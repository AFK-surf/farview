///| Feel (g5), app side: Escape closes the find bar the person types in before Peek / Reader, a Ctrl+Tab tap
///| switches tabs without flashing the switcher strip, Split View / Peek pick the most recent tab of the Space,
///| and the macOS menu bar leaves Cmd+W to the browser while giving Cmd+M to the system.

import "proto"
import "signals"

test "g5 app: Escape in the find field closes find first; Peek and Reader wait for the next Escape" {
  shell_adapter_reset()
  let prev_reader = app_state.reader_open
  let prev_find = app_state.find_open
  let prev_ff = app_state.find_field
  let prev_stage = app_state.stage
  let reader_sig = signals::signal(false)
  let find_sig = signals::signal(false)
  let ff = ui::Field::new()
  app_state.reader_open = Some(reader_sig)
  app_state.find_open = Some(find_sig)
  app_state.find_field = Some(ff)
  app_state.stage = None
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { let _ = ui::field(root, ff, label="Find in Page") }, width=400.0, height=100.0)
  t.frame(ms=16.0)

  // Peek, then Cmd+F over it: the first Escape closes find, Peek stays.
  let _ = shell_page_open_peek()
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(is_find_field_focused(), "the find field has the keyboard")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Escape consumed")
  debug_assert(!find_sig.untracked() && is_peek_open(), "Escape 1 closes find; Peek stays open")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !is_peek_open(), "Escape 2 closes Peek")

  // Reader, then Cmd+F: the same order.
  reader_sig.set(true)
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !find_sig.untracked() && reader_sig.untracked(), "find closes before Reader")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !reader_sig.untracked(), "then Reader closes")

  // A find bar left open while the keyboard is elsewhere still waits behind Peek.
  let _ = shell_page_open_peek()
  find_sig.set(true)
  ff.let_go()
  t.frame(ms=16.0)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !is_peek_open() && find_sig.untracked(), "unfocused find: Peek first")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !find_sig.untracked(), "then find")

  t.dispose()
  app_state.reader_open = prev_reader
  app_state.find_open = prev_find
  app_state.find_field = prev_ff
  app_state.stage = prev_stage
  shell_adapter_reset()
}

fn fka_tab(id : String, secs : Int64, space~ : String = "sp1") -> proto::TabSummary {
  proto::TabSummary::{
    id,
    space_id: space,
    title: "Tab " + id,
    url: "https://" + id + ".test/",
    pinned: false,
    favorite: false,
    active: secs == 400L,
    state: "active",
    folder_id: "",
    last_active_secs: secs,
  }
}

test "g5 app: a Ctrl+Tab tap switches with no strip; holding Ctrl shows it after 160ms; Tab again shows it at once" {
  shell_adapter_reset()
  let prev_mru = app_state.mru_open
  let prev_sel = app_state.mru_selected
  let prev_shown = app_state.mru_shown
  let prev_root = app_state.root_view
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()
  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  let mru_sig = signals::signal(false)
  let shown_sig = signals::signal(false)
  app_state.mru_open = Some(mru_sig)
  app_state.mru_selected = Some(signals::signal(0))
  app_state.mru_shown = Some(shown_sig)
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    tabs: [fka_tab("t3", 200L), fka_tab("t1", 400L), fka_tab("t2", 300L)],
  }
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { app_state.root_view = Some(root) }, width=400.0, height=200.0)
  t.frame(ms=16.0)
  let ctrl = proto::SHORTCUT_MOD_CTRL
  let _ = sn_read_all_available(acc, 0)

  // Tap: Ctrl+Tab and Ctrl up within 160ms. The previous tab comes forward, the strip was never drawn.
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false) && mru_sig.untracked(), "Ctrl+Tab opens the switcher (keys route to it)")
  debug_assert(!shown_sig.untracked() && !mru_strip_shown(), "the strip waits while Ctrl is held")
  t.frame(ms=80.0)
  debug_assert(!shown_sig.untracked(), "still not drawn at 80ms")
  debug_assert(handle_app_key(0, 0, false) && !mru_sig.untracked(), "Ctrl up commits")
  sn_expect_tab_switch(acc, "t2", "the tap switches to the previous tab")
  t.frame(ms=200.0)
  debug_assert(!shown_sig.untracked(), "the earlier reveal timer does nothing after the commit")

  // Hold: the strip shows once Ctrl has been down for 160ms, with the previous tab highlighted.
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false), "Ctrl+Tab again")
  t.frame(ms=100.0)
  debug_assert(!shown_sig.untracked(), "not at 100ms")
  t.frame(ms=100.0)
  debug_assert(shown_sig.untracked() && mru_strip_shown(), "drawn after 160ms held")
  debug_assert(handle_app_key(0, 0, false), "commit")
  debug_assert(!shown_sig.untracked(), "commit hides the strip")
  let _ = sn_read_all_available(acc, 0)

  // Ctrl+Tab, Tab: stepping shows it at once.
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false), "Ctrl+Tab")
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false) && shown_sig.untracked(), "a second Tab shows the strip at once")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, ctrl, false) && !shown_sig.untracked(), "Ctrl+Escape closes it")

  // Opened without Ctrl held (the menu, a demo flag): drawn at once.
  open_or_step_mru_switcher(1)
  debug_assert(shown_sig.untracked(), "opened from elsewhere: drawn at once")
  close_mru_switcher()

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.mru_open = prev_mru
  app_state.mru_selected = prev_sel
  app_state.mru_shown = prev_shown
  app_state.root_view = prev_root
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

test "g5 app: Split View and Peek open the most recent other tab of this Space, never a list-order pick" {
  let prev_ws = app_state.workspace
  // List order: a favorite from another Space first, then t3 (oldest) and t2 (most recent after t1).
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    tabs: [fka_tab("fav", 500L, space="sp2"), fka_tab("t3", 200L), fka_tab("t1", 400L), fka_tab("t2", 300L)],
  }
  let (u, id) = pick_default_split_target()
  debug_assert(id == "t2" && u == "https://t2.test/", "most recent other tab in this Space: \{id}")
  // Only the current tab in this Space: a blank page, not a copy of this one.
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    tabs: [fka_tab("fav", 500L, space="sp2"), fka_tab("t1", 400L)],
  }
  let (u2, id2) = pick_default_split_target()
  debug_assert(u2 == "about:blank" && id2 == "", "no other tab: a blank page (\{u2})")
  app_state.workspace = prev_ws
}

test "g5 app: the macOS menu bar gives Cmd+M to Minimize and keeps Cmd+W the browser's" {
  let j = mac_menu_bar_json()
  debug_assert(j.contains("\"role\":\"minimize\""), "Window menu has Minimize (Cmd+M)")
  debug_assert(j.contains("\"role\":\"quit\"") && j.contains("\"role\":\"hide\""), "app menu has Hide and Quit")
  debug_assert(!j.contains("\"role\":\"close\""), "no Close item: Cmd+W closes the tab, not the window")
  debug_assert(j.contains("\"role\":\"window\""), "the Window menu is the system's window list")
}

test "g5 app: Cmd/Ctrl+G finds again from the page, and reopens a closed find bar on the last query" {
  shell_adapter_reset()
  let prev_find = app_state.find_open
  let prev_ff = app_state.find_field
  let prev_stage = app_state.stage
  let find_sig = signals::signal(false)
  let ff = ui::Field::new()
  app_state.find_open = Some(find_sig)
  app_state.find_field = Some(ff)
  app_state.stage = Some(stage::Stage::new(fn(_b : Bytes) -> Unit { () }))
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { let _ = ui::field(root, ff, label="Find in Page") }, width=400.0, height=100.0)
  t.frame(ms=16.0)
  let primary = if ui::keys_system() == 0 { proto::SHORTCUT_MOD_CMD } else { proto::SHORTCUT_MOD_CTRL }
  let g = 1103
  // Closed with no query: Cmd+G opens the bar, as Cmd+F does.
  debug_assert(handle_app_key(g, primary, false) && find_sig.untracked(), "Cmd+G with nothing to find opens the bar")
  ff.set("grid")
  close_find_bar(active_find_stage())
  t.frame(ms=16.0)
  debug_assert(!find_sig.untracked(), "closed")
  // Closed with a query in the field: Cmd+G reopens on it.
  debug_assert(handle_app_key(g, primary, false), "Cmd+G consumed")
  debug_assert(find_sig.untracked() && app_state.last_find_query == "grid", "the bar comes back on the last query: \{app_state.last_find_query}")
  // Open, the page has the keyboard: Cmd+G and Cmd+Shift+G step without taking it.
  ff.let_go()
  t.frame(ms=16.0)
  debug_assert(handle_app_key(g, primary, false) && !ff.focused(), "Cmd+G steps; the keyboard stays on the page")
  debug_assert(handle_app_key(1071, primary | proto::SHORTCUT_MOD_SHIFT, false) && !ff.focused(), "Cmd+Shift+G steps back")
  debug_assert(find_sig.untracked() && app_state.last_find_query == "grid", "the query is kept")
  close_find_bar(active_find_stage())
  t.dispose()
  app_state.find_open = prev_find
  app_state.find_field = prev_ff
  app_state.stage = prev_stage
  shell_adapter_reset()
}
