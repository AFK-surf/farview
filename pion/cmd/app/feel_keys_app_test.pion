///| Feel (g5), app side: Escape closes the find bar the person types in before Peek / Reader, a Ctrl+Tab tap
///| switches tabs without flashing the switcher strip, Split View / Peek pick the most recent tab of the Space,
///| and the macOS menu bar leaves Cmd+W to the browser while giving Cmd+M to the system.

import "proto"
import "signals"

test "g5 app: Escape in the find field closes find first; Peek and Reader wait for the next Escape" {
  shell_adapter_reset()
  let prev_reader = app_state.reader_open
  let prev_find = app_state.find_open
  let prev_ff = app_state.find_field
  let prev_stage = app_state.stage
  let reader_sig = signals::signal(false)
  let find_sig = signals::signal(false)
  let ff = ui::Field::new()
  app_state.reader_open = Some(reader_sig)
  app_state.find_open = Some(find_sig)
  app_state.find_field = Some(ff)
  app_state.stage = None
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { let _ = ui::field(root, ff, label="Find in Page") }, width=400.0, height=100.0)
  t.frame(ms=16.0)

  // Peek, then Cmd+F over it: the first Escape closes find, Peek stays.
  let _ = shell_page_open_peek()
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(is_find_field_focused(), "the find field has the keyboard")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Escape consumed")
  debug_assert(!find_sig.untracked() && is_peek_open(), "Escape 1 closes find; Peek stays open")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !is_peek_open(), "Escape 2 closes Peek")

  // Reader, then Cmd+F: the same order.
  reader_sig.set(true)
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !find_sig.untracked() && reader_sig.untracked(), "find closes before Reader")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !reader_sig.untracked(), "then Reader closes")

  // A find bar left open while the keyboard is elsewhere still waits behind Peek.
  let _ = shell_page_open_peek()
  find_sig.set(true)
  ff.let_go()
  t.frame(ms=16.0)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !is_peek_open() && find_sig.untracked(), "unfocused find: Peek first")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !find_sig.untracked(), "then find")

  t.dispose()
  app_state.reader_open = prev_reader
  app_state.find_open = prev_find
  app_state.find_field = prev_ff
  app_state.stage = prev_stage
  shell_adapter_reset()
}

fn fka_tab(id : String, secs : Int64, space~ : String = "sp1") -> proto::TabSummary {
  proto::TabSummary::{
    id,
    space_id: space,
    title: "Tab " + id,
    url: "https://" + id + ".test/",
    pinned: false,
    favorite: false,
    active: secs == 400L,
    state: "active",
    folder_id: "",
    last_active_secs: secs,
  }
}

test "g5 app: a Ctrl+Tab tap switches with no strip; holding Ctrl shows it after 160ms; Tab again shows it at once" {
  shell_adapter_reset()
  let prev_mru = app_state.mru_open
  let prev_sel = app_state.mru_selected
  let prev_shown = app_state.mru_shown
  let prev_root = app_state.root_view
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()
  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  let mru_sig = signals::signal(false)
  let shown_sig = signals::signal(false)
  app_state.mru_open = Some(mru_sig)
  app_state.mru_selected = Some(signals::signal(0))
  app_state.mru_shown = Some(shown_sig)
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    tabs: [fka_tab("t3", 200L), fka_tab("t1", 400L), fka_tab("t2", 300L)],
  }
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { app_state.root_view = Some(root) }, width=400.0, height=200.0)
  t.frame(ms=16.0)
  let ctrl = proto::SHORTCUT_MOD_CTRL
  let _ = sn_read_all_available(acc, 0)

  // Tap: Ctrl+Tab and Ctrl up within 160ms. The previous tab comes forward, the strip was never drawn.
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false) && mru_sig.untracked(), "Ctrl+Tab opens the switcher (keys route to it)")
  debug_assert(!shown_sig.untracked() && !mru_strip_shown(), "the strip waits while Ctrl is held")
  t.frame(ms=80.0)
  debug_assert(!shown_sig.untracked(), "still not drawn at 80ms")
  debug_assert(handle_app_key(0, 0, false) && !mru_sig.untracked(), "Ctrl up commits")
  sn_expect_tab_switch(acc, "t2", "the tap switches to the previous tab")
  t.frame(ms=200.0)
  debug_assert(!shown_sig.untracked(), "the earlier reveal timer does nothing after the commit")

  // Hold: the strip shows once Ctrl has been down for 160ms, with the previous tab highlighted.
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false), "Ctrl+Tab again")
  t.frame(ms=100.0)
  debug_assert(!shown_sig.untracked(), "not at 100ms")
  t.frame(ms=100.0)
  debug_assert(shown_sig.untracked() && mru_strip_shown(), "drawn after 160ms held")
  debug_assert(handle_app_key(0, 0, false), "commit")
  debug_assert(!shown_sig.untracked(), "commit hides the strip")
  let _ = sn_read_all_available(acc, 0)

  // Ctrl+Tab, Tab: stepping shows it at once.
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false), "Ctrl+Tab")
  debug_assert(handle_app_key(proto::KEY_TAB, ctrl, false) && shown_sig.untracked(), "a second Tab shows the strip at once")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, ctrl, false) && !shown_sig.untracked(), "Ctrl+Escape closes it")

  // Opened without Ctrl held (the menu, a demo flag): drawn at once.
  open_or_step_mru_switcher(1)
  debug_assert(shown_sig.untracked(), "opened from elsewhere: drawn at once")
  close_mru_switcher()

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.mru_open = prev_mru
  app_state.mru_selected = prev_sel
  app_state.mru_shown = prev_shown
  app_state.root_view = prev_root
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

test "g5 app: Split View and Peek open the most recent other tab of this Space, never a list-order pick" {
  let prev_ws = app_state.workspace
  // List order: a favorite from another Space first, then t3 (oldest) and t2 (most recent after t1).
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    tabs: [fka_tab("fav", 500L, space="sp2"), fka_tab("t3", 200L), fka_tab("t1", 400L), fka_tab("t2", 300L)],
  }
  let (u, id) = pick_default_split_target()
  debug_assert(id == "t2" && u == "https://t2.test/", "most recent other tab in this Space: \{id}")
  // Only the current tab in this Space: a blank page, not a copy of this one.
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    tabs: [fka_tab("fav", 500L, space="sp2"), fka_tab("t1", 400L)],
  }
  let (u2, id2) = pick_default_split_target()
  debug_assert(u2 == "about:blank" && id2 == "", "no other tab: a blank page (\{u2})")
  app_state.workspace = prev_ws
}

test "g5 app: the macOS menu bar gives Cmd+M to Minimize and keeps Cmd+W the browser's" {
  let j = proto::mac_menu_bar_json()
  debug_assert(j.contains("\"role\":\"minimize\""), "Window menu has Minimize (Cmd+M)")
  debug_assert(j.contains("\"role\":\"quit\"") && j.contains("\"role\":\"hide\""), "app menu has Hide and Quit")
  debug_assert(!j.contains("\"role\":\"close\""), "no Close item: Cmd+W closes the tab, not the window")
  debug_assert(j.contains("\"role\":\"window\""), "the Window menu is the system's window list")
}

///| What the app sent the host on the main connection since the last read, as hex.
fn fka_sent_hex(acc : Int) -> String {
  let _ = io_rt.main_conn.flush_write()
  bytes_to_hex(sn_read_all_available(acc, 0))
}

fn fka_act_hex(name : String, arg : String, flags : String) -> String {
  bytes_to_hex(wire::encode(wire::Message::Act(name, arg, flags)))
}

test "g5 app: Cmd/Ctrl+G finds again from the page, and reopens a closed find bar on the last query" {
  shell_adapter_reset()
  let prev_find = app_state.find_open
  let prev_ff = app_state.find_field
  let prev_stage = app_state.stage
  let old_main = io_rt.main_conn.detach()
  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  let find_sig = signals::signal(false)
  let ff = ui::Field::new()
  app_state.find_open = Some(find_sig)
  app_state.find_field = Some(ff)
  app_state.stage = Some(stage::Stage::new(fn(_b : Bytes) -> Unit { () }))
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { let _ = ui::field(root, ff, label="Find in Page") }, width=400.0, height=100.0)
  t.frame(ms=16.0)
  let primary = if proto::keys_are_macos(ui::keys_system()) { proto::SHORTCUT_MOD_CMD } else { proto::SHORTCUT_MOD_CTRL }
  let shift = proto::SHORTCUT_MOD_SHIFT
  let g = 1103
  let flags = proto::find_flags_for(is_find_case_sensitive(), false)
  let find_q = fka_act_hex("find", "grid", flags)
  let next = fka_act_hex("find_next", "", "")
  let prev = fka_act_hex("find_prev", "", "")
  let _ = fka_sent_hex(acc)
  // Closed with no query: Cmd+G opens the bar, as Cmd+F does, and asks the host nothing.
  debug_assert(handle_app_key(g, primary, false) && find_sig.untracked(), "Cmd+G with nothing to find opens the bar")
  debug_assert(fka_sent_hex(acc) == "", "nothing to find: no step sent")
  ff.set("grid")
  close_find_bar(active_find_stage())
  t.frame(ms=16.0)
  debug_assert(!find_sig.untracked(), "closed")
  let _ = fka_sent_hex(acc)
  // Closed with a query in the field: Cmd+G reopens on it; the host's first match is the next one.
  debug_assert(handle_app_key(g, primary, false), "Cmd+G consumed")
  debug_assert(find_sig.untracked() && app_state.last_find_query == "grid", "the bar comes back on the last query: \{app_state.last_find_query}")
  debug_assert(fka_sent_hex(acc) == find_q, "reopen with Cmd+G: find \"grid\" and no extra step")
  close_find_bar(active_find_stage())
  t.frame(ms=16.0)
  let _ = fka_sent_hex(acc)
  // Closed, Cmd+Shift+G: find, then one step back (to the last match).
  debug_assert(handle_app_key(1071, primary | shift, false) && find_sig.untracked(), "Cmd+Shift+G reopens")
  debug_assert(fka_sent_hex(acc) == find_q + prev, "reopen with Cmd+Shift+G: find then find_prev")
  // Open, the page has the keyboard: Cmd+G and Cmd+Shift+G step without taking it.
  ff.let_go()
  t.frame(ms=16.0)
  let _ = fka_sent_hex(acc)
  debug_assert(handle_app_key(g, primary, false) && !ff.focused(), "Cmd+G steps; the keyboard stays on the page")
  debug_assert(fka_sent_hex(acc) == next, "open bar, Cmd+G: find_next")
  debug_assert(handle_app_key(1071, primary | shift, false) && !ff.focused(), "Cmd+Shift+G steps back")
  debug_assert(fka_sent_hex(acc) == prev, "open bar, Cmd+Shift+G: find_prev")
  debug_assert(find_sig.untracked() && app_state.last_find_query == "grid", "the query is kept")
  close_find_bar(active_find_stage())
  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.find_open = prev_find
  app_state.find_field = prev_ff
  app_state.stage = prev_stage
  shell_adapter_reset()
}

///| A page whose only content is an `<input>` (node 4), so a Focus patch gives the Stage a page field.
fn fka_reset_with_input(base : String) -> Bytes {
  let body : Array[Byte] = []
  sn_w_varint(body, 101) // HostMsg::Reset
  sn_w_varint(body, 1) // seq
  sn_w_varint(body, 0) // ack
  sn_w_str(body, base)
  sn_w_elem_header(body, 1, 0, "", 1)
  sn_w_elem_header(body, 2, 3, "html", 1)
  sn_w_elem_header(body, 3, 3, "body", 1)
  sn_w_elem_header(body, 4, 3, "input", 0)
  sn_w_varint(body, 0) // sheets
  sn_w_varint(body, 0) // cssom len
  sn_w_varint(body, 0) // frames len
  sn_w_str(body, "") // target
  let n = body.length()
  let framed = Bytes::new(4 + n)
  sn_put_be(framed, 0, 4, n)
  let mut i = 0
  while i < n {
    framed[4 + i] = body[i]
    i += 1
  }
  framed
}

fn fka_editing_stage() -> stage::Stage {
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.opened()
  ui::answered_from_outside(fn() -> Unit {
    st.feed(proto::encode_host(proto::HostMsg::Meta("https://editor.test/", "Editor", false, false, false)))
    st.feed(fka_reset_with_input("https://editor.test"))
    st.feed(proto::encode_host(proto::HostMsg::Patch(2, 0, [proto::PatchOp::Focus(4)])))
  })
  st
}

test "g5 app: editor keys follow the pane that has the keyboard (Peek counts), and never a Stage the keyboard left" {
  shell_adapter_reset()
  let prev_stage = app_state.stage
  let prev_split = app_state.split_stage
  let prev_sv = app_state.stage_view
  let prev_ssv = app_state.split_stage_view
  let prev_root = app_state.root_view
  let prev_start = app_state.initial_start_page_open
  app_state.initial_start_page_open = false
  let editing = fka_editing_stage()
  let idle = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  debug_assert(editing.editing_text() && !idle.editing_text(), "fixture: one Stage has a page field, the other none")
  let mut in_primary : Option[view::View] = None
  let mut in_peek : Option[view::View] = None
  let mut sidebar_btn : Option[view::View] = None
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let _ = root.box(fn(sv : view::View) -> Unit {
        app_state.stage_view = Some(sv)
        let _ = sv.box(fn(n : view::View) -> Unit {
          let _ = n.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0))).focusable(view::Live::Is(true))
          in_primary = Some(n)
        })
      })
      let _ = root.box(fn(sv2 : view::View) -> Unit {
        app_state.split_stage_view = Some(sv2)
        let _ = sv2.box(fn(n : view::View) -> Unit {
          let _ = n.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0))).focusable(view::Live::Is(true))
          in_peek = Some(n)
        })
      })
      sidebar_btn = Some(headless::button(root, fn() { "Sidebar Tab" }, fn(_v) { () }, fn(b, _btn) {
        let _ = b.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
      }))
    },
    width=400.0,
    height=300.0,
  )
  t.frame(ms=16.0)
  let focus_on = fn(v : Option[view::View]) -> Unit {
    match (app_state.root_view, v) {
      (Some(rv), Some(n)) => { let _ = rv.tree.focus_to(Some(n.id()), visible=false) }
      _ => ()
    }
  }
  let primary = if proto::keys_are_macos(ui::keys_system()) { proto::SHORTCUT_MOD_CMD } else { proto::SHORTCUT_MOD_CTRL }
  let k = 1107

  // A Peek whose page has a field, the keyboard in the Peek: Cmd+K is the page's.
  app_state.stage = Some(idle)
  app_state.split_stage = Some(editing)
  let _ = shell_page_open_peek()
  debug_assert(is_peek_open(), "Peek open")
  focus_on(in_peek)
  debug_assert(is_page_editing_focused(), "the Peek's page field counts")
  debug_assert(!handle_app_key(k, primary, false), "Cmd+K goes to the field in the Peek")
  // The keyboard moves to a sidebar button: Cmd+K is the browser's again (the Stage still reports its field).
  focus_on(sidebar_btn)
  debug_assert(editing.editing_text(), "the Stage still has its field")
  debug_assert(!is_page_editing_focused(), "focus on chrome: no page edits")
  debug_assert(handle_app_key(k, primary, false), "Cmd+K opens the command bar from the sidebar")
  toggle_command_bar()

  // The opposite case: a caret left in the primary page while the keyboard is in the Peek.
  app_state.stage = Some(editing)
  app_state.split_stage = Some(idle)
  focus_on(in_peek)
  debug_assert(!is_page_editing_focused(), "the primary page's old caret does not hide keys in the Peek")
  debug_assert(handle_app_key(k, primary, false), "Cmd+K is the browser's in a Peek with no field")
  toggle_command_bar()
  // And in the primary page itself, its field keeps Cmd+K.
  close_peek_preview(quiet=true)
  focus_on(in_primary)
  debug_assert(is_page_editing_focused() && !handle_app_key(k, primary, false), "Cmd+K goes to the primary page's field")

  t.dispose()
  app_state.stage = prev_stage
  app_state.split_stage = prev_split
  app_state.stage_view = prev_sv
  app_state.split_stage_view = prev_ssv
  app_state.root_view = prev_root
  app_state.initial_start_page_open = prev_start
  shell_adapter_reset()
}

test "desktop window: setup_desktop_window enables inset fused titlebar and sync_lg_theme_from_chrome forwards dark mode" {
  let prev_h = hostapi::host()
  let prev_theme_sig = app_state.chrome_theme
  let prev_init = app_state.initial_chrome_theme
  let prev_settings = app_state.settings
  let setup_called : Array[(Double, Double, Double, Double, Bool)] = []
  let dark_calls : Array[Bool] = []
  let h = hostapi::Host::noop()
  h.window_setup = fn(mw : Double, mh : Double, w : Double, hh : Double, inset : Bool) -> Unit {
    setup_called.push((mw, mh, w, hh, inset))
  }
  h.set_dark = fn(d : Bool) -> Unit { dark_calls.push(d) }
  hostapi::set_host(h)
  setup_desktop_window()
  debug_assert(setup_called.length() == 1, "window_setup called once")
  let (mw, mh, w, hh, inset) = setup_called[0]
  debug_assert(mw == 480.0 && mh == 400.0 && w == 1280.0 && hh == 800.0 && inset, "window_setup passes inset=true")
  app_state.chrome_theme = None
  app_state.initial_chrome_theme = ""
  app_state.settings = proto::BrowserSettings::{ ..app_state.settings, chrome_theme: "light" }
  sync_lg_theme_from_chrome("dark")
  sync_lg_theme_from_chrome("light")
  debug_assert(dark_calls.length() == 2 && dark_calls[0] && !dark_calls[1], "set_dark follows chrome theme")
  hostapi::set_host(prev_h)
  app_state.chrome_theme = prev_theme_sig
  app_state.initial_chrome_theme = prev_init
  app_state.settings = prev_settings
  sync_lg_theme_from_chrome(prev_settings.chrome_theme)
}
