///| What the app takes of the pointer before the view tree sees it (`ui::set_pointer_interceptor`): Invar hands a
///| press of the middle button (its button 3) to the tree as a primary press, so the shell's own middle-button
///| acts are taken here, on their way down, and the matching release with them.
///| (One interceptor per app: anything else that needs the pointer first is added to `handle_app_pointer`.)

///| A middle press the shell took: its release is the shell's too.
let middle_taken : Array[Bool] = [false]

///| The pointer's events as Invar's view host gives them (kind 1 down, 2 up; button 3 the middle one): a middle
///| press on a sidebar tab row closes that tab (Chrome's, Arc's), and neither it nor its release reaches the tree.
fn handle_app_pointer(kind : Int, x : Double, y : Double, button : Int, mods : Int) -> Bool {
  if button != 3 {
    return false
  }
  if kind == 1 {
    if shell_ui::shell_middle_press() {
      middle_taken[0] = true
      return true
    }
    // (not the shell's: a middle press over a page, whose link opens in a new tab behind)
    return page_middle_pointer(kind, x, y, button, mods)
  }
  if kind == 2 && middle_taken[0] {
    middle_taken[0] = false
    return true
  }
  page_middle_pointer(kind, x, y, button, mods)
}
