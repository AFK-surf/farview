///| Page zoom per site and the zoom bubble, app side.

import "proto"

fn zst_stage_at(url : String) -> stage::Stage {
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.opened()
  zst_go(st, url)
  st
}

fn zst_go(st : stage::Stage, url : String) -> Unit {
  ui::answered_from_outside(fn() -> Unit {
    st.feed(proto::encode_host(proto::HostMsg::Meta(url, "Page", false, false, false)))
  })
}

test "zoom per site: a zoom is kept for its site, other sites keep the default, and it comes back on return" {
  shell_adapter_reset()
  let prev_stage = app_state.stage
  let prev_settings = app_state.settings
  let prev_root = app_state.root_view
  app_state.root_view = None
  app_state.settings = proto::BrowserSettings::default()
  let st = zst_stage_at("https://www.alpha.test/a")
  app_state.stage = Some(st)

  zoom_act(proto::zoom_step_up)
  debug_assert(st.zoom_percent() == 110, "zoomed in one step")
  debug_assert(app_state.settings.site_zoom == "alpha.test=110", "kept for the site: " + app_state.settings.site_zoom)
  debug_assert(zoom_bubble_open.untracked(), "the zoom bubble shows")
  zoom_bubble_close()

  // Another site: the default; another page of the first site: its zoom.
  zst_go(st, "https://beta.test/")
  follow_site_zoom()
  debug_assert(st.zoom_percent() == 100, "another site is at the default")
  zst_go(st, "https://alpha.test/other")
  follow_site_zoom()
  debug_assert(st.zoom_percent() == 110, "back on the site, its zoom again")

  // Reset goes back to the default, and the site keeps no zoom of its own.
  zoom_act(fn(_z) { default_zoom() }, bubble=false)
  debug_assert(st.zoom_percent() == 100 && app_state.settings.site_zoom == "", "reset drops the site's zoom")
  debug_assert(!zoom_bubble_open.untracked(), "the zoom controls' own buttons show no bubble")

  // A new default: every site without its own zoom follows it, a site with one keeps it.
  zoom_act(proto::zoom_step_down, bubble=false)
  dispatch_settings_save(proto::BrowserSettings::{ ..app_state.settings, default_zoom_pct: 125 })
  follow_site_zoom()
  debug_assert(st.zoom_percent() == 90, "the site keeps its own zoom")
  zst_go(st, "https://beta.test/")
  follow_site_zoom()
  debug_assert(st.zoom_percent() == 125, "the others follow the new default")
  zoom_bubble_close()

  app_state.stage = prev_stage
  app_state.settings = prev_settings
  app_state.root_view = prev_root
  shell_adapter_reset()
}

test "zoom bubble: it goes a moment after the last zoom, and stays while the pointer is over it" {
  shell_adapter_reset()
  let prev_stage = app_state.stage
  let prev_settings = app_state.settings
  let prev_root = app_state.root_view
  app_state.settings = proto::BrowserSettings::default()
  let st = zst_stage_at("https://gamma.test/")
  app_state.stage = Some(st)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { app_state.root_view = Some(root) }, width=400.0, height=300.0)
  t.frame(ms=16.0)
  zoom_act(proto::zoom_step_up)
  t.run_for(ZOOM_BUBBLE_MS * 0.6)
  zoom_act(proto::zoom_step_up)
  t.run_for(ZOOM_BUBBLE_MS * 0.6)
  debug_assert(zoom_bubble_open.untracked(), "another zoom keeps it up")
  t.run_for(ZOOM_BUBBLE_MS * 0.6)
  debug_assert(!zoom_bubble_open.untracked(), "gone a moment after the last zoom")
  zoom_act(proto::zoom_step_down)
  zoom_bubble_hold(true)
  t.run_for(ZOOM_BUBBLE_MS * 1.5)
  debug_assert(zoom_bubble_open.untracked(), "held while the pointer is over it")
  zoom_bubble_hold(false)
  t.run_for(ZOOM_BUBBLE_MS * 0.5)
  debug_assert(zoom_bubble_open.untracked(), "not gone the moment the pointer leaves")
  t.run_for(ZOOM_BUBBLE_MS * 0.7)
  debug_assert(!zoom_bubble_open.untracked(), "gone after the wait once left")
  t.dispose()
  app_state.stage = prev_stage
  app_state.settings = prev_settings
  app_state.root_view = prev_root
  shell_adapter_reset()
}
