///| Native Metal Arc Reader Mode (`Cmd+Opt+R` / `Ctrl+Alt+R`) and
///| Arc Boosts per-domain live site styling panel (`Cmd+Shift+E` / `Ctrl+Shift+E`).
///| Strictly follows concentric corner radii (14 -> 8 -> 6pt), first-line alignment,
///| zero double dividers, zero `alpha=0` clickable buttons, and zero `ellipsis_past(true)`.

fn dispatch_reader_extract() -> Unit {
  send_wire_active(wire::Message::Act("reader_extract", "", ""))
}

fn dispatch_boost_sync() -> Unit {
  send_wire(wire::Message::Act("boost_sync", "", ""))
}

fn dispatch_boost_save(boost : proto::SiteBoost, toast_msg~ : String = "") -> Unit {
  let payload = proto::encode_site_boost(boost)
  send_wire(wire::Message::Act("boost_save", payload, ""))
  if toast_msg != "" {
    show_toast(toast_msg, "boost")
  }
}

fn dispatch_boost_reset(host : String) -> Unit {
  send_wire(wire::Message::Act("boost_reset", host, ""))
  show_toast("Reset Boost for " + host, "boost")
}

fn current_boost_host() -> String {
  let u = active_stage().url()
  let h = proto::normalize_boost_host(u)
  if h != "" { h } else { "local" }
}

fn current_site_boost() -> proto::SiteBoost {
  let h = current_boost_host()
  match proto::boosts_find(app_state.boosts_snap, h) {
    Some(b) => b
    None => proto::SiteBoost::default_for(h)
  }
}

fn sync_boosts_css_field_from_host() -> Unit {
  let b = current_site_boost()
  match app_state.boosts_css_field {
    Some(f) => if !f.focused() {
      app_state.syncing_boosts_css = true
      f.set(b.custom_css)
      app_state.syncing_boosts_css = false
    }
    None => ()
  }
}

fn set_host_reader_state(json : String) -> Unit {
  match proto::parse_reader_article(json) {
    Some(art) => {
      app_state.reader_article = art
      match app_state.reader_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_reader_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn set_host_boosts_state(json : String) -> Unit {
  match proto::parse_boosts_snapshot(json) {
    Some(snap) => {
      app_state.boosts_snap = snap
      sync_boosts_css_field_from_host()
      match app_state.boosts_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_boosts_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn set_host_reader_state_from_pane(from_pane : Int, json : String) -> Unit {
  if !shell_sig_is_true(app_state.reader_open) || from_pane != shell_adapter.reader_owner_pane {
    return
  }
  match proto::parse_reader_article(json) {
    Some(art) => {
      let exp_url = shell_adapter.reader_expected_url
      if exp_url != "" && art.url != "" && art.url != exp_url {
        return
      }
      app_state.reader_article = art
      match app_state.reader_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_reader_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn open_reader_mode() -> Unit {
  close_exclusive_overlays()
  shell_adapter.reader_owner_pane = if active_targets_split() { 1 } else { 0 }
  shell_adapter.reader_expected_url = if app_state.stage.is_some() {
    active_address_raw_url_untracked()
  } else {
    ""
  }
  match app_state.host_reader_synced {
    Some(s) => s.set(false)
    None => ()
  }
  match app_state.reader_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_page_set_active_reader(true)
  dispatch_reader_extract()
}

fn close_reader_mode() -> Unit {
  shell_adapter.reader_owner_pane = -1
  shell_adapter.reader_expected_url = ""
  match app_state.reader_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_page_set_active_reader(false)
}

fn toggle_reader_mode() -> Unit {
  let is_open = match app_state.reader_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_reader_mode()
  } else {
    open_reader_mode()
  }
}

fn close_boosts() -> Unit {
  match app_state.boosts_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  match app_state.boosts_css_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  shell_mark_exclusive_closed("boosts")
}

fn open_boosts() -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  sync_boosts_css_field_from_host()
  match app_state.boosts_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Drawer, "boosts")
  dispatch_boost_sync()
}

fn toggle_boosts() -> Unit {
  let is_open = match app_state.boosts_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_boosts()
  } else {
    open_boosts()
  }
}

fn ensure_demo_reader_sepia_seeded() -> Unit {
  if !app_state.demo_reader_sepia {
    return
  }
  match app_state.reader_theme {
    Some(s) => if s.untracked() != "sepia" { s.set("sepia") }
    None => ()
  }
  match app_state.reader_font {
    Some(s) => if s.untracked() != "serif" { s.set("serif") }
    None => ()
  }
  match app_state.reader_font_size {
    Some(s) => if s.untracked() != 18 { s.set(18) }
    None => ()
  }
  match app_state.reader_width_mode {
    Some(s) => if s.untracked() != "medium" { s.set("medium") }
    None => ()
  }
  match app_state.reader_progress {
    Some(s) => if s.untracked() < 0.05 { s.set(0.38) }
    None => ()
  }
  if app_state.reader_article.blocks.length() >= 4 && app_state.reader_article.word_count >= 180 {
    return
  }
  let blocks : Array[proto::ReaderBlock] = [
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "Modern desktop browsers spend a surprising share of every 16ms frame budget translating high-level document trees across process boundaries, re-rasterizing chrome layers, and fighting platform text metrics. Farview takes a different path: keep page execution isolated on the host while running CSS cascade, incremental layout, and retained-mode GPU painting natively on the client.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Heading,
      level: 2,
      text: "Why Retained Metal Trees Beat Video-Stream Browsers",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "When a remote browser streams pre-rendered pixel frames, scrolling latency, subpixel font clarity, and local form editing immediately degrade. By syncing authoritative DOM mutations and compact style sheets instead of pixel buffers, the client preserves crisp 2x CoreText typography, instantaneous hover feedback, and zero-jitter native scrolling even over high-latency links.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Quote,
      level: 0,
      text: "Good reading software should disappear into warm paper, balanced line lengths, and effortless typography — never competing with the ideas on the page.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Heading,
      level: 2,
      text: "中文排版与双语阅读体验设计",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "在长文阅读场景中，中英文混排的字数统计与阅读时长估算必须同时兼顾按词计数的拉丁文本与按字计数的东亚文字。羊皮纸色调降低屏幕高对比度眩光，配合 620pt 至 840pt 三档栏宽与 14px 至 24px 步进字号，无论是在宽屏显示器还是紧凑分屏中都能保持舒适的每行字数与呼吸感。",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::ListItem,
      level: 0,
      text: "Incremental layout touches only dirty subtrees so typography changes reflow in under a millisecond.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::ListItem,
      level: 0,
      text: "Three calibrated paper surfaces (Light, Sepia, and Night) preserve legibility across daylight and late-night sessions.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Code,
      level: 0,
      text: "let metrics = proto::compute_reader_metrics(article.blocks, title=article.title)\nlet col_pt = proto::reader_column_width_pt(width_mode) // 620 / 720 / 840pt",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "Combined with Arc-style colored tab folders and named workspace session snapshots, deep research threads stay organized without losing reading focus. Switch back to the live page at any moment with a single shortcut, or adjust column measure and typeface without touching the underlying document.",
    },
  ]
  let title = "Designing Low-Latency Native Metal Browsers for Deep Reading"
  let metrics = proto::compute_reader_metrics(blocks, title=title)
  app_state.reader_article = proto::ReaderArticle::{
    url: "https://farview.dev/notes/native-metal-reader-architecture",
    host: "farview.dev",
    title: title,
    byline: "Farview Engineering Notes — Typography & Rendering",
    read_minutes: metrics.read_minutes,
    word_count: metrics.word_count,
    blocks: blocks,
  }
  match app_state.reader_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.host_reader_synced {
    Some(s) => s.set(true)
    None => ()
  }
}

fn rb_make_run(
  s : String,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
) -> text::Run {
  let is_mono = force_mono || font == "mono"
  let is_serif = !is_mono && font == "serif"
  text::Run::{ ..text::plain(s), color, weight, italic, mono: is_mono, serif: is_serif }
}

///| Builds the immersive native Metal Arc Reader Mode Pro view covering the main content area.
///| Features: Light / Sepia (#F8F2E4) / Night (#16181E) paper themes, A-/14-24px/A+ font size stepper,
///| Sans/Serif/Mono typeface switch, Narrow (620pt)/Medium (720pt)/Wide (840pt) column width,
///| 2pt top reading progress bar, and independent English+CJK read time & word count badges.
fn build_reader_mode_view(
  parent : view::View,
  reader_open : signals::Signal[Bool],
  reader_rev : signals::Signal[Int],
  reader_theme : signals::Signal[String],
  reader_font : signals::Signal[String],
  reader_font_size : signals::Signal[Int],
  reader_width_mode : signals::Signal[String],
  reader_progress : signals::Signal[Double],
) -> Unit {
  parent.show(
    fn() -> Bool { reader_open.get() },
    fn(shell : view::View) -> Unit {
      // Paper theme palette: (page_bg, bar_bg, ink_primary, ink_muted, hairline, surface_bg, accent, pill_active_bg, pill_active_ink)
      let palette = fn() -> (Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64, Int64) {
        let th = proto::normalize_reader_paper_theme(reader_theme.get())
        if th == "sepia" {
          (0xF8F2E4FFL, 0xEFE6D4FFL, 0x35271AFFL, 0x7A634CFFL, 0xDCCEB6FFL, 0xEAE0CAFFL, 0x9A4E1CFFL, 0xFDF9F0FFL, 0x35271AFFL)
        } else if th == "night" {
          (0x16181EFFL, 0x1D2029FFL, 0xE6EAF2FFL, 0x94A3B8FFL, 0x2B3040FFL, 0x232734FFL, 0x60A5FAFFL, 0x2E3548FFL, 0xF8FAFCFFL)
        } else {
          (0xFCFBF9FFL, 0xF4F5F8FFL, 0x1C1917FFL, 0x6B7280FFL, 0xE5E7EBFFL, 0xECEEF2FFL, 0x2563EBFFL, 0xFFFFFFFFL, 0x1C1917FFL)
        }
      }

      let reader_metrics = fn() -> proto::ReaderMetrics {
        let _ = reader_rev.get()
        let art = app_state.reader_article
        let m = proto::compute_reader_metrics(art.blocks, title=art.title)
        if m.word_count > 0 {
          m
        } else {
          proto::ReaderMetrics::{
            word_count: art.word_count,
            cjk_chars: 0,
            latin_words: art.word_count,
            read_minutes: if art.read_minutes > 0 { art.read_minutes } else { 1 },
          }
        }
      }

      let _ = shell
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .min_width(view::Live::Is(Some(0.0)))
      .min_height(view::Live::Is(Some(0.0)))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 { palette().0 }))

      // 1. Top Reader Pro Typography Control Bar (44pt)
      let _ = shell.box(
        fn(bar : view::View) -> Unit {
          let _ = bar
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(44.0)))
          .rigid()
          .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
          .gap(view::Live::Is(8.0))
          .ground(view::Live::By(fn() -> Int64 { palette().1 }))

          // Left: Reader badge + independent read time & word count badges (zero `·` concatenation)
          let _ = bar.box(
            fn(left : view::View) -> Unit {
              let _ = left
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .gap(view::Live::Is(6.0))
              .clips(view::Live::Is(true))

              let _ = left.box(
                fn(tag : view::View) -> Unit {
                  let _ = tag
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { palette().5 }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, palette().4) }))
                  let _ = tag.box(
                    fn(tl : view::View) -> Unit {
                      let _ = tl
                      .words(
                        view::Live::Is("Reader"),
                        ink=0x2563EBFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { palette().6 }))
                    },
                  )
                },
              )

              let _ = left.box(
                fn(min_pill : view::View) -> Unit {
                  let _ = min_pill
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { palette().5 }))
                  let _ = min_pill.box(
                    fn(ml : view::View) -> Unit {
                      let _ = ml
                      .words(
                        view::Live::By(fn() -> String {
                          proto::format_read_minutes_badge(reader_metrics().read_minutes)
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { palette().3 }))
                    },
                  )
                },
              )

              left.show(
                fn() -> Bool { reader_metrics().word_count > 0 },
                fn(wc_pill : view::View) -> Unit {
                  let _ = wc_pill
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { palette().5 }))
                  let _ = wc_pill.box(
                    fn(wl : view::View) -> Unit {
                      let _ = wl
                      .words(
                        view::Live::By(fn() -> String {
                          proto::format_word_count_badge(reader_metrics().word_count)
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { palette().3 }))
                    },
                  )
                },
              )
            },
          )

          // Paper Theme selector: Light / Sepia / Night
          let _ = bar.box(
            fn(tseg : view::View) -> Unit {
              let _ = tseg
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
              .gap(view::Live::Is(2.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { palette().5 }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, palette().4) }))

              let theme_btn = fn(id : String, label : String, dot_color : Int64) -> Unit {
                let is_on = fn() -> Bool { proto::normalize_reader_paper_theme(reader_theme.get()) == id }
                let _ = headless::button(
                  tseg,
                  fn() -> String { "Reader Paper Theme " + label },
                  fn(_v : view::View) -> Unit { reader_theme.set(id) },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let _ = b
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .height(view::Live::Is(Some(24.0)))
                    .rigid()
                    .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                    .gap(view::Live::Is(4.0))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if is_on() {
                        palette().7
                      } else if btn.hovered() || btn.pressed() {
                        palette().4
                      } else {
                        0x00000000L
                      }
                    }))
                    let _ = b.box(
                      fn(dot : view::View) -> Unit {
                        let _ = dot
                        .width(view::Live::Is(Some(8.0)))
                        .height(view::Live::Is(Some(8.0)))
                        .rigid()
                        .radius(view::Live::Is(4.0))
                        .ground(view::Live::Is(dot_color))
                        .edge(view::Live::Is((1.0, 0x94A3B888L)))
                      },
                    )
                    let _ = b.box(
                      fn(lbl : view::View) -> Unit {
                        let _ = lbl
                        .words(
                          view::Live::Is(label),
                          ink=0x1C1917FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          if is_on() { palette().8 } else { palette().3 }
                        }))
                      },
                    )
                  },
                )
              }
              theme_btn("light", "Light", 0xFFFFFFFFL)
              theme_btn("sepia", "Sepia", 0xF8F2E4FFL)
              theme_btn("night", "Night", 0x16181EFFL)
            },
          )

          // Font size stepper: A- / 14px-24px / A+
          let _ = bar.box(
            fn(sseg : view::View) -> Unit {
              let _ = sseg
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
              .gap(view::Live::Is(2.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { palette().5 }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, palette().4) }))

              let step_btn = fn(label : String, delta : Int) -> Unit {
                let _ = headless::button(
                  sseg,
                  fn() -> String { "Font Size " + label },
                  fn(_v : view::View) -> Unit {
                    let next = proto::step_reader_font_size(reader_font_size.untracked(), delta)
                    reader_font_size.set(next)
                  },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let _ = b
                    .height(view::Live::Is(Some(24.0)))
                    .rigid()
                    .center()
                    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if btn.hovered() || btn.pressed() { palette().7 } else { 0x00000000L }
                    }))
                    let _ = b.box(
                      fn(tl : view::View) -> Unit {
                        let _ = tl
                        .words(
                          view::Live::Is(label),
                          ink=0x1C1917FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 { palette().2 }))
                      },
                    )
                  },
                )
              }

              step_btn("A-", 0 - proto::READER_FONT_SIZE_STEP)
              let _ = sseg.box(
                fn(sz : view::View) -> Unit {
                  let _ = sz
                  .width(view::Live::Is(Some(34.0)))
                  .rigid()
                  .center()
                  let _ = sz.box(
                    fn(pl : view::View) -> Unit {
                      let _ = pl
                      .words(
                        view::Live::By(fn() -> String {
                          proto::clamp_reader_font_size(reader_font_size.get()).to_string() + "px"
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { palette().3 }))
                    },
                  )
                },
              )
              step_btn("A+", proto::READER_FONT_SIZE_STEP)
            },
          )

          // Typeface selector: Sans / Serif / Mono
          let _ = bar.box(
            fn(fseg : view::View) -> Unit {
              let _ = fseg
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
              .gap(view::Live::Is(2.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { palette().5 }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, palette().4) }))

              let font_btn = fn(id : String, label : String) -> Unit {
                let is_on = fn() -> Bool { proto::normalize_reader_font(reader_font.get()) == id }
                let _ = headless::button(
                  fseg,
                  fn() -> String { "Reader Font " + label },
                  fn(_v : view::View) -> Unit { reader_font.set(id) },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let _ = b
                    .height(view::Live::Is(Some(24.0)))
                    .rigid()
                    .center()
                    .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if is_on() {
                        palette().7
                      } else if btn.hovered() || btn.pressed() {
                        palette().4
                      } else {
                        0x00000000L
                      }
                    }))
                    let _ = b.box(
                      fn(lbl : view::View) -> Unit {
                        let _ = lbl
                        .words(
                          view::Live::Is(label),
                          ink=0x1C1917FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          if is_on() { palette().8 } else { palette().3 }
                        }))
                      },
                    )
                  },
                )
              }
              font_btn("sans", "Sans")
              font_btn("serif", "Serif")
              font_btn("mono", "Mono")
            },
          )

          // Column width selector: Narrow (620pt) / Medium (720pt) / Wide (840pt)
          let _ = bar.box(
            fn(wseg : view::View) -> Unit {
              let _ = wseg
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
              .gap(view::Live::Is(2.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { palette().5 }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, palette().4) }))

              let width_btn = fn(id : String, label : String) -> Unit {
                let is_on = fn() -> Bool { proto::normalize_reader_width(reader_width_mode.get()) == id }
                let _ = headless::button(
                  wseg,
                  fn() -> String { "Column Width " + label },
                  fn(_v : view::View) -> Unit { reader_width_mode.set(id) },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let _ = b
                    .height(view::Live::Is(Some(24.0)))
                    .rigid()
                    .center()
                    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if is_on() {
                        palette().7
                      } else if btn.hovered() || btn.pressed() {
                        palette().4
                      } else {
                        0x00000000L
                      }
                    }))
                    let _ = b.box(
                      fn(lbl : view::View) -> Unit {
                        let _ = lbl
                        .words(
                          view::Live::Is(label),
                          ink=0x1C1917FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          if is_on() { palette().8 } else { palette().3 }
                        }))
                      },
                    )
                  },
                )
              }
              width_btn("narrow", "Narrow")
              width_btn("medium", "Medium")
              width_btn("wide", "Wide")
            },
          )

          // Exit Reader button
          let _ = headless::button(
            bar,
            fn() -> String { "Exit Reader Mode" },
            fn(_v : view::View) -> Unit { close_reader_mode() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .height(view::Live::Is(Some(28.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if btn.pressed() {
                  palette().4
                } else if btn.hovered() {
                  palette().7
                } else {
                  palette().5
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, palette().4) }))
              let _ = b.box(
                fn(el : view::View) -> Unit {
                  let _ = el
                  .words(
                    view::Live::Is("Exit"),
                    ink=0x1C1917FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { palette().2 }))
                },
              )
            },
          )
        },
      )

      // 2pt slim reading progress bar directly below the control bar (serves as clean visual separator — zero double divider)
      let _ = shell.box(
        fn(prog_track : view::View) -> Unit {
          let _ = prog_track
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(2.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { palette().4 }))
          let _ = prog_track.box(
            fn(prog_fill : view::View) -> Unit {
              let _ = prog_fill
              .height(view::Live::Is(Some(2.0)))
              .rigid()
              .width(view::Live::By(fn() -> Option[Double] {
                let (_, _, tw, _) = prog_track.placed_now()
                let base_w = if tw > 10.0 { tw } else { 1040.0 }
                let p = proto::clamp_reader_progress(reader_progress.get())
                Some(base_w * p)
              }))
              .ground(view::Live::By(fn() -> Int64 { palette().6 }))
            },
          )
        },
      )

      // 2. Scrollable centered paper column (Narrow 620pt / Medium 720pt / Wide 840pt)
      let _ = shell.box(
        fn(scroll_host : view::View) -> Unit {
          let _ = scroll_host
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          .clips(view::Live::Is(true))
          .on_wheel(fn(wh : view::Wheel) -> Unit {
            let cur = reader_progress.untracked()
            let delta = (0.0 - wh.dy) / 1400.0
            reader_progress.set(proto::clamp_reader_progress(cur + delta))
          })

          let _ = ui::scroll_box(
            scroll_host,
            fn(sc : view::View) -> Unit {
              let _ = sc
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((32.0, 34.0, 32.0, 64.0)))

              let _ = sc.box(
                fn(col : view::View) -> Unit {
                  let col_w = fn() -> Option[Double] {
                    Some(proto::reader_column_width_pt(reader_width_mode.get()))
                  }
                  let _ = col
                  .width(view::Live::By(col_w))
                  .max_width(view::Live::By(col_w))
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .gap(view::Live::Is(14.0))

                  col.switch_by(
                    fn() -> Int {
                      let rev = reader_rev.get()
                      let th = proto::normalize_reader_paper_theme(reader_theme.get())
                      let fnm = proto::normalize_reader_font(reader_font.get())
                      let fsz = proto::clamp_reader_font_size(reader_font_size.get())
                      let wm = proto::normalize_reader_width(reader_width_mode.get())
                      let th_i = if th == "sepia" { 1 } else if th == "night" { 2 } else { 0 }
                      let fn_i = if fnm == "serif" { 1 } else if fnm == "mono" { 2 } else { 0 }
                      let wm_i = if wm == "narrow" { 0 } else if wm == "wide" { 2 } else { 1 }
                      rev * 100000 + fsz * 64 + wm_i * 16 + th_i * 4 + fn_i
                    },
                    fn(doc_box : view::View, _key : Int) -> Unit {
                      let art = app_state.reader_article
                      let font = proto::normalize_reader_font(reader_font.untracked())
                      let body_size = proto::clamp_reader_font_size(reader_font_size.untracked()).to_double()
                      let scale = body_size / 17.0
                      let (_, _, ink, ink_muted, hairline, surface_bg, accent, _, _) = palette()
                      let metrics = reader_metrics()
                      let _ = doc_box.gap(view::Live::Is(14.0))

                      // Article domain & reading metrics eyebrow (independent soft pills, zero `·` concatenation)
                      let _ = doc_box.box(
                        fn(eyebrow : view::View) -> Unit {
                          let _ = eyebrow
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .gap(view::Live::Is(8.0))
                          if art.host != "" {
                            let _ = eyebrow.box(
                              fn(h : view::View) -> Unit {
                                let _ = h.words(
                                  view::Live::Is(art.host),
                                  ink=accent,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                                  one_line=true,
                                )
                              },
                            )
                          }
                          let _ = eyebrow.box(
                            fn(rm : view::View) -> Unit {
                              let _ = rm
                              .padding(view::Live::Is((7.0, 2.0, 7.0, 2.0)))
                              .radius(view::Live::Is(5.0))
                              .ground(view::Live::Is(surface_bg))
                              let _ = rm.box(
                                fn(rml : view::View) -> Unit {
                                  let _ = rml.words(
                                    view::Live::Is(proto::format_read_minutes_badge(metrics.read_minutes)),
                                    ink=ink_muted,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                    one_line=true,
                                  )
                                },
                              )
                            },
                          )
                          if metrics.word_count > 0 {
                            let _ = eyebrow.box(
                              fn(wc : view::View) -> Unit {
                                let _ = wc
                                .padding(view::Live::Is((7.0, 2.0, 7.0, 2.0)))
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::Is(surface_bg))
                                let _ = wc.box(
                                  fn(wcl : view::View) -> Unit {
                                    let _ = wcl.words(
                                      view::Live::Is(proto::format_word_count_badge(metrics.word_count)),
                                      ink=ink_muted,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                  },
                                )
                              },
                            )
                          }
                        },
                      )

                      // Article title
                      let title_text = if art.title != "" { art.title } else { "Extracting article..." }
                      let title_size = 30.0 * scale
                      let _ = doc_box.box(
                        fn(tb : view::View) -> Unit {
                          let _ = tb.words_runs(
                            view::Live::Is([rb_make_run(title_text, ink, font, weight=700)]),
                            ink=ink,
                            look=view::WordsLook::{
                              ..view::words_plain,
                              size: title_size,
                              weight: 700,
                              line: title_size * 1.24,
                              wrap: true,
                            },
                          )
                        },
                      )

                      // Optional byline
                      if art.byline != "" {
                        let _ = doc_box.box(
                          fn(by : view::View) -> Unit {
                            let _ = by.words_runs(
                              view::Live::Is([rb_make_run(art.byline, ink_muted, font, weight=400)]),
                              ink=ink_muted,
                              look=view::WordsLook::{
                                ..view::words_plain,
                                size: 13.5 * scale,
                                weight: 400,
                                line: 20.0 * scale,
                                wrap: true,
                              },
                            )
                          },
                        )
                      }

                      // Single 1pt hairline under article header
                      let _ = doc_box.box(
                        fn(hsep : view::View) -> Unit {
                          let _ = hsep
                          .height(view::Live::Is(Some(1.0)))
                          .rigid()
                          .ground(view::Live::Is(hairline))
                        },
                      )

                      if art.blocks.length() == 0 {
                        let _ = doc_box.box(
                          fn(emp : view::View) -> Unit {
                            let _ = emp
                            .padding(view::Live::Is((0.0, 12.0, 0.0, 12.0)))
                            .words_runs(
                              view::Live::Is([rb_make_run("No article body detected on this page.", ink_muted, font)]),
                              ink=ink_muted,
                              look=view::WordsLook::{
                                ..view::words_plain,
                                size: 15.0 * scale,
                                weight: 400,
                                line: 24.0 * scale,
                                wrap: true,
                              },
                            )
                          },
                        )
                      }

                      let body_line = body_size * 1.66
                      let mut i = 0
                      while i < art.blocks.length() {
                        let blk = art.blocks[i]
                        match blk.kind {
                          proto::ReaderBlockKind::Heading => {
                            let h_size = if blk.level <= 2 { 21.5 * scale } else { 18.0 * scale }
                            let _ = doc_box.box(
                              fn(hb : view::View) -> Unit {
                                let _ = hb
                                .padding(view::Live::Is((0.0, 10.0, 0.0, 0.0)))
                                .words_runs(
                                  view::Live::Is([rb_make_run(blk.text, ink, font, weight=600)]),
                                  ink=ink,
                                  look=view::WordsLook::{
                                    ..view::words_plain,
                                    size: h_size,
                                    weight: 600,
                                    line: h_size * 1.32,
                                    wrap: true,
                                  },
                                )
                              },
                            )
                          }
                          proto::ReaderBlockKind::Quote => {
                            let _ = doc_box.box(
                              fn(qb : view::View) -> Unit {
                                let _ = qb
                                .row(view::Live::Is(true))
                                .padding(view::Live::Is((14.0, 12.0, 16.0, 12.0)))
                                .gap(view::Live::Is(12.0))
                                .radius(view::Live::Is(8.0))
                                .ground(view::Live::Is(surface_bg))
                                // Left vertical accent bar
                                let _ = qb.box(
                                  fn(vbar : view::View) -> Unit {
                                    let _ = vbar
                                    .width(view::Live::Is(Some(3.0)))
                                    .rigid()
                                    .radius(view::Live::Is(1.5))
                                    .ground(view::Live::Is(accent))
                                  },
                                )
                                let _ = qb.box(
                                  fn(qt : view::View) -> Unit {
                                    let _ = qt
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .words_runs(
                                      view::Live::Is([rb_make_run(blk.text, ink, font, italic=true)]),
                                      ink=ink,
                                      look=view::WordsLook::{
                                        ..view::words_plain,
                                        size: body_size,
                                        weight: 400,
                                        line: body_line,
                                        wrap: true,
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          }
                          proto::ReaderBlockKind::Code => {
                            let code_size = 13.0 * scale
                            let _ = doc_box.box(
                              fn(cb : view::View) -> Unit {
                                let _ = cb
                                .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                                .radius(view::Live::Is(8.0))
                                .ground(view::Live::Is(surface_bg))
                                .edge(view::Live::Is((1.0, hairline)))
                                .words_runs(
                                  view::Live::Is([rb_make_run(blk.text, ink, font, force_mono=true)]),
                                  ink=ink,
                                  look=view::WordsLook::{
                                    ..view::words_plain,
                                    size: code_size,
                                    weight: 400,
                                    line: code_size * 1.55,
                                    wrap: true,
                                  },
                                )
                              },
                            )
                          }
                          proto::ReaderBlockKind::ListItem => {
                            let _ = doc_box.box(
                              fn(li : view::View) -> Unit {
                                let _ = li
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Start)))
                                .padding(view::Live::Is((6.0, 0.0, 0.0, 0.0)))
                                .gap(view::Live::Is(10.0))
                                // First-line aligned bullet dot (height matches first line height)
                                let _ = li.box(
                                  fn(bwrap : view::View) -> Unit {
                                    let _ = bwrap
                                    .width(view::Live::Is(Some(10.0)))
                                    .height(view::Live::Is(Some(body_line)))
                                    .rigid()
                                    .center()
                                    let _ = bwrap.box(
                                      fn(dot : view::View) -> Unit {
                                        let _ = dot
                                        .width(view::Live::Is(Some(5.0)))
                                        .height(view::Live::Is(Some(5.0)))
                                        .rigid()
                                        .radius(view::Live::Is(2.5))
                                        .ground(view::Live::Is(accent))
                                      },
                                    )
                                  },
                                )
                                let _ = li.box(
                                  fn(lt : view::View) -> Unit {
                                    let _ = lt
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .words_runs(
                                      view::Live::Is([rb_make_run(blk.text, ink, font)]),
                                      ink=ink,
                                      look=view::WordsLook::{
                                        ..view::words_plain,
                                        size: body_size,
                                        weight: 400,
                                        line: body_line,
                                        wrap: true,
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          }
                          proto::ReaderBlockKind::Paragraph => {
                            let _ = doc_box.box(
                              fn(pb : view::View) -> Unit {
                                let _ = pb.words_runs(
                                  view::Live::Is([rb_make_run(blk.text, ink, font)]),
                                  ink=ink,
                                  look=view::WordsLook::{
                                    ..view::words_plain,
                                    size: body_size,
                                    weight: 400,
                                    line: body_line,
                                    wrap: true,
                                  },
                                )
                              },
                            )
                          }
                        }
                        i = i + 1
                      }
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Builds the Arc Boosts floating card overlay (`Cmd+Shift+E` or address bar `✦` badge).
///| Mutually exclusive with all other overlays; concentric 14 -> 8 -> 6pt radii.
fn build_boosts_overlay(
  root : view::View,
  boosts_open : signals::Signal[Bool],
  boosts_rev : signals::Signal[Int],
  boosts_css_field : ui::Field,
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let active_space_color = fn() -> Int64 {
    let _ = workspace_rev.get()
    match proto::workspace_active_space(app_state.workspace) {
      Some(sp) => proto::workspace_accent_color(sp.accent)
      None => 0x6D28D9FFL
    }
  }

  root.show(
    fn() -> Bool { boosts_open.get() },
    fn(card : view::View) -> Unit {
      let _ = card
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        let top = match app_state.address_bar_view {
          Some(ab) => {
            let (_, ay, _, ah) = ab.placed_now()
            if ah > 0.0 { ay + ah + 6.0 } else { 48.0 }
          }
          None => 48.0
        }
        (None, Some(top), Some(14.0), None)
      }))
      .width(view::Live::Is(Some(336.0)))
      .clips(view::Live::Is(true))
      .radius(view::Live::Is(14.0))
      .ground(view::Live::Is(0xFFFFFFFFL))
      .edge(view::Live::Is((1.0, 0xDCDCE4FFL)))
      .shadow(view::Live::Is((26.0, 10.0, 0x0F172A2EL)))

      let cur_boost = fn() -> proto::SiteBoost {
        let _ = boosts_rev.get()
        current_site_boost()
      }

      // 1. Header: Arc Boosts + domain badge + Active toggle + Close
      let _ = card.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(46.0)))
          .rigid()
          .padding(view::Live::Is((14.0, 0.0, 12.0, 0.0)))
          .gap(view::Live::Is(8.0))

          let _ = hdr.box(
            fn(ico : view::View) -> Unit {
              let _ = ico
              .width(view::Live::Is(Some(24.0)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::Is(0xEDE9FEFFL))
              let _ = ico.box(
                fn(gl : view::View) -> Unit {
                  let _ = gl.words(
                    view::Live::Is("✦"),
                    ink=0x6D28D9FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )

          let _ = hdr.box(
            fn(tcol : view::View) -> Unit {
              let _ = tcol
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .clips(view::Live::Is(true))
              .gap(view::Live::Is(1.0))
              let _ = tcol.box(
                fn(t1 : view::View) -> Unit {
                  let _ = t1.words(
                    view::Live::Is("Arc Boosts"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = tcol.box(
                fn(t2 : view::View) -> Unit {
                  let _ = t2
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(fn() -> String { cur_boost().host }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )

          // Active master switch pill
          let _ = headless::button(
            hdr,
            fn() -> String { "Toggle Boost Active" },
            fn(_v : view::View) -> Unit {
              let b = current_site_boost()
              let next_on = !b.enabled
              let next_theme = if next_on && b.theme == "auto" && b.font == "default" && b.scale_pct == 100 && !b.hide_sticky && b.custom_css == "" {
                "dark"
              } else {
                b.theme
              }
              let next = proto::SiteBoost::{ ..b, enabled: next_on, theme: next_theme }
              let msg = if next_on { "Boost enabled for " + next.host } else { "Boost paused for " + next.host }
              dispatch_boost_save(next, toast_msg=msg)
            },
            fn(sw : view::View, sbtn : headless::Button) -> Unit {
              let is_on = fn() -> Bool { cur_boost().enabled }
              let _ = sw
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .gap(view::Live::Is(5.0))
              .radius(view::Live::Is(12.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_on() {
                  active_space_color()
                } else if sbtn.hovered() || sbtn.pressed() {
                  0xE5E7EBFFL
                } else {
                  0xF1F5F9FFL
                }
              }))
              let _ = sw.box(
                fn(dot : view::View) -> Unit {
                  let _ = dot
                  .width(view::Live::Is(Some(6.0)))
                  .height(view::Live::Is(Some(6.0)))
                  .rigid()
                  .radius(view::Live::Is(3.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_on() { 0xFFFFFFFFL } else { 0x94A3B8FFL }
                  }))
                },
              )
              let _ = sw.box(
                fn(lbl : view::View) -> Unit {
                  let _ = lbl
                  .words(
                    view::Live::By(fn() -> String { if is_on() { "Active" } else { "Off" } }),
                    ink=0xFFFFFFFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    if is_on() { 0xFFFFFFFFL } else { 0x4B5563FFL }
                  }))
                },
              )
            },
          )

          // Close button
          let _ = headless::button(
            hdr,
            fn() -> String { "Close Arc Boosts" },
            fn(_v : view::View) -> Unit { close_boosts() },
            fn(xb : view::View, xbtn : headless::Button) -> Unit {
              let _ = xb
              .width(view::Live::Is(Some(24.0)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if xbtn.pressed() { 0xE5E7EBFFL } else if xbtn.hovered() { 0xF3F4F6FFL } else { 0x00000000L }
              }))
              let _ = xb.box(
                fn(xl : view::View) -> Unit {
                  let _ = xl.words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
        },
      )

      // Single 1pt hairline under header
      let _ = card.box(
        fn(hsep : view::View) -> Unit {
          let _ = hsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::Is(0xECEEF4FFL))
        },
      )

      // 2. Body controls
      let _ = card.box(
        fn(body : view::View) -> Unit {
          let _ = body.padding(view::Live::Is((14.0, 12.0, 14.0, 14.0))).gap(view::Live::Is(12.0))

          // Section A: Theme Swatches (Auto / Dark / Sepia / Contrast)
          let _ = body.box(
            fn(sec : view::View) -> Unit {
              let _ = sec.gap(view::Live::Is(6.0))
              let _ = sec.box(
                fn(lbl : view::View) -> Unit {
                  let _ = lbl.words(
                    view::Live::Is("THEME"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = sec.box(
                fn(row : view::View) -> Unit {
                  let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(6.0))
                  let swatch_btn = fn(id : String, label : String, fill : Int64, dot : Int64) -> Unit {
                    let is_sel = fn() -> Bool { cur_boost().theme == id }
                    let _ = headless::button(
                      row,
                      fn() -> String { "Boost Theme " + label },
                      fn(_v : view::View) -> Unit {
                        let b = current_site_boost()
                        let next = proto::SiteBoost::{ ..b, enabled: true, theme: id }
                        dispatch_boost_save(next, toast_msg="Boost theme: " + label)
                      },
                      fn(sb : view::View, sbtn : headless::Button) -> Unit {
                        let _ = sb
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .height(view::Live::Is(Some(46.0)))
                        .center()
                        .gap(view::Live::Is(4.0))
                        .radius(view::Live::Is(8.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          if is_sel() {
                            0xF5F3FFFFL
                          } else if sbtn.hovered() || sbtn.pressed() {
                            0xF3F4F6FFL
                          } else {
                            0xF8F9FCFFL
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          if is_sel() { (1.5, active_space_color()) } else { (1.0, 0xE5E7EBFFL) }
                        }))
                        let _ = sb.box(
                          fn(chip : view::View) -> Unit {
                            let _ = chip
                            .width(view::Live::Is(Some(18.0)))
                            .height(view::Live::Is(Some(18.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(9.0))
                            .ground(view::Live::Is(fill))
                            .edge(view::Live::Is((1.0, 0xCBD5E1FFL)))
                            let _ = chip.box(
                              fn(inner : view::View) -> Unit {
                                let _ = inner
                                .width(view::Live::Is(Some(6.0)))
                                .height(view::Live::Is(Some(6.0)))
                                .rigid()
                                .radius(view::Live::Is(3.0))
                                .ground(view::Live::Is(dot))
                              },
                            )
                          },
                        )
                        let _ = sb.box(
                          fn(tl : view::View) -> Unit {
                            let _ = tl
                            .words(
                              view::Live::Is(label),
                              ink=0x374151FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              if is_sel() { active_space_color() } else { 0x374151FFL }
                            }))
                          },
                        )
                      },
                    )
                  }
                  swatch_btn("auto", "Auto", 0xFFFFFFFFL, 0x94A3B8FFL)
                  swatch_btn("dark", "Dark", 0x14161DFFL, 0x60A5FAFFL)
                  swatch_btn("sepia", "Sepia", 0xF5ECDCFFL, 0x9A501FFFL)
                  swatch_btn("contrast", "Contrast", 0x000000FFL, 0xFFE600FFL)
                },
              )
            },
          )

          // Section B: Font Family Pills (Default / Sans / Serif / Mono)
          let _ = body.box(
            fn(sec : view::View) -> Unit {
              let _ = sec.gap(view::Live::Is(6.0))
              let _ = sec.box(
                fn(lbl : view::View) -> Unit {
                  let _ = lbl.words(
                    view::Live::Is("TYPOGRAPHY"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = sec.box(
                fn(seg : view::View) -> Unit {
                  let _ = seg
                  .row(view::Live::Is(true))
                  .padding(view::Live::Is((3.0, 3.0, 3.0, 3.0)))
                  .gap(view::Live::Is(3.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::Is(0xF3F4F6FFL))
                  .edge(view::Live::Is((1.0, 0xE5E7EBFFL)))

                  let font_pill = fn(id : String, label : String) -> Unit {
                    let is_sel = fn() -> Bool { cur_boost().font == id }
                    let _ = headless::button(
                      seg,
                      fn() -> String { "Boost Font " + label },
                      fn(_v : view::View) -> Unit {
                        let b = current_site_boost()
                        let next = proto::SiteBoost::{ ..b, enabled: true, font: id }
                        dispatch_boost_save(next, toast_msg="Boost font: " + label)
                      },
                      fn(fb : view::View, fbtn : headless::Button) -> Unit {
                        let _ = fb
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .height(view::Live::Is(Some(26.0)))
                        .center()
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          if is_sel() {
                            0xFFFFFFFFL
                          } else if fbtn.hovered() || fbtn.pressed() {
                            0xE5E7EBFFL
                          } else {
                            0x00000000L
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          if is_sel() { (1.0, 0xDCE0ECFFL) } else { (0.0, 0x00000000L) }
                        }))
                        let _ = fb.box(
                          fn(fl : view::View) -> Unit {
                            let _ = fl
                            .words(
                              view::Live::Is(label),
                              ink=0x374151FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              if is_sel() { active_space_color() } else { 0x4B5563FFL }
                            }))
                          },
                        )
                      },
                    )
                  }
                  font_pill("default", "Default")
                  font_pill("sans", "Sans")
                  font_pill("serif", "Serif")
                  font_pill("mono", "Mono")
                },
              )
            },
          )

          // Section C: Text Size Stepper (90%..130%) & Hide Sticky Overlays Switch
          let _ = body.box(
            fn(card_opts : view::View) -> Unit {
              let _ = card_opts
              .padding(view::Live::Is((10.0, 8.0, 10.0, 8.0)))
              .gap(view::Live::Is(8.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::Is(0xF8F9FCFFL))
              .edge(view::Live::Is((1.0, 0xECEEF4FFL)))

              // Text size row
              let _ = card_opts.box(
                fn(srow : view::View) -> Unit {
                  let _ = srow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .gap(view::Live::Is(8.0))
                  let _ = srow.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("Text Size"),
                        ink=0x1F2937FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                  let step_size = fn(lbl : String, delta : Int) -> Unit {
                    let _ = headless::button(
                      srow,
                      fn() -> String { "Boost Text Size " + lbl },
                      fn(_v : view::View) -> Unit {
                        let b = current_site_boost()
                        let next_pct = proto::clamp_boost_scale_pct(b.scale_pct + delta)
                        let next = proto::SiteBoost::{ ..b, enabled: true, scale_pct: next_pct }
                        dispatch_boost_save(next, toast_msg="Text size: " + next_pct.to_string() + "%")
                      },
                      fn(sb : view::View, sbtn : headless::Button) -> Unit {
                        let _ = sb
                        .width(view::Live::Is(Some(26.0)))
                        .height(view::Live::Is(Some(24.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          if sbtn.pressed() { 0xE5E7EBFFL } else if sbtn.hovered() { 0xF3F4F6FFL } else { 0xFFFFFFFFL }
                        }))
                        .edge(view::Live::Is((1.0, 0xDCE0ECFFL)))
                        let _ = sb.box(
                          fn(tl : view::View) -> Unit {
                            let _ = tl.words(
                              view::Live::Is(lbl),
                              ink=0x1F2937FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                              one_line=true,
                            )
                          },
                        )
                      },
                    )
                  }
                  step_size("−", -5)
                  let _ = srow.box(
                    fn(pv : view::View) -> Unit {
                      let _ = pv
                      .width(view::Live::Is(Some(42.0)))
                      .rigid()
                      .center()
                      let _ = pv.box(
                        fn(pl : view::View) -> Unit {
                          let _ = pl.words(
                            view::Live::By(fn() -> String { cur_boost().scale_pct.to_string() + "%" }),
                            ink=0x1F2937FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                        },
                      )
                    },
                  )
                  step_size("+", 5)
                },
              )

              // Single inner hairline between Text Size and Hide Sticky Overlays
              let _ = card_opts.box(
                fn(msep : view::View) -> Unit {
                  let _ = msep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::Is(0xECEEF4FFL))
                },
              )

              // Hide sticky overlays toggle row
              let _ = card_opts.box(
                fn(hrow : view::View) -> Unit {
                  let _ = hrow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .gap(view::Live::Is(8.0))
                  let _ = hrow.box(
                    fn(hl : view::View) -> Unit {
                      let _ = hl
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("Hide sticky overlays"),
                        ink=0x1F2937FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                  let _ = headless::button(
                    hrow,
                    fn() -> String { "Toggle Hide Sticky Overlays" },
                    fn(_v : view::View) -> Unit {
                      let b = current_site_boost()
                      let next_hide = !b.hide_sticky
                      let next = proto::SiteBoost::{ ..b, enabled: true, hide_sticky: next_hide }
                      let msg = if next_hide { "Hiding sticky banners & popups" } else { "Showing sticky overlays" }
                      dispatch_boost_save(next, toast_msg=msg)
                    },
                    fn(sw : view::View, _sbtn : headless::Button) -> Unit {
                      let is_on = fn() -> Bool { cur_boost().hide_sticky }
                      let _ = sw
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .width(view::Live::Is(Some(36.0)))
                      .height(view::Live::Is(Some(20.0)))
                      .rigid()
                      .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
                        if is_on() { (18.0, 2.0, 2.0, 2.0) } else { (2.0, 2.0, 18.0, 2.0) }
                      }))
                      .radius(view::Live::Is(10.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        if is_on() { active_space_color() } else { 0xCBD5E1FFL }
                      }))
                      let _ = sw.box(
                        fn(knob : view::View) -> Unit {
                          let _ = knob
                          .width(view::Live::Is(Some(16.0)))
                          .height(view::Live::Is(Some(16.0)))
                          .rigid()
                          .radius(view::Live::Is(8.0))
                          .ground(view::Live::Is(0xFFFFFFFFL))
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Section D: Custom CSS input (registered in is_chrome_field_focused)
          let _ = body.box(
            fn(sec : view::View) -> Unit {
              let _ = sec.gap(view::Live::Is(6.0))
              let _ = sec.box(
                fn(lbl : view::View) -> Unit {
                  let _ = lbl.words(
                    view::Live::Is("CUSTOM CSS"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = sec.box(
                fn(crow : view::View) -> Unit {
                  let _ = crow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(6.0))
                  let _ = crow.box(
                    fn(fwrap : view::View) -> Unit {
                      let _ = fwrap
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(30.0)))
                      .padding(view::Live::Is((8.0, 4.0, 8.0, 4.0)))
                      .radius(view::Live::Is(6.0))
                      .clips(view::Live::Is(true))
                      .ground(view::Live::Is(0xF8F9FCFFL))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        if boosts_css_field.focused() { (1.5, active_space_color()) } else { (1.0, 0xDCE0ECFFL) }
                      }))
                      let _ = ui::field(
                        fwrap,
                        boosts_css_field,
                        placeholder="e.g. article p { line-height: 1.8; }",
                        font_size=12.0,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(raw : String) -> Unit {
                          let b = current_site_boost()
                          let next = proto::SiteBoost::{ ..b, enabled: true, custom_css: raw }
                          dispatch_boost_save(next, toast_msg="Applied Custom CSS")
                        },
                      )
                    },
                  )
                  let _ = headless::button(
                    crow,
                    fn() -> String { "Apply Custom CSS" },
                    fn(_v : view::View) -> Unit {
                      let raw = boosts_css_field.text()
                      let b = current_site_boost()
                      let next = proto::SiteBoost::{ ..b, enabled: true, custom_css: raw }
                      dispatch_boost_save(next, toast_msg="Applied Custom CSS")
                    },
                    fn(ab : view::View, abtn : headless::Button) -> Unit {
                      let _ = ab
                      .height(view::Live::Is(Some(30.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        if abtn.pressed() { 0xE2E6F0FFL } else if abtn.hovered() { 0xECEEF5FFL } else { 0xF3F4F6FFL }
                      }))
                      .edge(view::Live::Is((1.0, 0xDCE0ECFFL)))
                      let _ = ab.box(
                        fn(al : view::View) -> Unit {
                          let _ = al.words(
                            view::Live::Is("Apply"),
                            ink=0x1F2937FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Footer: live persistence status + Reset button
          let _ = body.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))
              let _ = ftr.box(
                fn(st_lbl : view::View) -> Unit {
                  let _ = st_lbl
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(fn() -> String {
                      let b = cur_boost()
                      if b.enabled { "Live on " + b.host } else { "Changes apply live without reload" }
                    }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = headless::button(
                ftr,
                fn() -> String { "Reset Site Boost" },
                fn(_v : view::View) -> Unit {
                  let h = current_boost_host()
                  app_state.syncing_boosts_css = true
                  boosts_css_field.set("")
                  app_state.syncing_boosts_css = false
                  dispatch_boost_reset(h)
                },
                fn(rb : view::View, rbtn : headless::Button) -> Unit {
                  let _ = rb
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if rbtn.pressed() { 0xFEE2E2FFL } else if rbtn.hovered() { 0xFEF2F2FFL } else { 0xF8F9FCFFL }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    if rbtn.hovered() || rbtn.pressed() { (1.0, 0xFCA5A5FFL) } else { (1.0, 0xDCE0ECFFL) }
                  }))
                  let _ = rb.box(
                    fn(rl : view::View) -> Unit {
                      let _ = rl
                      .words(
                        view::Live::Is("Reset"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        if rbtn.hovered() || rbtn.pressed() { 0xDC2626FFL } else { 0x4B5563FFL }
                      }))
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
