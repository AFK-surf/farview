///| Native Metal Daily-Driver Chrome UX Overlays:
///| 1. Cross-Space Global Tab & Recently Closed Search (`Cmd+Shift+A` / `Ctrl+Shift+A`, `--demo-tab-search`)
///| 2. Native Screenshot Saved Capture Sheet (`Cmd+Shift+S`, `--demo-capture-sheet`)
///|
///| Uses concentric corner radii (`14 -> 10 -> 8 -> 6pt` and `12 -> 8 -> 6pt`),
///| first-line alignment, zero `·` metadata concatenation, zero double/dangling dividers,
///| zero `alpha=0` clickable buttons, full Light & Dark `ChromePalette` parity, UTF-8 safe.

// --- 1. Cross-Space Global Tab Search Overlay (`Cmd+Shift+A`, 560pt centered glass modal) ---

fn build_tab_search_overlay(
  root : view::View,
  tab_search_open : signals::Signal[Bool],
  tab_search_query : signals::Signal[String],
  tab_search_selected : signals::Signal[Int],
  tab_search_field : ui::Field,
  workspace_rev : signals::Signal[Int],
  closed_tabs_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { tab_search_open.get() },
    fn(layer : view::View) -> Unit {
      let _ = layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Backdrop click dismisses overlay
      let _ = headless::button(
        layer,
        fn() -> String { "Dismiss Tab Search" },
        fn(_v : view::View) -> Unit { close_tab_search() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05070C99L } else { 0x0F172A40L }
          }))
        },
      )

      let get_results = fn() -> proto::TabSearchResult {
        let _ = workspace_rev.get()
        let _ = closed_tabs_rev.get()
        let _ = tab_search_query.get()
        current_tab_search_results()
      }

      // Centered 560pt glass card (concentric radii 14 -> 10 -> 8 -> 6pt)
      let _ = layer.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(560.0)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(14.0))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x1E222CF4L } else { 0xFFFFFFF7L }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            if is_dark_chrome() { (1.0, 0x394155FFL) } else { (1.0, 0xD8DCE8FFL) }
          }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (36.0, 14.0, 0x00000099L) } else { (32.0, 12.0, 0x0F172A32L) }
          }))

          card.reacts(fn() -> String { tab_search_field.text() }, fn(q : String) -> Unit {
            if tab_search_open.untracked() {
              tab_search_query.set(q)
              tab_search_selected.set(0)
            }
          })

          // 1. Top Search Row + Independent Open/Closed Count Capsules + Esc badge
          let _ = card.box(
            fn(srow : view::View) -> Unit {
              let _ = srow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(38.0)))
              .rigid()
              .padding(view::Live::Is((10.0, 0.0, 8.0, 0.0)))
              .gap(view::Live::Is(8.0))
              .radius(view::Live::Is(10.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let p = chrome_palette()
                if tab_search_field.focused() { (1.2, p.accent) } else { (1.0, p.border) }
              }))

              // Search glyph
              let _ = srow.box(
                fn(ic : view::View) -> Unit {
                  let _ = ic
                  .width(view::Live::Is(Some(16.0)))
                  .center()
                  .rigid()
                  .words(
                    view::Live::Is("⌕"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 15.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if tab_search_field.focused() { p.accent } else { p.ink_muted }
                  }))
                },
              )

              // Search Input Field
              let _ = srow.box(
                fn(fw : view::View) -> Unit {
                  let _ = fw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(28.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))

                  fw.show(
                    fn() -> Bool { !is_dark_chrome() },
                    fn(fl : view::View) -> Unit {
                      let _ = fl
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      let _ = ui::field(
                        fl,
                        tab_search_field,
                        placeholder="Search open & recently closed tabs...",
                        font_size=13.5,
                        color=0x1D1D1FFFL,
                        placeholder_color=0x8E8E93FFL,
                        caret_color=0x2563EBFFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(_v : String) -> Unit { commit_tab_search_selection() },
                      )
                    },
                  )
                  fw.show(
                    fn() -> Bool { is_dark_chrome() },
                    fn(fd : view::View) -> Unit {
                      let _ = fd
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      let _ = ui::field(
                        fd,
                        tab_search_field,
                        placeholder="Search open & recently closed tabs...",
                        font_size=13.5,
                        color=0xF1F5F9FFL,
                        placeholder_color=0x94A3B8FFL,
                        caret_color=0x60A5FAFFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(_v : String) -> Unit { commit_tab_search_selection() },
                      )
                    },
                  )
                },
              )

              // Independent Open count capsule (no `·` concatenation)
              let _ = srow.box(
                fn(open_pill : view::View) -> Unit {
                  let _ = open_pill
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                  let _ = open_pill.box(
                    fn(t : view::View) -> Unit {
                      let _ = t
                      .words(
                        view::Live::By(fn() -> String {
                          get_results().total_open.to_string() + " Open"
                        }),
                        ink=0x1D4ED8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )

              // Independent Closed count capsule (no `·` concatenation)
              let _ = srow.box(
                fn(closed_pill : view::View) -> Unit {
                  let _ = closed_pill
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = closed_pill.box(
                    fn(t : view::View) -> Unit {
                      let _ = t
                      .words(
                        view::Live::By(fn() -> String {
                          get_results().total_closed.to_string() + " Closed"
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                },
              )
            },
          )

          // Single 1pt hairline divider below search row
          let _ = card.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // 2. OPEN TABS Group (only rendered when open_items non-empty)
          card.show(
            fn() -> Bool { get_results().open_items.length() > 0 },
            fn(osec : view::View) -> Unit {
              let _ = osec.gap(view::Live::Is(3.0))

              // Section heading
              let _ = osec.box(
                fn(ohdr : view::View) -> Unit {
                  let _ = ohdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                  let _ = ohdr.box(
                    fn(ol : view::View) -> Unit {
                      let _ = ol
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("OPEN TABS"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                  let _ = ohdr.box(
                    fn(oc : view::View) -> Unit {
                      let _ = oc
                      .words(
                        view::Live::By(fn() -> String {
                          let n = get_results().total_open
                          if n == 1 { "1 tab across Spaces" } else { n.to_string() + " tabs across Spaces" }
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Open tab rows (fixed slot pool up to TAB_SEARCH_MAX_OPEN)
              let mut slot = 0
              while slot < proto::TAB_SEARCH_MAX_OPEN {
                let idx = slot
                osec.show(
                  fn() -> Bool { idx < get_results().open_items.length() },
                  fn(row_slot : view::View) -> Unit {
                    let is_selected = fn() -> Bool { tab_search_selected.get() == idx }
                    let get_item = fn() -> Option[proto::TabSearchItem] {
                      let items = get_results().open_items
                      if idx < items.length() { Some(items[idx]) } else { None }
                    }
                    let _ = row_slot
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .height(view::Live::Is(Some(46.0)))
                    .rigid()
                    .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
                    .gap(view::Live::Is(8.0))
                    .radius(view::Live::Is(8.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_selected() {
                        p.accent_soft_bg
                      } else if row_slot.pointed() {
                        p.tab_hover_bg
                      } else {
                        0x00000000L
                      }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      let p = chrome_palette()
                      if is_selected() { (1.0, p.accent_soft_border) } else { (1.0, 0x00000000L) }
                    }))

                    // Main clickable switch-to-tab region
                    let _ = headless::button(
                      row_slot,
                      fn() -> String {
                        match get_item() {
                          Some(it) => "Switch to " + it.title
                          None => "Switch Tab"
                        }
                      },
                      fn(_v : view::View) -> Unit {
                        match get_item() {
                          Some(it) => activate_tab_search_item(it)
                          None => ()
                        }
                      },
                      fn(main_b : view::View, _btn : headless::Button) -> Unit {
                        let _ = main_b
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .height(view::Live::Is(Some(42.0)))
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .gap(view::Live::Is(10.0))

                        // Monogram badge (26x26, concentric R=6pt)
                        let _ = main_b.box(
                          fn(mono : view::View) -> Unit {
                            let _ = mono
                            .width(view::Live::Is(Some(26.0)))
                            .height(view::Live::Is(Some(26.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              match get_item() {
                                Some(it) => space_badge_tint_themed(it.space_accent, false, false, is_dark_chrome()).0
                                None => chrome_palette().surface_subtle
                              }
                            }))
                            .edge(view::Live::By(fn() -> (Double, Int64) {
                              match get_item() {
                                Some(it) => (1.0, space_badge_tint_themed(it.space_accent, false, false, is_dark_chrome()).1)
                                None => (1.0, chrome_palette().hairline)
                              }
                            }))
                            let _ = mono.box(
                              fn(ml : view::View) -> Unit {
                                let _ = ml
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(it) => proto::omnibox_initial_letter(it.url, it.title)
                                      None => "T"
                                    }
                                  }),
                                  ink=0x2563EBFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 700, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  match get_item() {
                                    Some(it) => it.space_accent_rgba
                                    None => chrome_palette().accent
                                  }
                                }))
                              },
                            )
                          },
                        )

                        // Title + Domain/Status two-line stack
                        let _ = main_b.box(
                          fn(meta : view::View) -> Unit {
                            let _ = meta
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .gap(view::Live::Is(2.0))

                            // Title row (first-line aligned with subtle state dots)
                            let _ = meta.box(
                              fn(trow : view::View) -> Unit {
                                let _ = trow
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .gap(view::Live::Is(6.0))

                                let _ = trow.box(
                                  fn(tl : view::View) -> Unit {
                                    let _ = tl
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(it) => it.title
                                          None => ""
                                        }
                                      }),
                                      ink=0x1D1D1FFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                  },
                                )
                              },
                            )

                            // Subtitle row: display_host + independent status badges (no `·` concatenation)
                            let _ = meta.box(
                              fn(srow2 : view::View) -> Unit {
                                let _ = srow2
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .gap(view::Live::Is(6.0))

                                let _ = srow2.box(
                                  fn(hl : view::View) -> Unit {
                                    let _ = hl
                                    .shrink(view::Live::Is(1.0))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(it) => it.display_host
                                          None => ""
                                        }
                                      }),
                                      ink=0x6B7280FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )

                                // Active indicator dot + label
                                srow2.show(
                                  fn() -> Bool {
                                    match get_item() {
                                      Some(it) => it.is_active
                                      None => false
                                    }
                                  },
                                  fn(act_b : view::View) -> Unit {
                                    let _ = act_b
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .rigid()
                                    .gap(view::Live::Is(4.0))
                                    .padding(view::Live::Is((5.0, 1.0, 5.0, 1.0)))
                                    .radius(view::Live::Is(4.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      if is_dark_chrome() { 0x1E3A5FFFL } else { 0xDBEAFEFFL }
                                    }))
                                    let _ = act_b.box(
                                      fn(at : view::View) -> Unit {
                                        let _ = at
                                        .words(
                                          view::Live::Is("Current"),
                                          ink=0x1D4ED8FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 {
                                          if is_dark_chrome() { 0x93C5FDFFL } else { 0x1D4ED8FFL }
                                        }))
                                      },
                                    )
                                  },
                                )

                                // Playing audio indicator
                                srow2.show(
                                  fn() -> Bool {
                                    match get_item() {
                                      Some(it) => it.is_playing_audio
                                      None => false
                                    }
                                  },
                                  fn(pl_b : view::View) -> Unit {
                                    let _ = pl_b
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .rigid()
                                    .gap(view::Live::Is(4.0))
                                    .padding(view::Live::Is((5.0, 1.0, 5.0, 1.0)))
                                    .radius(view::Live::Is(4.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      if is_dark_chrome() { 0x132A21FFL } else { 0xDCFCE7FFL }
                                    }))
                                    let _ = pl_b.box(
                                      fn(pd : view::View) -> Unit {
                                        let _ = pd
                                        .width(view::Live::Is(Some(5.0)))
                                        .height(view::Live::Is(Some(5.0)))
                                        .rigid()
                                        .radius(view::Live::Is(2.5))
                                        .ground(view::Live::Is(0x10B981FFL))
                                      },
                                    )
                                    let _ = pl_b.box(
                                      fn(pt : view::View) -> Unit {
                                        let _ = pt
                                        .words(
                                          view::Live::Is("Playing"),
                                          ink=0x15803DFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 {
                                          if is_dark_chrome() { 0x6EE7B7FFL } else { 0x15803DFFL }
                                        }))
                                      },
                                    )
                                  },
                                )

                                // Pinned / Favorite subtle indicator
                                srow2.show(
                                  fn() -> Bool {
                                    match get_item() {
                                      Some(it) => (it.is_pinned || it.is_favorite) && !it.is_playing_audio
                                      None => false
                                    }
                                  },
                                  fn(pn_b : view::View) -> Unit {
                                    let _ = pn_b
                                    .rigid()
                                    .padding(view::Live::Is((5.0, 1.0, 5.0, 1.0)))
                                    .radius(view::Live::Is(4.0))
                                    .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                                    let _ = pn_b.box(
                                      fn(pt : view::View) -> Unit {
                                        let _ = pt
                                        .words(
                                          view::Live::By(fn() -> String {
                                            match get_item() {
                                              Some(it) => if it.is_favorite { "Favorite" } else { "Pinned" }
                                              None => "Pinned"
                                            }
                                          }),
                                          ink=0x6B7280FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          },
                        )

                        // Space colored dot capsule
                        let _ = main_b.box(
                          fn(sp_pill : view::View) -> Unit {
                            let _ = sp_pill
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .height(view::Live::Is(Some(22.0)))
                            .rigid()
                            .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                            .gap(view::Live::Is(5.0))
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              match get_item() {
                                Some(it) => space_badge_tint_themed(it.space_accent, false, false, is_dark_chrome()).0
                                None => chrome_palette().surface_subtle
                              }
                            }))
                            .edge(view::Live::By(fn() -> (Double, Int64) {
                              match get_item() {
                                Some(it) => (1.0, space_badge_tint_themed(it.space_accent, false, false, is_dark_chrome()).1)
                                None => (1.0, chrome_palette().hairline)
                              }
                            }))
                            let _ = sp_pill.box(
                              fn(sd : view::View) -> Unit {
                                let _ = sd
                                .width(view::Live::Is(Some(6.0)))
                                .height(view::Live::Is(Some(6.0)))
                                .rigid()
                                .radius(view::Live::Is(3.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  match get_item() {
                                    Some(it) => it.space_accent_rgba
                                    None => 0x2563EBFFL
                                  }
                                }))
                              },
                            )
                            let _ = sp_pill.box(
                              fn(sn : view::View) -> Unit {
                                let _ = sn
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(it) => it.space_name
                                      None => ""
                                    }
                                  }),
                                  ink=0x1D1D1FFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                              },
                            )
                          },
                        )
                      },
                    )

                    // Inline Close `×` button: conditionally mounted via `.show(...)` (NEVER alpha=0 clickable!)
                    row_slot.show(
                      fn() -> Bool { row_slot.pointed() || is_selected() },
                      fn(x_wrap : view::View) -> Unit {
                        let _ = x_wrap.rigid()
                        let _ = headless::button(
                          x_wrap,
                          fn() -> String { "Close Tab" },
                          fn(_v : view::View) -> Unit {
                            match get_item() {
                              Some(it) => dispatch_tab_close(it.id)
                              None => ()
                            }
                          },
                          fn(xb : view::View, xbtn : headless::Button) -> Unit {
                            let _ = xb
                            .width(view::Live::Is(Some(22.0)))
                            .height(view::Live::Is(Some(22.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                            }))
                            let _ = xb.box(
                              fn(xl : view::View) -> Unit {
                                let _ = xl
                                .words(
                                  view::Live::Is("×"),
                                  ink=0x6B7280FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
                slot = slot + 1
              }
            },
          )

          // Conditional single 1pt hairline divider ONLY when both Open & Recently Closed sections exist
          card.show(
            fn() -> Bool {
              let r = get_results()
              r.open_items.length() > 0 && r.closed_items.length() > 0
            },
            fn(mid_sep : view::View) -> Unit {
              let _ = mid_sep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // 3. RECENTLY CLOSED Group (only rendered when closed_items non-empty)
          card.show(
            fn() -> Bool { get_results().closed_items.length() > 0 },
            fn(csec : view::View) -> Unit {
              let _ = csec.gap(view::Live::Is(3.0))

              let _ = csec.box(
                fn(chdr : view::View) -> Unit {
                  let _ = chdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                  let _ = chdr.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("RECENTLY CLOSED"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              let mut cslot = 0
              while cslot < proto::TAB_SEARCH_MAX_CLOSED {
                let cidx = cslot
                csec.show(
                  fn() -> Bool { cidx < get_results().closed_items.length() },
                  fn(crow : view::View) -> Unit {
                    let flat_idx = fn() -> Int { get_results().open_items.length() + cidx }
                    let is_selected = fn() -> Bool { tab_search_selected.get() == flat_idx() }
                    let get_item = fn() -> Option[proto::TabSearchItem] {
                      let items = get_results().closed_items
                      if cidx < items.length() { Some(items[cidx]) } else { None }
                    }
                    let _ = crow
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .height(view::Live::Is(Some(42.0)))
                    .rigid()
                    .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
                    .gap(view::Live::Is(8.0))
                    .radius(view::Live::Is(8.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_selected() {
                        p.accent_soft_bg
                      } else if crow.pointed() {
                        p.tab_hover_bg
                      } else {
                        0x00000000L
                      }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      let p = chrome_palette()
                      if is_selected() { (1.0, p.accent_soft_border) } else { (1.0, 0x00000000L) }
                    }))

                    // Reopen icon badge
                    let _ = crow.box(
                      fn(ri : view::View) -> Unit {
                        let _ = ri
                        .width(view::Live::Is(Some(24.0)))
                        .height(view::Live::Is(Some(24.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                        let _ = ri.box(
                          fn(gl : view::View) -> Unit {
                            let _ = gl
                            .words(
                              view::Live::Is("↺"),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                          },
                        )
                      },
                    )

                    // Title + host stack
                    let _ = crow.box(
                      fn(cm : view::View) -> Unit {
                        let _ = cm
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .gap(view::Live::Is(1.0))
                        let _ = cm.box(
                          fn(tl : view::View) -> Unit {
                            let _ = tl
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(fn() -> String {
                                match get_item() {
                                  Some(it) => it.title
                                  None => ""
                                }
                              }),
                              ink=0x1D1D1FFFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                          },
                        )
                        let _ = cm.box(
                          fn(hl : view::View) -> Unit {
                            let _ = hl
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(fn() -> String {
                                match get_item() {
                                  Some(it) => it.display_host
                                  None => ""
                                }
                              }),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                          },
                        )
                      },
                    )

                    // Space pill
                    let _ = crow.box(
                      fn(csp : view::View) -> Unit {
                        let _ = csp
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .height(view::Live::Is(Some(20.0)))
                        .rigid()
                        .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                        .gap(view::Live::Is(4.0))
                        .radius(view::Live::Is(5.0))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                        let _ = csp.box(
                          fn(sd : view::View) -> Unit {
                            let _ = sd
                            .width(view::Live::Is(Some(5.0)))
                            .height(view::Live::Is(Some(5.0)))
                            .rigid()
                            .radius(view::Live::Is(2.5))
                            .ground(view::Live::By(fn() -> Int64 {
                              match get_item() {
                                Some(it) => it.space_accent_rgba
                                None => 0x64748BFFL
                              }
                            }))
                          },
                        )
                        let _ = csp.box(
                          fn(sn : view::View) -> Unit {
                            let _ = sn
                            .words(
                              view::Live::By(fn() -> String {
                                match get_item() {
                                  Some(it) => it.space_name
                                  None => ""
                                }
                              }),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                          },
                        )
                      },
                    )

                    // One-click Reopen button (concentric radius 6pt)
                    let _ = headless::button(
                      crow,
                      fn() -> String { "Reopen Closed Tab" },
                      fn(_v : view::View) -> Unit {
                        match get_item() {
                          Some(it) => activate_tab_search_item(it)
                          None => ()
                        }
                      },
                      fn(rb : view::View, rbtn : headless::Button) -> Unit {
                        let _ = rb
                        .height(view::Live::Is(Some(24.0)))
                        .rigid()
                        .center()
                        .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if rbtn.pressed() { p.btn_press } else if rbtn.hovered() { p.btn_hover } else { p.surface_subtle }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                        let _ = rb.box(
                          fn(rt : view::View) -> Unit {
                            let _ = rt
                            .words(
                              view::Live::Is("Reopen"),
                              ink=0x1D1D1FFFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                          },
                        )
                      },
                    )
                  },
                )
                cslot = cslot + 1
              }
            },
          )

          // Empty state when no tabs match query
          card.show(
            fn() -> Bool { get_results().total_count() == 0 },
            fn(empty_box : view::View) -> Unit {
              let _ = empty_box
              .height(view::Live::Is(Some(84.0)))
              .center()
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              let _ = empty_box.box(
                fn(et : view::View) -> Unit {
                  let _ = et
                  .words(
                    view::Live::Is("No open or recently closed tabs match your search"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )

          // Single 1pt hairline divider before footer hints
          let _ = card.box(
            fn(fsep : view::View) -> Unit {
              let _ = fsep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Footer shortcut hints (separate keycaps + labels, zero `·` concatenation)
          let _ = card.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((4.0, 2.0, 4.0, 0.0)))
              .gap(view::Live::Is(14.0))

              let hint_item = fn(keycap : String, desc : String) -> Unit {
                let _ = ftr.box(
                  fn(hi : view::View) -> Unit {
                    let _ = hi
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .rigid()
                    .gap(view::Live::Is(5.0))
                    let _ = hi.box(
                      fn(kc : view::View) -> Unit {
                        let _ = kc
                        .height(view::Live::Is(Some(18.0)))
                        .rigid()
                        .center()
                        .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                        .radius(view::Live::Is(4.5))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                        let _ = kc.box(
                          fn(kt : view::View) -> Unit {
                            let _ = kt
                            .words(
                              view::Live::Is(keycap),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                          },
                        )
                      },
                    )
                    let _ = hi.box(
                      fn(dl : view::View) -> Unit {
                        let _ = dl
                        .words(
                          view::Live::Is(desc),
                          ink=0x6B7280FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                      },
                    )
                  },
                )
              }

              hint_item("↑↓", "Select")
              hint_item("↵", "Switch or Reopen")
              let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
              hint_item("Esc", "Close")
            },
          )
        },
      )
    },
  )
}

// --- 2. Native Screenshot Saved Capture Sheet Overlay (`Cmd+Shift+S`, 320pt bottom-right card) ---

fn build_capture_sheet_overlay(
  root : view::View,
  capture_sheet_open : signals::Signal[Bool],
  capture_sheet_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { capture_sheet_open.get() },
    fn(card : view::View) -> Unit {
      let get_meta = fn() -> proto::CaptureSheetMeta {
        let _ = capture_sheet_rev.get()
        app_state.capture_sheet_meta
      }

      // 320pt wide bottom-right card, concentric radii 12 -> 8 -> 6pt
      let _ = card
      .over_at(view::Live::Is((None, None, Some(18.0), Some(18.0))))
      .width(view::Live::Is(Some(320.0)))
      .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
      .gap(view::Live::Is(9.0))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if is_dark_chrome() { (1.0, 0x394155FFL) } else { (1.0, chrome_palette().border) }
      }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (26.0, 10.0, 0x00000080L) } else { (22.0, 8.0, 0x0F172A28L) }
      }))

      // 1. Header row: Green completion dot + "Screenshot Saved" + independent Dims & Format capsules
      let _ = card.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(6.0))

          let _ = hdr.box(
            fn(dot : view::View) -> Unit {
              let _ = dot
              .width(view::Live::Is(Some(8.0)))
              .height(view::Live::Is(Some(8.0)))
              .rigid()
              .radius(view::Live::Is(4.0))
              .ground(view::Live::Is(0x10B981FFL))
            },
          )

          let _ = hdr.box(
            fn(ttl : view::View) -> Unit {
              let _ = ttl
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .clips(view::Live::Is(true))
              .words(
                view::Live::Is("Screenshot Saved"),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )

          // Independent Dimensions badge (e.g. `1280×800`)
          let _ = hdr.box(
            fn(dim_b : view::View) -> Unit {
              let _ = dim_b
              .height(view::Live::Is(Some(20.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
              let _ = dim_b.box(
                fn(dt : view::View) -> Unit {
                  let _ = dt
                  .words(
                    view::Live::By(fn() -> String {
                      let m = get_meta()
                      proto::capture_sheet_dims_badge(m.width, m.height)
                    }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                },
              )
            },
          )

          // Independent Format badge (e.g. `PNG`)
          let _ = hdr.box(
            fn(fmt_b : view::View) -> Unit {
              let _ = fmt_b
              .height(view::Live::Is(Some(20.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_dark_chrome() { 0x132A21FFL } else { 0xECFDF3FFL }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                (1.0, if is_dark_chrome() { 0x1E4B38FFL } else { 0xBBF7D0FFL })
              }))
              let _ = fmt_b.box(
                fn(ft : view::View) -> Unit {
                  let _ = ft
                  .words(
                    view::Live::By(fn() -> String {
                      let m = get_meta()
                      if m.format != "" { m.format } else { "PNG" }
                    }),
                    ink=0x15803DFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    if is_dark_chrome() { 0x6EE7B7FFL } else { 0x15803DFFL }
                  }))
                },
              )
            },
          )
        },
      )

      // 2. Single-line clipped filename card (concentric radius 8pt)
      let _ = card.box(
        fn(fcard : view::View) -> Unit {
          let _ = fcard
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(32.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(8.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

          let _ = fcard.box(
            fn(fnm : view::View) -> Unit {
              let _ = fnm
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .clips(view::Live::Is(true))
              .words(
                view::Live::By(fn() -> String {
                  let m = get_meta()
                  if m.filename != "" { m.filename } else { "farview-capture.png" }
                }),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )

          fcard.show(
            fn() -> Bool { proto::capture_sheet_size_label(get_meta().size_bytes) != "" },
            fn(sz : view::View) -> Unit {
              let _ = sz
              .rigid()
              .words(
                view::Live::By(fn() -> String {
                  proto::capture_sheet_size_label(get_meta().size_bytes)
                }),
                ink=0x6B7280FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )
        },
      )

      // 3. Action Buttons Row: Copy Path + Reveal + Dismiss (concentric radius 6pt)
      let _ = card.box(
        fn(arow : view::View) -> Unit {
          let _ = arow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(6.0))

          let _ = headless::button(
            arow,
            fn() -> String { "Copy Path" },
            fn(_v : view::View) -> Unit { copy_capture_sheet_path() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(28.0)))
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() {
                  if p.is_dark { 0x1D4ED8FFL } else { 0x1D4ED8FFL }
                } else if btn.hovered() {
                  if p.is_dark { 0x3B82F6FFL } else { 0x1E40AFFFL }
                } else {
                  p.accent
                }
              }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Copy Path"),
                    ink=0xFFFFFFFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    if is_dark_chrome() { 0x0F172AFFL } else { 0xFFFFFFFFL }
                  }))
                },
              )
            },
          )

          let _ = headless::button(
            arow,
            fn() -> String { "Reveal" },
            fn(_v : view::View) -> Unit { reveal_capture_sheet_file() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .height(view::Live::Is(Some(28.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Reveal"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
            },
          )

          let _ = headless::button(
            arow,
            fn() -> String { "Dismiss" },
            fn(_v : view::View) -> Unit { close_capture_sheet() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .height(view::Live::Is(Some(28.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { 0x00000000L }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Dismiss"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                },
              )
            },
          )
        },
      )
    },
  )
}
