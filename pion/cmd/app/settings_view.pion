///| Native Metal Settings Modal (`Cmd+,` / `Ctrl+,`) and Global Chrome Theme Palette
///| (`Light` / `Dark` real-time zero-refresh chrome theme engine).
///| Follows concentric corner radii (14 -> 10 -> 6pt), first-line alignment,
///| zero double dividers, zero `alpha=0` clickable buttons, and zero `ellipsis_past(true)`.

struct ChromePalette {
  is_dark : Bool
  toolbar_bg : Int64
  sidebar_bg : Int64
  surface_bg : Int64
  surface_subtle : Int64
  addr_bg : Int64
  btn_bg : Int64
  btn_hover : Int64
  btn_press : Int64
  btn_active_bg : Int64
  border : Int64
  hairline : Int64
  ink_primary : Int64
  ink_secondary : Int64
  ink_muted : Int64
  tab_active_bg : Int64
  tab_active_border : Int64
  tab_hover_bg : Int64
  tab_press_bg : Int64
  accent : Int64
  accent_soft_bg : Int64
  accent_soft_border : Int64
  accent_soft_ink : Int64
  danger : Int64
  danger_bg : Int64
  danger_border : Int64
}

fn chrome_palette_for(is_dark : Bool) -> ChromePalette {
  if is_dark {
    ChromePalette::{
      is_dark: true,
      toolbar_bg: 0x181A20FFL,
      sidebar_bg: 0x14161BFFL,
      surface_bg: 0x1C1F26FFL,
      surface_subtle: 0x22252EFFL,
      addr_bg: 0x22252EFFL,
      btn_bg: 0x232732FFL,
      btn_hover: 0x2C3140FFL,
      btn_press: 0x33394AFFL,
      btn_active_bg: 0x262A36FFL,
      border: 0x2C303CFFL,
      hairline: 0x262A35FFL,
      ink_primary: 0xF1F5F9FFL,
      ink_secondary: 0xCBD5E1FFL,
      ink_muted: 0x94A3B8FFL,
      tab_active_bg: 0x262A36FFL,
      tab_active_border: 0x353B4BFFL,
      tab_hover_bg: 0x1F232EFFL,
      tab_press_bg: 0x282D3BFFL,
      accent: 0x60A5FAFFL,
      accent_soft_bg: 0x1E2E4AFFL,
      accent_soft_border: 0x2F4B78FFL,
      accent_soft_ink: 0x93C5FDFFL,
      danger: 0xF87171FFL,
      danger_bg: 0x351D22FFL,
      danger_border: 0x5C2A32FFL,
    }
  } else {
    ChromePalette::{
      is_dark: false,
      toolbar_bg: 0xF2F2F7FFL,
      sidebar_bg: 0xF5F6FAFFL,
      surface_bg: 0xFFFFFFFFL,
      surface_subtle: 0xF8F9FCFFL,
      addr_bg: 0xFFFFFFFFL,
      btn_bg: 0xE5E5EAFFL,
      btn_hover: 0xDDDDE4FFL,
      btn_press: 0xD6D8E2FFL,
      btn_active_bg: 0xE1E5F2FFL,
      border: 0xDCDCE2FFL,
      hairline: 0xECEEF4FFL,
      ink_primary: 0x1D1D1FFFL,
      ink_secondary: 0x3A4152FFL,
      ink_muted: 0x6B7280FFL,
      tab_active_bg: 0xFFFFFFFFL,
      tab_active_border: 0xD8DCE8FFL,
      tab_hover_bg: 0xECEEF5FFL,
      tab_press_bg: 0xE2E6F0FFL,
      accent: 0x2563EBFFL,
      accent_soft_bg: 0xEAF3FFFFL,
      accent_soft_border: 0xBFD7FFFFL,
      accent_soft_ink: 0x1D4ED8FFL,
      danger: 0xDC2626FFL,
      danger_bg: 0xFEF2F2FFL,
      danger_border: 0xFECACAFFL,
    }
  }
}

fn is_dark_chrome() -> Bool {
  match app_state.chrome_theme {
    Some(s) => s.get() == "dark"
    None => app_state.settings.chrome_theme == "dark"
  }
}

fn chrome_palette() -> ChromePalette {
  chrome_palette_for(is_dark_chrome())
}

fn space_sidebar_surface_themed(accent : String, dark : Bool) -> Int64 {
  if dark {
    let hex = proto::normalize_space_accent(accent)
    if hex == "#10B981" {
      0x131918FFL
    } else if hex == "#8B5CF6" {
      0x17151EFFL
    } else if hex == "#F59E0B" {
      0x1A1713FFL
    } else if hex == "#EC4899" || hex == "#F43F5E" {
      0x1B1419FFL
    } else if hex == "#06B6D4" {
      0x13191CFFL
    } else if hex == "#64748B" {
      0x16181DFFL
    } else {
      0x14161BFFL
    }
  } else {
    space_sidebar_surface(accent)
  }
}

fn space_badge_tint_themed(accent : String, hovered : Bool, pressed : Bool, dark : Bool) -> (Int64, Int64) {
  if dark {
    let hex = proto::normalize_space_accent(accent)
    if hex == "#10B981" {
      (if pressed { 0x1A352BFFL } else if hovered { 0x172D25FFL } else { 0x152620FFL }, 0x234739FFL)
    } else if hex == "#8B5CF6" {
      (if pressed { 0x2B2446FFL } else if hovered { 0x251F3BFFL } else { 0x1F1B32FFL }, 0x3D3262FFL)
    } else if hex == "#F59E0B" {
      (if pressed { 0x3A2E1AFFL } else if hovered { 0x312717FFL } else { 0x292115FFL }, 0x4E3E22FFL)
    } else if hex == "#EC4899" || hex == "#F43F5E" {
      (if pressed { 0x3C1F30FFL } else if hovered { 0x331B29FFL } else { 0x2B1823FFL }, 0x522B42FFL)
    } else if hex == "#06B6D4" {
      (if pressed { 0x18323AFFL } else if hovered { 0x162B32FFL } else { 0x14252BFFL }, 0x224652FFL)
    } else if hex == "#64748B" {
      (if pressed { 0x2B303BFFL } else if hovered { 0x242934FFL } else { 0x1F242EFFL }, 0x3A4152FFL)
    } else {
      (if pressed { 0x24304BFFL } else if hovered { 0x202A40FFL } else { 0x1C2436FFL }, 0x2E3B57FFL)
    }
  } else {
    space_badge_tint(accent, hovered, pressed)
  }
}

fn dispatch_settings_sync() -> Unit {
  send_wire(wire::Message::Act("settings_sync", "", ""))
}

fn dispatch_settings_save(next_s : proto::BrowserSettings, toast_msg~ : String = "") -> Unit {
  let clean = proto::normalize_browser_settings(next_s)
  app_state.settings = clean
  match app_state.chrome_theme {
    Some(s) => s.set(clean.chrome_theme)
    None => ()
  }
  sync_lg_theme_from_chrome(clean.chrome_theme)
  match app_state.settings_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  let payload = proto::encode_browser_settings(clean)
  send_wire(wire::Message::Act("settings_save", payload, ""))
  if toast_msg != "" {
    show_toast(toast_msg, "settings")
  }
}

fn dispatch_clear_browsing_data(clear_hist : Bool, clear_dl : Bool, clear_boosts : Bool) -> Unit {
  let cats : Array[String] = []
  let labels : Array[String] = []
  if clear_hist {
    cats.push("history")
    labels.push("History")
  }
  if clear_dl {
    cats.push("downloads")
    labels.push("Downloads")
  }
  if clear_boosts {
    cats.push("boosts")
    labels.push("Site Boosts")
  }
  if cats.length() == 0 {
    show_toast("Select at least one category to clear", "settings")
    return
  }
  send_wire(wire::Message::Act("clear_browsing_data", cats.join(","), ""))
  show_toast("Cleared " + labels.join(", "), "settings")
}

fn set_host_settings_state(json : String) -> Unit {
  match proto::parse_browser_settings(json) {
    Some(parsed) => {
      let clean = proto::normalize_browser_settings(parsed)
      app_state.settings = clean
      match app_state.chrome_theme {
        Some(s) => if app_state.initial_chrome_theme == "" {
          s.set(clean.chrome_theme)
        }
        None => ()
      }
      if app_state.initial_chrome_theme == "" {
        sync_lg_theme_from_chrome(clean.chrome_theme)
      }
      match app_state.settings_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_settings_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_settings() -> Unit {
  match app_state.settings_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("settings")
}

fn open_settings(tab_idx~ : Int = -1) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  if tab_idx >= 0 && tab_idx <= 2 {
    match app_state.settings_tab {
      Some(t) => t.set(tab_idx)
      None => ()
    }
  }
  match app_state.settings_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "settings")
  dispatch_settings_sync()
}

fn toggle_settings() -> Unit {
  let is_open = match app_state.settings_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_settings()
  } else {
    open_settings()
  }
}

fn toggle_dark_chrome() -> Unit {
  let cur = app_state.settings
  let next_theme = if is_dark_chrome() { "light" } else { "dark" }
  app_state.initial_chrome_theme = ""
  let next = proto::BrowserSettings::{ ..cur, chrome_theme: next_theme }
  let label = if next_theme == "dark" { "Dark Appearance Enabled" } else { "Light Appearance Enabled" }
  dispatch_settings_save(next, toast_msg=label)
}

fn settings_sidebar_width() -> Double {
  let _ = match app_state.settings_rev {
    Some(r) => r.get()
    None => 0
  }
  if app_state.settings.compact_sidebar { 204.0 } else { 244.0 }
}

fn settings_step_default_zoom(delta : Int) -> Unit {
  let cur = app_state.settings
  let steps : Array[Int] = [75, 80, 90, 100, 110, 125, 150]
  let mut idx = 3
  let mut i = 0
  while i < steps.length() {
    if steps[i] <= cur.default_zoom_pct {
      idx = i
    }
    i = i + 1
  }
  let mut next_idx = idx + delta
  if next_idx < 0 {
    next_idx = 0
  }
  if next_idx >= steps.length() {
    next_idx = steps.length() - 1
  }
  let next_pct = steps[next_idx]
  if next_pct != cur.default_zoom_pct {
    dispatch_settings_save(proto::BrowserSettings::{ ..cur, default_zoom_pct: next_pct })
    apply_zoom_and_sync(active_stage(), (next_pct as Double) / 100.0)
  }
}

///| Builds the native Metal Settings Modal (`Cmd+,` / `Ctrl+,`).
///| Dual-column layout (184pt left navigation rail + 496pt right settings pane),
///| outer radius 14pt -> card radius 10pt -> control radius 6pt.
fn build_settings_modal(
  root : view::View,
  settings_open : signals::Signal[Bool],
  settings_tab : signals::Signal[Int],
  settings_rev : signals::Signal[Int],
  clear_hist : signals::Signal[Bool],
  clear_dl : signals::Signal[Bool],
  clear_boosts : signals::Signal[Bool],
) -> Unit {
  root.show(
    fn() -> Bool { settings_open.get() },
    fn(layer : view::View) -> Unit {
      let _ = layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Dimmed backdrop (click outside dismisses modal)
      let _ = headless::button(
        layer,
        fn() -> String { "Close Settings" },
        fn(_v : view::View) -> Unit { close_settings() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05070B88L } else { 0x0F172A46L }
          }))
        },
      )

      // Reusable toggle switch row helper (first-line aligned, crisp 38x22 pill switch)
      let render_toggle_row = fn(
        parent : view::View,
        title : String,
        subtitle : String,
        is_on : () -> Bool,
        on_toggle : () -> Unit,
      ) -> Unit {
        let _ = headless::button(
          parent,
          fn() -> String { title },
          fn(_v : view::View) -> Unit { on_toggle() },
          fn(row : view::View, btn : headless::Button) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
            .gap(view::Live::Is(12.0))
            .radius(view::Live::Is(8.0))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if btn.pressed() {
                p.tab_press_bg
              } else if btn.hovered() {
                p.tab_hover_bg
              } else {
                0x00000000L
              }
            }))
            let _ = row.box(
              fn(txt : view::View) -> Unit {
                let _ = txt
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(0.0)))
                .gap(view::Live::Is(2.0))
                let _ = txt.box(
                  fn(tl : view::View) -> Unit {
                    let _ = tl
                    .words(
                      view::Live::Is(title),
                      ink=0x1D1D1FFFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                  },
                )
                let _ = txt.box(
                  fn(sl : view::View) -> Unit {
                    let _ = sl
                    .words(
                      view::Live::Is(subtitle),
                      ink=0x6B7280FFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: true },
                    )
                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                  },
                )
              },
            )
            // Pill switch track (38x22)
            let _ = row.box(
              fn(track : view::View) -> Unit {
                let _ = track
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .width(view::Live::Is(Some(38.0)))
                .height(view::Live::Is(Some(22.0)))
                .rigid()
                .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
                .radius(view::Live::Is(11.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if is_on() {
                    if p.is_dark { 0x3B82F6FFL } else { 0x2563EBFFL }
                  } else if p.is_dark {
                    0x343A4AFFL
                  } else {
                    0xD1D5DBFFL
                  }
                }))
                track.show(
                  is_on,
                  fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) },
                )
                let _ = track.box(
                  fn(knob : view::View) -> Unit {
                    let _ = knob
                    .width(view::Live::Is(Some(18.0)))
                    .height(view::Live::Is(Some(18.0)))
                    .rigid()
                    .radius(view::Live::Is(9.0))
                    .ground(view::Live::Is(0xFFFFFFFFL))
                    .shadow(view::Live::Is((3.0, 1.0, 0x00000028L)))
                  },
                )
              },
            )
          },
        )
      }

      // Main Settings Modal Window (680x476, radius 14pt)
      let _ = layer.box(
        fn(modal : view::View) -> Unit {
          let _ = modal
          .width(view::Live::Is(Some(680.0)))
          .height(view::Live::Is(Some(476.0)))
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(14.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (32.0, 14.0, 0x00000080L) } else { (28.0, 12.0, 0x0F172A32L) }
          }))

          // 1. Header Bar (48pt height, single bottom hairline)
          let _ = modal.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(680.0)))
              .height(view::Live::Is(Some(48.0)))
              .rigid()
              .padding(view::Live::Is((18.0, 0.0, 14.0, 0.0)))
              .gap(view::Live::Is(8.0))
              let _ = hdr.box(
                fn(ht : view::View) -> Unit {
                  let _ = ht
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("Settings"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              let _ = hdr.box(
                fn(esc_pill : view::View) -> Unit {
                  let _ = esc_pill
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = esc_pill.box(
                    fn(el : view::View) -> Unit {
                      let _ = el
                      .words(
                        view::Live::Is("Esc"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
              let _ = headless::button(
                hdr,
                fn() -> String { "Close Settings" },
                fn(_v : view::View) -> Unit { close_settings() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(26.0)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                },
              )
            },
          )
          // Single 1pt header separator
          let _ = modal.box(
            fn(hsep : view::View) -> Unit {
              let _ = hsep
              .width(view::Live::Is(Some(680.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // 2. Two-column Body (Left Nav Rail 184pt + 1pt divider + Right Content 495pt)
          let _ = modal.box(
            fn(body : view::View) -> Unit {
              let _ = body
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))

              // Left Navigation Rail
              let _ = body.box(
                fn(nav : view::View) -> Unit {
                  let _ = nav
                  .width(view::Live::Is(Some(184.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 12.0, 10.0, 12.0)))
                  .gap(view::Live::Is(4.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().sidebar_bg }))

                  let nav_item = fn(idx : Int, icon : String, label : String) -> Unit {
                    let is_act = fn() -> Bool { settings_tab.get() == idx }
                    let _ = headless::button(
                      nav,
                      fn() -> String { label },
                      fn(_v : view::View) -> Unit { settings_tab.set(idx) },
                      fn(b : view::View, btn : headless::Button) -> Unit {
                        let _ = b
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .height(view::Live::Is(Some(34.0)))
                        .rigid()
                        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                        .gap(view::Live::Is(9.0))
                        .radius(view::Live::Is(8.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_act() {
                            p.tab_active_bg
                          } else if btn.pressed() {
                            p.tab_press_bg
                          } else if btn.hovered() {
                            p.tab_hover_bg
                          } else {
                            0x00000000L
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          if is_act() { (1.0, chrome_palette().tab_active_border) } else { (1.0, 0x00000000L) }
                        }))
                        let _ = b.box(
                          fn(ic : view::View) -> Unit {
                            let _ = ic
                            .width(view::Live::Is(Some(18.0)))
                            .center()
                            .rigid()
                            .words(
                              view::Live::Is(icon),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_act() { p.accent } else { p.ink_muted }
                            }))
                          },
                        )
                        let _ = b.box(
                          fn(lb : view::View) -> Unit {
                            let _ = lb
                            .words(
                              view::Live::Is(label),
                              ink=0x1D1D1FFFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_act() { p.ink_primary } else { p.ink_secondary }
                            }))
                          },
                        )
                      },
                    )
                  }
                  nav_item(0, "⚙", "General")
                  nav_item(1, "◐", "Appearance")
                  nav_item(2, "◈", "Privacy & Data")

                  // Flexible spacer + subtle version footnote
                  let _ = nav.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                  let _ = nav.box(
                    fn(ver : view::View) -> Unit {
                      let _ = ver
                      .padding(view::Live::Is((10.0, 4.0, 10.0, 4.0)))
                      .words(
                        view::Live::Is("Farview Native"),
                        ink=0x94A3B8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Single 1pt vertical rail divider
              let _ = body.box(
                fn(vsep : view::View) -> Unit {
                  let _ = vsep
                  .width(view::Live::Is(Some(1.0)))
                  .rigid()
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )

              // Right Content Pane
              let _ = body.box(
                fn(pane : view::View) -> Unit {
                  let _ = pane
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .padding(view::Live::Is((20.0, 18.0, 20.0, 18.0)))
                  .gap(view::Live::Is(14.0))

                  // TAB 0: GENERAL
                  pane.show(
                    fn() -> Bool { settings_tab.get() == 0 },
                    fn(gen : view::View) -> Unit {
                      let _ = gen.gap(view::Live::Is(14.0))

                      // Card 1: Default Search Engine (5 capsule pills)
                      let _ = gen.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
                          .gap(view::Live::Is(10.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          let _ = card.box(
                            fn(ch : view::View) -> Unit {
                              let _ = ch
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .gap(view::Live::Is(8.0))
                              let _ = ch.box(
                                fn(t : view::View) -> Unit {
                                  let _ = t
                                  .grow(view::Live::Is(1.0))
                                  .words(
                                    view::Live::Is("Default Search Engine"),
                                    ink=0x1D1D1FFFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                },
                              )
                              let _ = ch.box(
                                fn(host_lbl : view::View) -> Unit {
                                  let _ = host_lbl
                                  .words(
                                    view::Live::By(fn() -> String {
                                      let _ = settings_rev.get()
                                      proto::search_engine_host(app_state.settings.search_engine)
                                    }),
                                    ink=0x6B7280FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent }))
                                },
                              )
                            },
                          )
                          let _ = card.box(
                            fn(pills : view::View) -> Unit {
                              let _ = pills
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .gap(view::Live::Is(6.0))
                              let engine_pill = fn(id : String, label : String) -> Unit {
                                let is_sel = fn() -> Bool {
                                  let _ = settings_rev.get()
                                  app_state.settings.search_engine == id
                                }
                                let _ = headless::button(
                                  pills,
                                  fn() -> String { "Search Engine " + label },
                                  fn(_v : view::View) -> Unit {
                                    let cur = app_state.settings
                                    dispatch_settings_save(
                                      proto::BrowserSettings::{ ..cur, search_engine: id },
                                      toast_msg="Search Engine: " + label,
                                    )
                                  },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .height(view::Live::Is(Some(30.0)))
                                    .rigid()
                                    .center()
                                    .padding(view::Live::Is((11.0, 0.0, 11.0, 0.0)))
                                    .radius(view::Live::Is(6.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if is_sel() {
                                        p.accent_soft_bg
                                      } else if btn.pressed() {
                                        p.btn_press
                                      } else if btn.hovered() {
                                        p.btn_hover
                                      } else {
                                        p.surface_bg
                                      }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) {
                                      let p = chrome_palette()
                                      if is_sel() { (1.2, p.accent_soft_border) } else { (1.0, p.border) }
                                    }))
                                    let _ = b.box(
                                      fn(lbl : view::View) -> Unit {
                                        let _ = lbl
                                        .words(
                                          view::Live::Is(label),
                                          ink=0x1D1D1FFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 {
                                          let p = chrome_palette()
                                          if is_sel() { p.accent_soft_ink } else { p.ink_secondary }
                                        }))
                                      },
                                    )
                                  },
                                )
                              }
                              engine_pill("google", "Google")
                              engine_pill("duckduckgo", "DuckDuckGo")
                              engine_pill("kagi", "Kagi")
                              engine_pill("perplexity", "Perplexity")
                              engine_pill("bing", "Bing")
                            },
                          )
                        },
                      )

                      // Card 2: Default Page Zoom (75% - 150%)
                      let _ = gen.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
                          .gap(view::Live::Is(12.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          let _ = card.box(
                            fn(info : view::View) -> Unit {
                              let _ = info
                              .grow(view::Live::Is(1.0))
                              .gap(view::Live::Is(2.0))
                              let _ = info.box(
                                fn(t : view::View) -> Unit {
                                  let _ = t
                                  .words(
                                    view::Live::Is("Default Page Zoom"),
                                    ink=0x1D1D1FFFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                },
                              )
                              let _ = info.box(
                                fn(s : view::View) -> Unit {
                                  let _ = s
                                  .words(
                                    view::Live::Is("Applies baseline scale between 75% and 150%"),
                                    ink=0x6B7280FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                },
                              )
                            },
                          )

                          let _ = card.box(
                            fn(ctrl : view::View) -> Unit {
                              let _ = ctrl
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .rigid()
                              .gap(view::Live::Is(6.0))

                              let step_btn = fn(sym : String, aria : String, delta : Int) -> Unit {
                                let _ = headless::button(
                                  ctrl,
                                  fn() -> String { aria },
                                  fn(_v : view::View) -> Unit { settings_step_default_zoom(delta) },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .width(view::Live::Is(Some(28.0)))
                                    .height(view::Live::Is(Some(28.0)))
                                    .rigid()
                                    .center()
                                    .radius(view::Live::Is(6.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_bg }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                                    let _ = b.box(
                                      fn(l : view::View) -> Unit {
                                        let _ = l
                                        .words(
                                          view::Live::Is(sym),
                                          ink=0x1D1D1FFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 600, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                      },
                                    )
                                  },
                                )
                              }
                              step_btn("−", "Decrease Default Zoom", -1)
                              let _ = ctrl.box(
                                fn(zbox : view::View) -> Unit {
                                  let _ = zbox
                                  .width(view::Live::Is(Some(52.0)))
                                  .height(view::Live::Is(Some(28.0)))
                                  .rigid()
                                  .center()
                                  .radius(view::Live::Is(6.0))
                                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                                  let _ = zbox.box(
                                    fn(vl : view::View) -> Unit {
                                      let _ = vl
                                      .words(
                                        view::Live::By(fn() -> String {
                                          let _ = settings_rev.get()
                                          app_state.settings.default_zoom_pct.to_string() + "%"
                                        }),
                                        ink=0x1D1D1FFFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                        one_line=true,
                                      )
                                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                    },
                                  )
                                },
                              )
                              step_btn("+", "Increase Default Zoom", 1)
                            },
                          )
                        },
                      )

                      // Card 3: Auto-Archive Today Tabs (12h / 24h / 7d / Never)
                      let _ = gen.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
                          .gap(view::Live::Is(10.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          let _ = card.box(
                            fn(info : view::View) -> Unit {
                              let _ = info.gap(view::Live::Is(2.0))
                              let _ = info.box(
                                fn(t : view::View) -> Unit {
                                  let _ = t
                                  .words(
                                    view::Live::Is("Auto-Archive Today Tabs"),
                                    ink=0x1D1D1FFFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                },
                              )
                              let _ = info.box(
                                fn(s : view::View) -> Unit {
                                  let _ = s
                                  .words(
                                    view::Live::Is("Automatically sweep unpinned tabs after inactivity"),
                                    ink=0x6B7280FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                },
                              )
                            },
                          )
                          let _ = card.box(
                            fn(seg : view::View) -> Unit {
                              let _ = seg
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .gap(view::Live::Is(6.0))
                              let arch_pill = fn(hours : Int, label : String) -> Unit {
                                let is_sel = fn() -> Bool {
                                  let _ = settings_rev.get()
                                  app_state.settings.auto_archive_hours == hours
                                }
                                let _ = headless::button(
                                  seg,
                                  fn() -> String { "Auto-Archive " + label },
                                  fn(_v : view::View) -> Unit {
                                    let cur = app_state.settings
                                    dispatch_settings_save(
                                      proto::BrowserSettings::{ ..cur, auto_archive_hours: hours },
                                      toast_msg="Auto-Archive: " + label,
                                    )
                                  },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .grow(view::Live::Is(1.0))
                                    .height(view::Live::Is(Some(30.0)))
                                    .center()
                                    .radius(view::Live::Is(6.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if is_sel() {
                                        p.accent_soft_bg
                                      } else if btn.pressed() {
                                        p.btn_press
                                      } else if btn.hovered() {
                                        p.btn_hover
                                      } else {
                                        p.surface_bg
                                      }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) {
                                      let p = chrome_palette()
                                      if is_sel() { (1.2, p.accent_soft_border) } else { (1.0, p.border) }
                                    }))
                                    let _ = b.box(
                                      fn(lbl : view::View) -> Unit {
                                        let _ = lbl
                                        .words(
                                          view::Live::Is(label),
                                          ink=0x1D1D1FFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 {
                                          let p = chrome_palette()
                                          if is_sel() { p.accent_soft_ink } else { p.ink_secondary }
                                        }))
                                      },
                                    )
                                  },
                                )
                              }
                              arch_pill(12, "12 hours")
                              arch_pill(24, "24 hours")
                              arch_pill(168, "7 days")
                              arch_pill(0, "Never")
                            },
                          )
                        },
                      )
                    },
                  )

                  // TAB 1: APPEARANCE
                  pane.show(
                    fn() -> Bool { settings_tab.get() == 1 },
                    fn(app_pane : view::View) -> Unit {
                      let _ = app_pane.gap(view::Live::Is(14.0))

                      // Card 1: Chrome Theme Visual Cards (Light / Dark)
                      let _ = app_pane.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
                          .gap(view::Live::Is(12.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          let _ = card.box(
                            fn(hdr_col : view::View) -> Unit {
                              let _ = hdr_col.gap(view::Live::Is(2.0))
                              let _ = hdr_col.box(
                                fn(t : view::View) -> Unit {
                                  let _ = t
                                  .words(
                                    view::Live::Is("Browser Appearance"),
                                    ink=0x1D1D1FFFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                },
                              )
                              let _ = hdr_col.box(
                                fn(s : view::View) -> Unit {
                                  let _ = s
                                  .words(
                                    view::Live::Is("Switches toolbar, sidebar, address bar, and modals instantly"),
                                    ink=0x6B7280FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                },
                              )
                            },
                          )

                          let _ = card.box(
                            fn(grid : view::View) -> Unit {
                              let _ = grid
                              .row(view::Live::Is(true))
                              .gap(view::Live::Is(12.0))

                              let theme_card = fn(
                                id : String,
                                title : String,
                                desc : String,
                                pv_bar : Int64,
                                pv_side : Int64,
                                pv_addr : Int64,
                                pv_page : Int64,
                                pv_line : Int64,
                              ) -> Unit {
                                let is_sel = fn() -> Bool {
                                  if id == "dark" { is_dark_chrome() } else { !is_dark_chrome() }
                                }
                                let _ = headless::button(
                                  grid,
                                  fn() -> String { "Theme " + title },
                                  fn(_v : view::View) -> Unit {
                                    app_state.initial_chrome_theme = ""
                                    let cur = app_state.settings
                                    dispatch_settings_save(
                                      proto::BrowserSettings::{ ..cur, chrome_theme: id },
                                      toast_msg=title + " Appearance Enabled",
                                    )
                                  },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .grow(view::Live::Is(1.0))
                                    .padding(view::Live::Is((10.0, 10.0, 10.0, 10.0)))
                                    .gap(view::Live::Is(8.0))
                                    .radius(view::Live::Is(8.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if is_sel() {
                                        p.accent_soft_bg
                                      } else if btn.pressed() {
                                        p.btn_press
                                      } else if btn.hovered() {
                                        p.btn_hover
                                      } else {
                                        p.surface_bg
                                      }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) {
                                      let p = chrome_palette()
                                      if is_sel() { (1.5, p.accent) } else { (1.0, p.border) }
                                    }))

                                    // Miniature browser chrome preview swatch (6pt radius)
                                    let _ = b.box(
                                      fn(pv : view::View) -> Unit {
                                        let _ = pv
                                        .height(view::Live::Is(Some(74.0)))
                                        .clips(view::Live::Is(true))
                                        .radius(view::Live::Is(6.0))
                                        .ground(view::Live::Is(pv_page))
                                        .edge(view::Live::Is((1.0, pv_line)))

                                        // Mini topbar
                                        let _ = pv.box(
                                          fn(mb : view::View) -> Unit {
                                            let _ = mb
                                            .row(view::Live::Is(true))
                                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                            .height(view::Live::Is(Some(20.0)))
                                            .rigid()
                                            .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                            .gap(view::Live::Is(4.0))
                                            .ground(view::Live::Is(pv_bar))
                                            let _ = mb.box(fn(d : view::View) -> Unit { let _ = d.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(0xEF4444FFL)) })
                                            let _ = mb.box(fn(d : view::View) -> Unit { let _ = d.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(0xF59E0BFFL)) })
                                            let _ = mb.box(fn(d : view::View) -> Unit { let _ = d.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(0x10B981FFL)) })
                                            let _ = mb.box(
                                              fn(ma : view::View) -> Unit {
                                                let _ = ma
                                                .grow(view::Live::Is(1.0))
                                                .height(view::Live::Is(Some(10.0)))
                                                .radius(view::Live::Is(3.0))
                                                .ground(view::Live::Is(pv_addr))
                                                .edge(view::Live::Is((1.0, pv_line)))
                                              },
                                            )
                                          },
                                        )
                                        // Mini body: sidebar + page
                                        let _ = pv.box(
                                          fn(mbody : view::View) -> Unit {
                                            let _ = mbody
                                            .row(view::Live::Is(true))
                                            .grow(view::Live::Is(1.0))
                                            let _ = mbody.box(
                                              fn(ms : view::View) -> Unit {
                                                let _ = ms
                                                .width(view::Live::Is(Some(44.0)))
                                                .rigid()
                                                .padding(view::Live::Is((5.0, 5.0, 5.0, 5.0)))
                                                .gap(view::Live::Is(4.0))
                                                .ground(view::Live::Is(pv_side))
                                                let _ = ms.box(fn(r : view::View) -> Unit { let _ = r.height(view::Live::Is(Some(8.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(pv_addr)) })
                                                let _ = ms.box(fn(r : view::View) -> Unit { let _ = r.height(view::Live::Is(Some(6.0))).radius(view::Live::Is(2.0)).ground(view::Live::Is(pv_line)) })
                                                let _ = ms.box(fn(r : view::View) -> Unit { let _ = r.height(view::Live::Is(Some(6.0))).radius(view::Live::Is(2.0)).ground(view::Live::Is(pv_line)) })
                                              },
                                            )
                                            let _ = mbody.box(fn(mp : view::View) -> Unit { let _ = mp.grow(view::Live::Is(1.0)).ground(view::Live::Is(pv_page)) })
                                          },
                                        )
                                      },
                                    )

                                    // Label + Active badge
                                    let _ = b.box(
                                      fn(ft : view::View) -> Unit {
                                        let _ = ft
                                        .row(view::Live::Is(true))
                                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                        .gap(view::Live::Is(6.0))
                                        let _ = ft.box(
                                          fn(col : view::View) -> Unit {
                                            let _ = col.grow(view::Live::Is(1.0)).gap(view::Live::Is(1.0))
                                            let _ = col.box(
                                              fn(tl : view::View) -> Unit {
                                                let _ = tl
                                                .words(
                                                  view::Live::Is(title),
                                                  ink=0x1D1D1FFFL,
                                                  look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                                                  one_line=true,
                                                )
                                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                              },
                                            )
                                            let _ = col.box(
                                              fn(dl : view::View) -> Unit {
                                                let _ = dl
                                                .words(
                                                  view::Live::Is(desc),
                                                  ink=0x6B7280FFL,
                                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                                  one_line=true,
                                                )
                                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                              },
                                            )
                                          },
                                        )
                                        ft.show(
                                          is_sel,
                                          fn(chk : view::View) -> Unit {
                                            let _ = chk
                                            .width(view::Live::Is(Some(18.0)))
                                            .height(view::Live::Is(Some(18.0)))
                                            .rigid()
                                            .center()
                                            .radius(view::Live::Is(9.0))
                                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent }))
                                            let _ = chk.box(
                                              fn(cl : view::View) -> Unit {
                                                let _ = cl.words(
                                                  view::Live::Is("✓"),
                                                  ink=0xFFFFFFFFL,
                                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 700, wrap: false },
                                                  one_line=true,
                                                )
                                              },
                                            )
                                          },
                                        )
                                      },
                                    )
                                  },
                                )
                              }
                              theme_card("light", "Light", "Clean frosted silver chrome", 0xF2F2F7FFL, 0xF5F6FAFFL, 0xFFFFFFFFL, 0xFAFBFFFFL, 0xDCDCE2FFL)
                              theme_card("dark", "Dark", "Deep slate Apple/Arc chrome", 0x181A20FFL, 0x14161BFFL, 0x22252EFFL, 0x0F1117FFL, 0x2C303CFFL)
                            },
                          )
                        },
                      )

                      // Card 2: Compact Sidebar Toggle
                      let _ = app_pane.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .padding(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                          render_toggle_row(
                            card,
                            "Compact Sidebar",
                            "Use a narrower 204pt sidebar to maximize page width",
                            fn() -> Bool {
                              let _ = settings_rev.get()
                              app_state.settings.compact_sidebar
                            },
                            fn() -> Unit {
                              let cur = app_state.settings
                              let next_v = !cur.compact_sidebar
                              dispatch_settings_save(
                                proto::BrowserSettings::{ ..cur, compact_sidebar: next_v },
                                toast_msg=if next_v { "Compact Sidebar Enabled" } else { "Standard Sidebar Width" },
                              )
                            },
                          )
                        },
                      )
                    },
                  )

                  // TAB 2: PRIVACY & DATA
                  pane.show(
                    fn() -> Bool { settings_tab.get() == 2 },
                    fn(priv_pane : view::View) -> Unit {
                      let _ = priv_pane.gap(view::Live::Is(14.0))

                      // Card 1: Privacy Switches
                      let _ = priv_pane.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .padding(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          render_toggle_row(
                            card,
                            "HTTPS-Only Mode",
                            "Automatically upgrade external http:// URLs (keeps localhost)",
                            fn() -> Bool {
                              let _ = settings_rev.get()
                              app_state.settings.https_only
                            },
                            fn() -> Unit {
                              let cur = app_state.settings
                              let next_v = !cur.https_only
                              dispatch_settings_save(
                                proto::BrowserSettings::{ ..cur, https_only: next_v },
                                toast_msg=if next_v { "HTTPS-Only Mode On" } else { "HTTPS-Only Mode Off" },
                              )
                            },
                          )
                          let _ = card.box(fn(sep : view::View) -> Unit {
                            let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                          })
                          render_toggle_row(
                            card,
                            "Block Third-Party Cookies",
                            "Restrict cross-site tracking cookies across Spaces",
                            fn() -> Bool {
                              let _ = settings_rev.get()
                              app_state.settings.block_third_party_cookies
                            },
                            fn() -> Unit {
                              let cur = app_state.settings
                              dispatch_settings_save(
                                proto::BrowserSettings::{ ..cur, block_third_party_cookies: !cur.block_third_party_cookies },
                              )
                            },
                          )
                          let _ = card.box(fn(sep : view::View) -> Unit {
                            let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                          })
                          render_toggle_row(
                            card,
                            "Send Do Not Track",
                            "Include DNT: 1 preference header on outgoing requests",
                            fn() -> Bool {
                              let _ = settings_rev.get()
                              app_state.settings.send_dnt
                            },
                            fn() -> Unit {
                              let cur = app_state.settings
                              dispatch_settings_save(
                                proto::BrowserSettings::{ ..cur, send_dnt: !cur.send_dnt },
                              )
                            },
                          )
                        },
                      )

                      // Card 2: Clear Browsing Data
                      let _ = priv_pane.box(
                        fn(card : view::View) -> Unit {
                          let _ = card
                          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
                          .gap(view::Live::Is(12.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          let _ = card.box(
                            fn(info : view::View) -> Unit {
                              let _ = info.gap(view::Live::Is(2.0))
                              let _ = info.box(
                                fn(t : view::View) -> Unit {
                                  let _ = t
                                  .words(
                                    view::Live::Is("Clear Browsing Data"),
                                    ink=0x1D1D1FFFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                },
                              )
                              let _ = info.box(
                                fn(s : view::View) -> Unit {
                                  let _ = s
                                  .words(
                                    view::Live::Is("Permanently remove selected profile data from disk"),
                                    ink=0x6B7280FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                },
                              )
                            },
                          )

                          let _ = card.box(
                            fn(chips : view::View) -> Unit {
                              let _ = chips
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .gap(view::Live::Is(8.0))

                              let check_chip = fn(label : String, sig : signals::Signal[Bool]) -> Unit {
                                let _ = headless::button(
                                  chips,
                                  fn() -> String { "Toggle Clear " + label },
                                  fn(_v : view::View) -> Unit { sig.set(!sig.untracked()) },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .height(view::Live::Is(Some(30.0)))
                                    .rigid()
                                    .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                                    .gap(view::Live::Is(6.0))
                                    .radius(view::Live::Is(6.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if sig.get() {
                                        p.accent_soft_bg
                                      } else if btn.pressed() {
                                        p.btn_press
                                      } else if btn.hovered() {
                                        p.btn_hover
                                      } else {
                                        p.surface_bg
                                      }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) {
                                      let p = chrome_palette()
                                      if sig.get() { (1.2, p.accent_soft_border) } else { (1.0, p.border) }
                                    }))
                                    let _ = b.box(
                                      fn(box_c : view::View) -> Unit {
                                        let _ = box_c
                                        .width(view::Live::Is(Some(14.0)))
                                        .height(view::Live::Is(Some(14.0)))
                                        .rigid()
                                        .center()
                                        .radius(view::Live::Is(3.5))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          if sig.get() { chrome_palette().accent } else { 0x00000000L }
                                        }))
                                        .edge(view::Live::By(fn() -> (Double, Int64) {
                                          if sig.get() { (1.0, chrome_palette().accent) } else { (1.2, chrome_palette().ink_muted) }
                                        }))
                                        box_c.show(
                                          fn() -> Bool { sig.get() },
                                          fn(ck : view::View) -> Unit {
                                            let _ = ck.words(
                                              view::Live::Is("✓"),
                                              ink=0xFFFFFFFFL,
                                              look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 700, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                      },
                                    )
                                    let _ = b.box(
                                      fn(lbl : view::View) -> Unit {
                                        let _ = lbl
                                        .words(
                                          view::Live::Is(label),
                                          ink=0x1D1D1FFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 {
                                          let p = chrome_palette()
                                          if sig.get() { p.accent_soft_ink } else { p.ink_secondary }
                                        }))
                                      },
                                    )
                                  },
                                )
                              }
                              check_chip("History", clear_hist)
                              check_chip("Downloads", clear_dl)
                              check_chip("Site Boosts", clear_boosts)
                            },
                          )

                          // Action footer row
                          let _ = card.box(
                            fn(act_row : view::View) -> Unit {
                              let _ = act_row
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              let _ = headless::button(
                                act_row,
                                fn() -> String { "Clear Selected Data" },
                                fn(_v : view::View) -> Unit {
                                  dispatch_clear_browsing_data(
                                    clear_hist.untracked(),
                                    clear_dl.untracked(),
                                    clear_boosts.untracked(),
                                  )
                                },
                                fn(b : view::View, btn : headless::Button) -> Unit {
                                  let _ = b
                                  .height(view::Live::Is(Some(32.0)))
                                  .rigid()
                                  .center()
                                  .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
                                  .radius(view::Live::Is(6.0))
                                  .ground(view::Live::By(fn() -> Int64 {
                                    let p = chrome_palette()
                                    if btn.pressed() {
                                      p.danger_border
                                    } else if btn.hovered() {
                                      p.danger_bg
                                    } else {
                                      p.danger_bg
                                    }
                                  }))
                                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().danger_border) }))
                                  let _ = b.box(
                                    fn(lbl : view::View) -> Unit {
                                      let _ = lbl
                                      .words(
                                        view::Live::Is("Clear Selected Data"),
                                        ink=0xDC2626FFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                                        one_line=true,
                                      )
                                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                                    },
                                  )
                                },
                              )
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
