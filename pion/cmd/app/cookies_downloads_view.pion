///| Native Metal UI views for:
///| 1. Real Site Cookie & Storage Inspector Modal (`wire::Message::SiteCookiesState`, tag 65)
///| 2. Upgraded Downloads Manager Popover (`Cmd+J`, Light & Dark, live UTF-8 search, category capsules,
///|    extension badges, Copy Path + Reveal actions, and Clear List footer)
///| 3. Updated Arc Keyboard Shortcuts Cheatsheet Modal (`Cmd+/` / `Cmd+?`, full Light & Dark parity)
///|
///| Uses concentric corner radii, first-line alignment, zero `·` metadata
///| concatenation, zero double dividers, zero `alpha=0` clickable buttons, and zero `ellipsis_past(true)`.

struct DownloadsTracker {
  mut seq : Int
  mut export_req_seq : Int
  mut clear_req_seq : Int
  mut main_seqs : Array[Int]
  mut split_seqs : Array[Int]
  mut main_pending_clear_id : String
  mut split_pending_clear_id : String
  // 0 = Unknown (pre-first-snapshot), 1 = LegacyArray, 2 = Envelope
  mut main_dl_cap : Int
  mut split_dl_cap : Int
  mut main_pending_pdf_req_ids : Array[String]
  mut split_pending_pdf_req_ids : Array[String]
}

let downloads_tracker : DownloadsTracker = DownloadsTracker::{
  seq: 0,
  export_req_seq: 0,
  clear_req_seq: 0,
  main_seqs: [],
  split_seqs: [],
  main_pending_clear_id: "",
  split_pending_clear_id: "",
  main_dl_cap: 0,
  split_dl_cap: 0,
  main_pending_pdf_req_ids: [],
  split_pending_pdf_req_ids: [],
}

fn reset_downloads_tracker() -> Unit {
  downloads_tracker.seq = 0
  downloads_tracker.export_req_seq = 0
  downloads_tracker.clear_req_seq = 0
  downloads_tracker.main_seqs = []
  downloads_tracker.split_seqs = []
  app_state.main_downloads = []
  app_state.split_downloads = []
  app_state.downloads = []
  clear_pending_exports_for_pane(0)
  clear_pending_exports_for_pane(1)
}

fn alloc_pdf_export_req_id(pane_id : Int) -> String {
  downloads_tracker.export_req_seq = downloads_tracker.export_req_seq + 1
  "pdf-" + net::getpid().to_string() + "-" + pane_id.to_string() + "-" + downloads_tracker.export_req_seq.to_string()
}

fn alloc_clear_req_id(pane_id : Int) -> String {
  downloads_tracker.clear_req_seq = downloads_tracker.clear_req_seq + 1
  "clr-" + net::getpid().to_string() + "-" + pane_id.to_string() + "-" + downloads_tracker.clear_req_seq.to_string()
}

fn pane_dl_cap(pane_id : Int) -> Int {
  if pane_id == 1 { downloads_tracker.split_dl_cap } else { downloads_tracker.main_dl_cap }
}

fn pane_conn_is_open(pane_id : Int) -> Bool {
  if pane_id == 1 {
    (is_split_open() || is_peek_open()) && io_rt.split_conn.is_open()
  } else {
    io_rt.main_conn.is_open()
  }
}

fn download_identity_key(d : proto::DownloadSummary) -> String {
  d.id + "|" + d.url + "|" + d.filename
}

fn download_keys_snapshot(items : Array[proto::DownloadSummary]) -> Array[String] {
  let out : Array[String] = []
  for d in items {
    out.push(download_identity_key(d))
  }
  out
}

fn download_key_seen(keys : Array[String], key : String) -> Bool {
  for k in keys {
    if k == key {
      return true
    }
  }
  false
}

fn clear_pending_exports_for_pane(pane_id : Int) -> Unit {
  if pane_id == 1 {
    downloads_tracker.split_pending_pdf_req_ids = []
    app_state.split_pending_screenshot = false
    app_state.split_screenshot_seen_keys = []
    downloads_tracker.split_pending_clear_id = ""
    downloads_tracker.split_dl_cap = 0
  } else {
    downloads_tracker.main_pending_pdf_req_ids = []
    app_state.main_pending_screenshot = false
    app_state.main_screenshot_seen_keys = []
    downloads_tracker.main_pending_clear_id = ""
    downloads_tracker.main_dl_cap = 0
  }
}

fn rebuild_merged_downloads() -> Unit {
  let merged_items : Array[proto::DownloadSummary] = []
  let merged_seqs : Array[Int] = []
  let merged_keys : Array[String] = []
  let add_pane = fn(items : Array[proto::DownloadSummary], seqs : Array[Int]) -> Unit {
    let mut i = 0
    while i < items.length() {
      let d = items[i]
      let sq = if i < seqs.length() { seqs[i] } else { 0 }
      let k = download_identity_key(d)
      let mut found = -1
      let mut j = 0
      while j < merged_keys.length() {
        if merged_keys[j] == k {
          found = j
          break
        }
        j += 1
      }
      if found >= 0 {
        if sq > merged_seqs[found] {
          merged_seqs[found] = sq
          merged_items[found] = d
        }
      } else {
        merged_keys.push(k)
        merged_items.push(d)
        merged_seqs.push(sq)
      }
      i += 1
    }
  }
  add_pane(app_state.main_downloads, downloads_tracker.main_seqs)
  add_pane(app_state.split_downloads, downloads_tracker.split_seqs)
  // Insertion sort descending by arrival sequence (stable on equal seq)
  let mut i = 1
  while i < merged_items.length() {
    let item = merged_items[i]
    let sq = merged_seqs[i]
    let mut j = i - 1
    while j >= 0 && merged_seqs[j] < sq {
      merged_items[j + 1] = merged_items[j]
      merged_seqs[j + 1] = merged_seqs[j]
      j -= 1
    }
    merged_items[j + 1] = item
    merged_seqs[j + 1] = sq
    i += 1
  }
  let out : Array[proto::DownloadSummary] = []
  let lim = if merged_items.length() < 64 { merged_items.length() } else { 64 }
  let mut k = 0
  while k < lim {
    out.push(merged_items[k])
    k += 1
  }
  app_state.downloads = out
  match app_state.downloads_rev {
    Some(s) => s.set(s.untracked() + 1)
    None => ()
  }
}

fn begin_pending_pdf_export(pane_id : Int, req_id : String) -> Unit {
  if pane_id == 1 {
    downloads_tracker.split_pending_pdf_req_ids.push(req_id)
  } else {
    downloads_tracker.main_pending_pdf_req_ids.push(req_id)
  }
  match app_state.host_downloads_synced {
    Some(s) => s.set(false)
    None => ()
  }
}

fn remove_pending_pdf_req_id(pane_id : Int, req_id : String) -> Bool {
  let src = if pane_id == 1 {
    downloads_tracker.split_pending_pdf_req_ids
  } else {
    downloads_tracker.main_pending_pdf_req_ids
  }
  let next : Array[String] = []
  let mut matched = false
  for id in src {
    if !matched && id == req_id {
      matched = true
    } else {
      next.push(id)
    }
  }
  if matched {
    if pane_id == 1 {
      downloads_tracker.split_pending_pdf_req_ids = next
    } else {
      downloads_tracker.main_pending_pdf_req_ids = next
    }
  }
  matched
}

fn begin_pending_screenshot_export(pane_id : Int) -> Unit {
  if pane_id == 1 {
    app_state.split_pending_screenshot = true
    app_state.split_screenshot_seen_keys = download_keys_snapshot(app_state.split_downloads)
  } else {
    app_state.main_pending_screenshot = true
    app_state.main_screenshot_seen_keys = download_keys_snapshot(app_state.main_downloads)
  }
  match app_state.host_downloads_synced {
    Some(s) => s.set(false)
    None => ()
  }
}

fn dispatch_export_pdf_for_pane(owner : Int, cfg_json : String) -> Unit {
  let cfg = if cfg_json.trim() != "" {
    proto::parse_print_pdf_config(cfg_json)
  } else {
    proto::print_pdf_default_config()
  }
  if pane_dl_cap(owner) == 1 {
    if send_wire_to_pane_checked(owner, wire::Message::Act("export_pdf", "", proto::encode_print_pdf_config(cfg))) {
      let msg = "Sent PDF export request"
      if app_state.is_shot_mode {
        show_persistent_demo_toast(msg, "download")
      } else {
        show_toast(msg, "download")
      }
    }
  } else {
    let req_id = alloc_pdf_export_req_id(owner)
    let payload = proto::encode_print_pdf_config_with_req(cfg, req_id)
    if send_wire_to_pane_checked(owner, wire::Message::Act("export_pdf", "", payload)) {
      begin_pending_pdf_export(owner, req_id)
    }
  }
}

fn dispatch_export_pdf() -> Unit {
  dispatch_export_pdf_for_pane(active_split_pane(), "")
}

fn dispatch_capture_screenshot() -> Unit {
  if send_wire_to_pane_checked(0, wire::Message::Act("capture_screenshot", "", "")) {
    begin_pending_screenshot_export(0)
  }
}

fn dispatch_downloads_sync() -> Unit {
  let _ = send_wire_to_pane_checked(0, wire::Message::Act("downloads_sync", "", ""))
  if (is_split_open() || is_peek_open()) && io_rt.split_conn.is_open() {
    let _ = send_wire_to_pane_checked(1, wire::Message::Act("downloads_sync", "", ""))
  }
}

fn dispatch_downloads_clear() -> Unit {
  app_state.main_downloads = []
  downloads_tracker.main_seqs = []
  app_state.split_downloads = []
  downloads_tracker.split_seqs = []
  rebuild_merged_downloads()
  if downloads_tracker.main_dl_cap != 1 {
    let clr_id = alloc_clear_req_id(0)
    if send_wire_to_pane_checked(0, wire::Message::Act("downloads_clear", clr_id, "")) {
      downloads_tracker.main_pending_clear_id = clr_id
    }
  } else {
    let _ = send_wire_to_pane_checked(0, wire::Message::Act("downloads_clear", "", ""))
  }
  if is_split_open() || is_peek_open() {
    if downloads_tracker.split_dl_cap != 1 {
      let clr_id = alloc_clear_req_id(1)
      if send_wire_to_pane_checked(1, wire::Message::Act("downloads_clear", clr_id, "")) {
        downloads_tracker.split_pending_clear_id = clr_id
      }
    } else {
      let _ = send_wire_to_pane_checked(1, wire::Message::Act("downloads_clear", "", ""))
    }
  }
}

fn set_host_downloads_state_from_pane(pane_id : Int, json : String) -> Unit {
  let env = proto::parse_downloads_envelope(json, max_items=64)
  let next_cap = if env.has_envelope { 2 } else { 1 }
  if pane_id == 1 {
    downloads_tracker.split_dl_cap = next_cap
  } else {
    downloads_tracker.main_dl_cap = next_cap
  }
  let pending_clear = if pane_id == 1 {
    downloads_tracker.split_pending_clear_id
  } else {
    downloads_tracker.main_pending_clear_id
  }
  let mut stale_pre_clear = false
  if pending_clear != "" {
    let clear_acked = if env.has_envelope {
      env.clear_ack_id == pending_clear
    } else {
      env.items.length() == 0
    }
    if clear_acked {
      if pane_id == 1 {
        downloads_tracker.split_pending_clear_id = ""
      } else {
        downloads_tracker.main_pending_clear_id = ""
      }
    } else {
      stale_pre_clear = true
    }
  }
  if !stale_pre_clear {
    let parsed = env.items
    let old_items = if pane_id == 1 { app_state.split_downloads } else { app_state.main_downloads }
    let old_seqs = if pane_id == 1 { downloads_tracker.split_seqs } else { downloads_tracker.main_seqs }
    let next_seqs : Array[Int] = []
    let mut i = 0
    while i < parsed.length() {
      let k = download_identity_key(parsed[i])
      let mut prev_sq = -1
      let mut j = 0
      while j < old_items.length() {
        if download_identity_key(old_items[j]) == k {
          prev_sq = if j < old_seqs.length() { old_seqs[j] } else { 0 }
          break
        }
        j += 1
      }
      next_seqs.push(prev_sq)
      i += 1
    }
    // Assign monotonically increasing seq from oldest to newest so index 0 has highest seq
    let mut r = parsed.length() - 1
    while r >= 0 {
      if next_seqs[r] < 0 {
        downloads_tracker.seq = downloads_tracker.seq + 1
        next_seqs[r] = downloads_tracker.seq
      }
      r -= 1
    }
    if pane_id == 1 {
      app_state.split_downloads = parsed
      downloads_tracker.split_seqs = next_seqs
    } else {
      app_state.main_downloads = parsed
      downloads_tracker.main_seqs = next_seqs
    }
    rebuild_merged_downloads()
    match app_state.host_downloads_synced {
      Some(s) => s.set(true)
      None => ()
    }
  }
  if env.export_req_id != "" && remove_pending_pdf_req_id(pane_id, env.export_req_id) {
    if env.export_ok {
      let fname = if env.export_filename != "" { env.export_filename } else { "page.pdf" }
      let msg = "Saved PDF · " + fname
      if app_state.is_shot_mode {
        show_persistent_demo_toast(msg, "download")
      } else {
        show_toast(msg, "download")
      }
    } else {
      show_toast("Failed to save PDF", "error")
    }
  }
  if !stale_pre_clear {
    let shot_pending = if pane_id == 1 { app_state.split_pending_screenshot } else { app_state.main_pending_screenshot }
    if shot_pending {
      let shot_seen = if pane_id == 1 { app_state.split_screenshot_seen_keys } else { app_state.main_screenshot_seen_keys }
      for d in env.items {
        let k = download_identity_key(d)
        if !download_key_seen(shot_seen, k) && proto::download_ext_badge(d.filename) == "PNG" {
          if pane_id == 1 {
            app_state.split_pending_screenshot = false
            app_state.split_screenshot_seen_keys = []
          } else {
            app_state.main_pending_screenshot = false
            app_state.main_screenshot_seen_keys = []
          }
          let meta = proto::capture_sheet_from_download(d, 1280, 800)
          open_capture_sheet(meta)
          break
        }
      }
    }
  }
  // If the first DownloadsState snapshot reveals a legacy array-only host, settle any pending
  // PDF req_ids sent while cap==0 so we never hang or misreport historical downloads.
  if !env.has_envelope {
    let had_pending = if pane_id == 1 {
      let n = downloads_tracker.split_pending_pdf_req_ids.length()
      downloads_tracker.split_pending_pdf_req_ids = []
      n > 0
    } else {
      let n = downloads_tracker.main_pending_pdf_req_ids.length()
      downloads_tracker.main_pending_pdf_req_ids = []
      n > 0
    }
    if had_pending {
      let msg = "Sent PDF export request"
      if app_state.is_shot_mode {
        show_persistent_demo_toast(msg, "download")
      } else {
        show_toast(msg, "download")
      }
    }
  }
}

fn dispatch_cookies_sync(host_override~ : String = "") -> Unit {
  send_wire(wire::Message::Act("cookies_sync", host_override, ""))
}

fn dispatch_cookie_delete(domain : String, path : String, name : String, host_override : String) -> Unit {
  if name == "" {
    return
  }
  let spec = domain + "|" + (if path != "" { path } else { "/" }) + "|" + name
  // Optimistic local update for immediate responsiveness
  let prev = app_state.cookies_snap
  let next_rows : Array[proto::SiteCookieRow] = []
  let mut i = 0
  while i < prev.cookies.length() {
    let c = prev.cookies[i]
    if !(c.name == name && c.domain == domain && c.path == path) {
      next_rows.push(c)
    }
    i = i + 1
  }
  app_state.cookies_snap = proto::SiteCookiesSnapshot::{
    host: prev.host,
    origin: prev.origin,
    space_id: prev.space_id,
    cookies: next_rows,
  }
  match app_state.cookies_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("cookie_delete", spec, host_override))
  show_toast("Deleted cookie " + name, "clear")
}

fn dispatch_cookies_clear_site(host_override : String) -> Unit {
  let prev = app_state.cookies_snap
  let host_label = if host_override != "" {
    host_override
  } else if prev.host != "" {
    prev.host
  } else {
    "this site"
  }
  app_state.cookies_snap = proto::SiteCookiesSnapshot::{
    host: prev.host,
    origin: prev.origin,
    space_id: prev.space_id,
    cookies: [],
  }
  match app_state.cookies_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("cookies_clear_site", host_override, ""))
  show_toast("Cleared cookies for " + host_label, "clear")
}

fn set_host_cookies_state(json : String) -> Unit {
  match proto::parse_site_cookies_state(json, max_items=256) {
    Some(snap) => {
      app_state.cookies_snap = snap
      match app_state.cookies_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_cookies_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_cookies_modal() -> Unit {
  match app_state.cookies_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.cookies_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("cookies")
}

fn open_cookies_modal(host_override~ : String = "") -> Unit {
  let nested_in_site_info = shell_sig_is_true(app_state.site_info_open)
  if !nested_in_site_info {
    close_exclusive_overlays()
  }
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.cookies_field {
    Some(f) => f.set("")
    None => ()
  }
  match app_state.cookies_open {
    Some(s) => s.set(true)
    None => ()
  }
  if nested_in_site_info {
    let _ = shell_open_nested_exclusive(shell_ui::ExclusiveKind::Dialog, "cookies")
  } else {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "cookies")
  }
  dispatch_cookies_sync(host_override=host_override)
}

fn toggle_cookies_modal() -> Unit {
  let is_open = match app_state.cookies_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_cookies_modal()
  } else {
    open_cookies_modal()
  }
}

fn copy_download_path_with_toast(d : proto::DownloadSummary) -> Unit {
  let path = proto::download_copy_path(d)
  write_os_clipboard(path)
  show_toast("Copied path: " + d.filename, "copy")
}

fn reveal_download_with_toast(d : proto::DownloadSummary) -> Unit {
  let path = proto::download_copy_path(d)
  write_os_clipboard(path)
  show_toast("Located in Downloads: " + d.filename, "info")
}

///| Builds the centered Site Cookie & Storage Inspector Modal (`wire` tag 65, 580pt wide,
///| Light & Dark `ChromePalette` aligned, concentric radii 14 -> 10 -> 6pt, first-line aligned).
fn build_cookies_modal(
  root : view::View,
  cookies_open : signals::Signal[Bool],
  cookies_rev : signals::Signal[Int],
  cookies_field : ui::Field,
) -> Unit {
  root.show(
    fn() -> Bool { cookies_open.get() },
    fn(ck_layer : view::View) -> Unit {
      let _ = ck_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Dimmed backdrop (click closes modal)
      let _ = headless::button(
        ck_layer,
        fn() -> String { "Close Cookie Inspector" },
        fn(_v : view::View) -> Unit { close_cookies_modal() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05081066L } else { 0x0F172A42L }
          }))
        },
      )

      let active_host_fn = fn() -> String {
        let _ = cookies_rev.get()
        if app_state.cookies_snap.host != "" {
          app_state.cookies_snap.host
        } else {
          let h = proto::omnibox_display_host(active_stage_live().url())
          if h != "" { h } else { "Current Site" }
        }
      }

      let filtered_cookies = fn() -> Array[proto::SiteCookieRow] {
        let _ = cookies_rev.get()
        proto::filter_site_cookies(app_state.cookies_snap.cookies, cookies_field.text())
      }

      // Centered Modal Card (580pt wide, max 540pt tall)
      let _ = ck_layer.box(
        fn(modal : view::View) -> Unit {
          let _ = modal
          .width(view::Live::Is(Some(580.0)))
          .max_height(view::Live::Is(Some(540.0)))
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(14.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (32.0, 14.0, 0x00000088L) } else { (28.0, 12.0, 0x0F172A32L) }
          }))

          // 1. Header: Title + Domain Pill + Cookie Count Badge + Esc + Close
          let _ = modal.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(580.0)))
              .height(view::Live::Is(Some(52.0)))
              .rigid()
              .padding(view::Live::Is((18.0, 0.0, 14.0, 0.0)))
              .gap(view::Live::Is(8.0))

              // Title
              let _ = hdr.box(
                fn(ht : view::View) -> Unit {
                  let _ = ht
                  .rigid()
                  .words(
                    view::Live::Is("Site Cookies & Data"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              // Domain badge pill
              let _ = hdr.box(
                fn(dpill : view::View) -> Unit {
                  let _ = dpill
                  .height(view::Live::Is(Some(22.0)))
                  .max_width(view::Live::Is(Some(180.0)))
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .center()
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                  let _ = dpill.box(
                    fn(dl : view::View) -> Unit {
                      let _ = dl
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::By(active_host_fn),
                        ink=0x1D4ED8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )

              // Total count badge
              let _ = hdr.box(
                fn(cpill : view::View) -> Unit {
                  let _ = cpill
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = cpill.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .words(
                        view::Live::By(fn() -> String {
                          let _ = cookies_rev.get()
                          let n = app_state.cookies_snap.cookies.length()
                          if n == 1 { "1 cookie" } else { n.to_string() + " cookies" }
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Flexible spacer
              let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

              // Esc hint
              let _ = hdr.box(
                fn(esc_pill : view::View) -> Unit {
                  let _ = esc_pill
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = esc_pill.box(
                    fn(el : view::View) -> Unit {
                      let _ = el
                      .words(
                        view::Live::Is("Esc"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Close × button
              let _ = headless::button(
                hdr,
                fn() -> String { "Close Site Cookies" },
                fn(_v : view::View) -> Unit { close_cookies_modal() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // 2. Search Bar Row (concentric 10pt radius inside 16pt horizontal padding)
          let _ = modal.box(
            fn(swrap : view::View) -> Unit {
              let _ = swrap
              .width(view::Live::Is(Some(580.0)))
              .rigid()
              .padding(view::Live::Is((16.0, 0.0, 16.0, 12.0)))

              let _ = swrap.box(
                fn(sbox : view::View) -> Unit {
                  let _ = sbox
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(34.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 8.0, 0.0)))
                  .gap(view::Live::Is(8.0))
                  .radius(view::Live::Is(9.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if cookies_field.focused() { (1.5, p.accent) } else { (1.0, p.border) }
                  }))

                  let _ = sbox.box(
                    fn(si : view::View) -> Unit {
                      let _ = si
                      .width(view::Live::Is(Some(14.0)))
                      .center()
                      .rigid()
                      .words(
                        view::Live::Is("⌕"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )

                  let _ = sbox.box(
                    fn(fw : view::View) -> Unit {
                      let _ = fw
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(22.0)))
                      .clips(view::Live::Is(true))

                      fw.show(
                        fn() -> Bool { !is_dark_chrome() },
                        fn(fl : view::View) -> Unit {
                          let _ = ui::field(
                            fl,
                            cookies_field,
                            placeholder="Filter cookies by name, domain, or attribute (Secure, CHIPS)...",
                            font_size=12.5,
                            color=0x1D1D1FFFL,
                            placeholder_color=0x8E8E93FFL,
                            max_lines=1,
                            enter_sends=true,
                          )
                        },
                      )
                      fw.show(
                        fn() -> Bool { is_dark_chrome() },
                        fn(fd : view::View) -> Unit {
                          let _ = ui::field(
                            fd,
                            cookies_field,
                            placeholder="Filter cookies by name, domain, or attribute (Secure, CHIPS)...",
                            font_size=12.5,
                            color=0xF1F5F9FFL,
                            placeholder_color=0x94A3B8FFL,
                            caret_color=0x60A5FAFFL,
                            max_lines=1,
                            enter_sends=true,
                          )
                        },
                      )
                    },
                  )

                  sbox.show(
                    fn() -> Bool { cookies_field.text() != "" },
                    fn(cw : view::View) -> Unit {
                      let _ = headless::button(
                        cw,
                        fn() -> String { "Clear Cookie Filter" },
                        fn(_v : view::View) -> Unit { cookies_field.set("") },
                        fn(cb : view::View, cbtn : headless::Button) -> Unit {
                          let _ = cb
                          .width(view::Live::Is(Some(20.0)))
                          .height(view::Live::Is(Some(20.0)))
                          .rigid()
                          .center()
                          .radius(view::Live::Is(5.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if cbtn.pressed() { p.btn_press } else if cbtn.hovered() { p.btn_hover } else { 0x00000000L }
                          }))
                          let _ = cb.box(
                            fn(cl : view::View) -> Unit {
                              let _ = cl
                              .words(
                                view::Live::Is("×"),
                                ink=0x6B7280FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Single hairline divider
          let _ = modal.box(
            fn(hsep : view::View) -> Unit {
              let _ = hsep
              .width(view::Live::Is(Some(580.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // 3. Scrollable Cookie Rows Body
          let _ = modal.box(
            fn(body_wrap : view::View) -> Unit {
              let _ = body_wrap
              .width(view::Live::Is(Some(580.0)))
              .height(view::Live::Is(Some(356.0)))
              .rigid()
              .clips(view::Live::Is(true))

              let _ = ui::scroll_box(
                body_wrap,
                fn(sc : view::View) -> Unit {
                  let _ = sc
                  .width(view::Live::Is(Some(580.0)))
                  .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
                  .gap(view::Live::Is(8.0))

                  // Empty state
                  sc.show(
                    fn() -> Bool { filtered_cookies().length() == 0 },
                    fn(emp : view::View) -> Unit {
                      let _ = emp
                      .width(view::Live::Is(Some(548.0)))
                      .height(view::Live::Is(Some(120.0)))
                      .rigid()
                      .center()
                      .gap(view::Live::Is(4.0))
                      .radius(view::Live::Is(10.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                      let _ = emp.box(
                        fn(et : view::View) -> Unit {
                          let _ = et
                          .words(
                            view::Live::By(fn() -> String {
                              if cookies_field.text().trim() != "" {
                                "No cookies match your filter"
                              } else {
                                "No cookies stored for this site"
                              }
                            }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                      let _ = emp.box(
                        fn(es : view::View) -> Unit {
                          let _ = es
                          .words(
                            view::Live::Is("Cookies set by HTTP headers or document.cookie appear here."),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )

                  // Dynamic cookie rows (up to 32 rendered reactively)
                  let mut cslot = 0
                  while cslot < 32 {
                    let cidx = cslot
                    sc.show(
                      fn() -> Bool { cidx < filtered_cookies().length() },
                      fn(rwrap : view::View) -> Unit {
                        let get_ck = fn() -> Option[proto::SiteCookieRow] {
                          let list = filtered_cookies()
                          if cidx < list.length() { Some(list[cidx]) } else { None }
                        }
                        let _ = rwrap.box(
                          fn(crow : view::View) -> Unit {
                            // First-line alignment (`Along::Start`)
                            let _ = crow
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Start)))
                            .width(view::Live::Is(Some(548.0)))
                            .rigid()
                            .padding(view::Live::Is((12.0, 10.0, 10.0, 10.0)))
                            .gap(view::Live::Is(10.0))
                            .radius(view::Live::Is(10.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                            .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

                            // Left column: Line 1 (Cookie Name + Security Badges) & Line 2 (Domain/Path + Value Preview + Expiry)
                            let _ = crow.box(
                              fn(left : view::View) -> Unit {
                                let _ = left
                                .grow(view::Live::Is(1.0))
                                .shrink(view::Live::Is(1.0))
                                .basis(view::Live::Is(Some(0.0)))
                                .min_width(view::Live::Is(Some(0.0)))
                                .gap(view::Live::Is(5.0))

                                // Line 1: Cookie name + compact security attribute badges
                                let _ = left.box(
                                  fn(top_line : view::View) -> Unit {
                                    let _ = top_line
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .gap(view::Live::Is(6.0))

                                    let _ = top_line.box(
                                      fn(nm : view::View) -> Unit {
                                        let _ = nm
                                        .shrink(view::Live::Is(1.0))
                                        .min_width(view::Live::Is(Some(0.0)))
                                        .clips(view::Live::Is(true))
                                        .words(
                                          view::Live::By(fn() -> String {
                                            match get_ck() {
                                              Some(c) => c.name
                                              None => ""
                                            }
                                          }),
                                          ink=0x1D1D1FFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                      },
                                    )

                                    // Compact badge helper
                                    let render_attr_badge = fn(
                                      parent : view::View,
                                      label_fn : () -> String,
                                      bg_fn : () -> Int64,
                                      bd_fn : () -> Int64,
                                      ink_fn : () -> Int64,
                                    ) -> Unit {
                                      let _ = parent.box(
                                        fn(b : view::View) -> Unit {
                                          let _ = b
                                          .height(view::Live::Is(Some(18.0)))
                                          .rigid()
                                          .center()
                                          .padding(view::Live::Is((5.5, 0.0, 5.5, 0.0)))
                                          .radius(view::Live::Is(5.0))
                                          .ground(view::Live::By(bg_fn))
                                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, bd_fn()) }))
                                          let _ = b.box(
                                            fn(bt : view::View) -> Unit {
                                              let _ = bt
                                              .words(
                                                view::Live::By(label_fn),
                                                ink=0x1D1D1FFFL,
                                                look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                                                one_line=true,
                                              )
                                              .ink(view::Live::By(ink_fn))
                                            },
                                          )
                                        },
                                      )
                                    }

                                    // Secure badge (green)
                                    top_line.show(
                                      fn() -> Bool {
                                        match get_ck() {
                                          Some(c) => c.secure
                                          None => false
                                        }
                                      },
                                      fn(w : view::View) -> Unit {
                                        render_attr_badge(
                                          w,
                                          fn() -> String { "Secure" },
                                          fn() -> Int64 { if is_dark_chrome() { 0x132C22FFL } else { 0xE6F4EAFFL } },
                                          fn() -> Int64 { if is_dark_chrome() { 0x204D3AFFL } else { 0xB7E1C4FFL } },
                                          fn() -> Int64 { if is_dark_chrome() { 0x6EE7B7FFL } else { 0x137333FFL } },
                                        )
                                      },
                                    )

                                    // HttpOnly badge (blue)
                                    top_line.show(
                                      fn() -> Bool {
                                        match get_ck() {
                                          Some(c) => c.http_only
                                          None => false
                                        }
                                      },
                                      fn(w : view::View) -> Unit {
                                        render_attr_badge(
                                          w,
                                          fn() -> String { "HttpOnly" },
                                          fn() -> Int64 { if is_dark_chrome() { 0x1A2D49FFL } else { 0xE8F0FEFFL } },
                                          fn() -> Int64 { if is_dark_chrome() { 0x2C4A78FFL } else { 0xBFDBFEFFL } },
                                          fn() -> Int64 { if is_dark_chrome() { 0x93C5FDFFL } else { 0x1D4ED8FFL } },
                                        )
                                      },
                                    )

                                    // SameSite badge (neutral / amber for None)
                                    render_attr_badge(
                                      top_line,
                                      fn() -> String {
                                        match get_ck() {
                                          Some(c) => "SameSite=" + proto::normalize_cookie_same_site(c.same_site)
                                          None => "SameSite=Lax"
                                        }
                                      },
                                      fn() -> Int64 {
                                        let dark = is_dark_chrome()
                                        let is_none = match get_ck() {
                                          Some(c) => proto::normalize_cookie_same_site(c.same_site) == "None"
                                          None => false
                                        }
                                        if is_none {
                                          if dark { 0x342613FFL } else { 0xFEF3C7FFL }
                                        } else if dark {
                                          0x282D3AFFL
                                        } else {
                                          0xEEF1F7FFL
                                        }
                                      },
                                      fn() -> Int64 {
                                        let dark = is_dark_chrome()
                                        let is_none = match get_ck() {
                                          Some(c) => proto::normalize_cookie_same_site(c.same_site) == "None"
                                          None => false
                                        }
                                        if is_none {
                                          if dark { 0x5B411BFFL } else { 0xFDE68AFFL }
                                        } else {
                                          chrome_palette().border
                                        }
                                      },
                                      fn() -> Int64 {
                                        let dark = is_dark_chrome()
                                        let is_none = match get_ck() {
                                          Some(c) => proto::normalize_cookie_same_site(c.same_site) == "None"
                                          None => false
                                        }
                                        if is_none {
                                          if dark { 0xFCD34DFFL } else { 0xB45309FFL }
                                        } else {
                                          chrome_palette().ink_secondary
                                        }
                                      },
                                    )

                                    // CHIPS Partitioned badge (purple)
                                    top_line.show(
                                      fn() -> Bool {
                                        match get_ck() {
                                          Some(c) => c.partitioned
                                          None => false
                                        }
                                      },
                                      fn(w : view::View) -> Unit {
                                        render_attr_badge(
                                          w,
                                          fn() -> String { "CHIPS" },
                                          fn() -> Int64 { if is_dark_chrome() { 0x2A1F46FFL } else { 0xF3E8FFFFL } },
                                          fn() -> Int64 { if is_dark_chrome() { 0x4A3678FFL } else { 0xDDD6FEFFL } },
                                          fn() -> Int64 { if is_dark_chrome() { 0xC4B5FDFFL } else { 0x6D28D9FFL } },
                                        )
                                      },
                                    )
                                  },
                                )

                                // Line 2: Domain + Path + Masked Value Preview + Expiry (spaced cleanly, zero `·`)
                                let _ = left.box(
                                  fn(meta_line : view::View) -> Unit {
                                    let _ = meta_line
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .gap(view::Live::Is(12.0))

                                    // Domain + Path
                                    let _ = meta_line.box(
                                      fn(dp : view::View) -> Unit {
                                        let _ = dp
                                        .max_width(view::Live::Is(Some(190.0)))
                                        .shrink(view::Live::Is(1.0))
                                        .min_width(view::Live::Is(Some(0.0)))
                                        .clips(view::Live::Is(true))
                                        .words(
                                          view::Live::By(fn() -> String {
                                            match get_ck() {
                                              Some(c) => c.domain + c.path
                                              None => ""
                                            }
                                          }),
                                          ink=0x6B7280FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                                      },
                                    )

                                    // Masked Value Preview
                                    let _ = meta_line.box(
                                      fn(vp : view::View) -> Unit {
                                        let _ = vp
                                        .grow(view::Live::Is(1.0))
                                        .shrink(view::Live::Is(1.0))
                                        .basis(view::Live::Is(Some(0.0)))
                                        .min_width(view::Live::Is(Some(0.0)))
                                        .clips(view::Live::Is(true))
                                        .words(
                                          view::Live::By(fn() -> String {
                                            match get_ck() {
                                              Some(c) => c.value_preview
                                              None => ""
                                            }
                                          }),
                                          ink=0x8E8E93FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                      },
                                    )

                                    // Expires label
                                    let _ = meta_line.box(
                                      fn(ex : view::View) -> Unit {
                                        let _ = ex
                                        .rigid()
                                        .words(
                                          view::Live::By(fn() -> String {
                                            match get_ck() {
                                              Some(c) => if c.is_session { "Session" } else { "Exp " + c.expires_label }
                                              None => ""
                                            }
                                          }),
                                          ink=0x8E8E93FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                      },
                                    )
                                  },
                                )
                              },
                            )

                            // Right: Single-row delete × button (aligned with first line, always visible & clickable)
                            let _ = headless::button(
                              crow,
                              fn() -> String {
                                match get_ck() {
                                  Some(c) => "Delete cookie " + c.name
                                  None => "Delete cookie"
                                }
                              },
                              fn(_v : view::View) -> Unit {
                                match get_ck() {
                                  Some(c) => dispatch_cookie_delete(c.domain, c.path, c.name, app_state.cookies_snap.host)
                                  None => ()
                                }
                              },
                              fn(db : view::View, dbtn : headless::Button) -> Unit {
                                let _ = db
                                .width(view::Live::Is(Some(22.0)))
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if dbtn.pressed() {
                                    p.danger_bg
                                  } else if dbtn.hovered() {
                                    p.btn_hover
                                  } else {
                                    p.btn_bg
                                  }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) {
                                  let p = chrome_palette()
                                  if dbtn.pressed() || dbtn.hovered() { (1.0, p.danger_border) } else { (1.0, p.border) }
                                }))
                                let _ = db.box(
                                  fn(dl : view::View) -> Unit {
                                    let _ = dl
                                    .words(
                                      view::Live::Is("×"),
                                      ink=0x6B7280FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if dbtn.pressed() || dbtn.hovered() { p.danger } else { p.ink_muted }
                                    }))
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                    cslot = cslot + 1
                  }
                },
              )
            },
          )

          // Single hairline divider before footer
          let _ = modal.box(
            fn(fsep : view::View) -> Unit {
              let _ = fsep
              .width(view::Live::Is(Some(580.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // 4. Footer: Space partition summary + Clear Site Cookies danger button + Done
          let _ = modal.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(580.0)))
              .height(view::Live::Is(Some(52.0)))
              .rigid()
              .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
              .gap(view::Live::Is(10.0))

              let _ = ftr.box(
                fn(finfo : view::View) -> Unit {
                  let _ = finfo
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(fn() -> String {
                      let _ = cookies_rev.get()
                      let shown = filtered_cookies().length()
                      let total = app_state.cookies_snap.cookies.length()
                      let sp = if app_state.cookies_snap.space_id != "" {
                        format_space_label(app_state.cookies_snap.space_id)
                      } else {
                        app_state.space_name
                      }
                      if shown == total {
                        "Space: " + sp + "  |  Showing " + total.to_string() + " stored"
                      } else {
                        "Space: " + sp + "  |  Showing " + shown.to_string() + " of " + total.to_string()
                      }
                    }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )

              // Clear Site Cookies danger button
              let _ = headless::button(
                ftr,
                fn() -> String { "Clear Site Cookies" },
                fn(_v : view::View) -> Unit { dispatch_cookies_clear_site(app_state.cookies_snap.host) },
                fn(cb : view::View, cbtn : headless::Button) -> Unit {
                  let _ = cb
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                  .radius(view::Live::Is(7.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if cbtn.pressed() {
                      if p.is_dark { 0x4A232BFFL } else { 0xFEE2E2FFL }
                    } else if cbtn.hovered() {
                      if p.is_dark { 0x3F2026FFL } else { 0xFEF2F2FFL }
                    } else {
                      p.danger_bg
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().danger_border) }))
                  let _ = cb.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .words(
                        view::Live::Is("Clear Site Cookies"),
                        ink=0xDC2626FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                    },
                  )
                },
              )

              // Done button
              let _ = headless::button(
                ftr,
                fn() -> String { "Done" },
                fn(_v : view::View) -> Unit { close_cookies_modal() },
                fn(db : view::View, dbtn : headless::Button) -> Unit {
                  let _ = db
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                  .radius(view::Live::Is(7.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if dbtn.pressed() { p.btn_press } else if dbtn.hovered() { p.btn_hover } else { p.btn_bg }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = db.box(
                    fn(dl : view::View) -> Unit {
                      let _ = dl
                      .words(
                        view::Live::Is("Done"),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Builds the upgraded Arc Downloads Manager Popover (`Cmd+J`, 412pt wide, Light & Dark `ChromePalette`,
///| live UTF-8 search box, category capsules All/PDF/Images/Other, extension color badges,
///| Copy Path + Reveal row actions, and Clear List footer).
fn build_downloads_popover(
  root : view::View,
  downloads_open : signals::Signal[Bool],
  downloads_rev : signals::Signal[Int],
  downloads_field : ui::Field,
  downloads_cat : signals::Signal[String],
) -> Unit {
  root.show(
    fn() -> Bool { downloads_open.get() },
    fn(dpop : view::View) -> Unit {
      let filtered_dl = fn() -> Array[proto::DownloadSummary] {
        let _ = downloads_rev.get()
        let cat = downloads_cat.get()
        proto::filter_downloads(app_state.downloads, downloads_field.text(), cat)
      }

      let _ = dpop
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        match app_state.address_bar_view {
          Some(ab) => {
            let (_, ay, _, ah) = ab.placed_now()
            let top = if ah > 10.0 { ay + ah + 6.0 } else { 48.0 }
            (None, Some(top), Some(10.0), None)
          }
          None => (None, Some(48.0), Some(10.0), None)
        }
      }))
      .width(view::Live::Is(Some(412.0)))
      .clips(view::Live::Is(true))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (26.0, 10.0, 0x00000078L) } else { (22.0, 8.0, 0x0F172A24L) }
      }))

      // 1. Header: Downloads title + total count pill + close ×
      let _ = dpop.box(
        fn(dhdr : view::View) -> Unit {
          let _ = dhdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .width(view::Live::Is(Some(412.0)))
          .height(view::Live::Is(Some(44.0)))
          .rigid()
          .padding(view::Live::Is((14.0, 0.0, 12.0, 0.0)))
          .gap(view::Live::Is(8.0))

          let _ = dhdr.box(
            fn(dl_t : view::View) -> Unit {
              let _ = dl_t
              .rigid()
              .words(
                view::Live::Is("Downloads"),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )

          let _ = dhdr.box(
            fn(cnt_pill : view::View) -> Unit {
              let _ = cnt_pill
              .height(view::Live::Is(Some(20.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
              .radius(view::Live::Is(10.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = cnt_pill.box(
                fn(cl : view::View) -> Unit {
                  let _ = cl
                  .words(
                    view::Live::By(fn() -> String {
                      let _ = downloads_rev.get()
                      let n = app_state.downloads.length()
                      if n == 1 { "1 file" } else { n.to_string() + " files" }
                    }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )

          let _ = dhdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

          let _ = headless::button(
            dhdr,
            fn() -> String { "Close Downloads" },
            fn(_v : view::View) -> Unit { close_downloads() },
            fn(xb : view::View, xbtn : headless::Button) -> Unit {
              let _ = xb
              .width(view::Live::Is(Some(22.0)))
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
              }))
              let _ = xb.box(
                fn(xl : view::View) -> Unit {
                  let _ = xl
                  .words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )

      // 2. Search Bar + Compact Category Capsules (All / PDF / Images / Other)
      let _ = dpop.box(
        fn(ctrl : view::View) -> Unit {
          let _ = ctrl
          .width(view::Live::Is(Some(412.0)))
          .rigid()
          .padding(view::Live::Is((12.0, 0.0, 12.0, 10.0)))
          .gap(view::Live::Is(8.0))

          // Search input
          let _ = ctrl.box(
            fn(sbox : view::View) -> Unit {
              let _ = sbox
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(30.0)))
              .rigid()
              .padding(view::Live::Is((9.0, 0.0, 6.0, 0.0)))
              .gap(view::Live::Is(7.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let p = chrome_palette()
                if downloads_field.focused() { (1.5, p.accent) } else { (1.0, p.border) }
              }))

              let _ = sbox.box(
                fn(si : view::View) -> Unit {
                  let _ = si
                  .width(view::Live::Is(Some(13.0)))
                  .center()
                  .rigid()
                  .words(
                    view::Live::Is("⌕"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )

              let _ = sbox.box(
                fn(fw : view::View) -> Unit {
                  let _ = fw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(20.0)))
                  .clips(view::Live::Is(true))

                  fw.show(
                    fn() -> Bool { !is_dark_chrome() },
                    fn(fl : view::View) -> Unit {
                      let _ = ui::field(
                        fl,
                        downloads_field,
                        placeholder="Search downloads by name or domain...",
                        font_size=12.0,
                        color=0x1D1D1FFFL,
                        placeholder_color=0x8E8E93FFL,
                        max_lines=1,
                        enter_sends=true,
                      )
                    },
                  )
                  fw.show(
                    fn() -> Bool { is_dark_chrome() },
                    fn(fd : view::View) -> Unit {
                      let _ = ui::field(
                        fd,
                        downloads_field,
                        placeholder="Search downloads by name or domain...",
                        font_size=12.0,
                        color=0xF1F5F9FFL,
                        placeholder_color=0x94A3B8FFL,
                        caret_color=0x60A5FAFFL,
                        max_lines=1,
                        enter_sends=true,
                      )
                    },
                  )
                },
              )

              sbox.show(
                fn() -> Bool { downloads_field.text() != "" },
                fn(cw : view::View) -> Unit {
                  let _ = headless::button(
                    cw,
                    fn() -> String { "Clear Downloads Filter" },
                    fn(_v : view::View) -> Unit { downloads_field.set("") },
                    fn(cb : view::View, cbtn : headless::Button) -> Unit {
                      let _ = cb
                      .width(view::Live::Is(Some(18.0)))
                      .height(view::Live::Is(Some(18.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(5.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if cbtn.pressed() { p.btn_press } else if cbtn.hovered() { p.btn_hover } else { 0x00000000L }
                      }))
                      let _ = cb.box(
                        fn(cl : view::View) -> Unit {
                          let _ = cl
                          .words(
                            view::Live::Is("×"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Category filter capsules row
          let _ = ctrl.box(
            fn(cats : view::View) -> Unit {
              let _ = cats
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(6.0))

              let cat_pill = fn(lbl : String, key : String) -> Unit {
                let _ = headless::button(
                  cats,
                  fn() -> String { "Filter " + lbl },
                  fn(_v : view::View) -> Unit { downloads_cat.set(key) },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let active = fn() -> Bool { downloads_cat.get() == key }
                    let _ = b
                    .height(view::Live::Is(Some(24.0)))
                    .rigid()
                    .center()
                    .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                    .radius(view::Live::Is(12.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if active() {
                        p.accent_soft_bg
                      } else if btn.pressed() {
                        p.btn_press
                      } else if btn.hovered() {
                        p.btn_hover
                      } else {
                        p.surface_subtle
                      }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      let p = chrome_palette()
                      if active() { (1.0, p.accent_soft_border) } else { (1.0, p.border) }
                    }))
                    let _ = b.box(
                      fn(t : view::View) -> Unit {
                        let _ = t
                        .words(
                          view::Live::Is(lbl),
                          ink=0x3A4152FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if active() { p.accent_soft_ink } else { p.ink_secondary }
                        }))
                      },
                    )
                  },
                )
              }

              cat_pill("All", "all")
              cat_pill("PDF", "pdf")
              cat_pill("Images", "images")
              cat_pill("Other", "other")
            },
          )
        },
      )

      // Single hairline divider
      let _ = dpop.box(
        fn(hsep : view::View) -> Unit {
          let _ = hsep
          .width(view::Live::Is(Some(412.0)))
          .height(view::Live::Is(Some(1.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // 3. Scrollable Download Items List
      let _ = dpop.box(
        fn(list_wrap : view::View) -> Unit {
          let _ = list_wrap
          .width(view::Live::Is(Some(412.0)))
          .max_height(view::Live::Is(Some(324.0)))
          .clips(view::Live::Is(true))

          let _ = ui::scroll_box(
            list_wrap,
            fn(sc : view::View) -> Unit {
              let _ = sc
              .width(view::Live::Is(Some(412.0)))
              .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
              .gap(view::Live::Is(8.0))

              // Empty state
              sc.show(
                fn() -> Bool { filtered_dl().length() == 0 },
                fn(emp : view::View) -> Unit {
                  let _ = emp
                  .width(view::Live::Is(Some(388.0)))
                  .height(view::Live::Is(Some(80.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                  let _ = emp.box(
                    fn(et : view::View) -> Unit {
                      let _ = et
                      .words(
                        view::Live::By(fn() -> String {
                          if downloads_field.text().trim() != "" || downloads_cat.get() != "all" {
                            "No matching downloads"
                          } else {
                            "No recent downloads"
                          }
                        }),
                        ink=0x8E8E93FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Up to 16 download rows
              let mut dslot = 0
              while dslot < 16 {
                let didx = dslot
                sc.show(
                  fn() -> Bool { didx < filtered_dl().length() },
                  fn(drow_wrap : view::View) -> Unit {
                    let get_dl = fn() -> Option[proto::DownloadSummary] {
                      let list = filtered_dl()
                      if didx < list.length() { Some(list[didx]) } else { None }
                    }
                    let _ = drow_wrap.box(
                      fn(drow : view::View) -> Unit {
                        // First-line alignment (`Along::Start`) so extension badge & content align cleanly
                        let _ = drow
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Start)))
                        .width(view::Live::Is(Some(388.0)))
                        .rigid()
                        .clips(view::Live::Is(true))
                        .gap(view::Live::Is(10.0))
                        .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
                        .radius(view::Live::Is(8.0))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

                        // Extension color badge (36x28, R=6)
                        let _ = drow.box(
                          fn(fbadge : view::View) -> Unit {
                            let ext_fn = fn() -> String {
                              match get_dl() {
                                Some(d) => proto::download_ext_badge(d.filename)
                                None => "FILE"
                              }
                            }
                            let _ = fbadge
                            .width(view::Live::Is(Some(36.0)))
                            .height(view::Live::Is(Some(28.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let ex = ext_fn()
                              let dark = is_dark_chrome()
                              if ex == "PDF" {
                                if dark { 0x3A1D21FFL } else { 0xFCE8E6FFL }
                              } else if ex == "PNG" || ex == "JPG" || ex == "JPEG" || ex == "WEBP" || ex == "SVG" {
                                if dark { 0x132C22FFL } else { 0xE6F4EAFFL }
                              } else if ex == "DMG" || ex == "ZIP" || ex == "TAR" {
                                if dark { 0x1A2E4BFFL } else { 0xE8F0FEFFL }
                              } else if ex == "MP4" || ex == "MOV" {
                                if dark { 0x2E1F4BFFL } else { 0xF3E8FFFFL }
                              } else if dark {
                                0x262B38FFL
                              } else {
                                0xEEF0F5FFL
                              }
                            }))
                            let _ = fbadge.box(
                              fn(eb : view::View) -> Unit {
                                let _ = eb
                                .words(
                                  view::Live::By(ext_fn),
                                  ink=0x3A4152FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  let ex = ext_fn()
                                  let dark = is_dark_chrome()
                                  if ex == "PDF" {
                                    if dark { 0xFCA5A5FFL } else { 0xC5221FFFL }
                                  } else if ex == "PNG" || ex == "JPG" || ex == "JPEG" || ex == "WEBP" || ex == "SVG" {
                                    if dark { 0x6EE7B7FFL } else { 0x137333FFL }
                                  } else if ex == "DMG" || ex == "ZIP" || ex == "TAR" {
                                    if dark { 0x93C5FDFFL } else { 0x1967D2FFL }
                                  } else if ex == "MP4" || ex == "MOV" {
                                    if dark { 0xC4B5FDFFL } else { 0x7C3AEDFFL }
                                  } else if dark {
                                    0xCBD5E1FFL
                                  } else {
                                    0x4B5563FFL
                                  }
                                }))
                              },
                            )
                          },
                        )

                        // Middle + Actions column
                        let _ = drow.box(
                          fn(dmid : view::View) -> Unit {
                            let _ = dmid
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .gap(view::Live::Is(4.0))

                            // Row 1: Filename + Status Pill
                            let _ = dmid.box(
                              fn(top_r : view::View) -> Unit {
                                let _ = top_r
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .min_width(view::Live::Is(Some(0.0)))
                                .gap(view::Live::Is(8.0))

                                let _ = top_r.box(
                                  fn(fnm : view::View) -> Unit {
                                    let _ = fnm
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_dl() {
                                          Some(d) => d.filename
                                          None => ""
                                        }
                                      }),
                                      ink=0x1D1D1FFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                  },
                                )

                                // Compact status pill
                                let _ = top_r.box(
                                  fn(spill : view::View) -> Unit {
                                    let st_fn = fn() -> String {
                                      match get_dl() {
                                        Some(d) => proto::normalize_download_state(d.state)
                                        None => "completed"
                                      }
                                    }
                                    let _ = spill
                                    .height(view::Live::Is(Some(18.0)))
                                    .rigid()
                                    .center()
                                    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                    .radius(view::Live::Is(9.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let s = st_fn()
                                      let dark = is_dark_chrome()
                                      if s == "in_progress" {
                                        if dark { 0x1A2E4BFFL } else { 0xE8F0FEFFL }
                                      } else if s == "failed" {
                                        if dark { 0x3A1D21FFL } else { 0xFCE8E6FFL }
                                      } else if s == "cancelled" {
                                        if dark { 0x262B38FFL } else { 0xEEF0F4FFL }
                                      } else if dark {
                                        0x102E23FFL
                                      } else {
                                        0xE6F4EAFFL
                                      }
                                    }))
                                    let _ = spill.box(
                                      fn(stlbl : view::View) -> Unit {
                                        let _ = stlbl
                                        .words(
                                          view::Live::By(fn() -> String { proto::download_state_label(st_fn()) }),
                                          ink=0x137333FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 {
                                          let s = st_fn()
                                          let dark = is_dark_chrome()
                                          if s == "in_progress" {
                                            if dark { 0x93C5FDFFL } else { 0x1967D2FFL }
                                          } else if s == "failed" {
                                            if dark { 0xFCA5A5FFL } else { 0xC5221FFFL }
                                          } else if s == "cancelled" {
                                            if dark { 0x94A3B8FFL } else { 0x6E6E73FFL }
                                          } else if dark {
                                            0x34D399FFL
                                          } else {
                                            0x137333FFL
                                          }
                                        }))
                                      },
                                    )
                                  },
                                )
                              },
                            )

                            // Row 2: Source Host + File Size + Copy Path / Reveal actions
                            let _ = dmid.box(
                              fn(bot_r : view::View) -> Unit {
                                let _ = bot_r
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .min_width(view::Live::Is(Some(0.0)))
                                .gap(view::Live::Is(8.0))

                                // Source domain
                                let _ = bot_r.box(
                                  fn(dhost : view::View) -> Unit {
                                    let _ = dhost
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_dl() {
                                          Some(d) => proto::omnibox_display_host(d.url)
                                          None => ""
                                        }
                                      }),
                                      ink=0x6E6E73FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )

                                // File size
                                let _ = bot_r.box(
                                  fn(dsz : view::View) -> Unit {
                                    let _ = dsz
                                    .rigid()
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_dl() {
                                          Some(d) => proto::format_download_bytes(d.bytes)
                                          None => ""
                                        }
                                      }),
                                      ink=0x8E8E93FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )

                                // Copy Path button
                                let _ = headless::button(
                                  bot_r,
                                  fn() -> String { "Copy Path" },
                                  fn(_v : view::View) -> Unit {
                                    match get_dl() {
                                      Some(d) => copy_download_path_with_toast(d)
                                      None => ()
                                    }
                                  },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .height(view::Live::Is(Some(20.0)))
                                    .rigid()
                                    .center()
                                    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                    .radius(view::Live::Is(5.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_bg }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                                    let _ = b.box(
                                      fn(t : view::View) -> Unit {
                                        let _ = t
                                        .words(
                                          view::Live::Is("Copy Path"),
                                          ink=0x3A4152FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                                      },
                                    )
                                  },
                                )

                                // Reveal button
                                let _ = headless::button(
                                  bot_r,
                                  fn() -> String { "Reveal" },
                                  fn(_v : view::View) -> Unit {
                                    match get_dl() {
                                      Some(d) => reveal_download_with_toast(d)
                                      None => ()
                                    }
                                  },
                                  fn(b : view::View, btn : headless::Button) -> Unit {
                                    let _ = b
                                    .height(view::Live::Is(Some(20.0)))
                                    .rigid()
                                    .center()
                                    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                    .radius(view::Live::Is(5.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_bg }
                                    }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                                    let _ = b.box(
                                      fn(t : view::View) -> Unit {
                                        let _ = t
                                        .words(
                                          view::Live::Is("Reveal"),
                                          ink=0x3A4152FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
                dslot = dslot + 1
              }
            },
          )
        },
      )

      // Single hairline divider before footer
      let _ = dpop.box(
        fn(fsep : view::View) -> Unit {
          let _ = fsep
          .width(view::Live::Is(Some(412.0)))
          .height(view::Live::Is(Some(1.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // 4. Footer: Folder hint + Clear List button
      let _ = dpop.box(
        fn(dftr : view::View) -> Unit {
          let _ = dftr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .width(view::Live::Is(Some(412.0)))
          .height(view::Live::Is(Some(42.0)))
          .rigid()
          .padding(view::Live::Is((14.0, 0.0, 12.0, 0.0)))
          .gap(view::Live::Is(8.0))

          let _ = dftr.box(
            fn(fh : view::View) -> Unit {
              let _ = fh
              .grow(view::Live::Is(1.0))
              .words(
                view::Live::By(fn() -> String {
                  let shown = filtered_dl().length()
                  let total = app_state.downloads.length()
                  if total == 0 {
                    "Saved to ~/Downloads"
                  } else if shown == total {
                    "Showing all " + total.to_string() + " downloads"
                  } else {
                    "Showing " + shown.to_string() + " of " + total.to_string()
                  }
                }),
                ink=0x8E8E93FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )

          let _ = headless::button(
            dftr,
            fn() -> String { "Clear List" },
            fn(_v : view::View) -> Unit {
              dispatch_downloads_clear()
              show_toast("Cleared downloads list", "clear")
            },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .height(view::Live::Is(Some(26.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = b.box(
                fn(cl : view::View) -> Unit {
                  let _ = cl
                  .words(
                    view::Live::Is("Clear List"),
                    ink=0x5A6275FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Builds the updated Arc Keyboard Shortcuts Cheatsheet Modal (`Cmd+/` / `Cmd+?`, 568pt wide,
///| 100% Light & Dark `ChromePalette` aligned, concentric radii 14 -> 8 -> 6pt,
///| covering Navigation & Tabs + Tools & Reading without truncation or overflow).
fn build_shortcuts_modal(
  root : view::View,
  shortcuts_open : signals::Signal[Bool],
) -> Unit {
  root.show(
    fn() -> Bool { shortcuts_open.get() },
    fn(sc_layer : view::View) -> Unit {
      let _ = sc_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Dimmed backdrop (click closes modal)
      let _ = headless::button(
        sc_layer,
        fn() -> String { "Close Shortcuts Guide" },
        fn(_v : view::View) -> Unit { close_shortcuts() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05081066L } else { 0x0F172A42L }
          }))
        },
      )

      let is_macos = ui::keys_system() <= 0
      let mod_k = fn(k : String) -> String { if is_macos { "⌘" + k } else { "Ctrl+" + k } }
      let shift_mod_k = fn(k : String) -> String { if is_macos { "⇧⌘" + k } else { "Ctrl+Shift+" + k } }
      let alt_mod_k = fn(k : String) -> String { if is_macos { "⌥⌘" + k } else { "Ctrl+Alt+" + k } }

      let render_sc_group = fn(parent : view::View, title : String, rows : Array[(String, String)]) -> Unit {
        let _ = parent.box(
          fn(card : view::View) -> Unit {
            let _ = card
            .width(view::Live::Is(Some(262.0)))
            .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
            .gap(view::Live::Is(5.0))
            .radius(view::Live::Is(8.0))
            .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
            .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

            let _ = card.box(
              fn(gh : view::View) -> Unit {
                let _ = gh
                .padding(view::Live::Is((0.0, 0.0, 0.0, 3.0)))
                .words(
                  view::Live::Is(title),
                  ink=0x6B7280FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
              },
            )

            let mut ri = 0
            while ri < rows.length() {
              let r_label = rows[ri].0
              let r_keys = rows[ri].1
              let _ = card.box(
                fn(srow : view::View) -> Unit {
                  let _ = srow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .width(view::Live::Is(Some(238.0)))
                  .height(view::Live::Is(Some(23.0)))
                  .rigid()
                  .gap(view::Live::Is(8.0))

                  let _ = srow.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::Is(r_label),
                        ink=0x374151FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )

                  let _ = srow.box(
                    fn(cap : view::View) -> Unit {
                      let _ = cap
                      .height(view::Live::Is(Some(20.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                      let _ = cap.box(
                        fn(ck : view::View) -> Unit {
                          let _ = ck
                          .words(
                            view::Live::Is(r_keys),
                            ink=0x1F2937FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )
                },
              )
              ri = ri + 1
            }
          },
        )
      }

      let _ = sc_layer.box(
        fn(modal : view::View) -> Unit {
          let _ = modal
          .width(view::Live::Is(Some(568.0)))
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(14.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (32.0, 14.0, 0x00000088L) } else { (28.0, 12.0, 0x0F172A30L) }
          }))

          // Header
          let _ = modal.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(568.0)))
              .height(view::Live::Is(Some(48.0)))
              .rigid()
              .padding(view::Live::Is((18.0, 0.0, 14.0, 0.0)))
              .gap(view::Live::Is(8.0))

              let _ = hdr.box(
                fn(ht : view::View) -> Unit {
                  let _ = ht
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("Keyboard Shortcuts"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              let _ = hdr.box(
                fn(esc_pill : view::View) -> Unit {
                  let _ = esc_pill
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = esc_pill.box(
                    fn(el : view::View) -> Unit {
                      let _ = el
                      .words(
                        view::Live::Is("Esc"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              let _ = headless::button(
                hdr,
                fn() -> String { "Close Shortcuts" },
                fn(_v : view::View) -> Unit { close_shortcuts() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Single hairline divider
          let _ = modal.box(
            fn(hsep : view::View) -> Unit {
              let _ = hsep
              .width(view::Live::Is(Some(568.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // 2-column body grid
          let _ = modal.box(
            fn(grid : view::View) -> Unit {
              let _ = grid
              .row(view::Live::Is(true))
              .padding(view::Live::Is((16.0, 14.0, 16.0, 16.0)))
              .gap(view::Live::Is(12.0))

              // Left column: Navigation & Tabs + View & Zoom
              let _ = grid.box(
                fn(col_l : view::View) -> Unit {
                  let _ = col_l.width(view::Live::Is(Some(262.0))).rigid().gap(view::Live::Is(12.0))
                  render_sc_group(
                    col_l,
                    "NAVIGATION & TABS",
                    [
                      ("Focus Address Bar", mod_k("L")),
                      ("New Tab", mod_k("T")),
                      ("Close Tab", mod_k("W")),
                      ("Reopen Closed Tab", shift_mod_k("T")),
                      ("Toggle Sidebar", mod_k("S")),
                      ("Split View", shift_mod_k("\\")),
                      ("Peek Preview", shift_mod_k("P")),
                      ("Expand Peek", mod_k("O")),
                      ("Quick Tab Switch", if is_macos { "⌃⇥" } else { "Ctrl+Tab" }),
                      ("Switch Tab 1–9", mod_k("1–9")),
                      ("Back / Forward", mod_k("[") + " " + mod_k("]")),
                      ("Reload Page", mod_k("R")),
                    ],
                  )
                  render_sc_group(
                    col_l,
                    "VIEW & AUDIO",
                    [
                      ("Zoom In / Out", mod_k("+") + " " + mod_k("-")),
                      ("Reset Zoom", mod_k("0")),
                      ("Mute / Unmute Audio", mod_k("M")),
                      ("Save Page as PDF", mod_k("P")),
                    ],
                  )
                },
              )

              // Right column: Tools & Reading
              let _ = grid.box(
                fn(col_r : view::View) -> Unit {
                  let _ = col_r.width(view::Live::Is(Some(262.0))).rigid().gap(view::Live::Is(12.0))
                  render_sc_group(
                    col_r,
                    "TOOLS & READING",
                    [
                      ("Command Bar", mod_k("K")),
                      ("Find in Page", mod_k("F")),
                      ("Browsing History", mod_k("Y")),
                      ("Downloads Manager", mod_k("J")),
                      ("Bookmarks Drawer", shift_mod_k("B")),
                      ("Bookmark Page", mod_k("D")),
                      ("Reader Mode", alt_mod_k("R")),
                      ("Arc Boosts", shift_mod_k("E")),
                      ("Toggle DevTools", if is_macos { "⌥⌘I" } else { "Ctrl+Shift+I" }),
                      ("Copy Clean URL", shift_mod_k("C")),
                      ("Capture Screenshot", shift_mod_k("S")),
                      ("Site Info & Cookies", mod_k("I")),
                      ("Open Settings", mod_k(",")),
                      ("Shortcuts Guide", mod_k("/")),
                    ],
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
