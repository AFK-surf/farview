test "phase1a_r7: real ui::view_text(8) catcher focus-mismatch isolation & Reader immediate cache clear" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_sv = app_state.stage_view
  let prev_ssv = app_state.split_stage_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_rd_open = app_state.reader_open
  let prev_rd_sync = app_state.host_reader_synced
  let prev_rd_rev = app_state.reader_rev
  let prev_art = app_state.reader_article
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let main_stage = stage::Stage::new(fn(b : Bytes) -> Unit {
    enqueue_main_bytes(b)
  })
  let sec_stage = stage::Stage::new(fn(b : Bytes) -> Unit {
    enqueue_split_bytes(b)
  })
  app_state.stage = Some(main_stage)
  app_state.split_stage = Some(sec_stage)
  let _ = shell_page_open_split(1)

  let sb_btn_ref : Array[Option[view::View]] = [None]
  let sec_focus_ref : Array[Option[view::View]] = [None]
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let sb_btn = root.box(fn(v : view::View) -> Unit {
        let _ = v.focusable(view::Live::Is(true))
      })
      sb_btn_ref[0] = Some(sb_btn)
      let sv0 = root.box(fn(v : view::View) -> Unit {
        let _ = ui::field(
          v,
          main_stage.catcher,
          paste_limit=1,
          pasted=fn(s : String) -> Unit {
            if s != "" {
              enqueue_main_bytes(proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", s, 0)))
            }
          },
          edit=fn(e : ui::FieldEdit) -> Unit {
            if e.now != "" {
              enqueue_main_bytes(proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", e.now, 0)))
            }
          },
        )
      })
      app_state.stage_view = Some(sv0)
      let sv1 = root.box(fn(v : view::View) -> Unit {
        let sf = v.box(fn(f : view::View) -> Unit {
          let _ = f.focusable(view::Live::Is(true))
        })
        sec_focus_ref[0] = Some(sf)
      })
      app_state.split_stage_view = Some(sv1)
    },
    width=600.0,
    height=300.0,
  )
  ui::set_text_interceptor(Some(handle_ime_text))
  t.frame(ms=16.0)

  // 1a. Primary catcher focused -> move tree focus to sidebar button -> real ui::view_text(8, "secret")
  //     MUST let_go catcher & consume event so ui::view_text NEVER falls back to f.insert("secret") (0 bytes both sockets)!
  main_stage.catcher.focus()
  t.frame(ms=16.0)
  debug_assert(main_stage.catcher.focused(), "primary catcher focused")
  match sb_btn_ref[0] {
    Some(btn) => {
      let _ = btn.ask_focus()
    }
    None => debug_assert(false, "sidebar button mounted")
  }
  t.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == -1, "sidebar button owns focus (-1)")
  ui::view_text(8, "secret")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(!main_stage.catcher.focused(), "stale primary catcher released on paste while button focused")
  debug_assert(
    sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0,
    "real ui::view_text(8) leaked 0 bytes to both sockets when sidebar button focused",
  )

  // 1b. Primary catcher focused -> move tree focus to secondary Stage (pane == 1) -> real ui::view_text(8, "to-sec")
  //     MUST release primary catcher and route ONLY to split_conn (main_conn 0 bytes)!
  main_stage.catcher.focus()
  t.frame(ms=16.0)
  match sec_focus_ref[0] {
    Some(sf) => {
      let _ = sf.ask_focus()
    }
    None => debug_assert(false, "secondary stage focus node mounted")
  }
  t.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == 1, "secondary Stage owns focus (1)")
  ui::view_text(8, "to-sec")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let dm = dom_primary_mod()
  let k1 = proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", "to-sec", dm))
  let k2 = proto::encode_client(proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
  let got_s = sn_read_all_available(acc_s, k1.length() + k2.length())
  let got_m = sn_read_all_available(acc_m, 0)
  debug_assert(!main_stage.catcher.focused(), "stale primary catcher released when pasting to secondary pane")
  debug_assert(bytes_to_hex(got_s) == bytes_to_hex(k1) + bytes_to_hex(k2), "real ui::view_text(8) routed paste to split_conn")
  debug_assert(got_m.length() == 0, "main_conn received 0 bytes when pasting to secondary pane")

  // 2. [Astra #2] Reader immediate cache clear on open/close/re-extract:
  //    Display Article A -> open Reader B -> IMMEDIATELY title=="" && blocks==[] -> bare reply rejected -> B accepted!
  let rd_sig = signals::signal(false)
  let rd_sync = signals::signal(false)
  let rd_rev = signals::signal(0)
  app_state.reader_open = Some(rd_sig)
  app_state.host_reader_synced = Some(rd_sync)
  app_state.reader_rev = Some(rd_rev)
  let _ = shell_page_close_split()
  open_reader_mode()
  let rid_a = shell_adapter.reader_expected_req_id
  let art_a = proto::encode_reader_article_envelope(
    rid_a,
    "{\"url\":\"https://a.test\",\"host\":\"a.test\",\"title\":\"Article A\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":12,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Body A paragraph\"}]}",
  )
  set_host_reader_state_from_pane(0, art_a)
  debug_assert(
    rd_sync.untracked() && app_state.reader_article.title == "Article A" && app_state.reader_article.blocks.length() == 1,
    "Article A displayed with 1 block",
  )
  let rev_before = rd_rev.untracked()
  open_reader_mode()
  let rid_b = shell_adapter.reader_expected_req_id
  debug_assert(
    !rd_sync.untracked() &&
    app_state.reader_article.title == "" &&
    app_state.reader_article.blocks.length() == 0 &&
    rd_rev.untracked() > rev_before,
    "open_reader_mode immediately cleared Article A from UI cache",
  )
  // Bare unattributed article -> stays cleared!
  set_host_reader_state_from_pane(
    0,
    "{\"url\":\"https://a.test\",\"host\":\"a.test\",\"title\":\"Bare Leak\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":10,\"blocks\":[]}",
  )
  debug_assert(!rd_sync.untracked() && app_state.reader_article.title == "", "bare article rejected while waiting for B")
  // Matching req_id B -> accepted!
  let art_b = proto::encode_reader_article_envelope(
    rid_b,
    "{\"url\":\"https://b.test\",\"host\":\"b.test\",\"title\":\"Article B\",\"byline\":\"\",\"readMinutes\":2,\"wordCount\":40,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Body B paragraph\"}]}",
  )
  set_host_reader_state_from_pane(0, art_b)
  debug_assert(rd_sync.untracked() && app_state.reader_article.title == "Article B", "Article B accepted with matching req_id")

  ui::set_text_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage_view = prev_sv
  app_state.split_stage_view = prev_ssv
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.reader_open = prev_rd_open
  app_state.host_reader_synced = prev_rd_sync
  app_state.reader_rev = prev_rd_rev
  app_state.reader_article = prev_art
  shell_adapter_reset()
}

// ============================================================================
// Phase 1a Round 8 Final Closure Tests (Astra #1-#2)
