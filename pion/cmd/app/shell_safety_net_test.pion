// Phase 1a Round 2 Acceptance Tests (Opus P1-P7 + Astra #1-#5)
// ============================================================================

test "phase1a_r2: all 26 Exclusive tags paired, zero ghost Escape swallow, and SiteInfo->Cookies nested Escape" {
  shell_adapter_reset()
  let prev_hist = app_state.history_open
  let prev_find = app_state.find_open
  let prev_si = app_state.site_info_open
  let prev_ck = app_state.cookies_open
  let prev_stage = app_state.stage

  let hist_sig = signals::signal(false)
  let find_sig = signals::signal(false)
  let si_sig = signals::signal(false)
  let ck_sig = signals::signal(false)
  app_state.history_open = Some(hist_sig)
  app_state.find_open = Some(find_sig)
  app_state.site_info_open = Some(si_sig)
  app_state.cookies_open = Some(ck_sig)
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://site.example/", "Site", false, false, false)))
  app_state.stage = Some(st)

  // 1. Loop all 26 Exclusive overlay tags: mark open -> close_* -> adapter exclusive empty -> Escape returns false
  let tags = [
    "command_bar", "omnibox", "site_info", "cookies", "downloads", "history",
    "bookmarks", "boosts", "settings", "space_theme", "spaces_manager",
    "closed_tabs", "print_pdf", "tab_ctx", "zoom_popover", "folder_ctx",
    "shortcuts", "mru", "page_ctx", "nav_hist", "media_hub", "idn_popover",
    "bm_bar_ctx", "sessions", "folder_create", "tab_search",
  ]
  for tag in tags {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, tag)
    debug_assert(shell_adapter.exclusive.untracked().is_open(), "opened tag=" + tag)
    debug_assert(shell_close_overlay_by_tag(tag), "closed tag=" + tag)
    debug_assert(!shell_adapter.exclusive.untracked().is_open(), "exclusive empty after close tag=" + tag)
    debug_assert(!handle_app_key(proto::KEY_ESCAPE, 0, false), "no ghost Escape swallow after close tag=" + tag)
  }

  // 2. Open History -> close_history() -> open FindBar -> single Escape immediately closes FindBar
  open_history()
  debug_assert(hist_sig.untracked(), "History opened")
  close_history()
  debug_assert(!hist_sig.untracked() && !shell_adapter.exclusive.untracked().is_open(), "History closed cleanly")
  find_sig.set(true)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "single Escape closes FindBar")
  debug_assert(!find_sig.untracked(), "FindBar closed on first Escape with zero ghost swallow")

  // 3. Real parent->child nested path: SiteInfo -> open_cookies_modal() -> Escape 1 closes Cookies, Escape 2 closes SiteInfo
  toggle_site_info()
  debug_assert(si_sig.untracked(), "SiteInfo opened")
  open_cookies_modal()
  debug_assert(ck_sig.untracked() && si_sig.untracked(), "Cookies opened nested inside SiteInfo")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Escape 1 closes nested Cookies")
  debug_assert(!ck_sig.untracked() && si_sig.untracked(), "Cookies closed while SiteInfo stays open")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Escape 2 closes parent SiteInfo")
  debug_assert(!si_sig.untracked(), "SiteInfo closed on Escape 2")

  app_state.history_open = prev_hist
  app_state.find_open = prev_find
  app_state.site_info_open = prev_si
  app_state.cookies_open = prev_ck
  app_state.stage = prev_stage
  shell_adapter_reset()
}

test "phase1a_r2: single Escape on address bar restores safe URL, blurs field, and closes omnibox" {
  shell_adapter_reset()
  let prev_addr = app_state.address_field
  let prev_omni = app_state.omnibox_open
  let prev_stage = app_state.stage
  let prev_tf = app_state.tab_filter_open

  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://safe.example/page", "Safe", false, false, false)))
  app_state.stage = Some(st)

  let omni_sig = signals::signal(false)
  let tf_sig = signals::signal(true)
  app_state.omnibox_open = Some(omni_sig)
  app_state.tab_filter_open = Some(tf_sig)

  let addr = ui::Field::new()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = ui::field(root, addr, label="Address")
    },
    width=400.0,
    height=100.0,
  )
  app_state.address_field = Some(addr)
  addr.focus()
  t.frame(ms=16.0)
  addr.set("half")
  dispatch_omnibox_query("half")
  debug_assert(omni_sig.untracked() && addr.focused(), "omnibox open and address focused")
  // Phase 1a baseline parity: typing in omnibox does NOT close sidebar tab_filter
  debug_assert(tf_sig.untracked(), "typing in omnibox preserves sidebar tab_filter")

  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "single Escape consumed")
  t.frame(ms=16.0)
  debug_assert(!omni_sig.untracked(), "omnibox closed on single Escape")
  debug_assert(!addr.focused(), "address field blurred on single Escape")
  debug_assert(
    addr.text() == proto::omnibox_safe_display_url("https://safe.example/page"),
    "address bar restored to safe display URL, got=" + addr.text(),
  )

  ui::set_text_interceptor(None)
  t.dispose()
  app_state.address_field = prev_addr
  app_state.omnibox_open = prev_omni
  app_state.stage = prev_stage
  app_state.tab_filter_open = prev_tf
  shell_adapter_reset()
}

test "phase1a_r2: omnibox offline safety, broadcast isolation, privacy cache clear, and disconnect reset" {
  shell_adapter_reset()
  let prev_omni_open = app_state.omnibox_open
  let prev_omni_sync = app_state.host_omnibox_synced
  let prev_items = app_state.omnibox_items
  let old_main = io_rt.main_conn.detach()

  let omni_open_sig = signals::signal(false)
  let omni_sync_sig = signals::signal(false)
  app_state.omnibox_open = Some(omni_open_sig)
  app_state.host_omnibox_synced = Some(omni_sync_sig)
  app_state.omnibox_items = []

  // 1. Offline input "a" must NEVER stall in_flight; once connected, "ab" sends cleanly
  dispatch_omnibox_query("a")
  debug_assert(shell_adapter.omnibox_in_flight_req_id == "", "offline input leaves in_flight empty")

  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  dispatch_omnibox_query("ab")
  let _ = io_rt.main_conn.flush_write()
  let rid_ab = shell_adapter.omnibox_in_flight_req_id
  debug_assert(rid_ab != "", "connected 'ab' acquires req_id")
  let exp_ab = wire::encode(wire::Message::Act("omnibox", "ab", rid_ab))
  let got_ab = sn_read_all_available(acc, exp_ab.length())
  debug_assert(bytes_to_hex(got_ab) == bytes_to_hex(exp_ab), "connected 'ab' sent over wire after offline 'a'")

  // 2. New-host unattributed broadcast `[...]` while "ab" is in-flight MUST NOT consume rid_ab
  shell_adapter.omnibox_saw_envelope = true
  set_host_omnibox_results("[{\"url\":\"https://broadcast.test\",\"title\":\"BC\"}]")
  debug_assert(shell_adapter.omnibox_in_flight_req_id == rid_ab, "broadcast did not consume in_flight req_id")
  set_host_omnibox_results(proto::encode_omnibox_envelope(rid_ab, "[{\"url\":\"https://secret.test\",\"title\":\"Secret\"}]"))
  debug_assert(shell_adapter.omnibox_in_flight_req_id == "", "matching unicast reply cleared in_flight")
  debug_assert(app_state.omnibox_items.length() == 1 && app_state.omnibox_items[0].url == "https://secret.test", "unicast reply applied")

  // 3. Closed omnibox receives delete-history empty broadcast `[]` -> cache cleared immediately without reopening
  close_omnibox()
  debug_assert(!omni_open_sig.untracked(), "omnibox closed")
  set_host_omnibox_results("[]")
  debug_assert(!omni_open_sig.untracked(), "empty broadcast does not reopen closed omnibox")
  debug_assert(app_state.omnibox_items.length() == 0, "deleted privacy history immediately cleared from cache")

  // 4. Send "old", disconnect, reconnect, send "new": old epoch reply dropped, new accepted
  dispatch_omnibox_query("old")
  let rid_old = shell_adapter.omnibox_in_flight_req_id
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc, 0)
  shell_omnibox_on_disconnect()
  debug_assert(shell_adapter.omnibox_in_flight_req_id == "", "disconnect cleared in_flight")
  dispatch_omnibox_query("new")
  let rid_new = shell_adapter.omnibox_in_flight_req_id
  debug_assert(rid_new != "" && rid_new != rid_old, "post-reconnect query gets new epoch req_id")
  set_host_omnibox_results(proto::encode_omnibox_envelope(rid_old, "[{\"url\":\"https://old.invalid\",\"title\":\"Old\"}]"))
  debug_assert(app_state.omnibox_items.length() == 0, "old-epoch reply dropped")
  set_host_omnibox_results(proto::encode_omnibox_envelope(rid_new, "[{\"url\":\"https://new.test\",\"title\":\"New\"}]"))
  debug_assert(app_state.omnibox_items.length() == 1 && app_state.omnibox_items[0].url == "https://new.test", "new-epoch reply accepted")

  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.omnibox_open = prev_omni_open
  app_state.host_omnibox_synced = prev_omni_sync
  app_state.omnibox_items = prev_items
  shell_adapter_reset()
}

test "phase1a_r2: positive input ownership (DevTools Net search, Settings modal, IME unmark & Cmd shortcuts)" {
  shell_adapter_reset()
  let prev_dt_net = app_state.devtools_net_search_field
  let prev_settings = app_state.settings_open
  let prev_addr = app_state.address_field
  let prev_composing = app_state.ime_composing
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let set_sig = signals::signal(false)
  set_sidebar_open(true)
  app_state.settings_open = Some(set_sig)
  app_state.ime_composing = false

  // 1. DevTools Network search field focused: paste & IME send 0 bytes to main/split sockets
  let dt_net = ui::Field::new()
  let addr = ui::Field::new()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = ui::field(root, dt_net, label="Filter")
      let _ = ui::field(root, addr, label="Address")
    },
    width=400.0,
    height=100.0,
  )
  app_state.devtools_net_search_field = Some(dt_net)
  app_state.address_field = Some(addr)
  dt_net.focus()
  t.frame(ms=16.0)
  debug_assert(is_chrome_field_focused(), "devtools_net_search_field recognized by is_chrome_field_focused")
  debug_assert(handle_ime_text(8, "graphql", 0, 0), "paste routed to devtools_net_search_field")
  debug_assert(dt_net.text() == "graphql", "devtools_net_search_field received paste text")
  let _ = handle_ime_text(1, "nihao", 0, 0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "0 bytes leaked to main_conn from DevTools Net search")
  debug_assert(sn_read_all_available(acc_s, 0).length() == 0, "0 bytes leaked to split_conn from DevTools Net search")
  dt_net.let_go()
  t.frame(ms=16.0)

  // 2. Settings modal open with NO field focused: paste & IME must NEVER leak to underlying web Stage!
  set_sig.set(true)
  debug_assert(!handle_ime_text(8, "secret-clip", 0, 0), "paste blocked while Settings modal is open")
  let _ = handle_ime_text(1, "preedit", 0, 0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "0 bytes leaked to main_conn while Settings open")
  debug_assert(sn_read_all_available(acc_s, 0).length() == 0, "0 bytes leaked to split_conn while Settings open")
  set_sig.set(false)

  // 3. Page IME composing -> focus address bar -> kind == 2 clears page ime_composing;
  //    AND while ime_composing == true, Cmd/Ctrl+S global shortcut still works!
  let _ = handle_ime_text(1, "zhong", 0, 0)
  debug_assert(app_state.ime_composing, "page IME started")
  let primary_mod = if ui::keys_system() == 0 { proto::SHORTCUT_MOD_CMD } else { proto::SHORTCUT_MOD_CTRL }
  debug_assert(handle_app_key(1000 + 0x73, primary_mod, false), "Cmd/Ctrl+S NOT blocked by Layer 0 IME guard")
  debug_assert(!is_sidebar_open(), "Cmd/Ctrl+S toggled sidebar during IME composing")
  addr.focus()
  t.frame(ms=16.0)
  let _ = handle_ime_text(2, "", 0, 0)
  debug_assert(!app_state.ime_composing, "kind == 2 clears residual page ime_composing even while Chrome field focused")
  addr.let_go()
  ui::set_text_interceptor(None)
  t.dispose()

  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.devtools_net_search_field = prev_dt_net
  app_state.settings_open = prev_settings
  app_state.address_field = prev_addr
  app_state.ime_composing = prev_composing
  shell_adapter_reset()
}

test "phase1a_r2: secondary pane Reader routing, split rollback sync, and Dock/Passive sync" {
  shell_adapter_reset()
  let prev_bm_bar = app_state.bookmarks_bar_open
  let prev_dt = app_state.devtools_open
  let prev_toast = app_state.toast_visible
  let prev_toast_msg = app_state.toast_message
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let _ = shell_page_open_split(1)
  let bm_sig = signals::signal(false)
  let dt_sig = signals::signal(false)
  let tv_sig = signals::signal(false)
  let tm_sig = signals::signal("")
  app_state.bookmarks_bar_open = Some(bm_sig)
  app_state.devtools_open = Some(dt_sig)
  app_state.toast_visible = Some(tv_sig)
  app_state.toast_message = Some(tm_sig)

  // 1. Secondary pane reader_extract routes to split_conn with req_id (0 bytes to main_conn)
  dispatch_reader_extract()
  let _ = io_rt.split_conn.flush_write()
  let _ = io_rt.main_conn.flush_write()
  let exp_rd = wire::encode(wire::Message::Act("reader_extract", shell_adapter.reader_expected_req_id, ""))
  let got_s = sn_read_all_available(acc_s, exp_rd.length())
  let got_m = sn_read_all_available(acc_m, 0)
  debug_assert(bytes_to_hex(got_s) == bytes_to_hex(exp_rd), "secondary pane reader_extract landed on split_conn")
  debug_assert(got_m.length() == 0, "main_conn received 0 bytes for secondary pane reader_extract")

  // 2. Failed split spawn rollback syncs shell_adapter.page back to Single
  let _ = shell_page_open_split(1)
  debug_assert(shell_adapter.page.untracked().layout is shell_ui::PageLayout::Split, "page is Split before rollback")
  rollback_failed_split_spawn()
  debug_assert(shell_adapter.page.untracked().layout is shell_ui::PageLayout::Single, "rollback resets shell_adapter.page to Single")

  // 3. Split ratio, Bookmarks bar, DevTools, and Toast sync to shell_adapter
  shell_page_set_ratio(0.62)
  debug_assert((shell_adapter.page.untracked().split_ratio - 0.62).abs() < 0.001, "split_ratio synced")
  toggle_bookmarks_bar()
  debug_assert(shell_adapter.dock.untracked().bookmarks_open, "bookmarks_bar synced to dock")
  open_devtools()
  debug_assert(shell_adapter.dock.untracked().devtools_open, "devtools open synced to dock")
  close_devtools()
  debug_assert(!shell_adapter.dock.untracked().devtools_open, "devtools close synced to dock")
  show_toast("Synced Toast", "copy")
  debug_assert(shell_adapter.passive.untracked().toast_visible && shell_adapter.passive.untracked().toast_title == "Synced Toast", "toast synced to passive")

  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.bookmarks_bar_open = prev_bm_bar
  app_state.devtools_open = prev_dt
  app_state.toast_visible = prev_toast
  app_state.toast_message = prev_toast_msg
  shell_adapter_reset()
}

// ============================================================================
// Phase 1a Round 3 Final Closure Tests (Opus Q1-Q2 + Astra #1-#4)
// ============================================================================

test "phase1a_r3: tab_filter+Settings Escape order, SiteInfo->Cookies cascade close, and IDN non-nested" {
  shell_adapter_reset()
  let prev_tf = app_state.tab_filter_open
  let prev_set = app_state.settings_open
  let prev_si = app_state.site_info_open
  let prev_ck = app_state.cookies_open
  let prev_idn = app_state.idn_popover_open
  let prev_stage = app_state.stage

  let tf_sig = signals::signal(false)
  let set_sig = signals::signal(false)
  let si_sig = signals::signal(false)
  let ck_sig = signals::signal(false)
  let idn_sig = signals::signal(false)
  app_state.tab_filter_open = Some(tf_sig)
  app_state.settings_open = Some(set_sig)
  app_state.site_info_open = Some(si_sig)
  app_state.cookies_open = Some(ck_sig)
  app_state.idn_popover_open = Some(idn_sig)
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://r3.example/", "R3", false, false, false)))
  app_state.stage = Some(st)

  // 1. Open background tab_filter -> open foreground Settings -> Esc 1 closes Settings, Esc 2 closes tab_filter
  tf_sig.set(true)
  open_settings()
  debug_assert(tf_sig.untracked() && set_sig.untracked(), "both tab_filter and Settings open")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Esc 1 consumed")
  debug_assert(!set_sig.untracked() && tf_sig.untracked(), "Esc 1 closed foreground Settings while tab_filter stays open")
  debug_assert(!shell_adapter.exclusive.untracked().is_open(), "adapter exclusive empty after Settings closed")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Esc 2 consumed")
  debug_assert(!tf_sig.untracked(), "Esc 2 closed background tab_filter")

  // 2. SiteInfo -> nested Cookies -> close_site_info() cascades to close both and clear active/nested
  toggle_site_info()
  open_cookies_modal()
  debug_assert(si_sig.untracked() && ck_sig.untracked(), "SiteInfo + nested Cookies open")
  close_site_info()
  let exc = shell_adapter.exclusive.untracked()
  debug_assert(!si_sig.untracked() && !ck_sig.untracked(), "close_site_info closed both SiteInfo and nested Cookies")
  debug_assert(exc.active is shell_ui::ExclusiveKind::None && exc.nested is shell_ui::ExclusiveKind::None, "active & nested both None")

  // 3. IDN popover is sibling (non-nested): opening IDN while SiteInfo is open closes SiteInfo
  toggle_site_info()
  debug_assert(si_sig.untracked(), "SiteInfo re-opened")
  toggle_idn_popover()
  debug_assert(!si_sig.untracked() && idn_sig.untracked(), "IDN popover closed SiteInfo instead of nesting")
  close_idn_popover()

  app_state.tab_filter_open = prev_tf
  app_state.settings_open = prev_set
  app_state.site_info_open = prev_si
  app_state.cookies_open = prev_ck
  app_state.idn_popover_open = prev_idn
  app_state.stage = prev_stage
  shell_adapter_reset()
}

test "phase1a_r3: omnibox legacy array host, empty-query instant override, and rejected enqueue leaves no ghost in_flight" {
  shell_adapter_reset()
  let prev_omni_open = app_state.omnibox_open
  let prev_omni_sync = app_state.host_omnibox_synced
  let prev_items = app_state.omnibox_items
  let old_main = io_rt.main_conn.detach()

  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  let omni_open_sig = signals::signal(false)
  let omni_sync_sig = signals::signal(false)
  app_state.omnibox_open = Some(omni_open_sig)
  app_state.host_omnibox_synced = Some(omni_sync_sig)
  app_state.omnibox_items = []

  // 1. New host: empty query "" in-flight is IMMEDIATELY overridden by first non-empty keystroke "a"
  dispatch_omnibox_query("")
  let rid_empty = shell_adapter.omnibox_in_flight_req_id
  debug_assert(rid_empty != "" && shell_adapter.omnibox_in_flight_is_empty, "empty query in-flight")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc, 0)
  dispatch_omnibox_query("a")
  let rid_a = shell_adapter.omnibox_in_flight_req_id
  debug_assert(rid_a != "" && rid_a != rid_empty && !shell_adapter.omnibox_in_flight_is_empty, "'a' immediately overrode empty query")
  let _ = io_rt.main_conn.flush_write()
  let exp_a = wire::encode(wire::Message::Act("omnibox", "a", rid_a))
  let got_a = sn_read_all_available(acc, exp_a.length())
  debug_assert(bytes_to_hex(got_a) == bytes_to_hex(exp_a), "'a' dispatched immediately without waiting for empty query")

  // 2. Legacy array-only host: replies with bare array `[...]` -> clears remote cache (0 cross-viewer leak) and allows immediate next keystroke "ab"!
  set_host_omnibox_results("[{\"url\":\"https://legacy-a.test\",\"title\":\"Legacy A\"}]")
  debug_assert(app_state.omnibox_items.length() == 0, "bare array clears remote cache without cross-viewer pollution")
  dispatch_omnibox_query("ab")
  let rid_ab = shell_adapter.omnibox_in_flight_req_id
  debug_assert(rid_ab != "" && rid_ab != rid_a, "legacy host allows immediate next keystroke 'ab'")
  let _ = io_rt.main_conn.flush_write()
  let exp_ab = wire::encode(wire::Message::Act("omnibox", "ab", rid_ab))
  let got_ab = sn_read_all_available(acc, exp_ab.length())
  debug_assert(bytes_to_hex(got_ab) == bytes_to_hex(exp_ab), "'ab' dispatched cleanly against legacy host")

  // 3. Rejected enqueue (detached/not-connected) never commits ghost in_flight
  let detached_fd = io_rt.main_conn.detach()
  shell_omnibox_on_disconnect()
  dispatch_omnibox_query("offline-drop")
  debug_assert(shell_adapter.omnibox_in_flight_req_id == "", "rejected enqueue leaves in_flight empty")
  debug_assert(io_rt.main_conn.attach(detached_fd), "reattach main_conn")
  dispatch_omnibox_query("short")
  debug_assert(shell_adapter.omnibox_in_flight_req_id != "", "subsequent short query sends immediately")

  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.omnibox_open = prev_omni_open
  app_state.host_omnibox_synced = prev_omni_sync
  app_state.omnibox_items = prev_items
  shell_adapter_reset()
}

test "phase1a_r3: positive focus (sidebar button & catcher release on Settings) and per-pane IME disconnect isolation" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_sv = app_state.stage_view
  let prev_set = app_state.settings_open
  let prev_composing = app_state.ime_composing
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let set_sig = signals::signal(false)
  let _ = shell_page_open_split(1)
  app_state.settings_open = Some(set_sig)
  app_state.ime_composing = false

  // 1. Sidebar button focused -> paste sends 0 bytes to main/split sockets
  let sidebar_btn_ref : Array[Option[view::View]] = [None]
  let catcher = ui::Field::new()
  catcher.paste_limit = 1
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let sb_btn = root.box(fn(v : view::View) -> Unit {
        let _ = v.focusable(view::Live::Is(true))
      })
      sidebar_btn_ref[0] = Some(sb_btn)
      let sv = root.box(fn(v : view::View) -> Unit {
        let _ = ui::field(v, catcher, label="Catcher")
      })
      app_state.stage_view = Some(sv)
    },
    width=400.0,
    height=200.0,
  )
  t.frame(ms=16.0)
  match sidebar_btn_ref[0] {
    Some(btn) => {
      let _ = btn.ask_focus()
    }
    None => debug_assert(false, "sidebar button mounted")
  }
  t.frame(ms=16.0)
  debug_assert(!shell_is_page_focus_owner(), "sidebar button focused -> page is NOT focus owner")
  debug_assert(!handle_ime_text(8, "sidebar-paste", 0, 0), "paste blocked while sidebar button holds focus")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0, "0 bytes leaked when sidebar button focused")

  // 2. Focus webpage catcher -> open_settings() releases catcher -> paste leaks 0 bytes
  catcher.focus()
  t.frame(ms=16.0)
  debug_assert(catcher.focused(), "webpage catcher focused")
  open_settings()
  t.frame(ms=16.0)
  // Drain settings_sync wire frame sent by open_settings() before testing paste isolation
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  debug_assert(!catcher.focused(), "open_settings released webpage catcher focus")
  debug_assert(!handle_ime_text(8, "settings-paste", 0, 0), "paste blocked after opening Settings from catcher")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0, "0 bytes leaked after Settings opened from catcher")
  close_settings()
  ui::set_text_interceptor(None)
  t.dispose()
  app_state.root_view = None
  app_state.stage_view = None

  // 3. Secondary pane IME composing survives main_conn disconnect and commits to split_conn only
  let _ = handle_ime_text(1, "ni", 0, 0)
  debug_assert(app_state.ime_composing && shell_adapter.ime_owner_pane == 1, "secondary pane owns IME")
  // Simulate main disconnect (should NOT interrupt secondary pane composition!)
  if shell_adapter.ime_owner_pane == 0 {
    shell_end_page_ime_composition()
  }
  debug_assert(app_state.ime_composing && shell_adapter.ime_owner_pane == 1, "main disconnect did not interrupt secondary pane IME")
  // Switch active_pane to 0 before commit: commit MUST still route to original owner pane 1!
  shell_adapter.page.set(shell_ui::PageLayoutState::{ ..shell_adapter.page.untracked(), active_pane: shell_ui::PaneId::Primary })
  let _ = handle_ime_text(0, "你", 0, 0)
  let _ = io_rt.split_conn.flush_write()
  let _ = io_rt.main_conn.flush_write()
  let got_s = sn_read_all_available(acc_s, 10)
  let got_m = sn_read_all_available(acc_m, 0)
  debug_assert(got_s.length() > 0, "secondary pane IME commit landed on split_conn")
  debug_assert(got_m.length() == 0, "main_conn received 0 bytes from secondary pane IME")

  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage_view = prev_sv
  app_state.settings_open = prev_set
  app_state.ime_composing = prev_composing
  shell_adapter_reset()
}

test "phase1a_r3: Reader response source-pane validation drops stale cross-pane articles" {
  shell_adapter_reset()
  let prev_rd_open = app_state.reader_open
  let prev_rd_sync = app_state.host_reader_synced
  let prev_art = app_state.reader_article
  let old_split = io_rt.split_conn.detach()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let _ = shell_page_open_split(1)
  let rd_sig = signals::signal(false)
  let sync_sig = signals::signal(false)
  app_state.reader_open = Some(rd_sig)
  app_state.host_reader_synced = Some(sync_sig)

  open_reader_mode()
  debug_assert(shell_adapter.reader_owner_pane == 1, "Reader owned by secondary pane 1")

  let rid_sec = shell_adapter.reader_expected_req_id
  let sec_json = proto::encode_reader_article_envelope(
    rid_sec,
    "{\"title\":\"Secondary Article\",\"url\":\"https://sec.test\",\"paragraphs\":[\"Body\"]}",
  )
  let pri_json = proto::encode_reader_article_envelope(
    rid_sec,
    "{\"title\":\"Primary Stale Article\",\"url\":\"https://pri.test\",\"paragraphs\":[\"Stale\"]}",
  )

  // Case A: stale primary arrives first -> dropped; secondary arrives next -> accepted
  set_host_reader_state_from_pane(0, pri_json)
  debug_assert(!sync_sig.untracked(), "stale primary article dropped before secondary arrives")
  set_host_reader_state_from_pane(1, sec_json)
  debug_assert(sync_sig.untracked() && app_state.reader_article.title == "Secondary Article", "secondary article accepted")

  // Case B: stale primary arrives AFTER secondary -> dropped, does not overwrite Secondary Article!
  set_host_reader_state_from_pane(0, pri_json)
  debug_assert(app_state.reader_article.title == "Secondary Article", "late primary article cannot overwrite secondary article")

  let _ = io_rt.split_conn.detach()
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.reader_open = prev_rd_open
  app_state.host_reader_synced = prev_rd_sync
  app_state.reader_article = prev_art
  shell_adapter_reset()
}

// ============================================================================
// Phase 1a Round 4 Final Closure Tests (Opus R1-R2 + Astra #1-#4)
// ============================================================================

test "phase1a_r4: O(depth) parent walk on 5000-node Stage, IME preedit focus & stage click release, real disconnect_main_conn" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_sv = app_state.stage_view
  let prev_ssv = app_state.split_stage_view
  let prev_stage = app_state.stage
  let prev_composing = app_state.ime_composing
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_main = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  app_state.stage = Some(st_main)
  let _ = shell_page_open_split(1)
  app_state.ime_composing = false

  let btn_ref : Array[Option[view::View]] = [None]
  let sv_ref : Array[Option[view::View]] = [None]
  let leaf_ref : Array[Option[view::View]] = [None]
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let btn = root.box(fn(v : view::View) -> Unit {
        let _ = v.focusable(view::Live::Is(true))
      })
      btn_ref[0] = Some(btn)
      let sv = root.box(fn(v : view::View) -> Unit {
        // Populate 5,000 sibling nodes under stage_view to prove O(depth) upward parent walk!
        let mut k = 0
        while k < 5000 {
          let _ = v.box(fn(_c : view::View) -> Unit { () })
          k += 1
        }
        let leaf = v.box(fn(_c : view::View) -> Unit { () })
        leaf_ref[0] = Some(leaf)
      })
      sv_ref[0] = Some(sv)
      app_state.stage_view = Some(sv)
    },
    width=400.0,
    height=200.0,
  )
  t.frame(ms=16.0)

  // 1. O(depth) parent walk assertion on 5,000-node Stage
  match (sv_ref[0], leaf_ref[0], btn_ref[0]) {
    (Some(sv), Some(leaf), Some(btn)) => {
      let (in_sv, steps_in) = shell_view_contains_node_steps(sv, leaf.id())
      let (btn_in_sv, steps_out) = shell_view_contains_node_steps(sv, btn.id())
      debug_assert(in_sv && steps_in <= 4, "leaf inside 5000-node Stage found in O(depth) steps=" + steps_in.to_string())
      debug_assert(!btn_in_sv && steps_out <= 4, "sidebar button outside 5000-node Stage rejected in O(depth) steps=" + steps_out.to_string())

      // 2. Sidebar button focused -> BOTH IME preedit (kind==1) AND paste (kind==8) send 0 bytes!
      let _ = btn.ask_focus()
      t.frame(ms=16.0)
      debug_assert(!shell_is_page_focus_owner(), "sidebar button holds focus -> page is NOT focus owner")
      let _ = handle_ime_text(1, "ni", 0, 0)
      let _ = handle_ime_text(8, "clip", 0, 0)
      let _ = io_rt.main_conn.flush_write()
      let _ = io_rt.split_conn.flush_write()
      debug_assert(!app_state.ime_composing, "IME preedit rejected when sidebar button focused")
      debug_assert(sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0, "0 bytes on main/split while button focused")

      // 3. Clicking webpage releases button focus -> shell_is_page_focus_owner() becomes true!
      shell_release_chrome_focus_for_stage(sv)
      t.frame(ms=16.0)
      debug_assert(shell_is_page_focus_owner(), "clicking webpage releases chrome button focus")
    }
    _ => debug_assert(false, "tree views mounted")
  }

  // 4. Secondary pane IME composing survives REAL disconnect_main_conn() and decodes start/update/commit on split_conn!
  shell_adapter.last_page_focus_pane = 1
  let _ = handle_ime_text(1, "ni", 0, 0)
  debug_assert(app_state.ime_composing && shell_adapter.ime_owner_pane == 1, "secondary pane owns IME")
  disconnect_main_conn()
  debug_assert(app_state.ime_composing && shell_adapter.ime_owner_pane == 1, "real disconnect_main_conn() preserves secondary pane IME")
  let _ = handle_ime_text(0, "你", 0, 0)
  let _ = io_rt.split_conn.flush_write()
  let e1 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "", 0, 0, proto::EDIT_COMPOSING))
  let e2 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "ni", 1, 0, proto::EDIT_COMPOSING))
  let e3 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "你", 2, 0, proto::EDIT_COMPOSING))
  let got_s = sn_read_all_available(acc_s, e1.length() + e2.length() + e3.length())
  let got_m = sn_read_all_available(acc_m, 0)
  debug_assert(
    bytes_to_hex(got_s) == bytes_to_hex(e1) + bytes_to_hex(e2) + bytes_to_hex(e3),
    "split_conn decoded exact start/update/commit IME frames after real disconnect_main_conn()",
  )
  debug_assert(got_m.length() == 0, "main_conn received 0 bytes during secondary pane IME")

  ui::set_text_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage_view = prev_sv
  app_state.split_stage_view = prev_ssv
  app_state.stage = prev_stage
  app_state.ime_composing = prev_composing
  shell_adapter_reset()
}

test "phase1a_r4: toggle_site_info cascade close, bare-array closed-cache isolation, and same-pane Reader URL validation" {
  shell_adapter_reset()
  let prev_si = app_state.site_info_open
  let prev_ck = app_state.cookies_open
  let prev_omni_open = app_state.omnibox_open
  let prev_items = app_state.omnibox_items
  let prev_rd_open = app_state.reader_open
  let prev_rd_sync = app_state.host_reader_synced
  let prev_art = app_state.reader_article
  let prev_stage = app_state.stage

  let si_sig = signals::signal(false)
  let ck_sig = signals::signal(false)
  let omni_sig = signals::signal(false)
  let rd_sig = signals::signal(false)
  let sync_sig = signals::signal(false)
  app_state.site_info_open = Some(si_sig)
  app_state.cookies_open = Some(ck_sig)
  app_state.omnibox_open = Some(omni_sig)
  app_state.reader_open = Some(rd_sig)
  app_state.host_reader_synced = Some(sync_sig)
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://doc-a.test", "Doc A", false, false, false)))
  app_state.stage = Some(st)

  // 1. toggle_site_info() closing branch cascades to nested Cookies
  toggle_site_info()
  open_cookies_modal()
  debug_assert(si_sig.untracked() && ck_sig.untracked(), "SiteInfo + nested Cookies open")
  toggle_site_info()
  let exc = shell_adapter.exclusive.untracked()
  debug_assert(!si_sig.untracked() && !ck_sig.untracked(), "toggle_site_info closed both SiteInfo and nested Cookies")
  debug_assert(exc.active is shell_ui::ExclusiveKind::None && exc.nested is shell_ui::ExclusiveKind::None, "active & nested both None")

  // 2. Closed omnibox: non-empty bare array `[from_B]` clears cache to `[]` (no secret, no pollution, stays closed); empty `[]` also clears!
  app_state.omnibox_items = [
    proto::OmniboxItem::{ url: "https://mine.test", title: "Mine", visits: 2, score: 1.0, switch_to_tab: false },
  ]
  omni_sig.set(false)
  set_host_omnibox_results("[{\"url\":\"https://from-b.invalid\",\"title\":\"From B\"}]")
  debug_assert(
    app_state.omnibox_items.length() == 0 && !omni_sig.untracked(),
    "non-empty bare array clears closed cache with 0 pollution and never reopens",
  )
  set_host_omnibox_results("[]")
  debug_assert(app_state.omnibox_items.length() == 0, "empty array broadcast clears closed privacy cache")

  // 3. Same-pane Reader close A -> open B: stale A ReaderState dropped, B ReaderState accepted!
  open_reader_mode()
  debug_assert(shell_adapter.reader_expected_url == "https://doc-a.test", "expected URL is doc-a")
  close_reader_mode()
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://doc-b.test", "Doc B", false, false, false)))
  open_reader_mode()
  debug_assert(shell_adapter.reader_expected_url == "https://doc-b.test", "expected URL updated to doc-b")
  let rid_doc_b = shell_adapter.reader_expected_req_id
  set_host_reader_state_from_pane(0, "{\"title\":\"Doc A Stale\",\"url\":\"https://doc-a.test\",\"paragraphs\":[\"Old\"]}")
  debug_assert(!sync_sig.untracked() && app_state.reader_article.title != "Doc A Stale", "stale Doc A dropped on same pane")
  set_host_reader_state_from_pane(
    0,
    proto::encode_reader_article_envelope(
      rid_doc_b,
      "{\"title\":\"Doc B Fresh\",\"url\":\"https://doc-b.test\",\"paragraphs\":[\"New\"]}",
    ),
  )
  debug_assert(sync_sig.untracked() && app_state.reader_article.title == "Doc B Fresh", "fresh Doc B accepted")

  app_state.site_info_open = prev_si
  app_state.cookies_open = prev_ck
  app_state.omnibox_open = prev_omni_open
  app_state.omnibox_items = prev_items
  app_state.reader_open = prev_rd_open
  app_state.host_reader_synced = prev_rd_sync
  app_state.reader_article = prev_art
  app_state.stage = prev_stage
  shell_adapter_reset()
}

// ============================================================================
// Phase 1a Round 5 Final Closure Tests (Opus S1-S2 + Astra #1-#3)
// ============================================================================

test "phase1a_r5: real build_view & dual-pane move_to+press_at focus release and exact per-pane routing" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_sv = app_state.stage_view
  let prev_ssv = app_state.split_stage_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_composing = app_state.ime_composing
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  // 1. Single-pane real `build_view`: focus a real sidebar/toolbar button, then real `t.move_to` + `t.press_at` on Stage
  let st_real = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st_real.feed(proto::encode_host(proto::HostMsg::Meta("https://r5.test/", "R5", false, false, false)))
  app_state.stage = Some(st_real)
  let t1 = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t1.frame(ms=16.0)
  // Find a real focusable button outside stage_view (e.g. Toggle Sidebar / toolbar button)
  let mut focused_chrome_btn = false
  match (app_state.root_view, app_state.stage_view) {
    (Some(rv), Some(sv)) => {
      let mut i = 0
      while i < rv.tree.nodes.length() {
        let nid = view::NodeId::{ at: i }
        if !shell_view_contains_node(sv, nid) {
          if rv.tree.focus_to(Some(nid)) {
            focused_chrome_btn = true
            break
          }
        }
        i += 1
      }
      t1.frame(ms=16.0)
      debug_assert(focused_chrome_btn, "found and focused real chrome button in build_view")
      debug_assert(shell_page_focus_owner_pane() == -1, "real chrome button focused -> owner pane == -1")
      let (sx, sy, sw, sh) = sv.placed_window_now()
      debug_assert(sw > 100.0 && sh > 100.0, "real build_view stage_view has non-zero rect")
      let cx = sx + sw * 0.5
      let cy = sy + sh * 0.5
      t1.move_to(cx, cy)
      t1.press_at(cx, cy)
      t1.frame(ms=16.0)
      debug_assert(rv.tree.focused_now().0 is None, "real press_at on Stage released chrome button focus")
      debug_assert(shell_page_focus_owner_pane() == 0, "real press_at on single-pane Stage sets owner pane == 0")
    }
    _ => debug_assert(false, "build_view mounted root_view and stage_view")
  }
  t1.dispose()

  // 2. Dual-pane mounted Stage views + real loopback sockets
  shell_adapter_reset()
  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let _ = shell_page_open_split(1)
  app_state.ime_composing = false
  let st_main = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  app_state.stage = Some(st_main)

  let sb_btn_ref : Array[Option[view::View]] = [None]
  let main_focus_ref : Array[Option[view::View]] = [None]
  let sec_sv_ref : Array[Option[view::View]] = [None]
  let t2 = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let _ = root.row(view::Live::Is(true))
      let sb_btn = root.box(fn(v : view::View) -> Unit {
        let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(400.0))).focusable(view::Live::Is(true))
      })
      sb_btn_ref[0] = Some(sb_btn)
      let card0 = root.box(fn(c : view::View) -> Unit {
        let _ = c.width(view::Live::Is(Some(350.0))).height(view::Live::Is(Some(400.0)))
        let sv0 = c.box(fn(v : view::View) -> Unit {
          let _ = v.grow(view::Live::Is(1.0)).height(view::Live::Is(Some(400.0)))
          let mf = v.box(fn(f : view::View) -> Unit {
            let _ = f.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(30.0))).focusable(view::Live::Is(true))
          })
          main_focus_ref[0] = Some(mf)
        })
        app_state.stage_view = Some(sv0)
        shell_bind_stage_window_down(c, sv0, 0)
      })
      let _ = card0
      let card1 = root.box(fn(c : view::View) -> Unit {
        let _ = c.width(view::Live::Is(Some(350.0))).height(view::Live::Is(Some(400.0)))
        let sv1 = c.box(fn(v : view::View) -> Unit {
          let _ = v.grow(view::Live::Is(1.0)).height(view::Live::Is(Some(400.0)))
        })
        app_state.split_stage_view = Some(sv1)
        sec_sv_ref[0] = Some(sv1)
        shell_bind_stage_window_down(c, sv1, 1)
      })
      let _ = card1
    },
    width=800.0,
    height=400.0,
  )
  t2.frame(ms=16.0)

  // 2a. Keyboard focus inside primary Stage (even while split_active_pane == 1) -> IME routes to MAIN socket only!
  match main_focus_ref[0] {
    Some(mf) => {
      let _ = mf.ask_focus()
    }
    None => debug_assert(false, "main focus node mounted")
  }
  t2.frame(ms=16.0)
  debug_assert(active_split_pane() == 1, "active_split_pane is 1")
  debug_assert(shell_page_focus_owner_pane() == 0, "primary Stage tree focus pins owner pane == 0 despite active_split_pane == 1")
  let _ = handle_ime_text(1, "zhu", 0, 0)
  let _ = handle_ime_text(0, "主", 0, 0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let m1 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "", 0, 0, proto::EDIT_COMPOSING))
  let m2 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "zhu", 1, 0, proto::EDIT_COMPOSING))
  let m3 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "主", 2, 0, proto::EDIT_COMPOSING))
  let got_m_2a = sn_read_all_available(acc_m, m1.length() + m2.length() + m3.length())
  let got_s_2a = sn_read_all_available(acc_s, 0)
  debug_assert(
    bytes_to_hex(got_m_2a) == bytes_to_hex(m1) + bytes_to_hex(m2) + bytes_to_hex(m3) && got_s_2a.length() == 0,
    "primary Stage IME routed exact 3 frames to main_conn only (split 0 bytes)",
  )

  // 2b. Focus sidebar button -> owner == -1 -> IME & paste send 0 bytes to both sockets
  match sb_btn_ref[0] {
    Some(btn) => {
      let _ = btn.ask_focus()
    }
    None => debug_assert(false, "sidebar button mounted")
  }
  t2.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == -1, "sidebar button focused -> owner == -1")
  let _ = handle_ime_text(1, "no", 0, 0)
  let _ = handle_ime_text(8, "nope", 0, 0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(
    sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0,
    "sidebar button focused -> 0 bytes on both sockets",
  )

  // 2c. Real `t2.move_to` + `t2.press_at` on secondary Stage -> releases button focus, owner == 1,
  //     IME start/update -> real disconnect_main_conn() -> commit decodes exact 3 frames on split_conn!
  match sec_sv_ref[0] {
    Some(sv1) => {
      let (sx, sy, sw, sh) = sv1.placed_window_now()
      debug_assert(sw > 100.0 && sh > 100.0, "secondary stage_view has non-zero rect")
      t2.move_to(sx + sw * 0.5, sy + sh * 0.5)
      t2.press_at(sx + sw * 0.5, sy + sh * 0.5)
      t2.frame(ms=16.0)
    }
    None => debug_assert(false, "secondary stage_view mounted")
  }
  debug_assert(shell_page_focus_owner_pane() == 1, "real press_at on secondary Stage sets owner == 1")
  let _ = handle_ime_text(1, "fu", 0, 0)
  disconnect_main_conn()
  debug_assert(app_state.ime_composing && shell_adapter.ime_owner_pane == 1, "disconnect_main_conn keeps secondary IME alive")
  let _ = handle_ime_text(0, "副", 0, 0)
  let _ = io_rt.split_conn.flush_write()
  let e1 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "", 0, 0, proto::EDIT_COMPOSING))
  let e2 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "fu", 1, 0, proto::EDIT_COMPOSING))
  let e3 = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "副", 2, 0, proto::EDIT_COMPOSING))
  let got_s_2c = sn_read_all_available(acc_s, e1.length() + e2.length() + e3.length())
  let got_m_2c = sn_read_all_available(acc_m, 0)
  debug_assert(
    bytes_to_hex(got_s_2c) == bytes_to_hex(e1) + bytes_to_hex(e2) + bytes_to_hex(e3),
    "secondary Stage decoded exact start/update/commit after real disconnect_main_conn()",
  )
  debug_assert(got_m_2c.length() == 0, "main_conn received 0 bytes during secondary IME")

  t2.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage_view = prev_sv
  app_state.split_stage_view = prev_ssv
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.ime_composing = prev_composing
  shell_adapter_reset()
}

test "phase1a_r5: omnibox bare-array privacy clear, zero cross-viewer leak, and legacy-host pending flush" {
  shell_adapter_reset()
  let prev_omni_open = app_state.omnibox_open
  let prev_omni_sync = app_state.host_omnibox_synced
  let prev_items = app_state.omnibox_items
  let old_main = io_rt.main_conn.detach()

  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  let omni_sig = signals::signal(false)
  let sync_sig = signals::signal(false)
  app_state.omnibox_open = Some(omni_sig)
  app_state.host_omnibox_synced = Some(sync_sig)

  // 1. Cache [secret, keep]: closed & open-idle receiving non-empty [keep] broadcast clears cache to []!
  let seed_items = [
    proto::OmniboxItem::{ url: "https://secret.test", title: "Secret", visits: 5, score: 2.0, switch_to_tab: false },
    proto::OmniboxItem::{ url: "https://keep.test", title: "Keep", visits: 1, score: 1.0, switch_to_tab: false },
  ]
  app_state.omnibox_items = seed_items
  omni_sig.set(false)
  set_host_omnibox_results("[{\"url\":\"https://keep.test\",\"title\":\"Keep\"}]")
  debug_assert(app_state.omnibox_items.length() == 0 && !omni_sig.untracked(), "closed non-empty delete broadcast clears cache to [] and stays closed")

  app_state.omnibox_items = [
    proto::OmniboxItem::{ url: "https://secret.test", title: "Secret", visits: 5, score: 2.0, switch_to_tab: false },
    proto::OmniboxItem::{ url: "https://keep.test", title: "Keep", visits: 1, score: 1.0, switch_to_tab: false },
  ]
  omni_sig.set(true)
  set_host_omnibox_results("[{\"url\":\"https://keep.test\",\"title\":\"Keep\"}]")
  debug_assert(app_state.omnibox_items.length() == 0, "open-idle non-empty delete broadcast clears cache to []")

  // 2. Legacy host: viewer A editing receives viewer B's non-empty bare array -> A cache cleared to [] (0 leak)
  dispatch_omnibox_query("alpha")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc, 0)
  set_host_omnibox_results("[{\"url\":\"https://viewer-b.invalid\",\"title\":\"Viewer B\"}]")
  debug_assert(app_state.omnibox_items.length() == 0, "legacy host cross-viewer bare array clears A cache with 0 leak")

  // 3. Legacy host: viewer types A, then B (queued), stops typing -> legacy host replies [] for A -> B flushes immediately!
  shell_omnibox_on_disconnect()
  dispatch_omnibox_query("queryA")
  let rid_a = shell_adapter.omnibox_in_flight_req_id
  let _ = io_rt.main_conn.flush_write()
  let exp_a = wire::encode(wire::Message::Act("omnibox", "queryA", rid_a))
  let _ = sn_read_all_available(acc, exp_a.length())
  dispatch_omnibox_query("queryB")
  debug_assert(shell_adapter.omnibox_pending_query.unwrap_or("") == "queryB", "queryB queued while queryA in-flight")
  set_host_omnibox_results("[]")
  let rid_b = shell_adapter.omnibox_in_flight_req_id
  debug_assert(rid_b != "" && rid_b != rid_a, "legacy [] reply immediately flushed queued queryB")
  let _ = io_rt.main_conn.flush_write()
  let exp_b = wire::encode(wire::Message::Act("omnibox", "queryB", rid_b))
  let got_b = sn_read_all_available(acc, exp_b.length())
  debug_assert(bytes_to_hex(got_b) == bytes_to_hex(exp_b), "queued queryB wire bytes flushed automatically")

  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.omnibox_open = prev_omni_open
  app_state.host_omnibox_synced = prev_omni_sync
  app_state.omnibox_items = prev_items
  shell_adapter_reset()
}

test "phase1a_r5: Reader protocol req_id drops stale same-URL reload & late empty articles" {
  shell_adapter_reset()
  let prev_rd_open = app_state.reader_open
  let prev_rd_sync = app_state.host_reader_synced
  let prev_art = app_state.reader_article
  let prev_stage = app_state.stage

  let rd_sig = signals::signal(false)
  let sync_sig = signals::signal(false)
  app_state.reader_open = Some(rd_sig)
  app_state.host_reader_synced = Some(sync_sig)
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://same.test/article", "Same URL", false, false, false)))
  app_state.stage = Some(st)

  // Open A -> close A -> open B on the EXACT same URL
  open_reader_mode()
  let rid_a = shell_adapter.reader_expected_req_id
  debug_assert(rid_a != "", "Reader A assigned req_id")
  close_reader_mode()
  open_reader_mode()
  let rid_b = shell_adapter.reader_expected_req_id
  debug_assert(rid_b != "" && rid_b != rid_a, "Reader B assigned distinct req_id")
  debug_assert(!sync_sig.untracked(), "Reader B starts unsynced")

  // 1. Stale article A with old req_id on same URL -> dropped!
  let stale_a_env = proto::encode_reader_article_envelope(
    rid_a,
    "{\"url\":\"https://same.test/article\",\"host\":\"same.test\",\"title\":\"Old Body A\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":10,\"blocks\":[]}",
  )
  set_host_reader_state_from_pane(0, stale_a_env)
  debug_assert(!sync_sig.untracked() && app_state.reader_article.title != "Old Body A", "stale same-URL article A dropped by req_id")

  // 2. Late empty article (both with old req_id and bare legacy) -> dropped!
  let stale_empty_env = proto::encode_reader_article_envelope(
    rid_a,
    proto::encode_reader_article(proto::ReaderArticle::empty()),
  )
  set_host_reader_state_from_pane(0, stale_empty_env)
  debug_assert(!sync_sig.untracked(), "stale empty article envelope dropped")
  set_host_reader_state_from_pane(0, proto::encode_reader_article(proto::ReaderArticle::empty()))
  debug_assert(!sync_sig.untracked(), "bare legacy empty article never sets synced=true")

  // 3. Fresh article B with current req_id -> accepted!
  let fresh_b_env = proto::encode_reader_article_envelope(
    rid_b,
    "{\"url\":\"https://same.test/article\",\"host\":\"same.test\",\"title\":\"Fresh Body B\",\"byline\":\"\",\"readMinutes\":2,\"wordCount\":120,\"blocks\":[]}",
  )
  set_host_reader_state_from_pane(0, fresh_b_env)
  debug_assert(sync_sig.untracked() && app_state.reader_article.title == "Fresh Body B", "fresh article B accepted with matching req_id")

  app_state.reader_open = prev_rd_open
  app_state.host_reader_synced = prev_rd_sync
  app_state.reader_article = prev_art
  app_state.stage = prev_stage
  shell_adapter_reset()
}

