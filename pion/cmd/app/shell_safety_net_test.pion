test "phase1a_r7: real ui::view_text(8) catcher focus-mismatch isolation & Reader immediate cache clear" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_sv = app_state.stage_view
  let prev_ssv = app_state.split_stage_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_rd_open = app_state.reader_open
  let prev_rd_sync = app_state.host_reader_synced
  let prev_rd_rev = app_state.reader_rev
  let prev_art = app_state.reader_article
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let main_stage = stage::Stage::new(fn(b : Bytes) -> Unit {
    enqueue_main_bytes(b)
  })
  let sec_stage = stage::Stage::new(fn(b : Bytes) -> Unit {
    enqueue_split_bytes(b)
  })
  app_state.stage = Some(main_stage)
  app_state.split_stage = Some(sec_stage)
  let _ = shell_page_open_split(1)

  let sb_btn_ref : Array[Option[view::View]] = [None]
  let sec_focus_ref : Array[Option[view::View]] = [None]
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let sb_btn = root.box(fn(v : view::View) -> Unit {
        let _ = v.focusable(view::Live::Is(true))
      })
      sb_btn_ref[0] = Some(sb_btn)
      let sv0 = root.box(fn(v : view::View) -> Unit {
        let _ = ui::field(
          v,
          main_stage.catcher,
          paste_limit=1,
          pasted=fn(s : String) -> Unit {
            if s != "" {
              enqueue_main_bytes(proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", s, 0)))
            }
          },
          edit=fn(e : ui::FieldEdit) -> Unit {
            if e.now != "" {
              enqueue_main_bytes(proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", e.now, 0)))
            }
          },
        )
      })
      app_state.stage_view = Some(sv0)
      let sv1 = root.box(fn(v : view::View) -> Unit {
        let sf = v.box(fn(f : view::View) -> Unit {
          let _ = f.focusable(view::Live::Is(true))
        })
        sec_focus_ref[0] = Some(sf)
      })
      app_state.split_stage_view = Some(sv1)
    },
    width=600.0,
    height=300.0,
  )
  ui::set_text_interceptor(Some(handle_ime_text))
  t.frame(ms=16.0)

  // 1a. Primary catcher focused -> move tree focus to sidebar button -> real ui::view_text(8, "secret")
  //     MUST let_go catcher & consume event so ui::view_text NEVER falls back to f.insert("secret") (0 bytes both sockets)!
  main_stage.catcher.focus()
  t.frame(ms=16.0)
  debug_assert(main_stage.catcher.focused(), "primary catcher focused")
  match sb_btn_ref[0] {
    Some(btn) => {
      let _ = btn.ask_focus()
    }
    None => debug_assert(false, "sidebar button mounted")
  }
  t.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == -1, "sidebar button owns focus (-1)")
  ui::view_text(8, "secret")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(!main_stage.catcher.focused(), "stale primary catcher released on paste while button focused")
  debug_assert(
    sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0,
    "real ui::view_text(8) leaked 0 bytes to both sockets when sidebar button focused",
  )

  // 1b. Primary catcher focused -> move tree focus to secondary Stage (pane == 1) -> real ui::view_text(8, "to-sec")
  //     MUST release primary catcher and route ONLY to split_conn (main_conn 0 bytes)!
  main_stage.catcher.focus()
  t.frame(ms=16.0)
  match sec_focus_ref[0] {
    Some(sf) => {
      let _ = sf.ask_focus()
    }
    None => debug_assert(false, "secondary stage focus node mounted")
  }
  t.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == 1, "secondary Stage owns focus (1)")
  ui::view_text(8, "to-sec")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let dm = dom_primary_mod()
  let k1 = proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", "to-sec", dm))
  let k2 = proto::encode_client(proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
  let got_s = sn_read_all_available(acc_s, k1.length() + k2.length())
  let got_m = sn_read_all_available(acc_m, 0)
  debug_assert(!main_stage.catcher.focused(), "stale primary catcher released when pasting to secondary pane")
  debug_assert(bytes_to_hex(got_s) == bytes_to_hex(k1) + bytes_to_hex(k2), "real ui::view_text(8) routed paste to split_conn")
  debug_assert(got_m.length() == 0, "main_conn received 0 bytes when pasting to secondary pane")

  // 2. [Astra #2] Reader immediate cache clear on open/close/re-extract:
  //    Display Article A -> open Reader B -> IMMEDIATELY title=="" && blocks==[] -> bare reply rejected -> B accepted!
  let rd_sig = signals::signal(false)
  let rd_sync = signals::signal(false)
  let rd_rev = signals::signal(0)
  app_state.reader_open = Some(rd_sig)
  app_state.host_reader_synced = Some(rd_sync)
  app_state.reader_rev = Some(rd_rev)
  let _ = shell_page_close_split()
  open_reader_mode()
  let rid_a = shell_adapter.reader_expected_req_id
  let art_a = proto::encode_reader_article_envelope(
    rid_a,
    "{\"url\":\"https://a.test\",\"host\":\"a.test\",\"title\":\"Article A\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":12,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Body A paragraph\"}]}",
  )
  set_host_reader_state_from_pane(0, art_a)
  debug_assert(
    rd_sync.untracked() && app_state.reader_article.title == "Article A" && app_state.reader_article.blocks.length() == 1,
    "Article A displayed with 1 block",
  )
  let rev_before = rd_rev.untracked()
  open_reader_mode()
  let rid_b = shell_adapter.reader_expected_req_id
  debug_assert(
    !rd_sync.untracked() &&
    app_state.reader_article.title == "" &&
    app_state.reader_article.blocks.length() == 0 &&
    rd_rev.untracked() > rev_before,
    "open_reader_mode immediately cleared Article A from UI cache",
  )
  // Bare unattributed article -> stays cleared!
  set_host_reader_state_from_pane(
    0,
    "{\"url\":\"https://a.test\",\"host\":\"a.test\",\"title\":\"Bare Leak\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":10,\"blocks\":[]}",
  )
  debug_assert(!rd_sync.untracked() && app_state.reader_article.title == "", "bare article rejected while waiting for B")
  // Matching req_id B -> accepted!
  let art_b = proto::encode_reader_article_envelope(
    rid_b,
    "{\"url\":\"https://b.test\",\"host\":\"b.test\",\"title\":\"Article B\",\"byline\":\"\",\"readMinutes\":2,\"wordCount\":40,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Body B paragraph\"}]}",
  )
  set_host_reader_state_from_pane(0, art_b)
  debug_assert(rd_sync.untracked() && app_state.reader_article.title == "Article B", "Article B accepted with matching req_id")

  ui::set_text_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage_view = prev_sv
  app_state.split_stage_view = prev_ssv
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.reader_open = prev_rd_open
  app_state.host_reader_synced = prev_rd_sync
  app_state.reader_rev = prev_rd_rev
  app_state.reader_article = prev_art
  shell_adapter_reset()
}

// ============================================================================
// Phase 1a Round 8 Final Closure Tests (Astra #1-#2)
// ============================================================================

fn sn_tree_has_text(rv : view::View, needle : String) -> Bool {
  let mut i = 0
  while i < rv.tree.nodes.length() {
    let n = rv.tree.nodes[i]
    if n.live {
      if n.look.words.contains(needle) {
        return true
      }
      let mut j = 0
      while j < n.look.runs.length() {
        if n.look.runs[j].text.contains(needle) {
          return true
        }
        j += 1
      }
    }
    i += 1
  }
  false
}

test "phase1a_r8: webpage form field cross-pane/same-pane via ui::view_text(8) & real Reader view 3-state copy" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_sv = app_state.stage_view
  let prev_ssv = app_state.split_stage_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_rd_open = app_state.reader_open
  let prev_rd_sync = app_state.host_reader_synced
  let prev_rd_rev = app_state.reader_rev
  let prev_art = app_state.reader_article
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let main_stage = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let sec_stage = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  app_state.stage = Some(main_stage)
  app_state.split_stage = Some(sec_stage)
  let _ = shell_page_open_split(1)

  // 1. [Astra #1] Ordinary webpage `<input>` (`Editing.words`, paste_limit == 0) mounted in primary Stage
  let page_input = ui::Field::new()
  page_input.set("orig")
  let sec_focus_ref : Array[Option[view::View]] = [None]
  let t1 = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      app_state.root_view = Some(root)
      let sv0 = root.box(fn(v : view::View) -> Unit {
        let _ = ui::field(v, page_input, label="WebPageInput")
      })
      app_state.stage_view = Some(sv0)
      let sv1 = root.box(fn(v : view::View) -> Unit {
        let sf = v.box(fn(f : view::View) -> Unit {
          let _ = f.focusable(view::Live::Is(true))
        })
        sec_focus_ref[0] = Some(sf)
      })
      app_state.split_stage_view = Some(sv1)
    },
    width=600.0,
    height=300.0,
  )
  ui::set_text_interceptor(Some(handle_ime_text))
  t1.frame(ms=16.0)

  // 1a. Cross-pane: primary webpage `<input>` focused, tree focus in secondary Stage (pane == 1)
  //     -> real `ui::view_text(8, "cross-pane")` leaves primary input untouched, 0 bytes to main, sends to split!
  page_input.focus()
  t1.frame(ms=16.0)
  match sec_focus_ref[0] {
    Some(sf) => {
      let _ = sf.ask_focus()
    }
    None => debug_assert(false, "secondary focus node mounted")
  }
  t1.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == 1, "secondary Stage owns focus (1)")
  ui::view_text(8, "cross-pane")
  t1.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let dm = dom_primary_mod()
  let k1 = proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", "cross-pane", dm))
  let k2 = proto::encode_client(proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
  let got_s = sn_read_all_available(acc_s, k1.length() + k2.length())
  let got_m = sn_read_all_available(acc_m, 0)
  debug_assert(page_input.text() == "orig", "primary webpage form value untouched on cross-pane paste")
  debug_assert(got_m.length() == 0, "main_conn received 0 bytes on cross-pane form paste")
  debug_assert(bytes_to_hex(got_s) == bytes_to_hex(k1) + bytes_to_hex(k2), "split_conn received cross-pane paste")

  // 1b. Same-pane: primary webpage `<input>` focused & owner is primary Stage (pane == 0)
  //     -> real `ui::view_text(8, "same-pane")` inserts into primary webpage form normally!
  page_input.focus()
  t1.frame(ms=16.0)
  debug_assert(shell_page_focus_owner_pane() == 0, "primary webpage form owns focus (0)")
  ui::view_text(8, "same-pane")
  t1.frame(ms=16.0)
  debug_assert(page_input.text().contains("same-pane"), "same-pane paste inserted into primary webpage form")
  ui::set_text_interceptor(None)
  t1.dispose()

  // 2. [Astra #2] Real `build_view(root)` Reader view 3-state rendered copy verification
  shell_adapter_reset()
  let st_real = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  app_state.stage = Some(st_real)
  let t2 = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t2.frame(ms=16.0)
  let rv = match app_state.root_view {
    Some(v) => v
    None => {
      debug_assert(false, "build_view mounted root_view")
      panic()
    }
  }
  // Show Article A
  open_reader_mode()
  let rid_a = shell_adapter.reader_expected_req_id
  let art_a = proto::encode_reader_article_envelope(
    rid_a,
    "{\"url\":\"https://a.test\",\"host\":\"a.test\",\"title\":\"Article A\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":12,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Body A paragraph\"}]}",
  )
  set_host_reader_state_from_pane(0, art_a)
  t2.frame(ms=16.0)
  debug_assert(
    sn_tree_has_text(rv, "Article A") && sn_tree_has_text(rv, "Body A paragraph"),
    "Reader view rendered Article A title & body",
  )

  // Open Reader B -> IMMEDIATELY clears A and shows "Reading the article on this page."
  open_reader_mode()
  let rid_b = shell_adapter.reader_expected_req_id
  t2.frame(ms=16.0)
  debug_assert(
    !sn_tree_has_text(rv, "Article A") &&
    !sn_tree_has_text(rv, "Body A paragraph") &&
    sn_tree_has_text(rv, "Reading the article on this page."),
    "open_reader_mode immediately removed Article A and showed extracting state",
  )

  // Deliver bare unattributed response (no reqId) -> shows incompatible-host copy, still synced==false & no A
  set_host_reader_state_from_pane(
    0,
    "{\"url\":\"https://a.test\",\"host\":\"a.test\",\"title\":\"Bare Old\",\"byline\":\"\",\"readMinutes\":1,\"wordCount\":10,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Bare body\"}]}",
  )
  t2.frame(ms=16.0)
  debug_assert(
    !shell_sig_is_true(app_state.host_reader_synced) &&
    !sn_tree_has_text(rv, "Bare Old") &&
    sn_tree_has_text(rv, "This page did not answer with an article."),
    "bare unattributed response shows incompatible-host copy and keeps synced==false",
  )

  // Deliver matching req_id B -> renders Article B!
  let art_b = proto::encode_reader_article_envelope(
    rid_b,
    "{\"url\":\"https://b.test\",\"host\":\"b.test\",\"title\":\"Article B\",\"byline\":\"\",\"readMinutes\":2,\"wordCount\":40,\"blocks\":[{\"kind\":\"paragraph\",\"level\":0,\"text\":\"Body B paragraph\"}]}",
  )
  set_host_reader_state_from_pane(0, art_b)
  t2.frame(ms=16.0)
  debug_assert(
    shell_sig_is_true(app_state.host_reader_synced) &&
    sn_tree_has_text(rv, "Article B") &&
    sn_tree_has_text(rv, "Body B paragraph"),
    "matching req_id B rendered Article B",
  )

  // Open Reader C + deliver matching req_id EMPTY article -> shows "No article found on this page."
  open_reader_mode()
  let rid_c = shell_adapter.reader_expected_req_id
  set_host_reader_state_from_pane(
    0,
    proto::encode_reader_article_envelope(rid_c, proto::encode_reader_article(proto::ReaderArticle::empty())),
  )
  t2.frame(ms=16.0)
  debug_assert(
    shell_sig_is_true(app_state.host_reader_synced) &&
    sn_tree_has_text(rv, "No article found on this page."),
    "confirmed empty article with matching req_id shows empty-body copy",
  )

  close_reader_mode()
  ui::set_text_interceptor(None)
  t2.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage_view = prev_sv
  app_state.split_stage_view = prev_ssv
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.reader_open = prev_rd_open
  app_state.host_reader_synced = prev_rd_sync
  app_state.reader_rev = prev_rd_rev
  app_state.reader_article = prev_art
  shell_adapter_reset()
}

// ============================================================================
// Phase 1b Live Shell Swap Tests (Tier 1 Contracts 1-6 + Tier 2 Dual Stage)
// ============================================================================

fn sn_opt_view_id(v : Option[view::View]) -> Int {
  match v {
    Some(x) => x.id().at
    None => -1
  }
}

test "phase1b_t1_b1: 14 legacy overlays never mount shell_ui overlays, SiteInfo->Cookies->Esc, single CaptureSheet" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://b1.example/page", "B1 Page", false, false, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)
  let rv = match app_state.root_view { Some(v) => v
    None => panic("root_view") }

  // Open 14 legacy overlays one by one: 0 shell_ui built-in Dialog/Drawer/Menu may appear!
  let openers : Array[(String, () -> Unit)] = [
    ("settings", fn() { open_settings() }),
    ("history", fn() { open_history() }),
    ("bookmarks", fn() { open_bookmarks() }),
    ("downloads", fn() { toggle_downloads() }),
    ("cookies", fn() { open_cookies_modal() }),
    ("site_info", fn() { toggle_site_info() }),
    ("idn_popover", fn() { toggle_idn_popover() }),
    ("zoom_popover", fn() { toggle_zoom_popover() }),
    ("media_hub", fn() { toggle_media_hub() }),
    ("shortcuts", fn() { open_shortcuts() }),
    ("spaces_manager", fn() { open_spaces_manager() }),
    ("closed_tabs", fn() { open_closed_tabs_modal() }),
    ("print_pdf", fn() { open_print_pdf_modal() }),
    ("page_ctx", fn() {
      open_page_ctx(st, stage::MenuHit::{ x: 100.0, y: 100.0, link: "", can_back: false, can_forward: false })
    }),
  ]
  let mut idx = 0
  while idx < openers.length() {
    let (nm, opener) = openers[idx]
    close_exclusive_overlays()
    opener()
    t.frame(ms=16.0)
    debug_assert(!sn_tree_has_text(rv, "Export page as PDF"), nm + " must NOT mount shell_ui Export PDF dialog")
    debug_assert(!sn_tree_has_text(rv, "APPEARANCE"), nm + " must NOT mount shell_ui Page Controls drawer")
    idx += 1
  }
  close_exclusive_overlays()
  t.frame(ms=16.0)

  // SiteInfo -> Cookies (nested) -> Esc returns to SiteInfo
  toggle_site_info()
  t.frame(ms=16.0)
  open_cookies_modal()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.site_info_open) && shell_sig_is_true(app_state.cookies_open), "SiteInfo + nested Cookies open")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Esc closes nested Cookies")
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.cookies_open) && shell_sig_is_true(app_state.site_info_open), "SiteInfo remains open after nested Esc")
  close_site_info()

  // Single CaptureSheet renderer (render_passive_overlays=false in build_shell_frame)
  match app_state.capture_sheet_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_sync_passive_from_app()
  t.frame(ms=16.0)
  debug_assert(!sn_tree_has_text(rv, "Capture Completed"), "shell_ui duplicate CaptureSheet is NOT mounted")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  shell_adapter_reset()
}

test "phase1b_t1_b2_b3: zero Primary/Secondary Stage remounts across layout/resize/Split<->Peek/DevTools/theme & stale SplitSpawned rejected" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_split_pid = app_state.split_pid

  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://primary.test/", "Primary", false, false, false)))
  app_state.stage = Some(st)
  app_state.split_port = 1
  app_state.split_pid = 424242

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)

  let pri_id0 = sn_opt_view_id(app_state.stage_view)
  // Toggle sidebar, theme, DevTools, narrow breakpoints -> Primary Stage node ID never changes (0 remounts!)
  toggle_sidebar()
  t.frame(ms=16.0)
  debug_assert(sn_opt_view_id(app_state.stage_view) == pri_id0, "Primary Stage 0 remount on sidebar toggle")
  toggle_dark_chrome()
  t.frame(ms=16.0)
  debug_assert(sn_opt_view_id(app_state.stage_view) == pri_id0, "Primary Stage 0 remount on theme toggle")
  toggle_devtools()
  t.frame(ms=16.0)
  debug_assert(sn_opt_view_id(app_state.stage_view) == pri_id0, "Primary Stage 0 remount on DevTools open")
  toggle_devtools()
  t.frame(ms=16.0)
  debug_assert(sn_opt_view_id(app_state.stage_view) == pri_id0, "Primary Stage 0 remount on DevTools close")

  // Single -> Split -> Peek -> Split: Secondary Stage node ID, split_pid, and split_gen stay strictly invariant!
  open_split_view("https://sec-a.test/", "", focus_pane=1, quiet=true)
  t.frame(ms=16.0)
  debug_assert(sn_opt_view_id(app_state.stage_view) == pri_id0, "Primary Stage 0 remount on Single -> Split")
  let sec_id0 = sn_opt_view_id(app_state.split_stage_view)
  let gen_before = io_rt.split_gen
  let pid_before = app_state.split_pid

  // Split -> Peek direct handoff (0 remount, PID & gen unchanged!)
  open_peek_preview("https://sec-a.test/", "", quiet=true)
  t.frame(ms=16.0)
  debug_assert(is_peek_open() && !is_split_open(), "layout switched to Peek")
  debug_assert(sn_opt_view_id(app_state.stage_view) == pri_id0, "Primary Stage 0 remount on Split -> Peek")
  debug_assert(sn_opt_view_id(app_state.split_stage_view) == sec_id0, "Secondary Stage 0 remount on Split -> Peek")
  debug_assert(io_rt.split_gen == gen_before && app_state.split_pid == pid_before, "PID and split_gen unchanged on Split -> Peek")

  // Peek -> Split direct promotion (0 remount, PID & gen unchanged!)
  promote_peek_to_split()
  t.frame(ms=16.0)
  debug_assert(is_split_open() && !is_peek_open(), "promoted back to Split")
  debug_assert(sn_opt_view_id(app_state.split_stage_view) == sec_id0, "Secondary Stage 0 remount on Peek -> Split")
  debug_assert(io_rt.split_gen == gen_before && app_state.split_pid == pid_before, "PID and split_gen unchanged on Peek -> Split")

  // Esc closes Peek cleanly -> Single, and late SplitSpawned with stale gen never reopens Secondary!
  open_peek_preview("https://sec-a.test/", "", quiet=true)
  t.frame(ms=16.0)
  let stale_gen = io_rt.split_gen
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Esc closes Peek")
  t.frame(ms=16.0)
  debug_assert(!is_peek_open() && !is_split_open(), "layout returned to Single after Esc")
  debug_assert(io_rt.split_gen > stale_gen, "closing to Single increments split_gen")
  on_split_spawned(stale_gen, 29999, 987654)
  debug_assert(!is_peek_open() && !is_split_open(), "stale SplitSpawned never reopens closed secondary pane")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.split_pid = prev_split_pid
  shell_adapter_reset()
}

test "phase1b_t1_astra3_4_5: Esc returns focus to real Stage, occlusion blocks Cmd+A/C/paste, Swap+Solo keeps active pane, and apple_ui audit" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.opened()
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://main.test/doc", "Main Doc", false, false, false)))
  app_state.stage = Some(st)
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)

  // 1. [Astra #3] Focus Address Bar -> type -> Esc -> WITHOUT clicking webpage, paste lands on main_conn!
  let addr = match app_state.address_field { Some(f) => f
    None => panic("address_field") }
  match app_state.omnibox_editing {
    Some(ed) => ed.set(true)
    None => ()
  }
  addr.focus()
  addr.set("draft-query")
  t.frame(ms=16.0)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Esc dismisses omnibox")
  t.frame(ms=16.0)
  debug_assert(!addr.focused() && addr.text() == "https://main.test/doc", "Esc blurred address bar and restored safe URL")
  debug_assert(shell_page_focus_owner_pane() == 0, "Esc returned focus ownership directly to Primary Stage without clicking")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  debug_assert(handle_ime_text(8, "after-esc", 0, 0), "immediate paste after Esc reaches Primary Stage")
  let _ = io_rt.main_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 10).length() > 0, "paste bytes arrived on main_conn immediately after Esc")

  // 2. [B5 + Astra #4] Reader occlusion blocks Cmd+A / Cmd+C / paste from leaking to occluded Stage!
  open_reader_mode()
  t.frame(ms=16.0)
  debug_assert(shell_is_pane_occluded(0), "Primary pane marked occluded while Reader is open")
  debug_assert(shell_page_focus_owner_pane() == -1, "occluded pane returns focus owner -1")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let primary_mod = if ui::keys_system() == 0 { proto::SHORTCUT_MOD_CMD } else { proto::SHORTCUT_MOD_CTRL }
  debug_assert(handle_app_key(ui::key_of_char('a'), primary_mod, false), "Cmd+A swallowed when Reader occludes Stage")
  debug_assert(handle_app_key(ui::key_of_char('c'), primary_mod, false), "Cmd+C swallowed when Reader occludes Stage")
  debug_assert(!handle_ime_text(8, "blocked-paste", 0, 0), "paste blocked when Reader occludes Stage")
  let _ = io_rt.main_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "0 bytes leaked to occluded Primary Stage")
  close_reader_mode()
  t.frame(ms=16.0)

  // 3. [B4 + Astra #4 & #5] Split + Swap + Secondary active -> Find targets Secondary; Solo preserves Secondary URL!
  open_split_view("https://secondary.test/guide", "", focus_pane=1, quiet=true)
  let sp_st = ensure_split_stage()
  sp_st.feed(proto::encode_host(proto::HostMsg::Meta("https://secondary.test/guide", "Sec Guide", false, false, false)))
  t.frame(ms=16.0)
  swap_split_panes()
  t.frame(ms=16.0)
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 1, "Find bar owned by active Secondary pane after Swap")
  close_find_bar(active_find_stage())
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  expand_split_pane(active_split_pane())
  t.frame(ms=16.0)
  debug_assert(!is_split_open(), "Solo returned to Single layout")
  let _ = io_rt.main_conn.flush_write()
  let expected_solo_nav = bytes_to_hex(proto::encode_client(proto::ClientMsg::Nav(proto::NAV_GO, "https://secondary.test/guide")))
  let solo_hex = sn_read_until_hex(acc_m, expected_solo_nav)
  debug_assert(
    solo_hex.contains(expected_solo_nav),
    "Solo after Swap navigated Primary Stage to active Secondary URL https://secondary.test/guide",
  )

  // 4. [Tier 1 Apple UI Audit] Verify 0 nested glass, 0 scroll faults, 0 craft violations on live build_view!
  lg::assert_apple_ui(t, label="cmd_app_live_shell")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  shell_adapter_reset()
}

fn sn_encode_reset_rich_doc(
  base : String,
  font_family : String,
  font_url : String,
  img_url : String,
  heading : String,
  input_val : String,
) -> Bytes {
  let body : Array[Byte] = []
  sn_w_varint(body, 101) // HostMsg::Reset
  sn_w_varint(body, 1) // seq
  sn_w_varint(body, 0) // ack
  sn_w_str(body, base)
  // Document(1) -> html(2) -> body(3) with 22 children: h1, img, input, textarea, + 18 tall <p>
  sn_w_elem_header(body, 1, 0, "", 1)
  sn_w_elem_header(body, 2, 3, "html", 1)
  sn_w_elem_header(body, 3, 3, "body", 22)
  // 1. h1(4) -> Text(5)
  sn_w_elem_header(body, 4, 3, "h1", 1)
  sn_w_varint(body, 5)
  sn_w_varint(body, 4)
  sn_w_str(body, heading)
  // 2. img(6) with src_url + natural (16, 16)
  sn_w_varint(body, 6)
  sn_w_varint(body, 3)
  sn_w_varint(body, 0)
  sn_w_str(body, "")
  sn_w_str(body, "")
  sn_w_str(body, "img")
  sn_w_varint(body, 0)
  sn_w_str(body, "")
  body.push(0.to_byte()) // value = None
  sn_w_varint(body, 0) // checked = None
  body.push(1.to_byte()) // src_url = Some
  sn_w_str(body, img_url)
  body.push(0.to_byte()) // natural = None
  body.push(0.to_byte()) // quirks
  body.push(0.to_byte()) // public_id
  body.push(0.to_byte()) // system_id
  body.push(0.to_byte()) // defined
  sn_w_varint(body, 0) // states
  body.push(0.to_byte()) // shadow
  sn_w_varint(body, 0) // children
  // 3. input(7) with value = Some(input_val)
  sn_w_varint(body, 7)
  sn_w_varint(body, 3)
  sn_w_varint(body, 0)
  sn_w_str(body, "")
  sn_w_str(body, "")
  sn_w_str(body, "input")
  sn_w_varint(body, 0)
  sn_w_str(body, "")
  body.push(1.to_byte()) // value = Some
  sn_w_str(body, input_val)
  sn_w_varint(body, 0)
  body.push(0.to_byte())
  body.push(0.to_byte())
  body.push(0.to_byte())
  body.push(0.to_byte())
  body.push(0.to_byte())
  body.push(0.to_byte())
  sn_w_varint(body, 0)
  body.push(0.to_byte())
  sn_w_varint(body, 0)
  // 4. textarea(8)
  sn_w_elem_header(body, 8, 3, "textarea", 0)
  // 5..22: 18 tall paragraphs for real vertical scrolling
  let mut pi = 0
  while pi < 18 {
    let pid = 10 + pi * 2
    sn_w_elem_header(body, pid, 3, "p", 1)
    sn_w_varint(body, pid + 1)
    sn_w_varint(body, 4)
    sn_w_str(body, heading + " paragraph " + pi.to_string() + " scrollable body copy for Tier 2 verification.")
    pi += 1
  }
  // stylesheet with @font-face + tall paragraphs
  sn_w_varint(body, 1)
  sn_w_str(body, base + "/style.css")
  sn_w_str(
    body,
    "@font-face { font-family: '" + font_family + "'; src: url('" + font_url + "'); } body, h1, p { font-family: '" + font_family + "'; font-size: 20px; } p { height: 96px; margin: 16px 0; } img { width: 32px; height: 32px; }",
  )
  sn_w_varint(body, 0)
  sn_w_varint(body, 0)
  sn_w_str(body, "")
  let n = body.length()
  let framed = Bytes::new(4 + n)
  sn_put_be(framed, 0, 4, n)
  let mut i = 0
  while i < n {
    framed[4 + i] = body[i]
    i += 1
  }
  framed
}

fn sn_minimal_png_1x1() -> Bytes {
  // Valid 1x1 red RGBA PNG (69 bytes)
  let raw : Array[Int] = [
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,
    0x00, 0x00, 0x00, 0x0D, 0x49, 0x48, 0x44, 0x52,
    0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
    0x08, 0x06, 0x00, 0x00, 0x00, 0x1F, 0x15, 0xC4,
    0x89, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x44, 0x41,
    0x54, 0x78, 0x9C, 0x63, 0xF8, 0xCF, 0xC0, 0xF0,
    0x1F, 0x00, 0x05, 0x00, 0x01, 0xFF, 0x89, 0x99,
    0x3D, 0x1D, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45,
    0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
  ]
  let b = Bytes::new(raw.length())
  let mut i = 0
  while i < raw.length() {
    b[i] = raw[i].to_byte()
    i += 1
  }
  b
}

test "phase1b_t2: dual real Stage in Split & Peek with distinct HTML/fonts/images/forms/scroll, click focus, paste & IME routing" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let font_a = sn_build_probe_sfnt(600, "Tier2FontAlpha")
  let font_b = sn_build_probe_sfnt(720, "Tier2FontBetaWide")
  let png_a = sn_minimal_png_1x1()
  let url_fa = "https://alpha.local/font-a.ttf"
  let url_fb = "https://beta.local/font-b.ttf"
  let url_ia = "https://alpha.local/hero.png"
  let url_ib = "https://beta.local/diagram.png"
  let reset_a = sn_encode_reset_rich_doc("https://alpha.local", "Tier2FontAlpha", url_fa, url_ia, "Alpha Heading", "alpha-init")
  let reset_b = sn_encode_reset_rich_doc("https://beta.local", "Tier2FontBetaWide", url_fb, url_ib, "Beta A Heading", "beta-init")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st_a.add_font(font_a)
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  let cur_h = hostapi::host()
  let prev_face_add = cur_h.face_add_bytes
  let uploaded_slots : Array[(Int, Int)] = []
  cur_h.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    uploaded_slots.push((slot, data.length()))
    true
  }
  t.frame(ms=16.0)
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/doc", "Alpha Local Doc", false, false, false)))
    st_a.feed(proto::encode_host(proto::HostMsg::Asset(url_fa, 1, 0.0, 0.0, font_a)))
    st_a.feed(proto::encode_host(proto::HostMsg::Asset(url_ia, 0, 1.0, 1.0, png_a)))
    st_a.feed(reset_a)
  })
  t.frame(ms=16.0)

  open_split_view("https://beta.local/spec", "", focus_pane=1, quiet=true)
  let st_b = ensure_split_stage()
  st_b.add_font(font_b)
  t.frame(ms=16.0)
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.local/spec", "Beta Spec Doc", false, false, false)))
    st_b.feed(proto::encode_host(proto::HostMsg::Asset(url_fb, 1, 0.0, 0.0, font_b)))
    st_b.feed(proto::encode_host(proto::HostMsg::Asset(url_ib, 0, 1.0, 1.0, png_a)))
    st_b.feed(reset_b)
  })
  let mut fi = 0
  while fi < 12 {
    t.frame(ms=30.0)
    fi += 1
  }

  // Verify independent font slots & raster image caches across both real Stages
  let mut slot_a = -1
  let mut slot_b = -1
  for pair in uploaded_slots {
    let (sl, ln) = pair
    if ln == font_a.length() { slot_a = sl }
    if ln == font_b.length() { slot_b = sl }
  }
  debug_assert(proto::decode_host(reset_a.slice(4, reset_a.length())).is_some(), "reset_a decodes cleanly")
  debug_assert(proto::decode_host(reset_b.slice(4, reset_b.length())).is_some(), "reset_b decodes cleanly")
  debug_assert(
    slot_a >= 4 && slot_b >= 4 && slot_a != slot_b,
    "Tier 2 dual Stages allocated distinct font slots: slot_a=" + slot_a.to_string() +
    " slot_b=" + slot_b.to_string() + " uploads=" + uploaded_slots.length().to_string() +
    " la=" + st_a.layout_count().to_string() + " lb=" + st_b.layout_count().to_string() +
    " sfnt_b=" + stage::inspect_webfont_sfnt(font_b).is_ok().to_string(),
  )
  debug_assert(st_a.picture_cache_entries() > 0 && st_b.picture_cache_entries() > 0, "Tier 2 dual Stages cached raster images")

  // Click Primary <input> before scrolling away -> select all + paste -> verify real field value!
  let sv0 = match app_state.stage_view { Some(v) => v
    None => panic("stage_view") }
  let sv1 = match app_state.split_stage_view { Some(v) => v
    None => panic("split_stage_view") }
  let (x0, y0, w0, h0) = sv0.placed_window_now()
  let (x1, y1, w1, h1) = sv1.placed_window_now()
  debug_assert(w0 > 200.0 && h0 > 200.0 && w1 > 200.0 && h1 > 200.0, "both Split Stages have valid non-zero geometry")
  debug_assert(x0 + w0 <= x1 + 1.0, "Split panes do not overlap horizontally")

  let mut primary_input_field : Option[ui::Field] = None
  match t.find("alpha-init") {
    Some((ix, iy)) => {
      t.click(ix, iy)
      t.frame(ms=16.0)
      match ui::focused_field_now() {
        Some(f_a) => {
          f_a.pick(0, f_a.text().length())
          debug_assert(f_a.copy_selection() == "alpha-init", "Primary <input> selected 'alpha-init'")
          ui::view_text(8, "alpha-pasted")
          t.frame(ms=16.0)
          debug_assert(f_a.text() == "alpha-pasted", "Primary <input> received pasted text 'alpha-pasted'")
          primary_input_field = Some(f_a)
        }
        None => debug_assert(false, "clicking Primary <input> focused its Field")
      }
    }
    None => debug_assert(false, "Primary <input> 'alpha-init' visible before scroll")
  }
  // Click Secondary <input> ('beta-init') -> select + CJK IME commit -> verify exact replacement & Primary untouched!
  match t.find("beta-init") {
    Some((bx, by)) => {
      t.click(bx, by)
      t.frame(ms=16.0)
      match ui::focused_field_now() {
        Some(f_b) => {
          f_b.pick(0, f_b.text().length())
          debug_assert(f_b.copy_selection() == "beta-init", "Secondary <input> selected 'beta-init'")
          ui::view_text(1, "be")
          ui::view_text(0, "贝")
          t.frame(ms=16.0)
          debug_assert(f_b.text() == "贝", "Secondary <input> replaced selection with exact CJK IME commit '贝', got: " + f_b.text())
          debug_assert(f_b.copy_selection() == "", "Secondary <input> selection collapsed after CJK IME commit")
          match primary_input_field {
            Some(f_a) => debug_assert(f_a.text() == "alpha-pasted", "Primary <input> remained 'alpha-pasted' during Secondary IME commit")
            None => debug_assert(false, "primary_input_field captured")
          }
          f_b.let_go()
        }
        None => debug_assert(false, "clicking Secondary <input> focused its Field")
      }
    }
    None => debug_assert(false, "Secondary <input> 'beta-init' visible before scroll")
  }

  // Verify independent scrolling in both Stages
  st_a.scroll_page_down()
  t.frame(ms=16.0)
  debug_assert(st_a.scroll_y() > 0.0 && st_b.scroll_y() == 0.0, "Primary Stage scrolled independently of Secondary")
  st_b.scroll_page_down()
  t.frame(ms=16.0)
  debug_assert(st_b.scroll_y() > 0.0, "Secondary Stage scrolled independently")

  // Both Stages mounted with distinct URLs, titles, and non-overlapping Split rects
  debug_assert(st_a.url() == "https://alpha.local/doc" && st_b.url() == "https://beta.local/spec", "distinct dual Stage URLs")

  // Click Primary -> paste routes ONLY to main_conn with exact payload
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  t.move_to(x0 + w0 * 0.5, y0 + h0 * 0.5)
  t.press_at(x0 + w0 * 0.5, y0 + h0 * 0.5)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  debug_assert(shell_page_focus_owner_pane() == 0, "clicking Primary Stage sets owner pane 0")
  debug_assert(handle_ime_text(8, "alpha-paste", 0, 0), "paste routed to Primary")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let dm = dom_primary_mod()
  let exp_alpha = proto::encode_client(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", "alpha-paste", dm))
  let got_m_paste = sn_read_all_available(acc_m, exp_alpha.length())
  debug_assert(bytes_to_hex(got_m_paste).contains(bytes_to_hex(exp_alpha)) && sn_read_all_available(acc_s, 0).length() == 0, "Primary paste exact payload isolated to main_conn")

  // Click Secondary -> CJK IME routes ONLY to split_conn with exact committed text
  t.move_to(x1 + w1 * 0.5, y1 + h1 * 0.5)
  t.press_at(x1 + w1 * 0.5, y1 + h1 * 0.5)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  debug_assert(shell_page_focus_owner_pane() == 1, "clicking Secondary Stage sets owner pane 1")
  let _ = handle_ime_text(1, "be", 0, 0)
  let _ = handle_ime_text(0, "贝", 0, 0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_beta_ime_start = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "", 0, 0, proto::EDIT_COMPOSING))
  let exp_beta_ime_upd = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "be", 1, 0, proto::EDIT_COMPOSING))
  let exp_beta_ime = proto::encode_client(proto::ClientMsg::EditInput(0, 0, "贝", 2, 0, proto::EDIT_COMPOSING))
  let got_s_ime = sn_read_all_available(acc_s, exp_beta_ime_start.length() + exp_beta_ime_upd.length() + exp_beta_ime.length())
  debug_assert(bytes_to_hex(got_s_ime).contains(bytes_to_hex(exp_beta_ime)) && sn_read_all_available(acc_m, 0).length() == 0, "Secondary IME exact payload isolated to split_conn")

  // Switch Split -> Peek -> verify Secondary Stage stays alive (0 remount, scroll preserved)
  let sec_id_split = sv1.id().at
  let sec_scroll_before_peek = st_b.scroll_y()
  open_peek_preview("https://beta.local/spec", "", quiet=true)
  t.frame(ms=16.0)
  debug_assert(sn_opt_view_id(app_state.split_stage_view) == sec_id_split, "Tier 2 Split -> Peek preserved Secondary Stage node")
  debug_assert(st_b.scroll_y() > 0.0, "Tier 2 Split -> Peek preserved non-zero Secondary scroll position")

  cur_h.face_add_bytes = prev_face_add
  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  shell_adapter_reset()
}

test "phase1b_r2_a: normal-mode Omnibox Tab/Shift+Tab/single-click, Find pane ownership, and Peek->Split peek_close" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_demo_omni = app_state.demo_omnibox
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  app_state.demo_omnibox = ""
  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.test/home", "Alpha Home", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)

  // 1. [Astra #1] Normal mode: Cmd+L -> type -> Tab to Clear -> Shift+Tab -> continue typing (editing never drops)
  st_a.opened()
  let cmd_mod = if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }
  t.key(ui::key_of_char('l'), mods=cmd_mod)
  t.frame(ms=16.0)
  let addr = match app_state.address_field { Some(f) => f
    None => panic("address_field") }
  let omni_ed = match app_state.omnibox_editing { Some(s) => s
    None => panic("omnibox_editing") }
  addr.set("farview")
  t.frame(ms=16.0)
  debug_assert(omni_ed.untracked(), "omnibox_editing true after Cmd+L + type")
  t.key(ui::key_tab)
  t.frame(ms=16.0)
  debug_assert(omni_ed.untracked(), "Tab to Clear button keeps omnibox_editing open in normal mode")
  t.key(ui::key_tab, mods=ui::mod_shift_key)
  t.frame(ms=16.0)
  debug_assert(omni_ed.untracked() && addr.focused(), "Shift+Tab naturally returned focus to address field without dropping edit mode")
  addr.pick(addr.text().length(), addr.text().length())
  t.type_text(" docs")
  t.frame(ms=16.0)
  debug_assert(omni_ed.untracked() && addr.text() == "farview docs", "natural typing after Shift+Tab inserted ' docs'")

  // Seed a unique suggestion and click it -> exactly ONE Nav("https://unique.test/spec") on main_conn
  app_state.omni_suggest_items = [
    proto::OmniSuggestItem::{
      category: proto::OmniSuggestCategory::History,
      title: "Unique Spec Result",
      url: "https://unique.test/spec",
      subtitle: "unique.test",
      badge_label: "History",
      section_title: "History",
      tab_id: "",
      visits: 5,
      score: 100.0,
    },
  ]
  match app_state.omnibox_open { Some(s) => s.set(true)
    None => () }
  match app_state.omnibox_rev { Some(r) => r.set(r.untracked() + 1)
    None => () }
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  match t.find("Unique Spec Result") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Unique Spec Result row visible in omnibox popup")
  }
  let _ = io_rt.main_conn.flush_write()
  let exp_nav = bytes_to_hex(proto::encode_client(proto::ClientMsg::Nav(proto::NAV_GO, "https://unique.test/spec")))
  let nav_hex = sn_read_until_hex(acc_m, exp_nav)
  let mut nav_hits = 0
  let mut scan = 0
  while scan + exp_nav.length() <= nav_hex.length() {
    if nav_hex.slice(scan, scan + exp_nav.length()) == exp_nav {
      nav_hits += 1
      scan += exp_nav.length()
    } else {
      scan += 2
    }
  }
  debug_assert(nav_hits == 1, "clicking suggestion submitted navigation ONCE (got " + nav_hits.to_string() + ")")

  // 2. [Astra #2] Find pane ownership end-to-end (B opens Find -> click A -> Swap -> next/prev/Esc all go to B; A's stale FindResult ignored)
  open_split_view("https://beta.test/page", "", focus_pane=1, quiet=true)
  let st_b = ensure_split_stage()
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.test/page", "Beta Page", false, false, false)))
  t.frame(ms=16.0)
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 1, "Find owned by Secondary pane B")
  // Switch active pane back to Primary A, then Swap panes
  set_active_split_pane(0)
  swap_split_panes()
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  dispatch_find_query(active_find_stage(), "needle")
  dispatch_find_next(active_find_stage())
  dispatch_find_prev(active_find_stage())
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let m_find_out = sn_read_all_available(acc_m, 0)
  let s_find_out = sn_read_all_available(acc_s, 10)
  debug_assert(m_find_out.length() == 0, "0 Find commands leaked to Primary main_conn when B owns Find")
  let exp_find_flags = proto::find_flags_for(is_find_case_sensitive(), false)
  debug_assert(
    bytes_to_hex(s_find_out).contains(bytes_to_hex(wire::encode(wire::Message::Act("find", "needle", exp_find_flags)))),
    "find query sent to Secondary split_conn",
  )
  debug_assert(
    bytes_to_hex(s_find_out).contains(bytes_to_hex(wire::encode(wire::Message::Act("find_next", "", "")))),
    "find_next sent to Secondary split_conn",
  )
  debug_assert(
    bytes_to_hex(s_find_out).contains(bytes_to_hex(wire::encode(wire::Message::Act("find_prev", "", "")))),
    "find_prev sent to Secondary split_conn",
  )
  // Inbound FindResult filtering: pane 1 updates count; stale pane 0 result is dropped!
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::FindResult(2, 5))], st_b, 1000.0, fn() { 0.0 })
  let _ = dispatch_incoming_chunks_budgeted_at([wire::encode(wire::Message::FindResult(1, 99))], st_a, 1000.0, fn() { 0.0 })
  match (app_state.host_find_active, app_state.host_find_total) {
    (Some(fa), Some(ft)) => debug_assert(fa.untracked() == 2 && ft.untracked() == 5, "pane B FindResult(2,5) preserved; stale pane A FindResult(1,99) dropped")
    _ => debug_assert(false, "find result signals exist")
  }
  // Esc closes Find and sends find_clear ONLY to Secondary split_conn
  let _ = handle_app_key(proto::KEY_ESCAPE, 0, false)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "Esc find_clear did not leak to main_conn")
  debug_assert(
    sn_read_until_hex(acc_s, bytes_to_hex(wire::encode(wire::Message::Act("find_clear", "", "")))).contains(bytes_to_hex(wire::encode(wire::Message::Act("find_clear", "", "")))),
    "Esc sent find_clear to Secondary split_conn",
  )

  // 3. [Astra #3] Both Peek -> Split promotion entries send `peek_close` to main host while keeping split_conn alive
  let exp_peek_close = bytes_to_hex(wire::encode(wire::Message::Act("peek_close", "", "")))
  // Path A: promote_peek_to_split()
  open_peek_preview("https://beta.test/page", "t2", quiet=true)
  t.frame(ms=16.0)
  debug_assert(io_rt.peek_open_sent, "peek_open_sent true while Peek open")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let sec_id_before = sn_opt_view_id(app_state.split_stage_view)
  promote_peek_to_split()
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let pc_a = sn_read_all_available(acc_m, 10)
  debug_assert(!io_rt.peek_open_sent && io_rt.split_conn.is_open(), "promote_peek_to_split cleared peek_open_sent and kept split_conn")
  debug_assert(sn_opt_view_id(app_state.split_stage_view) == sec_id_before, "promote_peek_to_split 0 remount")
  debug_assert(bytes_to_hex(pc_a).contains(exp_peek_close), "promote_peek_to_split sent peek_close to main host")

  // Path B: open_split_view() from open Peek
  open_peek_preview("https://beta.test/page", "t2", quiet=true)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  open_split_view("https://beta.test/page", "t2", focus_pane=1, quiet=true)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let pc_b = sn_read_all_available(acc_m, 10)
  debug_assert(!io_rt.peek_open_sent && io_rt.split_conn.is_open(), "open_split_view from Peek cleared peek_open_sent and kept split_conn")
  debug_assert(bytes_to_hex(pc_b).contains(exp_peek_close), "open_split_view from Peek sent peek_close to main host")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.demo_omnibox = prev_demo_omni
  shell_adapter_reset()
}

test "phase1b_r2_b: Print/PDF, inline folder creator, nav history & fav ctx menu, case-insensitive filter, per-tab Mini Player mute, bookmark/boosts" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_ws = app_state.workspace
  let prev_mh = app_state.media_hub_snap
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")

  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    spaces: [proto::SpaceSummary::{ id: "sp1", name: "Work", accent: "#3B82F6", theme: proto::space_theme_unset(), active: true, tab_count: 3 }],
    folders: [
      proto::FolderSummary::{ id: "f-specs", space_id: "sp1", name: "Specs", color: "#3B82F6", collapsed: false },
      proto::FolderSummary::{ id: "f-arch", space_id: "sp1", name: "Archive", color: "#64748B", collapsed: false },
    ],
    tabs: [
      proto::TabSummary::{
        id: "t1",
        space_id: "sp1",
        title: "Farview Favorite",
        url: "https://farview.dev/fav",
        pinned: true,
        favorite: true,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 105L,
      },
      proto::TabSummary::{
        id: "t1-spec",
        space_id: "sp1",
        title: "Farview Architecture Notes",
        url: "https://farview.dev/arch",
        pinned: true,
        favorite: false,
        active: true,
        state: "active",
        folder_id: "f-specs",
        last_active_secs: 100L,
      },
      proto::TabSummary::{
        id: "t2",
        space_id: "sp1",
        title: "Quarterly Budget",
        url: "https://finance.local/q4",
        pinned: false,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "f-arch",
        last_active_secs: 90L,
      },
      proto::TabSummary::{
        id: "tab-bg-audio",
        space_id: "sp1",
        title: "Ambient Focus Stream",
        url: "https://audio.local/stream",
        pinned: false,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 80L,
      },
    ],
    nav_back: [proto::NavHistoryEntry::{ index: 0, title: "Previous Doc", url: "https://farview.dev/prev" }],
    media: Some(
      proto::MediaMiniState::{
        tab_id: "tab-bg-audio",
        title: "Ambient Focus Stream",
        host: "audio.local",
        playing: true,
        muted: false,
        is_meeting: false,
        accent: "#22C55E",
      },
    ),
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{
    sessions: [
      proto::MediaSessionItem::{
        tab_id: "tab-bg-audio",
        title: "Ambient Focus Stream",
        artist_or_host: "audio.local",
        url: "https://audio.local/stream",
        playing: true,
        muted: false,
        is_live_call: false,
        duration_secs: 180,
        position_secs: 30,
      },
    ],
  }

  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://farview.dev/arch", "Farview Architecture Notes", false, true, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)

  // 1. [Item 4a] Real Print/PDF modal opens & closes cleanly
  open_print_pdf_modal()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.print_pdf_open), "open_print_pdf_modal opens production print modal")
  debug_assert(shell_adapter.exclusive.untracked().tag == "print_pdf", "print_pdf exclusive tag set")
  close_print_pdf_modal()
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.print_pdf_open), "close_print_pdf_modal closes cleanly")

  // 2. [Item 4b] Inline folder creator mounted in live sidebar: open -> visible -> submit -> Esc closes
  open_folder_create_bar()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.folder_create_open), "folder_create_open true")
  debug_assert(t.find("Create").is_some(), "inline folder creator rendered in live sidebar")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  match app_state.folder_create_field {
    Some(ff) => {
      ff.set("Design Docs")
      t.enter()
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "folder_create_field exists")
  }
  let _ = io_rt.main_conn.flush_write()
  let fc_out = sn_read_all_available(acc_m, 10)
  debug_assert(fc_out.length() > 0, "submitting inline folder creator dispatched wire command")
  open_folder_create_bar()
  t.frame(ms=16.0)
  let _ = handle_app_key(proto::KEY_ESCAPE, 0, false)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.folder_create_open), "Esc closed inline folder creator")

  // 3. [Item 5a] Back button right-click opens nav history menu
  match t.get("Back") {
    Some(bd) => {
      t.right_click(bd.x + bd.w * 0.5, bd.y + bd.h * 0.5)
      t.frame(ms=16.0)
      debug_assert(shell_sig_is_true(app_state.nav_hist_open), "right-clicking Back opened nav history popover")
      close_nav_hist()
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Back button present in titleband")
  }

  // 4. [Item 5b] Favorites card right-click opens tab context menu
  match t.get("Farview Favorite") {
    Some(fd) => {
      t.right_click(fd.x + fd.w * 0.5, fd.y + fd.h * 0.5)
      t.frame(ms=16.0)
      debug_assert(shell_sig_is_true(app_state.tab_ctx_open), "right-clicking Favorite card opened tab context menu")
      close_tab_ctx()
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Favorite card present in sidebar")
  }

  // 5. [Item 5c] Case-insensitive Tab & Folder filter (`farview` matches `Farview Architecture Notes` & `Specs`, hides `Quarterly Budget` & `Archive`)
  match app_state.tab_filter_query {
    Some(q) => q.set("farview")
    None => debug_assert(false, "tab_filter_query exists")
  }
  t.frame(ms=16.0)
  debug_assert(t.find("Specs").is_some(), "matching folder Specs visible under filter 'farview'")
  debug_assert(t.find("Archive").is_none(), "non-matching folder Archive hidden under filter 'farview'")
  debug_assert(t.find("Quarterly Budget").is_none(), "non-matching tab Quarterly Budget hidden under filter 'farview'")
  match app_state.tab_filter_query {
    Some(q) => q.set("")
    None => ()
  }
  t.frame(ms=16.0)

  // 6. [Item 5d] Mini Player mute button targets background card `tab-bg-audio`
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  match t.get("Mute Media") {
    Some(md) => {
      t.click(md.x + md.w * 0.5, md.y + md.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Mini Player Mute Media button present")
  }
  let _ = io_rt.main_conn.flush_write()
  let exp_mute = bytes_to_hex(wire::encode(wire::Message::Act("media_mute_toggle", "tab-bg-audio", "")))
  let mute_hex = sn_read_until_hex(acc_m, exp_mute)
  debug_assert(
    mute_hex.contains(exp_mute),
    "Mini Player mute targeted background tab_id 'tab-bg-audio'",
  )

  // 7. [HIT-01] The capsule keeps one wide address target (Arc): Bookmark and Boosts are not in its resting row
  // (Bookmark Page is in the More menu and Cmd+D, Boosts and Zoom in Site Controls), and every capsule control
  // meets 32pt with the app's hooks on.
  debug_assert(t.get("Bookmark Page").is_none(), "no Bookmark button in the resting capsule")
  debug_assert(t.get("Site Boosts").is_none(), "no Site Boosts button in the resting capsule")
  match (t.get("Address Bar"), t.get("Address Bar Host")) {
    (Some(ab), Some(cap)) => debug_assert(ab.w >= cap.w * 0.6 - 0.5, "address field >= 60% of the capsule with app hooks: \{ab.w} of \{cap.w}")
    _ => debug_assert(false, "Address Bar and its capsule present")
  }
  for lbl in ["Site Controls", "More Actions"] {
    match t.get(lbl) {
      Some(b) => debug_assert(b.w >= 31.5 && b.h >= 31.5, "capsule control meets 32pt: " + lbl)
      None => debug_assert(false, "capsule control present: " + lbl)
    }
  }
  // Hovered too (anyone about to click the address is over the capsule): nothing covers its trailing end, and a
  // press at 95% of the Address Bar's width lands on it.
  match t.get("Address Bar") {
    Some(ab) => {
      let hx = ab.x + ab.w * 0.95
      let hy = ab.y + ab.h / 2.0
      t.move_to(ab.x + ab.w / 2.0, hy)
      t.frame(ms=200.0)
      debug_assert(t.get("Page Controls").is_none(), "no Page Controls over the hovered capsule")
      match t.get("Address Bar") {
        Some(ab2) => debug_assert((ab2.w - ab.w).abs() < 0.5, "hover does not change the Address Bar")
        None => ()
      }
      t.move_to(hx, hy)
      t.frame(ms=16.0)
      t.click(hx, hy)
      t.frame(ms=16.0)
      debug_assert(shell_sig_is_true(app_state.omnibox_editing), "a press at 95% of the hovered Address Bar opens the palette")
      shell_dismiss_omnibox_and_restore_address()
      t.frame(ms=16.0)
    }
    None => ()
  }

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.workspace = prev_ws
  app_state.media_hub_snap = prev_mh
  shell_adapter_reset()
}

test "phase1b_r3_astra_four_fixes: Print/PDF pane binding, Find close/migration, 480pt narrow folder creator, and split nav_hist/nav_jump" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  app_state.workspace = proto::WorkspaceSnapshot::empty()
  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st_a.opened()
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.test/report", "Primary Alpha Report", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)

  // Open Split on Secondary B with distinct title + can_back = true
  open_split_view("https://beta.test/spec", "", focus_pane=1, quiet=true)
  let st_b = ensure_split_stage()
  st_b.opened()
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.test/spec", "Secondary Beta Spec", false, true, false)))
  t.frame(ms=16.0)

  // 1. [Astra #1] Print/PDF from Secondary B via More Menu -> Save as PDF targets ONLY split_conn; Cancel sends 0
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  match t.get("More Actions") {
    Some(bm) => {
      t.click(bm.x + bm.w * 0.5, bm.y + bm.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "More Actions button present")
  }
  match t.find("Print / PDF Settings…") {
    Some((px, py)) => {
      t.click(px, py)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Print / PDF Settings… present in Browser Menu")
  }
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([]))
  debug_assert(app_state.print_owner_pane == 1, "Print modal bound to Secondary pane B")
  debug_assert(t.find("Secondary Beta Spec").is_some(), "Print modal preview shows Secondary Beta Spec title")
  match t.get("Save as PDF") {
    Some(sp) => {
      t.click(sp.x + sp.w * 0.5, sp.y + sp.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF button present in Print modal")
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let m_pdf = sn_read_all_available(acc_m, 0)
  let exp_pdf = bytes_to_hex("export_pdf".to_bytes())
  let s_pdf_hex = sn_read_until_hex(acc_s, exp_pdf)
  debug_assert(m_pdf.length() == 0, "Primary main_conn received 0 bytes on Secondary B export_pdf")
  debug_assert(s_pdf_hex.contains(exp_pdf), "Secondary split_conn received export_pdf")

  // Reopen Print modal on B and click Cancel -> 0 bytes on both connections
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.get("Cancel Export PDF") {
    Some(cb) => {
      t.click(cb.x + cb.w * 0.5, cb.y + cb.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Cancel Export PDF button present in Print modal")
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0, "Cancel exported 0 bytes on both connections")

  // 2. [Astra #4] Back right-click history on Secondary B (while Primary A has empty nav_back) -> nav_jump goes ONLY to B
  let split_ws = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    nav_back: [proto::NavHistoryEntry::{ index: 2, title: "Beta Prev Page", url: "https://beta.test/prev" }],
  }
  let _ = dispatch_split_incoming_chunks_budgeted_at(
    [wire::encode(wire::Message::WorkspaceState(proto::encode_workspace_snapshot(split_ws)))],
    st_b,
    1000.0,
    fn() { 0.0 },
  )
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  match t.get("Back") {
    Some(bd) => {
      t.right_click(bd.x + bd.w * 0.5, bd.y + bd.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Back button present")
  }
  debug_assert(shell_sig_is_true(app_state.nav_hist_open) && app_state.nav_hist_owner_pane == 1, "Back right-click opened nav history for Secondary B even when A has no history")
  match t.find("Beta Prev Page") {
    Some((nx, ny)) => {
      t.click(nx, ny)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Beta Prev Page visible in Secondary B nav history menu")
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_jump = bytes_to_hex(wire::encode(wire::Message::Act("nav_jump", "2", "")))
  let m_jump_hex = bytes_to_hex(sn_read_all_available(acc_m, 0))
  debug_assert(!m_jump_hex.contains(bytes_to_hex("nav_jump".to_bytes())), "Primary main_conn received 0 nav_jump commands on Secondary B nav_jump")
  debug_assert(sn_read_until_hex(acc_s, exp_jump).contains(exp_jump), "Secondary split_conn received nav_jump(2)")

  // 3. [Astra #2] B opens Find -> switch to A + Cmd+F migrates Find to A and sends find_clear to B; then B Find -> Solo A -> Esc sends 0 find_clear to A
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 1, "Find opened on Secondary B")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  set_active_split_pane(0)
  open_find_bar()
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let exp_fc = bytes_to_hex(wire::encode(wire::Message::Act("find_clear", "", "")))
  debug_assert(shell_adapter.find_owner_pane == 0, "Cmd+F on Primary A migrated Find owner to A")
  debug_assert(sn_read_until_hex(acc_s, exp_fc).contains(exp_fc), "Migrating Find to A sent find_clear to previous owner B")

  // Now open Find on B, then Solo Primary A -> Find closes automatically and sends 0 find_clear to Primary A!
  set_active_split_pane(1)
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 1 && is_find_bar_open(), "Find active on B before Solo A")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  expand_split_pane(0)
  t.frame(ms=16.0)
  debug_assert(!is_split_open() && !is_find_bar_open() && shell_adapter.find_owner_pane == 0, "Solo A closed B-owned Find bar immediately")
  let _ = handle_app_key(proto::KEY_ESCAPE, 0, false)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  debug_assert(!bytes_to_hex(sn_read_all_available(acc_m, 0)).contains(exp_fc), "Primary A received 0 find_clear after closing B-owned Find via Solo A + Esc")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()

  // 4. [Astra #3] 480pt narrow screen: New Tab Folder opens narrow drawer with inline folder creator, submits folder_new, Esc closes
  let t480 = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=480.0,
    height=800.0,
  )
  t480.frame(ms=16.0)
  open_folder_create_bar()
  t480.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.folder_create_open), "folder_create_open true at 480pt")
  debug_assert(t480.find("Create").is_some(), "inline folder creator visible inside 480pt narrow sidebar drawer")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  match app_state.folder_create_field {
    Some(ff) => {
      debug_assert(ff.focused(), "folder_create_field focused at 480pt")
      ff.set("Mobile Notes")
      t480.enter()
      t480.frame(ms=16.0)
    }
    None => debug_assert(false, "folder_create_field exists")
  }
  let _ = io_rt.main_conn.flush_write()
  let exp_fn = bytes_to_hex("Mobile Notes".to_bytes())
  let fn_hex = sn_read_until_hex(acc_m, exp_fn)
  debug_assert(fn_hex.contains(exp_fn), "480pt folder submit dispatched folder_new 'Mobile Notes'")
  open_folder_create_bar()
  t480.frame(ms=16.0)
  let _ = handle_app_key(proto::KEY_ESCAPE, 0, false)
  t480.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.folder_create_open), "Esc closed 480pt folder creator and drawer")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t480.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

test "phase1b_r4: per-pane DownloadsState isolation, identity-key PDF export, reactive Find migration & Peek cleanup" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_ws = app_state.workspace
  let prev_dl = app_state.downloads
  let prev_main_dl = app_state.main_downloads
  let prev_split_dl = app_state.split_downloads
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    spaces: [proto::SpaceSummary::{ id: "sp1", name: "Work", accent: "#3B82F6", theme: proto::space_theme_unset(), active: true, tab_count: 2 }],
    tabs: [
      proto::TabSummary::{
        id: "t1",
        space_id: "sp1",
        title: "Alpha Doc",
        url: "https://alpha.local/doc",
        pinned: false,
        favorite: false,
        active: true,
        state: "active",
        folder_id: "",
        last_active_secs: 100L,
      },
      proto::TabSummary::{
        id: "t2",
        space_id: "sp1",
        title: "Beta Spec",
        url: "https://beta.local/spec",
        pinned: false,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 90L,
      },
    ],
  }

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/doc", "Alpha Doc", false, false, false)))
    st_a.feed(sn_encode_reset_rich_doc("https://alpha.local/doc", "sans-serif", "", "", "alphaonly heading", "a-in"))
  })
  t.frame(ms=16.0)

  open_split_view("https://beta.local/spec", "t2", focus_pane=1, quiet=true)
  let st_b = ensure_split_stage()
  t.frame(ms=16.0)
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.local/spec", "Beta Spec", false, false, false)))
    st_b.feed(sn_encode_reset_rich_doc("https://beta.local/spec", "sans-serif", "", "", "betaonly heading", "b-in"))
  })
  t.frame(ms=16.0)

  // --- P1 #1a: Empty split DownloadsState does NOT wipe Primary A's downloads ---
  let main_seed = [
    proto::DownloadSummary::{
      id: "m1",
      filename: "alpha-notes.pdf",
      url: "https://alpha.local/notes.pdf",
      mime: "application/pdf",
      bytes: 1024L,
      state: "completed", path: "" },
    proto::DownloadSummary::{
      id: "m2",
      filename: "alpha-img.png",
      url: "https://alpha.local/img.png",
      mime: "image/png",
      bytes: 2048L,
      state: "completed", path: "" },
  ]
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope(main_seed))
  debug_assert(app_state.downloads.length() == 2, "Primary A seeded 2 downloads")
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([]))
  debug_assert(app_state.downloads.length() == 2 && app_state.downloads[0].filename == "alpha-notes.pdf", "Empty Secondary B DownloadsState preserved Primary A downloads")

  // --- P1 #1b: B exports PDF -> A's new PDF does NOT trigger B's toast; B's own PDF triggers exact toast ---
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF button visible")
  }
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 1, "split_pending_pdf_req_ids bound to Secondary B")
  let req_b1 = downloads_tracker.split_pending_pdf_req_ids[0]
  let main_with_new_pdf = [
    proto::DownloadSummary::{
      id: "m-new",
      filename: "alpha-unrelated.pdf",
      url: "https://alpha.local/doc",
      mime: "application/pdf",
      bytes: 4096L,
      state: "completed", path: "" },
    main_seed[0],
    main_seed[1],
  ]
  set_host_downloads_state_from_pane(0, proto::encode_downloads_state(main_with_new_pdf))
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 1 && downloads_tracker.split_pending_pdf_req_ids[0] == req_b1, "Primary A PDF did NOT satisfy Secondary B pending export")
  let cur_toast_mid = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!cur_toast_mid.contains("alpha-unrelated.pdf"), "Primary A PDF did NOT fire false Saved PDF toast")

  let split_pdf = [
    proto::DownloadSummary::{
      id: "b-pdf-1",
      filename: "beta-spec.pdf",
      url: "https://beta.local/spec",
      mime: "application/pdf",
      bytes: 8192L,
      state: "completed", path: "" },
  ]
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope(split_pdf, export_req_id=req_b1, export_ok=true, export_filename="beta-spec.pdf", export_id="b-pdf-1"),
  )
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 0, "Secondary B PDF completed pending export")
  let cur_toast_b = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(cur_toast_b.contains("Saved PDF") && cur_toast_b.contains("beta-spec.pdf"), "Secondary B PDF fired exact Saved PDF toast, got: " + cur_toast_b)

  // --- P1 #1c: Full 64-item download list on B still triggers toast on 65th PDF via envelope req_id ---
  let full64 : Array[proto::DownloadSummary] = []
  let mut di = 0
  while di < 64 {
    full64.push(proto::DownloadSummary::{
      id: "old-" + di.to_string(),
      filename: "old-" + di.to_string() + ".pdf",
      url: "https://beta.local/spec",
      mime: "application/pdf",
      bytes: 512L,
      state: "completed", path: "" })
    di += 1
  }
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope(full64))
  debug_assert(app_state.split_downloads.length() == 64, "Secondary B seeded with 64 downloads")
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF button visible on 64-item test")
  }
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 1, "split_pending_pdf_req_ids set with 64 existing items")
  let req_b65 = downloads_tracker.split_pending_pdf_req_ids[0]
  let next64 : Array[proto::DownloadSummary] = [
    proto::DownloadSummary::{
      id: "new-65",
      filename: "beta-65th.pdf",
      url: "https://beta.local/spec",
      mime: "application/pdf",
      bytes: 9000L,
      state: "completed", path: "" },
  ]
  let mut dj = 0
  while dj < 63 {
    next64.push(full64[dj])
    dj += 1
  }
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope(next64, export_req_id=req_b65, export_ok=true, export_filename="beta-65th.pdf", export_id="new-65"),
  )
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 0, "65th PDF detected despite constant length 64")
  let cur_toast_65 = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(cur_toast_65.contains("Saved PDF") && cur_toast_65.contains("beta-65th.pdf"), "65th PDF fired exact toast, got: " + cur_toast_65)

  // --- P1 #2a: Multi-frame reactive Find migration (B open Find -> click A -> frame -> Cmd+F) ---
  let sv0 = match app_state.stage_view { Some(v) => v
    None => panic("stage_view") }
  let sv1 = match app_state.split_stage_view { Some(v) => v
    None => panic("split_stage_view") }
  let (x0, y0, w0, h0) = sv0.placed_window_now()
  let (x1, y1, w1, h1) = sv1.placed_window_now()
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_find_bar()
  t.frame(ms=16.0)
  dispatch_find_query(active_find_stage(), "betaonly")
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 1 && st_b.find_place().1 > 0, "Find active & matched on Secondary B")
  match t.find("Aa") {
    Some((fb_x, _)) => debug_assert(fb_x >= x1 - 4.0, "Find bar initially rendered over Secondary B")
    None => debug_assert(false, "Find bar Aa button visible on Secondary B")
  }
  // Click Primary A -> settle a full frame -> real Cmd+F shortcut -> Find bar must reactively move to Primary A!
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  t.click(x0 + w0 * 0.5, y0 + h0 * 0.5)
  t.frame(ms=16.0)
  debug_assert(active_split_pane() == 0, "clicking Primary A focused pane 0")
  let cmd_mod = if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }
  t.key(ui::key_of_char('f'), mods=cmd_mod)
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 0 && shell_adapter.find_owner_pane_sig.untracked() == 0, "Cmd+F migrated Find owner to Primary A reactively")
  match t.find("Aa") {
    Some((fa_x, _)) => debug_assert(fa_x >= x0 - 4.0 && fa_x <= x0 + w0 + 4.0, "Find bar reactively moved into Primary A rect after multi-frame Cmd+F")
    None => debug_assert(false, "Find bar Aa button visible on Primary A after reactive migration")
  }
  dispatch_find_query(active_find_stage(), "alphaonly")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_fc = bytes_to_hex(wire::encode(wire::Message::Act("find_clear", "", "")))
  let exp_find_a = bytes_to_hex(wire::encode(wire::Message::Act("find", "alphaonly", "")))
  let s_after_mig = sn_read_until_hex(acc_s, exp_fc)
  let m_after_mig = sn_read_until_hex(acc_m, exp_find_a)
  debug_assert(st_a.find_place().1 > 0 && st_b.find_place().1 == 0, "st_a matched 'alphaonly' and st_b cleared")
  debug_assert(s_after_mig.contains(exp_fc) && !s_after_mig.contains(exp_find_a), "Secondary B received find_clear and 0 new find queries")
  debug_assert(m_after_mig.contains(exp_find_a), "Primary A received find('alphaonly')")

  // --- P1 #2b: Close Peek cleans up Secondary B Find state without sending find_clear to Primary A ---
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_find_bar()
  t.frame(ms=16.0)
  dispatch_find_query(active_find_stage(), "betaonly")
  t.frame(ms=16.0)
  debug_assert(shell_adapter.find_owner_pane == 1 && st_b.find_place().1 > 0, "Find active on B before Peek")
  open_peek_preview("https://beta.local/spec", "t2", quiet=true)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  match t.get("Close Peek") {
    Some(cp) => {
      t.click(cp.x + cp.w * 0.5, cp.y + cp.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Close Peek button must be present and clickable in Peek header")
  }
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let m_after_peek_close = bytes_to_hex(sn_read_all_available(acc_m, 0))
  debug_assert(!is_find_bar_open() && shell_adapter.find_owner_pane == 0 && shell_adapter.find_owner_pane_sig.untracked() == 0, "Close Peek closed B-owned Find bar and reset owner to 0")
  debug_assert(st_b.find_place().1 == 0, "Close Peek cleared st_b local find highlights")
  debug_assert(!m_after_peek_close.contains(exp_fc), "Close Peek sent 0 find_clear to Primary A")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.workspace = prev_ws
  app_state.downloads = prev_dl
  app_state.main_downloads = prev_main_dl
  app_state.split_downloads = prev_split_dl
  shell_adapter_reset()
}

test "phase1b_r5: monotonic download seq merge, dual Clear List + stale suppress, offline/concurrent URL-verified PDF export & SplitSpawnFailed Find cleanup" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t1",
    spaces: [proto::SpaceSummary::{ id: "sp1", name: "Work", accent: "#3B82F6", theme: proto::space_theme_unset(), active: true, tab_count: 2 }],
    tabs: [
      proto::TabSummary::{
        id: "t1",
        space_id: "sp1",
        title: "Alpha Doc",
        url: "https://alpha.local/doc",
        pinned: false,
        favorite: false,
        active: true,
        state: "active",
        folder_id: "",
        last_active_secs: 100L,
      },
      proto::TabSummary::{
        id: "t2",
        space_id: "sp1",
        title: "Beta Spec",
        url: "https://beta.local/spec",
        pinned: false,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 90L,
      },
    ],
  }

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/doc", "Alpha Doc", false, false, false)))
  })
  open_split_view("https://beta.local/spec", "t2", focus_pane=1, quiet=true)
  let st_b = ensure_split_stage()
  t.frame(ms=16.0)
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.local/spec", "Beta Spec", false, false, false)))
  })
  t.frame(ms=16.0)

  // --- 1. [R5 P1 #1] Monotonic seq: A has 64 old items -> B adds beta-new.pdf -> Cmd+J syncs A's 64 unchanged -> beta-new.pdf stays #1 ---
  let main64 : Array[proto::DownloadSummary] = []
  let mut i = 0
  while i < 64 {
    main64.push(proto::DownloadSummary::{
      id: "a-old-" + i.to_string(),
      filename: "a-old-" + i.to_string() + ".pdf",
      url: "https://alpha.local/old-" + i.to_string() + ".pdf",
      mime: "application/pdf",
      bytes: 1024L,
      state: "completed", path: "" })
    i += 1
  }
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope(main64))
  let beta_new = [
    proto::DownloadSummary::{
      id: "b-new-1",
      filename: "beta-new.pdf",
      url: "https://beta.local/spec",
      mime: "application/pdf",
      bytes: 2048L,
      state: "completed", path: "" },
  ]
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope(beta_new))
  debug_assert(app_state.downloads.length() == 64 && app_state.downloads[0].filename == "beta-new.pdf", "beta-new.pdf ranked #1 immediately")
  // Open Downloads (Cmd+J) -> triggers downloads_sync to BOTH panes -> A echoes same 64 old items
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  toggle_downloads()
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_dl_sync = bytes_to_hex(wire::encode(wire::Message::Act("downloads_sync", "", "")))
  debug_assert(sn_read_until_hex(acc_m, exp_dl_sync).contains(exp_dl_sync), "downloads_sync sent to Primary A")
  debug_assert(sn_read_until_hex(acc_s, exp_dl_sync).contains(exp_dl_sync), "downloads_sync sent to Secondary B")
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope(main64))
  debug_assert(app_state.downloads.length() == 64 && app_state.downloads[0].filename == "beta-new.pdf", "A's unchanged 64-item resync did NOT evict or demote B's beta-new.pdf")

  // --- 2. [R5 P1 #2] Global Clear List: sends downloads_clear(clr_id) to BOTH panes, suppresses stale resync until clear_ack_id matches ---
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  match t.find("Clear list") {
    Some((cx, cy)) => {
      t.click(cx, cy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Clear List button visible in Downloads popover")
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let clr_m = downloads_tracker.main_pending_clear_id
  let clr_s = downloads_tracker.split_pending_clear_id
  debug_assert(clr_m != "" && clr_s != "" && clr_m != clr_s, "Clear List allocated distinct clr_ids for A & B")
  let exp_dl_clear_m = bytes_to_hex(wire::encode(wire::Message::Act("downloads_clear", clr_m, "")))
  let exp_dl_clear_s = bytes_to_hex(wire::encode(wire::Message::Act("downloads_clear", clr_s, "")))
  debug_assert(sn_read_until_hex(acc_m, exp_dl_clear_m).contains(exp_dl_clear_m), "Clear List sent downloads_clear(clr_m) to Primary A")
  debug_assert(sn_read_until_hex(acc_s, exp_dl_clear_s).contains(exp_dl_clear_s), "Clear List sent downloads_clear(clr_s) to Secondary B")
  debug_assert(app_state.downloads.length() == 0, "Clear List immediately emptied merged downloads")
  // Late stale snapshots from A & B (clear_ack_id=="") must be discarded even with unseen items!
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([main64[0]], clear_seq=0))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope(beta_new, clear_seq=0))
  debug_assert(app_state.downloads.length() == 0, "Late stale snapshots suppressed after Clear List")
  // Both hosts ack with matching unicast clear_ack_id -> close & reopen Cmd+J -> stays empty
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([], clear_seq=1, clear_ack_id=clr_m))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([], clear_seq=1, clear_ack_id=clr_s))
  debug_assert(downloads_tracker.main_pending_clear_id == "" && downloads_tracker.split_pending_clear_id == "", "Unicast clear_ack_id cleared pending clear ids")
  toggle_downloads()
  t.frame(ms=16.0)
  toggle_downloads()
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 0, "Reopened Downloads popover remains empty")
  toggle_downloads()
  t.frame(ms=16.0)

  // --- 3a. [R5 P1 #3] Disconnected B clicking Save as PDF does NOT register pending -> reconnect old-b.pdf fires 0 toast ---
  show_toast("baseline-toast", "info")
  disconnect_split_conn(reconnect=false)
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible while B disconnected")
  }
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 0, "Disconnected B did NOT register pending PDF")
  let (srv_s2, cli_s2, acc_s2) = sn_make_loopback_pair()
  debug_assert(io_rt.split_conn.attach(cli_s2), "reattach split_conn")
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{
        id: "old-b",
        filename: "old-b.pdf",
        url: "https://beta.local/spec",
        mime: "application/pdf",
        bytes: 4096L,
        state: "completed", path: "" },
    ]),
  )
  let toast_after_reconn = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!toast_after_reconn.contains("Saved PDF"), "Reconnect initial snapshot with old-b.pdf fired 0 Saved PDF toast, got: " + toast_after_reconn)

  // --- 3b. [R5 P1 #3] Concurrent A & B PDF exports + unrelated PDF ignored + out-of-order completion ---
  set_active_split_pane(0)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible on A")
  }
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible on B")
  }
  debug_assert(downloads_tracker.main_pending_pdf_req_ids.length() == 1 && downloads_tracker.split_pending_pdf_req_ids.length() == 1, "Both A and B pending PDF exports tracked independently")
  let req_a = downloads_tracker.main_pending_pdf_req_ids[0]
  let req_b = downloads_tracker.split_pending_pdf_req_ids[0]
  debug_assert(req_a != req_b, "A and B req_ids are distinct")
  // Regular PDF download (even from same URL!) without matching export_req_id must NOT trigger Saved PDF!
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope(
      [
        proto::DownloadSummary::{
          id: "other-pdf",
          filename: "random-download.pdf",
          url: "https://beta.local/spec",
          mime: "application/pdf",
          bytes: 3000L,
          state: "completed", path: "" },
      ],
      clear_seq=0,
    ),
  )
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 1 && downloads_tracker.split_pending_pdf_req_ids[0] == req_b, "Regular PDF without matching export_req_id did NOT satisfy split_pending_pdf_req_ids")
  // Matching req_id envelope on B completes B's export while A remains pending
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope(
      [
        proto::DownloadSummary::{
          id: "b-exp",
          filename: "beta-export.pdf",
          url: "https://beta.local/spec",
          mime: "application/pdf",
          bytes: 6000L,
          state: "completed", path: "" },
      ],
      export_req_id=req_b,
      export_ok=true,
      export_filename="beta-export.pdf",
      export_id="b-exp",
    ),
  )
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 0 && downloads_tracker.main_pending_pdf_req_ids.length() == 1, "B export completed while A remained pending")
  let toast_b2 = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(toast_b2.contains("Saved PDF") && toast_b2.contains("beta-export.pdf"), "B exact toast: " + toast_b2)
  // Matching req_id envelope on A completes A's export afterwards
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope(
      [
        proto::DownloadSummary::{
          id: "a-exp",
          filename: "alpha-export.pdf",
          url: "https://alpha.local/doc",
          mime: "application/pdf",
          bytes: 7000L,
          state: "completed", path: "" },
      ],
      clear_seq=1,
      export_req_id=req_a,
      export_ok=true,
      export_filename="alpha-export.pdf",
      export_id="a-exp",
    ),
  )
  debug_assert(downloads_tracker.main_pending_pdf_req_ids.length() == 0, "A export completed after B")
  let toast_a2 = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(toast_a2.contains("Saved PDF") && toast_a2.contains("alpha-export.pdf"), "A exact toast: " + toast_a2)

  // --- 4. [R5 P2 #4] Delayed SplitSpawnFailed rollback cleans up B-owned Find & Esc sends 0 find_clear to A ---
  set_active_split_pane(1)
  io_rt.split_spawning = true
  t.frame(ms=16.0)
  open_find_bar()
  t.frame(ms=16.0)
  debug_assert(is_find_bar_open() && shell_adapter.find_owner_pane == 1, "Find opened on B while split spawn in-flight")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  rollback_failed_split_spawn()
  t.frame(ms=16.0)
  debug_assert(!is_find_bar_open() && shell_adapter.find_owner_pane == 0 && shell_adapter.find_owner_pane_sig.untracked() == 0, "rollback_failed_split_spawn closed B-owned Find immediately")
  let _ = handle_app_key(proto::KEY_ESCAPE, 0, false)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let exp_fc = bytes_to_hex(wire::encode(wire::Message::Act("find_clear", "", "")))
  debug_assert(!bytes_to_hex(sn_read_all_available(acc_m, 0)).contains(exp_fc), "Esc after SplitSpawnFailed rollback sent 0 find_clear to Primary A")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  net::close(cli_s2)
  net::close(acc_s2)
  net::close(srv_s2)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

test "phase1b_r6: QueueFull rejects PDF export on A & B, export_ok=false + same-URL PDF ignored, deduped filename & clear_seq blocks unseen FIFO x.zip" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_view(root)
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/doc", "Alpha Doc", false, false, false)))
  })
  open_split_view("https://beta.local/spec", "t2", focus_pane=1, quiet=true)
  let st_b = ensure_split_stage()
  t.frame(ms=16.0)
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.local/spec", "Beta Spec", false, false, false)))
  })
  t.frame(ms=16.0)

  // --- 1. [R6 P1 #1] QueueFull on open A & B rejects Save as PDF & registers 0 pending ---
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([]))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([]))
  show_toast("baseline-r6", "info")
  let dummy = wire::encode(wire::Message::Act("noop", "", ""))
  let mut fill_a = 0
  while fill_a < 1024 {
    match io_rt.main_conn.enqueue(dummy, coalescable=false) {
      net::EnqueueResult::Ok => fill_a += 1
      _ => break
    }
  }
  debug_assert(io_rt.main_conn.is_open() && io_rt.main_conn.pending_frames() > 0, "main_conn open with full write queue")
  set_active_split_pane(0)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible on full-queue A")
  }
  debug_assert(downloads_tracker.main_pending_pdf_req_ids.length() == 0, "QueueFull on A rejected export and did NOT register main_pending_pdf_req_ids")

  let mut fill_b = 0
  while fill_b < 1024 {
    match io_rt.split_conn.enqueue(dummy, coalescable=false) {
      net::EnqueueResult::Ok => fill_b += 1
      _ => break
    }
  }
  debug_assert(io_rt.split_conn.is_open() && io_rt.split_conn.pending_frames() > 0, "split_conn open with full write queue")
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible on full-queue B")
  }
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 0, "QueueFull on B rejected export and did NOT register split_pending_pdf_req_ids")

  // Reconnect fresh sockets & verify initial snapshot triggers 0 Saved PDF toasts
  let (srv_m2, cli_m2, acc_m2) = sn_make_loopback_pair()
  let (srv_s2, cli_s2, acc_s2) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m2) && io_rt.split_conn.attach(cli_s2), "reattach fresh conns")
  st_a.opened()
  st_b.opened()
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{ id: "r1", filename: "old-a.pdf", url: "https://alpha.local/doc", mime: "application/pdf", bytes: 100L, state: "completed", path: "" },
    ]),
  )
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{ id: "r2", filename: "old-b.pdf", url: "https://beta.local/spec", mime: "application/pdf", bytes: 100L, state: "completed", path: "" },
    ]),
  )
  let t_re = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!t_re.contains("Saved PDF"), "Reconnect after QueueFull fired 0 Saved PDF toasts")

  // --- 2. [R6 P1 #2] export_ok=false settles pending -> subsequent same-URL normal PDF ignored -> deduped doc (1).pdf succeeds ---
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible for failure test")
  }
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 1, "fail_req registered")
  let fail_req = downloads_tracker.split_pending_pdf_req_ids[0]
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope([], export_req_id=fail_req, export_ok=false, export_filename="", export_id=""),
  )
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 0, "export_ok=false cleared split_pending_pdf_req_ids")
  let t_fail = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!t_fail.contains("Saved PDF") && t_fail.contains("Failed"), "export_ok=false showed failure toast, not Saved PDF: " + t_fail)
  // Same-URL regular PDF download arrives right after -> 0 Saved PDF toast!
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{ id: "reg-pdf", filename: "spec.pdf", url: "https://beta.local/spec", mime: "application/pdf", bytes: 5000L, state: "completed", path: "" },
    ]),
  )
  let t_after_reg = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!t_after_reg.contains("Saved PDF"), "Same-URL normal PDF after failed export did NOT fire Saved PDF")
  // Now real deduped export succeeds -> exact `doc (1).pdf` toast!
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible for deduped test")
  }
  let ok_req = downloads_tracker.split_pending_pdf_req_ids[0]
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope(
      [
        proto::DownloadSummary::{ id: "dedup-1", filename: "doc (1).pdf", url: "https://beta.local/spec", mime: "application/pdf", bytes: 6000L, state: "completed", path: "" },
      ],
      export_req_id=ok_req,
      export_ok=true,
      export_filename="doc (1).pdf",
      export_id="dedup-1",
    ),
  )
  let t_dedup = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(t_dedup == "Saved PDF · doc (1).pdf", "Exact deduped filename toast: " + t_dedup)

  // --- 3. [R6/R7 P2 #2] Non-zero clear_seq=7 after reconnect + concurrent other-viewer clear_seq=8 stay empty until unicast clear_ack_id arrives ---
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope(
      [proto::DownloadSummary::{ id: "a1", filename: "a.zip", url: "https://alpha.local/a.zip", mime: "application/zip", bytes: 100L, state: "completed", path: "" }],
      clear_seq=7,
    ),
  )
  toggle_downloads()
  t.frame(ms=16.0)
  match t.find("Clear list") {
    Some((cx, cy)) => {
      t.click(cx, cy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Clear List visible in R6 test")
  }
  let r6_clr_id = downloads_tracker.main_pending_clear_id
  debug_assert(r6_clr_id != "" && app_state.downloads.length() == 0, "Clear List set main_pending_clear_id and cleared UI")
  // In-flight pre-clear FIFO snapshot (clear_seq=7, clear_ack_id=="") contains UNSEEN x.zip + a.zip -> MUST NOT flash!
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope(
      [
        proto::DownloadSummary::{ id: "x1", filename: "x.zip", url: "https://alpha.local/x.zip", mime: "application/zip", bytes: 200L, state: "completed", path: "" },
        proto::DownloadSummary::{ id: "a1", filename: "a.zip", url: "https://alpha.local/a.zip", mime: "application/zip", bytes: 100L, state: "completed", path: "" },
      ],
      clear_seq=7,
    ),
  )
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 0, "Unseen pre-clear FIFO x.zip discarded when clear_ack_id != pending")
  // Concurrent other-viewer clear broadcast (clear_seq=8, clear_ack_id=="") -> still does NOT unlock before our ack!
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([], clear_seq=8))
  debug_assert(downloads_tracker.main_pending_clear_id == r6_clr_id, "Other-viewer clear broadcast did NOT prematurely unlock pending clear")
  // Own unicast clear ack (clear_ack_id == r6_clr_id) -> unlocks!
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([], clear_seq=9, clear_ack_id=r6_clr_id))
  t.frame(ms=16.0)
  debug_assert(downloads_tracker.main_pending_clear_id == "" && app_state.downloads.length() == 0, "Unicast clear_ack_id unlocked clear gate")
  // Genuine post-clear download y.zip -> displayed normally!
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope(
      [proto::DownloadSummary::{ id: "y1", filename: "y.zip", url: "https://alpha.local/y.zip", mime: "application/zip", bytes: 300L, state: "completed", path: "" }],
      clear_seq=9,
    ),
  )
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "y.zip", "Post-clear y.zip displayed normally")

  // --- 4. [R7/R9 P1 #3] Legacy array-only host compatibility ---
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_state([
      proto::DownloadSummary::{ id: "leg-1", filename: "old.zip", url: "https://alpha.local/old.zip", mime: "application/zip", bytes: 50L, state: "completed", path: "" },
    ]),
  )
  debug_assert(downloads_tracker.main_dl_cap == 1, "Legacy array host detected as main_dl_cap=1")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m2, 0)
  match t.find("Clear list") {
    Some((cx, cy)) => {
      t.click(cx, cy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Clear List visible for legacy host test")
  }
  let _ = io_rt.main_conn.flush_write()
  let exp_leg_clear = bytes_to_hex(wire::encode(wire::Message::Act("downloads_clear", "", "")))
  debug_assert(sn_read_until_hex(acc_m2, exp_leg_clear).contains(exp_leg_clear), "Legacy host received empty-arg downloads_clear")
  debug_assert(downloads_tracker.main_pending_clear_id == "", "Legacy host did NOT set main_pending_clear_id")
  set_host_downloads_state_from_pane(0, "[]")
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_state([
      proto::DownloadSummary::{ id: "leg-2", filename: "after-clear.zip", url: "https://alpha.local/after-clear.zip", mime: "application/zip", bytes: 80L, state: "completed", path: "" },
    ]),
  )
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "after-clear.zip", "Legacy host post-clear after-clear.zip visible normally")
  toggle_downloads()
  t.frame(ms=16.0)

  // --- 5. [R11 P1 #1] cap==0 immediate TCP FIFO: Save on Page A -> click Sidebar Tab B -> export_pdf(a="", reqId in b) precedes tab_switch(B) ---
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp1",
    active_tab_id: "t-a",
    spaces: [proto::SpaceSummary::{ id: "sp1", name: "Work", accent: "#3B82F6", theme: proto::space_theme_unset(), active: true, tab_count: 2 }],
    tabs: [
      proto::TabSummary::{
        id: "t-a",
        space_id: "sp1",
        title: "Farview Alpha Doc",
        url: "https://alpha.local/doc",
        pinned: false,
        favorite: false,
        active: true,
        state: "active",
        folder_id: "",
        last_active_secs: 100L,
      },
      proto::TabSummary::{
        id: "t-b",
        space_id: "sp1",
        title: "Farview Beta Spec",
        url: "https://beta.local/spec",
        pinned: false,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 90L,
      },
    ],
  }
  match app_state.workspace_rev {
    Some(s) => s.set(s.untracked() + 1)
    None => ()
  }
  set_sidebar_open(true)
  t.frame(ms=16.0)
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/doc", "Farview Alpha Doc", false, false, false)))
  })
  downloads_tracker.main_dl_cap = 0
  downloads_tracker.main_pending_pdf_req_ids = []
  show_toast("baseline-r11", "info")
  set_active_split_pane(0)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m2, 0)
  // Real Print -> Save on Page A, immediately followed by clicking Sidebar Tab B!
  open_print_pdf_modal()
  t.frame(ms=16.0)
  match t.find("Save as PDF") {
    Some((sx, sy)) => {
      t.click(sx, sy)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Save as PDF visible in R11 FIFO test")
  }
  match t.find("Farview Beta Spec") {
    Some((bx, by)) => {
      t.click(bx, by)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Sidebar Tab B 'Farview Beta Spec' clickable")
  }
  let _ = io_rt.main_conn.flush_write()
  let fifo_raw = sn_read_all_available(acc_m2, 20)
  // Decode every outbound wire frame on main_conn and assert strict FIFO: export_pdf(a="", reqId) BEFORE tab_switch("t-b")!
  let mut export_idx = -1
  let mut export_count = 0
  let mut switch_idx = -1
  let mut wire_req_id = ""
  let mut frame_i = 0
  let mut foff = 0
  while foff + 4 <= fifo_raw.length() {
    let flen = (fifo_raw[foff].to_int() << 24) |
    (fifo_raw[foff + 1].to_int() << 16) |
    (fifo_raw[foff + 2].to_int() << 8) |
    fifo_raw[foff + 3].to_int()
    if flen <= 0 || foff + 4 + flen > fifo_raw.length() {
      break
    }
    match wire::decode(fifo_raw.slice(foff + 4, foff + 4 + flen)) {
      Some(wire::Message::Act("export_pdf", a_arg, b_cfg)) => {
        debug_assert(a_arg == "", "export_pdf wire arg a MUST be empty string for legacy compat, got: " + a_arg)
        wire_req_id = proto::parse_print_pdf_req_id(b_cfg)
        debug_assert(wire_req_id != "", "export_pdf config JSON carries non-empty reqId")
        export_idx = frame_i
        export_count += 1
      }
      Some(wire::Message::Act("tab_switch", tid, _)) if tid == "t-b" => switch_idx = frame_i
      _ => ()
    }
    frame_i += 1
    foff += 4 + flen
  }
  debug_assert(export_count == 1 && export_idx >= 0 && switch_idx > export_idx, "Strict TCP FIFO: export_pdf emitted once BEFORE tab_switch(t-b)")
  // 1) Delayed first DownloadsState arrives with historical old.pdf -> 0 false Saved PDF toast!
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{ id: "hist-old", filename: "old.pdf", url: "https://alpha.local/doc", mime: "application/pdf", bytes: 1200L, state: "completed", path: "" },
    ]),
  )
  let t_hist = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!t_hist.contains("Saved PDF"), "Historical old.pdf in first snapshot fired 0 Saved PDF toast")
  // 2) Host switches to Page B metadata
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.local/spec", "Farview Beta Spec", false, false, false)))
  })
  // 3) Unicast receipt for Page A's export arrives -> exact Page A filename toast!
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope(
      [proto::DownloadSummary::{ id: "a-pdf", filename: "Farview Alpha Doc.pdf", url: "https://alpha.local/doc", mime: "application/pdf", bytes: 4200L, state: "completed", path: "" }],
      export_req_id=wire_req_id,
      export_ok=true,
      export_filename="Farview Alpha Doc.pdf",
      export_id="a-pdf",
    ),
  )
  let t_a_ok = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(t_a_ok == "Saved PDF · Farview Alpha Doc.pdf" && downloads_tracker.main_pending_pdf_req_ids.length() == 0, "Exact Page A receipt settled cleanly: " + t_a_ok)

  // 5b: cap==0 on NEW host with write failure -> export_ok=false settles cleanly, same-URL PDF ignored
  downloads_tracker.main_dl_cap = 0
  dispatch_export_pdf()
  debug_assert(downloads_tracker.main_pending_pdf_req_ids.length() == 1, "5b immediate export registered req_id")
  let req_5b = downloads_tracker.main_pending_pdf_req_ids[0]
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([], export_req_id=req_5b, export_ok=false))
  let t_5b = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(t_5b.contains("Failed") && downloads_tracker.main_pending_pdf_req_ids.length() == 0, "5b write failure settled cleanly")
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{ id: "norm-5b", filename: "alpha.pdf", url: "https://alpha.local/doc", mime: "application/pdf", bytes: 900L, state: "completed", path: "" },
    ]),
  )
  let t_5b2 = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(!t_5b2.contains("Saved PDF"), "5b same-URL normal PDF ignored after failure")

  // 5c: cap==0 on LEGACY array-only host -> first bare array clears pending & toasts "Sent PDF export request" without hanging!
  downloads_tracker.main_dl_cap = 0
  dispatch_export_pdf()
  debug_assert(downloads_tracker.main_pending_pdf_req_ids.length() == 1, "5c pending req_id before first packet")
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_state([
      proto::DownloadSummary::{ id: "leg-old", filename: "old.pdf", url: "https://alpha.local/doc", mime: "application/pdf", bytes: 500L, state: "completed", path: "" },
    ]),
  )
  let t_5c = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(t_5c == "Sent PDF export request" && downloads_tracker.main_pending_pdf_req_ids.length() == 0, "5c legacy array host cleared pending without misreporting old.pdf: " + t_5c)

  // --- 6. [R9 P2 #3] Same-pane two consecutive PDF saves tracked as list: req1 fails while req2 stays pending, then req2 succeeds ---
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([]))
  set_active_split_pane(1)
  dispatch_export_pdf()
  dispatch_export_pdf()
  debug_assert(downloads_tracker.split_pending_pdf_req_ids.length() == 2, "Two consecutive saves on pane 1 tracked independently")
  let r_one = downloads_tracker.split_pending_pdf_req_ids[0]
  let r_two = downloads_tracker.split_pending_pdf_req_ids[1]
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([], export_req_id=r_one, export_ok=false))
  let t_r1 = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(t_r1.contains("Failed") && downloads_tracker.split_pending_pdf_req_ids.length() == 1 && downloads_tracker.split_pending_pdf_req_ids[0] == r_two, "req1 failure preserved req2 in pending list")
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([], export_req_id=r_two, export_ok=true, export_filename="second.pdf", export_id="s2"))
  let t_r2 = match app_state.toast_message { Some(sig) => sig.untracked()
    None => "" }
  debug_assert(t_r2 == "Saved PDF · second.pdf" && downloads_tracker.split_pending_pdf_req_ids.length() == 0, "req2 succeeded with exact toast and emptied pending list")

  // --- 7. [R10 P2 #2] Clear List while B is cap==0 (lagged first snapshot) binds clear_ack_id & blocks pre-clear bounce-back ---
  set_sidebar_open(false)
  t.frame(ms=16.0)
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([]))
  downloads_tracker.split_dl_cap = 0
  downloads_tracker.split_pending_clear_id = ""
  toggle_downloads()
  t.frame(ms=16.0)
  // An empty list offers no Clear list (nothing to clear); the protocol case is driven through the same dispatch.
  debug_assert(t.find("Clear list") is None, "empty Downloads shows no Clear list")
  dispatch_downloads_clear()
  t.frame(ms=16.0)
  let clr_b_r10 = downloads_tracker.split_pending_clear_id
  debug_assert(clr_b_r10 != "", "cap==0 Clear List bound split_pending_clear_id")
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope([
      proto::DownloadSummary::{ id: "b-old", filename: "b-old.zip", url: "https://beta.local/old.zip", mime: "application/zip", bytes: 100L, state: "completed", path: "" },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 0 && downloads_tracker.split_pending_clear_id == clr_b_r10, "Lagged first envelope snapshot b-old discarded before clear_ack_id")
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([], clear_seq=1, clear_ack_id=clr_b_r10))
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 0 && downloads_tracker.split_pending_clear_id == "", "Unicast clear_ack_id unlocked cap==0 Clear List")
  set_host_downloads_state_from_pane(
    1,
    proto::encode_downloads_envelope(
      [proto::DownloadSummary::{ id: "b-new", filename: "b-new.zip", url: "https://beta.local/new.zip", mime: "application/zip", bytes: 200L, state: "completed", path: "" }],
      clear_seq=1,
    ),
  )
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "b-new.zip", "Post-clear b-new.zip displayed normally")

  ui::set_text_interceptor(None)
  ui::set_key_interceptor(None)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  net::close(cli_m2)
  net::close(acc_m2)
  net::close(srv_m2)
  net::close(cli_s2)
  net::close(acc_s2)
  net::close(srv_s2)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

fn sn_count_label_in_tree(rv : view::View, needle : String) -> Int {
  if !rv.alive() {
    return 0
  }
  let mut total = 0
  match rv.tree.nodes[rv.at].said {
    Some(s) if s.label == needle => total += 1
    _ => ()
  }
  let kids = rv.kids()
  let mut i = 0
  while i < kids.length() {
    total += sn_count_label_in_tree(kids[i], needle)
    i += 1
  }
  total
}

fn sn_count_drawn_words(rv : view::View, needle : String) -> Int {
  let mut total = 0
  for d in rv.tree.drawn() {
    if d.words == needle {
      total += 1
    }
  }
  total
}

extern "C" fn sn_test_fopen(path : Ptr, mode : Ptr) -> Ptr = "fopen"
extern "C" fn sn_test_fwrite(buf : Ptr, sz : Int, n : Int, f : Ptr) -> Int = "fwrite"
extern "C" fn sn_test_fclose(f : Ptr) -> Int = "fclose"
extern "C" fn sn_test_unlink(path : Ptr) -> Int = "unlink"

fn sn_write_temp_file(path : String, content : String) -> Bool {
  let pb = (path + "\u{0000}").to_bytes()
  let mb = "wb\u{0000}".to_bytes()
  let f = sn_test_fopen(bytes_data_ptr(pb), bytes_data_ptr(mb))
  if ptr_is_null(f) {
    return false
  }
  let cb = content.to_bytes()
  let w = sn_test_fwrite(bytes_data_ptr(cb), 1, cb.length(), f)
  let _ = sn_test_fclose(f)
  w == cb.length()
}

fn sn_remove_temp_file(path : String) -> Unit {
  let pb = (path + "\u{0000}").to_bytes()
  let _ = sn_test_unlink(bytes_data_ptr(pb))
}

test "phase2a_t1: single-source CaptureSheet & Toast (real Copy/Reveal/Dismiss, PDF error ToastKind::Error, unique nodes, Exclusive focus exclusion)" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/home", "Alpha Home", false, false, false)))
  app_state.stage = Some(st)
  app_state.split_stage = None

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  let rv = match app_state.root_view { Some(v) => v; None => panic("root_view") }

  // 1. Open CaptureSheet via real proto::parse_downloads_state -> capture_sheet_from_download (zero ~/Downloads/ fabrication!)
  let custom_path = "/tmp/fv_capture_test_sub/phase2a-shot (1).png"
  let dl_json = "[{\"id\":\"cap-1\",\"filename\":\"phase2a-shot (1).png\",\"url\":\"about:capture\",\"mime\":\"image/png\",\"bytes\":204800,\"state\":\"completed\",\"path\":\"" + custom_path + "\"}]"
  let parsed_dls = proto::parse_downloads_state(dl_json)
  debug_assert(parsed_dls.length() == 1 && parsed_dls[0].path == custom_path, "parse_downloads_state preserved real absolute path")
  let cap_meta = proto::capture_sheet_from_download(parsed_dls[0], 1280, 800)
  debug_assert(cap_meta.path == custom_path && !cap_meta.path.starts_with("~/Downloads/"), "capture_sheet_from_download used exact host path")
  // Missing path in DownloadSummary MUST NOT fabricate ~/Downloads/
  let no_path_dl = proto::DownloadSummary::{
    id: "cap-nopath",
    filename: "remote-only.png",
    url: "",
    mime: "image/png",
    bytes: 1024L,
    state: "completed",
    path: "",
  }
  debug_assert(proto::capture_sheet_from_download(no_path_dl, 1280, 800).path == "", "empty DownloadSummary.path never guesses ~/Downloads/")

  // Install in-memory clipboard, file-exists, reveal, and host_addr test doubles (NEVER touch macOS system clipboard!)
  let mem_clip = ui::ref_new("__fv_capture_sentinel_clip__")
  let prev_clip_r = test_clipboard_read_hook.v
  let prev_clip_w = test_clipboard_write_hook.v
  test_clipboard_read_hook.v = Some(fn() -> String { mem_clip.v })
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { mem_clip.v = s })

  let revealed_paths : Array[String] = []
  let prev_reveal_hook = test_reveal_file_hook.v
  let prev_exists_hook = test_file_exists_hook.v
  let prev_host_override = test_host_addr_override.v
  test_reveal_file_hook.v = Some(fn(p : String) -> Bool {
    revealed_paths.push(p)
    true
  })
  test_file_exists_hook.v = Some(fn(p : String) -> Bool { p == custom_path })
  test_host_addr_override.v = Some("127.0.0.1")

  open_capture_sheet(cap_meta)
  t.frame(ms=16.0)
  debug_assert(sn_count_label_in_tree(rv, "Capture Completed") == 1, "exactly 1 Capture Completed node in tree")
  debug_assert(shell_adapter.passive.untracked().capture_sheet_revealable && !shell_adapter.passive.untracked().capture_sheet_file_unavailable, "local existing capture is revealable")

  // 2. Real click "Reveal" -> invokes OS reveal with exact non-default path, NEVER touches clipboard, shows Info toast
  t.press("Reveal")
  t.frame(ms=16.0)
  debug_assert(revealed_paths.length() == 1 && revealed_paths[0] == custom_path, "Reveal invoked with exact meta.path")
  debug_assert(mem_clip.v == "__fv_capture_sentinel_clip__", "Reveal NEVER modifies clipboard")
  let exp_reveal_prefix = if ui::keys_system() == 0 { "Revealed in Finder: " } else { "Opened folder: " }
  debug_assert(shell_adapter.passive.untracked().toast_title == exp_reveal_prefix + "phase2a-shot (1).png", "Reveal toast title")
  debug_assert(shell_adapter.passive.untracked().toast_kind is shell_ui::ToastKind::Info, "Reveal toast is Info")
  debug_assert(shell_sig_is_true(app_state.capture_sheet_open), "Reveal keeps CaptureSheet open")

  // 3. Real click "Copy Path" -> copies exact path to in-memory clipboard, 0 extra reveal calls, shows Success toast ONCE
  t.press("Copy path")
  t.frame(ms=16.0)
  debug_assert(mem_clip.v == custom_path, "Copy Path wrote exact meta.path to clipboard")
  debug_assert(revealed_paths.length() == 1, "Copy Path made 0 reveal calls")
  debug_assert(shell_adapter.passive.untracked().toast_visible, "Copy Path showed toast")
  debug_assert(shell_adapter.passive.untracked().toast_title == "Copied screenshot path", "Copy Path toast title")
  debug_assert(shell_adapter.passive.untracked().toast_kind is shell_ui::ToastKind::Success, "Copy Path toast is Success")
  debug_assert(shell_sig_is_true(app_state.capture_sheet_open), "Copy Path keeps CaptureSheet open")
  let copy_toast_hits = sn_count_drawn_words(rv, "Copied screenshot path")
  debug_assert(copy_toast_hits == 1, "Copied screenshot path rendered strictly ONCE in tree: got " + copy_toast_hits.to_string())

  // 4. Open ANY Exclusive overlay (CommandBar) -> CaptureSheet exits keyboard focus order!
  open_command_bar("")
  t.frame(ms=16.0)
  debug_assert(
    !shell_ui::capture_sheet_in_focus_order(shell_adapter.exclusive.untracked(), shell_adapter.passive.untracked()),
    "CaptureSheet exits focus order while CommandBar is open",
  )
  close_command_bar()
  t.frame(ms=16.0)
  debug_assert(
    shell_ui::capture_sheet_in_focus_order(shell_adapter.exclusive.untracked(), shell_adapter.passive.untracked()),
    "CaptureSheet returns to focus order after CommandBar closes",
  )

  // 5. Real click "Dismiss" -> closes CaptureSheet ONLY without calling reveal or modifying clipboard
  let toast_before_dismiss = shell_adapter.passive.untracked().toast_title
  t.press("Dismiss")
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.capture_sheet_open), "Dismiss closed CaptureSheet")
  // (its MO_POP_OUT_MS way out, then gone)
  t.frame(ms=120.0)
  t.frame(ms=16.0)
  debug_assert(sn_count_label_in_tree(rv, "Capture Completed") == 0, "0 Capture Completed nodes after Dismiss")
  debug_assert(shell_adapter.passive.untracked().toast_title == toast_before_dismiss, "Dismiss caused no extra toast side effect")
  debug_assert(revealed_paths.length() == 1, "Dismiss made 0 reveal calls")
  debug_assert(mem_clip.v == custom_path, "Dismiss left clipboard untouched")

  // 5b. Default local host with NO test doubles: nonexistent file hides Reveal, shows "File not accessible on this device" (NEVER "Saved on remote host")
  test_host_addr_override.v = None
  test_file_exists_hook.v = None
  test_reveal_file_hook.v = None
  open_capture_sheet(proto::CaptureSheetMeta::{
    filename: "missing-shot.png",
    path: "/tmp/fv_capture_nonexistent_987654321/missing-shot.png",
    width: 1280,
    height: 800,
    format: "PNG",
    size_bytes: 1024L,
    saved_at_label: "Just now",
  })
  t.frame(ms=16.0)
  debug_assert(!shell_adapter.passive.untracked().capture_sheet_revealable && shell_adapter.passive.untracked().capture_sheet_file_unavailable, "missing local file marks CaptureSheet unavailable")
  debug_assert(t.get("Reveal").is_none(), "Reveal button hidden when local file does not exist")
  debug_assert(t.find("File not accessible on this device").is_some(), "accurate unavailable status text shown")
  debug_assert(t.find("Saved on remote host").is_none(), "NEVER mislabels missing local file as 'Saved on remote host'")
  reveal_capture_sheet_file()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.passive.untracked().toast_title == "Could not locate screenshot file", "missing file shows error toast")
  debug_assert(shell_adapter.passive.untracked().toast_kind is shell_ui::ToastKind::Error, "missing file uses ToastKind::Error")
  close_capture_sheet()
  t.frame(ms=16.0)

  // 5c. Real local temp file with NO test doubles: matching size enables Reveal; mismatched size hides Reveal!
  let real_tmp = "/tmp/fv_p2a_real_local_shot_" + net::getpid().to_string() + ".png"
  debug_assert(sn_write_temp_file(real_tmp, "0123456789abcdef"), "wrote 16-byte real local temp file")
  open_capture_sheet(proto::CaptureSheetMeta::{
    filename: "farview-capture-real (1).png",
    path: real_tmp,
    width: 1280,
    height: 800,
    format: "PNG",
    size_bytes: 16L,
    saved_at_label: "Just now",
  })
  t.frame(ms=16.0)
  debug_assert(shell_adapter.passive.untracked().capture_sheet_revealable && t.get("Reveal").is_some(), "exact size match enables Reveal with real stat()")
  open_capture_sheet(proto::CaptureSheetMeta::{
    filename: "farview-capture-real (1).png",
    path: real_tmp,
    width: 1280,
    height: 800,
    format: "PNG",
    size_bytes: 999L,
    saved_at_label: "Just now",
  })
  t.frame(ms=16.0)
  debug_assert(!shell_adapter.passive.untracked().capture_sheet_revealable && t.get("Reveal").is_none(), "size mismatch disables Reveal via real stat()")
  debug_assert(t.find("File not accessible on this device").is_some(), "size mismatch shows accurate unavailable notice")
  close_capture_sheet()
  t.frame(ms=16.0)

  // 5d. Capability negotiation (3 scenarios):
  // (3) Pre-first-snapshot (cap=0) + new host (capture_receipt=true): ordinary.png does NOT hijack; matching export_req_id settles CaptureSheet!
  test_reveal_file_hook.v = Some(fn(p : String) -> Bool {
    revealed_paths.push(p)
    true
  })
  reset_downloads_tracker()
  debug_assert(downloads_tracker.main_dl_cap == 0, "starts at cap=0 (unknown)")
  dispatch_capture_screenshot()
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 1, "cap=0 dispatch registered pending shot req_id")
  let shot_req_id = downloads_tracker.main_pending_shot_req_ids[0]
  let ordinary_dl = proto::DownloadSummary::{
    id: "dl-ord-1",
    filename: "ordinary.png",
    url: "https://alpha.local/ordinary.png",
    mime: "image/png",
    bytes: 4096L,
    state: "completed",
    path: "/tmp/ordinary.png",
  }
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([ordinary_dl], capture_receipt=true))
  t.frame(ms=16.0)
  debug_assert(downloads_tracker.main_dl_cap == 3, "upgraded host sets cap=3")
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 1, "ordinary.png broadcast keeps pending==1 on cap=3 host")
  debug_assert(!shell_sig_is_true(app_state.capture_sheet_open), "ordinary.png download MUST NOT hijack pending CaptureSheet")
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "ordinary.png", "ordinary.png still recorded in downloads list")

  let real_shot_dl = proto::DownloadSummary::{
    id: "dl-shot-2",
    filename: "farview-capture-real (1).png",
    url: "https://alpha.local/home",
    mime: "image/png",
    bytes: 16L,
    state: "completed",
    path: real_tmp,
  }
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope(
      [real_shot_dl, ordinary_dl],
      export_req_id=shot_req_id,
      export_ok=true,
      export_filename="farview-capture-real (1).png",
      export_path=real_tmp,
      capture_receipt=true,
    ),
  )
  t.frame(ms=16.0)
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 0, "matching receipt cleared pending==0")
  debug_assert(shell_sig_is_true(app_state.capture_sheet_open), "matching export_req_id receipt opened CaptureSheet")
  debug_assert(app_state.capture_sheet_meta.filename == "farview-capture-real (1).png" && app_state.capture_sheet_meta.path == real_tmp, "CaptureSheet bound to exact deduped receipt path")
  t.press("Copy path")
  t.frame(ms=16.0)
  debug_assert(mem_clip.v == real_tmp, "Copy Path copied exact deduped receipt path")
  let rev_before = revealed_paths.length()
  t.press("Reveal")
  t.frame(ms=16.0)
  debug_assert(revealed_paths.length() == rev_before + 1 && revealed_paths[rev_before] == real_tmp, "Reveal invoked with exact deduped receipt path")
  close_capture_sheet()
  sn_remove_temp_file(real_tmp)

  // (1) Phase 2 baseline envelope host (has_envelope=true, capture_receipt=false):
  //     Both pre-first-snapshot (cap=0) and known (cap=2) settle cleanly with "Sent screenshot request", pending==0, never hang or hijack!
  reset_downloads_tracker()
  dispatch_capture_screenshot()
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 1, "cap=0 queued pending shot before first snapshot")
  let reviewtab_dl = proto::DownloadSummary::{
    id: "dl-rev-1",
    filename: "farview-capture-reviewtab.png",
    url: "https://alpha.local/review",
    mime: "image/png",
    bytes: 2048L,
    state: "completed",
    path: "/tmp/farview-capture-reviewtab.png",
  }
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([reviewtab_dl], capture_receipt=false))
  t.frame(ms=16.0)
  debug_assert(downloads_tracker.main_dl_cap == 2, "baseline envelope without capture_receipt sets cap=2")
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 0, "cap=0->2 cleared pending_shot_req_ids (never hangs)")
  debug_assert(!shell_sig_is_true(app_state.capture_sheet_open), "baseline envelope host does NOT hijack CaptureSheet")
  debug_assert(shell_adapter.passive.untracked().toast_title == "Sent screenshot request", "cap=0->2 settled with Sent screenshot request toast")
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "farview-capture-reviewtab.png", "downloads list updated on cap=2 host")
  // Known cap=2 dispatch: immediate toast & pending==0!
  dispatch_capture_screenshot()
  t.frame(ms=16.0)
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 0, "known cap=2 dispatch leaves pending==0")
  debug_assert(shell_adapter.passive.untracked().toast_title == "Sent screenshot request", "known cap=2 dispatch immediately shows Sent screenshot request")
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([reviewtab_dl], capture_receipt=false))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.capture_sheet_open), "known cap=2 subsequent snapshot never hijacks CaptureSheet")

  // (2) Legacy bare-array host (has_envelope=false -> cap=1):
  //     Immediate toast + pending==0, and ordinary download named "farview-capture-postcard.png" NEVER opens CaptureSheet!
  reset_downloads_tracker()
  set_host_downloads_state_from_pane(0, "[]")
  debug_assert(downloads_tracker.main_dl_cap == 1, "bare array sets cap=1")
  dispatch_capture_screenshot()
  t.frame(ms=16.0)
  debug_assert(downloads_tracker.main_pending_shot_req_ids.length() == 0, "cap=1 dispatch leaves pending==0")
  debug_assert(shell_adapter.passive.untracked().toast_title == "Sent screenshot request", "cap=1 dispatch shows Sent screenshot request")
  let postcard_json = "[{\"id\":\"dl-post-1\",\"filename\":\"farview-capture-postcard.png\",\"url\":\"https://alpha.local/postcard.png\",\"mime\":\"image/png\",\"bytes\":512,\"state\":\"completed\"}]"
  set_host_downloads_state_from_pane(0, postcard_json)
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "farview-capture-postcard.png", "bare-array downloads list updated")
  debug_assert(!shell_sig_is_true(app_state.capture_sheet_open), "farview-capture-postcard.png on cap=1 host MUST NEVER open CaptureSheet")

  test_reveal_file_hook.v = prev_reveal_hook
  test_file_exists_hook.v = prev_exists_hook
  test_host_addr_override.v = prev_host_override
  test_clipboard_read_hook.v = prev_clip_r
  test_clipboard_write_hook.v = prev_clip_w

  // 6. PDF write failure (`export_ok: false`) triggers Error ToastKind!
  downloads_tracker.main_pending_pdf_req_ids.push("pdf-fail-1")
  set_host_downloads_state_from_pane(
    0,
    proto::encode_downloads_envelope([], export_req_id="pdf-fail-1", export_ok=false),
  )
  t.frame(ms=16.0)
  debug_assert(shell_adapter.passive.untracked().toast_visible, "PDF fail showed toast")
  debug_assert(shell_adapter.passive.untracked().toast_title == "Failed to save PDF", "PDF fail toast message")
  debug_assert(shell_adapter.passive.untracked().toast_kind is shell_ui::ToastKind::Error, "PDF fail toast uses ToastKind::Error")
  debug_assert(t.find("Failed to save PDF").is_some(), "Error toast visible in production tree")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

test "phase2a_t2: real build_view single-click Pane B <input> unfocuses Omnibox, drops stale results, places caret & routes paste + CJK IME only to B" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let prev_demo_omni = app_state.demo_omnibox
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  app_state.demo_omnibox = ""
  let font_a = sn_build_probe_sfnt(600, "ProbeFontA")
  let font_b = sn_build_probe_sfnt(600, "ProbeFontB")
  let png_a = sn_minimal_png_1x1()
  let reset_a = sn_encode_reset_rich_doc("https://alpha.local", "ProbeFontA", "https://alpha.local/f.ttf", "https://alpha.local/i.png", "Alpha Doc", "alpha-keep")
  let reset_b = sn_encode_reset_rich_doc("https://beta.local", "ProbeFontB", "https://beta.local/f.ttf", "https://beta.local/i.png", "Beta Doc", "beta-target")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st_a.add_font(font_a)
  app_state.stage = Some(st_a)
  app_state.split_stage = None
  app_state.split_port = 1

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/doc", "Alpha Doc", false, false, false)))
    st_a.feed(proto::encode_host(proto::HostMsg::Asset("https://alpha.local/f.ttf", 1, 0.0, 0.0, font_a)))
    st_a.feed(proto::encode_host(proto::HostMsg::Asset("https://alpha.local/i.png", 0, 1.0, 1.0, png_a)))
    st_a.feed(reset_a)
  })
  t.frame(ms=16.0)

  open_split_view("https://beta.local/doc", "", focus_pane=0, quiet=true)
  let st_b = ensure_split_stage()
  st_b.add_font(font_b)
  t.frame(ms=16.0)
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.local/doc", "Beta Doc", false, false, false)))
    st_b.feed(proto::encode_host(proto::HostMsg::Asset("https://beta.local/f.ttf", 1, 0.0, 0.0, font_b)))
    st_b.feed(proto::encode_host(proto::HostMsg::Asset("https://beta.local/i.png", 0, 1.0, 1.0, png_a)))
    st_b.feed(reset_b)
  })
  // Pane B on the left half: the centered command palette covers the middle of the window, not B's <input>.
  shell_page_swap_panes()
  let mut fi = 0
  while fi < 8 {
    t.frame(ms=16.0)
    fi += 1
  }

  // 1. Focus Address Bar (`Cmd+L`), type "beta" -> Omnibox editing + suggestion dropdown open + in-flight req
  let cmd_mod = if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }
  t.key(ui::key_of_char('l'), mods=cmd_mod)
  t.frame(ms=16.0)
  let addr = match app_state.address_field { Some(f) => f; None => panic("address_field") }
  let omni_ed = match app_state.omnibox_editing { Some(s) => s; None => panic("omnibox_editing") }
  addr.set("beta")
  dispatch_omnibox_query("beta")
  let in_flight_rid = shell_adapter.omnibox_in_flight_req_id
  app_state.omni_suggest_items = [
    proto::OmniSuggestItem::{
      category: proto::OmniSuggestCategory::History,
      title: "Beta Suggestion",
      url: "https://beta.local/suggest",
      subtitle: "beta.local",
      badge_label: "History",
      section_title: "History",
      tab_id: "",
      visits: 3,
      score: 90.0,
    },
  ]
  match app_state.omnibox_open { Some(s) => s.set(true); None => () }
  match app_state.omnibox_rev { Some(r) => r.set(r.untracked() + 1); None => () }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::OmniboxSuggest, "omnibox")
  t.frame(ms=16.0)
  debug_assert(omni_ed.untracked() && shell_sig_is_true(app_state.omnibox_open), "Omnibox editing & dropdown open before clicking Pane B <input>")

  // 2. SINGLE click directly on Pane B's HTML <input> ("beta-target")!
  match t.find("beta-target") {
    Some((bx, by)) => {
      // The command palette is centered over the page column; Pane B sits on the left (swapped), so its
      // <input> is not under the palette and a person can click it directly.
      match t.get("Omnibox Suggestions") {
        Some(p) => debug_assert(bx < p.x || bx > p.x + p.w || by < p.y || by > p.y + p.h, "Pane B <input> is outside the palette")
        None => debug_assert(false, "Omnibox Suggestions palette is mounted while editing")
      }
      t.click(bx, by)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Pane B <input> 'beta-target' visible")
  }
  debug_assert(!shell_sig_is_true(app_state.omnibox_open), "single click on Pane B <input> closed Omnibox dropdown")
  debug_assert(!omni_ed.untracked() && !addr.focused(), "single click on Pane B <input> exited Omnibox editing & blurred address field")
  debug_assert(active_split_pane() == 1 && shell_page_focus_owner_pane() == 1, "single click activated Pane B")

  // 3. Late OmniboxResults for the old in-flight req MUST NOT reopen the dropdown!
  debug_assert(in_flight_rid != "", "captured non-empty omnibox in-flight req_id")
  let stale_env = proto::encode_omnibox_envelope(
    in_flight_rid,
    "[{\"url\":\"https://stale.test\",\"title\":\"Stale\",\"visits\":1,\"score\":10}]",
  )
  set_host_omnibox_results(stale_env)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.omnibox_open), "late OmniboxResults must NOT reopen closed dropdown")

  // 4. The VERY SAME single click placed caret in Pane B's <input>: paste & CJK IME modify ONLY B!
  match ui::focused_field_now() {
    Some(f_b) => {
      debug_assert(shell_field_belongs_to_pane(f_b, 1), "focused field belongs to Pane B on first click")
      f_b.pick(0, f_b.text().length())
      debug_assert(handle_ime_text(8, "pasted-B", 0, 0), "Cmd+V paste routed to Pane B <input>")
      t.frame(ms=16.0)
      debug_assert(f_b.text() == "pasted-B", "Pane B <input> received paste: got=" + f_b.text())
      f_b.pick(0, f_b.text().length())
      let _ = ui::view_text(1, "zhong")
      let _ = ui::view_text(0, "中")
      t.frame(ms=16.0)
      debug_assert(f_b.text() == "中", "Pane B <input> committed CJK IME '中': got=" + f_b.text())
      debug_assert(f_b.copy_selection() == "", "Pane B selection collapsed after IME commit")
      debug_assert(t.find("alpha-keep").is_some(), "Primary Pane A <input> stayed 'alpha-keep'")
    }
    None => debug_assert(false, "single click on Pane B <input> immediately placed caret in Pane B field")
  }

  // 5. Unswapped layout: Pane B back on the right, where the centered palette covers part of it.
  //    A click on the palette (over pane content) stays in the palette; a click on the page outside it dismisses it.
  shell_page_swap_panes()
  t.frame(ms=16.0)
  t.key(ui::key_of_char('l'), mods=cmd_mod)
  t.frame(ms=16.0)
  addr.set("beta")
  dispatch_omnibox_query("beta")
  app_state.omni_suggest_items = [
    proto::OmniSuggestItem::{
      category: proto::OmniSuggestCategory::History,
      title: "Beta Suggestion",
      url: "https://beta.local/suggest",
      subtitle: "beta.local",
      badge_label: "History",
      section_title: "History",
      tab_id: "",
      visits: 3,
      score: 90.0,
    },
  ]
  match app_state.omnibox_open { Some(s) => s.set(true); None => () }
  match app_state.omnibox_rev { Some(r) => r.set(r.untracked() + 1); None => () }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::OmniboxSuggest, "omnibox")
  let mut fj = 0
  while fj < 20 {
    t.frame(ms=16.0)
    fj += 1
  }
  debug_assert(omni_ed.untracked() && shell_sig_is_true(app_state.omnibox_open), "Omnibox reopened over the unswapped split")
  let pal = match t.get("Omnibox Suggestions") {
    Some(p) => p
    None => panic("Omnibox Suggestions palette missing in the unswapped layout")
  }
  // Pane B's <input> when it lies under the palette, else the palette's bottom rim (over pane content either way).
  let (ux, uy) = match t.find("beta-target") {
    Some((bx, by)) if bx >= pal.x && bx <= pal.x + pal.w && by >= pal.y && by <= pal.y + pal.h => (bx, by)
    _ => (pal.x + pal.w / 2.0, pal.y + pal.h - 4.0)
  }
  t.click(ux, uy)
  t.frame(ms=16.0)
  debug_assert(
    omni_ed.untracked() && shell_sig_is_true(app_state.omnibox_open),
    "a click on the palette keeps it open: at " + ux.to_string() + "," + uy.to_string() + " pal=" + pal.x.to_string() + "," +
    pal.y.to_string() + " " + pal.w.to_string() + "x" + pal.h.to_string() + " ed=" + omni_ed.untracked().to_string() + " open=" +
    shell_sig_is_true(app_state.omnibox_open).to_string() + " pane=" + shell_page_focus_owner_pane().to_string(),
  )
  match ui::focused_field_now() {
    Some(f) => debug_assert(!shell_field_belongs_to_pane(f, 0) && !shell_field_belongs_to_pane(f, 1), "a click on the palette never reaches the page under it")
    None => ()
  }
  // The page outside the palette: left of it and below it, on Pane A.
  t.click(pal.x - 40.0, pal.y + pal.h + 80.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.omnibox_open) && !omni_ed.untracked(), "a click on the page outside the palette dismisses it")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  app_state.demo_omnibox = prev_demo_omni
  shell_adapter_reset()
}

test "phase2a_t3: CommandBar->Settings focus handoff, TabSearch cross-Space switch & reopen, StartPage & FindBar" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_ws = app_state.workspace
  let prev_closed = app_state.closed_tabs_snap
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/home", "Alpha Home", false, false, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  ensure_demo_tab_search_seeded()
  t.frame(ms=16.0)

  // 1. Cmd+K -> type "settings" -> Enter hands off cleanly to Settings (focus stays in Settings, NOT Stage!)
  let cmd_mod = if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }
  debug_assert(handle_app_key(1000 + 0x6B, cmd_mod, false), "Cmd+K opens CommandBar")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.command_bar_open), "CommandBar open")
  debug_assert(shell_adapter.exclusive.untracked().tag == "command_bar", "exact tag 'command_bar'")
  refresh_command_bar_items("settings")
  t.frame(ms=16.0)
  let mut found_settings = false
  for it in app_state.command_bar_items {
    if it.id == "open_settings" {
      execute_command_bar_item(st, it)
      found_settings = true
      break
    }
  }
  t.frame(ms=16.0)
  debug_assert(found_settings, "CommandBar had open_settings item")
  debug_assert(!shell_sig_is_true(app_state.command_bar_open), "CommandBar closed after handoff")
  debug_assert(shell_sig_is_true(app_state.settings_open), "Settings opened via CommandBar")
  debug_assert(shell_adapter.exclusive.untracked().tag == "settings", "Settings owns Exclusive slot")
  debug_assert(shell_page_focus_owner_pane() == -1, "focus stays in Settings, not leaked to Stage")

  // Esc closes Settings (last layer) -> next key immediately reaches active real Stage!
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Esc closes Settings")
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.settings_open), "Settings closed")
  debug_assert(shell_page_focus_owner_pane() == 0, "closing last layer returned focus to active real Stage")

  // 2. Cmd+Shift+A TabSearch: cross-Space switch & reopen closed tab
  open_tab_search()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.tab_search_open) && shell_adapter.exclusive.untracked().tag == "tab_search", "TabSearch opened with exact tag")
  let res = current_tab_search_results_untracked()
  debug_assert(res.open_items.length() >= 4 && res.closed_items.length() >= 2, "TabSearch has cross-space open & closed items")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let mut switched = false
  for it in res.open_items {
    if it.id == "tab-ds" {
      activate_tab_search_item(it)
      switched = true
      break
    }
  }
  t.frame(ms=16.0)
  debug_assert(switched && !shell_sig_is_true(app_state.tab_search_open), "TabSearch switched to cross-space tab and closed")
  let _ = io_rt.main_conn.flush_write()
  let exp_sw = bytes_to_hex(wire::encode(wire::Message::Act("tab_switch", "tab-ds", "")))
  let sw_wire = sn_read_until_hex(acc_m, exp_sw)
  debug_assert(sw_wire.contains(exp_sw), "tab_switch wire sent for cross-space tab")

  // Reopen recently closed tab via TabSearch
  open_tab_search()
  t.frame(ms=16.0)
  let res2 = current_tab_search_results_untracked()
  activate_tab_search_item(res2.closed_items[0])
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let exp_re = bytes_to_hex(wire::encode(wire::Message::Act("tab_reopen_at", "0", "")))
  let re_wire = sn_read_until_hex(acc_m, exp_re)
  debug_assert(re_wire.contains(exp_re), "tab_reopen_at wire sent for closed tab")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.workspace = prev_ws
  app_state.closed_tabs_snap = prev_closed
  shell_adapter_reset()
}

fn sn_node_in_subtree(tree : view::Tree, ancestor : view::NodeId, target : view::NodeId) -> Bool {
  let mut cur = target.at
  let mut steps = 0
  while cur >= 0 && cur < tree.nodes.length() && steps < 256 {
    if cur == ancestor.at {
      return true
    }
    cur = tree.nodes[cur].parent
    steps += 1
  }
  false
}

test "phase2a_t4: CommandBar & TabSearch IME first-Esc guard and modal Tab/Shift+Tab focus trap" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_ws = app_state.workspace
  let prev_closed = app_state.closed_tabs_snap
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/home", "Alpha Home", false, false, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  ensure_demo_tab_search_seeded()
  t.frame(ms=16.0)
  let rv = match app_state.root_view { Some(v) => v; None => panic("root_view") }
  let cmd_mod = if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }

  // 1. CommandBar: IME double-Esc (1st Esc cancels preedit & preserves query/panel; 2nd Esc IMMEDIATELY closes & returns focus to Stage!)
  debug_assert(handle_app_key(1000 + 0x6B, cmd_mod, false), "Cmd+K opens CommandBar")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.command_bar_open), "CommandBar open")
  let cb_f = match app_state.command_bar_field { Some(f) => f; None => panic("command_bar_field") }
  cb_f.set("abc")
  t.frame(ms=16.0)
  let _ = ui::view_text(1, "zhong")
  t.frame(ms=16.0)
  debug_assert(cb_f.composing() && cb_f.text() == "abc", "CommandBar field is composing preedit over 'abc'")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.command_bar_open), "1st Esc during CommandBar IME keeps panel open")
  debug_assert(!cb_f.composing() && cb_f.text() == "abc", "1st Esc cancelled preedit and preserved query 'abc'")
  // 2nd Esc directly (NO view_text(0) commit in between!) MUST close CommandBar & return focus to Stage
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.command_bar_open), "2nd Esc immediately closes CommandBar")
  debug_assert(shell_page_focus_owner_pane() == 0, "Esc returned focus to active Stage")

  // 2. CommandBar: inside-card blank click stays open, outside click (30, 690) closes once with 0 page leak, + 12x Tab/Shift+Tab trap
  debug_assert(handle_app_key(1000 + 0x6B, cmd_mod, false), "Cmd+K re-opens CommandBar")
  t.frame(ms=16.0)
  let cb_box = match t.get("Command Bar") { Some(b) => b; None => panic("Command Bar dialog missing") }
  let cb_dlg = cb_box.id
  // Click blank corner inside CommandBar card -> stays open
  t.click(cb_box.x + 8.0, cb_box.y + 8.0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.command_bar_open), "clicking blank area inside CommandBar keeps it open")

  let sb_btn = match t.get("Toggle Sidebar") { Some(b) => Some(b.id); None => None }
  let mut ti = 0
  while ti < 12 {
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    match rv.tree.focused {
      Some(fid) => {
        debug_assert(sn_node_in_subtree(rv.tree, cb_dlg, fid), "CommandBar Tab #" + ti.to_string() + " stayed inside modal dialog")
        match sb_btn {
          Some(sbid) => debug_assert(fid != sbid, "CommandBar Tab never reached Toggle Sidebar")
          None => ()
        }
      }
      None => debug_assert(false, "CommandBar Tab #" + ti.to_string() + " kept valid focus")
    }
    ti += 1
  }
  let mut si = 0
  while si < 12 {
    t.key(proto::KEY_TAB, mods=proto::SHORTCUT_MOD_SHIFT)
    t.frame(ms=16.0)
    match rv.tree.focused {
      Some(fid) => debug_assert(sn_node_in_subtree(rv.tree, cb_dlg, fid), "CommandBar Shift+Tab #" + si.to_string() + " stayed inside modal dialog")
      None => debug_assert(false, "CommandBar Shift+Tab #" + si.to_string() + " kept valid focus")
    }
    si += 1
  }
  // Click outside backdrop (30, 690) -> closes CommandBar once with 0 bytes leaked to underlying webpage!
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.click(30.0, 690.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.command_bar_open), "outside click (30, 690) closed CommandBar")
  let _ = io_rt.main_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "CommandBar outside click leaked 0 pointer bytes to underlying page")

  // 3. TabSearch: IME double-Esc (1st Esc cancels preedit & preserves query/panel; 2nd Esc IMMEDIATELY closes & returns focus to Stage!)
  open_tab_search()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.tab_search_open), "TabSearch open")
  let ts_f = match app_state.tab_search_field { Some(f) => f; None => panic("tab_search_field") }
  ts_f.set("abc")
  t.frame(ms=16.0)
  let _ = ui::view_text(1, "zhong")
  t.frame(ms=16.0)
  debug_assert(ts_f.composing() && ts_f.text() == "abc", "TabSearch field is composing preedit over 'abc'")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.tab_search_open), "1st Esc during TabSearch IME keeps panel open")
  debug_assert(!ts_f.composing() && ts_f.text() == "abc", "1st Esc cancelled TabSearch preedit and preserved query 'abc'")
  // 2nd Esc directly (NO view_text(0) commit in between!) MUST close TabSearch & return focus to Stage
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.tab_search_open), "2nd Esc immediately closes TabSearch")
  debug_assert(shell_page_focus_owner_pane() == 0, "TabSearch Esc returned focus to Stage")

  // 4. TabSearch: inside-card blank click stays open, outside click (30, 690) closes once with 0 page leak, + 12x Tab/Shift+Tab trap
  open_tab_search()
  t.frame(ms=16.0)
  let ts_box = match t.get("Tab Search") { Some(b) => b; None => panic("Tab Search dialog missing") }
  let ts_dlg = ts_box.id
  t.click(ts_box.x + 8.0, ts_box.y + 8.0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.tab_search_open), "clicking blank area inside TabSearch keeps it open")

  let mut t2 = 0
  while t2 < 12 {
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    match rv.tree.focused {
      Some(fid) => {
        debug_assert(sn_node_in_subtree(rv.tree, ts_dlg, fid), "TabSearch Tab #" + t2.to_string() + " stayed inside modal dialog")
        match sb_btn {
          Some(sbid) => debug_assert(fid != sbid, "TabSearch Tab never reached Toggle Sidebar")
          None => ()
        }
      }
      None => debug_assert(false, "TabSearch Tab #" + t2.to_string() + " kept valid focus")
    }
    t2 += 1
  }
  let mut s2 = 0
  while s2 < 12 {
    t.key(proto::KEY_TAB, mods=proto::SHORTCUT_MOD_SHIFT)
    t.frame(ms=16.0)
    match rv.tree.focused {
      Some(fid) => debug_assert(sn_node_in_subtree(rv.tree, ts_dlg, fid), "TabSearch Shift+Tab #" + s2.to_string() + " stayed inside modal dialog")
      None => debug_assert(false, "TabSearch Shift+Tab #" + s2.to_string() + " kept valid focus")
    }
    s2 += 1
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.click(30.0, 690.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.tab_search_open), "outside click (30, 690) closed TabSearch")
  let _ = io_rt.main_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "TabSearch outside click leaked 0 pointer bytes to underlying page")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.workspace = prev_ws
  app_state.closed_tabs_snap = prev_closed
  shell_adapter_reset()
}

test "phase2a_t5: StartPage quick-action pills stay within viewport at 1280, 760, and 480 and all 5 click cleanly at 480" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_sp = app_state.initial_start_page_open
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  app_state.stage = Some(st)
  app_state.initial_start_page_open = true

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  t.frame(ms=16.0)

  let labels = ["Bookmarks", "History", "Settings", "Reader", "DevTools"]
  let widths : Array[Double] = [1280.0, 760.0, 480.0]
  let mut wi = 0
  while wi < widths.length() {
    let w = widths[wi]
    t.resize(w, 800.0)
    t.frame(ms=16.0)
    t.frame(ms=16.0)
    let mut li = 0
    while li < labels.length() {
      let lbl = labels[li]
      match t.get(lbl) {
        Some(box) => {
          debug_assert(
            box.x >= -0.5 && box.x + box.w <= w + 0.5 && box.y >= -0.5 && box.y + box.h <= 800.5,
            "StartPage pill '" + lbl + "' clipped at width=" + w.to_string() + ": x=" + box.x.to_string() + " w=" + box.w.to_string(),
          )
        }
        None => debug_assert(false, "StartPage pill '" + lbl + "' missing at width=" + w.to_string())
      }
      li += 1
    }
    wi += 1
  }

  // At 480x800, click all 5 quick-action pills and verify each dispatches its action!
  t.press("Bookmarks")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.bookmarks_open), "480pt StartPage Bookmarks pill opened Bookmarks")
  close_bookmarks()
  t.frame(ms=16.0)

  t.press("History")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.history_open), "480pt StartPage History pill opened History")
  close_history()
  t.frame(ms=16.0)

  t.press("Settings")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.settings_open), "480pt StartPage Settings pill opened Settings")
  close_settings()
  t.frame(ms=16.0)

  t.press("Reader")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.reader_open), "480pt StartPage Reader pill toggled Reader")
  toggle_reader_mode()
  t.frame(ms=16.0)

  t.press("DevTools")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.devtools_open), "480pt StartPage DevTools pill opened DevTools")
  toggle_devtools()
  t.frame(ms=16.0)

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.initial_start_page_open = prev_sp
  shell_adapter_reset()
}

test "phase2b_t1: split A/B distinct origins SiteInfo permission routing (split_conn only, 0 bytes main_conn, auto-close on pane switch)" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_perms = app_state.site_perms_snap
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://beta.example/settings", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // Open SiteInfo while active pane is B (`https://beta.example`)
  toggle_site_info()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.site_info_open), "SiteInfo opened on pane B")
  debug_assert(shell_adapter.site_info_owner_pane == 1, "SiteInfo locked owner_pane=1")
  debug_assert(shell_adapter.site_info_committed_origin == "https://beta.example", "SiteInfo locked committed_origin=https://beta.example")

  // Drain any initial sync frames before toggling permission
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)

  // Open the Camera row's picker inside Site controls and choose Allow
  t.press("Change Camera Permission")
  t.frame(ms=16.0)
  t.press("Camera Allow")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()

  let main_bytes = sn_read_all_available(acc_m, 0)
  debug_assert(main_bytes.length() == 0, "main_conn received 0 bytes when modifying pane B SiteInfo permission")
  let exp_perm_hex = bytes_to_hex(wire::encode(wire::Message::Act("site_perm_set", "https://beta.example|camera", "allow")))
  let split_hex = sn_read_until_hex(acc_s, exp_perm_hex)
  debug_assert(split_hex.contains(exp_perm_hex), "split_conn received site_perm_set for https://beta.example|camera=allow")

  // Switching active pane back to A auto-closes SiteInfo
  set_active_split_pane(0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.site_info_open), "switching active pane A<->B auto-closes SiteInfo")

  // Re-open on B, then navigate B to another origin -> auto-closes SiteInfo
  set_active_split_pane(1)
  t.frame(ms=16.0)
  toggle_site_info()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.site_info_open), "SiteInfo re-opened on pane B")
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://gamma.example/next", "Gamma", false, true, false)))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.site_info_open), "navigating bound pane B to new origin auto-closes SiteInfo")

  // Opening SiteInfo on about:blank and then navigating to https://example.com must auto-close SiteInfo
  set_active_split_pane(0)
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("about:blank", "Blank", false, false, false)))
  t.frame(ms=16.0)
  toggle_site_info()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.site_info_open), "SiteInfo opened on about:blank")
  debug_assert(shell_adapter.site_info_committed_origin == "about:blank", "SiteInfo locked on about:blank")
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://example.com/", "Example", false, false, false)))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.site_info_open), "navigating from about:blank to https://example.com auto-closes SiteInfo")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.site_perms_snap = prev_perms
  shell_adapter_reset()
}

test "phase2b_t2: 1280/760/480 dynamic anchor placement & zero-clipping probe across all Phase 2B overlays" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_idn = app_state.demo_idn_url
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://docs.example/guide", "Guide", false, false, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  t.frame(ms=16.0)

  let assert_overlay_in_bounds = fn(label : String, vw : Double, vh : Double, ctx : String) -> Unit {
    match t.get(label) {
      Some(b) => {
        debug_assert(
          b.x >= -0.5 && b.x + b.w <= vw + 0.5 && b.y >= -0.5 && b.y + b.h <= vh + 0.5,
          "\{ctx} (\{label}) clipped at \{vw}x\{vh}: x=\{b.x} y=\{b.y} w=\{b.w} h=\{b.h}",
        )
      }
      None => debug_assert(false, "\{ctx} (\{label}) not found at \{vw}x\{vh}")
    }
  }

  let widths : Array[Double] = [1280.0, 760.0, 480.0]
  let mut wi = 0
  while wi < widths.length() {
    let vw = widths[wi]
    t.resize(vw, 800.0)
    t.frame(ms=16.0)
    t.frame(ms=16.0)

    // SiteInfo
    toggle_site_info()
    t.frame(ms=16.0)
    assert_overlay_in_bounds("Site Controls", vw, 800.0, "SiteInfo")
    close_site_info()
    t.frame(ms=16.0)

    // Downloads Popover
    toggle_downloads()
    t.frame(ms=16.0)
    assert_overlay_in_bounds("Downloads", vw, 800.0, "Downloads")
    close_downloads()
    t.frame(ms=16.0)

    // Zoom Popover
    open_zoom_popover()
    t.frame(ms=16.0)
    assert_overlay_in_bounds("Page Zoom Controls", vw, 800.0, "Zoom")
    close_zoom_popover()
    t.frame(ms=16.0)

    // Media Hub
    open_media_hub()
    t.frame(ms=16.0)
    assert_overlay_in_bounds("Media Controls", vw, 800.0, "MediaHub")
    close_media_hub()
    t.frame(ms=16.0)

    // Shortcuts Modal
    toggle_shortcuts()
    t.frame(ms=16.0)
    assert_overlay_in_bounds("Keyboard Shortcuts", vw, 800.0, "Shortcuts")
    close_shortcuts()
    t.frame(ms=16.0)

    // Bookmarks Bar
    if !shell_sig_is_true(app_state.bookmarks_bar_open) {
      toggle_bookmarks_bar()
    }
    t.frame(ms=16.0)
    assert_overlay_in_bounds("Bookmarks Bar", vw, 800.0, "BookmarksBar")
    toggle_bookmarks_bar()
    t.frame(ms=16.0)

    wi += 1
  }

  // IDNA Spoof Popover at 480pt
  app_state.demo_idn_url = "https://xn--pple-43d.com/"
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  toggle_idn_popover()
  t.frame(ms=16.0)
  assert_overlay_in_bounds("Lookalike Domain Warning", 480.0, 800.0, "IDNA")
  close_idn_popover()
  t.frame(ms=16.0)

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.demo_idn_url = prev_idn
  shell_adapter_reset()
}

test "phase2b_t3: ShortcutsModal Tab/Shift+Tab trap & outside click zero leak + TabFilter IME double-Esc + NavHistory/PageCtx dismiss" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://docs.example/shortcuts", "Shortcuts Test", false, true, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let rv = match app_state.root_view { Some(v) => v; None => panic("root_view missing") }

  // 1. ShortcutsModal: inside-card blank click stays open, Tab/Shift+Tab stays inside dialog, outside click (30, 690) closes once with 0 webpage bytes!
  toggle_shortcuts()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.shortcuts_open), "ShortcutsModal opened")
  let sc_box = match t.get("Keyboard Shortcuts") { Some(b) => b; None => panic("Keyboard Shortcuts dialog missing") }
  let sc_dlg = sc_box.id
  t.click(sc_box.x + 8.0, sc_box.y + 8.0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.shortcuts_open), "clicking blank area inside ShortcutsModal keeps it open")
  let mut ti = 0
  while ti < 6 {
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    match rv.tree.focused {
      Some(fid) => debug_assert(sn_node_in_subtree(rv.tree, sc_dlg, fid), "ShortcutsModal Tab trapped inside modal dialog")
      None => debug_assert(false, "ShortcutsModal Tab kept valid focus")
    }
    ti += 1
  }
  let mut bi = 0
  while bi < 6 {
    t.key(proto::KEY_TAB, mods=proto::SHORTCUT_MOD_SHIFT)
    t.frame(ms=16.0)
    match rv.tree.focused {
      Some(fid) => debug_assert(sn_node_in_subtree(rv.tree, sc_dlg, fid), "ShortcutsModal Shift+Tab trapped inside modal dialog")
      None => debug_assert(false, "ShortcutsModal Shift+Tab kept valid focus")
    }
    bi += 1
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.click(30.0, 690.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.shortcuts_open), "outside click (30, 690) closed ShortcutsModal")
  let _ = io_rt.main_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "ShortcutsModal outside click leaked 0 bytes to webpage")

  // 2. TabFilter IME double-Esc: 1st Esc cancels preedit & preserves query, 2nd Esc closes & refocuses pane
  open_tab_filter("arch")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.tab_filter_open), "TabFilter opened")
  match app_state.tab_filter_field {
    Some(f) => {
      f.focus()
      t.frame(ms=16.0)
      let _ = ui::view_text(1, "nihao")
      t.frame(ms=16.0)
      debug_assert(f.focused() && f.composing() && f.text() == "arch", "TabFilter field focused & composing preedit over 'arch'")
      t.key(ui::key_escape, mods=0)
      t.frame(ms=16.0)
      debug_assert(shell_sig_is_true(app_state.tab_filter_open), "1st Esc during IME keeps TabFilter open")
      debug_assert(!f.composing(), "1st Esc cancels IME preedit via compose(\"\")")
      debug_assert(f.text() == "arch", "1st Esc preserves original query 'arch'")
      t.key(ui::key_escape, mods=0)
      t.frame(ms=16.0)
      debug_assert(!shell_sig_is_true(app_state.tab_filter_open), "2nd Esc closes TabFilter")
    }
    None => debug_assert(false, "tab_filter_field missing")
  }

  // 3. PageContextMenu outside click & Esc dismiss with 0 webpage leak
  open_page_ctx(st, stage::MenuHit::{ x: 400.0, y: 260.0, link: "https://example.org/p" })
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.page_ctx_open), "PageContextMenu opened")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.click(30.0, 690.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.page_ctx_open), "PageContextMenu outside click closes cleanly")
  let _ = io_rt.main_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "PageContextMenu outside click leaked 0 bytes")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  shell_adapter_reset()
}

test "phase2b_r1: SiteInfo sync routed strictly to pane B + authoritative secondary permissions + late A frame isolation + disconnect dismiss" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_perms = app_state.site_perms_snap
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://beta.example/settings", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)

  // 1. Opening SiteInfo on B sends site_perms_sync + cookies_sync ONLY to split_conn (0 to main_conn)
  toggle_site_info()
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let a_hex = bytes_to_hex(sn_read_all_available(acc_m, 0))
  let b_hex = bytes_to_hex(sn_read_all_available(acc_s, 0))
  let sync_hex = bytes_to_hex(wire::encode(wire::Message::Act("site_perms_sync", "", "")))
  debug_assert(!a_hex.contains(sync_hex) && b_hex.contains(sync_hex), "B SiteInfo requests site_perms_sync only from B")

  // 2. Authoritative secondary SitePermissionsState updates B; late A frame with different value does NOT contaminate B
  let rule_b = proto::SitePermissionRule::{ origin: "https://beta.example", camera: "block", microphone: "ask", notifications: "ask", geolocation: "ask", clipboard: "ask" }
  let data_b = proto::encode_site_permissions_snapshot(proto::SitePermissionsSnapshot::{ rules: [rule_b] })
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SitePermissionsState(data_b))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  debug_assert(active_site_permission_rule("https://beta.example").camera == "block", "B explicit Block from split socket reflected immediately")

  let rule_a_late = proto::SitePermissionRule::{ origin: "https://beta.example", camera: "allow", microphone: "ask", notifications: "ask", geolocation: "ask", clipboard: "ask" }
  let data_a_late = proto::encode_site_permissions_snapshot(proto::SitePermissionsSnapshot::{ rules: [rule_a_late] })
  let _ = dispatch_incoming_chunks_budgeted_at([wire::encode(wire::Message::SitePermissionsState(data_a_late))], st_a, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  debug_assert(active_site_permission_rule("https://beta.example").camera == "block", "late A permission frame must NOT contaminate B SiteInfo")

  // 3. Disconnecting split_conn auto-closes B's SiteInfo
  disconnect_split_conn(reconnect=false)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.site_info_open), "SiteInfo for B closed when split_conn disconnected")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.site_perms_snap = prev_perms
  shell_adapter_reset()
}

test "phase2b_r2: IDNA closes and releases exclusive tag on safe navigation + Downloads cross-host unique row action" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://xn--pple-43d.com/", "IDN", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  t.frame(ms=16.0)

  // 1. IDNA warning opens, then safe navigation closes it AND releases exclusive tag (no zombie Esc trap)
  t.press("IDN Spoofing Warning")
  t.frame(ms=16.0)
  debug_assert(t.get("Lookalike Domain Warning").is_some(), "IDNA warning mounted")
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://docs.example/safe", "Safe", false, false, false)))
  t.frame(ms=16.0)
  debug_assert(t.get("Lookalike Domain Warning").is_none(), "IDNA warning disappeared on safe nav")
  debug_assert(!shell_sig_is_true(app_state.idn_popover_open) && shell_adapter.exclusive.untracked().tag != "idn_popover", "IDNA exclusive tag cleanly released")

  // Re-entering spoof URL lets IDNA open cleanly again on first click
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://xn--pple-43d.com/", "IDN2", false, false, false)))
  t.frame(ms=16.0)
  t.press("IDN Spoofing Warning")
  t.frame(ms=16.0)
  debug_assert(t.get("Lookalike Domain Warning").is_some(), "IDNA warning re-opens cleanly")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.idn_popover_open), "single Esc closes IDNA cleanly")

  // 2. Downloads colliding id="1" from main & split hosts routes Copy Path / Reveal to exact clicked row
  open_split_view("https://beta.example/settings", "", focus_pane=1)
  t.frame(ms=16.0)
  let clipboard = ui::ref_new("")
  let revealed = ui::ref_new("")
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { clipboard.v = s })
  test_file_exists_hook.v = Some(fn(_s : String) -> Bool { true })
  test_reveal_file_hook.v = Some(fn(s : String) -> Bool { revealed.v = s; true })
  let a = proto::DownloadSummary::{ id: "1", filename: "review-alpha.pdf", url: "https://alpha.example/a", path: "/tmp/review-alpha.pdf", bytes: 50L, state: "completed", mime: "application/pdf" }
  let b = proto::DownloadSummary::{ ..a, filename: "review-beta.pdf", url: "https://beta.example/b", path: "/tmp/review-beta.pdf" }
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([a], capture_receipt=true))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([b], capture_receipt=true))
  toggle_downloads()
  t.frame(ms=16.0)
  match app_state.downloads_field { Some(f) => f.set("review-alpha"); None => panic("downloads_field missing") }
  t.frame(ms=16.0)
  t.press("Copy path")
  t.frame(ms=16.0)
  t.press("Reveal")
  t.frame(ms=16.0)
  debug_assert(clipboard.v == a.path && revealed.v == a.path, "filtered Alpha row Copy/Reveal hit exact Alpha path")

  test_clipboard_write_hook.v = None
  test_file_exists_hook.v = None
  test_reveal_file_hook.v = None
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  shell_adapter_reset()
}

test "phase2b_r3: open Downloads resize follow, MediaHub Mute all, PageCtx image+selection, TabCtx folders, FolderCtx color, MRU focus, Downloads IME double-Esc" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_media = app_state.media_hub_snap
  let prev_dl = app_state.downloads
  let prev_ws = app_state.workspace
  let old_main = io_rt.main_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://docs.example/shortcuts", "Shortcuts Test", false, true, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let rv = match app_state.root_view { Some(v) => v; None => panic("root_view missing") }

  // One download, so the popover has its search field (an empty list shows its empty state alone).
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([
    proto::DownloadSummary::{ id: "r3-doc", filename: "doc.pdf", url: "https://docs.example/doc.pdf", mime: "application/pdf", bytes: 1024L, state: "completed", path: "" },
  ]))
  // 1. Open Downloads follows live 1280 -> 480 window resize cleanly inside 0..480
  toggle_downloads()
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let dl_box = match t.get("Downloads") { Some(b) => b; None => panic("missing downloads") }
  debug_assert(dl_box.x >= 0.0 && dl_box.x + dl_box.w <= 480.5, "open Downloads followed resize to 480")
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  t.frame(ms=16.0)

  // 2. Downloads natural click + IME double-Esc returns focus to Stage
  let dl_b2 = match t.get("Search Downloads") { Some(b) => b; None => panic("missing downloads search 1280") }
  t.click(dl_b2.x + dl_b2.w / 2.0, dl_b2.y + dl_b2.h / 2.0)
  t.frame(ms=16.0)
  let dl_f = match app_state.downloads_field { Some(f) => f; None => panic("missing field") }
  debug_assert(dl_f.focused(), "downloads search focused")
  t.type_text("doc")
  ui::view_text(1, "zhong")
  t.frame(ms=16.0)
  debug_assert(dl_f.composing(), "downloads IME preedit active")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!dl_f.composing() && dl_f.text() == "doc" && shell_sig_is_true(app_state.downloads_open), "1st Esc cancelled IME only")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.downloads_open) && shell_page_focus_owner_pane() == 0, "2nd Esc closed Downloads & refocused Stage")

  // 3. MediaHub shows "Mute all" with playing session
  app_state.media_hub_snap = proto::MediaHubSnapshot::{
    sessions: [proto::MediaSessionItem::{ tab_id: "1", title: "Playing review", playing: true, muted: false, artist_or_host: "Alpha", url: "https://alpha.test", is_live_call: false, duration_secs: 90, position_secs: 2 }],
  }
  open_media_hub()
  t.frame(ms=16.0)
  debug_assert(t.get("Media Controls").is_some() && t.get("Mute all").is_some(), "MediaHub shows Mute all")
  close_media_hub()
  t.frame(ms=16.0)

  // 4. PageContextMenu preserves MenuHit image + selection
  open_page_ctx(st, stage::MenuHit::{ x: 400.0, y: 260.0, link: "", image: "https://example.org/a.png", selection: "selected review text", can_back: false, can_forward: false })
  t.frame(ms=16.0)
  debug_assert(t.get("Copy Image URL").is_some() && t.get("Copy Selection").is_some(), "PageCtx renders image + selection items")
  close_page_ctx()
  t.frame(ms=16.0)

  // 5. TabCtx folder move + live sidebar drag repositioning + FolderCtx color palette
  ensure_demo_tab_search_seeded()
  let sid = app_state.workspace.active_space_id
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..app_state.workspace,
    folders: [proto::FolderSummary::{ id: "fld-demo", space_id: sid, name: "Reading", color: "#2563EB", collapsed: false }],
  }
  match app_state.workspace_rev { Some(r) => r.set(r.untracked() + 1); None => () }
  set_sidebar_open(true)
  t.frame(ms=16.0)
  open_tab_ctx(app_state.workspace.tabs[0].id, 180.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Move to Reading").is_some(), "TabCtx exposes Move to Folder")
  let tc1 = match t.get("Tab Context Menu") { Some(b) => b; None => panic("TabCtx missing") }
  let cur_dock = shell_adapter.dock.untracked()
  shell_adapter.dock.set(shell_ui::DockState::{ ..cur_dock, sidebar_width: 310.0 })
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let tc2 = match t.get("Tab Context Menu") { Some(b) => b; None => panic("TabCtx missing after drag") }
  debug_assert(tc2.x > tc1.x + 20.0, "TabCtx tracks live sidebar width drag")
  close_tab_ctx()
  t.frame(ms=16.0)

  open_folder_ctx("fld-demo", 180.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Folder Color #2563EB").is_some(), "FolderCtx exposes folder color palette")
  close_folder_ctx()
  t.frame(ms=16.0)

  // 6. MRU modal Tab/Shift+Tab focus trap + outside click dismiss
  open_or_step_mru_switcher(1)
  t.frame(ms=16.0)
  let mru_box = match t.get("Quick Tab Switch") { Some(b) => b; None => panic("MRU missing") }
  for mod in [0, proto::SHORTCUT_MOD_SHIFT] {
    let mut i = 0
    while i < 12 {
      t.key(proto::KEY_TAB, mods=mod)
      t.frame(ms=16.0)
      match rv.tree.focused { Some(fid) => debug_assert(sn_node_in_subtree(rv.tree, mru_box.id, fid), "MRU focus stayed in dialog"); None => panic("MRU unfocused") }
      i += 1
    }
  }
  t.click(1100.0, 690.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.mru_open), "MRU outside click dismissed")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.downloads = prev_dl
  app_state.media_hub_snap = prev_media
  app_state.workspace = prev_ws
  shell_adapter_reset()
}

test "phase2b_r4: Cookies Inspector from B displays B, ignores late A, clears only B, closes on B disconnect + Downloads preserves identical records across panes" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_perms = app_state.site_perms_snap
  let prev_cookies = app_state.cookies_snap
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://beta.example/settings", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. Cookies Inspector opened from pane B displays B, ignores late A frame, clears ONLY B (0 bytes to A)
  toggle_site_info()
  t.frame(ms=16.0)
  t.press("Inspect Site Cookies")
  t.frame(ms=16.0)
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"beta.example\", \"origin\": \"https://beta.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"beta_session\", \"domain\": \"beta.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  let _ = dispatch_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"alpha.example\", \"origin\": \"https://alpha.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"alpha_session\", \"domain\": \"alpha.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_a, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.cookies_open) && t.get("Clear Site Cookies").is_some(), "Cookies Inspector open")
  let visible_a = t.get("Cookie alpha_session").is_some()
  let visible_b = t.get("Cookie beta_session").is_some()
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  let bounds = match t.get("Clear Site Cookies") { Some(v) => v; None => panic("missing Clear Site Cookies") }
  let rv = match app_state.root_view { Some(v) => v; None => panic("root_view missing") }
  debug_assert(rv.tree.focus_to(Some(bounds.id), visible=true), "Clear Site Cookies focusable")
  t.key(proto::KEY_ENTER)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let wrong = bytes_to_hex(wire::encode(wire::Message::Act("cookies_clear_site", "alpha.example", "")))
  let wanted = bytes_to_hex(wire::encode(wire::Message::Act("cookies_clear_site", "beta.example", "")))
  let a_hex = sn_read_until_hex(acc_m, wrong, max_wait_ms=50)
  let b_hex = sn_read_until_hex(acc_s, wanted, max_wait_ms=50)
  debug_assert(visible_b && !visible_a && b_hex.contains(wanted) && !a_hex.contains(wrong), "B Cookies Inspector isolated & clears only B")

  // Disconnecting split_conn closes B's Cookies Inspector
  disconnect_split_conn(reconnect=false)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.cookies_open), "B Cookies Inspector closes on split_conn disconnect")

  // 2. Identical record IDs & URLs with empty path from two separate hosts stay 2 distinct merged rows
  let a = proto::DownloadSummary::{ id: "1", filename: "report.pdf", url: "https://files.example/report.pdf", path: "", bytes: 64L, state: "failed", mime: "application/pdf" }
  let b = proto::DownloadSummary::{ ..a, bytes: 2048L, state: "completed" }
  let _ = dispatch_incoming_chunks_budgeted_at([wire::encode(wire::Message::DownloadsState(proto::encode_downloads_state([a])))], st_a, 1000.0, fn() { 0.0 })
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::DownloadsState(proto::encode_downloads_state([b])))], st_b, 1000.0, fn() { 0.0 })
  toggle_downloads()
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 2 && shell_adapter.download_row_keys.length() == 2, "identical id/url/filename across panes preserved as 2 distinct rows")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.site_perms_snap = prev_perms
  app_state.cookies_snap = prev_cookies
  shell_adapter_reset()
}

test "phase2b_r5: Cookies Inspector strict committed_host isolation (no stale cache, drops foreign broadcast, closes nested on navigation)" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_perms = app_state.site_perms_snap
  let prev_cookies = app_state.cookies_snap
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://previous.example/home", "Previous", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://previous.example/home", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. Cached snapshot from previous.example must NOT appear or be cleared when opening Cookies on beta.example
  toggle_site_info()
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"previous.example\", \"origin\": \"https://previous.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"previous_session\", \"domain\": \"previous.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  close_site_info()
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  t.frame(ms=16.0)
  toggle_site_info()
  t.frame(ms=16.0)
  t.press("Inspect Site Cookies")
  t.frame(ms=16.0)
  debug_assert(t.get("Cookie previous_session").is_none(), "stale previous.example cookie must not render for beta.example")
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  match t.get("Clear Site Cookies") {
    Some(button) => {
      let rv = match app_state.root_view { Some(v) => v; None => panic("root") }
      if rv.tree.focus_to(Some(button.id), visible=true) {
        t.key(proto::KEY_ENTER)
        t.frame(ms=16.0)
      }
    }
    None => ()
  }
  let _ = io_rt.split_conn.flush_write()
  let prev_wire = bytes_to_hex(wire::encode(wire::Message::Act("cookies_clear_site", "previous.example", "")))
  debug_assert(!sn_read_until_hex(acc_s, prev_wire, max_wait_ms=80).contains(prev_wire), "must never clear previous.example")

  // 2. Foreign broadcast after matching beta.example reply is ignored
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"beta.example\", \"origin\": \"https://beta.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"beta_session\", \"domain\": \"beta.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  debug_assert(t.get("Cookie beta_session").is_some(), "matching beta.example reply rendered")
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"previous.example\", \"origin\": \"https://previous.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"previous_session\", \"domain\": \"previous.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  debug_assert(t.get("Cookie previous_session").is_none() && t.get("Cookie beta_session").is_some(), "foreign broadcast dropped; beta_session preserved")

  // 3. Navigating B away from beta.example auto-closes nested Cookies Inspector
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://previous.example/home", "Previous", false, false, false)))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.cookies_open) && t.get("Clear Site Cookies").is_none(), "navigation closes nested Cookies Inspector")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.site_perms_snap = prev_perms
  app_state.cookies_snap = prev_cookies
  shell_adapter_reset()
}

test "phase2b_r6: cookies_canonical_host preserves www/punycode and strips path/port/scheme across all entry points" {
  // Pure canonicalizer edge cases
  debug_assert(cookies_canonical_host("https://www.beta.example/settings") == "www.beta.example", "preserve www")
  debug_assert(cookies_canonical_host("https://beta.example/settings/account") == "beta.example", "strip path")
  debug_assert(cookies_canonical_host("https://beta.example:8443/settings") == "beta.example", "strip port")
  debug_assert(cookies_canonical_host("https://xn--mnchen-3ya.de/path") == "xn--mnchen-3ya.de", "preserve punycode")
  debug_assert(cookies_canonical_host("http://[::1]:8443/test") == "[::1]", "preserve ipv6")
  debug_assert(cookies_canonical_host("https://user:pass@Sub.Example.COM:8080/a?b=1#c") == "sub.example.com", "strip userinfo/port/query")
  debug_assert(cookies_canonical_host(".beta.example") == "beta.example", "strip leading dot")
  debug_assert(cookies_canonical_host("about:blank") == "" && cookies_canonical_host("data:text/html,hi") == "" && cookies_canonical_host("javascript:void(0)") == "" && cookies_canonical_host("file:///tmp/a.html") == "", "reject non-http schemes")

  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_perms = app_state.site_perms_snap
  let prev_cookies = app_state.cookies_snap
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/settings", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://www.beta.example/settings", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. www.beta.example through SiteInfo -> Inspect Site Cookies -> Clear Site Cookies
  toggle_site_info()
  t.frame(ms=16.0)
  t.press("Inspect Site Cookies")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let www_sync = bytes_to_hex(wire::encode(wire::Message::Act("cookies_sync", "www.beta.example", "")))
  let apex_sync = bytes_to_hex(wire::encode(wire::Message::Act("cookies_sync", "beta.example", "")))
  let sent_www = bytes_to_hex(sn_read_all_available(acc_s, 0))
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"www.beta.example\", \"origin\": \"https://www.beta.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"www_session\", \"domain\": \"www.beta.example\", \"path\": \"/\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"beta.example\", \"origin\": \"https://www.beta.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"apex_session\", \"domain\": \"beta.example\", \"path\": \"/\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  let has_www = t.get("Cookie www_session").is_some()
  let has_apex = t.get("Cookie apex_session").is_some()
  let rv = match app_state.root_view { Some(v) => v; None => panic("root") }
  let cb = match t.get("Clear Site Cookies") { Some(v) => v; None => panic("clear") }
  debug_assert(rv.tree.focus_to(Some(cb.id), visible=true), "focus clear")
  t.key(proto::KEY_ENTER)
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let www_clear = bytes_to_hex(wire::encode(wire::Message::Act("cookies_clear_site", "www.beta.example", "")))
  let apex_clear = bytes_to_hex(wire::encode(wire::Message::Act("cookies_clear_site", "beta.example", "")))
  let out_www = sn_read_until_hex(acc_s, www_clear, max_wait_ms=100)
  debug_assert(sent_www.contains(www_sync) && !sent_www.contains(apex_sync) && has_www && !has_apex && out_www.contains(www_clear) && !out_www.contains(apex_clear), "www hostname preserved end-to-end")
  close_cookies_modal()
  close_site_info()
  t.frame(ms=16.0)

  // 2. Direct entry extracts hostname from URL path (no path leakage)
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings/account", "Beta", false, false, false)))
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  open_cookies_modal()
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let beta_sync = bytes_to_hex(wire::encode(wire::Message::Act("cookies_sync", "beta.example", "")))
  debug_assert(sn_read_until_hex(acc_s, beta_sync, max_wait_ms=100).contains(beta_sync) && shell_adapter.cookies_committed_host == "beta.example", "direct entry strips path")
  close_cookies_modal()
  t.frame(ms=16.0)

  // 3. SiteInfo + Cookies strips port from https://beta.example:8443/settings
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example:8443/settings", "BetaPort", false, false, false)))
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  toggle_site_info()
  t.frame(ms=16.0)
  t.press("Inspect Site Cookies")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_until_hex(acc_s, beta_sync, max_wait_ms=100).contains(beta_sync) && shell_adapter.cookies_committed_host == "beta.example", "port stripped for cookies_sync")
  close_cookies_modal()
  close_site_info()
  t.frame(ms=16.0)

  // 4. Punycode preserved (never Unicode-converted) for https://xn--mnchen-3ya.de/path
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://xn--mnchen-3ya.de/path", "Muenchen", false, false, false)))
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  toggle_site_info()
  t.frame(ms=16.0)
  t.press("Inspect Site Cookies")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let puny_sync = bytes_to_hex(wire::encode(wire::Message::Act("cookies_sync", "xn--mnchen-3ya.de", "")))
  debug_assert(sn_read_until_hex(acc_s, puny_sync, max_wait_ms=100).contains(puny_sync) && shell_adapter.cookies_committed_host == "xn--mnchen-3ya.de", "punycode preserved for cookies_sync")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.site_perms_snap = prev_perms
  app_state.cookies_snap = prev_cookies
  shell_adapter_reset()
}

test "phase2b_r7: empty cookie host (file://) shows 0 cookies, drops broadcasts, sends 0 wire mutations, and closes on nav" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_perms = app_state.site_perms_snap
  let prev_cookies = app_state.cookies_snap
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://beta.example/settings", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. Inspect previous.example SiteInfo & receive cached snapshot, then navigate to file:///tmp/notes.html
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://previous.example/home", "Previous", false, false, false)))
  t.frame(ms=16.0)
  toggle_site_info()
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"previous.example\", \"origin\": \"https://previous.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"previous_session\", \"domain\": \"previous.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  close_site_info()
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("file:///tmp/notes.html", "Local notes", false, false, false)))
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)

  open_command_bar("Inspect Site Cookies")
  t.frame(ms=16.0)
  t.press("Inspect Site Cookies")
  t.frame(ms=16.0)
  debug_assert(t.get("Cookie previous_session").is_none() && active_cookies_snap().cookies.length() == 0 && shell_adapter.cookies_committed_host == "", "file:// must not show stale previous.example cookies")

  // 2. Foreign previous.example & beta.example broadcasts while open on file:// are dropped
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"previous.example\", \"origin\": \"https://previous.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"previous_session\", \"domain\": \"previous.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::SiteCookiesState("{\"host\": \"beta.example\", \"origin\": \"https://beta.example\", \"spaceId\": \"work\", \"cookies\": [{\"name\": \"beta_session\", \"domain\": \"beta.example\", \"path\": \"/\", \"valuePreview\": \"masked\", \"secure\": true}]}"))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  debug_assert(t.get("Cookie previous_session").is_none() && t.get("Cookie beta_session").is_none() && active_cookies_snap().cookies.length() == 0, "foreign broadcasts dropped on empty host")

  // 3. Clicking Clear Site Cookies & calling dispatch_cookie_delete emit 0 cookies_clear_site / cookie_delete / cookies_sync frames
  match t.get("Clear Site Cookies") {
    Some(button) => {
      let rv = match app_state.root_view { Some(v) => v; None => panic("root") }
      if rv.tree.focus_to(Some(button.id), visible=true) {
        t.key(proto::KEY_ENTER)
        t.frame(ms=16.0)
      }
    }
    None => ()
  }
  dispatch_cookie_delete("previous.example", "/", "previous_session", "previous.example")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let b_hex = bytes_to_hex(sn_read_all_available(acc_s, 0))
  let clear_prev = bytes_to_hex(wire::encode(wire::Message::Act("cookies_clear_site", "previous.example", "")))
  let del_prev = bytes_to_hex(wire::encode(wire::Message::Act("cookie_delete", "previous.example|/|previous_session", "previous.example")))
  let sync_empty = bytes_to_hex(wire::encode(wire::Message::Act("cookies_sync", "", "")))
  debug_assert(!b_hex.contains(clear_prev) && !b_hex.contains(del_prev) && !b_hex.contains(sync_empty), "0 wire cookie mutations/syncs on empty host")
  close_cookies_modal()
  t.frame(ms=16.0)

  // 4. Navigating from https://beta.example/settings to file:///tmp/notes.html auto-closes Cookies Inspector
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/settings", "Beta", false, false, false)))
  t.frame(ms=16.0)
  open_cookies_modal()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.cookies_open) && shell_adapter.cookies_committed_host == "beta.example", "open on beta.example")
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("file:///tmp/notes.html", "Local notes", false, false, false)))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.cookies_open), "navigating to file:// auto-closes Cookies Inspector")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.site_perms_snap = prev_perms
  app_state.cookies_snap = prev_cookies
  shell_adapter_reset()
}

test "phase3a_t1: Settings modal focus trap, outside-click, IME double-Esc, Clear Browsing Data + Reader Mode pane isolation & origin/disconnect auto-close" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_settings = app_state.settings
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/article", "Beta Article", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let rv = match app_state.root_view { Some(v) => v; None => panic("root_view missing") }

  // 1. Settings modal: Tab/Shift+Tab focus trap inside modal + IME double-Esc + Clear Browsing Data + outside-click dismiss
  open_settings()
  t.frame(ms=16.0)
  let s_box = match t.get("Settings") { Some(b) => b; None => panic("Settings dialog missing") }
  for mod in [0, proto::SHORTCUT_MOD_SHIFT] {
    let mut i = 0
    while i < 8 {
      t.key(proto::KEY_TAB, mods=mod)
      t.frame(ms=16.0)
      match rv.tree.focused {
        Some(fid) => debug_assert(sn_node_in_subtree(rv.tree, s_box.id, fid), "Settings modal Tab focus stayed inside dialog")
        None => panic("Settings modal lost focus")
      }
      i += 1
    }
  }
  // IME double-Esc on settings_filter_field
  let sff = match shell_adapter.settings_filter_field { Some(f) => f; None => panic("settings_filter_field missing") }
  sff.focus()
  sff.compose("shezhi")
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.settings_open) && !sff.composing(), "1st Esc cleared Settings IME preedit only")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.settings_open), "2nd Esc closed Settings modal")

  // Reopen, switch to Privacy & Data, toggle Bookmarks, click Clear Selected Data -> exact wire frame
  open_settings(tab_idx=2)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.press("Bookmarks")
  t.press("Clear selected data")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let exp_clr = bytes_to_hex(wire::encode(wire::Message::Act("clear_browsing_data", "bookmarks,history", "")))
  debug_assert(sn_read_until_hex(acc_m, exp_clr).contains(exp_clr), "Settings Clear Selected Data emitted exact non-download clear_browsing_data frame")
  // Outside click closes Settings modal
  t.click(12.0, 12.0)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.settings_open), "outside click dismissed Settings modal")

  // 2. Reader Mode on pane B: routes reader_extract ONLY to split_conn, auto-closes on HTTPS -> file:// nav and on pane B disconnect
  open_split_view("https://beta.example/article", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  open_reader_mode()
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_rd = bytes_to_hex(wire::encode(wire::Message::Act("reader_extract", shell_adapter.reader_expected_req_id, "")))
  debug_assert(sn_read_until_hex(acc_s, exp_rd).contains(exp_rd), "Reader Mode on pane B sent reader_extract to split_conn")
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "Reader Mode on pane B sent 0 bytes to main_conn")
  // Navigating pane B from HTTPS to file:// auto-closes Reader Mode
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("file:///tmp/local.html", "Local", false, false, false)))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.reader_open), "Reader Mode auto-closed on HTTPS -> file:// origin change")
  // Reopen on pane B and disconnect pane B -> auto-closes Reader Mode
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://beta.example/article", "Beta", false, false, false)))
  t.frame(ms=16.0)
  open_reader_mode()
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.reader_open), "Reader Mode reopened on pane B")
  shell_on_pane_disconnected(1)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.reader_open), "Reader Mode auto-closed on pane B disconnect")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.settings = prev_settings
  shell_adapter_reset()
}

test "phase3a_t2: Site Boosts pane/origin/file:// isolation + DevTools pane B isolation, Copy as cURL, Docked<->Floating state & 1280->480 resize" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_clip_w = test_clipboard_write_hook.v
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let mem_clip = ui::ref_new("")
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { mem_clip.v = s })

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/page", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://www.beta.example/page", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. Site Boosts on pane B: canonical host preserves www., routes boost_save ONLY to split_conn (0 bytes to main_conn)
  open_boosts()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.boosts_committed_host == "www.beta.example", "Site Boosts preserved canonical www. host")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Boost Theme Dark")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_boost = bytes_to_hex("boost_save".to_bytes())
  let b_boost_hex = sn_read_until_hex(acc_s, exp_boost)
  debug_assert(b_boost_hex.contains(exp_boost) && b_boost_hex.contains(bytes_to_hex("www.beta.example".to_bytes())), "boost_save routed to split_conn preserving canonical www.beta.example")
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "boost_save sent 0 bytes to main_conn")

  // Zap on, a tap on the page (focus leaves the panel), then Escape: Zap ends, the panel stays; the next Escape closes it
  dispatch_boost_zap(true)
  t.frame(ms=16.0)
  debug_assert(boost_zap_active(), "Zap on")
  shell_focus_pane_stage(shell_ui::PaneId::Secondary)
  t.click(1000.0, 600.0)
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.boosts_open), "a tap on the page while zapping keeps the panel")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Escape after a tap on the page is taken")
  t.frame(ms=16.0)
  debug_assert(!boost_zap_active(), "Escape ended Zap")
  debug_assert(shell_sig_is_true(app_state.boosts_open), "the panel stays open after Zap ends")
  let _ = io_rt.split_conn.flush_write()
  let zap_hex = bytes_to_hex(sn_read_all_available(acc_s, 0))
  debug_assert(zap_hex.contains(bytes_to_hex("boost_zap".to_bytes())), "Zap off sent to the owner pane")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false) && !shell_sig_is_true(app_state.boosts_open), "the next Escape closes the panel")
  open_boosts()
  t.frame(ms=16.0)

  // Navigating pane B to file:// auto-closes Site Boosts; reopening on file:// emits 0 boost_save/boost_reset bytes
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("file:///tmp/notes.html", "Local Notes", false, false, false)))
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.boosts_open), "Site Boosts auto-closed on HTTPS -> file:// navigation")
  open_boosts()
  t.frame(ms=16.0)
  debug_assert(shell_adapter.boosts_committed_host == "", "file:// has empty boosts_committed_host")
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Boost Theme Warm")
  t.press("Reset Site Boost")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let empty_hex = bytes_to_hex(sn_read_all_available(acc_s, 0))
  debug_assert(!empty_hex.contains(bytes_to_hex("boost_save".to_bytes())) && !empty_hex.contains(bytes_to_hex("boost_reset".to_bytes())), "file:// emitted 0 boost_save/boost_reset bytes")
  close_boosts()
  t.frame(ms=16.0)

  // 2. DevTools on pane B: inspect/eval/clear route ONLY to split_conn (0 bytes to main_conn), Copy as cURL, Docked <-> Floating & 1280 -> 480 resize
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/page", "Beta", false, false, false)))
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  open_devtools(tab_idx=2)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_insp = bytes_to_hex(wire::encode(wire::Message::Act("devtools_inspect", "", "")))
  debug_assert(sn_read_until_hex(acc_s, exp_insp).contains(exp_insp), "DevTools open on pane B sent devtools_inspect to split_conn")
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0, "DevTools open on pane B sent 0 bytes to main_conn")

  // Feed pane B DevToolsState with a network request -> Copy as cURL writes to in-memory clipboard
  let dt_json = "{\"pageUrl\":\"https://www.beta.example/page\",\"pageTitle\":\"Beta\",\"selectedPath\":\"0\",\"nodes\":[{\"path\":\"0\",\"depth\":0,\"tag\":\"html\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0}],\"box\":{\"w\":800,\"h\":600,\"pt\":0,\"pr\":0,\"pb\":0,\"pl\":0,\"bt\":0,\"br\":0,\"bb\":0,\"bl\":0,\"mt\":0,\"mr\":0,\"mb\":0,\"ml\":0},\"styles\":[],\"console\":[],\"network\":[{\"name\":\"beta.json\",\"url\":\"https://api.beta.example/v1/beta.json\",\"kind\":\"fetch\",\"status\":200,\"ms\":35,\"bytes\":1200}]}"
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::DevToolsState(dt_json))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  t.press("Inspect request beta.json")
  t.frame(ms=16.0)
  t.press("Copy as cURL")
  t.frame(ms=16.0)
  debug_assert(mem_clip.v.contains("https://api.beta.example/v1/beta.json"), "Copy as cURL wrote pane B request URL to clipboard")

  // Switch Docked -> Floating, preserve REPL draft, resize 1280 -> 480, disconnect pane B auto-closes DevTools
  let dt_st = match shell_adapter.devtools_panel_state { Some(s) => s; None => panic("devtools_panel_state missing") }
  dt_st.repl_field.set("window.betaProbe")
  t.press("Float DevTools")
  t.frame(ms=16.0)
  debug_assert(dt_st.presentation.untracked() is shell_ui::DevToolsPresentation::Floating, "DevTools switched to Floating")
  debug_assert(dt_st.repl_field.text() == "window.betaProbe", "REPL draft preserved across Docked -> Floating")
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let dock_btn = match t.get("Dock DevTools") { Some(b) => b; None => panic("Dock DevTools button missing at 480") }
  debug_assert(dock_btn.x >= 0.0 && dock_btn.x + dock_btn.w <= 480.5 && dock_btn.y >= 44.0, "Floating DevTools clamped inside 480pt viewport below titleband")
  shell_on_pane_disconnected(1)
  t.frame(ms=16.0)
  debug_assert(!shell_sig_is_true(app_state.devtools_open), "DevTools auto-closed on pane B disconnect")

  test_clipboard_write_hook.v = prev_clip_w
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  shell_adapter_reset()
}

test "phase3a_r1: Settings dual-pane downloads clear+ack, Boosts CSS draft survives Tab+refresh, and DevTools per-doc selection isolation" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_clip_w = test_clipboard_write_hook.v
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let mem_clip = ui::ref_new("")
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { mem_clip.v = s })

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/page", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://www.beta.example/page", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. Settings Clear Browsing Data clears A & B downloads via dispatch_downloads_clear + ack suppresses stale refill
  let dl_a = [proto::DownloadSummary::{ id: "a-1", filename: "alpha.pdf", url: "https://alpha.example/a.pdf", mime: "application/pdf", bytes: 1024L, state: "completed", path: "" }]
  let dl_b = [proto::DownloadSummary::{ id: "b-1", filename: "beta.pdf", url: "https://www.beta.example/b.pdf", mime: "application/pdf", bytes: 2048L, state: "completed", path: "" }]
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope(dl_a))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope(dl_b))
  debug_assert(app_state.downloads.length() == 2, "both A and B downloads seeded")

  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  open_settings(tab_idx=2)
  t.frame(ms=16.0)
  t.press("Clear selected data")
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 0, "A and B downloads cleared immediately")
  let ack_m = downloads_tracker.main_pending_clear_id
  let ack_s = downloads_tracker.split_pending_clear_id
  debug_assert(ack_m != "" && ack_s != "", "both panes have pending clear_ack_id")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let exp_dl_m = bytes_to_hex(wire::encode(wire::Message::Act("downloads_clear", ack_m, "")))
  let exp_dl_s = bytes_to_hex(wire::encode(wire::Message::Act("downloads_clear", ack_s, "")))
  debug_assert(sn_read_until_hex(acc_m, exp_dl_m).contains(exp_dl_m), "main_conn received downloads_clear with ack")
  debug_assert(sn_read_until_hex(acc_s, exp_dl_s).contains(exp_dl_s), "split_conn received downloads_clear with ack")
  // Stale un-acked snapshots from A and B must NOT refill
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope(dl_a))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope(dl_b))
  debug_assert(app_state.downloads.length() == 0, "stale un-acked snapshots suppressed")
  // Acked empty replies clear pending ack; subsequent new download becomes visible
  set_host_downloads_state_from_pane(0, proto::encode_downloads_envelope([], clear_ack_id=ack_m))
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope([], clear_ack_id=ack_s))
  let dl_b2 = [proto::DownloadSummary::{ id: "b-2", filename: "beta2.pdf", url: "https://www.beta.example/b2.pdf", mime: "application/pdf", bytes: 512L, state: "completed", path: "" }]
  set_host_downloads_state_from_pane(1, proto::encode_downloads_envelope(dl_b2))
  debug_assert(app_state.downloads.length() == 1 && app_state.downloads[0].filename == "beta2.pdf", "new download visible after ack")
  // Unchecking Downloads preserves downloads and emits 0 downloads_clear
  t.press("Download list")
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Clear selected data")
  t.frame(ms=16.0)
  debug_assert(app_state.downloads.length() == 1, "unchecked Downloads preserved existing download")
  close_settings()
  t.frame(ms=16.0)

  // 2. Boosts unapplied CSS draft survives Tab blur + owner pane refresh, then submits exact CSS on Apply
  open_boosts()
  t.frame(ms=16.0)
  t.press("Code")
  t.frame(ms=600.0)
  let f = match app_state.boosts_css_field { Some(v) => v; None => panic("missing CSS field") }
  let cb = match t.get("Custom CSS") { Some(v) => v; None => panic("missing CSS input") }
  t.click(cb.x + 4.0, cb.y + cb.h * 0.5)
  t.type_text("p { color: teal }")
  t.frame(ms=16.0)
  debug_assert(f.text().contains("teal"), "draft typed")
  t.key(proto::KEY_TAB)
  t.frame(ms=16.0)
  debug_assert(!f.focused(), "Tab moved focus off CSS field")
  set_host_boosts_state_from_pane(1, proto::encode_boosts_snapshot(proto::BoostsSnapshot::empty()))
  t.frame(ms=16.0)
  debug_assert(f.text().contains("teal"), "unapplied CSS draft survived owner refresh after Tab")
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Apply Custom CSS")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let exp_teal = bytes_to_hex("p { color: teal }".to_bytes())
  debug_assert(sn_read_until_hex(acc_s, exp_teal).contains(exp_teal), "Apply Custom CSS sent preserved teal draft")
  close_boosts()
  t.frame(ms=16.0)

  // 3. DevTools per-doc selection isolation: B index 0 selected -> close -> switch to A -> A inspector NOT auto-opened
  open_devtools(tab_idx=2)
  t.frame(ms=16.0)
  let b_json = "{\"pageUrl\":\"https://www.beta.example/page\",\"pageTitle\":\"Beta\",\"selectedPath\":\"0\",\"nodes\":[{\"path\":\"0\",\"depth\":0,\"tag\":\"html\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0}],\"box\":{\"w\":800,\"h\":600,\"pt\":0,\"pr\":0,\"pb\":0,\"pl\":0,\"bt\":0,\"br\":0,\"bb\":0,\"bl\":0,\"mt\":0,\"mr\":0,\"mb\":0,\"ml\":0},\"styles\":[],\"console\":[],\"network\":[{\"name\":\"beta.json\",\"url\":\"https://api.beta.example/v1/beta.json\",\"kind\":\"fetch\",\"status\":200,\"ms\":35,\"bytes\":1200}]}"
  let _ = dispatch_split_incoming_chunks_budgeted_at([wire::encode(wire::Message::DevToolsState(b_json))], st_b, 1000.0, fn() { 0.0 })
  t.frame(ms=16.0)
  t.press("Inspect request beta.json")
  t.frame(ms=16.0)
  debug_assert(t.get("Copy as cURL").is_some(), "B request inspector open")
  // Same-doc Docked -> Floating preserves selected row
  t.press("Float DevTools")
  t.frame(ms=16.0)
  debug_assert(t.get("Copy as cURL").is_some(), "same-doc Docked->Floating preserved selected request")
  t.press("Dock DevTools")
  t.frame(ms=16.0)
  close_devtools()
  set_active_split_pane(0)
  t.frame(ms=16.0)
  let a_json = "{\"pageUrl\":\"https://alpha.example/home\",\"pageTitle\":\"Alpha\",\"selectedPath\":\"0\",\"nodes\":[{\"path\":\"0\",\"depth\":0,\"tag\":\"html\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0}],\"box\":{\"w\":800,\"h\":600,\"pt\":0,\"pr\":0,\"pb\":0,\"pl\":0,\"bt\":0,\"br\":0,\"bb\":0,\"bl\":0,\"mt\":0,\"mr\":0,\"mb\":0,\"ml\":0},\"styles\":[],\"console\":[],\"network\":[{\"name\":\"alpha.json\",\"url\":\"https://api.alpha.example/v1/alpha.json\",\"kind\":\"fetch\",\"status\":200,\"ms\":35,\"bytes\":1200}]}"
  set_host_devtools_state_from_pane(0, a_json)
  open_devtools(tab_idx=2)
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect request alpha.json").is_some(), "primary Network row present")
  debug_assert(t.get("Copy as cURL").is_none(), "A request inspector NOT auto-opened from B selection")

  test_clipboard_write_hook.v = prev_clip_w
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  shell_adapter_reset()
}

test "phase3a_r2: v1 legacy boosts echo on www., Boosts theme change keeps CSS draft until Apply, and DevTools closed refresh preserves B DOM path" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_clip_w = test_clipboard_write_hook.v
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let mem_clip = ui::ref_new("")
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { mem_clip.v = s })

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/page", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://www.beta.example/page", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  // 1. Legacy v1 boosts.json echoes on www.beta.example in Site Boosts panel
  let v1_json = "{\"items\":[{\"host\":\"beta.example\",\"enabled\":true,\"theme\":\"dark\"}]}"
  set_host_boosts_state_from_pane(1, v1_json)
  open_boosts()
  t.frame(ms=16.0)
  debug_assert(current_site_boost().theme == "dark" && current_site_boost().enabled, "v1 legacy bare boost echoed on www.beta.example")

  // 2. Astra R2 #1: Keep unapplied Custom CSS draft while clicking Boost Theme Dark + host reply, then Apply sends exact draft
  t.press("Code")
  t.frame(ms=600.0)
  let f = match app_state.boosts_css_field { Some(v) => v; None => panic("missing CSS field") }
  let cb = match t.get("Custom CSS") { Some(v) => v; None => panic("missing CSS input") }
  t.click(cb.x + 4.0, cb.y + cb.h * 0.5)
  t.type_text("p { color: teal }")
  t.frame(ms=16.0)
  debug_assert(f.text().contains("teal"), "draft typed")
  t.key(proto::KEY_TAB)
  t.frame(ms=16.0)
  debug_assert(!f.focused(), "tab takes keyboard focus to next control")
  t.press("Colors")
  t.frame(ms=600.0)
  t.press("Boost Theme Dark")
  t.frame(ms=16.0)
  let config = proto::SiteBoost::{ ..proto::SiteBoost::default_for("www.beta.example"), enabled: true, theme: "dark" }
  set_host_boosts_state_from_pane(1, proto::encode_boosts_snapshot(proto::BoostsSnapshot::{ items: [config] }))
  t.frame(ms=16.0)
  debug_assert(f.text().contains("teal"), "theme save and its reply preserved unapplied CSS draft")
  t.press("Code")
  t.frame(ms=600.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Apply Custom CSS")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let exp_teal = bytes_to_hex("p { color: teal }".to_bytes())
  debug_assert(sn_read_until_hex(acc_s, exp_teal).contains(exp_teal), "Apply Custom CSS sent preserved teal draft to split_conn")
  close_boosts()
  t.frame(ms=16.0)

  // 3. Astra R2 #2: DevTools DOM selection 0.1 on B survives close -> background A refresh -> open/close A -> reopen B
  let b_path = "0.1"
  let b_initial = "{\"pageUrl\":\"https://www.beta.example/page\",\"pageTitle\":\"Beta\",\"selectedPath\":\"0\",\"nodes\":[{\"path\":\"0\",\"depth\":0,\"tag\":\"html\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":2},{\"path\":\"0.0\",\"depth\":1,\"tag\":\"head\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0},{\"path\":\"0.1\",\"depth\":1,\"tag\":\"body\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0}],\"box\":{\"w\":800,\"h\":600,\"pt\":0,\"pr\":0,\"pb\":0,\"pl\":0,\"bt\":0,\"br\":0,\"bb\":0,\"bl\":0,\"mt\":0,\"mr\":0,\"mb\":0,\"ml\":0},\"styles\":[],\"console\":[],\"network\":[{\"name\":\"beta.json\",\"url\":\"https://api.beta.example/v1/beta.json\",\"kind\":\"fetch\",\"status\":200,\"ms\":35,\"bytes\":1200}]}"
  let b_reply = "{\"pageUrl\":\"https://www.beta.example/page\",\"pageTitle\":\"Beta\",\"selectedPath\":\"0.1\",\"nodes\":[{\"path\":\"0\",\"depth\":0,\"tag\":\"html\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":2},{\"path\":\"0.0\",\"depth\":1,\"tag\":\"head\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0},{\"path\":\"0.1\",\"depth\":1,\"tag\":\"body\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0}],\"box\":{\"w\":800,\"h\":600,\"pt\":0,\"pr\":0,\"pb\":0,\"pl\":0,\"bt\":0,\"br\":0,\"bb\":0,\"bl\":0,\"mt\":0,\"mr\":0,\"mb\":0,\"ml\":0},\"styles\":[],\"console\":[],\"network\":[{\"name\":\"beta.json\",\"url\":\"https://api.beta.example/v1/beta.json\",\"kind\":\"fetch\",\"status\":200,\"ms\":35,\"bytes\":1200}]}"
  open_devtools(tab_idx=0)
  set_host_devtools_state_from_pane(1, b_initial)
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Inspect <body>")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let clicked = bytes_to_hex(wire::encode(wire::Message::Act("devtools_inspect", b_path, "")))
  debug_assert(sn_read_until_hex(acc_s, clicked).contains(clicked), "B body selection emitted 0.1")
  set_host_devtools_state_from_pane(1, b_reply)
  t.frame(ms=16.0)
  close_devtools()
  t.frame(ms=16.0)

  let a_json = "{\"pageUrl\":\"https://alpha.example/home\",\"pageTitle\":\"Alpha\",\"selectedPath\":\"0\",\"nodes\":[{\"path\":\"0\",\"depth\":0,\"tag\":\"html\",\"id\":\"\",\"cls\":\"\",\"attrs\":[],\"text\":\"\",\"children\":0}],\"box\":{\"w\":800,\"h\":600,\"pt\":0,\"pr\":0,\"pb\":0,\"pl\":0,\"bt\":0,\"br\":0,\"bb\":0,\"bl\":0,\"mt\":0,\"mr\":0,\"mb\":0,\"ml\":0},\"styles\":[],\"console\":[],\"network\":[{\"name\":\"alpha.json\",\"url\":\"https://api.alpha.example/v1/alpha.json\",\"kind\":\"fetch\",\"status\":200,\"ms\":35,\"bytes\":1200}]}"
  set_host_devtools_state_from_pane(0, a_json)
  set_active_split_pane(0)
  open_devtools(tab_idx=2)
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect request alpha.json").is_some(), "primary Network row present")
  debug_assert(t.get("Copy as cURL").is_none(), "A request inspector NOT auto-opened")
  close_devtools()
  set_active_split_pane(1)
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  open_devtools(tab_idx=0)
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let selected = bytes_to_hex(wire::encode(wire::Message::Act("devtools_inspect", b_path, "")))
  let actual = sn_read_until_hex(acc_s, selected, max_wait_ms=120)
  debug_assert(actual.contains(selected), "reopened B preserved DOM path 0.1 after closed A background refresh")

  test_clipboard_write_hook.v = prev_clip_w
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  shell_adapter_reset()
}

test "phase3a_r3: SiteInfo and toolbar Boosts dot honor v1 legacyBare and v2 www. across primary & secondary panes" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_clip_w = test_clipboard_write_hook.v
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let mem_clip = ui::ref_new("")
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { mem_clip.v = s })

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  debug_assert(io_rt.split_conn.attach(cli_s), "attach split_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/home", "Alpha", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.beta.example/page", "Beta", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://www.beta.example/page", "", focus_pane=1)
  t.frame(ms=16.0)

  // Case 1 (legacy0): Primary pane with v1 legacy bare boost shows Edit Site Boosts in Site Info + toolbar purple dot
  set_active_split_pane(0)
  t.frame(ms=16.0)
  set_host_boosts_state_from_pane(0, "{\"items\":[{\"host\":\"beta.example\",\"enabled\":true,\"theme\":\"dark\"}]}")
  t.frame(ms=16.0)
  debug_assert(current_site_boost().enabled, "legacy0: Boosts sees active setting")
  toggle_site_info()
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect Site Cookies").is_some(), "legacy0: Site Info open")
  debug_assert(t.get("Edit Site Boosts").is_some(), "legacy0: Site Info shows Edit Site Boosts for v1 legacy bare boost")
  close_site_info()
  t.frame(ms=16.0)

  // Case 2 (v20): Primary pane with v2 www. boost shows Edit Site Boosts in Site Info
  set_host_boosts_state_from_pane(0, "{\"items\":[{\"host\":\"www.beta.example\",\"enabled\":true,\"theme\":\"dark\"}],\"version\":2}")
  t.frame(ms=16.0)
  debug_assert(current_site_boost().enabled, "v20: Boosts sees active v2 www. setting")
  toggle_site_info()
  t.frame(ms=16.0)
  debug_assert(t.get("Edit Site Boosts").is_some(), "v20: Site Info shows Edit Site Boosts for v2 www. boost")
  close_site_info()
  t.frame(ms=16.0)

  // Case 3 (v21): Secondary pane with v2 www. boost (primary cleared!) routes boost_sync to split_conn and shows Edit Site Boosts
  set_host_boosts_state_from_pane(0, "{\"items\":[],\"version\":2}")
  set_active_split_pane(1)
  t.frame(ms=16.0)
  set_host_boosts_state_from_pane(1, "{\"items\":[{\"host\":\"www.beta.example\",\"enabled\":true,\"theme\":\"dark\"}],\"version\":2}")
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_s, 0)
  toggle_site_info()
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.flush_write()
  let exp_sync = bytes_to_hex(wire::encode(wire::Message::Act("boost_sync", "", "")))
  debug_assert(sn_read_until_hex(acc_s, exp_sync).contains(exp_sync), "v21: Site Info dispatched boost_sync to split_conn")
  debug_assert(t.get("Edit Site Boosts").is_some(), "v21: Site Info shows Edit Site Boosts for secondary pane v2 www. boost")
  close_site_info()
  t.frame(ms=16.0)

  test_clipboard_write_hook.v = prev_clip_w
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  shell_adapter_reset()
}

test "phase3a_r4: on_split_connected dispatches boost_sync and secondary pane BoostsState lights toolbar purple dot" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()

  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")

  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://primary.test/", "Primary", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://www.example.com/split", "Split", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)
  open_split_view("https://www.example.com/split", "", focus_pane=1)
  t.frame(ms=16.0)
  set_active_split_pane(1)
  t.frame(ms=16.0)

  let has_purple_dot = fn() -> Bool {
    let mut found = false
    for r in t.drawn_rects() {
      if r.4 == shell_ui::shell_boost_mark() && r.2 <= 6.0 && r.3 <= 6.0 {
        found = true
      }
    }
    found
  }
  debug_assert(!has_purple_dot(), "toolbar Boosts purple dot initially off before split BoostsState")

  // Connect secondary pane via real on_split_connected -> MUST emit boost_sync to split_conn
  let _ = io_rt.split_conn.detach()
  on_split_connected(io_rt.split_gen, cli_s)
  debug_assert(io_rt.split_conn.is_open(), "on_split_connected attached split_conn")
  let _ = io_rt.split_conn.flush_write()
  let exp_sync = bytes_to_hex(wire::encode(wire::Message::Act("boost_sync", "", "")))
  debug_assert(sn_read_until_hex(acc_s, exp_sync).contains(exp_sync), "on_split_connected dispatched boost_sync on split_conn")

  // Secondary pane receives Meta + BoostsState for www.example.com -> toolbar Boosts purple dot lights up!
  match app_state.split_stage {
    Some(ss) => ss.feed(proto::encode_host(proto::HostMsg::Meta("https://www.example.com/split", "Split", false, false, false)))
    None => debug_assert(false, "expected split_stage after on_split_connected")
  }
  set_host_boosts_state_from_pane(1, "{\"items\":[{\"host\":\"www.example.com\",\"enabled\":true,\"theme\":\"dark\"}],\"version\":2}")
  t.frame(ms=16.0)
  debug_assert(current_site_boost().enabled, "secondary pane BoostsState activates current_site_boost")
  debug_assert(has_purple_dot(), "toolbar Boosts purple dot lights up for active secondary pane")

  close_split_view(quiet=true)
  t.frame(ms=16.0)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  shell_adapter_reset()
}

test "phase3b_t1: Cookies IDN display vs punycode RPC, History/Bookmarks search+clear, and Sessions exact id + draft preservation" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()
  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  let _ = io_rt.main_conn.attach(cli_m)
  let _ = io_rt.split_conn.attach(cli_s)
  app_state.split_port = 0
  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://primary.test/", "Primary", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://xn--mnchen-3ya.de/info", "Muenchen", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)

  // 1. Cookies Inspector IDN display (`münchen.de`) vs canonical punycode RPC (`xn--mnchen-3ya.de`) on Pane B
  open_split_view("https://xn--mnchen-3ya.de/info", "", focus_pane=1)
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.detach()
  let _ = io_rt.split_conn.attach(cli_s)
  set_active_split_pane(1)
  match app_state.split_stage {
    Some(ss) => ss.feed(proto::encode_host(proto::HostMsg::Meta("https://xn--mnchen-3ya.de/info", "Muenchen", false, false, false)))
    None => debug_assert(false, "split_stage expected")
  }
  t.frame(ms=16.0)
  open_cookies_modal()
  t.frame(ms=16.0)
  set_host_cookies_state_from_pane(1, "{\"host\":\"xn--mnchen-3ya.de\",\"origin\":\"https://xn--mnchen-3ya.de\",\"spaceId\":\"work\",\"cookies\":[{\"name\":\"session_id\",\"domain\":\"xn--mnchen-3ya.de\",\"path\":\"/\",\"valuePreview\":\"tok***\",\"secure\":true}]}")
  t.frame(ms=16.0)
  debug_assert(t.find("münchen.de").is_some(), "Cookies header renders Unicode IDN display host")
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  match t.get("Cookie session_id") {
    Some(d) => t.move_to(d.x + d.w * 0.5, d.y + d.h * 0.5)
    None => debug_assert(false, "Cookie session_id row rendered")
  }
  t.frame(ms=16.0)
  t.press("Delete cookie session_id")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let m_out = sn_read_all_available(acc_m, 0)
  let s_hex = bytes_to_hex(sn_read_all_available(acc_s, 10))
  let exp_del = bytes_to_hex(wire::encode(wire::Message::Act("cookie_delete", "xn--mnchen-3ya.de|/|session_id", "xn--mnchen-3ya.de")))
  debug_assert(m_out.length() == 0 && s_hex.contains(exp_del), "cookie_delete routed strictly to split_conn with canonical punycode")
  close_cookies_modal()
  t.frame(ms=16.0)

  // 2. History Drawer: Today/Earlier zero empty Yesterday, clear range, close clears search field
  let now_s = app_now_secs()
  app_state.history_snap = proto::HistorySnapshot::{
    query: "",
    total_count: 2,
    items: [
      proto::HistoryItemSummary::{ url: "https://farview.dev/today", title: "Today Page", host: "farview.dev", visit_count: 3, last_visit_secs: now_s - 300L },
      proto::HistoryItemSummary::{ url: "https://w3.org/old", title: "Earlier Page", host: "w3.org", visit_count: 1, last_visit_secs: now_s - 400000L },
    ],
  }
  match app_state.history_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  open_history()
  t.frame(ms=16.0)
  debug_assert(t.find("Today").is_some() && t.find("Earlier").is_some() && t.find("Yesterday").is_none(), "History zero empty group")
  match app_state.history_field {
    Some(hf) => {
      hf.set("Earlier")
      t.frame(ms=16.0)
    }
    None => ()
  }
  close_history()
  t.frame(ms=16.0)
  match app_state.history_field {
    Some(hf) => debug_assert(hf.text() == "", "close_history clears search field")
    None => ()
  }

  // 3. Bookmarks Drawer: search, empty state, close clears search field
  app_state.bookmarks_snap = proto::BookmarksSnapshot::{
    items: [
      proto::BookmarkEntry::{ id: "bm-1", title: "Invar Docs", url: "https://github.com/AFK-surf/invar", folder: "", created_ms: 100L },
    ],
  }
  match app_state.bookmarks_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  open_bookmarks()
  t.frame(ms=16.0)
  debug_assert(t.find("Invar Docs").is_some(), "Bookmarks Drawer renders saved bookmark")
  match app_state.bookmarks_field {
    Some(bf) => {
      bf.set("missing-bm")
      t.frame(ms=16.0)
      debug_assert(t.find("No matching bookmarks").is_some(), "Bookmarks empty filter state")
    }
    None => ()
  }
  close_bookmarks()
  t.frame(ms=16.0)
  match app_state.bookmarks_field {
    Some(bf) => debug_assert(bf.text() == "", "close_bookmarks clears search field")
    None => ()
  }

  // 4. Sessions Manager: filter + restore non-first item by exact session_id + draft survives host refresh
  app_state.sessions_state = proto::SavedSessionsState::{
    items: [
      proto::NamedSessionSnapshot::{ id: "sess-a", name: "Alpha Work", created_secs: now_s - 600L, active_space_id: "work", spaces: [], folders: [], tabs: [] },
      proto::NamedSessionSnapshot::{ id: "sess-target-exact", name: "Beta Release", created_secs: now_s - 1200L, active_space_id: "work", spaces: [], folders: [], tabs: [] },
    ],
  }
  match app_state.sessions_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  open_sessions_modal()
  t.frame(ms=16.0)
  match app_state.sessions_name_field {
    Some(nf) => nf.set("My Unsaved Draft")
    None => ()
  }
  // Background SessionsState refresh must NOT clobber uncommitted name draft
  set_host_sessions_state(proto::encode_saved_sessions_state(app_state.sessions_state))
  t.frame(ms=16.0)
  match app_state.sessions_name_field {
    Some(nf) => debug_assert(nf.text() == "My Unsaved Draft", "background SessionsState preserves uncommitted name draft")
    None => ()
  }
  match app_state.sessions_filter_field {
    Some(ff) => {
      ff.set("Beta")
      t.frame(ms=16.0)
    }
    None => ()
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.press("Restore Session Beta Release")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let sess_hex = bytes_to_hex(sn_read_all_available(acc_m, 10))
  let exp_rest = bytes_to_hex(wire::encode(wire::Message::Act("session_restore", "sess-target-exact", "")))
  debug_assert(sess_hex.contains(exp_rest), "filtered session restore dispatches exact session_id")

  close_split_view(quiet=true)
  t.frame(ms=16.0)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  shell_adapter_reset()
}

test "phase3b_t2: Spaces draft preservation, Closed Tabs original it.index after filter, and Print PDF pane B isolation + Cancel 0 bytes" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_split_stage = app_state.split_stage
  let prev_split_port = app_state.split_port
  let old_main = io_rt.main_conn.detach()
  let old_split = io_rt.split_conn.detach()
  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  let (srv_s, cli_s, acc_s) = sn_make_loopback_pair()
  let _ = io_rt.main_conn.attach(cli_m)
  let _ = io_rt.split_conn.attach(cli_s)
  app_state.split_port = 0
  let st_a = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  let st_b = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_split_bytes(b) })
  st_a.feed(proto::encode_host(proto::HostMsg::Meta("https://primary.test/", "Primary", false, false, false)))
  st_b.feed(proto::encode_host(proto::HostMsg::Meta("https://docs.example.com/spec", "Spec", false, false, false)))
  app_state.stage = Some(st_a)
  app_state.split_stage = Some(st_b)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)

  // 1. Spaces Manager: inline rename draft survives background WorkspaceState refresh
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..app_state.workspace,
    active_space_id: "work",
    spaces: [
      proto::SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: proto::space_theme_unset(), active: true, tab_count: 3 },
      proto::SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", theme: proto::space_theme_unset(), active: false, tab_count: 1 },
    ],
  }
  match app_state.workspace_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  open_spaces_manager()
  t.frame(ms=16.0)
  t.press("Rename Space Personal")
  t.frame(ms=16.0)
  match app_state.spaces_rename_field {
    Some(rf) => rf.set("My Custom Space")
    None => ()
  }
  match app_state.workspace_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  t.frame(ms=16.0)
  match app_state.spaces_rename_field {
    Some(rf) => debug_assert(rf.text() == "My Custom Space", "background WorkspaceState preserves Spaces rename draft")
    None => ()
  }
  close_spaces_manager()
  t.frame(ms=16.0)

  // 2. Closed Tabs Drawer: search filter -> click non-first item dispatches original it.index=3 (NOT filtered index 1!)
  let now_s = app_now_secs()
  app_state.closed_tabs_snap = proto::ClosedTabsSnapshot::{
    items: [
      proto::ClosedTabItem::{ index: 0, title: "Alpha", url: "https://alpha.dev", host: "alpha.dev", space_name: "Work", closed_secs: now_s - 20L },
      proto::ClosedTabItem::{ index: 1, title: "Beta", url: "https://beta.dev", host: "beta.dev", space_name: "Work", closed_secs: now_s - 40L },
      proto::ClosedTabItem::{ index: 2, title: "Gamma One", url: "https://g1.dev", host: "g1.dev", space_name: "Work", closed_secs: now_s - 60L },
      proto::ClosedTabItem::{ index: 3, title: "Gamma Two", url: "https://g2.dev", host: "g2.dev", space_name: "Work", closed_secs: now_s - 80L },
    ],
  }
  match app_state.closed_tabs_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  open_closed_tabs_modal()
  t.frame(ms=16.0)
  match app_state.closed_tabs_field {
    Some(cf) => {
      cf.set("Gamma")
      t.frame(ms=16.0)
    }
    None => ()
  }
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  t.press("Restore Gamma Two")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let ct_hex = bytes_to_hex(sn_read_all_available(acc_m, 10))
  let exp_reopen = bytes_to_hex(wire::encode(wire::Message::Act("tab_reopen_at", "3", "")))
  debug_assert(ct_hex.contains(exp_reopen), "filtered closed tab restore MUST send original it.index=3")
  match app_state.closed_tabs_field {
    Some(cf) => debug_assert(cf.text() == "", "closing Closed Tabs clears search field")
    None => ()
  }

  // 3. Print-to-PDF Modal: lock Pane B, Cancel emits 0 bytes, Save sends Legal+Landscape+Wide ONLY to split_conn!
  open_split_view("https://docs.example.com/spec", "", focus_pane=1)
  t.frame(ms=16.0)
  let _ = io_rt.split_conn.detach()
  let _ = io_rt.split_conn.attach(cli_s)
  set_active_split_pane(1)
  t.frame(ms=16.0)
  open_print_pdf_modal()
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  let _ = sn_read_all_available(acc_s, 0)
  t.press("Cancel Export PDF")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  debug_assert(sn_read_all_available(acc_m, 0).length() == 0 && sn_read_all_available(acc_s, 0).length() == 0, "Cancel Print PDF sends 0 bytes")

  open_print_pdf_modal()
  t.frame(ms=16.0)
  t.press("Legal")
  t.press("Landscape")
  t.press("Wide")
  t.frame(ms=16.0)
  t.press("Save as PDF")
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let _ = io_rt.split_conn.flush_write()
  let m_pdf = sn_read_all_available(acc_m, 0)
  let s_pdf = sn_read_all_available(acc_s, 10)
  debug_assert(m_pdf.length() == 0 && s_pdf.length() > 0, "Save as PDF locked to Pane B sends strictly to split_conn (0 bytes main_conn)")

  close_split_view(quiet=true)
  t.frame(ms=16.0)
  t.dispose()
  let _ = io_rt.main_conn.detach()
  let _ = io_rt.split_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  net::close(cli_s)
  net::close(acc_s)
  net::close(srv_s)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  if old_split >= 0 { let _ = io_rt.split_conn.attach(old_split) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.split_stage = prev_split_stage
  app_state.split_port = prev_split_port
  shell_adapter_reset()
}

test "phase3b_t3: History/Bookmarks/ClosedTabs mounted in body_content below titleband & top_strip with zero right-edge clip at 1280 and 480" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://farview.dev/docs", "Farview Docs", false, false, false)))
  app_state.stage = Some(st)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  t.frame(ms=16.0)

  let now_s = app_now_secs()
  app_state.history_snap = proto::HistorySnapshot::{
    query: "",
    total_count: 1,
    items: [proto::HistoryItemSummary::{ url: "https://farview.dev/docs", title: "Farview Docs", host: "farview.dev", visit_count: 2, last_visit_secs: now_s - 60L }],
  }
  match app_state.history_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  app_state.bookmarks_snap = proto::BookmarksSnapshot::{
    items: [proto::BookmarkEntry::{ id: "bm-1", title: "Invar UI", url: "https://github.com/AFK-surf/invar", folder: "Core", created_ms: 100L }],
  }
  match app_state.bookmarks_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  app_state.closed_tabs_snap = proto::ClosedTabsSnapshot::{
    items: [proto::ClosedTabItem::{ index: 0, title: "Alpha Docs", url: "https://alpha.dev", host: "alpha.dev", space_name: "Work", closed_secs: now_s - 30L }],
  }
  match app_state.closed_tabs_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }

  let settle = fn() -> Unit {
    let mut i = 0
    while i < 48 {
      t.frame(ms=16.67)
      i += 1
    }
  }

  let cases : Array[(Double, Bool)] = [(1280.0, true), (1280.0, false), (480.0, false)]
  for c in cases {
    let (win_w, sb_open) = c
    t.resize(win_w, 800.0)
    shell_adapter.dock.set(shell_ui::DockState::{ ..shell_adapter.dock.untracked(), sidebar_open: sb_open })
    t.frame(ms=16.0)
    // Page column top: SHELL_CANVAS_GAP with the sidebar docked (no toolbar), else below the 40pt toolbar row.
    let top_clear = shell_ui::shell_content_top_for(shell_adapter.dock.untracked(), win_w) + 12.0
    let left_clear = shell_ui::shell_sidebar_width(win_w, sb_open, custom_w=shell_adapter.dock.untracked().sidebar_width)

    open_history()
    settle()
    match t.get("Close History") {
      Some(cb) => {
        debug_assert(cb.y >= top_clear, "History drawer must stay inside the page column (below any toolbar), got y=" + cb.y.to_string())
        debug_assert(cb.x >= left_clear, "History drawer never covers the docked sidebar")
        debug_assert(cb.x + cb.w <= win_w - 12.0 + 0.5, "History drawer right edge unclipped at w=" + win_w.to_string())
      }
      None => debug_assert(false, "History drawer Close button missing")
    }
    close_history()
    settle()

    open_bookmarks()
    settle()
    match t.get("Close Bookmarks") {
      Some(cb) => {
        debug_assert(cb.y >= top_clear, "Bookmarks drawer must stay inside the page column (below any toolbar), got y=" + cb.y.to_string())
        debug_assert(cb.x >= left_clear, "Bookmarks drawer never covers the docked sidebar")
        debug_assert(cb.x + cb.w <= win_w - 12.0 + 0.5, "Bookmarks drawer right edge unclipped at w=" + win_w.to_string())
      }
      None => debug_assert(false, "Bookmarks drawer Close button missing")
    }
    close_bookmarks()
    settle()

    open_closed_tabs_modal()
    settle()
    match t.get("Clear All Closed Tabs") {
      Some(ca) => {
        debug_assert(ca.y >= top_clear, "Closed Tabs drawer inside the page column (below any toolbar)")
        debug_assert(ca.x + ca.w <= win_w - 12.0 + 0.5, "Closed Tabs Clear All unclipped at w=" + win_w.to_string() + " right=" + (ca.x + ca.w).to_string())
      }
      None => debug_assert(false, "Closed Tabs Clear All button missing")
    }
    close_closed_tabs_modal()
    settle()
  }

  t.dispose()
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  shell_adapter_reset()
}

fn g2_sel() -> Int {
  match app_state.omnibox_selected {
    Some(s) => s.untracked()
    None => -2
  }
}

test "feel g2: Cmd+T opens the palette for a new tab, the top row is lit and Enter takes it, hover selects, commands found, Escape creates nothing, Cmd+L navigates in place, zoom shows" {
  shell_adapter_reset()
  let prev_root = app_state.root_view
  let prev_stage = app_state.stage
  let prev_ws = app_state.workspace
  let prev_closed = app_state.closed_tabs_snap
  let old_main = io_rt.main_conn.detach()
  let (srv_m, cli_m, acc_m) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli_m), "attach main_conn")
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { enqueue_main_bytes(b) })
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://alpha.local/home", "Alpha Home", false, false, false)))
  app_state.stage = Some(st)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0, theme=lg::ui_theme)
  ensure_demo_tab_search_seeded()
  t.frame(ms=16.0)
  let cmd_mod = if ui::keys_system() == 0 { ui::mod_cmd } else { ui::mod_ctrl }

  // 1. Cmd+T: no blank tab yet; the palette opens empty and focused, in new-tab mode, with the first row lit.
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  debug_assert(handle_app_key(1000 + 0x74, cmd_mod, false), "Cmd+T handled")
  t.frame(ms=16.0)
  debug_assert(shell_sig_is_true(app_state.omnibox_editing), "Cmd+T opens the address palette")
  debug_assert(app_state.omnibox_new_tab, "the palette is in new-tab mode")
  let addr = match app_state.address_field {
    Some(f) => f
    None => {
      debug_assert(false, "address field")
      return
    }
  }
  debug_assert(addr.focused() && addr.text() == "", "the field is empty and focused: typing works at once")
  let _ = io_rt.main_conn.flush_write()
  let none_wire = bytes_to_hex(sn_read_all_available(acc_m, 0))
  let blank_hex = bytes_to_hex(wire::encode(wire::Message::Act("tab_new", "", "")))
  debug_assert(!none_wire.contains(blank_hex), "Cmd+T does not open a blank tab before anything is chosen")
  if app_state.omni_suggest_items.length() > 0 {
    debug_assert(g2_sel() == 0, "empty new-tab palette lights the first row")
  }

  // 2. Typing "gith" with an open GitHub tab: that tab is the top row, lit, and Enter switches to it.
  dispatch_omnibox_query("gith")
  t.frame(ms=16.0)
  debug_assert(app_state.omni_suggest_items.length() > 0, "suggestions for gith")
  debug_assert(app_state.omni_suggest_items[0].tab_id == "tab-pr", "the GitHub tab is the first row")
  debug_assert(g2_sel() == 0, "and it is preselected")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  navigate_omnibox(st, "gith", None)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let exp_sw = bytes_to_hex(wire::encode(wire::Message::Act("tab_switch", "tab-pr", "")))
  debug_assert(sn_read_until_hex(acc_m, exp_sw).contains(exp_sw), "Enter switched to the GitHub tab")
  debug_assert(!app_state.omnibox_new_tab, "new-tab mode ends with the palette")

  // 3. Cmd+T then a search-like query: the Web Search row leads; Enter opens the search in a NEW tab.
  debug_assert(handle_app_key(1000 + 0x74, cmd_mod, false), "Cmd+T again")
  t.frame(ms=16.0)
  dispatch_omnibox_query("github stars")
  t.frame(ms=16.0)
  debug_assert(app_state.omni_suggest_items[0].category is proto::OmniSuggestCategory::Search, "search row leads")
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  navigate_omnibox(st, "github stars", None)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let wire_all = bytes_to_hex(sn_read_all_available(acc_m, 8))
  debug_assert(wire_all.contains(bytes_to_hex("tab_new".to_bytes())), "the search opened in a new tab")
  debug_assert(wire_all.contains(bytes_to_hex("github".to_bytes())), "with the typed search in it")

  // 4. Cmd+L: the current address, nothing lit (Enter reloads it); hover selects without committing.
  // (what act_focus_url does)
  app_state.syncing_address_url = true
  addr.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
  app_state.syncing_address_url = false
  match app_state.omnibox_editing {
    Some(ed) => ed.set(true)
    None => ()
  }
  addr.focus()
  app_state.omnibox_new_tab = false
  omnibox_reset_selection()
  dispatch_omnibox_query("")
  t.frame(ms=16.0)
  debug_assert(!app_state.omnibox_new_tab, "Cmd+L is not new-tab mode")
  debug_assert(g2_sel() == -1, "Cmd+L with the address lights nothing")
  dispatch_omnibox_query("farview")
  t.frame(ms=16.0)
  if app_state.omni_suggest_items.length() > 1 {
    hover_omnibox_selection(1)
    debug_assert(g2_sel() == 1, "hover moved the selection")
    debug_assert(shell_sig_is_true(app_state.omnibox_editing), "hover never commits")
    // A background refresh keeps what the person pointed at.
    refresh_omnibox_suggestions("farview")
    debug_assert(g2_sel() == 1, "refresh keeps a moved selection")
  }

  // 5. One catalog: "split" typed in the address palette finds the Split View command.
  dispatch_omnibox_query("split")
  t.frame(ms=16.0)
  let mut has_split = false
  for it in app_state.omni_suggest_items {
    if (it.category is proto::OmniSuggestCategory::Action) && it.url == "toggle_split_view" {
      has_split = true
    }
  }
  debug_assert(has_split, "the address palette lists the Split View command")
  shell_dismiss_omnibox_and_restore_address()
  t.frame(ms=16.0)

  // 6. Cmd+T, type, Escape: nothing is created, the address comes back, new-tab mode ends.
  let tab_new_hex = bytes_to_hex("tab_new".to_bytes())
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  debug_assert(handle_app_key(1000 + 0x74, cmd_mod, false), "Cmd+T (escape case)")
  t.frame(ms=16.0)
  t.type_text("abc")
  t.frame(ms=16.0)
  debug_assert(addr.text() == "abc", "typed into the new-tab palette: " + addr.text())
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let esc_wire = bytes_to_hex(sn_read_all_available(acc_m, 0))
  debug_assert(!esc_wire.contains(tab_new_hex), "Escape on the new-tab palette creates no tab")
  debug_assert(!app_state.omnibox_new_tab, "Escape ends new-tab mode")
  debug_assert(!shell_sig_is_true(app_state.omnibox_editing), "Escape closes the palette")
  debug_assert(
    addr.text() == proto::omnibox_safe_display_url(active_address_raw_url_untracked()),
    "Escape restores the active tab's address: " + addr.text(),
  )

  // 7. Cmd+T then Cmd+L: back to editing the current tab; Enter goes there in place (no tab_new).
  debug_assert(handle_app_key(1000 + 0x74, cmd_mod, false), "Cmd+T (then Cmd+L)")
  t.frame(ms=16.0)
  debug_assert(app_state.omnibox_new_tab, "new-tab mode on")
  t.key(1000 + 0x6C, mods=cmd_mod)
  t.frame(ms=16.0)
  debug_assert(!app_state.omnibox_new_tab, "Cmd+L clears new-tab mode")
  debug_assert(shell_sig_is_true(app_state.omnibox_editing), "Cmd+L keeps the palette open on the address")
  t.type_text("beta.local/inplace")
  t.frame(ms=16.0)
  st.opened()
  let _ = io_rt.main_conn.flush_write()
  let _ = sn_read_all_available(acc_m, 0)
  navigate_omnibox(st, addr.text(), None)
  t.frame(ms=16.0)
  let _ = io_rt.main_conn.flush_write()
  let exp_go = bytes_to_hex(proto::encode_client(proto::ClientMsg::Nav(proto::NAV_GO, "https://beta.local/inplace")))
  let l_wire = sn_read_until_hex(acc_m, exp_go)
  debug_assert(l_wire.contains(exp_go), "after Cmd+T then Cmd+L, Enter navigates the current tab in place (st.go)")
  debug_assert(!l_wire.contains(tab_new_hex), "and opens no new tab")

  // 8. A page zoomed to 110% shows its zoom in the address (a state mark inside the Address Bar's press box).
  shell_dismiss_omnibox_and_restore_address()
  t.frame(ms=16.0)
  debug_assert(t.find("110%").is_none(), "no zoom mark at 100%")
  let ab_before = t.get("Address Bar")
  st.set_zoom(1.1)
  t.frame(ms=16.0)
  debug_assert(t.find("110%").is_some(), "a page at 110% shows its zoom in the frame")
  debug_assert(t.get("Page Zoom").is_some(), "the zoom mark is labelled")
  match (ab_before, t.get("Address Bar")) {
    (Some(a), Some(b)) => debug_assert((a.w - b.w).abs() < 0.5, "the zoom mark takes no width from the Address Bar")
    _ => debug_assert(false, "Address Bar present")
  }
  st.set_zoom(1.0)
  t.frame(ms=16.0)
  debug_assert(t.find("110%").is_none(), "the mark goes at 100% again")

  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(cli_m)
  net::close(acc_m)
  net::close(srv_m)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
  app_state.root_view = prev_root
  app_state.stage = prev_stage
  app_state.workspace = prev_ws
  app_state.closed_tabs_snap = prev_closed
  shell_adapter_reset()
}
