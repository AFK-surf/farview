fn dt_console_level_matches(filter : Int, level : String) -> Bool {
  if filter == 0 {
    true
  } else if filter == 1 {
    level == "log" || level == "info" || level == "input" || level == "result"
  } else if filter == 2 {
    level == "warn"
  } else {
    level == "error"
  }
}

// --- Folder Create & Color Dispatchers ---

fn close_folder_create_bar() -> Unit {
  match app_state.folder_create_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.folder_create_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("folder_create")
}

fn open_folder_create_bar() -> Unit {
  close_exclusive_overlays()
  if !is_sidebar_open() {
    set_sidebar_open(true)
  }
  match app_state.folder_create_field {
    Some(f) => {
      f.set("")
      f.focus()
    }
    None => ()
  }
  match app_state.folder_create_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "folder_create")
}

fn toggle_folder_create_bar() -> Unit {
  let is_open = match app_state.folder_create_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_folder_create_bar()
  } else {
    open_folder_create_bar()
  }
}

fn dispatch_folder_create_colored(
  name : String,
  color : String,
  move_active : Bool,
) -> Unit {
  let clean = name.trim()
  let label = if clean != "" {
    clean
  } else {
    proto::next_auto_folder_name(app_state.workspace, app_state.workspace.active_space_id)
  }
  let col = proto::normalize_folder_color(color)
  let move_arg = if move_active { "active" } else { "" }
  let payload_b = app_state.workspace.active_space_id + "|" + col + "|" + move_arg
  send_wire(wire::Message::Act("folder_create", label, payload_b))
  close_folder_create_bar()
  show_toast("Created Folder \"" + label + "\"", "folder")
}

fn dispatch_folder_color(folder_id : String, color : String) -> Unit {
  if folder_id != "" {
    let col = proto::normalize_folder_color(color)
    send_wire(wire::Message::Act("folder_color", folder_id, col))
  }
}

// --- Named Sessions Dispatchers ---

fn dispatch_sessions_sync() -> Unit {
  send_wire(wire::Message::Act("sessions_sync", "", ""))
}

fn dispatch_session_save(raw_name : String) -> Unit {
  let clean = raw_name.trim()
  let label = if clean != "" {
    clean
  } else {
    "Session " + (app_state.sessions_state.items.length() + 1).to_string()
  }
  // Optimistic local prepend so UI updates immediately even before host round-trip
  let now_s = (now_ms() / 1000.0).to_int64()
  let local_id = "sess-local-" + now_s.to_string()
  let captured = proto::capture_named_session(local_id, label, now_s, app_state.workspace)
  let next_items : Array[proto::NamedSessionSnapshot] = [captured]
  let mut i = 0
  while i < app_state.sessions_state.items.length() && next_items.length() < proto::SAVED_SESSIONS_MAX_ITEMS {
    next_items.push(app_state.sessions_state.items[i])
    i = i + 1
  }
  app_state.sessions_state = proto::SavedSessionsState::{ items: next_items }
  match app_state.sessions_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("session_save", label, ""))
  show_toast("Saved Session \"" + label + "\"", "info")
}

fn dispatch_session_restore(session_id : String, name : String) -> Unit {
  if session_id == "" {
    return
  }
  // Apply locally immediately if found, and dispatch to host
  let mut i = 0
  while i < app_state.sessions_state.items.length() {
    if app_state.sessions_state.items[i].id == session_id {
      app_state.workspace = proto::session_to_workspace_snapshot(app_state.sessions_state.items[i])
      match app_state.workspace_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      break
    }
    i = i + 1
  }
  send_wire(wire::Message::Act("session_restore", session_id, ""))
  close_sessions_modal()
  let lbl = if name.trim() != "" { name.trim() } else { "Session" }
  show_toast("Restored Session \"" + lbl + "\"", "info")
}

fn dispatch_session_delete(session_id : String, name : String) -> Unit {
  if session_id == "" {
    return
  }
  let kept : Array[proto::NamedSessionSnapshot] = []
  let mut i = 0
  while i < app_state.sessions_state.items.length() {
    if app_state.sessions_state.items[i].id != session_id {
      kept.push(app_state.sessions_state.items[i])
    }
    i = i + 1
  }
  app_state.sessions_state = proto::SavedSessionsState::{ items: kept }
  match app_state.sessions_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("session_delete", session_id, ""))
  let lbl = if name.trim() != "" { name.trim() } else { "Session" }
  show_toast("Deleted Session \"" + lbl + "\"", "clear")
}

fn set_host_sessions_state(json : String) -> Unit {
  match proto::parse_saved_sessions_state(json, max_items=proto::SAVED_SESSIONS_MAX_ITEMS) {
    Some(st) => {
      if app_state.demo_sessions && st.items.length() == 0 {
        ensure_demo_sessions_seeded()
      } else {
        app_state.sessions_state = st
        match app_state.sessions_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
      }
      match app_state.host_sessions_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_sessions_modal() -> Unit {
  match app_state.sessions_name_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.sessions_filter_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.sessions_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("sessions")
}

fn open_sessions_modal() -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.sessions_filter_field {
    Some(f) => f.set("")
    None => ()
  }
  match app_state.sessions_filter_query {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.sessions_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "sessions")
  if app_state.demo_sessions {
    ensure_demo_sessions_seeded()
  }
  dispatch_sessions_sync()
}

fn toggle_sessions_modal() -> Unit {
  let is_open = match app_state.sessions_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_sessions_modal()
  } else {
    open_sessions_modal()
  }
}

