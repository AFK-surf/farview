///| Settings / chrome palette, reader / boosts, devtools, folders / sessions and spaces / closed-tabs /
///| print panel state, host sync and wire dispatchers (no UI).

struct ChromePalette {
  is_dark : Bool
  toolbar_bg : Int64
  sidebar_bg : Int64
  surface_bg : Int64
  surface_subtle : Int64
  addr_bg : Int64
  btn_bg : Int64
  btn_hover : Int64
  btn_press : Int64
  btn_active_bg : Int64
  border : Int64
  hairline : Int64
  ink_primary : Int64
  ink_secondary : Int64
  ink_muted : Int64
  tab_active_bg : Int64
  tab_active_border : Int64
  tab_hover_bg : Int64
  tab_press_bg : Int64
  accent : Int64
  accent_soft_bg : Int64
  accent_soft_border : Int64
  accent_soft_ink : Int64
  danger : Int64
  danger_bg : Int64
  danger_border : Int64
}

fn chrome_palette_for(is_dark : Bool) -> ChromePalette {
  if is_dark {
    ChromePalette::{
      is_dark: true,
      toolbar_bg: 0x181A20FFL,
      sidebar_bg: 0x14161BFFL,
      surface_bg: 0x1C1F26FFL,
      surface_subtle: 0x22252EFFL,
      addr_bg: 0x22252EFFL,
      btn_bg: 0x232732FFL,
      btn_hover: 0x2C3140FFL,
      btn_press: 0x33394AFFL,
      btn_active_bg: 0x262A36FFL,
      border: 0x2C303CFFL,
      hairline: 0x262A35FFL,
      ink_primary: 0xF1F5F9FFL,
      ink_secondary: 0xCBD5E1FFL,
      ink_muted: 0x94A3B8FFL,
      tab_active_bg: 0x262A36FFL,
      tab_active_border: 0x353B4BFFL,
      tab_hover_bg: 0x1F232EFFL,
      tab_press_bg: 0x282D3BFFL,
      accent: 0x60A5FAFFL,
      accent_soft_bg: 0x1E2E4AFFL,
      accent_soft_border: 0x2F4B78FFL,
      accent_soft_ink: 0x93C5FDFFL,
      danger: 0xF87171FFL,
      danger_bg: 0x351D22FFL,
      danger_border: 0x5C2A32FFL,
    }
  } else {
    ChromePalette::{
      is_dark: false,
      toolbar_bg: 0xF2F2F7FFL,
      sidebar_bg: 0xF5F6FAFFL,
      surface_bg: 0xFFFFFFFFL,
      surface_subtle: 0xF8F9FCFFL,
      addr_bg: 0xFFFFFFFFL,
      btn_bg: 0xE5E5EAFFL,
      btn_hover: 0xDDDDE4FFL,
      btn_press: 0xD6D8E2FFL,
      btn_active_bg: 0xE1E5F2FFL,
      border: 0xDCDCE2FFL,
      hairline: 0xECEEF4FFL,
      ink_primary: 0x1D1D1FFFL,
      ink_secondary: 0x3A4152FFL,
      ink_muted: 0x6B7280FFL,
      tab_active_bg: 0xFFFFFFFFL,
      tab_active_border: 0xD8DCE8FFL,
      tab_hover_bg: 0xECEEF5FFL,
      tab_press_bg: 0xE2E6F0FFL,
      accent: 0x2563EBFFL,
      accent_soft_bg: 0xEAF3FFFFL,
      accent_soft_border: 0xBFD7FFFFL,
      accent_soft_ink: 0x1D4ED8FFL,
      danger: 0xDC2626FFL,
      danger_bg: 0xFEF2F2FFL,
      danger_border: 0xFECACAFFL,
    }
  }
}

fn is_dark_chrome() -> Bool {
  match app_state.chrome_theme {
    Some(s) => s.get() == "dark"
    None => app_state.settings.chrome_theme == "dark"
  }
}

fn chrome_palette() -> ChromePalette {
  chrome_palette_for(is_dark_chrome())
}

fn space_sidebar_surface_themed(accent : String, dark : Bool) -> Int64 {
  if dark {
    let hex = proto::normalize_space_accent(accent)
    if hex == "#10B981" {
      0x131918FFL
    } else if hex == "#8B5CF6" {
      0x17151EFFL
    } else if hex == "#F59E0B" {
      0x1A1713FFL
    } else if hex == "#EC4899" || hex == "#F43F5E" {
      0x1B1419FFL
    } else if hex == "#06B6D4" {
      0x13191CFFL
    } else if hex == "#64748B" {
      0x16181DFFL
    } else {
      0x14161BFFL
    }
  } else {
    space_sidebar_surface(accent)
  }
}

fn dispatch_settings_sync() -> Unit {
  send_wire(wire::Message::Act("settings_sync", "", ""))
}

fn dispatch_settings_save(next_s : proto::BrowserSettings, toast_msg~ : String = "") -> Unit {
  let clean = proto::normalize_browser_settings(next_s)
  app_state.settings = clean
  match app_state.chrome_theme {
    Some(s) => s.set(clean.chrome_theme)
    None => ()
  }
  sync_lg_theme_from_chrome(clean.chrome_theme)
  match app_state.settings_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  let payload = proto::encode_browser_settings(clean)
  send_wire(wire::Message::Act("settings_save", payload, ""))
  if toast_msg != "" {
    show_toast(toast_msg, "settings")
  }
}

fn dispatch_clear_browsing_data(clear_hist : Bool, clear_dl : Bool, clear_boosts : Bool) -> Unit {
  let cats : Array[String] = []
  let labels : Array[String] = []
  if clear_hist {
    cats.push("history")
    labels.push("History")
  }
  if clear_dl {
    cats.push("downloads")
    labels.push("Downloads")
  }
  if clear_boosts {
    cats.push("boosts")
    labels.push("Site Boosts")
  }
  if cats.length() == 0 {
    show_toast("Select at least one category to clear", "settings")
    return
  }
  send_wire(wire::Message::Act("clear_browsing_data", cats.join(","), ""))
  show_toast("Cleared " + labels.join(", "), "settings")
}

fn set_host_settings_state(json : String) -> Unit {
  match proto::parse_browser_settings(json) {
    Some(parsed) => {
      let clean = proto::normalize_browser_settings(parsed)
      app_state.settings = clean
      match app_state.chrome_theme {
        Some(s) => if app_state.initial_chrome_theme == "" {
          s.set(clean.chrome_theme)
        }
        None => ()
      }
      if app_state.initial_chrome_theme == "" {
        sync_lg_theme_from_chrome(clean.chrome_theme)
      }
      match app_state.settings_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_settings_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_settings() -> Unit {
  match app_state.settings_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("settings")
}

fn open_settings(tab_idx~ : Int = -1) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  if tab_idx >= 0 && tab_idx <= 2 {
    match app_state.settings_tab {
      Some(t) => t.set(tab_idx)
      None => ()
    }
  }
  match app_state.settings_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "settings")
  dispatch_settings_sync()
}

fn toggle_settings() -> Unit {
  let is_open = match app_state.settings_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_settings()
  } else {
    open_settings()
  }
}

fn toggle_dark_chrome() -> Unit {
  let cur = app_state.settings
  let next_theme = if is_dark_chrome() { "light" } else { "dark" }
  app_state.initial_chrome_theme = ""
  let next = proto::BrowserSettings::{ ..cur, chrome_theme: next_theme }
  let label = if next_theme == "dark" { "Dark Appearance Enabled" } else { "Light Appearance Enabled" }
  dispatch_settings_save(next, toast_msg=label)
}

fn settings_sidebar_width() -> Double {
  let _ = match app_state.settings_rev {
    Some(r) => r.get()
    None => 0
  }
  if app_state.settings.compact_sidebar { 204.0 } else { 244.0 }
}

fn settings_step_default_zoom(delta : Int) -> Unit {
  let cur = app_state.settings
  let steps : Array[Int] = [75, 80, 90, 100, 110, 125, 150]
  let mut idx = 3
  let mut i = 0
  while i < steps.length() {
    if steps[i] <= cur.default_zoom_pct {
      idx = i
    }
    i = i + 1
  }
  let mut next_idx = idx + delta
  if next_idx < 0 {
    next_idx = 0
  }
  if next_idx >= steps.length() {
    next_idx = steps.length() - 1
  }
  let next_pct = steps[next_idx]
  if next_pct != cur.default_zoom_pct {
    dispatch_settings_save(proto::BrowserSettings::{ ..cur, default_zoom_pct: next_pct })
    apply_zoom_and_sync(active_stage(), (next_pct as Double) / 100.0)
  }
}

fn clear_reader_article_cache() -> Unit {
  app_state.reader_article = proto::ReaderArticle::empty()
  match app_state.reader_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

fn dispatch_reader_extract() -> Unit {
  let pane = if shell_adapter.reader_owner_pane >= 0 {
    shell_adapter.reader_owner_pane
  } else if active_targets_split() {
    1
  } else {
    0
  }
  let rid = shell_reader_next_req_id(pane)
  shell_adapter.reader_expected_req_id = rid
  shell_adapter.reader_status = 0
  clear_reader_article_cache()
  match app_state.host_reader_synced {
    Some(s) => s.set(false)
    None => ()
  }
  send_wire_active(wire::Message::Act("reader_extract", rid, ""))
}

fn dispatch_boost_sync() -> Unit {
  send_wire(wire::Message::Act("boost_sync", "", ""))
}

fn dispatch_boost_save(boost : proto::SiteBoost, toast_msg~ : String = "") -> Unit {
  let payload = proto::encode_site_boost(boost)
  send_wire(wire::Message::Act("boost_save", payload, ""))
  if toast_msg != "" {
    show_toast(toast_msg, "boost")
  }
}

fn dispatch_boost_reset(host : String) -> Unit {
  send_wire(wire::Message::Act("boost_reset", host, ""))
  show_toast("Reset Boost for " + host, "boost")
}

fn current_boost_host() -> String {
  let u = active_stage().url()
  let h = proto::normalize_boost_host(u)
  if h != "" { h } else { "local" }
}

fn current_site_boost() -> proto::SiteBoost {
  let h = current_boost_host()
  match proto::boosts_find(app_state.boosts_snap, h) {
    Some(b) => b
    None => proto::SiteBoost::default_for(h)
  }
}

fn sync_boosts_css_field_from_host() -> Unit {
  let b = current_site_boost()
  match app_state.boosts_css_field {
    Some(f) => if !f.focused() {
      app_state.syncing_boosts_css = true
      f.set(b.custom_css)
      app_state.syncing_boosts_css = false
    }
    None => ()
  }
}

