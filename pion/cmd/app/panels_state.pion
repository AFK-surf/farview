}

fn open_devtools(tab_idx~ : Int = -1) -> Unit {
  if tab_idx >= 0 && tab_idx <= 2 {
    match app_state.devtools_tab {
      Some(t) => t.set(tab_idx)
      None => ()
    }
  }
  match app_state.devtools_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_sync_dock_from_app()
  let sel = match app_state.devtools_selected_path {
    Some(sp) => sp.untracked()
    None => ""
  }
  dispatch_devtools_inspect(sel)
}

fn close_devtools() -> Unit {
  match app_state.devtools_open {
    Some(s) => s.set(false)
    None => ()
  }
  shell_sync_dock_from_app()
}

fn toggle_devtools() -> Unit {
  let is_open = match app_state.devtools_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_devtools()
  } else {
    open_devtools()
  }
}

fn submit_devtools_repl(raw : String) -> Unit {
  let trimmed = raw.trim()
  if trimmed == "" {
    return
  }
  match app_state.devtools_repl_field {
    Some(f) => f.set("")
    None => ()
  }
  dispatch_devtools_eval(trimmed)
}

fn dt_mono_run(s : String, color : Int64, weight~ : Int = 400) -> text::Run {
  text::Run::{ ..text::plain(s), mono: true, color, weight }
}

fn dt_is_hidden_by_collapse(path : String) -> Bool {
  let mut i = 0
  while i < path.length() {
    if path.code_unit_at(i).to_int() == 0x2E {
      let anc = path.slice(0, i)
      if app_state.devtools_collapsed.get(anc).unwrap_or(false) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn dt_dom_node_runs(nd : proto::DevToolsDomNode, collapsed : Bool, dark : Bool) -> Array[text::Run] {
  let runs : Array[text::Run] = []
  let c_punct = if dark { 0x64748BFFL } else { 0x64748BFFL }
  let c_tag = if dark { 0xC084FCFFL } else { 0x6D28D9FFL }
  let c_attr = if dark { 0xFBBF24FFL } else { 0xB45309FFL }
  let c_val = if dark { 0x34D399FFL } else { 0x047857FFL }
  let c_text = if dark { 0xE2E8F0FFL } else { 0x334155FFL }
  let c_muted = if dark { 0x64748BFFL } else { 0x94A3B8FFL }
  runs.push(dt_mono_run("<", c_punct))
  runs.push(dt_mono_run(nd.tag, c_tag, weight=500))
  if nd.id_attr != "" {
    runs.push(dt_mono_run(" id", c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + nd.id_attr + "\"", c_val))
  }
  if nd.class_attr != "" {
    let cls_show = if nd.class_attr.length() > 36 { nd.class_attr.slice(0, 36) + "..." } else { nd.class_attr }
    runs.push(dt_mono_run(" class", c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + cls_show + "\"", c_val))
  }
  let mut ai = 0
  while ai < nd.attrs.length() && ai < 2 {
    let at = nd.attrs[ai]
    let v_show = if at.value.length() > 28 { at.value.slice(0, 28) + "..." } else { at.value }
    runs.push(dt_mono_run(" " + at.name, c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + v_show + "\"", c_val))
    ai = ai + 1
  }
  runs.push(dt_mono_run(">", c_punct))
  if nd.text_preview != "" {
    let txt = if nd.text_preview.length() > 44 { nd.text_preview.slice(0, 44) + "..." } else { nd.text_preview }
    runs.push(dt_mono_run(txt, c_text))
  }
  if nd.child_count == 0 {
    runs.push(dt_mono_run("</" + nd.tag + ">", c_muted))
  } else if collapsed {
    runs.push(dt_mono_run(" … </" + nd.tag + ">", c_muted))
  }
  runs
}

fn dt_net_kind_colors(kind : String, dark : Bool) -> (Int64, Int64, String) {
  let cat = proto::devtools_net_category(kind, "")
  if dark {
    if cat == "doc" {
      (0x1E3A5FFFL, 0x93C5FDFFL, "doc")
    } else if cat == "js" {
      (0x3B2D14FFL, 0xFCD34DFFL, "js")
    } else if cat == "css" {
      (0x2E1F4BFFL, 0xC4B5FDFFL, "css")
    } else if cat == "img" {
      (0x113227FFL, 0x6EE7B7FFL, "img")
    } else if cat == "fetch" {
      (0x10333EFFL, 0x67E8F9FFL, "fetch")
    } else if kind == "font" {
      (0x3D1B30FFL, 0xF9A8D4FFL, "font")
    } else {
      (0x262B38FFL, 0xCBD5E1FFL, if kind != "" { kind } else { "other" })
    }
  } else if cat == "doc" {
    (0xDBEAFEFFL, 0x1D4ED8FFL, "doc")
  } else if cat == "js" {
    (0xFEF3C7FFL, 0xB45309FFL, "js")
  } else if cat == "css" {
    (0xEDE9FEFFL, 0x6D28D9FFL, "css")
  } else if cat == "img" {
    (0xD1FAE5FFL, 0x047857FFL, "img")
  } else if cat == "fetch" {
    (0xCFFAFEFFL, 0x0E7490FFL, "fetch")
  } else if kind == "font" {
    (0xFCE7F3FFL, 0xBE185DFFL, "font")
  } else {
    (0xF1F5F9FFL, 0x475569FFL, if kind != "" { kind } else { "other" })
  }
}

fn dt_net_waterfall_color(kind : String, url : String, dark : Bool) -> Int64 {
  let cat = proto::devtools_net_category(kind, url)
  if dark {
    if cat == "doc" {
      0x60A5FAFFL
    } else if cat == "js" {
      0xFBBF24FFL
    } else if cat == "css" {
      0xA78BFAFFL
    } else if cat == "img" {
      0x34D399FFL
    } else if cat == "fetch" {
      0x22D3EEFFL
    } else {
      0x94A3B8FFL
    }
  } else if cat == "doc" {
    0x3B82F6FFL
  } else if cat == "js" {
    0xF59E0BFFL
  } else if cat == "css" {
    0x8B5CF6FFL
  } else if cat == "img" {
    0x10B981FFL
  } else if cat == "fetch" {
    0x06B6D4FFL
  } else {
    0x64748BFFL
  }
}

fn dt_net_status_colors(status : Int, dark : Bool) -> (Int64, Int64) {
  if status >= 500 {
    if dark { (0x3D1820FFL, 0xFCA5A5FFL) } else { (0xFEE2E2FFL, 0xB91C1CFFL) }
  } else if status >= 400 {
    if dark { (0x3B1D1EFFL, 0xF87171FFL) } else { (0xFEE2E2FFL, 0xDC2626FFL) }
  } else if status >= 300 {
    if dark { (0x382A12FFL, 0xFBBF24FFL) } else { (0xFEF3C7FFL, 0xB45309FFL) }
  } else if dark {
    (0x102F24FFL, 0x34D399FFL)
  } else {
    (0xDCFCE7FFL, 0x047857FFL)
  }
}

