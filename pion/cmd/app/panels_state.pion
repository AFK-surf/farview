///| Settings / chrome palette, reader / boosts, devtools, folders / sessions and spaces / closed-tabs /
///| print panel state, host sync and wire dispatchers (no UI).

struct ChromePalette {
  is_dark : Bool
  toolbar_bg : Int64
  sidebar_bg : Int64
  surface_bg : Int64
  surface_subtle : Int64
  addr_bg : Int64
  btn_bg : Int64
  btn_hover : Int64
  btn_press : Int64
  btn_active_bg : Int64
  border : Int64
  hairline : Int64
  ink_primary : Int64
  ink_secondary : Int64
  ink_muted : Int64
  tab_active_bg : Int64
  tab_active_border : Int64
  tab_hover_bg : Int64
  tab_press_bg : Int64
  accent : Int64
  accent_soft_bg : Int64
  accent_soft_border : Int64
  accent_soft_ink : Int64
  danger : Int64
  danger_bg : Int64
  danger_border : Int64
}

fn chrome_palette_for(is_dark : Bool) -> ChromePalette {
  if is_dark {
    ChromePalette::{
      is_dark: true,
      toolbar_bg: 0x181A20FFL,
      sidebar_bg: 0x14161BFFL,
      surface_bg: 0x1C1F26FFL,
      surface_subtle: 0x22252EFFL,
      addr_bg: 0x22252EFFL,
      btn_bg: 0x232732FFL,
      btn_hover: 0x2C3140FFL,
      btn_press: 0x33394AFFL,
      btn_active_bg: 0x262A36FFL,
      border: 0x2C303CFFL,
      hairline: 0x262A35FFL,
      ink_primary: 0xF1F5F9FFL,
      ink_secondary: 0xCBD5E1FFL,
      ink_muted: 0x94A3B8FFL,
      tab_active_bg: 0x262A36FFL,
      tab_active_border: 0x353B4BFFL,
      tab_hover_bg: 0x1F232EFFL,
      tab_press_bg: 0x282D3BFFL,
      accent: 0x60A5FAFFL,
      accent_soft_bg: 0x1E2E4AFFL,
      accent_soft_border: 0x2F4B78FFL,
      accent_soft_ink: 0x93C5FDFFL,
      danger: 0xF87171FFL,
      danger_bg: 0x351D22FFL,
      danger_border: 0x5C2A32FFL,
    }
  } else {
    ChromePalette::{
      is_dark: false,
      toolbar_bg: 0xF2F2F7FFL,
      sidebar_bg: 0xF5F6FAFFL,
      surface_bg: 0xFFFFFFFFL,
      surface_subtle: 0xF8F9FCFFL,
      addr_bg: 0xFFFFFFFFL,
      btn_bg: 0xE5E5EAFFL,
      btn_hover: 0xDDDDE4FFL,
      btn_press: 0xD6D8E2FFL,
      btn_active_bg: 0xE1E5F2FFL,
      border: 0xDCDCE2FFL,
      hairline: 0xECEEF4FFL,
      ink_primary: 0x1D1D1FFFL,
      ink_secondary: 0x3A4152FFL,
      ink_muted: 0x6B7280FFL,
      tab_active_bg: 0xFFFFFFFFL,
      tab_active_border: 0xD8DCE8FFL,
      tab_hover_bg: 0xECEEF5FFL,
      tab_press_bg: 0xE2E6F0FFL,
      accent: 0x2563EBFFL,
      accent_soft_bg: 0xEAF3FFFFL,
      accent_soft_border: 0xBFD7FFFFL,
      accent_soft_ink: 0x1D4ED8FFL,
      danger: 0xDC2626FFL,
      danger_bg: 0xFEF2F2FFL,
      danger_border: 0xFECACAFFL,
    }
  }
}

fn is_dark_chrome() -> Bool {
  match app_state.chrome_theme {
    Some(s) => s.get() == "dark"
    None => app_state.settings.chrome_theme == "dark"
  }
}

fn chrome_palette() -> ChromePalette {
  chrome_palette_for(is_dark_chrome())
}

fn space_sidebar_surface_themed(accent : String, dark : Bool) -> Int64 {
  if dark {
    let hex = proto::normalize_space_accent(accent)
    if hex == "#10B981" {
      0x131918FFL
    } else if hex == "#8B5CF6" {
      0x17151EFFL
    } else if hex == "#F59E0B" {
      0x1A1713FFL
    } else if hex == "#EC4899" || hex == "#F43F5E" {
      0x1B1419FFL
    } else if hex == "#06B6D4" {
      0x13191CFFL
    } else if hex == "#64748B" {
      0x16181DFFL
    } else {
      0x14161BFFL
    }
  } else {
    space_sidebar_surface(accent)
  }
}

fn dispatch_settings_sync() -> Unit {
  send_wire(wire::Message::Act("settings_sync", "", ""))
}

fn dispatch_settings_save(next_s : proto::BrowserSettings, toast_msg~ : String = "") -> Unit {
  let clean = proto::normalize_browser_settings(next_s)
  app_state.settings = clean
  match app_state.chrome_theme {
    Some(s) => s.set(clean.chrome_theme)
    None => ()
  }
  ui::set_glass_solid(Some(!clean.glass))
  sync_lg_theme_from_chrome(clean.chrome_theme)
  match app_state.settings_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  let payload = proto::encode_browser_settings(clean)
  send_wire(wire::Message::Act("settings_save", payload, ""))
  if toast_msg != "" {
    show_toast(toast_msg, "settings")
  }
}

fn dispatch_clear_browsing_data_selection(sel : shell_ui::ClearBrowsingDataSelection) -> Unit {
  let non_dl_cats : Array[String] = []
  let labels : Array[String] = []
  if sel.bookmarks {
    non_dl_cats.push("bookmarks")
    labels.push("Bookmarks")
  }
  if sel.history {
    non_dl_cats.push("history")
    labels.push("History")
  }
  if sel.downloads {
    labels.push("Downloads")
  }
  if sel.boosts {
    non_dl_cats.push("boosts")
    labels.push("Site Boosts")
  }
  if labels.length() == 0 {
    show_toast("Select at least one category to clear", "settings")
    return
  }
  if sel.downloads {
    dispatch_downloads_clear()
  }
  if non_dl_cats.length() > 0 {
    send_wire(wire::Message::Act("clear_browsing_data", non_dl_cats.join(","), ""))
  }
  if sel.boosts && (is_split_open() || is_peek_open()) {
    send_wire_to_pane(1, wire::Message::Act("clear_browsing_data", "boosts", ""))
  }
  show_toast("Cleared " + labels.join(", "), "settings")
}

fn set_host_settings_state(json : String) -> Unit {
  match proto::parse_browser_settings(json) {
    Some(parsed) => {
      let clean = proto::normalize_browser_settings(parsed)
      app_state.settings = clean
      ui::set_glass_solid(Some(!clean.glass))
      match app_state.chrome_theme {
        Some(s) => if app_state.initial_chrome_theme == "" {
          s.set(clean.chrome_theme)
        }
        None => ()
      }
      if app_state.initial_chrome_theme == "" {
        sync_lg_theme_from_chrome(clean.chrome_theme)
      }
      match app_state.settings_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_settings_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_settings() -> Unit {
  match shell_adapter.settings_filter_field {
    Some(f) => {
      f.set("")
      if f.focused() {
        f.let_go()
      }
    }
    None => ()
  }
  match app_state.settings_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("settings")
}

fn open_settings(tab_idx~ : Int = -1) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  if tab_idx >= 0 && tab_idx <= 2 {
    match app_state.settings_tab {
      Some(t) => t.set(tab_idx)
      None => ()
    }
  }
  match app_state.settings_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "settings")
  dispatch_settings_sync()
}

fn toggle_settings() -> Unit {
  let is_open = match app_state.settings_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_settings()
  } else {
    open_settings()
  }
}

fn toggle_dark_chrome() -> Unit {
  let cur = app_state.settings
  let next_theme = if is_dark_chrome() { "light" } else { "dark" }
  app_state.initial_chrome_theme = ""
  let next = proto::BrowserSettings::{ ..cur, chrome_theme: next_theme }
  let label = if next_theme == "dark" { "Dark Appearance Enabled" } else { "Light Appearance Enabled" }
  dispatch_settings_save(next, toast_msg=label)
}

fn settings_sidebar_width() -> Double {
  let _ = match app_state.settings_rev {
    Some(r) => r.get()
    None => 0
  }
  if app_state.settings.compact_sidebar { 204.0 } else { 244.0 }
}

fn settings_step_default_zoom(delta : Int) -> Unit {
  let cur = app_state.settings
  let steps : Array[Int] = [75, 80, 90, 100, 110, 125, 150]
  let mut idx = 3
  let mut i = 0
  while i < steps.length() {
    if steps[i] <= cur.default_zoom_pct {
      idx = i
    }
    i = i + 1
  }
  let mut next_idx = idx + delta
  if next_idx < 0 {
    next_idx = 0
  }
  if next_idx >= steps.length() {
    next_idx = steps.length() - 1
  }
  let next_pct = steps[next_idx]
  if next_pct != cur.default_zoom_pct {
    dispatch_settings_save(proto::BrowserSettings::{ ..cur, default_zoom_pct: next_pct })
    apply_zoom_and_sync(active_stage(), (next_pct as Double) / 100.0)
  }
}

fn clear_reader_article_cache() -> Unit {
  app_state.reader_article = proto::ReaderArticle::empty()
  match app_state.reader_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

fn dispatch_reader_extract() -> Unit {
  let pane = if shell_adapter.reader_owner_pane >= 0 {
    shell_adapter.reader_owner_pane
  } else if active_targets_split() {
    1
  } else {
    0
  }
  let rid = shell_reader_next_req_id(pane)
  shell_adapter.reader_expected_req_id = rid
  shell_adapter.reader_status = 0
  clear_reader_article_cache()
  match app_state.host_reader_synced {
    Some(s) => s.set(false)
    None => ()
  }
  send_wire_to_pane(pane, wire::Message::Act("reader_extract", rid, ""))
}

fn boosts_canonical_origin(raw : String) -> String {
  let norm = proto::normalize_permission_origin(raw)
  let site_orig = proto::site_origin_from_url(raw)
  if norm != "" { norm } else if site_orig != "" { site_orig } else { raw.trim() }
}

fn dispatch_boost_sync() -> Unit {
  send_wire(wire::Message::Act("boost_sync", "", ""))
}

fn dispatch_boost_sync_for_pane(pane_id : Int) -> Unit {
  send_wire_to_pane(pane_id, wire::Message::Act("boost_sync", "", ""))
}

fn current_boost_draft_key() -> String {
  shell_adapter.boosts_owner_pane.to_string() + "|" + current_boost_host()
}

fn mark_boosts_css_draft_dirty() -> Unit {
  if !app_state.syncing_boosts_css {
    shell_adapter.boosts_css_dirty = true
    shell_adapter.boosts_css_draft_key = current_boost_draft_key()
  }
}

fn clear_boosts_css_draft_dirty() -> Unit {
  shell_adapter.boosts_css_dirty = false
  shell_adapter.boosts_css_draft_key = ""
}

fn dispatch_boost_save(
  boost : proto::SiteBoost,
  toast_msg~ : String = "",
  clear_css_dirty~ : Bool = false,
) -> Unit {
  let target_host = if shell_sig_is_true(app_state.boosts_open) {
    shell_adapter.boosts_committed_host.trim()
  } else {
    boost.host.trim()
  }
  if target_host == "" {
    return
  }
  if clear_css_dirty {
    clear_boosts_css_draft_dirty()
  }
  let locked = proto::SiteBoost::{ ..boost, host: target_host }
  let payload = proto::encode_site_boost(locked)
  send_wire_to_pane(shell_adapter.boosts_owner_pane, wire::Message::Act("boost_save", payload, ""))
  if toast_msg != "" {
    show_toast(toast_msg, "boost")
  }
}

// Boost Zap and Code state of the open Site Boosts panel (one panel at a time).
let boost_zap_flag : Array[Bool] = [false]
let boost_js_fields : Array[ui::Field] = []
// (the script last put in the JavaScript field from the host, and for which site: a field still holding it has no
// unapplied draft, so a host reply may replace it)
let boost_js_synced : Array[String] = ["", ""]

fn bump_boosts_rev() -> Unit {
  match app_state.boosts_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

///| The Site Boosts panel's custom JavaScript field.
fn boosts_js_field() -> ui::Field {
  if boost_js_fields.length() == 0 {
    boost_js_fields.push(ui::Field::new())
  }
  boost_js_fields[0]
}

fn sync_boosts_js_field_from_host() -> Unit {
  let f = boosts_js_field()
  if f.focused() {
    return
  }
  let key = current_boost_draft_key()
  if boost_js_synced[1] == key && f.text() != boost_js_synced[0] {
    return
  }
  let js = current_site_boost().custom_js
  f.set(js)
  boost_js_synced[0] = js
  boost_js_synced[1] = key
}

fn boost_zap_active() -> Bool {
  boost_zap_flag[0]
}

///| Turns Zap (pick elements on the page to hide) on or off in the Boost panel's pane.
fn dispatch_boost_zap(on : Bool) -> Unit {
  let target_host = shell_adapter.boosts_committed_host.trim()
  if on && (target_host == "" || !shell_sig_is_true(app_state.boosts_open)) {
    return
  }
  if boost_zap_flag[0] == on {
    return
  }
  boost_zap_flag[0] = on
  send_wire_to_pane(shell_adapter.boosts_owner_pane, wire::Message::Act("boost_zap", if on { "1" } else { "0" }, ""))
  bump_boosts_rev()
}

///| Saves a boost for its own site (All Boosts rows), whatever site the panel is bound to.
fn dispatch_boost_save_site(boost : proto::SiteBoost) -> Unit {
  let h = proto::normalize_boost_host(boost.host)
  if h == "" {
    return
  }
  let payload = proto::encode_site_boost(proto::SiteBoost::{ ..boost, host: h })
  send_wire_to_pane(active_boosts_pane(), wire::Message::Act("boost_save", payload, ""))
}

///| Deletes the boost of a site (All Boosts rows).
fn dispatch_boost_delete_site(host : String) -> Unit {
  let h = proto::normalize_boost_host(host)
  if h == "" {
    return
  }
  send_wire_to_pane(active_boosts_pane(), wire::Message::Act("boost_reset", h, ""))
  show_toast("Deleted Boost for " + h, "boost")
}

///| Opens a boosted site in a new tab.
fn dispatch_boost_open_site(host : String) -> Unit {
  let h = proto::normalize_boost_host(host)
  if h == "" {
    return
  }
  dispatch_tab_new("https://" + h + "/", h)
}

fn dispatch_boost_reset(host : String) -> Unit {
  let target_host = if shell_sig_is_true(app_state.boosts_open) {
    shell_adapter.boosts_committed_host.trim()
  } else {
    host.trim()
  }
  if target_host == "" {
    return
  }
  clear_boosts_css_draft_dirty()
  send_wire_to_pane(shell_adapter.boosts_owner_pane, wire::Message::Act("boost_reset", target_host, ""))
  show_toast("Reset Boost for " + target_host, "boost")
}

fn active_boosts_pane() -> Int {
  if shell_sig_is_true(app_state.boosts_open) {
    shell_adapter.boosts_owner_pane
  } else {
    shell_active_pane_index()
  }
}

fn active_boosts_snap() -> proto::BoostsSnapshot {
  if active_boosts_pane() == 1 {
    shell_adapter.split_boosts_snap
  } else {
    app_state.boosts_snap
  }
}

fn active_boosts_legacy_bare() -> Array[String] {
  if active_boosts_pane() == 1 {
    shell_adapter.split_boosts_legacy_bare
  } else {
    shell_adapter.boosts_legacy_bare
  }
}

fn current_boost_host() -> String {
  if shell_sig_is_true(app_state.boosts_open) {
    shell_adapter.boosts_committed_host
  } else {
    let raw = shell_pane_raw_url(shell_active_pane_index())
    cookies_canonical_host(raw)
  }
}

fn current_site_boost() -> proto::SiteBoost {
  let h = current_boost_host()
  if h == "" {
    return proto::SiteBoost::default_for("")
  }
  match proto::boosts_find_with_legacy(active_boosts_snap(), active_boosts_legacy_bare(), h) {
    Some(b) => b
    None => proto::SiteBoost::default_for(h)
  }
}

fn sync_boosts_css_field_from_host() -> Unit {
  let cur_key = current_boost_draft_key()
  if shell_adapter.boosts_css_dirty && shell_adapter.boosts_css_draft_key == cur_key {
    return
  }
  let b = current_site_boost()
  match app_state.boosts_css_field {
    Some(f) => if !f.focused() {
      app_state.syncing_boosts_css = true
      f.set(b.custom_css)
      app_state.syncing_boosts_css = false
    }
    None => ()
  }
}

fn set_host_reader_state(json : String) -> Unit {
  match proto::parse_reader_article(json) {
    Some(art) => {
      app_state.reader_article = art
      match app_state.reader_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_reader_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn set_host_boosts_state_from_pane(from_pane : Int, json : String) -> Unit {
  match proto::parse_boosts_snapshot_with_legacy(json) {
    Some((snap, legacy)) => {
      if from_pane == 1 {
        shell_adapter.split_boosts_snap = snap
        shell_adapter.split_boosts_legacy_bare = legacy
      } else {
        app_state.boosts_snap = snap
        shell_adapter.boosts_legacy_bare = legacy
      }
      let is_open = shell_sig_is_true(app_state.boosts_open)
      // (the page's own Done ended Zap in the panel's pane: the panel's Zap row turns off with it)
      if boost_zap_flag[0] && from_pane == shell_adapter.boosts_owner_pane && proto::boosts_snapshot_zap_done(json) {
        boost_zap_flag[0] = false
      }
      if !is_open || from_pane == shell_adapter.boosts_owner_pane {
        sync_boosts_css_field_from_host()
        sync_boosts_js_field_from_host()
        match app_state.boosts_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
        match app_state.host_boosts_synced {
          Some(s) => s.set(true)
          None => ()
        }
      }
    }
    None => ()
  }
}

fn set_host_boosts_state(json : String) -> Unit {
  set_host_boosts_state_from_pane(0, json)
}

fn set_host_reader_state_from_pane(from_pane : Int, json : String) -> Unit {
  if !shell_sig_is_true(app_state.reader_open) || from_pane != shell_adapter.reader_owner_pane {
    return
  }
  let (resp_rid, art_opt) = proto::parse_reader_article_envelope(json)
  let art = match art_opt {
    Some(a) => a
    None => return
  }
  match resp_rid {
    Some(rid) => if rid == "" || rid != shell_adapter.reader_expected_req_id {
      return
    }
    None => {
      if !shell_sig_is_true(app_state.host_reader_synced) {
        shell_adapter.reader_status = 1
        match app_state.reader_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
      }
      return
    }
  }
  shell_adapter.reader_status = 2
  app_state.reader_article = art
  match app_state.reader_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.host_reader_synced {
    Some(s) => s.set(true)
    None => ()
  }
}

fn open_reader_mode() -> Unit {
  close_exclusive_overlays()
  let owner = shell_active_pane_index()
  let raw = shell_pane_raw_url(owner)
  shell_adapter.reader_owner_pane = owner
  shell_release_pane_stage_focus(owner)
  shell_adapter.reader_expected_url = raw
  shell_adapter.reader_committed_origin = boosts_canonical_origin(raw)
  shell_adapter.reader_status = 0
  clear_reader_article_cache()
  match app_state.reader_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_page_set_active_reader(true)
  dispatch_reader_extract()
}

fn close_reader_mode() -> Unit {
  shell_adapter.reader_owner_pane = -1
  shell_adapter.reader_expected_url = ""
  shell_adapter.reader_committed_origin = ""
  shell_adapter.reader_expected_req_id = ""
  shell_adapter.reader_status = 0
  clear_reader_article_cache()
  match app_state.reader_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_page_set_active_reader(false)
}

fn toggle_reader_mode() -> Unit {
  let is_open = match app_state.reader_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_reader_mode()
  } else {
    open_reader_mode()
  }
}

fn close_boosts() -> Unit {
  // (Zap ends with the panel: the page stops picking before the panel lets go of its site)
  if boost_zap_flag[0] {
    boost_zap_flag[0] = false
    send_wire_to_pane(shell_adapter.boosts_owner_pane, wire::Message::Act("boost_zap", "0", ""))
  }
  if boosts_js_field().focused() {
    boosts_js_field().let_go()
  }
  match app_state.boosts_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  match app_state.boosts_css_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  clear_boosts_css_draft_dirty()
  shell_adapter.boosts_committed_host = ""
  shell_adapter.boosts_committed_origin = ""
  shell_mark_exclusive_closed("boosts")
}

fn open_boosts() -> Unit {
  close_exclusive_overlays()
  let owner = shell_active_pane_index()
  let raw = shell_pane_raw_url(owner)
  let next_host = cookies_canonical_host(raw)
  let next_key = owner.to_string() + "|" + next_host
  if shell_adapter.boosts_css_draft_key != next_key {
    clear_boosts_css_draft_dirty()
  }
  shell_adapter.boosts_owner_pane = owner
  shell_adapter.boosts_committed_host = next_host
  shell_adapter.boosts_committed_origin = boosts_canonical_origin(raw)
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  sync_boosts_css_field_from_host()
  sync_boosts_js_field_from_host()
  match app_state.boosts_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Drawer, "boosts")
  dispatch_boost_sync_for_pane(owner)
}

fn toggle_boosts() -> Unit {
  let is_open = match app_state.boosts_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_boosts()
  } else {
    open_boosts()
  }
}

fn ensure_demo_reader_sepia_seeded() -> Unit {
  if !app_state.demo_reader_sepia {
    return
  }
  let target_theme = if app_state.initial_reader_theme != "" {
    proto::normalize_reader_paper_theme(app_state.initial_reader_theme)
  } else {
    "sepia"
  }
  match app_state.reader_theme {
    Some(s) => if s.untracked() != target_theme { s.set(target_theme) }
    None => ()
  }
  match app_state.reader_font {
    Some(s) => if s.untracked() != "serif" { s.set("serif") }
    None => ()
  }
  match app_state.reader_font_size {
    Some(s) => if s.untracked() != 18 { s.set(18) }
    None => ()
  }
  match app_state.reader_width_mode {
    Some(s) => if s.untracked() != "medium" { s.set("medium") }
    None => ()
  }
  match app_state.reader_progress {
    Some(s) => if s.untracked() < 0.05 { s.set(0.38) }
    None => ()
  }
  if app_state.reader_article.blocks.length() >= 4 && app_state.reader_article.word_count >= 180 {
    return
  }
  let blocks : Array[proto::ReaderBlock] = [
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "Modern desktop browsers spend a surprising share of every 16ms frame budget translating high-level document trees across process boundaries, re-rasterizing chrome layers, and fighting platform text metrics. Farview takes a different path: keep page execution isolated on the host while running CSS cascade, incremental layout, and retained-mode GPU painting natively on the client.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Heading,
      level: 2,
      text: "Why Retained Metal Trees Beat Video-Stream Browsers",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "When a remote browser streams pre-rendered pixel frames, scrolling latency, subpixel font clarity, and local form editing immediately degrade. By syncing authoritative DOM mutations and compact style sheets instead of pixel buffers, the client preserves crisp 2x CoreText typography, instantaneous hover feedback, and zero-jitter native scrolling even over high-latency links.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Quote,
      level: 0,
      text: "Good reading software should disappear into warm paper, balanced line lengths, and effortless typography — never competing with the ideas on the page.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Heading,
      level: 2,
      text: "中文排版与双语阅读体验设计",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "在长文阅读场景中，中英文混排的字数统计与阅读时长估算必须同时兼顾按词计数的拉丁文本与按字计数的东亚文字。羊皮纸色调降低屏幕高对比度眩光，配合 620pt 至 840pt 三档栏宽与 14px 至 24px 步进字号，无论是在宽屏显示器还是紧凑分屏中都能保持舒适的每行字数与呼吸感。",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::ListItem,
      level: 0,
      text: "Incremental layout touches only dirty subtrees so typography changes reflow in under a millisecond.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::ListItem,
      level: 0,
      text: "Three calibrated paper surfaces (Light, Sepia, and Night) preserve legibility across daylight and late-night sessions.",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Code,
      level: 0,
      text: "let metrics = proto::compute_reader_metrics(article.blocks, title=article.title)\nlet col_pt = proto::reader_column_width_pt(width_mode) // 620 / 720 / 840pt",
    },
    proto::ReaderBlock::{
      kind: proto::ReaderBlockKind::Paragraph,
      level: 0,
      text: "Combined with Arc-style colored tab folders and named workspace session snapshots, deep research threads stay organized without losing reading focus. Switch back to the live page at any moment with a single shortcut, or adjust column measure and typeface without touching the underlying document.",
    },
  ]
  let title = "Designing Low-Latency Native Metal Browsers for Deep Reading"
  let metrics = proto::compute_reader_metrics(blocks, title=title)
  app_state.reader_article = proto::ReaderArticle::{
    url: "https://farview.dev/notes/native-metal-reader-architecture",
    host: "farview.dev",
    title: title,
    byline: "Farview Engineering Notes — Typography & Rendering",
    read_minutes: metrics.read_minutes,
    word_count: metrics.word_count,
    blocks: blocks,
  }
  match app_state.reader_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.host_reader_synced {
    Some(s) => s.set(true)
    None => ()
  }
}

fn active_devtools_snap() -> proto::DevToolsSnapshot {
  if shell_adapter.devtools_owner_pane == 1 {
    shell_adapter.split_devtools_snap
  } else {
    app_state.devtools_snap
  }
}

fn dispatch_devtools_inspect(path : String) -> Unit {
  send_wire_to_pane(shell_adapter.devtools_owner_pane, wire::Message::Act("devtools_inspect", path, ""))
}

fn dispatch_devtools_eval(expr : String) -> Unit {
  let trimmed = expr.trim()
  if trimmed == "" {
    return
  }
  send_wire_to_pane(shell_adapter.devtools_owner_pane, wire::Message::Act("devtools_eval", trimmed, ""))
}

fn dispatch_devtools_clear() -> Unit {
  send_wire_to_pane(shell_adapter.devtools_owner_pane, wire::Message::Act("devtools_clear", "console", ""))
}

fn dt_doc_key(pane_id : Int, page_url : String) -> String {
  pane_id.to_string() + "|" + page_url.trim()
}

fn dt_put_doc_net(key : String, idx : Int) -> Unit {
  if key == "" {
    return
  }
  if shell_adapter.devtools_doc_net_sel.length() >= 32 && !shell_adapter.devtools_doc_net_sel.contains(key) {
    shell_adapter.devtools_doc_net_sel.clear()
  }
  shell_adapter.devtools_doc_net_sel.set(key, idx)
}

fn dt_put_doc_dom(key : String, path : String) -> Unit {
  if key == "" {
    return
  }
  if shell_adapter.devtools_doc_dom_sel.length() >= 32 && !shell_adapter.devtools_doc_dom_sel.contains(key) {
    shell_adapter.devtools_doc_dom_sel.clear()
  }
  shell_adapter.devtools_doc_dom_sel.set(key, path)
}

fn dt_flush_active_doc_state() -> Unit {
  let key = shell_adapter.devtools_active_doc_key
  if key == "" {
    return
  }
  let cur_net = match app_state.devtools_net_selected_idx {
    Some(s) => s.untracked()
    None => -1
  }
  let cur_dom = match app_state.devtools_selected_path {
    Some(s) => s.untracked()
    None => ""
  }
  dt_put_doc_net(key, cur_net)
  dt_put_doc_dom(key, cur_dom)
}

fn dt_switch_doc_state(next_key : String, default_dom_sel : String) -> Unit {
  let prev_key = shell_adapter.devtools_active_doc_key
  if prev_key == next_key {
    return
  }
  if prev_key != "" {
    dt_flush_active_doc_state()
  }
  shell_adapter.devtools_active_doc_key = next_key
  let restored_net = shell_adapter.devtools_doc_net_sel.get(next_key).unwrap_or(-1)
  let restored_dom = shell_adapter.devtools_doc_dom_sel.get(next_key).unwrap_or(default_dom_sel)
  match app_state.devtools_net_selected_idx {
    Some(s) => s.set(restored_net)
    None => ()
  }
  match app_state.devtools_selected_path {
    Some(s) => s.set(restored_dom)
    None => ()
  }
  match shell_adapter.devtools_panel_state {
    Some(dt) => {
      dt.net_selected_idx.set(restored_net)
      dt.selected_path.set(restored_dom)
    }
    None => ()
  }
}

fn set_host_devtools_state_from_pane(from_pane : Int, json : String) -> Unit {
  match proto::parse_devtools_snapshot(json) {
    Some(snap) => {
      if from_pane == 1 {
        shell_adapter.split_devtools_snap = snap
      } else {
        app_state.devtools_snap = snap
      }
      let is_open = shell_sig_is_true(app_state.devtools_open)
      if !is_open {
        // Never overwrite shared live selection while DevTools is closed;
        // seed the document's slot only if the user has not selected a path there yet.
        if snap.page_url.trim() != "" && snap.selected_path != "" {
          let snap_key = dt_doc_key(from_pane, snap.page_url)
          if !shell_adapter.devtools_doc_dom_sel.contains(snap_key) {
            dt_put_doc_dom(snap_key, snap.selected_path)
          }
        }
        match app_state.devtools_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
        match app_state.host_devtools_synced {
          Some(s) => s.set(true)
          None => ()
        }
      } else if from_pane == shell_adapter.devtools_owner_pane {
        if snap.page_url.trim() != "" {
          dt_switch_doc_state(dt_doc_key(from_pane, snap.page_url), snap.selected_path)
        }
        if snap.selected_path != "" {
          match app_state.devtools_selected_path {
            Some(sp) => sp.set(snap.selected_path)
            None => ()
          }
          match shell_adapter.devtools_panel_state {
            Some(dt) => dt.selected_path.set(snap.selected_path)
            None => ()
          }
          if shell_adapter.devtools_active_doc_key != "" {
            dt_put_doc_dom(shell_adapter.devtools_active_doc_key, snap.selected_path)
          }
        }
        match app_state.devtools_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
        match app_state.host_devtools_synced {
          Some(s) => s.set(true)
          None => ()
        }
      }
    }
    None => ()
  }
}

fn set_host_devtools_state(json : String) -> Unit {
  set_host_devtools_state_from_pane(0, json)
}

fn open_devtools(tab_idx~ : Int = -1) -> Unit {
  let owner = shell_active_pane_index()
  shell_adapter.devtools_owner_pane = owner
  shell_adapter.devtools_owner_pane_sig.set(owner)
  let snap = active_devtools_snap()
  let doc_url = if snap.page_url.trim() != "" { snap.page_url } else { shell_pane_raw_url(owner) }
  dt_switch_doc_state(dt_doc_key(owner, doc_url), snap.selected_path)
  if tab_idx >= 0 && tab_idx <= 2 {
    match app_state.devtools_tab {
      Some(t) => t.set(tab_idx)
      None => ()
    }
    match shell_adapter.devtools_panel_state {
      Some(dt) => dt.tab.set(tab_idx)
      None => ()
    }
  }
  match app_state.devtools_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_sync_dock_from_app()
  let sel = match app_state.devtools_selected_path {
    Some(sp) => sp.untracked()
    None => ""
  }
  dispatch_devtools_inspect(sel)
}

fn close_devtools() -> Unit {
  dt_flush_active_doc_state()
  match app_state.devtools_open {
    Some(s) => s.set(false)
    None => ()
  }
  shell_sync_dock_from_app()
}

fn toggle_devtools() -> Unit {
  let is_open = match app_state.devtools_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_devtools()
  } else {
    open_devtools()
  }
}

fn submit_devtools_repl(raw : String) -> Unit {
  let trimmed = raw.trim()
  if trimmed == "" {
    return
  }
  match app_state.devtools_repl_field {
    Some(f) => f.set("")
    None => ()
  }
  dispatch_devtools_eval(trimmed)
}

