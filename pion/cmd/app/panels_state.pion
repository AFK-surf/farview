// --- Dispatchers & State Transitions ---

fn dispatch_space_new_with_accent(name : String, accent_hex : String) -> Unit {
  let clean = name.trim()
  let final_name = if clean != "" { clean } else { proto::next_auto_space_name(app_state.workspace) }
  let hex = proto::space_accent_hex_for_key(accent_hex)
  send_wire(wire::Message::Act("space_new", final_name, hex))
  show_toast("Created Space \"" + final_name + "\"", "info")
}

fn dispatch_space_accent(space_id : String, accent_hex : String) -> Unit {
  if space_id == "" {
    return
  }
  let hex = proto::space_accent_hex_for_key(accent_hex)
  send_wire(wire::Message::Act("space_accent", space_id, hex))
}

fn dispatch_closed_tabs_sync() -> Unit {
  send_wire(wire::Message::Act("closed_tabs_sync", "", ""))
}

fn dispatch_tab_reopen_at(index : Int, title : String) -> Unit {
  send_wire(wire::Message::Act("tab_reopen_at", index.to_string(), ""))
  let lbl = if title.trim() != "" { title.trim() } else { "Closed Tab" }
  show_toast("Restored \"" + lbl + "\"", "info")
}

fn dispatch_closed_tabs_clear() -> Unit {
  app_state.closed_tabs_snap = proto::ClosedTabsSnapshot::empty()
  match app_state.closed_tabs_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("closed_tabs_clear", "", ""))
  show_toast("Cleared recently closed tabs", "clear")
}

fn dispatch_export_pdf_with_config(cfg : proto::PrintPdfConfig) -> Unit {
  let owner = app_state.print_owner_pane
  let cfg_json = proto::encode_print_pdf_config(cfg)
  dispatch_export_pdf_for_pane(owner, cfg_json)
}

fn set_host_closed_tabs_state(json : String) -> Unit {
  match proto::parse_closed_tabs_state(json, max_items=proto::CLOSED_TABS_MAX_ITEMS) {
    Some(snap) => {
      app_state.closed_tabs_snap = snap
      match app_state.closed_tabs_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_closed_tabs_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_spaces_manager() -> Unit {
  match app_state.spaces_new_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.spaces_rename_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.spaces_edit_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.spaces_color_edit_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.spaces_manager_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("spaces_manager")
}

fn open_spaces_manager(focus_new~ : Bool = false) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.spaces_edit_id {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.spaces_color_edit_id {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.spaces_manager_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "spaces_manager")
  if focus_new {
    match app_state.spaces_new_field {
      Some(f) => f.focus()
      None => ()
    }
  }
  dispatch_workspace_sync()
}

fn toggle_spaces_manager() -> Unit {
  let is_open = match app_state.spaces_manager_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_spaces_manager()
  } else {
    open_spaces_manager()
  }
}

fn close_closed_tabs_modal() -> Unit {
  match app_state.closed_tabs_field {
    Some(f) => {
      if f.focused() { f.let_go() }
      if f.text() != "" { f.set("") }
    }
    None => ()
  }
  match app_state.closed_tabs_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("closed_tabs")
}

fn open_closed_tabs_modal() -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.closed_tabs_field {
    Some(f) => f.set("")
    None => ()
  }
  match app_state.closed_tabs_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "closed_tabs")
  dispatch_closed_tabs_sync()
}

fn toggle_closed_tabs_modal() -> Unit {
  let is_open = match app_state.closed_tabs_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_closed_tabs_modal()
  } else {
    open_closed_tabs_modal()
  }
}

fn close_print_pdf_modal() -> Unit {
  match app_state.print_pdf_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("print_pdf")
}

fn open_print_pdf_modal() -> Unit {
  let owner = shell_active_pane_index()
  close_exclusive_overlays()
  app_state.print_owner_pane = owner
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.print_pdf_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "print_pdf")
}

fn toggle_print_pdf_modal() -> Unit {
  let is_open = match app_state.print_pdf_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_print_pdf_modal()
  } else {
    open_print_pdf_modal()
  }
}

fn current_print_pdf_config() -> proto::PrintPdfConfig {
  let paper = match app_state.print_paper {
    Some(s) => s.get()
    None => "a4"
  }
  let orientation = match app_state.print_orientation {
    Some(s) => s.get()
    None => "portrait"
  }
  let margins = match app_state.print_margins {
    Some(s) => s.get()
    None => "default"
  }
  let background_graphics = match app_state.print_bg_graphics {
    Some(s) => s.get()
    None => true
  }
  proto::PrintPdfConfig::{ paper, orientation, margins, background_graphics }
}

fn current_print_pdf_config_untracked() -> proto::PrintPdfConfig {
  let paper = match app_state.print_paper {
    Some(s) => s.untracked()
    None => "a4"
  }
  let orientation = match app_state.print_orientation {
    Some(s) => s.untracked()
    None => "portrait"
  }
  let margins = match app_state.print_margins {
    Some(s) => s.untracked()
    None => "default"
  }
  let background_graphics = match app_state.print_bg_graphics {
    Some(s) => s.untracked()
    None => true
  }
  proto::PrintPdfConfig::{ paper, orientation, margins, background_graphics }
}
