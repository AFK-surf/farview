      match app_state.reader_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_reader_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn set_host_boosts_state(json : String) -> Unit {
  match proto::parse_boosts_snapshot(json) {
    Some(snap) => {
      app_state.boosts_snap = snap
      sync_boosts_css_field_from_host()
      match app_state.boosts_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_boosts_synced {
