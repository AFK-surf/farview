fn set_host_reader_state_from_pane(from_pane : Int, json : String) -> Unit {
  if !shell_sig_is_true(app_state.reader_open) || from_pane != shell_adapter.reader_owner_pane {
    return
  }
  let (resp_rid, art_opt) = proto::parse_reader_article_envelope(json)
  let art = match art_opt {
    Some(a) => a
    None => return
  }
  match resp_rid {
    Some(rid) => if rid == "" || rid != shell_adapter.reader_expected_req_id {
      return
    }
    None => {
      if !shell_sig_is_true(app_state.host_reader_synced) {
        shell_adapter.reader_status = 1
        match app_state.reader_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
      }
      return
    }
  }
  shell_adapter.reader_status = 2
  app_state.reader_article = art
  match app_state.reader_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.host_reader_synced {
    Some(s) => s.set(true)
    None => ()
  }
}

fn open_reader_mode() -> Unit {
  close_exclusive_overlays()
  let owner = if active_targets_split() { 1 } else { 0 }
  shell_adapter.reader_owner_pane = owner
  shell_release_pane_stage_focus(owner)
  shell_adapter.reader_expected_url = if app_state.stage.is_some() {
    active_address_raw_url_untracked()
  } else {
    ""
  }
  shell_adapter.reader_status = 0
  clear_reader_article_cache()
  match app_state.reader_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_page_set_active_reader(true)
  dispatch_reader_extract()
}

fn close_reader_mode() -> Unit {
  shell_adapter.reader_owner_pane = -1
  shell_adapter.reader_expected_url = ""
  shell_adapter.reader_expected_req_id = ""
  shell_adapter.reader_status = 0
  clear_reader_article_cache()
  match app_state.reader_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_page_set_active_reader(false)
}

fn toggle_reader_mode() -> Unit {
  let is_open = match app_state.reader_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_reader_mode()
  } else {
    open_reader_mode()
  }
}

