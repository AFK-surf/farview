///| Upgraded Address Bar Site Info & Permissions Popover (Camera, Microphone,
///| Notifications, Location, Clipboard per-origin persistence + Reset + Clear Site Data).
///| Strictly follows concentric corner radii, first-line alignment, zero double dividers,
///| zero `alpha=0` clickable buttons, and zero `ellipsis_past(true)`.

///| Builds the upgraded Address Bar Site Security & Storage Inspector Popover (`🔒` lock icon or `⌘I`).
///| 100% reactive to `ChromePalette` Light & Dark themes, concentric radii 12 -> 8 -> 6.5 -> 4.5,
///| with HTTPS/Local/HTTP security header card, real `omnibox_analyze_url` IDN Domain Verification row,
///| Quick Site Status row (live Cookies count -> `open_cookies_modal()`, live Zoom % -> `open_zoom_popover()`),
///| active Boost indicator, 5 per-origin permissions (Camera, Microphone, Notifications, Location, Clipboard),
///| and Reset / Clear Site Data actions.
fn build_site_info_popover(
  root : view::View,
  st : stage::Stage,
  site_info_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  site_perms_rev : signals::Signal[Int],
  boosts_rev : signals::Signal[Int],
  cookies_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { site_info_open.get() },
    fn(pop : view::View) -> Unit {
      let _ = pop
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        match app_state.address_bar_view {
          Some(ab) => {
            let (ax, ay, aw, ah) = ab.placed_now()
            if aw > 120.0 {
              (Some(ax), Some(ay + ah + 6.0), None, None)
            } else {
              (Some(156.0), Some(48.0), None, None)
            }
          }
          None => (Some(156.0), Some(48.0), None, None)
        }
      }))
      .width(view::Live::Is(Some(356.0)))
      .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
      .gap(view::Live::Is(9.0))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (26.0, 10.0, 0x00000078L) } else { (22.0, 8.0, 0x0F172A28L) }
      }))

      let current_url = fn() -> String {
        let _ = workspace_rev.get()
        let u = active_address_raw_url()
        if u != "" {
          u
        } else {
          match app_state.workspace.permissions {
            Some(pm) if pm.origin != "" => pm.origin
            _ => "about:newtab"
          }
        }
      }
      let current_origin = fn() -> String {
        let u = current_url()
        let norm = proto::normalize_permission_origin(u)
        let raw_origin = if norm != "" { norm } else { proto::site_origin_from_url(u) }
        proto::omnibox_safe_display_url(raw_origin)
      }
      let sec_kind = fn() -> Int {
        // 0 = HTTPS secure, 1 = Local development, 2 = Not secure (HTTP)
        let u = current_url()
        if proto::site_is_https(u) {
          0
        } else if proto::site_is_local(u) || proto::is_start_page_url(u) {
          1
        } else {
          2
        }
      }
      let idn_info = fn() -> proto::SiteIdnVerification {
        proto::build_site_idn_verification(current_url())
      }
      let active_boost_opt = fn() -> Option[proto::SiteBoost] {
        let _ = boosts_rev.get()
        let h = proto::normalize_boost_host(current_url())
        if h == "" { None } else { proto::boosts_find(app_state.boosts_snap, h) }
      }

      // 1. Header: Origin + Connection Security Card + IDN Domain Verification Row + Optional Arc Boost Pill
      let _ = pop.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr.gap(view::Live::Is(7.0))

          // Origin line
          let _ = hdr.box(
            fn(orow : view::View) -> Unit {
              let _ = orow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))
              .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
              let _ = orow.box(
                fn(orig_w : view::View) -> Unit {
                  let _ = orig_w
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(current_origin),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              // Close button
              let _ = headless::button(
                orow,
                fn() -> String { "Close Site Info" },
                fn(_v : view::View) -> Unit { close_site_info() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(22.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Connection & Domain Security Header Card (HTTPS Encrypted / Local / HTTP + IDN Domain Verification)
          let _ = hdr.box(
            fn(sec_wrap : view::View) -> Unit {
              let _ = sec_wrap
              .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
              .gap(view::Live::Is(7.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 {
                let dark = is_dark_chrome()
                let idn = idn_info()
                if idn.status_code == 2 {
                  if dark { 0x322512FFL } else { 0xFFFBEBFFL }
                } else {
                  let k = sec_kind()
                  if k == 0 {
                    if dark { 0x132A21FFL } else { 0xECFDF3FFL }
                  } else if k == 1 {
                    if dark { 0x17253BFFL } else { 0xEFF6FFFFL }
                  } else if dark {
                    0x322512FFL
                  } else {
                    0xFFFBEBFFL
                  }
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let dark = is_dark_chrome()
                let idn = idn_info()
                if idn.status_code == 2 {
                  (1.0, if dark { 0x78350FFFL } else { 0xF3D08BFFL })
                } else {
                  let k = sec_kind()
                  if k == 0 {
                    (1.0, if dark { 0x1E4B38FFL } else { 0xBBF7D0FFL })
                  } else if k == 1 {
                    (1.0, if dark { 0x264169FFL } else { 0xBFDBFEFFL })
                  } else {
                    (1.0, if dark { 0x5B411BFFL } else { 0xFDE68AFFL })
                  }
                }
              }))

              // Connection status row
              let _ = sec_wrap.box(
                fn(conn_row : view::View) -> Unit {
                  let _ = conn_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(8.0))

                  let _ = conn_row.box(
                    fn(icon : view::View) -> Unit {
                      let _ = icon
                      .width(view::Live::Is(Some(16.0)))
                      .height(view::Live::Is(Some(16.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(8.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let k = sec_kind()
                        if k == 0 { 0x10B981FFL } else if k == 1 { 0x3B82F6FFL } else { 0xF59E0BFFL }
                      }))
                      let _ = icon.box(
                        fn(gl : view::View) -> Unit {
                          let _ = gl.words(
                            view::Live::By(fn() -> String {
                              let k = sec_kind()
                              if k == 0 { "✓" } else if k == 1 { "i" } else { "!" }
                            }),
                            ink=0xFFFFFFFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 700, wrap: false },
                            one_line=true,
                          )
                        },
                      )
                    },
                  )

                  let _ = conn_row.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::By(fn() -> String {
                          let k = sec_kind()
                          if k == 0 {
                            "HTTPS Encrypted"
                          } else if k == 1 {
                            "Local / HTTP"
                          } else {
                            "Not Secure (HTTP)"
                          }
                        }),
                        ink=0x137333FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let dark = is_dark_chrome()
                        let k = sec_kind()
                        if k == 0 {
                          if dark { 0x6EE7B7FFL } else { 0x15803DFFL }
                        } else if k == 1 {
                          if dark { 0x93C5FDFFL } else { 0x1D4ED8FFL }
                        } else if dark {
                          0xFCD34DFFL
                        } else {
                          0xB45309FFL
                        }
                      }))
                    },
                  )

                  // Protocol pill
                  let _ = conn_row.box(
                    fn(pb : view::View) -> Unit {
                      let _ = pb
                      .height(view::Live::Is(Some(19.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                      .radius(view::Live::Is(4.5))
                      .ground(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0x0F172A55L } else { 0xFFFFFFB8L }
                      }))
                      let _ = pb.box(
                        fn(pt : view::View) -> Unit {
                          let _ = pt
                          .words(
                            view::Live::By(fn() -> String {
                              let k = sec_kind()
                              if k == 0 { "TLS" } else if k == 1 { "LOCAL" } else { "HTTP" }
                            }),
                            ink=0x3A4152FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                    },
                  )
                },
              )

              // IDN Domain Verification Row (powered by `proto::omnibox_analyze_url`)
              let _ = sec_wrap.box(
                fn(idn_row : view::View) -> Unit {
                  let _ = idn_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(6.0))
                  .padding(view::Live::Is((8.0, 5.0, 8.0, 5.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let dark = is_dark_chrome()
                    let st_c = idn_info().status_code
                    if st_c == 2 {
                      if dark { 0x4A3314FFL } else { 0xFEF3C7FFL }
                    } else if dark {
                      0x0F172A44L
                    } else {
                      0xFFFFFFB0L
                    }
                  }))

                  let _ = idn_row.box(
                    fn(idot : view::View) -> Unit {
                      let _ = idot
                      .width(view::Live::Is(Some(6.0)))
                      .height(view::Live::Is(Some(6.0)))
                      .rigid()
                      .radius(view::Live::Is(3.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let st_c = idn_info().status_code
                        if st_c == 2 {
                          0xF59E0BFFL
                        } else if st_c == 1 || st_c == 0 {
                          0x10B981FFL
                        } else {
                          0x3B82F6FFL
                        }
                      }))
                    },
                  )

                  let _ = idn_row.box(
                    fn(ilbl : view::View) -> Unit {
                      let _ = ilbl
                      .rigid()
                      .words(
                        view::Live::By(fn() -> String { idn_info().badge_label }),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let dark = is_dark_chrome()
                        if idn_info().status_code == 2 {
                          if dark { 0xFBBF24FFL } else { 0x92400EFFL }
                        } else {
                          chrome_palette().ink_primary
                        }
                      }))
                    },
                  )

                  let _ = idn_row.box(
                    fn(idet : view::View) -> Unit {
                      let _ = idet
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::By(fn() -> String {
                          let info = idn_info()
                          if info.status_code == 2 && info.safe_punycode != "" {
                            info.safe_punycode
                          } else if info.status_code == 1 {
                            proto::omnibox_analyze_url(current_url()).display_host
                          } else {
                            info.detail_line
                          }
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let dark = is_dark_chrome()
                        if idn_info().status_code == 2 {
                          if dark { 0xFDE68AFFL } else { 0xB45309FFL }
                        } else {
                          chrome_palette().ink_muted
                        }
                      }))
                    },
                  )
                },
              )
            },
          )

          // Quick Site Status Row: Cookies count (-> open_cookies_modal) + Page Zoom (-> open_zoom_popover)
          let _ = hdr.box(
            fn(qrow : view::View) -> Unit {
              let _ = qrow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(332.0)))
              .gap(view::Live::Is(8.0))

              // Cookies card button
              let _ = headless::button(
                qrow,
                fn() -> String { "Inspect Site Cookies" },
                fn(_v : view::View) -> Unit {
                  let h = proto::omnibox_display_host(current_url())
                  open_cookies_modal(host_override=h)
                },
                fn(cb : view::View, btn : headless::Button) -> Unit {
                  let _ = cb
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(46.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((10.0, 0.0, 9.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                  let _ = cb.box(
                    fn(cm : view::View) -> Unit {
                      let _ = cm
                      .grow(view::Live::Is(1.0))
                      .gap(view::Live::Is(2.0))
                      let _ = cm.box(
                        fn(k : view::View) -> Unit {
                          let _ = k
                          .words(
                            view::Live::Is("Cookies"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                      let _ = cm.box(
                        fn(v : view::View) -> Unit {
                          let _ = v
                          .words(
                            view::Live::By(fn() -> String {
                              let _ = cookies_rev.get()
                              proto::format_site_cookies_count(app_state.cookies_snap.cookies.length())
                            }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )

                  let _ = cb.box(
                    fn(ar : view::View) -> Unit {
                      let _ = ar
                      .rigid()
                      .words(
                        view::Live::Is("›"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Zoom card button
              let _ = headless::button(
                qrow,
                fn() -> String { "Open Zoom Controls" },
                fn(_v : view::View) -> Unit { open_zoom_popover() },
                fn(zb : view::View, btn : headless::Button) -> Unit {
                  let _ = zb
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(46.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((10.0, 0.0, 9.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                  let _ = zb.box(
                    fn(zm : view::View) -> Unit {
                      let _ = zm
                      .grow(view::Live::Is(1.0))
                      .gap(view::Live::Is(2.0))
                      let _ = zm.box(
                        fn(k : view::View) -> Unit {
                          let _ = k
                          .words(
                            view::Live::Is("Page Zoom"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                      let _ = zm.box(
                        fn(v : view::View) -> Unit {
                          let _ = v
                          .words(
                            view::Live::By(fn() -> String { st.zoom_percent().to_string() + "%" }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )

                  let _ = zb.box(
                    fn(ar : view::View) -> Unit {
                      let _ = ar
                      .rigid()
                      .words(
                        view::Live::Is("›"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Optional Active Arc Boost Indicator (only rendered when a Boost is active for this host)
          hdr.show(
            fn() -> Bool { active_boost_opt().is_some() },
            fn(b_wrap : view::View) -> Unit {
              let _ = headless::button(
                b_wrap,
                fn() -> String { "Edit Active Arc Boost" },
                fn(_v : view::View) -> Unit {
                  close_site_info()
                  open_boosts()
                },
                fn(bp : view::View, btn : headless::Button) -> Unit {
                  let _ = bp
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(28.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(7.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let dark = is_dark_chrome()
                    if btn.pressed() {
                      if dark { 0x2F254DFFL } else { 0xDDD6FEFFL }
                    } else if btn.hovered() {
                      if dark { 0x282043FFL } else { 0xEDE9FEFFL }
                    } else if dark {
                      0x211B38FFL
                    } else {
                      0xF5F3FFFFL
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    (1.0, if is_dark_chrome() { 0x453573FFL } else { 0xDDD6FEFFL })
                  }))
                  let _ = bp.box(
                    fn(bi : view::View) -> Unit {
                      let _ = bi.words(
                        view::Live::Is("✦"),
                        ink=0x8B5CF6FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                  let _ = bp.box(
                    fn(bt : view::View) -> Unit {
                      let _ = bt
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("Arc Boost active on this site"),
                        ink=0x6D28D9FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0xC4B5FDFFL } else { 0x6D28D9FFL }
                      }))
                    },
                  )
                  let _ = bp.box(
                    fn(be : view::View) -> Unit {
                      let _ = be
                      .words(
                        view::Live::Is("Edit"),
                        ink=0x7C3AEDFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0xA78BFAFFL } else { 0x7C3AEDFFL }
                      }))
                    },
                  )
                },
              )
            },
          )
        },
      )

      // Single 1pt divider
      let _ = pop.box(
        fn(sep : view::View) -> Unit {
          let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // 2. Site Permissions List (Camera, Microphone, Notifications, Location, Clipboard)
      let _ = pop.box(
        fn(psec : view::View) -> Unit {
          let _ = psec.gap(view::Live::Is(5.0))
          let _ = psec.box(
            fn(pl : view::View) -> Unit {
              let _ = pl
              .padding(view::Live::Is((2.0, 0.0, 2.0, 2.0)))
              .words(
                view::Live::Is("SITE PERMISSIONS"),
                ink=0x8E8E93FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )

          let render_perm_row = fn(label : String, kind_key : String, read_val : (proto::SitePermissionRule) -> String) -> Unit {
            let cur_state = fn() -> String {
              let _ = site_perms_rev.get()
              let r = active_site_permission_rule(current_url())
              proto::normalize_site_perm_value(read_val(r))
            }
            let _ = psec.box(
              fn(row : view::View) -> Unit {
                let _ = row
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .width(view::Live::Is(Some(332.0)))
                .height(view::Live::Is(Some(32.0)))
                .rigid()
                .gap(view::Live::Is(8.0))
                .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))

                // Status dot
                let _ = row.box(
                  fn(dot : view::View) -> Unit {
                    let _ = dot
                    .width(view::Live::Is(Some(6.0)))
                    .height(view::Live::Is(Some(6.0)))
                    .rigid()
                    .radius(view::Live::Is(3.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let s = cur_state()
                      if s == "allow" {
                        0x10B981FFL
                      } else if s == "block" {
                        0xEF4444FFL
                      } else if is_dark_chrome() {
                        0x475569FFL
                      } else {
                        0xCBD5E1FFL
                      }
                    }))
                  },
                )

                // Permission label
                let _ = row.box(
                  fn(nm : view::View) -> Unit {
                    let _ = nm
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .clips(view::Live::Is(true))
                    .words(
                      view::Live::Is(label),
                      ink=0x1D1D1FFFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                  },
                )

                // 3-state segmented capsule: Ask / Allow / Block (concentric R=6.5, P=2 -> R=4.5)
                let _ = row.box(
                  fn(seg : view::View) -> Unit {
                    let _ = seg
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .rigid()
                    .gap(view::Live::Is(2.0))
                    .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
                    .radius(view::Live::Is(6.5))
                    .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

                    let seg_btn = fn(btn_label : String, target_state : String) -> Unit {
                      let _ = headless::button(
                        seg,
                        fn() -> String { label + " " + btn_label },
                        fn(_v : view::View) -> Unit { dispatch_site_perm_set(current_url(), kind_key, target_state) },
                        fn(b : view::View, btn : headless::Button) -> Unit {
                          let active = fn() -> Bool { cur_state() == target_state }
                          let _ = b
                          .width(view::Live::Is(Some(46.0)))
                          .height(view::Live::Is(Some(22.0)))
                          .rigid()
                          .center()
                          .radius(view::Live::Is(4.5))
                          .ground(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if active() {
                              if target_state == "allow" {
                                if p.is_dark { 0x153428FFL } else { 0xE6F4EAFFL }
                              } else if target_state == "block" {
                                if p.is_dark { 0x3A1E24FFL } else { 0xFCE8E6FFL }
                              } else if p.is_dark {
                                0x303646FFL
                              } else {
                                0xFFFFFFFFL
                              }
                            } else if btn.pressed() {
                              p.btn_press
                            } else if btn.hovered() {
                              p.btn_hover
                            } else {
                              0x00000000L
                            }
                          }))
                          .edge(view::Live::By(fn() -> (Double, Int64) {
                            let p = chrome_palette()
                            if active() {
                              if target_state == "allow" {
                                (1.0, if p.is_dark { 0x225A43FFL } else { 0xA8DAB5FFL })
                              } else if target_state == "block" {
                                (1.0, if p.is_dark { 0x6B2D38FFL } else { 0xF6AEA9FFL })
                              } else {
                                (1.0, p.tab_active_border)
                              }
                            } else {
                              (1.0, 0x00000000L)
                            }
                          }))
                          let _ = b.box(
                            fn(lbl : view::View) -> Unit {
                              let _ = lbl
                              .words(
                                view::Live::Is(btn_label),
                                ink=0x6E6E73FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 {
                                let p = chrome_palette()
                                if active() {
                                  if target_state == "allow" {
                                    if p.is_dark { 0x6EE7B7FFL } else { 0x137333FFL }
                                  } else if target_state == "block" {
                                    if p.is_dark { 0xFCA5A5FFL } else { 0xC5221FFFL }
                                  } else {
                                    p.ink_primary
                                  }
                                } else {
                                  p.ink_muted
                                }
                              }))
                            },
                          )
                        },
                      )
                    }
                    seg_btn("Ask", "ask")
                    seg_btn("Allow", "allow")
                    seg_btn("Block", "block")
                  },
                )
              },
            )
          }

          render_perm_row("Camera", "camera", fn(r : proto::SitePermissionRule) -> String { r.camera })
          render_perm_row("Microphone", "microphone", fn(r : proto::SitePermissionRule) -> String { r.microphone })
          render_perm_row("Notifications", "notifications", fn(r : proto::SitePermissionRule) -> String { r.notifications })
          render_perm_row("Location", "geolocation", fn(r : proto::SitePermissionRule) -> String { r.geolocation })
          render_perm_row("Clipboard", "clipboard", fn(r : proto::SitePermissionRule) -> String { r.clipboard })
        },
      )

      // Single 1pt divider before bottom action row
      let _ = pop.box(
        fn(sep : view::View) -> Unit {
          let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // 4. Bottom Action Row: Reset permissions + Clear site data (danger outline)
      let _ = pop.box(
        fn(arow : view::View) -> Unit {
          let _ = arow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .width(view::Live::Is(Some(332.0)))
          .gap(view::Live::Is(8.0))

          let _ = headless::button(
            arow,
            fn() -> String { "Reset permissions" },
            fn(_v : view::View) -> Unit { dispatch_site_perm_reset(current_url()) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(30.0)))
              .center()
              .radius(view::Live::Is(7.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Reset permissions"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
            },
          )

          let _ = headless::button(
            arow,
            fn() -> String { "Clear site data" },
            fn(_v : view::View) -> Unit { dispatch_site_clear_data(current_url()) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(30.0)))
              .center()
              .radius(view::Live::Is(7.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() {
                  if p.is_dark { 0x4A232BFFL } else { 0xFEE2E2FFL }
                } else if btn.hovered() {
                  if p.is_dark { 0x3F2026FFL } else { 0xFEF2F2FFL }
                } else {
                  p.danger_bg
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().danger_border) }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Clear site data"),
                    ink=0xDC2626FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                },
              )
            },
          )
        },
      )
    },
  )
}
