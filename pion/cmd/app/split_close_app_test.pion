///| Closing tabs with Split View open (the sidebar's X, Cmd+W in either pane): the main pane's tab gives the window to
///| the second pane's (shown first, then closed, so the host opens no New Tab in its place), the second pane's tab
///| closes its pane, a pane with no tab of its own closes alone. The second pane's host broadcasting the same Back/
///| Forward lists tells the sidebar nothing, and a second pane whose tab is gone closes. The sidebar's Mini Player
///| shows no media of a tab on screen in either pane.

import "proto"
import "shell_ui"
import "signals"
import "stage"

struct SplitCloseApp {
  srv : Int
  acc : Int
  prev_ws : proto::WorkspaceSnapshot
  prev_host : proto::WorkspaceSnapshot
  prev_stage : Option[stage::Stage]
  prev_split : Option[stage::Stage]
  prev_page : shell_ui::PageLayoutState
  prev_split_tab : Option[signals::Signal[String]]
  prev_rev : Option[signals::Signal[Int]]
}

///| Split View open with tab `split_tab` ("" a page of no tab) in the second pane, the keyboard in pane `focus`; the
///| main host is a loopback socket whose acts the test reads.
fn sca_open(split_tab : String, focus : Int, split_url~ : String = "") -> SplitCloseApp {
  let s = SplitCloseApp::{
    srv: -1,
    acc: -1,
    prev_ws: app_state.workspace,
    prev_host: app_state.workspace_host,
    prev_stage: app_state.stage,
    prev_split: app_state.split_stage,
    prev_page: shell_adapter.page.untracked(),
    prev_split_tab: app_state.split_tab_id,
    prev_rev: app_state.workspace_rev,
  }
  let (srv, cli, acc) = sn_make_loopback_pair()
  let _ = io_rt.main_conn.attach(cli)
  app_state.stage = Some(stage::Stage::new(fn(_b : Bytes) -> Unit { () }))
  let split_st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  if split_url != "" {
    split_st.feed(proto::encode_host(proto::HostMsg::Meta(split_url, "Split", false, false, false)))
  }
  app_state.split_stage = Some(split_st)
  app_state.ws_pending = []
  app_state.workspace = proto::WorkspaceSnapshot::{ ..sf_snapshot("a"), tabs: [sf_tab("a", "sp1"), sf_tab("b", "sp1"), sf_tab("c", "sp1")] }
  app_state.workspace_host = app_state.workspace
  app_state.split_tab_id = Some(signals::signal(split_tab))
  app_state.workspace_rev = Some(signals::signal(0))
  let _ = shell_page_open_split(focus)
  SplitCloseApp::{ ..s, srv, acc }
}

fn sca_close(s : SplitCloseApp) -> Unit {
  let _ = shell_page_close_split()
  let fd = io_rt.main_conn.detach()
  if fd >= 0 {
    net::close(fd)
  }
  net::close(s.acc)
  net::close(s.srv)
  app_state.workspace = s.prev_ws
  app_state.workspace_host = s.prev_host
  app_state.stage = s.prev_stage
  app_state.split_stage = s.prev_split
  shell_adapter.page.set(s.prev_page)
  app_state.split_tab_id = s.prev_split_tab
  app_state.workspace_rev = s.prev_rev
  app_state.ws_pending = []
}

///| The acts sent to the main host so far (at most `n`), in order.
fn sca_acts(s : SplitCloseApp, n : Int) -> Array[(String, String, String)] {
  let _ = io_rt.main_conn.flush_write()
  sf_read_acts(s.acc, n)
}

fn sca_verbs(acts : Array[(String, String, String)]) -> String {
  let parts : Array[String] = []
  for x in acts {
    let (v, a, _) = x
    parts.push(v + "(" + a + ")")
  }
  parts.join(" ")
}

fn sca_split_tab() -> String {
  match app_state.split_tab_id {
    Some(t) => t.untracked()
    None => ""
  }
}

test "split close: the sidebar's X on the main pane's tab shows the second pane's tab first, then closes it, and leaves Split View" {
  let s = sca_open("b", 0)
  dispatch_tab_close("a")
  let acts = sca_acts(s, 2)
  let v = sca_verbs(acts)
  debug_assert(v == "tab_switch(b) tab_close(a)", "b shown before a closes, so the host opens nothing in a's place: \{v}")
  debug_assert(!is_split_open() && sca_split_tab() == "", "Split View closed: b is the window's page")
  debug_assert(app_state.workspace.active_tab_id == "b", "the sidebar shows b selected at once")
  sca_close(s)
}

test "split close: the sidebar's X on the second pane's tab closes it and its pane; the main pane stays" {
  let s = sca_open("b", 0)
  dispatch_tab_close("b")
  let v = sca_verbs(sca_acts(s, 2))
  debug_assert(v == "tab_close(b)", "only b closes, nothing is switched: \{v}")
  debug_assert(!is_split_open() && sca_split_tab() == "", "its pane goes with it")
  debug_assert(app_state.workspace.active_tab_id == "a", "a stays shown")
  sca_close(s)
}

test "split close: another tab's X leaves Split View as it is" {
  let s = sca_open("b", 0)
  dispatch_tab_close("c")
  let v = sca_verbs(sca_acts(s, 1))
  debug_assert(v == "tab_close(c)", "\{v}")
  debug_assert(is_split_open() && sca_split_tab() == "b", "both panes stay")
  sca_close(s)
}

test "split close: Cmd+W closes the focused pane's tab, in the second pane as in the main one" {
  let s = sca_open("b", 1)
  dispatch_tab_close("")
  let v = sca_verbs(sca_acts(s, 2))
  debug_assert(v == "tab_close(b)", "the second pane focused: its tab b closes, not a: \{v}")
  debug_assert(!is_split_open(), "and its pane")
  sca_close(s)
  let s2 = sca_open("b", 0)
  dispatch_tab_close("")
  let v2 = sca_verbs(sca_acts(s2, 2))
  debug_assert(v2 == "tab_switch(b) tab_close(a)", "the main pane focused: a closes, b takes the window: \{v2}")
  debug_assert(!is_split_open(), "Split View closed")
  sca_close(s2)
}

test "split close: Cmd+W in a second pane with no tab of its own closes that pane alone" {
  let s = sca_open("", 1)
  dispatch_tab_close("")
  let acts = sca_acts(s, 1)
  debug_assert(acts.length() == 0, "no tab closes: \{sca_verbs(acts)}")
  debug_assert(!is_split_open(), "the pane closes")
  sca_close(s)
}

test "split close: one tab and a blank second pane: closing the tab closes Split View and leaves one tab, not one per close" {
  let s = sca_open("", 0)
  app_state.workspace = proto::WorkspaceSnapshot::{ ..sf_snapshot("a"), tabs: [sf_tab("a", "sp1")] }
  app_state.workspace_host = app_state.workspace
  dispatch_tab_close("a")
  let v = sca_verbs(sca_acts(s, 2))
  debug_assert(v == "tab_close(a)", "only a closes (the host gives the one New Tab a last close gives): \{v}")
  debug_assert(!is_split_open(), "Split View closed: no blank pane is left beside it")
  sca_close(s)
}

test "split close: a second pane showing a page of no tab becomes a tab when the main pane's tab closes" {
  let s = sca_open("", 0, split_url="https://split.test/")
  dispatch_tab_close("a")
  let v = sca_verbs(sca_acts(s, 2))
  debug_assert(v == "tab_new(https://split.test/) tab_close(a)", "its page opens as the shown tab, then a closes: \{v}")
  debug_assert(!is_split_open(), "Split View closed")
  sca_close(s)
}

test "split close: a snapshot without the second pane's tab closes that pane (closed with others, from Today)" {
  let s = sca_open("b", 0)
  let rev = match app_state.workspace_rev {
    Some(r) => r
    None => signals::signal(0)
  }
  set_host_workspace_state_now(sf_snapshot_json(proto::WorkspaceSnapshot::{ ..sf_snapshot("a"), tabs: [sf_tab("a", "sp1"), sf_tab("b", "sp1")] }))
  debug_assert(is_split_open() && sca_split_tab() == "b", "b still there: the pane stays")
  set_host_workspace_state_now(sf_snapshot_json(proto::WorkspaceSnapshot::{ ..sf_snapshot("a"), tabs: [sf_tab("a", "sp1")] }))
  debug_assert(!is_split_open() && sca_split_tab() == "", "b gone: its pane closes")
  debug_assert(rev.untracked() > 0, "the sidebar was told")
  sca_close(s)
}

test "split close: the second pane's host repeating the same Back/Forward lists tells the sidebar nothing" {
  let s = sca_open("b", 0)
  let rev = signals::signal(0)
  app_state.workspace_rev = Some(rev)
  let back = [proto::NavHistoryEntry::{ index: 0, title: "One", url: "https://one.test/" }]
  set_split_nav(back, [])
  let after_first = rev.untracked()
  debug_assert(after_first == 1, "a change is told once (\{after_first})")
  set_split_nav([proto::NavHistoryEntry::{ index: 0, title: "One", url: "https://one.test/" }], [])
  set_split_nav([proto::NavHistoryEntry::{ index: 0, title: "One", url: "https://one.test/" }], [])
  debug_assert(rev.untracked() == after_first, "the same lists again: no rebuild of the sidebar's rows (\{rev.untracked()})")
  set_split_nav([], back)
  debug_assert(rev.untracked() == after_first + 1, "a real change is told")
  app_state.split_nav_back = []
  app_state.split_nav_forward = []
  sca_close(s)
}

test "split close: the Mini Player shows no media of the tab in Split View's second pane" {
  let s = sca_open("b", 0)
  let prev_snap = app_state.media_hub_snap
  let item = fn(tid : String) -> proto::MediaSessionItem {
    proto::MediaSessionItem::{
      tab_id: tid,
      title: "Song",
      artist_or_host: "music.test",
      url: "https://music.test/",
      playing: true,
      muted: false,
      is_live_call: false,
      duration_secs: 0,
      position_secs: 0,
    }
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: [item("b")] }
  debug_assert(!current_mini_player_state().is_visible(), "b plays in the second pane: on screen, no card")
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: [item("a")] }
  debug_assert(!current_mini_player_state().is_visible(), "a plays in the main pane: no card")
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: [item("c")] }
  debug_assert(current_mini_player_state().is_visible(), "c plays off screen: the card")
  let _ = shell_page_close_split()
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: [item("b")] }
  debug_assert(current_mini_player_state().is_visible(), "Split View closed, b plays off screen: the card")
  app_state.media_hub_snap = prev_snap
  sca_close(s)
}

test "mini player: paused from its own card, the card stays (paused) until its tab is shown" {
  let prev_snap = app_state.media_hub_snap
  let prev_ws = app_state.workspace
  app_state.workspace = sf_snapshot("a")
  let song = fn(playing : Bool) -> proto::MediaHubSnapshot {
    proto::MediaHubSnapshot::{
      sessions: [
        proto::MediaSessionItem::{
          tab_id: "b",
          title: "Song",
          artist_or_host: "music.test",
          url: "https://music.test/",
          playing,
          muted: false,
          is_live_call: false,
          duration_secs: 0,
          position_secs: 0,
        },
      ],
    }
  }
  app_state.media_hub_snap = song(true)
  debug_assert(current_mini_player_state().is_visible(), "b plays in the background: the card")
  // the card's pause, as MediaTogglePlay does it; the host has not answered yet
  mini_player_held_tab.v = "b"
  debug_assert(current_mini_player_state().is_visible(), "still playing until the host answers")
  app_state.media_hub_snap = song(false)
  let mp = current_mini_player_state()
  debug_assert(mp.is_visible() && !mp.playing, "paused from the card: it stays, paused, to be played on")
  // media paused some other way never shows a card
  mini_player_held_tab.v = ""
  debug_assert(!current_mini_player_state().is_visible(), "not held: a paused background tab shows none")
  // held, then its tab shown: the card goes and lets go
  mini_player_held_tab.v = "b"
  app_state.workspace = sf_snapshot("b")
  debug_assert(!current_mini_player_state().is_visible() && mini_player_held_tab.v == "", "its tab shown: no card, not held")
  app_state.media_hub_snap = prev_snap
  app_state.workspace = prev_ws
}
