fn p0_live_end(t : ui::Tester, srv : Int, acc : Int, prev_ws : proto::WorkspaceSnapshot, prev_host : proto::WorkspaceSnapshot) -> Unit {
  match ui::focused_field_now() {
    Some(f) if f.focused() => f.let_go()
    _ => ()
  }
  t.dispose()
  let _ = io_rt.main_conn.detach()
  net::close(acc)
  net::close(srv)
  test_drop_build_view_refs()
  app_state.workspace = prev_ws
  app_state.workspace_host = prev_host
  app_state.initial_sidebar_open = false
  shell_adapter_reset()
}

test "app p0: a real middle press over a tab row closes that tab; neither it nor its release reaches the tree" {
  let prev_ws = app_state.workspace
  let prev_host = app_state.workspace_host
  let prev_stage = app_state.stage
  let (t, srv, _cli, acc) = p0_live(stage::Stage::new(fn(_b : Bytes) -> Unit { () }))
  let _ = p0_acts(acc)
  let (rx, ry, rw, rh) = match t.get("Tab b", role=view::Role::Button) {
    Some(d) => (d.x, d.y, d.w, d.h)
    None => {
      debug_assert(false, "the row of tab b is drawn")
      (0.0, 0.0, 0.0, 0.0)
    }
  }
  let x = rx + rw / 2.0
  let y = ry + rh / 2.0
  t.move_to(x, y)
  t.frame(ms=16.0)
  ui::view_pointer(1, x, y, 0.0, button=3)
  ui::view_pointer(2, x, y, 0.0, button=3)
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  t.frame(ms=16.0)
  let acts = p0_acts(acc)
  debug_assert(p0_has_act(acts, "tab_close", "b"), "tab b closes (\{acts.length()} acts)")
  debug_assert(!p0_has_act(acts, "tab_switch", "*"), "and no press reached the row: nothing switched")
  debug_assert(!middle_taken[0], "the release was taken with it")
  p0_live_end(t, srv, acc, prev_ws, prev_host)
  app_state.stage = prev_stage
}

test "app p0: the window is titled after the shown tab's page, and follows it" {
  let prev_ws = app_state.workspace
  let prev_host = app_state.workspace_host
  let prev_stage = app_state.stage
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  let (t, srv, _cli, acc) = p0_live(st)
  // (the Tester's own host, its window title caught)
  let h = hostapi::host()
  let prev_set = h.window_set_title
  let titles : Array[String] = []
  h.window_set_title = fn(_w : Int, s : String) -> Unit { titles.push(s) }
  hostapi::set_host(h)
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://first.test/", "First Page", false, false, false)))
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  debug_assert(titles.length() > 0, "titled after the page")
  let first = titles[titles.length() - 1]
  debug_assert(first.contains("First Page"), "after the page: \{first}")
  st.feed(proto::encode_host(proto::HostMsg::Meta("https://second.test/", "Second Page", false, false, false)))
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let last = titles[titles.length() - 1]
  debug_assert(last.contains("Second Page"), "and again as the page names itself anew: \{last}")
  h.window_set_title = prev_set
  hostapi::set_host(h)
  p0_live_end(t, srv, acc, prev_ws, prev_host)
  app_state.stage = prev_stage
}

test "app p0: the live Today divider's Clear sends today_clear (its toast's Undo reopens the batch)" {
  let prev_ws = app_state.workspace
  let prev_host = app_state.workspace_host
  let prev_stage = app_state.stage
  let (t, srv, _cli, acc) = p0_live(stage::Stage::new(fn(_b : Bytes) -> Unit { () }))
  let _ = p0_acts(acc)
  let today = match t.rect_of("Today") {
    Some(r) => r
    None => {
      debug_assert(false, "the divider is drawn")
      return
    }
  }
  t.move_to(today.0 + 4.0, today.1 + today.3 / 2.0)
  t.frame(ms=200.0)
  match t.get("Clear Today tabs", role=view::Role::Button) {
    Some(d) => {
      t.move_to(d.x + d.w / 2.0, d.y + d.h / 2.0)
      t.frame(ms=16.0)
      t.click(d.x + d.w / 2.0, d.y + d.h / 2.0)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Clear shows on the hovered divider")
  }
  let acts = p0_acts(acc)
  debug_assert(p0_has_act(acts, "today_clear", ""), "the host is asked to clear Today (\{acts.length()} acts)")
  p0_live_end(t, srv, acc, prev_ws, prev_host)
  app_state.stage = prev_stage
}

test "app p0: the host is told which tab Split View's second pane shows" {
  let prev_ws = app_state.workspace
  let prev_host = app_state.workspace_host
  let prev_stage = app_state.stage
  let (t, srv, _cli, acc) = p0_live(stage::Stage::new(fn(_b : Bytes) -> Unit { () }))
  let _ = p0_acts(acc)
  match app_state.split_tab_id {
    Some(s) => {
      s.set("b")
      t.frame(ms=16.0)
      debug_assert(p0_has_act(p0_acts(acc), "split_tab", "b"), "b in the second pane")
      s.set("")
      t.frame(ms=16.0)
      debug_assert(p0_has_act(p0_acts(acc), "split_tab", ""), "and none once it closes")
    }
    None => debug_assert(false, "build_view keeps the split pane's tab")
  }
  p0_live_end(t, srv, acc, prev_ws, prev_host)
  app_state.stage = prev_stage
}

test "app p0: an archived row brings that very tab back; a closed row reopens from the closed list" {
  let items = [
    proto::ClosedTabItem::{ index: 0, title: "Closed", url: "https://c.test/", host: "c.test", space_name: "Work", closed_secs: 10L, tab_id: "" },
    proto::ClosedTabItem::{ index: 16, title: "Archived", url: "https://a.test/", host: "a.test", space_name: "Work", closed_secs: 20L, tab_id: "42" },
  ]
  match closed_item_reopen_act(items, 16) {
    wire::Message::Act(v, a, _) => debug_assert(v == "tab_unarchive" && a == "42", "archived: \{v} \{a}")
    _ => debug_assert(false, "an act")
  }
  match closed_item_reopen_act(items, 0) {
    wire::Message::Act(v, a, _) => debug_assert(v == "tab_reopen_at" && a == "0", "closed: \{v} \{a}")
    _ => debug_assert(false, "an act")
  }
}
