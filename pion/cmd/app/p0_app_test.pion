///| p0 parity through the live app (`build_view`, real loopback to a host socket): the middle button closes the tab
///| row under it and nothing else hears it, the window is titled after the tab shown, the Today divider's Clear sends
///| `today_clear`, the host is told which tab Split View's second pane shows, and Library's archived rows bring that
///| very tab back.

import "hostapi"
import "proto"
import "stage"
import "ui"
import "view"
import "wire"

///| A live app over a host socket: `acc` reads what it sends. The workspace is `sf_snapshot("a")`.
fn p0_live(st : stage::Stage) -> (ui::Tester, Int, Int, Int) {
  shell_adapter_reset()
  io_rt.main_eof_pending = false
  io_rt.split_eof_pending = false
  io_rt.in_pump = false
  io_rt.frame_budget_bytes = 4194304
  middle_taken[0] = false
  // (the app opens with the sidebar as its settings say: shown here)
  app_state.initial_sidebar_open = true
  let (srv, cli, acc) = sn_make_loopback_pair()
  let _ = io_rt.main_conn.attach(cli)
  app_state.stage = Some(st)
  app_state.ws_pending = []
  app_state.workspace = sf_snapshot("a")
  app_state.workspace_host = sf_snapshot("a")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { build_view(root) }, width=1280.0, height=800.0)
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  (t, srv, cli, acc)
}

fn p0_acts(acc : Int) -> Array[(String, String, String)] {
  let _ = io_rt.main_conn.flush_write()
  sf_read_acts(acc, 64)
}

fn p0_has_act(acts : Array[(String, String, String)], verb : String, a : String) -> Bool {
  for x in acts {
    let (v, aa, _) = x
    if v == verb && (a == "*" || aa == a) {
      return true
    }
  }
  false
}

///| Clears every `Option` view/signal/field reference written by `build_view(root)` (plus stage views
