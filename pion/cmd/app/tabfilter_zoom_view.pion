///| Arc Daily-Driver Desktop Chrome UX Components:
///| 1. Sidebar Live Tab Filter Bar + Match Count Pill + Conditional Clear `×` + Empty State
///| 2. Upgraded Arc Tab Context Menu (Full Daily-Driver Actions, Light & Dark `ChromePalette`,
///|    single hairlines, zero double/dangling dividers, non-clickable disabled states)
///| 3. Omnibox Adaptive Zoom Pill + Zoom Control Popover (`−` / `%` / `+`, visual scale track,
///|    `Reset to 100%` (`⌘0`), and `Save as Default`)

fn dispatch_tab_close_others(tab_id : String) -> Unit {
  let count = proto::tab_close_others_count(app_state.workspace, tab_id)
  if count <= 0 {
    return
  }
  send_wire(wire::Message::Act("tab_close_others", tab_id, ""))
  let is_macos = ui::keys_system() <= 0
  let undo_hint = if is_macos { "⌘⇧T" } else { "Ctrl+Shift+T" }
  let noun = if count == 1 { "1 Other Tab" } else { count.to_string() + " Other Tabs" }
  show_toast("Closed " + noun + " · " + undo_hint + " to Undo", "close")
}

fn close_zoom_popover() -> Unit {
  match app_state.zoom_popover_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("zoom_popover")
}

fn open_zoom_popover() -> Unit {
  close_exclusive_overlays()
  match app_state.zoom_popover_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "zoom_popover")
}

fn toggle_zoom_popover() -> Unit {
  let is_open = match app_state.zoom_popover_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_zoom_popover()
  } else {
    open_zoom_popover()
  }
}

fn clear_tab_filter_query_only() -> Unit {
  match app_state.tab_filter_query {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.tab_filter_field {
    Some(f) => {
      if f.text() != "" {
        f.set("")
      }
      f.focus()
    }
    None => ()
  }
}

///| Compact Arc Sidebar Live Tab Filter bar (28pt height, concentric 7pt -> 5pt radius).
///| Displays live match-count pill (e.g. `3 / 8`) and conditional clear `×` button (never `alpha=0`).
///| 100% reactive to Light & Dark `ChromePalette`.
fn build_sidebar_tab_filter_bar(
  sb : view::View,
  tab_filter_open : signals::Signal[Bool],
  tab_filter_query : signals::Signal[String],
  tab_filter_field : ui::Field,
  workspace_rev : signals::Signal[Int],
) -> Unit {
  sb.show(
    fn() -> Bool { tab_filter_open.get() },
    fn(tf_wrap : view::View) -> Unit {
      let get_stats = fn() -> proto::TabFilterStats {
        let _ = workspace_rev.get()
        proto::tab_filter_compute_stats(
          app_state.workspace,
          app_state.workspace.active_space_id,
          tab_filter_query.get(),
        )
      }
      let _ = tf_wrap
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .width(view::Live::Is(Some(223.0)))
      .height(view::Live::Is(Some(30.0)))
      .rigid()
      .clips(view::Live::Is(true))
      .padding(view::Live::Is((8.0, 0.0, 5.0, 0.0)))
      .gap(view::Live::Is(5.0))
      .radius(view::Live::Is(8.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        let p = chrome_palette()
        if tab_filter_field.focused() || tab_filter_query.get().trim() != "" {
          (1.2, p.accent)
        } else {
          (1.0, p.border)
        }
      }))
      tf_wrap.reacts(fn() -> String { tab_filter_field.text() }, fn(q : String) -> Unit {
        if tab_filter_open.untracked() {
          tab_filter_query.set(q)
        }
      })
      // Crisp geometric magnifying-glass icon (lens ring + stem)
      let _ = tf_wrap.box(
        fn(icon_box : view::View) -> Unit {
          let _ = icon_box
          .width(view::Live::Is(Some(13.0)))
          .height(view::Live::Is(Some(13.0)))
          .rigid()
          let _ = icon_box.box(
            fn(lens : view::View) -> Unit {
              let _ = lens
              .over_at(view::Live::Is((Some(0.5), Some(0.5), None, None)))
              .width(view::Live::Is(Some(9.5)))
              .height(view::Live::Is(Some(9.5)))
              .radius(view::Live::Is(4.75))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let p = chrome_palette()
                if tab_filter_query.get().trim() != "" {
                  (1.5, p.accent)
                } else {
                  (1.3, p.ink_muted)
                }
              }))
            },
          )
          let _ = icon_box.box(
            fn(handle : view::View) -> Unit {
              let _ = handle
              .over_at(view::Live::Is((Some(8.5), Some(8.5), None, None)))
              .width(view::Live::Is(Some(3.5)))
              .height(view::Live::Is(Some(3.5)))
              .radius(view::Live::Is(1.2))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if tab_filter_query.get().trim() != "" { p.accent } else { p.ink_muted }
              }))
            },
          )
        },
      )
      // Single-line filter input field (Light & Dark ChromePalette reactive)
      let _ = tf_wrap.box(
        fn(tfi : view::View) -> Unit {
          let _ = tfi
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .clips(view::Live::Is(true))
          tfi.show(
            fn() -> Bool { !is_dark_chrome() },
            fn(fl : view::View) -> Unit {
              let _ = ui::field(
                fl,
                tab_filter_field,
                placeholder="Filter tabs...",
                font_size=12.0,
                color=0x1D1D1FFFL,
                placeholder_color=0x8E8E93FFL,
                caret_color=0x2563EBFFL,
                max_lines=1,
                enter_sends=true,
                submitted=fn(_t : String) -> Unit { () },
              )
            },
          )
          tfi.show(
            fn() -> Bool { is_dark_chrome() },
            fn(fd : view::View) -> Unit {
              let _ = ui::field(
                fd,
                tab_filter_field,
                placeholder="Filter tabs...",
                font_size=12.0,
                color=0xF1F5F9FFL,
                placeholder_color=0x94A3B8FFL,
                caret_color=0x60A5FAFFL,
                max_lines=1,
                enter_sends=true,
                submitted=fn(_t : String) -> Unit { () },
              )
            },
          )
        },
      )
      // Live match count pill (e.g. `3 / 8`), mounted only while a filter query is active
      tf_wrap.show(
        fn() -> Bool { proto::tab_filter_has_clear_button(tab_filter_query.get()) },
        fn(cnt_wrap : view::View) -> Unit {
          let _ = cnt_wrap
          .height(view::Live::Is(Some(18.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((5.5, 0.0, 5.5, 0.0)))
          .radius(view::Live::Is(5.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            let st = get_stats()
            if st.matched == 0 { p.danger_bg } else { p.accent_soft_bg }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            let st = get_stats()
            if st.matched == 0 { (1.0, p.danger_border) } else { (1.0, p.accent_soft_border) }
          }))
          let _ = cnt_wrap.box(
            fn(cl : view::View) -> Unit {
              let _ = cl
              .rigid()
              .words(
                view::Live::By(fn() -> String {
                  let st = get_stats()
                  proto::tab_filter_badge_label(st.matched, st.total)
                }),
                ink=0x1D4ED8FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                let st = get_stats()
                if st.matched == 0 { p.danger } else { p.accent_soft_ink }
              }))
            },
          )
        },
      )
      // Conditional one-click clear `×` button (mounted via `.show`, never `alpha=0` clickable)
      tf_wrap.show(
        fn() -> Bool { proto::tab_filter_has_clear_button(tab_filter_query.get()) },
        fn(xw : view::View) -> Unit {
          let _ = headless::button(
            xw,
            fn() -> String { "Clear Tab Filter" },
            fn(_v : view::View) -> Unit { clear_tab_filter_query_only() },
            fn(xb : view::View, xbtn : headless::Button) -> Unit {
              let _ = xb
              .width(view::Live::Is(Some(19.0)))
              .height(view::Live::Is(Some(19.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if xbtn.pressed() {
                  p.btn_press
                } else if xbtn.hovered() {
                  p.btn_hover
                } else {
                  0x00000000L
                }
              }))
              let _ = xb.box(
                fn(xl : view::View) -> Unit {
                  let _ = xl
                  .words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Soft empty-state card when Sidebar Live Tab Filter matches 0 tabs, with one-click Clear button.
///| 100% reactive to Light & Dark `ChromePalette`.
fn build_sidebar_tab_filter_empty(
  mid : view::View,
  tab_filter_query : signals::Signal[String],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  mid.show(
    fn() -> Bool {
      let _ = workspace_rev.get()
      let q = tab_filter_query.get().trim()
      if q == "" {
        return false
      }
      let stats = proto::tab_filter_compute_stats(
        app_state.workspace,
        app_state.workspace.active_space_id,
        q,
      )
      stats.matched == 0
    },
    fn(empty_box : view::View) -> Unit {
      let _ = empty_box
      .width(view::Live::Is(Some(223.0)))
      .padding(view::Live::Is((12.0, 16.0, 12.0, 14.0)))
      .gap(view::Live::Is(6.0))
      .center()
      .radius(view::Live::Is(10.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
      let _ = empty_box.box(
        fn(et : view::View) -> Unit {
          let _ = et
          .words(
            view::Live::Is("No matching tabs"),
            ink=0x3A4152FFL,
            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
            one_line=true,
          )
          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
        },
      )
      let _ = empty_box.box(
        fn(es : view::View) -> Unit {
          let _ = es
          .words(
            view::Live::Is("Try another keyword or press Esc"),
            ink=0x8E8E93FFL,
            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
            one_line=true,
          )
          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
        },
      )
      let _ = headless::button(
        empty_box,
        fn() -> String { "Clear Filter" },
        fn(_v : view::View) -> Unit { close_tab_filter() },
        fn(cb : view::View, cbtn : headless::Button) -> Unit {
          let _ = cb
          .height(view::Live::Is(Some(24.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if cbtn.pressed() {
              p.btn_press
            } else if cbtn.hovered() {
              p.accent_soft_border
            } else {
              p.accent_soft_bg
            }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
          let _ = cb.box(
            fn(cl : view::View) -> Unit {
              let _ = cl
              .words(
                view::Live::Is("Clear Filter"),
                ink=0x1D4ED8FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
            },
          )
        },
      )
    },
  )
}

///| Omnibox Adaptive Zoom Pill (mounted only when current zoom != 100%, or while Zoom Popover is open).
///| Unmounts cleanly at 100% taking 0px space. Clicking opens/closes the Zoom Control Popover.
fn build_omnibox_zoom_pill(
  f : view::View,
  zoom_popover_open : signals::Signal[Bool],
) -> Unit {
  f.show(
    fn() -> Bool {
      proto::zoom_pill_visible(active_stage_live().zoom()) || zoom_popover_open.get()
    },
    fn(zp : view::View) -> Unit {
      let zoom_label = fn() -> String { proto::zoom_pill_label(active_stage_live().zoom()) }
      let _ = headless::button(
        zp,
        fn() -> String { "Page Zoom " + zoom_label() },
        fn(_v : view::View) -> Unit { toggle_zoom_popover() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b
          .keeps_held(view::Live::Is(true))
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(22.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
          .gap(view::Live::Is(4.0))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if zoom_popover_open.get() {
              p.accent
            } else if btn.pressed() {
              p.accent_soft_border
            } else if btn.hovered() {
              p.accent_soft_bg
            } else {
              p.accent_soft_bg
            }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            if zoom_popover_open.get() {
              (1.0, p.accent)
            } else {
              (1.0, p.accent_soft_border)
            }
          }))
          // Compact magnifying glass (lens + handle)
          let _ = b.box(
            fn(icon_box : view::View) -> Unit {
              let _ = icon_box
              .width(view::Live::Is(Some(10.0)))
              .height(view::Live::Is(Some(10.0)))
              .rigid()
              let _ = icon_box.box(
                fn(lens : view::View) -> Unit {
                  let _ = lens
                  .over_at(view::Live::Is((Some(0.5), Some(0.5), None, None)))
                  .width(view::Live::Is(Some(7.0)))
                  .height(view::Live::Is(Some(7.0)))
                  .radius(view::Live::Is(3.5))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if zoom_popover_open.get() { (1.3, 0xFFFFFFFFL) } else { (1.3, p.accent_soft_ink) }
                  }))
                },
              )
              let _ = icon_box.box(
                fn(handle : view::View) -> Unit {
                  let _ = handle
                  .over_at(view::Live::Is((Some(6.5), Some(6.5), None, None)))
                  .width(view::Live::Is(Some(3.0)))
                  .height(view::Live::Is(Some(3.0)))
                  .radius(view::Live::Is(1.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if zoom_popover_open.get() { 0xFFFFFFFFL } else { p.accent_soft_ink }
                  }))
                },
              )
            },
          )
          let _ = b.box(
            fn(w : view::View) -> Unit {
              let _ = w
              .words(
                view::Live::By(zoom_label),
                ink=0x1D4ED8FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if zoom_popover_open.get() { 0xFFFFFFFFL } else { p.accent_soft_ink }
              }))
            },
          )
        },
      )
    },
  )
}

///| Native Metal Zoom Control Popover anchored below the omnibox zoom pill.
///| Outer radius 12pt -> padding 12pt -> inner controls 6pt; 100% Light & Dark `ChromePalette` aligned.
fn build_zoom_popover(
  root : view::View,
  zoom_popover_open : signals::Signal[Bool],
) -> Unit {
  root.show(
    fn() -> Bool { zoom_popover_open.get() },
    fn(zp_layer : view::View) -> Unit {
      let _ = zp_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      // Click-outside dismiss scrim
      let _ = headless::button(
        zp_layer,
        fn() -> String { "Dismiss Zoom Popover" },
        fn(_v : view::View) -> Unit { close_zoom_popover() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x00000000L))
        },
      )
      // Popover card anchored right below the omnibox zoom pill
      let _ = zp_layer.box(
        fn(card : view::View) -> Unit {
          let track_w = 228.0
          let _ = card
          .over_at(view::Live::Is((None, Some(44.0), Some(186.0), None)))
          .width(view::Live::Is(Some(252.0)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .radius(view::Live::Is(12.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (26.0, 10.0, 0x00000066L) } else { (22.0, 8.0, 0x0F172A24L) }
          }))
          // Header: Title + right-aligned domain pill
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))
              let _ = hdr.box(
                fn(tl : view::View) -> Unit {
                  let _ = tl
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("Page Zoom"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              let _ = hdr.box(
                fn(hpill : view::View) -> Unit {
                  let _ = hpill
                  .height(view::Live::Is(Some(20.0)))
                  .max_width(view::Live::Is(Some(142.0)))
                  .rigid()
                  .center()
                  .clips(view::Live::Is(true))
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(5.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                  let _ = hpill.box(
                    fn(hl : view::View) -> Unit {
                      let _ = hl
                      .words(
                        view::Live::By(fn() -> String {
                          proto::zoom_popover_host_label(active_stage_live().url())
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )
          // Stepper Control Row: [ - ]   125%   [ + ]
          let _ = card.box(
            fn(ctrl : view::View) -> Unit {
              let _ = ctrl
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(38.0)))
              .padding(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
              .gap(view::Live::Is(8.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
              // Zoom Out (`−`) button (conditional enabled button vs disabled non-clickable box)
              ctrl.show(
                fn() -> Bool { proto::zoom_can_step_down(active_stage_live().zoom()) },
                fn(dw : view::View) -> Unit {
                  let _ = headless::button(
                    dw,
                    fn() -> String { "Zoom Out" },
                    fn(_v : view::View) -> Unit {
                      let st = active_stage()
                      apply_zoom_and_sync(st, proto::zoom_step_down(st.zoom()))
                    },
                    fn(b : view::View, btn : headless::Button) -> Unit {
                      let _ = b
                      .width(view::Live::Is(Some(34.0)))
                      .height(view::Live::Is(Some(30.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if btn.pressed() {
                          p.btn_press
                        } else if btn.hovered() {
                          p.btn_hover
                        } else {
                          p.surface_bg
                        }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                      let _ = b.box(
                        fn(gl : view::View) -> Unit {
                          let _ = gl
                          .words(
                            view::Live::Is("−"),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 16.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )
                },
              )
              ctrl.show(
                fn() -> Bool { !proto::zoom_can_step_down(active_stage_live().zoom()) },
                fn(dw_dis : view::View) -> Unit {
                  let _ = dw_dis
                  .width(view::Live::Is(Some(34.0)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                  let _ = dw_dis.box(
                    fn(gl : view::View) -> Unit {
                      let _ = gl
                      .words(
                        view::Live::Is("−"),
                        ink=0x94A3B8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 16.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
              // Large current percentage readout
              let _ = ctrl.box(
                fn(rd : view::View) -> Unit {
                  let _ = rd
                  .grow(view::Live::Is(1.0))
                  .center()
                  let _ = rd.box(
                    fn(val_v : view::View) -> Unit {
                      let _ = val_v
                      .words(
                        view::Live::By(fn() -> String {
                          proto::zoom_pill_label(active_stage_live().zoom())
                        }),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 18.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                },
              )
              // Zoom In (`+`) button (conditional enabled button vs disabled non-clickable box)
              ctrl.show(
                fn() -> Bool { proto::zoom_can_step_up(active_stage_live().zoom()) },
                fn(uw : view::View) -> Unit {
                  let _ = headless::button(
                    uw,
                    fn() -> String { "Zoom In" },
                    fn(_v : view::View) -> Unit {
                      let st = active_stage()
                      apply_zoom_and_sync(st, proto::zoom_step_up(st.zoom()))
                    },
                    fn(b : view::View, btn : headless::Button) -> Unit {
                      let _ = b
                      .width(view::Live::Is(Some(34.0)))
                      .height(view::Live::Is(Some(30.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if btn.pressed() {
                          p.btn_press
                        } else if btn.hovered() {
                          p.btn_hover
                        } else {
                          p.surface_bg
                        }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                      let _ = b.box(
                        fn(gl : view::View) -> Unit {
                          let _ = gl
                          .words(
                            view::Live::Is("+"),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 16.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )
                },
              )
              ctrl.show(
                fn() -> Bool { !proto::zoom_can_step_up(active_stage_live().zoom()) },
                fn(uw_dis : view::View) -> Unit {
                  let _ = uw_dis
                  .width(view::Live::Is(Some(34.0)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                  let _ = uw_dis.box(
                    fn(gl : view::View) -> Unit {
                      let _ = gl
                      .words(
                        view::Live::Is("+"),
                        ink=0x94A3B8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 16.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )
          // Visual Scale Track (50% .. 100% tick .. 300%)
          let _ = card.box(
            fn(scale_wrap : view::View) -> Unit {
              let _ = scale_wrap.gap(view::Live::Is(5.0))
              let _ = scale_wrap.box(
                fn(track_box : view::View) -> Unit {
                  let _ = track_box
                  .width(view::Live::Is(Some(track_w)))
                  .height(view::Live::Is(Some(14.0)))
                  .rigid()
                  // Background rail
                  let _ = track_box.box(
                    fn(rail : view::View) -> Unit {
                      let _ = rail
                      .over_at(view::Live::Is((Some(0.0), Some(5.0), Some(0.0), None)))
                      .height(view::Live::Is(Some(4.0)))
                      .radius(view::Live::Is(2.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                    },
                  )
                  // Active fill bar
                  let _ = track_box.box(
                    fn(fill : view::View) -> Unit {
                      let _ = fill
                      .over_at(view::Live::Is((Some(0.0), Some(5.0), None, None)))
                      .width(view::Live::By(fn() -> Option[Double] {
                        let frac = proto::zoom_scale_fraction(active_stage_live().zoom())
                        let fw = frac * track_w
                        Some(if fw < 4.0 { 4.0 } else { fw })
                      }))
                      .height(view::Live::Is(Some(4.0)))
                      .radius(view::Live::Is(2.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent }))
                    },
                  )
                  // 100% default reference tick
                  let _ = track_box.box(
                    fn(tick : view::View) -> Unit {
                      let tick_x = proto::zoom_default_marker_fraction() * track_w - 1.0
                      let _ = tick
                      .over_at(view::Live::Is((Some(tick_x), Some(2.0), None, None)))
                      .width(view::Live::Is(Some(2.0)))
                      .height(view::Live::Is(Some(10.0)))
                      .radius(view::Live::Is(1.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
                    },
                  )
                  // Current zoom thumb dot
                  let _ = track_box.box(
                    fn(thumb : view::View) -> Unit {
                      let _ = thumb
                      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
                        let frac = proto::zoom_scale_fraction(active_stage_live().zoom())
                        let raw_x = frac * (track_w - 12.0)
                        let cx = if raw_x < 0.0 { 0.0 } else if raw_x > track_w - 12.0 { track_w - 12.0 } else { raw_x }
                        (Some(cx), Some(1.0), None, None)
                      }))
                      .width(view::Live::Is(Some(12.0)))
                      .height(view::Live::Is(Some(12.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (2.0, chrome_palette().accent) }))
                    },
                  )
                },
              )
              // Micro scale labels: 50% / 100% / 300%
              let _ = scale_wrap.box(
                fn(ticks_row : view::View) -> Unit {
                  let _ = ticks_row
                  .row(view::Live::Is(true))
                  .width(view::Live::Is(Some(track_w)))
                  let _ = ticks_row.box(
                    fn(l50 : view::View) -> Unit {
                      let _ = l50
                      .grow(view::Live::Is(5.0))
                      .words(
                        view::Live::Is("50%"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                  let _ = ticks_row.box(
                    fn(l100 : view::View) -> Unit {
                      let _ = l100
                      .grow(view::Live::Is(7.0))
                      .words(
                        view::Live::Is("100%"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                  let _ = ticks_row.box(
                    fn(l300 : view::View) -> Unit {
                      let _ = l300
                      .rigid()
                      .words(
                        view::Live::Is("300%"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )
          // Single 1px hairline divider
          let _ = card.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .width(view::Live::Is(Some(track_w)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
          // Footer actions: Reset to 100% (`⌘0`) + Save as Default
          let _ = card.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(6.0))
              let reset_hint = if ui::keys_system() <= 0 { "⌘0" } else { "Ctrl+0" }
              let _ = headless::button(
                ftr,
                fn() -> String { "Reset to 100%" },
                fn(_v : view::View) -> Unit {
                  apply_zoom_and_sync(active_stage(), proto::zoom_reset())
                  close_zoom_popover()
                  show_toast("Zoom Reset · 100%", "zoom")
                },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .grow(view::Live::Is(1.0))
                  .height(view::Live::Is(Some(28.0)))
                  .center()
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .gap(view::Live::Is(5.0))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() {
                      p.btn_press
                    } else if btn.hovered() {
                      p.btn_hover
                    } else {
                      p.btn_bg
                    }
                  }))
                  let _ = b.box(
                    fn(rl : view::View) -> Unit {
                      let _ = rl
                      .words(
                        view::Live::Is("Reset 100%"),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                  let _ = b.box(
                    fn(rh : view::View) -> Unit {
                      let _ = rh
                      .words(
                        view::Live::Is(reset_hint),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
              let _ = headless::button(
                ftr,
                fn() -> String { "Save as Default" },
                fn(_v : view::View) -> Unit {
                  let cur_pct = active_stage().zoom_percent()
                  let next = proto::BrowserSettings::{ ..app_state.settings, default_zoom_pct: cur_pct }
                  dispatch_settings_save(
                    next,
                    toast_msg="Default Zoom Saved (" + cur_pct.to_string() + "%)",
                  )
                  close_zoom_popover()
                },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .grow(view::Live::Is(1.0))
                  .height(view::Live::Is(Some(28.0)))
                  .center()
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() {
                      p.accent_soft_border
                    } else if btn.hovered() {
                      p.accent_soft_border
                    } else {
                      p.accent_soft_bg
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                  let _ = b.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .words(
                        view::Live::Is("Save as Default"),
                        ink=0x1D4ED8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Upgraded Arc Tab Context Menu (`228pt` card, concentric R_outer=12 / P=6 / R_inner=6).
///| 100% Light & Dark `ChromePalette` aligned, single 1px hairline dividers, zero double/dangling lines,
///| and non-clickable disabled states.
fn build_tab_context_menu(
  root : view::View,
  tab_ctx_open : signals::Signal[Bool],
  tab_ctx_tab_id : signals::Signal[String],
  tab_ctx_y : signals::Signal[Double],
  sidebar_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  st : stage::Stage,
) -> Unit {
  root.show(
    fn() -> Bool { tab_ctx_open.get() },
    fn(tc_layer : view::View) -> Unit {
      let _ = tc_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      // Click-outside dismiss scrim
      let _ = headless::button(
        tc_layer,
        fn() -> String { "Dismiss Tab Menu" },
        fn(_v : view::View) -> Unit { close_tab_ctx() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x00000000L))
        },
      )
      let get_ctx_tab = fn() -> Option[proto::TabSummary] {
        let _ = workspace_rev.get()
        find_tab_summary(tab_ctx_tab_id.get())
      }
      let item_w = 216.0
      let render_ctx_item = fn(
        parent : view::View,
        label_fn : () -> String,
        hint_fn : () -> String,
        danger : Bool,
        on_pick : () -> Unit,
      ) -> Unit {
        let _ = headless::button(
          parent,
          label_fn,
          fn(_v : view::View) -> Unit { on_pick() },
          fn(ib : view::View, ibtn : headless::Button) -> Unit {
            let _ = ib
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .width(view::Live::Is(Some(item_w)))
            .height(view::Live::Is(Some(29.0)))
            .rigid()
            .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
            .gap(view::Live::Is(8.0))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if danger {
                if ibtn.pressed() {
                  p.danger_border
                } else if ibtn.hovered() {
                  p.danger_bg
                } else {
                  0x00000000L
                }
              } else if ibtn.pressed() {
                p.tab_press_bg
              } else if ibtn.hovered() {
                p.tab_hover_bg
              } else {
                0x00000000L
              }
            }))
            let _ = ib.box(
              fn(lbl : view::View) -> Unit {
                let _ = lbl
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(0.0)))
                .clips(view::Live::Is(true))
                .words(
                  view::Live::By(label_fn),
                  ink=if danger { 0xDC2626FFL } else { 0x1F2937FFL },
                  look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if danger { p.danger } else { p.ink_primary }
                }))
              },
            )
            ib.show(
              fn() -> Bool { hint_fn() != "" },
              fn(hw : view::View) -> Unit {
                let _ = hw
                .rigid()
                .words(
                  view::Live::By(hint_fn),
                  ink=0x8E8E93FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
              },
            )
          },
        )
      }
      let render_ctx_disabled = fn(parent : view::View, label : String) -> Unit {
        let _ = parent.box(
          fn(ib : view::View) -> Unit {
            let _ = ib
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .width(view::Live::Is(Some(item_w)))
            .height(view::Live::Is(Some(29.0)))
            .rigid()
            .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
            .radius(view::Live::Is(6.0))
            let _ = ib.box(
              fn(lbl : view::View) -> Unit {
                let _ = lbl
                .grow(view::Live::Is(1.0))
                .words(
                  view::Live::Is(label),
                  ink=0x94A3B8FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  if is_dark_chrome() { 0x64748BFFL } else { 0x9CA3AFFFL }
                }))
              },
            )
          },
        )
      }
      let render_hairline = fn(parent : view::View) -> Unit {
        let _ = parent.box(
          fn(sep_w : view::View) -> Unit {
            let _ = sep_w
            .width(view::Live::Is(Some(item_w)))
            .padding(view::Live::Is((4.0, 3.0, 4.0, 3.0)))
            .rigid()
            let _ = sep_w.box(
              fn(sep : view::View) -> Unit {
                let _ = sep
                .height(view::Live::Is(Some(1.0)))
                .rigid()
                .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
              },
            )
          },
        )
      }
      let _ = tc_layer.box(
        fn(menu : view::View) -> Unit {
          let _ = menu
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let left = if sidebar_open.get() { 250.0 } else { 14.0 }
            let raw_top = tab_ctx_y.get()
            let top = if raw_top < 52.0 { 52.0 } else if raw_top > 280.0 { 280.0 } else { raw_top }
            (Some(left), Some(top), None, None)
          }))
          .width(view::Live::Is(Some(228.0)))
          .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
          .gap(view::Live::Is(1.0))
          .radius(view::Live::Is(12.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (28.0, 10.0, 0x00000077L) } else { (22.0, 8.0, 0x0F172A24L) }
          }))
          // Group 1: View & Share (Split View, Peek, Duplicate, Copy Clean URL)
          render_ctx_item(
            menu,
            fn() -> String { "Open in Split View" },
            fn() -> String { if ui::keys_system() <= 0 { "⇧⌘\\" } else { "Ctrl+Shift+\\" } },
            false,
            fn() -> Unit {
              let (u, tid) = match get_ctx_tab() {
                Some(tb) => (tb.url, tb.id)
                None => (st.url(), "")
              }
              close_tab_ctx()
              open_split_view(u, tid, focus_pane=1)
            },
          )
          render_ctx_item(
            menu,
            fn() -> String { "Open in Peek" },
            fn() -> String { if ui::keys_system() <= 0 { "⇧⌘P" } else { "Ctrl+Shift+P" } },
            false,
            fn() -> Unit {
              let (u, tid) = match get_ctx_tab() {
                Some(tb) => (tb.url, tb.id)
                None => (st.url(), "")
              }
              close_tab_ctx()
              open_peek_preview(u, tid)
            },
          )
          render_ctx_item(
            menu,
            fn() -> String { "Duplicate Tab" },
            fn() -> String { "" },
            false,
            fn() -> Unit {
              let tid = tab_ctx_tab_id.untracked()
              close_tab_ctx()
              dispatch_tab_duplicate(tid)
            },
          )
          render_ctx_item(
            menu,
            fn() -> String { "Copy Clean URL" },
            fn() -> String { if ui::keys_system() <= 0 { "⇧⌘C" } else { "Ctrl+Shift+C" } },
            false,
            fn() -> Unit {
              let u = match get_ctx_tab() {
                Some(tb) => tb.url
                None => st.url()
              }
              close_tab_ctx()
              copy_url_with_toast(u)
            },
          )
          // Divider 1
          render_hairline(menu)
          // Group 2: Tab State (Pin/Unpin, Favorites, Mute/Unmute)
          render_ctx_item(
            menu,
            fn() -> String {
              match get_ctx_tab() {
                Some(tb) => proto::tab_pin_menu_label(tb)
                None => "Pin Tab"
              }
            },
            fn() -> String { if ui::keys_system() <= 0 { "⌘D" } else { "Ctrl+D" } },
            false,
            fn() -> Unit {
              let tid = tab_ctx_tab_id.untracked()
              close_tab_ctx()
              dispatch_tab_pin(tid)
            },
          )
          render_ctx_item(
            menu,
            fn() -> String {
              match get_ctx_tab() {
                Some(tb) if tb.favorite => "Remove from Favorites"
                _ => "Add to Favorites"
              }
            },
            fn() -> String { "" },
            false,
            fn() -> Unit {
              let tid = tab_ctx_tab_id.untracked()
              close_tab_ctx()
              dispatch_tab_favorite(tid)
            },
          )
          render_ctx_item(
            menu,
            fn() -> String {
              let _ = workspace_rev.get()
              proto::tab_mute_menu_label(app_state.workspace, tab_ctx_tab_id.get())
            },
            fn() -> String { if ui::keys_system() <= 0 { "⌘M" } else { "Ctrl+M" } },
            false,
            fn() -> Unit {
              close_tab_ctx()
              dispatch_media_mute_toggle()
            },
          )
          // Move to Folder section (mounted only when current Space has >= 1 folder; owns its leading hairline)
          menu.show(
            fn() -> Bool {
              let _ = workspace_rev.get()
              proto::workspace_folders_for_space(
                app_state.workspace,
                app_state.workspace.active_space_id,
              ).length() > 0
            },
            fn(fsec : view::View) -> Unit {
              let _ = fsec.gap(view::Live::Is(1.0))
              render_hairline(fsec)
              let _ = fsec.box(
                fn(flbl : view::View) -> Unit {
                  let _ = flbl
                  .padding(view::Live::Is((10.0, 3.0, 10.0, 2.0)))
                  .words(
                    view::Live::Is("MOVE TO FOLDER"),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
              fsec.show(
                fn() -> Bool {
                  match get_ctx_tab() {
                    Some(tb) => tb.folder_id != ""
                    None => false
                  }
                },
                fn(rmw : view::View) -> Unit {
                  render_ctx_item(
                    rmw,
                    fn() -> String { "Move to Top-Level Pinned" },
                    fn() -> String { "" },
                    false,
                    fn() -> Unit {
                      let tid = tab_ctx_tab_id.untracked()
                      close_tab_ctx()
                      dispatch_tab_move_folder(tid, "")
                    },
                  )
                },
              )
              let mut fslot = 0
              while fslot < 6 {
                let f_idx = fslot
                let get_f = fn() -> Option[proto::FolderSummary] {
                  let _ = workspace_rev.get()
                  let fls = proto::workspace_folders_for_space(
                    app_state.workspace,
                    app_state.workspace.active_space_id,
                  )
                  if f_idx < fls.length() { Some(fls[f_idx]) } else { None }
                }
                fsec.show(
                  fn() -> Bool {
                    match (get_f(), get_ctx_tab()) {
                      (Some(fl), Some(tb)) => fl.id != tb.folder_id
                      (Some(_), None) => true
                      _ => false
                    }
                  },
                  fn(fitem : view::View) -> Unit {
                    render_ctx_item(
                      fitem,
                      fn() -> String {
                        match get_f() {
                          Some(fl) => fl.name
                          None => ""
                        }
                      },
                      fn() -> String { "Folder" },
                      false,
                      fn() -> Unit {
                        let tid = tab_ctx_tab_id.untracked()
                        let fid = match get_f() {
                          Some(fl) => fl.id
                          None => ""
                        }
                        close_tab_ctx()
                        if fid != "" {
                          dispatch_tab_move_folder(tid, fid)
                        }
                      },
                    )
                  },
                )
                fslot = fslot + 1
              }
            },
          )
          // Move to Space section (mounted only when >= 2 Spaces exist; owns its leading hairline)
          menu.show(
            fn() -> Bool {
              let _ = workspace_rev.get()
              app_state.workspace.spaces.length() >= 2
            },
            fn(ssec : view::View) -> Unit {
              let _ = ssec.gap(view::Live::Is(1.0))
              render_hairline(ssec)
              let _ = ssec.box(
                fn(slbl : view::View) -> Unit {
                  let _ = slbl
                  .padding(view::Live::Is((10.0, 3.0, 10.0, 2.0)))
                  .words(
                    view::Live::Is("MOVE TO SPACE"),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
              let mut sslot = 0
              while sslot < 6 {
                let s_idx = sslot
                let get_other_sp = fn() -> Option[proto::SpaceSummary] {
                  let _ = workspace_rev.get()
                  let cur_sid = match get_ctx_tab() {
                    Some(tb) => tb.space_id
                    None => app_state.workspace.active_space_id
                  }
                  let others : Array[proto::SpaceSummary] = []
                  let mut si = 0
                  while si < app_state.workspace.spaces.length() {
                    if app_state.workspace.spaces[si].id != cur_sid {
                      others.push(app_state.workspace.spaces[si])
                    }
                    si = si + 1
                  }
                  if s_idx < others.length() { Some(others[s_idx]) } else { None }
                }
                ssec.show(
                  fn() -> Bool { get_other_sp().is_some() },
                  fn(sitem : view::View) -> Unit {
                    let _ = headless::button(
                      sitem,
                      fn() -> String {
                        match get_other_sp() {
                          Some(sp) => "Move to " + sp.name
                          None => ""
                        }
                      },
                      fn(_v : view::View) -> Unit {
                        let tid = tab_ctx_tab_id.untracked()
                        let (sid, sname) = match get_other_sp() {
                          Some(sp) => (sp.id, sp.name)
                          None => ("", "")
                        }
                        close_tab_ctx()
                        if sid != "" {
                          dispatch_tab_move_space(tid, sid, sname)
                        }
                      },
                      fn(ib : view::View, ibtn : headless::Button) -> Unit {
                        let _ = ib
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .width(view::Live::Is(Some(item_w)))
                        .height(view::Live::Is(Some(29.0)))
                        .rigid()
                        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                        .gap(view::Live::Is(8.0))
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if ibtn.pressed() {
                            p.tab_press_bg
                          } else if ibtn.hovered() {
                            p.tab_hover_bg
                          } else {
                            0x00000000L
                          }
                        }))
                        let _ = ib.box(
                          fn(sdot : view::View) -> Unit {
                            let _ = sdot
                            .width(view::Live::Is(Some(7.0)))
                            .height(view::Live::Is(Some(7.0)))
                            .rigid()
                            .radius(view::Live::Is(3.5))
                            .ground(view::Live::By(fn() -> Int64 {
                              match get_other_sp() {
                                Some(sp) => proto::workspace_accent_color(sp.accent)
                                None => 0x2563EBFFL
                              }
                            }))
                          },
                        )
                        let _ = ib.box(
                          fn(lbl : view::View) -> Unit {
                            let _ = lbl
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(fn() -> String {
                                match get_other_sp() {
                                  Some(sp) => sp.name
                                  None => ""
                                }
                              }),
                              ink=0x1F2937FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                          },
                        )
                        let _ = ib.box(
                          fn(hw : view::View) -> Unit {
                            let _ = hw
                            .rigid()
                            .words(
                              view::Live::Is("Space"),
                              ink=0x8E8E93FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                          },
                        )
                      },
                    )
                  },
                )
                sslot = sslot + 1
              }
            },
          )
          // Final divider before Close group (Close Other Tabs + Close Tab)
          render_hairline(menu)
          // Close Other Tabs (enabled only when other unpinned tabs exist in same Space; disabled is non-clickable)
          let has_other_closable = fn() -> Bool {
            let _ = workspace_rev.get()
            proto::tab_close_others_enabled(app_state.workspace, tab_ctx_tab_id.get())
          }
          menu.show(
            has_other_closable,
            fn(cw : view::View) -> Unit {
              render_ctx_item(
                cw,
                fn() -> String { "Close Other Tabs" },
                fn() -> String {
                  let _ = workspace_rev.get()
                  let n = proto::tab_close_others_count(app_state.workspace, tab_ctx_tab_id.get())
                  if n > 0 { n.to_string() } else { "" }
                },
                false,
                fn() -> Unit {
                  let tid = tab_ctx_tab_id.untracked()
                  close_tab_ctx()
                  dispatch_tab_close_others(tid)
                },
              )
            },
          )
          menu.show(
            fn() -> Bool { !has_other_closable() },
            fn(cw_dis : view::View) -> Unit {
              render_ctx_disabled(cw_dis, "Close Other Tabs")
            },
          )
          render_ctx_item(
            menu,
            fn() -> String { "Close Tab" },
            fn() -> String { if ui::keys_system() <= 0 { "⌘W" } else { "Ctrl+W" } },
            true,
            fn() -> Unit {
              let tid = tab_ctx_tab_id.untracked()
              close_tab_ctx()
              dispatch_tab_close(tid)
            },
          )
        },
      )
    },
  )
}
