///| The omnibox's default row (A1): chosen for what is typed while the person has not arrowed, and never chosen again
///| over the person's own choice — arrowing back up to what they typed (-1) included — when later results come in.

import "proto"

fn omni_item(cat : proto::OmniSuggestCategory, url : String) -> proto::OmniSuggestItem {
  proto::OmniSuggestItem::{
    category: cat,
    title: url,
    url,
    subtitle: "",
    badge_label: "",
    section_title: "",
    tab_id: "",
    visits: 3,
    score: 1.0,
  }
}

test "omnibox default row: the site's own page for what is typed, none for a deeper page or a search" {
  let gh = [omni_item(proto::OmniSuggestCategory::History, "https://github.com/")]
  debug_assert(omni_default_selection("gith", gh) == 0, "gith -> github.com")
  let deep = [omni_item(proto::OmniSuggestCategory::History, "https://github.com/a/b")]
  debug_assert(omni_default_selection("gith", deep) == -1, "a deeper history page is not the default")
  debug_assert(omni_default_selection("git hub", gh) == -1, "words with a space are a search")
  debug_assert(omni_default_selection("g", gh) == -1, "one letter chooses nothing")
}

test "omnibox default row: later results re-choose only while the omnibox chooses, never over the person's choice" {
  // typed: auto, the default chosen
  let (a, auto_a) = omni_next_selection(-1, true, 0, 3)
  debug_assert(a == 0 && auto_a, "typed: the default row")
  // more results for the same query, still auto: chosen again (it may move)
  let (b, auto_b) = omni_next_selection(0, true, -1, 5)
  debug_assert(b == -1 && auto_b, "a ranking with no default: what was typed")
  // the person arrowed back up to what they typed (-1): results that would have a default leave it there
  let (c, auto_c) = omni_next_selection(-1, false, 0, 5)
  debug_assert(c == -1 && !auto_c, "the person's -1 stays: Enter goes to what they typed")
  // the person arrowed to row 2: kept (clamped to the rows there are)
  let (d, _) = omni_next_selection(2, false, 0, 5)
  debug_assert(d == 2, "the person's row stays")
  let (e, _) = omni_next_selection(4, false, 0, 2)
  debug_assert(e == 1, "clamped to the rows there are")
}
