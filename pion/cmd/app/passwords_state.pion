///| The password manager on the client (no UI here: `shell_ui/passwords_panel.pion` draws it): the Save / Update
///| prompt the host sends after a login form was sent, the autofill dropdown over the focused login field, and the
///| Settings -> Privacy -> Passwords list. Passwords themselves stay on the host: one comes here only when the person
///| asks to see or copy it (`password_reveal`), and is let go when hidden.

let pw_prompt : signals::Signal[proto::PasswordPromptState] = signals::signal(proto::PasswordPromptState::hidden())

let pw_prompt_open : signals::Signal[Bool] = signals::signal(false)

let pw_items : signals::Signal[Array[proto::PasswordItemSummary]] = signals::signal([])

///| the one login shown with Show password: (id, password), ("", "") for none
let pw_shown : signals::Signal[(String, String)] = signals::signal_by(("", ""), fn(a : (String, String), b : (String, String)) -> Bool {
  a.0 == b.0 && a.1 == b.1
})

///| (every answer is news: the dropdown redraws from it)
let pw_suggest : signals::Signal[proto::AutofillSnapshot] = signals::signal_by(proto::AutofillSnapshot::empty(), fn(
  _a : proto::AutofillSnapshot,
  _b : proto::AutofillSnapshot,
) -> Bool {
  false
})

let pw_dropdown_open : signals::Signal[Bool] = signals::signal(false)

///| what each reveal asked for is for: req id -> "show" or "copy"
let pw_reveal_for : Map[String, String] = Map::new()

let pw_seq : signals::Ref[Int] = signals::ref_new(0)

///| the latest autofill query sent (an older answer is dropped)
let pw_query_req : signals::Ref[String] = signals::ref_new("")

let pw_fields : signals::Ref[Option[(ui::Field, ui::Field)]] = signals::ref_new(None)

///| The Save popover's username field and the Passwords search field (made once).
fn pw_username_search_fields() -> (ui::Field, ui::Field) {
  match pw_fields.v {
    Some(f) => f
    None => {
      let f = (ui::Field::new(), ui::Field::new())
      pw_fields.v = Some(f)
      f
    }
  }
}

fn pw_next_req(kind : String) -> String {
  pw_seq.v = pw_seq.v + 1
  kind + "-" + pw_seq.v.to_string()
}

fn pw_cmd(prompt_id~ : String = "", id~ : String = "", req_id~ : String = "", username~ : String = "", never~ : Bool = false) -> String {
  proto::encode_password_command(proto::PasswordCommand::{ ..proto::PasswordCommand::empty(), prompt_id, id, req_id, username, never })
}

// --- From the host -------------------------------------------------------------------------------------------

fn set_host_passwords_state(json : String) -> Unit {
  match proto::parse_password_list(json) {
    Some(snap) => {
      pw_items.set(snap.items)
      // (a login shown and then deleted is not shown any more)
      let (sid, _) = pw_shown.untracked()
      if sid != "" {
        let mut still = false
        for it in snap.items {
          if it.id == sid {
            still = true
          }
        }
        if !still {
          pw_shown.set(("", ""))
        }
      }
    }
    None => ()
  }
}

fn set_host_password_prompt(json : String) -> Unit {
  match proto::parse_password_prompt(json) {
    Some(p) =>
    if p.visible {
      let (user_f, _) = pw_username_search_fields()
      user_f.set(p.username)
      pw_prompt.set(p)
      pw_dropdown_open.set(false)
      pw_prompt_open.set(true)
    } else if p.prompt_id == "" || p.prompt_id == pw_prompt.untracked().prompt_id {
      pw_prompt_open.set(false)
    }
    None => ()
  }
}

fn set_host_password_suggestions(json : String) -> Unit {
  match proto::parse_autofill_snapshot(json) {
    Some(s) => {
      if s.req_id != pw_query_req.v {
        return
      }
      // (still the field the person is in)
      match active_stage().login_field() {
        Some(f) if f.id == s.field_id => ()
        _ => return
      }
      pw_suggest.set(s)
      pw_dropdown_open.set(!pw_prompt_open.untracked() && (s.suggestions.length() > 0 || s.can_generate))
    }
    None => ()
  }
}

fn set_host_password_revealed(json : String) -> Unit {
  match proto::parse_password_reveal(json) {
    Some(r) => {
      let what = pw_reveal_for.get(r.req_id).unwrap_or("")
      pw_reveal_for.remove(r.req_id)
      if !r.ok {
        show_toast("That password is no longer saved", "error")
      } else if what == "show" {
        pw_shown.set((r.id, r.password))
      } else if what == "copy" {
        write_os_clipboard(r.password)
        show_toast("Password Copied", "success")
      }
    }
    None => ()
  }
}

fn set_host_password_io(json : String) -> Unit {
  match proto::parse_password_io(json) {
    Some(r) => show_toast(proto::password_io_message(r), if r.ok { "success" } else { "error" })
    None => ()
  }
}

///| The host's password messages (`wire::Message::Act(verb, json, _)`); false for any other verb.
fn take_host_password_act(verb : String, json : String) -> Bool {
  if verb == proto::PW_VERB_STATE {
    set_host_passwords_state(json)
  } else if verb == proto::PW_VERB_PROMPT {
    set_host_password_prompt(json)
  } else if verb == proto::PW_VERB_SUGGESTIONS {
    set_host_password_suggestions(json)
  } else if verb == proto::PW_VERB_REVEALED {
    set_host_password_revealed(json)
  } else if verb == proto::PW_VERB_IO {
    set_host_password_io(json)
  } else {
    return false
  }
  true
}

// --- To the host ---------------------------------------------------------------------------------------------

fn dispatch_passwords_sync() -> Unit {
  send_wire(wire::Message::Act(proto::PW_VERB_LIST, pw_cmd(), ""))
}

fn pw_prompt_save(username : String) -> Unit {
  let p = pw_prompt.untracked()
  pw_prompt_open.set(false)
  if p.prompt_id != "" {
    send_wire(wire::Message::Act(proto::PW_VERB_SAVE, pw_cmd(prompt_id=p.prompt_id, username=username.trim()), ""))
    show_toast(if p.kind == "update" { "Password Updated" } else { "Password Saved" }, "success")
  }
}

fn pw_prompt_dismiss(never : Bool) -> Unit {
  let p = pw_prompt.untracked()
  pw_prompt_open.set(false)
  if p.prompt_id != "" {
    send_wire(wire::Message::Act(proto::PW_VERB_DISMISS, pw_cmd(prompt_id=p.prompt_id, never~), ""))
  }
}

fn pw_reveal(id : String, what : String) -> Unit {
  let req = pw_next_req("rv")
  pw_reveal_for.set(req, what)
  send_wire(wire::Message::Act(proto::PW_VERB_REVEAL, pw_cmd(id~, req_id=req), ""))
}

fn pw_copy_username(id : String) -> Unit {
  for it in pw_items.untracked() {
    if it.id == id {
      write_os_clipboard(it.username)
      show_toast("Username Copied", "success")
      return
    }
  }
}

fn pw_delete(id : String) -> Unit {
  if pw_shown.untracked().0 == id {
    pw_shown.set(("", ""))
  }
  send_wire(wire::Message::Act(proto::PW_VERB_DELETE, pw_cmd(id~), ""))
}

///| The person moved into a field of the page: ask the host what it can fill there (it decides whether the field is
///| a login one, from the page it has).
fn pw_on_field_focus(field_id : Int) -> Unit {
  pw_dropdown_open.set(false)
  if field_id < 0 {
    return
  }
  let req = pw_next_req("af")
  pw_query_req.v = req
  let q = proto::AutofillQuery::{ req_id: req, url: active_stage().url(), field_id, password_field_id: -1 }
  send_wire(wire::Message::Act(proto::PW_VERB_AUTOFILL_QUERY, proto::encode_autofill_query(q), ""))
}

fn pw_fill(id : String, generate : Bool) -> Unit {
  let s = pw_suggest.untracked()
  pw_dropdown_open.set(false)
  let r = proto::AutofillFillRequest::{ url: active_stage().url(), id, field_id: s.field_id, password_field_id: s.password_field_id, generate }
  send_wire(wire::Message::Act(proto::PW_VERB_AUTOFILL_FILL, proto::encode_autofill_fill(r), ""))
}

// --- Mounted by the shell ------------------------------------------------------------------------------------

fn build_settings_passwords_props() -> shell_ui::SettingsPasswordsProps {
  let (_, search_f) = pw_username_search_fields()
  shell_ui::SettingsPasswordsProps::{
    items: fn() { pw_items.get() },
    search_field: search_f,
    revealed: fn(id : String) -> Option[String] {
      let (sid, pw) = pw_shown.get()
      if sid == id && sid != "" { Some(pw) } else { None }
    },
    on_show: fn(id) { pw_reveal(id, "show") },
    on_hide: fn(_id) { pw_shown.set(("", "")) },
    on_copy_username: pw_copy_username,
    on_copy_password: fn(id) { pw_reveal(id, "copy") },
    on_delete: pw_delete,
    on_import: fn() { send_wire(wire::Message::Act(proto::PW_VERB_IMPORT, "", "")) },
    on_export: fn() { send_wire(wire::Message::Act(proto::PW_VERB_EXPORT, "", "")) },
  }
}

///| The Save / Update popover (anchored under the address bar's start) and the autofill dropdown.
fn build_password_overlays(root : view::View, fallback_capsule : () -> shell_ui::AnchorRect) -> Unit {
  let (user_f, _) = pw_username_search_fields()
  shell_ui::build_password_save_popover(
    root,
    shell_ui::PasswordSavePopoverProps::{
      open: fn() { pw_prompt_open.get() },
      prompt: fn() { pw_prompt.get() },
      username_field: user_f,
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        match shell_ui::anchor_from_view(app_state.address_bar_view) {
          Some(ab) => Some(shell_ui::AnchorRect::{ x: ab.x, y: ab.y, w: 40.0, h: ab.h })
          None => None
        }
      },
      fallback_capsule,
      on_save: pw_prompt_save,
      on_never: fn() { pw_prompt_dismiss(true) },
      on_close: fn() { pw_prompt_dismiss(false) },
    },
  )
  shell_ui::build_autofill_dropdown(
    root,
    shell_ui::AutofillDropdownProps::{
      open: fn() { pw_dropdown_open.get() },
      field_rect: fn() -> shell_ui::AnchorRect {
        match active_stage_live().login_field() {
          Some(f) => shell_ui::AnchorRect::{ x: f.x, y: f.y, w: f.w, h: f.h }
          None => shell_ui::AnchorRect::empty()
        }
      },
      suggestions: fn() { pw_suggest.get().suggestions },
      can_generate: fn() { pw_suggest.get().can_generate },
      on_pick: fn(id) { pw_fill(id, false) },
      on_generate: fn() { pw_fill("", true) },
      on_manage: fn() {
        pw_dropdown_open.set(false)
        open_settings(tab_idx=shell_ui::SETTINGS_TAB_PRIVACY)
        dispatch_passwords_sync()
      },
      on_close: fn() { pw_dropdown_open.set(false) },
    },
  )
  // (each field the person moves into is asked about once; leaving every field closes the dropdown)
  root.reacts(
    fn() -> Int {
      match active_stage_live().login_field() {
        Some(f) => f.id
        None => -1
      }
    },
    pw_on_field_focus,
    at_start=false,
  )
}
