///| The client takes the host's Memory Saver state: each tab's hover-card line and whether it is inactive.

test "app memory saver: the host's state gives each tab its hover line" {
  let prev = host_memory_saver.snap
  set_host_memory_saver_state("fvms1\t1\t153600\t421888\n3\t0\t1\t153600\n7\t421888\t0\t0")
  debug_assert(host_memory_saver.snap.saved_kb == 153600L, "saved")
  let (l3, off3) = tab_memory_saver_line("3")
  debug_assert(l3 == "Inactive, saved 150 MB" && off3, "inactive tab: " + l3)
  let (l7, off7) = tab_memory_saver_line("7")
  debug_assert(l7 == "Memory 412 MB" && !off7, "shown tab: " + l7)
  let (l9, off9) = tab_memory_saver_line("9")
  debug_assert(l9 == "" && !off9, "no record, no line")
  // (a payload that is not one leaves the state as it was)
  set_host_memory_saver_state("garbage")
  debug_assert(host_memory_saver.snap.saved_kb == 153600L, "kept")
  host_memory_saver.snap = prev
}
