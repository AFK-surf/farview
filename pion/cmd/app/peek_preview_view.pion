///| Arc Peek Floating Preview Modal (real process-isolated secondary Stage + Back/Forward +
///| Expand/Split/Copy Clean URL/Close), Webpage Right-Click Context Menu (`Open in Peek`),
///| and Arc Sidebar Tab Hover Preview Card.
///| 100% reactive to Light & Dark `ChromePalette`, concentric radii, first-line alignment,
///| zero double dividers, zero `alpha=0` clickable controls, and zero `ellipsis_past(true)`.

fn set_host_peek_state(json : String) -> Unit {
  match proto::parse_peek_snapshot(json) {
    Some(snap) => {
      app_state.peek_snap = snap
      match app_state.peek_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
    }
    None => ()
  }
}

fn peek_current_url() -> String {
  match app_state.split_stage {
    Some(st) if st.url() != "" => st.url()
    _ => match app_state.peek_url {
      Some(s) => s.untracked()
      None => ""
    }
  }
}

fn close_page_ctx() -> Unit {
  match app_state.page_ctx_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
}

fn open_page_ctx(target_stage : stage::Stage, hit : stage::MenuHit) -> Unit {
  close_exclusive_overlays()
  app_state.page_ctx_stage = Some(target_stage)
  match app_state.page_ctx_link {
    Some(s) => s.set(hit.link.trim())
    None => ()
  }
  match app_state.page_ctx_x {
    Some(s) => s.set(hit.x)
    None => ()
  }
  match app_state.page_ctx_y {
    Some(s) => s.set(hit.y)
    None => ()
  }
  match app_state.page_ctx_can_back {
    Some(s) => s.set(hit.can_back)
    None => ()
  }
  match app_state.page_ctx_can_forward {
    Some(s) => s.set(hit.can_forward)
    None => ()
  }
  match app_state.page_ctx_open {
    Some(s) => s.set(true)
    None => ()
  }
}

fn open_tab_hover_preview(tab_id : String, anchor_y : Double, pinned_demo~ : Bool = false) -> Unit {
  if tab_id.trim() == "" {
    return
  }
  match app_state.tab_preview_tab_id {
    Some(s) => if s.untracked() != tab_id { s.set(tab_id) }
    None => ()
  }
  match app_state.tab_preview_y {
    Some(s) => if (s.untracked() - anchor_y).abs() > 1.0 { s.set(anchor_y) }
    None => ()
  }
  app_state.tab_preview_pinned_demo = pinned_demo
  match app_state.tab_preview_open {
    Some(s) => if !s.untracked() { s.set(true) }
    None => ()
  }
}

fn close_tab_hover_preview(force~ : Bool = false) -> Unit {
  if !force && app_state.tab_preview_pinned_demo {
    return
  }
  app_state.tab_preview_pinned_demo = false
  match app_state.tab_preview_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  match app_state.tab_preview_tab_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
}

fn tab_preview_media_state(tb : proto::TabSummary) -> (Bool, Bool) {
  let sessions = app_state.media_hub_snap.sessions
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    let matched = (s.tab_id != "" && s.tab_id == tb.id) || (s.tab_id == "active" && tb.active)
    if matched && (s.playing || s.muted || s.is_live_call) {
      return (s.playing || s.is_live_call, s.muted)
    }
    i = i + 1
  }
  match app_state.workspace.media {
    Some(m) => {
      let matched = if m.tab_id != "" { m.tab_id == tb.id } else { tb.active }
      if matched && (m.playing || m.muted || m.is_meeting) {
        return (m.playing || m.is_meeting, m.muted)
      }
    }
    None => ()
  }
  (false, false)
}

fn tab_preview_is_in_split(tb : proto::TabSummary) -> Bool {
  if !is_split_open() {
    return false
  }
  let sid = match app_state.split_tab_id {
    Some(s) => s.get()
    None => ""
  }
  if sid != "" && tb.id == sid {
    return true
  }
  match app_state.split_stage {
    Some(sp_st) => {
      let su = sp_st.url()
      su != "" && tb.url != "" && su == tb.url && !tb.active
    }
    None => false
  }
}

fn tab_preview_badge_colors(is_dark : Bool, kind : String, space_accent : Int64) -> (Int64, Int64, Int64) {
  if kind == "space" {
    let bg = (space_accent & 0xFFFFFF00L) | (if is_dark { 0x2CL } else { 0x1EL })
    let border = (space_accent & 0xFFFFFF00L) | (if is_dark { 0x60L } else { 0x48L })
    (bg, border, space_accent)
  } else if kind == "playing" {
    if is_dark {
      (0x0E2F26FFL, 0x1B5E4AFFL, 0x34D399FFL)
    } else {
      (0xDCFCE7FFL, 0x86EFACFFL, 0x15803DFFL)
    }
  } else if kind == "muted" {
    if is_dark {
      (0x361D22FFL, 0x6B2D38FFL, 0xFCA5A5FFL)
    } else {
      (0xFEE2E2FFL, 0xFECACAFFL, 0xB91C1CFFL)
    }
  } else if kind == "split" {
    if is_dark {
      (0x1E2E4AFFL, 0x2F4B78FFL, 0x93C5FDFFL)
    } else {
      (0xEAF3FFFFL, 0xBFD7FFFFL, 0x1D4ED8FFL)
    }
  } else if kind == "reader" {
    if is_dark {
      (0x362A14FFL, 0x6B4F1DFFL, 0xFBBF24FFL)
    } else {
      (0xFEF3C7FFL, 0xFCD34DFFL, 0xB45309FFL)
    }
  } else if kind == "boost" {
    if is_dark {
      (0x2B1E45FFL, 0x523482FFL, 0xC4B5FDFFL)
    } else {
      (0xF3E8FFFFL, 0xD8B4FEFFL, 0x7E22CEFFL)
    }
  } else if is_dark {
    (0x252A36FFL, 0x353C4DFFL, 0xCBD5E1FFL)
  } else {
    (0xF3F4F6FFL, 0xE2E6F0FFL, 0x4B5563FFL)
  }
}

///| Builds the Arc Sidebar Tab Hover Preview Card.
///| Mounted BEFORE context menus, Peek modal, Command Bar, and Toast so menus/modals always sit above it.
fn build_tab_hover_preview(
  root : view::View,
  tab_preview_open : signals::Signal[Bool],
  tab_preview_tab_id : signals::Signal[String],
  tab_preview_y : signals::Signal[Double],
  sidebar_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  media_hub_rev : signals::Signal[Int],
  reader_open : signals::Signal[Bool],
  boosts_rev : signals::Signal[Int],
) -> Unit {
  let get_preview_tab = fn() -> Option[proto::TabSummary] {
    let _ = workspace_rev.get()
    let tid = tab_preview_tab_id.get()
    if tid == "" {
      return None
    }
    find_tab_summary(tid)
  }

  root.show(
    fn() -> Bool {
      sidebar_open.get() && tab_preview_open.get() && get_preview_tab().is_some()
    },
    fn(card_layer : view::View) -> Unit {
      let _ = card_layer
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        let (_, rh) = root.laid_size()
        let vh = if rh > 100.0 { rh } else { 800.0 }
        let est_h = match get_preview_tab() {
          Some(tb) => {
            let _ = media_hub_rev.get()
            let (pl, mu) = tab_preview_media_state(tb)
            if pl || mu { 164.0 } else { 126.0 }
          }
          None => 126.0
        }
        let clamped_y = proto::clamp_tab_preview_y(tab_preview_y.get(), est_h, vh, 52.0)
        (Some(248.0), Some(clamped_y), None, None)
      }))
      .width(view::Live::Is(Some(272.0)))
      .rigid()
      .clips(view::Live::Is(true))
      .radius(view::Live::Is(12.0))
      .padding(view::Live::Is((11.0, 11.0, 11.0, 11.0)))
      .gap(view::Live::Is(8.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        let p = chrome_palette()
        (1.0, if p.is_dark { 0x353B4BFFL } else { p.border })
      }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (24.0, 8.0, 0x00000072L) } else { (18.0, 6.0, 0x0F172A24L) }
      }))
      app_state.tab_preview_card_view = Some(card_layer)
      let _ = card_layer.owns(fn() -> Unit {
        app_state.tab_preview_card_view = None
      })
      card_layer.reacts(
        fn() -> Bool { card_layer.pointed() },
        fn(is_p : Bool) -> Unit {
          if !is_p && !app_state.tab_preview_pinned_demo {
            close_tab_hover_preview()
          }
        },
      )

      let get_space_meta = fn() -> (String, Int64) {
        let _ = workspace_rev.get()
        match get_preview_tab() {
          Some(tb) => {
            let mut i = 0
            while i < app_state.workspace.spaces.length() {
              let sp = app_state.workspace.spaces[i]
              if sp.id == tb.space_id {
                return (
                  if sp.name != "" { sp.name } else { sp.id },
                  proto::workspace_accent_color(sp.accent),
                )
              }
              i = i + 1
            }
            (tb.space_id, 0x2563EBFFL)
          }
          None => ("", 0x2563EBFFL)
        }
      }

      let get_badges = fn() -> Array[proto::TabPreviewBadge] {
        let _ = workspace_rev.get()
        let _ = media_hub_rev.get()
        let _ = boosts_rev.get()
        match get_preview_tab() {
          Some(tb) => {
            let (sp_name, _) = get_space_meta()
            let (playing, muted) = tab_preview_media_state(tb)
            let in_split = tab_preview_is_in_split(tb)
            let is_reader = tb.active && reader_open.get()
            let tb_host = proto::normalize_boost_host(tb.url)
            let mut has_boost = false
            let mut bi = 0
            while bi < app_state.boosts_snap.items.length() {
              let bs = app_state.boosts_snap.items[bi]
              if bs.enabled && bs.host != "" && tb_host == bs.host {
                has_boost = true
                break
              }
              bi = bi + 1
            }
            proto::build_tab_preview_badges(
              sp_name,
              tb.pinned || tb.favorite,
              in_split,
              playing,
              muted,
              is_reader,
              has_boost,
            )
          }
          None => []
        }
      }

      // 1. Header: 26x26 monogram tile aligned to first line of 2-line title + cleaned host/path
      let _ = card_layer.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Start)))
          .rigid()
          .gap(view::Live::Is(9.0))

          let _ = hdr.box(
            fn(tile : view::View) -> Unit {
              let _ = tile
              .width(view::Live::Is(Some(26.0)))
              .height(view::Live::Is(Some(26.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let (_, acc) = get_space_meta()
                (acc & 0xFFFFFF00L) | (if is_dark_chrome() { 0x2EL } else { 0x1EL })
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let (_, acc) = get_space_meta()
                (1.0, (acc & 0xFFFFFF00L) | (if is_dark_chrome() { 0x5CL } else { 0x40L }))
              }))
              let _ = tile.box(
                fn(ml : view::View) -> Unit {
                  let _ = ml
                  .words(
                    view::Live::By(fn() -> String {
                      match get_preview_tab() {
                        Some(tb) => proto::omnibox_initial_letter(tb.url, tb.title)
                        None => ""
                      }
                    }),
                    ink=0x2563EBFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 700, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { get_space_meta().1 }))
                },
              )
            },
          )

          let _ = hdr.box(
            fn(meta : view::View) -> Unit {
              let _ = meta
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .gap(view::Live::Is(3.0))

              // Full tab title (up to 2 lines, clean wrap, zero overlap with URL line)
              let _ = meta.box(
                fn(tbox : view::View) -> Unit {
                  let _ = tbox
                  .rigid()
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(fn() -> String {
                      match get_preview_tab() {
                        Some(tb) => proto::tab_preview_display_title(proto::workspace_tab_display_title(tb))
                        None => ""
                      }
                    }),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: true },
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              // Cleaned readable host + path (single line)
              let _ = meta.box(
                fn(ubox : view::View) -> Unit {
                  let _ = ubox
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(fn() -> String {
                      match get_preview_tab() {
                        Some(tb) => proto::tab_preview_display_url(tb.url)
                        None => ""
                      }
                    }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )

      // 2. Real-time status badge row (Space, Pinned, Split, Playing/Muted, Reader, Boost)
      card_layer.show(
        fn() -> Bool { get_badges().length() > 0 },
        fn(brow : view::View) -> Unit {
          let _ = brow
          .row(view::Live::Is(true))
          .wraps(view::Live::Is(Some(5.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(5.0))
          let mut bi = 0
          while bi < 6 {
            let idx = bi
            brow.show(
              fn() -> Bool { idx < get_badges().length() },
              fn(pill : view::View) -> Unit {
                let get_b = fn() -> Option[proto::TabPreviewBadge] {
                  let list = get_badges()
                  if idx < list.length() { Some(list[idx]) } else { None }
                }
                let _ = pill
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(20.0)))
                .rigid()
                .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                .gap(view::Live::Is(4.0))
                .radius(view::Live::Is(6.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let (_, acc) = get_space_meta()
                  match get_b() {
                    Some(b) => tab_preview_badge_colors(is_dark_chrome(), b.kind, acc).0
                    None => 0x00000000L
                  }
                }))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  let (_, acc) = get_space_meta()
                  match get_b() {
                    Some(b) => (1.0, tab_preview_badge_colors(is_dark_chrome(), b.kind, acc).1)
                    None => (0.0, 0x00000000L)
                  }
                }))

                // Live dot for Space or Playing badge
                pill.show(
                  fn() -> Bool {
                    match get_b() {
                      Some(b) => b.kind == "space" || b.kind == "playing"
                      None => false
                    }
                  },
                  fn(dot : view::View) -> Unit {
                    let _ = dot
                    .width(view::Live::Is(Some(6.0)))
                    .height(view::Live::Is(Some(6.0)))
                    .rigid()
                    .radius(view::Live::Is(3.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let (_, acc) = get_space_meta()
                      match get_b() {
                        Some(b) => tab_preview_badge_colors(is_dark_chrome(), b.kind, acc).2
                        None => acc
                      }
                    }))
                  },
                )

                let _ = pill.box(
                  fn(bl : view::View) -> Unit {
                    let _ = bl
                    .rigid()
                    .words(
                      view::Live::By(fn() -> String {
                        match get_b() {
                          Some(b) => b.label
                          None => ""
                        }
                      }),
                      ink=0x374151FFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 {
                      let (_, acc) = get_space_meta()
                      match get_b() {
                        Some(b) => tab_preview_badge_colors(is_dark_chrome(), b.kind, acc).2
                        None => chrome_palette().ink_secondary
                      }
                    }))
                  },
                )
              },
            )
            bi = bi + 1
          }
        },
      )

      // 3. Footer quick action: Mute / Unmute when tab has active or muted audio
      let has_audio_ctrl = fn() -> Bool {
        let _ = media_hub_rev.get()
        match get_preview_tab() {
          Some(tb) => {
            let (pl, mu) = tab_preview_media_state(tb)
            pl || mu
          }
          None => false
        }
      }
      let is_muted_now = fn() -> Bool {
        let _ = media_hub_rev.get()
        match get_preview_tab() {
          Some(tb) => tab_preview_media_state(tb).1
          None => false
        }
      }

      card_layer.show(
        has_audio_ctrl,
        fn(foot : view::View) -> Unit {
          let _ = foot.rigid().gap(view::Live::Is(7.0))
          // Single 1px hairline divider
          let _ = foot.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
          let _ = foot.box(
            fn(arow : view::View) -> Unit {
              let _ = arow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .gap(view::Live::Is(6.0))
              let _ = headless::button(
                arow,
                fn() -> String { if is_muted_now() { "Unmute" } else { "Mute" } },
                fn(_v : view::View) -> Unit {
                  match get_preview_tab() {
                    Some(tb) => dispatch_media_toggle_mute(tb.id)
                    None => ()
                  }
                },
                fn(mb : view::View, mbtn : headless::Button) -> Unit {
                  let _ = mb
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if mbtn.pressed() {
                      p.btn_press
                    } else if mbtn.hovered() {
                      p.btn_hover
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    (1.0, chrome_palette().border)
                  }))
                  mh_draw_mute_glyph(mb, is_muted_now)
                  let _ = mb.box(
                    fn(ml : view::View) -> Unit {
                      let _ = ml
                      .rigid()
                      .words(
                        view::Live::By(fn() -> String {
                          if is_muted_now() { "Unmute" } else { "Mute" }
                        }),
                        ink=0x1F2937FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Builds the Webpage Right-Click Context Menu (`Open in Peek`, `Open in Split View`,
///| `Open in New Tab`, `Copy Clean Link`, and page navigation/copy actions).
fn build_page_context_menu(
  root : view::View,
  page_ctx_open : signals::Signal[Bool],
  page_ctx_link : signals::Signal[String],
  page_ctx_x : signals::Signal[Double],
  page_ctx_y : signals::Signal[Double],
  page_ctx_can_back : signals::Signal[Bool],
  page_ctx_can_forward : signals::Signal[Bool],
) -> Unit {
  root.show(
    fn() -> Bool { page_ctx_open.get() },
    fn(ctx_layer : view::View) -> Unit {
      let _ = ctx_layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      // Click-outside scrim
      let _ = headless::button(
        ctx_layer,
        fn() -> String { "Dismiss Page Context Menu" },
        fn(_v : view::View) -> Unit { close_page_ctx() },
        fn(bg : view::View, _b : headless::Button) -> Unit {
          let _ = bg.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
        },
      )

      let menu_item = fn(
        parent : view::View,
        label : String,
        hint : String,
        accent_row : Bool,
        on_click : () -> Unit,
      ) -> Unit {
        let _ = headless::button(
          parent,
          fn() -> String { label },
          fn(_v : view::View) -> Unit {
            close_page_ctx()
            on_click()
          },
          fn(row : view::View, btn : headless::Button) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .height(view::Live::Is(Some(28.0)))
            .rigid()
            .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
            .gap(view::Live::Is(8.0))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if btn.pressed() {
                if accent_row { p.accent_soft_bg } else { p.btn_press }
              } else if btn.hovered() {
                if accent_row { p.accent_soft_bg } else { p.tab_hover_bg }
              } else {
                0x00000000L
              }
            }))
            let _ = row.box(
              fn(lbox : view::View) -> Unit {
                let _ = lbox
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(0.0)))
                .clips(view::Live::Is(true))
                .words(
                  view::Live::Is(label),
                  ink=0x1F2937FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: if accent_row { 600 } else { 500 }, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if accent_row { p.accent } else { p.ink_primary }
                }))
              },
            )
            if hint != "" {
              let _ = row.box(
                fn(hbox : view::View) -> Unit {
                  let _ = hbox
                  .rigid()
                  .words(
                    view::Live::Is(hint),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            }
          },
        )
      }

      let _ = ctx_layer.box(
        fn(menu : view::View) -> Unit {
          let _ = menu
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let (rw, rh) = root.laid_size()
            let vw = if rw > 100.0 { rw } else { 1280.0 }
            let vh = if rh > 100.0 { rh } else { 800.0 }
            let has_link = page_ctx_link.get() != ""
            let est_h = if has_link { 240.0 } else { 112.0 }
            let (cx, cy) = proto::clamp_context_menu_pos(page_ctx_x.get(), page_ctx_y.get(), 224.0, est_h, vw, vh)
            (Some(cx), Some(cy), None, None)
          }))
          .width(view::Live::Is(Some(224.0)))
          .rigid()
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(10.0))
          .padding(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
          .gap(view::Live::Is(2.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            (1.0, if p.is_dark { 0x353B4BFFL } else { p.border })
          }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (22.0, 8.0, 0x00000078L) } else { (16.0, 6.0, 0x0F172A24L) }
          }))

          menu.show(
            fn() -> Bool { page_ctx_link.get() != "" },
            fn(link_grp : view::View) -> Unit {
              let _ = link_grp.rigid().gap(view::Live::Is(2.0))
              menu_item(
                link_grp,
                "Open in Peek",
                "⇧Click",
                true,
                fn() -> Unit {
                  let u = page_ctx_link.untracked()
                  if u != "" {
                    open_peek_preview(u, "")
                  }
                },
              )
              menu_item(
                link_grp,
                "Open Link in Split View",
                "",
                false,
                fn() -> Unit {
                  let u = page_ctx_link.untracked()
                  if u != "" {
                    open_split_view(u, "", focus_pane=1)
                  }
                },
              )
              menu_item(
                link_grp,
                "Open Link in New Tab",
                "",
                false,
                fn() -> Unit {
                  let u = page_ctx_link.untracked()
                  if u != "" {
                    dispatch_tab_new(u, "")
                  }
                },
              )
              menu_item(
                link_grp,
                "Copy Clean Link",
                "",
                false,
                fn() -> Unit {
                  let u = page_ctx_link.untracked()
                  if u != "" {
                    copy_url_with_toast(u)
                  }
                },
              )
              // Single hairline divider between link actions and page actions
              let _ = link_grp.box(
                fn(sep : view::View) -> Unit {
                  let _ = sep
                  .height(view::Live::Is(Some(1.0)))
                  .rigid()
                  .padding(view::Live::Is((4.0, 2.0, 4.0, 2.0)))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )
            },
          )

          menu.show(
            fn() -> Bool { page_ctx_can_back.get() },
            fn(bw : view::View) -> Unit {
              let _ = bw.rigid()
              menu_item(
                bw,
                "Back",
                "",
                false,
                fn() -> Unit {
                  match app_state.page_ctx_stage {
                    Some(ts) => ts.back()
                    None => active_stage().back()
                  }
                },
              )
            },
          )
          menu.show(
            fn() -> Bool { page_ctx_can_forward.get() },
            fn(fw : view::View) -> Unit {
              let _ = fw.rigid()
              menu_item(
                fw,
                "Forward",
                "",
                false,
                fn() -> Unit {
                  match app_state.page_ctx_stage {
                    Some(ts) => ts.forward()
                    None => active_stage().forward()
                  }
                },
              )
            },
          )
          menu_item(
            menu,
            "Reload Page",
            if ui::keys_system() <= 0 { "⌘R" } else { "Ctrl+R" },
            false,
            fn() -> Unit {
              match app_state.page_ctx_stage {
                Some(ts) => ts.reload()
                None => active_stage().reload()
              }
            },
          )
          menu_item(
            menu,
            "Copy Clean Page URL",
            if ui::keys_system() <= 0 { "⇧⌘C" } else { "Ctrl+Shift+C" },
            false,
            fn() -> Unit {
              let u = match app_state.page_ctx_stage {
                Some(ts) => ts.url()
                None => active_stage().url()
              }
              copy_url_with_toast(u)
            },
          )
        },
      )
    },
  )
}

///| Builds the Arc Peek Floating Preview Modal (real secondary Stage, 84% x 86% centered card,
///| Light & Dark `ChromePalette`, concentric 14pt -> 6pt radii, Back/Forward, Split/Expand/Copy Clean URL/Close).
fn build_peek_preview_modal(
  root : view::View,
  peek_open : signals::Signal[Bool],
  peek_url : signals::Signal[String],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { peek_open.get() },
    fn(pk_layer : view::View) -> Unit {
      let peek_st = ensure_split_stage()
      let _ = pk_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Semi-transparent dimmed scrim (click closes Peek & frees Peek tab)
      let _ = headless::button(
        pk_layer,
        fn() -> String { "Close Peek Preview" },
        fn(_v : view::View) -> Unit { close_peek_preview() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x0206178CL } else { 0x0F172A58L }
          }))
        },
      )

      let peek_space_color = fn() -> Int64 {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => proto::workspace_accent_color(sp.accent)
          None => chrome_palette().accent
        }
      }

      let peek_live_url = fn() -> String {
        let su = peek_st.url()
        if su != "" { su } else { peek_url.get() }
      }

      let peek_nav_btn = fn(
        parent : view::View,
        glyph : String,
        label : String,
        enabled : () -> Bool,
        on_click : () -> Unit,
      ) -> Unit {
        let _ = headless::button(
          parent,
          fn() -> String { label },
          fn(_v : view::View) -> Unit {
            if enabled() {
              on_click()
            }
          },
          fn(nb : view::View, nbtn : headless::Button) -> Unit {
            let _ = nb
            .width(view::Live::Is(Some(24.0)))
            .height(view::Live::Is(Some(24.0)))
            .rigid()
            .center()
            .radius(view::Live::Is(6.0))
            .presses(view::Live::By(enabled))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if !enabled() {
                0x00000000L
              } else if nbtn.pressed() {
                p.btn_press
              } else if nbtn.hovered() {
                p.btn_hover
              } else {
                0x00000000L
              }
            }))
            let _ = nb.box(
              fn(ng : view::View) -> Unit {
                let _ = ng
                .words(
                  view::Live::Is(glyph),
                  ink=0x374151FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if enabled() { p.ink_primary } else { (p.ink_muted & 0xFFFFFF00L) | 0x66L }
                }))
              },
            )
          },
        )
      }

      let peek_action_btn = fn(
        parent : view::View,
        label : String,
        primary : Bool,
        on_click : () -> Unit,
      ) -> Unit {
        let _ = headless::button(
          parent,
          fn() -> String { label },
          fn(_v : view::View) -> Unit { on_click() },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let _ = b
            .height(view::Live::Is(Some(24.0)))
            .rigid()
            .center()
            .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if primary {
                if btn.pressed() {
                  (p.accent & 0xFFFFFF00L) | 0x44L
                } else if btn.hovered() {
                  (p.accent & 0xFFFFFF00L) | 0x30L
                } else {
                  p.accent_soft_bg
                }
              } else if btn.pressed() {
                p.btn_press
              } else if btn.hovered() {
                p.btn_hover
              } else {
                p.surface_bg
              }
            }))
            .edge(view::Live::By(fn() -> (Double, Int64) {
              let p = chrome_palette()
              if primary {
                (1.0, p.accent_soft_border)
              } else {
                (1.0, p.border)
              }
            }))
            let _ = b.box(
              fn(lbl : view::View) -> Unit {
                let _ = lbl
                .rigid()
                .words(
                  view::Live::Is(label),
                  ink=0x1F2937FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if primary { p.accent_soft_ink } else { p.ink_primary }
                }))
              },
            )
          },
        )
      }

      let _ = pk_layer.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::By(fn() -> Option[Double] {
            let (rw, rh) = root.laid_size()
            Some(proto::peek_modal_size(rw, rh).0)
          }))
          .height(view::Live::By(fn() -> Option[Double] {
            let (rw, rh) = root.laid_size()
            Some(proto::peek_modal_size(rw, rh).1)
          }))
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(14.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            (1.0, if p.is_dark { 0x353B4BFFL } else { p.border })
          }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (36.0, 14.0, 0x00000088L) } else { (32.0, 14.0, 0x0F172A3AL) }
          }))

          // Top 38pt Peek Toolbar (single-line baseline aligned, concentric 6pt controls inside 14pt card)
          let _ = card.box(
            fn(tbar : view::View) -> Unit {
              let _ = tbar
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(38.0)))
              .rigid()
              .padding(view::Live::Is((10.0, 0.0, 8.0, 0.0)))
              .gap(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

              // Left: Back/Forward + status dot + domain/security capsule + page title
              let _ = tbar.box(
                fn(meta : view::View) -> Unit {
                  let _ = meta
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .gap(view::Live::Is(6.0))

                  // Compact Back / Forward nav controls for in-Peek browsing
                  peek_nav_btn(
                    meta,
                    "‹",
                    "Peek Back",
                    fn() -> Bool { peek_st.can_back() },
                    fn() -> Unit { peek_st.back() },
                  )
                  peek_nav_btn(
                    meta,
                    "›",
                    "Peek Forward",
                    fn() -> Bool { peek_st.can_forward() },
                    fn() -> Unit { peek_st.forward() },
                  )

                  // Domain + security / loading capsule
                  let _ = meta.box(
                    fn(host_pill : view::View) -> Unit {
                      let _ = host_pill
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .height(view::Live::Is(Some(22.0)))
                      .rigid()
                      .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                      .gap(view::Live::Is(5.0))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                      // Space / loading indicator dot
                      let _ = host_pill.box(
                        fn(dot : view::View) -> Unit {
                          let _ = dot
                          .width(view::Live::Is(Some(6.0)))
                          .height(view::Live::Is(Some(6.0)))
                          .rigid()
                          .radius(view::Live::Is(3.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            if peek_st.loading() {
                              0xF59E0BFFL
                            } else if proto::is_secure_url(peek_live_url()) {
                              0x10B981FFL
                            } else {
                              peek_space_color()
                            }
                          }))
                        },
                      )
                      let _ = host_pill.box(
                        fn(hl : view::View) -> Unit {
                          let _ = hl
                          .rigid()
                          .words(
                            view::Live::By(fn() -> String {
                              let h = proto::split_pane_display_host(peek_live_url())
                              if peek_st.loading() { h + " …" } else { h }
                            }),
                            ink=0x5A6275FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                    },
                  )

                  // Page title (single line, bounded shrink + clips)
                  let _ = meta.box(
                    fn(ttl : view::View) -> Unit {
                      let _ = ttl
                      .shrink(view::Live::Is(1.0))
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::By(fn() -> String {
                          proto::split_pane_display_title(peek_st.title(), peek_live_url())
                        }),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                },
              )

              // Right: Open in Split, Expand to Tab, Copy Clean URL, Close
              let _ = tbar.box(
                fn(acts : view::View) -> Unit {
                  let _ = acts
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .rigid()
                  .gap(view::Live::Is(6.0))
                  peek_action_btn(acts, "Open in Split", false, fn() -> Unit { promote_peek_to_split() })
                  peek_action_btn(acts, "↗ Expand to Tab", true, fn() -> Unit { expand_peek_to_tab() })
                  peek_action_btn(acts, "Copy Clean URL", false, fn() -> Unit { copy_url_with_toast(peek_live_url()) })
                  let _ = headless::button(
                    acts,
                    fn() -> String { "Close Peek" },
                    fn(_v : view::View) -> Unit { close_peek_preview() },
                    fn(xb : view::View, xbtn : headless::Button) -> Unit {
                      let _ = xb
                      .width(view::Live::Is(Some(24.0)))
                      .height(view::Live::Is(Some(24.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if xbtn.pressed() {
                          p.btn_press
                        } else if xbtn.hovered() {
                          p.btn_hover
                        } else {
                          0x00000000L
                        }
                      }))
                      let _ = xb.box(
                        fn(xl : view::View) -> Unit {
                          let _ = xl
                          .words(
                            view::Live::Is("×"),
                            ink=0x4B5563FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Single 1px hairline divider
          let _ = card.box(
            fn(psep : view::View) -> Unit {
              let _ = psep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Isolated Secondary Stage Viewport (supports live scroll, click, links, Back/Forward)
          let _ = card.box(
            fn(pbody : view::View) -> Unit {
              let _ = pbody
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))
              let psv = stage::stage_node(
                pbody,
                peek_st,
                on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(peek_st, hit) }),
              )
              let _ = psv.min_width(view::Live::Is(Some(0.0)))
              app_state.split_stage_view = Some(psv)
            },
          )
        },
      )
    },
  )
}
