///| Cmd+D and the bookmark bubble (no UI here: `shell_ui::build_bookmark_bubble` draws it).
///|
///| Cmd+D (or the bookmarks bar's star) on a page not bookmarked yet bookmarks it and opens the bubble ("Bookmark
///| added") to name it and pick its folder; on a page already bookmarked it opens the bubble on that bookmark ("Edit
///| bookmark"), where Remove takes it away. Done, Enter, Escape or a press outside keep what the fields say.

let bm_bubble_open : signals::Signal[Bool] = signals::signal(false)

let bm_bubble_added : signals::Signal[Bool] = signals::signal(false)

///| the page the bubble is about, and the name and folder it opened with (sent again only when changed)
let bm_bubble_url : signals::Signal[String] = signals::signal("")

let bm_bubble_initial : signals::Ref[(String, String)] = signals::ref_new(("", ""))

let bm_bubble_fields : signals::Ref[Option[(ui::Field, ui::Field)]] = signals::ref_new(None)

///| The bubble's name and folder fields (made once).
fn bm_bubble_name_folder() -> (ui::Field, ui::Field) {
  match bm_bubble_fields.v {
    Some(f) => f
    None => {
      let f = (ui::Field::new(), ui::Field::new())
      bm_bubble_fields.v = Some(f)
      f
    }
  }
}

///| The page Cmd+D asked the host to bookmark whose answer (the bookmarks snapshot) has not come back yet; "" for
///| none. Until it does, the snapshot does not say the page is bookmarked, so Cmd+D again must not ask again.
let bm_add_pending_url : signals::Ref[String] = signals::ref_new("")

///| Cmd+D / the star on the active page: bookmark it and name it, or edit the bookmark it has. With the bubble
///| open, it is Done (as in Chrome: the second press keeps what the fields say and closes the bubble).
fn bookmark_page_act() -> Unit {
  if bm_bubble_open.untracked() {
    bm_bubble_done()
    return
  }
  let st = active_stage()
  let url = st.url().trim()
  if url == "" || proto::is_start_page_url(url) {
    return
  }
  let (name_f, folder_f) = bm_bubble_name_folder()
  match proto::bookmarks_entry_for_url(app_state.bookmarks_snap, url) {
    Some(e) => {
      bm_bubble_added.set(false)
      bm_bubble_initial.v = (e.title, e.folder)
      name_f.set(e.title)
      folder_f.set(e.folder)
    }
    None => {
      let t0 = st.title().trim()
      let title = if t0 != "" { t0 } else { proto::omnibox_display_host(url) }
      if bm_add_pending_url.v != url {
        // (the star confirms this one, as its bookmark comes back from the host: shell_pop_in's `confirms`)
        bookmark_confirm_url.v = url
        bm_add_pending_url.v = url
        // `bookmark_add` never removes: even sent twice, the page stays bookmarked
        send_wire(wire::Message::Act("bookmark_add", url, title))
      }
      bm_bubble_added.set(true)
      bm_bubble_initial.v = (title, proto::BOOKMARK_DEFAULT_FOLDER)
      name_f.set(title)
      folder_f.set(proto::BOOKMARK_DEFAULT_FOLDER)
    }
  }
  bm_bubble_url.set(url)
  close_exclusive_overlays(keep_tag="bookmark_bubble")
  bm_bubble_open.set(true)
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "bookmark_bubble")
}

///| Done (Enter, Escape, a press outside): the bookmark keeps what the fields say.
fn bm_bubble_done() -> Unit {
  if !bm_bubble_open.untracked() {
    return
  }
  let (name_f, folder_f) = bm_bubble_name_folder()
  let name = name_f.text().trim()
  let folder0 = folder_f.text().trim()
  let folder = if folder0 == "" { proto::BOOKMARK_DEFAULT_FOLDER } else { folder0 }
  let (n0, f0) = bm_bubble_initial.v
  let url = bm_bubble_url.untracked()
  if url != "" && ((name != "" && name != n0) || folder != f0) {
    send_wire(wire::Message::Act("bookmark_update", url, proto::encode_bookmark_update(name, folder)))
  }
  bm_bubble_close()
}

///| Remove: the bookmark goes.
fn bm_bubble_remove() -> Unit {
  let url = bm_bubble_url.untracked()
  bm_bubble_close()
  if url != "" {
    dispatch_bookmark_delete(url)
  }
}

fn bm_bubble_close() -> Unit {
  if bm_bubble_open.untracked() {
    bm_bubble_open.set(false)
    shell_mark_exclusive_closed("bookmark_bubble")
  }
}
