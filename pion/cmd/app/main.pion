fn is_chrome_field_focused() -> Bool {
  match ui::focused_field_now() {
    Some(f) => {
      let pid = f.phys_id
      let is_addr = match app_state.address_field {
        Some(a) => a.phys_id == pid && a.focused()
        None => false
      }
      let is_find = match app_state.find_field {
        Some(ff) => ff.phys_id == pid && ff.focused()
        None => false
      }
      let is_cmd = match app_state.command_bar_field {
        Some(cf) => cf.phys_id == pid && cf.focused()
        None => false
      }
      let is_hist = match app_state.history_field {
        Some(hf) => hf.phys_id == pid && hf.focused()
        None => false
      }
      let is_bm = match app_state.bookmarks_field {
        Some(bf) => bf.phys_id == pid && bf.focused()
        None => false
      }
      let is_sp = match app_state.space_name_field {
        Some(sf) => sf.phys_id == pid && sf.focused()
        None => false
      }
      let is_fl = match app_state.folder_name_field {
        Some(ff) => ff.phys_id == pid && ff.focused()
        None => false
      }
      let is_tf = match app_state.tab_filter_field {
        Some(tf) => tf.phys_id == pid && tf.focused()
        None => false
      }
      let is_dt = match app_state.devtools_repl_field {
        Some(df) => df.phys_id == pid && df.focused()
        None => false
      }
      let is_boost = match app_state.boosts_css_field {
        Some(bf2) => bf2.phys_id == pid && bf2.focused()
        None => false
      }
      let is_start = match app_state.start_page_field {
        Some(spf) => spf.phys_id == pid && spf.focused()
        None => false
      }
      let is_cookies = match app_state.cookies_field {
        Some(ckf) => ckf.phys_id == pid && ckf.focused()
        None => false
      }
      let is_dl = match app_state.downloads_field {
        Some(dlf) => dlf.phys_id == pid && dlf.focused()
        None => false
      }
      let is_sp_new = match app_state.spaces_new_field {
        Some(snf) => snf.phys_id == pid && snf.focused()
        None => false
      }
      let is_sp_ren = match app_state.spaces_rename_field {
        Some(srf) => srf.phys_id == pid && srf.focused()
        None => false
      }
      let is_ct = match app_state.closed_tabs_field {
        Some(ctf) => ctf.phys_id == pid && ctf.focused()
        None => false
      }
      let is_fc = match app_state.folder_create_field {
        Some(fcf) => fcf.phys_id == pid && fcf.focused()
        None => false
      }
      let is_sn = match app_state.sessions_name_field {
        Some(snf2) => snf2.phys_id == pid && snf2.focused()
        None => false
      }
      let is_sf = match app_state.sessions_filter_field {
        Some(sff) => sff.phys_id == pid && sff.focused()
        None => false
      }
      let is_ts = match app_state.tab_search_field {
        Some(tsf) => tsf.phys_id == pid && tsf.focused()
        None => false
      }
      is_addr || is_find || is_cmd || is_hist || is_bm || is_sp || is_fl || is_tf || is_dt || is_boost || is_start || is_cookies || is_dl || is_sp_new || is_sp_ren || is_ct || is_fc || is_sn || is_sf || is_ts
    }
    None => false
  }
}

fn primary_mod_active(mods : Int) -> Bool {
  if ui::keys_system() == 0 {
    (mods & ui::mod_cmd) != 0
  } else {
    (mods & ui::mod_ctrl) != 0
  }
}

fn dom_primary_mod() -> Int {
  if ui::keys_system() == 0 { 4 } else { 2 }
}

fn read_os_clipboard() -> String {
  match os_platform::clipboard_read_text() {
    Some(s) if s != "" => s
    _ => ui::clipboard_get()
  }
}

fn write_os_clipboard(s : String) -> Unit {
  if s != "" {
    let _ = os_platform::clipboard_write_text(s)
    ui::clipboard_set(s, label="Farview")
  }
}

fn handle_ime_text(kind : Int, s : String, _a : Int, _b : Int) -> Bool {
  // macOS Cmd+V paste arrives from NSTextInputClient / paste_now as kind == 8.
  if kind == 8 {
    if s != "" {
      write_os_clipboard(s)
      match ui::focused_field_now() {
        Some(f) if f.focused() => {
          f.paste_text(s)
          return true
        }
        _ => if !is_chrome_field_focused() {
          let dm = dom_primary_mod()
          send_proto_active(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", s, dm))
          send_proto_active(proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
          return true
        }
      }
    }
    return false
  }
  // Chrome fields (address bar / find bar) handle IME locally via ui::Field.
  if is_chrome_field_focused() {
    return false
  }
  // kind == 1: setMarkedText (CJK IME composition preedit)
  if kind == 1 {
    if s != "" {
      if !app_state.ime_composing {
        app_state.ime_composing = true
        send_proto_active(proto::ClientMsg::EditInput(0, 0, "", 0, 0, proto::EDIT_COMPOSING))
      }
      send_proto_active(proto::ClientMsg::EditInput(0, 0, s, 1, 0, proto::EDIT_COMPOSING))
    } else if app_state.ime_composing {
      app_state.ime_composing = false
      send_proto_active(proto::ClientMsg::EditInput(0, 0, "", 2, 0, proto::EDIT_COMPOSING))
    }
    // Let ui::Field::compose(s) also run so hostapi::set_ime keeps reporting caret rect for candidate window.
    return false
  }
  // kind == 2: unmarkText (IME composition cancelled/finished without insertText)
  if kind == 2 {
    if app_state.ime_composing {
      app_state.ime_composing = false
      send_proto_active(proto::ClientMsg::EditInput(0, 0, "", 2, 0, proto::EDIT_COMPOSING))
    }
    return false
  }
  // kind == 0: insertText (commit text; when closing an active IME composition, dispatch compose_end)
  if kind == 0 && app_state.ime_composing {
    app_state.ime_composing = false
    send_proto_active(proto::ClientMsg::EditInput(0, 0, s, 2, 0, proto::EDIT_COMPOSING))
    match ui::focused_field_now() {
      Some(f) if f.focused() && f.paste_limit == 1 => {
        // Hidden contenteditable catcher: avoid double-sending via catcher's edit callback.
        f.compose("")
        return true
      }
      _ => return false
    }
  }
  false
}

fn sync_shift_held_from_mods(mods : Int) -> Unit {
  let sh_now = (mods & 1) != 0
  match app_state.shift_held {
    Some(sh) => if sh.untracked() != sh_now {
      sh.set(sh_now)
      hostapi::request_frame()
    }
    None => ()
  }
}

fn handle_app_key(code : Int, mods : Int, is_up : Bool) -> Bool {
  sync_shift_held_from_mods(mods)
  if code == 0 || is_up {
    return false
  }
  // Layer 0: Active IME composition guard (never swallow Escape/Enter/Arrows while composing)
  if is_ime_composing_active() {
    return false
  }
  // Layer 1: Deepest active Exclusive control (MRU/TabSearch/CommandBar/Omnibox) & deterministic Escape chain
  if handle_layer1_exclusive_key(code, mods) {
    return true
  }
  // Layer 2: Global browser shortcuts (Column A invariants preserved 100%)
  let find_open = is_find_bar_open()
  let find_focused = is_find_field_focused()
  let field_focused = ui::field_has_focus() || is_chrome_field_focused()
  let shortcut = proto::dispatch_browser_shortcut(
    code,
    mods,
    ui::keys_system() == 0,
    find_open,
    find_focused,
    field_focused,
  )
  match shortcut {
    proto::BrowserShortcut::FindPrev => {
      dispatch_find_prev(active_stage())
      return true
    }
    proto::BrowserShortcut::Reload if proto::is_f5_key(code) => {
      active_stage().reload()
      return true
    }
    proto::BrowserShortcut::Back if (mods & ui::mod_alt) != 0 => {
      active_stage().back()
      return true
    }
    proto::BrowserShortcut::Forward if (mods & ui::mod_alt) != 0 => {
      active_stage().forward()
      return true
    }
    proto::BrowserShortcut::ZoomIn if (mods & ui::mod_shift_key) != 0 => {
      let st = active_stage()
      apply_zoom_and_sync(st, proto::zoom_step_up(st.zoom()))
      return true
    }
    proto::BrowserShortcut::ToggleSidebar => {
      toggle_sidebar()
      return true
    }
    proto::BrowserShortcut::TabNew => {
      dispatch_tab_new("", "")
      return true
    }
    proto::BrowserShortcut::TabClose => {
      dispatch_tab_close("")
      return true
    }
    proto::BrowserShortcut::TabSwitch(idx) => {
      dispatch_switch_tab_index(idx)
      return true
    }
    proto::BrowserShortcut::ToggleSiteInfo => {
      toggle_site_info()
      return true
    }
    proto::BrowserShortcut::ToggleDownloads => {
      toggle_downloads()
      return true
    }
    proto::BrowserShortcut::OpenCommandBar => {
      toggle_command_bar()
      return true
    }
    proto::BrowserShortcut::TogglePinTab => {
      dispatch_tab_pin("")
      return true
    }
    proto::BrowserShortcut::ReopenClosedTab => {
      dispatch_tab_reopen()
      return true
    }
    proto::BrowserShortcut::ToggleMuteAudio => {
      dispatch_media_mute_toggle()
      return true
    }
    proto::BrowserShortcut::ToggleHistory => {
      toggle_history()
      return true
    }
    proto::BrowserShortcut::CopyCurrentUrl => {
      let target_u = if is_peek_open() { peek_current_url() } else { active_stage().url() }
      copy_url_with_toast(target_u)
      return true
    }
    proto::BrowserShortcut::ToggleShortcuts => {
      toggle_shortcuts()
      return true
    }
    proto::BrowserShortcut::ToggleSplitView => {
      toggle_split_view()
      return true
    }
    proto::BrowserShortcut::TogglePeek => {
      toggle_peek_preview()
      return true
    }
    proto::BrowserShortcut::ExpandPeek => {
      if is_peek_open() {
        expand_peek_to_tab()
        return true
      }
    }
    proto::BrowserShortcut::TabSwitchMru(delta) => {
      open_or_step_mru_switcher(delta)
      return true
    }
    proto::BrowserShortcut::PrintPdf => {
      open_print_pdf_modal()
      return true
    }
    proto::BrowserShortcut::ToggleTabFilter => {
      toggle_tab_search()
      return true
    }
    proto::BrowserShortcut::ToggleDevTools => {
      toggle_devtools()
      return true
    }
    proto::BrowserShortcut::ToggleBookmark => {
      dispatch_bookmark_toggle()
      return true
    }
    proto::BrowserShortcut::ToggleBookmarks => {
      toggle_bookmarks_bar()
      return true
    }
    proto::BrowserShortcut::CaptureScreenshot => {
      dispatch_capture_screenshot()
      return true
    }
    proto::BrowserShortcut::ToggleReaderMode => {
      toggle_reader_mode()
      return true
    }
    proto::BrowserShortcut::ToggleBoosts => {
      toggle_boosts()
      return true
    }
    proto::BrowserShortcut::OpenSettings => {
      toggle_settings()
      return true
    }
    proto::BrowserShortcut::ToggleDarkChrome => {
      toggle_dark_chrome()
      return true
    }
    proto::BrowserShortcut::TogglePerfHud => {
      toggle_perf_hud()
      return true
    }
    _ => ()
  }
  let cmd = primary_mod_active(mods)
  let is_copy = code == ui::key_code_copy || (cmd && code == ui::key_of_char('c'))
  let is_cut = code == ui::key_code_cut || (cmd && code == ui::key_of_char('x'))
  let is_paste = cmd && code == ui::key_of_char('v')
  if is_paste {
    let clip = read_os_clipboard()
    if clip != "" {
      ui::clipboard_set(clip, label="Farview")
    }
    if !ui::field_has_focus() && !is_chrome_field_focused() {
      let dm = dom_primary_mod()
      send_proto_active(proto::ClientMsg::Key(0, 0, true, "v", "KeyV", clip, dm))
      send_proto_active(proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
      return true
    }
    return false
  }
  if is_copy {
    match ui::focused_field_now() {
      Some(f) if f.focused() && f.paste_limit == 0 => {
        let sel = f.copy_selection()
        if sel != "" {
          write_os_clipboard(sel)
        }
        return true
      }
      _ => return false
    }
  }
  if is_cut {
    match ui::focused_field_now() {
      Some(f) if f.focused() && f.paste_limit == 0 => {
        let sel = f.cut_selection()
        if sel != "" {
          write_os_clipboard(sel)
        }
        return true
      }
      _ => return false
    }
  }
  // Layer 3: Fall through to active Stage
  false
}

fn now_ms() -> Double {
  hostapi::now()
}

fn get_stage() -> stage::Stage {
  match app_state.stage {
    Some(s) => s
    None => panic("app stage not initialized")
  }
}

fn frame_body_to_stage(bodies : Array[Bytes], st : stage::Stage) -> Unit {
  if bodies.length() == 0 {
    return
  }
  let mut total = 0
  for b in bodies {
    total = total + 4 + b.length()
  }
  let out = Bytes::new(total)
  let mut off = 0
  for b in bodies {
    let n = b.length()
    out[off] = ((n >> 24) & 0xFF).to_byte()
    out[off + 1] = ((n >> 16) & 0xFF).to_byte()
    out[off + 2] = ((n >> 8) & 0xFF).to_byte()
    out[off + 3] = (n & 0xFF).to_byte()
    let mut i = 0
    while i < n {
      out[off + 4 + i] = b[i]
      i = i + 1
    }
    off = off + 4 + n
  }
  st.feed(out)
}

fn dispatch_incoming_chunks_budgeted_at(
  chunks : Array[Bytes],
  st : stage::Stage,
  deadline : Double,
  clock_fn : () -> Double,
) -> Bool {
  for c in chunks {
    app_state.framer.push(c)
  }
  let doc_bodies : Array[Bytes] = []
  let mut doc_batch_bytes = 0
  let mut processed = 0
  let mut hit_deadline = false
  while true {
    if processed > 0 && clock_fn() >= deadline {
      hit_deadline = true
      break
    }
    match app_state.framer.next() {
      Some(body) => {
        processed = processed + 1
        if proto::is_doc_wire(body) {
          doc_bodies.push(body)
          doc_batch_bytes = doc_batch_bytes + body.length()
          if doc_batch_bytes >= 262144 {
            frame_body_to_stage(doc_bodies, st)
            doc_bodies.clear()
            doc_batch_bytes = 0
            if clock_fn() >= deadline {
              hit_deadline = true
              break
            }
          }
        } else {
          match wire::decode(body) {
            Some(wire::Message::FindResult(active, total)) => set_host_find_result(true, active, total)
            Some(wire::Message::Zoom(z)) => st.set_zoom(proto::clamp_zoom(z))
            Some(wire::Message::OmniboxResults(json)) => set_host_omnibox_results(json)
            Some(wire::Message::WorkspaceState(json)) => set_host_workspace_state(json)
            Some(wire::Message::DownloadsState(json)) => set_host_downloads_state(json)
            Some(wire::Message::HistoryState(json)) => set_host_history_state(json)
            Some(wire::Message::DevToolsState(json)) => set_host_devtools_state(json)
            Some(wire::Message::BookmarksState(json)) => set_host_bookmarks_state(json)
            Some(wire::Message::ReaderState(json)) => set_host_reader_state(json)
            Some(wire::Message::BoostsState(json)) => set_host_boosts_state(json)
            Some(wire::Message::SettingsState(json)) => set_host_settings_state(json)
            Some(wire::Message::SitePermissionsState(json)) => set_host_site_perms_state(json)
            Some(wire::Message::MediaHubState(json)) => set_host_media_hub_state(json)
            Some(wire::Message::PeekState(json)) => set_host_peek_state(json)
            Some(wire::Message::SiteCookiesState(json)) => set_host_cookies_state(json)
            Some(wire::Message::ClosedTabsState(json)) => set_host_closed_tabs_state(json)
            Some(wire::Message::PerfHudState(json)) => set_host_perf_hud_state(json)
            Some(wire::Message::SessionsState(json)) => set_host_sessions_state(json)
            _ => ()
          }
        }
      }
      None => break
    }
  }
  frame_body_to_stage(doc_bodies, st)
  hit_deadline
}

fn dispatch_split_incoming_chunks_budgeted_at(
  chunks : Array[Bytes],
  st : stage::Stage,
  deadline : Double,
  clock_fn : () -> Double,
) -> Bool {
  for c in chunks {
    app_state.split_framer.push(c)
  }
  let doc_bodies : Array[Bytes] = []
  let mut doc_batch_bytes = 0
  let mut processed = 0
  let mut hit_deadline = false
  while true {
    if processed > 0 && clock_fn() >= deadline {
      hit_deadline = true
      break
    }
    match app_state.split_framer.next() {
      Some(body) => {
        processed = processed + 1
        if proto::is_doc_wire(body) {
          doc_bodies.push(body)
          doc_batch_bytes = doc_batch_bytes + body.length()
          if doc_batch_bytes >= 262144 {
            frame_body_to_stage(doc_bodies, st)
            doc_bodies.clear()
            doc_batch_bytes = 0
            if clock_fn() >= deadline {
              hit_deadline = true
              break
            }
          }
        } else {
          match wire::decode(body) {
            Some(wire::Message::FindResult(active, total)) => if active_split_pane() == 1 {
              set_host_find_result(true, active, total)
            }
            Some(wire::Message::Zoom(z)) => st.set_zoom(proto::clamp_zoom(z))
            _ => ()
          }
        }
      }
      None => break
    }
  }
  frame_body_to_stage(doc_bodies, st)
  hit_deadline
}

fn bar_button_live(row : view::View, words : () -> String, press : () -> Unit) -> Unit {
  let _ = headless::button(
    row,
    words,
    fn(_v : view::View) -> Unit { press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let _ = b
      .pad(view::Live::Is(8.0))
      .radius(view::Live::Is(6.0))
      .ground(view::Live::By(fn() -> Int64 {
        let p = chrome_palette()
        if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.btn_bg }
      }))
      let _ = b.box(fn(w : view::View) -> Unit {
        let _ = w
        .words(view::Live::By(words), ink=0x1D1D1FFFL)
        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
      })
    },
  )
}

fn bar_button(row : view::View, words : String, press : () -> Unit) -> Unit {
  bar_button_live(row, fn() -> String { words }, press)
}

fn favorite_badge_colors(url : String) -> (Int64, Int64) {
  let host = proto::omnibox_display_host(url)
  if host.contains("youtube.com") || host.contains("youtu.be") {
    (0xFEE2E2FFL, 0xDC2626FFL)
  } else if host.contains("meet.google.com") {
    (0xDCFCE7FFL, 0x15803DFFL)
  } else if host.starts_with("x.com") || host.contains("twitter.com") {
    (0xE5E7EBFFL, 0x111827FFL)
  } else if host.contains("linear.app") {
    (0xE0E7FFFFL, 0x4F46E5FFL)
  } else if host.contains("github.com") {
    (0xE5E7EBFFL, 0x1F2937FFL)
  } else if host.contains("figma.com") || host.contains("dribbble.com") {
    (0xF3E8FFFFL, 0x7C3AEDFFL)
  } else {
    (0xE8F0FEFFL, 0x2563EBFFL)
  }
}

