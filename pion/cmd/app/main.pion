  app_state.reader_font_size = Some(reader_font_size)
  app_state.reader_width_mode = Some(reader_width_mode)
  app_state.reader_progress = Some(reader_progress)
  app_state.folder_create_open = Some(folder_create_open)
  app_state.folder_create_color = Some(folder_create_color)
  app_state.folder_create_move_active = Some(folder_create_move_active)
  app_state.folder_create_field = Some(folder_create_field)
  app_state.sessions_open = Some(sessions_open)
  app_state.sessions_rev = Some(sessions_rev)
  app_state.host_sessions_synced = Some(host_sessions_synced)
  app_state.sessions_name_field = Some(sessions_name_field)
  app_state.sessions_filter_field = Some(sessions_filter_field)
  app_state.sessions_filter_query = Some(sessions_filter_query)
  app_state.boosts_open = Some(boosts_open)
  app_state.boosts_rev = Some(boosts_rev)
  app_state.host_boosts_synced = Some(host_boosts_synced)
  app_state.boosts_css_field = Some(boosts_css_field)
  app_state.settings_open = Some(settings_open)
  app_state.settings_tab = Some(settings_tab)
  app_state.settings_rev = Some(settings_rev)
  app_state.chrome_theme = Some(chrome_theme)
  app_state.host_settings_synced = Some(host_settings_synced)
  app_state.site_perms_rev = Some(site_perms_rev)
  app_state.host_site_perms_synced = Some(host_site_perms_synced)
  app_state.media_hub_open = Some(media_hub_open)
  app_state.media_hub_rev = Some(media_hub_rev)
  app_state.mini_player_rev = Some(mini_player_rev)
  app_state.host_media_hub_synced = Some(host_media_hub_synced)
  app_state.start_page_field = Some(start_page_field)
  app_state.devtools_selected_path = Some(devtools_selected_path)
  app_state.devtools_console_filter = Some(devtools_console_filter)
  app_state.devtools_repl_field = Some(devtools_repl_field)
  app_state.host_devtools_synced = Some(host_devtools_synced)
  app_state.perf_hud_open = Some(perf_hud_open)
  app_state.perf_hud_rev = Some(perf_hud_rev)
  app_state.host_perf_hud_synced = Some(host_perf_hud_synced)
  app_state.ime_composing = false
  shell_dock_init_from_app()
  shell_page_init_from_app()
  shell_sync_passive_from_app()
  // Sync exact Exclusive tag when any Phase 2B demo/initial flag opens an overlay at startup
  if app_state.initial_site_info_open {
    shell_lock_site_info_target()
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "site_info")
  } else if app_state.initial_idn_popover_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "idn_popover")
  } else if app_state.initial_downloads_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Drawer, "downloads")
  } else if app_state.initial_shortcuts_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "shortcuts")
  } else if app_state.initial_media_hub_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "media_hub")
  } else if app_state.initial_zoom_popover_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "zoom_popover")
  } else if app_state.initial_space_theme_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "space_theme")
  } else if app_state.initial_mru_open {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::MruSwitcher, "mru")
  } else if app_state.initial_nav_hist_dir >= 0 {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Menu, "nav_hist")
  } else if app_state.demo_tab_ctx != "" {
    shell_mark_exclusive_open(shell_ui::ExclusiveKind::Menu, "tab_ctx")
  }
  ui::set_text_interceptor(Some(handle_ime_text))
  ui::set_key_interceptor(Some(handle_app_key))
  if app_state.demo_find != "" {
    find_field.set(app_state.demo_find)
  }
  let all_keys : Array[view::Binding] = []
  // Single-line Omnibox & Command Bar Field keyboard navigation (Invar focus-chain routing)
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_down, mods: 0 }],
      action: "omnibox.down",
      when: view::KeyWhen::In("OmniboxField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_up, mods: 0 }],
      action: "omnibox.up",
      when: view::KeyWhen::In("OmniboxField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_down, mods: 0 }],
      action: "commandbar.down",
      when: view::KeyWhen::In("CommandBarField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_up, mods: 0 }],
      action: "commandbar.up",
      when: view::KeyWhen::In("CommandBarField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: proto::KEY_ESCAPE, mods: 0 }],
      action: "commandbar.escape",
      when: view::KeyWhen::In("CommandBarField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: proto::KEY_ESCAPE, mods: 0 }],
      action: "tabfilter.escape",
      when: view::KeyWhen::In("TabFilterField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: proto::KEY_ESCAPE, mods: 0 }],
      action: "downloads.escape",
      when: view::KeyWhen::In("DownloadsField"),
    },
  )
  for b in stage::browser_keys() {
    all_keys.push(b)
  }
  // Additional Chromium/Arc desktop shortcuts: F5, Alt+Left/Right, Cmd/Ctrl+Shift+= / +
  for f5 in [proto::KEY_F5_MAC, proto::KEY_F5_WIN, proto::KEY_F5_X11] {
    all_keys.push(
      view::Binding::{
        keys: [view::Stroke::{ code: f5, mods: 0 }],
        action: stage::act_reload,
        when: view::KeyWhen::Always,
      },
    )
  }
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_left, mods: ui::mod_alt }],
      action: stage::act_back,
      when: view::KeyWhen::Not(view::KeyWhen::In("Field")),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_right, mods: ui::mod_alt }],
      action: stage::act_forward,
      when: view::KeyWhen::Not(view::KeyWhen::In("Field")),
    },
  )
  for m in [ui::mod_cmd | ui::mod_shift_key, ui::mod_ctrl | ui::mod_shift_key] {
    for code in [1061, 1043] {
      all_keys.push(
        view::Binding::{
          keys: [view::Stroke::{ code, mods: m }],
          action: stage::act_zoom_in,
          when: view::KeyWhen::Always,
        },
      )
    }
  }
  for b in stage::page_keys() {
    all_keys.push(b)
  }
  let _ = root
  .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))
  .keymap(view::Live::Is(view::Keymap::new(all_keys)))
  .on_action(stage::act_focus_url, fn(_a : view::ActionAt) -> Bool {
    app_state.syncing_address_url = true
    address.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
    app_state.syncing_address_url = false
    omnibox_editing.set(true)
    address.focus()
    address.pick(0, address.text().length())
    omnibox_selected.set(-1)
    dispatch_omnibox_query("")
    true
  })
  .on_action(stage::act_reload, fn(_a : view::ActionAt) -> Bool {
    active_stage().reload()
    true
  })
  .on_action(stage::act_back, fn(_a : view::ActionAt) -> Bool {
    active_stage().back()
    true
  })
  .on_action(stage::act_forward, fn(_a : view::ActionAt) -> Bool {
    active_stage().forward()
    true
  })
  .on_action(stage::act_zoom_in, fn(_a : view::ActionAt) -> Bool {
    let cur = active_stage()
    apply_zoom_and_sync(cur, proto::zoom_step_up(cur.zoom()))
    true
  })
  .on_action(stage::act_zoom_out, fn(_a : view::ActionAt) -> Bool {
    let cur = active_stage()
    apply_zoom_and_sync(cur, proto::zoom_step_down(cur.zoom()))
    true
  })
  .on_action(stage::act_zoom_reset, fn(_a : view::ActionAt) -> Bool {
    apply_zoom_and_sync(active_stage(), proto::zoom_reset())
    true
  })
  .on_action(stage::act_find, fn(_a : view::ActionAt) -> Bool {
    open_find_bar()
    true
  })
  .on_action(stage::act_escape, fn(_a : view::ActionAt) -> Bool {
    dismiss_topmost_layer()
  })
  // Live Omnibox reactive subscriptions (Contract 4: zero dual Field, preserves Phase 1a gate & IME guard)
  root.reacts(fn() -> String { active_address_raw_url() }, fn(u : String) -> Unit {
    if !address.focused() && !omnibox_editing.untracked() {
      app_state.syncing_address_url = true
      address.set(proto::omnibox_safe_display_url(u))
      app_state.syncing_address_url = false
    }
  })
  root.reacts(fn() -> String { address.text() }, fn(q : String) -> Unit {
    if address.focused() && !app_state.syncing_address_url {
      omnibox_selected.set(-1)
      dispatch_omnibox_query(q)
    }
  })

  build_live_shell_frame(
    root,
    st,
    address,
    omnibox_open,
    omnibox_rev,
    omnibox_selected,
    omnibox_editing,
    chrome_theme,
    workspace_rev,
    media_hub_rev,
    mini_player_rev,
    bookmarks_bar_open,
    bookmarks_rev,
    boosts_rev,
    history_rev,
    settings_rev,
    peek_url,
    shift_held,
    tab_filter_open,
    tab_filter_query,
    tab_filter_field,
    folder_create_open,
    folder_create_color,
    folder_create_move_active,
    folder_create_field,
    idn_popover_open,
    start_page_field,
    reader_open,
    reader_rev,
    reader_theme,
    reader_font,
    reader_font_size,
    reader_width_mode,
    reader_progress,
    find_open,
    find_field,
    find_case_sensitive,
    host_find_synced,
    host_find_active,
    host_find_total,
    devtools_open,
    devtools_height,
    devtools_dragging,
    devtools_tab,
    devtools_rev,
    devtools_selected_path,
    devtools_console_filter,
    devtools_repl_field,
    devtools_net_filter,
    devtools_net_query,
    devtools_net_search_field,
    devtools_net_selected_idx,
    command_bar_rev,
    command_bar_selected,
    command_bar_field,
    tab_search_query,
    tab_search_selected,
    tab_search_field,
    closed_tabs_rev,
  )
  // Phase 3B Liquid Glass Deep Drawers & Modals (`shell_ui`)
  build_phase3b_overlays(
    root,
    cookies_open,
    cookies_rev,
    cookies_field,
    history_open,
    history_rev,
    history_field,
    bookmarks_open,
    bookmarks_rev,
    bookmarks_field,
    bookmarks_query,
    sessions_open,
    sessions_rev,
    sessions_name_field,
    sessions_filter_field,
    spaces_manager_open,
    workspace_rev,
    spaces_new_field,
    spaces_new_accent,
    spaces_edit_id,
    spaces_rename_field,
    spaces_color_edit_id,
    closed_tabs_open,
    closed_tabs_rev,
    closed_tabs_field,
    print_pdf_open,
    print_paper,
    print_orientation,
    print_margins,
    print_bg_graphics,
  )
  build_phase3a_overlays(root, reader_open, boosts_open, boosts_rev, boosts_css_field, settings_open, settings_tab, settings_rev, clear_hist, clear_dl, clear_boosts, devtools_open, devtools_rev, workspace_rev)
  // Phase 2B Liquid Glass Popovers, Overlays, HUD, and Context Menus (`shell_ui`)
  build_phase2b_overlays(
    root,
    st,
    workspace_rev,
    site_info_open,
    site_perms_rev,
    boosts_rev,
    cookies_rev,
    idn_popover_open,
    media_hub_open,
    media_hub_rev,
    zoom_popover_open,
    downloads_open,
    downloads_rev,
    downloads_field,
    downloads_cat,
    shortcuts_open,
    perf_hud_open,
    perf_hud_rev,
    tab_preview_open,
    tab_preview_tab_id,
    tab_preview_y,
    reader_open,
    page_ctx_open,
    page_ctx_link,
    page_ctx_image,
    page_ctx_selection,
    page_ctx_x,
    page_ctx_y,
    page_ctx_can_back,
    page_ctx_can_forward,
    nav_hist_open,
    nav_hist_dir,
    nav_hist_x,
    tab_ctx_open,
    tab_ctx_tab_id,
    tab_ctx_y,
    folder_ctx_open,
    folder_ctx_id,
    folder_ctx_y,
    folder_name_field,
    bm_bar_ctx_open,
    bm_bar_ctx_id,
    bm_bar_ctx_url,
    bm_bar_ctx_x,
    space_theme_open,
    space_name_field,
    mru_open,
    mru_rev,
    mru_selected,
  )
  pump_io_frame()
}

fn load_default_fonts(w : World) -> Array[Bytes] {
  // Keep system default fonts to 4 slots (4..7) so MB_FACES=16 leaves 8 slots (8..15) for page web fonts.
  let paths : Array[String] = [
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/System/Library/Fonts/Supplemental/Georgia.ttf",
    "/System/Library/Fonts/Supplemental/Courier New.ttf",
  ]
  let out : Array[Bytes] = []
  let mut i = 0
  while i < paths.length() {
    match fs_read_bytes(w, paths[i]) {
      Result::Ok(b) => out.push(b)
      Result::Err(_) => ()
    }
    i = i + 1
  }
  out
}

fn main(w : World) -> Unit {
  let cli_args = world_args(w)
  // Panels are solid until settings say otherwise (glass is opt-in: Settings > Appearance > Translucent panels).
  ui::set_glass_solid(Some(!app_state.settings.glass))
  let mut arg_i = 1
  while arg_i < cli_args.length() {
    let arg = cli_args[arg_i]
    if arg == "--demo-peek" && arg_i + 1 < cli_args.length() {
      let u = cli_args[arg_i + 1].trim()
      if u != "" {
        app_state.initial_peek_url = u
        app_state.initial_peek_open = true
      }
      arg_i = arg_i + 2
      continue
    } else if arg.starts_with("--demo-peek=") {
      let u = arg.slice(12, arg.length()).trim()
      if u != "" {
        app_state.initial_peek_url = u
        app_state.initial_peek_open = true
      }
    } else if arg == "--demo-tab-preview" {
      app_state.initial_sidebar_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_tab_preview = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      } else {
        app_state.demo_tab_preview = "first"
      }
    } else if arg.starts_with("--demo-tab-preview=") {
      let tid = arg.slice(19, arg.length()).trim()
      app_state.initial_sidebar_open = true
      app_state.demo_tab_preview = if tid != "" { tid } else { "first" }
    } else if arg == "--demo-split-ui" {
      app_state.initial_split_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        let u = cli_args[arg_i + 1].trim()
        if u != "" {
          app_state.initial_split_url = u
        }
        arg_i = arg_i + 2
        continue
      }
    } else if arg.starts_with("--demo-split-ui=") {
      app_state.initial_split_open = true
      let u = arg.slice(16, arg.length()).trim()
      if u != "" {
        app_state.initial_split_url = u
      }
    } else if arg == "--demo-find" && arg_i + 1 < cli_args.length() {
      let q = cli_args[arg_i + 1].trim()
      if q != "" {
        app_state.demo_find = q
      }
      arg_i = arg_i + 2
      continue
    } else if arg.starts_with("--demo-find=") {
      let q = arg.slice(12, arg.length()).trim()
      if q != "" {
        app_state.demo_find = q
      }
    } else if arg == "--demo-find-case" {
      app_state.demo_find_case = true
    } else if arg == "--demo-history" {
      app_state.initial_history_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_history_query = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      }
    } else if arg.starts_with("--demo-history=") {
      app_state.initial_history_open = true
      app_state.demo_history_query = arg.slice(15, arg.length()).trim()
    } else if arg == "--demo-cookies" {
      app_state.initial_cookies_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_cookies_host = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      }
