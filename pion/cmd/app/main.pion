fn open_or_step_mru_switcher(delta : Int) -> Unit {
  let is_open = match app_state.mru_open {
    Some(s) => s.untracked()
    None => false
  }
  if !is_open {
    close_exclusive_overlays()
    match app_state.address_field {
      Some(addr) => if addr.focused() { addr.let_go() }
      None => ()
    }
    match app_state.tab_filter_field {
      Some(tf) => if tf.focused() { tf.let_go() }
      None => ()
    }
    let items = proto::workspace_mru_tabs(app_state.workspace, app_state.workspace.active_space_id)
    app_state.mru_items = items
    match app_state.mru_rev {
      Some(s) => s.set(s.untracked() + 1)
      None => ()
    }
    let n = items.length()
    let init_idx = if n <= 1 {
      0
    } else if delta < 0 {
      n - 1
    } else {
      1
    }
    match app_state.mru_selected {
      Some(s) => s.set(init_idx)
      None => ()
    }
    match app_state.mru_open {
      Some(s) => s.set(true)
      None => ()
    }
  } else {
    let n = app_state.mru_items.length()
    if n > 0 {
      match app_state.mru_selected {
        Some(s) => {
          let cur = s.untracked()
          let next = ((cur + delta) % n + n) % n
          s.set(next)
        }
        None => ()
      }
    }
  }
}

fn commit_mru_switcher() -> Unit {
  let sel = match app_state.mru_selected {
    Some(s) => s.untracked()
    None => 0
  }
  let items = app_state.mru_items
  close_mru_switcher()
  if sel >= 0 && sel < items.length() {
    dispatch_tab_switch(items[sel].id)
  }
}

