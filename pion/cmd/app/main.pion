    }
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_SHORTCUTS") {
    Some(v) if v == "1" || v == "true" => app_state.initial_shortcuts_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_TAB_CTX") {
    Some(v) if v.trim() != "" => {
      app_state.initial_sidebar_open = true
      app_state.demo_tab_ctx = v.trim()
    }
    _ => ()
  }
  match env_get(w, "FV_APP_DEMO_TAB_PREVIEW") {
    Some(v) if v.trim() != "" => {
      app_state.initial_sidebar_open = true
      app_state.demo_tab_preview = v.trim()
    }
    _ => ()
  }
  match env_get(w, "FV_APP_DEMO_TOAST") {
    Some(v) if v.trim() != "" => app_state.demo_toast = v.trim()
    _ => ()
  }
  match env_get(w, "FV_APP_COMMAND_QUERY") {
    Some(v) if v != "" => app_state.demo_command_query = v
    _ => ()
  }
  match env_get(w, "FV_APP_SPLIT_PORT") {
    Some(p) => {
      let n = css::parse_double(p).to_int()
      if n > 0 {
        app_state.initial_split_port = n
        app_state.split_port = n
        app_state.initial_split_open = true
      }
    }
    None => ()
  }
  match env_get(w, "FV_APP_SPLIT_URL") {
    Some(v) if v.trim() != "" => {
      app_state.initial_split_url = v.trim()
      app_state.initial_split_open = true
    }
    _ => ()
  }
  match env_get(w, "FV_APP_SPLIT_RATIO") {
    Some(v) => {
      let r = css::parse_double(v)
      if r > 0.0 {
        app_state.initial_split_ratio = proto::clamp_split_ratio(r)
      }
    }
    None => ()
  }
  match env_get(w, "FV_APP_SPLIT_ACTIVE") {
    Some(v) if v == "1" || v == "right" => app_state.initial_split_active_pane = 1
    _ => ()
  }
  match env_get(w, "FV_APP_SPLIT_SWAPPED") {
    Some(v) if v == "1" || v == "true" => app_state.initial_split_swapped = true
    _ => ()
  }
  match env_get(w, "FV_APP_PEEK_PORT") {
    Some(p) => {
      let n = css::parse_double(p).to_int()
      if n > 0 {
        app_state.initial_peek_port = n
        app_state.split_port = n
        app_state.initial_peek_open = true
      }
    }
    None => ()
  }
  match env_get(w, "FV_APP_PEEK_URL") {
    Some(v) if v.trim() != "" => {
      app_state.initial_peek_url = v.trim()
      app_state.initial_peek_open = true
    }
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_NAV_HIST") {
    Some(v) if v.trim() == "back" || v.trim() == "0" => app_state.initial_nav_hist_dir = 0
    Some(v) if v.trim() == "forward" || v.trim() == "1" => app_state.initial_nav_hist_dir = 1
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_MRU") {
    Some(v) if v == "1" || v == "true" => app_state.initial_mru_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_EXPORT_PDF") {
    Some(v) if v == "1" || v == "true" => app_state.initial_export_pdf = true
    _ => ()
  }
  match env_get(w, "FV_APP_CAPTURE_SCREENSHOT") {
    Some(v) if v == "1" || v == "true" => app_state.initial_capture_screenshot = true
    _ => ()
  }
  match env_get(w, "FV_APP_TAB_FILTER") {
    Some(v) if v.trim() != "" => {
      app_state.initial_sidebar_open = true
      app_state.initial_tab_filter_query = v.trim()
    }
    _ => ()
  }
  match env_get(w, "FV_APP_DEVTOOLS") {
    Some(v) if v == "1" || v == "true" => app_state.initial_devtools_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_DEVTOOLS_TAB") {
    Some(v) => {
      let lv = v.trim()
      if lv == "console" || lv == "1" {
        app_state.initial_devtools_tab = 1
      } else if lv == "network" || lv == "2" {
        app_state.initial_devtools_tab = 2
      } else {
        app_state.initial_devtools_tab = 0
      }
      app_state.initial_devtools_open = true
    }
    None => ()
  }
  match env_get(w, "FV_APP_DEVTOOLS_HEIGHT") {
    Some(v) => {
      let h = css::parse_double(v)
      if h > 0.0 {
        app_state.initial_devtools_height = proto::clamp_devtools_height(h)
      }
    }
    None => ()
  }
  match env_get(w, "FV_APP_DEVTOOLS_SELECT") {
    Some(v) if v.trim() != "" => app_state.initial_devtools_select = v.trim()
    _ => ()
  }
  match env_get(w, "FV_APP_DEVTOOLS_EVAL") {
    Some(v) if v.trim() != "" => {
      for part in v.split(";;") {
        let ep = part.trim()
        if ep != "" {
          app_state.initial_devtools_eval.push(ep)
        }
      }
      app_state.initial_devtools_open = true
    }
    _ => ()
  }
  host::install()
  let fonts = load_default_fonts(w)
  app_state.default_fonts = fonts
  let stage0 = stage::Stage::new(
    fn(bytes : Bytes) -> Unit {
      enqueue_main_bytes(bytes, coalescable=proto::is_pointer_move_frame(bytes))
    },
    fonts=fonts,
  )
  if (app_state.initial_zoom - 1.0).abs() > 1.0e-6 {
    stage0.set_zoom(app_state.initial_zoom)
  }
  app_state.stage = Some(stage0)
  let init_sec_url = if app_state.initial_peek_open && app_state.initial_peek_url != "" {
    app_state.initial_peek_url
  } else {
    app_state.initial_split_url
  }
  let need_init_split_spawn = (app_state.initial_split_open || app_state.initial_peek_open) && app_state.split_port <= 0 && init_sec_url != ""
  if app_state.initial_split_open || app_state.initial_peek_open {
    let _ = ensure_split_stage()
  }
  let boot_theme = if app_state.initial_chrome_theme != "" {
    app_state.initial_chrome_theme
  } else {
    app_state.settings.chrome_theme
  }
  sync_lg_theme_from_chrome(boot_theme)
  let shot_env = match env_get(w, "FV_APP_SHOT") {
    Some(v) if v != "" => Some(v)
    _ => env_get(w, "FV_APP_SHOT_PATH")
  }
  let (proc_w, proc_ctx) : (ui::Worker[ProcCmd, ProcEv], ui::WorkerCtx[ProcCmd, ProcEv]) = ui::Worker::pair()
  let (kill_w, kill_ctx) : (ui::Worker[KillCmd, KillEv], ui::WorkerCtx[KillCmd, KillEv]) = ui::Worker::pair()
  io_rt.proc_worker = Some(proc_w)
  io_rt.kill_worker = Some(kill_w)
  let watcher_pair = net::IoWatcher::pair()
  match env_get(w, "FV_APP_SELFTEST_MT") {
    Some(v) if v != "" && v != "0" => {
      match watcher_pair {
        Some((wh, _)) => wh.shutdown()
        None => ()
      }
      let rc = run_mt_io_selftest(w)
      net::exit(rc)
    }
    _ => ()
  }
  match watcher_pair {
    Some((wh, _)) => io_rt.watcher = Some(wh)
    None => {
      io_println(w, "app io: IoWatcher::pair() failed, falling back to degraded non-blocking timer")
      io_rt.degraded_poll = true
    }
  }
  io_rt.before_frame_hook = ui::on_before_frame(fn() -> Unit { pump_io_frame() })
  if need_init_split_spawn {
    request_spawn_split(init_sec_url, true, is_peek=app_state.initial_peek_open)
  }
  let shot_exit_code : Array[Int] = [-1]
  scope(w, fn(s : Scope) -> Unit {
    match watcher_pair {
      Some((wh, wctx)) => {
        wh.mark_started()
        spawn(s, fn() -> Unit {
          wctx.run_loop(fn() -> Unit { ui::wake_now() })
        })
      }
      None => ()
    }
    spawn(s, fn() -> Unit {
      proc_ctx.run_loop(fn(cmd : ProcCmd, emit : (ProcEv) -> Unit) -> Unit {
        handle_proc_cmd(cmd, emit)
      })
    })
    spawn(s, fn() -> Unit {
      run_kill_worker_loop(kill_ctx)
    })
    match shot_env {
      Some(out_path) => if out_path != "" {
        app_state.is_shot_mode = true
        let mut width = 1000.0
        let mut height = 700.0
        let mut max_ms = 14000.0
        match env_get(w, "FV_APP_W") {
          Some(v) => {
            let n = css::parse_double(v)
            if n > 0.0 { width = n }
          }
          None => ()
        }
        match env_get(w, "FV_APP_H") {
          Some(v) => {
            let n = css::parse_double(v)
            if n > 0.0 { height = n }
          }
          None => ()
        }
        let mut quiet_ms = 600.0
        match env_get(w, "FV_APP_MAX_MS") {
          Some(v) => {
            let n = css::parse_double(v)
            if n > 0.0 { max_ms = n }
          }
          None => ()
        }
        match env_get(w, "FV_APP_QUIET_MS") {
          Some(v) => {
            let n = css::parse_double(v)
            if n > 0.0 { quiet_ms = n }
          }
          None => ()
        }
        let prof = match env_get(w, "FV_APP_PROF") {
          Some(v) => v != "" && v != "0"
          None => false
        }
        match env_get(w, "FV_APP_DEMO_ZOOM") {
          Some(v) if v != "" && v != "0" => app_state.demo_zoom = true
          _ => ()
        }
        match env_get(w, "FV_APP_DEMO_FIND") {
          Some(v) if v != "" => app_state.demo_find = v
          _ => ()
        }
        match env_get(w, "FV_APP_OMNIBOX") {
          Some(v) if v != "" => app_state.demo_omnibox = v
          _ => ()
        }
        let scale = 2.0
        if !host::init_offscreen(width, height, scale) {
          io_println(w, "app offscreen: renderer init failed (" + width.to_string() + "x" + height.to_string() + ")")
          close_peek_preview(quiet=true)
          close_split_view(quiet=true)
          shutdown_io_runtime()
          shot_exit_code[0] = 1
        } else {
          ui::set_view_app(build_view)
          let st = get_stage()
          let t0 = now_ms()
          if prof {
            let last_t : Array[Double] = [t0]
            stage::phase_mark[0] = fn(p : String) -> Unit {
              let cur = now_ms()
              let dt = cur - last_t[0]
              last_t[0] = cur
              io_println(w, "PROF phase=" + p + " dt=" + dt.to_int().to_string() + "ms t=" + (cur - t0).to_int().to_string() + "ms")
            }
          }
          app_state.last_activity = t0
          app_state.total_bytes = 0
          let mut frame_i = 0
          while frame_i < 1000 {
            let now = now_ms()
            let elapsed = now - t0
            if prof {
              io_println(w, "FRAME_BEGIN i=" + frame_i.to_string() + " t=" + elapsed.to_int().to_string() + "ms")
            }
            let _ = ui::view_frame(width, height, scale, now)
            if prof {
              io_println(w, "FRAME_END i=" + frame_i.to_string() + " dt=" + (now_ms() - now).to_int().to_string() + "ms bytes=" + app_state.total_bytes.to_string() + " loading=" + st.loading().to_string())
            }
            let split_ready = (!app_state.initial_split_open && !app_state.initial_peek_open) || match app_state.split_stage {
              Some(sp_st) => app_state.split_total_bytes > 200 && !sp_st.loading() && sp_st.url() != "" && now_ms() - app_state.split_last_activity >= quiet_ms
              None => true
            }
            if app_state.total_bytes > 200 && !st.loading() && st.url() != "" && now_ms() - app_state.last_activity >= quiet_ms && split_ready && frame_i >= 20 && (!st.has_finite_animations(now) || now_ms() - app_state.last_activity >= 3500.0) {
              break
            }
            if elapsed >= max_ms {
              break
            }
            host::pump_main_loop(16.0)
            frame_i = frame_i + 1
          }
          if (app_state.initial_zoom - 1.0).abs() > 1.0e-6 {
            apply_zoom_and_sync(st, app_state.initial_zoom)
          } else if app_state.demo_zoom {
            apply_zoom_and_sync(st, proto::zoom_step_up(st.zoom()))
          }
          if app_state.demo_find != "" {
            dispatch_find_query(active_stage(), app_state.demo_find)
          }
          if app_state.initial_sidebar_open || app_state.initial_site_info_open || app_state.initial_command_bar_open {
            let already_ws = match app_state.host_workspace_synced {
              Some(s) => s.untracked()
              None => false
            }
            if !already_ws {
              dispatch_workspace_sync()
            }
          }
          if app_state.initial_site_info_open {
            close_command_bar()
            close_omnibox()
            close_downloads()
            dispatch_site_perms_sync()
            dispatch_boost_sync()
            dispatch_cookies_sync(host_override=proto::omnibox_display_host(active_address_raw_url_untracked()))
            match app_state.site_info_open {
              Some(s) => s.set(true)
              None => ()
            }
          }
          if app_state.initial_downloads_open {
            close_command_bar()
            close_omnibox()
            close_site_info()
            dispatch_downloads_sync()
            match app_state.downloads_open {
              Some(s) => s.set(true)
              None => ()
            }
          }
          if app_state.demo_omnibox != "" {
            let q = if app_state.demo_omnibox == "*" { "" } else { app_state.demo_omnibox }
            match app_state.address_field {
              Some(addr) => {
                app_state.syncing_address_url = true
                addr.set(q)
                app_state.syncing_address_url = false
                addr.focus()
                addr.pick(q.length(), q.length())
              }
              None => ()
            }
            dispatch_omnibox_query(q)
          }
          if app_state.initial_command_bar_open {
            open_command_bar(app_state.demo_command_query)
          }
          if app_state.initial_history_open {
            open_history()
            if app_state.demo_history_query != "" {
              match app_state.history_field {
                Some(hf) => hf.set(app_state.demo_history_query)
                None => ()
              }
              dispatch_history_query(app_state.demo_history_query)
            }
          }
          if app_state.initial_bookmarks_open {
            open_bookmarks()
          }
          if app_state.initial_reader_open {
            open_reader_mode()
          }
          if app_state.initial_boosts_open {
            open_boosts()
          }
          if app_state.initial_settings_open {
            open_settings(tab_idx=app_state.initial_settings_tab)
          }
          if app_state.initial_space_theme_open {
            open_space_theme()
          }
          if app_state.initial_spaces_open {
            open_spaces_manager()
          }
          if app_state.initial_closed_tabs_open {
            open_closed_tabs_modal()
          }
          if app_state.initial_print_open {
            open_print_pdf_modal()
          }
          if app_state.initial_shortcuts_open {
            open_shortcuts()
          }
          if app_state.initial_cookies_open {
            open_cookies_modal(host_override=app_state.demo_cookies_host)
          }
          if app_state.initial_media_hub_open {
            open_media_hub()
          }
          if app_state.initial_tab_filter_query != "" {
            open_tab_filter(app_state.initial_tab_filter_query)
          }
          if app_state.initial_export_pdf {
            dispatch_export_pdf()
          }
          if app_state.initial_capture_screenshot {
            dispatch_capture_screenshot()
          }
          if app_state.initial_devtools_open {
            open_devtools(tab_idx=app_state.initial_devtools_tab)
            for expr in app_state.initial_devtools_eval {
              dispatch_devtools_eval(expr)
            }
          }
          if app_state.demo_toast != "" {
            show_persistent_demo_toast(app_state.demo_toast, "copy")
          }
          if app_state.initial_perf_hud_open {
            open_perf_hud()
          }
          if app_state.demo_favorites {
            ensure_demo_favorites_seeded()
          }
          if app_state.demo_bookmarks_bar {
            ensure_demo_bookmarks_bar_seeded()
          }
          if app_state.demo_devtools_network {
            ensure_demo_devtools_network_seeded()
          }
          if app_state.demo_folders {
            ensure_demo_folders_seeded()
          }
          if app_state.demo_reader_sepia {
            ensure_demo_reader_sepia_seeded()
          }
          if app_state.initial_sessions_open {
            open_sessions_modal()
          }
          if app_state.demo_sessions {
            ensure_demo_sessions_seeded()
          }
          if app_state.initial_tab_search_open {
            open_tab_search()
          }
          if app_state.demo_tab_search {
            ensure_demo_tab_search_seeded()
          }
          if app_state.demo_site_info {
            ensure_demo_site_info_seeded()
          }
          if app_state.demo_capture_sheet {
            ensure_demo_capture_sheet_seeded()
          }
          if app_state.demo_shell_dock_light {
            ensure_demo_shell_dock_light_seeded()
          }
          if app_state.demo_shell_dock_dark {
            ensure_demo_shell_dock_dark_seeded()
          }
          // Render settled frames before snapshot, pumping socket + main loop so Host FindResult, OmniboxResults, WorkspaceState, DownloadsState, HistoryState & ImageIO finish
          let mut settle_i = 0
          while settle_i < 48 {
            if app_state.demo_favorites {
              ensure_demo_favorites_seeded()
            }
            let now1 = now_ms()
            let _ = ui::view_frame(width, height, scale, now1)
            let find_done = app_state.demo_find == "" || match app_state.host_find_synced {
              Some(s) => s.untracked()
              None => true
            }
            let omni_done = app_state.demo_omnibox == "" || match app_state.host_omnibox_synced {
              Some(s) => s.untracked()
              None => true
            }
            let ws_done = (!app_state.initial_sidebar_open && !app_state.initial_site_info_open && !app_state.initial_command_bar_open && !app_state.initial_space_theme_open && !app_state.initial_spaces_open && !app_state.initial_mru_open && app_state.demo_tab_ctx == "" && app_state.demo_tab_preview == "" && app_state.initial_nav_hist_dir < 0) || match app_state.host_workspace_synced {
              Some(s) => s.untracked()
              None => true
            }
            let closed_done = !app_state.initial_closed_tabs_open || match app_state.host_closed_tabs_synced {
              Some(s) => s.untracked()
              None => true
            }
            let dl_done = (!app_state.initial_downloads_open && !app_state.initial_export_pdf && !app_state.initial_capture_screenshot) || (match app_state.host_downloads_synced {
              Some(s) => s.untracked()
              None => true
            } && !app_state.pending_pdf_export && !app_state.pending_screenshot_export)
            let is_sp = app_state.initial_start_page_open || proto::is_start_page_url(st.url())
            let hist_done = (!app_state.initial_history_open && !is_sp) || match app_state.host_history_synced {
              Some(s) => s.untracked()
              None => true
            }
            let bm_done = (!app_state.initial_bookmarks_open && app_state.demo_omnibox == "" && !is_sp) || match app_state.host_bookmarks_synced {
              Some(s) => s.untracked()
              None => true
            }
            let dt_done = !app_state.initial_devtools_open || (match app_state.host_devtools_synced {
              Some(s) => s.untracked()
              None => true
            } && app_state.devtools_snap.console_entries.length() >= app_state.initial_devtools_eval.length() * 2)
            let reader_done = !app_state.initial_reader_open || match app_state.host_reader_synced {
              Some(s) => s.untracked()
              None => true
            }
            let boosts_done = !app_state.initial_boosts_open || match app_state.host_boosts_synced {
              Some(s) => s.untracked()
              None => true
            }
            let settings_done = !app_state.initial_settings_open || match app_state.host_settings_synced {
              Some(s) => s.untracked()
              None => true
            }
            let site_perms_done = !app_state.initial_site_info_open || match app_state.host_site_perms_synced {
              Some(s) => s.untracked()
              None => true
            }
            let cookies_done = !app_state.initial_cookies_open || match app_state.host_cookies_synced {
              Some(s) => s.untracked()
              None => true
            }
            let perf_hud_done = !app_state.initial_perf_hud_open || match app_state.host_perf_hud_synced {
              Some(s) => s.untracked()
              None => true
            }
            if settle_i >= 24 && find_done && omni_done && ws_done && closed_done && dl_done && hist_done && bm_done && dt_done && reader_done && boosts_done && settings_done && site_perms_done && cookies_done && perf_hud_done && !ui::images_pending() {
              break
            }
            host::pump_main_loop(16.0)
            settle_i = settle_i + 1
          }
          if app_state.demo_favorites {
            ensure_demo_favorites_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_bookmarks_bar {
            ensure_demo_bookmarks_bar_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_devtools_network {
            ensure_demo_devtools_network_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_folders {
            ensure_demo_folders_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_reader_sepia {
            ensure_demo_reader_sepia_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_sessions {
            ensure_demo_sessions_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_tab_search {
            ensure_demo_tab_search_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_site_info {
            ensure_demo_site_info_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_capture_sheet {
            ensure_demo_capture_sheet_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_shell_dock_light {
            ensure_demo_shell_dock_light_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_shell_dock_dark {
            ensure_demo_shell_dock_dark_seeded()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.initial_mru_open {
            open_or_step_mru_switcher(1)
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.initial_nav_hist_dir >= 0 {
            let ax = if app_state.initial_nav_hist_dir == 0 { 44.0 } else { 78.0 }
            open_nav_hist(app_state.initial_nav_hist_dir, ax)
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_tab_preview != "" {
            let mut pick_id = app_state.demo_tab_preview
            let sp_tabs = proto::workspace_space_tabs(app_state.workspace, app_state.workspace.active_space_id)
            if pick_id == "first" || pick_id == "pinned" || pick_id == "1" || pick_id == "true" {
              if sp_tabs.length() > 0 {
                pick_id = sp_tabs[0].id
              }
            } else if pick_id == "media" {
              let mut found_m = ""
              let mut mi = 0
              while mi < sp_tabs.length() {
                let (pl, mu) = tab_preview_media_state(sp_tabs[mi])
                if pl || mu {
                  found_m = sp_tabs[mi].id
                  break
                }
                mi = mi + 1
              }
              if found_m != "" {
                pick_id = found_m
              } else {
                match app_state.workspace.media {
                  Some(m) if m.tab_id != "" => pick_id = m.tab_id
                  _ => if sp_tabs.length() > 0 { pick_id = sp_tabs[0].id }
                }
              }
            }
            open_tab_hover_preview(pick_id, 152.0, pinned_demo=true)
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.demo_tab_ctx != "" {
            let mut pick_id = app_state.demo_tab_ctx
            if pick_id == "first" || pick_id == "pinned" {
              let sp_tabs = proto::workspace_space_tabs(app_state.workspace, app_state.workspace.active_space_id)
              if sp_tabs.length() > 0 {
                pick_id = sp_tabs[0].id
              }
            }
            open_tab_ctx(pick_id, 148.0)
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          if app_state.initial_zoom_popover_open {
            open_zoom_popover()
            let _ = ui::view_frame(width, height, scale, now_ms())
          }
          let now2 = now_ms()
          let _ = ui::view_frame(width, height, scale, now2)
          let ok = host::snapshot(out_path)
          io_println(
            w,
            "app offscreen: url=" + st.url() + " title=\"" + st.title() + "\" frames=" + frame_i.to_string() + " snapshot=" + ok.to_string() + " -> " + out_path,
          )
          close_peek_preview(quiet=true)
          close_split_view(quiet=true)
          shutdown_io_runtime()
          shot_exit_code[0] = if ok { 0 } else { 1 }
        }
      }
      None => ()
    }
    if shot_exit_code[0] < 0 {
      ui::run("Farview", build_view, theme=lg::ui_theme)
      close_peek_preview(quiet=true)
      close_split_view(quiet=true)
      shutdown_io_runtime()
    }
  })
  app_cleanup_split_hosts()
  if shot_exit_code[0] >= 0 {
    net::exit(shot_exit_code[0])
  }
}
