fn any_command_bar_row_pressed() -> Bool {
  let mut i = 0
  while i < app_state.command_bar_row_views.length() {
    if app_state.command_bar_row_views[i].pressed() {
      return true
    }
    i = i + 1
  }
  false
}

fn refresh_command_bar_items(query : String) -> Unit {
  let cur_url = match app_state.stage {
    Some(_) => active_stage().url()
    None => ""
  }
  let ks = ui::keys_system()
  let is_macos = ks == 0 || ks < 0
  let items = proto::build_command_bar_items(
    app_state.workspace,
    query,
    cur_url,
    is_macos,
  )
  app_state.command_bar_items = items
  match app_state.command_bar_rev {
    Some(s) => s.set(s.untracked() + 1)
    None => ()
  }
  match app_state.command_bar_selected {
    Some(sel_sig) => {
      if items.length() == 0 {
        sel_sig.set(-1)
      } else {
        let cur = sel_sig.untracked()
        if cur < 0 || cur >= items.length() {
          sel_sig.set(0)
        }
      }
    }
    None => ()
  }
}

fn close_command_bar() -> Unit {
  app_state.command_bar_row_views.clear()
  match app_state.command_bar_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  match app_state.command_bar_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.command_bar_selected {
    Some(s) => s.set(0)
    None => ()
  }
}

fn open_command_bar(initial_query : String) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.command_bar_field {
    Some(cf) => {
      cf.set(initial_query)
      cf.focus()
      cf.pick(initial_query.length(), initial_query.length())
    }
    None => ()
  }
  refresh_command_bar_items(initial_query)
  match app_state.command_bar_selected {
    Some(s) => s.set(if app_state.command_bar_items.length() > 0 { 0 } else { -1 })
    None => ()
  }
  match app_state.command_bar_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::CommandBar, "command_bar")
  dispatch_workspace_sync()
}

fn toggle_command_bar() -> Unit {
  let is_open = match app_state.command_bar_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_command_bar()
  } else {
    open_command_bar("")
  }
}

fn step_command_bar_selection(delta : Int) -> Bool {
  let items = app_state.command_bar_items
  if items.length() == 0 {
    return true
  }
  match app_state.command_bar_selected {
    Some(sel_sig) => {
      let next = proto::omnibox_step_selection(sel_sig.untracked(), items.length(), delta)
      sel_sig.set(next)
    }
    None => ()
  }
  true
}

fn find_tab_summary(tab_id : String) -> Option[proto::TabSummary] {
  let target = if tab_id != "" { tab_id } else { app_state.workspace.active_tab_id }
  let mut i = 0
  while i < app_state.workspace.tabs.length() {
    let t = app_state.workspace.tabs[i]
    if (target != "" && t.id == target) || (target == "" && t.active) {
      return Some(t)
    }
    i = i + 1
  }
  None
}

fn dispatch_tab_pin(tab_id : String) -> Unit {
  let was_pinned = match find_tab_summary(tab_id) {
    Some(t) => t.pinned || t.favorite
    None => false
  }
  send_wire(wire::Message::Act("tab_pin", tab_id, ""))
  show_toast(if was_pinned { "Unpinned Tab" } else { "Pinned Tab" }, "pin")
}

fn dispatch_tab_favorite(tab_id : String) -> Unit {
