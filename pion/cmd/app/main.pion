    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_SPACE_THEME") {
    Some(v) if v == "1" || v == "true" => {
      app_state.initial_sidebar_open = true
      app_state.initial_space_theme_open = true
    }
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_SPACES") {
