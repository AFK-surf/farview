      None => ()
    }
    None => ()
  }
  match env_get(w, "FV_APP_SIDEBAR") {
    Some(v) if v == "1" || v == "true" => app_state.initial_sidebar_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_SITE_INFO") {
    Some(v) if v == "1" || v == "true" => app_state.initial_site_info_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_COOKIES") {
