///| Farview's own client: a tab on `stage::Stage` (the page's document laid out and drawn here, its fields
///| typed in here), over a socket to the host; a bar over it (back, forward, the address, reload) and,
///| while an agent drives the tab, a banner with a takeover button.
///| 1:1 port of `src/app/main.mbt` + `FV_APP_PORT` and `FV_APP_SHOT` offscreen Metal snapshot support.

import "net"
import "css"
import "proto"
import "wire"
import "os_platform"
import "stage"
import "shell_ui"
import "lg"
import "hostapi"
import "host"
import "view"
import "text"
import "ui"
import "signals"
import "headless"

let host_addr : String = "127.0.0.1"

extern "C" fn app_unix_time(tloc : Int64) -> Int64 = "time"
extern "C" fn app_pick_free_port() -> Int = "fv_app_pick_free_port"
extern "C" fn c_spawn_split_host(port : Int, url : Ptr, url_len : Int) -> Int = "fv_app_spawn_split_host"
extern "C" fn c_reveal_file(path : Ptr, path_len : Int) -> Int = "fv_app_reveal_file"
extern "C" fn c_verify_local_file(path : Ptr, path_len : Int, expected_bytes : Int64) -> Int = "fv_app_verify_local_file"
extern "C" fn app_kill_split_host(pid : Int) -> Int = "fv_app_kill_split_host"
extern "C" fn app_reap_pid(pid : Int) -> Int = "fv_app_reap_pid"
extern "C" fn app_cleanup_split_hosts() -> Unit = "fv_app_cleanup_split_hosts"

fn spawn_split_host(port : Int, url : String) -> Int {
  let b = url.to_bytes()
  let pid = c_spawn_split_host(port, bytes_data_ptr(b), b.length())
  if b.length() < 0 {
    panic("unreachable")
  }
  pid
}

fn app_now_secs() -> Int64 {
  let t = app_unix_time(0L)
  if t > 0L { t } else { 1700000000L }
}

fn space_sidebar_surface(accent : String) -> Int64 {
  let hex = proto::normalize_space_accent(accent)
  if hex == "#10B981" {
    0xF2FAF6FFL
  } else if hex == "#8B5CF6" {
    0xF6F3FDFFL
  } else if hex == "#F59E0B" {
    0xFDF8F0FFL
  } else if hex == "#EC4899" || hex == "#F43F5E" {
    0xFDF3F8FFL
  } else if hex == "#06B6D4" {
    0xF1FAFCFFL
  } else if hex == "#64748B" {
    0xF4F5F8FFL
  } else {
    0xF4F6FCFFL
  }
}

fn space_badge_tint(accent : String, hovered : Bool, pressed : Bool) -> (Int64, Int64) {
  let hex = proto::normalize_space_accent(accent)
  if hex == "#10B981" {
    (if pressed { 0xD1FAE5FFL } else if hovered { 0xDCFCE7FFL } else { 0xE6F9F0FFL }, 0xA7F3D0FFL)
  } else if hex == "#8B5CF6" {
    (if pressed { 0xDDD6FEFFL } else if hovered { 0xE7E1FEFFL } else { 0xEFEBFDFFL }, 0xC4B5FDFFL)
  } else if hex == "#F59E0B" {
    (if pressed { 0xFDE68AFFL } else if hovered { 0xFEF0B8FFL } else { 0xFEF6D8FFL }, 0xFCD34DFFL)
  } else if hex == "#EC4899" || hex == "#F43F5E" {
    (if pressed { 0xFBCFE8FFL } else if hovered { 0xFDE0F0FFL } else { 0xFCEBF4FFL }, 0xF9A8D4FFL)
  } else if hex == "#06B6D4" {
    (if pressed { 0xCFFAFEFFL } else if hovered { 0xDCF8FCFFL } else { 0xE8F9FCFFL }, 0xA5F3FCFFL)
  } else if hex == "#64748B" {
    (if pressed { 0xE2E8F0FFL } else if hovered { 0xE9EEF4FFL } else { 0xF1F5F9FFL }, 0xCBD5E1FFL)
  } else {
    (if pressed { 0xDCE1F0FFL } else if hovered { 0xE2E6F2FFL } else { 0xE8EBF4FFL }, 0xD4D9E8FFL)
  }
}

