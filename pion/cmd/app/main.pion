        app_state.demo_omnibox = q
      }
    } else if arg == "--demo-folders" {
      app_state.demo_folders = true
      app_state.initial_sidebar_open = true
    } else if arg == "--demo-reader-sepia" {
      app_state.demo_reader_sepia = true
      app_state.initial_reader_open = true
      app_state.initial_reader_theme = "sepia"
      app_state.initial_reader_font = "serif"
    } else if arg == "--demo-sessions" {
      app_state.demo_sessions = true
      app_state.initial_sessions_open = true
    } else if arg == "--demo-tab-search" {
      app_state.demo_tab_search = true
      app_state.initial_tab_search_open = true
    } else if arg == "--demo-site-info" {
      app_state.demo_site_info = true
      app_state.initial_site_info_open = true
    } else if arg == "--demo-capture-sheet" {
      app_state.demo_capture_sheet = true
    } else if arg == "--demo-shell-dock-light" {
      app_state.demo_shell_dock_light = true
      app_state.initial_sidebar_open = true
      app_state.initial_chrome_theme = "light"
      app_state.settings = proto::BrowserSettings::{ ..app_state.settings, chrome_theme: "light" }
    } else if arg == "--demo-shell-dock-dark" {
      app_state.demo_shell_dock_dark = true
      app_state.initial_sidebar_open = true
      app_state.initial_split_open = true
      app_state.initial_chrome_theme = "dark"
      app_state.settings = proto::BrowserSettings::{ ..app_state.settings, chrome_theme: "dark" }
    }
    arg_i = arg_i + 1
  }
  match env_get(w, "FV_APP_PORT") {
