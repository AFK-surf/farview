  app_state.tab_ctx_open = Some(tab_ctx_open)
  app_state.tab_ctx_tab_id = Some(tab_ctx_tab_id)
  app_state.tab_ctx_y = Some(tab_ctx_y)
  app_state.zoom_popover_open = Some(zoom_popover_open)
  app_state.folder_ctx_open = Some(folder_ctx_open)
  app_state.folder_ctx_id = Some(folder_ctx_id)
  app_state.folder_ctx_y = Some(folder_ctx_y)
  app_state.shortcuts_open = Some(shortcuts_open)
  app_state.split_open = Some(split_open)
  app_state.split_ratio = Some(split_ratio)
  app_state.split_active_pane = Some(split_active_pane)
  app_state.split_swapped = Some(split_swapped)
  app_state.split_dragging = Some(split_dragging)
  app_state.split_tab_id = Some(split_tab_id)
  app_state.peek_open = Some(peek_open)
  app_state.peek_tab_id = Some(peek_tab_id)
  app_state.peek_url = Some(peek_url)
  app_state.peek_rev = Some(peek_rev)
  app_state.page_ctx_open = Some(page_ctx_open)
  app_state.page_ctx_link = Some(page_ctx_link)
  app_state.page_ctx_x = Some(page_ctx_x)
  app_state.page_ctx_y = Some(page_ctx_y)
  app_state.page_ctx_can_back = Some(page_ctx_can_back)
  app_state.page_ctx_can_forward = Some(page_ctx_can_forward)
  app_state.tab_preview_open = Some(tab_preview_open)
  app_state.tab_preview_tab_id = Some(tab_preview_tab_id)
  app_state.tab_preview_y = Some(tab_preview_y)
  app_state.shift_held = Some(shift_held)
  app_state.nav_hist_open = Some(nav_hist_open)
  app_state.nav_hist_dir = Some(nav_hist_dir)
  app_state.nav_hist_x = Some(nav_hist_x)
  app_state.mru_open = Some(mru_open)
  app_state.tab_search_open = Some(tab_search_open)
  app_state.tab_search_query = Some(tab_search_query)
  app_state.tab_search_selected = Some(tab_search_selected)
  app_state.tab_search_field = Some(tab_search_field)
  app_state.capture_sheet_open = Some(capture_sheet_open)
  app_state.capture_sheet_rev = Some(capture_sheet_rev)
  app_state.mru_selected = Some(mru_selected)
  app_state.mru_rev = Some(mru_rev)
  app_state.tab_filter_open = Some(tab_filter_open)
  app_state.tab_filter_query = Some(tab_filter_query)
  app_state.tab_filter_field = Some(tab_filter_field)
  app_state.devtools_open = Some(devtools_open)
  app_state.devtools_height = Some(devtools_height)
  app_state.devtools_dragging = Some(devtools_dragging)
  app_state.devtools_tab = Some(devtools_tab)
  app_state.devtools_rev = Some(devtools_rev)
  app_state.devtools_net_filter = Some(devtools_net_filter)
  app_state.devtools_net_query = Some(devtools_net_query)
  app_state.devtools_net_search_field = Some(devtools_net_search_field)
  app_state.devtools_net_selected_idx = Some(devtools_net_selected_idx)
  app_state.bookmarks_bar_open = Some(bookmarks_bar_open)
  app_state.bm_bar_ctx_open = Some(bm_bar_ctx_open)
  app_state.bm_bar_ctx_id = Some(bm_bar_ctx_id)
  app_state.bm_bar_ctx_url = Some(bm_bar_ctx_url)
  app_state.bm_bar_ctx_x = Some(bm_bar_ctx_x)
  app_state.reader_open = Some(reader_open)
  app_state.reader_rev = Some(reader_rev)
  app_state.host_reader_synced = Some(host_reader_synced)
  app_state.reader_theme = Some(reader_theme)
  app_state.reader_font = Some(reader_font)
  app_state.reader_font_size = Some(reader_font_size)
  app_state.reader_width_mode = Some(reader_width_mode)
  app_state.reader_progress = Some(reader_progress)
  app_state.folder_create_open = Some(folder_create_open)
  app_state.folder_create_color = Some(folder_create_color)
  app_state.folder_create_move_active = Some(folder_create_move_active)
  app_state.folder_create_field = Some(folder_create_field)
  app_state.sessions_open = Some(sessions_open)
  app_state.sessions_rev = Some(sessions_rev)
  app_state.host_sessions_synced = Some(host_sessions_synced)
  app_state.sessions_name_field = Some(sessions_name_field)
  app_state.sessions_filter_field = Some(sessions_filter_field)
  app_state.sessions_filter_query = Some(sessions_filter_query)
  app_state.boosts_open = Some(boosts_open)
  app_state.boosts_rev = Some(boosts_rev)
  app_state.host_boosts_synced = Some(host_boosts_synced)
  app_state.boosts_css_field = Some(boosts_css_field)
  app_state.settings_open = Some(settings_open)
  app_state.settings_tab = Some(settings_tab)
  app_state.settings_rev = Some(settings_rev)
  app_state.chrome_theme = Some(chrome_theme)
  app_state.host_settings_synced = Some(host_settings_synced)
  app_state.site_perms_rev = Some(site_perms_rev)
  app_state.host_site_perms_synced = Some(host_site_perms_synced)
  app_state.media_hub_open = Some(media_hub_open)
  app_state.media_hub_rev = Some(media_hub_rev)
  app_state.mini_player_rev = Some(mini_player_rev)
  app_state.host_media_hub_synced = Some(host_media_hub_synced)
  app_state.start_page_field = Some(start_page_field)
  app_state.devtools_selected_path = Some(devtools_selected_path)
  app_state.devtools_console_filter = Some(devtools_console_filter)
  app_state.devtools_repl_field = Some(devtools_repl_field)
  app_state.host_devtools_synced = Some(host_devtools_synced)
  app_state.perf_hud_open = Some(perf_hud_open)
  app_state.perf_hud_rev = Some(perf_hud_rev)
  app_state.host_perf_hud_synced = Some(host_perf_hud_synced)
  app_state.ime_composing = false
  shell_sync_dock_from_app()
  shell_page_sync_from_app()
  shell_sync_passive_from_app()
  ui::set_text_interceptor(Some(handle_ime_text))
  ui::set_key_interceptor(Some(handle_app_key))
  if app_state.demo_find != "" {
    find_field.set(app_state.demo_find)
  }
  let all_keys : Array[view::Binding] = []
  // Single-line Omnibox & Command Bar Field keyboard navigation (Invar focus-chain routing)
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_down, mods: 0 }],
      action: "omnibox.down",
      when: view::KeyWhen::In("OmniboxField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_up, mods: 0 }],
      action: "omnibox.up",
      when: view::KeyWhen::In("OmniboxField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_down, mods: 0 }],
      action: "commandbar.down",
      when: view::KeyWhen::In("CommandBarField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_up, mods: 0 }],
      action: "commandbar.up",
      when: view::KeyWhen::In("CommandBarField"),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: proto::KEY_ESCAPE, mods: 0 }],
      action: "commandbar.escape",
      when: view::KeyWhen::In("CommandBarField"),
    },
  )
  for b in stage::browser_keys() {
    all_keys.push(b)
  }
  // Additional Chromium/Arc desktop shortcuts: F5, Alt+Left/Right, Cmd/Ctrl+Shift+= / +
  for f5 in [proto::KEY_F5_MAC, proto::KEY_F5_WIN, proto::KEY_F5_X11] {
    all_keys.push(
      view::Binding::{
        keys: [view::Stroke::{ code: f5, mods: 0 }],
        action: stage::act_reload,
        when: view::KeyWhen::Always,
      },
    )
  }
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_left, mods: ui::mod_alt }],
      action: stage::act_back,
      when: view::KeyWhen::Not(view::KeyWhen::In("Field")),
    },
  )
  all_keys.push(
    view::Binding::{
      keys: [view::Stroke::{ code: ui::key_code_right, mods: ui::mod_alt }],
      action: stage::act_forward,
      when: view::KeyWhen::Not(view::KeyWhen::In("Field")),
    },
  )
  for m in [ui::mod_cmd | ui::mod_shift_key, ui::mod_ctrl | ui::mod_shift_key] {
    for code in [1061, 1043] {
      all_keys.push(
        view::Binding::{
          keys: [view::Stroke::{ code, mods: m }],
          action: stage::act_zoom_in,
          when: view::KeyWhen::Always,
        },
      )
    }
  }
  for b in stage::page_keys() {
    all_keys.push(b)
  }
  let _ = root
  .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))
  .keymap(view::Live::Is(view::Keymap::new(all_keys)))
  .on_action(stage::act_focus_url, fn(_a : view::ActionAt) -> Bool {
    address.focus()
    address.pick(0, address.text().length())
    omnibox_selected.set(-1)
    dispatch_omnibox_query("")
    true
  })
  .on_action(stage::act_reload, fn(_a : view::ActionAt) -> Bool {
    active_stage().reload()
    true
  })
  .on_action(stage::act_back, fn(_a : view::ActionAt) -> Bool {
    active_stage().back()
    true
  })
  .on_action(stage::act_forward, fn(_a : view::ActionAt) -> Bool {
    active_stage().forward()
    true
  })
  .on_action(stage::act_zoom_in, fn(_a : view::ActionAt) -> Bool {
    let cur = active_stage()
    apply_zoom_and_sync(cur, proto::zoom_step_up(cur.zoom()))
    true
  })
  .on_action(stage::act_zoom_out, fn(_a : view::ActionAt) -> Bool {
    let cur = active_stage()
    apply_zoom_and_sync(cur, proto::zoom_step_down(cur.zoom()))
    true
  })
  .on_action(stage::act_zoom_reset, fn(_a : view::ActionAt) -> Bool {
    apply_zoom_and_sync(active_stage(), proto::zoom_reset())
    true
  })
  .on_action(stage::act_find, fn(_a : view::ActionAt) -> Bool {
    open_find_bar()
    true
  })
  .on_action(stage::act_escape, fn(_a : view::ActionAt) -> Bool {
    if mru_open.untracked() {
      close_mru_switcher()
      true
    } else if peek_open.untracked() {
      close_peek_preview()
      true
    } else if nav_hist_open.untracked() {
      close_nav_hist()
      true
    } else if shortcuts_open.untracked() {
      close_shortcuts()
      true
    } else if cookies_open.untracked() {
      close_cookies_modal()
      true
    } else if tab_ctx_open.untracked() {
      close_tab_ctx()
      true
    } else if zoom_popover_open.untracked() {
      close_zoom_popover()
      true
    } else if folder_ctx_open.untracked() {
      close_folder_ctx()
      true
    } else if command_bar_open.untracked() {
      close_command_bar()
      true
    } else if tab_search_open.untracked() {
      close_tab_search()
      true
    } else if capture_sheet_open.untracked() {
      close_capture_sheet()
      true
    } else if history_open.untracked() {
      close_history()
      true
    } else if bookmarks_open.untracked() {
      close_bookmarks()
      true
    } else if boosts_open.untracked() {
      close_boosts()
      true
    } else if settings_open.untracked() {
      close_settings()
      true
    } else if reader_open.untracked() {
      close_reader_mode()
      true
    } else if space_theme_open.untracked() {
      close_space_theme()
      true
    } else if spaces_manager_open.untracked() {
      close_spaces_manager()
      true
    } else if closed_tabs_open.untracked() {
      close_closed_tabs_modal()
      true
    } else if print_pdf_open.untracked() {
      close_print_pdf_modal()
      true
    } else if perf_hud_open.untracked() {
      close_perf_hud()
      true
    } else if site_info_open.untracked() || downloads_open.untracked() || idn_popover_open.untracked() {
      close_site_info()
      close_downloads()
      close_idn_popover()
      true
    } else if tab_filter_open.untracked() {
      close_tab_filter()
      true
    } else if find_open.untracked() {
      close_find_bar(active_stage())
      true
    } else if address.focused() || omnibox_open.untracked() {
      close_omnibox()
      app_state.syncing_address_url = true
      address.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
      app_state.syncing_address_url = false
      address.let_go()
      true
    } else {
      false
    }
  })
  let _ = root.box(
    fn(bar : view::View) -> Unit {
      let _ = bar
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(46.0)))
      .rigid()
      .gap(view::Live::Is(6.0))
      .padding(view::Live::Is((6.0, 8.0, 6.0, 8.0)))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))
      // Leftmost Arc sidebar toggle button (crisp vector 2-pane icon)
      let _ = headless::button(
        bar,
        fn() -> String { "Toggle Sidebar" },
        fn(_v : view::View) -> Unit { toggle_sidebar() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b
          .width(view::Live::Is(Some(30.0)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .center()
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if btn.pressed() {
              p.btn_press
            } else if sidebar_open.get() {
              p.btn_active_bg
            } else if btn.hovered() {
              p.btn_hover
            } else {
              p.btn_bg
            }
          }))
          let _ = b.box(
            fn(ico : view::View) -> Unit {
              let _ = ico
              .row(view::Live::Is(true))
              .width(view::Live::Is(Some(15.0)))
              .height(view::Live::Is(Some(12.0)))
              .radius(view::Live::Is(2.5))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let p = chrome_palette()
                if sidebar_open.get() { (1.2, p.accent) } else { (1.2, p.ink_secondary) }
              }))
              let _ = ico.box(
                fn(rail : view::View) -> Unit {
                  let _ = rail
                  .width(view::Live::Is(Some(5.0)))
                  .height(view::Live::Is(Some(12.0)))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if sidebar_open.get() { (p.accent & 0xFFFFFF00L) | 0x40L } else { (p.ink_secondary & 0xFFFFFF00L) | 0x28L }
                  }))
                },
              )
              let _ = ico.box(
                fn(sep : view::View) -> Unit {
                  let _ = sep
                  .width(view::Live::Is(Some(1.0)))
                  .height(view::Live::Is(Some(12.0)))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if sidebar_open.get() { p.accent } else { p.ink_secondary }
                  }))
                },
              )
            },
          )
        },
      )
      let nav_hist_button = fn(symbol : String, dir : Int, on_click : () -> Unit) -> Unit {
        let _ = headless::button(
          bar,
          fn() -> String { if dir == 0 { "Back (Right-click for history)" } else { "Forward (Right-click for history)" } },
          fn(_v : view::View) -> Unit {
            close_nav_hist()
            on_click()
          },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let is_pop = fn() -> Bool { nav_hist_open.get() && nav_hist_dir.get() == dir }
            let _ = b
            .padding(view::Live::Is((9.0, 5.0, 9.0, 5.0)))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if is_pop() {
                p.accent_soft_bg
              } else if btn.pressed() {
                p.btn_press
              } else if btn.hovered() {
                p.btn_hover
              } else {
                p.btn_bg
              }
            }))
            .on_menu(fn(_m : view::Menu) -> Unit {
              let (bx, _, _, _) = b.placed_now()
              open_nav_hist(dir, if bx > 4.0 { bx } else { 44.0 })
            })
            let _ = b.box(
              fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is(symbol),
                  ink=0x1D1D1FFFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
              },
            )
          },
        )
      }
      nav_hist_button("‹", 0, fn() -> Unit { active_stage().back() })
      nav_hist_button("›", 1, fn() -> Unit { active_stage().forward() })
      // Arc Space badge (restrained pill with accent indicator synced with active Space)
      let active_space_label = fn() -> String {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) if sp.name != "" => sp.name
          _ => app_state.space_name
        }
      }
      let active_space_color = fn() -> Int64 {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => proto::workspace_accent_color(sp.accent)
          None => 0x2563EBFFL
        }
      }
      let _ = headless::button(
        bar,
        active_space_label,
        fn(_v : view::View) -> Unit { toggle_sidebar() },
        fn(sp : view::View, btn : headless::Button) -> Unit {
          let _ = sp
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(6.0))
          .padding(view::Live::Is((5.0, 9.0, 5.0, 8.0)))
          .radius(view::Live::Is(7.0))
          .ground(view::Live::By(fn() -> Int64 {
            let _ = workspace_rev.get()
            let acc = match proto::workspace_active_space(app_state.workspace) {
              Some(s) => s.accent
              None => "#2563EB"
            }
            let (bg, _) = space_badge_tint_themed(acc, btn.hovered(), btn.pressed(), is_dark_chrome())
            bg
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let _ = workspace_rev.get()
            let acc = match proto::workspace_active_space(app_state.workspace) {
              Some(s) => s.accent
              None => "#2563EB"
            }
            let (_, ed) = space_badge_tint_themed(acc, btn.hovered(), btn.pressed(), is_dark_chrome())
            (1.0, ed)
          }))
          let _ = sp.box(
            fn(dot : view::View) -> Unit {
              let _ = dot
              .width(view::Live::Is(Some(7.0)))
              .height(view::Live::Is(Some(7.0)))
              .radius(view::Live::Is(3.5))
              .ground(view::Live::By(active_space_color))
            },
          )
          let _ = sp.box(
            fn(lbl : view::View) -> Unit {
              let _ = lbl
              .words(
                view::Live::By(active_space_label),
                ink=0x2C3446FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )
        },
      )
      bar.reacts(fn() -> String { active_address_raw_url() }, fn(u : String) -> Unit {
        if !address.focused() {
          app_state.syncing_address_url = true
          address.set(proto::omnibox_safe_display_url(u))
          app_state.syncing_address_url = false
        }
      })
      bar.reacts(fn() -> String { address.text() }, fn(q : String) -> Unit {
        if address.focused() && !app_state.syncing_address_url {
          omnibox_selected.set(-1)
          dispatch_omnibox_query(q)
        }
      })
      bar.reacts(fn() -> Bool { address.focused() }, fn(foc : Bool) -> Unit {
        if foc {
          if !omnibox_open.untracked() {
            let cur = address.text()
            let q = if cur == active_stage().url() { "" } else { cur }
            dispatch_omnibox_query(q)
          }
        } else if app_state.demo_omnibox == "" && !any_omnibox_row_pressed() {
          close_omnibox()
        }
      })
      let _ = bar.box(
        fn(f : view::View) -> Unit {
          app_state.address_bar_view = Some(f)
          let _ = f
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(6.0))
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .padding(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
          .radius(view::Live::Is(8.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            if address.focused() { (1.5, p.accent) } else { (1.0, p.border) }
          }))
          .key_context("OmniboxField")
          .on_action("omnibox.down", fn(_a : view::ActionAt) -> Bool { step_omnibox_selection(1) })
          .on_action("omnibox.up", fn(_a : view::ActionAt) -> Bool { step_omnibox_selection(-1) })
          // Left site security / permissions badge (lock icon + media permission dot)
          let _ = headless::button(
            f,
            fn() -> String { "Site Controls" },
            fn(_v : view::View) -> Unit { toggle_site_info() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let is_sec = fn() -> Bool {
                let _ = workspace_rev.get()
                match app_state.workspace.permissions {
                  Some(pm) if pm.origin != "" => proto::site_is_https(pm.origin)
                  _ => proto::site_is_https(st.url())
                }
              }
              let has_media = fn() -> Bool {
                let _ = workspace_rev.get()
                let _ = site_perms_rev.get()
                proto::site_has_granted_media(app_state.workspace.permissions) ||
                proto::site_perm_rule_has_active_media(active_site_permission_rule(active_stage_live().url()))
              }
              let lock_ink = fn() -> Int64 {
                let p = chrome_palette()
                if site_info_open.get() {
                  p.accent
                } else if is_sec() {
                  if p.is_dark { 0x34D399FFL } else { 0x15803DFFL }
                } else {
                  p.ink_muted
                }
              }
              let _ = b
              .keeps_held(view::Live::Is(true))
              .width(view::Live::Is(Some(26.0)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if site_info_open.get() {
                  p.accent_soft_bg
                } else if btn.pressed() {
                  p.btn_press
                } else if btn.hovered() {
                  p.btn_hover
                } else if is_sec() {
                  if p.is_dark { 0x152B23FFL } else { 0xECFDF3FFL }
                } else if p.is_dark {
                  0x282C38FFL
                } else {
                  0xF3F4F7FFL
                }
              }))
              // Crisp vector padlock icon
              let _ = b.box(
                fn(ico : view::View) -> Unit {
                  let _ = ico
                  .width(view::Live::Is(Some(12.0)))
                  .height(view::Live::Is(Some(13.0)))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  // Shackle
                  let _ = ico.box(
                    fn(sh : view::View) -> Unit {
                      let _ = sh
                      .width(view::Live::Is(Some(7.0)))
                      .height(view::Live::Is(Some(5.5)))
                      .rigid()
                      .radius(view::Live::Is(3.5))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.4, lock_ink()) }))
                    },
                  )
                  // Lock body
                  let _ = ico.box(
                    fn(bd : view::View) -> Unit {
                      let _ = bd
                      .width(view::Live::Is(Some(10.5)))
                      .height(view::Live::Is(Some(7.5)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(2.0))
                      .ground(view::Live::By(lock_ink))
                      let _ = bd.box(
                        fn(kh : view::View) -> Unit {
                          let _ = kh
                          .width(view::Live::Is(Some(2.0)))
                          .height(view::Live::Is(Some(2.5)))
                          .radius(view::Live::Is(1.0))
                          .ground(view::Live::Is(0xFFFFFFFFL))
                        },
                      )
                    },
                  )
                },
              )
              // Soft granted-media indicator dot (camera/microphone/screen share active)
              b.show(
                has_media,
                fn(dot : view::View) -> Unit {
                  let _ = dot
                  .over_at(view::Live::Is((None, Some(2.0), Some(2.0), None)))
                  .width(view::Live::Is(Some(6.0)))
                  .height(view::Live::Is(Some(6.0)))
                  .radius(view::Live::Is(3.0))
                  .ground(view::Live::Is(0x10B981FFL))
                  .edge(view::Live::Is((1.0, 0xFFFFFFFFL)))
                },
              )
            },
          )
          // IDN homograph anti-spoofing warning capsule — unmounts to 0px when safe
          build_idna_spoof_capsule(f, idn_popover_open)
          // Smart Site Search capsule (`@gh`, `@yt`, `@mdn`, `@wiki`, `@g`) — unmounts to 0px when inactive
          build_omnibox_site_search_capsule(f, address, omnibox_rev)
          let _ = f.box(
            fn(fw : view::View) -> Unit {
              let _ = fw
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(24.0)))
              .clips(view::Live::Is(true))
              .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
              fw.show(
                fn() -> Bool { !is_dark_chrome() },
                fn(fl : view::View) -> Unit {
                  let _ = ui::field(
                    fl,
                    address,
                    placeholder="Search or enter URL...",
                    font_size=15.0,
                    color=0x1D1D1FFFL,
                    placeholder_color=0x8E8E93FFL,
                    max_lines=1,
                    enter_sends=true,
                    submitted=fn(t : String) -> Unit {
                      navigate_omnibox(active_stage(), t, None)
                    },
                  )
                },
              )
              fw.show(
                fn() -> Bool { is_dark_chrome() },
                fn(fd : view::View) -> Unit {
                  let _ = ui::field(
                    fd,
                    address,
                    placeholder="Search or enter URL...",
                    font_size=15.0,
                    color=0xF1F5F9FFL,
                    placeholder_color=0x94A3B8FFL,
                    caret_color=0x60A5FAFFL,
                    max_lines=1,
                    enter_sends=true,
                    submitted=fn(t : String) -> Unit {
                      navigate_omnibox(active_stage(), t, None)
                    },
                  )
                },
              )
            },
          )
          // Right-side Bookmark Star button (outline star when unsaved, warm gold solid star when bookmarked)
          let _ = headless::button(
            f,
            fn() -> String {
              let _ = bookmarks_rev.get()
              if proto::bookmarks_contains_url(app_state.bookmarks_snap, active_stage_live().url()) {
                "Remove Bookmark"
              } else {
                "Bookmark This Page"
              }
            },
            fn(_v : view::View) -> Unit { dispatch_bookmark_toggle() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let is_saved = fn() -> Bool {
                let _ = bookmarks_rev.get()
                proto::bookmarks_contains_url(app_state.bookmarks_snap, active_stage_live().url())
              }
              let _ = b
              .keeps_held(view::Live::Is(true))
              .width(view::Live::Is(Some(26.0)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if is_saved() {
                  if p.is_dark {
                    if btn.pressed() { 0x4A3A15FFL } else if btn.hovered() { 0x3D3014FFL } else { 0x332812FFL }
                  } else if btn.pressed() {
                    0xFCD34DFFL
                  } else if btn.hovered() {
                    0xFDE68AFFL
                  } else {
                    0xFEF3C7FFL
                  }
                } else if btn.pressed() {
                  p.btn_press
                } else if btn.hovered() {
                  p.btn_hover
                } else {
                  0x00000000L
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                if is_saved() {
                  (1.0, if is_dark_chrome() { 0x785B1EFFL } else { 0xFCD34DFFL })
                } else {
                  (1.0, 0x00000000L)
                }
              }))
              let _ = b.box(
                fn(star : view::View) -> Unit {
                  let _ = star
                  .words(
                    view::Live::By(fn() -> String { if is_saved() { "★" } else { "☆" } }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if is_saved() {
                      if p.is_dark { 0xFBBF24FFL } else { 0xD97706FFL }
                    } else if btn.hovered() || btn.pressed() {
                      p.ink_primary
                    } else {
                      p.ink_muted
                    }
                  }))
                },
              )
            },
          )
          // Right-side Arc Boosts badge button (violet tint + dot when site boost is active)
          let _ = headless::button(
            f,
            fn() -> String { "Arc Boosts" },
            fn(_v : view::View) -> Unit { toggle_boosts() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let is_boosted = fn() -> Bool {
                let _ = boosts_rev.get()
                proto::boosts_is_active(app_state.boosts_snap, active_stage_live().url())
              }
              let _ = b
              .keeps_held(view::Live::Is(true))
              .width(view::Live::Is(Some(26.0)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if boosts_open.get() || is_boosted() {
                  if p.is_dark {
                    if btn.pressed() { 0x3A2D5EFFL } else if btn.hovered() { 0x312650FFL } else { 0x282042FFL }
                  } else if btn.pressed() {
                    0xDDD6FEFFL
                  } else if btn.hovered() {
                    0xE9D5FFFFL
                  } else {
                    0xEDE9FEFFL
                  }
                } else if btn.pressed() {
                  p.btn_press
                } else if btn.hovered() {
                  p.btn_hover
                } else {
                  0x00000000L
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                if boosts_open.get() || is_boosted() {
                  (1.0, if is_dark_chrome() { 0x5B468FFFL } else { 0xC4B5FDFFL })
                } else {
                  (1.0, 0x00000000L)
                }
              }))
              let _ = b.box(
                fn(spark : view::View) -> Unit {
                  let _ = spark
                  .words(
                    view::Live::Is("✦"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if boosts_open.get() || is_boosted() {
                      if p.is_dark { 0xC4B5FDFFL } else { 0x6D28D9FFL }
                    } else if btn.hovered() || btn.pressed() {
                      p.ink_primary
                    } else {
                      p.ink_muted
                    }
                  }))
                },
              )
              b.show(
                is_boosted,
                fn(dot : view::View) -> Unit {
                  let _ = dot
                  .over_at(view::Live::Is((None, Some(2.0), Some(2.0), None)))
                  .width(view::Live::Is(Some(5.0)))
                  .height(view::Live::Is(Some(5.0)))
                  .radius(view::Live::Is(2.5))
                  .ground(view::Live::Is(0x7C3AEDFFL))
                  .edge(view::Live::Is((1.0, 0xFFFFFFFFL)))
                },
              )
            },
          )
          build_omnibox_zoom_pill(f, zoom_popover_open)
        },
      )
      bar_button_live(
        bar,
        fn() -> String { if active_stage_live().loading() { "×" } else { "↻" } },
        fn() -> Unit { active_stage().reload() },
      )
      // Arc Split View toggle button (crisp vector 2-column split icon; Space-accent active state)
      let _ = headless::button(
        bar,
        fn() -> String { if split_open.get() { "Close Split View" } else { "Open Split View" } },
        fn(_v : view::View) -> Unit { toggle_split_view() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let split_ink = fn() -> Int64 {
            let p = chrome_palette()
            if split_open.get() { active_space_color() } else { p.ink_secondary }
          }
          let _ = b
          .width(view::Live::Is(Some(30.0)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .center()
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if btn.pressed() {
              p.btn_press
            } else if split_open.get() {
              let c = active_space_color()
              (c & 0xFFFFFF00L) | 0x22L
            } else if btn.hovered() {
              p.btn_hover
            } else {
              p.btn_bg
            }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            if split_open.get() {
              let c = active_space_color()
              (1.0, (c & 0xFFFFFF00L) | 0x66L)
            } else {
              (1.0, 0x00000000L)
            }
          }))
          let _ = b.box(
            fn(ico : view::View) -> Unit {
              let _ = ico
              .row(view::Live::Is(true))
              .width(view::Live::Is(Some(15.0)))
              .height(view::Live::Is(Some(12.0)))
              .radius(view::Live::Is(2.5))
              .clips(view::Live::Is(true))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.2, split_ink()) }))
              let _ = ico.box(
                fn(lp : view::View) -> Unit {
                  let _ = lp
                  .grow(view::Live::Is(1.0))
                  .height(view::Live::Is(Some(12.0)))
                  .ground(view::Live::By(fn() -> Int64 {
                    if split_open.get() {
                      let c = active_space_color()
                      (c & 0xFFFFFF00L) | 0x1AL
                    } else {
                      0x00000000L
                    }
                  }))
                },
              )
              let _ = ico.box(
                fn(sep : view::View) -> Unit {
                  let _ = sep
                  .width(view::Live::Is(Some(1.2)))
                  .height(view::Live::Is(Some(12.0)))
                  .rigid()
                  .ground(view::Live::By(split_ink))
                },
              )
              let _ = ico.box(
                fn(rp : view::View) -> Unit {
                  let _ = rp
                  .grow(view::Live::Is(1.0))
                  .height(view::Live::Is(Some(12.0)))
                  .ground(view::Live::By(fn() -> Int64 {
                    if split_open.get() {
                      let c = active_space_color()
                      (c & 0xFFFFFF00L) | 0x44L
                    } else {
                      0x4B556322L
                    }
                  }))
                },
              )
            },
          )
        },
      )
      // Global Media Hub trigger button (`♫`)
      build_topbar_media_hub_button(bar, media_hub_open, media_hub_rev, workspace_rev)
      // Rightmost Downloads trigger button (vector download arrow + active blue dot badge)
      let _ = headless::button(
        bar,
        fn() -> String { "Downloads" },
        fn(_v : view::View) -> Unit { toggle_downloads() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let has_dl = fn() -> Bool {
            let _ = downloads_rev.get()
            app_state.downloads.length() > 0
          }
          let arrow_ink = fn() -> Int64 {
            let p = chrome_palette()
            if downloads_open.get() { p.accent } else { p.ink_secondary }
          }
          let _ = b
          .width(view::Live::Is(Some(30.0)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .center()
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if btn.pressed() {
              p.btn_press
            } else if downloads_open.get() {
              p.btn_active_bg
            } else if btn.hovered() {
              p.btn_hover
            } else {
              p.btn_bg
            }
          }))
          let _ = b.box(
            fn(ico : view::View) -> Unit {
              let _ = ico
              .width(view::Live::Is(Some(14.0)))
              .height(view::Live::Is(Some(14.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              // Arrow stem
              let _ = ico.box(
                fn(stem : view::View) -> Unit {
                  let _ = stem
                  .width(view::Live::Is(Some(2.0)))
                  .height(view::Live::Is(Some(6.0)))
                  .rigid()
                  .radius(view::Live::Is(1.0))
                  .ground(view::Live::By(arrow_ink))
                },
              )
              // Arrow head (crisp stepped chevron pointing down)
              let _ = ico.box(
                fn(h1 : view::View) -> Unit {
                  let _ = h1
                  .width(view::Live::Is(Some(7.0)))
                  .height(view::Live::Is(Some(1.8)))
                  .rigid()
                  .radius(view::Live::Is(0.8))
                  .ground(view::Live::By(arrow_ink))
                },
              )
              let _ = ico.box(
                fn(h2 : view::View) -> Unit {
                  let _ = h2
                  .width(view::Live::Is(Some(4.0)))
                  .height(view::Live::Is(Some(1.6)))
                  .rigid()
                  .radius(view::Live::Is(0.8))
                  .ground(view::Live::By(arrow_ink))
                },
              )
              let _ = ico.box(
                fn(sp : view::View) -> Unit {
                  let _ = sp.height(view::Live::Is(Some(2.0))).rigid()
                },
              )
              // Tray line
              let _ = ico.box(
                fn(tray : view::View) -> Unit {
                  let _ = tray
                  .width(view::Live::Is(Some(11.0)))
                  .height(view::Live::Is(Some(1.8)))
                  .rigid()
                  .radius(view::Live::Is(0.9))
                  .ground(view::Live::By(arrow_ink))
                },
              )
            },
          )
          b.show(
            has_dl,
            fn(dot : view::View) -> Unit {
              let _ = dot
              .over_at(view::Live::Is((None, Some(3.0), Some(3.0), None)))
              .width(view::Live::Is(Some(6.0)))
              .height(view::Live::Is(Some(6.0)))
              .radius(view::Live::Is(3.0))
              .ground(view::Live::Is(0x2563EBFFL))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().toolbar_bg) }))
            },
          )
        },
      )
      // Rightmost Settings trigger button (`Cmd+,` / `Ctrl+,`)
      let _ = headless::button(
        bar,
        fn() -> String { "Settings" },
        fn(_v : view::View) -> Unit { toggle_settings() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b
          .width(view::Live::Is(Some(30.0)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .center()
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if btn.pressed() {
              p.btn_press
            } else if settings_open.get() {
              p.btn_active_bg
            } else if btn.hovered() {
              p.btn_hover
            } else {
              p.btn_bg
            }
          }))
          let _ = b.box(
            fn(gl : view::View) -> Unit {
              let _ = gl
              .words(
                view::Live::Is("⚙"),
                ink=0x3A4152FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if settings_open.get() { p.accent } else { p.ink_secondary }
              }))
            },
          )
        },
      )
    },
  )
  // Native toggleable 28pt Bookmarks Bar (`Cmd+Shift+B`; unmounts to 0px when hidden, single bottom hairline)
  build_bookmarks_bar(root, bookmarks_bar_open, bookmarks_rev)
  root.show(
    fn() -> Bool { active_stage_live().loading() },
    fn(prog : view::View) -> Unit {
      let _ = prog.height(view::Live::Is(Some(2.0))).ground(view::Live::Is(0x0A84FFFFL))
    },
  )
  // Floating Cmd+F capsule is mounted inside `content_wrap` via `build_find_bar_overlay` so it never shifts or covers toolbar controls.
  root.show(
    fn() -> Bool { st.agent() },
    fn(line : view::View) -> Unit {
      let _ = line
      .row(view::Live::Is(true))
      .gap(view::Live::Is(8.0))
      .padding(view::Live::Is((6.0, 12.0, 6.0, 12.0)))
      .ground(view::Live::Is(0xFFF4D6FFL))
      let _ = line.box(
        fn(w : view::View) -> Unit {
          let _ = w.grow(view::Live::Is(1.0)).words(view::Live::Is("Agent 正在操作这个页面"), ink=0x1D1D1FFFL)
        },
      )
      bar_button(line, "接管", fn() -> Unit { st.take_over() })
    },
  )
  // Main content row: optional collapsible 244pt Arc Sidebar + Webpage Stage
  let _ = root.box(
    fn(body : view::View) -> Unit {
      let _ = body
      .row(view::Live::Is(true))
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_height(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      body.show(
        fn() -> Bool { sidebar_open.get() },
        fn(sb_outer : view::View) -> Unit {
          let _ = sb_outer
          .row(view::Live::Is(true))
          .width(view::Live::By(fn() -> Option[Double] { Some(settings_sidebar_width()) }))
          .rigid()
          let _ = sb_outer.box(
            fn(sb : view::View) -> Unit {
              let _ = sb
              .width(view::Live::By(fn() -> Option[Double] { Some(settings_sidebar_width() - 1.0) }))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 {
                let _ = workspace_rev.get()
                let dark = is_dark_chrome()
                match proto::workspace_active_space(app_state.workspace) {
                  Some(sp) => space_sidebar_surface_themed(sp.accent, dark)
                  None => chrome_palette().sidebar_bg
                }
              }))
              .padding(view::Live::Is((10.0, 10.0, 10.0, 10.0)))
              .gap(view::Live::Is(8.0))
              // Top Space header row: left button opens Space Customizer, right `N tabs ▾` pill toggles inline Tab Filter
              let _ = sb.box(
                fn(sh_row : view::View) -> Unit {
                  let _ = sh_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .gap(view::Live::Is(4.0))
                  let _ = headless::button(
                    sh_row,
                    fn() -> String { "Customize Space Theme" },
                    fn(_v : view::View) -> Unit { toggle_space_theme() },
                    fn(sh : view::View, sh_btn : headless::Button) -> Unit {
                      let _ = sh
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(30.0)))
                      .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
                      .gap(view::Live::Is(6.0))
                      .radius(view::Live::Is(8.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        if space_theme_open.get() || sh_btn.pressed() {
                          0x00000010L
                        } else if sh_btn.hovered() {
                          0x00000008L
                        } else {
                          0x00000000L
                        }
                      }))
                      let _ = sh.box(
                        fn(dot : view::View) -> Unit {
                          let _ = dot
                          .width(view::Live::Is(Some(9.0)))
                          .height(view::Live::Is(Some(9.0)))
                          .rigid()
                          .radius(view::Live::Is(4.5))
                          .ground(view::Live::By(fn() -> Int64 {
                            let _ = workspace_rev.get()
                            match proto::workspace_active_space(app_state.workspace) {
                              Some(sp) => proto::workspace_accent_color(sp.accent)
                              None => 0x2563EBFFL
                            }
                          }))
                        },
                      )
                      let _ = sh.box(
                        fn(nm : view::View) -> Unit {
                          let _ = nm
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .clips(view::Live::Is(true))
                          .words(
                            view::Live::By(fn() -> String {
                              let _ = workspace_rev.get()
                              match proto::workspace_active_space(app_state.workspace) {
                                Some(sp) if sp.name != "" => sp.name
                                _ => app_state.space_name
                              }
                            }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )
                  let _ = headless::button(
                    sh_row,
                    fn() -> String { "Filter Sidebar Tabs" },
                    fn(_v : view::View) -> Unit { toggle_tab_filter() },
                    fn(fb : view::View, fbtn : headless::Button) -> Unit {
                      let _ = fb
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .height(view::Live::Is(Some(24.0)))
                      .rigid()
                      .padding(view::Live::Is((7.0, 0.0, 6.0, 0.0)))
                      .gap(view::Live::Is(4.0))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if tab_filter_open.get() {
                          p.accent_soft_bg
                        } else if fbtn.pressed() {
                          p.btn_press
                        } else if fbtn.hovered() {
                          p.btn_hover
                        } else {
                          0x00000000L
                        }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        let p = chrome_palette()
                        if tab_filter_open.get() {
                          (1.0, p.accent_soft_border)
                        } else {
                          (1.0, 0x00000000L)
                        }
                      }))
                      // Compact magnifying glass (lens + handle)
                      let _ = fb.box(
                        fn(icon_box : view::View) -> Unit {
                          let _ = icon_box
                          .width(view::Live::Is(Some(10.0)))
                          .height(view::Live::Is(Some(10.0)))
                          .rigid()
                          let _ = icon_box.box(
                            fn(lens : view::View) -> Unit {
                              let _ = lens
                              .over_at(view::Live::Is((Some(0.5), Some(0.5), None, None)))
                              .width(view::Live::Is(Some(7.0)))
                              .height(view::Live::Is(Some(7.0)))
                              .radius(view::Live::Is(3.5))
                              .edge(view::Live::By(fn() -> (Double, Int64) {
                                let p = chrome_palette()
                                if tab_filter_open.get() { (1.3, p.accent_soft_ink) } else { (1.2, p.ink_muted) }
                              }))
                            },
                          )
                          let _ = icon_box.box(
                            fn(handle : view::View) -> Unit {
                              let _ = handle
                              .over_at(view::Live::Is((Some(6.5), Some(6.5), None, None)))
                              .width(view::Live::Is(Some(3.0)))
                              .height(view::Live::Is(Some(3.0)))
                              .radius(view::Live::Is(1.0))
                              .ground(view::Live::By(fn() -> Int64 {
                                let p = chrome_palette()
                                if tab_filter_open.get() { p.accent_soft_ink } else { p.ink_muted }
                              }))
                            },
                          )
                        },
                      )
                      let _ = fb.box(
                        fn(cnt : view::View) -> Unit {
                          let _ = cnt
                          .rigid()
                          .words(
                            view::Live::By(fn() -> String {
                              let _ = workspace_rev.get()
                              let n = match proto::workspace_active_space(app_state.workspace) {
                                Some(sp) => sp.tab_count
                                None => 0
                              }
                              if n == 1 { "1 tab" } else { n.to_string() + " tabs" }
                            }),
                            ink=0x8E8E93FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if tab_filter_open.get() { p.accent_soft_ink } else { p.ink_muted }
                          }))
                        },
                      )
                      let _ = fb.box(
                        fn(chev : view::View) -> Unit {
                          let _ = chev
                          .rigid()
                          .words(
                            view::Live::By(fn() -> String {
                              if tab_filter_open.get() { "▴" } else { "▾" }
                            }),
                            ink=0x8E8E93FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if tab_filter_open.get() { p.accent_soft_ink } else { p.ink_muted }
                          }))
                        },
                      )
                    },
                  )
                },
              )
              // Inline Sidebar Live Tab Filter bar (mounted when toggled via header filter button or `Cmd/Ctrl+Shift+A`)
              build_sidebar_tab_filter_bar(
                sb,
                tab_filter_open,
                tab_filter_query,
                tab_filter_field,
                workspace_rev,
              )
              // Top Arc Favorites Glass Tile Grid (3x2 equal-width tiles, audio green dot, hover preview, right-click menu; 0px when empty)
              build_sidebar_favorites_grid(
                sb,
                workspace_rev,
                media_hub_rev,
                tab_ctx_open,
                tab_ctx_tab_id,
                tab_preview_tab_id,
              )
              // Tab row renderer helper (Pinned, Folder-Pinned & Today share crisp 34pt card geometry, zero alpha=0 hidden controls)
              let render_tab_row_by = fn(parent : view::View, get_tab : () -> Option[proto::TabSummary], row_w : Double) -> Unit {
                parent.show(
                  fn() -> Bool {
                    let _ = workspace_rev.get()
                    get_tab().is_some()
                  },
                  fn(wrap : view::View) -> Unit {
                    let label_fn = fn() -> String {
                      let _ = workspace_rev.get()
                      match get_tab() {
                        Some(tb) => proto::workspace_tab_display_title(tb)
                        None => ""
                      }
                    }
                    let is_act = fn() -> Bool {
                      let _ = workspace_rev.get()
                      match get_tab() {
                        Some(tb) => tb.active
                        None => false
                      }
                    }
                    let is_ctx_target = fn() -> Bool {
                      if !tab_ctx_open.get() {
                        return false
                      }
                      let target_id = tab_ctx_tab_id.get()
                      let _ = workspace_rev.get()
                      match get_tab() {
                        Some(tb) => tb.id == target_id
                        None => false
                      }
                    }
                    let is_in_split = fn() -> Bool {
                      if !split_open.get() {
                        return false
                      }
                      let _ = workspace_rev.get()
                      let sid = split_tab_id.get()
                      match get_tab() {
                        Some(tb) => {
                          if sid != "" && tb.id == sid {
                            true
                          } else {
                            match app_state.split_stage {
                              Some(sp_st) => {
                                let su = sp_st.url()
                                su != "" && tb.url != "" && su == tb.url && !tb.active
                              }
                              None => false
                            }
                          }
                        }
                        None => false
                      }
                    }
                    let has_audio = fn() -> Bool {
                      let _ = workspace_rev.get()
                      match (get_tab(), app_state.workspace.media) {
                        (Some(tb), Some(m)) => {
                          let matched = if m.tab_id != "" {
                            m.tab_id == tb.id
                          } else {
                            tb.active
                          }
                          matched && (m.playing || m.muted || m.is_meeting)
                        }
                        _ => false
                      }
                    }
                    let is_audio_muted = fn() -> Bool {
                      let _ = workspace_rev.get()
                      match app_state.workspace.media {
                        Some(m) => m.muted
                        None => false
                      }
                    }
                    let audio_accent = fn() -> Int64 {
                      let _ = workspace_rev.get()
                      match app_state.workspace.media {
                        Some(m) if m.accent != "" => proto::workspace_accent_color(m.accent)
                        _ => match proto::workspace_active_space(app_state.workspace) {
                          Some(sp) => proto::workspace_accent_color(sp.accent)
                          None => 0x2563EBFFL
                        }
                      }
                    }
                    let _ = wrap.box(
                      fn(row_card : view::View) -> Unit {
                        let show_actions = fn() -> Bool {
                          is_act() || row_card.pointed() || is_ctx_target()
                        }
                        let open_ctx_for_row = fn() -> Unit {
                          match get_tab() {
                            Some(tb) => {
                              let (_, ry, _, _) = row_card.placed_now()
                              open_tab_ctx(tb.id, if ry > 40.0 { ry } else { 140.0 })
                            }
                            None => ()
                          }
                        }
                        let _ = row_card
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .width(view::Live::Is(Some(row_w)))
                        .height(view::Live::Is(Some(34.0)))
                        .rigid()
                        .clips(view::Live::Is(true))
                        .radius(view::Live::Is(8.0))
                        .on_menu(fn(_m : view::Menu) -> Unit { open_ctx_for_row() })
                        row_card.reacts(
                          fn() -> Bool { row_card.pointed() },
                          fn(is_p : Bool) -> Unit {
                            if is_p {
                              match get_tab() {
                                Some(tb) => {
                                  let (_, ry, _, _) = row_card.placed_now()
                                  open_tab_hover_preview(tb.id, if ry > 40.0 { ry } else { 120.0 })
                                }
                                None => ()
                              }
                            } else if !app_state.tab_preview_pinned_demo {
                              let cur_id = tab_preview_tab_id.untracked()
                              match get_tab() {
                                Some(tb) if tb.id == cur_id => {
                                  let on_card = match app_state.tab_preview_card_view {
                                    Some(cv) => cv.pointed()
                                    None => false
                                  }
                                  if !on_card {
                                    close_tab_hover_preview()
                                  }
                                }
                                _ => ()
                              }
                            }
                          },
                        )
                        let _ = row_card
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_act() {
                            p.tab_active_bg
                          } else if is_ctx_target() {
                            p.accent_soft_bg
                          } else {
                            0x00000000L
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          let p = chrome_palette()
                          if is_act() {
                            (1.0, p.tab_active_border)
                          } else if is_ctx_target() {
                            (1.0, p.accent_soft_border)
                          } else {
                            (1.0, 0x00000000L)
                          }
                        }))
                        .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
                          if is_act() { (6.0, 2.0, 0x00000012L) } else { (0.0, 0.0, 0x00000000L) }
                        }))
                        let _ = headless::button(
                          row_card,
                          label_fn,
                          fn(_v : view::View) -> Unit {
                            match get_tab() {
                              Some(tb) => dispatch_tab_switch(tb.id)
                              None => ()
                            }
                          },
                          fn(b : view::View, btn : headless::Button) -> Unit {
                            let _ = b
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .height(view::Live::Is(Some(34.0)))
                            .clips(view::Live::Is(true))
                            .gap(view::Live::Is(8.0))
                            .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
                            .radius(view::Live::Is(8.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_act() || is_ctx_target() {
                                0x00000000L
                              } else if btn.pressed() {
                                p.tab_press_bg
                              } else if btn.hovered() {
                                p.tab_hover_bg
                              } else {
                                0x00000000L
                              }
                            }))
                            // Monogram tile (20x20, concentric radius 5)
                            let _ = b.box(
                              fn(ico : view::View) -> Unit {
                                let _ = ico
                                .width(view::Live::Is(Some(20.0)))
                                .height(view::Live::Is(Some(20.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_act() { p.accent_soft_bg } else { p.btn_bg }
                                }))
                                let _ = ico.box(
                                  fn(ch : view::View) -> Unit {
                                    let _ = ch
                                    .words(
                                      view::Live::By(fn() -> String {
                                        let _ = workspace_rev.get()
                                        match get_tab() {
                                          Some(tb) => proto::omnibox_initial_letter(tb.url, tb.title)
                                          None => ""
                                        }
                                      }),
                                      ink=0x4B5563FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if is_act() { p.accent } else { p.ink_secondary }
                                    }))
                                  },
                                )
                              },
                            )
                            // Single-line truncated title (bounded width, default ellipsis_past=false for true "…" ellipsis)
                            let _ = b.box(
                              fn(tw : view::View) -> Unit {
                                let title_w_act = row_w - 72.0
                                let title_w_idle = row_w - 44.0
                                let title_w_split_act = row_w - 110.0
                                let title_w_split_idle = row_w - 82.0
                                let calc_w = fn() -> Option[Double] {
                                  let base_w = if is_in_split() {
                                    if show_actions() { title_w_split_act } else { title_w_split_idle }
                                  } else if show_actions() {
                                    title_w_act
                                  } else {
                                    title_w_idle
                                  }
                                  let w = if has_audio() { base_w - 26.0 } else { base_w }
                                  Some(if w > 40.0 { w } else { 40.0 })
                                }
                                let _ = tw
                                .width(view::Live::By(calc_w))
                                .max_width(view::Live::By(calc_w))
                                .shrink(view::Live::Is(1.0))
                                .min_width(view::Live::Is(Some(0.0)))
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(label_fn),
                                  ink=0x2C3446FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_act() { p.ink_primary } else { p.ink_secondary }
                                }))
                              },
                            )
                            // Split View active-tab badge in sidebar (mounted only when tab is shown in Split pane)
                            b.show(
                              is_in_split,
                              fn(spb : view::View) -> Unit {
                                let _ = spb
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .height(view::Live::Is(Some(17.0)))
                                .rigid()
                                .padding(view::Live::Is((0.0, 5.0, 0.0, 5.0)))
                                .radius(view::Live::Is(4.5))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let _ = workspace_rev.get()
                                  let c = match proto::workspace_active_space(app_state.workspace) {
                                    Some(sp) => proto::workspace_accent_color(sp.accent)
                                    None => 0x2563EBFFL
                                  }
                                  (c & 0xFFFFFF00L) | 0x1EL
                                }))
                                let _ = spb.box(
                                  fn(sl : view::View) -> Unit {
                                    let _ = sl
                                    .words(
                                      view::Live::Is("Split"),
                                      ink=0x2563EBFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      let _ = workspace_rev.get()
                                      match proto::workspace_active_space(app_state.workspace) {
                                        Some(sp) => proto::workspace_accent_color(sp.accent)
                                        None => 0x2563EBFFL
                                      }
                                    }))
                                  },
                                )
                              },
                            )
                          },
                        )
                        // Live Audio / Mute one-click toggle badge (mounted only when tab has active audio/meeting; zero alpha=0 hidden controls)
                        row_card.show(
                          has_audio,
                          fn(aw : view::View) -> Unit {
                            let _ = aw.padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
                              if show_actions() { (0.0, 0.0, 2.0, 0.0) } else { (0.0, 0.0, 6.0, 0.0) }
                            })).rigid()
                            let _ = headless::button(
                              aw,
                              fn() -> String {
                                if is_audio_muted() { "Unmute Tab" } else { "Mute Tab" }
                              },
                              fn(_v : view::View) -> Unit { dispatch_media_mute_toggle() },
                              fn(ab : view::View, abtn : headless::Button) -> Unit {
                                let _ = ab
                                .width(view::Live::Is(Some(22.0)))
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  if is_audio_muted() {
                                    if abtn.pressed() {
                                      0xDFE3EEFFL
                                    } else if abtn.hovered() {
                                      0xE9ECF5FFL
                                    } else {
                                      0xF1F3F8FFL
                                    }
                                  } else {
                                    let c = audio_accent()
                                    if abtn.pressed() {
                                      (c & 0xFFFFFF00L) | 0x34L
                                    } else if abtn.hovered() {
                                      (c & 0xFFFFFF00L) | 0x28L
                                    } else {
                                      (c & 0xFFFFFF00L) | 0x1AL
                                    }
                                  }
                                }))
                                // Crisp geometric 3-bar audio waveform (playing) / flat muted bars
                                let _ = ab.box(
                                  fn(eq : view::View) -> Unit {
                                    let _ = eq
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::End)))
                                    .height(view::Live::Is(Some(11.0)))
                                    .gap(view::Live::Is(1.8))
                                    let bar_ink = fn() -> Int64 {
                                      if is_audio_muted() { 0x9CA3AFFFL } else { audio_accent() }
                                    }
                                    let _ = eq.box(
                                      fn(b1 : view::View) -> Unit {
                                        let _ = b1
                                        .width(view::Live::Is(Some(2.2)))
                                        .height(view::Live::By(fn() -> Option[Double] {
                                          Some(if is_audio_muted() { 3.0 } else { 6.0 })
                                        }))
                                        .rigid()
                                        .radius(view::Live::Is(1.1))
                                        .ground(view::Live::By(bar_ink))
                                      },
                                    )
                                    let _ = eq.box(
                                      fn(b2 : view::View) -> Unit {
                                        let _ = b2
                                        .width(view::Live::Is(Some(2.2)))
                                        .height(view::Live::By(fn() -> Option[Double] {
                                          Some(if is_audio_muted() { 3.0 } else { 10.5 })
                                        }))
                                        .rigid()
                                        .radius(view::Live::Is(1.1))
                                        .ground(view::Live::By(bar_ink))
                                      },
                                    )
                                    let _ = eq.box(
                                      fn(b3 : view::View) -> Unit {
                                        let _ = b3
                                        .width(view::Live::Is(Some(2.2)))
                                        .height(view::Live::By(fn() -> Option[Double] {
                                          Some(if is_audio_muted() { 3.0 } else { 7.5 })
                                        }))
                                        .rigid()
                                        .radius(view::Live::Is(1.1))
                                        .ground(view::Live::By(bar_ink))
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          },
                        )
                        // Quick Actions `⋯` trigger (mounted via show only when active/hovered/menu-open; zero alpha=0 hidden controls)
                        row_card.show(
                          show_actions,
                          fn(pw : view::View) -> Unit {
                            let _ = pw.padding(view::Live::Is((0.0, 0.0, 6.0, 0.0))).rigid()
                            let _ = headless::button(
                              pw,
                              fn() -> String { "Tab Actions" },
                              fn(_v : view::View) -> Unit { open_ctx_for_row() },
                              fn(pb : view::View, pbtn : headless::Button) -> Unit {
                                let _ = pb
                                .width(view::Live::Is(Some(22.0)))
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if pbtn.pressed() || is_ctx_target() {
                                    p.accent_soft_border
                                  } else if pbtn.hovered() {
                                    p.btn_hover
                                  } else {
                                    0x00000000L
                                  }
                                }))
                                // Crisp geometric 3-dot glyph
                                let _ = pb.box(
                                  fn(dots : view::View) -> Unit {
                                    let _ = dots
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .gap(view::Live::Is(2.2))
                                    let mut di = 0
                                    while di < 3 {
                                      let _ = dots.box(
                                        fn(dot : view::View) -> Unit {
                                          let _ = dot
                                          .width(view::Live::Is(Some(2.6)))
                                          .height(view::Live::Is(Some(2.6)))
                                          .rigid()
                                          .radius(view::Live::Is(1.3))
                                          .ground(view::Live::By(fn() -> Int64 {
                                            let p = chrome_palette()
                                            if is_ctx_target() { p.accent_soft_ink } else { p.ink_muted }
                                          }))
                                        },
                                      )
                                      di = di + 1
                                    }
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
              }
              let render_tab_row = fn(parent : view::View, is_pinned : Bool, slot_idx : Int) -> Unit {
                let get_tab = fn() -> Option[proto::TabSummary] {
                  let q = tab_filter_query.get()
                  let raw_list = if is_pinned {
                    proto::workspace_unfoldered_pinned_tabs(
                      app_state.workspace,
                      app_state.workspace.active_space_id,
                    )
                  } else {
                    proto::workspace_tabs_for_space(
                      app_state.workspace,
                      app_state.workspace.active_space_id,
                      false,
                    )
                  }
                  let list = proto::workspace_filter_tabs(raw_list, q)
                  if slot_idx < list.length() { Some(list[slot_idx]) } else { None }
                }
                render_tab_row_by(parent, get_tab, 223.0)
              }
              // Collapsible Pinned Folder renderer (chevron + geometric folder icon + name + count pill + indented child tabs)
              let render_folder_slot = fn(parent : view::View, f_idx : Int) -> Unit {
                let get_folder = fn() -> Option[proto::FolderSummary] {
                  let q = tab_filter_query.get()
                  let fls = proto::workspace_filtered_folders(
                    app_state.workspace,
                    app_state.workspace.active_space_id,
                    q,
                  )
                  if f_idx < fls.length() { Some(fls[f_idx]) } else { None }
                }
                parent.show(
                  fn() -> Bool {
                    let _ = workspace_rev.get()
                    get_folder().is_some()
                  },
                  fn(fwrap : view::View) -> Unit {
                    let _ = fwrap.gap(view::Live::Is(2.0))
                    let is_fctx_target = fn() -> Bool {
                      if !folder_ctx_open.get() {
                        return false
                      }
                      let fid = folder_ctx_id.get()
                      let _ = workspace_rev.get()
                      match get_folder() {
                        Some(fl) => fl.id == fid
                        None => false
                      }
                    }
                    let _ = fwrap.box(
                      fn(frow : view::View) -> Unit {
                        let show_factions = fn() -> Bool {
                          frow.pointed() || is_fctx_target()
                        }
                        let open_fctx = fn() -> Unit {
                          match get_folder() {
                            Some(fl) => {
                              let (_, fy, _, _) = frow.placed_now()
                              open_folder_ctx(fl.id, if fy > 40.0 { fy } else { 140.0 })
                            }
                            None => ()
                          }
                        }
                        let _ = frow
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .width(view::Live::Is(Some(223.0)))
                        .height(view::Live::Is(Some(32.0)))
                        .rigid()
                        .clips(view::Live::Is(true))
                        .radius(view::Live::Is(8.0))
                        .on_menu(fn(_m : view::Menu) -> Unit { open_fctx() })
                        .ground(view::Live::By(fn() -> Int64 {
                          if is_fctx_target() { chrome_palette().tab_active_bg } else { 0x00000000L }
                        }))
                        let _ = headless::button(
                          frow,
                          fn() -> String {
                            let _ = workspace_rev.get()
                            match get_folder() {
                              Some(fl) => fl.name
                              None => "Folder"
                            }
                          },
                          fn(_v : view::View) -> Unit {
                            match get_folder() {
                              Some(fl) => dispatch_folder_toggle(fl.id)
                              None => ()
                            }
                          },
                          fn(fb : view::View, fbtn : headless::Button) -> Unit {
                            let _ = fb
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .height(view::Live::Is(Some(32.0)))
                            .clips(view::Live::Is(true))
                            .gap(view::Live::Is(6.0))
                            .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                            .radius(view::Live::Is(8.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if fbtn.pressed() {
                                p.tab_press_bg
                              } else if fbtn.hovered() {
                                p.tab_hover_bg
                              } else {
                                0x00000000L
                              }
                            }))
                            // Disclosure chevron (`▸` collapsed / `▾` expanded)
                            let _ = fb.box(
                              fn(chev : view::View) -> Unit {
                                let _ = chev
                                .width(view::Live::Is(Some(12.0)))
                                .height(view::Live::Is(Some(16.0)))
                                .rigid()
                                .center()
                                .words(
                                  view::Live::By(fn() -> String {
                                    let _ = workspace_rev.get()
                                    let q = tab_filter_query.get().trim()
                                    match get_folder() {
                                      Some(fl) if fl.collapsed && q == "" => "▸"
                                      _ => "▾"
                                    }
                                  }),
                                  ink=0x6B7280FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                              },
                            )
                            // Semantic 6-color folder dot inside soft halo
                            let _ = fb.box(
                              fn(fdot_wrap : view::View) -> Unit {
                                let _ = fdot_wrap
                                .width(view::Live::Is(Some(16.0)))
                                .height(view::Live::Is(Some(16.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let _ = workspace_rev.get()
                                  let dark = is_dark_chrome()
                                  match get_folder() {
                                    Some(fl) => proto::folder_color_soft_bg(fl.color, dark)
                                    None => proto::folder_color_soft_bg("blue", dark)
                                  }
                                }))
                                let _ = fdot_wrap.box(
                                  fn(fdot : view::View) -> Unit {
                                    let _ = fdot
                                    .width(view::Live::Is(Some(8.0)))
                                    .height(view::Live::Is(Some(8.0)))
                                    .rigid()
                                    .radius(view::Live::Is(4.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      let _ = workspace_rev.get()
                                      match get_folder() {
                                        Some(fl) => proto::folder_color_rgba(fl.color)
                                        None => proto::folder_color_rgba("blue")
                                      }
                                    }))
                                  },
                                )
                              },
                            )
                            // Folder name (UTF-8 safe, single-line clipped)
                            let _ = fb.box(
                              fn(fnm : view::View) -> Unit {
                                let _ = fnm
                                .grow(view::Live::Is(1.0))
                                .shrink(view::Live::Is(1.0))
                                .basis(view::Live::Is(Some(0.0)))
                                .min_width(view::Live::Is(Some(0.0)))
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(fn() -> String {
                                    let _ = workspace_rev.get()
                                    match get_folder() {
                                      Some(fl) => fl.name
                                      None => ""
                                    }
                                  }),
                                  ink=0x2C3446FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                              },
                            )
                            // Child tab count pill (subtle tint when collapsed, neutral when expanded)
                            let _ = fb.box(
                              fn(cnt : view::View) -> Unit {
                                let _ = cnt
                                .height(view::Live::Is(Some(18.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                .radius(view::Live::Is(9.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let _ = workspace_rev.get()
                                  let dark = is_dark_chrome()
                                  match get_folder() {
                                    Some(fl) if fl.collapsed => proto::folder_color_soft_bg(fl.color, dark)
                                    _ => chrome_palette().btn_bg
                                  }
                                }))
                                let _ = cnt.box(
                                  fn(cl : view::View) -> Unit {
                                    let _ = cl.words(
                                      view::Live::By(fn() -> String {
                                        let _ = workspace_rev.get()
                                        match get_folder() {
                                          Some(fl) =>
                                          proto::folder_tab_count(
                                            app_state.workspace,
                                            app_state.workspace.active_space_id,
                                            fl.id,
                                          ).to_string()
                                          None => "0"
                                        }
                                      }),
                                      ink=0x5A6275FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      let _ = workspace_rev.get()
                                      match get_folder() {
                                        Some(fl) if fl.collapsed => proto::folder_color_rgba(fl.color)
                                        _ => chrome_palette().ink_muted
                                      }
                                    }))
                                  },
                                )
                              },
                            )
                          },
                        )
                        // Folder `⋯` button (only mounted on hover or menu open; zero alpha=0 hidden controls)
                        frow.show(
                          show_factions,
                          fn(fpw : view::View) -> Unit {
                            let _ = fpw.padding(view::Live::Is((0.0, 0.0, 4.0, 0.0))).rigid()
                            let _ = headless::button(
                              fpw,
                              fn() -> String { "Folder Actions" },
                              fn(_v : view::View) -> Unit { open_fctx() },
                              fn(fpb : view::View, fpbtn : headless::Button) -> Unit {
                                let _ = fpb
                                .width(view::Live::Is(Some(22.0)))
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  if fpbtn.pressed() || is_fctx_target() {
                                    0xDCE5FAFFL
                                  } else if fpbtn.hovered() {
                                    0xEDF1FAFFL
                                  } else {
                                    0x00000000L
                                  }
                                }))
                                let _ = fpb.box(
                                  fn(fdots : view::View) -> Unit {
                                    let _ = fdots
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .gap(view::Live::Is(2.2))
                                    let mut di = 0
                                    while di < 3 {
                                      let _ = fdots.box(
                                        fn(dot : view::View) -> Unit {
                                          let _ = dot
                                          .width(view::Live::Is(Some(2.6)))
                                          .height(view::Live::Is(Some(2.6)))
                                          .rigid()
                                          .radius(view::Live::Is(1.3))
                                          .ground(view::Live::Is(0x6B7280FFL))
                                        },
                                      )
                                      di = di + 1
                                    }
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                    // Expanded folder children (indented with crisp 1px guide rail; auto-expanded when inline filter is active)
                    fwrap.show(
                      fn() -> Bool {
                        let _ = workspace_rev.get()
                        let q = tab_filter_query.get().trim()
                        match get_folder() {
                          Some(fl) => !fl.collapsed || q != ""
                          None => false
                        }
                      },
                      fn(fchildren : view::View) -> Unit {
                        let _ = fchildren
                        .row(view::Live::Is(true))
                        .padding(view::Live::Is((10.0, 0.0, 0.0, 0.0)))
                        .gap(view::Live::Is(6.0))
                        let _ = fchildren.box(
                          fn(rail : view::View) -> Unit {
                            let _ = rail
                            .width(view::Live::Is(Some(1.0)))
                            .rigid()
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
                          },
                        )
                        let _ = fchildren.box(
                          fn(flist : view::View) -> Unit {
                            let _ = flist.gap(view::Live::Is(2.0))
                            let mut cti = 0
                            while cti < 6 {
                              let child_slot = cti
                              let get_child_tab = fn() -> Option[proto::TabSummary] {
                                let q = tab_filter_query.get()
                                match get_folder() {
                                  Some(fl) => {
                                    let raw = proto::workspace_tabs_in_folder(
                                      app_state.workspace,
                                      app_state.workspace.active_space_id,
                                      fl.id,
                                    )
                                    let list = proto::workspace_filter_tabs(raw, q)
                                    if child_slot < list.length() { Some(list[child_slot]) } else { None }
                                  }
                                  None => None
                                }
                              }
                              render_tab_row_by(flist, get_child_tab, 206.0)
                              cti = cti + 1
                            }
                            flist.show(
                              fn() -> Bool {
                                let _ = workspace_rev.get()
                                match get_folder() {
                                  Some(fl) =>
                                  proto::workspace_tabs_in_folder(
                                    app_state.workspace,
                                    app_state.workspace.active_space_id,
                                    fl.id,
                                  ).length() == 0
                                  None => false
                                }
                              },
                              fn(emp : view::View) -> Unit {
                                let _ = emp
                                .padding(view::Live::Is((8.0, 4.0, 8.0, 4.0)))
                                .words(
                                  view::Live::Is("Empty folder"),
                                  ink=0x9CA3AFFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                  one_line=true,
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
              }
              // Scrollable/flexible middle area holding Pinned + Today
              let _ = sb.box(
                fn(mid : view::View) -> Unit {
                  let _ = mid
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .gap(view::Live::Is(10.0))
                  // Pinned section (mounted when current Space has matching pinned tabs/folders or inline creator is open)
                  mid.show(
                    fn() -> Bool {
                      let _ = workspace_rev.get()
                      let sid = app_state.workspace.active_space_id
                      let q = tab_filter_query.get()
                      folder_create_open.get() ||
                      proto::workspace_filter_tabs(
                        proto::workspace_unfoldered_pinned_tabs(app_state.workspace, sid),
                        q,
                      ).length() > 0 ||
                      proto::workspace_filtered_folders(app_state.workspace, sid, q).length() > 0
                    },
                    fn(psec : view::View) -> Unit {
                      let _ = psec.gap(view::Live::Is(3.0))
                      let _ = psec.box(
                        fn(phdr : view::View) -> Unit {
                          let _ = phdr
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .height(view::Live::Is(Some(22.0)))
                          .rigid()
                          .padding(view::Live::Is((6.0, 0.0, 2.0, 0.0)))
                          .gap(view::Live::Is(6.0))
                          let _ = phdr.box(
                            fn(pl : view::View) -> Unit {
                              let _ = pl
                              .grow(view::Live::Is(1.0))
                              .words(
                                view::Live::Is("PINNED"),
                                ink=0x8E8E93FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                            },
                          )
                          let _ = headless::button(
                            phdr,
                            fn() -> String { "New Tab Folder" },
                            fn(_v : view::View) -> Unit { toggle_folder_create_bar() },
                            fn(fb : view::View, fbtn : headless::Button) -> Unit {
                              let _ = fb
                              .height(view::Live::Is(Some(20.0)))
                              .rigid()
                              .center()
                              .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                              .radius(view::Live::Is(5.0))
                              .ground(view::Live::By(fn() -> Int64 {
                                let p = chrome_palette()
                                if fbtn.pressed() {
                                  p.tab_press_bg
                                } else if fbtn.hovered() || folder_create_open.get() {
                                  p.tab_hover_bg
                                } else {
                                  0x00000000L
                                }
                              }))
                              let _ = fb.box(
                                fn(fl : view::View) -> Unit {
                                  let _ = fl.words(
                                    view::Live::Is("+ Folder"),
                                    ink=0x6B7280FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                    one_line=true,
                                  )
                                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                },
                              )
                            },
                          )
                        },
                      )
                      build_inline_folder_creator(
                        psec,
                        folder_create_open,
                        folder_create_color,
                        folder_create_move_active,
                        folder_create_field,
                      )
                      let mut fi = 0
                      while fi < 6 {
                        render_folder_slot(psec, fi)
                        fi = fi + 1
                      }
                      let mut pi = 0
                      while pi < 6 {
                        render_tab_row(psec, true, pi)
                        pi = pi + 1
                      }
                    },
                  )
                  // Today section (+ New Tab button + Today tabs; hidden while filtering if 0 Today matches)
                  mid.show(
                    fn() -> Bool {
                      let _ = workspace_rev.get()
                      let q = tab_filter_query.get().trim()
                      if q == "" {
                        true
                      } else {
                        proto::workspace_filter_tabs(
                          proto::workspace_tabs_for_space(
                            app_state.workspace,
                            app_state.workspace.active_space_id,
                            false,
                          ),
                          q,
                        ).length() > 0
                      }
                    },
                    fn(tsec : view::View) -> Unit {
                      let _ = tsec.gap(view::Live::Is(3.0))
                      let _ = tsec.box(
                        fn(thdr : view::View) -> Unit {
                          let _ = thdr
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .height(view::Live::Is(Some(22.0)))
                          .rigid()
                          .padding(view::Live::Is((6.0, 0.0, 2.0, 0.0)))
                          .gap(view::Live::Is(6.0))
                          let _ = thdr.box(
                            fn(tl : view::View) -> Unit {
                              let _ = tl
                              .grow(view::Live::Is(1.0))
                              .words(
                                view::Live::Is("TODAY"),
                                ink=0x8E8E93FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                one_line=true,
                              )
                            },
                          )
                          // Arc Sweep Clear button (mounted only when current Space has > 1 Today tab; never alpha=0)
                          thdr.show(
                            fn() -> Bool {
                              let _ = workspace_rev.get()
                              proto::workspace_tabs_for_space(
                                app_state.workspace,
                                app_state.workspace.active_space_id,
                                false,
                              ).length() > 1
                            },
                            fn(cw : view::View) -> Unit {
                              let _ = headless::button(
                                cw,
                                fn() -> String { "Clear Today Tabs" },
                                fn(_v : view::View) -> Unit { dispatch_today_clear() },
                                fn(b : view::View, btn : headless::Button) -> Unit {
                                  let _ = b
                                  .height(view::Live::Is(Some(20.0)))
                                  .rigid()
                                  .center()
                                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                  .radius(view::Live::Is(5.0))
                                  .ground(view::Live::By(fn() -> Int64 {
                                    if btn.pressed() {
                                      0xDFE3EEFFL
                                    } else if btn.hovered() {
                                      0xEAEDF5FFL
                                    } else {
                                      0x00000000L
                                    }
                                  }))
                                  let _ = b.box(
                                    fn(cl : view::View) -> Unit {
                                      let _ = cl.words(
                                        view::Live::Is("Clear"),
                                        ink=0x6B7280FFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                        one_line=true,
                                      )
                                    },
                                  )
                                },
                              )
                            },
                          )
                        },
                      )
                      // + New Tab button
                      let _ = headless::button(
                        tsec,
                        fn() -> String { "New Tab" },
                        fn(_v : view::View) -> Unit { dispatch_tab_new("", "") },
                        fn(b : view::View, btn : headless::Button) -> Unit {
                          let _ = b
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .height(view::Live::Is(Some(32.0)))
                          .rigid()
                          .gap(view::Live::Is(8.0))
                          .padding(view::Live::Is((0.0, 8.0, 0.0, 8.0)))
                          .radius(view::Live::Is(8.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            if btn.pressed() {
                              0xDDE2EEFFL
                            } else if btn.hovered() {
                              0xECEEF5FFL
                            } else {
                              0x00000000L
                            }
                          }))
                          let _ = b.box(
                            fn(plus : view::View) -> Unit {
                              let _ = plus
                              .width(view::Live::Is(Some(20.0)))
                              .height(view::Live::Is(Some(20.0)))
                              .rigid()
                              .center()
                              .words(
                                view::Live::Is("+"),
                                ink=0x6B7280FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                                one_line=true,
                              )
                            },
                          )
                          let _ = b.box(
                            fn(lbl : view::View) -> Unit {
                              let _ = lbl.words(
                                view::Live::Is("New Tab"),
                                ink=0x5A6275FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                one_line=true,
                              )
                            },
                          )
                        },
                      )
                      let mut ti = 0
                      while ti < 12 {
                        render_tab_row(tsec, false, ti)
                        ti = ti + 1
                      }
                    },
                  )
                  // Clean empty-state card when inline sidebar tab filter has 0 matches
                  build_sidebar_tab_filter_empty(mid, tab_filter_query, workspace_rev)
                },
              )
              // Live Media / Meet Mini-Player card (mounted only when workspace.media is Some)
              // Upgraded Arc Sidebar Mini-Player Card (Light & Dark Chrome, MiniPlayerState)
              build_shell_dock_mini_player(sb, media_hub_rev, workspace_rev, mini_player_rev)
              // Bottom Space switcher bar (single subtle hairline above, no double divider)
              let _ = sb.box(
                fn(sep : view::View) -> Unit {
                  let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )
              let _ = sb.box(
                fn(sbar : view::View) -> Unit {
                  let _ = sbar
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .rigid()
                  .gap(view::Live::Is(4.0))
                  .padding(view::Live::Is((2.0, 0.0, 0.0, 0.0)))
                  let mut si = 0
                  while si < 4 {
                    let sidx = si
                    sbar.show(
                      fn() -> Bool {
                        let _ = workspace_rev.get()
                        sidx < app_state.workspace.spaces.length()
                      },
                      fn(sw : view::View) -> Unit {
                        let sp_label = fn() -> String {
                          let _ = workspace_rev.get()
                          let list = app_state.workspace.spaces
                          if sidx < list.length() { list[sidx].name } else { "" }
                        }
                        let _ = headless::button(
                          sw,
                          sp_label,
                          fn(_v : view::View) -> Unit {
                            let list = app_state.workspace.spaces
                            if sidx < list.length() {
                              dispatch_space_switch(list[sidx].id)
                            }
                          },
                          fn(b : view::View, btn : headless::Button) -> Unit {
                            let is_sp_act = fn() -> Bool {
                              let _ = workspace_rev.get()
                              let list = app_state.workspace.spaces
                              sidx < list.length() && list[sidx].active
                            }
                            let _ = b
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .height(view::Live::Is(Some(28.0)))
                            .rigid()
                            .gap(view::Live::Is(5.0))
                            .padding(view::Live::Is((0.0, 7.0, 0.0, 6.0)))
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_sp_act() {
                                p.tab_active_bg
                              } else if btn.pressed() {
                                p.tab_press_bg
                              } else if btn.hovered() {
                                p.tab_hover_bg
                              } else {
                                0x00000000L
                              }
                            }))
                            .edge(view::Live::By(fn() -> (Double, Int64) {
                              if is_sp_act() { (1.0, chrome_palette().tab_active_border) } else { (1.0, 0x00000000L) }
                            }))
                            let _ = b.box(
                              fn(dot : view::View) -> Unit {
                                let _ = dot
                                .width(view::Live::Is(Some(7.0)))
                                .height(view::Live::Is(Some(7.0)))
                                .rigid()
                                .radius(view::Live::Is(3.5))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let _ = workspace_rev.get()
                                  let list = app_state.workspace.spaces
                                  if sidx < list.length() {
                                    proto::workspace_accent_color(list[sidx].accent)
                                  } else {
                                    0x2563EBFFL
                                  }
                                }))
                              },
                            )
                            let _ = b.box(
                              fn(lbl : view::View) -> Unit {
                                let _ = lbl
                                .max_width(view::Live::Is(Some(52.0)))
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(sp_label),
                                  ink=0x5A6275FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_sp_act() { p.ink_primary } else { p.ink_muted }
                                }))
                              },
                            )
                          },
                        )
                      },
                    )
                    si = si + 1
                  }
                  // Flexible spacer so Sessions & `+` New Space micro-buttons anchor cleanly at the right edge
                  let _ = sbar.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                  let _ = headless::button(
                    sbar,
                    fn() -> String { "Saved Sessions" },
                    fn(_v : view::View) -> Unit { open_sessions_modal() },
                    fn(b : view::View, btn : headless::Button) -> Unit {
                      let _ = b
                      .height(view::Live::Is(Some(28.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if btn.pressed() {
                          p.tab_press_bg
                        } else if btn.hovered() {
                          p.tab_hover_bg
                        } else {
                          0x00000000L
                        }
                      }))
                      let _ = b.box(
                        fn(sl : view::View) -> Unit {
                          let _ = sl
                          .words(
                            view::Live::Is("Sessions"),
                            ink=0x5A6275FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )
                  let _ = headless::button(
                    sbar,
                    fn() -> String { "Manage & Create Spaces" },
                    fn(_v : view::View) -> Unit {
                      open_spaces_manager(focus_new=true)
                    },
                    fn(b : view::View, btn : headless::Button) -> Unit {
                      let _ = b
                      .width(view::Live::Is(Some(26.0)))
                      .height(view::Live::Is(Some(28.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if btn.pressed() {
                          p.tab_press_bg
                        } else if btn.hovered() {
                          p.tab_hover_bg
                        } else {
                          0x00000000L
                        }
                      }))
                      let _ = b.box(
                        fn(pl : view::View) -> Unit {
                          let _ = pl
                          .words(
                            view::Live::Is("+"),
                            ink=0x5A6275FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                    },
                  )
                },
              )
            },
          )
          // Single 1px right separator hairline (no double divider)
          let _ = sb_outer.box(
            fn(rline : view::View) -> Unit {
              let _ = rline.width(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
        },
      )
      // Main webpage stage container: vertical stack of [Webpage Stage / Split View] + [Docked DevTools Drawer]
      let _ = body.box(
        fn(content_col : view::View) -> Unit {
          let _ = content_col
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          // Arc Split View ultra-thin 28pt top focus & quick-switch micro-toolbar
          build_split_focus_bar(
            content_col,
            st,
            split_open,
            split_active_pane,
            split_swapped,
            workspace_rev,
          )
          let _ = content_col.box(
            fn(content_wrap : view::View) -> Unit {
              app_state.split_container_view = Some(content_wrap)
              let _ = content_wrap
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))
              // Single-pane mode (100% backwards compatible)
              content_wrap.show(
                fn() -> Bool { !split_open.get() },
                fn(single_wrap : view::View) -> Unit {
                  let _ = single_wrap
                  .row(view::Live::Is(true))
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(0.0)))
                  let sv = stage::stage_node(
                    single_wrap,
                    st,
                    on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(st, hit) }),
                  )
                  let _ = sv.min_width(view::Live::Is(Some(0.0)))
                  app_state.stage_view = Some(sv)
                  // Shift+Click on any webpage link opens it directly in Arc Peek without losing scroll position
                  let _ = single_wrap.box(
                    fn(sh_ov : view::View) -> Unit {
                      let _ = sh_ov
                      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
                      .presses(view::Live::By(fn() -> Bool {
                        shift_held.get() && st.hover_url() != ""
                      }))
                      .cursor(view::Live::By(fn() -> Option[view::Cursor] {
                        if shift_held.get() && st.hover_url() != "" {
                          Some(view::Cursor::Hand)
                        } else {
                          None
                        }
                      }))
                      .on_press(fn() -> Unit {
                        let u = st.hover_url()
                        if u != "" {
                          open_peek_preview(u, app_state.workspace.active_tab_id)
                        }
                      })
                    },
                  )
                },
              )
              // Arc Split View mode (dual isolated Stage + dual pion-host, extracted to split_find_history_view.pion)
              build_split_view(
                content_wrap,
                st,
                sidebar_open,
                workspace_rev,
                split_open,
                split_ratio,
                split_active_pane,
                split_swapped,
                split_dragging,
              )
              build_start_page_view(
                content_wrap,
                st,
                split_open,
                reader_open,
                workspace_rev,
                bookmarks_rev,
                history_rev,
                settings_rev,
                start_page_field,
              )
              build_reader_mode_view(
                content_wrap,
                reader_open,
                reader_rev,
                reader_theme,
                reader_font,
                reader_font_size,
                reader_width_mode,
                reader_progress,
              )
              build_find_bar_overlay(
                content_wrap,
                find_open,
                find_field,
                find_case_sensitive,
                host_find_synced,
                host_find_active,
                host_find_total,
                split_open,
              )
            },
          )
          build_devtools_drawer(
            content_col,
            devtools_open,
            devtools_height,
            devtools_dragging,
            devtools_tab,
            devtools_rev,
            devtools_selected_path,
            devtools_console_filter,
            devtools_repl_field,
            devtools_net_filter,
            devtools_net_query,
            devtools_net_search_field,
            devtools_net_selected_idx,
            workspace_rev,
          )
        },
      )
    },
  )
  // Chrome / Arc rich-categorized Omnibox smart suggestions dropdown (shell_dock_view.pion)
  build_omni_suggest_overlay(root, address, omnibox_open, omnibox_selected, omnibox_rev)
  // Global Media Hub Popover (Light & Dark Chrome, per-session Play/Pause/Mute + Mute all)
  build_media_hub_popover(
    root,
    media_hub_open,
    media_hub_rev,
    workspace_rev,
  )
  // Upgraded Site Security & Storage Inspector Popover (Light & Dark Chrome, IDN verification + Cookies/Zoom + 5 permissions + Reset/Clear)
  build_site_info_popover(
    root,
    st,
    site_info_open,
    workspace_rev,
    site_perms_rev,
    boosts_rev,
    cookies_rev,
  )
  // IDN Spoofing Explanation Popover (Light & Dark Chrome, anchored under address bar)
  build_idna_spoof_popover(root, idn_popover_open)
  build_downloads_popover(root, downloads_open, downloads_rev, downloads_field, downloads_cat)
  // Arc Space Theme Customizer Popover (224pt card, radius 12pt, anchored right beside sidebar Space header)
  root.show(
    fn() -> Bool { space_theme_open.get() },
    fn(spop : view::View) -> Unit {
      let _ = spop
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        let top = match app_state.address_bar_view {
          Some(ab) => {
            let (_, ay, _, ah) = ab.placed_now()
            if ah > 10.0 { ay + ah + 8.0 } else { 52.0 }
          }
          None => 52.0
        }
        let left = if sidebar_open.get() { 250.0 } else { 12.0 }
        (Some(left), Some(top), None, None)
      }))
      .width(view::Live::Is(Some(224.0)))
      .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
      .gap(view::Live::Is(10.0))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::Is(0xFFFFFFFFL))
      .edge(view::Live::Is((1.0, 0xDCDCE2FFL)))
      .shadow(view::Live::Is((22.0, 8.0, 0x0F172A24L)))
      // Header: Space title + close glyph
      let _ = spop.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .width(view::Live::Is(Some(200.0)))
          .height(view::Live::Is(Some(22.0)))
          .rigid()
          .gap(view::Live::Is(6.0))
          let _ = hdr.box(
            fn(ht : view::View) -> Unit {
              let _ = ht
              .grow(view::Live::Is(1.0))
              .words(
                view::Live::Is("Customize Space"),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                one_line=true,
              )
            },
          )
          let _ = headless::button(
            hdr,
            fn() -> String { "Close Space Customizer" },
            fn(_v : view::View) -> Unit { close_space_theme() },
            fn(xb : view::View, xbtn : headless::Button) -> Unit {
              let _ = xb
              .width(view::Live::Is(Some(20.0)))
              .height(view::Live::Is(Some(20.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if xbtn.pressed() {
                  0xE5E7EBFFL
                } else if xbtn.hovered() {
                  0xF3F4F6FFL
                } else {
                  0x00000000L
                }
              }))
              let _ = xb.box(
                fn(xl : view::View) -> Unit {
                  let _ = xl.words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
        },
      )
      // Space Name Rename Field (`SpaceNameField`, Enter submits `space_rename`)
      let _ = spop.box(
        fn(nf_wrap : view::View) -> Unit {
          let _ = nf_wrap
          .width(view::Live::Is(Some(200.0)))
          .height(view::Live::Is(Some(32.0)))
          .rigid()
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .radius(view::Live::Is(8.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::Is(0xF5F6FAFFL))
          .edge(view::Live::Is((1.0, 0xD8DCE8FFL)))
          let _ = nf_wrap.box(
            fn(nfi : view::View) -> Unit {
              let _ = nfi
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(24.0)))
              .clips(view::Live::Is(true))
              let _ = ui::field(
                nfi,
                space_name_field,
                placeholder="Space name...",
                font_size=13.0,
                max_lines=1,
                enter_sends=true,
                submitted=fn(t : String) -> Unit {
                  let sid = match proto::workspace_active_space(app_state.workspace) {
                    Some(sp) => sp.id
                    None => app_state.workspace.active_space_id
                  }
                  dispatch_space_rename(sid, t)
                },
              )
            },
          )
        },
      )
      // 6-color Arc Space theme palette (24x24 swatches with crisp double-ring selected indicator)
      let _ = spop.box(
        fn(pal_sec : view::View) -> Unit {
          let _ = pal_sec.width(view::Live::Is(Some(200.0))).rigid().gap(view::Live::Is(6.0))
          let _ = pal_sec.box(
            fn(pl : view::View) -> Unit {
              let _ = pl.words(
                view::Live::Is("Theme Color"),
                ink=0x6B7280FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                one_line=true,
              )
            },
          )
          let _ = pal_sec.box(
            fn(sw_row : view::View) -> Unit {
              let _ = sw_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::Is(Some(28.0)))
              .rigid()
              .gap(view::Live::Is(6.0))
              let palette = proto::workspace_space_palette()
              let mut ci = 0
              while ci < palette.length() {
                let hex = palette[ci]
                let rgba = proto::workspace_accent_color(hex)
                let is_sel = fn() -> Bool {
                  let _ = workspace_rev.get()
                  match proto::workspace_active_space(app_state.workspace) {
                    Some(sp) => proto::normalize_space_accent(sp.accent) == hex
                    None => hex == "#2563EB"
                  }
                }
                let _ = headless::button(
                  sw_row,
                  fn() -> String { "Space color " + hex },
                  fn(_v : view::View) -> Unit {
                    let sid = match proto::workspace_active_space(app_state.workspace) {
                      Some(sp) => sp.id
                      None => app_state.workspace.active_space_id
                    }
                    dispatch_space_color(sid, hex)
                  },
                  fn(sw : view::View, sw_btn : headless::Button) -> Unit {
                    let _ = sw
                    .width(view::Live::Is(Some(28.0)))
                    .height(view::Live::Is(Some(28.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(14.0))
                    .ground(view::Live::Is(0xFFFFFFFFL))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      if is_sel() {
                        (2.0, rgba)
                      } else if sw_btn.hovered() {
                        (1.5, 0xCBD5E1FFL)
                      } else {
                        (0.0, 0x00000000L)
                      }
                    }))
                    let _ = sw.box(
                      fn(inner : view::View) -> Unit {
                        let _ = inner
                        .width(view::Live::By(fn() -> Option[Double] {
                          if is_sel() { Some(20.0) } else { Some(24.0) }
                        }))
                        .height(view::Live::By(fn() -> Option[Double] {
                          if is_sel() { Some(20.0) } else { Some(24.0) }
                        }))
                        .rigid()
                        .radius(view::Live::By(fn() -> Double {
                          if is_sel() { 10.0 } else { 12.0 }
                        }))
                        .ground(view::Live::Is(rgba))
                      },
                    )
                  },
                )
                ci = ci + 1
              }
            },
          )
        },
      )
      // Conditional "Delete Space" danger action (mounted ONLY when spaces.length() > 1, never alpha=0)
      spop.show(
        fn() -> Bool {
          let _ = workspace_rev.get()
          app_state.workspace.spaces.length() > 1
        },
        fn(del_sec : view::View) -> Unit {
          let _ = del_sec.width(view::Live::Is(Some(200.0))).rigid().gap(view::Live::Is(8.0))
          let _ = del_sec.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::Is(0xECEEF4FFL))
            },
          )
          let _ = headless::button(
            del_sec,
            fn() -> String { "Delete Space" },
            fn(_v : view::View) -> Unit {
              let sid = match proto::workspace_active_space(app_state.workspace) {
                Some(sp) => sp.id
                None => app_state.workspace.active_space_id
              }
              close_space_theme()
              dispatch_space_delete(sid)
            },
            fn(db : view::View, dbtn : headless::Button) -> Unit {
              let _ = db
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::Is(Some(30.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 {
                if dbtn.pressed() {
                  0xFECACAFFL
                } else if dbtn.hovered() {
                  0xFEE2E2FFL
                } else {
                  0xFEF2F2FFL
                }
              }))
              .edge(view::Live::Is((1.0, 0xFECACAFFL)))
              let _ = db.box(
                fn(dl : view::View) -> Unit {
                  let _ = dl.words(
                    view::Live::Is("Delete Space"),
                    ink=0xDC2626FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
        },
      )
    },
  )
  // Arc Encrypted Browsing History Drawer (Cmd/Ctrl+Y, extracted to split_find_history_view.pion)
  build_history_drawer(root, st, history_open, history_rev, history_field)
  // Arc Bookmarks Drawer (Cmd/Ctrl+Shift+B, 460pt centered panel, concentric 12pt -> 8pt -> 6pt)
  root.show(
    fn() -> Bool { bookmarks_open.get() },
    fn(bm_layer : view::View) -> Unit {
      let _ = bm_layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      let _ = headless::button(
        bm_layer,
        fn() -> String { "Dismiss Bookmarks" },
        fn(_v : view::View) -> Unit { close_bookmarks() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x0F172A30L))
        },
      )
      let is_macos_bm = ui::keys_system() <= 0
      let get_filtered_bms = fn() -> Array[proto::BookmarkEntry] {
        let _ = bookmarks_rev.get()
        let q = bookmarks_query.get()
        proto::bookmarks_filter(app_state.bookmarks_snap, q)
      }
      let _ = bm_layer.box(
        fn(bpop : view::View) -> Unit {
          let _ = bpop
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let rw = match app_state.root_view {
              Some(rv) => {
                let (w0, _) = rv.laid_size()
                w0
              }
              None => 1280.0
            }
            let left = if rw > 492.0 { (rw - 460.0) / 2.0 } else { 16.0 }
            (Some(left), Some(64.0), None, None)
          }))
          .width(view::Live::Is(Some(460.0)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(12.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (28.0, 12.0, 0x00000077L) } else { (28.0, 12.0, 0x0F172A32L) }
          }))
          bpop.reacts(fn() -> String { bookmarks_field.text() }, fn(q : String) -> Unit {
            if bookmarks_open.untracked() {
              bookmarks_query.set(q)
            }
          })
          // Header row: Star badge + "Bookmarks" + saved count pill + "Bookmark current page" button
          let _ = bpop.box(
            fn(bhdr : view::View) -> Unit {
              let _ = bhdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(436.0)))
              .height(view::Live::Is(Some(28.0)))
              .rigid()
              .gap(view::Live::Is(8.0))
              .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
              let _ = bhdr.box(
                fn(bico : view::View) -> Unit {
                  let _ = bico
                  .width(view::Live::Is(Some(22.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_dark_chrome() { 0x362A14FFL } else { 0xFEF3C7FFL }
                  }))
                  let _ = bico.box(
                    fn(bs : view::View) -> Unit {
                      let _ = bs.words(
                        view::Live::Is("★"),
                        ink=0xD97706FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0xFBBF24FFL } else { 0xD97706FFL }
                      }))
                    },
                  )
                },
              )
              let _ = bhdr.box(
                fn(bt : view::View) -> Unit {
                  let _ = bt.rigid().words(
                    view::Live::Is("Bookmarks"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.5, weight: 600, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              let _ = bhdr.box(
                fn(bcnt_pill : view::View) -> Unit {
                  let _ = bcnt_pill
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_dark_chrome() { 0x362A14FFL } else { 0xFEF3C7FFL }
                  }))
                  let _ = bcnt_pill.box(
                    fn(bcnt : view::View) -> Unit {
                      let _ = bcnt.words(
                        view::Live::By(fn() -> String {
                          let _ = bookmarks_rev.get()
                          let n = app_state.bookmarks_snap.items.length()
                          if n == 1 { "1 saved" } else { n.to_string() + " saved" }
                        }),
                        ink=0xB45309FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0xFCD34DFFL } else { 0xB45309FFL }
                      }))
                    },
                  )
                },
              )
              let _ = bhdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
              let _ = headless::button(
                bhdr,
                fn() -> String { "Bookmark current page" },
                fn(_v : view::View) -> Unit { dispatch_bookmark_toggle() },
                fn(ab : view::View, abtn : headless::Button) -> Unit {
                  let cur_saved = fn() -> Bool {
                    let _ = bookmarks_rev.get()
                    proto::bookmarks_contains_url(app_state.bookmarks_snap, active_stage_live().url())
                  }
                  let _ = ab
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if cur_saved() {
                      if p.is_dark {
                        if abtn.pressed() { 0x523E19FFL } else if abtn.hovered() { 0x453415FFL } else { 0x362A14FFL }
                      } else if abtn.pressed() {
                        0xFCD34DFFL
                      } else if abtn.hovered() {
                        0xFDE68AFFL
                      } else {
                        0xFEF3C7FFL
                      }
                    } else if abtn.pressed() {
                      0x1D4ED8FFL
                    } else if abtn.hovered() {
                      0x2563EBFFL
                    } else {
                      p.accent_soft_bg
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if cur_saved() {
                      (1.0, if p.is_dark { 0x6B4F1DFFL } else { 0xFCD34DFFL })
                    } else {
                      (1.0, p.accent_soft_border)
                    }
                  }))
                  let _ = ab.box(
                    fn(al : view::View) -> Unit {
                      let _ = al
                      .words(
                        view::Live::By(fn() -> String {
                          if cur_saved() { "★ Bookmarked" } else { "Bookmark current page" }
                        }),
                        ink=0x1D4ED8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if cur_saved() {
                          if p.is_dark { 0xFCD34DFFL } else { 0xB45309FFL }
                        } else if abtn.hovered() || abtn.pressed() {
                          0xFFFFFFFFL
                        } else {
                          p.accent_soft_ink
                        }
                      }))
                    },
                  )
                },
              )
            },
          )
          // Single-line Search input (registered in is_chrome_field_focused, radius 8pt)
          let _ = bpop.box(
            fn(bs_row : view::View) -> Unit {
              let _ = bs_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(436.0)))
              .height(view::Live::Is(Some(36.0)))
              .rigid()
              .gap(view::Live::Is(8.0))
              .padding(view::Live::Is((12.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(8.0))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = bs_row.box(
                fn(bfw : view::View) -> Unit {
                  let _ = bfw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .clips(view::Live::Is(true))
                  bfw.show(
                    fn() -> Bool { !is_dark_chrome() },
                    fn(fl : view::View) -> Unit {
                      let _ = ui::field(
                        fl,
                        bookmarks_field,
                        placeholder="Search bookmarks...",
                        font_size=13.0,
                        color=0x1D1D1FFFL,
                        placeholder_color=0x8E8E93FFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(_t : String) -> Unit {
                          let list = get_filtered_bms()
                          if list.length() > 0 {
                            let u = list[0].url
                            close_bookmarks()
                            if u != "" {
                              active_stage().go(u)
                            }
                          }
                        },
                      )
                    },
                  )
                  bfw.show(
                    fn() -> Bool { is_dark_chrome() },
                    fn(fd : view::View) -> Unit {
                      let _ = ui::field(
                        fd,
                        bookmarks_field,
                        placeholder="Search bookmarks...",
                        font_size=13.0,
                        color=0xF1F5F9FFL,
                        placeholder_color=0x94A3B8FFL,
                        caret_color=0x60A5FAFFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(_t : String) -> Unit {
                          let list = get_filtered_bms()
                          if list.length() > 0 {
                            let u = list[0].url
                            close_bookmarks()
                            if u != "" {
                              active_stage().go(u)
                            }
                          }
                        },
                      )
                    },
                  )
                },
              )
              let _ = bs_row.box(
                fn(bk : view::View) -> Unit {
                  let _ = bk
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  let _ = bk.box(
                    fn(bkl : view::View) -> Unit {
                      let _ = bkl.words(
                        view::Live::Is(if is_macos_bm { "⇧⌘B" } else { "Ctrl+Shift+B" }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )
          // Empty state (clean centered rounded card, zero dangling dividers)
          bpop.show(
            fn() -> Bool { get_filtered_bms().length() == 0 },
            fn(emp : view::View) -> Unit {
              let _ = emp
              .width(view::Live::Is(Some(436.0)))
              .height(view::Live::Is(Some(76.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              let _ = emp.box(
                fn(et : view::View) -> Unit {
                  let _ = et.words(
                    view::Live::By(fn() -> String {
                      if bookmarks_query.get().trim() != "" {
                        "No matching bookmarks"
                      } else {
                        "No bookmarks saved yet — press ⌘D to bookmark this page"
                      }
                    }),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
          // Up to 8 Bookmark rows (sibling click-to-open area + always-visible inline Delete button, zero alpha=0 click-through)
          let mut bslot = 0
          while bslot < proto::BOOKMARKS_MAX_ITEMS {
            let bidx = bslot
            bpop.show(
              fn() -> Bool { bidx < get_filtered_bms().length() },
              fn(brow_wrap : view::View) -> Unit {
                let get_b = fn() -> Option[proto::BookmarkEntry] {
                  let list = get_filtered_bms()
                  if bidx < list.length() { Some(list[bidx]) } else { None }
                }
                let _ = brow_wrap.box(
                  fn(brow : view::View) -> Unit {
                    let _ = brow
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .width(view::Live::Is(Some(436.0)))
                    .height(view::Live::Is(Some(46.0)))
                    .rigid()
                    .clips(view::Live::Is(true))
                    .gap(view::Live::Is(6.0))
                    .padding(view::Live::Is((4.0, 0.0, 6.0, 0.0)))
                    .radius(view::Live::Is(8.0))
                    .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                    // Clickable main area: star badge + title/host + optional folder pill
                    let _ = headless::button(
                      brow,
                      fn() -> String {
                        match get_b() {
                          Some(it) => it.title
                          None => ""
                        }
                      },
                      fn(_v : view::View) -> Unit {
                        match get_b() {
                          Some(it) => {
                            close_bookmarks()
                            if it.url != "" {
                              active_stage().go(it.url)
                            }
                          }
                          None => ()
                        }
                      },
                      fn(bmain : view::View, bbtn : headless::Button) -> Unit {
                        let _ = bmain
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .height(view::Live::Is(Some(38.0)))
                        .clips(view::Live::Is(true))
                        .gap(view::Live::Is(10.0))
                        .padding(view::Live::Is((4.0, 0.0, 6.0, 0.0)))
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if bbtn.pressed() {
                            p.tab_press_bg
                          } else if bbtn.hovered() {
                            p.tab_hover_bg
                          } else {
                            0x00000000L
                          }
                        }))
                        // Left warm gold star tile (24x24, radius 6pt)
                        let _ = bmain.box(
                          fn(sico : view::View) -> Unit {
                            let _ = sico
                            .width(view::Live::Is(Some(24.0)))
                            .height(view::Live::Is(Some(24.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              if is_dark_chrome() { 0x362A14FFL } else { 0xFEF3C7FFL }
                            }))
                            let _ = sico.box(
                              fn(sl : view::View) -> Unit {
                                let _ = sl.words(
                                  view::Live::Is("★"),
                                  ink=0xD97706FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                  one_line=true,
                                ).ink(view::Live::By(fn() -> Int64 {
                                  if is_dark_chrome() { 0xFBBF24FFL } else { 0xD97706FFL }
                                }))
                              },
                            )
                          },
                        )
                        // Center column: title + display host/URL
                        let _ = bmain.box(
                          fn(bmid : view::View) -> Unit {
                            let _ = bmid
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .clips(view::Live::Is(true))
                            .gap(view::Live::Is(1.0))
                            let _ = bmid.box(
                              fn(btitle : view::View) -> Unit {
                                let _ = btitle
                                .min_width(view::Live::Is(Some(0.0)))
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_b() {
                                      Some(it) => it.title
                                      None => ""
                                    }
                                  }),
                                  ink=0x1D1D1FFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                                  one_line=true,
                                ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                              },
                            )
                            let _ = bmid.box(
                              fn(burl : view::View) -> Unit {
                                let _ = burl
                                .min_width(view::Live::Is(Some(0.0)))
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_b() {
                                      Some(it) => proto::omnibox_display_host(it.url)
                                      None => ""
                                    }
                                  }),
                                  ink=0x6B7280FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                  one_line=true,
                                ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                              },
                            )
                          },
                        )
                        // Optional folder pill
                        bmain.show(
                          fn() -> Bool {
                            match get_b() {
                              Some(it) => it.folder.trim() != ""
                              None => false
                            }
                          },
                          fn(fp : view::View) -> Unit {
                            let _ = fp
                            .height(view::Live::Is(Some(20.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                            .radius(view::Live::Is(5.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                            let _ = fp.box(
                              fn(fl : view::View) -> Unit {
                                let _ = fl.words(
                                  view::Live::By(fn() -> String {
                                    match get_b() {
                                      Some(it) => it.folder
                                      None => ""
                                    }
                                  }),
                                  ink=0x4B5563FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                  one_line=true,
                                ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                              },
                            )
                          },
                        )
                      },
                    )
                    // Sibling always-visible inline Delete button (no alpha=0 click-through)
                    let _ = headless::button(
                      brow,
                      fn() -> String { "Remove Bookmark" },
                      fn(_v : view::View) -> Unit {
                        match get_b() {
                          Some(it) => dispatch_bookmark_delete(if it.id != "" { it.id } else { it.url })
                          None => ()
                        }
                      },
                      fn(db : view::View, dbtn : headless::Button) -> Unit {
                        let _ = db
                        .width(view::Live::Is(Some(24.0)))
                        .height(view::Live::Is(Some(24.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if dbtn.pressed() {
                            p.danger_border
                          } else if dbtn.hovered() {
                            p.danger_bg
                          } else {
                            p.btn_bg
                          }
                        }))
                        let _ = db.box(
                          fn(dl : view::View) -> Unit {
                            let _ = dl
                            .words(
                              view::Live::Is("×"),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              if dbtn.hovered() || dbtn.pressed() { 0xDC2626FFL } else { 0x6B7280FFL }
                            }))
                          },
                        )
                      },
                    )
                  },
                )
              },
            )
            bslot = bslot + 1
          }
          // Subtle footer count & shortcut hint
          let _ = bpop.box(
            fn(bftr : view::View) -> Unit {
              let _ = bftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(436.0)))
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
              .gap(view::Live::Is(8.0))
              let _ = bftr.box(
                fn(fl : view::View) -> Unit {
                  let _ = fl
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::By(fn() -> String {
                      let _ = bookmarks_rev.get()
                      let total = app_state.bookmarks_snap.items.length()
                      let shown = get_filtered_bms().length()
                      if shown == total {
                        if total == 1 { "1 bookmark" } else { total.to_string() + " bookmarks" }
                      } else {
                        "Showing " + shown.to_string() + " of " + total.to_string() + " bookmarks"
                      }
                    }),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = bftr.box(
                fn(fr : view::View) -> Unit {
                  let _ = fr.rigid().words(
                    view::Live::Is(if is_macos_bm { "⌘D Toggle   Esc Close" } else { "Ctrl+D Toggle   Esc Close" }),
                    ink=0xAEAEB2FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
        },
      )
    },
  )
  // Arc Command Bar (Cmd/Ctrl+K centered 560pt modal; highest Z-order above Omnibox/SiteInfo/Downloads)
  root.show(
    fn() -> Bool { command_bar_open.get() },
    fn(cb_layer : view::View) -> Unit {
      app_state.command_bar_row_views.clear()
      let _ = cb_layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      // Translucent dark backdrop; clicking outside modal dismisses Command Bar
      let _ = headless::button(
        cb_layer,
        fn() -> String { "Dismiss Command Bar" },
        fn(_v : view::View) -> Unit { close_command_bar() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x0F172A48L))
        },
      )
      // Top-centered 560pt modal card (concentric radius ladder: 14pt outer -> 8pt rows -> 6pt badges/keycaps)
      let _ = cb_layer.box(
        fn(panel : view::View) -> Unit {
          let _ = panel
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let rw = match app_state.root_view {
              Some(rv) => {
                let (w0, _) = rv.laid_size()
                w0
              }
              None => 1280.0
            }
            let left = if rw > 592.0 { (rw - 560.0) / 2.0 } else { 16.0 }
            (Some(left), Some(88.0), None, None)
          }))
          .width(view::Live::Is(Some(560.0)))
          .radius(view::Live::Is(14.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::Is((28.0, 12.0, 0x0F172A38L)))
          panel.reacts(fn() -> String { command_bar_field.text() }, fn(q : String) -> Unit {
            if command_bar_open.untracked() {
              refresh_command_bar_items(q)
              if app_state.command_bar_items.length() > 0 {
                command_bar_selected.set(0)
              }
            }
          })
          // Top input row (`CommandBarField` key context for Up/Down/Escape)
          let _ = panel.box(
            fn(in_row : view::View) -> Unit {
              let _ = in_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(52.0)))
              .rigid()
              .gap(view::Live::Is(10.0))
              .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
              .key_context("CommandBarField")
              .on_action("commandbar.down", fn(_a : view::ActionAt) -> Bool { step_command_bar_selection(1) })
              .on_action("commandbar.up", fn(_a : view::ActionAt) -> Bool { step_command_bar_selection(-1) })
              .on_action("commandbar.escape", fn(_a : view::ActionAt) -> Bool {
                close_command_bar()
                true
              })
              // Left command glyph badge (24x24, concentric radius 6)
              let _ = in_row.box(
                fn(ico : view::View) -> Unit {
                  let _ = ico
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                  let _ = ico.box(
                    fn(gl : view::View) -> Unit {
                      let _ = gl.words(
                        view::Live::Is("⌘"),
                        ink=0x2563EBFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )
              // Single-line Command Bar input field
              let _ = in_row.box(
                fn(fw : view::View) -> Unit {
                  let _ = fw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(26.0)))
                  .clips(view::Live::Is(true))
                  .padding(view::Live::Is((0.0, 2.0, 0.0, 2.0)))
                  fw.show(
                    fn() -> Bool { !is_dark_chrome() },
                    fn(fl : view::View) -> Unit {
                      let _ = ui::field(
                        fl,
                        command_bar_field,
                        placeholder="Type a URL, tab, space, or command...",
                        font_size=15.0,
                        color=0x1D1D1FFFL,
                        placeholder_color=0x8E8E93FFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(t : String) -> Unit { submit_command_bar(st, t) },
                      )
                    },
                  )
                  fw.show(
                    fn() -> Bool { is_dark_chrome() },
                    fn(fd : view::View) -> Unit {
                      let _ = ui::field(
                        fd,
                        command_bar_field,
                        placeholder="Type a URL, tab, space, or command...",
                        font_size=15.0,
                        color=0xF1F5F9FFL,
                        placeholder_color=0x94A3B8FFL,
                        caret_color=0x60A5FAFFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(t : String) -> Unit { submit_command_bar(st, t) },
                      )
                    },
                  )
                },
              )
              // Right ESC keycap hint
              let _ = in_row.box(
                fn(esc : view::View) -> Unit {
                  let _ = esc
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = esc.box(
                    fn(el : view::View) -> Unit {
                      let _ = el.words(
                        view::Live::Is("ESC"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )
          // Single hairline divider before results list (only mounted when items exist)
          panel.show(
            fn() -> Bool {
              let _ = command_bar_rev.get()
              app_state.command_bar_items.length() > 0
            },
            fn(sep : view::View) -> Unit {
              let _ = sep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
          // Up to 7 filtered result rows (concentric R_inner = 14 - 6 = 8pt)
          let _ = panel.box(
            fn(list_box : view::View) -> Unit {
              let _ = list_box
              .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
              .gap(view::Live::Is(2.0))
              let mut cslot = 0
              while cslot < proto::COMMAND_BAR_MAX_ITEMS {
                let cidx = cslot
                list_box.show(
                  fn() -> Bool {
                    let _ = command_bar_rev.get()
                    cidx < app_state.command_bar_items.length()
                  },
                  fn(rwrap : view::View) -> Unit {
                    let get_item = fn() -> Option[proto::CommandBarItem] {
                      let _ = command_bar_rev.get()
                      let list = app_state.command_bar_items
                      if cidx < list.length() { Some(list[cidx]) } else { None }
                    }
                    let title_fn = fn() -> String {
                      match get_item() {
                        Some(it) => it.title
                        None => ""
                      }
                    }
                    let _ = headless::button(
                      rwrap,
                      title_fn,
                      fn(_v : view::View) -> Unit {
                        let list = app_state.command_bar_items
                        if cidx < list.length() {
                          execute_command_bar_item(st, list[cidx])
                        }
                      },
                      fn(b : view::View, btn : headless::Button) -> Unit {
                        app_state.command_bar_row_views.push(b)
                        let is_sel = fn() -> Bool { command_bar_selected.get() == cidx }
                        let _ = b
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .height(view::Live::Is(Some(42.0)))
                        .rigid()
                        .clips(view::Live::Is(true))
                        .gap(view::Live::Is(10.0))
                        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                        .radius(view::Live::Is(8.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if btn.pressed() {
                            p.tab_press_bg
                          } else if is_sel() {
                            p.accent_soft_bg
                          } else if btn.hovered() {
                            p.tab_hover_bg
                          } else {
                            0x00000000L
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          let p = chrome_palette()
                          if is_sel() { (1.0, p.accent_soft_border) } else { (1.0, 0x00000000L) }
                        }))
                        // Left 24x24 icon tile (concentric radius 6)
                        let _ = b.box(
                          fn(ico : view::View) -> Unit {
                            let _ = ico
                            .width(view::Live::Is(Some(24.0)))
                            .height(view::Live::Is(Some(24.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_sel() { p.btn_active_bg } else { p.surface_subtle }
                            }))
                            ico.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(it) => it.is_space && it.monogram == ""
                                  None => false
                                }
                              },
                              fn(dot : view::View) -> Unit {
                                let _ = dot
                                .width(view::Live::Is(Some(9.0)))
                                .height(view::Live::Is(Some(9.0)))
                                .rigid()
                                .radius(view::Live::Is(4.5))
                                .ground(view::Live::By(fn() -> Int64 {
                                  match get_item() {
                                    Some(it) if it.accent != 0L => it.accent
                                    _ => 0x2563EBFFL
                                  }
                                }))
                              },
                            )
                            ico.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(it) => !(it.is_space && it.monogram == "")
                                  None => false
                                }
                              },
                              fn(ch : view::View) -> Unit {
                                let _ = ch
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(it) => it.monogram
                                      None => ""
                                    }
                                  }),
                                  ink=0x4B5563FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_sel() { p.accent_soft_ink } else { p.ink_secondary }
                                }))
                              },
                            )
                          },
                        )
                        // Primary title (flex-bounded single line, default ellipsis_past=false for true "…" ellipsis)
                        let _ = b.box(
                          fn(tw : view::View) -> Unit {
                            let _ = tw
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(title_fn),
                              ink=0x1D1D1FFFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_sel() { p.accent_soft_ink } else { p.ink_primary }
                            }))
                          },
                        )
                        // Right metadata: muted subtitle + Space/Category badge + Switch pill + Shortcut keycap
                        let _ = b.box(
                          fn(meta : view::View) -> Unit {
                            let _ = meta
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .rigid()
                            .gap(view::Live::Is(6.0))
                            meta.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(it) => it.subtitle != ""
                                  None => false
                                }
                              },
                              fn(sub : view::View) -> Unit {
                                let _ = sub
                                .max_width(view::Live::Is(Some(148.0)))
                                .clips(view::Live::Is(true))
                                .padding(view::Live::Is((0.0, 1.0, 0.0, 0.0)))
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(it) => it.subtitle
                                      None => ""
                                    }
                                  }),
                                  ink=0x86868BFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_sel() { p.accent } else { p.ink_muted }
                                }))
                              },
                            )
                            // Space / Category badge (radius 6)
                            meta.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(it) => it.badge != ""
                                  None => false
                                }
                              },
                              fn(bdg : view::View) -> Unit {
                                let _ = bdg
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .gap(view::Live::Is(5.0))
                                .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_sel() { p.btn_active_bg } else { p.btn_bg }
                                }))
                                bdg.show(
                                  fn() -> Bool {
                                    match get_item() {
                                      Some(it) => it.is_tab && it.accent != 0L
                                      None => false
                                    }
                                  },
                                  fn(sdot : view::View) -> Unit {
                                    let _ = sdot
                                    .width(view::Live::Is(Some(6.0)))
                                    .height(view::Live::Is(Some(6.0)))
                                    .rigid()
                                    .radius(view::Live::Is(3.0))
                                    .ground(view::Live::By(fn() -> Int64 {
                                      match get_item() {
                                        Some(it) => it.accent
                                        None => 0x2563EBFFL
                                      }
                                    }))
                                  },
                                )
                                let _ = bdg.box(
                                  fn(bl : view::View) -> Unit {
                                    let _ = bl
                                    .max_width(view::Live::Is(Some(72.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(it) => it.badge
                                          None => ""
                                        }
                                      }),
                                      ink=0x5A6275FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if is_sel() { p.accent_soft_ink } else { p.ink_secondary }
                                    }))
                                  },
                                )
                              },
                            )
                            // Green Switch pill for Open Tabs (radius 6)
                            meta.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(it) => it.is_tab
                                  None => false
                                }
                              },
                              fn(swp : view::View) -> Unit {
                                let _ = swp
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  if is_dark_chrome() { 0x102E23FFL } else { 0xE6F4EAFFL }
                                }))
                                let _ = swp.box(
                                  fn(swl : view::View) -> Unit {
                                    let _ = swl.words(
                                      view::Live::Is("Switch"),
                                      ink=0x1E7E34FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                      one_line=true,
                                    ).ink(view::Live::By(fn() -> Int64 {
                                      if is_dark_chrome() { 0x34D399FFL } else { 0x1E7E34FFL }
                                    }))
                                  },
                                )
                              },
                            )
                            // Shortcut keycap badge (radius 6)
                            meta.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(it) => it.shortcut != ""
                                  None => false
                                }
                              },
                              fn(sc : view::View) -> Unit {
                                let _ = sc
                                .height(view::Live::Is(Some(22.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_sel() { p.btn_active_bg } else { p.btn_bg }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) {
                                  let p = chrome_palette()
                                  if is_sel() { (1.0, p.accent_soft_border) } else { (1.0, p.border) }
                                }))
                                let _ = sc.box(
                                  fn(scl : view::View) -> Unit {
                                    let _ = scl
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(it) => it.shortcut
                                          None => ""
                                        }
                                      }),
                                      ink=0x5A6275FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      let p = chrome_palette()
                                      if is_sel() { p.accent_soft_ink } else { p.ink_secondary }
                                    }))
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
                cslot = cslot + 1
              }
            },
          )
          // Subtle footer bar (single hairline divider above)
          let _ = panel.box(
            fn(fsep : view::View) -> Unit {
              let _ = fsep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
          let _ = panel.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(30.0)))
              .rigid()
              .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              let _ = ftr.box(
                fn(fl : view::View) -> Unit {
                  let _ = fl
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("↑↓ Navigate    ↵ Run    Esc Close"),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
              let _ = ftr.box(
                fn(fr : view::View) -> Unit {
                  let _ = fr.words(
                    view::Live::By(fn() -> String {
                      let _ = workspace_rev.get()
                      let c = app_state.workspace.closed_count
                      if c > 0 {
                        c.to_string() + " closed tab" + (if c == 1 { "" } else { "s" }) + " ready to reopen"
                      } else {
                        "Arc Command Bar"
                      }
                    }),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )
    },
  )
  // Live Page Performance & Security HUD Overlay (mounted BEFORE context menus & popovers)
  build_perf_hud_overlay(root, perf_hud_open, perf_hud_rev, workspace_rev)
  // Arc Sidebar Tab Hover Preview Card (mounted BEFORE context menus & modals so menus always sit above it)
  build_tab_hover_preview(
    root,
    tab_preview_open,
    tab_preview_tab_id,
    tab_preview_y,
    sidebar_open,
    workspace_rev,
    media_hub_rev,
    reader_open,
    boosts_rev,
  )
  // Upgraded Arc Tab Context Menu + Bookmarks Bar Context Menu + Omnibox Zoom Control Popover (Light & Dark ChromePalette)
  build_tab_context_menu(
    root,
    tab_ctx_open,
    tab_ctx_tab_id,
    tab_ctx_y,
    sidebar_open,
    workspace_rev,
    st,
  )
  build_bookmark_bar_context_menu(
    root,
    bm_bar_ctx_open,
    bm_bar_ctx_id,
    bm_bar_ctx_url,
    bm_bar_ctx_x,
  )
  build_zoom_popover(root, zoom_popover_open)
  // Arc Spaces Manager + Recently Closed Tabs Picker + Native Cmd+P Export PDF Dialog
  build_spaces_manager_modal(
    root,
    spaces_manager_open,
    workspace_rev,
    spaces_new_field,
    spaces_new_accent,
    spaces_edit_id,
    spaces_rename_field,
    spaces_color_edit_id,
  )
  build_closed_tabs_modal(root, closed_tabs_open, closed_tabs_rev, closed_tabs_field)
  build_print_pdf_modal(
    root,
    print_pdf_open,
    print_paper,
    print_orientation,
    print_margins,
    print_bg_graphics,
  )
  // Cross-Space Global Tab Search (`Cmd+Shift+A`) + Native Screenshot Saved Capture Sheet (`Cmd+Shift+S`)
  build_tab_search_overlay(
    root,
    tab_search_open,
    tab_search_query,
    tab_search_selected,
    tab_search_field,
    workspace_rev,
    closed_tabs_rev,
  )
  build_capture_sheet_overlay(root, capture_sheet_open, capture_sheet_rev)
  // Arc Folder Context Popover (Rename + Delete Folder keeping tabs in Pinned)
  root.show(
    fn() -> Bool { folder_ctx_open.get() },
    fn(fc_layer : view::View) -> Unit {
      let _ = fc_layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      let _ = headless::button(
        fc_layer,
        fn() -> String { "Dismiss Folder Menu" },
        fn(_v : view::View) -> Unit { close_folder_ctx() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x00000000L))
        },
      )
      let _ = fc_layer.box(
        fn(fpop : view::View) -> Unit {
          let _ = fpop
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let left = if sidebar_open.get() { 250.0 } else { 14.0 }
            let top = folder_ctx_y.get()
            (Some(left), Some(top), None, None)
          }))
          .width(view::Live::Is(Some(224.0)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .radius(view::Live::Is(12.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (24.0, 8.0, 0x00000066L) } else { (22.0, 8.0, 0x0F172A24L) }
          }))
          let _ = fpop.box(
            fn(fhdr : view::View) -> Unit {
              let _ = fhdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::Is(Some(20.0)))
              .rigid()
              let _ = fhdr.box(
                fn(ft : view::View) -> Unit {
                  let _ = ft
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("Folder Settings"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              let _ = headless::button(
                fhdr,
                fn() -> String { "Close Folder Settings" },
                fn(_v : view::View) -> Unit { close_folder_ctx() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(20.0)))
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl.words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )
          // Rename input + Save
          let _ = fpop.box(
            fn(rn : view::View) -> Unit {
              let _ = rn
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(200.0)))
              .gap(view::Live::Is(6.0))
              let _ = rn.box(
                fn(fi_wrap : view::View) -> Unit {
                  let _ = fi_wrap
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(30.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .clips(view::Live::Is(true))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = fi_wrap.box(
                    fn(fii : view::View) -> Unit {
                      let _ = fii
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(22.0)))
                      .clips(view::Live::Is(true))
                      fii.show(
                        fn() -> Bool { !is_dark_chrome() },
                        fn(fl : view::View) -> Unit {
                          let _ = ui::field(
                            fl,
                            folder_name_field,
                            placeholder="Folder name",
                            font_size=12.5,
                            color=0x1D1D1FFFL,
                            placeholder_color=0x8E8E93FFL,
                            max_lines=1,
                            enter_sends=true,
                            submitted=fn(txt : String) -> Unit {
                              let fid = folder_ctx_id.untracked()
                              close_folder_ctx()
                              dispatch_folder_rename(fid, txt)
                            },
                          )
                        },
                      )
                      fii.show(
                        fn() -> Bool { is_dark_chrome() },
                        fn(fd : view::View) -> Unit {
                          let _ = ui::field(
                            fd,
                            folder_name_field,
                            placeholder="Folder name",
                            font_size=12.5,
                            color=0xF1F5F9FFL,
                            placeholder_color=0x94A3B8FFL,
                            caret_color=0x60A5FAFFL,
                            max_lines=1,
                            enter_sends=true,
                            submitted=fn(txt : String) -> Unit {
                              let fid = folder_ctx_id.untracked()
                              close_folder_ctx()
                              dispatch_folder_rename(fid, txt)
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
              let _ = headless::button(
                rn,
                fn() -> String { "Save Folder Name" },
                fn(_v : view::View) -> Unit {
                  let fid = folder_ctx_id.untracked()
                  let txt = folder_name_field.text()
                  close_folder_ctx()
                  dispatch_folder_rename(fid, txt)
                },
                fn(sb : view::View, sbtn : headless::Button) -> Unit {
                  let _ = sb
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if sbtn.pressed() { 0x1D4ED8FFL } else if sbtn.hovered() { 0x2563EBFFL } else { 0x3B82F6FFL }
                  }))
                  let _ = sb.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl.words(
                        view::Live::Is("Save"),
                        ink=0xFFFFFFFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                },
              )
            },
          )
          // 6-color folder dot picker
          let _ = fpop.box(
            fn(fcols : view::View) -> Unit {
              let _ = fcols
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(200.0)))
              .gap(view::Live::Is(8.0))
              let keys = proto::folder_color_keys()
              let mut ci = 0
              while ci < keys.length() {
                let ck = keys[ci]
                let rgba = proto::folder_color_rgba(ck)
                let _ = headless::button(
                  fcols,
                  fn() -> String { "Set Folder Color " + proto::folder_color_label(ck) },
                  fn(_v : view::View) -> Unit {
                    let fid = folder_ctx_id.untracked()
                    dispatch_folder_color(fid, ck)
                  },
                  fn(cb : view::View, _cbtn : headless::Button) -> Unit {
                    let _ = cb
                    .width(view::Live::Is(Some(20.0)))
                    .height(view::Live::Is(Some(20.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(10.0))
                    let _ = cb.box(
                      fn(dot : view::View) -> Unit {
                        let _ = dot
                        .width(view::Live::Is(Some(12.0)))
                        .height(view::Live::Is(Some(12.0)))
                        .rigid()
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::Is(rgba))
                      },
                    )
                  },
                )
                ci = ci + 1
              }
            },
          )
          let _ = fpop.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
          let _ = headless::button(
            fpop,
            fn() -> String { "Delete Folder" },
            fn(_v : view::View) -> Unit {
              let fid = folder_ctx_id.untracked()
              close_folder_ctx()
              dispatch_folder_delete(fid)
            },
            fn(db : view::View, dbtn : headless::Button) -> Unit {
              let _ = db
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::Is(Some(30.0)))
              .rigid()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if dbtn.pressed() { p.danger_border } else if dbtn.hovered() { p.danger_bg } else { 0x00000000L }
              }))
              let _ = db.box(
                fn(dl : view::View) -> Unit {
                  let _ = dl
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("Delete Folder"),
                    ink=0xDC2626FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                },
              )
              let _ = db.box(
                fn(dh : view::View) -> Unit {
                  let _ = dh.rigid().words(
                    view::Live::Is("Keep tabs"),
                    ink=0x9CA3AFFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )
    },
  )
  build_shortcuts_modal(root, shortcuts_open)
  build_sessions_modal(
    root,
    sessions_open,
    sessions_rev,
    sessions_name_field,
    sessions_filter_field,
    sessions_filter_query,
    workspace_rev,
  )
  build_cookies_modal(root, cookies_open, cookies_rev, cookies_field)
  build_boosts_overlay(root, boosts_open, boosts_rev, boosts_css_field, workspace_rev)
  build_settings_modal(root, settings_open, settings_tab, settings_rev, clear_hist, clear_dl, clear_boosts)
  // Arc Classic MRU Tab Switcher Modal (`Ctrl+Tab` / `Ctrl+Shift+Tab`, 480pt wide, concentric 14pt outer / 6pt pad / 8pt row)
  root.show(
    fn() -> Bool { mru_open.get() },
    fn(mru_layer : view::View) -> Unit {
      let _ = mru_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()
      // Dimmed backdrop (click closes switcher)
      let _ = headless::button(
        mru_layer,
        fn() -> String { "Close Quick Tab Switcher" },
        fn(_v : view::View) -> Unit { close_mru_switcher() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x0F172A3DL))
        },
      )
      let is_macos_mru = ui::keys_system() <= 0
      let _ = mru_layer.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(480.0)))
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(14.0))
          .ground(view::Live::Is(0xFFFFFFFFL))
          .edge(view::Live::Is((1.0, 0xDCDCE2FFL)))
          .shadow(view::Live::Is((28.0, 12.0, 0x0F172A34L)))
          // Header
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(480.0)))
              .height(view::Live::Is(Some(44.0)))
              .rigid()
              .padding(view::Live::Is((16.0, 0.0, 14.0, 0.0)))
              .gap(view::Live::Is(8.0))
              let _ = hdr.box(
                fn(ht : view::View) -> Unit {
                  let _ = ht
                  .rigid()
                  .words(
                    view::Live::Is("Quick Tab Switch"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
              // Active Space badge
              let _ = hdr.box(
                fn(sp_pill : view::View) -> Unit {
                  let _ = sp_pill
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .gap(view::Live::Is(5.0))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::Is(0xF3F5FAFFL))
                  let _ = sp_pill.box(
                    fn(sdot : view::View) -> Unit {
                      let _ = sdot
                      .width(view::Live::Is(Some(6.5)))
                      .height(view::Live::Is(Some(6.5)))
                      .rigid()
                      .radius(view::Live::Is(3.25))
                      .ground(view::Live::By(fn() -> Int64 {
                        let _ = workspace_rev.get()
                        match proto::workspace_active_space(app_state.workspace) {
                          Some(sp) => proto::workspace_accent_color(sp.accent)
                          None => 0x2563EBFFL
                        }
                      }))
                    },
                  )
                  let _ = sp_pill.box(
                    fn(snm : view::View) -> Unit {
                      let _ = snm.words(
                        view::Live::By(fn() -> String {
                          let _ = workspace_rev.get()
                          match proto::workspace_active_space(app_state.workspace) {
                            Some(sp) if sp.name != "" => sp.name
                            _ => app_state.space_name
                          }
                        }),
                        ink=0x4B5563FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                },
              )
              let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
              let _ = hdr.box(
                fn(hk : view::View) -> Unit {
                  let _ = hk
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::Is(0xF3F4F6FFL))
                  .edge(view::Live::Is((1.0, 0xE2E5EEFFL)))
                  let _ = hk.box(
                    fn(hl : view::View) -> Unit {
                      let _ = hl.words(
                        view::Live::Is(if is_macos_mru { "⌃⇥" } else { "Ctrl+Tab" }),
                        ink=0x5A6275FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                },
              )
            },
          )
          // Single hairline divider
          let _ = card.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .width(view::Live::Is(Some(480.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::Is(0xECEEF4FFL))
            },
          )
          // MRU Tab list (padding 6pt -> concentric 14 - 6 = 8pt row radius)
          let _ = card.box(
            fn(list_box : view::View) -> Unit {
              let _ = list_box
              .width(view::Live::Is(Some(480.0)))
              .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
              .gap(view::Live::Is(2.0))
              let mut mi = 0
              while mi < 8 {
                let row_idx = mi
                let get_item = fn() -> Option[proto::TabSummary] {
                  let _ = mru_rev.get()
                  if row_idx < app_state.mru_items.length() {
                    Some(app_state.mru_items[row_idx])
                  } else {
                    None
                  }
                }
                list_box.show(
                  fn() -> Bool { get_item().is_some() },
                  fn(rw : view::View) -> Unit {
                    let is_sel = fn() -> Bool { mru_selected.get() == row_idx }
                    let is_playing = fn() -> Bool {
                      let _ = workspace_rev.get()
                      match (get_item(), app_state.workspace.media) {
                        (Some(tb), Some(m)) => {
                          let matched = if m.tab_id != "" { m.tab_id == tb.id } else { tb.active }
                          matched && (m.playing || m.muted || m.is_meeting)
                        }
                        _ => false
                      }
                    }
                    let is_muted_mru = fn() -> Bool {
                      let _ = workspace_rev.get()
                      match app_state.workspace.media {
                        Some(m) => m.muted
                        None => false
                      }
                    }
                    let is_split_mru = fn() -> Bool {
                      if !split_open.get() {
                        return false
                      }
                      let sid = split_tab_id.get()
                      match get_item() {
                        Some(tb) => sid != "" && tb.id == sid
                        None => false
                      }
                    }
                    let _ = headless::button(
                      rw,
                      fn() -> String {
                        match get_item() {
                          Some(tb) => proto::workspace_tab_display_title(tb)
                          None => ""
                        }
                      },
                      fn(_v : view::View) -> Unit {
                        match get_item() {
                          Some(tb) => {
                            close_mru_switcher()
                            dispatch_tab_switch(tb.id)
                          }
                          None => ()
                        }
                      },
                      fn(row : view::View, rbtn : headless::Button) -> Unit {
                        let _ = row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .width(view::Live::Is(Some(468.0)))
                        .height(view::Live::Is(Some(46.0)))
                        .rigid()
                        .clips(view::Live::Is(true))
                        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                        .gap(view::Live::Is(10.0))
                        .radius(view::Live::Is(8.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          if is_sel() {
                            0xEEF2FFFFL
                          } else if rbtn.pressed() {
                            0xE8ECF7FFL
                          } else if rbtn.hovered() {
                            0xF5F7FCFFL
                          } else {
                            0x00000000L
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          if is_sel() {
                            (1.0, 0xC7D2FEFFL)
                          } else {
                            (1.0, 0x00000000L)
                          }
                        }))
                        // Monogram tile (26x26, radius 6)
                        let _ = row.box(
                          fn(ico : view::View) -> Unit {
                            let _ = ico
                            .width(view::Live::Is(Some(26.0)))
                            .height(view::Live::Is(Some(26.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              if is_sel() { 0xDBE4FEFFL } else { 0xEFF1F7FFL }
                            }))
                            let _ = ico.box(
                              fn(ch : view::View) -> Unit {
                                let _ = ch
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(tb) => proto::omnibox_initial_letter(tb.url, tb.title)
                                      None => ""
                                    }
                                  }),
                                  ink=0x374151FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 {
                                  if is_sel() { 0x2563EBFFL } else { 0x4B5563FFL }
                                }))
                              },
                            )
                          },
                        )
                        // Title + Domain stack
                        let _ = row.box(
                          fn(meta : view::View) -> Unit {
                            let _ = meta
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .clips(view::Live::Is(true))
                            .gap(view::Live::Is(1.0))
                            let _ = meta.box(
                              fn(tl : view::View) -> Unit {
                                let _ = tl
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(tb) => proto::workspace_tab_display_title(tb)
                                      None => ""
                                    }
                                  }),
                                  ink=0x1D1D1FFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                  one_line=true,
                                )
                              },
                            )
                            let _ = meta.box(
                              fn(hl : view::View) -> Unit {
                                let _ = hl
                                .clips(view::Live::Is(true))
                                .words(
                                  view::Live::By(fn() -> String {
                                    match get_item() {
                                      Some(tb) => proto::omnibox_display_host(tb.url)
                                      None => ""
                                    }
                                  }),
                                  ink=0x6B7280FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                  one_line=true,
                                )
                              },
                            )
                          },
                        )
                        // Status badges on right (Playing / Split / Pinned / Current)
                        let _ = row.box(
                          fn(badges : view::View) -> Unit {
                            let _ = badges
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .rigid()
                            .gap(view::Live::Is(5.0))
                            // Playing / Muted badge
                            badges.show(
                              is_playing,
                              fn(pb : view::View) -> Unit {
                                let _ = pb
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .height(view::Live::Is(Some(19.0)))
                                .rigid()
                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                .gap(view::Live::Is(4.0))
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  if is_muted_mru() { 0xF1F3F7FFL } else { 0xE6F9F0FFL }
                                }))
                                let _ = pb.box(
                                  fn(pl : view::View) -> Unit {
                                    let _ = pl.words(
                                      view::Live::By(fn() -> String {
                                        if is_muted_mru() { "Muted" } else { "Playing" }
                                      }),
                                      ink=0x059669FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      if is_muted_mru() { 0x6B7280FFL } else { 0x059669FFL }
                                    }))
                                  },
                                )
                              },
                            )
                            // Split badge
                            badges.show(
                              is_split_mru,
                              fn(sb2 : view::View) -> Unit {
                                let _ = sb2
                                .height(view::Live::Is(Some(19.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::Is(0xEEF2FFFFL))
                                let _ = sb2.box(
                                  fn(sl : view::View) -> Unit {
                                    let _ = sl.words(
                                      view::Live::Is("Split"),
                                      ink=0x2563EBFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                  },
                                )
                              },
                            )
                            // Pinned / Favorite badge
                            badges.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(tb) => tb.pinned || tb.favorite
                                  None => false
                                }
                              },
                              fn(pinb : view::View) -> Unit {
                                let _ = pinb
                                .height(view::Live::Is(Some(19.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::Is(0xF3F4F8FFL))
                                let _ = pinb.box(
                                  fn(pl : view::View) -> Unit {
                                    let _ = pl.words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(tb) if tb.favorite => "Favorite"
                                          _ => "Pinned"
                                        }
                                      }),
                                      ink=0x5A6275FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                  },
                                )
                              },
                            )
                            // Current tab badge
                            badges.show(
                              fn() -> Bool {
                                match get_item() {
                                  Some(tb) => tb.active
                                  None => false
                                }
                              },
                              fn(curb : view::View) -> Unit {
                                let _ = curb
                                .height(view::Live::Is(Some(19.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                .radius(view::Live::Is(5.0))
                                .ground(view::Live::Is(0xE8F0FEFFL))
                                let _ = curb.box(
                                  fn(cl : view::View) -> Unit {
                                    let _ = cl.words(
                                      view::Live::Is("Current"),
                                      ink=0x2563EBFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                      one_line=true,
                                    )
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
                mi = mi + 1
              }
            },
          )
          // Footer bar (single top hairline + keycap hints)
          let _ = card.box(
            fn(fsep : view::View) -> Unit {
              let _ = fsep
              .width(view::Live::Is(Some(480.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::Is(0xECEEF4FFL))
            },
          )
          let _ = card.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(480.0)))
              .height(view::Live::Is(Some(32.0)))
              .rigid()
              .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
              .gap(view::Live::Is(14.0))
              .ground(view::Live::Is(0xF8F9FCFFL))
              let _ = ftr.box(
                fn(h1 : view::View) -> Unit {
                  let _ = h1.words(
                    view::Live::Is("↑↓ Cycle"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = ftr.box(
                fn(h2 : view::View) -> Unit {
                  let _ = h2.words(
                    view::Live::Is("↵ Switch"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = ftr.box(
                fn(h3 : view::View) -> Unit {
                  let _ = h3.words(
                    view::Live::Is("Esc Cancel"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
        },
      )
    },
  )
  // Arc Back / Forward Navigation History Popover (260pt wide, concentric R_outer=12 / P=6 / R_inner=6)
  root.show(
    fn() -> Bool { nav_hist_open.get() },
    fn(nh_layer : view::View) -> Unit {
      let _ = nh_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      // Click-outside transparent dismiss scrim
      let _ = headless::button(
        nh_layer,
        fn() -> String { "Dismiss Navigation History" },
        fn(_v : view::View) -> Unit { close_nav_hist() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x00000000L))
        },
      )
      let get_entries = fn() -> Array[proto::NavHistoryEntry] {
        let _ = workspace_rev.get()
        if nav_hist_dir.get() == 0 {
          app_state.workspace.nav_back
        } else {
          app_state.workspace.nav_forward
        }
      }
      let _ = nh_layer.box(
        fn(pop : view::View) -> Unit {
          let _ = pop
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let left = nav_hist_x.get()
            let top = match app_state.address_bar_view {
              Some(ab) => {
                let (_, ay, _, ah) = ab.placed_now()
                if ah > 10.0 { ay + ah + 6.0 } else { 48.0 }
              }
              None => 48.0
            }
            (Some(left), Some(top), None, None)
          }))
          .width(view::Live::Is(Some(260.0)))
          .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
          .gap(view::Live::Is(2.0))
          .radius(view::Live::Is(12.0))
          .ground(view::Live::Is(0xFFFFFFFFL))
          .edge(view::Live::Is((1.0, 0xDCDCE2FFL)))
          .shadow(view::Live::Is((22.0, 8.0, 0x0F172A24L)))
          // Header micro-label + entry count
          let _ = pop.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(248.0)))
              .padding(view::Live::Is((8.0, 3.0, 8.0, 4.0)))
              .gap(view::Live::Is(6.0))
              let _ = hdr.box(
                fn(ht : view::View) -> Unit {
                  let _ = ht
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::By(fn() -> String {
                      if nav_hist_dir.get() == 0 { "BACK HISTORY" } else { "FORWARD HISTORY" }
                    }),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
              let _ = hdr.box(
                fn(hc : view::View) -> Unit {
                  let _ = hc.rigid().words(
                    view::Live::By(fn() -> String { get_entries().length().to_string() }),
                    ink=0x8E8E93FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
          // Single 1px hairline divider
          let _ = pop.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .width(view::Live::Is(Some(248.0)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::Is(0xECEEF4FFL))
            },
          )
          // Up to 10 entries, most recent first
          let mut nslot = 0
          while nslot < 10 {
            let n_idx = nslot
            let get_entry = fn() -> Option[proto::NavHistoryEntry] {
              let arr = get_entries()
              if n_idx < arr.length() { Some(arr[n_idx]) } else { None }
            }
            pop.show(
              fn() -> Bool { get_entry().is_some() },
              fn(nrow : view::View) -> Unit {
                let _ = headless::button(
                  nrow,
                  fn() -> String {
                    match get_entry() {
                      Some(e) => proto::nav_entry_display_title(e)
                      None => ""
                    }
                  },
                  fn(_v : view::View) -> Unit {
                    match get_entry() {
                      Some(e) => dispatch_nav_jump(e.index)
                      None => close_nav_hist()
                    }
                  },
                  fn(ib : view::View, ibtn : headless::Button) -> Unit {
                    let _ = ib
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Start)))
                    .width(view::Live::Is(Some(248.0)))
                    .rigid()
                    .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
                    .gap(view::Live::Is(8.0))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if ibtn.pressed() {
                        0xE5E9F4FFL
                      } else if ibtn.hovered() {
                        0xF1F3F9FFL
                      } else {
                        0x00000000L
                      }
                    }))
                    // Compact monogram icon aligned with first line
                    let _ = ib.box(
                      fn(ico : view::View) -> Unit {
                        let _ = ico
                        .width(view::Live::Is(Some(20.0)))
                        .height(view::Live::Is(Some(20.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::Is(0xEEF1F8FFL))
                        .edge(view::Live::Is((1.0, 0xDCE0ECFFL)))
                        let _ = ico.box(
                          fn(gl : view::View) -> Unit {
                            let _ = gl.words(
                              view::Live::By(fn() -> String {
                                match get_entry() {
                                  Some(e) => proto::omnibox_initial_letter(e.url, e.title)
                                  None => "·"
                                }
                              }),
                              ink=0x4B5563FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                              one_line=true,
                            )
                          },
                        )
                      },
                    )
                    // 2-line title + domain stack
                    let _ = ib.box(
                      fn(col : view::View) -> Unit {
                        let _ = col
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .gap(view::Live::Is(1.0))
                        let _ = col.box(
                          fn(tl : view::View) -> Unit {
                            let _ = tl
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(fn() -> String {
                                match get_entry() {
                                  Some(e) => proto::nav_entry_display_title(e)
                                  None => ""
                                }
                              }),
                              ink=0x1D1D1FFFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                          },
                        )
                        let _ = col.box(
                          fn(hl : view::View) -> Unit {
                            let _ = hl
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(fn() -> String {
                                match get_entry() {
                                  Some(e) => proto::split_pane_display_host(e.url)
                                  None => ""
                                }
                              }),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                              one_line=true,
                            )
                          },
                        )
                      },
                    )
                  },
                )
              },
            )
            nslot = nslot + 1
          }
        },
      )
    },
  )
  // Webpage Right-Click Context Menu (`Open in Peek`, `Open Link in Split View`, `Copy Clean Link`)
  build_page_context_menu(
    root,
    page_ctx_open,
    page_ctx_link,
    page_ctx_x,
    page_ctx_y,
    page_ctx_can_back,
    page_ctx_can_forward,
  )
  // Arc Peek Floating Preview Modal (process-isolated secondary Stage, Light & Dark ChromePalette)
  build_peek_preview_modal(root, peek_open, peek_url, workspace_rev)
  // Arc Floating Toast Pill (highest Z-order, non-blocking top-center obsidian capsule, auto-dismisses after 2.2s)
  root.show(
    fn() -> Bool { toast_visible.get() },
    fn(toast_wrap : view::View) -> Unit {
      let _ = toast_wrap
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        if peek_open.get() {
          return (Some(0.0), None, Some(0.0), Some(20.0))
        }
        let top = match app_state.address_bar_view {
          Some(ab) => {
            let (_, ay, _, ah) = ab.placed_now()
            if ah > 10.0 { ay + ah + 14.0 } else { 60.0 }
          }
          None => 60.0
        }
        (Some(0.0), Some(top), Some(0.0), None)
      }))
      .row(view::Live::Is(true))
      .center()
      let _ = toast_wrap.box(
        fn(pill : view::View) -> Unit {
          let _ = pill
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(34.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 14.0, 0.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(17.0))
          .ground(view::Live::Is(0x181C24F2L))
          .edge(view::Live::Is((1.0, 0xFFFFFF22L)))
          .shadow(view::Live::Is((18.0, 6.0, 0x0F172A38L)))
          // Colored circular status icon badge (18x18, radius 9)
          let _ = pill.box(
            fn(badge : view::View) -> Unit {
              let _ = badge
              .width(view::Live::Is(Some(18.0)))
              .height(view::Live::Is(Some(18.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(9.0))
              .ground(view::Live::By(fn() -> Int64 {
                let k = toast_kind.get()
                if k == "close" || k == "clear" {
                  0xF59E0BFFL
                } else if k == "fav" {
                  0xEAB308FFL
                } else if k == "audio" || k == "split" {
                  0x3B82F6FFL
                } else {
                  0x10B981FFL
                }
              }))
              let _ = badge.box(
                fn(g : view::View) -> Unit {
                  let _ = g.words(
                    view::Live::By(fn() -> String {
                      let k = toast_kind.get()
                      if k == "close" || k == "clear" {
                        "↺"
                      } else if k == "fav" {
                        "★"
                      } else {
                        "✓"
                      }
                    }),
                    ink=0xFFFFFFFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 700, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
          // High-contrast crisp white label
          let _ = pill.box(
            fn(tl : view::View) -> Unit {
              let _ = tl.rigid().words(
                view::Live::By(fn() -> String { toast_message.get() }),
                ink=0xFFFFFFFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                one_line=true,
              )
            },
          )
        },
      )
    },
  )
  pump_io_frame()
}

fn load_default_fonts(w : World) -> Array[Bytes] {
  // Keep system default fonts to 4 slots (4..7) so MB_FACES=16 leaves 8 slots (8..15) for page web fonts.
  let paths : Array[String] = [
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/System/Library/Fonts/Supplemental/Georgia.ttf",
    "/System/Library/Fonts/Supplemental/Courier New.ttf",
  ]
  let out : Array[Bytes] = []
  let mut i = 0
  while i < paths.length() {
    match fs_read_bytes(w, paths[i]) {
      Result::Ok(b) => out.push(b)
      Result::Err(_) => ()
    }
    i = i + 1
  }
  out
}

fn main(w : World) -> Unit {
  let cli_args = world_args(w)
  let mut arg_i = 1
  while arg_i < cli_args.length() {
    let arg = cli_args[arg_i]
    if arg == "--demo-peek" && arg_i + 1 < cli_args.length() {
      let u = cli_args[arg_i + 1].trim()
      if u != "" {
        app_state.initial_peek_url = u
        app_state.initial_peek_open = true
      }
      arg_i = arg_i + 2
      continue
    } else if arg.starts_with("--demo-peek=") {
      let u = arg.slice(12, arg.length()).trim()
      if u != "" {
        app_state.initial_peek_url = u
        app_state.initial_peek_open = true
      }
    } else if arg == "--demo-tab-preview" {
      app_state.initial_sidebar_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_tab_preview = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      } else {
        app_state.demo_tab_preview = "first"
      }
    } else if arg.starts_with("--demo-tab-preview=") {
      let tid = arg.slice(19, arg.length()).trim()
      app_state.initial_sidebar_open = true
      app_state.demo_tab_preview = if tid != "" { tid } else { "first" }
    } else if arg == "--demo-split-ui" {
      app_state.initial_split_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        let u = cli_args[arg_i + 1].trim()
        if u != "" {
          app_state.initial_split_url = u
        }
        arg_i = arg_i + 2
        continue
      }
    } else if arg.starts_with("--demo-split-ui=") {
      app_state.initial_split_open = true
      let u = arg.slice(16, arg.length()).trim()
      if u != "" {
        app_state.initial_split_url = u
      }
    } else if arg == "--demo-find" && arg_i + 1 < cli_args.length() {
      let q = cli_args[arg_i + 1].trim()
      if q != "" {
        app_state.demo_find = q
      }
      arg_i = arg_i + 2
      continue
    } else if arg.starts_with("--demo-find=") {
      let q = arg.slice(12, arg.length()).trim()
      if q != "" {
        app_state.demo_find = q
      }
    } else if arg == "--demo-find-case" {
      app_state.demo_find_case = true
    } else if arg == "--demo-history" {
      app_state.initial_history_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_history_query = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      }
    } else if arg.starts_with("--demo-history=") {
      app_state.initial_history_open = true
      app_state.demo_history_query = arg.slice(15, arg.length()).trim()
    } else if arg == "--demo-cookies" {
      app_state.initial_cookies_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_cookies_host = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      }
    } else if arg.starts_with("--demo-cookies=") {
      app_state.initial_cookies_open = true
      app_state.demo_cookies_host = arg.slice(15, arg.length()).trim()
    } else if arg == "--demo-downloads" {
      app_state.initial_downloads_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_downloads_cat = proto::normalize_download_category(cli_args[arg_i + 1])
        arg_i = arg_i + 2
        continue
      }
    } else if arg.starts_with("--demo-downloads=") {
      app_state.initial_downloads_open = true
      app_state.demo_downloads_cat = proto::normalize_download_category(arg.slice(17, arg.length()))
    } else if arg == "--demo-shortcuts" {
      app_state.initial_shortcuts_open = true
    } else if arg == "--demo-tab-filter" && arg_i + 1 < cli_args.length() {
      let q = cli_args[arg_i + 1].trim()
      app_state.initial_sidebar_open = true
      app_state.initial_tab_filter_query = q
      arg_i = arg_i + 2
      continue
    } else if arg.starts_with("--demo-tab-filter=") {
      let q = arg.slice(18, arg.length()).trim()
      app_state.initial_sidebar_open = true
      app_state.initial_tab_filter_query = q
    } else if arg == "--demo-tab-ctx" {
      app_state.initial_sidebar_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        app_state.demo_tab_ctx = cli_args[arg_i + 1].trim()
        arg_i = arg_i + 2
        continue
      } else {
        app_state.demo_tab_ctx = "first"
      }
    } else if arg.starts_with("--demo-tab-ctx=") {
      let tid = arg.slice(15, arg.length()).trim()
      app_state.initial_sidebar_open = true
      app_state.demo_tab_ctx = if tid != "" { tid } else { "first" }
    } else if arg == "--demo-zoom" {
      app_state.initial_zoom_popover_open = true
      if arg_i + 1 < cli_args.length() && !cli_args[arg_i + 1].starts_with("--") {
        match proto::parse_demo_zoom_pct(cli_args[arg_i + 1]) {
          Some(z) => app_state.initial_zoom = z
          None => app_state.initial_zoom = 1.25
        }
        arg_i = arg_i + 2
        continue
      } else {
        app_state.initial_zoom = 1.25
      }
    } else if arg.starts_with("--demo-zoom=") {
      let raw_z = arg.slice(12, arg.length()).trim()
      app_state.initial_zoom_popover_open = true
      match proto::parse_demo_zoom_pct(raw_z) {
        Some(z) => app_state.initial_zoom = z
        None => app_state.initial_zoom = 1.25
      }
    } else if arg == "--demo-spaces" {
      app_state.initial_sidebar_open = true
      app_state.initial_spaces_open = true
    } else if arg == "--demo-closed-tabs" {
      app_state.initial_sidebar_open = true
      app_state.initial_closed_tabs_open = true
    } else if arg == "--demo-print" {
      app_state.initial_sidebar_open = true
      app_state.initial_print_open = true
    } else if arg == "--demo-favorites" {
      app_state.demo_favorites = true
      app_state.initial_sidebar_open = true
    } else if arg == "--demo-site-search" && arg_i + 1 < cli_args.length() {
      arg_i = arg_i + 1
      let q = cli_args[arg_i]
      if q != "" {
        app_state.demo_site_search = q
        app_state.demo_omnibox = q
      }
    } else if arg.starts_with("--demo-site-search=") {
      let q = arg.slice(19, arg.length())
      if q != "" {
        app_state.demo_site_search = q
        app_state.demo_omnibox = q
      }
    } else if arg == "--demo-perf-hud" {
      app_state.initial_perf_hud_open = true
    } else if arg == "--demo-idn-spoof" {
      app_state.demo_idn_url = "https://p\u{0430}ypal.com/signin"
      app_state.initial_idn_popover_open = true
    } else if arg == "--demo-idn-safe" {
      app_state.demo_idn_url = "https://xn--mnchen-3ya.de/guide"
      app_state.initial_idn_popover_open = false
    } else if arg == "--demo-devtools-network" {
      app_state.demo_devtools_network = true
      app_state.initial_devtools_open = true
      app_state.initial_devtools_tab = 2
      app_state.initial_devtools_height = 350.0
    } else if arg == "--demo-bookmarks-bar" {
      app_state.demo_bookmarks_bar = true
      app_state.initial_bookmarks_bar_open = true
    } else if arg == "--demo-omnibox-calc" && arg_i + 1 < cli_args.length() {
      arg_i = arg_i + 1
      let q = cli_args[arg_i]
      if q != "" {
        app_state.demo_omnibox = q
      }
    } else if arg.starts_with("--demo-omnibox-calc=") {
      let q = arg.slice(20, arg.length())
