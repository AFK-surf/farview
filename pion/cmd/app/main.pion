fn execute_command_bar_item(_st : stage::Stage, item : proto::CommandBarItem) -> Unit {
  let target_st = active_stage()
  close_command_bar()
  match item.kind {
    proto::CommandKind::SwitchTab => dispatch_tab_switch(item.id)
    proto::CommandKind::SwitchSpace => dispatch_space_switch(item.id)
    proto::CommandKind::NewSpace => dispatch_space_new(item.id)
    proto::CommandKind::NavigateUrl | proto::CommandKind::SearchWeb => {
      if item.id != "" {
        target_st.go(item.id)
      }
    }
    proto::CommandKind::Action => {
      if item.id == "pin_tab" {
        dispatch_tab_pin("")
      } else if item.id == "favorite_tab" {
        dispatch_tab_favorite("")
      } else if item.id == "global_media_controls" {
        open_media_hub()
      } else if item.id == "toggle_play_media" {
        dispatch_media_toggle_play("")
      } else if item.id == "toggle_mute_audio" {
        dispatch_media_mute_toggle()
      } else if item.id == "reopen_tab" {
        dispatch_tab_reopen()
      } else if item.id == "recently_closed_tabs" {
        open_closed_tabs_modal()
      } else if item.id == "new_tab" {
        dispatch_tab_new("", "")
      } else if item.id == "new_start_page" {
        target_st.go("about:newtab")
      } else if item.id == "manage_spaces" {
        open_spaces_manager()
      } else if item.id == "new_space" {
        open_spaces_manager(focus_new=true)
      } else if item.id == "new_folder" {
        open_folder_create_bar()
      } else if item.id == "saved_sessions" {
        open_sessions_modal()
      } else if item.id == "today_clear" {
        dispatch_today_clear()
      } else if item.id == "toggle_sidebar" {
        toggle_sidebar()
      } else if item.id == "toggle_split_view" {
        toggle_split_view()
      } else if item.id == "toggle_peek" {
        toggle_peek_preview()
      } else if item.id == "open_current_in_peek" {
        open_peek_preview(target_st.url(), app_state.workspace.active_tab_id)
      } else if item.id == "swap_split_panes" {
        swap_split_panes()
      } else if item.id == "close_split_view" {
        close_split_view()
      } else if item.id == "site_info" {
        toggle_site_info()
      } else if item.id == "inspect_cookies" {
        open_cookies_modal()
      } else if item.id == "toggle_devtools" {
        toggle_devtools()
      } else if item.id == "toggle_perf_hud" {
        toggle_perf_hud()
      } else if item.id == "export_pdf" {
        open_print_pdf_modal()
      } else if item.id == "search_all_tabs" {
        open_tab_search()
      } else if item.id == "capture_screenshot" {
        dispatch_capture_screenshot()
      } else if item.id == "toggle_bookmark" {
        dispatch_bookmark_toggle()
      } else if item.id == "toggle_bookmarks_bar" {
        toggle_bookmarks_bar()
      } else if item.id == "bookmarks" {
        open_bookmarks()
      } else if item.id == "toggle_reader_mode" {
        toggle_reader_mode()
      } else if item.id == "toggle_boosts" {
        toggle_boosts()
      } else if item.id == "downloads" {
        toggle_downloads()
      } else if item.id == "history" {
        open_history()
      } else if item.id == "space_theme" {
        open_space_theme()
      } else if item.id == "copy_url" {
        copy_url_with_toast(target_st.url())
      } else if item.id == "open_settings" {
        open_settings()
      } else if item.id == "toggle_dark_chrome" {
        toggle_dark_chrome()
      } else if item.id == "shortcuts" {
        open_shortcuts()
      } else if item.id == "reload" {
        target_st.reload()
      }
    }
  }
}

fn submit_command_bar(st : stage::Stage, raw : String) -> Unit {
  let items = app_state.command_bar_items
  let sel = match app_state.command_bar_selected {
    Some(s) => s.untracked()
    None => 0
  }
  if sel >= 0 && sel < items.length() {
    execute_command_bar_item(st, items[sel])
  } else if items.length() > 0 {
    execute_command_bar_item(st, items[0])
  } else {
    close_command_bar()
    let target = proto::omnibox_normalize_input_with_engine(
      raw,
      app_state.settings.search_engine,
      https_only=app_state.settings.https_only,
    )
    if target != "" {
      st.go(target)
    }
  }
}

