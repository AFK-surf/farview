fn show_toast(msg : String, kind : String) -> Unit {
  if msg.trim() == "" {
    return
  }
  match app_state.toast_message {
    Some(s) => s.set(msg)
    None => ()
  }
  match app_state.toast_kind {
    Some(s) => s.set(kind)
    None => ()
  }
  match app_state.toast_visible {
    Some(s) => s.set(true)
    None => ()
  }
  app_state.toast_expires_ms = now_ms() + 2200.0
  schedule_toast_expiry(2200.0)
}

fn show_persistent_demo_toast(msg : String, kind : String) -> Unit {
