  }
  match env_get(w, "FV_APP_OPEN_COMMAND_BAR") {
    Some(v) if v == "1" || v == "true" => app_state.initial_command_bar_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_HISTORY") {
    Some(v) if v == "1" || v == "true" => app_state.initial_history_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_BOOKMARKS") {
    Some(v) if v == "1" || v == "true" => app_state.initial_bookmarks_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_READER") {
    Some(v) if v == "1" || v == "true" => app_state.initial_reader_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_READER_THEME") {
    Some(v) if v.trim() != "" => app_state.initial_reader_theme = v.trim()
    _ => ()
  }
  match env_get(w, "FV_APP_READER_FONT") {
    Some(v) if v.trim() != "" => app_state.initial_reader_font = v.trim()
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_BOOSTS") {
    Some(v) if v == "1" || v == "true" => app_state.initial_boosts_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_OPEN_SETTINGS") {
    Some(v) if v == "1" || v == "true" => app_state.initial_settings_open = true
    _ => ()
  }
  match env_get(w, "FV_APP_SETTINGS_TAB") {
    Some(v) => {
      let lv = v.trim()
      if lv == "appearance" || lv == "1" {
        app_state.initial_settings_tab = 1
      } else if lv == "privacy" || lv == "2" {
        app_state.initial_settings_tab = 2
      } else {
        app_state.initial_settings_tab = 0
      }
    }
    None => ()
  }
  match env_get(w, "FV_APP_CHROME_THEME") {
    Some(v) if v.trim() != "" => {
