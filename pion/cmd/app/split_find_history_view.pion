///| Arc Desktop Shell daily-driver UX views:
///| 1. Split View (`build_split_view`): draggable 6pt divider with grab handle & double-click 50/50 reset,
///|    per-pane 32pt compact header (`‹` / `›` / `↻`, domain + title, `⇄ Swap` / `↗ Expand` / `× Close`),
///|    full Light & Dark `ChromePalette` parity.
///| 2. Upgraded Floating `Cmd+F` Find-in-Page capsule (`build_find_bar_overlay`):
///|    top-right rounded capsule (never overlaps toolbar or split headers), real-time `N / M` counter
///|    (hidden on empty query, soft red `0 / 0` on miss), `Aa` case-sensitivity toggle, `‹` / `›` / `×`.
///| 3. Upgraded History Drawer (`build_history_drawer`):
///|    real-time full-text search, `Today` / `Yesterday` / `Earlier` time buckets (zero empty groups,
///|    zero dangling dividers), per-item delete, and bottom compact time-range clear bar
///|    (`Last Hour` / `Last 24h` / `Last 7d` / `All`).

fn build_split_view(
  content_wrap : view::View,
  st : stage::Stage,
  sidebar_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  split_open : signals::Signal[Bool],
  split_ratio : signals::Signal[Double],
  split_active_pane : signals::Signal[Int],
  split_swapped : signals::Signal[Bool],
  split_dragging : signals::Signal[Bool],
) -> Unit {
  content_wrap.show(
    fn() -> Bool { split_open.get() },
    fn(split_row : view::View) -> Unit {
      let split_st = ensure_split_stage()
      let _ = split_row
      .row(view::Live::Is(true))
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      .min_height(view::Live::Is(Some(0.0)))
      .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))

      let active_space_color = fn() -> Int64 {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => proto::workspace_accent_color(sp.accent)
          None => chrome_palette().accent
        }
      }

      let inner_avail_w = fn() -> Double {
        let (cw, _) = content_wrap.laid_size()
        if cw > 100.0 {
          cw - 12.0
        } else if sidebar_open.get() {
          1024.0
        } else {
          1268.0
        }
      }

      let render_pane_card = fn(
        slot : view::View,
        pane_id : Int,
        pst : stage::Stage,
        slot_width_fn : () -> Double,
      ) -> Unit {
        let is_focused = fn() -> Bool { split_active_pane.get() == pane_id }
        let _ = slot.box(
          fn(card : view::View) -> Unit {
            let _ = card
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .min_height(view::Live::Is(Some(0.0)))
            .radius(view::Live::Is(8.0))
            .clips(view::Live::Is(true))
            .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
            .edge(view::Live::By(fn() -> (Double, Int64) {
              let p = chrome_palette()
              if is_focused() {
                let c = active_space_color()
                (1.5, (c & 0xFFFFFF00L) | 0xB3L)
              } else {
                (1.0, p.border)
              }
            }))
            .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
              if is_focused() {
                if is_dark_chrome() { (12.0, 3.0, 0x00000055L) } else { (10.0, 2.0, 0x0F172A18L) }
              } else {
                (0.0, 0.0, 0x00000000L)
              }
            }))

            // Top 2.5pt Space-accent focus bar (fixed height prevents layout shift when switching focus)
            let _ = card.box(
              fn(fbar : view::View) -> Unit {
                let _ = fbar
                .height(view::Live::Is(Some(2.5)))
                .rigid()
                .ground(view::Live::By(fn() -> Int64 {
                  if is_focused() { active_space_color() } else { 0x00000000L }
                }))
              },
            )

            // Compact 32pt Per-Pane Mini Header Bar
            let _ = card.box(
              fn(hdr : view::View) -> Unit {
                let _ = hdr
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(32.0)))
                .rigid()
                .gap(view::Live::Is(4.0))
                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if is_focused() { p.surface_bg } else { p.surface_subtle }
                }))

                // Per-pane navigation button helper (`‹`, `›`, `↻`)
                let pane_nav_btn = fn(
                  glyph : String,
                  label : String,
                  enabled_fn : () -> Bool,
                  on_click : () -> Unit,
                ) -> Unit {
                  let _ = headless::button(
                    hdr,
                    fn() -> String { label },
                    fn(_v : view::View) -> Unit {
                      set_active_split_pane(pane_id)
                      if enabled_fn() {
                        on_click()
                      }
                    },
                    fn(nb : view::View, nbtn : headless::Button) -> Unit {
                      let _ = nb
                      .width(view::Live::Is(Some(22.0)))
                      .height(view::Live::Is(Some(22.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(5.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        if !enabled_fn() {
                          0x00000000L
                        } else {
                          let p = chrome_palette()
                          if nbtn.pressed() {
                            p.btn_press
                          } else if nbtn.hovered() {
                            p.btn_hover
                          } else {
                            0x00000000L
                          }
                        }
                      }))
                      let _ = nb.box(
                        fn(gl : view::View) -> Unit {
                          let _ = gl
                          .words(
                            view::Live::Is(glyph),
                            ink=0x4B5563FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if !enabled_fn() {
                              if p.is_dark { 0x475569FFL } else { 0xCBD5E1FFL }
                            } else if nbtn.hovered() || nbtn.pressed() {
                              p.ink_primary
                            } else {
                              p.ink_secondary
                            }
                          }))
                        },
                      )
                    },
                  )
                }

                pane_nav_btn("‹", "Pane Back", fn() -> Bool { pst.can_back() }, fn() -> Unit { pst.back() })
                pane_nav_btn("›", "Pane Forward", fn() -> Bool { pst.can_forward() }, fn() -> Unit { pst.forward() })
                pane_nav_btn("↻", "Pane Reload", fn() -> Bool { true }, fn() -> Unit { pst.reload() })

                // Clickable focus + domain + title strip
                let _ = headless::button(
                  hdr,
                  fn() -> String {
                    proto::split_pane_display_title(pst.title(), pst.url())
                  },
                  fn(_v : view::View) -> Unit { set_active_split_pane(pane_id) },
                  fn(tb : view::View, _tbtn : headless::Button) -> Unit {
                    let _ = tb
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .height(view::Live::Is(Some(24.0)))
                    .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
                    .clips(view::Live::Is(true))
                    .gap(view::Live::Is(6.0))
                    // Focus indicator dot
                    let _ = tb.box(
                      fn(dot : view::View) -> Unit {
                        let _ = dot
                        .width(view::Live::Is(Some(6.0)))
                        .height(view::Live::Is(Some(6.0)))
                        .rigid()
                        .radius(view::Live::Is(3.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_focused() { active_space_color() } else { p.border }
                        }))
                      },
                    )
                    // Secure domain pill (shown when width permits, non-loopback, and distinct from title)
                    tb.show(
                      fn() -> Bool {
                        let host = proto::split_pane_display_host(pst.url())
                        let title = pst.title().trim()
                        let skip_local = title != "" && proto::split_bar_is_local_host(host)
                        slot_width_fn() >= 340.0 && host != "" && !skip_local
                      },
                      fn(hl : view::View) -> Unit {
                        let _ = hl
                        .max_width(view::Live::Is(Some(136.0)))
                        .shrink(view::Live::Is(1.0))
                        .min_width(view::Live::Is(Some(0.0)))
                        .clips(view::Live::Is(true))
                        .words(
                          view::Live::By(fn() -> String {
                            proto::split_pane_display_host(pst.url())
                          }),
                          ink=0x6B7280FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_focused() { p.ink_secondary } else { p.ink_muted }
                        }))
                      },
                    )
                    // Pane title (single-line bounded, ellipsis on overflow)
                    let _ = tb.box(
                      fn(tl : view::View) -> Unit {
                        let _ = tl
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .clips(view::Live::Is(true))
                        .words(
                          view::Live::By(fn() -> String {
                            let host = proto::split_pane_display_host(pst.url())
                            let title = proto::split_pane_display_title(pst.title(), pst.url())
                            if slot_width_fn() >= 340.0 && host != "" && title == host {
                              ""
                            } else {
                              title
                            }
                          }),
                          ink=0x1D1D1FFFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_focused() { p.ink_primary } else { p.ink_muted }
                        }))
                      },
                    )
                  },
                )

                // Top Split Focus Bar owns global Swap / Solo / Close Split controls
                // (avoids duplicate action buttons in per-pane headers).
              },
            )

            // Single hairline separator under pane header (zero double divider)
            let _ = card.box(
              fn(hsep : view::View) -> Unit {
                let _ = hsep
                .height(view::Live::Is(Some(1.0)))
                .rigid()
                .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
              },
            )

            // Live webpage Stage node (focus switches on press without swallowing page input)
            let psv = stage::stage_node(
              card,
              pst,
              on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(pst, hit) }),
            )
            let _ = psv.min_width(view::Live::Is(Some(0.0)))
            if pane_id == 0 {
              app_state.stage_view = Some(psv)
            } else {
              app_state.split_stage_view = Some(psv)
            }
            card.reacts(fn() -> Bool { psv.pressed() }, fn(is_p : Bool) -> Unit {
              if is_p {
                set_active_split_pane(pane_id)
              }
            })
          },
        )
      }

      let left_w_fn = fn() -> Double {
        let (lw, _) = proto::split_pane_widths(inner_avail_w(), split_ratio.get())
        lw
      }
      let right_w_fn = fn() -> Double {
        let (_, rw) = proto::split_pane_widths(inner_avail_w(), split_ratio.get())
        rw
      }

      // Left slot
      let _ = split_row.box(
        fn(left_slot : view::View) -> Unit {
          let _ = left_slot
          .row(view::Live::Is(true))
          .width(view::Live::By(fn() -> Option[Double] { Some(left_w_fn()) }))
          .rigid()
          .min_width(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          left_slot.show(
            fn() -> Bool { !split_swapped.get() },
            fn(w0 : view::View) -> Unit {
              let _ = w0
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))
              render_pane_card(w0, 0, st, left_w_fn)
            },
          )
          left_slot.show(
            fn() -> Bool { split_swapped.get() },
            fn(w1 : view::View) -> Unit {
              let _ = w1
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))
              render_pane_card(w1, 1, split_st, left_w_fn)
            },
          )
        },
      )

      // Draggable 6pt Split Divider (subtle resting grab handle pill, Space-accent highlight on hover/drag, double-click resets 50/50)
      let _ = split_row.box(
        fn(divider : view::View) -> Unit {
          let is_hot = fn() -> Bool { split_dragging.get() || divider.pointed() }
          let _ = divider
          .width(view::Live::Is(Some(proto::SPLIT_DIVIDER_WIDTH)))
          .rigid()
          .center()
          .cursor(view::Live::Is(Some(view::Cursor::ResizeX)))
          .on_drag(
            fn(d : view::Drag) -> Unit {
              match d.kind {
                view::DragIs::Down => {
                  let now_t = d.at
                  if proto::split_is_double_click(app_state.split_last_click_ms, now_t) {
                    app_state.split_last_click_ms = 0.0
                    let reset_r = proto::split_reset_ratio()
                    split_ratio.set(reset_r)
                    shell_page_set_ratio(reset_r)
                    split_dragging.set(false)
                    show_toast("Reset Split View (50/50)", "split")
                  } else {
                    app_state.split_last_click_ms = now_t
                    app_state.split_drag_start_wx = d.wx
                    app_state.split_drag_start_ratio = split_ratio.untracked()
                    split_dragging.set(true)
                  }
                }
                view::DragIs::Moved => {
                  if split_dragging.untracked() {
                    let dx = d.wx - app_state.split_drag_start_wx
                    let next_r = proto::split_ratio_from_drag(
                      app_state.split_drag_start_ratio,
                      dx,
                      inner_avail_w(),
                    )
                    split_ratio.set(next_r)
                    shell_page_set_ratio(next_r)
                  }
                }
                view::DragIs::Up | view::DragIs::Off => {
                  split_dragging.set(false)
                }
              }
            },
            captures=true,
          )
          // Full-height subtle divider hairline
          let _ = divider.box(
            fn(line : view::View) -> Unit {
              let _ = line
              .width(view::Live::By(fn() -> Option[Double] {
                if is_hot() { Some(2.0) } else { Some(1.0) }
              }))
              .grow(view::Live::Is(1.0))
              .radius(view::Live::Is(1.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_hot() { active_space_color() } else { chrome_palette().border }
              }))
            },
          )
          // Always-discoverable centered grab handle pill (subtle at rest, Space-accent on hover/drag)
          let _ = divider.box(
            fn(pill : view::View) -> Unit {
              let _ = pill
              .over_at(view::Live::Is((Some(1.0), None, None, None)))
              .width(view::Live::Is(Some(4.0)))
              .height(view::Live::By(fn() -> Option[Double] {
                if is_hot() { Some(34.0) } else { Some(24.0) }
              }))
              .radius(view::Live::Is(2.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if is_hot() {
                  active_space_color()
                } else if p.is_dark {
                  0x475569FFL
                } else {
                  0xBAC2D4FFL
                }
              }))
            },
          )
        },
      )

      // Right slot (fills remaining width cleanly with zero gap)
      let _ = split_row.box(
        fn(right_slot : view::View) -> Unit {
          let _ = right_slot
          .row(view::Live::Is(true))
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          right_slot.show(
            fn() -> Bool { !split_swapped.get() },
            fn(w1 : view::View) -> Unit {
              let _ = w1
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))
              render_pane_card(w1, 1, split_st, right_w_fn)
            },
          )
          right_slot.show(
            fn() -> Bool { split_swapped.get() },
            fn(w0 : view::View) -> Unit {
              let _ = w0
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))
              render_pane_card(w0, 0, st, right_w_fn)
            },
          )
        },
      )
    },
  )
}

///| Upgraded floating `Cmd+F` Find-in-Page rounded capsule anchored at top-right of `content_wrap`.
///| Automatically drops below Split View's 32pt pane header when split mode is active so it never
///| obscures toolbar or pane header controls. Concentric radii: 12pt capsule -> 6pt controls.
fn build_find_bar_overlay(
  content_wrap : view::View,
  find_open : signals::Signal[Bool],
  find_field : ui::Field,
  find_case_sensitive : signals::Signal[Bool],
  host_find_synced : signals::Signal[Bool],
  host_find_active : signals::Signal[Int],
  host_find_total : signals::Signal[Int],
  split_open : signals::Signal[Bool],
) -> Unit {
  content_wrap.show(
    fn() -> Bool { find_open.get() },
    fn(fbar : view::View) -> Unit {
      let _ = fbar
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        let top_y = if split_open.get() { 48.0 } else { 12.0 }
        (None, Some(top_y), Some(16.0), None)
      }))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(40.0)))
      .gap(view::Live::Is(5.0))
      .padding(view::Live::Is((8.0, 6.0, 6.0, 6.0)))
      .radius(view::Live::Is(12.0))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        let p = chrome_palette()
        (1.0, if p.is_dark { 0x3A4154FFL } else { p.border })
      }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (22.0, 8.0, 0x00000088L) } else { (20.0, 6.0, 0x0F172A28L) }
      }))

      fbar.reacts(fn() -> String { find_field.text() }, fn(q : String) -> Unit {
        dispatch_find_query(active_stage(), q)
      })

      let resolve_find_counts = fn() -> (Int, Int) {
        if host_find_synced.get() {
          (host_find_active.get(), host_find_total.get())
        } else {
          let (at1, tot) = active_stage_live().find_place()
          if tot <= 0 { (-1, 0) } else { (at1 - 1, tot) }
        }
      }

      // Single-line Find input box (Light & Dark ChromePalette aware)
      let _ = fbar.box(
        fn(fw : view::View) -> Unit {
          let _ = fw
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .width(view::Live::Is(Some(192.0)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            let q = find_field.text()
            let (_, tot) = resolve_find_counts()
            if proto::find_is_empty_result(q, tot) {
              (1.0, p.danger_border)
            } else {
              (1.0, p.border)
            }
          }))
          let _ = fw.box(
            fn(in_wrap : view::View) -> Unit {
              let _ = in_wrap
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(20.0)))
              .clips(view::Live::Is(true))
              in_wrap.show(
                fn() -> Bool { !is_dark_chrome() },
                fn(fl : view::View) -> Unit {
                  let _ = ui::field(
                    fl,
                    find_field,
                    placeholder="Find in page",
                    font_size=13.0,
                    color=0x1D1D1FFFL,
                    placeholder_color=0x8E8E93FFL,
                    max_lines=1,
                    enter_sends=true,
                    submitted=fn(_t : String) -> Unit { dispatch_find_next(active_stage()) },
                  )
                },
              )
              in_wrap.show(
                fn() -> Bool { is_dark_chrome() },
                fn(fd : view::View) -> Unit {
                  let _ = ui::field(
                    fd,
                    find_field,
                    placeholder="Find in page",
                    font_size=13.0,
                    color=0xF1F5F9FFL,
                    placeholder_color=0x94A3B8FFL,
                    caret_color=0x60A5FAFFL,
                    max_lines=1,
                    enter_sends=true,
                    submitted=fn(_t : String) -> Unit { dispatch_find_next(active_stage()) },
                  )
                },
              )
            },
          )
        },
      )

      // Real-time match counter (`3 / 14`, soft red `0 / 0` on miss, hidden when query is empty)
      fbar.show(
        fn() -> Bool { find_field.text().trim() != "" },
        fn(cnt_wrap : view::View) -> Unit {
          let _ = cnt_wrap
          .height(view::Live::Is(Some(24.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            let q = find_field.text()
            let (_, tot) = resolve_find_counts()
            if proto::find_is_empty_result(q, tot) {
              p.danger_bg
            } else {
              p.surface_subtle
            }
          }))
          let _ = cnt_wrap.box(
            fn(cnt : view::View) -> Unit {
              let _ = cnt.words(
                view::Live::By(fn() -> String {
                  let q = find_field.text()
                  let (idx, tot) = resolve_find_counts()
                  proto::format_find_counter(q, idx, tot)
                }),
                ink=0x5A6275FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                let q = find_field.text()
                let (_, tot) = resolve_find_counts()
                if proto::find_is_empty_result(q, tot) {
                  p.danger
                } else {
                  p.ink_secondary
                }
              }))
            },
          )
        },
      )

      // `Aa` Case-Sensitivity Toggle Button (active accent highlight, real host re-query)
      let _ = headless::button(
        fbar,
        fn() -> String { "Match Case" },
        fn(_v : view::View) -> Unit { toggle_find_case_sensitive(active_stage()) },
        fn(ab : view::View, abtn : headless::Button) -> Unit {
          let _ = ab
          .width(view::Live::Is(Some(28.0)))
          .height(view::Live::Is(Some(26.0)))
          .rigid()
          .center()
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if find_case_sensitive.get() {
              p.accent_soft_bg
            } else if abtn.pressed() {
              p.btn_press
            } else if abtn.hovered() {
              p.btn_hover
            } else {
              0x00000000L
            }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            if find_case_sensitive.get() {
              (1.0, p.accent_soft_border)
            } else {
              (0.0, 0x00000000L)
            }
          }))
          let _ = ab.box(
            fn(al : view::View) -> Unit {
              let _ = al.words(
                view::Live::Is("Aa"),
                ink=0x5A6275FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if find_case_sensitive.get() {
                  p.accent_soft_ink
                } else if abtn.hovered() || abtn.pressed() {
                  p.ink_primary
                } else {
                  p.ink_secondary
                }
              }))
            },
          )
        },
      )

      // Single crisp vertical hairline between search controls & navigation buttons
      let _ = fbar.box(
        fn(vsep : view::View) -> Unit {
          let _ = vsep
          .width(view::Live::Is(Some(1.0)))
          .height(view::Live::Is(Some(16.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
        },
      )

      let find_nav_btn = fn(glyph : String, label : String, danger : Bool, on_click : () -> Unit) -> Unit {
        let _ = headless::button(
          fbar,
          fn() -> String { label },
          fn(_v : view::View) -> Unit { on_click() },
          fn(nb : view::View, nbtn : headless::Button) -> Unit {
            let _ = nb
            .width(view::Live::Is(Some(26.0)))
            .height(view::Live::Is(Some(26.0)))
            .rigid()
            .center()
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() -> Int64 {
              let p = chrome_palette()
              if danger {
                if nbtn.pressed() {
                  p.danger_border
                } else if nbtn.hovered() {
                  p.danger_bg
                } else {
                  0x00000000L
                }
              } else if nbtn.pressed() {
                p.btn_press
              } else if nbtn.hovered() {
                p.btn_hover
              } else {
                0x00000000L
              }
            }))
            let _ = nb.box(
              fn(gl : view::View) -> Unit {
                let _ = gl.words(
                  view::Live::Is(glyph),
                  ink=0x4B5563FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 500, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if danger && (nbtn.hovered() || nbtn.pressed()) {
                    p.danger
                  } else if nbtn.hovered() || nbtn.pressed() {
                    p.ink_primary
                  } else {
                    p.ink_secondary
                  }
                }))
              },
            )
          },
        )
      }

      find_nav_btn("‹", "Previous Match (Shift+Enter)", false, fn() -> Unit { dispatch_find_prev(active_stage()) })
      find_nav_btn("›", "Next Match (Enter)", false, fn() -> Unit { dispatch_find_next(active_stage()) })
      find_nav_btn("×", "Close Find Bar (Esc)", true, fn() -> Unit { close_find_bar(active_stage()) })
    },
  )
}

///| Upgraded Encrypted Browsing History Drawer (`Cmd/Ctrl+Y`, 500pt centered panel).
///| Real-time full-text search, `Today` / `Yesterday` / `Earlier` time buckets (zero empty groups,
///| zero dangling dividers), per-item delete, and bottom compact time-range clear bar
///| (`Last Hour` / `Last 24h` / `Last 7d` / `All`). Full Light & Dark `ChromePalette` parity.
fn build_history_drawer(
  root : view::View,
  st : stage::Stage,
  history_open : signals::Signal[Bool],
  history_rev : signals::Signal[Int],
  history_field : ui::Field,
) -> Unit {
  root.show(
    fn() -> Bool { history_open.get() },
    fn(h_layer : view::View) -> Unit {
      let _ = h_layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      let _ = headless::button(
        h_layer,
        fn() -> String { "Dismiss Browsing History" },
        fn(_v : view::View) -> Unit { close_history() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05070C66L } else { 0x0F172A30L }
          }))
        },
      )
      let _ = h_layer.box(
        fn(hpop : view::View) -> Unit {
          let panel_w = 500.0
          let inner_w = 476.0
          let _ = hpop
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            let rw = match app_state.root_view {
              Some(rv) => {
                let (w0, _) = rv.laid_size()
                w0
              }
              None => 1280.0
            }
            let left = if rw > panel_w + 32.0 { (rw - panel_w) / 2.0 } else { 16.0 }
            (Some(left), Some(56.0), None, None)
          }))
          .width(view::Live::Is(Some(panel_w)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(12.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            (1.0, if p.is_dark { 0x3A4154FFL } else { p.border })
          }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (32.0, 14.0, 0x00000099L) } else { (28.0, 12.0, 0x0F172A32L) }
          }))

          hpop.reacts(fn() -> String { history_field.text() }, fn(q : String) -> Unit {
            if history_open.untracked() {
              dispatch_history_query(q)
            }
          })

          let filtered_items = fn() -> Array[proto::HistoryItemSummary] {
            let _ = history_rev.get()
            let q = history_field.text()
            proto::history_filter_items(app_state.history_snap.items, q)
          }

          // Header row: "History" + live count pill + close `×`
          let _ = hpop.box(
            fn(hhdr : view::View) -> Unit {
              let _ = hhdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(inner_w)))
              .height(view::Live::Is(Some(28.0)))
              .rigid()
              .gap(view::Live::Is(8.0))
              .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
              let _ = hhdr.box(
                fn(ht : view::View) -> Unit {
                  let _ = ht.rigid().words(
                    view::Live::Is("History"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 600, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              let _ = hhdr.box(
                fn(hcnt_pill : view::View) -> Unit {
                  let _ = hcnt_pill
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  let _ = hcnt_pill.box(
                    fn(hcnt : view::View) -> Unit {
                      let _ = hcnt.words(
                        view::Live::By(fn() -> String {
                          let shown = filtered_items().length()
                          let total = app_state.history_snap.total_count
                          let q = history_field.text().trim()
                          if q != "" {
                            shown.to_string() + " of " + total.to_string()
                          } else if total == 1 {
                            "1 site"
                          } else {
                            total.to_string() + " sites"
                          }
                        }),
                        ink=0x5A6275FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                },
              )
              let _ = hhdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
              let _ = headless::button(
                hhdr,
                fn() -> String { "Close History" },
                fn(_v : view::View) -> Unit { close_history() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() {
                      p.btn_press
                    } else if xbtn.hovered() {
                      p.btn_hover
                    } else {
                      0x00000000L
                    }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl.words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if xbtn.hovered() || xbtn.pressed() { p.ink_primary } else { p.ink_muted }
                      }))
                    },
                  )
                },
              )
            },
          )

          // Real-time Search Input (`radius 8pt`, with conditional clear `×` + `⌘Y` badge)
          let _ = hpop.box(
            fn(hs_row : view::View) -> Unit {
              let _ = hs_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(inner_w)))
              .height(view::Live::Is(Some(36.0)))
              .rigid()
              .gap(view::Live::Is(8.0))
              .padding(view::Live::Is((12.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(8.0))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = hs_row.box(
                fn(hfw : view::View) -> Unit {
                  let _ = hfw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .clips(view::Live::Is(true))
                  hfw.show(
                    fn() -> Bool { !is_dark_chrome() },
                    fn(fl : view::View) -> Unit {
                      let _ = ui::field(
                        fl,
                        history_field,
                        placeholder="Search history by title or URL...",
                        font_size=13.0,
                        color=0x1D1D1FFFL,
                        placeholder_color=0x8E8E93FFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(_t : String) -> Unit {
                          let list = filtered_items()
                          if list.length() > 0 {
                            let u = list[0].url
                            close_history()
                            if u != "" {
                              st.go(u)
                            }
                          }
                        },
                      )
                    },
                  )
                  hfw.show(
                    fn() -> Bool { is_dark_chrome() },
                    fn(fd : view::View) -> Unit {
                      let _ = ui::field(
                        fd,
                        history_field,
                        placeholder="Search history by title or URL...",
                        font_size=13.0,
                        color=0xF1F5F9FFL,
                        placeholder_color=0x94A3B8FFL,
                        caret_color=0x60A5FAFFL,
                        max_lines=1,
                        enter_sends=true,
                        submitted=fn(_t : String) -> Unit {
                          let list = filtered_items()
                          if list.length() > 0 {
                            let u = list[0].url
                            close_history()
                            if u != "" {
                              st.go(u)
                            }
                          }
                        },
                      )
                    },
                  )
                },
              )
              hs_row.show(
                fn() -> Bool { history_field.text() != "" },
                fn(clr_wrap : view::View) -> Unit {
                  let _ = headless::button(
                    clr_wrap,
                    fn() -> String { "Clear Search" },
                    fn(_v : view::View) -> Unit {
                      history_field.set("")
                      dispatch_history_query("")
                    },
                    fn(cb : view::View, cbtn : headless::Button) -> Unit {
                      let _ = cb
                      .width(view::Live::Is(Some(20.0)))
                      .height(view::Live::Is(Some(20.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(5.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if cbtn.pressed() { p.btn_press } else if cbtn.hovered() { p.btn_hover } else { 0x00000000L }
                      }))
                      let _ = cb.box(
                        fn(cl : view::View) -> Unit {
                          let _ = cl.words(
                            view::Live::Is("×"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                            one_line=true,
                          ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )
                },
              )
              let _ = hs_row.box(
                fn(hk : view::View) -> Unit {
                  let _ = hk
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  let _ = hk.box(
                    fn(hkl : view::View) -> Unit {
                      let _ = hkl.words(
                        view::Live::Is("⌘Y"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Scrollable Time-Grouped History List (`Today` / `Yesterday` / `Earlier`, zero empty groups)
          let _ = hpop.box(
            fn(list_wrap : view::View) -> Unit {
              let _ = list_wrap
              .width(view::Live::Is(Some(inner_w)))
              .height(view::Live::By(fn() -> Option[Double] {
                let n = filtered_items().length()
                if n == 0 {
                  Some(92.0)
                } else {
                  let est = (n as Double) * 54.0 + 78.0
                  Some(if est > 480.0 { 480.0 } else { est })
                }
              }))
              .rigid()
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))

              let _ = ui::scroll_box(
                list_wrap,
                fn(scroller : view::View) -> Unit {
                  scroller.switch_by(
                    fn() -> Int {
                      let rev = history_rev.get()
                      let qlen = history_field.text().length()
                      let dark_bit = if is_dark_chrome() { 1 } else { 0 }
                      rev * 1024 + qlen * 2 + dark_bit
                    },
                    fn(items_col : view::View, _key : Int) -> Unit {
                      let _ = items_col.gap(view::Live::Is(4.0))
                      let list = filtered_items()
                      let now_s = app_now_secs()
                      if list.length() == 0 {
                        let _ = items_col.box(
                          fn(emp : view::View) -> Unit {
                            let _ = emp
                            .width(view::Live::Is(Some(inner_w)))
                            .height(view::Live::Is(Some(84.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(8.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                            let _ = emp.box(
                              fn(et : view::View) -> Unit {
                                let q = history_field.text().trim()
                                let msg = if q != "" {
                                  "No matching history for \"" + q + "\""
                                } else {
                                  "No browsing history yet"
                                }
                                let _ = et.words(
                                  view::Live::Is(msg),
                                  ink=0x8E8E93FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: false },
                                  one_line=true,
                                ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                              },
                            )
                          },
                        )
                      } else {
                        let max_n = if list.length() > proto::HISTORY_DRAWER_MAX_ITEMS {
                          proto::HISTORY_DRAWER_MAX_ITEMS
                        } else {
                          list.length()
                        }
                        let mut hi = 0
                        while hi < max_n {
                          let it = list[hi]
                          let sec_hdr = proto::history_section_header_at(list, hi, now_s)
                          if sec_hdr != "" {
                            let is_first_sec = hi == 0
                            let _ = items_col.box(
                              fn(sh : view::View) -> Unit {
                                let _ = sh
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .width(view::Live::Is(Some(inner_w)))
                                .padding(view::Live::Is((4.0, if is_first_sec { 2.0 } else { 8.0 }, 4.0, 2.0)))
                                .rigid()
                                let _ = sh.box(
                                  fn(sl : view::View) -> Unit {
                                    let _ = sl.words(
                                      view::Live::Is(sec_hdr),
                                      ink=0x6B7280FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                                      one_line=true,
                                    ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )
                              },
                            )
                          }
                          let item_url = it.url
                          let item_title = it.title
                          let item_host = it.host
                          let item_visits = it.visit_count
                          let item_age = proto::format_history_age(it.last_visit_secs, now_s)
                          let _ = items_col.box(
                            fn(hrow_box : view::View) -> Unit {
                              let _ = hrow_box
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .width(view::Live::Is(Some(inner_w)))
                              .height(view::Live::Is(Some(46.0)))
                              .rigid()
                              .clips(view::Live::Is(true))
                              .gap(view::Live::Is(6.0))
                              .padding(view::Live::Is((0.0, 0.0, 6.0, 0.0)))
                              .radius(view::Live::Is(8.0))
                              .ground(view::Live::By(fn() -> Int64 {
                                let p = chrome_palette()
                                if hrow_box.pointed() { p.tab_hover_bg } else { p.surface_subtle }
                              }))

                              // Main clickable area (monogram + title/host + age + visit count)
                              let _ = headless::button(
                                hrow_box,
                                fn() -> String { item_title },
                                fn(_v : view::View) -> Unit {
                                  close_history()
                                  if item_url != "" {
                                    st.go(item_url)
                                  }
                                },
                                fn(hmain : view::View, hbtn : headless::Button) -> Unit {
                                  let _ = hmain
                                  .row(view::Live::Is(true))
                                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                  .grow(view::Live::Is(1.0))
                                  .shrink(view::Live::Is(1.0))
                                  .basis(view::Live::Is(Some(0.0)))
                                  .min_width(view::Live::Is(Some(0.0)))
                                  .height(view::Live::Is(Some(46.0)))
                                  .clips(view::Live::Is(true))
                                  .gap(view::Live::Is(10.0))
                                  .padding(view::Live::Is((8.0, 0.0, 4.0, 0.0)))
                                  .radius(view::Live::Is(8.0))
                                  .ground(view::Live::By(fn() -> Int64 {
                                    if hbtn.pressed() { chrome_palette().tab_press_bg } else { 0x00000000L }
                                  }))
                                  // 24x24 monogram badge (radius 6pt)
                                  let _ = hmain.box(
                                    fn(mono : view::View) -> Unit {
                                      let (mbg, mfg) = favorite_badge_colors(item_url)
                                      let _ = mono
                                      .width(view::Live::Is(Some(24.0)))
                                      .height(view::Live::Is(Some(24.0)))
                                      .rigid()
                                      .center()
                                      .radius(view::Live::Is(6.0))
                                      .ground(view::Live::Is(mbg))
                                      let _ = mono.box(
                                        fn(ml : view::View) -> Unit {
                                          let _ = ml.words(
                                            view::Live::Is(proto::omnibox_initial_letter(item_url, item_title)),
                                            ink=mfg,
                                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                                            one_line=true,
                                          )
                                        },
                                      )
                                    },
                                  )
                                  // Title + Host
                                  let _ = hmain.box(
                                    fn(hmid : view::View) -> Unit {
                                      let _ = hmid
                                      .grow(view::Live::Is(1.0))
                                      .shrink(view::Live::Is(1.0))
                                      .basis(view::Live::Is(Some(0.0)))
                                      .min_width(view::Live::Is(Some(0.0)))
                                      .clips(view::Live::Is(true))
                                      .gap(view::Live::Is(1.0))
                                      let _ = hmid.box(
                                        fn(htitle : view::View) -> Unit {
                                          let _ = htitle
                                          .min_width(view::Live::Is(Some(0.0)))
                                          .clips(view::Live::Is(true))
                                          .words(
                                            view::Live::Is(item_title),
                                            ink=0x1D1D1FFFL,
                                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                                            one_line=true,
                                          ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                        },
                                      )
                                      let _ = hmid.box(
                                        fn(hhost : view::View) -> Unit {
                                          let _ = hhost
                                          .min_width(view::Live::Is(Some(0.0)))
                                          .clips(view::Live::Is(true))
                                          .words(
                                            view::Live::Is(item_host),
                                            ink=0x6B7280FFL,
                                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                            one_line=true,
                                          ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                        },
                                      )
                                    },
                                  )
                                  // Relative time
                                  if item_age != "" {
                                    let _ = hmain.box(
                                      fn(hage : view::View) -> Unit {
                                        let _ = hage.rigid().words(
                                          view::Live::Is(item_age),
                                          ink=0x8E8E93FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                          one_line=true,
                                        ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                      },
                                    )
                                  }
                                  // Visit count pill
                                  let _ = hmain.box(
                                    fn(hv : view::View) -> Unit {
                                      let _ = hv
                                      .height(view::Live::Is(Some(20.0)))
                                      .rigid()
                                      .center()
                                      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                      .radius(view::Live::Is(6.0))
                                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                                      let _ = hv.box(
                                        fn(hvl : view::View) -> Unit {
                                          let _ = hvl.words(
                                            view::Live::Is(item_visits.to_string() + "×"),
                                            ink=0x4B5563FFL,
                                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                            one_line=true,
                                          ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                                        },
                                      )
                                    },
                                  )
                                },
                              )

                              // Per-item delete button (cleanly visible, zero alpha=0 click-through)
                              let _ = headless::button(
                                hrow_box,
                                fn() -> String { "Remove from History" },
                                fn(_v : view::View) -> Unit {
                                  dispatch_history_delete(item_url)
                                  show_toast("Removed from history", "clear")
                                },
                                fn(db : view::View, dbtn : headless::Button) -> Unit {
                                  let _ = db
                                  .width(view::Live::Is(Some(22.0)))
                                  .height(view::Live::Is(Some(22.0)))
                                  .rigid()
                                  .center()
                                  .radius(view::Live::Is(5.0))
                                  .ground(view::Live::By(fn() -> Int64 {
                                    let p = chrome_palette()
                                    if dbtn.pressed() {
                                      p.danger_border
                                    } else if dbtn.hovered() {
                                      p.danger_bg
                                    } else {
                                      0x00000000L
                                    }
                                  }))
                                  let _ = db.box(
                                    fn(dl : view::View) -> Unit {
                                      let _ = dl.words(
                                        view::Live::Is("×"),
                                        ink=0x6B7280FFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                                        one_line=true,
                                      ).ink(view::Live::By(fn() -> Int64 {
                                        let p = chrome_palette()
                                        if dbtn.hovered() || dbtn.pressed() { p.danger } else { p.ink_muted }
                                      }))
                                    },
                                  )
                                },
                              )
                            },
                          )
                          hi = hi + 1
                        }
                      }
                    },
                  )
                },
              )
            },
          )

          // Single hairline separator above bottom time-range clear bar (zero double divider)
          let _ = hpop.box(
            fn(fsep : view::View) -> Unit {
              let _ = fsep
              .width(view::Live::Is(Some(inner_w)))
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Bottom Compact Time-Range Clear Bar (`Last Hour` / `Last 24h` / `Last 7d` / `All`)
          let _ = hpop.box(
            fn(hfoot : view::View) -> Unit {
              let _ = hfoot
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(inner_w)))
              .height(view::Live::Is(Some(30.0)))
              .rigid()
              .gap(view::Live::Is(6.0))
              .padding(view::Live::Is((2.0, 2.0, 2.0, 0.0)))

              let _ = hfoot.box(
                fn(flbl : view::View) -> Unit {
                  let _ = flbl.rigid().words(
                    view::Live::Is("Clear history"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                    one_line=true,
                  ).ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )

              let _ = hfoot.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

              let clear_range_btn = fn(range_key : String, label : String, danger : Bool) -> Unit {
                let _ = headless::button(
                  hfoot,
                  fn() -> String { "Clear History: " + label },
                  fn(_v : view::View) -> Unit { dispatch_history_clear_range(range_key) },
                  fn(cb : view::View, cbtn : headless::Button) -> Unit {
                    let _ = cb
                    .height(view::Live::Is(Some(24.0)))
                    .rigid()
                    .center()
                    .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if danger {
                        if cbtn.pressed() {
                          p.danger_border
                        } else if cbtn.hovered() {
                          p.danger_bg
                        } else {
                          p.danger_bg
                        }
                      } else if cbtn.pressed() {
                        p.btn_press
                      } else if cbtn.hovered() {
                        p.btn_hover
                      } else {
                        p.surface_subtle
                      }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      let p = chrome_palette()
                      if danger {
                        (1.0, p.danger_border)
                      } else {
                        (1.0, p.border)
                      }
                    }))
                    let _ = cb.box(
                      fn(cl : view::View) -> Unit {
                        let _ = cl.words(
                          view::Live::Is(label),
                          ink=0x5A6275FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                          one_line=true,
                        ).ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if danger {
                            p.danger
                          } else if cbtn.hovered() || cbtn.pressed() {
                            p.ink_primary
                          } else {
                            p.ink_secondary
                          }
                        }))
                      },
                    )
                  },
                )
              }

              clear_range_btn("hour", "Last Hour", false)
              clear_range_btn("24h", "Last 24h", false)
              clear_range_btn("7d", "Last 7d", false)
              clear_range_btn("all", "All", true)
            },
          )
        },
      )
    },
  )
}
