///| Non-UI overlay state transitions, host state setters, wire dispatchers,
///| demo data seeders, and shared helpers extracted from legacy view files
///| so Shell 2.0 view replacements can remove legacy `*_view.pion` files
///| without losing production logic.

// --- Tab Search & Capture Sheet State ---

fn current_tab_search_results() -> proto::TabSearchResult {
  let q = match app_state.tab_search_query {
    Some(s) => s.get()
    None => ""
  }
  proto::build_tab_search_results(
    app_state.workspace,
    app_state.closed_tabs_snap,
    q,
    max_open=proto::TAB_SEARCH_MAX_OPEN,
    max_closed=proto::TAB_SEARCH_MAX_CLOSED,
  )
}

fn current_tab_search_results_untracked() -> proto::TabSearchResult {
  let q = match app_state.tab_search_query {
    Some(s) => s.untracked()
    None => ""
  }
  proto::build_tab_search_results(
    app_state.workspace,
    app_state.closed_tabs_snap,
    q,
    max_open=proto::TAB_SEARCH_MAX_OPEN,
    max_closed=proto::TAB_SEARCH_MAX_CLOSED,
  )
}

fn close_tab_search() -> Unit {
  match app_state.tab_search_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.tab_search_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("tab_search")
}

fn open_tab_search(initial_query~ : String = "") -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.tab_search_query {
    Some(s) => s.set(initial_query)
    None => ()
  }
  match app_state.tab_search_selected {
    Some(sel) => sel.set(0)
    None => ()
  }
  match app_state.tab_search_field {
    Some(f) => {
      f.set(initial_query)
      f.focus()
      f.pick(initial_query.length(), initial_query.length())
    }
    None => ()
  }
  match app_state.tab_search_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::TabSearch, "tab_search")
  dispatch_workspace_sync()
  dispatch_closed_tabs_sync()
}

fn toggle_tab_search() -> Unit {
  let is_open = match app_state.tab_search_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_tab_search()
  } else {
    open_tab_search()
  }
}

fn step_tab_search_selection(delta : Int) -> Unit {
  let res = current_tab_search_results_untracked()
  let total = res.total_count()
  match app_state.tab_search_selected {
    Some(sel) => sel.set(proto::tab_search_step_selection(sel.untracked(), delta, total))
    None => ()
  }
}

fn activate_tab_search_item(item : proto::TabSearchItem) -> Unit {
  close_tab_search()
  if item.is_open {
    dispatch_tab_switch(item.id)
  } else {
    dispatch_tab_reopen_at(item.closed_index, item.title)
  }
}

fn commit_tab_search_selection() -> Unit {
  let res = current_tab_search_results_untracked()
  let idx = match app_state.tab_search_selected {
    Some(sel) => sel.untracked()
    None => 0
  }
  match res.item_at(idx) {
    Some(it) => activate_tab_search_item(it)
    None => if res.total_count() > 0 {
      match res.item_at(0) {
        Some(first) => activate_tab_search_item(first)
        None => ()
      }
    }
  }
}

