}

// --- Start Page & Site Info / Permissions State ---

fn dispatch_site_perms_sync() -> Unit {
  send_wire(wire::Message::Act("site_perms_sync", "", ""))
}

fn site_perm_display_kind(kind : String) -> String {
  if kind == "camera" {
    "Camera"
  } else if kind == "microphone" {
    "Microphone"
  } else if kind == "notifications" {
    "Notifications"
  } else if kind == "geolocation" {
    "Location"
  } else if kind == "clipboard" {
    "Clipboard"
  } else {
    kind
  }
}

fn site_perm_display_state(state : String) -> String {
  let n = proto::normalize_site_perm_value(state)
  if n == "allow" {
    "Allow"
  } else if n == "block" {
    "Block"
  } else {
    "Ask"
  }
}

fn site_perms_upsert_local(origin : String, kind : String, value : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    return
  }
  let rules = app_state.site_perms_snap.rules
  let mut idx = -1
  let mut i = 0
  while i < rules.length() {
    if proto::normalize_permission_origin(rules[i].origin) == norm_origin {
      idx = i
      break
    }
    i = i + 1
  }
  let base = if idx >= 0 {
    rules[idx]
  } else {
    proto::SitePermissionRule::default_for(norm_origin)
  }
  let updated = proto::site_perm_rule_with(base, kind, value)
  let next_rules : Array[proto::SitePermissionRule] = []
  let mut j = 0
  while j < rules.length() {
    if j != idx {
      next_rules.push(rules[j])
    }
    j = j + 1
  }
  if proto::site_perm_rule_has_custom(updated) {
    next_rules.push(updated)
  }
  app_state.site_perms_snap = proto::SitePermissionsSnapshot::{ rules: next_rules }
  match app_state.site_perms_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

fn dispatch_site_perm_set(origin : String, kind : String, value : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    show_toast("Permissions apply to web origins", "info")
    return
  }
  let norm_val = proto::normalize_site_perm_value(value)
  site_perms_upsert_local(norm_origin, kind, norm_val)
  send_wire(wire::Message::Act("site_perm_set", norm_origin + "|" + kind, norm_val))
  show_toast(site_perm_display_kind(kind) + ": " + site_perm_display_state(norm_val), "perm")
}

fn dispatch_site_perm_reset(origin : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    return
  }
  let rules = app_state.site_perms_snap.rules
  let next_rules : Array[proto::SitePermissionRule] = []
  let mut i = 0
  while i < rules.length() {
    if proto::normalize_permission_origin(rules[i].origin) != norm_origin {
      next_rules.push(rules[i])
    }
    i = i + 1
  }
  app_state.site_perms_snap = proto::SitePermissionsSnapshot::{ rules: next_rules }
  match app_state.site_perms_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("site_perm_reset", norm_origin, ""))
  show_toast("Permissions reset to Ask", "perm")
}

fn dispatch_site_clear_data(origin : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    show_toast("No site data for this page", "info")
    return
  }
  let host = proto::history_url_host(norm_origin)
  let rules = app_state.site_perms_snap.rules
  let next_rules : Array[proto::SitePermissionRule] = []
  let mut i = 0
  while i < rules.length() {
    if proto::normalize_permission_origin(rules[i].origin) != norm_origin {
      next_rules.push(rules[i])
    }
    i = i + 1
  }
  app_state.site_perms_snap = proto::SitePermissionsSnapshot::{ rules: next_rules }
  match app_state.site_perms_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("site_clear_data", norm_origin, ""))
  let label = if host != "" { host } else { norm_origin }
  show_toast("Cleared site data for " + label, "clear")
}

fn set_host_site_perms_state(json : String) -> Unit {
  match proto::parse_site_permissions_snapshot(json, max_items=256) {
    Some(snap) => {
      app_state.site_perms_snap = snap
      match app_state.site_perms_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_site_perms_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn active_site_permission_rule(url : String) -> proto::SitePermissionRule {
  let _ = match app_state.site_perms_rev {
    Some(r) => r.get()
    None => 0
  }
  let _ = match app_state.workspace_rev {
    Some(r) => r.get()
    None => 0
  }
  let origin = proto::normalize_permission_origin(url)
  let base = proto::site_perms_rule_for(app_state.site_perms_snap, origin)
  if proto::site_perm_rule_has_custom(base) {
    return base
  }
  // Fallback to WorkspaceState permissions if no tag-62 custom rule yet
  match app_state.workspace.permissions {
    Some(pm) if proto::normalize_permission_origin(pm.origin) == origin && origin != "" =>
    proto::SitePermissionRule::{
      origin: origin,
      camera: proto::normalize_site_perm_value(pm.camera),
      microphone: proto::normalize_site_perm_value(pm.microphone),
      notifications: proto::normalize_site_perm_value(pm.notifications),
      geolocation: base.geolocation,
      clipboard: proto::normalize_site_perm_value(pm.clipboard_read),
    }
    _ => base
  }
}

fn submit_start_page_search(st : stage::Stage, raw : String) -> Unit {
  let trimmed = raw.trim()
  if trimmed == "" {
    return
  }
  let target = proto::omnibox_normalize_input_with_engine(
    trimmed,
    app_state.settings.search_engine,
    https_only=app_state.settings.https_only,
  )
  match app_state.start_page_field {
    Some(f) => {
      f.set("")
      if f.focused() {
        f.let_go()
      }
    }
    None => ()
  }
  app_state.initial_start_page_open = false
  if target != "" {
    st.go(target)
  }
}

