    let raw_u = active_address_raw_url_untracked()
    let host = {
      let h = proto::omnibox_display_host(raw_u)
      if h != "" { h } else { "example.com" }
    }
    let origin = {
      let o = proto::normalize_permission_origin(raw_u)
      if o != "" { o } else { "https://" + host }
    }
    app_state.cookies_snap = proto::SiteCookiesSnapshot::{
      host,
      origin,
      space_id: app_state.workspace.active_space_id,
      cookies: [
        proto::SiteCookieRow::{ name: "fv_session", domain: host, path: "/", value_preview: "a8f1••••9c2d (48 B)", secure: true, http_only: true, same_site: "Lax", partitioned: false, expires_label: "Session", is_session: true },
        proto::SiteCookieRow::{ name: "theme_pref", domain: host, path: "/", value_preview: "light (5 B)", secure: true, http_only: false, same_site: "Lax", partitioned: false, expires_label: "1y", is_session: false },
        proto::SiteCookieRow::{ name: "csrf_token", domain: host, path: "/", value_preview: "91e4••••44ba (32 B)", secure: true, http_only: true, same_site: "Strict", partitioned: true, expires_label: "12h", is_session: false },
        proto::SiteCookieRow::{ name: "locale", domain: host, path: "/", value_preview: "zh-CN (5 B)", secure: true, http_only: false, same_site: "Lax", partitioned: false, expires_label: "90d", is_session: false },
      ],
    }
    match app_state.cookies_rev {
      Some(r) => r.set(r.untracked() + 1)
      None => ()
    }
  }
}

// --- IDN Spoofing Warning State ---

fn active_address_raw_url() -> String {
  if app_state.demo_idn_url != "" {
    app_state.demo_idn_url
  } else {
    active_stage_live().url()
  }
}

fn active_address_raw_url_untracked() -> String {
  if app_state.demo_idn_url != "" {
    app_state.demo_idn_url
  } else {
    active_stage().url()
  }
}

fn current_url_safety() -> proto::OmniboxUrlSafety {
  proto::omnibox_analyze_url(active_address_raw_url())
}

fn close_idn_popover() -> Unit {
  match app_state.idn_popover_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("idn_popover")
}

fn toggle_idn_popover() -> Unit {
  match app_state.idn_popover_open {
    Some(s) => {
      let next = !s.untracked()
      if next {
        close_exclusive_overlays()
        s.set(true)
        shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "idn_popover")
      } else {
        close_idn_popover()
      }
    }
    None => ()
  }
}

// --- Media Hub State & Shared Mute Glyph Helper ---

fn dispatch_media_hub_sync() -> Unit {
  send_wire(wire::Message::Act("media_hub_sync", "", ""))
}

fn dispatch_media_toggle_play(tab_id : String) -> Unit {
  let tid = tab_id.trim()
  let sessions = app_state.media_hub_snap.sessions
  let next : Array[proto::MediaSessionItem] = []
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    if (tid != "" && s.tab_id == tid) || (tid == "" && i == 0) {
      next.push(proto::MediaSessionItem::{ ..s, playing: !s.playing })
    } else {
      next.push(s)
    }
    i = i + 1
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: next }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("media_toggle_play", tid, ""))
}

fn dispatch_media_toggle_mute(tab_id : String) -> Unit {
  let tid = tab_id.trim()
  let sessions = app_state.media_hub_snap.sessions
  let next : Array[proto::MediaSessionItem] = []
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    if (tid != "" && s.tab_id == tid) || (tid == "" && i == 0) {
      next.push(proto::MediaSessionItem::{ ..s, muted: !s.muted })
    } else {
      next.push(s)
    }
    i = i + 1
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: next }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("media_toggle_mute", tid, ""))
}

fn dispatch_media_mute_all() -> Unit {
  let sessions = app_state.media_hub_snap.sessions
  let next : Array[proto::MediaSessionItem] = []
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    next.push(proto::MediaSessionItem::{ ..s, muted: true })
    i = i + 1
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: next }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("media_mute_all", "", ""))
  show_toast("Muted all media sessions", "info")
}

fn set_host_media_hub_state(json : String) -> Unit {
  match proto::parse_media_hub_snapshot(json) {
    Some(snap) => {
      app_state.media_hub_snap = snap
      match app_state.media_hub_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_media_hub_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_media_hub() -> Unit {
  match app_state.media_hub_open {
    Some(s) => s.set(false)
    None => ()
  }
  shell_mark_exclusive_closed("media_hub")
}

fn open_media_hub() -> Unit {
  close_exclusive_overlays()
  match app_state.media_hub_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "media_hub")
  dispatch_media_hub_sync()
}

fn toggle_media_hub() -> Unit {
  let is_open = match app_state.media_hub_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_media_hub()
  } else {
    open_media_hub()
  }
}

///| Returns the effective `MediaHubSnapshot`, falling back to `workspace.media`
///| if `MediaHubState` has not yet reported sessions.
fn effective_media_hub_snapshot() -> proto::MediaHubSnapshot {
  if app_state.media_hub_snap.sessions.length() > 0 {
    return app_state.media_hub_snap
  }
  match app_state.workspace.media {
    Some(m) =>
    proto::MediaHubSnapshot::{
      sessions: [
        proto::normalize_media_session_item(
          proto::MediaSessionItem::{
            tab_id: m.tab_id,
            title: m.title,
            artist_or_host: m.host,
            url: if m.host != "" { "https://" + m.host } else { "" },
            playing: m.playing,
            muted: m.muted,
            is_live_call: m.is_meeting,
            duration_secs: if m.is_meeting { 0 } else { 240 },
            position_secs: if m.is_meeting { 0 } else { 96 },
          },
        ),
      ],
    }
    None => proto::MediaHubSnapshot::empty()
  }
}

fn mh_draw_mute_glyph(parent : view::View, is_muted : () -> Bool) -> Unit {
  let spk_ink = fn() -> Int64 {
    let p = chrome_palette()
    if is_muted() { p.danger } else { p.ink_primary }
  }
  let _ = parent.box(
    fn(spk : view::View) -> Unit {
      let _ = spk
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .rigid()
      .gap(view::Live::Is(1.5))
      let _ = spk.box(
        fn(sb1 : view::View) -> Unit {
          let _ = sb1
          .width(view::Live::Is(Some(3.0)))
          .height(view::Live::Is(Some(5.0)))
          .rigid()
          .radius(view::Live::Is(1.0))
          .ground(view::Live::By(spk_ink))
        },
      )
      let _ = spk.box(
        fn(sc1 : view::View) -> Unit {
          let _ = sc1
          .width(view::Live::Is(Some(3.5)))
          .height(view::Live::Is(Some(9.0)))
          .rigid()
          .radius(view::Live::Is(1.2))
          .ground(view::Live::By(spk_ink))
        },
      )
      spk.show(
        fn() -> Bool { !is_muted() },
        fn(wv : view::View) -> Unit {
          let _ = wv
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(1.5))
          let _ = wv.box(
            fn(w1 : view::View) -> Unit {
              let _ = w1
              .width(view::Live::Is(Some(1.5)))
              .height(view::Live::Is(Some(5.0)))
              .rigid()
              .radius(view::Live::Is(0.8))
              .ground(view::Live::By(spk_ink))
            },
          )
          let _ = wv.box(
            fn(w2 : view::View) -> Unit {
              let _ = w2
              .width(view::Live::Is(Some(1.5)))
              .height(view::Live::Is(Some(8.0)))
              .rigid()
              .radius(view::Live::Is(0.8))
              .ground(view::Live::By(spk_ink))
            },
          )
        },
      )
      spk.show(
        is_muted,
        fn(xm : view::View) -> Unit {
          let _ = xm
          .words(
            view::Live::Is("×"),
            ink=0xDC2626FFL,
            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
            one_line=true,
          )
          .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
        },
      )
    },
  )
}

// --- Tab Filter & Zoom Popover State ---

fn dispatch_tab_close_others(tab_id : String) -> Unit {
  let count = proto::tab_close_others_count(app_state.workspace, tab_id)
  if count <= 0 {
    return
  }
  send_wire(wire::Message::Act("tab_close_others", tab_id, ""))
  let is_macos = ui::keys_system() <= 0
  let undo_hint = if is_macos { "⌘⇧T" } else { "Ctrl+Shift+T" }
  let noun = if count == 1 { "1 Other Tab" } else { count.to_string() + " Other Tabs" }
  show_toast("Closed " + noun + " · " + undo_hint + " to Undo", "close")
}

fn close_zoom_popover() -> Unit {
  match app_state.zoom_popover_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("zoom_popover")
}

fn open_zoom_popover() -> Unit {
  close_exclusive_overlays()
  match app_state.zoom_popover_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "zoom_popover")
}

fn toggle_zoom_popover() -> Unit {
  let is_open = match app_state.zoom_popover_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_zoom_popover()
  } else {
    open_zoom_popover()
  }
}

fn clear_tab_filter_query_only() -> Unit {
  match app_state.tab_filter_query {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.tab_filter_field {
    Some(f) => {
      if f.text() != "" {
        f.set("")
      }
      f.focus()
    }
    None => ()
  }
}

