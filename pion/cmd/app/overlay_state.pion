// --- Capture Sheet Overlay State Transitions ---

fn close_capture_sheet() -> Unit {
  match app_state.capture_sheet_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_sync_passive_from_app()
}

fn open_capture_sheet(meta : proto::CaptureSheetMeta) -> Unit {
  app_state.capture_sheet_meta = meta
  match app_state.capture_sheet_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.capture_sheet_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_sync_passive_from_app()
}

fn copy_capture_sheet_path() -> Unit {
  let meta = app_state.capture_sheet_meta
  let target = if meta.path != "" { meta.path } else { meta.filename }
  if target != "" {
    write_os_clipboard(target)
    show_toast("Copied screenshot path", "copy")
  }
}

let test_reveal_file_hook : signals::Ref[Option[(String) -> Bool]] = ui::ref_new(None)

fn reveal_os_file(path : String) -> Bool {
  let trimmed = path.trim()
  if trimmed == "" {
    return false
  }
  match test_reveal_file_hook.v {
    Some(hook) => hook(trimmed)
    None => {
      let b = trimmed.to_bytes()
      let rc = c_reveal_file(bytes_data_ptr(b), b.length())
      if b.length() < 0 {
        panic("unreachable")
      }
      rc == 0
    }
  }
}

fn reveal_capture_sheet_file() -> Unit {
  let meta = app_state.capture_sheet_meta
  let target = meta.path.trim()
  if target == "" {
    show_toast("Could not locate screenshot file", "error")
    return
  }
  if reveal_os_file(target) {
    let label = if meta.filename != "" { meta.filename } else { target }
    show_toast("Revealed in Finder: " + label, "info")
  } else {
    show_toast("Could not locate screenshot file", "error")
  }
}

