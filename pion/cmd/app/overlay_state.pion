///| Ensures 6 realistic Favorite tabs exist in the active Space when `--demo-favorites` is active,
///| including a playing media badge on YouTube for full Metal offscreen verification.
fn ensure_demo_favorites_seeded() -> Unit {
  if !app_state.demo_favorites {
    return
  }
  let sid = if app_state.workspace.active_space_id != "" {
    app_state.workspace.active_space_id
  } else {
    "default"
  }
  let existing_favs = proto::workspace_favorite_tiles(app_state.workspace, sid)
  if existing_favs.length() >= 6 {
    return
  }
  let demo_entries : Array[(String, String, String, Bool)] = [
    ("fav-demo-gh", "GitHub", "https://github.com/AFK-surf/farview", true),
    ("fav-demo-yt", "YouTube", "https://www.youtube.com/watch?v=farview", false),
    ("fav-demo-mdn", "MDN Web Docs", "https://developer.mozilla.org/en-US/docs/Web/CSS", false),
    ("fav-demo-ln", "Linear", "https://linear.app/farview/active", false),
    ("fav-demo-fg", "Figma", "https://www.figma.com/file/arc-glass", false),
    ("fav-demo-wk", "Wikipedia", "https://en.wikipedia.org/wiki/Metal_(API)", false),
  ]
  let new_tabs : Array[proto::TabSummary] = []
  let mut has_active_fav = false
  let mut di = 0
  while di < demo_entries.length() {
    let e = demo_entries[di]
    let mut exists = false
    let mut ti = 0
    while ti < app_state.workspace.tabs.length() {
      if app_state.workspace.tabs[ti].id == e.0 {
        exists = true
        break
      }
      ti = ti + 1
    }
    if !exists {
      if e.3 {
        has_active_fav = true
      }
      new_tabs.push(proto::TabSummary::{
        id: e.0,
        space_id: sid,
        title: e.1,
        url: e.2,
        pinned: true,
        favorite: true,
        active: e.3,
        state: "active",
        folder_id: "",
        last_active_secs: 1795519000L - di.to_int64() * 60L,
      })
    }
    di = di + 1
  }
  let mut k = 0
  while k < app_state.workspace.tabs.length() {
    let t = app_state.workspace.tabs[k]
    new_tabs.push(proto::TabSummary::{
      id: t.id,
      space_id: t.space_id,
      title: t.title,
      url: t.url,
      pinned: t.pinned,
      favorite: t.favorite,
      active: if has_active_fav { false } else { t.active },
      state: t.state,
      folder_id: t.folder_id,
      last_active_secs: t.last_active_secs,
    })
    k = k + 1
  }
  let media_opt : Option[proto::MediaMiniState] = match app_state.workspace.media {
    Some(m) => Some(m)
    None =>
    Some(proto::MediaMiniState::{
      tab_id: "fav-demo-yt",
      title: "Farview Metal Architecture Deep Dive",
      host: "youtube.com",
      playing: true,
      muted: false,
      is_meeting: false,
      accent: "#DC2626",
    })
  }
  let ws = app_state.workspace
  let spaces : Array[proto::SpaceSummary] = if ws.spaces.length() > 0 {
    let sp_out : Array[proto::SpaceSummary] = []
    let mut si = 0
    while si < ws.spaces.length() {
      let sp = ws.spaces[si]
      let mut cnt = 0
      let mut tj = 0
      while tj < new_tabs.length() {
        if new_tabs[tj].space_id == sp.id {
          cnt = cnt + 1
        }
        tj = tj + 1
      }
      sp_out.push(proto::SpaceSummary::{ ..sp, tab_count: if cnt > 0 { cnt } else { sp.tab_count } })
      si = si + 1
    }
    sp_out
  } else {
    [
      proto::SpaceSummary::{
        id: sid,
        name: if app_state.space_name != "" { app_state.space_name } else { "Work" },
        accent: "#2563EB",
        active: true,
        tab_count: new_tabs.length(),
      },
    ]
  }
  app_state.workspace = proto::WorkspaceSnapshot::{
    active_space_id: sid,
    active_tab_id: if has_active_fav { "fav-demo-gh" } else { ws.active_tab_id },
    spaces: spaces,
    folders: ws.folders,
    tabs: new_tabs,
    permissions: ws.permissions,
    closed_count: ws.closed_count,
    media: media_opt,
    nav_back: ws.nav_back,
    nav_forward: ws.nav_forward,
  }
  match app_state.workspace_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

// --- Bookmarks Bar State ---

fn toggle_bookmarks_bar() -> Unit {
  match app_state.bookmarks_bar_open {
    Some(sig) => {
      let next = !sig.untracked()
      sig.set(next)
      if next {
        dispatch_bookmarks_sync()
      } else {
        close_bm_bar_ctx()
      }
      shell_sync_dock_from_app()
    }
    None => ()
  }
}

fn close_bm_bar_ctx() -> Unit {
  match app_state.bm_bar_ctx_open {
    Some(s) => s.set(false)
    None => ()
  }
  shell_mark_exclusive_closed("bm_bar_ctx")
}

fn open_bm_bar_ctx(bm_id : String, bm_url : String, x : Double) -> Unit {
  close_exclusive_overlays()
  match app_state.bm_bar_ctx_id {
    Some(s) => s.set(bm_id)
    None => ()
  }
  match app_state.bm_bar_ctx_url {
    Some(s) => s.set(bm_url)
    None => ()
  }
  match app_state.bm_bar_ctx_x {
    Some(s) => s.set(if x < 12.0 { 12.0 } else { x })
    None => ()
  }
  match app_state.bm_bar_ctx_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Menu, "bm_bar_ctx")
}

fn ensure_demo_bookmarks_bar_seeded() -> Unit {
  if !app_state.demo_bookmarks_bar {
    return
  }
  if app_state.bookmarks_snap.items.length() > 0 {
    return
  }
  app_state.bookmarks_snap = proto::BookmarksSnapshot::{
    items: [
      proto::BookmarkEntry::{ id: "bm-gh", title: "GitHub", url: "https://github.com/AFK-surf/farview", folder: "Dev", created_ms: 1732400001000L },
      proto::BookmarkEntry::{ id: "bm-mdn", title: "MDN Web Docs", url: "https://developer.mozilla.org/en-US/docs/Web/CSS", folder: "Dev", created_ms: 1732400002000L },
      proto::BookmarkEntry::{ id: "bm-linear", title: "Linear", url: "https://linear.app/farview", folder: "Work", created_ms: 1732400003000L },
      proto::BookmarkEntry::{ id: "bm-figma", title: "Figma Design", url: "https://www.figma.com/files/recent", folder: "Design", created_ms: 1732400004000L },
      proto::BookmarkEntry::{ id: "bm-hn", title: "Hacker News", url: "https://news.ycombinator.com/", folder: "Reading", created_ms: 1732400005000L },
      proto::BookmarkEntry::{ id: "bm-wiki", title: "Metal API", url: "https://en.wikipedia.org/wiki/Metal_(API)", folder: "Reading", created_ms: 1732400006000L },
    ],
  }
  match app_state.bookmarks_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

