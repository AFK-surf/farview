  app_state.media_hub_snap = proto::MediaHubSnapshot::{
    sessions: [
      proto::MediaSessionItem::{
        tab_id: "tab-spotify",
        title: "Deep Work Piano — Focus Mix",
        artist_or_host: "open.spotify.com",
        url: "https://open.spotify.com/playlist/deep-work",
        playing: true,
        muted: false,
        is_live_call: false,
        duration_secs: 280,
        position_secs: 184,
      },
    ],
  }
  app_state.split_pending_url = "https://developer.mozilla.org/en-US/docs/Web/CSS"
  let _ = shell_page_open_split(0)
  match app_state.workspace_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.mini_player_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

// ============================================================================
// 8. Live Production Shell 2.0 Frame Bridge (mounted from `build_view`)
// ============================================================================

fn build_live_shell_frame(
  root : view::View,
  st : stage::Stage,
  address : ui::Field,
  omnibox_open : signals::Signal[Bool],
  omnibox_rev : signals::Signal[Int],
  omnibox_selected : signals::Signal[Int],
  omnibox_editing : signals::Signal[Bool],
  chrome_theme : signals::Signal[String],
  workspace_rev : signals::Signal[Int],
  media_hub_rev : signals::Signal[Int],
  mini_player_rev : signals::Signal[Int],
  bookmarks_bar_open : signals::Signal[Bool],
  bookmarks_rev : signals::Signal[Int],
  boosts_rev : signals::Signal[Int],
  history_rev : signals::Signal[Int],
  settings_rev : signals::Signal[Int],
  peek_url : signals::Signal[String],
  shift_held : signals::Signal[Bool],
  tab_filter_open : signals::Signal[Bool],
  tab_filter_query : signals::Signal[String],
  tab_filter_field : ui::Field,
  folder_create_open : signals::Signal[Bool],
  folder_create_color : signals::Signal[String],
  folder_create_move_active : signals::Signal[Bool],
  folder_create_field : ui::Field,
  idn_popover_open : signals::Signal[Bool],
  start_page_field : ui::Field,
  reader_open : signals::Signal[Bool],
  reader_rev : signals::Signal[Int],
  reader_theme : signals::Signal[String],
  reader_font : signals::Signal[String],
  reader_font_size : signals::Signal[Int],
  reader_width_mode : signals::Signal[String],
  reader_progress : signals::Signal[Double],
  find_open : signals::Signal[Bool],
  find_field : ui::Field,
  find_case_sensitive : signals::Signal[Bool],
  host_find_synced : signals::Signal[Bool],
  host_find_active : signals::Signal[Int],
  host_find_total : signals::Signal[Int],
  devtools_open : signals::Signal[Bool],
  devtools_height : signals::Signal[Double],
  devtools_dragging : signals::Signal[Bool],
  devtools_tab : signals::Signal[Int],
  devtools_rev : signals::Signal[Int],
  devtools_selected_path : signals::Signal[String],
  devtools_console_filter : signals::Signal[Int],
  devtools_repl_field : ui::Field,
  devtools_net_filter : signals::Signal[String],
  devtools_net_query : signals::Signal[String],
  devtools_net_search_field : ui::Field,
  devtools_net_selected_idx : signals::Signal[Int],
  command_bar_rev : signals::Signal[Int],
  command_bar_selected : signals::Signal[Int],
  command_bar_field : ui::Field,
  tab_search_query : signals::Signal[String],
  tab_search_selected : signals::Signal[Int],
  tab_search_field : ui::Field,
  closed_tabs_rev : signals::Signal[Int],
) -> Unit {
  // Live Shell 2.0 Model backed 100% by `shell_adapter` + `cmd/app` signals (zero duplicate state)
  let live_shell_model = shell_ui::ShellModel::{
    url: fn() -> String { st.url() },
    title: fn() -> String { st.title() },
    secondary_url: fn() -> String {
      match app_state.split_stage {
        Some(sp) if sp.url() != "" => sp.url()
        _ => peek_url.get()
      }
    },
    secondary_title: fn() -> String {
      match app_state.split_stage {
        Some(sp) => sp.title()
        None => ""
      }
    },
    active_url: fn() -> String { active_address_raw_url() },
    active_title: fn() -> String { active_stage_live().title() },
    loading: fn() -> Bool { active_stage_live().loading() },
    can_back: fn() -> Bool { active_stage_live().can_back() },
    can_forward: fn() -> Bool { active_stage_live().can_forward() },
    omnibox_security: fn() -> shell_ui::OmniboxSecurity {
      let cur = active_address_raw_url()
      let safe = proto::omnibox_safe_display_url(cur)
      let editing = omnibox_editing.get() || address.focused()
      if editing || address.text() != safe {
        shell_ui::OmniboxSecurity::EditingSearch
      } else {
        shell_ui::classify_omnibox_security(cur, false)
      }
    },
    omnibox_editing: fn() -> Bool { omnibox_editing.get() },
    dark: fn() -> Bool { chrome_theme.get() == "dark" },
    dock: fn() -> shell_ui::DockState { shell_adapter.dock.get() },
    page: fn() -> shell_ui::PageLayoutState { shell_adapter.page.get() },
    exclusive: fn() -> shell_ui::ExclusiveState { shell_adapter.exclusive.get() },
    passive: fn() -> shell_ui::PassiveState { shell_adapter.passive.get() },
    omnibox_field: address,
    omnibox_suggest: fn() -> proto::OmniSuggestState {
      let _ = omnibox_rev.get()
      proto::OmniSuggestState::{
        open: omnibox_open.get() && app_state.omni_suggest_items.length() > 0,
        query: app_state.omnibox_last_query,
        items: app_state.omni_suggest_items,
        selected: omnibox_selected.get(),
      }
    },
    favorites: fn() -> Array[shell_ui::ShellFavoriteItem] {
      let _ = workspace_rev.get()
      let favs = proto::workspace_favorite_tiles(app_state.workspace, app_state.workspace.active_space_id)
      let out : Array[shell_ui::ShellFavoriteItem] = []
      let mut i = 0
      while i < favs.length() {
        let f = favs[i]
        let (bg, _) = favorite_badge_colors(f.url)
        let ttl = proto::workspace_tab_display_title(f)
        let mono = if ttl.length() > 0 { ttl.slice(0, 1) } else { "F" }
        out.push(shell_ui::ShellFavoriteItem::{
          id: f.id,
          title: ttl,
          url: f.url,
          monogram: mono,
          accent_rgba: bg,
        })
        i += 1
      }
      out
    },
    folders: fn() -> Array[shell_ui::ShellFolderItem] {
      let _ = workspace_rev.get()
      let sid = app_state.workspace.active_space_id
      let flds = proto::workspace_filtered_folders(app_state.workspace, sid, tab_filter_query.get())
      let out : Array[shell_ui::ShellFolderItem] = []
      let mut i = 0
      while i < flds.length() {
        let fl = flds[i]
        out.push(shell_ui::ShellFolderItem::{
          id: fl.id,
          name: fl.name,
          collapsed: fl.collapsed,
        })
        i += 1
      }
      out
    },
    tabs: fn() -> Array[shell_ui::ShellTabItem] {
      let _ = workspace_rev.get()
      let _ = media_hub_rev.get()
      let filter_q = tab_filter_query.get().trim()
      let all = app_state.workspace.tabs
      let out : Array[shell_ui::ShellTabItem] = []
      let mut i = 0
      while i < all.length() {
        let tb = all[i]
        if filter_q == "" || proto::workspace_tab_matches_filter(tb, filter_q) {
          let ttl = proto::workspace_tab_display_title(tb)
          let (pl, mu) = tab_preview_media_state(tb)
          out.push(shell_ui::ShellTabItem::{
            id: tb.id,
            title: ttl,
            url: tb.url,
            folder_id: tb.folder_id,
            space_id: tb.space_id,
            pinned: tb.pinned,
            active: tb.active || tb.id == app_state.workspace.active_tab_id,
            playing_audio: pl,
            muted: mu,
          })
        }
        i += 1
      }
      out
    },
    spaces: fn() -> Array[shell_ui::ShellSpaceItem] {
      let _ = workspace_rev.get()
      let sps = app_state.workspace.spaces
      let out : Array[shell_ui::ShellSpaceItem] = []
      let mut i = 0
      while i < sps.length() {
        let sp = sps[i]
        out.push(shell_ui::ShellSpaceItem::{
          id: sp.id,
          name: if sp.name != "" { sp.name } else { "Work" },
          accent_rgba: proto::workspace_accent_color(sp.accent),
        })
        i += 1
      }
      out
    },
    active_space_id: fn() -> String {
      let _ = workspace_rev.get()
      app_state.workspace.active_space_id
    },
    mini_player: fn() -> proto::MiniPlayerState {
      let _ = media_hub_rev.get()
      let _ = workspace_rev.get()
      let _ = mini_player_rev.get()
      current_mini_player_state()
    },
    window_inset_override: None,
  }

  let dispatch_shell_intent = fn(intent : shell_ui::ShellIntent) -> Unit {
    match intent {
      shell_ui::ShellIntent::GoBack => {
        close_nav_hist()
        active_stage().back()
      }
      shell_ui::ShellIntent::GoForward => {
        close_nav_hist()
        active_stage().forward()
      }
      shell_ui::ShellIntent::Reload => active_stage().reload()
      shell_ui::ShellIntent::StopLoading => send_wire_active(wire::Message::Act("stop", "", ""))
      shell_ui::ShellIntent::Navigate(raw) => navigate_omnibox(active_stage(), raw, None)
      shell_ui::ShellIntent::SyncActiveUrl(_, _, _) => sync_address_bar_from_active()
      shell_ui::ShellIntent::OmniboxFocus => {
        app_state.syncing_address_url = true
        address.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
        app_state.syncing_address_url = false
        omnibox_editing.set(true)
        address.focus()
        address.pick(0, address.text().length())
        omnibox_selected.set(-1)
        dispatch_omnibox_query("")
      }
      shell_ui::ShellIntent::OmniboxBlur => {
        if app_state.demo_omnibox == "" {
          close_omnibox()
          omnibox_editing.set(false)
        }
      }
      shell_ui::ShellIntent::OmniboxEdit(q) => {
        omnibox_editing.set(true)
        omnibox_selected.set(-1)
        dispatch_omnibox_query(q)
      }
      shell_ui::ShellIntent::OmniboxSubmit(raw) => {
        omnibox_editing.set(false)
        navigate_omnibox(active_stage(), raw, None)
      }
      shell_ui::ShellIntent::OmniboxMoveSelection(delta) => {
        let _ = step_omnibox_selection(delta)
      }
      shell_ui::ShellIntent::OmniboxSelectIndex(idx) => {
        let items = app_state.omni_suggest_items
        if idx >= 0 && idx < items.length() {
          execute_omni_suggest_item(active_stage(), items[idx])
        }
      }
      shell_ui::ShellIntent::OmniboxResultsArrived(_) => ()
      shell_ui::ShellIntent::OmniboxEscape | shell_ui::ShellIntent::OmniboxClose => {
        shell_dismiss_omnibox_and_restore_address()
      }
      shell_ui::ShellIntent::ToggleSidebar => toggle_sidebar()
      shell_ui::ShellIntent::ToggleNarrowSidebar => {
        let ex = shell_adapter.exclusive.untracked()
        if (ex.active is shell_ui::ExclusiveKind::SidebarDrawer) && ex.tag == "shell_sidebar_drawer" {
          shell_mark_exclusive_closed("shell_sidebar_drawer")
        } else {
          close_exclusive_overlays(keep_tag="shell_sidebar_drawer")
          shell_mark_exclusive_open(shell_ui::ExclusiveKind::SidebarDrawer, "shell_sidebar_drawer")
        }
      }
      shell_ui::ShellIntent::ToggleSplitView => toggle_split_view()
      shell_ui::ShellIntent::SwapSplitPanes => swap_split_panes()
      shell_ui::ShellIntent::SoloActivePane => expand_split_pane(active_split_pane())
      shell_ui::ShellIntent::SetSplitRatio(r) => shell_page_set_ratio(r)
      shell_ui::ShellIntent::OpenPeek(u) => open_peek_preview(u, app_state.workspace.active_tab_id)
      shell_ui::ShellIntent::PromotePeekToSplit => promote_peek_to_split()
      shell_ui::ShellIntent::PeekGoBack => {
        match app_state.split_stage {
          Some(sp) => sp.back()
          None => ()
        }
      }
      shell_ui::ShellIntent::PeekGoForward => {
        match app_state.split_stage {
          Some(sp) => sp.forward()
          None => ()
        }
      }
      shell_ui::ShellIntent::PeekCopyUrl => copy_url_with_toast(peek_current_url())
      shell_ui::ShellIntent::PeekExpandToTab => expand_peek_to_tab()
      shell_ui::ShellIntent::CloseSecondaryPane => {
        if is_peek_open() {
          close_peek_preview()
        } else {
          close_split_view()
        }
      }
      shell_ui::ShellIntent::ToggleReaderMode(pane) => {
        set_active_split_pane(if pane is shell_ui::PaneId::Secondary { 1 } else { 0 })
        toggle_reader_mode()
      }
      shell_ui::ShellIntent::ToggleActiveReaderMode => toggle_reader_mode()
      shell_ui::ShellIntent::SetPaneFocus(pane) => {
        set_active_split_pane(if pane is shell_ui::PaneId::Secondary { 1 } else { 0 })
      }
      shell_ui::ShellIntent::SelectFavorite(id_or_url) => {
        match find_tab_summary(id_or_url) {
          Some(tb) => dispatch_tab_switch(tb.id)
          None => if id_or_url != "" { active_stage().go(id_or_url) }
        }
      }
      shell_ui::ShellIntent::SelectTab(id) => dispatch_tab_switch(id)
      shell_ui::ShellIntent::CloseTab(id) => dispatch_tab_close(id)
      shell_ui::ShellIntent::NewTab => dispatch_tab_new("", "")
      shell_ui::ShellIntent::CreateFolder(_) => open_folder_create_bar()
      shell_ui::ShellIntent::ToggleFolder(fid) => {
        send_wire(wire::Message::Act("folder_toggle", fid, ""))
      }
      shell_ui::ShellIntent::SelectSpace(sid) => {
        send_wire(wire::Message::Act("space_switch", sid, ""))
      }
      shell_ui::ShellIntent::ToggleDrawer => {
        let ex = shell_adapter.exclusive.untracked()
        if (ex.active is shell_ui::ExclusiveKind::Drawer) && ex.tag == "shell_drawer" {
          shell_mark_exclusive_closed("shell_drawer")
        } else {
          close_exclusive_overlays(keep_tag="shell_drawer")
          shell_mark_exclusive_open(shell_ui::ExclusiveKind::Drawer, "shell_drawer")
        }
      }
      shell_ui::ShellIntent::CloseExclusive => {
        let _ = shell_dismiss_active_exclusive()
      }
      shell_ui::ShellIntent::OpenMoreMenu => {
        close_exclusive_overlays(keep_tag="shell_menu")
        shell_mark_exclusive_open(shell_ui::ExclusiveKind::Menu, "shell_menu")
      }
      shell_ui::ShellIntent::CloseMoreMenu => shell_mark_exclusive_closed("shell_menu")
      shell_ui::ShellIntent::ToggleDarkTheme => toggle_dark_chrome()
      shell_ui::ShellIntent::MediaTogglePlay => {
        let mp = current_mini_player_state()
        if mp.tab_id != "" {
          send_wire(wire::Message::Act("media_play_toggle", mp.tab_id, ""))
        }
      }
      shell_ui::ShellIntent::MediaToggleMute => {
        let mp = current_mini_player_state()
        if mp.tab_id != "" {
          send_wire(wire::Message::Act("media_mute_toggle", mp.tab_id, ""))
          show_toast(if mp.muted { "Unmuted Tab" } else { "Muted Tab" }, "audio")
        } else {
          dispatch_media_mute_toggle()
        }
      }
      shell_ui::ShellIntent::MediaJumpToTab => {
        match current_mini_player_state().jump_to_tab() {
          Some(tid) => dispatch_tab_switch(tid)
          None => ()
        }
      }
      shell_ui::ShellIntent::MediaDismiss => {
        dismiss_shell_mini_player(current_mini_player_state().tab_id)
      }
      shell_ui::ShellIntent::CaptureCopyPath => copy_capture_sheet_path()
      shell_ui::ShellIntent::CaptureRevealFile => reveal_capture_sheet_file()
      shell_ui::ShellIntent::CaptureDismiss => close_capture_sheet()
      shell_ui::ShellIntent::TogglePerfHud => toggle_perf_hud()
      shell_ui::ShellIntent::OpenDialog => {
        close_exclusive_overlays(keep_tag="shell_dialog")
        shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "shell_dialog")
      }
      shell_ui::ShellIntent::CloseDialog => shell_mark_exclusive_closed("shell_dialog")
      shell_ui::ShellIntent::EscapePressed => {
        let _ = dismiss_topmost_layer()
      }
    }
  }

  // Unique 2 `stage::stage_node` mount points in all of `pion/cmd/app` (Primary + Secondary)
  let pane_slot = shell_ui::PaneSlot::new(fn(pane_v : view::View, pane_id : shell_ui::PaneId) -> Unit {
    match pane_id {
      shell_ui::PaneId::Primary => {
        let _ = pane_v.box(fn(sw : view::View) -> Unit {
          let _ = sw.fill().points(view::Live::By(fn() -> Bool { !shell_is_pane_occluded(0) }))
          let sv = stage::stage_node(
            sw,
            st,
            on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(st, hit) }),
          )
          let _ = sv.min_width(view::Live::Is(Some(0.0)))
          app_state.stage_view = Some(sv)
          shell_bind_stage_window_down(pane_v, sv, 0)
        })
        // Shift+Click on Primary link: in Split mode loads directly in existing Secondary Stage (0 remounts, PID unchanged);
        // in Single/Peek mode opens in Peek preview!
        let _ = pane_v.box(fn(sh_ov : view::View) -> Unit {
          let _ = sh_ov
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .presses(view::Live::By(fn() -> Bool {
            !shell_is_pane_occluded(0) && shift_held.get() && st.hover_url() != ""
          }))
          .cursor(view::Live::By(fn() -> Option[view::Cursor] {
            if !shell_is_pane_occluded(0) && shift_held.get() && st.hover_url() != "" {
              Some(view::Cursor::Hand)
            } else {
              None
            }
          }))
          .on_press(fn() -> Unit {
            let u = st.hover_url().trim()
            if u != "" {
              if is_split_open() {
                let sp_st = ensure_split_stage()
                if io_rt.split_conn.is_open() {
                  sp_st.go(u)
                } else {
                  app_state.split_pending_url = u
                }
              } else {
                open_peek_preview(u, app_state.workspace.active_tab_id)
              }
            }
          })
        })
        let is_start_active = fn() -> Bool {
          if is_split_open_live() || (reader_open.get() && shell_adapter.reader_owner_pane == 0) {
            return false
          }
          if app_state.initial_start_page_open {
            return true
          }
          let u = st.url()
          !st.loading() && proto::is_start_page_url(u)
        }
        let ks = ui::keys_system()
        let is_mac = ks == 0 || ks < 0
        shell_ui::build_startpage_panel(
          pane_v,
          shell_ui::StartPageProps::{
            visible: is_start_active,
            dark: fn() -> Bool { chrome_theme.get() == "dark" },
            space_name: fn() -> String {
              let _ = workspace_rev.get()
              match proto::workspace_active_space(app_state.workspace) {
                Some(sp) => if sp.name != "" { sp.name } else { app_state.space_name }
                None => app_state.space_name
              }
            },
            space_accent: fn() -> Int64 {
              let _ = workspace_rev.get()
              match proto::workspace_active_space(app_state.workspace) {
                Some(sp) => proto::workspace_accent_color(sp.accent)
                None => 0x2563EBFFL
              }
            },
            search_engine_label: fn() -> String {
              let _ = settings_rev.get()
              proto::search_engine_label(app_state.settings.search_engine)
            },
            tiles: fn() -> Array[proto::StartPageTile] {
              let _ = bookmarks_rev.get()
              let _ = history_rev.get()
              proto::build_start_page_tiles(
                app_state.bookmarks_snap.items,
                app_state.history_snap.items,
                proto::START_PAGE_MAX_TILES,
              )
            },
            field: start_page_field,
            on_show: fn() -> Unit { shell_release_pane_stage_focus(0) },
            on_submit: fn(q : String) -> Unit { submit_start_page_search(st, q) },
            on_open_tile: fn(url : String) -> Unit {
              app_state.initial_start_page_open = false
              st.go(url)
            },
            quick_actions: [
              shell_ui::StartPageQuickAction::{
                label: "Bookmarks",
                shortcut: if is_mac { "⇧⌘B" } else { "Ctrl+Shift+B" },
                icon_name: shell_ui::ICON_BOOKMARK,
                on_press: fn() -> Unit { open_bookmarks() },
              },
              shell_ui::StartPageQuickAction::{
                label: "History",
                shortcut: if is_mac { "⌘Y" } else { "Ctrl+Y" },
                icon_name: shell_ui::ICON_CLOCK,
                on_press: fn() -> Unit { open_history() },
              },
              shell_ui::StartPageQuickAction::{
                label: "Settings",
                shortcut: if is_mac { "⌘," } else { "Ctrl+," },
                icon_name: shell_ui::ICON_SETTINGS,
                on_press: fn() -> Unit { open_settings() },
              },
              shell_ui::StartPageQuickAction::{
                label: "Reader",
                shortcut: if is_mac { "⌥⌘R" } else { "Ctrl+Alt+R" },
                icon_name: shell_ui::ICON_READER,
                on_press: fn() -> Unit { toggle_reader_mode() },
              },
              shell_ui::StartPageQuickAction::{
                label: "DevTools",
                shortcut: if is_mac { "⌥⌘I" } else { "Ctrl+Shift+I" },
                icon_name: shell_ui::ICON_TERMINAL,
                on_press: fn() -> Unit { toggle_devtools() },
              },
            ],
          },
        )
        build_reader_mode_view(
          pane_v,
          0,
          reader_open,
          reader_rev,
          reader_theme,
          reader_font,
          reader_font_size,
          reader_width_mode,
          reader_progress,
        )
        shell_ui::build_find_bar_panel(
          pane_v,
          shell_ui::FindBarProps::{
            visible: fn() -> Bool {
              let _ = shell_adapter.page.get()
              find_open.get() && shell_adapter.find_owner_pane_sig.get() == 0
            },
            dark: fn() -> Bool { chrome_theme.get() == "dark" },
            field: find_field,
            case_sensitive: fn() -> Bool { find_case_sensitive.get() },
            counts: fn() -> (Int, Int) {
              if host_find_synced.get() {
                (host_find_active.get(), host_find_total.get())
              } else {
                let (at1, tot) = st.find_place()
                if tot <= 0 { (-1, 0) } else { (at1 - 1, tot) }
              }
            },
            on_query_change: fn(q : String) -> Unit { dispatch_find_query(st, q) },
            on_prev: fn() -> Unit { dispatch_find_prev(st) },
            on_next: fn() -> Unit { dispatch_find_next(st) },
            on_toggle_case: fn() -> Unit { toggle_find_case_sensitive(st) },
            on_close: fn() -> Unit { close_find_bar(st) },
          },
        )
      }
      shell_ui::PaneId::Secondary => {
        let sp_st = ensure_split_stage()
        let _ = pane_v.box(fn(sw : view::View) -> Unit {
          let _ = sw.fill().points(view::Live::By(fn() -> Bool { !shell_is_pane_occluded(1) }))
          let psv = stage::stage_node(
            sw,
            sp_st,
            on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(sp_st, hit) }),
          )
          let _ = psv.min_width(view::Live::Is(Some(0.0)))
          app_state.split_stage_view = Some(psv)
          shell_bind_stage_window_down(pane_v, psv, 1)
        })
        build_reader_mode_view(
          pane_v,
          1,
          reader_open,
          reader_rev,
          reader_theme,
          reader_font,
          reader_font_size,
          reader_width_mode,
          reader_progress,
        )
        shell_ui::build_find_bar_panel(
          pane_v,
          shell_ui::FindBarProps::{
            visible: fn() -> Bool {
              let _ = shell_adapter.page.get()
              find_open.get() && shell_adapter.find_owner_pane_sig.get() == 1
            },
            dark: fn() -> Bool { chrome_theme.get() == "dark" },
            field: find_field,
            case_sensitive: fn() -> Bool { find_case_sensitive.get() },
            counts: fn() -> (Int, Int) {
              if host_find_synced.get() {
                (host_find_active.get(), host_find_total.get())
              } else {
                let (at1, tot) = sp_st.find_place()
                if tot <= 0 { (-1, 0) } else { (at1 - 1, tot) }
              }
            },
            on_query_change: fn(q : String) -> Unit { dispatch_find_query(sp_st, q) },
            on_prev: fn() -> Unit { dispatch_find_prev(sp_st) },
            on_next: fn() -> Unit { dispatch_find_next(sp_st) },
            on_toggle_case: fn() -> Unit { toggle_find_case_sensitive(sp_st) },
            on_close: fn() -> Unit { close_find_bar(sp_st) },
          },
        )
      }
    }
  })

  // Production host hooks: Agent Takeover Bar, Bookmarks Bar, DevTools Dock, SiteInfo/IDN/Zoom, Sidebar ctx/hover/filter, More menu
  let shell_hooks = shell_ui::ShellHostHooks::{
    on_address_bar_view: Some(fn(v : view::View) -> Unit { app_state.address_bar_view = Some(v) }),
    on_omnibox_panel_view: Some(fn(v : view::View) -> Unit { shell_adapter.omnibox_panel_view = Some(v) }),
    top_strip: Some(fn(strip : view::View) -> Unit {
      strip.show(
        fn() -> Bool { st.agent() },
        fn(line : view::View) -> Unit {
          let _ = line
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(8.0))
          .padding(view::Live::Is((12.0, 6.0, 12.0, 6.0)))
          .ground(view::Live::Is(0xFFF4D6FFL))
          let _ = line.box(fn(w : view::View) -> Unit {
            let _ = w.grow(view::Live::Is(1.0)).words(view::Live::Is("Agent 正在操作这个页面"), ink=0x1D1D1FFFL)
          })
          bar_button(line, "接管", fn() -> Unit { st.take_over() })
        },
      )
      build_bookmarks_bar(strip, bookmarks_bar_open, bookmarks_rev)
      strip.show(
        fn() -> Bool { active_stage_live().loading() },
        fn(prog : view::View) -> Unit {
          let _ = prog.height(view::Live::Is(Some(2.0))).rigid().ground(view::Live::Is(0x0A84FFFFL))
        },
      )
    }),
    bottom_dock: Some(fn(dock : view::View) -> Unit {
      build_devtools_drawer(
        dock,
        devtools_open,
        devtools_height,
        devtools_dragging,
        devtools_tab,
        devtools_rev,
        devtools_selected_path,
        devtools_console_filter,
        devtools_repl_field,
        devtools_net_filter,
        devtools_net_query,
        devtools_net_search_field,
        devtools_net_selected_idx,
        workspace_rev,
      )
    }),
    sidebar_filter_slot: Some(fn(sb : view::View) -> Unit {
      sb.show(fn() -> Bool { tab_filter_open.get() }, fn(tf_row : view::View) -> Unit {
        let _ = tf_row
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .height(view::Live::Is(Some(30.0)))
        .rigid()
        .gap(view::Live::Is(4.0))
        .padding(view::Live::Is((8.0, 2.0, 6.0, 2.0)))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::By(fn() -> Int64 { lg::surface().card }))
        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, lg::surface().separator) }))
        let _ = ui::field(
          tf_row,
          tab_filter_field,
          placeholder="Filter tabs...",
          font_size=12.0,
          color=0x1D1D1FFFL,
          placeholder_color=0x8E8E93FFL,
          max_lines=1,
          edited=fn(q : String) -> Unit { tab_filter_query.set(q) },
        )
        let _ = headless::button(
          tf_row,
          fn() -> String { "Clear Filter" },
          fn(_v : view::View) -> Unit { close_tab_filter() },
          fn(cb : view::View, _btn : headless::Button) -> Unit {
            let _ = cb.width(view::Live::Is(Some(22.0))).height(view::Live::Is(Some(22.0))).center()
            let _ = shell_ui::shell_icon(cb, shell_ui::ICON_CLOSE, size=11.0, color_by=fn() { lg::surface().ink_secondary })
          },
        )
      })
    }),
    sidebar_folder_create_slot: Some(fn(sb : view::View) -> Unit {
      build_inline_folder_creator(
        sb,
        folder_create_open,
        folder_create_color,
        folder_create_move_active,
        folder_create_field,
      )
    }),
    address_trailing_slot: Some(fn(pill : view::View) -> Unit {
      // IDN spoofing warning badge
      build_idna_spoof_capsule(pill, idn_popover_open)
      // Zoom badge (visible whenever zoom != 100%)
      pill.show(
        fn() -> Bool { (active_stage_live().zoom() - 1.0).abs() > 0.005 },
        fn(zm_wrap : view::View) -> Unit {
          let _ = headless::button(
            zm_wrap,
            fn() -> String { "Page Zoom" },
            fn(_v : view::View) -> Unit { toggle_zoom_popover() },
            fn(zb : view::View, _btn : headless::Button) -> Unit {
              let _ = zb
              .height(view::Live::Is(Some(22.0)))
              .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
              .radius(view::Live::Is(11.0))
              .center()
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { lg::surface().card_secondary }))
              let _ = zb.box(fn(t : view::View) -> Unit {
                let _ = t.words(
                  view::Live::By(fn() -> String {
                    ((active_stage_live().zoom() * 100.0 + 0.5).to_int()).to_string() + "%"
                  }),
                  ink=0x1D1D1FFFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                  one_line=true,
                ).ink(view::Live::By(fn() -> Int64 { lg::surface().ink }))
              })
            },
          )
        },
      )
      // Bookmark Star button (gold filled when current URL is bookmarked)
      let is_bookmarked = fn() -> Bool {
        let _ = bookmarks_rev.get()
        let u = active_address_raw_url().trim()
        u != "" && proto::bookmarks_contains_url(app_state.bookmarks_snap, u)
      }
      let _ = headless::button(
        pill,
        fn() -> String { if is_bookmarked() { "Remove Bookmark" } else { "Bookmark Page" } },
        fn(_v : view::View) -> Unit { dispatch_bookmark_toggle() },
        fn(bb : view::View, btn : headless::Button) -> Unit {
          let _ = bb
          .width(view::Live::Is(Some(26.0)))
          .height(view::Live::Is(Some(26.0)))
          .radius(view::Live::Is(13.0))
          .center()
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { if btn.hovered() { lg::surface().row_hover } else { 0x00000000L } }))
          bb.show(fn() { is_bookmarked() }, fn(ic : view::View) -> Unit {
            let _ = shell_ui::shell_icon(ic, shell_ui::ICON_STAR_FILLED, size=14.0, color_by=fn() { 0xF5A623FFL })
          })
          bb.show(fn() { !is_bookmarked() }, fn(ic : view::View) -> Unit {
            let _ = shell_ui::shell_icon(ic, shell_ui::ICON_STAR, size=14.0, color_by=fn() { lg::surface().ink_secondary })
          })
        },
      )
      // Site Boosts button (with purple active dot when current host has an active Boost)
      let has_active_boost = fn() -> Bool {
        let _ = boosts_rev.get()
        let h = proto::omnibox_display_host(active_address_raw_url())
        if h == "" {
          false
        } else {
          match proto::boosts_find(app_state.boosts_snap, h) {
            Some(b) => b.enabled
            None => false
          }
        }
      }
      let _ = headless::button(
        pill,
        fn() -> String { "Site Boosts" },
        fn(_v : view::View) -> Unit { toggle_boosts() },
        fn(sb_btn : view::View, btn : headless::Button) -> Unit {
          let _ = sb_btn
          .width(view::Live::Is(Some(26.0)))
          .height(view::Live::Is(Some(26.0)))
          .radius(view::Live::Is(13.0))
          .center()
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { if btn.hovered() { lg::surface().row_hover } else { 0x00000000L } }))
          let _ = shell_ui::shell_icon(
            sb_btn,
            shell_ui::ICON_SPARKLES,
            size=14.0,
            color_by=fn() { if has_active_boost() { 0x8B5CF6FFL } else { lg::surface().ink_secondary } },
          )
          sb_btn.show(fn() { has_active_boost() }, fn(dot : view::View) -> Unit {
            let _ = dot
            .over(view::Live::Is(true), edges=(None, Some(3.0), Some(3.0), None))
            .width(view::Live::Is(Some(5.0)))
            .height(view::Live::Is(Some(5.0)))
            .radius(view::Live::Is(2.5))
            .ground(view::Live::Is(0x8B5CF6FFL))
          })
        },
      )
    }),
    on_site_info: Some(fn() -> Unit { toggle_site_info() }),
    on_nav_history: Some(fn(dir : Int, ax : Double) -> Unit { open_nav_hist(dir, ax) }),
    on_tab_context: Some(fn(id : String, y : Double) -> Unit { open_tab_ctx(id, y) }),
    on_tab_hover: Some(fn(id : String, y : Double, entered : Bool) -> Unit {
      if entered {
        open_tab_hover_preview(id, y)
      } else {
        close_tab_hover_preview()
      }
    }),
    on_folder_context: Some(fn(id : String, y : Double) -> Unit { open_folder_ctx(id, y) }),
    on_space_header_click: Some(fn() -> Unit { toggle_space_theme() }),
    on_tab_count_click: Some(fn() -> Unit { toggle_tab_filter() }),
    extra_more_items: Some(fn() -> Array[lg::LiquidMenuEntry] {
      [
        lg::LiquidMenuEntry::item(
          label="Find in Page…",
          shortcut="Cmd+F",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_SEARCH, size=14.0, color_by=ink) },
          on_select=fn() { open_find_bar() },
        ),
        lg::LiquidMenuEntry::item(
          label="Media Hub",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_VOLUME, size=14.0, color_by=ink) },
          on_select=fn() { toggle_media_hub() },
        ),
        lg::LiquidMenuEntry::item(
          label="Downloads",
          shortcut="Cmd+Shift+J",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_DOWNLOAD, size=14.0, color_by=ink) },
          on_select=fn() { toggle_downloads() },
        ),
        lg::LiquidMenuEntry::item(
          label="History",
          shortcut="Cmd+Y",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_CLOCK, size=14.0, color_by=ink) },
          on_select=fn() { toggle_history() },
        ),
        lg::LiquidMenuEntry::item(
          label="Bookmarks",
          shortcut="Cmd+Alt+B",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_BOOKMARK, size=14.0, color_by=ink) },
          on_select=fn() { toggle_bookmarks() },
        ),
        lg::LiquidMenuEntry::item(
          label="Bookmarks Bar",
          shortcut="Cmd+Shift+B",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_STAR, size=14.0, color_by=ink) },
          on_select=fn() { toggle_bookmarks_bar() },
        ),
        lg::LiquidMenuEntry::item(
          label="Developer Tools",
          shortcut="Cmd+Alt+I",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_ZAP, size=14.0, color_by=ink) },
          on_select=fn() { toggle_devtools() },
        ),
        lg::LiquidMenuEntry::item(
          label="Print / PDF Settings…",
          shortcut="Cmd+P",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_DOWNLOAD, size=14.0, color_by=ink) },
          on_select=fn() { open_print_pdf_modal() },
        ),
        lg::LiquidMenuEntry::item(
          label="Keyboard Shortcuts",
          shortcut="Cmd+/",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_COMMAND, size=14.0, color_by=ink) },
          on_select=fn() { toggle_shortcuts() },
        ),
        lg::LiquidMenuEntry::item(
          label="Manage Spaces…",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_LAYERS, size=14.0, color_by=ink) },
          on_select=fn() { open_spaces_manager() },
        ),
        lg::LiquidMenuEntry::item(
          label="Settings…",
          shortcut="Cmd+,",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_SETTINGS, size=14.0, color_by=ink) },
          on_select=fn() { toggle_settings() },
        ),
      ]
    }),
    hide_demo_export_pdf: true,
    peek_can_back: Some(fn() -> Bool {
      match app_state.split_stage {
        Some(sp) => sp.can_back()
        None => false
      }
    }),
    peek_can_forward: Some(fn() -> Bool {
      match app_state.split_stage {
        Some(sp) => sp.can_forward()
        None => false
      }
    }),
    command_bar: Some(shell_ui::CommandBarProps::{
      field: command_bar_field,
      items: fn() -> Array[proto::CommandBarItem] {
        let _ = command_bar_rev.get()
        app_state.command_bar_items
      },
      selected: fn() -> Int { command_bar_selected.get() },
      on_query_change: fn(q : String) -> Unit {
        refresh_command_bar_items(q)
        if app_state.command_bar_items.length() > 0 {
          command_bar_selected.set(0)
        }
      },
      on_step: fn(delta : Int) -> Bool { step_command_bar_selection(delta) },
      on_submit: fn(t : String) -> Unit { submit_command_bar(st, t) },
      on_execute: fn(it : proto::CommandBarItem) -> Unit { execute_command_bar_item(st, it) },
      on_close: fn() -> Unit { close_command_bar() },
      on_row_view: Some(fn(b : view::View) -> Unit { app_state.command_bar_row_views.push(b) }),
      on_clear_rows: Some(fn() -> Unit { app_state.command_bar_row_views.clear() }),
    }),
    tab_search: Some(shell_ui::TabSearchProps::{
      field: tab_search_field,
      results: fn() -> proto::TabSearchResult {
        let _ = workspace_rev.get()
        let _ = closed_tabs_rev.get()
        let _ = tab_search_query.get()
        current_tab_search_results()
      },
      selected: fn() -> Int { tab_search_selected.get() },
      on_query_change: fn(q : String) -> Unit {
        tab_search_query.set(q)
        tab_search_selected.set(0)
      },
      on_submit: fn() -> Unit { commit_tab_search_selection() },
      on_activate: fn(it : proto::TabSearchItem) -> Unit { activate_tab_search_item(it) },
      on_close_tab: fn(tid : String) -> Unit { dispatch_tab_close(tid) },
      on_close: fn() -> Unit { close_tab_search() },
    }),
  }

  // Live production Desktop Shell 2.0 frame (`render_passive_overlays=true`: single-source CaptureSheet & Toast)
  shell_ui::build_shell_frame(
    root,
    live_shell_model,
    dispatch_shell_intent,
    pane_slot,
    render_passive_overlays=true,
    on_focus_pane=Some(shell_focus_pane_stage),
    hooks=Some(shell_hooks),
  )
}
