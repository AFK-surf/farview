// ============================================================================
// 8. Live Production Shell 2.0 Frame Bridge (mounted from `build_view`)
// ============================================================================

fn build_live_shell_frame(
  root : view::View,
  st : stage::Stage,
  address : ui::Field,
  omnibox_open : signals::Signal[Bool],
  omnibox_rev : signals::Signal[Int],
  omnibox_selected : signals::Signal[Int],
  omnibox_editing : signals::Signal[Bool],
  chrome_theme : signals::Signal[String],
  workspace_rev : signals::Signal[Int],
  media_hub_rev : signals::Signal[Int],
  mini_player_rev : signals::Signal[Int],
  bookmarks_bar_open : signals::Signal[Bool],
  bookmarks_rev : signals::Signal[Int],
  boosts_rev : signals::Signal[Int],
  history_rev : signals::Signal[Int],
  settings_rev : signals::Signal[Int],
  peek_url : signals::Signal[String],
  shift_held : signals::Signal[Bool],
  tab_filter_open : signals::Signal[Bool],
  tab_filter_query : signals::Signal[String],
  tab_filter_field : ui::Field,
  folder_create_open : signals::Signal[Bool],
  folder_create_color : signals::Signal[String],
  folder_create_move_active : signals::Signal[Bool],
  folder_create_field : ui::Field,
  idn_popover_open : signals::Signal[Bool],
  start_page_field : ui::Field,
  reader_open : signals::Signal[Bool],
  reader_rev : signals::Signal[Int],
  reader_theme : signals::Signal[String],
  reader_font : signals::Signal[String],
  reader_font_size : signals::Signal[Int],
  reader_width_mode : signals::Signal[String],
  reader_progress : signals::Signal[Double],
  find_open : signals::Signal[Bool],
  find_field : ui::Field,
  find_case_sensitive : signals::Signal[Bool],
  host_find_synced : signals::Signal[Bool],
  host_find_active : signals::Signal[Int],
  host_find_total : signals::Signal[Int],
  devtools_open : signals::Signal[Bool],
  devtools_height : signals::Signal[Double],
  devtools_dragging : signals::Signal[Bool],
  devtools_tab : signals::Signal[Int],
  devtools_rev : signals::Signal[Int],
  devtools_selected_path : signals::Signal[String],
  devtools_console_filter : signals::Signal[Int],
  devtools_repl_field : ui::Field,
  devtools_net_filter : signals::Signal[String],
  devtools_net_query : signals::Signal[String],
  devtools_net_search_field : ui::Field,
  devtools_net_selected_idx : signals::Signal[Int],
  command_bar_rev : signals::Signal[Int],
  command_bar_selected : signals::Signal[Int],
  command_bar_field : ui::Field,
  tab_search_query : signals::Signal[String],
  tab_search_selected : signals::Signal[Int],
  tab_search_field : ui::Field,
  closed_tabs_rev : signals::Signal[Int],
) -> Unit {
  // Live Shell 2.0 Model backed 100% by `shell_adapter` + `cmd/app` signals (zero duplicate state)
  let live_shell_model = shell_ui::ShellModel::{
    url: fn() -> String { st.url() },
    title: fn() -> String { st.title() },
    secondary_url: fn() -> String {
      match app_state.split_stage {
        Some(sp) if sp.url() != "" => sp.url()
        _ => peek_url.get()
      }
    },
    secondary_title: fn() -> String {
      match app_state.split_stage {
        Some(sp) => sp.title()
        None => ""
      }
    },
    active_url: fn() -> String { active_address_raw_url() },
    active_title: fn() -> String { active_stage_live().title() },
    loading: fn() -> Bool { active_stage_live().loading() },
    pane_loading: fn(p : shell_ui::PaneId) -> Bool {
      match p {
        shell_ui::PaneId::Primary => st.loading()
        shell_ui::PaneId::Secondary =>
        match app_state.split_stage {
          Some(sp) => sp.loading()
          None => false
        }
      }
    },
    can_back: fn() -> Bool { active_stage_live().can_back() },
    can_forward: fn() -> Bool { active_stage_live().can_forward() },
    omnibox_security: fn() -> shell_ui::OmniboxSecurity {
      let cur = active_address_raw_url()
      let safe = proto::omnibox_safe_display_url(cur)
      let editing = omnibox_editing.get() || address.focused()
      if editing || address.text() != safe {
        shell_ui::OmniboxSecurity::EditingSearch
      } else {
        shell_ui::classify_omnibox_security(cur, false)
      }
    },
    omnibox_editing: fn() -> Bool { omnibox_editing.get() },
    dark: fn() -> Bool { chrome_theme.get() == "dark" },
    dock: fn() -> shell_ui::DockState { shell_adapter.dock.get() },
    page: fn() -> shell_ui::PageLayoutState { shell_adapter.page.get() },
    exclusive: fn() -> shell_ui::ExclusiveState { shell_adapter.exclusive.get() },
    passive: fn() -> shell_ui::PassiveState { shell_adapter.passive.get() },
    omnibox_field: address,
    omnibox_suggest: fn() -> proto::OmniSuggestState {
      let _ = omnibox_rev.get()
      proto::OmniSuggestState::{
        open: omnibox_open.get() && app_state.omni_suggest_items.length() > 0,
        query: app_state.omnibox_last_query,
        items: app_state.omni_suggest_items,
        selected: omnibox_selected.get(),
        touched: app_state.omnibox_sel_touched,
      }
    },
    favorites: fn() -> Array[shell_ui::ShellFavoriteItem] {
      let _ = workspace_rev.get()
      // (Favorites belong to the profile, not a Space: the grid stays the same as Spaces switch, as in Arc)
      let favs = proto::workspace_favorite_tiles(app_state.workspace, "")
      let out : Array[shell_ui::ShellFavoriteItem] = []
      let mut i = 0
      while i < favs.length() {
        let f = favs[i]
        let (bg, _) = favorite_badge_colors(f.url)
        let ttl = proto::workspace_tab_display_title(f)
        let mono = if ttl.length() > 0 { ttl.slice(0, 1) } else { "F" }
        out.push(shell_ui::ShellFavoriteItem::{
          id: f.id,
          title: ttl,
          url: f.url,
          monogram: mono,
          accent_rgba: bg,
          active: f.id == app_state.workspace.active_tab_id,
        })
        i += 1
      }
      out
    },
    folders: fn() -> Array[shell_ui::ShellFolderItem] {
      let _ = workspace_rev.get()
      let sid = app_state.workspace.active_space_id
      let flds = proto::workspace_filtered_folders(app_state.workspace, sid, tab_filter_query.get())
      let out : Array[shell_ui::ShellFolderItem] = []
      let mut i = 0
      while i < flds.length() {
        let fl = flds[i]
        out.push(shell_ui::ShellFolderItem::{
          id: fl.id,
          name: fl.name,
          collapsed: fl.collapsed,
        })
        i += 1
      }
      out
    },
    tabs: fn() -> Array[shell_ui::ShellTabItem] {
      let _ = workspace_rev.get()
      let _ = media_hub_rev.get()
      let filter_q = tab_filter_query.get().trim()
      let all = app_state.workspace.tabs
      let out : Array[shell_ui::ShellTabItem] = []
      let mut i = 0
      while i < all.length() {
        let tb = all[i]
        if filter_q == "" || proto::workspace_tab_matches_filter(tb, filter_q) {
          let ttl = proto::workspace_tab_display_title(tb)
          let (pl, mu) = tab_preview_media_state(tb)
          out.push(shell_ui::ShellTabItem::{
            id: tb.id,
            title: ttl,
            url: tb.url,
            folder_id: tb.folder_id,
            space_id: tb.space_id,
            pinned: tb.pinned,
            favorite: tb.favorite,
            // (the workspace's active tab alone: a press shows its tab selected before the host says so, and the
            // host's per-tab flag would light the old one too meanwhile)
            active: tb.id == app_state.workspace.active_tab_id,
            playing_audio: pl,
            muted: mu,
            loading: tab_row_loading(tb),
            unloaded: tb.state == "discarded" && tb.id != app_state.workspace.active_tab_id,
          })
        }
        i += 1
      }
      out
    },
    spaces: fn() -> Array[shell_ui::ShellSpaceItem] {
      let _ = workspace_rev.get()
      let sps = app_state.workspace.spaces
      let out : Array[shell_ui::ShellSpaceItem] = []
      let mut i = 0
      while i < sps.length() {
        let sp = sps[i]
        out.push(shell_ui::ShellSpaceItem::{
          id: sp.id,
          name: if sp.name != "" { sp.name } else { "Work" },
          accent_rgba: proto::workspace_accent_color(sp.accent),
          theme: sp.theme,
        })
        i += 1
      }
      out
    },
    active_space_id: fn() -> String {
      let _ = workspace_rev.get()
      app_state.workspace.active_space_id
    },
    mini_player: fn() -> proto::MiniPlayerState {
      let _ = media_hub_rev.get()
      let _ = workspace_rev.get()
      let _ = mini_player_rev.get()
      current_mini_player_state()
    },
    window_inset_override: None,
  }

  let dispatch_shell_intent = fn(intent : shell_ui::ShellIntent) -> Unit {
    match intent {
      shell_ui::ShellIntent::GoBack => {
        close_nav_hist()
        active_stage().back()
      }
      shell_ui::ShellIntent::GoForward => {
        close_nav_hist()
        active_stage().forward()
      }
      shell_ui::ShellIntent::Reload => active_stage().reload()
      shell_ui::ShellIntent::StopLoading => send_wire_active(wire::Message::Act("stop", "", ""))
      shell_ui::ShellIntent::Navigate(raw) => navigate_omnibox(active_stage(), raw, None)
      shell_ui::ShellIntent::SyncActiveUrl(_, _, _) => sync_address_bar_from_active()
      shell_ui::ShellIntent::OmniboxFocus => {
        app_state.syncing_address_url = true
        address.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
        app_state.syncing_address_url = false
        omnibox_editing.set(true)
        address.focus()
        address.pick(0, address.text().length())
        app_state.omnibox_new_tab = false
        omnibox_reset_selection()
        dispatch_omnibox_query("")
      }
      shell_ui::ShellIntent::OmniboxBlur => {
        if app_state.demo_omnibox == "" {
          close_omnibox()
          omnibox_editing.set(false)
        }
      }
      shell_ui::ShellIntent::OmniboxEdit(q) => {
        omnibox_editing.set(true)
        omnibox_reset_selection()
        dispatch_omnibox_query(q)
      }
      shell_ui::ShellIntent::OmniboxSubmit(raw) => {
        omnibox_editing.set(false)
        navigate_omnibox(active_stage(), raw, None)
      }
      shell_ui::ShellIntent::OmniboxMoveSelection(delta) => {
        let _ = step_omnibox_selection(delta)
      }
      shell_ui::ShellIntent::OmniboxSelectIndex(idx) => {
        let items = app_state.omni_suggest_items
        if idx >= 0 && idx < items.length() {
          execute_omni_suggest_item(active_stage(), items[idx])
        }
      }
      shell_ui::ShellIntent::OmniboxHoverIndex(idx) => hover_omnibox_selection(idx)
      shell_ui::ShellIntent::OmniboxResultsArrived(_) => ()
      shell_ui::ShellIntent::OmniboxEscape | shell_ui::ShellIntent::OmniboxClose => {
        shell_dismiss_omnibox_and_restore_address()
      }
      shell_ui::ShellIntent::ToggleSidebar => toggle_sidebar()
      shell_ui::ShellIntent::ToggleNarrowSidebar => {
        let ex = shell_adapter.exclusive.untracked()
        if (ex.active is shell_ui::ExclusiveKind::SidebarDrawer) && ex.tag == "shell_sidebar_drawer" {
          shell_mark_exclusive_closed("shell_sidebar_drawer")
        } else {
          close_exclusive_overlays(keep_tag="shell_sidebar_drawer")
          shell_mark_exclusive_open(shell_ui::ExclusiveKind::SidebarDrawer, "shell_sidebar_drawer")
        }
      }
      shell_ui::ShellIntent::ToggleSplitView => toggle_split_view()
      shell_ui::ShellIntent::SwapSplitPanes => swap_split_panes()
      shell_ui::ShellIntent::SoloActivePane => expand_split_pane(active_split_pane())
      shell_ui::ShellIntent::SetSplitRatio(r) => shell_page_set_ratio(r)
      shell_ui::ShellIntent::OpenPeek(u) => open_peek_preview(u, app_state.workspace.active_tab_id)
      shell_ui::ShellIntent::PromotePeekToSplit => promote_peek_to_split()
      shell_ui::ShellIntent::PeekGoBack => {
        match app_state.split_stage {
          Some(sp) => sp.back()
          None => ()
        }
      }
      shell_ui::ShellIntent::PeekGoForward => {
        match app_state.split_stage {
          Some(sp) => sp.forward()
          None => ()
        }
      }
      shell_ui::ShellIntent::PeekCopyUrl => copy_url_with_toast(peek_current_url())
      shell_ui::ShellIntent::PeekExpandToTab => expand_peek_to_tab()
      shell_ui::ShellIntent::CloseSecondaryPane => {
        if is_peek_open() {
          close_peek_preview()
        } else {
          close_split_view()
        }
      }
      shell_ui::ShellIntent::ToggleReaderMode(pane) => {
        set_active_split_pane(if pane is shell_ui::PaneId::Secondary { 1 } else { 0 })
        toggle_reader_mode()
      }
      shell_ui::ShellIntent::ToggleActiveReaderMode => toggle_reader_mode()
      shell_ui::ShellIntent::SetPaneFocus(pane) => {
        set_active_split_pane(if pane is shell_ui::PaneId::Secondary { 1 } else { 0 })
      }
      shell_ui::ShellIntent::SelectFavorite(id_or_url) => {
        match find_tab_summary(id_or_url) {
          Some(tb) => dispatch_tab_switch(tb.id)
          None => if id_or_url != "" { active_stage().go(id_or_url) }
        }
      }
      shell_ui::ShellIntent::SelectTab(id) => dispatch_tab_switch(id)
      shell_ui::ShellIntent::CloseTab(id) => {
        // (a pointer close told as a transition by the shell: its answer from the host is told so too)
        if view::transition_now() {
          workspace_next_told("close", id)
        }
        dispatch_tab_close(id)
      }
      shell_ui::ShellIntent::NewTab => open_new_tab_palette()
      shell_ui::ShellIntent::ClearToday => dispatch_today_clear()
      shell_ui::ShellIntent::ToggleTabMute(id) => dispatch_media_toggle_mute(id)
      shell_ui::ShellIntent::CreateFolder(_) => open_folder_create_bar()
      // (through the dispatchers, so the sidebar answers on the press's own frame: `ws_pending_show`; a pointer
      // toggle is told as a transition by the shell, and so is the host's answer if it changes what was shown)
      shell_ui::ShellIntent::ToggleFolder(fid) => {
        if view::transition_now() {
          workspace_next_told("folder", fid)
        }
        dispatch_folder_toggle(fid)
      }
      shell_ui::ShellIntent::SelectSpace(sid) => dispatch_space_switch(sid)
      shell_ui::ShellIntent::MoveTab(id, target, before) => dispatch_tab_move(id, target, before)
      shell_ui::ShellIntent::SetSidebarWidth(w, commit) => set_sidebar_width_live(w, commit)
      shell_ui::ShellIntent::ToastAction => run_toast_action()
      shell_ui::ShellIntent::ToastHover(on) => set_toast_hovered(on)
      shell_ui::ShellIntent::ToggleDrawer => {
        let ex = shell_adapter.exclusive.untracked()
        if (ex.active is shell_ui::ExclusiveKind::Drawer) && ex.tag == "shell_drawer" {
          shell_mark_exclusive_closed("shell_drawer")
        } else {
          close_exclusive_overlays(keep_tag="shell_drawer")
          shell_mark_exclusive_open(shell_ui::ExclusiveKind::Drawer, "shell_drawer")
        }
      }
      shell_ui::ShellIntent::CloseExclusive => {
        let _ = shell_dismiss_active_exclusive()
      }
      shell_ui::ShellIntent::OpenMoreMenu => {
        close_exclusive_overlays(keep_tag="shell_menu")
        shell_mark_exclusive_open(shell_ui::ExclusiveKind::Menu, "shell_menu")
      }
      shell_ui::ShellIntent::CloseMoreMenu => shell_mark_exclusive_closed("shell_menu")
      shell_ui::ShellIntent::ToggleDarkTheme => toggle_dark_chrome()
      shell_ui::ShellIntent::MediaTogglePlay => {
        let mp = current_mini_player_state()
        if mp.tab_id != "" {
          send_wire(wire::Message::Act("media_play_toggle", mp.tab_id, ""))
        }
      }
      shell_ui::ShellIntent::MediaToggleMute => {
        let mp = current_mini_player_state()
        if mp.tab_id != "" {
          send_wire(wire::Message::Act("media_mute_toggle", mp.tab_id, ""))
        } else {
          dispatch_media_mute_toggle()
        }
      }
      shell_ui::ShellIntent::MediaJumpToTab => {
        match current_mini_player_state().jump_to_tab() {
          Some(tid) => dispatch_tab_switch(tid)
          None => ()
        }
      }
      shell_ui::ShellIntent::MediaDismiss => {
        dismiss_shell_mini_player(current_mini_player_state().tab_id)
      }
      shell_ui::ShellIntent::CaptureCopyPath => copy_capture_sheet_path()
      shell_ui::ShellIntent::CaptureRevealFile => reveal_capture_sheet_file()
      shell_ui::ShellIntent::CaptureDismiss => close_capture_sheet()
      shell_ui::ShellIntent::TogglePerfHud => toggle_perf_hud()
      shell_ui::ShellIntent::OpenDialog => {
        close_exclusive_overlays(keep_tag="shell_dialog")
        shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "shell_dialog")
      }
      shell_ui::ShellIntent::CloseDialog => shell_mark_exclusive_closed("shell_dialog")
      shell_ui::ShellIntent::EscapePressed => {
        let _ = dismiss_topmost_layer()
      }
    }
  }

  // Unique 2 `stage::stage_node` mount points in all of `pion/cmd/app` (Primary + Secondary)
  let pane_slot = shell_ui::PaneSlot::new(fn(pane_v : view::View, pane_id : shell_ui::PaneId) -> Unit {
    match pane_id {
      shell_ui::PaneId::Primary => {
        let _ = pane_v.box(fn(sw : view::View) -> Unit {
          let _ = sw.fill().points(view::Live::By(fn() -> Bool { !shell_is_pane_occluded(0) }))
          let sv = stage::stage_node(
            sw,
            st,
            on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(st, hit) }),
          )
          let _ = sv.min_width(view::Live::Is(Some(0.0)))
          app_state.stage_view = Some(sv)
          shell_bind_stage_window_down(pane_v, sv, 0)
        })
        // Shift+Click on Primary link: in Split mode loads directly in existing Secondary Stage (0 remounts, PID unchanged);
        // in Single/Peek mode opens in Peek preview!
        let _ = pane_v.box(fn(sh_ov : view::View) -> Unit {
          let _ = sh_ov
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .presses(view::Live::By(fn() -> Bool {
            !shell_is_pane_occluded(0) && shift_held.get() && st.hover_url() != ""
          }))
          .cursor(view::Live::By(fn() -> Option[view::Cursor] {
            if !shell_is_pane_occluded(0) && shift_held.get() && st.hover_url() != "" {
              Some(view::Cursor::Hand)
            } else {
              None
            }
          }))
          .on_press(fn() -> Unit {
            let u = st.hover_url().trim()
            if u != "" {
              if is_split_open() {
                let sp_st = ensure_split_stage()
                if io_rt.split_conn.is_open() {
                  sp_st.go(u)
                } else {
                  app_state.split_pending_url = u
                }
              } else {
                open_peek_preview(u, app_state.workspace.active_tab_id)
              }
            }
          })
        })
        let is_start_active = fn() -> Bool {
          if is_split_open_live() || (reader_open.get() && shell_adapter.reader_owner_pane == 0) {
            return false
          }
          if app_state.initial_start_page_open {
            return true
          }
          let u = st.url()
          !st.loading() && proto::is_start_page_url(u)
        }
        let is_mac = proto::keys_are_macos(ui::keys_system())
        shell_ui::build_startpage_panel(
          pane_v,
          shell_ui::StartPageProps::{
            visible: is_start_active,
            dark: fn() -> Bool { chrome_theme.get() == "dark" },
            space_name: fn() -> String {
              let _ = workspace_rev.get()
              match proto::workspace_active_space(app_state.workspace) {
                Some(sp) => if sp.name != "" { sp.name } else { app_state.space_name }
                None => app_state.space_name
              }
            },
            space_accent: fn() -> Int64 {
              let _ = workspace_rev.get()
              match proto::workspace_active_space(app_state.workspace) {
                Some(sp) => proto::workspace_accent_color(sp.accent)
                None => 0x2563EBFFL
              }
            },
            search_engine_label: fn() -> String {
              let _ = settings_rev.get()
              proto::search_engine_label(app_state.settings.search_engine)
            },
            tiles: fn() -> Array[proto::StartPageTile] {
              let _ = bookmarks_rev.get()
              let _ = history_rev.get()
              proto::build_start_page_tiles(
                app_state.bookmarks_snap.items,
                app_state.history_snap.items,
                proto::START_PAGE_MAX_TILES,
              )
            },
            field: start_page_field,
            on_show: fn() -> Unit { shell_release_pane_stage_focus(0) },
            on_submit: fn(q : String) -> Unit { submit_start_page_search(st, q) },
            on_open_tile: fn(url : String) -> Unit {
              app_state.initial_start_page_open = false
              st.go(url)
            },
            quick_actions: [
              shell_ui::StartPageQuickAction::{
                label: "Bookmarks",
                shortcut: proto::bookmarks_shortcut_label(is_mac),
                icon_name: shell_ui::ICON_BOOKMARK,
                on_press: fn() -> Unit { open_bookmarks() },
              },
              shell_ui::StartPageQuickAction::{
                label: "History",
                shortcut: if is_mac { "⌘Y" } else { "Ctrl+Y" },
                icon_name: shell_ui::ICON_CLOCK,
                on_press: fn() -> Unit { open_history() },
              },
              shell_ui::StartPageQuickAction::{
                label: "Settings",
                shortcut: if is_mac { "⌘," } else { "Ctrl+," },
                icon_name: shell_ui::ICON_SETTINGS,
                on_press: fn() -> Unit { open_settings() },
              },
              shell_ui::StartPageQuickAction::{
                label: "Reader",
                shortcut: if is_mac { "⌥⌘R" } else { "Ctrl+Alt+R" },
                icon_name: shell_ui::ICON_READER,
                on_press: fn() -> Unit { toggle_reader_mode() },
              },
              shell_ui::StartPageQuickAction::{
                label: "DevTools",
                shortcut: if is_mac { "⌥⌘I" } else { "Ctrl+Shift+I" },
                icon_name: shell_ui::ICON_TERMINAL,
                on_press: fn() -> Unit { toggle_devtools() },
              },
            ],
          },
        )
        shell_ui::build_reader_mode_panel(
          pane_v,
          shell_ui::ReaderModeProps::{
            open: fn() -> Bool {
              let _ = shell_adapter.page.get()
              reader_open.get() && shell_adapter.reader_owner_pane == 0
            },
            owner_pane: shell_ui::PaneId::Primary,
            article: fn() -> proto::ReaderArticle {
              let _ = reader_rev.get()
              app_state.reader_article
            },
            rev: fn() -> Int { reader_rev.get() },
            status: fn() -> Int {
              let _ = reader_rev.get()
              shell_adapter.reader_status
            },
            theme: fn() -> String { reader_theme.get() },
            font: fn() -> String { reader_font.get() },
            font_size: fn() -> Int { reader_font_size.get() },
            width_mode: fn() -> String { reader_width_mode.get() },
            progress: fn() -> Double { reader_progress.get() },
            on_theme: fn(th : String) -> Unit { reader_theme.set(th) },
            on_font: fn(f : String) -> Unit { reader_font.set(f) },
            on_font_size: fn(sz : Int) -> Unit { reader_font_size.set(sz) },
            on_width_mode: fn(w : String) -> Unit { reader_width_mode.set(w) },
            on_progress: fn(p : Double) -> Unit { reader_progress.set(p) },
            on_close: fn() -> Unit { close_reader_mode() },
          },
        )
        shell_ui::build_find_bar_panel(
          pane_v,
          shell_ui::FindBarProps::{
            visible: fn() -> Bool {
              let _ = shell_adapter.page.get()
              find_open.get() && shell_adapter.find_owner_pane_sig.get() == 0
            },
            dark: fn() -> Bool { chrome_theme.get() == "dark" },
            field: find_field,
            case_sensitive: fn() -> Bool { find_case_sensitive.get() },
            counts: fn() -> (Int, Int) {
              if host_find_synced.get() {
                (host_find_active.get(), host_find_total.get())
              } else {
                let (at1, tot) = st.find_place()
                if tot <= 0 { (-1, 0) } else { (at1 - 1, tot) }
              }
            },
            on_query_change: fn(q : String) -> Unit { dispatch_find_query(st, q) },
            on_prev: fn() -> Unit { dispatch_find_prev(st) },
            on_next: fn() -> Unit { dispatch_find_next(st) },
            on_toggle_case: fn() -> Unit { toggle_find_case_sensitive(st) },
            on_close: fn() -> Unit { close_find_bar(st) },
          },
        )
      }
      shell_ui::PaneId::Secondary => {
        let sp_st = ensure_split_stage()
        let _ = pane_v.box(fn(sw : view::View) -> Unit {
          let _ = sw.fill().points(view::Live::By(fn() -> Bool { !shell_is_pane_occluded(1) }))
          let psv = stage::stage_node(
            sw,
            sp_st,
            on_menu=Some(fn(hit : stage::MenuHit) -> Unit { open_page_ctx(sp_st, hit) }),
          )
          let _ = psv.min_width(view::Live::Is(Some(0.0)))
          app_state.split_stage_view = Some(psv)
          shell_bind_stage_window_down(pane_v, psv, 1)
        })
        shell_ui::build_reader_mode_panel(
          pane_v,
          shell_ui::ReaderModeProps::{
            open: fn() -> Bool {
              let _ = shell_adapter.page.get()
              reader_open.get() && shell_adapter.reader_owner_pane == 1
            },
            owner_pane: shell_ui::PaneId::Secondary,
            article: fn() -> proto::ReaderArticle {
              let _ = reader_rev.get()
              app_state.reader_article
            },
            rev: fn() -> Int { reader_rev.get() },
            status: fn() -> Int {
              let _ = reader_rev.get()
              shell_adapter.reader_status
            },
            theme: fn() -> String { reader_theme.get() },
            font: fn() -> String { reader_font.get() },
            font_size: fn() -> Int { reader_font_size.get() },
            width_mode: fn() -> String { reader_width_mode.get() },
            progress: fn() -> Double { reader_progress.get() },
            on_theme: fn(th : String) -> Unit { reader_theme.set(th) },
            on_font: fn(f : String) -> Unit { reader_font.set(f) },
            on_font_size: fn(sz : Int) -> Unit { reader_font_size.set(sz) },
            on_width_mode: fn(w : String) -> Unit { reader_width_mode.set(w) },
            on_progress: fn(p : Double) -> Unit { reader_progress.set(p) },
            on_close: fn() -> Unit { close_reader_mode() },
          },
        )
        shell_ui::build_find_bar_panel(
          pane_v,
          shell_ui::FindBarProps::{
            visible: fn() -> Bool {
              let _ = shell_adapter.page.get()
              find_open.get() && shell_adapter.find_owner_pane_sig.get() == 1
            },
            dark: fn() -> Bool { chrome_theme.get() == "dark" },
            field: find_field,
            case_sensitive: fn() -> Bool { find_case_sensitive.get() },
            counts: fn() -> (Int, Int) {
              if host_find_synced.get() {
                (host_find_active.get(), host_find_total.get())
              } else {
                let (at1, tot) = sp_st.find_place()
                if tot <= 0 { (-1, 0) } else { (at1 - 1, tot) }
              }
            },
            on_query_change: fn(q : String) -> Unit { dispatch_find_query(sp_st, q) },
            on_prev: fn() -> Unit { dispatch_find_prev(sp_st) },
            on_next: fn() -> Unit { dispatch_find_next(sp_st) },
            on_toggle_case: fn() -> Unit { toggle_find_case_sensitive(sp_st) },
            on_close: fn() -> Unit { close_find_bar(sp_st) },
          },
        )
      }
    }
  })

  // The host answers every site it loads with its icon or a miss: live tabs' tiles wait for it on a neutral plate.
  shell_ui::shell_site_icons_answered(true)
  // Production host hooks: Agent Takeover Bar, Bookmarks Bar, DevTools Dock, SiteInfo/IDN/Zoom, Sidebar ctx/hover/filter, More menu
  let shell_hooks = shell_ui::ShellHostHooks::{
    on_address_bar_view: Some(fn(v : view::View) -> Unit { app_state.address_bar_view = Some(v) }),
    on_omnibox_panel_view: Some(fn(v : view::View) -> Unit { shell_adapter.omnibox_panel_view = Some(v) }),
    top_strip: Some(fn(strip : view::View) -> Unit {
      strip.show(
        fn() -> Bool { st.agent() },
        fn(line : view::View) -> Unit {
          let _ = line
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(8.0))
          .padding(view::Live::Is((12.0, 6.0, 12.0, 6.0)))
          .ground(view::Live::Is(0xFFF4D6FFL))
          let _ = line.box(fn(w : view::View) -> Unit {
            let _ = w.grow(view::Live::Is(1.0)).words(view::Live::Is("Agent 正在操作这个页面"), ink=0x1D1D1FFFL)
          })
          bar_button(line, "接管", fn() -> Unit { st.take_over() })
        },
      )
      shell_ui::build_bookmarks_bar_strip(
        strip,
        shell_ui::BookmarksBarProps::{
          open: fn() -> Bool { bookmarks_bar_open.get() },
          items: fn() -> Array[shell_ui::BookmarkChipItem] {
            let _ = bookmarks_rev.get()
            let out : Array[shell_ui::BookmarkChipItem] = []
            let src = app_state.bookmarks_snap.items
            let mut i = 0
            while i < src.length() && i < 12 {
              let bm = src[i]
              let bid = if bm.id != "" { bm.id } else { bm.url }
              let btitle = if bm.title.trim() != "" { bm.title.trim() } else { proto::omnibox_display_host(bm.url) }
              out.push(shell_ui::BookmarkChipItem::{ id: bid, title: btitle, url: bm.url })
              i += 1
            }
            out
          },
          page_saved: fn() -> Bool {
            let _ = bookmarks_rev.get()
            proto::bookmarks_contains_url(app_state.bookmarks_snap, active_stage_live().url())
          },
          on_navigate: fn(u : String) -> Unit {
            close_bm_bar_ctx()
            if u != "" {
              active_stage().go(u)
            }
          },
          on_context_menu: fn(bid : String, u : String, cx : Double, _cy : Double) -> Unit {
            open_bm_bar_ctx(bid, u, cx)
          },
          on_toggle_bookmark: fn() -> Unit { dispatch_bookmark_toggle() },
        },
      )
      // (the page-load line is drawn inside each page card by the frame: `pane_loading` below)
    }),
    bottom_dock: Some(fn(dock : view::View) -> Unit {
      let init_pres = if shell_adapter.initial_devtools_floating {
        shell_ui::DevToolsPresentation::Floating
      } else {
        shell_ui::DevToolsPresentation::Docked
      }
      let dt_state = shell_ui::DevToolsPanelState::{
        presentation: signals::signal(init_pres),
        tab: devtools_tab,
        height: devtools_height,
        dragging: devtools_dragging,
        selected_path: devtools_selected_path,
        collapsed_paths: app_state.devtools_collapsed,
        collapse_rev: signals::signal(0),
        console_filter: devtools_console_filter,
        repl_field: devtools_repl_field,
        net_filter: devtools_net_filter,
        net_query: devtools_net_query,
        net_search_field: devtools_net_search_field,
        net_selected_idx: devtools_net_selected_idx,
      }
      shell_adapter.devtools_panel_state = Some(dt_state)
      shell_ui::build_devtools_panel(
        dock,
        shell_build_devtools_props(devtools_open, devtools_rev, dt_state),
        docked_only=true,
      )
    }),
    sidebar_filter_slot: Some(fn(sb : view::View) -> Unit {
      shell_ui::build_tab_filter_bar(
        sb,
        shell_ui::TabFilterBarProps::{
          open: fn() -> Bool { tab_filter_open.get() },
          field: tab_filter_field,
          matched_count: fn() -> Int {
            let _ = workspace_rev.get()
            proto::tab_filter_compute_stats(
              app_state.workspace,
              app_state.workspace.active_space_id,
              tab_filter_query.get(),
            ).matched
          },
          total_count: fn() -> Int {
            let _ = workspace_rev.get()
            proto::tab_filter_compute_stats(
              app_state.workspace,
              app_state.workspace.active_space_id,
              tab_filter_query.get(),
            ).total
          },
          on_query_change: fn(q : String) -> Unit {
            if tab_filter_open.untracked() {
              tab_filter_query.set(q)
            }
          },
          on_clear: fn() -> Unit { clear_tab_filter_query_only() },
          on_close: fn() -> Unit { close_tab_filter() },
        },
      )
    }),
    sidebar_folder_create_slot: Some(fn(sb : view::View) -> Unit {
      shell_ui::build_inline_folder_creator_bar(
        sb,
        shell_ui::InlineFolderCreatorProps::{
          open: fn() -> Bool { folder_create_open.get() },
          name_field: folder_create_field,
          color: folder_create_color,
          move_active_tab: folder_create_move_active,
          on_submit: fn(name : String, color : String, move_active : Bool) -> Unit {
            dispatch_folder_create_colored(name, color, move_active)
          },
          on_cancel: fn() -> Unit { close_folder_create_bar() },
          return_focus: None,
        },
      )
    }),
    address_trailing_slot: Some(fn(pill : view::View) -> Unit {
      // IDN spoofing warning badge
      shell_ui::build_idna_spoof_capsule(
        pill,
        fn() -> Bool { current_url_safety().is_spoof_warning },
        fn() -> Bool { idn_popover_open.get() },
        fn() -> Unit { toggle_idn_popover() },
      )
      // Nothing else rests in the capsule, so the Address Bar keeps its width (Arc): Page Zoom and Site Boosts
      // live in Site Controls (the leading button), Bookmark Page in the More menu (and Cmd+D). An active Boost is
      // a state worth seeing: a small purple badge on the Site Controls glyph, laid over it (no reflow, no press).
      let has_active_boost = fn() -> Bool {
        let _ = boosts_rev.get()
        let p = shell_adapter.page.get()
        let pane = if (p.active_pane is shell_ui::PaneId::Secondary) && (is_split_open() || is_peek_open()) { 1 } else { 0 }
        let h = cookies_canonical_host(shell_pane_raw_url_live(pane))
        if h == "" {
          false
        } else {
          let (b_snap, b_legacy) = if pane == 1 {
            (shell_adapter.split_boosts_snap, shell_adapter.split_boosts_legacy_bare)
          } else {
            (app_state.boosts_snap, shell_adapter.boosts_legacy_bare)
          }
          match proto::boosts_find_with_legacy(b_snap, b_legacy, h) {
            Some(b) => b.enabled
            None => false
          }
        }
      }
      pill.show(has_active_boost, fn(dot : view::View) -> Unit {
        let _ = dot
        .over(view::Live::Is(true), edges=(Some(shell_ui::SP_20), Some(shell_ui::SP_6), None, None))
        .width(view::Live::Is(Some(shell_ui::SP_6)))
        .height(view::Live::Is(Some(shell_ui::SP_6)))
        .radius(view::Live::Is(shell_ui::SP_6 / 2.0))
        .points(view::Live::Is(false))
        .ground(view::Live::Is(shell_ui::shell_boost_mark()))
        .says(view::Live::Is(Some(view::said(view::Role::Image, label="Boost Active"))))
      })
    }),
    address_inline_slot: Some(fn(row : view::View) -> Unit {
      // A page zoom that is not 100% is a state worth seeing (Arc shows it in the address): a quiet percent after
      // the host, inside the Address Bar's press box, so it takes no width from the target. Zoom itself is
      // changed from Site Controls, Cmd+= / Cmd+- and Cmd+0.
      row.show(fn() -> Bool { (active_stage_live().zoom() - 1.0).abs() > 0.005 }, fn(zm : view::View) -> Unit {
        let _ = zm
        .rigid()
        .height(view::Live::Is(Some(shell_ui::SP_20)))
        .padding(view::Live::Is((shell_ui::SP_6, shell_ui::SP_0, shell_ui::SP_6, shell_ui::SP_0)))
        .radius(view::Live::Is(shell_ui::SP_6))
        .center()
        .ground(view::Live::By(fn() -> Int64 { shell_ui::shell_wash(lg::is_dark()) }))
        .says(view::Live::Is(Some(view::said(view::Role::Status, label="Page Zoom"))))
        let _ = <ui::Text
          in={zm}
          size={shell_ui::TX_CAPTION}
          weight={600}
          lines={1}
          color_by=>{lg::surface().ink_secondary}
          text_by=>{((active_stage_live().zoom() * 100.0 + 0.5).to_int()).to_string() + "%"}
        />
      })
    }),
    on_site_info: Some(fn() -> Unit { toggle_site_info() }),
    on_nav_history: Some(fn(dir : Int, ax : Double) -> Unit { open_nav_hist(dir, ax) }),
    on_tab_context: Some(fn(id : String, y : Double) -> Unit { open_tab_ctx(id, y) }),
    on_tab_hover: Some(fn(id : String, y : Double, entered : Bool) -> Unit {
      if entered {
        open_tab_hover_preview(id, y)
      } else {
        close_tab_hover_preview()
      }
    }),
    on_folder_context: Some(fn(id : String, y : Double) -> Unit { open_folder_ctx(id, y) }),
    on_space_header_click: Some(fn() -> Unit { toggle_space_theme() }),
    // The sidebar magnifier opens the same Tab Search as Cmd+Shift+A (one way to find a tab).
    on_tab_count_click: Some(fn() -> Unit { toggle_tab_search() }),
    extra_more_items: Some(fn() -> Array[lg::LiquidMenuEntry] {
      let is_mac = shell_ui::shell_keys_mac()
      let mk = fn(m : String, o : String) -> String { if is_mac { m } else { o } }
      let bookmarked = {
        let u = active_address_raw_url_untracked().trim()
        u != "" && proto::bookmarks_contains_url(app_state.bookmarks_snap, u)
      }
      [
        lg::LiquidMenuEntry::item(
          label=if bookmarked { "Remove Bookmark" } else { "Bookmark Page" },
          shortcut=mk("⌘D", "Ctrl+D"),
          icon=fn(ic, ink) {
            let _ = shell_ui::shell_icon(ic, if bookmarked { shell_ui::ICON_STAR_FILLED } else { shell_ui::ICON_STAR }, size=shell_ui::IC_MD, color_by=ink)
          },
          on_select=fn() { dispatch_bookmark_toggle() },
        ),
        lg::LiquidMenuEntry::item(
          label="Find in Page…",
          shortcut=mk("⌘F", "Ctrl+F"),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_SEARCH, size=14.0, color_by=ink) },
          on_select=fn() { open_find_bar() },
        ),
        lg::LiquidMenuEntry::item(
          label="Media Hub",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_VOLUME, size=14.0, color_by=ink) },
          on_select=fn() { toggle_media_hub() },
        ),
        lg::LiquidMenuEntry::item(
          label="Downloads",
          shortcut=mk("⌘J", "Ctrl+J"),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_DOWNLOAD, size=14.0, color_by=ink) },
          on_select=fn() { toggle_downloads() },
        ),
        lg::LiquidMenuEntry::item(
          label="History",
          shortcut=mk("⌘Y", "Ctrl+Y"),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_CLOCK, size=14.0, color_by=ink) },
          on_select=fn() { toggle_history() },
        ),
        lg::LiquidMenuEntry::item(
          label="Bookmarks",
          shortcut=proto::bookmarks_shortcut_label(is_mac),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_BOOKMARK, size=14.0, color_by=ink) },
          on_select=fn() { toggle_bookmarks() },
        ),
        lg::LiquidMenuEntry::item(
          label="Bookmarks Bar",
          shortcut=proto::bookmarks_bar_shortcut_label(is_mac),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_STAR, size=14.0, color_by=ink) },
          on_select=fn() { toggle_bookmarks_bar() },
        ),
        lg::LiquidMenuEntry::item(
          label="Developer Tools",
          shortcut=proto::devtools_shortcut_label(is_mac),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_ZAP, size=14.0, color_by=ink) },
          on_select=fn() { toggle_devtools() },
        ),
        lg::LiquidMenuEntry::item(
          label="Print / PDF Settings…",
          shortcut=mk("⌘P", "Ctrl+P"),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_DOWNLOAD, size=14.0, color_by=ink) },
          on_select=fn() { open_print_pdf_modal() },
        ),
        lg::LiquidMenuEntry::item(
          label="Keyboard Shortcuts",
          shortcut=mk("⌘/", "Ctrl+/"),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_COMMAND, size=14.0, color_by=ink) },
          on_select=fn() { toggle_shortcuts() },
        ),
        lg::LiquidMenuEntry::item(
          label="Manage Spaces…",
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_LAYERS, size=14.0, color_by=ink) },
          on_select=fn() { open_spaces_manager() },
        ),
        lg::LiquidMenuEntry::item(
          label="Settings…",
          shortcut=mk("⌘,", "Ctrl+,"),
          icon=fn(ic, ink) { let _ = shell_ui::shell_icon(ic, shell_ui::ICON_SETTINGS, size=14.0, color_by=ink) },
          on_select=fn() { toggle_settings() },
        ),
      ]
    }),
    hide_demo_export_pdf: true,
    peek_can_back: Some(fn() -> Bool {
      match app_state.split_stage {
        Some(sp) => sp.can_back()
        None => false
      }
    }),
    peek_can_forward: Some(fn() -> Bool {
      match app_state.split_stage {
        Some(sp) => sp.can_forward()
        None => false
      }
    }),
    command_bar: Some(shell_ui::CommandBarProps::{
      field: command_bar_field,
      items: fn() -> Array[proto::CommandBarItem] {
        let _ = command_bar_rev.get()
        app_state.command_bar_items
      },
      selected: fn() -> Int { command_bar_selected.get() },
      on_query_change: fn(q : String) -> Unit {
        refresh_command_bar_items(q)
        if app_state.command_bar_items.length() > 0 {
          command_bar_selected.set(0)
        }
      },
      on_step: fn(delta : Int) -> Bool { step_command_bar_selection(delta) },
      on_submit: fn(t : String) -> Unit { submit_command_bar(st, t) },
      on_execute: fn(it : proto::CommandBarItem) -> Unit { execute_command_bar_item(st, it) },
      on_close: fn() -> Unit { close_command_bar() },
      on_row_view: Some(fn(b : view::View) -> Unit { app_state.command_bar_row_views.push(b) }),
      on_clear_rows: Some(fn() -> Unit { app_state.command_bar_row_views.clear() }),
    }),
    tab_search: Some(shell_ui::TabSearchProps::{
      field: tab_search_field,
      results: fn() -> proto::TabSearchResult {
        let _ = workspace_rev.get()
        let _ = closed_tabs_rev.get()
        let _ = tab_search_query.get()
        current_tab_search_results()
      },
      selected: fn() -> Int { tab_search_selected.get() },
      on_query_change: fn(q : String) -> Unit {
        tab_search_query.set(q)
        tab_search_selected.set(0)
      },
      on_submit: fn() -> Unit { commit_tab_search_selection() },
      on_activate: fn(it : proto::TabSearchItem) -> Unit { activate_tab_search_item(it) },
      on_close_tab: fn(tid : String) -> Unit { dispatch_tab_close(tid) },
      on_close: fn() -> Unit { close_tab_search() },
    }),
    body_overlays: Some(fn(body_host : view::View) -> Unit {
      shell_adapter.body_overlays_host = Some(body_host)
    }),
    sidebar_modes: Some(app_sidebar_mode_props(workspace_rev, boosts_rev, closed_tabs_rev)),
    pane_loading: Some(fn(pane : shell_ui::PaneId) -> Bool {
      match pane {
        shell_ui::PaneId::Primary => get_stage().loading()
        shell_ui::PaneId::Secondary =>
        match app_state.split_stage {
          Some(sp) if shell_adapter.page.get().has_secondary() => sp.loading()
          _ => false
        }
      }
    }),
    downloads_activity: Some(dl_activity_now),
    on_downloads_activity: Some(fn() -> Unit {
      // (a failed download keeps its row until it is looked at)
      dl_activity_keys.clear()
      dl_activity_rev.set(dl_activity_rev.untracked() + 1)
      toggle_downloads()
    }),
  }

  // The window is titled after the page it shows (the Window menu, Mission Control, the Dock and Cmd+` list it so),
  // following the active tab as it switches and as its page names itself.
  root.reacts(fn() -> String { proto::window_title_for(live_shell_model.active_title(), live_shell_model.active_url()) }, fn(
    t : String,
  ) -> Unit {
    hostapi::window_set_title(hostapi::window_current(), t)
  })
  // The host is told which tab Split View's second pane shows (its auto-archive never takes a tab on screen).
  match app_state.split_tab_id {
    Some(sid) => root.reacts(fn() -> String { sid.get() }, fn(id : String) -> Unit { send_wire(split_tab_act(id)) }, at_start=false)
    None => ()
  }

  // Live production Desktop Shell 2.0 frame (`render_passive_overlays=true`: single-source CaptureSheet & Toast)
  shell_ui::build_shell_frame(
    root,
    live_shell_model,
    dispatch_shell_intent,
    pane_slot,
    render_passive_overlays=true,
    on_focus_pane=Some(shell_focus_pane_stage),
    hooks=Some(shell_hooks),
  )
}

///| Mounts all Phase 2B Liquid Glass popovers, overlays, HUDs, and context menus from `shell_ui`.
///| Single source of truth: every Exclusive overlay matches its exact `ex.tag == "<tag>"`.
fn build_phase2b_overlays(
  root : view::View,
  st : stage::Stage,
  workspace_rev : signals::Signal[Int],
  site_info_open : signals::Signal[Bool],
  site_perms_rev : signals::Signal[Int],
  boosts_rev : signals::Signal[Int],
  cookies_rev : signals::Signal[Int],
  idn_popover_open : signals::Signal[Bool],
  media_hub_open : signals::Signal[Bool],
  media_hub_rev : signals::Signal[Int],
  zoom_popover_open : signals::Signal[Bool],
  downloads_open : signals::Signal[Bool],
  downloads_rev : signals::Signal[Int],
  downloads_field : ui::Field,
  downloads_cat : signals::Signal[String],
  shortcuts_open : signals::Signal[Bool],
  perf_hud_open : signals::Signal[Bool],
  perf_hud_rev : signals::Signal[Int],
  tab_preview_open : signals::Signal[Bool],
  tab_preview_tab_id : signals::Signal[String],
  tab_preview_y : signals::Signal[Double],
  reader_open : signals::Signal[Bool],
  page_ctx_open : signals::Signal[Bool],
  page_ctx_link : signals::Signal[String],
  page_ctx_image : signals::Signal[String],
  page_ctx_selection : signals::Signal[String],
  page_ctx_x : signals::Signal[Double],
  page_ctx_y : signals::Signal[Double],
  page_ctx_can_back : signals::Signal[Bool],
  page_ctx_can_forward : signals::Signal[Bool],
  nav_hist_open : signals::Signal[Bool],
  nav_hist_dir : signals::Signal[Int],
  nav_hist_x : signals::Signal[Double],
  tab_ctx_open : signals::Signal[Bool],
  tab_ctx_tab_id : signals::Signal[String],
  tab_ctx_y : signals::Signal[Double],
  folder_ctx_open : signals::Signal[Bool],
  folder_ctx_id : signals::Signal[String],
  folder_ctx_y : signals::Signal[Double],
  folder_name_field : ui::Field,
  bm_bar_ctx_open : signals::Signal[Bool],
  bm_bar_ctx_id : signals::Signal[String],
  bm_bar_ctx_url : signals::Signal[String],
  bm_bar_ctx_x : signals::Signal[Double],
  space_theme_open : signals::Signal[Bool],
  space_name_field : ui::Field,
  mru_open : signals::Signal[Bool],
  mru_rev : signals::Signal[Int],
  mru_selected : signals::Signal[Int],
) -> Unit {
  let fallback_capsule = fn() -> shell_ui::AnchorRect {
    match shell_ui::anchor_from_view(app_state.address_bar_view) {
      Some(r) => r
      None => shell_ui::shell_address_fallback_rect(
        shell_adapter.dock.get(),
        shell_live_window_w(),
        inset=shell_ui::shell_live_traffic_light_inset(),
      )
    }
  }
  let exact_tag_open = fn(sig : signals::Signal[Bool], tag : String) -> Bool {
    sig.get() && shell_adapter.exclusive.get().tag == tag
  }

  // Auto-close SiteInfo if the bound pane navigates to a different origin (Astra #4)
  root.reacts(
    at_start=false,
    fn() -> String {
      if !site_info_open.get() {
        return ""
      }
      let owner = shell_adapter.site_info_owner_pane
      let raw = shell_pane_raw_url_live(owner)
      let norm = proto::normalize_permission_origin(raw)
      if norm != "" { norm } else { proto::site_origin_from_url(raw) }
    },
    fn(cur_origin : String) -> Unit {
      if site_info_open.untracked() &&
      shell_adapter.site_info_committed_origin != "" &&
      cur_origin != "" &&
      cur_origin != shell_adapter.site_info_committed_origin {
        close_site_info()
      }
    },
  )

  // Auto-close Cookies Inspector (including nested inside SiteInfo) when bound pane navigates to a different origin
  root.reacts(
    at_start=false,
    fn() -> String {
      let is_ck_open = match app_state.cookies_open {
        Some(s) => s.get()
        None => false
      }
      if !is_ck_open {
        return ""
      }
      let owner = shell_adapter.cookies_owner_pane
      let raw = shell_pane_raw_url_live(owner)
      let norm = proto::normalize_permission_origin(raw)
      let site_orig = proto::site_origin_from_url(raw)
      if norm != "" { norm } else if site_orig != "" { site_orig } else { raw.trim() }
    },
    fn(cur_origin : String) -> Unit {
      if shell_sig_is_true(app_state.cookies_open) &&
      shell_adapter.cookies_committed_origin != "" &&
      cur_origin != "" &&
      cur_origin != shell_adapter.cookies_committed_origin {
        close_cookies_modal()
      }
    },
  )

  // Auto-close IDNA spoof popover when warning clears, pane changes, or origin navigates
  root.reacts(
    at_start=false,
    fn() -> (Bool, Bool, Int, String) {
      let open = idn_popover_open.get()
      if !open {
        return (false, false, 0, "")
      }
      let owner = shell_adapter.idn_popover_owner_pane
      let raw = shell_pane_raw_url_live(owner)
      let norm = proto::normalize_permission_origin(raw)
      let orig = if norm != "" { norm } else { proto::site_origin_from_url(raw) }
      let cur_pane = if (shell_adapter.page.get().active_pane is shell_ui::PaneId::Secondary) && (is_split_open() || is_peek_open()) { 1 } else { 0 }
      (true, current_url_safety().is_spoof_warning, cur_pane, orig)
    },
    fn(st_tuple : (Bool, Bool, Int, String)) -> Unit {
      let (open, is_spoof, cur_pane, cur_orig) = st_tuple
      if open && idn_popover_open.untracked() {
        let wrong_pane = cur_pane != shell_adapter.idn_popover_owner_pane
        let orig_changed = shell_adapter.idn_popover_committed_origin != "" &&
        cur_orig != "" &&
        cur_orig != shell_adapter.idn_popover_committed_origin
        if !is_spoof || wrong_pane || orig_changed {
          close_idn_popover()
        }
      }
    },
  )

  // 1. Live Page Performance & Security HUD (mounted BEFORE menus & popovers)
  shell_ui::build_perf_hud_overlay(
    root,
    shell_ui::PerfHudProps::{
      open: fn() -> Bool { perf_hud_open.get() },
      metrics: fn() -> shell_ui::PerfHudMetrics {
        let _ = perf_hud_rev.get()
        let _ = workspace_rev.get()
        let s = app_state.perf_hud_snap
        let cur_url = active_stage_live().url()
        let h = if s.host != "" { s.host } else { proto::omnibox_display_host(cur_url) }
        let (sp_name, sp_hex) = match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => (
            if sp.name != "" { sp.name } else if s.active_space != "" { s.active_space } else { app_state.space_name },
            proto::normalize_space_accent(sp.accent),
          )
          None => (if s.active_space != "" { s.active_space } else { app_state.space_name }, "#2563EB")
        }
        let zoom_pct = if s.zoom_pct > 0 { s.zoom_pct } else { active_stage_live().zoom_percent() }
        shell_ui::PerfHudMetrics::{
          host_label: if h != "" { h } else { "about:blank" },
          scheme: if s.scheme != "" { s.scheme } else if proto::site_is_https(cur_url) { "https" } else if proto::site_is_local(cur_url) { "local" } else { "http" },
          tls_secure: s.is_https || proto::site_is_https(cur_url),
          dom_nodes: s.dom_nodes,
          stylesheets: s.stylesheets,
          images: s.images,
          doc_width: s.doc_width,
          doc_height: s.doc_height,
          zoom_percent: zoom_pct,
          cookies_count: s.cookies_count,
          space_name: sp_name,
          space_accent: proto::workspace_accent_color(sp_hex),
        }
      },
      top_offset: fn() -> Double {
        let bm_h = match app_state.bookmarks_bar_open {
          Some(sig) if sig.get() => 33.0
          _ => 0.0
        }
        let sp_h = if is_split_open() { shell_ui::SHELL_SPLIT_BAR_H } else { 0.0 }
        shell_live_content_top() + bm_h + sp_h + shell_ui::SP_8
      },
      on_refresh: fn() -> Unit { dispatch_perf_hud_sync() },
      on_close: fn() -> Unit { close_perf_hud() },
    },
  )

  // 2. Tab Hover Preview Card (mounted BEFORE context menus & modals)
  shell_ui::build_tab_hover_preview_card(
    root,
    shell_ui::TabHoverPreviewProps::{
      open: fn() -> Bool { is_sidebar_open_live() && tab_preview_open.get() },
      snapshot: fn() -> Option[shell_ui::TabHoverPreviewSnapshot] {
        let _ = workspace_rev.get()
        let _ = media_hub_rev.get()
        let tid = tab_preview_tab_id.get()
        if tid == "" {
          return None
        }
        match find_tab_summary(tid) {
          Some(tb) => {
            let (playing, muted) = tab_preview_media_state(tb)
            let in_split = tab_preview_is_in_split(tb)
            let is_reader = tb.active && reader_open.get()
            let mut sp_name = tb.space_id
            let mut i = 0
            while i < app_state.workspace.spaces.length() {
              if app_state.workspace.spaces[i].id == tb.space_id {
                sp_name = app_state.workspace.spaces[i].name
                break
              }
              i += 1
            }
            Some(shell_ui::TabHoverPreviewSnapshot::{
              tab_id: tb.id,
              title: proto::tab_preview_display_title(proto::workspace_tab_display_title(tb)),
              clean_host: proto::tab_preview_display_url(tb.url),
              space_name: sp_name,
              playing,
              muted,
              in_split,
              in_reader: is_reader,
            })
          }
          None => None
        }
      },
      anchor_x: fn() -> Double { shell_live_sidebar_anchor_x(root) },
      anchor_y: fn() -> Double { tab_preview_y.get() },
    },
  )

  // 3. SiteInfo & Permissions Popover (`site_info`, strict `(owner_pane, committed_origin)` lock)
  shell_ui::build_site_info_popover(
    root,
    shell_ui::SiteInfoPopoverProps::{
      open: fn() -> Bool { exact_tag_open(site_info_open, "site_info") },
      snapshot: fn() -> shell_ui::SiteInfoSnapshot {
        let _ = workspace_rev.get()
        let _ = site_perms_rev.get()
        let _ = boosts_rev.get()
        let _ = cookies_rev.get()
        let owner = shell_adapter.site_info_owner_pane
        let raw_u = shell_pane_raw_url_live(owner)
        let locked_origin = if shell_adapter.site_info_committed_origin != "" {
          shell_adapter.site_info_committed_origin
        } else {
          let n = proto::normalize_permission_origin(raw_u)
          if n != "" { n } else { proto::site_origin_from_url(raw_u) }
        }
        let target_u = if locked_origin != "" { locked_origin } else { raw_u }
        let safe_host = proto::omnibox_display_host(target_u)
        let display_host = if safe_host != "" { safe_host } else { proto::omnibox_safe_display_url(locked_origin) }
        let is_https = proto::site_is_https(target_u)
        let is_local = proto::site_is_local(target_u) || proto::is_start_page_url(target_u)
        let tls_summary = if is_https {
          "Connection uses HTTPS transport encryption."
        } else if is_local {
          "Local or built-in document."
        } else {
          "Connection is not encrypted (HTTP)."
        }
        let idn = proto::build_site_idn_verification(target_u)
        let rule = active_site_permission_rule(locked_origin)
        let boost_host = proto::normalize_boost_host(target_u)
        let (b_snap, b_legacy) = if owner == 1 {
          (shell_adapter.split_boosts_snap, shell_adapter.split_boosts_legacy_bare)
        } else {
          (app_state.boosts_snap, shell_adapter.boosts_legacy_bare)
        }
        let boost_active = boost_host != "" &&
        match proto::boosts_find_with_legacy(b_snap, b_legacy, boost_host) {
          Some(b) => b.enabled
          None => false
        }
        let zoom_pct = if owner == 1 {
          match app_state.split_stage {
            Some(sp) => sp.zoom_percent()
            None => st.zoom_percent()
          }
        } else {
          st.zoom_percent()
        }
        shell_ui::SiteInfoSnapshot::{
          owner_pane: owner,
          committed_origin: locked_origin,
          display_host: if display_host != "" { display_host } else { "about:blank" },
          tls_secure: is_https,
          tls_local: is_local,
          tls_summary,
          idn_warning: idn.status_code == 2,
          idn_badge: idn.badge_label,
          idn_detail: if idn.status_code == 2 && idn.safe_punycode != "" { idn.safe_punycode } else { idn.detail_line },
          cookies_count: {
            let raw_ck = if owner == 1 { shell_adapter.split_cookies_snap } else { app_state.cookies_snap }
            let want_h = cookies_canonical_host(locked_origin)
            if want_h == "" || cookies_snap_norm_host(raw_ck) != want_h { 0 } else { raw_ck.cookies.length() }
          },
          zoom_percent: zoom_pct,
          boost_active,
          reader_active: shell_sig_is_true(app_state.reader_open) && shell_adapter.reader_owner_pane == owner,
          permissions: [
            shell_ui::SitePermissionEntry::{ kind: "camera", label: "Camera", state: proto::normalize_site_perm_value(rule.camera) },
            shell_ui::SitePermissionEntry::{ kind: "microphone", label: "Microphone", state: proto::normalize_site_perm_value(rule.microphone) },
            shell_ui::SitePermissionEntry::{ kind: "notifications", label: "Notifications", state: proto::normalize_site_perm_value(rule.notifications) },
            shell_ui::SitePermissionEntry::{ kind: "geolocation", label: "Location", state: proto::normalize_site_perm_value(rule.geolocation) },
            shell_ui::SitePermissionEntry::{ kind: "clipboard", label: "Clipboard", state: proto::normalize_site_perm_value(rule.clipboard) },
          ],
        }
      },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        match shell_ui::anchor_from_view(app_state.address_bar_view) {
          Some(ab) => Some(shell_ui::AnchorRect::{ x: ab.x, y: ab.y, w: 32.0, h: ab.h })
          None => None
        }
      },
      fallback_capsule,
      callbacks: shell_ui::SiteInfoCallbacks::{
        on_close: fn() -> Unit { close_site_info() },
        // Share and Reader act on the pane Site Info was opened for (the secondary of a split or a Peek too).
        on_share: fn(pane : Int, _origin : String) -> Unit {
          let u = shell_pane_raw_url(pane)
          close_site_info()
          if u != "" {
            copy_url_with_toast(u)
          }
        },
        on_capture: fn(_pane : Int) -> Unit {
          close_site_info()
          dispatch_capture_screenshot()
        },
        on_reader: fn(pane : Int) -> Unit {
          close_site_info()
          set_active_split_pane(pane)
          toggle_reader_mode()
        },
        on_permission_change: fn(pane : Int, origin : String, kind : String, next_state : String) -> Unit {
          dispatch_site_perm_set_for_pane(pane, origin, kind, next_state)
        },
        on_open_cookies: fn(pane : Int, origin : String) -> Unit {
          let h = cookies_canonical_host(origin)
          open_cookies_modal(host_override=h, pane_id=pane)
        },
        on_open_zoom: fn(_pane : Int) -> Unit { open_zoom_popover() },
        on_open_boosts: fn(_pane : Int, _origin : String) -> Unit {
          close_site_info()
          open_boosts()
        },
        on_reset_permissions: fn(pane : Int, origin : String) -> Unit {
          dispatch_site_perm_reset_for_pane(pane, origin)
        },
        on_clear_site_data: fn(pane : Int, origin : String) -> Unit {
          dispatch_site_clear_data_for_pane(pane, origin)
        },
      },
    },
  )

  // 4. IDNA Spoof Warning Popover (`idn_popover`)
  shell_ui::build_idna_spoof_popover(
    root,
    shell_ui::IdnaSpoofPopoverProps::{
      open: fn() -> Bool { exact_tag_open(idn_popover_open, "idn_popover") && current_url_safety().is_spoof_warning },
      snapshot: fn() -> shell_ui::IdnaSpoofSnapshot {
        let s = current_url_safety()
        let raw_u = active_address_raw_url()
        shell_ui::IdnaSpoofSnapshot::{
          unicode_host: proto::site_origin_from_url(raw_u),
          punycode_host: s.display_host,
          warning_summary: s.warning_summary,
          warning_detail: s.warning_detail,
        }
      },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        match shell_ui::anchor_from_view(app_state.address_bar_view) {
          Some(ab) => Some(shell_ui::AnchorRect::{ x: ab.x, y: ab.y, w: 32.0, h: ab.h })
          None => None
        }
      },
      fallback_capsule,
      on_close: fn() -> Unit { close_idn_popover() },
    },
  )

  // 5. Global Media Hub Popover (`media_hub`, stable `tab_id`)
  shell_ui::build_media_hub_popover(
    root,
    shell_ui::MediaHubPopoverProps::{
      open: fn() -> Bool { exact_tag_open(media_hub_open, "media_hub") },
      entries: fn() -> Array[shell_ui::MediaHubEntry] {
        let _ = media_hub_rev.get()
        let _ = workspace_rev.get()
        let src = effective_media_hub_snapshot().sessions
        let out : Array[shell_ui::MediaHubEntry] = []
        let mut i = 0
        while i < src.length() {
          let m = src[i]
          out.push(shell_ui::MediaHubEntry::{
            tab_id: m.tab_id,
            title: m.title,
            source_host: m.artist_or_host,
            playing: m.playing,
            muted: m.muted,
            is_live_call: m.is_live_call,
          })
          i += 1
        }
        out
      },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        match shell_ui::anchor_from_view(app_state.address_bar_view) {
          Some(ab) => Some(shell_ui::AnchorRect::{ x: ab.x + ab.w - 32.0, y: ab.y, w: 32.0, h: ab.h })
          None => None
        }
      },
      fallback_capsule,
      callbacks: shell_ui::MediaHubCallbacks::{
        on_toggle_play: fn(tid : String) -> Unit { dispatch_media_toggle_play(tid) },
        on_toggle_mute: fn(tid : String) -> Unit { dispatch_media_toggle_mute(tid) },
        on_mute_all: fn() -> Unit { dispatch_media_mute_all() },
        on_jump_tab: fn(tid : String) -> Unit {
          close_media_hub()
          if tid != "" {
            dispatch_tab_switch(tid)
          }
        },
        on_close: fn() -> Unit { close_media_hub() },
      },
    },
  )

  // 6. Zoom Popover (`zoom_popover`)
  shell_ui::build_zoom_popover(
    root,
    shell_ui::ZoomPopoverProps::{
      open: fn() -> Bool { exact_tag_open(zoom_popover_open, "zoom_popover") },
      host_label: fn() -> String { proto::zoom_popover_host_label(active_stage_live().url()) },
      zoom_percent: fn() -> Int { active_stage_live().zoom_percent() },
      can_zoom_out: fn() -> Bool { proto::zoom_can_step_down(active_stage_live().zoom()) },
      can_zoom_in: fn() -> Bool { proto::zoom_can_step_up(active_stage_live().zoom()) },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        match shell_ui::anchor_from_view(app_state.address_bar_view) {
          Some(ab) => Some(shell_ui::AnchorRect::{ x: ab.x + ab.w - 40.0, y: ab.y, w: 40.0, h: ab.h })
          None => None
        }
      },
      fallback_capsule,
      on_zoom_out: fn() -> Unit {
        let cur = active_stage()
        apply_zoom_and_sync(cur, proto::zoom_step_down(cur.zoom()))
      },
      on_zoom_in: fn() -> Unit {
        let cur = active_stage()
        apply_zoom_and_sync(cur, proto::zoom_step_up(cur.zoom()))
      },
      on_reset: fn() -> Unit {
        let cur = active_stage()
        apply_zoom_and_sync(cur, 1.0)
      },
      on_save_default: fn() -> Unit {
        let cur_pct = active_stage().zoom_percent()
        let next = proto::BrowserSettings::{ ..app_state.settings, default_zoom_pct: cur_pct }
        dispatch_settings_save(
          next,
          toast_msg="Default Zoom Saved (\{cur_pct}%)",
        )
        close_zoom_popover()
      },
      on_close: fn() -> Unit { close_zoom_popover() },
    },
  )

  // 7. Downloads Popover (`downloads`, pure UI over existing `DownloadsTracker` protocol)
  shell_ui::build_downloads_popover(
    root,
    shell_ui::DownloadsPopoverProps::{
      open: fn() -> Bool { exact_tag_open(downloads_open, "downloads") },
      search_field: downloads_field,
      active_category: fn() -> String { downloads_cat.get() },
      total_count: fn() -> Int {
        let _ = downloads_rev.get()
        app_state.downloads.length()
      },
      items: fn() -> Array[shell_ui::DownloadItemView] {
        let _ = downloads_rev.get()
        let cat = downloads_cat.get()
        let q = downloads_field.text()
        let out : Array[shell_ui::DownloadItemView] = []
        let all_dl = app_state.downloads
        let all_keys = shell_adapter.download_row_keys
        let mut i = 0
        while i < all_dl.length() && out.length() < 32 {
          let d = all_dl[i]
          if proto::filter_downloads([d], q, cat).length() > 0 {
            let st_norm = proto::normalize_download_state(d.state)
            let rk = if i < all_keys.length() { all_keys[i] } else { download_identity_key(d) }
            out.push(shell_ui::DownloadItemView::{
              id: rk,
              filename: d.filename,
              source_host: proto::omnibox_display_host(d.url),
              ext_badge: proto::download_ext_badge(d.filename),
              size_label: proto::format_download_bytes(d.bytes),
              state: st_norm,
              state_label: proto::download_state_label(st_norm),
            })
          }
          i += 1
        }
        out
      },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        let _ = root.laid_size_told()
        let ww = root.window_w()
        let vw = if ww > 100.0 { ww } else {
          let (rw, _) = root.laid_size()
          if rw > 100.0 { rw } else { 1280.0 }
        }
        if vw < 540.0 {
          None
        } else {
          Some(shell_ui::AnchorRect::{ x: vw - 44.0, y: 4.0, w: 36.0, h: 36.0 })
        }
      },
      fallback_capsule,
      callbacks: shell_ui::DownloadsCallbacks::{
        on_search_change: fn(_q : String) -> Unit { () },
        on_category_change: fn(c : String) -> Unit { downloads_cat.set(c) },
        on_copy_path: fn(dl_id : String) -> Unit {
          let all_dl = app_state.downloads
          let all_keys = shell_adapter.download_row_keys
          let mut i = 0
          while i < all_dl.length() {
            let d = all_dl[i]
            let rk = if i < all_keys.length() { all_keys[i] } else { download_identity_key(d) }
            if rk == dl_id {
              copy_download_path_with_toast(d)
              return
            }
            i += 1
          }
        },
        on_reveal: fn(dl_id : String) -> Unit {
          let all_dl = app_state.downloads
          let all_keys = shell_adapter.download_row_keys
          let mut i = 0
          while i < all_dl.length() {
            let d = all_dl[i]
            let rk = if i < all_keys.length() { all_keys[i] } else { download_identity_key(d) }
            if rk == dl_id {
              reveal_download_with_toast(d)
              return
            }
            i += 1
          }
        },
        on_open: fn(dl_id : String) -> Unit {
          let all_dl = app_state.downloads
          let all_keys = shell_adapter.download_row_keys
          let mut i = 0
          while i < all_dl.length() {
            let d = all_dl[i]
            let rk = if i < all_keys.length() { all_keys[i] } else { download_identity_key(d) }
            if rk == dl_id {
              open_download_with_toast(d)
              return
            }
            i += 1
          }
        },
        on_clear_list: fn() -> Unit {
          dispatch_downloads_clear()
          show_toast("Cleared downloads list", "clear")
        },
        on_close: fn() -> Unit { close_downloads() },
      },
    },
  )

  // 8. Shortcuts Modal (`shortcuts`, modal `headless::dialog`)
  shell_ui::build_shortcuts_modal(
    root,
    shell_ui::ShortcutsModalProps::{
      open: fn() -> Bool { exact_tag_open(shortcuts_open, "shortcuts") },
      groups: shell_ui::default_macos_shortcut_groups,
      on_close: fn() -> Unit { close_shortcuts() },
    },
  )

  // 9. Webpage Context Menu (`page_ctx`)
  shell_ui::build_page_context_menu(
    root,
    shell_ui::PageContextMenuProps::{
      open: fn() -> Bool { exact_tag_open(page_ctx_open, "page_ctx") },
      target: fn() -> shell_ui::PageContextTarget {
        shell_ui::PageContextTarget::{
          link_url: page_ctx_link.get(),
          image_url: page_ctx_image.get(),
          selection_text: page_ctx_selection.get(),
          can_back: page_ctx_can_back.get(),
          can_forward: page_ctx_can_forward.get(),
        }
      },
      anchor_x: fn() -> Double { page_ctx_x.get() },
      anchor_y: fn() -> Double { page_ctx_y.get() },
      callbacks: shell_ui::PageContextCallbacks::{
        on_open_peek: fn(u : String) -> Unit {
          close_page_ctx()
          if u != "" { open_peek_preview(u, "") }
        },
        on_open_split: fn(u : String) -> Unit {
          close_page_ctx()
          if u != "" { open_split_view(u, "", focus_pane=1) }
        },
        on_open_new_tab: fn(u : String) -> Unit {
          close_page_ctx()
          if u != "" { dispatch_tab_new(u, "") }
        },
        on_copy_link: fn(u : String) -> Unit {
          close_page_ctx()
          if u != "" { copy_url_with_toast(u) }
        },
        on_open_image: fn(u : String) -> Unit {
          close_page_ctx()
          if u != "" { dispatch_tab_new(u, "") }
        },
        on_copy_image_url: fn(u : String) -> Unit {
          close_page_ctx()
          if u != "" { copy_url_with_toast(u) }
        },
        on_copy_selection: fn(s : String) -> Unit {
          close_page_ctx()
          if s != "" { write_os_clipboard(s) }
        },
        on_search_selection: fn(s : String) -> Unit {
          close_page_ctx()
          if s != "" { active_stage().go(proto::omnibox_resolve_submit(s, [], -1)) }
        },
        on_back: fn() -> Unit {
          close_page_ctx()
          match app_state.page_ctx_stage {
            Some(ts) => ts.back()
            None => active_stage().back()
          }
        },
        on_forward: fn() -> Unit {
          close_page_ctx()
          match app_state.page_ctx_stage {
            Some(ts) => ts.forward()
            None => active_stage().forward()
          }
        },
        on_reload: fn() -> Unit {
          close_page_ctx()
          match app_state.page_ctx_stage {
            Some(ts) => ts.reload()
            None => active_stage().reload()
          }
        },
        on_copy_page_url: fn() -> Unit {
          close_page_ctx()
          let u = match app_state.page_ctx_stage {
            Some(ts) => ts.url()
            None => active_stage().url()
          }
          copy_url_with_toast(u)
        },
        on_close: fn() -> Unit { close_page_ctx() },
      },
    },
  )

  // 10. Navigation History Popover (`nav_hist`, preserves `owner_pane`)
  shell_ui::build_nav_history_popover(
    root,
    shell_ui::NavHistoryPopoverProps::{
      open: fn() -> Bool { exact_tag_open(nav_hist_open, "nav_hist") },
      owner_pane: fn() -> Int { app_state.nav_hist_owner_pane },
      is_forward: fn() -> Bool { nav_hist_dir.get() != 0 },
      entries: fn() -> Array[shell_ui::NavHistoryItem] {
        let _ = workspace_rev.get()
        let raw = nav_hist_entries_for(app_state.nav_hist_owner_pane, nav_hist_dir.get())
        let out : Array[shell_ui::NavHistoryItem] = []
        let mut i = 0
        while i < raw.length() && i < 10 {
          let e = raw[i]
          out.push(shell_ui::NavHistoryItem::{
            index: e.index,
            title: proto::nav_entry_display_title(e),
            url: e.url,
          })
          i += 1
        }
        out
      },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        Some(shell_ui::AnchorRect::{ x: nav_hist_x.get(), y: 4.0, w: 32.0, h: 36.0 })
      },
      fallback_capsule,
      on_jump: fn(_owner : Int, idx : Int) -> Unit { dispatch_nav_jump(idx) },
      on_close: fn() -> Unit { close_nav_hist() },
    },
  )

  // 11. Tab Context Menu (`tab_ctx`, stable `tab_id`, full 9 daily-driver actions)
  shell_ui::build_tab_context_menu(
    root,
    shell_ui::TabContextMenuProps::{
      open: fn() -> Bool { exact_tag_open(tab_ctx_open, "tab_ctx") },
      target: fn() -> shell_ui::TabContextTarget {
        let _ = workspace_rev.get()
        let tid = tab_ctx_tab_id.get()
        let (is_active, pinned, favorite, muted, folder_id) = match find_tab_summary(tid) {
          Some(tb) => (tb.active || tb.id == app_state.workspace.active_tab_id, tb.pinned, tb.favorite, tab_preview_media_state(tb).1, tb.folder_id)
          None => (false, false, false, false, "")
        }
        let folders : Array[(String, String)] = []
        let mut fi = 0
        while fi < app_state.workspace.folders.length() {
          let fl = app_state.workspace.folders[fi]
          if fl.space_id == app_state.workspace.active_space_id {
            folders.push((fl.id, fl.name))
          }
          fi += 1
        }
        let spaces : Array[(String, String)] = []
        let mut i = 0
        while i < app_state.workspace.spaces.length() {
          let sp = app_state.workspace.spaces[i]
          if sp.id != app_state.workspace.active_space_id {
            spaces.push((sp.id, sp.name))
          }
          i += 1
        }
        let can_close_others = app_state.workspace.tabs.length() > 1
        shell_ui::TabContextTarget::{
          tab_id: tid,
          is_active,
          pinned,
          favorite,
          muted,
          folder_id,
          can_close_others,
          folders,
          spaces,
        }
      },
      anchor_x: fn() -> Double { shell_live_sidebar_anchor_x(root) },
      anchor_y: fn() -> Double { tab_ctx_y.get() },
      callbacks: shell_ui::TabContextCallbacks::{
        on_open_split: fn(tid : String) -> Unit {
          let u = match find_tab_summary(tid) {
            Some(tb) => tb.url
            None => st.url()
          }
          close_tab_ctx()
          open_split_view(u, tid, focus_pane=1)
        },
        on_open_peek: fn(tid : String) -> Unit {
          let u = match find_tab_summary(tid) {
            Some(tb) => tb.url
            None => st.url()
          }
          close_tab_ctx()
          open_peek_preview(u, tid)
        },
        on_duplicate: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_tab_duplicate(tid)
        },
        on_copy_clean_url: fn(tid : String) -> Unit {
          let u = match find_tab_summary(tid) {
            Some(tb) => tb.url
            None => st.url()
          }
          close_tab_ctx()
          copy_url_with_toast(u)
        },
        on_toggle_pin: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_tab_pin(tid)
        },
        on_toggle_favorite: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_tab_favorite(tid)
        },
        on_toggle_mute: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_media_toggle_mute(tid)
        },
        on_move_to_folder: fn(tid : String, fid : String) -> Unit {
          close_tab_ctx()
          dispatch_tab_move_folder(tid, fid)
        },
        on_new_folder_with_tab: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_folder_create_with_tab(tid)
        },
        on_move_to_space: fn(tid : String, sid : String) -> Unit {
          let mut sname = sid
          let mut si = 0
          while si < app_state.workspace.spaces.length() {
            if app_state.workspace.spaces[si].id == sid {
              sname = app_state.workspace.spaces[si].name
              break
            }
            si += 1
          }
          close_tab_ctx()
          dispatch_tab_move_space(tid, sid, sname)
        },
        on_close_others: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_tab_close_others(tid)
        },
        on_close_tab: fn(tid : String) -> Unit {
          close_tab_ctx()
          dispatch_tab_close(tid)
        },
        on_close: fn() -> Unit { close_tab_ctx() },
      },
    },
  )

  // 12. Folder Context Menu (`folder_ctx`, stable `folder_id`)
  shell_ui::build_folder_context_menu(
    root,
    shell_ui::FolderContextMenuProps::{
      open: fn() -> Bool { exact_tag_open(folder_ctx_open, "folder_ctx") },
      target: fn() -> shell_ui::FolderContextTarget {
        let _ = workspace_rev.get()
        let fid = folder_ctx_id.get()
        let mut fname = ""
        let mut fcolor = "#2563EB"
        let mut fcoll = false
        let mut i = 0
        while i < app_state.workspace.folders.length() {
          let fl = app_state.workspace.folders[i]
          if fl.id == fid {
            fname = fl.name
            fcolor = proto::normalize_space_accent(fl.color)
            fcoll = fl.collapsed
            break
          }
          i += 1
        }
        shell_ui::FolderContextTarget::{ folder_id: fid, name: fname, color: fcolor, collapsed: fcoll }
      },
      palette: proto::workspace_space_palette(),
      rename_field: folder_name_field,
      anchor_x: fn() -> Double { shell_live_sidebar_anchor_x(root) },
      anchor_y: fn() -> Double { folder_ctx_y.get() },
      callbacks: shell_ui::FolderContextCallbacks::{
        on_rename: fn(fid : String, name : String) -> Unit {
          close_folder_ctx()
          dispatch_folder_rename(fid, name)
        },
        on_pick_color: fn(fid : String, hex : String) -> Unit {
          dispatch_folder_color(fid, hex)
        },
        on_toggle_collapse: fn(fid : String) -> Unit {
          close_folder_ctx()
          dispatch_folder_toggle(fid)
        },
        on_delete: fn(fid : String) -> Unit {
          close_folder_ctx()
          dispatch_folder_delete(fid)
        },
        on_close: fn() -> Unit { close_folder_ctx() },
      },
    },
  )

  // 13. Bookmarks Bar Context Menu (`bm_bar_ctx`)
  shell_ui::build_bookmarks_bar_context_menu(
    root,
    shell_ui::BookmarksBarContextProps::{
      open: fn() -> Bool { exact_tag_open(bm_bar_ctx_open, "bm_bar_ctx") },
      bookmark_id: fn() -> String { bm_bar_ctx_id.get() },
      bookmark_url: fn() -> String { bm_bar_ctx_url.get() },
      anchor_x: fn() -> Double { bm_bar_ctx_x.get() },
      anchor_y: fn() -> Double { 76.0 },
      on_open_split: fn(u : String) -> Unit {
        close_bm_bar_ctx()
        if u != "" { open_split_view(u, app_state.workspace.active_tab_id, focus_pane=1) }
      },
      on_open_peek: fn(u : String) -> Unit {
        close_bm_bar_ctx()
        if u != "" { open_peek_preview(u, app_state.workspace.active_tab_id) }
      },
      on_remove: fn(bid : String) -> Unit {
        let u = bm_bar_ctx_url.untracked()
        close_bm_bar_ctx()
        dispatch_bookmark_delete(if bid != "" { bid } else { u })
      },
      on_close: fn() -> Unit { close_bm_bar_ctx() },
    },
  )

  // 14. Space Theme editor (`space_theme`): opened from the sidebar's Space name, the Spaces manager and the
  // command bar. From the sidebar's Space name it grows from that name; otherwise (or with no sidebar) it sits in the
  // middle of the window.
  shell_ui::build_space_theme_editor(
    root,
    shell_ui::SpaceThemeEditorProps::{
      open: fn() -> Bool { exact_tag_open(space_theme_open, "space_theme") },
      space_id: fn() -> String {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => sp.id
          None => app_state.workspace.active_space_id
        }
      },
      theme: fn() -> proto::SpaceTheme {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => proto::space_theme_effective(sp.theme, sp.accent)
          None => proto::space_theme_from_accent("#2563EB")
        }
      },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        let _ = root.laid_size_told()
        let ww = root.window_w()
        let wh = root.window_h()
        let vw = if ww > 100.0 { ww } else { 1280.0 }
        let h = if wh > 100.0 { wh } else { 800.0 }
        let sw = shell_ui::shell_sidebar_width(vw, is_sidebar_open_live(), custom_w=shell_adapter.dock.get().sidebar_width)
        if space_theme_from_sidebar.v && sw > 0.0 {
          // The Space name button at the foot of the sidebar (shell_frame's Space bar: 32pt tall, 8pt above the foot).
          let w = if sw - 16.0 < 160.0 { sw - 16.0 } else { 160.0 }
          Some(shell_ui::AnchorRect::{ x: 8.0, y: h - 44.0, w, h: 32.0 })
        } else {
          None
        }
      },
      name_field: Some(space_name_field),
      on_rename: fn(sid : String, name : String) -> Unit { dispatch_space_rename(sid, name) },
      on_change: fn(sid : String, theme : proto::SpaceTheme) -> Unit { dispatch_space_theme(sid, theme) },
      on_close: fn() -> Unit { close_space_theme() },
    },
  )

  // 15. MRU Switcher Modal (`mru`, modal `headless::dialog`): one strip that pages to keep the selection in view.
  shell_ui::build_mru_switcher_modal(
    root,
    shell_ui::MruSwitcherModalProps::{
      open: fn() -> Bool { exact_tag_open(mru_open, "mru") && mru_strip_shown() },
      space_name: fn() -> String {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) if sp.name != "" => sp.name
          _ => app_state.space_name
        }
      },
      items: fn() -> Array[shell_ui::MruTabEntry] {
        let _ = mru_rev.get()
        let _ = workspace_rev.get()
        let out : Array[shell_ui::MruTabEntry] = []
        let mut i = 0
        while i < app_state.mru_items.length() {
          let tb = app_state.mru_items[i]
          let playing = match app_state.workspace.media {
            Some(md) => md.tab_id == tb.id && md.playing
            None => false
          }
          out.push(shell_ui::MruTabEntry::{
            tab_id: tb.id,
            title: proto::workspace_tab_display_title(tb),
            host: proto::omnibox_display_host(tb.url),
            playing,
            active: tb.active,
          })
          i += 1
        }
        out
      },
      selected_index: fn() -> Int { mru_selected.get() },
      on_select_tab: fn(tid : String) -> Unit {
        close_mru_switcher()
        if tid != "" {
          dispatch_tab_switch(tid)
        }
      },
      on_hover_index: fn(i : Int) -> Unit { mru_selected.set(i) },
      on_close: fn() -> Unit { close_mru_switcher() },
      content_left: fn(vw : Double) -> Double {
        if is_sidebar_open_live() {
          shell_ui::shell_sidebar_width(vw, true, custom_w=shell_adapter.dock.get().sidebar_width)
        } else {
          0.0
        }
      },
    },
  )
}

fn shell_build_devtools_props(
  devtools_open : signals::Signal[Bool],
  devtools_rev : signals::Signal[Int],
  dt_state : shell_ui::DevToolsPanelState,
) -> shell_ui::DevToolsPanelProps {
  shell_ui::DevToolsPanelProps::{
    open: fn() -> Bool { devtools_open.get() },
    dark: fn() -> Bool { is_dark_chrome() },
    owner_pane: fn() -> shell_ui::PaneId {
      if shell_adapter.devtools_owner_pane_sig.get() == 1 {
        shell_ui::PaneId::Secondary
      } else {
        shell_ui::PaneId::Primary
      }
    },
    snapshot: fn() -> proto::DevToolsSnapshot {
      let _ = devtools_rev.get()
      let _ = shell_adapter.devtools_owner_pane_sig.get()
      active_devtools_snap()
    },
    rev: fn() -> Int { devtools_rev.get() },
    state: dt_state,
    on_inspect: fn(path : String) -> Unit { dispatch_devtools_inspect(path) },
    on_eval: fn(expr : String) -> Unit { dispatch_devtools_eval(expr) },
    on_clear_console: fn() -> Unit { dispatch_devtools_clear() },
    on_copy_curl: fn(curl_cmd : String) -> Unit {
      write_os_clipboard(curl_cmd)
      show_toast("Copied cURL command", "info")
    },
    on_refresh: fn() -> Unit {
      dispatch_devtools_inspect(dt_state.selected_path.untracked())
    },
    on_close: fn() -> Unit { close_devtools() },
    on_presentation_change: None,
    anchor_top: fn() -> Double {
      let bm_h = match app_state.bookmarks_bar_open {
        Some(sig) if sig.get() => 33.0
        _ => 0.0
      }
      shell_live_content_top() + bm_h
    },
  }
}

///| Phase 3A Liquid Glass deep panels mounted at root:
///| - Floating DevTools (shares the exact same `DevToolsPanelState` as `bottom_dock` Docked mode)
///| - Site Boosts overlay (bound to `(boosts_owner_pane, boosts_committed_host)`, auto-closed on origin change/disconnect)
///| - Settings modal (`modal=true`, 3 tabs, per-category Clear Browsing Data, IME double-Esc)
///| Plus origin-change auto-close observers for Reader Mode and Site Boosts.
fn build_phase3a_overlays(
  root : view::View,
  reader_open : signals::Signal[Bool],
  boosts_open : signals::Signal[Bool],
  boosts_rev : signals::Signal[Int],
  boosts_css_field : ui::Field,
  settings_open : signals::Signal[Bool],
  settings_tab : signals::Signal[Int],
  settings_rev : signals::Signal[Int],
  clear_hist : signals::Signal[Bool],
  clear_dl : signals::Signal[Bool],
  clear_boosts : signals::Signal[Bool],
  devtools_open : signals::Signal[Bool],
  devtools_rev : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let exact_tag_open = fn(sig : signals::Signal[Bool], tag : String) -> Bool {
    sig.get() && shell_adapter.exclusive.get().tag == tag
  }

  // Auto-close Reader Mode when its bound pane navigates to a different origin (including HTTPS <-> file://)
  root.reacts(
    at_start=false,
    fn() -> String {
      if !reader_open.get() {
        return ""
      }
      let owner = shell_adapter.reader_owner_pane
      if owner < 0 {
        return ""
      }
      boosts_canonical_origin(shell_pane_raw_url_live(owner))
    },
    fn(cur_origin : String) -> Unit {
      if reader_open.untracked() &&
      shell_adapter.reader_committed_origin != "" &&
      cur_origin != "" &&
      cur_origin != shell_adapter.reader_committed_origin {
        close_reader_mode()
      }
    },
  )

  // Auto-close Site Boosts when its bound pane navigates to a different origin (including HTTPS <-> file://)
  root.reacts(
    at_start=false,
    fn() -> String {
      if !boosts_open.get() {
        return ""
      }
      let owner = shell_adapter.boosts_owner_pane
      boosts_canonical_origin(shell_pane_raw_url_live(owner))
    },
    fn(cur_origin : String) -> Unit {
      if boosts_open.untracked() &&
      shell_adapter.boosts_committed_origin != "" &&
      cur_origin != "" &&
      cur_origin != shell_adapter.boosts_committed_origin {
        close_boosts()
      }
    },
  )

  // 1. Floating DevTools (shares exact `DevToolsPanelState` with Docked bottom_dock)
  let dt_state = match shell_adapter.devtools_panel_state {
    Some(s) => s
    None => {
      let fresh = shell_ui::DevToolsPanelState::new()
      shell_adapter.devtools_panel_state = Some(fresh)
      fresh
    }
  }
  shell_ui::build_devtools_panel(
    root,
    shell_build_devtools_props(devtools_open, devtools_rev, dt_state),
    floating_only=true,
  )

  // 2. Site Boosts Overlay (`boosts`)
  shell_ui::build_site_boosts_panel(
    root,
    shell_ui::SiteBoostsProps::{
      open: fn() -> Bool { exact_tag_open(boosts_open, "boosts") },
      dark: fn() -> Bool { is_dark_chrome() },
      target_origin: fn() -> String {
        let _ = boosts_rev.get()
        shell_adapter.boosts_committed_host
      },
      owner_pane: fn() -> shell_ui::PaneId {
        if shell_adapter.boosts_owner_pane == 1 {
          shell_ui::PaneId::Secondary
        } else {
          shell_ui::PaneId::Primary
        }
      },
      boost: fn() -> proto::SiteBoost {
        let _ = boosts_rev.get()
        current_site_boost()
      },
      css_field: boosts_css_field,
      anchor_top: fn() -> Double {
        let bm_h = match app_state.bookmarks_bar_open {
          Some(sig) if sig.get() => 33.0
          _ => 0.0
        }
        shell_live_content_top() + bm_h + shell_ui::SP_8
      },
      accent_color: fn() -> Int64 {
        let _ = workspace_rev.get()
        match proto::workspace_active_space(app_state.workspace) {
          Some(sp) => proto::workspace_accent_color(sp.accent)
          None => 0x8B5CF6FFL
        }
      },
      on_save: fn(orig : String, b : proto::SiteBoost) -> Unit {
        if orig == "" {
          return
        }
        let target = proto::SiteBoost::{ ..b, host: orig }
        // (the panel shows each change as it is made: no toast per toggle or slider)
        dispatch_boost_save(target, clear_css_dirty=false)
      },
      on_reset: fn(orig : String) -> Unit {
        if orig == "" {
          return
        }
        dispatch_boost_reset(orig)
      },
      on_close: fn() -> Unit { close_boosts() },
      on_css_edited: Some(fn(_raw : String) -> Unit { mark_boosts_css_draft_dirty() }),
      on_apply_css: Some(fn(orig : String, b : proto::SiteBoost) -> Unit {
        if orig == "" {
          return
        }
        let target = proto::SiteBoost::{ ..b, host: orig }
        boost_js_synced[0] = proto::sanitize_boost_custom_js(target.custom_js)
        boost_js_synced[1] = current_boost_draft_key()
        dispatch_boost_save(target, toast_msg="Updated Boost for " + orig, clear_css_dirty=true)
      }),
      js_field: boosts_js_field(),
      zap_active: fn() -> Bool {
        let _ = boosts_rev.get()
        boost_zap_active()
      },
      on_zap: fn(on : Bool) -> Unit { dispatch_boost_zap(on) },
      all_boosts: fn() -> Array[proto::SiteBoost] {
        let _ = boosts_rev.get()
        active_boosts_snap().items
      },
      on_site_save: fn(b : proto::SiteBoost) -> Unit { dispatch_boost_save_site(b) },
      on_site_open: fn(h : String) -> Unit { dispatch_boost_open_site(h) },
      on_site_delete: fn(h : String) -> Unit { dispatch_boost_delete_site(h) },
    },
  )

  // 3. Settings Modal (`settings`, `modal=true`)
  let clear_bookmarks = signals::signal(false)
  let settings_filter_field = ui::Field::new()
  shell_adapter.settings_filter_field = Some(settings_filter_field)
  shell_ui::build_settings_panel(
    root,
    shell_ui::SettingsPanelProps::{
      open: fn() -> Bool { exact_tag_open(settings_open, "settings") },
      dark: fn() -> Bool { is_dark_chrome() },
      active_tab: settings_tab,
      settings: fn() -> proto::BrowserSettings {
        let _ = settings_rev.get()
        app_state.settings
      },
      clear_bookmarks,
      clear_history: clear_hist,
      clear_downloads: clear_dl,
      clear_boosts,
      filter_field: Some(settings_filter_field),
      on_save_settings: fn(next_s : proto::BrowserSettings, msg : String) -> Unit {
        app_state.initial_chrome_theme = ""
        dispatch_settings_save(next_s, toast_msg=msg)
      },
      on_step_zoom: fn(delta : Int) -> Unit { settings_step_default_zoom(delta) },
      on_clear_browsing_data: fn(sel : shell_ui::ClearBrowsingDataSelection) -> Unit {
        dispatch_clear_browsing_data_selection(sel)
      },
      on_close: fn() -> Unit { close_settings() },
    },
  )
}

///| Phase 3B Liquid Glass deep drawers & modals mounted at root (`shell_ui`):
///| 1. Site Cookies & Data Inspector Modal (`cookies`, supports nested SiteInfo + IDN display host)
///| 2. History Drawer (`history`, `Today`/`Yesterday`/`Earlier`, zero empty groups)
///| 3. Bookmarks Drawer (`bookmarks`, live search, toggle current, open/delete)
///| 4. Named Workspace Sessions Manager Modal (`sessions`, exact `session_id` restore/delete)
///| 5. Arc Spaces Manager Modal (`spaces_manager`, create/switch/rename/recolor/delete)
///| 6. Recently Closed Tabs Drawer (`closed_tabs`, original `it.index` after filtering)
///| 7. Print / Export PDF Settings Modal (`print_pdf`, locked `print_owner_pane`, FIFO `reqId`)
fn build_phase3b_overlays(
  root : view::View,
  cookies_open : signals::Signal[Bool],
  cookies_rev : signals::Signal[Int],
  cookies_field : ui::Field,
  history_open : signals::Signal[Bool],
  history_rev : signals::Signal[Int],
  history_field : ui::Field,
  bookmarks_open : signals::Signal[Bool],
  bookmarks_rev : signals::Signal[Int],
  bookmarks_field : ui::Field,
  bookmarks_query : signals::Signal[String],
  sessions_open : signals::Signal[Bool],
  sessions_rev : signals::Signal[Int],
  sessions_name_field : ui::Field,
  sessions_filter_field : ui::Field,
  spaces_manager_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  spaces_new_field : ui::Field,
  spaces_new_accent : signals::Signal[String],
  spaces_edit_id : signals::Signal[String],
  spaces_rename_field : ui::Field,
  spaces_color_edit_id : signals::Signal[String],
  closed_tabs_open : signals::Signal[Bool],
  closed_tabs_rev : signals::Signal[Int],
  closed_tabs_field : ui::Field,
  print_pdf_open : signals::Signal[Bool],
  print_paper : signals::Signal[String],
  print_orientation : signals::Signal[String],
  print_margins : signals::Signal[String],
  print_bg_graphics : signals::Signal[Bool],
) -> Unit {
  let exact_tag_open = fn(sig : signals::Signal[Bool], tag : String) -> Bool {
    sig.get() && shell_adapter.exclusive.get().tag == tag
  }
  // "Customize" on another Space in the Spaces manager: the theme editor opens once that Space is active.
  root.reacts(fn() {
    let _ = workspace_rev.get()
    app_state.workspace.active_space_id
  }, fn(active : String) -> Unit {
    let want = space_theme_pending_id.v
    if want != "" {
      if active == want {
        space_theme_pending_id.v = ""
        open_space_theme()
      } else {
        let mut still = false
        for sp in app_state.workspace.spaces {
          if sp.id == want {
            still = true
          }
        }
        if !still {
          space_theme_pending_id.v = ""
        }
      }
    }
  }, at_start=false)
  let drawer_host = match shell_adapter.body_overlays_host {
    Some(bh) => bh
    None => root
  }

  // 1. Site Cookies & Data Inspector Modal (`cookies` or nested under `site_info`)
  shell_ui::build_cookies_inspector_modal(
    root,
    shell_ui::CookiesInspectorProps::{
      open: fn() -> Bool {
        cookies_open.get() &&
        (shell_adapter.exclusive.get().tag == "cookies" || shell_adapter.nested_overlay_tag == "cookies")
      },
      owner_pane: fn() -> Int {
        let _ = cookies_rev.get()
        shell_adapter.cookies_owner_pane
      },
      site_host: fn() -> String {
        let _ = cookies_rev.get()
        let snap = active_cookies_snap()
        if snap.host != "" {
          snap.host
        } else {
          shell_adapter.cookies_committed_host
        }
      },
      space_id: fn() -> String {
        let _ = cookies_rev.get()
        let snap = active_cookies_snap()
        if snap.space_id != "" {
          format_space_label(snap.space_id)
        } else {
          app_state.space_name
        }
      },
      cookies: fn() -> Array[proto::SiteCookieRow] {
        let _ = cookies_rev.get()
        active_cookies_snap().cookies
      },
      filter_field: cookies_field,
      show_back_to_site_info: fn() -> Bool { shell_sig_is_true(app_state.site_info_open) },
      on_back_to_site_info: fn() -> Unit { close_cookies_modal() },
      on_delete_cookie: fn(_pane : Int, host : String, name : String, domain : String, path : String) -> Unit {
        dispatch_cookie_delete(domain, path, name, host)
      },
      on_clear_site: fn(_pane : Int, host : String) -> Unit {
        dispatch_cookies_clear_site(host)
      },
      on_close: fn() -> Unit { close_cookies_modal() },
      return_focus: None,
    },
  )

  // 2. History Drawer (`history`, mounted inside `body_content` below Titleband & Top Strip)
  shell_ui::build_history_drawer_panel(
    drawer_host,
    shell_ui::HistoryDrawerProps::{
      open: fn() -> Bool { exact_tag_open(history_open, "history") },
      items: fn() -> Array[proto::HistoryItemSummary] {
        let _ = history_rev.get()
        app_state.history_snap.items
      },
      total_count: fn() -> Int {
        let _ = history_rev.get()
        app_state.history_snap.total_count
      },
      now_secs: fn() -> Int64 { app_now_secs() },
      search_field: history_field,
      on_query_change: fn(q : String) -> Unit {
        if history_open.untracked() {
          dispatch_history_query(q)
        }
      },
      on_open_url: fn(u : String) -> Unit {
        if u != "" {
          active_stage().go(u)
        }
      },
      on_delete_url: fn(u : String) -> Unit {
        dispatch_history_delete(u)
        show_toast("Removed from history", "clear")
      },
      on_clear_range: fn(range_key : String) -> Unit {
        dispatch_history_clear_range(range_key)
      },
      on_close: fn() -> Unit { close_history() },
    },
  )

  // 3. Bookmarks Drawer (`bookmarks`)
  root.reacts(at_start=false, fn() -> String { bookmarks_field.text() }, fn(q : String) -> Unit {
    if bookmarks_open.untracked() {
      bookmarks_query.set(q)
    }
  })
  shell_ui::build_bookmarks_drawer_panel(
    drawer_host,
    shell_ui::BookmarksDrawerProps::{
      open: fn() -> Bool { exact_tag_open(bookmarks_open, "bookmarks") },
      snapshot: fn() -> proto::BookmarksSnapshot {
        let _ = bookmarks_rev.get()
        let _ = bookmarks_query.get()
        app_state.bookmarks_snap
      },
      current_url: fn() -> String { active_stage_live().url() },
      search_field: bookmarks_field,
      on_toggle_current: fn() -> Unit { dispatch_bookmark_toggle() },
      on_open_url: fn(u : String) -> Unit {
        if u != "" {
          active_stage().go(u)
        }
      },
      on_delete_bookmark: fn(id_or_url : String) -> Unit {
        dispatch_bookmark_delete(id_or_url)
      },
      on_close: fn() -> Unit { close_bookmarks() },
    },
  )

  // 4. Named Workspace Sessions Manager Modal (`sessions`)
  shell_ui::build_sessions_modal_panel(
    root,
    shell_ui::SessionsModalProps::{
      open: fn() -> Bool { exact_tag_open(sessions_open, "sessions") },
      sessions: fn() -> Array[proto::NamedSessionSnapshot] {
        let _ = sessions_rev.get()
        app_state.sessions_state.items
      },
      current_space_count: fn() -> Int {
        let _ = workspace_rev.get()
        app_state.workspace.spaces.length()
      },
      current_tab_count: fn() -> Int {
        let _ = workspace_rev.get()
        app_state.workspace.tabs.length()
      },
      now_secs: fn() -> Int64 { app_now_secs() },
      name_field: sessions_name_field,
      filter_field: sessions_filter_field,
      on_save_session: fn(raw_name : String) -> Unit { dispatch_session_save(raw_name) },
      on_restore_session: fn(session_id : String, name : String) -> Unit {
        dispatch_session_restore(session_id, name)
      },
      on_delete_session: fn(session_id : String, name : String) -> Unit {
        dispatch_session_delete(session_id, name)
      },
      on_close: fn() -> Unit { close_sessions_modal() },
      return_focus: None,
    },
  )

  // 5. Arc Spaces Manager Modal (`spaces_manager`)
  shell_ui::build_spaces_modal_panel(
    root,
    shell_ui::SpacesModalProps::{
      open: fn() -> Bool { exact_tag_open(spaces_manager_open, "spaces_manager") },
      spaces: fn() -> Array[proto::SpaceSummary] {
        let _ = workspace_rev.get()
        app_state.workspace.spaces
      },
      active_space_id: fn() -> String {
        let _ = workspace_rev.get()
        app_state.workspace.active_space_id
      },
      new_name_field: spaces_new_field,
      new_accent: spaces_new_accent,
      rename_space_id: spaces_edit_id,
      rename_field: spaces_rename_field,
      color_edit_space_id: spaces_color_edit_id,
      on_create_space: fn(name : String, accent_hex : String) -> Unit {
        dispatch_space_new_with_accent(name, accent_hex)
      },
      on_new_space: Some(fn() -> Unit { start_create_space() }),
      on_switch_space: fn(space_id : String) -> Unit {
        dispatch_space_switch(space_id)
        close_spaces_manager()
      },
      on_rename_space: fn(space_id : String, new_name : String) -> Unit {
        dispatch_space_rename(space_id, new_name)
      },
      on_recolor_space: fn(space_id : String, accent_hex : String) -> Unit {
        dispatch_space_accent(space_id, accent_hex)
      },
      on_customize_space: fn(space_id : String) -> Unit {
        close_spaces_manager()
        if space_id != app_state.workspace.active_space_id {
          // The editor themes the active Space (the frame previews it): open it once the host says the switch is
          // done, so no change lands on the Space being left.
          space_theme_pending_id.v = space_id
          dispatch_space_switch(space_id)
        } else {
          open_space_theme()
        }
      },
      on_delete_space: fn(space_id : String) -> Unit {
        if proto::space_can_delete(app_state.workspace, space_id) {
          dispatch_space_delete(space_id)
        }
      },
      on_close: fn() -> Unit { close_spaces_manager() },
      return_focus: None,
    },
  )

  // 6. Recently Closed Tabs Drawer (`closed_tabs`, mounted inside `body_content` below Titleband & Top Strip)
  shell_ui::build_closed_tabs_drawer_panel(
    drawer_host,
    shell_ui::ClosedTabsDrawerProps::{
      open: fn() -> Bool { exact_tag_open(closed_tabs_open, "closed_tabs") },
      items: fn() -> Array[proto::ClosedTabItem] {
        let _ = closed_tabs_rev.get()
        app_state.closed_tabs_snap.items
      },
      now_secs: fn() -> Int64 { app_now_secs() },
      search_field: closed_tabs_field,
      on_restore_tab: fn(orig_index : Int, title : String) -> Unit {
        dispatch_tab_reopen_at(orig_index, title)
      },
      on_clear_all: fn() -> Unit { dispatch_closed_tabs_clear() },
      on_close: fn() -> Unit { close_closed_tabs_modal() },
    },
  )

  // 7. Print / Export PDF Settings Modal (`print_pdf`, locked `print_owner_pane`)
  shell_ui::build_print_pdf_modal_panel(
    root,
    shell_ui::PrintPdfModalProps::{
      open: fn() -> Bool { exact_tag_open(print_pdf_open, "print_pdf") },
      owner_pane: fn() -> Int { app_state.print_owner_pane },
      page_title: fn() -> String { pane_stage(app_state.print_owner_pane).title() },
      page_url: fn() -> String { pane_stage(app_state.print_owner_pane).url() },
      paper: print_paper,
      orientation: print_orientation,
      margins: print_margins,
      background_graphics: print_bg_graphics,
      on_save_pdf: fn(owner : Int, cfg : proto::PrintPdfConfig) -> Unit {
        close_print_pdf_modal()
        let cfg_json = proto::encode_print_pdf_config(cfg)
        dispatch_export_pdf_for_pane(owner, cfg_json)
      },
      on_cancel: fn() -> Unit { close_print_pdf_modal() },
      return_focus: None,
    },
  )
}
