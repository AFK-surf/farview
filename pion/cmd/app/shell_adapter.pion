      proto::BookmarkEntry::{
        id: "bm-1",
        title: "GitHub Actions Workflow Syntax",
        url: "https://docs.github.com/en/actions",
        folder: "Engineering",
        created_ms: 1700000100L,
      },
      proto::BookmarkEntry::{
        id: "bm-2",
        title: "GitHub Metal Shaders Guide",
        url: "https://github.com/topics/metal-shaders",
        folder: "Graphics",
        created_ms: 1700000200L,
      },
    ],
  }
  app_state.history_snap = proto::HistorySnapshot::{
    items: [
      proto::HistoryItemSummary::{
        url: "https://github.com/trending/rust",
        title: "Trending Repositories on GitHub",
        host: "github.com",
        visit_count: 18,
        last_visit_secs: 1700000300L,
      },
      proto::HistoryItemSummary::{
        url: "https://github.com/AFK-surf/invar",
        title: "AFK-surf/invar — GPU UI Toolkit",
        host: "github.com",
        visit_count: 9,
        last_visit_secs: 1700000250L,
      },
    ],
  }
  match app_state.workspace_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.mini_player_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.address_field {
    Some(addr) => {
      app_state.syncing_address_url = true
      addr.set("github")
      app_state.syncing_address_url = false
    }
    None => ()
  }
  refresh_omnibox_suggestions("github")
  match app_state.omnibox_open {
    Some(s) => s.set(true)
    None => ()
  }
  match app_state.omnibox_selected {
    Some(s) => s.set(0)
    None => ()
  }
}

fn ensure_demo_shell_dock_dark_seeded() -> Unit {
  app_state.mini_player_dismissed_tab = ""
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp-work",
    active_tab_id: "tab-primary",
    spaces: [
      proto::SpaceSummary::{ id: "sp-work", name: "Work", accent: "#3B82F6", active: true, tab_count: 3 },
      proto::SpaceSummary::{ id: "sp-research", name: "Research", accent: "#10B981", active: false, tab_count: 2 },
      proto::SpaceSummary::{ id: "sp-media", name: "Media", accent: "#8B5CF6", active: false, tab_count: 1 },
    ],
    folders: [],
    tabs: [
      proto::TabSummary::{
        id: "tab-primary",
        space_id: "sp-work",
        title: "GitHub — AFK-surf/farview",
