///| Farview Desktop Shell 2.0 Phase 1a State & Routing Adapter (`pion/cmd/app/shell_adapter.pion`).
///|
///| Bridges `pion/cmd/app` legacy `app_state` signals with the authoritative `shell_ui`
///| four-layer state machine (`Dock`, orthogonal `PageLayout x PaneSurface`, `Exclusive`
///| with optional 1-level `nested`, and independent `Passive`), request-attributed
///| `shell_ui::OmniboxRequestGate`, `lg::set_dark` chrome theme synchronization,
///| positive input/IME ownership, and deterministic `dismiss_topmost_layer()` routing.

struct ShellAdapter {
  dock : signals::Signal[shell_ui::DockState]
  page : signals::Signal[shell_ui::PageLayoutState]
  exclusive : signals::Signal[shell_ui::ExclusiveState]
  passive : signals::Signal[shell_ui::PassiveState]
  mut omnibox_gate : shell_ui::OmniboxRequestGate
  mut omnibox_conn_epoch : Int
  mut omnibox_req_seq : Int
  mut omnibox_in_flight_req_id : String
  mut omnibox_in_flight_started_ms : Double
  mut omnibox_in_flight_is_empty : Bool
  mut omnibox_legacy_array_seen : Bool
  mut omnibox_saw_envelope : Bool
  mut omnibox_pending_query : Option[String]
  mut active_overlay_tag : String
  mut nested_overlay_tag : String
  mut leaving_overlay_tag : String
  mut reader_pane_id : shell_ui::PaneId
  mut reader_owner_pane : Int
  mut reader_expected_url : String
  mut reader_committed_origin : String
  mut reader_req_seq : Int
  mut reader_expected_req_id : String
  mut reader_status : Int
  mut boosts_owner_pane : Int
  mut boosts_committed_host : String
  mut boosts_committed_origin : String
  mut boosts_css_dirty : Bool
  mut boosts_css_draft_key : String
  mut boosts_legacy_bare : Array[String]
  mut split_boosts_snap : proto::BoostsSnapshot
  mut split_boosts_legacy_bare : Array[String]
  mut devtools_owner_pane : Int
  devtools_owner_pane_sig : signals::Signal[Int]
  mut split_devtools_snap : proto::DevToolsSnapshot
  mut devtools_panel_state : Option[shell_ui::DevToolsPanelState]
  mut devtools_active_doc_key : String
  devtools_doc_net_sel : Map[String, Int]
  devtools_doc_dom_sel : Map[String, String]
  mut initial_devtools_floating : Bool
  mut settings_filter_field : Option[ui::Field]
  mut find_owner_pane : Int
  find_owner_pane_sig : signals::Signal[Int]
  mut ime_owner_pane : Int
  mut last_page_focus_pane : Int
  mut omnibox_panel_view : Option[view::View]
  mut site_info_owner_pane : Int
  mut site_info_committed_origin : String
  mut idn_popover_owner_pane : Int
  mut idn_popover_committed_origin : String
  mut split_site_perms_snap : proto::SitePermissionsSnapshot
  mut split_cookies_snap : proto::SiteCookiesSnapshot
  mut cookies_owner_pane : Int
  mut cookies_committed_host : String
  mut cookies_committed_origin : String
  mut download_row_keys : Array[String]
  mut body_overlays_host : Option[view::View]
}

fn ShellAdapter::new() -> ShellAdapter {
  ShellAdapter::{
    dock: signals::signal_ref(shell_ui::DockState::default()),
    page: signals::signal_ref(shell_ui::PageLayoutState::default()),
    exclusive: signals::signal_ref(shell_ui::ExclusiveState::empty()),
    passive: signals::signal_ref(shell_ui::PassiveState::empty()),
    omnibox_gate: shell_ui::OmniboxRequestGate::new(),
    omnibox_conn_epoch: 1,
    omnibox_req_seq: 0,
    omnibox_in_flight_req_id: "",
    omnibox_in_flight_started_ms: 0.0,
    omnibox_in_flight_is_empty: false,
    omnibox_legacy_array_seen: false,
    omnibox_saw_envelope: false,
    omnibox_pending_query: None,
    active_overlay_tag: "",
    nested_overlay_tag: "",
    leaving_overlay_tag: "",
    reader_pane_id: shell_ui::PaneId::Primary,
    reader_owner_pane: -1,
    reader_expected_url: "",
    reader_committed_origin: "",
    reader_req_seq: 0,
    reader_expected_req_id: "",
    reader_status: 0,
    boosts_owner_pane: 0,
    boosts_committed_host: "",
    boosts_committed_origin: "",
    boosts_css_dirty: false,
    boosts_css_draft_key: "",
    boosts_legacy_bare: [],
    split_boosts_snap: proto::BoostsSnapshot::empty(),
    split_boosts_legacy_bare: [],
    devtools_owner_pane: 0,
    devtools_owner_pane_sig: signals::signal(0),
    split_devtools_snap: proto::DevToolsSnapshot::empty(),
    devtools_panel_state: None,
    devtools_active_doc_key: "",
    devtools_doc_net_sel: Map::new(),
    devtools_doc_dom_sel: Map::new(),
    initial_devtools_floating: false,
    settings_filter_field: None,
    find_owner_pane: 0,
    find_owner_pane_sig: signals::signal(0),
    ime_owner_pane: -1,
    last_page_focus_pane: 0,
    omnibox_panel_view: None,
    site_info_owner_pane: 0,
    site_info_committed_origin: "",
    idn_popover_owner_pane: 0,
    idn_popover_committed_origin: "",
    split_site_perms_snap: proto::SitePermissionsSnapshot::empty(),
    split_cookies_snap: proto::SiteCookiesSnapshot::empty(),
    cookies_owner_pane: 0,
    cookies_committed_host: "",
    cookies_committed_origin: "",
    download_row_keys: [],
    body_overlays_host: None,
  }
}

let shell_adapter : ShellAdapter = ShellAdapter::new()

///| Resets the adapter to clean defaults (used by deterministic tests).
fn shell_adapter_reset() -> Unit {
  shell_adapter.dock.set(shell_ui::DockState::default())
  shell_adapter.page.set(shell_ui::PageLayoutState::default())
  shell_adapter.exclusive.set(shell_ui::ExclusiveState::empty())
  shell_adapter.passive.set(shell_ui::PassiveState::empty())
  shell_adapter.omnibox_gate = shell_ui::OmniboxRequestGate::new()
  shell_adapter.omnibox_conn_epoch = 1
  shell_adapter.omnibox_req_seq = 0
  shell_adapter.omnibox_in_flight_req_id = ""
  shell_adapter.omnibox_in_flight_started_ms = 0.0
  shell_adapter.omnibox_in_flight_is_empty = false
  shell_adapter.omnibox_legacy_array_seen = false
  shell_adapter.omnibox_saw_envelope = false
  shell_adapter.omnibox_pending_query = None
  shell_adapter.active_overlay_tag = ""
  shell_adapter.nested_overlay_tag = ""
  shell_adapter.leaving_overlay_tag = ""
  shell_adapter.reader_pane_id = shell_ui::PaneId::Primary
  shell_adapter.reader_owner_pane = -1
  shell_adapter.reader_expected_url = ""
  shell_adapter.reader_committed_origin = ""
  shell_adapter.reader_req_seq = 0
  shell_adapter.reader_expected_req_id = ""
  shell_adapter.reader_status = 0
  shell_adapter.boosts_owner_pane = 0
  shell_adapter.boosts_committed_host = ""
  shell_adapter.boosts_committed_origin = ""
  shell_adapter.boosts_css_dirty = false
  shell_adapter.boosts_css_draft_key = ""
  shell_adapter.boosts_legacy_bare = []
  shell_adapter.split_boosts_snap = proto::BoostsSnapshot::empty()
  shell_adapter.split_boosts_legacy_bare = []
  shell_adapter.devtools_owner_pane = 0
  shell_adapter.devtools_owner_pane_sig.set(0)
  shell_adapter.split_devtools_snap = proto::DevToolsSnapshot::empty()
  shell_adapter.devtools_panel_state = None
  shell_adapter.devtools_active_doc_key = ""
  shell_adapter.devtools_doc_net_sel.clear()
  shell_adapter.devtools_doc_dom_sel.clear()
  shell_adapter.initial_devtools_floating = false
  shell_adapter.settings_filter_field = None
  shell_adapter.find_owner_pane = 0
  shell_adapter.find_owner_pane_sig.set(0)
  shell_adapter.ime_owner_pane = -1
  shell_adapter.last_page_focus_pane = 0
  shell_adapter.omnibox_panel_view = None
  shell_adapter.site_info_owner_pane = 0
  shell_adapter.site_info_committed_origin = ""
  shell_adapter.idn_popover_owner_pane = 0
  shell_adapter.idn_popover_committed_origin = ""
  shell_adapter.split_site_perms_snap = proto::SitePermissionsSnapshot::empty()
  shell_adapter.split_cookies_snap = proto::SiteCookiesSnapshot::empty()
  shell_adapter.cookies_owner_pane = 0
  shell_adapter.cookies_committed_host = ""
  shell_adapter.cookies_committed_origin = ""
  shell_adapter.download_row_keys = []
  shell_adapter.body_overlays_host = None
  reset_downloads_tracker()
}

fn shell_active_pane_index() -> Int {
  let p = shell_adapter.page.untracked()
  if (p.active_pane is shell_ui::PaneId::Secondary) && (is_split_open() || is_peek_open()) {
    1
  } else {
    0
  }
}

fn shell_pane_raw_url(pane : Int) -> String {
  if pane == 1 {
    match app_state.split_stage {
      Some(sp) => sp.url()
      None => if app_state.stage.is_some() { active_address_raw_url_untracked() } else { "" }
    }
  } else if app_state.demo_idn_url != "" {
    app_state.demo_idn_url
  } else {
    match app_state.stage {
      Some(st) => st.url()
      None => ""
    }
  }
}

fn shell_pane_raw_url_live(pane : Int) -> String {
  if pane == 1 {
    match app_state.split_stage {
      Some(sp) => sp.url()
      None => active_address_raw_url()
    }
  } else if app_state.demo_idn_url != "" {
    app_state.demo_idn_url
  } else {
    match app_state.stage {
      Some(st) => st.url()
      None => ""
    }
  }
}

fn shell_lock_site_info_target() -> Unit {
  let owner = shell_active_pane_index()
  let raw = shell_pane_raw_url(owner)
  let norm = proto::normalize_permission_origin(raw)
  let origin = if norm != "" { norm } else { proto::site_origin_from_url(raw) }
  shell_adapter.site_info_owner_pane = owner
  shell_adapter.site_info_committed_origin = origin
}

fn shell_lock_idn_popover_target() -> Unit {
  let owner = shell_active_pane_index()
  let raw = shell_pane_raw_url(owner)
  let norm = proto::normalize_permission_origin(raw)
  let origin = if norm != "" { norm } else { proto::site_origin_from_url(raw) }
  shell_adapter.idn_popover_owner_pane = owner
  shell_adapter.idn_popover_committed_origin = origin
}

fn shell_on_pane_disconnected(pane_id : Int) -> Unit {
  if shell_sig_is_true(app_state.site_info_open) && shell_adapter.site_info_owner_pane == pane_id {
    close_site_info()
  }
  if shell_sig_is_true(app_state.idn_popover_open) && shell_adapter.idn_popover_owner_pane == pane_id {
    close_idn_popover()
  }
  if shell_sig_is_true(app_state.cookies_open) && shell_adapter.cookies_owner_pane == pane_id {
    close_cookies_modal()
  }
  if shell_sig_is_true(app_state.reader_open) && shell_adapter.reader_owner_pane == pane_id {
    close_reader_mode()
  }
  if shell_sig_is_true(app_state.boosts_open) && shell_adapter.boosts_owner_pane == pane_id {
    close_boosts()
  }
  if shell_sig_is_true(app_state.devtools_open) && shell_adapter.devtools_owner_pane == pane_id {
    close_devtools()
  }
  if shell_sig_is_true(app_state.print_pdf_open) && app_state.print_owner_pane == pane_id {
    close_print_pdf_modal()
  }
}

fn shell_live_sidebar_anchor_x(root : view::View) -> Double {
  let _ = root.laid_size_told()
  let ww = root.window_w()
  let vw = if ww > 100.0 { ww } else { 1280.0 }
  if is_sidebar_open_live() {
    shell_ui::shell_sidebar_width(vw, true, custom_w=shell_adapter.dock.get().sidebar_width) + 6.0
  } else {
    14.0
  }
}

fn shell_live_window_w() -> Double {
  let ww = match app_state.root_view {
    Some(r) => {
      let _ = r.laid_size_told()
      r.window_w()
    }
    None => 0.0
  }
  if ww > 100.0 { ww } else { 1280.0 }
}

///| Window y where the page column starts in the live layout: `SHELL_CANVAS_GAP` with the sidebar docked (no
///| toolbar), `SHELL_TITLEBAND_H` when the toolbar row shows (narrow window or hidden sidebar).
fn shell_live_content_top() -> Double {
  shell_ui::shell_content_top_for(shell_adapter.dock.get(), shell_live_window_w())
}

fn set_find_owner_pane(pane_id : Int) -> Unit {
  let p = if pane_id == 1 { 1 } else { 0 }
  shell_adapter.find_owner_pane = p
  if shell_adapter.find_owner_pane_sig.untracked() != p {
    shell_adapter.find_owner_pane_sig.set(p)
  }
}

fn nav_hist_entries_for(pane_id : Int, dir : Int) -> Array[proto::NavHistoryEntry] {
  if pane_id == 1 {
    if dir == 0 { app_state.split_nav_back } else { app_state.split_nav_forward }
  } else {
    if dir == 0 { app_state.workspace.nav_back } else { app_state.workspace.nav_forward }
  }
}

fn cleanup_secondary_pane_ephemeral_state() -> Unit {
  shell_on_pane_disconnected(1)
  if is_find_bar_open() && shell_adapter.find_owner_pane == 1 {
    match app_state.find_open {
      Some(s) => s.set(false)
      None => ()
    }
    match app_state.find_field {
      Some(ff) => ff.let_go()
      None => ()
    }
    match app_state.split_stage {
      Some(sp) => sp.find_clear()
      None => ()
    }
    app_state.last_find_query = ""
    set_host_find_result(false, -1, 0)
    set_find_owner_pane(0)
    shell_sync_dock_from_app()
  }
  app_state.split_nav_back = []
  app_state.split_nav_forward = []
  app_state.split_downloads = []
  downloads_tracker.split_seqs = []
  clear_pending_exports_for_pane(1)
  rebuild_merged_downloads()
}

// ============================================================================
// 1. `chrome_theme` <-> `lg::set_dark` Synchronization
// ============================================================================

///| Drives `lg::set_dark` from the normalized chrome theme name ("dark" | "light").
///| A Space set to light or dark keeps that appearance while it is active (the shell frame keeps it in step too).
fn sync_lg_theme_from_chrome(theme_name : String) -> Unit {
  let norm = proto::normalize_chrome_theme(theme_name)
  let forced = match proto::workspace_active_space(app_state.workspace) {
    Some(sp) =>
    match sp.theme.mode {
      proto::SpaceThemeMode::Light => Some(false)
      proto::SpaceThemeMode::Dark => Some(true)
      proto::SpaceThemeMode::Auto => None
    }
    None => None
  }
  lg::set_dark(Some(forced.unwrap_or(norm == "dark")))
}

// ============================================================================
// 2. Layer 1: Dock State Synchronization
// ============================================================================

fn shell_sync_dock_from_app() -> Unit {
  let bookmarks = match app_state.bookmarks_bar_open {
    Some(s) => s.untracked()
    None => app_state.initial_bookmarks_bar_open
  }
  let devtools = match app_state.devtools_open {
    Some(s) => s.untracked()
    None => app_state.initial_devtools_open
  }
  let find_open = is_find_bar_open()
  let find_focused = is_find_field_focused()
  let sb_w = settings_sidebar_width()
  let cur = shell_adapter.dock.untracked()
  if (cur.sidebar_width - sb_w).abs() > 0.5 || cur.bookmarks_open != bookmarks || cur.devtools_open != devtools || cur.find_bar_open != find_open || cur.find_focused != find_focused {
    shell_adapter.dock.set(
      shell_ui::DockState::{
        ..cur,
        sidebar_width: sb_w,
        bookmarks_open: bookmarks,
        devtools_open: devtools,
        find_bar_open: find_open,
        find_focused,
      },
    )
  }
}

// ============================================================================
// 3. Layer 2: Orthogonal `PageLayout x PaneSurface` State Machine
// ============================================================================

fn shell_pane_id_from_int(pane : Int) -> shell_ui::PaneId {
  if pane == 1 {
    shell_ui::PaneId::Secondary
  } else {
    shell_ui::PaneId::Primary
  }
}

fn shell_page_init_from_app() -> Unit {
  let layout = if app_state.initial_split_open {
    shell_ui::PageLayout::Split
  } else if app_state.initial_peek_open {
    shell_ui::PageLayout::Peek
  } else {
    shell_ui::PageLayout::Single
  }
  let active_pane = if app_state.initial_split_open && app_state.initial_split_active_pane == 1 {
    shell_ui::PaneId::Secondary
  } else {
    shell_ui::PaneId::Primary
  }
  let swapped = app_state.initial_split_open && app_state.initial_split_swapped
  let ratio = proto::clamp_split_ratio(app_state.initial_split_ratio)
  let cur = shell_adapter.page.untracked()
  shell_adapter.page.set(
    shell_ui::PageLayoutState::{
      ..cur,
      layout,
      active_pane,
      panes_swapped: swapped,
      split_ratio: ratio,
    },
  )
}

fn shell_dock_init_from_app() -> Unit {
  let cur = shell_adapter.dock.untracked()
  shell_adapter.dock.set(
    shell_ui::DockState::{
      ..cur,
      sidebar_open: app_state.initial_sidebar_open,
      sidebar_width: settings_sidebar_width(),
      bookmarks_open: app_state.initial_bookmarks_bar_open,
      devtools_open: app_state.initial_devtools_open,
      find_bar_open: is_find_bar_open(),
      find_focused: is_find_field_focused(),
    },
  )
}

fn shell_page_open_split(focus_pane : Int) -> shell_ui::SecondaryStageHandoff {
  shell_adapter.last_page_focus_pane = focus_pane
  let cur = shell_adapter.page.untracked()
  let (next0, handoff) = cur.with_layout(shell_ui::PageLayout::Split)
  let next_active = shell_pane_id_from_int(focus_pane)
  shell_adapter.page.set(shell_ui::PageLayoutState::{ ..next0, active_pane: next_active })
  handoff
}

fn shell_page_close_split() -> shell_ui::SecondaryStageHandoff {
  shell_adapter.last_page_focus_pane = 0
  let cur = shell_adapter.page.untracked()
  let (next0, handoff) = cur.with_layout(shell_ui::PageLayout::Single)
  shell_adapter.page.set(
    shell_ui::PageLayoutState::{
      ..next0,
      active_pane: shell_ui::PaneId::Primary,
      panes_swapped: false,
    },
  )
  handoff
}

fn shell_page_swap_panes() -> Unit {
  let cur = shell_adapter.page.untracked()
  shell_adapter.page.set(cur.swap_panes())
}

fn shell_page_set_ratio(ratio : Double) -> Unit {
  let cur = shell_adapter.page.untracked()
  shell_adapter.page.set(cur.set_ratio(ratio))
}

fn shell_page_open_peek() -> shell_ui::SecondaryStageHandoff {
  shell_adapter.last_page_focus_pane = 1
  let cur = shell_adapter.page.untracked()
  let (next0, handoff) = cur.open_peek()
  shell_adapter.page.set(next0)
  handoff
}

fn shell_page_promote_peek_to_split() -> shell_ui::SecondaryStageHandoff {
  shell_adapter.last_page_focus_pane = 1
  let cur = shell_adapter.page.untracked()
  let (next0, handoff) = cur.promote_peek_to_split()
  shell_adapter.page.set(
    shell_ui::PageLayoutState::{ ..next0, active_pane: shell_ui::PaneId::Secondary },
  )
  handoff
}

fn shell_page_close_peek() -> shell_ui::SecondaryStageHandoff {
  let cur = shell_adapter.page.untracked()
  if is_split_open() {
    return shell_ui::SecondaryStageHandoff::ReuseSharedStage
  }
  shell_adapter.last_page_focus_pane = 0
  let (next0, handoff) = cur.with_layout(shell_ui::PageLayout::Single)
  shell_adapter.page.set(next0)
  handoff
}

fn shell_page_set_active_pane(pane : Int) -> Unit {
  let cur = shell_adapter.page.untracked()
  let next_active = if pane == 1 && (cur.has_secondary() || is_split_open() || is_peek_open()) {
    shell_ui::PaneId::Secondary
  } else {
    shell_ui::PaneId::Primary
  }
  shell_adapter.last_page_focus_pane = if next_active is shell_ui::PaneId::Secondary { 1 } else { 0 }
  if cur.active_pane != next_active {
    shell_end_page_ime_composition()
    if shell_sig_is_true(app_state.site_info_open) {
      close_site_info()
    }
    shell_adapter.page.set(shell_ui::PageLayoutState::{ ..cur, active_pane: next_active })
  }
}

fn shell_reader_next_req_id(pane : Int) -> String {
  shell_adapter.reader_req_seq = shell_adapter.reader_req_seq + 1
  "r" + pane.to_string() + ":" + shell_adapter.reader_req_seq.to_string()
}

fn shell_page_set_surface(pane : shell_ui::PaneId, surface : shell_ui::PaneSurface) -> Unit {
  let cur = shell_adapter.page.untracked()
  shell_adapter.page.set(cur.set_surface(pane, surface))
}

fn shell_page_set_active_reader(open : Bool) -> Unit {
  let cur = shell_adapter.page.untracked()
  if open {
    shell_adapter.reader_pane_id = cur.active_pane
    shell_adapter.page.set(cur.set_surface(cur.active_pane, shell_ui::PaneSurface::Reader))
  } else {
    let target = shell_adapter.reader_pane_id
    shell_adapter.page.set(cur.set_surface(target, shell_ui::PaneSurface::Web))
  }
}

// ============================================================================
// 4. Layer 3 (`Exclusive`, at most 1 + 1 `nested`) & Layer 4 (`Passive`)
// ============================================================================

fn shell_close_overlay_by_tag(tag : String) -> Bool {
  if tag == "command_bar" {
    close_command_bar()
    true
  } else if tag == "omnibox" {
    shell_dismiss_omnibox_and_restore_address()
    true
  } else if tag == "site_info" {
    close_site_info()
    true
  } else if tag == "cookies" {
    close_cookies_modal()
    true
  } else if tag == "downloads" {
    close_downloads()
    true
  } else if tag == "history" {
    close_history()
    true
  } else if tag == "bookmarks" {
    close_bookmarks()
    true
  } else if tag == "boosts" {
    close_boosts()
    true
  } else if tag == "settings" {
    close_settings()
    true
  } else if tag == "space_theme" {
    close_space_theme()
    true
  } else if tag == "spaces_manager" {
    close_spaces_manager()
    true
  } else if tag == "closed_tabs" {
    close_closed_tabs_modal()
    true
  } else if tag == "print_pdf" {
    close_print_pdf_modal()
    true
  } else if tag == "tab_ctx" {
    close_tab_ctx()
    true
  } else if tag == "zoom_popover" {
    close_zoom_popover()
    true
  } else if tag == "folder_ctx" {
    close_folder_ctx()
    true
  } else if tag == "shortcuts" {
    close_shortcuts()
    true
  } else if tag == "mru" {
    close_mru_switcher()
    true
  } else if tag == "page_ctx" {
    close_page_ctx()
    true
  } else if tag == "nav_hist" {
    close_nav_hist()
    true
  } else if tag == "media_hub" {
    close_media_hub()
    true
  } else if tag == "idn_popover" {
    close_idn_popover()
    true
  } else if tag == "bm_bar_ctx" {
    close_bm_bar_ctx()
    true
  } else if tag == "sessions" {
    close_sessions_modal()
    true
  } else if tag == "folder_create" {
    close_folder_create_bar()
    true
  } else if tag == "tab_search" {
    close_tab_search()
    true
  } else if tag == "shell_menu" || tag == "shell_drawer" || tag == "shell_sidebar_drawer" || tag == "shell_dialog" {
    shell_mark_exclusive_closed(tag)
    true
  } else if tag == "shell_omnibox" {
    shell_dismiss_omnibox_and_restore_address()
    true
  } else {
    false
  }
}

///| Closes all Layer-3 `Exclusive` overlays (except optional `keep_tag`) plus `TabHoverPreview`,
///| while preserving Layer-2 `Peek` (explicitly dismissed via Esc / CloseSecondaryPane / backdrop)
///| and Layer-4 `Passive` surfaces (`Toast`, `PerfHUD`, `CaptureSheet`) and sidebar `tab_filter`.
fn close_exclusive_overlays(keep_tag~ : String = "") -> Unit {
  let prev = shell_adapter.exclusive.untracked()
  let prev_active = prev.active
  let prev_tag = shell_adapter.active_overlay_tag
  if keep_tag != "command_bar" { close_command_bar() }
  if keep_tag != "omnibox" && keep_tag != "shell_omnibox" { close_omnibox() }
  if keep_tag != "site_info" { close_site_info() }
  if keep_tag != "cookies" { close_cookies_modal() }
  if keep_tag != "downloads" { close_downloads() }
  if keep_tag != "history" { close_history() }
  if keep_tag != "bookmarks" { close_bookmarks() }
  if keep_tag != "boosts" { close_boosts() }
  if keep_tag != "settings" { close_settings() }
  if keep_tag != "space_theme" { close_space_theme() }
  if keep_tag != "spaces_manager" { close_spaces_manager() }
  if keep_tag != "closed_tabs" { close_closed_tabs_modal() }
  if keep_tag != "print_pdf" { close_print_pdf_modal() }
  if keep_tag != "tab_ctx" { close_tab_ctx() }
  if keep_tag != "zoom_popover" { close_zoom_popover() }
  if keep_tag != "folder_ctx" { close_folder_ctx() }
  if keep_tag != "shortcuts" { close_shortcuts() }
  if keep_tag != "mru" { close_mru_switcher() }
  if keep_tag != "page_ctx" { close_page_ctx() }
  if keep_tag != "nav_hist" { close_nav_hist() }
  if keep_tag != "media_hub" { close_media_hub() }
  if keep_tag != "idn_popover" { close_idn_popover() }
  if keep_tag != "bm_bar_ctx" { close_bm_bar_ctx() }
  if keep_tag != "sessions" { close_sessions_modal() }
  if keep_tag != "folder_create" { close_folder_create_bar() }
  if keep_tag != "tab_search" { close_tab_search() }
  close_tab_hover_preview()
  if keep_tag != "" && prev_tag == keep_tag {
    shell_adapter.nested_overlay_tag = ""
    return
  }
  shell_adapter.active_overlay_tag = ""
  shell_adapter.nested_overlay_tag = ""
  if !(prev_active is shell_ui::ExclusiveKind::None) {
    shell_adapter.leaving_overlay_tag = prev_tag
    shell_adapter.exclusive.set(
      shell_ui::ExclusiveState::{
        active: shell_ui::ExclusiveKind::None,
        tag: "",
        nested: shell_ui::ExclusiveKind::None,
        leaving_kind: prev_active,
        intercepts_pointer: false,
        return_focus_id: prev.return_focus_id,
        keep_omnibox_focus: false,
      },
    )
  }
}

///| Records opening an `Exclusive` overlay after closing any previous `Exclusive`.
///| Releases webpage Stage/catcher focus only when switching to a genuinely new overlay
///| (`prev_tag != tag`), ends page IME composition, and preserves `leaving_kind`.
fn shell_mark_exclusive_open(kind : shell_ui::ExclusiveKind, tag : String) -> Unit {
  let prev_tag = shell_adapter.active_overlay_tag
  if prev_tag != tag {
    shell_release_stage_focus()
  }
  let prev = shell_adapter.exclusive.untracked()
  let leaving = if !(prev.leaving_kind is shell_ui::ExclusiveKind::None) {
    prev.leaving_kind
  } else if !(prev.active is shell_ui::ExclusiveKind::None) {
    prev.active
  } else {
    shell_ui::ExclusiveKind::None
  }
  let opened = prev.open(kind, tag=tag)
  shell_adapter.active_overlay_tag = tag
  shell_adapter.nested_overlay_tag = ""
  shell_adapter.exclusive.set(shell_ui::ExclusiveState::{ ..opened, leaving_kind: leaving })
}

///| Opens a 1-level `nested` overlay above the currently active `Exclusive` overlay.
fn shell_open_nested_exclusive(kind : shell_ui::ExclusiveKind, tag : String) -> Bool {
  let cur = shell_adapter.exclusive.untracked()
  if cur.active is shell_ui::ExclusiveKind::None || kind is shell_ui::ExclusiveKind::None {
    return false
  }
  shell_release_stage_focus()
  shell_adapter.nested_overlay_tag = tag
  shell_adapter.exclusive.set(cur.open_nested(kind))
  true
}

fn shell_mark_exclusive_closed(tag : String) -> Unit {
  let cur = shell_adapter.exclusive.untracked()
  if shell_adapter.nested_overlay_tag == tag && tag != "" {
    shell_adapter.nested_overlay_tag = ""
    shell_adapter.exclusive.set(cur.begin_close())
    return
  }
  if shell_adapter.active_overlay_tag == tag && tag != "" {
    shell_adapter.leaving_overlay_tag = tag
    shell_adapter.active_overlay_tag = ""
    shell_adapter.nested_overlay_tag = ""
    shell_adapter.exclusive.set(cur.begin_close())
  }
}

fn shell_sync_passive_from_app() -> Unit {
  let toast_vis = match app_state.toast_visible {
    Some(s) => s.untracked()
    None => false
  }
  let toast_msg = match app_state.toast_message {
    Some(s) => s.untracked()
    None => ""
  }
  let toast_kind_tag = match app_state.toast_kind {
    Some(s) => s.untracked()
    None => "info"
  }
  let preview_id = match app_state.tab_preview_tab_id {
    Some(s) => s.untracked()
    None => ""
  }
  let cap_open = match app_state.capture_sheet_open {
    Some(s) => s.untracked()
    None => false
  }
  let perf_open = match app_state.perf_hud_open {
    Some(s) => s.untracked()
    None => false
  }
  let cap_meta = app_state.capture_sheet_meta
  let cap_path = cap_meta.path.trim()
  let cap_revealable = cap_open && cap_path != "" && capture_sheet_local_path_accessible(cap_path, cap_meta.size_bytes)
  let cap_unavailable = cap_open && !cap_revealable && !app_state.demo_capture_sheet
  let cur = shell_adapter.passive.untracked()
  shell_adapter.passive.set(
    shell_ui::PassiveState::{
      ..cur,
      toast_visible: toast_vis,
      toast_title: toast_msg,
      toast_kind: shell_ui::toast_kind_from_tag(toast_kind_tag),
      toast_action: app_state.toast_action_label,
      tab_preview_id: preview_id,
      capture_sheet_open: cap_open,
      capture_sheet: cap_meta,
      capture_sheet_revealable: cap_revealable,
      capture_sheet_file_unavailable: cap_unavailable,
      perf_hud_open: perf_open,
    },
  )
}

// ============================================================================
// 5. Request-Attributed `OmniboxRequestGate` (Epoch + `req_id` + Broadcast Isolation)
// ============================================================================

fn shell_omnibox_next_req_id() -> String {
  shell_adapter.omnibox_req_seq = shell_adapter.omnibox_req_seq + 1
  "c" + shell_adapter.omnibox_conn_epoch.to_string() + ":" + shell_adapter.omnibox_req_seq.to_string()
}

///| Resets the omnibox request gate on main connection disconnect.
fn shell_omnibox_on_disconnect() -> Unit {
  shell_adapter.omnibox_conn_epoch = shell_adapter.omnibox_conn_epoch + 1
  shell_adapter.omnibox_in_flight_req_id = ""
  shell_adapter.omnibox_in_flight_started_ms = 0.0
  shell_adapter.omnibox_in_flight_is_empty = false
  shell_adapter.omnibox_legacy_array_seen = false
  shell_adapter.omnibox_saw_envelope = false
  shell_adapter.omnibox_pending_query = None
  shell_adapter.omnibox_gate = shell_ui::OmniboxRequestGate::new()
}

///| Resets the omnibox request gate on main connection established and re-queries if open.
fn shell_omnibox_on_connected() -> Unit {
  shell_omnibox_on_disconnect()
  if shell_sig_is_true(app_state.omnibox_open) {
    dispatch_omnibox_query(app_state.omnibox_last_query)
  }
}

///| Prepares a connected omnibox query for dispatch WITHOUT committing `in_flight` until
///| the wire frame actually enqueues (prevents ghost `in_flight` on `TooLarge` / disconnect).
///| Immediately overrides an in-flight empty query `""`, a timed-out (>= 500ms) request,
///| or a legacy array-only host; otherwise coalesces bursts into `pending_query`.
fn shell_omnibox_prepare_dispatch(q : String) -> Option[(String, String)] {
  if !io_rt.main_conn.is_open() {
    return None
  }
  let trimmed = q.trim()
  let now = now_ms()
  let timed_out = shell_adapter.omnibox_in_flight_req_id != "" &&
  shell_adapter.omnibox_in_flight_started_ms > 0.0 &&
  now - shell_adapter.omnibox_in_flight_started_ms >= 500.0
  let can_send_now = shell_adapter.omnibox_in_flight_req_id == "" ||
  (shell_adapter.omnibox_in_flight_is_empty && trimmed != "") ||
  timed_out ||
  shell_adapter.omnibox_legacy_array_seen
  if can_send_now {
    let rid = shell_omnibox_next_req_id()
    Some((q, rid))
  } else {
    shell_adapter.omnibox_pending_query = Some(q)
    if trimmed != "" {
      let (next_gate, _) = shell_adapter.omnibox_gate.submit_query(trimmed)
      shell_adapter.omnibox_gate = next_gate
    } else {
      let g = shell_adapter.omnibox_gate
      shell_adapter.omnibox_gate = shell_ui::OmniboxRequestGate::{
        ..g,
        suggestions_open: true,
        pending_query: Some(""),
        latest_desired: "",
        generation: g.generation + 1,
      }
    }
    None
  }
}

///| Commits `in_flight` state AFTER `send_wire_checked` confirms the frame was enqueued.
fn shell_omnibox_commit_sent(q : String, req_id : String) -> Unit {
  let trimmed = q.trim()
  shell_adapter.omnibox_in_flight_req_id = req_id
  shell_adapter.omnibox_in_flight_started_ms = now_ms()
  shell_adapter.omnibox_in_flight_is_empty = trimmed == ""
  shell_adapter.omnibox_legacy_array_seen = false
  shell_adapter.omnibox_pending_query = None
  let g = shell_adapter.omnibox_gate
  shell_adapter.omnibox_gate = shell_ui::OmniboxRequestGate::{
    suggestions_open: true,
    in_flight: Some(trimmed),
    pending_query: None,
    latest_desired: trimmed,
    generation: g.generation + 1,
  }
}

///| Marks the omnibox suggestion popup closed in `OmniboxRequestGate` so any in-flight
///| late unicast reply is dropped and never resurrects the closed popup.
fn shell_omnibox_gate_close() -> Unit {
  shell_adapter.omnibox_in_flight_req_id = ""
  shell_adapter.omnibox_in_flight_started_ms = 0.0
  shell_adapter.omnibox_in_flight_is_empty = false
  shell_adapter.omnibox_legacy_array_seen = false
  shell_adapter.omnibox_pending_query = None
  shell_adapter.omnibox_gate = shell_adapter.omnibox_gate.close_suggestions()
}

fn send_wire_checked(msg : wire::Message) -> Bool {
  enqueue_main_bytes_at(wire::encode(msg), coalescable=is_wire_coalescable(msg), clock_fn=now_ms)
}

///| Processes an incoming `OmniboxResults(json)` payload:
///| - Bare array (`req_id == None`): ALWAYS clears local remote cache (`items = []`, never
///|   writes bare-array entries so deleted-history broadcasts and cross-viewer broadcasts can
///|   never pollute or retain stale items). On a new host (`omnibox_saw_envelope == true`),
///|   does not consume an active `in_flight`; on a legacy host (`omnibox_saw_envelope == false`),
///|   finishes the current `in_flight` slot and immediately flushes any queued `pending_query`.
///| - Unicast envelope (`req_id == Some(rid)`): marks `omnibox_saw_envelope = true` and only
///|   accepts if `rid` matches current connection epoch & `in_flight_req_id`.
fn shell_omnibox_gate_on_envelope(
  json : String,
) -> (Bool, Array[proto::OmniboxItem], Bool, Option[(String, String)]) {
  let (req_opt, parsed) = proto::parse_omnibox_envelope(json, max_items=proto::OMNIBOX_MAX_ITEMS)
  match req_opt {
    None => {
      if shell_adapter.omnibox_saw_envelope || shell_adapter.omnibox_in_flight_req_id == "" {
        return (true, [], true, None)
      }
      let is_open = shell_sig_is_true(app_state.omnibox_open)
      match shell_adapter.omnibox_pending_query {
        Some(next_q) if is_open && io_rt.main_conn.is_open() => {
          shell_adapter.omnibox_in_flight_req_id = ""
          shell_adapter.omnibox_in_flight_started_ms = 0.0
          shell_adapter.omnibox_in_flight_is_empty = false
          shell_adapter.omnibox_legacy_array_seen = true
          shell_adapter.omnibox_pending_query = None
          if shell_adapter.omnibox_gate.in_flight.is_some() {
            let (next_gate, _, _) = shell_adapter.omnibox_gate.on_results([])
            shell_adapter.omnibox_gate = next_gate
          }
          let next_rid = shell_omnibox_next_req_id()
          (true, [], true, Some((next_q, next_rid)))
        }
        _ => {
          shell_adapter.omnibox_legacy_array_seen = true
          (true, [], true, None)
        }
      }
    }
    Some(rid) => {
      shell_adapter.omnibox_saw_envelope = true
      if rid == "" || rid != shell_adapter.omnibox_in_flight_req_id {
        return (false, [], false, None)
      }
      shell_adapter.omnibox_in_flight_req_id = ""
      shell_adapter.omnibox_in_flight_started_ms = 0.0
      shell_adapter.omnibox_in_flight_is_empty = false
      shell_adapter.omnibox_legacy_array_seen = false
      let pending = shell_adapter.omnibox_pending_query
      shell_adapter.omnibox_pending_query = None
      if shell_adapter.omnibox_gate.in_flight.is_some() {
        let (next_gate, _, _) = shell_adapter.omnibox_gate.on_results(parsed)
        shell_adapter.omnibox_gate = next_gate
      }
      let is_open = shell_sig_is_true(app_state.omnibox_open)
      match pending {
        Some(next_q) if is_open && io_rt.main_conn.is_open() => {
          let next_rid = shell_omnibox_next_req_id()
          (false, [], false, Some((next_q, next_rid)))
        }
        _ => if is_open {
          (true, parsed, false, None)
        } else {
          (false, [], false, None)
        }
      }
    }
  }
}

// ============================================================================
// 6. Positive Input Ownership, Layer 0 IME Guard & Deterministic Escape Chain
// ============================================================================

fn send_proto_to_pane(owner : Int, msg : proto::ClientMsg) -> Unit {
  if owner == 1 {
    if io_rt.split_conn.is_open() {
      enqueue_split_bytes(proto::encode_client(msg), coalescable=is_proto_coalescable(msg))
    }
  } else if owner == 0 {
    if io_rt.main_conn.is_open() {
      enqueue_main_bytes(proto::encode_client(msg), coalescable=is_proto_coalescable(msg))
    }
  } else {
    send_proto_active(msg)
  }
}

///| O(depth) upward parent walk checking whether `target` is inside `v` (never walks descendants).
fn shell_view_contains_node_steps(v : view::View, target : view::NodeId) -> (Bool, Int) {
  if !v.alive() {
    return (false, 0)
  }
  let mut i = target.at
  let mut steps = 0
  while i >= 0 && i < v.tree.nodes.length() {
    steps += 1
    if i == v.at {
      return (true, steps)
    }
    i = v.tree.nodes[i].parent
  }
  (false, steps)
}

fn shell_view_contains_node(v : view::View, target : view::NodeId) -> Bool {
  shell_view_contains_node_steps(v, target).0
}

///| Releases toolbar/sidebar button or Chrome field focus when the user clicks inside a Stage.
fn shell_release_chrome_focus_for_stage(stage_v : view::View) -> Unit {
  match ui::focused_field_now() {
    Some(f) if f.focused() && is_chrome_field_focused() => f.let_go()
    _ => ()
  }
  match app_state.root_view {
    Some(rv) => match rv.tree.focused_now().0 {
      Some(fid) if !shell_view_contains_node(stage_v, fid) => {
        let _ = rv.tree.focus_to(None)
      }
      _ => ()
    }
    None => ()
  }
}

///| Returns true when `pane_id` (`0` = primary, `1` = secondary) is currently covered by
///| StartPage or Reader Mode so clicks, paste, IME, and `Cmd+A`/`Cmd+C` never penetrate to the Stage.
fn shell_is_pane_occluded(pane_id : Int) -> Bool {
  let reader_on = match app_state.reader_open {
    Some(s) => s.get()
    None => false
  }
  if reader_on && shell_adapter.reader_owner_pane == pane_id {
    return true
  }
  if pane_id == 0 && !is_split_open_live() {
    if app_state.initial_start_page_open {
      return true
    }
    match app_state.stage {
      Some(st) => {
        let u = st.url()
        if !st.loading() && proto::is_start_page_url(u) {
          return true
        }
      }
      None => ()
    }
  }
  false
}

///| Releases focus from a specific pane's `Stage` / `catcher` when occluded by StartPage or Reader.
fn shell_release_pane_stage_focus(pane_id : Int) -> Unit {
  if shell_adapter.ime_owner_pane == pane_id {
    shell_end_page_ime_composition()
  }
  match ui::focused_field_now() {
    Some(f) if f.focused() && shell_field_belongs_to_pane(f, pane_id) => f.let_go()
    _ => ()
  }
  match app_state.root_view {
    Some(rv) => match rv.tree.focused_now().0 {
      Some(fid) => {
        let target_v = if pane_id == 0 { app_state.stage_view } else { app_state.split_stage_view }
        match target_v {
          Some(sv) if shell_view_contains_node(sv, fid) => {
            let _ = rv.tree.focus_to(None)
          }
          _ => ()
        }
      }
      None => ()
    }
    None => ()
  }
}

///| Returns keyboard & paste focus directly to the active pane's real `Stage` (clearing chrome
///| field & toolbar button focus so the very next keypress after `Esc` hits the page).
fn shell_focus_pane_stage(pane : shell_ui::PaneId) -> Unit {
  let pane_i = if pane is shell_ui::PaneId::Secondary && (is_split_open() || is_peek_open()) { 1 } else { 0 }
  match ui::focused_field_now() {
    Some(f) if f.focused() && is_chrome_field_focused() => f.let_go()
    _ => ()
  }
  match app_state.root_view {
    Some(rv) => {
      let _ = rv.tree.focus_to(None)
    }
    None => ()
  }
  shell_page_set_active_pane(pane_i)
  shell_adapter.last_page_focus_pane = pane_i
}

///| Watches real window pointer downs (`window_downs()` + `window_down_point()`) against
///| `stage_v.placed_window_now()` so clicking inside a Stage (whether hover-first or direct
///| press/touch) releases chrome button focus and records explicit `last_page_focus_pane`.
fn shell_has_non_omnibox_blocking_overlay() -> Bool {
  let ex = shell_adapter.exclusive.untracked()
  let shell_owned_open = match ex.active {
    shell_ui::ExclusiveKind::Menu | shell_ui::ExclusiveKind::Drawer | shell_ui::ExclusiveKind::SidebarDrawer | shell_ui::ExclusiveKind::Dialog =>
    ex.tag == "shell_menu" || ex.tag == "shell_drawer" || ex.tag == "shell_sidebar_drawer" || ex.tag == "shell_dialog"
    _ => false
  }
  shell_owned_open ||
  shell_sig_is_true(app_state.mru_open) ||
  shell_sig_is_true(app_state.tab_search_open) ||
  shell_sig_is_true(app_state.command_bar_open) ||
  shell_sig_is_true(app_state.page_ctx_open) ||
  shell_sig_is_true(app_state.nav_hist_open) ||
  shell_sig_is_true(app_state.bm_bar_ctx_open) ||
  shell_sig_is_true(app_state.tab_ctx_open) ||
  shell_sig_is_true(app_state.folder_ctx_open) ||
  shell_sig_is_true(app_state.zoom_popover_open) ||
  shell_sig_is_true(app_state.idn_popover_open) ||
  shell_sig_is_true(app_state.site_info_open) ||
  shell_sig_is_true(app_state.media_hub_open) ||
  shell_sig_is_true(app_state.shortcuts_open) ||
  shell_sig_is_true(app_state.cookies_open) ||
  shell_sig_is_true(app_state.downloads_open) ||
  shell_sig_is_true(app_state.history_open) ||
  shell_sig_is_true(app_state.bookmarks_open) ||
  shell_sig_is_true(app_state.boosts_open) ||
  shell_sig_is_true(app_state.settings_open) ||
  shell_sig_is_true(app_state.space_theme_open) ||
  shell_sig_is_true(app_state.spaces_manager_open) ||
  shell_sig_is_true(app_state.closed_tabs_open) ||
  shell_sig_is_true(app_state.print_pdf_open) ||
  shell_sig_is_true(app_state.sessions_open) ||
  shell_sig_is_true(app_state.folder_create_open)
}

fn shell_bind_stage_window_down(
  host_v : view::View,
  stage_v : view::View,
  pane_id : Int,
) -> Unit {
  let mut last_down = signals::untracked(fn() -> Int { host_v.window_downs() })
  host_v.reacts(fn() -> Int { host_v.window_downs() }, fn(cnt : Int) -> Unit {
    if cnt == last_down {
      return
    }
    last_down = cnt
    if shell_has_non_omnibox_blocking_overlay() || !stage_v.alive() || (pane_id == 0 && is_peek_open()) || shell_is_pane_occluded(pane_id) {
      return
    }
    let (dx, dy) = host_v.window_down_point()
    if shell_sig_is_true(app_state.omnibox_open) {
      match shell_adapter.omnibox_panel_view {
        Some(pv) if pv.alive() => {
          let (px, py, pw, ph) = pv.placed_window_now()
          if pw > 0.0 && ph > 0.0 && dx >= px && dx <= px + pw && dy >= py && dy <= py + ph {
            return
          }
        }
        _ => ()
      }
    }
    let (sx, sy, sw, sh) = stage_v.placed_window_now()
    if sw > 0.0 && sh > 0.0 && dx >= sx && dx <= sx + sw && dy >= sy && dy <= sy + sh {
      let was_omni = shell_sig_is_true(app_state.omnibox_open) || shell_sig_is_true(app_state.omnibox_editing)
      if was_omni {
        close_omnibox()
        match app_state.omnibox_editing {
          Some(ed) => if ed.untracked() { ed.set(false) }
          None => ()
        }
      }
      shell_release_chrome_focus_for_stage(stage_v)
      shell_adapter.last_page_focus_pane = pane_id
      if is_split_open() {
        set_active_split_pane(pane_id)
      }
      if was_omni {
        sync_address_bar_from_active()
      }
    }
  })
}

///| Releases webpage `Stage` / hidden `catcher` / webpage form-field focus and ends page
///| IME composition whenever a blocking Exclusive overlay opens so clipboard/IME never leaks.
fn shell_release_stage_focus() -> Unit {
  shell_end_page_ime_composition()
  match ui::focused_field_now() {
    Some(f) if f.focused() && !is_chrome_field_focused() => f.let_go()
    _ => ()
  }
  match app_state.root_view {
    Some(rv) => match rv.tree.focused_now().0 {
      Some(fid) => {
        let in_main = match app_state.stage_view {
          Some(sv) => shell_view_contains_node(sv, fid)
          None => false
        }
        let in_split = match app_state.split_stage_view {
          Some(sv2) => shell_view_contains_node(sv2, fid)
          None => false
        }
        if in_main || in_split {
          let _ = rv.tree.focus_to(None)
        }
      }
      None => ()
    }
    None => ()
  }
}

///| Positive per-pane page-focus ownership check:
///| - Returns `0` when primary Stage owns focus (even if `active_split_pane == 1`),
///| - Returns `1` when secondary Stage owns focus (and Split/Peek is open),
///| - Returns `-1` when a Chrome Field, blocking Exclusive overlay, or non-Stage chrome
///|   button/control owns focus.
///| When no tree node holds focus (e.g. after clicking blank webpage content), returns the
///| explicitly recorded `last_page_focus_pane` (`0` or `1` if secondary is active).
fn shell_page_focus_owner_pane() -> Int {
  if is_chrome_field_focused() || shell_has_blocking_exclusive_overlay() {
    return -1
  }
  let sec_open = is_split_open() || is_peek_open()
  match app_state.root_view {
    Some(rv) => match rv.tree.focused_now().0 {
      Some(fid) => {
        match app_state.stage_view {
          Some(sv) if shell_view_contains_node(sv, fid) => return if shell_is_pane_occluded(0) { -1 } else { 0 }
          _ => ()
        }
        if sec_open {
          match app_state.split_stage_view {
            Some(sv2) if shell_view_contains_node(sv2, fid) => return if shell_is_pane_occluded(1) { -1 } else { 1 }
            _ => ()
          }
        }
        -1
      }
      None => {
        match ui::focused_field_now() {
          Some(f) if f.focused() && f.paste_limit != 1 => return -1
          _ => ()
        }
        if shell_adapter.last_page_focus_pane == 1 && sec_open {
          if shell_is_pane_occluded(1) { -1 } else { 1 }
        } else if shell_adapter.last_page_focus_pane == 0 {
          if shell_is_pane_occluded(0) { -1 } else { 0 }
        } else if app_state.stage_view.is_some() {
          if shell_is_pane_occluded(0) { -1 } else { 0 }
        } else {
          -1
        }
      }
    }
    None => {
      match ui::focused_field_now() {
        Some(f) if f.focused() && f.paste_limit == 1 => {
          let p = if active_targets_split() { 1 } else { 0 }
          return if shell_is_pane_occluded(p) { -1 } else { p }
        }
        Some(f) if f.focused() => return -1
        _ => ()
      }
      let p = if active_targets_split() { 1 } else { 0 }
      if shell_is_pane_occluded(p) { -1 } else { p }
    }
  }
}

fn shell_is_page_focus_owner() -> Bool {
  shell_page_focus_owner_pane() >= 0
}

///| Ends any active page-level IME composition on its owning pane so focus transitions,
///| tab/pane switches, overlay opens, or disconnects never leave `ime_composing` stuck.
fn shell_end_page_ime_composition() -> Unit {
  if !app_state.ime_composing {
    shell_adapter.ime_owner_pane = -1
    return
  }
  let owner = shell_adapter.ime_owner_pane
  app_state.ime_composing = false
  shell_adapter.ime_owner_pane = -1
  send_proto_to_pane(owner, proto::ClientMsg::EditInput(0, 0, "", 2, 0, proto::EDIT_COMPOSING))
}

///| Positively verifies that a non-Chrome `ui::Field` (`stage.catcher` or any mounted
///| webpage `<input>`/`<textarea>` `Editing.words`) belongs to the exact target `pane`
///| (`0` = primary Stage, `1` = secondary Stage). Never defaults to `true` for unknown fields.
fn shell_field_belongs_to_pane(f : ui::Field, pane : Int) -> Bool {
  if pane == 0 {
    match app_state.stage {
      Some(st) if f.phys_id == st.catcher.phys_id => return true
      _ => ()
    }
    match (app_state.stage_view, f.tree_node) {
      (Some(sv), Some(nid)) => return shell_view_contains_node(sv, nid)
      _ => false
    }
  } else if pane == 1 {
    match app_state.split_stage {
      Some(st2) if f.phys_id == st2.catcher.phys_id => return true
      _ => ()
    }
    match (app_state.split_stage_view, f.tree_node) {
      (Some(sv2), Some(nid)) => return shell_view_contains_node(sv2, nid)
      _ => false
    }
  } else {
    false
  }
}

///| Unified positive-ownership IME & clipboard paste handler delegated from `main.pion`.
fn shell_handle_ime_text(kind : Int, s : String, _a : Int, _b : Int) -> Bool {
  // macOS Cmd+V paste arrives from NSTextInputClient / paste_now as kind == 8.
  if kind == 8 {
    if s != "" {
      write_os_clipboard(s)
      if is_chrome_field_focused() {
        match ui::focused_field_now() {
          Some(f) if f.focused() => {
            f.paste_text(s)
            return true
          }
          _ => return false
        }
      }
      if shell_has_blocking_exclusive_overlay() {
        match ui::focused_field_now() {
          Some(f) if f.focused() => {
            f.let_go()
            return true
          }
          _ => return false
        }
      }
      let pane = shell_page_focus_owner_pane()
      match ui::focused_field_now() {
        Some(f) if f.focused() => {
          if pane < 0 {
            f.let_go()
            return true
          }
          if shell_field_belongs_to_pane(f, pane) {
            f.paste_text(s)
            return true
          }
          f.let_go()
          let dm = dom_primary_mod()
          send_proto_to_pane(pane, proto::ClientMsg::Key(0, 0, true, "v", "KeyV", s, dm))
          send_proto_to_pane(pane, proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
          return true
        }
        _ => if pane >= 0 {
          let dm = dom_primary_mod()
          send_proto_to_pane(pane, proto::ClientMsg::Key(0, 0, true, "v", "KeyV", s, dm))
          send_proto_to_pane(pane, proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
          return true
        }
      }
    }
    return false
  }
  // kind == 2: unmarkText always clears any residual page IME composition BEFORE checking focus.
  if kind == 2 {
    shell_end_page_ime_composition()
    return false
  }
  // Positive page focus ownership for IME preedit (kind == 1) & commit (kind == 0):
  // Chrome fields, blocking overlays, and focused non-Stage shell buttons never leak IME to web Stage.
  if is_chrome_field_focused() || shell_has_blocking_exclusive_overlay() {
    shell_end_page_ime_composition()
    return false
  }
  // kind == 1: setMarkedText (CJK IME composition preedit)
  if kind == 1 {
    let pane = shell_page_focus_owner_pane()
    if pane < 0 {
      return false
    }
    if s != "" {
      if !app_state.ime_composing {
        app_state.ime_composing = true
        shell_adapter.ime_owner_pane = pane
        send_proto_to_pane(
          shell_adapter.ime_owner_pane,
          proto::ClientMsg::EditInput(0, 0, "", 0, 0, proto::EDIT_COMPOSING),
        )
      }
      let owner = shell_adapter.ime_owner_pane
      send_proto_to_pane(owner, proto::ClientMsg::EditInput(0, 0, s, 1, 0, proto::EDIT_COMPOSING))
    } else if app_state.ime_composing {
      shell_end_page_ime_composition()
    }
    return false
  }
  // kind == 0: insertText (commit text; dispatch compose_end to the original IME owner pane)
  if kind == 0 && app_state.ime_composing {
    let owner = shell_adapter.ime_owner_pane
    app_state.ime_composing = false
    shell_adapter.ime_owner_pane = -1
    send_proto_to_pane(owner, proto::ClientMsg::EditInput(0, 0, s, 2, 0, proto::EDIT_COMPOSING))
    match ui::focused_field_now() {
      Some(f) if f.focused() && f.paste_limit == 1 => {
        f.compose("")
        return true
      }
      _ => return false
    }
  }
  false
}

///| Returns true when a blocking Exclusive overlay (modal/drawer/popover/menu) is open
///| so clipboard paste or IME text is NEVER leaked to the underlying web Stage.
fn shell_has_blocking_exclusive_overlay() -> Bool {
  let ex = shell_adapter.exclusive.untracked()
  let shell_owned_open = match ex.active {
    shell_ui::ExclusiveKind::Menu | shell_ui::ExclusiveKind::Drawer | shell_ui::ExclusiveKind::SidebarDrawer | shell_ui::ExclusiveKind::Dialog | shell_ui::ExclusiveKind::OmniboxSuggest =>
    ex.tag == "shell_menu" || ex.tag == "shell_drawer" || ex.tag == "shell_sidebar_drawer" || ex.tag == "shell_dialog" || ex.tag == "shell_omnibox"
    _ => false
  }
  shell_owned_open ||
  shell_sig_is_true(app_state.mru_open) ||
  shell_sig_is_true(app_state.tab_search_open) ||
  shell_sig_is_true(app_state.command_bar_open) ||
  shell_sig_is_true(app_state.omnibox_open) ||
  shell_sig_is_true(app_state.page_ctx_open) ||
  shell_sig_is_true(app_state.nav_hist_open) ||
  shell_sig_is_true(app_state.bm_bar_ctx_open) ||
  shell_sig_is_true(app_state.tab_ctx_open) ||
  shell_sig_is_true(app_state.folder_ctx_open) ||
  shell_sig_is_true(app_state.zoom_popover_open) ||
  shell_sig_is_true(app_state.idn_popover_open) ||
  shell_sig_is_true(app_state.site_info_open) ||
  shell_sig_is_true(app_state.media_hub_open) ||
  shell_sig_is_true(app_state.shortcuts_open) ||
  shell_sig_is_true(app_state.cookies_open) ||
  shell_sig_is_true(app_state.downloads_open) ||
  shell_sig_is_true(app_state.history_open) ||
  shell_sig_is_true(app_state.bookmarks_open) ||
  shell_sig_is_true(app_state.boosts_open) ||
  shell_sig_is_true(app_state.settings_open) ||
  shell_sig_is_true(app_state.space_theme_open) ||
  shell_sig_is_true(app_state.spaces_manager_open) ||
  shell_sig_is_true(app_state.closed_tabs_open) ||
  shell_sig_is_true(app_state.print_pdf_open) ||
  shell_sig_is_true(app_state.sessions_open) ||
  shell_sig_is_true(app_state.folder_create_open)
}

fn shell_field_opt_composing(f_opt : Option[ui::Field]) -> Bool {
  match f_opt {
    Some(f) => f.focused() && f.composing()
    None => false
  }
}

///| Layer 0 IME composition guard: returns true when page IME or a *focused* Chrome
///| `ui::Field` has an active preedit composition.
fn is_ime_composing_active() -> Bool {
  if app_state.ime_composing {
    return true
  }
  match ui::focused_field_now() {
    Some(f) if f.focused() && f.composing() => return true
    _ => ()
  }
  shell_field_opt_composing(app_state.address_field) ||
  shell_field_opt_composing(app_state.find_field) ||
  shell_field_opt_composing(app_state.command_bar_field) ||
  shell_field_opt_composing(app_state.tab_search_field) ||
  shell_field_opt_composing(app_state.tab_filter_field) ||
  shell_field_opt_composing(app_state.history_field) ||
  shell_field_opt_composing(app_state.bookmarks_field) ||
  shell_field_opt_composing(app_state.downloads_field) ||
  shell_field_opt_composing(app_state.cookies_field) ||
  shell_field_opt_composing(app_state.space_name_field) ||
  shell_field_opt_composing(app_state.folder_name_field) ||
  shell_field_opt_composing(app_state.folder_create_field) ||
  shell_field_opt_composing(app_state.sessions_name_field) ||
  shell_field_opt_composing(app_state.sessions_filter_field) ||
  shell_field_opt_composing(app_state.boosts_css_field) ||
  shell_field_opt_composing(app_state.start_page_field) ||
  shell_field_opt_composing(app_state.devtools_repl_field) ||
  shell_field_opt_composing(app_state.devtools_net_search_field) ||
  shell_field_opt_composing(app_state.closed_tabs_field) ||
  shell_field_opt_composing(app_state.spaces_new_field) ||
  shell_field_opt_composing(app_state.spaces_rename_field) ||
  shell_field_opt_composing(shell_adapter.settings_filter_field)
}

///| Returns true only for unmodified / shift-only IME composition editing keys
///| (`Escape`, `Enter`, `Tab`, Arrows, `Backspace`, `Delete`). Shortcuts with
///| `Cmd`/`Ctrl` (`⌘T`, `⌘Y`, `⌘W`, etc.) are NEVER blocked by Layer 0 IME guard.
fn is_ime_guarded_key(code : Int, mods : Int) -> Bool {
  if (mods & (ui::mod_cmd | ui::mod_ctrl)) != 0 {
    return false
  }
  code == proto::KEY_ESCAPE ||
  code == proto::KEY_ENTER ||
  code == proto::KEY_TAB ||
  code == proto::KEY_UP ||
  code == proto::KEY_DOWN ||
  code == proto::KEY_LEFT ||
  code == proto::KEY_RIGHT ||
  code == ui::key_code_backspace ||
  code == ui::key_code_delete
}

fn shell_sig_is_true(s_opt : Option[signals::Signal[Bool]]) -> Bool {
  match s_opt {
    Some(s) => s.untracked()
    None => false
  }
}

///| Closes omnibox, restores the active pane's safe display URL into the address bar,
///| blurs the address field, and returns focus to the active pane Stage in a single `Escape` press.
fn shell_dismiss_omnibox_and_restore_address() -> Unit {
  close_omnibox()
  match app_state.omnibox_editing {
    Some(ed) => if ed.untracked() { ed.set(false) }
    None => ()
  }
  match app_state.address_field {
    Some(addr) => {
      if app_state.stage.is_some() {
        app_state.syncing_address_url = true
        addr.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
        app_state.syncing_address_url = false
      }
      if addr.focused() {
        addr.let_go()
      }
    }
    None => ()
  }
  shell_focus_pane_stage(shell_adapter.page.untracked().active_pane)
}

fn shell_is_overlay_tag_open(tag : String) -> Bool {
  if tag == "shell_menu" || tag == "shell_drawer" || tag == "shell_sidebar_drawer" || tag == "shell_dialog" || tag == "shell_omnibox" {
    let ex = shell_adapter.exclusive.untracked()
    ex.is_open() && ex.tag == tag
  } else if tag == "command_bar" {
    shell_sig_is_true(app_state.command_bar_open)
  } else if tag == "omnibox" {
    shell_sig_is_true(app_state.omnibox_open)
  } else if tag == "site_info" {
    shell_sig_is_true(app_state.site_info_open)
  } else if tag == "cookies" {
    shell_sig_is_true(app_state.cookies_open)
  } else if tag == "downloads" {
    shell_sig_is_true(app_state.downloads_open)
  } else if tag == "history" {
    shell_sig_is_true(app_state.history_open)
  } else if tag == "bookmarks" {
    shell_sig_is_true(app_state.bookmarks_open)
  } else if tag == "boosts" {
    shell_sig_is_true(app_state.boosts_open)
  } else if tag == "settings" {
    shell_sig_is_true(app_state.settings_open)
  } else if tag == "space_theme" {
    shell_sig_is_true(app_state.space_theme_open)
  } else if tag == "spaces_manager" {
    shell_sig_is_true(app_state.spaces_manager_open)
  } else if tag == "closed_tabs" {
    shell_sig_is_true(app_state.closed_tabs_open)
  } else if tag == "print_pdf" {
    shell_sig_is_true(app_state.print_pdf_open)
  } else if tag == "tab_ctx" {
    shell_sig_is_true(app_state.tab_ctx_open)
  } else if tag == "zoom_popover" {
    shell_sig_is_true(app_state.zoom_popover_open)
  } else if tag == "folder_ctx" {
    shell_sig_is_true(app_state.folder_ctx_open)
  } else if tag == "shortcuts" {
    shell_sig_is_true(app_state.shortcuts_open)
  } else if tag == "mru" {
    shell_sig_is_true(app_state.mru_open)
  } else if tag == "page_ctx" {
    shell_sig_is_true(app_state.page_ctx_open)
  } else if tag == "nav_hist" {
    shell_sig_is_true(app_state.nav_hist_open)
  } else if tag == "media_hub" {
    shell_sig_is_true(app_state.media_hub_open)
  } else if tag == "idn_popover" {
    shell_sig_is_true(app_state.idn_popover_open)
  } else if tag == "bm_bar_ctx" {
    shell_sig_is_true(app_state.bm_bar_ctx_open)
  } else if tag == "sessions" {
    shell_sig_is_true(app_state.sessions_open)
  } else if tag == "folder_create" {
    shell_sig_is_true(app_state.folder_create_open)
  } else if tag == "tab_search" {
    shell_sig_is_true(app_state.tab_search_open)
  } else {
    false
  }
}

///| Dismisses the foreground active Exclusive overlay first (`active_overlay_tag`),
///| then falls back to scanning foreground Exclusive signals, and checks background
///| sidebar `tab_filter` strictly AFTER all foreground Exclusive overlays.
///| Silently reconciles stale adapter state and returns `false` so `Escape` is NEVER ghost-swallowed.
fn shell_dismiss_active_exclusive() -> Bool {
  // (Escape while Site Boosts' Zap is picking ends Zap and keeps the panel, wherever focus is: after a tap on the
  // page the key reaches here, not the panel; the next Escape closes it)
  if shell_sig_is_true(app_state.boosts_open) && boost_zap_active() {
    dispatch_boost_zap(false)
    return true
  }
  let active_tag = shell_adapter.active_overlay_tag
  if active_tag != "" && shell_is_overlay_tag_open(active_tag) {
    return shell_close_overlay_by_tag(active_tag)
  }
  if shell_sig_is_true(app_state.mru_open) {
    close_mru_switcher()
    return true
  }
  if shell_sig_is_true(app_state.tab_search_open) {
    close_tab_search()
    return true
  }
  if shell_sig_is_true(app_state.command_bar_open) {
    close_command_bar()
    return true
  }
  if shell_sig_is_true(app_state.omnibox_open) {
    shell_dismiss_omnibox_and_restore_address()
    return true
  }
  if shell_sig_is_true(app_state.page_ctx_open) {
    close_page_ctx()
    return true
  }
  if shell_sig_is_true(app_state.nav_hist_open) {
    close_nav_hist()
    return true
  }
  if shell_sig_is_true(app_state.bm_bar_ctx_open) {
    close_bm_bar_ctx()
    return true
  }
  if shell_sig_is_true(app_state.tab_ctx_open) {
    close_tab_ctx()
    return true
  }
  if shell_sig_is_true(app_state.folder_ctx_open) {
    close_folder_ctx()
    return true
  }
  if shell_sig_is_true(app_state.zoom_popover_open) {
    close_zoom_popover()
    return true
  }
  if shell_sig_is_true(app_state.idn_popover_open) {
    close_idn_popover()
    return true
  }
  if shell_sig_is_true(app_state.site_info_open) {
    close_site_info()
    return true
  }
  if shell_sig_is_true(app_state.media_hub_open) {
    close_media_hub()
    return true
  }
  if shell_sig_is_true(app_state.shortcuts_open) {
    close_shortcuts()
    return true
  }
  if shell_sig_is_true(app_state.cookies_open) {
    close_cookies_modal()
    return true
  }
  if shell_sig_is_true(app_state.downloads_open) {
    close_downloads()
    return true
  }
  if shell_sig_is_true(app_state.history_open) {
    close_history()
    return true
  }
  if shell_sig_is_true(app_state.bookmarks_open) {
    close_bookmarks()
    return true
  }
  if shell_sig_is_true(app_state.boosts_open) {
    close_boosts()
    return true
  }
  if shell_sig_is_true(app_state.settings_open) {
    close_settings()
    return true
  }
  if shell_sig_is_true(app_state.space_theme_open) {
    close_space_theme()
    return true
  }
  if shell_sig_is_true(app_state.spaces_manager_open) {
    close_spaces_manager()
    return true
  }
  if shell_sig_is_true(app_state.closed_tabs_open) {
    close_closed_tabs_modal()
    return true
  }
  if shell_sig_is_true(app_state.print_pdf_open) {
    close_print_pdf_modal()
    return true
  }
  if shell_sig_is_true(app_state.sessions_open) {
    close_sessions_modal()
    return true
  }
  if shell_sig_is_true(app_state.folder_create_open) {
    close_folder_create_bar()
    return true
  }
  // Background sidebar tab filter runs strictly AFTER all foreground Exclusive overlays.
  if shell_sig_is_true(app_state.tab_filter_open) {
    close_tab_filter()
    return true
  }
  // Silently reconcile stale adapter state without swallowing Escape.
  let cur = shell_adapter.exclusive.untracked()
  if cur.is_open() {
    shell_adapter.leaving_overlay_tag = shell_adapter.active_overlay_tag
    shell_adapter.active_overlay_tag = ""
    shell_adapter.nested_overlay_tag = ""
    shell_adapter.exclusive.set(cur.begin_close())
  }
  false
}

///| Closes the find bar (Escape's step) and gives the keyboard back to the active pane's page.
fn shell_dismiss_find_bar() -> Unit {
  match app_state.stage {
    Some(_) => close_find_bar(active_find_stage())
    None => {
      match app_state.find_open {
        Some(s) => s.set(false)
        None => ()
      }
      match app_state.find_field {
        Some(ff) => ff.let_go()
        None => ()
      }
      shell_sync_dock_from_app()
    }
  }
  shell_focus_pane_stage(shell_adapter.page.untracked().active_pane)
}

///| Single deterministic Escape dismissal order for Shell 2.0 Phase 1a:
///|   1. `nested` Exclusive child overlay (keeps parent Exclusive open)
///|   2. active `Exclusive` overlay (with full omnibox URL restore & blur)
///|   3. `Peek` preview (Layer 2)
///|   4. `ReaderMode` surface (Layer 2)
///|   5. `FindBar` dock (Layer 1)
///|   6. interactive `Passive` (`CaptureSheet`, Layer 4)
///|   7. focused address field (restores safe URL & blurs)
///| Escape (the key, the shell's EscapePressed, the stage's act_escape): the topmost layer closed as a person's act,
///| told as a transition within the window, so every surface mounted with `show(..., leave=)` (panels, popovers,
///| dialogs, Peek, Reader, context menus) plays its MO_POP_OUT_MS way out, the same as a click on its Close or its
///| scrim. Surfaces that close at once (the command bar, the address palette, MRU) mount without a leave and still go
///| at once.
fn dismiss_topmost_layer() -> Bool {
  // 0. A tab held in a sidebar drag is put back first (the layer under it stays open).
  if shell_ui::shell_tab_drag_cancel() {
    return true
  }
  let handled = ui::ref_new(false)
  match app_state.root_view {
    Some(rv) => view::transition(fn() { handled.v = dismiss_topmost_layer_now() }, within=rv)
    None => handled.v = dismiss_topmost_layer_now()
  }
  handled.v
}

fn dismiss_topmost_layer_now() -> Bool {
  // 1. Nested Exclusive child overlay
  let exc = shell_adapter.exclusive.untracked()
  if !(exc.nested is shell_ui::ExclusiveKind::None) {
    let ntag = shell_adapter.nested_overlay_tag
    if ntag != "" {
      let _ = shell_close_overlay_by_tag(ntag)
    }
    shell_adapter.nested_overlay_tag = ""
    let after_n = shell_adapter.exclusive.untracked()
    if !(after_n.nested is shell_ui::ExclusiveKind::None) {
      shell_adapter.exclusive.set(after_n.begin_close())
    }
    return true
  }
  // 2. Active Exclusive overlay (each close_* atomically updates shell_adapter.exclusive)
  if shell_dismiss_active_exclusive() {
    shell_focus_pane_stage(shell_adapter.page.untracked().active_pane)
    return true
  }
  // 2b. A sidebar mode (Create a Space: its theme editor first; the Library): back to the tabs
  if sidebar_modes.escape() {
    return true
  }
  // 2c. The find bar the person is typing in: it was opened over the page (Peek, Reader or not), so it goes
  // first; a find bar left open while focus is elsewhere waits for step 5.
  if is_find_bar_open() && is_find_field_focused() {
    shell_dismiss_find_bar()
    return true
  }
  // 3. Peek preview
  if is_peek_open() {
    close_peek_preview()
    shell_focus_pane_stage(shell_ui::PaneId::Primary)
    return true
  }
  // 4. Reader mode
  if shell_sig_is_true(app_state.reader_open) {
    close_reader_mode()
    shell_focus_pane_stage(shell_adapter.page.untracked().active_pane)
    return true
  }
  // 5. Find bar
  if is_find_bar_open() {
    shell_dismiss_find_bar()
    return true
  }
  // 6. Interactive Passive (CaptureSheet)
  if shell_sig_is_true(app_state.capture_sheet_open) {
    close_capture_sheet()
    shell_focus_pane_stage(shell_adapter.page.untracked().active_pane)
    return true
  }
  // 7. Focused address bar without dropdown
  match app_state.address_field {
    Some(addr) if addr.focused() || shell_sig_is_true(app_state.omnibox_editing) => {
      shell_dismiss_omnibox_and_restore_address()
      return true
    }
    _ => ()
  }
  false
}

///| Layer 1 active Exclusive control key routing (Escape via `dismiss_topmost_layer` first
///| so `nested` always beats its parent Exclusive, then MRU / TabSearch / CommandBar / Omnibox keys).
fn handle_layer1_exclusive_key(code : Int, mods : Int) -> Bool {
  if shell_sig_is_true(app_state.mru_open) {
    // The switcher is used with Ctrl held: Escape cancels with any modifiers (and disarms, so letting Ctrl go
    // afterwards switches nothing); the arrows step the one strip with no modifiers, Ctrl or Ctrl+Shift.
    if code == proto::KEY_ESCAPE {
      close_mru_switcher()
      return true
    }
    if code == proto::KEY_ENTER && mods == 0 {
      commit_mru_switcher()
      return true
    }
    let ctrl = proto::SHORTCUT_MOD_CTRL
    let step_mods = mods == 0 || mods == ctrl || mods == (ctrl | proto::SHORTCUT_MOD_SHIFT)
    if step_mods && (code == proto::KEY_RIGHT || code == proto::KEY_DOWN) {
      open_or_step_mru_switcher(1)
      return true
    }
    if step_mods && (code == proto::KEY_LEFT || code == proto::KEY_UP) {
      open_or_step_mru_switcher(-1)
      return true
    }
  }
  if code == proto::KEY_ESCAPE && mods == 0 {
    return dismiss_topmost_layer()
  }
  if shell_sig_is_true(app_state.tab_search_open) {
    if code == proto::KEY_ENTER && mods == 0 {
      commit_tab_search_selection()
      return true
    }
    if code == proto::KEY_DOWN && mods == 0 {
      step_tab_search_selection(1)
      return true
    }
    if code == proto::KEY_UP && mods == 0 {
      step_tab_search_selection(-1)
      return true
    }
  }
  if shell_sig_is_true(app_state.command_bar_open) {
    if code == proto::KEY_DOWN && mods == 0 {
      let _ = step_command_bar_selection(1)
      return true
    }
    if code == proto::KEY_UP && mods == 0 {
      let _ = step_command_bar_selection(-1)
      return true
    }
  }
  if shell_sig_is_true(app_state.omnibox_open) {
    if code == proto::KEY_DOWN && mods == 0 {
      return step_omnibox_selection(1)
    }
    if code == proto::KEY_UP && mods == 0 {
      return step_omnibox_selection(-1)
    }
  }
  false
}

// ============================================================================
// 7. Non-UI Shell Helpers (migrated from deleted `shell_dock_view.pion`)
// ============================================================================

fn current_mini_player_state() -> proto::MiniPlayerState {
  let snap = effective_media_hub_snapshot()
  let prev = proto::MiniPlayerState::{
    active: app_state.mini_player_dismissed_tab != "",
    dismissed: app_state.mini_player_dismissed_tab != "",
    tab_id: app_state.mini_player_dismissed_tab,
    title: "",
    domain: "",
    url: "",
    playing: false,
    muted: false,
    is_live: false,
    duration_secs: 0,
    position_secs: 0,
  }
  prev.sync_from_snapshot(snap, app_state.workspace.active_tab_id)
}

fn dismiss_shell_mini_player(tab_id : String) -> Unit {
  let tid = tab_id.trim()
  app_state.mini_player_dismissed_tab = if tid != "" { tid } else { "__dismissed__" }
  let sessions = app_state.media_hub_snap.sessions
  let next : Array[proto::MediaSessionItem] = []
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    if (tid != "" && s.tab_id == tid) || (tid == "" && i == 0) {
      next.push(proto::MediaSessionItem::{ ..s, playing: false })
    } else {
      next.push(s)
    }
    i = i + 1
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: next }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.mini_player_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  if tid != "" {
    send_wire(wire::Message::Act("media_toggle_play", tid, ""))
  }
}

fn execute_omni_suggest_item(st : stage::Stage, item : proto::OmniSuggestItem) -> Unit {
  // A command row (the Command Bar's catalog): close the palette, restore the address, run it.
  if item.category is proto::OmniSuggestCategory::Action {
    shell_dismiss_omnibox_and_restore_address()
    execute_command_bar_item(st, proto::CommandBarItem::{
      kind: proto::CommandKind::Action,
      id: item.url,
      title: item.title,
      subtitle: "",
      badge: "",
      shortcut: item.subtitle,
      monogram: "",
      accent: 0L,
      is_tab: false,
      is_space: false,
    })
    return
  }
  if item.category is proto::OmniSuggestCategory::Calc {
    let copy_v = item.url.trim()
    close_omnibox()
    match app_state.omnibox_editing {
      Some(ed) => if ed.untracked() { ed.set(false) }
      None => ()
    }
    match app_state.address_field {
      Some(addr) => addr.let_go()
      None => ()
    }
    if copy_v != "" {
      write_os_clipboard(copy_v)
      show_toast("Copied " + copy_v, "copy")
    }
    return
  }
  let target = item.url.trim()
  let new_tab = app_state.omnibox_new_tab
  let is_switch = item.category is proto::OmniSuggestCategory::SwitchTab
  let tab_id = item.tab_id
  close_omnibox()
  match app_state.omnibox_editing {
    Some(ed) => if ed.untracked() { ed.set(false) }
    None => ()
  }
  match app_state.address_field {
    Some(addr) => {
      if target != "" {
        app_state.syncing_address_url = true
        addr.set(proto::omnibox_safe_display_url(target))
        app_state.syncing_address_url = false
      }
      addr.let_go()
    }
    None => ()
  }
  if is_switch {
    if tab_id != "" {
      dispatch_tab_switch(tab_id)
      return
    }
    match find_open_tab_id_for_url(target) {
      Some(tid) => {
        dispatch_tab_switch(tid)
        return
      }
      None => ()
    }
  }
  omnibox_go(st, target, new_tab)
}
