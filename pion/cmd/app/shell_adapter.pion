// 7. Non-UI Shell Helpers (migrated from deleted `shell_dock_view.pion`)
// ============================================================================

fn current_mini_player_state() -> proto::MiniPlayerState {
  let snap = effective_media_hub_snapshot()
  let prev = proto::MiniPlayerState::{
    active: app_state.mini_player_dismissed_tab != "",
    dismissed: app_state.mini_player_dismissed_tab != "",
    tab_id: app_state.mini_player_dismissed_tab,
    title: "",
    domain: "",
    url: "",
    playing: false,
    muted: false,
    is_live: false,
    duration_secs: 0,
    position_secs: 0,
  }
  prev.sync_from_snapshot(snap, app_state.workspace.active_tab_id)
}

fn dismiss_shell_mini_player(tab_id : String) -> Unit {
  let tid = tab_id.trim()
  app_state.mini_player_dismissed_tab = if tid != "" { tid } else { "__dismissed__" }
  let sessions = app_state.media_hub_snap.sessions
  let next : Array[proto::MediaSessionItem] = []
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    if (tid != "" && s.tab_id == tid) || (tid == "" && i == 0) {
      next.push(proto::MediaSessionItem::{ ..s, playing: false })
    } else {
      next.push(s)
    }
    i = i + 1
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: next }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.mini_player_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  if tid != "" {
    send_wire(wire::Message::Act("media_toggle_play", tid, ""))
  }
}

fn execute_omni_suggest_item(st : stage::Stage, item : proto::OmniSuggestItem) -> Unit {
  if item.category is proto::OmniSuggestCategory::Calc {
    let copy_v = item.url.trim()
    close_omnibox()
    match app_state.omnibox_editing {
      Some(ed) => if ed.untracked() { ed.set(false) }
      None => ()
    }
    match app_state.address_field {
      Some(addr) => addr.let_go()
      None => ()
    }
    if copy_v != "" {
      write_os_clipboard(copy_v)
      show_toast("Copied " + copy_v, "copy")
    }
    return
  }
  let target = item.url.trim()
  let is_switch = item.category is proto::OmniSuggestCategory::SwitchTab
  let tab_id = item.tab_id
  close_omnibox()
  match app_state.omnibox_editing {
    Some(ed) => if ed.untracked() { ed.set(false) }
    None => ()
  }
  match app_state.address_field {
    Some(addr) => {
      if target != "" {
        app_state.syncing_address_url = true
        addr.set(proto::omnibox_safe_display_url(target))
        app_state.syncing_address_url = false
      }
      addr.let_go()
    }
    None => ()
  }
  if is_switch {
    if tab_id != "" {
      dispatch_tab_switch(tab_id)
      return
    }
    match find_open_tab_id_for_url(target) {
      Some(tid) => {
        dispatch_tab_switch(tid)
        return
      }
      None => ()
    }
  }
  if target != "" {
    st.go(target)
  }
}
