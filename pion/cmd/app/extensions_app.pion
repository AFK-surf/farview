///| The app's side of extensions: the host's `ExtensionsState` (tag 70) kept and told to the shell, the `ext_*`
///| verbs sent (with the toggle / pin / removal shown at once, before the host answers), the toolbar's pinned
///| extension faces, the popover a press on one opens, and Settings > Extensions.

struct ExtAppState {
  mut snap : proto::ExtensionsUiSnapshot
  mut rev : Option[signals::Signal[Int]]
  ///| the extension whose popover is open ("" when none)
  mut open_id : Option[signals::Signal[String]]
  mut path_field : Option[ui::Field]
}

let ext_app : ExtAppState = ExtAppState::{ snap: proto::ExtensionsUiSnapshot::empty(), rev: None, open_id: None, path_field: None }

fn ext_app_rev() -> signals::Signal[Int] {
  match ext_app.rev {
    Some(s) => s
    None => {
      let s = signals::signal(0)
      ext_app.rev = Some(s)
      s
    }
  }
}

fn ext_app_open_id() -> signals::Signal[String] {
  match ext_app.open_id {
    Some(s) => s
    None => {
      let s = signals::signal("")
      ext_app.open_id = Some(s)
      s
    }
  }
}

fn ext_app_path_field() -> ui::Field {
  match ext_app.path_field {
    Some(f) => f
    None => {
      let f = ui::Field::new()
      ext_app.path_field = Some(f)
      f
    }
  }
}

///| The extensions as the shell shows them (tracked: a view reading it follows every change).
fn ext_app_snapshot() -> proto::ExtensionsUiSnapshot {
  let _ = ext_app_rev().get()
  ext_app.snap
}

fn ext_app_set_snapshot(snap : proto::ExtensionsUiSnapshot) -> Unit {
  ext_app.snap = snap
  let r = ext_app_rev()
  r.set(r.untracked() + 1)
}

fn set_host_extensions_state(json : String) -> Unit {
  match proto::parse_extensions_ui_snapshot(json) {
    Some(snap) => {
      ext_app_set_snapshot(snap)
      // (an extension the popover shows that went away, or left the toolbar: the popover goes with it)
      let open_id = ext_app_open_id().untracked()
      if open_id != "" {
        match proto::extensions_find(snap, open_id) {
          Some(it) if it.enabled => ()
          _ => close_extension_popup()
        }
      }
    }
    None => ()
  }
}

fn dispatch_extensions_sync() -> Unit {
  send_wire(wire::Message::Act("ext_list", "", ""))
}

fn ext_app_send(verb : String, a : String, b : String) -> Unit {
  send_wire(wire::Message::Act(verb, a, b))
}

fn ext_app_toggle(id : String, on : Bool) -> Unit {
  match proto::extensions_find(ext_app.snap, id) {
    Some(it) => ext_app_set_snapshot(proto::extensions_with_item(ext_app.snap, proto::ExtensionUiItem::{ ..it, enabled: on }))
    None => ()
  }
  ext_app_send("ext_toggle", id, if on { "true" } else { "false" })
}

fn ext_app_pin(id : String, on : Bool) -> Unit {
  match proto::extensions_find(ext_app.snap, id) {
    Some(it) => ext_app_set_snapshot(proto::extensions_with_item(ext_app.snap, proto::ExtensionUiItem::{ ..it, pinned: on }))
    None => ()
  }
  if !on && ext_app_open_id().untracked() == id {
    close_extension_popup()
  }
  ext_app_send("ext_pin", id, if on { "true" } else { "false" })
}

fn ext_app_remove(id : String) -> Unit {
  ext_app_set_snapshot(proto::extensions_without(ext_app.snap, id))
  if ext_app_open_id().untracked() == id {
    close_extension_popup()
  }
  ext_app_send("ext_remove", id, "")
}

///| Settings > Extensions, opened from the More menu, the toolbar's Extensions face or the popover.
fn open_extensions_manager() -> Unit {
  close_extension_popup()
  open_settings()
  match app_state.settings_tab {
    Some(t) => t.set(shell_ui::SETTINGS_TAB_EXTENSIONS)
    None => ()
  }
  dispatch_extensions_sync()
}

fn close_extension_popup() -> Unit {
  let s = ext_app_open_id()
  if s.untracked() != "" {
    s.set("")
    shell_mark_exclusive_closed("extension_popup")
  }
}

///| A press on a pinned extension's toolbar face: its popover when it has a popup page (Chrome opens the popup),
///| and the host told either way (it grants `activeTab`, and without a popup fires `chrome.action.onClicked`).
fn ext_app_press(id : String) -> Unit {
  let was_open = ext_app_open_id().untracked() == id
  match proto::extensions_find(ext_app.snap, id) {
    Some(it) if it.has_popup && !was_open => {
      close_exclusive_overlays()
      ext_app_open_id().set(id)
      shell_mark_exclusive_open(shell_ui::ExclusiveKind::Popover, "extension_popup")
    }
    _ => close_extension_popup()
  }
  if !was_open {
    ext_app_send("ext_open_popup", id, "")
  }
}

fn build_extensions_panel_props() -> shell_ui::ExtensionsPanelProps {
  shell_ui::ExtensionsPanelProps::{
    snapshot: fn() { ext_app_snapshot() },
    on_toggle: fn(id, on) { ext_app_toggle(id, on) },
    on_pin: fn(id, on) { ext_app_pin(id, on) },
    on_remove: fn(id) { ext_app_remove(id) },
    on_options: fn(id) {
      close_settings()
      ext_app_send("ext_open_options", id, "")
    },
    path_field: ext_app_path_field(),
    on_load_unpacked: fn(path) { ext_app_send("ext_load_unpacked", path, "") },
    on_install_crx: fn(path) { ext_app_send("ext_load_crx3", path, "") },
  }
}

///| The pinned extensions' faces, in the Address Bar's trailing slot (nothing there until one is pinned).
fn build_extension_toolbar_slot(pill : view::View) -> Unit {
  shell_ui::build_extension_toolbar(
    pill,
    shell_ui::ExtensionToolbarProps::{
      items: fn() { proto::extensions_pinned_items(ext_app_snapshot()) },
      on_press: fn(id, _rect) { ext_app_press(id) },
      on_manage: fn() { open_extensions_manager() },
      open_id: fn() { ext_app_open_id().get() },
    },
    always_manage=false,
  )
}

///| The popover of the pressed extension, anchored under its face.
fn build_extension_popup_overlay(root : view::View, fallback_capsule : () -> shell_ui::AnchorRect) -> Unit {
  shell_ui::build_extension_popup_popover(
    root,
    shell_ui::ExtensionPopupProps::{
      open: fn() { ext_app_open_id().get() != "" },
      item: fn() { proto::extensions_find(ext_app_snapshot(), ext_app_open_id().get()) },
      trigger_anchor: fn() { shell_ui::extension_toolbar_anchor(ext_app_open_id().get()) },
      fallback_capsule,
      on_open_popup: fn(url) {
        close_extension_popup()
        ext_app_send("ext_open_tab", url, "")
      },
      on_options: fn(id) {
        close_extension_popup()
        ext_app_send("ext_open_options", id, "")
      },
      on_unpin: fn(id) { ext_app_pin(id, false) },
      on_manage: fn() { open_extensions_manager() },
      on_close: fn() { close_extension_popup() },
    },
  )
}
