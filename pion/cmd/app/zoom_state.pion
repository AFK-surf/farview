///| Page zoom per site and the zoom bubble (no UI here: `shell_ui::build_zoom_bubble` draws it).
///|
///| A zoom a person picks is kept for the page's site (`proto::site_zoom_*`, saved in the settings), shown on every
///| pane of that site, and applied again whenever a pane lands on it; any other site is shown at the default zoom.

///| The zoom bubble shows (after a zoom from the keyboard, a menu or the Command Bar).
let zoom_bubble_open : signals::Signal[Bool] = signals::signal(false)

///| Counts the bubble's shows, so only the newest timer lets it go; and whether the pointer holds it.
let zoom_bubble_seq : signals::Ref[Int] = signals::ref_new(0)

let zoom_bubble_held : signals::Ref[Bool] = signals::ref_new(false)

///| How long the bubble stays after the last zoom (or after the pointer leaves it), ms.
let ZOOM_BUBBLE_MS : Double = 2000.0

///| The pane a person's zoom acts on: the active one (the split's second page when it is active).
fn zoom_active_pane() -> Int {
  if active_targets_split() { 1 } else { 0 }
}

///| The stage shown in `pane` now (pane 1: the split's second page or Peek), if there is one.
fn zoom_pane_stage(pane : Int) -> Option[stage::Stage] {
  if pane == 1 {
    if is_split_open() || is_peek_open() { app_state.split_stage } else { None }
  } else {
    app_state.stage
  }
}

fn pane_base_wh(pane : Int) -> String {
  match if pane == 1 { app_state.split_stage_view } else { app_state.stage_view } {
    Some(sv) => {
      let (bw, bh) = sv.laid_size()
      if bw >= 50.0 && bh >= 50.0 { proto::format_base_wh(bw, bh) } else { "" }
    }
    None => ""
  }
}

///| `st` (in `pane`) zoomed to `target`, and its host told (it lays the page out in the room that zoom leaves).
fn apply_zoom_to_pane(pane : Int, st : stage::Stage, target : Double) -> Unit {
  let z = proto::clamp_zoom(target)
  st.set_zoom(z)
  send_wire_to_pane(pane, wire::Message::Act("zoom", proto::format_zoom_str(z), pane_base_wh(pane)))
}

///| What Reset (Cmd+0, Actual size) goes back to: the default zoom.
fn default_zoom() -> Double {
  (app_state.settings.default_zoom_pct as Double) / 100.0
}

///| A person zoomed the active pane to what `step` makes of its zoom (Cmd+= / Cmd+- / Cmd+0, the View menu, the
///| Command Bar, the zoom controls): it is zoomed, kept for its site, the other pane on that site follows, and
///| (`bubble`) the zoom bubble shows.
fn zoom_act(step : (Double) -> Double, bubble~ : Bool = true) -> Unit {
  let pane = zoom_active_pane()
  let st = pane_stage(pane)
  apply_zoom_to_pane(pane, st, step(st.zoom()))
  remember_site_zoom(pane, st)
  if bubble && !shell_sig_is_true(app_state.zoom_popover_open) {
    zoom_bubble_poke()
  }
}

///| The zoom `st` shows now, kept for its site (dropped when it is the default); the other pane on the same site
///| follows it.
fn remember_site_zoom(pane : Int, st : stage::Stage) -> Unit {
  let key = proto::site_zoom_key(st.url())
  if key == "" {
    return
  }
  let pct = st.zoom_percent()
  let cur = app_state.settings
  let table = proto::site_zoom_with(cur.site_zoom, key, pct, cur.default_zoom_pct)
  if table != cur.site_zoom {
    dispatch_settings_save(proto::BrowserSettings::{ ..cur, site_zoom: table })
  }
  let other = 1 - pane
  match zoom_pane_stage(other) {
    Some(o) if proto::site_zoom_key(o.url()) == key && o.zoom_percent() != pct =>
    apply_zoom_to_pane(other, o, (pct as Double) / 100.0)
    _ => ()
  }
}

///| Each pane shown at its site's zoom (or the default): as a pane lands on another site and as the settings
///| arrive or change. A zoom asked for at start (`--zoom`, a demo) is left as it is.
fn follow_site_zoom() -> Unit {
  if (app_state.initial_zoom - 1.0).abs() > 1.0e-6 || app_state.demo_zoom {
    return
  }
  for pane in [0, 1] {
    match zoom_pane_stage(pane) {
      Some(st) => {
        let pct = proto::site_zoom_effective_pct(app_state.settings, st.url())
        if pct != st.zoom_percent() {
          apply_zoom_to_pane(pane, st, (pct as Double) / 100.0)
        }
      }
      None => ()
    }
  }
}

///| What `follow_site_zoom` follows: the settings and each pane's site (followed).
fn site_zoom_watch() -> String {
  match app_state.settings_rev {
    Some(r) => {
      let _ = r.get()
    }
    None => ()
  }
  let _ = shell_adapter.page.get()
  let main_key = match app_state.stage {
    Some(st) => proto::site_zoom_key(st.url())
    None => ""
  }
  let split_key = match zoom_pane_stage(1) {
    Some(sp) => proto::site_zoom_key(sp.url())
    None => ""
  }
  app_state.settings.default_zoom_pct.to_string() + "|" + app_state.settings.site_zoom + "|" + main_key + "|" +
  split_key
}

// --- The zoom bubble -------------------------------------------------------------------------------------------

///| Shows the zoom bubble (again) and lets it go `ZOOM_BUBBLE_MS` after, unless the pointer is over it then.
fn zoom_bubble_poke() -> Unit {
  zoom_bubble_seq.v = zoom_bubble_seq.v + 1
  if !zoom_bubble_open.untracked() {
    zoom_bubble_open.set(true)
  }
  zoom_bubble_schedule_close()
}

fn zoom_bubble_schedule_close() -> Unit {
  let seq = zoom_bubble_seq.v
  match app_state.root_view {
    Some(rv) => {
      let _ = rv.at_moment(rv.logic_at() + ZOOM_BUBBLE_MS, later=true, fn() -> Unit {
        if zoom_bubble_seq.v == seq && !zoom_bubble_held.v {
          zoom_bubble_close()
        }
      })
    }
    None => ()
  }
}

///| The bubble running out (or put away for another surface): told as a transition, so it plays its way out.
fn zoom_bubble_close() -> Unit {
  zoom_bubble_held.v = false
  if zoom_bubble_open.untracked() {
    match app_state.root_view {
      Some(rv) => view::transition(fn() { zoom_bubble_open.set(false) }, within=rv)
      None => zoom_bubble_open.set(false)
    }
  }
}

///| The pointer over the bubble holds it; leaving it starts the wait again.
fn zoom_bubble_hold(held : Bool) -> Unit {
  zoom_bubble_held.v = held
  if !held && zoom_bubble_open.untracked() {
    zoom_bubble_seq.v = zoom_bubble_seq.v + 1
    zoom_bubble_schedule_close()
  }
}
