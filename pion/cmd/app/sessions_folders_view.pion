// --- 1. Inline Colored Folder Creator (Sidebar Pinned section) ---

fn build_inline_folder_creator(
  parent : view::View,
  folder_create_open : signals::Signal[Bool],
  folder_create_color : signals::Signal[String],
  folder_create_move_active : signals::Signal[Bool],
  folder_create_field : ui::Field,
) -> Unit {
  parent.show(
    fn() -> Bool { folder_create_open.get() },
    fn(card : view::View) -> Unit {
      let _ = card
      .width(view::Live::Is(Some(223.0)))
      .rigid()
      .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
      .gap(view::Live::Is(7.0))
      .radius(view::Live::Is(8.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

      // Row 1: UTF-8 Folder Name input
      let _ = card.box(
        fn(inp_wrap : view::View) -> Unit {
          let _ = inp_wrap
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(28.0)))
          .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          let _ = inp_wrap.box(
            fn(fhost : view::View) -> Unit {
              let _ = fhost
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(20.0)))
              .clips(view::Live::Is(true))
              fhost.show(
                fn() -> Bool { !is_dark_chrome() },
                fn(fl : view::View) -> Unit {
                  let _ = ui::field(
                    fl,
                    folder_create_field,
                    placeholder="Folder name...",
                    font_size=12.0,
                    color=0x1D1D1FFFL,
                    placeholder_color=0x8E8E93FFL,
                    max_lines=1,
                    enter_sends=true,
                    submitted=fn(txt : String) -> Unit {
                      dispatch_folder_create_colored(
                        txt,
                        folder_create_color.untracked(),
                        folder_create_move_active.untracked(),
                      )
                    },
                  )
                },
              )
              fhost.show(
                fn() -> Bool { is_dark_chrome() },
                fn(fd : view::View) -> Unit {
                  let _ = ui::field(
                    fd,
                    folder_create_field,
                    placeholder="Folder name...",
                    font_size=12.0,
                    color=0xF1F5F9FFL,
                    placeholder_color=0x94A3B8FFL,
                    caret_color=0x60A5FAFFL,
                    max_lines=1,
                    enter_sends=true,
                    submitted=fn(txt : String) -> Unit {
                      dispatch_folder_create_colored(
                        txt,
                        folder_create_color.untracked(),
                        folder_create_move_active.untracked(),
                      )
                    },
                  )
                },
              )
            },
          )
        },
      )

      // Row 2: 6 semantic color dots
      let _ = card.box(
        fn(crow : view::View) -> Unit {
          let _ = crow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(6.0))
          let keys = proto::folder_color_keys()
          let mut ci = 0
          while ci < keys.length() {
            let ck = keys[ci]
            let rgba = proto::folder_color_rgba(ck)
            let is_sel = fn() -> Bool { proto::normalize_folder_color(folder_create_color.get()) == ck }
            let _ = headless::button(
              crow,
              fn() -> String { "Folder Color " + proto::folder_color_label(ck) },
              fn(_v : view::View) -> Unit { folder_create_color.set(ck) },
              fn(cb : view::View, _cbtn : headless::Button) -> Unit {
                let _ = cb
                .width(view::Live::Is(Some(18.0)))
                .height(view::Live::Is(Some(18.0)))
                .rigid()
                .center()
                .radius(view::Live::Is(9.0))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  if is_sel() { (1.5, rgba) } else { (1.0, 0x00000000L) }
                }))
                let _ = cb.box(
                  fn(dot : view::View) -> Unit {
                    let _ = dot
                    .width(view::Live::Is(Some(10.0)))
                    .height(view::Live::Is(Some(10.0)))
                    .rigid()
                    .radius(view::Live::Is(5.0))
                    .ground(view::Live::Is(rgba))
                  },
                )
              },
            )
            ci = ci + 1
          }
        },
      )

      // Row 3: Move active tab toggle + Create / Cancel buttons
      let _ = card.box(
        fn(arow : view::View) -> Unit {
          let _ = arow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(6.0))

          let _ = headless::button(
            arow,
            fn() -> String { "Toggle Move Active Tab into Folder" },
            fn(_v : view::View) -> Unit {
              folder_create_move_active.set(!folder_create_move_active.untracked())
            },
            fn(mb : view::View, mbtn : headless::Button) -> Unit {
              let _ = mb
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .grow(view::Live::Is(1.0))
              .height(view::Live::Is(Some(24.0)))
              .gap(view::Live::Is(5.0))
              .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if mbtn.hovered() { p.tab_hover_bg } else { 0x00000000L }
              }))
              let _ = mb.box(
                fn(chk : view::View) -> Unit {
                  let _ = chk
                  .width(view::Live::Is(Some(12.0)))
                  .height(view::Live::Is(Some(12.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(3.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if folder_create_move_active.get() { chrome_palette().accent } else { 0x00000000L }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    if folder_create_move_active.get() { (1.0, chrome_palette().accent) } else { (1.0, chrome_palette().border) }
                  }))
                },
              )
              let _ = mb.box(
                fn(ml : view::View) -> Unit {
                  let _ = ml
                  .words(
                    view::Live::Is("Move tab"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )

          let _ = headless::button(
            arow,
            fn() -> String { "Cancel New Folder" },
            fn(_v : view::View) -> Unit { close_folder_create_bar() },
            fn(xb : view::View, xbtn : headless::Button) -> Unit {
              let _ = xb
              .width(view::Live::Is(Some(24.0)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
              }))
              let _ = xb.box(
                fn(xl : view::View) -> Unit {
                  let _ = xl
                  .words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )

          let _ = headless::button(
            arow,
            fn() -> String { "Create Folder" },
            fn(_v : view::View) -> Unit {
              dispatch_folder_create_colored(
                folder_create_field.text(),
                folder_create_color.untracked(),
                folder_create_move_active.untracked(),
              )
            },
            fn(cb : view::View, cbtn : headless::Button) -> Unit {
              let _ = cb
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if cbtn.pressed() { 0x1D4ED8FFL } else if cbtn.hovered() { 0x2563EBFFL } else { 0x3B82F6FFL }
              }))
              let _ = cb.box(
                fn(cl : view::View) -> Unit {
                  let _ = cl.words(
                    view::Live::Is("Create"),
                    ink=0xFFFFFFFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}

// --- 2. Named Session Snapshots Modal (600pt centered, Light & Dark ChromePalette) ---

fn build_sessions_modal(
  root : view::View,
  sessions_open : signals::Signal[Bool],
  sessions_rev : signals::Signal[Int],
  sessions_name_field : ui::Field,
  sessions_filter_field : ui::Field,
  sessions_filter_query : signals::Signal[String],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { sessions_open.get() },
    fn(layer : view::View) -> Unit {
      let _ = layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))

      // Backdrop scrim
      let _ = headless::button(
        layer,
        fn() -> String { "Dismiss Saved Sessions" },
        fn(_v : view::View) -> Unit { close_sessions_modal() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x00000078L } else { 0x0F172A40L }
          }))
        },
      )

      // Centered 600pt Modal Surface (concentric radii: 14 -> 10 -> 8 -> 6pt)
      let _ = layer.box(
        fn(center_wrap : view::View) -> Unit {
          let _ = center_wrap
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .center()
          .padding(view::Live::Is((24.0, 24.0, 24.0, 24.0)))

          let _ = center_wrap.box(
            fn(modal : view::View) -> Unit {
              let _ = modal
              .width(view::Live::Is(Some(600.0)))
              .max_height(view::Live::Is(Some(620.0)))
              .rigid()
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(14.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
                if is_dark_chrome() { (36.0, 14.0, 0x00000088L) } else { (32.0, 12.0, 0x0F172A2CL) }
              }))

              // Header
              let _ = modal.box(
                fn(hdr : view::View) -> Unit {
                  let _ = hdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(50.0)))
                  .rigid()
                  .padding(view::Live::Is((18.0, 0.0, 14.0, 0.0)))
                  .gap(view::Live::Is(8.0))

                  let _ = hdr.box(
                    fn(ttl : view::View) -> Unit {
                      let _ = ttl
                      .words(
                        view::Live::Is("Saved Sessions"),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )

                  let _ = hdr.box(
                    fn(cnt_pill : view::View) -> Unit {
                      let _ = cnt_pill
                      .height(view::Live::Is(Some(20.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                      let _ = cnt_pill.box(
                        fn(cl : view::View) -> Unit {
                          let _ = cl
                          .words(
                            view::Live::By(fn() -> String {
                              let _ = sessions_rev.get()
                              let n = app_state.sessions_state.items.length()
                              if n == 1 { "1 snapshot" } else { n.to_string() + " snapshots" }
                            }),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )

                  let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

                  let _ = headless::button(
                    hdr,
                    fn() -> String { "Close Saved Sessions" },
                    fn(_v : view::View) -> Unit { close_sessions_modal() },
                    fn(xb : view::View, xbtn : headless::Button) -> Unit {
                      let _ = xb
                      .width(view::Live::Is(Some(26.0)))
                      .height(view::Live::Is(Some(26.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                      }))
                      let _ = xb.box(
                        fn(xl : view::View) -> Unit {
                          let _ = xl
                          .words(
                            view::Live::Is("×"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 16.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )
                },
              )

              // Single hairline below header
              let _ = modal.box(
                fn(sep : view::View) -> Unit {
                  let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )

              // Save Current Session section
              let _ = modal.box(
                fn(save_sec : view::View) -> Unit {
                  let _ = save_sec
                  .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
                  .gap(view::Live::Is(8.0))
                  .rigid()
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

                  // Current workspace summary badges
                  let _ = save_sec.box(
                    fn(meta_row : view::View) -> Unit {
                      let _ = meta_row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .gap(view::Live::Is(6.0))

                      let _ = meta_row.box(
                        fn(lbl : view::View) -> Unit {
                          let _ = lbl
                          .words(
                            view::Live::Is("Current Workspace"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )

                      let _ = meta_row.box(
                        fn(sp_b : view::View) -> Unit {
                          let _ = sp_b
                          .height(view::Live::Is(Some(18.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                          .radius(view::Live::Is(5.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                          let _ = sp_b.box(
                            fn(spl : view::View) -> Unit {
                              let _ = spl
                              .words(
                                view::Live::By(fn() -> String {
                                  let _ = workspace_rev.get()
                                  let n = app_state.workspace.spaces.length()
                                  if n == 1 { "1 space" } else { n.to_string() + " spaces" }
                                }),
                                ink=0x2563EBFFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                            },
                          )
                        },
                      )

                      let _ = meta_row.box(
                        fn(tb_b : view::View) -> Unit {
                          let _ = tb_b
                          .height(view::Live::Is(Some(18.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                          .radius(view::Live::Is(5.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                          let _ = tb_b.box(
                            fn(tbl : view::View) -> Unit {
                              let _ = tbl
                              .words(
                                view::Live::By(fn() -> String {
                                  let _ = workspace_rev.get()
                                  let n = app_state.workspace.tabs.length()
                                  if n == 1 { "1 tab" } else { n.to_string() + " tabs" }
                                }),
                                ink=0x6B7280FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                            },
                          )
                        },
                      )
                    },
                  )

                  // Name input + Save Current Session primary button
                  let _ = save_sec.box(
                    fn(srow : view::View) -> Unit {
                      let _ = srow
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .gap(view::Live::Is(8.0))

                      let _ = srow.box(
                        fn(inp : view::View) -> Unit {
                          let _ = inp
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .height(view::Live::Is(Some(34.0)))
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                          .radius(view::Live::Is(8.0))
                          .clips(view::Live::Is(true))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                          let _ = inp.box(
                            fn(fh : view::View) -> Unit {
                              let _ = fh
                              .grow(view::Live::Is(1.0))
                              .shrink(view::Live::Is(1.0))
                              .basis(view::Live::Is(Some(0.0)))
                              .min_width(view::Live::Is(Some(0.0)))
                              .height(view::Live::Is(Some(22.0)))
                              .clips(view::Live::Is(true))
                              fh.show(
                                fn() -> Bool { !is_dark_chrome() },
                                fn(fl : view::View) -> Unit {
                                  let _ = ui::field(
                                    fl,
                                    sessions_name_field,
                                    placeholder="Snapshot name (e.g. Architecture Research)...",
                                    font_size=12.5,
                                    color=0x1D1D1FFFL,
                                    placeholder_color=0x8E8E93FFL,
                                    max_lines=1,
                                    enter_sends=true,
                                    submitted=fn(txt : String) -> Unit {
                                      dispatch_session_save(txt)
                                      sessions_name_field.set("")
                                    },
                                  )
                                },
                              )
                              fh.show(
                                fn() -> Bool { is_dark_chrome() },
                                fn(fd : view::View) -> Unit {
                                  let _ = ui::field(
                                    fd,
                                    sessions_name_field,
                                    placeholder="Snapshot name (e.g. Architecture Research)...",
                                    font_size=12.5,
                                    color=0xF1F5F9FFL,
                                    placeholder_color=0x94A3B8FFL,
                                    caret_color=0x60A5FAFFL,
                                    max_lines=1,
                                    enter_sends=true,
                                    submitted=fn(txt : String) -> Unit {
                                      dispatch_session_save(txt)
                                      sessions_name_field.set("")
                                    },
                                  )
                                },
                              )
                            },
                          )
                        },
                      )

                      let _ = headless::button(
                        srow,
                        fn() -> String { "Save Current Session" },
                        fn(_v : view::View) -> Unit {
                          let txt = sessions_name_field.text()
                          dispatch_session_save(txt)
                          sessions_name_field.set("")
                        },
                        fn(sb : view::View, sbtn : headless::Button) -> Unit {
                          let _ = sb
                          .height(view::Live::Is(Some(34.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
                          .radius(view::Live::Is(8.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            if sbtn.pressed() { 0x1D4ED8FFL } else if sbtn.hovered() { 0x2563EBFFL } else { 0x3B82F6FFL }
                          }))
                          let _ = sb.box(
                            fn(sl : view::View) -> Unit {
                              let _ = sl.words(
                                view::Live::Is("Save Current Session"),
                                ink=0xFFFFFFFFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                one_line=true,
                              )
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )

              // Single hairline below save bar
              let _ = modal.box(
                fn(sep2 : view::View) -> Unit {
                  let _ = sep2.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )

              // UTF-8 Filter input
              let _ = modal.box(
                fn(fsec : view::View) -> Unit {
                  let _ = fsec
                  .padding(view::Live::Is((16.0, 10.0, 16.0, 10.0)))
                  .rigid()

                  let _ = fsec.box(
                    fn(finp : view::View) -> Unit {
                      let _ = finp
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .height(view::Live::Is(Some(32.0)))
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .gap(view::Live::Is(8.0))
                      .radius(view::Live::Is(8.0))
                      .clips(view::Live::Is(true))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                      let _ = finp.box(
                        fn(ico : view::View) -> Unit {
                          let _ = ico
                          .rigid()
                          .words(
                            view::Live::Is("⌕"),
                            ink=0x8E8E93FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )

                      let _ = finp.box(
                        fn(fh : view::View) -> Unit {
                          let _ = fh
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .height(view::Live::Is(Some(20.0)))
                          .clips(view::Live::Is(true))
                          fh.show(
                            fn() -> Bool { !is_dark_chrome() },
                            fn(fl : view::View) -> Unit {
                              let _ = ui::field(
                                fl,
                                sessions_filter_field,
                                placeholder="Filter sessions by name, space, or domain...",
                                font_size=12.5,
                                color=0x1D1D1FFFL,
                                placeholder_color=0x8E8E93FFL,
                                max_lines=1,
                              )
                            },
                          )
                          fh.show(
                            fn() -> Bool { is_dark_chrome() },
                            fn(fd : view::View) -> Unit {
                              let _ = ui::field(
                                fd,
                                sessions_filter_field,
                                placeholder="Filter sessions by name, space, or domain...",
                                font_size=12.5,
                                color=0xF1F5F9FFL,
                                placeholder_color=0x94A3B8FFL,
                                caret_color=0x60A5FAFFL,
                                max_lines=1,
                              )
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )

              // Scrollable Snapshot Cards List
              let _ = modal.box(
                fn(list_host : view::View) -> Unit {
                  let _ = list_host
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(240.0)))
                  .max_height(view::Live::Is(Some(380.0)))
                  .clips(view::Live::Is(true))

                  let _ = ui::scroll_box(
                    list_host,
                    fn(sc : view::View) -> Unit {
                      let _ = sc.padding(view::Live::Is((16.0, 2.0, 16.0, 16.0)))
                      sc.switch_by(
                        fn() -> Int {
                          let rev = sessions_rev.get()
                          let q = sessions_filter_field.text()
                          let _ = sessions_filter_query.get()
                          let dark_bit = if is_dark_chrome() { 1 } else { 0 }
                          rev * 1024 + q.length() * 4 + dark_bit
                        },
                        fn(cards : view::View, _key : Int) -> Unit {
                          let pal = chrome_palette()
                          let q = sessions_filter_field.text()
                          let filtered = proto::filter_named_sessions(app_state.sessions_state.items, q)
                          let now_s = (now_ms() / 1000.0).to_int64()
                          let ref_now = if now_s > 1700000000L { now_s } else { 1795522600L }
                          let _ = cards.gap(view::Live::Is(8.0))

                          if filtered.length() == 0 {
                            let _ = cards.box(
                              fn(emp : view::View) -> Unit {
                                let _ = emp
                                .padding(view::Live::Is((16.0, 28.0, 16.0, 28.0)))
                                .center()
                                .radius(view::Live::Is(10.0))
                                .ground(view::Live::Is(pal.surface_subtle))
                                .edge(view::Live::Is((1.0, pal.border)))
                                let msg = if q.trim() != "" {
                                  "No saved sessions match \"" + q.trim() + "\""
                                } else {
                                  "No saved sessions yet — capture your current workspace above."
                                }
                                let _ = emp.box(
                                  fn(el : view::View) -> Unit {
                                    let _ = el.words(
                                      view::Live::Is(msg),
                                      ink=pal.ink_muted,
                                      look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: true },
                                    )
                                  },
                                )
                              },
                            )
                          }

                          let mut idx = 0
                          while idx < filtered.length() {
                            let sess = filtered[idx]
                            let sid = sess.id
                            let sname = sess.name
                            let sp_cnt = sess.spaces.length()
                            let tb_cnt = sess.tabs.length()
                            let ts_str = proto::format_session_timestamp(sess.created_secs, ref_now)
                            let hosts = proto::session_preview_hosts(sess, max_hosts=4)

                            let _ = cards.box(
                              fn(card : view::View) -> Unit {
                                let _ = card
                                .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                                .gap(view::Live::Is(8.0))
                                .radius(view::Live::Is(10.0))
                                .ground(view::Live::Is(pal.surface_subtle))
                                .edge(view::Live::Is((1.0, pal.border)))

                                // Top row: Title + Time badge + Restore & Delete actions
                                let _ = card.box(
                                  fn(top : view::View) -> Unit {
                                    let _ = top
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .gap(view::Live::Is(8.0))

                                    let _ = top.box(
                                      fn(tbox : view::View) -> Unit {
                                        let _ = tbox
                                        .grow(view::Live::Is(1.0))
                                        .shrink(view::Live::Is(1.0))
                                        .basis(view::Live::Is(Some(0.0)))
                                        .min_width(view::Live::Is(Some(0.0)))
                                        .clips(view::Live::Is(true))
                                        .words(
                                          view::Live::Is(sname),
                                          ink=pal.ink_primary,
                                          look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                                          one_line=true,
                                        )
                                      },
                                    )

                                    let _ = top.box(
                                      fn(ts : view::View) -> Unit {
                                        let _ = ts
                                        .rigid()
                                        .words(
                                          view::Live::Is(ts_str),
                                          ink=pal.ink_muted,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                          one_line=true,
                                        )
                                      },
                                    )

                                    let _ = headless::button(
                                      top,
                                      fn() -> String { "Restore Session " + sname },
                                      fn(_v : view::View) -> Unit {
                                        dispatch_session_restore(sid, sname)
                                      },
                                      fn(rb : view::View, rbtn : headless::Button) -> Unit {
                                        let _ = rb
                                        .height(view::Live::Is(Some(26.0)))
                                        .rigid()
                                        .center()
                                        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                                        .radius(view::Live::Is(6.0))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          if rbtn.pressed() {
                                            pal.accent_soft_border
                                          } else if rbtn.hovered() {
                                            pal.accent_soft_bg
                                          } else {
                                            pal.surface_bg
                                          }
                                        }))
                                        .edge(view::Live::Is((1.0, pal.accent_soft_border)))
                                        let _ = rb.box(
                                          fn(rl : view::View) -> Unit {
                                            let _ = rl.words(
                                              view::Live::Is("Restore"),
                                              ink=pal.accent_soft_ink,
                                              look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                      },
                                    )

                                    let _ = headless::button(
                                      top,
                                      fn() -> String { "Delete Session " + sname },
                                      fn(_v : view::View) -> Unit {
                                        dispatch_session_delete(sid, sname)
                                      },
                                      fn(db : view::View, dbtn : headless::Button) -> Unit {
                                        let _ = db
                                        .height(view::Live::Is(Some(26.0)))
                                        .rigid()
                                        .center()
                                        .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                                        .radius(view::Live::Is(6.0))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          if dbtn.pressed() {
                                            pal.danger_border
                                          } else if dbtn.hovered() {
                                            pal.danger_bg
                                          } else {
                                            0x00000000L
                                          }
                                        }))
                                        let _ = db.box(
                                          fn(dl : view::View) -> Unit {
                                            let _ = dl.words(
                                              view::Live::Is("Delete"),
                                              ink=pal.danger,
                                              look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                      },
                                    )
                                  },
                                )

                                // Bottom row: Space count badge + Tab count badge + Domain preview chips (zero `·` concatenation)
                                let _ = card.box(
                                  fn(bot : view::View) -> Unit {
                                    let _ = bot
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .gap(view::Live::Is(6.0))
                                    .clips(view::Live::Is(true))

                                    let _ = bot.box(
                                      fn(sp_p : view::View) -> Unit {
                                        let _ = sp_p
                                        .height(view::Live::Is(Some(20.0)))
                                        .rigid()
                                        .center()
                                        .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                                        .radius(view::Live::Is(5.0))
                                        .ground(view::Live::Is(pal.accent_soft_bg))
                                        let _ = sp_p.box(
                                          fn(sl : view::View) -> Unit {
                                            let _ = sl.words(
                                              view::Live::Is(if sp_cnt == 1 { "1 space" } else { sp_cnt.to_string() + " spaces" }),
                                              ink=pal.accent_soft_ink,
                                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                      },
                                    )

                                    let _ = bot.box(
                                      fn(tb_p : view::View) -> Unit {
                                        let _ = tb_p
                                        .height(view::Live::Is(Some(20.0)))
                                        .rigid()
                                        .center()
                                        .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                                        .radius(view::Live::Is(5.0))
                                        .ground(view::Live::Is(pal.surface_bg))
                                        .edge(view::Live::Is((1.0, pal.border)))
                                        let _ = tb_p.box(
                                          fn(tl : view::View) -> Unit {
                                            let _ = tl.words(
                                              view::Live::Is(if tb_cnt == 1 { "1 tab" } else { tb_cnt.to_string() + " tabs" }),
                                              ink=pal.ink_secondary,
                                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                      },
                                    )

                                    let mut hi = 0
                                    while hi < hosts.length() {
                                      let host_str = hosts[hi]
                                      let _ = bot.box(
                                        fn(hc : view::View) -> Unit {
                                          let _ = hc
                                          .height(view::Live::Is(Some(20.0)))
                                          .max_width(view::Live::Is(Some(128.0)))
                                          .rigid()
                                          .center()
                                          .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                          .radius(view::Live::Is(5.0))
                                          .clips(view::Live::Is(true))
                                          .ground(view::Live::Is(pal.btn_bg))
                                          let _ = hc.box(
                                            fn(hl : view::View) -> Unit {
                                              let _ = hl.words(
                                                view::Live::Is(host_str),
                                                ink=pal.ink_muted,
                                                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                                                one_line=true,
                                              )
                                            },
                                          )
                                        },
                                      )
                                      hi = hi + 1
                                    }
                                  },
                                )
                              },
                            )
                            idx = idx + 1
                          }
                        },
                      )
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
