///| Native Metal Daily-Driver Chrome UX Views:
///| 1. Arc Colored Collapsible Tab Folders + Inline Folder Creator (`+ Folder`, `Cmd+K` -> `New Tab Folder`, `--demo-folders`)
///| 2. Named Workspace Session Snapshots Modal (`Cmd+K` -> `Saved Sessions`, sidebar entry, `--demo-sessions`)
///|
///| Uses concentric corner radii (14 -> 10 -> 8 -> 6pt), first-line alignment,
///| zero `·` metadata concatenation, zero double/dangling dividers, zero `alpha=0` clickable buttons,
///| full Light & Dark `ChromePalette` parity, and UTF-8 multilingual safety.

// --- Folder Create & Color Dispatchers ---

fn close_folder_create_bar() -> Unit {
  match app_state.folder_create_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.folder_create_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
}

fn open_folder_create_bar() -> Unit {
  match app_state.sidebar_open {
    Some(sb) => if !sb.untracked() { sb.set(true) }
    None => ()
  }
  match app_state.folder_create_field {
    Some(f) => {
      f.set("")
      f.focus()
    }
    None => ()
  }
  match app_state.folder_create_open {
    Some(s) => s.set(true)
    None => ()
  }
}

fn toggle_folder_create_bar() -> Unit {
  let is_open = match app_state.folder_create_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_folder_create_bar()
  } else {
    open_folder_create_bar()
  }
}

fn dispatch_folder_create_colored(
  name : String,
  color : String,
  move_active : Bool,
) -> Unit {
  let clean = name.trim()
  let label = if clean != "" {
    clean
  } else {
    proto::next_auto_folder_name(app_state.workspace, app_state.workspace.active_space_id)
  }
  let col = proto::normalize_folder_color(color)
  let move_arg = if move_active { "active" } else { "" }
  let payload_b = app_state.workspace.active_space_id + "|" + col + "|" + move_arg
  send_wire(wire::Message::Act("folder_create", label, payload_b))
  close_folder_create_bar()
  show_toast("Created Folder \"" + label + "\"", "folder")
}

fn dispatch_folder_color(folder_id : String, color : String) -> Unit {
  if folder_id != "" {
    let col = proto::normalize_folder_color(color)
    send_wire(wire::Message::Act("folder_color", folder_id, col))
  }
}

// --- Named Sessions Dispatchers ---

fn dispatch_sessions_sync() -> Unit {
  send_wire(wire::Message::Act("sessions_sync", "", ""))
}

fn dispatch_session_save(raw_name : String) -> Unit {
  let clean = raw_name.trim()
  let label = if clean != "" {
    clean
  } else {
    "Session " + (app_state.sessions_state.items.length() + 1).to_string()
  }
  // Optimistic local prepend so UI updates immediately even before host round-trip
  let now_s = (now_ms() / 1000.0).to_int64()
  let local_id = "sess-local-" + now_s.to_string()
  let captured = proto::capture_named_session(local_id, label, now_s, app_state.workspace)
  let next_items : Array[proto::NamedSessionSnapshot] = [captured]
  let mut i = 0
  while i < app_state.sessions_state.items.length() && next_items.length() < proto::SAVED_SESSIONS_MAX_ITEMS {
    next_items.push(app_state.sessions_state.items[i])
    i = i + 1
  }
  app_state.sessions_state = proto::SavedSessionsState::{ items: next_items }
  match app_state.sessions_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("session_save", label, ""))
  show_toast("Saved Session \"" + label + "\"", "info")
}

fn dispatch_session_restore(session_id : String, name : String) -> Unit {
  if session_id == "" {
    return
  }
  // Apply locally immediately if found, and dispatch to host
  let mut i = 0
  while i < app_state.sessions_state.items.length() {
    if app_state.sessions_state.items[i].id == session_id {
      app_state.workspace = proto::session_to_workspace_snapshot(app_state.sessions_state.items[i])
      match app_state.workspace_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      break
    }
    i = i + 1
  }
  send_wire(wire::Message::Act("session_restore", session_id, ""))
  close_sessions_modal()
  let lbl = if name.trim() != "" { name.trim() } else { "Session" }
  show_toast("Restored Session \"" + lbl + "\"", "info")
}

fn dispatch_session_delete(session_id : String, name : String) -> Unit {
  if session_id == "" {
    return
  }
  let kept : Array[proto::NamedSessionSnapshot] = []
  let mut i = 0
  while i < app_state.sessions_state.items.length() {
    if app_state.sessions_state.items[i].id != session_id {
      kept.push(app_state.sessions_state.items[i])
    }
    i = i + 1
  }
  app_state.sessions_state = proto::SavedSessionsState::{ items: kept }
  match app_state.sessions_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("session_delete", session_id, ""))
  let lbl = if name.trim() != "" { name.trim() } else { "Session" }
  show_toast("Deleted Session \"" + lbl + "\"", "clear")
}

fn set_host_sessions_state(json : String) -> Unit {
  match proto::parse_saved_sessions_state(json, max_items=proto::SAVED_SESSIONS_MAX_ITEMS) {
    Some(st) => {
      if app_state.demo_sessions && st.items.length() == 0 {
        ensure_demo_sessions_seeded()
      } else {
        app_state.sessions_state = st
        match app_state.sessions_rev {
          Some(r) => r.set(r.untracked() + 1)
          None => ()
        }
      }
      match app_state.host_sessions_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_sessions_modal() -> Unit {
  match app_state.sessions_name_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.sessions_filter_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.sessions_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
}

fn open_sessions_modal() -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.sessions_filter_field {
    Some(f) => f.set("")
    None => ()
  }
  match app_state.sessions_filter_query {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.sessions_open {
    Some(s) => s.set(true)
    None => ()
  }
  if app_state.demo_sessions {
    ensure_demo_sessions_seeded()
  }
  dispatch_sessions_sync()
}

fn toggle_sessions_modal() -> Unit {
  let is_open = match app_state.sessions_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_sessions_modal()
  } else {
    open_sessions_modal()
  }
}

// --- Demo Seeders for Offscreen Metal Verification ---

fn ensure_demo_folders_seeded() -> Unit {
  if !app_state.demo_folders {
    return
  }
  let sid = if app_state.workspace.active_space_id != "" {
    app_state.workspace.active_space_id
  } else {
    "work"
  }
  let existing = proto::workspace_folders_for_space(app_state.workspace, sid)
  if existing.length() >= 3 {
    return
  }
  let spaces = if app_state.workspace.spaces.length() > 0 {
    app_state.workspace.spaces
  } else {
    [
      proto::SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", active: true, tab_count: 8 },
      proto::SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", active: false, tab_count: 2 },
    ]
  }
  let demo_folders : Array[proto::FolderSummary] = [
    proto::FolderSummary::{ id: "f-arch", space_id: sid, name: "Architecture", collapsed: false, color: "blue" },
    proto::FolderSummary::{ id: "f-cjk-notes", space_id: sid, name: "中文研究资料", collapsed: true, color: "emerald" },
    proto::FolderSummary::{ id: "f-release", space_id: sid, name: "Release Ops", collapsed: true, color: "violet" },
  ]
  let demo_tabs : Array[proto::TabSummary] = [
    proto::TabSummary::{ id: "t-arch-1", space_id: sid, title: "Metal Reader Architecture", url: "https://farview.dev/notes/native-metal-reader-architecture", pinned: true, favorite: false, active: true, state: "active", folder_id: "f-arch", last_active_secs: 1795522000L },
    proto::TabSummary::{ id: "t-arch-2", space_id: sid, title: "CSS Cascade Spec", url: "https://developer.mozilla.org/en-US/docs/Web/CSS/Cascade", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-arch", last_active_secs: 1795521800L },
    proto::TabSummary::{ id: "t-arch-3", space_id: sid, title: "Invar GPU Pipeline", url: "https://github.com/AFK-surf/invar", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-arch", last_active_secs: 1795521500L },
    proto::TabSummary::{ id: "t-cjk-1", space_id: sid, title: "渲染管线与文字排版", url: "https://farview.dev/docs/typography-zh", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-cjk-notes", last_active_secs: 1795521200L },
    proto::TabSummary::{ id: "t-cjk-2", space_id: sid, title: "字体度量与抗锯齿", url: "https://developer.apple.com/fonts/", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-cjk-notes", last_active_secs: 1795521000L },
    proto::TabSummary::{ id: "t-cjk-3", space_id: sid, title: "WPT Layout Matrix", url: "https://wpt.fyi/results/css", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-cjk-notes", last_active_secs: 1795520900L },
    proto::TabSummary::{ id: "t-rel-1", space_id: sid, title: "Release Triage Board", url: "https://linear.app/farview/cycle", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-release", last_active_secs: 1795520800L },
    proto::TabSummary::{ id: "t-rel-2", space_id: sid, title: "CI Build Telemetry", url: "https://github.com/AFK-surf/farview/actions", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-release", last_active_secs: 1795520600L },
    proto::TabSummary::{ id: "t-today-1", space_id: sid, title: "Speedometer 3.0 Notes", url: "https://browserbench.org/Speedometer3.0/", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 1795520500L },
    proto::TabSummary::{ id: "t-today-2", space_id: sid, title: "Hacker News", url: "https://news.ycombinator.com/", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 1795520400L },
  ]
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..app_state.workspace,
    active_space_id: sid,
    active_tab_id: "t-arch-1",
    spaces: spaces,
    folders: demo_folders,
