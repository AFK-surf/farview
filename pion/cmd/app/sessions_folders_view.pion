      created_secs: base_s - 93600L,
      active_space_id: "research",
      spaces: [
        proto::SessionSpaceItem::{ id: "research", name: "Research", accent: "#10B981" },
      ],
      folders: [
        proto::SessionFolderItem::{ id: "f-cjk", space_id: "research", name: "中文研究资料", color: "emerald", collapsed: false },
      ],
