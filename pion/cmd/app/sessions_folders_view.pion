        proto::SessionTabItem::{ space_id: "research", title: "CoreText Subpixel Notes", url: "https://farview.dev/docs/typography-zh", pinned: true, favorite: false, folder_id: "f-cjk" },
        proto::SessionTabItem::{ space_id: "research", title: "W3C CJK Layout", url: "https://www.w3.org/TR/clreq/", pinned: true, favorite: false, folder_id: "f-cjk" },
