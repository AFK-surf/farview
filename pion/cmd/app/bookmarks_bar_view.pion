///| Native Toggleable Bookmarks Bar (`Cmd+Shift+B` / `Ctrl+Shift+B`, Command Bar `Toggle Bookmarks Bar`):
///| - Unmounts completely (0px) via `.show(bookmarks_bar_open)` when hidden (never `alpha=0`)
///| - Single 1pt bottom hairline only (never doubles against toolbar bottom)
///| - Brand-colored domain monogram badge + crisp single-line title per bookmark
///| - Left-click navigates directly; right-click opens context menu (`Open in Split`, `Open in Peek`, `Remove Bookmark`)
///| - Trailing `+ Bookmark` quick-save button aligned with Light & Dark `ChromePalette`

fn bm_bar_brand_colors(url : String, dark : Bool) -> (Int64, Int64) {
  let host = proto::omnibox_display_host(url)
  let b = host.to_bytes()
  let mut h = 0
  let mut i = 0
  while i < b.length() {
    h = (h * 31 + (b[i].to_int() & 0xFF)) & 0x7FFFFFFF
    i = i + 1
  }
  let slot = h % 6
  if dark {
    if slot == 0 {
      (0x1E3A5FFFL, 0x93C5FDFFL)
    } else if slot == 1 {
      (0x2E1F4BFFL, 0xC4B5FDFFL)
    } else if slot == 2 {
      (0x113227FFL, 0x6EE7B7FFL)
    } else if slot == 3 {
      (0x3B2D14FFL, 0xFCD34DFFL)
    } else if slot == 4 {
      (0x3D1B30FFL, 0xF9A8D4FFL)
    } else {
      (0x10333EFFL, 0x67E8F9FFL)
    }
  } else if slot == 0 {
    (0xDBEAFEFFL, 0x1D4ED8FFL)
  } else if slot == 1 {
    (0xEDE9FEFFL, 0x6D28D9FFL)
  } else if slot == 2 {
    (0xD1FAE5FFL, 0x047857FFL)
  } else if slot == 3 {
    (0xFEF3C7FFL, 0xB45309FFL)
  } else if slot == 4 {
    (0xFCE7F3FFL, 0xBE185DFFL)
  } else {
    (0xCFFAFEFFL, 0x0E7490FFL)
  }
}

fn build_bookmarks_bar(
  parent : view::View,
  bookmarks_bar_open : signals::Signal[Bool],
  bookmarks_rev : signals::Signal[Int],
) -> Unit {
  parent.show(
    fn() -> Bool { bookmarks_bar_open.get() },
    fn(wrap : view::View) -> Unit {
      let _ = wrap.rigid()

      // 28pt horizontal bookmarks strip (no top hairline so toolbar + bar stay seamless with zero double border)
      let _ = wrap.box(
        fn(strip : view::View) -> Unit {
          let _ = strip
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(4.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))

          // Scrollable / clipped bookmarks list container
          let _ = strip.box(
            fn(items_host : view::View) -> Unit {
              let _ = items_host
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(24.0)))
              .clips(view::Live::Is(true))

              items_host.switch_by(
                fn() -> Int { bookmarks_rev.get() * 2 + (if is_dark_chrome() { 1 } else { 0 }) },
                fn(list_row : view::View, key : Int) -> Unit {
                  let dark = (key % 2) == 1
                  let pal = chrome_palette_for(dark)
                  let _ = list_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(4.0))
                  let items = app_state.bookmarks_snap.items
                  if items.length() == 0 {
                    let _ = list_row.box(
                      fn(emp : view::View) -> Unit {
                        let _ = emp
                        .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
                        .words(
                          view::Live::Is("No bookmarks yet — press ⌘D or click + Bookmark to save this page"),
                          ink=pal.ink_muted,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                          one_line=true,
                        )
                      },
                    )
                  }
                  let mut i = 0
                  while i < items.length() && i < 12 {
                    let bm = items[i]
                    let bm_url = bm.url
                    let bm_id = if bm.id != "" { bm.id } else { bm.url }
                    let bm_title = if bm.title.trim() != "" { bm.title.trim() } else { proto::omnibox_display_host(bm_url) }
                    let mono = proto::omnibox_initial_letter(bm_url, bm_title)
                    let (badge_bg, badge_fg) = bm_bar_brand_colors(bm_url, dark)
                    let _ = headless::button(
                      list_row,
                      fn() -> String { "Open bookmark " + bm_title },
                      fn(_v : view::View) -> Unit {
                        close_bm_bar_ctx()
                        if bm_url != "" {
                          active_stage().go(bm_url)
                        }
                      },
                      fn(chip : view::View, cbtn : headless::Button) -> Unit {
                        let _ = chip
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .height(view::Live::Is(Some(22.0)))
                        .max_width(view::Live::Is(Some(156.0)))
                        .rigid()
                        .padding(view::Live::Is((5.0, 0.0, 7.0, 0.0)))
                        .gap(view::Live::Is(5.0))
                        .radius(view::Live::Is(5.0))
                        .clips(view::Live::Is(true))
                        .ground(view::Live::By(fn() -> Int64 {
                          if cbtn.pressed() {
                            pal.btn_press
                          } else if cbtn.hovered() {
                            pal.btn_hover
                          } else {
                            0x00000000L
                          }
                        }))
                        .on_menu(fn(_m : view::Menu) -> Unit {
                          let (cx, _, _, _) = chip.placed_now()
                          open_bm_bar_ctx(bm_id, bm_url, cx)
                        })
                        // 14x14 brand monogram badge
                        let _ = chip.box(
                          fn(ico : view::View) -> Unit {
                            let _ = ico
                            .width(view::Live::Is(Some(14.0)))
                            .height(view::Live::Is(Some(14.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(3.5))
                            .ground(view::Live::Is(badge_bg))
                            let _ = ico.box(
                              fn(il : view::View) -> Unit {
                                let _ = il.words(
                                  view::Live::Is(mono),
                                  ink=badge_fg,
                                  look=view::WordsLook::{ ..view::words_plain, size: 9.0, weight: 600, wrap: false },
                                  one_line=true,
                                )
                              },
                            )
                          },
                        )
                        // Crisp single-line title
                        let _ = chip.box(
                          fn(tl : view::View) -> Unit {
                            let _ = tl
                            .shrink(view::Live::Is(1.0))
                            .min_width(view::Live::Is(Some(0.0)))
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::Is(bm_title),
                              ink=pal.ink_primary,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              if cbtn.hovered() || cbtn.pressed() { pal.ink_primary } else { pal.ink_secondary }
                            }))
                          },
                        )
                      },
                    )
                    i = i + 1
                  }
                },
              )
            },
          )

          // Right compact "+ Bookmark" quick-save button
          let _ = headless::button(
            strip,
            fn() -> String { "Bookmark Current Page" },
            fn(_v : view::View) -> Unit { dispatch_bookmark_toggle() },
            fn(ab : view::View, abtn : headless::Button) -> Unit {
              let is_saved = fn() -> Bool {
                let _ = bookmarks_rev.get()
                proto::bookmarks_contains_url(app_state.bookmarks_snap, active_stage_live().url())
              }
              let _ = ab
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(21.0)))
              .rigid()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .gap(view::Live::Is(4.0))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if abtn.pressed() {
                  p.btn_press
                } else if abtn.hovered() {
                  p.btn_hover
                } else if is_saved() {
                  p.accent_soft_bg
                } else {
                  p.btn_bg
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let p = chrome_palette()
                if is_saved() { (1.0, p.accent_soft_border) } else { (1.0, p.border) }
              }))
              let _ = ab.box(
                fn(al : view::View) -> Unit {
                  let _ = al
                  .words(
                    view::Live::By(fn() -> String {
                      if is_saved() { "★ Saved" } else { "+ Bookmark" }
                    }),
                    ink=0x475569FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if is_saved() { p.accent } else if abtn.hovered() { p.ink_primary } else { p.ink_secondary }
                  }))
                },
              )
            },
          )
        },
      )

      // Single 1pt bottom hairline separating Bookmarks Bar from page canvas
      let _ = wrap.box(
        fn(bsep : view::View) -> Unit {
          let _ = bsep
          .height(view::Live::Is(Some(1.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )
    },
  )
}

fn build_bookmark_bar_context_menu(
  root : view::View,
  bm_bar_ctx_open : signals::Signal[Bool],
  bm_bar_ctx_id : signals::Signal[String],
  bm_bar_ctx_url : signals::Signal[String],
  bm_bar_ctx_x : signals::Signal[Double],
) -> Unit {
  root.show(
    fn() -> Bool { bm_bar_ctx_open.get() },
    fn(layer : view::View) -> Unit {
      let _ = layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      let _ = headless::button(
        layer,
        fn() -> String { "Dismiss Bookmark Menu" },
        fn(_v : view::View) -> Unit { close_bm_bar_ctx() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::Is(0x00000000L))
        },
      )
      let _ = layer.box(
        fn(menu : view::View) -> Unit {
          let _ = menu
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            (Some(bm_bar_ctx_x.get()), Some(76.0), None, None)
          }))
          .width(view::Live::Is(Some(178.0)))
          .padding(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
          .gap(view::Live::Is(2.0))
          .radius(view::Live::Is(9.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (20.0, 6.0, 0x00000066L) } else { (18.0, 6.0, 0x0F172A22L) }
          }))

          let menu_item = fn(lbl : String, danger : Bool, on_act : () -> Unit) -> Unit {
            let _ = headless::button(
              menu,
              fn() -> String { lbl },
              fn(_v : view::View) -> Unit {
                close_bm_bar_ctx()
                on_act()
              },
              fn(mi : view::View, mbtn : headless::Button) -> Unit {
                let _ = mi
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(28.0)))
                .rigid()
                .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                .radius(view::Live::Is(6.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if danger {
                    if mbtn.pressed() { p.danger_border } else if mbtn.hovered() { p.danger_bg } else { 0x00000000L }
                  } else if mbtn.pressed() {
                    p.btn_press
                  } else if mbtn.hovered() {
                    p.btn_hover
                  } else {
                    0x00000000L
                  }
                }))
                let _ = mi.box(
                  fn(ml : view::View) -> Unit {
                    let _ = ml
                    .words(
                      view::Live::Is(lbl),
                      ink=0x1D1D1FFFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if danger { p.danger } else { p.ink_primary }
                    }))
                  },
                )
              },
            )
          }

          menu_item("Open in Split", false, fn() -> Unit {
            let u = bm_bar_ctx_url.untracked()
            if u != "" {
              open_split_view(u, app_state.workspace.active_tab_id, focus_pane=1)
            }
          })
          menu_item("Open in Peek", false, fn() -> Unit {
            let u = bm_bar_ctx_url.untracked()
            if u != "" {
              open_peek_preview(u, app_state.workspace.active_tab_id)
            }
          })
          let _ = menu.box(
            fn(sep : view::View) -> Unit {
              let _ = sep
              .height(view::Live::Is(Some(1.0)))
              .rigid()
              .padding(view::Live::Is((4.0, 2.0, 4.0, 2.0)))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )
          menu_item("Remove Bookmark", true, fn() -> Unit {
            let id = bm_bar_ctx_id.untracked()
            let u = bm_bar_ctx_url.untracked()
            dispatch_bookmark_delete(if id != "" { id } else { u })
          })
        },
      )
    },
  )
}
