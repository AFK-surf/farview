///| Cmd+D and the bookmark bubble, app side.

import "proto"

fn bbt_acts(sent : Array[wire::Message], verb : String) -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  for m in sent {
    match m {
      wire::Message::Act(v, a, b) if v == verb => out.push((a, b))
      _ => ()
    }
  }
  out
}

test "Cmd+D bookmarks the page and opens the bubble; Done renames and moves it, only when changed" {
  shell_adapter_reset()
  let prev_stage = app_state.stage
  let prev_snap = app_state.bookmarks_snap
  app_state.bookmarks_snap = proto::BookmarksSnapshot::empty()
  let st = zst_stage_at("https://docs.test/guide")
  app_state.stage = Some(st)
  let sent : Array[wire::Message] = []
  let prev_hook = test_send_wire_hook.v
  test_send_wire_hook.v = Some(fn(m : wire::Message) -> Unit { sent.push(m) })

  bm_add_pending_url.v = ""
  bookmark_page_act()
  debug_assert(bbt_acts(sent, "bookmark_add").length() == 1, "bookmarked")
  debug_assert(bm_bubble_open.untracked() && bm_bubble_added.untracked(), "the bubble says it was added")
  let (name_f, folder_f) = bm_bubble_name_folder()
  debug_assert(name_f.text() == "Page" && folder_f.text() == proto::BOOKMARK_DEFAULT_FOLDER, "named after the page")
  bm_bubble_done()
  debug_assert(!bm_bubble_open.untracked() && bbt_acts(sent, "bookmark_update").length() == 0, "nothing changed: no update")

  // The page is bookmarked now (the host's snapshot): Cmd+D edits it instead of removing it.
  app_state.bookmarks_snap = proto::BookmarksSnapshot::{
    items: [proto::BookmarkEntry::{ id: "bm-1", title: "Page", url: "https://docs.test/guide", folder: "Bookmarks", created_ms: 0L }],
  }
  bookmark_page_act()
  debug_assert(bm_bubble_open.untracked() && !bm_bubble_added.untracked(), "Edit bookmark")
  debug_assert(bbt_acts(sent, "bookmark_add").length() == 1 && bbt_acts(sent, "bookmark_toggle").length() == 0, "not toggled off")
  name_f.set("The guide")
  folder_f.set("Reading")
  bm_bubble_done()
  let ups = bbt_acts(sent, "bookmark_update")
  debug_assert(ups.length() == 1 && ups[0].0 == "https://docs.test/guide", "updated")
  let (t, f) = proto::parse_bookmark_update(ups[0].1)
  debug_assert(t == "The guide" && f == "Reading", "with the new name and folder")

  // Remove takes it away.
  bookmark_page_act()
  bm_bubble_remove()
  let dels = bbt_acts(sent, "bookmark_delete")
  debug_assert(dels.length() == 1 && dels[0].0 == "https://docs.test/guide" && !bm_bubble_open.untracked(), "removed")

  test_send_wire_hook.v = prev_hook
  app_state.stage = prev_stage
  app_state.bookmarks_snap = prev_snap
  shell_adapter_reset()
}

test "Cmd+D pressed again before the host answers: one add, no remove, and the typed name is kept" {
  shell_adapter_reset()
  let prev_stage = app_state.stage
  let prev_snap = app_state.bookmarks_snap
  app_state.bookmarks_snap = proto::BookmarksSnapshot::empty()
  bm_add_pending_url.v = ""
  app_state.stage = Some(zst_stage_at("https://slow.test/far"))
  let sent : Array[wire::Message] = []
  let prev_hook = test_send_wire_hook.v
  test_send_wire_hook.v = Some(fn(m : wire::Message) -> Unit { sent.push(m) })

  bookmark_page_act()
  let (name_f, _) = bm_bubble_name_folder()
  name_f.set("Far page")
  // Second Cmd+D with the bubble open: Done, the name typed is kept.
  bookmark_page_act()
  debug_assert(!bm_bubble_open.untracked(), "the second press closes the bubble")
  let ups = bbt_acts(sent, "bookmark_update")
  debug_assert(ups.length() == 1 && proto::parse_bookmark_update(ups[0].1).0 == "Far page", "with the name typed")
  // Third Cmd+D, the snapshot still not back: the bubble opens again, nothing more is asked of the host.
  bookmark_page_act()
  debug_assert(bm_bubble_open.untracked() && bm_bubble_added.untracked(), "Bookmark added again")
  bm_bubble_done()
  debug_assert(bbt_acts(sent, "bookmark_add").length() == 1, "one add")
  debug_assert(bbt_acts(sent, "bookmark_toggle").length() == 0 && bbt_acts(sent, "bookmark_delete").length() == 0, "no remove")
  // The snapshot comes back with it: Cmd+D now edits it.
  set_host_bookmarks_state(
    proto::encode_bookmarks_snapshot(proto::BookmarksSnapshot::{
      items: [proto::BookmarkEntry::{ id: "bm-1", title: "Far page", url: "https://slow.test/far", folder: "Bookmarks", created_ms: 0L }],
    }),
  )
  debug_assert(bm_add_pending_url.v == "", "the answer settles the pending add")
  bookmark_page_act()
  debug_assert(bm_bubble_open.untracked() && !bm_bubble_added.untracked() && name_f.text() == "Far page", "Edit bookmark")
  bm_bubble_done()
  debug_assert(bbt_acts(sent, "bookmark_add").length() == 1, "still one add")

  test_send_wire_hook.v = prev_hook
  app_state.stage = prev_stage
  app_state.bookmarks_snap = prev_snap
  shell_adapter_reset()
}
