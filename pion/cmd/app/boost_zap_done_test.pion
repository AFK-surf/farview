///| The page's Done ends Zap only for the pane the Boost panel is bound to (`set_host_boosts_state_from_pane`).

test "boosts: zapDone from the owner pane turns Zap off; from the other pane it does not" {
  let saved_owner = shell_adapter.boosts_owner_pane
  let saved_flag = boost_zap_flag[0]
  let done_json = proto::encode_boosts_snapshot(proto::BoostsSnapshot::empty(), zap_done=true)
  shell_adapter.boosts_owner_pane = 0
  boost_zap_flag[0] = true
  set_host_boosts_state_from_pane(1, done_json)
  debug_assert(boost_zap_flag[0], "the other pane's Done leaves Zap on")
  set_host_boosts_state_from_pane(0, proto::encode_boosts_snapshot(proto::BoostsSnapshot::empty()))
  debug_assert(boost_zap_flag[0], "a plain snapshot from the owner leaves Zap on")
  set_host_boosts_state_from_pane(0, done_json)
  debug_assert(!boost_zap_flag[0], "the owner pane's Done turns Zap off")
  // (the split pane owning the panel)
  shell_adapter.boosts_owner_pane = 1
  boost_zap_flag[0] = true
  set_host_boosts_state_from_pane(0, done_json)
  debug_assert(boost_zap_flag[0], "the primary pane's Done leaves the split pane's Zap on")
  set_host_boosts_state_from_pane(1, done_json)
  debug_assert(!boost_zap_flag[0], "the split pane's own Done turns Zap off")
  shell_adapter.boosts_owner_pane = saved_owner
  boost_zap_flag[0] = saved_flag
}
