///| The app's glue for a page's copy and its field menu (overlay_state.pion: copy_rich_to_os, page_ctx_edit_command).

fn peg_said(sent : Array[Bytes]) -> Array[proto::ClientMsg] {
  let framer = proto::Framer::new()
  for b in sent {
    framer.push(b)
  }
  let out : Array[proto::ClientMsg] = []
  while true {
    match framer.next() {
      Some(body) => match proto::decode_client(body) {
        Some(m) => out.push(m)
        None => ()
      }
      None => break
    }
  }
  out
}

test "a page's copy reaches the system's clipboard as plain text and HTML both; nothing copied, nothing written" {
  let got : Array[(String, String)] = []
  let prev = test_clipboard_rich_hook.v
  test_clipboard_rich_hook.v = Some(fn(p : String, h : String) -> Unit { got.push((p, h)) })
  copy_rich_to_os("hello 世界", "<p>hello <b>世界</b></p>")
  copy_rich_to_os("", "<p></p>")
  test_clipboard_rich_hook.v = prev
  debug_assert(got.length() == 1, "one write: " + got.length().to_string())
  debug_assert(got[0].0 == "hello 世界" && got[0].1 == "<p>hello <b>世界</b></p>", "plain and HTML both")
}

test "the field menu's Paste puts the system's clipboard in what the page is typed in; Copy there writes it back" {
  let sent : Array[Bytes] = []
  let st = stage::Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  st.opened()
  ui::answered_from_outside(fn() -> Unit {
    st.feed(proto::encode_host(proto::HostMsg::Meta("https://editor.test/", "Editor", false, false, false)))
    st.feed(fka_reset_with_input("https://editor.test"))
    st.feed(proto::encode_host(proto::HostMsg::Patch(2, 0, [proto::PatchOp::Focus(4)])))
  })
  debug_assert(st.editing_text(), "the page's field has the focus")
  let prev_stage = app_state.page_ctx_stage
  let prev_r = test_clipboard_read_hook.v
  let prev_w = test_clipboard_write_hook.v
  let reads : Array[Int] = []
  let written : Array[String] = []
  test_clipboard_read_hook.v = Some(fn() -> String { reads.push(1); "pasted words" })
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { written.push(s) })
  app_state.page_ctx_stage = Some(st)
  sent.clear()
  page_ctx_edit_command(shell_ui::EDIT_CMD_PASTE)
  debug_assert(reads.length() == 1, "Paste reads the system's clipboard once")
  let mut seen = false
  for m in peg_said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, _, v, _, _, _) => if v.contains("pasted words") { seen = true }
      proto::ClientMsg::Key(_, _, _, _, _, txt, _) => if txt.contains("pasted words") { seen = true }
      _ => ()
    }
  }
  // (Select All then Copy: what was pasted is what the field holds, written back to the system's clipboard)
  page_ctx_edit_command(shell_ui::EDIT_CMD_SELECT_ALL)
  page_ctx_edit_command(shell_ui::EDIT_CMD_COPY)
  debug_assert(seen || (written.length() == 1 && written[0] == "pasted words"), "the words pasted are the field's: " + written.join("|"))
  debug_assert(reads.length() == 1, "only Paste reads it")
  app_state.page_ctx_stage = prev_stage
  test_clipboard_read_hook.v = prev_r
  test_clipboard_write_hook.v = prev_w
}
