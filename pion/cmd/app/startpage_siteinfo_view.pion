///| Native Metal Start Page (`about:newtab` / blank tab, dual Light & Dark Chrome theme)
///| and upgraded Address Bar Site Info & Permissions Popover (Camera, Microphone,
///| Notifications, Location, Clipboard per-origin persistence + Reset + Clear Site Data).
///| Strictly follows concentric corner radii, first-line alignment, zero double dividers,
///| zero `alpha=0` clickable buttons, and zero `ellipsis_past(true)`.

fn dispatch_site_perms_sync() -> Unit {
  send_wire(wire::Message::Act("site_perms_sync", "", ""))
}

fn site_perm_display_kind(kind : String) -> String {
  if kind == "camera" {
    "Camera"
  } else if kind == "microphone" {
    "Microphone"
  } else if kind == "notifications" {
    "Notifications"
  } else if kind == "geolocation" {
    "Location"
  } else if kind == "clipboard" {
    "Clipboard"
  } else {
    kind
  }
}

fn site_perm_display_state(state : String) -> String {
  let n = proto::normalize_site_perm_value(state)
  if n == "allow" {
    "Allow"
  } else if n == "block" {
    "Block"
  } else {
    "Ask"
  }
}

fn site_perms_upsert_local(origin : String, kind : String, value : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    return
  }
  let rules = app_state.site_perms_snap.rules
  let mut idx = -1
  let mut i = 0
  while i < rules.length() {
    if proto::normalize_permission_origin(rules[i].origin) == norm_origin {
      idx = i
      break
    }
    i = i + 1
  }
  let base = if idx >= 0 {
    rules[idx]
  } else {
    proto::SitePermissionRule::default_for(norm_origin)
  }
  let updated = proto::site_perm_rule_with(base, kind, value)
  let next_rules : Array[proto::SitePermissionRule] = []
  let mut j = 0
  while j < rules.length() {
    if j != idx {
      next_rules.push(rules[j])
    }
    j = j + 1
  }
  if proto::site_perm_rule_has_custom(updated) {
    next_rules.push(updated)
  }
  app_state.site_perms_snap = proto::SitePermissionsSnapshot::{ rules: next_rules }
  match app_state.site_perms_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
}

fn dispatch_site_perm_set(origin : String, kind : String, value : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    show_toast("Permissions apply to web origins", "info")
    return
  }
  let norm_val = proto::normalize_site_perm_value(value)
  site_perms_upsert_local(norm_origin, kind, norm_val)
  send_wire(wire::Message::Act("site_perm_set", norm_origin + "|" + kind, norm_val))
  show_toast(site_perm_display_kind(kind) + ": " + site_perm_display_state(norm_val), "perm")
}

fn dispatch_site_perm_reset(origin : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    return
  }
  let rules = app_state.site_perms_snap.rules
  let next_rules : Array[proto::SitePermissionRule] = []
  let mut i = 0
  while i < rules.length() {
    if proto::normalize_permission_origin(rules[i].origin) != norm_origin {
      next_rules.push(rules[i])
    }
    i = i + 1
  }
  app_state.site_perms_snap = proto::SitePermissionsSnapshot::{ rules: next_rules }
  match app_state.site_perms_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("site_perm_reset", norm_origin, ""))
  show_toast("Permissions reset to Ask", "perm")
}

fn dispatch_site_clear_data(origin : String) -> Unit {
  let norm_origin = proto::normalize_permission_origin(origin)
  if norm_origin == "" {
    show_toast("No site data for this page", "info")
    return
  }
  let host = proto::history_url_host(norm_origin)
  let rules = app_state.site_perms_snap.rules
  let next_rules : Array[proto::SitePermissionRule] = []
  let mut i = 0
  while i < rules.length() {
    if proto::normalize_permission_origin(rules[i].origin) != norm_origin {
      next_rules.push(rules[i])
    }
    i = i + 1
  }
  app_state.site_perms_snap = proto::SitePermissionsSnapshot::{ rules: next_rules }
  match app_state.site_perms_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("site_clear_data", norm_origin, ""))
  let label = if host != "" { host } else { norm_origin }
  show_toast("Cleared site data for " + label, "clear")
}

fn set_host_site_perms_state(json : String) -> Unit {
  match proto::parse_site_permissions_snapshot(json, max_items=256) {
    Some(snap) => {
      app_state.site_perms_snap = snap
      match app_state.site_perms_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_site_perms_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn active_site_permission_rule(url : String) -> proto::SitePermissionRule {
  let _ = match app_state.site_perms_rev {
    Some(r) => r.get()
    None => 0
  }
  let _ = match app_state.workspace_rev {
    Some(r) => r.get()
    None => 0
  }
  let origin = proto::normalize_permission_origin(url)
  let base = proto::site_perms_rule_for(app_state.site_perms_snap, origin)
  if proto::site_perm_rule_has_custom(base) {
    return base
  }
  // Fallback to WorkspaceState permissions if no tag-62 custom rule yet
  match app_state.workspace.permissions {
    Some(pm) if proto::normalize_permission_origin(pm.origin) == origin && origin != "" =>
    proto::SitePermissionRule::{
      origin: origin,
      camera: proto::normalize_site_perm_value(pm.camera),
      microphone: proto::normalize_site_perm_value(pm.microphone),
      notifications: proto::normalize_site_perm_value(pm.notifications),
      geolocation: base.geolocation,
      clipboard: proto::normalize_site_perm_value(pm.clipboard_read),
    }
    _ => base
  }
}

fn submit_start_page_search(st : stage::Stage, raw : String) -> Unit {
  let trimmed = raw.trim()
  if trimmed == "" {
    return
  }
  let target = proto::omnibox_normalize_input_with_engine(
    trimmed,
    app_state.settings.search_engine,
    https_only=app_state.settings.https_only,
  )
  match app_state.start_page_field {
    Some(f) => {
      f.set("")
      if f.focused() {
        f.let_go()
      }
    }
    None => ()
  }
  app_state.initial_start_page_open = false
  if target != "" {
    st.go(target)
  }
}

///| Builds the native Metal Start Page (`about:newtab` / empty tab) inside `content_wrap`.
///| 100% reactive to `ChromePalette` Light & Dark themes, with centered search box,
///| 2x4 Quick Access speed-dial tiles from real bookmarks & history, and bottom action pills.
fn build_start_page_view(
  content_wrap : view::View,
  st : stage::Stage,
  split_open : signals::Signal[Bool],
  reader_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  bookmarks_rev : signals::Signal[Int],
  history_rev : signals::Signal[Int],
  settings_rev : signals::Signal[Int],
  start_page_field : ui::Field,
) -> Unit {
  let is_start_active = fn() -> Bool {
    if split_open.get() || reader_open.get() {
      return false
    }
    if app_state.initial_start_page_open {
      return true
    }
    let u = st.url()
    !st.loading() && proto::is_start_page_url(u)
  }

  let active_space_info = fn() -> (String, String, Int64) {
    let _ = workspace_rev.get()
    match proto::workspace_active_space(app_state.workspace) {
      Some(sp) => {
        let nm = if sp.name != "" { sp.name } else { app_state.space_name }
        (nm, sp.accent, proto::workspace_accent_color(sp.accent))
      }
      None => (app_state.space_name, "#2563EB", 0x2563EBFFL)
    }
  }

  content_wrap.show(
    is_start_active,
    fn(sp_root : view::View) -> Unit {
      let _ = sp_root
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .clips(view::Live::Is(true))
      .center()
      .padding(view::Live::Is((28.0, 24.0, 28.0, 24.0)))
      .ground(view::Live::By(fn() -> Int64 {
        let p = chrome_palette()
        if p.is_dark { 0x111318FFL } else { 0xF7F8FCFFL }
      }))

      // Centered column container (max 604pt wide)
      let _ = sp_root.box(
        fn(col : view::View) -> Unit {
          let _ = col
          .width(view::Live::Is(Some(604.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(26.0))

          // 1. Soft Centered Header: Farview Emblem + Title + Space Badge + Subtitle
          let _ = col.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(10.0))

              // Brand row: Monogram + Farview + Space Pill
              let _ = hdr.box(
                fn(brow : view::View) -> Unit {
                  let _ = brow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(10.0))

                  // Crisp 34x34 Farview emblem
                  let _ = brow.box(
                    fn(em : view::View) -> Unit {
                      let _ = em
                      .width(view::Live::Is(Some(34.0)))
                      .height(view::Live::Is(Some(34.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(9.0))
                      .ground(view::Live::By(fn() -> Int64 { active_space_info().2 }))
                      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
                        if is_dark_chrome() { (12.0, 4.0, 0x00000055L) } else { (10.0, 3.0, 0x1E3A8A26L) }
                      }))
                      let _ = em.box(
                        fn(fl : view::View) -> Unit {
                          let _ = fl.words(
                            view::Live::Is("F"),
                            ink=0xFFFFFFFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 17.0, weight: 700, wrap: false },
                            one_line=true,
                          )
                        },
                      )
                    },
                  )

                  // Brand title
                  let _ = brow.box(
                    fn(ttl : view::View) -> Unit {
                      let _ = ttl
                      .words(
                        view::Live::Is("Farview"),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 22.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )

                  // Active Space pill badge
                  let _ = brow.box(
                    fn(sp_pill : view::View) -> Unit {
                      let _ = sp_pill
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .height(view::Live::Is(Some(24.0)))
                      .rigid()
                      .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                      .gap(view::Live::Is(6.0))
                      .radius(view::Live::Is(12.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let (_, acc, _) = active_space_info()
                        space_badge_tint_themed(acc, false, false, is_dark_chrome()).0
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        let (_, acc, _) = active_space_info()
                        (1.0, space_badge_tint_themed(acc, false, false, is_dark_chrome()).1)
                      }))
                      let _ = sp_pill.box(
                        fn(dot : view::View) -> Unit {
                          let _ = dot
                          .width(view::Live::Is(Some(7.0)))
                          .height(view::Live::Is(Some(7.0)))
                          .rigid()
                          .radius(view::Live::Is(3.5))
                          .ground(view::Live::By(fn() -> Int64 { active_space_info().2 }))
                        },
                      )
                      let _ = sp_pill.box(
                        fn(sn : view::View) -> Unit {
                          let _ = sn
                          .words(
                            view::Live::By(fn() -> String { active_space_info().0 }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )
                },
              )

              // Restrained subtitle
              let _ = hdr.box(
                fn(sub : view::View) -> Unit {
                  let _ = sub
                  .words(
                    view::Live::By(fn() -> String {
                      let _ = settings_rev.get()
                      let eng = proto::search_engine_label(app_state.settings.search_engine)
                      "Search with " + eng + " or jump straight to your pinned sites"
                    }),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )

          // 2. Centered Large Search Box (580pt wide, 48pt tall, radius 12pt -> inner 7pt)
          let _ = col.box(
            fn(sbox : view::View) -> Unit {
              let _ = sbox
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(580.0)))
              .height(view::Live::Is(Some(48.0)))
              .rigid()
              .padding(view::Live::Is((14.0, 0.0, 8.0, 0.0)))
              .gap(view::Live::Is(10.0))
              .radius(view::Live::Is(12.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let p = chrome_palette()
                if start_page_field.focused() { (1.5, p.accent) } else { (1.0, p.border) }
              }))
              .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
                if is_dark_chrome() { (22.0, 8.0, 0x00000050L) } else { (18.0, 6.0, 0x0F172A18L) }
              }))

              // Search glyph
              let _ = sbox.box(
                fn(si : view::View) -> Unit {
                  let _ = si
                  .width(view::Live::Is(Some(18.0)))
                  .center()
                  .rigid()
                  .words(
                    view::Live::Is("⌕"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 17.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if start_page_field.focused() { p.accent } else { p.ink_muted }
                  }))
                },
              )

              // Single-line Search Input (registered in is_chrome_field_focused)
              let sp_empty = signals::signal(start_page_field.text() == "")
              let _ = sbox.box(
                fn(fw : view::View) -> Unit {
                  let _ = fw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(32.0)))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .row(view::Live::Is(true))

                  // Reactive placeholder showing live default search engine (Search with Google / Kagi / ...)
                  fw.show(
                    fn() -> Bool { sp_empty.get() },
                    fn(ph : view::View) -> Unit {
                      let _ = ph
                      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      let _ = ph.box(
                        fn(pt : view::View) -> Unit {
                          let _ = pt
                          .words(
                            view::Live::By(fn() -> String {
                              let _ = settings_rev.get()
                              let eng = proto::search_engine_label(app_state.settings.search_engine)
                              "Search with " + eng + " or enter URL..."
                            }),
                            ink=0x8E8E93FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 400, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )

                  fw.show(
                    fn() -> Bool { !is_dark_chrome() },
                    fn(fl : view::View) -> Unit {
                      let _ = fl
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      let _ = ui::field(
                        fl,
                        start_page_field,
                        placeholder="",
                        font_size=14.0,
                        color=0x1D1D1FFFL,
                        placeholder_color=0x8E8E93FFL,
                        caret_color=0x2563EBFFL,
                        max_lines=1,
                        enter_sends=true,
                        edited=fn(v : String) -> Unit { sp_empty.set(v == "") },
                        submitted=fn(v : String) -> Unit {
                          sp_empty.set(true)
                          submit_start_page_search(st, v)
                        },
                      )
                    },
                  )
                  fw.show(
                    fn() -> Bool { is_dark_chrome() },
                    fn(fd : view::View) -> Unit {
                      let _ = fd
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      let _ = ui::field(
                        fd,
                        start_page_field,
                        placeholder="",
                        font_size=14.0,
                        color=0xF1F5F9FFL,
                        placeholder_color=0x94A3B8FFL,
                        caret_color=0x60A5FAFFL,
                        max_lines=1,
                        enter_sends=true,
                        edited=fn(v : String) -> Unit { sp_empty.set(v == "") },
                        submitted=fn(v : String) -> Unit {
                          sp_empty.set(true)
                          submit_start_page_search(st, v)
                        },
                      )
                    },
                  )
                },
              )

              // Active Search Engine Pill + Go Button (concentric radius 7pt)
              let _ = headless::button(
                sbox,
                fn() -> String { "Submit Search" },
                fn(_v : view::View) -> Unit {
                  let q = start_page_field.text()
                  if q.trim() != "" {
                    submit_start_page_search(st, q)
                  } else {
                    start_page_field.focus()
                  }
                },
                fn(eb : view::View, btn : headless::Button) -> Unit {
                  let _ = eb
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(7.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() {
                      p.btn_press
                    } else if btn.hovered() {
                      p.btn_hover
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = eb.box(
                    fn(el : view::View) -> Unit {
                      let _ = el
                      .words(
                        view::Live::By(fn() -> String {
                          let _ = settings_rev.get()
                          proto::search_engine_label(app_state.settings.search_engine)
                        }),
                        ink=0x3A4152FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                  let _ = eb.box(
                    fn(ar : view::View) -> Unit {
                      let _ = ar
                      .words(
                        view::Live::Is("↵"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // 3. Quick Access Speed-Dial Grid (2x4 tiles from real Bookmarks + History)
          let get_tiles = fn() -> Array[proto::StartPageTile] {
            let _ = bookmarks_rev.get()
            let _ = history_rev.get()
            proto::build_start_page_tiles(
              app_state.bookmarks_snap.items,
              app_state.history_snap.items,
              proto::START_PAGE_MAX_TILES,
            )
          }

          let _ = col.box(
            fn(grid_sec : view::View) -> Unit {
              let _ = grid_sec
              .width(view::Live::Is(Some(580.0)))
              .gap(view::Live::Is(10.0))

              // Section label row
              let _ = grid_sec.box(
                fn(g_hdr : view::View) -> Unit {
                  let _ = g_hdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
                  let _ = g_hdr.box(
                    fn(gl : view::View) -> Unit {
                      let _ = gl
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("QUICK ACCESS"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                  let _ = g_hdr.box(
                    fn(gc : view::View) -> Unit {
                      let _ = gc
                      .words(
                        view::Live::By(fn() -> String {
                          let n = get_tiles().length()
                          if n == 0 {
                            ""
                          } else if n == 1 {
                            "1 pinned site"
                          } else {
                            n.to_string() + " sites"
                          }
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Empty state when neither bookmarks nor history exist yet
              grid_sec.show(
                fn() -> Bool { get_tiles().length() == 0 },
                fn(empty_box : view::View) -> Unit {
                  let _ = empty_box
                  .height(view::Live::Is(Some(108.0)))
                  .center()
                  .radius(view::Live::Is(12.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = empty_box.box(
                    fn(et : view::View) -> Unit {
                      let _ = et
                      .words(
                        view::Live::Is("Your bookmarks and frequently visited sites will appear here"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // 2 rows x 4 columns of Speed-Dial Tiles (each 136pt wide x 96pt tall, 12pt gap -> 4*136 + 3*12 = 580pt)
              let render_tile_row = fn(row_start : Int) -> Unit {
                grid_sec.show(
                  fn() -> Bool { get_tiles().length() > row_start },
                  fn(trow : view::View) -> Unit {
                    let _ = trow
                    .row(view::Live::Is(true))
                    .gap(view::Live::Is(12.0))
                    let mut c = 0
                    while c < 4 {
                      let idx = row_start + c
                      trow.show(
                        fn() -> Bool { idx < get_tiles().length() },
                        fn(slot : view::View) -> Unit {
                          let _ = headless::button(
                            slot,
                            fn() -> String {
                              let tiles = get_tiles()
                              if idx < tiles.length() { tiles[idx].title } else { "Site" }
                            },
                            fn(_v : view::View) -> Unit {
                              let tiles = get_tiles()
                              if idx < tiles.length() {
                                app_state.initial_start_page_open = false
                                st.go(tiles[idx].url)
                              }
                            },
                            fn(card : view::View, btn : headless::Button) -> Unit {
                              let _ = card
                              .width(view::Live::Is(Some(136.0)))
                              .height(view::Live::Is(Some(96.0)))
                              .rigid()
                              .padding(view::Live::Is((12.0, 12.0, 12.0, 10.0)))
                              .gap(view::Live::Is(8.0))
                              .radius(view::Live::Is(12.0))
                              .ground(view::Live::By(fn() -> Int64 {
                                let p = chrome_palette()
                                if btn.pressed() {
                                  p.tab_press_bg
                                } else if btn.hovered() {
                                  p.surface_subtle
                                } else {
                                  p.surface_bg
                                }
                              }))
                              .edge(view::Live::By(fn() -> (Double, Int64) {
                                let p = chrome_palette()
                                if btn.hovered() { (1.0, p.accent_soft_border) } else { (1.0, p.border) }
                              }))
                              .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
                                if is_dark_chrome() { (10.0, 3.0, 0x00000030L) } else { (8.0, 2.0, 0x0F172A0EL) }
                              }))

                              // Top row: Monogram square + subtle Bookmark star indicator
                              let _ = card.box(
                                fn(top : view::View) -> Unit {
                                  let _ = top
                                  .row(view::Live::Is(true))
                                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                  .gap(view::Live::Is(6.0))
                                  let _ = top.box(
                                    fn(ico : view::View) -> Unit {
                                      let _ = ico
                                      .width(view::Live::Is(Some(32.0)))
                                      .height(view::Live::Is(Some(32.0)))
                                      .rigid()
                                      .center()
                                      .radius(view::Live::Is(8.0))
                                      .ground(view::Live::By(fn() -> Int64 {
                                        let tiles = get_tiles()
                                        if idx < tiles.length() { tiles[idx].accent } else { 0x2563EBFFL }
                                      }))
                                      let _ = ico.box(
                                        fn(ml : view::View) -> Unit {
                                          let _ = ml.words(
                                            view::Live::By(fn() -> String {
                                              let tiles = get_tiles()
                                              if idx < tiles.length() { tiles[idx].monogram } else { "·" }
                                            }),
                                            ink=0xFFFFFFFFL,
                                            look=view::WordsLook::{ ..view::words_plain, size: 14.5, weight: 700, wrap: false },
                                            one_line=true,
                                          )
                                        },
                                      )
                                    },
                                  )
                                  let _ = top.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                                  top.show(
                                    fn() -> Bool {
                                      let tiles = get_tiles()
                                      idx < tiles.length() && tiles[idx].is_bookmark
                                    },
                                    fn(st_badge : view::View) -> Unit {
                                      let _ = st_badge
                                      .words(
                                        view::Live::Is("★"),
                                        ink=0xF59E0BFFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                        one_line=true,
                                      )
                                    },
                                  )
                                },
                              )

                              // Title + Short Domain
                              let _ = card.box(
                                fn(meta : view::View) -> Unit {
                                  let _ = meta.gap(view::Live::Is(2.0))
                                  let _ = meta.box(
                                    fn(tl : view::View) -> Unit {
                                      let _ = tl
                                      .width(view::Live::Is(Some(112.0)))
                                      .clips(view::Live::Is(true))
                                      .words(
                                        view::Live::By(fn() -> String {
                                          let tiles = get_tiles()
                                          if idx < tiles.length() { tiles[idx].title } else { "" }
                                        }),
                                        ink=0x1D1D1FFFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                                        one_line=true,
                                      )
                                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                    },
                                  )
                                  let _ = meta.box(
                                    fn(hl : view::View) -> Unit {
                                      let _ = hl
                                      .width(view::Live::Is(Some(112.0)))
                                      .clips(view::Live::Is(true))
                                      .words(
                                        view::Live::By(fn() -> String {
                                          let tiles = get_tiles()
                                          if idx < tiles.length() { tiles[idx].host } else { "" }
                                        }),
                                        ink=0x6B7280FFL,
                                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                        one_line=true,
                                      )
                                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                    },
                                  )
                                },
                              )
                            },
                          )
                        },
                      )
                      c = c + 1
                    }
                  },
                )
              }
              render_tile_row(0)
              render_tile_row(4)
            },
          )

          // 4. Bottom Lightweight Quick-Action Capsules
          let _ = col.box(
            fn(pills : view::View) -> Unit {
              let _ = pills
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))

              let ks = ui::keys_system()
              let is_mac = ks == 0 || ks < 0
              let quick_pill = fn(label : String, key_hint : String, on_tap : () -> Unit) -> Unit {
                let _ = headless::button(
                  pills,
                  fn() -> String { label },
                  fn(_v : view::View) -> Unit { on_tap() },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let _ = b
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .height(view::Live::Is(Some(32.0)))
                    .rigid()
                    .padding(view::Live::Is((11.0, 0.0, 9.0, 0.0)))
                    .gap(view::Live::Is(7.0))
                    .radius(view::Live::Is(9.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if btn.pressed() {
                        p.btn_press
                      } else if btn.hovered() {
                        p.btn_hover
                      } else {
                        p.surface_bg
                      }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                    let _ = b.box(
                      fn(lb : view::View) -> Unit {
                        let _ = lb
                        .words(
                          view::Live::Is(label),
                          ink=0x3A4152FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                      },
                    )
                    let _ = b.box(
                      fn(kc : view::View) -> Unit {
                        let _ = kc
                        .height(view::Live::Is(Some(19.0)))
                        .rigid()
                        .center()
                        .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                        .radius(view::Live::Is(4.5))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                        let _ = kc.box(
                          fn(kt : view::View) -> Unit {
                            let _ = kt
                            .words(
                              view::Live::Is(key_hint),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                          },
                        )
                      },
                    )
                  },
                )
              }

              quick_pill("Bookmarks", if is_mac { "⇧⌘B" } else { "Ctrl+Shift+B" }, fn() -> Unit { open_bookmarks() })
              quick_pill("History", if is_mac { "⌘Y" } else { "Ctrl+Y" }, fn() -> Unit { open_history() })
              quick_pill("Settings", if is_mac { "⌘," } else { "Ctrl+," }, fn() -> Unit { open_settings() })
              quick_pill("Reader", if is_mac { "⌥⌘R" } else { "Ctrl+Alt+R" }, fn() -> Unit { toggle_reader_mode() })
              quick_pill("DevTools", if is_mac { "⌥⌘I" } else { "Ctrl+Shift+I" }, fn() -> Unit { toggle_devtools() })
            },
          )
        },
      )
    },
  )
}

fn ensure_demo_site_info_seeded() -> Unit {
  if app_state.cookies_snap.cookies.length() == 0 {
    let raw_u = active_address_raw_url_untracked()
    let host = {
      let h = proto::omnibox_display_host(raw_u)
      if h != "" { h } else { "example.com" }
    }
    let origin = {
      let o = proto::normalize_permission_origin(raw_u)
      if o != "" { o } else { "https://" + host }
    }
    app_state.cookies_snap = proto::SiteCookiesSnapshot::{
      host,
      origin,
      space_id: app_state.workspace.active_space_id,
      cookies: [
        proto::SiteCookieRow::{ name: "fv_session", domain: host, path: "/", value_preview: "a8f1••••9c2d (48 B)", secure: true, http_only: true, same_site: "Lax", partitioned: false, expires_label: "Session", is_session: true },
        proto::SiteCookieRow::{ name: "theme_pref", domain: host, path: "/", value_preview: "light (5 B)", secure: true, http_only: false, same_site: "Lax", partitioned: false, expires_label: "1y", is_session: false },
        proto::SiteCookieRow::{ name: "csrf_token", domain: host, path: "/", value_preview: "91e4••••44ba (32 B)", secure: true, http_only: true, same_site: "Strict", partitioned: true, expires_label: "12h", is_session: false },
        proto::SiteCookieRow::{ name: "locale", domain: host, path: "/", value_preview: "zh-CN (5 B)", secure: true, http_only: false, same_site: "Lax", partitioned: false, expires_label: "90d", is_session: false },
      ],
    }
    match app_state.cookies_rev {
      Some(r) => r.set(r.untracked() + 1)
      None => ()
    }
  }
}

///| Builds the upgraded Address Bar Site Security & Storage Inspector Popover (`🔒` lock icon or `⌘I`).
///| 100% reactive to `ChromePalette` Light & Dark themes, concentric radii 12 -> 8 -> 6.5 -> 4.5,
///| with HTTPS/Local/HTTP security header card, real `omnibox_analyze_url` IDN Domain Verification row,
///| Quick Site Status row (live Cookies count -> `open_cookies_modal()`, live Zoom % -> `open_zoom_popover()`),
///| active Boost indicator, 5 per-origin permissions (Camera, Microphone, Notifications, Location, Clipboard),
///| and Reset / Clear Site Data actions.
fn build_site_info_popover(
  root : view::View,
  st : stage::Stage,
  site_info_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  site_perms_rev : signals::Signal[Int],
  boosts_rev : signals::Signal[Int],
  cookies_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { site_info_open.get() },
    fn(pop : view::View) -> Unit {
      let _ = pop
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        match app_state.address_bar_view {
          Some(ab) => {
            let (ax, ay, aw, ah) = ab.placed_now()
            if aw > 120.0 {
              (Some(ax), Some(ay + ah + 6.0), None, None)
            } else {
              (Some(156.0), Some(48.0), None, None)
            }
          }
          None => (Some(156.0), Some(48.0), None, None)
        }
      }))
      .width(view::Live::Is(Some(356.0)))
      .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
      .gap(view::Live::Is(9.0))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (26.0, 10.0, 0x00000078L) } else { (22.0, 8.0, 0x0F172A28L) }
      }))

      let current_url = fn() -> String {
        let _ = workspace_rev.get()
        let u = active_address_raw_url()
        if u != "" {
          u
        } else {
          match app_state.workspace.permissions {
            Some(pm) if pm.origin != "" => pm.origin
            _ => "about:newtab"
          }
        }
      }
      let current_origin = fn() -> String {
        let u = current_url()
        let norm = proto::normalize_permission_origin(u)
        let raw_origin = if norm != "" { norm } else { proto::site_origin_from_url(u) }
        proto::omnibox_safe_display_url(raw_origin)
      }
      let sec_kind = fn() -> Int {
        // 0 = HTTPS secure, 1 = Local development, 2 = Not secure (HTTP)
        let u = current_url()
        if proto::site_is_https(u) {
          0
        } else if proto::site_is_local(u) || proto::is_start_page_url(u) {
          1
        } else {
          2
        }
      }
      let idn_info = fn() -> proto::SiteIdnVerification {
        proto::build_site_idn_verification(current_url())
      }
      let active_boost_opt = fn() -> Option[proto::SiteBoost] {
        let _ = boosts_rev.get()
        let h = proto::normalize_boost_host(current_url())
        if h == "" { None } else { proto::boosts_find(app_state.boosts_snap, h) }
      }

      // 1. Header: Origin + Connection Security Card + IDN Domain Verification Row + Optional Arc Boost Pill
      let _ = pop.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr.gap(view::Live::Is(7.0))

          // Origin line
          let _ = hdr.box(
            fn(orow : view::View) -> Unit {
              let _ = orow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))
              .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
              let _ = orow.box(
                fn(orig_w : view::View) -> Unit {
                  let _ = orig_w
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(current_origin),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              // Close button
              let _ = headless::button(
                orow,
                fn() -> String { "Close Site Info" },
                fn(_v : view::View) -> Unit { close_site_info() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(22.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Connection & Domain Security Header Card (HTTPS Encrypted / Local / HTTP + IDN Domain Verification)
          let _ = hdr.box(
            fn(sec_wrap : view::View) -> Unit {
              let _ = sec_wrap
              .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
              .gap(view::Live::Is(7.0))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() -> Int64 {
                let dark = is_dark_chrome()
                let idn = idn_info()
                if idn.status_code == 2 {
                  if dark { 0x322512FFL } else { 0xFFFBEBFFL }
                } else {
                  let k = sec_kind()
                  if k == 0 {
                    if dark { 0x132A21FFL } else { 0xECFDF3FFL }
                  } else if k == 1 {
                    if dark { 0x17253BFFL } else { 0xEFF6FFFFL }
                  } else if dark {
                    0x322512FFL
                  } else {
                    0xFFFBEBFFL
                  }
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let dark = is_dark_chrome()
                let idn = idn_info()
                if idn.status_code == 2 {
                  (1.0, if dark { 0x78350FFFL } else { 0xF3D08BFFL })
                } else {
                  let k = sec_kind()
                  if k == 0 {
                    (1.0, if dark { 0x1E4B38FFL } else { 0xBBF7D0FFL })
                  } else if k == 1 {
                    (1.0, if dark { 0x264169FFL } else { 0xBFDBFEFFL })
                  } else {
                    (1.0, if dark { 0x5B411BFFL } else { 0xFDE68AFFL })
                  }
                }
              }))

              // Connection status row
              let _ = sec_wrap.box(
                fn(conn_row : view::View) -> Unit {
                  let _ = conn_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(8.0))

                  let _ = conn_row.box(
                    fn(icon : view::View) -> Unit {
                      let _ = icon
                      .width(view::Live::Is(Some(16.0)))
                      .height(view::Live::Is(Some(16.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(8.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let k = sec_kind()
                        if k == 0 { 0x10B981FFL } else if k == 1 { 0x3B82F6FFL } else { 0xF59E0BFFL }
                      }))
                      let _ = icon.box(
                        fn(gl : view::View) -> Unit {
                          let _ = gl.words(
                            view::Live::By(fn() -> String {
                              let k = sec_kind()
                              if k == 0 { "✓" } else if k == 1 { "i" } else { "!" }
                            }),
                            ink=0xFFFFFFFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 700, wrap: false },
                            one_line=true,
                          )
                        },
                      )
                    },
                  )

                  let _ = conn_row.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::By(fn() -> String {
                          let k = sec_kind()
                          if k == 0 {
                            "HTTPS Encrypted"
                          } else if k == 1 {
                            "Local / HTTP"
                          } else {
                            "Not Secure (HTTP)"
                          }
                        }),
                        ink=0x137333FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let dark = is_dark_chrome()
                        let k = sec_kind()
                        if k == 0 {
                          if dark { 0x6EE7B7FFL } else { 0x15803DFFL }
                        } else if k == 1 {
                          if dark { 0x93C5FDFFL } else { 0x1D4ED8FFL }
                        } else if dark {
                          0xFCD34DFFL
                        } else {
                          0xB45309FFL
                        }
                      }))
                    },
                  )

                  // Protocol pill
                  let _ = conn_row.box(
                    fn(pb : view::View) -> Unit {
                      let _ = pb
                      .height(view::Live::Is(Some(19.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                      .radius(view::Live::Is(4.5))
                      .ground(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0x0F172A55L } else { 0xFFFFFFB8L }
                      }))
                      let _ = pb.box(
                        fn(pt : view::View) -> Unit {
                          let _ = pt
                          .words(
                            view::Live::By(fn() -> String {
                              let k = sec_kind()
                              if k == 0 { "TLS" } else if k == 1 { "LOCAL" } else { "HTTP" }
                            }),
                            ink=0x3A4152FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                    },
                  )
                },
              )

              // IDN Domain Verification Row (powered by `proto::omnibox_analyze_url`)
              let _ = sec_wrap.box(
                fn(idn_row : view::View) -> Unit {
                  let _ = idn_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(6.0))
                  .padding(view::Live::Is((8.0, 5.0, 8.0, 5.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let dark = is_dark_chrome()
                    let st_c = idn_info().status_code
                    if st_c == 2 {
                      if dark { 0x4A3314FFL } else { 0xFEF3C7FFL }
                    } else if dark {
                      0x0F172A44L
                    } else {
                      0xFFFFFFB0L
                    }
                  }))

                  let _ = idn_row.box(
                    fn(idot : view::View) -> Unit {
                      let _ = idot
                      .width(view::Live::Is(Some(6.0)))
                      .height(view::Live::Is(Some(6.0)))
                      .rigid()
                      .radius(view::Live::Is(3.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let st_c = idn_info().status_code
                        if st_c == 2 {
                          0xF59E0BFFL
                        } else if st_c == 1 || st_c == 0 {
                          0x10B981FFL
                        } else {
                          0x3B82F6FFL
                        }
                      }))
                    },
                  )

                  let _ = idn_row.box(
                    fn(ilbl : view::View) -> Unit {
                      let _ = ilbl
                      .rigid()
                      .words(
                        view::Live::By(fn() -> String { idn_info().badge_label }),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let dark = is_dark_chrome()
                        if idn_info().status_code == 2 {
                          if dark { 0xFBBF24FFL } else { 0x92400EFFL }
                        } else {
                          chrome_palette().ink_primary
                        }
                      }))
                    },
                  )

                  let _ = idn_row.box(
                    fn(idet : view::View) -> Unit {
                      let _ = idet
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::By(fn() -> String {
                          let info = idn_info()
                          if info.status_code == 2 && info.safe_punycode != "" {
                            info.safe_punycode
                          } else if info.status_code == 1 {
                            proto::omnibox_analyze_url(current_url()).display_host
                          } else {
                            info.detail_line
                          }
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let dark = is_dark_chrome()
                        if idn_info().status_code == 2 {
                          if dark { 0xFDE68AFFL } else { 0xB45309FFL }
                        } else {
                          chrome_palette().ink_muted
                        }
                      }))
                    },
                  )
                },
              )
            },
          )

          // Quick Site Status Row: Cookies count (-> open_cookies_modal) + Page Zoom (-> open_zoom_popover)
          let _ = hdr.box(
            fn(qrow : view::View) -> Unit {
              let _ = qrow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .width(view::Live::Is(Some(332.0)))
              .gap(view::Live::Is(8.0))

              // Cookies card button
              let _ = headless::button(
                qrow,
                fn() -> String { "Inspect Site Cookies" },
                fn(_v : view::View) -> Unit {
                  let h = proto::omnibox_display_host(current_url())
                  open_cookies_modal(host_override=h)
                },
                fn(cb : view::View, btn : headless::Button) -> Unit {
                  let _ = cb
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(46.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((10.0, 0.0, 9.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                  let _ = cb.box(
                    fn(cm : view::View) -> Unit {
                      let _ = cm
                      .grow(view::Live::Is(1.0))
                      .gap(view::Live::Is(2.0))
                      let _ = cm.box(
                        fn(k : view::View) -> Unit {
                          let _ = k
                          .words(
                            view::Live::Is("Cookies"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                      let _ = cm.box(
                        fn(v : view::View) -> Unit {
                          let _ = v
                          .words(
                            view::Live::By(fn() -> String {
                              let _ = cookies_rev.get()
                              proto::format_site_cookies_count(app_state.cookies_snap.cookies.length())
                            }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )

                  let _ = cb.box(
                    fn(ar : view::View) -> Unit {
                      let _ = ar
                      .rigid()
                      .words(
                        view::Live::Is("›"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Zoom card button
              let _ = headless::button(
                qrow,
                fn() -> String { "Open Zoom Controls" },
                fn(_v : view::View) -> Unit { open_zoom_popover() },
                fn(zb : view::View, btn : headless::Button) -> Unit {
                  let _ = zb
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(46.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((10.0, 0.0, 9.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))

                  let _ = zb.box(
                    fn(zm : view::View) -> Unit {
                      let _ = zm
                      .grow(view::Live::Is(1.0))
                      .gap(view::Live::Is(2.0))
                      let _ = zm.box(
                        fn(k : view::View) -> Unit {
                          let _ = k
                          .words(
                            view::Live::Is("Page Zoom"),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                      let _ = zm.box(
                        fn(v : view::View) -> Unit {
                          let _ = v
                          .words(
                            view::Live::By(fn() -> String { st.zoom_percent().to_string() + "%" }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )

                  let _ = zb.box(
                    fn(ar : view::View) -> Unit {
                      let _ = ar
                      .rigid()
                      .words(
                        view::Live::Is("›"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Optional Active Arc Boost Indicator (only rendered when a Boost is active for this host)
          hdr.show(
            fn() -> Bool { active_boost_opt().is_some() },
            fn(b_wrap : view::View) -> Unit {
              let _ = headless::button(
                b_wrap,
                fn() -> String { "Edit Active Arc Boost" },
                fn(_v : view::View) -> Unit {
                  close_site_info()
                  open_boosts()
                },
                fn(bp : view::View, btn : headless::Button) -> Unit {
                  let _ = bp
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(28.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(7.0))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let dark = is_dark_chrome()
                    if btn.pressed() {
                      if dark { 0x2F254DFFL } else { 0xDDD6FEFFL }
                    } else if btn.hovered() {
                      if dark { 0x282043FFL } else { 0xEDE9FEFFL }
                    } else if dark {
                      0x211B38FFL
                    } else {
                      0xF5F3FFFFL
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    (1.0, if is_dark_chrome() { 0x453573FFL } else { 0xDDD6FEFFL })
                  }))
                  let _ = bp.box(
                    fn(bi : view::View) -> Unit {
                      let _ = bi.words(
                        view::Live::Is("✦"),
                        ink=0x8B5CF6FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                  let _ = bp.box(
                    fn(bt : view::View) -> Unit {
                      let _ = bt
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("Arc Boost active on this site"),
                        ink=0x6D28D9FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0xC4B5FDFFL } else { 0x6D28D9FFL }
                      }))
                    },
                  )
                  let _ = bp.box(
                    fn(be : view::View) -> Unit {
                      let _ = be
                      .words(
                        view::Live::Is("Edit"),
                        ink=0x7C3AEDFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        if is_dark_chrome() { 0xA78BFAFFL } else { 0x7C3AEDFFL }
                      }))
                    },
                  )
                },
              )
            },
          )
        },
      )

      // Single 1pt divider
      let _ = pop.box(
        fn(sep : view::View) -> Unit {
          let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // 2. Site Permissions List (Camera, Microphone, Notifications, Location, Clipboard)
      let _ = pop.box(
        fn(psec : view::View) -> Unit {
          let _ = psec.gap(view::Live::Is(5.0))
          let _ = psec.box(
            fn(pl : view::View) -> Unit {
              let _ = pl
              .padding(view::Live::Is((2.0, 0.0, 2.0, 2.0)))
              .words(
                view::Live::Is("SITE PERMISSIONS"),
                ink=0x8E8E93FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )

          let render_perm_row = fn(label : String, kind_key : String, read_val : (proto::SitePermissionRule) -> String) -> Unit {
            let cur_state = fn() -> String {
              let _ = site_perms_rev.get()
              let r = active_site_permission_rule(current_url())
              proto::normalize_site_perm_value(read_val(r))
            }
            let _ = psec.box(
              fn(row : view::View) -> Unit {
                let _ = row
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .width(view::Live::Is(Some(332.0)))
                .height(view::Live::Is(Some(32.0)))
                .rigid()
                .gap(view::Live::Is(8.0))
                .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))

                // Status dot
                let _ = row.box(
                  fn(dot : view::View) -> Unit {
                    let _ = dot
                    .width(view::Live::Is(Some(6.0)))
                    .height(view::Live::Is(Some(6.0)))
                    .rigid()
                    .radius(view::Live::Is(3.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let s = cur_state()
                      if s == "allow" {
                        0x10B981FFL
                      } else if s == "block" {
                        0xEF4444FFL
                      } else if is_dark_chrome() {
                        0x475569FFL
                      } else {
                        0xCBD5E1FFL
                      }
                    }))
                  },
                )

                // Permission label
                let _ = row.box(
                  fn(nm : view::View) -> Unit {
                    let _ = nm
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .clips(view::Live::Is(true))
                    .words(
                      view::Live::Is(label),
                      ink=0x1D1D1FFFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                  },
                )

                // 3-state segmented capsule: Ask / Allow / Block (concentric R=6.5, P=2 -> R=4.5)
                let _ = row.box(
                  fn(seg : view::View) -> Unit {
                    let _ = seg
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .rigid()
                    .gap(view::Live::Is(2.0))
                    .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
                    .radius(view::Live::Is(6.5))
                    .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

                    let seg_btn = fn(btn_label : String, target_state : String) -> Unit {
                      let _ = headless::button(
                        seg,
                        fn() -> String { label + " " + btn_label },
                        fn(_v : view::View) -> Unit { dispatch_site_perm_set(current_url(), kind_key, target_state) },
                        fn(b : view::View, btn : headless::Button) -> Unit {
                          let active = fn() -> Bool { cur_state() == target_state }
                          let _ = b
                          .width(view::Live::Is(Some(46.0)))
                          .height(view::Live::Is(Some(22.0)))
                          .rigid()
                          .center()
                          .radius(view::Live::Is(4.5))
                          .ground(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if active() {
                              if target_state == "allow" {
                                if p.is_dark { 0x153428FFL } else { 0xE6F4EAFFL }
                              } else if target_state == "block" {
                                if p.is_dark { 0x3A1E24FFL } else { 0xFCE8E6FFL }
                              } else if p.is_dark {
                                0x303646FFL
                              } else {
                                0xFFFFFFFFL
                              }
                            } else if btn.pressed() {
                              p.btn_press
                            } else if btn.hovered() {
                              p.btn_hover
                            } else {
                              0x00000000L
                            }
                          }))
                          .edge(view::Live::By(fn() -> (Double, Int64) {
                            let p = chrome_palette()
                            if active() {
                              if target_state == "allow" {
                                (1.0, if p.is_dark { 0x225A43FFL } else { 0xA8DAB5FFL })
                              } else if target_state == "block" {
                                (1.0, if p.is_dark { 0x6B2D38FFL } else { 0xF6AEA9FFL })
                              } else {
                                (1.0, p.tab_active_border)
                              }
                            } else {
                              (1.0, 0x00000000L)
                            }
                          }))
                          let _ = b.box(
                            fn(lbl : view::View) -> Unit {
                              let _ = lbl
                              .words(
                                view::Live::Is(btn_label),
                                ink=0x6E6E73FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 {
                                let p = chrome_palette()
                                if active() {
                                  if target_state == "allow" {
                                    if p.is_dark { 0x6EE7B7FFL } else { 0x137333FFL }
                                  } else if target_state == "block" {
                                    if p.is_dark { 0xFCA5A5FFL } else { 0xC5221FFFL }
                                  } else {
                                    p.ink_primary
                                  }
                                } else {
                                  p.ink_muted
                                }
                              }))
                            },
                          )
                        },
                      )
                    }
                    seg_btn("Ask", "ask")
                    seg_btn("Allow", "allow")
                    seg_btn("Block", "block")
                  },
                )
              },
            )
          }

          render_perm_row("Camera", "camera", fn(r : proto::SitePermissionRule) -> String { r.camera })
          render_perm_row("Microphone", "microphone", fn(r : proto::SitePermissionRule) -> String { r.microphone })
          render_perm_row("Notifications", "notifications", fn(r : proto::SitePermissionRule) -> String { r.notifications })
          render_perm_row("Location", "geolocation", fn(r : proto::SitePermissionRule) -> String { r.geolocation })
          render_perm_row("Clipboard", "clipboard", fn(r : proto::SitePermissionRule) -> String { r.clipboard })
        },
      )

      // Single 1pt divider before bottom action row
      let _ = pop.box(
        fn(sep : view::View) -> Unit {
          let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // 4. Bottom Action Row: Reset permissions + Clear site data (danger outline)
      let _ = pop.box(
        fn(arow : view::View) -> Unit {
          let _ = arow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .width(view::Live::Is(Some(332.0)))
          .gap(view::Live::Is(8.0))

          let _ = headless::button(
            arow,
            fn() -> String { "Reset permissions" },
            fn(_v : view::View) -> Unit { dispatch_site_perm_reset(current_url()) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(30.0)))
              .center()
              .radius(view::Live::Is(7.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Reset permissions"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
            },
          )

          let _ = headless::button(
            arow,
            fn() -> String { "Clear site data" },
            fn(_v : view::View) -> Unit { dispatch_site_clear_data(current_url()) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(30.0)))
              .center()
              .radius(view::Live::Is(7.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() {
                  if p.is_dark { 0x4A232BFFL } else { 0xFEE2E2FFL }
                } else if btn.hovered() {
                  if p.is_dark { 0x3F2026FFL } else { 0xFEF2F2FFL }
                } else {
                  p.danger_bg
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().danger_border) }))
              let _ = b.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Clear site data"),
                    ink=0xDC2626FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                },
              )
            },
          )
        },
      )
    },
  )
}
