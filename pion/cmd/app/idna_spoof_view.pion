///| Address bar IDN homograph anti-spoofing warning capsule and explanation popover.
///| Powered by `proto::omnibox_analyze_url` (`packages/idna` UTS #46 + UTS #39).
///| Unmounts completely to 0px via `.show(...)` for normal ASCII URLs and legitimate IDNs.

fn active_address_raw_url() -> String {
  if app_state.demo_idn_url != "" {
    app_state.demo_idn_url
  } else {
    active_stage_live().url()
  }
}

fn active_address_raw_url_untracked() -> String {
  if app_state.demo_idn_url != "" {
    app_state.demo_idn_url
  } else {
    active_stage().url()
  }
}

fn current_url_safety() -> proto::OmniboxUrlSafety {
  proto::omnibox_analyze_url(active_address_raw_url())
}

fn close_idn_popover() -> Unit {
  match app_state.idn_popover_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
}

fn toggle_idn_popover() -> Unit {
  match app_state.idn_popover_open {
    Some(s) => {
      let next = !s.untracked()
      if next {
        close_exclusive_overlays()
      }
      s.set(next)
    }
    None => ()
  }
}

///| Amber `IDN Warning` capsule mounted inside the address bar beside the security lock icon.
///| Completely unmounted (0px, non-clickable) unless `is_spoof_warning` is true.
fn build_idna_spoof_capsule(
  f : view::View,
  idn_popover_open : signals::Signal[Bool],
) -> Unit {
  f.show(
    fn() -> Bool { current_url_safety().is_spoof_warning },
    fn(wrap : view::View) -> Unit {
      let _ = wrap.rigid()
      let _ = headless::button(
        wrap,
        fn() -> String { "IDN Spoofing Warning" },
        fn(_v : view::View) -> Unit { toggle_idn_popover() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b
          .keeps_held(view::Live::Is(true))
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(22.0)))
          .rigid()
          .gap(view::Live::Is(5.0))
          .padding(view::Live::Is((5.0, 0.0, 8.0, 0.0)))
          .radius(view::Live::Is(5.0))
          .ground(view::Live::By(fn() -> Int64 {
            let dark = is_dark_chrome()
            if idn_popover_open.get() {
              if dark { 0x4A3314FFL } else { 0xFDE68AFFL }
            } else if btn.pressed() {
              if dark { 0x593E18FFL } else { 0xFCD34DFFL }
            } else if btn.hovered() {
              if dark { 0x4A3314FFL } else { 0xFDE68AFFL }
            } else if dark {
              0x3A2810FFL
            } else {
              0xFEF3C7FFL
            }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let dark = is_dark_chrome()
            if idn_popover_open.get() {
              (1.0, if dark { 0xF59E0BFFL } else { 0xD97706FFL })
            } else {
              (1.0, if dark { 0x92400EFFL } else { 0xE5B454FFL })
            }
          }))
          // Crisp 14x14 amber warning emblem
          let _ = b.box(
            fn(em : view::View) -> Unit {
              let _ = em
              .width(view::Live::Is(Some(14.0)))
              .height(view::Live::Is(Some(14.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(3.5))
              .ground(view::Live::By(fn() -> Int64 {
                if is_dark_chrome() { 0xF59E0BFFL } else { 0xD97706FFL }
              }))
              let _ = em.box(
                fn(bang : view::View) -> Unit {
                  let _ = bang
                  .words(
                    view::Live::Is("!"),
                    ink=0xFFFFFFFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 700, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    if is_dark_chrome() { 0x111318FFL } else { 0xFFFFFFFFL }
                  }))
                },
              )
            },
          )
          // Capsule label
          let _ = b.box(
            fn(lbl : view::View) -> Unit {
              let _ = lbl
              .words(
                view::Live::Is("IDN Warning"),
                ink=0x92400EFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                if is_dark_chrome() { 0xFBBF24FFL } else { 0x92400EFFL }
              }))
            },
          )
        },
      )
    },
  )
}

///| Explanation popover anchored under the address bar when clicking `IDN Warning`.
///| Concentric corner radii (12 -> 8 -> 6pt), single 1pt hairline borders, Light & Dark Chrome support.
fn build_idna_spoof_popover(
  root : view::View,
  idn_popover_open : signals::Signal[Bool],
) -> Unit {
  root.show(
    fn() -> Bool { idn_popover_open.get() && current_url_safety().is_spoof_warning },
    fn(pop : view::View) -> Unit {
      let _ = pop
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        match app_state.address_bar_view {
          Some(ab) => {
            let (ax, ay, aw, ah) = ab.placed_now()
            if aw > 120.0 {
              (Some(ax), Some(ay + ah + 6.0), None, None)
            } else {
              (Some(156.0), Some(48.0), None, None)
            }
          }
          None => (Some(156.0), Some(48.0), None, None)
        }
      }))
      .width(view::Live::Is(Some(356.0)))
      .padding(view::Live::Is((14.0, 12.0, 14.0, 14.0)))
      .gap(view::Live::Is(10.0))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (26.0, 10.0, 0x00000078L) } else { (22.0, 8.0, 0x0F172A28L) }
      }))

      // 1. Header row: warning icon + title + close button
      let _ = pop.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
          let _ = hdr.box(
            fn(ic : view::View) -> Unit {
              let _ = ic
              .width(view::Live::Is(Some(20.0)))
              .height(view::Live::Is(Some(20.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_dark_chrome() { 0x4A3314FFL } else { 0xFEF3C7FFL }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                (1.0, if is_dark_chrome() { 0xB45309FFL } else { 0xE5B454FFL })
              }))
              let _ = ic.box(
                fn(b : view::View) -> Unit {
                  let _ = b
                  .words(
                    view::Live::Is("!"),
                    ink=0xB45309FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 700, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    if is_dark_chrome() { 0xFBBF24FFL } else { 0xB45309FFL }
                  }))
                },
              )
            },
          )
          let _ = hdr.box(
            fn(ttl : view::View) -> Unit {
              let _ = ttl
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .words(
                view::Live::Is("Lookalike Domain Warning"),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )
          let _ = headless::button(
            hdr,
            fn() -> String { "Close IDN Warning" },
            fn(_v : view::View) -> Unit { close_idn_popover() },
            fn(xb : view::View, xbtn : headless::Button) -> Unit {
              let _ = xb
              .width(view::Live::Is(Some(22.0)))
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
              }))
              let _ = xb.box(
                fn(xl : view::View) -> Unit {
                  let _ = xl
                  .words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )

      // 2. Safe Punycode host card (concentric radius 8pt)
      let _ = pop.box(
        fn(host_card : view::View) -> Unit {
          let _ = host_card
          .padding(view::Live::Is((10.0, 8.0, 10.0, 8.0)))
          .gap(view::Live::Is(4.0))
          .radius(view::Live::Is(8.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
          let _ = host_card.box(
            fn(k : view::View) -> Unit {
              let _ = k
              .words(
                view::Live::Is("SAFE PUNYCODE HOST"),
                ink=0x6B7280FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )
          let _ = host_card.box(
            fn(v : view::View) -> Unit {
              let _ = v
              .words(
                view::Live::By(fn() -> String { current_url_safety().display_host }),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: true },
                one_line=false,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )
        },
      )

      // 3. Detection reason card (amber semantic tint, concentric radius 8pt)
      let _ = pop.box(
        fn(reason_card : view::View) -> Unit {
          let _ = reason_card
          .padding(view::Live::Is((10.0, 8.0, 10.0, 8.0)))
          .gap(view::Live::Is(4.0))
          .radius(view::Live::Is(8.0))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x312310FFL } else { 0xFFFBEBFFL }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            (1.0, if is_dark_chrome() { 0x78350FFFL } else { 0xF3D08BFFL })
          }))
          let _ = reason_card.box(
            fn(rk : view::View) -> Unit {
              let _ = rk
              .words(
                view::Live::Is("DETECTION REASON"),
                ink=0xB45309FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 {
                if is_dark_chrome() { 0xF59E0BFFL } else { 0xB45309FFL }
              }))
            },
          )
          let _ = reason_card.box(
            fn(rv : view::View) -> Unit {
              let _ = rv
              .words(
                view::Live::By(fn() -> String { current_url_safety().warning_summary }),
                ink=0x92400EFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: true },
                one_line=false,
              )
              .ink(view::Live::By(fn() -> Int64 {
                if is_dark_chrome() { 0xFDE68AFFL } else { 0x92400EFFL }
              }))
            },
          )
        },
      )

      // 4. Concise anti-spoofing explanation
      let _ = pop.box(
        fn(desc : view::View) -> Unit {
          let _ = desc
          .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
          .words(
            view::Live::By(fn() -> String { current_url_safety().warning_detail }),
            ink=0x3A4152FFL,
            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: true },
            one_line=false,
          )
          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
        },
      )
    },
  )
}
