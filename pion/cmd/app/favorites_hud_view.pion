///| Arc Daily-Driver Desktop Chrome UX Components (Batch 18B):
///| 3. Live Page Performance & Security HUD Overlay (`build_perf_hud_overlay`, wire tag 67):
///|    Floating top-right Engine & Page HUD card with HTTPS/HTTP badge, Refresh, Close,
///|    2x3 compact metric grid (DOM Nodes, Stylesheets, Images, Viewport/Doc, Zoom, Site Cookies),
///|    and Space + Pure-Pion Metal Engine status footer.
///| 100% reactive to Light & Dark `ChromePalette`, concentric radii, zero double dividers,
///| zero `alpha=0` clickable controls, and zero `ellipsis_past(true)`.

///| 3. Live Page Performance & Security HUD Overlay (`wire` tag 67 `PerfHudState`).
///| Mounted before context menus/popovers so menus always layer above it.
fn build_perf_hud_overlay(
  root : view::View,
  perf_hud_open : signals::Signal[Bool],
  perf_hud_rev : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool { perf_hud_open.get() },
    fn(card : view::View) -> Unit {
      let get_hud = fn() -> proto::PerfHudSnapshot {
        let _ = perf_hud_rev.get()
        app_state.perf_hud_snap
      }
      let _ = card
      .over_at(view::Live::Is((None, Some(54.0), Some(16.0), None)))
      .width(view::Live::Is(Some(324.0)))
      .rigid()
      .clips(view::Live::Is(true))
      .padding(view::Live::Is((12.0, 11.0, 12.0, 11.0)))
      .gap(view::Live::Is(9.0))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::By(fn() -> Int64 {
        let p = chrome_palette()
        if p.is_dark { 0x1A1E28F2L } else { 0xFFFFFFF5L }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        let p = chrome_palette()
        (1.0, if p.is_dark { 0x323848FFL } else { 0xD8DCE8FFL })
      }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        let p = chrome_palette()
        if p.is_dark { (22.0, 8.0, 0x00000068L) } else { (20.0, 6.0, 0x0F172A24L) }
      }))

      // Top header row: live dot + "Page & Engine HUD" + HTTPS/HTTP badge + Refresh + Close
      let _ = card.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(6.0))
          // Live status pulse dot
          let _ = hdr.box(
            fn(dot : view::View) -> Unit {
              let _ = dot
              .width(view::Live::Is(Some(7.0)))
              .height(view::Live::Is(Some(7.0)))
              .rigid()
              .radius(view::Live::Is(3.5))
              .ground(view::Live::By(fn() -> Int64 {
                let s = get_hud()
                if s.is_https { 0x10B981FFL } else { 0xF59E0BFFL }
              }))
            },
          )
          // Title
          let _ = hdr.box(
            fn(ttl : view::View) -> Unit {
              let _ = ttl
              .words(
                view::Live::Is("Page & Engine HUD"),
                ink=0x1D1D1FFFL,
                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
            },
          )
          // Security badge ("HTTPS" / "HTTP" / "LOCAL")
          let _ = hdr.box(
            fn(sec : view::View) -> Unit {
              let _ = sec
              .height(view::Live::Is(Some(18.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 {
                let dark = is_dark_chrome()
                let s = get_hud()
                if s.is_https {
                  if dark { 0x133528FFL } else { 0xDCFCE7FFL }
                } else if dark {
                  0x3A2A14FFL
                } else {
                  0xFEF3C7FFL
                }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                let dark = is_dark_chrome()
                let s = get_hud()
                if s.is_https {
                  (0.8, if dark { 0x225B43FFL } else { 0xBBF7D0FFL })
                } else {
                  (0.8, if dark { 0x6B4B1EFFL } else { 0xFDE68AFFL })
                }
              }))
              let _ = sec.box(
                fn(sl : view::View) -> Unit {
                  let _ = sl
                  .words(
                    view::Live::By(fn() -> String {
                      let s = get_hud()
                      proto::perf_hud_security_badge(s.scheme, s.is_https)
                    }),
                    ink=0x15803DFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 {
                    let dark = is_dark_chrome()
                    let s = get_hud()
                    if s.is_https {
                      if dark { 0x34D399FFL } else { 0x15803DFFL }
                    } else if dark {
                      0xFBBF24FFL
                    } else {
                      0xB45309FFL
                    }
                  }))
                },
              )
            },
          )
          // Flexible spacer
          let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
          // Refresh button
          let _ = headless::button(
            hdr,
            fn() -> String { "Refresh HUD" },
            fn(_v : view::View) -> Unit { dispatch_perf_hud_sync() },
            fn(rb : view::View, btn : headless::Button) -> Unit {
              let _ = rb
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { p.surface_subtle }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) { (0.8, chrome_palette().border) }))
              let _ = rb.box(
                fn(rl : view::View) -> Unit {
                  let _ = rl
                  .words(
                    view::Live::Is("Refresh"),
                    ink=0x3A4152FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                },
              )
            },
          )
          // Close button
          let _ = headless::button(
            hdr,
            fn() -> String { "Close HUD" },
            fn(_v : view::View) -> Unit { close_perf_hud() },
            fn(cb : view::View, btn : headless::Button) -> Unit {
              let _ = cb
              .width(view::Live::Is(Some(22.0)))
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                let p = chrome_palette()
                if btn.pressed() { p.btn_press } else if btn.hovered() { p.btn_hover } else { 0x00000000L }
              }))
              let _ = cb.box(
                fn(cl : view::View) -> Unit {
                  let _ = cl
                  .words(
                    view::Live::Is("×"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )
        },
      )

      // Active host sub-line (single-line clipped)
      let _ = card.box(
        fn(host_row : view::View) -> Unit {
          let _ = host_row
          .min_width(view::Live::Is(Some(0.0)))
          .clips(view::Live::Is(true))
          .words(
            view::Live::By(fn() -> String {
              let s = get_hud()
              let h = if s.host != "" { s.host } else { proto::omnibox_display_host(active_stage_live().url()) }
              if h != "" { h } else { "about:blank" }
            }),
            ink=0x6B7280FFL,
            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
            one_line=true,
          )
          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
        },
      )

      // Helper for each compact metric card in the 2x3 grid
      let render_metric = fn(parent : view::View, title : String, val_fn : () -> String, accent_val : Bool) -> Unit {
        let _ = parent.box(
          fn(mc : view::View) -> Unit {
            let _ = mc
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .clips(view::Live::Is(true))
            .padding(view::Live::Is((8.0, 7.0, 8.0, 7.0)))
            .gap(view::Live::Is(3.0))
            .radius(view::Live::Is(8.0))
            .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
            .edge(view::Live::By(fn() -> (Double, Int64) {
              let p = chrome_palette()
              (1.0, if p.is_dark { 0x2E3446FFL } else { p.hairline })
            }))
            let _ = mc.box(
              fn(k : view::View) -> Unit {
                let _ = k
                .min_width(view::Live::Is(Some(0.0)))
                .clips(view::Live::Is(true))
                .words(
                  view::Live::Is(title),
                  ink=0x6B7280FFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 500, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
              },
            )
            let _ = mc.box(
              fn(v : view::View) -> Unit {
                let _ = v
                .min_width(view::Live::Is(Some(0.0)))
                .clips(view::Live::Is(true))
                .words(
                  view::Live::By(val_fn),
                  ink=0x1D1D1FFFL,
                  look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                  one_line=true,
                )
                .ink(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if accent_val { p.accent } else { p.ink_primary }
                }))
              },
            )
          },
        )
      }

      // Row 1: DOM Nodes | Stylesheets | Images
      let _ = card.box(
        fn(r1 : view::View) -> Unit {
          let _ = r1.row(view::Live::Is(true)).rigid().gap(view::Live::Is(6.0))
          render_metric(r1, "DOM Nodes", fn() -> String { proto::perf_hud_format_count(get_hud().dom_nodes) }, true)
          render_metric(r1, "Stylesheets", fn() -> String { proto::perf_hud_format_count(get_hud().stylesheets) }, false)
          render_metric(r1, "Images", fn() -> String { proto::perf_hud_format_count(get_hud().images) }, false)
        },
      )

      // Row 2: Viewport / Doc | Zoom | Site Cookies
      let _ = card.box(
        fn(r2 : view::View) -> Unit {
          let _ = r2.row(view::Live::Is(true)).rigid().gap(view::Live::Is(6.0))
          render_metric(
            r2,
            "Viewport / Doc",
            fn() -> String {
              let s = get_hud()
              proto::perf_hud_format_dims(s.doc_width, s.doc_height)
            },
            false,
          )
          render_metric(r2, "Zoom", fn() -> String { proto::perf_hud_format_zoom(get_hud().zoom_pct) }, false)
          render_metric(r2, "Site Cookies", fn() -> String { proto::perf_hud_format_count(get_hud().cookies_count) }, false)
        },
      )

      // Single hairline divider
      let _ = card.box(
        fn(div : view::View) -> Unit {
          let _ = div
          .height(view::Live::Is(Some(1.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )

      // Bottom status row: Space badge + Pure-Pion Metal Engine label
      let _ = card.box(
        fn(ftr : view::View) -> Unit {
          let _ = ftr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .rigid()
          .gap(view::Live::Is(6.0))
          let _ = ftr.box(
            fn(sp_pill : view::View) -> Unit {
              let _ = sp_pill
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(19.0)))
              .rigid()
              .gap(view::Live::Is(5.0))
              .padding(view::Live::Is((6.0, 0.0, 7.0, 0.0)))
              .radius(view::Live::Is(5.0))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
              let _ = sp_pill.box(
                fn(sdot : view::View) -> Unit {
                  let _ = sdot
                  .width(view::Live::Is(Some(6.0)))
                  .height(view::Live::Is(Some(6.0)))
                  .radius(view::Live::Is(3.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let _ = workspace_rev.get()
                    match proto::workspace_active_space(app_state.workspace) {
                      Some(sp) => proto::workspace_accent_color(sp.accent)
                      None => chrome_palette().accent
                    }
                  }))
                },
              )
              let _ = sp_pill.box(
                fn(slbl : view::View) -> Unit {
                  let _ = slbl
                  .words(
                    view::Live::By(fn() -> String {
                      let s = get_hud()
                      if s.active_space != "" { "Space: " + s.active_space } else { "Space: Work" }
                    }),
                    ink=0x3A4152FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                },
              )
            },
          )
          let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
          let _ = ftr.box(
            fn(eng : view::View) -> Unit {
              let _ = eng
              .words(
                view::Live::Is("Pure-Pion Metal Engine"),
                ink=0x6B7280FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )
        },
      )
    },
  )
}
