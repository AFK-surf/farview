///| What a page asks the app to open, and the middle button: a link opened in a new tab (Cmd/Ctrl+click, the middle
///| button, target=_blank, window.open) becomes a workspace tab; a person's Cmd/middle click opens it behind the
///| active tab so the page on screen stays, Cmd+Shift+click and a page's own opens bring it to the front.

struct PageOpens {
  // the last Stage::opens_seq count taken, per pane (primary, split/peek); -1 not seen yet (its count then is
  // where it stands, nothing reopened when a pane comes back)
  seen : Array[Int]
  mut middle_installed : Bool
  mut middle_down : Option[(Double, Double)]
}

let page_opens : PageOpens = PageOpens::{ seen: [-1, -1], middle_installed: false, middle_down: None }

///| Opens `u` as a workspace tab: in front (the one host page goes there) or behind (listed only, loaded once switched
///| to).
fn open_page_tab(u : String, front : Bool) -> Unit {
  if u == "" {
    return
  }
  if front {
    dispatch_tab_new(u, "")
  } else {
    send_wire(wire::Message::Act("tab_new_bg", u, proto::omnibox_display_host(u)))
  }
}

fn take_page_opens(slot : Int, st : stage::Stage) -> Unit {
  let (n, u, front) = st.opens_seq()
  if page_opens.seen[slot] < 0 {
    page_opens.seen[slot] = n
    return
  }
  if n != page_opens.seen[slot] {
    page_opens.seen[slot] = n
    open_page_tab(u, front)
  }
}

///| Once a frame, before drawing (pump_io_frame): the opens each pane's page asked for since the last frame.
fn pump_page_opens() -> Unit {
  if !page_opens.middle_installed {
    page_opens.middle_installed = true
    install_middle_click()
  }
  match app_state.stage {
    Some(st) => take_page_opens(0, st)
    None => ()
  }
  match app_state.split_stage {
    Some(st) => take_page_opens(1, st)
    None => ()
  }
}

///| The middle button (the host's button 3) is not a primary press: down and up within a few points over a page's
///| link opens it in a new tab behind; anywhere else it does nothing (it never reaches the page as a click).
fn install_middle_click() -> Unit {
  ui::set_pointer_interceptor(
    Some(fn(kind : Int, x : Double, y : Double, button : Int, _mods : Int) -> Bool {
      if button != 3 {
        return false
      }
      if kind == 1 {
        page_opens.middle_down = Some((x, y))
        return true
      }
      if kind == 2 {
        match page_opens.middle_down {
          Some((x0, y0)) => {
            page_opens.middle_down = None
            if (x - x0).abs() <= 6.0 && (y - y0).abs() <= 6.0 {
              let done = match app_state.split_stage {
                Some(sp) if is_split_open() || is_peek_open() => sp.middle_click_window(x, y)
                _ => false
              }
              if !done {
                let _ = get_stage().middle_click_window(x, y)
              }
            }
          }
          None => ()
        }
        return true
      }
      false
    }),
  )
}
