///| The password manager, app side: the host's prompt opens the Save popover and Save / Never answer it; the list,
///| show / copy (a password only on request, only to here) and delete; a stale autofill answer is dropped.

import "proto"

fn pwa_acts(sent : Array[wire::Message], verb : String) -> Array[String] {
  let out : Array[String] = []
  for m in sent {
    match m {
      wire::Message::Act(v, a, _) if v == verb => out.push(a)
      _ => ()
    }
  }
  out
}

test "passwords app: the host's prompt opens Save; Save sends the edited username, Never asks never again" {
  shell_adapter_reset()
  let sent : Array[wire::Message] = []
  let prev_hook = test_send_wire_hook.v
  test_send_wire_hook.v = Some(fn(m : wire::Message) -> Unit { sent.push(m) })
  let p = proto::PasswordPromptState::{
    visible: true,
    prompt_id: "pp-9",
    kind: "save",
    origin: "https://example.com",
    username: "ada",
    display_name: "example.com",
    password_len: 8,
  }
  debug_assert(take_host_password_act(proto::PW_VERB_PROMPT, proto::encode_password_prompt(p)), "taken")
  debug_assert(pw_prompt_open.untracked(), "the popover opens")
  let (user_f, _) = pw_username_search_fields()
  debug_assert(user_f.text() == "ada", "with the username")
  pw_prompt_save("ada.l ")
  let saves = pwa_acts(sent, proto::PW_VERB_SAVE)
  debug_assert(saves.length() == 1 && !pw_prompt_open.untracked(), "saved and closed")
  match proto::parse_password_command(saves[0]) {
    Some(c) => debug_assert(c.prompt_id == "pp-9" && c.username == "ada.l", "the prompt, the edited username")
    None => debug_assert(false, "command")
  }
  // a second prompt: Never
  let _ = take_host_password_act(proto::PW_VERB_PROMPT, proto::encode_password_prompt({ ..p, prompt_id: "pp-10" }))
  pw_prompt_dismiss(true)
  let ds = pwa_acts(sent, proto::PW_VERB_DISMISS)
  debug_assert(ds.length() == 1 && ds[0].contains("\"never\":true") && ds[0].contains("pp-10"), "never")
  // the host hiding another prompt leaves an open one alone; hiding this one closes it
  let _ = take_host_password_act(proto::PW_VERB_PROMPT, proto::encode_password_prompt({ ..p, prompt_id: "pp-11" }))
  let _ = take_host_password_act(proto::PW_VERB_PROMPT, proto::encode_password_prompt({ ..proto::PasswordPromptState::hidden(), prompt_id: "pp-3" }))
  debug_assert(pw_prompt_open.untracked(), "another prompt's hide leaves this one")
  let _ = take_host_password_act(proto::PW_VERB_PROMPT, proto::encode_password_prompt({ ..proto::PasswordPromptState::hidden(), prompt_id: "pp-11" }))
  debug_assert(!pw_prompt_open.untracked(), "its own hide closes it")
  debug_assert(!take_host_password_act("bookmarks_state", "{}"), "other verbs are not ours")
  test_send_wire_hook.v = prev_hook
  shell_adapter_reset()
}

test "passwords app: the list, Show and Copy ask the host once each, and a deleted login is hidden" {
  shell_adapter_reset()
  let sent : Array[wire::Message] = []
  let prev_hook = test_send_wire_hook.v
  test_send_wire_hook.v = Some(fn(m : wire::Message) -> Unit { sent.push(m) })
  let copied : Array[String] = []
  let prev_clip = test_clipboard_write_hook.v
  test_clipboard_write_hook.v = Some(fn(s : String) -> Unit { copied.push(s) })
  let item = proto::PasswordItemSummary::{
    id: "pw-1",
    origin: "https://example.com",
    signon_realm: "https://example.com/",
    username: "ada",
    display_name: "",
    created_at: 0L,
    updated_at: 0L,
    last_used_at: 0L,
    times_used: 0,
  }
  let _ = take_host_password_act(proto::PW_VERB_STATE, proto::encode_password_list({ query: "", items: [item] }))
  debug_assert(pw_items.untracked().length() == 1, "listed")
  let props = build_settings_passwords_props()
  (props.on_show)("pw-1")
  let rv = pwa_acts(sent, proto::PW_VERB_REVEAL)
  debug_assert(rv.length() == 1, "asked once")
  let req = match proto::parse_password_command(rv[0]) {
    Some(c) => c.req_id
    None => ""
  }
  let _ = take_host_password_act(proto::PW_VERB_REVEALED, proto::encode_password_reveal({ req_id: req, id: "pw-1", ok: true, password: "hunter2" }))
  debug_assert(
    match (props.revealed)("pw-1") {
      Some(p) => p == "hunter2"
      None => false
    },
    "shown",
  )
  (props.on_hide)("pw-1")
  debug_assert((props.revealed)("pw-1") is None, "hidden: let go")
  // copy password: on the clipboard, not shown
  (props.on_copy_password)("pw-1")
  let rv2 = pwa_acts(sent, proto::PW_VERB_REVEAL)
  let req2 = match proto::parse_password_command(rv2[rv2.length() - 1]) {
    Some(c) => c.req_id
    None => ""
  }
  let _ = take_host_password_act(proto::PW_VERB_REVEALED, proto::encode_password_reveal({ req_id: req2, id: "pw-1", ok: true, password: "hunter2" }))
  debug_assert(copied.length() == 1 && copied[0] == "hunter2" && (props.revealed)("pw-1") is None, "copied, not shown")
  // an answer to no request does nothing
  let _ = take_host_password_act(proto::PW_VERB_REVEALED, proto::encode_password_reveal({ req_id: "rv-999", id: "pw-1", ok: true, password: "x" }))
  debug_assert(copied.length() == 1, "unasked answer ignored")
  (props.on_copy_username)("pw-1")
  debug_assert(copied.length() == 2 && copied[1] == "ada", "username copied locally")
  // shown, then deleted on the host: hidden
  (props.on_show)("pw-1")
  let rv3 = pwa_acts(sent, proto::PW_VERB_REVEAL)
  let req3 = match proto::parse_password_command(rv3[rv3.length() - 1]) {
    Some(c) => c.req_id
    None => ""
  }
  let _ = take_host_password_act(proto::PW_VERB_REVEALED, proto::encode_password_reveal({ req_id: req3, id: "pw-1", ok: true, password: "hunter2" }))
  let _ = take_host_password_act(proto::PW_VERB_STATE, proto::encode_password_list({ query: "", items: [] }))
  debug_assert((props.revealed)("pw-1") is None && pw_items.untracked().length() == 0, "gone")
  (props.on_delete)("pw-1")
  debug_assert(pwa_acts(sent, proto::PW_VERB_DELETE).length() == 1, "delete sent")
  // a stale autofill answer (another request) opens nothing
  pw_query_req.v = "af-77"
  let _ = take_host_password_act(
    proto::PW_VERB_SUGGESTIONS,
    proto::encode_autofill_snapshot({ ..proto::AutofillSnapshot::empty(), req_id: "af-1", can_generate: true }),
  )
  debug_assert(!pw_dropdown_open.untracked(), "stale answer dropped")
  test_clipboard_write_hook.v = prev_clip
  test_send_wire_hook.v = prev_hook
  shell_adapter_reset()
}
