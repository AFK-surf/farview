///| Downloads and Split View on this machine's files, on every OS: a Windows host's path is a path here, names
///| Windows refuses never reach the Downloads folder, a download of the same name again (changed, or empty) is
///| kept, folders are made as deep as needed, only a regular file is handed to the opener, a picture is never read
///| whole when it is too large, and the split host's Windows command line keeps its URL one argument.

import "proto"

extern "C" fn dft_quote_arg(src : Ptr, src_len : Int, out : Ptr, cap : Int) -> Int = "fv_app_win_quote_arg"

extern "C" fn dft_env_dropped(kv : Ptr) -> Int = "fv_app_split_env_dropped"

extern "C" fn dft_open_ok(path : Ptr, path_len : Int) -> Int = "fv_app_open_target_ok"

extern "C" fn dft_state_dir(port : Int, out : Ptr, cap : Int) -> Int = "fv_app_split_state_dir"

extern "C" fn dft_getenv(name : Ptr) -> Ptr = "getenv"

extern "C" fn dft_remove(path : Ptr) -> Int = "remove"

fn dft_env(name : String) -> String {
  let nb = (name + "\u{0}").to_bytes()
  let p = dft_getenv(bytes_data_ptr(nb))
  if ptr_is_null(p) { "" } else { cstr_to_str(p) }
}

fn dft_bytes_string(b : Bytes, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_byte(b[i])
    i += 1
  }
  sb.to_string()
}

fn dft_quote(s : String, cap : Int) -> String {
  let ib = s.to_bytes()
  let out = Bytes::new(cap)
  let n = dft_quote_arg(bytes_data_ptr(ib), ib.length(), bytes_data_ptr(out), cap)
  if n < 0 { "<too small>" } else { dft_bytes_string(out, n) }
}

fn dft_dropped(kv : String) -> Bool {
  let b = (kv + "\u{0}").to_bytes()
  dft_env_dropped(bytes_data_ptr(b)) == 1
}

fn dft_open_target(path : String) -> Bool {
  let b = path.to_bytes()
  dft_open_ok(bytes_data_ptr(b), b.length()) == 1
}

fn dft_write(path : String, body : String) -> Int {
  let pb = path.to_bytes()
  let data = body.to_bytes()
  let addr = if data.length() > 0 { c_bytes_addr(bytes_data_ptr(data)) } else { 0L }
  let rc = c_write_new_file_at(bytes_data_ptr(pb), pb.length(), addr, data.length())
  if data.length() < 0 || pb.length() < 0 {
    panic("unreachable")
  }
  rc
}

fn dft_size(path : String) -> Int64 {
  let pb = path.to_bytes()
  c_file_size(bytes_data_ptr(pb), pb.length())
}

fn dft_rm(path : String) -> Unit {
  let pb = (path + "\u{0}").to_bytes()
  let _ = dft_remove(bytes_data_ptr(pb))
}

///| A fresh folder under this machine's temporary one (made by the first file written in it).
fn dft_scratch(tag : String) -> String {
  let t = if dft_env("TMPDIR") != "" {
    dft_env("TMPDIR")
  } else if dft_env("TEMP") != "" {
    dft_env("TEMP")
  } else if dft_env("TMP") != "" {
    dft_env("TMP")
  } else {
    "/tmp"
  }
  let base = if t.ends_with("/") || t.ends_with("\\") { t.slice(0, t.length() - 1) } else { t }
  base + "/fv-" + tag + "-" + hostapi::wall_ms().to_int64().to_string()
}

test "split view (Windows): the host's command line keeps a URL with quotes or backslashes one argument" {
  // (CommandLineToArgvW / MSVC rules: always quoted, \" for a quote, backslashes before a quote doubled)
  debug_assert(dft_quote("https://a.test/x?q=1", 64) == "\"https://a.test/x?q=1\"", "a plain URL")
  debug_assert(dft_quote("x\" --evil \"y", 64) == "\"x\\\" --evil \\\"y\"", "a quote stays inside the argument")
  debug_assert(dft_quote("a\\", 64) == "\"a\\\\\"", "a trailing backslash does not escape the closing quote")
  debug_assert(dft_quote("a\\\"b", 64) == "\"a\\\\\\\"b\"", "a backslash before a quote")
  debug_assert(dft_quote("C:\\Program Files\\Farview\\pion-host.exe", 128) == "\"C:\\Program Files\\Farview\\pion-host.exe\"", "other backslashes kept")
  debug_assert(dft_quote("", 8) == "\"\"", "an empty argument")
  debug_assert(dft_quote("abc", 4) == "<too small>", "never past its buffer")
}

test "split view: the split host gets no profile, state or storage of the primary's" {
  debug_assert(dft_dropped("FV_PROFILE_DIR=/p") && dft_dropped("FV_STATE_DIR=/s") && dft_dropped("FV_STORAGE=/x"), "stripped")
  debug_assert(!dft_dropped("FV_STATE_DIRS=/s") && !dft_dropped("HOME=/h") && !dft_dropped("FV_PROFILE=/p"), "others kept")
  // Its own state folder, made (and seeded) for its port, on every OS.
  let out = Bytes::new(4096)
  let n = dft_state_dir(47123, bytes_data_ptr(out), out.length())
  debug_assert(n > 0, "made")
  let dir = dft_bytes_string(out, n)
  debug_assert(dir.ends_with("split-47123") && dft_size(dir) == -2L, "a folder of its own: " + dir)
}

test "downloads: a file is written as deep as its folders go, empty ones too, and never over another" {
  let base = dft_scratch("dl-deep")
  let deep = base + "/a/b/c/notes.txt"
  debug_assert(dft_write(deep, "abc") == 0, "folders made as needed")
  debug_assert(dft_size(deep) == 3L, "written")
  debug_assert(dft_write(deep, "xyz") == 1, "not over the one there")
  let empty = base + "/a/empty.txt"
  debug_assert(dft_write(empty, "") == 0 && dft_size(empty) == 0L, "an empty file is a file")
  // Only a regular file at an absolute path is handed to the opener.
  debug_assert(dft_open_target(deep), "a text file opens")
  debug_assert(dft_write(base + "/a/b.pdf/inner.txt", "i") == 0, "a folder named like a PDF")
  debug_assert(!dft_open_target(base + "/a/b.pdf"), "a folder never opens")
  debug_assert(!dft_open_target(base + "/a/missing.pdf"), "nor a missing file")
  debug_assert(!dft_open_target("notes.txt") && !dft_open_target("-a.pdf"), "nor a relative path (read as an option)")
  dft_rm(deep)
  dft_rm(base + "/a/b/c")
  dft_rm(base + "/a/b")
  dft_rm(base + "/a/b.pdf/inner.txt")
  dft_rm(base + "/a/b.pdf")
  dft_rm(empty)
  dft_rm(base + "/a")
  dft_rm(base)
}

test "downloads: a Windows host's own file (C:\\..., C:/..., \\\\server\\...) is found as a path here" {
  debug_assert(cl_dl_path_absolute("/Users/me/Downloads/a.pdf") && cl_dl_path_absolute("C:\\Users\\me\\a.pdf"), "POSIX and drive paths")
  debug_assert(cl_dl_path_absolute("d:/x/a.pdf") && cl_dl_path_absolute("\\\\nas\\share\\a.pdf"), "forward slashes and shares")
  debug_assert(!cl_dl_path_absolute("a.pdf") && !cl_dl_path_absolute("C:a.pdf") && !cl_dl_path_absolute("downloads\\a.pdf") && !cl_dl_path_absolute(""), "relative ones are not")
  let files : Map[String, Int64] = Map::new()
  let written : Array[String] = []
  let w = dpt_worker(files, written)
  let host_path = "C:\\Users\\me\\Downloads\\report.pdf"
  files.set(host_path, 5L)
  let got : Array[ClDlEv] = []
  let _ = w.send(ClDlCmd::Place("k", host_path, 5L, "report.pdf", 0L, 0, true))
  let _ = w.drain(fn(ev : ClDlEv) -> Unit { got.push(ev) })
  let placed = match got[0] {
    ClDlEv::Placed(_, p, how) => p == host_path && how == CL_HOST_FILE
    _ => false
  }
  debug_assert(got.length() == 1 && placed && written.length() == 0, "its own file, nothing copied")
}

test "downloads: no name Windows refuses or opens as a device reaches the Downloads folder" {
  debug_assert(client_download_safe_name("a:b*c?d\"e<f>g|h.txt") == "a_b_c_d_e_f_g_h.txt", "forbidden characters kept as _")
  debug_assert(client_download_safe_name("report.pdf:evil.exe") == "report.pdf_evil.exe", "no NTFS stream")
  debug_assert(client_download_safe_name("CON") == "_CON" && client_download_safe_name("con.txt") == "_con.txt", "CON")
  debug_assert(client_download_safe_name("nul") == "_nul" && client_download_safe_name("Prn.tar.gz") == "_Prn.tar.gz", "NUL, PRN")
  debug_assert(client_download_safe_name("AUX .log") == "_AUX .log" && client_download_safe_name("..aux.pdf") == "_aux.pdf", "spaces and dots around it")
  debug_assert(client_download_safe_name("COM1.txt") == "_COM1.txt" && client_download_safe_name("lpt9") == "_lpt9", "COM1-9, LPT1-9")
  debug_assert(client_download_safe_name("COM0.txt") == "COM0.txt" && client_download_safe_name("console.txt") == "console.txt", "other names kept")
  debug_assert(client_download_safe_name("LPT10.txt") == "LPT10.txt" && client_download_safe_name("auxiliary") == "auxiliary", "longer names kept")
}

test "downloads: the same name and address downloaded again, changed, is kept as a new copy" {
  let prev_dl = app_state.main_downloads
  dpt_reset()
  let files : Map[String, Int64] = Map::new()
  let written : Array[String] = []
  cl_dl_worker.v = Some(dpt_worker(files, written))
  app_state.main_downloads = []
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.opened()
  let d = proto::DownloadSummary::{ ..dpt_summary("completed"), path: "" }
  dpt_arrive(st, d, "%PDF-")
  debug_assert(written.length() == 1 && download_client_path(d) == "~/Downloads/report.pdf", "the first")
  // Downloaded again later (the host's own file had gone): the new bytes are kept, under the next free name.
  cl_dl_recent.clear()
  let d2 = proto::DownloadSummary::{ ..d, id: "d7b", bytes: 8L }
  dpt_arrive(st, d2, "%PDF-1.7")
  debug_assert(written.length() == 2 && written[1] == "~/Downloads/report (1).pdf", "a new copy: " + written.join(","))
  debug_assert(download_client_path(d2) == "~/Downloads/report (1).pdf", "opened from the new one")
  // The same bytes again find that copy.
  cl_dl_recent.clear()
  dpt_arrive(st, d2, "%PDF-1.7")
  debug_assert(written.length() == 2 && download_client_path(d2) == "~/Downloads/report (1).pdf", "not written twice")
  // Newer bytes while older ones are being placed follow them.
  cl_dl_recent.clear()
  ui::answered_from_outside(fn() -> Unit {
    st.feed(proto::encode_host(proto::HostMsg::Downloaded(d.filename, d.url, d.mime, "%PDF-1.70".to_bytes())))
  })
  keep_stage_downloads(st)
  ui::answered_from_outside(fn() -> Unit {
    st.feed(proto::encode_host(proto::HostMsg::Downloaded(d.filename, d.url, d.mime, "%PDF-1.700".to_bytes())))
  })
  keep_stage_downloads(st)
  cl_dl_recent.clear()
  dpt_pump()
  dpt_pump()
  debug_assert(written.length() == 4 && written[3] == "~/Downloads/report (3).pdf", "the newest last: " + written.join(","))
  debug_assert(download_client_path(d2) == "~/Downloads/report (3).pdf", "and it is the one opened")

  dpt_reset()
  app_state.main_downloads = prev_dl
}

test "downloads: an empty file is a download like any other (kept here, or the host's own)" {
  let prev_dl = app_state.main_downloads
  dpt_reset()
  let files : Map[String, Int64] = Map::new()
  let written : Array[String] = []
  cl_dl_worker.v = Some(dpt_worker(files, written))
  app_state.main_downloads = []
  let st = stage::Stage::new(fn(_b : Bytes) -> Unit { () })
  st.opened()
  let e = proto::DownloadSummary::{ ..dpt_summary("completed"), filename: "empty.txt", url: "https://files.test/empty.txt", bytes: 0L, path: "/srv/elsewhere/empty.txt" }
  dpt_arrive(st, e, "")
  debug_assert(written.length() == 1 && written[0] == "~/Downloads/empty.txt" && files.get("~/Downloads/empty.txt").unwrap_or(-1L) == 0L, "written, empty")
  debug_assert(download_client_path(e) == "~/Downloads/empty.txt" && download_place_note(e) == "", "here")
  // A host on this machine: its own empty file.
  dpt_reset()
  cl_dl_worker.v = Some(dpt_worker(files, written))
  app_state.main_downloads = []
  let mine = proto::DownloadSummary::{ ..e, filename: "blank.txt", url: "https://files.test/blank.txt", path: "/srv/host/blank.txt" }
  files.set("/srv/host/blank.txt", 0L)
  dpt_arrive(st, mine, "")
  debug_assert(download_client_path(mine) == "/srv/host/blank.txt" && written.length() == 1, "the host's own")

  dpt_reset()
  app_state.main_downloads = prev_dl
}

test "library: a picture's size is checked before it is read, and ~ is resolved as the downloads worker does" {
  let reads : Array[String] = []
  let read = fn(p : String) -> Option[Bytes] {
    reads.push(p)
    Some(Bytes::new(10))
  }
  debug_assert(lib_thumb_read("/x/big.png", fn(_p : String) -> Int64 { 9_000_000L }, read).is_none(), "too large")
  debug_assert(lib_thumb_read("/x/dir.png", fn(_p : String) -> Int64 { -2L }, read).is_none(), "not a file")
  debug_assert(lib_thumb_read("/x/none.png", fn(_p : String) -> Int64 { -1L }, read).is_none(), "missing")
  debug_assert(reads.length() == 0, "none of them read")
  debug_assert(lib_thumb_read("/x/ok.png", fn(_p : String) -> Int64 { 10L }, read).is_some() && reads.length() == 1, "a small one is")
  // (USERPROFILE, else HOME, on Windows; HOME elsewhere)
  let windows = dft_env("OS") == "Windows_NT"
  let home = if windows && dft_env("USERPROFILE") != "" { dft_env("USERPROFILE") } else { dft_env("HOME") }
  if home != "" {
    debug_assert(lib_thumb_path("~/Downloads/cat.png") == home + "/Downloads/cat.png", "~ resolved: " + lib_thumb_path("~/Downloads/cat.png"))
  }
  debug_assert(lib_thumb_path("/a/cat.png") == "/a/cat.png" && lib_thumb_path("~bob/cat.png") == "~bob/cat.png", "other paths as they are")
}
