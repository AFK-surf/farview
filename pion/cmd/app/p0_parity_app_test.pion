///| p0 parity, app side: the appearance follows the system everywhere, late search suggestions keep the picked row,
///| leaving a fullscreen page's tab ends its fullscreen, a link that comes before the host waits, and a Start page
///| tile's × hides it with Undo.

fn p0_space(mode : proto::SpaceThemeMode) -> proto::SpaceSummary {
  proto::SpaceSummary::{
    id: "s1",
    name: "Work",
    accent: "",
    theme: proto::SpaceTheme::{ points: [], mode, grain: 0.0, intensity: 0.0 },
    active: true,
    tab_count: 0,
  }
}

test "appearance: under system, every lg component follows the system as it switches; a Space set to dark wins, for pages too" {
  let prev_sig = app_state.chrome_theme
  let prev_init = app_state.initial_chrome_theme
  let prev_ws = app_state.workspace
  let theme = signals::signal("system")
  app_state.chrome_theme = Some(theme)
  app_state.initial_chrome_theme = ""
  app_state.workspace = proto::WorkspaceSnapshot::{ ..prev_ws, spaces: [p0_space(proto::SpaceThemeMode::Auto)], active_space_id: "s1" }
  let t = ui::Tester::tree(fn(root : view::View) -> Unit { follow_system_appearance(root) }, width=200.0, height=100.0)
  t.fake.dark_mode = false
  t.frame(ms=16.0)
  sync_lg_theme_from_chrome("system")
  debug_assert(!lg::is_dark(), "light while the system is light")
  t.fake.dark_mode = true
  t.frame(ms=16.0)
  debug_assert(ui::system_dark_now(), "the system went dark")
  debug_assert(lg::is_dark(), "lg went dark with it, with no setting saved")
  t.fake.dark_mode = false
  t.frame(ms=16.0)
  debug_assert(!lg::is_dark(), "and light again")
  // a person's own choice stays as it is
  theme.set("dark")
  t.fake.dark_mode = false
  t.frame(ms=16.0)
  sync_lg_theme_from_chrome("dark")
  t.fake.dark_mode = true
  t.frame(ms=16.0)
  t.fake.dark_mode = false
  t.frame(ms=16.0)
  debug_assert(lg::is_dark(), "Dark stays dark as the system switches")
  // a Space set to dark: the browser and its pages both dark under a light chrome
  theme.set("light")
  app_state.workspace = proto::WorkspaceSnapshot::{ ..prev_ws, spaces: [p0_space(proto::SpaceThemeMode::Dark)], active_space_id: "s1" }
  debug_assert(appearance_dark("light"), "the Space's Dark wins over a light chrome")
  let _ = stage::set_page_media(false, 1.0)
  sync_page_media()
  debug_assert(stage::page_media_dark(), "pages are told dark in a dark Space")
  app_state.workspace = proto::WorkspaceSnapshot::{ ..prev_ws, spaces: [p0_space(proto::SpaceThemeMode::Light)], active_space_id: "s1" }
  theme.set("dark")
  sync_page_media()
  debug_assert(!stage::page_media_dark(), "pages are told light in a light Space under a dark chrome")
  t.dispose()
  app_state.chrome_theme = prev_sig
  app_state.initial_chrome_theme = prev_init
  app_state.workspace = prev_ws
  sync_lg_theme_from_chrome(app_state.settings.chrome_theme)
  let _ = stage::set_page_media(false, 1.0)
}

test "search suggestions: an answer that comes after Down keeps the row the person picked; Enter opens it" {
  let prev_settings = app_state.settings
  let prev_hist = app_state.history_snap
  let prev_open = app_state.omnibox_open
  let prev_sel = app_state.omnibox_selected
  app_state.settings = proto::BrowserSettings::{ ..prev_settings, search_suggest: true, search_engine: "duckduckgo" }
  app_state.history_snap = proto::HistorySnapshot::{
    ..prev_hist,
    items: [
      proto::HistoryItemSummary::{
        url: "https://pion-lang.org/docs",
        title: "Pion docs",
        host: "pion-lang.org",
        visit_count: 4,
        last_visit_secs: 0L,
      },
    ],
  }
  app_state.omnibox_open = Some(signals::signal(true))
  let sel = signals::signal(-1)
  app_state.omnibox_selected = Some(sel)
  app_state.omnibox_sel_touched = false
  app_state.search_suggest_for = ""
  app_state.search_suggest_items = []
  refresh_omnibox_suggestions("pion")
  let mut hist_at = -1
  let mut k = 0
  while k < app_state.omni_suggest_items.length() {
    if app_state.omni_suggest_items[k].url == "https://pion-lang.org/docs" {
      hist_at = k
    }
    k += 1
  }
  debug_assert(hist_at >= 0, "the history row is listed")
  // Down until it is the history row
  let mut steps = 0
  while sel.untracked() != hist_at && steps < 20 {
    let _ = step_omnibox_selection(1)
    steps += 1
  }
  debug_assert(sel.untracked() == hist_at, "Down reached the history row")
  // the engine's answer comes now: its rows go under Web Search, above or below the picked row
  set_host_search_suggestions("pion", proto::encode_search_suggestions(["pion language", "pion compiler", "pion tutorial", "pion docs"]))
  let mut engine_rows = 0
  for it in app_state.omni_suggest_items {
    if it.category is proto::OmniSuggestCategory::SearchSuggest {
      engine_rows += 1
    }
  }
  debug_assert(engine_rows > 0, "the engine's rows were added")
  let now = sel.untracked()
  debug_assert(
    now >= 0 && now < app_state.omni_suggest_items.length() && app_state.omni_suggest_items[now].url == "https://pion-lang.org/docs",
    "the selection stays on the picked row, now at " + now.to_string(),
  )
  // (Enter runs the selected row: navigate_omnibox takes omni_suggest_items[selected])
  app_state.settings = prev_settings
  app_state.history_snap = prev_hist
  app_state.omnibox_open = prev_open
  app_state.omnibox_selected = prev_sel
  app_state.omnibox_sel_touched = false
  app_state.search_suggest_for = ""
  app_state.search_suggest_items = []
}

test "page fullscreen: switching to another tab ends it; the window and the sidebar come back and stay so" {
  let prev_ws = app_state.workspace
  let prev_host = app_state.workspace_host
  app_state.ws_pending = []
  let old_main = io_rt.main_conn.detach()
  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  app_state.workspace = proto::WorkspaceSnapshot::{ ..prev_ws, active_tab_id: "a" }
  app_state.workspace_host = app_state.workspace
  let was_open = is_sidebar_open()
  set_sidebar_open(true)
  sync_page_fullscreen(true)
  debug_assert(page_fs.on && page_fs.tab_id == "a" && !is_sidebar_open(), "tab a's page is fullscreen")
  dispatch_tab_switch("b")
  debug_assert(!page_fs.on, "switching tabs ends the fullscreen")
  debug_assert(is_sidebar_open(), "the sidebar is back")
  // (the host's own switch, a tab closed from elsewhere: the frame sees the active tab changed)
  sync_page_fullscreen(true)
  app_state.workspace = proto::WorkspaceSnapshot::{ ..app_state.workspace, active_tab_id: "c" }
  page_fullscreen_follow_tab()
  debug_assert(!page_fs.on && is_sidebar_open(), "a switch the host made ends it too")
  // closing the fullscreen tab
  sync_page_fullscreen(true)
  dispatch_tab_close("c")
  debug_assert(!page_fs.on, "closing its tab ends it")
  // the same tab stays fullscreen: a switch to itself is no leaving
  sync_page_fullscreen(true)
  dispatch_tab_switch("c")
  debug_assert(page_fs.on, "a switch to the same tab keeps it")
  sync_page_fullscreen(false)
  set_sidebar_open(was_open)
  app_state.ws_pending = []
  app_state.workspace = prev_ws
  app_state.workspace_host = prev_host
  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
}

test "links from other apps: one that comes before the host is connected waits and opens once it is" {
  let old_main = io_rt.main_conn.detach()
  on_system_said("{\"link\":\"https://early.test/a\"}")
  on_system_said("{\"link\":\"example.com\"}")
  on_system_said("{\"link\":\"file:///home/me/.ssh/id_rsa\"}")
  debug_assert(links_waiting.length() == 2, "two links wait (the file one is refused), got " + links_waiting.length().to_string())
  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  open_links_waiting()
  let _ = io_rt.main_conn.flush_write()
  // (both acts, however the socket hands them over: read until the second has come)
  let got = sn_read_until_hex(acc, bytes_to_hex(wire::encode(wire::Message::Act("tab_new", "https://example.com", ""))), max_wait_ms=1000)
  debug_assert(got.contains(bytes_to_hex(wire::encode(wire::Message::Act("tab_new", "https://early.test/a", "")))), "the early link opened")
  debug_assert(got.contains(bytes_to_hex(wire::encode(wire::Message::Act("tab_new", "https://example.com", "")))), "a bare host opened as https")
  debug_assert(!got.contains(bytes_to_hex("id_rsa".to_bytes())), "a file link is never opened")
  debug_assert(links_waiting.length() == 0, "none left waiting")
  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
}

test "start page: a tile's × hides it from the Start page and keeps its bookmark; Undo shows it again" {
  let old_main = io_rt.main_conn.detach()
  let (srv, cli, acc) = sn_make_loopback_pair()
  debug_assert(io_rt.main_conn.attach(cli), "attach main_conn")
  let prev = app_state.settings
  app_state.settings = proto::BrowserSettings::{ ..prev, start_hidden: [] }
  let fav = proto::StartPageTile::{
    title: "GitHub",
    url: "https://github.com/",
    host: "github.com",
    monogram: "G",
    accent: 0L,
    is_bookmark: true,
    visit_count: 0,
  }
  remove_start_page_tile(fav)
  let _ = io_rt.main_conn.flush_write()
  let sent = bytes_to_hex(sn_read_all_available(acc, 8))
  debug_assert(!sent.contains(bytes_to_hex("bookmark_delete".to_bytes())), "the bookmark is kept")
  debug_assert(app_state.settings.start_hidden.length() == 1, "the tile is hidden")
  debug_assert(app_state.toast_action_label == "Undo", "the toast offers Undo")
  let bookmarks = [
    proto::BookmarkEntry::{ id: "b1", title: "GitHub", url: "https://github.com/", folder: "", created_ms: 0L },
  ]
  let hidden_tiles = proto::build_start_page_tiles(bookmarks, [], 8, hidden=app_state.settings.start_hidden)
  debug_assert(hidden_tiles.length() == 0, "the Favorite is off the Start page")
  run_toast_action()
  debug_assert(app_state.settings.start_hidden.length() == 0, "Undo shows it again")
  let back = proto::build_start_page_tiles(bookmarks, [], 8, hidden=app_state.settings.start_hidden)
  debug_assert(back.length() == 1 && back[0].is_bookmark, "the Favorite is back")
  app_state.settings = prev
  let _ = io_rt.main_conn.detach()
  net::close(cli)
  net::close(acc)
  net::close(srv)
  if old_main >= 0 { let _ = io_rt.main_conn.attach(old_main) }
}
