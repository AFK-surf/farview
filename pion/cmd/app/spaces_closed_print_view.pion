///| Native Metal Daily-Driver Chrome UX Modals:
///| 1. Arc Spaces Manager Modal (`+` in sidebar Space strip, Command Bar `Manage Spaces` / `New Space`, `--demo-spaces`)
///| 2. Recently Closed Tabs Picker Modal (`wire::Message::ClosedTabsState`, tag 66, `--demo-closed-tabs`)
///| 3. Native `Cmd+P` Print / Export PDF Configuration Modal (`--demo-print`)
///|
///| Uses concentric corner radii (14 -> 10 -> 8 -> 6pt), first-line alignment,
///| zero `·` metadata concatenation, zero double/dangling dividers, zero `alpha=0` clickable buttons,
///| full Light & Dark `ChromePalette` parity, and UTF-8 multilingual safety.

// --- Dispatchers & State Transitions ---

fn dispatch_space_new_with_accent(name : String, accent_hex : String) -> Unit {
  let clean = name.trim()
  let final_name = if clean != "" { clean } else { proto::next_auto_space_name(app_state.workspace) }
  let hex = proto::space_accent_hex_for_key(accent_hex)
  send_wire(wire::Message::Act("space_new", final_name, hex))
  show_toast("Created Space \"" + final_name + "\"", "info")
}

fn dispatch_space_accent(space_id : String, accent_hex : String) -> Unit {
  if space_id == "" {
    return
  }
  let hex = proto::space_accent_hex_for_key(accent_hex)
  send_wire(wire::Message::Act("space_accent", space_id, hex))
}

fn dispatch_closed_tabs_sync() -> Unit {
  send_wire(wire::Message::Act("closed_tabs_sync", "", ""))
}

fn dispatch_tab_reopen_at(index : Int, title : String) -> Unit {
  send_wire(wire::Message::Act("tab_reopen_at", index.to_string(), ""))
  let lbl = if title.trim() != "" { title.trim() } else { "Closed Tab" }
  show_toast("Restored \"" + lbl + "\"", "info")
}

fn dispatch_closed_tabs_clear() -> Unit {
  app_state.closed_tabs_snap = proto::ClosedTabsSnapshot::empty()
  match app_state.closed_tabs_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  send_wire(wire::Message::Act("closed_tabs_clear", "", ""))
  show_toast("Cleared recently closed tabs", "clear")
}

fn dispatch_export_pdf_with_config(cfg : proto::PrintPdfConfig) -> Unit {
  let owner = app_state.print_owner_pane
  let cfg_json = proto::encode_print_pdf_config(cfg)
  dispatch_export_pdf_for_pane(owner, cfg_json)
}

fn set_host_closed_tabs_state(json : String) -> Unit {
  match proto::parse_closed_tabs_state(json, max_items=proto::CLOSED_TABS_MAX_ITEMS) {
    Some(snap) => {
      app_state.closed_tabs_snap = snap
      match app_state.closed_tabs_rev {
        Some(r) => r.set(r.untracked() + 1)
        None => ()
      }
      match app_state.host_closed_tabs_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
    None => ()
  }
}

fn close_spaces_manager() -> Unit {
  match app_state.spaces_new_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.spaces_rename_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.spaces_edit_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.spaces_color_edit_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.spaces_manager_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("spaces_manager")
}

fn open_spaces_manager(focus_new~ : Bool = false) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.spaces_edit_id {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.spaces_color_edit_id {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.spaces_manager_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "spaces_manager")
  if focus_new {
    match app_state.spaces_new_field {
      Some(f) => f.focus()
      None => ()
    }
  }
  dispatch_workspace_sync()
}

fn toggle_spaces_manager() -> Unit {
  let is_open = match app_state.spaces_manager_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_spaces_manager()
  } else {
    open_spaces_manager()
  }
}

fn close_closed_tabs_modal() -> Unit {
  match app_state.closed_tabs_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.closed_tabs_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("closed_tabs")
}

fn open_closed_tabs_modal() -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.closed_tabs_field {
    Some(f) => f.set("")
    None => ()
  }
  match app_state.closed_tabs_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "closed_tabs")
  dispatch_closed_tabs_sync()
}

fn toggle_closed_tabs_modal() -> Unit {
  let is_open = match app_state.closed_tabs_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_closed_tabs_modal()
  } else {
    open_closed_tabs_modal()
  }
}

fn close_print_pdf_modal() -> Unit {
  match app_state.print_pdf_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("print_pdf")
}

fn open_print_pdf_modal() -> Unit {
  let owner = active_split_pane()
  close_exclusive_overlays()
  app_state.print_owner_pane = owner
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.print_pdf_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Dialog, "print_pdf")
}

fn toggle_print_pdf_modal() -> Unit {
  let is_open = match app_state.print_pdf_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_print_pdf_modal()
  } else {
    open_print_pdf_modal()
  }
}

fn current_print_pdf_config() -> proto::PrintPdfConfig {
  let paper = match app_state.print_paper {
    Some(s) => s.get()
    None => "a4"
  }
  let orientation = match app_state.print_orientation {
    Some(s) => s.get()
    None => "portrait"
  }
  let margins = match app_state.print_margins {
    Some(s) => s.get()
    None => "default"
  }
  let background_graphics = match app_state.print_bg_graphics {
    Some(s) => s.get()
    None => true
  }
  proto::PrintPdfConfig::{ paper, orientation, margins, background_graphics }
}

fn current_print_pdf_config_untracked() -> proto::PrintPdfConfig {
  let paper = match app_state.print_paper {
    Some(s) => s.untracked()
    None => "a4"
  }
  let orientation = match app_state.print_orientation {
    Some(s) => s.untracked()
    None => "portrait"
  }
  let margins = match app_state.print_margins {
    Some(s) => s.untracked()
    None => "default"
  }
  let background_graphics = match app_state.print_bg_graphics {
    Some(s) => s.untracked()
    None => true
  }
  proto::PrintPdfConfig::{ paper, orientation, margins, background_graphics }
}

// --- 1. Arc Spaces Manager Modal (544pt centered, Light & Dark `ChromePalette`) ---

fn build_spaces_manager_modal(
  root : view::View,
  spaces_manager_open : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
  spaces_new_field : ui::Field,
  spaces_new_accent : signals::Signal[String],
  spaces_edit_id : signals::Signal[String],
  spaces_rename_field : ui::Field,
  spaces_color_edit_id : signals::Signal[String],
) -> Unit {
  root.show(
    fn() -> Bool { spaces_manager_open.get() },
    fn(sp_layer : view::View) -> Unit {
      let _ = sp_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Dimmed backdrop (click closes modal)
      let _ = headless::button(
        sp_layer,
        fn() -> String { "Close Spaces Manager" },
        fn(_v : view::View) -> Unit { close_spaces_manager() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05081068L } else { 0x0F172A40L }
          }))
        },
      )

      let submit_new_space = fn() -> Unit {
        let raw_name = spaces_new_field.text().trim()
        let hex = spaces_new_accent.untracked()
        dispatch_space_new_with_accent(raw_name, hex)
        spaces_new_field.set("")
      }

      // Centered Modal Card (544pt wide, concentric 14 -> 10 -> 8 -> 6pt radii)
      let _ = sp_layer.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(544.0)))
          .max_height(view::Live::Is(Some(596.0)))
          .radius(view::Live::Is(14.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (34.0, 14.0, 0x00000072L) } else { (30.0, 12.0, 0x0F172A2CL) }
          }))

          // Header Row: Title + "Isolated Cookie Partition" badge + Close button
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((18.0, 14.0, 14.0, 12.0)))
              .gap(view::Live::Is(10.0))
              .rigid()

              let _ = hdr.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .rigid()
                  .words(
                    view::Live::Is("Spaces"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 15.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              // Isolated Cookie Partition badge
              let _ = hdr.box(
                fn(iso : view::View) -> Unit {
                  let _ = iso
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .gap(view::Live::Is(5.0))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                  let _ = iso.box(
                    fn(dot : view::View) -> Unit {
                      let _ = dot
                      .width(view::Live::Is(Some(6.0)))
                      .height(view::Live::Is(Some(6.0)))
                      .rigid()
                      .radius(view::Live::Is(3.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent }))
                    },
                  )
                  let _ = iso.box(
                    fn(lbl : view::View) -> Unit {
                      let _ = lbl
                      .rigid()
                      .words(
                        view::Live::Is("Isolated Cookie Partition"),
                        ink=0x1D4ED8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )

              let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

              let _ = headless::button(
                hdr,
                fn() -> String { "Close Spaces Manager" },
                fn(_v : view::View) -> Unit { close_spaces_manager() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(26.0)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(7.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Single hairline below header
          let _ = card.box(
            fn(hl : view::View) -> Unit {
              let _ = hl.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Create New Space Section
          let _ = card.box(
            fn(new_sec : view::View) -> Unit {
              let _ = new_sec
              .padding(view::Live::Is((18.0, 14.0, 18.0, 16.0)))
              .gap(view::Live::Is(11.0))
              .rigid()
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

              // Section Header
              let _ = new_sec.box(
                fn(sh : view::View) -> Unit {
                  let _ = sh
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(8.0))
                  .rigid()
                  let _ = sh.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .words(
                        view::Live::Is("NEW SPACE"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                  let _ = sh.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                  let _ = sh.box(
                    fn(hint : view::View) -> Unit {
                      let _ = hint
                      .words(
                        view::Live::Is("Separate cookies, storage & pinned tabs"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Name Input Row + Create Space CTA
              let _ = new_sec.box(
                fn(in_row : view::View) -> Unit {
                  let _ = in_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(10.0))
                  .rigid()

                  // Name input box
                  let _ = in_row.box(
                    fn(nf : view::View) -> Unit {
                      let _ = nf
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(36.0)))
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .padding(view::Live::Is((11.0, 0.0, 11.0, 0.0)))
                      .gap(view::Live::Is(8.0))
                      .radius(view::Live::Is(9.0))
                      .clips(view::Live::Is(true))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        let p = chrome_palette()
                        if spaces_new_field.focused() {
                          (1.4, proto::workspace_accent_color(spaces_new_accent.get()))
                        } else {
                          (1.0, p.border)
                        }
                      }))

                      // Selected accent indicator dot inside field
                      let _ = nf.box(
                        fn(dot : view::View) -> Unit {
                          let _ = dot
                          .width(view::Live::Is(Some(9.0)))
                          .height(view::Live::Is(Some(9.0)))
                          .rigid()
                          .radius(view::Live::Is(4.5))
                          .ground(view::Live::By(fn() -> Int64 {
                            proto::workspace_accent_color(spaces_new_accent.get())
                          }))
                        },
                      )

                      // Dual-theme reactive text field (UTF-8 multilingual safe)
                      let _ = nf.box(
                        fn(fi : view::View) -> Unit {
                          let _ = fi
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .clips(view::Live::Is(true))
                          fi.show(
                            fn() -> Bool { !is_dark_chrome() },
                            fn(fl : view::View) -> Unit {
                              let _ = ui::field(
                                fl,
                                spaces_new_field,
                                placeholder="Space name (e.g. Design, 设计调研)...",
                                font_size=13.0,
                                color=0x1D1D1FFFL,
                                placeholder_color=0x8E8E93FFL,
                                caret_color=0x2563EBFFL,
                                max_lines=1,
                                enter_sends=true,
                                submitted=fn(_t : String) -> Unit { submit_new_space() },
                              )
                            },
                          )
                          fi.show(
                            fn() -> Bool { is_dark_chrome() },
                            fn(fd : view::View) -> Unit {
                              let _ = ui::field(
                                fd,
                                spaces_new_field,
                                placeholder="Space name (e.g. Design, 设计调研)...",
                                font_size=13.0,
                                color=0xF1F5F9FFL,
                                placeholder_color=0x94A3B8FFL,
                                caret_color=0x60A5FAFFL,
                                max_lines=1,
                                enter_sends=true,
                                submitted=fn(_t : String) -> Unit { submit_new_space() },
                              )
                            },
                          )
                        },
                      )
                    },
                  )

                  // Primary CTA button: Create Space
                  let _ = headless::button(
                    in_row,
                    fn() -> String { "Create Space" },
                    fn(_v : view::View) -> Unit { submit_new_space() },
                    fn(cb : view::View, cbtn : headless::Button) -> Unit {
                      let _ = cb
                      .height(view::Live::Is(Some(36.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((15.0, 0.0, 15.0, 0.0)))
                      .radius(view::Live::Is(9.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let base = proto::workspace_accent_color(spaces_new_accent.get())
                        if cbtn.pressed() {
                          // Slight darken on press
                          let r = ((base >> 24) & 0xFFL) * 85L / 100L
                          let g = ((base >> 16) & 0xFFL) * 85L / 100L
                          let b = ((base >> 8) & 0xFFL) * 85L / 100L
                          (r << 24) | (g << 16) | (b << 8) | 0xFFL
                        } else {
                          base
                        }
                      }))
                      let _ = cb.box(
                        fn(cl : view::View) -> Unit {
                          let _ = cl.words(
                            view::Live::Is("Create Space"),
                            ink=0xFFFFFFFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                            one_line=true,
                          )
                        },
                      )
                    },
                  )
                },
              )

              // 6 Classic Arc Theme Accent Swatches Row
              let _ = new_sec.box(
                fn(sw_wrap : view::View) -> Unit {
                  let _ = sw_wrap
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(8.0))
                  .rigid()

                  let _ = sw_wrap.box(
                    fn(lbl : view::View) -> Unit {
                      let _ = lbl
                      .rigid()
                      .words(
                        view::Live::Is("Accent"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )

                  let presets = proto::arc_space_accent_presets()
                  let mut pi = 0
                  while pi < presets.length() {
                    let preset = presets[pi]
                    let hex = preset.hex
                    let rgba = preset.rgba
                    let lbl_name = preset.label
                    let is_sel = fn() -> Bool {
                      proto::normalize_space_accent(spaces_new_accent.get()) == hex
                    }
                    let _ = headless::button(
                      sw_wrap,
                      fn() -> String { "Accent " + lbl_name },
                      fn(_v : view::View) -> Unit { spaces_new_accent.set(hex) },
                      fn(sw : view::View, sw_btn : headless::Button) -> Unit {
                        let _ = sw
                        .width(view::Live::Is(Some(28.0)))
                        .height(view::Live::Is(Some(28.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(14.0))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          let p = chrome_palette()
                          if is_sel() {
                            (2.0, rgba)
                          } else if sw_btn.hovered() {
                            (1.5, p.border)
                          } else {
                            (0.0, 0x00000000L)
                          }
                        }))
                        let _ = sw.box(
                          fn(dot : view::View) -> Unit {
                            let _ = dot
                            .width(view::Live::By(fn() -> Option[Double] {
                              if is_sel() { Some(18.0) } else { Some(22.0) }
                            }))
                            .height(view::Live::By(fn() -> Option[Double] {
                              if is_sel() { Some(18.0) } else { Some(22.0) }
                            }))
                            .rigid()
                            .radius(view::Live::By(fn() -> Double {
                              if is_sel() { 9.0 } else { 11.0 }
                            }))
                            .ground(view::Live::Is(rgba))
                          },
                        )
                      },
                    )
                    pi = pi + 1
                  }

                  let _ = sw_wrap.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

                  // Selected accent label readout
                  let _ = sw_wrap.box(
                    fn(sel_lbl : view::View) -> Unit {
                      let _ = sel_lbl
                      .rigid()
                      .height(view::Live::Is(Some(22.0)))
                      .center()
                      .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                      let _ = sel_lbl.box(
                        fn(sl : view::View) -> Unit {
                          let _ = sl
                          .words(
                            view::Live::By(fn() -> String {
                              proto::space_accent_label_for_hex(spaces_new_accent.get())
                            }),
                            ink=0x3A4152FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Single hairline between New Space and Spaces List
          let _ = card.box(
            fn(hl2 : view::View) -> Unit {
              let _ = hl2.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Existing Spaces Section Header
          let _ = card.box(
            fn(lh : view::View) -> Unit {
              let _ = lh
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((18.0, 12.0, 18.0, 6.0)))
              .gap(view::Live::Is(8.0))
              .rigid()

              let _ = lh.box(
                fn(lt : view::View) -> Unit {
                  let _ = lt
                  .words(
                    view::Live::Is("YOUR SPACES"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )

              let _ = lh.box(
                fn(cnt : view::View) -> Unit {
                  let _ = cnt
                  .height(view::Live::Is(Some(18.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(5.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  let _ = cnt.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .words(
                        view::Live::By(fn() -> String {
                          let _ = workspace_rev.get()
                          app_state.workspace.spaces.length().to_string()
                        }),
                        ink=0x3A4152FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                },
              )
            },
          )

          // Spaces List (up to 12 slots, reactive to workspace_rev)
          let _ = card.box(
            fn(list_wrap : view::View) -> Unit {
              let _ = list_wrap
              .padding(view::Live::Is((14.0, 4.0, 14.0, 14.0)))
              .gap(view::Live::Is(6.0))
              .rigid()

              let mut slot = 0
              while slot < 12 {
                let sidx = slot
                list_wrap.show(
                  fn() -> Bool {
                    let _ = workspace_rev.get()
                    sidx < app_state.workspace.spaces.length()
                  },
                  fn(row_outer : view::View) -> Unit {
                    let get_sp = fn() -> proto::SpaceSummary {
                      let _ = workspace_rev.get()
                      let list = app_state.workspace.spaces
                      if sidx < list.length() {
                        list[sidx]
                      } else {
                        proto::SpaceSummary::{ id: "", name: "", accent: "#2563EB", active: false, tab_count: 0 }
                      }
                    }
                    let is_act = fn() -> Bool {
                      let sp = get_sp()
                      sp.active || (sp.id != "" && sp.id == app_state.workspace.active_space_id)
                    }
                    let is_renaming = fn() -> Bool {
                      let sp = get_sp()
                      sp.id != "" && spaces_edit_id.get() == sp.id
                    }
                    let is_recoloring = fn() -> Bool {
                      let sp = get_sp()
                      sp.id != "" && spaces_color_edit_id.get() == sp.id
                    }

                    let _ = row_outer
                    .padding(view::Live::Is((12.0, 9.0, 10.0, 9.0)))
                    .gap(view::Live::Is(8.0))
                    .radius(view::Live::Is(10.0))
                    .rigid()
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_act() { p.tab_active_bg } else { p.surface_subtle }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      let p = chrome_palette()
                      if is_act() { (1.0, p.tab_active_border) } else { (1.0, p.hairline) }
                    }))

                    // Primary row line
                    let _ = row_outer.box(
                      fn(main_row : view::View) -> Unit {
                        let _ = main_row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .gap(view::Live::Is(10.0))
                        .rigid()

                        // Accent color dot (click toggles inline color picker)
                        let _ = headless::button(
                          main_row,
                          fn() -> String { "Recolor Space" },
                          fn(_v : view::View) -> Unit {
                            let sp = get_sp()
                            if sp.id != "" {
                              if spaces_color_edit_id.untracked() == sp.id {
                                spaces_color_edit_id.set("")
                              } else {
                                spaces_edit_id.set("")
                                spaces_color_edit_id.set(sp.id)
                              }
                            }
                          },
                          fn(db : view::View, dbtn : headless::Button) -> Unit {
                            let _ = db
                            .width(view::Live::Is(Some(24.0)))
                            .height(view::Live::Is(Some(24.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(12.0))
                            .edge(view::Live::By(fn() -> (Double, Int64) {
                              let sp = get_sp()
                              let rgba = proto::workspace_accent_color(sp.accent)
                              if is_recoloring() {
                                (1.8, rgba)
                              } else if dbtn.hovered() {
                                (1.2, chrome_palette().border)
                              } else {
                                (0.0, 0x00000000L)
                              }
                            }))
                            let _ = db.box(
                              fn(dot : view::View) -> Unit {
                                let _ = dot
                                .width(view::Live::Is(Some(12.0)))
                                .height(view::Live::Is(Some(12.0)))
                                .rigid()
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  proto::workspace_accent_color(get_sp().accent)
                                }))
                              },
                            )
                          },
                        )

                        // Space name
                        let _ = main_row.box(
                          fn(nm_box : view::View) -> Unit {
                            let _ = nm_box
                            .shrink(view::Live::Is(1.0))
                            .min_width(view::Live::Is(Some(0.0)))
                            .clips(view::Live::Is(true))
                            .words(
                              view::Live::By(fn() -> String {
                                let sp = get_sp()
                                if sp.name != "" { sp.name } else { sp.id }
                              }),
                              ink=0x1D1D1FFFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                          },
                        )

                        // Tab count capsule
                        let _ = main_row.box(
                          fn(tc : view::View) -> Unit {
                            let _ = tc
                            .height(view::Live::Is(Some(20.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                            let _ = tc.box(
                              fn(tl : view::View) -> Unit {
                                let _ = tl
                                .words(
                                  view::Live::By(fn() -> String {
                                    proto::space_tab_count_label(get_sp().tab_count)
                                  }),
                                  ink=0x6B7280FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                              },
                            )
                          },
                        )

                        // Active badge (mounted ONLY for active Space)
                        main_row.show(
                          is_act,
                          fn(ab : view::View) -> Unit {
                            let _ = ab
                            .height(view::Live::Is(Some(20.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                            .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                            let _ = ab.box(
                              fn(al : view::View) -> Unit {
                                let _ = al
                                .words(
                                  view::Live::Is("Active"),
                                  ink=0x1D4ED8FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                              },
                            )
                          },
                        )

                        let _ = main_row.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

                        // Switch button (mounted ONLY for non-active Spaces)
                        main_row.show(
                          fn() -> Bool { !is_act() },
                          fn(sw_wrap : view::View) -> Unit {
                            let _ = headless::button(
                              sw_wrap,
                              fn() -> String { "Switch to Space" },
                              fn(_v : view::View) -> Unit {
                                let sp = get_sp()
                                if sp.id != "" {
                                  dispatch_space_switch(sp.id)
                                  close_spaces_manager()
                                }
                              },
                              fn(sb : view::View, sbtn : headless::Button) -> Unit {
                                let _ = sb
                                .height(view::Live::Is(Some(26.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                                .radius(view::Live::Is(7.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if sbtn.pressed() { p.btn_press } else if sbtn.hovered() { p.btn_hover } else { p.btn_bg }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                                let _ = sb.box(
                                  fn(sl : view::View) -> Unit {
                                    let _ = sl
                                    .words(
                                      view::Live::Is("Switch"),
                                      ink=0x1D1D1FFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                  },
                                )
                              },
                            )
                          },
                        )

                        // Rename button
                        let _ = headless::button(
                          main_row,
                          fn() -> String { "Rename Space" },
                          fn(_v : view::View) -> Unit {
                            let sp = get_sp()
                            if sp.id != "" {
                              if spaces_edit_id.untracked() == sp.id {
                                spaces_edit_id.set("")
                              } else {
                                spaces_color_edit_id.set("")
                                spaces_edit_id.set(sp.id)
                                spaces_rename_field.set(if sp.name != "" { sp.name } else { sp.id })
                                spaces_rename_field.focus()
                              }
                            }
                          },
                          fn(rb : view::View, rbtn : headless::Button) -> Unit {
                            let _ = rb
                            .height(view::Live::Is(Some(26.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                            .radius(view::Live::Is(7.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_renaming() || rbtn.pressed() {
                                p.btn_press
                              } else if rbtn.hovered() {
                                p.btn_hover
                              } else {
                                0x00000000L
                              }
                            }))
                            let _ = rb.box(
                              fn(rl : view::View) -> Unit {
                                let _ = rl
                                .words(
                                  view::Live::Is("Rename"),
                                  ink=0x6B7280FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                              },
                            )
                          },
                        )

                        // Delete Space button (mounted ONLY when > 1 Space exists; never alpha=0)
                        main_row.show(
                          fn() -> Bool {
                            let sp = get_sp()
                            proto::space_can_delete(app_state.workspace, sp.id)
                          },
                          fn(del_wrap : view::View) -> Unit {
                            let _ = headless::button(
                              del_wrap,
                              fn() -> String { "Delete Space" },
                              fn(_v : view::View) -> Unit {
                                let sp = get_sp()
                                if proto::space_can_delete(app_state.workspace, sp.id) {
                                  if spaces_edit_id.untracked() == sp.id {
                                    spaces_edit_id.set("")
                                  }
                                  if spaces_color_edit_id.untracked() == sp.id {
                                    spaces_color_edit_id.set("")
                                  }
                                  dispatch_space_delete(sp.id)
                                }
                              },
                              fn(db : view::View, dbtn : headless::Button) -> Unit {
                                let _ = db
                                .height(view::Live::Is(Some(26.0)))
                                .rigid()
                                .center()
                                .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                                .radius(view::Live::Is(7.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if dbtn.pressed() || dbtn.hovered() { p.danger_bg } else { 0x00000000L }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) {
                                  let p = chrome_palette()
                                  if dbtn.pressed() || dbtn.hovered() { (1.0, p.danger_border) } else { (0.0, 0x00000000L) }
                                }))
                                let _ = db.box(
                                  fn(dl : view::View) -> Unit {
                                    let _ = dl
                                    .words(
                                      view::Live::Is("Delete"),
                                      ink=0xDC2626FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )

                    // Inline Rename Row (mounted only when this Space is being renamed)
                    row_outer.show(
                      is_renaming,
                      fn(ren_row : view::View) -> Unit {
                        let _ = ren_row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .gap(view::Live::Is(8.0))
                        .rigid()

                        let commit_rename = fn() -> Unit {
                          let sp = get_sp()
                          let nm = spaces_rename_field.text().trim()
                          if sp.id != "" && nm != "" {
                            dispatch_space_rename(sp.id, nm)
                          }
                          spaces_edit_id.set("")
                        }

                        let _ = ren_row.box(
                          fn(rf_wrap : view::View) -> Unit {
                            let _ = rf_wrap
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .height(view::Live::Is(Some(30.0)))
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                            .radius(view::Live::Is(7.0))
                            .clips(view::Live::Is(true))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
                            .edge(view::Live::By(fn() -> (Double, Int64) { (1.2, chrome_palette().accent) }))
                            rf_wrap.show(
                              fn() -> Bool { !is_dark_chrome() },
                              fn(fl : view::View) -> Unit {
                                let _ = ui::field(
                                  fl,
                                  spaces_rename_field,
                                  placeholder="New Space name...",
                                  font_size=12.5,
                                  color=0x1D1D1FFFL,
                                  placeholder_color=0x8E8E93FFL,
                                  caret_color=0x2563EBFFL,
                                  max_lines=1,
                                  enter_sends=true,
                                  submitted=fn(_t : String) -> Unit { commit_rename() },
                                )
                              },
                            )
                            rf_wrap.show(
                              fn() -> Bool { is_dark_chrome() },
                              fn(fd : view::View) -> Unit {
                                let _ = ui::field(
                                  fd,
                                  spaces_rename_field,
                                  placeholder="New Space name...",
                                  font_size=12.5,
                                  color=0xF1F5F9FFL,
                                  placeholder_color=0x94A3B8FFL,
                                  caret_color=0x60A5FAFFL,
                                  max_lines=1,
                                  enter_sends=true,
                                  submitted=fn(_t : String) -> Unit { commit_rename() },
                                )
                              },
                            )
                          },
                        )

                        let _ = headless::button(
                          ren_row,
                          fn() -> String { "Save Space Name" },
                          fn(_v : view::View) -> Unit { commit_rename() },
                          fn(sb : view::View, _sbtn : headless::Button) -> Unit {
                            let _ = sb
                            .height(view::Live::Is(Some(30.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                            .radius(view::Live::Is(7.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent }))
                            let _ = sb.box(
                              fn(sl : view::View) -> Unit {
                                let _ = sl.words(
                                  view::Live::Is("Save"),
                                  ink=0xFFFFFFFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                  one_line=true,
                                )
                              },
                            )
                          },
                        )
                      },
                    )

                    // Inline 6-Color Accent Picker Row (mounted only when clicking the Space dot)
                    row_outer.show(
                      is_recoloring,
                      fn(col_row : view::View) -> Unit {
                        let _ = col_row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .gap(view::Live::Is(6.0))
                        .rigid()
                        let presets = proto::arc_space_accent_presets()
                        let mut ci = 0
                        while ci < presets.length() {
                          let p_item = presets[ci]
                          let p_hex = p_item.hex
                          let p_rgba = p_item.rgba
                          let p_lbl = p_item.label
                          let is_cur = fn() -> Bool {
                            proto::normalize_space_accent(get_sp().accent) == p_hex
                          }
                          let _ = headless::button(
                            col_row,
                            fn() -> String { "Set Space color " + p_lbl },
                            fn(_v : view::View) -> Unit {
                              let sp = get_sp()
                              if sp.id != "" {
                                dispatch_space_accent(sp.id, p_hex)
                                spaces_color_edit_id.set("")
                              }
                            },
                            fn(sw : view::View, _btn : headless::Button) -> Unit {
                              let _ = sw
                              .width(view::Live::Is(Some(24.0)))
                              .height(view::Live::Is(Some(24.0)))
                              .rigid()
                              .center()
                              .radius(view::Live::Is(12.0))
                              .edge(view::Live::By(fn() -> (Double, Int64) {
                                if is_cur() { (1.8, p_rgba) } else { (0.0, 0x00000000L) }
                              }))
                              let _ = sw.box(
                                fn(d : view::View) -> Unit {
                                  let _ = d
                                  .width(view::Live::Is(Some(16.0)))
                                  .height(view::Live::Is(Some(16.0)))
                                  .rigid()
                                  .radius(view::Live::Is(8.0))
                                  .ground(view::Live::Is(p_rgba))
                                },
                              )
                            },
                          )
                          ci = ci + 1
                        }
                      },
                    )
                  },
                )
                slot = slot + 1
              }
            },
          )
        },
      )
    },
  )
}

// --- 2. Recently Closed Tabs Picker Modal (`wire` tag 66 `ClosedTabsState`, 520pt centered) ---

fn build_closed_tabs_modal(
  root : view::View,
  closed_tabs_open : signals::Signal[Bool],
  closed_tabs_rev : signals::Signal[Int],
  closed_tabs_field : ui::Field,
) -> Unit {
  root.show(
    fn() -> Bool { closed_tabs_open.get() },
    fn(ct_layer : view::View) -> Unit {
      let _ = ct_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Dimmed backdrop
      let _ = headless::button(
        ct_layer,
        fn() -> String { "Close Recently Closed Tabs" },
        fn(_v : view::View) -> Unit { close_closed_tabs_modal() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05081068L } else { 0x0F172A40L }
          }))
        },
      )

      let get_filtered = fn() -> Array[proto::ClosedTabItem] {
        let _ = closed_tabs_rev.get()
        proto::filter_closed_tabs(app_state.closed_tabs_snap.items, closed_tabs_field.text())
      }

      // Centered Modal Card (520pt wide, concentric radii 14 -> 10 -> 8 -> 6pt)
      let _ = ct_layer.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(520.0)))
          .max_height(view::Live::Is(Some(540.0)))
          .radius(view::Live::Is(14.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (34.0, 14.0, 0x00000072L) } else { (30.0, 12.0, 0x0F172A2CL) }
          }))

          // Header
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((18.0, 14.0, 14.0, 12.0)))
              .gap(view::Live::Is(8.0))
              .rigid()

              let _ = hdr.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .words(
                    view::Live::Is("Recently Closed Tabs"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              // Count pill
              let _ = hdr.box(
                fn(cp : view::View) -> Unit {
                  let _ = cp
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                  let _ = cp.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .words(
                        view::Live::By(fn() -> String {
                          let _ = closed_tabs_rev.get()
                          app_state.closed_tabs_snap.items.length().to_string()
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                },
              )

              let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

              // Clear All button (mounted ONLY when closed stack is non-empty)
              hdr.show(
                fn() -> Bool {
                  let _ = closed_tabs_rev.get()
                  app_state.closed_tabs_snap.items.length() > 0
                },
                fn(clr_wrap : view::View) -> Unit {
                  let _ = headless::button(
                    clr_wrap,
                    fn() -> String { "Clear Recently Closed Tabs" },
                    fn(_v : view::View) -> Unit { dispatch_closed_tabs_clear() },
                    fn(cb : view::View, cbtn : headless::Button) -> Unit {
                      let _ = cb
                      .height(view::Live::Is(Some(26.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .radius(view::Live::Is(7.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if cbtn.pressed() || cbtn.hovered() { p.danger_bg } else { 0x00000000L }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        let p = chrome_palette()
                        if cbtn.pressed() || cbtn.hovered() { (1.0, p.danger_border) } else { (0.0, 0x00000000L) }
                      }))
                      let _ = cb.box(
                        fn(cl : view::View) -> Unit {
                          let _ = cl
                          .words(
                            view::Live::Is("Clear All"),
                            ink=0xDC2626FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().danger }))
                        },
                      )
                    },
                  )
                },
              )

              let _ = headless::button(
                hdr,
                fn() -> String { "Close Recently Closed Tabs" },
                fn(_v : view::View) -> Unit { close_closed_tabs_modal() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(26.0)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(7.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Search Input Row
          let _ = card.box(
            fn(sr_wrap : view::View) -> Unit {
              let _ = sr_wrap.padding(view::Live::Is((16.0, 0.0, 16.0, 12.0))).rigid()
              let _ = sr_wrap.box(
                fn(sf : view::View) -> Unit {
                  let _ = sf
                  .height(view::Live::Is(Some(34.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((11.0, 0.0, 8.0, 0.0)))
                  .gap(view::Live::Is(8.0))
                  .radius(view::Live::Is(8.0))
                  .clips(view::Live::Is(true))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().addr_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if closed_tabs_field.focused() { (1.2, p.accent) } else { (1.0, p.border) }
                  }))
                  let _ = sf.box(
                    fn(fi : view::View) -> Unit {
                      let _ = fi
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      fi.show(
                        fn() -> Bool { !is_dark_chrome() },
                        fn(fl : view::View) -> Unit {
                          let _ = ui::field(
                            fl,
                            closed_tabs_field,
                            placeholder="Filter closed tabs by title, domain or Space...",
                            font_size=12.5,
                            color=0x1D1D1FFFL,
                            placeholder_color=0x8E8E93FFL,
                            caret_color=0x2563EBFFL,
                            max_lines=1,
                            enter_sends=true,
                            submitted=fn(_t : String) -> Unit {
                              let items = get_filtered()
                              if items.length() > 0 {
                                let it = items[0]
                                close_closed_tabs_modal()
                                dispatch_tab_reopen_at(it.index, it.title)
                              }
                            },
                          )
                        },
                      )
                      fi.show(
                        fn() -> Bool { is_dark_chrome() },
                        fn(fd : view::View) -> Unit {
                          let _ = ui::field(
                            fd,
                            closed_tabs_field,
                            placeholder="Filter closed tabs by title, domain or Space...",
                            font_size=12.5,
                            color=0xF1F5F9FFL,
                            placeholder_color=0x94A3B8FFL,
                            caret_color=0x60A5FAFFL,
                            max_lines=1,
                            enter_sends=true,
                            submitted=fn(_t : String) -> Unit {
                              let items = get_filtered()
                              if items.length() > 0 {
                                let it = items[0]
                                close_closed_tabs_modal()
                                dispatch_tab_reopen_at(it.index, it.title)
                              }
                            },
                          )
                        },
                      )
                    },
                  )
                  sf.show(
                    fn() -> Bool { closed_tabs_field.text().trim() != "" },
                    fn(xw : view::View) -> Unit {
                      let _ = headless::button(
                        xw,
                        fn() -> String { "Clear Filter" },
                        fn(_v : view::View) -> Unit { closed_tabs_field.set("") },
                        fn(xb : view::View, xbtn : headless::Button) -> Unit {
                          let _ = xb
                          .width(view::Live::Is(Some(20.0)))
                          .height(view::Live::Is(Some(20.0)))
                          .rigid()
                          .center()
                          .radius(view::Live::Is(5.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                          }))
                          let _ = xb.box(
                            fn(xl : view::View) -> Unit {
                              let _ = xl
                              .words(
                                view::Live::Is("×"),
                                ink=0x6B7280FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Single hairline above list
          let _ = card.box(
            fn(hl : view::View) -> Unit {
              let _ = hl.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Closed Tabs List (up to 16 entries)
          let _ = card.box(
            fn(list_body : view::View) -> Unit {
              let _ = list_body.padding(view::Live::Is((12.0, 10.0, 12.0, 12.0))).gap(view::Live::Is(4.0)).rigid()

              // Empty state
              list_body.show(
                fn() -> Bool { get_filtered().length() == 0 },
                fn(emp : view::View) -> Unit {
                  let _ = emp
                  .padding(view::Live::Is((16.0, 28.0, 16.0, 28.0)))
                  .center()
                  .gap(view::Live::Is(6.0))
                  let _ = emp.box(
                    fn(et : view::View) -> Unit {
                      let _ = et
                      .words(
                        view::Live::By(fn() -> String {
                          if closed_tabs_field.text().trim() != "" {
                            "No matching closed tabs"
                          } else {
                            "No recently closed tabs"
                          }
                        }),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                  let _ = emp.box(
                    fn(es : view::View) -> Unit {
                      let _ = es
                      .words(
                        view::Live::Is("Tabs you close appear here for one-click restoration."),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              let mut slot = 0
              while slot < proto::CLOSED_TABS_MAX_ITEMS {
                let idx = slot
                list_body.show(
                  fn() -> Bool { idx < get_filtered().length() },
                  fn(rw : view::View) -> Unit {
                    let get_item = fn() -> proto::ClosedTabItem {
                      let arr = get_filtered()
                      if idx < arr.length() {
                        arr[idx]
                      } else {
                        proto::ClosedTabItem::{
                          index: 0,
                          title: "",
                          url: "",
                          host: "",
                          space_name: "",
                          closed_secs: 0L,
                        }
                      }
                    }
                    let _ = headless::button(
                      rw,
                      fn() -> String { "Restore " + get_item().title },
                      fn(_v : view::View) -> Unit {
                        let it = get_item()
                        close_closed_tabs_modal()
                        dispatch_tab_reopen_at(it.index, it.title)
                      },
                      fn(row : view::View, btn : headless::Button) -> Unit {
                        let _ = row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Start)))
                        .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
                        .gap(view::Live::Is(10.0))
                        .radius(view::Live::Is(9.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if btn.pressed() { p.tab_press_bg } else if btn.hovered() { p.tab_hover_bg } else { 0x00000000L }
                        }))

                        // First-line aligned monogram icon box
                        let _ = row.box(
                          fn(ic : view::View) -> Unit {
                            let _ = ic
                            .width(view::Live::Is(Some(22.0)))
                            .height(view::Live::Is(Some(22.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() -> Int64 { chrome_palette().btn_bg }))
                            let _ = ic.box(
                              fn(il : view::View) -> Unit {
                                let _ = il
                                .words(
                                  view::Live::By(fn() -> String {
                                    let it = get_item()
                                    proto::omnibox_initial_letter(it.url, it.title)
                                  }),
                                  ink=0x3A4152FFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                              },
                            )
                          },
                        )

                        // Two-line content block (first line: Title + Relative Time; second line: Host + Space Badge)
                        let _ = row.box(
                          fn(col : view::View) -> Unit {
                            let _ = col
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .gap(view::Live::Is(4.0))

                            // Line 1: Title + Relative Time
                            let _ = col.box(
                              fn(l1 : view::View) -> Unit {
                                let _ = l1
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .gap(view::Live::Is(8.0))
                                let _ = l1.box(
                                  fn(tt : view::View) -> Unit {
                                    let _ = tt
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String { get_item().title }),
                                      ink=0x1D1D1FFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                  },
                                )
                                let _ = l1.box(
                                  fn(tm : view::View) -> Unit {
                                    let _ = tm
                                    .rigid()
                                    .words(
                                      view::Live::By(fn() -> String {
                                        proto::format_closed_relative_time(get_item().closed_secs, app_now_secs())
                                      }),
                                      ink=0x6B7280FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )
                              },
                            )

                            // Line 2: Host + Space Badge (no `·` middle-dot concatenation)
                            let _ = col.box(
                              fn(l2 : view::View) -> Unit {
                                let _ = l2
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                .gap(view::Live::Is(8.0))
                                let _ = l2.box(
                                  fn(hs : view::View) -> Unit {
                                    let _ = hs
                                    .shrink(view::Live::Is(1.0))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String { get_item().host }),
                                      ink=0x6B7280FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )
                                l2.show(
                                  fn() -> Bool { get_item().space_name.trim() != "" },
                                  fn(sp_b : view::View) -> Unit {
                                    let _ = sp_b
                                    .height(view::Live::Is(Some(18.0)))
                                    .rigid()
                                    .center()
                                    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                    .radius(view::Live::Is(5.0))
                                    .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                                    .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                                    let _ = sp_b.box(
                                      fn(sl : view::View) -> Unit {
                                        let _ = sl
                                        .words(
                                          view::Live::By(fn() -> String { get_item().space_name }),
                                          ink=0x1D4ED8FFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
                slot = slot + 1
              }
            },
          )
        },
      )
    },
  )
}

// --- 3. Native `Cmd+P` Print / Export PDF Configuration Modal (648pt centered, Light & Dark) ---

fn build_print_segment_btn(
  parent : view::View,
  label : String,
  is_active : () -> Bool,
  on_pick : () -> Unit,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() -> String { label },
    fn(_v : view::View) -> Unit { on_pick() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let _ = b
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .height(view::Live::Is(Some(32.0)))
      .center()
      .radius(view::Live::Is(7.0))
      .ground(view::Live::By(fn() -> Int64 {
        let p = chrome_palette()
        if is_active() {
          p.surface_bg
        } else if btn.pressed() {
          p.btn_press
        } else if btn.hovered() {
          p.btn_hover
        } else {
          0x00000000L
        }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        let p = chrome_palette()
        if is_active() { (1.0, p.border) } else { (0.0, 0x00000000L) }
      }))
      let _ = b.box(
        fn(tl : view::View) -> Unit {
          let _ = tl
          .words(
            view::Live::Is(label),
            ink=0x1D1D1FFFL,
            look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
            one_line=true,
          )
          .ink(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if is_active() { p.ink_primary } else { p.ink_secondary }
          }))
        },
      )
    },
  )
}

fn build_print_pdf_modal(
  root : view::View,
  print_pdf_open : signals::Signal[Bool],
  print_paper : signals::Signal[String],
  print_orientation : signals::Signal[String],
  print_margins : signals::Signal[String],
  print_bg_graphics : signals::Signal[Bool],
) -> Unit {
  root.show(
    fn() -> Bool { print_pdf_open.get() },
    fn(pr_layer : view::View) -> Unit {
      let _ = pr_layer
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .center()

      // Dimmed backdrop
      let _ = headless::button(
        pr_layer,
        fn() -> String { "Close Export PDF Dialog" },
        fn(_v : view::View) -> Unit { close_print_pdf_modal() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg
          .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
          .ground(view::Live::By(fn() -> Int64 {
            if is_dark_chrome() { 0x05081068L } else { 0x0F172A40L }
          }))
        },
      )

      let page_title_fn = fn() -> String {
        let st = pane_stage(app_state.print_owner_pane)
        let t = st.title().trim()
        if t != "" {
          t
        } else {
          let h = proto::omnibox_display_host(st.url())
          if h != "" { h } else { "Untitled Document" }
        }
      }

      let clean_url_fn = fn() -> String {
        let u = proto::clean_tracking_url(pane_stage(app_state.print_owner_pane).url())
        let h = proto::omnibox_display_host(u)
        if h != "" { h } else if u != "" { u } else { "about:blank" }
      }

      // Centered Export PDF Card (648pt wide, concentric 14 -> 10 -> 8 -> 6pt radii)
      let _ = pr_layer.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(648.0)))
          .radius(view::Live::Is(14.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (34.0, 14.0, 0x00000072L) } else { (30.0, 12.0, 0x0F172A2CL) }
          }))

          // Header Row
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((20.0, 14.0, 14.0, 12.0)))
              .gap(view::Live::Is(10.0))
              .rigid()

              let _ = hdr.box(
                fn(tt : view::View) -> Unit {
                  let _ = tt
                  .words(
                    view::Live::Is("Export PDF"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 15.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              // Paper spec pill (e.g. "210 × 297 mm")
              let _ = hdr.box(
                fn(sp_pill : view::View) -> Unit {
                  let _ = sp_pill
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                  let _ = sp_pill.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .words(
                        view::Live::By(fn() -> String {
                          proto::print_pdf_spec_summary(current_print_pdf_config())
                        }),
                        ink=0x1D4ED8FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )

              let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

              let _ = headless::button(
                hdr,
                fn() -> String { "Close Export PDF Dialog" },
                fn(_v : view::View) -> Unit { close_print_pdf_modal() },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(26.0)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(7.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() { p.btn_press } else if xbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Single hairline under header
          let _ = card.box(
            fn(hl1 : view::View) -> Unit {
              let _ = hl1.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Main Body: Left Visual Paper Preview + Right Controls
          let _ = card.box(
            fn(body : view::View) -> Unit {
              let _ = body
              .row(view::Live::Is(true))
              .rigid()

              // Left Preview Column (262pt wide, subtle canvas)
              let _ = body.box(
                fn(prev_col : view::View) -> Unit {
                  let _ = prev_col
                  .width(view::Live::Is(Some(262.0)))
                  .rigid()
                  .padding(view::Live::Is((20.0, 20.0, 20.0, 18.0)))
                  .gap(view::Live::Is(12.0))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

                  // Stage box to center the proportional paper sheet
                  let _ = prev_col.box(
                    fn(sheet_stage : view::View) -> Unit {
                      let _ = sheet_stage
                      .width(view::Live::Is(Some(222.0)))
                      .height(view::Live::Is(Some(254.0)))
                      .rigid()
                      .center()

                      // Dynamic proportional paper sheet (A4/Letter x Portrait/Landscape)
                      let _ = sheet_stage.box(
                        fn(sheet : view::View) -> Unit {
                          let _ = sheet
                          .width(view::Live::By(fn() -> Option[Double] {
                            let cfg = current_print_pdf_config()
                            let ratio = proto::print_pdf_aspect_ratio(cfg)
                            if ratio >= 1.0 {
                              Some(212.0)
                            } else {
                              Some((236.0 * ratio).floor())
                            }
                          }))
                          .height(view::Live::By(fn() -> Option[Double] {
                            let cfg = current_print_pdf_config()
                            let ratio = proto::print_pdf_aspect_ratio(cfg)
                            if ratio >= 1.0 {
                              Some((212.0 / ratio).floor())
                            } else {
                              Some(236.0)
                            }
                          }))
                          .rigid()
                          .radius(view::Live::Is(5.0))
                          .clips(view::Live::Is(true))
                          .ground(view::Live::Is(0xFFFFFFFFL))
                          .edge(view::Live::By(fn() -> (Double, Int64) {
                            if is_dark_chrome() { (1.0, 0x3A4152FFL) } else { (1.0, 0xCBD5E1FFL) }
                          }))
                          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
                            if is_dark_chrome() { (16.0, 6.0, 0x00000055L) } else { (14.0, 5.0, 0x0F172A1CL) }
                          }))
                          .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
                            let cfg = current_print_pdf_config()
                            let (fx, fy) = proto::print_pdf_margin_fraction(cfg)
                            let ratio = proto::print_pdf_aspect_ratio(cfg)
                            let sw = if ratio >= 1.0 { 212.0 } else { 236.0 * ratio }
                            let sh = if ratio >= 1.0 { 212.0 / ratio } else { 236.0 }
                            let px = (sw * fx * 1.4).floor()
                            let py = (sh * fy * 1.4).floor()
                            (px, py, px, py)
                          }))

                          // Inner printable margin guide box
                          let _ = sheet.box(
                            fn(inner : view::View) -> Unit {
                              let _ = inner
                              .fill()
                              .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
                              .gap(view::Live::Is(6.0))
                              .radius(view::Live::Is(2.0))
                              .clips(view::Live::Is(true))
                              .edge(view::Live::By(fn() -> (Double, Int64) {
                                if proto::normalize_print_margins(print_margins.get()) == "none" {
                                  (0.0, 0x00000000L)
                                } else {
                                  (1.0, 0xCBD5E1FFL)
                                }
                              }))

                              // Optional background graphics header accent bar
                              inner.show(
                                fn() -> Bool { print_bg_graphics.get() },
                                fn(bg_bar : view::View) -> Unit {
                                  let _ = bg_bar
                                  .height(view::Live::Is(Some(22.0)))
                                  .rigid()
                                  .radius(view::Live::Is(3.0))
                                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                  .row(view::Live::Is(true))
                                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                  .ground(view::Live::Is(0xEAF3FFFFL))
                                  .edge(view::Live::Is((1.0, 0xBFD7FFFFL)))
                                  let _ = bg_bar.box(
                                    fn(bdot : view::View) -> Unit {
                                      let _ = bdot
                                      .width(view::Live::Is(Some(6.0)))
                                      .height(view::Live::Is(Some(6.0)))
                                      .rigid()
                                      .radius(view::Live::Is(3.0))
                                      .ground(view::Live::Is(0x2563EBFFL))
                                    },
                                  )
                                },
                              )

                              // Page Title preview
                              let _ = inner.box(
                                fn(pt : view::View) -> Unit {
                                  let _ = pt
                                  .clips(view::Live::Is(true))
                                  .words(
                                    view::Live::By(page_title_fn),
                                    ink=0x111827FFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: true },
                                  )
                                },
                              )

                              // Clean URL preview
                              let _ = inner.box(
                                fn(pu : view::View) -> Unit {
                                  let _ = pu
                                  .clips(view::Live::Is(true))
                                  .words(
                                    view::Live::By(clean_url_fn),
                                    ink=0x2563EBFFL,
                                    look=view::WordsLook::{ ..view::words_plain, size: 7.5, weight: 500, wrap: false },
                                    one_line=true,
                                  )
                                },
                              )

                              // Clean typographic wireframe lines representing document body
                              let _ = inner.box(
                                fn(lines : view::View) -> Unit {
                                  let _ = lines.padding(view::Live::Is((0.0, 4.0, 0.0, 0.0))).gap(view::Live::Is(5.0)).rigid()
                                  let widths : Array[Double] = [1.0, 0.92, 0.84, 0.96, 0.68]
                                  let mut li = 0
                                  while li < widths.length() {
                                    let frac = widths[li]
                                    let _ = lines.box(
                                      fn(ln : view::View) -> Unit {
                                        let _ = ln
                                        .height(view::Live::Is(Some(4.0)))
                                        .width(view::Live::Is(Some((116.0 * frac).floor())))
                                        .rigid()
                                        .radius(view::Live::Is(2.0))
                                        .ground(view::Live::Is(0xE2E8F0FFL))
                                      },
                                    )
                                    li = li + 1
                                  }
                                },
                              )
                            },
                          )
                        },
                      )
                    },
                  )

                  // Preview Caption (Page Title + Clean URL, zero middle-dot)
                  let _ = prev_col.box(
                    fn(cap : view::View) -> Unit {
                      let _ = cap.gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid()
                      let _ = cap.box(
                        fn(ct : view::View) -> Unit {
                          let _ = ct
                          .max_width(view::Live::Is(Some(220.0)))
                          .clips(view::Live::Is(true))
                          .words(
                            view::Live::By(page_title_fn),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                      let _ = cap.box(
                        fn(cu : view::View) -> Unit {
                          let _ = cu
                          .max_width(view::Live::Is(Some(220.0)))
                          .clips(view::Live::Is(true))
                          .words(
                            view::Live::By(clean_url_fn),
                            ink=0x6B7280FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                    },
                  )
                },
              )

              // Single vertical hairline separator
              let _ = body.box(
                fn(vhl : view::View) -> Unit {
                  let _ = vhl.width(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )

              // Right Configuration Controls Column
              let _ = body.box(
                fn(cfg_col : view::View) -> Unit {
                  let _ = cfg_col
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .padding(view::Live::Is((22.0, 20.0, 22.0, 20.0)))
                  .gap(view::Live::Is(18.0))

                  // 1. Paper Size (A4 / Letter)
                  let _ = cfg_col.box(
                    fn(sec : view::View) -> Unit {
                      let _ = sec.gap(view::Live::Is(7.0)).rigid()
                      let _ = sec.box(
                        fn(lbl : view::View) -> Unit {
                          let _ = lbl
                          .words(
                            view::Live::Is("Paper Size"),
                            ink=0x3A4152FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                      let _ = sec.box(
                        fn(seg : view::View) -> Unit {
                          let _ = seg
                          .row(view::Live::Is(true))
                          .padding(view::Live::Is((3.0, 3.0, 3.0, 3.0)))
                          .gap(view::Live::Is(4.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                          build_print_segment_btn(
                            seg,
                            "A4",
                            fn() -> Bool { proto::normalize_print_paper(print_paper.get()) == "a4" },
                            fn() -> Unit { print_paper.set("a4") },
                          )
                          build_print_segment_btn(
                            seg,
                            "Letter",
                            fn() -> Bool { proto::normalize_print_paper(print_paper.get()) == "letter" },
                            fn() -> Unit { print_paper.set("letter") },
                          )
                        },
                      )
                    },
                  )

                  // 2. Orientation (Portrait / Landscape)
                  let _ = cfg_col.box(
                    fn(sec : view::View) -> Unit {
                      let _ = sec.gap(view::Live::Is(7.0)).rigid()
                      let _ = sec.box(
                        fn(lbl : view::View) -> Unit {
                          let _ = lbl
                          .words(
                            view::Live::Is("Orientation"),
                            ink=0x3A4152FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                      let _ = sec.box(
                        fn(seg : view::View) -> Unit {
                          let _ = seg
                          .row(view::Live::Is(true))
                          .padding(view::Live::Is((3.0, 3.0, 3.0, 3.0)))
                          .gap(view::Live::Is(4.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                          build_print_segment_btn(
                            seg,
                            "Portrait",
                            fn() -> Bool { proto::normalize_print_orientation(print_orientation.get()) == "portrait" },
                            fn() -> Unit { print_orientation.set("portrait") },
                          )
                          build_print_segment_btn(
                            seg,
                            "Landscape",
                            fn() -> Bool { proto::normalize_print_orientation(print_orientation.get()) == "landscape" },
                            fn() -> Unit { print_orientation.set("landscape") },
                          )
                        },
                      )
                    },
                  )

                  // 3. Margins (Default / Narrow / None)
                  let _ = cfg_col.box(
                    fn(sec : view::View) -> Unit {
                      let _ = sec.gap(view::Live::Is(7.0)).rigid()
                      let _ = sec.box(
                        fn(lbl : view::View) -> Unit {
                          let _ = lbl
                          .words(
                            view::Live::Is("Margins"),
                            ink=0x3A4152FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                        },
                      )
                      let _ = sec.box(
                        fn(seg : view::View) -> Unit {
                          let _ = seg
                          .row(view::Live::Is(true))
                          .padding(view::Live::Is((3.0, 3.0, 3.0, 3.0)))
                          .gap(view::Live::Is(4.0))
                          .radius(view::Live::Is(10.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                          build_print_segment_btn(
                            seg,
                            "Default",
                            fn() -> Bool { proto::normalize_print_margins(print_margins.get()) == "default" },
                            fn() -> Unit { print_margins.set("default") },
                          )
                          build_print_segment_btn(
                            seg,
                            "Narrow",
                            fn() -> Bool { proto::normalize_print_margins(print_margins.get()) == "narrow" },
                            fn() -> Unit { print_margins.set("narrow") },
                          )
                          build_print_segment_btn(
                            seg,
                            "None",
                            fn() -> Bool { proto::normalize_print_margins(print_margins.get()) == "none" },
                            fn() -> Unit { print_margins.set("none") },
                          )
                        },
                      )
                    },
                  )

                  // 4. Background graphics toggle switch
                  let _ = headless::button(
                    cfg_col,
                    fn() -> String { "Toggle Background Graphics" },
                    fn(_v : view::View) -> Unit { print_bg_graphics.set(!print_bg_graphics.untracked()) },
                    fn(row : view::View, btn : headless::Button) -> Unit {
                      let _ = row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
                      .gap(view::Live::Is(10.0))
                      .radius(view::Live::Is(10.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if btn.pressed() { p.tab_press_bg } else if btn.hovered() { p.tab_hover_bg } else { p.surface_subtle }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))

                      let _ = row.box(
                        fn(txt : view::View) -> Unit {
                          let _ = txt.grow(view::Live::Is(1.0)).gap(view::Live::Is(2.0))
                          let _ = txt.box(
                            fn(tl : view::View) -> Unit {
                              let _ = tl
                              .words(
                                view::Live::Is("Background graphics"),
                                ink=0x1D1D1FFFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                            },
                          )
                          let _ = txt.box(
                            fn(sl : view::View) -> Unit {
                              let _ = sl
                              .words(
                                view::Live::Is("Include CSS background colors & images"),
                                ink=0x6B7280FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                            },
                          )
                        },
                      )

                      // Toggle pill switch
                      let _ = row.box(
                        fn(sw : view::View) -> Unit {
                          let _ = sw
                          .width(view::Live::Is(Some(38.0)))
                          .height(view::Live::Is(Some(22.0)))
                          .rigid()
                          .radius(view::Live::Is(11.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            let p = chrome_palette()
                            if print_bg_graphics.get() { p.accent } else { p.btn_bg }
                          }))
                          let _ = sw.box(
                            fn(knob : view::View) -> Unit {
                              let _ = knob
                              .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
                                let left = if print_bg_graphics.get() { 18.0 } else { 2.0 }
                                (Some(left), Some(2.0), None, None)
                              }))
                              .width(view::Live::Is(Some(18.0)))
                              .height(view::Live::Is(Some(18.0)))
                              .radius(view::Live::Is(9.0))
                              .ground(view::Live::Is(0xFFFFFFFFL))
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // Footer: Single hairline + Cancel + Save as PDF
          let _ = card.box(
            fn(hl2 : view::View) -> Unit {
              let _ = hl2.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          let _ = card.box(
            fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((20.0, 12.0, 20.0, 12.0)))
              .gap(view::Live::Is(10.0))
              .rigid()

              let _ = ftr.box(
                fn(dest : view::View) -> Unit {
                  let _ = dest
                  .words(
                    view::Live::Is("Destination: Downloads folder"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )

              let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

              // Cancel button
              let _ = headless::button(
                ftr,
                fn() -> String { "Cancel Export PDF" },
                fn(_v : view::View) -> Unit { close_print_pdf_modal() },
                fn(cb : view::View, cbtn : headless::Button) -> Unit {
                  let _ = cb
                  .height(view::Live::Is(Some(34.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if cbtn.pressed() { p.btn_press } else if cbtn.hovered() { p.btn_hover } else { p.btn_bg }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = cb.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .words(
                        view::Live::Is("Cancel"),
                        ink=0x1D1D1FFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                    },
                  )
                },
              )

              // Primary Save as PDF CTA
              let _ = headless::button(
                ftr,
                fn() -> String { "Save as PDF" },
                fn(_v : view::View) -> Unit {
                  let cfg = current_print_pdf_config_untracked()
                  close_print_pdf_modal()
                  dispatch_export_pdf_with_config(cfg)
                },
                fn(sb : view::View, sbtn : headless::Button) -> Unit {
                  let _ = sb
                  .height(view::Live::Is(Some(34.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((18.0, 0.0, 18.0, 0.0)))
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if sbtn.pressed() { 0x1D4ED8FFL } else { 0x2563EBFFL }
                  }))
                  let _ = sb.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl.words(
                        view::Live::Is("Save as PDF"),
                        ink=0xFFFFFFFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
