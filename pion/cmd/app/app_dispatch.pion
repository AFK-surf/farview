///| App-level dispatch and routing: wire/proto sends, split / peek, omnibox, command bar, workspace, tabs,
///| find and key handling (no UI).

fn send_proto(msg : proto::ClientMsg) -> Unit {
  enqueue_main_bytes(proto::encode_client(msg), coalescable=is_proto_coalescable(msg))
}

///| Tests see what is sent to the main host here instead.
let test_send_wire_hook : signals::Ref[Option[(wire::Message) -> Unit]] = ui::ref_new(None)

fn send_wire(msg : wire::Message) -> Unit {
  match test_send_wire_hook.v {
    Some(hook) => hook(msg)
    None => enqueue_main_bytes(wire::encode(msg), coalescable=is_wire_coalescable(msg))
  }
}

fn is_sidebar_open() -> Bool {
  shell_adapter.dock.untracked().sidebar_open
}

fn is_sidebar_open_live() -> Bool {
  shell_adapter.dock.get().sidebar_open
}

fn set_sidebar_open(open : Bool) -> Unit {
  let cur = shell_adapter.dock.untracked()
  let sb_w = settings_sidebar_width()
  if cur.sidebar_open != open || (cur.sidebar_width - sb_w).abs() > 0.5 {
    shell_adapter.dock.set(shell_ui::DockState::{ ..cur, sidebar_open: open, sidebar_width: sb_w })
  }
}

fn is_split_open() -> Bool {
  shell_adapter.page.untracked().layout is shell_ui::PageLayout::Split
}

fn is_split_open_live() -> Bool {
  shell_adapter.page.get().layout is shell_ui::PageLayout::Split
}

fn active_split_pane() -> Int {
  let p = shell_adapter.page.untracked()
  if (p.layout is shell_ui::PageLayout::Split) && (p.active_pane is shell_ui::PaneId::Secondary) {
    1
  } else {
    0
  }
}

fn active_split_pane_live() -> Int {
  let p = shell_adapter.page.get()
  if (p.layout is shell_ui::PageLayout::Split) && (p.active_pane is shell_ui::PaneId::Secondary) {
    1
  } else {
    0
  }
}

fn pane_stage(pane_id : Int) -> stage::Stage {
  if pane_id == 1 && (is_split_open() || is_peek_open()) {
    match app_state.split_stage {
      Some(st) => st
      None => get_stage()
    }
  } else {
    get_stage()
  }
}

fn active_find_stage() -> stage::Stage {
  pane_stage(shell_adapter.find_owner_pane)
}

fn ensure_split_stage() -> stage::Stage {
  match app_state.split_stage {
    Some(st) => st
    None => {
      let st = stage::Stage::new(
        fn(bytes : Bytes) -> Unit {
          enqueue_split_bytes(bytes, coalescable=proto::is_pointer_move_frame(bytes))
        },
        fonts=app_state.default_fonts,
      )
      st.set_copier(copy_rich_to_os)
      st.set_noter(fn(m : String) -> Unit { show_toast(m, "warning") })
      app_state.split_stage = Some(st)
      st
    }
  }
}

fn active_stage() -> stage::Stage {
  if is_split_open() && active_split_pane() == 1 {
    match app_state.split_stage {
      Some(st) => st
      None => get_stage()
    }
  } else {
    get_stage()
  }
}

fn active_stage_live() -> stage::Stage {
  if is_split_open_live() && active_split_pane_live() == 1 {
    match app_state.split_stage {
      Some(st) => st
      None => get_stage()
    }
  } else {
    get_stage()
  }
}

fn active_targets_split() -> Bool {
  is_split_open() && active_split_pane() == 1
}

fn send_proto_active(msg : proto::ClientMsg) -> Unit {
  let data = proto::encode_client(msg)
  let coal = is_proto_coalescable(msg)
  if active_targets_split() {
    enqueue_split_bytes(data, coalescable=coal)
  } else {
    enqueue_main_bytes(data, coalescable=coal)
  }
}

fn send_wire_active(msg : wire::Message) -> Unit {
  let data = wire::encode(msg)
  let coal = is_wire_coalescable(msg)
  if active_targets_split() {
    enqueue_split_bytes(data, coalescable=coal)
  } else {
    enqueue_main_bytes(data, coalescable=coal)
  }
}

fn send_wire_to_pane_checked(pane_id : Int, msg : wire::Message) -> Bool {
  let data = wire::encode(msg)
  let coal = is_wire_coalescable(msg)
  if pane_id == 1 {
    if !(is_split_open() || is_peek_open()) {
      return false
    }
    return enqueue_split_bytes_at(data, coalescable=coal, clock_fn=now_ms)
  }
  enqueue_main_bytes_at(data, coalescable=coal, clock_fn=now_ms)
}

fn send_wire_to_pane(pane_id : Int, msg : wire::Message) -> Unit {
  let _ = send_wire_to_pane_checked(pane_id, msg)
}

fn sync_address_bar_from_active() -> Unit {
  match app_state.address_field {
    Some(addr) if !addr.focused() => {
      app_state.syncing_address_url = true
      addr.set(proto::omnibox_safe_display_url(active_address_raw_url_untracked()))
      app_state.syncing_address_url = false
    }
    _ => ()
  }
}

fn set_active_split_pane(pane : Int) -> Unit {
  let p = if pane == 1 && (is_split_open() || is_peek_open()) { 1 } else { 0 }
  shell_page_set_active_pane(p)
  sync_address_bar_from_active()
}

///| The page Split View (Cmd/Ctrl+Shift+\) or Peek (Cmd/Ctrl+Shift+P, no link under the pointer) opens beside
///| this one: the most recently used other tab in this Space (`workspace_mru_tabs`, by last use), never the first
///| tab in list order (often a favorite or another Space's). With no other tab, a blank page rather than a copy of
///| this one.
fn pick_default_split_target() -> (String, String) {
  let ws = app_state.workspace
  let recent = proto::workspace_mru_tabs(ws, ws.active_space_id)
  for t in recent {
    if !t.active && t.id != ws.active_tab_id && t.url != "" {
      return (t.url, t.id)
    }
  }
  ("about:blank", "")
}

fn open_split_view(target_url : String, tab_id : String, focus_pane~ : Int = 1, quiet~ : Bool = false) -> Unit {
  let sp_st = ensure_split_stage()
  let clean_url = target_url.trim()
  let chosen_url = if clean_url != "" {
    clean_url
  } else {
    let cur = get_stage().url()
    if cur != "" { cur } else { "about:blank" }
  }
  match app_state.split_tab_id {
    Some(s) => s.set(tab_id)
    None => ()
  }
  if is_split_open() || is_peek_open() {
    // Reuse existing Secondary Stage & host connection across Split <-> Peek with 0 remounts!
    let was_peek = is_peek_open()
    let _ = shell_page_open_split(focus_pane)
    if was_peek {
      match app_state.peek_tab_id {
        Some(s) => if s.untracked() != "" { s.set("") }
        None => ()
      }
      match app_state.peek_url {
        Some(s) => if s.untracked() != "" { s.set("") }
        None => ()
      }
      io_rt.split_spawn_is_peek = false
      io_rt.peek_open_sent = false
      send_wire(wire::Message::Act("peek_close", "", ""))
    }
    if clean_url != "" && clean_url != sp_st.url().trim() {
      if io_rt.split_conn.is_open() {
        sp_st.go(clean_url)
      } else {
        app_state.split_pending_url = clean_url
      }
    }
    set_active_split_pane(focus_pane)
    // (no toast: the new pane fading in is the answer)
    ignore(quiet)
    return
  }
  app_state.split_total_bytes = 0
  app_state.split_last_activity = now_ms()
  let _ = shell_page_open_split(focus_pane)
  if app_state.split_port <= 0 {
    request_spawn_split(chosen_url, quiet, is_peek=false)
  } else {
    app_state.split_pending_url = if clean_url != "" { clean_url } else { "" }
    if !io_rt.split_conn.is_open() {
      io_rt.split_opened_toast_pending = !quiet
    }
    request_connect_split()
  }
  set_active_split_pane(focus_pane)
}

fn close_split_view(quiet~ : Bool = false) -> Unit {
  let was_open = is_split_open()
  cleanup_secondary_pane_ephemeral_state()
  match app_state.split_tab_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  io_rt.split_gen = io_rt.split_gen + 1
  io_rt.split_spawning = false
  disconnect_split_conn(reconnect=false)
  app_state.split_stage_view = None
  if app_state.split_pid > 0 {
    let pid = app_state.split_pid
    app_state.split_pid = -1
    app_state.split_port = 0
    request_kill_split_pid(pid)
  }
  app_state.split_pending_url = ""
  let _ = shell_page_close_split()
  sync_address_bar_from_active()
  // (no toast: the pane going is the answer)
  ignore(was_open)
  ignore(quiet)
}

fn toggle_split_view() -> Unit {
  if is_split_open() {
    close_split_view()
  } else {
    let (url, tid) = pick_default_split_target()
    open_split_view(url, tid, focus_pane=1)
  }
}

fn swap_split_panes() -> Unit {
  if !is_split_open() {
    toggle_split_view()
    return
  }
  shell_page_swap_panes()
}

fn expand_split_pane_in_main() -> Unit {
  let split_url = match app_state.split_stage {
    Some(st) => st.url()
    None => ""
  }
  close_split_view(quiet=true)
  if split_url != "" {
    get_stage().go(split_url)
  }
}

fn expand_split_pane(pane_id : Int) -> Unit {
  if pane_id == 0 {
    close_split_view(quiet=true)
  } else {
    expand_split_pane_in_main()
  }
}

fn close_split_pane(pane_id : Int) -> Unit {
  if pane_id == 0 {
    let split_url = match app_state.split_stage {
      Some(st) => st.url()
      None => ""
    }
    close_split_view(quiet=true)
    if split_url != "" {
      get_stage().go(split_url)
    }
  } else {
    close_split_view()
  }
}

fn is_peek_open() -> Bool {
  shell_adapter.page.untracked().layout is shell_ui::PageLayout::Peek
}

fn close_peek_preview(quiet~ : Bool = false) -> Unit {
  let was_open = is_peek_open()
  match app_state.peek_tab_id {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  match app_state.peek_url {
    Some(s) => if s.untracked() != "" { s.set("") }
    None => ()
  }
  if was_open && !is_split_open() {
    cleanup_secondary_pane_ephemeral_state()
    io_rt.split_gen = io_rt.split_gen + 1
    io_rt.split_spawning = false
    disconnect_split_conn(reconnect=false)
    app_state.split_stage_view = None
    if app_state.split_pid > 0 {
      let pid = app_state.split_pid
      app_state.split_pid = -1
      app_state.split_port = 0
      request_kill_split_pid(pid)
    }
    app_state.split_pending_url = ""
  }
  if was_open {
    io_rt.peek_open_sent = false
    send_wire(wire::Message::Act("peek_close", "", ""))
  }
  let _ = shell_page_close_peek()
  ignore(quiet)
}

fn open_peek_preview(target_url : String, tab_id : String, quiet~ : Bool = false) -> Unit {
  close_exclusive_overlays()
  let sp_st = ensure_split_stage()
  let clean_url = target_url.trim()
  let chosen_url = if clean_url != "" {
    clean_url
  } else {
    let (def_u, _) = pick_default_split_target()
    def_u
  }
  match app_state.peek_tab_id {
    Some(s) => s.set(tab_id)
    None => ()
  }
  match app_state.peek_url {
    Some(s) => s.set(chosen_url)
    None => ()
  }
  if is_split_open() || is_peek_open() {
    // Direct Split <-> Peek handoff: NEVER kill connection or PID; reuse live Secondary Stage!
    let _ = shell_page_open_peek()
    if chosen_url != "" && chosen_url != sp_st.url().trim() {
      if io_rt.split_conn.is_open() {
        sp_st.go(chosen_url)
      } else {
        app_state.split_pending_url = chosen_url
      }
    }
    io_rt.peek_open_sent = true
    send_wire(wire::Message::Act("peek_open", chosen_url, tab_id))
    return
  }
  app_state.split_total_bytes = 0
  app_state.split_last_activity = now_ms()
  let _ = shell_page_open_peek()
  if app_state.split_port <= 0 {
    request_spawn_split(chosen_url, quiet, is_peek=true)
  } else {
    app_state.split_pending_url = if clean_url != "" { clean_url } else { "" }
    if !io_rt.split_conn.is_open() {
      io_rt.split_opened_toast_pending = !quiet
    }
    request_connect_split()
  }
  io_rt.peek_open_sent = true
  send_wire(wire::Message::Act("peek_open", chosen_url, tab_id))
}

fn toggle_peek_preview() -> Unit {
  if is_peek_open() {
    close_peek_preview()
  } else {
    let (url, tid) = pick_default_split_target()
    open_peek_preview(url, tid)
  }
}

fn expand_peek_to_tab() -> Unit {
  let u = match app_state.split_stage {
    Some(st) if st.url() != "" => st.url()
    _ => match app_state.peek_url {
      Some(s) => s.untracked()
      None => ""
    }
  }
  let ttl = match app_state.split_stage {
    Some(st) => st.title()
    None => ""
  }
  close_peek_preview(quiet=true)
  if u != "" {
    dispatch_tab_new(u, ttl)
  }
}

fn promote_peek_to_split() -> Unit {
  if !is_peek_open() {
    return
  }
  let tid = match app_state.peek_tab_id {
    Some(s) => s.untracked()
    None => ""
  }
  // Set layout to Split FIRST so any subsequent cleanup never mistakes layout for Single!
  let _ = shell_page_promote_peek_to_split()
  match app_state.peek_tab_id {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.peek_url {
    Some(s) => s.set("")
    None => ()
  }
  match app_state.split_tab_id {
    Some(s) => s.set(tid)
    None => ()
  }
  io_rt.split_spawn_is_peek = false
  io_rt.peek_open_sent = false
  send_wire(wire::Message::Act("peek_close", "", ""))
  set_active_split_pane(1)
}

fn close_nav_hist() -> Unit {
  match app_state.nav_hist_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  shell_mark_exclusive_closed("nav_hist")
}

fn open_nav_hist(dir : Int, anchor_x : Double) -> Unit {
  let owner = active_split_pane()
  let count = nav_hist_entries_for(owner, dir).length()
  if count == 0 {
    return
  }
  close_exclusive_overlays()
  app_state.nav_hist_owner_pane = owner
  match app_state.nav_hist_dir {
    Some(s) => s.set(dir)
    None => ()
  }
  let clamped_x = if anchor_x < 12.0 { 12.0 } else if anchor_x > 960.0 { 960.0 } else { anchor_x }
  match app_state.nav_hist_x {
    Some(s) => s.set(clamped_x)
    None => ()
  }
  match app_state.nav_hist_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::Menu, "nav_hist")
}

fn dispatch_nav_jump(index : Int) -> Unit {
  let owner = app_state.nav_hist_owner_pane
  close_nav_hist()
  send_wire_to_pane(owner, wire::Message::Act("nav_jump", index.to_string(), ""))
}

fn dispatch_tab_move_space(tab_id : String, space_id : String, space_name : String) -> Unit {
  if space_id == "" {
    return
  }
  send_wire(wire::Message::Act("tab_move_space", tab_id, space_id))
  let lbl = if space_name.trim() != "" { space_name.trim() } else { space_id }
  show_toast("Moved to " + lbl, "pin")
}

fn set_host_find_result(synced : Bool, active : Int, total : Int) -> Unit {
  match app_state.host_find_synced {
    Some(s) => s.set(synced)
    None => ()
  }
  match app_state.host_find_active {
    Some(s) => s.set(active)
    None => ()
  }
  match app_state.host_find_total {
    Some(s) => s.set(total)
    None => ()
  }
}

fn refresh_omnibox_suggestions(q : String) -> Unit {
  app_state.omnibox_last_query = q
  // (the row the person moved to, kept by what it is: rows that come in meanwhile do not move it onto another)
  let picked : Option[proto::OmniSuggestItem] = match app_state.omnibox_selected {
    Some(sel_sig) => {
      let k = sel_sig.untracked()
      if app_state.omnibox_sel_touched && k >= 0 && k < app_state.omni_suggest_items.length() {
        Some(app_state.omni_suggest_items[k])
      } else {
        None
      }
    }
    None => None
  }
  let merged_hist : Array[proto::HistoryItemSummary] = []
  let seen : Map[String, Bool] = Map::new()
  let mut i = 0
  while i < app_state.history_snap.items.length() {
    let it = app_state.history_snap.items[i]
    let ck = proto::bookmark_canonical_url(it.url)
    if ck != "" && !seen.contains(ck) {
      seen.set(ck, true)
      merged_hist.push(it)
    }
    i = i + 1
  }
  let mut j = 0
  while j < app_state.omnibox_items.length() {
    let oi = app_state.omnibox_items[j]
    let ck = proto::bookmark_canonical_url(oi.url)
    if ck != "" && !seen.contains(ck) {
      seen.set(ck, true)
      merged_hist.push(proto::HistoryItemSummary::{
        url: oi.url,
        title: oi.title,
        host: proto::history_url_host(oi.url),
        visit_count: if oi.visits > 0 { oi.visits } else { 1 },
        last_visit_secs: 0L,
      })
    }
    j = j + 1
  }
  let ranked = proto::rank_omnibox_suggestions(
    q,
    app_state.workspace.tabs,
    app_state.bookmarks_snap.items,
    merged_hist,
    proto::OMNIBOX_SUGGESTION_MAX_ITEMS,
  )
  let rich_ranked = proto::rank_omni_suggest_items(
    q,
    app_state.workspace.tabs,
    app_state.bookmarks_snap.items,
    merged_hist,
    max_items=proto::OMNI_SUGGEST_MAX_ITEMS,
    engine=app_state.settings.search_engine,
  )
  // Arc's rule: the first row is what Enter does. A prefix hit stays on top; otherwise the Web Search / Direct
  // URL fallback leads (proto::omnibox_order_for_enter).
  // (the engine's suggestions for what is typed now, under its Web Search row: set_host_search_suggestions)
  let engine_rows = if app_state.settings.search_suggest && app_state.search_suggest_for == q.trim() {
    app_state.search_suggest_items
  } else {
    []
  }
  let rich_ranked = proto::omnibox_with_actions(
    q,
    proto::omnibox_with_search_suggestions(
      q,
      proto::omnibox_order_for_enter(q, rich_ranked),
      engine_rows,
      app_state.settings.search_engine,
    ),
    proto::command_bar_matching_actions(
      app_state.workspace,
      q,
      if app_state.stage.is_some() { active_address_raw_url_untracked() } else { "" },
      ui::keys_system() <= 0,
    ),
  )
  app_state.omnibox_suggestions = ranked
  app_state.omni_suggest_items = rich_ranked
  match app_state.omnibox_rev {
    Some(s) => s.set(s.untracked() + 1)
    None => ()
  }
  match app_state.omnibox_selected {
    Some(sel_sig) => {
      let clamped = proto::omnibox_clamp_selection(sel_sig.untracked(), rich_ranked.length())
      let kept = match picked {
        Some(row) => {
          let at = proto::omni_suggest_find_row(rich_ranked, row)
          if at >= 0 { at } else { clamped }
        }
        None => clamped
      }
      sel_sig.set(if app_state.omnibox_sel_touched { kept } else { omnibox_untouched_selection(q, rich_ranked.length()) })
    }
    None => ()
  }
}

///| The palette's selection before the person moves it: `proto::omni_suggest_untouched_selection` (the same rule
///| the demo controller's `OmniSuggestState::update` uses), in new-tab mode for Cmd+T.
fn omnibox_untouched_selection(q : String, count : Int) -> Int {
  proto::omni_suggest_untouched_selection(q, count, new_tab=app_state.omnibox_new_tab)
}

///| Every keystroke and every open starts from the default selection again.
fn omnibox_reset_selection() -> Unit {
  app_state.omnibox_sel_touched = false
  match app_state.omnibox_selected {
    Some(s) => s.set(-1)
    None => ()
  }
}

///| The pointer moved onto suggestion `idx`: select it without committing (one lit row, the one Enter runs).
fn hover_omnibox_selection(idx : Int) -> Unit {
  if idx < 0 || idx >= app_state.omni_suggest_items.length() {
    return
  }
  app_state.omnibox_sel_touched = true
  match app_state.omnibox_selected {
    Some(s) => if s.untracked() != idx { s.set(idx) }
    None => ()
  }
}

///| Cmd+T, the sidebar's New Tab row, the More menu's and the Command Bar's New Tab: the address palette opens
///| empty and focused (typing works at once). Enter opens what it names in a new tab (an open tab's row switches
///| to it); Escape creates nothing.
fn open_new_tab_palette() -> Unit {
  close_exclusive_overlays(keep_tag="omnibox")
  match app_state.address_field {
    Some(addr) => {
      app_state.syncing_address_url = true
      addr.set("")
      app_state.syncing_address_url = false
      match app_state.omnibox_editing {
        Some(ed) => ed.set(true)
        None => ()
      }
      addr.focus()
      app_state.omnibox_new_tab = true
      omnibox_reset_selection()
      dispatch_omnibox_query("")
    }
    // No address field (headless paths): a blank tab as before.
    None => dispatch_tab_new("", "")
  }
}

///| Goes to `target` from the palette: in a new tab when it was opened for one, else in `st`.
fn omnibox_go(st : stage::Stage, target : String, new_tab : Bool) -> Unit {
  if target == "" {
    return
  }
  if new_tab {
    dispatch_tab_new(target, "")
  } else {
    st.go(target)
  }
}

fn dispatch_omnibox_query(q : String) -> Unit {
  close_exclusive_overlays(keep_tag="omnibox")
  match app_state.host_omnibox_synced {
    Some(s) => s.set(false)
    None => ()
  }
  match app_state.omnibox_open {
    Some(s) => if !s.untracked() { s.set(true) }
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::OmniboxSuggest, "omnibox")
  refresh_omnibox_suggestions(q)
  ask_search_suggestions(q)
  match shell_omnibox_prepare_dispatch(q) {
    Some((to_send, req_id)) => if send_wire_checked(wire::Message::Act("omnibox", to_send, req_id)) {
      shell_omnibox_commit_sent(to_send, req_id)
    }
    None => ()
  }
}

///| Ask the host for the engine's suggestions for `q` (it keeps one request out and asks for the latest typed when
///| that is answered); with the setting off, or for what is not a search, nothing leaves the device.
///| Asked once typing rests for SEARCH_SUGGEST_REST_MS (the latest typed then), so a word typed fast is one request.
fn ask_search_suggestions(q : String) -> Unit {
  let t = q.trim()
  if !app_state.settings.search_suggest || !proto::search_suggest_allowed(t) {
    app_state.search_suggest_for = ""
    app_state.search_suggest_items = []
    search_suggest_due.v = ""
    return
  }
  search_suggest_due.v = t
  match app_state.root_view {
    Some(rv) => {
      let _ = rv.at_moment(rv.logic_at() + SEARCH_SUGGEST_REST_MS, later=true, fn() -> Unit { search_suggest_rested(t) })
    }
    None => ()
  }
}

let SEARCH_SUGGEST_REST_MS : Double = 120.0

///| What typing last asked suggestions for, waiting for typing to rest ("" none).
let search_suggest_due : signals::Ref[String] = signals::ref_new("")

///| Typing rested on `t`: asked of the host if it is still the latest typed and the palette is open.
fn search_suggest_rested(t : String) -> Unit {
  if search_suggest_due.v != t {
    return
  }
  search_suggest_due.v = ""
  let open = match app_state.omnibox_open {
    Some(s) => s.untracked()
    None => false
  }
  if open && app_state.omnibox_last_query.trim() == t {
    let _ = send_wire_checked(wire::Message::Act("search_suggest", t, ""))
  }
}

///| The host's suggestions for `q`: kept and shown only while `q` is still what the palette has typed.
fn set_host_search_suggestions(q : String, json : String) -> Unit {
  let typed = app_state.omnibox_last_query
  match proto::search_suggest_take(q, json, typed) {
    Some(xs) => {
      app_state.search_suggest_for = q.trim()
      app_state.search_suggest_items = xs
      let open = match app_state.omnibox_open {
        Some(s) => s.untracked()
        None => false
      }
      if open {
        refresh_omnibox_suggestions(typed)
      }
    }
    None => ()
  }
}

fn close_omnibox() -> Unit {
  shell_omnibox_gate_close()
  app_state.omnibox_new_tab = false
  app_state.omnibox_sel_touched = false
  match app_state.omnibox_open {
    Some(s) => s.set(false)
    None => ()
  }
  match app_state.omnibox_selected {
    Some(s) => s.set(-1)
    None => ()
  }
  shell_mark_exclusive_closed("omnibox")
}

fn set_host_omnibox_results(json : String) -> Unit {
  let (apply_items, items, is_broadcast, next_req) = shell_omnibox_gate_on_envelope(json)
  match next_req {
    Some((dq, rid)) => if send_wire_checked(wire::Message::Act("omnibox", dq, rid)) {
      shell_omnibox_commit_sent(dq, rid)
    }
    None => ()
  }
  if apply_items {
    app_state.omnibox_items = items
    if is_broadcast {
      if shell_sig_is_true(app_state.omnibox_open) {
        refresh_omnibox_suggestions(app_state.omnibox_last_query)
      }
    } else {
      refresh_omnibox_suggestions(app_state.omnibox_last_query)
      match app_state.host_omnibox_synced {
        Some(s) => s.set(true)
        None => ()
      }
    }
  }
}

fn step_omnibox_selection(delta : Int) -> Bool {
  let items = app_state.omni_suggest_items
  let is_open = match app_state.omnibox_open {
    Some(s) => s.untracked()
    None => false
  }
  if !is_open {
    match app_state.address_field {
      Some(addr) => {
        dispatch_omnibox_query(addr.text())
        return true
      }
      None => return false
    }
  }
  if items.length() == 0 {
    return true
  }
  match app_state.omnibox_selected {
    Some(sel_sig) => {
      let next = proto::omnibox_step_selection(sel_sig.untracked(), items.length(), delta)
      app_state.omnibox_sel_touched = true
      sel_sig.set(next)
    }
    None => ()
  }
  true
}

///| The person's pointer act in the sidebar the host is to answer (a tab closed by its X, a folder opened or closed,
///| a tab dropped): `kind` ("close", "folder", "move") and the tab or folder it is about, until WORKSPACE_TOLD_MS
///| from now. The snapshot that carries that very change is told as a transition within the sidebar's tab list
///| (shell_tab_list_transition), so its rows make their way; any other snapshot meanwhile (a title, audio, another
///| tab's broadcast) is applied at once and leaves the act waiting for its own answer.
fn workspace_next_told(kind : String, id : String) -> Unit {
  app_state.workspace_told = (kind, id, now_ms() + WORKSPACE_TOLD_MS)
}

let WORKSPACE_TOLD_MS : Double = 1500.0

///| Whether `now` carries the change of the act told (`kind` about `id`) over `was`: the tab gone, the folder's
///| open state turned, the tab in another folder or place.
fn workspace_answers(kind : String, id : String, was : proto::WorkspaceSnapshot, now : proto::WorkspaceSnapshot) -> Bool {
  let tab_at = fn(s : proto::WorkspaceSnapshot) -> (Int, String) {
    let mut i = 0
    while i < s.tabs.length() {
      if s.tabs[i].id == id {
        return (i, s.tabs[i].folder_id)
      }
      i += 1
    }
    (-1, "")
  }
  let folder_closed = fn(s : proto::WorkspaceSnapshot) -> Int {
    for f in s.folders {
      if f.id == id {
        return if f.collapsed { 1 } else { 0 }
      }
    }
    -1
  }
  if kind == "close" {
    let (a, _) = tab_at(was)
    let (b, _) = tab_at(now)
    a >= 0 && b < 0
  } else if kind == "folder" {
    let a = folder_closed(was)
    let b = folder_closed(now)
    a >= 0 && b >= 0 && a != b
  } else if kind == "move" {
    let (a, fa) = tab_at(was)
    let (b, fb) = tab_at(now)
    a >= 0 && b >= 0 && (a != b || fa != fb)
  } else {
    false
  }
}

fn set_host_workspace_state(json : String) -> Unit {
  let (kind, id, until) = app_state.workspace_told
  if until <= 0.0 || now_ms() > until {
    app_state.workspace_told = ("", "", 0.0)
    set_host_workspace_state_now(json)
    return
  }
  let answers = match proto::parse_workspace_snapshot(json) {
    Some(snap) => workspace_answers(kind, id, app_state.workspace, snap)
    None => false
  }
  if answers {
    app_state.workspace_told = ("", "", 0.0)
    shell_ui::shell_tab_list_transition(fn() { set_host_workspace_state_now(json) })
  } else {
    set_host_workspace_state_now(json)
  }
}

fn set_host_workspace_state_now(json : String) -> Unit {
  match proto::parse_workspace_snapshot(json) {
    Some(snap) => {
      ws_pending_drop_superseded(app_state.workspace_host, snap)
      app_state.workspace_host = snap
      app_state.workspace = ws_apply_pending(snap)
      match app_state.workspace_rev {
        Some(s) => s.set(s.untracked() + 1)
        None => ()
      }
      match app_state.host_workspace_synced {
        Some(s) => s.set(true)
        None => ()
      }
      let cb_open = match app_state.command_bar_open {
        Some(s) => s.untracked()
        None => false
      }
      if cb_open {
        let q = match app_state.command_bar_field {
          Some(f) => f.text()
          None => ""
        }
        refresh_command_bar_items(q)
      }
      let st_open = match app_state.space_theme_open {
        Some(s) => s.untracked()
        None => false
      }
      let sf_focused = match app_state.space_name_field {
        Some(f) => f.focused()
        None => false
      }
      if st_open && !sf_focused {
        sync_space_name_field_from_active()
      }
      let om_open = match app_state.omnibox_open {
        Some(s) => s.untracked()
        None => false
      }
      if om_open {
        refresh_omnibox_suggestions(app_state.omnibox_last_query)
      }
    }
    None => ()
  }
}

fn set_host_bookmarks_state(json : String) -> Unit {
  match proto::parse_bookmarks_snapshot(json, max_items=256) {
    Some(snap) => {
      app_state.bookmarks_snap = snap
      // (answers come in order: this one has the bookmark Cmd+D asked for, if it asked)
      bm_add_pending_url.v = ""
      match app_state.bookmarks_rev {
        Some(s) => s.set(s.untracked() + 1)
        None => ()
      }
      match app_state.host_bookmarks_synced {
        Some(s) => s.set(true)
        None => ()
      }
      let om_open = match app_state.omnibox_open {
        Some(s) => s.untracked()
        None => false
      }
      if om_open {
        refresh_omnibox_suggestions(app_state.omnibox_last_query)
      }
    }
    None => ()
  }
}

fn dispatch_bookmarks_sync() -> Unit {
  send_wire(wire::Message::Act("bookmarks_sync", "", ""))
}

///| The page the person just bookmarked (Cmd+D, the star), whose star settles in as the host's answer marks it so;
///| "" for none. A star lit because the tab or the page changed to one already bookmarked is at rest at once.
let bookmark_confirm_url : signals::Ref[String] = signals::ref_new("")

///| Whether the star lighting now is the person's bookmark of `url` (once: the mark is let go of as it is read).
fn bookmark_confirms(url : String) -> Bool {
  let hit = bookmark_confirm_url.v != "" && bookmark_confirm_url.v == url
  bookmark_confirm_url.v = ""
  hit
}

fn dispatch_bookmark_toggle() -> Unit {
  let st = active_stage()
  let url = st.url().trim()
  if url == "" {
    return
  }
  let was_saved = proto::bookmarks_contains_url(app_state.bookmarks_snap, url)
  let title = st.title().trim()
  // (the star confirms this one, as its bookmark comes back from the host: shell_pop_in's `confirms`)
  bookmark_confirm_url.v = if was_saved { "" } else { url }
  send_wire(wire::Message::Act("bookmark_toggle", url, title))
  if was_saved {
    show_toast("Removed bookmark", "bookmark")
  } else {
    show_toast("Bookmarked", "bookmark")
  }
}

///| A Start page tile's ×: the tile is kept off the Start page (`BrowserSettings::start_hidden`), a Favorite's bookmark
///| and a site's history both kept, with Undo on the toast: one press aimed at the tile loses nothing.
fn remove_start_page_tile(t : proto::StartPageTile) -> Unit {
  let key = proto::start_page_hide_key(t.url)
  if key == "" {
    return
  }
  let cur = app_state.settings
  let hidden = cur.start_hidden.copy()
  hidden.push(key)
  dispatch_settings_save(proto::BrowserSettings::{ ..cur, start_hidden: hidden })
  show_action_toast("Removed from the Start page", "start", "Undo", fn() { restore_start_page_tile(key) })
}

///| A Start page tile's Undo: shown again.
fn restore_start_page_tile(key : String) -> Unit {
  let cur = app_state.settings
  let kept : Array[String] = []
  for h in cur.start_hidden {
    if h != key {
      kept.push(h)
    }
  }
  if kept.length() != cur.start_hidden.length() {
    dispatch_settings_save(proto::BrowserSettings::{ ..cur, start_hidden: kept })
  }
}

fn dispatch_bookmark_delete(id_or_url : String) -> Unit {
  let target = id_or_url.trim()
  if target != "" {
    send_wire(wire::Message::Act("bookmark_delete", target, ""))
    show_toast("Removed bookmark", "bookmark")
  }
}

fn set_host_history_state(json : String) -> Unit {
  match proto::parse_history_snapshot(json, max_items=64) {
    Some(snap) => {
      app_state.history_snap = snap
      match app_state.history_rev {
        Some(s) => s.set(s.untracked() + 1)
        None => ()
      }
      match app_state.host_history_synced {
        Some(s) => s.set(true)
        None => ()
      }
      let om_open = match app_state.omnibox_open {
        Some(s) => s.untracked()
        None => false
      }
      if om_open {
        refresh_omnibox_suggestions(app_state.omnibox_last_query)
      }
    }
    None => ()
  }
}

fn dispatch_history_query(query : String) -> Unit {
  match app_state.host_history_synced {
    Some(s) => s.set(false)
    None => ()
  }
  send_wire(wire::Message::Act("history_query", query, ""))
}

fn dispatch_history_clear() -> Unit {
  send_wire(wire::Message::Act("history_clear", "all", ""))
  show_toast("Cleared history (All)", "clear")
}

fn dispatch_history_clear_range(range_key : String) -> Unit {
  let norm = proto::history_clear_range_normalize(range_key)
  let lbl = proto::history_clear_range_label(norm)
  send_wire(wire::Message::Act("history_clear", norm, ""))
  show_toast("Cleared history (" + lbl + ")", "clear")
}

fn dispatch_history_delete(url : String) -> Unit {
  if url != "" {
    send_wire(wire::Message::Act("history_delete", url, ""))
  }
}

fn dispatch_space_rename(space_id : String, new_name : String) -> Unit {
  let nm = new_name.trim()
  if nm != "" {
    send_wire(wire::Message::Act("space_rename", space_id, nm))
  }
}

fn dispatch_space_color(space_id : String, hex_color : String) -> Unit {
  if hex_color != "" {
    send_wire(wire::Message::Act("space_color", space_id, hex_color))
  }
}

fn dispatch_space_theme(space_id : String, theme : proto::SpaceTheme) -> Unit {
  if space_id != "" {
    send_wire(wire::Message::Act("space_theme", space_id, proto::encode_space_theme(theme)))
  }
}

fn dispatch_space_delete(space_id : String) -> Unit {
  if space_id != "" {
    send_wire(wire::Message::Act("space_delete", space_id, ""))
  }
}

fn any_command_bar_row_pressed() -> Bool {
  let mut i = 0
  while i < app_state.command_bar_row_views.length() {
    if app_state.command_bar_row_views[i].pressed() {
      return true
    }
    i = i + 1
  }
  false
}

fn refresh_command_bar_items(query : String) -> Unit {
  let cur_url = match app_state.stage {
    Some(_) => active_stage().url()
    None => ""
  }
  let is_macos = proto::keys_are_macos(ui::keys_system())
  let items = proto::build_command_bar_items(
    app_state.workspace,
    query,
    cur_url,
    is_macos,
    sidebar_shown=is_sidebar_open(),
    bookmarks_bar_shown=match app_state.bookmarks_bar_open {
      Some(sig) => sig.untracked()
      None => false
    },
  )
  app_state.command_bar_items = items
  match app_state.command_bar_rev {
    Some(s) => s.set(s.untracked() + 1)
    None => ()
  }
  match app_state.command_bar_selected {
    Some(sel_sig) => {
      if items.length() == 0 {
        sel_sig.set(-1)
      } else {
        let cur = sel_sig.untracked()
        if cur < 0 || cur >= items.length() {
          sel_sig.set(0)
        }
      }
    }
    None => ()
  }
}

fn close_command_bar() -> Unit {
  app_state.command_bar_row_views.clear()
  match app_state.command_bar_open {
    Some(s) => if s.untracked() { s.set(false) }
    None => ()
  }
  match app_state.command_bar_field {
    Some(f) => if f.focused() { f.let_go() }
    None => ()
  }
  match app_state.command_bar_selected {
    Some(s) => s.set(0)
    None => ()
  }
  shell_mark_exclusive_closed("command_bar")
}

fn open_command_bar(initial_query : String) -> Unit {
  close_exclusive_overlays()
  match app_state.address_field {
    Some(addr) => if addr.focused() { addr.let_go() }
    None => ()
  }
  match app_state.command_bar_field {
    Some(cf) => {
      cf.set(initial_query)
      cf.focus()
      cf.pick(initial_query.length(), initial_query.length())
    }
    None => ()
  }
  refresh_command_bar_items(initial_query)
  match app_state.command_bar_selected {
    Some(s) => s.set(if app_state.command_bar_items.length() > 0 { 0 } else { -1 })
    None => ()
  }
  match app_state.command_bar_open {
    Some(s) => s.set(true)
    None => ()
  }
  shell_mark_exclusive_open(shell_ui::ExclusiveKind::CommandBar, "command_bar")
  dispatch_workspace_sync()
}

fn toggle_command_bar() -> Unit {
  let is_open = match app_state.command_bar_open {
    Some(s) => s.untracked()
    None => false
  }
  if is_open {
    close_command_bar()
  } else {
    open_command_bar("")
  }
}

fn step_command_bar_selection(delta : Int) -> Bool {
  let items = app_state.command_bar_items
  if items.length() == 0 {
    return true
  }
  match app_state.command_bar_selected {
    Some(sel_sig) => {
      let next = proto::omnibox_step_selection(sel_sig.untracked(), items.length(), delta)
      sel_sig.set(next)
    }
    None => ()
  }
  true
}

fn find_tab_summary(tab_id : String) -> Option[proto::TabSummary] {
  let target = if tab_id != "" { tab_id } else { app_state.workspace.active_tab_id }
  let mut i = 0
  while i < app_state.workspace.tabs.length() {
    let t = app_state.workspace.tabs[i]
    if (target != "" && t.id == target) || (target == "" && t.active) {
      return Some(t)
    }
    i = i + 1
  }
  None
}

///| Pins a tab, or unpins a pinned tab or a favorite (the host's `tab_pin`). The row moves above Today (or back) on
///| the press's frame (`WsPending::Tier`); with the sidebar hidden, where no row is seen, a short toast says it.
fn dispatch_tab_pin(tab_id : String) -> Unit {
  match find_tab_summary(tab_id) {
    Some(t) => {
      let was_pinned = t.pinned || t.favorite
      ws_pending_show(WsPending::Tier(t.id, !was_pinned, false, ws_now()))
      if !is_sidebar_open() {
        show_toast(if was_pinned { "Tab unpinned" } else { "Tab pinned" }, "info")
      }
    }
    None => ()
  }
  send_wire(wire::Message::Act("tab_pin", tab_id, ""))
}

///| Adds a tab to Favorites, or takes a favorite out (the host's `tab_favorite`): the tile comes or goes on the
///| press's frame; with the sidebar hidden a short toast says it.
fn dispatch_tab_favorite(tab_id : String) -> Unit {
  match find_tab_summary(tab_id) {
    Some(t) => {
      let was_fav = t.favorite
      ws_pending_show(WsPending::Tier(t.id, false, !was_fav, ws_now()))
      if !is_sidebar_open() {
        show_toast(if was_fav { "Removed from Favorites" } else { "Added to Favorites" }, "info")
      }
    }
    None => ()
  }
  send_wire(wire::Message::Act("tab_favorite", tab_id, ""))
}

fn dispatch_tab_duplicate(tab_id : String) -> Unit {
  send_wire(wire::Message::Act("tab_duplicate", tab_id, ""))
  show_toast("Tab duplicated", "tab")
}

fn dispatch_folder_new(name : String) -> Unit {
  let clean = name.trim()
  let label = if clean != "" { clean } else { proto::next_auto_folder_name(app_state.workspace, app_state.workspace.active_space_id) }
  send_wire(wire::Message::Act("folder_new", label, app_state.workspace.active_space_id))
  show_toast("Folder \"" + label + "\" created", "folder")
}

fn dispatch_folder_toggle(folder_id : String) -> Unit {
  if folder_id != "" {
    for f in app_state.workspace.folders {
      if f.id == folder_id {
        ws_pending_show(WsPending::Folder(folder_id, !f.collapsed, ws_now()))
      }
    }
    send_wire(wire::Message::Act("folder_toggle", folder_id, ""))
  }
}

fn dispatch_folder_rename(folder_id : String, new_name : String) -> Unit {
  let clean = new_name.trim()
  if folder_id != "" && clean != "" {
    send_wire(wire::Message::Act("folder_rename", folder_id, clean))
    show_toast("Folder renamed to \"" + clean + "\"", "folder")
  }
}

fn dispatch_folder_delete(folder_id : String) -> Unit {
  if folder_id != "" {
    send_wire(wire::Message::Act("folder_delete", folder_id, ""))
    show_toast("Folder deleted, its tabs kept in Pinned", "folder")
  }
}

fn dispatch_tab_move_folder(tab_id : String, folder_id : String) -> Unit {
  send_wire(wire::Message::Act("tab_move_folder", tab_id, folder_id))
  if folder_id == "" {
    show_toast("Moved to Pinned", "folder")
  } else {
    let fname = proto::workspace_folder_name(app_state.workspace, folder_id)
    if fname != "" {
      show_toast("Moved to \"" + fname + "\"", "folder")
    } else {
      show_toast("Moved to Folder", "folder")
    }
  }
}

fn dispatch_media_mute_toggle() -> Unit {
  let was_muted = match app_state.workspace.media {
    Some(m) => m.muted
    None => false
  }
  // (no toast while the sidebar shows: the tab's speaker glyph and the mini player say it)
  if !is_sidebar_open() {
    show_toast(if was_muted { "Unmuted" } else { "Muted" }, "info")
  }
  send_wire(wire::Message::Act("media_mute_toggle", "", ""))
}

fn dispatch_media_play_toggle() -> Unit {
  send_wire(wire::Message::Act("media_play_toggle", "", ""))
}

fn dispatch_tab_reopen() -> Unit {
  send_wire(wire::Message::Act("tab_reopen", "", ""))
}

///| A new undo group for a bulk close: the host stamps the tabs it closes with it, and `tab_reopen` with it
///| reopens exactly those, wherever they sit in the closed stack (a close made since does not come back instead).
fn next_undo_group() -> String {
  app_state.undo_group_seq = app_state.undo_group_seq + 1
  "c" + app_state.undo_group_seq.to_string() + "-" + now_ms().to_string()
}

///| Reopens the tabs closed together under `group` (a bulk close's Undo).
fn dispatch_tab_reopen_group(group : String) -> Unit {
  send_wire(wire::Message::Act("tab_reopen", "", group))
}

fn dispatch_today_clear() -> Unit {
  let today_tabs = proto::workspace_tabs_for_space(
    app_state.workspace,
    app_state.workspace.active_space_id,
    false,
  )
  let mut cleared = 0
  let mut i = 0
  while i < today_tabs.length() {
    if !today_tabs[i].active && today_tabs[i].id != app_state.workspace.active_tab_id {
      cleared = cleared + 1
    }
    i = i + 1
  }
  let group = next_undo_group()
  send_wire(wire::Message::Act("today_clear", "", group))
  if cleared > 0 {
    // One Undo brings this batch back (the host keeps it as undo group `group`), and only this batch.
    show_action_toast(
      "Closed " + cleared.to_string() + " Today " + (if cleared == 1 { "tab" } else { "tabs" }),
      "clear",
      "Undo",
      fn() { dispatch_tab_reopen_group(group) },
    )
  }
}

fn dispatch_space_new(name : String) -> Unit {
  send_wire(wire::Message::Act("space_new", name, ""))
}

fn execute_command_bar_item(_st : stage::Stage, item : proto::CommandBarItem) -> Unit {
  let target_st = active_stage()
  close_command_bar()
  match item.kind {
    proto::CommandKind::SwitchTab => dispatch_tab_switch(item.id)
    proto::CommandKind::SwitchSpace => dispatch_space_switch(item.id)
    proto::CommandKind::NewSpace => start_create_space(name=item.id)
    proto::CommandKind::NavigateUrl | proto::CommandKind::SearchWeb => {
      if item.id != "" {
        target_st.go(item.id)
      }
    }
    proto::CommandKind::Action => {
      let _ = run_browser_action(item.id)
    }
  }
}

///| One of the browser's actions by its id (a Command Bar action's, a menu bar item's: `proto::mac_menu_bar`), on
///| the active tab; whether there is one by that id.
fn run_browser_action(id : String) -> Bool {
  // (the active tab, asked only by what acts on it)
  let target_st = fn() { active_stage() }
  if id == "find" {
    open_find_bar()
  } else if id == "zoom_in" {
    zoom_act(proto::zoom_step_up)
  } else if id == "zoom_out" {
    zoom_act(proto::zoom_step_down)
  } else if id == "zoom_reset" {
    zoom_act(fn(_z) { default_zoom() })
  } else if id == "close_tab" {
    dispatch_tab_close("")
  } else if id == "duplicate_tab" {
    dispatch_tab_duplicate("")
  } else if id == "close_other_tabs" {
    dispatch_tab_close_others("")
  } else if id == "back" {
    target_st().back()
  } else if id == "forward" {
    target_st().forward()
  } else if id == "clear_history" {
    // The range picker lives in History; nothing is wiped from here at once.
    open_history()
  } else if id == "pin_tab" {
    dispatch_tab_pin("")
  } else if id == "favorite_tab" {
    dispatch_tab_favorite("")
  } else if id == "global_media_controls" {
    open_media_hub()
  } else if id == "toggle_play_media" {
    dispatch_media_toggle_play("")
  } else if id == "toggle_mute_audio" {
    dispatch_media_mute_toggle()
  } else if id == "reopen_tab" {
    dispatch_tab_reopen()
  } else if id == "recently_closed_tabs" {
    open_closed_tabs_modal()
  } else if id == "new_tab" {
    open_new_tab_palette()
  } else if id == "new_start_page" {
    target_st().go("about:newtab")
  } else if id == "manage_spaces" {
    open_spaces_manager()
  } else if id == "new_space" {
    start_create_space()
  } else if id == "library" {
    open_library_mode()
  } else if id == "new_folder" {
    open_folder_create_bar()
  } else if id == "saved_sessions" {
    open_sessions_modal()
  } else if id == "today_clear" {
    dispatch_today_clear()
  } else if id == "toggle_sidebar" {
    toggle_sidebar()
  } else if id == "toggle_split_view" {
    toggle_split_view()
  } else if id == "toggle_peek" {
    toggle_peek_preview()
  } else if id == "open_current_in_peek" {
    open_peek_preview(target_st().url(), app_state.workspace.active_tab_id)
  } else if id == "swap_split_panes" {
    swap_split_panes()
  } else if id == "close_split_view" {
    close_split_view()
  } else if id == "site_info" {
    toggle_site_info()
  } else if id == "inspect_cookies" {
    open_cookies_modal()
  } else if id == "toggle_devtools" {
    toggle_devtools()
  } else if id == "toggle_perf_hud" {
    toggle_perf_hud()
  } else if id == "export_pdf" {
    open_print_pdf_modal()
  } else if id == "search_all_tabs" {
    open_tab_search()
  } else if id == "capture_screenshot" {
    dispatch_capture_screenshot()
  } else if id == "toggle_bookmark" {
    bookmark_page_act()
  } else if id == "toggle_bookmarks_bar" {
    toggle_bookmarks_bar()
  } else if id == "bookmarks" {
    open_bookmarks()
  } else if id == "toggle_reader_mode" {
    toggle_reader_mode()
  } else if id == "toggle_boosts" {
    toggle_boosts()
  } else if id == "downloads" {
    toggle_downloads()
  } else if id == "history" {
    open_history()
  } else if id == "space_theme" {
    open_space_theme()
  } else if id == "copy_url" {
    copy_url_with_toast(target_st().url())
  } else if id == "open_settings" {
    open_settings()
  } else if id == "toggle_dark_chrome" {
    toggle_dark_chrome()
  } else if id == "shortcuts" {
    open_shortcuts()
  } else if id == "reload" {
    target_st().reload()
  } else if id == "focus_url" {
    for f in focus_address_bar_hook {
      f()
    }
  } else if id == "find_next" {
    find_again(1)
  } else if id == "find_prev" {
    find_again(-1)
  } else if id == "tab_next" {
    dispatch_tab_step(1)
  } else if id == "tab_prev" {
    dispatch_tab_step(-1)
  } else if id == "command_bar" {
    toggle_command_bar()
  } else {
    return false
  }
  true
}

///| The page's fullscreen (`requestFullscreen`, a video's fullscreen button) as the window shows it: the window full
///| screen and the sidebar put away while it lasts, with a hint for Esc; both back as they were after.
struct PageFullscreen {
  mut on : Bool
  mut made_window_full : Bool
  mut sidebar_was_open : Bool
  ///| the tab whose page is fullscreen (leaving it ends the fullscreen: `page_fullscreen_leave`)
  mut tab_id : String
}

let page_fs : PageFullscreen = PageFullscreen::{ on: false, made_window_full: false, sidebar_was_open: false, tab_id: "" }

///| The person leaves the fullscreen page's tab (another tab, a tab closed, another Space): its page is told to leave
///| fullscreen first, and the window and sidebar come back now. Otherwise the page kept its `:fullscreen` element and,
///| come back to, filled the window again with no act of the person's.
fn page_fullscreen_leave() -> Unit {
  if !page_fs.on {
    return
  }
  match app_state.stage {
    Some(st) => st.exit_fullscreen()
    None => ()
  }
  sync_page_fullscreen(false)
}

///| Before each frame: the active tab is no longer the fullscreen page's (however it changed: the host's own switch
///| too, or a tab closed from elsewhere).
fn page_fullscreen_follow_tab() -> Unit {
  if page_fs.on && page_fs.tab_id != app_state.workspace.active_tab_id {
    page_fullscreen_leave()
  }
}

fn sync_page_fullscreen(on : Bool) -> Unit {
  if on == page_fs.on {
    return
  }
  page_fs.on = on
  if on {
    page_fs.tab_id = app_state.workspace.active_tab_id
    page_fs.sidebar_was_open = is_sidebar_open()
    if page_fs.sidebar_was_open {
      set_sidebar_open(false)
    }
    page_fs.made_window_full = !ui::full_screen_now()
    if page_fs.made_window_full {
      ui::set_full_screen(true)
    }
    show_toast("Press Esc to exit full screen", "fullscreen")
  } else {
    if page_fs.sidebar_was_open {
      set_sidebar_open(true)
    }
    if page_fs.made_window_full && ui::full_screen_now() {
      ui::set_full_screen(false)
    }
    page_fs.made_window_full = false
  }
  hostapi::request_frame()
}

///| The window left full screen (its green button, ⌃⌘F) while the page was fullscreen: the page's ends too.
fn on_window_full_screen(fs : Bool) -> Unit {
  if !fs && page_fs.on && page_fs.made_window_full {
    page_fs.made_window_full = false
    get_stage().exit_fullscreen()
  }
}

///| Esc while the page is fullscreen leaves it (and goes no further: not to the page, not to a layer).
fn escape_page_fullscreen() -> Bool {
  if page_fs.on {
    get_stage().exit_fullscreen()
    return true
  }
  false
}

///| What focuses the address bar with its address picked (⌘L's, the window's keymap: main's), for the menu bar.
let focus_address_bar_hook : Array[() -> Unit] = []

///| What the system says on its channel (`hostapi::system_channel`): a menu bar item chosen runs its action; a link
///| the app was opened with (the default browser's, a link clicked in another app, `open -a Farview <url>`) opens in a
///| new tab of the window, brought to the front.
fn on_system_said(json : String) -> Unit {
  for said in hostapi::system_said(json) {
    match said {
      hostapi::SystemSaid::Menu(id) => {
        let _ = run_browser_action(id)
        hostapi::request_frame()
      }
      hostapi::SystemSaid::Link(u) => open_link_from_system(u)
      _ => ()
    }
  }
}

///| Links from other apps that came before the host was connected (a cold start from a link: the Apple Event, or
///| the command line's, comes before the connection does): opened once it is (`open_links_waiting`).
let links_waiting : Array[String] = []

fn open_link_from_system(raw : String) -> Unit {
  let u = proto::system_link_target(raw)
  if u == "" {
    return
  }
  if !io_rt.main_conn.is_open() {
    links_waiting.push(u)
    return
  }
  // (the window is brought back by the host itself: invar's application:openURLs:)
  dispatch_tab_new(u, "")
  hostapi::request_frame()
}

///| The host connected: the links that waited for it, each in a new tab, in the order they came.
fn open_links_waiting() -> Unit {
  if links_waiting.length() == 0 || !io_rt.main_conn.is_open() {
    return
  }
  let us = links_waiting.copy()
  links_waiting.clear()
  for u in us {
    dispatch_tab_new(u, "")
  }
  hostapi::request_frame()
}

fn submit_command_bar(st : stage::Stage, raw : String) -> Unit {
  let items = app_state.command_bar_items
  let sel = match app_state.command_bar_selected {
    Some(s) => s.untracked()
    None => 0
  }
  if sel >= 0 && sel < items.length() {
    execute_command_bar_item(st, items[sel])
  } else if items.length() > 0 {
    execute_command_bar_item(st, items[0])
  } else {
    close_command_bar()
    let target = proto::omnibox_normalize_input_with_engine(
      raw,
      app_state.settings.search_engine,
      https_only=app_state.settings.https_only,
    )
    if target != "" {
      st.go(target)
    }
  }
}

fn dispatch_perm_set(kind : String, state : String) -> Unit {
  send_wire(wire::Message::Act("perm_set", kind, state))
}

fn toggle_sidebar() -> Unit {
  set_sidebar_open(!is_sidebar_open())
}

fn dispatch_workspace_sync() -> Unit {
  send_wire(wire::Message::Act("workspace_sync", "", ""))
}

fn dispatch_tab_new(url : String, title : String) -> Unit {
  send_wire(wire::Message::Act("tab_new", url, title))
}

///| A link opened in another Space (the page's context menu): the host opens a tab there and shows that Space (its
///| snapshot brings both).
fn dispatch_tab_new_in_space(url : String, space_id : String) -> Unit {
  send_wire(wire::Message::Act("tab_new_in_space", url, space_id))
}

///| The Spaces other than the shown one, as the page's context menu offers them (id, name).
fn page_ctx_other_spaces() -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  for sp in app_state.workspace.spaces {
    if sp.id != app_state.workspace.active_space_id {
      out.push((sp.id, sp.name))
    }
  }
  out
}

// --- Optimistic sidebar: a press answered on its own frame -------------------------------------------------
//
// Tab, Space and folder presses (and a tab dropped somewhere new) change what the sidebar shows at once, before the
// host (which may be far away) replies. Each is kept as a pending override, laid over every snapshot until the host
// agrees with it, or for WS_PENDING_MS at most, so a refused act (the host's Err) falls back to what the host says
// and an unrelated snapshot meanwhile does not undo the press.

///| A press the sidebar shows before the host says so.
enum WsPending {
  ///| tab id, when
  Tab(String, Double)
  ///| Space id, the tab the host will show in it (its rule: the Space's active tab, else its first), when
  Space(String, String, Double)
  ///| folder id, collapsed, when
  Folder(String, Bool, Double)
  ///| tab id, container (`proto::TAB_DROP_*`), the tab it lands before, when
  Move(String, String, String, Double)
  ///| tab id, pinned, favorite, when (pin / favorite toggled: the tab keeps its place in the order)
  Tier(String, Bool, Bool, Double)
}

///| How long a pending press may wait for the host before the host's word is taken again (ms).
let WS_PENDING_MS : Double = 1500.0

///| Added to the clock the pending presses age by (tests move it on; 0 otherwise).
let ws_clock_skew : signals::Ref[Double] = signals::ref_new(0.0)

fn ws_now() -> Double {
  now_ms() + ws_clock_skew.v
}

fn ws_pending_at(p : WsPending) -> Double {
  match p {
    Tab(_, at) => at
    Space(_, _, at) => at
    Folder(_, _, at) => at
    Move(_, _, _, at) => at
    Tier(_, _, _, at) => at
  }
}

fn ws_pending_same(a : WsPending, b : WsPending) -> Bool {
  match (a, b) {
    (Tab(_, _), Tab(_, _)) => true
    (Space(_, _, _), Space(_, _, _)) => true
    (Folder(x, _, _), Folder(y, _, _)) => x == y
    (Move(x, _, _, _), Move(y, _, _, _)) => x == y
    (Tier(x, _, _, _), Tier(y, _, _, _)) => x == y
    _ => false
  }
}

///| Whether `snap` (the host's) already says what `p` showed.
fn ws_pending_settled(snap : proto::WorkspaceSnapshot, p : WsPending) -> Bool {
  match p {
    Tab(id, _) => snap.active_tab_id == id
    Space(sid, _, _) => snap.active_space_id == sid
    Folder(fid, c, _) => {
      for f in snap.folders {
        if f.id == fid {
          return f.collapsed == c
        }
      }
      true
    }
    Move(id, c, before, _) => {
      let mut at = -1
      let mut before_at = -1
      let mut found = false
      let mut i = 0
      while i < snap.tabs.length() {
        let t = snap.tabs[i]
        if t.id == id {
          at = i
          found = proto::workspace_tab_container(t) == c
        }
        if before != "" && t.id == before {
          before_at = i
        }
        i += 1
      }
      at < 0 || (found && (before == "" || before_at < 0 || at < before_at))
    }
    Tier(id, pinned, favorite, _) => {
      for t in snap.tabs {
        if t.id == id {
          return t.pinned == pinned && t.favorite == favorite
        }
      }
      true
    }
  }
}

fn ws_with_active_tab(snap : proto::WorkspaceSnapshot, id : String) -> proto::WorkspaceSnapshot {
  let tabs : Array[proto::TabSummary] = []
  for t in snap.tabs {
    tabs.push(proto::TabSummary::{ ..t, active: t.id == id })
  }
  proto::WorkspaceSnapshot::{ ..snap, active_tab_id: id, tabs }
}

///| `snap` with what is still pending laid over it; what the host has settled, or what waited too long, is let go.
fn ws_apply_pending(snap : proto::WorkspaceSnapshot) -> proto::WorkspaceSnapshot {
  let now = ws_now()
  let keep : Array[WsPending] = []
  let mut out = snap
  for p in app_state.ws_pending {
    if now - ws_pending_at(p) > WS_PENDING_MS || ws_pending_settled(snap, p) {
      continue
    }
    keep.push(p)
    out = match p {
      Tab(id, _) => ws_with_active_tab(out, id)
      Space(sid, tab_id, _) => {
        let spaces : Array[proto::SpaceSummary] = []
        for sp in out.spaces {
          spaces.push(proto::SpaceSummary::{ ..sp, active: sp.id == sid })
        }
        let moved = proto::WorkspaceSnapshot::{ ..out, active_space_id: sid, spaces }
        if tab_id != "" { ws_with_active_tab(moved, tab_id) } else { moved }
      }
      Folder(fid, c, _) => {
        let folders : Array[proto::FolderSummary] = []
        for f in out.folders {
          folders.push(if f.id == fid { proto::FolderSummary::{ ..f, collapsed: c } } else { f })
        }
        proto::WorkspaceSnapshot::{ ..out, folders }
      }
      Move(id, c, before, _) => proto::workspace_tab_move(out, id, c, before)
      Tier(id, pinned, favorite, _) => {
        let tabs : Array[proto::TabSummary] = []
        for t in out.tabs {
          tabs.push(if t.id == id { proto::TabSummary::{ ..t, pinned, favorite } } else { t })
        }
        proto::WorkspaceSnapshot::{ ..out, tabs }
      }
    }
  }
  app_state.ws_pending = keep
  out
}

///| Lets go of a tab or Space press the host has since gone past: `snap` shows another tab (or Space) than the
///| one shown before it and than the press's (Cmd+T after the press, a page opening a tab), so the host's newer
///| choice is shown, not the press.
fn ws_pending_drop_superseded(prev : proto::WorkspaceSnapshot, snap : proto::WorkspaceSnapshot) -> Unit {
  if app_state.ws_pending.length() == 0 {
    return
  }
  let keep : Array[WsPending] = []
  for p in app_state.ws_pending {
    let gone = match p {
      Tab(id, _) => snap.active_tab_id != prev.active_tab_id && snap.active_tab_id != id
      Space(sid, _, _) => snap.active_space_id != prev.active_space_id && snap.active_space_id != sid
      _ => false
    }
    if !gone {
      keep.push(p)
    }
  }
  app_state.ws_pending = keep
}

///| Keeps `p` (in place of one of its kind) and shows it now, over the host's last snapshot; at `WS_PENDING_MS`
///| the sidebar is drawn again from the host's snapshot, so a refused press goes back even when the host sends
///| nothing more.
fn ws_pending_show(p : WsPending) -> Unit {
  if app_state.ws_pending.length() == 0 {
    // (nothing laid over it: what is shown is the host's)
    app_state.workspace_host = app_state.workspace
  }
  let next : Array[WsPending] = []
  for q in app_state.ws_pending {
    if !ws_pending_same(q, p) {
      next.push(q)
    }
  }
  next.push(p)
  app_state.ws_pending = next
  app_state.workspace = ws_apply_pending(app_state.workspace_host)
  match app_state.workspace_rev {
    Some(s) => s.set(s.untracked() + 1)
    None => ()
  }
  match app_state.root_view {
    Some(rv) => {
      let _ = rv.at_moment(rv.logic_at() + WS_PENDING_MS + 50.0, later=true, fn() -> Unit { ws_pending_expire() })
    }
    None => ()
  }
}

///| Draws the sidebar again from the host's last snapshot once a pending press has waited too long.
fn ws_pending_expire() -> Unit {
  let had = app_state.ws_pending.length()
  if had == 0 {
    return
  }
  app_state.workspace = ws_apply_pending(app_state.workspace_host)
  if app_state.ws_pending.length() != had {
    match app_state.workspace_rev {
      Some(s) => s.set(s.untracked() + 1)
      None => ()
    }
  }
}

///| The tab the host shows when `space_id` is switched to: the Space's active tab, else its first.
fn ws_space_landing_tab(snap : proto::WorkspaceSnapshot, space_id : String) -> String {
  let mut first = ""
  for t in snap.tabs {
    if t.space_id == space_id {
      if t.state == "active" {
        return t.id
      }
      if first == "" {
        first = t.id
      }
    }
  }
  first
}

fn dispatch_tab_switch(tab_id : String) -> Unit {
  if tab_id != "" {
    shell_end_page_ime_composition()
    if tab_id != page_fs.tab_id {
      page_fullscreen_leave()
    }
    ws_pending_show(WsPending::Tab(tab_id, ws_now()))
    send_wire(wire::Message::Act("tab_switch", tab_id, ""))
  }
}

///| Closes a tab. No toast: the row going is the answer, and Cmd+Shift+T brings it back (as in Arc).
fn dispatch_tab_close(tab_id : String) -> Unit {
  if tab_id == page_fs.tab_id {
    page_fullscreen_leave()
  }
  send_wire(wire::Message::Act("tab_close", tab_id, ""))
}

fn dispatch_space_switch(space_id : String) -> Unit {
  if space_id != "" {
    if space_id != app_state.workspace.active_space_id {
      page_fullscreen_leave()
    }
    ws_pending_show(WsPending::Space(space_id, ws_space_landing_tab(app_state.workspace, space_id), ws_now()))
    send_wire(wire::Message::Act("space_switch", space_id, ""))
  }
}

///| A tab dragged in the sidebar: shown where it lands at once, then told to the host (`tab_move`).
fn dispatch_tab_move(tab_id : String, target : String, before_id : String) -> Unit {
  if tab_id == "" || target == "" {
    return
  }
  ws_pending_show(WsPending::Move(tab_id, target, before_id, ws_now()))
  send_wire(wire::Message::Act("tab_move", tab_id, target + "|" + before_id))
}

///| Cmd/Ctrl+1...9: the n-th tab in the order the sidebar draws (Favorites, folders, Pinned, Today); 9 is the last.
fn dispatch_switch_tab_index(idx : Int) -> Unit {
  match proto::workspace_tab_for_index(app_state.workspace, app_state.workspace.active_space_id, idx, filter_q=tab_filter_query_now()) {
    Some(t) => dispatch_tab_switch(t.id)
    None => ()
  }
}

///| The next (+1) or previous (-1) tab in the sidebar's order, wrapping.
fn dispatch_tab_step(step : Int) -> Unit {
  let ws = app_state.workspace
  match proto::workspace_tab_step(ws, ws.active_space_id, ws.active_tab_id, step) {
    Some(t) => dispatch_tab_switch(t.id)
    None => ()
  }
}

///| The `idx`-th Space (Ctrl+1...9), or the one `step` away from the active one (wrapping).
fn dispatch_space_index(idx : Int) -> Unit {
  let sps = app_state.workspace.spaces
  if idx >= 0 && idx < sps.length() {
    dispatch_space_switch(sps[idx].id)
  }
}

fn dispatch_space_step(step : Int) -> Unit {
  let sps = app_state.workspace.spaces
  let n = sps.length()
  if n == 0 {
    return
  }
  let mut at = 0
  let mut i = 0
  while i < n {
    if sps[i].id == app_state.workspace.active_space_id {
      at = i
    }
    i += 1
  }
  dispatch_space_switch(sps[((at + step) % n + n) % n].id)
}

fn find_open_tab_id_for_url(u : String) -> Option[String] {
  let target = u.trim()
  if target == "" {
    return None
  }
  let tabs = app_state.workspace.tabs
  let mut i = 0
  while i < tabs.length() {
    if tabs[i].url == target {
      return Some(tabs[i].id)
    }
    i = i + 1
  }
  None
}

fn execute_omnibox_suggestion(st : stage::Stage, sug : proto::OmniboxSuggestion) -> Unit {
  if sug.kind is proto::OmniboxSuggestionKind::InstantAnswer {
    let copy_v = sug.url.trim()
    close_omnibox()
    match app_state.address_field {
      Some(addr) => addr.let_go()
      None => ()
    }
    if copy_v != "" {
      write_os_clipboard(copy_v)
      show_toast("Copied " + copy_v, "copy")
    }
    return
  }
  let target = sug.url.trim()
  let is_switch = sug.kind is proto::OmniboxSuggestionKind::SwitchTab
  let tab_id = sug.tab_id
  close_omnibox()
  match app_state.address_field {
    Some(addr) => {
      if target != "" {
        app_state.syncing_address_url = true
        addr.set(target)
        app_state.syncing_address_url = false
      }
      addr.let_go()
    }
    None => ()
  }
  if is_switch {
    if tab_id != "" {
      dispatch_tab_switch(tab_id)
      return
    }
    match find_open_tab_id_for_url(target) {
      Some(tid) => {
        dispatch_tab_switch(tid)
        return
      }
      None => ()
    }
  }
  if target != "" {
    st.go(target)
  }
}

fn navigate_omnibox(st : stage::Stage, raw_input : String, explicit_url : Option[String]) -> Unit {
  let suggestions = app_state.omni_suggest_items
  let new_tab = app_state.omnibox_new_tab
  let sel = match app_state.omnibox_selected {
    Some(s) => s.untracked()
    None => -1
  }
  match explicit_url {
    Some(u) if u.trim() != "" => {
      let target = u.trim()
      let mut i = 0
      while i < suggestions.length() {
        if suggestions[i].url == target {
          execute_omni_suggest_item(st, suggestions[i])
          return
        }
        i = i + 1
      }
      close_omnibox()
      match app_state.address_field {
        Some(addr) => {
          app_state.syncing_address_url = true
          addr.set(target)
          app_state.syncing_address_url = false
          addr.let_go()
        }
        None => ()
      }
      omnibox_go(st, target, new_tab)
      return
    }
    _ => ()
  }
  // The Web Search / Direct URL row goes by the typed text below (it honours the search engine setting).
  let sel_is_fallback = sel >= 0 && sel < suggestions.length() &&
  (suggestions[sel].category is proto::OmniSuggestCategory::Search ||
    suggestions[sel].category is proto::OmniSuggestCategory::DirectUrl)
  if sel >= 0 && sel < suggestions.length() && !sel_is_fallback {
    execute_omni_suggest_item(st, suggestions[sel])
    return
  }
  if suggestions.length() > 0 && (suggestions[0].category is proto::OmniSuggestCategory::Calc) {
    execute_omni_suggest_item(st, suggestions[0])
    return
  }
  match proto::eval_omnibox_calc(raw_input) {
    Some(calc) => {
      close_omnibox()
      match app_state.address_field {
        Some(addr) => addr.let_go()
        None => ()
      }
      write_os_clipboard(calc.value)
      show_toast("Copied " + calc.value, "copy")
      return
    }
    None => ()
  }
  let target = {
    let resolved = proto::omnibox_normalize_input_with_engine(
      raw_input,
      app_state.settings.search_engine,
      https_only=app_state.settings.https_only,
    )
    if resolved != "" { resolved } else { stage::normalize_address(raw_input) }
  }
  close_omnibox()
  match app_state.address_field {
    Some(addr) => {
      if target != "" {
        app_state.syncing_address_url = true
        addr.set(target)
        app_state.syncing_address_url = false
      }
      addr.let_go()
    }
    None => ()
  }
  omnibox_go(st, target, new_tab)
}

fn format_space_label(raw : String) -> String {
  let s = raw.trim()
  if s == "" {
    return "Default"
  }
  let b = s.to_bytes()
  let c0 = b[0].to_int() & 0xFF
  if c0 >= 97 && c0 <= 122 {
    let out = Bytes::new(b.length())
    out[0] = (c0 - 32).to_byte()
    let mut i = 1
    while i < b.length() {
      out[i] = b[i]
      i = i + 1
    }
    out.to_string()
  } else {
    s
  }
}

fn current_base_wh() -> String {
  let sv_opt = if is_split_open() && active_split_pane() == 1 {
    app_state.split_stage_view
  } else {
    app_state.stage_view
  }
  match sv_opt {
    Some(sv) => {
      let (bw, bh) = sv.laid_size()
      if bw >= 50.0 && bh >= 50.0 {
        proto::format_base_wh(bw, bh)
      } else {
        ""
      }
    }
    None => ""
  }
}

fn apply_zoom_and_sync(st : stage::Stage, target : Double) -> Unit {
  let z = proto::clamp_zoom(target)
  st.set_zoom(z)
  send_wire_active(wire::Message::Act("zoom", proto::format_zoom_str(z), current_base_wh()))
}

fn is_find_case_sensitive() -> Bool {
  match app_state.find_case_sensitive {
    Some(s) => s.untracked()
    None => false
  }
}

fn toggle_find_case_sensitive(st : stage::Stage) -> Unit {
  match app_state.find_case_sensitive {
    Some(s) => s.set(!s.untracked())
    None => ()
  }
  let q = match app_state.find_field {
    Some(ff) => ff.text()
    None => app_state.last_find_query
  }
  if q != "" {
    dispatch_find_query(st, q)
  }
}

fn dispatch_find_query(st : stage::Stage, q : String) -> Unit {
  app_state.last_find_query = q
  let owner = shell_adapter.find_owner_pane
  if q == "" {
    st.find_clear()
    set_host_find_result(false, -1, 0)
    send_wire_to_pane(owner, wire::Message::Act("find_clear", "", ""))
  } else {
    set_host_find_result(false, -1, 0)
    st.find(q)
    let flags = proto::find_flags_for(is_find_case_sensitive(), false)
    send_wire_to_pane(owner, wire::Message::Act("find", q, flags))
  }
}

fn dispatch_find_next(st : stage::Stage) -> Unit {
  st.find_step(1)
  send_wire_to_pane(shell_adapter.find_owner_pane, wire::Message::Act("find_next", "", ""))
}

fn dispatch_find_prev(st : stage::Stage) -> Unit {
  st.find_step(-1)
  send_wire_to_pane(shell_adapter.find_owner_pane, wire::Message::Act("find_prev", "", ""))
}

fn dispatch_find_clear(st : stage::Stage) -> Unit {
  app_state.last_find_query = ""
  st.find_clear()
  set_host_find_result(false, -1, 0)
  send_wire_to_pane(shell_adapter.find_owner_pane, wire::Message::Act("find_clear", "", ""))
}

fn open_find_bar() -> Unit {
  let next_owner = if active_targets_split() { 1 } else { 0 }
  if is_find_bar_open() && shell_adapter.find_owner_pane != next_owner {
    let prev_owner = shell_adapter.find_owner_pane
    pane_stage(prev_owner).find_clear()
    set_host_find_result(false, -1, 0)
    send_wire_to_pane(prev_owner, wire::Message::Act("find_clear", "", ""))
  }
  set_find_owner_pane(next_owner)
  match app_state.find_open {
    Some(s) => s.set(true)
    None => ()
  }
  match app_state.find_field {
    Some(ff) => {
      ff.focus()
      ff.pick(0, ff.text().length())
    }
    None => ()
  }
  shell_sync_dock_from_app()
}

fn close_find_bar(st : stage::Stage) -> Unit {
  match app_state.find_open {
    Some(s) => s.set(false)
    None => ()
  }
  match app_state.find_field {
    Some(ff) => ff.let_go()
    None => ()
  }
  shell_sync_dock_from_app()
  dispatch_find_clear(st)
}

///| Find next (`dir` 1) or previous (-1) from anywhere (Cmd/Ctrl+G, Cmd/Ctrl+Shift+G, F3): with the bar open it
///| steps without moving the keyboard; with it closed it opens it again on the last query (the first match is the
///| next one; previous goes to the last). With no query yet it opens the bar, like Cmd/Ctrl+F.
fn find_again(dir : Int) -> Unit {
  if is_find_bar_open() {
    if dir < 0 { dispatch_find_prev(active_find_stage()) } else { dispatch_find_next(active_find_stage()) }
    return
  }
  let q = match app_state.find_field {
    Some(ff) => ff.text()
    None => app_state.last_find_query
  }
  open_find_bar()
  if q != "" {
    let st = active_find_stage()
    dispatch_find_query(st, q)
    if dir < 0 {
      dispatch_find_prev(st)
    }
  }
}

///| Whether a page (not the browser's own fields) has the text caret: a page form field or an editable region in
///| the pane that has the keyboard (`shell_page_focus_owner_pane`: the primary or the secondary Stage, Split View
///| or Peek, with tree focus inside that Stage's view). Focus on the sidebar, a menu, a chrome field or behind an
///| exclusive overlay is no page's, whatever caret a Stage last reported.
fn is_page_editing_focused() -> Bool {
  if app_state.stage.is_none() {
    return false
  }
  let pane = shell_page_focus_owner_pane()
  pane >= 0 && pane_stage(pane).editing_text()
}

fn is_find_bar_open() -> Bool {
  match app_state.find_open {
    Some(s) => s.untracked()
    None => false
  }
}

fn is_find_field_focused() -> Bool {
  match (ui::focused_field_now(), app_state.find_field) {
    (Some(f), Some(ff)) => f.phys_id == ff.phys_id && ff.focused()
    _ => false
  }
}

fn is_chrome_field_focused() -> Bool {
  match ui::focused_field_now() {
    Some(f) => {
      let pid = f.phys_id
      let is_addr = match app_state.address_field {
        Some(a) => a.phys_id == pid && a.focused()
        None => false
      }
      let is_find = match app_state.find_field {
        Some(ff) => ff.phys_id == pid && ff.focused()
        None => false
      }
      let is_cmd = match app_state.command_bar_field {
        Some(cf) => cf.phys_id == pid && cf.focused()
        None => false
      }
      let is_hist = match app_state.history_field {
        Some(hf) => hf.phys_id == pid && hf.focused()
        None => false
      }
      let is_bm = match app_state.bookmarks_field {
        Some(bf) => bf.phys_id == pid && bf.focused()
        None => false
      }
      let is_sp = match app_state.space_name_field {
        Some(sf) => sf.phys_id == pid && sf.focused()
        None => false
      }
      let is_fl = match app_state.folder_name_field {
        Some(ff) => ff.phys_id == pid && ff.focused()
        None => false
      }
      let is_tf = match app_state.tab_filter_field {
        Some(tf) => tf.phys_id == pid && tf.focused()
        None => false
      }
      let is_dt = match app_state.devtools_repl_field {
        Some(df) => df.phys_id == pid && df.focused()
        None => false
      }
      let is_dt_net = match app_state.devtools_net_search_field {
        Some(dnf) => dnf.phys_id == pid && dnf.focused()
        None => false
      }
      let is_boost = match app_state.boosts_css_field {
        Some(bf2) => bf2.phys_id == pid && bf2.focused()
        None => false
      }
      let is_start = match app_state.start_page_field {
        Some(spf) => spf.phys_id == pid && spf.focused()
        None => false
      }
      let is_cookies = match app_state.cookies_field {
        Some(ckf) => ckf.phys_id == pid && ckf.focused()
        None => false
      }
      let is_dl = match app_state.downloads_field {
        Some(dlf) => dlf.phys_id == pid && dlf.focused()
        None => false
      }
      let is_sp_new = match app_state.spaces_new_field {
        Some(snf) => snf.phys_id == pid && snf.focused()
        None => false
      }
      let is_sp_ren = match app_state.spaces_rename_field {
        Some(srf) => srf.phys_id == pid && srf.focused()
        None => false
      }
      let is_ct = match app_state.closed_tabs_field {
        Some(ctf) => ctf.phys_id == pid && ctf.focused()
        None => false
      }
      let is_fc = match app_state.folder_create_field {
        Some(fcf) => fcf.phys_id == pid && fcf.focused()
        None => false
      }
      let is_sn = match app_state.sessions_name_field {
        Some(snf2) => snf2.phys_id == pid && snf2.focused()
        None => false
      }
      let is_sf = match app_state.sessions_filter_field {
        Some(sff) => sff.phys_id == pid && sff.focused()
        None => false
      }
      let is_ts = match app_state.tab_search_field {
        Some(tsf) => tsf.phys_id == pid && tsf.focused()
        None => false
      }
      is_addr || is_find || is_cmd || is_hist || is_bm || is_sp || is_fl || is_tf || is_dt || is_dt_net || is_boost || is_start || is_cookies || is_dl || is_sp_new || is_sp_ren || is_ct || is_fc || is_sn || is_sf || is_ts
    }
    None => false
  }
}

fn primary_mod_active(mods : Int) -> Bool {
  if proto::keys_are_macos(ui::keys_system()) {
    (mods & ui::mod_cmd) != 0
  } else {
    (mods & ui::mod_ctrl) != 0
  }
}

fn dom_primary_mod() -> Int {
  if proto::keys_are_macos(ui::keys_system()) { 4 } else { 2 }
}

fn handle_ime_text(kind : Int, s : String, a : Int, b : Int) -> Bool {
  shell_handle_ime_text(kind, s, a, b)
}

fn sync_shift_held_from_mods(mods : Int) -> Unit {
  let sh_now = (mods & 1) != 0
  match app_state.shift_held {
    Some(sh) => if sh.untracked() != sh_now {
      sh.set(sh_now)
      hostapi::request_frame()
    }
    None => ()
  }
}

///| Whether a modifier-only change from `prev` to `mods` is a person letting Ctrl go: Ctrl was held, and Ctrl is
///| the only modifier that went away (each real key release changes one modifier). The hosts' focus-loss notice
///| drops every modifier at once (Linux `on_focus_out` and macOS resign-key both send mods 0), so a Cmd/Alt+Tab
///| away (Ctrl and Cmd or Alt held, then all gone) reads as leaving, not as letting Ctrl go.
fn mru_is_ctrl_release(prev : Int, mods : Int) -> Bool {
  let ctrl = ui::mod_ctrl
  (prev & ctrl) != 0 && (mods & ctrl) == 0 && mods == prev - ctrl
}

///| The app in front or not (`hostapi::set_app_state`: bit 2 while a window of the run is the key window). Leaving
///| the window cancels a `Ctrl+Tab` switcher, never commits it.
fn on_app_front_state(st : Int) -> Unit {
  let front = (st & 2) != 0
  let was_front = app_state.window_front
  app_state.window_front = front
  if front && !was_front {
    // (a notification tapped brings the app to the front with what it opens)
    let opens = hostapi::notice_opened()
    if opens != "" {
      dl_notice_opened(opens)
      hostapi::request_frame()
    }
  }
  if !front && shell_sig_is_true(app_state.mru_open) && app_state.mru_ctrl_armed {
    close_mru_switcher()
    hostapi::request_frame()
  }
}

///| A modifier-only change (`code == 0`) while a `Ctrl+Tab` switcher is armed: letting Ctrl go commits it, as in
///| Arc; the window losing focus (out of front, or every held modifier dropped at once) cancels it.
fn handle_mru_modifier_change(mods : Int) -> Bool {
  let prev = app_state.mru_mods
  app_state.mru_mods = mods
  if (mods & ui::mod_ctrl) != 0 {
    return false
  }
  if app_state.window_front && mru_is_ctrl_release(prev, mods) {
    commit_mru_switcher()
  } else {
    close_mru_switcher()
  }
  true
}

fn handle_app_key(code : Int, mods : Int, is_up : Bool) -> Bool {
  sync_shift_held_from_mods(mods)
  if code == 0 && !is_up && app_state.mru_ctrl_armed && shell_sig_is_true(app_state.mru_open) {
    return handle_mru_modifier_change(mods)
  }
  if code == 0 || is_up {
    return false
  }
  if code == proto::KEY_ESCAPE && mods == 0 && escape_page_fullscreen() {
    return true
  }
  // A tab held in a sidebar drag: Escape puts it back first, before it closes a Peek, Reader, the find bar or a
  // panel, or reaches the page (a second Escape does those).
  if code == proto::KEY_ESCAPE && shell_ui::shell_tab_drag_cancel() {
    return true
  }
  // Layer 0: Active IME composition guard (never swallow Escape/Enter/Arrows/Tab/Backspace while composing;
  // Cmd/Ctrl global shortcuts always pass through to Layer 2)
  if is_ime_composing_active() && is_ime_guarded_key(code, mods) {
    return false
  }
  // Layer 1: Deepest active Exclusive control (MRU/TabSearch/CommandBar/Omnibox) & deterministic Escape chain
  if handle_layer1_exclusive_key(code, mods) {
    return true
  }
  // Layer 1b: Create a Space takes the window: only typing, Escape, Return and the window's keys reach it.
  if sidebar_modes.mode.untracked() is shell_ui::SidebarMode::CreateSpace {
    return create_space_blocks_key(code, mods, proto::keys_are_macos(ui::keys_system()))
  }
  // Layer 2: Global browser shortcuts (Column A invariants preserved 100%)
  let find_open = is_find_bar_open()
  let find_focused = is_find_field_focused()
  let field_focused = ui::field_has_focus() || is_chrome_field_focused()
  let shortcut = proto::dispatch_browser_shortcut(
    code,
    mods,
    proto::keys_are_macos(ui::keys_system()),
    find_open,
    find_focused,
    field_focused,
    page_editing=is_page_editing_focused(),
  )
  match shortcut {
    // Enter in the find field is the field's own (its submit steps); Cmd/Ctrl+G, F3 and Shift+Enter step here.
    proto::BrowserShortcut::FindNext if code != proto::KEY_ENTER => {
      find_again(1)
      return true
    }
    proto::BrowserShortcut::FindPrev => {
      find_again(-1)
      return true
    }
    proto::BrowserShortcut::Reload if proto::is_f5_key(code) => {
      active_stage().reload()
      return true
    }
    proto::BrowserShortcut::Back if (mods & ui::mod_alt) != 0 => {
      active_stage().back()
      return true
    }
    proto::BrowserShortcut::Forward if (mods & ui::mod_alt) != 0 => {
      active_stage().forward()
      return true
    }
    proto::BrowserShortcut::ZoomIn if (mods & ui::mod_shift_key) != 0 => {
      zoom_act(proto::zoom_step_up)
      return true
    }
    proto::BrowserShortcut::ToggleSidebar => {
      toggle_sidebar()
      return true
    }
    proto::BrowserShortcut::TabNew => {
      open_new_tab_palette()
      return true
    }
    proto::BrowserShortcut::TabClose => {
      dispatch_close_frontmost()
      return true
    }
    proto::BrowserShortcut::ToggleFavoriteTab => {
      dispatch_tab_favorite("")
      return true
    }
    proto::BrowserShortcut::SpaceSwitch(idx) => {
      dispatch_space_index(idx)
      return true
    }
    proto::BrowserShortcut::SpaceStep(step) => {
      dispatch_space_step(step)
      return true
    }
    proto::BrowserShortcut::TabStep(step) => {
      dispatch_tab_step(step)
      return true
    }
    proto::BrowserShortcut::TabSwitch(idx) => {
      dispatch_switch_tab_index(idx)
      return true
    }
    proto::BrowserShortcut::ToggleSiteInfo => {
      toggle_site_info()
      return true
    }
    proto::BrowserShortcut::ToggleDownloads => {
      toggle_downloads()
      return true
    }
    proto::BrowserShortcut::OpenCommandBar => {
      toggle_command_bar()
      return true
    }
    proto::BrowserShortcut::TogglePinTab => {
      dispatch_tab_pin("")
      return true
    }
    proto::BrowserShortcut::ReopenClosedTab => {
      dispatch_tab_reopen()
      return true
    }
    proto::BrowserShortcut::ToggleMuteAudio => {
      dispatch_media_mute_toggle()
      return true
    }
    proto::BrowserShortcut::ToggleHistory => {
      toggle_history()
      return true
    }
    proto::BrowserShortcut::CopyCurrentUrl => {
      let target_u = if is_peek_open() { peek_current_url() } else { active_stage().url() }
      copy_url_with_toast(target_u)
      return true
    }
    proto::BrowserShortcut::ToggleShortcuts => {
      toggle_shortcuts()
      return true
    }
    proto::BrowserShortcut::ToggleSplitView => {
      toggle_split_view()
      return true
    }
    proto::BrowserShortcut::TogglePeek => {
      toggle_peek_preview()
      return true
    }
    proto::BrowserShortcut::ExpandPeek => {
      if is_peek_open() {
        expand_peek_to_tab()
        return true
      }
    }
    proto::BrowserShortcut::TabSwitchMru(delta) => {
      open_or_step_mru_switcher(delta, held=(mods & ui::mod_ctrl) != 0)
      if (mods & ui::mod_ctrl) != 0 && shell_sig_is_true(app_state.mru_open) {
        app_state.mru_ctrl_armed = true
        app_state.mru_mods = mods
      }
      return true
    }
    proto::BrowserShortcut::PrintPdf => {
      open_print_pdf_modal()
      return true
    }
    proto::BrowserShortcut::ToggleTabFilter => {
      toggle_tab_search()
      return true
    }
    proto::BrowserShortcut::ToggleDevTools => {
      toggle_devtools()
      return true
    }
    proto::BrowserShortcut::ToggleBookmark => {
      bookmark_page_act()
      return true
    }
    proto::BrowserShortcut::ToggleBookmarksBar => {
      toggle_bookmarks_bar()
      return true
    }
    proto::BrowserShortcut::ToggleBookmarksDrawer => {
      toggle_bookmarks()
      return true
    }
    proto::BrowserShortcut::CaptureScreenshot => {
      dispatch_capture_screenshot()
      return true
    }
    proto::BrowserShortcut::ToggleReaderMode => {
      toggle_reader_mode()
      return true
    }
    proto::BrowserShortcut::ToggleBoosts => {
      toggle_boosts()
      return true
    }
    proto::BrowserShortcut::OpenSettings => {
      toggle_settings()
      return true
    }
    proto::BrowserShortcut::ToggleDarkChrome => {
      toggle_dark_chrome()
      return true
    }
    proto::BrowserShortcut::TogglePerfHud => {
      toggle_perf_hud()
      return true
    }
    _ => ()
  }
  let cmd = primary_mod_active(mods)
  let is_copy = code == ui::key_code_copy || (cmd && code == ui::key_of_char('c'))
  let is_cut = code == ui::key_code_cut || (cmd && code == ui::key_of_char('x'))
  let is_paste = cmd && code == ui::key_of_char('v')
  let is_select_all = cmd && code == ui::key_of_char('a')
  let active_pane_i = if active_targets_split() { 1 } else { 0 }
  if !is_chrome_field_focused() && shell_is_pane_occluded(active_pane_i) {
    if is_copy || is_cut || is_select_all || !cmd {
      return true
    }
  }
  if is_paste {
    let clip = read_os_clipboard()
    if clip != "" {
      ui::clipboard_set(clip, label="Farview")
    }
    let pane = shell_page_focus_owner_pane()
    if !ui::field_has_focus() && pane >= 0 {
      let dm = dom_primary_mod()
      send_proto_to_pane(pane, proto::ClientMsg::Key(0, 0, true, "v", "KeyV", clip, dm))
      send_proto_to_pane(pane, proto::ClientMsg::Key(0, 0, false, "v", "KeyV", "", dm))
      return true
    }
    return false
  }
  if is_copy {
    match ui::focused_field_now() {
      Some(f) if f.focused() && f.paste_limit == 0 => {
        let sel = f.copy_selection()
        if sel != "" {
          write_os_clipboard(sel)
        }
        return true
      }
      _ => return false
    }
  }
  if is_cut {
    match ui::focused_field_now() {
      Some(f) if f.focused() && f.paste_limit == 0 => {
        let sel = f.cut_selection()
        if sel != "" {
          write_os_clipboard(sel)
        }
        return true
      }
      _ => return false
    }
  }
  // Layer 3: Fall through to active Stage
  false
}

///| The sidebar's tab filter as typed now ("" while none).
fn tab_filter_query_now() -> String {
  match app_state.tab_filter_query {
    Some(s) => s.untracked().trim()
    None => ""
  }
}

///| Cmd/Ctrl+W closes the frontmost thing, as Arc and macOS do: an open panel, menu or popover (focus goes back to
///| the page), then Peek, then the focused split pane (the left one's close brings the right one into its place),
///| and only then the tab. It never closes the find bar, Reader or the address field's focus ahead of the tab, and
///| never ends Zap.
fn dispatch_close_frontmost() -> Unit {
  if shell_adapter.exclusive.untracked().is_open() {
    let tag = shell_adapter.active_overlay_tag
    let closed = if tag != "" && shell_is_overlay_tag_open(tag) {
      shell_close_overlay_by_tag(tag)
    } else if shell_sig_is_true(app_state.boosts_open) && boost_zap_active() {
      // (picking with Zap: Cmd+W neither ends it nor closes a tab under it)
      return
    } else {
      shell_dismiss_active_exclusive()
    }
    if closed {
      shell_focus_pane_stage(shell_adapter.page.untracked().active_pane)
      return
    }
  }
  if is_peek_open() {
    close_peek_preview()
    shell_focus_pane_stage(shell_ui::PaneId::Primary)
    return
  }
  if is_split_open() {
    close_split_pane(active_split_pane())
    return
  }
  dispatch_tab_close("")
}
