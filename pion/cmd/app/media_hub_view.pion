///| Arc Sidebar Mini-Player Card (above bottom Space switcher) and Topbar Global Media Hub (`♫`)
///| button + mutually exclusive popover.
///| 100% reactive to Light & Dark `ChromePalette`, concentric radii (12 -> 8 -> 6pt),
///| first-line alignment, zero double dividers, zero `alpha=0` clickable controls,
///| and zero `ellipsis_past(true)`.

fn mh_pill_colors(is_dark : Bool, muted : Bool, is_live_call : Bool, playing : Bool) -> (Int64, Int64, Int64) {
  if muted {
    if is_dark {
      (0x272B36FFL, 0x3A4050FFL, 0x94A3B8FFL)
    } else {
      (0xF3F4F6FFL, 0xD1D5DBFFL, 0x6B7280FFL)
    }
  } else if is_live_call {
    if is_dark {
      (0x0E2F26FFL, 0x1B5E4AFFL, 0x34D399FFL)
    } else {
      (0xDCFCE7FFL, 0x86EFACFFL, 0x15803DFFL)
    }
  } else if playing {
    if is_dark {
      (0x361B20FFL, 0x692C35FFL, 0xFCA5A5FFL)
    } else {
      (0xFEE2E2FFL, 0xFCA5A5FFL, 0xDC2626FFL)
    }
  } else if is_dark {
    (0x362A14FFL, 0x6B4F1DFFL, 0xFBBF24FFL)
  } else {
    (0xFEF3C7FFL, 0xFCD34DFFL, 0xB45309FFL)
  }
}

fn mh_draw_play_pause_glyph(parent : view::View, is_playing : () -> Bool) -> Unit {
  parent.show(
    is_playing,
    fn(bars : view::View) -> Unit {
      let _ = bars
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .rigid()
      .gap(view::Live::Is(2.5))
      let _ = bars.box(
        fn(b1 : view::View) -> Unit {
          let _ = b1
          .width(view::Live::Is(Some(2.2)))
          .height(view::Live::Is(Some(9.0)))
          .rigid()
          .radius(view::Live::Is(1.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
        },
      )
      let _ = bars.box(
        fn(b2 : view::View) -> Unit {
          let _ = b2
          .width(view::Live::Is(Some(2.2)))
          .height(view::Live::Is(Some(9.0)))
          .rigid()
          .radius(view::Live::Is(1.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
        },
      )
    },
  )
  parent.show(
    fn() -> Bool { !is_playing() },
    fn(tri : view::View) -> Unit {
      let _ = tri
      .words(
        view::Live::Is("▶"),
        ink=0x2C3446FFL,
        look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
        one_line=true,
      )
      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
    },
  )
}

///| Builds the Arc sidebar bottom Mini-Player Card (directly above the Spaces switcher bar).
fn build_sidebar_mini_player(
  sb : view::View,
  media_hub_rev : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let get_featured = fn() -> Option[proto::MediaSessionItem] {
    let _ = media_hub_rev.get()
    let _ = workspace_rev.get()
    let snap = effective_media_hub_snapshot()
    proto::select_mini_player_session(snap, app_state.workspace.active_tab_id)
  }

  sb.show(
    fn() -> Bool { get_featured().is_some() },
    fn(mp_wrap : view::View) -> Unit {
      let _ = mp_wrap.padding(view::Live::Is((0.0, 2.0, 0.0, 4.0))).rigid()
      let _ = mp_wrap.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(223.0)))
          .rigid()
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(12.0))
          .padding(view::Live::Is((9.0, 9.0, 9.0, 9.0)))
          .gap(view::Live::Is(7.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            match get_featured() {
              Some(m) =>
              if m.muted {
                (1.0, p.border)
              } else if m.is_live_call {
                (1.0, if p.is_dark { 0x1B5E4AFFL } else { 0x86EFACFFL })
              } else if m.playing {
                let acc = proto::media_session_accent(m)
                (1.0, (acc & 0xFFFFFF00L) | (if p.is_dark { 0x66L } else { 0x55L }))
              } else {
                (1.0, p.border)
              }
              None => (1.0, p.border)
            }
          }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (12.0, 3.0, 0x00000044L) } else { (8.0, 2.0, 0x00000012L) }
          }))

          // 1. Header: 30x30 cover/monogram badge + Title / Artist-Host (first-line aligned)
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Start)))
              .rigid()
              .gap(view::Live::Is(8.0))

              // 30x30 rounded cover monogram badge (concentric radius 8pt)
              let _ = hdr.box(
                fn(cover : view::View) -> Unit {
                  let _ = cover
                  .width(view::Live::Is(Some(30.0)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    match get_featured() {
                      Some(m) => {
                        let acc = proto::media_session_accent(m)
                        if m.muted {
                          chrome_palette().surface_subtle
                        } else {
                          (acc & 0xFFFFFF00L) | (if is_dark_chrome() { 0x2EL } else { 0x22L })
                        }
                      }
                      None => chrome_palette().surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    match get_featured() {
                      Some(m) => {
                        let acc = proto::media_session_accent(m)
                        if m.muted {
                          (1.0, chrome_palette().border)
                        } else {
                          (1.0, (acc & 0xFFFFFF00L) | (if is_dark_chrome() { 0x66L } else { 0x44L }))
                        }
                      }
                      None => (1.0, chrome_palette().border)
                    }
                  }))
                  let _ = cover.box(
                    fn(ml : view::View) -> Unit {
                      let _ = ml
                      .words(
                        view::Live::By(fn() -> String {
                          match get_featured() {
                            Some(m) => proto::media_session_monogram(m)
                            None => "♫"
                          }
                        }),
                        ink=0x2563EBFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 700, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        match get_featured() {
                          Some(m) => if m.muted { chrome_palette().ink_muted } else { proto::media_session_accent(m) }
                          None => chrome_palette().ink_muted
                        }
                      }))
                    },
                  )
                },
              )

              // Right column: title + pill on line 1, artist/host on line 2
              let _ = hdr.box(
                fn(meta : view::View) -> Unit {
                  let _ = meta
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .gap(view::Live::Is(2.0))

                  let _ = meta.box(
                    fn(trow : view::View) -> Unit {
                      let _ = trow
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .rigid()
                      .gap(view::Live::Is(5.0))

                      // Single-line bounded title (zero ellipsis_past(true))
                      let _ = trow.box(
                        fn(tw : view::View) -> Unit {
                          let _ = tw
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .clips(view::Live::Is(true))
                          .words(
                            view::Live::By(fn() -> String {
                              match get_featured() {
                                Some(m) => m.title
                                None => "Playing Media"
                              }
                            }),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )

                      // Compact status pill (LIVE with green dot / MUTED / PAUSED / m:ss)
                      let _ = trow.box(
                        fn(pill : view::View) -> Unit {
                          let _ = pill
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .height(view::Live::Is(Some(16.0)))
                          .rigid()
                          .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                          .gap(view::Live::Is(3.5))
                          .radius(view::Live::Is(5.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            match get_featured() {
                              Some(m) => {
                                let (bg, _, _) = mh_pill_colors(is_dark_chrome(), m.muted, m.is_live_call, m.playing)
                                bg
                              }
                              None => chrome_palette().surface_subtle
                            }
                          }))
                          .edge(view::Live::By(fn() -> (Double, Int64) {
                            match get_featured() {
                              Some(m) => {
                                let (_, bd, _) = mh_pill_colors(is_dark_chrome(), m.muted, m.is_live_call, m.playing)
                                (1.0, bd)
                              }
                              None => (1.0, chrome_palette().border)
                            }
                          }))
                          pill.show(
                            fn() -> Bool {
                              match get_featured() {
                                Some(m) => m.is_live_call && !m.muted
                                None => false
                              }
                            },
                            fn(ldot : view::View) -> Unit {
                              let _ = ldot
                              .width(view::Live::Is(Some(5.0)))
                              .height(view::Live::Is(Some(5.0)))
                              .rigid()
                              .radius(view::Live::Is(2.5))
                              .ground(view::Live::Is(0x10B981FFL))
                            },
                          )
                          let _ = pill.box(
                            fn(pl : view::View) -> Unit {
                              let _ = pl
                              .words(
                                view::Live::By(fn() -> String {
                                  match get_featured() {
                                    Some(m) =>
                                    if m.muted {
                                      "MUTED"
                                    } else if m.is_live_call {
                                      "LIVE"
                                    } else if !m.playing {
                                      "PAUSED"
                                    } else if m.duration_secs > 0 {
                                      proto::format_media_time(m.position_secs)
                                    } else {
                                      "ON"
                                    }
                                    None => ""
                                  }
                                }),
                                ink=0x6B7280FFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 9.0, weight: 600, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 {
                                match get_featured() {
                                  Some(m) => {
                                    let (_, _, ink) = mh_pill_colors(is_dark_chrome(), m.muted, m.is_live_call, m.playing)
                                    ink
                                  }
                                  None => chrome_palette().ink_muted
                                }
                              }))
                            },
                          )
                        },
                      )
                    },
                  )

                  // Line 2: artist / host subtitle
                  let _ = meta.box(
                    fn(sub : view::View) -> Unit {
                      let _ = sub
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::By(fn() -> String {
                          match get_featured() {
                            Some(m) => m.artist_or_host
                            None => ""
                          }
                        }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // 2. Crisp 2pt progress bar (live call shows full emerald bar)
          let _ = card.box(
            fn(track : view::View) -> Unit {
              let _ = track
              .row(view::Live::Is(true))
              .height(view::Live::Is(Some(2.5)))
              .rigid()
              .radius(view::Live::Is(1.25))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
              let _ = track.box(
                fn(fill : view::View) -> Unit {
                  let _ = fill
                  .width(view::Live::By(fn() -> Option[Double] {
                    match get_featured() {
                      Some(m) => {
                        let r = proto::media_progress_ratio(m)
                        let px = r * 205.0
                        Some(if px < 4.0 && (m.playing || m.is_live_call) { 16.0 } else { px })
                      }
                      None => Some(0.0)
                    }
                  }))
                  .height(view::Live::Is(Some(2.5)))
                  .rigid()
                  .radius(view::Live::Is(1.25))
                  .ground(view::Live::By(fn() -> Int64 {
                    match get_featured() {
                      Some(m) =>
                      if m.muted {
                        chrome_palette().ink_muted
                      } else if m.is_live_call {
                        0x10B981FFL
                      } else if !m.playing {
                        0xF59E0BFFL
                      } else {
                        proto::media_session_accent(m)
                      }
                      None => chrome_palette().accent
                    }
                  }))
                },
              )
            },
          )

          // 3. Bottom control row: Jump to Tab + Play/Pause + Mute
          let _ = card.box(
            fn(bot : view::View) -> Unit {
              let _ = bot
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .gap(view::Live::Is(5.0))

              // Jump to Tab pill button
              let _ = headless::button(
                bot,
                fn() -> String { "Jump to Tab" },
                fn(_v : view::View) -> Unit {
                  match get_featured() {
                    Some(m) if m.tab_id != "" => dispatch_tab_switch(m.tab_id)
                    _ => ()
                  }
                },
                fn(jb : view::View, jbtn : headless::Button) -> Unit {
                  let _ = jb
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if jbtn.pressed() {
                      p.btn_press
                    } else if jbtn.hovered() {
                      p.btn_hover
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  let _ = jb.box(
                    fn(jl : view::View) -> Unit {
                      let _ = jl
                      .words(
                        view::Live::Is("Jump to Tab ↗"),
                        ink=0x3A4152FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_secondary }))
                    },
                  )
                },
              )

              // Play / Pause 24x24 button
              let _ = headless::button(
                bot,
                fn() -> String {
                  match get_featured() {
                    Some(m) if m.playing => "Pause Media"
                    _ => "Play Media"
                  }
                },
                fn(_v : view::View) -> Unit {
                  match get_featured() {
                    Some(m) => dispatch_media_toggle_play(m.tab_id)
                    None => dispatch_media_toggle_play("")
                  }
                },
                fn(pb : view::View, pbtn : headless::Button) -> Unit {
                  let _ = pb
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if pbtn.pressed() {
                      p.btn_press
                    } else if pbtn.hovered() {
                      p.btn_hover
                    } else {
                      p.btn_bg
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  mh_draw_play_pause_glyph(
                    pb,
                    fn() -> Bool {
                      match get_featured() {
                        Some(m) => m.playing
                        None => false
                      }
                    },
                  )
                },
              )

              // Mute / Unmute 24x24 button
              let _ = headless::button(
                bot,
                fn() -> String {
                  match get_featured() {
                    Some(m) if m.muted => "Unmute Audio"
                    _ => "Mute Audio"
                  }
                },
                fn(_v : view::View) -> Unit {
                  match get_featured() {
                    Some(m) => dispatch_media_toggle_mute(m.tab_id)
                    None => dispatch_media_toggle_mute("")
                  }
                },
                fn(mb : view::View, mbtn : headless::Button) -> Unit {
                  let is_muted = fn() -> Bool {
                    match get_featured() {
                      Some(m) => m.muted
                      None => false
                    }
                  }
                  let _ = mb
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if is_muted() {
                      if mbtn.pressed() { p.danger_border } else { p.danger_bg }
                    } else if mbtn.pressed() {
                      p.btn_press
                    } else if mbtn.hovered() {
                      p.btn_hover
                    } else {
                      p.btn_bg
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if is_muted() { (1.0, p.danger_border) } else { (1.0, p.border) }
                  }))
                  mh_draw_mute_glyph(mb, is_muted)
                },
              )
            },
          )
        },
      )
    },
  )
}

///| Builds the Topbar Global Media Hub trigger button (`♫`) with active playback/live dot.
fn build_topbar_media_hub_button(
  bar : view::View,
  media_hub_open : signals::Signal[Bool],
  media_hub_rev : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let _ = headless::button(
    bar,
    fn() -> String { "Global Media Controls" },
    fn(_v : view::View) -> Unit { toggle_media_hub() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let has_any = fn() -> Bool {
        let _ = media_hub_rev.get()
        let _ = workspace_rev.get()
        effective_media_hub_snapshot().sessions.length() > 0
      }
      let has_live = fn() -> Bool {
        let _ = media_hub_rev.get()
        let _ = workspace_rev.get()
        proto::media_hub_has_live_call(effective_media_hub_snapshot())
      }
      let has_active_audio = fn() -> Bool {
        let _ = media_hub_rev.get()
        let _ = workspace_rev.get()
        proto::media_hub_has_unmuted_playing(effective_media_hub_snapshot())
      }
      let _ = b
      .width(view::Live::Is(Some(30.0)))
      .height(view::Live::Is(Some(28.0)))
      .rigid()
      .center()
      .radius(view::Live::Is(6.0))
      .ground(view::Live::By(fn() -> Int64 {
        let p = chrome_palette()
        if btn.pressed() {
          p.btn_press
        } else if media_hub_open.get() {
          p.btn_active_bg
        } else if btn.hovered() {
          p.btn_hover
        } else {
          p.btn_bg
        }
      }))
      let _ = b.box(
        fn(lbl : view::View) -> Unit {
          let _ = lbl
          .words(
            view::Live::Is("♫"),
            ink=0x3A4152FFL,
            look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 600, wrap: false },
            one_line=true,
          )
          .ink(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if media_hub_open.get() || has_active_audio() {
              p.accent
            } else {
              p.ink_secondary
            }
          }))
        },
      )
      b.show(
        has_any,
        fn(dot : view::View) -> Unit {
          let _ = dot
          .over_at(view::Live::Is((None, Some(4.0), Some(4.0), None)))
          .width(view::Live::Is(Some(5.5)))
          .height(view::Live::Is(Some(5.5)))
          .radius(view::Live::Is(2.75))
          .ground(view::Live::By(fn() -> Int64 {
            if has_live() {
              0x10B981FFL
            } else if has_active_audio() {
              chrome_palette().accent
            } else {
              chrome_palette().ink_muted
            }
          }))
        },
      )
    },
  )
}

///| Builds the mutually exclusive Global Media Hub popover anchored under the topbar `♫` button.
fn build_media_hub_popover(
  root : view::View,
  media_hub_open : signals::Signal[Bool],
  media_hub_rev : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let get_sessions = fn() -> Array[proto::MediaSessionItem] {
    let _ = media_hub_rev.get()
    let _ = workspace_rev.get()
    effective_media_hub_snapshot().sessions
  }

  root.show(
    fn() -> Bool { media_hub_open.get() },
    fn(overlay : view::View) -> Unit {
      let _ = overlay.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      // Click-outside transparent backdrop
      let _ = headless::button(
        overlay,
        fn() -> String { "Close Media Controls" },
        fn(_v : view::View) -> Unit { close_media_hub() },
        fn(bg : view::View, _btn : headless::Button) -> Unit {
          let _ = bg.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
        },
      )
      // Popover card anchored top-right below toolbar
      let _ = overlay.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
            match app_state.address_bar_view {
              Some(ab) => {
                let (_, ay, _, ah) = ab.placed_now()
                let top = if ah > 10.0 { ay + ah + 6.0 } else { 48.0 }
                (None, Some(top), Some(42.0), None)
              }
              None => (None, Some(48.0), Some(42.0), None)
            }
          }))
          .width(view::Live::Is(Some(352.0)))
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(12.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (24.0, 8.0, 0x00000066L) } else { (18.0, 6.0, 0x00000022L) }
          }))

          // Header row
          let _ = card.box(
            fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((12.0, 10.0, 10.0, 10.0)))
              .gap(view::Live::Is(8.0))
              let _ = hdr.box(
                fn(t : view::View) -> Unit {
                  let _ = t
                  .grow(view::Live::Is(1.0))
                  .words(
                    view::Live::Is("Global Media Controls"),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )
              // Session count badge
              let _ = hdr.box(
                fn(cnt : view::View) -> Unit {
                  let _ = cnt
                  .height(view::Live::Is(Some(19.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_bg }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().accent_soft_border) }))
                  let _ = cnt.box(
                    fn(cl : view::View) -> Unit {
                      let _ = cl
                      .words(
                        view::Live::By(fn() -> String {
                          let n = get_sessions().length()
                          if n == 1 { "1 active" } else { n.to_string() + " active" }
                        }),
                        ink=0x2563EBFFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().accent_soft_ink }))
                    },
                  )
                },
              )
              // Close button
              let _ = headless::button(
                hdr,
                fn() -> String { "Close Media Controls" },
                fn(_v : view::View) -> Unit { close_media_hub() },
                fn(cb : view::View, cbtn : headless::Button) -> Unit {
                  let _ = cb
                  .width(view::Live::Is(Some(24.0)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if cbtn.pressed() { p.btn_press } else if cbtn.hovered() { p.btn_hover } else { 0x00000000L }
                  }))
                  let _ = cb.box(
                    fn(x : view::View) -> Unit {
                      let _ = x
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 15.0, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )
            },
          )

          // Single hairline below header
          let _ = card.box(
            fn(sep : view::View) -> Unit {
              let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
            },
          )

          // Empty state
          card.show(
            fn() -> Bool { get_sessions().length() == 0 },
            fn(emp : view::View) -> Unit {
              let _ = emp.padding(view::Live::Is((16.0, 22.0, 16.0, 22.0))).center()
              let _ = emp.box(
                fn(el : view::View) -> Unit {
                  let _ = el
                  .words(
                    view::Live::Is("No active media or live calls"),
                    ink=0x6B7280FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                },
              )
            },
          )

          // Session rows (up to 6 fixed reactive slots so zero double dividers and instant updates)
          card.show(
            fn() -> Bool { get_sessions().length() > 0 },
            fn(list : view::View) -> Unit {
              let _ = list.padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
              let mut slot = 0
              while slot < 6 {
                let idx = slot
                let get_item = fn() -> Option[proto::MediaSessionItem] {
                  let ss = get_sessions()
                  if idx < ss.length() { Some(ss[idx]) } else { None }
                }
                list.show(
                  fn() -> Bool { get_item().is_some() },
                  fn(wrap : view::View) -> Unit {
                    // Hairline divider only between adjacent items (idx > 0)
                    if idx > 0 {
                      let _ = wrap.box(
                        fn(dv : view::View) -> Unit {
                          let _ = dv
                          .padding(view::Live::Is((6.0, 3.0, 6.0, 3.0)))
                          .rigid()
                          let _ = dv.box(
                            fn(ln : view::View) -> Unit {
                              let _ = ln.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                            },
                          )
                        },
                      )
                    }
                    let _ = wrap.box(
                      fn(row : view::View) -> Unit {
                        let _ = row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .padding(view::Live::Is((6.0, 7.0, 6.0, 7.0)))
                        .gap(view::Live::Is(8.0))
                        .radius(view::Live::Is(8.0))

                        // Clickable left+middle area: cover badge + title/artist/progress (jumps to tab)
                        let _ = headless::button(
                          row,
                          fn() -> String {
                            match get_item() {
                              Some(m) => "Jump to " + m.title
                              None => "Jump to Tab"
                            }
                          },
                          fn(_v : view::View) -> Unit {
                            match get_item() {
                              Some(m) if m.tab_id != "" => {
                                close_media_hub()
                                dispatch_tab_switch(m.tab_id)
                              }
                              _ => ()
                            }
                          },
                          fn(main_btn : view::View, mbtn : headless::Button) -> Unit {
                            let _ = main_btn
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Start)))
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .padding(view::Live::Is((4.0, 3.0, 4.0, 3.0)))
                            .gap(view::Live::Is(9.0))
                            .radius(view::Live::Is(7.0))
                            .ground(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if mbtn.pressed() {
                                p.tab_press_bg
                              } else if mbtn.hovered() {
                                p.tab_hover_bg
                              } else {
                                0x00000000L
                              }
                            }))

                            // 32x32 cover monogram badge
                            let _ = main_btn.box(
                              fn(cv : view::View) -> Unit {
                                let _ = cv
                                .width(view::Live::Is(Some(32.0)))
                                .height(view::Live::Is(Some(32.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(8.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  match get_item() {
                                    Some(m) => {
                                      let acc = proto::media_session_accent(m)
                                      if m.muted {
                                        chrome_palette().surface_subtle
                                      } else {
                                        (acc & 0xFFFFFF00L) | (if is_dark_chrome() { 0x2EL } else { 0x22L })
                                      }
                                    }
                                    None => chrome_palette().surface_subtle
                                  }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) {
                                  match get_item() {
                                    Some(m) => {
                                      let acc = proto::media_session_accent(m)
                                      if m.muted {
                                        (1.0, chrome_palette().border)
                                      } else {
                                        (1.0, (acc & 0xFFFFFF00L) | (if is_dark_chrome() { 0x66L } else { 0x44L }))
                                      }
                                    }
                                    None => (1.0, chrome_palette().border)
                                  }
                                }))
                                let _ = cv.box(
                                  fn(ml : view::View) -> Unit {
                                    let _ = ml
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(m) => proto::media_session_monogram(m)
                                          None => "♫"
                                        }
                                      }),
                                      ink=0x2563EBFFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 13.5, weight: 700, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 {
                                      match get_item() {
                                        Some(m) => if m.muted { chrome_palette().ink_muted } else { proto::media_session_accent(m) }
                                        None => chrome_palette().ink_muted
                                      }
                                    }))
                                  },
                                )
                              },
                            )

                            // Title + pill, subtitle, progress bar
                            let _ = main_btn.box(
                              fn(info : view::View) -> Unit {
                                let _ = info
                                .grow(view::Live::Is(1.0))
                                .shrink(view::Live::Is(1.0))
                                .basis(view::Live::Is(Some(0.0)))
                                .min_width(view::Live::Is(Some(0.0)))
                                .gap(view::Live::Is(3.0))

                                // Line 1: title + pill
                                let _ = info.box(
                                  fn(l1 : view::View) -> Unit {
                                    let _ = l1
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                    .rigid()
                                    .gap(view::Live::Is(6.0))
                                    let _ = l1.box(
                                      fn(tw : view::View) -> Unit {
                                        let _ = tw
                                        .grow(view::Live::Is(1.0))
                                        .shrink(view::Live::Is(1.0))
                                        .basis(view::Live::Is(Some(0.0)))
                                        .min_width(view::Live::Is(Some(0.0)))
                                        .clips(view::Live::Is(true))
                                        .words(
                                          view::Live::By(fn() -> String {
                                            match get_item() {
                                              Some(m) => m.title
                                              None => ""
                                            }
                                          }),
                                          ink=0x1D1D1FFFL,
                                          look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                                          one_line=true,
                                        )
                                        .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                                      },
                                    )
                                    let _ = l1.box(
                                      fn(pl : view::View) -> Unit {
                                        let _ = pl
                                        .row(view::Live::Is(true))
                                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                        .height(view::Live::Is(Some(16.0)))
                                        .rigid()
                                        .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                                        .gap(view::Live::Is(3.0))
                                        .radius(view::Live::Is(5.0))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          match get_item() {
                                            Some(m) => {
                                              let (bg, _, _) = mh_pill_colors(is_dark_chrome(), m.muted, m.is_live_call, m.playing)
                                              bg
                                            }
                                            None => chrome_palette().surface_subtle
                                          }
                                        }))
                                        pl.show(
                                          fn() -> Bool {
                                            match get_item() {
                                              Some(m) => m.is_live_call && !m.muted
                                              None => false
                                            }
                                          },
                                          fn(d : view::View) -> Unit {
                                            let _ = d
                                            .width(view::Live::Is(Some(4.5)))
                                            .height(view::Live::Is(Some(4.5)))
                                            .rigid()
                                            .radius(view::Live::Is(2.25))
                                            .ground(view::Live::Is(0x10B981FFL))
                                          },
                                        )
                                        let _ = pl.box(
                                          fn(pt : view::View) -> Unit {
                                            let _ = pt
                                            .words(
                                              view::Live::By(fn() -> String {
                                                match get_item() {
                                                  Some(m) =>
                                                  if m.muted {
                                                    "MUTED"
                                                  } else if m.is_live_call {
                                                    "LIVE"
                                                  } else if !m.playing {
                                                    "PAUSED"
                                                  } else if m.duration_secs > 0 {
                                                    proto::format_media_time(m.position_secs) + " / " + proto::format_media_time(m.duration_secs)
                                                  } else {
                                                    "PLAYING"
                                                  }
                                                  None => ""
                                                }
                                              }),
                                              ink=0x6B7280FFL,
                                              look=view::WordsLook::{ ..view::words_plain, size: 9.0, weight: 600, wrap: false },
                                              one_line=true,
                                            )
                                            .ink(view::Live::By(fn() -> Int64 {
                                              match get_item() {
                                                Some(m) => {
                                                  let (_, _, ink) = mh_pill_colors(is_dark_chrome(), m.muted, m.is_live_call, m.playing)
                                                  ink
                                                }
                                                None => chrome_palette().ink_muted
                                              }
                                            }))
                                          },
                                        )
                                      },
                                    )
                                  },
                                )

                                // Line 2: artist / host
                                let _ = info.box(
                                  fn(sub : view::View) -> Unit {
                                    let _ = sub
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .clips(view::Live::Is(true))
                                    .words(
                                      view::Live::By(fn() -> String {
                                        match get_item() {
                                          Some(m) => m.artist_or_host
                                          None => ""
                                        }
                                      }),
                                      ink=0x6B7280FFL,
                                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                      one_line=true,
                                    )
                                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                                  },
                                )

                                // Line 3: 2pt progress bar
                                let _ = info.box(
                                  fn(tr : view::View) -> Unit {
                                    let _ = tr
                                    .row(view::Live::Is(true))
                                    .height(view::Live::Is(Some(2.0)))
                                    .rigid()
                                    .radius(view::Live::Is(1.0))
                                    .clips(view::Live::Is(true))
                                    .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                                    let _ = tr.box(
                                      fn(fl : view::View) -> Unit {
                                        let _ = fl
                                        .width(view::Live::By(fn() -> Option[Double] {
                                          match get_item() {
                                            Some(m) => {
                                              let px = proto::media_progress_ratio(m) * 196.0
                                              Some(if px < 4.0 && (m.playing || m.is_live_call) { 14.0 } else { px })
                                            }
                                            None => Some(0.0)
                                          }
                                        }))
                                        .height(view::Live::Is(Some(2.0)))
                                        .rigid()
                                        .radius(view::Live::Is(1.0))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          match get_item() {
                                            Some(m) =>
                                            if m.muted {
                                              chrome_palette().ink_muted
                                            } else if m.is_live_call {
                                              0x10B981FFL
                                            } else if !m.playing {
                                              0xF59E0BFFL
                                            } else {
                                              proto::media_session_accent(m)
                                            }
                                            None => chrome_palette().accent
                                          }
                                        }))
                                      },
                                    )
                                  },
                                )
                              },
                            )
                          },
                        )

                        // Independent Play/Pause & Mute buttons
                        let _ = row.box(
                          fn(ctls : view::View) -> Unit {
                            let _ = ctls
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .rigid()
                            .gap(view::Live::Is(5.0))

                            let _ = headless::button(
                              ctls,
                              fn() -> String {
                                match get_item() {
                                  Some(m) if m.playing => "Pause"
                                  _ => "Play"
                                }
                              },
                              fn(_v : view::View) -> Unit {
                                match get_item() {
                                  Some(m) => dispatch_media_toggle_play(m.tab_id)
                                  None => ()
                                }
                              },
                              fn(pb : view::View, pbtn : headless::Button) -> Unit {
                                let _ = pb
                                .width(view::Live::Is(Some(26.0)))
                                .height(view::Live::Is(Some(26.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if pbtn.pressed() { p.btn_press } else if pbtn.hovered() { p.btn_hover } else { p.btn_bg }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                                mh_draw_play_pause_glyph(
                                  pb,
                                  fn() -> Bool {
                                    match get_item() {
                                      Some(m) => m.playing
                                      None => false
                                    }
                                  },
                                )
                              },
                            )

                            let _ = headless::button(
                              ctls,
                              fn() -> String {
                                match get_item() {
                                  Some(m) if m.muted => "Unmute"
                                  _ => "Mute"
                                }
                              },
                              fn(_v : view::View) -> Unit {
                                match get_item() {
                                  Some(m) => dispatch_media_toggle_mute(m.tab_id)
                                  None => ()
                                }
                              },
                              fn(mb : view::View, mbtn : headless::Button) -> Unit {
                                let is_muted = fn() -> Bool {
                                  match get_item() {
                                    Some(m) => m.muted
                                    None => false
                                  }
                                }
                                let _ = mb
                                .width(view::Live::Is(Some(26.0)))
                                .height(view::Live::Is(Some(26.0)))
                                .rigid()
                                .center()
                                .radius(view::Live::Is(6.0))
                                .ground(view::Live::By(fn() -> Int64 {
                                  let p = chrome_palette()
                                  if is_muted() {
                                    if mbtn.pressed() { p.danger_border } else { p.danger_bg }
                                  } else if mbtn.pressed() {
                                    p.btn_press
                                  } else if mbtn.hovered() {
                                    p.btn_hover
                                  } else {
                                    p.btn_bg
                                  }
                                }))
                                .edge(view::Live::By(fn() -> (Double, Int64) {
                                  let p = chrome_palette()
                                  if is_muted() { (1.0, p.danger_border) } else { (1.0, p.border) }
                                }))
                                mh_draw_mute_glyph(mb, is_muted)
                              },
                            )
                          },
                        )
                      },
                    )
                  },
                )
                slot = slot + 1
              }
            },
          )

          // Footer with "Mute all" action (only when at least 1 session exists)
          card.show(
            fn() -> Bool { get_sessions().length() > 0 },
            fn(foot_wrap : view::View) -> Unit {
              let _ = foot_wrap.box(
                fn(sep : view::View) -> Unit {
                  let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )
              let _ = foot_wrap.box(
                fn(foot : view::View) -> Unit {
                  let _ = foot
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((12.0, 8.0, 10.0, 8.0)))
                  .gap(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  let _ = foot.box(
                    fn(hint : view::View) -> Unit {
                      let _ = hint
                      .grow(view::Live::Is(1.0))
                      .words(
                        view::Live::Is("Click a session to jump to tab"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                  let _ = headless::button(
                    foot,
                    fn() -> String { "Mute all" },
                    fn(_v : view::View) -> Unit { dispatch_media_mute_all() },
                    fn(mb : view::View, mbtn : headless::Button) -> Unit {
                      let _ = mb
                      .height(view::Live::Is(Some(24.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if mbtn.pressed() { p.btn_press } else if mbtn.hovered() { p.btn_hover } else { p.btn_bg }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                      let _ = mb.box(
                        fn(ml : view::View) -> Unit {
                          let _ = ml
                          .words(
                            view::Live::Is("Mute all"),
                            ink=0x1D1D1FFFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                        },
                      )
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
