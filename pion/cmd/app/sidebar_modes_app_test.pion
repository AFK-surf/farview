///| Sidebar modes in the app: a downloaded program is never handed to the system opener, Create a Space keeps
///| browser shortcuts from changing what is behind it, and one Escape closes the theme editor only.

fn smapp_download(name : String, path : String) -> proto::DownloadSummary {
  proto::DownloadSummary::{ id: "x", filename: name, url: "https://example.com/" + name, mime: "", bytes: 10L, state: "completed", path }
}

test "library: executables and unknown files never reach fv_app_open_file" {
  let seen : Array[String] = []
  let saved = lib_open_spawn.v
  lib_open_spawn.v = fn(p : String) -> Int {
    seen.push(p)
    0
  }
  for n in ["run.command", "Installer.app", "x.terminal", "tool.jar", "a.sh", "setup.pkg", "page.html", "README"] {
    open_download_with_toast(smapp_download(n, "/tmp/fv-no-such-dir/" + n))
    debug_assert(!download_opens_directly(smapp_download(n, "/tmp/" + n)), "not opened directly: " + n)
  }
  debug_assert(seen.length() == 0, "nothing passed to the opener: " + seen.join(", "))
  // A picture whose path on disk is an executable name is refused too (the opener sees the path).
  debug_assert(!download_opens_directly(smapp_download("cat.png", "/tmp/cat.command")), "path checked as well")
  debug_assert(download_opens_directly(smapp_download("report.pdf", "/tmp/report.pdf")), "a PDF opens")
  lib_open_spawn.v = saved
}

test "create a space: browser shortcuts are swallowed, typing and editing pass" {
  let cmd = proto::SHORTCUT_MOD_CMD
  let ctrl = proto::SHORTCUT_MOD_CTRL
  let key = fn(c : Char) -> Int { 1000 + c.to_int() }
  debug_assert(create_space_blocks_key(key('t'), cmd, true), "Cmd+T")
  debug_assert(create_space_blocks_key(key('l'), cmd, true), "Cmd+L")
  debug_assert(create_space_blocks_key(key('k'), cmd, true), "Cmd+K")
  debug_assert(create_space_blocks_key(key('w'), cmd, true), "Cmd+W")
  debug_assert(create_space_blocks_key(proto::KEY_TAB, ctrl, true), "Ctrl+Tab")
  debug_assert(create_space_blocks_key(proto::KEY_F5_MAC, 0, true), "F5")
  debug_assert(!create_space_blocks_key(key('a'), cmd, true) && !create_space_blocks_key(key('v'), cmd, true), "Cmd+A, Cmd+V")
  debug_assert(!create_space_blocks_key(key('z'), cmd | proto::SHORTCUT_MOD_SHIFT, true), "Cmd+Shift+Z")
  debug_assert(!create_space_blocks_key(key('q'), cmd, true), "Cmd+Q")
  debug_assert(!create_space_blocks_key(key('s'), 0, true) && !create_space_blocks_key(proto::KEY_LEFT, 0, true), "typing")
  debug_assert(!create_space_blocks_key(proto::KEY_ESCAPE, 0, true) && !create_space_blocks_key(proto::KEY_ENTER, 0, true), "Escape, Return")
  // Through the app's key handler.
  sidebar_modes.start_create(shell_ui::create_space_default_theme(0), name="Studio")
  debug_assert(handle_app_key(key('t'), cmd, false), "Cmd+T taken while creating")
  debug_assert(sidebar_modes.mode.untracked() is shell_ui::SidebarMode::CreateSpace, "still creating")
  sidebar_modes.cancel_create()
}

test "create a space: one Escape closes the theme editor only, the next cancels" {
  sidebar_modes.start_create(shell_ui::create_space_default_theme(0), name="Studio")
  sidebar_modes.theme_open.set(true)
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "Escape consumed")
  debug_assert(!sidebar_modes.theme_open.untracked(), "the editor closed")
  debug_assert(sidebar_modes.mode.untracked() is shell_ui::SidebarMode::CreateSpace, "still in Create a Space")
  debug_assert(handle_app_key(proto::KEY_ESCAPE, 0, false), "second Escape consumed")
  debug_assert(sidebar_modes.mode.untracked() is shell_ui::SidebarMode::Tabs, "the second Escape cancels")
  debug_assert(shell_ui::space_theme_draft.untracked().is_none(), "no preview left")
}
