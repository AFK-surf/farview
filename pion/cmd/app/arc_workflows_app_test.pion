fn arc_app_test_acts(sent : Array[wire::Message]) -> Array[String] {
  let out : Array[String] = []
  for m in sent {
    match m {
      wire::Message::Act(v, a, b) => out.push(v + "|" + a + "|" + b)
      _ => ()
    }
  }
  out
}

test "app arc: the host's rules, archive record and mini player land in the app; edits and restores go back as acts" {
  let prev_hook = test_send_wire_hook.v
  let prev = (arc_app.rules, arc_app.archived, arc_app.pip)
  let sent : Array[wire::Message] = []
  test_send_wire_hook.v = Some(fn(m : wire::Message) -> Unit { sent.push(m) })
  // From the host.
  let rules = proto::AtcRulesSnapshot::{
    rules: [proto::AtcRule::{ id: "atc-1", pattern: "github.com", match_kind: "host", target_space_id: "work", enabled: true, open_in_quick_window: false }],
  }
  debug_assert(arc_take_host_act("arc_atc_rules", proto::encode_atc_rules(rules), ""), "rules taken")
  debug_assert(arc_app.rules.length() == 1 && arc_app.rules[0].pattern == "github.com", "rules kept")
  let rec = proto::ArchivedTabsSnapshot::{
    items: [proto::ArchivedTabItem::{ id: "7", title: "Docs", url: "https://d.test/", host: "d.test", space_id: "work", archived_at_secs: 5L, last_active_secs: 1L }],
  }
  debug_assert(arc_take_host_act("arc_archived_tabs", proto::encode_archived_tabs(rec), ""), "record taken")
  debug_assert(arc_archived_now().length() == 1, "record kept")
  let pip = proto::AutoPipState::{ ..proto::AutoPipState::hidden(), active: true, tab_id: "9", title: "Video" }
  debug_assert(arc_take_host_act("arc_auto_pip", proto::encode_auto_pip_state(pip), ""), "pip taken")
  debug_assert(arc_app.pip.active && arc_app.pip.tab_id == "9", "pip kept")
  debug_assert(!arc_take_host_act("migrate_sources", "", ""), "other acts are not these")
  // To the host.
  let props = arc_atc_editor_props(signals::signal(0))
  (props.on_toggle)("atc-1", false)
  debug_assert(!arc_app.rules[0].enabled, "toggled at once")
  (props.on_upsert)(proto::AtcRule::{ id: "", pattern: "*.notion.so", match_kind: "host", target_space_id: "", enabled: true, open_in_quick_window: true })
  debug_assert(arc_app.rules.length() == 2, "added at once")
  (props.on_delete)("atc-1")
  dispatch_archived_restore("7")
  debug_assert(arc_app.archived.length() == 0, "restored leaves the list")
  dispatch_archived_clear()
  dispatch_arc_sync()
  let acts = arc_app_test_acts(sent)
  debug_assert(acts.contains("atc_rule_toggle|atc-1|false"), "toggle act")
  let mut upsert = false
  for a in acts {
    if a.starts_with("atc_rule_upsert|") && a.contains("notion.so") && a.contains("\"openInQuickWindow\":true") {
      upsert = true
    }
  }
  debug_assert(upsert, "upsert act carries the rule")
  debug_assert(acts.contains("atc_rule_delete|atc-1|"), "delete act")
  debug_assert(acts.contains("archived_tab_restore|7|"), "restore act")
  debug_assert(acts.contains("archived_tabs_clear||"), "clear act")
  debug_assert(acts.contains("atc_rules_get||") && acts.contains("archived_tabs_list||") && acts.contains("auto_pip_sync||"), "sync acts")
  test_send_wire_hook.v = prev_hook
  let (r0, a0, p0) = prev
  arc_app.rules = r0
  arc_app.archived = a0
  arc_app.pip = p0
}
