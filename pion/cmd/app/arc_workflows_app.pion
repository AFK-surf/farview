///| Arc signature workflows in the app (the host's side: `pion/cmd/host/arc_workflows.pion`):
///|
///| - Air Traffic Control: the rules the host keeps (`Act("arc_atc_rules", json)`), edited in Settings > Tabs; a link
///|   the host routes to the Quick Window (`Act("arc_atc_route", url, space)`) opens it there, and one routed into
///|   another Space (`Act("arc_atc_routed", url, space)`) says where it went.
///| - Archived tabs: the host's record (`Act("arc_archived_tabs", json)`) listed in Library > Archived Tabs, each
///|   restored by its id, all cleared at once.
///| - Auto Picture-in-Picture: the mini player's state (`Act("arc_auto_pip", json)`), floated over the page area.

struct ArcAppState {
  mut rules : Array[proto::AtcRule]
  mut archived : Array[proto::ArchivedTabItem]
  mut pip : proto::AutoPipState
  ///| bumped on each change from the host (made with the first view that reads it)
  mut rev : Option[signals::Signal[Int]]
}

let arc_app : ArcAppState = ArcAppState::{ rules: [], archived: [], pip: proto::AutoPipState::hidden(), rev: None }

fn arc_rev() -> signals::Signal[Int] {
  match arc_app.rev {
    Some(r) => r
    None => {
      let r = signals::signal(0)
      arc_app.rev = Some(r)
      r
    }
  }
}

fn arc_changed() -> Unit {
  let r = arc_rev()
  r.set(r.untracked() + 1)
}

///| Asks the host for the rules, the archive record and the mini player (on connecting).
fn dispatch_arc_sync() -> Unit {
  send_wire(wire::Message::Act("atc_rules_get", "", ""))
  send_wire(wire::Message::Act("archived_tabs_list", "", ""))
  send_wire(wire::Message::Act("auto_pip_sync", "", ""))
}

///| An Act the host sent about these workflows; false when `verb` is none of them.
fn arc_take_host_act(verb : String, a : String, b : String) -> Bool {
  if verb == "arc_atc_rules" {
    match proto::parse_atc_rules(a) {
      Some(sn) => {
        arc_app.rules = sn.rules
        arc_changed()
      }
      None => ()
    }
    true
  } else if verb == "arc_archived_tabs" {
    match proto::parse_archived_tabs(a) {
      Some(sn) => {
        arc_app.archived = sn.items
        arc_changed()
      }
      None => ()
    }
    true
  } else if verb == "arc_auto_pip" {
    match proto::parse_auto_pip_state(a) {
      Some(s) => {
        arc_app.pip = s
        arc_changed()
      }
      None => ()
    }
    true
  } else if verb == "arc_atc_route" {
    // (Quick Window: opened at the link; its Open in Space goes to the rule's Space)
    open_little_arc(url_arg=a)
    match client_little_arc.target_space_id {
      Some(s) => if b != "" { s.set(b) }
      None => ()
    }
    true
  } else if verb == "arc_atc_routed" {
    let mut name = ""
    for sp in app_state.workspace.spaces {
      if sp.id == b {
        name = sp.name
      }
    }
    if name != "" {
      show_toast("Opened in " + name, "info")
    }
    true
  } else {
    false
  }
}

fn arc_shell_spaces() -> Array[shell_ui::ShellSpaceItem] {
  let out : Array[shell_ui::ShellSpaceItem] = []
  for sp in app_state.workspace.spaces {
    out.push(shell_ui::ShellSpaceItem::{
      id: sp.id,
      name: if sp.name != "" { sp.name } else { "Work" },
      accent_rgba: proto::workspace_accent_color(sp.accent),
      theme: sp.theme,
    })
  }
  out
}

///| Settings > Tabs' Air Traffic Control editor, on the host's rules.
fn arc_atc_editor_props(workspace_rev : signals::Signal[Int]) -> shell_ui::AtcEditorProps {
  shell_ui::AtcEditorProps::{
    rules: fn() {
      let _ = arc_rev().get()
      arc_app.rules
    },
    spaces: fn() {
      let _ = workspace_rev.get()
      arc_shell_spaces()
    },
    on_upsert: fn(r) {
      // (shown at once; the host's answer is the rules as saved)
      arc_app.rules = proto::atc_rules_upsert(arc_app.rules, r)
      arc_changed()
      send_wire(wire::Message::Act("atc_rule_upsert", proto::encode_atc_rule_json(r), ""))
    },
    on_toggle: fn(id, on) {
      arc_app.rules = proto::atc_rules_toggle(arc_app.rules, id, on)
      arc_changed()
      send_wire(wire::Message::Act("atc_rule_toggle", id, if on { "true" } else { "false" }))
    },
    on_delete: fn(id) {
      arc_app.rules = proto::atc_rules_delete(arc_app.rules, id)
      arc_changed()
      send_wire(wire::Message::Act("atc_rule_delete", id, ""))
    },
  }
}

fn arc_archived_now() -> Array[proto::ArchivedTabItem] {
  let _ = arc_rev().get()
  arc_app.archived
}

fn dispatch_archived_restore(id : String) -> Unit {
  let mut title = ""
  for it in arc_app.archived {
    if it.id == id {
      title = it.title
    }
  }
  arc_app.archived = proto::archived_tabs_remove(arc_app.archived, id)
  arc_changed()
  send_wire(wire::Message::Act("archived_tab_restore", id, ""))
  show_toast("Restored \"" + (if title != "" { title } else { "Archived Tab" }) + "\"", "info")
}

fn dispatch_archived_clear() -> Unit {
  arc_app.archived = []
  arc_changed()
  send_wire(wire::Message::Act("archived_tabs_clear", "", ""))
  show_toast("Cleared archived tabs", "clear")
}

///| The floating mini player over the page area (`host`: the frame's body overlays).
fn build_arc_auto_pip(host : view::View) -> Unit {
  shell_ui::build_auto_pip_overlay(host, shell_ui::AutoPipProps::{
    state: fn() {
      let _ = arc_rev().get()
      arc_app.pip
    },
    on_back: fn() { send_wire(wire::Message::Act("auto_pip_back", "", "")) },
    on_toggle_play: fn() { send_wire(wire::Message::Act("auto_pip_toggle_play", "", "")) },
    on_toggle_mute: fn() { send_wire(wire::Message::Act("auto_pip_toggle_mute", "", "")) },
    on_close: fn() {
      arc_app.pip = proto::AutoPipState::{ ..arc_app.pip, active: false }
      arc_changed()
      send_wire(wire::Message::Act("auto_pip_close", "", ""))
    },
    on_place: fn(corner, w) { send_wire(wire::Message::Act("auto_pip_place", corner, w.to_string())) },
  })
}
