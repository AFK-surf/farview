///| Flagship Arc / Chrome Desktop Shell Views (`shell_dock_view.pion`):
///| 1. `build_shell_dock_mini_player`: Arc sidebar bottom-left dual-row glass Mini Media Player
///|    card (`MiniPlayerState`), conditionally mounted above Space switcher (zero persistent space).
///| 2. `build_omni_suggest_overlay`: Chrome / Arc rich-categorized Omnibox dropdown
///|    (`OmniSuggestState`) with section headers, `Switch to Tab` capsules, Bookmarks,
///|    History, Instant Calc/Unit Conversion, and `@gh`/`@yt`/`@mdn` site search.
///| 3. `build_split_focus_bar`: Arc Split View ultra-thin `28pt` top focus & quick-switch
///|    micro-toolbar (`SplitBarState`) with single bottom hairline, domain focus pills,
///|    and `Swap ⇄` / `Solo` / `Close Split` capsules.

fn current_mini_player_state() -> proto::MiniPlayerState {
  let snap = effective_media_hub_snapshot()
  let prev = proto::MiniPlayerState::{
    active: app_state.mini_player_dismissed_tab != "",
    dismissed: app_state.mini_player_dismissed_tab != "",
    tab_id: app_state.mini_player_dismissed_tab,
    title: "",
    domain: "",
    url: "",
    playing: false,
    muted: false,
    is_live: false,
    duration_secs: 0,
    position_secs: 0,
  }
  prev.sync_from_snapshot(snap, app_state.workspace.active_tab_id)
}

fn dismiss_shell_mini_player(tab_id : String) -> Unit {
  let tid = tab_id.trim()
  app_state.mini_player_dismissed_tab = if tid != "" { tid } else { "__dismissed__" }
  // Pause the dismissed media session so audio stops cleanly
  let sessions = app_state.media_hub_snap.sessions
  let next : Array[proto::MediaSessionItem] = []
  let mut i = 0
  while i < sessions.length() {
    let s = sessions[i]
    if (tid != "" && s.tab_id == tid) || (tid == "" && i == 0) {
      next.push(proto::MediaSessionItem::{ ..s, playing: false })
    } else {
      next.push(s)
    }
    i = i + 1
  }
  app_state.media_hub_snap = proto::MediaHubSnapshot::{ sessions: next }
  match app_state.media_hub_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  match app_state.mini_player_rev {
    Some(r) => r.set(r.untracked() + 1)
    None => ()
  }
  if tid != "" {
    send_wire(wire::Message::Act("media_toggle_play", tid, ""))
  }
}

///| Builds the Arc sidebar bottom-left Mini Media Player control card (`MiniPlayerState`).
///| Conditionally mounted directly above the Space switcher bar (zero persistent placeholder).
fn build_shell_dock_mini_player(
  sb : view::View,
  media_hub_rev : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
  mini_player_rev : signals::Signal[Int],
) -> Unit {
  let get_mp = fn() -> proto::MiniPlayerState {
    let _ = media_hub_rev.get()
    let _ = workspace_rev.get()
    let _ = mini_player_rev.get()
    current_mini_player_state()
  }

  sb.show(
    fn() -> Bool { get_mp().is_visible() },
    fn(mp_wrap : view::View) -> Unit {
      let _ = mp_wrap.padding(view::Live::Is((0.0, 2.0, 0.0, 4.0))).rigid()
      let _ = mp_wrap.box(
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(223.0)))
          .rigid()
          .clips(view::Live::Is(true))
          .radius(view::Live::Is(12.0))
          .padding(view::Live::Is((9.0, 8.0, 9.0, 8.0)))
          .gap(view::Live::Is(7.0))
          .ground(view::Live::By(fn() -> Int64 {
            let p = chrome_palette()
            if p.is_dark { 0x1E222CEEL } else { 0xFFFFFFF2L }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            let p = chrome_palette()
            let mp = get_mp()
            if mp.muted {
              (1.0, p.border)
            } else if mp.is_live {
              (1.0, if p.is_dark { 0x1B5E4AFFL } else { 0x86EFACFFL })
            } else if mp.playing {
              let acc = mp.accent_color()
              (1.0, (acc & 0xFFFFFF00L) | (if p.is_dark { 0x66L } else { 0x55L }))
            } else {
              (1.0, p.border)
            }
          }))
          .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
            if is_dark_chrome() { (12.0, 3.0, 0x00000048L) } else { (10.0, 2.0, 0x0F172A14L) }
          }))

          // Row 1: Colored audio waveform/state dot + single-line title + domain capsule + Jump button
          let _ = card.box(
            fn(top_row : view::View) -> Unit {
              let _ = top_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .gap(view::Live::Is(6.0))

              // Colored audio waveform (playing) or status dot (paused/muted)
              let _ = top_row.box(
                fn(wave : view::View) -> Unit {
                  let _ = wave
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::End)))
                  .width(view::Live::Is(Some(13.0)))
                  .height(view::Live::Is(Some(12.0)))
                  .rigid()
                  .center()
                  .gap(view::Live::Is(1.5))

                  let bar_color = fn() -> Int64 {
                    let mp = get_mp()
                    if mp.muted {
                      chrome_palette().ink_muted
                    } else if mp.is_live {
                      0x10B981FFL
                    } else if !mp.playing {
                      0xF59E0BFFL
                    } else {
                      mp.accent_color()
                    }
                  }
                  let bar_h = fn(h_play : Double, h_idle : Double) -> Option[Double] {
                    let mp = get_mp()
                    Some(if (mp.playing || mp.is_live) && !mp.muted { h_play } else { h_idle })
                  }
                  let _ = wave.box(
                    fn(b1 : view::View) -> Unit {
                      let _ = b1
                      .width(view::Live::Is(Some(2.2)))
                      .height(view::Live::By(fn() -> Option[Double] { bar_h(6.0, 4.0) }))
                      .rigid()
                      .radius(view::Live::Is(1.1))
                      .ground(view::Live::By(bar_color))
                    },
                  )
                  let _ = wave.box(
                    fn(b2 : view::View) -> Unit {
                      let _ = b2
                      .width(view::Live::Is(Some(2.2)))
                      .height(view::Live::By(fn() -> Option[Double] { bar_h(11.0, 5.0) }))
                      .rigid()
                      .radius(view::Live::Is(1.1))
                      .ground(view::Live::By(bar_color))
                    },
                  )
                  let _ = wave.box(
                    fn(b3 : view::View) -> Unit {
                      let _ = b3
                      .width(view::Live::Is(Some(2.2)))
                      .height(view::Live::By(fn() -> Option[Double] { bar_h(8.0, 4.0) }))
                      .rigid()
                      .radius(view::Live::Is(1.1))
                      .ground(view::Live::By(bar_color))
                    },
                  )
                },
              )

              // Single-line bounded title (graceful clip, never overflows)
              let _ = top_row.box(
                fn(tw : view::View) -> Unit {
                  let _ = tw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words(
                    view::Live::By(fn() -> String { get_mp().title }),
                    ink=0x1D1D1FFFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                    one_line=true,
                  )
                  .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_primary }))
                },
              )

              // One-click Jump button
              let _ = headless::button(
                top_row,
                fn() -> String { "Jump to Playing Tab" },
                fn(_v : view::View) -> Unit {
                  match get_mp().jump_to_tab() {
                    Some(tid) => dispatch_tab_switch(tid)
                    None => ()
                  }
                },
                fn(jb : view::View, jbtn : headless::Button) -> Unit {
                  let _ = jb
                  .height(view::Live::Is(Some(19.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if jbtn.pressed() {
                      p.btn_press
                    } else if jbtn.hovered() {
                      p.accent_soft_bg
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if jbtn.hovered() { (1.0, p.accent_soft_border) } else { (1.0, p.border) }
                  }))
                  let _ = jb.box(
                    fn(jl : view::View) -> Unit {
                      let _ = jl
                      .words(
                        view::Live::Is("Jump ↗"),
                        ink=0x3A4152FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if jbtn.hovered() { p.accent_soft_ink } else { p.ink_secondary }
                      }))
                    },
                  )
                },
              )
            },
          )

          // Row 1b: Compact source domain capsule + status badge (single-line, zero overflow)
          let _ = card.box(
            fn(sub_row : view::View) -> Unit {
              let _ = sub_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .gap(view::Live::Is(5.0))

              // Source domain capsule
              let _ = sub_row.box(
                fn(dom_pill : view::View) -> Unit {
                  let _ = dom_pill
                  .height(view::Live::Is(Some(17.0)))
                  .max_width(view::Live::Is(Some(138.0)))
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .center()
                  .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                  .radius(view::Live::Is(5.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().hairline) }))
                  let _ = dom_pill.box(
                    fn(dl : view::View) -> Unit {
                      let _ = dl
                      .min_width(view::Live::Is(Some(0.0)))
                      .clips(view::Live::Is(true))
                      .words(
                        view::Live::By(fn() -> String { get_mp().domain }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 500, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                    },
                  )
                },
              )

              // Spacer pushes status time/LIVE badge to the right
              let _ = sub_row.box(
                fn(sp : view::View) -> Unit {
                  let _ = sp.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
                },
              )

              // Compact status / elapsed pill
              let _ = sub_row.box(
                fn(st_pill : view::View) -> Unit {
                  let _ = st_pill
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(16.0)))
                  .rigid()
                  .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                  .gap(view::Live::Is(3.0))
                  .radius(view::Live::Is(5.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let mp = get_mp()
                    let (bg, _, _) = mh_pill_colors(is_dark_chrome(), mp.muted, mp.is_live, mp.playing)
                    bg
                  }))
                  let _ = st_pill.box(
                    fn(sl : view::View) -> Unit {
                      let _ = sl
                      .words(
                        view::Live::By(fn() -> String { get_mp().status_label() }),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 8.5, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let mp = get_mp()
                        let (_, _, ink) = mh_pill_colors(is_dark_chrome(), mp.muted, mp.is_live, mp.playing)
                        ink
                      }))
                    },
                  )
                },
              )
            },
          )

          // Row 2: Thin 2.5pt progress track + Play/Pause, Mute/Unmute, Dismiss circular controls
          let _ = card.box(
            fn(bot_row : view::View) -> Unit {
              let _ = bot_row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(24.0)))
              .rigid()
              .gap(view::Live::Is(6.0))

              // Refined 2.5pt progress track + proportional fill
              let _ = bot_row.box(
                fn(track : view::View) -> Unit {
                  let _ = track
                  .row(view::Live::Is(true))
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(40.0)))
                  .height(view::Live::Is(Some(2.5)))
                  .radius(view::Live::Is(1.25))
                  .clips(view::Live::Is(true))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                  let _ = track.box(
                    fn(fill : view::View) -> Unit {
                      let _ = fill
                      .width(view::Live::By(fn() -> Option[Double] {
                        let mp = get_mp()
                        let r = mp.progress_ratio()
                        let px = r * 114.0
                        Some(if px < 4.0 && (mp.playing || mp.is_live) { 14.0 } else { px })
                      }))
                      .height(view::Live::Is(Some(2.5)))
                      .rigid()
                      .radius(view::Live::Is(1.25))
                      .ground(view::Live::By(fn() -> Int64 {
                        let mp = get_mp()
                        if mp.muted {
                          chrome_palette().ink_muted
                        } else if mp.is_live {
                          0x10B981FFL
                        } else if !mp.playing {
                          0xF59E0BFFL
                        } else {
                          mp.accent_color()
                        }
                      }))
                    },
                  )
                },
              )

              // Play / Pause circular control button (22x22, radius 11)
              let _ = headless::button(
                bot_row,
                fn() -> String { if get_mp().playing { "Pause" } else { "Play" } },
                fn(_v : view::View) -> Unit {
                  app_state.mini_player_dismissed_tab = ""
                  dispatch_media_toggle_play(get_mp().tab_id)
                },
                fn(pb : view::View, pbtn : headless::Button) -> Unit {
                  let _ = pb
                  .width(view::Live::Is(Some(22.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(11.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if pbtn.pressed() {
                      p.btn_press
                    } else if pbtn.hovered() {
                      p.btn_hover
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                  mh_draw_play_pause_glyph(pb, fn() -> Bool { get_mp().playing })
                },
              )

              // Mute / Unmute circular control button (22x22, radius 11)
              let _ = headless::button(
                bot_row,
                fn() -> String { if get_mp().muted { "Unmute" } else { "Mute" } },
                fn(_v : view::View) -> Unit {
                  dispatch_media_toggle_mute(get_mp().tab_id)
                },
                fn(mb : view::View, mbtn : headless::Button) -> Unit {
                  let _ = mb
                  .width(view::Live::Is(Some(22.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(11.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if mbtn.pressed() {
                      p.btn_press
                    } else if mbtn.hovered() {
                      p.btn_hover
                    } else if get_mp().muted {
                      p.danger_bg
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if get_mp().muted { (1.0, p.danger_border) } else { (1.0, p.border) }
                  }))
                  mh_draw_mute_glyph(mb, fn() -> Bool { get_mp().muted })
                },
              )

              // Close / Dismiss circular control button (22x22, radius 11)
              let _ = headless::button(
                bot_row,
                fn() -> String { "Dismiss Mini Player" },
                fn(_v : view::View) -> Unit {
                  dismiss_shell_mini_player(get_mp().tab_id)
                },
                fn(xb : view::View, xbtn : headless::Button) -> Unit {
                  let _ = xb
                  .width(view::Live::Is(Some(22.0)))
                  .height(view::Live::Is(Some(22.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(11.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let p = chrome_palette()
                    if xbtn.pressed() {
                      p.danger_border
                    } else if xbtn.hovered() {
                      p.danger_bg
                    } else {
                      p.surface_subtle
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    let p = chrome_palette()
                    if xbtn.hovered() { (1.0, p.danger_border) } else { (1.0, p.border) }
                  }))
                  let _ = xb.box(
                    fn(xl : view::View) -> Unit {
                      let _ = xl
                      .words(
                        view::Live::Is("×"),
                        ink=0x6B7280FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 600, wrap: false },
                        one_line=true,
                      )
                      .ink(view::Live::By(fn() -> Int64 {
                        let p = chrome_palette()
                        if xbtn.hovered() || xbtn.pressed() { p.danger } else { p.ink_secondary }
                      }))
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}

// ============================================================================
// 2. Chrome / Arc Rich-Categorized Omnibox Dropdown (`OmniSuggestState`)
// ============================================================================

fn execute_omni_suggest_item(st : stage::Stage, item : proto::OmniSuggestItem) -> Unit {
  if item.category is proto::OmniSuggestCategory::Calc {
    let copy_v = item.url.trim()
    close_omnibox()
    match app_state.address_field {
      Some(addr) => addr.let_go()
      None => ()
    }
    if copy_v != "" {
      write_os_clipboard(copy_v)
      show_toast("Copied " + copy_v, "copy")
    }
    return
  }
  let target = item.url.trim()
  let is_switch = item.category is proto::OmniSuggestCategory::SwitchTab
  let tab_id = item.tab_id
  close_omnibox()
  match app_state.address_field {
    Some(addr) => {
      if target != "" {
        app_state.syncing_address_url = true
        addr.set(target)
        app_state.syncing_address_url = false
      }
      addr.let_go()
    }
    None => ()
  }
  if is_switch {
    if tab_id != "" {
      dispatch_tab_switch(tab_id)
      return
    }
    match find_open_tab_id_for_url(target) {
      Some(tid) => {
        dispatch_tab_switch(tid)
        return
      }
      None => ()
    }
  }
  if target != "" {
    st.go(target)
  }
}

fn os_cat_badge_colors(cat : proto::OmniSuggestCategory, dark : Bool, sel : Bool) -> (Int64, Int64, Int64) {
  match cat {
    proto::OmniSuggestCategory::Calc =>
    if dark {
      (if sel { 0x114034FFL } else { 0x0F3329FFL }, 0x10B98166L, 0x34D399FFL)
    } else {
      (if sel { 0xA7F3D0FFL } else { 0xD1FAE5FFL }, 0x6EE7B7FFL, 0x047857FFL)
    }
    proto::OmniSuggestCategory::SiteSearch =>
    if dark {
      (if sel { 0x2B2C5AFFL } else { 0x222344FFL }, 0x6366F166L, 0xA5B4FCFFL)
    } else {
      (if sel { 0xC7D2FEFFL } else { 0xEEF2FFFFL }, 0xA5B4FCFFL, 0x4338CAFFL)
    }
    proto::OmniSuggestCategory::SwitchTab =>
    if dark {
      (if sel { 0x1E3A5FFFL } else { 0x1A2E4BFFL }, 0x2F4B78FFL, 0x93C5FDFFL)
    } else {
      (if sel { 0xBFDBFEFFL } else { 0xDBEAFEFFL }, 0x93C5FDFFL, 0x1D4ED8FFL)
    }
    proto::OmniSuggestCategory::Bookmark =>
    if dark {
      (if sel { 0x423012FFL } else { 0x332510FFL }, 0x6B4F1DFFL, 0xFBBF24FFL)
    } else {
      (if sel { 0xFDE68AFFL } else { 0xFEF3C7FFL }, 0xFCD34DFFL, 0xB45309FFL)
    }
    proto::OmniSuggestCategory::History =>
    if dark {
      (if sel { 0x2C3344FFL } else { 0x242936FFL }, 0x3A4154FFL, 0xCBD5E1FFL)
    } else {
      (if sel { 0xE2E8F0FFL } else { 0xF1F5F9FFL }, 0xCBD5E1FFL, 0x475569FFL)
    }
    proto::OmniSuggestCategory::DirectUrl =>
    if dark {
      (if sel { 0x133B2CFFL } else { 0x102E23FFL }, 0x1B5E4AFFL, 0x34D399FFL)
    } else {
      (if sel { 0xA7F3D0FFL } else { 0xD1FAE5FFL }, 0x6EE7B7FFL, 0x047857FFL)
    }
    proto::OmniSuggestCategory::Search =>
    if dark {
      (if sel { 0x282952FFL } else { 0x222344FFL }, 0x3D4073FFL, 0xA5B4FCFFL)
    } else {
      (if sel { 0xC7D2FEFFL } else { 0xEEF2FFFFL }, 0xC7D2FEFFL, 0x4338CAFFL)
    }
  }
}

fn os_cat_glyph(cat : proto::OmniSuggestCategory) -> String {
  match cat {
    proto::OmniSuggestCategory::Calc => "="
    proto::OmniSuggestCategory::SiteSearch => "@"
    proto::OmniSuggestCategory::SwitchTab => "⇄"
    proto::OmniSuggestCategory::Bookmark => "★"
    proto::OmniSuggestCategory::History => "↺"
    proto::OmniSuggestCategory::DirectUrl => "→"
    proto::OmniSuggestCategory::Search => "G"
  }
}

///| Builds the Chrome / Arc rich-categorized Omnibox suggestions dropdown overlay.
///| Strictly above page content layer and wired into `close_all_overlays()`.
fn build_omni_suggest_overlay(
  root : view::View,
  address : ui::Field,
  omnibox_open : signals::Signal[Bool],
  omnibox_selected : signals::Signal[Int],
  omnibox_rev : signals::Signal[Int],
) -> Unit {
  root.show(
    fn() -> Bool {
      let _ = omnibox_rev.get()
      omnibox_open.get() && app_state.omni_suggest_items.length() > 0
    },
    fn(overlay : view::View) -> Unit {
      app_state.omnibox_row_views.clear()
      let _ = overlay
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        match app_state.address_bar_view {
          Some(ab) => {
            let (ax, ay, aw, ah) = ab.placed_now()
            if aw > 120.0 {
              (Some(ax), Some(ay + ah + 6.0), None, None)
            } else {
              (Some(156.0), Some(48.0), Some(46.0), None)
            }
          }
          None => (Some(156.0), Some(48.0), Some(46.0), None)
        }
      }))
      .width(view::Live::By(fn() -> Option[Double] {
        match app_state.address_bar_view {
          Some(ab) => {
            let (_, _, aw, _) = ab.placed_now()
            if aw > 120.0 { Some(aw) } else { None }
          }
          None => None
        }
      }))
      .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
      .gap(view::Live::Is(2.0))
      .radius(view::Live::Is(12.0))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 {
        let p = chrome_palette()
        if p.is_dark { 0x1A1D26FCL } else { 0xFFFFFFFCL }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
      .shadow(view::Live::By(fn() -> (Double, Double, Int64) {
        if is_dark_chrome() { (24.0, 10.0, 0x00000066L) } else { (20.0, 8.0, 0x0F172A24L) }
      }))

      // Top keyboard hint bar (no divider below, clean rhythm)
      let _ = overlay.box(
        fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(22.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(8.0))
          let _ = hdr.box(
            fn(hl : view::View) -> Unit {
              let _ = hl
              .grow(view::Live::Is(1.0))
              .words(
                view::Live::Is("Smart Suggestions"),
                ink=0x8E8E93FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )
          let _ = hdr.box(
            fn(hr : view::View) -> Unit {
              let _ = hr
              .words(
                view::Live::Is("↑↓ Navigate   ↵ Open   Esc Close"),
                ink=0xAEAEB2FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )
        },
      )

      // Up to 6 rich-categorized rows with dynamic section headers (zero empty groups, zero double dividers)
      let mut slot = 0
      while slot < proto::OMNI_SUGGEST_MAX_ITEMS {
        let idx = slot
        overlay.show(
          fn() -> Bool {
            let _ = omnibox_rev.get()
            idx < app_state.omni_suggest_items.length()
          },
          fn(row_wrap : view::View) -> Unit {
            let get_item = fn() -> Option[proto::OmniSuggestItem] {
              let _ = omnibox_rev.get()
              let list = app_state.omni_suggest_items
              if idx < list.length() { Some(list[idx]) } else { None }
            }

            // Conditional category section header
            row_wrap.show(
              fn() -> Bool {
                let _ = omnibox_rev.get()
                proto::omni_suggest_section_header(app_state.omni_suggest_items, idx).is_some()
              },
              fn(sec : view::View) -> Unit {
                let _ = sec
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(18.0)))
                .rigid()
                .padding(view::Live::Is((10.0, if idx == 0 { 0.0 } else { 3.0 }, 10.0, 0.0)))
                let _ = sec.box(
                  fn(sl : view::View) -> Unit {
                    let _ = sl
                    .words(
                      view::Live::By(fn() -> String {
                        let _ = omnibox_rev.get()
                        match proto::omni_suggest_section_header(app_state.omni_suggest_items, idx) {
                          Some(h) => h
                          None => ""
                        }
                      }),
                      ink=0x6B7280FFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                  },
                )
              },
            )

            let item_label = fn() -> String {
              match get_item() {
                Some(it) => it.title
                None => ""
              }
            }

            let _ = headless::button(
              row_wrap,
              item_label,
              fn(_v : view::View) -> Unit {
                let list = app_state.omni_suggest_items
                if idx < list.length() {
                  execute_omni_suggest_item(active_stage(), list[idx])
                }
              },
              fn(b : view::View, btn : headless::Button) -> Unit {
                app_state.omnibox_row_views.push(b)
                b.reacts(fn() -> Bool { btn.pressed() }, fn(is_pressed : Bool) -> Unit {
                  if !is_pressed &&
                  !address.focused() &&
                  omnibox_open.untracked() &&
                  app_state.demo_omnibox == "" &&
                  !app_state.demo_shell_dock_light &&
                  !any_omnibox_row_pressed() {
                    close_omnibox()
                  }
                })
                let is_sel = fn() -> Bool { omnibox_selected.get() == idx }
                let _ = b
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(40.0)))
                .rigid()
                .clips(view::Live::Is(true))
                .gap(view::Live::Is(10.0))
                .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                .radius(view::Live::Is(6.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if btn.pressed() {
                    p.btn_press
                  } else if is_sel() {
                    p.accent_soft_bg
                  } else if btn.hovered() {
                    p.tab_hover_bg
                  } else {
                    0x00000000L
                  }
                }))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  if is_sel() { (1.0, chrome_palette().accent_soft_border) } else { (1.0, 0x00000000L) }
                }))

                // Left category icon badge (26x26, radius 6pt)
                let _ = b.box(
                  fn(ico : view::View) -> Unit {
                    let _ = ico
                    .width(view::Live::Is(Some(26.0)))
                    .height(view::Live::Is(Some(26.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      match get_item() {
                        Some(it) => {
                          let (bg, _, _) = os_cat_badge_colors(it.category, is_dark_chrome(), is_sel())
                          bg
                        }
                        None => chrome_palette().surface_subtle
                      }
                    }))
                    let _ = ico.box(
                      fn(ch : view::View) -> Unit {
                        let _ = ch
                        .words(
                          view::Live::By(fn() -> String {
                            match get_item() {
                              Some(it) => os_cat_glyph(it.category)
                              None => ""
                            }
                          }),
                          ink=0x3A3A44FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          match get_item() {
                            Some(it) => {
                              let (_, _, ink) = os_cat_badge_colors(it.category, is_dark_chrome(), is_sel())
                              ink
                            }
                            None => chrome_palette().ink_secondary
                          }
                        }))
                      },
                    )
                  },
                )

                // Middle column: title + subtitle (bounded, zero overflow at narrow width)
                let _ = b.box(
                  fn(mid : view::View) -> Unit {
                    let _ = mid
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .clips(view::Live::Is(true))
                    .gap(view::Live::Is(1.0))
                    let _ = mid.box(
                      fn(tw : view::View) -> Unit {
                        let _ = tw
                        .min_width(view::Live::Is(Some(0.0)))
                        .clips(view::Live::Is(true))
                        .words(
                          view::Live::By(item_label),
                          ink=0x1D1D1FFFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 12.5, weight: 500, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_sel() { p.accent_soft_ink } else { p.ink_primary }
                        }))
                      },
                    )
                    let _ = mid.box(
                      fn(sub : view::View) -> Unit {
                        let _ = sub
                        .min_width(view::Live::Is(Some(0.0)))
                        .clips(view::Live::Is(true))
                        .words(
                          view::Live::By(fn() -> String {
                            match get_item() {
                              Some(it) => it.subtitle
                              None => ""
                            }
                          }),
                          ink=0x6B7280FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_sel() { p.accent } else { p.ink_muted }
                        }))
                      },
                    )
                  },
                )

                // Right fixed-aligned metadata & action capsule (never wraps)
                let _ = b.box(
                  fn(meta : view::View) -> Unit {
                    let _ = meta
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .rigid()
                    .gap(view::Live::Is(6.0))

                    // Optional visits badge for History items
                    meta.show(
                      fn() -> Bool {
                        match get_item() {
                          Some(it) => (it.category is proto::OmniSuggestCategory::History) && it.visits > 0
                          None => false
                        }
                      },
                      fn(vb : view::View) -> Unit {
                        let _ = vb
                        .height(view::Live::Is(Some(20.0)))
                        .rigid()
                        .center()
                        .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                        .radius(view::Live::Is(5.0))
                        .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                        let _ = vb.box(
                          fn(vl : view::View) -> Unit {
                            let _ = vl
                            .words(
                              view::Live::By(fn() -> String {
                                match get_item() {
                                  Some(it) => proto::omnibox_format_visits(it.visits)
                                  None => ""
                                }
                              }),
                              ink=0x6B7280FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                          },
                        )
                      },
                    )

                    // Primary right-side category capsule ("Switch to Tab ↵", "Bookmark", "History", "Copy Result ↵", ...)
                    let _ = meta.box(
                      fn(kp : view::View) -> Unit {
                        let _ = kp
                        .height(view::Live::Is(Some(22.0)))
                        .rigid()
                        .center()
                        .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                        .radius(view::Live::Is(6.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          match get_item() {
                            Some(it) => {
                              let (bg, _, _) = os_cat_badge_colors(it.category, is_dark_chrome(), false)
                              bg
                            }
                            None => chrome_palette().surface_subtle
                          }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          match get_item() {
                            Some(it) => {
                              let (_, bd, _) = os_cat_badge_colors(it.category, is_dark_chrome(), false)
                              (1.0, bd)
                            }
                            None => (1.0, 0x00000000L)
                          }
                        }))
                        let _ = kp.box(
                          fn(kl : view::View) -> Unit {
                            let _ = kl
                            .words(
                              view::Live::By(fn() -> String {
                                match get_item() {
                                  Some(it) => match it.category {
                                    proto::OmniSuggestCategory::SwitchTab => "Switch to Tab ↵"
                                    proto::OmniSuggestCategory::Calc => "Copy Result ↵"
                                    proto::OmniSuggestCategory::SiteSearch => it.badge_label + " ↵"
                                    _ => it.badge_label
                                  }
                                  None => ""
                                }
                              }),
                              ink=0x475569FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              match get_item() {
                                Some(it) => {
                                  let (_, _, ink) = os_cat_badge_colors(it.category, is_dark_chrome(), false)
                                  ink
                                }
                                None => chrome_palette().ink_secondary
                              }
                            }))
                          },
                        )
                      },
                    )
                  },
                )
              },
            )
          },
        )
        slot = slot + 1
      }
    },
  )
}

// ============================================================================
// 3. Arc Split View Ultra-Thin Top Focus & Quick-Switch Micro-Toolbar (`SplitBarState`)
// ============================================================================

///| Builds the `28pt` ultra-thin Split View focus & quick-switch micro-toolbar above the split
///| content area. Mounted ONLY when `split_open` is true, with a single `1pt` bottom hairline.
fn build_split_focus_bar(
  content_col : view::View,
  st : stage::Stage,
  split_open : signals::Signal[Bool],
  split_active_pane : signals::Signal[Int],
  split_swapped : signals::Signal[Bool],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let get_sb = fn() -> proto::SplitBarState {
    let _ = workspace_rev.get()
    let open = split_open.get()
    let active_pane = split_active_pane.get()
    let swapped = split_swapped.get()
    let primary_url = st.url()
    let secondary_url = match app_state.split_stage {
      Some(sp) => if sp.url() != "" { sp.url() } else { app_state.split_pending_url }
      None => app_state.split_pending_url
    }
    proto::SplitBarState::from_panes(open, primary_url, secondary_url, active_pane, swapped)
  }

  content_col.show(
    fn() -> Bool { split_open.get() },
    fn(bar_wrap : view::View) -> Unit {
      let _ = bar_wrap.rigid()

      let _ = bar_wrap.box(
        fn(bar : view::View) -> Unit {
          let _ = bar
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(28.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))

          // Helper for left/right pane focus domain pill
          let render_side_pill = fn(visual_side : Int) -> Unit {
            let is_focused = fn() -> Bool { get_sb().focused_pane == visual_side }
            let domain_fn = fn() -> String {
              let sb = get_sb()
              if visual_side == 0 { sb.left_domain } else { sb.right_domain }
            }
            let _ = headless::button(
              bar,
              domain_fn,
              fn(_v : view::View) -> Unit {
                let target_logical = get_sb().logical_pane_for_side(visual_side)
                set_active_split_pane(target_logical)
              },
              fn(pb : view::View, pbtn : headless::Button) -> Unit {
                let _ = pb
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(20.0)))
                .max_width(view::Live::Is(Some(210.0)))
                .shrink(view::Live::Is(1.0))
                .min_width(view::Live::Is(Some(0.0)))
                .clips(view::Live::Is(true))
                .padding(view::Live::Is((7.0, 0.0, 8.0, 0.0)))
                .gap(view::Live::Is(6.0))
                .radius(view::Live::Is(6.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if pbtn.pressed() {
                    p.btn_press
                  } else if is_focused() {
                    p.accent_soft_bg
                  } else if pbtn.hovered() {
                    p.tab_hover_bg
                  } else {
                    0x00000000L
                  }
                }))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  let p = chrome_palette()
                  if is_focused() { (1.0, p.accent_soft_border) } else { (1.0, 0x00000000L) }
                }))

                // Active focus blue dot indicator
                let _ = pb.box(
                  fn(dot : view::View) -> Unit {
                    let _ = dot
                    .width(view::Live::Is(Some(6.0)))
                    .height(view::Live::Is(Some(6.0)))
                    .rigid()
                    .radius(view::Live::Is(3.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_focused() { p.accent } else { p.border }
                    }))
                  },
                )

                // Concise source domain
                let _ = pb.box(
                  fn(dl : view::View) -> Unit {
                    let _ = dl
                    .min_width(view::Live::Is(Some(0.0)))
                    .clips(view::Live::Is(true))
                    .words(
                      view::Live::By(domain_fn),
                      ink=0x1D1D1FFFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_focused() { p.accent_soft_ink } else { p.ink_muted }
                    }))
                  },
                )
              },
            )
          }

          render_side_pill(0)
          let _ = bar.box(
            fn(sl : view::View) -> Unit {
              let _ = sl
              .rigid()
              .words(
                view::Live::Is("/"),
                ink=0x94A3B8FFL,
                look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                one_line=true,
              )
              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
            },
          )
          render_side_pill(1)

          // Flexible spacer pushes quick-switch actions to the right
          let _ = bar.box(
            fn(sp : view::View) -> Unit {
              let _ = sp.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
            },
          )

          // Right quick-switch action capsules: Swap ⇄, Solo, Close Split
          let split_action_pill = fn(text : String, danger : Bool, on_click : () -> Unit) -> Unit {
            let _ = headless::button(
              bar,
              fn() -> String { text },
              fn(_v : view::View) -> Unit { on_click() },
              fn(ab : view::View, abtn : headless::Button) -> Unit {
                let _ = ab
                .height(view::Live::Is(Some(20.0)))
                .rigid()
                .center()
                .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                .radius(view::Live::Is(5.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if danger {
                    if abtn.pressed() {
                      p.danger_border
                    } else if abtn.hovered() {
                      p.danger_bg
                    } else {
                      p.surface_subtle
                    }
                  } else if abtn.pressed() {
                    p.btn_press
                  } else if abtn.hovered() {
                    p.btn_hover
                  } else {
                    p.surface_subtle
                  }
                }))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  let p = chrome_palette()
                  if danger && (abtn.hovered() || abtn.pressed()) {
                    (1.0, p.danger_border)
                  } else {
                    (1.0, p.border)
                  }
                }))
                let _ = ab.box(
                  fn(al : view::View) -> Unit {
                    let _ = al
                    .words(
                      view::Live::Is(text),
                      ink=0x3A4152FFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if danger && (abtn.hovered() || abtn.pressed()) {
                        p.danger
                      } else if abtn.hovered() || abtn.pressed() {
                        p.ink_primary
                      } else {
                        p.ink_secondary
                      }
                    }))
                  },
                )
              },
            )
          }

          split_action_pill("Swap ⇄", false, fn() -> Unit { swap_split_panes() })
          split_action_pill("Solo", false, fn() -> Unit {
            expand_split_pane(split_active_pane.untracked())
          })
          split_action_pill("Close Split", true, fn() -> Unit { close_split_view() })
        },
      )

      // Strictly single 1pt hairline bottom divider
      let _ = bar_wrap.box(
        fn(line : view::View) -> Unit {
          let _ = line
          .height(view::Live::Is(Some(1.0)))
          .rigid()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
        },
      )
    },
  )
}

// ============================================================================
// 4. Clean Demo Seed Helpers (strictly clean https:// URLs for Metal snapshots)
// ============================================================================

fn ensure_demo_shell_dock_light_seeded() -> Unit {
  app_state.mini_player_dismissed_tab = ""
  app_state.workspace = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "sp-work",
    active_tab_id: "tab-docs",
    spaces: [
      proto::SpaceSummary::{ id: "sp-work", name: "Work", accent: "#2563EB", active: true, tab_count: 4 },
      proto::SpaceSummary::{ id: "sp-research", name: "Research", accent: "#10B981", active: false, tab_count: 2 },
      proto::SpaceSummary::{ id: "sp-media", name: "Media", accent: "#8B5CF6", active: false, tab_count: 1 },
    ],
    folders: [],
    tabs: [
      proto::TabSummary::{
        id: "tab-docs",
        space_id: "sp-work",
        title: "Farview Architecture",
        url: "https://example.org/farview/architecture",
        pinned: true,
        favorite: true,
        active: true,
        state: "active",
        folder_id: "",
        last_active_secs: 1700000300L,
      },
      proto::TabSummary::{
        id: "tab-gh",
        space_id: "sp-work",
        title: "GitHub — AFK-surf/farview",
        url: "https://github.com/AFK-surf/farview",
        pinned: true,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 1700000280L,
      },
      proto::TabSummary::{
        id: "tab-music",
        space_id: "sp-work",
        title: "Ambient Focus Synth — Live Radio",
        url: "https://music.youtube.com/watch?v=ambient247",
        pinned: false,
        favorite: false,
        active: false,
        state: "active",
        folder_id: "",
        last_active_secs: 1700000260L,
      },
      proto::TabSummary::{
        id: "tab-mdn",
        space_id: "sp-work",
        title: "MDN Web Docs — CSS Layout",
        url: "https://developer.mozilla.org/en-US/docs/Web/CSS",
        pinned: false,
