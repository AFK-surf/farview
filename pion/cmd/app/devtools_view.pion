///| Native Metal DevTools Drawer (`Cmd+Opt+I` / `Ctrl+Shift+I` / `F12`):
///| - Draggable 6pt top resize handle (`180..480pt`) with real-time Stage height resize
///| - Elements: syntax-highlighted monospace DOM tree + 260pt Box Model & Computed Styles Inspector
///| - Console: live V8 console.log/info/warn/error stream + level filters + interactive REPL
///| - Network: real main document & subresource requests table + summary bar

fn build_devtools_drawer(
  parent : view::View,
  devtools_open : signals::Signal[Bool],
  devtools_height : signals::Signal[Double],
  devtools_dragging : signals::Signal[Bool],
  devtools_tab : signals::Signal[Int],
  devtools_rev : signals::Signal[Int],
  devtools_selected_path : signals::Signal[String],
  devtools_console_filter : signals::Signal[Int],
  devtools_repl_field : ui::Field,
  devtools_net_filter : signals::Signal[String],
  devtools_net_query : signals::Signal[String],
  devtools_net_search_field : ui::Field,
  devtools_net_selected_idx : signals::Signal[Int],
  workspace_rev : signals::Signal[Int],
) -> Unit {
  let active_space_color = fn() -> Int64 {
    let _ = workspace_rev.get()
    match proto::workspace_active_space(app_state.workspace) {
      Some(sp) => proto::workspace_accent_color(sp.accent)
      None => 0x4F46E5FFL
    }
  }

  parent.show(
    fn() -> Bool { devtools_open.get() },
    fn(drawer : view::View) -> Unit {
      let _ = drawer
      .height(view::Live::By(fn() -> Option[Double] { Some(devtools_height.get()) }))
      .rigid()
      .min_width(view::Live::Is(Some(0.0)))
      .min_height(view::Live::Is(Some(proto::DEVTOOLS_HEIGHT_MIN)))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))

      // 1. Draggable 6pt top resize handle (single 1pt hairline, accent pill on hover/drag)
      let _ = drawer.box(
        fn(handle : view::View) -> Unit {
          let is_hot = fn() -> Bool { devtools_dragging.get() || handle.pointed() }
          let _ = handle
          .height(view::Live::Is(Some(proto::DEVTOOLS_DIVIDER_HEIGHT)))
          .rigid()
          .center()
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))
          .cursor(view::Live::Is(Some(view::Cursor::ResizeY)))
          .on_drag(
            fn(d : view::Drag) -> Unit {
              match d.kind {
                view::DragIs::Down => {
                  app_state.devtools_drag_start_wy = d.wy
                  app_state.devtools_drag_start_h = devtools_height.untracked()
                  devtools_dragging.set(true)
                }
                view::DragIs::Moved => {
                  if devtools_dragging.untracked() {
                    let dy = d.wy - app_state.devtools_drag_start_wy
                    devtools_height.set(proto::devtools_height_from_drag(app_state.devtools_drag_start_h, dy))
                  }
                }
                view::DragIs::Up | view::DragIs::Off => {
                  devtools_dragging.set(false)
                }
              }
            },
            captures=true,
          )
          let _ = handle.box(
            fn(line : view::View) -> Unit {
              let _ = line
              .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), None)))
              .height(view::Live::By(fn() -> Option[Double] {
                if is_hot() { Some(2.0) } else { Some(1.0) }
              }))
              .ground(view::Live::By(fn() -> Int64 {
                if is_hot() { active_space_color() } else { chrome_palette().border }
              }))
            },
          )
          let _ = handle.box(
            fn(pill : view::View) -> Unit {
              let _ = pill
              .width(view::Live::Is(Some(32.0)))
              .height(view::Live::Is(Some(3.0)))
              .rigid()
              .radius(view::Live::Is(1.5))
              .ground(view::Live::By(fn() -> Int64 {
                if is_hot() { active_space_color() } else { chrome_palette().border }
              }))
            },
          )
        },
      )

      // 2. Compact 32pt DevTools Tab Header Bar
      let _ = drawer.box(
        fn(bar : view::View) -> Unit {
          let _ = bar
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(32.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(4.0))
          .ground(view::Live::By(fn() -> Int64 { chrome_palette().toolbar_bg }))

          let tab_btn = fn(idx : Int, label : String, badge_fn : () -> String) -> Unit {
            let is_active = fn() -> Bool { devtools_tab.get() == idx }
            let _ = headless::button(
              bar,
              fn() -> String { label },
              fn(_v : view::View) -> Unit {
                devtools_tab.set(idx)
                dispatch_devtools_inspect(devtools_selected_path.untracked())
              },
              fn(tb : view::View, tbtn : headless::Button) -> Unit {
                let _ = tb
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(24.0)))
                .rigid()
                .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                .gap(view::Live::Is(5.0))
                .radius(view::Live::Is(6.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if is_active() {
                    p.tab_active_bg
                  } else if tbtn.pressed() {
                    p.btn_press
                  } else if tbtn.hovered() {
                    p.btn_hover
                  } else {
                    0x00000000L
                  }
                }))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  let p = chrome_palette()
                  if is_active() { (1.0, p.tab_active_border) } else { (0.0, 0x00000000L) }
                }))
                let _ = tb.box(
                  fn(tl : view::View) -> Unit {
                    let _ = tl
                    .words(
                      view::Live::Is(label),
                      ink=0x1D1D1FFFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_active() { p.accent } else { p.ink_secondary }
                    }))
                  },
                )
                tb.show(
                  fn() -> Bool { badge_fn() != "" },
                  fn(bg : view::View) -> Unit {
                    let _ = bg
                    .height(view::Live::Is(Some(16.0)))
                    .rigid()
                    .center()
                    .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                    .radius(view::Live::Is(8.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if is_active() { p.accent_soft_bg } else { p.btn_bg }
                    }))
                    let _ = bg.box(
                      fn(bl : view::View) -> Unit {
                        let _ = bl
                        .words(
                          view::Live::By(badge_fn),
                          ink=0x475569FFL,
                          look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                          one_line=true,
                        )
                        .ink(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_active() { p.accent_soft_ink } else { p.ink_secondary }
                        }))
                      },
                    )
                  },
                )
              },
            )
          }

          tab_btn(0, "Elements", fn() -> String { "" })
          tab_btn(1, "Console", fn() -> String {
            let _ = devtools_rev.get()
            let n = app_state.devtools_snap.console_entries.length()
            if n > 0 { n.to_string() } else { "" }
          })
          tab_btn(2, "Network", fn() -> String {
            let _ = devtools_rev.get()
            let n = app_state.devtools_snap.network_entries.length()
            if n > 0 { n.to_string() } else { "" }
          })

          // Flexible spacer with subtle inspected page host label
          let _ = bar.box(
            fn(sp : view::View) -> Unit {
              let _ = sp
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
              .clips(view::Live::Is(true))
              let _ = sp.box(
                fn(ul : view::View) -> Unit {
                  let _ = ul
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))
                  .words_runs(
                    view::Live::By(fn() -> Array[text::Run] {
                      let _ = devtools_rev.get()
                      let u = app_state.devtools_snap.page_url
                      let display = if u != "" { proto::omnibox_display_host(u) } else { "" }
                      [dt_mono_run(display, 0x94A3B8FFL)]
                    }),
                    ink=0x94A3B8FFL,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                  )
                },
              )
            },
          )

          // Right action buttons: Refresh, Clear, Close (always visible, never alpha=0)
          let action_btn = fn(text_lbl : String, a11y : String, danger : Bool, on_click : () -> Unit) -> Unit {
            let _ = headless::button(
              bar,
              fn() -> String { a11y },
              fn(_v : view::View) -> Unit { on_click() },
              fn(ab : view::View, abtn : headless::Button) -> Unit {
                let _ = ab
                .height(view::Live::Is(Some(22.0)))
                .rigid()
                .center()
                .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                .radius(view::Live::Is(5.0))
                .ground(view::Live::By(fn() -> Int64 {
                  let p = chrome_palette()
                  if danger {
                    if abtn.pressed() { p.danger_border } else if abtn.hovered() { p.danger_bg } else { 0x00000000L }
                  } else if abtn.pressed() {
                    p.btn_press
                  } else if abtn.hovered() {
                    p.btn_hover
                  } else {
                    0x00000000L
                  }
                }))
                let _ = ab.box(
                  fn(al : view::View) -> Unit {
                    let _ = al
                    .words(
                      view::Live::Is(text_lbl),
                      ink=0x4B5563FFL,
                      look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                      one_line=true,
                    )
                    .ink(view::Live::By(fn() -> Int64 {
                      let p = chrome_palette()
                      if danger && (abtn.hovered() || abtn.pressed()) {
                        p.danger
                      } else if abtn.hovered() || abtn.pressed() {
                        p.ink_primary
                      } else {
                        p.ink_secondary
                      }
                    }))
                  },
                )
              },
            )
          }

          action_btn("↻ Refresh", "Refresh DevTools", false, fn() -> Unit {
            dispatch_devtools_inspect(devtools_selected_path.untracked())
          })
          action_btn("Clear", "Clear Console", false, fn() -> Unit {
            dispatch_devtools_clear()
          })
          action_btn("×", "Close DevTools", true, fn() -> Unit {
            close_devtools()
          })
        },
      )

      // Single 1pt hairline under tab bar
      let _ = drawer.box(
        fn(sep : view::View) -> Unit {
          let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
        },
      )

      // 3. Panel Body Container (bounded flex container so inner scroll_box scrolls cleanly)
      let _ = drawer.box(
        fn(panel_host : view::View) -> Unit {
          let _ = panel_host
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          .clips(view::Live::Is(true))

          // --- TAB 0: ELEMENTS (DOM Tree + 260pt Box Model & Computed Styles) ---
          panel_host.show(
            fn() -> Bool { devtools_tab.get() == 0 },
            fn(el_split : view::View) -> Unit {
              let _ = el_split
              .row(view::Live::Is(true))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))

              // Left: DOM Tree scroller
              let _ = el_split.box(
                fn(tree_pane : view::View) -> Unit {
                  let _ = tree_pane
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(0.0)))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))

                  let _ = ui::scroll_box(
                    tree_pane,
                    fn(tree_list : view::View) -> Unit {
                      let _ = tree_list.padding(view::Live::Is((6.0, 6.0, 6.0, 6.0))).gap(view::Live::Is(1.0))
                      tree_list.switch_by(
                        fn() -> Int { devtools_rev.get() * 2 + (if is_dark_chrome() { 1 } else { 0 }) },
                        fn(nodes_box : view::View, key : Int) -> Unit {
                          let dark = (key % 2) == 1
                          let pal = chrome_palette_for(dark)
                          let _ = nodes_box.gap(view::Live::Is(1.0))
                          let nodes = app_state.devtools_snap.nodes
                          if nodes.length() == 0 {
                            let _ = nodes_box.box(
                              fn(emp : view::View) -> Unit {
                                let _ = emp
                                .padding(view::Live::Is((10.0, 10.0, 10.0, 10.0)))
                                .words_runs(
                                  view::Live::Is([dt_mono_run("Inspecting document DOM...", pal.ink_muted)]),
                                  ink=pal.ink_muted,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: false },
                                )
                              },
                            )
                          }
                          let mut i = 0
                          while i < nodes.length() {
                            let nd = nodes[i]
                            if !dt_is_hidden_by_collapse(nd.path) {
                              let npath = nd.path
                              let is_collapsed = app_state.devtools_collapsed.get(npath).unwrap_or(false)
                              let is_sel = fn() -> Bool { devtools_selected_path.get() == npath }
                              let indent = 6.0 + (nd.depth.to_double() * 14.0)
                              let _ = nodes_box.box(
                                fn(row_outer : view::View) -> Unit {
                                  let _ = row_outer
                                  .row(view::Live::Is(true))
                                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                  .height(view::Live::Is(Some(22.0)))
                                  .rigid()
                                  .radius(view::Live::Is(4.0))
                                  .clips(view::Live::Is(true))
                                  .ground(view::Live::By(fn() -> Int64 {
                                    if is_sel() {
                                      if dark { 0x242D42FFL } else { 0xEEF2FFFFL }
                                    } else {
                                      0x00000000L
                                    }
                                  }))
                                  // Selected left accent bar
                                  let _ = row_outer.box(
                                    fn(sbar : view::View) -> Unit {
                                      let _ = sbar
                                      .width(view::Live::Is(Some(2.0)))
                                      .height(view::Live::Is(Some(16.0)))
                                      .rigid()
                                      .radius(view::Live::Is(1.0))
                                      .ground(view::Live::By(fn() -> Int64 {
                                        if is_sel() { pal.accent } else { 0x00000000L }
                                      }))
                                    },
                                  )
                                  // Indent spacer
                                  let _ = row_outer.box(
                                    fn(ind : view::View) -> Unit {
                                      let _ = ind.width(view::Live::Is(Some(indent))).rigid()
                                    },
                                  )
                                  // Disclosure chevron if element has children
                                  if nd.child_count > 0 {
                                    let _ = headless::button(
                                      row_outer,
                                      fn() -> String { if is_collapsed { "Expand " + nd.tag } else { "Collapse " + nd.tag } },
                                      fn(_v : view::View) -> Unit {
                                        app_state.devtools_collapsed.set(npath, !is_collapsed)
                                        devtools_rev.set(devtools_rev.untracked() + 1)
                                      },
                                      fn(chb : view::View, cbtn : headless::Button) -> Unit {
                                        let _ = chb
                                        .width(view::Live::Is(Some(14.0)))
                                        .height(view::Live::Is(Some(18.0)))
                                        .rigid()
                                        .center()
                                        .radius(view::Live::Is(3.0))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          if cbtn.hovered() { pal.btn_hover } else { 0x00000000L }
                                        }))
                                        let _ = chb.box(
                                          fn(cl : view::View) -> Unit {
                                            let _ = cl.words(
                                              view::Live::Is(if is_collapsed { "▸" } else { "▾" }),
                                              ink=pal.ink_muted,
                                              look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                      },
                                    )
                                  } else {
                                    let _ = row_outer.box(
                                      fn(pad : view::View) -> Unit {
                                        let _ = pad.width(view::Live::Is(Some(14.0))).rigid()
                                      },
                                    )
                                  }
                                  // Clickable syntax-highlighted tag line
                                  let runs = dt_dom_node_runs(nd, is_collapsed, dark)
                                  let _ = headless::button(
                                    row_outer,
                                    fn() -> String { "Inspect <" + nd.tag + ">" },
                                    fn(_v : view::View) -> Unit {
                                      devtools_selected_path.set(npath)
                                      dispatch_devtools_inspect(npath)
                                    },
                                    fn(nb : view::View, nbtn : headless::Button) -> Unit {
                                      let _ = nb
                                      .row(view::Live::Is(true))
                                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                      .grow(view::Live::Is(1.0))
                                      .shrink(view::Live::Is(1.0))
                                      .basis(view::Live::Is(Some(0.0)))
                                      .min_width(view::Live::Is(Some(0.0)))
                                      .height(view::Live::Is(Some(22.0)))
                                      .padding(view::Live::Is((3.0, 0.0, 6.0, 0.0)))
                                      .clips(view::Live::Is(true))
                                      .ground(view::Live::By(fn() -> Int64 {
                                        if !is_sel() && nbtn.hovered() { pal.tab_hover_bg } else { 0x00000000L }
                                      }))
                                      let _ = nb.box(
                                        fn(nl : view::View) -> Unit {
                                          let _ = nl
                                          .shrink(view::Live::Is(1.0))
                                          .min_width(view::Live::Is(Some(0.0)))
                                          .clips(view::Live::Is(true))
                                          .words_runs(
                                            view::Live::Is(runs),
                                            ink=pal.ink_primary,
                                            look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: false },
                                          )
                                        },
                                      )
                                    },
                                  )
                                },
                              )
                            }
                            i = i + 1
                          }
                        },
                      )
                    },
                  )
                },
              )

              // Single 1pt vertical hairline between DOM tree and Inspector
              let _ = el_split.box(
                fn(vsep : view::View) -> Unit {
                  let _ = vsep.width(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
                },
              )

              // Right: 260pt Box Model & Computed Styles Inspector
              let _ = el_split.box(
                fn(insp_pane : view::View) -> Unit {
                  let _ = insp_pane
                  .width(view::Live::Is(Some(proto::DEVTOOLS_INSPECTOR_WIDTH)))
                  .rigid()
                  .min_height(view::Live::Is(Some(0.0)))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

                  let _ = ui::scroll_box(
                    insp_pane,
                    fn(insp_body : view::View) -> Unit {
                      let _ = insp_body.padding(view::Live::Is((12.0, 8.0, 12.0, 14.0))).gap(view::Live::Is(6.0))
                      insp_body.switch_by(
                        fn() -> Int { devtools_rev.get() * 2 + (if is_dark_chrome() { 1 } else { 0 }) },
                        fn(ic : view::View, key : Int) -> Unit {
                          let dark = (key % 2) == 1
                          let pal = chrome_palette_for(dark)
                          let margin_bg = if dark { 0x332815FFL } else { 0xFEF3C7FFL }
                          let margin_bd = if dark { 0xB4530988L } else { 0xF59E0B66L }
                          let margin_ink = if dark { 0xFCD34DFFL } else { 0x92400EFFL }
                          let pad_bg = if dark { 0x112E24FFL } else { 0xDCFCE7FFL }
                          let pad_bd = if dark { 0x10B98177L } else { 0x10B98166L }
                          let pad_ink = if dark { 0x6EE7B7FFL } else { 0x065F46FFL }
                          let content_bg = if dark { 0x1B2B4BFFL } else { 0xDBEAFEFFL }
                          let content_bd = if dark { 0x60A5FA88L } else { 0x3B82F688L }
                          let content_ink = if dark { 0x93C5FDFFL } else { 0x1E3A8AFFL }
                          let prop_ink = if dark { 0xC084FCFFL } else { 0x6D28D9FFL }
                          let val_ink = if dark { 0xE2E8F0FFL } else { 0x0F172AFFL }
                          let _ = ic.gap(view::Live::Is(6.0))
                          let snap = app_state.devtools_snap
                          let bm = snap.box_model

                          // Find selected node label
                          let mut sel_label = ""
                          for nd in snap.nodes {
                            if nd.path == snap.selected_path {
                              sel_label = nd.tag
                              if nd.id_attr != "" {
                                sel_label = sel_label + "#" + nd.id_attr
                              } else if nd.class_attr != "" {
                                let parts = nd.class_attr.split(" ")
                                if parts.length() > 0 && parts[0] != "" {
                                  sel_label = sel_label + "." + parts[0]
                                }
                              }
                              break
                            }
                          }

                          // BOX MODEL section header
                          let _ = ic.box(
                            fn(bhdr : view::View) -> Unit {
                              let _ = bhdr
                              .row(view::Live::Is(true))
                              .lines_up(view::Live::Is(Some(view::Along::Middle)))
                              .gap(view::Live::Is(6.0))
                              let _ = bhdr.box(
                                fn(bt : view::View) -> Unit {
                                  let _ = bt
                                  .grow(view::Live::Is(1.0))
                                  .words(
                                    view::Live::Is("BOX MODEL"),
                                    ink=pal.ink_muted,
                                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                    one_line=true,
                                  )
                                },
                              )
                              if sel_label != "" {
                                let _ = bhdr.box(
                                  fn(sp : view::View) -> Unit {
                                    let _ = sp
                                    .max_width(view::Live::Is(Some(134.0)))
                                    .clips(view::Live::Is(true))
                                    .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                                    .radius(view::Live::Is(4.0))
                                    .ground(view::Live::Is(pal.accent_soft_bg))
                                    let _ = sp.box(
                                      fn(spl : view::View) -> Unit {
                                        let _ = spl.words_runs(
                                          view::Live::Is([dt_mono_run(sel_label, pal.accent_soft_ink, weight=500)]),
                                          ink=pal.accent_soft_ink,
                                          look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 500, wrap: false },
                                        )
                                      },
                                    )
                                  },
                                )
                              }
                            },
                          )

                          // Concentric Box Model Diagram (margin -> padding -> content)
                          let _ = ic.box(
                            fn(m_box : view::View) -> Unit {
                              let _ = m_box
                              .padding(view::Live::Is((6.0, 3.0, 6.0, 3.0)))
                              .gap(view::Live::Is(1.5))
                              .radius(view::Live::Is(6.0))
                              .ground(view::Live::Is(margin_bg))
                              .edge(view::Live::Is((1.0, margin_bd)))
                              // Margin top row
                              let _ = m_box.box(
                                fn(mt_row : view::View) -> Unit {
                                  let _ = mt_row
                                  .row(view::Live::Is(true))
                                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                  let _ = mt_row.box(
                                    fn(mlbl : view::View) -> Unit {
                                      let _ = mlbl
                                      .width(view::Live::Is(Some(36.0)))
                                      .rigid()
                                      .words(
                                        view::Live::Is("margin"),
                                        ink=margin_ink,
                                        look=view::WordsLook::{ ..view::words_plain, size: 9.5, weight: 500, wrap: false },
                                        one_line=true,
                                      )
                                    },
                                  )
                                  let _ = mt_row.box(
                                    fn(mv : view::View) -> Unit {
                                      let _ = mv
                                      .grow(view::Live::Is(1.0))
                                      .center()
                                      let _ = mv.box(
                                        fn(mvt : view::View) -> Unit {
                                          let _ = mvt.words_runs(
                                            view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.margin_top), margin_ink)]),
                                            ink=margin_ink,
                                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                          )
                                        },
                                      )
                                    },
                                  )
                                  let _ = mt_row.box(fn(sp : view::View) -> Unit { let _ = sp.width(view::Live::Is(Some(36.0))).rigid() })
                                },
                              )
                              // Margin middle row: ml | padding box | mr
                              let _ = m_box.box(
                                fn(m_mid : view::View) -> Unit {
                                  let _ = m_mid
                                  .row(view::Live::Is(true))
                                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                  .gap(view::Live::Is(4.0))
                                  let _ = m_mid.box(
                                    fn(ml : view::View) -> Unit {
                                      let _ = ml
                                      .width(view::Live::Is(Some(20.0)))
                                      .rigid()
                                      .center()
                                      let _ = ml.box(
                                        fn(mlt : view::View) -> Unit {
                                          let _ = mlt.words_runs(
                                            view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.margin_left), margin_ink)]),
                                            ink=margin_ink,
                                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                          )
                                        },
                                      )
                                    },
                                  )
                                  // Padding box
                                  let _ = m_mid.box(
                                    fn(p_box : view::View) -> Unit {
                                      let _ = p_box
                                      .grow(view::Live::Is(1.0))
                                      .shrink(view::Live::Is(1.0))
                                      .basis(view::Live::Is(Some(0.0)))
                                      .min_width(view::Live::Is(Some(0.0)))
                                      .padding(view::Live::Is((5.0, 2.0, 5.0, 2.0)))
                                      .gap(view::Live::Is(1.5))
                                      .radius(view::Live::Is(4.0))
                                      .ground(view::Live::Is(pad_bg))
                                      .edge(view::Live::Is((1.0, pad_bd)))
                                      let _ = p_box.box(
                                        fn(pt_row : view::View) -> Unit {
                                          let _ = pt_row
                                          .row(view::Live::Is(true))
                                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                          let _ = pt_row.box(
                                            fn(plbl : view::View) -> Unit {
                                              let _ = plbl
                                              .width(view::Live::Is(Some(22.0)))
                                              .rigid()
                                              .words(
                                                view::Live::Is("pad"),
                                                ink=pad_ink,
                                                look=view::WordsLook::{ ..view::words_plain, size: 9.0, weight: 500, wrap: false },
                                                one_line=true,
                                              )
                                            },
                                          )
                                          let _ = pt_row.box(
                                            fn(pv : view::View) -> Unit {
                                              let _ = pv
                                              .grow(view::Live::Is(1.0))
                                              .center()
                                              let _ = pv.box(
                                                fn(pvt : view::View) -> Unit {
                                                  let _ = pvt.words_runs(
                                                    view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.pad_top), pad_ink)]),
                                                    ink=pad_ink,
                                                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                                  )
                                                },
                                              )
                                            },
                                          )
                                          let _ = pt_row.box(fn(sp : view::View) -> Unit { let _ = sp.width(view::Live::Is(Some(22.0))).rigid() })
                                        },
                                      )
                                      let _ = p_box.box(
                                        fn(p_mid : view::View) -> Unit {
                                          let _ = p_mid
                                          .row(view::Live::Is(true))
                                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                          .gap(view::Live::Is(4.0))
                                          let _ = p_mid.box(
                                            fn(pl : view::View) -> Unit {
                                              let _ = pl
                                              .width(view::Live::Is(Some(18.0)))
                                              .rigid()
                                              .center()
                                              let _ = pl.box(
                                                fn(plt : view::View) -> Unit {
                                                  let _ = plt.words_runs(
                                                    view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.pad_left), pad_ink)]),
                                                    ink=pad_ink,
                                                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                                  )
                                                },
                                              )
                                            },
                                          )
                                          // Content W x H box
                                          let _ = p_mid.box(
                                            fn(c_box : view::View) -> Unit {
                                              let dim_txt = proto::format_devtools_px(bm.width) + " × " + proto::format_devtools_px(bm.height)
                                              let _ = c_box
                                              .grow(view::Live::Is(1.0))
                                              .shrink(view::Live::Is(1.0))
                                              .basis(view::Live::Is(Some(0.0)))
                                              .min_width(view::Live::Is(Some(0.0)))
                                              .height(view::Live::Is(Some(19.0)))
                                              .center()
                                              .radius(view::Live::Is(3.0))
                                              .ground(view::Live::Is(content_bg))
                                              .edge(view::Live::Is((1.0, content_bd)))
                                              let _ = c_box.box(
                                                fn(cl : view::View) -> Unit {
                                                  let _ = cl.words_runs(
                                                    view::Live::Is([dt_mono_run(dim_txt, content_ink, weight=600)]),
                                                    ink=content_ink,
                                                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                                  )
                                                },
                                              )
                                            },
                                          )
                                          let _ = p_mid.box(
                                            fn(pr : view::View) -> Unit {
                                              let _ = pr
                                              .width(view::Live::Is(Some(18.0)))
                                              .rigid()
                                              .center()
                                              let _ = pr.box(
                                                fn(prt : view::View) -> Unit {
                                                  let _ = prt.words_runs(
                                                    view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.pad_right), pad_ink)]),
                                                    ink=pad_ink,
                                                    look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                                  )
                                                },
                                              )
                                            },
                                          )
                                        },
                                      )
                                      let _ = p_box.box(
                                        fn(pb : view::View) -> Unit {
                                          let _ = pb.center()
                                          let _ = pb.box(
                                            fn(pbt : view::View) -> Unit {
                                              let _ = pbt.words_runs(
                                                view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.pad_bottom), pad_ink)]),
                                                ink=pad_ink,
                                                look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                              )
                                            },
                                          )
                                        },
                                      )
                                    },
                                  )
                                  let _ = m_mid.box(
                                    fn(mr : view::View) -> Unit {
                                      let _ = mr
                                      .width(view::Live::Is(Some(20.0)))
                                      .rigid()
                                      .center()
                                      let _ = mr.box(
                                        fn(mrt : view::View) -> Unit {
                                          let _ = mrt.words_runs(
                                            view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.margin_right), margin_ink)]),
                                            ink=margin_ink,
                                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                          )
                                        },
                                      )
                                    },
                                  )
                                },
                              )
                              // Margin bottom row
                              let _ = m_box.box(
                                fn(mb : view::View) -> Unit {
                                  let _ = mb.center()
                                  let _ = mb.box(
                                    fn(mbt : view::View) -> Unit {
                                      let _ = mbt.words_runs(
                                        view::Live::Is([dt_mono_run(proto::format_devtools_px(bm.margin_bottom), margin_ink)]),
                                        ink=margin_ink,
                                        look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 400, wrap: false },
                                      )
                                    },
                                  )
                                },
                              )
                            },
                          )

                          // Border widths readout when non-zero
                          if bm.border_top > 0.0 || bm.border_right > 0.0 || bm.border_bottom > 0.0 || bm.border_left > 0.0 {
                            let b_txt =
                            "border: " +
                            proto::format_devtools_px(bm.border_top) + " " +
                            proto::format_devtools_px(bm.border_right) + " " +
                            proto::format_devtools_px(bm.border_bottom) + " " +
                            proto::format_devtools_px(bm.border_left) + " px"
                            let _ = ic.box(
                              fn(br : view::View) -> Unit {
                                let _ = br.words_runs(
                                  view::Live::Is([dt_mono_run(b_txt, pal.ink_muted)]),
                                  ink=pal.ink_muted,
                                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                                )
                              },
                            )
                          }

                          // COMPUTED STYLES section header
                          let _ = ic.box(
                            fn(shdr : view::View) -> Unit {
                              let _ = shdr
                              .padding(view::Live::Is((0.0, 4.0, 0.0, 0.0)))
                              .words(
                                view::Live::Is("COMPUTED STYLES"),
                                ink=pal.ink_muted,
                                look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                one_line=true,
                              )
                            },
                          )

                          // Computed style property rows
                          let _ = ic.box(
                            fn(slist : view::View) -> Unit {
                              let _ = slist.gap(view::Live::Is(4.0))
                              for sp in snap.styles {
                                let swatch = proto::parse_devtools_color_swatch(sp.color_hex)
                                let _ = slist.box(
                                  fn(srow : view::View) -> Unit {
                                    let _ = srow
                                    .row(view::Live::Is(true))
                                    .lines_up(view::Live::Is(Some(view::Along::Start)))
                                    .gap(view::Live::Is(8.0))
                                    let _ = srow.box(
                                      fn(pn : view::View) -> Unit {
                                        let _ = pn
                                        .width(view::Live::Is(Some(122.0)))
                                        .rigid()
                                        .clips(view::Live::Is(true))
                                        .words_runs(
                                          view::Live::Is([dt_mono_run(sp.name, prop_ink)]),
                                          ink=prop_ink,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, line: 16.0, weight: 400, wrap: false },
                                        )
                                      },
                                    )
                                    match swatch {
                                      Some(col) => {
                                        let _ = srow.box(
                                          fn(sw_wrap : view::View) -> Unit {
                                            let _ = sw_wrap
                                            .height(view::Live::Is(Some(16.0)))
                                            .rigid()
                                            .center()
                                            let _ = sw_wrap.box(
                                              fn(sw : view::View) -> Unit {
                                                let _ = sw
                                                .width(view::Live::Is(Some(10.0)))
                                                .height(view::Live::Is(Some(10.0)))
                                                .rigid()
                                                .radius(view::Live::Is(2.5))
                                                .ground(view::Live::Is(col))
                                                .edge(view::Live::Is((1.0, pal.border)))
                                              },
                                            )
                                          },
                                        )
                                      }
                                      None => ()
                                    }
                                    let _ = srow.box(
                                      fn(pv : view::View) -> Unit {
                                        let _ = pv
                                        .grow(view::Live::Is(1.0))
                                        .shrink(view::Live::Is(1.0))
                                        .basis(view::Live::Is(Some(0.0)))
                                        .min_width(view::Live::Is(Some(0.0)))
                                        .words_runs(
                                          view::Live::Is([dt_mono_run(sp.value, val_ink)]),
                                          ink=val_ink,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.0, line: 16.0, weight: 400, wrap: true },
                                        )
                                      },
                                    )
                                  },
                                )
                              }
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // --- TAB 1: CONSOLE (Filters + Real V8 Log Stream + 30pt REPL Input) ---
          panel_host.show(
            fn() -> Bool { devtools_tab.get() == 1 },
            fn(con_col : view::View) -> Unit {
              let _ = con_col
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))

              // Filter sub-bar (26pt)
              let _ = con_col.box(
                fn(fbar : view::View) -> Unit {
                  let _ = fbar
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(26.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(4.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

                  let filter_pill = fn(fidx : Int, lbl : String, count_fn : () -> Int, dot_col : Int64) -> Unit {
                    let is_on = fn() -> Bool { devtools_console_filter.get() == fidx }
                    let _ = headless::button(
                      fbar,
                      fn() -> String { "Filter " + lbl },
                      fn(_v : view::View) -> Unit { devtools_console_filter.set(fidx) },
                      fn(fb : view::View, fbtn : headless::Button) -> Unit {
                        let _ = fb
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .height(view::Live::Is(Some(20.0)))
                        .rigid()
                        .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                        .gap(view::Live::Is(4.0))
                        .radius(view::Live::Is(5.0))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_on() { p.tab_active_bg } else if fbtn.hovered() { p.btn_hover } else { 0x00000000L }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          let p = chrome_palette()
                          if is_on() { (1.0, p.tab_active_border) } else { (0.0, 0x00000000L) }
                        }))
                        if dot_col != 0L {
                          let _ = fb.box(
                            fn(dt : view::View) -> Unit {
                              let _ = dt
                              .width(view::Live::Is(Some(6.0)))
                              .height(view::Live::Is(Some(6.0)))
                              .rigid()
                              .radius(view::Live::Is(3.0))
                              .ground(view::Live::Is(dot_col))
                            },
                          )
                        }
                        let _ = fb.box(
                          fn(fl : view::View) -> Unit {
                            let _ = fl
                            .words(
                              view::Live::By(fn() -> String {
                                let c = count_fn()
                                if c > 0 { lbl + " (" + c.to_string() + ")" } else { lbl }
                              }),
                              ink=0x334155FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_on() { p.ink_primary } else { p.ink_secondary }
                            }))
                          },
                        )
                      },
                    )
                  }

                  let count_for = fn(fidx : Int) -> Int {
                    let _ = devtools_rev.get()
                    let mut c = 0
                    for ce in app_state.devtools_snap.console_entries {
                      if dt_console_level_matches(fidx, ce.level) {
                        c = c + 1
                      }
                    }
                    c
                  }
                  filter_pill(0, "All", fn() -> Int { count_for(0) }, 0L)
                  filter_pill(1, "Log", fn() -> Int { count_for(1) }, 0x3B82F6FFL)
                  filter_pill(2, "Warn", fn() -> Int { count_for(2) }, 0xF59E0BFFL)
                  filter_pill(3, "Error", fn() -> Int { count_for(3) }, 0xEF4444FFL)
                },
              )

              let _ = con_col.box(
                fn(csep : view::View) -> Unit {
                  let _ = csep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )

              // Console log stream (scrollable)
              let _ = con_col.box(
                fn(log_pane : view::View) -> Unit {
                  let _ = log_pane
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(0.0)))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))

                  let _ = ui::scroll_box(
                    log_pane,
                    fn(log_list : view::View) -> Unit {
                      log_list.switch_by(
                        fn() -> Int { (devtools_rev.get() * 16 + devtools_console_filter.get()) * 2 + (if is_dark_chrome() { 1 } else { 0 }) },
                        fn(entries_box : view::View, key : Int) -> Unit {
                          let dark = (key % 2) == 1
                          let pal = chrome_palette_for(dark)
                          let filt = devtools_console_filter.untracked()
                          let filtered : Array[proto::DevToolsConsoleEntry] = []
                          for ce in app_state.devtools_snap.console_entries {
                            if dt_console_level_matches(filt, ce.level) {
                              filtered.push(ce)
                            }
                          }
                          if filtered.length() == 0 {
                            let _ = entries_box.box(
                              fn(emp : view::View) -> Unit {
                                let _ = emp
                                .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                                .words_runs(
                                  view::Live::Is([dt_mono_run("No console messages. Type a JavaScript expression below and press Enter.", pal.ink_muted)]),
                                  ink=pal.ink_muted,
                                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, weight: 400, wrap: true },
                                )
                              },
                            )
                          }
                          let mut i = 0
                          while i < filtered.length() {
                            let ce = filtered[i]
                            let (stripe_col, row_bg, glyph, glyph_col, text_col) = if ce.level == "input" {
                              if dark {
                                (0x818CF8FFL, 0x222634FFL, ">", 0x818CF8FFL, 0xE2E8F0FFL)
                              } else {
                                (0x6366F1FFL, 0xF8FAFCFFL, ">", 0x6366F1FFL, 0x1E293BFFL)
                              }
                            } else if ce.level == "result" {
                              let vc = if ce.source == "string" {
                                if dark { 0x34D399FFL } else { 0x047857FFL }
                              } else if ce.source == "number" || ce.source == "boolean" {
                                if dark { 0x60A5FAFFL } else { 0x1D4ED8FFL }
                              } else if ce.source == "undefined" || ce.source == "null" {
                                pal.ink_muted
                              } else {
                                pal.ink_primary
                              }
                              (pal.border, pal.surface_bg, "←", pal.ink_muted, vc)
                            } else if ce.level == "warn" {
                              if dark {
                                (0xF59E0BFFL, 0x2E2411FFL, "▲", 0xFBBF24FFL, 0xFDE68AFFL)
                              } else {
                                (0xF59E0BFFL, 0xFFFBEBFFL, "▲", 0xD97706FFL, 0x92400EFFL)
                              }
                            } else if ce.level == "error" {
                              if dark {
                                (0xF87171FFL, 0x331B20FFL, "✕", 0xF87171FFL, 0xFCA5A5FFL)
                              } else {
                                (0xEF4444FFL, 0xFEF2F2FFL, "✕", 0xDC2626FFL, 0x991B1BFFL)
                              }
                            } else if ce.level == "info" {
                              (pal.accent, pal.surface_bg, "i", pal.accent, pal.ink_primary)
                            } else {
                              (pal.ink_muted, pal.surface_bg, "•", pal.ink_muted, pal.ink_primary)
                            }
                            let _ = entries_box.box(
                              fn(crow : view::View) -> Unit {
                                let _ = crow
                                .row(view::Live::Is(true))
                                .lines_up(view::Live::Is(Some(view::Along::Start)))
                                .padding(view::Live::Is((0.0, 5.0, 12.0, 5.0)))
                                .gap(view::Live::Is(8.0))
                                .ground(view::Live::Is(row_bg))
                                // Left level bar
                                let _ = crow.box(
                                  fn(bar : view::View) -> Unit {
                                    let _ = bar
                                    .width(view::Live::Is(Some(3.0)))
                                    .height(view::Live::Is(Some(18.0)))
                                    .rigid()
                                    .ground(view::Live::Is(stripe_col))
                                  },
                                )
                                // Level prefix glyph (aligned to first line)
                                let _ = crow.box(
                                  fn(gl : view::View) -> Unit {
                                    let _ = gl
                                    .width(view::Live::Is(Some(14.0)))
                                    .height(view::Live::Is(Some(18.0)))
                                    .rigid()
                                    .center()
                                    let _ = gl.box(
                                      fn(gtxt : view::View) -> Unit {
                                        let _ = gtxt.words_runs(
                                          view::Live::Is([dt_mono_run(glyph, glyph_col, weight=600)]),
                                          ink=glyph_col,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.5, line: 18.0, weight: 600, wrap: false },
                                        )
                                      },
                                    )
                                  },
                                )
                                // Message body
                                let _ = crow.box(
                                  fn(msg : view::View) -> Unit {
                                    let _ = msg
                                    .grow(view::Live::Is(1.0))
                                    .shrink(view::Live::Is(1.0))
                                    .basis(view::Live::Is(Some(0.0)))
                                    .min_width(view::Live::Is(Some(0.0)))
                                    .words_runs(
                                      view::Live::Is([dt_mono_run(ce.text, text_col)]),
                                      ink=text_col,
                                      look=view::WordsLook::{ ..view::words_plain, size: 12.0, line: 18.0, weight: 400, wrap: true },
                                    )
                                  },
                                )
                                // Source/type badge on right
                                if ce.source != "" {
                                  let _ = crow.box(
                                    fn(src : view::View) -> Unit {
                                      let _ = src
                                      .rigid()
                                      .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                                      .radius(view::Live::Is(4.0))
                                      .ground(view::Live::Is(pal.surface_subtle))
                                      let _ = src.box(
                                        fn(sl : view::View) -> Unit {
                                          let _ = sl.words_runs(
                                            view::Live::Is([dt_mono_run(ce.source, pal.ink_muted)]),
                                            ink=pal.ink_muted,
                                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, line: 14.0, weight: 400, wrap: false },
                                          )
                                        },
                                      )
                                    },
                                  )
                                }
                              },
                            )
                            // Hairline separator only between items (zero trailing dangling line)
                            if i + 1 < filtered.length() {
                              let _ = entries_box.box(
                                fn(rsep : view::View) -> Unit {
                                  let _ = rsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::Is(pal.hairline))
                                },
                              )
                            }
                            i = i + 1
                          }
                        },
                      )
                    },
                  )
                },
              )

              // Single 1pt top hairline above REPL bar
              let _ = con_col.box(
                fn(rtop : view::View) -> Unit {
                  let _ = rtop.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
                },
              )

              // Bottom 30pt Interactive V8 Console REPL Input Bar
              let _ = con_col.box(
                fn(repl : view::View) -> Unit {
                  let _ = repl
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  let _ = repl.box(
                    fn(prompt : view::View) -> Unit {
                      let _ = prompt
                      .width(view::Live::Is(Some(14.0)))
                      .rigid()
                      .center()
                      let _ = prompt.box(
                        fn(pl : view::View) -> Unit {
                          let _ = pl.words_runs(
                            view::Live::By(fn() -> Array[text::Run] {
                              [dt_mono_run(">", chrome_palette().accent, weight=600)]
                            }),
                            ink=0x4F46E5FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 600, wrap: false },
                          )
                        },
                      )
                    },
                  )
                  let _ = repl.box(
                    fn(rfw : view::View) -> Unit {
                      let _ = rfw
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(22.0)))
                      .clips(view::Live::Is(true))
                      rfw.show(
                        fn() -> Bool { !is_dark_chrome() },
                        fn(fl : view::View) -> Unit {
                          let _ = ui::field(
                            fl,
                            devtools_repl_field,
                            placeholder="Evaluate JavaScript in page V8 context... (Enter)",
                            font_size=12.5,
                            color=0x1D1D1FFFL,
                            placeholder_color=0x8E8E93FFL,
                            max_lines=1,
                            enter_sends=true,
                            submitted=fn(t : String) -> Unit {
                              submit_devtools_repl(t)
                            },
                          )
                        },
                      )
                      rfw.show(
                        fn() -> Bool { is_dark_chrome() },
                        fn(fd : view::View) -> Unit {
                          let _ = ui::field(
                            fd,
                            devtools_repl_field,
                            placeholder="Evaluate JavaScript in page V8 context... (Enter)",
                            font_size=12.5,
                            color=0xF1F5F9FFL,
                            placeholder_color=0x94A3B8FFL,
                            caret_color=0x60A5FAFFL,
                            max_lines=1,
                            enter_sends=true,
                            submitted=fn(t : String) -> Unit {
                              submit_devtools_repl(t)
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )
            },
          )

          // --- TAB 2: NETWORK PRO (Filter Pills + Search + Waterfall Timing Bars + Request Inspector + Copy as cURL) ---
          panel_host.show(
            fn() -> Bool { devtools_tab.get() == 2 },
            fn(net_col : view::View) -> Unit {
              let _ = net_col
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(0.0)))

              // 1. Network Filter & Search Sub-Bar (30pt)
              let _ = net_col.box(
                fn(nfbar : view::View) -> Unit {
                  let _ = nfbar
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(30.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(4.0))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

                  let net_pill = fn(cat_id : String, lbl : String, dot_col : Int64) -> Unit {
                    let is_on = fn() -> Bool { devtools_net_filter.get() == cat_id }
                    let _ = headless::button(
                      nfbar,
                      fn() -> String { "Filter " + lbl },
                      fn(_v : view::View) -> Unit {
                        devtools_net_filter.set(cat_id)
                        devtools_rev.set(devtools_rev.untracked() + 1)
                      },
                      fn(fb : view::View, fbtn : headless::Button) -> Unit {
                        let _ = fb
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .height(view::Live::Is(Some(21.0)))
                        .rigid()
                        .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                        .gap(view::Live::Is(5.0))
                        .radius(view::Live::Is(10.5))
                        .ground(view::Live::By(fn() -> Int64 {
                          let p = chrome_palette()
                          if is_on() { p.tab_active_bg } else if fbtn.pressed() { p.btn_press } else if fbtn.hovered() { p.btn_hover } else { 0x00000000L }
                        }))
                        .edge(view::Live::By(fn() -> (Double, Int64) {
                          let p = chrome_palette()
                          if is_on() { (1.0, p.tab_active_border) } else { (0.0, 0x00000000L) }
                        }))
                        if dot_col != 0L {
                          let _ = fb.box(
                            fn(dt : view::View) -> Unit {
                              let _ = dt
                              .width(view::Live::Is(Some(6.0)))
                              .height(view::Live::Is(Some(6.0)))
                              .rigid()
                              .radius(view::Live::Is(3.0))
                              .ground(view::Live::Is(dot_col))
                            },
                          )
                        }
                        let _ = fb.box(
                          fn(fl : view::View) -> Unit {
                            let _ = fl
                            .words(
                              view::Live::Is(lbl),
                              ink=0x334155FFL,
                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 500, wrap: false },
                              one_line=true,
                            )
                            .ink(view::Live::By(fn() -> Int64 {
                              let p = chrome_palette()
                              if is_on() { p.ink_primary } else { p.ink_secondary }
                            }))
                          },
                        )
                      },
                    )
                  }

                  net_pill("all", "All", 0L)
                  net_pill("doc", "Doc", 0x3B82F6FFL)
                  net_pill("js", "JS", 0xF59E0BFFL)
                  net_pill("css", "CSS", 0x8B5CF6FFL)
                  net_pill("img", "Img", 0x10B981FFL)
                  net_pill("fetch", "Fetch", 0x06B6D4FFL)

                  // Flexible spacer
                  let _ = nfbar.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

                  // Compact UTF-8 live search box (204pt)
                  let _ = nfbar.box(
                    fn(sbox : view::View) -> Unit {
                      let _ = sbox
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .width(view::Live::Is(Some(204.0)))
                      .height(view::Live::Is(Some(22.0)))
                      .rigid()
                      .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                      .gap(view::Live::Is(5.0))
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))
                      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, chrome_palette().border) }))
                      let _ = sbox.box(
                        fn(ic : view::View) -> Unit {
                          let _ = ic.words(
                            view::Live::Is("⌕"),
                            ink=0x94A3B8FFL,
                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 500, wrap: false },
                            one_line=true,
                          )
                          .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                        },
                      )
                      let _ = sbox.box(
                        fn(fw : view::View) -> Unit {
                          let _ = fw
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .height(view::Live::Is(Some(18.0)))
                          .clips(view::Live::Is(true))
                          fw.show(
                            fn() -> Bool { !is_dark_chrome() },
                            fn(fl : view::View) -> Unit {
                              let _ = ui::field(
                                fl,
                                devtools_net_search_field,
                                placeholder="Filter URL, type, status...",
                                font_size=11.0,
                                color=0x1D1D1FFFL,
                                placeholder_color=0x94A3B8FFL,
                                max_lines=1,
                                enter_sends=true,
                                submitted=fn(t : String) -> Unit {
                                  devtools_net_query.set(t)
                                  devtools_rev.set(devtools_rev.untracked() + 1)
                                },
                              )
                            },
                          )
                          fw.show(
                            fn() -> Bool { is_dark_chrome() },
                            fn(fd : view::View) -> Unit {
                              let _ = ui::field(
                                fd,
                                devtools_net_search_field,
                                placeholder="Filter URL, type, status...",
                                font_size=11.0,
                                color=0xF1F5F9FFL,
                                placeholder_color=0x64748BFFL,
                                caret_color=0x60A5FAFFL,
                                max_lines=1,
                                enter_sends=true,
                                submitted=fn(t : String) -> Unit {
                                  devtools_net_query.set(t)
                                  devtools_rev.set(devtools_rev.untracked() + 1)
                                },
                              )
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )

              let _ = net_col.box(
                fn(nfsep : view::View) -> Unit {
                  let _ = nfsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )

              // 2. Main Split: Left Waterfall Request Table + Right Optional Request Inspector Drawer
              let _ = net_col.box(
                fn(net_split : view::View) -> Unit {
                  let _ = net_split
                  .row(view::Live::Is(true))
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(0.0)))
                  .clips(view::Live::Is(true))

                  // Left: Waterfall Table Column
                  let _ = net_split.box(
                    fn(tbl_col : view::View) -> Unit {
                      let _ = tbl_col
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .min_height(view::Live::Is(Some(0.0)))

                      // Column Header Row (24pt)
                      let _ = tbl_col.box(
                        fn(nhdr : view::View) -> Unit {
                          let _ = nhdr
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .height(view::Live::Is(Some(24.0)))
                          .rigid()
                          .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                          .gap(view::Live::Is(8.0))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                          let _ = nhdr.box(
                            fn(c1 : view::View) -> Unit {
                              let _ = c1
                              .grow(view::Live::Is(1.0))
                              .shrink(view::Live::Is(1.0))
                              .basis(view::Live::Is(Some(0.0)))
                              .min_width(view::Live::Is(Some(0.0)))
                              .words(
                                view::Live::Is("Name"),
                                ink=0x64748BFFL,
                                look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                one_line=true,
                              )
                              .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                            },
                          )
                          let hdr_col = fn(w : Double, lbl : String) -> Unit {
                            let _ = nhdr.box(
                              fn(c : view::View) -> Unit {
                                let _ = c
                                .width(view::Live::Is(Some(w)))
                                .rigid()
                                .words(
                                  view::Live::Is(lbl),
                                  ink=0x64748BFFL,
                                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 600, wrap: false },
                                  one_line=true,
                                )
                                .ink(view::Live::By(fn() -> Int64 { chrome_palette().ink_muted }))
                              },
                            )
                          }
                          hdr_col(52.0, "Status")
                          hdr_col(56.0, "Type")
                          hdr_col(66.0, "Size")
                          hdr_col(144.0, "Waterfall")
                        },
                      )

                      let _ = tbl_col.box(
                        fn(nsep : view::View) -> Unit {
                          let _ = nsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                        },
                      )

                      // Request rows scroller
                      let _ = tbl_col.box(
                        fn(net_pane : view::View) -> Unit {
                          let _ = net_pane
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .min_height(view::Live::Is(Some(0.0)))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_bg }))

                          let _ = ui::scroll_box(
                            net_pane,
                            fn(net_list : view::View) -> Unit {
                              net_list.switch_by(
                                fn() -> Int {
                                  let _ = devtools_net_filter.get()
                                  let _ = devtools_net_query.get()
                                  let live_q = devtools_net_search_field.text()
                                  let mut qh = 0
                                  let qb = live_q.to_bytes()
                                  let mut qi = 0
                                  while qi < qb.length() {
                                    qh = (qh * 31 + (qb[qi].to_int() & 0xFF)) & 0xFFFF
                                    qi = qi + 1
                                  }
                                  (devtools_rev.get() * 65536 + qh) * 2 + (if is_dark_chrome() { 1 } else { 0 })
                                },
                                fn(rows_box : view::View, key : Int) -> Unit {
                                  let dark = (key % 2) == 1
                                  let pal = chrome_palette_for(dark)
                                  let entries = app_state.devtools_snap.network_entries
                                  let cat = devtools_net_filter.untracked()
                                  let live_q = devtools_net_search_field.text()
                                  let q = if live_q != "" { live_q } else { devtools_net_query.untracked() }
                                  let mut max_ms = 1
                                  let mut mi = 0
                                  while mi < entries.length() {
                                    if entries[mi].duration_ms > max_ms {
                                      max_ms = entries[mi].duration_ms
                                    }
                                    mi = mi + 1
                                  }
                                  let matched_indices : Array[Int] = []
                                  let mut fi = 0
                                  while fi < entries.length() {
                                    if proto::devtools_net_matches_filter(entries[fi], cat, q) {
                                      matched_indices.push(fi)
                                    }
                                    fi = fi + 1
                                  }
                                  if matched_indices.length() == 0 {
                                    let _ = rows_box.box(
                                      fn(emp : view::View) -> Unit {
                                        let _ = emp
                                        .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                                        .words_runs(
                                          view::Live::Is([dt_mono_run("No network requests match the current filter.", pal.ink_muted)]),
                                          ink=pal.ink_muted,
                                          look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                        )
                                      },
                                    )
                                  }
                                  let mut ri = 0
                                  while ri < matched_indices.length() {
                                    let idx = matched_indices[ri]
                                    let ne = entries[idx]
                                    let zebra_bg = if ri % 2 == 1 { pal.surface_subtle } else { pal.surface_bg }
                                    let (pill_bg, pill_fg, pill_lbl) = dt_net_kind_colors(ne.kind, dark)
                                    let (st_bg, st_fg) = dt_net_status_colors(ne.status, dark)
                                    let wf_col = dt_net_waterfall_color(ne.kind, ne.url, dark)
                                    let wf_ratio = proto::devtools_net_waterfall_ratio(ne.duration_ms, max_ms)
                                    let wf_bar_w = 88.0 * wf_ratio
                                    let track_bg = if dark { 0x1E2433FFL } else { 0xE2E8F0FFL }
                                    let is_sel = fn() -> Bool { devtools_net_selected_idx.get() == idx }
                                    let _ = headless::button(
                                      rows_box,
                                      fn() -> String { "Inspect request " + ne.name },
                                      fn(_v : view::View) -> Unit {
                                        if devtools_net_selected_idx.untracked() == idx {
                                          devtools_net_selected_idx.set(-1)
                                        } else {
                                          devtools_net_selected_idx.set(idx)
                                        }
                                      },
                                      fn(nrow : view::View, nbtn : headless::Button) -> Unit {
                                        let _ = nrow
                                        .row(view::Live::Is(true))
                                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                        .height(view::Live::Is(Some(26.0)))
                                        .rigid()
                                        .padding(view::Live::Is((0.0, 0.0, 12.0, 0.0)))
                                        .gap(view::Live::Is(8.0))
                                        .ground(view::Live::By(fn() -> Int64 {
                                          if is_sel() {
                                            if dark { 0x242D42FFL } else { 0xEEF2FFFFL }
                                          } else if nbtn.hovered() {
                                            pal.tab_hover_bg
                                          } else {
                                            zebra_bg
                                          }
                                        }))
                                        // Left 2pt selection accent bar
                                        let _ = nrow.box(
                                          fn(sbar : view::View) -> Unit {
                                            let _ = sbar
                                            .width(view::Live::Is(Some(2.0)))
                                            .height(view::Live::Is(Some(18.0)))
                                            .rigid()
                                            .radius(view::Live::Is(1.0))
                                            .ground(view::Live::By(fn() -> Int64 {
                                              if is_sel() { pal.accent } else { 0x00000000L }
                                            }))
                                          },
                                        )
                                        // Name column
                                        let _ = nrow.box(
                                          fn(nm : view::View) -> Unit {
                                            let _ = nm
                                            .grow(view::Live::Is(1.0))
                                            .shrink(view::Live::Is(1.0))
                                            .basis(view::Live::Is(Some(0.0)))
                                            .min_width(view::Live::Is(Some(0.0)))
                                            .padding(view::Live::Is((2.0, 0.0, 0.0, 0.0)))
                                            .clips(view::Live::Is(true))
                                            .words_runs(
                                              view::Live::Is([dt_mono_run(ne.name, pal.ink_primary)]),
                                              ink=pal.ink_primary,
                                              look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 400, wrap: false },
                                            )
                                          },
                                        )
                                        // Status badge pill
                                        let _ = nrow.box(
                                          fn(sc : view::View) -> Unit {
                                            let _ = sc
                                            .width(view::Live::Is(Some(52.0)))
                                            .rigid()
                                            .row(view::Live::Is(true))
                                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                            let _ = sc.box(
                                              fn(sp : view::View) -> Unit {
                                                let _ = sp
                                                .height(view::Live::Is(Some(17.0)))
                                                .rigid()
                                                .center()
                                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                                .radius(view::Live::Is(4.0))
                                                .ground(view::Live::Is(st_bg))
                                                let _ = sp.box(
                                                  fn(sl : view::View) -> Unit {
                                                    let _ = sl.words_runs(
                                                      view::Live::Is([dt_mono_run(ne.status.to_string(), st_fg, weight=600)]),
                                                      ink=st_fg,
                                                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                                    )
                                                  },
                                                )
                                              },
                                            )
                                          },
                                        )
                                        // Type badge pill
                                        let _ = nrow.box(
                                          fn(tc : view::View) -> Unit {
                                            let _ = tc
                                            .width(view::Live::Is(Some(56.0)))
                                            .rigid()
                                            .row(view::Live::Is(true))
                                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                            let _ = tc.box(
                                              fn(tp : view::View) -> Unit {
                                                let _ = tp
                                                .height(view::Live::Is(Some(17.0)))
                                                .rigid()
                                                .center()
                                                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                                .radius(view::Live::Is(4.0))
                                                .ground(view::Live::Is(pill_bg))
                                                let _ = tp.box(
                                                  fn(tl : view::View) -> Unit {
                                                    let _ = tl.words_runs(
                                                      view::Live::Is([dt_mono_run(pill_lbl, pill_fg, weight=500)]),
                                                      ink=pill_fg,
                                                      look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 500, wrap: false },
                                                    )
                                                  },
                                                )
                                              },
                                            )
                                          },
                                        )
                                        // Size column
                                        let _ = nrow.box(
                                          fn(bc : view::View) -> Unit {
                                            let _ = bc
                                            .width(view::Live::Is(Some(66.0)))
                                            .rigid()
                                            .words_runs(
                                              view::Live::Is([dt_mono_run(proto::format_devtools_bytes(ne.size_bytes), pal.ink_secondary)]),
                                              ink=pal.ink_secondary,
                                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                                            )
                                          },
                                        )
                                        // Waterfall Timing Bar + ms label (144pt)
                                        let _ = nrow.box(
                                          fn(wf : view::View) -> Unit {
                                            let _ = wf
                                            .width(view::Live::Is(Some(144.0)))
                                            .rigid()
                                            .row(view::Live::Is(true))
                                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                            .gap(view::Live::Is(6.0))
                                            let _ = wf.box(
                                              fn(track : view::View) -> Unit {
                                                let _ = track
                                                .width(view::Live::Is(Some(88.0)))
                                                .height(view::Live::Is(Some(7.0)))
                                                .rigid()
                                                .radius(view::Live::Is(3.5))
                                                .clips(view::Live::Is(true))
                                                .ground(view::Live::Is(track_bg))
                                                let _ = track.box(
                                                  fn(fill : view::View) -> Unit {
                                                    let _ = fill
                                                    .width(view::Live::Is(Some(wf_bar_w)))
                                                    .height(view::Live::Is(Some(7.0)))
                                                    .rigid()
                                                    .radius(view::Live::Is(3.5))
                                                    .ground(view::Live::Is(wf_col))
                                                  },
                                                )
                                              },
                                            )
                                            let _ = wf.box(
                                              fn(ms_lbl : view::View) -> Unit {
                                                let _ = ms_lbl
                                                .width(view::Live::Is(Some(50.0)))
                                                .rigid()
                                                .words_runs(
                                                  view::Live::Is([dt_mono_run(ne.duration_ms.to_string() + " ms", pal.ink_muted)]),
                                                  ink=pal.ink_muted,
                                                  look=view::WordsLook::{ ..view::words_plain, size: 10.5, weight: 400, wrap: false },
                                                )
                                              },
                                            )
                                          },
                                        )
                                      },
                                    )
                                    ri = ri + 1
                                  }
                                },
                              )
                            },
                          )
                        },
                      )
                    },
                  )

                  // Right: Clickable Request Inspector Sidebar (mounted only when a row is selected; 0px when closed)
                  net_split.show(
                    fn() -> Bool {
                      let _ = devtools_rev.get()
                      let idx = devtools_net_selected_idx.get()
                      idx >= 0 && idx < app_state.devtools_snap.network_entries.length()
                    },
                    fn(insp_wrap : view::View) -> Unit {
                      let _ = insp_wrap
                      .row(view::Live::Is(true))
                      .rigid()
                      .min_height(view::Live::Is(Some(0.0)))
                      // Single 1pt vertical hairline
                      let _ = insp_wrap.box(
                        fn(vsep : view::View) -> Unit {
                          let _ = vsep.width(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().border }))
                        },
                      )
                      let _ = insp_wrap.box(
                        fn(insp : view::View) -> Unit {
                          let _ = insp
                          .width(view::Live::Is(Some(312.0)))
                          .rigid()
                          .min_height(view::Live::Is(Some(0.0)))
                          .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))

                          let _ = ui::scroll_box(
                            insp,
                            fn(insp_body : view::View) -> Unit {
                              let _ = insp_body.padding(view::Live::Is((12.0, 10.0, 12.0, 12.0))).gap(view::Live::Is(8.0))
                              insp_body.switch_by(
                                fn() -> Int {
                                  (devtools_rev.get() * 128 + devtools_net_selected_idx.get() + 1) * 2 + (if is_dark_chrome() { 1 } else { 0 })
                                },
                                fn(card : view::View, key : Int) -> Unit {
                                  let dark = (key % 2) == 1
                                  let pal = chrome_palette_for(dark)
                                  let idx = devtools_net_selected_idx.untracked()
                                  let entries = app_state.devtools_snap.network_entries
                                  if idx < 0 || idx >= entries.length() {
                                    return
                                  }
                                  let ne = entries[idx]
                                  let (st_bg, st_fg) = dt_net_status_colors(ne.status, dark)
                                  let curl_cmd = proto::devtools_net_curl_command(ne)
                                  let _ = card.gap(view::Live::Is(8.0))

                                  // Header row: Request Details + Status Pill + Close
                                  let _ = card.box(
                                    fn(hdr : view::View) -> Unit {
                                      let _ = hdr
                                      .row(view::Live::Is(true))
                                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                      .gap(view::Live::Is(6.0))
                                      let _ = hdr.box(
                                        fn(ht : view::View) -> Unit {
                                          let _ = ht
                                          .grow(view::Live::Is(1.0))
                                          .words(
                                            view::Live::Is("REQUEST INSPECTOR"),
                                            ink=pal.ink_muted,
                                            look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                            one_line=true,
                                          )
                                        },
                                      )
                                      let _ = hdr.box(
                                        fn(sp : view::View) -> Unit {
                                          let _ = sp
                                          .height(view::Live::Is(Some(18.0)))
                                          .rigid()
                                          .center()
                                          .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                                          .radius(view::Live::Is(4.0))
                                          .ground(view::Live::Is(st_bg))
                                          let _ = sp.box(
                                            fn(sl : view::View) -> Unit {
                                              let _ = sl.words_runs(
                                                view::Live::Is([dt_mono_run(proto::devtools_net_status_text(ne.status), st_fg, weight=600)]),
                                                ink=st_fg,
                                                look=view::WordsLook::{ ..view::words_plain, size: 10.0, weight: 600, wrap: false },
                                              )
                                            },
                                          )
                                        },
                                      )
                                      let _ = headless::button(
                                        hdr,
                                        fn() -> String { "Close Request Inspector" },
                                        fn(_v : view::View) -> Unit { devtools_net_selected_idx.set(-1) },
                                        fn(cb : view::View, cbtn : headless::Button) -> Unit {
                                          let _ = cb
                                          .width(view::Live::Is(Some(20.0)))
                                          .height(view::Live::Is(Some(20.0)))
                                          .rigid()
                                          .center()
                                          .radius(view::Live::Is(4.0))
                                          .ground(view::Live::By(fn() -> Int64 {
                                            if cbtn.pressed() { pal.btn_press } else if cbtn.hovered() { pal.btn_hover } else { 0x00000000L }
                                          }))
                                          let _ = cb.box(
                                            fn(cl : view::View) -> Unit {
                                              let _ = cl.words(
                                                view::Live::Is("×"),
                                                ink=pal.ink_secondary,
                                                look=view::WordsLook::{ ..view::words_plain, size: 13.0, weight: 500, wrap: false },
                                                one_line=true,
                                              )
                                            },
                                          )
                                        },
                                      )
                                    },
                                  )

                                  // Full URL card (wrappable mono)
                                  let _ = card.box(
                                    fn(uc : view::View) -> Unit {
                                      let _ = uc
                                      .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
                                      .radius(view::Live::Is(6.0))
                                      .ground(view::Live::Is(pal.surface_bg))
                                      .edge(view::Live::Is((1.0, pal.border)))
                                      let _ = uc.box(
                                        fn(ul : view::View) -> Unit {
                                          let _ = ul.words_runs(
                                            view::Live::Is([dt_mono_run(if ne.url != "" { ne.url } else { ne.name }, pal.ink_primary)]),
                                            ink=pal.ink_primary,
                                            look=view::WordsLook::{ ..view::words_plain, size: 11.0, line: 15.0, weight: 400, wrap: true },
                                          )
                                        },
                                      )
                                    },
                                  )

                                  // Compact metadata key-value rows
                                  let kv_row = fn(k : String, v : String) -> Unit {
                                    let _ = card.box(
                                      fn(kr : view::View) -> Unit {
                                        let _ = kr
                                        .row(view::Live::Is(true))
                                        .lines_up(view::Live::Is(Some(view::Along::Start)))
                                        .gap(view::Live::Is(8.0))
                                        let _ = kr.box(
                                          fn(kl : view::View) -> Unit {
                                            let _ = kl
                                            .width(view::Live::Is(Some(66.0)))
                                            .rigid()
                                            .words(
                                              view::Live::Is(k),
                                              ink=pal.ink_muted,
                                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, line: 16.0, weight: 500, wrap: false },
                                              one_line=true,
                                            )
                                          },
                                        )
                                        let _ = kr.box(
                                          fn(vl : view::View) -> Unit {
                                            let _ = vl
                                            .grow(view::Live::Is(1.0))
                                            .shrink(view::Live::Is(1.0))
                                            .basis(view::Live::Is(Some(0.0)))
                                            .min_width(view::Live::Is(Some(0.0)))
                                            .words_runs(
                                              view::Live::Is([dt_mono_run(v, pal.ink_primary)]),
                                              ink=pal.ink_primary,
                                              look=view::WordsLook::{ ..view::words_plain, size: 11.0, line: 16.0, weight: 400, wrap: true },
                                            )
                                          },
                                        )
                                      },
                                    )
                                  }

                                  kv_row("Method", "GET")
                                  kv_row("Status", proto::devtools_net_status_text(ne.status))
                                  kv_row("MIME", proto::devtools_net_mime(ne))
                                  kv_row("Size", proto::format_devtools_bytes(ne.size_bytes))
                                  kv_row("Duration", ne.duration_ms.to_string() + " ms")

                                  // Action bar: Copy as cURL primary button
                                  let _ = headless::button(
                                    card,
                                    fn() -> String { "Copy as cURL" },
                                    fn(_v : view::View) -> Unit {
                                      write_os_clipboard(curl_cmd)
                                      show_toast("Copied cURL command", "copy")
                                    },
                                    fn(cb : view::View, cbtn : headless::Button) -> Unit {
                                      let _ = cb
                                      .row(view::Live::Is(true))
                                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                                      .center()
                                      .height(view::Live::Is(Some(28.0)))
                                      .rigid()
                                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                                      .gap(view::Live::Is(6.0))
                                      .radius(view::Live::Is(6.0))
                                      .ground(view::Live::By(fn() -> Int64 {
                                        if cbtn.pressed() {
                                          pal.accent
                                        } else if cbtn.hovered() {
                                          pal.accent_soft_bg
                                        } else {
                                          pal.tab_active_bg
                                        }
                                      }))
                                      .edge(view::Live::By(fn() -> (Double, Int64) {
                                        (1.0, if cbtn.hovered() || cbtn.pressed() { pal.accent } else { pal.tab_active_border })
                                      }))
                                      let _ = cb.box(
                                        fn(cl : view::View) -> Unit {
                                          let _ = cl
                                          .words(
                                            view::Live::Is("Copy as cURL"),
                                            ink=pal.accent,
                                            look=view::WordsLook::{ ..view::words_plain, size: 11.5, weight: 600, wrap: false },
                                            one_line=true,
                                          )
                                          .ink(view::Live::By(fn() -> Int64 {
                                            if cbtn.pressed() { 0xFFFFFFFFL } else { pal.accent }
                                          }))
                                        },
                                      )
                                    },
                                  )
                                },
                              )
                            },
                          )
                        },
                      )
                    },
                  )
                },
              )

              // Bottom summary bar (24pt)
              let _ = net_col.box(
                fn(fsep : view::View) -> Unit {
                  let _ = fsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() -> Int64 { chrome_palette().hairline }))
                },
              )
              let _ = net_col.box(
                fn(foot : view::View) -> Unit {
                  let _ = foot
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(24.0)))
                  .rigid()
                  .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                  .ground(view::Live::By(fn() -> Int64 { chrome_palette().surface_subtle }))
                  let _ = foot.box(
                    fn(fl : view::View) -> Unit {
                      let _ = fl.words_runs(
                        view::Live::By(fn() -> Array[text::Run] {
                          let _ = devtools_rev.get()
                          let cat = devtools_net_filter.get()
                          let live_q = devtools_net_search_field.text()
                          let q = if live_q != "" { live_q } else { devtools_net_query.get() }
                          let filtered : Array[proto::DevToolsNetworkEntry] = []
                          for ne in app_state.devtools_snap.network_entries {
                            if proto::devtools_net_matches_filter(ne, cat, q) {
                              filtered.push(ne)
                            }
                          }
                          [dt_mono_run(proto::devtools_network_summary(filtered), chrome_palette().ink_secondary)]
                        }),
                        ink=0x475569FFL,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.0, weight: 400, wrap: false },
                      )
                    },
                  )
                },
              )
            },
          )
        },
      )
    },
  )
}
