///| How V8 and Pion get along: scripts driving a Pion DOM through the host callback.
///| 1:1 port of `src/cmd/jsprobe/main.mbt`.

import "html"
import "js"

let nodes : Array[html::Node] = []

fn add(n : html::Node) -> Int {
  nodes.push(n)
  nodes.length() - 1
}

extern "C" fn host_cb(op : Int, a : Int, b : Int, s : String, _t : String) -> String {
  match op {
    0 => ""
    1 => add(html::Node::element(html::Ns::Html, s, [])).to_string()
    2 => {
      nodes[a].append(nodes[b])
      ""
    }
    3 => nodes[a].children.length().to_string()
    _ => ""
  }
}

fn main(w : World) -> Unit {
  js::start_raw(c_fn_ptr(host_cb))
  let args = world_args(w)
  if args.length() > 1 {
    let mut i = 1
    while i < args.length() {
      io_println(w, js::run(args[i]))
      i = i + 1
    }
    return
  }
  io_println(w, js::run("1 + 41"))
  io_println(w, js::run("nope.x"))
  io_println(
    w,
    js::run(
      "var t0=Date.now(); for (var i=0;i<1000000;i++) __fv(0,i,0,'',''); 'noop per sec ' + Math.round(1e6/((Date.now()-t0)/1000))",
    ),
  )
  io_println(
    w,
    js::run(
      "var t0=Date.now(); var root=+__fv(1,0,0,'div'); for (var i=0;i<100000;i++){var n=+__fv(1,0,0,'span'); __fv(2,root,n)}; 'append 100k ms ' + (Date.now()-t0) + ' children ' + __fv(3,root)",
    ),
  )
  io_println(w, js::heap_used().to_string())
}
