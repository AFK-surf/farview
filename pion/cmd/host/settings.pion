///| Host-side Browser Settings persistence (`FV_PROFILE_DIR/settings.json`, never in ephemeral mode),
///| `FV_SETTINGS_SEED` deterministic initialization, `wire::Message::SettingsState` (tag 61)
///| broadcasting, real `clear_browsing_data` execution, and search-engine / HTTPS-Only URL resolution.

import "page"
import "net"
import "wire"
import "proto"

let settings_current : page::Ref[proto::BrowserSettings] = page::Ref::{ v: proto::BrowserSettings::default() }
let settings_initialized : page::Ref[Bool] = page::Ref::{ v: false }

fn settings_file() -> Option[String] {
  if page::is_host_ephemeral() {
    return None
  }
  let dir = ws_profile_dir()
  if dir == "" {
    None
  } else {
    Some(dir + "/settings.json")
  }
}

fn settings_persist() -> Unit {
  if !settings_initialized.v || page::is_host_ephemeral() {
    return
  }
  match settings_file() {
    Some(path) => {
      let json = proto::encode_browser_settings(settings_current.v)
      net::write_file_atomic(path, json)
    }
    None => ()
  }
}

fn init_host_settings() -> Unit {
  if settings_initialized.v {
    return
  }
  settings_initialized.v = true
  settings_current.v = proto::BrowserSettings::default()
  // 1. Optional deterministic seed via FV_SETTINGS_SEED (JSON BrowserSettings)
  let seed_raw = page::env_var("FV_SETTINGS_SEED").unwrap_or("").trim()
  if seed_raw != "" {
    match proto::parse_browser_settings(seed_raw) {
      Some(s) => {
        settings_current.v = proto::normalize_browser_settings(s)
        settings_persist()
        return
      }
      None => ()
    }
  }
  // 2. Restore from `<FV_PROFILE_DIR>/settings.json`
  match settings_file() {
    Some(path) =>
    match read_file_text(path) {
      Some(text) if text != "" =>
      match proto::parse_browser_settings(text) {
        Some(s) => settings_current.v = proto::normalize_browser_settings(s)
        None => ()
      }
      _ => ()
    }
    None => ()
  }
}

fn settings_current_json() -> String {
  init_host_settings()
  proto::encode_browser_settings(settings_current.v)
}

fn settings_broadcast_state() -> String {
  let json = settings_current_json()
  broadcast_all(wire::encode(wire::Message::SettingsState(json)))
  json
}

fn settings_save_and_broadcast(payload_json : String) -> String {
  init_host_settings()
  match proto::parse_browser_settings(payload_json) {
    Some(parsed) => {
      settings_current.v = proto::normalize_browser_settings(parsed)
      settings_persist()
    }
    None => ()
  }
  settings_broadcast_state()
}

fn host_apply_url_settings(raw_url : String) -> String {
  init_host_settings()
  proto::apply_https_only(raw_url, settings_current.v.https_only)
}

fn host_resolve_address(typed : String) -> String {
  init_host_settings()
  let s = settings_current.v
  proto::omnibox_normalize_input_with_engine(typed, s.search_engine, https_only=s.https_only)
}

fn host_clear_browsing_data(categories_raw : String) -> String {
  init_host_settings()
  let mut clear_history = false
  let mut clear_bookmarks = false
  let mut clear_boosts = false
  let mut clear_downloads = false
  for raw_part in categories_raw.split(",") {
    let p = page::ascii_lower(raw_part.trim())
    if p == "all" {
      clear_history = true
      clear_bookmarks = true
      clear_boosts = true
      clear_downloads = true
    } else if p == "history" {
      clear_history = true
    } else if p == "bookmarks" {
      clear_bookmarks = true
    } else if p == "boosts" {
      clear_boosts = true
    } else if p == "downloads" {
      clear_downloads = true
    }
  }
  let cleared : Array[String] = []
  if clear_bookmarks {
    init_host_bookmarks()
    bm_entries.clear()
    bm_persist()
    let _ = bm_broadcast_state()
    cleared.push("\"bookmarks\"")
  }
  if clear_history {
    let (_, bms) = ws_read_omnibox_fvhist1()
    page::reset_omnibox_index()
    if !clear_bookmarks {
      let mut bi = 0
      while bi < bms.length() {
        page::omnibox_add_bookmark(bms[bi])
        bi += 1
      }
    }
    ws_sync_omnibox()
    save_space_vault_history()
    ws_last_history_query.v = ""
    broadcast_all(wire::encode(wire::Message::OmniboxResults(host_omnibox_results_json(""))))
    let _ = ws_broadcast_history("")
    cleared.push("\"history\"")
  }
  if clear_boosts {
    init_host_boosts()
    boost_entries.clear()
    boost_legacy_bare.clear()
    boost_persist()
    boost_apply_current_page()
    let _ = boost_broadcast_state()
    cleared.push("\"boosts\"")
  }
  if clear_downloads {
    host_clear_downloads_state()
    let _ = dl_broadcast_state(force=true)
    cleared.push("\"downloads\"")
  }
  "{\"cleared\":[" + cleared.join(",") + "]}"
}

///| The address palette's search suggestions (`proto/search_suggest_ui.pion`): at most one request to the engine out;
///| what is asked meanwhile waits as the one latest query, asked once the answer comes. Nothing is asked while the
///| setting is off, for a private (ephemeral) profile, or for what is not a search (`proto::search_suggest_allowed`).
///| A request lost (a navigation drops every request out: `page::load` tells the callback with status 0) or out longer
///| than `suggest_lost_ms` is taken as answered with nothing, so the next query is asked and suggestions never stop.
struct SuggestAsk {
  mut out : Bool
  mut out_at : Int
  ///| the request out (its callback, once called or given up on, answers nothing more)
  mut out_seq : Int
  mut next : Option[(String, Int)]
}

let suggest_ask : SuggestAsk = SuggestAsk::{ out: false, out_at: 0, out_seq: 0, next: None }

let suggest_lost_ms : Int = 2500

///| Where the engine is asked (a test's local server instead of the engine).
let suggest_url_said : page::Ref[Option[(String) -> String]] = page::Ref::{ v: None }

fn search_suggest_url_for(engine : String, q : String) -> String {
  match suggest_url_said.v {
    Some(at) => at(proto::search_suggest_url(engine, q))
    None => proto::search_suggest_url(engine, q)
  }
}

fn search_suggest_ask(query : String, reply_sock : Int) -> Unit {
  let q = query.trim()
  let s = settings_current.v
  let url = search_suggest_url_for(s.search_engine, q)
  if !s.search_suggest || page::is_host_ephemeral() || !proto::search_suggest_allowed(q) || url == "" {
    // (what was waiting is for an older query: dropped; the client clears its rows for this one)
    suggest_ask.next = None
    search_suggest_reply(reply_sock, q, [])
    return
  }
  // (the asker by its viewer's own number: its socket may be another peer's by the time the answer comes)
  let asker = viewer_id_on(reply_sock)
  if suggest_ask.out && page::now_ms() - suggest_ask.out_at < suggest_lost_ms {
    suggest_ask.next = Some((q, asker))
    return
  }
  search_suggest_send(q, asker)
}

fn search_suggest_send(q : String, asker : Int) -> Unit {
  let url = search_suggest_url_for(settings_current.v.search_engine, q)
  suggest_ask.out = true
  suggest_ask.out_at = page::now_ms()
  suggest_ask.out_seq += 1
  let seq = suggest_ask.out_seq
  let _ = page::host_fetch(url, "Accept: application/json", fn(r) {
    if seq != suggest_ask.out_seq {
      // (given up on as lost: a newer request is out)
      return
    }
    suggest_ask.out = false
    let got = if r.status >= 200 && r.status < 300 {
      proto::parse_opensearch_suggestions(page::utf8_decode_lossy(r.body), query=q)
    } else {
      []
    }
    match suggest_ask.next {
      Some((nq, na)) => {
        // (typed on meanwhile: this answer is for an older query; ask for the latest)
        suggest_ask.next = None
        search_suggest_answer(asker, q, got)
        search_suggest_send(nq, na)
      }
      None => search_suggest_answer(asker, q, got)
    }
  })
}

///| An answer that came later, to the viewer that asked if it is still here (else to no one).
fn search_suggest_answer(asker : Int, query : String, got : Array[String]) -> Unit {
  search_suggest_reply(viewer_sock_of(asker), query, got)
}

fn search_suggest_reply(reply_sock : Int, query : String, got : Array[String]) -> Unit {
  if reply_sock >= 0 {
    let _ = net::send(reply_sock, wire::encode(wire::Message::Act("search_suggest", query, proto::encode_search_suggestions(got))))
  }
}
