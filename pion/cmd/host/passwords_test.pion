///| Host password manager: a login form sent asks to save; Save writes an owner-only encrypted vault with no
///| plaintext in it; autofill offers and fills the login on its own origin only; reveal answers only the asker; a
///| passwords CSV import goes into the vault once.

import "net"
import "page"
import "page_aux"
import "proto"
import "passwords"
import "wire"

fn pwt_has_bytes(hay : Bytes, needle : Bytes) -> Bool {
  let mut i = 0
  while i + needle.length() <= hay.length() {
    let mut j = 0
    while j < needle.length() && hay[i + j] == needle[j] {
      j = j + 1
    }
    if j == needle.length() {
      return true
    }
    i = i + 1
  }
  false
}

///| The wire id (as the client names fields) of the element with this id attribute.
fn pwt_id(sel : String) -> Int {
  page::wire_id_of(page::eval("String(document.getElementById('" + sel + "')._id)").to_int().unwrap_or(-1))
}

fn pwt_tab() -> Tab {
  Tab::{
    w: 1280.0,
    h: 800.0,
    vp: proto::ZoomViewportState::new(1280.0, 800.0),
    history: [],
    history_titles: [],
    history_scroll: [],
    at: -1,
  }
}

fn pwt_reset(dir : String) -> String {
  let prev = page::env_var("FV_PROFILE_DIR").unwrap_or("")
  net::mkdir(dir)
  net::setenv("FV_PROFILE_DIR", dir)
  pw_vault_ref.v = None
  prev
}

test "host passwords: a sent login form prompts; Save writes a 0600 vault without plaintext; autofill fills it back" {
  let port = page_aux::storage_test_http_start(12)
  debug_assert(port > 0, "loopback server")
  let base = "http://127.0.0.1:" + port.to_string()
  let dir = "/tmp/fv-host-pw-test-" + now_ms64().to_string()
  let prev = pwt_reset(dir)
  let tab = pwt_tab()
  tab.go(base + "/pw-login")
  debug_assert(page::title() == "login", "login page loaded (" + page::title() + ")")
  let uid = pwt_id("u")
  let pid = pwt_id("p")
  let npid = pwt_id("np")
  debug_assert(uid > 0 && pid > 0, "fields found")
  debug_assert(page::login_field_kind(uid) == "username" && page::login_field_kind(pid) == "password", "kinds")
  debug_assert(page::login_field_kind(npid) == "new-password", "new-password kind")
  let (fu, fp) = page::login_form_fields(pid)
  debug_assert(fu == uid && fp == pid, "the form's username and password fields")

  // Type and send the form: the Save prompt names the origin and username, not the password
  let secret = "s3cret-Pa55word!"
  tab.hit(page::typed_node(uid, "ada@example.com"))
  tab.hit(page::typed_node(pid, secret))
  tab.hit(page::enter_node(pid))
  debug_assert(pw_pending.length() == 1, "one pending prompt")
  let pend = pw_pending[0]
  debug_assert(pend.kind == "save" && pend.username == "ada@example.com" && pend.password == secret, "captured")
  let pj = pw_prompt_json(pend)
  debug_assert(!pj.contains(secret), "the prompt does not carry the password")
  debug_assert(page::title() == "done", "the form was sent on (" + page::title() + ")")

  // Save: an encrypted vault, owner-only, no plaintext
  let cmd = proto::encode_password_command(proto::PasswordCommand::{ ..proto::PasswordCommand::empty(), prompt_id: pend.prompt_id })
  let list = pw_handle_act(tab, proto::PW_VERB_SAVE, cmd, agent=true).unwrap_or("")
  debug_assert(list.contains("ada@example.com") && !list.contains(secret), "list has the login, not its password")
  debug_assert(pw_pending.length() == 0, "prompt answered")
  let raw = mig_read_file_bytes(dir + "/passwords.vault").unwrap_or(Bytes::new(0))
  debug_assert(raw.length() > 40, "vault written")
  debug_assert(!pwt_has_bytes(raw, secret.to_bytes()), "no plaintext password on disk")
  debug_assert(!pwt_has_bytes(raw, "ada@example.com".to_bytes()), "no plaintext username on disk")
  debug_assert(net::file_mode(dir + "/passwords.vault") == 0x180, "vault is 0600 (\{net::file_mode(dir + "/passwords.vault")})")
  debug_assert(net::file_mode(dir + "/passwords.key") == 0x180, "key is 0600")
  // a second send of the same login asks nothing
  debug_assert(pw_on_capture("{\"url\":\"" + base + "/pw-login\",\"username\":\"ada@example.com\",\"password\":\"" + secret + "\"}") == "", "known login: no prompt")
  let upd = pw_on_capture("{\"url\":\"" + base + "/pw-login\",\"username\":\"ada@example.com\",\"password\":\"new-one\"}")
  debug_assert(upd.contains("\"kind\":\"update\""), "a new password asks to update")
  let _ = pw_handle_act(tab, proto::PW_VERB_DISMISS, proto::encode_password_command(proto::PasswordCommand::{ ..proto::PasswordCommand::empty(), prompt_id: pw_pending[0].prompt_id }), agent=true)
  debug_assert(pw_pending.length() == 0, "dismissed")

  // Reload from disk: the vault opens with its key
  pw_vault_ref.v = None
  debug_assert(pw_vault().length() == 1 && !pw_blocked.v, "reopened from disk")
  let id = pw_vault().entries()[0].id

  // Autofill on the login page: suggestion, then the host types it in
  tab.go(base + "/pw-login")
  let uid2 = pwt_id("u")
  let pid2 = pwt_id("p")
  let q = proto::encode_autofill_query(proto::AutofillQuery::{ req_id: "q1", url: "https://evil.example/", field_id: uid2, password_field_id: -1 })
  let sj = pw_handle_act(tab, proto::PW_VERB_AUTOFILL_QUERY, q, agent=true).unwrap_or("")
  match proto::parse_autofill_snapshot(sj) {
    Some(s) => {
      debug_assert(s.suggestions.length() == 1 && s.suggestions[0].exact && s.suggestions[0].username == "ada@example.com", "offered (page origin, not the client's URL)")
      debug_assert(s.password_field_id == pid2, "the form's password field")
      debug_assert(!sj.contains(secret), "suggestions carry no password")
    }
    None => debug_assert(false, "snapshot")
  }
  let fill = proto::encode_autofill_fill(proto::AutofillFillRequest::{ url: "", id, field_id: uid2, password_field_id: pid2, generate: false })
  debug_assert(pw_handle_act(tab, proto::PW_VERB_AUTOFILL_FILL, fill, agent=true).unwrap_or("") == "login", "filled")
  debug_assert(page::login_field_value(uid2) == "ada@example.com" && page::login_field_value(pid2) == secret, "the page's fields hold the login")
  debug_assert((match pw_vault().get(id) { Some(e) => e.times_used; None => 0 }) == 1, "use counted")
  // Generate fills the new-password field with a strong password
  let np2 = pwt_id("np")
  let gq = pw_autofill_snapshot(proto::AutofillQuery::{ req_id: "q2", url: "", field_id: np2, password_field_id: -1 })
  debug_assert(gq.can_generate && gq.suggestions.length() == 0, "new-password field: generate, no logins")
  let gen = proto::encode_autofill_fill(proto::AutofillFillRequest::{ url: "", id: "", field_id: np2, password_field_id: -1, generate: true })
  debug_assert(pw_handle_act(tab, proto::PW_VERB_AUTOFILL_FILL, gen, agent=true).unwrap_or("") == "generated", "generated")
  debug_assert(page::login_field_value(np2).length() == passwords::PW_GEN_DEFAULT_LEN, "a 20-character password typed in")

  // Reveal answers with the password (only to the asker); delete removes it
  let rv = pw_handle_act(tab, proto::PW_VERB_REVEAL, proto::encode_password_command(proto::PasswordCommand::{ ..proto::PasswordCommand::empty(), id, req_id: "r1" }), agent=true).unwrap_or("")
  debug_assert(rv.contains(secret) && rv.contains("\"ok\":true"), "revealed")
  let after = pw_handle_act(tab, proto::PW_VERB_DELETE, proto::encode_password_command(proto::PasswordCommand::{ ..proto::PasswordCommand::empty(), id }), agent=true).unwrap_or("")
  debug_assert(!after.contains("ada@example.com") && pw_vault().length() == 0, "deleted")

  // A login of another origin is never filled into this page
  match pw_vault().upsert("https://example.org/", "bob", "x", 1L) {
    passwords::UpsertOutcome::Added(oid) => {
      let f2 = proto::encode_autofill_fill(proto::AutofillFillRequest::{ url: "https://example.org/", id: oid, field_id: uid2, password_field_id: pid2, generate: false })
      debug_assert(pw_handle_act(tab, proto::PW_VERB_AUTOFILL_FILL, f2, agent=true).unwrap_or("x") == "", "cross-origin fill refused")
    }
    _ => debug_assert(false, "added")
  }

  // Never for this site: no more prompts on it
  let pj2 = pw_on_capture("{\"url\":\"" + base + "/x\",\"username\":\"c\",\"password\":\"d\"}")
  debug_assert(pj2 != "", "prompted")
  let _ = pw_handle_act(tab, proto::PW_VERB_DISMISS, proto::encode_password_command(proto::PasswordCommand::{ ..proto::PasswordCommand::empty(), prompt_id: pw_pending[0].prompt_id, never: true }), agent=true)
  debug_assert(pw_on_capture("{\"url\":\"" + base + "/y\",\"username\":\"e\",\"password\":\"f\"}") == "", "never again on this origin")

  // A damaged vault is kept as it is: nothing is written over it
  net::write_bytes_atomic(dir + "/passwords.vault", "FVPW\u{1}garbage-garbage-garbage-garbage-garbage-garbage".to_bytes())
  pw_vault_ref.v = None
  debug_assert(pw_vault().length() == 0 && pw_blocked.v, "blocked")
  let _ = pw_vault().upsert("https://example.com/", "z", "z", 1L)
  debug_assert(!pw_persist(), "not persisted")
  debug_assert(mig_read_file_bytes(dir + "/passwords.vault").unwrap_or(Bytes::new(0)).to_string().contains("garbage"), "the damaged file is untouched")

  net::setenv("FV_PROFILE_DIR", prev)
  pw_vault_ref.v = None
}

test "host passwords: a passwords CSV import goes into the vault, once" {
  let dir = "/tmp/fv-host-pw-csv-" + now_ms64().to_string()
  let prev = pwt_reset(dir)
  let csv = dir + "/Chrome Passwords.csv"
  net::write_file(csv, "name,url,username,password,note\nExample,https://example.com/login,ada,pw-one,\nBad,javascript:alert(1),x,y,\n")
  let r1 = proto::parse_migrate_result(host_migrate_import_file(csv, -1, true))
  match r1 {
    Some(r) => debug_assert(r.ok && r.passwords_added == 1 && r.skipped_unsafe >= 1, "one login imported (\{r.passwords_added})")
    None => debug_assert(false, "result")
  }
  match proto::parse_migrate_result(host_migrate_import_file(csv, -1, true)) {
    Some(r) => debug_assert(r.passwords_added == 0, "the same file again adds nothing")
    None => debug_assert(false, "result 2")
  }
  pw_vault_ref.v = None
  debug_assert((match pw_vault().find_login("https://example.com", "ada") { Some(e) => e.password; None => "" }) == "pw-one", "persisted encrypted")
  let raw = mig_read_file_bytes(dir + "/passwords.vault").unwrap_or(Bytes::new(0))
  debug_assert(raw.length() > 0 && !pwt_has_bytes(raw, "pw-one".to_bytes()), "no plaintext on disk")
  net::setenv("FV_PROFILE_DIR", prev)
  pw_vault_ref.v = None
}

test "host passwords: Import finds the newest passwords CSV in Downloads; Export writes an owner-only CSV" {
  let dir = "/tmp/fv-host-pw-io-" + now_ms64().to_string()
  let prev = pwt_reset(dir)
  let dl = dir + "/Downloads"
  net::mkdir(dl)
  let prev_dl = page::env_var("FV_DOWNLOADS_DIR").unwrap_or("")
  net::setenv("FV_DOWNLOADS_DIR", dl)
  let tab = pwt_tab()
  match proto::parse_password_io(pw_handle_act(tab, proto::PW_VERB_IMPORT, "", agent=true).unwrap_or("")) {
    Some(r) => debug_assert(!r.ok && r.error.contains("No passwords CSV"), "nothing to import yet")
    None => debug_assert(false, "io")
  }
  net::write_file(dl + "/notes.csv", "a,b\n1,2\n")
  net::write_file(dl + "/Chrome Passwords.csv", "name,url,username,password\nA,https://a.example/,u1,p1\n")
  net::write_file(dl + "/Chrome Passwords (1).csv", "name,url,username,password\nA,https://a.example/,u1,p1\nB,https://b.example/,u2,p2\n")
  match proto::parse_password_io(pw_handle_act(tab, proto::PW_VERB_IMPORT, "", agent=true).unwrap_or("")) {
    Some(r) => debug_assert(r.ok && r.count == 2 && r.path.ends_with("Chrome Passwords (1).csv"), "the newest export imported (\{r.count} from \{r.path})")
    None => debug_assert(false, "io 2")
  }
  match proto::parse_password_io(pw_handle_act(tab, proto::PW_VERB_EXPORT, "", agent=true).unwrap_or("")) {
    Some(r) => {
      debug_assert(r.ok && r.count == 2 && r.path == dl + "/Farview Passwords.csv", "exported")
      debug_assert(net::file_mode(r.path) == 0x180, "the export is 0600")
      let txt = read_file_text(r.path).unwrap_or("")
      debug_assert(txt.starts_with("name,url,username,password,note") && txt.contains("u2,p2"), "a browser-readable CSV")
    }
    None => debug_assert(false, "io 3")
  }
  // (our own export is never picked up as an import)
  debug_assert(pw_find_export_csv(dl).ends_with("Chrome Passwords (1).csv"), "own export skipped")
  net::setenv("FV_DOWNLOADS_DIR", prev_dl)
  net::setenv("FV_PROFILE_DIR", prev)
  pw_vault_ref.v = None
}
