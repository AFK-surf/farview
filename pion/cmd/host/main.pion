///| Farview Host entry point (`pion-host <port> <url>` or `pion-host --tab <port> <url>`).
///| 1:1 port of `src/cmd/host/main.mbt`.

import "page"
import "css"
import "layout"
import "wire"
import "proto"
import "net"
import "fetch"
import "intmap"
import "browser_ctx"

let news : page::Ref[Int] = page::Ref::{ v: 0 }
let saved_args : page::Ref[Array[String]] = page::Ref::{ v: [] }

struct Sent {
  glyphs : Map[String, Bool]
  pictures : Map[String, Bool]
  pieces : wire::Sender
  mut overlay : Bytes
  mut areas : Bytes
  mut hovers : Bool
}

struct Viewer {
  sock : Int
  ///| this viewer's own number, never another's (its socket's number can be another's once it is gone)
  id : Int
  framer : wire::Framer
  sent : Sent
  mut doc : Option[DocClient]
}

let viewer_ids : page::Ref[Int] = page::Ref::{ v: 0 }

fn Viewer::new(sock : Int) -> Viewer {
  viewer_ids.v += 1
  Viewer::{
    sock: sock,
    id: viewer_ids.v,
    framer: wire::Framer::new(),
    sent: Sent::{
      glyphs: Map::new(),
      pictures: Map::new(),
      pieces: wire::Sender::new(),
      overlay: Bytes::new(0),
      areas: Bytes::new(0),
      hovers: false,
    },
    doc: None,
  }
}

let viewers : Array[Viewer] = []

///| The viewer on `sock` now, by its own number (-1: none).
fn viewer_id_on(sock : Int) -> Int {
  for v in viewers {
    if v.sock == sock {
      return v.id
    }
  }
  -1
}

///| The socket of the viewer numbered `id` if it is still here (-1: gone, its socket maybe another's now).
fn viewer_sock_of(id : Int) -> Int {
  for v in viewers {
    if v.id == id {
      return v.sock
    }
  }
  -1
}

fn broadcast(msg : Bytes) -> Unit {
  for v in viewers {
    if v.doc is None {
      let _ = net::send(v.sock, msg)
    }
  }
}

fn broadcast_all(msg : Bytes) -> Unit {
  for v in viewers {
    let _ = net::send(v.sock, msg)
  }
}

fn has_doc_viewer() -> Bool {
  for v in viewers {
    if v.doc is Some(_) {
      return true
    }
  }
  false
}

fn agent_said(v : Viewer, on : Bool) -> Unit {
  let msg = match v.doc {
    Some(_) => proto::encode_host(proto::HostMsg::AgentOn(on))
    None => wire::encode(wire::Message::AgentOn(on))
  }
  let _ = net::send(v.sock, msg)
}

fn agent_told(on : Bool) -> Unit {
  broadcast(wire::encode(wire::Message::AgentOn(on)))
  for v in viewers {
    if v.doc is Some(_) {
      let _ = net::send(v.sock, proto::encode_host(proto::HostMsg::AgentOn(on)))
    }
  }
}

let on_drawn : page::Ref[() -> Unit] = page::Ref::{ v: fn() { () } }
let on_scrolled : page::Ref[(Double) -> Unit] = page::Ref::{ v: fn(_y) { () } }

fn send_frame(w : Double) -> Unit {
  let t0 = now_ms64()
  tell_opened()
  if viewers.length() == 0 {
    match page::take_scroll() {
      Some(y) => {
        news.v += 1
        (on_scrolled.v)(y)
      }
      None => ()
    }
    let _ = page::take_copied()
    (on_drawn.v)()
    return
  }
  let drawn_ones : Array[Viewer] = []
  for v in viewers {
    if v.doc is None {
      drawn_ones.push(v)
    }
  }
  if drawn_ones.length() < viewers.length() {
    if drawn_ones.length() > 0 || page::doc_needs_layout() {
      if page::has_dirty_canvases_now() {
        let _ = page::flush_canvases()
      }
      page::laid_out()
    } else if page::has_dirty_canvases_now() {
      let _ = page::flush_canvases()
    }
    let scrolled = page::take_scroll()
    let copied = page::take_copied()
    for v in viewers {
      match v.doc {
        Some(d) => {
          let _ = send_doc(v, d, scrolled, copied)
        }
        None => ()
      }
    }
    match scrolled {
      Some(y) => {
        news.v += 1
        (on_scrolled.v)(y)
        for v in drawn_ones {
          let _ = net::send(v.sock, wire::encode(wire::Message::ScrollTo(y)))
        }
      }
      None => ()
    }
    match copied {
      Some(t) => {
        for v in drawn_ones {
          let _ = net::send(v.sock, wire::encode(wire::Message::Copied(t)))
        }
      }
      None => ()
    }
    if drawn_ones.length() == 0 {
      page::clear_frame_due()
      news.v += 1
      (on_drawn.v)()
      return
    }
  }
  let (ops, _, height) = page::frame()
  let t_drawn = now_ms64()
  let fixed = page::fixed_ops()
  let drawn : Map[String, Double] = Map::new()
  for list in [ops, fixed] {
    for op in list {
      match op {
        wire::Op::Image(_, _, iw, ih, u) => {
          let m = if iw > ih { iw } else { ih }
          if m > drawn.get(u).unwrap_or(0.0) {
            drawn.set(u, m)
          }
        }
        _ => ()
      }
    }
  }
  let overlay = wire::encode(wire::Message::Overlay(fixed))
  let areas = wire::encode(wire::Message::DragAreas(page::drag_areas()))
  let mut size = 0
  for v in drawn_ones {
    size = page::imax(size, send_frame_to(v, w, height, ops, fixed, drawn, overlay, areas))
  }
  let t_sent = now_ms64()
  match page::take_scroll() {
    Some(y) => {
      news.v += 1
      broadcast(wire::encode(wire::Message::ScrollTo(y)))
      (on_scrolled.v)(y)
    }
    None => ()
  }
  match page::take_copied() {
    Some(t) => {
      news.v += 1
      broadcast(wire::encode(wire::Message::Copied(t)))
    }
    None => ()
  }
  (on_drawn.v)()
  if page::env_has("FV_HOST_LOG") {
    note("frame \{size} bytes, \{fixed.length()} ops over it; drawn in \{t_drawn - t0} ms, sent \{t_sent - t0} ms")
  }
}

fn filter_no_hover(a : Array[wire::Op]) -> Array[wire::Op] {
  let out : Array[wire::Op] = []
  for op in a {
    match op {
      wire::Op::Hover(_, _, _, _, _, _) => ()
      _ => out.push(op)
    }
  }
  out
}

fn send_frame_to(
  v : Viewer,
  w : Double,
  height : Double,
  ops : Array[wire::Op],
  fixed : Array[wire::Op],
  _drawn : Map[String, Double],
  overlay : Bytes,
  areas : Bytes,
) -> Int {
  let sock = v.sock
  let sent = v.sent
  send_outlines(sock, ops, sent.glyphs)
  send_outlines(sock, fixed, sent.glyphs)
  let pics = page::pictures()
  for u in pics.keys() {
    if !sent.pictures.contains(u) {
      sent.pictures.set(u, true)
      match pics.get(u) {
        Some(d) => {
          let _ = net::send(sock, wire::encode(wire::Message::Picture(u, d)))
        }
        None => ()
      }
    }
  }
  let (send_ops, send_overlay) = if sent.hovers {
    (ops, overlay)
  } else {
    (filter_no_hover(ops), wire::encode(wire::Message::Overlay(filter_no_hover(fixed))))
  }
  let msg = match sent.pieces.frame(w, height, send_ops) {
    Some(f) => wire::encode(f)
    None => Bytes::new(0)
  }
  if msg.length() > 0 {
    news.v += 1
    let _ = net::send(sock, msg)
  }
  if !bytes_eq(send_overlay, sent.overlay) {
    sent.overlay = send_overlay
    news.v += 1
    let _ = net::send(sock, send_overlay)
  }
  if !bytes_eq(areas, sent.areas) {
    sent.areas = areas
    news.v += 1
    let _ = net::send(sock, areas)
  }
  msg.length()
}

fn map_layout_cmds(cmds : Array[layout::PathCmd]) -> Array[wire::PathCmd] {
  let out : Array[wire::PathCmd] = []
  for c in cmds {
    match c {
      layout::PathCmd::MoveTo(x, y) => out.push(wire::PathCmd::MoveTo(x, y))
      layout::PathCmd::LineTo(x, y) => out.push(wire::PathCmd::LineTo(x, y))
      layout::PathCmd::QuadTo(cx, cy, x, y) => out.push(wire::PathCmd::QuadTo(cx, cy, x, y))
      layout::PathCmd::CubicTo(c1x, c1y, c2x, c2y, x, y) => out.push(wire::PathCmd::CubicTo(c1x, c1y, c2x, c2y, x, y))
      layout::PathCmd::Close => out.push(wire::PathCmd::Close)
    }
  }
  out
}

fn send_outlines(sock : Int, ops : Array[wire::Op], sent : Map[String, Bool]) -> Unit {
  let fonts = page::fonts()
  let todo : intmap::IntMap[Array[(Int, Array[wire::PathCmd])]] = intmap::IntMap::new()
  for op in ops {
    let drawn = match op {
      wire::Op::Glyphs(f, _, _, _, _, gids, _) => Some((f, gids))
      wire::Op::VGlyphs(f, _, _, gids, _, _, _) => Some((f, gids))
      _ => None
    }
    if drawn is Some((f, gids)) {
      for g in gids {
        let key = "\{f}:\{g}"
        if !sent.contains(key) {
          sent.set(key, true)
          let list = match intmap::get(todo, f) {
            Some(l) => l
            None => {
              let l : Array[(Int, Array[wire::PathCmd])] = []
              todo.set(f, l)
              l
            }
          }
          list.push((g, map_layout_cmds(fonts.wire_outline(f, g))))
        }
      }
    }
  }
  for f in todo.keys() {
    match intmap::get(todo, f) {
      Some(list) => {
        let _ = net::send(sock, wire::encode(wire::Message::Outlines(f, fonts.units_per_em(f), list)))
      }
      None => ()
    }
  }
}

fn note(s : String) -> Unit {
  match page::env_var("FV_HOST_LOG") {
    Some(path) if path != "" => {
      let prefix = if page::env_has("FV_HOST_LOG_TIMES") { "\{now_ms64()} " } else { "" }
      net::append_file(path, prefix + s + "\n")
    }
    _ => ()
  }
}

let logged_title : page::Ref[Option[String]] = page::Ref::{ v: None }

fn note_title() -> Unit {
  let t = page::title()
  let same = match logged_title.v {
    Some(prev) => prev == t
    None => false
  }
  if !same {
    logged_title.v = Some(t)
    note("title " + t)
    news.v += 1
    match the_tab.v {
      Some(tab) if tab.at >= 0 && tab.at < tab.history_titles.length() && t != "" => {
        tab.history_titles[tab.at] = t
      }
      _ => ()
    }
    broadcast(wire::encode(wire::Message::Title(t)))
    ws_on_title_changed(t)
    (on_drawn.v)()
  }
}

let logged_errors : page::Ref[Int] = page::Ref::{ v: 0 }

fn note_errors() -> Unit {
  let all = page::errors()
  let mut i = logged_errors.v
  while i < all.length() {
    let e = all[i]
    let txt = if e.length() > 2000 { e.slice(0, 2000) } else { e }
    note("script error: " + txt)
    i += 1
  }
  logged_errors.v = all.length()
}

fn load(u : String, w : Double, h : Double, post~ : Option[String] = None) -> Bool {
  if u.ends_with("#farview-stop-test") {
    net::exit(134)
  }
  let told : Array[String] = [""]
  let t0 = now_ms64()
  let on_parsed = fn() -> Unit {
    told[0] = page::url()
    dt_on_page_loaded()
    boost_on_page_loaded()
    broadcast(wire::encode(wire::Message::Page(told[0])))
    send_frame(w)
    note("parsed and drawn in \{now_ms64() - t0} ms")
  }
  let shown = match post {
    Some(p) => page::load(u, w, h, post=p, parsed=on_parsed)
    None => page::load(u, w, h, parsed=on_parsed)
  }
  if !shown {
    note("downloaded, not shown: " + u)
    return false
  }
  logged_errors.v = 0
  note_errors()
  if page::url() != told[0] {
    broadcast(wire::encode(wire::Message::Page(page::url())))
  }
  send_frame(w)
  save_storage()
  if !page::navigation_pending() {
    broadcast(wire::encode(wire::Message::Loaded))
  }
  true
}

struct Tab {
  mut w : Double
  mut h : Double
  vp : proto::ZoomViewportState
  history : Array[String]
  history_titles : Array[String]
  // where the person had scrolled each entry when they left it, by `scroll_key` (index and address: an entry's
  // place kept only while the entry is the same), put back on Back/Forward
  history_scroll : Array[(String, Double)]
  mut at : Int
}

fn scroll_key(k : Int, u : String) -> String {
  k.to_string() + "|" + u
}

///| Keeps where the person had scrolled the entry being left (before a navigation away from it).
fn Tab::keep_scroll(self : Tab) -> Unit {
  if self.at >= 0 && self.at < self.history.length() {
    let y = page::shown_y()
    let key = scroll_key(self.at, self.history[self.at])
    let kept : Array[(String, Double)] = []
    for e in self.history_scroll {
      if e.0 != key {
        kept.push(e)
      }
    }
    if y > 0.5 {
      kept.push((key, y))
    }
    // (and in the workspace tab's own entry: kept when the person switches to another tab and comes back)
    ws_keep_scroll(y)
    self.history_scroll.clear()
    // (the newest 64 entries' places)
    let from = if kept.length() > 64 { kept.length() - 64 } else { 0 }
    let mut i = from
    while i < kept.length() {
      self.history_scroll.push(kept[i])
      i += 1
    }
  }
}

fn Tab::kept_scroll(self : Tab, k : Int) -> Option[Double] {
  if k < 0 || k >= self.history.length() {
    return None
  }
  let key = scroll_key(k, self.history[k])
  for e in self.history_scroll {
    if e.0 == key {
      return Some(e.1)
    }
  }
  None
}

let the_tab : page::Ref[Option[Tab]] = page::Ref::{ v: None }

///| How many times the page's history took an address it went to (Tab::went_to): a go that was declined or saved a
///| file leaves it as it was.
let went_count : page::Ref[Int] = page::Ref::{ v: 0 }

fn tab_ways() -> (Bool, Bool) {
  match the_tab.v {
    Some(t) => (t.at > 0, t.at >= 0 && t.at + 1 < t.history.length())
    None => (false, false)
  }
}

fn Tab::go(self : Tab, raw_u : String, post~ : Option[String] = None) -> Unit {
  let u0 = host_apply_url_settings(raw_u)
  let u = if proto::is_start_page_url(u0) { "about:blank" } else { u0 }
  let lower = page::ascii_lower(u)
  if !(lower.starts_with("http://") || lower.starts_with("https://") || lower.starts_with("file:") || lower.starts_with("about:") || lower.starts_with("data:")) {
    note("not a page, stayed: " + u)
    return
  }
  tell_nav_start()
  self.keep_scroll()
  if !load(u, self.w, self.h, post=post) {
    return
  }
  note_title()
  self.went_to(page::url(), page::title(), post is None)
  if post is None {
    save_url(page::url())
    save_space_vault_cookies()
    save_space_vault_permissions()
    ws_on_navigation(self, page::url(), page::title())
    record_host_navigation(page::url(), page::title(), browser_ctx::VisitTransition::Typed)
    save_session_snapshot(self.history, self.at)
  } else {
    ws_on_page_history(self)
  }
}

///| The page went to `u`: a new entry after the current one (those after it let go), or — for an address it is
///| already at, gone to again without a form (Enter on the same address, a link to the page itself) — the current
///| entry in place, as a browser does, its forward entries kept.
fn Tab::went_to(self : Tab, u : String, title : String, replace_same : Bool) -> Unit {
  went_count.v += 1
  if replace_same && self.at >= 0 && self.at < self.history.length() && self.history[self.at] == u {
    if self.at < self.history_titles.length() {
      self.history_titles[self.at] = title
    }
    return
  }
  while self.history.length() > self.at + 1 {
    let _ = self.history.pop()
  }
  while self.history_titles.length() > self.history.length() {
    let _ = self.history_titles.pop()
  }
  while self.history_titles.length() < self.history.length() {
    self.history_titles.push("")
  }
  self.history.push(u)
  self.history_titles.push(title)
  self.at = self.history.length() - 1
}

fn Tab::follow(self : Tab) -> Unit {
  guard page::moved_to() is Some(u) else { return }
  note("moved to " + u)
  self.keep_scroll()
  news.v += 1
  self.went_to(u, page::title(), true)
  save_url(u)
  save_space_vault_cookies()
  save_space_vault_permissions()
  ws_on_navigation(self, u, page::title())
  record_host_navigation(u, page::title(), browser_ctx::VisitTransition::Link)
  save_session_snapshot(self.history, self.at)
  broadcast(wire::encode(wire::Message::Page(u)))
  broadcast(wire::encode(wire::Message::Loaded))
  (on_drawn.v)()
}

fn Tab::run_on(self : Tab, ms~ : Int = 50, net_wait~ : Int = 0) -> Unit {
  page::tick(ms, net_wait=net_wait)
  save_storage()
  note_errors()
  self.follow()
  note_title()
  match page::navigation() {
    Some(u) => {
      note("script went to " + u)
      news.v += 1
      self.go(u)
    }
    None => ()
  }
  let _ = page::fetch_pending()
  if page::changed() {
    send_frame(self.w)
  }
}

fn Tab::settle(self : Tab, ms : Int) -> Unit {
  let mut ran = 0
  let mut quiet = 0
  let t0 = now_ms64()
  while ran < ms || (quiet < 2000 && ran < ms + 10000) {
    let before = news.v
    self.run_on(net_wait=50)
    ran += 50
    quiet = if news.v == before && !page::network_busy() { quiet + 50 } else { 0 }
  }
  note("settled: \{ran} ms of the page's time in \{now_ms64() - t0} ms")
  broadcast(wire::encode(wire::Message::Settled))
}

fn Tab::step(self : Tab, step : Int) -> Unit {
  let k = self.at + step
  if k < 0 || k >= self.history.length() {
    return
  }
  self.keep_scroll()
  self.at = k
  tell_nav_start()
  // (Back/Forward show the entry as it was: its document from the history's own copy when it has one, Reload refetches)
  page::fc_history_nav(step != 0)
  let shown = load(self.history[k], self.w, self.h)
  page::fc_history_nav(false)
  if step != 0 {
    note(if page::fc_last_from_history() { "history: shown from its copy" } else { "history: fetched anew" })
  }
  // (back where the person had scrolled it when they left it, unless the page's scripts scrolled it themselves while
  // it loaded: a place they chose is left as they put it)
  match self.kept_scroll(k) {
    Some(y) => if shown && page::url() == self.history[k] && page::history_scroll_auto() && !page::scripts_scrolled() {
      page::ask_scroll(y)
      // (and the page's own scroll there with it: the client, put there by the host, tells no scroll of its own)
      page::scrolled(y)
      send_frame(self.w)
    }
    None => ()
  }
  note_title()
  if k >= 0 && k < self.history_titles.length() && page::title() != "" {
    self.history_titles[k] = page::title()
  }
  // (the entry now the address it landed on: a redirect on Reload or Back)
  if shown && page::url() != "" && page::url() != self.history[k] {
    self.history[k] = page::url()
  }
  save_url(self.history[k])
  save_space_vault_cookies()
  // (a step through the history, not a new entry: the workspace tab's place in its history moves with it)
  ws_on_page_history(self)
  let _ = ws_broadcast_state()
  save_session_snapshot(self.history, self.at)
}

let focused : page::Ref[Option[(Int, String, Bool)]] = page::Ref::{ v: None }

fn Tab::hit(self : Tab, hit : page::Hit) -> Unit {
  match hit {
    page::Hit::Go(u) => self.go(u)
    page::Hit::Post(u, data) => self.go(u, post=Some(data))
    page::Hit::Field(id, fx, fy, fw, fh, v, multi, secret) => {
      focused.v = Some((id, v, multi))
      frame_drawn()
      broadcast(wire::encode(wire::Message::Focus(id, fx, fy, fw, fh, v, multi, secret)))
    }
    page::Hit::Nothing => ()
  }
}

fn Tab::take(self : Tab, m : wire::Message, agent : Bool, reply_sock~ : Int = -1) -> Unit {
  match m {
    wire::Message::Hello(cw, ch, _) => {
      note("hello \{cw}x\{ch}")
      let (lw, lh) = self.vp.on_wire_hello(cw, ch)
      self.w = lw
      self.h = lh
    }
    wire::Message::Settle(ms) => self.settle(ms)
    wire::Message::Tap(x, y) => {
      note("tap \{x},\{y} on \{page::url()}")
      self.hit(page::tap(x, y))
      boost_zap_collect()
    }
    wire::Message::Pointer(k, x, y) => page::pointer(k, x, y)
    wire::Message::Input(id, v) => self.hit(page::typed(id, v))
    wire::Message::Enter(id) => self.hit(page::enter(id))
    wire::Message::Go(u) => self.go(address(u))
    wire::Message::Back => self.step(-1)
    wire::Message::Forward => self.step(1)
    wire::Message::Reload => self.step(0)
    wire::Message::Scroll(y) => page::scrolled(y)
    wire::Message::Zoom(z) => self.apply_zoom(z)
    wire::Message::Act("zoom", z_str, base_wh) => {
      match proto::parse_zoom_str(z_str) {
        Some(z) => self.apply_zoom(z, base_wh=base_wh)
        None => ()
      }
    }
    wire::Message::Act("find", query, flags) => {
      let cs = flags.contains("case")
      let ww = flags.contains("word")
      let (idx, total) = page::find_in_page(query, cs, ww)
      broadcast_all(wire::encode(wire::Message::FindResult(idx, total)))
    }
    wire::Message::Act("find_next", _, _) => {
      let (idx, total) = page::find_next()
      broadcast_all(wire::encode(wire::Message::FindResult(idx, total)))
    }
    wire::Message::Act("find_prev", _, _) => {
      let (idx, total) = page::find_prev()
      broadcast_all(wire::encode(wire::Message::FindResult(idx, total)))
    }
    wire::Message::Act("find_clear", _, _) => {
      page::find_clear()
      broadcast_all(wire::encode(wire::Message::FindResult(-1, 0)))
    }
    wire::Message::Act("omnibox", query, req_id) => {
      let raw_json = host_omnibox_results_json(query)
      let payload = if req_id != "" {
        proto::encode_omnibox_envelope(req_id, raw_json)
      } else {
        raw_json
      }
      let frame = wire::encode(wire::Message::OmniboxResults(payload))
      if reply_sock >= 0 {
        let _ = net::send(reply_sock, frame)
      } else if !agent {
        broadcast_all(frame)
      }
    }
    wire::Message::Act("search_suggest", query, _) => {
      if !agent {
        search_suggest_ask(query, reply_sock)
      }
    }
    wire::Message::Act("omnibox_seed", url, title) => {
      seed_host_omnibox_entry(url, title, 1)
    }
    wire::Message::Act(verb, sel, text) => {
      match ws_handle_act(self, verb, sel, text, reply_sock=reply_sock, agent=agent) {
        Some(_) => ()
        None => {
          note((if agent { "agent " } else { "" }) + "act \{verb} \{sel}")
          self.hit(page::act(verb, sel, text))
          note_errors()
        }
      }
    }
    wire::Message::ComposeStart(data) => page::compose_start(data=data)
    wire::Message::ComposeUpdate(data) => page::compose_update(data)
    wire::Message::ComposeEnd(data) => page::compose_end(data)
    wire::Message::Copy => {
      let _ = page::copy_selection()
    }
    wire::Message::Cut => {
      let _ = page::cut_selection()
    }
    wire::Message::Paste(text) => {
      let _ = page::paste_text(text=text)
    }
    wire::Message::SelectAll => {
      let _ = page::select_all()
    }
    _ => ()
  }
}

fn takes_back(m : wire::Message) -> Bool {
  match m {
    wire::Message::Tap(_, _) | wire::Message::Input(_, _) | wire::Message::Enter(_) | wire::Message::Go(_) | wire::Message::Back | wire::Message::Forward | wire::Message::Reload | wire::Message::Act(_, _, _) | wire::Message::TakeOver | wire::Message::Pointer(_, _, _) | wire::Message::ComposeStart(_) | wire::Message::ComposeUpdate(_) | wire::Message::ComposeEnd(_) | wire::Message::Copy | wire::Message::Cut | wire::Message::Paste(_) | wire::Message::SelectAll | wire::Message::Zoom(_) => true
    _ => false
  }
}

fn serve(sock : Int, start : String, agent_port : Int) -> Unit {
  init_host_space()
  media_prefs_from_env()
  let viewer = Viewer::new(sock)
  viewers.push(viewer)
  let framer = viewer.framer
  let tab = Tab::{ w: 1280.0, h: 800.0, vp: proto::ZoomViewportState::new(1280.0, 800.0), history: [], history_titles: [], history_scroll: [], at: -1 }
  the_tab.v = Some(tab)
  if !page::is_host_ephemeral() {
    page::storage_load(read_file_text(storage_file()).unwrap_or(""))
  }
  let restored_nav = restore_session_snapshot()
  let start_tab_initial = fn() -> Unit {
    match restored_nav {
      Some((urls, idx)) if urls.length() > 0 => {
        for u in urls {
          tab.history.push(u)
          tab.history_titles.push("")
        }
        tab.at = idx
        let _ = load(tab.history[tab.at], tab.w, tab.h)
        note_title()
        if tab.at >= 0 && tab.at < tab.history_titles.length() {
          tab.history_titles[tab.at] = page::title()
        }
        save_url(tab.history[tab.at])
      }
      _ =>
      if tab.at >= 0 && tab.at < tab.history.length() && tab.history[tab.at] == start {
        let _ = load(start, tab.w, tab.h)
        note_title()
        if tab.at >= 0 && tab.at < tab.history_titles.length() && page::title() != "" {
          tab.history_titles[tab.at] = page::title()
        }
        save_url(start)
      } else {
        tab.go(start)
      }
    }
    init_host_workspace(page::url(), page::title())
  }
  let agents = if agent_port > 0 { net::listen(agent_port) } else { -1 }
  let agent : page::Ref[Int] = page::Ref::{ v: -1 }
  let agent_framer = wire::Framer::new()
  let end_agent = fn(why : String) -> Unit {
    if agent.v >= 0 {
      note("agent off: " + why)
      let _ = net::send(agent.v, wire::encode(wire::Message::Taken))
      net::close(agent.v)
      agent.v = -1
      agent_said(viewer, false)
    }
  }
  let mut open = true
  let mut started = false
  while open {
    let poll_ms = if agent.v >= 0 || (started && (page::network_busy() || page::has_active_media() || page::has_active_gif_animations())) { 10 } else { 50 }
    match net::recv(sock, poll_ms) {
      None => open = false
      Some(chunk) => {
        framer.push(chunk)
        let mut seq = -1
        while framer.next() is Some(body) {
          if proto::is_doc_wire(body) {
            guard proto::decode_client(body) is Some(cm) else { continue }
            match cm {
              proto::ClientMsg::Hello(ver, caps) => {
                viewer.doc = Some(DocClient::new(caps.contains("png"), hello_ver=ver))
                sync_audio_clients_flag()
                continue
              }
              _ => ()
            }
            guard viewer.doc is Some(d) else { continue }
            match cm {
              proto::ClientMsg::Nav(6, _) => {
                end_agent("the person took the tab back")
                continue
              }
              _ => ()
            }
            if tab.doc_take(sock, d, cm) {
              end_agent("the person took the tab back")
            }
            match cm {
              proto::ClientMsg::Viewport(_, _, _) if !started => {
                started = true
                start_tab_initial()
              }
              _ => ()
            }
            if started {
              send_frame(tab.w)
            }
            continue
          }
          guard wire::decode(body) is Some(m) else { continue }
          if takes_back(m) {
            end_agent("the person took the tab back")
          }
          match m {
            wire::Message::Person(json) => {
              if caps_said(viewer, json) && started {
                send_frame(tab.w)
              }
              if tab.person_said(sock, json) {
                end_agent("the person took the tab back")
              }
            }
            wire::Message::BoxScroll(id, x, y) => box_scrolled(id, x, y)
            wire::Message::Seq(n) => seq = n
            _ => tab.take(m, false, reply_sock=sock)
          }
          save_storage()
          if takes_back(m) {
            if page::changed() {
              send_frame(tab.w)
            }
          }
          match m {
            wire::Message::Hello(_, _, _) if !started => {
              started = true
              start_tab_initial()
              send_frame(tab.w)
            }
            _ => ()
          }
        }
        if started && page::changed() {
          send_frame(tab.w)
        }
        if started && viewer.doc is None {
          tell_marks(fn(b) { let _ = net::send(sock, b) })
          tell_box_scrolls(fn(b) { let _ = net::send(sock, b) })
        }
        if seq >= 0 {
          let _ = net::send(sock, wire::encode(wire::Message::Acked(seq)))
        }
      }
    }
    if agents >= 0 && agent.v < 0 && started {
      let a = net::accept_now(agents)
      if a >= 0 {
        agent.v = a
        agent_framer.clear()
        note("agent on")
        agent_said(viewer, true)
      }
    }
    if agent.v >= 0 {
      match net::recv(agent.v, 0) {
        None => end_agent("it left")
        Some(chunk) => {
          agent_framer.push(chunk)
          while agent.v >= 0 && agent_framer.next() is Some(body) {
            if wire::decode(body) is Some(m) {
              let _ = net::send(agent.v, wire::encode(tab.agent_asks(m)))
            }
          }
        }
      }
    }
    if net::parent_gone() && !page::env_has("FV_NO_FORK") {
      open = false
    }
    if started {
      tab.run_on()
    }
  }
  peek_reset_on_disconnect()
  if agent.v >= 0 {
    net::close(agent.v)
  }
  if agents >= 0 {
    net::close(agents)
  }
  save_storage()
  save_space_vault_cookies()
  save_space_vault_permissions()
  save_space_vault_history()
  save_session_snapshot(tab.history, tab.at)
}

fn address(typed : String) -> String {
  host_resolve_address(typed)
}

///| What the client will show pages as, said by whoever started this host (FV_PREFERS_DARK=1|0, FV_DPR=<ratio>), so
///| the first page loaded before any viewer connects is already dark and picks its pictures for the display: a script
///| that reads `matchMedia('(prefers-color-scheme: dark)').matches` once at load, or a `srcset`, would otherwise see
///| light and 1x until the viewer's MediaPrefs come.
fn media_prefs_from_env() -> Unit {
  let (dark, dpr) = media_prefs_said(page::env_var("FV_PREFERS_DARK"), page::env_var("FV_DPR"))
  page::set_media_prefs(dark, dpr)
}

fn media_prefs_said(dark_env : Option[String], dpr_env : Option[String]) -> (Bool, Double) {
  let dark = match dark_env {
    Some(v) => v.trim() == "1" || v.trim() == "true"
    None => css::media_prefers_dark()
  }
  let dpr = match dpr_env {
    Some(v) => {
      let d = css::parse_double(v.trim())
      if d >= 0.5 && d <= 8.0 { d } else { css::media_dpr() }
    }
    None => css::media_dpr()
  }
  (dark, dpr)
}

fn state_dir() -> Option[String] {
  match page::env_var("FV_STATE_DIR") {
    Some(d) if d != "" => Some(d)
    _ => None
  }
}

fn state_file() -> String {
  match state_dir() {
    Some(d) => d + "/url"
    None => {
      let a = saved_args.v
      let port_s = if a.length() >= 2 { a[a.length() - 2] } else { "0" }
      "farview-host-" + port_s + ".url"
    }
  }
}

fn storage_file() -> String {
  match page::env_var("FV_STORAGE") {
    Some(p) if p != "" => return p
    _ => ()
  }
  match state_dir() {
    Some(d) => d + "/storage.json"
    None => state_file() + ".storage"
  }
}

fn save_storage() -> Unit {
  if page::is_host_ephemeral() {
    return
  }
  match page::storage_dump() {
    Some(text) => net::write_file_atomic(storage_file(), text)
    None => ()
  }
}

fn save_url(u : String) -> Unit {
  if page::is_host_ephemeral() {
    return
  }
  net::write_file_atomic(state_file(), u)
}

fn crash_page(u : String, status : Int) -> String {
  let a = saved_args.v
  let port_s = if a.length() >= 2 { a[1] } else { "0" }
  let path = "farview-host-" + port_s + "-stopped.html"
  let esc = page::str_replace_all(page::str_replace_all(page::str_replace_all(u, "&", "&amp;"), "<", "&lt;"), "\"", "&quot;")
  let html = "<!doctype html><meta name=viewport content=\"width=device-width\"><body style=\"font:16px sans-serif;margin:24px\">" +
  "<h2>Farview stopped on this page</h2><p>The engine ended (status \{status}) while showing</p>" +
  "<p><a href=\"\{esc}\">\{esc}</a></p><p>Tap the address to try again.</p>"
  net::write_file(path, html)
  let cwd = page::env_var("PWD").unwrap_or(".")
  "file://" + cwd + "/" + path
}

fn caps_said(v : Viewer, json : String) -> Bool {
  if json.contains("\"caps\"") && json.contains("\"hover\"") && !v.sent.hovers {
    v.sent.hovers = true
    v.sent.pieces.forget()
    return true
  }
  false
}

fn main(w : World) -> Unit {
  let a = world_args(w)
  saved_args.v = a
  if a.length() >= 4 && a[1] == "--tab" {
    tab_main(w, css::parse_double(a[2]).to_int(), a[3])
    return
  }
  if a.length() >= 6 && a[1] == "--serve-fd" {
    let sock = css::parse_double(a[2]).to_int()
    let agent_port = css::parse_double(a[3]).to_int()
    let url = a[5]
    serve(sock, url, agent_port)
    net::exit(0)
  }
  if a.length() < 3 {
    io_println(w, "usage: pion-host [--tab] <port> <url>")
    return
  }
  let port = css::parse_double(a[1]).to_int()
  let server = net::listen(port)
  if server < 0 {
    io_println(w, "farview host: port \{port} is taken")
    net::exit(1)
  }
  let agent_port = match page::env_var("FV_AGENT_PORT") {
    Some(v) => css::parse_double(v).to_int()
    None => port + 1
  }
  save_url(a[2])
  while true {
    let sock = net::accept(server)
    let url = read_file_text(state_file()).unwrap_or(a[2])
    if page::env_has("FV_NO_FORK") {
      serve(sock, url, agent_port)
      net::close(sock)
      continue
    }
    let pid = net::spawn_self_serve(sock, server, port, agent_port, url)
    net::close(sock)
    if pid > 0 {
      let status = net::wait(pid)
      if status != 0 {
        note("the page process ended with \{status} on \{url}")
        save_url(crash_page(read_file_text(state_file()).unwrap_or(url), status))
      }
    }
  }
}

test "host: omnibox Act unicasts req_id envelope to requesting client only" {
  let srv1 = net::listen_on("127.0.0.1", 0)
  let p1 = net::port_of(srv1)
  let cli1 = net::connect_timeout("127.0.0.1", p1, 2000)
  debug_assert(cli1 >= 0 && net::poll([srv1], 1000) >= 1, "client 1 connect")
  let acc1 = net::accept_now(srv1)
  debug_assert(acc1 >= 0 && net::set_nonblock(cli1, true), "client 1 accept")

  let srv2 = net::listen_on("127.0.0.1", 0)
  let p2 = net::port_of(srv2)
  let cli2 = net::connect_timeout("127.0.0.1", p2, 2000)
  debug_assert(cli2 >= 0 && net::poll([srv2], 1000) >= 1, "client 2 connect")
  let acc2 = net::accept_now(srv2)
  debug_assert(acc2 >= 0 && net::set_nonblock(cli2, true), "client 2 accept")

  let prev_viewers : Array[Viewer] = []
  for v in viewers { prev_viewers.push(v) }
  viewers.clear()
  viewers.push(Viewer::new(acc1))
  viewers.push(Viewer::new(acc2))

  let tab = Tab::{
    w: 1280.0,
    h: 800.0,
    vp: proto::ZoomViewportState::new(1280.0, 800.0),
    history: [],
    history_titles: [], history_scroll: [],
    at: -1,
  }
  seed_host_omnibox_entry("https://unicast.test", "Unicast Hit", 3)
  tab.take(wire::Message::Act("omnibox", "unicast", "c9:42"), false, reply_sock=acc1)

  let _ = net::poll([cli1], 500)
  let buf1 = Bytes::new(4096)
  let mut got1 = 0
  match net::recv_nb(cli1, buf1, 0, 4096) {
    net::NbIo::Bytes(n) => got1 = n
    _ => ()
  }
  debug_assert(got1 > 4, "requesting client 1 received unicast OmniboxResults frame")
  let body1 = buf1.slice(4, got1)
  match wire::decode(body1) {
    Some(wire::Message::OmniboxResults(json)) => {
      let (rid, items) = proto::parse_omnibox_envelope(json)
      debug_assert(rid.unwrap_or("") == "c9:42", "unicast reply carries exact req_id")
      debug_assert(items.length() >= 1 && items[0].url == "https://unicast.test", "unicast reply carries seeded item")
    }
    _ => debug_assert(false, "expected OmniboxResults wire frame on client 1")
  }

  let _ = net::poll([cli2], 30)
  let buf2 = Bytes::new(4096)
  let mut got2 = 0
  match net::recv_nb(cli2, buf2, 0, 4096) {
    net::NbIo::Bytes(n) => got2 = n
    _ => ()
  }
  debug_assert(got2 == 0, "second viewer client 2 received 0 bytes from client 1 omnibox query")

  // Agent omnibox query (agent=true, reply_sock=-1) must NEVER broadcast to human viewers
  tab.take(wire::Message::Act("omnibox", "unicast", ""), true, reply_sock=-1)
  let _ = net::poll([cli1, cli2], 30)
  let mut ag1 = 0
  let mut ag2 = 0
  match net::recv_nb(cli1, buf1, 0, 4096) {
    net::NbIo::Bytes(n) => ag1 = n
    _ => ()
  }
  match net::recv_nb(cli2, buf2, 0, 4096) {
    net::NbIo::Bytes(n) => ag2 = n
    _ => ()
  }
  debug_assert(ag1 == 0 && ag2 == 0, "agent omnibox query broadcasts 0 bytes to human viewers")

  // Agent reader_extract (agent=true, reply_sock=-1) must NEVER broadcast ReaderState to human viewers.
  // First warm up workspace_sync and drain all initial broadcasts on both viewers.
  let _ = ws_handle_act(tab, "workspace_sync", "", "")
  let drain_sock = fn(sock : Int, buf : Bytes) -> Unit {
    let mut tries = 0
    while tries < 8 {
      let _ = net::poll([sock], 15)
      match net::recv_nb(sock, buf, 0, 4096) {
        net::NbIo::Bytes(k) if k > 0 => tries += 1
        _ => break
      }
    }
  }
  drain_sock(cli1, buf1)
  drain_sock(cli2, buf2)

  tab.take(wire::Message::Act("reader_extract", "r-agent:1", ""), true, reply_sock=-1)
  let count_reader_frames = fn(sock : Int, buf : Bytes) -> (Int, Int) {
    let _ = net::poll([sock], 30)
    let n = match net::recv_nb(sock, buf, 0, 4096) {
      net::NbIo::Bytes(k) => k
      _ => 0
    }
    let mut off = 0
    let mut rd_cnt = 0
    while off + 4 <= n {
      let flen = (buf[off].to_int() << 24) |
      (buf[off + 1].to_int() << 16) |
      (buf[off + 2].to_int() << 8) |
      buf[off + 3].to_int()
      if flen <= 0 || off + 4 + flen > n {
        break
      }
      match wire::decode(buf.slice(off + 4, off + 4 + flen)) {
        Some(wire::Message::ReaderState(_)) => rd_cnt += 1
        _ => ()
      }
      off += 4 + flen
    }
    (n, rd_cnt)
  }
  let (rd1_bytes, rd1_frames) = count_reader_frames(cli1, buf1)
  let (rd2_bytes, rd2_frames) = count_reader_frames(cli2, buf2)
  debug_assert(
    rd1_frames == 0 && rd2_frames == 0 && rd1_bytes == 0 && rd2_bytes == 0,
    "agent reader_extract broadcasts 0 ReaderState frames (rd1=" +
    rd1_frames.to_string() +
    "/" +
    rd1_bytes.to_string() +
    "B rd2=" +
    rd2_frames.to_string() +
    "/" +
    rd2_bytes.to_string() +
    "B)",
  )

  viewers.clear()
  for v in prev_viewers { viewers.push(v) }
  net::close(cli1)
  net::close(acc1)
  net::close(srv1)
  net::close(cli2)
  net::close(acc2)
  net::close(srv2)
}

extern "C" fn host_test_unlink(path : Ptr) -> Int = "unlink"

extern "C" fn host_test_rmdir(path : Ptr) -> Int = "rmdir"

fn host_test_cstr(s : String) -> Bytes {
  let b = s.to_bytes()
  let out = Bytes::new(b.length() + 1)
  let mut i = 0
  while i < b.length() {
    out[i] = b[i]
    i += 1
  }
  out[b.length()] = 0.to_byte()
  out
}

test "host: export_pdf & downloads_clear unicast receipts, multi-viewer isolation, zero replay & deduped filename" {
  let srv1 = net::listen_on("127.0.0.1", 0)
  let p1 = net::port_of(srv1)
  let cli1 = net::connect_timeout("127.0.0.1", p1, 2000)
  debug_assert(cli1 >= 0 && net::poll([srv1], 1000) >= 1, "client 1 connect")
  let acc1 = net::accept_now(srv1)
  debug_assert(acc1 >= 0 && net::set_nonblock(cli1, true), "client 1 accept")

  let srv2 = net::listen_on("127.0.0.1", 0)
  let p2 = net::port_of(srv2)
  let cli2 = net::connect_timeout("127.0.0.1", p2, 2000)
  debug_assert(cli2 >= 0 && net::poll([srv2], 1000) >= 1, "client 2 connect")
  let acc2 = net::accept_now(srv2)
  debug_assert(acc2 >= 0 && net::set_nonblock(cli2, true), "client 2 accept")

  let prev_viewers : Array[Viewer] = []
  for v in viewers { prev_viewers.push(v) }
  viewers.clear()
  viewers.push(Viewer::new(acc1))
  viewers.push(Viewer::new(acc2))

  let tab = Tab::{
    w: 1280.0,
    h: 800.0,
    vp: proto::ZoomViewportState::new(1280.0, 800.0),
    history: [],
    history_titles: [], history_scroll: [],
    at: -1,
  }
  let read_all_dl_envs = fn(sock : Int, first_ms : Int) -> Array[proto::DownloadsSnapshotEnvelope] {
    let acc_bytes : Array[Byte] = []
    let tmp = Bytes::new(16384)
    let mut wait = first_ms
    let mut rounds = 0
    while rounds < 20 {
      if net::poll([sock], wait) <= 0 {
        break
      }
      match net::recv_nb(sock, tmp, 0, 16384) {
        net::NbIo::Bytes(n) if n > 0 => {
          let mut i = 0
          while i < n {
            acc_bytes.push(tmp[i])
            i += 1
          }
          wait = 50
        }
        _ => break
      }
      rounds += 1
    }
    let total = acc_bytes.length()
    let raw = Bytes::new(total)
    let mut k = 0
    while k < total {
      raw[k] = acc_bytes[k]
      k += 1
    }
    let envs : Array[proto::DownloadsSnapshotEnvelope] = []
    let mut off = 0
    while off + 4 <= total {
      let flen = (raw[off].to_int() << 24) |
      (raw[off + 1].to_int() << 16) |
      (raw[off + 2].to_int() << 8) |
      raw[off + 3].to_int()
      if flen <= 0 || off + 4 + flen > total {
        break
      }
      match wire::decode(raw.slice(off + 4, off + 4 + flen)) {
        Some(wire::Message::DownloadsState(j)) => envs.push(proto::parse_downloads_envelope(j))
        _ => ()
      }
      off += 4 + flen
    }
    envs
  }

  // 1. Multi-viewer export_pdf isolation with identical req_id "pdf-same-1":
  //    acc1 succeeds (writable tmp dir) -> acc1 gets export_ok=true receipt; acc2 gets ONLY shared broadcast (export_req_id=="")
  let tmp_dir = "/tmp/fv_host_dl_test_" + net::getpid().to_string()
  net::setenv("FV_DOWNLOAD_DIR", tmp_dir)
  tab.take(wire::Message::Act("export_pdf", "__req__:pdf-same-1", ""), false, reply_sock=acc1)
  let e1_ok = read_all_dl_envs(cli1, 300)
  let e2_after_1 = read_all_dl_envs(cli2, 80)
  let mut acc1_got_ok = false
  let mut saved_f1 = ""
  for e in e1_ok {
    if e.export_req_id == "pdf-same-1" && e.export_ok && e.export_filename.ends_with(".pdf") {
      acc1_got_ok = true
      saved_f1 = e.export_filename
    }
  }
  debug_assert(acc1_got_ok, "acc1 received unicast export_ok=true receipt for pdf-same-1")
  for e in e2_after_1 {
    debug_assert(e.export_req_id == "", "acc2 shared broadcast must NOT carry acc1 export_req_id")
  }

  //    Second export on acc1 verifies deduped filename (`... (1).pdf`)
  tab.take(wire::Message::Act("export_pdf", "__req__:pdf-ok-2", ""), false, reply_sock=acc1)
  let e1_ok2 = read_all_dl_envs(cli1, 300)
  let _ = read_all_dl_envs(cli2, 50)
  let mut acc1_got_dedup = false
  let mut saved_f2 = ""
  for e in e1_ok2 {
    if e.export_req_id == "pdf-ok-2" && e.export_ok && e.export_filename.contains("(1).pdf") {
      acc1_got_dedup = true
      saved_f2 = e.export_filename
    }
  }
  debug_assert(acc1_got_dedup, "second export_pdf reported deduped basename (1).pdf")

  //    acc2 fails (unwritable dir) with SAME req_id "pdf-same-1" -> acc2 gets export_ok=false; acc1 gets 0 frames!
  let blocker = tmp_dir + "/not_a_dir"
  net::write_file(blocker, "x")
  net::setenv("FV_DOWNLOAD_DIR", blocker + "/farview_unwritable_dir")
  tab.take(wire::Message::Act("export_pdf", "__req__:pdf-same-1", ""), false, reply_sock=acc2)
  let e2_fail = read_all_dl_envs(cli2, 300)
  let e1_after_2 = read_all_dl_envs(cli1, 50)
  let mut acc2_got_fail = false
  for e in e2_fail {
    if e.export_req_id == "pdf-same-1" && !e.export_ok && e.export_filename == "" {
      acc2_got_fail = true
    }
  }
  debug_assert(acc2_got_fail, "acc2 received unicast export_ok=false receipt for pdf-same-1")
  debug_assert(e1_after_2.length() == 0, "acc1 received 0 DownloadsState frames on acc2 write failure")

  // 2. downloads_sync NEVER replays historical export_req_id!
  tab.take(wire::Message::Act("downloads_sync", "", ""), false, reply_sock=acc1)
  let e1_sync = read_all_dl_envs(cli1, 300)
  let _ = read_all_dl_envs(cli2, 50)
  debug_assert(e1_sync.length() >= 1, "downloads_sync delivered snapshot")
  for e in e1_sync {
    debug_assert(e.export_req_id == "" && e.clear_ack_id == "", "downloads_sync never replays export_req_id or clear_ack_id")
  }

  // 3. downloads_clear unicasts clear_ack_id ONLY to requesting viewer (acc1), shared broadcast to acc2 has clear_ack_id == ""
  tab.take(wire::Message::Act("downloads_clear", "clr-host-99", ""), false, reply_sock=acc1)
  let e1_clr = read_all_dl_envs(cli1, 300)
  let e2_clr = read_all_dl_envs(cli2, 80)
  let mut acc1_got_ack = false
  for e in e1_clr {
    if e.clear_ack_id == "clr-host-99" && e.items.length() == 0 && e.clear_seq >= 1 {
      acc1_got_ack = true
    }
  }
  debug_assert(acc1_got_ack, "acc1 received unicast clear_ack_id=clr-host-99")
  debug_assert(e2_clr.length() >= 1, "acc2 received shared empty broadcast on clear")
  for e in e2_clr {
    debug_assert(e.clear_ack_id == "" && e.items.length() == 0, "acc2 shared clear broadcast carries empty clear_ack_id")
  }

  // Clean up temporary files/dir
  if saved_f1 != "" {
    let b1 = host_test_cstr(tmp_dir + "/" + saved_f1)
    let _ = host_test_unlink(bytes_data_ptr(b1))
  }
  if saved_f2 != "" {
    let b2 = host_test_cstr(tmp_dir + "/" + saved_f2)
    let _ = host_test_unlink(bytes_data_ptr(b2))
  }
  let bd = host_test_cstr(tmp_dir)
  let _ = host_test_rmdir(bytes_data_ptr(bd))
  net::setenv("FV_DOWNLOAD_DIR", "")
  viewers.clear()
  for v in prev_viewers { viewers.push(v) }
  net::close(cli1)
  net::close(acc1)
  net::close(srv1)
  net::close(cli2)
  net::close(acc2)
  net::close(srv2)
}

test "host: 257 downloads stay cleared across downloads_clear and host_clear_browsing_data, 258th visible" {
  let tmp_dir = "/tmp/fv_host_dl257_" + net::getpid().to_string()
  net::setenv("FV_DOWNLOAD_DIR", tmp_dir)
  let saved_paths : Array[String] = []
  let body = "x".to_bytes()
  let mut i = 0
  while i < 257 {
    match page::save_download("https://dl.test/" + i.to_string(), "item_" + i.to_string() + ".bin", body, mime="application/octet-stream") {
      Some(p) => saved_paths.push(p)
      None => debug_assert(false, "save_download succeeded for item " + i.to_string())
    }
    i += 1
  }

  // 1. Clear via downloads_clear -> dl_current_items() empty (257th never reappears)
  host_clear_downloads_state()
  let after_dl_clr = proto::parse_downloads_envelope(dl_current_json(), max_items=1000)
  debug_assert(after_dl_clr.items.length() == 0, "downloads_clear cleared all 257 items, got: " + after_dl_clr.items.length().to_string())

  // 2. Also clear via Settings Clear Browsing Data ("downloads") -> offset must NOT regress to 256!
  let _ = host_clear_browsing_data("downloads")
  let after_settings_clr = proto::parse_downloads_envelope(dl_current_json(), max_items=1000)
  debug_assert(after_settings_clr.items.length() == 0, "settings clear_browsing_data kept 257 items cleared (no 256 regression), got: " + after_settings_clr.items.length().to_string())

  // 3. Add 258th download -> ONLY the 258th item is visible!
  match page::save_download("https://dl.test/258", "item_258.bin", body, mime="application/octet-stream") {
    Some(p) => saved_paths.push(p)
    None => debug_assert(false, "save_download succeeded for item 258")
  }
  let after_258 = proto::parse_downloads_envelope(dl_current_json(), max_items=1000)
  debug_assert(after_258.items.length() == 1 && after_258.items[0].filename == "item_258.bin", "only 258th item visible after clearing 257, got len=" + after_258.items.length().to_string())

  // Clean up temp files & dir
  for p in saved_paths {
    let bp = host_test_cstr(p)
    let _ = host_test_unlink(bytes_data_ptr(bp))
  }
  let bd = host_test_cstr(tmp_dir)
  let _ = host_test_rmdir(bytes_data_ptr(bd))
  net::setenv("FV_DOWNLOAD_DIR", "")
}

test "host: export_pdf with config reqId followed by tab_switch(B) exports A page, not B" {
  let srv = net::listen_on("127.0.0.1", 0)
  let port = net::port_of(srv)
  let cli = net::connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli >= 0 && net::poll([srv], 1000) >= 1, "client connect")
  let acc = net::accept_now(srv)
  debug_assert(acc >= 0 && net::set_nonblock(cli, true), "client accept")

  let prev_viewers : Array[Viewer] = []
  for v in viewers { prev_viewers.push(v) }
  viewers.clear()
  viewers.push(Viewer::new(acc))

  let tab = Tab::{
    w: 1280.0,
    h: 800.0,
    vp: proto::ZoomViewportState::new(1280.0, 800.0),
    history: [],
    history_titles: [], history_scroll: [],
    at: -1,
  }
  let tmp_dir = "/tmp/fv_host_fifo_" + net::getpid().to_string()
  net::setenv("FV_DOWNLOAD_DIR", tmp_dir)

  // Load distinct Page A ("Farview Alpha Doc") via offline data: URL
  let url_a = "data:text/html,%3C!doctype%20html%3E%3Chtml%3E%3Chead%3E%3Ctitle%3EFarview%20Alpha%20Doc%3C/title%3E%3C/head%3E%3Cbody%3E%3Ch1%3EAlpha%20Page%20Content%3C/h1%3E%3C/body%3E%3C/html%3E"
  let _ = page::load(url_a, 1280.0, 800.0)
  let cfg_json = proto::encode_print_pdf_config_with_req(proto::print_pdf_default_config(), "pdf-fifo-a1")

  // Strict TCP FIFO: export_pdf(a="", b has reqId) arrives before tab_switch / load of Page B!
  tab.take(wire::Message::Act("export_pdf", "", cfg_json), false, reply_sock=acc)
  let url_b = "data:text/html,%3C!doctype%20html%3E%3Chtml%3E%3Chead%3E%3Ctitle%3EFarview%20Beta%20Spec%3C/title%3E%3C/head%3E%3Cbody%3E%3Ch1%3EBeta%20Page%20Content%3C/h1%3E%3C/body%3E%3C/html%3E"
  let _ = page::load(url_b, 1280.0, 800.0)
  tab.take(wire::Message::Act("tab_switch", "tab-b", ""), false, reply_sock=acc)

  // Loop-buffer read all DownloadsState frames
  let acc_bytes : Array[Byte] = []
  let tmp = Bytes::new(16384)
  let mut wait = 300
  let mut rounds = 0
  while rounds < 20 {
    if net::poll([cli], wait) <= 0 {
      break
    }
    match net::recv_nb(cli, tmp, 0, 16384) {
      net::NbIo::Bytes(n) if n > 0 => {
        let mut i = 0
        while i < n {
          acc_bytes.push(tmp[i])
          i += 1
        }
        wait = 50
      }
      _ => break
    }
    rounds += 1
  }
  let total = acc_bytes.length()
  let raw = Bytes::new(total)
  let mut k = 0
  while k < total {
    raw[k] = acc_bytes[k]
    k += 1
  }
  let mut got_a_receipt = false
  let mut saved_fname = ""
  let mut off = 0
  while off + 4 <= total {
    let flen = (raw[off].to_int() << 24) |
    (raw[off + 1].to_int() << 16) |
    (raw[off + 2].to_int() << 8) |
    raw[off + 3].to_int()
    if flen <= 0 || off + 4 + flen > total {
      break
    }
    match wire::decode(raw.slice(off + 4, off + 4 + flen)) {
      Some(wire::Message::DownloadsState(j)) => {
        let env = proto::parse_downloads_envelope(j)
        if env.export_req_id == "pdf-fifo-a1" {
          debug_assert(env.export_ok, "FIFO export_pdf succeeded")
          debug_assert(env.export_filename.contains("Farview-Alpha-Doc") && !env.export_filename.contains("Beta"), "Exported PDF filename belongs to Page A, not B: " + env.export_filename)
          got_a_receipt = true
          saved_fname = env.export_filename
        }
      }
      _ => ()
    }
    off += 4 + flen
  }
  debug_assert(got_a_receipt, "Received unicast receipt for pdf-fifo-a1")

  if saved_fname != "" {
    let bf = host_test_cstr(tmp_dir + "/" + saved_fname)
    let _ = host_test_unlink(bytes_data_ptr(bf))
  }
  let bd2 = host_test_cstr(tmp_dir)
  let _ = host_test_rmdir(bytes_data_ptr(bd2))
  net::setenv("FV_DOWNLOAD_DIR", "")
  viewers.clear()
  for v in prev_viewers { viewers.push(v) }
  net::close(cli)
  net::close(acc)
  net::close(srv)
}

test "host: save_download & DownloadsState preserve real absolute paths across colliding captures" {
  let tmp_dir = "/tmp/fv-capture-e2e-host"
  let b1_pre = host_test_cstr(tmp_dir + "/capture-e2e.png")
  let b2_pre = host_test_cstr(tmp_dir + "/capture-e2e (1).png")
  let _ = host_test_unlink(bytes_data_ptr(b1_pre))
  let _ = host_test_unlink(bytes_data_ptr(b2_pre))
  net::setenv("FV_DOWNLOAD_DIR", tmp_dir)
  host_clear_downloads_state()

  let fake_png = Bytes::new(8)
  fake_png[0] = b'\x89'
  fake_png[1] = b'P'
  fake_png[2] = b'N'
  fake_png[3] = b'G'
  let p1 = page::save_download("about:capture", "capture-e2e.png", fake_png, mime="image/png")
  let p2 = page::save_download("about:capture", "capture-e2e.png", fake_png, mime="image/png")
  match (p1, p2) {
    (Some(path1), Some(path2)) => {
      debug_assert(path1 == tmp_dir + "/capture-e2e.png", "first capture saved to exact custom absolute path: " + path1)
      debug_assert(path2 == tmp_dir + "/capture-e2e (1).png", "second colliding capture saved with deduped absolute path: " + path2)
      let items = proto::parse_downloads_state(dl_current_json())
      debug_assert(items.length() >= 2, "dl_current_json emitted both captures")
      let meta2 = proto::capture_sheet_from_download(items[0], 1280, 800)
      let meta1 = proto::capture_sheet_from_download(items[1], 1280, 800)
      debug_assert(meta2.path == path2 && !meta2.path.starts_with("~/Downloads/"), "newest CaptureSheetMeta preserves real deduped absolute path: " + meta2.path)
      debug_assert(meta1.path == path1 && !meta1.path.starts_with("~/Downloads/"), "first CaptureSheetMeta preserves real absolute path: " + meta1.path)
      let b1 = host_test_cstr(path1)
      let b2 = host_test_cstr(path2)
      let _ = host_test_unlink(bytes_data_ptr(b1))
      let _ = host_test_unlink(bytes_data_ptr(b2))
    }
    _ => debug_assert(false, "both colliding save_download calls must succeed")
  }
  let bd = host_test_cstr(tmp_dir)
  let _ = host_test_rmdir(bytes_data_ptr(bd))
  net::setenv("FV_DOWNLOAD_DIR", "")
}

test "host: capture_screenshot unicasts export_req_id receipt with real export_path while peer viewer gets shared broadcast" {
  let tmp_dir = "/tmp/fv-capture-unicast-host"
  let b1_pre = host_test_cstr(tmp_dir + "/farview-capture-shot.png")
  let b2_pre = host_test_cstr(tmp_dir + "/farview-capture-shot (1).png")
  let _ = host_test_unlink(bytes_data_ptr(b1_pre))
  let _ = host_test_unlink(bytes_data_ptr(b2_pre))
  net::setenv("FV_DOWNLOAD_DIR", tmp_dir)
  host_clear_downloads_state()

  let srv = net::listen_on("127.0.0.1", 0)
  let port = net::port_of(srv)
  let cli1 = net::connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli1 >= 0 && net::poll([srv], 1000) >= 1, "cli1 connect")
  let acc1 = net::accept_now(srv)
  let cli2 = net::connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli2 >= 0 && net::poll([srv], 1000) >= 1, "cli2 connect")
  let acc2 = net::accept_now(srv)
  let _ = net::set_nonblock(cli1, true)
  let _ = net::set_nonblock(cli2, true)
  let prev_viewers : Array[Viewer] = []
  for v in viewers { prev_viewers.push(v) }
  viewers.clear()
  viewers.push(Viewer::new(acc1))
  viewers.push(Viewer::new(acc2))

  let tab = Tab::{
    w: 1280.0,
    h: 800.0,
    vp: proto::ZoomViewportState::new(1280.0, 800.0),
    history: [],
    history_titles: [], history_scroll: [],
    at: -1,
  }
  let _ = page::load("data:text/html,<title>Shot</title><h1>Capture</h1>", 1280.0, 800.0)
  // First capture creates farview-capture-shot.png; second collides -> farview-capture-shot (1).png
  tab.take(wire::Message::Act("capture_screenshot", "shot", "shot-req-1"), false, reply_sock=acc1)
  tab.take(wire::Message::Act("capture_screenshot", "shot", "shot-req-2"), false, reply_sock=acc1)

  let read_envelopes = fn(sock : Int) -> Array[proto::DownloadsSnapshotEnvelope] {
    let acc_bytes : Array[Byte] = []
    let tmp = Bytes::new(16384)
    let mut wait = 250
    let mut rounds = 0
    while rounds < 20 {
      if net::poll([sock], wait) <= 0 {
        break
      }
      match net::recv_nb(sock, tmp, 0, 16384) {
        net::NbIo::Bytes(n) if n > 0 => {
          let mut i = 0
          while i < n {
            acc_bytes.push(tmp[i])
            i += 1
          }
          wait = 40
        }
        _ => break
      }
      rounds += 1
    }
    let total = acc_bytes.length()
    let raw = Bytes::new(total)
    let mut k = 0
    while k < total {
      raw[k] = acc_bytes[k]
      k += 1
    }
    let out : Array[proto::DownloadsSnapshotEnvelope] = []
    let mut off = 0
    while off + 4 <= total {
      let flen = (raw[off].to_int() << 24) |
      (raw[off + 1].to_int() << 16) |
      (raw[off + 2].to_int() << 8) |
      raw[off + 3].to_int()
      if flen <= 0 || off + 4 + flen > total {
        break
      }
      match wire::decode(raw.slice(off + 4, off + 4 + flen)) {
        Some(wire::Message::DownloadsState(j)) => out.push(proto::parse_downloads_envelope(j))
        _ => ()
      }
      off += 4 + flen
    }
    out
  }

  let envs1 = read_envelopes(cli1)
  let envs2 = read_envelopes(cli2)
  let mut got_receipt2 = false
  for e in envs1 {
    if e.export_req_id == "shot-req-2" {
      debug_assert(e.export_ok && e.capture_receipt, "capture_screenshot receipt export_ok && capture_receipt == true")
      debug_assert(e.export_filename == "farview-capture-shot (1).png", "deduped export_filename: " + e.export_filename)
      debug_assert(e.export_path == tmp_dir + "/farview-capture-shot (1).png", "real absolute export_path: " + e.export_path)
      got_receipt2 = true
    }
  }
  debug_assert(got_receipt2, "requesting viewer received unicast shot-req-2 receipt")
  debug_assert(envs2.length() > 0, "peer viewer received shared DownloadsState broadcast")
  for e in envs2 {
    debug_assert(e.export_req_id == "" && e.capture_receipt, "peer viewer gets capture_receipt=true shared broadcast without requester's export_req_id: got=" + e.export_req_id)
  }

  let _ = host_test_unlink(bytes_data_ptr(b1_pre))
  let _ = host_test_unlink(bytes_data_ptr(b2_pre))
  let bd = host_test_cstr(tmp_dir)
  let _ = host_test_rmdir(bytes_data_ptr(bd))
  net::setenv("FV_DOWNLOAD_DIR", "")
  viewers.clear()
  for v in prev_viewers { viewers.push(v) }
  net::close(cli1)
  net::close(acc1)
  net::close(cli2)
  net::close(acc2)
  net::close(srv)
}

test "host: site boosts preserve www. vs bare domain independently across save and reset" {
  init_host_boosts()
  let saved_entries : Array[proto::SiteBoost] = []
  for b in boost_entries { saved_entries.push(b) }
  boost_entries.clear()

  let b_bare = proto::SiteBoost::{
    ..proto::SiteBoost::default_for(""),
    host: "beta.example",
    enabled: true,
    theme: "sepia",
    font: "serif",
    scale_pct: 110,
    hide_sticky: false,
    custom_css: "body { color: #222; }",
  }
  let b_www = proto::SiteBoost::{
    ..proto::SiteBoost::default_for(""),
    host: "www.beta.example",
    enabled: true,
    theme: "dark",
    font: "mono",
    scale_pct: 120,
    hide_sticky: true,
    custom_css: "p { color: teal; }",
  }
  let _ = boost_save_and_broadcast(proto::encode_site_boost(b_bare))
  let _ = boost_save_and_broadcast(proto::encode_site_boost(b_www))
  debug_assert(boost_entries.length() == 2, "bare and www. boosts stored as 2 distinct entries")

  // Resetting www.beta.example MUST leave bare beta.example intact and not fall back to v2 bare
  let _ = boost_reset_and_broadcast("www.beta.example")
  debug_assert(boost_entries.length() == 1 && boost_entries[0].host == "beta.example" && boost_entries[0].theme == "sepia", "resetting www. preserved bare domain boost")
  debug_assert(
    proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, "https://www.beta.example/") is None,
    "after resetting v2 www.beta.example it does not inherit v2 bare beta.example",
  )

  // Legacy v1 boosts.json compatibility: bare entry without version applies to www.example.com and resets via www.example.com
  boost_entries.clear()
  boost_legacy_bare.clear()
  let v1_seed = "{\"items\":[{\"host\":\"example.com\",\"enabled\":true,\"theme\":\"dark\"}]}"
  match proto::parse_boosts_snapshot_with_legacy(v1_seed) {
    Some((snap, legacy)) => {
      for it in snap.items { boost_entries.push(it) }
      for lh in legacy { boost_legacy_bare.push(lh) }
    }
    None => debug_assert(false, "parse v1 seed")
  }
  match proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, "https://www.example.com/") {
    Some(b) => debug_assert(b.theme == "dark" && b.enabled, "v1 legacy bare entry applies to www.example.com")
    None => debug_assert(false, "expected v1 legacy fallback on www.example.com")
  }
  let _ = boost_reset_and_broadcast("www.example.com")
  debug_assert(boost_entries.length() == 0 && boost_legacy_bare.length() == 0, "resetting www.example.com cleared v1 legacy bare entry")

  // Restore original boost entries
  boost_entries.clear()
  boost_legacy_bare.clear()
  for b in saved_entries { boost_entries.push(b) }
}

test "host: Settings clear_browsing_data(boosts) and SiteInfo host_site_clear_data clear v1 legacyBare on disk" {
  let prev_prof = page::env_var("FV_PROFILE_DIR").unwrap_or("")
  let prev_key = page::env_var("FV_VAULT_TEST_KEY").unwrap_or("")
  let saved_entries : Array[proto::SiteBoost] = []
  for b in boost_entries { saved_entries.push(b) }
  let saved_legacy : Array[String] = []
  for lh in boost_legacy_bare { saved_legacy.push(lh) }

  let base = "/tmp/fv_host_boost_r3_" + net::getpid().to_string()
  net::setenv("FV_VAULT_TEST_KEY", "farview-ci-deterministic-vault-key-v1")

  // 1. Settings Clear Browsing Data("boosts") clears both boost_entries and legacyBare from boosts.json
  let dir_all = base + "_all"
  net::setenv("FV_PROFILE_DIR", dir_all)
  init_host_space()
  let path_all = dir_all + "/boosts.json"
  net::write_file_atomic(path_all, "{\"items\":[{\"host\":\"beta.example\",\"enabled\":true,\"theme\":\"dark\"}]}")
  boost_initialized.v = false
  init_host_boosts()
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, "www.beta.example").is_some(), "v1 legacy boost active before clear")
  let reply_all = host_clear_browsing_data("boosts")
  debug_assert(reply_all.contains("boosts"), "clear_browsing_data reported boosts")
  let saved_all = read_file_text(path_all).unwrap_or("missing")
  debug_assert(saved_all != "missing" && !saved_all.contains("beta.example"), "boosts.json cleared legacyBare on disk: " + saved_all)

  // 2. SiteInfo host_site_clear_data("https://www.beta.example") removes effective v1 legacy bare boost on disk
  let dir_site = base + "_site"
  net::setenv("FV_PROFILE_DIR", dir_site)
  init_host_space()
  let path_site = dir_site + "/boosts.json"
  net::write_file_atomic(path_site, "{\"items\":[{\"host\":\"beta.example\",\"enabled\":true,\"theme\":\"dark\"}]}")
  boost_initialized.v = false
  init_host_boosts()
  let reply_site = host_site_clear_data("https://www.beta.example")
  debug_assert(reply_site.contains("boosts"), "host_site_clear_data reported boosts")
  boost_initialized.v = false
  init_host_boosts()
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, "www.beta.example") is None, "v1 legacy boost removed after site clear + reload")

  // Cleanup temp files & restore env/state
  let c1 = host_test_cstr(path_all)
  let _ = host_test_unlink(bytes_data_ptr(c1))
  let c2 = host_test_cstr(dir_all + "/settings.json")
  let _ = host_test_unlink(bytes_data_ptr(c2))
  let c3 = host_test_cstr(dir_all)
  let _ = host_test_rmdir(bytes_data_ptr(c3))
  let c4 = host_test_cstr(path_site)
  let _ = host_test_unlink(bytes_data_ptr(c4))
  let c5 = host_test_cstr(dir_site + "/site_perms.json")
  let _ = host_test_unlink(bytes_data_ptr(c5))
  let c6 = host_test_cstr(dir_site)
  let _ = host_test_rmdir(bytes_data_ptr(c6))
  net::setenv("FV_PROFILE_DIR", prev_prof)
  net::setenv("FV_VAULT_TEST_KEY", prev_key)
  boost_entries.clear()
  for b in saved_entries { boost_entries.push(b) }
  boost_legacy_bare.clear()
  for lh in saved_legacy { boost_legacy_bare.push(lh) }
}

test "host: saving/resetting/clearing www.<bare> revokes v1 legacyBare fallback while preserving bare entry" {
  let prev_prof = page::env_var("FV_PROFILE_DIR").unwrap_or("")
  let prev_key = page::env_var("FV_VAULT_TEST_KEY").unwrap_or("")
  let saved_entries : Array[proto::SiteBoost] = []
  for b in boost_entries { saved_entries.push(b) }
  let saved_legacy : Array[String] = []
  for lh in boost_legacy_bare { saved_legacy.push(lh) }

  let base = "/tmp/fv_host_boost_r4_" + net::getpid().to_string()
  net::setenv("FV_VAULT_TEST_KEY", "farview-ci-deterministic-vault-key-v1")
  let www = "www.beta.example"
  let bare = "beta.example"
  let v1_json = "{\"items\":[{\"host\":\"beta.example\",\"enabled\":true,\"theme\":\"dark\"}]}"

  // 1. Migrated v1 bare -> edit www.beta.example (sepia) -> host_site_clear_data(www) -> reload:
  //    www.beta.example MUST NOT fall back to bare dark, while beta.example keeps dark!
  let dir_clear = base + "_clear"
  net::setenv("FV_PROFILE_DIR", dir_clear)
  init_host_space()
  let path_clear = dir_clear + "/boosts.json"
  net::write_file_atomic(path_clear, v1_json)
  boost_initialized.v = false
  init_host_boosts()
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, www).is_some(), "v1 legacy active before edit")
  let updated = proto::SiteBoost::{ ..proto::SiteBoost::default_for(www), enabled: true, theme: "sepia" }
  let _ = boost_save_and_broadcast(proto::encode_site_boost(updated))
  boost_initialized.v = false
  init_host_boosts()
  match proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, www) {
    Some(b) => debug_assert(b.host == www && b.theme == "sepia", "saved exact www config")
    None => debug_assert(false, "missing saved www config")
  }
  let reply_clear = host_site_clear_data("https://www.beta.example")
  debug_assert(reply_clear.contains("boosts"), "clear reported boosts")
  boost_initialized.v = false
  init_host_boosts()
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, www) is None, "after clear + reload www does not fall back to v1 bare")
  match proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, bare) {
    Some(b) => debug_assert(b.host == bare && b.theme == "dark" && b.enabled, "bare entry preserved after clearing www")
    None => debug_assert(false, "expected bare entry preserved after clearing www")
  }

  // 2. Migrated v1 bare -> edit www.beta.example (sepia) -> boost_reset_and_broadcast(www) -> reload:
  //    www.beta.example MUST NOT fall back to bare dark, while beta.example keeps dark!
  let dir_reset = base + "_reset"
  net::setenv("FV_PROFILE_DIR", dir_reset)
  init_host_space()
  let path_reset = dir_reset + "/boosts.json"
  net::write_file_atomic(path_reset, v1_json)
  boost_initialized.v = false
  init_host_boosts()
  let _ = boost_save_and_broadcast(proto::encode_site_boost(updated))
  let _ = boost_reset_and_broadcast(www)
  boost_initialized.v = false
  init_host_boosts()
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, www) is None, "after reset + reload www does not fall back to v1 bare")
  match proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, bare) {
    Some(b) => debug_assert(b.host == bare && b.theme == "dark" && b.enabled, "bare entry preserved after resetting www")
    None => debug_assert(false, "expected bare entry preserved after resetting www")
  }

  // 3. Explicit v2 saves for both bare and www -> clear www -> v2 bare stays, www is gone
  let dir_fresh = base + "_fresh"
  net::setenv("FV_PROFILE_DIR", dir_fresh)
  init_host_space()
  let path_fresh = dir_fresh + "/boosts.json"
  net::write_file_atomic(path_fresh, v1_json)
  boost_initialized.v = false
  init_host_boosts()
  for h in [bare, www] {
    let b = proto::SiteBoost::{ ..proto::SiteBoost::default_for(h), enabled: true, theme: "sepia" }
    let _ = boost_save_and_broadcast(proto::encode_site_boost(b))
  }
  let _ = host_site_clear_data("https://www.beta.example")
  boost_initialized.v = false
  init_host_boosts()
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, bare).is_some(), "v2 bare stays")
  debug_assert(proto::boosts_find_with_legacy(proto::BoostsSnapshot::{ items: boost_entries }, boost_legacy_bare, www) is None, "v2 www gone")

  // Cleanup temp files & restore env/state
  for f in [
    path_clear,
    dir_clear + "/site_perms.json",
    path_reset,
    path_fresh,
    dir_fresh + "/site_perms.json",
  ] {
    let cf = host_test_cstr(f)
    let _ = host_test_unlink(bytes_data_ptr(cf))
  }
  for d in [dir_clear, dir_reset, dir_fresh] {
    let cd = host_test_cstr(d)
    let _ = host_test_rmdir(bytes_data_ptr(cd))
  }
  net::setenv("FV_PROFILE_DIR", prev_prof)
  net::setenv("FV_VAULT_TEST_KEY", prev_key)
  boost_entries.clear()
  for b in saved_entries { boost_entries.push(b) }
  boost_legacy_bare.clear()
  for lh in saved_legacy { boost_legacy_bare.push(lh) }
}

test "phase3b: host PDF export honors MediaBox paper/orientation, 4-tier margins, background_graphics toggle, and restores screen mode" {
  let tab = Tab::{ w: 1280.0, h: 800.0, vp: proto::ZoomViewportState::new(1280.0, 800.0), history: [], history_titles: [], history_scroll: [], at: -1 }
  let href = "data:text/html,%3Cstyle%3Ehtml,body%7Bmargin:0%7Ddiv%7Bheight:240px;background:%23e03a12%7D%3C/style%3E%3Cdiv%3EPRINT%20ME%3C/div%3E"
  let _ = page::load(href, 1280.0, 800.0)

  let cfg_legal_none = proto::PrintPdfConfig::{ paper: "legal", orientation: "landscape", margins: "none", background_graphics: true }
  let pdf_legal_none = export_pdf_with_config(tab, cfg_legal_none)
  let pdf_legal_wide = export_pdf_with_config(tab, proto::PrintPdfConfig::{ ..cfg_legal_none, margins: "wide" })
  let pdf_legal_nobg = export_pdf_with_config(tab, proto::PrintPdfConfig::{ ..cfg_legal_none, background_graphics: false })
  let pdf_letter = export_pdf_with_config(tab, proto::PrintPdfConfig::{ ..cfg_legal_none, paper: "letter", orientation: "portrait" })
  let pdf_a4 = export_pdf_with_config(tab, proto::print_pdf_default_config())

  debug_assert(pdf_legal_none.to_string().contains("/MediaBox [0 0 1008.00 612.00]"), "Legal Landscape MediaBox 1008x612")
  debug_assert(pdf_letter.to_string().contains("/MediaBox [0 0 612.00 792.00]"), "Letter Portrait MediaBox 612x792")
  debug_assert(pdf_a4.to_string().contains("/MediaBox [0 0 595.28 841.89]"), "A4 Portrait MediaBox 595.28x841.89")
  let bytes_diff = fn(a : Bytes, b : Bytes) -> Bool {
    if a.length() != b.length() {
      return true
    }
    let mut i = 0
    while i < a.length() {
      if a[i] != b[i] {
        return true
      }
      i += 1
    }
    false
  }
  debug_assert(bytes_diff(pdf_legal_wide, pdf_legal_none), "wide margins PDF must differ from none margins")
  debug_assert(bytes_diff(pdf_legal_nobg, pdf_legal_none), "background_graphics=false PDF must differ from true")

  let is_red = fn(px : Bytes, pw : Int, x : Int, y : Int) -> Bool {
    let idx = (y * pw + x) * 4
    let r = px[idx].to_int() & 0xFF
    let g = px[idx + 1].to_int() & 0xFF
    let b = px[idx + 2].to_int() & 0xFF
    r > 180 && g < 100 && b < 60
  }
  let is_white = fn(px : Bytes, pw : Int, x : Int, y : Int) -> Bool {
    let idx = (y * pw + x) * 4
    let r = px[idx].to_int() & 0xFF
    let g = px[idx + 1].to_int() & 0xFF
    let b = px[idx + 2].to_int() & 0xFF
    r > 245 && g > 245 && b > 245
  }

  // Pixel verification: wide margins leave 96px white top/left border, none puts red flush at top (y=4, x=200 away from top-left glyph ink)
  let (pw_l, ph_l) = proto::print_pdf_dimensions_px(cfg_legal_none)
  page::set_print_mode(pw_l, ph_l, "print", background_graphics=true)
  let (w1, _, px_none) = picture_print_page(pw_l, ph_l, 0.0, pw_l, ph_l, 0.0)
  debug_assert(is_red(px_none, w1, 200, 4), "none margins renders red background flush at y=4")

  let wide_m = 96.0
  page::set_print_mode(pw_l - 2.0 * wide_m, ph_l - 2.0 * wide_m, "print", background_graphics=true)
  let (w2, _, px_wide) = picture_print_page(pw_l, ph_l, wide_m, pw_l - 2.0 * wide_m, ph_l - 2.0 * wide_m, 0.0)
  debug_assert(is_white(px_wide, w2, 10, 10) && is_white(px_wide, w2, 48, 48), "wide margins keep top-left 96px white")
  debug_assert(is_red(px_wide, w2, 240, 120), "wide margins shift content into printable box at (240,120)")

  // Pixel verification: background_graphics=false removes #e03a12 background while keeping real borderless glyph pixels
  page::set_print_mode(pw_l, ph_l, "print", background_graphics=false)
  let (w3, h3, px_nobg) = picture_print_page(pw_l, ph_l, 0.0, pw_l, ph_l, 0.0)
  let mut red_cnt = 0
  let mut ink_cnt = 0
  let mut y = 0
  while y < 120 && y < h3 {
    let mut x = 0
    while x < 300 && x < w3 {
      if is_red(px_nobg, w3, x, y) {
        red_cnt += 1
      } else if !is_white(px_nobg, w3, x, y) {
        ink_cnt += 1
      }
      x += 1
    }
    y += 1
  }
  debug_assert(red_cnt == 0, "background_graphics=false must eliminate #e03a12 background pixels")
  debug_assert(ink_cnt > 10, "background_graphics=false must preserve real borderless glyph pixels")

  // Restore screen mode and verify live page background is intact
  page::set_print_mode(1280.0, 800.0, "screen", background_graphics=true)
  let (ws, _, px_screen) = picture(1280.0, 800.0, 0.0, 1.0)
  debug_assert(is_red(px_screen, ws, 200, 4), "restoring screen mode preserves live page #e03a12 background")
}

test "phase3b_r2: borderless text renders real glyphs and iframe child+main backgrounds honor background_graphics toggle" {
  let tab = Tab::{ w: 1280.0, h: 800.0, vp: proto::ZoomViewportState::new(1280.0, 800.0), history: [], history_titles: [], history_scroll: [], at: -1 }
  let href = "data:text/html,%3C%21doctype%20html%3E%3Chtml%3E%3Cbody%20style%3D%22margin%3A0%22%3E%3Ciframe%20style%3D%22border%3A0%3Bwidth%3A280px%3Bheight%3A160px%22%20srcdoc%3D%22%3Chtml%3E%3Cbody%20style%3D%27margin%3A0%3Bbackground-color%3A%23e03a12%27%3E%3Cp%3EFrame%20heading%3C%2Fp%3E%3C%2Fbody%3E%3C%2Fhtml%3E%22%3E%3C%2Fiframe%3E%3Cdiv%20style%3D%22width%3A280px%3Bheight%3A160px%3Bbackground-color%3A%23176dce%22%3EMain%20heading%3C%2Fdiv%3E%3C%2Fbody%3E%3C%2Fhtml%3E"
  let _ = page::load(href, 1280.0, 800.0)
  let cfg_on = proto::PrintPdfConfig::{ paper: "letter", orientation: "portrait", margins: "none", background_graphics: true }
  let (pw, ph) = proto::print_pdf_dimensions_px(cfg_on)

  let count_colors = fn(px : Bytes, w : Int, h : Int, y0 : Int, y1 : Int) -> (Int, Int, Int) {
    let mut red = 0
    let mut blue = 0
    let mut ink = 0
    let mut y = y0
    while y < y1 && y < h {
      let mut x = 0
      while x < 300 && x < w {
        let idx = (y * w + x) * 4
        let r = px[idx].to_int() & 0xFF
        let g = px[idx + 1].to_int() & 0xFF
        let b = px[idx + 2].to_int() & 0xFF
        if r == 224 && g == 58 && b == 18 {
          red += 1
        } else if r == 23 && g == 109 && b == 206 {
          blue += 1
        } else {
          let m = if r < g { if r < b { r } else { b } } else if g < b { g } else { b }
          if m < 220 {
            ink += 1
          }
        }
        x += 1
      }
      y += 1
    }
    (red, blue, ink)
  }

  // background_graphics = true: both child iframe red and main div blue > 100px
  page::set_print_mode(pw, ph, "print", background_graphics=true)
  let (w1, h1, px_on) = picture_print_page(pw, ph, 0.0, pw, ph, 0.0)
  let (red_on, blue_on, _) = count_colors(px_on, w1, h1, 0, 340)
  debug_assert(red_on > 100 && blue_on > 100, "background_graphics=true must paint child red and main blue backgrounds")

  // background_graphics = false: both red and blue == 0, AND both child iframe text (y=0..160) & main text (y=160..340) have real glyph pixels!
  page::set_print_mode(pw, ph, "print", background_graphics=false)
  let (w2, h2, px_off) = picture_print_page(pw, ph, 0.0, pw, ph, 0.0)
  let (red_off, blue_off, child_ink) = count_colors(px_off, w2, h2, 0, 160)
  let (red_off2, blue_off2, main_ink) = count_colors(px_off, w2, h2, 160, 340)
  debug_assert(red_off + red_off2 == 0 && blue_off + blue_off2 == 0, "background_graphics=false must eliminate both child iframe and main backgrounds")
  debug_assert(child_ink > 10 && main_ink > 10, "background_graphics=false must preserve real glyph pixels in both child iframe and main doc")

  page::set_print_mode(tab.w, tab.h, "screen", background_graphics=true)
}

test "host picture(): renders white label glyphs over dark z-index:-1 isolated button backdrop" {
  let html = "<!doctype html><html><body style='margin:0;background:#fff'>" +
  "<div id='continue'><button style='display:inline-flex;align-items:center;justify-content:center;position:relative;isolation:isolate;width:300px;height:44px;border:0;background:transparent;color:#fff;font-size:18px;font-family:sans-serif'>" +
  "<span style='position:absolute;inset:0;z-index:-1;background:#191919'></span>" +
  "<span>Continue with email</span>" +
  "</button></div></body></html>"
  let _ = page::load("data:text/html;charset=utf-8," + html, 320.0, 80.0)
  let (pw, ph, rgba) = picture(320.0, 80.0, 0.0, 1.0)
  debug_assert(pw == 320 && ph == 80, "picture dimensions mismatch")
  let mut dark_px = 0
  let mut bright_px = 0
  let mut y = 4
  while y < 40 {
    let mut x = 10
    while x < 290 {
      let idx = (y * pw + x) * 4
      let r = rgba[idx].to_int() & 0xFF
      let g = rgba[idx + 1].to_int() & 0xFF
      let b = rgba[idx + 2].to_int() & 0xFF
      if r < 40 && g < 40 && b < 40 {
        dark_px += 1
      } else if r > 180 && g > 180 && b > 180 {
        bright_px += 1
      }
      x += 1
    }
    y += 1
  }
  debug_assert(dark_px > 2000, "button dark backdrop must be painted, got dark_px=" + dark_px.to_string())
  debug_assert(bright_px > 40, "white button label glyphs must be visibly painted over dark backdrop, got bright_px=" + bright_px.to_string())
}

test "host: search suggestions are not asked for an address or with the setting off; the asker hears none" {
  let srv = net::listen_on("127.0.0.1", 0)
  let cli = net::connect_timeout("127.0.0.1", net::port_of(srv), 2000)
  debug_assert(cli >= 0 && net::poll([srv], 1000) >= 1, "connect")
  let acc = net::accept_now(srv)
  debug_assert(acc >= 0 && net::set_nonblock(cli, true), "accept")
  let tab = Tab::{
    w: 1280.0,
    h: 800.0,
    vp: proto::ZoomViewportState::new(1280.0, 800.0),
    history: [],
    history_titles: [],
    history_scroll: [],
    at: -1,
  }
  let prev = settings_current.v
  let out_before = page::host_fetches_out()
  let heard = fn() -> Option[(String, String)] {
    let _ = net::poll([cli], 500)
    let buf = Bytes::new(4096)
    match net::recv_nb(cli, buf, 0, 4096) {
      net::NbIo::Bytes(n) if n > 4 => match wire::decode(buf.slice(4, n)) {
        Some(wire::Message::Act("search_suggest", q, json)) => Some((q, json))
        _ => None
      }
      _ => None
    }
  }
  settings_current.v = proto::BrowserSettings::{ ..prev, search_suggest: true }
  tab.take(wire::Message::Act("search_suggest", "example.com", ""), false, reply_sock=acc)
  match heard() {
    Some((q, json)) => debug_assert(q == "example.com" && json == "[]", "an address: none, got " + json)
    None => debug_assert(false, "the asker hears an empty answer")
  }
  settings_current.v = proto::BrowserSettings::{ ..prev, search_suggest: false }
  tab.take(wire::Message::Act("search_suggest", "how to bake bread", ""), false, reply_sock=acc)
  match heard() {
    Some((_, json)) => debug_assert(json == "[]", "off: none")
    None => debug_assert(false, "the asker hears an empty answer with the setting off")
  }
  debug_assert(page::host_fetches_out() == out_before, "nothing was fetched")
  settings_current.v = prev
  net::close(cli)
  net::close(acc)
  net::close(srv)
}
