///| Host-side Password Manager & Form Autofill: the profile's encrypted vault (`<profile>/passwords.vault`, sealed
///| with the 32-byte key in `<profile>/passwords.key`, both written owner-only `0600`), the Save / Update prompt after
///| a login form was sent, autofill of the focused login form, and the `password_*` verbs of `wire::Message::Act`.
///|
///| - Plaintext passwords exist only in this process: lists carry `proto::PasswordItemSummary` (no password); a
///|   password leaves only in a `password_revealed` answer to the one client that asked, never broadcast.
///| - Autofill types the login into the page itself (`page::typed_node`), only into `<input>`s of the main document, and
///|   only for a login whose origin matches the page the host has (never the URL a client says it has).
///| - An ephemeral host keeps its vault in memory only. A vault on disk that cannot be opened (another key, damaged)
///|   is never overwritten: the host keeps it as it is and saves nothing until it can be read.

import "page"
import "net"
import "wire"
import "proto"
import "passwords"
import "migrate"

struct PwPending {
  prompt_id : String
  url : String
  username : String
  password : String
  kind : String
}

let pw_vault_ref : page::Ref[Option[passwords::Vault]] = page::Ref::{ v: None }
let pw_vault_dir : page::Ref[String] = page::Ref::{ v: "" }
let pw_key_ref : page::Ref[Bytes] = page::Ref::{ v: Bytes::new(0) }
let pw_blocked : page::Ref[Bool] = page::Ref::{ v: false }
let pw_pending : Array[PwPending] = []
let pw_seq : page::Ref[Int] = page::Ref::{ v: 0 }

pub let PW_PENDING_MAX : Int = 4

fn pw_dir() -> String {
  if page::is_host_ephemeral() {
    return ""
  }
  match page::env_var("FV_PROFILE_DIR") {
    Some(d) if d.trim() != "" => d.trim()
    _ => ws_store_dir()
  }
}

fn pw_vault_path(dir : String) -> String {
  dir + "/passwords.vault"
}

fn pw_key_path(dir : String) -> String {
  dir + "/passwords.key"
}

fn pw_random(n : Int) -> Bytes {
  net::random_bytes(n)
}

///| The profile's vault key: read, or made once (32 bytes from the OS CSPRNG) and written owner-only.
fn pw_load_key(dir : String) -> Option[Bytes] {
  match mig_read_file_bytes(pw_key_path(dir), max_bytes=64) {
    Some(k) if k.length() == passwords::VAULT_KEY_LEN => return Some(k)
    Some(_) => return None
    None => ()
  }
  if file_exists(pw_key_path(dir)) {
    return None
  }
  let k = pw_random(passwords::VAULT_KEY_LEN)
  if k.length() != passwords::VAULT_KEY_LEN {
    return None
  }
  net::mkdir(dir)
  if !net::write_bytes_private(pw_key_path(dir), k) {
    return None
  }
  Some(k)
}

///| The vault of the profile now in use (loaded on first use, and again when the profile directory changes).
fn pw_vault() -> passwords::Vault {
  let dir = pw_dir()
  match pw_vault_ref.v {
    Some(v) if pw_vault_dir.v == dir => return v
    _ => ()
  }
  pw_vault_dir.v = dir
  pw_blocked.v = false
  pw_key_ref.v = Bytes::new(0)
  pw_pending.clear()
  let v = if dir == "" {
    passwords::Vault::new()
  } else {
    match pw_load_key(dir) {
      Some(k) => {
        pw_key_ref.v = k
        match mig_read_file_bytes(pw_vault_path(dir)) {
          Some(raw) =>
          match passwords::open_vault(raw, k) {
            Ok(v) => v
            Err(e) => {
              note("passwords: vault not opened (" + e + "): kept as it is, nothing saved")
              pw_blocked.v = true
              passwords::Vault::new()
            }
          }
          None => passwords::Vault::new()
        }
      }
      None => {
        note("passwords: no vault key: nothing saved")
        pw_blocked.v = true
        passwords::Vault::new()
      }
    }
  }
  pw_vault_ref.v = Some(v)
  v
}

///| Seals the vault under a fresh nonce and writes it owner-only; false when it may not or could not be written.
fn pw_persist() -> Bool {
  let v = pw_vault()
  let dir = pw_vault_dir.v
  if dir == "" || pw_blocked.v {
    return dir == "" && !pw_blocked.v
  }
  let nonce = pw_random(passwords::VAULT_NONCE_LEN)
  match passwords::seal_vault(v, pw_key_ref.v, nonce) {
    Some(sealed) => net::write_bytes_private(pw_vault_path(dir), sealed)
    None => false
  }
}

fn pw_now() -> Int64 {
  now_unix_secs()
}

fn pw_send(verb : String, json : String, reply_sock : Int, agent : Bool) -> Unit {
  let frame = wire::encode(wire::Message::Act(verb, json, ""))
  if reply_sock >= 0 && !agent {
    let _ = net::send(reply_sock, frame)
  } else if !agent {
    broadcast_all(frame)
  }
}

fn pw_list_json(query : String) -> String {
  proto::encode_password_list(proto::PasswordListSnapshot::{ query, items: pw_vault().summaries(query~) })
}

fn pw_broadcast_list() -> String {
  let json = pw_list_json("")
  broadcast_all(wire::encode(wire::Message::Act(proto::PW_VERB_STATE, json, "")))
  json
}

fn pw_prompt_json(p : PwPending) -> String {
  proto::encode_password_prompt(proto::PasswordPromptState::{
    visible: true,
    prompt_id: p.prompt_id,
    kind: p.kind,
    origin: passwords::normalize_origin(p.url),
    username: p.username,
    display_name: proto::password_origin_host(passwords::normalize_origin(p.url)),
    password_len: p.password.length(),
  })
}

fn pw_hidden_prompt_json(prompt_id : String) -> String {
  proto::encode_password_prompt(proto::PasswordPromptState::{ ..proto::PasswordPromptState::hidden(), prompt_id })
}

fn pw_take_pending(prompt_id : String) -> Option[PwPending] {
  let mut i = 0
  while i < pw_pending.length() {
    if pw_pending[i].prompt_id == prompt_id {
      let p = pw_pending[i]
      let kept : Array[PwPending] = []
      let mut k = 0
      while k < pw_pending.length() {
        if k != i {
          kept.push(pw_pending[k])
        }
        k = k + 1
      }
      pw_pending.clear()
      for x in kept {
        pw_pending.push(x)
      }
      return Some(p)
    }
    i = i + 1
  }
  None
}

///| A login form was sent (`page::take_credential_capture`'s JSON): when it is a login the vault does not have yet,
///| or a new password for one it has, the Save / Update prompt is broadcast. Returns the prompt's JSON, `""` for none.
fn pw_on_capture(json : String) -> String {
  if json == "" {
    return ""
  }
  let c = match proto::pw_json_obj(json) {
    Some(v) => v
    None => return ""
  }
  let url = c.str("url")
  let username = c.str("username").trim()
  let password = c.str("password")
  if passwords::normalize_origin(url) == "" || password == "" || password.length() > 4096 || username.length() > 512 {
    return ""
  }
  let v = pw_vault()
  if v.is_never(url) {
    return ""
  }
  let kind = match v.find_login(url, username) {
    Some(e) if e.password == password => return ""
    Some(_) => "update"
    None => "save"
  }
  pw_seq.v = pw_seq.v + 1
  let p = PwPending::{ prompt_id: "pp-" + pw_seq.v.to_string() + "-" + now_ms64().to_string(), url, username, password, kind }
  // (only the newest few prompts are kept: an old one not answered is dropped with its password)
  while pw_pending.length() >= PW_PENDING_MAX {
    let _ = pw_take_pending(pw_pending[0].prompt_id)
  }
  pw_pending.push(p)
  let pj = pw_prompt_json(p)
  broadcast_all(wire::encode(wire::Message::Act(proto::PW_VERB_PROMPT, pj, "")))
  pj
}

///| After a person's tap, Enter or action in the page: what a login form it sent left for the Save prompt.
fn pw_after_hit() -> Unit {
  let _ = pw_on_capture(page::take_credential_capture())
}

///| Brings a browser's passwords CSV rows into the vault (`migrate_import_file` with a `.csv`), then saves it.
fn pw_import_rows(rows : Array[migrate::ImportedPassword]) -> passwords::ImportCounts {
  let v = pw_vault()
  let counts = passwords::import_migrated(v, rows, pw_now())
  if counts.added + counts.updated > 0 {
    let _ = pw_persist()
    let _ = pw_broadcast_list()
  }
  counts
}

fn pw_downloads_dir() -> String {
  match page::env_var("FV_DOWNLOADS_DIR") {
    Some(d) if d.trim() != "" => return d.trim()
    _ => ()
  }
  let home = mig_detect_home()
  if home == "" { "" } else { home + "/Downloads" }
}

///| The newest file in `dir` named like a browser's passwords export (`Chrome Passwords.csv`, `Passwords.csv`,
///| `logins.csv`; not Farview's own export), `""` for none. Newest by modification time; at the same second the
///| longer name, as a browser numbers a later copy (`Chrome Passwords (1).csv`).
fn pw_find_export_csv(dir : String) -> String {
  let mut best = ""
  let mut best_t = -1L
  for name in mig_list_dir_entries(dir) {
    let low = migrate::mig_ascii_lower(name)
    if low.ends_with(".csv") && (low.contains("password") || low.contains("logins")) && !low.starts_with("farview passwords") {
      let t = net::file_mtime(dir + "/" + name)
      if best == "" || t > best_t || (t == best_t && name.length() > best.length()) {
        best = name
        best_t = t
      }
    }
  }
  if best == "" { "" } else { dir + "/" + best }
}

fn pw_import_file(path0 : String) -> proto::PasswordIoResult {
  let path = if path0.trim() != "" { path0.trim() } else { pw_find_export_csv(pw_downloads_dir()) }
  let none = proto::PasswordIoResult::{ ok: false, kind: "import", path, count: 0, error: "" }
  if path == "" {
    return { ..none, error: "No passwords CSV in Downloads" }
  }
  match read_file_text(path) {
    Some(txt) => {
      let (rows, _) = migrate::parse_passwords_csv(txt)
      if rows.length() == 0 {
        return { ..none, error: "No passwords in " + bm_path_basename(path) }
      }
      let c = pw_import_rows(rows)
      { ..none, ok: true, count: c.added + c.updated }
    }
    None => { ..none, error: "Could not read " + bm_path_basename(path) }
  }
}

///| Writes every saved login as a passwords CSV (owner-only) to `path`, or to `Farview Passwords.csv` in Downloads.
fn pw_export_file(path0 : String) -> proto::PasswordIoResult {
  let dir = pw_downloads_dir()
  let path = if path0.trim() != "" { path0.trim() } else if dir != "" { dir + "/Farview Passwords.csv" } else { "" }
  let none = proto::PasswordIoResult::{ ok: false, kind: "export", path, count: 0, error: "" }
  let v = pw_vault()
  if path == "" {
    return { ..none, error: "No Downloads folder" }
  }
  if v.length() == 0 {
    return { ..none, error: "No saved passwords to export" }
  }
  if !net::write_bytes_private(path, v.export_csv().to_bytes()) {
    return { ..none, error: "Could not write " + bm_path_basename(path) }
  }
  { ..none, ok: true, count: v.length() }
}

fn pw_autofill_snapshot(q : proto::AutofillQuery) -> proto::AutofillSnapshot {
  let kind = page::login_field_kind(q.field_id)
  if kind == "" {
    return proto::AutofillSnapshot::{ ..proto::AutofillSnapshot::empty(), req_id: q.req_id, field_id: q.field_id }
  }
  let (_, pw_id) = page::login_form_fields(q.field_id)
  // (a text field with no password field in its form is no login: a search box, a comment)
  if kind == "username" && pw_id < 0 {
    return proto::AutofillSnapshot::{ ..proto::AutofillSnapshot::empty(), req_id: q.req_id, field_id: q.field_id }
  }
  // (the page's address as the host has it: what the client says it shows is not trusted)
  let url = page::url()
  let out : Array[proto::AutofillSuggestion] = []
  for m in pw_vault().matches_for(url) {
    let (e, exact) = m
    if out.length() >= proto::PW_SUGGESTIONS_MAX {
      break
    }
    out.push(proto::AutofillSuggestion::{ id: e.id, origin: e.origin, username: e.username, display_name: e.display_name, exact })
  }
  proto::AutofillSnapshot::{
    req_id: q.req_id,
    field_id: q.field_id,
    password_field_id: pw_id,
    suggestions: if kind == "new-password" { [] } else { out },
    can_generate: kind == "new-password" || (kind == "password" && out.length() == 0),
  }
}

///| Fills a saved login (or a new strong password) into the login form of `field_id`. Returns what was filled
///| (`"login"`, `"generated"`) or `""` when nothing was.
fn pw_fill(tab : Tab, r : proto::AutofillFillRequest) -> String {
  let (user_id, pw_id0) = page::login_form_fields(r.field_id)
  let pw_id = if pw_id0 >= 0 {
    pw_id0
  } else if r.password_field_id >= 0 && page::login_field_kind(r.password_field_id).contains("password") {
    r.password_field_id
  } else {
    -1
  }
  if r.generate {
    if pw_id < 0 {
      return ""
    }
    let gen = passwords::generate_password(passwords::PW_GEN_DEFAULT_LEN, true, pw_random)
    tab.hit(page::typed_node(pw_id, gen))
    return "generated"
  }
  let v = pw_vault()
  let e = match v.get(r.id) {
    Some(e) => e
    None => return ""
  }
  if passwords::origin_match(e.origin, page::url()) == 0 {
    note("passwords: fill refused: the login is not for this page's origin")
    return ""
  }
  if user_id >= 0 && e.username != "" {
    tab.hit(page::typed_node(user_id, e.username))
  }
  if pw_id >= 0 {
    tab.hit(page::typed_node(pw_id, e.password))
  }
  if user_id < 0 && pw_id < 0 {
    return ""
  }
  v.mark_used(e.id, pw_now())
  let _ = pw_persist()
  "login"
}

///| The `password_*` verbs of `wire::Message::Act` (`None` for any other verb).
fn pw_handle_act(tab : Tab, verb : String, a : String, reply_sock~ : Int = -1, agent~ : Bool = false) -> Option[String] {
  if !verb.starts_with("password") {
    return None
  }
  if verb == proto::PW_VERB_LIST {
    let cmd = proto::parse_password_command(a).unwrap_or(proto::PasswordCommand::empty())
    let json = pw_list_json(cmd.query)
    pw_send(proto::PW_VERB_STATE, json, reply_sock, agent)
    return Some(json)
  }
  if verb == proto::PW_VERB_SAVE {
    let cmd = proto::parse_password_command(a).unwrap_or(proto::PasswordCommand::empty())
    match pw_take_pending(cmd.prompt_id) {
      Some(p) => {
        let user = if cmd.username.trim() != "" { cmd.username.trim() } else { p.username }
        let v = pw_vault()
        let _ = v.upsert(p.url, user, p.password, pw_now())
        let saved = pw_persist()
        broadcast_all(wire::encode(wire::Message::Act(proto::PW_VERB_PROMPT, pw_hidden_prompt_json(p.prompt_id), "")))
        let list = pw_broadcast_list()
        return Some(if saved { list } else { "{\"error\":\"not saved\"}" })
      }
      None => return Some("{\"error\":\"no such prompt\"}")
    }
  }
  if verb == proto::PW_VERB_DISMISS {
    let cmd = proto::parse_password_command(a).unwrap_or(proto::PasswordCommand::empty())
    match pw_take_pending(cmd.prompt_id) {
      Some(p) =>
      if cmd.never {
        pw_vault().set_never(p.url)
        let _ = pw_persist()
      }
      None => ()
    }
    let hidden = pw_hidden_prompt_json(cmd.prompt_id)
    broadcast_all(wire::encode(wire::Message::Act(proto::PW_VERB_PROMPT, hidden, "")))
    return Some(hidden)
  }
  if verb == proto::PW_VERB_DELETE {
    let cmd = proto::parse_password_command(a).unwrap_or(proto::PasswordCommand::empty())
    if pw_vault().delete(cmd.id) {
      let _ = pw_persist()
    }
    return Some(pw_broadcast_list())
  }
  if verb == proto::PW_VERB_REVEAL {
    let cmd = proto::parse_password_command(a).unwrap_or(proto::PasswordCommand::empty())
    let res = match pw_vault().get(cmd.id) {
      Some(e) => proto::PasswordRevealResult::{ req_id: cmd.req_id, id: cmd.id, ok: true, password: e.password }
      None => proto::PasswordRevealResult::{ req_id: cmd.req_id, id: cmd.id, ok: false, password: "" }
    }
    let json = proto::encode_password_reveal(res)
    // (to the one client that asked, never to every viewer)
    if reply_sock >= 0 && !agent {
      let _ = net::send(reply_sock, wire::encode(wire::Message::Act(proto::PW_VERB_REVEALED, json, "")))
    }
    return Some(json)
  }
  if verb == proto::PW_VERB_IMPORT {
    let json = proto::encode_password_io(pw_import_file(a))
    pw_send(proto::PW_VERB_IO, json, reply_sock, agent)
    return Some(json)
  }
  if verb == proto::PW_VERB_EXPORT {
    let json = proto::encode_password_io(pw_export_file(a))
    pw_send(proto::PW_VERB_IO, json, reply_sock, agent)
    return Some(json)
  }
  if verb == proto::PW_VERB_AUTOFILL_QUERY {
    match proto::parse_autofill_query(a) {
      Some(q) => {
        let json = proto::encode_autofill_snapshot(pw_autofill_snapshot(q))
        pw_send(proto::PW_VERB_SUGGESTIONS, json, reply_sock, agent)
        return Some(json)
      }
      None => return Some("")
    }
  }
  if verb == proto::PW_VERB_AUTOFILL_FILL {
    match proto::parse_autofill_fill(a) {
      Some(r) => return Some(pw_fill(tab, r))
      None => return Some("")
    }
  }
  None
}
