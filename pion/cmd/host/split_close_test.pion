///| Closing a tab with Split View open: the main pane's tab gives the window to the second pane's tab (never its
///| neighbour beside it, never a New Tab made while the other pane still shows one), the second pane's tab lets go of
///| that pane, and the client's order (show the second pane's tab, then close the main one) opens nothing new.

import "browser_ctx"

struct SplitCloseSaved {
  ctx : browser_ctx::BrowserContext
  init : Bool
  sid : String
  page_space : String
  active : Int64
  page_tab : Int64
  split : Int64
  closed : Array[ClosedTabRecord]
}

fn sc_save() -> SplitCloseSaved {
  let closed : Array[ClosedTabRecord] = []
  for r in ws_closed_tabs {
    closed.push(r)
  }
  SplitCloseSaved::{
    ctx: ws_ctx.v,
    init: ws_initialized.v,
    sid: ws_active_space_id.v,
    page_space: ws_page_space_id.v,
    active: ws_active_tab_id.v,
    page_tab: ws_page_tab_id.v,
    split: ws_split_tab_id.v,
    closed,
  }
}

fn sc_restore(s : SplitCloseSaved) -> Unit {
  ws_ctx.v = s.ctx
  ws_initialized.v = s.init
  ws_apply_space_partition(s.sid)
  ws_page_space_id.v = s.page_space
  ws_active_tab_id.v = s.active
  ws_page_tab_id.v = s.page_tab
  ws_split_tab_id.v = s.split
  ws_closed_tabs.clear()
  for r in s.closed {
    ws_closed_tabs.push(r)
  }
}

///| A Work Space with `n` blank Today tabs (blank: nothing is loaded), the first shown; their ids in order.
fn sc_setup(n : Int, first_tier~ : browser_ctx::TabTier = browser_ctx::TabTier::Today) -> (browser_ctx::BrowserContext, Array[Int64]) {
  let ctx = p0_ctx()
  let ids : Array[Int64] = []
  let mut i = 0
  while i < n {
    let tier = if i == 0 { first_tier } else { browser_ctx::TabTier::Today }
    ids.push(p0_open(ctx, "s1", tier, "about:blank", (i + 1).to_int64(), i == 0))
    i += 1
  }
  ws_ctx.v = ctx
  ws_initialized.v = true
  ws_apply_space_partition("s1")
  ws_active_tab_id.v = ids[0]
  ws_page_tab_id.v = ids[0]
  ws_split_tab_id.v = 0L
  (ctx, ids)
}

fn sc_count(ctx : browser_ctx::BrowserContext) -> Int {
  ctx.tab_manager.tabs_in_space("s1", false).length()
}

test "host split close: closing the main pane's tab shows the second pane's tab, not its neighbour, and opens none" {
  let saved = sc_save()
  // A shown, C between, B in Split View's second pane
  let (ctx, ids) = sc_setup(3)
  let a = ids[0]
  let c = ids[1]
  let b = ids[2]
  let tab = p0_tab_stub()
  let _ = ws_handle_act(tab, "split_tab", b.to_string(), "")
  let _ = ws_handle_act(tab, "tab_close", a.to_string(), "")
  debug_assert(ctx.tab_manager.get_tab(a).is_none(), "A is closed")
  debug_assert(ws_active_tab_id.v == b, "the second pane's tab B is shown (\{ws_active_tab_id.v}), not the neighbour C (\{c})")
  debug_assert(ws_split_tab_id.v == 0L, "and no longer counts as the second pane's")
  debug_assert(sc_count(ctx) == 2, "no New Tab opens: B and C stay (\{sc_count(ctx)})")
  sc_restore(saved)
}

test "host split close: the client's order (show B, then close A) closes A in the background and opens none" {
  let saved = sc_save()
  let (ctx, ids) = sc_setup(2)
  let a = ids[0]
  let b = ids[1]
  let tab = p0_tab_stub()
  let _ = ws_handle_act(tab, "split_tab", b.to_string(), "")
  let _ = ws_handle_act(tab, "tab_switch", b.to_string(), "")
  let _ = ws_handle_act(tab, "tab_close", a.to_string(), "")
  let _ = ws_handle_act(tab, "split_tab", "", "")
  debug_assert(ctx.tab_manager.get_tab(a).is_none() && ws_active_tab_id.v == b, "B shown, A gone")
  debug_assert(sc_count(ctx) == 1, "exactly one tab left: no New Tab pops up (\{sc_count(ctx)})")
  // closed once more: the last tab's close still gives one New Tab, as without Split View
  let _ = ws_handle_act(tab, "tab_close", b.to_string(), "")
  debug_assert(sc_count(ctx) == 1 && ws_active_tab_id.v != b, "a last close leaves one blank tab (\{sc_count(ctx)})")
  sc_restore(saved)
}

test "host split close: closing the second pane's tab leaves the shown tab shown and lets go of the pane" {
  let saved = sc_save()
  let (ctx, ids) = sc_setup(3)
  let a = ids[0]
  let b = ids[2]
  let tab = p0_tab_stub()
  let _ = ws_handle_act(tab, "split_tab", b.to_string(), "")
  let _ = ws_handle_act(tab, "tab_close", b.to_string(), "")
  debug_assert(ctx.tab_manager.get_tab(b).is_none(), "B is closed")
  debug_assert(ws_active_tab_id.v == a, "A stays shown")
  debug_assert(ws_split_tab_id.v == 0L, "the second pane shows no tab now")
  debug_assert(sc_count(ctx) == 2, "nothing opens (\{sc_count(ctx)})")
  sc_restore(saved)
}

test "host split close: a kept (Favorite) main tab closed with Split View open shows the second pane's tab" {
  let saved = sc_save()
  let (ctx, ids) = sc_setup(3, first_tier=browser_ctx::TabTier::Favorite)
  let fav = ids[0]
  let b = ids[2]
  let tab = p0_tab_stub()
  let _ = ws_handle_act(tab, "split_tab", b.to_string(), "")
  let _ = ws_handle_act(tab, "tab_close", fav.to_string(), "")
  debug_assert(ctx.tab_manager.get_tab(fav).is_some(), "the Favorite's entry stays")
  debug_assert(ws_active_tab_id.v == b && ws_split_tab_id.v == 0L, "B is shown in the main pane")
  debug_assert(sc_count(ctx) == 3, "nothing opens (\{sc_count(ctx)})")
  sc_restore(saved)
}

test "host split close: with no second-pane tab, closing a tab behaves as without Split View" {
  let saved = sc_save()
  let (ctx, ids) = sc_setup(3)
  let a = ids[0]
  let c = ids[1]
  let tab = p0_tab_stub()
  let _ = ws_handle_act(tab, "tab_close", a.to_string(), "")
  debug_assert(ws_active_tab_id.v == c, "the neighbour is shown (\{ws_active_tab_id.v})")
  debug_assert(sc_count(ctx) == 2, "nothing opens")
  sc_restore(saved)
}
