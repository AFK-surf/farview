///| Host-side managed Arc Peek state (`wire::Message::PeekState`, tag 64)
///| and Peek lifecycle actions (`peek_open`, `peek_close`, `peek_expand`, `peek_sync`).

import "page"
import "wire"
import "proto"

let host_peek_open : page::Ref[Bool] = page::Ref::{ v: false }
let host_peek_url : page::Ref[String] = page::Ref::{ v: "" }
let host_peek_title : page::Ref[String] = page::Ref::{ v: "" }
let host_peek_source_tab : page::Ref[String] = page::Ref::{ v: "" }

fn peek_build_snapshot() -> proto::PeekSnapshot {
  proto::PeekSnapshot::{
    open: host_peek_open.v,
    url: host_peek_url.v,
    title: host_peek_title.v,
    source_tab_id: host_peek_source_tab.v,
    loading: false,
    can_back: false,
    can_forward: false,
  }
}

fn peek_broadcast_state() -> String {
  let json = proto::encode_peek_snapshot(peek_build_snapshot())
  broadcast_all(wire::encode(wire::Message::PeekState(json)))
  json
}

fn peek_handle_open(raw_url : String, source_tab_id : String) -> String {
  let u = raw_url.trim()
  host_peek_open.v = u != ""
  host_peek_url.v = u
  host_peek_title.v = if u != "" { proto::split_pane_display_host(u) } else { "" }
  host_peek_source_tab.v = source_tab_id.trim()
  peek_broadcast_state()
}

fn peek_handle_close() -> String {
  host_peek_open.v = false
  host_peek_url.v = ""
  host_peek_title.v = ""
  host_peek_source_tab.v = ""
  peek_broadcast_state()
}

fn peek_reset_on_disconnect() -> Unit {
  host_peek_open.v = false
  host_peek_url.v = ""
  host_peek_title.v = ""
  host_peek_source_tab.v = ""
}

test "peek_reset_on_disconnect clears open Peek state on client EOF" {
  host_peek_open.v = true
  host_peek_url.v = "https://example.com/peek"
  host_peek_title.v = "example.com"
  host_peek_source_tab.v = "t-1"
  peek_reset_on_disconnect()
  debug_assert(!host_peek_open.v, "host_peek_open must be false after disconnect")
  debug_assert(host_peek_url.v == "", "host_peek_url must be cleared")
  debug_assert(host_peek_title.v == "", "host_peek_title must be cleared")
  debug_assert(host_peek_source_tab.v == "", "host_peek_source_tab must be cleared")
}

fn peek_handle_expand(tab : Tab, raw_url : String, raw_title : String) -> String {
  let u = if raw_url.trim() != "" { raw_url.trim() } else { host_peek_url.v }
  let ttl = if raw_title.trim() != "" { raw_title.trim() } else { host_peek_title.v }
  host_peek_open.v = false
  host_peek_url.v = ""
  host_peek_title.v = ""
  host_peek_source_tab.v = ""
  let _ = peek_broadcast_state()
  if u != "" {
    match ws_handle_act(tab, "tab_new", u, ttl) {
      Some(res) => return res
      None => ()
    }
  }
  ws_broadcast_state()
}
