///| Closing on the host: a closed Pinned tab is unloaded even while it plays audio; a bulk close's undo group is
///| reopened exactly, wherever it sits in the closed stack.

import "browser_ctx"
import "security"

test "host: closing a background audible pinned tab unloads it and stops its sound" {
  let prev = ws_ctx.v
  let ctx = browser_ctx::BrowserContext::new(8)
  let _ = ctx.add_profile(browser_ctx::Profile::new("p1", "Main", "/data"))
  let _ = ctx.add_space(browser_ctx::Space::new("s1", "p1", "Work", 3600L))
  ws_ctx.v = ctx
  let cn = security::CoopPolicy::default()
  let ce = security::CoepPolicy::default()
  let pin = match ctx.open_tab("s1", browser_ctx::TabTier::Pinned, "https://music.test/", "Music", cn, ce, 0L, false) {
    Ok((t, _)) => t
    Err(e) => {
      ws_ctx.v = prev
      debug_assert(false, "open pinned: " + e)
      return
    }
  }
  let _ = ctx.open_tab("s1", browser_ctx::TabTier::Today, "https://other.test/", "Other", cn, ce, 0L, true)
  let _ = ctx.tab_manager.set_audible(pin.id, true)
  debug_assert(ws_unload_closed_kept(pin.id), "the close unloads it")
  match ctx.tab_manager.get_tab(pin.id) {
    Some(t) => {
      debug_assert(t.state.eq(browser_ctx::TabLifecycleState::Discarded), "Discarded")
      debug_assert(!t.is_audible, "no longer playing")
      debug_assert(t.state.to_token() == "discarded", "the sidebar is told it is unloaded")
    }
    None => debug_assert(false, "the entry stays")
  }
  ws_ctx.v = prev
}

test "host: a named undo group comes back whole, even under a later close" {
  let saved : Array[ClosedTabRecord] = []
  for r in ws_closed_tabs {
    saved.push(r)
  }
  ws_closed_tabs.clear()
  let rec = fn(url : String, group : String) -> ClosedTabRecord {
    ClosedTabRecord::{
      url,
      title: url,
      space_id: "s1",
      tier: browser_ctx::TabTier::Today,
      closed_secs: 0L,
      folder_id: "",
      undo_group: group,
    }
  }
  ws_begin_undo_group(named="c1-x")
  debug_assert(ws_closing_group.v == "c1-x", "the client's group is the one stamped")
  ws_end_undo_group()
  ws_begin_undo_group()
  debug_assert(ws_closing_group.v.starts_with("h"), "else one of the host's own")
  ws_end_undo_group()
  ws_closed_tabs.push(rec("https://a.test/", "c1-x"))
  ws_closed_tabs.push(rec("https://b.test/", "c1-x"))
  ws_closed_tabs.push(rec("https://c.test/", "c1-x"))
  // (closed after the batch, on top of the stack)
  ws_closed_tabs.push(rec("https://later.test/", ""))
  let back = ws_take_undo_group("c1-x")
  debug_assert(back.length() == 3, "the three of the batch")
  debug_assert(back[0].url == "https://a.test/" && back[2].url == "https://c.test/", "in the order they stood")
  debug_assert(ws_closed_tabs.length() == 1 && ws_closed_tabs[0].url == "https://later.test/", "the later close stays closed")
  debug_assert(ws_take_undo_group("c1-x").length() == 0, "a second Undo brings nothing (not some other tab)")
  ws_closed_tabs.clear()
  for r in saved {
    ws_closed_tabs.push(r)
  }
}
