///| p0 parity on the host: Today tabs left unseen are archived (never the shown one, nor one playing sound), a
///| restored session shows the tab that was shown, and a Favorite opened from another Space comes into this one.

import "browser_ctx"
import "security"

fn p0_ctx() -> browser_ctx::BrowserContext {
  let ctx = browser_ctx::BrowserContext::new(8)
  let _ = ctx.add_profile(browser_ctx::Profile::new("p1", "Main", "/data"))
  let _ = ctx.add_space(browser_ctx::Space::new("s1", "p1", "Work", 3600L))
  let _ = ctx.add_space(browser_ctx::Space::new("s2", "p1", "Life", 3600L))
  ctx
}

fn p0_open(ctx : browser_ctx::BrowserContext, sid : String, tier : browser_ctx::TabTier, url : String, at : Int64, show : Bool) -> Int64 {
  match ctx.open_tab(sid, tier, url, url, security::CoopPolicy::default(), security::CoepPolicy::default(), at, show) {
    Ok((t, _)) => t.id
    Err(e) => {
      debug_assert(false, "open " + url + ": " + e)
      0L
    }
  }
}

test "host p0: Today tabs unseen past the setting are due for archive; the shown, pinned and playing ones never" {
  let ctx = p0_ctx()
  let old = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://old.test/", 0L, false)
  let fresh = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://fresh.test/", 90000L, false)
  let other_space = p0_open(ctx, "s2", browser_ctx::TabTier::Today, "https://life.test/", 0L, false)
  let pinned = p0_open(ctx, "s1", browser_ctx::TabTier::Pinned, "https://pin.test/", 0L, false)
  let playing = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://music.test/", 0L, false)
  let _ = ctx.tab_manager.set_audible(playing, true)
  let shown = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://shown.test/", 0L, true)
  let due = ws_auto_archive_due(ctx, 86400L, 100000L, shown)
  debug_assert(due.contains(old) && due.contains(other_space), "stale Today tabs in every Space (\{due.length()})")
  debug_assert(!due.contains(fresh), "a tab seen within the window stays")
  debug_assert(!due.contains(pinned) && !due.contains(playing) && !due.contains(shown), "pinned, playing and shown stay")
  debug_assert(ws_auto_archive_due(ctx, 0L, 100000L, shown).length() == 0, "Never archives nothing")
}

test "host p0: the archive sweep closes due tabs into the closed list as one undo group" {
  let prev_ctx = ws_ctx.v
  let prev_init = ws_initialized.v
  let prev_active = ws_active_tab_id.v
  let prev_at = ws_auto_archive_at.v
  let saved : Array[ClosedTabRecord] = []
  for r in ws_closed_tabs {
    saved.push(r)
  }
  ws_closed_tabs.clear()
  ws_closed_seeded.v = true
  let ctx = p0_ctx()
  let old = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://old.test/", 0L, false)
  let shown = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://shown.test/", 0L, true)
  ws_ctx.v = ctx
  ws_initialized.v = true
  ws_active_tab_id.v = shown
  // (24 hours is the default setting)
  debug_assert(ws_auto_archive_sweep(100000L, force=true), "it archives")
  debug_assert(ctx.tab_manager.get_tab(old) is None, "the stale tab is gone from the sidebar")
  debug_assert(ctx.tab_manager.get_tab(shown) is Some(_), "the shown one stays")
  debug_assert(ws_closed_tabs.length() == 1 && ws_closed_tabs[0].url == "https://old.test/", "it can be reopened")
  debug_assert(ws_closed_tabs[0].undo_group == "archive-100000", "as one batch")
  debug_assert(!ws_auto_archive_sweep(100010L), "looked for at most once a minute")
  ws_ctx.v = prev_ctx
  ws_initialized.v = prev_init
  ws_active_tab_id.v = prev_active
  ws_auto_archive_at.v = prev_at
  ws_closed_tabs.clear()
  for r in saved {
    ws_closed_tabs.push(r)
  }
}

test "host p0: a restored session shows the tab saved as shown, else the Active tab seen last" {
  let ctx = p0_ctx()
  let a = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://a.test/", 10L, true)
  let b = p0_open(ctx, "s2", browser_ctx::TabTier::Today, "https://b.test/", 20L, true)
  let restored = match browser_ctx::BrowserContext::restore_session(ctx.export_session(), 8) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "restore: " + e)
      return
    }
  }
  let tabs = restored.snapshot().tabs
  match ws_restored_shown_tab(tabs, a) {
    Some(t) => debug_assert(t.id == a && t.space_id == "s1", "the saved one, in its Space")
    None => debug_assert(false, "found")
  }
  match ws_restored_shown_tab(tabs, 0L) {
    Some(t) => debug_assert(t.id == b, "else the Active tab seen last (both Spaces keep one Active)")
    None => debug_assert(false, "found")
  }
  match ws_restored_shown_tab(tabs, 999L) {
    Some(t) => debug_assert(t.id == b, "a saved tab no longer there is passed over")
    None => debug_assert(false, "found")
  }
}

test "host p0: a Favorite opened from another Space comes into the active one; other tabs stay put" {
  let prev_ctx = ws_ctx.v
  let prev_sid = ws_active_space_id.v
  let ctx = p0_ctx()
  let fav = p0_open(ctx, "s1", browser_ctx::TabTier::Favorite, "https://fav.test/", 0L, false)
  let today = p0_open(ctx, "s1", browser_ctx::TabTier::Today, "https://today.test/", 0L, false)
  ws_ctx.v = ctx
  ws_active_space_id.v = "s2"
  ws_bring_favorite_here(fav, 5L)
  ws_bring_favorite_here(today, 5L)
  match (ctx.tab_manager.get_tab(fav), ctx.tab_manager.get_tab(today)) {
    (Some(f), Some(t)) => {
      debug_assert(f.space_id == "s2", "the favorite opens here")
      debug_assert(f.tier.eq(browser_ctx::TabTier::Favorite), "still a favorite")
      debug_assert(t.space_id == "s1", "a Today tab keeps its Space")
    }
    _ => debug_assert(false, "both there")
  }
  ws_ctx.v = prev_ctx
  ws_active_space_id.v = prev_sid
}
