///| End-to-end host migration tests: Chrome/Arc/Safari/Firefox auto-discovery, Arc Spaces/Folders/Pinned
///| tabs import, Chromium Bookmarks + MV3 Extensions + cookies.txt import, and idempotent re-import.

import "net"
import "page"
import "proto"
import "browser_ctx"

test "host: migrate_detect and migrate_run import Arc Spaces, Chrome Bookmarks, MV3 extensions idempotently" {
  let tmp = "/tmp/fv-host-mig-test-" + now_ms64().to_string()
  net::mkdir(tmp)
  net::mkdir(tmp + "/Library")
  net::mkdir(tmp + "/Library/Application Support")
  net::mkdir(tmp + "/Library/Application Support/Arc")
  net::mkdir(tmp + "/Library/Application Support/Arc/User Data")
  net::mkdir(tmp + "/Library/Application Support/Arc/User Data/Default")
  net::mkdir(tmp + "/Library/Application Support/Arc/User Data/Default/Extensions")
  net::mkdir(tmp + "/Library/Application Support/Arc/User Data/Default/Extensions/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  net::mkdir(tmp + "/Library/Application Support/Arc/User Data/Default/Extensions/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/1.4.0_0")
  net::mkdir(tmp + "/Library/Safari")

  net::write_file(
    tmp + "/Library/Application Support/Arc/User Data/Default/Bookmarks",
    "{\"version\":1,\"roots\":{\"bookmark_bar\":{\"name\":\"Bar\",\"type\":\"folder\",\"children\":[{\"name\":\"Farview\",\"type\":\"url\",\"url\":\"https://farview.dev/\"},{\"name\":\"Unsafe\",\"type\":\"url\",\"url\":\"javascript:alert(1)\"}]}}}",
  )
  net::write_file(
    tmp + "/Library/Application Support/Arc/StorableSidebar.json",
    "{\"sidebar\":{\"containers\":[{\"global\":{}},{\"topAppsContainerIDs\":[\"default\",\"top-1\"],\"spaces\":[{\"id\":\"arc-sp-1\",\"title\":\"Research\",\"containerIDs\":[\"pinned\",\"c-pin-1\"]}],\"items\":[\"f1\",{\"id\":\"f1\",\"parentID\":\"c-pin-1\",\"title\":\"Papers\",\"data\":{\"list\":{}},\"childrenIds\":[\"t1\"]},\"t1\",{\"id\":\"t1\",\"parentID\":\"f1\",\"title\":\"RFC 9111\",\"data\":{\"tab\":{\"savedURL\":\"https://httpwg.org/specs/rfc9111.html\",\"savedTitle\":\"RFC 9111\"}}}]}]}}",
  )
  net::write_file(
    tmp + "/Library/Application Support/Arc/User Data/Default/Extensions/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/1.4.0_0/manifest.json",
    "{\"manifest_version\":3,\"name\":\"MigTest Ext\",\"version\":\"1.4.0\",\"permissions\":[\"storage\"]}",
  )
  net::write_file(
    tmp + "/Library/Safari/Bookmarks.plist",
    "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict><key>Children</key><array><dict><key>WebBookmarkType</key><string>WebBookmarkTypeLeaf</string><key>URLString</key><string>https://webkit.org/</string><key>URIDictionary</key><dict><key>title</key><string>WebKit</string></dict></dict></array></dict></plist>",
  )

  net::setenv("FV_MIGRATE_HOME", tmp)
  net::setenv("FV_MIGRATE_OS", "macos")
  page::clear_extensions()

  // 1. Detect installed profiles
  let det_json = host_migrate_detect(-1, true)
  let det = match proto::parse_migrate_sources(det_json) {
    Some(s) => s
    None => {
      debug_assert(false, "migrate_detect must return valid JSON")
      return
    }
  }
  debug_assert(det.sources.length() == 2, "expected Arc and Safari detected, got " + det.sources.length().to_string())
  debug_assert(det.sources[0].id == "arc:default" && det.sources[0].has_spaces && det.sources[0].has_extensions, "Arc source capabilities detected")

  // 2. Run migration from Arc
  let req = proto::encode_migrate_request(proto::MigrateRequest::{
    source_id: "arc:default",
    import_bookmarks: true,
    import_history: false,
    import_spaces: true,
    import_extensions: true,
    custom_path: "",
  })
  let res1_json = host_migrate_run(req, -1, true)
  let res1 = match proto::parse_migrate_result(res1_json) {
    Some(r) => r
    None => {
      debug_assert(false, "migrate_run must return valid JSON")
      return
    }
  }
  debug_assert(res1.ok, "Arc migration ok: " + res1.error)
  debug_assert(res1.bookmarks_added >= 2, "bookmarks imported (Farview + RFC 9111)")
  debug_assert(res1.spaces_added == 1, "Research space created")
  debug_assert(res1.folders_added == 1, "Papers folder created")
  debug_assert(res1.pinned_added == 1, "RFC 9111 pinned tab created")
  debug_assert(res1.extensions_added == 1, "MV3 extension imported")
  debug_assert(res1.skipped_unsafe == 1, "javascript: bookmark blocked")

  // 3. Idempotent re-import adds 0 duplicates
  let res2_json = host_migrate_run(req, -1, true)
  match proto::parse_migrate_result(res2_json) {
    Some(r2) => {
      debug_assert(r2.ok && r2.bookmarks_added == 0 && r2.spaces_added == 0 && r2.folders_added == 0 && r2.pinned_added == 0, "second import is idempotent")
    }
    None => debug_assert(false, "second migrate_run parse failed")
  }

  // 4. Standalone cookies.txt & Safari plist import
  let ck_path = tmp + "/cookies.txt"
  net::write_file(ck_path, "#HttpOnly_.mig.test\tTRUE\t/\tTRUE\t2100000000\tsess\ttok42\n")
  let ck_json = host_migrate_import_file(ck_path, -1, true)
  match proto::parse_migrate_result(ck_json) {
    Some(r) => debug_assert(r.ok && r.cookies_added == 1, "cookies.txt imported into jar")
    None => debug_assert(false, "cookies.txt import parse failed")
  }

  page::clear_extensions()
  net::setenv("FV_MIGRATE_HOME", "")
  net::setenv("FV_MIGRATE_OS", "")
}
