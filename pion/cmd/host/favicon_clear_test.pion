///| Site icons on the host: clearing history or a site's data takes its icons from `<profile>/favicons` (index,
///| PNGs) and from the profile's other tab processes (`cleared.tsv`); the SVG bound reads names with a namespace
///| prefix and in any case.

import "net"
import "proto"

fn fct_cstr(s : String) -> Bytes {
  (s + page::nul_str()).to_bytes()
}

fn fct_rec(key : String, hash : String, at : Int64) -> proto::FaviconRecord {
  proto::FaviconRecord::{ key, hash, fetched_secs: at, used_secs: at, named: "" }
}

test "favicon clear: a site's and then every site's icons leave the index, its PNGs and other processes" {
  // (relative to the test's directory: no /tmp on Windows)
  let dir = "fv_fav_clear_" + net::getpid().to_string()
  net::mkdir(dir)
  let now = fetch::wall_now_secs()
  let ha = "00000000000000a1"
  let hb = "00000000000000b2"
  net::write_bytes_atomic(dir + "/" + ha + ".png", "a".to_bytes())
  net::write_bytes_atomic(dir + "/" + hb + ".png", "b".to_bytes())
  let recs = [fct_rec("a.example", ha, now - 10L), fct_rec("b.example", hb, now - 10L)]
  net::write_file_atomic(dir + "/index.tsv", proto::favicon_index_text(recs))
  fav_index.clear()
  fav_cleared_seen.v = ""
  for r in recs {
    fav_index[r.key] = r
  }
  // one site's data cleared
  fav_forget_in(dir, "a.example")
  debug_assert(!fav_index.contains("a.example") && fav_index.contains("b.example"), "only a.example forgotten in memory")
  let on_disk = proto::favicon_index_parse(read_file_text(dir + "/index.tsv").unwrap_or(""))
  debug_assert(on_disk.length() == 1 && on_disk[0].key == "b.example", "index.tsv keeps only b.example")
  debug_assert(!file_exists(dir + "/" + ha + ".png") && file_exists(dir + "/" + hb + ".png"), "a.example's PNG removed")
  let cleared = read_file_text(dir + "/cleared.tsv").unwrap_or("")
  let a_hash = proto::favicon_hash("a.example".to_bytes())
  debug_assert(
    cleared != "" && !cleared.contains("a.example") && !cleared.contains(a_hash),
    "the clear is told without naming the site, not even by its hash: " + cleared,
  )
  // another tab process still holding a.example from before: it drops it on its next read, not writing it back,
  // and keeps b.example (the index still lists it)
  fav_index["a.example"] = recs[0]
  fav_cleared_seen.v = ""
  fav_apply_cleared(dir)
  debug_assert(!fav_index.contains("a.example"), "another process's old record dropped")
  debug_assert(fav_index.contains("b.example"), "a site the index lists is kept")
  // one fetched after the clear stays
  fav_index["a.example"] = fct_rec("a.example", ha, now + 5L)
  fav_cleared_seen.v = ""
  fav_apply_cleared(dir)
  debug_assert(fav_index.contains("a.example"), "a record fetched after the clear is kept")
  // the whole history cleared
  fav_forget_in(dir, "*")
  debug_assert(fav_index.length() == 0, "no records in memory")
  debug_assert(read_file_text(dir + "/index.tsv").unwrap_or("x") == "", "index.tsv empty")
  debug_assert(!file_exists(dir + "/" + hb + ".png"), "every PNG removed")
  debug_assert(fav_recent().length() == 0, "nothing sent to a client that comes on")
  for f in ["index.tsv", "cleared.tsv", "index.lock"] {
    remove_file_quiet(dir + "/" + f)
  }
  let dir_c = fct_cstr(dir)
  let _ = host_test_rmdir(bytes_data_ptr(dir_c))
  fav_cleared_seen.v = ""
}

test "favicon svg bound: <use>/<filter> with a namespace prefix or in another case, and <!Entity, are seen" {
  let ok = fn(s : String) -> Bool { fav_svg_bounded(s.to_bytes()) }
  debug_assert(ok("<svg><path d='M0 0'/><user/></svg>"), "a plain icon")
  debug_assert(!ok("<svg><filter id='f'/></svg>"), "filter")
  debug_assert(!ok("<svg:svg xmlns:svg='http://www.w3.org/2000/svg'><svg:filter id='f'/></svg:svg>"), "svg:filter")
  debug_assert(!ok("<svg><FILTER/></svg>"), "FILTER")
  debug_assert(!ok("<?xml version='1.0'?><!DOCTYPE svg [<!Entity a 'xx'>]><svg/>"), "!Entity")
  debug_assert(!ok("<!DOCTYPE svg [<!ENTITY a 'xx'>]><svg/>"), "!ENTITY")
  let mut uses = "<svg>"
  let mut i = 0
  while i < 17 {
    uses = uses + "<svg:use href='#a'/>"
    i += 1
  }
  debug_assert(!ok(uses + "</svg>"), "17 svg:use")
  let mut sixteen = "<svg>"
  i = 0
  while i < 16 {
    sixteen = sixteen + "<x:USE href='#a'/>"
    i += 1
  }
  debug_assert(ok(sixteen + "</svg>"), "16 uses are fine")
  // a prefix with `.` or a non-ASCII character (invar's XML reader takes both in a name)
  debug_assert(!ok("<svg><a.b:filter xmlns:a.b='http://www.w3.org/2000/svg'/></svg>"), "a.b:filter")
  debug_assert(!ok("<svg><\u{E9}:filter/></svg>"), "e-acute:filter")
  let mut wide = "<svg>"
  i = 0
  while i < 17 {
    wide = wide + "<\u{E9}:use href='#a'/>"
    i += 1
  }
  debug_assert(!ok(wide + "</svg>"), "17 e-acute:use")
  debug_assert(ok("<svg><a.filter/><filter.x/></svg>"), "a name only with filter in it")
}
