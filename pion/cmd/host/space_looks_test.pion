///| Space themes on the host: `space_looks.json` round trip, an accent pick moving point 0, and themes carried
///| through a session snapshot (what a session restore seeds from).

import "proto"

test "host: space_looks.json round trips themes and skips unset or malformed entries" {
  let looks : Map[String, proto::SpaceTheme] = Map::new()
  let three = proto::SpaceTheme::{
    points: [proto::space_theme_point_at(0.1, 0.2), proto::space_theme_point_at(0.5, 0.4), proto::space_theme_point_at(0.9, 0.6)],
    mode: proto::SpaceThemeMode::Dark,
    grain: 0.3,
    intensity: 0.7,
  }
  looks.set("work", three)
  looks.set("plain", proto::space_theme_unset())
  let text = ws_space_looks_json(looks)
  let back : Map[String, proto::SpaceTheme] = Map::new()
  ws_space_looks_read(text, back)
  match back.get("work") {
    Some(t) => debug_assert(t.same(three), "theme kept")
    None => debug_assert(false, "work theme read back")
  }
  debug_assert(back.get("plain").is_none(), "unset themes are not written")
  let junk : Map[String, proto::SpaceTheme] = Map::new()
  ws_space_looks_read("{\"a\":\"not a theme\",\"b\":3}", junk)
  ws_space_looks_read("nonsense", junk)
  debug_assert(junk.keys().length() == 0, "malformed entries skipped")
}

test "host: picking a themed Space's accent moves point 0 and keeps the rest" {
  let t = proto::SpaceTheme::{
    points: [proto::space_theme_point_at(0.1, 0.2), proto::space_theme_point_at(0.6, 0.4)],
    mode: proto::SpaceThemeMode::Light,
    grain: 0.4,
    intensity: 0.6,
  }
  let after = ws_space_look_with_accent(t, "#10B981")
  debug_assert(after.points.length() == 2, "same count")
  debug_assert(after.points[0].rgba == 0x10B981FFL, "point 0 is the picked color exactly")
  debug_assert(after.points[1].rgba == t.points[1].rgba, "point 1 kept")
  debug_assert(after.mode.name() == "light" && after.grain == 0.4 && after.intensity == 0.6, "settings kept")
  debug_assert(ws_space_look_with_accent(proto::space_theme_unset(), "#10B981").is_unset(), "unset stays unset")
}

test "host: a session snapshot carries Space themes (restore seeds them back)" {
  let t = proto::SpaceTheme::{ ..proto::space_theme_from_accent("#8B5CF6"), mode: proto::SpaceThemeMode::Dark, grain: 0.5 }
  let snap = proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "a",
    spaces: [
      proto::SpaceSummary::{ id: "a", name: "A", accent: "#8B5CF6", theme: t, active: true, tab_count: 0 },
      proto::SpaceSummary::{ id: "b", name: "B", accent: "#10B981", theme: proto::space_theme_unset(), active: false, tab_count: 0 },
    ],
  }
  match proto::parse_workspace_snapshot(proto::encode_workspace_snapshot(snap)) {
    Some(back) => {
      debug_assert(back.spaces[0].theme.same(t), "themed Space restored with its theme")
      debug_assert(back.spaces[1].theme.is_unset(), "accent-only Space stays accent-only")
    }
    None => debug_assert(false, "snapshot parses")
  }
}
