///| `library` scenes for the offscreen gallery (`FV_SHOTS_ONLY=library`): the sidebar switched into Create a Space
///| (empty, named, with the theme editor open) and into the Library (Downloads with pictures and files, Media,
///| Spaces (and a hovered row), Boosts, Archived Tabs, a hovered card, empty sections), the result of Create Space and
///| the way back to the tabs. Named `library-<scene>-<light|dark>[-480].png`.

import "film"
import "lg"
import "proto"
import "shell_ui"
import "ui"
import "view"

///| Renders the demo shell with sidebar modes; `setup` puts the modes state where the scene wants it (before the
///| frame is built: it is there at once), `script` then drives it.
fn library_shot(
  w_world : World,
  out_dir : String,
  filename : String,
  width : Double,
  setup : (shell_ui::SidebarModeState, shell_ui::ShellController) -> Unit,
  dark~ : Bool = false,
  empty~ : Bool = false,
  script~ : String = "wait 400",
) -> Bool {
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      shell_ui::demo_library_images()
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let state = shell_ui::SidebarModeState::new()
      let modes = shell_ui::demo_sidebar_modes(ctrl, state, empty=empty)
      setup(state, ctrl)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      let hooks = shell_ui::ShellHostHooks::{ ..shell_ui::ShellHostHooks::empty(), sidebar_modes: Some(modes) }
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    path=path,
    w=width,
    h=800.0,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script=script,
    theme=lg::ui_theme,
  )
  io_println(w_world, if ok { "shell_shots: wrote " + path } else { "shell_shots: FAILED " + path })
  ok
}

fn library_create(theme~ : proto::SpaceTheme = shell_ui::create_space_default_theme(3), name~ : String = "") -> (shell_ui::SidebarModeState, shell_ui::ShellController) -> Unit {
  fn(st, _ctrl) { st.start_create(theme, name~) }
}

fn library_open(section : String) -> (shell_ui::SidebarModeState, shell_ui::ShellController) -> Unit {
  fn(st, _ctrl) { st.open_library(section~) }
}

///| The Spaces section with one Space carrying a gradient theme (Aurora on Lab), so its swatch shows the gradient.
fn library_spaces_setup() -> (shell_ui::SidebarModeState, shell_ui::ShellController) -> Unit {
  fn(st, ctrl) {
    for pr in proto::space_theme_presets() {
      if pr.key == "aurora" {
        shell_ui::demo_land_space_theme(ctrl, "lab", pr.theme)
      }
    }
    st.open_library(section=shell_ui::LIBRARY_SPACES)
  }
}

fn library_pair(w : World, out_dir : String, name : String, setup : (shell_ui::SidebarModeState, shell_ui::ShellController) -> Unit, narrow~ : Bool = false, empty~ : Bool = false, script~ : String = "wait 400") -> Bool {
  let mut ok = true
  ok = library_shot(w, out_dir, "library-" + name + "-light.png", 1280.0, setup, empty~, script~) && ok
  ok = library_shot(w, out_dir, "library-" + name + "-dark.png", 1280.0, setup, dark=true, empty~, script~) && ok
  if narrow {
    ok = library_shot(w, out_dir, "library-" + name + "-light-480.png", 480.0, setup, empty~, script~) && ok
    ok = library_shot(w, out_dir, "library-" + name + "-dark-480.png", 480.0, setup, dark=true, empty~, script~) && ok
  }
  ok
}

pub fn render_library_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // Create a Space: as it opens (nothing typed: Create Space waits for a name), with a name, and choosing a theme.
  ok = library_pair(w, out_dir, "create", library_create(), narrow=true) && ok
  ok = library_pair(w, out_dir, "create-named", library_create(name="Studio")) && ok
  ok = library_pair(w, out_dir, "create-theme", library_create(name="Studio"), script="wait 300\npress Choose a Theme\nwait 400") && ok
  // After Create Space: the new Space active with its theme on the frame, the tabs back.
  ok = library_pair(w, out_dir, "create-done", library_create(name="Studio"), script="wait 300\npress Create Space\nwait 600") && ok
  // Library sections over the demo data.
  ok = library_pair(w, out_dir, "downloads", library_open(shell_ui::LIBRARY_DOWNLOADS), narrow=true) && ok
  ok = library_pair(w, out_dir, "downloads-hover", library_open(shell_ui::LIBRARY_DOWNLOADS), script="wait 300\nhover Open coast-path.jpg\nwait 300") && ok
  ok = library_pair(w, out_dir, "media", library_open(shell_ui::LIBRARY_MEDIA)) && ok
  ok = library_pair(w, out_dir, "spaces", library_spaces_setup()) && ok
  ok = library_pair(w, out_dir, "spaces-hover", library_spaces_setup(), script="wait 300\nhover Switch to Life\nwait 300") && ok
  ok = library_pair(w, out_dir, "boosts", library_open(shell_ui::LIBRARY_BOOSTS)) && ok
  ok = library_pair(w, out_dir, "archived", library_open(shell_ui::LIBRARY_ARCHIVED)) && ok
  ok = library_pair(w, out_dir, "search", library_open(shell_ui::LIBRARY_DOWNLOADS), script="wait 300\npress Search Downloads\ntype jpg\nwait 300") && ok
  // Empty sections.
  ok = library_pair(w, out_dir, "empty-media", library_open(shell_ui::LIBRARY_MEDIA), empty=true) && ok
  ok = library_pair(w, out_dir, "empty-boosts", library_open(shell_ui::LIBRARY_BOOSTS), empty=true) && ok
  ok = library_pair(w, out_dir, "empty-archived", library_open(shell_ui::LIBRARY_ARCHIVED), empty=true) && ok
  // Mid-switch (60ms into the 200ms crossfade): the tabs fading out, the Library rising in.
  ok = library_shot(w, out_dir, "library-switch-mid-light.png", 1280.0, fn(_st, _ctrl) { () }, script="wait 300\npress Library\nwait 60") && ok
  ok = library_shot(w, out_dir, "library-create-mid-light.png", 1280.0, fn(_st, _ctrl) { () }, script="wait 300\npress New Space\nwait 60") && ok
  // Back from the Library: the tabs as they were (no entrance), 60ms in and settled.
  ok = library_shot(w, out_dir, "library-back-mid-light.png", 1280.0, library_open(shell_ui::LIBRARY_DOWNLOADS), script="wait 300\npress Back to Tabs\nwait 60") && ok
  ok = library_pair(w, out_dir, "back", library_open(shell_ui::LIBRARY_DOWNLOADS), script="wait 300\npress Back to Tabs\nwait 400") && ok
  // The tabs with the Library and New Space buttons on the space bar.
  ok = library_pair(w, out_dir, "tabs", fn(_st, _ctrl) { () }) && ok
  ok
}
