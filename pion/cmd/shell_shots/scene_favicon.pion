///| Site icon scenes for the offscreen gallery (`FV_SHOTS_ONLY=favicon`): the demo shell with synthetic icons
///| (plain shapes drawn at run time, `shell_ui::shell_favicon_demo_install`; no real site's mark) for some of its
///| sites and letter tiles for the rest, as a host that found icons for some sites gives them. Light and dark,
///| named `favicon-<scene>-<light|dark>.png`: the sidebar (tabs, favorites), the command bar (and a typed URL to a site with an icon), Ctrl+Tab, and the
///| sidebar before any icon came (the same frame with letter tiles, for a side-by-side check of no layout shift).

import "shell_ui"
import "view"

fn fav_scene_pair(
  w : World,
  out_dir : String,
  scene : String,
  icons : Bool,
  build : (view::View, shell_ui::ShellController) -> Unit,
) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    shell_ui::shell_site_icons_clear()
    if icons {
      shell_ui::shell_favicon_demo_install()
    }
    let name = "favicon-" + scene + "-" + (if dark { "dark" } else { "light" }) + ".png"
    ok = render_scene(w, out_dir, name, 1280.0, 800.0, build, dark=dark) && ok
  }
  shell_ui::shell_site_icons_clear()
  ok
}

pub fn render_favicon_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = fav_scene_pair(w, out_dir, "sidebar", true, fn(_root, _c) { () }) && ok
  ok = fav_scene_pair(w, out_dir, "sidebar-letters", false, fn(_root, _c) { () }) && ok
  ok = fav_scene_pair(w, out_dir, "command-bar", true, fn(root, ctrl) { mount_command_bar(root, ctrl, "", 0) }) && ok
  ok = fav_scene_pair(w, out_dir, "command-bar-url", true, fn(root, ctrl) { mount_command_bar(root, ctrl, "figma.com/files", 0) }) && ok
  ok = fav_scene_pair(w, out_dir, "tab-search", true, fn(root, ctrl) { mount_tab_search(root, ctrl, "", 0) }) && ok
  ok = fav_scene_pair(w, out_dir, "ctrl-tab", true, menus_build_mru) && ok
  ok
}
