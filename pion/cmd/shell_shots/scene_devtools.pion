///| `devtools` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=devtools`).
///| Each scene renders light and dark at 1280x800 and 480x800 (DevTools has a narrow layout),
///| named `devtools-<scene>-<light|dark>[-480].png`.
///|
///| Docked scenes mount the panel through the frame's own `bottom_dock` hook (as `pion/cmd/app` does), so it
///| sits under the page card exactly where it lives in the app. Floating scenes mount it over the window root.

import "film"
import "lg"
import "proto"
import "shell_ui"
import "signals"
import "ui"
import "view"

///| The page the demo shell shows (notes.example.com, "Designing for Reading"), as DevTools would see it.
fn dt_demo_snapshot() -> proto::DevToolsSnapshot {
  let node = fn(
    path : String,
    depth : Int,
    tag : String,
    id_attr : String,
    class_attr : String,
    text_preview : String,
    child_count : Int,
  ) -> proto::DevToolsDomNode {
    proto::DevToolsDomNode::{ path, depth, tag, id_attr, class_attr, attrs: [], text_preview, child_count }
  }
  let base = "https://notes.example.com"
  proto::DevToolsSnapshot::{
    page_url: base + "/designing-for-reading",
    page_title: "Designing for Reading",
    selected_path: "0.1.1",
    nodes: [
      proto::DevToolsDomNode::{ ..node("0", 0, "html", "", "", "", 2), attrs: [proto::DevToolsAttr::{ name: "lang", value: "en" }] },
      node("0.0", 1, "head", "", "", "", 14),
      node("0.1", 1, "body", "", "", "", 3),
      node("0.1.0", 2, "header", "", "site-header", "", 2),
      node("0.1.1", 2, "main", "content", "page", "", 1),
      node("0.1.1.0", 3, "article", "", "essay", "", 5),
      proto::DevToolsDomNode::{
        ..node("0.1.1.0.0", 4, "a", "", "kicker", "Typography", 0),
        attrs: [proto::DevToolsAttr::{ name: "href", value: "/topics/typography" }],
      },
      node("0.1.1.0.1", 4, "h1", "", "", "Designing for Reading", 0),
      node("0.1.1.0.2", 4, "p", "", "byline", "", 2),
      proto::DevToolsDomNode::{
        ..node("0.1.1.0.2.0", 5, "time", "", "", "November 24, 2026", 0),
        attrs: [proto::DevToolsAttr::{ name: "datetime", value: "2026-11-24" }],
      },
      node("0.1.1.0.3", 4, "p", "", "", "A page is easy to read when the eye never has to search", 0),
      node("0.1.1.0.4", 4, "p", "", "", "Most of the work happens before a single word is styled", 0),
      node("0.1.2", 2, "footer", "", "site-footer", "", 2),
    ],
    box_model: proto::DevToolsBoxModel::{
      width: 640.0,
      height: 1872.0,
      pad_top: 64.0,
      pad_right: 0.0,
      pad_bottom: 96.0,
      pad_left: 0.0,
      border_top: 0.0,
      border_right: 0.0,
      border_bottom: 0.0,
      border_left: 0.0,
      margin_top: 0.0,
      margin_right: 300.0,
      margin_bottom: 0.0,
      margin_left: 300.0,
    },
    styles: [
      proto::DevToolsStyleProp::{ name: "display", value: "block", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "max-width", value: "40rem", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "margin", value: "0 auto", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "padding", value: "4rem 0 6rem", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "font-family", value: "\"Source Serif 4\", Georgia, serif", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "font-size", value: "20px", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "line-height", value: "1.6", color_hex: "" },
      proto::DevToolsStyleProp::{ name: "color", value: "rgb(28, 28, 30)", color_hex: "#1C1C1E" },
    ],
    console_entries: [
      proto::DevToolsConsoleEntry::{ id: 1, level: "log", text: "Service worker registered with scope: https://notes.example.com/", source: "app.js:12" },
      proto::DevToolsConsoleEntry::{ id: 2, level: "warn", text: "The resource https://notes.example.com/fonts/source-serif-4.woff2 was preloaded using link preload but not used within a few seconds from the window's load event.", source: "designing-for-reading" },
      proto::DevToolsConsoleEntry::{ id: 3, level: "error", text: "Failed to load resource: the server responded with a status of 404 (Not Found)", source: "apple-touch-icon.png" },
      proto::DevToolsConsoleEntry::{ id: 4, level: "input", text: "document.querySelectorAll(\"article p\").length", source: "" },
      proto::DevToolsConsoleEntry::{ id: 5, level: "result", text: "3", source: "number" },
      proto::DevToolsConsoleEntry::{ id: 6, level: "input", text: "getComputedStyle(document.body).fontSize", source: "" },
      proto::DevToolsConsoleEntry::{ id: 7, level: "result", text: "\"20px\"", source: "string" },
      proto::DevToolsConsoleEntry::{ id: 8, level: "input", text: "matchMedia(\"(prefers-reduced-motion: reduce)\").matches", source: "" },
      proto::DevToolsConsoleEntry::{ id: 9, level: "result", text: "false", source: "boolean" },
    ],
    network_entries: [
      proto::DevToolsNetworkEntry::{ name: "designing-for-reading", url: base + "/designing-for-reading", kind: "document", status: 200, duration_ms: 148, size_bytes: 24816 },
      proto::DevToolsNetworkEntry::{ name: "site.css", url: base + "/assets/site.css", kind: "stylesheet", status: 200, duration_ms: 42, size_bytes: 18240 },
      proto::DevToolsNetworkEntry::{ name: "app.js", url: base + "/assets/app.js", kind: "script", status: 200, duration_ms: 76, size_bytes: 31507 },
      proto::DevToolsNetworkEntry::{ name: "source-serif-4.woff2", url: base + "/fonts/source-serif-4.woff2", kind: "font", status: 200, duration_ms: 61, size_bytes: 87312 },
      proto::DevToolsNetworkEntry::{ name: "measure-diagram.svg", url: base + "/images/measure-diagram.svg", kind: "image", status: 200, duration_ms: 29, size_bytes: 6144 },
      proto::DevToolsNetworkEntry::{ name: "related", url: base + "/api/related?slug=designing-for-reading", kind: "fetch", status: 200, duration_ms: 112, size_bytes: 1932 },
      proto::DevToolsNetworkEntry::{ name: "sw.js", url: base + "/sw.js", kind: "script", status: 304, duration_ms: 18, size_bytes: 0 },
      proto::DevToolsNetworkEntry::{ name: "apple-touch-icon.png", url: base + "/apple-touch-icon.png", kind: "image", status: 404, duration_ms: 23, size_bytes: 548 },
    ],
  }
}

fn dt_demo_props(
  dark : Bool,
  st : shell_ui::DevToolsPanelState,
  owner~ : shell_ui::PaneId = shell_ui::PaneId::Primary,
) -> shell_ui::DevToolsPanelProps {
  let snap = dt_demo_snapshot()
  shell_ui::DevToolsPanelProps::{
    open: fn() { true },
    dark: fn() { dark },
    owner_pane: fn() { owner },
    snapshot: fn() { snap },
    rev: fn() { 1 },
    state: st,
    on_inspect: fn(_p) { () },
    on_eval: fn(_e) { () },
    on_clear_console: fn() { () },
    on_copy_curl: fn(_c) { () },
    on_refresh: fn() { () },
    on_close: fn() { () },
    on_presentation_change: None,
    anchor_top: fn() { shell_ui::SHELL_TITLEBAND_H },
  }
}

fn dt_demo_state(tab : Int, floating : Bool, net_selected : Int) -> shell_ui::DevToolsPanelState {
  let st = shell_ui::DevToolsPanelState::new(
    presentation=if floating { shell_ui::DevToolsPresentation::Floating } else { shell_ui::DevToolsPresentation::Docked },
  )
  st.tab.set(tab)
  st.selected_path.set("0.1.1.0")
  st.collapsed_paths.set("0.0", true)
  st.net_selected_idx.set(net_selected)
  st.height.set(shell_ui::SP_160 * 2.0 + shell_ui::SP_48)
  st
}

///| Renders the demo shell with DevTools docked through the frame's `bottom_dock` hook.
fn render_docked(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  tab : Int,
  dark~ : Bool = false,
  net_selected~ : Int = -1,
  owner~ : shell_ui::PaneId = shell_ui::PaneId::Primary,
  dragging~ : Bool = false,
) -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      let st = dt_demo_state(tab, false, net_selected)
      st.dragging.set(dragging)
      let hooks = shell_ui::ShellHostHooks::{
        ..shell_ui::ShellHostHooks::empty(),
        bottom_dock: Some(fn(dock : view::View) -> Unit {
          shell_ui::build_devtools_panel(dock, dt_demo_props(dark, st, owner=owner), docked_only=true)
        }),
      }
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    at=500.0,
    theme=lg::ui_theme,
    async_write=true,
  )
  io_println(w_world, (if ok { "shell_shots: wrote " } else { "shell_shots: FAILED " }) + path)
  ok
}

fn render_floating(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  tab : Int,
  dark~ : Bool = false,
  net_selected~ : Int = -1,
) -> Bool {
  render_scene(
    w_world,
    out_dir,
    filename,
    w,
    h,
    fn(root : view::View, _ctrl : shell_ui::ShellController) -> Unit {
      let st = dt_demo_state(tab, true, net_selected)
      shell_ui::build_devtools_panel(root, dt_demo_props(dark, st), floating_only=true)
    },
    dark=dark,
  )
}

pub fn render_devtools_scenes(w : World, out_dir : String) -> Bool {
  let _ = signals::signal(0)
  let _ = ui::ref_new(0)
  let mut ok = true
  let modes : Array[(Bool, String)] = [(false, "light"), (true, "dark")]
  for m in modes {
    let (dark, name) = m
    ok = render_docked(w, out_dir, "devtools-elements-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_ELEMENTS, dark=dark) && ok
    ok = render_docked(w, out_dir, "devtools-elements-" + name + "-480.png", 480.0, 800.0, shell_ui::DEVTOOLS_TAB_ELEMENTS, dark=dark) && ok
    ok = render_docked(w, out_dir, "devtools-console-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_CONSOLE, dark=dark) && ok
    ok = render_docked(w, out_dir, "devtools-console-" + name + "-480.png", 480.0, 800.0, shell_ui::DEVTOOLS_TAB_CONSOLE, dark=dark) && ok
    ok = render_docked(w, out_dir, "devtools-network-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_NETWORK, dark=dark) && ok
    ok = render_docked(w, out_dir, "devtools-network-" + name + "-480.png", 480.0, 800.0, shell_ui::DEVTOOLS_TAB_NETWORK, dark=dark) && ok
    ok = render_docked(w, out_dir, "devtools-network-request-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_NETWORK, dark=dark, net_selected=0) && ok
    ok = render_docked(w, out_dir, "devtools-network-request-" + name + "-480.png", 480.0, 800.0, shell_ui::DEVTOOLS_TAB_NETWORK, dark=dark, net_selected=0) && ok
    // The right pane's DevTools (its toolbar names the pane), and the resize grabber as it shows while dragged.
    ok = render_docked(w, out_dir, "devtools-right-pane-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_CONSOLE, dark=dark, owner=shell_ui::PaneId::Secondary) && ok
    ok = render_docked(w, out_dir, "devtools-resizing-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_ELEMENTS, dark=dark, dragging=true) && ok
    ok = render_floating(w, out_dir, "devtools-floating-" + name + ".png", 1280.0, 800.0, shell_ui::DEVTOOLS_TAB_ELEMENTS, dark=dark) && ok
    ok = render_floating(w, out_dir, "devtools-floating-" + name + "-480.png", 480.0, 800.0, shell_ui::DEVTOOLS_TAB_CONSOLE, dark=dark) && ok
  }
  ok
}
