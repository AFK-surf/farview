///| `theme` scenes for the offscreen gallery (`FV_SHOTS_ONLY=theme`): the Space theme editor (open, a handle mid-drag,
///| the second page of presets) and frames painted by Space themes (a three-color gradient, strong grain, a Space
///| forced dark in a light app and one forced light in a dark app). Named `theme-<scene>-<light|dark>[-480].png`.

import "film"
import "lg"
import "proto"
import "shell_ui"
import "ui"
import "view"

fn theme_set(ctrl : shell_ui::ShellController, theme : proto::SpaceTheme) -> Unit {
  let sid = ctrl.active_space_id.untracked()
  let out : Array[shell_ui::ShellSpaceItem] = []
  for sp in ctrl.spaces.untracked() {
    if sp.id == sid {
      out.push(shell_ui::ShellSpaceItem::{ ..sp, theme, accent_rgba: theme.points[0].rgba })
    } else {
      out.push(sp)
    }
  }
  ctrl.spaces.set(out)
}

fn theme_three() -> proto::SpaceTheme {
  proto::SpaceTheme::{
    points: [proto::space_theme_point_at(0.62, 0.30), proto::space_theme_point_at(0.08, 0.10), proto::space_theme_point_at(0.90, 0.40)],
    mode: proto::SpaceThemeMode::Auto,
    grain: 0.25,
    intensity: 0.6,
  }
}

fn theme_open_editor(root : view::View, ctrl : shell_ui::ShellController) -> Unit {
  let name = ui::Field::new()
  name.set("Work")
  shell_ui::build_space_theme_editor(
    root,
    shell_ui::SpaceThemeEditorProps::{
      open: fn() { true },
      space_id: fn() { ctrl.active_space_id.get() },
      theme: fn() {
        let sid = ctrl.active_space_id.get()
        let mut t = proto::space_theme_unset()
        for sp in ctrl.spaces.get() {
          if sp.id == sid {
            t = if sp.theme.is_unset() { proto::space_theme_from_accent(proto::space_theme_hex(sp.accent_rgba)) } else { sp.theme }
          }
        }
        t
      },
      // The Space name at the foot of the sidebar ("Customize Space"); no sidebar (480): the middle of the window.
      trigger_anchor: fn() {
        if root.window_w() >= 600.0 {
          Some(shell_ui::AnchorRect::{ x: 8.0, y: 756.0, w: 160.0, h: 32.0 })
        } else {
          None
        }
      },
      name_field: Some(name),
      on_rename: fn(_sid, _name) { () },
      on_change: fn(_sid, t) { theme_set(ctrl, t) },
      on_close: fn() { () },
    },
  )
}

fn theme_scene_pair(
  w : World,
  out_dir : String,
  name : String,
  build : (view::View, shell_ui::ShellController) -> Unit,
  narrow~ : Bool = false,
) -> Bool {
  let mut ok = true
  ok = render_scene(w, out_dir, "theme-" + name + "-light.png", 1280.0, 800.0, build) && ok
  ok = render_scene(w, out_dir, "theme-" + name + "-dark.png", 1280.0, 800.0, build, dark=true) && ok
  if narrow {
    ok = render_scene(w, out_dir, "theme-" + name + "-light-480.png", 480.0, 800.0, build) && ok
    ok = render_scene(w, out_dir, "theme-" + name + "-dark-480.png", 480.0, 800.0, build, dark=true) && ok
  }
  ok
}

///| The editor over the three-color theme, driven by `script` and captured at script frame `frame` (60 fps; None:
///| after the script).
fn theme_scripted(w_world : World, out_dir : String, filename : String, width : Double, script : String, frame? : Int, dark~ : Bool = false) -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      theme_set(ctrl, theme_three())
      theme_open_editor(root, ctrl)
    },
    path=path,
    w=width,
    h=800.0,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script=script,
    frame?=frame,
    theme=lg::ui_theme,
    async_write=true,
  )
  io_println(w_world, if ok { "shell_shots: wrote " + path } else { "shell_shots: FAILED " + path })
  ok
}

pub fn render_theme_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // The editor over a three-color theme.
  ok = theme_scene_pair(
    w,
    out_dir,
    "editor",
    fn(root, ctrl) {
      theme_set(ctrl, theme_three())
      theme_open_editor(root, ctrl)
    },
    narrow=true,
  ) && ok
  // The editor over an accent-only Space (as saved before themes).
  ok = theme_scene_pair(w, out_dir, "editor-accent", fn(root, ctrl) { theme_open_editor(root, ctrl) }) && ok
  // A three-color gradient frame.
  ok = theme_scene_pair(w, out_dir, "gradient", fn(_root, ctrl) { theme_set(ctrl, theme_three()) }, narrow=true) && ok
  // Strong grain over a one-color theme.
  ok = theme_scene_pair(
    w,
    out_dir,
    "grain",
    fn(_root, ctrl) {
      theme_set(ctrl, proto::SpaceTheme::{ ..proto::space_theme_from_accent("#F59E0B"), grain: 1.0, intensity: 0.7 })
    },
  ) && ok
  // A Space forced dark (rendered with the app light) and one forced light (app dark).
  ok = render_scene(
    w,
    out_dir,
    "theme-forced-dark-app-light.png",
    1280.0,
    800.0,
    fn(_root, ctrl) {
      theme_set(ctrl, proto::SpaceTheme::{ ..theme_three(), mode: proto::SpaceThemeMode::Dark, grain: 0.0 })
    },
  ) && ok
  // A handle mid-drag (larger while held; the frame already follows), and the presets' second page.
  ok = theme_scripted(w, out_dir, "theme-drag-light.png", 1280.0, "wait 400\ndrag 204 401 -70 110 300", frame=36) && ok
  ok = theme_scripted(w, out_dir, "theme-drag-dark.png", 1280.0, "wait 400\ndrag 204 401 -70 110 300", frame=36, dark=true) && ok
  ok = theme_scripted(w, out_dir, "theme-presets-page2-light.png", 1280.0, "wait 400\npress More Themes\nwait 400") && ok
  ok = theme_scripted(w, out_dir, "theme-presets-page2-dark.png", 1280.0, "wait 400\npress More Themes\nwait 400", dark=true) && ok
  ok = render_scene(
    w,
    out_dir,
    "theme-forced-light-app-dark.png",
    1280.0,
    800.0,
    fn(_root, ctrl) {
      theme_set(ctrl, proto::SpaceTheme::{ ..theme_three(), mode: proto::SpaceThemeMode::Light, grain: 0.0 })
    },
    dark=true,
  ) && ok
  ok
}
