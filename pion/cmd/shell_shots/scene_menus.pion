    shell_ui::BookmarkChipItem::{ id: "bm-wiki", title: "Wikipedia", url: "https://en.wikipedia.org/wiki/Main_Page" },
    shell_ui::BookmarkChipItem::{ id: "bm-hn", title: "Hacker News", url: "https://news.ycombinator.com" },
    shell_ui::BookmarkChipItem::{ id: "bm-grid", title: "CSS Grid Layout Module Level 3", url: "https://drafts.csswg.org/css-grid-3/" },
    shell_ui::BookmarkChipItem::{ id: "bm-wpt", title: "WPT Dashboard", url: "https://wpt.fyi/results/css" },
