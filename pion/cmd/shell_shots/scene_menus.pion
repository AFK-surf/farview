      items: menus_bookmarks,
      page_saved: fn() { true },
      on_navigate: fn(_u : String) -> Unit { () },
      on_context_menu: fn(_id : String, _u : String, _x : Double, _y : Double) -> Unit { () },
      on_toggle_bookmark: menus_noop,
    },
  )
}

///| Like `render_scene`, but mounts the Bookmarks Bar in the frame's `top_strip` slot (where the app puts it).
fn render_menus_strip_scene(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  build : (view::View, shell_ui::ShellController) -> Unit,
  dark~ : Bool = false,
) -> Bool {
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      let hooks = shell_ui::ShellHostHooks::{ ..shell_ui::ShellHostHooks::empty(), top_strip: Some(menus_bookmarks_strip) }
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
      build(root, ctrl)
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    at=500.0,
    theme=lg::ui_theme,
  )
  if ok {
    io_println(w_world, "shell_shots: wrote " + path)
  } else {
    io_println(w_world, "shell_shots: FAILED " + path)
  }
  ok
}

