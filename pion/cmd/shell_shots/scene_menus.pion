///| `menus` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=menus`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `menus-<scene>-<light|dark>[-480].png`, via `render_scene`.

fn menus_noop() -> Unit {
  ()
}

