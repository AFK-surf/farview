fn menus_mru_switcher(
  root : view::View,
  ctrl : shell_ui::ShellController,
  items : Array[shell_ui::MruTabEntry],
  selected : Int,
) -> Unit {
  shell_ui::build_mru_switcher_modal(
    root,
    shell_ui::MruSwitcherModalProps::{
      open: fn() { true },
      space_name: fn() { "Work" },
      items: fn() { items },
      selected_index: fn() { selected },
      on_select_tab: fn(_t) { () },
      on_hover_index: fn(_i) { () },
      on_close: menus_noop,
      content_left: fn(vw) {
        let dock = ctrl.model().dock()
        shell_ui::shell_sidebar_width(vw, dock.sidebar_open, custom_w=dock.sidebar_width)
      },
    },
  )
}

///| `Ctrl+Tab` once: the previous tab (second cell) is selected.
fn menus_build_mru(root : view::View, ctrl : shell_ui::ShellController) -> Unit {
  menus_mru_switcher(root, ctrl, menus_mru_tabs(), 1)
}

///| Twelve tabs, `Ctrl+Tab` held to the last: the strip has scrolled to end on it (tabs 7-11 at 1280, 10-11 at 480).
fn menus_build_mru_many(root : view::View, ctrl : shell_ui::ShellController) -> Unit {
  let items = menus_mru_tabs()
  for e in [
    ("t9", "Rust Playground", "play.rust-lang.org"),
    ("t10", "Figma — Shell 3", "figma.com"),
    ("t11", "Linear — Cycle 42", "linear.app"),
    ("t12", "The Verge", "theverge.com"),
    ("t13", "WPT Dashboard", "wpt.fyi"),
    ("t14", "Google Calendar — Week of Nov 23", "calendar.google.com"),
  ] {
    let (id, title, host) = e
    items.push(shell_ui::MruTabEntry::{ tab_id: id, title, host, playing: false, active: false })
  }
  menus_mru_switcher(root, ctrl, items, 11)
}

pub fn render_menus_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  let scenes : Array[(String, (view::View, shell_ui::ShellController) -> Unit, Bool)] = [
    ("perf-hud", menus_build_hud, false),
    ("tab-hover", menus_build_hover, false),
    ("tab-hover-status", menus_build_hover_status, false),
    ("page-ctx-link", menus_build_page_ctx, false),
    ("page-ctx-selection", menus_build_page_ctx_selection, false),
    ("page-ctx-field", menus_build_page_ctx_field, false),
    ("page-ctx-field-link", menus_build_page_ctx_field_link, false),
    ("tab-ctx", menus_build_tab_ctx, false),
    ("nav-hist", menus_build_nav_hist, false),
    ("folder-ctx", menus_build_folder_ctx, false),
    ("space-theme", menus_build_space_theme, true),
    ("mru", menus_build_mru, true),
    ("mru-many", menus_build_mru_many, true),
  ]
  let mut i = 0
  while i < scenes.length() {
    let (name, build, narrow) = scenes[i]
    ok = render_scene(w, out_dir, "menus-" + name + "-light.png", 1280.0, 800.0, build, dark=false) && ok
    ok = render_scene(w, out_dir, "menus-" + name + "-dark.png", 1280.0, 800.0, build, dark=true) && ok
    if narrow {
      ok = render_scene(w, out_dir, "menus-" + name + "-light-480.png", 480.0, 800.0, build, dark=false) && ok
    }
    i += 1
  }
  ok = render_menus_strip_scene(w, out_dir, "menus-bookmarks-bar-light.png", 1280.0, 800.0, menus_build_none) && ok
  ok = render_menus_strip_scene(w, out_dir, "menus-bookmarks-bar-dark.png", 1280.0, 800.0, menus_build_none, dark=true) && ok
  ok = render_menus_strip_scene(w, out_dir, "menus-bookmarks-bar-light-480.png", 480.0, 800.0, menus_build_none) && ok
  ok = render_menus_strip_scene(w, out_dir, "menus-bm-ctx-light.png", 1280.0, 800.0, menus_build_bm_ctx) && ok
  ok = render_menus_strip_scene(w, out_dir, "menus-bm-ctx-dark.png", 1280.0, 800.0, menus_build_bm_ctx, dark=true) && ok
  ok
}
