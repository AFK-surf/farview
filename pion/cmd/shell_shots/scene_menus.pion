///| The selected phrase on the demo page ("sixty to seventy-five characters"), tinted like a text selection so
///| the shot shows what the menu acts on.
fn menus_selection_tint(root : view::View) -> Unit {
  let _ = root.box(fn(sel : view::View) -> Unit {
    let _ = sel
    .over_at(view::Live::Is((Some(496.0), Some(390.0), None, None)))
    .width(view::Live::Is(Some(247.0)))
    .height(view::Live::Is(Some(24.0)))
    .radius(view::Live::Is(shell_ui::SP_2))
    .points(view::Live::Is(false))
    .ground(view::Live::By(fn() { lg::alpha(lg::surface().accent, if lg::is_dark() { 0.40 } else { 0.25 }) }))
  })
}

