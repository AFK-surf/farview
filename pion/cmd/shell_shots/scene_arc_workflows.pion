///| Arc workflow scenes for the offscreen gallery (`FV_SHOTS_ONLY=arc`), light and dark at 1280x800:
///| `arc-pip-<light|dark>.png` (the Auto-PiP mini player at rest), `arc-pip-hover-<light|dark>.png` (its controls
///| shown) and `arc-atc-<light|dark>.png` (Settings > Tabs > Air Traffic Control with rules).

import "film"
import "lg"
import "proto"
import "shell_ui"
import "signals"
import "view"

fn arc_demo_pip() -> proto::AutoPipState {
  proto::AutoPipState::{
    ..proto::AutoPipState::hidden(),
    active: true,
    tab_id: "42",
    title: "Designing calm interfaces \u{2014} Talk",
    host: "video.example.com",
    playing: true,
    progress: 0.38,
    duration_secs: 1834,
  }
}

fn arc_pip_shot(w_world : World, out_dir : String, filename : String, dark : Bool, hover : Bool) -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      let state = signals::signal(arc_demo_pip())
      let hooks = shell_ui::ShellHostHooks::{
        ..shell_ui::ShellHostHooks::empty(),
        body_overlays: Some(fn(body : view::View) -> Unit {
          shell_ui::build_auto_pip_overlay(body, shell_ui::AutoPipProps::{
            state: fn() { state.get() },
            on_back: fn() { () },
            on_toggle_play: fn() { () },
            on_toggle_mute: fn() { () },
            on_close: fn() { () },
            on_place: fn(_c, _w) { () },
          })
        }),
      }
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    path=path,
    w=1280.0,
    h=800.0,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script=if hover { "wait 400\nhover Mini Video Player\nwait 400" } else { "" },
    at=500.0,
    theme=lg::ui_theme,
  )
  io_println(w_world, (if ok { "shell_shots: wrote " } else { "shell_shots: FAILED " }) + path)
  ok
}

fn arc_demo_atc_props() -> shell_ui::AtcEditorProps {
  let rules = signals::signal([
    proto::AtcRule::{ id: "atc-1", pattern: "*.github.com", match_kind: "host", target_space_id: "work", enabled: true, open_in_quick_window: false },
    proto::AtcRule::{ id: "atc-2", pattern: "docs.google.com/spreadsheets", match_kind: "prefix", target_space_id: "work", enabled: true, open_in_quick_window: false },
    proto::AtcRule::{ id: "atc-3", pattern: "figma.com", match_kind: "host", target_space_id: "", enabled: false, open_in_quick_window: true },
  ])
  shell_ui::AtcEditorProps::{
    rules: fn() { rules.get() },
    spaces: fn() {
      [
        shell_ui::ShellSpaceItem::{ id: "work", name: "Work", accent_rgba: 0x007AFFFFL, theme: proto::space_theme_unset() },
        shell_ui::ShellSpaceItem::{ id: "personal", name: "Life", accent_rgba: 0x10B981FFL, theme: proto::space_theme_unset() },
      ]
    },
    on_upsert: fn(r) { rules.set(proto::atc_rules_upsert(rules.untracked(), r)) },
    on_toggle: fn(id, on) { rules.set(proto::atc_rules_toggle(rules.untracked(), id, on)) },
    on_delete: fn(id) { rules.set(proto::atc_rules_delete(rules.untracked(), id)) },
  }
}

pub fn render_arc_workflow_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let sfx = if dark { "dark" } else { "light" }
    ok = arc_pip_shot(w, out_dir, "arc-pip-" + sfx + ".png", dark, false) && ok
    ok = arc_pip_shot(w, out_dir, "arc-pip-hover-" + sfx + ".png", dark, true) && ok
    ok = render_scene(
      w,
      out_dir,
      "arc-atc-" + sfx + ".png",
      1280.0,
      800.0,
      fn(root, ctrl) { mount_settings(root, ctrl, shell_ui::SETTINGS_TAB_TABS, "air traffic", atc=Some(arc_demo_atc_props())) },
      dark=dark,
    ) && ok
  }
  ok
}
