///| `command` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=command`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `command-<scene>-<light|dark>[-480].png`, via `render_scene`.
///|
///| The rows come from the real builders (`proto::build_command_bar_items`, `proto::build_tab_search_results`)
///| over a small workspace of three Spaces, so what is drawn is what the app would show for that workspace.

import "proto"
import "shell_ui"
import "ui"
import "view"

fn cmd_demo_tab(id : String, space : String, title : String, url : String, active~ : Bool = false, pinned~ : Bool = false, favorite~ : Bool = false) -> proto::TabSummary {
  proto::TabSummary::{
    id,
    space_id: space,
    title,
    url,
    pinned,
    favorite,
    active,
    state: "",
    folder_id: "",
    last_active_secs: 0L,
  }
}

fn cmd_demo_snapshot() -> proto::WorkspaceSnapshot {
  proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: "work",
    active_tab_id: "t-mdn",
    spaces: [
      proto::SpaceSummary::{ id: "work", name: "Work", accent: "#007AFF", active: true, tab_count: 4 },
      proto::SpaceSummary::{ id: "research", name: "Research", accent: "#AF52DE", active: false, tab_count: 2 },
      proto::SpaceSummary::{ id: "personal", name: "Personal", accent: "#34C759", active: false, tab_count: 2 },
    ],
    tabs: [
      cmd_demo_tab("t-mdn", "work", "CSS grid layout - CSS | MDN", "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout", active=true),
      cmd_demo_tab("t-gh", "work", "Pull requests · rust-lang/rust", "https://github.com/rust-lang/rust/pulls", pinned=true),
      cmd_demo_tab("t-hn", "work", "Hacker News", "https://news.ycombinator.com/", favorite=true),
      cmd_demo_tab("t-spec", "work", "CSS Grid Layout Module Level 2", "https://www.w3.org/TR/css-grid-2/"),
      cmd_demo_tab("t-wiki", "research", "Color theory - Wikipedia", "https://en.wikipedia.org/wiki/Color_theory"),
      cmd_demo_tab("t-arxiv", "research", "Attention Is All You Need", "https://arxiv.org/abs/1706.03762"),
      cmd_demo_tab("t-yt", "personal", "Nils Frahm - Says (Live)", "https://www.youtube.com/watch?v=dIwwjy4slI8"),
      cmd_demo_tab("t-maps", "personal", "Lisbon - Google Maps", "https://www.google.com/maps/place/Lisbon"),
    ],
    closed_count: 2,
    media: Some(proto::MediaMiniState::{
      tab_id: "t-yt",
      title: "Nils Frahm - Says (Live)",
      host: "youtube.com",
      playing: true,
      muted: false,
      is_meeting: false,
      accent: "#34C759",
    }),
  }
}

fn cmd_demo_closed() -> proto::ClosedTabsSnapshot {
  proto::ClosedTabsSnapshot::{
    items: [
      proto::ClosedTabItem::{
        index: 0,
        title: "Flexbox - Learn web development | MDN",
        url: "https://developer.mozilla.org/en-US/docs/Learn/CSS/CSS_layout/Flexbox",
        host: "developer.mozilla.org",
        space_name: "Work",
        closed_secs: 0L,
      },
      proto::ClosedTabItem::{
        index: 1,
        title: "Bauhaus - Wikipedia",
        url: "https://en.wikipedia.org/wiki/Bauhaus",
        host: "en.wikipedia.org",
        space_name: "Research",
        closed_secs: 0L,
      },
    ],
  }
}

fn cmd_open_bar(ctrl : shell_ui::ShellController, kind : shell_ui::ExclusiveKind, tag : String) -> Unit {
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(kind, tag=tag))
}

fn mount_command_bar(root : view::View, ctrl : shell_ui::ShellController, query : String, selected : Int) -> Unit {
  let field = ui::Field::new()
  field.set(query)
  let items = proto::build_command_bar_items(cmd_demo_snapshot(), query, "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout", true)
  cmd_open_bar(ctrl, shell_ui::ExclusiveKind::CommandBar, "command_bar")
  shell_ui::build_command_bar_overlay(
    root,
    ctrl.model(),
    shell_ui::CommandBarProps::{
      field,
      items: fn() { items },
      selected: fn() { selected },
      on_query_change: fn(_q) { () },
      on_step: fn(_d) { true },
      on_submit: fn(_t) { () },
      on_execute: fn(_it) { () },
      on_close: fn() { () },
      on_row_view: None,
      on_clear_rows: None,
    },
  )
  let len = field.text().length()
  field.focus()
  field.pick(len, len)
}

fn mount_tab_search(root : view::View, ctrl : shell_ui::ShellController, query : String, selected : Int) -> Unit {
  let field = ui::Field::new()
  field.set(query)
  let res = proto::build_tab_search_results(cmd_demo_snapshot(), cmd_demo_closed(), query)
  cmd_open_bar(ctrl, shell_ui::ExclusiveKind::TabSearch, "tab_search")
  shell_ui::build_tab_search_overlay(
    root,
    ctrl.model(),
    shell_ui::TabSearchProps::{
      field,
      results: fn() { res },
      selected: fn() { selected },
      on_query_change: fn(_q) { () },
      on_submit: fn() { () },
      on_activate: fn(_it) { () },
      on_close_tab: fn(_id) { () },
      on_close: fn() { () },
    },
  )
  let len = field.text().length()
  field.focus()
  field.pick(len, len)
}

fn cmd_scene_set(
  w : World,
  out_dir : String,
  name : String,
  narrow : Bool,
  build : (view::View, shell_ui::ShellController) -> Unit,
) -> Bool {
  let mut ok = true
  ok = render_scene(w, out_dir, "command-" + name + "-light.png", 1280.0, 800.0, build) && ok
  ok = render_scene(w, out_dir, "command-" + name + "-dark.png", 1280.0, 800.0, build, dark=true) && ok
  if narrow {
    ok = render_scene(w, out_dir, "command-" + name + "-light-480.png", 480.0, 800.0, build) && ok
    ok = render_scene(w, out_dir, "command-" + name + "-dark-480.png", 480.0, 800.0, build, dark=true) && ok
  }
  ok
}

pub fn render_command_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // Command Bar, nothing typed: two tabs from other Spaces, a Space, then the first commands.
  ok = cmd_scene_set(w, out_dir, "bar", true, fn(root, ctrl) { mount_command_bar(root, ctrl, "", 0) }) && ok
  // Command Bar while typing "grid": matching tabs, then the web search fallback.
  ok = cmd_scene_set(w, out_dir, "bar-query", false, fn(root, ctrl) { mount_command_bar(root, ctrl, "grid", 1) }) && ok
  // Command Bar while typing "split": commands with their shortcuts.
  ok = cmd_scene_set(w, out_dir, "bar-commands", false, fn(root, ctrl) { mount_command_bar(root, ctrl, "split", 0) }) && ok
  // Tab Search, nothing typed: every open tab across Spaces, then recently closed.
  ok = cmd_scene_set(w, out_dir, "tabs", true, fn(root, ctrl) { mount_tab_search(root, ctrl, "", 1) }) && ok
  // Tab Search while typing "wiki": one open and one closed match.
  ok = cmd_scene_set(w, out_dir, "tabs-query", false, fn(root, ctrl) { mount_tab_search(root, ctrl, "wiki", 0) }) && ok
  // Tab Search with no match.
  ok = cmd_scene_set(w, out_dir, "tabs-empty", false, fn(root, ctrl) { mount_tab_search(root, ctrl, "kubernetes", 0) }) && ok
  ok
}
