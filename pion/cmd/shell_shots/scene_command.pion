///| `command` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=command`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `command-<scene>-<light|dark>[-480].png`, via `render_scene`.
///|
///| The rows come from the real builders (`proto::build_command_bar_items`, `proto::build_tab_search_results`)
///| over the same workspace the frame behind the panel draws: the demo controller's Spaces (Work, Life, Lab),
///| its Work tabs (the sidebar), its active tab and its mini player. The scene adds a few tabs to the other
///| two Spaces (to the controller too, so the sidebar and the panel never disagree) and two recently closed
///| tabs.

import "film"
import "lg"
import "proto"
import "shell_ui"
import "ui"
import "view"

///| Tabs the scene adds to the Spaces the sidebar is not showing.
fn cmd_extra_tabs() -> Array[shell_ui::ShellTabItem] {
  let mk = fn(id : String, space : String, title : String, url : String) -> shell_ui::ShellTabItem {
    shell_ui::ShellTabItem::{
      id,
      title,
      url,
      folder_id: "",
      space_id: space,
      pinned: false,
      active: false,
      playing_audio: false,
      muted: false,
    }
  }
  [
    mk("t-maps", "personal", "Lisbon - Google Maps", "https://www.google.com/maps/place/Lisbon"),
    mk("t-yt", "personal", "Nils Frahm - Says (Live)", "https://www.youtube.com/watch?v=dIwwjy4slI8"),
    mk("t-gh", "lab", "Pull requests · rust-lang/rust", "https://github.com/rust-lang/rust/pulls"),
    mk("t-wiki", "lab", "Color theory - Wikipedia", "https://en.wikipedia.org/wiki/Color_theory"),
    mk("t-hn", "lab", "Hacker News", "https://news.ycombinator.com/"),
  ]
}

fn cmd_hex2(v : Int) -> String {
  let d = "0123456789ABCDEF"
  d.slice((v >> 4) & 15, ((v >> 4) & 15) + 1) + d.slice(v & 15, (v & 15) + 1)
}

///| `0x007AFFFF` -> `#007AFF`.
fn cmd_accent_hex(rgba : Int64) -> String {
  let v = (rgba >> 8).to_int()
  "#" + cmd_hex2((v >> 16) & 255) + cmd_hex2((v >> 8) & 255) + cmd_hex2(v & 255)
}

///| Adds the scene's tabs to the controller, then builds the workspace snapshot from the controller itself.
fn cmd_snapshot_from(ctrl : shell_ui::ShellController) -> proto::WorkspaceSnapshot {
  let all = ctrl.tabs.untracked()
  let mut have_extra = false
  for t in all {
    if t.id == "t-maps" {
      have_extra = true
    }
  }
  if !have_extra {
    let next : Array[shell_ui::ShellTabItem] = []
    for t in all {
      next.push(t)
    }
    for t in cmd_extra_tabs() {
      next.push(t)
    }
    ctrl.tabs.set(next)
  }
  let active_space = ctrl.active_space_id.untracked()
  let tabs : Array[proto::TabSummary] = []
  let mut active_tab = ""
  for t in ctrl.tabs.untracked() {
    if t.active {
      active_tab = t.id
    }
    tabs.push(proto::TabSummary::{
      id: t.id,
      space_id: t.space_id,
      title: t.title,
      url: t.url,
      pinned: t.pinned,
      favorite: false,
      active: t.active,
      state: "",
      folder_id: t.folder_id,
      last_active_secs: 0L,
    })
  }
  let spaces : Array[proto::SpaceSummary] = []
  for sp in ctrl.spaces.untracked() {
    let mut n = 0
    for t in tabs {
      if t.space_id == sp.id {
        n += 1
      }
    }
    spaces.push(proto::SpaceSummary::{ id: sp.id, name: sp.name, accent: cmd_accent_hex(sp.accent_rgba), active: sp.id == active_space, tab_count: n })
  }
  let mp = ctrl.mini_player.untracked()
  let mut media_accent = "#007AFF"
  for t in ctrl.tabs.untracked() {
    if t.id == mp.tab_id {
      for sp in ctrl.spaces.untracked() {
        if sp.id == t.space_id {
          media_accent = cmd_accent_hex(sp.accent_rgba)
        }
      }
    }
  }
  proto::WorkspaceSnapshot::{
    ..proto::WorkspaceSnapshot::empty(),
    active_space_id: active_space,
    active_tab_id: active_tab,
    spaces,
    tabs,
    closed_count: 2,
    media: if mp.active {
      Some(proto::MediaMiniState::{
        tab_id: mp.tab_id,
        title: mp.title,
        host: mp.domain,
        playing: mp.playing,
        muted: mp.muted,
        is_meeting: false,
        accent: media_accent,
      })
    } else {
      None
    },
  }
}

fn cmd_demo_closed() -> proto::ClosedTabsSnapshot {
  proto::ClosedTabsSnapshot::{
    items: [
      proto::ClosedTabItem::{
        index: 0,
        title: "Flexbox - Learn web development | MDN",
        url: "https://developer.mozilla.org/en-US/docs/Learn/CSS/CSS_layout/Flexbox",
        host: "developer.mozilla.org",
        space_name: "Work",
        closed_secs: 0L,
      },
      proto::ClosedTabItem::{
        index: 1,
        title: "Bauhaus - Wikipedia",
        url: "https://en.wikipedia.org/wiki/Bauhaus",
        host: "en.wikipedia.org",
        space_name: "Lab",
        closed_secs: 0L,
      },
    ],
  }
}

fn cmd_open_bar(ctrl : shell_ui::ShellController, kind : shell_ui::ExclusiveKind, tag : String) -> Unit {
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(kind, tag=tag))
}

fn mount_command_bar(root : view::View, ctrl : shell_ui::ShellController, query : String, selected : Int, is_macos~ : Bool = true) -> Unit {
  let field = ui::Field::new()
  field.set(query)
  let items = proto::build_command_bar_items(cmd_snapshot_from(ctrl), query, ctrl.url.untracked(), is_macos)
  cmd_open_bar(ctrl, shell_ui::ExclusiveKind::CommandBar, "command_bar")
  shell_ui::build_command_bar_overlay(
    root,
    ctrl.model(),
    shell_ui::CommandBarProps::{
      field,
      items: fn() { items },
      selected: fn() { selected },
      on_query_change: fn(_q) { () },
      on_step: fn(_d) { true },
      on_submit: fn(_t) { () },
      on_execute: fn(_it) { () },
      on_close: fn() { () },
      on_row_view: None,
      on_clear_rows: None,
    },
  )
  let len = field.text().length()
  field.focus()
  field.pick(len, len)
}

fn mount_tab_search(root : view::View, ctrl : shell_ui::ShellController, query : String, selected : Int) -> Unit {
  let field = ui::Field::new()
  field.set(query)
  let res = proto::build_tab_search_results(cmd_snapshot_from(ctrl), cmd_demo_closed(), query)
  cmd_open_bar(ctrl, shell_ui::ExclusiveKind::TabSearch, "tab_search")
  shell_ui::build_tab_search_overlay(
    root,
    ctrl.model(),
    shell_ui::TabSearchProps::{
      field,
      results: fn() { res },
      selected: fn() { selected },
      on_query_change: fn(_q) { () },
      on_submit: fn() { () },
      on_activate: fn(_it) { () },
      on_close_tab: fn(_id) { () },
      on_close: fn() { () },
    },
  )
  let len = field.text().length()
  field.focus()
  field.pick(len, len)
}

///| `render_scene` with a drive script (`hover <label>`), for states only a pointer reaches. Builds the same
///| demo shell `render_scene` does.
fn cmd_render_driven(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  script : String,
  build : (view::View, shell_ui::ShellController) -> Unit,
  dark~ : Bool = false,
) -> Bool {
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      build(root, ctrl)
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script=script,
    at=500.0,
    theme=lg::ui_theme,
  )
  if ok {
    io_println(w_world, "shell_shots: wrote " + path)
  } else {
    io_println(w_world, "shell_shots: FAILED " + path)
  }
  ok
}

fn cmd_scene_set(
  w : World,
  out_dir : String,
  name : String,
  narrow : Bool,
  build : (view::View, shell_ui::ShellController) -> Unit,
) -> Bool {
  let mut ok = true
  ok = render_scene(w, out_dir, "command-" + name + "-light.png", 1280.0, 800.0, build) && ok
  ok = render_scene(w, out_dir, "command-" + name + "-dark.png", 1280.0, 800.0, build, dark=true) && ok
  if narrow {
    ok = render_scene(w, out_dir, "command-" + name + "-light-480.png", 480.0, 800.0, build) && ok
    ok = render_scene(w, out_dir, "command-" + name + "-dark-480.png", 480.0, 800.0, build, dark=true) && ok
  }
  ok
}

pub fn render_command_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // Command Bar, nothing typed: the first two tabs of the Work Space that are not in front, the next Space,
  // then the first commands with their shortcuts.
  ok = cmd_scene_set(w, out_dir, "bar", true, fn(root, ctrl) { mount_command_bar(root, ctrl, "", 0) }) && ok
  // Command Bar while typing "grid": the matching tab, then the web search fallback. The first row is
  // selected, as in the app after typing.
  ok = cmd_scene_set(w, out_dir, "bar-query", false, fn(root, ctrl) { mount_command_bar(root, ctrl, "grid", 0) }) && ok
  // Command Bar while typing "split": the split view commands with their shortcuts.
  ok = cmd_scene_set(w, out_dir, "bar-commands", false, fn(root, ctrl) { mount_command_bar(root, ctrl, "split", 0) }) && ok
  // The same on Linux and Windows: Ctrl/Shift keycaps instead of the Mac symbols.
  ok = cmd_scene_set(w, out_dir, "bar-commands-ctrl", false, fn(root, ctrl) {
    mount_command_bar(root, ctrl, "split", 0, is_macos=false)
  }) && ok
  // Command Bar while typing a URL: the go-to row (teal tile) first.
  ok = cmd_scene_set(w, out_dir, "bar-url", false, fn(root, ctrl) { mount_command_bar(root, ctrl, "github.com/rust-lang", 0) }) && ok
  // Command Bar while typing the name of the Space in front: its row says "Current Space".
  ok = cmd_scene_set(w, out_dir, "bar-space", false, fn(root, ctrl) { mount_command_bar(root, ctrl, "work", 0) }) && ok
  // Tab Search, nothing typed: every open tab across Spaces (the one in front first), then recently closed.
  ok = cmd_scene_set(w, out_dir, "tabs", true, fn(root, ctrl) { mount_tab_search(root, ctrl, "", 0) }) && ok
  // Tab Search with no selection and the pointer over one open tab: its close button shows on hover alone.
  let hover = "wait 100\nhover Switch to WPT Dashboard: css\nwait 300"
  let hover_build = fn(root : view::View, ctrl : shell_ui::ShellController) -> Unit { mount_tab_search(root, ctrl, "", -1) }
  ok = cmd_render_driven(w, out_dir, "command-tabs-hover-light.png", 1280.0, 800.0, hover, hover_build) && ok
  ok = cmd_render_driven(w, out_dir, "command-tabs-hover-dark.png", 1280.0, 800.0, hover, hover_build, dark=true) && ok
  // Tab Search while typing "wiki": one open and one closed match.
  ok = cmd_scene_set(w, out_dir, "tabs-query", false, fn(root, ctrl) { mount_tab_search(root, ctrl, "wiki", 0) }) && ok
  // Tab Search with no match: only the Esc hint is left in the footer.
  ok = cmd_scene_set(w, out_dir, "tabs-empty", false, fn(root, ctrl) { mount_tab_search(root, ctrl, "kubernetes", 0) }) && ok
  ok
}
