///| Password manager scenes for the offscreen gallery (`FV_SHOTS_ONLY=passwords`): the Save password popover under
///| the address bar, the autofill dropdown over a login field, and Settings -> Privacy -> Passwords, light and dark
///| at 1280x800 (`passwords-<scene>-<light|dark>.png`).

import "proto"
import "shell_ui"
import "signals"
import "ui"
import "view"

fn pw_demo_items() -> Array[proto::PasswordItemSummary] {
  let mk = fn(id : String, origin : String, user : String) -> proto::PasswordItemSummary {
    proto::PasswordItemSummary::{
      id,
      origin,
      signon_realm: origin + "/",
      username: user,
      display_name: "",
      created_at: 0L,
      updated_at: 0L,
      last_used_at: 0L,
      times_used: 0,
    }
  }
  [
    mk("pw-1", "https://github.com", "octocat"),
    mk("pw-2", "https://accounts.example.com", "ada@example.com"),
    mk("pw-3", "https://news.ycombinator.com", "pg"),
  ]
}

fn mount_password_save(root : view::View, kind : String) -> Unit {
  let user_f = ui::Field::new()
  user_f.set("ada@example.com")
  shell_ui::build_password_save_popover(root, shell_ui::PasswordSavePopoverProps::{
    open: fn() { true },
    prompt: fn() {
      proto::PasswordPromptState::{
        visible: true,
        prompt_id: "pp-1",
        kind,
        origin: "https://accounts.example.com",
        username: "ada@example.com",
        display_name: "accounts.example.com",
        password_len: 14,
      }
    },
    username_field: user_f,
    trigger_anchor: fn() { Some(shell_ui::AnchorRect::{ x: 300.0, y: 12.0, w: 40.0, h: 32.0 }) },
    fallback_capsule: fn() { shell_ui::AnchorRect::{ x: 300.0, y: 12.0, w: 560.0, h: 32.0 } },
    on_save: fn(_u) { () },
    on_never: fn() { () },
    on_close: fn() { () },
  })
}

fn mount_autofill(root : view::View) -> Unit {
  // (a stand-in login field where a page would have one)
  let _ = root.box(fn(f : view::View) -> Unit {
    let _ = f
    .over_at(view::Live::Is((Some(460.0), Some(240.0), None, None)))
    .width(view::Live::Is(Some(320.0)))
    .height(view::Live::Is(Some(36.0)))
    .radius(view::Live::Is(6.0))
    .edge(view::Live::Is((1.0, 0x8E8E93FFL)))
    .ground(view::Live::Is(0xFFFFFFFFL))
  })
  shell_ui::build_autofill_dropdown(root, shell_ui::AutofillDropdownProps::{
    open: fn() { true },
    field_rect: fn() { shell_ui::AnchorRect::{ x: 460.0, y: 240.0, w: 320.0, h: 36.0 } },
    suggestions: fn() {
      [
        proto::AutofillSuggestion::{ id: "pw-2", origin: "https://www.example.com", username: "ada@example.com", display_name: "", exact: true },
        proto::AutofillSuggestion::{ id: "pw-4", origin: "https://accounts.example.com", username: "ada.work", display_name: "", exact: false },
      ]
    },
    can_generate: fn() { true },
    on_pick: fn(_id) { () },
    on_generate: fn() { () },
    on_manage: fn() { () },
    on_close: fn() { () },
  })
}

pub fn render_passwords_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "passwords-save-" + mode + ".png", 1280.0, 800.0, fn(root, _ctrl) {
      mount_password_save(root, "save")
    }, dark~) && ok
    ok = render_scene(w, out_dir, "passwords-update-" + mode + ".png", 1280.0, 800.0, fn(root, _ctrl) {
      mount_password_save(root, "update")
    }, dark~) && ok
    ok = render_scene(w, out_dir, "passwords-autofill-" + mode + ".png", 1280.0, 800.0, fn(root, _ctrl) { mount_autofill(root) }, dark~) && ok
    ok = render_scene(w, out_dir, "passwords-settings-" + mode + ".png", 1280.0, 800.0, fn(root, ctrl) {
      let shown = signals::signal("pw-1")
      mount_settings(root, ctrl, shell_ui::SETTINGS_TAB_PRIVACY, "passwords", passwords=Some(shell_ui::SettingsPasswordsProps::{
        items: pw_demo_items,
        search_field: ui::Field::new(),
        revealed: fn(id) { if shown.get() == id { Some("correct-horse-42") } else { None } },
        on_show: fn(id) { shown.set(id) },
        on_hide: fn(_id) { shown.set("") },
        on_copy_username: fn(_id) { () },
        on_copy_password: fn(_id) { () },
        on_delete: fn(_id) { () },
        on_import: fn() { () },
        on_export: fn() { () },
      }))
    }, dark~) && ok
  }
  ok
}
