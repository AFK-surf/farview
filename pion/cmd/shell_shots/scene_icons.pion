///| Icon sheet for the offscreen gallery (`FV_SHOTS_ONLY=icons`): every shell icon at 16pt and 20pt with its name,
///| light and dark, named `icons-sheet-<pack>-<light|dark>.png` (`<pack>` is "central" or "invar", the icon pack this
///| build draws; see tools/deps_icons.sh). Rendered once per pack, the two sheets compare the sets name by name.

import "film"
import "lg"
import "shell_ui"
import "ui"
import "view"

fn icons_sheet_names() -> Array[String] {
  let names = shell_ui::shell_icon_names()
  for n in ["menu", "chevrons-up-down", "square", "archive", "palette", "file-code", "trash", "edit", "eye", "link", "upload", "share", "home", "user", "users", "image", "mail", "key"] {
    if !names.contains(n) {
      names.push(n)
    }
  }
  names
}

pub fn render_icons_scenes(w_world : World, out_dir : String) -> Bool {
  let mut ok = true
  let names = icons_sheet_names()
  let cols = 8
  let cell_w = 150.0
  let cell_h = 64.0
  let rows = (names.length() + cols - 1) / cols
  for dark in [false, true] {
    if !take_shot_slot() {
      continue
    }
    let path = out_dir + "/icons-sheet-" + shell_ui::shell_icon_pack() + "-" + (if dark { "dark" } else { "light" }) + ".png"
    let ink = if dark { 0xF2F2F7FFL } else { 0x1C1C1EFFL }
    let sub = if dark { 0x8E8E93FFL } else { 0x6E6E73FFL }
    let wrote = film::picture(
      fn(root : view::View) -> Unit {
        let _ = root.box(fn(page : view::View) -> Unit {
          let _ = page
          .grow(view::Live::Is(1.0))
          .pad(view::Live::Is(24.0))
          .ground(view::Live::Is(if dark { 0x1C1C1EFFL } else { 0xFFFFFFFFL }))
          let mut r = 0
          while r < rows {
            let row_at = r
            let _ = page.box(fn(row : view::View) -> Unit {
              let _ = row.row(view::Live::Is(true))
              for c in 0..<cols {
                let i = row_at * cols + c
                if i >= names.length() {
                  break
                }
                let name = names[i]
                let _ = row.box(fn(cell : view::View) -> Unit {
                  let _ = cell.width(view::Live::Is(Some(cell_w))).height(view::Live::Is(Some(cell_h))).gap(view::Live::Is(6.0))
                  let _ = cell.box(fn(ir : view::View) -> Unit {
                    let _ = ir.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
                    let _ = shell_ui::shell_icon(ir, name, size=16.0, color_by=fn() { ink })
                    let _ = shell_ui::shell_icon(ir, name, size=20.0, color_by=fn() { ink })
                  })
                  <ui::Text in={cell} size={11.0} color={sub} text={name} />
                })
              }
            })
            r += 1
          }
        })
      },
      path=path,
      w=24.0 * 2.0 + cell_w * cols.to_double(),
      h=48.0 + cell_h * rows.to_double(),
      scale=2.0,
      dark=dark,
      at=200.0,
      theme=lg::ui_theme,
    )
    io_println(w_world, (if wrote { "shell_shots: wrote " } else { "shell_shots: FAILED " }) + path)
    ok = wrote && ok
  }
  let _ = ui::dmax(0.0, 0.0)
  ok
}
