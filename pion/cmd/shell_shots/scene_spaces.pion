    proto::ClosedTabItem::{ index: 1, title: "Pull requests", url: "https://github.com/AFK-surf/farview/pulls", host: "github.com", space_name: "Work", closed_secs: spaces_demo_now - 360L },
    proto::ClosedTabItem::{ index: 2, title: "Lisbon - Wikipedia", url: "https://en.wikipedia.org/wiki/Lisbon", host: "en.wikipedia.org", space_name: "Life", closed_secs: spaces_demo_now - 1500L },
    proto::ClosedTabItem::{ index: 3, title: "Hacker News", url: "https://news.ycombinator.com/", host: "news.ycombinator.com", space_name: "Life", closed_secs: spaces_demo_now - 7300L },
    proto::ClosedTabItem::{ index: 4, title: "CSS Grid Layout Module Level 3", url: "https://drafts.csswg.org/css-grid-3/", host: "drafts.csswg.org", space_name: "Lab", closed_secs: spaces_demo_now - 11000L },
    proto::ClosedTabItem::{ index: 5, title: "WebKit blog", url: "https://webkit.org/blog/", host: "webkit.org", space_name: "Lab", closed_secs: spaces_demo_now - 90000L },
  ]
}

fn mount_closed(root : view::View, items : Array[proto::ClosedTabItem], query : String) -> Unit {
  let search_field = ui::Field::new()
  search_field.set(query)
  shell_ui::build_closed_tabs_drawer_panel(
    root,
    shell_ui::ClosedTabsDrawerProps::{
      open: fn() { true },
      items: fn() { items },
      now_secs: fn() { spaces_demo_now },
      search_field,
      on_restore_tab: fn(_i, _t) { () },
      on_clear_all: fn() { () },
      on_close: fn() { () },
    },
  )
}

fn mount_print(root : view::View, paper : String, orientation : String, margins : String, bg : Bool) -> Unit {
  shell_ui::build_print_pdf_modal_panel(
    root,
    shell_ui::PrintPdfModalProps::{
      open: fn() { true },
      owner_pane: fn() { 0 },
      page_title: fn() { "Fetch API - Web APIs | MDN" },
      page_url: fn() { "https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API" },
      paper: signals::signal(paper),
      orientation: signals::signal(orientation),
      margins: signals::signal(margins),
      background_graphics: signals::signal(bg),
      on_save_pdf: fn(_p, _c) { () },
      on_cancel: fn() { () },
      return_focus: None,
    },
  )
}

///| The inline New Folder card mounted the way `cmd/app` mounts it: through the frame's
///| `sidebar_folder_create_slot`, so its inset and width come from the sidebar column.
fn render_folder_scene(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  dark : Bool,
  name : String,
  color : String,
  move_tab : Bool,
) -> Bool {
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      let name_field = ui::Field::new()
      name_field.set(name)
      let color_sig = signals::signal(color)
      let move_sig = signals::signal(move_tab)
      let hooks = shell_ui::ShellHostHooks::{
        ..shell_ui::ShellHostHooks::empty(),
        sidebar_folder_create_slot: Some(fn(sb : view::View) -> Unit {
          shell_ui::build_inline_folder_creator_bar(
            sb,
            shell_ui::InlineFolderCreatorProps::{
              open: fn() { true },
              name_field,
              color: color_sig,
              move_active_tab: move_sig,
              on_submit: fn(_n, _c, _m) { () },
              on_cancel: fn() { () },
              return_focus: None,
            },
          )
        }),
      }
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    at=500.0,
    theme=lg::ui_theme,
  )
  if ok {
    io_println(w_world, "shell_shots: wrote " + path)
  } else {
    io_println(w_world, "shell_shots: FAILED " + path)
  }
  ok
}

fn both(
  w : World,
  out_dir : String,
  scene : String,
  build : (view::View, shell_ui::ShellController) -> Unit,
  narrow~ : Bool = false,
) -> Bool {
  let mut ok = true
  ok = render_scene(w, out_dir, "spaces-" + scene + "-light.png", 1280.0, 800.0, build, dark=false) && ok
  ok = render_scene(w, out_dir, "spaces-" + scene + "-dark.png", 1280.0, 800.0, build, dark=true) && ok
  if narrow {
    ok = render_scene(w, out_dir, "spaces-" + scene + "-light-480.png", 480.0, 800.0, build, dark=false) && ok
    ok = render_scene(w, out_dir, "spaces-" + scene + "-dark-480.png", 480.0, 800.0, build, dark=true) && ok
  }
  ok
}

pub fn render_spaces_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = both(w, out_dir, "sessions", fn(root, _c) { mount_sessions(root, spaces_demo_sessions(), "Docs review", "") }, narrow=true) && ok
  ok = both(w, out_dir, "sessions-empty", fn(root, _c) { mount_sessions(root, [], "", "") }) && ok
  ok = both(w, out_dir, "spaces", fn(root, _c) { mount_spaces(root, "", "", "#2563EB") }, narrow=true) && ok
  ok = both(w, out_dir, "spaces-edit", fn(root, _c) { mount_spaces(root, "life", "", "#2563EB") }) && ok
  ok = both(w, out_dir, "spaces-new", fn(root, _c) { mount_spaces(root, "", "Reading", "#F59E0B") }) && ok
  ok = render_folder_scene(w, out_dir, "spaces-folder-light.png", 1280.0, 800.0, false, "Specs", "violet", true) && ok
  ok = render_folder_scene(w, out_dir, "spaces-folder-dark.png", 1280.0, 800.0, true, "Specs", "violet", true) && ok
  ok = both(w, out_dir, "closed", fn(root, _c) { mount_closed(root, spaces_demo_closed(), "") }, narrow=true) && ok
  ok = both(w, out_dir, "closed-empty", fn(root, _c) { mount_closed(root, [], "") }) && ok
  ok = both(w, out_dir, "print", fn(root, _c) { mount_print(root, "a4", "portrait", "default", true) }, narrow=true) && ok
  ok = both(w, out_dir, "print-landscape", fn(root, _c) { mount_print(root, "letter", "landscape", "narrow", false) }) && ok
  ok
}
