fn mount_sessions(root : view::View, items : Array[proto::NamedSessionSnapshot], name : String, filter : String) -> Unit {
  let name_field = ui::Field::new()
  name_field.set(name)
  let filter_field = ui::Field::new()
  filter_field.set(filter)
  shell_ui::build_sessions_modal_panel(
    root,
    shell_ui::SessionsModalProps::{
      open: fn() { true },
      sessions: fn() { items },
      current_space_count: fn() { 3 },
      current_tab_count: fn() { 8 },
      now_secs: fn() { spaces_demo_now },
      name_field,
      filter_field,
      on_save_session: fn(_n) { () },
      on_restore_session: fn(_i, _n) { () },
      on_delete_session: fn(_i, _n) { () },
      on_close: fn() { () },
      return_focus: None,
    },
  )
}

fn spaces_demo_spaces() -> Array[proto::SpaceSummary] {
  [
    proto::SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", active: true, tab_count: 5 },
    proto::SpaceSummary::{ id: "life", name: "Life", accent: "#10B981", active: false, tab_count: 3 },
    proto::SpaceSummary::{ id: "lab", name: "Lab", accent: "#8B5CF6", active: false, tab_count: 2 },
  ]
}

fn mount_spaces(root : view::View, edit_id : String, new_name : String, new_accent : String) -> Unit {
  let spaces = spaces_demo_spaces()
  let new_field = ui::Field::new()
  new_field.set(new_name)
  let rename_field = ui::Field::new()
  for s in spaces {
    if s.id == edit_id {
      rename_field.set(s.name)
    }
  }
  shell_ui::build_spaces_modal_panel(
    root,
    shell_ui::SpacesModalProps::{
      open: fn() { true },
      spaces: fn() { spaces },
      active_space_id: fn() { "work" },
      new_name_field: new_field,
      new_accent: signals::signal(new_accent),
      rename_space_id: signals::signal(edit_id),
      rename_field,
      color_edit_space_id: signals::signal(edit_id),
      on_create_space: fn(_n, _h) { () },
      on_switch_space: fn(_i) { () },
      on_rename_space: fn(_i, _n) { () },
      on_recolor_space: fn(_i, _h) { () },
      on_delete_space: fn(_i) { () },
      on_close: fn() { () },
      return_focus: None,
    },
  )
}

