      folders: [],
      tabs: [
        spaces_demo_tab("work", "Pull requests", "https://github.com/AFK-surf/farview/pulls"),
        spaces_demo_tab("work", "Fetch API - Web APIs | MDN", "https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API"),
        spaces_demo_tab("work", "Hacker News", "https://news.ycombinator.com/"),
      ],
    },
    proto::NamedSessionSnapshot::{
      id: "s-lisbon",
      name: "Trip to Lisbon",
      created_secs: spaces_demo_now - 100000L,
      active_space_id: "life",
      spaces: [proto::SessionSpaceItem::{ id: "life", name: "Life", accent: "#10B981" }],
      folders: [],
      tabs: [
        spaces_demo_tab("life", "Lisbon - Wikipedia", "https://en.wikipedia.org/wiki/Lisbon"),
        spaces_demo_tab("life", "Tram 28 - Wikipedia", "https://en.wikipedia.org/wiki/Lisbon_tramway_network"),
        spaces_demo_tab("life", "Lisboa", "https://www.visitlisboa.com/"),
      ],
    },
    proto::NamedSessionSnapshot::{
      id: "s-grid",
      name: "CSS grid research",
      created_secs: spaces_demo_now - 4L * 86400L,
      active_space_id: "lab",
      spaces: [
        proto::SessionSpaceItem::{ id: "lab", name: "Lab", accent: "#8B5CF6" },
        proto::SessionSpaceItem::{ id: "work", name: "Work", accent: "#2563EB" },
      ],
      folders: [],
      tabs: [
        spaces_demo_tab("lab", "CSS Grid Layout Module Level 3", "https://drafts.csswg.org/css-grid-3/"),
        spaces_demo_tab("lab", "grid - CSS | MDN", "https://developer.mozilla.org/en-US/docs/Web/CSS/grid"),
