///| `spaces` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=spaces`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `spaces-<scene>-<light|dark>[-480].png`, via `render_scene`.

import "film"
import "lg"
import "proto"
import "shell_ui"
import "signals"
import "ui"
import "view"

let spaces_demo_now : Int64 = 1795661407L

fn spaces_demo_tab(space_id : String, title : String, url : String) -> proto::SessionTabItem {
  proto::SessionTabItem::{ space_id, title, url, pinned: false, favorite: false, folder_id: "" }
}

