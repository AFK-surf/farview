///| `history` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=history`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `history-<scene>-<light|dark>[-480].png`, via `render_scene`.

import "film"
import "lg"
import "proto"

let HS_NOW : Int64 = 1795700000L

fn hs_cookie(
  name : String,
  domain : String,
  secure : Bool,
  http_only : Bool,
  same_site : String,
  expires : String,
  path~ : String = "/",
  partitioned~ : Bool = false,
) -> proto::SiteCookieRow {
  proto::SiteCookieRow::{
    name,
    domain,
    path,
    value_preview: "",
    secure,
    http_only,
    same_site,
    partitioned,
    expires_label: expires,
    is_session: expires == "",
  }
}

fn hs_cookies() -> Array[proto::SiteCookieRow] {
  [
    hs_cookie("_gh_sess", "github.com", true, true, "Lax", ""),
    hs_cookie("user_session", "github.com", true, true, "Lax", "Dec 10, 2026"),
    hs_cookie("__Host-user_session_same_site", "github.com", true, true, "Strict", "Dec 10, 2026"),
    hs_cookie("tz", "github.com", true, false, "Lax", ""),
    hs_cookie("logged_in", ".github.com", true, true, "Lax", "Nov 26, 2027"),
    hs_cookie("_octo", ".github.com", true, false, "Lax", "Nov 26, 2027"),
    hs_cookie("color_mode", ".github.com", true, false, "Lax", ""),
    hs_cookie("_device_id", "github.com", false, false, "Lax", "Nov 26, 2027"),
    hs_cookie("saved_filters", "github.com", true, false, "Lax", "Dec 26, 2026", path="/notifications"),
    hs_cookie("__Host-embed", "github.com", true, true, "None", "Dec 3, 2026", partitioned=true),
  ]
}

fn hs_cookies_props(
  field : ui::Field,
  cookies~ : Array[proto::SiteCookieRow] = hs_cookies(),
  host~ : String = "github.com",
  back~ : Bool = true,
) -> shell_ui::CookiesInspectorProps {
  shell_ui::CookiesInspectorProps::{
    open: fn() { true },
    owner_pane: fn() { 0 },
    site_host: fn() { host },
    space_id: fn() { "Work" },
    cookies: fn() { cookies },
    filter_field: field,
    show_back_to_site_info: fn() { back },
    on_back_to_site_info: fn() { () },
    on_delete_cookie: fn(_p, _h, _n, _d, _pa) { () },
    on_clear_site: fn(_p, _h) { () },
    on_close: fn() { () },
    return_focus: None,
  }
}

fn hs_visit(url : String, title : String, host : String, ago_secs : Int64) -> proto::HistoryItemSummary {
  proto::HistoryItemSummary::{ url, title, host, visit_count: 1, last_visit_secs: HS_NOW - ago_secs }
}

fn hs_history() -> Array[proto::HistoryItemSummary] {
  [
    hs_visit("https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout", "CSS grid layout - CSS | MDN", "developer.mozilla.org", 240L),
    hs_visit("https://news.ycombinator.com/", "Hacker News", "news.ycombinator.com", 1500L),
    hs_visit("https://en.wikipedia.org/wiki/Typeface", "Typeface - Wikipedia", "en.wikipedia.org", 4200L),
    hs_visit("https://github.com/rust-lang/rust/pulls", "Pull requests · rust-lang/rust", "github.com", 9800L),
    hs_visit("https://caniuse.com/css-subgrid", "CSS Subgrid | Can I use...", "caniuse.com", 95000L),
    hs_visit("https://web.dev/articles/inp", "Interaction to Next Paint (INP) | web.dev", "web.dev", 101000L),
    hs_visit("https://www.w3.org/TR/css-contain-3/", "CSS Conditional Rules Module Level 5", "w3.org", 300000L),
    hs_visit("https://webkit.org/blog/", "Blog | WebKit", "webkit.org", 420000L),
  ]
}

fn hs_history_props(
  field : ui::Field,
  items~ : Array[proto::HistoryItemSummary] = hs_history(),
) -> shell_ui::HistoryDrawerProps {
  let total = if items.length() == 0 { 0 } else { 214 }
  shell_ui::HistoryDrawerProps::{
    open: fn() { true },
    items: fn() { items },
    total_count: fn() { total },
    now_secs: fn() { HS_NOW },
    search_field: field,
    on_query_change: fn(_q) { () },
    on_open_url: fn(_u) { () },
    on_delete_url: fn(_u) { () },
    on_clear_range: fn(_r) { () },
    on_close: fn() { () },
  }
}

fn hs_bookmark(id : String, title : String, url : String, folder : String) -> proto::BookmarkEntry {
  proto::BookmarkEntry::{ id, title, url, folder, created_ms: 0L }
}

fn hs_bookmarks() -> proto::BookmarksSnapshot {
  proto::BookmarksSnapshot::{
    items: [
      hs_bookmark("b1", "CSS grid layout - CSS | MDN", "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout", "Reference"),
      hs_bookmark("b2", "Can I use... Support tables for HTML5, CSS3, etc", "https://caniuse.com/", "Reference"),
      hs_bookmark("b3", "HTML Standard", "https://html.spec.whatwg.org/", "Reference"),
      hs_bookmark("b4", "Hacker News", "https://news.ycombinator.com/", "Reading"),
      hs_bookmark("b5", "Typeface - Wikipedia", "https://en.wikipedia.org/wiki/Typeface", "Reading"),
      hs_bookmark("b6", "rust-lang/rust", "https://github.com/rust-lang/rust", ""),
    ],
  }
}

fn hs_bookmarks_props(
  field : ui::Field,
  snap : proto::BookmarksSnapshot,
  current~ : String = "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout",
) -> shell_ui::BookmarksDrawerProps {
  shell_ui::BookmarksDrawerProps::{
    open: fn() { true },
    snapshot: fn() { snap },
    current_url: fn() { current },
    search_field: field,
    on_toggle_current: fn() { () },
    on_open_url: fn(_u) { () },
    on_delete_bookmark: fn(_id) { () },
    on_close: fn() { () },
  }
}

///| `render_scene` with the pointer moved over the control named `hover_label` before the capture (the drive script's
///| `hover`), for states that exist only under the pointer.
fn hs_render_hovered(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  build : (view::View, shell_ui::ShellController) -> Unit,
  hover_label : String,
  dark~ : Bool = false,
) -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      build(root, ctrl)
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script="wait 500\nhover " + hover_label + "\nwait 300",
    at=200.0,
    theme=lg::ui_theme,
    async_write=true,
  )
  io_println(w_world, if ok { "shell_shots: wrote " + path } else { "shell_shots: FAILED " + path })
  ok
}

///| Renders one scene light and dark at 1280x800, plus 480x800 when `narrow`; with `hover`, the pointer rests on the
///| control of that name.
fn hs_both(
  w : World,
  out_dir : String,
  scene : String,
  build : (view::View, shell_ui::ShellController) -> Unit,
  narrow~ : Bool = false,
  hover~ : String = "",
) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    let sizes : Array[(Double, String)] = if narrow { [(1280.0, ""), (480.0, "-480")] } else { [(1280.0, "")] }
    for sz in sizes {
      let name = "history-" + scene + "-" + mode + sz.1 + ".png"
      ok = (if hover == "" {
        render_scene(w, out_dir, name, sz.0, 800.0, build, dark=dark)
      } else {
        hs_render_hovered(w, out_dir, name, sz.0, 800.0, build, hover, dark=dark)
      }) && ok
    }
  }
  ok
}

pub fn render_history_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = hs_both(
    w,
    out_dir,
    "cookies",
    fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
      shell_ui::build_cookies_inspector_modal(root, hs_cookies_props(ui::Field::new()))
    },
    narrow=true,
  ) && ok
  ok = hs_both(w, out_dir, "cookies-filter-empty", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    let f = ui::Field::new()
    f.set("csrf")
    shell_ui::build_cookies_inspector_modal(root, hs_cookies_props(f))
  }) && ok
  ok = hs_both(
    w,
    out_dir,
    "history",
    fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
      shell_ui::build_history_drawer_panel(root, hs_history_props(ui::Field::new()))
    },
    narrow=true,
  ) && ok
  ok = hs_both(w, out_dir, "history-search-empty", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    let f = ui::Field::new()
    f.set("figma")
    shell_ui::build_history_drawer_panel(root, hs_history_props(f))
  }) && ok
  ok = hs_both(
    w,
    out_dir,
    "bookmarks",
    fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
      shell_ui::build_bookmarks_drawer_panel(root, hs_bookmarks_props(ui::Field::new(), hs_bookmarks()))
    },
    narrow=true,
  ) && ok
  ok = hs_both(w, out_dir, "bookmarks-empty", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    shell_ui::build_bookmarks_drawer_panel(root, hs_bookmarks_props(ui::Field::new(), proto::BookmarksSnapshot::{ items: [] }))
  }) && ok
  // A site that set nothing, opened straight from the address bar (no Site Info to go back to).
  ok = hs_both(w, out_dir, "cookies-empty", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    shell_ui::build_cookies_inspector_modal(root, hs_cookies_props(ui::Field::new(), cookies=[], host="en.wikipedia.org", back=false))
  }) && ok
  ok = hs_both(
    w,
    out_dir,
    "cookies-row-hover",
    fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
      shell_ui::build_cookies_inspector_modal(root, hs_cookies_props(ui::Field::new()))
    },
    hover="Cookie user_session",
  ) && ok
  ok = hs_both(w, out_dir, "history-empty", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    shell_ui::build_history_drawer_panel(root, hs_history_props(ui::Field::new(), items=[]))
  }) && ok
  ok = hs_both(
    w,
    out_dir,
    "history-row-hover",
    fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
      shell_ui::build_history_drawer_panel(root, hs_history_props(ui::Field::new()))
    },
    hover="Open Hacker News",
  ) && ok
  ok = hs_both(w, out_dir, "bookmarks-search-empty", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    let f = ui::Field::new()
    f.set("figma")
    shell_ui::build_bookmarks_drawer_panel(root, hs_bookmarks_props(f, hs_bookmarks()))
  }) && ok
  // A new tab: nothing to bookmark, so the toggle is off and disabled.
  ok = hs_both(w, out_dir, "bookmarks-no-url", fn(root : view::View, _c : shell_ui::ShellController) -> Unit {
    shell_ui::build_bookmarks_drawer_panel(root, hs_bookmarks_props(ui::Field::new(), hs_bookmarks(), current=""))
  }) && ok
  ok
}
