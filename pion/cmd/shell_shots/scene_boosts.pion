///| `boosts` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=boosts`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `boosts-<scene>-<light|dark>[-480].png`, via `render_scene`.

fn boosts_scene(
  w : World,
  out_dir : String,
  name : String,
  build : (view::View, Bool) -> Unit,
  narrow~ : Bool = false,
) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "boosts-" + name + "-" + mode + ".png", 1280.0, 800.0, fn(root, _c) { build(root, dark) }, dark=dark) &&
    ok
    if narrow {
      ok = render_scene(
        w,
        out_dir,
        "boosts-" + name + "-" + mode + "-480.png",
        480.0,
        800.0,
        fn(root, _c) { build(root, dark) },
        dark=dark,
      ) &&
      ok
    }
  }
  ok
}

pub fn render_boosts_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // Site Boosts: each section, then All Boosts.
  ok = boosts_scene(w, out_dir, "colors", fn(root, _d) { shell_ui::build_demo_site_boosts(root, section=0) }, narrow=true) && ok
  ok = boosts_scene(w, out_dir, "fonts", fn(root, _d) { shell_ui::build_demo_site_boosts(root, section=1) }) && ok
  ok = boosts_scene(w, out_dir, "zap", fn(root, _d) { shell_ui::build_demo_site_boosts(root, section=2, zap=true) }, narrow=true) && ok
  ok = boosts_scene(w, out_dir, "code", fn(root, _d) { shell_ui::build_demo_site_boosts(root, section=3) }) && ok
  ok = boosts_scene(w, out_dir, "sites", fn(root, _d) { shell_ui::build_demo_site_boosts(root, all=true) }, narrow=true) && ok
  // Reader Mode over the page card: light paper in the light shell, night paper in the dark one, and sepia.
  ok = boosts_scene(w, out_dir, "reader", fn(root, d) { shell_ui::build_demo_reader_mode(root, theme=if d { "night" } else { "light" }) }, narrow=true) &&
  ok
  ok = render_scene(
    w,
    out_dir,
    "boosts-reader-sepia-light.png",
    1280.0,
    800.0,
    fn(root, _c) { shell_ui::build_demo_reader_mode(root, theme="sepia", font="sans") },
  ) &&
  ok
  ok
}
