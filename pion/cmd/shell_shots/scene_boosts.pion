///| `boosts` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=boosts`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `boosts-<scene>-<light|dark>[-480].png`, via `render_scene`.

fn boosts_scene(
  w : World,
  out_dir : String,
  name : String,
  build : (view::View, Bool) -> Unit,
  narrow~ : Bool = false,
) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "boosts-" + name + "-" + mode + ".png", 1280.0, 800.0, fn(root, _c) { build(root, dark) }, dark=dark) &&
    ok
    if narrow {
      ok = render_scene(
        w,
        out_dir,
        "boosts-" + name + "-" + mode + "-480.png",
        480.0,
        800.0,
        fn(root, _c) { build(root, dark) },
        dark=dark,
      ) &&
      ok
    }
  }
  ok
}

pub fn render_boosts_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // The Boost editor for the demo shell's page (notes.example.com): its tint and second color on the canvas.
  ok = boosts_scene(w, out_dir, "editor", fn(root, _d) { shell_ui::build_demo_site_boosts(root) }, narrow=true) && ok
  // No colors yet: the gray handles in the neutral frame, as Arc opens a new boost.
  ok = boosts_scene(w, out_dir, "editor-plain", fn(root, _d) { shell_ui::build_demo_site_boosts(root, plain=true) }) && ok
  // The typeface grid with a typeface chosen, larger text and uppercase.
  ok = boosts_scene(w, out_dir, "fonts", fn(root, _d) { shell_ui::build_demo_site_boosts(root, font="serif", text_case="upper") }) && ok
  // The fine controls under the sliders button.
  ok = boosts_scene(w, out_dir, "fine", fn(root, _d) { shell_ui::build_demo_site_boosts(root, fine=true) }) && ok
  // Zap on: the row filled with the count, what it hid listed under it; and Zap just turned on.
  ok = boosts_scene(w, out_dir, "zap", fn(root, _d) { shell_ui::build_demo_site_boosts(root, zap=true) }, narrow=true) && ok
  ok = boosts_scene(w, out_dir, "zap-empty", fn(root, _d) { shell_ui::build_demo_site_boosts(root, zap=true, hidden=false) }) && ok
  // Code, All Boosts (and empty), a page that is not on http(s).
  ok = boosts_scene(w, out_dir, "code", fn(root, _d) { shell_ui::build_demo_site_boosts(root, section=3) }, narrow=true) && ok
  ok = boosts_scene(w, out_dir, "sites", fn(root, _d) { shell_ui::build_demo_site_boosts(root, all=true) }, narrow=true) && ok
  ok = boosts_scene(w, out_dir, "sites-empty", fn(root, _d) { shell_ui::build_demo_site_boosts(root, all=true, no_sites=true) }) && ok
  ok = boosts_scene(w, out_dir, "no-origin", fn(root, _d) { shell_ui::build_demo_site_boosts(root, origin="") }) && ok
  // Reset asks once more in place, its danger caption where the boost's name was.
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = frame_scripted(
      w,
      out_dir,
      "boosts-reset-confirm-" + mode + ".png",
      1280.0,
      fn(root, _c) { shell_ui::build_demo_site_boosts(root) },
      "wait 300\npress Reset Site Boost\nwait 300",
      dark~,
    ) &&
    ok
  }
  // Reader Mode over the page card: light paper in the light shell, night paper in the dark one; sepia in both.
  ok = boosts_scene(w, out_dir, "reader", fn(root, d) { shell_ui::build_demo_reader_mode(root, theme=if d { "night" } else { "light" }) }, narrow=true) &&
  ok
  ok = boosts_scene(w, out_dir, "reader-sepia", fn(root, _d) { shell_ui::build_demo_reader_mode(root, theme="sepia", font="sans") }) && ok
  ok
}
