///| `motion` scenes (`FV_SHOTS_ONLY=motion`): every shell motion as frames at fixed times after the person's act, so
///| the curve can be read frame by frame. The shell is built, then at MOTION_T0 the act happens (open, close, switch);
///| `motion-<item>-<ms>.png` is the window `ms` after it. Light, 1280x800 @1x.

import "film"
import "lg"
import "shell_ui"
import "signals"
import "ui"
import "view"

///| When the act happens, after the shell is built (so it is a person's act, not restored state).
let MOTION_T0 : Double = 100.0

fn motion_frames(
  w : World,
  out_dir : String,
  item : String,
  times : Array[Double],
  build : (view::View, shell_ui::ShellController, (() -> Unit) -> Unit) -> Unit,
  width~ : Double = 1280.0,
) -> Bool {
  let mut ok = true
  for ms in times {
    let path = out_dir + "/motion-" + item + "-" + ms.to_int().to_string() + ".png"
    let shot = film::picture(
      fn(root : view::View) -> Unit {
        let ctrl = shell_ui::make_demo_controller(dark=false)
        let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
          shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=shell_ui::DemoBackdrop::EditorialLight)
        })
        shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
        let at_t0 = fn(f : () -> Unit) -> Unit {
          let _ = root.at_moment(root.cause_at() + MOTION_T0, f)
        }
        build(root, ctrl, at_t0)
      },
      path=path,
      w=width,
      h=800.0,
      scale=1.0,
      window_corner=20.0,
      at=MOTION_T0 + ms,
      theme=lg::ui_theme,
    )
    if shot {
      io_println(w, "shell_shots: wrote " + path)
    } else {
      io_println(w, "shell_shots: FAILED " + path)
    }
    ok = shot && ok
  }
  ok
}

fn motion_shortcuts(root : view::View, open : signals::Signal[Bool]) -> Unit {
  shell_ui::build_shortcuts_modal(
    root,
    shell_ui::ShortcutsModalProps::{
      open: fn() { open.get() },
      groups: shell_ui::default_macos_shortcut_groups,
      on_close: fn() { open.set(false) },
    },
  )
}

pub fn render_motion_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  let enter = [0.0, 40.0, 80.0, 120.0, 200.0, 400.0]
  let quick = [0.0, 20.0, 40.0, 60.0, 100.0, 120.0]
  let exits = [0.0, 20.0, 40.0, 60.0, 100.0]

  // Modal dialog (Keyboard Shortcuts): fade + 0.98 -> 1, centered, 200ms strong ease-out.
  ok = motion_frames(w, out_dir, "dialog", enter, fn(root, _ctrl, at_t0) {
    let open = signals::signal(false)
    motion_shortcuts(root, open)
    at_t0(fn() { open.set(true) })
  }) && ok
  // The same dialog closed by the person: 100ms, eased out.
  ok = motion_frames(w, out_dir, "dialog-out", exits, fn(root, _ctrl, at_t0) {
    let open = signals::signal(true)
    motion_shortcuts(root, open)
    at_t0(fn() { view::transition(fn() { open.set(false) }) })
  }) && ok
  // Page-load line (2pt over the page card's top edge, Space accent): fades in over MO_HOVER_MS and creeps to
  // MO_LOAD_CREEP of the width over MO_LOAD_CREEP_MS; at the end it runs to the full width while it fades out.
  ok = motion_frames(w, out_dir, "load", [0.0, 60.0, 120.0, 600.0, 2400.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.loading.set(true) })
  }) && ok
  ok = motion_frames(w, out_dir, "load-finish", [2400.0, 2440.0, 2480.0, 2520.0, 2600.0], fn(root, ctrl, at_t0) {
    at_t0(fn() { ctrl.loading.set(true) })
    let _ = root.at_moment(root.cause_at() + MOTION_T0 + 2400.0, fn() { ctrl.loading.set(false) })
  }) && ok
  // A load that starts while the last line fades out (a redirect 60ms after the finish): the line turns back from
  // where it is, never jumping to 0 width.
  ok = motion_frames(w, out_dir, "load-redirect", [2440.0, 2460.0, 2500.0, 2600.0, 3000.0], fn(root, ctrl, at_t0) {
    at_t0(fn() { ctrl.loading.set(true) })
    let _ = root.at_moment(root.cause_at() + MOTION_T0 + 2400.0, fn() { ctrl.loading.set(false) })
    let _ = root.at_moment(root.cause_at() + MOTION_T0 + 2460.0, fn() { ctrl.loading.set(true) })
  }) && ok
  // Anchored popover (Zoom, under the site button): 0.97 -> 1 from its trigger, 140ms.
  ok = motion_frames(w, out_dir, "popover", [0.0, 40.0, 80.0, 140.0, 200.0], fn(root, _ctrl, at_t0) {
    let open = signals::signal(false)
    shell_ui::build_zoom_popover(
      root,
      shell_ui::ZoomPopoverProps::{
        open: fn() { open.get() },
        host_label: fn() { "developer.mozilla.org" },
        zoom_percent: fn() { 110 },
        can_zoom_out: fn() { true },
        can_zoom_in: fn() { true },
        trigger_anchor: fn() { Some(shell_ui::AnchorRect::{ x: 12.0, y: 52.0, w: 24.0, h: 24.0 }) },
        fallback_capsule: fn() { shell_ui::AnchorRect::{ x: 8.0, y: 48.0, w: 232.0, h: 32.0 } },
        on_zoom_out: fn() { () },
        on_zoom_in: fn() { () },
        on_reset: fn() { () },
        on_save_default: fn() { () },
        on_close: fn() { open.set(false) },
      },
    )
    at_t0(fn() { open.set(true) })
  }) && ok
  // Capture Completed sheet: grows out of its bottom-right corner, 140ms.
  ok = motion_frames(w, out_dir, "capture", [0.0, 40.0, 80.0, 140.0, 200.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() {
      let p = ctrl.passive.untracked()
      ctrl.passive.set(shell_ui::PassiveState::{
        ..p,
        capture_sheet_open: true,
        capture_sheet: shell_ui::demo_capture_meta(),
        capture_sheet_revealable: true,
      })
    })
  }) && ok
  // Tab hover preview (first card only): fade + 0.98 -> 1 from the hovered tab's side, 120ms.
  ok = motion_frames(w, out_dir, "hover-preview", [0.0, 40.0, 80.0, 120.0, 200.0], fn(root, _ctrl, at_t0) {
    let open = signals::signal(false)
    shell_ui::build_tab_hover_preview_card(
      root,
      shell_ui::TabHoverPreviewProps::{
        open: fn() { open.get() },
        snapshot: fn() {
          Some(shell_ui::TabHoverPreviewSnapshot::{
            tab_id: "t3",
            title: "Groove Salad — SomaFM",
            clean_host: "soma.fm",
            space_name: "Work",
            playing: true,
            muted: false,
            in_split: false,
            in_reader: false,
          })
        },
        anchor_x: fn() { 244.0 },
        anchor_y: fn() { 318.0 },
      },
    )
    at_t0(fn() { open.set(true) })
  }) && ok
  // Peek over the page: card and scrim fade in, card 0.97 -> 1 (no layout), 200ms.
  ok = motion_frames(w, out_dir, "peek", enter, fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::OpenPeek("https://developer.mozilla.org/en-US/docs/Web/CSS/grid")) })
  }) && ok
  // Address palette (Cmd+L): opacity only, 100ms; no lift.
  ok = motion_frames(w, out_dir, "palette", quick, fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::OmniboxFocus) })
  }) && ok
  // Tab switch (Cmd+2): the selected wash and lift cross-fade over 100ms on ease; the page swaps at once.
  ok = motion_frames(w, out_dir, "tab-switch", quick, fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::SelectTab("t2")) })
  }) && ok
  // Toast (Copied Capture Path): fade + 0.97 -> 1 about its top edge, 140ms; out over 100ms when it runs out.
  let toast_on = fn(ctrl : shell_ui::ShellController, on : Bool) -> Unit {
    let p = ctrl.passive.untracked()
    ctrl.passive.set(shell_ui::PassiveState::{
      ..p,
      toast_visible: on,
      toast_title: "Copied Link",
      toast_subtitle: "",
      toast_kind: shell_ui::ToastKind::Success,
    })
  }
  ok = motion_frames(w, out_dir, "toast", [0.0, 20.0, 40.0, 80.0, 140.0, 200.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() { toast_on(ctrl, true) })
  }) && ok
  ok = motion_frames(w, out_dir, "toast-out", exits, fn(root, ctrl, at_t0) {
    toast_on(ctrl, true)
    // (the app's expiry timer tells it as a transition within the window)
    at_t0(fn() { view::transition(fn() { toast_on(ctrl, false) }, within=root) })
  }) && ok
  // More menu: the lg menu panel grows out of the trigger's corner, 140ms; items readable from the first frame
  // (was lg's morph: content after 170ms, done near 330ms).
  ok = motion_frames(w, out_dir, "more-menu", [0.0, 20.0, 40.0, 80.0, 140.0, 200.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::OpenMoreMenu) })
  }) && ok
  ok = motion_frames(w, out_dir, "more-menu-out", exits, fn(_root, ctrl, at_t0) {
    ctrl.dispatch(shell_ui::ShellIntent::OpenMoreMenu)
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::CloseMoreMenu) })
  }) && ok
  // Narrow window sidebar drawer (Cmd+S at 480pt): fade + 12pt slide, 100ms; was a 280ms spring.
  ok = motion_frames(w, out_dir, "narrow-drawer", quick, width=480.0, fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleNarrowSidebar) })
  }) && ok
  ok = motion_frames(w, out_dir, "narrow-drawer-out", exits, width=480.0, fn(_root, ctrl, at_t0) {
    ctrl.dispatch(shell_ui::ShellIntent::ToggleNarrowSidebar)
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleNarrowSidebar) })
  }) && ok
  // Space switch (Work -> Life): only the frame tint recolors, 100ms on ease; the sidebar content swaps at once.
  ok = motion_frames(w, out_dir, "space-tint", quick, fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::SelectSpace("personal")) })
  }) && ok
  // Split View opened from one pane: the new pane fades in over 180ms (opacity only; sizes at once).
  ok = motion_frames(w, out_dir, "split", [0.0, 40.0, 80.0, 120.0, 180.0, 300.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleSplitView) })
  }) && ok
  // A folder closed and opened by the person: its children close / open their way down the column, the rows below
  // follow, the chevron turns a quarter.
  ok = motion_frames(w, out_dir, "folder-close", [0.0, 40.0, 80.0, 120.0, 200.0, 300.0, 400.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() { view::transition(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleFolder("research")) }) })
  }) && ok
  ok = motion_frames(w, out_dir, "folder-open", [0.0, 40.0, 80.0, 120.0, 200.0, 300.0], fn(_root, ctrl, at_t0) {
    ctrl.dispatch(shell_ui::ShellIntent::ToggleFolder("research"))
    at_t0(fn() { view::transition(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleFolder("research")) }) })
  }) && ok
  // A tab closed by its X: the row fades out (80ms), then closes its way, the rows below following.
  ok = motion_frames(w, out_dir, "tab-close", [0.0, 40.0, 80.0, 120.0, 160.0, 200.0, 300.0, 400.0], fn(_root, _ctrl, at_t0) {
    at_t0(fn() { shell_ui::shell_close_tab_by_pointer("t3") })
  }) && ok
  // The docked sidebar hidden (Cmd+S): laid out once, the page drawn sliding from where it stood over 100ms, the
  // sidebar fading under it, the compact toolbar in once the sidebar's own is gone.
  ok = motion_frames(w, out_dir, "sidebar-hide", [0.0, 20.0, 40.0, 60.0, 100.0, 150.0, 250.0], fn(_root, ctrl, at_t0) {
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleSidebar) })
  }) && ok
  ok = motion_frames(w, out_dir, "sidebar-show", quick, fn(_root, ctrl, at_t0) {
    ctrl.dispatch(shell_ui::ShellIntent::ToggleSidebar)
    at_t0(fn() { ctrl.dispatch(shell_ui::ShellIntent::ToggleSidebar) })
  }) && ok
  // Peek closed by the person (its Close, the scrim, Escape): fades and shrinks back over 100ms with its scrim.
  ok = motion_frames(w, out_dir, "peek-close", exits, fn(_root, ctrl, at_t0) {
    ctrl.dispatch(shell_ui::ShellIntent::OpenPeek("https://developer.mozilla.org/en-US/docs/Web/CSS/grid"))
    at_t0(fn() { view::transition(fn() { ctrl.dispatch(shell_ui::ShellIntent::CloseSecondaryPane) }) })
  }) && ok
  ok
}
