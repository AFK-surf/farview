///| `settings` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=settings`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `settings-<scene>-<light|dark>[-480].png`, via `render_scene`.
///| The Start page lives inside the page card, so its scenes mount it in the primary pane (`render_startpage`).

import "film"
import "lg"
import "proto"
import "shell_ui"
import "signals"
import "ui"
import "view"

///| Mounts the Settings dialog on `root` at category `tab`, with the filter field holding `filter`.
fn mount_settings(root : view::View, ctrl : shell_ui::ShellController, tab : Int, filter : String, theme~ : String = "") -> Unit {
  let open = signals::signal(true)
  let active_tab = signals::signal(tab)
  let settings = signals::signal_ref(proto::BrowserSettings::{
    ..proto::BrowserSettings::default(),
    search_engine: "duckduckgo",
    chrome_theme: if theme != "" { theme } else if ctrl.dark.untracked() { "dark" } else { "light" },
    https_only: true,
  })
  let filter_field = ui::Field::new()
  if filter != "" {
    filter_field.set(filter)
  }
  shell_ui::build_settings_panel(
    root,
    shell_ui::SettingsPanelProps::{
      open: fn() { open.get() },
      dark: fn() { ctrl.dark.get() },
      active_tab,
      settings: fn() { settings.get() },
      clear_bookmarks: signals::signal(false),
      clear_history: signals::signal(true),
      clear_downloads: signals::signal(true),
      clear_boosts: signals::signal(false),
      filter_field: Some(filter_field),
      on_save_settings: fn(next_s, _msg) { settings.set(next_s) },
      on_step_zoom: fn(_d) { () },
      on_clear_browsing_data: fn(_sel) { () },
      on_close: fn() { open.set(false) },
    },
  )
}

fn settings_scene(w : World, out_dir : String, name : String, tab : Int, filter~ : String = "", narrow~ : Bool = false, theme~ : String = "") -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let suffix = (if dark { "dark" } else { "light" }) + (if narrow { "-480" } else { "" })
    ok = render_scene(
      w,
      out_dir,
      "settings-" + name + "-" + suffix + ".png",
      if narrow { 480.0 } else { 1280.0 },
      800.0,
      fn(root, ctrl) { mount_settings(root, ctrl, tab, filter, theme~) },
      dark=dark,
    ) && ok
  }
  ok
}

fn demo_tile(title : String, url : String, host : String, bookmark : Bool, visits : Int) -> proto::StartPageTile {
  proto::StartPageTile::{
    url,
    title,
    host,
    // The letter the app sends (`proto::build_start_page_tiles`); the panel draws its own from the title.
    monogram: proto::omnibox_initial_letter(url, title),
    accent: shell_ui::shell_site_color(host),
    is_bookmark: bookmark,
    visit_count: visits,
  }
}

///| Bookmarks first, then the most visited history, as `proto::build_start_page_tiles` orders them.
fn demo_start_tiles() -> Array[proto::StartPageTile] {
  [
    demo_tile("GitHub", "https://github.com", "github.com", true, 0),
    demo_tile("MDN Web Docs", "https://developer.mozilla.org", "developer.mozilla.org", true, 0),
    demo_tile("Wikipedia", "https://en.wikipedia.org", "en.wikipedia.org", true, 0),
    demo_tile("Hacker News", "https://news.ycombinator.com", "news.ycombinator.com", true, 0),
    demo_tile("Can I use", "https://caniuse.com", "caniuse.com", true, 0),
    demo_tile("CSS Grid Layout Module Level 3", "https://drafts.csswg.org/css-grid-3/", "drafts.csswg.org", false, 14),
    demo_tile("WebKit Blog", "https://webkit.org/blog/", "webkit.org", false, 9),
    demo_tile("HTML Standard", "https://html.spec.whatwg.org/multipage/", "html.spec.whatwg.org", false, 6),
  ]
}

fn render_startpage(w_world : World, out_dir : String, filename : String, w : Double, dark : Bool, empty : Bool, script~ : String = "") -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      // The Start page belongs to a New Tab: open one so the sidebar selection and address field agree with it.
      ctrl.dispatch(shell_ui::ShellIntent::NewTab)
      // A New Tab has no address to show yet: the capsule shows its placeholder.
      ctrl.url.set("")
      ctrl.omnibox_field.set("")
      let field = ui::Field::new()
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
        if id is shell_ui::PaneId::Primary {
          shell_ui::build_startpage_panel(
            p,
            shell_ui::StartPageProps::{
              visible: fn() { true },
              dark: fn() { ctrl.dark.get() },
              space_name: fn() { "Work" },
              space_accent: fn() { 0x007AFFFFL },
              search_engine_label: fn() { "DuckDuckGo" },
              tiles: fn() { if empty { [] } else { demo_start_tiles() } },
              field,
              on_show: fn() { () },
              on_submit: fn(_q) { () },
              on_open_tile: fn(_u) { () },
              on_remove_tile: fn(_t) { () },
              quick_actions: [
                shell_ui::StartPageQuickAction::{ label: "Bookmarks", shortcut: "Ctrl+Shift+B", icon_name: shell_ui::ICON_BOOKMARK, on_press: fn() { () } },
                shell_ui::StartPageQuickAction::{ label: "History", shortcut: "Ctrl+Y", icon_name: shell_ui::ICON_CLOCK, on_press: fn() { () } },
                shell_ui::StartPageQuickAction::{ label: "Settings", shortcut: "Ctrl+,", icon_name: shell_ui::ICON_SETTINGS, on_press: fn() { () } },
                shell_ui::StartPageQuickAction::{ label: "Reader", shortcut: "Ctrl+Alt+R", icon_name: shell_ui::ICON_READER, on_press: fn() { () } },
                shell_ui::StartPageQuickAction::{ label: "DevTools", shortcut: "Ctrl+Shift+I", icon_name: shell_ui::ICON_TERMINAL, on_press: fn() { () } },
              ],
            },
          )
        }
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    path=path,
    w=w,
    h=800.0,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script=script,
    at=500.0,
    theme=lg::ui_theme,
  )
  if ok {
    io_println(w_world, "shell_shots: wrote " + path)
  } else {
    io_println(w_world, "shell_shots: FAILED " + path)
  }
  ok
}

pub fn render_settings_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = settings_scene(w, out_dir, "general", shell_ui::SETTINGS_TAB_GENERAL) && ok
  ok = settings_scene(w, out_dir, "appearance", shell_ui::SETTINGS_TAB_APPEARANCE) && ok
  // Auto (the default): follows the system's appearance.
  ok = settings_scene(w, out_dir, "appearance-auto", shell_ui::SETTINGS_TAB_APPEARANCE, theme="system") && ok
  ok = settings_scene(w, out_dir, "tabs", shell_ui::SETTINGS_TAB_TABS) && ok
  ok = settings_scene(w, out_dir, "search", shell_ui::SETTINGS_TAB_SEARCH) && ok
  ok = settings_scene(w, out_dir, "privacy", shell_ui::SETTINGS_TAB_PRIVACY) && ok
  ok = settings_scene(w, out_dir, "downloads", shell_ui::SETTINGS_TAB_DOWNLOADS) && ok
  ok = settings_scene(w, out_dir, "shortcuts", shell_ui::SETTINGS_TAB_SHORTCUTS) && ok
  ok = settings_scene(w, out_dir, "about", shell_ui::SETTINGS_TAB_ABOUT) && ok
  ok = settings_scene(w, out_dir, "filter", shell_ui::SETTINGS_TAB_GENERAL, filter="cookies") && ok
  ok = settings_scene(w, out_dir, "general", shell_ui::SETTINGS_TAB_GENERAL, narrow=true) && ok
  ok = settings_scene(w, out_dir, "privacy", shell_ui::SETTINGS_TAB_PRIVACY, narrow=true) && ok
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = render_startpage(w, out_dir, "settings-startpage-" + mode + ".png", 1280.0, dark, false) && ok
    ok = render_startpage(w, out_dir, "settings-startpage-" + mode + "-480.png", 480.0, dark, false) && ok
    ok = render_startpage(w, out_dir, "settings-startpage-empty-" + mode + ".png", 1280.0, dark, true) && ok
    // The pointer over a Favorite and over a Frequently visited row: each shows its ×.
    ok = render_startpage(w, out_dir, "settings-startpage-hover-fav-" + mode + ".png", 1280.0, dark, false, script="wait 100\nhover MDN Web Docs\nwait 300") && ok
    ok = render_startpage(w, out_dir, "settings-startpage-hover-recent-" + mode + ".png", 1280.0, dark, false, script="wait 100\nhover HTML Standard\nwait 300") && ok
    // The keyboard on a Favorite (Tab from the search field): its × shows too, so Tab reaches it.
    ok = render_startpage(
      w,
      out_dir,
      "settings-startpage-focus-fav-" + mode + ".png",
      1280.0,
      dark,
      false,
      script="wait 100\ntap Start Page Search\nwait 50\nkey tab\nwait 300",
    ) && ok
    // Tab once more: the focus is on the × itself, which stays.
    ok = render_startpage(
      w,
      out_dir,
      "settings-startpage-focus-x-" + mode + ".png",
      1280.0,
      dark,
      false,
      script="wait 100\ntap Start Page Search\nwait 50\nkey tab\nwait 50\nkey tab\nwait 300",
    ) && ok
  }
  ok
}
