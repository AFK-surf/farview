///| `sidebar` scenes for the offscreen gallery (`FV_SHOTS_ONLY=sidebar`): the sidebar's feel states, caught in the
///| middle of what they show: a tab dragged to reorder (the drop line), a tab dragged onto Favorites (the lifted row
///| over the grid, the grid's wash, the line between tiles), the edge handle hovered and dragged, a bulk close's
///| toast with Undo, a loading tab with Stop, a page's download in the sidebar foot (running and failed), the open
///| favorite raised, and an unloaded pinned tab. Named `sidebar-<scene>-<light|dark>.png`, at 1280x800.

import "film"
import "lg"
import "shell_ui"
import "view"

///| The demo shell, `setup` run on its controller before the frame is built, `script` then driven; `frame` catches
///| the scene at that frame of the script (mid-drag) instead of at its end.
fn sidebar_shot(
  w_world : World,
  out_dir : String,
  filename : String,
  setup : (shell_ui::ShellController) -> Unit,
  dark~ : Bool = false,
  script~ : String = "wait 400",
  frame? : Int,
  download~ : shell_ui::ShellDownloadActivity = shell_ui::ShellDownloadActivity::none(),
) -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      setup(ctrl)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      let hooks = shell_ui::ShellHostHooks::{
        ..shell_ui::ShellHostHooks::empty(),
        downloads_activity: if download.visible { Some(fn() { download }) } else { None },
        on_downloads_activity: if download.visible { Some(fn() { () }) } else { None },
      }
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    path=path,
    w=1280.0,
    h=800.0,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    script=script,
    frame?=frame,
    theme=lg::ui_theme,
    async_write=true,
  )
  io_println(w_world, if ok { "shell_shots: wrote " + path } else { "shell_shots: FAILED " + path })
  ok
}

fn sidebar_pair(
  w : World,
  out_dir : String,
  name : String,
  setup : (shell_ui::ShellController) -> Unit,
  script~ : String = "wait 400",
  frame? : Int,
  download~ : shell_ui::ShellDownloadActivity = shell_ui::ShellDownloadActivity::none(),
) -> Bool {
  let mut ok = true
  ok = sidebar_shot(w, out_dir, "sidebar-" + name + "-light.png", setup, script~, frame?=frame, download~) && ok
  ok = sidebar_shot(w, out_dir, "sidebar-" + name + "-dark.png", setup, dark=true, script~, frame?=frame, download~) && ok
  ok
}

fn sidebar_no_setup(_ctrl : shell_ui::ShellController) -> Unit {
  ()
}

pub fn render_sidebar_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // The Today divider hovered: its Clear at the trailing end, the hairline ending where it starts.
  ok = sidebar_pair(w, out_dir, "today-clear", sidebar_no_setup, script="wait 200\nhover Today\nwait 300") && ok
  // A playing tab hovered: Close at the row's end, its speaker (a button: mute) just left of it.
  ok = sidebar_pair(w, out_dir, "speaker-hover", sidebar_no_setup, script="wait 200\nhover SomaFM\nwait 300") && ok
  // The docked sidebar hidden, the pointer at the window's leading edge: the sidebar floats in over the page.
  ok = sidebar_pair(w, out_dir, "edge-peek", fn(ctrl) {
    ctrl.dock.set(shell_ui::DockState::{ ..ctrl.dock.untracked(), sidebar_open: false })
  }, script="wait 200\nhover Sidebar Edge\nwait 400") && ok
  // (the demo's rows at 1280x800: WPT Dashboard 349..381, Groove Salad 315..347, the Favorites grid 92..140)
  // A tab dragged up onto Groove Salad's upper half, caught before it is let go: the 2pt accent line above it.
  ok = sidebar_pair(w, out_dir, "drag-reorder", sidebar_no_setup, script="wait 200\ndrag 120 365 0 -40 600", frame=46) && ok
  // A tab dragged onto Favorites: the lifted row over the grid (outside the list's clip), the grid's wash, the line
  // before the tile it would land in front of.
  ok = sidebar_pair(w, out_dir, "drag-favorites", sidebar_no_setup, script="wait 200\ndrag 120 365 0 -249 600", frame=46) && ok
  // The sidebar edge: hovered (the hairline), and dragged (the accent hairline, the sidebar following).
  ok = sidebar_pair(w, out_dir, "resize-hover", sidebar_no_setup, script="wait 200\nhover Resize Sidebar\nwait 300") && ok
  ok = sidebar_pair(w, out_dir, "resize-drag", sidebar_no_setup, script="wait 200\ndrag 244 300 60 0 600", frame=46) && ok
  // A bulk close's toast with a real Undo.
  ok = sidebar_pair(w, out_dir, "undo-toast", fn(ctrl) {
    ctrl.passive.set(shell_ui::PassiveState::{
      ..ctrl.passive.untracked(),
      toast_visible: true,
      toast_title: "Closed 3 other tabs",
      toast_kind: shell_ui::toast_kind_from_tag("close"),
      toast_action: "Undo",
    })
  }) && ok
  // The active tab loading: its tile a spinner, Reload turned into Stop.
  ok = sidebar_pair(w, out_dir, "loading", fn(ctrl) {
    ctrl.loading.set(true)
    let tabs = ctrl.tabs.untracked().copy()
    let mut i = 0
    while i < tabs.length() {
      if tabs[i].active {
        tabs[i] = shell_ui::ShellTabItem::{ ..tabs[i], loading: true }
      }
      i += 1
    }
    ctrl.tabs.set(tabs)
  }) && ok
  // A page's download at the sidebar's foot: running, and failed (it stays until pressed).
  ok = sidebar_pair(w, out_dir, "download-running", sidebar_no_setup, download=shell_ui::ShellDownloadActivity::{
    visible: true,
    name: "farview-0.9.2-arm64.dmg",
    more: 1,
    progress: 0.42,
    done: false,
    failed: false,
  }) && ok
  ok = sidebar_pair(w, out_dir, "download-failed", sidebar_no_setup, download=shell_ui::ShellDownloadActivity::{
    visible: true,
    name: "quarterly-report.pdf",
    more: 0,
    progress: 0.6,
    done: true,
    failed: true,
  }) && ok
  // The open favorite raised like the selected row; an unloaded pinned tab dimmed.
  ok = sidebar_pair(w, out_dir, "favorite-active-unloaded", fn(ctrl) {
    let favs = ctrl.favorites.untracked().copy()
    favs[1] = shell_ui::ShellFavoriteItem::{ ..favs[1], active: true }
    ctrl.favorites.set(favs)
    let tabs = ctrl.tabs.untracked().copy()
    let mut i = 0
    while i < tabs.length() {
      tabs[i] = shell_ui::ShellTabItem::{ ..tabs[i], active: false, unloaded: tabs[i].title == "CSS Grid Layout Module Level 3" }
      i += 1
    }
    ctrl.tabs.set(tabs)
  }) && ok
  ok
}
