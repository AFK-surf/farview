///| `popovers` panel scenes for the offscreen gallery (`FV_SHOTS_ONLY=popovers`).
///| Each scene renders light and dark at 1280x800 (and 480x800 where the panel has a narrow layout),
///| named `popovers-<scene>-<light|dark>[-480].png`, via `render_scene`.

import "shell_ui"
import "ui"
import "view"

///| The address field in the docked sidebar (1280) and in the compact toolbar (480).
fn pop_capsule(narrow : Bool) -> shell_ui::AnchorRect {
  if narrow {
    shell_ui::AnchorRect::{ x: 84.0, y: 4.0, w: 388.0, h: 32.0 }
  } else {
    shell_ui::AnchorRect::{ x: 8.0, y: 48.0, w: 232.0, h: 32.0 }
  }
}

///| The site button at the leading edge of the address field.
fn pop_site_button(narrow : Bool) -> shell_ui::AnchorRect {
  let c = pop_capsule(narrow)
  shell_ui::AnchorRect::{ x: c.x + 4.0, y: c.y + 4.0, w: 24.0, h: 24.0 }
}

fn pop_open_page(ctrl : shell_ui::ShellController, url : String, title : String) -> Unit {
  ctrl.dispatch(shell_ui::ShellIntent::SyncActiveUrl(shell_ui::PaneId::Primary, url, title))
}

fn site_info_callbacks() -> shell_ui::SiteInfoCallbacks {
  shell_ui::SiteInfoCallbacks::{
    on_close: fn() { () },
    on_permission_change: fn(_p : Int, _o : String, _k : String, _n : String) -> Unit { () },
    on_open_cookies: fn(_p : Int, _o : String) -> Unit { () },
    on_open_zoom: fn(_p : Int) -> Unit { () },
    on_open_boosts: fn(_p : Int, _o : String) -> Unit { () },
    on_reset_permissions: fn(_p : Int, _o : String) -> Unit { () },
    on_clear_site_data: fn(_p : Int, _o : String) -> Unit { () },
  }
}

fn perms(camera : String, mic : String, notif : String, geo : String, clip : String) -> Array[shell_ui::SitePermissionEntry] {
  [
    shell_ui::SitePermissionEntry::{ kind: "camera", label: "Camera", state: camera },
    shell_ui::SitePermissionEntry::{ kind: "microphone", label: "Microphone", state: mic },
    shell_ui::SitePermissionEntry::{ kind: "notifications", label: "Notifications", state: notif },
    shell_ui::SitePermissionEntry::{ kind: "geolocation", label: "Location", state: geo },
    shell_ui::SitePermissionEntry::{ kind: "clipboard", label: "Clipboard", state: clip },
  ]
}

fn mount_site_info(root : view::View, snap : shell_ui::SiteInfoSnapshot, narrow : Bool) -> Unit {
  shell_ui::build_site_info_popover(
    root,
    shell_ui::SiteInfoPopoverProps::{
      open: fn() { true },
      snapshot: fn() { snap },
      trigger_anchor: fn() { Some(pop_site_button(narrow)) },
      fallback_capsule: fn() { pop_capsule(narrow) },
      callbacks: site_info_callbacks(),
    },
  )
}

fn github_snapshot() -> shell_ui::SiteInfoSnapshot {
  shell_ui::SiteInfoSnapshot::{
    owner_pane: 0,
    committed_origin: "https://github.com",
    display_host: "github.com",
    tls_secure: true,
    tls_local: false,
    tls_summary: "Connection uses HTTPS transport encryption.",
    idn_warning: false,
    idn_badge: "",
    idn_detail: "",
    cookies_count: 12,
    zoom_percent: 110,
    boost_active: false,
    permissions: perms("ask", "ask", "allow", "block", "allow"),
  }
}

fn insecure_snapshot() -> shell_ui::SiteInfoSnapshot {
  shell_ui::SiteInfoSnapshot::{
    owner_pane: 0,
    committed_origin: "http://neverssl.com",
    display_host: "neverssl.com",
    tls_secure: false,
    tls_local: false,
    tls_summary: "Connection is not encrypted (HTTP).",
    idn_warning: false,
    idn_badge: "",
    idn_detail: "",
    cookies_count: 0,
    zoom_percent: 100,
    boost_active: false,
    permissions: perms("block", "block", "ask", "ask", "ask"),
  }
}

fn idn_site_snapshot() -> shell_ui::SiteInfoSnapshot {
  shell_ui::SiteInfoSnapshot::{
    owner_pane: 0,
    committed_origin: "https://xn--80ak6aa92e.com",
    display_host: "xn--80ak6aa92e.com",
    tls_secure: true,
    tls_local: false,
    tls_summary: "Connection uses HTTPS transport encryption.",
    idn_warning: true,
    idn_badge: "Lookalike characters",
    idn_detail: "Shown as xn--80ak6aa92e.com: the name mixes Cyrillic letters that look Latin.",
    cookies_count: 3,
    zoom_percent: 100,
    boost_active: false,
    permissions: perms("ask", "ask", "ask", "ask", "ask"),
  }
}

fn mount_idn(root : view::View, narrow : Bool) -> Unit {
  shell_ui::build_idna_spoof_popover(
    root,
    shell_ui::IdnaSpoofPopoverProps::{
      open: fn() { true },
      snapshot: fn() {
        shell_ui::IdnaSpoofSnapshot::{
          unicode_host: "аррӏе.com",
          punycode_host: "xn--80ak6aa92e.com",
          warning_summary: "This address uses letters from another alphabet that look like apple.com.",
          warning_detail: "Farview shows the Punycode form so the real address is visible. Check it before you sign in.",
        }
      },
      trigger_anchor: fn() { Some(pop_site_button(narrow)) },
      fallback_capsule: fn() { pop_capsule(narrow) },
      on_close: fn() { () },
    },
  )
}

fn mount_zoom(root : view::View, narrow : Bool, pct : Int) -> Unit {
  shell_ui::build_zoom_popover(
    root,
    shell_ui::ZoomPopoverProps::{
      open: fn() { true },
      host_label: fn() { "developer.mozilla.org" },
      zoom_percent: fn() { pct },
      can_zoom_out: fn() { pct > 50 },
      can_zoom_in: fn() { pct < 300 },
      trigger_anchor: fn() { None },
      fallback_capsule: fn() { pop_capsule(narrow) },
      on_zoom_out: fn() { () },
      on_zoom_in: fn() { () },
      on_reset: fn() { () },
      on_save_default: fn() { () },
      on_close: fn() { () },
    },
  )
}

fn mount_media(root : view::View, narrow : Bool, entries : Array[shell_ui::MediaHubEntry]) -> Unit {
  shell_ui::build_media_hub_popover(
    root,
    shell_ui::MediaHubPopoverProps::{
      open: fn() { true },
      entries: fn() { entries },
      trigger_anchor: fn() { None },
      fallback_capsule: fn() { pop_capsule(narrow) },
      callbacks: shell_ui::MediaHubCallbacks::{
        on_toggle_play: fn(_t : String) -> Unit { () },
        on_toggle_mute: fn(_t : String) -> Unit { () },
        on_mute_all: fn() { () },
        on_jump_tab: fn(_t : String) -> Unit { () },
        on_close: fn() { () },
      },
    },
  )
}

fn media_entries() -> Array[shell_ui::MediaHubEntry] {
  [
    shell_ui::MediaHubEntry::{
      tab_id: "t3",
      title: "Groove Salad — SomaFM",
      source_host: "soma.fm",
      playing: true,
      muted: false,
      is_live_call: false,
    },
    shell_ui::MediaHubEntry::{
      tab_id: "t7",
      title: "Weekly design review",
      source_host: "meet.google.com",
      playing: true,
      muted: true,
      is_live_call: true,
    },
    shell_ui::MediaHubEntry::{
      tab_id: "t8",
      title: "CSS Subgrid in 10 minutes",
      source_host: "youtube.com",
      playing: false,
      muted: false,
      is_live_call: false,
    },
  ]
}

fn mount_filter(root : view::View, query : String, matched : Int) -> Unit {
  let field = ui::Field::new()
  field.set(query)
  let _ = root.box(fn(pos : view::View) -> Unit {
    let _ = pos.over_at(view::Live::Is((Some(8.0), Some(88.0), None, None))).width(view::Live::Is(Some(232.0)))
    shell_ui::build_tab_filter_bar(
      pos,
      shell_ui::TabFilterBarProps::{
        open: fn() { true },
        field,
        matched_count: fn() { matched },
        total_count: fn() { 4 },
        on_query_change: fn(_q : String) -> Unit { () },
        on_clear: fn() { () },
        on_close: fn() { () },
      },
    )
  })
}

fn both(
  w : World,
  out_dir : String,
  scene : String,
  narrow_too : Bool,
  build : (view::View, shell_ui::ShellController, Bool) -> Unit,
) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "popovers-\{scene}-\{tone}.png", 1280.0, 800.0, fn(r, c) { build(r, c, false) }, dark=dark) &&
    ok
    if narrow_too {
      ok = render_scene(w, out_dir, "popovers-\{scene}-\{tone}-480.png", 480.0, 800.0, fn(r, c) { build(r, c, true) }, dark=dark) &&
      ok
    }
  }
  ok
}

pub fn render_popovers_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = both(w, out_dir, "siteinfo", true, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://github.com/w3c/csswg-drafts", "w3c/csswg-drafts")
    mount_site_info(root, github_snapshot(), narrow)
  }) &&
  ok
  ok = both(w, out_dir, "siteinfo-insecure", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "http://neverssl.com/", "NeverSSL")
    mount_site_info(root, insecure_snapshot(), narrow)
  }) &&
  ok
  ok = both(w, out_dir, "siteinfo-idn", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://xn--80ak6aa92e.com/", "Sign in")
    mount_site_info(root, idn_site_snapshot(), narrow)
  }) &&
  ok
  ok = both(w, out_dir, "idn", true, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://xn--80ak6aa92e.com/", "Sign in")
    mount_idn(root, narrow)
  }) &&
  ok
  ok = both(w, out_dir, "zoom", true, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://developer.mozilla.org/en-US/docs/Web/CSS/grid", "grid - CSS | MDN")
    mount_zoom(root, narrow, 125)
  }) &&
  ok
  ok = both(w, out_dir, "zoom-actual", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://developer.mozilla.org/en-US/docs/Web/CSS/grid", "grid - CSS | MDN")
    mount_zoom(root, narrow, 100)
  }) &&
  ok
  ok = both(w, out_dir, "media", true, fn(root, _ctrl, narrow) { mount_media(root, narrow, media_entries()) }) && ok
  ok = both(w, out_dir, "media-empty", false, fn(root, _ctrl, narrow) { mount_media(root, narrow, []) }) && ok
  ok = both(w, out_dir, "tabfilter", false, fn(root, _ctrl, _narrow) { mount_filter(root, "css", 2) }) && ok
  ok
}
