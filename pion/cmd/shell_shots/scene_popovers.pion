///| Renders the demo shell like `render_scene`, but with host hooks (the real sidebar filter slot and the
///| address field's trailing slot), so those pieces sit where the app puts them.
fn render_scene_hooked(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  dark : Bool,
  setup : (shell_ui::ShellController) -> Unit,
  hooks : shell_ui::ShellHostHooks,
  build : (view::View, shell_ui::ShellController) -> Unit,
) -> Bool {
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark)
      setup(ctrl)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
      build(root, ctrl)
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    at=500.0,
    theme=lg::ui_theme,
  )
  if ok {
    io_println(w_world, "shell_shots: wrote " + path)
  } else {
    io_println(w_world, "shell_shots: FAILED " + path)
  }
  ok
}

///| Address field hooks with the lookalike marker (`active`: its popover is open).
fn idn_marker_hooks(active : Bool) -> shell_ui::ShellHostHooks {
  shell_ui::ShellHostHooks::{
    ..shell_ui::ShellHostHooks::empty(),
    address_trailing_slot: Some(fn(pill : view::View) -> Unit {
      shell_ui::build_idna_spoof_capsule(pill, fn() { true }, fn() { active }, fn() { () })
    }),
  }
}

///| The tab filter in the real sidebar slot; the sidebar's tabs and folders are filtered the way the app does
///| (a tab matches when its title or address contains the query).
fn tab_matches(t : shell_ui::ShellTabItem, q : String) -> Bool {
  t.url.contains(q) || t.title.contains(q)
}

fn filter_scene(w : World, out_dir : String, scene : String, query : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    let field = ui::Field::new()
    field.set(query)
    let matched = ui::ref_new(0)
    let total = ui::ref_new(0)
    let hooks = shell_ui::ShellHostHooks::{
      ..shell_ui::ShellHostHooks::empty(),
      sidebar_filter_slot: Some(fn(sb : view::View) -> Unit {
        shell_ui::build_tab_filter_bar(
          sb,
          shell_ui::TabFilterBarProps::{
            open: fn() { true },
            field,
            matched_count: fn() { matched.v },
            total_count: fn() { total.v },
            on_query_change: fn(_q : String) -> Unit { () },
            on_clear: fn() { () },
            on_close: fn() { () },
          },
        )
      }),
    }
    let setup = fn(ctrl : shell_ui::ShellController) -> Unit {
      let all = ctrl.tabs.untracked()
      let kept : Array[shell_ui::ShellTabItem] = []
      for t in all {
        if tab_matches(t, query) {
          kept.push(t)
        }
      }
      matched.v = kept.length()
      total.v = all.length()
      let folders : Array[shell_ui::ShellFolderItem] = []
      for f in ctrl.folders.untracked() {
        let mut used = false
        for t in kept {
          if t.folder_id == f.id {
            used = true
          }
        }
        if used {
          folders.push(f)
        }
      }
      ctrl.tabs.set(kept)
      ctrl.folders.set(folders)
    }
    ok = render_scene_hooked(w, out_dir, "popovers-\{scene}-\{tone}.png", 1280.0, 800.0, dark, setup, hooks, fn(_r, _c) { () }) &&
    ok
  }
  ok
}

///| The lookalike marker in the address field (light and dark, 1280 and 480), at rest or with its popover open.
fn idn_marker_scene(w : World, out_dir : String, scene : String, open_popover : Bool) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    for narrow in [false, true] {
      let suffix = if narrow { "-480" } else { "" }
      ok = render_scene_hooked(
        w,
        out_dir,
        "popovers-\{scene}-\{tone}\{suffix}.png",
        if narrow { 480.0 } else { 1280.0 },
        800.0,
        dark,
        fn(ctrl) { pop_open_page(ctrl, "https://xn--80ak6aa92e.com/", "Sign in") },
        idn_marker_hooks(open_popover),
        fn(root, _ctrl) {
          if open_popover {
            mount_idn(root, narrow)
          }
        },
      ) &&
      ok
    }
  }
  ok
}

///| Site Information for the lookalike host, with the marker in the address field.
fn siteinfo_idn_scene(w : World, out_dir : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene_hooked(
      w,
      out_dir,
      "popovers-siteinfo-idn-\{tone}.png",
      1280.0,
      800.0,
      dark,
      fn(ctrl) { pop_open_page(ctrl, "https://xn--80ak6aa92e.com/", "Sign in") },
      idn_marker_hooks(false),
      fn(root, _ctrl) { mount_site_info(root, idn_site_snapshot(), false) },
    ) &&
    ok
  }
  ok
}

fn pop_both(
  w : World,
  out_dir : String,
  scene : String,
  narrow_too : Bool,
  build : (view::View, shell_ui::ShellController, Bool) -> Unit,
) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "popovers-\{scene}-\{tone}.png", 1280.0, 800.0, fn(r, c) { build(r, c, false) }, dark=dark) &&
    ok
    if narrow_too {
      ok = render_scene(w, out_dir, "popovers-\{scene}-\{tone}-480.png", 480.0, 800.0, fn(r, c) { build(r, c, true) }, dark=dark) &&
      ok
    }
  }
  ok
}

pub fn render_popovers_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = pop_both(w, out_dir, "siteinfo", true, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://github.com/w3c/csswg-drafts", "w3c/csswg-drafts")
    mount_site_info(root, github_snapshot(), narrow)
  }) &&
  ok
  ok = pop_both(w, out_dir, "siteinfo-insecure", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "http://neverssl.com/", "NeverSSL")
    mount_site_info(root, insecure_snapshot(), narrow)
  }) &&
  ok
  ok = siteinfo_idn_scene(w, out_dir) && ok
  // Its opened parts: the Camera row's picker, the More menu, the connection detail.
  ok = pop_both(w, out_dir, "siteinfo-picker", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://github.com/w3c/csswg-drafts", "w3c/csswg-drafts")
    mount_site_info(root, github_snapshot(), narrow, picking="camera")
  }) &&
  ok
  ok = pop_both(w, out_dir, "siteinfo-more", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://github.com/w3c/csswg-drafts", "w3c/csswg-drafts")
    mount_site_info(root, github_snapshot(), narrow, more=true)
  }) &&
  ok
  ok = pop_both(w, out_dir, "siteinfo-detail", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://github.com/w3c/csswg-drafts", "w3c/csswg-drafts")
    mount_site_info(root, github_snapshot(), narrow, detail=true)
  }) &&
  ok
  // A short window: the header stays put and the groups scroll under it instead of running off the bottom.
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene(
      w,
      out_dir,
      "popovers-siteinfo-short-\{tone}.png",
      1280.0,
      560.0,
      fn(root, ctrl) {
        pop_open_page(ctrl, "https://github.com/w3c/csswg-drafts", "w3c/csswg-drafts")
        mount_site_info(root, github_snapshot(), false)
      },
      dark=dark,
    ) &&
    ok
  }
  ok = idn_marker_scene(w, out_dir, "idn", true) && ok
  ok = idn_marker_scene(w, out_dir, "idn-marker", false) && ok
  ok = pop_both(w, out_dir, "zoom", true, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://developer.mozilla.org/en-US/docs/Web/CSS/grid", "grid - CSS | MDN")
    mount_zoom(root, narrow, 125)
  }) &&
  ok
  ok = pop_both(w, out_dir, "zoom-actual", false, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://developer.mozilla.org/en-US/docs/Web/CSS/grid", "grid - CSS | MDN")
    mount_zoom(root, narrow, 100)
  }) &&
  ok
  ok = pop_both(w, out_dir, "zoom-bubble", true, fn(root, ctrl, narrow) {
    pop_open_page(ctrl, "https://developer.mozilla.org/en-US/docs/Web/CSS/grid", "grid - CSS | MDN")
    mount_zoom_bubble(root, narrow, 125)
  }) &&
  ok
  ok = pop_both(w, out_dir, "media", true, fn(root, _ctrl, narrow) { mount_media(root, narrow, media_entries()) }) && ok
  ok = pop_both(w, out_dir, "media-empty", false, fn(root, _ctrl, narrow) { mount_media(root, narrow, []) }) && ok
  ok = filter_scene(w, out_dir, "tabfilter", "css") && ok
  ok = filter_scene(w, out_dir, "tabfilter-none", "figma") && ok
  ok
}
