///| Arc feel, Arc Peek (frameless card + outside floating rail + Favorite Peek corner badge),
///| and Little Arc (`emil-design-eng` window motion) offscreen @2x screenshots and 60fps videos.
///| Run via `FV_SHOTS_ONLY=arc_feel` (stills) or `FV_SHOTS_ONLY=arc_feel_video` (60fps MP4s).

import "film"
import "lg"
import "proto"
import "shell_ui"
import "signals"
import "ui"
import "view"

fn af_activate_first_favorite(ctrl : shell_ui::ShellController) -> Unit {
  let favs = ctrl.favorites.untracked()
  let next : Array[shell_ui::ShellFavoriteItem] = []
  let mut i = 0
  while i < favs.length() {
    let f = favs[i]
    next.push(shell_ui::ShellFavoriteItem::{ ..f, active: i == 0 })
    i += 1
  }
  ctrl.favorites.set(next)
}

fn af_build_little_arc_demo(
  root : view::View,
  ctrl : shell_ui::ShellController,
  open : signals::Signal[Bool],
  dark : Bool,
) -> Unit {
  let url = signals::signal("https://developer.mozilla.org")
  let title = signals::signal("CSS Grid Layout Module Level 3")
  let target_sp = signals::signal("work")
  let url_field = ui::Field::new()
  shell_ui::build_little_arc_window(
    root,
    shell_ui::LittleArcProps::{
      open: fn() { open.get() },
      dark: fn() { dark },
      stage_left: fn() {
        let d = ctrl.dock.get()
        if d.sidebar_open && root.window_w() >= 720.0 {
          if d.sidebar_width > 0.0 { d.sidebar_width } else { 248.0 }
        } else {
          shell_ui::SHELL_FRAME_GAP
        }
      },
      url: fn() { url.get() },
      title: fn() { title.get() },
      spaces: fn() { ctrl.spaces.get() },
      target_space_id: target_sp,
      url_field,
      on_navigate: fn(u) { url.set(u) },
      on_promote: fn(_u, sid) {
        ctrl.dispatch(shell_ui::ShellIntent::SelectSpace(sid))
        open.set(false)
      },
      on_close: fn() { open.set(false) },
      content: Some(fn(card : view::View) -> Unit {
        shell_ui::build_demo_pane(
          card,
          shell_ui::PaneId::Secondary,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      }),
    },
  )
}

pub fn render_arc_feel_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true

  // 1. Exact same-size/same-data AFTER shot for `before/peek-before.png` (1280x800 @1x)
  let peek_same_path = out_dir + "/arc-peek-after-same.png"
  let p_same = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=false)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=shell_ui::DemoBackdrop::EditorialLight)
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      let _ = root.at_moment(root.cause_at() + 100.0, fn() {
        ctrl.dispatch(shell_ui::ShellIntent::OpenPeek("https://developer.mozilla.org/en-US/docs/Web/CSS/grid"))
      })
    },
    path=peek_same_path,
    w=1280.0,
    h=800.0,
    scale=1.0,
    window_corner=20.0,
    at=360.0,
    theme=lg::ui_theme,
    async_write=true,
  )
  io_println(w, if p_same { "shell_shots: wrote " + peek_same_path } else { "shell_shots: FAILED " + peek_same_path })
  ok = p_same && ok

  // 2. High-res @2x Arc Peek + Active Favorite luminous border + Peek corner badge (light & dark)
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "arc-peek-fav-\{tone}.png", 1280.0, 800.0, fn(_root, ctrl) {
      af_activate_first_favorite(ctrl)
      ctrl.dispatch(shell_ui::ShellIntent::OpenPeek("https://thetype.com/"))
    }, dark=dark) && ok
  }

  // 3. Standalone Quick Window (independent 820x580 compact OS window — no sidebar, no backdrop scrim!)
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    let qw_path = out_dir + "/quick-window-standalone-\{tone}.png"
    let q_ok = film::picture(
      fn(root : view::View) -> Unit {
        lg::set_dark(Some(dark))
        let ctrl = shell_ui::make_demo_controller(dark=dark)
        let open = signals::signal(true)
        let url = signals::signal("https://developer.mozilla.org")
        let title = signals::signal("CSS Grid Layout Module Level 3")
        let target_sp = signals::signal("work")
        let url_field = ui::Field::new()
        shell_ui::build_quick_window_standalone(
          root,
          shell_ui::LittleArcProps::{
            open: fn() { open.get() },
            dark: fn() { dark },
            stage_left: fn() { 0.0 },
            url: fn() { url.get() },
            title: fn() { title.get() },
            spaces: fn() { ctrl.spaces.get() },
            target_space_id: target_sp,
            url_field,
            on_navigate: fn(u) { url.set(u) },
            on_promote: fn(_u, _sid) { () },
            on_close: fn() { () },
            content: Some(fn(card : view::View) -> Unit {
              shell_ui::build_demo_pane(
                card,
                shell_ui::PaneId::Secondary,
                ctrl.model(),
                emit=fn(i) { ctrl.dispatch(i) },
                backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
              )
            }),
          },
        )
      },
      path=qw_path,
      w=820.0,
      h=580.0,
      scale=2.0,
      dark=dark,
      window_corner=16.0,
      at=120.0,
      theme=lg::ui_theme,
      async_write=true,
    )
    io_println(w, if q_ok { "shell_shots: wrote " + qw_path } else { "shell_shots: FAILED " + qw_path })
    ok = q_ok && ok
  }
  ok = frame_scripted(
    w,
    out_dir,
    "quick-window-picker-light.png",
    1280.0,
    fn(root, ctrl) {
      let open = signals::signal(true)
      af_build_little_arc_demo(root, ctrl, open, false)
    },
    "wait 200\npress Choose Space for Quick Window\nwait 260",
    dark=false,
  ) && ok

  // 4. Settings -> General, Tabs, and Privacy showing semantic color-coded sidebar + filled icons (light & dark)
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "quick-settings-general-\{tone}.png", 1280.0, 800.0, fn(root, ctrl) {
      mount_settings(root, ctrl, shell_ui::SETTINGS_TAB_GENERAL, "")
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "quick-settings-tabs-\{tone}.png", 1280.0, 800.0, fn(root, ctrl) {
      mount_settings(root, ctrl, shell_ui::SETTINGS_TAB_TABS, "")
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "quick-settings-privacy-\{tone}.png", 1280.0, 800.0, fn(root, ctrl) {
      mount_settings(root, ctrl, shell_ui::SETTINGS_TAB_PRIVACY, "")
    }, dark=dark) && ok
  }

  // 5. Tab Hover Close AFTER (same 1280x800 @2x as before/frame-tab-hover-close-*)
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = frame_scripted(
      w,
      out_dir,
      "arc-tab-hover-close-\{tone}.png",
      1280.0,
      fn(_r, _c) { () },
      "wait 300\nhover CSS Grid Layout Module Level 3\nwait 300",
      dark=dark,
    ) && ok
  }
  ok
}

pub fn render_arc_feel_videos(w : World, out_dir : String) -> Bool {
  let mut ok = true

  // Video 1: Quick Window Apple spring bloom -> open Space switcher -> pick Life -> Open in Life spring promote
  let la_mp4 = out_dir + "/quick_window_spring_motion.mp4"
  let ok_la = film::film(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=false)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=shell_ui::DemoBackdrop::EditorialLight)
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      let open = signals::signal(false)
      af_build_little_arc_demo(root, ctrl, open, false)
      let _ = root.at_moment(root.cause_at() + 220.0, fn() { open.set(true) })
    },
    script="wait 850\npress Choose Space for Quick Window\nwait 420\npress Target Space Life\nwait 420\npress Open in Life\nwait 450",
    out=la_mp4,
    w=1280.0,
    h=800.0,
    scale=1.0,
    dark=false,
    window_corner=20.0,
    fps=60,
    theme=lg::ui_theme,
    transitions_only=false,
  )
  io_println(w, if ok_la { "shell_shots: wrote " + la_mp4 } else { "shell_shots: FAILED " + la_mp4 })
  ok = ok_la && ok

  // Video 2: Peek Apple spring bloom from clicked link origin (640, 560) with subtle 1% primary recession +
  // whisper-subtle micro-overshoot settle -> hover & press Close Peek
  let pk_mp4 = out_dir + "/peek_spring_motion.mp4"
  let ok_pk = film::film(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=false)
      af_activate_first_favorite(ctrl)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=shell_ui::DemoBackdrop::EditorialLight)
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      let _ = root.at_moment(root.cause_at() + 180.0, fn() {
        root.tree.pointer_is(610.0, 560.0)
      })
      let _ = root.at_moment(root.cause_at() + 220.0, fn() {
        ctrl.dispatch(shell_ui::ShellIntent::OpenPeek("https://thetype.com/"))
      })
    },
    script="wait 920\nhover Close Peek\nwait 260\npress Close Peek\nwait 420",
    out=pk_mp4,
    w=1280.0,
    h=800.0,
    scale=1.0,
    dark=false,
    window_corner=20.0,
    fps=60,
    theme=lg::ui_theme,
    transitions_only=false,
  )
  io_println(w, if ok_pk { "shell_shots: wrote " + pk_mp4 } else { "shell_shots: FAILED " + pk_mp4 })
  ok = ok_pk && ok

  // Video 3: Round 2 radiating interactions — Site Controls micro-spring popover -> hover Copy/Boost ->
  // Camera inline permission picker reveal -> close -> Command Bar Cmd+K lift+scale reveal
  let r2_mp4 = out_dir + "/r2_radiating_motion.mp4"
  let ok_r2 = film::film(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=false)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=shell_ui::DemoBackdrop::EditorialLight)
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      let site_open = signals::signal(false)
      let snap = github_snapshot()
      shell_ui::build_site_info_popover(
        root,
        shell_ui::SiteInfoPopoverProps::{
          open: fn() { site_open.get() },
          snapshot: fn() { snap },
          trigger_anchor: fn() { Some(pop_site_button(false)) },
          fallback_capsule: fn() { pop_capsule(false) },
          callbacks: site_info_callbacks(),
        },
      )
      let cmd_field = ui::Field::new()
      let cmd_items = proto::build_command_bar_items(cmd_snapshot_from(ctrl), "", ctrl.url.untracked(), true)
      shell_ui::build_command_bar_overlay(
        root,
        ctrl.model(),
        shell_ui::CommandBarProps::{
          field: cmd_field,
          items: fn() { cmd_items },
          selected: fn() { 0 },
          on_query_change: fn(_q) { () },
          on_step: fn(_d) { true },
          on_submit: fn(_t) { () },
          on_execute: fn(_it) { () },
          on_close: fn() { ctrl.exclusive.set(shell_ui::ExclusiveState::empty()) },
          on_row_view: None,
          on_clear_rows: None,
        },
      )
      let _ = root.at_moment(root.cause_at() + 240.0, fn() { site_open.set(true) })
      let _ = root.at_moment(root.cause_at() + 2050.0, fn() { site_open.set(false) })
      let _ = root.at_moment(root.cause_at() + 2350.0, fn() {
        cmd_open_bar(ctrl, shell_ui::ExclusiveKind::CommandBar, "command_bar")
      })
      let _ = root.at_moment(root.cause_at() + 3450.0, fn() {
        ctrl.exclusive.set(shell_ui::ExclusiveState::empty())
      })
    },
    script="wait 640\nhover Copy Link\nwait 220\nhover Edit Site Boosts\nwait 220\npress Change Camera Permission\nwait 480\nhover Camera Allow\nwait 300\nwait 1800",
    out=r2_mp4,
    w=1280.0,
    h=800.0,
    scale=1.0,
    dark=false,
    window_corner=20.0,
    fps=60,
    theme=lg::ui_theme,
    transitions_only=false,
  )
  io_println(w, if ok_r2 { "shell_shots: wrote " + r2_mp4 } else { "shell_shots: FAILED " + r2_mp4 })
  ok = ok_r2 && ok
  ok
}
