///| `frame` scenes for the offscreen gallery (`FV_SHOTS_ONLY=frame`): the capture sheet and the toast that the
///| shell frame draws over the page, and the address palette (Cmd+T empty, a green and a purple Space). Each renders light and dark at 1280x800 and 480x800, named
///| `frame-<scene>-<light|dark>[-480].png`, via `render_scene`.

import "film"
import "lg"
import "shell_ui"
import "view"

fn frame_show_capture(ctrl : shell_ui::ShellController, revealable : Bool, unavailable : Bool) -> Unit {
  let p = ctrl.passive.untracked()
  ctrl.passive.set(shell_ui::PassiveState::{
    ..p,
    capture_sheet_open: true,
    capture_sheet: shell_ui::demo_capture_meta(),
    capture_sheet_revealable: revealable,
    capture_sheet_file_unavailable: unavailable,
  })
}

fn frame_show_toast(ctrl : shell_ui::ShellController, title : String, subtitle : String, kind : shell_ui::ToastKind) -> Unit {
  let p = ctrl.passive.untracked()
  ctrl.passive.set(shell_ui::PassiveState::{ ..p, toast_visible: true, toast_title: title, toast_subtitle: subtitle, toast_kind: kind })
}

fn frame_scene_set(
  w : World,
  out_dir : String,
  name : String,
  build : (view::View, shell_ui::ShellController) -> Unit,
) -> Bool {
  let mut ok = true
  ok = render_scene(w, out_dir, "frame-" + name + "-light.png", 1280.0, 800.0, build) && ok
  ok = render_scene(w, out_dir, "frame-" + name + "-dark.png", 1280.0, 800.0, build, dark=true) && ok
  ok = render_scene(w, out_dir, "frame-" + name + "-light-480.png", 480.0, 800.0, build) && ok
  ok = render_scene(w, out_dir, "frame-" + name + "-dark-480.png", 480.0, 800.0, build, dark=true) && ok
  ok
}

///| `render_scene` driven by a film `script` before the capture (hover, press), on `platform` (0 macOS, 3 Windows, 5 Linux).
fn frame_scripted(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  build : (view::View, shell_ui::ShellController) -> Unit,
  script : String,
  dark~ : Bool = false,
  platform~ : Int = 0,
  split~ : Bool = false,
  window_inset_override? : Double,
  window_corner~ : Double = 20.0,
) -> Bool {
  if !take_shot_slot() {
    return true
  }
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(dark=dark, split=split, window_inset_override?=window_inset_override)
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(
          p,
          id,
          ctrl.model(),
          emit=fn(i) { ctrl.dispatch(i) },
          backdrop=if dark { shell_ui::DemoBackdrop::DocsDark } else { shell_ui::DemoBackdrop::EditorialLight },
        )
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      build(root, ctrl)
    },
    path=path,
    w=w,
    h=800.0,
    scale=2.0,
    platform=platform,
    dark=dark,
    window_corner=window_corner,
    script=script,
    at=200.0,
    theme=lg::ui_theme,
    async_write=true,
  )
  io_println(w_world, if ok { "shell_shots: wrote " + path } else { "shell_shots: FAILED " + path })
  ok
}

///| Keyboard and flow feel: the page-load line over the card's top edge, a hovered tab's title fading under its
///| close button, the split divider's drag strip, the More menu's shortcut labels on macOS and Linux, and the
///| Windows fused titlebar (docked sidebar, collapsed compact toolbar, narrow 480px, close-hover).
fn render_frame_feel_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  // Schedule the 69-frame mp4 first in frame so it lands on shard 1 (slot 5) beside player-hover-light.mp4 on shard 0 (slot 4).
  if take_shot_slot() {
    let mp4 = out_dir + "/frame-win-inset-sidebar-toggle.mp4"
    let filmed = film::film(
      fn(root : view::View) -> Unit {
        let ctrl = shell_ui::make_demo_controller(dark=false, window_inset_override=1.0)
        let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
          shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=shell_ui::DemoBackdrop::EditorialLight)
        })
        shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      },
      script="wait 250\npress Toggle Sidebar\nwait 450\npress Toggle Sidebar\nwait 450",
      out=mp4,
      w=1280.0,
      h=800.0,
      scale=1.0,
      platform=3,
      dark=false,
      window_corner=8.0,
      fps=60,
      theme=lg::ui_theme,
      transitions_only=false,
    )
    io_println(w, if filmed { "shell_shots: wrote " + mp4 } else { "shell_shots: FAILED " + mp4 })
    ok = filmed && ok
  }
  ok = frame_scene_set(w, out_dir, "loading", fn(_root, ctrl) { ctrl.loading.set(true) }) && ok
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = frame_scripted(w, out_dir, "frame-tab-hover-close-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 300\nhover CSS Grid Layout Module Level 3\nwait 300", dark~) && ok
    // (at rest beside hovered, so the grabber's hover wash can be compared: the pointer is over the strip's middle)
    ok = frame_scripted(w, out_dir, "frame-split-divider-rest-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 600", dark~, split=true) && ok
    ok = frame_scripted(w, out_dir, "frame-split-divider-hover-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 300\nhover Resize Split View\nwait 300", dark~, split=true) && ok
    ok = frame_scripted(w, out_dir, "frame-more-menu-mac-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 300\npress More Actions\nwait 400", dark~) && ok
    ok = frame_scripted(w, out_dir, "frame-more-menu-linux-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 300\npress More Actions\nwait 400", dark~, platform=5) && ok
    // Windows fused titlebar scenes (platform=3, inset=true, Windows 11 8pt corner).
    ok = frame_scripted(w, out_dir, "frame-win-inset-docked-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 200", dark~, platform=3, window_inset_override=1.0, window_corner=8.0) && ok
    ok = frame_scripted(w, out_dir, "frame-win-inset-720-\{tone}.png", 720.0, fn(_r, _c) { () }, "wait 200", dark~, platform=3, window_inset_override=1.0, window_corner=8.0) && ok
    ok = frame_scripted(w, out_dir, "frame-win-inset-collapsed-\{tone}.png", 1280.0, fn(_r, ctrl) { ctrl.dispatch(shell_ui::ShellIntent::ToggleSidebar) }, "wait 300", dark~, platform=3, window_inset_override=1.0, window_corner=8.0) && ok
    ok = frame_scripted(w, out_dir, "frame-win-inset-480-\{tone}.png", 480.0, fn(_r, _c) { () }, "wait 200", dark~, platform=3, window_inset_override=1.0, window_corner=8.0) && ok
    ok = frame_scripted(w, out_dir, "frame-win-inset-close-hover-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 200\nhover Close Window\nwait 200", dark~, platform=3, window_inset_override=1.0, window_corner=8.0) && ok
    ok = frame_scripted(w, out_dir, "frame-win-inset-modal-\{tone}.png", 1280.0, fn(_r, ctrl) { ctrl.dispatch(shell_ui::ShellIntent::OpenDialog) }, "wait 300", dark~, platform=3, window_inset_override=1.0, window_corner=8.0) && ok
    // macOS fused inset titlebar scenes (platform=0, inset=80pt, 20pt corner): 1280, narrow 720, saved 180 clamped, collapsed, fullscreen.
    ok = frame_scripted(w, out_dir, "frame-mac-inset-1280-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 200", dark~, platform=0, window_inset_override=shell_ui::SHELL_TRAFFIC_LIGHT_INSET, window_corner=20.0) && ok
    ok = frame_scripted(w, out_dir, "frame-mac-inset-720-\{tone}.png", 720.0, fn(_r, _c) { () }, "wait 200", dark~, platform=0, window_inset_override=shell_ui::SHELL_TRAFFIC_LIGHT_INSET, window_corner=20.0) && ok
    ok = frame_scripted(w, out_dir, "frame-mac-inset-180-\{tone}.png", 1280.0, fn(_r, ctrl) { ctrl.dispatch(shell_ui::ShellIntent::SetSidebarWidth(180.0, true)) }, "wait 200", dark~, platform=0, window_inset_override=shell_ui::SHELL_TRAFFIC_LIGHT_INSET, window_corner=20.0) && ok
    ok = frame_scripted(w, out_dir, "frame-mac-inset-collapsed-\{tone}.png", 1280.0, fn(_r, ctrl) { ctrl.dispatch(shell_ui::ShellIntent::ToggleSidebar) }, "wait 300", dark~, platform=0, window_inset_override=shell_ui::SHELL_TRAFFIC_LIGHT_INSET, window_corner=20.0) && ok
    ok = frame_scripted(w, out_dir, "frame-mac-fullscreen-\{tone}.png", 1280.0, fn(_r, _c) { () }, "wait 200", dark~, platform=0, window_inset_override=0.0, window_corner=0.0) && ok
  }
  ok
}

pub fn render_frame_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  ok = render_frame_feel_scenes(w, out_dir) && ok
  // Screenshot saved locally: Copy Path and Reveal.
  ok = frame_scene_set(w, out_dir, "capture-sheet", fn(_root, ctrl) { frame_show_capture(ctrl, true, false) }) && ok
  // Screenshot saved on the host: the file cannot be revealed on this device.
  ok = frame_scene_set(w, out_dir, "capture-sheet-remote", fn(_root, ctrl) { frame_show_capture(ctrl, false, true) }) && ok
  // Toasts: a confirmation, and an error with its reason.
  ok = frame_scene_set(
    w,
    out_dir,
    "toast-success",
    fn(_root, ctrl) { frame_show_toast(ctrl, "Link copied", "developer.mozilla.org/en-US/docs/Web/CSS/grid", shell_ui::ToastKind::Success) },
  ) && ok
  ok = frame_scene_set(
    w,
    out_dir,
    "toast-error",
    fn(_root, ctrl) { frame_show_toast(ctrl, "Failed to save PDF", "There is not enough space in Downloads.", shell_ui::ToastKind::Error) },
  ) && ok
  // Cmd+T: the empty new-tab palette (placeholder, open tabs, first row lit in the Space color).
  ok = frame_scene_set(w, out_dir, "omnibox-newtab-empty", fn(_root, ctrl) { ctrl.demo_open_new_tab_palette() }) && ok
  // The selected row filled from a green Space (Life), not the blue Work Space every other shot uses.
  ok = frame_scene_set(w, out_dir, "omnibox-open-life", fn(_root, ctrl) {
    ctrl.dispatch(shell_ui::ShellIntent::SelectSpace("personal"))
    ctrl.dispatch(shell_ui::ShellIntent::OmniboxFocus)
    ctrl.omnibox_field.set("grid")
    ctrl.dispatch(shell_ui::ShellIntent::OmniboxEdit("grid"))
  }) && ok
  ok = frame_scene_set(w, out_dir, "omnibox-newtab-lab", fn(_root, ctrl) {
    ctrl.dispatch(shell_ui::ShellIntent::SelectSpace("lab"))
    ctrl.demo_open_new_tab_palette()
  }) && ok
  ok
}
