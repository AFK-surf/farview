///| Extensions scenes for the offscreen gallery (`FV_SHOTS_ONLY=extensions`): Settings > Extensions, the
///| Address Bar's pinned extension faces with their badges, and the popover of a pressed one, light and dark at
///| 1280x800 (`extensions-<scene>-<light|dark>.png`, `settings-extensions-<light|dark>.png`).

import "proto"
import "shell_ui"
import "signals"
import "ui"
import "view"

fn shots_ext_item(id : String, name : String, version : String, description : String) -> proto::ExtensionUiItem {
  proto::ExtensionUiItem::{
    ..proto::ExtensionUiItem::blank(id),
    name,
    version,
    description,
    title: name,
    has_action: true,
    has_popup: true,
    popup_html_path: "chrome-extension://" + id + "/popup.html",
    options_url: "chrome-extension://" + id + "/options.html",
    permissions: ["storage", "contextMenus", "scripting"],
    host_permissions: ["https://*.example.com/*"],
    source: "unpacked:/exts/" + id,
  }
}

fn shots_ext_snapshot() -> proto::ExtensionsUiSnapshot {
  proto::ExtensionsUiSnapshot::{
    ..proto::ExtensionsUiSnapshot::empty(),
    items: [
      proto::ExtensionUiItem::{
        ..shots_ext_item("tabnotes", "Tab Notes", "1.4.2", "Keeps a short note with every tab and shows how many are open."),
        pinned: true,
        badge_text: "12",
        badge_bg: 0xFF3B30FFL,
      },
      proto::ExtensionUiItem::{
        ..shots_ext_item("readlater", "Read Later", "0.9.0", "Saves pages to read offline."),
        pinned: true,
        badge_text: "ON",
        permissions: ["storage", "alarms"],
        host_permissions: ["<all_urls>"],
        options_url: "",
      },
      proto::ExtensionUiItem::{
        ..shots_ext_item("darkmode", "Dark Mode", "3.1.0", "Darkens every site."),
        enabled: false,
        has_popup: false,
        popup_html_path: "",
      },
      proto::ExtensionUiItem::{
        ..shots_ext_item("oldtool", "Old Tool", "1.0", ""),
        enabled: false,
        error: "This extension's files are no longer available. Load it again.",
        permissions: [],
        host_permissions: [],
      },
    ],
  }
}

fn shots_ext_panel_props() -> shell_ui::ExtensionsPanelProps {
  let snap = signals::signal_ref(shots_ext_snapshot())
  shell_ui::ExtensionsPanelProps::{
    snapshot: fn() { snap.get() },
    on_toggle: fn(_id, _on) { () },
    on_pin: fn(_id, _on) { () },
    on_remove: fn(_id) { () },
    on_options: fn(_id) { () },
    path_field: ui::Field::new(),
    on_load_unpacked: fn(_p) { () },
    on_install_crx: fn(_p) { () },
  }
}

fn shots_ext_hooks(open_id : signals::Signal[String]) -> shell_ui::ShellHostHooks {
  shell_ui::ShellHostHooks::{
    ..shell_ui::ShellHostHooks::empty(),
    address_trailing_slot: Some(fn(pill : view::View) -> Unit {
      shell_ui::build_extension_toolbar(
        pill,
        shell_ui::ExtensionToolbarProps::{
          items: fn() { proto::extensions_pinned_items(shots_ext_snapshot()) },
          on_press: fn(id, _r) { open_id.set(id) },
          on_manage: fn() { () },
          open_id: fn() { open_id.get() },
        },
        always_manage=false,
      )
    }),
  }
}

pub fn render_extensions_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let tone = if dark { "dark" } else { "light" }
    ok = render_scene(
      w,
      out_dir,
      "settings-extensions-" + tone + ".png",
      1280.0,
      800.0,
      fn(root, ctrl) { mount_settings(root, ctrl, shell_ui::SETTINGS_TAB_EXTENSIONS, "", extensions=Some(shots_ext_panel_props())) },
      dark=dark,
    ) &&
    ok
    for popover in [false, true] {
      let open_id = signals::signal(if popover { "tabnotes" } else { "" })
      ok = render_scene_hooked(
        w,
        out_dir,
        "extensions-" + (if popover { "popover" } else { "toolbar" }) + "-" + tone + ".png",
        1280.0,
        800.0,
        dark,
        fn(ctrl) { pop_open_page(ctrl, "https://news.example.com/today", "Today's news") },
        shots_ext_hooks(open_id),
        fn(root, _ctrl) {
          shell_ui::build_extension_popup_popover(
            root,
            shell_ui::ExtensionPopupProps::{
              open: fn() { open_id.get() != "" },
              item: fn() { proto::extensions_find(shots_ext_snapshot(), open_id.get()) },
              trigger_anchor: fn() { shell_ui::extension_toolbar_anchor(open_id.get()) },
              fallback_capsule: fn() { shell_ui::AnchorRect::{ x: 480.0, y: 12.0, w: 320.0, h: 32.0 } },
              on_open_popup: fn(_u) { () },
              on_options: fn(_id) { () },
              on_unpin: fn(_id) { () },
              on_manage: fn() { () },
              on_close: fn() { open_id.set("") },
            },
          )
        },
      ) &&
      ok
    }
  }
  ok
}
