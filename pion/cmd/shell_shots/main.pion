///| macOS Metal @2x offscreen GPU screenshot harness for Farview Desktop Shell 2.0.
///| Renders 10 canonical Shell 2.0 scenes (including `10-compact-480-inset.png` with 72pt macOS
///| traffic-light clearance) into `$FV_SHELL_SHOTS_DIR` (default `/tmp/fv-shell-shots`).
///| Never commits PNGs to git; used for visual craft review and macOS CI smoke verification.

import "film"
import "lg"
import "shell_ui"
import "view"

fn render_shot(
  w_world : World,
  out_dir : String,
  filename : String,
  w : Double,
  h : Double,
  dark~ : Bool = false,
  split~ : Bool = false,
  left_reader~ : Bool = false,
  omnibox_open~ : Bool = false,
  drawer_open~ : Bool = false,
  backdrop~ : shell_ui::DemoBackdrop = shell_ui::DemoBackdrop::EditorialLight,
  settle_ms~ : Double = 0.0,
  window_inset_override? : Double,
) -> Bool {
  let path = out_dir + "/" + filename
  let ok = film::picture(
    fn(root : view::View) -> Unit {
      let ctrl = shell_ui::make_demo_controller(
        dark=dark,
        split=split,
        left_reader=left_reader,
        omnibox_open=omnibox_open,
        drawer_open=drawer_open,
        window_inset_override?=window_inset_override,
      )
      let slot = shell_ui::PaneSlot::new(fn(p : view::View, id : shell_ui::PaneId) -> Unit {
        shell_ui::build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=backdrop)
      })
      shell_ui::build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    path=path,
    w=w,
    h=h,
    scale=2.0,
    dark=dark,
    window_corner=20.0,
    at=settle_ms,
    theme=lg::ui_theme,
  )
  if ok {
    io_println(w_world, "shell_shots: wrote " + path)
  } else {
    io_println(w_world, "shell_shots: FAILED " + path)
  }
  ok
}

pub fn main(w : World) -> Int {
  let out_dir = match env_get(w, "FV_SHELL_SHOTS_DIR") {
    Some(v) if v.trim() != "" => v.trim()
    _ => "/tmp/fv-shell-shots"
  }
  let mut all_ok = true
  all_ok = render_shot(w, out_dir, "01-light-1280.png", 1280.0, 800.0, dark=false) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "02-dark-1280.png",
    1280.0,
    800.0,
    dark=true,
    backdrop=shell_ui::DemoBackdrop::DocsDark,
  ) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "03-split-1280.png",
    1280.0,
    800.0,
    dark=false,
    split=true,
    left_reader=true,
  ) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "04-omnibox-open-light.png",
    1280.0,
    800.0,
    dark=false,
    omnibox_open=true,
  ) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "05-omnibox-open-dark.png",
    1280.0,
    800.0,
    dark=true,
    omnibox_open=true,
    backdrop=shell_ui::DemoBackdrop::DocsDark,
  ) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "06-omnibox-open-colorful.png",
    1280.0,
    800.0,
    dark=false,
    omnibox_open=true,
    backdrop=shell_ui::DemoBackdrop::ColorfulPoster,
  ) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "07-drawer-open-1280.png",
    1280.0,
    800.0,
    dark=false,
    drawer_open=true,
    settle_ms=500.0,
  ) && all_ok
  all_ok = render_shot(w, out_dir, "08-narrow-760.png", 760.0, 800.0, dark=false) && all_ok
  all_ok = render_shot(w, out_dir, "09-compact-480.png", 480.0, 800.0, dark=false) && all_ok
  all_ok = render_shot(
    w,
    out_dir,
    "10-compact-480-inset.png",
    480.0,
    800.0,
    dark=false,
    window_inset_override=72.0,
  ) && all_ok
  if all_ok { 0 } else { 1 }
}
