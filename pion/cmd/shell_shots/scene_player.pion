///| Sidebar media player scenes (`FV_SHOTS_ONLY=player`): the demo shell with Groove Salad playing, the player at
///| rest and with the pointer over it (its title strip shown), light and dark, named `player-<rest|hover>-<mode>.png`.

import "shell_ui"

pub fn render_player_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "player-rest-" + mode + ".png", 1280.0, 800.0, fn(_root, _ctrl) { () }, dark=dark) && ok
    ok = render_scene(
      w,
      out_dir,
      "player-hover-" + mode + ".png",
      1280.0,
      800.0,
      fn(_root, _ctrl) { () },
      dark=dark,
      prepare="hover Mini Media Player\nwait 300",
    ) && ok
  }
  let _ = shell_ui::shell_icon_pack()
  ok
}
