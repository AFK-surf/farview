///| Sidebar media player scenes (`FV_SHOTS_ONLY=player`): the demo shell with Groove Salad playing, the player at
///| rest and with the pointer over it (its title strip shown), light and dark, named `player-<rest|hover>-<mode>.png`.

import "film"
import "lg"

pub fn render_player_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  for dark in [false, true] {
    let mode = if dark { "dark" } else { "light" }
    ok = render_scene(w, out_dir, "player-rest-" + mode + ".png", 1280.0, 800.0, fn(_root, _ctrl) { () }, dark=dark) && ok
    ok = render_scene(
      w,
      out_dir,
      "player-hover-" + mode + ".png",
      1280.0,
      800.0,
      fn(_root, _ctrl) { () },
      dark=dark,
      prepare="hover Mini Media Player\nwait 300",
    ) && ok
  }
  // At real speed: the pointer comes onto the player, rests, and leaves for a tab row.
  let film_out = out_dir + "/player-hover-light.mp4"
  let filmed = film::film(
    demo_tree(fn(_root, _ctrl) { () }, false),
    script="wait 300\nhover Mini Media Player\nwait 700\nhover Designing for Reading\nwait 600",
    out=film_out,
    w=1280.0,
    h=800.0,
    scale=2.0,
    window_corner=20.0,
    theme=lg::ui_theme,
  )
  io_println(w, (if filmed { "shell_shots: wrote " } else { "shell_shots: FAILED " }) + film_out)
  ok && filmed
}
