  [
    shell_ui::DownloadItemView::{
      id: "dl-node",
      filename: "node-v22.11.0-darwin-arm64.tar.gz",
      source_host: "nodejs.org",
      ext_badge: "GZ",
      size_label: "18.2 MB",
      state: "in_progress",
      state_label: "Downloading",
    },
    shell_ui::DownloadItemView::{
      id: "dl-progit",
      filename: "progit.pdf",
      source_host: "git-scm.com",
      ext_badge: "PDF",
      size_label: "6.9 MB",
      state: "completed",
      state_label: "Done",
    },
    shell_ui::DownloadItemView::{
      id: "dl-logo",
      filename: "Unicode_logo.svg.png",
      source_host: "upload.wikimedia.org",
      ext_badge: "PNG",
      size_label: "182 KB",
      state: "completed",
      state_label: "Done",
    },
    shell_ui::DownloadItemView::{
      id: "dl-rg",
      filename: "ripgrep-14.1.1-x86_64-apple-darwin.tar.gz",
