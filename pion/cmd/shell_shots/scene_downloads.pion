}

fn dl_mount_downloads(
  root : view::View,
  items : Array[shell_ui::DownloadItemView],
  total : Int,
  query~ : String = "",
  category~ : String = "all",
) -> Unit {
  let field = ui::Field::new()
  if query != "" {
    field.set(query)
  }
  shell_ui::build_downloads_popover(
    root,
    shell_ui::DownloadsPopoverProps::{
      open: fn() { true },
      search_field: field,
      active_category: fn() { category },
      total_count: fn() { total },
      items: fn() { items },
      trigger_anchor: fn() -> Option[shell_ui::AnchorRect] {
        let vw = root.window_w()
        if vw < 540.0 {
          None
        } else {
          Some(shell_ui::AnchorRect::{ x: vw - 44.0, y: 4.0, w: 36.0, h: 36.0 })
        }
      },
      fallback_capsule: fn() { shell_ui::AnchorRect::{ x: 56.0, y: 8.0, w: 368.0, h: 32.0 } },
      callbacks: shell_ui::DownloadsCallbacks::{
        on_search_change: fn(_q) { () },
        on_category_change: fn(_c) { () },
        on_copy_path: fn(_id) { () },
        on_reveal: fn(_id) { () },
        on_open: fn(_id) { () },
        on_clear_list: fn() { () },
        on_close: fn() { () },
      },
    },
  )
}

fn dl_mount_find(root : view::View, ctrl : shell_ui::ShellController, query : String, counts : (Int, Int), case_on~ : Bool = false) -> Unit {
  let field = ui::Field::new()
  field.set(query)
  // Stand in for the page pane: the find bar floats in the page card's top-right corner.
  let _ = root.box(fn(pane : view::View) -> Unit {
    let _ = pane
    .over_at(view::Live::By(fn() {
      let ww = root.window_w()
      let w = if ww > 0.0 { ww } else { 1280.0 }
      if w < shell_ui::SHELL_SIDEBAR_BREAKPOINT {
        (Some(shell_ui::SP_8), Some(shell_ui::SP_48), Some(shell_ui::SP_8), Some(shell_ui::SP_8))
      } else {
        (Some(shell_ui::shell_sidebar_width(w, true) + shell_ui::SP_8), Some(shell_ui::SP_8), Some(shell_ui::SP_8), Some(shell_ui::SP_8))
      }
    }))
    .points(view::Live::Is(false))
    shell_ui::build_find_bar_panel(
      pane,
      shell_ui::FindBarProps::{
        visible: fn() { true },
        dark: fn() { ctrl.model().dark() },
        field,
        case_sensitive: fn() { case_on },
        counts: fn() { counts },
        on_query_change: fn(_q) { () },
        on_prev: fn() { () },
        on_next: fn() { () },
        on_toggle_case: fn() { () },
        on_close: fn() { () },
      },
    )
  })
}

fn dl_mount_shortcuts(root : view::View) -> Unit {
  shell_ui::build_shortcuts_modal(
    root,
    shell_ui::ShortcutsModalProps::{
      open: fn() { true },
      groups: shell_ui::default_macos_shortcut_groups,
      on_close: fn() { () },
    },
  )
}

pub fn render_downloads_scenes(w : World, out_dir : String) -> Bool {
  let mut ok = true
  let themes : Array[(Bool, String)] = [(false, "light"), (true, "dark")]
  let mut i = 0
  while i < themes.length() {
    let (dark, tn) = themes[i]
    let items = dl_demo_items()
    // Downloads: the list (1280 + narrow 480), a search that matches nothing, and a first-run empty list.
    ok = render_scene(w, out_dir, "downloads-list-\{tn}.png", 1280.0, 800.0, fn(root, _c) {
      dl_mount_downloads(root, items, items.length())
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-list-\{tn}-480.png", 480.0, 800.0, fn(root, _c) {
      dl_mount_downloads(root, items, items.length())
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-filtered-\{tn}.png", 1280.0, 800.0, fn(root, _c) {
      dl_mount_downloads(root, [items[1]], items.length(), category="pdf")
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-nomatch-\{tn}.png", 1280.0, 800.0, fn(root, _c) {
      dl_mount_downloads(root, [], items.length(), query="keynote")
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-empty-\{tn}.png", 1280.0, 800.0, fn(root, _c) {
      dl_mount_downloads(root, [], 0)
    }, dark=dark) && ok
    // Keyboard Shortcuts: two columns at 1280, one column at 480.
    ok = render_scene(w, out_dir, "downloads-shortcuts-\{tn}.png", 1280.0, 800.0, fn(root, _c) { dl_mount_shortcuts(root) }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-shortcuts-\{tn}-480.png", 480.0, 800.0, fn(root, _c) { dl_mount_shortcuts(root) }, dark=dark) && ok
    // Find bar: a hit with Match Case on, a miss, and the narrow window.
    ok = render_scene(w, out_dir, "downloads-find-\{tn}.png", 1280.0, 800.0, fn(root, c) {
      dl_mount_find(root, c, "grid", (2, 14), case_on=true)
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-find-miss-\{tn}.png", 1280.0, 800.0, fn(root, c) {
      dl_mount_find(root, c, "subgird", (-1, 0))
    }, dark=dark) && ok
    ok = render_scene(w, out_dir, "downloads-find-\{tn}-480.png", 480.0, 800.0, fn(root, c) {
      dl_mount_find(root, c, "grid", (2, 14))
    }, dark=dark) && ok
    i += 1
  }
  ok
}
