///| unpack br|woff2 IN OUT: a brotli stream or a WOFF2 font made whole, for checking against reference tools.
///| 1:1 port of `src/cmd/unpack/main.mbt`.

import "brotli"
import "woff2"

fn main(w : World) -> Unit {
  let args = world_args(w)
  if args.length() < 4 {
    io_println(w, "usage: pion-unpack br|woff2 IN OUT")
    return
  }
  let data = match fs_read_bytes(w, args[2]) {
    Result::Ok(b) => b
    Result::Err(_) => {
      io_println(w, "read failed")
      return
    }
  }
  let res = if args[1] == "br" {
    brotli::decode(data)
  } else {
    woff2::decode(data)
  }
  match res {
    Result::Ok(out) => match fs_write_bytes(w, args[3], out) {
      Result::Ok(_) => ()
      Result::Err(_) => io_println(w, "write failed")
    }
    Result::Err(e) => io_println(w, "error: " + e)
  }
}
