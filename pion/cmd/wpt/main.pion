///| Runs a page with testharness.js and prints its results, then each expression given after it:
///| `pion-wpt <url> [expr...]`

import "page"
import "css"
import "fetch"

fn main(w : World) -> Unit {
  let started = fetch::now_us() / 1000L
  let a = world_args(w)
  if a.length() < 2 {
    io_println(w, "usage: pion-wpt <url> [expr...]")
    return
  }
  let vw = match env_get(w, "FV_WIDTH") {
    Option::Some(v) => {
      let d = css::parse_double(v)
      if d > 0.0 { d } else { 800.0 }
    }
    Option::None => 800.0
  }
  page::eager_pictures.v = true
  page::test_input.v = true
  let _ = page::load(a[1], vw, 600.0)
  page::tick(1000, net_wait=1000)
  let mut page_ms = 1000
  let mut waited = 0
  let mut turn = 0
  while turn < 300 {
    if page::eval("window.__wpt ? 1 : 0") == "1" || page_ms >= 20000 {
      break
    }
    if page::network_busy() && waited < 40 {
      page::tick(0, net_wait=250)
      waited += 1
    } else {
      page::tick(250, net_wait=250)
      page_ms += 250
      waited = 0
    }
    turn += 1
  }
  io_println(
    w,
    page::eval(
      "JSON.stringify(window.__wpt ? {pass: __wpt.filter(t => t.status === 0).length, total: __wpt.length, fails: __wpt.filter(t => t.status !== 0).slice(0, 3).map(t => t.name + ': ' + String(t.message).slice(0, 90))} : {none: 1})",
    ),
  )
  if env_get(w, "FV_STATS").is_some() {
    io_println(w, "layouts: \{page::layout_count()}")
  }
  let wait = match env_get(w, "FV_WAIT") {
    Option::Some(v) => css::parse_double(v).to_int()
    Option::None => 0
  }
  let mut i = 2
  while i < a.length() {
    if wait > 0 {
      page::tick(wait, net_wait=wait)
    }
    io_println(w, page::eval(a[i]))
    i += 1
  }
  if env_get(w, "FV_PROF").is_some() {
    let elapsed = fetch::now_us() / 1000L - started
    io_println(w, "time: wall \{elapsed} ms; " + page::time_spent())
    io_println(w, "ops: " + page::take_op_report())
    io_println(w, "mem: " + page::mem_report())
    io_println(w, "work: " + page::work_report())
  }
  if env_get(w, "FV_DEBUG_FRAMES").is_some() {
    for r in page::pending_requests() {
      io_println(w, "still out: " + r)
    }
  }
  let shown = if env_get(w, "FV_DEBUG_FRAMES").is_some() { 60 } else { 3 }
  let errs = page::errors()
  let mut ei = 0
  while ei < errs.length() && ei < shown {
    let e = errs[ei]
    let end_i = if e.length() > 200 { 200 } else { e.length() }
    io_println(w, e.slice(0, end_i))
    ei += 1
  }
}
