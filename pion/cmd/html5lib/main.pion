///| Runs html5lib's tree construction tests: each .dat file given, a line of what failed, and the totals.
///| 1:1 port of `src/cmd/html5lib/main.mbt`.

import "html"

extern "C" fn c_exit(code : Int) -> Unit = "exit"

struct Case {
  data : String
  fragment : Option[String]
  scripting : Option[Bool]
  expected : String
}

fn parse_cases(text : String) -> Array[Case] {
  let cases : Array[Case] = []
  let lines = text.split("\n")
  let mut i = 0
  while i < lines.length() {
    if lines[i] != "#data" {
      i = i + 1
      continue
    }
    i = i + 1
    let data : Array[String] = []
    while i < lines.length() && lines[i] != "#errors" {
      data.push(lines[i])
      i = i + 1
    }
    let mut fragment : Option[String] = Option::None
    let mut scripting : Option[Bool] = Option::None
    while i < lines.length() && lines[i] != "#document" {
      if lines[i] == "#document-fragment" && i + 1 < lines.length() {
        fragment = Option::Some(lines[i + 1])
      } else if lines[i] == "#script-on" {
        scripting = Option::Some(true)
      } else if lines[i] == "#script-off" {
        scripting = Option::Some(false)
      }
      i = i + 1
    }
    i = i + 1
    let out : Array[String] = []
    while i < lines.length() && lines[i] != "#data" {
      if lines[i] == "" && (i + 1 >= lines.length() || lines[i + 1] == "#data") {
        break
      }
      out.push(lines[i])
      i = i + 1
    }
    let expected = out.join("\n") + "\n"
    cases.push(Case::{ data: data.join("\n"), fragment, scripting, expected })
  }
  cases
}

fn run_case(c : Case, scripting : Bool) -> String {
  match c.fragment {
    Option::None => {
      let doc = html::parse_with_scripting(c.data, scripting)
      let res = html::dump(doc)
      html::cut(doc)
      res
    }
    Option::Some(ctx) => {
      let (ns, tag) = if ctx.starts_with("svg ") {
        (html::Ns::Svg, ctx.slice(4, ctx.length()))
      } else if ctx.starts_with("math ") {
        (html::Ns::MathMl, ctx.slice(5, ctx.length()))
      } else {
        (html::Ns::Html, ctx)
      }
      let node = html::Node::element(ns, tag, [])
      let frag = html::parse_fragment(c.data, node, scripting)
      let res = html::dump(frag)
      html::cut(frag)
      res
    }
  }
}

fn main(w : World) -> Unit {
  let args = world_args(w)
  let mut verbose = false
  let mut list_failures = false
  let mut ai = 1
  while ai < args.length() {
    if args[ai] == "-v" {
      verbose = true
    } else if args[ai] == "--list-failures" {
      list_failures = true
    }
    ai = ai + 1
  }
  let mut pass = 0
  let mut fail = 0
  let mut read_errors = 0
  let mut pi = 1
  while pi < args.length() {
    let path = args[pi]
    pi = pi + 1
    if path == "-v" || path == "--list-failures" {
      continue
    }
    let text = match fs_read(w, path) {
      Result::Ok(s) => s
      Result::Err(_) => {
        io_println(w, "read failed: " + path)
        read_errors = read_errors + 1
        continue
      }
    }
    let mut file_fail = 0
    let mut n = 0
    let cases = parse_cases(text)
    let mut ci = 0
    while ci < cases.length() {
      let case_idx = ci
      let c = cases[ci]
      ci = ci + 1
      let modes : Array[Bool] = [false, true]
      let mut mi = 0
      while mi < 2 {
        let scripting = modes[mi]
        mi = mi + 1
        let skip = match c.scripting {
          Option::Some(s) => s != scripting
          Option::None => false
        }
        if skip {
          continue
        }
        n = n + 1
        let got = run_case(c, scripting)
        if got == c.expected {
          pass = pass + 1
        } else {
          fail = fail + 1
          file_fail = file_fail + 1
          if list_failures || verbose {
            io_println(w, "FAIL_KEY " + path + "#" + case_idx.to_string() + " scripting=" + scripting.to_string())
          }
          if verbose {
            io_println(
              w,
              "FAIL " + path + " scripting=" + scripting.to_string() + "\n" + c.data + "\n--- want\n" + c.expected + "--- got\n" + got,
            )
          }
        }
      }
    }
    io_println(w, file_fail.to_string() + "/" + n.to_string() + " failed " + path)
  }
  io_println(w, "pass " + pass.to_string() + " fail " + fail.to_string())
  if read_errors > 0 || pass + fail == 0 {
    c_exit(1)
  }
}
