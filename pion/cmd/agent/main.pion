///| Standalone `pion-agent` CLI binary.
///| Drives a running Farview host over TCP (`<host> <port> [steps...]`).

import "agent_cli"

fn main(w : World) -> Unit {
  let a = world_args(w)
  if a.length() < 3 {
    io_println(w, "usage: pion-agent <host> <port> [steps...]")
    return
  }
  let host = a[1]
  let port = agent_cli::parse_port(a[2])
  let steps : Array[String] = []
  let mut i = 3
  while i < a.length() {
    steps.push(a[i])
    i = i + 1
  }
  let _ = agent_cli::run_agent(w, host, port, steps, true)
}
