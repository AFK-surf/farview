  debug_assert(saw_choose_multi, "input[type=file][multiple] must paint 'Choose Files' button label")
  html::cut(doc)
}

test "Batch 2: animated color on ancestor box propagates to inheriting TextRun, span, color:inherit, and later positioned descendants" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='rib' class='rib'>" +
    "<span id='sp'>Hello</span>" +
    "<a id='inh' style='color:inherit'>Inh</a>" +
    "<span id='rel' style='position:relative;z-index:1'>Rel</span>" +
    "<span id='exp' style='color:rgb(255,0,0)'>Red</span>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  e.add_sheet(".rib { color: rgb(245, 245, 247); animation-name: fade-col; }")
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  // Simulate doc/anim.pion post-layout b.set_style(style.with_value("color", ...))
  let rib_node = doc.children[1].children[1].children[0]
  let rib_box = match layout::box_of(root, rib_node) { Some(b) => b None => panic("rib") }
  let anim_toks = css::tokenize("rgb(29, 29, 31)")
  let clean_toks : Array[css::Tok] = []
  for t in anim_toks {
    if !(t is css::Tok::End) { clean_toks.push(t) }
  }
  rib_box.set_style(rib_box.style.with_value("color", clean_toks))
  let items = display_list(root, fonts)
  let dark = (29 << 24) | (29 << 16) | (31 << 8) | 255
  let red = (255 << 24) | (0 << 16) | (0 << 8) | 255
  let mut hello_col = 0
  let mut inh_col = 0
  let mut rel_col = 0
  let mut red_col = 0
  for it in items {
    match it {
      Item::Text(_, _, _, _, col, txt, _, _) => {
        if txt == "Hello" { hello_col = col }
        if txt == "Inh" { inh_col = col }
        if txt == "Rel" { rel_col = col }
        if txt == "Red" { red_col = col }
      }
      _ => ()
    }
  }
  debug_assert(hello_col == dark, "inheriting span text must receive animated color, got " + hello_col.to_string())
  debug_assert(inh_col == dark, "color:inherit descendant must receive animated color, got " + inh_col.to_string())
  debug_assert(rel_col == dark, "later positioned descendant must receive animated color, got " + rel_col.to_string())
  debug_assert(red_col == red, "explicit distinct color descendant must keep its own color, got " + red_col.to_string())
  html::cut(doc)
}

test "Batch 5: border-style dashed and dotted emit segmented rect ops instead of single solid bars" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='d' style='width:60px;height:20px;border:1px dashed rgb(56, 189, 248)'></div>" +
    "<div id='t' style='width:20px;height:20px;border:2px dotted rgb(10, 20, 30)'></div>" +
    "</body></html>",
  )
  let fonts = layout::Fonts::new_portable([], [])
  let eng = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, eng) { Some(b) => b None => panic("root") }
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let sky = (56 << 24) | (189 << 16) | (248 << 8) | 255
  let dot_col = (10 << 24) | (20 << 16) | (30 << 8) | 255
  let mut sky_rects = 0
  let mut dot_rects = 0
  for it in items {
    match it {
      Item::Rect(_, _, _, _, col) => {
        if col == sky { sky_rects += 1 }
        if col == dot_col { dot_rects += 1 }
      }
      _ => ()
    }
  }
  debug_assert(sky_rects > 12, "1px dashed 60x20 border must emit multiple dash segments, got " + sky_rects.to_string())
  debug_assert(dot_rects > 12, "2px dotted 20x20 border must emit multiple dot segments, got " + dot_rects.to_string())
  html::cut(doc)
}

test "Batch 6: partial-side border on rounded box clips to RoundClip and calc(1px * infinity) forms pill radii" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='callout' style='width:200px;height:60px;border-radius:4px;border-inline-start:2px solid #044c9f;background:#ecf4fe'></div>" +
    "<div id='pill' style='width:120px;height:40px;border-radius:calc(1px * infinity);background:#6364ff'></div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 200.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) { Some(b) => b None => panic("root") }
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let accent = (4 << 24) | (76 << 16) | (159 << 8) | 255
  let pill_col = (99 << 24) | (100 << 16) | (255 << 8) | 255
  let mut saw_callout_clip = false
  let mut saw_callout_left_rect = false
  let mut saw_bad_zero_top_round = false
  let mut saw_pill_round = false
  for it in items {
    match it {
      Item::RoundClip(_, _, w, h, r) => {
        if (w - 202.0).abs() < 1.0 && (h - 60.0).abs() < 1.0 && r.length() == 4 && (r[0] - 4.0).abs() < 0.1 {
          saw_callout_clip = true
        }
      }
      Item::Rect(_, _, w, h, col) => {
        if col == accent && (w - 2.0).abs() < 0.1 && (h - 60.0).abs() < 1.0 {
          saw_callout_left_rect = true
        }
      }
      Item::Round(_, _, _, _, r, bw, col) => {
        if col == accent && bw.length() == 4 && bw[0] == 0.0 {
          saw_bad_zero_top_round = true
        }
        if col == pill_col && bw.length() == 0 && r.length() == 4 && (r[0] - 20.0).abs() < 0.5 {
          saw_pill_round = true
        }
      }
      _ => ()
    }
  }
  debug_assert(!saw_bad_zero_top_round, "asymmetric border on rounded box must not emit Item::Round with top width 0")
  debug_assert(saw_callout_clip && saw_callout_left_rect, "rounded box with border-inline-start must emit RoundClip + left border Rect")
  debug_assert(saw_pill_round, "border-radius: calc(1px * infinity) on 120x40 box must clamp to 20px pill radius")
  html::cut(doc)
}

test "Batch 7: text-decoration-style dotted/dashed/double emits segmented rects and diagonal background-clip:text projects over ancestor box" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<abbr id='ab' title='Working Group' style='color:#112233;font-size:16px'>Working</abbr>" +
    "<span id='ds' style='color:#223344;font-size:16px;text-decoration:underline dashed'>DashedLine</span>" +
    "<span id='db' style='color:#334455;font-size:16px;text-decoration:underline double'>Double</span>" +
    "<h1 id='hero' style='margin:0;width:520px;font-size:64px;line-height:1;background:linear-gradient(to bottom right,#ffffff 30%,#ffffff80);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent'>Email for<br>developers</h1>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(600.0, 400.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) { Some(b) => b None => panic("root") }
  layout::layout_with_scrollbar(root, fonts, 600.0, 400.0, 0.0)
  let items = display_list(root, fonts)
  let ab_col = (0x11 << 24) | (0x22 << 16) | (0x33 << 8) | 255
  let ds_col = (0x22 << 24) | (0x33 << 16) | (0x44 << 8) | 255
  let db_col = (0x33 << 24) | (0x44 << 16) | (0x55 << 8) | 255
  let mut dot_rects = 0
  let mut dash_rects = 0
  let mut dbl_rects = 0
  let mut r_alpha = 0
  let mut s_alpha = 0
  for it in items {
    match it {
      Item::Rect(_, _, w, h, col) => {
        if col == ab_col && (h - 1.0).abs() < 0.01 && w <= 1.5 { dot_rects += 1 }
        if col == ds_col && (h - 1.0).abs() < 0.01 && w <= 4.5 { dash_rects += 1 }
        if col == db_col && (h - 1.0).abs() < 0.01 && w > 10.0 { dbl_rects += 1 }
      }
      Item::Text(_, _, _, _, rgba, txt, _, _) => {
        if txt == "r" && r_alpha == 0 { r_alpha = rgba & 0xFF }
        if txt == "s" { s_alpha = rgba & 0xFF }
      }
      _ => ()
    }
  }
  debug_assert(dot_rects >= 6, "abbr[title] dotted underline must emit multiple 1px dot rects, got " + dot_rects.to_string())
  debug_assert(dash_rects >= 4, "dashed underline must emit multiple dash rects, got " + dash_rects.to_string())
  debug_assert(dbl_rects == 2, "double underline must emit 2 parallel rects, got " + dbl_rects.to_string())
  debug_assert(r_alpha >= 200, "diagonal background-clip:text on 520px h1 must keep 'r' in 'Email for' bright (alpha>=200), got " + r_alpha.to_string())
  debug_assert(s_alpha > 0 && s_alpha < r_alpha - 20, "diagonal background-clip:text must fade smoothly toward bottom-right 's' (" + s_alpha.to_string() + " < " + r_alpha.to_string() + ")")
  html::cut(doc)
}

test "Batch 8: spatial radial/linear gradient mask-image emits inverted-alpha overlay and rounded object-fit:cover img skips redundant rect Clip" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;background:#08090a'>" +
    "<div id='vig' style='position:relative;width:400px;height:200px;mask-image:radial-gradient(50% 50%, rgb(0,0,0) 20%, rgba(0,0,0,0) 100%)'>" +
    "<div style='width:100px;height:100px;background:#333333'></div>" +
    "</div>" +
    "<div id='ytwrap' style='background:#ffffff;width:600px;height:20px'>" +
    "<div id='ytmask' style='width:600px;height:20px;overflow:hidden;mask-image:linear-gradient(to top, rgba(0,0,0,0) 0%, rgba(0,0,0,0) 20px, rgb(0,0,0) 20px, rgb(0,0,0) 100%), linear-gradient(to right, rgb(0,0,0) 0px, rgb(0,0,0) 484px, rgba(0,0,0,0) 554px)'>" +
    "<span style='color:#111111'>Welcome to Google for Developers</span>" +
    "</div></div>" +
    "<img id='av' src='a.png' width='600' height='400' style='display:block;width:80px;height:80px;object-fit:cover;border-radius:calc(1px * infinity)'>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(800.0, 600.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) { Some(b) => b None => panic("root") }
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let items = display_list(root, fonts)
  let mut child_idx = -1
  let mut radial_idx = -1
  let mut linear_mask_ok = false
  let mut saw_av_rclip = false
  let mut saw_av_rect_clip = false
  for i, it in items {
    match it {
      Item::Rect(_, _, w, h, col) if (w - 100.0).abs() < 0.5 && (h - 100.0).abs() < 0.5 && ((col >> 8) & 0xFFFFFF) == 0x333333 =>
      child_idx = i
      Item::Gradient(_, _, w, h, kind, _, _, cols) if kind == 1 && (w - 400.0).abs() < 0.5 && (h - 200.0).abs() < 0.5 && cols.length() >= 2 =>
      if ((cols[0] >> 8) & 0xFFFFFF) == 0x08090A && (cols[0] & 0xFF) == 0 && (cols[cols.length() - 1] & 0xFF) == 255 {
        radial_idx = i
      }
      Item::Gradient(_, _, w, h, kind, _, _, cols) if kind == 0 && (w - 600.0).abs() < 0.5 && (h - 20.0).abs() < 0.5 && cols.length() >= 2 =>
      if ((cols[0] >> 8) & 0xFFFFFF) == 0xFFFFFF && (cols[0] & 0xFF) == 0 && (cols[cols.length() - 1] & 0xFF) == 255 {
        linear_mask_ok = true
      }
      Item::RoundClip(_, _, w, h, r) if (w - 80.0).abs() < 0.5 && (h - 80.0).abs() < 0.5 && r.length() >= 4 && (r[0] - 40.0).abs() < 0.5 =>
      saw_av_rclip = true
      Item::Clip(_, _, w, h) if (w - 80.0).abs() < 0.5 && (h - 80.0).abs() < 0.5 =>
      saw_av_rect_clip = true
      _ => ()
    }
  }
  debug_assert(child_idx >= 0 && radial_idx > child_idx, "radial-gradient mask-image must emit inverted-alpha overlay after masked children")
  debug_assert(linear_mask_ok, "multi-layer linear-gradient mask-image must emit active horizontal fade overlay in ancestor white")
  debug_assert(saw_av_rclip && !saw_av_rect_clip, "rounded object-fit:cover img with zero padding must emit RoundClip without redundant inner rect Clip")
  html::cut(doc)
}

///|
test "Wave 2: KeptCache hits inside transform:translate + iframe + position:relative non-SC containers without double-shift" {
  let main_doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='transform:translate(30px, 40px)'>" +
    "<div style='margin-left:50px;margin-top:60px'><iframe style='width:200px;height:120px;border:0'></iframe></div>" +
    "</div></body></html>",
  )
  let sub_doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='position:relative;width:100px;height:40px;background:#112233'>" +
    "<div style='width:40px;height:20px;background:#ff0000'></div>" +
    "</div></body></html>",
  )
  let e_main = css::Engine::new(css::Env::new(400.0, 300.0))
  let e_sub = css::Engine::new(css::Env::new(200.0, 120.0))
  let root = match layout::generate(main_doc, e_main) { Some(b) => b None => panic("root") }
  let sub = match layout::generate(sub_doc, e_sub) { Some(b) => b None => panic("sub") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  layout::layout_with_scrollbar(sub, fonts, 200.0, 120.0, 0.0)
  let mut iframe_lid = -1
  let stack = [root]
  while stack.pop() is Some(b) {
    match b.node {
      Some(n) if n.tag == "iframe" => iframe_lid = n.layout_id
      _ => ()
    }
    for ch in b.children { stack.push(ch) }
  }
  debug_assert(iframe_lid >= 0, "iframe layout_id found")
  let frames : intmap::IntMap[layout::Box] = intmap::IntMap::new()
  frames.set(iframe_lid, sub)
  let kc = KeptCache::new()
  // Frame 1: populate KeptCache
  kc.items_buf.clear()
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], frames, false, Some(kc), kc.items_buf, defer_arena_swap=true)
  let mut x1 = -1.0
  let mut y1 = -1.0
  for it in kc.items_buf {
    match it {
      Item::Rect(rx, ry, rw, rh, col) if col == 0xFF0000FF && rw == 40.0 && rh == 20.0 => { x1 = rx; y1 = ry }
      _ => ()
    }
  }
  kc.commit_items()
  // Frame 2: must hit KeptCache inside transform:translate + iframe + position:relative AND preserve exact (80, 100)
  let hits0 = paint_counts[1]
  kc.items_buf.clear()
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], frames, false, Some(kc), kc.items_buf, defer_arena_swap=true)
  let hits_delta = paint_counts[1] - hits0
  let mut x2 = -1.0
  let mut y2 = -1.0
  for it in kc.items_buf {
    match it {
      Item::Rect(rx, ry, rw, rh, col) if col == 0xFF0000FF && rw == 40.0 && rh == 20.0 => { x2 = rx; y2 = ry }
      _ => ()
    }
  }
  debug_assert(hits_delta >= 1, "Frame 2 must hit KeptCache inside transform:translate + iframe + position:relative, got hits=" + hits_delta.to_string())
  debug_assert(x1 == 80.0 && y1 == 100.0, "Frame 1 red rect at (80,100), got (" + x1.to_string() + "," + y1.to_string() + ")")
  debug_assert(x2 == 80.0 && y2 == 100.0, "Frame 2 red rect must stay at (80,100) without double-shift, got (" + x2.to_string() + "," + y2.to_string() + ")")
  html::cut(sub_doc)
  html::cut(main_doc)
}

test "non-uniform 4-side solid rounded borders emit Item::Round with per-side widths" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='yt' style='width:300px;height:40px;box-sizing:border-box;border:1px solid #cccccc;border-right:none;border-radius:40px 0 0 40px'></div>" +
    "<div id='gh' style='width:120px;height:32px;box-sizing:border-box;border:1px solid #d0d7de;border-left:none;border-radius:0 6px 6px 0'></div>" +
    "<div id='asym' style='width:100px;height:36px;box-sizing:border-box;border:1px solid #333333;border-bottom-width:3px;border-radius:8px'></div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(500.0, 300.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) { Some(b) => b None => panic("root") }
  layout::layout_with_scrollbar(root, fonts, 500.0, 300.0, 0.0)
  let items = display_list(root, fonts)
  let yt_col = (0xCC << 24) | (0xCC << 16) | (0xCC << 8) | 255
  let gh_col = (0xD0 << 24) | (0xD7 << 16) | (0xDE << 8) | 255
  let asym_col = (0x33 << 24) | (0x33 << 16) | (0x33 << 8) | 255
  let mut saw_yt = false
  let mut saw_gh = false
  let mut saw_asym = false
  for it in items {
    match it {
      Item::Round(_, _, _, _, r, bw, col) if bw.length() == 4 => {
        if col == yt_col && (bw[0] - 1.0).abs() < 0.01 && bw[1] == 0.0 && (bw[2] - 1.0).abs() < 0.01 && (bw[3] - 1.0).abs() < 0.01 &&
        r.length() == 4 && (r[0] - 20.0).abs() < 0.1 && r[1] == 0.0 && r[2] == 0.0 && (r[3] - 20.0).abs() < 0.1 {
          saw_yt = true
        }
        if col == gh_col && (bw[0] - 1.0).abs() < 0.01 && (bw[1] - 1.0).abs() < 0.01 && (bw[2] - 1.0).abs() < 0.01 && bw[3] == 0.0 &&
        r.length() == 4 && r[0] == 0.0 && (r[1] - 6.0).abs() < 0.1 && (r[2] - 6.0).abs() < 0.1 && r[3] == 0.0 {
          saw_gh = true
        }
        if col == asym_col && (bw[0] - 1.0).abs() < 0.01 && (bw[1] - 1.0).abs() < 0.01 && (bw[2] - 3.0).abs() < 0.01 && (bw[3] - 1.0).abs() < 0.01 &&
        r.length() == 4 && (r[0] - 8.0).abs() < 0.1 {
          saw_asym = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_yt, "YouTube-style border-right:none + border-radius:40px 0 0 40px must emit Item::Round with ring [1,0,1,1]")
  debug_assert(saw_gh, "GitHub-style border-left:none + border-radius:0 6px 6px 0 must emit Item::Round with ring [1,1,1,0]")
  debug_assert(saw_asym, "asymmetric-width solid rounded border must emit Item::Round with ring [1,1,3,1]")
  html::cut(doc)
}

test "Batch 13: W3C CSS Masking 1 §7.1/§7.4 non-none mask-image creates stacking context and clips abs children to mask-clip" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<div id='masked'><div id='abs'></div></div>" +
    "<div id='noclip'></div>" +
    "</body></html>",
  )
  let engine = css::Engine::new(css::Env::new(400.0, 200.0))
  engine.add_sheet(
    "body { margin: 0; }" +
    "#masked { display: inline-block; position: relative; width: 120px; height: 20px; mask-image: linear-gradient(180deg, #000, #fff 20%, #fff 80%, #000); }" +
    "#abs { position: absolute; left: 0; top: 100%; width: 120px; height: 20px; background: #ff0000; }" +
    "#noclip { display: block; width: 80px; height: 20px; mask-image: linear-gradient(180deg, #000, #fff); mask-clip: no-clip; }",
  )
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, engine) {
    Some(r) => r
    None => {
      debug_assert(false, "layout root missing")
      return
    }
  }
  layout::layout(root, fonts, 400.0, 200.0)
  let mut b_masked : Option[layout::Box] = None
  let stack = [root]
  while stack.pop() is Some(b) {
    match b.node {
      Some(n) if n.attr("id").unwrap_or("") == "masked" => b_masked = Some(b)
      _ => ()
    }
    for ch in b.children { stack.push(ch) }
  }
  match b_masked {
    Some(bm) => debug_assert(creates_stacking_context(bm), "non-none mask-image must establish a stacking context")
    None => debug_assert(false, "#masked box missing")
  }
  let ops = display_list_full(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, None)
  let mut clip_depth = 0
  let mut saw_clipped_abs_red = false
  let mut saw_noclip_clip = false
  for op in ops {
    match op {
      Item::Clip(_, _, cw, ch) => {
        clip_depth += 1
        if (cw - 80.0).abs() < 0.5 && (ch - 20.0).abs() < 0.5 {
          saw_noclip_clip = true
        }
      }
      Item::RoundClip(_, _, _, _, _) => clip_depth += 1
      Item::Unclip => clip_depth -= 1
      Item::Rect(_, ry, rw, rh, col) => {
        if col == 0xFF0000FF && (ry - 20.0).abs() < 0.5 && (rw - 120.0).abs() < 0.5 && (rh - 20.0).abs() < 0.5 && clip_depth > 0 {
          saw_clipped_abs_red = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_clipped_abs_red, "position:absolute;top:100% child inside mask-image box must be clipped to border-box")
  debug_assert(!saw_noclip_clip, "mask-clip:no-clip must not emit a mask clip")
  html::cut(doc)
}

///|
test "Batch 14: W3C CSS Masking 1 §7.3 leaf transparent radial-gradient mask overlay skips opaque backdrop veil and attenuates localized spotlight" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;background:#08090a'>" +
    "<div id='frame' style='position:relative;width:1320px;height:720px;background:#090a0b'>" +
    "<div id='content' style='width:600px;height:200px;color:#d0d6e0'>Faster app launch</div>" +
    "<div id='shine' style='position:absolute;inset:0;border:1px solid rgba(255,255,255,0.25);mask-image:radial-gradient(200px 200px at 8% 0%, rgb(0,0,0) 0%, rgba(0,0,0,0.6) 30%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 70%)'></div>" +
    "</div></body></html>",
  )
  let engine = css::Engine::new(css::Env::new(1320.0, 800.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, engine) {
    Some(r) => r
    None => panic("root")
  }
  layout::layout_with_scrollbar(root, fonts, 1320.0, 800.0, 0.0)
  let mut b_shine : Option[layout::Box] = None
  let stack = [root]
  while stack.pop() is Some(b) {
    match b.node {
      Some(n) if n.attr("id").unwrap_or("") == "shine" => b_shine = Some(b)
      _ => ()
    }
    for ch in b.children { stack.push(ch) }
  }
  match b_shine {
    Some(bs) => {
      let ma = box_mask_alpha(bs)
      debug_assert(ma > 0.05 && ma < 0.25, "localized 200px radial spotlight on 1320x720 leaf border overlay must attenuate alpha, got " + ma.to_string())
      debug_assert(!has_mask_gradient_overlay(bs), "leaf transparent-background border overlay must not emit opaque ancestor_opaque_bg gradient veil")
    }
    None => debug_assert(false, "#shine box missing")
  }
  let ops = display_list(root, fonts)
  let mut saw_blackout_grad = false
  for op in ops {
    match op {
      Item::Gradient(_, _, gw, gh, kind, _, _, _) if kind == 1 && (gw - 1320.0).abs() < 1.0 && (gh - 720.0).abs() < 1.0 =>
      saw_blackout_grad = true
      _ => ()
    }
  }
  debug_assert(!saw_blackout_grad, "leaf transparent radial-gradient mask overlay must not emit full-box blackout gradient over siblings")
  html::cut(doc)
}

test "Batch 15: CSS Compositing 1 + Masking 1 §7.3 ancestor_opaque_bg composites translucent ancestors via source-over" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;background:#ffffff'>" +
    "<div id='card' style='width:400px;height:60px;background:rgba(0,0,0,0.05)'>" +
    "<div id='masked' style='width:400px;height:20px;mask-image:linear-gradient(90deg, rgb(0,0,0) 90%, rgba(0,0,0,0))'>23M views 12y ago</div>" +
    "</div>" +
    "<div style='width:400px;height:60px;background:#102030'>" +
    "<div style='width:400px;height:60px;background:rgba(255,255,255,0.2)'>" +
    "<div id='glass_masked' style='width:400px;height:20px;mask-image:linear-gradient(90deg, rgb(0,0,0) 85%, rgba(0,0,0,0))'>Glass row</div>" +
    "</div></div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(800.0, 400.0))
  let root = match layout::generate(doc, eng) { Some(r) => r None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout(root, fonts, 800.0, 400.0)
  let mut b_masked : Option[layout::Box] = None
  let mut b_glass : Option[layout::Box] = None
  let stack = [root]
  while stack.pop() is Some(b) {
    match b.node {
      Some(n) => {
        let id = n.attr("id").unwrap_or("")
        if id == "masked" { b_masked = Some(b) }
        else if id == "glass_masked" { b_glass = Some(b) }
      }
      None => ()
    }
    for ch in b.children { stack.push(ch) }
  }
  let fallback = css::Color::{ r: 255, g: 255, b: 255, a: 1.0 }
  match b_masked {
    Some(bm) => {
      let bg = ancestor_opaque_bg(bm, fallback)
      // rgba(0,0,0,0.05) over #ffffff => round(255 * 0.95) = 242 (#f2f2f2)
      debug_assert(bg.r == 242 && bg.g == 242 && bg.b == 242, "rgba(0,0,0,0.05) over #ffffff must composite to rgb(242,242,242), got (" + bg.r.to_string() + "," + bg.g.to_string() + "," + bg.b.to_string() + ")")
    }
    None => debug_assert(false, "#masked box missing")
  }
  match b_glass {
    Some(bg_box) => {
      let bg = ancestor_opaque_bg(bg_box, fallback)
      // rgba(255,255,255,0.2) over #102030 (16,32,48) => (64,77,89)
      debug_assert(
        (bg.r - 64).abs() <= 1 && (bg.g - 77).abs() <= 1 && (bg.b - 89).abs() <= 1,
        "rgba(255,255,255,0.2) over #102030 must composite to ~(64,77,89), got (" + bg.r.to_string() + "," + bg.g.to_string() + "," + bg.b.to_string() + ")",
      )
    }
    None => debug_assert(false, "#glass_masked box missing")
  }
  html::cut(doc)
}

test "Batch 16: CSS Images 4 + Syntax 3 minified gradient stops without whitespace after color-mix() or var()" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='hero'></div>" +
    "</body></html>",
  )
  let css_src =
  "#hero{--poster-bg:#f46a25;--poster-shade:color-mix(in oklab,var(--poster-bg)72%,#b33200);" +
  "width:600px;height:400px;" +
  "background:radial-gradient(80% 60% at 100% 0%,#ffffff1f 0%,transparent 70%)," +
  "linear-gradient(150deg,color-mix(in oklab,var(--poster-bg)90%,#fff)0%,var(--poster-bg)50%,var(--poster-shade)100%)}"
  let eng = css::Engine::new(css::Env::new(800.0, 600.0))
  eng.add_sheet(css_src)
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) {
    Some(r) => r
    None => { debug_assert(false, "layout root missing"); return }
  }
  layout::layout(root, fonts, 800.0, 600.0)
  let ops = display_list(root, fonts)
  let mut saw_linear = false
  let mut saw_radial = false
  for op in ops {
    match op {
      Item::Gradient(_, _, gw, gh, kind, _, offs, cols) if (gw - 600.0).abs() < 1.0 && (gh - 400.0).abs() < 1.0 && cols.length() >= 2 => {
        if kind == 0 && offs.length() >= 3 {
          // Verify orange stop (#f46a25 -> R > 200) is present
          let mid_r = (cols[1] >> 24) & 0xFF
          if mid_r > 200 { saw_linear = true }
        } else if kind == 1 {
          saw_radial = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_linear, "minified linear-gradient with color-mix(...)0% and var(...)50% must emit Item::Gradient")
  debug_assert(saw_radial, "radial-gradient layer in multi-layer background must emit Item::Gradient")
  html::cut(doc)
}

test "Batch 17: CSS Masking 1 §7.9 multi-layer mask-image with mask-composite:intersect emits all fade overlays" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;background:#ffffff'>" +
    "<div id='inter' style='width:300px;height:200px;" +
    "mask-image:linear-gradient(to bottom,black 50%,transparent 100%),linear-gradient(to right,transparent,black 10%,black 90%,transparent);" +
    "mask-composite:intersect'><div style='width:300px;height:200px;background:#112233'></div></div>" +
    "<div id='add' style='width:300px;height:200px;" +
    "mask-image:linear-gradient(to bottom,black 50%,transparent 100%),linear-gradient(to right,transparent,black 10%,black 90%,transparent);" +
    "mask-composite:add'><div style='width:300px;height:200px;background:#112233'></div></div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 500.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) {
    Some(r) => r
    None => { debug_assert(false, "layout root missing"); return }
  }
  layout::layout(root, fonts, 400.0, 500.0)
  let ops = display_list(root, fonts)
  let mut inter_grads = 0
  let mut add_grads = 0
  for op in ops {
    match op {
      Item::Gradient(_, gy, gw, gh, kind, _, _, _) if kind == 0 && (gw - 300.0).abs() < 1.0 && (gh - 200.0).abs() < 1.0 => {
        if gy.abs() < 1.0 {
          inter_grads += 1
        } else if (gy - 200.0).abs() < 1.0 {
          add_grads += 1
        }
      }
      _ => ()
    }
  }
  debug_assert(inter_grads == 2, "mask-composite:intersect with 2 gradient mask layers must emit 2 inverted-alpha overlays, got " + inter_grads.to_string())
  debug_assert(add_grads == 1, "mask-composite:add preserves single primary gradient overlay, got " + add_grads.to_string())
  html::cut(doc)
}

test "Batch 20: CSS Grid 2 §2 grid-template-rows: subgrid inherits parent row track sizes and row-gap" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='outer' style='display:grid;width:200px;grid-template-rows:40px 70px 30px;row-gap:10px'>" +
    "<div id='sub' style='display:grid;grid-row:1 / span 3;grid-template-rows:subgrid'>" +
    "<div id='r1' style='background:#f00'></div>" +
    "<div id='r2' style='background:#0f0'></div>" +
    "<div id='r3' style='background:#00f'></div>" +
    "</div></div></body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 400.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) {
    Some(r) => r
    None => { debug_assert(false, "layout root missing"); return }
  }
  layout::layout(root, fonts, 400.0, 400.0)
  let ops = display_list(root, fonts)
  let mut r1_y = -1.0
  let mut r1_h = -1.0
  let mut r2_y = -1.0
  let mut r2_h = -1.0
  let mut r3_y = -1.0
  let mut r3_h = -1.0
  for op in ops {
    match op {
      Item::Rect(_, y, _, h, c) =>
      if c == 0xFF0000FF {
        r1_y = y; r1_h = h
      } else if c == 0x00FF00FF {
        r2_y = y; r2_h = h
      } else if c == 0x0000FFFF {
        r3_y = y; r3_h = h
      }
      _ => ()
    }
  }
  debug_assert((r1_y - 0.0).abs() < 1.0 && (r1_h - 40.0).abs() < 1.0, "subgrid row 1 must be y=0 h=40, got y=" + r1_y.to_string() + " h=" + r1_h.to_string())
  debug_assert((r2_y - 50.0).abs() < 1.0 && (r2_h - 70.0).abs() < 1.0, "subgrid row 2 must be y=50 h=70 (40+10 gap), got y=" + r2_y.to_string() + " h=" + r2_h.to_string())
  debug_assert((r3_y - 130.0).abs() < 1.0 && (r3_h - 30.0).abs() < 1.0, "subgrid row 3 must be y=130 h=30 (40+10+70+10), got y=" + r3_y.to_string() + " h=" + r3_h.to_string())
  html::cut(doc)
}

test "Batch 20: CSS Images 4 gradient interpolation in oklab resolves currentColor stops instead of dropping intermediate samples" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:200px;height:40px;color:rgb(255, 0, 0);background-image:linear-gradient(to right in oklab, currentColor, rgb(0, 0, 255))'></div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 200.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) {
    Some(r) => r
    None => { debug_assert(false, "layout root missing"); return }
  }
  layout::layout(root, fonts, 400.0, 200.0)
  let ops = display_list(root, fonts)
  let mut stop_count = 0
  for op in ops {
    match op {
      Item::Gradient(_, _, gw, _, kind, _, offs, _) if kind == 0 && (gw - 200.0).abs() < 1.0 =>
      stop_count = offs.length()
      _ => ()
    }
  }
  debug_assert(stop_count >= 9, "in oklab gradient with currentColor must emit interpolated intermediate stops (>=9), got " + stop_count.to_string())
  html::cut(doc)
}

test "Batch 20: CSS Shapes 1 clip-path inset() round with slash vertical radii does not overwrite corner radii" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:200px;height:100px;background:#336699;clip-path:inset(4px 6px round 8px 12px / 20px 24px)'></div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 200.0))
  let fonts = layout::Fonts::new_portable([], [])
  let root = match layout::generate(doc, eng) {
    Some(r) => r
    None => { debug_assert(false, "layout root missing"); return }
  }
  layout::layout(root, fonts, 400.0, 200.0)
  let ops = display_list(root, fonts)
  let mut found = false
  for op in ops {
    match op {
      Item::RoundClip(cx, cy, cw, ch, rads) => {
        found = true
        debug_assert((cx - 6.0).abs() < 0.5 && (cy - 4.0).abs() < 0.5 && (cw - 188.0).abs() < 0.5 && (ch - 92.0).abs() < 0.5, "inset rect mismatch")
        debug_assert(
          (rads[0] - 8.0).abs() < 0.5 && (rads[1] - 12.0).abs() < 0.5 && (rads[2] - 8.0).abs() < 0.5 && (rads[3] - 12.0).abs() < 0.5,
          "round 8px 12px / 20px 24px must preserve horizontal corner radii [8,12,8,12], got [" +
          rads[0].to_string() + "," + rads[1].to_string() + "," + rads[2].to_string() + "," + rads[3].to_string() + "]",
        )
      }
      _ => ()
    }
  }
  debug_assert(found, "clip-path: inset(... round ...) must emit Item::RoundClip")
  html::cut(doc)
}
