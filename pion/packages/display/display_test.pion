///| Unit tests for `pion/packages/display` (list markers, background-image sizing, object-fit).

fn build_ops(markup : String) -> Array[Item] {
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  display_list(root, fonts)
}

test "display: ul/ol list markers emit disc, circle, square, decimal, alpha, roman and skip none/hidden" {
  let markup = "<!doctype html><html><body>" +
  "<ul><li>One</li></ul>" +
  "<ul style=\"list-style-type:circle\"><li>Two</li></ul>" +
  "<ul style=\"list-style-type:square\"><li>Three</li></ul>" +
  "<ol start=\"5\"><li>Five</li><li value=\"9\">Nine</li><li>Ten</li></ol>" +
  "<ol style=\"list-style-type:lower-alpha\"><li>Alpha</li><li>Beta</li></ol>" +
  "<ol style=\"list-style-type:upper-roman\"><li>R1</li><li>R2</li><li>R3</li><li>R4</li></ol>" +
  "<ul style=\"list-style:none\"><li>NoMarker</li></ul>" +
  "<ul style=\"visibility:hidden\"><li>Hidden</li></ul>" +
  "</body></html>"
  let ops = build_ops(markup)
  let mut filled_rounds = 0
  let mut ring_rounds = 0
  let mut small_squares = 0
  let marker_texts : Array[String] = []
  for op in ops {
    match op {
      Item::Round(_x, _y, w, h, _r, ring, _col) if w > 2.0 && w < 12.0 && (w - h).abs() < 0.01 =>
      if ring.length() == 0 {
        filled_rounds += 1
      } else {
        ring_rounds += 1
      }
      Item::Rect(_x, _y, w, h, _col) if w > 2.0 && w < 12.0 && (w - h).abs() < 0.01 =>
      small_squares += 1
      Item::Text(_f, _sz, _x, _y, _col, t, _l, _w) =>
      if t == "5." || t == "9." || t == "10." || t == "a." || t == "b." || t == "I." || t == "IV." {
        marker_texts.push(t)
      }
      _ => ()
    }
  }
  debug_assert(filled_rounds == 1, "expected 1 disc marker, got " + filled_rounds.to_string())
  debug_assert(ring_rounds == 1, "expected 1 circle marker, got " + ring_rounds.to_string())
  debug_assert(small_squares == 1, "expected 1 square marker, got " + small_squares.to_string())
  debug_assert(marker_texts.length() == 7, "expected 7 decimal/alpha/roman markers, got " + marker_texts.length().to_string())
}

test "display: list markers only draw for display: list-item (not inline/flex/grid/block/all:unset)" {
  let markup = "<!doctype html><html><body>" +
  "<ul class=\"nav\"><li class=\"u\">Unset</li><li class=\"i\">Inline</li><li class=\"ib\">IB</li><li class=\"f\">Flex</li><li class=\"b\">Block</li></ul>" +
  "<ul class=\"keep\"><li>Kept</li></ul>" +
  "</body></html>"
  let css_src = "body{margin:0} .nav{display:flex;gap:8px} .u{all:unset} .i{display:inline} .ib{display:inline-block} .f{display:flex} .b{display:block}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut discs = 0
  for op in ops {
    match op {
      Item::Round(_x, _y, w, h, _rad, bw, _col) if w > 2.0 && w < 12.0 && (w - h).abs() < 0.01 && bw.length() == 0 =>
      discs += 1
      _ => ()
    }
  }
  debug_assert(discs == 1, "only the default display:list-item <li> should draw a disc marker, got " + discs.to_string())
}

test "display: background-image viewBox-only SVG fits box and supports 2-value background-size" {
  let markup = "<!doctype html><html><body><div id=\"a\"></div><div id=\"b\"></div><div id=\"c\"></div></body></html>"
  let css_src = "body{margin:0}" +
  "#a{width:257px;height:90px;background-image:url(https://ziglang.org/zig-logo-dark.svg);background-repeat:no-repeat}" +
  "#b{width:200px;height:100px;background-image:url(https://example.test/pic.png);background-repeat:no-repeat;background-size:100% 50px}" +
  "#c{width:200px;height:100px;background-image:url(https://example.test/pic.png);background-repeat:no-repeat;background-size:auto 40px}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let sizes : Map[String, (Double, Double)] = Map::new()
  // Negative size encodes viewBox-only SVG (ratio-only, no intrinsic width/height)
  sizes.set("https://ziglang.org/zig-logo-dark.svg", (-400.0, -140.0))
  sizes.set("https://example.test/pic.png", (100.0, 50.0))
  let ops = display_list_full(root, fonts, sizes, fn(_) { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, None)
  let mut saw_a = false
  let mut saw_b = false
  let mut saw_c = false
  for op in ops {
    match op {
      Item::Image(_x, _y, iw, ih, u, _) =>
      if u == "https://ziglang.org/zig-logo-dark.svg" && (iw - 257.0).abs() < 0.5 && (ih - 89.95).abs() < 0.5 {
        saw_a = true
      } else if u == "https://example.test/pic.png" && (iw - 200.0).abs() < 0.5 && (ih - 50.0).abs() < 0.5 {
        saw_b = true
      } else if u == "https://example.test/pic.png" && (iw - 80.0).abs() < 0.5 && (ih - 40.0).abs() < 0.5 {
        saw_c = true
      }
      _ => ()
    }
  }
  debug_assert(saw_a, "viewBox-only SVG background-image should scale to 257x89.95 inside 257x90 box")
  debug_assert(saw_b, "2-value background-size: 100% 50px should produce 200x50")
  debug_assert(saw_c, "2-value background-size: auto 40px should preserve 2:1 ratio -> 80x40")
}

test "display: img object-fit cover/contain/none/scale-down and object-position" {
  let markup = "<!doctype html><html><body>" +
  "<img id=\"gopher\" src=\"https://go.dev/images/gophers/ladder.svg\">" +
  "<img id=\"logo\" src=\"https://example.test/square.png\">" +
  "</body></html>"
  let css_src = "body{margin:0}" +
  "#gopher{display:block;width:184px;height:368px;object-fit:cover;object-position:100% 0}" +
  "#logo{display:block;width:200px;height:100px;object-fit:contain}"
  let doc = html::parse(markup)
  let walk = [doc]
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "img" {
      match n.attr("id") {
        Some("gopher") => {
          n.src_url = Some("https://go.dev/images/gophers/ladder.svg")
          n.natural = Some((183.0, 572.0))
        }
        Some("logo") => {
          n.src_url = Some("https://example.test/square.png")
          n.natural = Some((100.0, 100.0))
        }
        _ => ()
      }
    }
    for ch in n.children { walk.push(ch) }
  }
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_gopher = false
  let mut saw_logo = false
  for op in ops {
    match op {
      Item::Image(x, y, iw, ih, u, _) =>
      if u == "https://go.dev/images/gophers/ladder.svg" {
        if x.abs() < 0.5 && y.abs() < 0.5 && (iw - 184.0).abs() < 0.5 && (ih - 575.125).abs() < 1.0 {
          saw_gopher = true
        }
      } else if u == "https://example.test/square.png" {
        if (x - 50.0).abs() < 0.5 && (iw - 100.0).abs() < 0.5 && (ih - 100.0).abs() < 0.5 {
          saw_logo = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_gopher, "object-fit: cover + object-position: 100% 0 should draw 184x575.125 at y=0 (clipped)")
  debug_assert(saw_logo, "object-fit: contain should center 100x100 at x=50 inside 200x100")
}

test "display: Tailwind v4 minified scale: var(--x)var(--y) with percentage emits horizontal flip Transform" {
  let markup = "<!doctype html><html><body><div id=\"arrow\" class=\"flip\"></div></body></html>"
  let css_src = "body{margin:0}:root{--tw-scale-x:1;--tw-scale-y:1}" +
  ".flip{width:24px;height:24px;background:#fff;--tw-scale-x: -100% ;scale:var(--tw-scale-x)var(--tw-scale-y)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_flip = false
  for op in ops {
    match op {
      Item::Transform(_ox, _oy, a, b, c, d, _e, _f) =>
      if (a + 1.0).abs() < 1.0e-6 && b.abs() < 1.0e-6 && c.abs() < 1.0e-6 && (d - 1.0).abs() < 1.0e-6 {
        saw_flip = true
      }
      _ => ()
    }
  }
  debug_assert(saw_flip, "scale: var(--tw-scale-x)var(--tw-scale-y) with -100% and 1 must emit scaleX(-1) Transform")
}

test "display: background-clip text with color transparent uses gradient ink instead of invisible text" {
  let markup = "<!doctype html><html><body><span class=\"grad\">Get Started</span></body></html>"
  let css_src = "body{margin:0}.grad{display:inline-block;background-clip:text;-webkit-background-clip:text;color:transparent;background-image:linear-gradient(90deg,#3245ff,#bc52ee)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let visible_text = StringBuilder::new()
  for op in ops {
    match op {
      Item::Text(_f, _sz, _x, _y, col, t, _l, _w) =>
      if (col & 0xFF) > 200 {
        visible_text.write_string(t)
      }
      _ => ()
    }
  }
  debug_assert(visible_text.to_string().contains("Get"), "background-clip: text with transparent color must draw visible gradient ink")
}

test "display: mask shorthand with var() emits Item::Mask instead of solid Rect" {
  let markup = "<!doctype html><html><body><span class=\"ico\"></span></body></html>"
  let css_src = "body{margin:0}.ico{display:inline-block;width:16px;height:16px;color:#ffffff;--icon:url(\"data:image/svg+xml,%3Csvg/%3E\");mask:var(--icon) no-repeat;-webkit-mask:var(--icon) no-repeat;background-color:currentColor}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_mask = false
  for op in ops {
    match op {
      Item::Mask(_x, _y, _w, _h, u, _col) if u.starts_with("data:image/svg+xml") => saw_mask = true
      _ => ()
    }
  }
  debug_assert(saw_mask, "mask: var(--icon) no-repeat must emit Item::Mask")
}

test "display: negative z-index pseudo-element paints before in-flow text inside stacking context" {
  let markup = "<!doctype html><html><body><a class=\"btn\">Get Started</a></body></html>"
  let css_src = "body{margin:0}.btn{display:inline-block;position:relative;transform:translateZ(0);padding:8px 16px;color:#fff}.btn::after{content:\"\";position:absolute;inset:0;z-index:-1;background-color:#262626}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut bg_idx = -1
  let mut text_idx = -1
  for i, op in ops {
    match op {
      Item::Rect(_x, _y, _w, _h, col) if col == 0x262626FF => bg_idx = i
      Item::Text(_f, _sz, _x, _y, _col, t, _l, _w) if t.contains("Get") => text_idx = i
      _ => ()
    }
  }
  debug_assert(bg_idx >= 0 && text_idx >= 0, "both ::after rect and button text must be emitted")
  debug_assert(bg_idx < text_idx, "z-index: -1 ::after must paint before in-flow button text")
}

test "display: position fixed inside iframe stays contained in iframe ops and does not leak to parent fixed" {
  let parent_html = "<!doctype html><html><body><div style=\"height:2000px\"></div><iframe width=\"114\" height=\"32\"></iframe></body></html>"
  let parent_css = "body{margin:0}iframe{display:block;border:0}"
  let pdoc = html::parse(parent_html)
  let peng = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen" })
  peng.add_sheet(parent_css)
  let proot = match layout::generate(pdoc, peng) {
    Some(b) => b
    None => panic("expected parent root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(proot, fonts, 1280.0, 800.0, 0.0)
  // Find iframe layout_id
  let mut iframe_id = -1
  let walk : Array[layout::Box] = [proot]
  while walk.length() > 0 {
    let cur = walk[walk.length() - 1]
    let _ = walk.pop()
    match cur.node {
      Some(n) if n.tag == "iframe" => iframe_id = n.layout_id
      _ => ()
    }
    for ch in cur.children { walk.push(ch) }
  }
  debug_assert(iframe_id >= 0, "found iframe box")

  let child_html = "<!doctype html><html><body><div class=\"fix\">Sponsor</div></body></html>"
  let child_css = "body{margin:0}.fix{position:fixed;top:0;left:0;width:100px;height:30px;background:#123456}"
  let cdoc = html::parse(child_html)
  let ceng = css::Engine::new(css::Env::{ width: 114.0, height: 32.0, media: "screen" })
  ceng.add_sheet(child_css)
  let croot = match layout::generate(cdoc, ceng) {
    Some(b) => b
    None => panic("expected child root Box")
  }
  layout::layout_with_scrollbar(croot, fonts, 114.0, 32.0, 0.0)

  let frames : intmap::IntMap[layout::Box] = intmap::IntMap::new()
  frames.set(iframe_id, croot)
  let parent_fixed : Array[Item] = []
  let ops = display_list_full(proot, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), parent_fixed, frames, false, None)
  debug_assert(parent_fixed.length() == 0, "iframe position:fixed must NOT leak into parent fixed layer")
  let mut saw_translated_rect = false
  for op in ops {
    match op {
      Item::Rect(_x, y, _w, _h, col) if col == 0x123456FF && y >= 1999.0 => saw_translated_rect = true
      _ => ()
    }
  }
  debug_assert(saw_translated_rect, "iframe position:fixed rect must be translated into iframe coordinates (y >= 2000)")
}

test "display: mask shorthand with position/size centers and sizes Item::Mask" {
  let markup = "<!doctype html><html><body><span class=\"ico\"></span></body></html>"
  let css_src = "body{margin:0}.ico{display:inline-block;width:30px;height:64px;background-color:#666;-webkit-mask:none 50%/calc(100% - 10px) no-repeat;mask:none 50%/calc(100% - 10px) no-repeat;-webkit-mask-image:url(\"data:image/svg+xml,%3Csvg/%3E\")}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut ok_mask = false
  for op in ops {
    match op {
      Item::Mask(x, y, w, h, u, _col) if u.starts_with("data:image/svg+xml") =>
      if (w - 20.0).abs() < 0.5 && (h - 20.0).abs() < 0.5 && (x - 5.0).abs() < 0.5 && (y - 22.0).abs() < 0.5 {
        ok_mask = true
      }
      _ => ()
    }
  }
  debug_assert(ok_mask, "mask: none 50%/calc(100% - 10px) no-repeat must center 20x20 Item::Mask inside 30x64 box")
}

test "display: outer overflow:hidden clip is not shifted by inner translate3d stacking context" {
  let markup = "<!doctype html><html><body><div class=\"clip\"><div class=\"track\"><div class=\"slide\"></div></div></div></body></html>"
  let css_src = "body{margin:0}.clip{overflow:hidden;width:800px;height:200px}.track{transform:translate3d(400px,0,0);position:relative;height:200px}.slide{position:absolute;left:700px;top:10px;width:100px;height:100px;background:rgb(255,0,0);transform:translate3d(-1000px,0,0)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_shifted_clip = false
  let mut saw_slide_at_100 = false
  for op in ops {
    match op {
      Item::Clip(x, _, _, _) => if x > 10.0 { saw_shifted_clip = true }
      Item::Rect(x, y, w, h, c) =>
      if ((c >> 24) & 0xFF) == 255 && ((c >> 16) & 0xFF) == 0 && ((c >> 8) & 0xFF) == 0 &&
      (x - 100.0).abs() < 1.0 && (y - 10.0).abs() < 1.0 && (w - 100.0).abs() < 1.0 && (h - 100.0).abs() < 1.0 {
        saw_slide_at_100 = true
      }
      _ => ()
    }
  }
  debug_assert(!saw_shifted_clip, "outer overflow:hidden clip must not be duplicated and shifted to x=400 by inner translate3d")
  debug_assert(saw_slide_at_100, "doubly-translated slide must paint at x=700-1000+400=100")
}

test "display: CSS outline draws rounded ring outside border box" {
  let markup = "<!doctype html><html><body><a class=\"btn\">GitHub</a></body></html>"
  let css_src = "body{margin:0}.btn{display:inline-block;width:120px;height:40px;border-radius:8px;outline-style:solid;outline-width:1px;outline-color:#3b3440}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_outline = false
  for op in ops {
    match op {
      Item::Round(_, _, w, h, r, ring, c) =>
      if ring.length() == 4 && (ring[0] - 1.0).abs() < 0.01 &&
      (w - 122.0).abs() < 0.5 && (h - 42.0).abs() < 0.5 &&
      r.length() == 4 && r[0] > 8.5 &&
      ((c >> 24) & 0xFF) == 0x3b && ((c >> 16) & 0xFF) == 0x34 && ((c >> 8) & 0xFF) == 0x40 {
        saw_outline = true
      }
      _ => ()
    }
  }
  debug_assert(saw_outline, "outline-style:solid + outline-width:1px + outline-color:#3b3440 must emit rounded Item::Round ring")
}

test "display: -webkit-text-fill-color transparent with background-clip text interpolates linear-gradient across glyphs" {
  let markup = "<!doctype html><html><body><h1>The <span class=\"g\">new foundation</span></h1></body></html>"
  let css_src = "body{margin:0;color:#111}h1{font-size:40px}.g{-webkit-text-fill-color:transparent;-webkit-background-clip:text;background-clip:text;background-image:linear-gradient(90deg,#007aff 0%,#2ec7b2 100%)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let grad_cols : Array[Int] = []
  for op in ops {
    match op {
      Item::Text(_, _, _, _, c, txt, _, _) => if txt.length() == 1 && ((c >> 8) & 0xFF) > 150 {
        grad_cols.push(c)
      }
      _ => ()
    }
  }
  debug_assert(grad_cols.length() >= 10, "gradient text must emit per-glyph Item::Text ops, got " + grad_cols.length().to_string())
  let first_g = (grad_cols[0] >> 16) & 0xFF
  let last_g = (grad_cols[grad_cols.length() - 1] >> 16) & 0xFF
  debug_assert(last_g > first_g + 40, "green channel must interpolate upward from #007aff to #2ec7b2")
}

test "display: text-decoration-color transparent suppresses underline rect" {
  let markup = "<!doctype html><html><body><a class=\"lnk\">Hello</a></body></html>"
  let css_src = "body{margin:0}.lnk{color:#111;text-decoration-line:underline;text-decoration-color:transparent}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_underline = false
  for op in ops {
    match op {
      Item::Rect(_, _, _, h, c) if (h - 1.0).abs() < 0.01 && (c & 0xFF) > 0 => saw_underline = true
      _ => ()
    }
  }
  debug_assert(!saw_underline, "text-decoration-color: transparent must not draw a visible underline rect")
}

test "display: inline svg with overflow visible expands draw rect beyond viewBox" {
  let markup = "<!doctype html><html><body><svg class=\"ring\" viewBox=\"0 0 80 70\" width=\"80\" height=\"70\"><path d=\"M-40,-20 L160,120\"/></svg></body></html>"
  let css_src = "body{margin:0}.ring{display:block;width:80px;height:70px;overflow:visible}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let svgs : intmap::IntMap[String] = intmap::IntMap::new()
  let walk : Array[layout::Box] = [root]
  while walk.length() > 0 {
    let cur = walk[walk.length() - 1]
    let _ = walk.pop()
    match cur.node {
      Some(n) if n.tag == "svg" => svgs.set(n.layout_id, "fv-svg:ring")
      _ => ()
    }
    for ch in cur.children { walk.push(ch) }
  }
  let ops = display_list_full(root, fonts, Map::new(), fn(_ : String) -> Option[(Double, Double)] { None }, svgs, [], intmap::IntMap::new(), false, None)
  let mut expanded = false
  for op in ops {
    match op {
      Item::Image(x, y, w, h, k, _) if k == "fv-svg:ring" =>
      if x < -30.0 && y < -15.0 && w > 180.0 && h > 130.0 {
        expanded = true
      }
      _ => ()
    }
  }
  debug_assert(expanded, "inline svg with overflow:visible and out-of-viewBox path must expand Item::Image rect")
}

test "display: radial-gradient respects per-layer background-position and background-size" {
  let markup = "<!doctype html><html><body><div class=\"page\"></div></body></html>"
  let css_src = "body{margin:0}.page{width:1000px;height:4000px;background-image:radial-gradient(#3b82f6,transparent 50%),radial-gradient(#60a5fa,transparent 50%);background-position:-200px -100px,300px -200px;background-size:800px 600px,700px 500px}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 1000.0, height: 800.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 1000.0, 800.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_first = false
  let mut saw_second = false
  for op in ops {
    match op {
      Item::Gradient(x, y, w, h, _, _, _, _) => {
        if (x + 200.0).abs() < 1.0 && (y + 100.0).abs() < 1.0 && (w - 800.0).abs() < 1.0 && (h - 600.0).abs() < 1.0 {
          saw_first = true
        }
        if (x - 300.0).abs() < 1.0 && (y + 200.0).abs() < 1.0 && (w - 700.0).abs() < 1.0 && (h - 500.0).abs() < 1.0 {
          saw_second = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_first && saw_second, "both radial-gradient layers must use their own background-position and background-size")
}

test "display: radial-gradient without shape/size prelude draws non-zero radius" {
  let markup = "<!doctype html><html><body><div class=\"glow\"></div></body></html>"
  let css_src = "body{margin:0}.glow{width:400px;height:300px;background:radial-gradient(#c2d9fa,transparent 50%)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_nonzero = false
  for op in ops {
    match op {
      Item::Gradient(_, _, _, _, _, geom, _, cols) =>
      if geom.length() >= 4 && geom[2] > 50.0 && geom[3] > 50.0 && cols.length() >= 2 {
        saw_nonzero = true
      }
      _ => ()
    }
  }
  debug_assert(saw_nonzero, "radial-gradient(#c2d9fa, transparent 50%) must compute non-zero rx/ry")
}

test "display: isolation isolate creates stacking context so z-index:-1 child paints above parent background" {
  let markup = "<!doctype html><html><body><div class=\"panel\"><div class=\"art\"></div><span class=\"txt\">Solid</span></div></body></html>"
  let css_src = "body{margin:0}.panel{position:relative;isolation:isolate;width:200px;height:100px;background-color:#0044aa}.art{position:absolute;inset:0;z-index:-1;background-color:#22ccff}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut panel_idx = -1
  let mut art_idx = -1
  let mut text_idx = -1
  for i, op in ops {
    match op {
      Item::Rect(_, _, _, _, c) if c == 0x0044AAFF => panel_idx = i
      Item::Rect(_, _, _, _, c) if c == 0x22CCFFFF => art_idx = i
      Item::Text(_, _, _, _, _, t, _, _) if t.contains("Solid") => text_idx = i
      _ => ()
    }
  }
  debug_assert(panel_idx >= 0 && art_idx >= 0 && text_idx >= 0, "panel, z-index:-1 art, and text must all emit")
  debug_assert(panel_idx < art_idx && art_idx < text_idx, "under isolation:isolate, z-index:-1 art must paint after panel bg and before in-flow text")
}

test "display: filter blur(16px) wraps element paint in Item::BlurLayer and Item::UnblurLayer" {
  let markup = "<!doctype html><html><body><div class=\"glow\"></div></body></html>"
  let css_src = "body{margin:0}.glow{width:120px;height:80px;background-color:#ff4400;filter:blur(16px)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut blur_idx = -1
  let mut rect_idx = -1
  let mut unblur_idx = -1
  for i, op in ops {
    match op {
      Item::BlurLayer(_, _, w, h, r) if (w - 120.0).abs() < 0.5 && (h - 80.0).abs() < 0.5 && (r - 16.0).abs() < 0.01 => blur_idx = i
      Item::Rect(_, _, _, _, c) if c == 0xFF4400FF => rect_idx = i
      Item::UnblurLayer => unblur_idx = i
      _ => ()
    }
  }
  debug_assert(blur_idx >= 0 && rect_idx > blur_idx && unblur_idx > rect_idx, "filter:blur(16px) must wrap element Rect inside BlurLayer..UnblurLayer")
}

test "display: ancestor opacity propagates to Item::Image and opacity:0 omits image" {
  let markup = "<!doctype html><html><body>" +
  "<div class=\"faint\"><img id=\"tex\" src=\"https://example.test/tex.jpg\"></div>" +
  "<div class=\"hidden\"><img id=\"gone\" src=\"https://example.test/gone.jpg\"></div>" +
  "</body></html>"
  let css_src = "body{margin:0}.faint{opacity:0.06}.hidden{opacity:0}img{display:block;width:100px;height:100px}"
  let doc = html::parse(markup)
  let walk = [doc]
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "img" {
      match n.attr("id") {
        Some("tex") => {
          n.src_url = Some("https://example.test/tex.jpg")
          n.natural = Some((100.0, 100.0))
        }
        Some("gone") => {
          n.src_url = Some("https://example.test/gone.jpg")
          n.natural = Some((100.0, 100.0))
        }
        _ => ()
      }
    }
    for ch in n.children { walk.push(ch) }
  }
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut tex_alpha = -1.0
  let mut saw_gone = false
  for op in ops {
    match op {
      Item::Image(_, _, _, _, u, a) =>
      if u == "https://example.test/tex.jpg" {
        tex_alpha = a
      } else if u == "https://example.test/gone.jpg" {
        saw_gone = true
      }
      _ => ()
    }
  }
  debug_assert((tex_alpha - 0.06).abs() < 0.001, "ancestor opacity:0.06 must propagate to Item::Image alpha")
  debug_assert(!saw_gone, "ancestor opacity:0 must omit Item::Image")
}

test "display: repeating background-size linear-gradient tiles across container and filter:invert() tags Item::Image" {
  let markup = "<!doctype html><html><body><div class=\"grid\"></div><img id=\"ic\" class=\"inv\" src=\"https://example.test/w.svg\"></body></html>"
  let css_src = "body{margin:0}.grid{width:128px;height:64px;background-image:linear-gradient(-90deg,#595959 1px,transparent 1px),linear-gradient(#595959 1px,transparent 1px);background-size:32px 32px,32px 32px}.inv{display:block;width:40px;height:40px;filter:invert()}"
  let doc = html::parse(markup)
  let walk = [doc]
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "img" {
      n.src_url = Some("https://example.test/w.svg")
      n.natural = Some((40.0, 40.0))
    }
    for ch in n.children { walk.push(ch) }
  }
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut grid_cnt = 0
  let mut saw_inv = false
  for op in ops {
    match op {
      Item::Gradient(_, _, _, _, _, _, _, _) => grid_cnt += 1
      Item::Rect(_, _, rw, rh, c) if (c & 0xFF) != 0 && ((rw - 1.0).abs() < 0.01 || (rh - 1.0).abs() < 0.01) => grid_cnt += 1
      Item::Image(_, _, _, _, u, _) if u.starts_with("fvflt:") && u.ends_with("|https://example.test/w.svg") => saw_inv = true
      _ => ()
    }
  }
  debug_assert(grid_cnt == 6, "128x64 box with 32x32 horiz+vert linear-gradient grid should emit 4+2=6 tiled grid strips, got " + grid_cnt.to_string())
  debug_assert(saw_inv, "filter:invert() on img/svg must tag Item::Image with fvflt: matrix")
}

test "display: propagated body background does not paint over z-index:-1 child of root" {
  let markup = "<!doctype html><html><body><div class=\"bg\"></div><p>hello</p></body></html>"
  let css_src = "body{margin:0;background-color:#ffffff}.bg{position:absolute;top:0;left:0;width:400px;height:300px;z-index:-1;background-color:#00aaff}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut canvas_idx = -1
  let mut bg_idx = -1
  let mut body_white_after_bg = false
  for i, op in ops {
    match op {
      Item::Rect(_, _, w, _, c) if c == 0xFFFFFFFF =>
      if canvas_idx < 0 && w >= 10000.0 {
        canvas_idx = i
      } else if bg_idx >= 0 {
        body_white_after_bg = true
      }
      Item::Rect(_, _, _, _, c) if c == 0x00AAFFFF => bg_idx = i
      _ => ()
    }
  }
  debug_assert(canvas_idx >= 0 && bg_idx > canvas_idx, "z-index:-1 bg must paint after canvas background")
  debug_assert(!body_white_after_bg, "body background propagated to canvas must not repaint over z-index:-1 element")
}

test "display: zero-content-box CSS border triangle emits vector SVG polygon instead of solid Rect" {
  let markup = "<!doctype html><html><body><span class=\"caret\"></span></body></html>"
  let css_src = "body{margin:0}.caret{display:inline-block;width:0;height:0;border:6px solid transparent;border-top-color:#1c1e21;border-bottom:0}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 200.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_tri = false
  let mut saw_rect = false
  for op in ops {
    match op {
      Item::Image(_, _, w, h, u, _) if (w - 12.0).abs() < 0.5 && (h - 6.0).abs() < 0.5 && u.starts_with("data:image/svg+xml,") && u.contains("<polygon") => saw_tri = true
      Item::Rect(_, _, w, h, c) if (w - 12.0).abs() < 0.5 && (h - 6.0).abs() < 0.5 && c == 0x1C1E21FF => saw_rect = true
      _ => ()
    }
  }
  debug_assert(saw_tri && !saw_rect, "CSS border triangle must emit vector SVG polygon instead of solid Rect")
}

test "display: background-clip:text on ancestor heading colors nested span text and mask-image repeating-linear-gradient clips stripes" {
  let markup = "<!doctype html><html><body><h1 class=\"hero\"><span>Rsbuild</span></h1><div class=\"stripes\"></div></body></html>"
  let css_src = "body{margin:0}.hero{background:linear-gradient(279deg,#ff8b00 35%,#f93920 63%);-webkit-text-fill-color:#0000;-webkit-background-clip:text;background-clip:text;font-size:72px}.stripes{width:100px;height:80px;background-image:linear-gradient(180deg,#d8ff4a,#ffc6f2);mask-image:repeating-linear-gradient(90deg,black,black 5px,transparent 5px,transparent 10px)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_orange_text = false
  let mut stripe_clips = 0
  for op in ops {
    match op {
      Item::Text(_, _, _, _, c, txt, _, _) if txt == "R" || txt.contains("Rsbuild") => {
        let r = (c >> 24) & 0xFF
        let a = c & 0xFF
        if r > 200 && a > 200 { saw_orange_text = true }
      }
      Item::Clip(_, _, cw, ch) if (cw - 5.0).abs() < 0.1 && (ch - 80.0).abs() < 0.5 => stripe_clips += 1
      _ => ()
    }
  }
  debug_assert(saw_orange_text, "nested span inside background-clip:text heading must sample ancestor gradient color")
  debug_assert(stripe_clips == 10, "100px box with 5px/10px repeating-linear-gradient mask must emit 10 clipped stripes, got " + stripe_clips.to_string())
}

///|
test "display: backface-visibility hidden culls rotateY(180deg) back-facing box but keeps scaleX(-1)" {
  let markup = "<!doctype html><html><body><div class=\"back\"></div><div class=\"flip\"></div></body></html>"
  let css_src = "body{margin:0}.back{width:80px;height:80px;background:#ff0000;backface-visibility:hidden;transform:rotateY(180deg)}.flip{width:80px;height:80px;background:#00ff00;backface-visibility:hidden;transform:scaleX(-1)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 200.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_red = false
  let mut saw_green = false
  for op in ops {
    match op {
      Item::Rect(_, _, _, _, c) if c == 0xFF0000FF => saw_red = true
      Item::Rect(_, _, _, _, c) if c == 0x00FF00FF => saw_green = true
      _ => ()
    }
  }
  debug_assert(!saw_red, "rotateY(180deg) with backface-visibility:hidden must be culled")
  debug_assert(saw_green, "2D scaleX(-1) with backface-visibility:hidden must remain visible")
}

///|
test "DisplayMasks fast paths: box_decor, box_mask_url, list_marker & clip_of" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='plain' style='width:40px;height:20px'></div>" +
    "<div id='bg' style='width:40px;height:20px;background-color:#ff0000'></div>" +
    "<div id='bd' style='width:40px;height:20px;border:2px solid #00ff00'></div>" +
    "<div id='sh' style='width:40px;height:20px;box-shadow:0 2px 4px #000'></div>" +
    "<div id='ol' style='width:40px;height:20px;outline:2px solid #0000ff'></div>" +
    "<div id='mk' style='width:40px;height:20px;background-color:#111;mask-image:url(a.svg)'></div>" +
    "<div id='ov' style='width:40px;height:20px;overflow:hidden'></div>" +
    "<button id='btn'>ok</button>" +
    "<ul><li id='li1'>item</li><li id='li2' style='visibility:hidden'>hid</li></ul>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_plain = match layout::box_of(root, body.children[0]) { Some(b) => b None => panic("plain") }
  let b_mk = match layout::box_of(root, body.children[5]) { Some(b) => b None => panic("mk") }
  let b_ov = match layout::box_of(root, body.children[6]) { Some(b) => b None => panic("ov") }
  debug_assert(box_mask_url(b_plain.style).is_none(), "plain box_mask_url None")
  debug_assert(box_mask_url(b_mk.style).unwrap_or("") == "a.svg", "mask-image url parsed via url_id")
  debug_assert(!clip_of(b_plain) && clip_of(b_ov), "clip_of fast path vs overflow:hidden")
  let ops = display_list(root, fonts)
  let mut rects = 0
  let mut rounds = 0
  for op in ops {
    match op {
      Item::Rect(_, _, _, _, _) => rects += 1
      Item::Round(_, _, _, _, _, _, _) => rounds += 1
      _ => ()
    }
  }
  debug_assert(rects > 0 && rounds > 0, "decorations, borders, outlines, button & list marker emitted")
  html::cut(doc)
}

///|
test "display: inline svg with viewBox preserves aspect ratio (meet) inside wider CSS box" {
  let markup = "<!doctype html><html><body><svg class=\"bar\" width=\"150\" height=\"24\" viewBox=\"0 0 90 16\"></svg><svg class=\"stretch\" width=\"150\" height=\"24\" viewBox=\"0 0 90 16\" preserveAspectRatio=\"none\"></svg></body></html>"
  let css_src = "body{margin:0}.bar,.stretch{display:block;width:600px;height:16px;overflow:hidden}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 200.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 200.0, 0.0)
  let svgs : intmap::IntMap[String] = intmap::IntMap::new()
  let walk : Array[layout::Box] = [root]
  while walk.length() > 0 {
    let cur = walk[walk.length() - 1]
    let _ = walk.pop()
    match cur.node {
      Some(n) if n.tag == "svg" => {
        let cls = n.attr("class").unwrap_or("")
        svgs.set(n.layout_id, "fv-svg:" + cls)
      }
      _ => ()
    }
    for ch in cur.children { walk.push(ch) }
  }
  let ops = display_list_full(root, fonts, Map::new(), fn(_ : String) -> Option[(Double, Double)] { None }, svgs, [], intmap::IntMap::new(), false, None)
  let mut ok_meet = false
  let mut ok_none = false
  for op in ops {
    match op {
      Item::Image(x, _y, w, h, k, _) if k == "fv-svg:bar" =>
      if (w - 100.0).abs() < 0.5 && (h - 16.0).abs() < 0.5 && (x - 250.0).abs() < 0.5 {
        ok_meet = true
      }
      Item::Image(x, _y, w, h, k, _) if k == "fv-svg:stretch" =>
      if (w - 600.0).abs() < 0.5 && (h - 16.0).abs() < 0.5 && x.abs() < 0.5 {
        ok_none = true
      }
      _ => ()
    }
  }
  debug_assert(ok_meet, "inline svg with viewBox must preserve aspect ratio centered inside 600x16 box")
  debug_assert(ok_none, "inline svg with preserveAspectRatio=none must stretch to 600x16")
}

///|
test "display: clip-path polygon tags descendant Item::Image with fvpoly normalized vertices" {
  let markup = "<!doctype html><html><body><a class=\"hex\"><img src=\"https://example.test/chart.png\"></a></body></html>"
  let css_src = "body{margin:0}.hex{display:block;width:200px;height:200px;clip-path:polygon(50% 100%,93.3% 75%,93.3% 25%,50% 0%,6.7% 25%,6.7% 75%)}.hex img{display:block;width:200px;height:200px}"
  let doc = html::parse(markup)
  let walk_n : Array[html::Node] = [doc]
  while walk_n.length() > 0 {
    let cur = walk_n[walk_n.length() - 1]
    let _ = walk_n.pop()
    if cur.kind == html::Kind::Element && cur.tag == "img" {
      cur.src_url = Some("https://example.test/chart.png")
      cur.natural = Some((200.0, 200.0))
    }
    for ch in cur.children { walk_n.push(ch) }
  }
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 400.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("expected root Box")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_poly = false
  for op in ops {
    match op {
      Item::Image(_, _, _, _, u, _) if u.starts_with("fvpoly:") && u.ends_with("|https://example.test/chart.png") => saw_poly = true
      _ => ()
    }
  }
  debug_assert(saw_poly, "clip-path:polygon must tag descendant Item::Image with fvpoly: normalized vertices")
}

///|
test "Wave 46A: in_flow TextRun fast path, box_decor borderless/ring_color/mixed-border & outline" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;color:#112233'>" +
    "<div id='tvis'>visible text</div>" +
    "<div id='thid' style='visibility:hidden'>hidden text</div>" +
    "<div id='bgonly' style='width:40px;height:20px;background-color:#ff0000;border-radius:4px'></div>" +
    "<div id='samebd' style='width:40px;height:20px;border:2px solid #00aa00;border-radius:6px'></div>" +
    "<div id='mixbd' style='width:40px;height:20px;border-top:2px solid #ff0000;border-bottom:2px solid #0000ff;border-radius:6px'></div>" +
    "<div id='olonly' style='width:40px;height:20px;outline:2px solid #aa00aa'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_vis = false
  let mut saw_hid = false
  let mut saw_same_ring = false
  let mut saw_mix_red = false
  let mut saw_mix_blue = false
  let mut saw_outline = false
  for op in ops {
    match op {
      Item::Text(_, _, _, _, _, t, _, _) => {
        if t.contains("visible") { saw_vis = true }
        if t.contains("hidden") { saw_hid = true }
      }
      Item::Round(_, _, _, _, _, bw, col) => {
        if bw.length() == 4 && col == 0x00AA00FF { saw_same_ring = true }
        if bw.length() == 4 && col == 0xAA00AAFF { saw_outline = true }
      }
      Item::Rect(_, _, _, _, col) => {
        if col == 0xFF0000FF { saw_mix_red = true }
        if col == 0x0000FFFF { saw_mix_blue = true }
      }
      _ => ()
    }
  }
  debug_assert(saw_vis && !saw_hid, "TextRun fast path draws visible text and respects visibility:hidden")
  debug_assert(saw_same_ring, "rounded same-color border emits Item::Round ring")
  debug_assert(saw_mix_red && saw_mix_blue, "rounded mixed-color border falls back to per-side Rects")
  debug_assert(saw_outline, "outline emits Item::Round when p_outline_style is present")
  html::cut(doc)
}

///|
test "Wave 50A: in_flow child_fg, EffectMasks any_m0/m1 filter+clip+polygon & cursor_cache" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex'><div style='z-index:2;width:20px;height:20px;background:#111'></div></div>" +
    "<div style='display:inline-flex'><div style='z-index:2;width:20px;height:20px;background:#222'></div></div>" +
    "<div style='width:40px;height:40px;background:#f00;filter:opacity(0.5);clip-path:polygon(0 0,100% 0,100% 100%)'></div>" +
    "<div style='cursor:pointer;width:40px;height:20px'><span id='ch' style='display:block;width:20px;height:10px'>go</span></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_poly = false
  let mut saw_hover_ptr = 0
  for op in ops {
    match op {
      Item::Image(_, _, _, _, u, _) if u.contains("<polygon") => saw_poly = true
      Item::Hover(_, _, _, _, _, k) if k == 1 => saw_hover_ptr += 1
      _ => ()
    }
  }
  debug_assert(saw_poly, "merged EffectMasks any_m0/m1 still emits polygon clip")
  debug_assert(saw_hover_ptr >= 2, "cursor:pointer parent and child emit Hover with cursor_cache")
  html::cut(doc)
}

///|
test "display: inline svg with width=1em height=1em and wide viewBox uses viewBox aspect ratio inside CSS box" {
  let markup = "<!doctype html><html><body><div class=\"wrap\"><svg width=\"1em\" height=\"1em\" viewBox=\"67 15 663.545 144\" class=\"logo\"></svg></div></body></html>"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(800.0, 200.0))
  e.add_sheet("body{margin:0}.wrap{width:110.591px;height:24px}.logo{display:block;width:100%;height:100%}")
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 200.0, 0.0)
  let svgs : intmap::IntMap[String] = intmap::IntMap::new()
  let walk : Array[layout::Box] = [root]
  while walk.length() > 0 {
    let cur = walk[walk.length() - 1]
    let _ = walk.pop()
    match cur.node {
      Some(n) if n.tag == "svg" => svgs.set(n.layout_id, "fv-svg:logo")
      _ => ()
    }
    for ch in cur.children { walk.push(ch) }
  }
  let ops = display_list_full(root, fonts, Map::new(), fn(_ : String) -> Option[(Double, Double)] { None }, svgs, [], intmap::IntMap::new(), false, None)
  let mut ok_logo = false
  for op in ops {
    match op {
      Item::Image(_x, _y, w, h, k, _) if k == "fv-svg:logo" =>
      if (w - 110.591).abs() < 0.5 && (h - 24.0).abs() < 0.5 {
        ok_logo = true
      }
      _ => ()
    }
  }
  debug_assert(ok_logo, "inline svg with width=1em height=1em and 663.545x144 viewBox must fill 110.591x24 CSS box, not shrink to 24x24")
  html::cut(doc)
}

///|
test "Wave 58A: context empty later fast path, pos/neg z-index stacking context & creates_stacking_context gates" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='sc_empty' style='width:60px;height:30px;opacity:0.5;transform:translateX(10px);background:#112233'></div>" +
    "<div id='sc_z' style='position:relative;isolation:isolate;width:100px;height:60px;background:#000011'>" +
    "<div style='position:absolute;inset:0;z-index:-1;background:#001100'></div>" +
    "<div style='position:absolute;inset:0;z-index:2;background:#110000'></div>" +
    "</div>" +
    "<div id='plain' style='width:20px;height:20px'></div>" +
    "<div id='iso' style='isolation:isolate'></div>" +
    "<div id='fix' style='position:fixed'></div>" +
    "<div id='flt' style='filter:blur(2px)'></div>" +
    "<div id='clp' style='width:20px;height:20px;clip-path:inset(1px)'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_plain = match layout::box_of(root, body.children[2]) { Some(b) => b None => panic("plain") }
  let b_iso = match layout::box_of(root, body.children[3]) { Some(b) => b None => panic("iso") }
  let b_fix = match layout::box_of(root, body.children[4]) { Some(b) => b None => panic("fix") }
  let b_flt = match layout::box_of(root, body.children[5]) { Some(b) => b None => panic("flt") }
  let b_clp = match layout::box_of(root, body.children[6]) { Some(b) => b None => panic("clp") }
  debug_assert(!creates_stacking_context(b_plain), "plain div is not a stacking context")
  debug_assert(creates_stacking_context(b_iso) && creates_stacking_context(b_fix) && creates_stacking_context(b_flt) && creates_stacking_context(b_clp), "isolation/fixed/filter/clip-path create stacking contexts")
  let ops = display_list(root, fonts)
  let mut idx_empty = -1
  let mut idx_bg = -1
  let mut idx_neg = -1
  let mut idx_pos = -1
  for i, op in ops {
    match op {
      Item::Rect(x, _, _, _, c) if ((c >> 8) & 0xFFFFFF) == 0x112233 && (x - 10.0).abs() < 0.5 => idx_empty = i
      Item::Rect(_, _, _, _, c) if c == 0x000011FF => idx_bg = i
      Item::Rect(_, _, _, _, c) if c == 0x001100FF => idx_neg = i
      Item::Rect(_, _, _, _, c) if c == 0x110000FF => idx_pos = i
      _ => ()
    }
  }
  debug_assert(idx_empty >= 0, "empty-later stacking context emits translated rect at x=10")
  debug_assert(idx_bg >= 0 && idx_neg > idx_bg && idx_pos > idx_neg, "stacking context paints bg < z:-1 < z:+2")
  html::cut(doc)
}

///|
test "display: background-clip:text vertical reveal gradient with transparent top stop and background-position 50% 100% draws opaque text" {
  let markup = "<!doctype html><html><body><h1><span class=\"ch\">Y</span><span class=\"ch\">o</span></h1></body></html>"
  let css_src = "body{margin:0;color:#111111}.ch{display:inline-block;background-image:linear-gradient(to bottom,transparent 0%, #8844ff 50%, #111111 100%);-webkit-text-fill-color:transparent;-webkit-background-clip:text;background-clip:text;background-size:100% 300%;background-position:50% 100%;font-size:48px}"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(800.0, 200.0))
  e.add_sheet(css_src)
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut opaque_chars = 0
  for op in ops {
    match op {
      Item::Text(_, _, _, _, col, txt, _, _) if txt == "Y" || txt == "o" =>
      if (col & 0xFF) >= 240 {
        opaque_chars += 1
      }
      _ => ()
    }
  }
  debug_assert(opaque_chars == 2, "vertical background-clip:text reveal gradient at background-position 50% 100% must draw opaque text, got " + opaque_chars.to_string())
  html::cut(doc)
}

///|
test "Wave 52B: inherited initial reset (text-transform:initial), U+2028 collapsible space & mask-composite:exclude gradient ring" {
  let markup = "<!doctype html><html><body>" +
  "<a class='btn'><span class='lbl'>Sentry MCP</span></a>" +
  "<p class='sub'>considered \u{2028}\"not bad\" by devs</p>" +
  "<div class='ring'></div>" +
  "</body></html>"
  let css_src = "body{margin:0}" +
  ".btn{text-transform:uppercase}" +
  ".btn .lbl{text-transform:initial}" +
  ".ring{width:120px;height:40px;padding:2px;border-radius:8px;" +
  "background:linear-gradient(11deg,#fa7faa 0%,#ff9691 50%,#ffb287 100%);" +
  "-webkit-mask-composite:xor;mask-composite:exclude;" +
  "mask-clip:content-box,border-box}"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(800.0, 400.0))
  e.add_sheet(css_src)
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 400.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_mixed_case = false
  let mut saw_ring = false
  let mut saw_solid_grad = false
  let mut saw_u2028 = false
  for op in ops {
    match op {
      Item::Text(_, _, _, _, _, txt, _, _) => {
        if txt == "Sentry" { saw_mixed_case = true }
        if txt.contains("\u{2028}") { saw_u2028 = true }
      }
      Item::Round(_, _, _, _, _, borders, col) =>
      if borders.length() == 4 && (borders[0] - 2.0).abs() < 0.1 && (col & 0xFF) > 200 {
        saw_ring = true
      }
      Item::Gradient(_, _, _, _, _, _, _, _) => saw_solid_grad = true
      _ => ()
    }
  }
  debug_assert(saw_mixed_case, "text-transform:initial on child must reset parent uppercase")
  debug_assert(!saw_u2028, "U+2028 line separator must collapse as whitespace, not leak into text glyph runs")
  debug_assert(saw_ring && !saw_solid_grad, "mask-composite:exclude + mask-clip:content-box,border-box must emit hollow border ring, not solid gradient")
  html::cut(doc)
}

///|
test "Wave 53B: low-alpha radial-gradient mask-image attenuates background opacity" {
  let markup = "<!doctype html><html><body><div class='grain'></div><div class='zero'></div></body></html>"
  let css_src = "body{margin:0}" +
  ".grain{width:200px;height:200px;background-color:#ffffff;" +
  "mask-image:radial-gradient(ellipse closest-side at 70% 45%, rgba(0,0,0,0.15), transparent 100%)}" +
  ".zero{width:100px;height:100px;background-color:#ffffff;" +
  "mask-image:linear-gradient(transparent, transparent)}"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(400.0, 400.0))
  e.add_sheet(css_src)
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let ops = display_list(root, fonts)
  let mut grain_alpha = -1
  let mut zero_count = 0
  for op in ops {
    match op {
      Item::Rect(_, _, w, _, col) if (w - 200.0).abs() < 0.5 => grain_alpha = col & 0xFF
      Item::Rect(_, _, w, _, _) if (w - 100.0).abs() < 0.5 => zero_count += 1
      _ => ()
    }
  }
  debug_assert(grain_alpha > 0 && grain_alpha < 30, "low-alpha radial-gradient mask-image must attenuate background alpha (<30), got " + grain_alpha.to_string())
  debug_assert(zero_count == 0, "fully transparent mask-image must skip drawing background")
  html::cut(doc)
}

///|
test "Wave 60B: low-alpha radial-gradient mask-image attenuates descendant subtree alpha" {
  let markup = "<!doctype html><html><body><div class='grid'><div class='child'></div></div></body></html>"
  let css_src = "body{margin:0}" +
  ".grid{position:relative;width:400px;height:300px;" +
  "mask-image:radial-gradient(ellipse 50% 70% at 50% 50%, #00000040 0%, #0000 76.36%)}" +
  ".child{width:180px;height:120px;background-color:#ffffff}"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(400.0, 400.0))
  e.add_sheet(css_src)
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let ops = display_list(root, fonts)
  let mut child_alpha = -1
  for op in ops {
    match op {
      Item::Rect(_, _, w, _, col) if (w - 180.0).abs() < 0.5 => child_alpha = col & 0xFF
      _ => ()
    }
  }
  debug_assert(child_alpha > 0 && child_alpha < 40, "low-alpha radial-gradient mask-image on parent must attenuate child alpha (<40), got " + child_alpha.to_string())
  html::cut(doc)
}

///|
test "Wave 55B: ::first-line pseudo-element colors only the first line of wrapped text" {
  let markup = "<!doctype html><html><body><h1 class='hero'><span class='name'>Beautiful &amp;\nconsistent icons</span></h1></body></html>"
  let css_src = "body{margin:0}.hero .name{display:block;width:160px;font-size:24px;color:#3c3c43}.hero .name:first-line{color:#f56565}"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  e.add_sheet(css_src)
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut red_first = false
  let mut gray_second = false
  for op in ops {
    match op {
      Item::Text(_, _, _, _, col, txt, _, _) => {
        let rgb = (col >> 8) & 0xFFFFFF
        if txt == "Beautiful" && rgb == 0xF56565 { red_first = true }
        if txt == "consistent" && rgb == 0x3C3C43 { gray_second = true }
      }
      _ => ()
    }
  }
  debug_assert(red_first, "first line word 'Beautiful' must be colored #f56565 by :first-line")
  debug_assert(gray_second, "second line word 'consistent' must keep base color #3c3c43")
  html::cut(doc)
}

///|
test "Wave 56B: -webkit-text-stroke with transparent fill renders visible hollow outline tint" {
  let markup = "<!doctype html><html><body><h1><span class='hollow'>UNBREAKABLE.</span></h1></body></html>"
  let css_src = "body{margin:0;color:#ffffff}.hollow{-webkit-text-stroke:1px currentColor;-webkit-text-fill-color:transparent;font-size:48px}"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  e.add_sheet(css_src)
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_visible = false
  for op in ops {
    match op {
      Item::Text(_, _, _, _, col, txt, _, _) if txt == "UNBREAKABLE." => {
        let a = col & 0xFF
        let rgb = (col >> 8) & 0xFFFFFF
        if rgb == 0xFFFFFF && a >= 100 && a <= 180 {
          saw_visible = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_visible, "hollow -webkit-text-stroke text with transparent fill must draw visible white outline tint")
  html::cut(doc)
}

///|
test "Wave 59A: scroller_of maybe_has_id gate (none / overflow-y:auto / overflow:hidden)" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='plain' style='width:50px;height:50px'></div>" +
    "<div id='sc_y' style='width:50px;height:50px;overflow-y:auto'><div style='height:120px'></div></div>" +
    "<div id='hid' style='width:50px;height:50px;overflow:hidden'><div style='height:120px'></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_plain = match layout::box_of(root, body.children[0]) { Some(b) => b None => panic("plain") }
  let b_scy = match layout::box_of(root, body.children[1]) { Some(b) => b None => panic("sc_y") }
  let b_hid = match layout::box_of(root, body.children[2]) { Some(b) => b None => panic("hid") }
  debug_assert(scroller_of(b_plain).is_none(), "plain box without overflow is not a scroller")
  debug_assert(scroller_of(b_scy).is_some(), "overflow-y:auto box is a scroller")
  debug_assert(scroller_of(b_hid).is_none(), "overflow:hidden box is not a scroller")
  html::cut(doc)
}

///|
test "Wave 58B: mask shorthand with content-box + mask-composite:exclude emits gradient border ring" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<span id='ring' style='display:block;width:140px;height:40px;padding:1px;border-radius:20px;background:linear-gradient(90deg, #98f04a 0%, #98f04a 100%);mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);mask-composite:exclude'></span>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list_full(root, fonts, Map::new(), fn(_ : String) -> Option[(Double, Double)] { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, None)
  let mut saw_ring = false
  let mut saw_grad = false
  for op in ops {
    match op {
      Item::Round(_, _, _, _, _, bw, col) if bw.length() == 4 && (bw[0] - 1.0).abs() < 0.01 && (col & 0xFF) > 0 => saw_ring = true
      Item::Gradient(_, _, _, _, _, _, _, _) => saw_grad = true
      _ => ()
    }
  }
  debug_assert(saw_ring && !saw_grad, "mask shorthand content-box + mask-composite:exclude must emit 1px ring instead of solid gradient fill")
  html::cut(doc)
}

///|
test "Wave 77B: alpha_of skips leading Space tokens from var() fallback so opacity: var(--x, 0) hides fixed backdrop" {
  let doc = html::parse(
    "<!doctype html><html><head><style>:root{--op: 0}.bd{position:fixed;inset:0;z-index:300;background:rgba(0,0,0,0.4);opacity:var(--op)}.bd2{position:fixed;inset:0;z-index:322;background:rgba(0,0,0,0.3);opacity:var(--missing, 0)}</style></head><body style='margin:0'>" +
    "<div class='bd'></div><div class='bd2'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list_full(root, fonts, Map::new(), fn(_ : String) -> Option[(Double, Double)] { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, None)
  let mut saw_dark = false
  for op in ops {
    match op {
      Item::Rect(_, _, _, _, col) if (col & 0xFFFFFF00) == 0 && (col & 0xFF) > 0 => saw_dark = true
      _ => ()
    }
  }
  debug_assert(!saw_dark, "opacity: var(--op) / var(--missing, 0) with leading Space token must hide fixed backdrop")
  html::cut(doc)
}

///|
test "Wave 80B: mix-blend-mode:soft-light empty overlay over opaque black backdrop vanishes per W3C Compositing §10.1" {
  let doc = html::parse(
    "<!doctype html><html><head><style>.hero{position:relative;width:400px;height:200px;background:#000}.hero::after{content:'';position:absolute;inset:0;opacity:0.8;mix-blend-mode:soft-light;background:#808080}</style></head><body style='margin:0'>" +
    "<div class='hero'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list_full(root, fonts, Map::new(), fn(_ : String) -> Option[(Double, Double)] { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, None)
  let mut saw_grey = false
  for op in ops {
    match op {
      Item::Rect(_, _, _, _, col) if (col >> 24) == 0x80 => saw_grey = true
      _ => ()
    }
  }
  debug_assert(!saw_grey, "soft-light empty overlay over #000 must not paint #808080 SourceOver wash")
  html::cut(doc)
}

///|
test "Wave 7C: control_text honors -webkit-text-fill-color:transparent on overlay textarea without double ghosting" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<textarea style='width:200px;height:60px;color:#ffffff;-webkit-text-fill-color:transparent'>ghost_text</textarea>" +
    "<textarea style='width:200px;height:60px;color:#112233'>visible_text</textarea>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut saw_ghost = false
  let mut saw_vis = false
  for op in ops {
    match op {
      Item::Text(_, _, _, _, _, txt, _, _) => {
        if txt.contains("ghost_text") { saw_ghost = true }
        if txt.contains("visible_text") { saw_vis = true }
      }
      _ => ()
    }
  }
  debug_assert(!saw_ghost, "textarea with -webkit-text-fill-color:transparent must not emit ghost text")
  debug_assert(saw_vis, "opaque textarea must still emit visible_text")
  html::cut(doc)
}

///|
test "Wave 8C: control_text honors text-align:center and text-align:right on text inputs" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<input type='text' value='5 4 * * *' style='width:400px;height:40px;text-align:center;border:0;padding:0'>" +
    "<input type='text' value='RIGHT' style='width:400px;height:40px;text-align:right;border:0;padding:0'>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let ops = display_list(root, fonts)
  let mut center_x = -1.0
  let mut right_x = -1.0
  for op in ops {
    match op {
      Item::Text(_, _, x, _, _, txt, _, _) => {
        if txt == "5 4 * * *" { center_x = x }
        if txt == "RIGHT" { right_x = x }
      }
      _ => ()
    }
  }
  debug_assert(center_x > 100.0 && center_x < 250.0, "text-align:center input must center text around x~170, got " + center_x.to_string())
  debug_assert(right_x > 300.0, "text-align:right input must align text near right edge (x>300), got " + right_x.to_string())
  html::cut(doc)
}

///|
test "Wave 12C: background-image background-size evaluates calc() math expressions" {
  let markup = "<!doctype html><html><body><div id=\"bg\"></div></body></html>"
  let css_src = "body{margin:0}#bg{width:124px;height:124px;background-image:url(https://cssgridgarden.com/images/carrots.svg);background-repeat:no-repeat;background-size:calc(10vw - 4px)}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen" })
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let sizes : Map[String, (Double, Double)] = Map::new()
  sizes.set("https://cssgridgarden.com/images/carrots.svg", (2000.0, 2000.0))
  let ops = display_list_full(root, fonts, sizes, fn(_) { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, None)
  let mut got_w = -1.0
  let mut got_h = -1.0
  for op in ops {
    match op {
      Item::Image(_x, _y, iw, ih, u, _) if u == "https://cssgridgarden.com/images/carrots.svg" => {
        got_w = iw
        got_h = ih
      }
      _ => ()
    }
  }
  debug_assert((got_w - 124.0).abs() < 0.5 && (got_h - 124.0).abs() < 0.5, "background-size: calc(10vw - 4px) on 1280px viewport must scale 2000x2000 SVG to 124x124, got " + got_w.to_string() + "x" + got_h.to_string())
  html::cut(doc)
}

///|
test "Wave 94B: CSS 2.1 §9.2.2 / Fragmentation §5.1 multi-line inline border-bottom draws per line fragment" {
  let markup = "<!doctype html><html><body style='margin:0'><div style='width:230px;font-size:14px;line-height:22px'>Agree to our <a class='l1'>Privacy &amp; Cookies Policy</a>. You <a class='l2'>change cookies settings</a>.</div></body></html>"
  let css_src = ".l1{border-bottom:2px solid #00aa00}.l2{border-bottom:2px solid #0000ff}"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::new(400.0, 300.0))
  engine.add_sheet(css_src)
  let root = match layout::generate(doc, engine) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let ops = display_list(root, fonts)
  let g_rects : Array[(Double, Double, Double, Double)] = []
  let b_rects : Array[(Double, Double, Double, Double)] = []
  for op in ops {
    match op {
      Item::Rect(x, y, w, h, col) if col == 0x00AA00FF && (h - 2.0).abs() < 0.1 => g_rects.push((x, y, w, h))
      Item::Rect(x, y, w, h, col) if col == 0x0000FFFF && (h - 2.0).abs() < 0.1 => b_rects.push((x, y, w, h))
      _ => ()
    }
  }
  debug_assert(g_rects.length() == 2, "l1 wrapped across 2 lines must emit 2 green border-bottom rects, got " + g_rects.length().to_string())
  debug_assert(b_rects.length() == 2, "l2 wrapped across 2 lines must emit 2 blue border-bottom rects, got " + b_rects.length().to_string())
  // l1 line 1 starts after "Agree to our "; l1 line 2 starts at x=0 and does NOT extend across ". You "
  debug_assert(g_rects[0].0 > 70.0 && g_rects[0].2 < 140.0, "l1 line 1 must underline only its line-1 words")
  debug_assert(g_rects[1].0 < 2.0 && g_rects[1].2 < 140.0, "l1 line 2 must underline only its line-2 words")
  debug_assert(g_rects[1].1 > g_rects[0].1 + 10.0, "l1 line 2 must be below line 1")
  // l2 line 1 starts AFTER l1 line 2 + ". You " on the same line, and l2 line 2 does NOT overshoot right whitespace
  debug_assert((b_rects[0].1 - g_rects[1].1).abs() < 2.0, "l2 first fragment must be on same line as l1 second fragment")
  debug_assert(b_rects[0].0 > g_rects[1].0 + g_rects[1].2 + 20.0, "gap for '. You ' must remain un-underlined between l1 and l2")
  debug_assert(b_rects[1].0 < 2.0 && b_rects[1].2 < 160.0, "l2 second fragment must not overshoot into right whitespace")
  html::cut(doc)
}

///|
test "Wave 91A: KeptCache zero-copy commit_items and mutated_ops filter safety" {
  let markup = "<!doctype html><html><body><div id='plain'><div id='k1' style='width:40px;height:20px;background:red'></div></div><div id='flt' style='filter:invert(1)'><div id='k2' style='width:30px;height:20px;background:blue'></div></div></body></html>"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen" })
  let root = match layout::generate(doc, engine) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let kc = KeptCache::new()
  // Frame 1: populate KeptCache with deferred swap
  kc.items_buf.clear()
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, Some(kc), kc.items_buf, defer_arena_swap=true)
  let n1 = kc.items_buf.length()
  kc.commit_items()
  // Frame 2: reuse cached ops from prev_arena
  kc.items_buf.clear()
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, Some(kc), kc.items_buf, defer_arena_swap=true)
  let n2 = kc.items_buf.length()
  debug_assert(n1 == n2 && n1 > 2, "zero-copy KeptCache preserves exact item count across frames: " + n1.to_string() + " vs " + n2.to_string())
  html::cut(doc)
}

///|
test "Wave 96B: CSS 2.1 Appendix E iframe position:fixed respects z-index stacking order against higher-z non-fixed modal" {
  let outer_doc = html::parse("<!doctype html><html><body style='margin:0'><iframe style='display:block;width:400px;height:300px;border:0'></iframe></body></html>")
  let outer_eng = css::Engine::new(css::Env::new(400.0, 300.0))
  let outer_root = match layout::generate(outer_doc, outer_eng) { Some(b) => b None => panic("outer root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(outer_root, fonts, 400.0, 300.0, 0.0)
  let inner_doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='position:fixed;inset:0;z-index:1;background:#111111'></div>" +
    "<div style='position:relative;z-index:2;width:200px;height:100px;background:#ffffff'></div>" +
    "</body></html>",
  )
  let inner_eng = css::Engine::new(css::Env::new(400.0, 300.0))
  let inner_root = match layout::generate(inner_doc, inner_eng) { Some(b) => b None => panic("inner root") }
  layout::layout_with_scrollbar(inner_root, fonts, 400.0, 300.0, 0.0)
  let iframe_node = outer_doc.children[1].children[1].children[0]
  let frames : intmap::IntMap[layout::Box] = intmap::IntMap::new()
  frames.set(iframe_node.layout_id, inner_root)
  let ops = display_list_full(outer_root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], frames, false, None)
  let mut idx_veil = -1
  let mut idx_modal = -1
  for i in 0..<ops.length() {
    match ops[i] {
      Item::Rect(_, _, _, _, col) if col == 0x111111FF => idx_veil = i
      Item::Rect(_, _, _, _, col) if col == 0xFFFFFFFF => idx_modal = i
      _ => ()
    }
  }
  debug_assert(idx_veil >= 0 && idx_modal >= 0, "both iframe veil and modal must be painted")
  debug_assert(idx_veil < idx_modal, "z-index:1 position:fixed veil must paint BEFORE z-index:2 modal, got veil=" + idx_veil.to_string() + " modal=" + idx_modal.to_string())
  html::cut(inner_doc)
  html::cut(outer_doc)
}

///|
test "Wave 96B: CSS 2.1 Appendix E equal z-index preserves DOM tree order across non-SC positioned wrapper" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='position:absolute;inset:0;z-index:2147483646;background:#111111'></div>" +
    "<div style='overflow:hidden'><div style='position:relative'>" +
    "<div style='position:absolute;z-index:2147483646;width:200px;height:100px;background:#ffffff'></div>" +
    "</div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 300.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let ops = display_list(root, fonts)
  let mut idx_veil = -1
  let mut idx_modal = -1
  for i in 0..<ops.length() {
    match ops[i] {
      Item::Rect(_, _, _, _, col) if col == 0x111111FF => idx_veil = i
      Item::Rect(_, _, _, _, col) if col == 0xFFFFFFFF => idx_modal = i
      _ => ()
    }
  }
  debug_assert(idx_veil >= 0 && idx_modal >= 0, "both veil and modal must be painted")
  debug_assert(idx_veil < idx_modal, "earlier-in-DOM veil (z=2147483646) must paint BEFORE later-in-DOM bubbled modal (z=2147483646), got veil=" + idx_veil.to_string() + " modal=" + idx_modal.to_string())
  html::cut(doc)
}

///|
test "Wave 97B: P0 fix zero-copy KeptCache must not save c.fixed indices into items_buf arena" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='position:fixed;inset:0;z-index:10'>" +
    "<div style='width:100px;height:20px;background:#ff0000'></div>" +
    "<div style='width:100px;height:20px;background:#00ff00'></div>" +
    "<div style='width:100px;height:20px;background:#0000ff'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 300.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let kc = KeptCache::new()
  // Frame 1: items_buf only has 1 canvas Rect while fixed has 3 child Rects
  kc.items_buf.clear()
  let fixed1 : Array[Item] = []
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), fixed1, intmap::IntMap::new(), false, Some(kc), kc.items_buf, defer_arena_swap=true)
  kc.commit_items()
  // Frame 2: must NOT panic with index out of bounds when painting fixed children
  kc.items_buf.clear()
  let fixed2 : Array[Item] = []
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), fixed2, intmap::IntMap::new(), false, Some(kc), kc.items_buf, defer_arena_swap=true)
  debug_assert(fixed1.length() == fixed2.length() && fixed2.length() >= 3, "fixed layer must paint cleanly across frames without KeptCache OOB")
  html::cut(doc)
}

///|
test "Wave 16C: unfocused <input type='number'> omits permanent spin stepper so narrow values like '13' are not clipped" {
  let markup = "<!doctype html><html><body><input id='n' type='number' value='13' style='width:38px;height:22px'></body></html>"
  let doc = html::parse(markup)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen" })
  let root = match layout::generate(doc, engine) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let items = display_list(root, fonts)
  let mut clip_w = 0.0
  let mut saw_text = false
  for it in items {
    match it {
      Item::Clip(_, _, w, _) => if w > clip_w { clip_w = w }
      Item::Text(_, _, _, _, _, t, _, _) => if t == "13" { saw_text = true }
      _ => ()
    }
  }
  debug_assert(saw_text, "number input must draw full '13' text")
  debug_assert(clip_w >= 30.0, "unfocused 38px number input must not steal 20px for permanent stepper, clip_w=" + clip_w.to_string())
  html::cut(doc)
}

///|
test "Wave 98B: KeptCache shifts in_flow kept ops_lo/ops_hi after neg_bubbled z-index:-1 splice" {
  let doc = html::parse(
    "<!doctype html><html dir='rtl'><body style='margin:0'>" +
    "<ul style='margin:0;padding:0;overflow:hidden'>" +
    "<li style='display:inline-block;position:relative;z-index:2'>" +
    "<a style='display:flex;flex-direction:column;height:44px;color:#fff'>شاهد</a>" +
    "<div style='position:absolute;bottom:-1px;width:200px;height:1px;background:#cccccc;z-index:-1'></div>" +
    "</li></ul></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let kc = KeptCache::new()
  let mut frame = 0
  while frame < 4 {
    kc.items_buf.clear()
    display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], intmap::IntMap::new(), false, Some(kc), kc.items_buf, defer_arena_swap=true)
    let mut text_hits = 0
    let mut neg_rects = 0
    for op in kc.items_buf {
      match op {
        Item::Text(_, _, _, _, _, txt, _, _) if txt == "شاهد" => text_hits += 1
        Item::Rect(_, _, w, h, col) if col == 0xCCCCCCFF && (w - 200.0).abs() < 0.5 && (h - 1.0).abs() < 0.5 => neg_rects += 1
        _ => ()
      }
    }
    debug_assert(text_hits == 1, "frame " + frame.to_string() + " must preserve Item::Text('شاهد'), got " + text_hits.to_string())
    debug_assert(neg_rects == 1, "frame " + frame.to_string() + " must not duplicate z-index:-1 rect, got " + neg_rects.to_string())
    kc.commit_items()
    frame += 1
  }
  html::cut(doc)
}

///|
test "Wave 100B: SVG 2 §5.6 inline <svg> without viewBox referencing <symbol viewBox> via <use> preserves aspect ratio (meet)" {
  let markup = "<!doctype html><html><body style='margin:0'>" +
  "<svg style='display:none'><symbol id='icon-caret' viewBox='0 0 18 10'><path d='M9 0L0 10h18z'/></symbol></svg>" +
  "<button style='position:relative;width:120px;height:44px;border:0;padding:0'>" +
  "<svg id='ic' width='10' height='6' style='position:absolute;top:0;right:15px;height:100%'><use href='#icon-caret'></use></svg>" +
  "</button></body></html>"
  let doc = html::parse(markup)
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  // Register dummy rendered SVG key for the button's <svg id='ic'>
  let svgs : intmap::IntMap[String] = intmap::IntMap::new()
  let walk : Array[layout::Box] = [root]
  while walk.length() > 0 {
    match walk.pop() {
      Some(b) => {
        match b.node {
          Some(n) if n.tag == "svg" && n.attr("id").unwrap_or("") == "ic" => svgs.set(n.layout_id, "fv-svg:ic")
          _ => ()
        }
        for k in b.children { walk.push(k) }
      }
      None => break
    }
  }
  let ops = display_list_full(root, fonts, Map::new(), fn(_) { None }, svgs, [], intmap::IntMap::new(), false, None)
  let mut found_h = -1.0
  let mut found_y = -1.0
  for op in ops {
    match op {
      Item::Image(_, y, w, h, key, _) if key == "fv-svg:ic" => {
        found_h = h
        found_y = y
        debug_assert((w - 10.0).abs() < 0.5, "width must stay 10px, got " + w.to_string())
      }
      _ => ()
    }
  }
  debug_assert(found_h > 0.0 && (found_h - 6.0).abs() < 1.0, "caret SVG must preserve 10x6 aspect ratio instead of stretching to 44px, got h=" + found_h.to_string())
  debug_assert(found_y > 15.0 && found_y < 23.0, "caret SVG must center vertically inside 44px box (y~19), got y=" + found_y.to_string())
  html::cut(doc)
}

///|
test "Wave 17C: iframe paint must not leak into KeptCache or double-shift across frames" {
  let main_doc = html::parse(
    "<!doctype html><html><body style='margin:0'><div style='margin-left:80px;margin-top:100px'><iframe style='width:200px;height:120px;border:0'></iframe></div></body></html>",
  )
  let sub_doc = html::parse(
    "<!doctype html><html><body style='margin:0'><div style='width:40px;height:20px;background:#ff0000'></div></body></html>",
  )
  let e_main = css::Engine::new(css::Env::new(400.0, 300.0))
  let e_sub = css::Engine::new(css::Env::new(200.0, 120.0))
  let root = match layout::generate(main_doc, e_main) { Some(b) => b None => panic("root") }
  let sub = match layout::generate(sub_doc, e_sub) { Some(b) => b None => panic("sub") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  layout::layout_with_scrollbar(sub, fonts, 200.0, 120.0, 0.0)
  // Find iframe layout_id
  let mut iframe_lid = -1
  let stack = [root]
  while stack.pop() is Some(b) {
    match b.node {
      Some(n) if n.tag == "iframe" => iframe_lid = n.layout_id
      _ => ()
    }
    for ch in b.children {
      stack.push(ch)
    }
  }
  debug_assert(iframe_lid >= 0, "iframe layout_id found")
  let frames : intmap::IntMap[layout::Box] = intmap::IntMap::new()
  frames.set(iframe_lid, sub)
  let kc = KeptCache::new()
  let mut x1 = -1.0
  let mut y1 = -1.0
  let mut x2 = -1.0
  let mut y2 = -1.0
  // Frame 1
  kc.items_buf.clear()
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], frames, false, Some(kc), kc.items_buf, defer_arena_swap=true)
  for it in kc.items_buf {
    match it {
      Item::Rect(rx, ry, rw, rh, col) if col == 0xFF0000FF && rw == 40.0 && rh == 20.0 => { x1 = rx; y1 = ry }
      _ => ()
    }
  }
  kc.commit_items()
  // Frame 2 (must NOT double-shift by +(80, 100) from KeptCache!)
  kc.items_buf.clear()
  display_list_into(root, fonts, Map::new(), fn(_) { None }, intmap::IntMap::new(), [], frames, false, Some(kc), kc.items_buf, defer_arena_swap=true)
  for it in kc.items_buf {
    match it {
      Item::Rect(rx, ry, rw, rh, col) if col == 0xFF0000FF && rw == 40.0 && rh == 20.0 => { x2 = rx; y2 = ry }
      _ => ()
    }
  }
  debug_assert(x1 == 80.0 && y1 == 100.0, "Frame 1 iframe rect at (80,100), got (" + x1.to_string() + "," + y1.to_string() + ")")
  debug_assert(x2 == 80.0 && y2 == 100.0, "Frame 2 iframe rect must stay at (80,100), got (" + x2.to_string() + "," + y2.to_string() + ")")
  html::cut(sub_doc)
  html::cut(main_doc)
}

///|
test "Wave 18C: appearance:none <input type='range'> renders ::-webkit-slider-runnable-track and ::-webkit-slider-thumb even when input height is 0" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'><input type='range' min='0' max='100' value='50'></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  e.add_sheet(
    "input[type=range]{-webkit-appearance:none;background:transparent;height:0;width:200px}" +
    "input[type=range]::-webkit-slider-runnable-track{background:#001f3f;border-radius:3px;height:6px;width:100%}" +
    "input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;background:#001f3f;border-radius:50%;height:16px;width:16px}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_track = false
  let mut saw_thumb = false
  for it in items {
    match it {
      Item::Round(_, _, w, h, _, _, col) if col == 0x001F3FFF => {
        if w >= 190.0 && h == 6.0 { saw_track = true }
        if w == 16.0 && h == 16.0 { saw_thumb = true }
      }
      _ => ()
    }
  }
  debug_assert(saw_track, "custom ::-webkit-slider-runnable-track must be drawn")
  debug_assert(saw_thumb, "custom ::-webkit-slider-thumb must be drawn")
  html::cut(doc)
}

///|
test "Wave 19C: CSS Backgrounds 3 §5.1 elliptical border-radius '/' 8-value syntax & §5.5 overlap scaling" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'><div id='a' style='width:200px;height:100px;background:#ff00ff;border-radius:30% 70% 70% 30% / 30% 30% 70% 70%'></div><div id='b' style='width:100px;height:100px;background:#00ff00;border-radius:10px'></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 300.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_ellip = false
  let mut saw_fast4 = false
  for it in items {
    match it {
      Item::Round(_, _, w, h, r, _, col) => {
        if col == 0xFF00FFFF && w == 200.0 && h == 100.0 && r.length() == 8 {
          // 30% of 200 = 60, 70% of 200 = 140; 30% of 100 = 30, 70% of 100 = 70
          debug_assert((r[0] - 60.0).abs() < 0.01 && (r[1] - 140.0).abs() < 0.01, "rx must resolve against width")
          debug_assert((r[4] - 30.0).abs() < 0.01 && (r[6] - 70.0).abs() < 0.01, "ry must resolve against height")
          saw_ellip = true
        }
        if col == 0x00FF00FF && w == 100.0 && h == 100.0 && r.length() == 4 {
          saw_fast4 = true
        }
      }
      _ => ()
    }
  }
  debug_assert(saw_ellip, "8-value elliptical border-radius must emit 8 radii")
  debug_assert(saw_fast4, "circular border-radius must keep 4-element fast path")
  html::cut(doc)
}

///|
test "Wave 101B: <video> honors object-fit (default contain, cover) and object-position for poster/frames" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<video id='v1' style='display:block;width:200px;height:200px'></video>" +
    "<video id='v2' style='display:block;width:200px;height:200px;object-fit:cover'></video>" +
    "</body></html>",
  )
  // Populate natural 16:9 size (160x90) and poster/frame src_url on both videos
  let stack = [doc]
  while stack.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "video" {
      n.natural = Some((160.0, 90.0))
      match n.attr("id") {
        Some("v1") => n.src_url = Some("https://example.com/v1_poster.jpg")
        Some("v2") => n.src_url = Some("https://example.com/v2_poster.jpg")
        _ => ()
      }
    }
    for ch in n.children {
      stack.push(ch)
    }
  }
  let e = css::Engine::new(css::Env::new(400.0, 500.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 500.0, 0.0)
  let items = display_list(root, fonts)
  let mut v1_ok = false
  let mut v2_ok = false
  let mut v2_clipped = false
  let mut in_v2_clip = false
  for it in items {
    match it {
      Item::Clip(cx, cy, cw, ch) if cx.abs() < 0.5 && (cy - 200.0).abs() < 0.5 && (cw - 200.0).abs() < 0.5 && (ch - 200.0).abs() < 0.5 => {
        in_v2_clip = true
      }
      Item::Unclip => in_v2_clip = false
      Item::Image(x, y, w, h, u, _) if u == "https://example.com/v1_poster.jpg" => {
        // Default contain in 200x200 for 160x90 -> 200x112.5 centered at (0, 43.75)
        debug_assert((w - 200.0).abs() < 0.5 && (h - 112.5).abs() < 0.5, "default video object-fit:contain expected 200x112.5, got " + w.to_string() + "x" + h.to_string())
        debug_assert(x.abs() < 0.5 && (y - 43.75).abs() < 0.5, "default video contain centered y=43.75, got " + y.to_string())
        v1_ok = true
      }
      Item::Image(x, y, w, h, u, _) if u == "https://example.com/v2_poster.jpg" => {
        // object-fit:cover in 200x200 for 160x90 -> scale=200/90, w=355.56, h=200, x=-77.78
        debug_assert((w - 355.555).abs() < 1.0 && (h - 200.0).abs() < 0.5, "video object-fit:cover expected ~355.6x200, got " + w.to_string() + "x" + h.to_string())
        debug_assert((x + 77.777).abs() < 1.0 && (y - 200.0).abs() < 0.5, "video cover centered at x=-77.8,y=200, got (" + x.to_string() + "," + y.to_string() + ")")
        v2_ok = true
        v2_clipped = in_v2_clip
      }
      _ => ()
    }
  }
  debug_assert(v1_ok, "v1 video poster image item must be emitted")
  debug_assert(v2_ok, "v2 video poster image item must be emitted")
  debug_assert(v2_clipped, "Wave 102B: standalone <video object-fit:cover> must self-clip to its content box (HTML UA overflow:clip)")
  html::cut(doc)
}

///|
test "Wave 21C: textarea soft-wraps long lines, mix-blend-mode:difference resolves against backdrop, and rotated gradient slider thumb renders" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<textarea>M 4 8 L 10 1 L 13 0 L 12 3 L 5 9 C 6 10 6 11 7 10</textarea>" +
    "<div class='card'><div class='line'></div></div>" +
    "<input type='range' min='0' max='100' value='50'>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 400.0))
  e.add_sheet(
    "textarea{width:120px;height:100px;font-size:12px;padding:4px;border:0}" +
    ".card{background:#fff;width:200px;height:100px;position:relative}" +
    ".line{position:absolute;left:0;top:50px;width:200px;height:1px;background:#fff;mix-blend-mode:difference;opacity:0.4}" +
    "input[type=range]{appearance:none;width:200px;height:40px;background:transparent}" +
    "input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;background:linear-gradient(#62a6d7,#62a6d7);border:3px solid #fff;transform:rotate(45deg)}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let items = display_list(root, fonts)
  let mut ta_lines = 0
  let mut saw_diff_dark = false
  let mut saw_rot_thumb = false
  let mut saw_thumb_fill = false
  let mut saw_thumb_border = false
  for it in items {
    match it {
      Item::Text(_, _, _, _, _, _, _, _) => ta_lines += 1
      Item::Rect(_, _, w, h, c) if (w - 200.0).abs() < 0.5 && (h - 1.0).abs() < 0.5 => {
        let r = (c >> 24) & 0xFF
        let g = (c >> 16) & 0xFF
        let bl = (c >> 8) & 0xFF
        let al = c & 0xFF
        if r == 0 && g == 0 && bl == 0 && al > 50 { saw_diff_dark = true }
      }
      Item::Transform(_, _, a, _, _, _, _, _) if (a - 0.7071).abs() < 0.02 => saw_rot_thumb = true
      Item::Round(_, _, w, h, _, ring, c) if (w - 24.0).abs() < 0.5 && (h - 24.0).abs() < 0.5 => {
        if ring.length() == 0 && ((c >> 24) & 0xFF) == 0x62 { saw_thumb_fill = true }
        if ring.length() == 4 && (ring[0] - 3.0).abs() < 0.1 { saw_thumb_border = true }
      }
      _ => ()
    }
  }
  debug_assert(ta_lines >= 2, "textarea must soft-wrap long text into multiple lines, got " + ta_lines.to_string())
  debug_assert(saw_diff_dark, "mix-blend-mode:difference white line over white card must invert to dark gray")
  debug_assert(saw_rot_thumb, "rotated slider thumb must emit 45deg Item::Transform")
  debug_assert(saw_thumb_fill, "gradient slider thumb must emit fill with extracted gradient color")
  debug_assert(saw_thumb_border, "bordered slider thumb must emit 3px border ring")
  html::cut(doc)
}

///|
test "Wave 22C: KeptCache shifts z==0 positioned later subtrees after neg_bubbled z-index:-1 splice" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div class='bg'></div>" +
    "<div class='wrap'><div class='logo'><img id='p1' src='https://example.test/logo.png' width='70' height='30'></div>" +
    "<div class='abs'><img id='p2' src='https://example.test/astro.svg' width='200' height='200'></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet(
    ".bg{position:fixed;inset:0;z-index:-1;background:linear-gradient(45deg,#112233,#445566)}" +
    ".wrap{position:relative;width:800px;height:600px}" +
    ".abs{position:absolute;left:0;bottom:0}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let kept = KeptCache::new()
  let sizes : Map[String, (Double, Double)] = Map::new()
  sizes.set("https://example.test/logo.png", (70.0, 30.0))
  sizes.set("https://example.test/astro.svg", (200.0, 200.0))
  let fixed1 : Array[Item] = []
  let items1 = display_list_full(root, fonts, sizes, fn(u : String) -> Option[(Double, Double)] { sizes.get(u) }, intmap::IntMap::new(), fixed1, intmap::IntMap::new(), true, Some(kept))
  let fixed2 : Array[Item] = []
  let items2 = display_list_full(root, fonts, sizes, fn(u : String) -> Option[(Double, Double)] { sizes.get(u) }, intmap::IntMap::new(), fixed2, intmap::IntMap::new(), true, Some(kept))
  let count_imgs = fn(items : Array[Item]) -> Int {
    let mut n = 0
    for it in items {
      if it is Item::Image(_, _, _, _, _, _) { n += 1 }
    }
    n
  }
  let n1 = count_imgs(items1)
  let n2 = count_imgs(items2)
  debug_assert(n1 == 2, "frame 1 must emit 2 images, got " + n1.to_string())
  debug_assert(n2 == 2, "frame 2 KeptCache replay must preserve both images after neg_bubbled splice, got " + n2.to_string())
  html::cut(doc)
}

///|
test "Wave 24C: CSS Backgrounds 4 §2.10 background-clip:text suppresses solid background-color rectangle and tints transparent text" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;background:#0e141b'>" +
    "<h1 id='t'>Shadow Palette Generator</h1>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  e.add_sheet(
    "h1{display:inline-block;background-color:rgb(255,178,62);background-clip:text;-webkit-background-clip:text;color:transparent;font-size:32px}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_amber_rect = false
  let mut saw_amber_text = false
  for it in items {
    match it {
      Item::Rect(_, _, _, _, c) if ((c >> 24) & 0xFF) == 255 && ((c >> 16) & 0xFF) == 178 => saw_amber_rect = true
      Item::Text(_, _, _, _, c, _, _, _) if ((c >> 24) & 0xFF) == 255 && ((c >> 16) & 0xFF) == 178 => saw_amber_text = true
      _ => ()
    }
  }
  debug_assert(!saw_amber_rect, "background-clip:text must not emit a solid background-color rectangle")
  debug_assert(saw_amber_text, "background-clip:text with transparent text must fall back to amber background color")
  html::cut(doc)
}

///|
test "Wave 111B: CSS Backgrounds 3 §2.10 multi-layer background-image uses per-layer position, size, and repeat" {
  let doc = html::parse("<!doctype html><html><body style='margin:0'><div id='btn' style='width:100px;height:50px'>Give</div></body></html>")
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet(
    "#btn { background-image: url(https://example.test/bl.svg), url(https://example.test/tr.svg);" +
    " background-position: 0 100%, 100% 0; background-repeat: no-repeat, no-repeat; background-size: 20px, 10px; }",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let sizes : Map[String, (Double, Double)] = Map::new()
  sizes.set("https://example.test/bl.svg", (20.0, 20.0))
  sizes.set("https://example.test/tr.svg", (20.0, 20.0))
  let fixed : Array[Item] = []
  let items = display_list_full(root, fonts, sizes, fn(u : String) -> Option[(Double, Double)] { sizes.get(u) }, intmap::IntMap::new(), fixed, intmap::IntMap::new(), true, None)
  let mut saw_bl = false
  let mut saw_tr = false
  for it in items {
    match it {
      Item::Image(x, y, w, h, u, _) =>
      if u == "https://example.test/bl.svg" {
        debug_assert((x - 0.0).abs() < 0.5 && (y - 30.0).abs() < 0.5 && (w - 20.0).abs() < 0.5 && (h - 20.0).abs() < 0.5,
          "layer 0 bl.svg must be at (0, 30) 20x20, got (" + x.to_string() + "," + y.to_string() + ") " + w.to_string() + "x" + h.to_string())
        saw_bl = true
      } else if u == "https://example.test/tr.svg" {
        debug_assert((x - 90.0).abs() < 0.5 && (y - 0.0).abs() < 0.5 && (w - 10.0).abs() < 0.5 && (h - 10.0).abs() < 0.5,
          "layer 1 tr.svg must be at (90, 0) 10x10, got (" + x.to_string() + "," + y.to_string() + ") " + w.to_string() + "x" + h.to_string())
        saw_tr = true
      }
      _ => ()
    }
  }
  debug_assert(saw_bl && saw_tr, "both multi-layer background images must be emitted at their per-layer rects")
  html::cut(doc)
}

///|
test "Wave 25C: ::-webkit-slider-runnable-track linear-gradient background and 2D small-period gradient tiling (>256 tiles)" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<input id='s1' type='range' min='0' max='100' value='33' style='--p:33%'>" +
    "<div id='pat'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 400.0))
  e.add_sheet(
    "input[type=range]{-webkit-appearance:none;appearance:none;width:240px;height:20px;background:transparent}" +
    "input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:linear-gradient(90deg,#88f903 var(--p),#ffffff var(--p))}" +
    "input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:#ffffff}" +
    "#pat{width:280px;height:200px;background-image:radial-gradient(#444cf7 0.5px,transparent 0.5px);background-size:10px 10px}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_track_grad = false
  let mut radial_tiles = 0
  for it in items {
    match it {
      Item::Gradient(_, _, w, h, kind, _, _, _) if kind == 0 && (w - 240.0).abs() < 1.0 && (h - 6.0).abs() < 1.0 => saw_track_grad = true
      Item::Gradient(_, _, w, h, kind, _, _, _) if kind == 1 && (w - 10.0).abs() < 0.5 && (h - 10.0).abs() < 0.5 => radial_tiles += 1
      _ => ()
    }
  }
  debug_assert(saw_track_grad, "::-webkit-slider-runnable-track linear-gradient must emit Item::Gradient")
  debug_assert(radial_tiles >= 500, "280x200 10x10px radial pattern must emit >=500 tiles without 256 cutoff, got " + radial_tiles.to_string())
  html::cut(doc)
}

///|
test "Wave 26C: CSS Backgrounds 4 background-position-x and background-position-y offset sprite background images" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='ic'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  e.add_sheet(
    "#ic{width:30px;height:40px;background-image:url(https://example.test/sprite.svg);background-repeat:no-repeat;background-position-y:50%;background-position-x:-150px}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let sizes : Map[String, (Double, Double)] = Map::new()
  sizes.set("https://example.test/sprite.svg", (300.0, 30.0))
  let fixed : Array[Item] = []
  let items = display_list_full(root, fonts, sizes, fn(u : String) -> Option[(Double, Double)] { sizes.get(u) }, intmap::IntMap::new(), fixed, intmap::IntMap::new(), true, None)
  let mut saw_sprite = false
  for it in items {
    match it {
      Item::Image(x, y, w, h, u, _) if u == "https://example.test/sprite.svg" => {
        debug_assert((x - -150.0).abs() < 0.5 && (y - 5.0).abs() < 0.5 && (w - 300.0).abs() < 0.5 && (h - 30.0).abs() < 0.5,
          "sprite must be placed at (-150, 5) 300x30, got (" + x.to_string() + "," + y.to_string() + ") " + w.to_string() + "x" + h.to_string())
        saw_sprite = true
      }
      _ => ()
    }
  }
  debug_assert(saw_sprite, "sprite background-image with background-position-x/-y must be emitted")
  html::cut(doc)
}

///|
test "Wave 115B: background-clip: text with diagonal -webkit-linear-gradient(315deg) interpolates per-character left-to-right" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<span id='g1'>Progressive</span>" +
    "<span id='g2'>Diagonal</span>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  e.add_sheet(
    "#g1{font-size:48px;background:-webkit-linear-gradient(315deg,#42d392 25%,#647eff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}" +
    "#g2{font-size:48px;background:linear-gradient(135deg,#ff0000,#0000ff);background-clip:text;color:transparent}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut p_col = 0
  let mut e_col = 0
  let mut d_col = 0
  let mut l_col = 0
  for it in items {
    match it {
      Item::Text(_, _, _, _, rgba, txt, _, _) => {
        if txt == "P" && p_col == 0 { p_col = rgba }
        if txt == "e" { e_col = rgba }
        if txt == "D" && d_col == 0 { d_col = rgba }
        if txt == "l" { l_col = rgba }
      }
      _ => ()
    }
  }
  let p_g = (p_col >> 16) & 0xFF
  let p_b = (p_col >> 8) & 0xFF
  let e_g = (e_col >> 16) & 0xFF
  let e_b = (e_col >> 8) & 0xFF
  debug_assert(p_col != 0 && p_g > p_b + 40, "first char P of -webkit-linear-gradient(315deg,#42d392,#647eff) must be green-dominant")
  debug_assert(e_col != 0 && e_b > e_g + 40, "last char e of -webkit-linear-gradient(315deg,#42d392,#647eff) must be blue-dominant")
  let d_r = (d_col >> 24) & 0xFF
  let d_b = (d_col >> 8) & 0xFF
  let l_r = (l_col >> 24) & 0xFF
  let l_b = (l_col >> 8) & 0xFF
  debug_assert(d_col != 0 && d_r > d_b + 80, "first char D of linear-gradient(135deg,#ff0000,#0000ff) must be red-dominant")
  debug_assert(l_col != 0 && l_b > l_r + 80, "last char l of linear-gradient(135deg,#ff0000,#0000ff) must be blue-dominant")
  html::cut(doc)
}

///|
test "Wave 28C: CSS Masking 1 clip-path:polygon clips solid background and linear-gradient boxes as vector SVG polygons" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='solid'></div>" +
    "<div id='grad'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 400.0))
  e.add_sheet(
    "#solid{width:100px;height:100px;background-color:#3b82f6;clip-path:polygon(50% 0%,0% 100%,100% 100%)}" +
    "#grad{width:100px;height:100px;background-image:linear-gradient(135deg,#4f46e5,#9333ea);clip-path:polygon(50% 0%,100% 38%,82% 100%,18% 100%,0% 38%)}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_solid_poly = false
  let mut saw_grad_poly = false
  for it in items {
    match it {
      Item::Image(_, _, w, h, u, _) if (w - 100.0).abs() < 0.5 && (h - 100.0).abs() < 0.5 && u.starts_with("data:image/svg+xml,") => {
        if u.contains("<polygon points='50,0 0,100 100,100'") { saw_solid_poly = true }
        if u.contains("<linearGradient id='g'") && u.contains("fill='url(%23g)'") { saw_grad_poly = true }
      }
      _ => ()
    }
  }
  debug_assert(saw_solid_poly, "clip-path:polygon on solid rect must emit vector SVG polygon")
  debug_assert(saw_grad_poly, "clip-path:polygon on linear-gradient must emit vector SVG gradient polygon")
  html::cut(doc)
}

///|
test "Wave 116B: CSS Pseudo-Elements 4 ::first-letter colors only the first letter of a block" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<h2>Versatile</h2>" +
    "<h2>User-friendly</h2>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  e.add_sheet("h2{font-size:20px;color:#213547}h2::first-letter{color:#42b883}")
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_v_green = false
  let mut saw_rest_dark = false
  let mut saw_u_green = false
  for it in items {
    match it {
      Item::Text(_, _, _, _, rgba, txt, _, _) => {
        if txt == "V" && rgba == 0x42B883FF { saw_v_green = true }
        if txt == "ersatile" && rgba == 0x213547FF { saw_rest_dark = true }
        if txt == "U" && rgba == 0x42B883FF { saw_u_green = true }
      }
      _ => ()
    }
  }
  debug_assert(saw_v_green, "first letter 'V' must be colored #42b883 by ::first-letter")
  debug_assert(saw_rest_dark, "remainder 'ersatile' must keep element color #213547")
  debug_assert(saw_u_green, "first letter 'U' of second h2 must be colored #42b883")
  html::cut(doc)
}

///|
test "Wave 117B: SVG 2 §7.8 viewBox-only <img> preserves aspect ratio (xMidYMid meet) when width:100% is clamped by max-height" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:1000px'><img id='logo' src='https://example.test/logo.svg' style='width:100%;height:100px;max-height:100px'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(1000.0, 400.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 1000.0, 400.0, 0.0)
  let sizes : Map[String, (Double, Double)] = Map::new()
  // Negative sentinel (-w, -h) marks a viewBox-only SVG without fixed width/height attributes.
  sizes.set("https://example.test/logo.svg", (-400.0, -100.0))
  let fixed : Array[Item] = []
  let items = display_list_full(root, fonts, sizes, fn(u : String) -> Option[(Double, Double)] { sizes.get(u) }, intmap::IntMap::new(), fixed, intmap::IntMap::new(), true, None)
  let mut saw_logo = false
  for it in items {
    match it {
      Item::Image(x, y, w, h, u, _) if u == "https://example.test/logo.svg" => {
        debug_assert((w - 400.0).abs() < 1.0 && (h - 100.0).abs() < 1.0,
          "viewBox-only 4:1 SVG in 1000x100 box must fit 400x100 (xMidYMid meet), got " + w.to_string() + "x" + h.to_string())
        debug_assert((x - 300.0).abs() < 1.0 && y.abs() < 1.0,
          "viewBox-only 4:1 SVG must be centered at x=300, got (" + x.to_string() + "," + y.to_string() + ")")
        saw_logo = true
      }
      _ => ()
    }
  }
  debug_assert(saw_logo, "viewBox-only SVG <img> must emit Item::Image")
  html::cut(doc)
}

///|
test "Wave 118B: CSS Backgrounds 4 §2.11 semi-transparent -webkit-text-fill-color composites over ancestor background-clip:text gradient" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<nav><ul><li><a href='#'>Documentation</a></li></ul></nav>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  e.add_sheet(
    "nav>ul{background:linear-gradient(to right,rgb(100 190 121),rgb(54 206 255));background-clip:text;-webkit-background-clip:text}" +
    "nav>ul>li>a{-webkit-text-fill-color:rgba(0 0 0 / .1);font-size:16px}",
  )
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut d_col = 0
  let mut n_col = 0
  for it in items {
    match it {
      Item::Text(_, _, _, _, rgba, txt, _, _) => {
        if txt == "D" && d_col == 0 { d_col = rgba }
        if txt == "n" { n_col = rgba }
      }
      _ => ()
    }
  }
  let d_g = (d_col >> 16) & 0xFF
  let d_a = d_col & 0xFF
  let n_b = (n_col >> 8) & 0xFF
  let n_a = n_col & 0xFF
  debug_assert(d_col != 0 && d_a == 255 && d_g > 150, "first char D must composite rgba(0,0,0,0.1) over bright green gradient stop")
  debug_assert(n_col != 0 && n_a == 255 && n_b > 200, "last char n must composite rgba(0,0,0,0.1) over bright cyan gradient stop")
  html::cut(doc)
}

///|
test "Wave 119B: CSS Color 4 space-separated rgb() stops in linear-gradient emit exact RGBA colors" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='hero'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  e.add_sheet("#hero{width:400px;height:120px;background-image:linear-gradient(to right, rgb(0 190 255), rgb(137 44 220))}")
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_grad = false
  for it in items {
    match it {
      Item::Gradient(_, _, w, h, kind, _, _, cols) if kind == 0 && (w - 400.0).abs() < 0.5 && (h - 120.0).abs() < 0.5 => {
        debug_assert(cols.length() == 2, "linear-gradient must have 2 stops")
        debug_assert(cols[0] == 0x00BEFFFF, "first stop must be rgb(0 190 255)")
        debug_assert(cols[1] == 0x892CDCFF, "second stop must be rgb(137 44 220)")
        saw_grad = true
      }
      _ => ()
    }
  }
  debug_assert(saw_grad, "hero linear-gradient with CSS Color 4 space-separated rgb() must emit Item::Gradient")
  html::cut(doc)
}

///|
test "Wave 122B: CSS Text 3 §9.1 text-indent offsets <input type='search'> placeholder and value text" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<input id='s' type='search' placeholder='Search this site...' style='width:200px;height:32px;padding:0;border:0;font-size:16px;text-indent:1.25em'>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_placeholder = false
  for it in items {
    match it {
      Item::Text(_, _, x, _, _, txt, _, _) if txt == "Search this site..." => {
        // 1.25em * 16px = 20px (+ 1px inner margin = 21px)
        debug_assert((x - 21.0).abs() < 1.0, "search input placeholder must be indented by 1.25em (20px), got x=" + x.to_string())
        saw_placeholder = true
      }
      _ => ()
    }
  }
  debug_assert(saw_placeholder, "search input placeholder Item::Text must be emitted")
  html::cut(doc)
}

test "Wave 31C: native input[type=file] renders Choose File button and status label with transparent UA background" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<input id='f1' type='file'>" +
    "<input id='f2' type='file' multiple>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(600.0, 200.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let items = display_list(root, fonts)
  let mut saw_choose = false
  let mut saw_no_file = false
  let mut saw_choose_multi = false
  for it in items {
    match it {
      Item::Text(_, _, _, _, _, txt, _, _) => {
        if txt == "Choose File" { saw_choose = true }
        if txt == "No file chosen" { saw_no_file = true }
        if txt == "Choose Files" { saw_choose_multi = true }
      }
      _ => ()
    }
  }
