///| Modern CSS visual effects: backdrop-filter, filter, and clip-path.
///| 1:1 port of `client/src/display/effects.mbt`.

import "css"
import "layout"

struct ColorMat {
  m : Array[Double]
}

fn disp_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i += 1
  }
  if !has_upper {
    return s
  }
  let b = StringBuilder::new()
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      b.write_byte((c + 32).to_byte())
    } else {
      b.write_byte(c.to_byte())
    }
    i += 1
  }
  b.to_string()
}

fn mat_zeros() -> Array[Double] {
  let m : Array[Double] = []
  for _ in 0..<20 {
    m.push(0.0)
  }
  m
}

fn ColorMat::identity() -> ColorMat {
  let m = mat_zeros()
  m[0] = 1.0
  m[6] = 1.0
  m[12] = 1.0
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn ColorMat::mul(self : ColorMat, b : ColorMat) -> ColorMat {
  let out = mat_zeros()
  for r in 0..<4 {
    for c in 0..<5 {
      let mut s = 0.0
      for k in 0..<4 {
        s += self.m[r * 5 + k] * b.m[k * 5 + c]
      }
      if c == 4 {
        s += self.m[r * 5 + 4]
      }
      out[r * 5 + c] = s
    }
  }
  ColorMat::{ m: out }
}

fn ColorMat::apply_rgba(self : ColorMat, col : Int) -> Int {
  let r = ((col >> 24) & 0xFF).to_double() / 255.0
  let g = ((col >> 16) & 0xFF).to_double() / 255.0
  let b = ((col >> 8) & 0xFF).to_double() / 255.0
  let a = (col & 0xFF).to_double() / 255.0
  let m = self.m
  let nr = m[0] * r + m[1] * g + m[2] * b + m[3] * a + m[4]
  let ng = m[5] * r + m[6] * g + m[7] * b + m[8] * a + m[9]
  let nb = m[10] * r + m[11] * g + m[12] * b + m[13] * a + m[14]
  let na = m[15] * r + m[16] * g + m[17] * b + m[18] * a + m[19]
  let clamp = fn(v : Double) -> Int {
    let x = (v * 255.0 + 0.5).floor().to_int()
    if x < 0 { 0 } else if x > 255 { 255 } else { x }
  }
  (clamp(nr) << 24) | (clamp(ng) << 16) | (clamp(nb) << 8) | clamp(na)
}

fn grayscale_mat(amount : Double) -> ColorMat {
  let s = dmax(0.0, dmin(1.0, amount))
  let inv = 1.0 - s
  let m = mat_zeros()
  m[0] = 0.2126 + 0.7874 * inv
  m[1] = 0.7152 - 0.7152 * inv
  m[2] = 0.0722 - 0.0722 * inv
  m[5] = 0.2126 - 0.2126 * inv
  m[6] = 0.7152 + 0.2848 * inv
  m[7] = 0.0722 - 0.0722 * inv
  m[10] = 0.2126 - 0.2126 * inv
  m[11] = 0.7152 - 0.7152 * inv
  m[12] = 0.0722 + 0.9278 * inv
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn saturate_mat(s0 : Double) -> ColorMat {
  let s = dmax(0.0, s0)
  let m = mat_zeros()
  m[0] = 0.213 + 0.787 * s
  m[1] = 0.715 - 0.715 * s
  m[2] = 0.072 - 0.072 * s
  m[5] = 0.213 - 0.213 * s
  m[6] = 0.715 + 0.285 * s
  m[7] = 0.072 - 0.072 * s
  m[10] = 0.213 - 0.213 * s
  m[11] = 0.715 - 0.715 * s
  m[12] = 0.072 + 0.928 * s
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn brightness_mat(b0 : Double) -> ColorMat {
  let b = dmax(0.0, b0)
  let m = mat_zeros()
  m[0] = b
  m[6] = b
  m[12] = b
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn contrast_mat(c0 : Double) -> ColorMat {
  let c = dmax(0.0, c0)
  let t = 0.5 * (1.0 - c)
  let m = mat_zeros()
  m[0] = c
  m[4] = t
  m[6] = c
  m[9] = t
  m[12] = c
  m[14] = t
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn sepia_mat(amount : Double) -> ColorMat {
  let s = dmax(0.0, dmin(1.0, amount))
  let inv = 1.0 - s
  let m = mat_zeros()
  m[0] = 0.393 + 0.607 * inv
  m[1] = 0.769 - 0.769 * inv
  m[2] = 0.189 - 0.189 * inv
  m[5] = 0.349 - 0.349 * inv
  m[6] = 0.686 + 0.314 * inv
  m[7] = 0.168 - 0.168 * inv
  m[10] = 0.272 - 0.272 * inv
  m[11] = 0.534 - 0.534 * inv
  m[12] = 0.131 + 0.869 * inv
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn invert_mat(amount : Double) -> ColorMat {
  let s = dmax(0.0, dmin(1.0, amount))
  let k = 1.0 - 2.0 * s
  let m = mat_zeros()
  m[0] = k
  m[4] = s
  m[6] = k
  m[9] = s
  m[12] = k
  m[14] = s
  m[18] = 1.0
  ColorMat::{ m: m }
}

fn css_functions(toks : Array[css::Tok]) -> Array[(String, Array[css::Tok])] {
  let out : Array[(String, Array[css::Tok])] = []
  let mut i = 0
  while i < toks.length() {
    match toks[i] {
      css::Tok::Function(name) => {
        let args : Array[css::Tok] = []
        let mut depth = 1
        i += 1
        while i < toks.length() && depth > 0 {
          match toks[i] {
            css::Tok::Function(_) => {
              depth += 1
              args.push(toks[i])
            }
            css::Tok::OpenParen => {
              depth += 1
              args.push(toks[i])
            }
            css::Tok::CloseParen => {
              depth -= 1
              if depth > 0 {
                args.push(toks[i])
              }
            }
            t => args.push(t)
          }
          i += 1
        }
        out.push((disp_ascii_lower(name), args))
      }
      _ => i += 1
    }
  }
  out
}

fn filter_amount(args : Array[css::Tok], default_val : Double) -> Double {
  for t in args {
    match t {
      css::Tok::Number(n) => return n
      css::Tok::Percentage(p) => return p / 100.0
      _ => ()
    }
  }
  default_val
}

fn filter_px(s : css::Style, args : Array[css::Tok]) -> Double {
  let ws = css::words(args)
  if ws.length() == 0 {
    return 0.0
  }
  match s.length_of(ws[0]) {
    Some(l) => dmax(0.0, l.px)
    None => 0.0
  }
}

struct EffectMasks {
  mut ready : Bool
  mut filter_m0 : Int64
  mut filter_m1 : Int64
  mut filter_m2 : Int64
  mut filter_m3 : Int64
  mut backdrop_m0 : Int64
  mut backdrop_m1 : Int64
  mut backdrop_m2 : Int64
  mut backdrop_m3 : Int64
  mut clip_m0 : Int64
  mut clip_m1 : Int64
  mut clip_m2 : Int64
  mut clip_m3 : Int64
  mut any_m0 : Int64
  mut any_m1 : Int64
  mut any_m2 : Int64
  mut any_m3 : Int64
}

let effect_masks : EffectMasks = EffectMasks::{
  ready: false,
  filter_m0: 0L,
  filter_m1: 0L,
  filter_m2: 0L,
  filter_m3: 0L,
  backdrop_m0: 0L,
  backdrop_m1: 0L,
  backdrop_m2: 0L,
  backdrop_m3: 0L,
  clip_m0: 0L,
  clip_m1: 0L,
  clip_m2: 0L,
  clip_m3: 0L,
  any_m0: 0L,
  any_m1: 0L,
  any_m2: 0L,
  any_m3: 0L,
}

fn mask_quad_of_2(id0 : Int, id1 : Int) -> (Int64, Int64, Int64, Int64) {
  (
    css::mask_bit_in(id0, 0) | css::mask_bit_in(id1, 0),
    css::mask_bit_in(id0, 1) | css::mask_bit_in(id1, 1),
    css::mask_bit_in(id0, 2) | css::mask_bit_in(id1, 2),
    css::mask_bit_in(id0, 3) | css::mask_bit_in(id1, 3),
  )
}

fn ensure_effect_masks() -> Unit {
  if effect_masks.ready { return }
  let (fm0, fm1, fm2, fm3) = mask_quad_of_2(css::p_filter, css::p__webkit_filter)
  effect_masks.filter_m0 = fm0
  effect_masks.filter_m1 = fm1
  effect_masks.filter_m2 = fm2
  effect_masks.filter_m3 = fm3
  let (bm0, bm1, bm2, bm3) = mask_quad_of_2(css::p_backdrop_filter, css::p__webkit_backdrop_filter)
  effect_masks.backdrop_m0 = bm0
  effect_masks.backdrop_m1 = bm1
  effect_masks.backdrop_m2 = bm2
  effect_masks.backdrop_m3 = bm3
  let (cm0, cm1, cm2, cm3) = mask_quad_of_2(css::p_clip_path, css::p__webkit_clip_path)
  effect_masks.clip_m0 = cm0
  effect_masks.clip_m1 = cm1
  effect_masks.clip_m2 = cm2
  effect_masks.clip_m3 = cm3
  effect_masks.any_m0 = fm0 | cm0
  effect_masks.any_m1 = fm1 | cm1
  effect_masks.any_m2 = fm2 | cm2
  effect_masks.any_m3 = fm3 | cm3
  effect_masks.ready = true
}

fn parse_backdrop_filter(s : css::Style) -> Option[(Double, Double)] {
  ensure_effect_masks()
  if !s.values.has_any_mask(effect_masks.backdrop_m0, effect_masks.backdrop_m1, effect_masks.backdrop_m2, effect_masks.backdrop_m3) {
    return None
  }
  let mut toks = s.own_id(css::p_backdrop_filter)
  if toks.length() == 0 {
    toks = s.own_id(css::p__webkit_backdrop_filter)
  }
  if toks.length() == 0 {
    return None
  }
  let mut blur = 0.0
  let mut sat = 1.0
  for f in css_functions(toks) {
    if f.0 == "blur" {
      blur = filter_px(s, f.1)
    } else if f.0 == "saturate" {
      sat = dmax(0.0, filter_amount(f.1, 1.0))
    }
  }
  if blur > 0.0 { Some((blur, sat)) } else { None }
}

struct FilterChain {
  opacity : Double
  has_mat : Bool
  mat : ColorMat
  shadows : Array[css::BoxShadow]
  blur : Double
}

fn parse_drop_shadow(s : css::Style, args : Array[css::Tok]) -> Option[css::BoxShadow] {
  let ws = css::words(args)
  let lens : Array[Double] = []
  let mut col : Option[css::Color] = None
  for w in ws {
    match s.length_of(w) {
      Some(l) => lens.push(l.px)
      None =>
      if col.is_none() {
        match css::parse_color(w, 0) {
          Some(c) => col = Some(c)
          None => ()
        }
      }
    }
  }
  if lens.length() < 2 {
    return None
  }
  let dx = lens[0]
  let dy = lens[1]
  let blur = if lens.length() >= 3 { dmax(0.0, lens[2]) } else { 0.0 }
  let color = match col {
    Some(c) => c
    None =>
    match s.color_id(css::p_color) {
      Some(c) => c
      None => css::Color::{ r: 0, g: 0, b: 0, a: 1.0 }
    }
  }
  Some(css::BoxShadow::{ dx: dx, dy: dy, blur: blur, spread: 0.0, color: color, inset: false })
}

fn parse_filter(s : css::Style) -> Option[FilterChain] {
  ensure_effect_masks()
  if !s.values.has_any_mask(effect_masks.filter_m0, effect_masks.filter_m1, effect_masks.filter_m2, effect_masks.filter_m3) {
    return None
  }
  let mut toks = s.own_id(css::p_filter)
  if toks.length() == 0 {
    toks = s.own_id(css::p__webkit_filter)
  }
  if toks.length() == 0 {
    return None
  }
  let fns = css_functions(toks)
  if fns.length() == 0 {
    return None
  }
  let mut opacity = 1.0
  let mut has_mat = false
  let mut mat = ColorMat::identity()
  let shadows : Array[css::BoxShadow] = []
  let mut blur = 0.0
  for f in fns {
    if f.0 == "opacity" {
      opacity = opacity * dmax(0.0, dmin(1.0, filter_amount(f.1, 1.0)))
    } else if f.0 == "grayscale" {
      has_mat = true
      mat = grayscale_mat(filter_amount(f.1, 1.0)).mul(mat)
    } else if f.0 == "saturate" {
      has_mat = true
      mat = saturate_mat(filter_amount(f.1, 1.0)).mul(mat)
    } else if f.0 == "brightness" {
      has_mat = true
      mat = brightness_mat(filter_amount(f.1, 1.0)).mul(mat)
    } else if f.0 == "contrast" {
      has_mat = true
      mat = contrast_mat(filter_amount(f.1, 1.0)).mul(mat)
    } else if f.0 == "sepia" {
      has_mat = true
      mat = sepia_mat(filter_amount(f.1, 1.0)).mul(mat)
    } else if f.0 == "invert" {
      has_mat = true
      mat = invert_mat(filter_amount(f.1, 1.0)).mul(mat)
    } else if f.0 == "drop-shadow" {
      match parse_drop_shadow(s, f.1) {
        Some(sh) => shadows.push(sh)
        None => ()
      }
    } else if f.0 == "blur" {
      blur += filter_px(s, f.1)
    }
  }
  if opacity == 1.0 && !has_mat && shadows.length() == 0 && blur == 0.0 {
    None
  } else {
    Some(FilterChain::{ opacity: opacity, has_mat: has_mat, mat: mat, shadows: shadows, blur: blur })
  }
}

fn encode_color_mat_url(mat : ColorMat, u : String) -> String {
  if u == "" || u.starts_with("fvflt:") {
    return u
  }
  let sb = StringBuilder::new()
  sb.write_string("fvflt:")
  for i in 0..<20 {
    if i > 0 { sb.write_string(",") }
    sb.write_string(mat.m[i].to_string())
  }
  sb.write_string("|")
  sb.write_string(u)
  sb.to_string()
}

fn apply_color_mat(ops : Array[Item], start : Int, mat : ColorMat) -> Unit {
  for i in start..<ops.length() {
    ops[i] = match ops[i] {
      Item::Rect(x, y, w, h, c) => Item::Rect(x, y, w, h, mat.apply_rgba(c))
      Item::Round(x, y, w, h, r, ring, c) => Item::Round(x, y, w, h, r, ring, mat.apply_rgba(c))
      Item::Text(f, sz, x, y, c, t, l, w) => Item::Text(f, sz, x, y, mat.apply_rgba(c), t, l, w)
      Item::VText(f, sz, c, t, turned, x, y) => Item::VText(f, sz, mat.apply_rgba(c), t, turned, x, y)
      Item::Image(x, y, w, h, u, a) => Item::Image(x, y, w, h, encode_color_mat_url(mat, u), a)
      Item::Mask(x, y, w, h, u, c) => Item::Mask(x, y, w, h, u, mat.apply_rgba(c))
      Item::Gradient(x, y, w, h, k, g, o, cols) => {
        let nc : Array[Int] = []
        for col in cols { nc.push(mat.apply_rgba(col)) }
        Item::Gradient(x, y, w, h, k, g, o, nc)
      }
      Item::Shadow(x, y, w, h, g, c, inset) => Item::Shadow(x, y, w, h, g, mat.apply_rgba(c), inset)
      Item::Backdrop(x, y, w, h, r, blur, sat, tint) => Item::Backdrop(x, y, w, h, r, blur, sat, mat.apply_rgba(tint))
      other => other
    }
  }
}

fn resolve_len_pct(s : css::Style, w : Array[css::Tok], basis : Double) -> Option[Double] {
  match s.length_of(w) {
    Some(l) => Some(l.px + l.pct * basis / 100.0)
    None => None
  }
}

fn single_ident_lower(w : Array[css::Tok]) -> String {
  if w.length() == 1 {
    match w[0] {
      css::Tok::Ident(k) => disp_ascii_lower(k)
      _ => ""
    }
  } else {
    ""
  }
}

fn parse_clip_path(b : layout::Box) -> Option[Item] {
  if b.kind is layout::Kind::Inline || b.w <= 0.0 || b.h <= 0.0 {
    return None
  }
  let s = b.style
  ensure_effect_masks()
  if !s.values.has_any_mask(effect_masks.clip_m0, effect_masks.clip_m1, effect_masks.clip_m2, effect_masks.clip_m3) {
    return None
  }
  let mut toks = s.own_id(css::p_clip_path)
  if toks.length() == 0 {
    toks = s.own_id(css::p__webkit_clip_path)
  }
  if toks.length() == 0 {
    return None
  }
  let fns = css_functions(toks)
  if fns.length() == 0 {
    return None
  }
  let (name, args) = fns[0]
  if name == "inset" {
    let ws = css::words(args)
    let edges : Array[Double] = []
    let rads : Array[Double] = []
    let mut in_round = false
    for w in ws {
      if single_ident_lower(w) == "round" {
        in_round = true
        continue
      }
      if !in_round {
        let basis = if edges.length() % 2 == 0 { b.h } else { b.w }
        match resolve_len_pct(s, w, basis) {
          Some(v) => edges.push(v)
          None => ()
        }
      } else {
        // W3C CSS Shapes 1 §2.2 / Backgrounds 3 §5.1: stop horizontal corner radii at `/`
        // so vertical radii do not overwrite the 4 corner slots.
        let mut slash_idx = -1
        for ti, tk in w {
          match tk {
            css::Tok::Delim(47) => { slash_idx = ti; break }
            _ => ()
          }
        }
        if slash_idx == 0 {
          break
        }
        let rad_toks = if slash_idx > 0 {
          let pre : Array[css::Tok] = []
          let mut pi = 0
          while pi < slash_idx {
            pre.push(w[pi])
            pi += 1
          }
          pre
        } else {
          w
        }
        match resolve_len_pct(s, rad_toks, dmin(b.w, b.h)) {
          Some(v) => rads.push(dmax(0.0, v))
          None => ()
        }
        if slash_idx > 0 {
          break
        }
      }
    }
    if edges.length() == 0 {
      return None
    }
    let top = edges[0]
    let right = if edges.length() >= 2 { edges[1] } else { top }
    let bottom = if edges.length() >= 3 { edges[2] } else { top }
    let left = if edges.length() >= 4 { edges[3] } else { right }
    let cx = b.x + left
    let cy = b.y + top
    let cw = dmax(0.0, b.w - left - right)
    let ch = dmax(0.0, b.h - top - bottom)
    let mut any_pos = false
    for v in rads { if v > 0.0 { any_pos = true; break } }
    if rads.length() > 0 && any_pos {
      let r0 = rads[0]
      let r1 = if rads.length() >= 2 { rads[1] } else { r0 }
      let r2 = if rads.length() >= 3 { rads[2] } else { r0 }
      let r3 = if rads.length() >= 4 { rads[3] } else { r1 }
      Some(Item::RoundClip(cx, cy, cw, ch, [r0, r1, r2, r3]))
    } else {
      Some(Item::Clip(cx, cy, cw, ch))
    }
  } else if name == "circle" {
    let ws = css::words(args)
    let mut at_idx = -1
    for i, w in ws {
      if single_ident_lower(w) == "at" {
        at_idx = i
        break
      }
    }
    let mut cx = b.w / 2.0
    let mut cy = b.h / 2.0
    if at_idx >= 0 {
      let pos_at = fn(w : Array[css::Tok], room : Double) -> Option[Double] {
        let k = single_ident_lower(w)
        if k == "left" || k == "top" {
          Some(0.0)
        } else if k == "center" {
          Some(room / 2.0)
        } else if k == "right" || k == "bottom" {
          Some(room)
        } else {
          resolve_len_pct(s, w, room)
        }
      }
      if at_idx + 1 < ws.length() {
        match pos_at(ws[at_idx + 1], b.w) { Some(v) => cx = v None => () }
      }
      if at_idx + 2 < ws.length() {
        match pos_at(ws[at_idx + 2], b.h) { Some(v) => cy = v None => () }
      }
    }
    let ref_len = ((b.w * b.w + b.h * b.h) / 2.0).sqrt()
    let closest = dmin(dmin(cx, b.w - cx), dmin(cy, b.h - cy))
    let farthest = dmax(dmax(cx, b.w - cx), dmax(cy, b.h - cy))
    let rad = if at_idx == 0 || ws.length() == 0 {
      dmax(0.0, closest)
    } else {
      let k = single_ident_lower(ws[0])
      if k == "closest-side" {
        dmax(0.0, closest)
      } else if k == "farthest-side" {
        dmax(0.0, farthest)
      } else {
        let v = match resolve_len_pct(s, ws[0], ref_len) { Some(x) => x None => closest }
        dmax(0.0, v)
      }
    }
    Some(Item::RoundClip(b.x + cx - rad, b.y + cy - rad, rad * 2.0, rad * 2.0, [rad, rad, rad, rad]))
  } else if name == "ellipse" {
    let ws = css::words(args)
    let mut at_idx = -1
    for i, w in ws {
      if single_ident_lower(w) == "at" {
        at_idx = i
        break
      }
    }
    let mut cx = b.w / 2.0
    let mut cy = b.h / 2.0
    if at_idx >= 0 {
      if at_idx + 1 < ws.length() {
        match resolve_len_pct(s, ws[at_idx + 1], b.w) { Some(v) => cx = v None => () }
      }
      if at_idx + 2 < ws.length() {
        match resolve_len_pct(s, ws[at_idx + 2], b.h) { Some(v) => cy = v None => () }
      }
    }
    let rx = if ws.length() >= 1 && at_idx != 0 {
      dmax(0.0, match resolve_len_pct(s, ws[0], b.w) { Some(v) => v None => b.w / 2.0 })
    } else {
      b.w / 2.0
    }
    let ry = if ws.length() >= 2 && (at_idx < 0 || at_idx > 1) {
      dmax(0.0, match resolve_len_pct(s, ws[1], b.h) { Some(v) => v None => b.h / 2.0 })
    } else {
      b.h / 2.0
    }
    let r = dmin(rx, ry)
    Some(Item::RoundClip(b.x + cx - rx, b.y + cy - ry, rx * 2.0, ry * 2.0, [r, r, r, r]))
  } else if name == "polygon" {
    let pts = css::split_top_commas(args)
    let mut x0 = 1.0e30
    let mut y0 = 1.0e30
    let mut x1 = -1.0e30
    let mut y1 = -1.0e30
    for pt in pts {
      let ws = css::words(pt)
      if ws.length() >= 2 {
        match (resolve_len_pct(s, ws[0], b.w), resolve_len_pct(s, ws[1], b.h)) {
          (Some(px), Some(py)) => {
            if px < x0 { x0 = px }
            if py < y0 { y0 = py }
            if px > x1 { x1 = px }
            if py > y1 { y1 = py }
          }
          _ => ()
        }
      }
    }
    if x0 <= x1 && y0 <= y1 {
      Some(Item::Clip(b.x + x0, b.y + y0, dmax(0.0, x1 - x0), dmax(0.0, y1 - y0)))
    } else {
      None
    }
  } else {
    None
  }
}

fn parse_clip_polygon(b : layout::Box) -> Option[Array[(Double, Double)]] {
  if b.kind is layout::Kind::Inline || b.w <= 0.0 || b.h <= 0.0 {
    return None
  }
  let s = b.style
  ensure_effect_masks()
  if !s.values.has_any_mask(effect_masks.clip_m0, effect_masks.clip_m1, effect_masks.clip_m2, effect_masks.clip_m3) {
    return None
  }
  let mut toks = s.own_id(css::p_clip_path)
  if toks.length() == 0 {
    toks = s.own_id(css::p__webkit_clip_path)
  }
  if toks.length() == 0 {
    return None
  }
  let fns = css_functions(toks)
  if fns.length() == 0 || fns[0].0 != "polygon" {
    return None
  }
  let pts = css::split_top_commas(fns[0].1)
  let out : Array[(Double, Double)] = []
  for pt in pts {
    let ws = css::words(pt)
    if ws.length() >= 2 {
      match (resolve_len_pct(s, ws[0], b.w), resolve_len_pct(s, ws[1], b.h)) {
        (Some(px), Some(py)) => out.push((b.x + px, b.y + py))
        _ => ()
      }
    }
  }
  if out.length() >= 3 { Some(out) } else { None }
}

fn format_poly_coord(v : Double) -> String {
  let scaled = (v * 10000.0 + (if v >= 0.0 { 0.5 } else { -0.5 })).to_int()
  let neg = scaled < 0
  let abs_s = if neg { -scaled } else { scaled }
  let ip = abs_s / 10000
  let fp = abs_s % 10000
  let sb = StringBuilder::new()
  if neg && abs_s > 0 { sb.write_string("-") }
  sb.write_string(ip.to_string())
  if fp > 0 {
    sb.write_string(".")
    if fp < 1000 { sb.write_string("0") }
    if fp < 100 { sb.write_string("0") }
    if fp < 10 { sb.write_string("0") }
    sb.write_string(fp.to_string())
  }
  sb.to_string()
}

fn encode_poly_clip_url(
  poly : Array[(Double, Double)],
  ix : Double,
  iy : Double,
  iw : Double,
  ih : Double,
  u : String,
) -> String {
  if u == "" || iw <= 0.0 || ih <= 0.0 || poly.length() < 3 {
    return u
  }
  let sb = StringBuilder::new()
  sb.write_string("fvpoly:")
  let mut i = 0
  while i < poly.length() {
    if i > 0 { sb.write_string(";") }
    let (px, py) = poly[i]
    sb.write_string(format_poly_coord((px - ix) / iw))
    sb.write_string(",")
    sb.write_string(format_poly_coord((py - iy) / ih))
    i += 1
  }
  sb.write_string("|")
  sb.write_string(u)
  sb.to_string()
}

fn svg_poly_points(poly : Array[(Double, Double)], ox : Double, oy : Double) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < poly.length() {
    if i > 0 { sb.write_string(" ") }
    let (px, py) = poly[i]
    sb.write_string((px - ox).to_string())
    sb.write_string(",")
    sb.write_string((py - oy).to_string())
    i += 1
  }
  sb.to_string()
}

fn svg_rgb_str(col : Int) -> (String, Double) {
  let r = (col >> 24) & 0xFF
  let g = (col >> 16) & 0xFF
  let b = (col >> 8) & 0xFF
  let a = (col & 0xFF).to_double() / 255.0
  ("rgb(" + r.to_string() + "," + g.to_string() + "," + b.to_string() + ")", a)
}

fn encode_poly_svg_rect(
  poly : Array[(Double, Double)],
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  col : Int,
) -> String {
  let (rgb, a) = svg_rgb_str(col)
  let pts = svg_poly_points(poly, x, y)
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " +
  w.to_string() + " " + h.to_string() + "'><polygon points='" + pts + "' fill='" + rgb + "' fill-opacity='" + a.to_string() + "'/></svg>"
}

fn encode_poly_svg_linear_grad(
  poly : Array[(Double, Double)],
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  geom : Array[Double],
  offs : Array[Double],
  cols : Array[Int],
) -> String {
  let sb = StringBuilder::new()
  sb.write_string("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ")
  sb.write_string(w.to_string())
  sb.write_string(" ")
  sb.write_string(h.to_string())
  sb.write_string("'><defs><linearGradient id='g' gradientUnits='userSpaceOnUse' x1='")
  sb.write_string((geom[0] - x).to_string())
  sb.write_string("' y1='")
  sb.write_string((geom[1] - y).to_string())
  sb.write_string("' x2='")
  sb.write_string((geom[2] - x).to_string())
  sb.write_string("' y2='")
  sb.write_string((geom[3] - y).to_string())
  sb.write_string("'>")
  let mut i = 0
  while i < offs.length() {
    let (rgb, a) = svg_rgb_str(cols[i])
    sb.write_string("<stop offset='")
    sb.write_string(offs[i].to_string())
    sb.write_string("' stop-color='")
    sb.write_string(rgb)
    sb.write_string("' stop-opacity='")
    sb.write_string(a.to_string())
    sb.write_string("'/>")
    i += 1
  }
  sb.write_string("</linearGradient></defs><polygon points='")
  sb.write_string(svg_poly_points(poly, x, y))
  sb.write_string("' fill='url(%23g)'/></svg>")
  sb.to_string()
}

fn apply_poly_clip(ops : Array[Item], start : Int, poly : Array[(Double, Double)]) -> Unit {
  if poly.length() < 3 { return }
  for i in start..<ops.length() {
    ops[i] = match ops[i] {
      Item::Image(x, y, w, h, u, a) => Item::Image(x, y, w, h, encode_poly_clip_url(poly, x, y, w, h, u), a)
      Item::Rect(x, y, w, h, col) if w > 0.0 && h > 0.0 && (col & 0xFF) > 0 =>
      Item::Image(x, y, w, h, encode_poly_svg_rect(poly, x, y, w, h, col), 1.0)
      Item::Round(x, y, w, h, _, ring, col) if ring.length() == 0 && w > 0.0 && h > 0.0 && (col & 0xFF) > 0 =>
      Item::Image(x, y, w, h, encode_poly_svg_rect(poly, x, y, w, h, col), 1.0)
      Item::Gradient(x, y, w, h, kind, geom, offs, cols) if kind == 0 && w > 0.0 && h > 0.0 && geom.length() >= 4 && offs.length() >= 2 && offs.length() == cols.length() =>
      Item::Image(x, y, w, h, encode_poly_svg_linear_grad(poly, x, y, w, h, geom, offs, cols), 1.0)
      other => other
    }
  }
}
