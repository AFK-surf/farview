///| The display list: what a page draws, in order.
///| 1:1 port of `client/src/display/item.mbt`.

pub enum Item {
  Rect(Double, Double, Double, Double, Int)
  Round(Double, Double, Double, Double, Array[Double], Array[Double], Int)
  Text(Int, Double, Double, Double, Int, String, Double, Double)
  VText(Int, Double, Int, String, Bool, Double, Double)
  Image(Double, Double, Double, Double, String, Double)
  Mask(Double, Double, Double, Double, String, Int)
  Gradient(Double, Double, Double, Double, Int, Array[Double], Array[Double], Array[Int])
  Shadow(Double, Double, Double, Double, Array[Double], Int, Bool)
  Clip(Double, Double, Double, Double)
  RoundClip(Double, Double, Double, Double, Array[Double])
  ScrollBox(Int, Double, Double, Double, Double, Double, Double)
  Unclip
  Transform(Double, Double, Double, Double, Double, Double, Double, Double)
  Sticky(Int, Double, Double, Double, Double)
  Untransform
  Hover(Int, Double, Double, Double, Double, Int)
  Backdrop(Double, Double, Double, Double, Array[Double], Double, Double, Int)
  BlurLayer(Double, Double, Double, Double, Double)
  UnblurLayer
  CompLayer(Int, Double, Double, Double, Double, Double, Double, Double, Double, Double)
  UncompLayer
}

pub fn item_moved(self : Item, dx : Double, dy : Double) -> Item {
  match self {
    Item::Rect(x, y, w, h, col) => Item::Rect(x + dx, y + dy, w, h, col)
    Item::Round(x, y, w, h, r, ring, col) => Item::Round(x + dx, y + dy, w, h, r, ring, col)
    Item::Text(f, sz, x, y, col, t, l, w) => Item::Text(f, sz, x + dx, y + dy, col, t, l, w)
    Item::VText(f, sz, col, t, turned, x, y) => Item::VText(f, sz, col, t, turned, x + dx, y + dy)
    Item::Image(x, y, w, h, u, a) => Item::Image(x + dx, y + dy, w, h, u, a)
    Item::Mask(x, y, w, h, u, col) => Item::Mask(x + dx, y + dy, w, h, u, col)
    Item::Gradient(x, y, w, h, k, g, o, cols) => Item::Gradient(x + dx, y + dy, w, h, k, g, o, cols)
    Item::Shadow(x, y, w, h, g, col, inset) => Item::Shadow(x + dx, y + dy, w, h, g, col, inset)
    Item::Clip(x, y, w, h) => Item::Clip(x + dx, y + dy, w, h)
    Item::RoundClip(x, y, w, h, r) => Item::RoundClip(x + dx, y + dy, w, h, r)
    Item::ScrollBox(id, x, y, w, h, sw, sh) => Item::ScrollBox(id, x + dx, y + dy, w, h, sw, sh)
    Item::Unclip => Item::Unclip
    Item::Transform(ox, oy, a, b, c, d, e, f) => Item::Transform(ox + dx, oy + dy, a, b, c, d, e, f)
    Item::Sticky(id, t, top, room, d) => Item::Sticky(id, t, top, room, d)
    Item::Untransform => Item::Untransform
    Item::Hover(id, x, y, w, h, k) => Item::Hover(id, x + dx, y + dy, w, h, k)
    Item::Backdrop(x, y, w, h, r, blur, sat, tint) => Item::Backdrop(x + dx, y + dy, w, h, r, blur, sat, tint)
    Item::BlurLayer(x, y, w, h, r) => Item::BlurLayer(x + dx, y + dy, w, h, r)
    Item::UnblurLayer => Item::UnblurLayer
    Item::CompLayer(id, ox, oy, a, b, c, d, e, f, al) => Item::CompLayer(id, ox + dx, oy + dy, a, b, c, d, e, f, al)
    Item::UncompLayer => Item::UncompLayer
  }
}

fn double_arr_eq(a : Array[Double], b : Array[Double]) -> Bool {
  if a.length() != b.length() { return false }
  for i in 0..<a.length() {
    if a[i] != b[i] { return false }
  }
  true
}

fn int_arr_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() { return false }
  for i in 0..<a.length() {
    if a[i] != b[i] { return false }
  }
  true
}

pub fn item_eq(a : Item, b : Item) -> Bool {
  match (a, b) {
    (Item::Rect(x1, y1, w1, h1, c1), Item::Rect(x2, y2, w2, h2, c2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && c1 == c2
    (Item::Round(x1, y1, w1, h1, r1, g1, c1), Item::Round(x2, y2, w2, h2, r2, g2, c2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(r1, r2) && double_arr_eq(g1, g2) && c1 == c2
    (Item::Text(f1, s1, x1, y1, c1, t1, l1, w1), Item::Text(f2, s2, x2, y2, c2, t2, l2, w2)) =>
    f1 == f2 && s1 == s2 && x1 == x2 && y1 == y2 && c1 == c2 && t1 == t2 && l1 == l2 && w1 == w2
    (Item::VText(f1, s1, c1, t1, u1, x1, y1), Item::VText(f2, s2, c2, t2, u2, x2, y2)) =>
    f1 == f2 && s1 == s2 && c1 == c2 && t1 == t2 && u1 == u2 && x1 == x2 && y1 == y2
    (Item::Image(x1, y1, w1, h1, u1, a1), Item::Image(x2, y2, w2, h2, u2, a2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && u1 == u2 && a1 == a2
    (Item::Mask(x1, y1, w1, h1, u1, c1), Item::Mask(x2, y2, w2, h2, u2, c2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && u1 == u2 && c1 == c2
    (Item::Gradient(x1, y1, w1, h1, k1, g1, o1, c1), Item::Gradient(x2, y2, w2, h2, k2, g2, o2, c2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && k1 == k2 &&
    double_arr_eq(g1, g2) && double_arr_eq(o1, o2) && int_arr_eq(c1, c2)
    (Item::Shadow(x1, y1, w1, h1, g1, c1, i1), Item::Shadow(x2, y2, w2, h2, g2, c2, i2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(g1, g2) && c1 == c2 && i1 == i2
    (Item::Clip(x1, y1, w1, h1), Item::Clip(x2, y2, w2, h2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2
    (Item::RoundClip(x1, y1, w1, h1, r1), Item::RoundClip(x2, y2, w2, h2, r2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(r1, r2)
    (Item::ScrollBox(id1, x1, y1, w1, h1, sw1, sh1), Item::ScrollBox(id2, x2, y2, w2, h2, sw2, sh2)) =>
    id1 == id2 && x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && sw1 == sw2 && sh1 == sh2
    (Item::Unclip, Item::Unclip) => true
    (Item::Transform(ox1, oy1, a1, b1, c1, d1, e1, f1), Item::Transform(ox2, oy2, a2, b2, c2, d2, e2, f2)) =>
    ox1 == ox2 && oy1 == oy2 && a1 == a2 && b1 == b2 && c1 == c2 && d1 == d2 && e1 == e2 && f1 == f2
    (Item::Sticky(id1, t1, top1, r1, d1), Item::Sticky(id2, t2, top2, r2, d2)) =>
    id1 == id2 && t1 == t2 && top1 == top2 && r1 == r2 && d1 == d2
    (Item::Untransform, Item::Untransform) => true
    (Item::Hover(id1, x1, y1, w1, h1, k1), Item::Hover(id2, x2, y2, w2, h2, k2)) =>
    id1 == id2 && x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && k1 == k2
    (Item::Backdrop(x1, y1, w1, h1, r1, bl1, s1, t1), Item::Backdrop(x2, y2, w2, h2, r2, bl2, s2, t2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(r1, r2) && bl1 == bl2 && s1 == s2 && t1 == t2
    (Item::BlurLayer(x1, y1, w1, h1, r1), Item::BlurLayer(x2, y2, w2, h2, r2)) =>
    x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && r1 == r2
    (Item::UnblurLayer, Item::UnblurLayer) => true
    (Item::CompLayer(id1, ox1, oy1, a1, b1, c1, d1, e1, f1, al1), Item::CompLayer(id2, ox2, oy2, a2, b2, c2, d2, e2, f2, al2)) =>
    id1 == id2 && ox1 == ox2 && oy1 == oy2 && a1 == a2 && b1 == b2 && c1 == c2 && d1 == d2 && e1 == e2 && f1 == f2 && al1 == al2
    (Item::UncompLayer, Item::UncompLayer) => true
    _ => false
  }
}

fn hash_mix(h : Int, v : Int) -> Int {
  ((h * 16777619) ^ v)
}

fn hash_double(h : Int, v : Double) -> Int {
  let bits = v.to_bits()
  let lo = bits.to_int()
  let hi = (bits >> 32).to_int()
  hash_mix(hash_mix(h, lo), hi)
}

fn hash_str(h : Int, s : String) -> Int {
  let mut acc = h
  let n = s.length()
  let mut i = 0
  while i < n {
    acc = hash_mix(acc, s.code_unit_at(i))
    i += 1
  }
  acc
}

pub fn hash_double_arr(a : Array[Double]) -> Int {
  let mut h = 2166136261
  let mut i = 0
  while i < a.length() {
    h = hash_double(h, a[i])
    i += 1
  }
  h
}

pub fn hash_int_arr(a : Array[Int]) -> Int {
  let mut h = 2166136261
  let mut i = 0
  while i < a.length() {
    h = hash_mix(h, a[i])
    i += 1
  }
  h
}

pub fn item_hash(it : Item) -> Int {
  let mut h = 2166136261
  match it {
    Item::Rect(x, y, w, h0, c) => hash_mix(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 1), x), y), w), h0), c)
    Item::Round(x, y, w, h0, r, ring, c) => {
      h = hash_double(hash_double(hash_double(hash_double(hash_mix(h, 2), x), y), w), h0)
      hash_mix(hash_mix(hash_mix(h, hash_double_arr(r)), hash_double_arr(ring)), c)
    }
    Item::Text(f, sz, x, y, c, t, l, w) => {
      h = hash_mix(hash_double(hash_double(hash_double(hash_mix(hash_mix(h, 3), f), sz), x), y), c)
      hash_double(hash_double(hash_str(h, t), l), w)
    }
    Item::VText(f, sz, c, t, turned, x, y) => {
      h = hash_mix(hash_double(hash_mix(hash_mix(h, 4), f), sz), c)
      hash_double(hash_double(hash_mix(hash_str(h, t), if turned { 1 } else { 0 }), x), y)
    }
    Item::Image(x, y, w, h0, u, a) => hash_double(hash_str(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 5), x), y), w), h0), u), a)
    Item::Mask(x, y, w, h0, u, c) => hash_mix(hash_str(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 6), x), y), w), h0), u), c)
    Item::Gradient(x, y, w, h0, k, g, o, cols) => {
      h = hash_mix(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 7), x), y), w), h0), k)
      hash_mix(hash_mix(hash_mix(h, hash_double_arr(g)), hash_double_arr(o)), hash_int_arr(cols))
    }
    Item::Shadow(x, y, w, h0, g, c, inset) => {
      h = hash_double(hash_double(hash_double(hash_double(hash_mix(h, 8), x), y), w), h0)
      hash_mix(hash_mix(hash_mix(h, hash_double_arr(g)), c), if inset { 1 } else { 0 })
    }
    Item::Clip(x, y, w, h0) => hash_double(hash_double(hash_double(hash_double(hash_mix(h, 9), x), y), w), h0)
    Item::RoundClip(x, y, w, h0, r) => hash_mix(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 10), x), y), w), h0), hash_double_arr(r))
    Item::ScrollBox(id, x, y, w, h0, sw, sh) => hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_mix(hash_mix(h, 11), id), x), y), w), h0), sw), sh)
    Item::Unclip => hash_mix(h, 12)
    Item::Transform(ox, oy, a, b, c, d, e, f) => hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 13), ox), oy), a), b), c), d), e), f)
    Item::Sticky(id, t, top, room, d) => hash_double(hash_double(hash_double(hash_double(hash_mix(hash_mix(h, 14), id), t), top), room), d)
    Item::Untransform => hash_mix(h, 15)
    Item::Hover(id, x, y, w, h0, k) => hash_mix(hash_double(hash_double(hash_double(hash_double(hash_mix(hash_mix(h, 16), id), x), y), w), h0), k)
    Item::Backdrop(x, y, w, h0, r, bl, sat, tint) => hash_mix(hash_double(hash_double(hash_mix(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 17), x), y), w), h0), hash_double_arr(r)), bl), sat), tint)
    Item::BlurLayer(x, y, w, h0, r) => hash_double(hash_double(hash_double(hash_double(hash_double(hash_mix(h, 18), x), y), w), h0), r)
    Item::UnblurLayer => hash_mix(h, 19)
    Item::CompLayer(id, ox, oy, a, b, c, d, e, f, al) => hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_double(hash_mix(hash_mix(h, 20), id), ox), oy), a), b), c), d), e), f), al)
    Item::UncompLayer => hash_mix(h, 21)
  }
}
