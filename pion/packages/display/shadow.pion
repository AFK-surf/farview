///| Box shadows (CSS Backgrounds §7.1): blurred rounded rectangles, cast outside or inside.
///| 1:1 port of `client/src/display/shadow.mbt`.

import "fvdmath"

pub fn spread_radius(r : Double, spread : Double) -> Double {
  if r <= 0.0 {
    return 0.0
  }
  if spread >= 0.0 || r > -spread {
    dmax(r + spread, 0.0)
  } else {
    let t = r / -spread - 1.0
    dmax(r + spread * (1.0 + t * t * t), 0.0)
  }
}

pub fn erf(x : Double) -> Double {
  let sign = if x < 0.0 { -1.0 } else { 1.0 }
  let a = x.abs()
  let t = 1.0 / (1.0 + 0.3275911 * a)
  let p = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
  sign * (1.0 - p * fvdmath::exp(-(a * a)))
}

fn sdist(px : Double, py : Double, cx : Double, cy : Double, hw : Double, hh : Double, r : Double) -> Double {
  let qx = (px - cx).abs() - hw + r
  let qy = (py - cy).abs() - hh + r
  let mx = dmax(qx, 0.0)
  let my = dmax(qy, 0.0)
  (mx * mx + my * my).sqrt() + dmin(dmax(qx, qy), 0.0) - r
}

fn rect_gauss(px : Double, py : Double, cx : Double, cy : Double, hw : Double, hh : Double, sigma : Double) -> Double {
  let s = sigma * 2.0.sqrt()
  0.25 * (erf((px - cx + hw) / s) - erf((px - cx - hw) / s)) *
  (erf((py - cy + hh) / s) - erf((py - cy - hh) / s))
}

fn round_gauss(
  px : Double,
  py : Double,
  cx : Double,
  cy : Double,
  hw : Double,
  hh : Double,
  r : Double,
  sigma : Double,
) -> Double {
  if r <= 0.0 {
    return rect_gauss(px, py, cx, cy, hw, hh, sigma)
  }
  let rx = (px - cx).abs()
  let ry = (py - cy).abs()
  if rx < hw - r && ry < hh - r {
    return rect_gauss(px, py, cx, cy, hw, hh, sigma)
  }
  let d = sdist(px, py, cx, cy, hw, hh, r)
  0.5 * (1.0 - erf(d / (sigma * 2.0.sqrt())))
}

pub fn shadow_raster(
  w : Double,
  h : Double,
  dx : Double,
  dy : Double,
  blur : Double,
  spread : Double,
  r : Array[Double],
  ink : Int,
  inset : Bool,
  cut : Bool,
  scale : Double,
) -> (Double, Double, Int, Int, Array[Int]) {
  let sigma = blur / 2.0
  let pad = if inset { 0.0 } else { (sigma * 3.0).ceil() }
  let r0 = if r.length() >= 4 { (r[0] + r[1] + r[2] + r[3]) / 4.0 } else { 0.0 }
  let bx0 = if inset { 0.0 } else { dmin(0.0, dx - spread - pad) }
  let by0 = if inset { 0.0 } else { dmin(0.0, dy - spread - pad) }
  let bx1 = if inset { w } else { dmax(w, dx + w + spread + pad) }
  let by1 = if inset { h } else { dmax(h, dy + h + spread + pad) }
  let ox = bx0.floor()
  let oy = by0.floor()
  let pw = dmax(((bx1 - ox) * scale).ceil(), 1.0).to_int()
  let ph = dmax(((by1 - oy) * scale).ceil(), 1.0).to_int()
  let buf : Array[Int] = []
  for _ in 0..<(pw * ph) {
    buf.push(0)
  }
  if pw > 4096 || ph > 4096 {
    return (ox, oy, 1, 1, [0])
  }
  let cr = (ink >> 24) & 0xFF
  let cg = (ink >> 16) & 0xFF
  let cb = (ink >> 8) & 0xFF
  let ca = (ink & 0xFF).to_double() / 255.0
  let s_hw = if inset { dmax(w / 2.0 - spread, 0.0) } else { dmax(w / 2.0 + spread, 0.0) }
  let s_hh = if inset { dmax(h / 2.0 - spread, 0.0) } else { dmax(h / 2.0 + spread, 0.0) }
  let s_cx = w / 2.0 + dx
  let s_cy = h / 2.0 + dy
  let s_r = dmin(spread_radius(r0, if inset { -spread } else { spread }), dmin(s_hw, s_hh))
  let o_hw = w / 2.0
  let o_hh = h / 2.0
  let o_cx = w / 2.0
  let o_cy = h / 2.0
  let o_r = dmin(r0, dmin(o_hw, o_hh))
  let inv = 1.0 / scale
  let mut py_i = 0
  while py_i < ph {
    let py = oy + (py_i.to_double() + 0.5) * inv
    let mut px_i = 0
    while px_i < pw {
      let px = ox + (px_i.to_double() + 0.5) * inv
      let cov = if sigma <= 0.01 {
        let d = sdist(px, py, s_cx, s_cy, s_hw, s_hh, s_r)
        dmax(0.0, dmin(1.0, 0.5 - d * scale))
      } else {
        round_gauss(px, py, s_cx, s_cy, s_hw, s_hh, s_r, sigma)
      }
      let a0 = if inset { 1.0 - cov } else { cov }
      let a = if inset {
        let d = sdist(px, py, o_cx, o_cy, o_hw, o_hh, o_r)
        a0 * dmax(0.0, dmin(1.0, 0.5 - d * scale))
      } else if cut {
        let d = sdist(px, py, o_cx, o_cy, o_hw, o_hh, o_r)
        a0 * dmax(0.0, dmin(1.0, 0.5 + d * scale))
      } else {
        a0
      }
      let alpha = (a * ca * 255.0 + 0.5).floor().to_int()
      if alpha > 0 {
        let clamped = if alpha > 255 { 255 } else { alpha }
        buf[py_i * pw + px_i] = (cr << 24) | (cg << 16) | (cb << 8) | clamped
      }
      px_i += 1
    }
    py_i += 1
  }
  (ox, oy, pw, ph, buf)
}

fn blur_reach(blur : Double) -> Double {
  blur * 1.5
}

pub fn shadow_rect(it : Item) -> (Double, Double, Double, Double) {
  match it {
    Item::Shadow(x, y, w, h, g, _, false) => {
      let dx = g[0]
      let dy = g[1]
      let blur = g[2]
      let spread = g[3]
      let e = blur_reach(blur) + spread
      (x + dx - e, y + dy - e, dmax(w + 2.0 * e, 0.0), dmax(h + 2.0 * e, 0.0))
    }
    Item::Shadow(x, y, w, h, _, _, true) => (x, y, w, h)
    _ => (0.0, 0.0, 0.0, 0.0)
  }
}

pub fn shadow_scale(it : Item) -> Double {
  match it {
    Item::Shadow(_, _, _, _, g, _, inset) => {
      let blur = g[2]
      let cut = if g.length() > 8 { g[8] } else { 1.0 }
      if blur < 4.0 {
        2.0
      } else if !inset && cut == 0.0 {
        let s = 4.0 / blur
        if s < 0.25 { 0.25 } else if s > 1.0 { 1.0 } else { s }
      } else {
        1.0
      }
    }
    _ => 1.0
  }
}

fn round_distance(
  px : Double,
  py : Double,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  r : FixedArray[Double],
) -> Double {
  if w <= 0.0 || h <= 0.0 {
    return 1.0e9
  }
  let hw = w / 2.0
  let hh = h / 2.0
  let cx = px - x - hw
  let cy = py - y - hh
  let rad0 = if cx < 0.0 {
    if cy < 0.0 { r[0] } else { r[3] }
  } else if cy < 0.0 {
    r[1]
  } else {
    r[2]
  }
  let rad = dmin(dmin(rad0, hw), hh)
  let qx = cx.abs() - hw + rad
  let qy = cy.abs() - hh + rad
  if qx > 0.0 && qy > 0.0 {
    (qx * qx + qy * qy).sqrt() - rad
  } else {
    dmax(qx, qy) - rad
  }
}

fn shadow_coverage(d : Double, px_size : Double) -> Double {
  let v = 0.5 - d / px_size
  if v < 0.0 { 0.0 } else if v > 1.0 { 1.0 } else { v }
}

fn box_blurs(a : FixedArray[Double], w : Int, h : Int, sigma : Double, rows : Bool) -> Unit {
  if sigma < 0.3 {
    return
  }
  let d0 = (sigma * 3.0 * (2.0 * 3.141592653589793).sqrt() / 4.0 + 0.5).floor().to_int()
  let d = if d0 < 1 { 1 } else { d0 }
  let n = if rows { w } else { h }
  let lines = if rows { h } else { w }
  let step = if rows { 1 } else { w }
  let line = FixedArray::make(n, 0.0)
  let passes : Array[(Int, Int)] = if d % 2 == 1 {
    [(d / 2, d / 2), (d / 2, d / 2), (d / 2, d / 2)]
  } else {
    [(d / 2, d / 2 - 1), (d / 2 - 1, d / 2), (d / 2, d / 2)]
  }
  let mut l = 0
  while l < lines {
    let base = if rows { l * w } else { l }
    let mut pi = 0
    while pi < passes.length() {
      let (left, right) = passes[pi]
      let size = (left + right + 1).to_double()
      let mut i = 0
      while i < n {
        line[i] = a[base + i * step]
        i += 1
      }
      let mut sum = 0.0
      let rlim = if right < n { right } else { n }
      i = 0
      while i < rlim {
        sum += line[i]
        i += 1
      }
      i = 0
      while i < n {
        let add = i + right
        if add < n {
          sum += line[add]
        }
        let drop = i - left - 1
        if drop >= 0 {
          sum -= line[drop]
        }
        a[base + i * step] = sum / size
        i += 1
      }
      pi += 1
    }
    l += 1
  }
}

pub fn shadow_alpha(it : Item, pw : Int, ph : Int) -> FixedArray[Byte] {
  let out = FixedArray::make(pw * ph, 0 as Byte)
  let (x, y, w, h, g, inset) = match it {
    Item::Shadow(x0, y0, w0, h0, g0, _, ins) => (x0, y0, w0, h0, g0, ins)
    _ => return out
  }
  let (rx, ry, rw, rh) = shadow_rect(it)
  if pw <= 0 || ph <= 0 || rw <= 0.0 || rh <= 0.0 {
    return out
  }
  let dx = g[0]
  let dy = g[1]
  let blur = g[2]
  let spread = g[3]
  let radii = FixedArray::make(4, 0.0)
  for i in 0..<4 {
    radii[i] = if 4 + i < g.length() { g[4 + i] } else { 0.0 }
  }
  let sx = pw.to_double() / rw
  let sy = ph.to_double() / rh
  let px_size = 1.0 / ((sx + sy) / 2.0)
  let sigma = blur / 2.0
  let mx = if inset { (blur_reach(blur) * sx).ceil().to_int() } else { 0 }
  let my = if inset { (blur_reach(blur) * sy).ceil().to_int() } else { 0 }
  let bw = pw + 2 * mx
  let bh = ph + 2 * my
  let a = FixedArray::make(bw * bh, 0.0)
  let shape = FixedArray::make(4, 0.0)
  for i in 0..<4 {
    shape[i] = if inset { spread_radius(radii[i], -spread) } else { spread_radius(radii[i], spread) }
  }
  let (sx0, sy0, sw, sh) = if inset {
    (x + dx + spread, y + dy + spread, w - 2.0 * spread, h - 2.0 * spread)
  } else {
    (x + dx - spread, y + dy - spread, w + 2.0 * spread, h + 2.0 * spread)
  }
  for j in 0..<bh {
    let py = ry + ((j - my).to_double() + 0.5) / sy
    for i in 0..<bw {
      let px = rx + ((i - mx).to_double() + 0.5) / sx
      let c = shadow_coverage(round_distance(px, py, sx0, sy0, sw, sh, shape), px_size)
      a[j * bw + i] = if inset { 1.0 - c } else { c }
    }
  }
  box_blurs(a, bw, bh, sigma * sx, true)
  box_blurs(a, bw, bh, sigma * sy, false)
  let cut = (if g.length() > 8 { g[8] } else { 1.0 }) != 0.0
  for j in 0..<ph {
    let py = ry + (j.to_double() + 0.5) / sy
    for i in 0..<pw {
      let px = rx + (i.to_double() + 0.5) / sx
      let bx = if inset || cut { shadow_coverage(round_distance(px, py, x, y, w, h, radii), px_size) } else { 0.0 }
      let v = a[(j + my) * bw + i + mx] * (if inset { bx } else { 1.0 - bx })
      let iv = (v * 255.0 + 0.5).floor().to_int()
      let clamped = if iv < 0 { 0 } else if iv > 255 { 255 } else { iv }
      out[j * pw + i] = clamped.to_byte()
    }
  }
  out
}
