///| V8 script engine bindings for Farview host (via libnode.dylib + v8_shim.cc + crypto.cc).
///| 1:1 port of `src/js/js.mbt` using P26-A `[link.macos]` and P26-B `extern "C" fn` / `c_fn_ptr`.

extern "C" fn c_js_start(host_cb : Ptr) -> Unit = "pion_js_start"

extern "C" fn c_js_set_int(int_cb : Ptr) -> Unit = "pion_js_set_int_host"

extern "C" fn c_js_run_len(source : Ptr, len : Int) -> Int = "pion_js_run_len"

extern "C" fn c_js_run_copy(dst : Ptr, len : Int) -> Unit = "pion_js_run_copy"

extern "C" fn c_js_host_key() -> Ptr = "pion_js_host_key"

extern "C" fn c_js_set_origin(i : Int, origin : Ptr, len : Int) -> Unit = "pion_js_set_origin"

extern "C" fn c_js_set_script_ms(ms : Int) -> Unit = "pion_js_set_script_ms"

pub extern "C" fn heap_used() -> Int64 = "fv_js_heap"

pub extern "C" fn new_context() -> Unit = "fv_js_new_context"

pub extern "C" fn add_context() -> Int = "fv_js_add_context"

pub extern "C" fn use_context(i : Int) -> Unit = "fv_js_use"

pub extern "C" fn context_counts() -> Int = "fv_js_contexts"

pub extern "C" fn collect() -> Unit = "fv_js_collect"

pub extern "C" fn drop_context(i : Int) -> Unit = "fv_js_drop_context"

pub extern "C" fn set_dom_version(v : Int) -> Unit = "fv_js_set_dom_version"

pub extern "C" fn set_doc_names_version(v : Int) -> Unit = "fv_js_set_doc_names_version"

pub extern "C" fn set_detach_version(v : Int) -> Unit = "fv_js_set_detach_version"

pub extern "C" fn intbuf_cap() -> Int = "fv_js_intbuf_cap"

pub extern "C" fn intbuf_ptr() -> Ptr = "fv_js_intbuf_ptr"

pub extern "C" fn intbuf_get(i : Int) -> Int = "fv_js_intbuf_get"

pub extern "C" fn intbuf_set(i : Int, v : Int) -> Unit = "fv_js_intbuf_set"

///| Starts V8 with a Pion `extern "C" fn(Int, Int, Int, String, String) -> String` callback pointer
///| obtained via `c_fn_ptr(...)`.
pub fn start_raw(host_cb : Ptr) -> Unit {
  c_js_start(host_cb)
}

///| Registers the fast integer host callback `extern "C" fn(Int, Int, Int) -> Int` via `c_fn_ptr(...)`.
pub fn start_int_raw(int_cb : Ptr) -> Unit {
  c_js_set_int(int_cb)
}

pub fn run(source : String) -> String {
  let n = c_js_run_len(str_data_ptr(source), source.length())
  if n <= 0 {
    return ""
  }
  let buf = Bytes::new(n)
  c_js_run_copy(bytes_data_ptr(buf), n)
  buf.to_string()
}

pub fn host_key() -> String {
  let p = c_js_host_key()
  let out = cstr_to_str(p)
  ptr_free(p)
  out
}

pub fn set_origin(i : Int, origin : String) -> Unit {
  c_js_set_origin(i, str_data_ptr(origin), origin.length())
}

pub fn set_script_timeout_ms(ms : Int) -> Unit {
  c_js_set_script_ms(ms)
}

// --- Multi-threaded V8 Isolate Web Worker API (Wave W1) ---

extern "C" fn c_worker_spawn(script : Ptr, script_len : Int, url : Ptr, url_len : Int) -> Int = "pion_worker_spawn"

extern "C" fn c_worker_post(id : Int, data : Ptr, data_len : Int) -> Int = "pion_worker_post"

extern "C" fn c_worker_poll_kind(id : Int) -> Int = "pion_worker_poll_kind"

extern "C" fn c_worker_poll_len() -> Int = "pion_worker_poll_len"

extern "C" fn c_worker_poll_copy(dst : Ptr, len : Int) -> Unit = "pion_worker_poll_copy"

pub extern "C" fn worker_terminate(id : Int) -> Unit = "pion_worker_terminate"

pub extern "C" fn worker_terminate_all() -> Unit = "pion_worker_terminate_all"

pub extern "C" fn worker_active_count() -> Int = "pion_worker_active_count"

pub extern "C" fn worker_thread_id(id : Int) -> Int64 = "pion_worker_thread_id"

pub extern "C" fn worker_main_thread_id() -> Int64 = "pion_worker_main_thread_id"

pub extern "C" fn worker_sleep_ms(ms : Int) -> Unit = "pion_worker_sleep_ms"

///| Spawns a dedicated OS thread with an independent v8::Isolate and DedicatedWorkerGlobalScope.
pub fn worker_spawn(script : String, url : String) -> Int {
  c_worker_spawn(str_data_ptr(script), script.length(), str_data_ptr(url), url.length())
}

///| Posts a UTF-8 message into worker `id`'s inbound queue.
pub fn worker_post(id : Int, data : String) -> Bool {
  c_worker_post(id, str_data_ptr(data), data.length()) != 0
}

///| Non-blocking poll of worker `id`'s outbound queue.
///| Returns `(kind, payload)` where kind is 0 (none), 1 (data), or 2 (error).
pub fn worker_poll(id : Int) -> (Int, String) {
  let kind = c_worker_poll_kind(id)
  if kind == 0 {
    return (0, "")
  }
  let n = c_worker_poll_len()
  if n <= 0 {
    return (kind, "")
  }
  let buf = Bytes::new(n)
  c_worker_poll_copy(bytes_data_ptr(buf), n)
  (kind, buf.to_string())
}

// --- Real V8 Isolated Worlds (independent v8::Context per world_key) ---

extern "C" fn c_world_create(ctx_id : Int, key : Ptr, key_len : Int) -> Int = "pion_js_world_create"

extern "C" fn c_world_eval_len(ctx_id : Int, key : Ptr, key_len : Int, src : Ptr, src_len : Int) -> Int = "pion_js_world_eval_len"

extern "C" fn c_world_eval_copy(dst : Ptr, len : Int) -> Unit = "pion_js_world_eval_copy"

extern "C" fn c_world_destroy(ctx_id : Int, key : Ptr, key_len : Int) -> Int = "pion_js_world_destroy"

pub extern "C" fn world_count(ctx_id : Int) -> Int = "pion_js_world_count"

///| Creates (or ensures) an independent V8 Context isolated world for `(ctx_id, world_key)`.
pub fn world_create(ctx_id : Int, world_key : String) -> Bool {
  c_world_create(ctx_id, str_data_ptr(world_key), world_key.length()) != 0
}

///| Evaluates JS source inside the isolated V8 Context `(ctx_id, world_key)`.
pub fn world_eval(ctx_id : Int, world_key : String, source : String) -> String {
  let n = c_world_eval_len(ctx_id, str_data_ptr(world_key), world_key.length(), str_data_ptr(source), source.length())
  if n <= 0 {
    return ""
  }
  let buf = Bytes::new(n)
  c_world_eval_copy(bytes_data_ptr(buf), n)
  buf.to_string()
}

///| Destroys the isolated V8 Context `(ctx_id, world_key)` and notifies V8 GC.
pub fn world_destroy(ctx_id : Int, world_key : String) -> Bool {
  c_world_destroy(ctx_id, str_data_ptr(world_key), world_key.length()) != 0
}
