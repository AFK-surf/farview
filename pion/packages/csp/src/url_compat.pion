///| Compatibility bridge between vendored `AFK-surf/pion-packages` `csp`
///| and Farview's workspace `url` package (`pion/packages/url/`).
///| 100% pure Pion, 0 `extern "C"`, 0 `World`, 0 mutable globals.

import "url"

fn csp_url_default_port(scheme : String) -> Option[Int] {
  if scheme == "http" || scheme == "ws" {
    Option::Some(80)
  } else if scheme == "https" || scheme == "wss" {
    Option::Some(443)
  } else if scheme == "ftp" {
    Option::Some(21)
  } else {
    Option::None
  }
}

fn csp_url_origin(u : url::Url) -> Origin {
  if u.scheme == "http" ||
  u.scheme == "https" ||
  u.scheme == "ws" ||
  u.scheme == "wss" ||
  u.scheme == "ftp" {
    match u.host {
      Option::Some(h) => {
        if h.length() == 0 {
          Origin::Opaque
        } else {
          let port = match u.port {
            Option::Some(p) => p
            Option::None =>
            match csp_url_default_port(u.scheme) {
              Option::Some(dp) => dp
              Option::None => -1
            }
          }
          Origin::Tuple(u.scheme, h, port)
        }
      }
      Option::None => Origin::Opaque
    }
  } else if u.scheme == "blob" {
    match url::parse_url(url::url_path(u, false)) {
      Option::Some(inner) => {
        if inner.scheme == "http" || inner.scheme == "https" {
          csp_url_origin(inner)
        } else {
          Origin::Opaque
        }
      }
      Option::None => Origin::Opaque
    }
  } else {
    Origin::Opaque
  }
}

fn csp_url_has_host(u : url::Url) -> Bool {
  match u.host {
    Option::Some(h) => h.length() > 0
    Option::None => false
  }
}

fn csp_url_hostname(u : url::Url) -> String {
  match u.host {
    Option::Some(h) => h
    Option::None => ""
  }
}

fn csp_url_port_or_default(u : url::Url) -> Option[Int] {
  match u.port {
    Option::Some(p) => Option::Some(p)
    Option::None => csp_url_default_port(u.scheme)
  }
}

fn csp_url_path(u : url::Url) -> String {
  url::url_path(u, false)
}

fn csp_hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn csp_percent_decode_str(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let mut has_pct = false
  let mut i = 0
  while i < n {
    if (src[i].to_int() & 0xFF) == 37 {
      has_pct = true
      break
    }
    i = i + 1
  }
  if !has_pct {
    return s
  }
  let buf = Bytes::new(n)
  let mut out_len = 0
  i = 0
  while i < n {
    let b = src[i].to_int() & 0xFF
    if b == 37 && i + 2 < n {
      let hi = csp_hex_val(src[i + 1].to_int() & 0xFF)
      let lo = csp_hex_val(src[i + 2].to_int() & 0xFF)
      if hi >= 0 && lo >= 0 {
        buf[out_len] = ((hi << 4) | lo).to_byte()
        out_len = out_len + 1
        i = i + 3
        continue
      }
    }
    buf[out_len] = src[i]
    out_len = out_len + 1
    i = i + 1
  }
  buf.slice(0, out_len).to_string()
}
