///| Generic integer-keyed hash map (`IntMap[V]`) backed by Pion P27-C1 native `Map[Int, V]` (`pion_imap_*`).

pub struct IntMap[V] {
  inner : Map[Int, V]
}

pub fn hash_int(k : Int) -> Int {
  let mut x = k
  x = x ^ ((x >> 16) & 0xFFFF)
  x = x * 0x45d9f3b
  x = x ^ ((x >> 16) & 0xFFFF)
  x = x * 0x45d9f3b
  x = x ^ ((x >> 16) & 0xFFFF)
  x
}

pub fn IntMap::new[V]() -> IntMap[V] {
  IntMap::{ inner: Map::new() }
}

pub fn IntMap::with_capacity[V](min_cap : Int) -> IntMap[V] {
  IntMap::{ inner: Map::with_capacity(min_cap) }
}

pub fn IntMap::len[V](self : IntMap[V]) -> Int {
  self.inner.length()
}

pub fn IntMap::is_empty[V](self : IntMap[V]) -> Bool {
  self.inner.length() == 0
}

pub fn IntMap::set[V](self : IntMap[V], key : Int, value : V) -> Unit {
  self.inner.set(key, value)
}

pub fn get[V](m : IntMap[V], key : Int) -> Option[V] {
  m.inner.get(key)
}

pub fn IntMap::get_or[V](self : IntMap[V], key : Int, default : V) -> V {
  match self.inner.get(key) {
    Some(v) => v
    None => default
  }
}

pub fn IntMap::contains[V](self : IntMap[V], key : Int) -> Bool {
  self.inner.contains(key)
}

pub fn remove[V](m : IntMap[V], key : Int) -> Option[V] {
  let prev = m.inner.get(key)
  if prev.is_some() {
    let _ = m.inner.remove(key)
  }
  prev
}

pub fn IntMap::delete[V](self : IntMap[V], key : Int) -> Bool {
  let had = self.inner.contains(key)
  if had {
    let _ = self.inner.remove(key)
  }
  had
}

pub fn IntMap::erase[V](self : IntMap[V], key : Int) -> Unit {
  let _ = self.inner.remove(key)
}

pub fn IntMap::clear[V](self : IntMap[V]) -> Unit {
  self.inner.clear()
}

pub fn IntMap::keys[V](self : IntMap[V]) -> Array[Int] {
  self.inner.keys()
}

pub fn IntMap::each[V](self : IntMap[V], f : (Int, V) -> Unit) -> Unit {
  let ks = self.inner.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match self.inner.get(k) {
      Some(v) => f(k, v)
      None => ()
    }
    i = i + 1
  }
}
