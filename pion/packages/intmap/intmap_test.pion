test "basic set get contains remove" {
  let m : IntMap[String] = IntMap::new()
  debug_assert(m.len() == 0, "initial len 0")
  debug_assert(m.is_empty(), "initial empty")
  debug_assert(!m.contains(42), "missing 42")

  m.set(1, "one")
  m.set(2, "two")
  m.set(-5, "neg")
  m.set(0, "zero")
  debug_assert(m.len() == 4, "len 4")
  debug_assert(m.contains(1), "has 1")
  debug_assert(m.contains(-5), "has -5")
  debug_assert(get(m, 1).unwrap_or("") == "one", "get 1")
  debug_assert(get(m, -5).unwrap_or("") == "neg", "get -5")
  debug_assert(get(m, 0).unwrap_or("") == "zero", "get 0")
  debug_assert(m.get_or(1, "") == "one", "get_or 1")
  debug_assert(m.get_or(999, "def") == "def", "get_or missing")

  // Overwrite existing key
  m.set(2, "TWO")
  debug_assert(m.len() == 4, "len stays 4 after overwrite")
  debug_assert(get(m, 2).unwrap_or("") == "TWO", "overwritten 2")

  // Remove
  let r = remove(m, 2)
  debug_assert(r.unwrap_or("") == "TWO", "removed value")
  debug_assert(m.len() == 3, "len 3")
  debug_assert(!m.contains(2), "2 removed")
  debug_assert(remove(m, 2).is_none(), "double remove none")
}

test "growth collision and high frequency" {
  let m : IntMap[Int] = IntMap::new()
  let mut i = 0
  while i < 2000 {
    m.set(i * 17 - 500, i * 3 + 1)
    i = i + 1
  }
  debug_assert(m.len() == 2000, "len 2000")
  i = 0
  while i < 2000 {
    let k = i * 17 - 500
    let v = get(m, k).unwrap_or(-1)
    debug_assert(v == i * 3 + 1, "value matches after growth")
    i = i + 1
  }
  // Delete even indices
  i = 0
  while i < 2000 {
    if i % 2 == 0 {
      let r = remove(m, i * 17 - 500)
      debug_assert(r.is_some(), "removed even")
    }
    i = i + 1
  }
  debug_assert(m.len() == 1000, "len 1000")
  i = 0
  while i < 2000 {
    let k = i * 17 - 500
    if i % 2 == 0 {
      debug_assert(!m.contains(k), "even gone")
    } else {
      debug_assert(get(m, k).unwrap_or(-1) == i * 3 + 1, "odd intact")
    }
    i = i + 1
  }
}

test "tombstone churn and rehash without unbounded growth" {
  let m : IntMap[Int] = IntMap::with_capacity(16)
  let mut round = 0
  while round < 50 {
    let base = round * 10
    let mut j = 0
    while j < 10 {
      m.set(base + j, base + j + 100)
      j = j + 1
    }
    j = 0
    while j < 10 {
      let v = remove(m, base + j).unwrap_or(-1)
      debug_assert(v == base + j + 100, "tombstone round value")
      j = j + 1
    }
    debug_assert(m.len() == 0, "empty after round")
    round = round + 1
  }
  m.set(999, 42)
  debug_assert(get(m, 999).unwrap_or(-1) == 42, "works after churn")
}

test "keys each and clear" {
  let m : IntMap[Int] = IntMap::new()
  m.set(10, 100)
  m.set(20, 200)
  m.set(30, 300)
  let ks = m.keys()
  ks.sort()
  debug_assert(ks.length() == 3, "3 keys")
  debug_assert(ks[0] == 10 && ks[1] == 20 && ks[2] == 30, "sorted keys")

  let sum_box : Array[Int] = [0]
  m.each(fn(k : Int, v : Int) -> Unit {
    sum_box[0] = sum_box[0] + k + v
  })
  debug_assert(sum_box[0] == 660, "each sum 660")

  m.clear()
  debug_assert(m.len() == 0 && m.is_empty(), "cleared")
  debug_assert(get(m, 10).is_none(), "10 gone after clear")
  m.set(10, 101)
  debug_assert(get(m, 10).unwrap_or(-1) == 101, "reinsert after clear")
  m.erase(10)
  debug_assert(!m.contains(10) && m.len() == 0, "erase removes existing key")
  m.erase(999)
  debug_assert(m.len() == 0, "erase missing key is no-op")
  let mc : IntMap[Int] = IntMap::with_capacity(64)
  debug_assert(mc.is_empty(), "with_capacity starts empty")
  mc.set(7, 77)
  mc.set(8, 88)
  debug_assert(mc.len() == 2 && get(mc, 7).unwrap_or(0) == 77 && get(mc, 8).unwrap_or(0) == 88, "with_capacity set/get")
}
