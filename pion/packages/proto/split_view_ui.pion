///| Pure-Pion portable Arc Split View geometry, ratio clamping, narrow-window protection,
///| and pane metadata helpers shared by `pion-app` and unit tests.

pub let SPLIT_RATIO_MIN : Double = 0.25
pub let SPLIT_RATIO_MAX : Double = 0.75
pub let SPLIT_RATIO_DEFAULT : Double = 0.5
pub let SPLIT_DIVIDER_WIDTH : Double = 6.0
pub let SPLIT_MIN_PANE_WIDTH : Double = 240.0
pub let SPLIT_DOUBLE_CLICK_MS : Double = 350.0

///| Returns true when two divider clicks fall within the double-click reset window.
pub fn split_is_double_click(last_click_ms : Double, now_ms : Double) -> Bool {
  last_click_ms > 0.0 && now_ms >= last_click_ms && now_ms - last_click_ms <= SPLIT_DOUBLE_CLICK_MS
}

///| Returns the default 50/50 split ratio used when double-clicking the divider.
pub fn split_reset_ratio() -> Double {
  SPLIT_RATIO_DEFAULT
}

///| Clamps split ratio into `[0.25, 0.75]` (NaN resets to `0.50`).
pub fn clamp_split_ratio(ratio : Double) -> Double {
  if ratio != ratio {
    return SPLIT_RATIO_DEFAULT
  }
  if ratio < SPLIT_RATIO_MIN {
    SPLIT_RATIO_MIN
  } else if ratio > SPLIT_RATIO_MAX {
    SPLIT_RATIO_MAX
  } else {
    ratio
  }
}

///| Computes `(left_width, right_width)` inside `total_width` minus the `6pt` divider,
///| protecting both panes from collapsing below `SPLIT_MIN_PANE_WIDTH` when room permits
///| (and gracefully falling back to proportional bounds on very narrow windows).
pub fn split_pane_widths(total_width : Double, ratio : Double) -> (Double, Double) {
  let avail = total_width - SPLIT_DIVIDER_WIDTH
  if avail <= 0.0 || avail != avail {
    return (0.0, 0.0)
  }
  let r = clamp_split_ratio(ratio)
  let raw_left = avail * r
  let min_pane = if avail >= SPLIT_MIN_PANE_WIDTH * 2.0 {
    SPLIT_MIN_PANE_WIDTH
  } else {
    avail * 0.35
  }
  let max_left = avail - min_pane
  let left = if raw_left < min_pane {
    min_pane
  } else if raw_left > max_left {
    max_left
  } else {
    raw_left
  }
  let right = avail - left
  (left, if right > 0.0 { right } else { 0.0 })
}

///| Updates split ratio from a horizontal drag delta over `total_width`.
pub fn split_ratio_from_drag(
  start_ratio : Double,
  delta_x : Double,
  total_width : Double,
) -> Double {
  let base = clamp_split_ratio(start_ratio)
  let avail = total_width - SPLIT_DIVIDER_WIDTH
  if avail <= 1.0 || delta_x != delta_x {
    return base
  }
  clamp_split_ratio(base + delta_x / avail)
}

///| Formats a concise domain/host subtitle for a Split View pane header.
pub fn split_pane_display_host(url : String) -> String {
  let raw = omnibox_display_host(url)
  if raw == "" {
    let t = url.trim()
    return if t != "" { t } else { "about:blank" }
  }
  let mut cut = raw.length()
  let mut i = 0
  while i < raw.length() {
    let c = raw.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      cut = i
      break
    }
    i = i + 1
  }
  if cut > 0 { raw.slice(0, cut) } else { raw }
}

///| Formats a concise single-line title for a Split View pane header.
pub fn split_pane_display_title(title : String, url : String) -> String {
  let t = title.trim()
  if t != "" {
    return t
  }
  if url.trim() != "" {
    let host = split_pane_display_host(url)
    if host != "" {
      return host
    }
  }
  "Split Pane"
}

///| Returns the opposite pane index (`0 <-> 1`).
pub fn split_other_pane(active_pane : Int) -> Int {
  if active_pane == 1 { 0 } else { 1 }
}
