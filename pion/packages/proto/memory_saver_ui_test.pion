///| Memory Saver payload: round trip, malformed input, and the labels a person reads.

test "memory saver payload round-trips and skips malformed tab lines" {
  let snap = MemorySaverSnapshot::{
    enabled: true,
    saved_kb: 245760L,
    host_rss_kb: 512000L,
    tabs: [
      TabMemory::{ tab_id: "3", memory_kb: 0L, discarded: true, freed_kb: 153600L },
      TabMemory::{ tab_id: "7", memory_kb: 512000L, discarded: false, freed_kb: 0L },
      TabMemory::{ tab_id: "bad\tid", memory_kb: 1L, discarded: false, freed_kb: 0L },
    ],
  }
  let enc = encode_memory_saver_snapshot(snap)
  match parse_memory_saver_snapshot(enc) {
    Some(back) => {
      debug_assert(back.enabled && back.saved_kb == 245760L && back.host_rss_kb == 512000L, "header")
      debug_assert(back.tabs.length() == 2, "the bad id left out: " + back.tabs.length().to_string())
      match memory_saver_tab(back, "3") {
        Some(t) => debug_assert(t.discarded && t.freed_kb == 153600L && t.memory_kb == 0L, "tab 3")
        None => debug_assert(false, "tab 3 kept")
      }
      debug_assert(memory_saver_tab(back, "9") is None, "no tab 9")
    }
    None => debug_assert(false, "parses")
  }
  debug_assert(parse_memory_saver_snapshot("") is None, "empty")
  debug_assert(parse_memory_saver_snapshot("{\"a\":1}") is None, "not ours")
  debug_assert(parse_memory_saver_snapshot("fvms1\tx\t1\t1") is None, "bad flag")
  match parse_memory_saver_snapshot("fvms1\t0\t0\t0\n5\tzz\t1\t0\n6\t10\t0\t0") {
    Some(s) => debug_assert(s.tabs.length() == 1 && s.tabs[0].tab_id == "6", "malformed line skipped")
    None => debug_assert(false, "header ok")
  }
}

test "memory saver labels" {
  debug_assert(format_memory_kb(0L) == "<1 MB", "tiny")
  debug_assert(format_memory_kb(1024L) == "1 MB", "1 MB")
  debug_assert(format_memory_kb(250880L) == "245 MB", "245 MB")
  debug_assert(format_memory_kb(1468006L) == "1.4 GB", "1.4 GB: " + format_memory_kb(1468006L))
  debug_assert(memory_saver_hover_label(TabMemory::{ tab_id: "1", memory_kb: 0L, discarded: true, freed_kb: 153600L }) == "Inactive, saved 150 MB", "discarded")
  debug_assert(memory_saver_hover_label(TabMemory::{ tab_id: "1", memory_kb: 0L, discarded: true, freed_kb: 0L }) == "Inactive to save memory", "discarded, nothing measured")
  debug_assert(memory_saver_hover_label(TabMemory::{ tab_id: "1", memory_kb: 307200L, discarded: false, freed_kb: 0L }) == "Memory 300 MB", "live")
  debug_assert(memory_saver_hover_label(TabMemory::{ tab_id: "1", memory_kb: 0L, discarded: false, freed_kb: 0L }) == "", "unknown")
}
