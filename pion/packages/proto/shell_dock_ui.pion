///| Pure-Pion portable state models for Arc / Chrome flagship desktop shell upgrades:
///| 1. `MiniPlayerState`: Arc sidebar bottom-left Mini Media Player control card.
///| 2. `OmniSuggestState`: Rich-categorized Omnibox smart suggestions (Switch to Tab,
///|    Bookmark, History, Calc/Unit conversion, Site Search, Direct URL, Web Search).
///| 3. `SplitBarState`: Arc Split View ultra-thin top focus & quick-switch micro-toolbar.

pub let OMNI_SUGGEST_MAX_ITEMS : Int = 6

// ============================================================================
// 1. Arc Sidebar Mini Media Player (`MiniPlayerState`)
// ============================================================================

pub struct MiniPlayerState {
  pub active : Bool
  pub dismissed : Bool
  pub tab_id : String
  pub title : String
  pub domain : String
  pub url : String
  pub playing : Bool
  pub muted : Bool
  pub is_live : Bool
  pub duration_secs : Int
  pub position_secs : Int
}

pub fn MiniPlayerState::empty() -> MiniPlayerState {
  MiniPlayerState::{
    active: false,
    dismissed: false,
    tab_id: "",
    title: "",
    domain: "",
    url: "",
    playing: false,
    muted: false,
    is_live: false,
    duration_secs: 0,
    position_secs: 0,
  }
}

pub fn MiniPlayerState::is_visible(self : MiniPlayerState) -> Bool {
  self.active && !self.dismissed
}

pub fn MiniPlayerState::progress_ratio(self : MiniPlayerState) -> Double {
  if !self.active {
    return 0.0
  }
  if self.is_live {
    return 1.0
  }
  if self.duration_secs <= 0 {
    return 0.0
  }
  let pos = if self.position_secs < 0 {
    0
  } else if self.position_secs > self.duration_secs {
    self.duration_secs
  } else {
    self.position_secs
  }
  (pos as Double) / (self.duration_secs as Double)
}

pub fn MiniPlayerState::from_media_session(item : MediaSessionItem) -> MiniPlayerState {
  let norm = normalize_media_session_item(item)
  let raw_host = if norm.url != "" {
    split_pane_display_host(norm.url)
  } else {
    ""
  }
  let domain = if raw_host != "" && raw_host != "about:blank" {
    raw_host
  } else if norm.artist_or_host != "" {
    norm.artist_or_host
  } else {
    "media"
  }
  MiniPlayerState::{
    active: true,
    dismissed: false,
    tab_id: norm.tab_id,
    title: norm.title,
    domain,
    url: norm.url,
    playing: norm.playing,
    muted: norm.muted,
    is_live: norm.is_live_call,
    duration_secs: norm.duration_secs,
    position_secs: norm.position_secs,
  }
}

///| Syncs `MiniPlayerState` from a `MediaHubSnapshot` and current active tab ID.
///| Preserves `dismissed` for the same tab unless playback freshly resumes or a
///| different media tab takes over.
pub fn MiniPlayerState::sync_from_snapshot(
  self : MiniPlayerState,
  snap : MediaHubSnapshot,
  active_tab_id : String,
) -> MiniPlayerState {
  match select_mini_player_session(snap, active_tab_id) {
    None => MiniPlayerState::empty()
    Some(item) => {
      let next = MiniPlayerState::from_media_session(item)
      let same_tab = self.tab_id != "" && self.tab_id == next.tab_id
      let resumed = !self.playing && next.playing
      if self.dismissed && same_tab && !resumed {
        MiniPlayerState::{ ..next, dismissed: true }
      } else {
        next
      }
    }
  }
}

pub fn MiniPlayerState::toggle_play(self : MiniPlayerState) -> MiniPlayerState {
  if !self.active {
    return self
  }
  MiniPlayerState::{ ..self, playing: !self.playing, dismissed: false }
}

pub fn MiniPlayerState::toggle_mute(self : MiniPlayerState) -> MiniPlayerState {
  if !self.active {
    return self
  }
  MiniPlayerState::{ ..self, muted: !self.muted }
}

pub fn MiniPlayerState::jump_to_tab(self : MiniPlayerState) -> Option[String] {
  if self.is_visible() && self.tab_id.trim() != "" {
    Some(self.tab_id.trim())
  } else {
    None
  }
}

pub fn MiniPlayerState::dismiss(self : MiniPlayerState) -> MiniPlayerState {
  if !self.active {
    return self
  }
  MiniPlayerState::{ ..self, dismissed: true, playing: false }
}

pub fn MiniPlayerState::accent_color(self : MiniPlayerState) -> Int64 {
  media_session_accent(
    MediaSessionItem::{
      tab_id: self.tab_id,
      title: self.title,
      artist_or_host: self.domain,
      url: self.url,
      playing: self.playing,
      muted: self.muted,
      is_live_call: self.is_live,
      duration_secs: self.duration_secs,
      position_secs: self.position_secs,
    },
  )
}

pub fn MiniPlayerState::status_label(self : MiniPlayerState) -> String {
  if self.muted {
    "MUTED"
  } else if self.is_live {
    "LIVE"
  } else if !self.playing {
    "PAUSED"
  } else if self.duration_secs > 0 {
    format_media_time(self.position_secs)
  } else {
    "PLAYING"
  }
}

// ============================================================================
// 2. Rich-Categorized Omnibox Smart Suggestions (`OmniSuggestState`)
// ============================================================================

pub enum OmniSuggestCategory {
  Calc
  SiteSearch
  SwitchTab
  Bookmark
  History
  DirectUrl
  Search
  ///| A Command Bar action matched by the typed text (`command_bar_matching_actions`); `url` holds its id and
  ///| `subtitle` its shortcut.
  Action
}

pub struct OmniSuggestItem {
  pub category : OmniSuggestCategory
  pub title : String
  pub url : String
  pub subtitle : String
  pub badge_label : String
  pub section_title : String
  pub tab_id : String
  pub visits : Int
  pub score : Double
}

pub struct OmniSuggestState {
  pub open : Bool
  pub query : String
  pub items : Array[OmniSuggestItem]
  pub selected : Int
}

pub fn OmniSuggestState::empty() -> OmniSuggestState {
  OmniSuggestState::{ open: false, query: "", items: [], selected: -1 }
}

fn os_cat_priority(cat : OmniSuggestCategory) -> Int {
  match cat {
    OmniSuggestCategory::Calc => 6
    OmniSuggestCategory::SiteSearch => 5
    OmniSuggestCategory::SwitchTab => 4
    OmniSuggestCategory::Bookmark => 3
    OmniSuggestCategory::History => 2
    OmniSuggestCategory::DirectUrl => 1
    OmniSuggestCategory::Search => 0
    OmniSuggestCategory::Action => -1
  }
}

pub fn omni_suggest_category_badge(cat : OmniSuggestCategory) -> String {
  match cat {
    OmniSuggestCategory::Calc => "Copy Result"
    OmniSuggestCategory::SiteSearch => "Site Search"
    OmniSuggestCategory::SwitchTab => "Switch to Tab"
    OmniSuggestCategory::Bookmark => "Bookmark"
    OmniSuggestCategory::History => "History"
    OmniSuggestCategory::DirectUrl => "Open URL"
    OmniSuggestCategory::Search => "Search"
    OmniSuggestCategory::Action => "Run"
  }
}

pub fn omni_suggest_category_section(cat : OmniSuggestCategory) -> String {
  match cat {
    OmniSuggestCategory::Calc => "Instant Answer"
    OmniSuggestCategory::SiteSearch => "Site Search"
    OmniSuggestCategory::SwitchTab => "Open Tabs"
    OmniSuggestCategory::Bookmark => "Bookmarks"
    OmniSuggestCategory::History => "History"
    OmniSuggestCategory::DirectUrl => "Go to Site"
    OmniSuggestCategory::Search => "Web Search"
    OmniSuggestCategory::Action => "Commands"
  }
}

///| UTF-8 safe case-insensitive lowercase helper.
///| Folds ASCII `A-Z` and Latin-1 uppercase (`\u{C0}`..`\u{D6}`, `\u{D8}`..`\u{DE}`)
///| while preserving all other multi-byte UTF-8 sequences (CJK, Kana, Emoji) intact.
pub fn omni_suggest_utf8_lower(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c0 = b[i].to_int() & 0xFF
    if c0 >= 0x41 && c0 <= 0x5A {
      out[i] = (c0 + 32).to_byte()
      i = i + 1
    } else if c0 == 0xC3 && i + 1 < n {
      let c1 = b[i + 1].to_int() & 0xFF
      if (c1 >= 0x80 && c1 <= 0x96) || (c1 >= 0x98 && c1 <= 0x9E) {
        out[i] = 0xC3.to_byte()
        out[i + 1] = (c1 + 0x20).to_byte()
        i = i + 2
      } else {
        out[i] = b[i]
        out[i + 1] = b[i + 1]
        i = i + 2
      }
    } else {
      out[i] = b[i]
      i = i + 1
    }
  }
  out.to_string()
}

fn os_find_sub_pos(hay : String, needle : String) -> Int {
  let hb = hay.to_bytes()
  let nb = needle.to_bytes()
  let hn = hb.length()
  let nn = nb.length()
  if nn == 0 {
    return 0
  }
  if nn > hn {
    return -1
  }
  let limit = hn - nn
  let mut i = 0
  while i <= limit {
    let mut j = 0
    while j < nn && hb[i + j] == nb[j] {
      j = j + 1
    }
    if j == nn {
      return i
    }
    i = i + 1
  }
  -1
}

fn os_is_word_boundary(hay : String, pos : Int) -> Bool {
  if pos <= 0 {
    return true
  }
  let hb = hay.to_bytes()
  if pos - 1 >= hb.length() {
    return false
  }
  let prev = hb[pos - 1].to_int() & 0xFF
  prev == 0x20 ||
  prev == 0x2D ||
  prev == 0x5F ||
  prev == 0x2F ||
  prev == 0x2E ||
  prev == 0x3A ||
  prev == 0x3F ||
  prev == 0x26
}

///| Computes UTF-8 case-insensitive prefix / word-boundary / substring match score.
///| Returns `-1.0` when `query` does not match `title`, `host`, or `url`.
pub fn omni_suggest_match_score(
  query : String,
  title : String,
  url : String,
  host : String,
) -> Double {
  let q = omni_suggest_utf8_lower(query.trim())
  if q == "" {
    return 10.0
  }
  let hl = omni_suggest_utf8_lower(host)
  let tl = omni_suggest_utf8_lower(title)
  let ul = omni_suggest_utf8_lower(url)
  let mut best = -1.0
  if hl == q || tl == q {
    best = 120.0
  } else if hl.starts_with(q) || tl.starts_with(q) {
    best = 96.0
  } else {
    let hp = os_find_sub_pos(hl, q)
    let tp = os_find_sub_pos(tl, q)
    if hp >= 0 && os_is_word_boundary(hl, hp) {
      best = 82.0
    } else if tp >= 0 && os_is_word_boundary(tl, tp) {
      best = 78.0
    } else if hp >= 0 {
      best = 64.0
    } else if tp >= 0 {
      best = 58.0
    } else {
      let up = os_find_sub_pos(ul, q)
      if up >= 0 {
        best = if os_is_word_boundary(ul, up) { 46.0 } else { 36.0 }
      }
    }
  }
  if best < 0.0 {
    return -1.0
  }
  let denom = if hl.length() > 0 {
    hl.length()
  } else if tl.length() > 0 {
    tl.length()
  } else {
    1
  }
  let ratio = int_to_double(q.length()) / int_to_double(denom)
  let bonus = if ratio > 1.0 { 12.0 } else { ratio * 12.0 }
  best + bonus
}

fn os_find_canon(list : Array[OmniSuggestItem], canon : String) -> Int {
  let mut i = 0
  while i < list.length() {
    if bookmark_canonical_url(list[i].url) == canon {
      return i
    }
    i = i + 1
  }
  -1
}

fn os_looks_like_direct_url(raw : String) -> Bool {
  let s = raw.trim()
  if s == "" {
    return false
  }
  let low = omni_ascii_lower(s)
  if low.starts_with("http://") ||
  low.starts_with("https://") ||
  low.starts_with("about:") ||
  low.starts_with("localhost") ||
  low.starts_with("127.0.0.1") {
    return true
  }
  let mut has_dot = false
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x20 || c == 0x09 {
      return false
    }
    if c == 0x2E {
      has_dot = true
    }
    i = i + 1
  }
  has_dot
}

///| Ranks Top `max_items` (default 6) rich-categorized Omnibox suggestions across:
///| Instant Calc/Unit Conversion, Site Search (`@gh`/`@yt`/`@mdn`), Open Tabs (`Switch to Tab`),
///| Bookmarks (`Bookmark`), History (`History`), and Direct URL / Web Search fallback.
pub fn rank_omni_suggest_items(
  query : String,
  tabs : Array[TabSummary],
  bookmarks : Array[BookmarkEntry],
  history : Array[HistoryItemSummary],
  max_items~ : Int = OMNI_SUGGEST_MAX_ITEMS,
) -> Array[OmniSuggestItem] {
  let cap = if max_items > 0 { max_items } else { OMNI_SUGGEST_MAX_ITEMS }
  let trimmed = query.trim()
  let pinned_top : Array[OmniSuggestItem] = []

  // 1. Instant Calculator / Unit Converter
  match eval_omnibox_calc(trimmed) {
    Some(calc) =>
    pinned_top.push(
      OmniSuggestItem::{
        category: OmniSuggestCategory::Calc,
        title: calc.display,
        url: calc.value,
        subtitle: calc.expr + " (" + calc.kind_label + ")",
        badge_label: "Copy Result",
        section_title: omni_suggest_category_section(OmniSuggestCategory::Calc),
        tab_id: "",
        visits: 0,
        score: 300.0,
      },
    )
    None => ()
  }

  // 2. Site Search shortcut (`@gh`, `@yt`, `@mdn`, `@wiki`, `@g`)
  let site_search = match_site_search(trimmed)
  match site_search {
    Some(ss) =>
    pinned_top.push(
      OmniSuggestItem::{
        category: OmniSuggestCategory::SiteSearch,
        title: ss.label + ": " + ss.query,
        url: ss.url,
        subtitle: omnibox_display_host(ss.url),
        badge_label: ss.label,
        section_title: omni_suggest_category_section(OmniSuggestCategory::SiteSearch),
        tab_id: "",
        visits: 0,
        score: 260.0,
      },
    )
    None => ()
  }

  let match_q = match site_search {
    Some(ss) => ss.query
    None => trimmed
  }

  let candidates : Array[OmniSuggestItem] = []

  // 3. Open Tabs (`Switch to Tab`)
  let mut ti = 0
  while ti < tabs.length() {
    let t = tabs[ti]
    let u = t.url.trim()
    if u != "" && u != "about:blank" && !t.active {
      let title = workspace_tab_display_title(t)
      let host = omnibox_display_host(u)
      let base = omni_suggest_match_score(match_q, title, u, host)
      if base >= 0.0 {
        let score = base + 55.0 + (if t.pinned || t.favorite { 6.0 } else { 0.0 })
        let canon = bookmark_canonical_url(u)
        let prev_i = os_find_canon(candidates, canon)
        let item = OmniSuggestItem::{
          category: OmniSuggestCategory::SwitchTab,
          title,
          url: u,
          subtitle: host,
          badge_label: omni_suggest_category_badge(OmniSuggestCategory::SwitchTab),
          section_title: omni_suggest_category_section(OmniSuggestCategory::SwitchTab),
          tab_id: t.id,
          visits: 0,
          score,
        }
        if prev_i < 0 {
          candidates.push(item)
        } else if score > candidates[prev_i].score {
          candidates[prev_i] = item
        }
      }
    }
    ti = ti + 1
  }

  // 4. Bookmarks
  let mut bi = 0
  while bi < bookmarks.length() {
    let bm = bookmarks[bi]
    let u = bm.url.trim()
    if u != "" {
      let host = omnibox_display_host(u)
      let title = if bm.title.trim() != "" { bm.title.trim() } else { host }
      let base = omni_suggest_match_score(match_q, title, u, host)
      if base >= 0.0 {
        let score = base + 35.0
        let canon = bookmark_canonical_url(u)
        let prev_i = os_find_canon(candidates, canon)
        let item = OmniSuggestItem::{
          category: OmniSuggestCategory::Bookmark,
          title,
          url: u,
          subtitle: host,
          badge_label: omni_suggest_category_badge(OmniSuggestCategory::Bookmark),
          section_title: omni_suggest_category_section(OmniSuggestCategory::Bookmark),
          tab_id: "",
          visits: 0,
          score,
        }
        if prev_i < 0 {
          candidates.push(item)
        } else {
          let prev = candidates[prev_i]
          if os_cat_priority(OmniSuggestCategory::Bookmark) > os_cat_priority(prev.category) {
            candidates[prev_i] = item
          }
        }
      }
    }
    bi = bi + 1
  }

  // 5. History
  let mut hi = 0
  while hi < history.length() {
    let h = history[hi]
    let u = h.url.trim()
    if u != "" {
      let host = if h.host.trim() != "" { h.host.trim() } else { omnibox_display_host(u) }
      let title = if h.title.trim() != "" { h.title.trim() } else { host }
      let base = omni_suggest_match_score(match_q, title, u, host)
      if base >= 0.0 {
        let vcap = if h.visit_count > 20 { 20 } else if h.visit_count < 0 { 0 } else { h.visit_count }
        let score = base + 15.0 + int_to_double(vcap) * 0.5
        let canon = bookmark_canonical_url(u)
        let prev_i = os_find_canon(candidates, canon)
        let item = OmniSuggestItem::{
          category: OmniSuggestCategory::History,
          title,
          url: u,
          subtitle: host,
          badge_label: omni_suggest_category_badge(OmniSuggestCategory::History),
          section_title: omni_suggest_category_section(OmniSuggestCategory::History),
          tab_id: "",
          visits: h.visit_count,
          score,
        }
        if prev_i < 0 {
          candidates.push(item)
        } else {
          let prev = candidates[prev_i]
          if (prev.category is OmniSuggestCategory::History) && score > prev.score {
            candidates[prev_i] = item
          }
        }
      }
    }
    hi = hi + 1
  }

  // Deterministic insertion sort by (score desc, category priority desc, title asc)
  let mut i = 1
  while i < candidates.length() {
    let cur = candidates[i]
    let mut j = i
    while j > 0 {
      let prev = candidates[j - 1]
      let better = if cur.score > prev.score + 1.0e-6 {
        true
      } else if prev.score > cur.score + 1.0e-6 {
        false
      } else {
        let cp = os_cat_priority(cur.category)
        let pp = os_cat_priority(prev.category)
        if cp != pp {
          cp > pp
        } else {
          cur.title < prev.title
        }
      }
      if better {
        candidates[j] = prev
        j = j - 1
      } else {
        break
      }
    }
    candidates[j] = cur
    i = i + 1
  }

  let out : Array[OmniSuggestItem] = []
  let mut pi = 0
  while pi < pinned_top.length() && out.length() < cap {
    out.push(pinned_top[pi])
    pi = pi + 1
  }

  let reserve_fallback = trimmed != "" && site_search.is_none() && pinned_top.length() == 0
  let body_cap = if reserve_fallback && cap > 1 { cap - 1 } else { cap }
  let mut ci = 0
  while ci < candidates.length() && out.length() < body_cap {
    out.push(candidates[ci])
    ci = ci + 1
  }

  // 6. Direct URL or Web Search fallback
  if reserve_fallback && out.length() < cap {
    let norm_url = omnibox_normalize_input(trimmed)
    let is_url = os_looks_like_direct_url(trimmed)
    let canon = bookmark_canonical_url(norm_url)
    if is_url {
      if os_find_canon(out, canon) < 0 {
        out.push(
          OmniSuggestItem::{
            category: OmniSuggestCategory::DirectUrl,
            title: omnibox_display_host(norm_url),
            url: norm_url,
            subtitle: norm_url,
            badge_label: omni_suggest_category_badge(OmniSuggestCategory::DirectUrl),
            section_title: omni_suggest_category_section(OmniSuggestCategory::DirectUrl),
            tab_id: "",
            visits: 0,
            score: 1.0,
          },
        )
      }
    } else {
      out.push(
        OmniSuggestItem::{
          category: OmniSuggestCategory::Search,
          title: "Search Google for \"" + trimmed + "\"",
          url: norm_url,
          subtitle: "google.com",
          badge_label: omni_suggest_category_badge(OmniSuggestCategory::Search),
          section_title: omni_suggest_category_section(OmniSuggestCategory::Search),
          tab_id: "",
          visits: 0,
          score: 0.5,
        },
      )
    }
  }

  // Fill any remaining slot if fallback was skipped due to duplicate URL
  while ci < candidates.length() && out.length() < cap {
    out.push(candidates[ci])
    ci = ci + 1
  }

  out
}

pub fn OmniSuggestState::update(
  self : OmniSuggestState,
  query : String,
  tabs : Array[TabSummary],
  bookmarks : Array[BookmarkEntry],
  history : Array[HistoryItemSummary],
  open~ : Bool = true,
) -> OmniSuggestState {
  let items = omnibox_order_for_enter(
    query,
    rank_omni_suggest_items(query, tabs, bookmarks, history, max_items=OMNI_SUGGEST_MAX_ITEMS),
  )
  let next_sel = if items.length() == 0 {
    -1
  } else if self.selected >= 0 && self.selected < items.length() {
    self.selected
  } else {
    0
  }
  OmniSuggestState::{
    open: open && items.length() > 0,
    query,
    items,
    selected: next_sel,
  }
}

pub fn OmniSuggestState::move_down(self : OmniSuggestState) -> OmniSuggestState {
  let next = omnibox_step_selection(self.selected, self.items.length(), 1)
  OmniSuggestState::{ ..self, selected: next }
}

pub fn OmniSuggestState::move_up(self : OmniSuggestState) -> OmniSuggestState {
  let next = omnibox_step_selection(self.selected, self.items.length(), -1)
  OmniSuggestState::{ ..self, selected: next }
}

pub fn OmniSuggestState::close(self : OmniSuggestState) -> OmniSuggestState {
  OmniSuggestState::{ ..self, open: false, selected: -1 }
}

pub fn OmniSuggestState::active_item(self : OmniSuggestState) -> Option[OmniSuggestItem] {
  if self.selected >= 0 && self.selected < self.items.length() {
    Some(self.items[self.selected])
  } else {
    None
  }
}

pub fn OmniSuggestState::resolve_enter(self : OmniSuggestState) -> Option[OmniSuggestItem] {
  match self.active_item() {
    Some(it) => Some(it)
    None => {
      if self.items.length() > 0 {
        return Some(self.items[0])
      }
      let trimmed = self.query.trim()
      if trimmed == "" {
        return None
      }
      let norm = omnibox_normalize_input(trimmed)
      let cat = if os_looks_like_direct_url(trimmed) {
        OmniSuggestCategory::DirectUrl
      } else {
        OmniSuggestCategory::Search
      }
      Some(
        OmniSuggestItem::{
          category: cat,
          title: trimmed,
          url: norm,
          subtitle: omnibox_display_host(norm),
          badge_label: omni_suggest_category_badge(cat),
          section_title: omni_suggest_category_section(cat),
          tab_id: "",
          visits: 0,
          score: 0.0,
        },
      )
    }
  }
}

///| Returns the section header label to render above item `idx`, or `None` if it belongs
///| to the same section as `idx - 1` (ensuring zero empty groups and zero double dividers).
pub fn omni_suggest_section_header(items : Array[OmniSuggestItem], idx : Int) -> Option[String] {
  if idx < 0 || idx >= items.length() {
    return None
  }
  if idx == 0 || items[idx].section_title != items[idx - 1].section_title {
    Some(items[idx].section_title)
  } else {
    None
  }
}

// ============================================================================
// 3. Arc Split View Top Focus & Quick-Switch Micro-Toolbar (`SplitBarState`)
// ============================================================================

pub enum SplitBarAction {
  FocusLeft
  FocusRight
  Swap
  Solo
  CloseSplit
}

pub struct SplitBarState {
  pub open : Bool
  pub left_domain : String
  pub right_domain : String
  pub left_url : String
  pub right_url : String
  pub focused_pane : Int
  pub swapped : Bool
}

pub fn SplitBarState::closed() -> SplitBarState {
  SplitBarState::{
    open: false,
    left_domain: "",
    right_domain: "",
    left_url: "",
    right_url: "",
    focused_pane: 0,
    swapped: false,
  }
}

///| Returns true when a display host refers to a local loopback address (`127.0.0.1`, `localhost`, `0.0.0.0`).
pub fn split_bar_is_local_host(host : String) -> Bool {
  let low = omni_ascii_lower(host.trim())
  low == "localhost" ||
  low.starts_with("localhost:") ||
  low == "127.0.0.1" ||
  low.starts_with("127.0.0.1:") ||
  low == "0.0.0.0" ||
  low.starts_with("0.0.0.0:")
}

///| Formats the display label for a Split View focus bar pill:
///| uses the page title when the URL is on a local loopback host (`127.0.0.1` / `localhost`)
///| and a non-empty title is available; otherwise displays the concise source domain.
pub fn split_bar_display_label(title : String, url : String) -> String {
  let host = split_pane_display_host(url)
  let t = title.trim()
  if t != "" && (host == "" || host == "about:blank" || split_bar_is_local_host(host)) {
    t
  } else {
    host
  }
}

///| Builds a `SplitBarState` from the two logical panes (`primary_url` = pane 0,
///| `secondary_url` = pane 1), current logical `active_pane` (`0` or `1`), and `swapped`.
///| `focused_pane` in `SplitBarState` is in visual coordinates (`0` = left, `1` = right).
pub fn SplitBarState::from_panes(
  open : Bool,
  primary_url : String,
  secondary_url : String,
  active_pane : Int,
  swapped : Bool,
) -> SplitBarState {
  SplitBarState::from_panes_with_titles(
    open,
    "",
    primary_url,
    "",
    secondary_url,
    active_pane,
    swapped,
  )
}

///| Builds a `SplitBarState` with optional page titles so local `127.0.0.1` / `localhost`
///| pages display their clean title while external sites display their source domain.
pub fn SplitBarState::from_panes_with_titles(
  open : Bool,
  primary_title : String,
  primary_url : String,
  secondary_title : String,
  secondary_url : String,
  active_pane : Int,
  swapped : Bool,
) -> SplitBarState {
  if !open {
    return SplitBarState::closed()
  }
  let left_url = if swapped { secondary_url } else { primary_url }
  let right_url = if swapped { primary_url } else { secondary_url }
  let left_title = if swapped { secondary_title } else { primary_title }
  let right_title = if swapped { primary_title } else { secondary_title }
  let logical_active = if active_pane == 1 { 1 } else { 0 }
  let visual_focused = if swapped { 1 - logical_active } else { logical_active }
  SplitBarState::{
    open: true,
    left_domain: split_bar_display_label(left_title, left_url),
    right_domain: split_bar_display_label(right_title, right_url),
    left_url,
    right_url,
    focused_pane: visual_focused,
    swapped,
  }
}

///| Returns the logical pane id (`0` or `1`) corresponding to visual side (`0` = left, `1` = right).
pub fn SplitBarState::logical_pane_for_side(self : SplitBarState, visual_side : Int) -> Int {
  let side = if visual_side == 1 { 1 } else { 0 }
  if self.swapped { 1 - side } else { side }
}

///| Applies a `SplitBarAction`, returning `(next_state, survivor_url)`.
///| For `Solo`, `survivor_url` is the currently focused pane's URL.
///| For `CloseSplit`, `survivor_url` is the primary (non-secondary) pane's URL.
pub fn SplitBarState::apply(
  self : SplitBarState,
  action : SplitBarAction,
) -> (SplitBarState, String) {
  if !self.open {
    return (self, "")
  }
  match action {
    SplitBarAction::FocusLeft =>
    (SplitBarState::{ ..self, focused_pane: 0 }, "")
    SplitBarAction::FocusRight =>
    (SplitBarState::{ ..self, focused_pane: 1 }, "")
    SplitBarAction::Swap =>
    (
      SplitBarState::{
        open: true,
        left_domain: self.right_domain,
        right_domain: self.left_domain,
        left_url: self.right_url,
        right_url: self.left_url,
        focused_pane: 1 - self.focused_pane,
        swapped: !self.swapped,
      },
      "",
    )
    SplitBarAction::Solo => {
      let survivor = if self.focused_pane == 1 { self.right_url } else { self.left_url }
      (SplitBarState::closed(), survivor)
    }
    SplitBarAction::CloseSplit => {
      let primary = if self.swapped { self.right_url } else { self.left_url }
      (SplitBarState::closed(), primary)
    }
  }
}

// ============================================================================
// 4. Overlay Mutual-Exclusion Helper
// ============================================================================

///| Pure model helper verifying that opening Omnibox suggestions closes other
///| overlays, and `close_all` clears Omnibox suggestions cleanly.
pub struct ShellOverlaySet {
  pub omni_open : Bool
  pub media_hub_open : Bool
  pub command_bar_open : Bool
}

pub fn ShellOverlaySet::close_all() -> ShellOverlaySet {
  ShellOverlaySet::{
    omni_open: false,
    media_hub_open: false,
    command_bar_open: false,
  }
}

pub fn ShellOverlaySet::open_omni(_self : ShellOverlaySet) -> ShellOverlaySet {
  ShellOverlaySet::{
    omni_open: true,
    media_hub_open: false,
    command_bar_open: false,
  }
}

pub fn ShellOverlaySet::open_media_hub(_self : ShellOverlaySet) -> ShellOverlaySet {
  ShellOverlaySet::{
    omni_open: false,
    media_hub_open: true,
    command_bar_open: false,
  }
}

///| `items` with up to two matching Command Bar actions after them (Arc's one bar: "split" or "zoom" typed into
///| the address palette finds the command). Nothing is added for an empty query or for a URL-like one.
pub fn omnibox_with_actions(query : String, items : Array[OmniSuggestItem], actions : Array[CommandBarItem]) -> Array[OmniSuggestItem] {
  let q = query.trim()
  if q == "" || os_looks_like_direct_url(q) || actions.length() == 0 {
    return items
  }
  let out = items.copy()
  for a in actions {
    out.push(OmniSuggestItem::{
      category: OmniSuggestCategory::Action,
      title: a.title,
      url: a.id,
      subtitle: a.shortcut,
      badge_label: omni_suggest_category_badge(OmniSuggestCategory::Action),
      section_title: omni_suggest_category_section(OmniSuggestCategory::Action),
      tab_id: "",
      visits: 0,
      score: 0.0,
    })
  }
  out
}

///| `s` with a leading `scheme://` and `www.` removed, lowercased (`https://www.GitHub.com/x` -> `github.com/x`).
fn os_bare_url(s : String) -> String {
  let mut t = omni_suggest_utf8_lower(s.trim())
  let mut k = 0
  while k + 3 <= t.length() {
    if t.slice(k, k + 3) == "://" {
      t = t.slice(k + 3, t.length())
      break
    }
    k += 1
  }
  if t.starts_with("www.") {
    t = t.slice(4, t.length())
  }
  t
}

///| Which suggestion Enter takes before the person moves the selection (the inline-autocomplete rule):
///| 0 when the top row is pinned and explicit (a calculation, an `@site` search), or is an open tab, bookmark or
///| history entry whose host or address starts with what was typed (`gith` -> github.com), or an open tab whose title
///| starts with it; -1 otherwise (an empty query, a query with a space, a bookmark / history title or substring match, or the top row already being the Web Search /
///| Direct URL fallback), where Enter goes by the typed text.
pub fn omnibox_default_selection(query : String, items : Array[OmniSuggestItem]) -> Int {
  let q = omni_suggest_utf8_lower(query.trim())
  if q == "" || items.length() == 0 {
    return -1
  }
  let top = items[0]
  match top.category {
    OmniSuggestCategory::Calc | OmniSuggestCategory::SiteSearch => 0
    OmniSuggestCategory::SwitchTab | OmniSuggestCategory::Bookmark | OmniSuggestCategory::History => {
      if q.contains(" ") {
        return -1
      }
      let bq = os_bare_url(q)
      if bq == "" {
        return -1
      }
      let url_hit = os_bare_url(top.url).starts_with(bq) || os_bare_url(top.subtitle).starts_with(bq)
      // An open tab is a strong intent: its title's start counts too (`東京` -> "東京グラフィックス…").
      let tab_title_hit = (top.category is OmniSuggestCategory::SwitchTab) &&
      omni_suggest_utf8_lower(top.title).starts_with(q)
      if url_hit || tab_title_hit { 0 } else { -1 }
    }
    OmniSuggestCategory::DirectUrl | OmniSuggestCategory::Search | OmniSuggestCategory::Action => -1
  }
}

///| The suggestions in the order the palette shows them, so its first row is always what Enter does (Arc's
///| Cmd+T bar): when the top row is not a navigational hit for what was typed (`omnibox_default_selection` is -1)
///| the Web Search / Direct URL fallback moves to the top, and the matches follow in rank order.
pub fn omnibox_order_for_enter(query : String, items : Array[OmniSuggestItem]) -> Array[OmniSuggestItem] {
  if query.trim() == "" || items.length() < 2 || omnibox_default_selection(query, items) == 0 {
    return items
  }
  let mut fb = -1
  let mut i = 0
  while i < items.length() {
    match items[i].category {
      OmniSuggestCategory::DirectUrl | OmniSuggestCategory::Search => {
        fb = i
        break
      }
      _ => ()
    }
    i += 1
  }
  if fb <= 0 {
    return items
  }
  let out : Array[OmniSuggestItem] = [items[fb]]
  let mut j = 0
  while j < items.length() {
    if j != fb {
      out.push(items[j])
    }
    j += 1
  }
  out
}
