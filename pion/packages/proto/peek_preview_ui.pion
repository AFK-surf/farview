///| Pure-Pion portable Arc Peek state model, Sidebar Tab Hover Preview helpers,
///| Webpage Context Menu geometry, and RFC 3986-safe tracking-parameter URL cleaner
///| (`clean_tracking_url`) shared by `pion-app`, `pion-host`, and unit tests.

///| Returns true when `key_lower` (already ASCII-lowercased) is a known ad/analytics tracking parameter.
fn is_tracking_query_param(key_lower : String) -> Bool {
  if key_lower.starts_with("utm_") {
    return true
  }
  key_lower == "fbclid" ||
  key_lower == "gclid" ||
  key_lower == "dclid" ||
  key_lower == "msclkid" ||
  key_lower == "yclid" ||
  key_lower == "mc_cid" ||
  key_lower == "mc_eid" ||
  key_lower == "igshid" ||
  key_lower == "si" ||
  key_lower == "ref_src" ||
  key_lower == "ref_url" ||
  key_lower == "spm" ||
  key_lower == "_hsenc" ||
  key_lower == "_hsmi"
}

fn url_is_http_or_https(url : String) -> Bool {
  let n = url.length()
  if n >= 7 {
    let p7 = omni_ascii_lower(url.slice(0, 7))
    if p7 == "http://" {
      return true
    }
  }
  if n >= 8 {
    let p8 = omni_ascii_lower(url.slice(0, 8))
    if p8 == "https://" {
      return true
    }
  }
  false
}

///| RFC 3986-safe tracking parameter stripper returning `(cleaned_url, removed_count)`.
///| - Leaves non-HTTP(S) URLs (`about:`, `data:`, `file:`, etc.) and invalid/queryless URLs untouched.
///| - Preserves original order and exact percent-encoding of all non-tracking query parameters.
///| - Preserves `#fragment` verbatim and never leaves a dangling `?`.
pub fn clean_tracking_url_ex(url : String) -> (String, Int) {
  if !url_is_http_or_https(url) {
    return (url, 0)
  }
  let n = url.length()
  let mut hash_idx = n
  let mut i = 0
  while i < n {
    if url.code_unit_at(i).to_int() == 0x23 { // '#'
      hash_idx = i
      break
    }
    i = i + 1
  }
  let mut q_idx = -1
  let mut j = 0
  while j < hash_idx {
    if url.code_unit_at(j).to_int() == 0x3F { // '?'
      q_idx = j
      break
    }
    j = j + 1
  }
  if q_idx < 0 || q_idx + 1 >= hash_idx {
    return (url, 0)
  }
  let base = url.slice(0, q_idx)
  let query = url.slice(q_idx + 1, hash_idx)
  let frag = if hash_idx < n { url.slice(hash_idx, n) } else { "" }

  let kept : Array[String] = []
  let mut removed = 0
  let qlen = query.length()
  let mut seg_start = 0
  let mut k = 0
  while k <= qlen {
    if k == qlen || query.code_unit_at(k).to_int() == 0x26 { // '&'
      let seg = query.slice(seg_start, k)
      if seg.length() == 0 {
        kept.push(seg)
      } else {
        let mut eq_idx = seg.length()
        let mut e = 0
        while e < seg.length() {
          if seg.code_unit_at(e).to_int() == 0x3D { // '='
            eq_idx = e
            break
          }
          e = e + 1
        }
        let key_lower = omni_ascii_lower(seg.slice(0, eq_idx))
        if is_tracking_query_param(key_lower) {
          removed = removed + 1
        } else {
          kept.push(seg)
        }
      }
      seg_start = k + 1
    }
    k = k + 1
  }
  if removed == 0 {
    return (url, 0)
  }
  // Drop empty segments only if everything meaningful was removed
  let mut has_non_empty = false
  let mut m = 0
  while m < kept.length() {
    if kept[m].length() > 0 {
      has_non_empty = true
      break
    }
    m = m + 1
  }
  if !has_non_empty {
    return (base + frag, removed)
  }
  (base + "?" + kept.join("&") + frag, removed)
}

///| Strips common tracking query parameters from an HTTP(S) URL while preserving
///| non-tracking query parameters, their original order/encoding, and `#fragment`.
pub fn clean_tracking_url(url : String) -> String {
  clean_tracking_url_ex(url).0
}

///| Formats the native toast copy confirmation message for `Cmd+Shift+C`.
///| What the Copy URL toast says: with `host`, which site's link was copied, so it can be checked at a glance.
pub fn format_copy_clean_url_toast(removed_count : Int, host~ : String = "") -> String {
  let what = if host != "" { host + " link" } else { "URL" }
  if removed_count <= 0 {
    "Copied " + what
  } else if removed_count == 1 {
    "Copied clean " + what + " (1 tracker removed)"
  } else {
    "Copied clean " + what + " (" + removed_count.to_string() + " trackers removed)"
  }
}

///| Returns true when `url` uses HTTPS.
pub fn is_secure_url(url : String) -> Bool {
  let t = url.trim()
  t.length() >= 8 && omni_ascii_lower(t.slice(0, 8)) == "https://"
}

///| Computes the Arc Peek modal `(width, height)` inside `(vw, vh)`:
///| targets ~84% width x ~86% height with narrow-screen safety bounds.
pub fn peek_modal_size(vw : Double, vh : Double) -> (Double, Double) {
  let raw_w = if vw > 100.0 { vw * 0.84 } else { 1040.0 }
  let raw_h = if vh > 100.0 { vh * 0.86 } else { 680.0 }
  let max_w = if vw > 100.0 && vw - 40.0 < 1120.0 { vw - 40.0 } else { 1120.0 }
  let max_h = if vh > 100.0 && vh - 40.0 < 760.0 { vh - 40.0 } else { 760.0 }
  let w = if raw_w > max_w {
    max_w
  } else if raw_w < 320.0 {
    320.0
  } else {
    raw_w
  }
  let h = if raw_h > max_h {
    max_h
  } else if raw_h < 260.0 {
    260.0
  } else {
    raw_h
  }
  (w, h)
}

///| Managed Arc Peek state synced over `wire::Message::PeekState` (tag 64).
pub struct PeekSnapshot {
  pub open : Bool
  pub url : String
  pub title : String
  pub source_tab_id : String
  pub loading : Bool
  pub can_back : Bool
  pub can_forward : Bool
}

pub fn PeekSnapshot::empty() -> PeekSnapshot {
  PeekSnapshot::{
    open: false,
    url: "",
    title: "",
    source_tab_id: "",
    loading: false,
    can_back: false,
    can_forward: false,
  }
}

pub fn encode_peek_snapshot(snap : PeekSnapshot) -> String {
  "{\"open\":" +
  (if snap.open { "true" } else { "false" }) +
  ",\"url\":" +
  omni_json_escape(snap.url) +
  ",\"title\":" +
  omni_json_escape(snap.title) +
  ",\"sourceTabId\":" +
  omni_json_escape(snap.source_tab_id) +
  ",\"loading\":" +
  (if snap.loading { "true" } else { "false" }) +
  ",\"canBack\":" +
  (if snap.can_back { "true" } else { "false" }) +
  ",\"canForward\":" +
  (if snap.can_forward { "true" } else { "false" }) +
  "}"
}

pub fn parse_peek_snapshot(json : String) -> Option[PeekSnapshot] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut open = false
  let mut url = ""
  let mut title = ""
  let mut source_tab_id = ""
  let mut loading = false
  let mut can_back = false
  let mut can_forward = false
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(PeekSnapshot::{ open, url, title, source_tab_id, loading, can_back, can_forward })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "open" {
      match ws_parse_bool(p) {
        Some(v) => open = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "sourceTabId" {
      match p.parse_str() {
        Some(v) => source_tab_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "loading" {
      match ws_parse_bool(p) {
        Some(v) => loading = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "canBack" {
      match ws_parse_bool(p) {
        Some(v) => can_back = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "canForward" {
      match ws_parse_bool(p) {
        Some(v) => can_forward = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
      continue
    }
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(PeekSnapshot::{ open, url, title, source_tab_id, loading, can_back, can_forward })
    }
    return None
  }
  None
}

///| Truncates a long tab title cleanly to fit comfortably within 2 lines inside
///| the Sidebar Tab Hover Preview Card without overflowing or colliding with the URL row.
pub fn tab_preview_display_title(raw_title : String, max_chars~ : Int = 48) -> String {
  let t = raw_title.trim()
  if t.length() <= max_chars || max_chars < 8 {
    return t
  }
  let mut cut = max_chars - 1
  // Prefer breaking on a space within the last 10 characters for clean typography
  let mut scan = cut
  let min_scan = if cut > 10 { cut - 10 } else { 0 }
  while scan > min_scan {
    if t.code_unit_at(scan).to_int() == 0x20 {
      cut = scan
      break
    }
    scan = scan - 1
  }
  t.slice(0, cut).trim() + "…"
}

///| Formats a readable `host/path` string for the Sidebar Tab Hover Preview card,
///| stripping scheme (`http://`/`https://`), `www.`, and tracking query parameters.
pub fn tab_preview_display_url(raw_url : String) -> String {
  let cleaned = clean_tracking_url(raw_url.trim())
  if cleaned == "" {
    return "about:blank"
  }
  let mut s = cleaned
  let lower = omni_ascii_lower(s)
  if lower.starts_with("https://") {
    s = s.slice(8, s.length())
  } else if lower.starts_with("http://") {
    s = s.slice(7, s.length())
  }
  if omni_ascii_lower(s).starts_with("www.") && s.length() > 4 {
    s = s.slice(4, s.length())
  }
  // Drop trailing single slash if bare host
  if s.length() > 1 && s.code_unit_at(s.length() - 1).to_int() == 0x2F {
    let mut has_other_slash = false
    let mut i = 0
    while i < s.length() - 1 {
      if s.code_unit_at(i).to_int() == 0x2F {
        has_other_slash = true
        break
      }
      i = i + 1
    }
    if !has_other_slash {
      s = s.slice(0, s.length() - 1)
    }
  }
  s
}

///| Status badge descriptor for the Sidebar Tab Hover Preview Card.
pub struct TabPreviewBadge {
  pub label : String
  pub kind : String // "space" | "pinned" | "split" | "playing" | "muted" | "reader" | "boost"
}

///| Builds the ordered list of real-time status badges for a hovered sidebar tab.
pub fn build_tab_preview_badges(
  space_name : String,
  pinned : Bool,
  in_split : Bool,
  playing : Bool,
  muted : Bool,
  reader_active : Bool,
  boost_active : Bool,
) -> Array[TabPreviewBadge] {
  let out : Array[TabPreviewBadge] = []
  let sp = space_name.trim()
  if sp != "" {
    out.push(TabPreviewBadge::{ label: sp, kind: "space" })
  }
  if pinned {
    out.push(TabPreviewBadge::{ label: "Pinned", kind: "pinned" })
  }
  if in_split {
    out.push(TabPreviewBadge::{ label: "Split", kind: "split" })
  }
  if muted {
    out.push(TabPreviewBadge::{ label: "Muted", kind: "muted" })
  } else if playing {
    out.push(TabPreviewBadge::{ label: "Playing", kind: "playing" })
  }
  if reader_active {
    out.push(TabPreviewBadge::{ label: "Reader", kind: "reader" })
  }
  if boost_active {
    out.push(TabPreviewBadge::{ label: "Boost", kind: "boost" })
  }
  out
}

///| Clamps the Sidebar Tab Hover Preview card Y position inside `[top_min, viewport_h - card_h - 12.0]`.
pub fn clamp_tab_preview_y(
  anchor_y : Double,
  card_h : Double,
  viewport_h : Double,
  top_min : Double,
) -> Double {
  let lo = if top_min > 8.0 { top_min } else { 8.0 }
  let max_y = viewport_h - card_h - 12.0
  let hi = if max_y > lo { max_y } else { lo }
  let y = if anchor_y != anchor_y { lo } else { anchor_y }
  if y < lo {
    lo
  } else if y > hi {
    hi
  } else {
    y
  }
}

///| Clamps a floating context menu `(x, y)` inside the window safe area.
pub fn clamp_context_menu_pos(
  x : Double,
  y : Double,
  menu_w : Double,
  menu_h : Double,
  vw : Double,
  vh : Double,
) -> (Double, Double) {
  let max_x = if vw - menu_w - 10.0 > 10.0 { vw - menu_w - 10.0 } else { 10.0 }
  let max_y = if vh - menu_h - 10.0 > 10.0 { vh - menu_h - 10.0 } else { 10.0 }
  let cx = if x != x || x < 10.0 {
    10.0
  } else if x > max_x {
    max_x
  } else {
    x
  }
  let cy = if y != y || y < 10.0 {
    10.0
  } else if y > max_y {
    max_y
  } else {
    y
  }
  (cx, cy)
}
