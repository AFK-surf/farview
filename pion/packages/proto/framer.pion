///| Length-prefixed message framer (4-byte big-endian length + body).
///| 1:1 port of `client/src/proto/framer.mbt`.

let MAX_MESSAGE : Int = 256 * 1024 * 1024

pub struct Framer {
  mut buf : Bytes
  mut start : Int
  mut end : Int
  mut broken_flag : Bool
}

pub fn Framer::new() -> Framer {
  Framer::{ buf: Bytes::new(65536), start: 0, end: 0, broken_flag: false }
}

pub fn Framer::broken(self : Framer) -> Bool {
  self.broken_flag
}

pub fn Framer::clear(self : Framer) -> Unit {
  self.start = 0
  self.end = 0
  self.broken_flag = false
}

extern "C" fn proto_c_memmove(dst : Ptr, src : Ptr, n : Int64) -> Ptr = "memmove"

fn proto_bytes_blit(dst : Bytes, dst_off : Int, src : Bytes, src_off : Int, len : Int) -> Unit {
  if len <= 0 {
    return
  }
  let _ = proto_c_memmove(
    ptr_offset(bytes_data_ptr(dst), dst_off.to_int64()),
    ptr_offset(bytes_data_ptr(src), src_off.to_int64()),
    len.to_int64(),
  )
}

pub fn Framer::push(self : Framer, chunk : Bytes) -> Unit {
  let n = chunk.length()
  if n == 0 {
    return
  }
  if self.end + n > self.buf.length() {
    let live = self.end - self.start
    let need = live + n
    if need <= self.buf.length() / 2 && self.start > 0 {
      proto_bytes_blit(self.buf, 0, self.buf, self.start, live)
      self.start = 0
      self.end = live
    } else {
      let size = if need >= 262144 {
        need + 65536
      } else {
        let mut c = self.buf.length() * 2
        while c < need {
          c = c * 2
        }
        c
      }
      let fresh = Bytes::new(size)
      proto_bytes_blit(fresh, 0, self.buf, self.start, live)
      self.buf = fresh
      self.start = 0
      self.end = live
    }
  }
  proto_bytes_blit(self.buf, self.end, chunk, 0, n)
  self.end = self.end + n
}

pub fn Framer::next(self : Framer) -> Option[Bytes] {
  if self.broken_flag || self.end - self.start < 4 {
    return None
  }
  let d = self.buf
  let s = self.start
  let n = (d[s].to_int() << 24) |
  (d[s + 1].to_int() << 16) |
  (d[s + 2].to_int() << 8) |
  d[s + 3].to_int()
  if n < 0 || n > MAX_MESSAGE {
    self.broken_flag = true
    self.start = 0
    self.end = 0
    return None
  }
  if self.end - s < 4 + n {
    return None
  }
  let body = d.slice(s + 4, s + 4 + n)
  self.start = s + 4 + n
  if self.start == self.end {
    self.start = 0
    self.end = 0
    if self.buf.length() > 524288 {
      self.buf = Bytes::new(65536)
    }
  }
  Some(body)
}
