///| Length-prefixed message framer (4-byte big-endian length + body).
///| 1:1 port of `client/src/proto/framer.mbt`.

let MAX_MESSAGE : Int = 256 * 1024 * 1024

pub struct Framer {
  mut buf : Bytes
  mut start : Int
  mut end : Int
  mut broken_flag : Bool
}

pub fn Framer::new() -> Framer {
  Framer::{ buf: Bytes::new(65536), start: 0, end: 0, broken_flag: false }
}

pub fn Framer::broken(self : Framer) -> Bool {
  self.broken_flag
}

pub fn Framer::clear(self : Framer) -> Unit {
  self.start = 0
  self.end = 0
  self.broken_flag = false
}

pub fn Framer::push(self : Framer, chunk : Bytes) -> Unit {
  let n = chunk.length()
  if self.end + n > self.buf.length() {
    let live = self.end - self.start
    let size = if live + n > self.buf.length() / 2 {
      let mut c = self.buf.length() * 2
      while c < live + n {
        c = c * 2
      }
      c
    } else {
      self.buf.length()
    }
    let fresh = Bytes::new(size)
    let mut i = 0
    while i < live {
      fresh[i] = self.buf[self.start + i]
      i = i + 1
    }
    self.buf = fresh
    self.start = 0
    self.end = live
  }
  let mut i = 0
  while i < n {
    self.buf[self.end + i] = chunk[i]
    i = i + 1
  }
  self.end = self.end + n
}

pub fn Framer::next(self : Framer) -> Option[Bytes] {
  if self.broken_flag || self.end - self.start < 4 {
    return None
  }
  let d = self.buf
  let s = self.start
  let n = (d[s].to_int() << 24) |
  (d[s + 1].to_int() << 16) |
  (d[s + 2].to_int() << 8) |
  d[s + 3].to_int()
  if n < 0 || n > MAX_MESSAGE {
    self.broken_flag = true
    self.start = 0
    self.end = 0
    return None
  }
  if self.end - s < 4 + n {
    return None
  }
  let body = d.slice(s + 4, s + 4 + n)
  self.start = s + 4 + n
  if self.start == self.end {
    self.start = 0
    self.end = 0
  }
  Some(body)
}
