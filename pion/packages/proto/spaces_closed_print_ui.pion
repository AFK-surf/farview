///| Pure-Pion portable UI helpers & codecs for:
///| 1. Arc Spaces Manager (6-color classic Arc accent palette, delete safety, tab count badges)
///| 2. Recently Closed Tabs (`wire::Message::ClosedTabsState`, tag 66: JSON codec, UTF-8 safe
///|    search filter via `omni_ascii_lower`, and relative time formatter)
///| 3. Native `Cmd+P` Print / Export PDF Dialog (paper dimensions in mm/px, aspect ratio,
///|    margin fractions, spec summary, and JSON config codec)

pub let CLOSED_TABS_MAX_ITEMS : Int = 16

pub struct SpaceAccentPreset {
  pub key : String
  pub label : String
  pub hex : String
  pub rgba : Int64
}

///| Classic 6-color Arc Space accent swatch catalog:
///| `blue`, `purple`, `emerald`, `amber`, `rose`, `slate`.
pub fn arc_space_accent_presets() -> Array[SpaceAccentPreset] {
  [
    SpaceAccentPreset::{ key: "blue", label: "Blue", hex: "#2563EB", rgba: 0x2563EBFFL },
    SpaceAccentPreset::{ key: "purple", label: "Purple", hex: "#8B5CF6", rgba: 0x8B5CF6FFL },
    SpaceAccentPreset::{ key: "emerald", label: "Emerald", hex: "#10B981", rgba: 0x10B981FFL },
    SpaceAccentPreset::{ key: "amber", label: "Amber", hex: "#F59E0B", rgba: 0xF59E0BFFL },
    SpaceAccentPreset::{ key: "rose", label: "Rose", hex: "#F43F5E", rgba: 0xF43F5EFFL },
    SpaceAccentPreset::{ key: "slate", label: "Slate", hex: "#64748B", rgba: 0x64748BFFL },
  ]
}

///| Resolves either a semantic Arc palette key (`"blue"`, `"purple"`, `"emerald"`,
///| `"amber"`, `"rose"`, `"slate"`) or a `#RRGGBB` hex string to a normalized `#RRGGBB` hex.
pub fn space_accent_hex_for_key(raw : String) -> String {
  let k = omni_ascii_lower(raw.trim())
  if k == "blue" {
    "#2563EB"
  } else if k == "purple" || k == "violet" {
    "#8B5CF6"
  } else if k == "emerald" || k == "green" {
    "#10B981"
  } else if k == "amber" || k == "orange" || k == "yellow" {
    "#F59E0B"
  } else if k == "rose" || k == "pink" || k == "red" {
    "#F43F5E"
  } else if k == "slate" || k == "gray" || k == "grey" {
    "#64748B"
  } else {
    normalize_space_accent(raw)
  }
}

///| Human-readable swatch name for a `#RRGGBB` accent hex.
pub fn space_accent_label_for_hex(hex_raw : String) -> String {
  let h = normalize_space_accent(hex_raw)
  if h == "#2563EB" {
    "Blue"
  } else if h == "#8B5CF6" {
    "Purple"
  } else if h == "#10B981" {
    "Emerald"
  } else if h == "#F59E0B" {
    "Amber"
  } else if h == "#F43F5E" || h == "#EC4899" {
    "Rose"
  } else if h == "#64748B" {
    "Slate"
  } else if h == "#06B6D4" {
    "Cyan"
  } else {
    "Custom"
  }
}

///| Returns true only when `space_id` can be safely deleted (always keeps at least 1 Space).
pub fn space_can_delete(snap : WorkspaceSnapshot, space_id : String) -> Bool {
  if snap.spaces.length() <= 1 || space_id.trim() == "" {
    return false
  }
  let mut i = 0
  while i < snap.spaces.length() {
    if snap.spaces[i].id == space_id {
      return true
    }
    i = i + 1
  }
  false
}

///| Formats a Space's tab count pill label (`"0 tabs"`, `"1 tab"`, `"4 tabs"`).
pub fn space_tab_count_label(count : Int) -> String {
  let n = if count < 0 { 0 } else { count }
  if n == 1 {
    "1 tab"
  } else {
    n.to_string() + " tabs"
  }
}

// --- Recently Closed Tabs (`wire` tag 66 `ClosedTabsState`) ---

pub struct ClosedTabItem {
  pub index : Int
  pub title : String
  pub url : String
  pub host : String
  pub space_name : String
  pub closed_secs : Int64
}

pub struct ClosedTabsSnapshot {
  pub items : Array[ClosedTabItem]
}

pub fn ClosedTabsSnapshot::empty() -> ClosedTabsSnapshot {
  ClosedTabsSnapshot::{ items: [] }
}

///| Encodes `ClosedTabsSnapshot` as canonical JSON for `wire::Message::ClosedTabsState` (tag 66).
pub fn encode_closed_tabs_state(snap : ClosedTabsSnapshot) -> String {
  let parts : Array[String] = []
  let lim = if snap.items.length() > CLOSED_TABS_MAX_ITEMS {
    CLOSED_TABS_MAX_ITEMS
  } else {
    snap.items.length()
  }
  let mut i = 0
  while i < lim {
    let it = snap.items[i]
    let host = if it.host.trim() != "" { it.host.trim() } else { omnibox_display_host(it.url) }
    let title = if it.title.trim() != "" { it.title.trim() } else if host != "" { host } else { it.url }
    parts.push(
      "{\"index\":" +
      it.index.to_string() +
      ",\"title\":" +
      omni_json_escape(title) +
      ",\"url\":" +
      omni_json_escape(it.url) +
      ",\"host\":" +
      omni_json_escape(host) +
      ",\"spaceName\":" +
      omni_json_escape(it.space_name) +
      ",\"closedSecs\":" +
      it.closed_secs.to_string() +
      "}",
    )
    i = i + 1
  }
  "{\"items\":[" + parts.join(",") + "]}"
}

fn scp_parse_i64(p : OmniJsonParser) -> Option[Int64] {
  p.skip_ws()
  let start = p.i
  let mut neg = false
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2D {
    neg = true
    p.i = p.i + 1
  }
  let dig_start = p.i
  let mut acc = 0L
  while p.i < p.n {
    let c = p.s.code_unit_at(p.i).to_int()
    if c >= 0x30 && c <= 0x39 {
      acc = acc * 10L + (c - 0x30).to_int64()
      p.i = p.i + 1
    } else {
      break
    }
  }
  if p.i == dig_start {
    p.i = start
    return None
  }
  Some(if neg { 0L - acc } else { acc })
}

fn scp_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

fn scp_parse_closed_item(p : OmniJsonParser, fallback_index : Int) -> Option[ClosedTabItem] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut index = fallback_index
  let mut title = ""
  let mut url = ""
  let mut host = ""
  let mut space_name = ""
  let mut closed_secs = 0L
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(ClosedTabItem::{ index, title, url, host, space_name, closed_secs })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "index" {
      match scp_parse_i64(p) {
        Some(v) => index = v.to_int()
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "host" {
      match p.parse_str() {
        Some(v) => host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "spaceName" || key == "space_name" {
      match p.parse_str() {
        Some(v) => space_name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "closedSecs" || key == "closed_secs" {
      match scp_parse_i64(p) {
        Some(v) => closed_secs = v
        None => if !p.skip_value() { return None }
      }
    } else {
      if !p.skip_value() {
        return None
      }
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
      p.skip_ws()
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      let final_host = if host.trim() != "" { host.trim() } else { omnibox_display_host(url) }
      let final_title = if title.trim() != "" {
        title.trim()
      } else if final_host != "" {
        final_host
      } else {
        url
      }
      return Some(ClosedTabItem::{
        index,
        title: final_title,
        url,
        host: final_host,
        space_name,
        closed_secs,
      })
    } else {
      return None
    }
  }
  None
}

fn scp_parse_closed_array(p : OmniJsonParser, max_items : Int) -> Option[Array[ClosedTabItem]] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
    return None
  }
  p.i = p.i + 1
  let out : Array[ClosedTabItem] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
    p.i = p.i + 1
    return Some(out)
  }
  let mut idx = 0
  while p.i < p.n {
    match scp_parse_closed_item(p, idx) {
      Some(item) => {
        if out.length() < max_items && item.url.trim() != "" {
          out.push(item)
        }
        idx = idx + 1
      }
      None => return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
      p.skip_ws()
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
      p.i = p.i + 1
      return Some(out)
    } else {
      return None
    }
  }
  None
}

///| Parses `wire::Message::ClosedTabsState` JSON payload (`{"items":[...]}` or bare `[...]`).
///| Returns `None` on malformed or truncated JSON.
pub fn parse_closed_tabs_state(json : String, max_items~ : Int = CLOSED_TABS_MAX_ITEMS) -> Option[ClosedTabsSnapshot] {
  let cap = if max_items <= 0 { CLOSED_TABS_MAX_ITEMS } else { max_items }
  let p = OmniJsonParser::{ s: json, i: 0, n: json.length() }
  p.skip_ws()
  if p.i >= p.n {
    return None
  }
  let first = p.s.code_unit_at(p.i).to_int()
  if first == 0x5B {
    match scp_parse_closed_array(p, cap) {
      Some(items) => return Some(ClosedTabsSnapshot::{ items })
      None => return None
    }
  }
  if first != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut items : Array[ClosedTabItem] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(ClosedTabsSnapshot::{ items })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "items" {
      match scp_parse_closed_array(p, cap) {
        Some(arr) => items = arr
        None => return None
      }
    } else {
      if !p.skip_value() {
        return None
      }
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
      p.skip_ws()
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(ClosedTabsSnapshot::{ items })
    } else {
      return None
    }
  }
  None
}

///| UTF-8 safe case-insensitive search filter over closed tabs (matches title, URL, host, or Space name).
pub fn filter_closed_tabs(items : Array[ClosedTabItem], raw_query : String) -> Array[ClosedTabItem] {
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    return items
  }
  let out : Array[ClosedTabItem] = []
  let mut i = 0
  while i < items.length() {
    let it = items[i]
    if omni_ascii_lower(it.title).contains(q) ||
    omni_ascii_lower(it.url).contains(q) ||
    omni_ascii_lower(it.host).contains(q) ||
    omni_ascii_lower(it.space_name).contains(q) {
      out.push(it)
    }
    i = i + 1
  }
  out
}

///| Formats a closed-tab Unix timestamp (seconds) relative to `now_secs`:
///| `"Just now"`, `"2m ago"`, `"3h ago"`, `"Yesterday"`, or `"4d ago"`.
pub fn format_closed_relative_time(closed_secs : Int64, now_secs : Int64) -> String {
  if closed_secs <= 0L {
    return "Recently"
  }
  let diff = now_secs - closed_secs
  if diff < 60L {
    "Just now"
  } else if diff < 3600L {
    (diff / 60L).to_string() + "m ago"
  } else if diff < 86400L {
    (diff / 3600L).to_string() + "h ago"
  } else if diff < 172800L {
    "Yesterday"
  } else {
    (diff / 86400L).to_string() + "d ago"
  }
}

// --- Native `Cmd+P` Print / Export PDF Configuration Specs ---

pub struct PrintPdfConfig {
  pub paper : String
  pub orientation : String
  pub margins : String
  pub background_graphics : Bool
}

pub fn print_pdf_default_config() -> PrintPdfConfig {
  PrintPdfConfig::{
    paper: "a4",
    orientation: "portrait",
    margins: "default",
    background_graphics: true,
  }
}

pub fn normalize_print_paper(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "letter" || s == "us-letter" || s == "us_letter" {
    "letter"
  } else if s == "legal" || s == "us-legal" || s == "us_legal" {
    "legal"
  } else {
    "a4"
  }
}

pub fn normalize_print_orientation(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "landscape" {
    "landscape"
  } else {
    "portrait"
  }
}

pub fn normalize_print_margins(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "narrow" {
    "narrow"
  } else if s == "wide" {
    "wide"
  } else if s == "none" || s == "zero" {
    "none"
  } else {
    "default"
  }
}

///| Returns `(width_mm, height_mm)` for the configured paper size and orientation.
///| A4 Portrait: `210 × 297 mm`; US Letter Portrait: `215.9 × 279.4 mm`; US Legal Portrait: `215.9 × 355.6 mm`.
pub fn print_pdf_dimensions_mm(cfg : PrintPdfConfig) -> (Double, Double) {
  let paper = normalize_print_paper(cfg.paper)
  let orient = normalize_print_orientation(cfg.orientation)
  let (base_w, base_h) = if paper == "letter" {
    (215.9, 279.4)
  } else if paper == "legal" {
    (215.9, 355.6)
  } else {
    (210.0, 297.0)
  }
  if orient == "landscape" {
    (base_h, base_w)
  } else {
    (base_w, base_h)
  }
}

///| Returns `(width_px, height_px)` at 96 CSS DPI for host PDF pagination.
///| A4 Portrait ≈ `(794.0, 1123.0)`, US Letter Portrait ≈ `(816.0, 1056.0)`.
pub fn print_pdf_dimensions_px(cfg : PrintPdfConfig) -> (Double, Double) {
  let (w_mm, h_mm) = print_pdf_dimensions_mm(cfg)
  let w_px = (w_mm * 96.0 / 25.4 + 0.5).floor()
  let h_px = (h_mm * 96.0 / 25.4 + 0.5).floor()
  (w_px, h_px)
}

///| Returns the paper aspect ratio `width / height` for the live Export PDF preview card.
pub fn print_pdf_aspect_ratio(cfg : PrintPdfConfig) -> Double {
  let (w_mm, h_mm) = print_pdf_dimensions_mm(cfg)
  if h_mm <= 0.0 {
    0.707
  } else {
    w_mm / h_mm
  }
}

///| Returns the uniform page margin in millimeters:
///| `default` -> `12.7 mm` (0.5 in), `narrow` -> `6.35 mm` (0.25 in), `wide` -> `25.4 mm` (1.0 in), `none` -> `0.0 mm`.
pub fn print_pdf_margin_mm(margins : String) -> Double {
  let m = normalize_print_margins(margins)
  if m == "narrow" {
    6.35
  } else if m == "wide" {
    25.4
  } else if m == "none" {
    0.0
  } else {
    12.7
  }
}

///| Returns `(margin_x_fraction, margin_y_fraction)` relative to paper width/height
///| so the visual preview card renders accurate proportional page-margin guides.
pub fn print_pdf_margin_fraction(cfg : PrintPdfConfig) -> (Double, Double) {
  let m = print_pdf_margin_mm(cfg.margins)
  let (w_mm, h_mm) = print_pdf_dimensions_mm(cfg)
  let fx = if w_mm > 0.0 { m / w_mm } else { 0.0 }
  let fy = if h_mm > 0.0 { m / h_mm } else { 0.0 }
  (fx, fy)
}

///| Human-readable paper dimension summary (e.g. `"210 × 297 mm"` or `"279 × 216 mm"`).
pub fn print_pdf_spec_summary(cfg : PrintPdfConfig) -> String {
  let (w_mm, h_mm) = print_pdf_dimensions_mm(cfg)
  let wi = (w_mm + 0.5).floor().to_int()
  let hi = (h_mm + 0.5).floor().to_int()
  wi.to_string() + " × " + hi.to_string() + " mm"
}

///| Encodes `PrintPdfConfig` as compact JSON for `Act("export_pdf", filename, cfg_json)`.
pub fn encode_print_pdf_config(cfg : PrintPdfConfig) -> String {
  encode_print_pdf_config_with_req(cfg, "")
}

///| Encodes `PrintPdfConfig` with an optional `"reqId"` correlation field.
///| Older hosts ignore unknown `"reqId"` cleanly via `skip_value()`.
pub fn encode_print_pdf_config_with_req(cfg : PrintPdfConfig, req_id : String) -> String {
  let req_part = if req_id != "" { ",\"reqId\":" + omni_json_escape(req_id) } else { "" }
  "{\"paper\":" +
  omni_json_escape(normalize_print_paper(cfg.paper)) +
  ",\"orientation\":" +
  omni_json_escape(normalize_print_orientation(cfg.orientation)) +
  ",\"margins\":" +
  omni_json_escape(normalize_print_margins(cfg.margins)) +
  ",\"backgroundGraphics\":" +
  (if cfg.background_graphics { "true" } else { "false" }) +
  req_part +
  "}"
}

///| Extracts optional `"reqId"` from a `PrintPdfConfig` JSON payload (`""` if absent/invalid).
pub fn parse_print_pdf_req_id(raw : String) -> String {
  let p = OmniJsonParser::{ s: raw, i: 0, n: raw.length() }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return ""
  }
  p.i = p.i + 1
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    return ""
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return ""
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return ""
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "reqId" || key == "req_id" {
      match p.parse_str() {
        Some(v) => return v.trim()
        None => if !p.skip_value() { return "" }
      }
    } else if !p.skip_value() {
      return ""
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
      p.skip_ws()
    } else {
      break
    }
  }
  ""
}

///| Parses `PrintPdfConfig` from JSON; returns defaults for any missing/invalid fields.
pub fn parse_print_pdf_config(raw : String) -> PrintPdfConfig {
  let def = print_pdf_default_config()
  let p = OmniJsonParser::{ s: raw, i: 0, n: raw.length() }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return def
  }
  p.i = p.i + 1
  let mut paper = def.paper
  let mut orientation = def.orientation
  let mut margins = def.margins
  let mut background_graphics = def.background_graphics
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    return def
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return PrintPdfConfig::{ paper, orientation, margins, background_graphics }
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return PrintPdfConfig::{ paper, orientation, margins, background_graphics }
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "paper" {
      match p.parse_str() {
        Some(v) => paper = normalize_print_paper(v)
        None => if !p.skip_value() { break }
      }
    } else if key == "orientation" {
      match p.parse_str() {
        Some(v) => orientation = normalize_print_orientation(v)
        None => if !p.skip_value() { break }
      }
    } else if key == "margins" {
      match p.parse_str() {
        Some(v) => margins = normalize_print_margins(v)
        None => if !p.skip_value() { break }
      }
    } else if key == "backgroundGraphics" || key == "background_graphics" {
      match scp_parse_bool(p) {
        Some(v) => background_graphics = v
        None => if !p.skip_value() { break }
      }
    } else {
      if !p.skip_value() {
        break
      }
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
      p.skip_ws()
    } else {
      break
    }
  }
  PrintPdfConfig::{ paper, orientation, margins, background_graphics }
}
