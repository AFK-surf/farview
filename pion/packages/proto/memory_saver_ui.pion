///| Memory Saver state the host sends the client (`wire::Message::Act("memory_saver_state", payload, "")`): whether
///| it is on, the memory the discarded tabs saved, the host's own memory, and each tab's measured memory and whether
///| it is discarded, for the tab hover card and the page details HUD.
///|
///| Payload (text, one record per line, fields split by tabs):
///|   `fvms1\t<enabled 0|1>\t<saved_kb>\t<host_rss_kb>` then one `<tab_id>\t<memory_kb>\t<discarded 0|1>\t<freed_kb>`
///|   line per tab the host has a number for.

pub struct TabMemory {
  pub tab_id : String
  ///| what the tab holds now (KB; 0 unknown, or discarded)
  pub memory_kb : Int64
  pub discarded : Bool
  ///| what discarding it freed (KB)
  pub freed_kb : Int64
}

pub struct MemorySaverSnapshot {
  pub enabled : Bool
  pub saved_kb : Int64
  pub host_rss_kb : Int64
  pub tabs : Array[TabMemory]
}

pub fn MemorySaverSnapshot::empty() -> MemorySaverSnapshot {
  MemorySaverSnapshot::{ enabled: false, saved_kb: 0L, host_rss_kb: 0L, tabs: [] }
}

fn ms_kb_text(v : Int64) -> String {
  (if v < 0L { 0L } else { v }).to_string()
}

pub fn encode_memory_saver_snapshot(snap : MemorySaverSnapshot) -> String {
  let sb = StringBuilder::new()
  sb.write_string("fvms1\t")
  sb.write_string(if snap.enabled { "1" } else { "0" })
  sb.write_string("\t" + ms_kb_text(snap.saved_kb) + "\t" + ms_kb_text(snap.host_rss_kb))
  for t in snap.tabs {
    // (an id never holds a tab or a line break: one that does is left out rather than breaking the record)
    if t.tab_id == "" || t.tab_id.contains("\t") || t.tab_id.contains("\n") {
      continue
    }
    sb.write_string("\n" + t.tab_id + "\t" + ms_kb_text(t.memory_kb) + "\t" + (if t.discarded { "1" } else { "0" }))
    sb.write_string("\t" + ms_kb_text(t.freed_kb))
  }
  sb.to_string()
}

fn ms_parse_kb(s : String) -> Option[Int64] {
  let t = s.trim()
  if t == "" || t.length() > 18 {
    return None
  }
  let mut v = 0L
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i).to_int()
    if c < 0x30 || c > 0x39 {
      return None
    }
    v = v * 10L + (c - 0x30).to_int64()
    i += 1
  }
  Some(v)
}

fn ms_parse_flag(s : String) -> Option[Bool] {
  let t = s.trim()
  if t == "1" {
    Some(true)
  } else if t == "0" {
    Some(false)
  } else {
    None
  }
}

///| Parses `encode_memory_saver_snapshot`'s payload; None when it is not one (a malformed tab line is skipped).
pub fn parse_memory_saver_snapshot(payload : String) -> Option[MemorySaverSnapshot] {
  let lines = payload.split("\n")
  if lines.length() == 0 {
    return None
  }
  let head = lines[0].split("\t")
  if head.length() < 4 || head[0] != "fvms1" {
    return None
  }
  let enabled = match ms_parse_flag(head[1]) {
    Some(b) => b
    None => return None
  }
  let saved = match ms_parse_kb(head[2]) {
    Some(v) => v
    None => return None
  }
  let rss = match ms_parse_kb(head[3]) {
    Some(v) => v
    None => return None
  }
  let tabs : Array[TabMemory] = []
  let mut i = 1
  while i < lines.length() {
    let f = lines[i].split("\t")
    if f.length() >= 4 && f[0].trim() != "" {
      match (ms_parse_kb(f[1]), ms_parse_flag(f[2]), ms_parse_kb(f[3])) {
        (Some(mem), Some(d), Some(freed)) =>
        tabs.push(TabMemory::{ tab_id: f[0].trim(), memory_kb: mem, discarded: d, freed_kb: freed })
        _ => ()
      }
    }
    i += 1
  }
  Some(MemorySaverSnapshot::{ enabled, saved_kb: saved, host_rss_kb: rss, tabs })
}

///| Tab `tab_id`'s memory record, if the host sent one.
pub fn memory_saver_tab(snap : MemorySaverSnapshot, tab_id : String) -> Option[TabMemory] {
  for t in snap.tabs {
    if t.tab_id == tab_id {
      return Some(t)
    }
  }
  None
}

///| KB as a person reads it: "<1 MB", "245 MB", "1.4 GB" (MB and GB of 1024).
pub fn format_memory_kb(kb : Int64) -> String {
  if kb < 1024L {
    return "<1 MB"
  }
  let mb = (kb + 512L) / 1024L
  if mb < 1024L {
    return mb.to_string() + " MB"
  }
  let tenths = (kb * 10L + 524288L) / 1048576L
  (tenths / 10L).to_string() + "." + (tenths % 10L).to_string() + " GB"
}

///| The hover card's line for a tab ("" none): a discarded tab says it is inactive and what that saved; the tab
///| shown says what the page holds.
pub fn memory_saver_hover_label(t : TabMemory) -> String {
  if t.discarded {
    if t.freed_kb >= 1024L {
      "Inactive, saved " + format_memory_kb(t.freed_kb)
    } else {
      "Inactive to save memory"
    }
  } else if t.memory_kb > 0L {
    "Memory " + format_memory_kb(t.memory_kb)
  } else {
    ""
  }
}
