///| Round-trip and robustness tests for the password manager / autofill wire model (`passwords_ui.pion`).

test "passwords wire: list summaries round-trip and never carry a password field" {
  let snap = PasswordListSnapshot::{
    query: "ex",
    items: [
      PasswordItemSummary::{
        id: "pw-1",
        origin: "https://accounts.example.com",
        signon_realm: "https://accounts.example.com/",
        username: "ada@example.com",
        display_name: "Example \"Work\"",
        created_at: 1700000000L,
        updated_at: 1700000100L,
        last_used_at: 0L,
        times_used: 3,
      },
    ],
  }
  let json = encode_password_list(snap)
  debug_assert(!json.contains("password\""), "a list broadcast has no password key")
  match parse_password_list(json) {
    Some(back) => {
      debug_assert(back.query == "ex" && back.items.length() == 1, "query and one item")
      let it = back.items[0]
      debug_assert(it.id == "pw-1" && it.username == "ada@example.com", "id and username")
      debug_assert(it.display_name == "Example \"Work\"", "escaped quotes survive")
      debug_assert(it.created_at == 1700000000L && it.updated_at == 1700000100L && it.times_used == 3, "numbers")
      debug_assert(it.signon_realm == "https://accounts.example.com/", "realm")
    }
    None => debug_assert(false, "list parses")
  }
  debug_assert(parse_password_list("{\"items\":[{\"id\":\"a\"},").is_none(), "truncated JSON is None")
  debug_assert(parse_password_list("[]").is_none(), "not an object")
}

test "passwords wire: prompt, autofill query/snapshot/fill, command and reveal round-trip" {
  let pr = PasswordPromptState::{
    visible: true,
    prompt_id: "pp-7",
    kind: "update",
    origin: "https://example.com",
    username: "ada",
    display_name: "example.com",
    password_len: 12,
  }
  match parse_password_prompt(encode_password_prompt(pr)) {
    Some(b) => debug_assert(b.visible && b.prompt_id == "pp-7" && b.kind == "update" && b.password_len == 12, "prompt")
    None => debug_assert(false, "prompt parses")
  }
  match parse_password_prompt("{\"kind\":\"evil\"}") {
    Some(b) => debug_assert(b.kind == "save" && !b.visible, "unknown kind falls back to save")
    None => debug_assert(false, "lenient prompt")
  }
  let q = AutofillQuery::{ req_id: "q1", url: "https://example.com/login", field_id: 41, password_field_id: 42 }
  match parse_autofill_query(encode_autofill_query(q)) {
    Some(b) => debug_assert(b.req_id == "q1" && b.field_id == 41 && b.password_field_id == 42 && b.url == q.url, "query")
    None => debug_assert(false, "query parses")
  }
  match parse_autofill_query("{\"url\":\"x\"}") {
    Some(b) => debug_assert(b.field_id == -1 && b.password_field_id == -1, "missing ids are -1")
    None => debug_assert(false, "lenient query")
  }
  let snap = AutofillSnapshot::{
    req_id: "q1",
    field_id: 41,
    password_field_id: 42,
    can_generate: true,
    suggestions: [
      AutofillSuggestion::{ id: "pw-1", origin: "https://example.com", username: "ada", display_name: "", exact: true },
      AutofillSuggestion::{ id: "pw-2", origin: "https://accounts.example.com", username: "bob", display_name: "", exact: false },
    ],
  }
  let sj = encode_autofill_snapshot(snap)
  debug_assert(!sj.contains("\"password\""), "suggestions carry no password")
  match parse_autofill_snapshot(sj) {
    Some(b) => {
      debug_assert(b.suggestions.length() == 2 && b.can_generate, "two suggestions, generate")
      debug_assert(b.suggestions[0].exact && !b.suggestions[1].exact, "exactness")
      debug_assert(b.suggestions[1].origin == "https://accounts.example.com", "origin kept")
    }
    None => debug_assert(false, "snapshot parses")
  }
  let f = AutofillFillRequest::{ url: "https://example.com/", id: "pw-1", field_id: 41, password_field_id: 42, generate: false }
  match parse_autofill_fill(encode_autofill_fill(f)) {
    Some(b) => debug_assert(b.id == "pw-1" && !b.generate && b.password_field_id == 42, "fill")
    None => debug_assert(false, "fill parses")
  }
  let c = PasswordCommand::{ ..PasswordCommand::empty(), prompt_id: "pp-7", username: "ada\u{2026}", never: true }
  match parse_password_command(encode_password_command(c)) {
    Some(b) => debug_assert(b.prompt_id == "pp-7" && b.never && b.username == "ada\u{2026}", "command keeps UTF-8")
    None => debug_assert(false, "command parses")
  }
  let r = PasswordRevealResult::{ req_id: "r1", id: "pw-1", ok: true, password: "p\\a\"s\ns" }
  match parse_password_reveal(encode_password_reveal(r)) {
    Some(b) => debug_assert(b.ok && b.password == "p\\a\"s\ns", "reveal escapes")
    None => debug_assert(false, "reveal parses")
  }
}

test "passwords wire: JSON values, list search and origin host" {
  match pw_json_parse(" {\"a\":[1,true,null,\"x\"],\"b\":{\"c\":-2.5}} ") {
    Some(v) => {
      debug_assert(v.items("a").length() == 4, "array")
      debug_assert(
        match v.get("b").get("c") {
          PwJson::Num(d) => d == -2.5
          _ => false
        },
        "nested number",
      )
    }
    None => debug_assert(false, "parses")
  }
  debug_assert(pw_json_parse("{\"a\":1} x").is_none(), "trailing garbage")
  debug_assert(pw_json_parse("{\"a\":").is_none(), "truncated")
  let items = [
    PasswordItemSummary::{ id: "1", origin: "https://github.com", signon_realm: "", username: "octo", display_name: "", created_at: 0L, updated_at: 0L, last_used_at: 0L, times_used: 0 },
    PasswordItemSummary::{ id: "2", origin: "https://example.com", signon_realm: "", username: "Ada", display_name: "Work", created_at: 0L, updated_at: 0L, last_used_at: 0L, times_used: 0 },
  ]
  debug_assert(password_list_filter(items, "").length() == 2, "empty keeps all")
  debug_assert(password_list_filter(items, "ADA").length() == 1, "case-insensitive username")
  debug_assert(password_list_filter(items, "github")[0].id == "1", "origin")
  debug_assert(password_list_filter(items, "zzz").length() == 0, "no match")
  debug_assert(password_origin_host("https://accounts.example.com:8443/x") == "accounts.example.com", "host")
}

test "passwords wire: import / export results round-trip and read as a toast" {
  let r = PasswordIoResult::{ ok: true, kind: "export", path: "/tmp/x.csv", count: 2, error: "" }
  match parse_password_io(encode_password_io(r)) {
    Some(b) => debug_assert(b.ok && b.kind == "export" && b.count == 2 && b.path == "/tmp/x.csv", "io")
    None => debug_assert(false, "io parses")
  }
  debug_assert(password_io_message(r) == "Exported 2 passwords", "export toast")
  debug_assert(password_io_message(PasswordIoResult::{ ..r, kind: "import", count: 1 }) == "Imported 1 password", "import toast")
  debug_assert(password_io_message(PasswordIoResult::{ ..r, kind: "import", count: 0 }) == "Passwords already up to date", "nothing new")
  debug_assert(password_io_message(PasswordIoResult::{ ..r, ok: false, error: "No passwords CSV found" }) == "No passwords CSV found", "error")
}
