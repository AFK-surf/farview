///| Pure-Pion portable Site Cookie & Storage Inspector model (`wire::Message::SiteCookiesState`, tag 65),
///| UTF-8 safe value masking/preview, JSON codec with malformed/truncated resilience, and upgraded
///| Downloads Manager category classification & UTF-8 safe filtering shared by `pion-app` and `pion-host`.

pub struct SiteCookieRow {
  pub name : String
  pub domain : String
  pub path : String
  pub value_preview : String
  pub secure : Bool
  pub http_only : Bool
  pub same_site : String
  pub partitioned : Bool
  pub expires_label : String
  pub is_session : Bool
}

pub struct SiteCookiesSnapshot {
  pub host : String
  pub origin : String
  pub space_id : String
  pub cookies : Array[SiteCookieRow]
}

pub fn SiteCookiesSnapshot::empty() -> SiteCookiesSnapshot {
  SiteCookiesSnapshot::{ host: "", origin: "", space_id: "default", cookies: [] }
}

pub fn normalize_cookie_same_site(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "strict" {
    "Strict"
  } else if s == "none" {
    "None"
  } else {
    "Lax"
  }
}

///| UTF-8 safe cookie value redaction & preview formatter.
///| Never slices mid-UTF-8 codepoint and never exposes full sensitive session tokens.
pub fn mask_cookie_value_preview(raw : String) -> String {
  let trimmed = raw.trim()
  let b = trimmed.to_bytes()
  let n = b.length()
  if n == 0 {
    return "(empty)"
  }
  if n <= 6 {
    return "••••"
  }
  // Collect safe leading ASCII bytes (up to 4) and trailing ASCII bytes (up to 4)
  let mut lead = 0
  while lead < n && lead < 4 {
    let c = b[lead].to_int() & 0xFF
    if c >= 0x21 && c <= 0x7E {
      lead = lead + 1
    } else {
      break
    }
  }
  let mut trail_start = n
  let mut trail = 0
  while trail_start > lead && trail < 4 {
    let c = b[trail_start - 1].to_int() & 0xFF
    if c >= 0x21 && c <= 0x7E {
      trail_start = trail_start - 1
      trail = trail + 1
    } else {
      break
    }
  }
  if lead >= 2 && trail >= 2 && lead + trail < n {
    let pre = b.slice(0, lead).to_string()
    let suf = b.slice(trail_start, n).to_string()
    pre + "••••" + suf + " (" + n.to_string() + " B)"
  } else {
    "•••• (" + n.to_string() + " B)"
  }
}

///| Formats a Unix epoch expiration timestamp (in seconds) relative to `now_secs` into a compact UI label.
pub fn format_cookie_expires_label(expires_opt : Option[Int64], now_secs : Int64) -> (String, Bool) {
  match expires_opt {
    None => ("Session", true)
    Some(ts) => {
      if ts <= 0L {
        return ("Session", true)
      }
      let diff = ts - now_secs
      if diff <= 0L {
        return ("Expired", false)
      }
      let days = diff / 86400L
      if days >= 365L {
        let yrs = days / 365L
        (yrs.to_string() + "y", false)
      } else if days >= 1L {
        (days.to_string() + "d", false)
      } else {
        let hrs = diff / 3600L
        if hrs >= 1L {
          (hrs.to_string() + "h", false)
        } else {
          let mins = (diff + 59L) / 60L
          (mins.to_string() + "m", false)
        }
      }
    }
  }
}

///| UTF-8 safe filter for `SiteCookieRow` using `omni_ascii_lower`.
///| Matches cookie name, domain, path, SameSite policy, and attribute keywords (`secure`, `httponly`, `chips`, `session`).
pub fn filter_site_cookies(rows : Array[SiteCookieRow], raw_query : String) -> Array[SiteCookieRow] {
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    return rows
  }
  let out : Array[SiteCookieRow] = []
  let mut i = 0
  while i < rows.length() {
    let r = rows[i]
    let matched = omni_ascii_lower(r.name).contains(q) ||
    omni_ascii_lower(r.domain).contains(q) ||
    omni_ascii_lower(r.path).contains(q) ||
    omni_ascii_lower(r.same_site).contains(q) ||
    omni_ascii_lower(r.expires_label).contains(q) ||
    (r.secure && "secure".contains(q)) ||
    (r.http_only && "httponly".contains(q)) ||
    (r.partitioned && ("chips".contains(q) || "partitioned".contains(q))) ||
    (r.is_session && "session".contains(q))
    if matched {
      out.push(r)
    }
    i = i + 1
  }
  out
}

pub fn encode_site_cookies_state(snap : SiteCookiesSnapshot) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < snap.cookies.length() {
    let c = snap.cookies[i]
    let ss = normalize_cookie_same_site(c.same_site)
    let exp_lbl = if c.expires_label.trim() != "" {
      c.expires_label
    } else if c.is_session {
      "Session"
    } else {
      "Persistent"
    }
    parts.push(
      "{\"name\":" +
      omni_json_escape(c.name) +
      ",\"domain\":" +
      omni_json_escape(c.domain) +
      ",\"path\":" +
      omni_json_escape(if c.path != "" { c.path } else { "/" }) +
      ",\"valuePreview\":" +
      omni_json_escape(c.value_preview) +
      ",\"secure\":" +
      (if c.secure { "true" } else { "false" }) +
      ",\"httpOnly\":" +
      (if c.http_only { "true" } else { "false" }) +
      ",\"sameSite\":" +
      omni_json_escape(ss) +
      ",\"partitioned\":" +
      (if c.partitioned { "true" } else { "false" }) +
      ",\"expiresLabel\":" +
      omni_json_escape(exp_lbl) +
      ",\"isSession\":" +
      (if c.is_session { "true" } else { "false" }) +
      "}",
    )
    i = i + 1
  }
  "{\"host\":" +
  omni_json_escape(snap.host) +
  ",\"origin\":" +
  omni_json_escape(snap.origin) +
  ",\"spaceId\":" +
  omni_json_escape(snap.space_id) +
  ",\"cookies\":[" +
  parts.join(",") +
  "]}"
}

fn ck_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

fn ck_parse_row(p : OmniJsonParser) -> Option[SiteCookieRow] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut name = ""
  let mut domain = ""
  let mut path = "/"
  let mut value_preview = ""
  let mut secure = false
  let mut http_only = false
  let mut same_site = "Lax"
  let mut partitioned = false
  let mut expires_label = "Session"
  let mut is_session = true
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SiteCookieRow::{
      name,
      domain,
      path,
      value_preview,
      secure,
      http_only,
      same_site,
      partitioned,
      expires_label,
      is_session,
    })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "domain" {
      match p.parse_str() {
        Some(v) => domain = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "path" {
      match p.parse_str() {
        Some(v) => path = if v != "" { v } else { "/" }
        None => if !p.skip_value() { return None }
      }
    } else if key == "valuePreview" || key == "value_preview" {
      match p.parse_str() {
        Some(v) => value_preview = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "secure" {
      match ck_parse_bool(p) {
        Some(v) => secure = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "httpOnly" || key == "http_only" {
      match ck_parse_bool(p) {
        Some(v) => http_only = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "sameSite" || key == "same_site" {
      match p.parse_str() {
        Some(v) => same_site = normalize_cookie_same_site(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "partitioned" {
      match ck_parse_bool(p) {
        Some(v) => partitioned = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "expiresLabel" || key == "expires_label" {
      match p.parse_str() {
        Some(v) => expires_label = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "isSession" || key == "is_session" {
      match ck_parse_bool(p) {
        Some(v) => is_session = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SiteCookieRow::{
        name,
        domain,
        path,
        value_preview,
        secure,
        http_only,
        same_site,
        partitioned,
        expires_label,
        is_session,
      })
    } else {
      return None
    }
  }
  None
}

///| Parses a `SiteCookiesSnapshot` JSON payload from `wire::Message::SiteCookiesState` (tag 65).
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_site_cookies_state(
  json : String,
  max_items~ : Int = 256,
) -> Option[SiteCookiesSnapshot] {
  let limit = if max_items > 0 { max_items } else { 256 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut host = ""
  let mut origin = ""
  let mut space_id = "default"
  let cookies : Array[SiteCookieRow] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SiteCookiesSnapshot::{ host, origin, space_id, cookies })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "host" {
      match p.parse_str() {
        Some(v) => host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "origin" {
      match p.parse_str() {
        Some(v) => origin = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "spaceId" || key == "space_id" {
      match p.parse_str() {
        Some(v) => space_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "cookies" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_done = false
        while p.i < p.n && !arr_done {
          match ck_parse_row(p) {
            Some(row) => if row.name != "" && cookies.length() < limit { cookies.push(row) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_done = true
          } else {
            return None
          }
        }
        if !arr_done {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SiteCookiesSnapshot::{ host, origin, space_id, cookies })
    } else {
      return None
    }
  }
  None
}

///| Classifies a `DownloadSummary` into `"pdf"`, `"images"`, or `"other"`.
pub fn download_category(d : DownloadSummary) -> String {
  let ext = download_ext_badge(d.filename)
  let mime = omni_ascii_lower(d.mime.trim())
  if ext == "PDF" || mime == "application/pdf" {
    "pdf"
  } else if ext == "PNG" ||
  ext == "JPG" ||
  ext == "JPEG" ||
  ext == "WEBP" ||
  ext == "GIF" ||
  ext == "SVG" ||
  ext == "AVIF" ||
  ext == "HEIC" ||
  mime.starts_with("image/") {
    "images"
  } else {
    "other"
  }
}

///| Normalizes a downloads category filter token into `"all"`, `"pdf"`, `"images"`, or `"other"`.
pub fn normalize_download_category(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "pdf" {
    "pdf"
  } else if s == "images" || s == "image" {
    "images"
  } else if s == "other" {
    "other"
  } else {
    "all"
  }
}

///| UTF-8 safe filter for `DownloadSummary` by search query (filename, host, URL, MIME) and category capsule.
pub fn filter_downloads(
  items : Array[DownloadSummary],
  raw_query : String,
  raw_category : String,
) -> Array[DownloadSummary] {
  let q = omni_ascii_lower(raw_query.trim())
  let cat = normalize_download_category(raw_category)
  let out : Array[DownloadSummary] = []
  let mut i = 0
  while i < items.length() {
    let d = items[i]
    let cat_ok = cat == "all" || download_category(d) == cat
    let q_ok = if q == "" {
      true
    } else {
      omni_ascii_lower(d.filename).contains(q) ||
      omni_ascii_lower(d.url).contains(q) ||
      omni_ascii_lower(omnibox_display_host(d.url)).contains(q) ||
      omni_ascii_lower(d.mime).contains(q)
    }
    if cat_ok && q_ok {
      out.push(d)
    }
    i = i + 1
  }
  out
}

///| Returns a user-facing local path for `Copy Path` / `Reveal` actions in the Downloads drawer.
pub fn download_copy_path(d : DownloadSummary) -> String {
  let name = d.filename.trim()
  if name == "" {
    return d.url
  }
  if name.starts_with("/") || name.starts_with("~/") {
    name
  } else {
    "~/Downloads/" + name
  }
}
