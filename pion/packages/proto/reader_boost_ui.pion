///| Pure-Pion portable models for Arc Reader Mode (`ReaderArticle`, `ReaderBlock`)
///| and per-domain Arc Boosts (`SiteBoost`, `BoostsSnapshot`), compact JSON codecs
///| with malformed/truncated resilience, and deterministic CSS generator with strict
///| `</style>` escape sanitization.

pub let READER_MAX_BLOCKS : Int = 256
pub let BOOST_SCALE_MIN : Int = 90
pub let BOOST_SCALE_MAX : Int = 130
pub let BOOST_SCALE_DEFAULT : Int = 100
pub let BOOST_CUSTOM_CSS_MAX : Int = 4096
///| Custom JS a person writes for a site is capped at 16 KiB.
pub let BOOST_CUSTOM_JS_MAX : Int = 16384
///| At most 64 zapped selectors per site, each at most 240 characters.
pub let BOOST_ZAP_MAX : Int = 64
pub let BOOST_ZAP_SELECTOR_MAX : Int = 240
///| Tint intensity (0..100, default 40), brightness and contrast (50..150, default 100).
pub let BOOST_TINT_DEFAULT : Int = 40
pub let BOOST_ADJUST_MIN : Int = 50
pub let BOOST_ADJUST_MAX : Int = 150
pub let BOOST_ADJUST_DEFAULT : Int = 100

pub enum ReaderBlockKind {
  Heading
  Paragraph
  Quote
  Code
  ListItem
}

pub struct ReaderBlock {
  pub kind : ReaderBlockKind
  pub level : Int
  pub text : String
}

pub struct ReaderArticle {
  pub url : String
  pub host : String
  pub title : String
  pub byline : String
  pub read_minutes : Int
  pub word_count : Int
  pub blocks : Array[ReaderBlock]
}

pub fn ReaderArticle::empty() -> ReaderArticle {
  ReaderArticle::{
    url: "",
    host: "",
    title: "",
    byline: "",
    read_minutes: 0,
    word_count: 0,
    blocks: [],
  }
}

pub fn reader_block_kind_str(kind : ReaderBlockKind) -> String {
  match kind {
    ReaderBlockKind::Heading => "heading"
    ReaderBlockKind::Paragraph => "paragraph"
    ReaderBlockKind::Quote => "quote"
    ReaderBlockKind::Code => "code"
    ReaderBlockKind::ListItem => "list_item"
  }
}

pub fn parse_reader_block_kind(raw : String) -> ReaderBlockKind {
  let s = omni_ascii_lower(raw.trim())
  if s == "heading" || s == "h" {
    ReaderBlockKind::Heading
  } else if s == "quote" || s == "blockquote" {
    ReaderBlockKind::Quote
  } else if s == "code" || s == "pre" {
    ReaderBlockKind::Code
  } else if s == "list_item" || s == "li" || s == "list" {
    ReaderBlockKind::ListItem
  } else {
    ReaderBlockKind::Paragraph
  }
}

pub fn encode_reader_article(art : ReaderArticle) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < art.blocks.length() {
    let blk = art.blocks[i]
    let lv = if blk.level < 0 { 0 } else if blk.level > 6 { 6 } else { blk.level }
    parts.push(
      "{\"kind\":" +
      omni_json_escape(reader_block_kind_str(blk.kind)) +
      ",\"level\":" +
      lv.to_string() +
      ",\"text\":" +
      omni_json_escape(blk.text) +
      "}",
    )
    i = i + 1
  }
  let mins = if art.read_minutes < 0 { 0 } else { art.read_minutes }
  let words = if art.word_count < 0 { 0 } else { art.word_count }
  "{\"url\":" +
  omni_json_escape(art.url) +
  ",\"host\":" +
  omni_json_escape(art.host) +
  ",\"title\":" +
  omni_json_escape(art.title) +
  ",\"byline\":" +
  omni_json_escape(art.byline) +
  ",\"readMinutes\":" +
  mins.to_string() +
  ",\"wordCount\":" +
  words.to_string() +
  ",\"blocks\":[" +
  parts.join(",") +
  "]}"
}

///| Wraps a `ReaderArticle` JSON string with an attribution `reqId` envelope so the
///| client can drop stale same-URL reload or late empty-article responses.
pub fn encode_reader_article_envelope(req_id : String, article_json : String) -> String {
  "{\"reqId\":" + omni_json_escape(req_id) + ",\"article\":" + article_json + "}"
}

///| Parses either a request-attributed envelope `{"reqId":"...","article":{...}}`
///| or a legacy bare `ReaderArticle` JSON object.
///| Returns `(Some(req_id), Some(art))` for envelopes, `(None, Some(art))` for legacy
///| bare articles, and `(None, None)` for malformed/truncated JSON.
pub fn parse_reader_article_envelope(
  json : String,
  max_blocks~ : Int = READER_MAX_BLOCKS,
) -> (Option[String], Option[ReaderArticle]) {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return (None, None)
  }
  p.i = p.i + 1
  let mut req_id : Option[String] = None
  let mut article_slice : Option[String] = None
  let mut has_envelope_key = false
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    return (None, parse_reader_article(json, max_blocks=max_blocks))
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return (None, None)
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return (None, None)
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "reqId" || key == "req_id" {
      has_envelope_key = true
      match p.parse_str() {
        Some(v) => req_id = Some(v)
        None => if !p.skip_value() { return (None, None) }
      }
    } else if key == "article" {
      has_envelope_key = true
      let val_start = p.i
      if !p.skip_value() {
        return (None, None)
      }
      article_slice = Some(json.slice(val_start, p.i))
    } else if !p.skip_value() {
      return (None, None)
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      if has_envelope_key {
        match article_slice {
          Some(slice) => return (req_id, parse_reader_article(slice, max_blocks=max_blocks))
          None => return (req_id, None)
        }
      }
      return (None, parse_reader_article(json, max_blocks=max_blocks))
    } else {
      return (None, None)
    }
  }
  (None, None)
}

fn rb_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

fn rb_parse_reader_block(p : OmniJsonParser) -> Option[ReaderBlock] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut kind = ReaderBlockKind::Paragraph
  let mut level = 0
  let mut text = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(ReaderBlock::{ kind, level, text })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "kind" || key == "k" {
      match p.parse_str() {
        Some(v) => kind = parse_reader_block_kind(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "level" || key == "lv" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          level = if iv < 0 { 0 } else if iv > 6 { 6 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "text" || key == "t" {
      match p.parse_str() {
        Some(v) => text = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(ReaderBlock::{ kind, level, text })
    } else {
      return None
    }
  }
  None
}

///| Parses a `ReaderArticle` JSON payload from `wire::Message::ReaderState`.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_reader_article(
  json : String,
  max_blocks~ : Int = READER_MAX_BLOCKS,
) -> Option[ReaderArticle] {
  let limit = if max_blocks > 0 { max_blocks } else { READER_MAX_BLOCKS }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut url = ""
  let mut host = ""
  let mut title = ""
  let mut byline = ""
  let mut read_minutes = 0
  let mut word_count = 0
  let blocks : Array[ReaderBlock] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(ReaderArticle::{ url, host, title, byline, read_minutes, word_count, blocks })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "host" {
      match p.parse_str() {
        Some(v) => host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "byline" {
      match p.parse_str() {
        Some(v) => byline = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "readMinutes" || key == "read_minutes" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          read_minutes = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "wordCount" || key == "word_count" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          word_count = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "blocks" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match rb_parse_reader_block(p) {
            Some(blk) => if blk.text != "" && blocks.length() < limit { blocks.push(blk) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      let eff_host = if host != "" { host } else { normalize_boost_host(url) }
      return Some(ReaderArticle::{
        url,
        host: eff_host,
        title,
        byline,
        read_minutes,
        word_count,
        blocks,
      })
    } else {
      return None
    }
  }
  None
}

pub struct SiteBoost {
  pub host : String
  pub enabled : Bool
  pub theme : String
  pub font : String
  pub scale_pct : Int
  pub hide_sticky : Bool
  pub custom_css : String
  ///| Tint color as `#rrggbb` (`""` for none) and how strongly it colors the page (0..100).
  pub tint : String
  pub tint_pct : Int
  ///| Brightness and contrast of the whole page, in percent (100 leaves it as it is).
  pub brightness_pct : Int
  pub contrast_pct : Int
  ///| Inverts the page's colors (pictures and video keep theirs).
  pub invert : Bool
  ///| CSS selectors of elements the person zapped (hidden on every visit).
  pub zapped : Array[String]
  ///| The person's own script for the site, run in the page on each load.
  pub custom_js : String
}

pub struct BoostsSnapshot {
  pub items : Array[SiteBoost]
}

pub fn BoostsSnapshot::empty() -> BoostsSnapshot {
  BoostsSnapshot::{ items: [] }
}

///| Normalizes a URL or raw hostname into a canonical lowercase Boost domain key
///| (strips scheme, path/query/hash, port, and leading `www.`).
pub fn normalize_boost_host(raw : String) -> String {
  let trimmed = raw.trim()
  if trimmed == "" {
    return ""
  }
  let mut s = omni_ascii_lower(trimmed)
  if s.starts_with("about:") || s.starts_with("data:") {
    return ""
  }
  if s.starts_with("file://") {
    return "local-file"
  }
  if s.starts_with("https://") {
    s = s.slice(8, s.length())
  } else if s.starts_with("http://") {
    s = s.slice(7, s.length())
  }
  let mut end_idx = s.length()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      end_idx = i
      break
    }
    i = i + 1
  }
  s = s.slice(0, end_idx)
  // Strip userinfo if any
  let mut at_idx = -1
  let mut j = 0
  while j < s.length() {
    if s.code_unit_at(j).to_int() == 0x40 {
      at_idx = j
    }
    j = j + 1
  }
  if at_idx >= 0 && at_idx + 1 < s.length() {
    s = s.slice(at_idx + 1, s.length())
  }
  // Strip port (unless IPv6 bracketed without trailing port)
  if !s.starts_with("[") {
    let mut colon_idx = -1
    let mut k = 0
    while k < s.length() {
      if s.code_unit_at(k).to_int() == 0x3A {
        colon_idx = k
        break
      }
      k = k + 1
    }
    if colon_idx > 0 {
      s = s.slice(0, colon_idx)
    }
  }
  s
}

pub fn normalize_boost_theme(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "dark" || s == "sepia" || s == "contrast" {
    s
  } else {
    "auto"
  }
}

pub fn normalize_boost_font(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "sans" || s == "serif" || s == "mono" {
    s
  } else {
    "default"
  }
}

pub fn clamp_boost_scale_pct(pct : Int) -> Int {
  if pct < BOOST_SCALE_MIN {
    BOOST_SCALE_MIN
  } else if pct > BOOST_SCALE_MAX {
    BOOST_SCALE_MAX
  } else {
    pct
  }
}

pub fn SiteBoost::default_for(host_or_url : String) -> SiteBoost {
  SiteBoost::{
    host: normalize_boost_host(host_or_url),
    enabled: false,
    theme: "auto",
    font: "default",
    scale_pct: BOOST_SCALE_DEFAULT,
    hide_sticky: false,
    custom_css: "",
    tint: "",
    tint_pct: BOOST_TINT_DEFAULT,
    brightness_pct: BOOST_ADJUST_DEFAULT,
    contrast_pct: BOOST_ADJUST_DEFAULT,
    invert: false,
    zapped: [],
    custom_js: "",
  }
}

///| Returns the bare domain for a `www.` host (for v1 legacy fallback), or `""`.
pub fn boost_legacy_bare_host(host_or_url : String) -> String {
  let h = normalize_boost_host(host_or_url)
  if h.starts_with("www.") && h.length() > 4 {
    h.slice(4, h.length())
  } else {
    ""
  }
}

pub fn boosts_find(snap : BoostsSnapshot, host_or_url : String) -> Option[SiteBoost] {
  let h = normalize_boost_host(host_or_url)
  if h == "" {
    return None
  }
  let mut i = 0
  while i < snap.items.length() {
    if normalize_boost_host(snap.items[i].host) == h {
      return Some(snap.items[i])
    }
    i = i + 1
  }
  None
}

///| Looks up a SiteBoost by exact normalized host, falling back to a v1 legacy bare
///| domain entry ONLY when that bare host is listed in `legacy_bare`.
pub fn boosts_find_with_legacy(
  snap : BoostsSnapshot,
  legacy_bare : Array[String],
  host_or_url : String,
) -> Option[SiteBoost] {
  match boosts_find(snap, host_or_url) {
    Some(b) => Some(b)
    None => {
      let bare = boost_legacy_bare_host(host_or_url)
      if bare == "" {
        return None
      }
      let mut i = 0
      while i < legacy_bare.length() {
        if normalize_boost_host(legacy_bare[i]) == bare {
          return boosts_find(snap, bare)
        }
        i = i + 1
      }
      None
    }
  }
}

pub fn boosts_is_active(snap : BoostsSnapshot, host_or_url : String) -> Bool {
  match boosts_find(snap, host_or_url) {
    Some(b) => b.enabled
    None => false
  }
}

pub fn encode_site_boost(b : SiteBoost) -> String {
  let h = normalize_boost_host(b.host)
  let theme = normalize_boost_theme(b.theme)
  let font = normalize_boost_font(b.font)
  let scale = clamp_boost_scale_pct(b.scale_pct)
  let css = sanitize_boost_custom_css(b.custom_css)
  let zap_parts : Array[String] = []
  let zapped = normalize_boost_zapped(b.zapped)
  let mut zi = 0
  while zi < zapped.length() {
    zap_parts.push(omni_json_escape(zapped[zi]))
    zi = zi + 1
  }
  "{\"host\":" +
  omni_json_escape(h) +
  ",\"enabled\":" +
  (if b.enabled { "true" } else { "false" }) +
  ",\"theme\":" +
  omni_json_escape(theme) +
  ",\"font\":" +
  omni_json_escape(font) +
  ",\"scalePct\":" +
  scale.to_string() +
  ",\"hideSticky\":" +
  (if b.hide_sticky { "true" } else { "false" }) +
  ",\"customCss\":" +
  omni_json_escape(css) +
  ",\"tint\":" +
  omni_json_escape(normalize_boost_tint(b.tint)) +
  ",\"tintPct\":" +
  clamp_boost_tint_pct(b.tint_pct).to_string() +
  ",\"brightness\":" +
  clamp_boost_adjust_pct(b.brightness_pct).to_string() +
  ",\"contrast\":" +
  clamp_boost_adjust_pct(b.contrast_pct).to_string() +
  ",\"invert\":" +
  (if b.invert { "true" } else { "false" }) +
  ",\"zapped\":[" +
  zap_parts.join(",") +
  "],\"customJs\":" +
  omni_json_escape(sanitize_boost_custom_js(b.custom_js)) +
  "}"
}

pub fn encode_boosts_snapshot(
  snap : BoostsSnapshot,
  legacy_bare~ : Array[String] = [],
) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < snap.items.length() {
    let b = snap.items[i]
    if normalize_boost_host(b.host) != "" {
      parts.push(encode_site_boost(b))
    }
    i = i + 1
  }
  let lb_parts : Array[String] = []
  let mut j = 0
  while j < legacy_bare.length() {
    let lh = normalize_boost_host(legacy_bare[j])
    if lh != "" && !lh.starts_with("www.") {
      lb_parts.push(omni_json_escape(lh))
    }
    j = j + 1
  }
  if lb_parts.length() > 0 {
    "{\"version\":2,\"items\":[" + parts.join(",") + "],\"legacyBare\":[" + lb_parts.join(",") + "]}"
  } else {
    "{\"version\":2,\"items\":[" + parts.join(",") + "]}"
  }
}

fn rb_parse_site_boost_obj(p : OmniJsonParser) -> Option[SiteBoost] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut host = ""
  let mut enabled = false
  let mut theme = "auto"
  let mut font = "default"
  let mut scale_pct = BOOST_SCALE_DEFAULT
  let mut hide_sticky = false
  let mut custom_css = ""
  let mut tint = ""
  let mut tint_pct = BOOST_TINT_DEFAULT
  let mut brightness_pct = BOOST_ADJUST_DEFAULT
  let mut contrast_pct = BOOST_ADJUST_DEFAULT
  let mut invert = false
  let zapped : Array[String] = []
  let mut custom_js = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SiteBoost::{
      host,
      enabled,
      theme,
      font,
      scale_pct,
      hide_sticky,
      custom_css,
      tint,
      tint_pct,
      brightness_pct,
      contrast_pct,
      invert,
      zapped,
      custom_js,
    })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "host" {
      match p.parse_str() {
        Some(v) => host = normalize_boost_host(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "enabled" {
      match rb_parse_bool(p) {
        Some(v) => enabled = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "theme" {
      match p.parse_str() {
        Some(v) => theme = normalize_boost_theme(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "font" {
      match p.parse_str() {
        Some(v) => font = normalize_boost_font(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "scalePct" || key == "scale_pct" {
      match p.parse_number() {
        Some(v) => scale_pct = clamp_boost_scale_pct(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "hideSticky" || key == "hide_sticky" {
      match rb_parse_bool(p) {
        Some(v) => hide_sticky = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "customCss" || key == "custom_css" {
      match p.parse_str() {
        Some(v) => custom_css = sanitize_boost_custom_css(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "tint" {
      match p.parse_str() {
        Some(v) => tint = normalize_boost_tint(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "tintPct" || key == "tint_pct" {
      match p.parse_number() {
        Some(v) => tint_pct = clamp_boost_tint_pct(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "brightness" || key == "brightness_pct" {
      match p.parse_number() {
        Some(v) => brightness_pct = clamp_boost_adjust_pct(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "contrast" || key == "contrast_pct" {
      match p.parse_number() {
        Some(v) => contrast_pct = clamp_boost_adjust_pct(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "invert" {
      match rb_parse_bool(p) {
        Some(v) => invert = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "customJs" || key == "custom_js" {
      match p.parse_str() {
        Some(v) => custom_js = sanitize_boost_custom_js(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "zapped" {
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5B {
        p.i = p.i + 1
        p.skip_ws()
        if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
          p.i = p.i + 1
        } else {
          let mut zap_ok = false
          while p.i < p.n {
            match p.parse_str() {
              Some(sel) => {
                let clean = sanitize_boost_selector(sel)
                if clean != "" && zapped.length() < BOOST_ZAP_MAX {
                  rb_push_unique_str(zapped, clean)
                }
              }
              None => if !p.skip_value() { return None }
            }
            p.skip_ws()
            if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
              p.i = p.i + 1
              p.skip_ws()
            } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
              p.i = p.i + 1
              zap_ok = true
              break
            } else {
              return None
            }
          }
          if !zap_ok {
            return None
          }
        }
      } else if !p.skip_value() {
        return None
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SiteBoost::{
        host,
        enabled,
        theme,
        font,
        scale_pct,
        hide_sticky,
        custom_css,
        tint,
        tint_pct,
        brightness_pct,
        contrast_pct,
        invert,
        zapped,
        custom_js,
      })
    } else {
      return None
    }
  }
  None
}

pub fn parse_site_boost(json : String) -> Option[SiteBoost] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  rb_parse_site_boost_obj(p)
}

fn rb_push_unique_str(arr : Array[String], s : String) -> Unit {
  if s == "" {
    return
  }
  let mut i = 0
  while i < arr.length() {
    if arr[i] == s {
      return
    }
    i = i + 1
  }
  arr.push(s)
}

///| Parses a `BoostsSnapshot` JSON payload along with its `legacyBare` host list.
///| Legacy v1 payloads (missing `version` or `version < 2`) automatically mark all
///| non-`www.` stored items as `legacyBare` so upgraded `www.` sites keep working.
pub fn parse_boosts_snapshot_with_legacy(
  json : String,
  max_items~ : Int = 128,
) -> Option[(BoostsSnapshot, Array[String])] {
  let limit = if max_items > 0 { max_items } else { 128 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let items : Array[SiteBoost] = []
  let explicit_legacy : Array[String] = []
  let mut has_version = false
  let mut version = 1
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some((BoostsSnapshot::{ items }, []))
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "version" {
      match p.parse_number() {
        Some(v) => {
          has_version = true
          version = math_floor(v + 0.5).to_int()
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "legacyBare" || key == "legacy_bare" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut lb_ok = false
        while p.i < p.n {
          match p.parse_str() {
            Some(s) => {
              let nh = normalize_boost_host(s)
              if nh != "" && !nh.starts_with("www.") {
                rb_push_unique_str(explicit_legacy, nh)
              }
            }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            lb_ok = true
            break
          } else {
            return None
          }
        }
        if !lb_ok {
          return None
        }
      }
    } else if key == "items" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match rb_parse_site_boost_obj(p) {
            Some(it) => if it.host != "" && items.length() < limit { items.push(it) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      let legacy_out : Array[String] = []
      if !has_version || version < 2 {
        let mut li = 0
        while li < items.length() {
          let ih = normalize_boost_host(items[li].host)
          if ih != "" && !ih.starts_with("www.") {
            rb_push_unique_str(legacy_out, ih)
          }
          li = li + 1
        }
      } else {
        let mut li = 0
        while li < explicit_legacy.length() {
          rb_push_unique_str(legacy_out, explicit_legacy[li])
          li = li + 1
        }
      }
      return Some((BoostsSnapshot::{ items }, legacy_out))
    } else {
      return None
    }
  }
  None
}

///| Parses a `BoostsSnapshot` JSON payload from `wire::Message::BoostsState` or disk.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_boosts_snapshot(
  json : String,
  max_items~ : Int = 128,
) -> Option[BoostsSnapshot] {
  match parse_boosts_snapshot_with_legacy(json, max_items=max_items) {
    Some((snap, _legacy)) => Some(snap)
    None => None
  }
}

///| Strictly sanitizes user custom CSS to prevent `</style>` / `<style` / `<script`
///| / HTML comment injection while preserving valid CSS selectors (including `>`).
pub fn sanitize_boost_custom_css(raw : String) -> String {
  let trimmed = raw.trim()
  if trimmed == "" {
    return ""
  }
  let capped = if trimmed.length() > BOOST_CUSTOM_CSS_MAX {
    trimmed.slice(0, BOOST_CUSTOM_CSS_MAX)
  } else {
    trimmed
  }
  // Pass 1: strip NUL bytes and disallowed `<` tag openers (valid CSS never needs `<`)
  let b = capped.to_bytes()
  let out : Array[Int] = []
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 0 || c == 0x3C {
      // Strip NUL and '<' completely: guarantees `</style>`, `<style>`, `<script>`, `<!--` can never form
      i = i + 1
    } else {
      out.push(c)
      i = i + 1
    }
  }
  if out.length() == 0 {
    return ""
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k].to_byte()
    k = k + 1
  }
  res.to_string().trim()
}

///| Deterministically generates the `<style id="__fv_arc_boost">` stylesheet
///| for a given `SiteBoost`. Returns `""` when disabled or all settings are default.
pub fn build_boost_css(boost : SiteBoost) -> String {
  if !boost.enabled {
    return ""
  }
  let rules : Array[String] = []
  let theme = normalize_boost_theme(boost.theme)
  if theme == "dark" {
    rules.push(
      "html, body { background-color: #12141A !important; color: #E5E7EB !important; }",
    )
    rules.push(
      "main, article, section, header, footer, aside, nav, div, table, tr, td, th, form, blockquote { background-color: #1A1E29 !important; color: #E5E7EB !important; border-color: #2E3444 !important; }",
    )
    rules.push(
      "h1, h2, h3, h4, h5, h6, p, li, span, label, strong, em, dt, dd { color: #E5E7EB !important; }",
    )
    rules.push("a, a * { color: #60A5FA !important; }")
    rules.push(
      "code, pre { background-color: #0D1017 !important; color: #93C5FD !important; border-color: #2E3444 !important; }",
    )
    rules.push(
      "input, textarea, select, button { background-color: #222736 !important; color: #F3F4F6 !important; border-color: #374151 !important; }",
    )
  } else if theme == "sepia" {
    rules.push(
      "html, body { background-color: #F6EFE2 !important; color: #3B2E20 !important; }",
    )
    rules.push(
      "main, article, section, header, footer, aside, nav, div, table, tr, td, th, blockquote { background-color: #F2E8D5 !important; color: #3B2E20 !important; border-color: #D9C9AE !important; }",
    )
    rules.push(
      "h1, h2, h3, h4, h5, h6, p, li, span, label, strong, em { color: #3B2E20 !important; }",
    )
    rules.push("a, a * { color: #8C4A1C !important; }")
    rules.push(
      "code, pre { background-color: #EADDC6 !important; color: #4A3520 !important; border-color: #D4C1A1 !important; }",
    )
  } else if theme == "contrast" {
    rules.push(
      "html, body { background-color: #000000 !important; color: #FFFFFF !important; }",
    )
    rules.push(
      "main, article, section, header, footer, aside, nav, div, table, tr, td, th, form, blockquote { background-color: #000000 !important; color: #FFFFFF !important; border-color: #FFFFFF !important; }",
    )
    rules.push(
      "h1, h2, h3, h4, h5, h6, p, li, span, label, strong, em { color: #FFFFFF !important; }",
    )
    rules.push("a, a * { color: #FFE600 !important; text-decoration: underline !important; }")
    rules.push(
      "code, pre { background-color: #111111 !important; color: #00FF88 !important; border: 1px solid #FFFFFF !important; }",
    )
    rules.push(
      "input, textarea, select, button { background-color: #000000 !important; color: #FFFFFF !important; border: 1.5px solid #FFFFFF !important; }",
    )
  }

  // Colors: a tint over the page's ground and its links, then brightness, contrast and invert as one filter.
  let tint = normalize_boost_tint(boost.tint)
  let tint_pct = clamp_boost_tint_pct(boost.tint_pct)
  if tint != "" && tint_pct > 0 {
    let dark_ground = theme == "dark" || theme == "contrast"
    let ground_base = if theme == "dark" {
      "#12141a"
    } else if theme == "contrast" {
      "#000000"
    } else if theme == "sepia" {
      "#f6efe2"
    } else {
      "#ffffff"
    }
    let ground = boost_mix_hex(ground_base, tint, tint_pct.to_double() / 100.0 * 0.45)
    let link = if dark_ground { boost_mix_hex(tint, "#ffffff", 0.35) } else { boost_mix_hex(tint, "#000000", 0.25) }
    rules.push("html, body { background-color: " + ground + " !important; }")
    rules.push("a, a * { color: " + link + " !important; }")
    rules.push("html { accent-color: " + tint + " !important; }")
    rules.push("::selection { background-color: " + boost_mix_hex(ground_base, tint, 0.4) + " !important; }")
  }
  let bright = clamp_boost_adjust_pct(boost.brightness_pct)
  let contrast = clamp_boost_adjust_pct(boost.contrast_pct)
  let filters : Array[String] = []
  if boost.invert {
    filters.push("invert(1) hue-rotate(180deg)")
  }
  if bright != BOOST_ADJUST_DEFAULT {
    filters.push("brightness(" + bright.to_string() + "%)")
  }
  if contrast != BOOST_ADJUST_DEFAULT {
    filters.push("contrast(" + contrast.to_string() + "%)")
  }
  if filters.length() > 0 {
    rules.push("html { filter: " + filters.join(" ") + " !important; }")
  }
  if boost.invert {
    // (a page without a ground of its own inverts to black, as on a white canvas)
    if tint == "" && theme == "auto" {
      rules.push("html { background-color: #ffffff !important; }")
    }
    rules.push("img, video, picture, canvas, iframe, embed, object { filter: invert(1) hue-rotate(180deg) !important; }")
  }

  let font = normalize_boost_font(boost.font)
  if font == "sans" {
    rules.push(
      "html, body, p, li, div, article, section, main, h1, h2, h3, h4, blockquote { font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", Arial, sans-serif !important; }",
    )
  } else if font == "serif" {
    rules.push(
      "html, body, p, li, div, article, section, main, h1, h2, h3, h4, blockquote { font-family: Georgia, \"New York\", \"Iowan Old Style\", \"Times New Roman\", serif !important; }",
    )
  } else if font == "mono" {
    rules.push(
      "html, body, p, li, div, article, section, main, h1, h2, h3, h4, blockquote, code, pre { font-family: ui-monospace, \"SF Mono\", Menlo, Monaco, Consolas, monospace !important; }",
    )
  }

  let scale = clamp_boost_scale_pct(boost.scale_pct)
  if scale != BOOST_SCALE_DEFAULT {
    rules.push("html { font-size: " + scale.to_string() + "% !important; }")
  }

  if boost.hide_sticky {
    rules.push(
      "[class*=\"cookie\" i], [id*=\"cookie\" i], [class*=\"consent\" i], [id*=\"consent\" i], [class*=\"newsletter\" i], [class*=\"popup\" i], [class*=\"sticky\" i], [class*=\"ad-slot\" i], [class*=\"promo\" i] { display: none !important; }",
    )
  }

  let zapped = normalize_boost_zapped(boost.zapped)
  let mut zi = 0
  while zi < zapped.length() {
    // (one rule per selector: a selector the engine cannot parse drops only its own rule)
    rules.push(zapped[zi] + " { display: none !important; }")
    zi = zi + 1
  }

  let clean_custom = sanitize_boost_custom_css(boost.custom_css)
  if clean_custom != "" {
    rules.push(clean_custom)
  }

  rules.join("\n")
}

///| Clamps a tint intensity to 0..100.
pub fn clamp_boost_tint_pct(pct : Int) -> Int {
  if pct < 0 { 0 } else if pct > 100 { 100 } else { pct }
}

///| Clamps a brightness or contrast adjustment to 50..150 percent.
pub fn clamp_boost_adjust_pct(pct : Int) -> Int {
  if pct < BOOST_ADJUST_MIN {
    BOOST_ADJUST_MIN
  } else if pct > BOOST_ADJUST_MAX {
    BOOST_ADJUST_MAX
  } else {
    pct
  }
}

fn rb_hex_digit(c : Int) -> Int {
  if c >= 0x30 && c <= 0x39 {
    c - 0x30
  } else if c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else if c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else {
    -1
  }
}

///| A tint color as lowercase `#rrggbb` (`#rgb` is expanded), or `""` when it is not one.
pub fn normalize_boost_tint(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if !s.starts_with("#") {
    return ""
  }
  let body = s.slice(1, s.length())
  let mut i = 0
  while i < body.length() {
    if rb_hex_digit(body.code_unit_at(i).to_int()) < 0 {
      return ""
    }
    i = i + 1
  }
  if body.length() == 6 {
    "#" + body
  } else if body.length() == 3 {
    let a = body.slice(0, 1)
    let b = body.slice(1, 2)
    let c = body.slice(2, 3)
    "#" + a + a + b + b + c + c
  } else {
    ""
  }
}

///| `#rrggbb` as (r, g, b) 0..255 (black for `""`).
pub fn boost_tint_rgb(hex : String) -> (Int, Int, Int) {
  let h = normalize_boost_tint(hex)
  if h == "" {
    return (0, 0, 0)
  }
  let ch = fn(at : Int) -> Int {
    rb_hex_digit(h.code_unit_at(at).to_int()) * 16 + rb_hex_digit(h.code_unit_at(at + 1).to_int())
  }
  (ch(1), ch(3), ch(5))
}

///| A tint color as opaque `0xRRGGBBAA` (for drawing its swatch).
pub fn boost_tint_rgba(hex : String) -> Int64 {
  let (r, g, b) = boost_tint_rgb(hex)
  (r.to_int64() << 24) | (g.to_int64() << 16) | (b.to_int64() << 8) | 0xFFL
}

fn rb_hex2(v : Int) -> String {
  let digits = "0123456789abcdef"
  let c = if v < 0 { 0 } else if v > 255 { 255 } else { v }
  digits.slice(c / 16, c / 16 + 1) + digits.slice(c % 16, c % 16 + 1)
}

fn rb_rgb_hex(r : Int, g : Int, b : Int) -> String {
  "#" + rb_hex2(r) + rb_hex2(g) + rb_hex2(b)
}

fn rb_dabs(v : Double) -> Double {
  if v < 0.0 { 0.0 - v } else { v }
}

///| Mixes two `#rrggbb` colors (`t = 0` gives `a`).
pub fn boost_mix_hex(a : String, b : String, t : Double) -> String {
  let (ar, ag, ab) = boost_tint_rgb(a)
  let (br, bg, bb) = boost_tint_rgb(b)
  let tt = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t }
  let m = fn(x : Int, y : Int) -> Int {
    math_floor(x.to_double() + (y.to_double() - x.to_double()) * tt + 0.5).to_int()
  }
  rb_rgb_hex(m(ar, br), m(ag, bg), m(ab, bb))
}

///| The tint of hue `deg` (0..360) the hue slider gives: saturated, mid lightness.
pub fn boost_hue_hex(deg : Int) -> String {
  let h0 = ((deg % 360) + 360) % 360
  let h = h0.to_double() / 60.0
  let s = 0.78
  let l = 0.52
  let c = (1.0 - rb_dabs(2.0 * l - 1.0)) * s
  let hm = h - 2.0 * math_floor(h / 2.0)
  let x = c * (1.0 - rb_dabs(hm - 1.0))
  let (r1, g1, b1) = if h < 1.0 {
    (c, x, 0.0)
  } else if h < 2.0 {
    (x, c, 0.0)
  } else if h < 3.0 {
    (0.0, c, x)
  } else if h < 4.0 {
    (0.0, x, c)
  } else if h < 5.0 {
    (x, 0.0, c)
  } else {
    (c, 0.0, x)
  }
  let m = l - c / 2.0
  let to8 = fn(v : Double) -> Int { math_floor((v + m) * 255.0 + 0.5).to_int() }
  rb_rgb_hex(to8(r1), to8(g1), to8(b1))
}

///| The hue (0..359) of a `#rrggbb` tint (0 for gray or none).
pub fn boost_tint_hue(hex : String) -> Int {
  let (ri, gi, bi) = boost_tint_rgb(hex)
  let r = ri.to_double() / 255.0
  let g = gi.to_double() / 255.0
  let b = bi.to_double() / 255.0
  let mx = if r > g { if r > b { r } else { b } } else if g > b { g } else { b }
  let mn = if r < g { if r < b { r } else { b } } else if g < b { g } else { b }
  let d = mx - mn
  if d <= 0.0 {
    return 0
  }
  let h = if mx == r {
    let q = (g - b) / d
    q - 6.0 * math_floor(q / 6.0)
  } else if mx == g {
    (b - r) / d + 2.0
  } else {
    (r - g) / d + 4.0
  }
  let deg = math_floor(h * 60.0 + 0.5).to_int()
  ((deg % 360) + 360) % 360
}

///| The tint swatches the Colors section offers (name, `#rrggbb`), the system palette.
pub fn boost_tint_palette() -> Array[(String, String)] {
  [
    ("Red", "#ff3b30"),
    ("Orange", "#ff9500"),
    ("Yellow", "#ffcc00"),
    ("Green", "#34c759"),
    ("Teal", "#30b0c7"),
    ("Blue", "#007aff"),
    ("Indigo", "#5856d6"),
    ("Purple", "#af52de"),
    ("Pink", "#ff2d55"),
  ]
}

///| A zapped element's CSS selector made safe to put in a stylesheet: one selector list, no rule or block
///| characters (`{`, `}`, `;`, `<`), no control characters, at most `BOOST_ZAP_SELECTOR_MAX` long; `""` when none
///| is left.
pub fn sanitize_boost_selector(raw : String) -> String {
  let t = raw.trim()
  if t == "" || t.length() > BOOST_ZAP_SELECTOR_MAX {
    return ""
  }
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i).to_int()
    if c < 0x20 || c == 0x7B || c == 0x7D || c == 0x3B || c == 0x3C || c == 0x7F {
      return ""
    }
    i = i + 1
  }
  // (a comment opener could swallow the rules after it)
  if t.contains("/*") || t.contains("*/") {
    return ""
  }
  t
}

///| Zapped selectors cleaned, without duplicates, at most `BOOST_ZAP_MAX`.
pub fn normalize_boost_zapped(list : Array[String]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < list.length() && out.length() < BOOST_ZAP_MAX {
    rb_push_unique_str(out, sanitize_boost_selector(list[i]))
    i = i + 1
  }
  out
}

///| The boost with `selector` zapped (and on); unchanged when the selector is unsafe.
pub fn boost_zap_add(b : SiteBoost, selector : String) -> SiteBoost {
  let clean = sanitize_boost_selector(selector)
  if clean == "" {
    return b
  }
  let next = normalize_boost_zapped(b.zapped)
  if next.length() < BOOST_ZAP_MAX {
    rb_push_unique_str(next, clean)
  }
  SiteBoost::{ ..b, enabled: true, zapped: next }
}

///| The boost with `selector` restored (shown again).
pub fn boost_zap_remove(b : SiteBoost, selector : String) -> SiteBoost {
  let target = selector.trim()
  let next : Array[String] = []
  let mut i = 0
  while i < b.zapped.length() {
    if b.zapped[i].trim() != target {
      next.push(b.zapped[i])
    }
    i = i + 1
  }
  SiteBoost::{ ..b, zapped: next }
}

///| The person's script for a site, capped at `BOOST_CUSTOM_JS_MAX`, NUL characters removed.
pub fn sanitize_boost_custom_js(raw : String) -> String {
  let trimmed = raw.trim()
  if trimmed == "" {
    return ""
  }
  let capped = if trimmed.length() > BOOST_CUSTOM_JS_MAX {
    trimmed.slice(0, BOOST_CUSTOM_JS_MAX)
  } else {
    trimmed
  }
  let mut has_nul = false
  let mut i = 0
  while i < capped.length() {
    if capped.code_unit_at(i).to_int() == 0 {
      has_nul = true
      break
    }
    i = i + 1
  }
  if !has_nul {
    return capped
  }
  let parts : Array[String] = []
  let mut from = 0
  let mut j = 0
  while j < capped.length() {
    if capped.code_unit_at(j).to_int() == 0 {
      parts.push(capped.slice(from, j))
      from = j + 1
    }
    j = j + 1
  }
  parts.push(capped.slice(from, capped.length()))
  parts.join("")
}

///| Whether anything of the boost differs from a fresh one.
pub fn boost_has_changes(b : SiteBoost) -> Bool {
  normalize_boost_theme(b.theme) != "auto" ||
  normalize_boost_font(b.font) != "default" ||
  clamp_boost_scale_pct(b.scale_pct) != BOOST_SCALE_DEFAULT ||
  b.hide_sticky ||
  sanitize_boost_custom_css(b.custom_css) != "" ||
  normalize_boost_tint(b.tint) != "" ||
  clamp_boost_adjust_pct(b.brightness_pct) != BOOST_ADJUST_DEFAULT ||
  clamp_boost_adjust_pct(b.contrast_pct) != BOOST_ADJUST_DEFAULT ||
  b.invert ||
  normalize_boost_zapped(b.zapped).length() > 0 ||
  sanitize_boost_custom_js(b.custom_js) != ""
}

///| The script the host runs in a boosted page once it has loaded: the person's own code for that site, in a
///| function of its own so its declarations stay local and its errors are caught; `""` when there is none or the
///| boost is off.
pub fn build_boost_js(boost : SiteBoost) -> String {
  if !boost.enabled {
    return ""
  }
  let js = sanitize_boost_custom_js(boost.custom_js)
  if js == "" {
    return ""
  }
  "(() => { try { (function () {\n" +
  js +
  "\n}).call(globalThis); } catch (e) { try { console.error('Boost script: ' + e); } catch (_) {} } return '1'; })()"
}
