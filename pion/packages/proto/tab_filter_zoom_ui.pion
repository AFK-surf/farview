///| Pure-Pion daily-driver UI helpers for:
///| 1. Arc Sidebar Live Tab Filter (UTF-8 safe via `omni_ascii_lower`, match counters, clear-button visibility)
///| 2. Arc Tab Context Menu (`tab_close_others` eligibility & target IDs, mute/pin dynamic labels)
///| 3. Omnibox Adaptive Zoom Pill & Zoom Control Popover (visibility, formatting, ladder step/fraction, demo parser)

pub struct TabFilterStats {
  pub matched : Int
  pub total : Int
  pub pinned_matched : Int
  pub folder_matched : Int
  pub today_matched : Int
  pub active : Bool
}

///| UTF-8 safe case-insensitive match for a sidebar tab against `raw_query`.
///| Matches title, full URL, or display host; preserves CJK/Japanese/Korean/accented characters intact.
pub fn tab_filter_matches(tab : TabSummary, raw_query : String) -> Bool {
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    return true
  }
  if omni_ascii_lower(tab.title).contains(q) {
    return true
  }
  if omni_ascii_lower(tab.url).contains(q) {
    return true
  }
  omni_ascii_lower(omnibox_display_host(tab.url)).contains(q)
}

///| Computes sidebar live filter statistics across unfoldered Pinned, Foldered Pinned, and Today tabs in `space_id`.
pub fn tab_filter_compute_stats(
  snap : WorkspaceSnapshot,
  space_id : String,
  raw_query : String,
) -> TabFilterStats {
  let q = raw_query.trim()
  let active = q != ""
  let mut total = 0
  let mut matched = 0
  let mut pinned_matched = 0
  let mut folder_matched = 0
  let mut today_matched = 0

  let unfoldered_pinned = workspace_unfoldered_pinned_tabs(snap, space_id)
  let mut i = 0
  while i < unfoldered_pinned.length() {
    total = total + 1
    if !active || tab_filter_matches(unfoldered_pinned[i], q) {
      matched = matched + 1
      pinned_matched = pinned_matched + 1
    }
    i = i + 1
  }

  let folders = workspace_folders_for_space(snap, space_id)
  let mut fi = 0
  while fi < folders.length() {
    let fl = folders[fi]
    let folder_name_hit = active && omni_ascii_lower(fl.name).contains(omni_ascii_lower(q))
    let children = workspace_tabs_in_folder(snap, space_id, fl.id)
    let mut ci = 0
    while ci < children.length() {
      total = total + 1
      if !active || folder_name_hit || tab_filter_matches(children[ci], q) {
        matched = matched + 1
        folder_matched = folder_matched + 1
      }
      ci = ci + 1
    }
    fi = fi + 1
  }

  let today = workspace_tabs_for_space(snap, space_id, false)
  let mut ti = 0
  while ti < today.length() {
    total = total + 1
    if !active || tab_filter_matches(today[ti], q) {
      matched = matched + 1
      today_matched = today_matched + 1
    }
    ti = ti + 1
  }

  TabFilterStats::{ matched, total, pinned_matched, folder_matched, today_matched, active }
}

///| Formats the compact match-count pill label (e.g. `"3 / 8"`).
pub fn tab_filter_badge_label(matched : Int, total : Int) -> String {
  let m = if matched < 0 { 0 } else { matched }
  let t = if total < 0 { 0 } else { total }
  m.to_string() + " / " + t.to_string()
}

///| Returns true when the one-click clear `×` button in the sidebar filter bar should be mounted.
pub fn tab_filter_has_clear_button(raw_query : String) -> Bool {
  raw_query.trim() != ""
}

///| Returns the IDs of all other unpinned, non-favorite (Today) tabs in the same Space as `target_tab_id`.
///| Used by `Close Other Tabs` in both client UI enablement checks and host `tab_close_others`.
pub fn tab_close_others_ids(snap : WorkspaceSnapshot, target_tab_id : String) -> Array[String] {
  let mut target_space = snap.active_space_id
  let mut i = 0
  while i < snap.tabs.length() {
    if snap.tabs[i].id == target_tab_id {
      target_space = snap.tabs[i].space_id
      break
    }
    i = i + 1
  }
  let out : Array[String] = []
  let mut j = 0
  while j < snap.tabs.length() {
    let t = snap.tabs[j]
    if t.space_id == target_space && !t.pinned && !t.favorite && t.id != target_tab_id {
      out.push(t.id)
    }
    j = j + 1
  }
  out
}

///| Returns the number of other closable (Today, unpinned) tabs in the same Space as `target_tab_id`.
pub fn tab_close_others_count(snap : WorkspaceSnapshot, target_tab_id : String) -> Int {
  tab_close_others_ids(snap, target_tab_id).length()
}

///| Returns true only when there is at least one other unpinned tab in the same Space to close.
pub fn tab_close_others_enabled(snap : WorkspaceSnapshot, target_tab_id : String) -> Bool {
  tab_close_others_count(snap, target_tab_id) > 0
}

///| Returns true when `tab_id` is currently muted according to `snap.media`.
pub fn tab_is_muted_in_snapshot(snap : WorkspaceSnapshot, tab_id : String) -> Bool {
  match snap.media {
    Some(m) => {
      if m.tab_id != "" {
        m.tab_id == tab_id && m.muted
      } else if tab_id == snap.active_tab_id {
        m.muted
      } else {
        false
      }
    }
    None => false
  }
}

///| Returns `"Unmute Tab"` or `"Mute Tab"` based on real snapshot media state.
pub fn tab_mute_menu_label(snap : WorkspaceSnapshot, tab_id : String) -> String {
  if tab_is_muted_in_snapshot(snap, tab_id) {
    "Unmute Tab"
  } else {
    "Mute Tab"
  }
}

///| Returns `"Unpin Tab"` or `"Pin Tab"` based on the tab's pinned state.
pub fn tab_pin_menu_label(tab : TabSummary) -> String {
  if tab.pinned {
    "Unpin Tab"
  } else {
    "Pin Tab"
  }
}

///| Returns true when the omnibox zoom pill should be shown (`zoom != 100%`).
pub fn zoom_pill_visible(zoom : Double) -> Bool {
  zoom_percent(zoom) != 100
}

///| Formats the zoom percentage pill / readout label (e.g. `"125%"`, `"80%"`).
pub fn zoom_pill_label(zoom : Double) -> String {
  zoom_percent(zoom).to_string() + "%"
}

///| Returns true when zoom can step down further (above 50%).
pub fn zoom_can_step_down(zoom : Double) -> Bool {
  zoom_percent(zoom) > zoom_percent(ZOOM_MIN)
}

///| Returns true when zoom can step up further (below 300%).
pub fn zoom_can_step_up(zoom : Double) -> Bool {
  zoom_percent(zoom) < zoom_percent(ZOOM_MAX)
}

///| Returns true when zoom is at the 100% default.
pub fn zoom_is_default(zoom : Double) -> Bool {
  zoom_percent(zoom) == 100
}

///| Returns the nearest index (0..12) on the 13-step Chromium zoom ladder.
pub fn zoom_step_index(zoom : Double) -> Int {
  let z = clamp_zoom(zoom)
  let steps = zoom_steps()
  let mut best_i = 0
  let mut best_d = 999.0
  let mut i = 0
  while i < steps.length() {
    let d = math_abs(steps[i] - z)
    if d < best_d {
      best_d = d
      best_i = i
    }
    i = i + 1
  }
  best_i
}

///| Normalized 0.0..1.0 position of `zoom` along the 13-step Chromium zoom ladder
///| (50% -> 0.0, 100% -> 5/12, 125% -> 7/12, 300% -> 1.0).
pub fn zoom_scale_fraction(zoom : Double) -> Double {
  let steps = zoom_steps()
  let max_idx = steps.length() - 1
  if max_idx <= 0 {
    return 0.0
  }
  let idx = zoom_step_index(zoom)
  let f = int_to_double(idx) / int_to_double(max_idx)
  if f < 0.0 {
    0.0
  } else if f > 1.0 {
    1.0
  } else {
    f
  }
}

///| Normalized position of the 100% default tick on the zoom ladder (`5 / 12`).
pub fn zoom_default_marker_fraction() -> Double {
  5.0 / 12.0
}

///| Returns a clean domain/host label for the Zoom Control Popover header.
pub fn zoom_popover_host_label(raw_url : String) -> String {
  let h = omnibox_display_host(raw_url).trim()
  if h == "" {
    return "Current Page"
  }
  let mut end = h.length()
  let mut i = 0
  while i < h.length() {
    let c = h.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      end = i
      break
    }
    i = i + 1
  }
  let dom = h.slice(0, end).trim()
  if dom != "" {
    dom
  } else {
    "Current Page"
  }
}

///| Parses `--demo-zoom` argument accepting either percentage (`"125"`, `"125%"`, `"80"`)
///| or scale factor (`"1.25"`, `"0.8"`), returning a clamped zoom factor in `[0.5, 3.0]`.
pub fn parse_demo_zoom_pct(raw : String) -> Option[Double] {
  let s = raw.trim()
  if s == "" {
    return None
  }
  if s.ends_with("%") {
    return parse_zoom_str(s)
  }
  match parse_zoom_num(s) {
    Some(v) if v > 0.0 => {
      if v >= 10.0 {
        Some(clamp_zoom(v / 100.0))
      } else {
        Some(clamp_zoom(v))
      }
    }
    _ => None
  }
}
