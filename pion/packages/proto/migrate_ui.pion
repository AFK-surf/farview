///| Shared pure-Pion protocol models & fault-tolerant JSON codecs for cross-browser migration
///| (`migrate_detect` -> `migrate_sources`, `migrate_run` -> `migrate_result`).
///| Decoupled from rendering internals so both pure-Pion and future swappable engines share one contract.

#derive(Eq)
pub struct MigrateSourceInfo {
  pub id : String
  pub browser : String
  pub profile_name : String
  pub profile_path : String
  pub has_bookmarks : Bool
  pub has_history : Bool
  pub has_spaces : Bool
  pub has_extensions : Bool
}

pub struct MigrateSourcesSnapshot {
  pub sources : Array[MigrateSourceInfo]
}

pub struct MigrateRequest {
  pub source_id : String
  pub import_bookmarks : Bool
  pub import_history : Bool
  pub import_spaces : Bool
  pub import_extensions : Bool
  pub custom_path : String
}

pub struct MigrateResultSnapshot {
  pub ok : Bool
  pub source_label : String
  pub bookmarks_added : Int
  pub history_added : Int
  pub spaces_added : Int
  pub folders_added : Int
  pub pinned_added : Int
  pub extensions_added : Int
  pub cookies_added : Int
  pub skipped_unsafe : Int
  pub error : String
}

pub fn MigrateResultSnapshot::empty() -> MigrateResultSnapshot {
  MigrateResultSnapshot::{
    ok: false,
    source_label: "",
    bookmarks_added: 0,
    history_added: 0,
    spaces_added: 0,
    folders_added: 0,
    pinned_added: 0,
    extensions_added: 0,
    cookies_added: 0,
    skipped_unsafe: 0,
    error: "",
  }
}

fn mig_json_escape(s : String) -> String {
  let sb = StringBuilder::new()
  sb.write_char('"')
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 34 {
      sb.write_string("\\\"")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else if c >= 32 {
      sb.write_string(s.slice(i, i + 1))
    }
    i += 1
  }
  sb.write_char('"')
  sb.to_string()
}

pub fn encode_migrate_sources(snap : MigrateSourcesSnapshot) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"sources\":[")
  let mut i = 0
  while i < snap.sources.length() {
    if i > 0 {
      sb.write_char(',')
    }
    let s = snap.sources[i]
    sb.write_string("{\"id\":")
    sb.write_string(mig_json_escape(s.id))
    sb.write_string(",\"browser\":")
    sb.write_string(mig_json_escape(s.browser))
    sb.write_string(",\"profileName\":")
    sb.write_string(mig_json_escape(s.profile_name))
    sb.write_string(",\"profilePath\":")
    sb.write_string(mig_json_escape(s.profile_path))
    sb.write_string(",\"hasBookmarks\":")
    sb.write_string(if s.has_bookmarks { "true" } else { "false" })
    sb.write_string(",\"hasHistory\":")
    sb.write_string(if s.has_history { "true" } else { "false" })
    sb.write_string(",\"hasSpaces\":")
    sb.write_string(if s.has_spaces { "true" } else { "false" })
    sb.write_string(",\"hasExtensions\":")
    sb.write_string(if s.has_extensions { "true" } else { "false" })
    sb.write_char('}')
    i += 1
  }
  sb.write_string("]}")
  sb.to_string()
}

pub fn encode_migrate_request(req : MigrateRequest) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"sourceId\":")
  sb.write_string(mig_json_escape(req.source_id))
  sb.write_string(",\"importBookmarks\":")
  sb.write_string(if req.import_bookmarks { "true" } else { "false" })
  sb.write_string(",\"importHistory\":")
  sb.write_string(if req.import_history { "true" } else { "false" })
  sb.write_string(",\"importSpaces\":")
  sb.write_string(if req.import_spaces { "true" } else { "false" })
  sb.write_string(",\"importExtensions\":")
  sb.write_string(if req.import_extensions { "true" } else { "false" })
  sb.write_string(",\"customPath\":")
  sb.write_string(mig_json_escape(req.custom_path))
  sb.write_char('}')
  sb.to_string()
}

pub fn encode_migrate_result(res : MigrateResultSnapshot) -> String {
  let sb = StringBuilder::new()
  sb.write_string("{\"ok\":")
  sb.write_string(if res.ok { "true" } else { "false" })
  sb.write_string(",\"sourceLabel\":")
  sb.write_string(mig_json_escape(res.source_label))
  sb.write_string(",\"bookmarksAdded\":")
  sb.write_string(res.bookmarks_added.to_string())
  sb.write_string(",\"historyAdded\":")
  sb.write_string(res.history_added.to_string())
  sb.write_string(",\"spacesAdded\":")
  sb.write_string(res.spaces_added.to_string())
  sb.write_string(",\"foldersAdded\":")
  sb.write_string(res.folders_added.to_string())
  sb.write_string(",\"pinnedAdded\":")
  sb.write_string(res.pinned_added.to_string())
  sb.write_string(",\"extensionsAdded\":")
  sb.write_string(res.extensions_added.to_string())
  sb.write_string(",\"cookiesAdded\":")
  sb.write_string(res.cookies_added.to_string())
  sb.write_string(",\"skippedUnsafe\":")
  sb.write_string(res.skipped_unsafe.to_string())
  sb.write_string(",\"error\":")
  sb.write_string(mig_json_escape(res.error))
  sb.write_char('}')
  sb.to_string()
}

fn mig_skip_ws(s : String, start : Int) -> Int {
  let mut i = start
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 32 || c == 9 || c == 10 || c == 13 {
      i += 1
    } else {
      break
    }
  }
  i
}

fn mig_read_str(s : String, start : Int) -> Option[(String, Int)] {
  let mut i = mig_skip_ws(s, start)
  if i >= s.length() || s.code_unit_at(i).to_int() != 34 {
    return None
  }
  i += 1
  let sb = StringBuilder::new()
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 34 {
      return Some((sb.to_string(), i + 1))
    }
    if c == 92 && i + 1 < s.length() {
      let e = s.code_unit_at(i + 1).to_int()
      i += 2
      if e == 34 { sb.write_char('"') }
      else if e == 92 { sb.write_char('\\') }
      else if e == 47 { sb.write_char('/') }
      else if e == 110 { sb.write_char('\n') }
      else if e == 114 { sb.write_char('\r') }
      else if e == 116 { sb.write_char('\t') }
      else { sb.write_string(s.slice(i - 1, i)) }
    } else {
      sb.write_string(s.slice(i, i + 1))
      i += 1
    }
  }
  None
}

fn mig_skip_val(s : String, start : Int, depth : Int) -> Int {
  if depth > 32 {
    return s.length()
  }
  let i = mig_skip_ws(s, start)
  if i >= s.length() {
    return i
  }
  let c = s.code_unit_at(i).to_int()
  if c == 34 {
    match mig_read_str(s, i) {
      Some((_, ni)) => ni
      None => s.length()
    }
  } else if c == 123 || c == 91 {
    let open = c
    let close = if c == 123 { 125 } else { 93 }
    let mut j = i + 1
    let mut nest = 1
    while j < s.length() && nest > 0 {
      let ch = s.code_unit_at(j).to_int()
      if ch == 34 {
        match mig_read_str(s, j) {
          Some((_, nj)) => j = nj
          None => return s.length()
        }
      } else if ch == open {
        nest += 1
        j += 1
      } else if ch == close {
        nest -= 1
        j += 1
      } else {
        j += 1
      }
    }
    j
  } else {
    let mut j = i
    while j < s.length() {
      let ch = s.code_unit_at(j).to_int()
      if ch == 44 || ch == 125 || ch == 93 || ch == 32 || ch == 10 || ch == 13 || ch == 9 {
        break
      }
      j += 1
    }
    j
  }
}

fn mig_read_bool(s : String, start : Int) -> (Bool, Int) {
  let i = mig_skip_ws(s, start)
  if i + 4 <= s.length() && s.slice(i, i + 4) == "true" {
    (true, i + 4)
  } else if i + 5 <= s.length() && s.slice(i, i + 5) == "false" {
    (false, i + 5)
  } else {
    (false, mig_skip_val(s, i, 0))
  }
}

fn mig_read_int(s : String, start : Int) -> (Int, Int) {
  let mut i = mig_skip_ws(s, start)
  let mut neg = false
  if i < s.length() && s.code_unit_at(i).to_int() == 45 {
    neg = true
    i += 1
  }
  let mut acc = 0
  let mut digits = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
      digits += 1
      i += 1
    } else {
      break
    }
  }
  if digits == 0 {
    (0, mig_skip_val(s, start, 0))
  } else {
    (if neg { 0 - acc } else { acc }, i)
  }
}

fn mig_parse_source_obj(s : String, start : Int) -> Option[(MigrateSourceInfo, Int)] {
  let mut i = mig_skip_ws(s, start)
  if i >= s.length() || s.code_unit_at(i).to_int() != 123 {
    return None
  }
  i += 1
  let mut id = ""
  let mut browser = ""
  let mut profile_name = ""
  let mut profile_path = ""
  let mut has_bookmarks = false
  let mut has_history = false
  let mut has_spaces = false
  let mut has_extensions = false
  while i < s.length() {
    i = mig_skip_ws(s, i)
    if i >= s.length() {
      return None
    }
    if s.code_unit_at(i).to_int() == 125 {
      return Some((
        MigrateSourceInfo::{
          id,
          browser,
          profile_name,
          profile_path,
          has_bookmarks,
          has_history,
          has_spaces,
          has_extensions,
        },
        i + 1,
      ))
    }
    let (k, ni) = match mig_read_str(s, i) {
      Some(v) => v
      None => return None
    }
    i = mig_skip_ws(s, ni)
    if i >= s.length() || s.code_unit_at(i).to_int() != 58 {
      return None
    }
    i = mig_skip_ws(s, i + 1)
    if k == "id" {
      match mig_read_str(s, i) {
        Some((v, n2)) => { id = v; i = n2 }
        None => i = mig_skip_val(s, i, 0)
      }
    } else if k == "browser" {
      match mig_read_str(s, i) {
        Some((v, n2)) => { browser = v; i = n2 }
        None => i = mig_skip_val(s, i, 0)
      }
    } else if k == "profileName" {
      match mig_read_str(s, i) {
        Some((v, n2)) => { profile_name = v; i = n2 }
        None => i = mig_skip_val(s, i, 0)
      }
    } else if k == "profilePath" {
      match mig_read_str(s, i) {
        Some((v, n2)) => { profile_path = v; i = n2 }
        None => i = mig_skip_val(s, i, 0)
      }
    } else if k == "hasBookmarks" {
      let (b, n2) = mig_read_bool(s, i)
      has_bookmarks = b
      i = n2
    } else if k == "hasHistory" {
      let (b, n2) = mig_read_bool(s, i)
      has_history = b
      i = n2
    } else if k == "hasSpaces" {
      let (b, n2) = mig_read_bool(s, i)
      has_spaces = b
      i = n2
    } else if k == "hasExtensions" {
      let (b, n2) = mig_read_bool(s, i)
      has_extensions = b
      i = n2
    } else {
      i = mig_skip_val(s, i, 0)
    }
    i = mig_skip_ws(s, i)
    if i < s.length() && s.code_unit_at(i).to_int() == 44 {
      i += 1
    }
  }
  None
}

pub fn parse_migrate_sources(json : String) -> Option[MigrateSourcesSnapshot] {
  let mut i = mig_skip_ws(json, 0)
  if i >= json.length() || json.code_unit_at(i).to_int() != 123 {
    return None
  }
  i += 1
  let sources : Array[MigrateSourceInfo] = []
  while i < json.length() {
    i = mig_skip_ws(json, i)
    if i >= json.length() || json.code_unit_at(i).to_int() == 125 {
      break
    }
    let (k, ni) = match mig_read_str(json, i) {
      Some(v) => v
      None => return None
    }
    i = mig_skip_ws(json, ni)
    if i >= json.length() || json.code_unit_at(i).to_int() != 58 {
      return None
    }
    i = mig_skip_ws(json, i + 1)
    if k == "sources" && i < json.length() && json.code_unit_at(i).to_int() == 91 {
      i += 1
      while i < json.length() {
        i = mig_skip_ws(json, i)
        if i >= json.length() {
          break
        }
        if json.code_unit_at(i).to_int() == 93 {
          i += 1
          break
        }
        match mig_parse_source_obj(json, i) {
          Some((src, n2)) => {
            if sources.length() < 64 {
              sources.push(src)
            }
            i = n2
          }
          None => break
        }
        i = mig_skip_ws(json, i)
        if i < json.length() && json.code_unit_at(i).to_int() == 44 {
          i += 1
        }
      }
    } else {
      i = mig_skip_val(json, i, 0)
    }
    i = mig_skip_ws(json, i)
    if i < json.length() && json.code_unit_at(i).to_int() == 44 {
      i += 1
    }
  }
  Some(MigrateSourcesSnapshot::{ sources })
}

pub fn parse_migrate_request(json : String) -> Option[MigrateRequest] {
  let mut i = mig_skip_ws(json, 0)
  if i >= json.length() || json.code_unit_at(i).to_int() != 123 {
    return None
  }
  i += 1
  let mut source_id = ""
  let mut import_bookmarks = true
  let mut import_history = true
  let mut import_spaces = true
  let mut import_extensions = true
  let mut custom_path = ""
  while i < json.length() {
    i = mig_skip_ws(json, i)
    if i >= json.length() || json.code_unit_at(i).to_int() == 125 {
      break
    }
    let (k, ni) = match mig_read_str(json, i) {
      Some(v) => v
      None => return None
    }
    i = mig_skip_ws(json, ni)
    if i >= json.length() || json.code_unit_at(i).to_int() != 58 {
      return None
    }
    i = mig_skip_ws(json, i + 1)
    if k == "sourceId" {
      match mig_read_str(json, i) {
        Some((v, n2)) => { source_id = v; i = n2 }
        None => i = mig_skip_val(json, i, 0)
      }
    } else if k == "customPath" {
      match mig_read_str(json, i) {
        Some((v, n2)) => { custom_path = v; i = n2 }
        None => i = mig_skip_val(json, i, 0)
      }
    } else if k == "importBookmarks" {
      let (b, n2) = mig_read_bool(json, i)
      import_bookmarks = b
      i = n2
    } else if k == "importHistory" {
      let (b, n2) = mig_read_bool(json, i)
      import_history = b
      i = n2
    } else if k == "importSpaces" {
      let (b, n2) = mig_read_bool(json, i)
      import_spaces = b
      i = n2
    } else if k == "importExtensions" {
      let (b, n2) = mig_read_bool(json, i)
      import_extensions = b
      i = n2
    } else {
      i = mig_skip_val(json, i, 0)
    }
    i = mig_skip_ws(json, i)
    if i < json.length() && json.code_unit_at(i).to_int() == 44 {
      i += 1
    }
  }
  Some(MigrateRequest::{
    source_id,
    import_bookmarks,
    import_history,
    import_spaces,
    import_extensions,
    custom_path,
  })
}

pub fn parse_migrate_result(json : String) -> Option[MigrateResultSnapshot] {
  let mut i = mig_skip_ws(json, 0)
  if i >= json.length() || json.code_unit_at(i).to_int() != 123 {
    return None
  }
  i += 1
  let mut ok = false
  let mut source_label = ""
  let mut bookmarks_added = 0
  let mut history_added = 0
  let mut spaces_added = 0
  let mut folders_added = 0
  let mut pinned_added = 0
  let mut extensions_added = 0
  let mut cookies_added = 0
  let mut skipped_unsafe = 0
  let mut error = ""
  while i < json.length() {
    i = mig_skip_ws(json, i)
    if i >= json.length() || json.code_unit_at(i).to_int() == 125 {
      break
    }
    let (k, ni) = match mig_read_str(json, i) {
      Some(v) => v
      None => return None
    }
    i = mig_skip_ws(json, ni)
    if i >= json.length() || json.code_unit_at(i).to_int() != 58 {
      return None
    }
    i = mig_skip_ws(json, i + 1)
    if k == "ok" {
      let (b, n2) = mig_read_bool(json, i)
      ok = b
      i = n2
    } else if k == "sourceLabel" {
      match mig_read_str(json, i) {
        Some((v, n2)) => { source_label = v; i = n2 }
        None => i = mig_skip_val(json, i, 0)
      }
    } else if k == "error" {
      match mig_read_str(json, i) {
        Some((v, n2)) => { error = v; i = n2 }
        None => i = mig_skip_val(json, i, 0)
      }
    } else if k == "bookmarksAdded" {
      let (v, n2) = mig_read_int(json, i)
      bookmarks_added = v
      i = n2
    } else if k == "historyAdded" {
      let (v, n2) = mig_read_int(json, i)
      history_added = v
      i = n2
    } else if k == "spacesAdded" {
      let (v, n2) = mig_read_int(json, i)
      spaces_added = v
      i = n2
    } else if k == "foldersAdded" {
      let (v, n2) = mig_read_int(json, i)
      folders_added = v
      i = n2
    } else if k == "pinnedAdded" {
      let (v, n2) = mig_read_int(json, i)
      pinned_added = v
      i = n2
    } else if k == "extensionsAdded" {
      let (v, n2) = mig_read_int(json, i)
      extensions_added = v
      i = n2
    } else if k == "cookiesAdded" {
      let (v, n2) = mig_read_int(json, i)
      cookies_added = v
      i = n2
    } else if k == "skippedUnsafe" {
      let (v, n2) = mig_read_int(json, i)
      skipped_unsafe = v
      i = n2
    } else {
      i = mig_skip_val(json, i, 0)
    }
    i = mig_skip_ws(json, i)
    if i < json.length() && json.code_unit_at(i).to_int() == 44 {
      i += 1
    }
  }
  Some(MigrateResultSnapshot::{
    ok,
    source_label,
    bookmarks_added,
    history_added,
    spaces_added,
    folders_added,
    pinned_added,
    extensions_added,
    cookies_added,
    skipped_unsafe,
    error,
  })
}

///| Formats a concise human-readable summary of a completed migration run for Settings & toasts.
pub fn format_migrate_result_summary(res : MigrateResultSnapshot) -> String {
  if !res.ok {
    if res.error != "" {
      return "Import failed: " + res.error
    }
    return "Import failed."
  }
  let parts : Array[String] = []
  if res.bookmarks_added > 0 {
    parts.push(res.bookmarks_added.to_string() + (if res.bookmarks_added == 1 { " bookmark" } else { " bookmarks" }))
  }
  if res.history_added > 0 {
    parts.push(res.history_added.to_string() + (if res.history_added == 1 { " history item" } else { " history items" }))
  }
  if res.spaces_added > 0 {
    parts.push(res.spaces_added.to_string() + (if res.spaces_added == 1 { " space" } else { " spaces" }))
  }
  if res.folders_added > 0 {
    parts.push(res.folders_added.to_string() + (if res.folders_added == 1 { " folder" } else { " folders" }))
  }
  if res.pinned_added > 0 {
    parts.push(res.pinned_added.to_string() + (if res.pinned_added == 1 { " pinned tab" } else { " pinned tabs" }))
  }
  if res.extensions_added > 0 {
    parts.push(res.extensions_added.to_string() + (if res.extensions_added == 1 { " extension" } else { " extensions" }))
  }
  if res.cookies_added > 0 {
    parts.push(res.cookies_added.to_string() + (if res.cookies_added == 1 { " cookie" } else { " cookies" }))
  }
  let from_suffix = if res.source_label != "" { " from " + res.source_label } else { "" }
  if parts.length() == 0 {
    "Already up to date" + from_suffix + "."
  } else {
    "Imported " + parts.join(", ") + from_suffix + "."
  }
}
