fn bodies(framed : Bytes) -> Array[Bytes] {
  let f = Framer::new()
  f.push(framed)
  let out : Array[Bytes] = []
  while true {
    match f.next() {
      Some(b) => out.push(b)
      None => break
    }
  }
  out
}

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
    i = i + 1
  }
  true
}

fn make_filled_bytes(n : Int, v : Int) -> Bytes {
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = (v & 0xFF).to_byte()
    i = i + 1
  }
  b
}

test "host message truncated at any byte is dropped" {
  let png_sample = Bytes::new(6)
  png_sample[0] = (0x89).to_byte()
  png_sample[1] = (80).to_byte()
  png_sample[2] = (78).to_byte()
  png_sample[3] = (71).to_byte()
  png_sample[4] = (13).to_byte()
  png_sample[5] = (10).to_byte()
  let pdf_sample = "%PDF-1.4".to_bytes()
  let msgs : Array[HostMsg] = [
    Meta("https://example.com/", "例子", true, false, true),
    Asset("https://example.com/a.png", 0, 12.5, 7.0, png_sample),
    Copied("复制的字"),
    OpenTab("https://example.com/new"),
    PickFile(42, "image/*,.pdf", true),
    PickFile(7, "", false),
    Downloaded("报告.pdf", "https://example.com/r", "application/pdf", pdf_sample),
    Downloaded("big.bin", "https://example.com/big", "", Bytes::new(0)),
    CloseTab,
    Audio(1, make_filled_bytes(32, 0x5a)),
    AudioCtl(0.75, true),
  ]
  let mut i = 0
  while i < msgs.length() {
    let bs = bodies(encode_host(msgs[i]))
    debug_assert(bs.length() == 1, "one body")
    let body = bs[0]
    debug_assert(decode_host(body).is_some(), "full decode ok")
    let mut k = 0
    while k < body.length() {
      debug_assert(decode_host(body.slice(0, k)).is_none(), "truncated must be None")
      k = k + 1
    }
    i = i + 1
  }
}

test "client message truncated at any byte is dropped" {
  let msgs : Array[ClientMsg] = [
    Hello(3, "doc"),
    Viewport(1280.0, 800.0, 2.0),
    Pointer(1, 0, 0, 0, 42, 0.5, 0.25, 100.0, 200.0),
    EditInput(2, 42, "你好", 0, 2, 1),
    Key(3, 42, true, "a", "KeyA", "a", 0),
    Nav(0, "https://example.com/"),
    UploadFiles(42, [("a.txt", "text/plain", "hello".to_bytes()), ("图.png", "image/png", "PNG".to_bytes())]),
    UploadFiles(42, []),
  ]
  let mut i = 0
  while i < msgs.length() {
    let body = bodies(encode_client(msgs[i]))[0]
    debug_assert(decode_client(body).is_some(), "full client decode ok")
    let mut k = 0
    while k < body.length() {
      debug_assert(decode_client(body.slice(0, k)).is_none(), "truncated client None")
      k = k + 1
    }
    i = i + 1
  }
}

test "malformed counts lengths and unterminated varints dropped" {
  let w = Writer::new()
  w.int(102)
  w.int(1)
  w.int(0)
  w.int(1000000000)
  debug_assert(decode_host(w.to_bytes()).is_none(), "huge patch count")

  let bad_lens : Array[Int] = [1 << 30, -5]
  let mut i = 0
  while i < bad_lens.length() {
    let w2 = Writer::new()
    w2.int(103)
    w2.string("k")
    w2.int(0)
    w2.num(1.0)
    w2.num(1.0)
    w2.int(bad_lens[i])
    debug_assert(decode_host(w2.to_bytes()).is_none(), "bad asset len")
    i = i + 1
  }
  debug_assert(decode_client(make_filled_bytes(12, 0xff)).is_none(), "unterminated varint")
  debug_assert(decode_host(Bytes::new(0)).is_none(), "empty host body")
}

test "framer broken state and clear" {
  let f = Framer::new()
  let bad = Bytes::new(8)
  bad[0] = (0xff).to_byte()
  bad[1] = (0xff).to_byte()
  bad[2] = (0xff).to_byte()
  bad[3] = (0xf0).to_byte()
  f.push(bad)
  debug_assert(f.next().is_none(), "broken next none")
  debug_assert(f.broken(), "framer is broken")
  f.push(encode_client(Hello(3, "doc")))
  debug_assert(f.next().is_none(), "still broken after push")
  f.clear()
  f.push(encode_client(Hello(3, "doc")))
  debug_assert(f.next().is_some(), "works after clear")
}

test "IMA-ADPCM 440Hz/880Hz sine fidelity and Audio/AudioCtl roundtrip" {
  let frames = 960
  let pcm = Bytes::new(frames * 4)
  let two_pi = 6.283185307179586
  let mut i = 0
  while i < frames {
    let t = int_to_double(i) / 48000.0
    let l = (math_sin(two_pi * 440.0 * t) * 20000.0).to_int()
    let r = (math_sin(two_pi * 880.0 * t) * 16000.0).to_int()
    let off = i * 4
    pcm[off] = (l & 0xFF).to_byte()
    pcm[off + 1] = ((l >> 8) & 0xFF).to_byte()
    pcm[off + 2] = (r & 0xFF).to_byte()
    pcm[off + 3] = ((r >> 8) & 0xFF).to_byte()
    i = i + 1
  }
  let adpcm = encode_ima_adpcm_stereo(pcm)
  debug_assert(adpcm.length() == 967, "adpcm 967 bytes")
  let decoded = decode_ima_adpcm_stereo(adpcm)
  debug_assert(decoded.length() == 3840, "decoded 3840 bytes")
  let mut sig_sq = 0.0
  let mut err_sq = 0.0
  let mut max_err = 0
  i = 0
  while i < frames * 2 {
    let orig = read_s16le(pcm, i * 2)
    let dec = read_s16le(decoded, i * 2)
    let diff = int_abs(orig - dec)
    if diff > max_err {
      max_err = diff
    }
    let od = int_to_double(orig)
    let dd = int_to_double(diff)
    sig_sq = sig_sq + od * od
    err_sq = err_sq + dd * dd
    i = i + 1
  }
  debug_assert(err_sq > 0.0 && sig_sq / err_sq > 1000.0, "SNR > 30dB")
  debug_assert(max_err < 1200, "max_err < 1200")
  debug_assert(encode_ima_adpcm_stereo(Bytes::new(0)).length() == 0, "empty encode")
  debug_assert(decode_ima_adpcm_stereo(Bytes::new(7)).length() == 0, "short decode")

  match decode_host(bodies(encode_host(Audio(1, adpcm)))[0]) {
    Some(Audio(fmt, got)) => debug_assert(fmt == 1 && bytes_eq(got, adpcm), "audio roundtrip")
    _ => debug_assert(false, "audio decode failed")
  }
  match decode_host(bodies(encode_host(AudioCtl(0.4, true)))[0]) {
    Some(AudioCtl(v, stop)) => debug_assert(math_abs(v - 0.4) < 0.000000001 && stop, "audioctl roundtrip")
    _ => debug_assert(false, "audioctl decode failed")
  }
}

test "stage23a: PatchOp::Validation round-trips over wire" {
  let msg = HostMsg::Patch(7, 3, [Validation(42, "Please fill out this field."), Validation(0, "")])
  let body = bodies(encode_host(msg))[0]
  match decode_host(body) {
    Some(Patch(seq, ack, ops)) => {
      debug_assert(seq == 7 && ack == 3 && ops.length() == 2, "patch header")
      match ops[0] {
        Validation(id, s) => debug_assert(id == 42 && s == "Please fill out this field.", "val 0")
        _ => debug_assert(false, "expected validation 0")
      }
      match ops[1] {
        Validation(id, s) => debug_assert(id == 0 && s == "", "val 1")
        _ => debug_assert(false, "expected validation 1")
      }
    }
    _ => debug_assert(false, "validation decode failed")
  }
}

test "zoom clamping, Chromium ladder step_up/step_down/reset, and parsing" {
  // Boundary clamping 50%..300% and NaN safety
  debug_assert(math_abs(clamp_zoom(0.1) - 0.5) < 1.0e-9, "clamp below min")
  debug_assert(math_abs(clamp_zoom(-2.0) - 0.5) < 1.0e-9, "clamp negative")
  debug_assert(math_abs(clamp_zoom(0.5) - 0.5) < 1.0e-9, "exact min")
  debug_assert(math_abs(clamp_zoom(1.0) - 1.0) < 1.0e-9, "exact default")
  debug_assert(math_abs(clamp_zoom(3.0) - 3.0) < 1.0e-9, "exact max")
  debug_assert(math_abs(clamp_zoom(4.5) - 3.0) < 1.0e-9, "clamp above max")
  debug_assert(math_abs(clamp_zoom(0.0 / 0.0) - 1.0) < 1.0e-9, "NaN falls back to 1.0")

  // Walk full Chromium ladder upward from 50% to 300%
  let expected = zoom_steps()
  debug_assert(expected.length() == 13, "13 Chromium zoom steps")
  let mut z = expected[0]
  let mut i = 1
  while i < expected.length() {
    z = zoom_step_up(z)
    debug_assert(math_abs(z - expected[i]) < 1.0e-9, "step_up matches Chromium ladder")
    i = i + 1
  }
  debug_assert(math_abs(zoom_step_up(3.0) - 3.0) < 1.0e-9, "step_up saturates at 300%")

  // Walk full Chromium ladder downward from 300% to 50%
  z = expected[expected.length() - 1]
  i = expected.length() - 2
  while i >= 0 {
    z = zoom_step_down(z)
    debug_assert(math_abs(z - expected[i]) < 1.0e-9, "step_down matches Chromium ladder")
    i = i - 1
  }
  debug_assert(math_abs(zoom_step_down(0.5) - 0.5) < 1.0e-9, "step_down saturates at 50%")

  // Intermediate values & reset
  debug_assert(math_abs(zoom_step_up(1.05) - 1.1) < 1.0e-9, "step_up from 1.05 -> 1.1")
  debug_assert(math_abs(zoom_step_down(1.3) - 1.25) < 1.0e-9, "step_down from 1.3 -> 1.25")
  debug_assert(math_abs(zoom_reset() - 1.0) < 1.0e-9, "reset returns 1.0")
  debug_assert(zoom_percent(0.67) == 67 && zoom_percent(1.5) == 150 && zoom_percent(3.0) == 300, "zoom_percent")
  debug_assert(format_zoom_str(1.0) == "1.0" && format_zoom_str(1.5) == "1.5" && format_zoom_str(1.25) == "1.25" && format_zoom_str(0.67) == "0.67", "format_zoom_str")

  // parse_zoom_str
  match parse_zoom_str("1.5") {
    Some(v) => debug_assert(math_abs(v - 1.5) < 1.0e-9, "parse 1.5")
    None => debug_assert(false, "expected 1.5")
  }
  match parse_zoom_str("150%") {
    Some(v) => debug_assert(math_abs(v - 1.5) < 1.0e-9, "parse 150%")
    None => debug_assert(false, "expected 150%")
  }
  match parse_zoom_str("500%") {
    Some(v) => debug_assert(math_abs(v - 3.0) < 1.0e-9, "parse 500% clamped to 3.0")
    None => debug_assert(false, "expected clamped 3.0")
  }
  match parse_zoom_str("10%") {
    Some(v) => debug_assert(math_abs(v - 0.5) < 1.0e-9, "parse 10% clamped to 0.5")
    None => debug_assert(false, "expected clamped 0.5")
  }
  debug_assert(parse_zoom_str("").is_none(), "empty zoom None")
  debug_assert(parse_zoom_str("-1.5").is_none(), "negative zoom None")
  debug_assert(parse_zoom_str("abc").is_none(), "invalid zoom None")
  debug_assert(parse_zoom_str("0").is_none(), "zero zoom None")

  // Find badge formatting (0-based active -> 1-based display)
  debug_assert(format_find_badge(-1, 0) == "0/0", "no matches")
  debug_assert(format_find_badge(0, 5) == "1/5", "first match")
  debug_assert(format_find_badge(4, 5) == "5/5", "last match")
  debug_assert(format_find_badge(9, 5) == "5/5", "clamped active")
}

test "desktop browser shortcut dispatcher (macOS Cmd & Linux/Win Ctrl, Find, Zoom, Nav)" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  let alt = SHORTCUT_MOD_ALT
  let shift = SHORTCUT_MOD_SHIFT

  // macOS Cmd shortcuts
  debug_assert(dispatch_browser_shortcut(1108, cmd, true, false, false, false) is BrowserShortcut::FocusUrl, "Cmd+L")
  debug_assert(dispatch_browser_shortcut(1114, cmd, true, false, false, false) is BrowserShortcut::Reload, "Cmd+R")
  debug_assert(dispatch_browser_shortcut(KEY_F5_MAC, 0, true, false, false, false) is BrowserShortcut::Reload, "F5 mac")
  debug_assert(dispatch_browser_shortcut(KEY_F5_WIN, 0, false, false, false, false) is BrowserShortcut::Reload, "F5 win")
  debug_assert(dispatch_browser_shortcut(1091, cmd, true, false, false, false) is BrowserShortcut::Back, "Cmd+[")
  debug_assert(dispatch_browser_shortcut(1093, cmd, true, false, false, false) is BrowserShortcut::Forward, "Cmd+]")
  debug_assert(dispatch_browser_shortcut(KEY_LEFT, alt, true, false, false, false) is BrowserShortcut::Back, "Alt+Left")
  debug_assert(dispatch_browser_shortcut(KEY_RIGHT, alt, true, false, false, false) is BrowserShortcut::Forward, "Alt+Right")
  // Alt+Left/Right must NOT hijack word navigation while a text field is focused
  debug_assert(dispatch_browser_shortcut(KEY_LEFT, alt, true, false, false, true) is BrowserShortcut::None, "Alt+Left in field")
  debug_assert(dispatch_browser_shortcut(KEY_RIGHT, alt, true, false, false, true) is BrowserShortcut::None, "Alt+Right in field")

  // Zoom shortcuts (macOS & Linux/Win, with and without Shift for +/=)
  debug_assert(dispatch_browser_shortcut(1061, cmd, true, false, false, false) is BrowserShortcut::ZoomIn, "Cmd+=")
  debug_assert(dispatch_browser_shortcut(1043, cmd | shift, true, false, false, false) is BrowserShortcut::ZoomIn, "Cmd+Shift++")
  debug_assert(dispatch_browser_shortcut(1061, ctrl | shift, false, false, false, false) is BrowserShortcut::ZoomIn, "Ctrl+Shift+=")
  debug_assert(dispatch_browser_shortcut(1045, cmd, true, false, false, false) is BrowserShortcut::ZoomOut, "Cmd+-")
  debug_assert(dispatch_browser_shortcut(1048, cmd, true, false, false, false) is BrowserShortcut::ZoomReset, "Cmd+0")
  debug_assert(dispatch_browser_shortcut(1108, ctrl, false, false, false, false) is BrowserShortcut::FocusUrl, "Ctrl+L")
  debug_assert(dispatch_browser_shortcut(1102, ctrl, false, false, false, false) is BrowserShortcut::FindOpen, "Ctrl+F")

  // Find bar shortcuts: Cmd+F, Enter (next), Shift+Enter (prev), Escape (close)
  debug_assert(dispatch_browser_shortcut(1102, cmd, true, false, false, false) is BrowserShortcut::FindOpen, "Cmd+F")
  debug_assert(dispatch_browser_shortcut(KEY_ENTER, 0, true, true, true, true) is BrowserShortcut::FindNext, "Enter in find bar")
  debug_assert(dispatch_browser_shortcut(KEY_ENTER, shift, true, true, true, true) is BrowserShortcut::FindPrev, "Shift+Enter in find bar")
  debug_assert(dispatch_browser_shortcut(KEY_ESCAPE, 0, true, true, true, true) is BrowserShortcut::FindClose, "Esc closes find bar")
  debug_assert(dispatch_browser_shortcut(KEY_ESCAPE, 0, true, false, false, false) is BrowserShortcut::None, "Esc when find closed")

  // Clipboard shortcuts must remain untouched (None)
  debug_assert(dispatch_browser_shortcut(1099, cmd, true, false, false, false) is BrowserShortcut::None, "Cmd+C untouched")
  debug_assert(dispatch_browser_shortcut(1118, cmd, true, false, false, false) is BrowserShortcut::None, "Cmd+V untouched")
  debug_assert(dispatch_browser_shortcut(1120, cmd, true, false, false, false) is BrowserShortcut::None, "Cmd+X untouched")
  debug_assert(dispatch_browser_shortcut(1097, cmd, true, false, false, false) is BrowserShortcut::None, "Cmd+A untouched")
}

test "ZoomViewportState prevents split-packet double-division and broadcast oscillation" {
  // Scenario 1: Split TCP recv — Viewport(853.33, 464.0) arrives BEFORE Act("zoom", "1.5", "1280x696")
  let vp1 = ZoomViewportState::new(1280.0, 696.0)
  let (w1, h1) = vp1.on_doc_viewport(1280.0 / 1.5, 696.0 / 1.5)
  debug_assert(math_abs(w1 - 853.3333333) < 0.01 && math_abs(h1 - 464.0) < 0.01, "doc viewport sets logical size")
  let (rz1, bcast1) = vp1.on_zoom_cmd(1.5, format_base_wh(1280.0, 696.0), true)
  debug_assert(bcast1, "zoom 1.0 -> 1.5 broadcasts once")
  match rz1 {
    Some((rw, rh)) => debug_assert(math_abs(rw - 853.3333333) < 0.01 && math_abs(rh - 464.0) < 0.01, "no double-division with explicit base_wh")
    None => debug_assert(false, "expected resize target with explicit base_wh")
  }
  // Repeating same zoom must NOT broadcast again (zero oscillation)
  let (_, bcast1_dup) = vp1.on_zoom_cmd(1.5, "1280x696", true)
  debug_assert(!bcast1_dup, "duplicate zoom does not re-broadcast")

  // Scenario 2: Split TCP recv — Viewport(853.33, 464.0) arrives BEFORE Act("zoom", "1.5", "") (empty base_wh)
  let vp2 = ZoomViewportState::new(1280.0, 696.0)
  let _ = vp2.on_doc_viewport(1280.0 / 1.5, 696.0 / 1.5)
  let (rz2, bcast2) = vp2.on_zoom_cmd(1.5, "", true)
  debug_assert(bcast2, "empty base_wh with DocClient broadcasts Zoom(1.5)")
  debug_assert(rz2.is_none(), "empty base_wh with DocClient does NOT double-divide stale viewport")
  debug_assert(math_abs(vp2.w - 853.3333333) < 0.01 && math_abs(vp2.h - 464.0) < 0.01, "logical viewport preserved without double-division")

  // Scenario 3: Agent-initiated zoom with no DocClient (headless/wire viewer)
  let vp3 = ZoomViewportState::new(1280.0, 800.0)
  let _ = vp3.on_wire_hello(1280.0, 800.0)
  let (rz3, bcast3) = vp3.on_zoom_cmd(2.0, "", false)
  debug_assert(bcast3, "agent zoom broadcasts")
  match rz3 {
    Some((rw, rh)) => debug_assert(math_abs(rw - 640.0) < 0.01 && math_abs(rh - 400.0) < 0.01, "wire client divides unscaled base by 2.0")
    None => debug_assert(false, "expected resize for wire client")
  }
  let (rz3_reset, bcast3_reset) = vp3.on_zoom_cmd(1.0, "", false)
  debug_assert(bcast3_reset, "reset to 1.0 broadcasts")
  match rz3_reset {
    Some((rw, rh)) => debug_assert(math_abs(rw - 1280.0) < 0.01 && math_abs(rh - 800.0) < 0.01, "reset restores 1280x800")
    None => debug_assert(false, "expected resize on reset")
  }
}

test "omnibox_ui JSON parse, cap at 6, and malformed/truncated resilience" {
  let sample : Array[OmniboxItem] = [
    OmniboxItem::{ url: "https://www.youtube.com/watch?v=abc", title: "YouTube — \"Live\" & Music", visits: 42, score: 1520.25, switch_to_tab: false },
    OmniboxItem::{ url: "https://example.com/app/issues", title: "Linear · Issues \\ 架构", visits: 18, score: 1240.5, switch_to_tab: true },
    OmniboxItem::{ url: "https://dashboard.stripe.com/payments", title: "Stripe Dashboard", visits: 15, score: 1100.0, switch_to_tab: false },
    OmniboxItem::{ url: "https://meet.google.com/abc-defg-hij", title: "Google Meet", visits: 9, score: 980.0, switch_to_tab: false },
    OmniboxItem::{ url: "https://github.com/AFK-surf/farview", title: "AFK-surf/farview", visits: 27, score: 960.0, switch_to_tab: false },
    OmniboxItem::{ url: "https://docs.farview.dev/guide", title: "Farview Guide", visits: 5, score: 850.0, switch_to_tab: false },
    OmniboxItem::{ url: "https://example.com/overflow", title: "Overflow Item 7", visits: 1, score: 100.0, switch_to_tab: false },
  ]
  let encoded = encode_omnibox_results(sample)
  let parsed = parse_omnibox_results(encoded)
  debug_assert(parsed.length() == OMNIBOX_MAX_ITEMS, "must cap at 6 items")
  debug_assert(parsed[0].url == "https://www.youtube.com/watch?v=abc", "item 0 url")
  debug_assert(parsed[0].title == "YouTube — \"Live\" & Music", "item 0 escaped quote")
  debug_assert(parsed[0].visits == 42, "item 0 visits")
  debug_assert(math_abs(parsed[0].score - 1520.25) < 0.01, "item 0 score")
  debug_assert(!parsed[0].switch_to_tab, "item 0 switchToTab false")
  debug_assert(parsed[1].title == "Linear · Issues \\ 架构", "item 1 backslash + CJK")
  debug_assert(parsed[1].switch_to_tab, "item 1 switchToTab true")
  debug_assert(parsed[5].url == "https://docs.farview.dev/guide", "item 5 kept")

  // Empty, malformed, truncated, and empty-url filtering
  debug_assert(parse_omnibox_results("[]").length() == 0, "empty json array")
  debug_assert(parse_omnibox_results("").length() == 0, "empty string")
  debug_assert(parse_omnibox_results("not json").length() == 0, "garbage")
  debug_assert(parse_omnibox_results("[{\"url\":\"https://a.com\"").length() == 0, "truncated object")
  let filtered = parse_omnibox_results("[{\"url\":\"\",\"title\":\"skip\"},{\"url\":\"https://ok.dev\",\"title\":\"OK\",\"extra\":[1,2]}]")
  debug_assert(filtered.length() == 1 && filtered[0].url == "https://ok.dev", "skips empty url and unknown fields")
}

test "omnibox_ui keyboard selection wrap, URL normalization, and display helpers" {
  // Empty list always returns -1
  debug_assert(omnibox_step_selection(-1, 0, 1) == -1, "empty down")
  debug_assert(omnibox_step_selection(0, 0, -1) == -1, "empty up")

  // From unselected (-1): Down -> 0, Up -> count - 1
  debug_assert(omnibox_step_selection(-1, 4, 1) == 0, "down from -1 -> 0")
  debug_assert(omnibox_step_selection(-1, 4, -1) == 3, "up from -1 -> last")

  // Cyclic wrap-around
  debug_assert(omnibox_step_selection(0, 4, 1) == 1, "0 -> 1")
  debug_assert(omnibox_step_selection(3, 4, 1) == 0, "last -> 0 wrap")
  debug_assert(omnibox_step_selection(0, 4, -1) == 3, "0 -> last wrap")
  debug_assert(omnibox_step_selection(2, 4, -1) == 1, "2 -> 1")
  debug_assert(omnibox_clamp_selection(5, 3) == 2, "clamp high")
  debug_assert(omnibox_clamp_selection(-1, 3) == -1, "clamp -1")

  // Normalization & submit resolution
  debug_assert(omnibox_normalize_input("  ") == "", "blank")
  debug_assert(omnibox_normalize_input("https://linear.app") == "https://linear.app", "keep https")
  debug_assert(omnibox_normalize_input("localhost:3000/test") == "http://localhost:3000/test", "localhost -> http")
  debug_assert(omnibox_normalize_input("github.com/AFK-surf") == "https://github.com/AFK-surf", "domain -> https")
  debug_assert(omnibox_normalize_input("farview browser") == "https://www.google.com/search?q=farview+browser", "search query")

  let items : Array[OmniboxItem] = [
    OmniboxItem::{ url: "https://youtube.com", title: "YouTube", visits: 12, score: 900.0, switch_to_tab: false },
  ]
  debug_assert(omnibox_resolve_submit("you", items, 0) == "https://youtube.com", "selected item wins")
  debug_assert(omnibox_resolve_submit("you", items, -1) == "https://www.google.com/search?q=you", "unselected normalizes input")

  // Display helpers
  debug_assert(omnibox_display_host("https://www.youtube.com/") == "youtube.com", "strip https+www+trailing slash")
  debug_assert(omnibox_display_host("http://example.com/app") == "example.com/app", "strip http keep path")
  debug_assert(omnibox_initial_letter("https://www.github.com", "GitHub") == "G", "initial letter")
  debug_assert(omnibox_format_visits(0) == "", "0 visits hidden")
  debug_assert(omnibox_format_visits(14) == "14×", "14 visits")
  debug_assert(omnibox_format_visits(1250) == "1.2k×", "1.2k visits")
}

test "workspace_ui JSON round-trip, space/tier filtering, accent colors, and malformed resilience" {
  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "2",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work 工作", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 3 },
      SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", theme: space_theme_unset(), active: false, tab_count: 1 },
      SpaceSummary::{ id: "design", name: "Design", accent: "#8B5CF6", theme: space_theme_unset(), active: false, tab_count: 0 },
    ],
    folders: [],
    tabs: [
      TabSummary::{ id: "1", space_id: "work", title: "Linear — \"Roadmap\"", url: "https://example.com/app", pinned: true, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "2", space_id: "work", title: "Google Meet", url: "https://meet.google.com/abc-defg-hij", pinned: false, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "3", space_id: "work", title: "", url: "https://github.com/AFK-surf/farview", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "4", space_id: "personal", title: "YouTube 首页", url: "https://www.youtube.com/", pinned: true, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 0L },
    ],
    permissions: Some(SitePermSummary::{
      origin: "https://meet.google.com",
      camera: "granted",
      microphone: "granted",
      notifications: "denied",
      screen_capture: "granted",
      clipboard_read: "denied",
    }),
    closed_count: 3,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
  let encoded = encode_workspace_snapshot(snap)
  match parse_workspace_snapshot(encoded) {
    Some(got) => {
      debug_assert(got.active_space_id == "work", "active_space_id")
      debug_assert(got.active_tab_id == "2", "active_tab_id")
      debug_assert(got.closed_count == 3, "closed_count round-trip")
      debug_assert(got.spaces.length() == 3, "3 spaces")
      debug_assert(got.spaces[0].name == "Work 工作" && got.spaces[0].tab_count == 3, "space 0")
      debug_assert(got.tabs.length() == 4, "4 tabs")
      debug_assert(got.tabs[0].title == "Linear — \"Roadmap\"" && got.tabs[0].pinned, "tab 0 escaped title")
      debug_assert(got.tabs[1].active && got.tabs[1].state == "active", "tab 1 active")
      match got.permissions {
        Some(pm) =>
        debug_assert(
          pm.origin == "https://meet.google.com" &&
          pm.camera == "granted" &&
          pm.microphone == "granted" &&
          pm.notifications == "denied" &&
          pm.screen_capture == "granted" &&
          pm.clipboard_read == "denied",
          "permissions round-trip",
        )
        None => debug_assert(false, "expected permissions")
      }
      // Filtering Pinned vs Today per space
      let work_pinned = workspace_tabs_for_space(got, "work", true)
      let work_today = workspace_tabs_for_space(got, "work", false)
      let work_all = workspace_space_tabs(got, "work")
      debug_assert(work_pinned.length() == 1 && work_pinned[0].id == "1", "work pinned")
      debug_assert(work_today.length() == 2 && work_today[0].id == "2" && work_today[1].id == "3", "work today")
      debug_assert(work_all.length() == 3 && work_all[0].id == "1" && work_all[1].id == "2", "work ordered pinned first")
      debug_assert(workspace_tab_display_title(work_today[1]) == "github.com/AFK-surf/farview", "empty title falls back to host")
      match workspace_active_space(got) {
        Some(sp) => debug_assert(sp.id == "work", "active space lookup")
        None => debug_assert(false, "expected active space")
      }
    }
    None => debug_assert(false, "parse_workspace_snapshot failed")
  }

  // Accent hex parsing & fallback
  debug_assert(workspace_accent_color("#2563EB") == 0x2563EBFFL, "blue accent")
  debug_assert(workspace_accent_color("#10b981") == 0x10B981FFL, "lowercase green accent")
  debug_assert(workspace_accent_color("invalid") == 0x2563EBFFL, "invalid falls back to blue")

  // Malformed and truncated inputs safely return None
  debug_assert(parse_workspace_snapshot("").is_none(), "empty")
  debug_assert(parse_workspace_snapshot("not json").is_none(), "garbage")
  debug_assert(parse_workspace_snapshot("{\"activeSpaceId\":\"work\"").is_none(), "truncated object")
  debug_assert(parse_workspace_snapshot("{\"spaces\":[{\"id\":\"w\"").is_none(), "truncated array")
  debug_assert(parse_workspace_snapshot("{\"activeSpaceId\":\"w\",\"extra\":[1,true,null],\"spaces\":[],\"tabs\":[]}").is_some(), "unknown fields skipped")

  // Workspace shortcuts: Cmd/Ctrl+S, Cmd/Ctrl+T, Cmd/Ctrl+W, Cmd/Ctrl+1..9
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  debug_assert(dispatch_browser_shortcut(1115, cmd, true, false, false, false) is BrowserShortcut::ToggleSidebar, "Cmd+S")
  debug_assert(dispatch_browser_shortcut(1115, ctrl, false, false, false, false) is BrowserShortcut::ToggleSidebar, "Ctrl+S")
  debug_assert(dispatch_browser_shortcut(1116, cmd, true, false, false, false) is BrowserShortcut::TabNew, "Cmd+T")
  debug_assert(dispatch_browser_shortcut(1119, cmd, true, false, false, false) is BrowserShortcut::TabClose, "Cmd+W")
  match dispatch_browser_shortcut(1049, cmd, true, false, false, false) {
    BrowserShortcut::TabSwitch(idx) => debug_assert(idx == 0, "Cmd+1 -> index 0")
    _ => debug_assert(false, "expected TabSwitch(0)")
  }
  match dispatch_browser_shortcut(1057, ctrl, false, false, false, false) {
    BrowserShortcut::TabSwitch(idx) => debug_assert(idx == 8, "Ctrl+9 -> index 8")
    _ => debug_assert(false, "expected TabSwitch(8)")
  }
  // Site Info & Downloads shortcuts: Cmd/Ctrl+I and Cmd/Ctrl+J
  debug_assert(dispatch_browser_shortcut(1105, cmd, true, false, false, false) is BrowserShortcut::ToggleSiteInfo, "Cmd+I")
  debug_assert(dispatch_browser_shortcut(1105, ctrl, false, false, false, false) is BrowserShortcut::ToggleSiteInfo, "Ctrl+I")
  debug_assert(dispatch_browser_shortcut(1106, cmd, true, false, false, false) is BrowserShortcut::ToggleDownloads, "Cmd+J")
  debug_assert(dispatch_browser_shortcut(1106, ctrl, false, false, false, false) is BrowserShortcut::ToggleDownloads, "Ctrl+J")
  // Command Bar, Pin Tab & Reopen Closed Tab shortcuts: Cmd/Ctrl+K, Cmd/Ctrl+D, Cmd/Ctrl+Shift+T
  let shift = SHORTCUT_MOD_SHIFT
  debug_assert(dispatch_browser_shortcut(1107, cmd, true, false, false, false) is BrowserShortcut::OpenCommandBar, "Cmd+K")
  debug_assert(dispatch_browser_shortcut(1107, ctrl, false, false, false, false) is BrowserShortcut::OpenCommandBar, "Ctrl+K")
  debug_assert(dispatch_browser_shortcut(1100, cmd, true, false, false, false) is BrowserShortcut::ToggleBookmark, "Cmd+D")
  debug_assert(dispatch_browser_shortcut(1100, ctrl, false, false, false, false) is BrowserShortcut::ToggleBookmark, "Ctrl+D")
  debug_assert(dispatch_browser_shortcut(1098, cmd | shift, true, false, false, false) is BrowserShortcut::ToggleBookmarks, "Cmd+Shift+B")
  debug_assert(dispatch_browser_shortcut(1066, cmd | shift, true, false, false, false) is BrowserShortcut::ToggleBookmarks, "Cmd+Shift+B uppercase")
  debug_assert(dispatch_browser_shortcut(1098, ctrl | shift, false, false, false, false) is BrowserShortcut::ToggleBookmarks, "Ctrl+Shift+B")
  debug_assert(dispatch_browser_shortcut(1115, cmd | shift, true, false, false, false) is BrowserShortcut::CaptureScreenshot, "Cmd+Shift+S")
  debug_assert(dispatch_browser_shortcut(1083, cmd | shift, true, false, false, false) is BrowserShortcut::CaptureScreenshot, "Cmd+Shift+S uppercase")
  debug_assert(dispatch_browser_shortcut(1115, ctrl | shift, false, false, false, false) is BrowserShortcut::CaptureScreenshot, "Ctrl+Shift+S")
  debug_assert(dispatch_browser_shortcut(1116, cmd | shift, true, false, false, false) is BrowserShortcut::ReopenClosedTab, "Cmd+Shift+T")
  debug_assert(dispatch_browser_shortcut(1084, cmd | shift, true, false, false, false) is BrowserShortcut::ReopenClosedTab, "Cmd+Shift+T uppercase")
  debug_assert(dispatch_browser_shortcut(1116, ctrl | shift, false, false, false, false) is BrowserShortcut::ReopenClosedTab, "Ctrl+Shift+T")

  // Command Bar filtering, new space parsing, URL/search fallback & closed_count compatibility
  let legacy_no_closed = parse_workspace_snapshot("{\"activeSpaceId\":\"work\",\"activeTabId\":\"2\",\"spaces\":[],\"tabs\":[]}")
  match legacy_no_closed {
    Some(ls) => debug_assert(ls.closed_count == 0, "legacy snapshot defaults closed_count to 0")
    None => debug_assert(false, "expected legacy snapshot")
  }
  let def_items = build_command_bar_items(snap, "", "https://meet.google.com/abc", true)
  debug_assert(def_items.length() == COMMAND_BAR_MAX_ITEMS, "empty query fills 7 curated items")
  debug_assert(def_items[0].is_tab && def_items[0].title == "Linear — \"Roadmap\"", "first default item is non-active open tab")
  let new_sp_items = build_command_bar_items(snap, "new space Research", "https://meet.google.com/abc", true)
  debug_assert(new_sp_items.length() >= 2 && (new_sp_items[0].kind is CommandKind::NewSpace) && new_sp_items[0].id == "Research", "new space <name> creates custom space item")
  let url_items = build_command_bar_items(snap, "linear.app/roadmap", "https://meet.google.com/abc", true)
  let last_url = url_items[url_items.length() - 1]
  debug_assert((last_url.kind is CommandKind::NavigateUrl) && last_url.id == "https://linear.app/roadmap", "URL fallback")
  let search_items = build_command_bar_items(snap, "arc browser shortcuts", "https://meet.google.com/abc", false)
  let last_search = search_items[search_items.length() - 1]
  debug_assert((last_search.kind is CommandKind::SearchWeb) && last_search.id.starts_with("https://www.google.com/search?q="), "search fallback")
  debug_assert(next_auto_space_name(snap) == "Research", "skips existing Design space")
}

test "site_controls_ui legacy permissions defaults, DownloadSummary codec, and size formatting" {
  // Legacy 3-field permissions JSON must default screen_capture and clipboard_read to "ask"
  let legacy_json = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"1\",\"spaces\":[],\"tabs\":[],\"permissions\":{\"origin\":\"https://meet.google.com\",\"camera\":\"granted\",\"microphone\":\"prompt\",\"notifications\":\"denied\"}}"
  match parse_workspace_snapshot(legacy_json) {
    Some(snap) => match snap.permissions {
      Some(pm) => {
        debug_assert(pm.origin == "https://meet.google.com", "legacy origin")
        debug_assert(normalize_perm_state(pm.camera) == "allow", "legacy camera allow")
        debug_assert(normalize_perm_state(pm.microphone) == "ask", "legacy mic ask")
        debug_assert(normalize_perm_state(pm.notifications) == "deny", "legacy notif deny")
        debug_assert(pm.screen_capture == "ask" && pm.clipboard_read == "ask", "missing new perms default to ask")
        debug_assert(site_has_granted_media(Some(pm)), "granted camera triggers media badge")
      }
      None => debug_assert(false, "expected legacy permissions")
    }
    None => debug_assert(false, "expected legacy snapshot parse")
  }
  debug_assert(!site_has_granted_media(None), "None permissions has no media")
  debug_assert(site_is_https("https://meet.google.com/abc"), "https check")
  debug_assert(!site_is_https("http://localhost:8080/"), "http not https")
  debug_assert(site_is_local("http://127.0.0.1:8080/index.html"), "127.0.0.1 local")
  debug_assert(site_origin_from_url("https://meet.google.com/abc-def?x=1") == "https://meet.google.com", "origin extraction")

  // DownloadSummary round-trip & malformed/truncated resilience
  let dls : Array[DownloadSummary] = [
    DownloadSummary::{
      id: "dl-1",
      filename: "Farview-2.4-macOS-arm64.dmg",
      url: "https://releases.farview.dev/Farview-2.4-macOS-arm64.dmg",
      mime: "application/x-apple-diskimage",
      bytes: 14889779L,
      state: "completed", path: "" },
    DownloadSummary::{
      id: "dl-2",
      filename: "Q4 Architecture Review \"Final\".pdf",
      url: "https://docs.linear.app/q4-review.pdf",
      mime: "application/pdf",
      bytes: 1468006L,
      state: "in_progress", path: "" },
    DownloadSummary::{
      id: "dl-3",
      filename: "meeting-recording-2026.mp4",
      url: "https://meet.google.com/rec/2026.mp4",
      mime: "video/mp4",
      bytes: 253952L,
      state: "failed", path: "" },
    DownloadSummary::{
      id: "dl-4",
      filename: "archive.zip",
      url: "https://github.com/AFK-surf/farview/archive.zip",
      mime: "application/zip",
      bytes: 0L,
      state: "cancelled", path: "" },
  ]
  let encoded = encode_downloads_state(dls)
  let parsed = parse_downloads_state(encoded)
  debug_assert(parsed.length() == 4, "4 downloads parsed")
  debug_assert(parsed[0].id == "dl-1" && parsed[0].filename == "Farview-2.4-macOS-arm64.dmg" && parsed[0].bytes == 14889779L && parsed[0].state == "completed", "dl 0")
  debug_assert(parsed[1].filename == "Q4 Architecture Review \"Final\".pdf" && parsed[1].state == "in_progress", "dl 1 escaped")
  debug_assert(parsed[2].state == "failed" && download_state_label(parsed[2].state) == "Failed", "dl 2 failed")
  debug_assert(parsed[3].state == "cancelled" && download_state_label(parsed[3].state) == "Cancelled", "dl 3 cancelled")

  // Compatibility with page::downloads_json() schema (`name`/`size`)
  let host_dl = parse_downloads_state("[{\"name\":\"report.pdf\",\"path\":\"/tmp/report.pdf\",\"url\":\"https://example.com/report.pdf\",\"size\":253952}]")
  debug_assert(host_dl.length() == 1 && host_dl[0].filename == "report.pdf" && host_dl[0].bytes == 253952L && host_dl[0].state == "completed", "page::downloads_json alias")

  // Malformed / truncated resilience
  debug_assert(parse_downloads_state("").length() == 0, "empty")
  debug_assert(parse_downloads_state("[]").length() == 0, "empty array")
  debug_assert(parse_downloads_state("garbage").length() == 0, "garbage")
  debug_assert(parse_downloads_state("[{\"filename\":\"a.pdf\"").length() == 0, "truncated")

  // Human-readable file size formatting & extension badges
  debug_assert(format_download_bytes(-10L) == "0 B", "negative clamped to 0 B")
  debug_assert(format_download_bytes(0L) == "0 B", "0 B")
  debug_assert(format_download_bytes(512L) == "512 B", "512 B")
  debug_assert(format_download_bytes(253952L) == "248 KB", "248 KB")
  debug_assert(format_download_bytes(1468006L) == "1.4 MB", "1.4 MB")
  debug_assert(format_download_bytes(14889779L) == "14.2 MB", "14.2 MB")
  debug_assert(format_download_bytes(2684354560L) == "2.5 GB", "2.5 GB")
  debug_assert(download_ext_badge("Farview-2.4.dmg") == "DMG", "DMG badge")
  debug_assert(download_ext_badge("README") == "FILE", "no ext -> FILE")
}

test "arc favorites, MediaMiniState codec, Cmd/Ctrl+M mute shortcut, and command bar actions" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  debug_assert(dispatch_browser_shortcut(1109, cmd, true, false, false, false) is BrowserShortcut::ToggleMuteAudio, "Cmd+M")
  debug_assert(dispatch_browser_shortcut(1109, ctrl, false, false, false, false) is BrowserShortcut::ToggleMuteAudio, "Ctrl+M")

  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "2",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 4 },
      SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [],
    tabs: [
      TabSummary::{ id: "1", space_id: "work", title: "YouTube", url: "https://www.youtube.com/watch?v=live", pinned: false, favorite: true, active: false, state: "background", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "2", space_id: "work", title: "Google Meet", url: "https://meet.google.com/abc-defg-hij", pinned: false, favorite: true, active: true, state: "active", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "3", space_id: "personal", title: "X", url: "https://x.com/home", pinned: true, favorite: true, active: false, state: "background", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "4", space_id: "work", title: "Linear", url: "https://example.com/app", pinned: true, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "5", space_id: "work", title: "GitHub", url: "https://github.com/AFK-surf/farview", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 0L },
    ],
    permissions: None,
    closed_count: 0,
    media: Some(MediaMiniState::{
      tab_id: "2",
      title: "Design Review \"Live\"",
      host: "meet.google.com",
      playing: true,
      muted: true,
      is_meeting: true,
      accent: "#10B981",
    }),
    nav_back: [],
    nav_forward: [],
  }

  let encoded = encode_workspace_snapshot(snap)
  match parse_workspace_snapshot(encoded) {
    Some(got) => {
      let favs = workspace_favorite_tabs(got)
      debug_assert(favs.length() == 3 && favs[0].id == "1" && favs[1].id == "2" && favs[2].id == "3", "cross-space favorites")
      // Favorites must NEVER duplicate in PINNED or TODAY lists
      let pinned = workspace_tabs_for_space(got, "work", true)
      let today = workspace_tabs_for_space(got, "work", false)
      debug_assert(pinned.length() == 1 && pinned[0].id == "4", "favorite excluded from pinned")
      debug_assert(today.length() == 1 && today[0].id == "5", "favorite excluded from today")
      let pers_pinned = workspace_tabs_for_space(got, "personal", true)
      debug_assert(pers_pinned.length() == 0, "favorite with pinned=true excluded from personal pinned")
      match got.media {
        Some(m) => {
          debug_assert(m.tab_id == "2", "media tab_id")
          debug_assert(m.title == "Design Review \"Live\"", "media escaped title")
          debug_assert(m.host == "meet.google.com", "media host")
          debug_assert(m.playing && m.muted && m.is_meeting, "media flags")
          debug_assert(m.accent == "#10B981", "media accent")
        }
        None => debug_assert(false, "expected MediaMiniState")
      }
    }
    None => debug_assert(false, "parse_workspace_snapshot with favorites+media failed")
  }

  // Backward compatibility: legacy JSON without `favorite` or `media`
  let legacy = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"1\",\"spaces\":[{\"id\":\"work\",\"name\":\"Work\",\"accent\":\"#2563EB\",\"active\":true,\"tabCount\":1}],\"tabs\":[{\"id\":\"1\",\"spaceId\":\"work\",\"title\":\"Docs\",\"url\":\"https://example.com\",\"pinned\":false,\"active\":true,\"state\":\"active\"}]}"
  match parse_workspace_snapshot(legacy) {
    Some(ls) => {
      debug_assert(ls.tabs.length() == 1 && !ls.tabs[0].favorite, "legacy tab defaults favorite=false")
      debug_assert(ls.media.is_none(), "legacy snapshot defaults media=None")
    }
    None => debug_assert(false, "legacy snapshot parse failed")
  }

  // Command Bar actions: Toggle Mute Audio (⌘M / Ctrl+M) and Favorite / Unfavorite Active Tab
  let mute_items = build_command_bar_items(snap, "mute", "https://meet.google.com/abc", true)
  let mut found_mute = false
  for it in mute_items {
    if it.id == "toggle_mute_audio" {
      found_mute = true
      debug_assert(it.title == "Unmute audio", "muted state shows Unmute Audio")
      debug_assert(it.shortcut == "⌘M", "macOS shortcut ⌘M")
    }
  }
  debug_assert(found_mute, "command bar includes toggle_mute_audio")

  let fav_items = build_command_bar_items(snap, "favorite", "https://meet.google.com/abc", false)
  let mut found_fav = false
  for it in fav_items {
    if it.id == "favorite_tab" {
      found_fav = true
      debug_assert(it.title == "Remove from Favorites", "active favorite tab shows Remove from Favorites")
    }
  }
  debug_assert(found_fav, "command bar includes favorite_tab")
}

test "history drawer shortcut Cmd/Ctrl+Y, HistorySnapshot codec, format_history_age, space palette & command bar actions" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  debug_assert(dispatch_browser_shortcut(1121, cmd, true, false, false, false) is BrowserShortcut::ToggleHistory, "Cmd+Y")
  debug_assert(dispatch_browser_shortcut(1121, ctrl, false, false, false, false) is BrowserShortcut::ToggleHistory, "Ctrl+Y")
  // Non-primary or shifted must not trigger ToggleHistory
  debug_assert(dispatch_browser_shortcut(1121, cmd | SHORTCUT_MOD_SHIFT, true, false, false, false) is BrowserShortcut::None, "Cmd+Shift+Y ignored")

  let snap = HistorySnapshot::{
    query: "farview",
    total_count: 14,
    items: [
      HistoryItemSummary::{
        url: "https://github.com/AFK-surf/farview",
        title: "Farview \"Pure Pion\" Browser",
        host: "github.com",
        visit_count: 12,
        last_visit_secs: 1795493100L,
      },
      HistoryItemSummary::{
        url: "https://example.com/app/issue/FV-42",
        title: "Arc History Drawer & Space Themes",
        host: "linear.app",
        visit_count: 4,
        last_visit_secs: 1795489500L,
      },
    ],
  }
  let encoded = encode_history_snapshot(snap)
  match parse_history_snapshot(encoded) {
    Some(got) => {
      debug_assert(got.query == "farview", "history query round-trip")
      debug_assert(got.total_count == 14, "history total_count round-trip")
      debug_assert(got.items.length() == 2, "history items length")
      debug_assert(got.items[0].url == "https://github.com/AFK-surf/farview", "item 0 url")
      debug_assert(got.items[0].title == "Farview \"Pure Pion\" Browser", "item 0 escaped title")
      debug_assert(got.items[0].host == "github.com", "item 0 host")
      debug_assert(got.items[0].visit_count == 12, "item 0 visit_count")
      debug_assert(got.items[0].last_visit_secs == 1795493100L, "item 0 last_visit_secs")
      debug_assert(got.items[1].host == "linear.app" && got.items[1].visit_count == 4, "item 1")
    }
    None => debug_assert(false, "parse_history_snapshot round-trip failed")
  }

  // Snake_case compatibility and malformed / truncated resilience
  let snake = "{\"query\":\"\",\"total_count\":1,\"items\":[{\"url\":\"https://example.com/docs\",\"title\":\"Docs\",\"visit_count\":3,\"last_visit_secs\":1795400000}]}"
  match parse_history_snapshot(snake) {
    Some(got) => {
      debug_assert(got.total_count == 1 && got.items.length() == 1, "snake_case history")
      debug_assert(got.items[0].host == "example.com" && got.items[0].visit_count == 3, "derived host")
    }
    None => debug_assert(false, "snake_case history parse failed")
  }
  debug_assert(parse_history_snapshot("").is_none(), "empty history json -> None")
  debug_assert(parse_history_snapshot("not-json").is_none(), "garbage history json -> None")
  debug_assert(parse_history_snapshot("{\"query\":\"a\",\"items\":[{\"url\":\"https://a.com\"").is_none(), "truncated history json -> None")

  // Relative timestamp formatting
  // 2026-11-24T12:00:00Z = 1795521600
  let now : Int64 = 1795521600L
  debug_assert(format_history_age(0L, now) == "", "zero timestamp")
  debug_assert(format_history_age(now - 15L, now) == "Just now", "15s -> Just now")
  debug_assert(format_history_age(now + 10L, now) == "Just now", "future skew -> Just now")
  debug_assert(format_history_age(now - 720L, now) == "12m ago", "12m ago")
  debug_assert(format_history_age(now - 10800L, now) == "3h ago", "3h ago")
  debug_assert(format_history_age(now - 100000L, now) == "Yesterday", "Yesterday")
  // 4 days before 2026-11-24T12:00:00Z = 2026-11-20T12:00:00Z
  debug_assert(format_history_age(now - 4L * 86400L, now) == "Nov 20", "Nov 20")

  // Space theme palette validation
  debug_assert(workspace_space_palette().length() == 6, "6 standard Arc colors")
  debug_assert(normalize_space_accent("#8b5cf6") == "#8B5CF6", "hex normalized uppercase")
  debug_assert(normalize_space_accent("10b981") == "#10B981", "missing # normalized")
  debug_assert(normalize_space_accent("bad-hex") == "#2563EB", "invalid hex falls back to blue")

  // Command Bar actions: Browsing History (⌘Y / Ctrl+Y) and Customize Space Theme
  let ws = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "1",
    spaces: [SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 1 }],
    folders: [],
    tabs: [TabSummary::{ id: "1", space_id: "work", title: "Docs", url: "https://example.com", pinned: false, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 0L }],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
  let h_mac = build_command_bar_items(ws, "history", "https://example.com", true)
  let mut found_hist = false
  for it in h_mac {
    if it.id == "history" {
      found_hist = true
      debug_assert(it.title == "Browsing history" && it.shortcut == "⌘Y", "macOS Browsing History ⌘Y")
    }
  }
  debug_assert(found_hist, "command bar includes Browsing History")

  let h_win = build_command_bar_items(ws, "history", "https://example.com", false)
  let mut found_hist_win = false
  for it in h_win {
    if it.id == "history" && it.shortcut == "Ctrl+Y" {
      found_hist_win = true
    }
  }
  debug_assert(found_hist_win, "non-macOS Browsing History Ctrl+Y")

  let th_items = build_command_bar_items(ws, "theme", "https://example.com", true)
  let mut found_theme = false
  for it in th_items {
    if it.id == "space_theme" && it.title == "Customize Space theme" {
      found_theme = true
    }
  }
  debug_assert(found_theme, "command bar includes Customize Space Theme")
}

test "Arc shortcuts (Cmd/Ctrl+Shift+C, Cmd/Ctrl+/), Pinned folders JSON codec, and Command Bar actions" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  let shift = SHORTCUT_MOD_SHIFT

  // Cmd/Ctrl+Shift+C -> CopyCurrentUrl; plain Cmd/Ctrl+C remains untouched (None)
  debug_assert(dispatch_browser_shortcut(1099, cmd | shift, true, false, false, false) is BrowserShortcut::CopyCurrentUrl, "Cmd+Shift+C")
  debug_assert(dispatch_browser_shortcut(1067, ctrl | shift, false, false, false, false) is BrowserShortcut::CopyCurrentUrl, "Ctrl+Shift+C")
  debug_assert(dispatch_browser_shortcut(1099, cmd, true, false, false, false) is BrowserShortcut::None, "plain Cmd+C untouched")

  // Cmd/Ctrl+/ -> ToggleShortcuts
  debug_assert(dispatch_browser_shortcut(1047, cmd, true, false, false, false) is BrowserShortcut::ToggleShortcuts, "Cmd+/")
  debug_assert(dispatch_browser_shortcut(1047, ctrl, false, false, false, false) is BrowserShortcut::ToggleShortcuts, "Ctrl+/")

  // WorkspaceSnapshot with Pinned folders round-trip & filtering helpers
  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "2",
    spaces: [SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 3 }],
    folders: [
      FolderSummary::{ id: "f-docs", space_id: "work", name: "Docs", collapsed: false, color: "blue" },
      FolderSummary::{ id: "f-refs", space_id: "work", name: "References", collapsed: true, color: "emerald" },
    ],
    tabs: [
      TabSummary::{ id: "1", space_id: "work", title: "Pion Guide", url: "https://pion.dev/guide", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-docs", last_active_secs: 0L },
      TabSummary::{ id: "2", space_id: "work", title: "Linear", url: "https://linear.app", pinned: true, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 0L },
      TabSummary::{ id: "3", space_id: "work", title: "GitHub", url: "https://github.com", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 0L },
    ],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
  let encoded = encode_workspace_snapshot(snap)
  let decoded = match parse_workspace_snapshot(encoded) {
    Some(v) => v
    None => panic("parse_workspace_snapshot failed")
  }
  debug_assert(decoded.folders.length() == 2, "2 folders decoded")
  debug_assert(decoded.folders[0].id == "f-docs" && !decoded.folders[0].collapsed, "f-docs expanded")
  debug_assert(decoded.folders[1].id == "f-refs" && decoded.folders[1].collapsed, "f-refs collapsed")
  debug_assert(workspace_tabs_in_folder(decoded, "work", "f-docs").length() == 1, "1 tab in f-docs")
  debug_assert(workspace_unfoldered_pinned_tabs(decoded, "work").length() == 1, "1 unfoldered pinned tab")
  debug_assert(workspace_folder_name(decoded, "f-refs") == "References", "folder name lookup")
  debug_assert(next_auto_folder_name(decoded, "work") == "Projects", "skips Docs, picks Projects")

  // Legacy JSON without folders/folderId parses cleanly
  let legacy_json = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"1\",\"spaces\":[{\"id\":\"work\",\"name\":\"Work\",\"accent\":\"#2563EB\",\"active\":true,\"tabCount\":1}],\"tabs\":[{\"id\":\"1\",\"spaceId\":\"work\",\"title\":\"Docs\",\"url\":\"https://example.com\",\"pinned\":true,\"favorite\":false,\"active\":true,\"state\":\"active\"}],\"closedCount\":0}"
  let legacy_dec = match parse_workspace_snapshot(legacy_json) {
    Some(v) => v
    None => panic("legacy parse failed")
  }
  debug_assert(legacy_dec.folders.length() == 0 && legacy_dec.tabs[0].folder_id == "", "legacy defaults empty")

  // Command Bar actions: Copy Current URL (⇧⌘C), New Pinned Folder, Keyboard Shortcuts (⌘/)
  let copy_items = build_command_bar_items(decoded, "copy", "https://linear.app", true)
  let mut found_copy = false
  for it in copy_items {
    if it.id == "copy_url" && it.shortcut == "⇧⌘C" {
      found_copy = true
    }
  }
  debug_assert(found_copy, "Command Bar Copy Current URL has ⇧⌘C")

  let sc_items = build_command_bar_items(decoded, "shortcuts", "https://linear.app", true)
  let mut found_sc = false
  for it in sc_items {
    if it.id == "shortcuts" && it.shortcut == "⌘/" {
      found_sc = true
    }
  }
  debug_assert(found_sc, "Command Bar Keyboard Shortcuts has ⌘/")

  let fl_items = build_command_bar_items(decoded, "folder", "https://linear.app", true)
  let mut found_fl = false
  for it in fl_items {
    if it.id == "new_folder" && it.title == "New tab folder" {
      found_fl = true
    }
  }
  debug_assert(found_fl, "Command Bar includes New Tab Folder")
}

test "Arc Split View shortcut (Cmd/Ctrl+Shift+\\), Command Bar actions, ratio clamp & narrow protection" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  let shift = SHORTCUT_MOD_SHIFT

  // Cmd/Ctrl+Shift+\ (1092) and shifted | (1124) -> ToggleSplitView
  debug_assert(dispatch_browser_shortcut(1092, cmd | shift, true, false, false, false) is BrowserShortcut::ToggleSplitView, "Cmd+Shift+\\")
  debug_assert(dispatch_browser_shortcut(1124, cmd | shift, true, false, false, false) is BrowserShortcut::ToggleSplitView, "Cmd+Shift+|")
  debug_assert(dispatch_browser_shortcut(1092, ctrl | shift, false, false, false, false) is BrowserShortcut::ToggleSplitView, "Ctrl+Shift+\\")
  debug_assert(dispatch_browser_shortcut(1124, ctrl | shift, false, false, false, false) is BrowserShortcut::ToggleSplitView, "Ctrl+Shift+|")
  // Plain Cmd/Ctrl+\ without Shift remains None
  debug_assert(dispatch_browser_shortcut(1092, cmd, true, false, false, false) is BrowserShortcut::None, "plain Cmd+\\ untouched")
  debug_assert(dispatch_browser_shortcut(1092, ctrl, false, false, false, false) is BrowserShortcut::None, "plain Ctrl+\\ untouched")

  // Ratio clamping & drag calculation
  debug_assert((clamp_split_ratio(0.5) - 0.5).abs() < 1.0e-6, "default ratio 0.5")
  debug_assert((clamp_split_ratio(0.1) - SPLIT_RATIO_MIN).abs() < 1.0e-6, "clamp min 0.25")
  debug_assert((clamp_split_ratio(0.95) - SPLIT_RATIO_MAX).abs() < 1.0e-6, "clamp max 0.75")
  debug_assert((clamp_split_ratio(0.0 / 0.0) - SPLIT_RATIO_DEFAULT).abs() < 1.0e-6, "NaN resets to 0.5")

  // Drag delta math
  let r1 = split_ratio_from_drag(0.5, 100.0, 1006.0)
  debug_assert((r1 - 0.6).abs() < 1.0e-6, "drag +100px over 1000avail -> 0.6")
  let r2 = split_ratio_from_drag(0.5, -400.0, 1006.0)
  debug_assert((r2 - 0.25).abs() < 1.0e-6, "drag clamp min 0.25")

  // Pane widths & narrow-window protection
  let (lw0, rw0) = split_pane_widths(1006.0, 0.5)
  debug_assert((lw0 - 500.0).abs() < 1.0e-6 && (rw0 - 500.0).abs() < 1.0e-6, "50/50 split on 1006px")
  // On 606px total (600px avail), 0.25 would be 150px < 240px min -> clamped to 240 / 360
  let (lw1, rw1) = split_pane_widths(606.0, 0.25)
  debug_assert((lw1 - 240.0).abs() < 1.0e-6 && (rw1 - 360.0).abs() < 1.0e-6, "narrow protection clamps left to 240")
  // Very narrow 406px total (400px avail < 480px) -> 35% floor = 140 / 260
  let (lw2, rw2) = split_pane_widths(406.0, 0.25)
  debug_assert((lw2 - 140.0).abs() < 1.0e-6 && (rw2 - 260.0).abs() < 1.0e-6, "very narrow window uses 35% floor")
  debug_assert(split_other_pane(0) == 1 && split_other_pane(1) == 0, "other pane toggles")

  // Pane header display helpers
  debug_assert(split_pane_display_title("Farview Docs", "https://docs.farview.dev") == "Farview Docs", "uses title when present")
  debug_assert(split_pane_display_title("", "https://docs.farview.dev/api") == "docs.farview.dev", "falls back to host")
  debug_assert(split_pane_display_title("", "") == "Split Pane", "empty fallback")
  debug_assert(split_pane_display_host("https://github.com/AFK-surf/farview") == "github.com", "host extraction")

  // Command Bar actions: Open Split View (⇧⌘\ / Ctrl+Shift+\), Swap Split Panes, Close Split View
  let ws = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "1",
    spaces: [SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 1 }],
    folders: [],
    tabs: [TabSummary::{ id: "1", space_id: "work", title: "Docs", url: "https://example.com", pinned: false, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 0L }],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
  let sp_mac = build_command_bar_items(ws, "split", "https://example.com", true)
  let mut found_open = false
  let mut found_swap = false
  let mut found_close = false
  for it in sp_mac {
    if it.id == "toggle_split_view" && it.title == "Open split view" && it.shortcut == "⇧⌘\\" {
      found_open = true
    }
    if it.id == "swap_split_panes" && it.title == "Swap split panes" {
      found_swap = true
    }
    if it.id == "close_split_view" && it.title == "Close split view" {
      found_close = true
    }
  }
  debug_assert(found_open, "Command Bar includes Open Split View (⇧⌘\\)")
  debug_assert(found_swap, "Command Bar includes Swap Split Panes")
  debug_assert(found_close, "Command Bar includes Close Split View")

  let sp_linux = build_command_bar_items(ws, "split", "https://example.com", false)
  let mut found_open_linux = false
  for it in sp_linux {
    if it.id == "toggle_split_view" && it.shortcut == "Ctrl+Shift+\\" {
      found_open_linux = true
    }
  }
  debug_assert(found_open_linux, "Linux Command Bar includes Ctrl+Shift+\\")
}

test "Arc Peek shortcut (Cmd/Ctrl+Shift+P), Command Bar action, and navBack/navForward JSON codec" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  let shift = SHORTCUT_MOD_SHIFT

  // Cmd/Ctrl+Shift+P -> TogglePeek; plain Cmd/Ctrl+P -> PrintPdf (no conflict)
  debug_assert(dispatch_browser_shortcut(1112, cmd | shift, true, false, false, false) is BrowserShortcut::TogglePeek, "Cmd+Shift+P")
  debug_assert(dispatch_browser_shortcut(1080, cmd | shift, true, false, false, false) is BrowserShortcut::TogglePeek, "Cmd+Shift+P uppercase")
  debug_assert(dispatch_browser_shortcut(1112, ctrl | shift, false, false, false, false) is BrowserShortcut::TogglePeek, "Ctrl+Shift+P")
  debug_assert(dispatch_browser_shortcut(1080, ctrl | shift, false, false, false, false) is BrowserShortcut::TogglePeek, "Ctrl+Shift+P uppercase")
  debug_assert(dispatch_browser_shortcut(1112, cmd, true, false, false, false) is BrowserShortcut::PrintPdf, "plain Cmd+P -> PrintPdf")
  debug_assert(dispatch_browser_shortcut(1112, ctrl, false, false, false, false) is BrowserShortcut::PrintPdf, "plain Ctrl+P -> PrintPdf")

  // WorkspaceSnapshot with navBack & navForward round-trip
  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "2",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 2 },
      SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [],
    tabs: [
      TabSummary::{ id: "2", space_id: "work", title: "Farview Spec", url: "https://docs.farview.dev/spec", pinned: false, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 0L },
    ],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [
      NavHistoryEntry::{ index: 1, title: "Architecture \"v2\"", url: "https://docs.farview.dev/arch" },
      NavHistoryEntry::{ index: 0, title: "", url: "https://github.com/AFK-surf/farview" },
    ],
    nav_forward: [
      NavHistoryEntry::{ index: 3, title: "Release Notes", url: "https://docs.farview.dev/releases" },
    ],
  }
  let encoded = encode_workspace_snapshot(snap)
  let decoded = match parse_workspace_snapshot(encoded) {
    Some(v) => v
    None => panic("parse_workspace_snapshot with navBack/navForward failed")
  }
  debug_assert(decoded.nav_back.length() == 2, "2 nav_back entries")
  debug_assert(decoded.nav_back[0].index == 1 && decoded.nav_back[0].title == "Architecture \"v2\"", "nav_back[0] escaped title")
  debug_assert(decoded.nav_back[1].index == 0 && nav_entry_display_title(decoded.nav_back[1]) == "github.com", "nav_back[1] host fallback")
  debug_assert(decoded.nav_forward.length() == 1 && decoded.nav_forward[0].index == 3 && decoded.nav_forward[0].title == "Release Notes", "nav_forward[0]")

  // Backward compatibility: legacy JSON without navBack / navForward defaults to empty arrays
  let legacy = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"2\",\"spaces\":[],\"tabs\":[]}"
  match parse_workspace_snapshot(legacy) {
    Some(ls) => {
      debug_assert(ls.nav_back.length() == 0 && ls.nav_forward.length() == 0, "legacy defaults empty nav stacks")
    }
    None => debug_assert(false, "legacy parse failed")
  }

  // Command Bar includes Open Peek Preview (⇧⌘P / Ctrl+Shift+P)
  let pk_mac = build_command_bar_items(decoded, "peek", "https://docs.farview.dev/spec", true)
  let mut found_peek_mac = false
  for it in pk_mac {
    if it.id == "toggle_peek" && it.title == "Open Peek preview" && it.shortcut == "⇧⌘P" {
      found_peek_mac = true
    }
  }
  debug_assert(found_peek_mac, "macOS Command Bar includes Open Peek Preview (⇧⌘P)")

  let pk_linux = build_command_bar_items(decoded, "peek", "https://docs.farview.dev/spec", false)
  let mut found_peek_linux = false
  for it in pk_linux {
    if it.id == "toggle_peek" && it.title == "Open Peek preview" && it.shortcut == "Ctrl+Shift+P" {
      found_peek_linux = true
    }
  }
  debug_assert(found_peek_linux, "Linux Command Bar includes Open Peek Preview (Ctrl+Shift+P)")
}

test "MRU switcher shortcuts, PrintPdf, ToggleTabFilter, lastActiveSecs codec, MRU sort & sidebar filter" {
  let cmd = SHORTCUT_MOD_CMD
  let ctrl = SHORTCUT_MOD_CTRL
  let shift = SHORTCUT_MOD_SHIFT

  // Ctrl+Tab (+1) & Ctrl+Shift+Tab (-1) on both macOS and Linux
  match dispatch_browser_shortcut(KEY_TAB, ctrl, true, false, false, false) {
    BrowserShortcut::TabSwitchMru(d) => debug_assert(d == 1, "macOS Ctrl+Tab -> +1")
    _ => debug_assert(false, "expected TabSwitchMru(+1) on macOS")
  }
  match dispatch_browser_shortcut(KEY_TAB, ctrl | shift, true, false, false, false) {
    BrowserShortcut::TabSwitchMru(d) => debug_assert(d == -1, "macOS Ctrl+Shift+Tab -> -1")
    _ => debug_assert(false, "expected TabSwitchMru(-1) on macOS")
  }
  match dispatch_browser_shortcut(KEY_TAB, ctrl, false, false, false, false) {
    BrowserShortcut::TabSwitchMru(d) => debug_assert(d == 1, "Linux Ctrl+Tab -> +1")
    _ => debug_assert(false, "expected TabSwitchMru(+1) on Linux")
  }
  match dispatch_browser_shortcut(KEY_TAB, ctrl | shift, false, false, false, false) {
    BrowserShortcut::TabSwitchMru(d) => debug_assert(d == -1, "Linux Ctrl+Shift+Tab -> -1")
    _ => debug_assert(false, "expected TabSwitchMru(-1) on Linux")
  }
  // Plain Tab without Ctrl must stay None
  debug_assert(dispatch_browser_shortcut(KEY_TAB, 0, true, false, false, false) is BrowserShortcut::None, "plain Tab untouched")

  // Cmd/Ctrl+Shift+A -> ToggleTabFilter; plain Cmd/Ctrl+A remains None (Select All)
  debug_assert(dispatch_browser_shortcut(1097, cmd | shift, true, false, false, false) is BrowserShortcut::ToggleTabFilter, "Cmd+Shift+A")
  debug_assert(dispatch_browser_shortcut(1065, cmd | shift, true, false, false, false) is BrowserShortcut::ToggleTabFilter, "Cmd+Shift+A uppercase")
  debug_assert(dispatch_browser_shortcut(1097, ctrl | shift, false, false, false, false) is BrowserShortcut::ToggleTabFilter, "Ctrl+Shift+A")
  debug_assert(dispatch_browser_shortcut(1097, cmd, true, false, false, false) is BrowserShortcut::None, "plain Cmd+A untouched")
  debug_assert(dispatch_browser_shortcut(1097, ctrl, false, false, false, false) is BrowserShortcut::None, "plain Ctrl+A untouched")

  // WorkspaceSnapshot lastActiveSecs round-trip + backward compatibility
  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "t2",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 4 },
      SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [
      FolderSummary::{ id: "f-docs", space_id: "work", name: "Docs", collapsed: true, color: "blue" },
      FolderSummary::{ id: "f-ops", space_id: "work", name: "Ops", collapsed: true, color: "violet" },
    ],
    tabs: [
      TabSummary::{ id: "t1", space_id: "work", title: "Linear Roadmap", url: "https://tracker.example.org/app", pinned: true, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 1000L },
      TabSummary::{ id: "t2", space_id: "work", title: "Farview Spec", url: "https://docs.farview.dev/spec", pinned: false, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 3000L },
      TabSummary::{ id: "t3", space_id: "work", title: "Pion Guide", url: "https://pion.dev/guide", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-docs", last_active_secs: 2500L },
      TabSummary::{ id: "t4", space_id: "work", title: "Grafana Alerts", url: "https://ops.example.com/alerts", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-ops", last_active_secs: 1500L },
      TabSummary::{ id: "t5", space_id: "personal", title: "YouTube", url: "https://youtube.com", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 9999L },
    ],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
  let enc = encode_workspace_snapshot(snap)
  let dec = match parse_workspace_snapshot(enc) {
    Some(v) => v
    None => panic("parse_workspace_snapshot with lastActiveSecs failed")
  }
  debug_assert(dec.tabs.length() == 5, "5 tabs decoded")
  debug_assert(dec.tabs[0].last_active_secs == 1000L && dec.tabs[1].last_active_secs == 3000L && dec.tabs[2].last_active_secs == 2500L, "lastActiveSecs preserved")

  // Backward compat: JSON without lastActiveSecs defaults to 0L
  let legacy_json = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"1\",\"spaces\":[],\"tabs\":[{\"id\":\"1\",\"spaceId\":\"work\",\"title\":\"Old\",\"url\":\"https://old.example.com\",\"pinned\":false,\"favorite\":false,\"active\":true,\"state\":\"active\"}]}"
  match parse_workspace_snapshot(legacy_json) {
    Some(ls) => debug_assert(ls.tabs.length() == 1 && ls.tabs[0].last_active_secs == 0L, "legacy tab defaults last_active_secs to 0")
    None => debug_assert(false, "legacy json without lastActiveSecs should parse")
  }

  // MRU ordering in active space ("work"): t2 (3000) > t3 (2500) > t4 (1500) > t1 (1000)
  let mru = workspace_mru_tabs(dec, "work")
  debug_assert(mru.length() == 4, "4 tabs in work space")
  debug_assert(mru[0].id == "t2" && mru[1].id == "t3" && mru[2].id == "t4" && mru[3].id == "t1", "MRU descending order")

  // Sidebar tab filtering & folder matching
  let filtered_pion = workspace_filter_tabs(mru, "pion")
  debug_assert(filtered_pion.length() == 1 && filtered_pion[0].id == "t3", "filter by title/url matches t3")
  let filtered_host = workspace_filter_tabs(mru, "tracker.example.org")
  debug_assert(filtered_host.length() == 1 && filtered_host[0].id == "t1", "filter by domain matches t1")
  let filtered_none = workspace_filter_tabs(mru, "zzzz-no-match")
  debug_assert(filtered_none.length() == 0, "no match yields empty array")
  let matched_folders = workspace_filtered_folders(dec, "work", "pion")
  debug_assert(matched_folders.length() == 1 && matched_folders[0].id == "f-docs", "collapsed folder matched by child tab")

  // Command Bar includes Save Page as PDF (⌘P / Ctrl+P)
  let pdf_mac = build_command_bar_items(dec, "pdf", "https://docs.farview.dev/spec", true)
  let mut found_pdf_mac = false
  for it in pdf_mac {
    if it.id == "export_pdf" && it.title == "Save page as PDF" && it.shortcut == "⌘P" {
      found_pdf_mac = true
    }
  }
  debug_assert(found_pdf_mac, "macOS Command Bar includes Save Page as PDF (⌘P)")
  let pdf_linux = build_command_bar_items(dec, "pdf", "https://docs.farview.dev/spec", false)
  let mut found_pdf_linux = false
  for it in pdf_linux {
    if it.id == "export_pdf" && it.title == "Save page as PDF" && it.shortcut == "Ctrl+P" {
      found_pdf_linux = true
    }
  }
  debug_assert(found_pdf_linux, "Linux Command Bar includes Save Page as PDF (Ctrl+P)")
}

test "DevTools shortcuts (Cmd+Opt+I, Ctrl+Shift+I, F12), Command Bar, and DevToolsSnapshot codec" {
  // macOS Cmd+Opt+I -> ToggleDevTools
  match dispatch_browser_shortcut(1105, SHORTCUT_MOD_CMD | SHORTCUT_MOD_ALT, true, false, false, false) {
    BrowserShortcut::ToggleDevTools => ()
    _ => debug_assert(false, "macOS Cmd+Opt+I should map to ToggleDevTools")
  }
  // Linux/Win Ctrl+Shift+I -> ToggleDevTools
  match dispatch_browser_shortcut(1105, SHORTCUT_MOD_CTRL | SHORTCUT_MOD_SHIFT, false, false, false, false) {
    BrowserShortcut::ToggleDevTools => ()
    _ => debug_assert(false, "Linux Ctrl+Shift+I should map to ToggleDevTools")
  }
  // F12 across macOS / Win / X11 -> ToggleDevTools
  match dispatch_browser_shortcut(KEY_F12_MAC, 0, true, false, false, false) {
    BrowserShortcut::ToggleDevTools => ()
    _ => debug_assert(false, "macOS F12 should map to ToggleDevTools")
  }
  match dispatch_browser_shortcut(KEY_F12_WIN, 0, false, false, false, false) {
    BrowserShortcut::ToggleDevTools => ()
    _ => debug_assert(false, "Win F12 should map to ToggleDevTools")
  }
  match dispatch_browser_shortcut(KEY_F12_X11, 0, false, false, false, false) {
    BrowserShortcut::ToggleDevTools => ()
    _ => debug_assert(false, "X11 F12 should map to ToggleDevTools")
  }
  // Plain Cmd+I on macOS stays ToggleSiteInfo
  match dispatch_browser_shortcut(1105, SHORTCUT_MOD_CMD, true, false, false, false) {
    BrowserShortcut::ToggleSiteInfo => ()
    _ => debug_assert(false, "macOS Cmd+I should remain ToggleSiteInfo")
  }

  // Height clamping & drag math
  debug_assert(clamp_devtools_height(100.0) == DEVTOOLS_HEIGHT_MIN, "clamp min")
  debug_assert(clamp_devtools_height(640.0) == DEVTOOLS_HEIGHT_MAX, "clamp max")
  debug_assert(devtools_height_from_drag(290.0, -50.0) == 340.0, "drag up increases height")
  debug_assert(devtools_height_from_drag(290.0, 60.0) == 230.0, "drag down decreases height")

  // Color swatch & byte formatting
  match parse_devtools_color_swatch("#2563EB") {
    Some(c) => debug_assert(c == 0x2563EBFFL, "hex swatch")
    None => debug_assert(false, "hex swatch should parse")
  }
  match parse_devtools_color_swatch("rgb(16, 185, 129)") {
    Some(c) => debug_assert(c == 0x10B981FFL, "rgb swatch")
    None => debug_assert(false, "rgb swatch should parse")
  }
  debug_assert(parse_devtools_color_swatch("rgba(0, 0, 0, 0)") is None, "transparent rgba returns None")
  debug_assert(format_devtools_bytes(840) == "840 B", "bytes fmt")
  debug_assert(format_devtools_bytes(1536) == "1.5 KB", "kb fmt")

  // Command Bar includes Toggle DevTools
  let empty_ws = WorkspaceSnapshot::empty()
  let dt_mac = build_command_bar_items(empty_ws, "devtools", "https://docs.farview.dev", true)
  let mut found_mac = false
  for it in dt_mac {
    if it.id == "toggle_devtools" && it.title == "Developer tools" && it.shortcut == "⌥⌘I" {
      found_mac = true
    }
  }
  debug_assert(found_mac, "macOS Command Bar includes Toggle DevTools (⌥⌘I)")
  let dt_lin = build_command_bar_items(empty_ws, "devtools", "https://docs.farview.dev", false)
  let mut found_lin = false
  for it in dt_lin {
    if it.id == "toggle_devtools" && it.title == "Developer tools" && it.shortcut == "Ctrl+Shift+I" {
      found_lin = true
    }
  }
  debug_assert(found_lin, "Linux Command Bar includes Toggle DevTools (Ctrl+Shift+I)")

  // DevToolsSnapshot JSON encode/decode round-trip + backward compat + malformed rejection
  let snap = DevToolsSnapshot::{
    page_url: "https://farview.dev/demo",
    page_title: "Farview Demo",
    selected_path: "0.1.0",
    nodes: [
      DevToolsDomNode::{
        path: "0",
        depth: 0,
        tag: "html",
        id_attr: "",
        class_attr: "",
        attrs: [DevToolsAttr::{ name: "lang", value: "en" }],
        text_preview: "",
        child_count: 2,
      },
      DevToolsDomNode::{
        path: "0.1.0",
        depth: 2,
        tag: "div",
        id_attr: "hero",
        class_attr: "card active",
        attrs: [DevToolsAttr::{ name: "data-role", value: "banner" }],
        text_preview: "Hello Farview",
        child_count: 3,
      },
    ],
    box_model: DevToolsBoxModel::{
      width: 640.0,
      height: 184.5,
      pad_top: 16.0,
      pad_right: 20.0,
      pad_bottom: 16.0,
      pad_left: 20.0,
      border_top: 1.0,
      border_right: 1.0,
      border_bottom: 1.0,
      border_left: 1.0,
      margin_top: 0.0,
      margin_right: 0.0,
      margin_bottom: 12.0,
      margin_left: 0.0,
    },
    styles: [
      DevToolsStyleProp::{ name: "display", value: "flex", color_hex: "" },
      DevToolsStyleProp::{ name: "color", value: "rgb(15, 23, 42)", color_hex: "rgb(15, 23, 42)" },
      DevToolsStyleProp::{ name: "background-color", value: "rgb(255, 255, 255)", color_hex: "rgb(255, 255, 255)" },
    ],
    console_entries: [
      DevToolsConsoleEntry::{ id: 1, level: "log", text: "boot ok", source: "page" },
      DevToolsConsoleEntry::{ id: 2, level: "input", text: "21 * 2", source: "REPL" },
      DevToolsConsoleEntry::{ id: 3, level: "result", text: "42", source: "number" },
    ],
    network_entries: [
      DevToolsNetworkEntry::{ name: "demo", url: "https://farview.dev/demo", kind: "document", status: 200, duration_ms: 14, size_bytes: 4096 },
      DevToolsNetworkEntry::{ name: "app.js", url: "https://farview.dev/app.js", kind: "script", status: 200, duration_ms: 8, size_bytes: 2048 },
    ],
  }
  let enc = encode_devtools_snapshot(snap)
  let dec = match parse_devtools_snapshot(enc) {
    Some(v) => v
    None => panic("parse_devtools_snapshot round-trip failed")
  }
  debug_assert(dec.page_url == "https://farview.dev/demo" && dec.selected_path == "0.1.0", "meta preserved")
  debug_assert(dec.nodes.length() == 2 && dec.nodes[1].id_attr == "hero" && dec.nodes[1].class_attr == "card active", "nodes preserved")
  debug_assert(dec.box_model.width == 640.0 && dec.box_model.height == 184.5 && dec.box_model.pad_left == 20.0, "box model preserved")
  debug_assert(dec.styles.length() == 3 && dec.styles[1].name == "color", "styles preserved")
  debug_assert(dec.console_entries.length() == 3 && dec.console_entries[2].text == "42", "console preserved")
  debug_assert(dec.network_entries.length() == 2 && devtools_network_summary(dec.network_entries) == "2 requests · 6.0 KB", "network summary")

  // Backward compat: minimal JSON with unknown fields
  let legacy = "{\"url\":\"https://example.com\",\"extraField\":[1,2,3]}"
  match parse_devtools_snapshot(legacy) {
    Some(ls) => debug_assert(ls.page_url == "https://example.com" && ls.nodes.length() == 0, "minimal compat")
    None => debug_assert(false, "minimal devtools json should parse")
  }
  // Truncated/malformed rejected safely
  debug_assert(parse_devtools_snapshot("{\"url\":\"x\",\"nodes\":[{\"tag\":\"div\"") is None, "truncated rejected")
  debug_assert(parse_devtools_snapshot("not json") is None, "malformed rejected")
}

test "bookmarks_ui codec, truncation resilience, filtering, and rank_omnibox_suggestions" {
  let snap = BookmarksSnapshot::{
    items: [
      BookmarkEntry::{
        id: "bm-1",
        title: "GitHub — \"Farview\" Engine",
        url: "https://github.com/AFK-surf/farview",
        folder: "Engineering",
        created_ms: 1795503600000L,
      },
      BookmarkEntry::{
        id: "bm-2",
        title: "Linear Roadmap",
        url: "https://linear.app/roadmap/",
        folder: "Work",
        created_ms: 1795503500000L,
      },
    ],
  }
  let encoded = encode_bookmarks_snapshot(snap)
  match parse_bookmarks_snapshot(encoded) {
    Some(dec) => {
      debug_assert(dec.items.length() == 2, "expected 2 bookmarks")
      debug_assert(dec.items[0].id == "bm-1", "bm-1 id")
      debug_assert(dec.items[0].title == "GitHub — \"Farview\" Engine", "bm-1 escaped title")
      debug_assert(dec.items[0].folder == "Engineering", "bm-1 folder")
      debug_assert(dec.items[0].created_ms == 1795503600000L, "bm-1 created_ms")
      debug_assert(bookmarks_contains_url(dec, "https://linear.app/roadmap"), "canonical trailing slash match")
      debug_assert(bookmarks_contains_url(dec, "HTTPS://GITHUB.COM/AFK-SURF/FARVIEW/"), "case-insensitive canonical match")
      debug_assert(!bookmarks_contains_url(dec, "https://example.com"), "non-bookmarked URL")
      let filtered = bookmarks_filter(dec, "eng")
      debug_assert(filtered.length() == 1 && filtered[0].id == "bm-1", "filter matches title/folder")
    }
    None => debug_assert(false, "parse_bookmarks_snapshot failed")
  }
  // Truncated / malformed resilience
  debug_assert(parse_bookmarks_snapshot("").is_none(), "empty json")
  debug_assert(parse_bookmarks_snapshot("{\"items\":[{\"id\":\"bm-1\"").is_none(), "truncated json")
  debug_assert(parse_bookmarks_snapshot("[]").is_none(), "array instead of object")

  // Omnibox unified ranking across SwitchTab, Bookmark, History, DirectUrl, Search
  let tabs : Array[TabSummary] = [
    TabSummary::{
      id: "t-1",
      space_id: "work",
      title: "Current Active Page",
      url: "https://farview.dev/docs",
      pinned: false,
      favorite: false,
      folder_id: "",
      active: true,
      last_active_secs: 100L,
    },
    TabSummary::{
      id: "t-2",
      space_id: "work",
      title: "GitHub Pull Requests",
      url: "https://github.com/AFK-surf/farview/pulls",
      pinned: true,
      favorite: false,
      folder_id: "",
      active: false,
      last_active_secs: 90L,
    },
  ]
  let hist : Array[HistoryItemSummary] = [
    HistoryItemSummary::{
      url: "https://github.com/AFK-surf/farview/pulls",
      title: "GitHub Pull Requests",
      host: "github.com",
      visit_count: 14,
      last_visit_secs: 1795500000L,
    },
    HistoryItemSummary::{
      url: "https://github.com/AFK-surf/invar",
      title: "Invar GPU UI Framework",
      host: "github.com",
      visit_count: 9,
      last_visit_secs: 1795499000L,
    },
  ]
  let ranked = rank_omnibox_suggestions("github", tabs, snap.items, hist, 6)
  debug_assert(ranked.length() == 4, "deduped SwitchTab + Bookmark + History + Search fallback")
  debug_assert(ranked[0].kind is OmniboxSuggestionKind::SwitchTab && ranked[0].tab_id == "t-2", "open tab ranked first with SwitchTab")
  debug_assert(ranked[0].visits == 14, "deduplicated SwitchTab preserves history visits")
  debug_assert(ranked[1].kind is OmniboxSuggestionKind::Bookmark && ranked[1].url == "https://github.com/AFK-surf/farview", "bookmark ranked second")
  debug_assert(ranked[2].kind is OmniboxSuggestionKind::History && ranked[2].url == "https://github.com/AFK-surf/invar", "history ranked third")
  debug_assert(ranked[3].kind is OmniboxSuggestionKind::Search, "search fallback appended")

  // Direct URL fallback
  let url_ranked = rank_omnibox_suggestions("example.org/docs", tabs, snap.items, hist, 6)
  debug_assert(url_ranked.length() == 1 && (url_ranked[0].kind is OmniboxSuggestionKind::DirectUrl) && url_ranked[0].url == "https://example.org/docs", "direct url suggestion")
}

test "ReaderArticle codec, SiteBoost codec, CSS builder sanitization, and Reader/Boosts shortcuts" {
  // 1. ReaderArticle JSON round-trip & malformed/truncated resilience
  let art = ReaderArticle::{
    url: "https://blog.example.com/posts/pure-pion",
    host: "blog.example.com",
    title: "Building a Pure-Pion Browser",
    byline: "Farview Engineering",
    read_minutes: 4,
    word_count: 820,
    blocks: [
      ReaderBlock::{ kind: ReaderBlockKind::Heading, level: 2, text: "Architecture Overview" },
      ReaderBlock::{ kind: ReaderBlockKind::Paragraph, level: 0, text: "Farview keeps layout and painting local in native Metal." },
      ReaderBlock::{ kind: ReaderBlockKind::Quote, level: 0, text: "Zero video frames, pure synced DOM." },
      ReaderBlock::{ kind: ReaderBlockKind::Code, level: 0, text: "pionc build pion/cmd/app -o out/pion-app" },
      ReaderBlock::{ kind: ReaderBlockKind::ListItem, level: 0, text: "Deterministic CSS cascade" },
    ],
  }
  let art_json = encode_reader_article(art)
  let art_dec = match parse_reader_article(art_json) {
    Some(a) => a
    None => {
      debug_assert(false, "parse_reader_article failed")
      ReaderArticle::empty()
    }
  }
  debug_assert(art_dec.title == art.title && art_dec.host == "blog.example.com", "reader article header")
  debug_assert(art_dec.read_minutes == 4 && art_dec.word_count == 820, "reader article metrics")
  debug_assert(art_dec.blocks.length() == 5, "reader article block count")
  debug_assert(art_dec.blocks[0].kind is ReaderBlockKind::Heading && art_dec.blocks[0].level == 2, "heading block")
  debug_assert(art_dec.blocks[2].kind is ReaderBlockKind::Quote, "quote block")
  debug_assert(art_dec.blocks[3].kind is ReaderBlockKind::Code, "code block")
  debug_assert(art_dec.blocks[4].kind is ReaderBlockKind::ListItem, "list_item block")
  // Truncated JSON must cleanly return None
  debug_assert(parse_reader_article(art_json.slice(0, art_json.length() / 2)) is None, "truncated reader article")
  debug_assert(parse_reader_article("{not-json") is None, "malformed reader article")
  // Request-attributed Reader envelope round-trip & legacy fallback
  let env_json = encode_reader_article_envelope("r0:7", art_json)
  let (env_rid, env_art) = parse_reader_article_envelope(env_json)
  debug_assert(env_rid.unwrap_or("") == "r0:7", "reader envelope reqId")
  match env_art {
    Some(a) => debug_assert(a.title == art.title && a.url == art.url, "reader envelope article")
    None => debug_assert(false, "reader envelope article parsed")
  }
  let empty_env = encode_reader_article_envelope("r1:8", encode_reader_article(ReaderArticle::empty()))
  let (empty_rid, empty_art) = parse_reader_article_envelope(empty_env)
  debug_assert(empty_rid.unwrap_or("") == "r1:8" && empty_art.is_some(), "empty reader envelope keeps reqId")
  let (bare_rid, bare_art) = parse_reader_article_envelope(art_json)
  debug_assert(bare_rid is None && bare_art.is_some(), "legacy bare reader article parses with None reqId")
  let (bad_rid, bad_art) = parse_reader_article_envelope("{not-json")
  debug_assert(bad_rid is None && bad_art is None, "malformed reader envelope returns None")

  // 2. SiteBoost & BoostsSnapshot codec + canonical host normalization (preserving www.)
  debug_assert(normalize_boost_host("https://WWW.Example.COM:8443/a/b?x=1") == "www.example.com", "normalize boost host preserves www.")
  debug_assert(normalize_boost_host("https://Example.COM/news") == "example.com", "normalize boost host bare domain")
  debug_assert(normalize_boost_host("about:blank") == "", "about:blank has no boost host")
  let b1 = SiteBoost::{
    ..SiteBoost::default_for(""),
    host: "www.Example.com",
    enabled: true,
    theme: "dark",
    font: "serif",
    scale_pct: 115,
    hide_sticky: true,
    custom_css: "article > p { line-height: 1.8; } </style><script>alert(1)</script>",
  }
  let b2 = SiteBoost::{
    ..SiteBoost::default_for(""),
    host: "docs.pion.dev",
    enabled: false,
    theme: "sepia",
    font: "mono",
    scale_pct: 200,
    hide_sticky: false,
    custom_css: "",
  }
  let b3 = SiteBoost::{
    ..SiteBoost::default_for(""),
    host: "example.com",
    enabled: true,
    theme: "sepia",
    font: "sans",
    scale_pct: 105,
    hide_sticky: false,
    custom_css: "body { color: #222; }",
  }
  let bsnap = BoostsSnapshot::{ items: [b1, b2, b3] }
  let bjson = encode_boosts_snapshot(bsnap)
  let bdec = match parse_boosts_snapshot(bjson) {
    Some(s) => s
    None => {
      debug_assert(false, "parse_boosts_snapshot failed")
      BoostsSnapshot::empty()
    }
  }
  debug_assert(bdec.items.length() == 3, "three distinct site boosts (www. vs bare)")
  debug_assert(boosts_is_active(bdec, "https://www.example.com/news"), "active www. boost lookup")
  debug_assert(boosts_is_active(bdec, "https://example.com/news"), "active bare domain boost lookup")
  match (boosts_find(bdec, "https://www.example.com/a"), boosts_find(bdec, "https://example.com/a")) {
    (Some(w), Some(b)) => debug_assert(w.theme == "dark" && b.theme == "sepia", "www. and bare domain boosts stay independent")
    _ => debug_assert(false, "both www. and bare domain boosts found independently")
  }
  debug_assert(!boosts_is_active(bdec, "https://docs.pion.dev/guide"), "disabled boost lookup")
  debug_assert(bdec.items[1].scale_pct == BOOST_SCALE_MAX, "scale_pct clamped to 130")
  debug_assert(parse_boosts_snapshot(bjson.slice(0, bjson.length() - 3)) is None, "truncated boosts snapshot")

  // 3. Deterministic build_boost_css & strict </style> sanitization
  let css_on = build_boost_css(bdec.items[0])
  debug_assert(css_on.contains("#12141A"), "dark theme background")
  debug_assert(css_on.contains("Georgia"), "serif font override")
  debug_assert(css_on.contains("font-size: 115%"), "scale_pct override")
  debug_assert(css_on.contains("cookie"), "hide_sticky rule")
  debug_assert(css_on.contains("article > p"), "preserves valid CSS child combinator")
  debug_assert(!css_on.contains("</style") && !css_on.contains("<script"), "strips all < tag openers")
  debug_assert(build_boost_css(bdec.items[1]) == "", "disabled boost produces empty CSS")

  // 4. Reader Mode (Cmd+Opt+R / Ctrl+Alt+R) & Boosts (Cmd/Ctrl+Shift+E) shortcuts + Command Bar
  let mac_reader = dispatch_browser_shortcut(1114, SHORTCUT_MOD_CMD | SHORTCUT_MOD_ALT, true, false, false, false)
  debug_assert(mac_reader is BrowserShortcut::ToggleReaderMode, "macOS Cmd+Opt+R -> ToggleReaderMode")
  let lin_reader = dispatch_browser_shortcut(1114, SHORTCUT_MOD_CTRL | SHORTCUT_MOD_ALT, false, false, false, false)
  debug_assert(lin_reader is BrowserShortcut::ToggleReaderMode, "Linux/Win Ctrl+Alt+R -> ToggleReaderMode")
  let mac_boosts = dispatch_browser_shortcut(1101, SHORTCUT_MOD_CMD | SHORTCUT_MOD_SHIFT, true, false, false, false)
  debug_assert(mac_boosts is BrowserShortcut::ToggleBoosts, "macOS Cmd+Shift+E -> ToggleBoosts")
  let lin_boosts = dispatch_browser_shortcut(1069, SHORTCUT_MOD_CTRL | SHORTCUT_MOD_SHIFT, false, false, false, false)
  debug_assert(lin_boosts is BrowserShortcut::ToggleBoosts, "Linux/Win Ctrl+Shift+E -> ToggleBoosts")

  let ws = WorkspaceSnapshot::empty()
  let r_items = build_command_bar_items(ws, "reader", "https://example.com", true)
  let mut found_reader = false
  for it in r_items {
    if it.id == "toggle_reader_mode" && it.shortcut == "⌥⌘R" {
      found_reader = true
    }
  }
  debug_assert(found_reader, "Command Bar includes toggle_reader_mode")
  let b_items = build_command_bar_items(ws, "boost", "https://example.com", true)
  let mut found_boost = false
  for it in b_items {
    if it.id == "toggle_boosts" && it.shortcut == "⇧⌘E" {
      found_boost = true
    }
  }
  debug_assert(found_boost, "Command Bar includes toggle_boosts")
}

test "boosts: v1/v2 JSON without Colors, Zap or Code fields loads with their defaults" {
  let old_json = "{\"version\":2,\"items\":[{\"host\":\"github.com\",\"enabled\":true,\"theme\":\"dark\",\"font\":\"serif\",\"scalePct\":110,\"hideSticky\":true,\"customCss\":\"pre { tab-size: 2; }\"}]}"
  match parse_boosts_snapshot(old_json) {
    Some(snap) => {
      debug_assert(snap.items.length() == 1, "old boost loads")
      let b = snap.items[0]
      debug_assert(b.theme == "dark" && b.font == "serif" && b.scale_pct == 110 && b.hide_sticky, "old fields kept")
      debug_assert(b.tint == "" && b.tint_pct == BOOST_TINT_DEFAULT, "tint defaults")
      debug_assert(b.brightness_pct == 100 && b.contrast_pct == 100 && !b.invert, "adjustments default")
      debug_assert(b.zapped.length() == 0 && b.custom_js == "", "zap and script default")
      let css = build_boost_css(b)
      debug_assert(!css.contains("filter:"), "no filter for an old boost")
    }
    None => debug_assert(false, "old boosts JSON parses")
  }
  let v1 = "{\"items\":[{\"host\":\"news.ycombinator.com\",\"enabled\":true,\"theme\":\"sepia\"}]}"
  match parse_boosts_snapshot(v1) {
    Some(snap) => debug_assert(snap.items[0].zapped.length() == 0 && snap.items[0].theme == "sepia", "v1 boost loads")
    None => debug_assert(false, "v1 boosts JSON parses")
  }
}

test "boosts: Colors, Zap and Code round-trip through JSON" {
  let b = SiteBoost::{
    ..SiteBoost::default_for("developer.mozilla.org"),
    enabled: true,
    tint: "#5856D6",
    tint_pct: 70,
    brightness_pct: 90,
    contrast_pct: 120,
    invert: true,
    zapped: ["div.newsletter-banner", "#onetrust-consent-sdk", "div.newsletter-banner"],
    custom_js: "document.title = document.title.replace(' | MDN', '');",
  }
  let json = encode_site_boost(b)
  match parse_site_boost(json) {
    Some(d) => {
      debug_assert(d.host == "developer.mozilla.org", "host")
      debug_assert(d.tint == "#5856d6", "tint lowercased")
      debug_assert(d.tint_pct == 70 && d.brightness_pct == 90 && d.contrast_pct == 120 && d.invert, "adjustments")
      debug_assert(d.zapped.length() == 2 && d.zapped[0] == "div.newsletter-banner" && d.zapped[1] == "#onetrust-consent-sdk", "zapped deduplicated in order")
      debug_assert(d.custom_js == "document.title = document.title.replace(' | MDN', '');", "custom js")
    }
    None => debug_assert(false, "encoded boost parses")
  }
  let snap_json = encode_boosts_snapshot(BoostsSnapshot::{ items: [b] })
  match parse_boosts_snapshot(snap_json) {
    Some(s) => debug_assert(s.items[0].zapped.length() == 2 && s.items[0].invert, "snapshot keeps new fields")
    None => debug_assert(false, "snapshot parses")
  }
  // Out-of-range values clamp; bad colors and unsafe selectors are dropped.
  let raw = "{\"host\":\"en.wikipedia.org\",\"enabled\":true,\"tint\":\"blue\",\"tintPct\":400,\"brightness\":10,\"contrast\":999,\"zapped\":[\"a{}\",\"body > div; color:red\",\"#siteNotice\"]}"
  match parse_site_boost(raw) {
    Some(d) => {
      debug_assert(d.tint == "" && d.tint_pct == 100, "named color dropped, intensity clamped")
      debug_assert(d.brightness_pct == BOOST_ADJUST_MIN && d.contrast_pct == BOOST_ADJUST_MAX, "adjustments clamped")
      debug_assert(d.zapped.length() == 1 && d.zapped[0] == "#siteNotice", "unsafe selectors dropped")
    }
    None => debug_assert(false, "clamped boost parses")
  }
}

test "boosts: build_boost_css for tint, filters, invert and zapped elements" {
  let base = SiteBoost::{ ..SiteBoost::default_for("github.com"), enabled: true }
  debug_assert(build_boost_css(base) == "", "an enabled boost with nothing set adds no CSS")
  let tinted = build_boost_css(SiteBoost::{ ..base, tint: "#007aff", tint_pct: 100 })
  // Original: the page keeps its own ground (light or dark); the tint is a 45% multiply wash over it.
  debug_assert(!tinted.contains("html, body { background-color"), "Original keeps the page's own ground")
  debug_assert(tinted.contains("mix-blend-mode: multiply") && tinted.contains("rgba(0, 122, 255, 0.450)"), "tint washes over the page")
  // Sepia: 45% of #007aff over #f6efe2 replaces the ground.
  let sep = build_boost_css(SiteBoost::{ ..base, theme: "sepia", tint: "#007aff", tint_pct: 100 })
  debug_assert(sep.contains("html, body { background-color: " + boost_mix_hex("#f6efe2", "#007aff", 0.45) + " !important; }"), "tint mixes into a theme's ground")
  debug_assert(tinted.contains("accent-color: #007aff"), "tint is the accent color")
  debug_assert(build_boost_css(SiteBoost::{ ..base, tint: "#007aff", tint_pct: 0 }) == "", "zero intensity adds no tint")
  let adj = build_boost_css(SiteBoost::{ ..base, brightness_pct: 80, contrast_pct: 125 })
  debug_assert(adj.contains("html { filter: brightness(80%) contrast(125%) !important; }"), "one filter for brightness and contrast")
  let inv = build_boost_css(SiteBoost::{ ..base, invert: true })
  debug_assert(inv.contains("html { filter: invert(1) hue-rotate(180deg) !important; }"), "invert filter")
  debug_assert(inv.contains("img, video, canvas, iframe"), "media keeps its colors under invert")
  debug_assert(!inv.contains("picture"), "an img in a picture is inverted back once, not twice")
  // A selector with an open bracket, string or escape would swallow the rules after it: dropped.
  let swallow = build_boost_css(SiteBoost::{ ..base, zapped: ["a[x", "a[title=\"", "p\\", "a(b]", "div.ok", "a[href=\"]\"]"], custom_css: "body { margin: 0; }" })
  debug_assert(!swallow.contains("a[x {") && !swallow.contains("a[title=") && !swallow.contains("p\\ {") && !swallow.contains("a(b]"), "unbalanced selectors dropped")
  debug_assert(swallow.contains("div.ok { display: none !important; }"), "a balanced selector stays")
  debug_assert(swallow.contains("a[href=\"]\"] { display: none !important; }"), "a bracket inside a string is fine")
  debug_assert(swallow.ends_with("body { margin: 0; }"), "custom CSS still comes last")
  debug_assert(sanitize_boost_selector("a[x") == "" && sanitize_boost_selector("a\\") == "" && sanitize_boost_selector("p:not(.a)") == "p:not(.a)", "sanitize balances")
  let zap = build_boost_css(SiteBoost::{ ..base, zapped: ["#onetrust-banner-sdk", "aside.promo"] })
  debug_assert(zap.contains("#onetrust-banner-sdk { display: none !important; }"), "first zapped element hidden")
  debug_assert(zap.contains("aside.promo { display: none !important; }"), "each zapped element has its own rule")
  // The second color takes the links on its own, with no tint (Original: deepened 15% toward black).
  let only2 = build_boost_css(SiteBoost::{ ..base, tint2: "#ff9500" })
  debug_assert(only2.contains("a, a * { color: " + boost_mix_hex("#ff9500", "#000000", 0.15) + " !important; }"), "a second color alone colors links")
  debug_assert(!only2.contains("mix-blend-mode") && !only2.contains("accent-color"), "a second color alone adds no tint")
  let dark2 = build_boost_css(SiteBoost::{ ..base, theme: "dark", tint2: "#ff9500" })
  debug_assert(dark2.contains("a, a * { color: " + boost_mix_hex("#ff9500", "#ffffff", 0.35) + " !important; }"), "on a dark ground it is lightened")
  // With a tint, the second color's link rule comes after the tint's own, so it is the one that holds.
  let both = build_boost_css(SiteBoost::{ ..base, theme: "sepia", tint: "#007aff", tint_pct: 100, tint2: "#ff9500" })
  let tint_link = "a, a * { color: " + boost_mix_hex("#007aff", "#000000", 0.25) + " !important; }"
  let link2 = "a, a * { color: " + boost_mix_hex("#ff9500", "#000000", 0.25) + " !important; }"
  let at_tint = both.index_of(tint_link)
  let at_2 = both.index_of(link2)
  debug_assert(at_tint >= 0 && at_2 >= 0, "both link rules present: " + both)
  debug_assert(at_tint < at_2, "the second color's link rule overrides the tint's")
  let off = build_boost_css(SiteBoost::{ ..base, enabled: false, zapped: ["aside.promo"], invert: true })
  debug_assert(off == "", "a boost that is off adds nothing")
  // Zap add/remove
  let z1 = boost_zap_add(SiteBoost::default_for("news.ycombinator.com"), "td.subtext")
  debug_assert(z1.enabled && z1.zapped.length() == 1, "zapping turns the boost on")
  debug_assert(boost_zap_add(z1, "td.subtext").zapped.length() == 1, "zapping twice keeps one")
  debug_assert(boost_zap_add(z1, "x { }").zapped.length() == 1, "unsafe selector ignored")
  debug_assert(boost_zap_remove(z1, "td.subtext").zapped.length() == 0, "restore removes it")
  debug_assert(boost_has_changes(z1) && !boost_has_changes(SiteBoost::default_for("a.example")), "has_changes")
  // Colors helpers
  debug_assert(normalize_boost_tint("#ABC") == "#aabbcc", "short hex expands")
  debug_assert(boost_hue_hex(0).starts_with("#e") && boost_tint_hue(boost_hue_hex(210)) >= 205 && boost_tint_hue(boost_hue_hex(210)) <= 215, "hue round trip")
  debug_assert(boost_tint_rgba("#ff9500") == 0xFF9500FFL, "rgba of tint")
  // Code
  debug_assert(build_boost_js(base) == "", "no script, nothing to run")
  let js = build_boost_js(SiteBoost::{ ..base, custom_js: "document.body.dataset.boosted = '1';" })
  debug_assert(js.contains("document.body.dataset.boosted") && js.contains("catch (e)"), "script wrapped and guarded")
  debug_assert(build_boost_js(SiteBoost::{ ..base, enabled: false, custom_js: "x()" }) == "", "off boost runs no script")
}

test "boosts: case, second color and the font grid round-trip and build CSS (old JSON loads with defaults)" {
  // Old JSON (no textCase / tint2) loads with the page's own case and no second color.
  match parse_site_boost("{\"host\":\"github.com\",\"enabled\":true,\"font\":\"serif\"}") {
    Some(d) => debug_assert(d.text_case == "none" && d.tint2 == "" && d.font == "serif", "old boost: defaults for new fields")
    None => debug_assert(false, "old boost parses")
  }
  let b = SiteBoost::{
    ..SiteBoost::default_for("en.wikipedia.org"),
    enabled: true,
    tint: "#5856d6",
    tint_pct: 50,
    tint2: "#FF9500",
    text_case: "UPPER",
    font: "didone",
  }
  match parse_site_boost(encode_site_boost(b)) {
    Some(d) => {
      debug_assert(d.text_case == "upper", "case round-trips normalized")
      debug_assert(d.tint2 == "#ff9500", "second color round-trips lowercased")
      debug_assert(d.font == "didone", "a grid font round-trips")
    }
    None => debug_assert(false, "boost with case parses")
  }
  debug_assert(normalize_boost_case("Title") == "none" && normalize_boost_font("comic") == "default", "unknown values fall back")
  debug_assert(boost_next_case("none") == "lower" && boost_next_case("lower") == "upper" && boost_next_case("upper") == "none", "case cycles")
  debug_assert(boost_next_scale(100) == 110 && boost_next_scale(120) == 130 && boost_next_scale(130) == 90, "size steps then wraps to the smallest")
  debug_assert(boost_next_scale(90) == 100, "from the smallest back to the page's own size")
  let css = build_boost_css(b)
  debug_assert(css.contains("text-transform: uppercase !important;"), "case becomes text-transform")
  debug_assert(css.contains("font-family: Didot,"), "a grid font sets its stack")
  debug_assert(css.contains("a, a * { color: " + boost_mix_hex("#ff9500", "#000000", 0.15) + " !important; }"), "second color takes the links")
  let lower = build_boost_css(SiteBoost::{ ..SiteBoost::default_for("a.example"), enabled: true, text_case: "lower" })
  debug_assert(lower.contains("lowercase") && lower.contains(":not(input):not(textarea)"), "lowercase leaves form fields alone")
  debug_assert(boost_has_changes(SiteBoost::{ ..SiteBoost::default_for("a.example"), text_case: "lower" }), "case is a change")
  // The grid shows only samples the panel draws apart: no two share family, weight class and italic.
  let looks : Array[String] = []
  for f in boost_grid_fonts() {
    let look = f.family + (if f.weight >= 600 { "-bold" } else { "-regular" }) + (if f.italic { "-italic" } else { "" })
    debug_assert(!looks.contains(look), "grid sample drawn apart: " + f.id + " (" + look + ")")
    looks.push(look)
  }
  debug_assert(boost_grid_fonts().length() == 6, "six grid samples")
  // Every grid font has a stack and a sample face; ids are unique; the three old ids are kept.
  let seen : Array[String] = []
  for f in boost_fonts() {
    debug_assert(f.stack != "" && (f.family == "sans" || f.family == "serif" || f.family == "mono"), "font " + f.id + " is drawable")
    debug_assert(!seen.contains(f.id), "font id unique: " + f.id)
    seen.push(f.id)
  }
  debug_assert(seen.contains("sans") && seen.contains("serif") && seen.contains("mono") && seen.length() == 15, "15 fonts incl. the old three")
  // The page's Done marks its snapshot; ordinary snapshots are not marked.
  let snap = BoostsSnapshot::{ items: [b] }
  debug_assert(boosts_snapshot_zap_done(encode_boosts_snapshot(snap, zap_done=true)), "zapDone read back")
  debug_assert(!boosts_snapshot_zap_done(encode_boosts_snapshot(snap)), "plain snapshot is not zapDone")
  debug_assert(!boosts_snapshot_zap_done(encode_boosts_snapshot(snap, legacy_bare=["github.com"])), "legacy snapshot is not zapDone")
  match parse_boosts_snapshot(encode_boosts_snapshot(snap, zap_done=true)) {
    Some(s2) => debug_assert(s2.items.length() == 1, "a zapDone snapshot still parses")
    None => debug_assert(false, "zapDone snapshot parses")
  }
}

test "proto BrowserSettings codec, fault-tolerant fallback, search URLs, and HTTPS-Only upgrade" {
  let def = BrowserSettings::default()
  debug_assert(def.search_engine == "google", "default search engine is google")
  debug_assert(def.chrome_theme == "light", "default chrome theme is light")
  debug_assert(def.default_zoom_pct == 100, "default zoom is 100")
  debug_assert(!def.compact_sidebar, "default compact_sidebar false")
  debug_assert(!def.https_only, "default https_only false")
  debug_assert(def.block_third_party_cookies, "default block_third_party_cookies true")
  debug_assert(!def.send_dnt, "default send_dnt false")
  debug_assert(def.auto_archive_hours == 24, "default auto_archive_hours 24")
  debug_assert(!def.glass, "default glass off")
  match parse_browser_settings("{\"searchEngine\":\"kagi\"}") {
    Some(old) => debug_assert(!old.glass, "settings saved before the glass field load with glass off")
    None => debug_assert(false, "old settings JSON parses")
  }

  let custom = BrowserSettings::{
    search_engine: "kagi",
    chrome_theme: "dark",
    default_zoom_pct: 125,
    compact_sidebar: true,
    https_only: true,
    block_third_party_cookies: false,
    send_dnt: true,
    auto_archive_hours: 168,
    glass: true,
  }
  let enc = encode_browser_settings(custom)
  match parse_browser_settings(enc) {
    Some(got) => {
      debug_assert(got.search_engine == "kagi", "roundtrip search_engine")
      debug_assert(got.chrome_theme == "dark", "roundtrip chrome_theme")
      debug_assert(got.default_zoom_pct == 125, "roundtrip default_zoom_pct")
      debug_assert(got.compact_sidebar, "roundtrip compact_sidebar")
      debug_assert(got.https_only, "roundtrip https_only")
      debug_assert(!got.block_third_party_cookies, "roundtrip block_third_party_cookies")
      debug_assert(got.send_dnt, "roundtrip send_dnt")
      debug_assert(got.auto_archive_hours == 168, "roundtrip auto_archive_hours")
      debug_assert(got.glass, "roundtrip glass")
    }
    None => debug_assert(false, "parse_browser_settings failed on valid JSON")
  }

  // Invalid field values safely fall back to defaults / clamped ranges
  let bad_vals = "{\"searchEngine\":\"yahoo\",\"chromeTheme\":\"neon\",\"defaultZoomPct\":999,\"autoArchiveHours\":99,\"httpsOnly\":true,\"extra\":123}"
  match parse_browser_settings(bad_vals) {
    Some(got) => {
      debug_assert(got.search_engine == "google", "unknown engine falls back to google")
      debug_assert(got.chrome_theme == "light", "unknown theme falls back to light")
      debug_assert(got.default_zoom_pct == 150, "zoom clamped to 150")
      debug_assert(got.auto_archive_hours == 24, "invalid archive hours falls back to 24")
      debug_assert(got.https_only, "valid httpsOnly preserved")
    }
    None => debug_assert(false, "parse_browser_settings should tolerate invalid values")
  }
  debug_assert(parse_browser_settings("{truncated").is_none(), "truncated JSON returns None")
  debug_assert(parse_browser_settings("[]").is_none(), "non-object JSON returns None")

  // All 5 search engines + labels + URL encoding
  debug_assert(search_engine_label("google") == "Google", "label google")
  debug_assert(search_engine_label("duckduckgo") == "DuckDuckGo", "label duckduckgo")
  debug_assert(search_engine_label("kagi") == "Kagi", "label kagi")
  debug_assert(search_engine_label("perplexity") == "Perplexity", "label perplexity")
  debug_assert(search_engine_label("bing") == "Bing", "label bing")
  debug_assert(build_search_url("google", "farview browser") == "https://www.google.com/search?q=farview+browser", "google search url")
  debug_assert(build_search_url("duckduckgo", "pion lang") == "https://duckduckgo.com/?q=pion+lang", "ddg search url")
  debug_assert(build_search_url("kagi", "a&b") == "https://kagi.com/search?q=a%26b", "kagi search url")
  debug_assert(build_search_url("perplexity", "metal gpu") == "https://www.perplexity.ai/search?q=metal+gpu", "perplexity search url")
  debug_assert(build_search_url("bing", "rust") == "https://www.bing.com/search?q=rust", "bing search url")

  // HTTPS-Only upgrade preserves localhost / 127.0.0.1
  debug_assert(apply_https_only("http://example.com/path?a=1", true) == "https://example.com/path?a=1", "upgrade external http")
  debug_assert(apply_https_only("http://example.com/path", false) == "http://example.com/path", "disabled https_only keeps http")
  debug_assert(apply_https_only("http://localhost:8080/test", true) == "http://localhost:8080/test", "preserve localhost")
  debug_assert(apply_https_only("http://127.0.0.1:9000/", true) == "http://127.0.0.1:9000/", "preserve 127.0.0.1")
  debug_assert(omnibox_normalize_input_with_engine("hello world", "kagi", https_only=true) == "https://kagi.com/search?q=hello+world", "omnibox uses kagi")
  debug_assert(omnibox_normalize_input_with_engine("http://example.org", "kagi", https_only=true) == "https://example.org", "omnibox upgrades http when https_only")
}

test "proto Cmd+, OpenSettings shortcut and Command Bar settings/dark mode items" {
  let sc_mac = dispatch_browser_shortcut(1044, SHORTCUT_MOD_CMD, true, false, false, false)
  debug_assert(sc_mac is BrowserShortcut::OpenSettings, "Cmd+, opens settings on macOS")
  let sc_lin = dispatch_browser_shortcut(1044, SHORTCUT_MOD_CTRL, false, false, false, false)
  debug_assert(sc_lin is BrowserShortcut::OpenSettings, "Ctrl+, opens settings on Linux/Windows")

  let snap = WorkspaceSnapshot::empty()
  let items_set = build_command_bar_items(snap, "settings", "https://farview.dev", true)
  let mut found_settings = false
  let mut i = 0
  while i < items_set.length() {
    if items_set[i].id == "open_settings" && items_set[i].shortcut == "⌘," {
      found_settings = true
    }
    i = i + 1
  }
  debug_assert(found_settings, "Command Bar includes Open Settings with ⌘,")

  let items_dark = build_command_bar_items(snap, "dark mode", "https://farview.dev", true)
  let mut found_dark = false
  let mut j = 0
  while j < items_dark.length() {
    if items_dark[j].id == "toggle_dark_chrome" {
      found_dark = true
    }
    j = j + 1
  }
  debug_assert(found_dark, "Command Bar includes Toggle Dark Mode")
}

test "proto SitePermissionRule codec, origin normalization, start-page detection & tile dedup" {
  // Start Page URL detection
  debug_assert(is_start_page_url(""), "empty is start page")
  debug_assert(is_start_page_url("about:blank"), "about:blank is start page")
  debug_assert(is_start_page_url("about:newtab"), "about:newtab is start page")
  debug_assert(is_start_page_url("FARVIEW://NEWTAB/"), "farview://newtab/ is start page")
  debug_assert(!is_start_page_url("https://meet.google.com"), "https URL is not start page")

  // Origin normalization
  debug_assert(normalize_permission_origin("https://Meet.Google.com:443/abc-defg-hij?authuser=0#top") == "https://meet.google.com", "normalize https default port")
  debug_assert(normalize_permission_origin("http://LocalHost:8080/app") == "http://localhost:8080", "preserve non-default port")
  debug_assert(normalize_permission_origin("http://example.com:80/foo") == "http://example.com", "strip http default port 80")
  debug_assert(normalize_permission_origin("about:newtab") == "", "start page has empty origin")
  debug_assert(normalize_permission_origin("") == "", "empty url has empty origin")

  // SitePermissionsSnapshot round-trip
  let meet_rule = SitePermissionRule::{
    origin: "https://meet.google.com/abc-defg-hij",
    camera: "allow",
    microphone: "allow",
    notifications: "ask",
    geolocation: "block",
    clipboard: "ask",
  }
  let snap = SitePermissionsSnapshot::{ rules: [meet_rule] }
  let enc = encode_site_permissions_snapshot(snap)
  match parse_site_permissions_snapshot(enc) {
    Some(got) => {
      debug_assert(got.rules.length() == 1, "1 rule decoded")
      let r = site_perms_rule_for(got, "https://meet.google.com/xyz-1234-567")
      debug_assert(r.origin == "https://meet.google.com", "origin normalized")
      debug_assert(r.camera == "allow", "camera allow")
      debug_assert(r.microphone == "allow", "microphone allow")
      debug_assert(r.notifications == "ask", "notifications ask")
      debug_assert(r.geolocation == "block", "geolocation block")
      debug_assert(r.clipboard == "ask", "clipboard ask")
      debug_assert(site_perm_rule_has_custom(r), "custom rule detected")
      debug_assert(site_perm_rule_has_active_media(r), "active media detected")
    }
    None => debug_assert(false, "parse_site_permissions_snapshot failed on valid JSON")
  }

  // Fault-tolerant fallback for invalid values and malformed JSON
  let bad_vals = "{\"rules\":[{\"origin\":\"https://example.org/p\",\"camera\":\"granted\",\"microphone\":\"denied\",\"notifications\":\"bogus\",\"geolocation\":\"invalid\",\"clipboard\":\"allow\"}]}"
  match parse_site_permissions_snapshot(bad_vals) {
    Some(got) => {
      let r = site_perms_rule_for(got, "https://example.org")
      debug_assert(r.camera == "allow", "granted -> allow")
      debug_assert(r.microphone == "block", "denied -> block")
      debug_assert(r.notifications == "ask", "bogus -> ask")
      debug_assert(r.geolocation == "ask", "invalid -> ask")
      debug_assert(r.clipboard == "allow", "allow preserved")
    }
    None => debug_assert(false, "should tolerate invalid permission tokens")
  }
  debug_assert(parse_site_permissions_snapshot("{truncated").is_none(), "truncated JSON returns None")
  debug_assert(parse_site_permissions_snapshot("[]").is_none(), "non-object JSON returns None")

  // Start Page Quick Access tiles: merge bookmarks + high-frequency history, dedup by canonical URL
  let bms : Array[BookmarkEntry] = [
    BookmarkEntry::{ id: "b1", title: "GitHub", url: "https://github.com/", folder: "Dev", created_ms: 100L },
    BookmarkEntry::{ id: "b2", title: "Google Meet", url: "https://meet.google.com", folder: "Work", created_ms: 90L },
    BookmarkEntry::{ id: "b3", title: "Blank", url: "about:newtab", folder: "", created_ms: 80L },
  ]
  let hist : Array[HistoryItemSummary] = [
    HistoryItemSummary::{ url: "https://github.com", title: "GitHub Home", host: "github.com", visit_count: 14, last_visit_secs: 200L },
    HistoryItemSummary::{ url: "https://news.ycombinator.com/", title: "Hacker News", host: "news.ycombinator.com", visit_count: 25, last_visit_secs: 180L },
    HistoryItemSummary::{ url: "https://linear.app/", title: "Linear", host: "linear.app", visit_count: 9, last_visit_secs: 190L },
    HistoryItemSummary::{ url: "https://docs.rs/", title: "Docs.rs", host: "docs.rs", visit_count: 4, last_visit_secs: 150L },
  ]
  let tiles = build_start_page_tiles(bms, hist, 4)
  debug_assert(tiles.length() == 4, "capped at 4 tiles")
  debug_assert(tiles[0].url == "https://github.com/" && tiles[0].is_bookmark && tiles[0].visit_count == 14, "bookmark deduped and inherits history visit_count")
  debug_assert(tiles[1].url == "https://meet.google.com" && tiles[1].is_bookmark, "second bookmark preserved")
  debug_assert(tiles[2].url == "https://news.ycombinator.com/" && !tiles[2].is_bookmark && tiles[2].visit_count == 25, "highest-frequency history fills next")
  debug_assert(tiles[3].url == "https://linear.app/" && tiles[3].monogram == "L", "second highest history fills last slot")

  // Command Bar includes New Start Page & Site Permissions and Info
  let ws = WorkspaceSnapshot::empty()
  let sp_items = build_command_bar_items(ws, "start page", "https://meet.google.com", true)
  let mut found_sp = false
  let mut i = 0
  while i < sp_items.length() {
    if sp_items[i].id == "new_start_page" {
      found_sp = true
    }
    i = i + 1
  }
  debug_assert(found_sp, "Command Bar includes New Start Page")

  let si_items = build_command_bar_items(ws, "site permissions", "https://meet.google.com", true)
  let mut found_si = false
  let mut j = 0
  while j < si_items.length() {
    if si_items[j].id == "site_info" && si_items[j].title == "Site permissions and info" {
      found_si = true
    }
    j = j + 1
  }
  debug_assert(found_si, "Command Bar includes Site Permissions and Info")
}

test "MediaHubSnapshot codec, select_mini_player_session, progress & time formatting, and Command Bar actions" {
  // Time formatting
  debug_assert(format_media_time(-5) == "0:00", "negative secs clamps to 0:00")
  debug_assert(format_media_time(0) == "0:00", "0 secs -> 0:00")
  debug_assert(format_media_time(9) == "0:09", "9 secs -> 0:09")
  debug_assert(format_media_time(65) == "1:05", "65 secs -> 1:05")
  debug_assert(format_media_time(3665) == "1:01:05", "3665 secs -> 1:01:05")

  let yt = MediaSessionItem::{
    tab_id: "t-yt",
    title: "Lofi Girl — beats to relax/study to",
    artist_or_host: "Lofi Girl · youtube.com",
    url: "https://www.youtube.com/watch?v=jfKfPfyJRdk",
    playing: true,
    muted: false,
    is_live_call: false,
    duration_secs: 240,
    position_secs: 120,
  }
  let meet = MediaSessionItem::{
    tab_id: "t-meet",
    title: "Design Architecture Sync",
    artist_or_host: "meet.google.com",
    url: "https://meet.google.com/abc-defg-hij",
    playing: true,
    muted: false,
    is_live_call: true,
    duration_secs: 0,
    position_secs: 0,
  }
  let spot = MediaSessionItem::{
    tab_id: "t-spot",
    title: "Midnight City",
    artist_or_host: "M83",
    url: "https://open.spotify.com/track/123",
    playing: false,
    muted: true,
    is_live_call: false,
    duration_secs: 244,
    position_secs: 61,
  }

  // Progress ratio & percentage
  debug_assert(media_progress_pct(yt) == 50, "120/240 -> 50%")
  debug_assert(media_progress_pct(meet) == 100, "live call -> 100%")
  debug_assert(media_progress_pct(spot) == 25, "61/244 -> 25%")

  // Codec round-trip
  let snap = MediaHubSnapshot::{ sessions: [yt, meet, spot] }
  let enc = encode_media_hub_snapshot(snap)
  match parse_media_hub_snapshot(enc) {
    Some(got) => {
      debug_assert(got.sessions.length() == 3, "3 sessions decoded")
      debug_assert(got.sessions[0].tab_id == "t-yt" && got.sessions[0].playing && got.sessions[0].duration_secs == 240 && got.sessions[0].position_secs == 120, "yt round-trip")
      debug_assert(got.sessions[1].tab_id == "t-meet" && got.sessions[1].is_live_call, "meet round-trip")
      debug_assert(got.sessions[2].tab_id == "t-spot" && got.sessions[2].muted && !got.sessions[2].playing, "spot round-trip")
      debug_assert(media_hub_has_live_call(got), "has live call")
      debug_assert(media_hub_has_unmuted_playing(got), "has unmuted playing")

      // Mini-player selection prefers background live call / playing tab over active tab
      match select_mini_player_session(got, "t-yt") {
        Some(sel) => debug_assert(sel.tab_id == "t-meet", "prefers background live call when yt is active")
        None => debug_assert(false, "expected mini player selection")
      }
      match select_mini_player_session(got, "t-meet") {
        Some(sel) => debug_assert(sel.tab_id == "t-yt", "prefers background playing yt when meet is active")
        None => debug_assert(false, "expected mini player selection")
      }
    }
    None => debug_assert(false, "parse_media_hub_snapshot failed on valid JSON")
  }

  // Empty snapshot selection -> None
  debug_assert(select_mini_player_session(MediaHubSnapshot::empty(), "t-1").is_none(), "empty snapshot -> None")

  // Fault tolerance on truncated/malformed JSON
  debug_assert(parse_media_hub_snapshot("{truncated").is_none(), "truncated JSON returns None")
  debug_assert(parse_media_hub_snapshot("[]").is_none(), "non-object JSON returns None")

  // Command Bar includes Global Media Controls & Play / Pause Media
  let ws = WorkspaceSnapshot::empty()
  let gm_items = build_command_bar_items(ws, "global media", "https://youtube.com", true)
  let mut found_gm = false
  let mut k = 0
  while k < gm_items.length() {
    if gm_items[k].id == "global_media_controls" {
      found_gm = true
    }
    k = k + 1
  }
  debug_assert(found_gm, "Command Bar includes Global Media Controls")

  let pp_items = build_command_bar_items(ws, "play / pause", "https://youtube.com", true)
  let mut found_pp = false
  let mut m = 0
  while m < pp_items.length() {
    if pp_items[m].id == "toggle_play_media" {
      found_pp = true
    }
    m = m + 1
  }
  debug_assert(found_pp, "Command Bar includes Play / Pause Media")
}

test "clean_tracking_url strips tracking params RFC-3986 safely while preserving order, encoding, hash & non-http URLs" {
  // Empty / queryless URLs untouched
  debug_assert(clean_tracking_url("https://example.com/docs") == "https://example.com/docs", "queryless unchanged")
  debug_assert(clean_tracking_url("https://example.com/docs?") == "https://example.com/docs?", "empty query unchanged")
  debug_assert(clean_tracking_url_ex("https://example.com/docs").1 == 0, "0 removed")

  // All tracking params removed cleanly without trailing '?'
  let (c1, r1) = clean_tracking_url_ex("https://example.com/post?utm_source=x&utm_medium=social&fbclid=AbC123&gclid=g1")
  debug_assert(c1 == "https://example.com/post", "all tracking params stripped")
  debug_assert(r1 == 4, "4 trackers removed")

  // Mixed params: order & percent-encoding preserved verbatim
  let (c2, r2) = clean_tracking_url_ex("https://example.com/search?a=1&utm_source=x&b=hello%20world&si=tok99&c=2#results")
  debug_assert(c2 == "https://example.com/search?a=1&b=hello%20world&c=2#results", "mixed params + hash preserved")
  debug_assert(r2 == 2, "2 trackers removed")

  // Case-insensitive tracking param names + all required tracker keys
  let (c3, r3) = clean_tracking_url_ex(
    "https://shop.example.org/item?UTM_CAMPAIGN=fall&DCLID=1&msclkid=2&yclid=3&mc_cid=4&mc_eid=5&igshid=6&ref_src=7&ref_url=8&spm=9&_hsenc=10&_hsmi=11&sku=A%2FB",
  )
  debug_assert(c3 == "https://shop.example.org/item?sku=A%2FB", "all tracker keys stripped case-insensitively")
  debug_assert(r3 == 12, "12 trackers removed")

  // Hash preserved when all query params stripped
  let (c4, r4) = clean_tracking_url_ex("https://example.com/guide?utm_term=arc#peek")
  debug_assert(c4 == "https://example.com/guide#peek", "hash preserved when query emptied")
  debug_assert(r4 == 1, "1 tracker removed")

  // Non-HTTP(S) & invalid URLs untouched
  debug_assert(clean_tracking_url("about:newtab?utm_source=x") == "about:newtab?utm_source=x", "about: untouched")
  debug_assert(clean_tracking_url("data:text/html,<h1>Hi</h1>?fbclid=1") == "data:text/html,<h1>Hi</h1>?fbclid=1", "data: untouched")
  debug_assert(clean_tracking_url("file:///tmp/index.html?gclid=1") == "file:///tmp/index.html?gclid=1", "file: untouched")
  debug_assert(clean_tracking_url("not a url") == "not a url", "invalid URL untouched")

  // Toast formatting
  debug_assert(format_copy_clean_url_toast(0) == "Copied URL", "toast 0")
  debug_assert(format_copy_clean_url_toast(1) == "Copied clean URL (1 tracker removed)", "toast 1")
  debug_assert(format_copy_clean_url_toast(3) == "Copied clean URL (3 trackers removed)", "toast 3")
}

test "PeekSnapshot codec, modal geometry, Tab Hover Preview badges & clamping, and Command Bar/Shortcuts" {
  let snap = PeekSnapshot::{
    open: true,
    url: "https://developer.mozilla.org/en-US/docs/Web",
    title: "MDN Web Docs",
    source_tab_id: "tab-42",
    loading: false,
    can_back: true,
    can_forward: false,
  }
  let json = encode_peek_snapshot(snap)
  match parse_peek_snapshot(json) {
    Some(got) => {
      debug_assert(got.open, "peek open")
      debug_assert(got.url == snap.url, "peek url")
      debug_assert(got.title == "MDN Web Docs", "peek title")
      debug_assert(got.source_tab_id == "tab-42", "peek sourceTabId")
      debug_assert(!got.loading && got.can_back && !got.can_forward, "peek nav flags")
    }
    None => debug_assert(false, "parse_peek_snapshot failed")
  }
  debug_assert(parse_peek_snapshot("{bad").is_none(), "malformed peek JSON -> None")

  // Peek modal sizing (~84% x 86% at 1280x800, safe on narrow viewport)
  let (pw, ph) = peek_modal_size(1280.0, 800.0)
  debug_assert(pw > 1000.0 && pw <= 1120.0, "desktop peek width")
  debug_assert(ph > 640.0 && ph <= 760.0, "desktop peek height")
  let (nw, nh) = peek_modal_size(360.0, 320.0)
  debug_assert(nw >= 320.0 && nh >= 260.0, "narrow peek bounds")

  // Tab Hover Preview URL display, 2-line title clamp, badges & Y clamping
  debug_assert(
    tab_preview_display_title("Short Title") == "Short Title",
    "short title unchanged",
  )
  let clamped_t = tab_preview_display_title("Farview Architecture & Metal Renderer Spec — Live Audio Walkthrough")
  debug_assert(clamped_t.length() <= 50 && clamped_t.ends_with("…"), "long title cleanly ellipsized for 2 lines")
  debug_assert(
    tab_preview_display_url("https://www.github.com/AFK-surf/farview?utm_source=arc") == "github.com/AFK-surf/farview",
    "tab preview cleaned readable host/path",
  )
  let badges = build_tab_preview_badges("Work", true, true, true, false, true, true)
  debug_assert(badges.length() == 6, "all 6 active badges present")
  debug_assert(badges[0].kind == "space" && badges[0].label == "Work", "space badge")
  debug_assert(badges[3].kind == "playing", "playing badge")
  let muted_badges = build_tab_preview_badges("Personal", false, false, true, true, false, false)
  debug_assert(muted_badges.length() == 2 && muted_badges[1].kind == "muted", "muted overrides playing")
  debug_assert(clamp_tab_preview_y(10.0, 140.0, 800.0, 52.0) == 52.0, "top clamp")
  debug_assert(clamp_tab_preview_y(750.0, 140.0, 800.0, 52.0) == 648.0, "bottom clamp")

  // Cmd+O expands Peek; Cmd+Shift+C copies clean URL
  let expand_sc = dispatch_browser_shortcut(1111, SHORTCUT_MOD_CMD, true, false, false, false)
  debug_assert(expand_sc is BrowserShortcut::ExpandPeek, "Cmd+O -> ExpandPeek")
  let copy_sc = dispatch_browser_shortcut(1099, SHORTCUT_MOD_CMD | SHORTCUT_MOD_SHIFT, true, false, false, false)
  debug_assert(copy_sc is BrowserShortcut::CopyCurrentUrl, "Cmd+Shift+C -> CopyCurrentUrl")

  // Command Bar includes Open Current Page in Peek & Copy Clean URL
  let ws = WorkspaceSnapshot::empty()
  let pk_items = build_command_bar_items(ws, "open current page in peek", "https://example.com", true)
  let mut found_pk = false
  let mut i = 0
  while i < pk_items.length() {
    if pk_items[i].id == "open_current_in_peek" {
      found_pk = true
    }
    i = i + 1
  }
  debug_assert(found_pk, "Command Bar includes Open Current Page in Peek")
  let cp_items = build_command_bar_items(ws, "copy clean url", "https://example.com?utm_source=x", true)
  let mut found_cp = false
  let mut j = 0
  while j < cp_items.length() {
    if cp_items[j].id == "copy_url" && cp_items[j].title == "Copy clean URL" {
      found_cp = true
    }
    j = j + 1
  }
  debug_assert(found_cp, "Command Bar includes Copy Clean URL")
}

test "split view double-click reset, find counter & history time-range clear" {
  // Split View double-click & reset helpers
  debug_assert(split_is_double_click(1000.0, 1250.0), "250ms is double click")
  debug_assert(split_is_double_click(1000.0, 1350.0), "350ms boundary is double click")
  debug_assert(!split_is_double_click(1000.0, 1351.0), "351ms is not double click")
  debug_assert(!split_is_double_click(0.0, 100.0), "no previous click")
  debug_assert(!split_is_double_click(1200.0, 1100.0), "backwards clock rejected")
  debug_assert(split_reset_ratio() == 0.5, "double-click resets to 50/50")
  let (nlw, nrw) = split_pane_widths(386.0, 0.25)
  debug_assert(nlw > 130.0 && nrw > 130.0 && (nlw + nrw - 380.0).abs() < 0.01, "narrow screen proportional fallback")

  // Find-in-Page counter, normalization, flags, cyclic step
  debug_assert(format_find_counter("", -1, 0) == "", "empty query hides 0 / 0")
  debug_assert(format_find_counter("   ", 0, 5) == "", "whitespace query hides counter")
  debug_assert(format_find_counter("farview", -1, 0) == "0 / 0", "non-empty zero matches")
  debug_assert(format_find_counter("farview", 2, 14) == "3 / 14", "1-based counter")
  debug_assert(format_find_counter("farview", 99, 14) == "14 / 14", "clamped upper bound")
  debug_assert(format_find_counter("farview", -3, 14) == "1 / 14", "clamped lower bound")
  debug_assert(find_is_empty_result("xyz", 0), "empty result true")
  debug_assert(!find_is_empty_result("", 0), "empty query not empty result")
  debug_assert(!find_is_empty_result("xyz", 2), "matches found not empty result")
  debug_assert(find_flags_for(false, false) == "", "no flags")
  debug_assert(find_flags_for(true, false) == "case", "case flag")
  debug_assert(find_flags_for(false, true) == "word", "word flag")
  debug_assert(find_flags_for(true, true) == "case,word", "both flags")
  debug_assert(find_step_index(0, 5, 1) == 1, "step forward")
  debug_assert(find_step_index(4, 5, 1) == 0, "step forward wrap")
  debug_assert(find_step_index(0, 5, -1) == 4, "step backward wrap")
  debug_assert(find_step_index(0, 0, 1) == -1, "step empty")

  // History time bucketing, zero-empty-group headers, filtering & time-range clear
  let now_s : Int64 = 1795520000L // 2026-11-24 UTC
  let today_10m = now_s - 600L
  let today_2h = now_s - 7200L
  let yesterday_s = now_s - 86400L
  let earlier_3d = now_s - 3L * 86400L
  let earlier_10d = now_s - 10L * 86400L
  debug_assert(history_time_bucket(today_10m, now_s) == HISTORY_BUCKET_TODAY, "today bucket")
  debug_assert(history_time_bucket(yesterday_s, now_s) == HISTORY_BUCKET_YESTERDAY, "yesterday bucket")
  debug_assert(history_time_bucket(earlier_3d, now_s) == HISTORY_BUCKET_EARLIER, "earlier bucket")
  debug_assert(history_bucket_label(HISTORY_BUCKET_TODAY) == "Today", "today label")
  debug_assert(history_bucket_label(HISTORY_BUCKET_YESTERDAY) == "Yesterday", "yesterday label")
  debug_assert(history_bucket_label(HISTORY_BUCKET_EARLIER) == "Earlier", "earlier label")

  let h_items : Array[HistoryItemSummary] = [
    HistoryItemSummary::{ url: "https://github.com/AFK-surf/farview", title: "Farview Repo", host: "github.com", visit_count: 8, last_visit_secs: today_10m },
    HistoryItemSummary::{ url: "https://news.ycombinator.com/", title: "Hacker News", host: "news.ycombinator.com", visit_count: 4, last_visit_secs: today_2h },
    HistoryItemSummary::{ url: "https://developer.apple.com/metal/", title: "Apple Metal Docs", host: "developer.apple.com", visit_count: 3, last_visit_secs: yesterday_s },
    HistoryItemSummary::{ url: "https://en.wikipedia.org/wiki/Web_browser", title: "Web browser - Wikipedia", host: "en.wikipedia.org", visit_count: 2, last_visit_secs: earlier_3d },
    HistoryItemSummary::{ url: "https://www.rust-lang.org/", title: "Rust Programming Language", host: "www.rust-lang.org", visit_count: 1, last_visit_secs: earlier_10d },
  ]
  debug_assert(history_section_header_at(h_items, 0, now_s) == "Today", "first item starts Today")
  debug_assert(history_section_header_at(h_items, 1, now_s) == "", "second Today item has no duplicate header")
  debug_assert(history_section_header_at(h_items, 2, now_s) == "Yesterday", "third item starts Yesterday")
  debug_assert(history_section_header_at(h_items, 3, now_s) == "Earlier", "fourth item starts Earlier")
  debug_assert(history_section_header_at(h_items, 4, now_s) == "", "fifth item stays in Earlier")

  // Filtering
  let f_metal = history_filter_items(h_items, "METAL")
  debug_assert(f_metal.length() == 1 && f_metal[0].host == "developer.apple.com", "case-insensitive title filter")
  let f_gh = history_filter_items(h_items, "afk-surf")
  debug_assert(f_gh.length() == 1 && f_gh[0].title == "Farview Repo", "url substring filter")
  let f_all = history_filter_items(h_items, "  ")
  debug_assert(f_all.length() == 5, "blank query returns all")

  // UTF-8 CJK / accented / em-dash mixed-case regression test
  let utf8_items : Array[HistoryItemSummary] = [
    HistoryItemSummary::{ url: "https://docs.farview.dev/zh/arch", title: "Farview 浏览器 — 架构文档", host: "docs.farview.dev", visit_count: 6, last_visit_secs: today_10m },
    HistoryItemSummary::{ url: "https://example.fr/cafe", title: "Café & Résumé Notes", host: "example.fr", visit_count: 2, last_visit_secs: today_2h },
  ]
  let f_cjk = history_filter_items(utf8_items, "浏览器")
  debug_assert(f_cjk.length() == 1 && f_cjk[0].host == "docs.farview.dev", "UTF-8 CJK substring filter")
  let f_mix = history_filter_items(utf8_items, "FARVIEW")
  debug_assert(f_mix.length() == 1 && f_mix[0].title == "Farview 浏览器 — 架构文档", "UTF-8 mixed ASCII case filter")
  let f_dash = history_filter_items(utf8_items, "— 架构")
  debug_assert(f_dash.length() == 1 && f_dash[0].host == "docs.farview.dev", "UTF-8 em-dash + CJK filter")
  let f_acc = history_filter_items(utf8_items, "café")
  debug_assert(f_acc.length() == 1 && f_acc[0].host == "example.fr", "UTF-8 accented character filter")

  // Time-range clearing
  debug_assert(history_clear_range_label("hour") == "Last Hour", "hour label")
  debug_assert(history_clear_range_label("24h") == "Last 24h", "24h label")
  debug_assert(history_clear_range_label("7d") == "Last 7d", "7d label")
  debug_assert(history_clear_range_label("") == "All", "empty defaults to All")
  debug_assert(!history_should_keep_after_clear(today_10m, "hour", now_s), "10m ago removed by Last Hour")
  debug_assert(history_should_keep_after_clear(today_2h, "hour", now_s), "2h ago kept by Last Hour")
  debug_assert(!history_should_keep_after_clear(today_2h, "24h", now_s), "2h ago removed by Last 24h")
  debug_assert(history_should_keep_after_clear(earlier_3d, "24h", now_s), "3d ago kept by Last 24h")
  debug_assert(!history_should_keep_after_clear(earlier_3d, "7d", now_s), "3d ago removed by Last 7d")
  debug_assert(history_should_keep_after_clear(earlier_10d, "7d", now_s), "10d ago kept by Last 7d")
  debug_assert(!history_should_keep_after_clear(earlier_10d, "all", now_s), "all removes everything")
}

test "SiteCookiesState JSON round-trip, malformed resilience, UTF-8 masking and filtering" {
  let snap = SiteCookiesSnapshot::{
    host: "github.com",
    origin: "https://github.com",
    space_id: "work",
    cookies: [
      SiteCookieRow::{
        name: "__Host-user_session",
        domain: "github.com",
        path: "/",
        value_preview: mask_cookie_value_preview("ghs_9a8b7c6d5e4f3a2b1c0d9xQ2"),
        secure: true,
        http_only: true,
        same_site: "Lax",
        partitioned: true,
        expires_label: "14d",
        is_session: false,
      },
      SiteCookieRow::{
        name: "偏好设置_theme",
        domain: ".github.com",
        path: "/settings",
        value_preview: mask_cookie_value_preview("深色主题_dark_mode_v2"),
        secure: true,
        http_only: false,
        same_site: "Strict",
        partitioned: false,
        expires_label: "Session",
        is_session: true,
      },
      SiteCookieRow::{
        name: "_octo",
        domain: ".github.com",
        path: "/",
        value_preview: mask_cookie_value_preview("abc"),
        secure: false,
        http_only: false,
        same_site: "None",
        partitioned: false,
        expires_label: "1y",
        is_session: false,
      },
    ],
  }
  debug_assert(snap.cookies[0].value_preview == "ghs_••••9xQ2 (28 B)", "ASCII token value masked with prefix/suffix")
  debug_assert(snap.cookies[1].value_preview.contains("••••"), "UTF-8 value safely masked without mid-byte slice")
  debug_assert(snap.cookies[2].value_preview == "••••", "short value masked")
  debug_assert(mask_cookie_value_preview("") == "(empty)", "empty value preview")

  let encoded = encode_site_cookies_state(snap)
  match parse_site_cookies_state(encoded) {
    Some(dec) => {
      debug_assert(dec.host == "github.com", "host round-trip")
      debug_assert(dec.origin == "https://github.com", "origin round-trip")
      debug_assert(dec.space_id == "work", "space_id round-trip")
      debug_assert(dec.cookies.length() == 3, "3 cookies round-trip")
      debug_assert(dec.cookies[0].name == "__Host-user_session", "cookie 0 name")
      debug_assert(dec.cookies[0].secure && dec.cookies[0].http_only && dec.cookies[0].partitioned, "cookie 0 flags")
      debug_assert(dec.cookies[0].same_site == "Lax", "cookie 0 sameSite")
      debug_assert(dec.cookies[1].name == "偏好设置_theme", "UTF-8 cookie name preserved")
      debug_assert(dec.cookies[1].same_site == "Strict" && dec.cookies[1].is_session, "cookie 1 attributes")
    }
    None => debug_assert(false, "parse_site_cookies_state should succeed")
  }

  // Truncation resilience
  debug_assert(parse_site_cookies_state("{") is None, "truncated object")
  debug_assert(parse_site_cookies_state("{\"host\":\"a\",\"cookies\":[{\"name\":\"x\"") is None, "truncated cookie row")
  debug_assert(parse_site_cookies_state("not-json") is None, "malformed json")

  // UTF-8 safe filtering by CJK name, ASCII case-insensitive, and security attributes
  debug_assert(filter_site_cookies(snap.cookies, "偏好设置").length() == 1, "CJK cookie filter")
  debug_assert(filter_site_cookies(snap.cookies, "CHIPS").length() == 1, "CHIPS attribute filter")
  debug_assert(filter_site_cookies(snap.cookies, "httponly").length() == 1, "HttpOnly attribute filter")
  debug_assert(filter_site_cookies(snap.cookies, "STRICT").length() == 1, "SameSite filter")
  debug_assert(filter_site_cookies(snap.cookies, "").length() == 3, "empty query returns all")
}

test "Upgraded Downloads category classification and UTF-8 safe filtering" {
  let items : Array[DownloadSummary] = [
    DownloadSummary::{
      id: "1",
      filename: "Q4_设计评审报告.pdf",
      url: "https://docs.example.com/q4.pdf",
      mime: "application/pdf",
      bytes: 2457600L,
      state: "completed", path: "" },
    DownloadSummary::{
      id: "2",
      filename: "hero-banner-2x.png",
      url: "https://cdn.figma.com/hero-banner-2x.png",
      mime: "image/png",
      bytes: 842100L,
      state: "completed", path: "" },
    DownloadSummary::{
      id: "3",
      filename: "farview-macos-arm64.zip",
      url: "https://releases.farview.dev/farview.zip",
      mime: "application/zip",
      bytes: 18432000L,
      state: "in_progress", path: "" },
  ]
  debug_assert(download_category(items[0]) == "pdf", "pdf category")
  debug_assert(download_category(items[1]) == "images", "images category")
  debug_assert(download_category(items[2]) == "other", "other category")
  debug_assert(filter_downloads(items, "", "all").length() == 3, "all downloads")
  debug_assert(filter_downloads(items, "", "pdf").length() == 1, "pdf filter")
  debug_assert(filter_downloads(items, "", "images").length() == 1, "images filter")
  debug_assert(filter_downloads(items, "", "other").length() == 1, "other filter")
  debug_assert(filter_downloads(items, "设计评审", "all").length() == 1, "CJK filename search")
  debug_assert(filter_downloads(items, "FIGMA", "images").length() == 1, "case-insensitive host + category")
  debug_assert(download_copy_path(items[0]) == "~/Downloads/Q4_设计评审报告.pdf", "copy path format")

  let ws = WorkspaceSnapshot::empty()
  let cmds = build_command_bar_items(ws, "cookie", "https://github.com", true)
  let mut found_cookie_cmd = false
  let mut i = 0
  while i < cmds.length() {
    if cmds[i].id == "inspect_cookies" {
      found_cookie_cmd = true
    }
    i = i + 1
  }
  debug_assert(found_cookie_cmd, "Command Bar includes inspect_cookies action")
}

test "tab_filter_zoom_ui: UTF-8 multi-language sidebar tab filtering and stats" {
  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "t1",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "blue", theme: space_theme_unset(), active: true, tab_count: 6 },
      SpaceSummary::{ id: "life", name: "Life", accent: "green", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [
      FolderSummary::{ id: "f-docs", space_id: "work", name: "文档 Docs", collapsed: false, color: "cyan" },
    ],
    tabs: [
      TabSummary::{ id: "t1", space_id: "work", title: "Farview 浏览器架构", url: "https://github.com/AFK-surf/farview", pinned: true, favorite: false, active: true, state: "live", folder_id: "", last_active_secs: 100L },
      TabSummary::{ id: "t2", space_id: "work", title: "東京天気予報", url: "https://weather.jp/tokyo", pinned: true, favorite: false, active: false, state: "live", folder_id: "f-docs", last_active_secs: 90L },
      TabSummary::{ id: "t3", space_id: "work", title: "서울 개발자 문서", url: "https://dev.kr/docs", pinned: false, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 80L },
      TabSummary::{ id: "t4", space_id: "work", title: "Hacker News", url: "https://news.ycombinator.com/item?id=42", pinned: false, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 70L },
      TabSummary::{ id: "t5", space_id: "work", title: "Pinned Fav", url: "https://mail.google.com", pinned: true, favorite: true, active: false, state: "live", folder_id: "", last_active_secs: 60L },
      TabSummary::{ id: "t6", space_id: "life", title: "Other Space", url: "https://example.org", pinned: false, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 50L },
    ],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }

  // Blank query matches all non-favorite tabs in space "work" (4 tabs: t1, t2, t3, t4)
  let s_all = tab_filter_compute_stats(snap, "work", "")
  debug_assert(s_all.total == 4 && s_all.matched == 4 && !s_all.active, "blank filter stats")
  debug_assert(!tab_filter_has_clear_button("   "), "no clear button on blank query")

  // ASCII case-insensitive title / host match
  debug_assert(tab_filter_matches(snap.tabs[0], "FARVIEW"), "ASCII uppercase matches mixed case title")
  debug_assert(tab_filter_matches(snap.tabs[3], "YCOMBINATOR.COM"), "host match case-insensitive")
  let s_hn = tab_filter_compute_stats(snap, "work", "  hacker ")
  debug_assert(s_hn.matched == 1 && s_hn.total == 4 && s_hn.today_matched == 1 && s_hn.active, "single today match")
  debug_assert(tab_filter_badge_label(s_hn.matched, s_hn.total) == "1 / 4", "badge label")
  debug_assert(tab_filter_has_clear_button("hacker"), "clear button shown for non-empty query")

  // UTF-8 CJK / Japanese / Korean matching stays intact
  debug_assert(tab_filter_matches(snap.tabs[0], "浏览器"), "Chinese match")
  debug_assert(tab_filter_matches(snap.tabs[1], "東京"), "Japanese match")
  debug_assert(tab_filter_matches(snap.tabs[2], "서울"), "Korean match")
  let s_cn = tab_filter_compute_stats(snap, "work", "文档")
  debug_assert(s_cn.matched == 1 && s_cn.folder_matched == 1, "folder name CJK match includes folder child")

  // Zero matches
  let s_none = tab_filter_compute_stats(snap, "work", "zzzz-no-match")
  debug_assert(s_none.matched == 0 && s_none.total == 4 && s_none.active, "zero matches")
  debug_assert(tab_filter_badge_label(s_none.matched, s_none.total) == "0 / 4", "zero badge")
}

test "tab_filter_zoom_ui: tab_close_others eligibility and mute/pin labels" {
  let snap = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "t3",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "blue", theme: space_theme_unset(), active: true, tab_count: 5 },
      SpaceSummary::{ id: "life", name: "Life", accent: "green", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [],
    tabs: [
      TabSummary::{ id: "t1", space_id: "work", title: "Pinned", url: "https://a.com", pinned: true, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 10L },
      TabSummary::{ id: "t2", space_id: "work", title: "Fav", url: "https://b.com", pinned: true, favorite: true, active: false, state: "live", folder_id: "", last_active_secs: 20L },
      TabSummary::{ id: "t3", space_id: "work", title: "Today A", url: "https://c.com", pinned: false, favorite: false, active: true, state: "live", folder_id: "", last_active_secs: 30L },
      TabSummary::{ id: "t4", space_id: "work", title: "Today B", url: "https://d.com", pinned: false, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 40L },
      TabSummary::{ id: "t5", space_id: "work", title: "Today C", url: "https://e.com", pinned: false, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 50L },
      TabSummary::{ id: "t6", space_id: "life", title: "Life Today", url: "https://f.com", pinned: false, favorite: false, active: false, state: "live", folder_id: "", last_active_secs: 60L },
    ],
    permissions: None,
    closed_count: 0,
    media: Some(MediaMiniState::{
      tab_id: "t3",
      title: "Today A",
      host: "c.com",
      playing: true,
      muted: true,
      is_meeting: false,
      accent: "blue",
    }),
    nav_back: [],
    nav_forward: [],
  }

  // Closing others from t3 closes t4 and t5 only (keeps pinned t1, fav t2, and other-space t6)
  let ids_from_t3 = tab_close_others_ids(snap, "t3")
  debug_assert(ids_from_t3.length() == 2 && ids_from_t3[0] == "t4" && ids_from_t3[1] == "t5", "close others from Today tab")
  debug_assert(tab_close_others_enabled(snap, "t3"), "enabled when other Today tabs exist")

  // Closing others from pinned t1 closes all 3 Today tabs in work
  debug_assert(tab_close_others_count(snap, "t1") == 3, "close others from Pinned tab")

  // In space "life", t6 is the only Today tab -> disabled
  debug_assert(!tab_close_others_enabled(snap, "t6"), "disabled when no other Today tabs in space")
  debug_assert(tab_close_others_count(snap, "t6") == 0, "0 count in single-tab space")

  // Mute / Pin labels
  debug_assert(tab_mute_menu_label(snap, "t3") == "Unmute Tab", "muted tab shows Unmute")
  debug_assert(tab_mute_menu_label(snap, "t4") == "Mute Tab", "unmuted tab shows Mute")
  debug_assert(tab_pin_menu_label(snap.tabs[0]) == "Unpin Tab", "pinned tab shows Unpin")
  debug_assert(tab_pin_menu_label(snap.tabs[2]) == "Pin Tab", "unpinned tab shows Pin")
}

test "tab_filter_zoom_ui: omnibox zoom pill visibility, formatting, ladder fraction & demo parser" {
  debug_assert(!zoom_pill_visible(1.0), "100% hides zoom pill")
  debug_assert(zoom_pill_visible(1.25), "125% shows zoom pill")
  debug_assert(zoom_pill_visible(0.8), "80% shows zoom pill")
  debug_assert(zoom_pill_label(1.25) == "125%", "125% label")
  debug_assert(zoom_pill_label(0.8) == "80%", "80% label")

  debug_assert(!zoom_can_step_down(0.5), "cannot step down at 50%")
  debug_assert(zoom_can_step_down(0.67), "can step down at 67%")
  debug_assert(!zoom_can_step_up(3.0), "cannot step up at 300%")
  debug_assert(zoom_can_step_up(2.5), "can step up at 250%")
  debug_assert(zoom_is_default(1.0) && !zoom_is_default(1.25), "default check")

  debug_assert(zoom_step_index(0.5) == 0, "50% is step 0")
  debug_assert(zoom_step_index(1.0) == 5, "100% is step 5")
  debug_assert(zoom_step_index(1.25) == 7, "125% is step 7")
  debug_assert(zoom_step_index(3.0) == 12, "300% is step 12")
  debug_assert(math_abs(zoom_scale_fraction(0.5) - 0.0) < 1.0e-9, "50% fraction is 0.0")
  debug_assert(math_abs(zoom_scale_fraction(1.0) - zoom_default_marker_fraction()) < 1.0e-9, "100% aligns with default marker")
  debug_assert(math_abs(zoom_scale_fraction(3.0) - 1.0) < 1.0e-9, "300% fraction is 1.0")

  debug_assert(zoom_popover_host_label("https://news.ycombinator.com/news") == "news.ycombinator.com", "host label")
  debug_assert(zoom_popover_host_label("") == "Current Page", "empty URL fallback")

  match parse_demo_zoom_pct("125") {
    Some(z) => debug_assert(zoom_percent(z) == 125, "parse 125 -> 125%")
    None => debug_assert(false, "expected Some(1.25)")
  }
  match parse_demo_zoom_pct("80%") {
    Some(z) => debug_assert(zoom_percent(z) == 80, "parse 80% -> 80%")
    None => debug_assert(false, "expected Some(0.8)")
  }
  match parse_demo_zoom_pct("1.5") {
    Some(z) => debug_assert(zoom_percent(z) == 150, "parse 1.5 -> 150%")
    None => debug_assert(false, "expected Some(1.5)")
  }
  debug_assert(parse_demo_zoom_pct("bad").is_none(), "invalid demo zoom returns None")
}

test "spaces_closed_print_ui: Arc Spaces palette, delete guard & tab count badge" {
  let presets = arc_space_accent_presets()
  debug_assert(presets.length() == 6, "6 classic Arc accent presets")
  debug_assert(presets[0].key == "blue" && presets[0].hex == "#2563EB", "blue preset")
  debug_assert(presets[1].key == "purple" && presets[1].hex == "#8B5CF6", "purple preset")
  debug_assert(presets[2].key == "emerald" && presets[2].hex == "#10B981", "emerald preset")
  debug_assert(presets[3].key == "amber" && presets[3].hex == "#F59E0B", "amber preset")
  debug_assert(presets[4].key == "rose" && presets[4].hex == "#F43F5E", "rose preset")
  debug_assert(presets[5].key == "slate" && presets[5].hex == "#64748B", "slate preset")

  debug_assert(space_accent_hex_for_key("purple") == "#8B5CF6", "key -> hex")
  debug_assert(space_accent_hex_for_key("ROSE") == "#F43F5E", "uppercase key -> hex")
  debug_assert(space_accent_hex_for_key("slate") == "#64748B", "slate -> hex")
  debug_assert(space_accent_hex_for_key("#10b981") == "#10B981", "hex passthrough")
  debug_assert(space_accent_label_for_hex("#f43f5e") == "Rose", "label for rose")
  debug_assert(space_accent_label_for_hex("#64748b") == "Slate", "label for slate")

  let one_space = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "1",
    spaces: [SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 1 }],
    folders: [],
    tabs: [],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
  debug_assert(!space_can_delete(one_space, "work"), "cannot delete the sole remaining Space")
  let two_spaces = WorkspaceSnapshot::{
    ..one_space,
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 3 },
      SpaceSummary::{ id: "design", name: "设计调研", accent: "#8B5CF6", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
  }
  debug_assert(space_can_delete(two_spaces, "design"), "can delete when >1 spaces exist")
  debug_assert(!space_can_delete(two_spaces, "missing"), "cannot delete non-existent space")
  debug_assert(space_tab_count_label(0) == "0 tabs", "0 tabs")
  debug_assert(space_tab_count_label(1) == "1 tab", "1 tab")
  debug_assert(space_tab_count_label(5) == "5 tabs", "5 tabs")
}

test "spaces_closed_print_ui: ClosedTabsState JSON codec, UTF-8 filter & relative time" {
  let snap = ClosedTabsSnapshot::{
    items: [
      ClosedTabItem::{
        index: 0,
        title: "设计调研 — Arc Spaces",
        url: "https://farview.dev/spaces",
        host: "farview.dev",
        space_name: "设计调研",
        closed_secs: 1795516700L,
      },
      ClosedTabItem::{
        index: 1,
        title: "Pion Language Reference",
        url: "https://pionlang.dev/docs",
        host: "pionlang.dev",
        space_name: "Work",
        closed_secs: 1795516100L,
      },
    ],
  }
  let encoded = encode_closed_tabs_state(snap)
  match parse_closed_tabs_state(encoded) {
    Some(dec) => {
      debug_assert(dec.items.length() == 2, "decoded 2 closed tabs")
      debug_assert(dec.items[0].index == 0 && dec.items[0].title == "设计调研 — Arc Spaces", "UTF-8 title preserved")
      debug_assert(dec.items[0].space_name == "设计调研" && dec.items[0].closed_secs == 1795516700L, "space_name & ts")
      debug_assert(dec.items[1].host == "pionlang.dev", "second item host")
    }
    None => debug_assert(false, "parse_closed_tabs_state failed")
  }
  // Truncated / malformed payloads must return None
  debug_assert(parse_closed_tabs_state("{\"items\":[").is_none(), "truncated json returns None")
  debug_assert(parse_closed_tabs_state("not-json").is_none(), "invalid json returns None")

  // UTF-8 safe search filter
  let cjk = filter_closed_tabs(snap.items, "调研")
  debug_assert(cjk.length() == 1 && cjk[0].index == 0, "UTF-8 CJK query matches")
  let ascii = filter_closed_tabs(snap.items, "PIONLANG")
  debug_assert(ascii.length() == 1 && ascii[0].index == 1, "ASCII case-insensitive host match")
  debug_assert(filter_closed_tabs(snap.items, "").length() == 2, "empty query returns all")

  // Relative time formatting
  let now = 1795516740L
  debug_assert(format_closed_relative_time(now - 20L, now) == "Just now", "<60s -> Just now")
  debug_assert(format_closed_relative_time(now - 300L, now) == "5m ago", "5m ago")
  debug_assert(format_closed_relative_time(now - 7200L, now) == "2h ago", "2h ago")
  debug_assert(format_closed_relative_time(now - 90000L, now) == "Yesterday", "Yesterday")
  debug_assert(format_closed_relative_time(now - 260000L, now) == "3d ago", "3d ago")
}

test "spaces_closed_print_ui: PrintPdfConfig dimensions, aspect ratio, margins & JSON codec" {
  let def = print_pdf_default_config()
  let (aw, ah) = print_pdf_dimensions_mm(def)
  debug_assert(math_abs(aw - 210.0) < 0.01 && math_abs(ah - 297.0) < 0.01, "A4 portrait mm")
  let (apx, ahpx) = print_pdf_dimensions_px(def)
  debug_assert(math_abs(apx - 794.0) < 1.0 && math_abs(ahpx - 1123.0) < 1.0, "A4 portrait px")
  debug_assert(print_pdf_spec_summary(def) == "210 × 297 mm", "A4 summary")

  let land_letter = PrintPdfConfig::{
    paper: "letter",
    orientation: "landscape",
    margins: "narrow",
    background_graphics: false,
  }
  let (lw, lh) = print_pdf_dimensions_mm(land_letter)
  debug_assert(math_abs(lw - 279.4) < 0.01 && math_abs(lh - 215.9) < 0.01, "Letter landscape swaps w/h")
  debug_assert(print_pdf_aspect_ratio(land_letter) > 1.2, "landscape aspect ratio > 1")
  debug_assert(print_pdf_aspect_ratio(def) < 0.75, "portrait aspect ratio < 1")
  debug_assert(math_abs(print_pdf_margin_mm("default") - 12.7) < 0.01, "default margin 12.7mm")
  debug_assert(math_abs(print_pdf_margin_mm("narrow") - 6.35) < 0.01, "narrow margin 6.35mm")
  debug_assert(math_abs(print_pdf_margin_mm("none") - 0.0) < 0.01, "none margin 0mm")
  let (mfx, mfy) = print_pdf_margin_fraction(land_letter)
  debug_assert(mfx > 0.02 && mfx < 0.03 && mfy > 0.025 && mfy < 0.035, "narrow margin fractions")

  let enc = encode_print_pdf_config(land_letter)
  let dec = parse_print_pdf_config(enc)
  debug_assert(dec.paper == "letter" && dec.orientation == "landscape" && dec.margins == "narrow" && !dec.background_graphics, "PrintPdfConfig JSON round-trip")
  let enc_req = encode_print_pdf_config_with_req(land_letter, "pdf-123-0-7")
  let dec_req = parse_print_pdf_config(enc_req)
  debug_assert(dec_req.paper == "letter" && dec_req.orientation == "landscape" && dec_req.margins == "narrow" && !dec_req.background_graphics, "parse_print_pdf_config skips reqId losslessly")
  debug_assert(parse_print_pdf_req_id(enc_req) == "pdf-123-0-7", "parse_print_pdf_req_id extracts exact reqId")
  debug_assert(parse_print_pdf_req_id(enc) == "" && parse_print_pdf_req_id("bad") == "", "parse_print_pdf_req_id returns empty on absent/malformed")

  let legal_wide = PrintPdfConfig::{
    paper: "legal",
    orientation: "portrait",
    margins: "wide",
    background_graphics: true,
  }
  let (lgw, lgh) = print_pdf_dimensions_mm(legal_wide)
  debug_assert(math_abs(lgw - 215.9) < 0.01 && math_abs(lgh - 355.6) < 0.01, "Legal portrait mm")
  debug_assert(math_abs(print_pdf_margin_mm("wide") - 25.4) < 0.01, "wide margin 25.4mm")
  let dec_lw = parse_print_pdf_config(encode_print_pdf_config(legal_wide))
  debug_assert(dec_lw.paper == "legal" && dec_lw.margins == "wide" && dec_lw.background_graphics, "Legal + Wide JSON round-trip")
}

test "favorites_hud_ui: Site Search prefixes, UTF-8 CJK/Japanese percent-encoding & Omnibox ranking" {
  // Basic ASCII + space encoding
  match match_site_search("@gh farview metal") {
    Some(ss) => {
      debug_assert(ss.engine_id == "github" && ss.badge_text == "Search GitHub" && ss.monogram == "GH", "@gh metadata")
      debug_assert(ss.query == "farview metal", "@gh trimmed query")
      debug_assert(ss.url == "https://github.com/search?q=farview%20metal", "@gh encoded url")
    }
    None => debug_assert(false, "expected @gh match")
  }
  // Case-insensitive + bare keyword aliases
  match match_site_search("GH pion-lang") {
    Some(ss) => debug_assert(ss.url == "https://github.com/search?q=pion-lang", "GH bare alias")
    None => debug_assert(false, "expected GH match")
  }
  match match_site_search("@yt lo-fi beats") {
    Some(ss) => debug_assert(ss.url == "https://www.youtube.com/results?search_query=lo-fi%20beats" && ss.badge_text == "Search YouTube", "@yt url")
    None => debug_assert(false, "expected @yt match")
  }
  match match_site_search("mdn flex-grow") {
    Some(ss) => debug_assert(ss.url == "https://developer.mozilla.org/en-US/search?q=flex-grow" && ss.badge_text == "Search MDN", "mdn url")
    None => debug_assert(false, "expected mdn match")
  }
  match match_site_search("@wiki Rust_language") {
    Some(ss) => debug_assert(ss.url == "https://en.wikipedia.org/w/index.php?search=Rust_language" && ss.badge_text == "Search Wikipedia", "@wiki url")
    None => debug_assert(false, "expected @wiki match")
  }
  match match_site_search("@g weather tokyo") {
    Some(ss) => debug_assert(ss.url == "https://www.google.com/search?q=weather%20tokyo" && ss.badge_text == "Search Google", "@g url")
    None => debug_assert(false, "expected @g match")
  }
  // UTF-8 CJK & Japanese safe percent-encoding
  match match_site_search("@gh 浏览器 引擎") {
    Some(ss) => debug_assert(ss.url == "https://github.com/search?q=%E6%B5%8F%E8%A7%88%E5%99%A8%20%E5%BC%95%E6%93%8E", "Chinese UTF-8 percent encoding")
    None => debug_assert(false, "expected CJK @gh match")
  }
  match match_site_search("@wiki 東京タワー") {
    Some(ss) => debug_assert(ss.url == "https://en.wikipedia.org/w/index.php?search=%E6%9D%B1%E4%BA%AC%E3%82%BF%E3%83%AF%E3%83%BC", "Japanese UTF-8 percent encoding")
    None => debug_assert(false, "expected Japanese @wiki match")
  }
  // Empty query right after space still activates capsule
  match match_site_search("@gh ") {
    Some(ss) => debug_assert(ss.query == "" && ss.url == "https://github.com/search", "@gh trailing space activates capsule")
    None => debug_assert(false, "expected @gh trailing space match")
  }
  // Non-prefix inputs must not falsely match
  debug_assert(match_site_search("github.com/AFK-surf/farview").is_none(), "normal domain must not match")
  debug_assert(match_site_search("ghost").is_none(), "word starting with gh must not match")

  // Omnibox normalization & ranking integration
  debug_assert(omnibox_normalize_input("@mdn grid-template") == "https://developer.mozilla.org/en-US/search?q=grid-template", "normalize_input routes @mdn")
  debug_assert(omnibox_normalize_input_with_engine("@yt metal shader", "kagi") == "https://www.youtube.com/results?search_query=metal%20shader", "normalize_input_with_engine routes @yt")
  let ranked = rank_omnibox_suggestions("@gh farview metal", [], [], [], 6)
  debug_assert(ranked.length() >= 1, "site search produces top suggestion")
  debug_assert(ranked[0].url == "https://github.com/search?q=farview%20metal", "top suggestion carries encoded URL")
  debug_assert(ranked[0].title.contains("Search GitHub"), "top suggestion title shows Search GitHub")
}

test "favorites_hud_ui: Favorites tile filtering, monograms, PerfHudSnapshot codec & Cmd+Shift+U" {
  let tabs : Array[TabSummary] = [
    TabSummary::{ id: "1", space_id: "work", title: "AFK-surf/farview", url: "https://github.com/AFK-surf/farview", pinned: true, favorite: true, active: true, state: "active", folder_id: "", last_active_secs: 100L },
    TabSummary::{ id: "2", space_id: "work", title: "Music", url: "https://www.youtube.com/watch?v=1", pinned: true, favorite: true, active: false, state: "active", folder_id: "", last_active_secs: 90L },
    TabSummary::{ id: "3", space_id: "personal", title: "Wiki", url: "https://en.wikipedia.org/wiki/Pion", pinned: true, favorite: true, active: false, state: "active", folder_id: "", last_active_secs: 80L },
    TabSummary::{ id: "4", space_id: "work", title: "Normal Tab", url: "https://example.com", pinned: false, favorite: false, active: false, state: "active", folder_id: "", last_active_secs: 70L },
  ]
  let ws = WorkspaceSnapshot::{
    ..WorkspaceSnapshot::empty(),
    active_space_id: "work",
    active_tab_id: "1",
    tabs: tabs,
  }
  let work_favs = workspace_favorite_tiles(ws, "work")
  debug_assert(work_favs.length() == 2, "filters favorites to active space")
  debug_assert(favorite_tile_monogram(work_favs[0]) == "GH" && favorite_tile_short_label(work_favs[0]) == "GitHub", "GitHub monogram & short label")
  debug_assert(favorite_tile_monogram(work_favs[1]) == "YT" && favorite_tile_short_label(work_favs[1]) == "YouTube", "YouTube monogram & short label")
  let empty_favs = workspace_favorite_tiles(ws, "empty-space")
  debug_assert(empty_favs.length() == 0, "space with no favorites returns 0 tiles")

  // PerfHudSnapshot JSON round-trip & truncation safety
  let hud = PerfHudSnapshot::{
    host: "github.com",
    scheme: "https",
    is_https: true,
    dom_nodes: 1482,
    stylesheets: 6,
    images: 24,
    fonts: 3,
    doc_width: 1280,
    doc_height: 4280,
    scroll_y: 120,
    rss_mb: 142,
    zoom_pct: 110,
    cookies_count: 8,
    active_space: "Work",
  }
  let enc = encode_perf_hud_snapshot(hud)
  match parse_perf_hud_snapshot(enc) {
    Some(dec) => {
      debug_assert(dec.host == "github.com" && dec.is_https && dec.dom_nodes == 1482, "PerfHudSnapshot host/https/dom")
      debug_assert(dec.stylesheets == 6 && dec.images == 24 && dec.fonts == 3, "PerfHudSnapshot resources")
      debug_assert(dec.doc_width == 1280 && dec.doc_height == 4280 && dec.zoom_pct == 110 && dec.cookies_count == 8 && dec.active_space == "Work", "PerfHudSnapshot dims/zoom/cookies/space")
    }
    None => debug_assert(false, "PerfHudSnapshot round-trip failed")
  }
  debug_assert(parse_perf_hud_snapshot(enc.slice(0, enc.length() / 2)).is_none(), "truncated PerfHudSnapshot returns None")
  debug_assert(perf_hud_format_count(1482) == "1,482", "count formatting with comma")
  debug_assert(perf_hud_format_dims(1280, 4280) == "1280×4280", "dims formatting")
  debug_assert(perf_hud_format_zoom(110) == "110%", "zoom formatting")
  debug_assert(perf_hud_security_badge("https", true) == "HTTPS" && perf_hud_security_badge("http", false) == "HTTP", "security badge")

  // Cmd+Shift+U shortcut & Command Bar entry
  match dispatch_browser_shortcut(1117, SHORTCUT_MOD_CMD | SHORTCUT_MOD_SHIFT, true, false, false, false) {
    BrowserShortcut::TogglePerfHud => ()
    _ => debug_assert(false, "Cmd+Shift+U must dispatch TogglePerfHud")
  }
  let cmds = build_command_bar_items(ws, "performance hud", "https://github.com", true)
  let mut found_hud_cmd = false
  for c in cmds {
    if c.id == "toggle_perf_hud" {
      found_hud_cmd = true
    }
  }
  debug_assert(found_hud_cmd, "Command Bar must include Page Performance HUD action")
}

test "idna_bridge: ASCII fast path, legitimate IDN decoding, anti-spoofing, and URL parts preservation" {
  // 1. Pure ASCII fast path
  let plain = omnibox_analyze_url("https://www.github.com:443/AFK-surf/farview?tab=code#readme")
  debug_assert(!plain.is_idn && !plain.is_spoof_warning, "ASCII URL is not IDN and has no warning")
  debug_assert(plain.display_url == "https://www.github.com:443/AFK-surf/farview?tab=code#readme", "ASCII URL preserved verbatim")
  debug_assert(plain.display_host == "www.github.com" && plain.ascii_host == "www.github.com", "ASCII host preserved")
  debug_assert(plain.warning_summary == "" && plain.warning_detail == "", "ASCII warning fields empty")

  // 2. IPv6, port, path, query, fragment, userinfo, non-hierarchical schemes
  let ipv6 = omnibox_analyze_url("http://[::1]:8080/api/v1?ok=1#top")
  debug_assert(!ipv6.is_idn && !ipv6.is_spoof_warning, "IPv6 literal is safe ASCII")
  debug_assert(ipv6.display_url == "http://[::1]:8080/api/v1?ok=1#top", "IPv6 URL preserved")
  debug_assert(ipv6.display_host == "[::1]", "IPv6 host extracted")
  let about = omnibox_analyze_url("about:newtab")
  debug_assert(!about.is_idn && !about.is_spoof_warning && about.display_url == "about:newtab", "about:newtab unchanged")

  // 3. Legitimate multilingual IDNs decode cleanly with zero false positives
  let de = omnibox_analyze_url("https://xn--mnchen-3ya.de/guide?lang=de#intro")
  debug_assert(de.is_idn && !de.is_spoof_warning, "münchen.de is legitimate IDN")
  debug_assert(de.display_host == "münchen.de" && de.ascii_host == "xn--mnchen-3ya.de", "münchen.de decoded")
  debug_assert(de.display_url == "https://münchen.de/guide?lang=de#intro", "münchen.de path/query/fragment preserved")
  debug_assert(omnibox_display_host("https://xn--mnchen-3ya.de/guide") == "münchen.de/guide", "omnibox_display_host decodes safe IDN")

  let zh = omnibox_analyze_url("https://中文.com/docs")
  debug_assert(zh.is_idn && !zh.is_spoof_warning, "中文.com is legitimate IDN")
  debug_assert(zh.display_host == "中文.com" && zh.display_url == "https://中文.com/docs", "中文.com stays Unicode")

  let gr = omnibox_analyze_url("https://αθήνα.gr/")
  debug_assert(gr.is_idn && !gr.is_spoof_warning && gr.display_host == "αθήνα.gr", "αθήνα.gr is legitimate Greek IDN")

  let ru = omnibox_analyze_url("https://привет.рф/")
  debug_assert(ru.is_idn && !ru.is_spoof_warning && ru.display_host == "привет.рф", "привет.рф is legitimate Cyrillic IDN")

  // 4. Homograph / confusable / spoof domains forced to Punycode + warning
  let spoof_uni = omnibox_analyze_url("https://p\u{0430}ypal.com/signin?next=/home")
  debug_assert(spoof_uni.is_idn && spoof_uni.is_spoof_warning, "Cyrillic-a paypal triggers spoof warning")
  debug_assert(spoof_uni.display_host == "xn--pypal-4ve.com", "paypal spoof forced to Punycode")
  debug_assert(spoof_uni.display_url == "https://xn--pypal-4ve.com/signin?next=/home", "paypal spoof display_url uses Punycode")
  debug_assert(spoof_uni.warning_summary == "Mixed-script homograph", "paypal spoof reason is Mixed-script homograph")
  debug_assert(omnibox_display_host("https://p\u{0430}ypal.com/signin") == "xn--pypal-4ve.com/signin", "omnibox_display_host forces Punycode on spoof")

  let spoof_puny = omnibox_analyze_url("https://xn--pypal-4ve.com/signin")
  debug_assert(spoof_puny.is_idn && spoof_puny.is_spoof_warning, "Punycode paypal spoof triggers warning")
  debug_assert(spoof_puny.display_host == "xn--pypal-4ve.com", "Punycode paypal stays Punycode")

  let apple_spoof = omnibox_analyze_url("https://аррӏе.com/")
  debug_assert(apple_spoof.is_idn && apple_spoof.is_spoof_warning, "whole-script Cyrillic apple triggers warning")
  debug_assert(apple_spoof.display_host.starts_with("xn--"), "Cyrillic apple forced to Punycode")
  debug_assert(apple_spoof.warning_summary == "Confusable character", "whole-script confusable reason")

  let slash_spoof = omnibox_analyze_url("https://google.comノevil.com/")
  debug_assert(slash_spoof.is_idn && slash_spoof.is_spoof_warning, "CJK slash lookalike triggers warning")
  debug_assert(slash_spoof.display_host.contains("xn--"), "CJK slash lookalike forced to Punycode")

  let rlo_spoof = omnibox_analyze_url("https://bank\u{202E}evil.com/")
  debug_assert(rlo_spoof.is_idn && rlo_spoof.is_spoof_warning, "RLO bidi override triggers warning")
  debug_assert(!rlo_spoof.display_url.contains("\u{202E}"), "RLO control character never echoed in display_url")
  debug_assert(rlo_spoof.warning_summary == "Bidi spoofing", "RLO spoof reason is Bidi spoofing")

  // 5. Schemeless host with port and path
  let schemeless = omnibox_analyze_url("xn--mnchen-3ya.de:8443/path")
  debug_assert(schemeless.is_idn && !schemeless.is_spoof_warning, "schemeless IDN with port works")
  debug_assert(schemeless.display_url == "münchen.de:8443/path", "schemeless IDN preserves port and path")
}

test "omnibox instant calculator arithmetic precedence, functions, errors & depth limit" {
  // Precedence, parentheses, decimals & trailing-zero trimming
  match eval_omnibox_calc("1280 * 1.5") {
    Some(r) => debug_assert(r.value == "1920" && r.display == "= 1920", "1280 * 1.5 == 1920")
    None => debug_assert(false, "1280 * 1.5 should evaluate")
  }
  match eval_omnibox_calc("(1920 - 240) / 16") {
    Some(r) => debug_assert(r.value == "105" && r.display == "= 105", "(1920 - 240) / 16 == 105")
    None => debug_assert(false, "(1920 - 240) / 16 should evaluate")
  }
  match eval_omnibox_calc("2 + 3 * 4") {
    Some(r) => debug_assert(r.value == "14", "2 + 3 * 4 == 14")
    None => debug_assert(false, "2 + 3 * 4 should evaluate")
  }
  match eval_omnibox_calc("0.1 + 0.2") {
    Some(r) => debug_assert(r.value == "0.3", "0.1 + 0.2 trimmed cleanly to 0.3")
    None => debug_assert(false, "0.1 + 0.2 should evaluate")
  }
  match eval_omnibox_calc("sqrt(144) + 2^8") {
    Some(r) => debug_assert(r.value == "268" && r.display == "= 268", "sqrt(144) + 2^8 == 268")
    None => debug_assert(false, "sqrt(144) + 2^8 should evaluate")
  }
  match eval_omnibox_calc("abs(-42.5) + round(3.6)") {
    Some(r) => debug_assert(r.value == "46.5", "abs + round")
    None => debug_assert(false, "abs + round should evaluate")
  }
  match eval_omnibox_calc("10 % 3") {
    Some(r) => debug_assert(r.value == "1", "10 % 3 == 1")
    None => debug_assert(false, "10 % 3 should evaluate")
  }
  match eval_omnibox_calc("-5 + 12") {
    Some(r) => debug_assert(r.value == "7", "unary minus -5 + 12 == 7")
    None => debug_assert(false, "-5 + 12 should evaluate")
  }
  match eval_omnibox_calc("(-2)^3") {
    Some(r) => debug_assert(r.value == "-8", "(-2)^3 == -8")
    None => debug_assert(false, "(-2)^3 should evaluate")
  }
  match eval_omnibox_calc("-2^2") {
    Some(r) => debug_assert(r.value == "-4", "-2^2 == -4")
    None => debug_assert(false, "-2^2 should evaluate")
  }

  // Error & boundary guards
  debug_assert(eval_omnibox_calc("10 / 0").is_none(), "div by zero rejected")
  debug_assert(eval_omnibox_calc("10 % 0").is_none(), "mod by zero rejected")
  debug_assert(eval_omnibox_calc("sqrt(-9)").is_none(), "sqrt negative rejected")
  debug_assert(eval_omnibox_calc("(1 + 2").is_none(), "unmatched paren rejected")
  debug_assert(eval_omnibox_calc("1 + 2)").is_none(), "trailing paren rejected")
  debug_assert(eval_omnibox_calc("42").is_none(), "plain number does not trigger calc")
  debug_assert(eval_omnibox_calc("https://example.com").is_none(), "URL does not trigger calc")

  // Nesting depth > OMNIBOX_CALC_MAX_DEPTH rejected safely without stack overflow
  let deep = "((((((((((((((((((((((((((((((((((1+1))))))))))))))))))))))))))))))))))"
  debug_assert(eval_omnibox_calc(deep).is_none(), "nesting depth overflow rejected")
}

test "omnibox instant unit & base conversions and suggestion ranking" {
  match eval_omnibox_calc("24px to rem") {
    Some(r) => debug_assert(r.value == "1.5 rem" && r.display == "= 1.5 rem", "24px to rem")
    None => debug_assert(false, "24px to rem should convert")
  }
  match eval_omnibox_calc("1.5rem to px") {
    Some(r) => debug_assert(r.value == "24 px", "1.5rem to px")
    None => debug_assert(false, "1.5rem to px should convert")
  }
  match eval_omnibox_calc("64 MB to KB") {
    Some(r) => debug_assert(r.value == "65536 KB", "64 MB to KB")
    None => debug_assert(false, "64 MB to KB should convert")
  }
  match eval_omnibox_calc("2048 KB to MB") {
    Some(r) => debug_assert(r.value == "2 MB", "2048 KB to MB")
    None => debug_assert(false, "2048 KB to MB should convert")
  }
  match eval_omnibox_calc("4 GB to MB") {
    Some(r) => debug_assert(r.value == "4096 MB", "4 GB to MB")
    None => debug_assert(false, "4 GB to MB should convert")
  }
  match eval_omnibox_calc("37C to F") {
    Some(r) => debug_assert(r.value == "98.6 °F", "37C to F")
    None => debug_assert(false, "37C to F should convert")
  }
  match eval_omnibox_calc("72F to C") {
    Some(r) => debug_assert(r.value == "22.22 °C", "72F to C")
    None => debug_assert(false, "72F to C should convert")
  }
  match eval_omnibox_calc("0xFF to dec") {
    Some(r) => debug_assert(r.value == "255", "0xFF to dec")
    None => debug_assert(false, "0xFF to dec should convert")
  }
  match eval_omnibox_calc("255 to hex") {
    Some(r) => debug_assert(r.value == "0xFF", "255 to hex")
    None => debug_assert(false, "255 to hex should convert")
  }
  match eval_omnibox_calc("255 to bin") {
    Some(r) => debug_assert(r.value == "0b11111111", "255 to bin")
    None => debug_assert(false, "255 to bin should convert")
  }

  // Ranking pins InstantAnswer at index 0
  let ranked = rank_omnibox_suggestions("(1920 - 240) / 16", [], [], [], 6)
  debug_assert(ranked.length() >= 1, "ranked has instant answer")
  debug_assert(ranked[0].kind is OmniboxSuggestionKind::InstantAnswer, "index 0 is InstantAnswer")
  debug_assert(ranked[0].title == "= 105" && ranked[0].url == "105", "InstantAnswer title and copy value")
}

test "devtools network pro classification, utf8 filter, waterfall ratio & curl escaping" {
  let e_doc = DevToolsNetworkEntry::{ name: "index.html", url: "https://example.com/index.html", kind: "document", status: 200, duration_ms: 40, size_bytes: 4096 }
  let e_js = DevToolsNetworkEntry::{ name: "app.mjs", url: "https://cdn.example.com/app.mjs?v=2", kind: "", status: 200, duration_ms: 100, size_bytes: 20480 }
  let e_css = DevToolsNetworkEntry::{ name: "theme.css", url: "https://cdn.example.com/theme.css", kind: "stylesheet", status: 304, duration_ms: 15, size_bytes: 3200 }
  let e_img = DevToolsNetworkEntry::{ name: "logo.svg", url: "https://cdn.example.com/logo.svg", kind: "", status: 200, duration_ms: 12, size_bytes: 1800 }
  let e_api = DevToolsNetworkEntry::{ name: "sync", url: "https://api.example.com/api/v1/sync?q=it's&lang=中文", kind: "fetch", status: 404, duration_ms: 50, size_bytes: 512 }

  debug_assert(devtools_net_category(e_doc.kind, e_doc.url) == "doc", "doc bucket")
  debug_assert(devtools_net_category(e_js.kind, e_js.url) == "js", "js bucket by ext")
  debug_assert(devtools_net_category(e_css.kind, e_css.url) == "css", "css bucket")
  debug_assert(devtools_net_category(e_img.kind, e_img.url) == "img", "img bucket by ext")
  debug_assert(devtools_net_category(e_api.kind, e_api.url) == "fetch", "fetch bucket")

  debug_assert(devtools_net_matches_filter(e_api, "fetch", "SYNC"), "case-insensitive query match")
  debug_assert(devtools_net_matches_filter(e_api, "all", "中文"), "UTF-8 query match")
  debug_assert(devtools_net_matches_filter(e_api, "all", "404"), "status query match")
  debug_assert(!devtools_net_matches_filter(e_api, "js", ""), "category mismatch excluded")

  debug_assert(devtools_net_waterfall_ratio(100, 100) == 1.0, "max duration ratio is 1.0")
  debug_assert(devtools_net_waterfall_ratio(50, 100) == 0.5, "half duration ratio is 0.5")
  debug_assert(devtools_net_waterfall_ratio(0, 100) == 0.06, "zero duration clamped to minimum visible bar")

  debug_assert(devtools_net_curl_command(e_doc) == "curl 'https://example.com/index.html'", "plain curl single-quoted")
  debug_assert(
    devtools_net_curl_command(e_api) == "curl 'https://api.example.com/api/v1/sync?q=it'\\''s&lang=中文'",
    "curl escapes embedded single quote safely",
  )
}

test "reader pro english + CJK reading time estimation and typography bounds" {
  // Paper theme normalization (including legacy 'dark' -> 'night')
  debug_assert(normalize_reader_paper_theme("Light") == "light", "light theme")
  debug_assert(normalize_reader_paper_theme("SEPIA") == "sepia", "sepia theme")
  debug_assert(normalize_reader_paper_theme("night") == "night", "night theme")
  debug_assert(normalize_reader_paper_theme("dark") == "night", "legacy dark maps to night")
  debug_assert(normalize_reader_paper_theme("unknown") == "light", "fallback light")

  // Font & width bounds
  debug_assert(normalize_reader_font("Sans") == "sans", "sans font")
  debug_assert(normalize_reader_font("SERIF") == "serif", "serif font")
  debug_assert(normalize_reader_font("Mono") == "mono", "mono font")
  debug_assert(reader_column_width_pt("narrow") == 620.0, "narrow 620pt")
  debug_assert(reader_column_width_pt("medium") == 720.0, "medium 720pt")
  debug_assert(reader_column_width_pt("wide") == 840.0, "wide 840pt")
  debug_assert(reader_column_width_pt("invalid") == 720.0, "fallback medium 720pt")

  // Font size 14-24px clamping & stepping
  debug_assert(clamp_reader_font_size(10) == 14, "min clamp 14px")
  debug_assert(clamp_reader_font_size(30) == 24, "max clamp 24px")
  debug_assert(step_reader_font_size(14, -2) == 14, "cannot step below 14px")
  debug_assert(step_reader_font_size(24, 2) == 24, "cannot step above 24px")
  debug_assert(step_reader_font_size(17, 2) == 19, "step up 17->19px")

  // Progress clamping
  debug_assert(clamp_reader_progress(-0.5) == 0.0, "min progress 0")
  debug_assert(clamp_reader_progress(1.5) == 1.0, "max progress 1")
  debug_assert(clamp_reader_progress(0.42) == 0.42, "mid progress preserved")

  // English + CJK word/char count & reading time estimation
  let empty_m = compute_reader_metrics([], title="")
  debug_assert(empty_m.word_count == 0 && empty_m.read_minutes == 1, "empty article defaults to 1 min read")
  debug_assert(format_read_minutes_badge(empty_m.read_minutes) == "1 min read", "1 min read badge")

  let en_blocks = [
    ReaderBlock::{ kind: ReaderBlockKind::Paragraph, level: 0, text: "Farview renders native Metal frames with incremental CSS layout." },
  ]
  let en_m = compute_reader_metrics(en_blocks, title="Native Metal")
  debug_assert(en_m.cjk_chars == 0 && en_m.latin_words == 11 && en_m.word_count == 11, "english word count")
  debug_assert(format_word_count_badge(en_m.word_count) == "11 words", "word badge plural")

  // Mixed English + CJK (~320 CJK chars + 220 English words -> ~2 min read)
  let mut cjk_chunk = ""
  let mut ci = 0
  while ci < 64 {
    cjk_chunk = cjk_chunk + "中文排版测试" // 6 CJK chars * 64 = 384 chars
    ci = ci + 1
  }
  let mut en_chunk = ""
  let mut ei = 0
  while ei < 55 {
    en_chunk = en_chunk + "native metal browser layout " // 4 words * 55 = 220 words
    ei = ei + 1
  }
  let mixed_m = compute_reader_metrics(
    [
      ReaderBlock::{ kind: ReaderBlockKind::Paragraph, level: 0, text: cjk_chunk },
      ReaderBlock::{ kind: ReaderBlockKind::Paragraph, level: 0, text: en_chunk },
    ],
  )
  debug_assert(mixed_m.cjk_chars == 384 && mixed_m.latin_words == 220, "mixed cjk + latin counts")
  debug_assert(mixed_m.word_count == 604 && mixed_m.read_minutes == 2, "mixed reading time ~2 min")
}

test "colored tab folders collapse, count, palette & named session snapshots JSON round-trip and UTF-8 filter" {
  // 6-color folder palette
  debug_assert(folder_color_keys().length() == 6, "6 semantic folder colors")
  debug_assert(normalize_folder_color("EMERALD") == "emerald", "normalize emerald")
  debug_assert(normalize_folder_color("#8B5CF6") == "violet", "normalize violet hex")
  debug_assert(normalize_folder_color("unknown") == "blue", "fallback blue")
  debug_assert(folder_color_rgba("rose") == 0xF43F5EFFL, "rose rgba")

  let ws = WorkspaceSnapshot::{
    active_space_id: "work",
    active_tab_id: "t1",
    spaces: [
      SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 3 },
      SpaceSummary::{ id: "research", name: "研究", accent: "#10B981", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [
      FolderSummary::{ id: "f-arch", space_id: "work", name: "Architecture", collapsed: false, color: "blue" },
      FolderSummary::{ id: "f-zh", space_id: "work", name: "中文资料", collapsed: true, color: "emerald" },
    ],
    tabs: [
      TabSummary::{ id: "t1", space_id: "work", title: "Farview Engine", url: "https://github.com/AFK-surf/farview", pinned: true, favorite: false, active: true, state: "active", folder_id: "f-arch", last_active_secs: 100L },
      TabSummary::{ id: "t2", space_id: "work", title: "MDN CSS", url: "https://developer.mozilla.org/en-US/docs/Web/CSS", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-arch", last_active_secs: 90L },
      TabSummary::{ id: "t3", space_id: "work", title: "渲染架构", url: "https://farview.dev/zh/arch", pinned: true, favorite: false, active: false, state: "background", folder_id: "f-zh", last_active_secs: 80L },
      TabSummary::{ id: "t4", space_id: "research", title: "WPT Matrix", url: "https://wpt.fyi/results/", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 70L },
    ],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }

  debug_assert(folder_tab_count(ws, "work", "f-arch") == 2, "f-arch has 2 tabs")
  debug_assert(folder_tab_count(ws, "work", "f-zh") == 1, "f-zh has 1 tab")
  debug_assert(!folder_is_collapsed(ws, "f-arch") && folder_is_collapsed(ws, "f-zh"), "initial collapse states")
  let toggled = folder_toggle_collapsed_in_snapshot(ws, "f-arch")
  debug_assert(folder_is_collapsed(toggled, "f-arch"), "toggled f-arch to collapsed")

  // Capture named session & JSON round-trip
  let sess1 = capture_named_session("s-1", "Architecture Research", 1795520000L, ws)
  let sess2 = NamedSessionSnapshot::{
    id: "s-2",
    name: "中文 GPU 调研",
    created_secs: 1795510000L,
    active_space_id: "research",
    spaces: [SessionSpaceItem::{ id: "research", name: "研究", accent: "#10B981" }],
    folders: [],
    tabs: [SessionTabItem::{ space_id: "research", title: "Metal 管线", url: "https://developer.apple.com/metal/", pinned: false, favorite: false, folder_id: "" }],
  }
  let state = SavedSessionsState::{ items: [sess1, sess2] }
  let encoded = encode_saved_sessions_state(state)
  match parse_saved_sessions_state(encoded) {
    Some(parsed) => {
      debug_assert(parsed.items.length() == 2, "2 sessions round-tripped")
      debug_assert(parsed.items[0].name == "Architecture Research", "session 1 name")
      debug_assert(parsed.items[0].folders.length() == 2 && parsed.items[0].folders[1].color == "emerald", "folder color preserved")
      debug_assert(parsed.items[1].name == "中文 GPU 调研", "UTF-8 session name preserved")

      // Preview hosts dedupe
      let hosts = session_preview_hosts(parsed.items[0], max_hosts=4)
      debug_assert(hosts.length() == 4 && hosts[0] == "github.com", "preview hosts extracted")

      // UTF-8 filtering by name, folder, domain, and CJK
      debug_assert(filter_named_sessions(parsed.items, "ARCHITECTURE").length() == 1, "case-insensitive name filter")
      debug_assert(filter_named_sessions(parsed.items, "apple.com").length() == 1, "domain filter")
      debug_assert(filter_named_sessions(parsed.items, "中文").length() == 2, "UTF-8 CJK matches both folder and session name")
      debug_assert(filter_named_sessions(parsed.items, "调研").length() == 1, "UTF-8 CJK session name filter")
      debug_assert(filter_named_sessions(parsed.items, "nonexistent").length() == 0, "no-match filter")

      // Restore conversion
      let restored_ws = session_to_workspace_snapshot(parsed.items[0])
      debug_assert(restored_ws.spaces.length() == 2 && restored_ws.folders.length() == 2 && restored_ws.tabs.length() == 4, "restore workspace snapshot")
    }
    None => debug_assert(false, "SavedSessionsState JSON parse failed")
  }

  // Malformed / truncated JSON safety
  debug_assert(parse_saved_sessions_state("").is_none(), "empty json rejected")
  debug_assert(parse_saved_sessions_state("{\"items\":[{\"id\":\"s-1\"").is_none(), "truncated json rejected")

  // Timestamp formatting
  debug_assert(format_session_timestamp(1000L, 1020L) == "Just now", "just now")
  debug_assert(format_session_timestamp(1000L, 1900L) == "15m ago", "minutes ago")
  debug_assert(format_session_timestamp(1000L, 8200L) == "2h ago", "hours ago")
  debug_assert(format_session_timestamp(1000L, 100000L) == "Yesterday", "yesterday")

  // Command bar includes New Tab Folder and Saved Sessions
  let cmd_fl = build_command_bar_items(ws, "new tab folder", "https://github.com", true)
  let mut found_fl = false
  for it in cmd_fl {
    if it.id == "new_folder" && it.title == "New tab folder" {
      found_fl = true
    }
  }
  debug_assert(found_fl, "Cmd+K includes New Tab Folder")

  let cmd_ss = build_command_bar_items(ws, "saved sessions", "https://github.com", true)
  let mut found_ss = false
  for it in cmd_ss {
    if it.id == "saved_sessions" && it.title == "Saved sessions" {
      found_ss = true
    }
  }
  debug_assert(found_ss, "Cmd+K includes Saved Sessions")
}

test "tab search cross-space utf8 ranking, site idn verification, and capture sheet meta" {
  let ws = WorkspaceSnapshot::{
    active_space_id: "sp-work",
    active_tab_id: "t-1",
    spaces: [
      SpaceSummary::{ id: "sp-work", name: "Work", accent: "#2563EB", theme: space_theme_unset(), active: true, tab_count: 2 },
      SpaceSummary::{ id: "sp-design", name: "设计空间", accent: "#8B5CF6", theme: space_theme_unset(), active: false, tab_count: 2 },
      SpaceSummary::{ id: "sp-read", name: "日本語リード", accent: "#10B981", theme: space_theme_unset(), active: false, tab_count: 1 },
    ],
    folders: [],
    tabs: [
      TabSummary::{ id: "t-1", space_id: "sp-work", title: "Farview Architecture RFC", url: "https://github.com/AFK-surf/farview", pinned: true, favorite: false, active: true, state: "active", folder_id: "", last_active_secs: 2000L },
      TabSummary::{ id: "t-2", space_id: "sp-work", title: "Lo-Fi Coding Radio", url: "https://music.example.com/live", pinned: false, favorite: true, active: false, state: "playing", folder_id: "", last_active_secs: 1800L },
      TabSummary::{ id: "t-3", space_id: "sp-design", title: "设计系统规范与组件文档", url: "https://design.example.org/tokens", pinned: true, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 1950L },
      TabSummary::{ id: "t-4", space_id: "sp-design", title: "PayPal Sign In", url: "https://p\u{0430}ypal.com/signin", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 1700L },
      TabSummary::{ id: "t-5", space_id: "sp-read", title: "東京技術ブログ：レンダリング最適化", url: "https://tech.example.jp/metal", pinned: false, favorite: false, active: false, state: "background", folder_id: "", last_active_secs: 1900L },
    ],
    permissions: None,
    closed_count: 2,
    media: Some(MediaMiniState::{
      tab_id: "t-2",
      title: "Lo-Fi Coding Radio",
      host: "music.example.com",
      playing: true,
      muted: false,
      is_meeting: false,
      accent: "#2563EB",
    }),
    nav_back: [],
    nav_forward: [],
  }
  let closed = ClosedTabsSnapshot::{
    items: [
      ClosedTabItem::{ index: 0, title: "WebGPU Shading Spec", url: "https://gpuweb.github.io/gpuweb/", host: "gpuweb.github.io", space_name: "Work", closed_secs: 1990L },
      ClosedTabItem::{ index: 1, title: "中文排版与字体设计指南", url: "https://type.example.cn/cjk", host: "type.example.cn", space_name: "设计空间", closed_secs: 1950L },
    ],
  }

  // 1. Empty query: active tab first, playing audio second, cross-Space tabs + closed tabs populated
  let all = build_tab_search_results(ws, closed, "")
  debug_assert(all.total_open == 5, "all 5 open tabs across 3 Spaces")
  debug_assert(all.total_closed == 2, "all 2 recently closed tabs")
  debug_assert(all.total_count() == 7, "flat total count 7")
  debug_assert(all.open_items[0].id == "t-1" && all.open_items[0].is_active, "active tab ranked first")
  debug_assert(all.open_items[1].id == "t-2" && all.open_items[1].is_playing_audio, "playing audio tab ranked second")
  match all.item_at(5) {
    Some(it) => debug_assert(!it.is_open && it.closed_index == 0, "flat item_at reaches closed section")
    None => debug_assert(false, "expected closed item at index 5")
  }
  debug_assert(tab_search_step_selection(0, -1, 7) == 6, "step selection wraps upward")
  debug_assert(tab_search_step_selection(6, 1, 7) == 0, "step selection wraps downward")

  // 2. UTF-8 Chinese query matches across open & recently closed tabs
  let zh = build_tab_search_results(ws, closed, "设计")
  debug_assert(zh.total_open == 2, "Chinese space/title matches 2 open tabs in 设计空间")
  debug_assert(zh.total_closed == 1 && zh.closed_items[0].closed_index == 1, "Chinese query matches closed tab")

  // 3. UTF-8 Japanese query
  let ja = build_tab_search_results(ws, closed, "レンダリング")
  debug_assert(ja.total_open == 1 && ja.open_items[0].id == "t-5", "Japanese query matches t-5")
  debug_assert(ja.open_items[0].space_name == "日本語リード", "preserves Japanese space name")

  // 4. IDN anti-spoofing inside Tab Search display_host
  let spoof = build_tab_search_results(ws, closed, "paypal")
  debug_assert(spoof.total_open == 1 && spoof.open_items[0].id == "t-4", "finds lookalike tab")
  debug_assert(spoof.open_items[0].display_host.contains("xn--"), "display_host uses safe Punycode against homograph")

  // 5. Command Bar includes Search All Tabs (`Cmd+Shift+A`)
  let cmd_ts = build_command_bar_items(ws, "search all tabs", "https://github.com", true)
  let mut found_ts = false
  for it in cmd_ts {
    if it.id == "search_all_tabs" && it.shortcut == "⇧⌘A" {
      found_ts = true
    }
  }
  debug_assert(found_ts, "Cmd+K includes Search All Tabs with Shift+Cmd+A")

  // 6. Site Security IDN Verification summaries
  let idn_ascii = build_site_idn_verification("https://github.com/AFK-surf/farview")
  debug_assert(idn_ascii.status_code == 0 && idn_ascii.badge_label == "Verified ASCII host", "ASCII host verified")
  let idn_uni = build_site_idn_verification("https://xn--mnchen-3ya.de/guide")
  debug_assert(idn_uni.status_code == 1 && idn_uni.badge_label == "Verified Unicode IDN", "Unicode IDN verified")
  debug_assert(idn_uni.detail_line.contains("xn--mnchen-3ya.de"), "Unicode IDN includes ascii punycode")
  let idn_spoof = build_site_idn_verification("https://p\u{0430}ypal.com/signin")
  debug_assert(idn_spoof.status_code == 2 && idn_spoof.badge_label == "Homograph Risk", "Homograph spoof flagged")
  debug_assert(idn_spoof.safe_punycode.contains("xn--"), "Homograph spoof shows safe Punycode")
  let idn_local = build_site_idn_verification("http://127.0.0.1:8080/app")
  debug_assert(idn_local.status_code == 3 && idn_local.badge_label == "Local / Internal", "Local host classified")
  debug_assert(format_site_cookies_count(0) == "0 cookies", "0 cookies plural")
  debug_assert(format_site_cookies_count(1) == "1 cookie", "1 cookie singular")
  debug_assert(format_site_cookies_count(6) == "6 cookies", "6 cookies plural")

  // 7. Capture Sheet metadata & badges
  let dl = DownloadSummary::{
    id: "dl-99",
    filename: "farview-20261124-120000.png",
    url: "https://example.com/",
    mime: "image/png",
    bytes: 412672L,
    state: "completed", path: "" }
  let cap = capture_sheet_from_download(dl, 1280, 800)
  debug_assert(cap.filename == "farview-20261124-120000.png", "capture filename")
  debug_assert(cap.format == "PNG", "capture format PNG")
  debug_assert(capture_sheet_dims_badge(cap.width, cap.height) == "1280×800", "dims badge")
  debug_assert(capture_sheet_size_label(cap.size_bytes) == "403 KB", "size label KB")
  debug_assert(capture_sheet_size_label(1572864L) == "1.5 MB", "size label MB")
}

test "unicode_segment UAX #29 text_segment_bridge & Reader Mode Pro multilingual word count" {
  // 1. Emoji ZWJ family (👨‍👩‍👧‍👦 = 25 UTF-8 bytes), regional indicator flags (🇯🇵🇺🇸 = 8+8 bytes),
  //    combining acute accent (e\u{0301} = 3 bytes), and Hangul syllable (한 = 3 bytes).
  let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"
  let jp_flag = "\u{1F1EF}\u{1F1F5}"
  let us_flag = "\u{1F1FA}\u{1F1F8}"
  let accented = "e\u{0301}"
  let sample = "A" + family + jp_flag + us_flag + accented + "한"
  let p0 = 0
  let p1 = next_grapheme_offset(sample, p0) // after "A" (1)
  let p2 = next_grapheme_offset(sample, p1) // after family (1 + 25 = 26)
  let p3 = next_grapheme_offset(sample, p2) // after jp_flag (26 + 8 = 34)
  let p4 = next_grapheme_offset(sample, p3) // after us_flag (34 + 8 = 42)
  let p5 = next_grapheme_offset(sample, p4) // after e + combining acute (42 + 3 = 45)
  let p6 = next_grapheme_offset(sample, p5) // after Hangul 한 (45 + 3 = 48)
  debug_assert(p1 == 1, "grapheme step after A")
  debug_assert(p2 == 1 + family.length(), "grapheme step skips whole Emoji ZWJ family")
  debug_assert(p3 == p2 + jp_flag.length(), "grapheme step skips whole JP flag")
  debug_assert(p4 == p3 + us_flag.length(), "grapheme step skips whole US flag")
  debug_assert(p5 == p4 + accented.length(), "grapheme step skips combining accent")
  debug_assert(p6 == sample.length(), "grapheme step reaches end")
  debug_assert(next_grapheme_offset(sample, p6) == sample.length(), "clamped at end")

  // Reverse stepping & mid-cluster recovery never split grapheme clusters
  debug_assert(prev_grapheme_offset(sample, p6) == p5, "prev skips Hangul")
  debug_assert(prev_grapheme_offset(sample, p5) == p4, "prev skips combining accent")
  debug_assert(prev_grapheme_offset(sample, p4) == p3, "prev skips US flag")
  debug_assert(prev_grapheme_offset(sample, p3) == p2, "prev skips JP flag")
  debug_assert(prev_grapheme_offset(sample, p2) == p1, "prev skips whole ZWJ family")
  debug_assert(prev_grapheme_offset(sample, p1) == 0, "prev reaches start")
  debug_assert(prev_grapheme_offset(sample, 0) == 0, "clamped at 0")
  debug_assert(prev_grapheme_offset(sample, p1 + 5) == p1, "mid-ZWJ prev snaps to cluster start")
  debug_assert(next_grapheme_offset(sample, p1 + 5) == p2, "mid-ZWJ next snaps to cluster end")

  // 2. UAX #29 word boundaries (Option+Left/Right & double-click)
  let line = "don't stop 東京テスト!"
  let w1 = next_word_boundary(line, 0)
  debug_assert(line.slice(0, w1) == "don't", "UAX #29 keeps contraction don't together")
  let w2 = next_word_boundary(line, w1)
  debug_assert(line.slice(w1, w2) == " ", "space boundary")
  let w3 = next_word_boundary(line, w2)
  debug_assert(line.slice(w2, w3) == "stop", "word stop")
  debug_assert(prev_word_boundary(line, w3) == w2, "prev_word_boundary returns start of stop")
  let (dlo, dhi) = word_span_at_byte(line, 2)
  debug_assert(line.slice(dlo, dhi) == "don't", "word_span_at_byte selects whole contraction")

  // 3. Editorial word count & Reader Mode Pro integration (EN + CJK + Japanese + Korean + Emoji)
  debug_assert(count_editorial_words("") == 0, "empty editorial word count")
  debug_assert(count_editorial_words("Hello, world! 2026") == 3, "ASCII words + number")
  debug_assert(count_editorial_words("don't panic") == 2, "contraction counts as 1 word")
  debug_assert(count_editorial_words("Hello 世界" + family + "!") == 3, "mixed EN + CJK + Emoji")
  let multi = compute_reader_metrics_text("Farview 渲染引擎 カタカナ 한국어 " + jp_flag)
  debug_assert(multi.latin_words == 1, "Farview is 1 latin word")
  debug_assert(multi.cjk_chars == 6, "4 Han chars + 1 Katakana word + 1 Hangul word")
  debug_assert(multi.word_count == 7 && multi.read_minutes == 1, "Reader Mode Pro UAX #29 total")
}

test "phase3a_r2: v1 legacy boosts.json fallback, v2 www/bare independence, and session_preview_hosts strips www." {
  // 1. Legacy v1 boosts.json (no "version" field) marks bare hosts as legacyBare
  let v1_json = "{\"items\":[{\"host\":\"example.com\",\"enabled\":true,\"theme\":\"dark\"}]}"
  let (v1_snap, v1_legacy) = match parse_boosts_snapshot_with_legacy(v1_json) {
    Some(pair) => pair
    None => panic("parse v1 boosts failed")
  }
  debug_assert(v1_legacy.length() == 1 && v1_legacy[0] == "example.com", "v1 bare host collected in legacyBare")
  match boosts_find_with_legacy(v1_snap, v1_legacy, "https://www.example.com/news") {
    Some(b) => debug_assert(b.theme == "dark" && b.enabled, "www.example.com falls back to v1 legacy example.com")
    None => debug_assert(false, "expected v1 legacy fallback hit for www.example.com")
  }

  // 2. v2 boosts.json encodes version:2; fresh v2 bare domain does NOT leak to www.
  let v2_snap = BoostsSnapshot::{
    items: [SiteBoost::{ ..SiteBoost::default_for("beta.example"), enabled: true, theme: "sepia" }],
  }
  let v2_json = encode_boosts_snapshot(v2_snap)
  debug_assert(v2_json.contains("\"version\":2"), "encode_boosts_snapshot writes version:2")
  let (v2_dec, v2_legacy) = match parse_boosts_snapshot_with_legacy(v2_json) {
    Some(pair) => pair
    None => panic("parse v2 boosts failed")
  }
  debug_assert(v2_legacy.length() == 0, "fresh v2 bare domain is NOT in legacyBare")
  debug_assert(boosts_find_with_legacy(v2_dec, v2_legacy, "https://www.beta.example/") is None, "v2 www.beta.example does not inherit v2 bare beta.example")
  debug_assert(boosts_find_with_legacy(v2_dec, v2_legacy, "https://beta.example/").is_some(), "v2 bare beta.example matches exact bare host")

  // 3. session_preview_hosts still strips leading www. and deduplicates
  let sess = NamedSessionSnapshot::{
    id: "s1",
    name: "Dev",
    created_secs: 1000L,
    active_space_id: "sp1",
    spaces: [],
    folders: [],
    tabs: [
      SessionTabItem::{ space_id: "sp1", title: "GH A", url: "https://www.github.com/a", pinned: false, favorite: false, folder_id: "" },
      SessionTabItem::{ space_id: "sp1", title: "GH B", url: "https://github.com/b", pinned: false, favorite: false, folder_id: "" },
    ],
  }
  let hosts = session_preview_hosts(sess)
  debug_assert(hosts.length() == 1 && hosts[0] == "github.com", "session_preview_hosts strips www. and deduplicates to [github.com]")
}

test "command bar copy: verb + object in sentence case, never \"Toggle ...\", and the old words still find them" {
  let snap = match parse_workspace_snapshot("{\"activeSpaceId\":\"work\",\"activeTabId\":\"\",\"spaces\":[],\"tabs\":[]}") {
    Some(s) => s
    None => {
      debug_assert(false, "snapshot")
      return
    }
  }
  // Every action, through one keyword each kind of command answers to.
  let names = ["Space", "Spaces", "Favorites", "Peek", "Today", "Google", "PDF", "URL", "Start", "Page", "Library", "Bookmarks", "Downloads", "Work"]
  let mut seen = 0
  for q in ["a", "e", "i", "o", "u"] {
    for it in build_command_bar_items(snap, q, "https://example.org/", true) {
      if it.kind is CommandKind::Action {
        seen += 1
        debug_assert(!it.title.starts_with("Toggle"), "no Toggle title: " + it.title)
        let words = it.title.split(" ")
        let mut i = 1
        while i < words.length() {
          let w = words[i]
          let c0 = if w.length() > 0 { w.code_unit_at(0).to_int() } else { 0 }
          let upper = c0 >= 65 && c0 <= 90
          let all_caps = w.length() > 1 && !has_ascii_lower_for_test(w)
          if upper && !all_caps && !names.contains(w) {
            debug_assert(false, "sentence case: " + it.title)
          }
          i += 1
        }
      }
    }
  }
  debug_assert(seen > 0, "actions listed")
  let find = fn(q : String, id : String) -> Bool {
    for it in build_command_bar_items(snap, q, "", true) {
      if it.id == id {
        return true
      }
    }
    false
  }
  debug_assert(find("toggle", "toggle_bookmarks_bar"), "toggle still finds Bookmarks bar")
  debug_assert(find("devtools", "toggle_devtools"), "devtools still finds Developer tools")
}

fn has_ascii_lower_for_test(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 97 && c <= 122 {
      return true
    }
    i += 1
  }
  false
}
