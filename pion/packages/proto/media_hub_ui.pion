///| Pure-Pion portable Global Media Hub & Sidebar Mini-Player model
///| (`MediaSessionItem`, `MediaHubSnapshot`), fault-tolerant JSON codec,
///| mini-player session selection, progress ratio & `m:ss` / `h:mm:ss` formatting
///| shared by `pion-host` and `pion-app`.

pub struct MediaSessionItem {
  pub tab_id : String
  pub title : String
  pub artist_or_host : String
  pub url : String
  pub playing : Bool
  pub muted : Bool
  pub is_live_call : Bool
  pub duration_secs : Int
  pub position_secs : Int
}

pub struct MediaHubSnapshot {
  pub sessions : Array[MediaSessionItem]
}

pub fn MediaHubSnapshot::empty() -> MediaHubSnapshot {
  MediaHubSnapshot::{ sessions: [] }
}

fn mh_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

fn mh_clamp_nonneg(v : Int) -> Int {
  if v < 0 { 0 } else { v }
}

pub fn normalize_media_session_item(item : MediaSessionItem) -> MediaSessionItem {
  let dur = mh_clamp_nonneg(item.duration_secs)
  let raw_pos = mh_clamp_nonneg(item.position_secs)
  let pos = if dur > 0 && raw_pos > dur { dur } else { raw_pos }
  let artist = if item.artist_or_host.trim() != "" {
    item.artist_or_host.trim()
  } else {
    omnibox_display_host(item.url)
  }
  let title = if item.title.trim() != "" {
    item.title.trim()
  } else if artist != "" {
    artist
  } else if item.is_live_call {
    "Live Call"
  } else {
    "Playing Media"
  }
  MediaSessionItem::{
    tab_id: item.tab_id.trim(),
    title,
    artist_or_host: artist,
    url: item.url.trim(),
    playing: item.playing,
    muted: item.muted,
    is_live_call: item.is_live_call,
    duration_secs: dur,
    position_secs: pos,
  }
}

pub fn encode_media_hub_snapshot(snap : MediaHubSnapshot) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < snap.sessions.length() {
    let it = normalize_media_session_item(snap.sessions[i])
    parts.push(
      "{\"tabId\":" +
      omni_json_escape(it.tab_id) +
      ",\"title\":" +
      omni_json_escape(it.title) +
      ",\"artistOrHost\":" +
      omni_json_escape(it.artist_or_host) +
      ",\"url\":" +
      omni_json_escape(it.url) +
      ",\"playing\":" +
      (if it.playing { "true" } else { "false" }) +
      ",\"muted\":" +
      (if it.muted { "true" } else { "false" }) +
      ",\"isLiveCall\":" +
      (if it.is_live_call { "true" } else { "false" }) +
      ",\"durationSecs\":" +
      it.duration_secs.to_string() +
      ",\"positionSecs\":" +
      it.position_secs.to_string() +
      "}",
    )
    i = i + 1
  }
  "{\"sessions\":[" + parts.join(",") + "]}"
}

fn mh_parse_session(p : OmniJsonParser) -> Option[MediaSessionItem] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut tab_id = ""
  let mut title = ""
  let mut artist_or_host = ""
  let mut url = ""
  let mut playing = false
  let mut muted = false
  let mut is_live_call = false
  let mut duration_secs = 0
  let mut position_secs = 0
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(
      normalize_media_session_item(
        MediaSessionItem::{
          tab_id,
          title,
          artist_or_host,
          url,
          playing,
          muted,
          is_live_call,
          duration_secs,
          position_secs,
        },
      ),
    )
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "tabId" || key == "tab_id" {
      match p.parse_str() {
        Some(v) => tab_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "artistOrHost" || key == "artist_or_host" || key == "artist" || key == "host" {
      match p.parse_str() {
        Some(v) => artist_or_host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "playing" {
      match mh_parse_bool(p) {
        Some(v) => playing = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "muted" {
      match mh_parse_bool(p) {
        Some(v) => muted = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "isLiveCall" || key == "is_live_call" || key == "isMeeting" || key == "is_meeting" {
      match mh_parse_bool(p) {
        Some(v) => is_live_call = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "durationSecs" || key == "duration_secs" || key == "duration" {
      match p.parse_number() {
        Some(v) => duration_secs = if v >= 0.0 { v.to_int() } else { 0 }
        None => if !p.skip_value() { return None }
      }
    } else if key == "positionSecs" || key == "position_secs" || key == "position" {
      match p.parse_number() {
        Some(v) => position_secs = if v >= 0.0 { v.to_int() } else { 0 }
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(
        normalize_media_session_item(
          MediaSessionItem::{
            tab_id,
            title,
            artist_or_host,
            url,
            playing,
            muted,
            is_live_call,
            duration_secs,
            position_secs,
          },
        ),
      )
    } else {
      return None
    }
  }
  None
}

///| Parses a `MediaHubSnapshot` JSON payload from `wire::Message::MediaHubState`
///| or `FV_MEDIA_HUB_SEED`. Tolerates extra keys and negative numbers; malformed or
///| truncated JSON returns `None` without panicking.
pub fn parse_media_hub_snapshot(
  json : String,
  max_items~ : Int = 64,
) -> Option[MediaHubSnapshot] {
  let limit = if max_items > 0 { max_items } else { 64 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let sessions : Array[MediaSessionItem] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(MediaHubSnapshot::{ sessions })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "sessions" || key == "items" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match mh_parse_session(p) {
            Some(it) => if sessions.length() < limit { sessions.push(it) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(MediaHubSnapshot::{ sessions })
    } else {
      return None
    }
  }
  None
}

///| Selects the best session to feature in the sidebar Mini-Player Card:
///| prioritizes an active playing / live-call background tab (`tab_id != active_tab_id`),
///| falling back to the active tab's live/playing media, then any remaining session.
pub fn select_mini_player_session(
  snap : MediaHubSnapshot,
  active_tab_id : String,
) -> Option[MediaSessionItem] {
  if snap.sessions.length() == 0 {
    return None
  }
  let act = active_tab_id.trim()
  let mut best_idx = -1
  let mut best_score = -1
  let mut i = 0
  while i < snap.sessions.length() {
    let it = snap.sessions[i]
    let is_bg = act == "" || (it.tab_id != "" && it.tab_id != act)
    let mut score = 0
    if is_bg {
      score = score + 100
    }
    if it.is_live_call {
      score = score + 40
    }
    if it.playing {
      score = score + 30
    }
    if !it.muted {
      score = score + 10
    }
    if score > best_score {
      best_score = score
      best_idx = i
    }
    i = i + 1
  }
  if best_idx >= 0 {
    Some(snap.sessions[best_idx])
  } else {
    Some(snap.sessions[0])
  }
}

///| Returns playback progress in `[0.0, 1.0]`. Live calls return `1.0`.
pub fn media_progress_ratio(item : MediaSessionItem) -> Double {
  if item.is_live_call {
    return 1.0
  }
  if item.duration_secs <= 0 {
    return 0.0
  }
  let pos = if item.position_secs < 0 { 0 } else if item.position_secs > item.duration_secs { item.duration_secs } else { item.position_secs }
  (pos as Double) / (item.duration_secs as Double)
}

///| Returns playback progress percentage in `0..=100`.
pub fn media_progress_pct(item : MediaSessionItem) -> Int {
  let pct = (media_progress_ratio(item) * 100.0 + 0.5).to_int()
  if pct < 0 { 0 } else if pct > 100 { 100 } else { pct }
}

fn mh_two_digits(n : Int) -> String {
  if n < 10 { "0" + n.to_string() } else { n.to_string() }
}

///| Formats seconds as `m:ss` (under 1 hour) or `h:mm:ss` (1 hour and above).
pub fn format_media_time(secs : Int) -> String {
  let s = if secs < 0 { 0 } else { secs }
  let hrs = s / 3600
  let mins = (s % 3600) / 60
  let rem = s % 60
  if hrs > 0 {
    hrs.to_string() + ":" + mh_two_digits(mins) + ":" + mh_two_digits(rem)
  } else {
    mins.to_string() + ":" + mh_two_digits(rem)
  }
}

pub fn media_hub_has_live_call(snap : MediaHubSnapshot) -> Bool {
  let mut i = 0
  while i < snap.sessions.length() {
    if snap.sessions[i].is_live_call {
      return true
    }
    i = i + 1
  }
  false
}

pub fn media_hub_has_unmuted_playing(snap : MediaHubSnapshot) -> Bool {
  let mut i = 0
  while i < snap.sessions.length() {
    let it = snap.sessions[i]
    if (it.playing || it.is_live_call) && !it.muted {
      return true
    }
    i = i + 1
  }
  false
}

pub fn media_session_accent(item : MediaSessionItem) -> Int64 {
  let low_url = omni_ascii_lower(item.url)
  let low_host = omni_ascii_lower(item.artist_or_host)
  if item.is_live_call || low_url.contains("meet.google.com") || low_host.contains("meet.google.com") {
    0x10B981FFL
  } else if low_url.contains("youtube.com") || low_url.contains("youtu.be") || low_host.contains("youtube") {
    0xEF4444FFL
  } else if low_url.contains("spotify.com") || low_host.contains("spotify") {
    0x22C55EFFL
  } else if low_url.contains("twitch.tv") || low_url.contains("podcasts") {
    0x8B5CF6FFL
  } else {
    0x3B82F6FFL
  }
}

pub fn media_session_monogram(item : MediaSessionItem) -> String {
  let ch = omnibox_initial_letter(item.url, if item.title.trim() != "" { item.title } else { item.artist_or_host })
  if ch != "" { ch } else { "♫" }
}
