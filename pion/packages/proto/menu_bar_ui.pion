///| The macOS menu bar (`ui::menu_setup`'s JSON): the app menu, File, Edit, View, History, Bookmarks, Tab, Window
///| and Help, as a Mac browser has them. The system's items go by their role (About, Services, Hide, Quit, the
///| editing items, Minimize, Zoom, Enter Full Screen, Bring All to Front); the browser's own name a Command Bar action
///| (`command_bar_action_catalog`'s ids, run by the app as the Command Bar runs them) and show the keys the app
///| already takes for them (the view takes a key before the menu, so a key does its action once). A chosen item comes
///| back on the system's channel as `{"menu": id}` (`hostapi::SystemSaid::Menu`).

///| One item of a menu: a separator, a system role, or one of the browser's actions with the keys shown for it.
pub enum MenuBarItem {
  Separator
  Role(String, String)
  Action(String, String, String)
}

pub struct MenuBarMenu {
  pub title : String
  pub role : String
  pub items : Array[MenuBarItem]
}

fn mb_sep() -> MenuBarItem {
  MenuBarItem::Separator
}

fn mb_act(title : String, id : String, keys~ : String = "") -> MenuBarItem {
  MenuBarItem::Action(title, id, keys)
}

fn mb_role(title : String, role : String) -> MenuBarItem {
  MenuBarItem::Role(title, role)
}

///| The browser's menus in order. Every action id is one `run_browser_action` (the app's) knows.
pub fn mac_menu_bar() -> Array[MenuBarMenu] {
  [
    MenuBarMenu::{
      title: "{app}",
      role: "",
      items: [
        mb_role("About {app}", "about"),
        mb_sep(),
        mb_act("Settings…", "open_settings", keys="Mod+,"),
        mb_sep(),
        mb_role("Services", "services"),
        mb_sep(),
        mb_role("Hide {app}", "hide"),
        mb_role("Hide Others", "hideOthers"),
        mb_role("Show All", "showAll"),
        mb_sep(),
        mb_role("Quit {app}", "quit"),
      ],
    },
    MenuBarMenu::{
      title: "File",
      role: "actions",
      items: [
        mb_act("New Tab", "new_tab", keys="Mod+T"),
        mb_act("New Space", "new_space"),
        mb_act("Open Location…", "focus_url", keys="Mod+L"),
        mb_act("Reopen Closed Tab", "reopen_tab", keys="Mod+Shift+T"),
        mb_sep(),
        mb_act("Close Tab", "close_tab", keys="Mod+W"),
        mb_sep(),
        mb_act("Save Page as PDF…", "export_pdf", keys="Mod+P"),
        mb_act("Capture Screenshot", "capture_screenshot", keys="Mod+Shift+S"),
        mb_act("Copy Clean URL", "copy_url", keys="Mod+Shift+C"),
      ],
    },
    MenuBarMenu::{
      title: "Edit",
      role: "",
      items: [
        mb_role("Undo", "undo"),
        mb_role("Redo", "redo"),
        mb_sep(),
        mb_role("Cut", "cut"),
        mb_role("Copy", "copy"),
        mb_role("Paste", "paste"),
        mb_role("Select All", "selectAll"),
        mb_sep(),
        mb_act("Find…", "find", keys="Mod+F"),
        mb_act("Find Next", "find_next", keys="Mod+G"),
        mb_act("Find Previous", "find_prev", keys="Mod+Shift+G"),
      ],
    },
    MenuBarMenu::{
      title: "View",
      role: "actions",
      items: [
        mb_act("Toggle Sidebar", "toggle_sidebar", keys="Mod+S"),
        mb_act("Toggle Bookmarks Bar", "toggle_bookmarks_bar", keys="Mod+Shift+B"),
        mb_act("Command Bar", "command_bar", keys="Mod+K"),
        mb_sep(),
        mb_act("Reload Page", "reload", keys="Mod+R"),
        mb_sep(),
        mb_act("Actual Size", "zoom_reset", keys="Mod+0"),
        mb_act("Zoom In", "zoom_in", keys="Mod+="),
        mb_act("Zoom Out", "zoom_out", keys="Mod+-"),
        mb_sep(),
        mb_act("Reader Mode", "toggle_reader_mode", keys="Mod+Alt+R"),
        mb_act("Split View", "toggle_split_view", keys="Mod+Shift+\\"),
        mb_act("Dark Mode", "toggle_dark_chrome", keys="Mod+Shift+L"),
        mb_sep(),
        mb_role("Enter Full Screen", "fullScreen"),
        mb_sep(),
        mb_act("Developer Tools", "toggle_devtools", keys="Mod+Alt+I"),
        mb_act("Page Details", "toggle_perf_hud", keys="Mod+Shift+U"),
      ],
    },
    MenuBarMenu::{
      title: "History",
      role: "actions",
      items: [
        mb_act("Back", "back", keys="Mod+["),
        mb_act("Forward", "forward", keys="Mod+]"),
        mb_sep(),
        mb_act("Show All History", "history", keys="Mod+Y"),
        mb_act("Recently Closed Tabs", "recently_closed_tabs"),
        mb_sep(),
        mb_act("Clear Browsing History…", "clear_history"),
      ],
    },
    MenuBarMenu::{
      title: "Bookmarks",
      role: "actions",
      items: [
        mb_act("Bookmark This Page", "toggle_bookmark", keys="Mod+D"),
        mb_act("Show All Bookmarks", "bookmarks", keys="Mod+Alt+B"),
      ],
    },
    MenuBarMenu::{
      title: "Tab",
      role: "actions",
      items: [
        mb_act("Show Next Tab", "tab_next", keys="Mod+Alt+Down"),
        mb_act("Show Previous Tab", "tab_prev", keys="Mod+Alt+Up"),
        mb_act("Search Tabs", "search_all_tabs", keys="Mod+Shift+A"),
        mb_sep(),
        mb_act("Pin Tab", "pin_tab", keys="Mod+Shift+D"),
        mb_act("Add to Favorites", "favorite_tab", keys="Mod+Alt+D"),
        mb_act("Duplicate Tab", "duplicate_tab"),
        mb_act("Mute Tab", "toggle_mute_audio", keys="Mod+Shift+M"),
        mb_sep(),
        mb_act("Close Other Tabs", "close_other_tabs"),
      ],
    },
    MenuBarMenu::{
      title: "Window",
      role: "window",
      items: [
        mb_role("Minimize", "minimize"),
        mb_role("Zoom", "zoom"),
        mb_sep(),
        mb_act("Downloads", "downloads", keys="Mod+J"),
        mb_act("Library", "library"),
        mb_sep(),
        mb_role("Bring All to Front", "front"),
      ],
    },
    MenuBarMenu::{
      title: "Help",
      role: "actions",
      items: [mb_act("Keyboard Shortcuts", "shortcuts", keys="Mod+/")],
    },
  ]
}

fn mb_json_str(s : String) -> String {
  omni_json_escape(s)
}

///| `mac_menu_bar` as `ui::menu_setup` takes it.
pub fn mac_menu_bar_json() -> String {
  let sb = StringBuilder::new()
  sb.write_string("[")
  let menus = mac_menu_bar()
  let mut mi = 0
  while mi < menus.length() {
    let m = menus[mi]
    if mi > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"title\":" + mb_json_str(m.title))
    if m.role != "" {
      sb.write_string(",\"role\":" + mb_json_str(m.role))
    }
    sb.write_string(",\"items\":[")
    let mut ii = 0
    while ii < m.items.length() {
      if ii > 0 {
        sb.write_string(",")
      }
      match m.items[ii] {
        MenuBarItem::Separator => sb.write_string("{\"separator\":true}")
        MenuBarItem::Role(t, r) => sb.write_string("{\"title\":" + mb_json_str(t) + ",\"role\":" + mb_json_str(r) + "}")
        MenuBarItem::Action(t, id, keys) => {
          sb.write_string("{\"title\":" + mb_json_str(t) + ",\"action\":" + mb_json_str(id))
          if keys != "" {
            sb.write_string(",\"keys\":" + mb_json_str(keys))
          }
          sb.write_string("}")
        }
      }
      ii = ii + 1
    }
    sb.write_string("]}")
    mi = mi + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///| Every action id the menu bar names (each must be one the app runs).
pub fn mac_menu_bar_actions() -> Array[String] {
  let out : Array[String] = []
  for m in mac_menu_bar() {
    for it in m.items {
      match it {
        MenuBarItem::Action(_, id, _) => out.push(id)
        _ => ()
      }
    }
  }
  out
}

///| What a link the system opened the app with opens in a tab: an http(s) address as it is, and a bare host name
///| (`example.com`, `docs.example.com/a`: letters, digits, `-` and `.`, its last label two letters or more) as
///| https://; anything else is not opened (""). Not file://: a file page's origin is not yet its own, so one opened
///| from Finder or a mail attachment could read the person's other files; nor javascript:, data:, or another app's
///| scheme.
pub fn system_link_target(raw : String) -> String {
  let t = raw.trim()
  let lower = omni_ascii_lower(t)
  if lower.starts_with("http://") || lower.starts_with("https://") {
    return t
  }
  if system_link_bare_host(t) { "https://" + t } else { "" }
}

fn system_link_bare_host(t : String) -> Bool {
  let slash = t.index_of("/")
  let host = if slash >= 0 { t.slice(0, slash) } else { t }
  if host.length() == 0 || host.length() > 253 || host.starts_with(".") || host.starts_with("-") || host.ends_with(".") {
    return false
  }
  // (nothing but host characters before the path: no scheme, port, user or space)
  let mut dots = 0
  let mut tld = 0
  let mut tld_letters = true
  let mut i = 0
  while i < host.length() {
    let c = host.code_unit_at(i).to_int()
    if c == 46 {
      dots += 1
      tld = 0
      tld_letters = true
    } else if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
      tld += 1
    } else if (c >= 48 && c <= 57) || c == 45 {
      tld += 1
      tld_letters = false
    } else {
      return false
    }
    i += 1
  }
  let mut k = 0
  while k < t.length() {
    let c = t.code_unit_at(k).to_int()
    if c <= 32 {
      return false
    }
    k += 1
  }
  dots > 0 && tld >= 2 && tld_letters
}
