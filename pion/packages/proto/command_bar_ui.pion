///| Pure-Pion portable Arc Command Bar (`Cmd/Ctrl+K`) item model, dynamic filtering,
///| ranking across Open Tabs / Spaces / Arc Actions / Direct URL-Search fallback,
///| and automatic Space naming shared by `pion-app` and tests.

pub let COMMAND_BAR_MAX_ITEMS : Int = 7

pub enum CommandKind {
  SwitchTab
  SwitchSpace
  NewSpace
  Action
  NavigateUrl
  SearchWeb
}

pub struct CommandBarItem {
  pub kind : CommandKind
  pub id : String
  pub title : String
  pub subtitle : String
  pub badge : String
  pub shortcut : String
  pub monogram : String
  pub accent : Int64
  pub is_tab : Bool
  pub is_space : Bool
}

fn cmd_contains(haystack : String, needle : String) -> Bool {
  if needle == "" {
    return true
  }
  omni_ascii_lower(haystack).contains(needle)
}

fn cmd_looks_like_url(trimmed : String) -> Bool {
  let lower = omni_ascii_lower(trimmed)
  if lower.starts_with("http://") ||
  lower.starts_with("https://") ||
  lower.starts_with("file://") ||
  lower.starts_with("about:") ||
  lower.starts_with("localhost") ||
  lower.starts_with("127.0.0.1") {
    return true
  }
  let mut has_dot = false
  let mut i = 0
  while i < trimmed.length() {
    let c = trimmed.code_unit_at(i).to_int()
    if c == 32 || c == 9 || c == 10 || c == 13 {
      return false
    }
    if c == 46 {
      has_dot = true
    }
    i = i + 1
  }
  has_dot
}

fn cmd_space_info(snap : WorkspaceSnapshot, space_id : String) -> (String, Int64) {
  let mut i = 0
  while i < snap.spaces.length() {
    if snap.spaces[i].id == space_id {
      let nm = if snap.spaces[i].name != "" { snap.spaces[i].name } else { space_id }
      return (nm, workspace_accent_color(snap.spaces[i].accent))
    }
    i = i + 1
  }
  (space_id, 0x2563EBFFL)
}

fn cmd_active_tab_pinned(snap : WorkspaceSnapshot) -> Bool {
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if t.active || (snap.active_tab_id != "" && t.id == snap.active_tab_id) {
      return t.pinned
    }
    i = i + 1
  }
  false
}

fn cmd_active_tab_favorite(snap : WorkspaceSnapshot) -> Bool {
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if t.active || (snap.active_tab_id != "" && t.id == snap.active_tab_id) {
      return t.favorite
    }
    i = i + 1
  }
  false
}

fn cmd_media_muted(snap : WorkspaceSnapshot) -> Bool {
  match snap.media {
    Some(m) => m.muted
    None => false
  }
}

///| Picks the next unused human-friendly Space name (`Design`, `Research`, `Reading`, `Labs`, `Studio`, `Space N`).
pub fn next_auto_space_name(snap : WorkspaceSnapshot) -> String {
  let presets : Array[String] = ["Design", "Research", "Reading", "Labs", "Studio"]
  let mut i = 0
  while i < presets.length() {
    let cand = omni_ascii_lower(presets[i])
    let mut used = false
    let mut j = 0
    while j < snap.spaces.length() {
      if omni_ascii_lower(snap.spaces[j].name) == cand || omni_ascii_lower(snap.spaces[j].id) == cand {
        used = true
        break
      }
      j = j + 1
    }
    if !used {
      return presets[i]
    }
    i = i + 1
  }
  "Space " + (snap.spaces.length() + 1).to_string()
}

fn cmd_tab_item(snap : WorkspaceSnapshot, t : TabSummary) -> CommandBarItem {
  let (sp_name, sp_accent) = cmd_space_info(snap, t.space_id)
  let host = omnibox_display_host(t.url)
  CommandBarItem::{
    kind: CommandKind::SwitchTab,
    id: t.id,
    title: workspace_tab_display_title(t),
    subtitle: host,
    badge: sp_name,
    shortcut: "",
    monogram: omnibox_initial_letter(t.url, t.title),
    accent: sp_accent,
    is_tab: true,
    is_space: false,
  }
}

fn cmd_space_item(sp : SpaceSummary) -> CommandBarItem {
  let count_str = if sp.tab_count == 1 { "1 tab" } else { sp.tab_count.to_string() + " tabs" }
  CommandBarItem::{
    kind: CommandKind::SwitchSpace,
    id: sp.id,
    title: sp.name,
    subtitle: count_str,
    badge: if sp.active { "Active" } else { "Space" },
    shortcut: "",
    monogram: "",
    accent: workspace_accent_color(sp.accent),
    is_tab: false,
    is_space: true,
  }
}

fn cmd_shortcut(is_macos : Bool, key : String) -> String {
  if is_macos { "⌘" + key } else { "Ctrl+" + key }
}

fn cmd_shift_shortcut(is_macos : Bool, key : String) -> String {
  if is_macos { "⇧⌘" + key } else { "Ctrl+Shift+" + key }
}

fn cmd_devtools_shortcut(is_macos : Bool) -> String {
  if is_macos { "⌥⌘I" } else { "Ctrl+Shift+I" }
}

fn cmd_alt_shortcut(is_macos : Bool, key : String) -> String {
  if is_macos { "⌥⌘" + key } else { "Ctrl+Alt+" + key }
}

///| The Command Bar's actions (id, title, subtitle, shortcut, monogram, keywords): one catalog shared by the Command
///| Bar (Cmd+K) and the address palette (Cmd+L / Cmd+T, `command_bar_matching_actions`), so both find the same
///| commands.
fn command_bar_action_catalog(
  snap : WorkspaceSnapshot,
  current_url : String,
  is_macos : Bool,
) -> Array[(String, String, String, String, String, String)] {
  let active_pinned = cmd_active_tab_pinned(snap)
  let active_favorite = cmd_active_tab_favorite(snap)
  let media_muted = cmd_media_muted(snap)
  let auto_space = next_auto_space_name(snap)
  let active_sp_name = match workspace_active_space(snap) {
    Some(sp) if sp.name != "" => sp.name
    _ => "Space"
  }
  let pin_title = if active_pinned { "Unpin Active Tab" } else { "Pin Active Tab" }
  let fav_title = if active_favorite { "Remove from Favorites" } else { "Add to Favorites" }
  let fav_sub = if active_favorite { "Take this tab out of Favorites" } else { "Pin this tab to Favorites" }
  let pin_sub = if active_pinned { "Move this tab back to Today" } else { "Keep this tab at the top of the sidebar" }
  let mute_title = if media_muted { "Unmute Audio" } else { "Mute Audio" }
  let reopen_sub = if snap.closed_count > 0 {
    snap.closed_count.to_string() + " recently closed"
  } else {
    "Restore last closed tab"
  }
  let today_count = workspace_tabs_for_space(snap, snap.active_space_id, false).length()
  let sweep_sub = if today_count > 1 {
    "Archive " + (today_count - 1).to_string() + " inactive tabs in " + active_sp_name
  } else {
    "Archive Today tabs in " + active_sp_name
  }

  // Action catalog: (id, title, subtitle, shortcut, monogram, keywords)
  [
    ("toggle_bookmark", "Bookmark Current Page", "Save or remove this page in Bookmarks", cmd_shortcut(is_macos, "D"), "★", "bookmark star save favorite page"),
    ("toggle_bookmarks_bar", "Toggle Bookmarks Bar", "Show or hide the bookmarks bar", cmd_shift_shortcut(is_macos, "B"), "▤", "bookmarks bar toggle show hide strip favorites"),
    ("bookmarks", "Bookmarks", "Search and manage bookmarks", "", "B", "bookmarks library saved stars drawer"),
    ("toggle_reader_mode", "Toggle Reader Mode", "Read this article without clutter", cmd_alt_shortcut(is_macos, "R"), "R", "reader mode article reading clean paper typography distraction free"),
    ("toggle_boosts", "Customize Site Style", "Change colors, fonts and CSS for this site", cmd_shift_shortcut(is_macos, "E"), "✦", "boosts style theme dark sepia font css customize site domain appearance"),
    ("search_all_tabs", "Search All Tabs", "Find any open or recently closed tab", cmd_shift_shortcut(is_macos, "A"), "⌕", "search all tabs tab search switch open closed spaces find tab"),
    ("capture_screenshot", "Capture Screenshot", "Save the visible page as a PNG in Downloads", cmd_shift_shortcut(is_macos, "S"), "⬚", "screenshot capture png snapshot image export save"),
    ("pin_tab", pin_title, pin_sub, "", "P", "pin unpin tab"),
    ("favorite_tab", fav_title, fav_sub, "", "★", "favorite unfavorite star top grid app"),
    ("global_media_controls", "Global Media Controls", "Control every playing tab and call", "", "♫", "global media controls hub player audio video meet spotify youtube playing"),
    ("toggle_play_media", "Play / Pause Media", "Play or pause the media in this tab", "", "⏯", "play pause media audio video music playback toggle"),
    ("toggle_mute_audio", mute_title, "Mute or unmute the media in this tab", cmd_shortcut(is_macos, "M"), "M", "mute unmute audio toggle sound silence media meet"),
    ("reopen_tab", "Reopen Closed Tab", reopen_sub, cmd_shift_shortcut(is_macos, "T"), "↺", "reopen restore undo closed tab"),
    ("recently_closed_tabs", "Recently Closed Tabs", reopen_sub, "", "↺", "recently closed tabs history stack reopen restore picker"),
    ("new_tab", "New Tab", "Open a blank tab in " + active_sp_name, cmd_shortcut(is_macos, "T"), "+", "new tab open"),
    ("new_start_page", "New Start Page", "Open a tab on the Start Page", "", "⌂", "new start page home newtab speed dial quick access"),
    ("manage_spaces", "Manage Spaces", "Create, rename, recolor and switch Spaces", "", "◎", "manage spaces workspace partition cookie switch delete"),
    ("new_space", "New Space", "Create \"" + auto_space + "\" workspace", "", "+", "new space workspace create"),
    ("new_folder", "New Tab Folder", "Create colored tab folder in " + active_sp_name, "", "F", "new tab folder pinned group organize create color"),
    ("saved_sessions", "Saved Sessions", "Save and restore sets of tabs", "", "◫", "saved sessions snapshots workspace save restore tabs backup"),
    ("today_clear", "Sweep Today Tabs", sweep_sub, "", "S", "sweep clear archive today tabs clean"),
    ("toggle_sidebar", "Toggle Sidebar", "Show or hide the sidebar", cmd_shortcut(is_macos, "S"), "◧", "sidebar toggle hide show panel"),
    ("toggle_split_view", "Open Split View", "Show two pages side by side", cmd_shift_shortcut(is_macos, "\\"), "◫", "split view dual pane side by side open toggle"),
    ("toggle_peek", "Open Peek Preview", "Preview a link without leaving this page", cmd_shift_shortcut(is_macos, "P"), "◰", "peek preview modal quick floating popup toggle peek"),
    ("open_current_in_peek", "Open Current Page in Peek", "Show this page in a floating preview", "", "◰", "open current page in peek preview modal floating"),
    ("swap_split_panes", "Swap Split Panes", "Swap the left and right pages", "", "⇄", "swap split panes switch left right flip"),
    ("close_split_view", "Close Split View", "Go back to one page", "", "×", "close split view exit single pane"),
    ("site_info", "Site Permissions and Info", "Connection, permissions and site data", cmd_shortcut(is_macos, "I"), "I", "site permissions info lock zoom camera microphone notifications location clipboard clear data meet"),
    ("inspect_cookies", "Inspect Site Cookies", "View and delete cookies for this site", "", "C", "cookies storage inspector site data clear chips httponly secure samesite"),
    ("toggle_devtools", "Toggle DevTools", "Elements, Console and Network", cmd_devtools_shortcut(is_macos), ">_", "devtools inspector elements console repl network dom styles f12"),
    ("toggle_perf_hud", "Page Performance HUD", "Show live layout and resource counts for this page", cmd_shift_shortcut(is_macos, "U"), "⚡", "page performance hud engine metrics dom nodes stylesheets images zoom cookies https stats"),
    ("export_pdf", "Save Page as PDF", "Choose paper size, margins and background", cmd_shortcut(is_macos, "P"), "P", "pdf print / export pdf save document page download a4 letter"),
    ("downloads", "Downloads", "Show recent downloads", cmd_shortcut(is_macos, "J"), "↓", "downloads files manager"),
    ("library", "Library", "Downloads, media, Spaces, Boosts and closed tabs in the sidebar", "", "▤", "library downloads media pictures files spaces boosts archived closed tabs"),
    ("history", "Browsing History", "Search and clear history", cmd_shortcut(is_macos, "Y"), "H", "history browsing recent visits clear search vault"),
    ("space_theme", "Customize Space Theme", "Rename or recolor " + active_sp_name, "", "◉", "customize space theme color rename palette appearance"),
    ("copy_url", "Copy Clean URL", omnibox_display_host(clean_tracking_url(current_url)), cmd_shift_shortcut(is_macos, "C"), "C", "copy clean url link address clipboard tracking utm"),
    ("open_settings", "Open Settings", "Search engine, appearance, privacy and data", cmd_shortcut(is_macos, ","), "⚙", "settings preferences options config search engine privacy data clear zoom"),
    ("toggle_dark_chrome", "Toggle Dark Mode", "Switch between light and dark appearance", "", "☾", "dark mode light theme chrome appearance color scheme night toggle"),
    ("shortcuts", "Keyboard Shortcuts", "Show all keyboard shortcuts", cmd_shortcut(is_macos, "/"), "?", "keyboard shortcuts hotkeys help cheatsheet guide"),
    ("reload", "Reload Page", "Load this page again", cmd_shortcut(is_macos, "R"), "↻", "reload refresh page"),
    ("find", "Find in Page", "Search the text of this page", cmd_shortcut(is_macos, "F"), "F", "find search text page in-page match"),
    ("zoom_in", "Zoom In", "Make this page bigger", cmd_shortcut(is_macos, "="), "+", "zoom in bigger larger magnify scale"),
    ("zoom_out", "Zoom Out", "Make this page smaller", cmd_shortcut(is_macos, "-"), "-", "zoom out smaller scale"),
    ("zoom_reset", "Actual Size", "Reset this page's zoom to 100%", cmd_shortcut(is_macos, "0"), "0", "zoom reset actual size 100 default scale"),
    ("close_tab", "Close Tab", "Close this tab", cmd_shortcut(is_macos, "W"), "×", "close tab remove"),
    ("duplicate_tab", "Duplicate Tab", "Open this page again in a new tab", "", "D", "duplicate tab copy clone"),
    ("close_other_tabs", "Close Other Tabs", "Close every Today tab but this one", "", "×", "close other tabs others clean"),
    ("back", "Back", "Go to the previous page", cmd_shortcut(is_macos, "["), "←", "back previous history go"),
    ("forward", "Forward", "Go to the next page", cmd_shortcut(is_macos, "]"), "→", "forward next history go"),
    ("clear_history", "Clear Browsing History", "Choose a time range to clear", "", "H", "clear history delete browsing data wipe range"),
  ]

}

///| Up to `limit` actions matching `raw_query` (title, subtitle or keywords), as Command Bar items: what the address
///| palette appends after its tabs, bookmarks and history, so "split" or "zoom" finds the command there too.
pub fn command_bar_matching_actions(
  snap : WorkspaceSnapshot,
  raw_query : String,
  current_url : String,
  is_macos : Bool,
  limit~ : Int = 2,
) -> Array[CommandBarItem] {
  let q = omni_ascii_lower(raw_query.trim())
  let out : Array[CommandBarItem] = []
  if q == "" || limit <= 0 {
    return out
  }
  for act in command_bar_action_catalog(snap, current_url, is_macos) {
    if out.length() >= limit {
      break
    }
    if cmd_contains(act.1, q) || cmd_contains(act.2, q) || cmd_contains(act.5, q) {
      out.push(CommandBarItem::{
        kind: CommandKind::Action,
        id: act.0,
        title: act.1,
        subtitle: act.2,
        badge: "",
        shortcut: act.3,
        monogram: act.4,
        accent: 0L,
        is_tab: false,
        is_space: false,
      })
    }
  }
  out
}

///| Builds up to `COMMAND_BAR_MAX_ITEMS` (7) ranked items for the Arc Command Bar.
pub fn build_command_bar_items(
  snap : WorkspaceSnapshot,
  raw_query : String,
  current_url : String,
  is_macos : Bool,
) -> Array[CommandBarItem] {
  let trimmed = raw_query.trim()
  let q = omni_ascii_lower(trimmed)
  let out : Array[CommandBarItem] = []
  let auto_space = next_auto_space_name(snap)
  let actions = command_bar_action_catalog(snap, current_url, is_macos)

  if q == "" {
    // Empty query: curated quick-access mix (up to 2 Open Tabs + 1 other Space + top Arc Actions = 7 rows)
    let mut tab_added = 0
    let mut i = 0
    while i < snap.tabs.length() && tab_added < 2 {
      if !snap.tabs[i].active {
        out.push(cmd_tab_item(snap, snap.tabs[i]))
        tab_added = tab_added + 1
      }
      i = i + 1
    }
    if tab_added == 0 && snap.tabs.length() > 0 {
      out.push(cmd_tab_item(snap, snap.tabs[0]))
      tab_added = 1
    }
    let mut s = 0
    while s < snap.spaces.length() {
      if !snap.spaces[s].active {
        out.push(cmd_space_item(snap.spaces[s]))
        break
      }
      s = s + 1
    }
    let mut a = 0
    while a < actions.length() && out.length() < COMMAND_BAR_MAX_ITEMS {
      let act = actions[a]
      out.push(CommandBarItem::{
        kind: CommandKind::Action,
        id: act.0,
        title: act.1,
        subtitle: act.2,
        badge: "",
        shortcut: act.3,
        monogram: act.4,
        accent: 0L,
        is_tab: false,
        is_space: false,
      })
      a = a + 1
    }
    return out
  }

  // Non-empty query: reserve 1 slot for Direct URL / Search fallback so max matches = 6
  let match_cap = COMMAND_BAR_MAX_ITEMS - 1
  let mut added_new_space = false

  // Explicit "new space <name>" command
  if q == "new space" || q.starts_with("new space ") {
    let custom = if trimmed.length() > 9 { trimmed.slice(9, trimmed.length()).trim() } else { "" }
    let sp_name = if custom != "" { custom } else { auto_space }
    out.push(CommandBarItem::{
      kind: CommandKind::NewSpace,
      id: sp_name,
      title: "New Space: " + sp_name,
      subtitle: "Create workspace",
      badge: "Space",
      shortcut: "",
      monogram: "+",
      accent: 0x8B5CF6FFL,
      is_tab: false,
      is_space: true,
    })
    added_new_space = true
  }

  // 1. Open Tabs (cross-Space)
  let mut ti = 0
  while ti < snap.tabs.length() && out.length() < match_cap {
    let t = snap.tabs[ti]
    let (sp_name, _) = cmd_space_info(snap, t.space_id)
    let title = workspace_tab_display_title(t)
    if cmd_contains(title, q) || cmd_contains(t.url, q) || cmd_contains(sp_name, q) {
      out.push(cmd_tab_item(snap, t))
    }
    ti = ti + 1
  }

  // 2. Spaces
  let mut si = 0
  while si < snap.spaces.length() && out.length() < match_cap {
    let sp = snap.spaces[si]
    if cmd_contains(sp.name, q) || cmd_contains(sp.id, q) || cmd_contains("space", q) {
      out.push(cmd_space_item(sp))
    }
    si = si + 1
  }

  // 3. Arc Actions
  let mut ai = 0
  while ai < actions.length() && out.length() < match_cap {
    let act = actions[ai]
    if !(added_new_space && act.0 == "new_space") {
      if cmd_contains(act.1, q) || cmd_contains(act.2, q) || cmd_contains(act.5, q) {
        out.push(CommandBarItem::{
          kind: CommandKind::Action,
          id: act.0,
          title: act.1,
          subtitle: act.2,
          badge: "",
          shortcut: act.3,
          monogram: act.4,
          accent: 0L,
          is_tab: false,
          is_space: false,
        })
      }
    }
    ai = ai + 1
  }

  // 4. Direct URL or Google Search fallback (always available on Enter)
  let normalized = omnibox_normalize_input(trimmed)
  if cmd_looks_like_url(trimmed) {
    out.push(CommandBarItem::{
      kind: CommandKind::NavigateUrl,
      id: normalized,
      title: "Open " + trimmed,
      subtitle: omnibox_display_host(normalized),
      badge: "URL",
      shortcut: "",
      monogram: "→",
      accent: 0L,
      is_tab: false,
      is_space: false,
    })
  } else {
    out.push(CommandBarItem::{
      kind: CommandKind::SearchWeb,
      id: normalized,
      title: "Search Google for \"" + trimmed + "\"",
      subtitle: "google.com",
      badge: "Search",
      shortcut: "",
      monogram: "G",
      accent: 0L,
      is_tab: false,
      is_space: false,
    })
  }
  out
}
