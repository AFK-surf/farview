test "mini player state lifecycle play mute jump dismiss and snapshot sync" {
  let empty = MiniPlayerState::empty()
  debug_assert(!empty.is_visible(), "empty mini player must not be visible")
  debug_assert(empty.jump_to_tab().is_none(), "empty mini player jump_to_tab is None")
  debug_assert(empty.progress_ratio() == 0.0, "empty progress ratio is 0")

  let snap = MediaHubSnapshot::{
    sessions: [
      MediaSessionItem::{
        tab_id: "tab-music",
        title: "Lo-Fi Coding Radio — Live Beats",
        artist_or_host: "music.youtube.com",
        url: "https://music.youtube.com/watch?v=demo123",
        playing: true,
        muted: false,
        is_live_call: false,
        duration_secs: 300,
        position_secs: 150,
      },
      MediaSessionItem::{
        tab_id: "tab-active",
        title: "Docs Walkthrough",
        artist_or_host: "developer.mozilla.org",
        url: "https://developer.mozilla.org/en-US/docs/Web",
        playing: false,
        muted: false,
        is_live_call: false,
        duration_secs: 120,
        position_secs: 30,
      },
    ],
  }

  let mp0 = empty.sync_from_snapshot(snap, "tab-active")
  debug_assert(mp0.is_visible(), "background playing media tab should make mini player visible")
  debug_assert(mp0.tab_id == "tab-music", "background playing tab selected first")
  debug_assert(mp0.domain == "music.youtube.com", "clean source domain extracted")
  debug_assert(mp0.playing && !mp0.muted, "initial playing/unmuted state")
  debug_assert(mp0.progress_ratio() > 0.49 && mp0.progress_ratio() < 0.51, "progress ratio is 0.5")
  match mp0.jump_to_tab() {
    Some(tid) => debug_assert(tid == "tab-music", "jump_to_tab returns playing tab id")
    None => debug_assert(false, "jump_to_tab should be Some")
  }

  let mp1 = mp0.toggle_play()
  debug_assert(!mp1.playing && mp1.is_visible(), "toggle_play pauses without hiding")
  debug_assert(mp1.status_label() == "PAUSED", "paused status label")

  let mp2 = mp1.toggle_mute()
  debug_assert(mp2.muted && mp2.status_label() == "MUTED", "toggle_mute sets muted")

  let mp3 = mp2.dismiss()
  debug_assert(!mp3.is_visible() && mp3.dismissed && !mp3.playing, "dismiss hides card and pauses")
  debug_assert(mp3.jump_to_tab().is_none(), "dismissed mini player jump_to_tab is None")

  // Same tab still paused stays dismissed on re-sync
  let paused_snap = MediaHubSnapshot::{
    sessions: [
      MediaSessionItem::{
        tab_id: "tab-music",
        title: "Lo-Fi Coding Radio — Live Beats",
        artist_or_host: "music.youtube.com",
        url: "https://music.youtube.com/watch?v=demo123",
        playing: false,
        muted: false,
        is_live_call: false,
        duration_secs: 300,
        position_secs: 150,
      },
    ],
  }
  let mp4 = mp3.sync_from_snapshot(paused_snap, "tab-active")
  debug_assert(!mp4.is_visible(), "dismissed tab stays hidden while paused")

  // Different tab starting playback revives mini player
  let next_snap = MediaHubSnapshot::{
    sessions: [
      MediaSessionItem::{
        tab_id: "tab-meet",
        title: "Architecture Design Sync",
        artist_or_host: "meet.google.com",
        url: "https://meet.google.com/abc-defg-hij",
        playing: true,
        muted: false,
        is_live_call: true,
        duration_secs: 0,
        position_secs: 0,
      },
    ],
  }
  let mp5 = mp4.sync_from_snapshot(next_snap, "tab-active")
  debug_assert(mp5.is_visible() && mp5.is_live && mp5.progress_ratio() == 1.0, "new live call revives mini player")
  debug_assert(mp5.status_label() == "LIVE", "live call status label")
}

test "omni suggest ranking priority switch-to-tab bookmark history calc and site search" {
  let tabs : Array[TabSummary] = [
    TabSummary::{
      id: "t-active",
      space_id: "sp-1",
      title: "Current Workspace",
      url: "https://example.org/home",
      pinned: false,
      favorite: false,
      active: true,
      state: "active",
      folder_id: "",
      last_active_secs: 100L,
    },
    TabSummary::{
      id: "t-gh",
      space_id: "sp-1",
      title: "GitHub — Farview Engine",
      url: "https://github.com/AFK-surf/farview",
      pinned: true,
      favorite: false,
      active: false,
      state: "active",
      folder_id: "",
      last_active_secs: 95L,
    },
  ]
  let bookmarks : Array[BookmarkEntry] = [
    BookmarkEntry::{
      id: "bm-1",
      title: "GitHub Actions Reference",
      url: "https://docs.github.com/en/actions",
      folder: "Dev",
      created_ms: 100L,
    },
    BookmarkEntry::{
      id: "bm-dup",
      title: "Farview Repo Duplicate",
      url: "https://github.com/AFK-surf/farview/",
      folder: "Dev",
      created_ms: 101L,
    },
  ]
  let history : Array[HistoryItemSummary] = [
    HistoryItemSummary::{
      url: "https://github.com/topics/metal",
      title: "Metal Graphics on GitHub",
      host: "github.com",
      visit_count: 14,
      last_visit_secs: 200L,
    },
  ]

  let ranked = rank_omni_suggest_items("github", tabs, bookmarks, history, max_items=6)
  debug_assert(ranked.length() == 4, "3 deduped matches + 1 search fallback")
  debug_assert((ranked[0].category is OmniSuggestCategory::SwitchTab) && ranked[0].tab_id == "t-gh", "open tab ranked first with SwitchTab")
  debug_assert(ranked[0].badge_label == "Switch to Tab", "Switch to Tab badge")
  debug_assert((ranked[1].category is OmniSuggestCategory::Bookmark) && ranked[1].url == "https://docs.github.com/en/actions", "bookmark ranked second")
  debug_assert((ranked[2].category is OmniSuggestCategory::History) && ranked[2].visits == 14, "history ranked third with visit count")
  debug_assert(ranked[3].category is OmniSuggestCategory::Search, "search fallback appended")

  // Instant Calc / Unit Conversion
  let calc_items = rank_omni_suggest_items("24px to rem", tabs, bookmarks, history, max_items=6)
  debug_assert(calc_items.length() >= 1 && (calc_items[0].category is OmniSuggestCategory::Calc), "unit conversion surfaces Calc at top")
  debug_assert(calc_items[0].title == "= 1.5 rem", "24px to rem evaluates to = 1.5 rem")

  let math_items = rank_omni_suggest_items("(12 + 8) * 3", tabs, bookmarks, history, max_items=6)
  debug_assert(math_items.length() >= 1 && (math_items[0].category is OmniSuggestCategory::Calc), "math expression surfaces Calc at top")
  debug_assert(math_items[0].url == "60", "copy value is 60")

  // Site search shortcuts (@gh, @yt, @mdn)
  let gh_items = rank_omni_suggest_items("@gh metal renderer", tabs, bookmarks, history, max_items=6)
  debug_assert(gh_items.length() >= 1 && (gh_items[0].category is OmniSuggestCategory::SiteSearch), "@gh produces SiteSearch")
  debug_assert(gh_items[0].url.contains("github.com/search"), "@gh resolves to github search URL")

  let yt_items = rank_omni_suggest_items("@yt jazz piano", tabs, bookmarks, history, max_items=6)
  debug_assert(yt_items.length() >= 1 && (yt_items[0].category is OmniSuggestCategory::SiteSearch), "@yt produces SiteSearch")
  debug_assert(yt_items[0].url.contains("youtube.com/results"), "@yt resolves to youtube search URL")

  let mdn_items = rank_omni_suggest_items("@mdn flexbox", tabs, bookmarks, history, max_items=6)
  debug_assert(mdn_items.length() >= 1 && (mdn_items[0].category is OmniSuggestCategory::SiteSearch), "@mdn produces SiteSearch")
  debug_assert(mdn_items[0].url.contains("developer.mozilla.org"), "@mdn resolves to MDN search URL")
}

test "omni suggest utf8 case-insensitive matching keyboard nav and section headers" {
  debug_assert(omni_suggest_utf8_lower("Café ÜBER 東京") == "café über 東京", "UTF-8 safe case folding preserves CJK and folds Latin-1")
  let sc = omni_suggest_match_score("CAFÉ", "Café Design Notes", "https://example.org/cafe", "example.org")
  debug_assert(sc > 90.0, "UTF-8 prefix match gets high score")
  let cjk = omni_suggest_match_score("東京", "東京グラフィックスガイド", "https://example.jp/tokyo", "example.jp")
  debug_assert(cjk > 90.0, "CJK UTF-8 prefix match succeeds")

  let tabs : Array[TabSummary] = [
    TabSummary::{
      id: "t-1",
      space_id: "sp-1",
      title: "東京グラフィックスガイド",
      url: "https://example.jp/tokyo",
      pinned: false,
      favorite: false,
      active: false,
      state: "active",
      folder_id: "",
      last_active_secs: 90L,
    },
  ]
  let st0 = OmniSuggestState::empty().update("東京", tabs, [], [], open=true)
  debug_assert(st0.open && st0.items.length() == 2 && st0.selected == 0, "state opens with selection at 0")

  // Section headers only appear at category boundaries
  match omni_suggest_section_header(st0.items, 0) {
    Some(h) => debug_assert(h == "Open Tabs", "first section is Open Tabs")
    None => debug_assert(false, "expected section header at 0")
  }
  match omni_suggest_section_header(st0.items, 1) {
    Some(h) => debug_assert(h == "Web Search", "second section is Web Search")
    None => debug_assert(false, "expected section header at 1")
  }

  let st1 = st0.move_down()
  debug_assert(st1.selected == 1, "move_down advances to 1")
  let st2 = st1.move_down()
  debug_assert(st2.selected == 0, "move_down wraps to 0")
  let st3 = st2.move_up()
  debug_assert(st3.selected == 1, "move_up wraps to last")
  match st0.resolve_enter() {
    Some(it) => debug_assert((it.category is OmniSuggestCategory::SwitchTab) && it.tab_id == "t-1", "Enter resolves SwitchTab")
    None => debug_assert(false, "expected resolved item")
  }
  let closed = st3.close()
  debug_assert(!closed.open && closed.selected == -1, "close clears open and selection")
}

test "omni suggest: one untouched-selection rule (Cmd+L empty lights nothing, Cmd+T and typed text light row 0, a moved selection survives a refresh)" {
  debug_assert(omni_suggest_untouched_selection("", 3) == -1, "Cmd+L, nothing typed: nothing lit")
  debug_assert(omni_suggest_untouched_selection("  ", 3) == -1, "blank counts as nothing typed")
  debug_assert(omni_suggest_untouched_selection("", 3, new_tab=true) == 0, "Cmd+T, nothing typed: first row lit")
  debug_assert(omni_suggest_untouched_selection("gi", 3) == 0, "typed: first row lit")
  debug_assert(omni_suggest_untouched_selection("gi", 0, new_tab=true) == -1, "no rows: nothing lit")
  let tabs : Array[TabSummary] = [
    TabSummary::{
      id: "t-a",
      space_id: "sp-1",
      title: "Alpha Docs",
      url: "https://alpha.example/docs",
      pinned: false,
      favorite: false,
      active: false,
      state: "active",
      folder_id: "",
      last_active_secs: 90L,
    },
    TabSummary::{
      id: "t-b",
      space_id: "sp-1",
      title: "Alpha Blog",
      url: "https://alpha.example/blog",
      pinned: false,
      favorite: false,
      active: false,
      state: "active",
      folder_id: "",
      last_active_secs: 80L,
    },
  ]
  let empty_l = OmniSuggestState::empty().update("", tabs, [], [])
  if empty_l.items.length() > 0 {
    debug_assert(empty_l.selected == -1, "demo update, Cmd+L empty: nothing lit like the app")
    let empty_t = OmniSuggestState::empty().update("", tabs, [], [], new_tab=true)
    debug_assert(empty_t.selected == 0, "demo update, Cmd+T empty: first row lit like the app")
  }
  let typed = OmniSuggestState::empty().update("alpha", tabs, [], [])
  debug_assert(typed.items.length() >= 2 && typed.selected == 0 && !typed.touched, "typed: row 0, untouched")
  let moved = typed.move_down()
  debug_assert(moved.touched && moved.selected == 1, "arrow moves and marks touched")
  let refreshed = moved.update("alpha", tabs, [], [])
  debug_assert(refreshed.selected == 1 && refreshed.touched, "a refresh keeps the moved selection")
  let closed = refreshed.close()
  let reopened = closed.update("alpha", tabs, [], [])
  debug_assert(reopened.selected == 0 && !reopened.touched, "after close the default rule applies again")
}

test "split bar state focus swap solo close and overlay mutual exclusion" {
  let closed = SplitBarState::closed()
  debug_assert(!closed.open, "initial split bar closed")

  let sb0 = SplitBarState::from_panes(
    true,
    "https://github.com/AFK-surf/farview",
    "https://developer.mozilla.org/en-US/docs/Web/CSS",
    0,
    false,
  )
  debug_assert(sb0.open, "split bar open")
  debug_assert(sb0.left_domain == "github.com", "left domain extracted")
  debug_assert(sb0.right_domain == "developer.mozilla.org", "right domain extracted")
  debug_assert(sb0.focused_pane == 0 && sb0.logical_pane_for_side(0) == 0 && sb0.logical_pane_for_side(1) == 1, "initial focus left")

  let (sb1, _) = sb0.apply(SplitBarAction::FocusRight)
  debug_assert(sb1.focused_pane == 1, "FocusRight focuses right pane")

  let (sb2, _) = sb1.apply(SplitBarAction::Swap)
  debug_assert(sb2.swapped && sb2.left_domain == "developer.mozilla.org" && sb2.right_domain == "github.com", "Swap exchanges domains")
  debug_assert(sb2.focused_pane == 0 && sb2.logical_pane_for_side(0) == 1, "Swap keeps focus on same logical page")

  let (sb_solo, solo_url) = sb2.apply(SplitBarAction::Solo)
  debug_assert(!sb_solo.open && solo_url == "https://developer.mozilla.org/en-US/docs/Web/CSS", "Solo exits split keeping focused page")

  let (sb_close, primary_url) = sb2.apply(SplitBarAction::CloseSplit)
  debug_assert(!sb_close.open && primary_url == "https://github.com/AFK-surf/farview", "CloseSplit closes secondary pane and keeps primary")

  // Local loopback URLs prefer page title; external sites keep concise domain
  let sb_local = SplitBarState::from_panes_with_titles(
    true,
    "AFK-surf/farview",
    "http://127.0.0.1:8080/repo",
    "MDN Web Docs",
    "https://developer.mozilla.org/en-US/docs/Web/CSS",
    0,
    false,
  )
  debug_assert(sb_local.left_domain == "AFK-surf/farview", "127.0.0.1 uses page title")
  debug_assert(sb_local.right_domain == "developer.mozilla.org", "external site keeps domain")

  // Overlay mutual exclusion
  let ov0 = ShellOverlaySet::close_all()
  let ov1 = ov0.open_omni()
  debug_assert(ov1.omni_open && !ov1.media_hub_open && !ov1.command_bar_open, "opening omni closes others")
  let ov2 = ov1.open_media_hub()
  debug_assert(!ov2.omni_open && ov2.media_hub_open, "opening media hub closes omni")
  let ov3 = ShellOverlaySet::close_all()
  debug_assert(!ov3.omni_open && !ov3.media_hub_open && !ov3.command_bar_open, "close_all closes all overlays")
}

fn os_test_tab(id : String, title : String, url : String) -> TabSummary {
  TabSummary::{
    id,
    space_id: "sp-1",
    title,
    url,
    pinned: false,
    favorite: false,
    active: false,
    state: "active",
    folder_id: "",
    last_active_secs: 10L,
  }
}

test "omnibox default selection takes a prefix hit and puts the fallback first otherwise" {
  let tabs = [
    os_test_tab("t-cur", "Current", "https://example.org/"),
    os_test_tab("t-gh", "Pull requests", "https://github.com/AFK-surf/farview/pulls"),
  ]
  // "gith" prefix-matches the open GitHub tab: it is the top row and Enter takes it.
  let gith = rank_omni_suggest_items("gith", tabs, [], [])
  debug_assert(gith[0].category is OmniSuggestCategory::SwitchTab, "github tab ranks first for gith")
  debug_assert(omnibox_default_selection("gith", gith) == 0, "prefix hit is preselected")
  let gith_o = omnibox_order_for_enter("gith", gith)
  debug_assert(gith_o[0].tab_id == "t-gh", "order keeps the tab on top")
  // A query with a space is search-like: the Web Search row moves to the top.
  let stars = rank_omni_suggest_items("github stars", tabs, [], [])
  debug_assert(omnibox_default_selection("github stars", stars) == -1, "search-like text is not a nav hit")
  let stars_o = omnibox_order_for_enter("github stars", stars)
  debug_assert(stars_o[0].category is OmniSuggestCategory::Search, "web search becomes the first row")
  debug_assert(stars_o.length() == stars.length(), "nothing is dropped by reordering")
  // An open tab's title start counts ("pull" -> "Pull requests").
  let pull = rank_omni_suggest_items("pull", tabs, [], [])
  debug_assert(omnibox_default_selection("pull", pull) == 0, "open tab title prefix is preselected")
  // A history entry matched only inside its title is not: fallback first.
  let hist = [
    HistoryItemSummary::{ url: "https://news.example/a", title: "Daily grid notes", host: "news.example", visit_count: 3, last_visit_secs: 1L },
  ]
  let grid = rank_omni_suggest_items("grid", [], [], hist)
  debug_assert(omnibox_default_selection("grid", grid) == -1, "history substring match is not preselected")
  debug_assert(omnibox_order_for_enter("grid", grid)[0].category is OmniSuggestCategory::Search, "fallback leads")
  // Calculations are pinned and explicit.
  let calc = rank_omni_suggest_items("2+3", tabs, [], [])
  debug_assert(omnibox_default_selection("2+3", calc) == 0, "calc preselected")
  // Empty query: nothing preselected, order unchanged.
  debug_assert(omnibox_default_selection("", gith) == -1, "empty query has no default")
  debug_assert(omnibox_order_for_enter("", gith).length() == gith.length(), "empty query keeps order")
  // www. and scheme are ignored.
  debug_assert(omnibox_default_selection("www.git", gith) == 0, "www. prefix still matches the host")
}

test "one action catalog: split, zoom and close find commands in the Command Bar and in the address palette" {
  let snap = WorkspaceSnapshot::empty()
  let split = command_bar_matching_actions(snap, "split", "https://example.org/", true)
  debug_assert(split.length() >= 1 && split[0].id == "toggle_split_view", "split finds Split View")
  let zoom = command_bar_matching_actions(snap, "zoom", "https://example.org/", true, limit=4)
  debug_assert(zoom.length() >= 3, "zoom finds in, out and actual size")
  let close = command_bar_matching_actions(snap, "close tab", "https://example.org/", true, limit=4)
  let mut has_close = false
  for c in close {
    if c.id == "close_tab" {
      has_close = true
    }
  }
  debug_assert(has_close, "close tab is a command now")
  let k = build_command_bar_items(snap, "zoom", "https://example.org/", true)
  let mut k_zoom = false
  for it in k {
    if it.id == "zoom_in" {
      k_zoom = true
    }
  }
  debug_assert(k_zoom, "Cmd+K finds zoom in too (same catalog)")
  let items = rank_omni_suggest_items("split", [], [], [])
  let with = omnibox_with_actions("split", items, split)
  debug_assert(with.length() == items.length() + split.length(), "the address palette appends the actions")
  debug_assert(with[with.length() - 1].category is OmniSuggestCategory::Action, "after the matches")
  debug_assert(omnibox_with_actions("github.com", items, split).length() == items.length(), "no actions for a URL")
  debug_assert(omnibox_with_actions("", items, split).length() == items.length(), "no actions for nothing typed")
}
