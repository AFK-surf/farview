fn st_test_space(theme : SpaceTheme) -> SpaceSummary {
  SpaceSummary::{ id: "work", name: "Work", accent: "#10B981", theme, active: true, tab_count: 2 }
}

test "space theme: JSON round trip keeps points, mode, grain and intensity" {
  let t = SpaceTheme::{
    points: [space_theme_point_at(0.1, 0.2), space_theme_point_at(0.5, 0.4), space_theme_point_at(0.9, 0.75)],
    mode: SpaceThemeMode::Dark,
    grain: 0.6,
    intensity: 0.8,
  }
  let json = encode_space_theme(t)
  match decode_space_theme(json) {
    Some(back) => {
      debug_assert(back.same(t), "theme round trips: " + json)
      debug_assert(back.mode.name() == "dark", "mode kept")
      debug_assert(back.points.length() == 3, "three points kept")
    }
    None => debug_assert(false, "decodes " + json)
  }
}

test "space theme: snapshot round trip carries the theme, accent-only spaces stay unset" {
  let themed = space_theme_with_grain(space_theme_add_point(space_theme_from_accent("#8B5CF6")), 0.3)
  let snap = WorkspaceSnapshot::{
    ..WorkspaceSnapshot::empty(),
    active_space_id: "work",
    spaces: [
      st_test_space(themed),
      SpaceSummary::{ id: "life", name: "Life", accent: "#F59E0B", theme: space_theme_unset(), active: false, tab_count: 0 },
    ],
  }
  let json = encode_workspace_snapshot(snap)
  debug_assert(json.contains("\"theme\":"), "themed space writes its theme")
  match parse_workspace_snapshot(json) {
    Some(back) => {
      debug_assert(back.spaces.length() == 2, "two spaces")
      debug_assert(back.spaces[0].theme.same(themed), "theme survives the wire")
      debug_assert(back.spaces[1].theme.is_unset(), "accent-only space stays unset")
      debug_assert(back.spaces[1].accent == "#F59E0B", "accent kept")
    }
    None => debug_assert(false, "snapshot parses")
  }
}

test "space theme: old accent-only JSON loads as one point with the exact accent" {
  let old = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"\",\"spaces\":[{\"id\":\"work\",\"name\":\"Work\",\"accent\":\"#2563EB\",\"active\":true,\"tabCount\":1}],\"folders\":[],\"tabs\":[],\"closedCount\":0}"
  match parse_workspace_snapshot(old) {
    Some(snap) => {
      let sp = snap.spaces[0]
      debug_assert(sp.theme.is_unset(), "no theme key: unset")
      let eff = space_theme_effective(sp.theme, sp.accent)
      debug_assert(eff.points.length() == 1, "one derived point")
      debug_assert(eff.points[0].rgba == 0x2563EBFFL, "derived point keeps the accent exactly")
      debug_assert(eff.mode.name() == "auto", "auto mode")
      debug_assert(eff.grain == 0.0, "no grain")
      debug_assert(eff.intensity == SPACE_THEME_DEFAULT_INTENSITY, "default intensity")
      // Re-encoding an unset theme writes no theme key, so old readers see the same object.
      debug_assert(!encode_workspace_snapshot(snap).contains("\"theme\""), "unset theme not written")
    }
    None => debug_assert(false, "old snapshot parses")
  }
}

test "space theme: malformed theme values are skipped or rejected safely" {
  debug_assert(decode_space_theme("").is_none(), "empty")
  debug_assert(decode_space_theme("{\"points\":[{\"x\":0.5").is_none(), "truncated")
  debug_assert(decode_space_theme("[1,2]").is_none(), "not an object")
  match decode_space_theme("{\"points\":[{\"x\":7,\"y\":-2,\"c\":\"nope\"},{},{},{}],\"mode\":\"weird\",\"grain\":5,\"future\":[1]}") {
    Some(t) => {
      debug_assert(t.points.length() == 3, "at most three points")
      debug_assert(t.points[0].x == 1.0 && t.points[0].y == 0.0, "positions clamped")
      debug_assert(t.points[0].rgba == space_theme_color_at(1.0, 0.0), "bad color falls back to the canvas color")
      debug_assert(t.mode.name() == "auto", "unknown mode is auto")
      debug_assert(t.grain == 1.0, "grain clamped")
    }
    None => debug_assert(false, "lenient theme decodes")
  }
  // A theme value that is not an object inside a snapshot leaves the space unset rather than dropping the snapshot.
  let snap_json = "{\"activeSpaceId\":\"a\",\"spaces\":[{\"id\":\"a\",\"name\":\"A\",\"accent\":\"#2563EB\",\"theme\":\"x\",\"active\":true}],\"folders\":[],\"tabs\":[],\"closedCount\":0}"
  match parse_workspace_snapshot(snap_json) {
    Some(s) => debug_assert(s.spaces[0].theme.is_unset(), "bad theme value: unset")
    None => debug_assert(false, "snapshot with a bad theme value still parses")
  }
}

test "space theme: points add up to three, remove down to one, move recolors" {
  let one = space_theme_from_accent("#2563EB")
  let two = space_theme_add_point(one)
  let three = space_theme_add_point(two)
  debug_assert(space_theme_add_point(three).points.length() == 3, "capped at three")
  debug_assert(space_theme_remove_point(three, 1).points.length() == 2, "removes one")
  debug_assert(space_theme_remove_point(one, 0).points.length() == 1, "keeps at least one")
  let moved = space_theme_move_point(two, 1, 0.33, 0.5)
  debug_assert(moved.points[1].rgba == space_theme_color_at(0.33, 0.5), "moved point takes the canvas color")
  debug_assert(space_theme_accent_hex(moved, "#000000") == "#2563EB", "first point is the accent")
}

test "space theme: canvas colors map back to their positions" {
  let mut x = 0.05
  while x < 1.0 {
    let c = space_theme_color_at(x, 0.4)
    let (px, py) = space_theme_position_of(c)
    debug_assert((px - x).abs() < 0.02 && (py - 0.4).abs() < 0.02, "position of color at x=" + x.to_string())
    x = x + 0.15
  }
  debug_assert(space_theme_hex(0x8B5CF6FFL) == "#8B5CF6", "hex")
}

test "space theme: presets are curated, named and valid" {
  let ps = space_theme_presets()
  debug_assert(ps.length() >= 9, "enough presets for two pages")
  for p in ps {
    debug_assert(p.label != "" && p.key != "", "named")
    let n = p.theme.points.length()
    debug_assert(n >= 1 && n <= 3, "1-3 points: " + p.key)
    match decode_space_theme(encode_space_theme(p.theme)) {
      Some(t) => debug_assert(t.same(p.theme), "preset round trips: " + p.key)
      None => debug_assert(false, "preset encodes: " + p.key)
    }
  }
}
