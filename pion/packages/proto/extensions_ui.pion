///| Pure-Pion portable Extensions model shared by `pion-host` and `pion-app`: what the Extensions Manager and the
///| toolbar show of each installed MV3 extension (`ExtensionUiItem`), the context menu items extensions registered
///| (`ExtensionUiMenuItem`), the popup the host asked the client to open, the host's saved per-extension state
///| (`<profile>/extensions_state.json`, `ExtensionsSavedState`), fault-tolerant JSON codecs for both, and the
///| small display rules the shell draws them by (badge text, badge ink, permission chips, monogram).

pub let EXTENSIONS_MAX_ITEMS : Int = 128
pub let EXTENSIONS_BADGE_MAX_CHARS : Int = 4

#derive(Eq)
pub struct ExtensionUiItem {
  pub id : String
  pub name : String
  pub version : String
  pub description : String
  pub enabled : Bool
  pub pinned : Bool
  ///| the toolbar title (`action.setTitle`, `default_title`, or the name)
  pub title : String
  pub badge_text : String
  ///| RGBA; 0 when the extension never set one (the theme's accent)
  pub badge_bg : Int64
  pub has_action : Bool
  pub has_popup : Bool
  ///| `chrome-extension://<id>/<popup>` ("" without a popup)
  pub popup_html_path : String
  pub options_url : String
  pub permissions : Array[String]
  pub host_permissions : Array[String]
  ///| where it was loaded from: `unpacked:<dir>`, `crx3:<file>`, or `import:<browser>`
  pub source : String
  ///| why it could not load ("" when it runs)
  pub error : String
}

///| A `chrome.contextMenus` item, for the page's context menu.
#derive(Eq)
pub struct ExtensionUiMenuItem {
  pub ext_id : String
  pub id : String
  pub title : String
  pub contexts : Array[String]
  pub parent_id : String
  pub kind : String
  pub enabled : Bool
  pub checked : Bool
}

pub struct ExtensionsUiSnapshot {
  pub items : Array[ExtensionUiItem]
  pub menus : Array[ExtensionUiMenuItem]
  ///| the popup a toolbar press opened (`ext_open_popup`), new each time `popup_seq` grows
  pub popup_ext_id : String
  pub popup_url : String
  pub popup_seq : Int
  ///| the last manager action's result ("Loaded Tab Notes 1.4.2", "manifest.json missing required field: name")
  pub status : String
  pub status_error : Bool
}

pub fn ExtensionsUiSnapshot::empty() -> ExtensionsUiSnapshot {
  ExtensionsUiSnapshot::{ items: [], menus: [], popup_ext_id: "", popup_url: "", popup_seq: 0, status: "", status_error: false }
}

pub fn ExtensionUiItem::blank(id : String) -> ExtensionUiItem {
  ExtensionUiItem::{
    id,
    name: "",
    version: "",
    description: "",
    enabled: true,
    pinned: false,
    title: "",
    badge_text: "",
    badge_bg: 0L,
    has_action: false,
    has_popup: false,
    popup_html_path: "",
    options_url: "",
    permissions: [],
    host_permissions: [],
    source: "",
    error: "",
  }
}

///| One saved extension of the profile (`extensions_state.json`).
pub struct ExtensionSavedEntry {
  pub id : String
  pub source : String
  pub enabled : Bool
  pub pinned : Bool
  ///| the version it last ran (`runtime.onInstalled` reason `update` when it changes)
  pub version : String
}

pub struct ExtensionsSavedState {
  pub entries : Array[ExtensionSavedEntry]
}

// ============================================================================
// Display rules
// ============================================================================

///| The badge as the toolbar draws it: trimmed, at most 4 characters (Chrome's own limit on what fits).
pub fn extension_badge_display(text : String) -> String {
  let t = text.trim()
  eu_prefix_chars(t, EXTENSIONS_BADGE_MAX_CHARS)
}

///| The first `n` characters of UTF-8 `s` (whole code points).
fn eu_prefix_chars(s : String, n : Int) -> String {
  let mut seen = 0
  let mut i = 0
  while i < s.length() {
    let b = s.code_unit_at(i).to_int() & 0xFF
    if (b & 0xC0) != 0x80 {
      if seen == n {
        return s.slice(0, i)
      }
      seen = seen + 1
    }
    i = i + 1
  }
  s
}

fn eu_ascii_upper(s : String) -> String {
  let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 97 && c <= 122 {
      sb.write_string(upper.slice(c - 97, c - 96))
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i = i + 1
  }
  sb.to_string()
}

fn eu_find(s : String, needle : String) -> Option[Int] {
  let n = needle.length()
  let mut i = 0
  while i + n <= s.length() {
    if s.slice(i, i + n) == needle {
      return Some(i)
    }
    i = i + 1
  }
  None
}

///| Text on a badge of `bg`: white while it keeps the 3:1 contrast of UI text on a small pill (WCAG relative
///| luminance; red, blue and green fills), near-black on light fills (yellow, white).
pub fn extension_badge_ink(bg : Int64) -> Int64 {
  if bg == 0L {
    return 0xFFFFFFFFL
  }
  let r = ((bg >> 24) & 255L).to_double() / 255.0
  let g = ((bg >> 16) & 255L).to_double() / 255.0
  let b = ((bg >> 8) & 255L).to_double() / 255.0
  let lin = fn(c : Double) -> Double { if c <= 0.04045 { c / 12.92 } else { math_pow((c + 0.055) / 1.055, 2.4) } }
  let l = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
  if 1.05 / (l + 0.05) >= 3.0 {
    0xFFFFFFFFL
  } else {
    0x1C1C1EFFL
  }
}

///| A permission or host pattern as a short chip label (`storage` -> `Storage`, `<all_urls>` -> `All sites`,
///| `https://*.example.com/*` -> `*.example.com`).
pub fn extension_permission_label(p : String) -> String {
  let s = p.trim()
  if s == "<all_urls>" || s == "*://*/*" || s == "http://*/*" || s == "https://*/*" {
    return "All sites"
  }
  match eu_find(s, "://") {
    Some(i) => {
      let rest = s.slice(i + 3, s.length())
      let end = match eu_find(rest, "/") {
        Some(k) => k
        None => rest.length()
      }
      let host = rest.slice(0, end)
      if host == "*" { "All sites" } else { host }
    }
    None => {
      let known = [
        ("activeTab", "Active tab"),
        ("contextMenus", "Context menus"),
        ("declarativeNetRequest", "Content blocking"),
        ("declarativeNetRequestWithHostAccess", "Content blocking"),
        ("scripting", "Scripting"),
        ("storage", "Storage"),
        ("unlimitedStorage", "Unlimited storage"),
        ("alarms", "Alarms"),
        ("tabs", "Tabs"),
        ("notifications", "Notifications"),
        ("cookies", "Cookies"),
        ("history", "History"),
        ("bookmarks", "Bookmarks"),
        ("downloads", "Downloads"),
        ("webRequest", "Web requests"),
        ("sidePanel", "Side panel"),
      ]
      for kv in known {
        let (k, v) = kv
        if k == s {
          return v
        }
      }
      if s == "" {
        ""
      } else {
        eu_ascii_upper(s.slice(0, 1)) + s.slice(1, s.length())
      }
    }
  }
}

///| The permission chips of an item: host access first (it is what people weigh), then API permissions, deduped.
pub fn extension_permission_chips(item : ExtensionUiItem, max~ : Int = 6) -> Array[String] {
  let out : Array[String] = []
  let add = fn(lbl : String) {
    if lbl != "" && !out.contains(lbl) && out.length() < max {
      out.push(lbl)
    }
  }
  for h in item.host_permissions {
    add(extension_permission_label(h))
  }
  for p in item.permissions {
    add(extension_permission_label(p))
  }
  out
}

///| One or two letters for an extension's tile (its name's first letter, uppercased).
pub fn extension_monogram(name : String) -> String {
  let t = name.trim()
  if t == "" {
    return "?"
  }
  eu_ascii_upper(eu_prefix_chars(t, 1))
}

///| The pinned, enabled extensions with a toolbar button, in their manager order.
pub fn extensions_pinned_items(snap : ExtensionsUiSnapshot) -> Array[ExtensionUiItem] {
  let out : Array[ExtensionUiItem] = []
  for it in snap.items {
    if it.pinned && it.enabled && it.has_action && it.error == "" {
      out.push(it)
    }
  }
  out
}

pub fn extensions_find(snap : ExtensionsUiSnapshot, id : String) -> Option[ExtensionUiItem] {
  for it in snap.items {
    if it.id == id {
      return Some(it)
    }
  }
  None
}

///| The snapshot with one item replaced (an optimistic toggle or pin before the host answers).
pub fn extensions_with_item(snap : ExtensionsUiSnapshot, item : ExtensionUiItem) -> ExtensionsUiSnapshot {
  let items : Array[ExtensionUiItem] = []
  for it in snap.items {
    items.push(if it.id == item.id { item } else { it })
  }
  ExtensionsUiSnapshot::{ ..snap, items, }
}

///| The snapshot without the item `id` (an optimistic removal).
pub fn extensions_without(snap : ExtensionsUiSnapshot, id : String) -> ExtensionsUiSnapshot {
  let items : Array[ExtensionUiItem] = []
  for it in snap.items {
    if it.id != id {
      items.push(it)
    }
  }
  let menus : Array[ExtensionUiMenuItem] = []
  for m in snap.menus {
    if m.ext_id != id {
      menus.push(m)
    }
  }
  ExtensionsUiSnapshot::{ ..snap, items, menus, }
}

///| The context menu items for one press: those whose `contexts` include `context` (or `all`), enabled ones of
///| enabled extensions, top level first then children under their parents (one level deep, as Chrome's).
pub fn extensions_menu_items_for(snap : ExtensionsUiSnapshot, context : String) -> Array[ExtensionUiMenuItem] {
  let fits = fn(m : ExtensionUiMenuItem) -> Bool {
    if m.contexts.length() == 0 {
      return context == "page"
    }
    m.contexts.contains(context) || m.contexts.contains("all")
  }
  let on = fn(ext_id : String) -> Bool {
    match extensions_find(snap, ext_id) {
      Some(it) => it.enabled
      None => false
    }
  }
  let out : Array[ExtensionUiMenuItem] = []
  for m in snap.menus {
    if m.parent_id == "" && fits(m) && on(m.ext_id) {
      out.push(m)
      for kid in snap.menus {
        if kid.ext_id == m.ext_id && kid.parent_id == m.id && fits(kid) {
          out.push(kid)
        }
      }
    }
  }
  out
}

// ============================================================================
// JSON codec
// ============================================================================

fn eu_b(v : Bool) -> String {
  if v { "true" } else { "false" }
}

fn eu_strs(a : Array[String]) -> String {
  let parts : Array[String] = []
  for s in a {
    parts.push(omni_json_escape(s))
  }
  "[" + parts.join(",") + "]"
}

fn eu_hex8(c : Int64) -> String {
  let hex = "0123456789abcdef"
  let sb = StringBuilder::new()
  let mut j = 0
  while j < 8 {
    let nib = ((c >> ((7 - j) * 4)) & 15L).to_int()
    sb.write_string(hex.slice(nib, nib + 1))
    j = j + 1
  }
  sb.to_string()
}

fn eu_parse_hex8(s : String) -> Int64 {
  let mut v = 0L
  let mut i = 0
  let t = if s.starts_with("#") { s.slice(1, s.length()) } else { s }
  if t.length() != 8 {
    return 0L
  }
  while i < t.length() {
    let c = t.code_unit_at(i).to_int()
    let d = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 102 {
      c - 87
    } else if c >= 65 && c <= 70 {
      c - 55
    } else {
      return 0L
    }
    v = (v << 4) | d.to_int64()
    i = i + 1
  }
  v
}

pub fn encode_extension_ui_item(it : ExtensionUiItem) -> String {
  "{\"id\":" + omni_json_escape(it.id) +
  ",\"name\":" + omni_json_escape(it.name) +
  ",\"version\":" + omni_json_escape(it.version) +
  ",\"description\":" + omni_json_escape(it.description) +
  ",\"enabled\":" + eu_b(it.enabled) +
  ",\"pinned\":" + eu_b(it.pinned) +
  ",\"title\":" + omni_json_escape(it.title) +
  ",\"badgeText\":" + omni_json_escape(it.badge_text) +
  ",\"badgeBg\":\"" + eu_hex8(it.badge_bg) + "\"" +
  ",\"hasAction\":" + eu_b(it.has_action) +
  ",\"hasPopup\":" + eu_b(it.has_popup) +
  ",\"popup\":" + omni_json_escape(it.popup_html_path) +
  ",\"options\":" + omni_json_escape(it.options_url) +
  ",\"permissions\":" + eu_strs(it.permissions) +
  ",\"hostPermissions\":" + eu_strs(it.host_permissions) +
  ",\"source\":" + omni_json_escape(it.source) +
  ",\"error\":" + omni_json_escape(it.error) + "}"
}

pub fn encode_extensions_ui_snapshot(snap : ExtensionsUiSnapshot) -> String {
  let items : Array[String] = []
  for it in snap.items {
    items.push(encode_extension_ui_item(it))
  }
  let menus : Array[String] = []
  for m in snap.menus {
    menus.push(
      "{\"extId\":" + omni_json_escape(m.ext_id) +
      ",\"id\":" + omni_json_escape(m.id) +
      ",\"title\":" + omni_json_escape(m.title) +
      ",\"contexts\":" + eu_strs(m.contexts) +
      ",\"parentId\":" + omni_json_escape(m.parent_id) +
      ",\"type\":" + omni_json_escape(m.kind) +
      ",\"enabled\":" + eu_b(m.enabled) +
      ",\"checked\":" + eu_b(m.checked) + "}",
    )
  }
  "{\"items\":[" + items.join(",") + "],\"menus\":[" + menus.join(",") +
  "],\"popupExtId\":" + omni_json_escape(snap.popup_ext_id) +
  ",\"popupUrl\":" + omni_json_escape(snap.popup_url) +
  ",\"popupSeq\":" + snap.popup_seq.to_string() +
  ",\"status\":" + omni_json_escape(snap.status) +
  ",\"statusError\":" + eu_b(snap.status_error) + "}"
}

///| A small JSON tree for the decoders below (built on the shared `OmniJsonParser`).
enum EuJson {
  Null
  Bool(Bool)
  Num(Double)
  Str(String)
  Arr(Array[EuJson])
  Obj(Array[(String, EuJson)])
}

fn eu_parse(p : OmniJsonParser, depth : Int) -> Option[EuJson] {
  if depth > 16 {
    return None
  }
  p.skip_ws()
  if p.i >= p.n {
    return None
  }
  let c = p.s.code_unit_at(p.i).to_int()
  if c == 0x22 {
    match p.parse_str() {
      Some(s) => Some(EuJson::Str(s))
      None => None
    }
  } else if c == 0x7B {
    p.i = p.i + 1
    let fields : Array[(String, EuJson)] = []
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(EuJson::Obj(fields))
    }
    while p.i < p.n {
      let k = match p.parse_str() {
        Some(k) => k
        None => return None
      }
      p.skip_ws()
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
        return None
      }
      p.i = p.i + 1
      match eu_parse(p, depth + 1) {
        Some(v) => fields.push((k, v))
        None => return None
      }
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
        p.i = p.i + 1
      } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
        p.i = p.i + 1
        return Some(EuJson::Obj(fields))
      } else {
        return None
      }
    }
    None
  } else if c == 0x5B {
    p.i = p.i + 1
    let items : Array[EuJson] = []
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
      p.i = p.i + 1
      return Some(EuJson::Arr(items))
    }
    while p.i < p.n {
      match eu_parse(p, depth + 1) {
        Some(v) => items.push(v)
        None => return None
      }
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
        p.i = p.i + 1
      } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
        return Some(EuJson::Arr(items))
      } else {
        return None
      }
    }
    None
  } else if c == 0x74 && p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(EuJson::Bool(true))
  } else if c == 0x66 && p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(EuJson::Bool(false))
  } else if c == 0x6E && p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "null" {
    p.i = p.i + 4
    Some(EuJson::Null)
  } else {
    match p.parse_number() {
      Some(d) => Some(EuJson::Num(d))
      None => None
    }
  }
}

fn eu_parse_root(json : String) -> Option[EuJson] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  match eu_parse(p, 0) {
    Some(v) => {
      p.skip_ws()
      if p.i == p.n { Some(v) } else { None }
    }
    None => None
  }
}

fn eu_get(v : EuJson, k : String) -> Option[EuJson] {
  match v {
    EuJson::Obj(fields) => {
      for f in fields {
        let (fk, fv) = f
        if fk == k {
          return Some(fv)
        }
      }
      None
    }
    _ => None
  }
}

fn eu_str(v : EuJson, k : String) -> String {
  match eu_get(v, k) {
    Some(EuJson::Str(s)) => s
    _ => ""
  }
}

fn eu_bool(v : EuJson, k : String, def : Bool) -> Bool {
  match eu_get(v, k) {
    Some(EuJson::Bool(b)) => b
    _ => def
  }
}

fn eu_int(v : EuJson, k : String, def : Int) -> Int {
  match eu_get(v, k) {
    Some(EuJson::Num(d)) => d.to_int()
    _ => def
  }
}

fn eu_str_arr(v : EuJson, k : String) -> Array[String] {
  let out : Array[String] = []
  match eu_get(v, k) {
    Some(EuJson::Arr(items)) => {
      for it in items {
        match it {
          EuJson::Str(s) => if out.length() < 64 { out.push(s) }
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

fn eu_item(v : EuJson) -> Option[ExtensionUiItem] {
  let id = eu_str(v, "id").trim()
  if id == "" {
    return None
  }
  let popup = eu_str(v, "popup")
  Some(ExtensionUiItem::{
    id,
    name: eu_str(v, "name"),
    version: eu_str(v, "version"),
    description: eu_str(v, "description"),
    enabled: eu_bool(v, "enabled", true),
    pinned: eu_bool(v, "pinned", false),
    title: eu_str(v, "title"),
    badge_text: eu_str(v, "badgeText"),
    badge_bg: eu_parse_hex8(eu_str(v, "badgeBg")),
    has_action: eu_bool(v, "hasAction", false),
    has_popup: eu_bool(v, "hasPopup", popup != ""),
    popup_html_path: popup,
    options_url: eu_str(v, "options"),
    permissions: eu_str_arr(v, "permissions"),
    host_permissions: eu_str_arr(v, "hostPermissions"),
    source: eu_str(v, "source"),
    error: eu_str(v, "error"),
  })
}

///| Parses an `ExtensionsUiSnapshot` (`wire::Message::ExtensionsState`). Extra keys are ignored, items without an
///| id dropped, at most `max_items` kept; malformed or truncated JSON gives `None`.
pub fn parse_extensions_ui_snapshot(json : String, max_items~ : Int = EXTENSIONS_MAX_ITEMS) -> Option[ExtensionsUiSnapshot] {
  let root = match eu_parse_root(json) {
    Some(v) => v
    None => return None
  }
  if !(root is EuJson::Obj(_)) {
    return None
  }
  let items : Array[ExtensionUiItem] = []
  match eu_get(root, "items") {
    Some(EuJson::Arr(arr)) => {
      for v in arr {
        match eu_item(v) {
          Some(it) => {
            let mut dup = false
            for o in items {
              if o.id == it.id {
                dup = true
              }
            }
            if items.length() < max_items && !dup {
              items.push(it)
            }
          }
          None => ()
        }
      }
    }
    _ => ()
  }
  let menus : Array[ExtensionUiMenuItem] = []
  match eu_get(root, "menus") {
    Some(EuJson::Arr(arr)) => {
      for v in arr {
        let id = eu_str(v, "id")
        let ext_id = eu_str(v, "extId")
        if id != "" && ext_id != "" && menus.length() < 256 {
          menus.push(ExtensionUiMenuItem::{
            ext_id,
            id,
            title: eu_str(v, "title"),
            contexts: eu_str_arr(v, "contexts"),
            parent_id: eu_str(v, "parentId"),
            kind: if eu_str(v, "type") == "" { "normal" } else { eu_str(v, "type") },
            enabled: eu_bool(v, "enabled", true),
            checked: eu_bool(v, "checked", false),
          })
        }
      }
    }
    _ => ()
  }
  Some(ExtensionsUiSnapshot::{
    items,
    menus,
    popup_ext_id: eu_str(root, "popupExtId"),
    popup_url: eu_str(root, "popupUrl"),
    popup_seq: eu_int(root, "popupSeq", 0),
    status: eu_str(root, "status"),
    status_error: eu_bool(root, "statusError", false),
  })
}

pub fn encode_extensions_saved_state(state : ExtensionsSavedState) -> String {
  let parts : Array[String] = []
  for e in state.entries {
    parts.push(
      "{\"id\":" + omni_json_escape(e.id) + ",\"source\":" + omni_json_escape(e.source) + ",\"enabled\":" + eu_b(e.enabled) +
      ",\"pinned\":" + eu_b(e.pinned) + ",\"version\":" + omni_json_escape(e.version) + "}",
    )
  }
  "{\"version\":1,\"extensions\":[" + parts.join(",") + "]}"
}

///| Parses `extensions_state.json`; a damaged file gives an empty state (never a panic), duplicate ids keep the
///| first.
pub fn parse_extensions_saved_state(json : String) -> ExtensionsSavedState {
  let entries : Array[ExtensionSavedEntry] = []
  match eu_parse_root(json) {
    Some(root) =>
    match eu_get(root, "extensions") {
      Some(EuJson::Arr(arr)) => {
        for v in arr {
          let id = eu_str(v, "id").trim()
          let mut dup = false
          for e in entries {
            if e.id == id {
              dup = true
            }
          }
          if id != "" && !dup && entries.length() < EXTENSIONS_MAX_ITEMS {
            entries.push(ExtensionSavedEntry::{
              id,
              source: eu_str(v, "source"),
              enabled: eu_bool(v, "enabled", true),
              pinned: eu_bool(v, "pinned", false),
              version: eu_str(v, "version"),
            })
          }
        }
      }
      _ => ()
    }
    None => ()
  }
  ExtensionsSavedState::{ entries, }
}
