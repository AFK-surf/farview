fn atc_t(id : String, pattern : String, kind : String, space : String, enabled~ : Bool = true, quick~ : Bool = false) -> AtcRule {
  AtcRule::{ id, pattern, match_kind: kind, target_space_id: space, enabled, open_in_quick_window: quick }
}

fn atc_t_space(r : Option[AtcRule]) -> String {
  match r {
    Some(x) => x.target_space_id
    None => "-"
  }
}

test "ATC: exact host matches the host and www., never another host or a subdomain" {
  let rules = [atc_t("a", "github.com", "host", "work")]
  debug_assert(atc_t_space(match_atc_rule(rules, "https://github.com/AFK-surf")) == "work", "exact host")
  debug_assert(atc_t_space(match_atc_rule(rules, "https://WWW.GitHub.com:443/x")) == "work", "www. and case and port")
  debug_assert(match_atc_rule(rules, "https://gist.github.com/x") is None, "a subdomain is not the exact host")
  debug_assert(match_atc_rule(rules, "https://notgithub.com/") is None, "a longer host is not it")
  debug_assert(match_atc_rule(rules, "https://evil.com/?u=github.com") is None, "the host only, never the query")
  debug_assert(match_atc_rule(rules, "about:blank") is None, "internal pages never route")
  debug_assert(match_atc_rule(rules, "file:///github.com") is None, "files never route")
}

test "ATC: *.github.com matches any subdomain, not the apex nor a look-alike" {
  let rules = [atc_t("a", "*.github.com", "host", "dev")]
  debug_assert(atc_t_space(match_atc_rule(rules, "https://gist.github.com/x")) == "dev", "one level")
  debug_assert(atc_t_space(match_atc_rule(rules, "https://a.b.github.com/")) == "dev", "two levels")
  debug_assert(match_atc_rule(rules, "https://github.com/") is None, "the apex is not a subdomain")
  debug_assert(match_atc_rule(rules, "https://evilgithub.com/") is None, "a look-alike is not a subdomain")
}

test "ATC: prefix with and without a scheme, glob with * and ?" {
  let pre = [atc_t("p", "docs.google.com/spreadsheets", "prefix", "finance")]
  debug_assert(atc_t_space(match_atc_rule(pre, "https://docs.google.com/spreadsheets/d/1")) == "finance", "bare prefix")
  debug_assert(match_atc_rule(pre, "https://docs.google.com/document/d/1") is None, "another path")
  let pre2 = [atc_t("p", "HTTPS://Linear.app/team", "prefix", "work")]
  debug_assert(atc_t_space(match_atc_rule(pre2, "https://linear.app/team/issue/1")) == "work", "scheme prefix, authority case-folded")
  debug_assert(match_atc_rule(pre2, "http://linear.app/team") is None, "the scheme counts when written")
  let glob = [atc_t("g", "*.notion.so/*/page-?", "glob", "notes")]
  debug_assert(atc_t_space(match_atc_rule(glob, "https://acme.notion.so/x/page-1")) == "notes", "glob")
  debug_assert(match_atc_rule(glob, "https://acme.notion.so/x/page-12") is None, "? is one character")
  debug_assert(atc_glob_match("a*b*c", "aXXbYYc") && !atc_glob_match("a*b*c", "aXXbYY"), "backtracking glob")
}

test "ATC: disabled rules are skipped; priority is most specific, then list order" {
  let off = [atc_t("x", "github.com", "host", "work", enabled=false)]
  debug_assert(match_atc_rule(off, "https://github.com/") is None, "a disabled rule never matches")
  let rules = [
    atc_t("1", "*github*", "glob", "glob"),
    atc_t("2", "*.github.com", "host", "wild"),
    atc_t("3", "gist.github.com", "host", "exact"),
    atc_t("4", "gist.github.com/AFK", "prefix", "prefix"),
    atc_t("5", "gist.github.com", "host", "exact-later"),
  ]
  debug_assert(atc_t_space(match_atc_rule(rules, "https://gist.github.com/AFK/x")) == "exact", "exact host beats prefix, wildcard and glob; earliest among equals")
  debug_assert(atc_t_space(match_atc_rule(rules, "https://api.github.com/")) == "wild", "wildcard beats glob")
  debug_assert(atc_t_space(match_atc_rule(rules, "https://github.io/github")) == "glob", "glob last")
  // the same answer whatever order they were added in (except ties)
  let rev = [rules[3], rules[2], rules[1], rules[0]]
  debug_assert(atc_t_space(match_atc_rule(rev, "https://api.github.com/")) == "wild", "order-independent")
  let two_prefixes = [atc_t("a", "x.com/a", "prefix", "short"), atc_t("b", "x.com/a/b", "prefix", "long")]
  debug_assert(atc_t_space(match_atc_rule(two_prefixes, "https://x.com/a/b/c")) == "long", "the longer prefix wins")
}

test "ATC: upsert, toggle, delete, ids, validity and preview" {
  let r0 : Array[AtcRule] = []
  let r1 = atc_rules_upsert(r0, atc_t("", "https://www.Figma.com/files", "host", "design"))
  debug_assert(r1.length() == 1 && r1[0].id == "atc-1" && r1[0].pattern == "figma.com", "new rule normalized with an id")
  let r2 = atc_rules_upsert(r1, atc_t("", "*.linear.app", "host", "", quick=true))
  debug_assert(r2.length() == 2 && r2[1].id == "atc-2", "a Quick Window rule needs no Space")
  let r3 = atc_rules_upsert(r2, atc_t("atc-1", "figma.com", "host", "work"))
  debug_assert(r3.length() == 2 && r3[0].target_space_id == "work", "same id replaced in place")
  debug_assert(atc_rules_upsert(r3, atc_t("", "", "host", "work")).length() == 2, "no pattern is not kept")
  debug_assert(atc_rules_upsert(r3, atc_t("", "a.com", "host", "")).length() == 2, "nowhere to go is not kept")
  let r4 = atc_rules_toggle(r3, "atc-2", false)
  debug_assert(!r4[1].enabled && r4[0].enabled, "toggle one")
  let r5 = atc_rules_delete(r4, "atc-1")
  debug_assert(r5.length() == 1 && r5[0].id == "atc-2", "delete one")
  debug_assert(atc_next_rule_id(r3) == "atc-3", "next id past the largest")
  debug_assert(atc_pattern_preview("*.github.com", "host") == "Links to any subdomain of github.com", "preview wildcard")
  debug_assert(atc_pattern_preview("HTTPS://www.github.com/x", "host") == "Links to github.com", "preview host")
  debug_assert(atc_pattern_preview("", "glob") == "Type a site, like github.com", "preview empty")
  debug_assert(normalize_atc_match_kind("Regex") == "host", "unknown kinds read as host")
}

test "ATC: JSON round trip; malformed, truncated and invalid input is safe" {
  let snap = AtcRulesSnapshot::{
    rules: [atc_t("atc-1", "github.com", "host", "work"), atc_t("atc-2", "a\"b*", "glob", "", enabled=false, quick=true)],
  }
  let json = encode_atc_rules(snap)
  match parse_atc_rules(json) {
    Some(back) => {
      debug_assert(back.rules.length() == 2, "two rules")
      debug_assert(back.rules[0] == snap.rules[0], "first equal")
      debug_assert(back.rules[1].pattern == "a\"b*" && back.rules[1].open_in_quick_window && !back.rules[1].enabled, "second equal")
    }
    None => debug_assert(false, "parses " + json)
  }
  let mut i = 0
  while i < json.length() {
    let _ = parse_atc_rules(json.slice(0, i))
    i = i + 1
  }
  debug_assert(parse_atc_rules("{\"rules\":[{\"pattern\":\"x\"").is_none(), "truncated is None")
  match parse_atc_rules("{\"v\":2,\"rules\":[{\"pattern\":\"\",\"targetSpaceId\":\"w\"},{\"id\":\"d\",\"pattern\":\"a.com\",\"targetSpaceId\":\"w\",\"extra\":[1,{}]},{\"id\":\"d\",\"pattern\":\"b.com\",\"targetSpaceId\":\"w\"}]}") {
    Some(s) => debug_assert(s.rules.length() == 1 && s.rules[0].pattern == "a.com", "invalid and repeated ids dropped, extra keys skipped")
    None => debug_assert(false, "tolerant parse")
  }
}

fn arch_tab(id : String, last : Int64, pinned~ : Bool = false, favorite~ : Bool = false, active~ : Bool = false, state~ : String = "idle", folder~ : String = "") -> TabSummary {
  TabSummary::{
    id,
    space_id: "work",
    title: "T" + id,
    url: "https://" + id + ".test/",
    pinned,
    favorite,
    active,
    state,
    folder_id: folder,
    last_active_secs: last,
  }
}

test "auto-archive: only expired unpinned Today tabs; never active, pinned, Favorite, foldered or audible" {
  let now = 1000000L
  let day = 24L * 3600L
  let tabs = [
    arch_tab("old", now - day - 1L),
    arch_tab("fresh", now - day + 60L),
    arch_tab("active", now - 9L * day, active=true),
    arch_tab("pinned", now - 9L * day, pinned=true),
    arch_tab("fav", now - 9L * day, favorite=true),
    arch_tab("folder", now - 9L * day, folder="f1"),
    arch_tab("audible", now - 9L * day, state="playing"),
    arch_tab("call", now - 9L * day, state="capturing"),
    arch_tab("form", now - 9L * day, state="protected"),
    arch_tab("exact", now - day),
  ]
  let due = select_tabs_for_auto_archive(tabs, now, 24)
  debug_assert(due.length() == 2 && due[0].id == "old" && due[1].id == "exact", "only the expired Today tabs, in order: \{due.length()}")
  debug_assert(select_tabs_for_auto_archive(tabs, now, 0).length() == 0, "Never archives nothing")
  debug_assert(select_tabs_for_auto_archive(tabs, now, 12 * 24 * 30).length() == 0, "nothing older than 30 days")
}

test "archived tabs: ring keeps newest first, re-archived ids move up, capped; JSON round trip and search" {
  let mk = fn(id : String, at : Int64) -> ArchivedTabItem {
    ArchivedTabItem::{ id, title: "Tab " + id, url: "https://" + id + ".test/x", host: "", space_id: "work", archived_at_secs: at, last_active_secs: at - 100L }
  }
  let r1 = archived_tabs_push([], [mk("1", 10L), mk("2", 10L)], cap=3)
  debug_assert(r1.length() == 2 && r1[0].id == "2" && r1[0].host == "2.test", "newest first, host filled")
  let r2 = archived_tabs_push(r1, [mk("3", 20L), mk("1", 30L)], cap=3)
  debug_assert(r2.length() == 3 && r2[0].id == "1" && r2[1].id == "3" && r2[2].id == "2", "re-archived moves to the front")
  let r3 = archived_tabs_push(r2, [mk("4", 40L)], cap=3)
  debug_assert(r3.length() == 3 && r3[0].id == "4" && r3[2].id == "3", "the oldest falls off")
  debug_assert(archived_tabs_remove(r3, "1").length() == 2, "remove one")
  debug_assert(filter_archived_tabs(r3, "TAB 4").length() == 1 && filter_archived_tabs(r3, "").length() == 3, "search")
  let json = encode_archived_tabs(ArchivedTabsSnapshot::{ items: r3 })
  match parse_archived_tabs(json) {
    Some(back) => {
      debug_assert(back.items.length() == 3, "three back")
      debug_assert(back.items[0] == r3[0] && back.items[2] == r3[2], "items equal")
    }
    None => debug_assert(false, "parses " + json)
  }
  let mut i = 0
  while i < json.length() {
    let _ = parse_archived_tabs(json.slice(0, i))
    i = i + 1
  }
  match parse_archived_tabs(json, max_items=1) {
    Some(s) => debug_assert(s.items.length() == 1, "max_items")
    None => debug_assert(false, "max_items parse")
  }
  match parse_archived_tabs("{\"items\":[{\"id\":\"\",\"url\":\"u\"},{\"id\":\"a\",\"url\":\"\"},{\"id\":\"b\",\"url\":\"https://b.test\",\"archivedAtSecs\":-5}]}") {
    Some(s) => debug_assert(s.items.length() == 1 && s.items[0].archived_at_secs == 0L, "invalid dropped, negatives clamped")
    None => debug_assert(false, "tolerant parse")
  }
}

test "auto PiP: JSON round trip, normalization, corner snap and placement" {
  let s = AutoPipState::{
    active: true,
    tab_id: "42",
    title: "Lo-fi \"beats\"",
    host: "youtube.com",
    playing: true,
    muted: false,
    progress: 0.25,
    duration_secs: 240,
    corner: "tl",
    w: 400.0,
    h: 1.0,
  }
  let json = encode_auto_pip_state(s)
  match parse_auto_pip_state(json) {
    Some(back) => {
      debug_assert(back.active && back.tab_id == "42" && back.title == "Lo-fi \"beats\"", "fields")
      debug_assert(back.progress == 0.25 && back.duration_secs == 240 && back.corner == "tl", "progress and corner")
      debug_assert(back.w == 400.0 && back.h == 225.0, "16:9 kept: \{back.h}")
      debug_assert(back == normalize_auto_pip_state(s), "round trip equals normalized")
    }
    None => debug_assert(false, "parses " + json)
  }
  let mut i = 0
  while i < json.length() {
    let _ = parse_auto_pip_state(json.slice(0, i))
    i = i + 1
  }
  let odd = normalize_auto_pip_state(AutoPipState::{ ..AutoPipState::hidden(), active: true, tab_id: " ", progress: 3.0, corner: "middle", w: 10.0 })
  debug_assert(!odd.active, "no tab, not shown")
  debug_assert(odd.progress == 1.0 && odd.corner == "br" && odd.w == AUTO_PIP_MIN_W, "clamped")
  debug_assert(AutoPipState::hidden().w == 320.0 && AutoPipState::hidden().h == 180.0, "320x180 default")
  debug_assert(auto_pip_snap_corner(900.0, 700.0, 1000.0, 800.0) == "br", "br")
  debug_assert(auto_pip_snap_corner(100.0, 700.0, 1000.0, 800.0) == "bl", "bl")
  debug_assert(auto_pip_snap_corner(900.0, 100.0, 1000.0, 800.0) == "tr", "tr")
  debug_assert(auto_pip_snap_corner(100.0, 100.0, 1000.0, 800.0) == "tl", "tl")
  let (x, y) = auto_pip_corner_origin("br", 320.0, 180.0, 100.0, 50.0, 1000.0, 800.0, 16.0)
  debug_assert(x == 764.0 && y == 654.0, "br origin \{x},\{y}")
  let (x2, y2) = auto_pip_corner_origin("tl", 320.0, 180.0, 100.0, 50.0, 1000.0, 800.0, 16.0)
  debug_assert(x2 == 116.0 && y2 == 66.0, "tl origin")
}
