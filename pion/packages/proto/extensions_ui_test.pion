///| Extensions Manager / toolbar model: codecs, badge display rules, chips, menu selection, saved state.

fn eu_t_item(id : String, name : String) -> ExtensionUiItem {
  ExtensionUiItem::{
    ..ExtensionUiItem::blank(id),
    name,
    version: "1.2.3",
    description: "Says \"hi\"\n",
    title: name,
    has_action: true,
    has_popup: true,
    popup_html_path: "chrome-extension://" + id + "/popup.html",
    permissions: ["storage", "contextMenus", "storage"],
    host_permissions: ["https://*.example.com/*", "<all_urls>"],
    source: "unpacked:/exts/" + id,
  }
}

test "ExtensionsUiSnapshot JSON round-trip keeps every field, drops bad items, and tolerates junk" {
  let a = ExtensionUiItem::{ ..eu_t_item("aaa", "Tab Notes"), pinned: true, badge_text: "12", badge_bg: 0xFF3B30FFL }
  let b = ExtensionUiItem::{ ..eu_t_item("bbb", "Dark"), enabled: false, has_popup: false, popup_html_path: "", error: "bad manifest" }
  let snap = ExtensionsUiSnapshot::{
    items: [a, b],
    menus: [
      ExtensionUiMenuItem::{ ext_id: "aaa", id: "root", title: "Note", contexts: ["page", "selection"], parent_id: "", kind: "normal", enabled: true, checked: false },
      ExtensionUiMenuItem::{ ext_id: "aaa", id: "kid", title: "Pin", contexts: ["page"], parent_id: "root", kind: "checkbox", enabled: true, checked: true },
    ],
    popup_ext_id: "aaa",
    popup_url: "chrome-extension://aaa/popup.html",
    popup_seq: 7,
    status: "Loaded Tab Notes 1.2.3",
    status_error: false,
  }
  let json = encode_extensions_ui_snapshot(snap)
  match parse_extensions_ui_snapshot(json) {
    Some(s) => {
      debug_assert(s.items.length() == 2 && s.menus.length() == 2, "counts")
      let x = s.items[0]
      debug_assert(x.id == "aaa" && x.name == "Tab Notes" && x.version == "1.2.3" && x.description == "Says \"hi\"\n", "strings")
      debug_assert(x.pinned && x.enabled && x.badge_text == "12" && x.badge_bg == 0xFF3B30FFL, "badge + flags")
      debug_assert(x.has_popup && x.popup_html_path == "chrome-extension://aaa/popup.html" && x.has_action, "popup")
      debug_assert(x.permissions.length() == 3 && x.host_permissions[1] == "<all_urls>" && x.source == "unpacked:/exts/aaa", "perms")
      debug_assert(!s.items[1].enabled && s.items[1].error == "bad manifest" && !s.items[1].has_popup, "second item")
      debug_assert(s.menus[1].parent_id == "root" && s.menus[1].kind == "checkbox" && s.menus[1].checked, "menus")
      debug_assert(s.popup_seq == 7 && s.popup_ext_id == "aaa" && s.status == "Loaded Tab Notes 1.2.3", "popup + status")
      debug_assert(encode_extensions_ui_snapshot(s) == json, "stable re-encode")
    }
    None => debug_assert(false, "parse failed: " + json)
  }
  // duplicates and id-less items dropped, unknown keys ignored, cap honored
  let junk = "{\"x\":{\"deep\":[1,2,{\"a\":null}]},\"items\":[{\"id\":\"\"},{\"id\":\"z\",\"name\":\"Z\",\"extra\":[true]},{\"id\":\"z\"},{\"id\":\"y\"}]}"
  match parse_extensions_ui_snapshot(junk, max_items=1) {
    Some(s) => debug_assert(s.items.length() == 1 && s.items[0].name == "Z" && s.items[0].enabled, "junk tolerated")
    None => debug_assert(false, "junk rejected")
  }
  // every truncation is rejected without a panic
  let mut i = 0
  while i < json.length() {
    debug_assert(parse_extensions_ui_snapshot(json.slice(0, i)) is None, "truncation at " + i.to_string())
    i = i + 7
  }
  debug_assert(parse_extensions_ui_snapshot("[]") is None, "not an object")
}

test "badge display, badge ink contrast, permission chips and monogram" {
  debug_assert(extension_badge_display(" 1234567 ") == "1234", "4 chars")
  debug_assert(extension_badge_display("\u{4F60}\u{597D}\u{4E16}\u{754C}\u{FF01}") == "\u{4F60}\u{597D}\u{4E16}\u{754C}", "4 code points")
  debug_assert(extension_badge_display("") == "", "empty")
  debug_assert(extension_badge_ink(0xFF3B30FFL) == 0xFFFFFFFFL, "white on red")
  debug_assert(extension_badge_ink(0x1A73E8FFL) == 0xFFFFFFFFL, "white on blue")
  debug_assert(extension_badge_ink(0xFFCC00FFL) == 0x1C1C1EFFL, "dark on yellow")
  debug_assert(extension_badge_ink(0xFFFFFFFFL) == 0x1C1C1EFFL, "dark on white")
  debug_assert(extension_badge_ink(0L) == 0xFFFFFFFFL, "theme default: white")
  let chips = extension_permission_chips(eu_t_item("aaa", "Tab Notes"))
  debug_assert(chips.join("|") == "*.example.com|All sites|Storage|Context menus", "chips: " + chips.join("|"))
  debug_assert(extension_permission_label("https://*/*") == "All sites" && extension_permission_label("fooBar") == "FooBar", "labels")
  debug_assert(extension_monogram(" tab notes") == "T" && extension_monogram("") == "?", "monogram")
  debug_assert(extension_monogram("\u{00E9}clair") == "\u{00E9}", "non-ASCII monogram keeps the whole letter")
}

test "pinned items, optimistic edits and context menu selection" {
  let a = ExtensionUiItem::{ ..eu_t_item("aaa", "A"), pinned: true }
  let b = ExtensionUiItem::{ ..eu_t_item("bbb", "B"), pinned: true, enabled: false }
  let c = ExtensionUiItem::{ ..eu_t_item("ccc", "C"), pinned: true, has_action: false }
  let d = ExtensionUiItem::{ ..eu_t_item("ddd", "D"), pinned: false }
  let snap = ExtensionsUiSnapshot::{
    ..ExtensionsUiSnapshot::empty(),
    items: [a, b, c, d],
    menus: [
      ExtensionUiMenuItem::{ ext_id: "aaa", id: "r", title: "R", contexts: ["selection"], parent_id: "", kind: "normal", enabled: true, checked: false },
      ExtensionUiMenuItem::{ ext_id: "aaa", id: "k", title: "K", contexts: ["all"], parent_id: "r", kind: "normal", enabled: true, checked: false },
      ExtensionUiMenuItem::{ ext_id: "aaa", id: "p", title: "P", contexts: [], parent_id: "", kind: "normal", enabled: true, checked: false },
      ExtensionUiMenuItem::{ ext_id: "bbb", id: "q", title: "Q", contexts: ["all"], parent_id: "", kind: "normal", enabled: true, checked: false },
    ],
  }
  let pinned = extensions_pinned_items(snap)
  debug_assert(pinned.length() == 1 && pinned[0].id == "aaa", "only enabled pinned items with an action")
  let pinned_d = extensions_pinned_items(extensions_with_item(snap, ExtensionUiItem::{ ..d, pinned: true }))
  debug_assert(pinned_d.length() == 2 && pinned_d[1].id == "ddd", "optimistic pin keeps order")
  let gone = extensions_without(snap, "aaa")
  debug_assert(gone.items.length() == 3 && gone.menus.length() == 1, "removal drops its menus")
  let sel = extensions_menu_items_for(snap, "selection")
  debug_assert(sel.length() == 2 && sel[0].id == "r" && sel[1].id == "k", "selection: parent then child")
  let page = extensions_menu_items_for(snap, "page")
  debug_assert(page.length() == 1 && page[0].id == "p", "page: default contexts, disabled extension hidden")
}

test "extensions_state.json round-trip, damage and duplicates" {
  let st = ExtensionsSavedState::{
    entries: [
      ExtensionSavedEntry::{ id: "aaa", source: "unpacked:/x/a", enabled: true, pinned: true, version: "1.0" },
      ExtensionSavedEntry::{ id: "bbb", source: "crx3:/x/b.crx", enabled: false, pinned: false, version: "2.0" },
    ],
  }
  let json = encode_extensions_saved_state(st)
  let back = parse_extensions_saved_state(json)
  debug_assert(back.entries.length() == 2, "2 entries")
  debug_assert(back.entries[0].pinned && back.entries[1].source == "crx3:/x/b.crx" && !back.entries[1].enabled, "fields")
  debug_assert(encode_extensions_saved_state(back) == json, "stable")
  debug_assert(parse_extensions_saved_state(json.slice(0, json.length() - 3)).entries.length() == 0, "damaged file: empty")
  debug_assert(parse_extensions_saved_state("").entries.length() == 0, "empty file")
  let dup = "{\"extensions\":[{\"id\":\"a\",\"pinned\":true},{\"id\":\"a\"},{\"source\":\"x\"}]}"
  let d = parse_extensions_saved_state(dup)
  debug_assert(d.entries.length() == 1 && d.entries[0].pinned && d.entries[0].enabled, "first of duplicates, defaults")
}
