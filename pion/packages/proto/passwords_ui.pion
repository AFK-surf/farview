///| Pure-Pion portable Password Manager & Form Autofill wire model shared by `pion-host` and `pion-app`.
///|
///| - `PasswordItemSummary` is what list broadcasts carry: never a password. A password crosses the wire only in a
///|   `PasswordRevealResult`, sent to the one client that asked for it (`password_reveal`, Settings show/copy).
///| - `PasswordPromptState` is the Save / Update prompt after a login form was sent; the captured password stays on
///|   the host, the prompt names it by `prompt_id`.
///| - `AutofillSuggestion` is one saved login offered for the focused field (`password_autofill_query`); choosing one
///|   (`password_autofill_fill`) has the host decrypt it and type it into the page itself.
///| - `PwJson` is a small fault-tolerant JSON value codec, also used by the `passwords` vault.

pub let PW_VERB_LIST : String = "password_list"
pub let PW_VERB_SAVE : String = "password_save"
pub let PW_VERB_DISMISS : String = "password_dismiss"
pub let PW_VERB_DELETE : String = "password_delete"
pub let PW_VERB_REVEAL : String = "password_reveal"
pub let PW_VERB_AUTOFILL_QUERY : String = "password_autofill_query"
pub let PW_VERB_AUTOFILL_FILL : String = "password_autofill_fill"
///| `password_import` (arg: a CSV path, `""` for the newest passwords export in the Downloads folder) and
///| `password_export` (writes `Farview Passwords.csv` owner-only into Downloads); both answer `password_io`
pub let PW_VERB_IMPORT : String = "password_import"
pub let PW_VERB_EXPORT : String = "password_export"
///| host -> client verbs (`wire::Message::Act(verb, json, "")`)
pub let PW_VERB_STATE : String = "passwords_state"
pub let PW_VERB_PROMPT : String = "password_prompt"
pub let PW_VERB_SUGGESTIONS : String = "password_suggestions"
pub let PW_VERB_REVEALED : String = "password_revealed"
pub let PW_VERB_IO : String = "password_io"

pub let PW_LIST_MAX_ITEMS : Int = 2000
pub let PW_SUGGESTIONS_MAX : Int = 8

// ---------------------------------------------------------------------------
// JSON value codec
// ---------------------------------------------------------------------------

pub enum PwJson {
  Null
  Bool(Bool)
  Num(Double)
  Str(String)
  Arr(Array[PwJson])
  Obj(Array[(String, PwJson)])
}

fn pwj_value(p : OmniJsonParser, depth : Int) -> Option[PwJson] {
  if depth > 32 {
    return None
  }
  p.skip_ws()
  if p.i >= p.n {
    return None
  }
  let c = p.s.code_unit_at(p.i).to_int()
  if c == 0x22 {
    return match p.parse_str() {
      Some(s) => Some(PwJson::Str(s))
      None => None
    }
  }
  if c == 0x7B {
    p.i = p.i + 1
    let fields : Array[(String, PwJson)] = []
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(PwJson::Obj(fields))
    }
    while p.i < p.n {
      let key = match p.parse_str() {
        Some(k) => k
        None => return None
      }
      p.skip_ws()
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
        return None
      }
      p.i = p.i + 1
      match pwj_value(p, depth + 1) {
        Some(v) => fields.push((key, v))
        None => return None
      }
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
        p.i = p.i + 1
      } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
        p.i = p.i + 1
        return Some(PwJson::Obj(fields))
      } else {
        return None
      }
    }
    return None
  }
  if c == 0x5B {
    p.i = p.i + 1
    let items : Array[PwJson] = []
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
      p.i = p.i + 1
      return Some(PwJson::Arr(items))
    }
    while p.i < p.n {
      match pwj_value(p, depth + 1) {
        Some(v) => items.push(v)
        None => return None
      }
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
        p.i = p.i + 1
      } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
        return Some(PwJson::Arr(items))
      } else {
        return None
      }
    }
    return None
  }
  if p.s.slice(p.i, p.n).starts_with("true") {
    p.i = p.i + 4
    return Some(PwJson::Bool(true))
  }
  if p.s.slice(p.i, p.n).starts_with("false") {
    p.i = p.i + 5
    return Some(PwJson::Bool(false))
  }
  if p.s.slice(p.i, p.n).starts_with("null") {
    p.i = p.i + 4
    return Some(PwJson::Null)
  }
  match p.parse_number() {
    Some(d) => Some(PwJson::Num(d))
    None => None
  }
}

///| Parses one JSON value; trailing bytes other than whitespace, or malformed input, give `None`.
pub fn pw_json_parse(s : String) -> Option[PwJson] {
  let p = OmniJsonParser::{ s, n: s.length(), i: 0 }
  match pwj_value(p, 0) {
    Some(v) => {
      p.skip_ws()
      if p.i == p.n { Some(v) } else { None }
    }
    None => None
  }
}

///| Parses a JSON object (anything else gives `None`).
pub fn pw_json_obj(s : String) -> Option[PwJson] {
  match pw_json_parse(s) {
    Some(PwJson::Obj(f)) => Some(PwJson::Obj(f))
    _ => None
  }
}

pub fn pw_json_quote(s : String) -> String {
  omni_json_escape(s)
}

pub fn PwJson::get(self : PwJson, key : String) -> PwJson {
  match self {
    PwJson::Obj(fields) => {
      for f in fields {
        let (k, v) = f
        if k == key {
          return v
        }
      }
      PwJson::Null
    }
    _ => PwJson::Null
  }
}

pub fn PwJson::str(self : PwJson, key : String) -> String {
  match self.get(key) {
    PwJson::Str(s) => s
    PwJson::Num(d) => d.to_int64().to_string()
    _ => ""
  }
}

pub fn PwJson::int64(self : PwJson, key : String) -> Int64 {
  match self.get(key) {
    PwJson::Num(d) => d.to_int64()
    PwJson::Str(s) =>
    match pw_parse_i64(s) {
      Some(v) => v
      None => 0L
    }
    _ => 0L
  }
}

pub fn PwJson::int(self : PwJson, key : String) -> Int {
  self.int64(key).to_int()
}

pub fn PwJson::bool(self : PwJson, key : String) -> Bool {
  match self.get(key) {
    PwJson::Bool(b) => b
    PwJson::Num(d) => d != 0.0
    PwJson::Str(s) => s == "true" || s == "1"
    _ => false
  }
}

pub fn PwJson::items(self : PwJson, key : String) -> Array[PwJson] {
  match self.get(key) {
    PwJson::Arr(a) => a
    _ => []
  }
}

pub fn pw_parse_i64(raw : String) -> Option[Int64] {
  let s = raw.trim()
  if s == "" {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0).to_int() == 0x2D {
    neg = true
    i = 1
  }
  let mut acc = 0L
  let mut digits = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c < 0x30 || c > 0x39 || digits > 18 {
      return None
    }
    acc = acc * 10L + (c - 0x30).to_int64()
    digits = digits + 1
    i = i + 1
  }
  if digits == 0 {
    return None
  }
  Some(if neg { 0L - acc } else { acc })
}

// ---------------------------------------------------------------------------
// Wire model
// ---------------------------------------------------------------------------

///| A saved login as lists show it: everything but the password.
#derive(Eq)
pub struct PasswordItemSummary {
  pub id : String
  pub origin : String
  pub signon_realm : String
  pub username : String
  pub display_name : String
  pub created_at : Int64
  pub updated_at : Int64
  pub last_used_at : Int64
  pub times_used : Int
}

pub struct PasswordListSnapshot {
  pub query : String
  pub items : Array[PasswordItemSummary]
}

pub fn PasswordListSnapshot::empty() -> PasswordListSnapshot {
  PasswordListSnapshot::{ query: "", items: [] }
}

///| The Save / Update prompt after a login form was sent (`kind` is `"save"` or `"update"`).
#derive(Eq)
pub struct PasswordPromptState {
  pub visible : Bool
  pub prompt_id : String
  pub kind : String
  pub origin : String
  pub username : String
  pub display_name : String
  ///| how many characters the captured password has (drawn as dots; the password itself stays on the host)
  pub password_len : Int
}

pub fn PasswordPromptState::hidden() -> PasswordPromptState {
  PasswordPromptState::{ visible: false, prompt_id: "", kind: "save", origin: "", username: "", display_name: "", password_len: 0 }
}

///| One saved login offered for the focused field. `exact` is false for a login saved on another host of the same
///| site (`accounts.example.com` for `www.example.com`): the dropdown names its origin.
#derive(Eq)
pub struct AutofillSuggestion {
  pub id : String
  pub origin : String
  pub username : String
  pub display_name : String
  pub exact : Bool
}

///| `password_autofill_query`: the page and the focused field (and the form's password field, `-1` for none).
pub struct AutofillQuery {
  pub req_id : String
  pub url : String
  pub field_id : Int
  pub password_field_id : Int
}

///| `password_suggestions`: the answer to an `AutofillQuery`.
pub struct AutofillSnapshot {
  pub req_id : String
  pub field_id : Int
  pub password_field_id : Int
  pub suggestions : Array[AutofillSuggestion]
  ///| the focused field is a new-password field (or the form's password field): offer "Generate strong password"
  pub can_generate : Bool
}

pub fn AutofillSnapshot::empty() -> AutofillSnapshot {
  AutofillSnapshot::{ req_id: "", field_id: -1, password_field_id: -1, suggestions: [], can_generate: false }
}

///| `password_autofill_fill`: fill saved login `id` (or, with `generate`, a new strong password) into the fields.
pub struct AutofillFillRequest {
  pub url : String
  pub id : String
  pub field_id : Int
  pub password_field_id : Int
  pub generate : Bool
}

///| Every client -> host password command but the autofill pair (`password_save`, `password_dismiss`,
///| `password_delete`, `password_reveal`, `password_list`): the fields a verb does not use are left empty.
pub struct PasswordCommand {
  pub prompt_id : String
  pub id : String
  pub req_id : String
  pub username : String
  pub query : String
  ///| `password_dismiss`: also never offer to save on this origin again
  pub never : Bool
}

pub fn PasswordCommand::empty() -> PasswordCommand {
  PasswordCommand::{ prompt_id: "", id: "", req_id: "", username: "", query: "", never: false }
}

///| `password_revealed`: sent only to the client that asked (`ok=false` when the login is gone).
pub struct PasswordRevealResult {
  pub req_id : String
  pub id : String
  pub ok : Bool
  pub password : String
}

// ---------------------------------------------------------------------------
// Codecs
// ---------------------------------------------------------------------------

fn pw_summary_json(it : PasswordItemSummary) -> String {
  "{\"id\":" +
  omni_json_escape(it.id) +
  ",\"origin\":" +
  omni_json_escape(it.origin) +
  ",\"signon_realm\":" +
  omni_json_escape(it.signon_realm) +
  ",\"username\":" +
  omni_json_escape(it.username) +
  ",\"display_name\":" +
  omni_json_escape(it.display_name) +
  ",\"created_at\":" +
  it.created_at.to_string() +
  ",\"updated_at\":" +
  it.updated_at.to_string() +
  ",\"last_used_at\":" +
  it.last_used_at.to_string() +
  ",\"times_used\":" +
  it.times_used.to_string() +
  "}"
}

fn pw_summary_of(v : PwJson) -> PasswordItemSummary {
  PasswordItemSummary::{
    id: v.str("id"),
    origin: v.str("origin"),
    signon_realm: v.str("signon_realm"),
    username: v.str("username"),
    display_name: v.str("display_name"),
    created_at: v.int64("created_at"),
    updated_at: v.int64("updated_at"),
    last_used_at: v.int64("last_used_at"),
    times_used: v.int("times_used"),
  }
}

pub fn encode_password_list(snap : PasswordListSnapshot) -> String {
  let parts : Array[String] = []
  for it in snap.items {
    if parts.length() >= PW_LIST_MAX_ITEMS {
      break
    }
    parts.push(pw_summary_json(it))
  }
  "{\"query\":" + omni_json_escape(snap.query) + ",\"items\":[" + parts.join(",") + "]}"
}

pub fn parse_password_list(json : String) -> Option[PasswordListSnapshot] {
  match pw_json_obj(json) {
    Some(v) => {
      let items : Array[PasswordItemSummary] = []
      for it in v.items("items") {
        if items.length() >= PW_LIST_MAX_ITEMS {
          break
        }
        let s = pw_summary_of(it)
        if s.id != "" {
          items.push(s)
        }
      }
      Some(PasswordListSnapshot::{ query: v.str("query"), items })
    }
    _ => None
  }
}

pub fn encode_password_prompt(p : PasswordPromptState) -> String {
  "{\"visible\":" +
  (if p.visible { "true" } else { "false" }) +
  ",\"prompt_id\":" +
  omni_json_escape(p.prompt_id) +
  ",\"kind\":" +
  omni_json_escape(p.kind) +
  ",\"origin\":" +
  omni_json_escape(p.origin) +
  ",\"username\":" +
  omni_json_escape(p.username) +
  ",\"display_name\":" +
  omni_json_escape(p.display_name) +
  ",\"password_len\":" +
  p.password_len.to_string() +
  "}"
}

pub fn parse_password_prompt(json : String) -> Option[PasswordPromptState] {
  match pw_json_obj(json) {
    Some(v) => {
      let kind = if v.str("kind") == "update" { "update" } else { "save" }
      Some(PasswordPromptState::{
        visible: v.bool("visible"),
        prompt_id: v.str("prompt_id"),
        kind,
        origin: v.str("origin"),
        username: v.str("username"),
        display_name: v.str("display_name"),
        password_len: v.int("password_len"),
      })
    }
    _ => None
  }
}

pub fn encode_autofill_query(q : AutofillQuery) -> String {
  "{\"req_id\":" +
  omni_json_escape(q.req_id) +
  ",\"url\":" +
  omni_json_escape(q.url) +
  ",\"field_id\":" +
  q.field_id.to_string() +
  ",\"password_field_id\":" +
  q.password_field_id.to_string() +
  "}"
}

fn pw_id_or_none(v : PwJson, key : String) -> Int {
  match v.get(key) {
    PwJson::Num(d) => d.to_int()
    _ => -1
  }
}

pub fn parse_autofill_query(json : String) -> Option[AutofillQuery] {
  match pw_json_obj(json) {
    Some(v) =>
    Some(AutofillQuery::{
      req_id: v.str("req_id"),
      url: v.str("url"),
      field_id: pw_id_or_none(v, "field_id"),
      password_field_id: pw_id_or_none(v, "password_field_id"),
    })
    _ => None
  }
}

pub fn encode_autofill_snapshot(s : AutofillSnapshot) -> String {
  let parts : Array[String] = []
  for g in s.suggestions {
    if parts.length() >= PW_SUGGESTIONS_MAX {
      break
    }
    parts.push(
      "{\"id\":" +
      omni_json_escape(g.id) +
      ",\"origin\":" +
      omni_json_escape(g.origin) +
      ",\"username\":" +
      omni_json_escape(g.username) +
      ",\"display_name\":" +
      omni_json_escape(g.display_name) +
      ",\"exact\":" +
      (if g.exact { "true" } else { "false" }) +
      "}",
    )
  }
  "{\"req_id\":" +
  omni_json_escape(s.req_id) +
  ",\"field_id\":" +
  s.field_id.to_string() +
  ",\"password_field_id\":" +
  s.password_field_id.to_string() +
  ",\"can_generate\":" +
  (if s.can_generate { "true" } else { "false" }) +
  ",\"suggestions\":[" +
  parts.join(",") +
  "]}"
}

pub fn parse_autofill_snapshot(json : String) -> Option[AutofillSnapshot] {
  match pw_json_obj(json) {
    Some(v) => {
      let out : Array[AutofillSuggestion] = []
      for g in v.items("suggestions") {
        if out.length() >= PW_SUGGESTIONS_MAX {
          break
        }
        let id = g.str("id")
        if id != "" {
          out.push(AutofillSuggestion::{
            id,
            origin: g.str("origin"),
            username: g.str("username"),
            display_name: g.str("display_name"),
            exact: g.bool("exact"),
          })
        }
      }
      Some(AutofillSnapshot::{
        req_id: v.str("req_id"),
        field_id: pw_id_or_none(v, "field_id"),
        password_field_id: pw_id_or_none(v, "password_field_id"),
        suggestions: out,
        can_generate: v.bool("can_generate"),
      })
    }
    _ => None
  }
}

pub fn encode_autofill_fill(r : AutofillFillRequest) -> String {
  "{\"url\":" +
  omni_json_escape(r.url) +
  ",\"id\":" +
  omni_json_escape(r.id) +
  ",\"field_id\":" +
  r.field_id.to_string() +
  ",\"password_field_id\":" +
  r.password_field_id.to_string() +
  ",\"generate\":" +
  (if r.generate { "true" } else { "false" }) +
  "}"
}

pub fn parse_autofill_fill(json : String) -> Option[AutofillFillRequest] {
  match pw_json_obj(json) {
    Some(v) =>
    Some(AutofillFillRequest::{
      url: v.str("url"),
      id: v.str("id"),
      field_id: pw_id_or_none(v, "field_id"),
      password_field_id: pw_id_or_none(v, "password_field_id"),
      generate: v.bool("generate"),
    })
    _ => None
  }
}

pub fn encode_password_command(c : PasswordCommand) -> String {
  "{\"prompt_id\":" +
  omni_json_escape(c.prompt_id) +
  ",\"id\":" +
  omni_json_escape(c.id) +
  ",\"req_id\":" +
  omni_json_escape(c.req_id) +
  ",\"username\":" +
  omni_json_escape(c.username) +
  ",\"query\":" +
  omni_json_escape(c.query) +
  ",\"never\":" +
  (if c.never { "true" } else { "false" }) +
  "}"
}

pub fn parse_password_command(json : String) -> Option[PasswordCommand] {
  match pw_json_obj(json) {
    Some(v) =>
    Some(PasswordCommand::{
      prompt_id: v.str("prompt_id"),
      id: v.str("id"),
      req_id: v.str("req_id"),
      username: v.str("username"),
      query: v.str("query"),
      never: v.bool("never"),
    })
    _ => None
  }
}

pub fn encode_password_reveal(r : PasswordRevealResult) -> String {
  "{\"req_id\":" +
  omni_json_escape(r.req_id) +
  ",\"id\":" +
  omni_json_escape(r.id) +
  ",\"ok\":" +
  (if r.ok { "true" } else { "false" }) +
  ",\"password\":" +
  omni_json_escape(r.password) +
  "}"
}

pub fn parse_password_reveal(json : String) -> Option[PasswordRevealResult] {
  match pw_json_obj(json) {
    Some(v) =>
    Some(PasswordRevealResult::{ req_id: v.str("req_id"), id: v.str("id"), ok: v.bool("ok"), password: v.str("password") })
    _ => None
  }
}

///| `password_io`: what an import or export did (`count` logins, the file it used, or why it did nothing).
pub struct PasswordIoResult {
  pub ok : Bool
  pub kind : String
  pub path : String
  pub count : Int
  pub error : String
}

pub fn encode_password_io(r : PasswordIoResult) -> String {
  "{\"ok\":" +
  (if r.ok { "true" } else { "false" }) +
  ",\"kind\":" +
  omni_json_escape(r.kind) +
  ",\"path\":" +
  omni_json_escape(r.path) +
  ",\"count\":" +
  r.count.to_string() +
  ",\"error\":" +
  omni_json_escape(r.error) +
  "}"
}

pub fn parse_password_io(json : String) -> Option[PasswordIoResult] {
  match pw_json_obj(json) {
    Some(v) =>
    Some(PasswordIoResult::{ ok: v.bool("ok"), kind: v.str("kind"), path: v.str("path"), count: v.int("count"), error: v.str("error") })
    None => None
  }
}

///| The toast an import or export result reads as.
pub fn password_io_message(r : PasswordIoResult) -> String {
  if !r.ok {
    return if r.error != "" { r.error } else { "Nothing was done" }
  }
  let n = r.count.to_string() + (if r.count == 1 { " password" } else { " passwords" })
  if r.kind == "export" { "Exported " + n } else if r.count == 0 { "Passwords already up to date" } else { "Imported " + n }
}

///| Case-insensitive search over a list's origin, username and display name (`""` keeps all).
pub fn password_list_filter(items : Array[PasswordItemSummary], query : String) -> Array[PasswordItemSummary] {
  let q = omni_ascii_lower(query.trim())
  if q == "" {
    return items
  }
  let out : Array[PasswordItemSummary] = []
  for it in items {
    let hay = omni_ascii_lower(it.origin + " " + it.username + " " + it.display_name + " " + it.signon_realm)
    if hay.contains(q) {
      out.push(it)
    }
  }
  out
}

///| The host part of an origin (`https://accounts.example.com:8443` -> `accounts.example.com`), for display.
pub fn password_origin_host(origin : String) -> String {
  let mut s = origin
  let k = s.index_of("://")
  if k >= 0 {
    s = s.slice(k + 3, s.length())
  }
  let slash = s.index_of("/")
  if slash >= 0 {
    s = s.slice(0, slash)
  }
  let colon = s.index_of(":")
  if colon >= 0 {
    s = s.slice(0, colon)
  }
  s
}
