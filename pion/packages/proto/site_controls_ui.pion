///| Pure-Pion portable Site Control Center & Downloads Popover UI model,
///| compact JSON codec with malformed/truncated resilience, and human-readable
///| formatting helpers shared by `pion-app` and `pion-host`.

pub let DOWNLOADS_MAX_ITEMS : Int = 6

pub struct DownloadSummary {
  pub id : String
  pub filename : String
  pub url : String
  pub mime : String
  pub bytes : Int64
  pub state : String
  pub path : String
}

///| Normalizes a Web/Host permission token (`granted`/`allow`, `denied`/`deny`/`block`, `prompt`/`ask`)
///| into canonical UI 3-state tokens: `"allow"`, `"ask"`, or `"deny"`.
pub fn normalize_perm_state(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "allow" || s == "granted" {
    "allow"
  } else if s == "deny" || s == "denied" || s == "block" || s == "blocked" {
    "deny"
  } else {
    "ask"
  }
}

///| Returns true when the site has any active media permission (`camera`, `microphone`, or `screen_capture`) allowed.
pub fn site_has_granted_media(pm : Option[SitePermSummary]) -> Bool {
  match pm {
    Some(p) =>
    normalize_perm_state(p.camera) == "allow" ||
    normalize_perm_state(p.microphone) == "allow" ||
    normalize_perm_state(p.screen_capture) == "allow"
    None => false
  }
}

pub fn site_is_https(url : String) -> Bool {
  omni_ascii_lower(url.trim()).starts_with("https://")
}

pub fn site_is_local(url : String) -> Bool {
  let low = omni_ascii_lower(url.trim())
  if low == "" || low.starts_with("about:") || low.starts_with("file:") || low.starts_with("data:") {
    return true
  }
  let host = omnibox_display_host(url)
  omni_is_local_host(omni_ascii_lower(host))
}

///| Extracts a clean origin string (e.g. `https://meet.google.com`) from a full URL for display.
pub fn site_origin_from_url(raw_url : String) -> String {
  let s = raw_url.trim()
  if s == "" {
    return "about:blank"
  }
  let low = omni_ascii_lower(s)
  let scheme_len = if low.starts_with("https://") {
    8
  } else if low.starts_with("http://") {
    7
  } else {
    return s
  }
  let mut i = scheme_len
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      return s.slice(0, i)
    }
    i = i + 1
  }
  s
}

///| Normalizes a download state token into `"completed"`, `"in_progress"`, `"failed"`, or `"cancelled"`.
pub fn normalize_download_state(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "in_progress" || s == "downloading" || s == "active" {
    "in_progress"
  } else if s == "failed" || s == "error" {
    "failed"
  } else if s == "cancelled" || s == "canceled" {
    "cancelled"
  } else {
    "completed"
  }
}

///| Returns the compact pill label for a download state.
pub fn download_state_label(state : String) -> String {
  let s = normalize_download_state(state)
  if s == "in_progress" {
    "Downloading"
  } else if s == "failed" {
    "Failed"
  } else if s == "cancelled" {
    "Cancelled"
  } else {
    "Done"
  }
}

///| Extracts an uppercase 2..4 char file-type badge (e.g. `"PDF"`, `"DMG"`, `"ZIP"`, `"FILE"`).
pub fn download_ext_badge(filename : String) -> String {
  let s = filename.trim()
  let mut dot = -1
  let mut i = s.length() - 1
  while i > 0 {
    let c = s.code_unit_at(i).to_int()
    if c == 0x2E {
      dot = i
      break
    }
    if c == 0x2F || c == 0x5C {
      break
    }
    i = i - 1
  }
  if dot <= 0 || dot + 1 >= s.length() {
    return "FILE"
  }
  let raw_ext = s.slice(dot + 1, s.length())
  if raw_ext.length() == 0 || raw_ext.length() > 4 {
    return "FILE"
  }
  let b = raw_ext.to_bytes()
  let out = Bytes::new(b.length())
  let mut k = 0
  while k < b.length() {
    let c = b[k].to_int() & 0xFF
    if c >= 97 && c <= 122 {
      out[k] = (c - 32).to_byte()
    } else if (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
      out[k] = b[k]
    } else {
      return "FILE"
    }
    k = k + 1
  }
  out.to_string()
}

///| Formats a byte count into a human-readable size string (`0 B`, `512 B`, `248 KB`, `1.4 MB`, `14.2 MB`, `2.5 GB`).
pub fn format_download_bytes(bytes : Int64) -> String {
  if bytes <= 0L {
    return "0 B"
  }
  if bytes < 1024L {
    return bytes.to_string() + " B"
  }
  let kb_unit = 1024L
  let mb_unit = 1024L * 1024L
  let gb_unit = 1024L * 1024L * 1024L
  if bytes < mb_unit {
    let kb_tenths = (bytes * 10L + kb_unit / 2L) / kb_unit
    let whole = kb_tenths / 10L
    let frac = (kb_tenths % 10L).to_int()
    if whole >= 10L || frac == 0 {
      let rounded = (bytes + kb_unit / 2L) / kb_unit
      rounded.to_string() + " KB"
    } else {
      whole.to_string() + "." + frac.to_string() + " KB"
    }
  } else if bytes < gb_unit {
    let mb_tenths = (bytes * 10L + mb_unit / 2L) / mb_unit
    let whole = mb_tenths / 10L
    let frac = (mb_tenths % 10L).to_int()
    whole.to_string() + "." + frac.to_string() + " MB"
  } else {
    let gb_tenths = (bytes * 10L + gb_unit / 2L) / gb_unit
    let whole = gb_tenths / 10L
    let frac = (gb_tenths % 10L).to_int()
    whole.to_string() + "." + frac.to_string() + " GB"
  }
}

pub fn encode_downloads_state(items : Array[DownloadSummary]) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < items.length() {
    let d = items[i]
    let safe_bytes = if d.bytes < 0L { 0L } else { d.bytes }
    let path_part = if d.path.trim() != "" {
      ",\"path\":" + omni_json_escape(d.path.trim())
    } else {
      ""
    }
    parts.push(
      "{\"id\":" +
      omni_json_escape(d.id) +
      ",\"filename\":" +
      omni_json_escape(d.filename) +
      ",\"url\":" +
      omni_json_escape(d.url) +
      ",\"mime\":" +
      omni_json_escape(d.mime) +
      ",\"bytes\":" +
      safe_bytes.to_string() +
      ",\"state\":" +
      omni_json_escape(normalize_download_state(d.state)) +
      path_part +
      "}",
    )
    i = i + 1
  }
  "[" + parts.join(",") + "]"
}

fn dl_parse_item(p : OmniJsonParser, fallback_idx : Int) -> Option[DownloadSummary] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut filename = ""
  let mut url = ""
  let mut mime = ""
  let mut bytes : Int64 = 0L
  let mut state = "completed"
  let mut path = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    let eff_id = if id != "" { id } else { (fallback_idx + 1).to_string() }
    return Some(DownloadSummary::{ id: eff_id, filename, url, mime, bytes, state, path })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "filename" || key == "name" {
      match p.parse_str() {
        Some(v) => filename = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "mime" {
      match p.parse_str() {
        Some(v) => mime = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "bytes" || key == "size" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int64()
          bytes = if iv < 0L { 0L } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "state" {
      match p.parse_str() {
        Some(v) => state = normalize_download_state(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "path" {
      match p.parse_str() {
        Some(v) => path = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      let eff_id = if id != "" { id } else { (fallback_idx + 1).to_string() }
      return Some(DownloadSummary::{ id: eff_id, filename, url, mime, bytes, state, path })
    } else {
      return None
    }
  }
  None
}

pub struct DownloadsSnapshotEnvelope {
  pub items : Array[DownloadSummary]
  pub clear_seq : Int
  pub clear_ack_id : String
  pub export_req_id : String
  pub export_ok : Bool
  pub export_filename : String
  pub export_id : String
  pub has_envelope : Bool
}

pub fn encode_downloads_envelope(
  items : Array[DownloadSummary],
  clear_seq~ : Int = 0,
  clear_ack_id~ : String = "",
  export_req_id~ : String = "",
  export_ok~ : Bool = false,
  export_filename~ : String = "",
  export_id~ : String = "",
) -> String {
  let safe_seq = if clear_seq < 0 { 0 } else { clear_seq }
  "{\"items\":" +
  encode_downloads_state(items) +
  ",\"clear_seq\":" +
  safe_seq.to_string() +
  ",\"clear_ack_id\":" +
  omni_json_escape(clear_ack_id) +
  ",\"export_req_id\":" +
  omni_json_escape(export_req_id) +
  ",\"export_ok\":" +
  (if export_ok { "true" } else { "false" }) +
  ",\"export_filename\":" +
  omni_json_escape(export_filename) +
  ",\"export_id\":" +
  omni_json_escape(export_id) +
  "}"
}

fn dl_parse_items_array(p : OmniJsonParser, limit : Int) -> Option[Array[DownloadSummary]] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
    return None
  }
  p.i = p.i + 1
  let out : Array[DownloadSummary] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
    p.i = p.i + 1
    return Some(out)
  }
  let mut idx = 0
  while p.i < p.n {
    match dl_parse_item(p, idx) {
      Some(item) => {
        if item.filename != "" && out.length() < limit {
          out.push(item)
        }
        idx = idx + 1
      }
      None => return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
      p.i = p.i + 1
      return Some(out)
    } else {
      return None
    }
  }
  None
}

fn dl_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    return Some(true)
  }
  if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    return Some(false)
  }
  None
}

///| Parses either a legacy JSON array `[...]` or an upgraded DownloadsState JSON envelope
///| `{"items":[...],"clear_seq":N,"export_req_id":"...","export_ok":bool,"export_filename":"...","export_id":"..."}`.
///| Never panics on malformed or truncated JSON.
pub fn parse_downloads_envelope(
  json : String,
  max_items~ : Int = 64,
) -> DownloadsSnapshotEnvelope {
  let empty = DownloadsSnapshotEnvelope::{
    items: [],
    clear_seq: 0,
    clear_ack_id: "",
    export_req_id: "",
    export_ok: false,
    export_filename: "",
    export_id: "",
    has_envelope: false,
  }
  let limit = if max_items > 0 { max_items } else { 64 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n {
    return empty
  }
  let first = p.s.code_unit_at(p.i).to_int()
  if first == 0x5B {
    return match dl_parse_items_array(p, limit) {
      Some(items) => DownloadsSnapshotEnvelope::{ ..empty, items }
      None => empty
    }
  }
  if first != 0x7B {
    return empty
  }
  p.i = p.i + 1
  let mut items : Array[DownloadSummary] = []
  let mut clear_seq = 0
  let mut clear_ack_id = ""
  let mut export_req_id = ""
  let mut export_ok = false
  let mut export_filename = ""
  let mut export_id = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    return DownloadsSnapshotEnvelope::{
      items,
      clear_seq,
      clear_ack_id,
      export_req_id,
      export_ok,
      export_filename,
      export_id,
      has_envelope: true,
    }
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return empty
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return empty
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "items" {
      match dl_parse_items_array(p, limit) {
        Some(v) => items = v
        None => return empty
      }
    } else if key == "clear_seq" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          clear_seq = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return empty }
      }
    } else if key == "clear_ack_id" {
      match p.parse_str() {
        Some(v) => clear_ack_id = v
        None => if !p.skip_value() { return empty }
      }
    } else if key == "export_req_id" {
      match p.parse_str() {
        Some(v) => export_req_id = v
        None => if !p.skip_value() { return empty }
      }
    } else if key == "export_ok" {
      match dl_parse_bool(p) {
        Some(v) => export_ok = v
        None => if !p.skip_value() { return empty }
      }
    } else if key == "export_filename" {
      match p.parse_str() {
        Some(v) => export_filename = v
        None => if !p.skip_value() { return empty }
      }
    } else if key == "export_id" {
      match p.parse_str() {
        Some(v) => export_id = v
        None => if !p.skip_value() { return empty }
      }
    } else if !p.skip_value() {
      return empty
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      return DownloadsSnapshotEnvelope::{
        items,
        clear_seq,
        clear_ack_id,
        export_req_id,
        export_ok,
        export_filename,
        export_id,
        has_envelope: true,
      }
    } else {
      return empty
    }
  }
  empty
}

///| Parses a JSON array or envelope of `DownloadSummary` items from `wire::Message::DownloadsState`
///| or `page::downloads_json()` (`name`/`size` aliases supported).
///| Returns an empty array on malformed or truncated JSON (never panics).
pub fn parse_downloads_state(
  json : String,
  max_items~ : Int = 64,
) -> Array[DownloadSummary] {
  parse_downloads_envelope(json, max_items=max_items).items
}
