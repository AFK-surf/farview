///| Pure-Pion portable Browsing History drawer UI model (`HistoryItemSummary`,
///| `HistorySnapshot`), compact JSON codec with malformed/truncated resilience,
///| relative timestamp formatting (`format_history_age`), and Arc 6-color Space
///| theme palette helpers shared by `pion-app` and `pion-host`.

pub let HISTORY_MAX_ITEMS : Int = 8
pub let HISTORY_DRAWER_MAX_ITEMS : Int = 16
pub let HISTORY_HOST_MAX_ITEMS : Int = 24

pub let HISTORY_BUCKET_TODAY : Int = 0
pub let HISTORY_BUCKET_YESTERDAY : Int = 1
pub let HISTORY_BUCKET_EARLIER : Int = 2

pub struct HistoryItemSummary {
  pub url : String
  pub title : String
  pub host : String
  pub visit_count : Int
  pub last_visit_secs : Int64
}

pub struct HistorySnapshot {
  pub query : String
  pub total_count : Int
  pub items : Array[HistoryItemSummary]
}

pub fn HistorySnapshot::empty() -> HistorySnapshot {
  HistorySnapshot::{ query: "", total_count: 0, items: [] }
}

///| Standard 6-color Arc Space theme palette.
pub fn workspace_space_palette() -> Array[String] {
  ["#2563EB", "#10B981", "#8B5CF6", "#F59E0B", "#EC4899", "#06B6D4"]
}

///| Validates and normalizes a `#RRGGBB` hex accent color string (uppercased).
///| Falls back to Arc blue (`#2563EB`) on invalid input.
pub fn normalize_space_accent(raw : String) -> String {
  let s = raw.trim()
  let start = if s.starts_with("#") { 1 } else { 0 }
  if s.length() - start != 6 {
    return "#2563EB"
  }
  let out = Bytes::new(7)
  out[0] = 0x23.to_byte() // '#'
  let mut i = 0
  while i < 6 {
    let c = s.code_unit_at(start + i).to_int()
    if c >= 0x30 && c <= 0x39 {
      out[1 + i] = c.to_byte()
    } else if c >= 0x41 && c <= 0x46 {
      out[1 + i] = c.to_byte()
    } else if c >= 0x61 && c <= 0x66 {
      out[1 + i] = (c - 32).to_byte()
    } else {
      return "#2563EB"
    }
    i = i + 1
  }
  out.to_string()
}

///| Formats a Unix timestamp in seconds relative to `now_secs`:
///| `"Just now"`, `"12m ago"`, `"3h ago"`, `"Yesterday"`, or `"Nov 20"` (UTC).
pub fn format_history_age(last_visit_secs : Int64, now_secs : Int64) -> String {
  if last_visit_secs <= 0L {
    return ""
  }
  let diff = now_secs - last_visit_secs
  if diff < 60L {
    return "Just now"
  }
  if diff < 3600L {
    return (diff / 60L).to_string() + "m ago"
  }
  if diff < 86400L {
    return (diff / 3600L).to_string() + "h ago"
  }
  if diff < 172800L {
    return "Yesterday"
  }
  // Howard Hinnant civil-from-days algorithm (UTC Gregorian calendar)
  let z = last_visit_secs / 86400L + 719468L
  let era = (if z >= 0L { z } else { z - 146096L }) / 146097L
  let doe = z - era * 146097L
  let yoe = (doe - doe / 1460L + doe / 36524L - doe / 146096L) / 365L
  let doy = doe - (365L * yoe + yoe / 4L - yoe / 100L)
  let mp = (5L * doy + 2L) / 153L
  let day = (doy - (153L * mp + 2L) / 5L + 1L).to_int()
  let month = (mp + (if mp < 10L { 3L } else { -9L })).to_int()
  let months : Array[String] = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
  ]
  let m_str = if month >= 1 && month <= 12 { months[month - 1] } else { "Jan" }
  m_str + " " + day.to_string()
}

///| Classifies a Unix timestamp into `HISTORY_BUCKET_TODAY`, `HISTORY_BUCKET_YESTERDAY`,
///| or `HISTORY_BUCKET_EARLIER` using UTC calendar-day boundaries.
pub fn history_time_bucket(last_visit_secs : Int64, now_secs : Int64) -> Int {
  if last_visit_secs <= 0L || now_secs <= 0L {
    return HISTORY_BUCKET_EARLIER
  }
  let now_day = now_secs / 86400L
  let visit_day = last_visit_secs / 86400L
  let day_diff = now_day - visit_day
  if day_diff <= 0L {
    HISTORY_BUCKET_TODAY
  } else if day_diff == 1L {
    HISTORY_BUCKET_YESTERDAY
  } else {
    HISTORY_BUCKET_EARLIER
  }
}

///| Returns the human-readable section header label for a history time bucket.
pub fn history_bucket_label(bucket : Int) -> String {
  if bucket == HISTORY_BUCKET_TODAY {
    "Today"
  } else if bucket == HISTORY_BUCKET_YESTERDAY {
    "Yesterday"
  } else {
    "Earlier"
  }
}

///| Returns the section header title (`"Today"` / `"Yesterday"` / `"Earlier"`) if row `idx`
///| begins a new time group in `items`, or `""` otherwise. Guarantees zero empty groups.
pub fn history_section_header_at(
  items : Array[HistoryItemSummary],
  idx : Int,
  now_secs : Int64,
) -> String {
  if idx < 0 || idx >= items.length() {
    return ""
  }
  let cur_b = history_time_bucket(items[idx].last_visit_secs, now_secs)
  if idx == 0 {
    return history_bucket_label(cur_b)
  }
  let prev_b = history_time_bucket(items[idx - 1].last_visit_secs, now_secs)
  if cur_b != prev_b {
    history_bucket_label(cur_b)
  } else {
    ""
  }
}

///| Case-insensitive substring filter over history items by `title`, `url`, or `host`.
///| Uses UTF-8 safe `omni_ascii_lower` so CJK / accented / punctuation titles match intact.
pub fn history_filter_items(
  items : Array[HistoryItemSummary],
  query : String,
) -> Array[HistoryItemSummary] {
  let q = omni_ascii_lower(query.trim())
  if q == "" {
    return items
  }
  let out : Array[HistoryItemSummary] = []
  let mut i = 0
  while i < items.length() {
    let it = items[i]
    if omni_ascii_lower(it.title).contains(q) ||
    omni_ascii_lower(it.url).contains(q) ||
    omni_ascii_lower(it.host).contains(q) {
      out.push(it)
    }
    i = i + 1
  }
  out
}

///| Normalizes a history clear time-range key into `"hour"`, `"24h"`, `"7d"`, or `"all"`.
pub fn history_clear_range_normalize(raw : String) -> String {
  let r = omni_ascii_lower(raw.trim())
  if r == "hour" || r == "1h" || r == "last_hour" {
    "hour"
  } else if r == "24h" || r == "day" || r == "1d" || r == "last_24h" {
    "24h"
  } else if r == "7d" || r == "week" || r == "last_7d" {
    "7d"
  } else {
    "all"
  }
}

///| Returns the UI button & toast label for a normalized history clear range.
pub fn history_clear_range_label(range_key : String) -> String {
  let norm = history_clear_range_normalize(range_key)
  if norm == "hour" {
    "Last Hour"
  } else if norm == "24h" {
    "Last 24h"
  } else if norm == "7d" {
    "Last 7d"
  } else {
    "All"
  }
}

///| Computes the cutoff Unix timestamp (seconds) for clearing history within `range_key`.
///| Entries with `last_visit_secs >= cutoff` are removed; `"all"` returns `0L`.
pub fn history_clear_cutoff_secs(range_key : String, now_secs : Int64) -> Int64 {
  let norm = history_clear_range_normalize(range_key)
  if norm == "hour" {
    let c = now_secs - 3600L
    if c > 0L { c } else { 0L }
  } else if norm == "24h" {
    let c = now_secs - 86400L
    if c > 0L { c } else { 0L }
  } else if norm == "7d" {
    let c = now_secs - 604800L
    if c > 0L { c } else { 0L }
  } else {
    0L
  }
}

///| Returns `true` if a history entry visited at `last_visit_secs` should be KEPT
///| after clearing the given time range (`"hour"`, `"24h"`, `"7d"`, `"all"`).
pub fn history_should_keep_after_clear(
  last_visit_secs : Int64,
  range_key : String,
  now_secs : Int64,
) -> Bool {
  let norm = history_clear_range_normalize(range_key)
  if norm == "all" {
    return false
  }
  let cutoff = history_clear_cutoff_secs(norm, now_secs)
  last_visit_secs < cutoff
}

///| Extracts a clean lowercase hostname (e.g. `github.com`) from a URL for History rows.
pub fn history_url_host(raw_url : String) -> String {
  let s = omnibox_display_host(raw_url)
  let mut end_i = s.length()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      end_i = i
      break
    }
    i = i + 1
  }
  s.slice(0, end_i)
}

pub fn encode_history_snapshot(snap : HistorySnapshot) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < snap.items.length() {
    let it = snap.items[i]
    let vc = if it.visit_count < 0 { 0 } else { it.visit_count }
    let ts = if it.last_visit_secs < 0L { 0L } else { it.last_visit_secs }
    let host = if it.host != "" { it.host } else { history_url_host(it.url) }
    parts.push(
      "{\"url\":" +
      omni_json_escape(it.url) +
      ",\"title\":" +
      omni_json_escape(it.title) +
      ",\"host\":" +
      omni_json_escape(host) +
      ",\"visitCount\":" +
      vc.to_string() +
      ",\"lastVisitSecs\":" +
      ts.to_string() +
      "}",
    )
    i = i + 1
  }
  let safe_total = if snap.total_count < 0 { 0 } else { snap.total_count }
  "{\"query\":" +
  omni_json_escape(snap.query) +
  ",\"totalCount\":" +
  safe_total.to_string() +
  ",\"items\":[" +
  parts.join(",") +
  "]}"
}

fn hist_parse_item(p : OmniJsonParser) -> Option[HistoryItemSummary] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut url = ""
  let mut title = ""
  let mut host = ""
  let mut visit_count = 1
  let mut last_visit_secs : Int64 = 0L
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(HistoryItemSummary::{ url, title, host, visit_count, last_visit_secs })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "host" {
      match p.parse_str() {
        Some(v) => host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "visitCount" || key == "visit_count" || key == "visits" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          visit_count = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "lastVisitSecs" || key == "last_visit_secs" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int64()
          last_visit_secs = if iv < 0L { 0L } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      let eff_host = if host != "" { host } else { history_url_host(url) }
      return Some(HistoryItemSummary::{ url, title, host: eff_host, visit_count, last_visit_secs })
    } else {
      return None
    }
  }
  None
}

///| Parses a `HistorySnapshot` JSON payload from `wire::Message::HistoryState`.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_history_snapshot(
  json : String,
  max_items~ : Int = 64,
) -> Option[HistorySnapshot] {
  let limit = if max_items > 0 { max_items } else { 64 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut query = ""
  let mut total_count = 0
  let items : Array[HistoryItemSummary] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(HistorySnapshot::{ query, total_count, items })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "query" {
      match p.parse_str() {
        Some(v) => query = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "totalCount" || key == "total_count" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          total_count = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "items" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match hist_parse_item(p) {
            Some(it) => if it.url != "" && items.length() < limit { items.push(it) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(HistorySnapshot::{ query, total_count, items })
    } else {
      return None
    }
  }
  None
}
