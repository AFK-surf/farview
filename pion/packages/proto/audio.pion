///| Pure Pion 48 kHz stereo IMA-ADPCM 4:1 codec.
///| 1:1 port of `client/src/proto/audio.mbt`.

let IMA_INDEX_TABLE : Array[Int] = [
  -1, -1, -1, -1, 2, 4, 6, 8, -1, -1, -1, -1, 2, 4, 6, 8,
]

let IMA_STEP_TABLE : Array[Int] = [
  7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31, 34, 37, 41, 45,
  50, 55, 60, 66, 73, 80, 88, 97, 107, 118, 130, 143, 157, 173, 190, 209, 230,
  253, 279, 307, 337, 371, 408, 449, 494, 544, 598, 658, 724, 796, 876, 963,
  1060, 1166, 1282, 1411, 1552, 1707, 1878, 2066, 2272, 2499, 2749, 3024, 3327,
  3660, 4026, 4428, 4871, 5358, 5894, 6484, 7132, 7845, 8630, 9493, 10442,
  11487, 12635, 13899, 15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794,
  32767,
]

fn clamp_i16(v : Int) -> Int {
  if v < -32768 {
    -32768
  } else if v > 32767 {
    32767
  } else {
    v
  }
}

fn clamp_idx(v : Int) -> Int {
  if v < 0 {
    0
  } else if v > 88 {
    88
  } else {
    v
  }
}

pub fn read_s16le(b : Bytes, off : Int) -> Int {
  let lo = b[off].to_int() & 0xFF
  let hi = b[off + 1].to_int() & 0xFF
  let u = lo | (hi << 8)
  if u >= 32768 {
    u - 65536
  } else {
    u
  }
}

fn write_s16le(out : Bytes, off : Int, v : Int) -> Unit {
  out[off] = (v & 0xFF).to_byte()
  out[off + 1] = ((v >> 8) & 0xFF).to_byte()
}

fn int_abs(v : Int) -> Int {
  if v < 0 { 0 - v } else { v }
}

fn initial_step_index(s0 : Int, s1 : Int) -> Int {
  let diff = int_abs(s1 - s0)
  let mut best = 0
  let mut i = 0
  while i < 89 {
    if IMA_STEP_TABLE[i] <= diff {
      best = i
    } else {
      break
    }
    i = i + 1
  }
  best
}

fn ima_encode_sample(sample : Int, pred : Int, idx : Int) -> (Int, Int, Int) {
  let step = IMA_STEP_TABLE[idx]
  let mut diff = sample - pred
  let mut nibble = 0
  if diff < 0 {
    nibble = 8
    diff = 0 - diff
  }
  let mut delta = step >> 3
  if diff >= step {
    nibble = nibble | 4
    diff = diff - step
    delta = delta + step
  }
  let half = step >> 1
  if diff >= half {
    nibble = nibble | 2
    diff = diff - half
    delta = delta + half
  }
  let quarter = step >> 2
  if diff >= quarter {
    nibble = nibble | 1
    delta = delta + quarter
  }
  let next_pred = clamp_i16(
    if (nibble & 8) != 0 { pred - delta } else { pred + delta },
  )
  let next_idx = clamp_idx(idx + IMA_INDEX_TABLE[nibble])
  (nibble, next_pred, next_idx)
}

fn ima_decode_sample(nibble : Int, pred : Int, idx : Int) -> (Int, Int) {
  let step = IMA_STEP_TABLE[idx]
  let mut delta = step >> 3
  if (nibble & 4) != 0 {
    delta = delta + step
  }
  if (nibble & 2) != 0 {
    delta = delta + (step >> 1)
  }
  if (nibble & 1) != 0 {
    delta = delta + (step >> 2)
  }
  let next_pred = clamp_i16(
    if (nibble & 8) != 0 { pred - delta } else { pred + delta },
  )
  let next_idx = clamp_idx(idx + IMA_INDEX_TABLE[nibble & 0x0F])
  (next_pred, next_idx)
}

pub fn encode_ima_adpcm_stereo(pcm : Bytes) -> Bytes {
  let nbytes = pcm.length()
  if nbytes < 4 || (nbytes & 3) != 0 {
    return Bytes::new(0)
  }
  let frames = nbytes / 4
  let out_len = 8 + (frames - 1)
  let out = Bytes::new(out_len)
  let mut l_pred = read_s16le(pcm, 0)
  let mut r_pred = read_s16le(pcm, 2)
  let mut l_idx = if frames > 1 {
    initial_step_index(l_pred, read_s16le(pcm, 4))
  } else {
    0
  }
  let mut r_idx = if frames > 1 {
    initial_step_index(r_pred, read_s16le(pcm, 6))
  } else {
    0
  }
  write_s16le(out, 0, l_pred)
  out[2] = l_idx.to_byte()
  out[3] = (0).to_byte()
  write_s16le(out, 4, r_pred)
  out[6] = r_idx.to_byte()
  out[7] = (0).to_byte()
  let mut f = 1
  while f < frames {
    let off = f * 4
    let (ln, lp, li) = ima_encode_sample(read_s16le(pcm, off), l_pred, l_idx)
    let (rn, rp, ri) = ima_encode_sample(
      read_s16le(pcm, off + 2),
      r_pred,
      r_idx,
    )
    l_pred = lp
    l_idx = li
    r_pred = rp
    r_idx = ri
    out[8 + f - 1] = ((ln & 0x0F) | ((rn & 0x0F) << 4)).to_byte()
    f = f + 1
  }
  out
}

pub fn decode_ima_adpcm_stereo(adpcm : Bytes) -> Bytes {
  let nbytes = adpcm.length()
  if nbytes < 8 || nbytes > 65536 {
    return Bytes::new(0)
  }
  let mut l_idx = adpcm[2].to_int() & 0xFF
  let mut r_idx = adpcm[6].to_int() & 0xFF
  if l_idx > 88 || r_idx > 88 {
    return Bytes::new(0)
  }
  let mut l_pred = read_s16le(adpcm, 0)
  let mut r_pred = read_s16le(adpcm, 4)
  let frames = 1 + (nbytes - 8)
  let out = Bytes::new(frames * 4)
  write_s16le(out, 0, l_pred)
  write_s16le(out, 2, r_pred)
  let mut f = 1
  while f < frames {
    let b = adpcm[8 + f - 1].to_int() & 0xFF
    let (lp, li) = ima_decode_sample(b & 0x0F, l_pred, l_idx)
    let (rp, ri) = ima_decode_sample((b >> 4) & 0x0F, r_pred, r_idx)
    l_pred = lp
    l_idx = li
    r_pred = rp
    r_idx = ri
    let off = f * 4
    write_s16le(out, off, l_pred)
    write_s16le(out, off + 2, r_pred)
    f = f + 1
  }
  out
}
