///| Pure-Pion portable Find-in-Page (`Cmd+F`) query normalization, match counter formatting,
///| case-sensitivity flag encoding, and cyclic step helpers shared by `pion-app`, `pion-host`,
///| and unit tests.

pub struct FindMatchState {
  pub query : String
  pub active : Int
  pub total : Int
  pub case_sensitive : Bool
}

pub fn FindMatchState::empty() -> FindMatchState {
  FindMatchState::{ query: "", active: -1, total: 0, case_sensitive: false }
}

///| Normalizes `(active, total)` into a valid 0-based match index and non-negative total.
///| Returns `(-1, 0)` when there are no matches.
pub fn normalize_find_match(active : Int, total : Int) -> (Int, Int) {
  if total <= 0 {
    return (-1, 0)
  }
  let clamped = if active < 0 {
    0
  } else if active >= total {
    total - 1
  } else {
    active
  }
  (clamped, total)
}

///| Formats the floating `Cmd+F` match counter badge:
///| - Empty / whitespace-only query -> `""` (no superfluous `0 / 0`)
///| - Non-empty query with 0 matches -> `"0 / 0"`
///| - Matches found -> `"3 / 14"` (1-based clamped index)
pub fn format_find_counter(query : String, active : Int, total : Int) -> String {
  if query.trim() == "" {
    return ""
  }
  let (idx, tot) = normalize_find_match(active, total)
  if tot <= 0 {
    "0 / 0"
  } else {
    (idx + 1).to_string() + " / " + tot.to_string()
  }
}

///| Returns true when the user typed a non-empty query that yielded zero matches.
pub fn find_is_empty_result(query : String, total : Int) -> Bool {
  query.trim() != "" && total <= 0
}

///| Encodes Find-in-Page boolean flags for `wire::Message::Act("find", query, flags)`.
pub fn find_flags_for(case_sensitive : Bool, whole_word : Bool) -> String {
  if case_sensitive && whole_word {
    "case,word"
  } else if case_sensitive {
    "case"
  } else if whole_word {
    "word"
  } else {
    ""
  }
}

///| Steps a 0-based active match index forward (`delta = 1`) or backward (`delta = -1`)
///| with cyclic wrap-around. Returns `-1` when `total <= 0`.
pub fn find_step_index(active : Int, total : Int, delta : Int) -> Int {
  if total <= 0 {
    return -1
  }
  let (cur, tot) = normalize_find_match(active, total)
  let next = (cur + delta) % tot
  if next < 0 { next + tot } else { next }
}
