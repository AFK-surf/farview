///| Chromium-grade Page Zoom ladder (50%..300%), Find-in-Page badge formatting,
///| and pure desktop browser shortcut dispatcher shared by `pion-app` and `pion-host`.

pub let ZOOM_MIN : Double = 0.5
pub let ZOOM_MAX : Double = 3.0
pub let ZOOM_DEFAULT : Double = 1.0

pub let SHORTCUT_MOD_SHIFT : Int = 1
pub let SHORTCUT_MOD_CTRL : Int = 2
pub let SHORTCUT_MOD_ALT : Int = 4
pub let SHORTCUT_MOD_CMD : Int = 8

pub let KEY_LEFT : Int = 3
pub let KEY_RIGHT : Int = 4
pub let KEY_UP : Int = 5
pub let KEY_DOWN : Int = 6
pub let KEY_ENTER : Int = 7
pub let KEY_ESCAPE : Int = 17
pub let KEY_TAB : Int = 18
pub let KEY_F5_MAC : Int = 64264 // 1000 + 0xF708 (NSF5FunctionKey)
pub let KEY_F5_WIN : Int = 116 // VK_F5 / DOM F5
pub let KEY_F5_X11 : Int = 65470 // XK_F5
pub let KEY_F12_MAC : Int = 64271 // 1000 + 0xF70F (NSF12FunctionKey)
pub let KEY_F12_WIN : Int = 123 // VK_F12 / DOM F12
pub let KEY_F12_X11 : Int = 65481 // XK_F12

pub enum BrowserShortcut {
  None
  FocusUrl
  Reload
  Back
  Forward
  FindOpen
  FindNext
  FindPrev
  FindClose
  ZoomIn
  ZoomOut
  ZoomReset
  ToggleSidebar
  TabNew
  TabClose
  TabSwitch(Int)
  ToggleSiteInfo
  ToggleDownloads
  OpenCommandBar
  TogglePinTab
  ReopenClosedTab
  ToggleMuteAudio
  ToggleHistory
  CopyCurrentUrl
  ToggleShortcuts
  ToggleSplitView
  TogglePeek
  ExpandPeek
  TabSwitchMru(Int)
  PrintPdf
  ToggleTabFilter
  ToggleDevTools
  ToggleBookmark
  ToggleBookmarks
  CaptureScreenshot
  ToggleReaderMode
  ToggleBoosts
  OpenSettings
  ToggleDarkChrome
  TogglePerfHud
}

pub fn zoom_steps() -> Array[Double] {
  [0.5, 0.67, 0.75, 0.8, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0, 2.5, 3.0]
}

pub fn clamp_zoom(z : Double) -> Double {
  if z != z {
    return ZOOM_DEFAULT
  }
  if z < ZOOM_MIN {
    ZOOM_MIN
  } else if z > ZOOM_MAX {
    ZOOM_MAX
  } else {
    z
  }
}

pub fn zoom_step_up(current : Double) -> Double {
  let z = clamp_zoom(current)
  let steps = zoom_steps()
  let mut i = 0
  while i < steps.length() {
    if steps[i] > z + 1.0e-6 {
      return steps[i]
    }
    i = i + 1
  }
  ZOOM_MAX
}

pub fn zoom_step_down(current : Double) -> Double {
  let z = clamp_zoom(current)
  let steps = zoom_steps()
  let mut best = ZOOM_MIN
  let mut i = 0
  while i < steps.length() {
    if steps[i] < z - 1.0e-6 {
      best = steps[i]
    }
    i = i + 1
  }
  best
}

pub fn zoom_reset() -> Double {
  ZOOM_DEFAULT
}

pub fn zoom_percent(z : Double) -> Int {
  let c = clamp_zoom(z)
  math_floor(c * 100.0 + 0.5).to_int()
}

pub fn format_zoom_str(z : Double) -> String {
  let pct = zoom_percent(z)
  let whole = pct / 100
  let frac = pct % 100
  if frac == 0 {
    whole.to_string() + ".0"
  } else if frac % 10 == 0 {
    whole.to_string() + "." + (frac / 10).to_string()
  } else if frac < 10 {
    whole.to_string() + ".0" + frac.to_string()
  } else {
    whole.to_string() + "." + frac.to_string()
  }
}

pub fn parse_zoom_str(raw : String) -> Option[Double] {
  let s0 = raw.trim()
  if s0 == "" {
    return None
  }
  let is_pct = s0.ends_with("%")
  let s = if is_pct { s0.slice(0, s0.length() - 1).trim() } else { s0 }
  if s == "" {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0).to_int() == 0x2D {
    neg = true
    i = 1
  } else if s.code_unit_at(0).to_int() == 0x2B {
    i = 1
  }
  let mut whole = 0.0
  let mut frac = 0.0
  let mut div = 1.0
  let mut seen_dot = false
  let mut digits = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 0x30 && c <= 0x39 {
      let d = int_to_double(c - 0x30)
      digits = digits + 1
      if seen_dot {
        div = div * 10.0
        frac = frac + d / div
      } else {
        whole = whole * 10.0 + d
      }
    } else if c == 0x2E && !seen_dot {
      seen_dot = true
    } else {
      return None
    }
    i = i + 1
  }
  if digits == 0 || neg {
    return None
  }
  let v = whole + frac
  if v <= 0.0 {
    return None
  }
  let factor = if is_pct { v / 100.0 } else { v }
  Some(clamp_zoom(factor))
}

pub fn format_base_wh(w : Double, h : Double) -> String {
  let wi = math_floor(w + 0.5).to_int()
  let hi = math_floor(h + 0.5).to_int()
  wi.to_string() + "x" + hi.to_string()
}

pub fn parse_base_wh(s : String) -> Option[(Double, Double)] {
  let trimmed = s.trim()
  if trimmed == "" {
    return None
  }
  let mut split_at = -1
  let mut i = 0
  while i < trimmed.length() {
    let c = trimmed.code_unit_at(i).to_int()
    if c == 0x78 || c == 0x58 {
      split_at = i
      break
    }
    i = i + 1
  }
  if split_at <= 0 || split_at + 1 >= trimmed.length() {
    return None
  }
  match (parse_zoom_num(trimmed.slice(0, split_at)), parse_zoom_num(trimmed.slice(split_at + 1, trimmed.length()))) {
    (Some(bw), Some(bh)) if bw >= 50.0 && bh >= 50.0 => Some((bw, bh))
    _ => None
  }
}

fn parse_zoom_num(raw : String) -> Option[Double] {
  let s = raw.trim()
  if s == "" {
    return None
  }
  let mut i = 0
  let mut whole = 0.0
  let mut frac = 0.0
  let mut div = 1.0
  let mut seen_dot = false
  let mut digits = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 0x30 && c <= 0x39 {
      let d = int_to_double(c - 0x30)
      digits = digits + 1
      if seen_dot {
        div = div * 10.0
        frac = frac + d / div
      } else {
        whole = whole * 10.0 + d
      }
    } else if c == 0x2E && !seen_dot {
      seen_dot = true
    } else {
      return None
    }
    i = i + 1
  }
  if digits == 0 {
    return None
  }
  Some(whole + frac)
}

///| Pure Host viewport + zoom state machine preventing split-packet double-division
///| between `proto::ClientMsg::Viewport` and `wire::Message::Act("zoom", ...)` / `Zoom`.
pub struct ZoomViewportState {
  pub mut w : Double
  pub mut h : Double
  pub mut base_w : Double
  pub mut base_h : Double
  pub mut has_explicit_base : Bool
  pub mut zoom : Double
}

pub fn ZoomViewportState::new(w : Double, h : Double) -> ZoomViewportState {
  ZoomViewportState::{ w, h, base_w: w, base_h: h, has_explicit_base: false, zoom: ZOOM_DEFAULT }
}

///| Handle `proto::ClientMsg::Viewport(cw, ch, _)` from a `DocClient`.
///| `Stage::viewport_now()` already divides by zoom, so `(cw, ch)` is the authoritative
///| logical CSS viewport; never corrupt `base_w/base_h` by multiplying with a stale `zoom`.
pub fn ZoomViewportState::on_doc_viewport(self : ZoomViewportState, cw : Double, ch : Double) -> (Double, Double) {
  if cw >= 50.0 && ch >= 50.0 {
    self.w = cw
    self.h = ch
  }
  (self.w, self.h)
}

///| Handle legacy `wire::Message::Hello(cw, ch, _)` carrying unscaled physical viewport.
pub fn ZoomViewportState::on_wire_hello(self : ZoomViewportState, cw : Double, ch : Double) -> (Double, Double) {
  if cw >= 50.0 && ch >= 50.0 {
    self.base_w = cw
    self.base_h = ch
    self.has_explicit_base = true
    self.w = cw / self.zoom
    self.h = ch / self.zoom
  }
  (self.w, self.h)
}

///| Handle `Act("zoom", z, base_wh)` or `wire::Message::Zoom(z)`.
///| Returns `(resize_target_opt, should_broadcast_zoom)`:
///| - With explicit `base_wh`, updates `base_w/base_h` and resizes to `base / z`.
///| - Without `base_wh` when a `DocClient` is active, updates `zoom` and broadcasts `Zoom(z)`
///|   so the client's `Stage::viewport_now()` sends back the authoritative `Viewport(base / z)`,
///|   preventing split-packet double-division if `Viewport` already arrived first.
///| - Without `base_wh` and no `DocClient`, resizes to `base_w / z, base_h / z`.
///| - `should_broadcast_zoom` is true only when `zoom` actually changed (zero echo oscillation).
pub fn ZoomViewportState::on_zoom_cmd(
  self : ZoomViewportState,
  z0 : Double,
  base_wh : String,
  has_doc_client : Bool,
) -> (Option[(Double, Double)], Bool) {
  let z = clamp_zoom(z0)
  let changed = math_abs(z - self.zoom) > 1.0e-6
  let mut got_explicit = false
  match parse_base_wh(base_wh) {
    Some((bw, bh)) => {
      self.base_w = bw
      self.base_h = bh
      self.has_explicit_base = true
      got_explicit = true
    }
    None => ()
  }
  self.zoom = z
  if got_explicit || !has_doc_client {
    let lw = self.base_w / z
    let lh = self.base_h / z
    self.w = lw
    self.h = lh
    (Some((lw, lh)), changed)
  } else if self.has_explicit_base {
    let lw = self.base_w / z
    let lh = self.base_h / z
    self.w = lw
    self.h = lh
    (Some((lw, lh)), changed)
  } else {
    (None, changed)
  }
}

pub fn format_find_badge(active : Int, total : Int) -> String {
  if total <= 0 {
    "0/0"
  } else {
    let clamped = if active < 0 {
      0
    } else if active >= total {
      total - 1
    } else {
      active
    }
    (clamped + 1).to_string() + "/" + total.to_string()
  }
}

pub fn is_f5_key(code : Int) -> Bool {
  code == KEY_F5_MAC || code == KEY_F5_WIN || code == KEY_F5_X11
}

pub fn is_f12_key(code : Int) -> Bool {
  code == KEY_F12_MAC || code == KEY_F12_WIN || code == KEY_F12_X11
}

///| Pure desktop browser shortcut classifier.
///| Leaves clipboard/editing keys (`Cmd/Ctrl+C/V/X/A`) untouched (`BrowserShortcut::None`).
pub fn dispatch_browser_shortcut(
  code : Int,
  mods : Int,
  is_macos : Bool,
  find_open : Bool,
  find_focused : Bool,
  field_focused : Bool,
) -> BrowserShortcut {
  let primary = if is_macos {
    (mods & SHORTCUT_MOD_CMD) != 0
  } else {
    (mods & SHORTCUT_MOD_CTRL) != 0
  }
  let alt = (mods & SHORTCUT_MOD_ALT) != 0
  let shift = (mods & SHORTCUT_MOD_SHIFT) != 0
  let other_primary = if is_macos {
    (mods & SHORTCUT_MOD_CTRL) != 0
  } else {
    (mods & SHORTCUT_MOD_CMD) != 0
  }
  if code == KEY_TAB && (mods & SHORTCUT_MOD_CTRL) != 0 && !alt && (mods & SHORTCUT_MOD_CMD) == 0 {
    if shift {
      return BrowserShortcut::TabSwitchMru(-1) // Ctrl+Shift+Tab
    }
    return BrowserShortcut::TabSwitchMru(1) // Ctrl+Tab
  }
  if code == KEY_ESCAPE && mods == 0 {
    if find_open {
      return BrowserShortcut::FindClose
    }
    return BrowserShortcut::None
  }
  if find_open && find_focused && code == KEY_ENTER && !primary && !alt && !other_primary {
    if shift {
      return BrowserShortcut::FindPrev
    }
    return BrowserShortcut::FindNext
  }
  if is_f5_key(code) && !alt && !other_primary {
    return BrowserShortcut::Reload
  }
  if is_f12_key(code) && !primary && !alt && !other_primary && !shift {
    return BrowserShortcut::ToggleDevTools
  }
  if is_macos && primary && alt && !other_primary && !shift && (code == 1105 || code == 1073) {
    return BrowserShortcut::ToggleDevTools // Cmd+Opt+I
  }
  if primary && alt && !other_primary && !shift && (code == 1114 || code == 1082) {
    return BrowserShortcut::ToggleReaderMode // Cmd+Opt+R (macOS) / Ctrl+Alt+R (Linux/Win)
  }
  if alt && !primary && !other_primary && !shift && !field_focused {
    if code == KEY_LEFT {
      return BrowserShortcut::Back
    }
    if code == KEY_RIGHT {
      return BrowserShortcut::Forward
    }
  }
  if primary && !alt && !other_primary {
    if !shift {
      if code == 1108 {
        return BrowserShortcut::FocusUrl // Cmd/Ctrl+L
      }
      if code == 1114 {
        return BrowserShortcut::Reload // Cmd/Ctrl+R
      }
      if code == 1091 {
        return BrowserShortcut::Back // Cmd/Ctrl+[
      }
      if code == 1093 {
        return BrowserShortcut::Forward // Cmd/Ctrl+]
      }
      if code == 1102 {
        return BrowserShortcut::FindOpen // Cmd/Ctrl+F
      }
      if code == 1045 {
        return BrowserShortcut::ZoomOut // Cmd/Ctrl+-
      }
      if code == 1048 {
        return BrowserShortcut::ZoomReset // Cmd/Ctrl+0
      }
      if code == 1115 {
        return BrowserShortcut::ToggleSidebar // Cmd/Ctrl+S
      }
      if code == 1116 {
        return BrowserShortcut::TabNew // Cmd/Ctrl+T
      }
      if code == 1119 {
        return BrowserShortcut::TabClose // Cmd/Ctrl+W
      }
      if code == 1105 {
        return BrowserShortcut::ToggleSiteInfo // Cmd/Ctrl+I
      }
      if code == 1106 {
        return BrowserShortcut::ToggleDownloads // Cmd/Ctrl+J
      }
      if code == 1107 {
        return BrowserShortcut::OpenCommandBar // Cmd/Ctrl+K
      }
      if code == 1100 {
        return BrowserShortcut::ToggleBookmark // Cmd/Ctrl+D
      }
      if code == 1109 {
        return BrowserShortcut::ToggleMuteAudio // Cmd/Ctrl+M
      }
      if code == 1121 {
        return BrowserShortcut::ToggleHistory // Cmd/Ctrl+Y
      }
      if code == 1111 {
        return BrowserShortcut::ExpandPeek // Cmd/Ctrl+O (expand Arc Peek to full tab)
      }
      if code == 1112 {
        return BrowserShortcut::PrintPdf // Cmd/Ctrl+P
      }
      if code == 1047 {
        return BrowserShortcut::ToggleShortcuts // Cmd/Ctrl+/
      }
      if code == 1044 {
        return BrowserShortcut::OpenSettings // Cmd/Ctrl+,
      }
      if code >= 1049 && code <= 1057 {
        return BrowserShortcut::TabSwitch(code - 1049) // Cmd/Ctrl+1..9 (0-based index)
      }
    } else {
      if code == 1116 || code == 1084 {
        return BrowserShortcut::ReopenClosedTab // Cmd/Ctrl+Shift+T
      }
      if code == 1099 || code == 1067 {
        return BrowserShortcut::CopyCurrentUrl // Cmd/Ctrl+Shift+C
      }
      if code == 1092 || code == 1124 {
        return BrowserShortcut::ToggleSplitView // Cmd/Ctrl+Shift+\ (or shifted |)
      }
      if code == 1112 || code == 1080 {
        return BrowserShortcut::TogglePeek // Cmd/Ctrl+Shift+P
      }
      if code == 1097 || code == 1065 {
        return BrowserShortcut::ToggleTabFilter // Cmd/Ctrl+Shift+A
      }
      if code == 1098 || code == 1066 {
        return BrowserShortcut::ToggleBookmarks // Cmd/Ctrl+Shift+B
      }
      if code == 1115 || code == 1083 {
        return BrowserShortcut::CaptureScreenshot // Cmd/Ctrl+Shift+S
      }
      if code == 1101 || code == 1069 {
        return BrowserShortcut::ToggleBoosts // Cmd/Ctrl+Shift+E
      }
      if code == 1117 || code == 1085 {
        return BrowserShortcut::TogglePerfHud // Cmd/Ctrl+Shift+U
      }
      if !is_macos && (code == 1105 || code == 1073) {
        return BrowserShortcut::ToggleDevTools // Ctrl+Shift+I (Linux/Windows)
      }
    }
    if code == 1061 || code == 1043 {
      return BrowserShortcut::ZoomIn // Cmd/Ctrl+= or Cmd/Ctrl++ (with or without Shift)
    }
  }
  BrowserShortcut::None
}
