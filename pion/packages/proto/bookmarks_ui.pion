///| Pure-Pion portable Bookmarks UI model (`BookmarkEntry`, `BookmarksSnapshot`),
///| compact JSON codec with malformed/truncated resilience, and unified Arc Omnibox
///| intelligent ranking (`rank_omnibox_suggestions`) across Open Tabs, Bookmarks,
///| Browsing History, Direct URL, and Search suggestions.

pub let BOOKMARKS_MAX_ITEMS : Int = 8
pub let OMNIBOX_SUGGESTION_MAX_ITEMS : Int = 6

pub struct BookmarkEntry {
  pub id : String
  pub title : String
  pub url : String
  pub folder : String
  pub created_ms : Int64
}

pub struct BookmarksSnapshot {
  pub items : Array[BookmarkEntry]
}

pub fn BookmarksSnapshot::empty() -> BookmarksSnapshot {
  BookmarksSnapshot::{ items: [] }
}

pub enum OmniboxSuggestionKind {
  InstantAnswer
  SwitchTab
  Bookmark
  History
  DirectUrl
  Search
}

pub struct OmniboxSuggestion {
  pub kind : OmniboxSuggestionKind
  pub title : String
  pub url : String
  pub subtitle : String
  pub tab_id : String
  pub visits : Int
  pub score : Double
}

///| Canonicalizes a URL for deduplication and bookmark lookup (trimmed, lowercased
///| scheme/host, trailing slash stripped except for bare root).
pub fn bookmark_canonical_url(raw : String) -> String {
  let mut s = raw.trim()
  if s == "" {
    return ""
  }
  let mut lower = omni_ascii_lower(s)
  while lower.length() > 1 && lower.ends_with("/") {
    // Keep "https://" or "http://" intact
    if lower == "https://" || lower == "http://" || lower == "file://" {
      break
    }
    lower = lower.slice(0, lower.length() - 1)
    s = s.slice(0, s.length() - 1)
  }
  lower
}

pub fn bookmarks_contains_url(snap : BookmarksSnapshot, raw_url : String) -> Bool {
  let key = bookmark_canonical_url(raw_url)
  if key == "" {
    return false
  }
  let mut i = 0
  while i < snap.items.length() {
    if bookmark_canonical_url(snap.items[i].url) == key {
      return true
    }
    i = i + 1
  }
  false
}

pub fn bookmarks_filter(snap : BookmarksSnapshot, raw_query : String) -> Array[BookmarkEntry] {
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    let out : Array[BookmarkEntry] = []
    let mut i = 0
    while i < snap.items.length() {
      out.push(snap.items[i])
      i = i + 1
    }
    return out
  }
  let out : Array[BookmarkEntry] = []
  let mut i = 0
  while i < snap.items.length() {
    let it = snap.items[i]
    if omni_ascii_lower(it.title).contains(q) ||
    omni_ascii_lower(it.url).contains(q) ||
    omni_ascii_lower(it.folder).contains(q) {
      out.push(it)
    }
    i = i + 1
  }
  out
}

pub fn encode_bookmarks_snapshot(snap : BookmarksSnapshot) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < snap.items.length() {
    let it = snap.items[i]
    let ts = if it.created_ms < 0L { 0L } else { it.created_ms }
    parts.push(
      "{\"id\":" +
      omni_json_escape(it.id) +
      ",\"title\":" +
      omni_json_escape(it.title) +
      ",\"url\":" +
      omni_json_escape(it.url) +
      ",\"folder\":" +
      omni_json_escape(it.folder) +
      ",\"createdMs\":" +
      ts.to_string() +
      "}",
    )
    i = i + 1
  }
  "{\"items\":[" + parts.join(",") + "]}"
}

fn bm_parse_entry(p : OmniJsonParser) -> Option[BookmarkEntry] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut title = ""
  let mut url = ""
  let mut folder = ""
  let mut created_ms : Int64 = 0L
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(BookmarkEntry::{ id, title, url, folder, created_ms })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "folder" {
      match p.parse_str() {
        Some(v) => folder = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "createdMs" || key == "created_ms" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int64()
          created_ms = if iv < 0L { 0L } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      let eff_title = if title != "" { title } else { omnibox_display_host(url) }
      return Some(BookmarkEntry::{ id, title: eff_title, url, folder, created_ms })
    } else {
      return None
    }
  }
  None
}

///| Parses a `BookmarksSnapshot` JSON payload from `wire::Message::BookmarksState`.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_bookmarks_snapshot(
  json : String,
  max_items~ : Int = 256,
) -> Option[BookmarksSnapshot] {
  let limit = if max_items > 0 { max_items } else { 256 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let items : Array[BookmarkEntry] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(BookmarksSnapshot::{ items })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "items" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match bm_parse_entry(p) {
            Some(it) => if it.url != "" && items.length() < limit { items.push(it) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(BookmarksSnapshot::{ items })
    } else {
      return None
    }
  }
  None
}

fn omni_word_boundary_match(text : String, q : String) -> Bool {
  text.contains(" " + q) ||
  text.contains("-" + q) ||
  text.contains("." + q) ||
  text.contains("/" + q) ||
  text.contains("_" + q)
}

fn omni_match_score(q : String, title : String, url : String, host : String) -> Double {
  if q == "" {
    return 20.0
  }
  let host_l = omni_ascii_lower(host)
  let title_l = omni_ascii_lower(title)
  let url_l = omni_ascii_lower(url)
  let mut best = -1.0
  if host_l == q {
    best = 130.0
  } else if host_l.starts_with(q) {
    best = 105.0
  } else if title_l.starts_with(q) {
    best = 95.0
  } else if omni_word_boundary_match(host_l, q) {
    best = 82.0
  } else if omni_word_boundary_match(title_l, q) {
    best = 76.0
  } else if host_l.contains(q) {
    best = 66.0
  } else if title_l.contains(q) {
    best = 56.0
  } else if url_l.contains(q) {
    best = 42.0
  }
  if best < 0.0 {
    return -1.0
  }
  // Compactness bonus when query covers a larger fraction of host/title
  let denom = if host_l.length() > 0 { host_l.length() } else if title_l.length() > 0 { title_l.length() } else { 1 }
  let ratio = int_to_double(q.length()) / int_to_double(denom)
  let bonus = if ratio > 1.0 { 12.0 } else { ratio * 12.0 }
  best + bonus
}

fn omni_kind_priority(k : OmniboxSuggestionKind) -> Int {
  match k {
    OmniboxSuggestionKind::InstantAnswer => 5
    OmniboxSuggestionKind::SwitchTab => 4
    OmniboxSuggestionKind::Bookmark => 3
    OmniboxSuggestionKind::History => 2
    OmniboxSuggestionKind::DirectUrl => 1
    OmniboxSuggestionKind::Search => 0
  }
}

fn omni_find_canon(list : Array[OmniboxSuggestion], canon : String) -> Int {
  let mut i = 0
  while i < list.length() {
    if bookmark_canonical_url(list[i].url) == canon {
      return i
    }
    i = i + 1
  }
  -1
}

///| Ranks unified Omnibox suggestions across Open Tabs (`SwitchTab`), Bookmarks (`Bookmark`),
///| Browsing History (`History`), and Direct URL / Search fallback (`DirectUrl` / `Search`).
///| Deduplicates by canonical URL (preserving the highest-priority match) and returns at most `max_items`.
pub fn rank_omnibox_suggestions(
  query : String,
  tabs : Array[TabSummary],
  bookmarks : Array[BookmarkEntry],
  history : Array[HistoryItemSummary],
  max_items : Int,
) -> Array[OmniboxSuggestion] {
  let cap = if max_items > 0 { max_items } else { OMNIBOX_SUGGESTION_MAX_ITEMS }
  let site_search = match_site_search(query)
  let trimmed = match site_search {
    Some(ss) => ss.query
    None => query.trim()
  }
  let q = omni_ascii_lower(trimmed)
  let candidates : Array[OmniboxSuggestion] = []

  // 1. Open Tabs (non-active tabs get SwitchTab priority)
  let mut ti = 0
  while ti < tabs.length() {
    let t = tabs[ti]
    let u = t.url.trim()
    if u != "" && u != "about:blank" && !t.active {
      let title = workspace_tab_display_title(t)
      let host = omnibox_display_host(u)
      let base = omni_match_score(q, title, u, host)
      if base >= 0.0 {
        let score = base + 45.0 + (if t.pinned || t.favorite { 6.0 } else { 0.0 })
        let canon = bookmark_canonical_url(u)
        let prev_i = omni_find_canon(candidates, canon)
        let sug = OmniboxSuggestion::{
          kind: OmniboxSuggestionKind::SwitchTab,
          title: title,
          url: u,
          subtitle: host,
          tab_id: t.id,
          visits: 0,
          score: score,
        }
        if prev_i < 0 {
          candidates.push(sug)
        } else if score > candidates[prev_i].score {
          candidates[prev_i] = sug
        }
      }
    }
    ti = ti + 1
  }

  // 2. Bookmarks
  let mut bi = 0
  while bi < bookmarks.length() {
    let bm = bookmarks[bi]
    let u = bm.url.trim()
    if u != "" {
      let host = omnibox_display_host(u)
      let title = if bm.title.trim() != "" { bm.title.trim() } else { host }
      let base = omni_match_score(q, title, u, host)
      if base >= 0.0 {
        let score = base + 30.0
        let canon = bookmark_canonical_url(u)
        let prev_i = omni_find_canon(candidates, canon)
        if prev_i < 0 {
          candidates.push(OmniboxSuggestion::{
            kind: OmniboxSuggestionKind::Bookmark,
            title: title,
            url: u,
            subtitle: host,
            tab_id: "",
            visits: 0,
            score: score,
          })
        } else {
          let prev = candidates[prev_i]
          if omni_kind_priority(OmniboxSuggestionKind::Bookmark) > omni_kind_priority(prev.kind) {
            candidates[prev_i] = OmniboxSuggestion::{
              kind: OmniboxSuggestionKind::Bookmark,
              title: title,
              url: u,
              subtitle: host,
              tab_id: "",
              visits: prev.visits,
              score: if score > prev.score { score } else { prev.score },
            }
          }
        }
      }
    }
    bi = bi + 1
  }

  // 3. Browsing History
  let mut hi = 0
  while hi < history.length() {
    let h = history[hi]
    let u = h.url.trim()
    if u != "" {
      let host = if h.host != "" { h.host } else { omnibox_display_host(u) }
      let title = if h.title.trim() != "" { h.title.trim() } else { host }
      let base = omni_match_score(q, title, u, host)
      if base >= 0.0 {
        let vc = if h.visit_count > 0 { h.visit_count } else { 1 }
        let visit_bonus = {
          let vb = int_to_double(vc) * 1.5
          if vb > 20.0 { 20.0 } else { vb }
        }
        let score = base + 10.0 + visit_bonus
        let canon = bookmark_canonical_url(u)
        let prev_i = omni_find_canon(candidates, canon)
        if prev_i < 0 {
          candidates.push(OmniboxSuggestion::{
            kind: OmniboxSuggestionKind::History,
            title: title,
            url: u,
            subtitle: host,
            tab_id: "",
            visits: vc,
            score: score,
          })
        } else {
          // Preserve visit count metadata on deduplicated SwitchTab/Bookmark
          let prev = candidates[prev_i]
          if prev.visits == 0 && vc > 0 {
            candidates[prev_i] = OmniboxSuggestion::{
              kind: prev.kind,
              title: prev.title,
              url: prev.url,
              subtitle: prev.subtitle,
              tab_id: prev.tab_id,
              visits: vc,
              score: prev.score,
            }
          }
        }
      }
    }
    hi = hi + 1
  }

  // Stable descending sort by score (tie-break by kind priority)
  let mut i = 1
  while i < candidates.length() {
    let cur = candidates[i]
    let mut j = i - 1
    while j >= 0 {
      let prev = candidates[j]
      let better = cur.score > prev.score ||
      (cur.score == prev.score && omni_kind_priority(cur.kind) > omni_kind_priority(prev.kind))
      if better {
        candidates[j + 1] = prev
        j = j - 1
      } else {
        break
      }
    }
    candidates[j + 1] = cur
    i = i + 1
  }

  // If Site Search (`@gh`, `@yt`, `@mdn`, `@wiki`, `@g`) matched, place it at index 0 with exact target URL
  match site_search {
    Some(ss) => {
      let ss_title = if ss.query != "" {
        ss.badge_text + " for \"" + ss.query + "\""
      } else {
        ss.badge_text + " — type keywords..."
      }
      let out : Array[OmniboxSuggestion] = [
        OmniboxSuggestion::{
          kind: OmniboxSuggestionKind::Search,
          title: ss_title,
          url: ss.url,
          subtitle: ss.url,
          tab_id: "",
          visits: 0,
          score: 1000.0,
        },
      ]
      let mut sk = 0
      while sk < candidates.length() && out.length() < cap {
        out.push(candidates[sk])
        sk = sk + 1
      }
      return out
    }
    None => ()
  }

  // If Instant Calculator / Unit Converter matched, pin it at index 0 ahead of everything
  match eval_omnibox_calc(trimmed) {
    Some(calc) => {
      let out : Array[OmniboxSuggestion] = [
        OmniboxSuggestion::{
          kind: OmniboxSuggestionKind::InstantAnswer,
          title: calc.display,
          url: calc.value,
          subtitle: calc.expr + " — " + calc.kind_label,
          tab_id: "",
          visits: 0,
          score: 2000.0,
        },
      ]
      let mut ck = 0
      while ck < candidates.length() && out.length() < cap {
        out.push(candidates[ck])
        ck = ck + 1
      }
      return out
    }
    None => ()
  }

  // Reserve 1 slot for DirectUrl / Search when query is non-empty
  let has_fallback = trimmed != ""
  let normalized = if has_fallback { omnibox_normalize_input(trimmed) } else { "" }
  let is_url = has_fallback && cmd_looks_like_url(trimmed)
  let fallback_canon = if is_url { bookmark_canonical_url(normalized) } else { "" }
  let need_fallback = has_fallback && (!is_url || omni_find_canon(candidates, fallback_canon) < 0)

  let match_limit = if need_fallback && cap > 1 { cap - 1 } else { cap }
  let out : Array[OmniboxSuggestion] = []
  let mut k = 0
  while k < candidates.length() && out.length() < match_limit {
    out.push(candidates[k])
    k = k + 1
  }

  if need_fallback && out.length() < cap {
    if is_url {
      out.push(OmniboxSuggestion::{
        kind: OmniboxSuggestionKind::DirectUrl,
        title: trimmed,
        url: normalized,
        subtitle: omnibox_display_host(normalized),
        tab_id: "",
        visits: 0,
        score: 5.0,
      })
    } else {
      out.push(OmniboxSuggestion::{
        kind: OmniboxSuggestionKind::Search,
        title: "Search Google for \"" + trimmed + "\"",
        url: normalized,
        subtitle: "google.com",
        tab_id: "",
        visits: 0,
        score: 1.0,
      })
    }
  }
  out
}
