///| Farview host <-> client binary wire protocol (tags 100..135, PatchOp 0..18).
///| 1:1 port of `client/src/proto/proto.mbt`.

import "html"

pub struct WireNode {
  pub id : Int
  pub kind : html::Kind
  pub ns : html::Ns
  pub ns_uri : String
  pub prefix : String
  pub tag : String
  pub attrs : Array[html::Attr]
  pub data : String
  pub value : Option[String]
  pub checked : Option[Bool]
  pub src_url : Option[String]
  pub natural : Option[(Double, Double)]
  pub quirks : Bool
  pub public_id : Option[String]
  pub system_id : Option[String]
  pub defined : Bool
  pub states : Int
  pub shadow : Option[WireNode]
  pub children : Array[WireNode]
}

pub struct WireFrame {
  pub iframe : Int
  pub url : String
  pub root : WireNode
}

pub struct WireDoc {
  pub base : String
  pub root : WireNode
  pub sheets : Array[(String, String)]
  pub cssom : Array[(Int, String)]
  pub frames : Array[WireFrame]
  pub target : String
}

pub enum PatchOp {
  Insert(Int, Int, WireNode)
  Remove(Int, Int)
  SetData(Int, String)
  SetAttrs(Int, Array[html::Attr])
  SetForm(Int, Option[String], Option[Bool])
  SetImage(Int, Option[String], Option[(Double, Double)])
  SetShadow(Int, Option[WireNode])
  SetDefined(Int, Bool)
  SetStates(Int, Int)
  SetQuirks(Int, Bool)
  SetSheet(String, String)
  SetCssom(Int, Option[String])
  SetFrame(Int, Option[WireFrame])
  SetTarget(String)
  Rendered(Int, String, Double, Double)
  Focus(Int)
  ScrollTo(Int, Double, Double)
  Selection(Int, Int, Int, Int, Int)
  Validation(Int, String)
}

pub enum HostMsg {
  Meta(String, String, Bool, Bool, Bool)
  Reset(Int, Int, WireDoc)
  Patch(Int, Int, Array[PatchOp])
  Asset(String, Int, Double, Double, Bytes)
  Copied(String)
  AgentOn(Bool)
  OpenTab(String)
  PickFile(Int, String, Bool)
  Downloaded(String, String, String, Bytes)
  CloseTab
  DownloadStart(Int, String, String, String, Int)
  DownloadChunk(Int, Bytes)
  DownloadEnd(Int)
  Audio(Int, Bytes)
  AudioCtl(Double, Bool)
  // whether a navigation is on its way (true: one has started, or the page's scripts asked for one; false: none,
  // whatever the page's pictures still load). A host that sends it acknowledges every NavAt (done or declined); a
  // client that never had one takes neither for granted (an older host: older clients skip the unknown tag)
  Navigating(Bool)
}

pub let DOWNLOAD_SENT_MOST : Int = 33554432
pub let DOWNLOAD_SINGLE_MOST : Int = 4194304
pub let DOWNLOAD_CHUNK_SIZE : Int = 2097152
pub let DOWNLOAD_STREAM_MOST : Int = 268435456

pub enum ClientMsg {
  Hello(Int, String)
  Viewport(Double, Double, Double)
  Pointer(Int, Int, Int, Int, Int, Double, Double, Double, Double)
  Wheel(Int, Double, Double, Double, Double)
  ScrollSync(Int, Double, Double)
  EditInput(Int, Int, String, Int, Int, Int)
  Key(Int, Int, Bool, String, String, String, Int)
  Nav(Int, String)
  // a Nav with the input seq it goes with (seq, kind, url): the host acknowledges it (Patch ack) once it has done
  // or declined it, so the client knows its asked-for navigation was answered. On the wire: a Nav with the seq after
  // its url (a host that reads only Nav's fields takes it as a Nav)
  NavAt(Int, Int, String)
  UploadFiles(Int, Array[(String, String, Bytes)])
  ///| Files the person dropped on the page from their desktop, where `Pointer` says a point: the element there (its
  ///| wire id, 0 for none) and the point's fraction of its box, then the point of what shows (CSS px from its top
  ///| left, for none): the page's drag events there with a DataTransfer of them, or an `<input type=file>` there
  ///| given them.
  DropFiles(Int, Double, Double, Double, Double, Array[(String, String, Bytes)])
  ///| Files from the desktop held over the page, at a point as `DropFiles` says it (types "Files", no data): the
  ///| page's dragenter, dragleave and dragover as they move.
  DragOver(Int, Double, Double, Double, Double)
  ///| Files from the desktop carried off the page: dragleave on what they were over.
  DragLeave
  /// What the person's pages are shown as beyond their size: dark (`prefers-color-scheme`, the browser's appearance
  /// as it follows the system's or the person's choice). Said once a tab's page is there and again when it changes;
  /// the device pixel ratio goes with `Viewport`.
  MediaPrefs(Bool)
  /// The person left the page's fullscreen (Esc, the window leaving full screen): the host ends it
  /// (`document.fullscreenElement` null, "fullscreenchange").
  ExitFullscreen
}

pub let VERSION : Int = 1

pub let POINTER_DOWN : Int = 0
pub let POINTER_UP : Int = 1
pub let POINTER_MOVE : Int = 2
pub let POINTER_CLICK : Int = 3
pub let POINTER_DOUBLE : Int = 4
pub let POINTER_MENU : Int = 5
pub let POINTER_LEAVE : Int = 6

pub let EDIT_INPUT : Int = 0
pub let EDIT_CHANGE : Int = 1
pub let EDIT_SUBMIT : Int = 2
pub let EDIT_COMPOSING : Int = 3

pub let NAV_GO : Int = 0
pub let NAV_BACK : Int = 1
pub let NAV_FORWARD : Int = 2
pub let NAV_RELOAD : Int = 3
pub let NAV_NEW_TAB : Int = 4
pub let NAV_CLOSE : Int = 5
pub let NAV_TAKE_OVER : Int = 6

fn int_to_double(v : Int) -> Double {
  v.to_double()
}

fn double_to_bits(v : Double) -> Int64 {
  v.to_bits()
}

fn bits_to_double(bits : Int64) -> Double {
  Double::from_bits(bits)
}

struct Writer {
  mut buf : Bytes
  mut n : Int
}

fn Writer::new() -> Writer {
  // Reserve 4 leading bytes for the length prefix so `framed()` avoids a second full copy.
  Writer::{ buf: Bytes::new(260), n: 4 }
}

fn Writer::ensure(self : Writer, extra : Int) -> Unit {
  if self.n + extra <= self.buf.length() {
    return
  }
  let need = self.n + extra
  let cap = if extra >= 262144 {
    need
  } else {
    let mut c = self.buf.length() * 2
    while c < need {
      c = c * 2
    }
    c
  }
  let bigger = Bytes::new(cap)
  proto_bytes_blit(bigger, 0, self.buf, 0, self.n)
  self.buf = bigger
}

fn Writer::write_byte(self : Writer, b : Int) -> Unit {
  self.ensure(1)
  self.buf[self.n] = (b & 0xFF).to_byte()
  self.n = self.n + 1
}

fn Writer::write_bytes(self : Writer, b : Bytes) -> Unit {
  let len = b.length()
  if len == 0 {
    return
  }
  self.ensure(len)
  proto_bytes_blit(self.buf, self.n, b, 0, len)
  self.n = self.n + len
}

fn Writer::to_bytes(self : Writer) -> Bytes {
  self.buf.slice(4, self.n)
}

fn Writer::int(self : Writer, v : Int) -> Unit {
  let zz = (v << 1) ^ (v >> 31)
  let mut u = zz.to_int64() & 0xFFFFFFFFL
  while u >= 0x80L {
    self.write_byte(((u & 0x7FL) | 0x80L).to_int())
    u = u >> 7L
  }
  self.write_byte(u.to_int())
}

fn Writer::num(self : Writer, v : Double) -> Unit {
  let bits = double_to_bits(v)
  let mut i = 0
  while i < 8 {
    self.write_byte(((bits >> (i * 8).to_int64()) & 0xFFL).to_int())
    i = i + 1
  }
}

fn Writer::flag(self : Writer, b : Bool) -> Unit {
  self.write_byte(if b { 1 } else { 0 })
}

fn Writer::string(self : Writer, s : String) -> Unit {
  let b = s.to_bytes()
  self.int(b.length())
  self.write_bytes(b)
}

fn Writer::bytes(self : Writer, b : Bytes) -> Unit {
  self.int(b.length())
  self.write_bytes(b)
}

fn Writer::opt_string(self : Writer, s : Option[String]) -> Unit {
  match s {
    Some(v) => {
      self.flag(true)
      self.string(v)
    }
    None => self.flag(false)
  }
}

fn Writer::attrs(self : Writer, attrs : Array[html::Attr]) -> Unit {
  self.int(attrs.length())
  let mut i = 0
  while i < attrs.length() {
    let a = attrs[i]
    self.string(a.prefix)
    self.string(a.name)
    self.string(a.ns)
    self.string(a.value)
    i = i + 1
  }
}

fn kind_int(k : html::Kind) -> Int {
  match k {
    html::Kind::Document => 0
    html::Kind::Fragment => 1
    html::Kind::Doctype => 2
    html::Kind::Element => 3
    html::Kind::Text => 4
    html::Kind::Comment => 5
  }
}

fn int_kind(i : Int) -> html::Kind {
  if i == 0 {
    html::Kind::Document
  } else if i == 1 {
    html::Kind::Fragment
  } else if i == 2 {
    html::Kind::Doctype
  } else if i == 3 {
    html::Kind::Element
  } else if i == 4 {
    html::Kind::Text
  } else {
    html::Kind::Comment
  }
}

fn ns_int(n : html::Ns) -> Int {
  match n {
    html::Ns::Html => 0
    html::Ns::Svg => 1
    html::Ns::MathMl => 2
    html::Ns::Other => 3
  }
}

fn int_ns(i : Int) -> html::Ns {
  if i == 0 {
    html::Ns::Html
  } else if i == 1 {
    html::Ns::Svg
  } else if i == 2 {
    html::Ns::MathMl
  } else {
    html::Ns::Other
  }
}

fn Writer::node(self : Writer, n : WireNode) -> Unit {
  self.int(n.id)
  self.int(kind_int(n.kind))
  if n.kind == html::Kind::Text || n.kind == html::Kind::Comment {
    self.string(n.data)
    return
  }
  self.int(ns_int(n.ns))
  self.string(n.ns_uri)
  self.string(n.prefix)
  self.string(n.tag)
  self.attrs(n.attrs)
  self.string(n.data)
  self.opt_string(n.value)
  match n.checked {
    Some(c) => self.int(if c { 2 } else { 1 })
    None => self.int(0)
  }
  self.opt_string(n.src_url)
  match n.natural {
    Some(sz) => {
      self.flag(true)
      self.num(sz.0)
      self.num(sz.1)
    }
    None => self.flag(false)
  }
  self.flag(n.quirks)
  self.opt_string(n.public_id)
  self.opt_string(n.system_id)
  self.flag(n.defined)
  self.int(n.states)
  match n.shadow {
    Some(s) => {
      self.flag(true)
      self.node(s)
    }
    None => self.flag(false)
  }
  self.int(n.children.length())
  let mut i = 0
  while i < n.children.length() {
    self.node(n.children[i])
    i = i + 1
  }
}

fn Writer::frame(self : Writer, f : WireFrame) -> Unit {
  self.int(f.iframe)
  self.string(f.url)
  self.node(f.root)
}

fn Writer::op(self : Writer, op : PatchOp) -> Unit {
  match op {
    Insert(p, i, n) => {
      self.int(0)
      self.int(p)
      self.int(i)
      self.node(n)
    }
    Remove(p, c) => {
      self.int(1)
      self.int(p)
      self.int(c)
    }
    SetData(id, s) => {
      self.int(2)
      self.int(id)
      self.string(s)
    }
    SetAttrs(id, a) => {
      self.int(3)
      self.int(id)
      self.attrs(a)
    }
    SetForm(id, v, c) => {
      self.int(4)
      self.int(id)
      self.opt_string(v)
      self.int(
        match c {
          Some(true) => 2
          Some(false) => 1
          None => 0
        },
      )
    }
    SetImage(id, u, nat) => {
      self.int(5)
      self.int(id)
      self.opt_string(u)
      match nat {
        Some(sz) => {
          self.flag(true)
          self.num(sz.0)
          self.num(sz.1)
        }
        None => self.flag(false)
      }
    }
    SetShadow(id, s) => {
      self.int(6)
      self.int(id)
      match s {
        Some(n) => {
          self.flag(true)
          self.node(n)
        }
        None => self.flag(false)
      }
    }
    SetDefined(id, d) => {
      self.int(7)
      self.int(id)
      self.flag(d)
    }
    SetStates(id, b) => {
      self.int(16)
      self.int(id)
      self.int(b)
    }
    SetQuirks(id, q) => {
      self.int(8)
      self.int(id)
      self.flag(q)
    }
    SetSheet(u, t) => {
      self.int(9)
      self.string(u)
      self.string(t)
    }
    SetCssom(id, t) => {
      self.int(10)
      self.int(id)
      self.opt_string(t)
    }
    SetFrame(id, f) => {
      self.int(11)
      self.int(id)
      match f {
        Some(fr) => {
          self.flag(true)
          self.frame(fr)
        }
        None => self.flag(false)
      }
    }
    SetTarget(t) => {
      self.int(12)
      self.string(t)
    }
    Rendered(id, k, w, h) => {
      self.int(13)
      self.int(id)
      self.string(k)
      self.num(w)
      self.num(h)
    }
    Focus(id) => {
      self.int(14)
      self.int(id)
    }
    ScrollTo(id, x, y) => {
      self.int(15)
      self.int(id)
      self.num(x)
      self.num(y)
    }
    Selection(host, a, ao, z, zo) => {
      self.int(17)
      self.int(host)
      self.int(a)
      self.int(ao)
      self.int(z)
      self.int(zo)
    }
    Validation(id, msg) => {
      self.int(18)
      self.int(id)
      self.string(msg)
    }
  }
}

fn Writer::framed(self : Writer) -> Bytes {
  let payload = self.n - 4
  self.buf[0] = ((payload >> 24) & 0xFF).to_byte()
  self.buf[1] = ((payload >> 16) & 0xFF).to_byte()
  self.buf[2] = ((payload >> 8) & 0xFF).to_byte()
  self.buf[3] = (payload & 0xFF).to_byte()
  self.buf.slice(0, self.n)
}

pub fn encode_host(m : HostMsg) -> Bytes {
  let w = Writer::new()
  match m {
    Meta(url, title, loading, back, forward) => {
      w.int(100)
      w.string(url)
      w.string(title)
      w.flag(loading)
      w.flag(back)
      w.flag(forward)
    }
    Reset(seq, ack, d) => {
      w.int(101)
      w.int(seq)
      w.int(ack)
      w.string(d.base)
      w.node(d.root)
      w.int(d.sheets.length())
      let mut i = 0
      while i < d.sheets.length() {
        w.string(d.sheets[i].0)
        w.string(d.sheets[i].1)
        i = i + 1
      }
      w.int(d.cssom.length())
      i = 0
      while i < d.cssom.length() {
        w.int(d.cssom[i].0)
        w.string(d.cssom[i].1)
        i = i + 1
      }
      w.int(d.frames.length())
      i = 0
      while i < d.frames.length() {
        w.frame(d.frames[i])
        i = i + 1
      }
      w.string(d.target)
    }
    Patch(seq, ack, ops) => {
      w.int(102)
      w.int(seq)
      w.int(ack)
      w.int(ops.length())
      let mut i = 0
      while i < ops.length() {
        w.op(ops[i])
        i = i + 1
      }
    }
    Asset(key, kind, aw, ah, data) => {
      w.int(103)
      w.string(key)
      w.int(kind)
      w.num(aw)
      w.num(ah)
      w.bytes(data)
    }
    Copied(t) => {
      w.int(104)
      w.string(t)
    }
    AgentOn(on) => {
      w.int(105)
      w.flag(on)
    }
    OpenTab(u) => {
      w.int(106)
      w.string(u)
    }
    PickFile(id, accept, multiple) => {
      w.int(107)
      w.int(id)
      w.string(accept)
      w.flag(multiple)
    }
    Downloaded(name, url, mime, data) => {
      w.int(108)
      w.string(name)
      w.string(url)
      w.string(mime)
      w.bytes(data)
    }
    CloseTab => w.int(109)
    DownloadStart(id, name, url, mime, total) => {
      w.int(110)
      w.int(id)
      w.string(name)
      w.string(url)
      w.string(mime)
      w.int(total)
    }
    DownloadChunk(id, data) => {
      w.int(111)
      w.int(id)
      w.bytes(data)
    }
    DownloadEnd(id) => {
      w.int(112)
      w.int(id)
    }
    Audio(fmt, data) => {
      w.int(134)
      w.int(fmt)
      w.bytes(data)
    }
    Navigating(on) => {
      w.int(136)
      w.flag(on)
    }
    AudioCtl(vol, stop) => {
      w.int(135)
      w.num(vol)
      w.flag(stop)
    }
  }
  w.framed()
}

pub fn encode_client(m : ClientMsg) -> Bytes {
  let w = Writer::new()
  match m {
    Hello(v, caps) => {
      w.int(120)
      w.int(v)
      w.string(caps)
    }
    Viewport(vw, vh, dpr) => {
      w.int(121)
      w.num(vw)
      w.num(vh)
      w.num(dpr)
    }
    Pointer(seq, kind, button, mods, target, rx, ry, x, y) => {
      w.int(122)
      w.int(seq)
      w.int(kind)
      w.int(button)
      w.int(mods)
      w.int(target)
      w.num(rx)
      w.num(ry)
      w.num(x)
      w.num(y)
    }
    Wheel(target, rx, ry, dx, dy) => {
      w.int(123)
      w.int(target)
      w.num(rx)
      w.num(ry)
      w.num(dx)
      w.num(dy)
    }
    ScrollSync(id, x, y) => {
      w.int(124)
      w.int(id)
      w.num(x)
      w.num(y)
    }
    EditInput(seq, id, value, s0, s1, kind) => {
      w.int(125)
      w.int(seq)
      w.int(id)
      w.string(value)
      w.int(s0)
      w.int(s1)
      w.int(kind)
    }
    Key(seq, focus, down, key, code, text, mods) => {
      w.int(126)
      w.int(seq)
      w.int(focus)
      w.flag(down)
      w.string(key)
      w.string(code)
      w.string(text)
      w.int(mods)
    }
    Nav(kind, url) => {
      w.int(127)
      w.int(kind)
      w.string(url)
    }
    NavAt(seq, kind, url) => {
      w.int(127)
      w.int(kind)
      w.string(url)
      w.int(seq)
    }
    MediaPrefs(dark) => {
      w.int(132)
      w.flag(dark)
    }
    ExitFullscreen => w.int(133)
    UploadFiles(id, files) => {
      w.int(128)
      w.int(id)
      w.int(files.length())
      let mut i = 0
      while i < files.length() {
        w.string(files[i].0)
        w.string(files[i].1)
        w.bytes(files[i].2)
        i = i + 1
      }
    }
    DropFiles(target, rx, ry, x, y, files) => {
      w.int(129)
      w.int(target)
      w.num(rx)
      w.num(ry)
      w.num(x)
      w.num(y)
      w.int(files.length())
      for f in files {
        w.string(f.0)
        w.string(f.1)
        w.bytes(f.2)
      }
    }
    DragOver(target, rx, ry, x, y) => {
      w.int(130)
      w.int(target)
      w.num(rx)
      w.num(ry)
      w.num(x)
      w.num(y)
    }
    DragLeave => w.int(131)
  }
  w.framed()
}

///| Zero-allocation check whether a length-prefixed framed client message is a
///| coalescable `ClientMsg::Pointer(_, POINTER_MOVE, ...)`.
pub fn is_pointer_move_frame(framed : Bytes) -> Bool {
  let n = framed.length()
  if n < 7 {
    return false
  }
  let mut pos = 4
  // Decode tag (varint zigzag): 122 -> zigzag 244 -> [0xF4, 0x01]
  if framed[pos].to_int() != 0xF4 || framed[pos + 1].to_int() != 0x01 {
    return false
  }
  pos = pos + 2
  // Skip seq varint
  while pos < n {
    let b = framed[pos].to_int()
    pos = pos + 1
    if (b & 0x80) == 0 {
      break
    }
  }
  if pos >= n {
    return false
  }
  // Decode kind varint: POINTER_MOVE == 2 -> zigzag 4 -> single byte 0x04
  framed[pos].to_int() == 4
}

struct Reader {
  b : Bytes
  mut i : Int
  mut bad : Bool
}

fn Reader::new(b : Bytes) -> Reader {
  Reader::{ b: b, i: 0, bad: false }
}

fn Reader::byte(self : Reader) -> Int {
  if self.i >= self.b.length() {
    self.bad = true
    return 0
  }
  let c = self.b[self.i].to_int() & 0xFF
  self.i = self.i + 1
  c
}

fn Reader::int(self : Reader) -> Int {
  let mut u = 0L
  let mut shift = 0
  while true {
    let c = self.byte()
    if self.bad {
      return 0
    }
    u = u | ((c & 0x7F).to_int64() << shift.to_int64())
    if c < 0x80 {
      break
    }
    shift = shift + 7
    if shift >= 35 {
      self.bad = true
      return 0
    }
  }
  let u32 = u & 0xFFFFFFFFL
  ((u32 >> 1L) ^ (0L - (u32 & 1L))).to_int()
}

fn Reader::count(self : Reader) -> Int {
  let n = self.int()
  if n < 0 || n > self.b.length() - self.i {
    self.bad = true
    return 0
  }
  n
}

fn Reader::num(self : Reader) -> Double {
  if self.b.length() - self.i < 8 {
    self.bad = true
    self.i = self.b.length()
    return 0.0
  }
  let mut bits = 0L
  let mut k = 0
  while k < 8 {
    let bk = (self.b[self.i + k].to_int() & 0xFF).to_int64()
    bits = bits | (bk << (k * 8).to_int64())
    k = k + 1
  }
  self.i = self.i + 8
  bits_to_double(bits)
}

fn Reader::flag(self : Reader) -> Bool {
  self.byte() != 0
}

fn Reader::bytes(self : Reader) -> Bytes {
  let n = self.count()
  let out = self.b.slice(self.i, self.i + n)
  self.i = self.i + n
  out
}

fn Reader::string(self : Reader) -> String {
  self.bytes().to_string()
}

fn Reader::opt_string(self : Reader) -> Option[String] {
  if self.flag() {
    Some(self.string())
  } else {
    None
  }
}

fn Reader::attrs(self : Reader) -> Array[html::Attr] {
  let n = self.count()
  let out : Array[html::Attr] = []
  let mut i = 0
  while i < n {
    let prefix = self.string()
    let name = self.string()
    let ns = self.string()
    let value = self.string()
    out.push(html::Attr::new(prefix, name, value, ns))
    i = i + 1
  }
  out
}

fn Reader::checked(self : Reader) -> Option[Bool] {
  let v = self.int()
  if v == 2 {
    Some(true)
  } else if v == 1 {
    Some(false)
  } else {
    None
  }
}

fn Reader::natural(self : Reader) -> Option[(Double, Double)] {
  if self.flag() {
    let w = self.num()
    let h = self.num()
    Some((w, h))
  } else {
    None
  }
}

fn Reader::node(self : Reader) -> WireNode {
  let id = self.int()
  let kind = int_kind(self.int())
  if kind == html::Kind::Text || kind == html::Kind::Comment {
    let d = self.string()
    return WireNode::{
      id: id,
      kind: kind,
      ns: html::Ns::Html,
      ns_uri: "",
      prefix: "",
      tag: "",
      attrs: [],
      data: d,
      value: None,
      checked: None,
      src_url: None,
      natural: None,
      quirks: false,
      public_id: None,
      system_id: None,
      defined: false,
      states: 0,
      shadow: None,
      children: [],
    }
  }
  let ns = int_ns(self.int())
  let ns_uri = self.string()
  let prefix = self.string()
  let tag = self.string()
  let attrs = self.attrs()
  let data = self.string()
  let value = self.opt_string()
  let checked = self.checked()
  let src_url = self.opt_string()
  let natural = self.natural()
  let quirks = self.flag()
  let public_id = self.opt_string()
  let system_id = self.opt_string()
  let defined = self.flag()
  let states = self.int()
  let shadow : Option[WireNode] = if self.flag() {
    Some(self.node())
  } else {
    None
  }
  let n = self.count()
  let children : Array[WireNode] = []
  let mut i = 0
  while i < n {
    children.push(self.node())
    i = i + 1
  }
  WireNode::{
    id: id,
    kind: kind,
    ns: ns,
    ns_uri: ns_uri,
    prefix: prefix,
    tag: tag,
    attrs: attrs,
    data: data,
    value: value,
    checked: checked,
    src_url: src_url,
    natural: natural,
    quirks: quirks,
    public_id: public_id,
    system_id: system_id,
    defined: defined,
    states: states,
    shadow: shadow,
    children: children,
  }
}

fn Reader::frame(self : Reader) -> WireFrame {
  let iframe = self.int()
  let url = self.string()
  let root = self.node()
  WireFrame::{ iframe: iframe, url: url, root: root }
}

fn Reader::op(self : Reader) -> PatchOp {
  let tag = self.int()
  if tag == 0 {
    let p = self.int()
    let i = self.int()
    Insert(p, i, self.node())
  } else if tag == 1 {
    let p = self.int()
    Remove(p, self.int())
  } else if tag == 2 {
    let id = self.int()
    SetData(id, self.string())
  } else if tag == 3 {
    let id = self.int()
    SetAttrs(id, self.attrs())
  } else if tag == 4 {
    let id = self.int()
    let v = self.opt_string()
    SetForm(id, v, self.checked())
  } else if tag == 5 {
    let id = self.int()
    let u = self.opt_string()
    SetImage(id, u, self.natural())
  } else if tag == 6 {
    let id = self.int()
    let sh : Option[WireNode] = if self.flag() {
      Some(self.node())
    } else {
      None
    }
    SetShadow(id, sh)
  } else if tag == 7 {
    let id = self.int()
    SetDefined(id, self.flag())
  } else if tag == 8 {
    let id = self.int()
    SetQuirks(id, self.flag())
  } else if tag == 9 {
    let u = self.string()
    SetSheet(u, self.string())
  } else if tag == 10 {
    let id = self.int()
    SetCssom(id, self.opt_string())
  } else if tag == 11 {
    let id = self.int()
    let fr : Option[WireFrame] = if self.flag() {
      Some(self.frame())
    } else {
      None
    }
    SetFrame(id, fr)
  } else if tag == 12 {
    SetTarget(self.string())
  } else if tag == 13 {
    let id = self.int()
    let k = self.string()
    let w = self.num()
    Rendered(id, k, w, self.num())
  } else if tag == 14 {
    Focus(self.int())
  } else if tag == 16 {
    let id = self.int()
    SetStates(id, self.int())
  } else if tag == 17 {
    let host = self.int()
    let a = self.int()
    let ao = self.int()
    let z = self.int()
    Selection(host, a, ao, z, self.int())
  } else if tag == 18 {
    let id = self.int()
    Validation(id, self.string())
  } else {
    let id = self.int()
    let x = self.num()
    ScrollTo(id, x, self.num())
  }
}

pub fn is_doc_wire(body : Bytes) -> Bool {
  Reader::new(body).int() >= 100
}

fn host_msg(r : Reader) -> Option[HostMsg] {
  let tag = r.int()
  if tag == 100 {
    let url = r.string()
    let title = r.string()
    let loading = r.flag()
    let back = r.flag()
    Some(Meta(url, title, loading, back, r.flag()))
  } else if tag == 101 {
    let seq = r.int()
    let ack = r.int()
    let base = r.string()
    let root = r.node()
    let ns = r.count()
    let sheets : Array[(String, String)] = []
    let mut i = 0
    while i < ns {
      let u = r.string()
      sheets.push((u, r.string()))
      i = i + 1
    }
    let nc = r.count()
    let cssom : Array[(Int, String)] = []
    i = 0
    while i < nc {
      let id = r.int()
      cssom.push((id, r.string()))
      i = i + 1
    }
    let nf = r.count()
    let frames : Array[WireFrame] = []
    i = 0
    while i < nf {
      frames.push(r.frame())
      i = i + 1
    }
    let target = r.string()
    Some(
      Reset(
        seq,
        ack,
        WireDoc::{
          base: base,
          root: root,
          sheets: sheets,
          cssom: cssom,
          frames: frames,
          target: target,
        },
      ),
    )
  } else if tag == 102 {
    let seq = r.int()
    let ack = r.int()
    let n = r.count()
    let ops : Array[PatchOp] = []
    let mut i = 0
    while i < n {
      ops.push(r.op())
      i = i + 1
    }
    Some(Patch(seq, ack, ops))
  } else if tag == 103 {
    let key = r.string()
    let kind = r.int()
    let w = r.num()
    let h = r.num()
    Some(Asset(key, kind, w, h, r.bytes()))
  } else if tag == 104 {
    Some(Copied(r.string()))
  } else if tag == 105 {
    Some(AgentOn(r.flag()))
  } else if tag == 106 {
    Some(OpenTab(r.string()))
  } else if tag == 107 {
    let id = r.int()
    let accept = r.string()
    Some(PickFile(id, accept, r.flag()))
  } else if tag == 108 {
    let name = r.string()
    let url = r.string()
    let mime = r.string()
    Some(Downloaded(name, url, mime, r.bytes()))
  } else if tag == 109 {
    Some(CloseTab)
  } else if tag == 110 {
    let id = r.int()
    let name = r.string()
    let url = r.string()
    let mime = r.string()
    Some(DownloadStart(id, name, url, mime, r.int()))
  } else if tag == 111 {
    let id = r.int()
    Some(DownloadChunk(id, r.bytes()))
  } else if tag == 112 {
    Some(DownloadEnd(r.int()))
  } else if tag == 134 {
    let fmt = r.int()
    Some(Audio(fmt, r.bytes()))
  } else if tag == 135 {
    let vol = r.num()
    Some(AudioCtl(vol, r.flag()))
  } else if tag == 136 {
    Some(Navigating(r.flag()))
  } else {
    None
  }
}

pub fn decode_host(body : Bytes) -> Option[HostMsg] {
  let r = Reader::new(body)
  let m = host_msg(r)
  if r.bad { None } else { m }
}

fn client_msg(r : Reader) -> Option[ClientMsg] {
  let tag = r.int()
  if tag == 120 {
    let v = r.int()
    Some(Hello(v, r.string()))
  } else if tag == 121 {
    let w = r.num()
    let h = r.num()
    Some(Viewport(w, h, r.num()))
  } else if tag == 122 {
    let seq = r.int()
    let kind = r.int()
    let button = r.int()
    let mods = r.int()
    let target = r.int()
    let rx = r.num()
    let ry = r.num()
    let x = r.num()
    Some(Pointer(seq, kind, button, mods, target, rx, ry, x, r.num()))
  } else if tag == 123 {
    let target = r.int()
    let rx = r.num()
    let ry = r.num()
    let dx = r.num()
    Some(Wheel(target, rx, ry, dx, r.num()))
  } else if tag == 124 {
    let id = r.int()
    let x = r.num()
    Some(ScrollSync(id, x, r.num()))
  } else if tag == 125 {
    let seq = r.int()
    let id = r.int()
    let value = r.string()
    let s0 = r.int()
    let s1 = r.int()
    Some(EditInput(seq, id, value, s0, s1, r.int()))
  } else if tag == 126 {
    let seq = r.int()
    let focus = r.int()
    let down = r.flag()
    let key = r.string()
    let code = r.string()
    let text = r.string()
    Some(Key(seq, focus, down, key, code, text, r.int()))
  } else if tag == 127 {
    let kind = r.int()
    let url = r.string()
    if !r.bad && r.i < r.b.length() {
      Some(NavAt(r.int(), kind, url))
    } else {
      Some(Nav(kind, url))
    }
  } else if tag == 128 {
    let id = r.int()
    let n = r.count()
    let files : Array[(String, String, Bytes)] = []
    let mut i = 0
    while i < n {
      let name = r.string()
      let mime = r.string()
      files.push((name, mime, r.bytes()))
      i = i + 1
    }
    Some(UploadFiles(id, files))
  } else if tag == 129 {
    let target = r.int()
    let rx = r.num()
    let ry = r.num()
    let x = r.num()
    let y = r.num()
    let n = r.count()
    let files : Array[(String, String, Bytes)] = []
    let mut i = 0
    while i < n {
      let name = r.string()
      let mime = r.string()
      files.push((name, mime, r.bytes()))
      i = i + 1
    }
    Some(DropFiles(target, rx, ry, x, y, files))
  } else if tag == 130 {
    let target = r.int()
    let rx = r.num()
    let ry = r.num()
    let x = r.num()
    let y = r.num()
    Some(DragOver(target, rx, ry, x, y))
  } else if tag == 131 {
    Some(DragLeave)
  } else if tag == 132 {
    Some(MediaPrefs(r.flag()))
  } else if tag == 133 {
    Some(ExitFullscreen)
  } else {
    None
  }
}

pub fn decode_client(body : Bytes) -> Option[ClientMsg] {
  let r = Reader::new(body)
  let m = client_msg(r)
  if r.bad { None } else { m }
}
