///| Page zoom per site (Chrome's per-host zoom): a zoom a person picks on a site is kept for that site, applied to
///| every tab of it and again on its next visit; a site without one is shown at the default zoom.
///|
///| The table lives in `BrowserSettings.site_zoom` as `host=pct` entries joined by `,`, the most recently set
///| last; a site at the default zoom has no entry.

///| How many sites keep a zoom of their own (the oldest set goes first).
pub let SITE_ZOOM_MAX_ENTRIES : Int = 200

///| The key a page's zoom is kept under: its host, lower case, without a leading `www.` (an `http(s)` page only;
///| "" for anything else, which follows the default zoom).
pub fn site_zoom_key(raw_url : String) -> String {
  let s = raw_url.trim()
  let lower = omni_ascii_lower(s)
  let rest = if lower.starts_with("https://") {
    lower.slice(8, lower.length())
  } else if lower.starts_with("http://") {
    lower.slice(7, lower.length())
  } else {
    return ""
  }
  let mut end = rest.length()
  let mut i = 0
  while i < rest.length() {
    let c = rest.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      end = i
      break
    }
    i = i + 1
  }
  let mut host = rest.slice(0, end)
  // (credentials and the port are no part of the site)
  let at = sz_last_index(host, 0x40)
  if at >= 0 {
    host = host.slice(at + 1, host.length())
  }
  if !host.starts_with("[") {
    let colon = host.index_of(":")
    if colon >= 0 {
      host = host.slice(0, colon)
    }
  }
  if host.starts_with("www.") && host.length() > 4 {
    host = host.slice(4, host.length())
  }
  if host.contains("=") || host.contains(",") {
    return ""
  }
  host
}

fn sz_last_index(s : String, ch : Int) -> Int {
  let mut i = s.length() - 1
  while i >= 0 {
    if s.code_unit_at(i).to_int() == ch {
      return i
    }
    i = i - 1
  }
  -1
}

///| The last `SITE_ZOOM_MAX_ENTRIES` of `entries`, joined.
fn site_zoom_join_last(entries : Array[(String, Int)]) -> String {
  let from = if entries.length() > SITE_ZOOM_MAX_ENTRIES { entries.length() - SITE_ZOOM_MAX_ENTRIES } else { 0 }
  let kept : Array[(String, Int)] = []
  let mut i = from
  while i < entries.length() {
    kept.push(entries[i])
    i = i + 1
  }
  site_zoom_join(kept)
}

fn site_zoom_entries(table : String) -> Array[(String, Int)] {
  let out : Array[(String, Int)] = []
  for part in table.split(",") {
    let p = part.to_string().trim()
    let eq = sz_last_index(p, 0x3D)
    if eq <= 0 {
      continue
    }
    let key = p.slice(0, eq)
    let num = p.slice(eq + 1, p.length())
    let mut pct = 0
    let mut ok = num.length() > 0 && num.length() <= 3
    let mut i = 0
    while i < num.length() {
      let c = num.code_unit_at(i).to_int()
      if c < 48 || c > 57 {
        ok = false
        break
      }
      pct = pct * 10 + (c - 48)
      i = i + 1
    }
    if ok {
      out.push((key, zoom_percent((pct as Double) / 100.0)))
    }
  }
  out
}

fn site_zoom_join(entries : Array[(String, Int)]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < entries.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(entries[i].0)
    sb.write_string("=")
    sb.write_string(entries[i].1.to_string())
    i = i + 1
  }
  sb.to_string()
}

///| The zoom (percent) kept for `key`, or 0 when it has none of its own.
pub fn site_zoom_pct(table : String, key : String) -> Int {
  if key == "" {
    return 0
  }
  for e in site_zoom_entries(table) {
    if e.0 == key {
      return e.1
    }
  }
  0
}

///| `table` with `key` kept at `pct`: an entry at `default_pct` is dropped (the site follows the default again), a
///| new or changed one goes last, and past `SITE_ZOOM_MAX_ENTRIES` the oldest are let go.
pub fn site_zoom_with(table : String, key : String, pct : Int, default_pct : Int) -> String {
  let kept : Array[(String, Int)] = []
  for e in site_zoom_entries(table) {
    if e.0 != key {
      kept.push(e)
    }
  }
  let p = zoom_percent((pct as Double) / 100.0)
  if key != "" && p != default_pct {
    kept.push((key, p))
  }
  site_zoom_join_last(kept)
}

///| A stored table made clean: entries that do not parse are dropped, each key once (the last kept).
pub fn normalize_site_zoom(table : String) -> String {
  let all = site_zoom_entries(table)
  let out : Array[(String, Int)] = []
  let mut i = 0
  while i < all.length() {
    // (each key once: where it was last set)
    let mut later = false
    let mut j = i + 1
    while j < all.length() {
      if all[j].0 == all[i].0 {
        later = true
        break
      }
      j = j + 1
    }
    if !later {
      out.push(all[i])
    }
    i = i + 1
  }
  site_zoom_join_last(out)
}

///| The zoom (percent) a page at `raw_url` is shown at: its site's own, else the default.
pub fn site_zoom_effective_pct(s : BrowserSettings, raw_url : String) -> Int {
  let own = site_zoom_pct(s.site_zoom, site_zoom_key(raw_url))
  if own > 0 { own } else { s.default_zoom_pct }
}
