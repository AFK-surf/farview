///| Pure-Pion portable models & logic for:
///| 1. Arc Colored Collapsible Tab Folders (6-color semantic palette, count & collapse helpers)
///| 2. Arc Reader Mode Pro Typography (Light/Sepia/Night paper themes, 14-24px font size,
///|    Sans/Serif/Mono fonts, Narrow/Medium/Wide column width, English+CJK reading time/word count)
///| 3. Named Workspace Session Snapshots (capture, JSON codec, UTF-8 filtering, one-click restore)

pub let READER_FONT_SIZE_MIN : Int = 14
pub let READER_FONT_SIZE_MAX : Int = 24
pub let READER_FONT_SIZE_DEFAULT : Int = 17
pub let READER_FONT_SIZE_STEP : Int = 2

pub let SAVED_SESSIONS_MAX_ITEMS : Int = 64

// --- 1. Colored Collapsible Tab Folders ---

pub fn folder_color_keys() -> Array[String] {
  ["blue", "emerald", "violet", "amber", "rose", "cyan"]
}

pub fn normalize_folder_color(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "emerald" || s == "green" || s == "#10b981" {
    "emerald"
  } else if s == "violet" || s == "purple" || s == "#8b5cf6" {
    "violet"
  } else if s == "amber" || s == "orange" || s == "yellow" || s == "#f59e0b" {
    "amber"
  } else if s == "rose" || s == "pink" || s == "red" || s == "#f43f5e" || s == "#ec4899" {
    "rose"
  } else if s == "cyan" || s == "teal" || s == "#06b6d4" {
    "cyan"
  } else {
    "blue"
  }
}

pub fn folder_color_for_index(idx : Int) -> String {
  let keys = folder_color_keys()
  let k = if idx < 0 { 0 } else { idx % keys.length() }
  keys[k]
}

pub fn folder_color_label(raw : String) -> String {
  let k = normalize_folder_color(raw)
  if k == "emerald" {
    "Emerald"
  } else if k == "violet" {
    "Violet"
  } else if k == "amber" {
    "Amber"
  } else if k == "rose" {
    "Rose"
  } else if k == "cyan" {
    "Cyan"
  } else {
    "Blue"
  }
}

pub fn folder_color_rgba(raw : String) -> Int64 {
  let k = normalize_folder_color(raw)
  if k == "emerald" {
    0x10B981FFL
  } else if k == "violet" {
    0x8B5CF6FFL
  } else if k == "amber" {
    0xF59E0BFFL
  } else if k == "rose" {
    0xF43F5EFFL
  } else if k == "cyan" {
    0x06B6D4FFL
  } else {
    0x3B82F6FFL
  }
}

pub fn folder_color_soft_bg(raw : String, dark : Bool) -> Int64 {
  let k = normalize_folder_color(raw)
  if dark {
    if k == "emerald" {
      0x123026FFL
    } else if k == "violet" {
      0x271E3EFFL
    } else if k == "amber" {
      0x342612FFL
    } else if k == "rose" {
      0x381924FFL
    } else if k == "cyan" {
      0x112E37FFL
    } else {
      0x192B48FFL
    }
  } else if k == "emerald" {
    0xD1FAE5FFL
  } else if k == "violet" {
    0xEDE9FEFFL
  } else if k == "amber" {
    0xFEF3C7FFL
  } else if k == "rose" {
    0xFFE4E6FFL
  } else if k == "cyan" {
    0xCFFAFEFFL
  } else {
    0xDBEAFEFFL
  }
}

pub fn folder_tab_count(
  snap : WorkspaceSnapshot,
  space_id : String,
  folder_id : String,
) -> Int {
  workspace_tabs_in_folder(snap, space_id, folder_id).length()
}

pub fn folder_is_collapsed(snap : WorkspaceSnapshot, folder_id : String) -> Bool {
  let mut i = 0
  while i < snap.folders.length() {
    if snap.folders[i].id == folder_id {
      return snap.folders[i].collapsed
    }
    i = i + 1
  }
  false
}

pub fn folder_toggle_collapsed_in_snapshot(
  snap : WorkspaceSnapshot,
  folder_id : String,
) -> WorkspaceSnapshot {
  let next_folders : Array[FolderSummary] = []
  let mut i = 0
  while i < snap.folders.length() {
    let fl = snap.folders[i]
    if fl.id == folder_id {
      next_folders.push(FolderSummary::{ ..fl, collapsed: !fl.collapsed })
    } else {
      next_folders.push(fl)
    }
    i = i + 1
  }
  WorkspaceSnapshot::{ ..snap, folders: next_folders }
}

// --- 2. Reader Mode Pro Typography & Reading Time Estimation ---

pub struct ReaderMetrics {
  pub word_count : Int
  pub cjk_chars : Int
  pub latin_words : Int
  pub read_minutes : Int
}

pub struct ReaderTypographyConfig {
  pub theme : String
  pub font : String
  pub font_size_px : Int
  pub width_mode : String
}

pub fn ReaderTypographyConfig::default() -> ReaderTypographyConfig {
  ReaderTypographyConfig::{
    theme: "light",
    font: "serif",
    font_size_px: READER_FONT_SIZE_DEFAULT,
    width_mode: "medium",
  }
}

pub fn normalize_reader_paper_theme(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "sepia" || s == "warm" || s == "paper" {
    "sepia"
  } else if s == "night" || s == "dark" {
    "night"
  } else {
    "light"
  }
}

pub fn normalize_reader_font(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "serif" {
    "serif"
  } else if s == "mono" || s == "monospace" {
    "mono"
  } else {
    "sans"
  }
}

pub fn normalize_reader_width(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "narrow" || s == "compact" {
    "narrow"
  } else if s == "wide" || s == "full" {
    "wide"
  } else {
    "medium"
  }
}

pub fn reader_column_width_pt(width_mode : String) -> Double {
  let w = normalize_reader_width(width_mode)
  if w == "narrow" {
    620.0
  } else if w == "wide" {
    840.0
  } else {
    720.0
  }
}

pub fn clamp_reader_font_size(px : Int) -> Int {
  if px < READER_FONT_SIZE_MIN {
    READER_FONT_SIZE_MIN
  } else if px > READER_FONT_SIZE_MAX {
    READER_FONT_SIZE_MAX
  } else {
    px
  }
}

pub fn step_reader_font_size(px : Int, delta : Int) -> Int {
  clamp_reader_font_size(clamp_reader_font_size(px) + delta)
}

pub fn clamp_reader_progress(progress : Double) -> Double {
  if progress < 0.0 {
    0.0
  } else if progress > 1.0 {
    1.0
  } else {
    progress
  }
}

fn rs_count_text_units(s : String) -> (Int, Int) {
  count_editorial_word_units(s)
}

fn rs_estimate_minutes(cjk : Int, latin : Int) -> Int {
  let total = cjk + latin
  if total <= 0 {
    return 1
  }
  // English/Latin: ~220 words/min, CJK: ~320 chars/min
  let mins_f = cjk.to_double() / 320.0 + latin.to_double() / 220.0
  let rounded = math_floor(mins_f + 0.5).to_int()
  if rounded < 1 { 1 } else { rounded }
}

pub fn compute_reader_metrics_text(text : String) -> ReaderMetrics {
  let (cjk, latin) = rs_count_text_units(text)
  ReaderMetrics::{
    word_count: cjk + latin,
    cjk_chars: cjk,
    latin_words: latin,
    read_minutes: rs_estimate_minutes(cjk, latin),
  }
}

pub fn compute_reader_metrics(
  blocks : Array[ReaderBlock],
  title~ : String = "",
) -> ReaderMetrics {
  let mut cjk = 0
  let mut latin = 0
  if title.trim() != "" {
    let (tc, tl) = rs_count_text_units(title)
    cjk = cjk + tc
    latin = latin + tl
  }
  let mut i = 0
  while i < blocks.length() {
    let (bc, bl) = rs_count_text_units(blocks[i].text)
    cjk = cjk + bc
    latin = latin + bl
    i = i + 1
  }
  ReaderMetrics::{
    word_count: cjk + latin,
    cjk_chars: cjk,
    latin_words: latin,
    read_minutes: rs_estimate_minutes(cjk, latin),
  }
}

pub fn format_read_minutes_badge(mins : Int) -> String {
  let m = if mins > 0 { mins } else { 1 }
  m.to_string() + " min read"
}

pub fn format_word_count_badge(words : Int) -> String {
  let w = if words > 0 { words } else { 0 }
  if w == 1 {
    "1 word"
  } else {
    w.to_string() + " words"
  }
}

// --- 3. Named Workspace Session Snapshots ---

pub struct SessionSpaceItem {
  pub id : String
  pub name : String
  pub accent : String
}

pub struct SessionFolderItem {
  pub id : String
  pub space_id : String
  pub name : String
  pub color : String
  pub collapsed : Bool
}

pub struct SessionTabItem {
  pub space_id : String
  pub title : String
  pub url : String
  pub pinned : Bool
  pub favorite : Bool
  pub folder_id : String
}

pub struct NamedSessionSnapshot {
  pub id : String
  pub name : String
  pub created_secs : Int64
  pub active_space_id : String
  pub spaces : Array[SessionSpaceItem]
  pub folders : Array[SessionFolderItem]
  pub tabs : Array[SessionTabItem]
}

pub struct SavedSessionsState {
  pub items : Array[NamedSessionSnapshot]
}

pub fn SavedSessionsState::empty() -> SavedSessionsState {
  SavedSessionsState::{ items: [] }
}

pub fn capture_named_session(
  id : String,
  name : String,
  created_secs : Int64,
  snap : WorkspaceSnapshot,
) -> NamedSessionSnapshot {
  let clean_name = if name.trim() != "" { name.trim() } else { "Untitled Session" }
  let spaces : Array[SessionSpaceItem] = []
  let mut i = 0
  while i < snap.spaces.length() {
    let sp = snap.spaces[i]
    spaces.push(SessionSpaceItem::{ id: sp.id, name: sp.name, accent: sp.accent })
    i = i + 1
  }
  let folders : Array[SessionFolderItem] = []
  let mut fi = 0
  while fi < snap.folders.length() {
    let fl = snap.folders[fi]
    folders.push(SessionFolderItem::{
      id: fl.id,
      space_id: fl.space_id,
      name: fl.name,
      color: normalize_folder_color(fl.color),
      collapsed: fl.collapsed,
    })
    fi = fi + 1
  }
  let tabs : Array[SessionTabItem] = []
  let mut ti = 0
  while ti < snap.tabs.length() {
    let tb = snap.tabs[ti]
    tabs.push(SessionTabItem::{
      space_id: tb.space_id,
      title: tb.title,
      url: tb.url,
      pinned: tb.pinned,
      favorite: tb.favorite,
      folder_id: tb.folder_id,
    })
    ti = ti + 1
  }
  NamedSessionSnapshot::{
    id: id,
    name: clean_name,
    created_secs: if created_secs < 0L { 0L } else { created_secs },
    active_space_id: snap.active_space_id,
    spaces: spaces,
    folders: folders,
    tabs: tabs,
  }
}

pub fn session_to_workspace_snapshot(sess : NamedSessionSnapshot) -> WorkspaceSnapshot {
  let spaces : Array[SpaceSummary] = []
  let mut i = 0
  while i < sess.spaces.length() {
    let sp = sess.spaces[i]
    let mut cnt = 0
    let mut ti = 0
    while ti < sess.tabs.length() {
      if sess.tabs[ti].space_id == sp.id {
        cnt = cnt + 1
      }
      ti = ti + 1
    }
    spaces.push(SpaceSummary::{
      id: sp.id,
      name: sp.name,
      accent: sp.accent,
      active: sp.id == sess.active_space_id || (sess.active_space_id == "" && i == 0),
      tab_count: cnt,
    })
    i = i + 1
  }
  let active_sid = if sess.active_space_id != "" {
    sess.active_space_id
  } else if spaces.length() > 0 {
    spaces[0].id
  } else {
    "work"
  }
  let folders : Array[FolderSummary] = []
  let mut fi = 0
  while fi < sess.folders.length() {
    let fl = sess.folders[fi]
    folders.push(FolderSummary::{
      id: fl.id,
      space_id: fl.space_id,
      name: fl.name,
      collapsed: fl.collapsed,
      color: normalize_folder_color(fl.color),
    })
    fi = fi + 1
  }
  let tabs : Array[TabSummary] = []
  let mut active_tid = ""
  let mut j = 0
  while j < sess.tabs.length() {
    let tb = sess.tabs[j]
    let tid = "restored-" + (j + 1).to_string()
    let is_act = active_tid == "" && tb.space_id == active_sid && !tb.favorite
    if is_act {
      active_tid = tid
    }
    tabs.push(TabSummary::{
      id: tid,
      space_id: tb.space_id,
      title: tb.title,
      url: tb.url,
      pinned: tb.pinned,
      favorite: tb.favorite,
      active: is_act,
      state: if is_act { "active" } else { "background" },
      folder_id: tb.folder_id,
      last_active_secs: sess.created_secs,
    })
    j = j + 1
  }
  WorkspaceSnapshot::{
    active_space_id: active_sid,
    active_tab_id: active_tid,
    spaces: spaces,
    folders: folders,
    tabs: tabs,
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
}

pub fn session_preview_hosts(
  sess : NamedSessionSnapshot,
  max_hosts~ : Int = 4,
) -> Array[String] {
  let cap = if max_hosts > 0 { max_hosts } else { 4 }
  let out : Array[String] = []
  let mut i = 0
  while i < sess.tabs.length() && out.length() < cap {
    let h0 = normalize_boost_host(sess.tabs[i].url)
    let h = if h0.starts_with("www.") && h0.length() > 4 { h0.slice(4, h0.length()) } else { h0 }
    if h != "" && h != "local-file" {
      let mut dup = false
      let mut k = 0
      while k < out.length() {
        if out[k] == h {
          dup = true
          break
        }
        k = k + 1
      }
      if !dup {
        out.push(h)
      }
    }
    i = i + 1
  }
  out
}

pub fn session_matches_filter(
  sess : NamedSessionSnapshot,
  raw_query : String,
) -> Bool {
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    return true
  }
  if omni_ascii_lower(sess.name).contains(q) {
    return true
  }
  let mut si = 0
  while si < sess.spaces.length() {
    if omni_ascii_lower(sess.spaces[si].name).contains(q) {
      return true
    }
    si = si + 1
  }
  let mut fi = 0
  while fi < sess.folders.length() {
    if omni_ascii_lower(sess.folders[fi].name).contains(q) {
      return true
    }
    fi = fi + 1
  }
  let mut ti = 0
  while ti < sess.tabs.length() {
    let tb = sess.tabs[ti]
    if omni_ascii_lower(tb.title).contains(q) ||
    omni_ascii_lower(tb.url).contains(q) ||
    omni_ascii_lower(omnibox_display_host(tb.url)).contains(q) {
      return true
    }
    ti = ti + 1
  }
  false
}

pub fn filter_named_sessions(
  items : Array[NamedSessionSnapshot],
  raw_query : String,
) -> Array[NamedSessionSnapshot] {
  let q = raw_query.trim()
  if q == "" {
    return items
  }
  let out : Array[NamedSessionSnapshot] = []
  let mut i = 0
  while i < items.length() {
    if session_matches_filter(items[i], q) {
      out.push(items[i])
    }
    i = i + 1
  }
  out
}

pub fn format_session_timestamp(created_secs : Int64, now_secs : Int64) -> String {
  if created_secs <= 0L {
    return "Saved"
  }
  let diff = if now_secs > created_secs { now_secs - created_secs } else { 0L }
  if diff < 60L {
    "Just now"
  } else if diff < 3600L {
    (diff / 60L).to_string() + "m ago"
  } else if diff < 86400L {
    (diff / 3600L).to_string() + "h ago"
  } else if diff < 172800L {
    "Yesterday"
  } else {
    (diff / 86400L).to_string() + "d ago"
  }
}

pub fn encode_named_session(sess : NamedSessionSnapshot) -> String {
  let sp_parts : Array[String] = []
  let mut i = 0
  while i < sess.spaces.length() {
    let sp = sess.spaces[i]
    sp_parts.push(
      "{\"id\":" +
      omni_json_escape(sp.id) +
      ",\"name\":" +
      omni_json_escape(sp.name) +
      ",\"accent\":" +
      omni_json_escape(sp.accent) +
      "}",
    )
    i = i + 1
  }
  let fl_parts : Array[String] = []
  let mut fi = 0
  while fi < sess.folders.length() {
    let fl = sess.folders[fi]
    fl_parts.push(
      "{\"id\":" +
      omni_json_escape(fl.id) +
      ",\"spaceId\":" +
      omni_json_escape(fl.space_id) +
      ",\"name\":" +
      omni_json_escape(fl.name) +
      ",\"color\":" +
      omni_json_escape(normalize_folder_color(fl.color)) +
      ",\"collapsed\":" +
      (if fl.collapsed { "true" } else { "false" }) +
      "}",
    )
    fi = fi + 1
  }
  let tb_parts : Array[String] = []
  let mut ti = 0
  while ti < sess.tabs.length() {
    let tb = sess.tabs[ti]
    tb_parts.push(
      "{\"spaceId\":" +
      omni_json_escape(tb.space_id) +
      ",\"title\":" +
      omni_json_escape(tb.title) +
      ",\"url\":" +
      omni_json_escape(tb.url) +
      ",\"pinned\":" +
      (if tb.pinned { "true" } else { "false" }) +
      ",\"favorite\":" +
      (if tb.favorite { "true" } else { "false" }) +
      ",\"folderId\":" +
      omni_json_escape(tb.folder_id) +
      "}",
    )
    ti = ti + 1
  }
  "{\"id\":" +
  omni_json_escape(sess.id) +
  ",\"name\":" +
  omni_json_escape(sess.name) +
  ",\"createdSecs\":" +
  (if sess.created_secs < 0L { 0L } else { sess.created_secs }).to_string() +
  ",\"activeSpaceId\":" +
  omni_json_escape(sess.active_space_id) +
  ",\"spaces\":[" +
  sp_parts.join(",") +
  "],\"folders\":[" +
  fl_parts.join(",") +
  "],\"tabs\":[" +
  tb_parts.join(",") +
  "]}"
}

pub fn encode_saved_sessions_state(state : SavedSessionsState) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < state.items.length() {
    parts.push(encode_named_session(state.items[i]))
    i = i + 1
  }
  "{\"items\":[" + parts.join(",") + "]}"
}

fn rs_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

fn rs_parse_session_space(p : OmniJsonParser) -> Option[SessionSpaceItem] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut name = ""
  let mut accent = "#2563EB"
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SessionSpaceItem::{ id, name, accent })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "accent" {
      match p.parse_str() {
        Some(v) => accent = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SessionSpaceItem::{ id, name, accent })
    } else {
      return None
    }
  }
  None
}

fn rs_parse_session_folder(p : OmniJsonParser) -> Option[SessionFolderItem] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut space_id = ""
  let mut name = ""
  let mut color = "blue"
  let mut collapsed = false
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SessionFolderItem::{ id, space_id, name, color, collapsed })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "spaceId" || key == "space_id" {
      match p.parse_str() {
        Some(v) => space_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "color" {
      match p.parse_str() {
        Some(v) => color = normalize_folder_color(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "collapsed" {
      match rs_parse_bool(p) {
        Some(v) => collapsed = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SessionFolderItem::{ id, space_id, name, color, collapsed })
    } else {
      return None
    }
  }
  None
}

fn rs_parse_session_tab(p : OmniJsonParser) -> Option[SessionTabItem] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut space_id = ""
  let mut title = ""
  let mut url = ""
  let mut pinned = false
  let mut favorite = false
  let mut folder_id = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SessionTabItem::{ space_id, title, url, pinned, favorite, folder_id })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "spaceId" || key == "space_id" {
      match p.parse_str() {
        Some(v) => space_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "pinned" {
      match rs_parse_bool(p) {
        Some(v) => pinned = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "favorite" {
      match rs_parse_bool(p) {
        Some(v) => favorite = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "folderId" || key == "folder_id" {
      match p.parse_str() {
        Some(v) => folder_id = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SessionTabItem::{ space_id, title, url, pinned, favorite, folder_id })
    } else {
      return None
    }
  }
  None
}

fn rs_parse_named_session(p : OmniJsonParser) -> Option[NamedSessionSnapshot] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut name = ""
  let mut created_secs : Int64 = 0L
  let mut active_space_id = ""
  let spaces : Array[SessionSpaceItem] = []
  let folders : Array[SessionFolderItem] = []
  let tabs : Array[SessionTabItem] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(NamedSessionSnapshot::{ id, name, created_secs, active_space_id, spaces, folders, tabs })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "createdSecs" || key == "created_secs" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int64()
          created_secs = if iv < 0L { 0L } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "activeSpaceId" || key == "active_space_id" {
      match p.parse_str() {
        Some(v) => active_space_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "spaces" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match rs_parse_session_space(p) {
            Some(sp) => if sp.id != "" { spaces.push(sp) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "folders" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match rs_parse_session_folder(p) {
            Some(fl) => if fl.id != "" { folders.push(fl) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "tabs" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match rs_parse_session_tab(p) {
            Some(tb) => tabs.push(tb)
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(NamedSessionSnapshot::{ id, name, created_secs, active_space_id, spaces, folders, tabs })
    } else {
      return None
    }
  }
  None
}

///| Parses a `SavedSessionsState` JSON payload from `wire::Message::SessionsState` or disk.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_saved_sessions_state(
  json : String,
  max_items~ : Int = SAVED_SESSIONS_MAX_ITEMS,
) -> Option[SavedSessionsState] {
  let limit = if max_items > 0 { max_items } else { SAVED_SESSIONS_MAX_ITEMS }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let items : Array[NamedSessionSnapshot] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SavedSessionsState::{ items })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "items" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match rs_parse_named_session(p) {
            Some(it) => if it.id != "" && items.length() < limit { items.push(it) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SavedSessionsState::{ items })
    } else {
      return None
    }
  }
  None
}
