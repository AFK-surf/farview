///| Pure-Pion portable Browser Settings model (`BrowserSettings`), fault-tolerant JSON codec,
///| 5-engine search URL builder (`google | duckduckgo | kagi | perplexity | bing`),
///| and HTTPS-Only external URL upgrade helper shared by `pion-host` and `pion-app`.

pub let SETTINGS_ZOOM_MIN_PCT : Int = 75
pub let SETTINGS_ZOOM_MAX_PCT : Int = 150
pub let SETTINGS_ZOOM_DEFAULT_PCT : Int = 100

pub struct BrowserSettings {
  pub search_engine : String
  pub chrome_theme : String
  pub default_zoom_pct : Int
  pub compact_sidebar : Bool
  pub https_only : Bool
  pub block_third_party_cookies : Bool
  pub send_dnt : Bool
  pub auto_archive_hours : Int
  ///| Translucent (Liquid Glass) floating panels; off draws them solid.
  pub glass : Bool
  ///| The docked sidebar's width dragged at its edge (pt); 0 keeps the default (and `compact_sidebar`'s).
  pub sidebar_width : Double
  ///| Each site's own page zoom (`site_zoom.pion`): `host=pct` entries, the most recently set last.
  pub site_zoom : String
  ///| Suggestions from the search engine as the person types in the address palette (what is typed goes to the
  ///| engine, as in Chrome and Safari); off keeps typing on this device.
  pub search_suggest : Bool
  ///| Sites taken off the Start page's Frequently visited (their canonical addresses; history keeps them).
  pub start_hidden : Array[String]
  ///| Little Arc settings (Arc-style quick floating lookup window).
  pub little_arc_shortcut : Bool
  pub little_arc_opt_click : Bool
  pub little_arc_external_links : Bool
  pub little_arc_archive_hours : Int
  ///| Peek preview settings (Shift-click or external links from Favorites/Pinned).
  pub peek_shift_click : Bool
  pub peek_external_sites : Bool
}

pub let SETTINGS_START_HIDDEN_MOST : Int = 64

///| The widths the sidebar edge can be dragged to (pt).
pub let SETTINGS_SIDEBAR_W_MIN : Double = 180.0

pub let SETTINGS_SIDEBAR_W_MAX : Double = 480.0

///| A dragged sidebar width kept within range; under the minimum (0) is no width of its own.
pub fn clamp_sidebar_width(w : Double) -> Double {
  if w != w || w < SETTINGS_SIDEBAR_W_MIN {
    0.0
  } else if w > SETTINGS_SIDEBAR_W_MAX {
    SETTINGS_SIDEBAR_W_MAX
  } else {
    math_floor(w + 0.5)
  }
}

pub fn BrowserSettings::default() -> BrowserSettings {
  BrowserSettings::{
    search_engine: "google",
    chrome_theme: "system",
    default_zoom_pct: SETTINGS_ZOOM_DEFAULT_PCT,
    compact_sidebar: false,
    https_only: false,
    block_third_party_cookies: true,
    send_dnt: false,
    auto_archive_hours: 24,
    glass: false,
    sidebar_width: 0.0,
    site_zoom: "",
    search_suggest: true,
    start_hidden: [],
    little_arc_shortcut: true,
    little_arc_opt_click: true,
    little_arc_external_links: false,
    little_arc_archive_hours: 6,
    peek_shift_click: true,
    peek_external_sites: true,
  }
}

pub fn normalize_search_engine(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "google" || s == "duckduckgo" || s == "kagi" || s == "perplexity" || s == "bing" {
    s
  } else {
    "google"
  }
}

///| The browser's appearance as the person chose it: "light", "dark", or "system" (the default: as the system's
///| appearance is now, switching with it). "auto" is "system"; anything else is the default.
pub fn normalize_chrome_theme(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "dark" {
    "dark"
  } else if s == "light" {
    "light"
  } else {
    "system"
  }
}

///| Whether the browser is drawn dark under `theme` (`normalize_chrome_theme`'s) while the system's appearance is
///| `system_dark`.
pub fn chrome_theme_is_dark(theme : String, system_dark : Bool) -> Bool {
  let t = normalize_chrome_theme(theme)
  t == "dark" || (t == "system" && system_dark)
}

///| The theme's name as Settings shows it.
pub fn chrome_theme_label(theme : String) -> String {
  let t = normalize_chrome_theme(theme)
  if t == "dark" {
    "Dark"
  } else if t == "light" {
    "Light"
  } else {
    "Auto"
  }
}

pub fn clamp_default_zoom_pct(pct : Int) -> Int {
  if pct < SETTINGS_ZOOM_MIN_PCT {
    SETTINGS_ZOOM_MIN_PCT
  } else if pct > SETTINGS_ZOOM_MAX_PCT {
    SETTINGS_ZOOM_MAX_PCT
  } else {
    pct
  }
}

pub fn normalize_auto_archive_hours(hours : Int) -> Int {
  if hours == 0 || hours == 12 || hours == 24 || hours == 168 || hours == 720 {
    hours
  } else {
    24
  }
}

pub fn normalize_little_arc_archive_hours(hours : Int) -> Int {
  if hours == 0 || hours == 1 || hours == 6 || hours == 12 || hours == 24 {
    hours
  } else {
    6
  }
}

pub fn normalize_browser_settings(s : BrowserSettings) -> BrowserSettings {
  BrowserSettings::{
    search_engine: normalize_search_engine(s.search_engine),
    chrome_theme: normalize_chrome_theme(s.chrome_theme),
    default_zoom_pct: clamp_default_zoom_pct(s.default_zoom_pct),
    compact_sidebar: s.compact_sidebar,
    https_only: s.https_only,
    block_third_party_cookies: s.block_third_party_cookies,
    send_dnt: s.send_dnt,
    auto_archive_hours: normalize_auto_archive_hours(s.auto_archive_hours),
    glass: s.glass,
    sidebar_width: clamp_sidebar_width(s.sidebar_width),
    site_zoom: normalize_site_zoom(s.site_zoom),
    search_suggest: s.search_suggest,
    start_hidden: normalize_start_hidden(s.start_hidden),
    little_arc_shortcut: s.little_arc_shortcut,
    little_arc_opt_click: s.little_arc_opt_click,
    little_arc_external_links: s.little_arc_external_links,
    little_arc_archive_hours: normalize_little_arc_archive_hours(s.little_arc_archive_hours),
    peek_shift_click: s.peek_shift_click,
    peek_external_sites: s.peek_external_sites,
  }
}

///| The hidden Start page sites: trimmed, non-empty, each once, the latest `SETTINGS_START_HIDDEN_MOST`.
pub fn normalize_start_hidden(xs : Array[String]) -> Array[String] {
  let out : Array[String] = []
  for x in xs {
    let t = x.trim()
    if t != "" && !out.contains(t) {
      out.push(t)
    }
  }
  if out.length() <= SETTINGS_START_HIDDEN_MOST {
    return out
  }
  let kept : Array[String] = []
  let mut i = out.length() - SETTINGS_START_HIDDEN_MOST
  while i < out.length() {
    kept.push(out[i])
    i = i + 1
  }
  kept
}

pub fn search_engine_label(engine : String) -> String {
  let e = normalize_search_engine(engine)
  if e == "duckduckgo" {
    "DuckDuckGo"
  } else if e == "kagi" {
    "Kagi"
  } else if e == "perplexity" {
    "Perplexity"
  } else if e == "bing" {
    "Bing"
  } else {
    "Google"
  }
}

pub fn search_engine_host(engine : String) -> String {
  let e = normalize_search_engine(engine)
  if e == "duckduckgo" {
    "duckduckgo.com"
  } else if e == "kagi" {
    "kagi.com"
  } else if e == "perplexity" {
    "perplexity.ai"
  } else if e == "bing" {
    "bing.com"
  } else {
    "google.com"
  }
}

pub fn search_engine_monogram(engine : String) -> String {
  let e = normalize_search_engine(engine)
  if e == "duckduckgo" {
    "D"
  } else if e == "kagi" {
    "K"
  } else if e == "perplexity" {
    "P"
  } else if e == "bing" {
    "B"
  } else {
    "G"
  }
}

pub fn build_search_url(engine : String, query : String) -> String {
  let e = normalize_search_engine(engine)
  let q = omni_percent_encode(query.trim())
  if e == "duckduckgo" {
    "https://duckduckgo.com/?q=" + q
  } else if e == "kagi" {
    "https://kagi.com/search?q=" + q
  } else if e == "perplexity" {
    "https://www.perplexity.ai/search?q=" + q
  } else if e == "bing" {
    "https://www.bing.com/search?q=" + q
  } else {
    "https://www.google.com/search?q=" + q
  }
}

fn settings_is_local_authority(rest : String) -> Bool {
  let lower = omni_ascii_lower(rest)
  omni_is_local_host(lower) ||
  lower == "[::1]" ||
  lower.starts_with("[::1]:") ||
  lower.starts_with("[::1]/")
}

///| Upgrades `http://` external URLs to `https://` when HTTPS-Only Mode is enabled.
///| Preserves `localhost`, `127.0.0.1`, `0.0.0.0`, and `[::1]` unchanged.
pub fn apply_https_only(raw_url : String, enabled : Bool) -> String {
  if !enabled {
    return raw_url
  }
  let s = raw_url.trim()
  let lower = omni_ascii_lower(s)
  if !lower.starts_with("http://") {
    return s
  }
  let rest = s.slice(7, s.length())
  if rest == "" || settings_is_local_authority(rest) {
    s
  } else {
    "https://" + rest
  }
}

///| Normalizes raw address bar input into a navigable URL or search query URL
///| using the configured `search_engine` and optional `https_only` upgrade.
pub fn omnibox_normalize_input_with_engine(
  raw : String,
  engine : String,
  https_only~ : Bool = false,
) -> String {
  match match_site_search(raw) {
    Some(ss) => return ss.url
    None => ()
  }
  let s = raw.trim()
  if s == "" {
    return ""
  }
  let lower = omni_ascii_lower(s)
  if lower.starts_with("http://") ||
  lower.starts_with("https://") ||
  lower.starts_with("file://") ||
  lower.starts_with("about:") ||
  lower.starts_with("data:") ||
  lower.starts_with("javascript:") ||
  lower.starts_with("blob:") ||
  lower.starts_with("ws://") ||
  lower.starts_with("wss://") ||
  lower.starts_with("view-source:") {
    return apply_https_only(s, https_only)
  }
  if s.starts_with("//") {
    return "https:" + s
  }
  if omni_is_local_host(lower) {
    return "http://" + s
  }
  let mut has_space = false
  let mut has_dot = false
  let mut i = 0
  while i < s.length() {
    let cu = s.code_unit_at(i).to_int()
    if cu == 32 || cu == 9 || cu == 10 || cu == 13 {
      has_space = true
      break
    }
    if cu == 46 {
      has_dot = true
    }
    i = i + 1
  }
  if !has_space && has_dot {
    "https://" + s
  } else {
    build_search_url(engine, s)
  }
}

fn settings_json_strings(xs : Array[String]) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(omni_json_escape(xs[i]))
    i = i + 1
  }
  sb.to_string()
}

pub fn encode_browser_settings(raw : BrowserSettings) -> String {
  let s = normalize_browser_settings(raw)
  "{\"searchEngine\":" +
  omni_json_escape(s.search_engine) +
  ",\"chromeTheme\":" +
  omni_json_escape(s.chrome_theme) +
  ",\"defaultZoomPct\":" +
  s.default_zoom_pct.to_string() +
  ",\"compactSidebar\":" +
  (if s.compact_sidebar { "true" } else { "false" }) +
  ",\"httpsOnly\":" +
  (if s.https_only { "true" } else { "false" }) +
  ",\"blockThirdPartyCookies\":" +
  (if s.block_third_party_cookies { "true" } else { "false" }) +
  ",\"sendDnt\":" +
  (if s.send_dnt { "true" } else { "false" }) +
  ",\"autoArchiveHours\":" +
  s.auto_archive_hours.to_string() +
  ",\"glass\":" +
  (if s.glass { "true" } else { "false" }) +
  ",\"sidebarWidth\":" +
  s.sidebar_width.to_int().to_string() +
  ",\"siteZoom\":" +
  omni_json_escape(s.site_zoom) +
  ",\"searchSuggest\":" +
  (if s.search_suggest { "true" } else { "false" }) +
  ",\"startHidden\":[" +
  settings_json_strings(s.start_hidden) +
  "],\"littleArcShortcut\":" +
  (if s.little_arc_shortcut { "true" } else { "false" }) +
  ",\"littleArcOptClick\":" +
  (if s.little_arc_opt_click { "true" } else { "false" }) +
  ",\"littleArcExternalLinks\":" +
  (if s.little_arc_external_links { "true" } else { "false" }) +
  ",\"littleArcArchiveHours\":" +
  s.little_arc_archive_hours.to_string() +
  ",\"peekShiftClick\":" +
  (if s.peek_shift_click { "true" } else { "false" }) +
  ",\"peekExternalSites\":" +
  (if s.peek_external_sites { "true" } else { "false" }) +
  "}"
}

fn settings_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

///| Parses a `BrowserSettings` JSON payload from `wire::Message::SettingsState` or `settings.json`.
///| Invalid or out-of-range field values safely fall back to defaults; malformed/truncated JSON returns `None`.
pub fn parse_browser_settings(json : String) -> Option[BrowserSettings] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let def = BrowserSettings::default()
  let mut search_engine = def.search_engine
  let mut chrome_theme = def.chrome_theme
  let mut default_zoom_pct = def.default_zoom_pct
  let mut compact_sidebar = def.compact_sidebar
  let mut https_only = def.https_only
  let mut block_third_party_cookies = def.block_third_party_cookies
  let mut send_dnt = def.send_dnt
  let mut auto_archive_hours = def.auto_archive_hours
  let mut glass = def.glass
  let mut sidebar_width = def.sidebar_width
  let mut site_zoom = def.site_zoom
  let mut search_suggest = def.search_suggest
  let start_hidden : Array[String] = []
  let mut little_arc_shortcut = def.little_arc_shortcut
  let mut little_arc_opt_click = def.little_arc_opt_click
  let mut little_arc_external_links = def.little_arc_external_links
  let mut little_arc_archive_hours = def.little_arc_archive_hours
  let mut peek_shift_click = def.peek_shift_click
  let mut peek_external_sites = def.peek_external_sites
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(
      normalize_browser_settings(
        BrowserSettings::{
          search_engine,
          chrome_theme,
          default_zoom_pct,
          compact_sidebar,
          https_only,
          block_third_party_cookies,
          send_dnt,
          auto_archive_hours,
          glass,
          sidebar_width,
          site_zoom,
          search_suggest,
          start_hidden,
          little_arc_shortcut,
          little_arc_opt_click,
          little_arc_external_links,
          little_arc_archive_hours,
          peek_shift_click,
          peek_external_sites,
        },
      ),
    )
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "searchEngine" || key == "search_engine" {
      match p.parse_str() {
        Some(v) => search_engine = normalize_search_engine(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "chromeTheme" || key == "chrome_theme" {
      match p.parse_str() {
        Some(v) => chrome_theme = normalize_chrome_theme(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "defaultZoomPct" || key == "default_zoom_pct" {
      match p.parse_number() {
        Some(v) => default_zoom_pct = clamp_default_zoom_pct(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "compactSidebar" || key == "compact_sidebar" {
      match settings_parse_bool(p) {
        Some(b) => compact_sidebar = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "httpsOnly" || key == "https_only" {
      match settings_parse_bool(p) {
        Some(b) => https_only = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "blockThirdPartyCookies" || key == "block_third_party_cookies" {
      match settings_parse_bool(p) {
        Some(b) => block_third_party_cookies = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "sendDnt" || key == "send_dnt" {
      match settings_parse_bool(p) {
        Some(b) => send_dnt = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "glass" {
      match settings_parse_bool(p) {
        Some(b) => glass = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "siteZoom" || key == "site_zoom" {
      match p.parse_str() {
        Some(v) => site_zoom = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "searchSuggest" || key == "search_suggest" {
      match settings_parse_bool(p) {
        Some(b) => search_suggest = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "startHidden" || key == "start_hidden" {
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5B {
        p.i = p.i + 1
        p.skip_ws()
        while p.i < p.n && p.s.code_unit_at(p.i).to_int() != 0x5D {
          match p.parse_str() {
            Some(u) => start_hidden.push(u)
            None => if !p.skip_value() { return None }
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
            p.skip_ws()
          }
        }
        if p.i >= p.n {
          return None
        }
        p.i = p.i + 1
      } else if !p.skip_value() {
        return None
      }
    } else if key == "sidebarWidth" || key == "sidebar_width" {
      match p.parse_number() {
        Some(v) => sidebar_width = clamp_sidebar_width(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "autoArchiveHours" || key == "auto_archive_hours" {
      match p.parse_number() {
        Some(v) => auto_archive_hours = normalize_auto_archive_hours(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "littleArcShortcut" || key == "little_arc_shortcut" {
      match settings_parse_bool(p) {
        Some(b) => little_arc_shortcut = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "littleArcOptClick" || key == "little_arc_opt_click" {
      match settings_parse_bool(p) {
        Some(b) => little_arc_opt_click = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "littleArcExternalLinks" || key == "little_arc_external_links" {
      match settings_parse_bool(p) {
        Some(b) => little_arc_external_links = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "littleArcArchiveHours" || key == "little_arc_archive_hours" {
      match p.parse_number() {
        Some(v) => little_arc_archive_hours = normalize_little_arc_archive_hours(math_floor(v + 0.5).to_int())
        None => if !p.skip_value() { return None }
      }
    } else if key == "peekShiftClick" || key == "peek_shift_click" {
      match settings_parse_bool(p) {
        Some(b) => peek_shift_click = b
        None => if !p.skip_value() { return None }
      }
    } else if key == "peekExternalSites" || key == "peek_external_sites" {
      match settings_parse_bool(p) {
        Some(b) => peek_external_sites = b
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(
        normalize_browser_settings(
          BrowserSettings::{
            search_engine,
            chrome_theme,
            default_zoom_pct,
            compact_sidebar,
            https_only,
            block_third_party_cookies,
            send_dnt,
            auto_archive_hours,
            glass,
            sidebar_width,
            site_zoom,
            search_suggest,
            start_hidden,
            little_arc_shortcut,
            little_arc_opt_click,
            little_arc_external_links,
            little_arc_archive_hours,
            peek_shift_click,
            peek_external_sites,
          },
        ),
      )
    } else {
      return None
    }
  }
  None
}
