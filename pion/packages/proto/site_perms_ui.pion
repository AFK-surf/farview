///| Pure-Pion portable Site Permissions model (`SitePermissionRule`, `SitePermissionsSnapshot`),
///| fault-tolerant JSON codec, origin normalization, Start Page URL detection, and
///| Start Page Quick Access tile builder shared by `pion-host` and `pion-app`.

pub let START_PAGE_MAX_TILES : Int = 8

pub struct SitePermissionRule {
  pub origin : String
  pub camera : String
  pub microphone : String
  pub notifications : String
  pub geolocation : String
  pub clipboard : String
}

pub struct SitePermissionsSnapshot {
  pub rules : Array[SitePermissionRule]
}

pub struct StartPageTile {
  pub url : String
  pub title : String
  pub host : String
  pub monogram : String
  pub accent : Int64
  pub is_bookmark : Bool
  pub visit_count : Int
}

pub fn SitePermissionRule::default_for(origin : String) -> SitePermissionRule {
  SitePermissionRule::{
    origin: normalize_permission_origin(origin),
    camera: "ask",
    microphone: "ask",
    notifications: "ask",
    geolocation: "ask",
    clipboard: "ask",
  }
}

pub fn SitePermissionsSnapshot::empty() -> SitePermissionsSnapshot {
  SitePermissionsSnapshot::{ rules: [] }
}

///| Normalizes a permission state token into `"ask"`, `"allow"`, or `"block"`.
///| Invalid or unknown values safely fall back to `"ask"`.
pub fn normalize_site_perm_value(raw : String) -> String {
  let s = omni_ascii_lower(raw.trim())
  if s == "allow" || s == "granted" {
    "allow"
  } else if s == "block" || s == "blocked" || s == "deny" || s == "denied" {
    "block"
  } else {
    "ask"
  }
}

///| Returns true when `raw_url` represents the browser's native Start Page
///| (`""`, `"about:blank"`, `"about:newtab"`, `"farview://newtab"`).
pub fn is_start_page_url(raw_url : String) -> Bool {
  let mut s = omni_ascii_lower(raw_url.trim())
  while s.length() > 1 && s.ends_with("/") {
    if s == "farview://" {
      break
    }
    s = s.slice(0, s.length() - 1)
  }
  s == "" || s == "about:blank" || s == "about:newtab" || s == "farview://newtab"
}

///| Extracts and normalizes an origin key (`scheme://host[:port]`) from any URL.
///| Lowercases scheme and host, strips path/query/fragment and default ports (`:80` / `:443`).
///| Returns `""` for empty or start-page URLs.
pub fn normalize_permission_origin(raw_url : String) -> String {
  let s = raw_url.trim()
  if s == "" || is_start_page_url(s) {
    return ""
  }
  let low = omni_ascii_lower(s)
  let (scheme, scheme_len, default_port) = if low.starts_with("https://") {
    ("https://", 8, ":443")
  } else if low.starts_with("http://") {
    ("http://", 7, ":80")
  } else {
    return ""
  }
  let mut end_i = low.length()
  let mut i = scheme_len
  while i < low.length() {
    let c = low.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      end_i = i
      break
    }
    i = i + 1
  }
  let mut auth = low.slice(scheme_len, end_i)
  // Strip optional userinfo (`user@host`)
  let mut at_idx = -1
  let mut j = 0
  while j < auth.length() {
    if auth.code_unit_at(j).to_int() == 0x40 {
      at_idx = j
    }
    j = j + 1
  }
  if at_idx >= 0 {
    auth = auth.slice(at_idx + 1, auth.length())
  }
  if auth == "" {
    return ""
  }
  if auth.ends_with(default_port) && auth.length() > default_port.length() {
    auth = auth.slice(0, auth.length() - default_port.length())
  }
  scheme + auth
}

pub fn normalize_site_permission_rule(rule : SitePermissionRule) -> SitePermissionRule {
  SitePermissionRule::{
    origin: normalize_permission_origin(rule.origin),
    camera: normalize_site_perm_value(rule.camera),
    microphone: normalize_site_perm_value(rule.microphone),
    notifications: normalize_site_perm_value(rule.notifications),
    geolocation: normalize_site_perm_value(rule.geolocation),
    clipboard: normalize_site_perm_value(rule.clipboard),
  }
}

pub fn site_perm_rule_has_custom(rule : SitePermissionRule) -> Bool {
  normalize_site_perm_value(rule.camera) != "ask" ||
  normalize_site_perm_value(rule.microphone) != "ask" ||
  normalize_site_perm_value(rule.notifications) != "ask" ||
  normalize_site_perm_value(rule.geolocation) != "ask" ||
  normalize_site_perm_value(rule.clipboard) != "ask"
}

pub fn site_perm_rule_has_active_media(rule : SitePermissionRule) -> Bool {
  normalize_site_perm_value(rule.camera) == "allow" ||
  normalize_site_perm_value(rule.microphone) == "allow"
}

///| Looks up the effective `SitePermissionRule` for a URL or origin,
///| falling back to all `"ask"` when no custom rule exists.
pub fn site_perms_rule_for(snap : SitePermissionsSnapshot, url_or_origin : String) -> SitePermissionRule {
  let origin = normalize_permission_origin(url_or_origin)
  if origin == "" {
    return SitePermissionRule::default_for("")
  }
  let mut i = 0
  while i < snap.rules.length() {
    if normalize_permission_origin(snap.rules[i].origin) == origin {
      return normalize_site_permission_rule(snap.rules[i])
    }
    i = i + 1
  }
  SitePermissionRule::default_for(origin)
}

///| Returns a new `SitePermissionRule` with the named permission kind updated.
pub fn site_perm_rule_with(
  rule : SitePermissionRule,
  kind : String,
  value : String,
) -> SitePermissionRule {
  let k = omni_ascii_lower(kind.trim())
  let v = normalize_site_perm_value(value)
  let base = normalize_site_permission_rule(rule)
  if k == "camera" {
    SitePermissionRule::{ ..base, camera: v }
  } else if k == "microphone" || k == "mic" {
    SitePermissionRule::{ ..base, microphone: v }
  } else if k == "notifications" || k == "notification" {
    SitePermissionRule::{ ..base, notifications: v }
  } else if k == "geolocation" || k == "location" {
    SitePermissionRule::{ ..base, geolocation: v }
  } else if k == "clipboard" || k == "clipboard_read" || k == "clipboard-read" {
    SitePermissionRule::{ ..base, clipboard: v }
  } else {
    base
  }
}

pub fn encode_site_permissions_snapshot(snap : SitePermissionsSnapshot) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < snap.rules.length() {
    let r = normalize_site_permission_rule(snap.rules[i])
    if r.origin != "" {
      parts.push(
        "{\"origin\":" +
        omni_json_escape(r.origin) +
        ",\"camera\":" +
        omni_json_escape(r.camera) +
        ",\"microphone\":" +
        omni_json_escape(r.microphone) +
        ",\"notifications\":" +
        omni_json_escape(r.notifications) +
        ",\"geolocation\":" +
        omni_json_escape(r.geolocation) +
        ",\"clipboard\":" +
        omni_json_escape(r.clipboard) +
        "}",
      )
    }
    i = i + 1
  }
  "{\"rules\":[" + parts.join(",") + "]}"
}

fn sp_parse_rule(p : OmniJsonParser) -> Option[SitePermissionRule] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut origin = ""
  let mut camera = "ask"
  let mut microphone = "ask"
  let mut notifications = "ask"
  let mut geolocation = "ask"
  let mut clipboard = "ask"
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(
      normalize_site_permission_rule(
        SitePermissionRule::{ origin, camera, microphone, notifications, geolocation, clipboard },
      ),
    )
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "origin" || key == "url" {
      match p.parse_str() {
        Some(v) => origin = normalize_permission_origin(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "camera" {
      match p.parse_str() {
        Some(v) => camera = normalize_site_perm_value(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "microphone" || key == "mic" {
      match p.parse_str() {
        Some(v) => microphone = normalize_site_perm_value(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "notifications" || key == "notification" {
      match p.parse_str() {
        Some(v) => notifications = normalize_site_perm_value(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "geolocation" || key == "location" {
      match p.parse_str() {
        Some(v) => geolocation = normalize_site_perm_value(v)
        None => if !p.skip_value() { return None }
      }
    } else if key == "clipboard" || key == "clipboardRead" || key == "clipboard_read" {
      match p.parse_str() {
        Some(v) => clipboard = normalize_site_perm_value(v)
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(
        normalize_site_permission_rule(
          SitePermissionRule::{ origin, camera, microphone, notifications, geolocation, clipboard },
        ),
      )
    } else {
      return None
    }
  }
  None
}

///| Parses a `SitePermissionsSnapshot` JSON payload from `wire::Message::SitePermissionsState`
///| or `site_permissions.json`. Invalid permission values safely fall back to `"ask"`;
///| malformed or truncated JSON returns `None` without panicking.
pub fn parse_site_permissions_snapshot(
  json : String,
  max_items~ : Int = 256,
) -> Option[SitePermissionsSnapshot] {
  let limit = if max_items > 0 { max_items } else { 256 }
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let rules : Array[SitePermissionRule] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SitePermissionsSnapshot::{ rules })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "rules" || key == "items" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match sp_parse_rule(p) {
            Some(r) => if r.origin != "" && rules.length() < limit { rules.push(r) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SitePermissionsSnapshot::{ rules })
    } else {
      return None
    }
  }
  None
}

fn start_page_tile_accent(host : String) -> Int64 {
  let palette : Array[Int64] = [
    0x2563EBFFL, // Cobalt
    0x0EA5E9FFL, // Sky
    0x10B981FFL, // Emerald
    0x8B5CF6FFL, // Violet
    0xF59E0BFFL, // Amber
    0xEC4899FFL, // Rose
    0x06B6D4FFL, // Cyan
    0x6366F1FFL, // Indigo
  ]
  let low = omni_ascii_lower(host)
  let mut h = 2166136261
  let mut i = 0
  while i < low.length() {
    h = (h ^ low.code_unit_at(i).to_int()) * 16777619
    i = i + 1
  }
  let idx = if h < 0 { (0 - h) % palette.length() } else { h % palette.length() }
  palette[idx]
}

fn start_page_clean_host(url : String) -> String {
  let h = history_url_host(url)
  if h.starts_with("www.") && h.length() > 4 {
    h.slice(4, h.length())
  } else {
    h
  }
}

fn start_page_find_canon(tiles : Array[StartPageTile], canon : String) -> Int {
  let mut i = 0
  while i < tiles.length() {
    if bookmark_canonical_url(tiles[i].url) == canon {
      return i
    }
    i = i + 1
  }
  -1
}

///| Builds Quick Access speed-dial tiles for the native Start Page by merging real
///| bookmarks and high-frequency browsing history (deduplicated by canonical URL).
///| Whether a site the person took off Frequently visited (`BrowserSettings::start_hidden`) is `canon`.
fn start_page_hidden(hidden : Array[String], canon : String) -> Bool {
  for h in hidden {
    if bookmark_canonical_url(h) == canon {
      return true
    }
  }
  false
}

///| What hides a Start page tile (a Favorite or a Frequently visited site): its canonical address
///| (`BrowserSettings::start_hidden`).
pub fn start_page_hide_key(url : String) -> String {
  bookmark_canonical_url(url.trim())
}

pub fn build_start_page_tiles(
  bookmarks : Array[BookmarkEntry],
  history : Array[HistoryItemSummary],
  max_tiles : Int,
  hidden~ : Array[String] = [],
) -> Array[StartPageTile] {
  let cap = if max_tiles > 0 { max_tiles } else { START_PAGE_MAX_TILES }
  let out : Array[StartPageTile] = []

  // 1. Add real bookmarks first (skipping blank/start-page URLs, deduplicated)
  let mut bi = 0
  while bi < bookmarks.length() && out.length() < cap {
    let bm = bookmarks[bi]
    let u = bm.url.trim()
    if u != "" && !is_start_page_url(u) {
      let canon = bookmark_canonical_url(u)
      // (a Favorite taken off the Start page keeps its bookmark: only the tile goes)
      if canon != "" && start_page_find_canon(out, canon) < 0 && !start_page_hidden(hidden, canon) {
        let host = start_page_clean_host(u)
        let title = if bm.title.trim() != "" { bm.title.trim() } else { host }
        out.push(StartPageTile::{
          url: u,
          title: title,
          host: host,
          monogram: omnibox_initial_letter(u, title),
          accent: start_page_tile_accent(host),
          is_bookmark: true,
          visit_count: 0,
        })
      }
    }
    bi = bi + 1
  }

  // 2. Sort a copy of history by visit_count desc, then last_visit_secs desc
  let sorted_hist : Array[HistoryItemSummary] = []
  let mut hi = 0
  while hi < history.length() {
    sorted_hist.push(history[hi])
    hi = hi + 1
  }
  let mut si = 1
  while si < sorted_hist.length() {
    let cur = sorted_hist[si]
    let mut j = si - 1
    while j >= 0 {
      let prev = sorted_hist[j]
      let better = cur.visit_count > prev.visit_count ||
      (cur.visit_count == prev.visit_count && cur.last_visit_secs > prev.last_visit_secs)
      if better {
        sorted_hist[j + 1] = prev
        j = j - 1
      } else {
        break
      }
    }
    sorted_hist[j + 1] = cur
    si = si + 1
  }

  // 3. Merge high-frequency history into remaining slots (and backfill visit_count on bookmarks)
  let mut k = 0
  while k < sorted_hist.length() {
    let h = sorted_hist[k]
    let u = h.url.trim()
    if u != "" && !is_start_page_url(u) {
      let canon = bookmark_canonical_url(u)
      if canon != "" {
        let prev_idx = start_page_find_canon(out, canon)
        let vc = if h.visit_count > 0 { h.visit_count } else { 1 }
        if prev_idx >= 0 {
          if out[prev_idx].visit_count == 0 {
            out[prev_idx] = StartPageTile::{ ..out[prev_idx], visit_count: vc }
          }
        } else if out.length() < cap && !start_page_hidden(hidden, canon) {
          let host = start_page_clean_host(u)
          let title = if h.title.trim() != "" { h.title.trim() } else { host }
          out.push(StartPageTile::{
            url: u,
            title: title,
            host: host,
            monogram: omnibox_initial_letter(u, title),
            accent: start_page_tile_accent(host),
            is_bookmark: false,
            visit_count: vc,
          })
        }
      }
    }
    k = k + 1
  }
  out
}
