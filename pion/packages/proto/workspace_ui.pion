    } else if key == "screenCapture" || key == "screen_capture" {
      match p.parse_str() {
        Some(v) => screen_capture = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "clipboardRead" || key == "clipboard_read" {
      match p.parse_str() {
        Some(v) => clipboard_read = v
