fn ws_parse_media(p : OmniJsonParser) -> Option[MediaMiniState] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut tab_id = ""
  let mut title = ""
  let mut host = ""
  let mut playing = true
  let mut muted = false
  let mut is_meeting = false
  let mut accent = "#2563EB"
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(MediaMiniState::{ tab_id, title, host, playing, muted, is_meeting, accent })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "tabId" || key == "tab_id" {
      match p.parse_str() {
        Some(v) => tab_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "host" {
      match p.parse_str() {
        Some(v) => host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "playing" {
      match ws_parse_bool(p) {
        Some(v) => playing = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "muted" {
      match ws_parse_bool(p) {
        Some(v) => muted = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "isMeeting" || key == "is_meeting" {
      match ws_parse_bool(p) {
        Some(v) => is_meeting = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "accent" {
      match p.parse_str() {
        Some(v) => accent = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(MediaMiniState::{ tab_id, title, host, playing, muted, is_meeting, accent })
    } else {
      return None
    }
  }
  None
}

fn ws_parse_nav_entry(p : OmniJsonParser) -> Option[NavHistoryEntry] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut index = 0
  let mut title = ""
  let mut url = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(NavHistoryEntry::{ index, title, url })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "index" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          index = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" {
      match p.parse_str() {
        Some(v) => title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(NavHistoryEntry::{ index, title, url })
    } else {
      return None
    }
  }
  None
}

fn ws_parse_nav_list(p : OmniJsonParser, out : Array[NavHistoryEntry]) -> Bool {
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
    return false
  }
  p.i = p.i + 1
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
    p.i = p.i + 1
    return true
  }
  while p.i < p.n {
    match ws_parse_nav_entry(p) {
      Some(e) => if e.url != "" { out.push(e) }
      None => return false
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
      p.i = p.i + 1
      return true
    } else {
      return false
    }
  }
  false
}

///| Parses a `WorkspaceSnapshot` JSON payload from `wire::Message::WorkspaceState`.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_workspace_snapshot(json : String) -> Option[WorkspaceSnapshot] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut active_space_id = ""
  let mut active_tab_id = ""
  let spaces : Array[SpaceSummary] = []
  let folders : Array[FolderSummary] = []
  let tabs : Array[TabSummary] = []
  let mut permissions : Option[SitePermSummary] = None
  let mut closed_count = 0
  let mut media : Option[MediaMiniState] = None
  let nav_back : Array[NavHistoryEntry] = []
  let nav_forward : Array[NavHistoryEntry] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(WorkspaceSnapshot::{ active_space_id, active_tab_id, spaces, folders, tabs, permissions, closed_count, media, nav_back, nav_forward })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "activeSpaceId" || key == "active_space_id" {
      match p.parse_str() {
        Some(v) => active_space_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "activeTabId" || key == "active_tab_id" {
      match p.parse_str() {
        Some(v) => active_tab_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "spaces" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match ws_parse_space(p) {
            Some(sp) => if sp.id != "" { spaces.push(sp) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "folders" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match ws_parse_folder(p) {
            Some(fl) => if fl.id != "" { folders.push(fl) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "tabs" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match ws_parse_tab(p) {
            Some(tb) => if tb.id != "" { tabs.push(tb) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "permissions" {
      if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "null" {
        p.i = p.i + 4
        permissions = None
      } else {
        match ws_parse_perms(p) {
          Some(pm) => if pm.origin != "" { permissions = Some(pm) }
          None => return None
        }
      }
    } else if key == "closedCount" || key == "closed_count" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          closed_count = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if key == "media" {
      if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "null" {
        p.i = p.i + 4
        media = None
      } else {
        match ws_parse_media(p) {
          Some(m) => if m.tab_id != "" || m.title != "" || m.host != "" { media = Some(m) }
          None => return None
        }
      }
    } else if key == "navBack" || key == "nav_back" {
      if !ws_parse_nav_list(p, nav_back) {
        return None
      }
    } else if key == "navForward" || key == "nav_forward" {
      if !ws_parse_nav_list(p, nav_forward) {
        return None
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(WorkspaceSnapshot::{ active_space_id, active_tab_id, spaces, folders, tabs, permissions, closed_count, media, nav_back, nav_forward })
    } else {
      return None
    }
  }
  None
}

///| Returns the active `SpaceSummary` in `snap`, falling back to the first space if none is marked active.
pub fn workspace_active_space(snap : WorkspaceSnapshot) -> Option[SpaceSummary] {
  let mut i = 0
  while i < snap.spaces.length() {
    if snap.spaces[i].id == snap.active_space_id || snap.spaces[i].active {
      return Some(snap.spaces[i])
    }
    i = i + 1
  }
  if snap.spaces.length() > 0 {
    Some(snap.spaces[0])
  } else {
    None
  }
}

///| Returns all cross-Space Favorite tabs (`favorite = true`).
pub fn workspace_favorite_tabs(snap : WorkspaceSnapshot) -> Array[TabSummary] {
  let out : Array[TabSummary] = []
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if t.favorite {
      out.push(t)
    }
    i = i + 1
  }
  out
}

///| Filters non-Favorite tabs in `space_id` by Pinned (`pinned = true`) or Today (`pinned = false`).
pub fn workspace_tabs_for_space(
  snap : WorkspaceSnapshot,
  space_id : String,
  pinned : Bool,
) -> Array[TabSummary] {
  let out : Array[TabSummary] = []
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if !t.favorite && t.space_id == space_id && t.pinned == pinned {
      out.push(t)
    }
    i = i + 1
  }
  out
}

///| Returns all tabs in `space_id` ordered Pinned first, then Today (matches `Cmd/Ctrl+1..9` order).
pub fn workspace_space_tabs(
  snap : WorkspaceSnapshot,
  space_id : String,
) -> Array[TabSummary] {
  let out = workspace_tabs_for_space(snap, space_id, true)
  let today = workspace_tabs_for_space(snap, space_id, false)
  let mut i = 0
  while i < today.length() {
    out.push(today[i])
    i = i + 1
  }
  out
}

///| Returns active tabs in `space_id` sorted by `last_active_secs` descending (MRU order).
///| Tie-breakers: active tab first, then original order.
pub fn workspace_mru_tabs(
  snap : WorkspaceSnapshot,
  space_id : String,
) -> Array[TabSummary] {
  let out : Array[TabSummary] = []
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if space_id == "" || t.space_id == space_id {
      out.push(t)
    }
    i = i + 1
  }
  // Stable insertion sort by last_active_secs descending (tie-break: active first)
  let mut s = 1
  while s < out.length() {
    let key = out[s]
    let mut k = s - 1
    while k >= 0 && (
      out[k].last_active_secs < key.last_active_secs ||
      (out[k].last_active_secs == key.last_active_secs && !out[k].active && key.active)
    ) {
      out[k + 1] = out[k]
      k = k - 1
    }
    out[k + 1] = key
    s = s + 1
  }
  out
}

///| Returns true when `tab` matches the sidebar inline filter query (case-insensitive substring on title, host, or URL).
pub fn workspace_tab_matches_filter(tab : TabSummary, raw_query : String) -> Bool {
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    return true
  }
  if omni_ascii_lower(tab.title).contains(q) {
    return true
  }
  if omni_ascii_lower(tab.url).contains(q) {
    return true
  }
  omni_ascii_lower(omnibox_display_host(tab.url)).contains(q)
}

///| Filters a list of tabs by `raw_query` (returns all tabs when query is blank).
pub fn workspace_filter_tabs(
  tabs : Array[TabSummary],
  raw_query : String,
) -> Array[TabSummary] {
  let q = raw_query.trim()
  if q == "" {
    return tabs
  }
  let out : Array[TabSummary] = []
  let mut i = 0
  while i < tabs.length() {
    if workspace_tab_matches_filter(tabs[i], q) {
      out.push(tabs[i])
    }
    i = i + 1
  }
  out
}

///| Returns Pinned folders in `space_id` matching `raw_query` (either folder name matches or any child tab matches).
pub fn workspace_filtered_folders(
  snap : WorkspaceSnapshot,
  space_id : String,
  raw_query : String,
) -> Array[FolderSummary] {
  let all = workspace_folders_for_space(snap, space_id)
  let q = omni_ascii_lower(raw_query.trim())
  if q == "" {
    return all
  }
  let out : Array[FolderSummary] = []
  let mut i = 0
  while i < all.length() {
    let fl = all[i]
    let children = workspace_tabs_in_folder(snap, space_id, fl.id)
    let matched_children = workspace_filter_tabs(children, q)
    if matched_children.length() > 0 || omni_ascii_lower(fl.name).contains(q) {
      out.push(fl)
    }
    i = i + 1
  }
  out
}

///| Returns all Pinned folders belonging to `space_id`.
pub fn workspace_folders_for_space(
  snap : WorkspaceSnapshot,
  space_id : String,
) -> Array[FolderSummary] {
  let out : Array[FolderSummary] = []
  let mut i = 0
  while i < snap.folders.length() {
    if snap.folders[i].space_id == space_id {
      out.push(snap.folders[i])
    }
    i = i + 1
  }
  out
}

///| Returns Pinned non-Favorite tabs in `space_id` assigned to `folder_id`.
pub fn workspace_tabs_in_folder(
  snap : WorkspaceSnapshot,
  space_id : String,
  folder_id : String,
) -> Array[TabSummary] {
  let out : Array[TabSummary] = []
  if folder_id == "" {
    return out
  }
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if !t.favorite && t.pinned && t.space_id == space_id && t.folder_id == folder_id {
      out.push(t)
    }
    i = i + 1
  }
  out
}

///| Returns top-level Pinned tabs in `space_id` that are not inside any existing folder of `space_id`.
pub fn workspace_unfoldered_pinned_tabs(
  snap : WorkspaceSnapshot,
  space_id : String,
) -> Array[TabSummary] {
  let folders = workspace_folders_for_space(snap, space_id)
  let out : Array[TabSummary] = []
  let mut i = 0
  while i < snap.tabs.length() {
    let t = snap.tabs[i]
    if !t.favorite && t.pinned && t.space_id == space_id {
      let mut in_valid_folder = false
      if t.folder_id != "" {
        let mut fi = 0
        while fi < folders.length() {
          if folders[fi].id == t.folder_id {
            in_valid_folder = true
            break
          }
          fi = fi + 1
        }
      }
      if !in_valid_folder {
        out.push(t)
      }
    }
    i = i + 1
  }
  out
}

///| Looks up a folder's display name by `folder_id`.
pub fn workspace_folder_name(snap : WorkspaceSnapshot, folder_id : String) -> String {
  let mut i = 0
  while i < snap.folders.length() {
    if snap.folders[i].id == folder_id {
      return snap.folders[i].name
    }
    i = i + 1
  }
  ""
}

///| Picks the next unused human-friendly Pinned folder name in `space_id`.
pub fn next_auto_folder_name(snap : WorkspaceSnapshot, space_id : String) -> String {
  let presets : Array[String] = ["Docs", "Projects", "Reference", "Reading", "Design"]
  let existing = workspace_folders_for_space(snap, space_id)
  let mut i = 0
  while i < presets.length() {
    let cand = omni_ascii_lower(presets[i])
    let mut used = false
    let mut j = 0
    while j < existing.length() {
      if omni_ascii_lower(existing[j].name) == cand {
        used = true
        break
      }
      j = j + 1
    }
    if !used {
      return presets[i]
    }
    i = i + 1
  }
  "Folder " + (existing.length() + 1).to_string()
}

///| Formats a human-readable navigation history entry title (title if non-empty, else host, else url).
pub fn nav_entry_display_title(e : NavHistoryEntry) -> String {
  let t = e.title.trim()
  if t != "" {
    return t
  }
  let h = split_pane_display_host(e.url)
  if h != "" { h } else { e.url }
}

///| Formats a human-readable tab label (title if non-empty, else host, else "New Tab").
pub fn workspace_tab_display_title(tab : TabSummary) -> String {
  let t = tab.title.trim()
  if t != "" {
    return t
  }
  let h = omnibox_display_host(tab.url)
  if h != "" && h != "about:blank" {
    h
  } else {
    "New Tab"
  }
}

fn ws_hex_nibble(c : Int) -> Int {
  if c >= 0x30 && c <= 0x39 {
    c - 0x30
  } else if c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else if c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else {
    -1
  }
}

///| Parses a `#RRGGBB` hex accent color string into a 32-bit `0xRRGGBBFFL` RGBA Int64.
///| Falls back to Arc blue (`0x2563EBFFL`) on invalid input.
pub fn workspace_accent_color(accent : String) -> Int64 {
  let s = accent.trim()
  let start = if s.starts_with("#") { 1 } else { 0 }
  if s.length() - start != 6 {
    return 0x2563EBFFL
  }
  let mut rgb = 0L
  let mut i = 0
  while i < 6 {
    let nib = ws_hex_nibble(s.code_unit_at(start + i).to_int())
    if nib < 0 {
      return 0x2563EBFFL
    }
    rgb = (rgb << 4) | nib.to_int64()
    i = i + 1
  }
  (rgb << 8) | 0xFFL
}
