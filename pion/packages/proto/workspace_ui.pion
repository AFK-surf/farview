///| Pure-Pion portable Arc Workspace UI state model (Spaces, Tabs, Site Permissions),
///| compact JSON codec with malformed/truncated resilience, and pure filtering helpers
///| shared by `pion-app` and `pion-host`.

pub struct SpaceSummary {
  pub id : String
  pub name : String
  pub accent : String
  ///| The Space's theme (unset for a Space saved with an accent only: `space_theme_effective` derives it).
  pub theme : SpaceTheme
  pub active : Bool
  pub tab_count : Int
}

pub struct FolderSummary {
  pub id : String
  pub space_id : String
  pub name : String
  pub collapsed : Bool
  pub color : String
}

pub struct TabSummary {
  pub id : String
  pub space_id : String
  pub title : String
  pub url : String
  pub pinned : Bool
  pub favorite : Bool
  pub active : Bool
  pub state : String
  pub folder_id : String
  pub last_active_secs : Int64
}

pub struct SitePermSummary {
  pub origin : String
  pub camera : String
  pub microphone : String
  pub notifications : String
  pub screen_capture : String
  pub clipboard_read : String
}

pub struct MediaMiniState {
  pub tab_id : String
  pub title : String
  pub host : String
  pub playing : Bool
  pub muted : Bool
  pub is_meeting : Bool
  pub accent : String
}

pub struct NavHistoryEntry {
  pub index : Int
  pub title : String
  pub url : String
}

pub struct WorkspaceSnapshot {
  pub active_space_id : String
  pub active_tab_id : String
  pub spaces : Array[SpaceSummary]
  pub folders : Array[FolderSummary]
  pub tabs : Array[TabSummary]
  pub permissions : Option[SitePermSummary]
  pub closed_count : Int
  pub media : Option[MediaMiniState]
  pub nav_back : Array[NavHistoryEntry]
  pub nav_forward : Array[NavHistoryEntry]
}

pub fn WorkspaceSnapshot::empty() -> WorkspaceSnapshot {
  WorkspaceSnapshot::{
    active_space_id: "",
    active_tab_id: "",
    spaces: [],
    folders: [],
    tabs: [],
    permissions: None,
    closed_count: 0,
    media: None,
    nav_back: [],
    nav_forward: [],
  }
}

pub fn encode_workspace_snapshot(snap : WorkspaceSnapshot) -> String {
  let sp_parts : Array[String] = []
  let mut i = 0
  while i < snap.spaces.length() {
    let sp = snap.spaces[i]
    sp_parts.push(
      "{\"id\":" +
      omni_json_escape(sp.id) +
      ",\"name\":" +
      omni_json_escape(sp.name) +
      ",\"accent\":" +
      omni_json_escape(sp.accent) +
      (if sp.theme.is_unset() { "" } else { ",\"theme\":" + encode_space_theme(sp.theme) }) +
      ",\"active\":" +
      (if sp.active { "true" } else { "false" }) +
      ",\"tabCount\":" +
      sp.tab_count.to_string() +
      "}",
    )
    i = i + 1
  }
  let folder_parts : Array[String] = []
  let mut fi = 0
  while fi < snap.folders.length() {
    let fl = snap.folders[fi]
    let color_part = if fl.color != "" {
      ",\"color\":" + omni_json_escape(normalize_folder_color(fl.color))
    } else {
      ""
    }
    folder_parts.push(
      "{\"id\":" +
      omni_json_escape(fl.id) +
      ",\"spaceId\":" +
      omni_json_escape(fl.space_id) +
      ",\"name\":" +
      omni_json_escape(fl.name) +
      ",\"collapsed\":" +
      (if fl.collapsed { "true" } else { "false" }) +
      color_part +
      "}",
    )
    fi = fi + 1
  }
  let tab_parts : Array[String] = []
  let mut j = 0
  while j < snap.tabs.length() {
    let tb = snap.tabs[j]
    let fid_part = if tb.folder_id != "" {
      ",\"folderId\":" + omni_json_escape(tb.folder_id)
    } else {
      ""
    }
    let last_active_part = if tb.last_active_secs > 0L {
      ",\"lastActiveSecs\":" + tb.last_active_secs.to_string()
    } else {
      ""
    }
    tab_parts.push(
      "{\"id\":" +
      omni_json_escape(tb.id) +
      ",\"spaceId\":" +
      omni_json_escape(tb.space_id) +
      ",\"title\":" +
      omni_json_escape(tb.title) +
      ",\"url\":" +
      omni_json_escape(tb.url) +
      ",\"pinned\":" +
      (if tb.pinned { "true" } else { "false" }) +
      ",\"favorite\":" +
      (if tb.favorite { "true" } else { "false" }) +
      ",\"active\":" +
      (if tb.active { "true" } else { "false" }) +
      ",\"state\":" +
      omni_json_escape(tb.state) +
      fid_part +
      last_active_part +
      "}",
    )
    j = j + 1
  }
  let perm_part = match snap.permissions {
    Some(pm) if pm.origin != "" =>
    ",\"permissions\":{\"origin\":" +
    omni_json_escape(pm.origin) +
    ",\"camera\":" +
    omni_json_escape(pm.camera) +
    ",\"microphone\":" +
    omni_json_escape(pm.microphone) +
    ",\"notifications\":" +
    omni_json_escape(pm.notifications) +
    ",\"screenCapture\":" +
    omni_json_escape(pm.screen_capture) +
    ",\"clipboardRead\":" +
    omni_json_escape(pm.clipboard_read) +
    "}"
    _ => ""
  }
  let media_part = match snap.media {
    Some(m) if m.tab_id != "" || m.title != "" || m.host != "" =>
    ",\"media\":{\"tabId\":" +
    omni_json_escape(m.tab_id) +
    ",\"title\":" +
    omni_json_escape(m.title) +
    ",\"host\":" +
    omni_json_escape(m.host) +
    ",\"playing\":" +
    (if m.playing { "true" } else { "false" }) +
    ",\"muted\":" +
    (if m.muted { "true" } else { "false" }) +
    ",\"isMeeting\":" +
    (if m.is_meeting { "true" } else { "false" }) +
    ",\"accent\":" +
    omni_json_escape(m.accent) +
    "}"
    _ => ""
  }
  let encode_nav_list = fn(entries : Array[NavHistoryEntry]) -> String {
    let parts : Array[String] = []
    let mut k = 0
    while k < entries.length() {
      let e = entries[k]
      parts.push(
        "{\"index\":" +
        e.index.to_string() +
        ",\"title\":" +
        omni_json_escape(e.title) +
        ",\"url\":" +
        omni_json_escape(e.url) +
        "}",
      )
      k = k + 1
    }
    "[" + parts.join(",") + "]"
  }
  let nav_back_part = if snap.nav_back.length() > 0 {
    ",\"navBack\":" + encode_nav_list(snap.nav_back)
  } else {
    ""
  }
  let nav_fwd_part = if snap.nav_forward.length() > 0 {
    ",\"navForward\":" + encode_nav_list(snap.nav_forward)
  } else {
    ""
  }
  "{\"activeSpaceId\":" +
  omni_json_escape(snap.active_space_id) +
  ",\"activeTabId\":" +
  omni_json_escape(snap.active_tab_id) +
  ",\"spaces\":[" +
  sp_parts.join(",") +
  "],\"folders\":[" +
  folder_parts.join(",") +
  "],\"tabs\":[" +
  tab_parts.join(",") +
  "],\"closedCount\":" +
  (if snap.closed_count < 0 { 0 } else { snap.closed_count }).to_string() +
  perm_part +
  media_part +
  nav_back_part +
  nav_fwd_part +
  "}"
}

fn ws_parse_bool(p : OmniJsonParser) -> Option[Bool] {
  p.skip_ws()
  if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
    p.i = p.i + 4
    Some(true)
  } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
    p.i = p.i + 5
    Some(false)
  } else {
    None
  }
}

fn ws_parse_space(p : OmniJsonParser) -> Option[SpaceSummary] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut name = ""
  let mut accent = "#2563EB"
  let mut theme = space_theme_unset()
  let mut active = false
  let mut tab_count = 0
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(SpaceSummary::{ id, name, accent, theme, active, tab_count })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "accent" {
      match p.parse_str() {
        Some(v) => accent = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "theme" {
      match ws_parse_space_theme_value(p) {
        Some(v) => theme = v
        None => return None
      }
    } else if key == "active" {
      match ws_parse_bool(p) {
        Some(v) => active = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "tabCount" || key == "tab_count" {
      match p.parse_number() {
        Some(v) => {
          let iv = math_floor(v + 0.5).to_int()
          tab_count = if iv < 0 { 0 } else { iv }
        }
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(SpaceSummary::{ id, name, accent, theme, active, tab_count })
    } else {
      return None
    }
  }
  None
}

fn ws_parse_folder(p : OmniJsonParser) -> Option[FolderSummary] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = ""
  let mut space_id = ""
  let mut name = ""
  let mut collapsed = false
  let mut color = "blue"
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(FolderSummary::{ id, space_id, name, collapsed, color })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_str() {
        Some(v) => id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "spaceId" || key == "space_id" {
      match p.parse_str() {
        Some(v) => space_id = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "collapsed" {
      match ws_parse_bool(p) {
        Some(v) => collapsed = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "color" {
      match p.parse_str() {
        Some(v) => color = normalize_folder_color(v)
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(FolderSummary::{ id, space_id, name, collapsed, color })
    } else {
      return None
    }
  }
  None
}

