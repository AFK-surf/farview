    p.skip_ws()
    if key == "origin" {
      match p.parse_str() {
        Some(v) => origin = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "camera" {
      match p.parse_str() {
        Some(v) => camera = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "microphone" {
      match p.parse_str() {
        Some(v) => microphone = v
