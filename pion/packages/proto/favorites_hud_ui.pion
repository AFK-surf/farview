///| Pure-Pion portable models & codecs for:
///| 1. Arc Sidebar Favorites Glass Tile Grid helpers (up to 6 tiles in 3x2 grid, brand monograms & Light/Dark accents)
///| 2. Omnibox Smart Site Search (`@gh`, `@yt`, `@mdn`, `@wiki`, `@g`) prefix matcher & UTF-8 percent-encoder
///| 3. Live Page Performance & Security HUD (`PerfHudSnapshot`, wire tag 67 `PerfHudState`) JSON codec & formatters

pub let FAVORITES_MAX_TILES : Int = 6

///| Returns up to `max_tiles` (default 6) Favorite tabs (`favorite == true`) for `space_id`.
///| When `space_id` is empty, returns favorites across all Spaces; otherwise filters to `space_id`.
pub fn workspace_favorite_tiles(
  snap : WorkspaceSnapshot,
  space_id : String,
  max_tiles~ : Int = FAVORITES_MAX_TILES,
) -> Array[TabSummary] {
  let cap = if max_tiles > 0 { max_tiles } else { FAVORITES_MAX_TILES }
  let out : Array[TabSummary] = []
  let mut i = 0
  while i < snap.tabs.length() && out.length() < cap {
    let t = snap.tabs[i]
    if t.favorite && (space_id == "" || t.space_id == space_id) {
      out.push(t)
    }
    i = i + 1
  }
  out
}

///| Extracts a crisp 1-2 character brand monogram for an Arc Favorites glass tile.
pub fn favorite_tile_monogram(tab : TabSummary) -> String {
  let host = omni_ascii_lower(omnibox_display_host(tab.url))
  if host.contains("github.com") {
    "GH"
  } else if host.contains("youtube.com") || host.contains("youtu.be") {
    "YT"
  } else if host.contains("developer.mozilla.org") {
    "MD"
  } else if host.contains("wikipedia.org") {
    "W"
  } else if host.contains("linear.app") {
    "LN"
  } else if host.contains("figma.com") {
    "FG"
  } else if host.contains("meet.google.com") {
    "MT"
  } else if host.contains("mail.google.com") {
    "GM"
  } else if host.starts_with("x.com") || host.contains("twitter.com") {
    "X"
  } else if host.contains("notion.so") {
    "N"
  } else if host.contains("slack.com") {
    "SL"
  } else {
    omnibox_initial_letter(tab.url, tab.title)
  }
}

///| Returns a clean short site label for an Arc Favorites tile (single-line safe).
pub fn favorite_tile_short_label(tab : TabSummary) -> String {
  let host = omni_ascii_lower(omnibox_display_host(tab.url))
  if host.contains("github.com") {
    return "GitHub"
  }
  if host.contains("youtube.com") || host.contains("youtu.be") {
    return "YouTube"
  }
  if host.contains("developer.mozilla.org") {
    return "MDN Docs"
  }
  if host.contains("wikipedia.org") {
    return "Wikipedia"
  }
  if host.contains("linear.app") {
    return "Linear"
  }
  if host.contains("figma.com") {
    return "Figma"
  }
  if host.contains("meet.google.com") {
    return "Meet"
  }
  if host.contains("mail.google.com") {
    return "Gmail"
  }
  if host.starts_with("x.com") || host.contains("twitter.com") {
    return "X"
  }
  if host.contains("notion.so") {
    return "Notion"
  }
  if host.contains("slack.com") {
    return "Slack"
  }
  let t = workspace_tab_display_title(tab)
  if t != "" { t } else { "Site" }
}

///| Returns `(badge_bg, badge_ink, badge_border)` tuned for Light and Dark `ChromePalette`.
pub fn favorite_tile_brand_colors(url : String, is_dark : Bool) -> (Int64, Int64, Int64) {
  let host = omni_ascii_lower(omnibox_display_host(url))
  if host.contains("youtube.com") || host.contains("youtu.be") {
    if is_dark { (0x3D1C22FFL, 0xFCA5A5FFL, 0x6B2C36FFL) } else { (0xFEE2E2FFL, 0xDC2626FFL, 0xFECACAFFL) }
  } else if host.contains("github.com") {
    if is_dark { (0x2A2F3DFFL, 0xE2E8F0FFL, 0x41495EFFL) } else { (0xE5E7EBFFL, 0x111827FFL, 0xD1D5DBFFL) }
  } else if host.contains("developer.mozilla.org") {
    if is_dark { (0x1B2D48FFL, 0x7DD3FCFFL, 0x2B4973FFL) } else { (0xE0F2FEFFL, 0x0369A1FFL, 0xBAE6FDFFL) }
  } else if host.contains("wikipedia.org") {
    if is_dark { (0x2D313CFFL, 0xE5E7EBFFL, 0x454B5BFFL) } else { (0xF1F5F9FFL, 0x334155FFL, 0xCBD5E1FFL) }
  } else if host.contains("linear.app") {
    if is_dark { (0x25264EFFL, 0xA5B4FCFFL, 0x3E4080FFL) } else { (0xE0E7FFFFL, 0x4338CAFFL, 0xC7D2FEFFL) }
  } else if host.contains("figma.com") || host.contains("dribbble.com") {
    if is_dark { (0x34214BFFL, 0xD8B4FEFFL, 0x55367AFFL) } else { (0xF3E8FFFFL, 0x7C3AEDFFL, 0xE9D5FFFFL) }
  } else if host.contains("meet.google.com") {
    if is_dark { (0x163327FFL, 0x6EE7B7FFL, 0x245540FFL) } else { (0xDCFCE7FFL, 0x15803DFFL, 0xBBF7D0FFL) }
  } else if host.contains("mail.google.com") {
    if is_dark { (0x3C2224FFL, 0xFDA4AFFFL, 0x643438FFL) } else { (0xFFE4E6FFL, 0xBE123CFFL, 0xFECDD3FFL) }
  } else if host.starts_with("x.com") || host.contains("twitter.com") {
    if is_dark { (0x272B36FFL, 0xF8FAFCFFL, 0x3E4556FFL) } else { (0xE5E7EBFFL, 0x111827FFL, 0xD1D5DBFFL) }
  } else if is_dark {
    (0x1E2F4DFFL, 0x93C5FDFFL, 0x304D7DFFL)
  } else {
    (0xE8F0FEFFL, 0x2563EBFFL, 0xBFDBFEFFL)
  }
}

// --- 2. Omnibox Smart Site Search (`@gh`, `@yt`, `@mdn`, `@wiki`, `@g`) ---

pub struct SiteSearchMatch {
  pub engine_id : String
  pub keyword : String
  pub label : String
  pub badge_text : String
  pub monogram : String
  pub query : String
  pub url : String
  pub display_host : String
  pub accent_light : Int64
  pub accent_dark : Int64
  pub bg_light : Int64
  pub bg_dark : Int64
  pub border_light : Int64
  pub border_dark : Int64
}

///| RFC 3986 UTF-8 byte-level percent-encoder for Site Search queries.
///| Preserves ASCII letters, digits, and `-_.~`; encodes spaces as `%20` and all non-ASCII
///| (CJK, Japanese, emoji, etc.) safely by raw UTF-8 bytes.
pub fn site_search_percent_encode(s : String) -> String {
  let b = s.to_bytes()
  let hex = "0123456789ABCDEF"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    let unreserved = (c >= 0x41 && c <= 0x5A) ||
    (c >= 0x61 && c <= 0x7A) ||
    (c >= 0x30 && c <= 0x39) ||
    c == 0x2D ||
    c == 0x2E ||
    c == 0x5F ||
    c == 0x7E
    if unreserved {
      sb.write_string(omni_byte_str(c))
    } else {
      sb.write_char('%')
      sb.write_string(hex.slice((c >> 4) & 15, ((c >> 4) & 15) + 1))
      sb.write_string(hex.slice(c & 15, (c & 15) + 1))
    }
    i = i + 1
  }
  sb.to_string()
}

fn site_search_trim_left(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i).to_int()
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D {
      i = i + 1
    } else {
      break
    }
  }
  if i == 0 { s } else { s.slice(i, n) }
}

fn site_search_build_match(engine_id : String, raw_query : String) -> SiteSearchMatch {
  let q = raw_query.trim()
  let enc = site_search_percent_encode(q)
  if engine_id == "github" {
    SiteSearchMatch::{
      engine_id: "github",
      keyword: "@gh",
      label: "GitHub",
      badge_text: "Search GitHub",
      monogram: "GH",
      query: q,
      url: if q != "" { "https://github.com/search?q=" + enc } else { "https://github.com/search" },
      display_host: "github.com",
      accent_light: 0x111827FFL,
      accent_dark: 0xF1F5F9FFL,
      bg_light: 0xEEF0F4FFL,
      bg_dark: 0x2A303EFFL,
      border_light: 0xCBD5E1FFL,
      border_dark: 0x454E63FFL,
    }
  } else if engine_id == "youtube" {
    SiteSearchMatch::{
      engine_id: "youtube",
      keyword: "@yt",
      label: "YouTube",
      badge_text: "Search YouTube",
      monogram: "YT",
      query: q,
      url: if q != "" { "https://www.youtube.com/results?search_query=" + enc } else { "https://www.youtube.com" },
      display_host: "youtube.com",
      accent_light: 0xDC2626FFL,
      accent_dark: 0xFCA5A5FFL,
      bg_light: 0xFEE2E2FFL,
      bg_dark: 0x3D1C22FFL,
      border_light: 0xFECACAFFL,
      border_dark: 0x6B2C36FFL,
    }
  } else if engine_id == "mdn" {
    SiteSearchMatch::{
      engine_id: "mdn",
      keyword: "@mdn",
      label: "MDN Docs",
      badge_text: "Search MDN",
      monogram: "MDN",
      query: q,
      url: if q != "" { "https://developer.mozilla.org/en-US/search?q=" + enc } else { "https://developer.mozilla.org/en-US/" },
      display_host: "developer.mozilla.org",
      accent_light: 0x0369A1FFL,
      accent_dark: 0x7DD3FCFFL,
      bg_light: 0xE0F2FEFFL,
      bg_dark: 0x1B2D48FFL,
      border_light: 0xBAE6FDFFL,
      border_dark: 0x2B4973FFL,
    }
  } else if engine_id == "wikipedia" {
    SiteSearchMatch::{
      engine_id: "wikipedia",
      keyword: "@wiki",
      label: "Wikipedia",
      badge_text: "Search Wikipedia",
      monogram: "W",
      query: q,
      url: if q != "" { "https://en.wikipedia.org/w/index.php?search=" + enc } else { "https://en.wikipedia.org/" },
      display_host: "en.wikipedia.org",
      accent_light: 0x334155FFL,
      accent_dark: 0xE2E8F0FFL,
      bg_light: 0xF1F5F9FFL,
      bg_dark: 0x2C313DFFL,
      border_light: 0xCBD5E1FFL,
      border_dark: 0x454D60FFL,
    }
  } else {
    SiteSearchMatch::{
      engine_id: "google",
      keyword: "@g",
      label: "Google",
      badge_text: "Search Google",
      monogram: "G",
      query: q,
      url: if q != "" { "https://www.google.com/search?q=" + enc } else { "https://www.google.com/" },
      display_host: "google.com",
      accent_light: 0x1D4ED8FFL,
      accent_dark: 0x93C5FDFFL,
      bg_light: 0xDBEAFEFFL,
      bg_dark: 0x1E2E4AFFL,
      border_light: 0xBFDBFEFFL,
      border_dark: 0x2F4B78FFL,
    }
  }
}

///| Recognizes Omnibox Site Search prefixes (`@gh `, `gh `, `@yt `, `yt `, `@mdn `, `mdn `,
///| `@wiki `, `wiki `, `@g `) in a UTF-8 safe manner (ASCII case-insensitive via `omni_ascii_lower`).
pub fn match_site_search(raw : String) -> Option[SiteSearchMatch] {
  let s = site_search_trim_left(raw)
  if s == "" {
    return None
  }
  let lower = omni_ascii_lower(s)
  if lower.starts_with("@gh ") {
    return Some(site_search_build_match("github", s.slice(4, s.length())))
  }
  if lower.starts_with("gh ") {
    return Some(site_search_build_match("github", s.slice(3, s.length())))
  }
  if lower.starts_with("@yt ") {
    return Some(site_search_build_match("youtube", s.slice(4, s.length())))
  }
  if lower.starts_with("yt ") {
    return Some(site_search_build_match("youtube", s.slice(3, s.length())))
  }
  if lower.starts_with("@mdn ") {
    return Some(site_search_build_match("mdn", s.slice(5, s.length())))
  }
  if lower.starts_with("mdn ") {
    return Some(site_search_build_match("mdn", s.slice(4, s.length())))
  }
  if lower.starts_with("@wiki ") {
    return Some(site_search_build_match("wikipedia", s.slice(6, s.length())))
  }
  if lower.starts_with("wiki ") {
    return Some(site_search_build_match("wikipedia", s.slice(5, s.length())))
  }
  if lower.starts_with("@g ") {
    return Some(site_search_build_match("google", s.slice(3, s.length())))
  }
  None
}

///| Convenience helper returning the resolved Site Search URL when `raw` matches a prefix.
pub fn omnibox_resolve_site_search_url(raw : String) -> Option[String] {
  match match_site_search(raw) {
    Some(m) => Some(m.url)
    None => None
  }
}

// --- 3. Live Page Performance & Security HUD (`PerfHudSnapshot`, wire tag 67) ---

pub struct PerfHudSnapshot {
  pub host : String
  pub scheme : String
  pub is_https : Bool
  pub dom_nodes : Int
  pub stylesheets : Int
  pub images : Int
  pub fonts : Int
  pub doc_width : Int
  pub doc_height : Int
  pub scroll_y : Int
  pub rss_mb : Int
  pub zoom_pct : Int
  pub cookies_count : Int
  pub active_space : String
}

pub fn PerfHudSnapshot::empty() -> PerfHudSnapshot {
  PerfHudSnapshot::{
    host: "",
    scheme: "https",
    is_https: false,
    dom_nodes: 0,
    stylesheets: 0,
    images: 0,
    fonts: 0,
    doc_width: 0,
    doc_height: 0,
    scroll_y: 0,
    rss_mb: 0,
    zoom_pct: 100,
    cookies_count: 0,
    active_space: "Work",
  }
}

pub fn encode_perf_hud_snapshot(snap : PerfHudSnapshot) -> String {
  "{\"host\":" +
  omni_json_escape(snap.host) +
  ",\"scheme\":" +
  omni_json_escape(snap.scheme) +
  ",\"isHttps\":" +
  (if snap.is_https { "true" } else { "false" }) +
  ",\"domNodes\":" +
  snap.dom_nodes.to_string() +
  ",\"stylesheets\":" +
  snap.stylesheets.to_string() +
  ",\"images\":" +
  snap.images.to_string() +
  ",\"fonts\":" +
  snap.fonts.to_string() +
  ",\"docWidth\":" +
  snap.doc_width.to_string() +
  ",\"docHeight\":" +
  snap.doc_height.to_string() +
  ",\"scrollY\":" +
  snap.scroll_y.to_string() +
  ",\"rssMb\":" +
  snap.rss_mb.to_string() +
  ",\"zoomPct\":" +
  snap.zoom_pct.to_string() +
  ",\"cookiesCount\":" +
  snap.cookies_count.to_string() +
  ",\"activeSpace\":" +
  omni_json_escape(snap.active_space) +
  "}"
}

fn perf_hud_parse_nonneg_int(p : OmniJsonParser) -> Option[Int] {
  match p.parse_number() {
    Some(v) => {
      let iv = math_floor(v + 0.5).to_int()
      Some(if iv < 0 { 0 } else { iv })
    }
    None => None
  }
}

///| Parses a `PerfHudSnapshot` JSON payload from `wire::Message::PerfHudState` (tag 67).
///| Safely handles malformed/truncated JSON by returning `None`.
pub fn parse_perf_hud_snapshot(json : String) -> Option[PerfHudSnapshot] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut host = ""
  let mut scheme = ""
  let mut is_https = false
  let mut dom_nodes = 0
  let mut stylesheets = 0
  let mut images = 0
  let mut fonts = 0
  let mut doc_width = 0
  let mut doc_height = 0
  let mut scroll_y = 0
  let mut rss_mb = 0
  let mut zoom_pct = 100
  let mut cookies_count = 0
  let mut active_space = "Work"
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(
      PerfHudSnapshot::{
        host,
        scheme,
        is_https,
        dom_nodes,
        stylesheets,
        images,
        fonts,
        doc_width,
        doc_height,
        scroll_y,
        rss_mb,
        zoom_pct,
        cookies_count,
        active_space,
      },
    )
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "host" {
      match p.parse_str() {
        Some(v) => host = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "scheme" {
      match p.parse_str() {
        Some(v) => scheme = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "isHttps" || key == "is_https" {
      if p.i + 4 <= p.n && p.s.slice(p.i, p.i + 4) == "true" {
        p.i = p.i + 4
        is_https = true
      } else if p.i + 5 <= p.n && p.s.slice(p.i, p.i + 5) == "false" {
        p.i = p.i + 5
        is_https = false
      } else if !p.skip_value() {
        return None
      }
    } else if key == "domNodes" || key == "dom_nodes" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => dom_nodes = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "stylesheets" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => stylesheets = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "images" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => images = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "fonts" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => fonts = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "docWidth" || key == "doc_width" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => doc_width = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "docHeight" || key == "doc_height" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => doc_height = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "scrollY" || key == "scroll_y" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => scroll_y = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "rssMb" || key == "rss_mb" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => rss_mb = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "zoomPct" || key == "zoom_pct" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => zoom_pct = if v > 0 { v } else { 100 }
        None => if !p.skip_value() { return None }
      }
    } else if key == "cookiesCount" || key == "cookies_count" {
      match perf_hud_parse_nonneg_int(p) {
        Some(v) => cookies_count = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "activeSpace" || key == "active_space" {
      match p.parse_str() {
        Some(v) => active_space = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(
        PerfHudSnapshot::{
          host,
          scheme,
          is_https,
          dom_nodes,
          stylesheets,
          images,
          fonts,
          doc_width,
          doc_height,
          scroll_y,
          rss_mb,
          zoom_pct,
          cookies_count,
          active_space,
        },
      )
    } else {
      return None
    }
  }
  None
}

///| Formats an integer count with thousands separator (e.g. `1,248`) or compact `k` suffix for >= 100k.
pub fn perf_hud_format_count(n : Int) -> String {
  let v = if n < 0 { 0 } else { n }
  if v >= 100000 {
    let k = v / 1000
    k.to_string() + "k"
  } else if v >= 1000 {
    let hi = v / 1000
    let lo = v % 1000
    let pad = if lo < 10 {
      "00" + lo.to_string()
    } else if lo < 100 {
      "0" + lo.to_string()
    } else {
      lo.to_string()
    }
    hi.to_string() + "," + pad
  } else {
    v.to_string()
  }
}

///| Formats document/viewport dimensions as `W×H` (e.g. `1280×3420`).
pub fn perf_hud_format_dims(w : Int, h : Int) -> String {
  let cw = if w < 0 { 0 } else { w }
  let ch = if h < 0 { 0 } else { h }
  cw.to_string() + "×" + ch.to_string()
}

///| Formats a zoom percentage as `100%`.
pub fn perf_hud_format_zoom(pct : Int) -> String {
  let v = if pct <= 0 { 100 } else { pct }
  v.to_string() + "%"
}

///| Returns the uppercase security badge label (`HTTPS`, `HTTP`, or `LOCAL`).
pub fn perf_hud_security_badge(scheme : String, is_https : Bool) -> String {
  if is_https {
    "HTTPS"
  } else {
    let sc = omni_ascii_lower(scheme.trim())
    if sc == "https" {
      "HTTPS"
    } else if sc == "http" {
      "HTTP"
    } else if sc == "file" || sc == "about" || sc == "data" {
      "LOCAL"
    } else {
      "HTTP"
    }
  }
}
