///| Pure-Pion portable DevTools Drawer data model (`DevToolsSnapshot`, DOM tree,
///| Computed Box Model & Styles, Console REPL entries, Network/Resources table),
///| height clamping & drag math, CSS color swatch parser, byte formatting, and
///| compact JSON codec shared by `pion-host` and `pion-app`.

pub let DEVTOOLS_HEIGHT_MIN : Double = 180.0
pub let DEVTOOLS_HEIGHT_MAX : Double = 480.0
pub let DEVTOOLS_HEIGHT_DEFAULT : Double = 290.0
pub let DEVTOOLS_DIVIDER_HEIGHT : Double = 6.0
pub let DEVTOOLS_INSPECTOR_WIDTH : Double = 308.0

pub struct DevToolsAttr {
  pub name : String
  pub value : String
}

pub struct DevToolsDomNode {
  pub path : String
  pub depth : Int
  pub tag : String
  pub id_attr : String
  pub class_attr : String
  pub attrs : Array[DevToolsAttr]
  pub text_preview : String
  pub child_count : Int
}

pub struct DevToolsBoxModel {
  pub width : Double
  pub height : Double
  pub pad_top : Double
  pub pad_right : Double
  pub pad_bottom : Double
  pub pad_left : Double
  pub border_top : Double
  pub border_right : Double
  pub border_bottom : Double
  pub border_left : Double
  pub margin_top : Double
  pub margin_right : Double
  pub margin_bottom : Double
  pub margin_left : Double
}

pub struct DevToolsStyleProp {
  pub name : String
  pub value : String
  pub color_hex : String
}

pub struct DevToolsConsoleEntry {
  pub id : Int
  pub level : String
  pub text : String
  pub source : String
}

pub struct DevToolsNetworkEntry {
  pub name : String
  pub url : String
  pub kind : String
  pub status : Int
  pub duration_ms : Int
  pub size_bytes : Int
}

pub struct DevToolsSnapshot {
  pub page_url : String
  pub page_title : String
  pub selected_path : String
  pub nodes : Array[DevToolsDomNode]
  pub box_model : DevToolsBoxModel
  pub styles : Array[DevToolsStyleProp]
  pub console_entries : Array[DevToolsConsoleEntry]
  pub network_entries : Array[DevToolsNetworkEntry]
}

pub fn DevToolsBoxModel::empty() -> DevToolsBoxModel {
  DevToolsBoxModel::{
    width: 0.0,
    height: 0.0,
    pad_top: 0.0,
    pad_right: 0.0,
    pad_bottom: 0.0,
    pad_left: 0.0,
    border_top: 0.0,
    border_right: 0.0,
    border_bottom: 0.0,
    border_left: 0.0,
    margin_top: 0.0,
    margin_right: 0.0,
    margin_bottom: 0.0,
    margin_left: 0.0,
  }
}

pub fn DevToolsSnapshot::empty() -> DevToolsSnapshot {
  DevToolsSnapshot::{
    page_url: "",
    page_title: "",
    selected_path: "",
    nodes: [],
    box_model: DevToolsBoxModel::empty(),
    styles: [],
    console_entries: [],
    network_entries: [],
  }
}

pub fn clamp_devtools_height(h : Double) -> Double {
  if h != h {
    return DEVTOOLS_HEIGHT_DEFAULT
  }
  if h < DEVTOOLS_HEIGHT_MIN {
    DEVTOOLS_HEIGHT_MIN
  } else if h > DEVTOOLS_HEIGHT_MAX {
    DEVTOOLS_HEIGHT_MAX
  } else {
    h
  }
}

///| Computes new DevTools drawer height when dragging the top resize handle by `dy`
///| (dragging upward -> `dy < 0` -> taller drawer).
pub fn devtools_height_from_drag(start_h : Double, dy : Double) -> Double {
  clamp_devtools_height(start_h - dy)
}

pub fn format_devtools_px(v : Double) -> String {
  if v != v {
    return "0"
  }
  let rounded = math_floor(v * 10.0 + 0.5).to_int()
  let whole = rounded / 10
  let frac = rounded % 10
  if frac == 0 {
    whole.to_string()
  } else {
    whole.to_string() + "." + (if frac < 0 { 0 - frac } else { frac }).to_string()
  }
}

pub fn format_devtools_bytes(bytes : Int) -> String {
  if bytes <= 0 {
    return "0 B"
  }
  if bytes < 1024 {
    return bytes.to_string() + " B"
  }
  if bytes < 1048576 {
    let tenths = (bytes * 10 + 512) / 1024
    let whole = tenths / 10
    let frac = tenths % 10
    return whole.to_string() + "." + frac.to_string() + " KB"
  }
  let tenths = (bytes * 10 + 524288) / 1048576
  let whole = tenths / 10
  let frac = tenths % 10
  whole.to_string() + "." + frac.to_string() + " MB"
}

pub fn devtools_network_summary(entries : Array[DevToolsNetworkEntry]) -> String {
  let n = entries.length()
  let mut total = 0
  let mut i = 0
  while i < n {
    if entries[i].size_bytes > 0 {
      total = total + entries[i].size_bytes
    }
    i = i + 1
  }
  let req_word = if n == 1 { "request" } else { "requests" }
  n.to_string() + " " + req_word + " · " + format_devtools_bytes(total)
}

fn dt_strip_query_hash(url : String) -> String {
  let mut end = url.length()
  let mut i = 0
  while i < url.length() {
    let c = url.code_unit_at(i).to_int()
    if c == 0x3F || c == 0x23 {
      end = i
      break
    }
    i = i + 1
  }
  url.slice(0, end)
}

///| Classifies a network entry into canonical filter buckets:
///| `"doc"`, `"js"`, `"css"`, `"img"`, `"fetch"`, or `"other"`.
pub fn devtools_net_category(kind : String, url : String) -> String {
  let k = omni_ascii_lower(kind.trim())
  if k == "document" || k == "doc" || k == "html" {
    return "doc"
  }
  if k == "script" || k == "js" || k == "javascript" {
    return "js"
  }
  if k == "stylesheet" || k == "css" {
    return "css"
  }
  if k == "img" || k == "image" || k == "svg" {
    return "img"
  }
  if k == "fetch" || k == "xhr" || k == "api" || k == "json" {
    return "fetch"
  }
  let path = omni_ascii_lower(dt_strip_query_hash(url.trim()))
  if path.ends_with(".html") || path.ends_with(".htm") {
    "doc"
  } else if path.ends_with(".js") || path.ends_with(".mjs") || path.ends_with(".cjs") {
    "js"
  } else if path.ends_with(".css") {
    "css"
  } else if path.ends_with(".png") ||
  path.ends_with(".jpg") ||
  path.ends_with(".jpeg") ||
  path.ends_with(".webp") ||
  path.ends_with(".gif") ||
  path.ends_with(".svg") ||
  path.ends_with(".ico") ||
  path.ends_with(".avif") {
    "img"
  } else if path.ends_with(".json") || path.contains("/api/") {
    "fetch"
  } else {
    "other"
  }
}

///| Checks whether a network entry matches the selected category pill and UTF-8 search query.
pub fn devtools_net_matches_filter(
  entry : DevToolsNetworkEntry,
  category : String,
  query : String,
) -> Bool {
  let cat = omni_ascii_lower(category.trim())
  if cat != "" && cat != "all" {
    if devtools_net_category(entry.kind, entry.url) != cat {
      return false
    }
  }
  let q = omni_ascii_lower(query.trim())
  if q == "" {
    return true
  }
  omni_ascii_lower(entry.name).contains(q) ||
  omni_ascii_lower(entry.url).contains(q) ||
  omni_ascii_lower(entry.kind).contains(q) ||
  entry.status.to_string().contains(q)
}

///| Infers a human-readable MIME type for a network entry.
pub fn devtools_net_mime(entry : DevToolsNetworkEntry) -> String {
  let path = omni_ascii_lower(dt_strip_query_hash(entry.url.trim()))
  if path.ends_with(".svg") {
    return "image/svg+xml"
  }
  if path.ends_with(".png") {
    return "image/png"
  }
  if path.ends_with(".jpg") || path.ends_with(".jpeg") {
    return "image/jpeg"
  }
  if path.ends_with(".webp") {
    return "image/webp"
  }
  if path.ends_with(".woff2") {
    return "font/woff2"
  }
  let cat = devtools_net_category(entry.kind, entry.url)
  if cat == "doc" {
    "text/html; charset=utf-8"
  } else if cat == "js" {
    "application/javascript"
  } else if cat == "css" {
    "text/css; charset=utf-8"
  } else if cat == "img" {
    "image/png"
  } else if cat == "fetch" {
    "application/json"
  } else if omni_ascii_lower(entry.kind) == "font" {
    "font/woff2"
  } else {
    "application/octet-stream"
  }
}

///| Formats an HTTP status code with a concise standard reason phrase.
pub fn devtools_net_status_text(status : Int) -> String {
  if status == 200 {
    "200 OK"
  } else if status == 201 {
    "201 Created"
  } else if status == 204 {
    "204 No Content"
  } else if status == 301 {
    "301 Moved"
  } else if status == 302 {
    "302 Found"
  } else if status == 304 {
    "304 Not Modified"
  } else if status == 400 {
    "400 Bad Request"
  } else if status == 401 {
    "401 Unauthorized"
  } else if status == 403 {
    "403 Forbidden"
  } else if status == 404 {
    "404 Not Found"
  } else if status == 500 {
    "500 Server Error"
  } else if status == 502 {
    "502 Bad Gateway"
  } else if status == 503 {
    "503 Unavailable"
  } else {
    status.to_string()
  }
}

///| Computes normalized waterfall bar ratio in `[0.06, 1.0]` relative to `max_ms`.
pub fn devtools_net_waterfall_ratio(duration_ms : Int, max_ms : Int) -> Double {
  if duration_ms <= 0 || max_ms <= 0 {
    return 0.06
  }
  let raw = int_to_double(duration_ms) / int_to_double(max_ms)
  if raw < 0.06 {
    0.06
  } else if raw > 1.0 {
    1.0
  } else {
    raw
  }
}

///| POSIX single-quote shell escaping: wraps `s` in `'...'` and replaces `'` with `'\''`.
pub fn devtools_shell_single_quote(s : String) -> String {
  let sb = StringBuilder::new()
  sb.write_char('\'')
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x27 {
      sb.write_string("'\\''")
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i = i + 1
  }
  sb.write_char('\'')
  sb.to_string()
}

///| Generates a POSIX-safe `curl '...'` command for a network request entry.
pub fn devtools_net_curl_command(entry : DevToolsNetworkEntry) -> String {
  let target = if entry.url.trim() != "" { entry.url.trim() } else { entry.name.trim() }
  "curl " + devtools_shell_single_quote(target)
}

fn dt_hex_digit(c : Int) -> Int {
  if c >= 0x30 && c <= 0x39 {
    c - 0x30
  } else if c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else if c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else {
    -1
  }
}

fn dt_parse_u8(s : String) -> Option[Int] {
  let t = s.trim()
  if t == "" {
    return None
  }
  let mut i = 0
  let mut acc = 0
  let mut digits = 0
  while i < t.length() {
    let c = t.code_unit_at(i).to_int()
    if c >= 0x30 && c <= 0x39 {
      acc = acc * 10 + (c - 0x30)
      digits = digits + 1
    } else if c == 0x2E {
      break
    } else {
      return None
    }
    i = i + 1
  }
  if digits == 0 {
    return None
  }
  if acc < 0 { Some(0) } else if acc > 255 { Some(255) } else { Some(acc) }
}

fn dt_parse_alpha(s : String) -> Option[Int] {
  let t = s.trim()
  if t == "" {
    return None
  }
  let mut i = 0
  let mut whole = 0.0
  let mut frac = 0.0
  let mut div = 1.0
  let mut dot = false
  let mut digits = 0
  while i < t.length() {
    let c = t.code_unit_at(i).to_int()
    if c >= 0x30 && c <= 0x39 {
      let d = int_to_double(c - 0x30)
      digits = digits + 1
      if dot {
        div = div * 10.0
        frac = frac + d / div
      } else {
        whole = whole * 10.0 + d
      }
    } else if c == 0x2E && !dot {
      dot = true
    } else {
      return None
    }
    i = i + 1
  }
  if digits == 0 {
    return None
  }
  let v = whole + frac
  let clamped = if v < 0.0 { 0.0 } else if v > 1.0 { 1.0 } else { v }
  Some(math_floor(clamped * 255.0 + 0.5).to_int())
}

///| Parses `#RRGGBB`, `#RRGGBBAA`, `rgb(r, g, b)`, or `rgba(r, g, b, a)` into `0xRRGGBBAAL`.
pub fn parse_devtools_color_swatch(raw : String) -> Option[Int64] {
  let s = raw.trim()
  if s == "" || s == "transparent" || s == "none" {
    return None
  }
  if s.starts_with("#") {
    let n = s.length()
    if n == 7 || n == 9 {
      let mut out : Int64 = 0L
      let mut i = 1
      while i < n {
        let d = dt_hex_digit(s.code_unit_at(i).to_int())
        if d < 0 {
          return None
        }
        out = (out << 4L) | d.to_int64()
        i = i + 1
      }
      if n == 7 {
        out = (out << 8L) | 0xFFL
      }
      return Some(out)
    }
    return None
  }
  let lower = omni_ascii_lower(s)
  let inner = if lower.starts_with("rgba(") && lower.ends_with(")") {
    s.slice(5, s.length() - 1)
  } else if lower.starts_with("rgb(") && lower.ends_with(")") {
    s.slice(4, s.length() - 1)
  } else {
    return None
  }
  let parts = inner.split(",")
  if parts.length() < 3 || parts.length() > 4 {
    return None
  }
  let r = match dt_parse_u8(parts[0]) {
    Some(v) => v
    None => return None
  }
  let g = match dt_parse_u8(parts[1]) {
    Some(v) => v
    None => return None
  }
  let b = match dt_parse_u8(parts[2]) {
    Some(v) => v
    None => return None
  }
  let a = if parts.length() == 4 {
    match dt_parse_alpha(parts[3]) {
      Some(v) => v
      None => return None
    }
  } else {
    255
  }
  if a == 0 {
    return None
  }
  Some((r.to_int64() << 24L) | (g.to_int64() << 16L) | (b.to_int64() << 8L) | a.to_int64())
}

fn dt_num_json(v : Double) -> String {
  format_devtools_px(v)
}

pub fn encode_devtools_snapshot(snap : DevToolsSnapshot) -> String {
  let node_parts : Array[String] = []
  let mut ni = 0
  while ni < snap.nodes.length() {
    let nd = snap.nodes[ni]
    let attr_parts : Array[String] = []
    let mut ai = 0
    while ai < nd.attrs.length() {
      let at = nd.attrs[ai]
      attr_parts.push("{\"n\":" + omni_json_escape(at.name) + ",\"v\":" + omni_json_escape(at.value) + "}")
      ai = ai + 1
    }
    node_parts.push(
      "{\"path\":" + omni_json_escape(nd.path) +
      ",\"depth\":" + nd.depth.to_string() +
      ",\"tag\":" + omni_json_escape(nd.tag) +
      ",\"id\":" + omni_json_escape(nd.id_attr) +
      ",\"cls\":" + omni_json_escape(nd.class_attr) +
      ",\"attrs\":[" + attr_parts.join(",") + "]" +
      ",\"text\":" + omni_json_escape(nd.text_preview) +
      ",\"children\":" + nd.child_count.to_string() + "}",
    )
    ni = ni + 1
  }
  let bm = snap.box_model
  let box_json =
  "{\"w\":" + dt_num_json(bm.width) +
  ",\"h\":" + dt_num_json(bm.height) +
  ",\"pt\":" + dt_num_json(bm.pad_top) +
  ",\"pr\":" + dt_num_json(bm.pad_right) +
  ",\"pb\":" + dt_num_json(bm.pad_bottom) +
  ",\"pl\":" + dt_num_json(bm.pad_left) +
  ",\"bt\":" + dt_num_json(bm.border_top) +
  ",\"br\":" + dt_num_json(bm.border_right) +
  ",\"bb\":" + dt_num_json(bm.border_bottom) +
  ",\"bl\":" + dt_num_json(bm.border_left) +
  ",\"mt\":" + dt_num_json(bm.margin_top) +
  ",\"mr\":" + dt_num_json(bm.margin_right) +
  ",\"mb\":" + dt_num_json(bm.margin_bottom) +
  ",\"ml\":" + dt_num_json(bm.margin_left) + "}"
  let style_parts : Array[String] = []
  let mut si = 0
  while si < snap.styles.length() {
    let sp = snap.styles[si]
    style_parts.push(
      "{\"n\":" + omni_json_escape(sp.name) +
      ",\"v\":" + omni_json_escape(sp.value) +
      ",\"c\":" + omni_json_escape(sp.color_hex) + "}",
    )
    si = si + 1
  }
  let console_parts : Array[String] = []
  let mut ci = 0
  while ci < snap.console_entries.length() {
    let ce = snap.console_entries[ci]
    console_parts.push(
      "{\"id\":" + ce.id.to_string() +
      ",\"level\":" + omni_json_escape(ce.level) +
      ",\"text\":" + omni_json_escape(ce.text) +
      ",\"src\":" + omni_json_escape(ce.source) + "}",
    )
    ci = ci + 1
  }
  let net_parts : Array[String] = []
  let mut ki = 0
  while ki < snap.network_entries.length() {
    let ne = snap.network_entries[ki]
    net_parts.push(
      "{\"name\":" + omni_json_escape(ne.name) +
      ",\"url\":" + omni_json_escape(ne.url) +
      ",\"kind\":" + omni_json_escape(ne.kind) +
      ",\"status\":" + ne.status.to_string() +
      ",\"ms\":" + ne.duration_ms.to_string() +
      ",\"bytes\":" + ne.size_bytes.to_string() + "}",
    )
    ki = ki + 1
  }
  "{\"url\":" + omni_json_escape(snap.page_url) +
  ",\"title\":" + omni_json_escape(snap.page_title) +
  ",\"selectedPath\":" + omni_json_escape(snap.selected_path) +
  ",\"nodes\":[" + node_parts.join(",") + "]" +
  ",\"box\":" + box_json +
  ",\"styles\":[" + style_parts.join(",") + "]" +
  ",\"console\":[" + console_parts.join(",") + "]" +
  ",\"network\":[" + net_parts.join(",") + "]}"
}

fn dt_parse_attr(p : OmniJsonParser) -> Option[DevToolsAttr] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut name = ""
  let mut value = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsAttr::{ name, value })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "n" || key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "v" || key == "value" {
      match p.parse_str() {
        Some(v) => value = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsAttr::{ name, value })
    } else {
      return None
    }
  }
  None
}

fn dt_parse_dom_node(p : OmniJsonParser) -> Option[DevToolsDomNode] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut path = ""
  let mut depth = 0
  let mut tag = ""
  let mut id_attr = ""
  let mut class_attr = ""
  let attrs : Array[DevToolsAttr] = []
  let mut text_preview = ""
  let mut child_count = 0
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsDomNode::{ path, depth, tag, id_attr, class_attr, attrs, text_preview, child_count })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "path" {
      match p.parse_str() {
        Some(v) => path = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "depth" {
      match p.parse_number() {
        Some(v) => depth = math_floor(v + 0.5).to_int()
        None => if !p.skip_value() { return None }
      }
    } else if key == "tag" {
      match p.parse_str() {
        Some(v) => tag = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "id" || key == "idAttr" {
      match p.parse_str() {
        Some(v) => id_attr = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "cls" || key == "class" || key == "classAttr" {
      match p.parse_str() {
        Some(v) => class_attr = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "text" || key == "textPreview" {
      match p.parse_str() {
        Some(v) => text_preview = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "children" || key == "childCount" {
      match p.parse_number() {
        Some(v) => child_count = math_floor(v + 0.5).to_int()
        None => if !p.skip_value() { return None }
      }
    } else if key == "attrs" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match dt_parse_attr(p) {
            Some(at) => if at.name != "" { attrs.push(at) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsDomNode::{ path, depth, tag, id_attr, class_attr, attrs, text_preview, child_count })
    } else {
      return None
    }
  }
  None
}

fn dt_parse_box_model(p : OmniJsonParser) -> Option[DevToolsBoxModel] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut width = 0.0
  let mut height = 0.0
  let mut pad_top = 0.0
  let mut pad_right = 0.0
  let mut pad_bottom = 0.0
  let mut pad_left = 0.0
  let mut border_top = 0.0
  let mut border_right = 0.0
  let mut border_bottom = 0.0
  let mut border_left = 0.0
  let mut margin_top = 0.0
  let mut margin_right = 0.0
  let mut margin_bottom = 0.0
  let mut margin_left = 0.0
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsBoxModel::empty())
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    match p.parse_number() {
      Some(v) =>
      if key == "w" || key == "width" {
        width = v
      } else if key == "h" || key == "height" {
        height = v
      } else if key == "pt" {
        pad_top = v
      } else if key == "pr" {
        pad_right = v
      } else if key == "pb" {
        pad_bottom = v
      } else if key == "pl" {
        pad_left = v
      } else if key == "bt" {
        border_top = v
      } else if key == "br" {
        border_right = v
      } else if key == "bb" {
        border_bottom = v
      } else if key == "bl" {
        border_left = v
      } else if key == "mt" {
        margin_top = v
      } else if key == "mr" {
        margin_right = v
      } else if key == "mb" {
        margin_bottom = v
      } else if key == "ml" {
        margin_left = v
      }
      None => if !p.skip_value() { return None }
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsBoxModel::{
        width,
        height,
        pad_top,
        pad_right,
        pad_bottom,
        pad_left,
        border_top,
        border_right,
        border_bottom,
        border_left,
        margin_top,
        margin_right,
        margin_bottom,
        margin_left,
      })
    } else {
      return None
    }
  }
  None
}

fn dt_parse_style_prop(p : OmniJsonParser) -> Option[DevToolsStyleProp] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut name = ""
  let mut value = ""
  let mut color_hex = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsStyleProp::{ name, value, color_hex })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "n" || key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "v" || key == "value" {
      match p.parse_str() {
        Some(v) => value = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "c" || key == "color" || key == "colorHex" {
      match p.parse_str() {
        Some(v) => color_hex = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsStyleProp::{ name, value, color_hex })
    } else {
      return None
    }
  }
  None
}

fn dt_parse_console_entry(p : OmniJsonParser) -> Option[DevToolsConsoleEntry] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut id = 0
  let mut level = "log"
  let mut text = ""
  let mut source = ""
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsConsoleEntry::{ id, level, text, source })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "id" {
      match p.parse_number() {
        Some(v) => id = math_floor(v + 0.5).to_int()
        None => if !p.skip_value() { return None }
      }
    } else if key == "level" {
      match p.parse_str() {
        Some(v) => level = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "text" {
      match p.parse_str() {
        Some(v) => text = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "src" || key == "source" {
      match p.parse_str() {
        Some(v) => source = v
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsConsoleEntry::{ id, level, text, source })
    } else {
      return None
    }
  }
  None
}

fn dt_parse_network_entry(p : OmniJsonParser) -> Option[DevToolsNetworkEntry] {
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut name = ""
  let mut url = ""
  let mut kind = "other"
  let mut status = 200
  let mut duration_ms = 0
  let mut size_bytes = 0
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsNetworkEntry::{ name, url, kind, status, duration_ms, size_bytes })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "name" {
      match p.parse_str() {
        Some(v) => name = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "url" {
      match p.parse_str() {
        Some(v) => url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "kind" || key == "type" {
      match p.parse_str() {
        Some(v) => kind = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "status" {
      match p.parse_number() {
        Some(v) => status = math_floor(v + 0.5).to_int()
        None => if !p.skip_value() { return None }
      }
    } else if key == "ms" || key == "durationMs" {
      match p.parse_number() {
        Some(v) => duration_ms = math_floor(v + 0.5).to_int()
        None => if !p.skip_value() { return None }
      }
    } else if key == "bytes" || key == "sizeBytes" {
      match p.parse_number() {
        Some(v) => size_bytes = math_floor(v + 0.5).to_int()
        None => if !p.skip_value() { return None }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsNetworkEntry::{ name, url, kind, status, duration_ms, size_bytes })
    } else {
      return None
    }
  }
  None
}

///| Parses a `DevToolsSnapshot` JSON payload from `wire::Message::DevToolsState`.
///| Returns `None` on malformed or truncated JSON (never panics).
pub fn parse_devtools_snapshot(json : String) -> Option[DevToolsSnapshot] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  p.skip_ws()
  if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x7B {
    return None
  }
  p.i = p.i + 1
  let mut page_url = ""
  let mut page_title = ""
  let mut selected_path = ""
  let nodes : Array[DevToolsDomNode] = []
  let mut box_model = DevToolsBoxModel::empty()
  let styles : Array[DevToolsStyleProp] = []
  let console_entries : Array[DevToolsConsoleEntry] = []
  let network_entries : Array[DevToolsNetworkEntry] = []
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
    p.i = p.i + 1
    return Some(DevToolsSnapshot::{ page_url, page_title, selected_path, nodes, box_model, styles, console_entries, network_entries })
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    p.skip_ws()
    if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x3A {
      return None
    }
    p.i = p.i + 1
    p.skip_ws()
    if key == "url" || key == "pageUrl" {
      match p.parse_str() {
        Some(v) => page_url = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "title" || key == "pageTitle" {
      match p.parse_str() {
        Some(v) => page_title = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "selectedPath" || key == "selected_path" {
      match p.parse_str() {
        Some(v) => selected_path = v
        None => if !p.skip_value() { return None }
      }
    } else if key == "box" || key == "boxModel" {
      match dt_parse_box_model(p) {
        Some(bm) => box_model = bm
        None => return None
      }
    } else if key == "nodes" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match dt_parse_dom_node(p) {
            Some(nd) => if nd.tag != "" { nodes.push(nd) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "styles" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match dt_parse_style_prop(p) {
            Some(sp) => if sp.name != "" { styles.push(sp) }
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "console" || key == "consoleEntries" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match dt_parse_console_entry(p) {
            Some(ce) => console_entries.push(ce)
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if key == "network" || key == "networkEntries" {
      if p.i >= p.n || p.s.code_unit_at(p.i).to_int() != 0x5B {
        return None
      }
      p.i = p.i + 1
      p.skip_ws()
      if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
        p.i = p.i + 1
      } else {
        let mut arr_ok = false
        while p.i < p.n {
          match dt_parse_network_entry(p) {
            Some(ne) => network_entries.push(ne)
            None => return None
          }
          p.skip_ws()
          if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
            p.i = p.i + 1
          } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x5D {
            p.i = p.i + 1
            arr_ok = true
            break
          } else {
            return None
          }
        }
        if !arr_ok {
          return None
        }
      }
    } else if !p.skip_value() {
      return None
    }
    p.skip_ws()
    if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x2C {
      p.i = p.i + 1
    } else if p.i < p.n && p.s.code_unit_at(p.i).to_int() == 0x7D {
      p.i = p.i + 1
      return Some(DevToolsSnapshot::{ page_url, page_title, selected_path, nodes, box_model, styles, console_entries, network_entries })
    } else {
      return None
    }
  }
  None
}
