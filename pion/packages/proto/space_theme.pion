///| Space themes (Arc's Space theme picker): one to three color points on a canvas (x = hue, y = light to deep),
///| an appearance per Space (auto / light / dark), grain and intensity. A Space saved before themes existed has
///| only an accent: it reads as an unset theme, and `space_theme_effective` derives one point from the accent that
///| keeps the accent's exact color, so the frame looks as it did.

pub let SPACE_THEME_MAX_POINTS : Int = 3

///| Intensity of a theme derived from an accent: the frame mixes ~11% of it into the paper, as before themes.
pub let SPACE_THEME_DEFAULT_INTENSITY : Double = 0.25

#derive(Eq)
pub enum SpaceThemeMode {
  Auto
  Light
  Dark
}

pub fn SpaceThemeMode::name(self : SpaceThemeMode) -> String {
  match self {
    SpaceThemeMode::Auto => "auto"
    SpaceThemeMode::Light => "light"
    SpaceThemeMode::Dark => "dark"
  }
}

pub fn space_theme_mode_parse(raw : String) -> SpaceThemeMode {
  let k = omni_ascii_lower(raw.trim())
  if k == "light" {
    SpaceThemeMode::Light
  } else if k == "dark" {
    SpaceThemeMode::Dark
  } else {
    SpaceThemeMode::Auto
  }
}

pub fn SpaceThemeMode::same(self : SpaceThemeMode, other : SpaceThemeMode) -> Bool {
  self.name() == other.name()
}

///| One color point: where it sits on the canvas (0..1 each way) and the color it stands for. The color is kept
///| with the point so an accent-derived point keeps the accent exactly.
#derive(Eq)
pub struct SpaceThemePoint {
  pub x : Double
  pub y : Double
  pub rgba : Int64
}

pub struct SpaceTheme {
  pub points : Array[SpaceThemePoint]
  pub mode : SpaceThemeMode
  pub grain : Double
  pub intensity : Double
}

pub impl Eq for SpaceTheme {
  fn equal(self : SpaceTheme, other : SpaceTheme) -> Bool {
    self.same(other)
  }
}

fn st_clamp01(v : Double) -> Double {
  if v < 0.0 {
    0.0
  } else if v > 1.0 {
    1.0
  } else {
    v
  }
}

///| A theme with no points: the Space's accent decides its one color (what every Space saved before themes is).
pub fn space_theme_unset() -> SpaceTheme {
  SpaceTheme::{ points: [], mode: SpaceThemeMode::Auto, grain: 0.0, intensity: SPACE_THEME_DEFAULT_INTENSITY }
}

pub fn SpaceTheme::is_unset(self : SpaceTheme) -> Bool {
  self.points.length() == 0
}

pub fn SpaceTheme::same(self : SpaceTheme, other : SpaceTheme) -> Bool {
  if self.points.length() != other.points.length() || !self.mode.same(other.mode) {
    return false
  }
  if (self.grain - other.grain).abs() > 0.0005 || (self.intensity - other.intensity).abs() > 0.0005 {
    return false
  }
  let mut i = 0
  while i < self.points.length() {
    let a = self.points[i]
    let b = other.points[i]
    if a.rgba != b.rgba || (a.x - b.x).abs() > 0.0005 || (a.y - b.y).abs() > 0.0005 {
      return false
    }
    i += 1
  }
  true
}

fn st_hue_to_rgb(p : Double, q : Double, t0 : Double) -> Double {
  let t = if t0 < 0.0 {
    t0 + 1.0
  } else if t0 > 1.0 {
    t0 - 1.0
  } else {
    t0
  }
  if t < 1.0 / 6.0 {
    p + (q - p) * 6.0 * t
  } else if t < 0.5 {
    q
  } else if t < 2.0 / 3.0 {
    p + (q - p) * (2.0 / 3.0 - t) * 6.0
  } else {
    p
  }
}

fn st_byte(v : Double) -> Int64 {
  let r = (st_clamp01(v) * 255.0 + 0.5).floor().to_int64()
  if r < 0L {
    0L
  } else if r > 255L {
    255L
  } else {
    r
  }
}

///| HSL (each 0..1) as opaque `0xRRGGBBFF`.
pub fn space_theme_hsl(h : Double, s : Double, l : Double) -> Int64 {
  if s <= 0.0 {
    let g = st_byte(l)
    return (g << 24) | (g << 16) | (g << 8) | 0xFFL
  }
  let q = if l < 0.5 { l * (1.0 + s) } else { l + s - l * s }
  let p = 2.0 * l - q
  let r = st_byte(st_hue_to_rgb(p, q, h + 1.0 / 3.0))
  let g = st_byte(st_hue_to_rgb(p, q, h))
  let b = st_byte(st_hue_to_rgb(p, q, h - 1.0 / 3.0))
  (r << 24) | (g << 16) | (b << 8) | 0xFFL
}

///| `0xRRGGBBAA` as HSL (each 0..1).
pub fn space_theme_to_hsl(rgba : Int64) -> (Double, Double, Double) {
  let r = ((rgba >> 24) & 0xFFL).to_double() / 255.0
  let g = ((rgba >> 16) & 0xFFL).to_double() / 255.0
  let b = ((rgba >> 8) & 0xFFL).to_double() / 255.0
  let mx = if r > g { if r > b { r } else { b } } else if g > b { g } else { b }
  let mn = if r < g { if r < b { r } else { b } } else if g < b { g } else { b }
  let l = (mx + mn) / 2.0
  let d = mx - mn
  if d <= 0.0 {
    return (0.0, 0.0, l)
  }
  let s = if l > 0.5 { d / (2.0 - mx - mn) } else { d / (mx + mn) }
  let h6 = if mx == r {
    (g - b) / d + (if g < b { 6.0 } else { 0.0 })
  } else if mx == g {
    (b - r) / d + 2.0
  } else {
    (r - g) / d + 4.0
  }
  (h6 / 6.0, s, l)
}

let ST_SAT : Double = 0.72
let ST_L_TOP : Double = 0.90
let ST_L_SPAN : Double = 0.56

///| The color at a canvas position: hue across, from light (top) to deep (bottom).
pub fn space_theme_color_at(x : Double, y : Double) -> Int64 {
  space_theme_hsl(st_clamp01(x), ST_SAT, ST_L_TOP - ST_L_SPAN * st_clamp01(y))
}

///| Where a color sits on the canvas (the inverse of `space_theme_color_at`, near enough for any color).
pub fn space_theme_position_of(rgba : Int64) -> (Double, Double) {
  let (h, _, l) = space_theme_to_hsl(rgba)
  (st_clamp01(h), st_clamp01((ST_L_TOP - l) / ST_L_SPAN))
}

pub fn space_theme_point_at(x : Double, y : Double) -> SpaceThemePoint {
  SpaceThemePoint::{ x: st_clamp01(x), y: st_clamp01(y), rgba: space_theme_color_at(x, y) }
}

///| One point for an accent: at the accent's place on the canvas, keeping the accent's exact color.
pub fn space_theme_from_accent(accent : String) -> SpaceTheme {
  let rgba = workspace_accent_color(normalize_space_accent(accent))
  let (x, y) = space_theme_position_of(rgba)
  SpaceTheme::{ ..space_theme_unset(), points: [SpaceThemePoint::{ x, y, rgba }] }
}

///| The theme a Space draws with: its own, or (unset) one point from its accent with the unset theme's settings.
pub fn space_theme_effective(theme : SpaceTheme, accent : String) -> SpaceTheme {
  if theme.is_unset() {
    let derived = space_theme_from_accent(accent)
    SpaceTheme::{ ..theme, points: derived.points }
  } else {
    theme
  }
}

///| `0xRRGGBBAA` as `#RRGGBB`.
pub fn space_theme_hex(rgba : Int64) -> String {
  let digits = "0123456789ABCDEF"
  let sb = StringBuilder::new()
  sb.write_string("#")
  let mut shift = 28
  while shift >= 8 {
    let nib = ((rgba >> shift) & 0xFL).to_int()
    sb.write_string(digits.slice(nib, nib + 1))
    shift -= 4
  }
  sb.to_string()
}

///| The accent a themed Space reports to everything that shows one color (its first point).
pub fn space_theme_accent_hex(theme : SpaceTheme, fallback : String) -> String {
  if theme.points.length() > 0 {
    space_theme_hex(theme.points[0].rgba)
  } else {
    normalize_space_accent(fallback)
  }
}

///| The theme with one more point (at most three), placed a third of the way round the hue circle from the last.
pub fn space_theme_add_point(theme : SpaceTheme) -> SpaceTheme {
  let n = theme.points.length()
  if n >= SPACE_THEME_MAX_POINTS {
    return theme
  }
  let next = if n == 0 {
    space_theme_point_at(0.6, 0.35)
  } else {
    let last = theme.points[n - 1]
    let mut nx = last.x + 0.33
    if nx > 1.0 {
      nx = nx - 1.0
    }
    let ny = if last.y > 0.6 { last.y - 0.2 } else { last.y + 0.12 }
    space_theme_point_at(nx, ny)
  }
  let pts = theme.points.copy()
  pts.push(next)
  SpaceTheme::{ ..theme, points: pts }
}

///| The theme without point `idx` (a theme keeps at least one point).
pub fn space_theme_remove_point(theme : SpaceTheme, idx : Int) -> SpaceTheme {
  if theme.points.length() <= 1 || idx < 0 || idx >= theme.points.length() {
    return theme
  }
  let pts : Array[SpaceThemePoint] = []
  let mut i = 0
  while i < theme.points.length() {
    if i != idx {
      pts.push(theme.points[i])
    }
    i += 1
  }
  SpaceTheme::{ ..theme, points: pts }
}

///| The theme with point `idx` moved to `(x, y)` (its color follows the canvas).
pub fn space_theme_move_point(theme : SpaceTheme, idx : Int, x : Double, y : Double) -> SpaceTheme {
  if idx < 0 || idx >= theme.points.length() {
    return theme
  }
  let pts = theme.points.copy()
  pts[idx] = space_theme_point_at(x, y)
  SpaceTheme::{ ..theme, points: pts }
}

pub fn space_theme_with_mode(theme : SpaceTheme, mode : SpaceThemeMode) -> SpaceTheme {
  SpaceTheme::{ ..theme, mode: mode }
}

pub fn space_theme_with_grain(theme : SpaceTheme, grain : Double) -> SpaceTheme {
  SpaceTheme::{ ..theme, grain: st_clamp01(grain) }
}

pub fn space_theme_with_intensity(theme : SpaceTheme, intensity : Double) -> SpaceTheme {
  SpaceTheme::{ ..theme, intensity: st_clamp01(intensity) }
}

// ============================================================================
// Presets: curated themes for the swatch row
// ============================================================================

pub struct SpaceThemePreset {
  pub key : String
  pub label : String
  pub theme : SpaceTheme
}

fn st_preset(key : String, label : String, spots : Array[(Double, Double)]) -> SpaceThemePreset {
  let pts : Array[SpaceThemePoint] = []
  for s in spots {
    pts.push(space_theme_point_at(s.0, s.1))
  }
  SpaceThemePreset::{ key, label, theme: SpaceTheme::{ ..space_theme_unset(), points: pts, intensity: 0.4 } }
}

///| The swatch row's themes, in the order shown: single colors round the hue circle, then blends. A preset is a
///| choice of colors: applying one sets the points and keeps the Space's appearance, grain and intensity.
pub fn space_theme_presets() -> Array[SpaceThemePreset] {
  [
    st_preset("paper", "Paper", [(0.10, 0.04)]),
    st_preset("blossom", "Blossom", [(0.93, 0.34)]),
    st_preset("plum", "Plum", [(0.83, 0.56)]),
    st_preset("coral", "Coral", [(0.99, 0.44)]),
    st_preset("tangerine", "Tangerine", [(0.06, 0.42)]),
    st_preset("sunlight", "Sunlight", [(0.13, 0.34)]),
    st_preset("mint", "Mint", [(0.42, 0.40)]),
    st_preset("sky", "Sky", [(0.55, 0.38)]),
    st_preset("dusk", "Dusk", [(0.66, 0.72)]),
    st_preset("sunset", "Sunset", [(0.06, 0.40), (0.94, 0.34), (0.78, 0.56)]),
    st_preset("aurora", "Aurora", [(0.40, 0.46), (0.50, 0.40), (0.75, 0.52)]),
    st_preset("lagoon", "Lagoon", [(0.50, 0.34), (0.60, 0.50)]),
    st_preset("peach", "Peach", [(0.05, 0.20), (0.95, 0.20)]),
    st_preset("midnight", "Midnight", [(0.62, 0.80), (0.72, 0.74)]),
  ]
}

// ============================================================================
// JSON: {"points":[{"x":0.5,"y":0.3,"c":"#AABBCC"}],"mode":"auto","grain":0.2,"intensity":0.5}
// ============================================================================

///| A 0..1 value as at most three decimals ("0.25", "1", "0").
fn st_fmt(v : Double) -> String {
  let k = (st_clamp01(v) * 1000.0 + 0.5).floor().to_int()
  if k >= 1000 {
    return "1"
  }
  if k <= 0 {
    return "0"
  }
  let mut frac = k.to_string()
  while frac.length() < 3 {
    frac = "0" + frac
  }
  while frac.length() > 0 && frac.ends_with("0") {
    frac = frac.slice(0, frac.length() - 1)
  }
  "0." + frac
}

pub fn encode_space_theme(theme : SpaceTheme) -> String {
  let parts : Array[String] = []
  for p in theme.points {
    parts.push(
      "{\"x\":" + st_fmt(p.x) + ",\"y\":" + st_fmt(p.y) + ",\"c\":" + omni_json_escape(space_theme_hex(p.rgba)) + "}",
    )
  }
  "{\"points\":[" +
  parts.join(",") +
  "],\"mode\":" +
  omni_json_escape(theme.mode.name()) +
  ",\"grain\":" +
  st_fmt(theme.grain) +
  ",\"intensity\":" +
  st_fmt(theme.intensity) +
  "}"
}

fn st_expect(p : OmniJsonParser, ch : Int) -> Bool {
  p.skip_ws()
  if p.i < p.n && p.s.code_unit_at(p.i).to_int() == ch {
    p.i = p.i + 1
    true
  } else {
    false
  }
}

fn st_parse_point(p : OmniJsonParser) -> Option[SpaceThemePoint] {
  if !st_expect(p, 0x7B) {
    return None
  }
  let mut x = 0.5
  let mut y = 0.5
  let mut color = ""
  if st_expect(p, 0x7D) {
    return Some(space_theme_point_at(x, y))
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    if !st_expect(p, 0x3A) {
      return None
    }
    if key == "x" {
      match p.parse_number() {
        Some(v) => x = st_clamp01(v)
        None => return None
      }
    } else if key == "y" {
      match p.parse_number() {
        Some(v) => y = st_clamp01(v)
        None => return None
      }
    } else if key == "c" {
      match p.parse_str() {
        Some(v) => color = v
        None => return None
      }
    } else if !p.skip_value() {
      return None
    }
    if st_expect(p, 0x2C) {
      continue
    }
    if st_expect(p, 0x7D) {
      let rgba = if color != "" && normalize_space_accent(color) == normalize_space_accent_strict(color) {
        workspace_accent_color(color)
      } else {
        space_theme_color_at(x, y)
      }
      return Some(SpaceThemePoint::{ x, y, rgba })
    }
    return None
  }
  None
}

///| `#RRGGBB` normalized when it is one, "" otherwise (unlike `normalize_space_accent`, no fallback).
fn normalize_space_accent_strict(raw : String) -> String {
  let s = raw.trim()
  let start = if s.starts_with("#") { 1 } else { 0 }
  if s.length() - start != 6 {
    return ""
  }
  let mut i = 0
  while i < 6 {
    let c = s.code_unit_at(start + i).to_int()
    let ok = (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
    if !ok {
      return ""
    }
    i += 1
  }
  normalize_space_accent(s)
}

fn st_parse_theme(p : OmniJsonParser) -> Option[SpaceTheme] {
  if !st_expect(p, 0x7B) {
    return None
  }
  let pts : Array[SpaceThemePoint] = []
  let mut mode = SpaceThemeMode::Auto
  let mut grain = 0.0
  let mut intensity = SPACE_THEME_DEFAULT_INTENSITY
  if st_expect(p, 0x7D) {
    return Some(space_theme_unset())
  }
  while p.i < p.n {
    let key = match p.parse_str() {
      Some(k) => k
      None => return None
    }
    if !st_expect(p, 0x3A) {
      return None
    }
    if key == "points" {
      if !st_expect(p, 0x5B) {
        return None
      }
      if !st_expect(p, 0x5D) {
        while true {
          match st_parse_point(p) {
            Some(pt) => if pts.length() < SPACE_THEME_MAX_POINTS { pts.push(pt) }
            None => return None
          }
          if st_expect(p, 0x2C) {
            continue
          }
          if st_expect(p, 0x5D) {
            break
          }
          return None
        }
      }
    } else if key == "mode" {
      match p.parse_str() {
        Some(v) => mode = space_theme_mode_parse(v)
        None => return None
      }
    } else if key == "grain" {
      match p.parse_number() {
        Some(v) => grain = st_clamp01(v)
        None => return None
      }
    } else if key == "intensity" {
      match p.parse_number() {
        Some(v) => intensity = st_clamp01(v)
        None => return None
      }
    } else if !p.skip_value() {
      return None
    }
    if st_expect(p, 0x2C) {
      continue
    }
    if st_expect(p, 0x7D) {
      return Some(SpaceTheme::{ points: pts, mode, grain, intensity })
    }
    return None
  }
  None
}

///| Parses `encode_space_theme`'s JSON (unknown keys skipped, values clamped, at most three points); None when
///| it is not a theme object.
pub fn decode_space_theme(json : String) -> Option[SpaceTheme] {
  let p = OmniJsonParser::{ s: json, n: json.length(), i: 0 }
  match st_parse_theme(p) {
    Some(t) => {
      p.skip_ws()
      if p.i == p.n { Some(t) } else { None }
    }
    None => None
  }
}

///| Reads a theme object at the parser's position (inside a larger document); unset when it is malformed but
///| skippable, None when the document cannot go on.
fn ws_parse_space_theme_value(p : OmniJsonParser) -> Option[SpaceTheme] {
  let start = p.i
  match st_parse_theme(p) {
    Some(t) => Some(t)
    None => {
      p.i = start
      if p.skip_value() { Some(space_theme_unset()) } else { None }
    }
  }
}
