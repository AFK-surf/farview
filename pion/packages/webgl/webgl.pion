///| Farview Wave G1: Real GPU WebGL 1.0 & WebGL 2.0 backend with pure-Pion GLSL ES 1.00/3.00 -> OpenGL 4.10 Core translation.

import "glsl"

// --- Core WebGL Constants ---
pub let gl_depth_buffer_bit : Int = 0x0100
pub let gl_stencil_buffer_bit : Int = 0x0400
pub let gl_color_buffer_bit : Int = 0x4000

pub let gl_points : Int = 0x0000
pub let gl_lines : Int = 0x0001
pub let gl_line_loop : Int = 0x0002
pub let gl_line_strip : Int = 0x0003
pub let gl_triangles : Int = 0x0004
pub let gl_triangle_strip : Int = 0x0005
pub let gl_triangle_fan : Int = 0x0006

pub let gl_array_buffer : Int = 0x8892
pub let gl_element_array_buffer : Int = 0x8893
pub let gl_stream_draw : Int = 0x88E0
pub let gl_static_draw : Int = 0x88E4
pub let gl_dynamic_draw : Int = 0x88E8

pub let gl_cull_face : Int = 0x0B44
pub let gl_blend : Int = 0x0BE2
pub let gl_dither : Int = 0x0BD0
pub let gl_stencil_test : Int = 0x0B90
pub let gl_depth_test : Int = 0x0B71
pub let gl_scissor_test : Int = 0x0C11
pub let gl_polygon_offset_fill : Int = 0x8037

pub let gl_byte : Int = 0x1400
pub let gl_unsigned_byte : Int = 0x1401
pub let gl_short : Int = 0x1402
pub let gl_unsigned_short : Int = 0x1403
pub let gl_int : Int = 0x1404
pub let gl_unsigned_int : Int = 0x1405
pub let gl_float : Int = 0x1406

pub let gl_depth_component : Int = 0x1902
pub let gl_alpha : Int = 0x1906
pub let gl_rgb : Int = 0x1907
pub let gl_rgba : Int = 0x1908
pub let gl_luminance : Int = 0x1909
pub let gl_luminance_alpha : Int = 0x190A
pub let gl_rgba8 : Int = 0x8058

pub let gl_fragment_shader : Int = 0x8B30
pub let gl_vertex_shader : Int = 0x8B31
pub let gl_shader_type : Int = 0x8B4F
pub let gl_delete_status : Int = 0x8B80
pub let gl_compile_status : Int = 0x8B81
pub let gl_link_status : Int = 0x8B82
pub let gl_validate_status : Int = 0x8B83
pub let gl_attached_shaders : Int = 0x8B85
pub let gl_active_uniforms : Int = 0x8B86
pub let gl_active_attributes : Int = 0x8B89

pub let gl_texture_2d : Int = 0x0DE1
pub let gl_texture0 : Int = 0x84C0
pub let gl_texture_mag_filter : Int = 0x2800
pub let gl_texture_min_filter : Int = 0x2801
pub let gl_texture_wrap_s : Int = 0x2802
pub let gl_texture_wrap_t : Int = 0x2803
pub let gl_nearest : Int = 0x2600
pub let gl_linear : Int = 0x2601
pub let gl_clamp_to_edge : Int = 0x812F
pub let gl_repeat : Int = 0x2901

pub let gl_framebuffer : Int = 0x8D40
pub let gl_renderbuffer : Int = 0x8D41
pub let gl_color_attachment0 : Int = 0x8CE0
pub let gl_depth_attachment : Int = 0x8D00
pub let gl_depth_stencil_attachment : Int = 0x821A
pub let gl_depth24_stencil8 : Int = 0x88F0
pub let gl_framebuffer_complete : Int = 0x8CD5

pub let gl_unpack_flip_y_webgl : Int = 0x9240
pub let gl_unpack_premultiply_alpha_webgl : Int = 0x9241

pub let gl_vendor : Int = 0x1F00
pub let gl_renderer : Int = 0x1F01
pub let gl_version : Int = 0x1F02
pub let gl_shading_language_version : Int = 0x8B8C
pub let gl_max_texture_size : Int = 0x0D33
pub let gl_viewport : Int = 0x0BA2
pub let gl_less : Int = 0x0201
pub let gl_lequal : Int = 0x0203

