// --- Shader Source & GLSL ES 1.00/3.00 -> OpenGL 4.10 Core Translation State ---

let shader_orig_src : Map[String, String] = Map::new()
let shader_trans_src : Map[String, String] = Map::new()
let shader_trans_err : Map[String, String] = Map::new()

fn shader_key(ctx_id : Int, shader : Int) -> String {
  ctx_id.to_string() + ":" + shader.to_string()
}

pub fn create(width : Int, height : Int, is_webgl2 : Bool) -> Int {
  c_create(width, height, if is_webgl2 { 1 } else { 0 })
}

pub fn destroy(ctx_id : Int) -> Unit {
  let prefix = ctx_id.to_string() + ":"
  let keys = shader_orig_src.keys()
  let mut i = 0
  while i < keys.length() {
    let k = keys[i]
    if k.starts_with(prefix) {
      let _ = shader_orig_src.remove(k)
      let _ = shader_trans_src.remove(k)
      let _ = shader_trans_err.remove(k)
    }
    i = i + 1
  }
  c_destroy(ctx_id)
}

fn keep_bytes_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

pub fn shader_source(ctx_id : Int, shader : Int, source : String) -> Unit {
  let k = shader_key(ctx_id, shader)
  shader_orig_src.set(k, source)
  let stype = c_get_shader_iv(ctx_id, shader, gl_shader_type)
  let stage = if stype == gl_fragment_shader {
    glsl::ShaderStage::Fragment
  } else {
    glsl::ShaderStage::Vertex
  }
  match glsl::translate_to_glsl410(source, stage) {
    Ok(tr) => {
      shader_trans_src.set(k, tr.glsl410)
      let _ = shader_trans_err.remove(k)
      let bs = tr.glsl410.to_bytes()
      if bs.length() > 0 {
        c_shader_source(ctx_id, shader, bytes_data_ptr(bs), bs.length())
        keep_bytes_alive(bs)
      }
    }
    Err(e) => {
      let _ = shader_trans_src.remove(k)
      shader_trans_err.set(k, "GLSL ES translate error: " + glsl::glsl_error_message(e))
      let bad = "#version 410 core\n#error GLSL ES translation failed\n".to_bytes()
      c_shader_source(ctx_id, shader, bytes_data_ptr(bad), bad.length())
      keep_bytes_alive(bad)
    }
  }
}

pub fn compile_shader(ctx_id : Int, shader : Int) -> Unit {
  let k = shader_key(ctx_id, shader)
  match shader_trans_err.get(k) {
    Some(_) => ()
    None => c_compile_shader(ctx_id, shader)
  }
}

pub fn get_shader_iv(ctx_id : Int, shader : Int, pname : Int) -> Int {
  if pname == gl_compile_status {
    let k = shader_key(ctx_id, shader)
    match shader_trans_err.get(k) {
      Some(_) => return 0
      None => ()
    }
  }
  c_get_shader_iv(ctx_id, shader, pname)
}

pub fn get_shader_info_log(ctx_id : Int, shader : Int) -> String {
  let k = shader_key(ctx_id, shader)
  match shader_trans_err.get(k) {
    Some(err) => return err
    None => ()
  }
  let buf = Bytes::new(4096)
  let n = c_get_shader_info_log(ctx_id, shader, bytes_data_ptr(buf), 4096)
  if n <= 0 {
    ""
  } else {
    buf.slice(0, n).to_string()
  }
}

pub fn get_shader_source(ctx_id : Int, shader : Int) -> String {
  match shader_orig_src.get(shader_key(ctx_id, shader)) {
    Some(s) => s
    None => ""
  }
}

pub fn get_translated_shader_source(ctx_id : Int, shader : Int) -> String {
  match shader_trans_src.get(shader_key(ctx_id, shader)) {
    Some(s) => s
    None => ""
  }
}

pub fn delete_shader(ctx_id : Int, shader : Int) -> Unit {
  let k = shader_key(ctx_id, shader)
  let _ = shader_orig_src.remove(k)
  let _ = shader_trans_src.remove(k)
  let _ = shader_trans_err.remove(k)
  c_delete_shader(ctx_id, shader)
}

pub fn get_program_info_log(ctx_id : Int, program : Int) -> String {
  let buf = Bytes::new(4096)
  let n = c_get_program_info_log(ctx_id, program, bytes_data_ptr(buf), 4096)
  if n <= 0 {
    ""
  } else {
    buf.slice(0, n).to_string()
  }
}

fn unmangle_glsl_name(name : String) -> String {
  if name.starts_with("_fv_u_") {
    name.slice(6, name.length())
  } else {
    name
  }
}

pub fn get_attrib_location(ctx_id : Int, program : Int, name : String) -> Int {
  let loc = c_get_attrib_location(ctx_id, program, str_data_ptr(name), name.length())
  if loc >= 0 || name.starts_with("_fv_u_") {
    return loc
  }
  let m = "_fv_u_" + name
  c_get_attrib_location(ctx_id, program, str_data_ptr(m), m.length())
}

pub fn bind_attrib_location(ctx_id : Int, program : Int, index : Int, name : String) -> Unit {
  c_bind_attrib_location(ctx_id, program, index, str_data_ptr(name), name.length())
  if !name.starts_with("_fv_u_") {
    let m = "_fv_u_" + name
    c_bind_attrib_location(ctx_id, program, index, str_data_ptr(m), m.length())
  }
}

pub fn get_uniform_location(ctx_id : Int, program : Int, name : String) -> Int {
  let loc = c_get_uniform_location(ctx_id, program, str_data_ptr(name), name.length())
  if loc >= 0 || name.starts_with("_fv_u_") {
    return loc
  }
  let m = "_fv_u_" + name
  c_get_uniform_location(ctx_id, program, str_data_ptr(m), m.length())
}

pub fn get_uniform_block_index(ctx_id : Int, program : Int, name : String) -> Int {
  let idx = c_get_uniform_block_index(ctx_id, program, str_data_ptr(name), name.length())
  if idx != -1 && idx != 0x7FFFFFFF || name.starts_with("_fv_u_") {
    return idx
  }
  let m = "_fv_u_" + name
  c_get_uniform_block_index(ctx_id, program, str_data_ptr(m), m.length())
}

pub fn get_active_attrib(ctx_id : Int, program : Int, index : Int) -> Option[(Int, Int, String)] {
  let buf = Bytes::new(1024)
  let n = c_get_active_attrib(ctx_id, program, index, bytes_data_ptr(buf), 1024)
  if n <= 0 {
    return None
  }
  let parts = buf.slice(0, n).to_string().split("\t")
  if parts.length() < 3 {
    return None
  }
  let sz = parts[0].to_int().unwrap_or(1)
  let ty = parts[1].to_int().unwrap_or(0)
  Some((sz, ty, unmangle_glsl_name(parts[2])))
}

pub fn get_active_uniform(ctx_id : Int, program : Int, index : Int) -> Option[(Int, Int, String)] {
  let buf = Bytes::new(1024)
  let n = c_get_active_uniform(ctx_id, program, index, bytes_data_ptr(buf), 1024)
  if n <= 0 {
    return None
  }
  let parts = buf.slice(0, n).to_string().split("\t")
  if parts.length() < 3 {
    return None
  }
  let sz = parts[0].to_int().unwrap_or(1)
  let ty = parts[1].to_int().unwrap_or(0)
  Some((sz, ty, unmangle_glsl_name(parts[2])))
}

// --- Buffers, Uniforms, Textures ---

pub fn buffer_data_size(ctx_id : Int, target : Int, size : Int, usage : Int) -> Unit {
  let dummy = Bytes::new(1)
  c_buffer_data(ctx_id, target, size, bytes_data_ptr(dummy), 0, usage)
  keep_bytes_alive(dummy)
}

pub fn buffer_data_bytes(ctx_id : Int, target : Int, data : Bytes, usage : Int) -> Unit {
  if data.length() == 0 {
    buffer_data_size(ctx_id, target, 0, usage)
  } else {
    c_buffer_data(ctx_id, target, data.length(), bytes_data_ptr(data), 1, usage)
    keep_bytes_alive(data)
  }
}

pub fn buffer_sub_data_bytes(ctx_id : Int, target : Int, offset : Int, data : Bytes) -> Unit {
  if data.length() > 0 {
    c_buffer_sub_data(ctx_id, target, offset, data.length(), bytes_data_ptr(data))
    keep_bytes_alive(data)
  }
}

pub fn pack_f32s(vals : Array[Double]) -> Bytes {
  let n = vals.length()
  let out = Bytes::new(n * 4)
  let ptr = bytes_data_ptr(out)
  let mut i = 0
  while i < n {
    c_write_f32(ptr, i * 4, vals[i])
    i = i + 1
  }
  out
}

pub fn pack_i32s(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let out = Bytes::new(n * 4)
  let ptr = bytes_data_ptr(out)
  let mut i = 0
  while i < n {
    c_write_i32(ptr, i * 4, vals[i])
    i = i + 1
  }
  out
}

pub fn pack_u16s(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = vals[i] & 0xFFFF
    out[i * 2] = (v & 0xFF).to_byte()
    out[i * 2 + 1] = ((v >> 8) & 0xFF).to_byte()
    i = i + 1
  }
  out
}

pub fn vertex_attrib_fv(ctx_id : Int, index : Int, dim : Int, vals : Array[Double]) -> Unit {
  if vals.length() < dim {
    return
  }
  let b = pack_f32s(vals)
  c_vertex_attrib_fv(ctx_id, index, dim, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn uniform_fv(ctx_id : Int, loc : Int, dim : Int, vals : Array[Double]) -> Unit {
  if dim <= 0 || vals.length() < dim {
    return
  }
  let count = vals.length() / dim
  let b = pack_f32s(vals)
  c_uniform_fv(ctx_id, loc, dim, count, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn uniform_iv(ctx_id : Int, loc : Int, dim : Int, vals : Array[Int]) -> Unit {
  if dim <= 0 || vals.length() < dim {
    return
  }
  let count = vals.length() / dim
  let b = pack_i32s(vals)
  c_uniform_iv(ctx_id, loc, dim, count, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn uniform_uiv(ctx_id : Int, loc : Int, dim : Int, vals : Array[Int]) -> Unit {
  if dim <= 0 || vals.length() < dim {
    return
  }
  let count = vals.length() / dim
  let b = pack_i32s(vals)
  c_uniform_uiv(ctx_id, loc, dim, count, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn uniform_matrix_fv(ctx_id : Int, loc : Int, dim : Int, transpose : Bool, vals : Array[Double]) -> Unit {
  let elems = dim * dim
  if elems <= 0 || vals.length() < elems {
    return
  }
  let count = vals.length() / elems
  let b = pack_f32s(vals)
  c_uniform_matrix_fv(ctx_id, loc, dim, count, if transpose { 1 } else { 0 }, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn tex_image_2d_null(ctx_id : Int, target : Int, level : Int, internalformat : Int, w : Int, h : Int, border : Int, format : Int, ty : Int) -> Unit {
  let dummy = Bytes::new(1)
  c_tex_image_2d(ctx_id, target, level, internalformat, w, h, border, format, ty, bytes_data_ptr(dummy), 0, 0)
  keep_bytes_alive(dummy)
}

pub fn tex_image_2d_bytes(ctx_id : Int, target : Int, level : Int, internalformat : Int, w : Int, h : Int, border : Int, format : Int, ty : Int, data : Bytes) -> Unit {
  if data.length() == 0 {
    tex_image_2d_null(ctx_id, target, level, internalformat, w, h, border, format, ty)
  } else {
    c_tex_image_2d(ctx_id, target, level, internalformat, w, h, border, format, ty, bytes_data_ptr(data), 1, data.length())
    keep_bytes_alive(data)
  }
}

pub fn tex_sub_image_2d_bytes(ctx_id : Int, target : Int, level : Int, xoff : Int, yoff : Int, w : Int, h : Int, format : Int, ty : Int, data : Bytes) -> Unit {
  if data.length() > 0 {
    c_tex_sub_image_2d(ctx_id, target, level, xoff, yoff, w, h, format, ty, bytes_data_ptr(data), data.length())
    keep_bytes_alive(data)
  }
}

pub fn draw_buffers(ctx_id : Int, bufs : Array[Int]) -> Unit {
  if bufs.length() == 0 {
    return
  }
  let b = pack_i32s(bufs)
  c_draw_buffers(ctx_id, bufs.length(), bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn clear_buffer_fv(ctx_id : Int, buffer : Int, drawbuffer : Int, vals : Array[Double]) -> Unit {
  let padded : Array[Double] = [
    if vals.length() > 0 { vals[0] } else { 0.0 },
    if vals.length() > 1 { vals[1] } else { 0.0 },
    if vals.length() > 2 { vals[2] } else { 0.0 },
    if vals.length() > 3 { vals[3] } else { 0.0 },
  ]
  let b = pack_f32s(padded)
  c_clear_buffer_fv(ctx_id, buffer, drawbuffer, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn clear_buffer_iv(ctx_id : Int, buffer : Int, drawbuffer : Int, vals : Array[Int]) -> Unit {
  let padded : Array[Int] = [
    if vals.length() > 0 { vals[0] } else { 0 },
    if vals.length() > 1 { vals[1] } else { 0 },
    if vals.length() > 2 { vals[2] } else { 0 },
    if vals.length() > 3 { vals[3] } else { 0 },
  ]
  let b = pack_i32s(padded)
  c_clear_buffer_iv(ctx_id, buffer, drawbuffer, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

pub fn clear_buffer_uiv(ctx_id : Int, buffer : Int, drawbuffer : Int, vals : Array[Int]) -> Unit {
  let padded : Array[Int] = [
    if vals.length() > 0 { vals[0] } else { 0 },
    if vals.length() > 1 { vals[1] } else { 0 },
    if vals.length() > 2 { vals[2] } else { 0 },
    if vals.length() > 3 { vals[3] } else { 0 },
  ]
  let b = pack_i32s(padded)
  c_clear_buffer_uiv(ctx_id, buffer, drawbuffer, bytes_data_ptr(b))
  keep_bytes_alive(b)
}

// --- Queries & Readback ---

pub fn get_string(ctx_id : Int, pname : Int) -> String {
  let buf = Bytes::new(512)
  let n = c_get_string(ctx_id, pname, bytes_data_ptr(buf), 512)
  if n <= 0 {
    keep_bytes_alive(buf)
    ""
  } else {
    buf.slice(0, n).to_string()
  }
}

pub fn get_integerv(ctx_id : Int, pname : Int) -> Array[Int] {
  let buf = Bytes::new(16)
  let ptr = bytes_data_ptr(buf)
  let cnt = c_get_integerv(ctx_id, pname, ptr, 4)
  let out : Array[Int] = []
  let mut i = 0
  while i < cnt {
    out.push(c_read_i32(ptr, i * 4))
    i = i + 1
  }
  keep_bytes_alive(buf)
  out
}

pub fn get_floatv(ctx_id : Int, pname : Int) -> Array[Double] {
  let buf = Bytes::new(16)
  let ptr = bytes_data_ptr(buf)
  let cnt = c_get_floatv(ctx_id, pname, ptr, 4)
  let out : Array[Double] = []
  let mut i = 0
  while i < cnt {
    out.push(c_read_f32(ptr, i * 4))
    i = i + 1
  }
  keep_bytes_alive(buf)
  out
}

pub fn read_pixels(ctx_id : Int, x : Int, y : Int, w : Int, h : Int, format : Int, ty : Int) -> Bytes {
  if w <= 0 || h <= 0 {
    return Bytes::new(0)
  }
  let ch = if format == gl_rgb { 3 } else if format == gl_alpha || format == gl_luminance { 1 } else { 4 }
  let bpc = if ty == gl_float || ty == gl_unsigned_int { 4 } else if ty == gl_unsigned_short { 2 } else { 1 }
  let need = w * h * ch * bpc
  if need <= 0 {
    return Bytes::new(0)
  }
  let out = Bytes::new(need)
  let got = c_read_pixels(ctx_id, x, y, w, h, format, ty, bytes_data_ptr(out), need)
  if got <= 0 {
    Bytes::new(0)
  } else if got == need {
    out
  } else {
    out.slice(0, got)
  }
}

pub fn read_rgba_top_down(ctx_id : Int) -> Bytes {
  let w = width(ctx_id)
  let h = height(ctx_id)
  if w <= 0 || h <= 0 {
    return Bytes::new(0)
  }
  let need = w * h * 4
  let out = Bytes::new(need)
  let got = c_read_rgba_top_down(ctx_id, bytes_data_ptr(out), need)
  if got == need {
    out
  } else {
    Bytes::new(0)
  }
}

///| Reads the default WebGL framebuffer downscaled on the GPU via `glBlitFramebuffer`
///| to at most `max_dim` on the long side, flipped top-down on the GPU. When `keep_premul`
///| is true, skips CPU unpremultiply; when `async_pbo` is true, uses double-buffered PBOs.
pub fn read_rgba_scaled(ctx_id : Int, max_dim : Int, keep_premul : Bool, async_pbo~ : Bool = false) -> (Int, Int, Bytes) {
  let w = width(ctx_id)
  let h = height(ctx_id)
  if w <= 0 || h <= 0 {
    return (0, 0, Bytes::new(0))
  }
  let (dw, dh) = if max_dim > 0 && (w > max_dim || h > max_dim) {
    if w >= h {
      let nh = (h * max_dim + w / 2) / w
      (max_dim, if nh < 1 { 1 } else { nh })
    } else {
      let nw = (w * max_dim + h / 2) / h
      (if nw < 1 { 1 } else { nw }, max_dim)
    }
  } else {
    (w, h)
  }
  let need = dw * dh * 4
  if need <= 0 {
    return (0, 0, Bytes::new(0))
  }
  let out = Bytes::new(need)
  let mode = if keep_premul { if async_pbo { 2 } else { 1 } } else { 0 }
  let got = c_read_rgba_scaled(ctx_id, max_dim, mode, bytes_data_ptr(out), need)
  if got == need {
    (dw, dh, out)
  } else {
    (0, 0, Bytes::new(0))
  }
}

pub extern "C" fn batch_fn_ptr() -> Int64 = "pion_webgl_batch_fn_ptr"

pub extern "C" fn upload_fn_ptr() -> Int64 = "pion_webgl_upload_fn_ptr"
