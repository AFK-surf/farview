///| Pure-Pion Portable W3C ARIA 1.2 / HTML-AAM Accessibility Semantic Tree Engine.
///| Zero `extern "C"`, zero `World`, zero V8/fetch/OS dependencies.

import "html"
import "css"
import "layout"
import "intmap"

let prop_visibility : Int = css::prop_id("visibility")

pub struct AxRect {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
}

pub fn AxRect::zero() -> AxRect {
  AxRect::{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
}

pub enum CheckedState {
  False
  True
  Mixed
}

pub struct AxNode {
  pub uid : Int
  pub role : String
  pub name : String
  pub description : String
  pub tag : String
  pub input_type : String
  pub html_name : String
  pub autocomplete : String
  pub disabled : Bool
  pub checked : Option[CheckedState]
  pub selected : Option[Bool]
  pub expanded : Option[Bool]
  pub pressed : Option[CheckedState]
  pub required : Bool
  pub invalid : String
  pub readonly : Bool
  pub hidden : Bool
  pub modal : Bool
  pub live : String
  pub value : String
  pub valuemin : Option[Double]
  pub valuemax : Option[Double]
  pub level : Int
  pub focused : Bool
  pub bounds : AxRect
  pub children : Array[AxNode]
}

struct AxCtx {
  styles : css::Engine
  bounds_by_uid : intmap::IntMap[AxRect]
  style_by_uid : intmap::IntMap[css::Style]
  id_map : Map[String, html::Node]
  label_for_map : Map[String, Array[html::Node]]
  focused_uid : Int
}

// ----- ASCII & parsing helpers -----

fn is_ascii_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn ascii_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let mut changed = false
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      changed = true
      break
    }
    i = i + 1
  }
  if !changed {
    return s
  }
  let out = Bytes::new(n)
  i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

fn normalize_ws(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let sb = StringBuilder::new()
  let mut in_ws = true
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if is_ascii_ws(c) {
      in_ws = true
      i = i + 1
    } else {
      if in_ws && sb.length() > 0 {
        sb.write_string(" ")
      }
      in_ws = false
      let start = i
      while i < n && !is_ascii_ws(b[i].to_int() & 0xFF) {
        i = i + 1
      }
      sb.write_string(b.slice(start, i).to_string())
    }
  }
  sb.to_string()
}

fn split_ws_tokens(s : String) -> Array[String] {
  let b = s.to_bytes()
  let n = b.length()
  let out : Array[String] = []
  let mut i = 0
  while i < n {
    while i < n && is_ascii_ws(b[i].to_int() & 0xFF) {
      i = i + 1
    }
    let start = i
    while i < n && !is_ascii_ws(b[i].to_int() & 0xFF) {
      i = i + 1
    }
    if i > start {
      out.push(b.slice(start, i).to_string())
    }
  }
  out
}

fn parse_int_opt(s : String) -> Option[Int] {
  let t = normalize_ws(s)
  let b = t.to_bytes()
  let n = b.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if (b[0].to_int() & 0xFF) == 45 {
    neg = true
    i = 1
  } else if (b[0].to_int() & 0xFF) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  Some(if neg { -acc } else { acc })
}

fn parse_double_opt(s : String) -> Option[Double] {
  let t = normalize_ws(s)
  let b = t.to_bytes()
  let n = b.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if (b[0].to_int() & 0xFF) == 45 {
    neg = true
    i = 1
  } else if (b[0].to_int() & 0xFF) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut int_part = 0.0
  let mut frac_part = 0.0
  let mut frac_div = 1.0
  let mut seen_dot = false
  let mut digits = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c >= 48 && c <= 57 {
      digits = digits + 1
      let d = (c - 48).to_double()
      if !seen_dot {
        int_part = int_part * 10.0 + d
      } else {
        frac_div = frac_div * 10.0
        frac_part = frac_part + d / frac_div
      }
    } else if c == 46 && !seen_dot {
      seen_dot = true
    } else {
      return None
    }
    i = i + 1
  }
  if digits == 0 {
    return None
  }
  let v = int_part + frac_part
  Some(if neg { -v } else { v })
}

fn attr_lower(n : html::Node, name : String) -> String {
  match n.attr(name) {
    Some(v) => ascii_lower(normalize_ws(v))
    None => ""
  }
}

fn has_attr(n : html::Node, name : String) -> Bool {
  n.attr(name).is_some()
}

// ----- Indexing boxes & DOM -----

fn index_boxes(
  b : layout::Box,
  bounds_by_uid : intmap::IntMap[AxRect],
  style_by_uid : intmap::IntMap[css::Style],
  dx0 : Double,
  dy0 : Double,
) -> Unit {
  let dx = dx0 + b.rel_dx
  let dy = dy0 + b.rel_dy + b.stick_dy
  match b.node {
    Some(n) => {
      style_by_uid.set(n.uid, b.style)
      if b.kind is layout::Kind::Inline || b.kind is layout::Kind::Break {
        if b.has_frag {
          let rect = AxRect::{
            x: b.min_x + dx,
            y: b.min_y + dy,
            w: b.max_x - b.min_x,
            h: b.max_y - b.min_y,
          }
          bounds_by_uid.set(n.uid, rect)
        }
      } else {
        let rect = AxRect::{ x: b.x + dx, y: b.y + dy, w: b.w, h: b.h }
        bounds_by_uid.set(n.uid, rect)
      }
    }
    None => ()
  }
  let (sx, sy) = layout::scroll_of(b)
  let mut i = 0
  while i < b.children.length() {
    index_boxes(b.children[i], bounds_by_uid, style_by_uid, dx - sx, dy - sy)
    i = i + 1
  }
}

fn index_dom(
  n : html::Node,
  id_map : Map[String, html::Node],
  label_for_map : Map[String, Array[html::Node]],
) -> Unit {
  if n.kind == html::Kind::Element {
    match n.attr("id") {
      Some(id) =>
      if id.length() > 0 && !id_map.contains(id) {
        id_map.set(id, n)
      }
      None => ()
    }
    if n.tag == "label" {
      match n.attr("for") {
        Some(target_id) =>
        if target_id.length() > 0 {
          match label_for_map.get(target_id) {
            Some(arr) => arr.push(n)
            None => label_for_map.set(target_id, [n])
          }
        }
        None => ()
      }
    }
  }
  let mut i = 0
  while i < n.children.length() {
    index_dom(n.children[i], id_map, label_for_map)
    i = i + 1
  }
  match n.get_shadow() {
    Some(sh) => index_dom(sh, id_map, label_for_map)
    None => ()
  }
}

// ----- Visibility & Pruning -----

fn is_non_rendered_tag(tag : String) -> Bool {
  tag == "head" ||
  tag == "script" ||
  tag == "style" ||
  tag == "meta" ||
  tag == "link" ||
  tag == "title" ||
  tag == "template" ||
  tag == "noscript" ||
  tag == "base" ||
  tag == "param" ||
  tag == "source" ||
  tag == "track"
}

fn get_node_style(ctx : AxCtx, n : html::Node, parent_style : Option[css::Style]) -> Option[css::Style] {
  match intmap::get(ctx.style_by_uid, n.uid) {
    Some(s) => Some(s)
    None => ctx.styles.style_of(n, parent_style)
  }
}

fn is_display_none(style : Option[css::Style]) -> Bool {
  match style {
    Some(s) => s.display_str() == "none"
    None => false
  }
}

fn is_visibility_hidden(style : Option[css::Style]) -> Bool {
  match style {
    Some(s) => {
      let v = s.word_id(prop_visibility)
      v == "hidden" || v == "collapse"
    }
    None => false
  }
}

fn is_subtree_hidden(n : html::Node, style : Option[css::Style]) -> Bool {
  if n.kind == html::Kind::Element {
    if is_non_rendered_tag(n.tag) {
      return true
    }
    if n.tag == "input" && attr_lower(n, "type") == "hidden" {
      return true
    }
    if has_attr(n, "hidden") {
      return true
    }
    if attr_lower(n, "aria-hidden") == "true" {
      return true
    }
    if is_display_none(style) {
      return true
    }
  }
  false
}

// ----- W3C ARIA 1.2 / HTML-AAM Role Mapping -----

fn is_valid_aria_role(r : String) -> Bool {
  r == "alert" ||
  r == "alertdialog" ||
  r == "application" ||
  r == "article" ||
  r == "banner" ||
  r == "blockquote" ||
  r == "button" ||
  r == "caption" ||
  r == "cell" ||
  r == "checkbox" ||
  r == "code" ||
  r == "columnheader" ||
  r == "combobox" ||
  r == "complementary" ||
  r == "contentinfo" ||
  r == "definition" ||
  r == "deletion" ||
  r == "dialog" ||
  r == "directory" ||
  r == "document" ||
  r == "emphasis" ||
  r == "feed" ||
  r == "figure" ||
  r == "form" ||
  r == "generic" ||
  r == "grid" ||
  r == "gridcell" ||
  r == "group" ||
  r == "heading" ||
  r == "img" ||
  r == "insertion" ||
  r == "link" ||
  r == "list" ||
  r == "listbox" ||
  r == "listitem" ||
  r == "log" ||
  r == "main" ||
  r == "marquee" ||
  r == "math" ||
  r == "menu" ||
  r == "menubar" ||
  r == "menuitem" ||
  r == "menuitemcheckbox" ||
  r == "menuitemradio" ||
  r == "meter" ||
  r == "navigation" ||
  r == "none" ||
  r == "note" ||
  r == "option" ||
  r == "paragraph" ||
  r == "presentation" ||
  r == "progressbar" ||
  r == "radio" ||
  r == "radiogroup" ||
  r == "region" ||
  r == "row" ||
  r == "rowgroup" ||
  r == "rowheader" ||
  r == "scrollbar" ||
  r == "search" ||
  r == "searchbox" ||
  r == "separator" ||
  r == "slider" ||
  r == "spinbutton" ||
  r == "status" ||
  r == "strong" ||
  r == "subscript" ||
  r == "superscript" ||
  r == "switch" ||
  r == "tab" ||
  r == "table" ||
  r == "tablist" ||
  r == "tabpanel" ||
  r == "term" ||
  r == "textbox" ||
  r == "time" ||
  r == "timer" ||
  r == "toolbar" ||
  r == "tooltip" ||
  r == "tree" ||
  r == "treegrid" ||
  r == "treeitem"
}

fn explicit_role(n : html::Node) -> Option[String] {
  match n.attr("role") {
    Some(raw) => {
      let toks = split_ws_tokens(raw)
      let mut i = 0
      while i < toks.length() {
        let r = ascii_lower(toks[i])
        if is_valid_aria_role(r) {
          return Some(r)
        }
        i = i + 1
      }
      None
    }
    None => None
  }
}

fn inside_sectioning_or_main(n : html::Node) -> Bool {
  let mut cur = n.parent
  while cur is Some(p) {
    if p.kind == html::Kind::Element {
      let t = p.tag
      if t == "article" || t == "aside" || t == "main" || t == "nav" || t == "section" {
        return true
      }
    }
    cur = p.parent
  }
  false
}

fn has_global_aria_or_focusable(n : html::Node) -> Bool {
  if has_attr(n, "tabindex") ||
  has_attr(n, "aria-label") ||
  has_attr(n, "aria-labelledby") ||
  has_attr(n, "aria-describedby") ||
  has_attr(n, "aria-live") ||
  has_attr(n, "aria-modal") ||
  has_attr(n, "aria-expanded") ||
  has_attr(n, "aria-pressed") ||
  has_attr(n, "aria-checked") ||
  has_attr(n, "aria-selected") ||
  has_attr(n, "aria-disabled") ||
  has_attr(n, "aria-required") ||
  has_attr(n, "aria-invalid") {
    return true
  }
  false
}

fn input_role(n : html::Node) -> String {
  let ty = attr_lower(n, "type")
  if ty == "button" || ty == "submit" || ty == "reset" || ty == "image" || ty == "file" || ty == "color" {
    "button"
  } else if ty == "checkbox" {
    "checkbox"
  } else if ty == "radio" {
    "radio"
  } else if ty == "range" {
    "slider"
  } else if ty == "number" {
    "spinbutton"
  } else if ty == "search" {
    if has_attr(n, "list") { "combobox" } else { "searchbox" }
  } else {
    if has_attr(n, "list") { "combobox" } else { "textbox" }
  }
}

fn implicit_role(n : html::Node, has_name_hint : Bool) -> String {
  let t = n.tag
  if t == "button" || t == "summary" {
    "button"
  } else if t == "a" || t == "area" {
    if has_attr(n, "href") { "link" } else { "generic" }
  } else if t == "input" {
    input_role(n)
  } else if t == "textarea" {
    "textbox"
  } else if t == "select" {
    if has_attr(n, "multiple") {
      "listbox"
    } else {
      match n.attr("size") {
        Some(sz) =>
        match parse_int_opt(sz) {
          Some(v) => if v > 1 { "listbox" } else { "combobox" }
          None => "combobox"
        }
        None => "combobox"
      }
    }
  } else if t == "option" {
    "option"
  } else if t == "optgroup" || t == "fieldset" || t == "details" {
    "group"
  } else if t == "h1" || t == "h2" || t == "h3" || t == "h4" || t == "h5" || t == "h6" {
    "heading"
  } else if t == "nav" {
    "navigation"
  } else if t == "main" {
    "main"
  } else if t == "header" {
    if inside_sectioning_or_main(n) { "generic" } else { "banner" }
  } else if t == "footer" {
    if inside_sectioning_or_main(n) { "generic" } else { "contentinfo" }
  } else if t == "aside" {
    "complementary"
  } else if t == "article" {
    "article"
  } else if t == "section" {
    if has_name_hint { "region" } else { "generic" }
  } else if t == "form" {
    "form"
  } else if t == "ul" || t == "ol" || t == "menu" {
    "list"
  } else if t == "li" {
    "listitem"
  } else if t == "table" {
    "table"
  } else if t == "thead" || t == "tbody" || t == "tfoot" {
    "rowgroup"
  } else if t == "tr" {
    "row"
  } else if t == "th" {
    if attr_lower(n, "scope") == "row" { "rowheader" } else { "columnheader" }
  } else if t == "td" {
    "cell"
  } else if t == "caption" {
    "caption"
  } else if t == "img" {
    match n.attr("alt") {
      Some(a) =>
      if a.length() == 0 && !has_attr(n, "aria-label") && !has_attr(n, "aria-labelledby") && !has_attr(n, "title") {
        "none"
      } else {
        "img"
      }
      None => "img"
    }
  } else if t == "dialog" {
    "dialog"
  } else if t == "progress" {
    "progressbar"
  } else if t == "meter" {
    "meter"
  } else if t == "hr" {
    "separator"
  } else if t == "output" {
    "status"
  } else if t == "iframe" {
    "iframe"
  } else if t == "figure" {
    "figure"
  } else if t == "search" {
    "search"
  } else {
    "generic"
  }
}

fn role_allows_name_from_content(role : String) -> Bool {
  role == "button" ||
  role == "link" ||
  role == "heading" ||
  role == "listitem" ||
  role == "cell" ||
  role == "columnheader" ||
  role == "rowheader" ||
  role == "gridcell" ||
  role == "option" ||
  role == "tab" ||
  role == "menuitem" ||
  role == "menuitemcheckbox" ||
  role == "menuitemradio" ||
  role == "checkbox" ||
  role == "radio" ||
  role == "switch" ||
  role == "treeitem" ||
  role == "tooltip" ||
  role == "caption"
}

fn is_labelable_control(n : html::Node) -> Bool {
  let t = n.tag
  t == "input" || t == "textarea" || t == "select" || t == "progress" || t == "meter" || t == "button"
}

// ----- AccName 1.2 Computation -----

fn text_from_subtree(
  ctx : AxCtx,
  n : html::Node,
  skip_uid : Int,
  include_hidden : Bool,
  visited : intmap::IntMap[Bool],
) -> String {
  if n.uid == skip_uid {
    return ""
  }
  if n.kind == html::Kind::Text {
    return n.data
  }
  if n.kind != html::Kind::Element && n.kind != html::Kind::Fragment && n.kind != html::Kind::Document {
    return ""
  }
  if n.kind == html::Kind::Element {
    if is_non_rendered_tag(n.tag) {
      return ""
    }
    if !include_hidden {
      if has_attr(n, "hidden") || attr_lower(n, "aria-hidden") == "true" {
        return ""
      }
      let st = intmap::get(ctx.style_by_uid, n.uid)
      if is_display_none(st) || is_visibility_hidden(st) {
        return ""
      }
    }
    match n.attr("aria-label") {
      Some(al) => {
        let t = normalize_ws(al)
        if t.length() > 0 {
          return t
        }
      }
      None => ()
    }
    if n.tag == "img" {
      match n.attr("alt") {
        Some(alt) => return normalize_ws(alt)
        None => return ""
      }
    }
    if n.tag == "input" {
      let ty = attr_lower(n, "type")
      if ty == "button" || ty == "submit" || ty == "reset" {
        match n.attr("value") {
          Some(v) => return normalize_ws(v)
          None => ()
        }
      }
      return ""
    }
  }
  let parts : Array[String] = []
  let mut i = 0
  while i < n.children.length() {
    let part = text_from_subtree(ctx, n.children[i], skip_uid, include_hidden, visited)
    if part.length() > 0 {
      parts.push(part)
    }
    i = i + 1
  }
  match n.get_shadow() {
    Some(sh) => {
      let part = text_from_subtree(ctx, sh, skip_uid, include_hidden, visited)
      if part.length() > 0 {
        parts.push(part)
      }
    }
    None => ()
  }
  normalize_ws(parts.join(" "))
}

fn compute_idref_text(
  ctx : AxCtx,
  attr_val : String,
  visited : intmap::IntMap[Bool],
) -> String {
  let ids = split_ws_tokens(attr_val)
  let parts : Array[String] = []
  let mut i = 0
  while i < ids.length() {
    match ctx.id_map.get(ids[i]) {
      Some(target) =>
      if !visited.contains(target.uid) {
        visited.set(target.uid, true)
        let name = compute_acc_name_inner(ctx, target, "", true, visited)
        if name.length() > 0 {
          parts.push(name)
        }
      }
      None => ()
    }
    i = i + 1
  }
  normalize_ws(parts.join(" "))
}

fn compute_associated_labels(
  ctx : AxCtx,
  n : html::Node,
  visited : intmap::IntMap[Bool],
) -> String {
  let parts : Array[String] = []
  let used_labels : intmap::IntMap[Bool] = intmap::IntMap::new()
  match n.attr("id") {
    Some(id) =>
    if id.length() > 0 {
      match ctx.label_for_map.get(id) {
        Some(labels) => {
          let mut i = 0
          while i < labels.length() {
            let lbl = labels[i]
            if !used_labels.contains(lbl.uid) {
              used_labels.set(lbl.uid, true)
              let txt = text_from_subtree(ctx, lbl, n.uid, false, visited)
              if txt.length() > 0 {
                parts.push(txt)
              }
            }
            i = i + 1
          }
        }
        None => ()
      }
    }
    None => ()
  }
  // Ancestor wrapping <label>
  let mut cur = n.parent
  while cur is Some(p) {
    if p.kind == html::Kind::Element && p.tag == "label" {
      if !used_labels.contains(p.uid) {
        used_labels.set(p.uid, true)
        let txt = text_from_subtree(ctx, p, n.uid, false, visited)
        if txt.length() > 0 {
          parts.push(txt)
        }
      }
      break
    }
    cur = p.parent
  }
  normalize_ws(parts.join(" "))
}

fn find_first_child_tag(n : html::Node, tag : String) -> Option[html::Node] {
  let mut i = 0
  while i < n.children.length() {
    let c = n.children[i]
    if c.kind == html::Kind::Element && c.tag == tag {
      return Some(c)
    }
    i = i + 1
  }
  None
}

fn compute_acc_name_inner(
  ctx : AxCtx,
  n : html::Node,
  role : String,
  in_labelledby : Bool,
  visited : intmap::IntMap[Bool],
) -> String {
  // 1. aria-labelledby (not re-traversed recursively per AccName 1.2 §4.3.2B)
  if !in_labelledby {
    match n.attr("aria-labelledby") {
      Some(lb) => {
        visited.set(n.uid, true)
        let res = compute_idref_text(ctx, lb, visited)
        if res.length() > 0 {
          return res
        }
      }
      None => ()
    }
  }
  // 2. aria-label
  match n.attr("aria-label") {
    Some(al) => {
      let t = normalize_ws(al)
      if t.length() > 0 {
        return t
      }
    }
    None => ()
  }
  // 3. Host-language native labeling
  if is_labelable_control(n) {
    let lbl = compute_associated_labels(ctx, n, visited)
    if lbl.length() > 0 {
      return lbl
    }
  }
  if n.tag == "img" || (n.tag == "input" && attr_lower(n, "type") == "image") {
    match n.attr("alt") {
      Some(alt) => {
        let t = normalize_ws(alt)
        if t.length() > 0 {
          return t
        }
      }
      None => ()
    }
  }
  if n.tag == "input" {
    let ty = attr_lower(n, "type")
    if ty == "button" || ty == "submit" || ty == "reset" {
      match n.attr("value") {
        Some(v) => {
          let t = normalize_ws(v)
          if t.length() > 0 {
            return t
          }
        }
        None => {
          if ty == "submit" { return "Submit" }
          if ty == "reset" { return "Reset" }
        }
      }
    }
  }
  if n.tag == "fieldset" {
    match find_first_child_tag(n, "legend") {
      Some(leg) => {
        let t = text_from_subtree(ctx, leg, -1, in_labelledby, visited)
        if t.length() > 0 {
          return t
        }
      }
      None => ()
    }
  }
  if n.tag == "table" {
    match find_first_child_tag(n, "caption") {
      Some(cap) => {
        let t = text_from_subtree(ctx, cap, -1, in_labelledby, visited)
        if t.length() > 0 {
          return t
        }
      }
      None => ()
    }
  }
  if n.tag == "figure" {
    match find_first_child_tag(n, "figcaption") {
      Some(fc) => {
        let t = text_from_subtree(ctx, fc, -1, in_labelledby, visited)
        if t.length() > 0 {
          return t
        }
      }
      None => ()
    }
  }
  // 4. Name from content (always when referenced via aria-labelledby, or for name-from-content roles)
  if in_labelledby || role_allows_name_from_content(role) {
    let txt = text_from_subtree(ctx, n, -1, in_labelledby, visited)
    if txt.length() > 0 {
      return txt
    }
  }
  // 5. placeholder (for input/textarea)
  if n.tag == "input" || n.tag == "textarea" {
    match n.attr("placeholder") {
      Some(ph) => {
        let t = normalize_ws(ph)
        if t.length() > 0 {
          return t
        }
      }
      None => ()
    }
  }
  // 6. title fallback
  match n.attr("title") {
    Some(tt) => {
      let t = normalize_ws(tt)
      if t.length() > 0 {
        return t
      }
    }
    None => ()
  }
  ""
}

fn compute_acc_name(ctx : AxCtx, n : html::Node, role : String) -> String {
  let visited : intmap::IntMap[Bool] = intmap::IntMap::new()
  compute_acc_name_inner(ctx, n, role, false, visited)
}

fn compute_acc_description(ctx : AxCtx, n : html::Node, computed_name : String) -> String {
  match n.attr("aria-describedby") {
    Some(db) => {
      let visited : intmap::IntMap[Bool] = intmap::IntMap::new()
      visited.set(n.uid, true)
      let res = compute_idref_text(ctx, db, visited)
      if res.length() > 0 {
        return res
      }
    }
    None => ()
  }
  match n.attr("title") {
    Some(tt) => {
      let t = normalize_ws(tt)
      if t.length() > 0 && t != computed_name {
        return t
      }
    }
    None => ()
  }
  ""
}

// ----- States & Attributes -----

fn parse_tristate(v : String) -> Option[CheckedState] {
  if v == "true" {
    Some(CheckedState::True)
  } else if v == "false" {
    Some(CheckedState::False)
  } else if v == "mixed" {
    Some(CheckedState::Mixed)
  } else {
    None
  }
}

fn is_disabled_by_fieldset(n : html::Node) -> Bool {
  let mut prev = n
  let mut cur = n.parent
  while cur is Some(p) {
    if p.kind == html::Kind::Element && p.tag == "fieldset" && has_attr(p, "disabled") {
      match find_first_child_tag(p, "legend") {
        Some(leg) =>
        if prev.uid == leg.uid {
          return false
        }
        None => ()
      }
      return true
    }
    prev = p
    cur = p.parent
  }
  false
}

fn compute_disabled(n : html::Node) -> Bool {
  if attr_lower(n, "aria-disabled") == "true" {
    return true
  }
  if has_attr(n, "disabled") {
    return true
  }
  if is_labelable_control(n) && is_disabled_by_fieldset(n) {
    return true
  }
  false
}

fn compute_checked(n : html::Node, role : String) -> Option[CheckedState] {
  match parse_tristate(attr_lower(n, "aria-checked")) {
    Some(st) => return Some(st)
    None => ()
  }
  if role == "checkbox" || role == "radio" || role == "switch" || role == "menuitemcheckbox" || role == "menuitemradio" {
    match n.get_checked() {
      Some(b) => return Some(if b { CheckedState::True } else { CheckedState::False })
      None => ()
    }
    if n.tag == "input" {
      let ty = attr_lower(n, "type")
      if ty == "checkbox" || ty == "radio" {
        return Some(if has_attr(n, "checked") { CheckedState::True } else { CheckedState::False })
      }
    }
  }
  None
}

fn compute_selected(n : html::Node, role : String) -> Option[Bool] {
  let v = attr_lower(n, "aria-selected")
  if v == "true" {
    return Some(true)
  }
  if v == "false" {
    return Some(false)
  }
  if n.tag == "option" || role == "option" {
    return Some(html::option_chosen(n))
  }
  None
}

fn compute_expanded(n : html::Node) -> Option[Bool] {
  let v = attr_lower(n, "aria-expanded")
  if v == "true" {
    return Some(true)
  }
  if v == "false" {
    return Some(false)
  }
  if n.tag == "details" {
    return Some(has_attr(n, "open"))
  }
  if n.tag == "summary" {
    match n.parent {
      Some(p) =>
      if p.kind == html::Kind::Element && p.tag == "details" {
        return Some(has_attr(p, "open"))
      }
      None => ()
    }
  }
  None
}

fn compute_value(n : html::Node) -> String {
  match n.attr("aria-valuetext") {
    Some(v) => return v
    None => ()
  }
  match n.attr("aria-valuenow") {
    Some(v) => return normalize_ws(v)
    None => ()
  }
  match n.value {
    Some(v) => return v
    None => ()
  }
  if n.tag == "input" {
    let ty = attr_lower(n, "type")
    if ty != "password" && ty != "button" && ty != "submit" && ty != "reset" {
      match n.attr("value") {
        Some(v) => return v
        None => ()
      }
    }
  } else if n.tag == "textarea" {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n.children.length() {
      if n.children[i].kind == html::Kind::Text {
        sb.write_string(n.children[i].data)
      }
      i = i + 1
    }
    return sb.to_string()
  } else if n.tag == "select" {
    let opts = html::select_options(n)
    let mut i = 0
    while i < opts.length() {
      if html::option_chosen(opts[i]) {
        match opts[i].attr("value") {
          Some(v) => return v
          None => {
            let visited : intmap::IntMap[Bool] = intmap::IntMap::new()
            let sb = StringBuilder::new()
            let mut j = 0
            while j < opts[i].children.length() {
              if opts[i].children[j].kind == html::Kind::Text {
                sb.write_string(opts[i].children[j].data)
              }
              j = j + 1
            }
            let _ = visited
            return normalize_ws(sb.to_string())
          }
        }
      }
      i = i + 1
    }
  } else if n.tag == "progress" || n.tag == "meter" {
    match n.attr("value") {
      Some(v) => return normalize_ws(v)
      None => ()
    }
  }
  ""
}

fn compute_valuemin(n : html::Node) -> Option[Double] {
  match n.attr("aria-valuemin") {
    Some(v) => parse_double_opt(v)
    None =>
    match n.attr("min") {
      Some(v) => parse_double_opt(v)
      None => if n.tag == "progress" { Some(0.0) } else { None }
    }
  }
}

fn compute_valuemax(n : html::Node) -> Option[Double] {
  match n.attr("aria-valuemax") {
    Some(v) => parse_double_opt(v)
    None =>
    match n.attr("max") {
      Some(v) => parse_double_opt(v)
      None => if n.tag == "progress" { Some(1.0) } else { None }
    }
  }
}

fn compute_level(n : html::Node, role : String) -> Int {
  match n.attr("aria-level") {
    Some(v) =>
    match parse_int_opt(v) {
      Some(lvl) => if lvl > 0 { return lvl }
      None => ()
    }
    None => ()
  }
  if role == "heading" {
    let t = n.tag
    if t == "h1" { return 1 }
    if t == "h2" { return 2 }
    if t == "h3" { return 3 }
    if t == "h4" { return 4 }
    if t == "h5" { return 5 }
    if t == "h6" { return 6 }
    return 2
  }
  0
}

fn compute_live(n : html::Node, role : String) -> String {
  let v = attr_lower(n, "aria-live")
  if v == "polite" || v == "assertive" || v == "off" {
    return v
  }
  if role == "alert" {
    return "assertive"
  }
  if role == "status" || role == "log" {
    return "polite"
  }
  ""
}

fn compute_invalid(n : html::Node) -> String {
  let v = attr_lower(n, "aria-invalid")
  if v == "true" || v == "grammar" || v == "spelling" {
    v
  } else {
    ""
  }
}

// ----- Tree Builder -----

fn build_children(
  ctx : AxCtx,
  n : html::Node,
  parent_style : Option[css::Style],
  out : Array[AxNode],
) -> Unit {
  let mut i = 0
  while i < n.children.length() {
    visit_node(ctx, n.children[i], parent_style, out)
    i = i + 1
  }
  match n.get_shadow() {
    Some(sh) => build_children(ctx, sh, parent_style, out)
    None => ()
  }
}

fn visit_node(
  ctx : AxCtx,
  n : html::Node,
  parent_style : Option[css::Style],
  out : Array[AxNode],
) -> Unit {
  if n.kind == html::Kind::Text {
    if is_visibility_hidden(parent_style) {
      return
    }
    let txt = normalize_ws(n.data)
    if txt.length() == 0 {
      return
    }
    let bounds = match intmap::get(ctx.bounds_by_uid, n.uid) {
      Some(r) => r
      None => AxRect::zero()
    }
    out.push(AxNode::{
      uid: n.uid,
      role: "StaticText",
      name: txt,
      description: "",
      tag: "",
      input_type: "",
      html_name: "",
      autocomplete: "",
      disabled: false,
      checked: None,
      selected: None,
      expanded: None,
      pressed: None,
      required: false,
      invalid: "",
      readonly: false,
      hidden: false,
      modal: false,
      live: "",
      value: "",
      valuemin: None,
      valuemax: None,
      level: 0,
      focused: false,
      bounds: bounds,
      children: [],
    })
    return
  }
  if n.kind != html::Kind::Element {
    return
  }

  let st = get_node_style(ctx, n, parent_style)
  if is_subtree_hidden(n, st) {
    return
  }

  // `visibility: hidden` hides this element, but a descendant with `visibility: visible` can still be exposed.
  if is_visibility_hidden(st) {
    build_children(ctx, n, st, out)
    return
  }

  // Transparent structural roots (`html`, `body`)
  if (n.tag == "html" || n.tag == "body") && explicit_role(n).is_none() && !has_global_aria_or_focusable(n) {
    build_children(ctx, n, st, out)
    return
  }

  let exp = explicit_role(n)
  let name_hint = has_attr(n, "aria-label") || has_attr(n, "aria-labelledby") || has_attr(n, "title")
  let raw_role = match exp {
    Some(r) => r
    None => implicit_role(n, name_hint)
  }

  // `role="presentation"` / `role="none"` (or decorative `<img alt="">`): omit self unless focusable / global ARIA
  if (raw_role == "presentation" || raw_role == "none") && !has_global_aria_or_focusable(n) {
    build_children(ctx, n, st, out)
    return
  }
  let role = if raw_role == "presentation" || raw_role == "none" {
    implicit_role(n, name_hint)
  } else {
    raw_role
  }

  let name = compute_acc_name(ctx, n, role)
  let desc = compute_acc_description(ctx, n, name)
  let disabled = compute_disabled(n)
  let checked = compute_checked(n, role)
  let selected = compute_selected(n, role)
  let expanded = compute_expanded(n)
  let pressed = parse_tristate(attr_lower(n, "aria-pressed"))
  let required = has_attr(n, "required") || attr_lower(n, "aria-required") == "true"
  let invalid = compute_invalid(n)
  let readonly = has_attr(n, "readonly") || attr_lower(n, "aria-readonly") == "true"
  let modal = attr_lower(n, "aria-modal") == "true"
  let live = compute_live(n, role)
  let value = compute_value(n)
  let valuemin = compute_valuemin(n)
  let valuemax = compute_valuemax(n)
  let level = compute_level(n, role)
  let focused = ctx.focused_uid > 0 && n.uid == ctx.focused_uid
  let bounds = match intmap::get(ctx.bounds_by_uid, n.uid) {
    Some(r) => r
    None => AxRect::zero()
  }
  let input_type = if n.tag == "input" {
    let ty = attr_lower(n, "type")
    if ty.length() == 0 { "text" } else { ty }
  } else {
    ""
  }
  let html_name = match n.attr("name") {
    Some(v) => v
    None => ""
  }
  let autocomplete = attr_lower(n, "autocomplete")

  let kids : Array[AxNode] = []
  build_children(ctx, n, st, kids)

  // Collapse unnamed, stateless `generic` wrappers (e.g. layout `<div>`/`<span>`) so the semantic tree stays concise.
  let is_plain_generic = role == "generic" &&
  exp.is_none() &&
  name.length() == 0 &&
  desc.length() == 0 &&
  !disabled &&
  checked.is_none() &&
  selected.is_none() &&
  expanded.is_none() &&
  pressed.is_none() &&
  !required &&
  invalid.length() == 0 &&
  !readonly &&
  !modal &&
  live.length() == 0 &&
  !focused
  if is_plain_generic {
    let mut k = 0
    while k < kids.length() {
      out.push(kids[k])
      k = k + 1
    }
    return
  }

  out.push(AxNode::{
    uid: n.uid,
    role: role,
    name: name,
    description: desc,
    tag: n.tag,
    input_type: input_type,
    html_name: html_name,
    autocomplete: autocomplete,
    disabled: disabled,
    checked: checked,
    selected: selected,
    expanded: expanded,
    pressed: pressed,
    required: required,
    invalid: invalid,
    readonly: readonly,
    hidden: false,
    modal: modal,
    live: live,
    value: value,
    valuemin: valuemin,
    valuemax: valuemax,
    level: level,
    focused: focused,
    bounds: bounds,
    children: kids,
  })
}

fn find_document_title(doc : html::Node) -> String {
  let walk : Array[html::Node] = [doc]
  while walk.length() > 0 {
    match walk.pop() {
      Some(n) => {
        if n.kind == html::Kind::Element && n.tag == "title" {
          let sb = StringBuilder::new()
          let mut i = 0
          while i < n.children.length() {
            if n.children[i].kind == html::Kind::Text {
              sb.write_string(n.children[i].data)
            }
            i = i + 1
          }
          return normalize_ws(sb.to_string())
        }
        let mut i = n.children.length() - 1
        while i >= 0 {
          walk.push(n.children[i])
          i = i - 1
        }
      }
      None => break
    }
  }
  ""
}

///| Build a W3C ARIA 1.2 / HTML-AAM accessibility tree from DOM, CSS Engine, and layout Box tree.
pub fn build_a11y_tree(doc : html::Node, styles : css::Engine, boxes : layout::Box) -> AxNode {
  build_a11y_tree_with_focus(doc, styles, Some(boxes), -1)
}

///| Build a W3C ARIA 1.2 / HTML-AAM accessibility tree with optional layout boxes and focused DOM node uid.
pub fn build_a11y_tree_with_focus(
  doc : html::Node,
  styles : css::Engine,
  boxes : Option[layout::Box],
  focused_uid : Int,
) -> AxNode {
  let bounds_by_uid : intmap::IntMap[AxRect] = intmap::IntMap::with_capacity(64)
  let style_by_uid : intmap::IntMap[css::Style] = intmap::IntMap::with_capacity(64)
  let root_bounds = match boxes {
    Some(root_box) => {
      index_boxes(root_box, bounds_by_uid, style_by_uid, 0.0, 0.0)
      AxRect::{ x: root_box.x, y: root_box.y, w: root_box.w, h: root_box.h }
    }
    None => AxRect::zero()
  }
  let id_map : Map[String, html::Node] = Map::new()
  let label_for_map : Map[String, Array[html::Node]] = Map::new()
  index_dom(doc, id_map, label_for_map)

  let ctx = AxCtx::{
    styles: styles,
    bounds_by_uid: bounds_by_uid,
    style_by_uid: style_by_uid,
    id_map: id_map,
    label_for_map: label_for_map,
    focused_uid: focused_uid,
  }

  let children : Array[AxNode] = []
  build_children(ctx, doc, None, children)
  let doc_title = find_document_title(doc)

  AxNode::{
    uid: doc.uid,
    role: "RootWebArea",
    name: doc_title,
    description: "",
    tag: "#document",
    input_type: "",
    html_name: "",
    autocomplete: "",
    disabled: false,
    checked: None,
    selected: None,
    expanded: None,
    pressed: None,
    required: false,
    invalid: "",
    readonly: false,
    hidden: false,
    modal: false,
    live: "",
    value: "",
    valuemin: None,
    valuemax: None,
    level: 0,
    focused: focused_uid > 0 && doc.uid == focused_uid,
    bounds: root_bounds,
    children: children,
  }
}

// ----- Query Helpers -----

fn collect_by_role(node : AxNode, role : String, out : Array[AxNode]) -> Unit {
  if node.role == role {
    out.push(node)
  }
  let mut i = 0
  while i < node.children.length() {
    collect_by_role(node.children[i], role, out)
    i = i + 1
  }
}

pub fn find_by_role(root : AxNode, role : String) -> Array[AxNode] {
  let out : Array[AxNode] = []
  collect_by_role(root, role, out)
  out
}

fn collect_by_name(node : AxNode, name : String, out : Array[AxNode]) -> Unit {
  if node.name == name {
    out.push(node)
  }
  let mut i = 0
  while i < node.children.length() {
    collect_by_name(node.children[i], name, out)
    i = i + 1
  }
}

pub fn find_by_name(root : AxNode, name : String) -> Array[AxNode] {
  let out : Array[AxNode] = []
  collect_by_name(root, name, out)
  out
}

pub fn find_by_role_and_name(root : AxNode, role : String, name : String) -> Option[AxNode] {
  if root.role == role && root.name == name {
    return Some(root)
  }
  let mut i = 0
  while i < root.children.length() {
    match find_by_role_and_name(root.children[i], role, name) {
      Some(found) => return Some(found)
      None => ()
    }
    i = i + 1
  }
  None
}

pub fn find_by_uid(root : AxNode, uid : Int) -> Option[AxNode] {
  if root.uid == uid {
    return Some(root)
  }
  let mut i = 0
  while i < root.children.length() {
    match find_by_uid(root.children[i], uid) {
      Some(found) => return Some(found)
      None => ()
    }
    i = i + 1
  }
  None
}

pub fn count_nodes(root : AxNode) -> Int {
  let mut total = 1
  let mut i = 0
  while i < root.children.length() {
    total = total + count_nodes(root.children[i])
    i = i + 1
  }
  total
}

// ----- JSON Serialization (NSAccessibility / UIA / CDP Accessibility.getFullAXTree / AI Agent) -----

fn write_json_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_string("\"")
  let b = s.to_bytes()
  let n = b.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c == 34 || c == 92 || c < 32 {
      if i > start {
        sb.write_string(b.slice(start, i).to_string())
      }
      if c == 34 {
        sb.write_string("\\\"")
      } else if c == 92 {
        sb.write_string("\\\\")
      } else if c == 10 {
        sb.write_string("\\n")
      } else if c == 13 {
        sb.write_string("\\r")
      } else if c == 9 {
        sb.write_string("\\t")
      } else {
        sb.write_string("\\u00")
        let hex = "0123456789abcdef"
        let hi = (c >> 4) & 0xF
        let lo = c & 0xF
        sb.write_string(hex.slice(hi, hi + 1))
        sb.write_string(hex.slice(lo, lo + 1))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    sb.write_string(b.slice(start, n).to_string())
  }
  sb.write_string("\"")
}

fn checked_str(c : CheckedState) -> String {
  match c {
    CheckedState::True => "true"
    CheckedState::False => "false"
    CheckedState::Mixed => "mixed"
  }
}

fn write_ax_json(sb : StringBuilder, n : AxNode) -> Unit {
  sb.write_string("{\"uid\":")
  sb.write_string(n.uid.to_string())
  sb.write_string(",\"role\":")
  write_json_str(sb, n.role)
  sb.write_string(",\"name\":")
  write_json_str(sb, n.name)
  if n.description.length() > 0 {
    sb.write_string(",\"description\":")
    write_json_str(sb, n.description)
  }
  if n.tag.length() > 0 {
    sb.write_string(",\"tag\":")
    write_json_str(sb, n.tag)
  }
  if n.input_type.length() > 0 {
    sb.write_string(",\"inputType\":")
    write_json_str(sb, n.input_type)
  }
  if n.html_name.length() > 0 {
    sb.write_string(",\"htmlName\":")
    write_json_str(sb, n.html_name)
  }
  if n.autocomplete.length() > 0 {
    sb.write_string(",\"autocomplete\":")
    write_json_str(sb, n.autocomplete)
  }
  if n.disabled {
    sb.write_string(",\"disabled\":true")
  }
  match n.checked {
    Some(c) => {
      sb.write_string(",\"checked\":")
      write_json_str(sb, checked_str(c))
    }
    None => ()
  }
  match n.selected {
    Some(v) => sb.write_string(if v { ",\"selected\":true" } else { ",\"selected\":false" })
    None => ()
  }
  match n.expanded {
    Some(v) => sb.write_string(if v { ",\"expanded\":true" } else { ",\"expanded\":false" })
    None => ()
  }
  match n.pressed {
    Some(p) => {
      sb.write_string(",\"pressed\":")
      write_json_str(sb, checked_str(p))
    }
    None => ()
  }
  if n.required {
    sb.write_string(",\"required\":true")
  }
  if n.invalid.length() > 0 {
    sb.write_string(",\"invalid\":")
    write_json_str(sb, n.invalid)
  }
  if n.readonly {
    sb.write_string(",\"readonly\":true")
  }
  if n.hidden {
    sb.write_string(",\"hidden\":true")
  }
  if n.modal {
    sb.write_string(",\"modal\":true")
  }
  if n.live.length() > 0 {
    sb.write_string(",\"live\":")
    write_json_str(sb, n.live)
  }
  if n.value.length() > 0 {
    sb.write_string(",\"value\":")
    write_json_str(sb, n.value)
  }
  match n.valuemin {
    Some(v) => {
      sb.write_string(",\"valuemin\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  match n.valuemax {
    Some(v) => {
      sb.write_string(",\"valuemax\":")
      sb.write_string(v.to_string())
    }
    None => ()
  }
  if n.level > 0 {
    sb.write_string(",\"level\":")
    sb.write_string(n.level.to_string())
  }
  if n.focused {
    sb.write_string(",\"focused\":true")
  }
  sb.write_string(",\"bounds\":{\"x\":")
  sb.write_string(n.bounds.x.to_string())
  sb.write_string(",\"y\":")
  sb.write_string(n.bounds.y.to_string())
  sb.write_string(",\"w\":")
  sb.write_string(n.bounds.w.to_string())
  sb.write_string(",\"h\":")
  sb.write_string(n.bounds.h.to_string())
  sb.write_string("},\"children\":[")
  let mut i = 0
  while i < n.children.length() {
    if i > 0 {
      sb.write_string(",")
    }
    write_ax_json(sb, n.children[i])
    i = i + 1
  }
  sb.write_string("]}")
}

pub fn AxNode::to_json(self : AxNode) -> String {
  let sb = StringBuilder::new()
  write_ax_json(sb, self)
  sb.to_string()
}
