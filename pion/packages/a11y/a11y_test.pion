///| Comprehensive unit tests for `a11y` (W3C ARIA 1.2 / HTML-AAM semantic tree).

import "html"
import "css"
import "layout"

fn assert(ok : Bool, msg : String) -> Unit {
  if !ok {
    panic("a11y test failed: " + msg)
  }
}

fn build_doc_ax(html_src : String, sheet : String, focused_id : String) -> AxNode {
  let doc = html::parse(html_src)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  if sheet.length() > 0 {
    engine.add_sheet(sheet)
  }
  let root_box = match layout::generate(doc, engine) {
    Some(b) => b
    None => panic("layout::generate returned None")
  }
  let fonts = layout::Fonts::new_portable([], [])
  layout::layout_with_scrollbar(root_box, fonts, 800.0, 600.0, 0.0)
  if focused_id.length() == 0 {
    build_a11y_tree(doc, engine, root_box)
  } else {
    let fuid = find_dom_uid_by_id(doc, focused_id)
    build_a11y_tree_with_focus(doc, engine, Some(root_box), fuid)
  }
}

fn find_dom_uid_by_id(n : html::Node, target : String) -> Int {
  if n.kind == html::Kind::Element {
    match n.attr("id") {
      Some(id) => if id == target { return n.uid }
      None => ()
    }
  }
  let mut i = 0
  while i < n.children.length() {
    let u = find_dom_uid_by_id(n.children[i], target)
    if u > 0 {
      return u
    }
    i = i + 1
  }
  -1
}

test "HTML-AAM landmarks, headings, lists, tables, images, and role=presentation" {
  let src = "<!doctype html><html><head><title>Portal</title></head><body>" +
  "<header><nav aria-label=\"Primary\"><a href=\"/home\">Home</a></nav></header>" +
  "<main><h1>Dashboard</h1><h3>Stats</h3>" +
  "<section aria-label=\"Summary\"><article><p>Hello</p></article></section>" +
  "<aside>Sidebar</aside>" +
  "<ul><li>One</li><li>Two</li></ul>" +
  "<table><caption>Scores</caption><tr><th>Player</th><td>42</td></tr></table>" +
  "<img src=\"a.png\" alt=\"Logo\"><img src=\"spacer.png\" alt=\"\">" +
  "<div role=\"presentation\"><button>Inside Presentation</button></div>" +
  "<progress value=\"70\" max=\"100\" aria-label=\"Upload\"></progress>" +
  "</main><footer>Footer</footer></body></html>"
  let ax = build_doc_ax(src, "", "")
  assert(ax.role == "RootWebArea", "root role")
  assert(ax.name == "Portal", "root title")
  assert(find_by_role(ax, "banner").length() == 1, "banner landmark")
  assert(find_by_role(ax, "navigation").length() == 1, "nav landmark")
  assert(find_by_role_and_name(ax, "navigation", "Primary").is_some(), "named nav")
  assert(find_by_role(ax, "main").length() == 1, "main landmark")
  assert(find_by_role(ax, "contentinfo").length() == 1, "footer landmark")
  assert(find_by_role(ax, "complementary").length() == 1, "aside landmark")
  assert(find_by_role(ax, "article").length() == 1, "article role")
  assert(find_by_role_and_name(ax, "region", "Summary").is_some(), "named section -> region")

  let headings = find_by_role(ax, "heading")
  assert(headings.length() == 2, "two headings")
  assert(headings[0].name == "Dashboard" && headings[0].level == 1, "h1 level 1")
  assert(headings[1].name == "Stats" && headings[1].level == 3, "h3 level 3")

  assert(find_by_role(ax, "list").length() == 1, "list")
  assert(find_by_role(ax, "listitem").length() == 2, "2 listitems")
  assert(find_by_role_and_name(ax, "table", "Scores").is_some(), "table named by caption")
  assert(find_by_role(ax, "columnheader").length() == 1, "th columnheader")
  assert(find_by_role(ax, "cell").length() == 1, "td cell")

  // Only the non-empty alt image is exposed as img; decorative alt="" is omitted.
  let imgs = find_by_role(ax, "img")
  assert(imgs.length() == 1 && imgs[0].name == "Logo", "decorative img omitted")

  // role="presentation" wrapper omitted while preserving child button.
  assert(find_by_role(ax, "presentation").length() == 0, "presentation omitted")
  assert(find_by_role_and_name(ax, "button", "Inside Presentation").is_some(), "child promoted")

  let prog = find_by_role(ax, "progressbar")
  assert(prog.length() == 1 && prog[0].value == "70", "progressbar value")
  match prog[0].valuemax {
    Some(mx) => assert(mx == 100.0, "progressbar max 100")
    None => assert(false, "progressbar valuemax present")
  }
}

test "AccName 1.2 priority, nested aria-labelledby (including hidden target), and aria-describedby" {
  let src = "<!doctype html><html><body>" +
  "<span id=\"prefix\" style=\"display:none\">Billing</span>" +
  "<span id=\"suffix\" aria-hidden=\"true\">Address</span>" +
  "<input id=\"addr\" aria-labelledby=\"prefix suffix\" aria-label=\"Ignored\" placeholder=\"Ignored\" title=\"Extra hint\" aria-describedby=\"help\">" +
  "<div id=\"help\">Enter street name</div>" +
  "<label for=\"cb1\">Accept <img src=\"x\" alt=\"Terms\"></label>" +
  "<input id=\"cb1\" type=\"checkbox\" checked>" +
  "<label>Remember me <input id=\"cb2\" type=\"checkbox\"></label>" +
  "<button id=\"btn1\" aria-pressed=\"mixed\" aria-expanded=\"true\" disabled>Toggle</button>" +
  "</body></html>"
  let ax = build_doc_ax(src, "", "addr")

  // Hidden spans must NOT appear as standalone nodes in the tree
  assert(find_by_name(ax, "Billing").length() == 0, "display:none span pruned")
  assert(find_by_name(ax, "Address").length() == 0, "aria-hidden span pruned")

  // Yet aria-labelledby MUST resolve both hidden targets per AccName 1.2!
  match find_by_role_and_name(ax, "textbox", "Billing Address") {
    Some(tb) => {
      assert(tb.description == "Enter street name", "aria-describedby resolved")
      assert(tb.focused, "focused flag set")
    }
    None => assert(false, "aria-labelledby failed to resolve hidden targets")
  }

  match find_by_role_and_name(ax, "checkbox", "Accept Terms") {
    Some(cb) =>
    match cb.checked {
      Some(CheckedState::True) => ()
      _ => assert(false, "cb1 must be checked=True")
    }
    None => assert(false, "label[for] with inner img alt failed")
  }

  match find_by_role_and_name(ax, "checkbox", "Remember me") {
    Some(cb) =>
    match cb.checked {
      Some(CheckedState::False) => ()
      _ => assert(false, "cb2 must be checked=False")
    }
    None => assert(false, "wrapping label failed")
  }

  match find_by_role_and_name(ax, "button", "Toggle") {
    Some(btn) => {
      assert(btn.disabled, "button disabled")
      match btn.pressed {
        Some(CheckedState::Mixed) => ()
        _ => assert(false, "aria-pressed=mixed")
      }
      match btn.expanded {
        Some(true) => ()
        _ => assert(false, "aria-expanded=true")
      }
    }
    None => assert(false, "Toggle button missing")
  }
}

test "aria-hidden, display:none, and visibility:hidden pruning (with visibility:visible child recovery)" {
  let src = "<!doctype html><html><body>" +
  "<div aria-hidden=\"true\"><button>Ghost Button</button></div>" +
  "<div class=\"gone\"><a href=\"/x\">Gone Link</a></div>" +
  "<div class=\"invis\"><button>Hidden Button</button><button class=\"vis\">Visible Child</button></div>" +
  "<div role=\"alert\">Session expired</div>" +
  "<dialog open aria-modal=\"true\" aria-label=\"Confirm Delete\"><button>Delete</button></dialog>" +
  "</body></html>"
  let sheet = ".gone { display: none } .invis { visibility: hidden } .vis { visibility: visible }"
  let ax = build_doc_ax(src, sheet, "")

  assert(find_by_role_and_name(ax, "button", "Ghost Button").is_none(), "aria-hidden subtree pruned")
  assert(find_by_role_and_name(ax, "link", "Gone Link").is_none(), "display:none subtree pruned")
  assert(find_by_role_and_name(ax, "button", "Hidden Button").is_none(), "visibility:hidden button pruned")
  assert(find_by_role_and_name(ax, "button", "Visible Child").is_some(), "visibility:visible descendant recovered")

  let alerts = find_by_role(ax, "alert")
  assert(alerts.length() == 1 && alerts[0].live == "assertive", "alert has implicit live=assertive")

  match find_by_role_and_name(ax, "dialog", "Confirm Delete") {
    Some(dlg) => {
      assert(dlg.modal, "dialog modal=true")
      assert(find_by_role_and_name(dlg, "button", "Delete").is_some(), "dialog child button present")
    }
    None => assert(false, "modal dialog missing")
  }
}

test "complex login form semantic autofill detection with exact layout coordinates and JSON export" {
  let src = "<!doctype html><html><head><title>Sign In</title></head><body>" +
  "<form aria-label=\"Login Form\">" +
  "  <input type=\"hidden\" name=\"csrf\" value=\"tok123\">" +
  "  <label for=\"u\">Email or Username</label>" +
  "  <input id=\"u\" name=\"username\" type=\"email\" autocomplete=\"username\" required>" +
  "  <label for=\"p\">Password</label>" +
  "  <input id=\"p\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required aria-invalid=\"true\">" +
  "  <select aria-label=\"Region\"><option value=\"us\" selected>US</option><option value=\"eu\">EU</option></select>" +
  "  <button id=\"sub\" type=\"submit\">Sign in</button>" +
  "</form></body></html>"
  let sheet = "body, form, label, input, select, button { margin: 0; padding: 0; border: 0 } form { display: block; width: 320px } label { display: block; height: 20px } input[type=email], input[type=password] { display: block; width: 300px; height: 36px; box-sizing: border-box } select { display: block; width: 300px; height: 32px } button { display: block; width: 140px; height: 40px; box-sizing: border-box }"
  let ax = build_doc_ax(src, sheet, "u")

  let forms = find_by_role(ax, "form")
  assert(forms.length() == 1 && forms[0].name == "Login Form", "login form found")

  // Hidden CSRF input must not be exposed
  let textboxes = find_by_role(ax, "textbox")
  assert(textboxes.length() == 2, "exactly 2 textboxes (username + password, no hidden csrf)")

  let user_node = textboxes[0]
  assert(user_node.name == "Email or Username", "username label")
  assert(user_node.input_type == "email", "username input_type")
  assert(user_node.autocomplete == "username", "username autocomplete")
  assert(user_node.required && user_node.focused, "username required & focused")
  assert(
    user_node.bounds.w == 300.0 && user_node.bounds.h == 36.0 && user_node.bounds.y == 20.0,
    "username exact bounds got x=" +
    user_node.bounds.x.to_string() +
    " y=" +
    user_node.bounds.y.to_string() +
    " w=" +
    user_node.bounds.w.to_string() +
    " h=" +
    user_node.bounds.h.to_string(),
  )

  let pass_node = textboxes[1]
  assert(pass_node.name == "Password", "password label")
  assert(pass_node.input_type == "password", "password input_type")
  assert(pass_node.autocomplete == "current-password", "password autocomplete")
  assert(pass_node.required && pass_node.invalid == "true", "password required & invalid")
  assert(pass_node.bounds.w == 300.0 && pass_node.bounds.h == 36.0 && pass_node.bounds.y == 76.0, "password exact bounds")

  let combos = find_by_role(ax, "combobox")
  assert(combos.length() == 1 && combos[0].name == "Region" && combos[0].value == "us", "select combobox value")

  match find_by_role_and_name(ax, "button", "Sign in") {
    Some(sub) => {
      assert(sub.bounds.w == 140.0 && sub.bounds.h == 40.0, "submit exact bounds")
      assert(sub.bounds.y > pass_node.bounds.y, "submit below password")
    }
    None => assert(false, "submit button missing")
  }

  let json = ax.to_json()
  assert(json.starts_with("{\"uid\":"), "json starts with object")
  assert(json.contains("\"role\":\"RootWebArea\""), "json has RootWebArea")
  assert(json.contains("\"autocomplete\":\"current-password\""), "json has autocomplete")
  assert(json.contains("\"invalid\":\"true\""), "json has invalid")
  assert(json.contains("\"bounds\":{\"x\":"), "json has bounds")
  assert(count_nodes(ax) >= 8, "node count >= 8")
}
