///| Unit tests for `raster`: Canvas 2D primitives, gradients, text, wire::Op rendering, PNG/JPEG/WebP ImageIO round-trip.

import "wire"
import "exif"
import "pixels"

fn pixel_at(rgba : Bytes, w : Int, x : Int, y : Int) -> (Int, Int, Int, Int) {
  let off = (y * w + x) * 4
  (
    rgba[off].to_int() & 0xFF,
    rgba[off + 1].to_int() & 0xFF,
    rgba[off + 2].to_int() & 0xFF,
    rgba[off + 3].to_int() & 0xFF,
  )
}

test "raster: rect, circle arc, linear gradient, text -> PNG encode & ImageIO decode pixel exact" {
  let s = Surface::new(64, 64)
  s.fill_rect(0.0, 0.0, 64.0, 64.0, 0xFFFFFFFF)
  s.fill_rect(4.0, 4.0, 20.0, 20.0, 0xFF0000FF)
  s.begin_path()
  s.arc(48.0, 16.0, 10.0, 0.0, 6.2831853, false)
  s.close_path()
  s.fill(0x00FF00FF, false)
  s.fill_linear_gradient(4.0, 32.0, 56.0, 12.0, 4.0, 32.0, 60.0, 32.0, [0.0, 1.0], [0x0000FFFF, 0xFFFF00FF])
  s.fill_text("Helvetica", 12.0, 6.0, 58.0, 0x000000FF, "Hi")

  let png = s.to_png()
  debug_assert(png.length() > 64, "PNG non-empty")
  debug_assert((png[0].to_int() & 0xFF) == 0x89 && (png[1].to_int() & 0xFF) == 80, "PNG magic")

  // Decode back via ImageIO and check pixels
  match image_size(png) {
    Option::Some((w, h)) => debug_assert(w == 64 && h == 64, "PNG size 64x64")
    Option::None => debug_assert(false, "image_size failed")
  }
  match decode_image(png) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 64 && h == 64, "decoded 64x64")
      let (r1, g1, b1, a1) = pixel_at(rgba, w, 10, 10)
      debug_assert(r1 == 255 && g1 == 0 && b1 == 0 && a1 == 255, "red rect pixel")
      let (r2, g2, b2, a2) = pixel_at(rgba, w, 48, 16)
      debug_assert(r2 == 0 && g2 == 255 && b2 == 0 && a2 == 255, "green circle center pixel")
      let (_, _, b3, a3) = pixel_at(rgba, w, 6, 38)
      debug_assert(b3 > 200 && a3 == 255, "gradient left is blue")
      let (r4, g4, _, a4) = pixel_at(rgba, w, 58, 38)
      debug_assert(r4 > 200 && g4 > 200 && a4 == 255, "gradient right is yellow")
    }
    Option::None => debug_assert(false, "PNG decode failed")
  }

  // Also test JPEG encode + ImageIO decode round-trip
  let jpg = s.to_jpeg(0.9)
  debug_assert(jpg.length() > 64 && (jpg[0].to_int() & 0xFF) == 0xFF && (jpg[1].to_int() & 0xFF) == 0xD8, "JPEG magic")
  match decode_image(jpg) {
    Option::Some((jw, jh, _)) => debug_assert(jw == 64 && jh == 64, "JPEG decoded 64x64")
    Option::None => debug_assert(false, "JPEG decode failed")
  }

  s.free()
}

test "raster: wire::Op display list rendering + put_image_data/get_image_data + WebP decode" {
  let ops : Array[wire::Op] = [
    wire::Op::Rect(0.0, 0.0, 32.0, 32.0, 0x102030FF),
    wire::Op::Clip(8.0, 8.0, 16.0, 16.0),
    wire::Op::Rect(0.0, 0.0, 32.0, 32.0, 0xFF8000FF),
    wire::Op::Unclip,
  ]
  let imgs : Map[String, (Int, Int, Bytes)] = Map::new()
  let surf = render_ops(ops, 32, 32, 1.0, imgs)
  let pix = surf.pixels()
  let (r0, g0, b0, _) = pixel_at(pix, 32, 2, 2)
  debug_assert(r0 == 0x10 && g0 == 0x20 && b0 == 0x30, "outside clip preserved")
  let (r1, g1, b1, _) = pixel_at(pix, 32, 16, 16)
  debug_assert(r1 == 0xFF && g1 == 0x80 && b1 == 0x00, "inside clip filled")

  // put_image_data / get_image_data round-trip
  let patch = Bytes::new(4)
  patch[0] = 0x12.to_byte()
  patch[1] = 0x34.to_byte()
  patch[2] = 0x56.to_byte()
  patch[3] = 0xFF.to_byte()
  surf.put_image_data(patch, 1, 1, 3, 3)
  let got = surf.get_image_data(3, 3, 1, 1)
  debug_assert((got[0].to_int() & 0xFF) == 0x12 && (got[1].to_int() & 0xFF) == 0x34 && (got[2].to_int() & 0xFF) == 0x56, "put/get_image_data exact")
  surf.free()

  // Minimal valid 1x1 lossless WebP (VP8L) decoded by macOS ImageIO
  let webp_arr : Array[Int] = [
    0x52, 0x49, 0x46, 0x46, 0x24, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x4C, 0x17, 0x00, 0x00, 0x00, 0x2F, 0x00, 0x00, 0x00,
    0x10, 0x07, 0x10, 0x11, 0x11, 0x88, 0x88, 0xFE, 0x07, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ]
  let webp = Bytes::new(webp_arr.length())
  let mut i = 0
  while i < webp_arr.length() {
    webp[i] = webp_arr[i].to_byte()
    i = i + 1
  }
  match image_size(webp) {
    Option::Some((ww, wh)) => debug_assert(ww == 1 && wh == 1, "WebP 1x1 size detected")
    Option::None => debug_assert(false, "WebP 1x1 size failed")
  }
  match decode_image(webp) {
    Option::Some((ww, wh, _)) => debug_assert(ww == 1 && wh == 1, "WebP 1x1 decoded")
    Option::None => debug_assert(false, "WebP 1x1 decode failed")
  }
}

test "raster: anti-aliased circle (corner outside circle stays white), radial gradient, cubic bezier & round clip" {
  let s = Surface::new(64, 64)
  s.fill_rect(0.0, 0.0, 64.0, 64.0, 0xFFFFFFFF)
  // Draw green circle centered at (32, 32), radius 16:
  // center (32, 32) must be green, bbox corner (17, 17) must stay white (proves real path fill, not bbox stub!)
  s.begin_path()
  s.arc(32.0, 32.0, 16.0, 0.0, 6.2831853, false)
  s.close_path()
  s.fill(0x00FF00FF, false)
  let px = s.pixels()
  let (cr, cg, cb, _) = pixel_at(px, 64, 32, 32)
  debug_assert(cr == 0 && cg == 255 && cb == 0, "circle center green")
  let (br, bg, bb, _) = pixel_at(px, 64, 17, 17)
  debug_assert(br == 255 && bg == 255 && bb == 255, "circle bbox corner stays white")

  // Radial gradient: red center -> blue outer
  s.fill_radial_gradient(0.0, 0.0, 64.0, 64.0, 32.0, 32.0, 0.0, 32.0, 32.0, 28.0, [0.0, 1.0], [0xFF0000FF, 0x0000FFFF])
  let gpx = s.pixels()
  let (gr0, _, gb0, _) = pixel_at(gpx, 64, 32, 32)
  debug_assert(gr0 > 200 && gb0 < 55, "radial gradient center red")
  let (gr1, _, gb1, _) = pixel_at(gpx, 64, 2, 2)
  debug_assert(gb1 > 200 && gr1 < 55, "radial gradient outer blue")

  // RoundClip preserves corners outside rounded rect
  let ops : Array[wire::Op] = [
    wire::Op::Rect(0.0, 0.0, 40.0, 40.0, 0x000000FF),
    wire::Op::RoundClip(4.0, 4.0, 32.0, 32.0, [12.0, 12.0, 12.0, 12.0]),
    wire::Op::Rect(0.0, 0.0, 40.0, 40.0, 0xFFFFFFFF),
    wire::Op::Unclip,
  ]
  let imgs : Map[String, (Int, Int, Bytes)] = Map::new()
  let rs = render_ops(ops, 40, 40, 1.0, imgs)
  let rpx = rs.pixels()
  let (rr0, rg0, rb0, _) = pixel_at(rpx, 40, 5, 5)
  debug_assert(rr0 == 0 && rg0 == 0 && rb0 == 0, "outside round clip corner stays black")
  let (rr1, rg1, rb1, _) = pixel_at(rpx, 40, 20, 20)
  debug_assert(rr1 == 255 && rg1 == 255 && rb1 == 255, "inside round clip center white")
  rs.free()
  s.free()
}

test "raster: pure-Pion invar/svg image_size, decode_image & decode_svg pixel exact" {
  let doc = "<svg xmlns='http://www.w3.org/2000/svg' width='40' height='20'><rect width='20' height='20' fill='#ff0000'/><rect x='20' width='20' height='20' fill='#0000ff'/></svg>".to_bytes()
  match image_size(doc) {
    Option::Some((w, h)) => debug_assert(w == 40 && h == 20, "SVG intrinsic size 40x20")
    Option::None => debug_assert(false, "SVG image_size failed")
  }
  match decode_image(doc) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 40 && h == 20, "SVG decoded 40x20")
      let (r0, g0, b0, a0) = pixel_at(rgba, w, 10, 10)
      debug_assert(r0 == 255 && g0 == 0 && b0 == 0 && a0 == 255, "SVG left half red")
      let (r1, g1, b1, a1) = pixel_at(rgba, w, 30, 10)
      debug_assert(r1 == 0 && g1 == 0 && b1 == 255 && a1 == 255, "SVG right half blue")
    }
    Option::None => debug_assert(false, "SVG decode_image failed")
  }
  match decode_svg(doc, 80) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 80 && h == 40, "SVG scaled 80x40")
      let (r0, g0, b0, a0) = pixel_at(rgba, w, 20, 20)
      debug_assert(r0 == 255 && g0 == 0 && b0 == 0 && a0 == 255, "SVG scaled left half red")
    }
    Option::None => debug_assert(false, "SVG decode_svg failed")
  }
}

test "raster: decode_svg renders SVG <text> with system fonts" {
  let doc = "<svg xmlns='http://www.w3.org/2000/svg' width='80' height='30'><text x='10' y='22' font-family='sans-serif' font-size='20' fill='#ff0000'>Hi</text></svg>".to_bytes()
  match decode_svg(doc, 80) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 80 && h == 30, "SVG text size 80x30")
      let mut red_pixels = 0
      let mut i = 0
      while i < w * h {
        let off = i * 4
        if rgba[off].to_int() > 150 && rgba[off + 3].to_int() > 100 {
          red_pixels = red_pixels + 1
        }
        i = i + 1
      }
      debug_assert(red_pixels > 20, "expected rendered SVG <text> red pixels, got " + red_pixels.to_string())
    }
    Option::None => debug_assert(false, "SVG text decode_svg failed")
  }
}

test "Wave 73A: Surface::write_png_into reuses caller buffer & matches Surface::to_png byte-for-byte" {
  let s = Surface::new(16, 12)
  s.fill_rect(2.0, 2.0, 10.0, 8.0, 0xFF3366FF)
  let need = png_size(16, 12)
  debug_assert(need > 0, "png_size > 0")
  let buf = Bytes::new(need)
  let got1 = s.write_png_into(buf)
  let ref1 = s.to_png()
  debug_assert(got1 == need && ref1.length() == need, "write_png_into length matches to_png")
  let mut same = true
  let mut i = 0
  while i < need {
    if buf[i] != ref1[i] {
      same = false
      break
    }
    i = i + 1
  }
  debug_assert(same, "write_png_into output matches to_png byte-for-byte")
  s.fill_rect(0.0, 0.0, 16.0, 12.0, 0x00CC88FF)
  let got2 = s.write_png_into(buf)
  debug_assert(got2 == need, "reused buffer write_png_into succeeds on second frame")
  match decode_image(buf) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 16 && h == 12, "decoded reused PNG dimensions 16x12")
      let (r, g, b, a) = pixel_at(rgba, w, 8, 6)
      debug_assert(r == 0 && g == 204 && b == 136 && a == 255, "reused PNG buffer reflects updated pixels")
    }
    Option::None => debug_assert(false, "decode_image failed on reused PNG buffer")
  }
  s.free()
}

test "Wave 74A: CGPathIsRect fill & axis-aligned horizontal/vertical line stroke fast paths" {
  let s = Surface::new(24, 24)
  // Axis-aligned horizontal line via beginPath + moveTo + lineTo + stroke
  s.begin_path()
  s.move_to(2.0, 6.0)
  s.line_to(20.0, 6.0)
  s.stroke(0xFF0000FF, 2.0)
  // Axis-aligned vertical line
  s.begin_path()
  s.move_to(12.0, 2.0)
  s.line_to(12.0, 22.0)
  s.stroke(0x00FF00FF, 2.0)
  // Closed rectangle path filled via CGPathIsRect fast path
  s.begin_path()
  s.move_to(16.0, 14.0)
  s.line_to(22.0, 14.0)
  s.line_to(22.0, 20.0)
  s.line_to(16.0, 20.0)
  s.close_path()
  s.fill(0x0000FFFF, false)
  // Zero-alpha stroke/fill must be a no-op
  s.begin_path()
  s.move_to(0.0, 0.0)
  s.line_to(24.0, 0.0)
  s.line_to(24.0, 24.0)
  s.line_to(0.0, 24.0)
  s.close_path()
  s.fill(0xFFFFFF00, false)
  let px = s.pixels()
  let (r1, g1, b1, a1) = pixel_at(px, 24, 6, 6)
  debug_assert(r1 == 255 && g1 == 0 && b1 == 0 && a1 == 255, "horizontal line stroke fast path draws red")
  let (r2, g2, b2, a2) = pixel_at(px, 24, 12, 16)
  debug_assert(r2 == 0 && g2 == 255 && b2 == 0 && a2 == 255, "vertical line stroke fast path draws green")
  let (r3, g3, b3, a3) = pixel_at(px, 24, 19, 17)
  debug_assert(r3 == 0 && g3 == 0 && b3 == 255 && a3 == 255, "rect path fill fast path draws blue")
  s.free()
}

test "Wave 75A: multi-segment axis-aligned polyline stroke & closed rect border stroke fast paths" {
  let s = Surface::new(32, 32)
  // Batched grid lines (multiple disconnected moveTo+lineTo segments)
  s.begin_path()
  s.move_to(2.0, 6.0)
  s.line_to(28.0, 6.0)
  s.move_to(2.0, 14.0)
  s.line_to(28.0, 14.0)
  s.move_to(10.0, 2.0)
  s.line_to(10.0, 28.0)
  s.stroke(0xFF0000FF, 2.0)
  // Closed 4-point axis-aligned rectangle border stroke
  s.begin_path()
  s.move_to(16.0, 18.0)
  s.line_to(26.0, 18.0)
  s.line_to(26.0, 28.0)
  s.line_to(16.0, 28.0)
  s.close_path()
  s.stroke(0x0000FFFF, 2.0)
  let px = s.pixels()
  let (r1, _, _, a1) = pixel_at(px, 32, 20, 6)
  let (r2, _, _, a2) = pixel_at(px, 32, 20, 14)
  let (r3, _, _, a3) = pixel_at(px, 32, 10, 20)
  debug_assert(r1 == 255 && a1 == 255 && r2 == 255 && a2 == 255 && r3 == 255 && a3 == 255, "batched multi-segment axis-aligned grid lines draw red")
  let (_, _, b4, a4) = pixel_at(px, 32, 21, 18)
  let (_, _, b5, a5) = pixel_at(px, 32, 21, 23)
  debug_assert(b4 == 255 && a4 == 255 && a5 == 0, "closed rect border stroke draws blue edge and leaves interior transparent")
  s.free()
}

test "Wave 75A review fixes: open 4-point U-shape, L-shape miter corner, translucent crossing lines" {
  // 1. Open 4-point U-shape stroke must NOT close the 4th edge
  let s1 = Surface::new(32, 32)
  s1.begin_path()
  s1.move_to(6.0, 6.0)
  s1.line_to(26.0, 6.0)
  s1.line_to(26.0, 26.0)
  s1.line_to(6.0, 26.0)
  s1.stroke(0xFF0000FF, 2.0)
  let px1 = s1.pixels()
  let (_, _, _, a_open) = pixel_at(px1, 32, 6, 16)
  let (r_top, _, _, a_top) = pixel_at(px1, 32, 16, 6)
  debug_assert(r_top == 255 && a_top == 255, "U-shape top edge drawn")
  debug_assert(a_open == 0, "open 4-point U-shape must not draw 4th closing edge, got a=" + a_open.to_string())
  s1.free()

  // 2. Connected L-shape polyline stroke must draw outer miter corner
  let s2 = Surface::new(32, 32)
  s2.begin_path()
  s2.move_to(6.0, 10.0)
  s2.line_to(20.0, 10.0)
  s2.line_to(20.0, 24.0)
  s2.stroke(0x00FF00FF, 6.0)
  let px2 = s2.pixels()
  // Outer corner of miter at (20+2, 10-2) = (22, 8) must be filled
  let (_, g_corner, _, a_corner) = pixel_at(px2, 32, 22, 8)
  debug_assert(g_corner == 255 && a_corner == 255, "L-shape miter outer corner must be drawn, got a=" + a_corner.to_string())
  s2.free()

  // 3. Translucent crossing horizontal + vertical lines must not double-blend alpha at intersection
  let s3 = Surface::new(32, 32)
  s3.begin_path()
  s3.move_to(4.0, 16.0)
  s3.line_to(28.0, 16.0)
  s3.move_to(16.0, 4.0)
  s3.line_to(16.0, 28.0)
  s3.stroke(0xFF000080, 4.0)
  let px3 = s3.pixels()
  let (_, _, _, a_arm) = pixel_at(px3, 32, 8, 16)
  let (_, _, _, a_cross) = pixel_at(px3, 32, 16, 16)
  debug_assert(a_arm > 100 && a_arm < 160, "single arm alpha ~128, got " + a_arm.to_string())
  debug_assert((a_cross - a_arm).abs() <= 2, "translucent cross intersection must not double-blend: cross=" + a_cross.to_string() + " arm=" + a_arm.to_string())
  s3.free()
}

///|
test "Wave 81A: PNG stored encoder CRC32/Adler32/unpremul roundtrip" {
  let s = Surface::new(24, 16)
  // Fill opaque, transparent, and semi-transparent rects to exercise all unpremul branches
  s.fill_rect(0.0, 0.0, 8.0, 16.0, 0x123456FF)
  s.fill_rect(8.0, 0.0, 8.0, 16.0, 0x8040C080)
  s.fill_rect(16.0, 0.0, 8.0, 16.0, 0x00000000)
  let png = s.to_png()
  debug_assert(png.length() > 64, "PNG output non-empty")
  // Verify PNG signature
  debug_assert(png[0] == 137.to_byte() && png[1] == 80.to_byte() && png[2] == 78.to_byte() && png[3] == 71.to_byte(), "valid PNG signature")
  // Decode back via decode_image to verify CRC32 + Adler32 checksums and unpremul pixels
  let dec = decode_image(png)
  match dec {
    Some((dw, dh, px)) => {
      debug_assert(dw == 24 && dh == 16, "decoded PNG dimensions match")
      let (r0, g0, b0, a0) = pixel_at(px, 24, 4, 8)
      debug_assert(r0 == 0x12 && g0 == 0x34 && b0 == 0x56 && a0 == 0xFF, "opaque pixel roundtrips exactly")
      let (r1, g1, b1, a1) = pixel_at(px, 24, 12, 8)
      debug_assert(a1 >= 126 && a1 <= 130 && r1 >= 124 && r1 <= 132 && g1 >= 60 && g1 <= 68 && b1 >= 188 && b1 <= 196, "semi-transparent pixel unpremul roundtrips accurately")
      let (_, _, _, a2) = pixel_at(px, 24, 20, 8)
      debug_assert(a2 == 0, "transparent pixel roundtrips as alpha=0")
    }
    None => debug_assert(false, "decode_image must succeed on encoded PNG (CRC32 + Adler32 valid)")
  }
  s.free()
}

///|
test "Wave 86A: direct circle fill/stroke, rect fill/clear, fractional clip, and moveTo+arc accuracy" {
  // 1. Direct full-circle fill (with moveTo at arc start point) + ring stroke under dpr scale(2, 2)
  let s1 = Surface::new(64, 64)
  s1.save()
  s1.transform(2.0, 0.0, 0.0, 2.0, 0.0, 0.0)
  s1.begin_path()
  s1.move_to(21.0, 16.0)
  s1.arc(16.0, 16.0, 5.0, 0.0, 6.283185307179586, false)
  s1.fill(0xFF0000FF, false)
  s1.stroke(0x0000FFFF, 2.0)
  s1.restore()
  let px1 = s1.pixels()
  // Center (32, 32) in pixel coords must be pure red fill
  let (rc, gc, bc, ac) = pixel_at(px1, 64, 32, 32)
  debug_assert(rc == 255 && gc == 0 && bc == 0 && ac == 255, "circle center must be red, got (" + rc.to_string() + "," + gc.to_string() + "," + bc.to_string() + "," + ac.to_string() + ")")
  // Ring at radius 10px -> pixel (42, 32) must be blue stroke
  let (rr, _, br, ar) = pixel_at(px1, 64, 42, 32)
  debug_assert(br > 200 && rr < 40 && ar == 255, "circle ring must be blue, got r=" + rr.to_string() + " b=" + br.to_string() + " a=" + ar.to_string())
  // Far outside (4, 4) must remain transparent
  let (_, _, _, ao) = pixel_at(px1, 64, 4, 4)
  debug_assert(ao == 0, "outside circle must remain transparent")
  s1.free()

  // 2. Circle stroke-only ring must leave center transparent
  let s2 = Surface::new(40, 40)
  s2.begin_path()
  s2.arc(20.0, 20.0, 8.0, 0.0, 6.283185307179586, false)
  s2.stroke(0x00FF00FF, 2.0)
  let px2 = s2.pixels()
  let (_, _, _, a_mid) = pixel_at(px2, 40, 20, 20)
  let (_, g_ring, _, a_ring) = pixel_at(px2, 40, 28, 20)
  debug_assert(a_mid == 0, "stroke-only circle center must be transparent, got a=" + a_mid.to_string())
  debug_assert(g_ring > 200 && a_ring > 200, "stroke-only circle ring must be green")
  s2.free()

  // 3. Fractional clip rect: inside circle draws, straddling circle stays clipped outside clip box, restore unclips
  let s3 = Surface::new(48, 48)
  s3.save()
  s3.begin_path()
  s3.move_to(10.5, 10.5)
  s3.line_to(38.5, 10.5)
  s3.line_to(38.5, 38.5)
  s3.line_to(10.5, 38.5)
  s3.close_path()
  s3.clip(false)
  // Strictly inside fractional clip: fast path draws at (24, 24)
  s3.begin_path()
  s3.arc(24.0, 24.0, 4.0, 0.0, 6.283185307179586, false)
  s3.fill(0xFF0000FF, false)
  // Straddling left clip edge at x=10.5: must fall back and NOT paint x=7
  s3.begin_path()
  s3.arc(10.0, 24.0, 4.0, 0.0, 6.283185307179586, false)
  s3.fill(0x00FF00FF, false)
  s3.restore()
  // After restore(), direct fill_rect + clear_rect at (2, 2) must work unclipped
  s3.fill_rect(2.0, 2.0, 4.0, 4.0, 0x0000FFFF)
  s3.clear_rect(4.0, 2.0, 2.0, 4.0)
  let px3 = s3.pixels()
  let (r_in, _, _, a_in) = pixel_at(px3, 48, 24, 24)
  let (_, _, _, a_clipped) = pixel_at(px3, 48, 7, 24)
  let (_, _, b_unclip, a_unclip) = pixel_at(px3, 48, 3, 3)
  let (_, _, _, a_cleared) = pixel_at(px3, 48, 5, 3)
  debug_assert(r_in == 255 && a_in == 255, "circle inside fractional clip must draw")
  debug_assert(a_clipped == 0, "circle straddling fractional clip must stay clipped at x=7, got a=" + a_clipped.to_string())
  debug_assert(b_unclip == 255 && a_unclip == 255, "post-restore direct fill_rect must draw")
  debug_assert(a_cleared == 0, "post-restore direct clear_rect must clear")
  s3.free()

  // 4. moveTo far from arc start must fall back and draw connecting line
  let s4 = Surface::new(40, 40)
  s4.begin_path()
  s4.move_to(4.0, 20.0)
  s4.arc(24.0, 20.0, 4.0, 0.0, 6.283185307179586, false)
  s4.stroke(0xFF0000FF, 2.0)
  let px4 = s4.pixels()
  let (r_line, _, _, a_line) = pixel_at(px4, 40, 12, 20)
  debug_assert(r_line > 200 && a_line > 200, "moveTo + arc connecting segment must not be dropped")
  s4.free()
}

test "render_ops_with_glyphs rasterizes Glyphs and VGlyphs to non-blank pixels" {
  // Synthetic 1000-upem square glyph covering [100..900] x [0..800] (font Y-up)
  let box_glyph : Array[hostfont::PathCmd] = [
    hostfont::PathCmd::MoveTo(100.0, 0.0),
    hostfont::PathCmd::LineTo(900.0, 0.0),
    hostfont::PathCmd::LineTo(900.0, 800.0),
    hostfont::PathCmd::LineTo(100.0, 800.0),
    hostfont::PathCmd::Close,
  ]
  let ops : Array[wire::Op] = [
    wire::Op::Rect(0.0, 0.0, 80.0, 40.0, 0xFFFFFFFF),
    wire::Op::Glyphs(1, 20.0, 10.0, 30.0, 0xFF0000FF, [42, 42], [0.0, 24.0]),
    wire::Op::VGlyphs(1, 20.0, 0x0000FFFF, [42], [true], [60.0], [10.0]),
  ]
  let surf = render_ops_with_glyphs(
    ops,
    80,
    40,
    1.0,
    Map::new(),
    fn(fid : Int, gid : Int) -> Option[(Int, Array[hostfont::PathCmd])] {
      if fid == 1 && gid == 42 {
        Option::Some((1000, box_glyph))
      } else {
        Option::None
      }
    },
  )
  let px = surf.pixels()
  // First horizontal glyph at x=10, y=30, size=20 -> covers x=[12..28], y=[14..30]
  let (r1, g1, b1, a1) = pixel_at(px, 80, 20, 22)
  debug_assert(r1 > 200 && g1 < 50 && b1 < 50 && a1 == 255, "first horizontal glyph must be red")
  // Second horizontal glyph at x=10+24=34 -> covers x=[36..52], y=[14..30]
  let (r2, g2, b2, a2) = pixel_at(px, 80, 44, 22)
  debug_assert(r2 > 200 && g2 < 50 && b2 < 50 && a2 == 255, "second horizontal glyph must be red")
  // Turned vertical glyph at (60, 10), size=20 -> x=[60..76], y=[12..28]
  let (r3, g3, b3, a3) = pixel_at(px, 80, 68, 20)
  debug_assert(r3 < 50 && g3 < 50 && b3 > 200 && a3 == 255, "turned vertical glyph must be blue")
  surf.free()
}

test "decode_image and image_size decode GIF87a via pure-Pion gif" {
  // Valid 2x2 GIF87a with 2 colors: (0,0)=(220,120,40), (1,0)=(40,160,220), (0,1)=(40,160,220), (1,1)=(220,120,40)
  let gif_vals : Array[Int] = [
    0x47, 0x49, 0x46, 0x38, 0x37, 0x61, 0x02, 0x00, 0x02, 0x00, 0x81, 0x00, 0x00,
    0xDC, 0x78, 0x28, 0x28, 0xA0, 0xDC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x2C,
    0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00, 0x00, 0x08, 0x07, 0x00, 0x01,
    0x04, 0x08, 0x00, 0x20, 0x20, 0x00, 0x3B,
  ]
  let gif = Bytes::new(gif_vals.length())
  let mut i = 0
  while i < gif_vals.length() {
    gif[i] = gif_vals[i].to_byte()
    i += 1
  }
  debug_assert(is_gif_bytes(gif), "GIF87a magic detected")
  match image_size(gif) {
    Option::Some((w, h)) => debug_assert(w == 2 && h == 2, "GIF87a image_size must be 2x2")
    Option::None => debug_assert(false, "GIF87a image_size returned None")
  }
  match decode_image(gif) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 2 && h == 2 && rgba.length() == 16, "GIF87a decode_image must be 2x2 RGBA")
      let (r0, g0, b0, a0) = pixel_at(rgba, 2, 0, 0)
      let (r1, g1, b1, a1) = pixel_at(rgba, 2, 1, 0)
      let (r2, g2, b2, a2) = pixel_at(rgba, 2, 0, 1)
      let (r3, g3, b3, a3) = pixel_at(rgba, 2, 1, 1)
      debug_assert(r0 == 220 && g0 == 120 && b0 == 40 && a0 == 255, "GIF87a pixel (0,0) exact")
      debug_assert(r1 == 40 && g1 == 160 && b1 == 220 && a1 == 255, "GIF87a pixel (1,0) exact")
      debug_assert(r2 == 40 && g2 == 160 && b2 == 220 && a2 == 255, "GIF87a pixel (0,1) exact")
      debug_assert(r3 == 220 && g3 == 120 && b3 == 40 && a3 == 255, "GIF87a pixel (1,1) exact")
    }
    Option::None => debug_assert(false, "GIF87a decode_image returned None")
  }
}

fn ints_to_bytes(vals : Array[Int]) -> Bytes {
  let out = Bytes::new(vals.length())
  let mut i = 0
  while i < vals.length() {
    out[i] = vals[i].to_byte()
    i = i + 1
  }
  out
}

fn push_all(dst : Array[Int], src : Array[Int]) -> Unit {
  let mut i = 0
  while i < src.length() {
    dst.push(src[i])
    i = i + 1
  }
}

///| Encode palette indices in `0..3` as valid GIF LZW with `min_code_size = 2`.
///| Emits Clear (4) every 2 literals so code width stays strictly 3 bits.
fn lzw_encode_2bit_literals(indices : Array[Int]) -> Array[Int] {
  let codes : Array[Int] = [4]
  let mut i = 0
  let mut since_clear = 0
  while i < indices.length() {
    if since_clear == 2 {
      codes.push(4)
      since_clear = 0
    }
    codes.push(indices[i] & 3)
    since_clear = since_clear + 1
    i = i + 1
  }
  codes.push(5)
  let packed : Array[Int] = []
  let mut bit_buf = 0
  let mut bit_cnt = 0
  let mut ci = 0
  while ci < codes.length() {
    bit_buf = bit_buf | (codes[ci] << bit_cnt)
    bit_cnt = bit_cnt + 3
    while bit_cnt >= 8 {
      packed.push(bit_buf & 0xFF)
      bit_buf = bit_buf >> 8
      bit_cnt = bit_cnt - 8
    }
    ci = ci + 1
  }
  if bit_cnt > 0 {
    packed.push(bit_buf & 0xFF)
  }
  let out : Array[Int] = [2, packed.length()]
  push_all(out, packed)
  out.push(0)
  out
}

fn push_gce(dst : Array[Int], disposal : Int, delay_cs : Int, trans_idx : Option[Int]) -> Unit {
  let (packed, tid) = match trans_idx {
    Option::Some(idx) => (((disposal & 7) << 2) | 1, idx & 0xFF)
    Option::None => ((disposal & 7) << 2, 0)
  }
  push_all(dst, [0x21, 0xF9, 0x04, packed, delay_cs & 0xFF, (delay_cs >> 8) & 0xFF, tid, 0x00])
}

fn push_netscape_loop(dst : Array[Int], loops : Int) -> Unit {
  push_all(
    dst,
    [
      0x21, 0xFF, 0x0B,
      0x4E, 0x45, 0x54, 0x53, 0x43, 0x41, 0x50, 0x45, 0x32, 0x2E, 0x30,
      0x03, 0x01, loops & 0xFF, (loops >> 8) & 0xFF, 0x00,
    ],
  )
}

fn push_image_desc(dst : Array[Int], left : Int, top : Int, w : Int, h : Int, indices : Array[Int]) -> Unit {
  push_all(
    dst,
    [
      0x2C,
      left & 0xFF, (left >> 8) & 0xFF,
      top & 0xFF, (top >> 8) & 0xFF,
      w & 0xFF, (w >> 8) & 0xFF,
      h & 0xFF, (h >> 8) & 0xFF,
      0x00,
    ],
  )
  push_all(dst, lzw_encode_2bit_literals(indices))
}

test "raster: pure-Pion GIF89a image_size & decode_image with transparent pixel" {
  // 2x2 GIF89a with 4-color GCT: 0=red, 1=green, 2=blue, 3=transparent
  let raw : Array[Int] = [
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61, // GIF89a
    0x02, 0x00, 0x02, 0x00, // 2x2
    0x91, 0x00, 0x00, // GCT flag=1, size=4 (2^(1+1))
    255, 0, 0, // 0: red
    0, 255, 0, // 1: green
    0, 0, 255, // 2: blue
    0, 0, 0, // 3: transparent
  ]
  push_gce(raw, 1, 4, Option::Some(3))
  push_image_desc(raw, 0, 0, 2, 2, [0, 1, 2, 3])
  raw.push(0x3B)
  let gif = ints_to_bytes(raw)

  debug_assert(is_gif_bytes(gif), "GIF89a magic detected")
  match image_size(gif) {
    Option::Some((w, h)) => debug_assert(w == 2 && h == 2, "GIF89a image_size 2x2")
    Option::None => debug_assert(false, "GIF89a image_size returned None")
  }
  match decode_image(gif) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 2 && h == 2 && rgba.length() == 16, "GIF89a 2x2 RGBA")
      let (r0, g0, b0, a0) = pixel_at(rgba, 2, 0, 0)
      let (r1, g1, b1, a1) = pixel_at(rgba, 2, 1, 0)
      let (r2, g2, b2, a2) = pixel_at(rgba, 2, 0, 1)
      let (r3, g3, b3, a3) = pixel_at(rgba, 2, 1, 1)
      debug_assert(r0 == 255 && g0 == 0 && b0 == 0 && a0 == 255, "GIF89a (0,0) red")
      debug_assert(r1 == 0 && g1 == 255 && b1 == 0 && a1 == 255, "GIF89a (1,0) green")
      debug_assert(r2 == 0 && g2 == 0 && b2 == 255 && a2 == 255, "GIF89a (0,1) blue")
      debug_assert(r3 == 0 && g3 == 0 && b3 == 0 && a3 == 0, "GIF89a (1,1) transparent")
    }
    Option::None => debug_assert(false, "GIF89a decode_image returned None")
  }
}

test "raster: decode_gif_animation multi-frame disposal, transparency, NETSCAPE2.0 loop & delay normalization" {
  // 2x2 animated GIF89a with GCT: 0=red, 1=green, 2=blue, 3=yellow
  let raw : Array[Int] = [
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61, // GIF89a
    0x02, 0x00, 0x02, 0x00, // 2x2
    0x91, 0x00, 0x00, // GCT size=4
    255, 0, 0, // 0: red
    0, 255, 0, // 1: green
    0, 0, 255, // 2: blue
    255, 255, 0, // 3: yellow
  ]
  push_netscape_loop(raw, 3)
  // Frame 0: full 2x2 [R, R, G, G], DoNotDispose (1), delay_cs=0 -> delay_ms=100
  push_gce(raw, 1, 0, Option::None)
  push_image_desc(raw, 0, 0, 2, 2, [0, 0, 1, 1])
  // Frame 1: sub-rect (1,0,1x2) [B, transparent], RestoreToPrevious (3), delay_cs=1 -> delay_ms=100
  push_gce(raw, 3, 1, Option::Some(3))
  push_image_desc(raw, 1, 0, 1, 2, [2, 3])
  // Frame 2: sub-rect (0,0,1x1) [Y], RestoreToBackground (2), delay_cs=5 -> delay_ms=50
  push_gce(raw, 2, 5, Option::None)
  push_image_desc(raw, 0, 0, 1, 1, [3])
  // Frame 3: sub-rect (1,1,1x1) [B], DoNotDispose (1), delay_cs=2 -> delay_ms=20
  push_gce(raw, 1, 2, Option::None)
  push_image_desc(raw, 1, 1, 1, 1, [2])
  raw.push(0x3B)
  let gif = ints_to_bytes(raw)

  match decode_gif_animation(gif) {
    Option::Some(anim) => {
      debug_assert(anim.width == 2 && anim.height == 2, "anim dimensions 2x2")
      debug_assert(anim.loop_count == 3, "NETSCAPE2.0 finite loop_count == 3")
      debug_assert(anim.frames.length() == 4, "4 animated frames decoded")

      // Frame 0: R R / G G, delay_cs=0, delay_ms=100
      let f0 = anim.frames[0]
      debug_assert(f0.width == 2 && f0.height == 2, "frame 0 size 2x2")
      debug_assert(f0.delay_cs == 0 && f0.delay_ms == 100, "frame 0 delay 0cs -> 100ms")
      let (f0_r00, f0_g00, f0_b00, f0_a00) = pixel_at(f0.rgba, 2, 0, 0)
      let (f0_r01, f0_g01, f0_b01, f0_a01) = pixel_at(f0.rgba, 2, 0, 1)
      debug_assert(f0_r00 == 255 && f0_g00 == 0 && f0_b00 == 0 && f0_a00 == 255, "frame 0 (0,0) red")
      debug_assert(f0_r01 == 0 && f0_g01 == 255 && f0_b01 == 0 && f0_a01 == 255, "frame 0 (0,1) green")

      // Frame 1: R B / G G (transparent (1,1) preserves frame 0 green), delay_cs=1, delay_ms=100
      let f1 = anim.frames[1]
      debug_assert(f1.delay_cs == 1 && f1.delay_ms == 100, "frame 1 delay 1cs -> 100ms")
      let (f1_r10, f1_g10, f1_b10, f1_a10) = pixel_at(f1.rgba, 2, 1, 0)
      let (f1_r11, f1_g11, f1_b11, f1_a11) = pixel_at(f1.rgba, 2, 1, 1)
      debug_assert(f1_r10 == 0 && f1_g10 == 0 && f1_b10 == 255 && f1_a10 == 255, "frame 1 (1,0) blue")
      debug_assert(f1_r11 == 0 && f1_g11 == 255 && f1_b11 == 0 && f1_a11 == 255, "frame 1 (1,1) keeps frame 0 green via transparency")

      // Frame 2: Y R / G G (proves frame 1 RestoreToPrevious reverted (1,0) back to red), delay_cs=5, delay_ms=50
      let f2 = anim.frames[2]
      debug_assert(f2.delay_cs == 5 && f2.delay_ms == 50, "frame 2 delay 5cs -> 50ms")
      let (f2_r00, f2_g00, f2_b00, f2_a00) = pixel_at(f2.rgba, 2, 0, 0)
      let (f2_r10, f2_g10, f2_b10, f2_a10) = pixel_at(f2.rgba, 2, 1, 0)
      debug_assert(f2_r00 == 255 && f2_g00 == 255 && f2_b00 == 0 && f2_a00 == 255, "frame 2 (0,0) yellow")
      debug_assert(f2_r10 == 255 && f2_g10 == 0 && f2_b10 == 0 && f2_a10 == 255, "frame 2 (1,0) reverted to red by RestoreToPrevious")

      // Frame 3: transparent R / G B (proves frame 2 RestoreToBackground cleared (0,0)), delay_cs=2, delay_ms=20
      let f3 = anim.frames[3]
      debug_assert(f3.delay_cs == 2 && f3.delay_ms == 20, "frame 3 delay 2cs -> 20ms")
      let (f3_r00, f3_g00, f3_b00, f3_a00) = pixel_at(f3.rgba, 2, 0, 0)
      let (f3_r10, f3_g10, f3_b10, f3_a10) = pixel_at(f3.rgba, 2, 1, 0)
      let (f3_r01, f3_g01, f3_b01, f3_a01) = pixel_at(f3.rgba, 2, 0, 1)
      let (f3_r11, f3_g11, f3_b11, f3_a11) = pixel_at(f3.rgba, 2, 1, 1)
      debug_assert(f3_r00 == 0 && f3_g00 == 0 && f3_b00 == 0 && f3_a00 == 0, "frame 3 (0,0) cleared by RestoreToBackground")
      debug_assert(f3_r10 == 255 && f3_g10 == 0 && f3_b10 == 0 && f3_a10 == 255, "frame 3 (1,0) red")
      debug_assert(f3_r01 == 0 && f3_g01 == 255 && f3_b01 == 0 && f3_a01 == 255, "frame 3 (0,1) green")
      debug_assert(f3_r11 == 0 && f3_g11 == 0 && f3_b11 == 255 && f3_a11 == 255, "frame 3 (1,1) blue")
    }
    Option::None => debug_assert(false, "decode_gif_animation returned None for valid animated GIF")
  }

  // Also verify infinite NETSCAPE2.0 loop_count == 0
  let inf_raw : Array[Int] = [
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
    0x01, 0x00, 0x01, 0x00,
    0x80, 0x00, 0x00,
    10, 20, 30, 40, 50, 60,
  ]
  push_netscape_loop(inf_raw, 0)
  push_image_desc(inf_raw, 0, 0, 1, 1, [1])
  inf_raw.push(0x3B)
  match decode_gif_animation(ints_to_bytes(inf_raw)) {
    Option::Some(anim) => {
      debug_assert(anim.loop_count == 0, "NETSCAPE2.0 loop=0 maps to 0 (infinite)")
      debug_assert(anim.frames.length() == 1, "single frame decoded")
      let (r, g, b, a) = pixel_at(anim.frames[0].rgba, 1, 0, 0)
      debug_assert(r == 40 && g == 50 && b == 60 && a == 255, "infinite-loop GIF pixel exact")
    }
    Option::None => debug_assert(false, "decode_gif_animation failed on infinite-loop GIF")
  }
}

test "raster: malformed and bomb GIFs safely return None without panic or OOM" {
  // 1. Truncated GIF header
  let trunc = ints_to_bytes([0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x02, 0x00])
  debug_assert(image_size(trunc) is Option::None, "truncated GIF image_size -> None")
  debug_assert(decode_image(trunc) is Option::None, "truncated GIF decode_image -> None")
  debug_assert(decode_gif_animation(trunc) is Option::None, "truncated GIF decode_gif_animation -> None")

  // 2. Invalid LZW minimum code size (12 > 8)
  let bad_lzw = ints_to_bytes([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
    0x01, 0x00, 0x01, 0x00,
    0x80, 0x00, 0x00,
    255, 0, 0, 0, 255, 0,
    0x2C, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00,
    0x0C, 0x01, 0x00, 0x00, 0x3B,
  ])
  debug_assert(decode_image(bad_lzw) is Option::None, "invalid LZW code size decode_image -> None")
  debug_assert(decode_gif_animation(bad_lzw) is Option::None, "invalid LZW code size decode_gif_animation -> None")

  // 3. Decompression bomb (65535x65535 exceeds default_max_width=16384 and default_max_pixels=16M)
  let bomb = ints_to_bytes([
    0x47, 0x49, 0x46, 0x38, 0x39, 0x61,
    0xFF, 0xFF, 0xFF, 0xFF,
    0x80, 0x00, 0x00,
    0, 0, 0, 255, 255, 255,
    0x2C, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00,
    0x02, 0x02, 0x4C, 0x01, 0x00, 0x3B,
  ])
  match image_size(bomb) {
    Option::Some((w, h)) => debug_assert(w == 65535 && h == 65535, "probe_header reads bomb dims without allocation")
    Option::None => debug_assert(false, "probe_header should read valid 65535x65535 header")
  }
  debug_assert(decode_image(bomb) is Option::None, "bomb GIF decode_image safely returns None (0 OOM)")
  debug_assert(decode_gif_animation(bomb) is Option::None, "bomb GIF decode_gif_animation safely returns None (0 OOM)")

  // 4. Non-GIF bytes rejected cleanly by decode_gif_animation
  let not_gif = "NOT_A_GIF_FILE".to_bytes()
  debug_assert(!is_gif_bytes(not_gif), "non-GIF magic is false")
  debug_assert(decode_gif_animation(not_gif) is Option::None, "non-GIF decode_gif_animation -> None")
}

test "Batch 3: decode_svg converts CSS Color 4 color(display-p3 ...) and color(srgb ... / alpha) instead of falling back to black" {
  let svg_p3 = (
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\">" +
    "<rect x=\"0\" y=\"0\" width=\"10\" height=\"20\" fill=\"#F25E6B\" style=\"fill:#F25E6B;fill:color(display-p3 0.9490 0.3686 0.4196);fill-opacity:1;\"/>" +
    "<rect x=\"10\" y=\"0\" width=\"10\" height=\"20\" fill=\"#0030EC\" style=\"fill:#0030EC;fill:color(display-p3 0.0000 0.1882 0.9255);fill-opacity:1;\"/>" +
    "</svg>"
  ).to_bytes()
  match decode_svg(svg_p3, 20) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 20 && h == 20, "display-p3 SVG size 20x20")
      let (r1, g1, b1, a1) = pixel_at(rgba, w, 5, 10)
      debug_assert(r1 > 220 && g1 < 120 && b1 > 70 && a1 == 255, "left display-p3 coral-red must not turn black, got rgba=(" + r1.to_string() + "," + g1.to_string() + "," + b1.to_string() + "," + a1.to_string() + ")")
      let (r2, g2, b2, a2) = pixel_at(rgba, w, 15, 10)
      debug_assert(r2 < 40 && g2 < 80 && b2 > 210 && a2 == 255, "right display-p3 blue must not turn black, got rgba=(" + r2.to_string() + "," + g2.to_string() + "," + b2.to_string() + "," + a2.to_string() + ")")
    }
    Option::None => debug_assert(false, "decode_svg failed for display-p3 SVG")
  }
}

fn webp_test_fnv1a64(b : Bytes) -> UInt64 {
  let mut h : UInt64 = 14695981039346656037UL
  let n = b.length()
  let mut i = 0
  while i < n {
    h = h ^ b[i].to_int().to_int64().to_uint64()
    h = h * 1099511628211UL
    i = i + 1
  }
  h
}

test "raster: pure-Pion WebP image_size and decode_image cover VP8L, VP8, and VP8X+ALPH" {
  // 1. VP8L lossless 1x1 opaque red (255, 0, 0, 255)
  let vp8l_1x1 = ints_to_bytes([
    82, 73, 70, 70, 28, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 76, 15, 0, 0, 0, 47, 0, 0, 0, 0, 7, 16,
    253, 143, 254, 7, 34, 162, 255, 1, 0,
  ])
  debug_assert(is_webp_bytes(vp8l_1x1), "VP8L 1x1 recognized as WebP")
  match image_size(vp8l_1x1) {
    Option::Some((w, h)) => debug_assert(w == 1 && h == 1, "VP8L 1x1 image_size == 1x1")
    Option::None => debug_assert(false, "VP8L 1x1 image_size returned None")
  }
  match decode_image(vp8l_1x1) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 1 && h == 1 && rgba.length() == 4, "VP8L 1x1 dims & len")
      let (r, g, b, a) = pixel_at(rgba, w, 0, 0)
      debug_assert(r == 255 && g == 0 && b == 0 && a == 255, "VP8L 1x1 exact red pixel")
      debug_assert(webp_test_fnv1a64(rgba) == 7593310196735934163UL, "VP8L 1x1 pure-Pion hash exact")
    }
    Option::None => debug_assert(false, "VP8L 1x1 decode_image returned None")
  }

  // 2. VP8L lossless 16x16 gradient with alpha
  let vp8l_16x16 = ints_to_bytes([
    82, 73, 70, 70, 146, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 76, 134, 0, 0, 0, 47, 15, 192, 3, 16,
    185, 140, 232, 127, 236, 34, 10, 222, 255, 48, 48, 104, 219, 72, 210, 73, 6, 112, 252, 233, 238,
    87, 10, 157, 161, 96, 72, 91, 123, 155, 8, 124, 28, 161, 152, 20, 147, 98, 82, 36, 109, 41, 38,
    197, 164, 40, 199, 47, 112, 130, 64, 5, 110, 219, 40, 26, 195, 65, 190, 241, 97, 133, 36, 127,
    144, 200, 5, 63, 130, 63, 65, 227, 217, 31, 73, 107, 244, 236, 143, 208, 186, 18, 90, 27, 161,
    117, 117, 181, 189, 172, 190, 139, 253, 192, 217, 62, 188, 167, 253, 192, 209, 62, 197, 79, 219,
    30, 237, 83, 20, 34, 183, 86, 228, 54, 137, 220, 118, 145, 219, 85, 228, 246, 242, 226, 14, 126,
    36, 65, 10,
  ])
  match image_size(vp8l_16x16) {
    Option::Some((w, h)) => debug_assert(w == 16 && h == 16, "VP8L 16x16 image_size == 16x16")
    Option::None => debug_assert(false, "VP8L 16x16 image_size returned None")
  }
  match decode_image(vp8l_16x16) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 16 && h == 16 && rgba.length() == 1024, "VP8L 16x16 dims & len")
      let (r0, _, _, a0) = pixel_at(rgba, w, 0, 0)
      debug_assert(r0 == 0 && a0 == 128, "VP8L 16x16 (0,0) alpha=128")
      let (r1, g1, b1, a1) = pixel_at(rgba, w, 15, 15)
      debug_assert(r1 == 74 && g1 == 14 && b1 == 0 && a1 == 248, "VP8L 16x16 (15,15) exact RGBA")
      debug_assert(webp_test_fnv1a64(rgba) == 12420637356515786181UL, "VP8L 16x16 pure-Pion hash exact")
    }
    Option::None => debug_assert(false, "VP8L 16x16 decode_image returned None")
  }

  // 3. VP8 lossy 17x13
  let vp8_17x13 = ints_to_bytes([
    82, 73, 70, 70, 134, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 32, 122, 0, 0, 0, 144, 4, 0, 157, 1,
    42, 17, 0, 13, 0, 62, 145, 62, 154, 72, 37, 163, 162, 161, 48, 8, 0, 176, 18, 9, 108, 0, 157, 50,
    132, 119, 55, 128, 111, 0, 176, 255, 187, 85, 3, 2, 138, 110, 214, 0, 0, 254, 245, 220, 80, 238,
    200, 12, 18, 79, 182, 165, 88, 117, 63, 159, 254, 150, 114, 175, 153, 35, 168, 255, 116, 255,
    220, 178, 181, 204, 190, 151, 205, 240, 176, 105, 254, 157, 118, 87, 6, 255, 206, 53, 33, 47,
    150, 8, 87, 56, 153, 111, 240, 80, 175, 164, 242, 121, 36, 144, 155, 77, 49, 167, 62, 146, 183,
    233, 43, 127, 77, 185, 127, 166, 209, 0, 0,
  ])
  match image_size(vp8_17x13) {
    Option::Some((w, h)) => debug_assert(w == 17 && h == 13, "VP8 17x13 image_size == 17x13")
    Option::None => debug_assert(false, "VP8 17x13 image_size returned None")
  }
  match decode_image(vp8_17x13) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 17 && h == 13 && rgba.length() == 17 * 13 * 4, "VP8 17x13 dims & len")
      let (r0, g0, b0, a0) = pixel_at(rgba, w, 0, 0)
      debug_assert(r0 == 38 && g0 == 42 && b0 == 16 && a0 == 255, "VP8 17x13 (0,0) exact RGBA")
      debug_assert(webp_test_fnv1a64(rgba) == 18126280748633696700UL, "VP8 17x13 pure-Pion hash exact")
    }
    Option::None => debug_assert(false, "VP8 17x13 decode_image returned None")
  }

  // 4. VP8X + ALPH (VP8L-compressed alpha) + VP8 lossy 17x13
  let vp8x_alph = ints_to_bytes([
    82, 73, 70, 70, 206, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 88, 10, 0, 0, 0, 16, 0, 0, 0, 16, 0,
    0, 12, 0, 0, 65, 76, 80, 72, 23, 0, 0, 0, 1, 185, 140, 232, 127, 128, 72, 219, 102, 124, 104,
    254, 5, 31, 158, 70, 76, 192, 4, 80, 115, 174, 0, 0, 86, 80, 56, 32, 144, 0, 0, 0, 240, 4, 0,
    157, 1, 42, 17, 0, 13, 0, 62, 145, 60, 152, 71, 165, 163, 162, 161, 48, 8, 0, 176, 18, 9, 108,
    0, 157, 50, 132, 119, 55, 128, 111, 1, 24, 105, 139, 254, 238, 0, 10, 225, 100, 150, 17, 12, 0,
    0, 254, 244, 89, 71, 168, 14, 213, 70, 235, 19, 110, 244, 54, 251, 132, 145, 179, 247, 13, 172,
    215, 240, 224, 201, 176, 132, 251, 169, 36, 191, 245, 49, 13, 177, 4, 246, 57, 107, 217, 173,
    56, 52, 251, 156, 223, 11, 67, 127, 232, 204, 128, 252, 96, 78, 185, 202, 156, 49, 150, 113, 41,
    187, 97, 231, 25, 210, 248, 242, 23, 164, 39, 177, 40, 96, 27, 123, 27, 247, 234, 19, 154, 39,
    234, 145, 88, 7, 235, 17, 134, 191, 88, 139, 44, 0, 0,
  ])
  match image_size(vp8x_alph) {
    Option::Some((w, h)) => debug_assert(w == 17 && h == 13, "VP8X+ALPH 17x13 image_size == 17x13")
    Option::None => debug_assert(false, "VP8X+ALPH 17x13 image_size returned None")
  }
  match decode_image(vp8x_alph) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 17 && h == 13 && rgba.length() == 17 * 13 * 4, "VP8X+ALPH 17x13 dims & len")
      let (r0, g0, b0, a0) = pixel_at(rgba, w, 0, 0)
      debug_assert(r0 == 92 && g0 == 96 && b0 == 71 && a0 == 0, "VP8X+ALPH (0,0) exact RGBA with alpha=0")
      debug_assert(webp_test_fnv1a64(rgba) == 15335733769688195600UL, "VP8X+ALPH pure-Pion hash exact")
    }
    Option::None => debug_assert(false, "VP8X+ALPH decode_image returned None")
  }
}

test "raster: malformed, truncated, and 16383x16383 bomb WebPs safely return None without panic" {
  // 1. Truncated RIFF/WEBP container (no chunks)
  let trunc = ints_to_bytes([0x52, 0x49, 0x46, 0x46, 0x04, 0x00, 0x00, 0x00, 0x57, 0x45, 0x42, 0x50])
  debug_assert(is_webp_bytes(trunc), "truncated WebP header recognized")
  debug_assert(image_size(trunc) is Option::None, "truncated WebP image_size -> None")
  debug_assert(decode_image(trunc) is Option::None, "truncated WebP decode_image -> None")

  // 2. Malformed VP8L chunk with invalid signature byte (0x00 instead of 0x2F)
  let bad_vp8l = ints_to_bytes([
    0x52, 0x49, 0x46, 0x46, 20, 0, 0, 0, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x4C, 8, 0, 0, 0,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  ])
  debug_assert(image_size(bad_vp8l) is Option::None, "bad VP8L image_size -> None")
  debug_assert(decode_image(bad_vp8l) is Option::None, "bad VP8L decode_image -> None")

  // 3. 16383x16383 VP8L decompression bomb (268M pixels > default_max_pixels 16M)
  let vp8l_bomb = ints_to_bytes([
    0x52, 0x49, 0x46, 0x46, 20, 0, 0, 0, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x4C, 8, 0, 0, 0,
    0x2F, 0xFE, 0xBF, 0xFF, 0x0F, 0x00, 0x00, 0x00,
  ])
  match image_size(vp8l_bomb) {
    Option::Some((w, h)) => debug_assert(w == 16383 && h == 16383, "VP8L bomb image_size probes 16383x16383 without alloc")
    Option::None => debug_assert(false, "VP8L bomb image_size should probe header without alloc")
  }
  debug_assert(decode_image(vp8l_bomb) is Option::None, "16383x16383 VP8L bomb decode_image -> None (0 OOM)")

  // 4. 16383x16383 animated VP8X decompression bomb must also reject without falling back to platform decoder
  let vp8x_anim_bomb = ints_to_bytes([
    0x52, 0x49, 0x46, 0x46, 22, 0, 0, 0, 0x57, 0x45, 0x42, 0x50,
    0x56, 0x50, 0x38, 0x58, 10, 0, 0, 0,
    0x02, 0x00, 0x00, 0x00,
    0xFE, 0x3F, 0x00,
    0xFE, 0x3F, 0x00,
  ])
  match image_size(vp8x_anim_bomb) {
    Option::Some((w, h)) => debug_assert(w == 16383 && h == 16383, "VP8X anim bomb image_size probes 16383x16383")
    Option::None => debug_assert(false, "VP8X anim bomb image_size should probe header")
  }
  debug_assert(decode_image(vp8x_anim_bomb) is Option::None, "16383x16383 animated VP8X bomb decode_image -> None (no fallback OOM)")
}

fn exif_test_make_tiff_orientation(ori : Int) -> Array[Int] {
  // Minimal valid little-endian TIFF with IFD0 containing 1 entry: Orientation (0x0112, SHORT, count=1, value=ori)
  [
    0x49, 0x49, 0x2A, 0x00, // "II", magic 42
    0x08, 0x00, 0x00, 0x00, // IFD0 offset = 8
    0x01, 0x00, // 1 entry
    0x12, 0x01, // tag 0x0112 (Orientation)
    0x03, 0x00, // type SHORT (3)
    0x01, 0x00, 0x00, 0x00, // count = 1
    ori & 0xFF, (ori >> 8) & 0xFF, 0x00, 0x00, // value = ori
    0x00, 0x00, 0x00, 0x00, // next IFD = 0
  ]
}

fn exif_test_crc32(data : Array[Int], start : Int, len : Int) -> UInt {
  let mut c : UInt = 0xFFFFFFFFU
  let mut i = 0
  while i < len {
    c = c ^ (data[start + i] & 0xFF).to_uint()
    let mut b = 0
    while b < 8 {
      if (c & 1U) != 0U {
        c = (c >> 1) ^ 0xEDB88320U
      } else {
        c = c >> 1
      }
      b = b + 1
    }
    i = i + 1
  }
  c ^ 0xFFFFFFFFU
}

fn exif_test_inject_png_exif(png : Bytes, tiff : Array[Int]) -> Bytes {
  // Insert eXIf chunk immediately after 8-byte PNG signature + 25-byte IHDR chunk (offset 33)
  let out : Array[Int] = []
  let mut i = 0
  while i < 33 {
    out.push(png[i].to_int() & 0xFF)
    i = i + 1
  }
  let n = tiff.length()
  out.push((n >> 24) & 0xFF)
  out.push((n >> 16) & 0xFF)
  out.push((n >> 8) & 0xFF)
  out.push(n & 0xFF)
  let type_start = out.length()
  out.push(0x65) // 'e'
  out.push(0x58) // 'X'
  out.push(0x49) // 'I'
  out.push(0x66) // 'f'
  push_all(out, tiff)
  let crc = exif_test_crc32(out, type_start, 4 + n)
  out.push(((crc >> 24) & 0xFFU).to_int())
  out.push(((crc >> 16) & 0xFFU).to_int())
  out.push(((crc >> 8) & 0xFFU).to_int())
  out.push((crc & 0xFFU).to_int())
  while i < png.length() {
    out.push(png[i].to_int() & 0xFF)
    i = i + 1
  }
  ints_to_bytes(out)
}

fn exif_test_inject_jpeg_exif(jpg : Bytes, tiff : Array[Int]) -> Bytes {
  // Insert APP1 ("Exif\0\0" + tiff) immediately after SOI (0xFF 0xD8)
  let out : Array[Int] = [0xFF, 0xD8, 0xFF, 0xE1]
  let seg_len = 2 + 6 + tiff.length()
  out.push((seg_len >> 8) & 0xFF)
  out.push(seg_len & 0xFF)
  push_all(out, [0x45, 0x78, 0x69, 0x66, 0x00, 0x00])
  push_all(out, tiff)
  let mut i = 2
  while i < jpg.length() {
    out.push(jpg[i].to_int() & 0xFF)
    i = i + 1
  }
  ints_to_bytes(out)
}

fn exif_test_wrap_webp_with_exif(vp8_webp : Bytes, w : Int, h : Int, tiff : Array[Int]) -> Bytes {
  // Build RIFF/WEBP with VP8X (EXIF flag=0x08), original VP8 chunk (starting at byte 12), and EXIF chunk
  let body : Array[Int] = []
  // VP8X chunk (10-byte payload)
  push_all(body, [0x56, 0x50, 0x38, 0x58, 10, 0, 0, 0])
  push_all(body, [0x08, 0x00, 0x00, 0x00]) // flags: EXIF bit (0x08)
  let wm1 = w - 1
  let hm1 = h - 1
  push_all(body, [wm1 & 0xFF, (wm1 >> 8) & 0xFF, (wm1 >> 16) & 0xFF])
  push_all(body, [hm1 & 0xFF, (hm1 >> 8) & 0xFF, (hm1 >> 16) & 0xFF])
  // Original VP8 chunk (bytes 12..end of vp8_webp)
  let mut i = 12
  while i < vp8_webp.length() {
    body.push(vp8_webp[i].to_int() & 0xFF)
    i = i + 1
  }
  if (body.length() & 1) != 0 {
    body.push(0)
  }
  // EXIF chunk
  let en = tiff.length()
  push_all(body, [0x45, 0x58, 0x49, 0x46])
  push_all(body, [en & 0xFF, (en >> 8) & 0xFF, (en >> 16) & 0xFF, (en >> 24) & 0xFF])
  push_all(body, tiff)
  if (en & 1) != 0 {
    body.push(0)
  }
  let riff_size = 4 + body.length()
  let out : Array[Int] = [
    0x52, 0x49, 0x46, 0x46,
    riff_size & 0xFF, (riff_size >> 8) & 0xFF, (riff_size >> 16) & 0xFF, (riff_size >> 24) & 0xFF,
    0x57, 0x45, 0x42, 0x50,
  ]
  push_all(out, body)
  ints_to_bytes(out)
}

test "raster: apply_exif_orientation all 8 TIFF 6.0 orientations exact on asymmetric 2x3 RGBA block" {
  // 2x3 block with 6 distinct RGBA pixels:
  // row 0: A=(10,20,30,255)   B=(40,50,60,255)
  // row 1: C=(70,80,90,255)   D=(100,110,120,255)
  // row 2: E=(130,140,150,255) F=(160,170,180,255)
  let src = ints_to_bytes([
    10, 20, 30, 255, 40, 50, 60, 255,
    70, 80, 90, 255, 100, 110, 120, 255,
    130, 140, 150, 255, 160, 170, 180, 255,
  ])
  let check_px = fn(buf : Bytes, w : Int, x : Int, y : Int, r : Int, label : String) -> Unit {
    let (pr, pg, pb, pa) = pixel_at(buf, w, x, y)
    debug_assert(pr == r && pg == r + 10 && pb == r + 20 && pa == 255, label + " expected r=" + r.to_string() + " got " + pr.to_string())
  }

  // 1: Normal (2x3) -> [[A, B], [C, D], [E, F]]
  let (b1, w1, h1) = apply_exif_orientation(src, 2, 3, exif::Orientation::Normal)
  debug_assert(w1 == 2 && h1 == 3, "ori1 dims 2x3")
  check_px(b1, w1, 0, 0, 10, "ori1 (0,0)=A")
  check_px(b1, w1, 1, 0, 40, "ori1 (1,0)=B")
  check_px(b1, w1, 0, 1, 70, "ori1 (0,1)=C")
  check_px(b1, w1, 1, 1, 100, "ori1 (1,1)=D")
  check_px(b1, w1, 0, 2, 130, "ori1 (0,2)=E")
  check_px(b1, w1, 1, 2, 160, "ori1 (1,2)=F")

  // 2: FlipHorizontal (2x3) -> [[B, A], [D, C], [F, E]]
  let (b2, w2, h2) = apply_exif_orientation(src, 2, 3, exif::Orientation::FlipHorizontal)
  debug_assert(w2 == 2 && h2 == 3, "ori2 dims 2x3")
  check_px(b2, w2, 0, 0, 40, "ori2 (0,0)=B")
  check_px(b2, w2, 1, 0, 10, "ori2 (1,0)=A")
  check_px(b2, w2, 0, 1, 100, "ori2 (0,1)=D")
  check_px(b2, w2, 1, 1, 70, "ori2 (1,1)=C")
  check_px(b2, w2, 0, 2, 160, "ori2 (0,2)=F")
  check_px(b2, w2, 1, 2, 130, "ori2 (1,2)=E")

  // 3: Rotate180 (2x3) -> [[F, E], [D, C], [B, A]]
  let (b3, w3, h3) = apply_exif_orientation(src, 2, 3, exif::Orientation::Rotate180)
  debug_assert(w3 == 2 && h3 == 3, "ori3 dims 2x3")
  check_px(b3, w3, 0, 0, 160, "ori3 (0,0)=F")
  check_px(b3, w3, 1, 0, 130, "ori3 (1,0)=E")
  check_px(b3, w3, 0, 1, 100, "ori3 (0,1)=D")
  check_px(b3, w3, 1, 1, 70, "ori3 (1,1)=C")
  check_px(b3, w3, 0, 2, 40, "ori3 (0,2)=B")
  check_px(b3, w3, 1, 2, 10, "ori3 (1,2)=A")

  // 4: FlipVertical (2x3) -> [[E, F], [C, D], [A, B]]
  let (b4, w4, h4) = apply_exif_orientation(src, 2, 3, exif::Orientation::FlipVertical)
  debug_assert(w4 == 2 && h4 == 3, "ori4 dims 2x3")
  check_px(b4, w4, 0, 0, 130, "ori4 (0,0)=E")
  check_px(b4, w4, 1, 0, 160, "ori4 (1,0)=F")
  check_px(b4, w4, 0, 1, 70, "ori4 (0,1)=C")
  check_px(b4, w4, 1, 1, 100, "ori4 (1,1)=D")
  check_px(b4, w4, 0, 2, 10, "ori4 (0,2)=A")
  check_px(b4, w4, 1, 2, 40, "ori4 (1,2)=B")

  // 5: Transpose (3x2) -> [[A, C, E], [B, D, F]]
  let (b5, w5, h5) = apply_exif_orientation(src, 2, 3, exif::Orientation::Transpose)
  debug_assert(w5 == 3 && h5 == 2, "ori5 dims 3x2")
  check_px(b5, w5, 0, 0, 10, "ori5 (0,0)=A")
  check_px(b5, w5, 1, 0, 70, "ori5 (1,0)=C")
  check_px(b5, w5, 2, 0, 130, "ori5 (2,0)=E")
  check_px(b5, w5, 0, 1, 40, "ori5 (0,1)=B")
  check_px(b5, w5, 1, 1, 100, "ori5 (1,1)=D")
  check_px(b5, w5, 2, 1, 160, "ori5 (2,1)=F")

  // 6: Rotate90CW (3x2) -> [[E, C, A], [F, D, B]]
  let (b6, w6, h6) = apply_exif_orientation(src, 2, 3, exif::Orientation::Rotate90CW)
  debug_assert(w6 == 3 && h6 == 2, "ori6 dims 3x2")
  check_px(b6, w6, 0, 0, 130, "ori6 (0,0)=E")
  check_px(b6, w6, 1, 0, 70, "ori6 (1,0)=C")
  check_px(b6, w6, 2, 0, 10, "ori6 (2,0)=A")
  check_px(b6, w6, 0, 1, 160, "ori6 (0,1)=F")
  check_px(b6, w6, 1, 1, 100, "ori6 (1,1)=D")
  check_px(b6, w6, 2, 1, 40, "ori6 (2,1)=B")

  // 7: Transverse (3x2) -> [[F, D, B], [E, C, A]]
  let (b7, w7, h7) = apply_exif_orientation(src, 2, 3, exif::Orientation::Transverse)
  debug_assert(w7 == 3 && h7 == 2, "ori7 dims 3x2")
  check_px(b7, w7, 0, 0, 160, "ori7 (0,0)=F")
  check_px(b7, w7, 1, 0, 100, "ori7 (1,0)=D")
  check_px(b7, w7, 2, 0, 40, "ori7 (2,0)=B")
  check_px(b7, w7, 0, 1, 130, "ori7 (0,1)=E")
  check_px(b7, w7, 1, 1, 70, "ori7 (1,1)=C")
  check_px(b7, w7, 2, 1, 10, "ori7 (2,1)=A")

  // 8: Rotate270CW (3x2) -> [[B, D, F], [A, C, E]]
  let (b8, w8, h8) = apply_exif_orientation(src, 2, 3, exif::Orientation::Rotate270CW)
  debug_assert(w8 == 3 && h8 == 2, "ori8 dims 3x2")
  check_px(b8, w8, 0, 0, 40, "ori8 (0,0)=B")
  check_px(b8, w8, 1, 0, 100, "ori8 (1,0)=D")
  check_px(b8, w8, 2, 0, 160, "ori8 (2,0)=F")
  check_px(b8, w8, 0, 1, 10, "ori8 (0,1)=A")
  check_px(b8, w8, 1, 1, 70, "ori8 (1,1)=C")
  check_px(b8, w8, 2, 1, 130, "ori8 (2,1)=E")
}

test "raster: end-to-end EXIF Orientation=6 auto-rotation for PNG eXIf, JPEG APP1, WebP EXIF & malformed degradation" {
  let tiff_ori6 = exif_test_make_tiff_orientation(6)

  // 1. PNG (4x2 with 4 distinct quadrant colors) + eXIf Orientation=6 -> 2x4 rotated 90 deg CW
  let png_surf = Surface::new(4, 2)
  png_surf.fill_rect(0.0, 0.0, 2.0, 1.0, 0xFF0000FF) // top-left red
  png_surf.fill_rect(2.0, 0.0, 2.0, 1.0, 0x00FF00FF) // top-right green
  png_surf.fill_rect(0.0, 1.0, 2.0, 1.0, 0x0000FFFF) // bottom-left blue
  png_surf.fill_rect(2.0, 1.0, 2.0, 1.0, 0xFFFF00FF) // bottom-right yellow
  let png_base = png_surf.to_png()
  png_surf.free()
  let png_ori6 = exif_test_inject_png_exif(png_base, tiff_ori6)

  match image_size(png_ori6) {
    Option::Some((w, h)) => debug_assert(w == 2 && h == 4, "PNG ori6 image_size swapped to 2x4, got " + w.to_string() + "x" + h.to_string())
    Option::None => debug_assert(false, "PNG ori6 image_size returned None")
  }
  match decode_image(png_ori6) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 2 && h == 4 && rgba.length() == 32, "PNG ori6 decoded 2x4")
      let (r_tl, g_tl, b_tl, a_tl) = pixel_at(rgba, w, 0, 0)
      let (r_tr, g_tr, b_tr, a_tr) = pixel_at(rgba, w, 1, 0)
      let (r_bl, g_bl, b_bl, a_bl) = pixel_at(rgba, w, 0, 3)
      let (r_br, g_br, b_br, a_br) = pixel_at(rgba, w, 1, 3)
      debug_assert(r_tl == 0 && g_tl == 0 && b_tl == 255 && a_tl == 255, "PNG ori6 (0,0) = old bottom-left blue")
      debug_assert(r_tr == 255 && g_tr == 0 && b_tr == 0 && a_tr == 255, "PNG ori6 (1,0) = old top-left red")
      debug_assert(r_bl == 255 && g_bl == 255 && b_bl == 0 && a_bl == 255, "PNG ori6 (0,3) = old bottom-right yellow")
      debug_assert(r_br == 0 && g_br == 255 && b_br == 0 && a_br == 255, "PNG ori6 (1,3) = old top-right green")
    }
    Option::None => debug_assert(false, "PNG ori6 decode_image returned None")
  }

  // 2. JPEG (16x8 with 4 distinct quadrant colors) + APP1 Orientation=6 -> 8x16 rotated 90 deg CW
  let jpg_surf = Surface::new(16, 8)
  jpg_surf.fill_rect(0.0, 0.0, 8.0, 4.0, 0xFF0000FF) // top-left red
  jpg_surf.fill_rect(8.0, 0.0, 8.0, 4.0, 0x00FF00FF) // top-right green
  jpg_surf.fill_rect(0.0, 4.0, 8.0, 4.0, 0x0000FFFF) // bottom-left blue
  jpg_surf.fill_rect(8.0, 4.0, 8.0, 4.0, 0xFFFF00FF) // bottom-right yellow
  let jpg_base = jpg_surf.to_jpeg(0.98)
  jpg_surf.free()
  let jpg_ori6 = exif_test_inject_jpeg_exif(jpg_base, tiff_ori6)

  match image_size(jpg_ori6) {
    Option::Some((w, h)) => debug_assert(w == 8 && h == 16, "JPEG ori6 image_size swapped to 8x16, got " + w.to_string() + "x" + h.to_string())
    Option::None => debug_assert(false, "JPEG ori6 image_size returned None")
  }
  match decode_image(jpg_ori6) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 8 && h == 16 && rgba.length() == 8 * 16 * 4, "JPEG ori6 decoded 8x16")
      let (r_tl, g_tl, b_tl, _) = pixel_at(rgba, w, 1, 2)
      let (r_tr, g_tr, b_tr, _) = pixel_at(rgba, w, 6, 2)
      let (r_bl, g_bl, b_bl, _) = pixel_at(rgba, w, 1, 13)
      let (r_br, g_br, b_br, _) = pixel_at(rgba, w, 6, 13)
      debug_assert(b_tl > 200 && r_tl < 50 && g_tl < 50, "JPEG ori6 top-left = old bottom-left blue")
      debug_assert(r_tr > 200 && g_tr < 50 && b_tr < 50, "JPEG ori6 top-right = old top-left red")
      debug_assert(r_bl > 200 && g_bl > 200 && b_bl < 50, "JPEG ori6 bottom-left = old bottom-right yellow")
      debug_assert(g_br > 200 && r_br < 50 && b_br < 50, "JPEG ori6 bottom-right = old top-right green")
    }
    Option::None => debug_assert(false, "JPEG ori6 decode_image returned None")
  }

  // Verify empirically on macOS that ImageIO fallback returns raw unrotated pixels (so no double-rotation)
  if c_cg_available() != 0 {
    let wh_sz : Array[Int] = [0, 0]
    let ok_sz = c_image_size_fallback(bytes_data_ptr(jpg_ori6), jpg_ori6.length(), array_data_ptr(wh_sz))
    debug_assert(ok_sz != 0 && wh_sz[0] == 16 && wh_sz[1] == 8, "macOS ImageIO image_size_fallback returns raw 16x8")
    let wh_dec : Array[Int] = [0, 0]
    let raw_fb = take_buf(c_decode_image_fallback(bytes_data_ptr(jpg_ori6), jpg_ori6.length(), array_data_ptr(wh_dec)))
    debug_assert(wh_dec[0] == 16 && wh_dec[1] == 8 && raw_fb.length() == 16 * 8 * 4, "macOS ImageIO decode_image_fallback returns raw 16x8")
  }

  // 3. WebP (VP8 17x13 wrapped in VP8X + EXIF Orientation=6) -> 13x17 rotated 90 deg CW
  let vp8_17x13 = ints_to_bytes([
    82, 73, 70, 70, 134, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 32, 122, 0, 0, 0, 144, 4, 0, 157, 1,
    42, 17, 0, 13, 0, 62, 145, 62, 154, 72, 37, 163, 162, 161, 48, 8, 0, 176, 18, 9, 108, 0, 157, 50,
    132, 119, 55, 128, 111, 0, 176, 255, 187, 85, 3, 2, 138, 110, 214, 0, 0, 254, 245, 220, 80, 238,
    200, 12, 18, 79, 182, 165, 88, 117, 63, 159, 254, 150, 114, 175, 153, 35, 168, 255, 116, 255,
    220, 178, 181, 204, 190, 151, 205, 240, 176, 105, 254, 157, 118, 87, 6, 255, 206, 53, 33, 47,
    150, 8, 87, 56, 153, 111, 240, 80, 175, 164, 242, 121, 36, 144, 155, 77, 49, 167, 62, 146, 183,
    233, 43, 127, 77, 185, 127, 166, 209, 0, 0,
  ])
  let (raw_w, raw_h, raw_rgba) = match decode_image(vp8_17x13) {
    Option::Some(v) => v
    Option::None => {
      debug_assert(false, "baseline WebP decode failed")
      (0, 0, Bytes::new(0))
    }
  }
  debug_assert(raw_w == 17 && raw_h == 13, "baseline WebP 17x13")
  let webp_ori6 = exif_test_wrap_webp_with_exif(vp8_17x13, 17, 13, tiff_ori6)

  match image_size(webp_ori6) {
    Option::Some((w, h)) => debug_assert(w == 13 && h == 17, "WebP ori6 image_size swapped to 13x17, got " + w.to_string() + "x" + h.to_string())
    Option::None => debug_assert(false, "WebP ori6 image_size returned None")
  }
  match decode_image(webp_ori6) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 13 && h == 17 && rgba.length() == 13 * 17 * 4, "WebP ori6 decoded 13x17")
      // 90 deg CW: dst(0,0)=src(0,12), dst(12,0)=src(0,0), dst(0,16)=src(16,12), dst(12,16)=src(16,0)
      let px_eq = fn(a : (Int, Int, Int, Int), b : (Int, Int, Int, Int)) -> Bool {
        a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3
      }
      debug_assert(px_eq(pixel_at(rgba, w, 0, 0), pixel_at(raw_rgba, 17, 0, 12)), "WebP ori6 (0,0) == raw (0,12)")
      debug_assert(px_eq(pixel_at(rgba, w, 12, 0), pixel_at(raw_rgba, 17, 0, 0)), "WebP ori6 (12,0) == raw (0,0)")
      debug_assert(px_eq(pixel_at(rgba, w, 0, 16), pixel_at(raw_rgba, 17, 16, 12)), "WebP ori6 (0,16) == raw (16,12)")
      debug_assert(px_eq(pixel_at(rgba, w, 12, 16), pixel_at(raw_rgba, 17, 16, 0)), "WebP ori6 (12,16) == raw (16,0)")
    }
    Option::None => debug_assert(false, "WebP ori6 decode_image returned None")
  }

  // 4. Malformed EXIF payload silently degrades to Orientation::Normal without breaking decode
  let bad_tiff : Array[Int] = [0xDE, 0xAD, 0xBE, 0xEF, 0x00, 0x01]
  let png_bad_exif = exif_test_inject_png_exif(png_base, bad_tiff)
  match image_size(png_bad_exif) {
    Option::Some((w, h)) => debug_assert(w == 4 && h == 2, "malformed PNG eXIf degrades to raw 4x2")
    Option::None => debug_assert(false, "malformed PNG eXIf must not fail image_size")
  }
  match decode_image(png_bad_exif) {
    Option::Some((w, h, _)) => debug_assert(w == 4 && h == 2, "malformed PNG eXIf degrades to raw 4x2 decode")
    Option::None => debug_assert(false, "malformed PNG eXIf must not fail decode_image")
  }
  let jpg_bad_exif = exif_test_inject_jpeg_exif(jpg_base, bad_tiff)
  match image_size(jpg_bad_exif) {
    Option::Some((w, h)) => debug_assert(w == 16 && h == 8, "malformed JPEG EXIF degrades to raw 16x8")
    Option::None => debug_assert(false, "malformed JPEG EXIF must not fail image_size")
  }
  match decode_image(jpg_bad_exif) {
    Option::Some((w, h, _)) => debug_assert(w == 16 && h == 8, "malformed JPEG EXIF degrades to raw 16x8 decode")
    Option::None => debug_assert(false, "malformed JPEG EXIF must not fail decode_image")
  }
}

fn icc_test_push_u16_be(buf : Array[Int], v : Int) -> Unit {
  buf.push((v >> 8) & 0xFF)
  buf.push(v & 0xFF)
}

fn icc_test_push_u32_be(buf : Array[Int], v : Int64) -> Unit {
  buf.push(((v >> 24) & 0xFFL).to_int())
  buf.push(((v >> 16) & 0xFFL).to_int())
  buf.push(((v >> 8) & 0xFFL).to_int())
  buf.push((v & 0xFFL).to_int())
}

fn icc_test_push_s15fixed16(buf : Array[Int], v : Double) -> Unit {
  let scaled = if v >= 0.0 { (v * 65536.0 + 0.5).to_int64() } else { (v * 65536.0 - 0.5).to_int64() }
  let u = if scaled < 0L { scaled + 0x100000000L } else { scaled }
  icc_test_push_u32_be(buf, u)
}

fn icc_test_push_fourcc(buf : Array[Int], s : String) -> Unit {
  let mut i = 0
  while i < 4 {
    buf.push(s.code_unit_at(i) & 0xFF)
    i = i + 1
  }
}

fn icc_test_xyz_tag(x : Double, y : Double, z : Double) -> Array[Int] {
  let b : Array[Int] = []
  icc_test_push_fourcc(b, "XYZ ")
  icc_test_push_u32_be(b, 0L)
  icc_test_push_s15fixed16(b, x)
  icc_test_push_s15fixed16(b, y)
  icc_test_push_s15fixed16(b, z)
  b
}

fn icc_test_para3_srgb() -> Array[Int] {
  let b : Array[Int] = []
  icc_test_push_fourcc(b, "para")
  icc_test_push_u32_be(b, 0L)
  icc_test_push_u16_be(b, 3)
  icc_test_push_u16_be(b, 0)
  icc_test_push_s15fixed16(b, 2.4)
  icc_test_push_s15fixed16(b, 1.0 / 1.055)
  icc_test_push_s15fixed16(b, 0.055 / 1.055)
  icc_test_push_s15fixed16(b, 1.0 / 12.92)
  icc_test_push_s15fixed16(b, 0.04045)
  b
}

fn icc_test_curv_gamma(gamma : Double) -> Array[Int] {
  let b : Array[Int] = []
  icc_test_push_fourcc(b, "curv")
  icc_test_push_u32_be(b, 0L)
  icc_test_push_u32_be(b, 1L)
  icc_test_push_u16_be(b, (gamma * 256.0 + 0.5).to_int())
  b
}

fn icc_test_build_profile(
  major : Int,
  color_space : String,
  tags : Array[(String, Array[Int])],
  aliases : Array[(String, String)],
) -> Bytes {
  let total_tags = tags.length() + aliases.length()
  let mut cur_off = 128 + 4 + total_tags * 12
  while cur_off % 4 != 0 {
    cur_off = cur_off + 1
  }
  let offsets : Array[Int] = []
  let sizes : Array[Int] = []
  let mut i = 0
  while i < tags.length() {
    let (_, payload) = tags[i]
    offsets.push(cur_off)
    sizes.push(payload.length())
    cur_off = cur_off + payload.length()
    while cur_off % 4 != 0 {
      cur_off = cur_off + 1
    }
    i = i + 1
  }
  let profile_size = cur_off
  let buf : Array[Int] = []
  icc_test_push_u32_be(buf, profile_size.to_int64())
  icc_test_push_fourcc(buf, "pion")
  buf.push(major & 0xFF)
  buf.push(0)
  buf.push(0)
  buf.push(0)
  icc_test_push_fourcc(buf, "mntr")
  icc_test_push_fourcc(buf, color_space)
  icc_test_push_fourcc(buf, "XYZ ")
  // DateTime 2026-11-24 00:00:00
  icc_test_push_u16_be(buf, 2026)
  icc_test_push_u16_be(buf, 11)
  icc_test_push_u16_be(buf, 24)
  icc_test_push_u16_be(buf, 0)
  icc_test_push_u16_be(buf, 0)
  icc_test_push_u16_be(buf, 0)
  icc_test_push_fourcc(buf, "acsp")
  icc_test_push_fourcc(buf, "APPL")
  icc_test_push_u32_be(buf, 0L)
  icc_test_push_fourcc(buf, "PION")
  icc_test_push_fourcc(buf, "TEST")
  icc_test_push_u32_be(buf, 0L)
  icc_test_push_u32_be(buf, 0L)
  icc_test_push_u32_be(buf, 0L) // Perceptual intent
  icc_test_push_s15fixed16(buf, 0.96420288)
  icc_test_push_s15fixed16(buf, 1.0)
  icc_test_push_s15fixed16(buf, 0.82490540)
  icc_test_push_fourcc(buf, "pion")
  let mut k = 0
  while k < 44 {
    buf.push(0)
    k = k + 1
  }
  icc_test_push_u32_be(buf, total_tags.to_int64())
  i = 0
  while i < tags.length() {
    let (sig, _) = tags[i]
    icc_test_push_fourcc(buf, sig)
    icc_test_push_u32_be(buf, offsets[i].to_int64())
    icc_test_push_u32_be(buf, sizes[i].to_int64())
    i = i + 1
  }
  let mut a = 0
  while a < aliases.length() {
    let (nsig, tsig) = aliases[a]
    let mut off = 0
    let mut sz = 0
    let mut j = 0
    while j < tags.length() {
      let (s, _) = tags[j]
      if s == tsig {
        off = offsets[j]
        sz = sizes[j]
      }
      j = j + 1
    }
    icc_test_push_fourcc(buf, nsig)
    icc_test_push_u32_be(buf, off.to_int64())
    icc_test_push_u32_be(buf, sz.to_int64())
    a = a + 1
  }
  i = 0
  while i < tags.length() {
    let (_, payload) = tags[i]
    while buf.length() < offsets[i] {
      buf.push(0)
    }
    push_all(buf, payload)
    i = i + 1
  }
  while buf.length() < profile_size {
    buf.push(0)
  }
  ints_to_bytes(buf)
}

fn icc_test_display_p3_profile() -> Bytes {
  let trc = icc_test_para3_srgb()
  icc_test_build_profile(
    4,
    "RGB ",
    [
      ("wtpt", icc_test_xyz_tag(0.950455, 1.0, 1.089050)),
      ("rXYZ", icc_test_xyz_tag(0.515121, 0.241196, -0.001053)),
      ("gXYZ", icc_test_xyz_tag(0.291977, 0.692245, 0.041885)),
      ("bXYZ", icc_test_xyz_tag(0.157104, 0.066574, 0.784073)),
      ("rTRC", trc),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
}

fn icc_test_srgb_profile() -> Bytes {
  let trc = icc_test_para3_srgb()
  icc_test_build_profile(
    2,
    "RGB ",
    [
      ("wtpt", icc_test_xyz_tag(0.950455, 1.0, 1.089050)),
      ("rXYZ", icc_test_xyz_tag(0.436066, 0.222488, 0.013916)),
      ("gXYZ", icc_test_xyz_tag(0.385147, 0.716873, 0.097076)),
      ("bXYZ", icc_test_xyz_tag(0.143066, 0.060608, 0.714096)),
      ("rTRC", trc),
    ],
    [("gTRC", "rTRC"), ("bTRC", "rTRC")],
  )
}

fn icc_test_gray_gamma22_profile() -> Bytes {
  icc_test_build_profile(
    2,
    "GRAY",
    [
      ("wtpt", icc_test_xyz_tag(0.950455, 1.0, 1.089050)),
      ("kTRC", icc_test_curv_gamma(2.2)),
    ],
    [],
  )
}

fn icc_test_cmyk_profile() -> Bytes {
  icc_test_build_profile(
    2,
    "CMYK",
    [("wtpt", icc_test_xyz_tag(0.950455, 1.0, 1.089050))],
    [],
  )
}

fn icc_test_wrap_webp(
  vp8l_webp : Bytes,
  w : Int,
  h : Int,
  vp8x_flags : Int,
  icc_bytes : Option[Bytes],
  exif_tiff : Option[Array[Int]],
) -> Bytes {
  let body : Array[Int] = []
  // VP8X chunk (10-byte payload)
  push_all(body, [0x56, 0x50, 0x38, 0x58, 10, 0, 0, 0])
  push_all(body, [vp8x_flags & 0xFF, 0x00, 0x00, 0x00])
  let wm1 = w - 1
  let hm1 = h - 1
  push_all(body, [wm1 & 0xFF, (wm1 >> 8) & 0xFF, (wm1 >> 16) & 0xFF])
  push_all(body, [hm1 & 0xFF, (hm1 >> 8) & 0xFF, (hm1 >> 16) & 0xFF])
  // Optional ICCP chunk (per WebP spec, placed before image chunk)
  match icc_bytes {
    Option::Some(icc) => {
      let n = icc.length()
      push_all(body, [0x49, 0x43, 0x43, 0x50])
      push_all(body, [n & 0xFF, (n >> 8) & 0xFF, (n >> 16) & 0xFF, (n >> 24) & 0xFF])
      let mut i = 0
      while i < n {
        body.push(icc[i].to_int() & 0xFF)
        i = i + 1
      }
      if (n & 1) != 0 {
        body.push(0)
      }
    }
    Option::None => ()
  }
  // Original VP8L chunk (bytes 12..end of vp8l_webp)
  let mut i = 12
  while i < vp8l_webp.length() {
    body.push(vp8l_webp[i].to_int() & 0xFF)
    i = i + 1
  }
  if (body.length() & 1) != 0 {
    body.push(0)
  }
  // Optional EXIF chunk
  match exif_tiff {
    Option::Some(tiff) => {
      let en = tiff.length()
      push_all(body, [0x45, 0x58, 0x49, 0x46])
      push_all(body, [en & 0xFF, (en >> 8) & 0xFF, (en >> 16) & 0xFF, (en >> 24) & 0xFF])
      push_all(body, tiff)
      if (en & 1) != 0 {
        body.push(0)
      }
    }
    Option::None => ()
  }
  let riff_size = 4 + body.length()
  let out : Array[Int] = [
    0x52, 0x49, 0x46, 0x46,
    riff_size & 0xFF, (riff_size >> 8) & 0xFF, (riff_size >> 16) & 0xFF, (riff_size >> 24) & 0xFF,
    0x57, 0x45, 0x42, 0x50,
  ]
  push_all(out, body)
  ints_to_bytes(out)
}

fn icc_test_inject_jpeg_icc(jpg : Bytes, icc : Bytes) -> Bytes {
  // Insert APP2 ("ICC_PROFILE\0" + seq=1, total=1 + icc) immediately after SOI (0xFF 0xD8)
  let out : Array[Int] = [0xFF, 0xD8, 0xFF, 0xE2]
  let seg_len = 2 + 12 + 2 + icc.length()
  out.push((seg_len >> 8) & 0xFF)
  out.push(seg_len & 0xFF)
  push_all(out, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0x00, 0x01, 0x01])
  let mut k = 0
  while k < icc.length() {
    out.push(icc[k].to_int() & 0xFF)
    k = k + 1
  }
  let mut i = 2
  while i < jpg.length() {
    out.push(jpg[i].to_int() & 0xFF)
    i = i + 1
  }
  ints_to_bytes(out)
}

test "raster: apply_icc_rgba handles Display-P3, Grayscale, sRGB identity, and malformed/unsupported ICC" {
  let p3 = icc_test_display_p3_profile()
  let srgb = icc_test_srgb_profile()
  let gray = icc_test_gray_gamma22_profile()
  let cmyk = icc_test_cmyk_profile()
  let bad = ints_to_bytes([0xDE, 0xAD, 0xBE, 0xEF, 0x01, 0x02])

  let src = ints_to_bytes([200, 70, 40, 200, 128, 128, 128, 77])

  // 1. Display-P3 -> sRGB: (200, 70, 40, 200) -> ~(217, 56, 20, 200), gray stays ~128, alphas strictly preserved
  let out_p3 = apply_icc_rgba(src, p3)
  let (r0, g0, b0, a0) = pixel_at(out_p3, 2, 0, 0)
  debug_assert(
    (r0 - 217).abs() <= 1 && (g0 - 56).abs() <= 1 && (b0 - 20).abs() <= 1 && a0 == 200,
    "apply_icc_rgba Display-P3 expected ~(217,56,20,200), got (" + r0.to_string() + "," + g0.to_string() + "," + b0.to_string() + "," + a0.to_string() + ")",
  )
  let (gr, gg, gb, ga) = pixel_at(out_p3, 2, 1, 0)
  debug_assert((gr - 128).abs() <= 1 && (gg - 128).abs() <= 1 && (gb - 128).abs() <= 1 && ga == 77, "Display-P3 neutral gray & alpha preserved")

  // 2. Grayscale gamma 2.2 -> sRGB: gray (128,128,128,77) maps to ~129 with alpha=77
  let out_gray = apply_icc_rgba(src, gray)
  let (kr, kg, kb, ka) = pixel_at(out_gray, 2, 1, 0)
  debug_assert(kr == kg && kg == kb && (kr - 129).abs() <= 2 && ka == 77, "apply_icc_rgba Grayscale gamma 2.2")

  // 3. sRGB identity fast path: exact byte-for-byte unchanged
  let out_srgb = apply_icc_rgba(src, srgb)
  let (sr, sg, sb, sa) = pixel_at(out_srgb, 2, 0, 0)
  debug_assert(sr == 200 && sg == 70 && sb == 40 && sa == 200, "apply_icc_rgba sRGB identity unchanged")

  // 4. Malformed & unsupported CMYK profiles: graceful fallback to original pixels
  let out_bad = apply_icc_rgba(src, bad)
  let (br, bg, bb, ba) = pixel_at(out_bad, 2, 0, 0)
  debug_assert(br == 200 && bg == 70 && bb == 40 && ba == 200, "apply_icc_rgba malformed ICC graceful fallback")
  let out_cmyk = apply_icc_rgba(src, cmyk)
  let (cr, cg, cb, ca) = pixel_at(out_cmyk, 2, 0, 0)
  debug_assert(cr == 200 && cg == 70 && cb == 40 && ca == 200, "apply_icc_rgba unsupported CMYK graceful fallback")
}

test "raster: WebP Display-P3 ICC auto-conversion, Alpha preservation, VP8X flag guard, sRGB & malformed fallback" {
  // Valid 1x1 lossless VP8L with exact pixel (200, 70, 40, 200)
  let vp8l_1x1 = ints_to_bytes([
    82, 73, 70, 70, 30, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 76, 17, 0, 0, 0,
    47, 0, 0, 0, 16, 7, 80, 163, 34, 23, 165, 200, 129, 136, 232, 127, 0, 0,
  ])
  let p3 = icc_test_display_p3_profile()
  let srgb = icc_test_srgb_profile()
  let bad_icc = ints_to_bytes([0xDE, 0xAD, 0xBE, 0xEF, 0x00, 0x01, 0x02, 0x03])

  // 1. Plain VP8L (no VP8X/ICCP) stays exact (200, 70, 40, 200)
  match decode_image(vp8l_1x1) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 1 && h == 1, "plain VP8L 1x1")
      let (r, g, b, a) = pixel_at(rgba, 1, 0, 0)
      debug_assert(r == 200 && g == 70 && b == 40 && a == 200, "plain VP8L pixel exact (200,70,40,200)")
    }
    Option::None => debug_assert(false, "plain VP8L decode failed")
  }

  // 2. Display-P3 WebP (VP8X flags=0x20 + ICCP + VP8L) -> sRGB ~(217, 56, 20, 200), <= 1 LSB, Alpha == 200
  let webp_p3 = icc_test_wrap_webp(vp8l_1x1, 1, 1, 0x20, Option::Some(p3), Option::None)
  match decode_image(webp_p3) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 1 && h == 1, "Display-P3 WebP 1x1")
      let (r, g, b, a) = pixel_at(rgba, 1, 0, 0)
      debug_assert(
        (r - 217).abs() <= 1 && (g - 56).abs() <= 1 && (b - 20).abs() <= 1 && a == 200,
        "Display-P3 WebP expected ~(217,56,20,200), got (" + r.to_string() + "," + g.to_string() + "," + b.to_string() + "," + a.to_string() + ")",
      )
    }
    Option::None => debug_assert(false, "Display-P3 WebP decode failed")
  }

  // 3. WebP with ICCP chunk but VP8X ICCP flag bit (0x20) NOT set -> must NOT convert
  let webp_no_flag = icc_test_wrap_webp(vp8l_1x1, 1, 1, 0x00, Option::Some(p3), Option::None)
  match decode_image(webp_no_flag) {
    Option::Some((_, _, rgba)) => {
      let (r, g, b, a) = pixel_at(rgba, 1, 0, 0)
      debug_assert(r == 200 && g == 70 && b == 40 && a == 200, "WebP without VP8X 0x20 flag must not convert")
    }
    Option::None => debug_assert(false, "WebP no-flag decode failed")
  }

  // 4. sRGB WebP -> unchanged exact (200, 70, 40, 200)
  let webp_srgb = icc_test_wrap_webp(vp8l_1x1, 1, 1, 0x20, Option::Some(srgb), Option::None)
  match decode_image(webp_srgb) {
    Option::Some((_, _, rgba)) => {
      let (r, g, b, a) = pixel_at(rgba, 1, 0, 0)
      debug_assert(r == 200 && g == 70 && b == 40 && a == 200, "sRGB WebP identity unchanged")
    }
    Option::None => debug_assert(false, "sRGB WebP decode failed")
  }

  // 5. Malformed ICCP WebP -> graceful fallback to (200, 70, 40, 200)
  let webp_bad = icc_test_wrap_webp(vp8l_1x1, 1, 1, 0x20, Option::Some(bad_icc), Option::None)
  match decode_image(webp_bad) {
    Option::Some((_, _, rgba)) => {
      let (r, g, b, a) = pixel_at(rgba, 1, 0, 0)
      debug_assert(r == 200 && g == 70 && b == 40 && a == 200, "malformed ICC WebP graceful fallback")
    }
    Option::None => debug_assert(false, "malformed ICC WebP decode must not fail")
  }
}

test "raster: JPEG Display-P3 ICC empirical check (invar/pixels raw vs macOS ImageIO sRGB) & no double-conversion" {
  // Solid 16x16 JPEG with pixel (200, 70, 40, 255) = 0xC84628FF
  let s = Surface::new(16, 16)
  s.fill_rect(0.0, 0.0, 16.0, 16.0, 0xC84628FF)
  let jpg_base = s.to_jpeg(0.98)
  s.free()
  let p3 = icc_test_display_p3_profile()
  let jpg_p3 = icc_test_inject_jpeg_icc(jpg_base, p3)

  // Empirical check 1: pure-Pion `invar/pixels::decode_jpeg` returns RAW unconverted pixels ~(200, 70, 40)
  match pixels::decode_jpeg(jpg_p3) {
    Option::Some((w, h, raw_rgba)) => {
      debug_assert(w == 16 && h == 16, "pixels::decode_jpeg 16x16")
      let (rr, rg, rb, ra) = pixel_at(fixed_to_bytes(raw_rgba), 16, 8, 8)
      debug_assert(
        (rr - 200).abs() <= 3 && (rg - 70).abs() <= 3 && (rb - 40).abs() <= 3 && ra == 255,
        "pixels::decode_jpeg must return raw unconverted ~(200,70,40), got (" + rr.to_string() + "," + rg.to_string() + "," + rb.to_string() + ")",
      )
    }
    Option::None => debug_assert(false, "pixels::decode_jpeg failed on baseline JPEG")
  }

  // Empirical check 2: macOS ImageIO `c_decode_image_fallback` renders into kCGColorSpaceSRGB and
  // ALREADY converts Display-P3 -> sRGB ~(217, 56, 20), so the fallback path must NOT apply ICC again.
  if c_cg_available() != 0 {
    let wh_fb : Array[Int] = [0, 0]
    let fb_rgba = take_buf(c_decode_image_fallback(bytes_data_ptr(jpg_p3), jpg_p3.length(), array_data_ptr(wh_fb)))
    debug_assert(wh_fb[0] == 16 && wh_fb[1] == 16, "ImageIO fallback 16x16")
    let (fr, fg, fb, fa) = pixel_at(fb_rgba, 16, 8, 8)
    debug_assert(
      (fr - 217).abs() <= 3 && (fg - 56).abs() <= 3 && (fb - 20).abs() <= 3 && fa == 255,
      "macOS ImageIO fallback already converts Display-P3 to sRGB ~(217,56,20), got (" + fr.to_string() + "," + fg.to_string() + "," + fb.to_string() + ")",
    )
  }

  // Empirical check 3: `raster::decode_image` applies ICC exactly once on `pixels::decode_jpeg` output
  // -> sRGB ~(217, 56, 20) (double-conversion would yield ~233, 40, 0!)
  match decode_image(jpg_p3) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 16 && h == 16, "decode_image Display-P3 JPEG 16x16")
      let (r, g, b, a) = pixel_at(rgba, 16, 8, 8)
      debug_assert(
        (r - 217).abs() <= 3 && (g - 56).abs() <= 3 && (b - 20).abs() <= 3 && a == 255,
        "decode_image Display-P3 JPEG expected single-converted sRGB ~(217,56,20), got (" + r.to_string() + "," + g.to_string() + "," + b.to_string() + ")",
      )
    }
    Option::None => debug_assert(false, "decode_image Display-P3 JPEG failed")
  }

  // Malformed APP2 ICC on JPEG degrades gracefully to raw ~(200, 70, 40)
  let jpg_bad = icc_test_inject_jpeg_icc(jpg_base, ints_to_bytes([0xBA, 0xAD, 0xF0, 0x0D]))
  match decode_image(jpg_bad) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 16 && h == 16, "malformed ICC JPEG 16x16")
      let (r, g, b, a) = pixel_at(rgba, 16, 8, 8)
      debug_assert((r - 200).abs() <= 3 && (g - 70).abs() <= 3 && (b - 40).abs() <= 3 && a == 255, "malformed ICC JPEG degrades to raw pixels")
    }
    Option::None => debug_assert(false, "malformed ICC JPEG must not fail decode_image")
  }
}

test "raster: combined EXIF Orientation=6 + Display-P3 ICC on WebP (2x3->3x2) and JPEG (16x8->8x16)" {
  let p3 = icc_test_display_p3_profile()
  let tiff_ori6 = exif_test_make_tiff_orientation(6)

  // 1. WebP 2x3 lossless:
  //    (0,0)=(200,70,40,200), (1,0)=(40,200,70,255),
  //    (0,1)=(128,128,128,255), (1,1)=(40,70,200,180),
  //    (0,2)=(200,70,40,255), (1,2)=(220,220,220,255)
  let vp8l_2x3 = ints_to_bytes([
    82, 73, 70, 70, 80, 0, 0, 0, 87, 69, 66, 80, 86, 80, 56, 76, 68, 0, 0, 0,
    47, 1, 128, 0, 16, 47, 64, 144, 109, 51, 127, 162, 17, 140, 226, 8, 7, 82, 212, 182,
    13, 84, 120, 39, 128, 62, 7, 124, 96, 200, 2, 76, 198, 53, 164, 168, 58, 131, 10, 134,
    32, 219, 166, 254, 102, 115, 185, 195, 99, 255, 191, 225, 20, 7, 16, 215, 129, 64, 128, 50,
    86, 92, 176, 76, 68, 255, 99, 47,
  ])
  // VP8X flags = 0x20 (ICCP) | 0x08 (EXIF) | 0x10 (ALPH) = 0x38
  let webp_both = icc_test_wrap_webp(vp8l_2x3, 2, 3, 0x38, Option::Some(p3), Option::Some(tiff_ori6))
  match image_size(webp_both) {
    Option::Some((w, h)) => debug_assert(w == 3 && h == 2, "WebP P3+ori6 image_size swapped to 3x2")
    Option::None => debug_assert(false, "WebP P3+ori6 image_size failed")
  }
  match decode_image(webp_both) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 3 && h == 2 && rgba.length() == 24, "WebP P3+ori6 decoded 3x2")
      // Rotate90CW: dst(0,0)=src(0,2)=(200,70,40,255)->(217,56,20,255)
      let (r00, g00, b00, a00) = pixel_at(rgba, 3, 0, 0)
      debug_assert(
        (r00 - 217).abs() <= 1 && (g00 - 56).abs() <= 1 && (b00 - 20).abs() <= 1 && a00 == 255,
        "WebP P3+ori6 (0,0) rotated+P3 exact",
      )
      // Rotate90CW: dst(2,0)=src(0,0)=(200,70,40,200)->(217,56,20,200)
      let (r20, g20, b20, a20) = pixel_at(rgba, 3, 2, 0)
      debug_assert(
        (r20 - 217).abs() <= 1 && (g20 - 56).abs() <= 1 && (b20 - 20).abs() <= 1 && a20 == 200,
        "WebP P3+ori6 (2,0) rotated+P3+alpha=200 exact",
      )
      // Rotate90CW: dst(1,0)=src(0,1)=(128,128,128,255) stays neutral gray
      let (r10, g10, b10, a10) = pixel_at(rgba, 3, 1, 0)
      debug_assert(
        (r10 - 128).abs() <= 1 && (g10 - 128).abs() <= 1 && (b10 - 128).abs() <= 1 && a10 == 255,
        "WebP P3+ori6 (1,0) neutral gray",
      )
      // Rotate90CW: dst(1,1)=src(1,1)=(40,70,200,180) keeps alpha=180
      let (_, _, _, a11) = pixel_at(rgba, 3, 1, 1)
      debug_assert(a11 == 180, "WebP P3+ori6 (1,1) alpha=180 preserved")
    }
    Option::None => debug_assert(false, "WebP P3+ori6 decode_image failed")
  }

  // 2. JPEG 16x8 + APP1 EXIF Orientation=6 + APP2 Display-P3 ICC -> 8x16
  let s = Surface::new(16, 8)
  s.fill_rect(0.0, 0.0, 16.0, 4.0, 0xC84628FF) // top half: Display-P3 (200,70,40)
  s.fill_rect(0.0, 4.0, 16.0, 4.0, 0x808080FF) // bottom half: neutral gray (128,128,128)
  let jpg_base = s.to_jpeg(0.98)
  s.free()
  let jpg_both = icc_test_inject_jpeg_icc(exif_test_inject_jpeg_exif(jpg_base, tiff_ori6), p3)
  match image_size(jpg_both) {
    Option::Some((w, h)) => debug_assert(w == 8 && h == 16, "JPEG P3+ori6 image_size swapped to 8x16")
    Option::None => debug_assert(false, "JPEG P3+ori6 image_size failed")
  }
  match decode_image(jpg_both) {
    Option::Some((w, h, rgba)) => {
      debug_assert(w == 8 && h == 16 && rgba.length() == 8 * 16 * 4, "JPEG P3+ori6 decoded 8x16")
      // After 90 deg CW: right half (x=6) is old top half (Display-P3 -> sRGB ~(217,56,20)),
      // left half (x=1) is old bottom half (neutral gray ~(128,128,128))
      let (rr, rg, rb, ra) = pixel_at(rgba, 8, 6, 8)
      debug_assert(
        (rr - 217).abs() <= 3 && (rg - 56).abs() <= 3 && (rb - 20).abs() <= 3 && ra == 255,
        "JPEG P3+ori6 right half converted to sRGB ~(217,56,20), got (" + rr.to_string() + "," + rg.to_string() + "," + rb.to_string() + ")",
      )
      let (lr, lg, lb, la) = pixel_at(rgba, 8, 1, 8)
      debug_assert(
        (lr - 128).abs() <= 3 && (lg - 128).abs() <= 3 && (lb - 128).abs() <= 3 && la == 255,
        "JPEG P3+ori6 left half stays neutral gray ~(128,128,128), got (" + lr.to_string() + "," + lg.to_string() + "," + lb.to_string() + ")",
      )
    }
    Option::None => debug_assert(false, "JPEG P3+ori6 decode_image failed")
  }
}

test "software text font cache stays bounded across 50 unknown font-family names" {
  let s = Surface::new(64, 32)
  // Prime default fallback faces once
  let _ = software_text_faces("UnknownFamilyPrime")
  let base_count = software_font_face_cache_len()
  let mut i = 0
  while i < 50 {
    let fam = "\"UnknownWebFont_" + i.to_string() + "\", 'MissingFallback_" + i.to_string() + "', sans-serif"
    let faces = software_text_faces(fam)
    s.fill_text_software(fam, 14.0, 2.0, 20.0, 0xFFFFFFFF, "Hi")
    debug_assert(
      software_font_face_cache_len() == base_count,
      "path-keyed font cache must not grow for unknown families",
    )
    let _ = faces
    i = i + 1
  }
  s.free()
}

test "software text UTF-8 decoding handles ASCII, 3-byte CJK, 4-byte supplementary, and draws glyphs" {
  // 1-byte ASCII
  let (c0, s0) = decode_utf8_at("Hi", 0)
  let (c1, s1) = decode_utf8_at("Hi", 1)
  debug_assert(c0 == 0x48 && s0 == 1, "ASCII 'H' decodes to U+0048 (1 byte)")
  debug_assert(c1 == 0x69 && s1 == 1, "ASCII 'i' decodes to U+0069 (1 byte)")

  // 2-byte Latin-1 supplement ("é" = C3 A9 -> U+00E9)
  let (ce, se) = decode_utf8_at("é", 0)
  debug_assert(ce == 0x00E9 && se == 2, "2-byte UTF-8 'é' decodes to U+00E9 (2 bytes)")

  // 3-byte CJK ("中" = E4 B8 AD -> U+4E2D)
  let cjk = "中"
  debug_assert(cjk.length() == 3, "UTF-8 byte length of '中' is 3")
  let (cz, sz) = decode_utf8_at(cjk, 0)
  debug_assert(cz == 0x4E2D && sz == 3, "3-byte UTF-8 '中' decodes to U+4E2D (3 bytes)")

  // 4-byte supplementary ("😀" = F0 9F 98 80 -> U+1F600)
  let emoji = "😀"
  debug_assert(emoji.length() == 4, "UTF-8 byte length of '😀' is 4")
  let (cm, sm) = decode_utf8_at(emoji, 0)
  debug_assert(cm == 0x1F600 && sm == 4, "4-byte UTF-8 '😀' decodes to U+1F600 (4 bytes)")

  // Sequential mixed string decode: "A中😀"
  let mixed = "A中😀"
  let decoded : Array[Int] = []
  let mut idx = 0
  while idx < mixed.length() {
    let (cp, step) = decode_utf8_at(mixed, idx)
    decoded.push(cp)
    idx = idx + step
  }
  debug_assert(
    decoded.length() == 3 && decoded[0] == 0x41 && decoded[1] == 0x4E2D && decoded[2] == 0x1F600,
    "mixed UTF-8 string decodes to [U+0041, U+4E2D, U+1F600]",
  )

  // Truncated/invalid byte sequence returns U+FFFD and advances 1 byte
  let (bad_cp, bad_step) = decode_utf8_at(cjk, 1)
  debug_assert(bad_cp == 0xFFFD && bad_step == 1, "continuation byte at start yields U+FFFD, step 1")

  // Software text glyph lookup + drawing on Surface
  let s = Surface::new(96, 32)
  s.fill_text_software("sans-serif", 16.0, 4.0, 22.0, 0xFFFFFFFF, "Hi")
  let px_hi = s.pixels()
  let mut lit_hi = 0
  let mut k = 3
  while k < px_hi.length() {
    if px_hi[k].to_int() > 0 {
      lit_hi = lit_hi + 1
    }
    k = k + 4
  }
  debug_assert(lit_hi > 0, "fill_text_software draws visible pixels for ASCII 'Hi'")

  // Exercise 3-byte CJK & 4-byte supplementary through fill_text_software; if a system CJK font
  // covers U+4E2D, verify glyph_index(0x4E2D) succeeds and produces visible pixels.
  let s_cjk = Surface::new(64, 32)
  s_cjk.fill_text_software("sans-serif", 18.0, 4.0, 24.0, 0xFFFFFFFF, "中😀")
  let faces = software_text_faces("sans-serif")
  let mut has_cjk_glyph = false
  let mut fi = 0
  while fi < faces.length() {
    if faces[fi].glyph_index(0x4E2D) != 0 {
      has_cjk_glyph = true
      break
    }
    fi = fi + 1
  }
  if has_cjk_glyph {
    let px_cjk = s_cjk.pixels()
    let mut lit_cjk = 0
    let mut j = 3
    while j < px_cjk.length() {
      if px_cjk[j].to_int() > 0 {
        lit_cjk = lit_cjk + 1
      }
      j = j + 4
    }
    debug_assert(lit_cjk > 0, "fill_text_software draws visible pixels for CJK '中' when CJK font is available")
  }
  s_cjk.free()
  s.free()
}

test "encode_png fast native RLE PNG roundtrips bit-exact across solid, gradient, transparent, and pseudo-random patterns" {
  // 1. Solid color + transparent band (highly compressible via Filter 1 Sub + RLE)
  let w1 = 128
  let h1 = 64
  let solid = Bytes::new(w1 * h1 * 4)
  let mut y = 0
  while y < h1 {
    let mut x = 0
    while x < w1 {
      let k = (y * w1 + x) * 4
      if y < 32 {
        solid[k] = 42 as Byte
        solid[k + 1] = 128 as Byte
        solid[k + 2] = 240 as Byte
        solid[k + 3] = 255 as Byte
      } else {
        solid[k] = 0 as Byte
        solid[k + 1] = 0 as Byte
        solid[k + 2] = 0 as Byte
        solid[k + 3] = 0 as Byte
      }
      x += 1
    }
    y += 1
  }
  let p1 = encode_png(solid, w1, h1)
  debug_assert(p1.length() > 33 && p1.length() < 4096, "solid 128x64 PNG must compress well, got " + p1.length().to_string())
  match decode_image(p1) {
    Option::Some((dw, dh, rgba)) => {
      debug_assert(dw == w1 && dh == h1 && rgba.length() == solid.length(), "solid dims & length match")
      let mut i = 0
      while i < solid.length() {
        debug_assert(rgba[i] == solid[i], "solid byte mismatch at " + i.to_string())
        i += 1
      }
    }
    Option::None => debug_assert(false, "solid PNG decode failed")
  }

  // 2. Smooth 2D RGBA gradient + uncompressible pseudo-random noise (exercises fallback to stored PNG too)
  let w2 = 97
  let h2 = 53
  let noise = Bytes::new(w2 * h2 * 4)
  let mut seed = 0x1234567
  let mut i = 0
  while i < noise.length() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
    noise[i] = ((seed >> 16) & 0xFF).to_byte()
    i += 1
  }
  let p2 = encode_png(noise, w2, h2)
  match decode_image(p2) {
    Option::Some((dw, dh, rgba)) => {
      debug_assert(dw == w2 && dh == h2 && rgba.length() == noise.length(), "noise dims & length match")
      let mut j = 0
      while j < noise.length() {
        debug_assert(rgba[j] == noise[j], "noise byte mismatch at " + j.to_string())
        j += 1
      }
    }
    Option::None => debug_assert(false, "noise PNG decode failed")
  }
}
