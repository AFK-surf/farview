///| Core data models, timestamp normalization, and URL/text security sanitizers for `migrate`.
///|
///| Completely decoupled from rendering internals (`css`, `layout`, `stage`, `shell_ui`, `js`) so
///| any browser engine backend can reuse the same verified migration pipeline.

import "extensions"
import "proto"

pub struct ImportedBookmark {
  pub title : String
  pub url : String
  pub folder : String
  pub created_ms : Int64
}

pub struct ImportedHistoryItem {
  pub url : String
  pub title : String
  pub visit_count : Int
  pub typed_count : Int
  pub last_visit_secs : Int64
}

pub struct ImportedSpace {
  pub id : String
  pub name : String
}

pub struct ImportedFolder {
  pub id : String
  pub space_id : String
  pub title : String
}

pub struct ImportedPinnedTab {
  pub url : String
  pub title : String
  pub space_id : String
  pub folder_id : String
  pub is_favorite : Bool
}

pub struct ImportedCookie {
  pub domain : String
  pub include_subdomains : Bool
  pub path : String
  pub secure : Bool
  pub http_only : Bool
  pub expires_secs : Int64
  pub name : String
  pub value : String
}

pub struct ImportedPassword {
  pub name : String
  pub url : String
  pub username : String
  pub password : String
  pub note : String
}

pub fn mig_ascii_lower(s : String) -> String {
  let az = "abcdefghijklmnopqrstuvwxyz"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 65 && c <= 90 {
      sb.write_string(az.slice(c - 65, c - 64))
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i += 1
  }
  sb.to_string()
}

pub fn mig_parse_i64(raw : String) -> Option[Int64] {
  let s = raw.trim()
  if s == "" {
    return None
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0).to_int() == 45 {
    neg = true
    i = 1
  }
  let mut acc = 0L
  let mut digits = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
      digits += 1
      i += 1
    } else if c == 46 {
      // Stop at decimal fractional part (e.g. Safari CoreData float timestamps)
      break
    } else {
      return None
    }
  }
  if digits == 0 {
    return None
  }
  Some(if neg { 0L - acc } else { acc })
}

///| Converts Chrome/WebKit timestamp (microseconds since 1601-01-01 UTC) to Unix seconds.
pub fn webkit_us_to_unix_secs(webkit_us : Int64) -> Int64 {
  if webkit_us <= 0L {
    return 0L
  }
  // 11644473600 seconds between 1601-01-01 and 1970-01-01
  let secs = webkit_us / 1000000L - 11644473600L
  if secs > 0L { secs } else { 0L }
}

///| Converts Firefox PRTime (microseconds since 1970-01-01 UTC) to Unix seconds.
pub fn prtime_us_to_unix_secs(prtime_us : Int64) -> Int64 {
  if prtime_us <= 0L {
    return 0L
  }
  prtime_us / 1000000L
}

///| Converts Apple/Safari CoreData timestamp (seconds since 2001-01-01 UTC) to Unix seconds.
pub fn coredata_secs_to_unix_secs(cd_secs : Int64) -> Int64 {
  if cd_secs <= 0L {
    return 0L
  }
  cd_secs + 978307200L
}

///| Security gate for imported URLs: allows only `http://`, `https://`, and safe `about:blank` URLs.
///| Strictly blocks `javascript:`, `data:`, `vbscript:`, `file:`, `chrome:`, control chars, and NUL bytes.
pub fn is_safe_import_url(raw : String) -> Bool {
  let u = raw.trim()
  if u == "" || u.length() > 4096 {
    return false
  }
  let mut i = 0
  while i < u.length() {
    let c = u.code_unit_at(i).to_int()
    if c < 0x20 || c == 0x7F {
      return false
    }
    i += 1
  }
  let low = mig_ascii_lower(u)
  if low.starts_with("https://") {
    return u.length() > 8
  }
  if low.starts_with("http://") {
    return u.length() > 7
  }
  false
}

///| Strips control characters and trims imported bookmark/history/folder titles.
pub fn sanitize_import_text(raw : String, max_len~ : Int = 256) -> String {
  let t = raw.trim()
  let sb = StringBuilder::new()
  let mut i = 0
  let mut n = 0
  while i < t.length() && n < max_len {
    let c = t.code_unit_at(i).to_int()
    if c >= 0x20 && c != 0x7F {
      sb.write_string(t.slice(i, i + 1))
      n += 1
    } else if c == 9 || c == 10 || c == 13 {
      sb.write_char(' ')
      n += 1
    }
    i += 1
  }
  sb.to_string().trim()
}
