///| Cross-platform installed browser profile discovery (macOS, Linux, Windows).
///| Pure callback-driven so tests run deterministically without touching the machine's real profiles.

import "proto"

struct BrowserBaseSpec {
  key : String
  label : String
  user_data_dir : String
  is_arc : Bool
  arc_root : String
}

fn chromium_profile_display_name(profile_dir : String, fallback : String, read_text : (String) -> Option[String]) -> String {
  match read_text(profile_dir + "/Preferences") {
    Some(raw) if raw != "" => match mjson_parse(raw) {
      Some(root) => match mj_get(root, "profile") {
        Some(p) => {
          let name = sanitize_import_text(mj_str(p, "name"), max_len=64)
          if name != "" { name } else { fallback }
        }
        None => fallback
      }
      None => fallback
    }
    _ => fallback
  }
}

fn discover_chromium_family(
  spec : BrowserBaseSpec,
  exists : (String) -> Bool,
  read_text : (String) -> Option[String],
  out : Array[proto::MigrateSourceInfo],
) -> Unit {
  let candidates = ["Default", "Profile 1", "Profile 2", "Profile 3", "Profile 4", "Profile 5"]
  let has_arc_sidebar = spec.is_arc && exists(spec.arc_root + "/StorableSidebar.json")
  for prof in candidates {
    let pdir = spec.user_data_dir + "/" + prof
    let has_bm = exists(pdir + "/Bookmarks")
    let has_hist = exists(pdir + "/History")
    let has_ext = exists(pdir + "/Extensions")
    let has_sp = has_arc_sidebar && prof == "Default"
    if has_bm || has_hist || has_ext || has_sp {
      let pname = chromium_profile_display_name(pdir, prof, read_text)
      let slug = mig_ascii_lower(prof).replace(" ", "-")
      out.push(proto::MigrateSourceInfo::{
        id: spec.key + ":" + slug,
        browser: spec.label,
        profile_name: pname,
        profile_path: pdir,
        has_bookmarks: has_bm || has_sp,
        has_history: has_hist,
        has_spaces: has_sp,
        has_extensions: has_ext,
      })
    }
  }
  // Arc-only fallback if StorableSidebar.json exists even when Chromium Default/ isn't populated
  if has_arc_sidebar {
    let mut found_arc = false
    for s in out {
      if s.id.starts_with(spec.key + ":") {
        found_arc = true
        break
      }
    }
    if !found_arc {
      out.push(proto::MigrateSourceInfo::{
        id: spec.key + ":sidebar",
        browser: spec.label,
        profile_name: "Default",
        profile_path: spec.arc_root,
        has_bookmarks: true,
        has_history: false,
        has_spaces: true,
        has_extensions: false,
      })
    }
  }
}

///| Discovers installed Chromium-family (Arc, Chrome, Canary, Brave, Edge, Vivaldi, Chromium, Opera),
///| Safari, and Firefox browser profiles across macOS, Linux, and Windows.
pub fn discover_browser_sources_with(
  home : String,
  local_appdata : String,
  appdata : String,
  os_kind : String,
  exists : (String) -> Bool,
  read_text : (String) -> Option[String],
) -> Array[proto::MigrateSourceInfo] {
  let out : Array[proto::MigrateSourceInfo] = []
  let os = mig_ascii_lower(os_kind)
  let specs : Array[BrowserBaseSpec] = []

  if os == "macos" || os == "darwin" {
    let app_sup = home + "/Library/Application Support"
    specs.push(BrowserBaseSpec::{ key: "arc", label: "Arc", user_data_dir: app_sup + "/Arc/User Data", is_arc: true, arc_root: app_sup + "/Arc" })
    specs.push(BrowserBaseSpec::{ key: "chrome", label: "Google Chrome", user_data_dir: app_sup + "/Google/Chrome", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "chrome-canary", label: "Chrome Canary", user_data_dir: app_sup + "/Google/Chrome Canary", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "brave", label: "Brave", user_data_dir: app_sup + "/BraveSoftware/Brave-Browser", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "edge", label: "Microsoft Edge", user_data_dir: app_sup + "/Microsoft Edge", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "vivaldi", label: "Vivaldi", user_data_dir: app_sup + "/Vivaldi", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "chromium", label: "Chromium", user_data_dir: app_sup + "/Chromium", is_arc: false, arc_root: "" })
  } else if os == "windows" || os == "win32" {
    let la = if local_appdata != "" { local_appdata } else { home + "/AppData/Local" }
    specs.push(BrowserBaseSpec::{ key: "arc", label: "Arc", user_data_dir: la + "/Packages/TheBrowserCompany.Arc/LocalCache/Local/Arc/User Data", is_arc: true, arc_root: la + "/Packages/TheBrowserCompany.Arc/LocalCache/Local/Arc" })
    specs.push(BrowserBaseSpec::{ key: "chrome", label: "Google Chrome", user_data_dir: la + "/Google/Chrome/User Data", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "edge", label: "Microsoft Edge", user_data_dir: la + "/Microsoft/Edge/User Data", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "brave", label: "Brave", user_data_dir: la + "/BraveSoftware/Brave-Browser/User Data", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "vivaldi", label: "Vivaldi", user_data_dir: la + "/Vivaldi/User Data", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "chromium", label: "Chromium", user_data_dir: la + "/Chromium/User Data", is_arc: false, arc_root: "" })
  } else {
    let cfg = home + "/.config"
    specs.push(BrowserBaseSpec::{ key: "chrome", label: "Google Chrome", user_data_dir: cfg + "/google-chrome", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "chromium", label: "Chromium", user_data_dir: cfg + "/chromium", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "brave", label: "Brave", user_data_dir: cfg + "/BraveSoftware/Brave-Browser", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "edge", label: "Microsoft Edge", user_data_dir: cfg + "/microsoft-edge", is_arc: false, arc_root: "" })
    specs.push(BrowserBaseSpec::{ key: "vivaldi", label: "Vivaldi", user_data_dir: cfg + "/vivaldi", is_arc: false, arc_root: "" })
  }

  for sp in specs {
    discover_chromium_family(sp, exists, read_text, out)
  }

  // Safari (macOS)
  if os == "macos" || os == "darwin" {
    let safari_dir = home + "/Library/Safari"
    let has_bm = exists(safari_dir + "/Bookmarks.plist")
    let has_hist = exists(safari_dir + "/History.db")
    if has_bm || has_hist {
      out.push(proto::MigrateSourceInfo::{
        id: "safari:default",
        browser: "Safari",
        profile_name: "Default",
        profile_path: safari_dir,
        has_bookmarks: has_bm,
        has_history: has_hist,
        has_spaces: false,
        has_extensions: false,
      })
    }
  }

  // Firefox (macOS / Linux / Windows)
  let ff_base = if os == "macos" || os == "darwin" {
    home + "/Library/Application Support/Firefox"
  } else if os == "windows" || os == "win32" {
    let ad = if appdata != "" { appdata } else { home + "/AppData/Roaming" }
    ad + "/Mozilla/Firefox"
  } else {
    home + "/.mozilla/firefox"
  }
  match read_text(ff_base + "/profiles.ini") {
    Some(ini) if ini != "" => {
      let profs = parse_firefox_profiles_ini(ini, ff_base)
      let mut idx = 0
      for p in profs {
        let (pname, pdir) = p
        let has_places = exists(pdir + "/places.sqlite")
        let has_html = exists(pdir + "/bookmarks.html")
        if has_places || has_html {
          out.push(proto::MigrateSourceInfo::{
            id: "firefox:p" + idx.to_string(),
            browser: "Firefox",
            profile_name: pname,
            profile_path: pdir,
            has_bookmarks: has_places || has_html,
            has_history: has_places,
            has_spaces: false,
            has_extensions: false,
          })
          idx += 1
        }
      }
    }
    _ => ()
  }

  out
}

///| Resolves the Arc `StorableSidebar.json` path adjacent to a discovered Arc profile path.
pub fn arc_sidebar_json_path(profile_path : String) -> String {
  if profile_path.ends_with("/User Data/Default") {
    profile_path.slice(0, profile_path.length() - 18) + "/StorableSidebar.json"
  } else if profile_path.contains("/User Data/") {
    match find_sub_from(profile_path, "/User Data/", 0) {
      Some(p) => profile_path.slice(0, p) + "/StorableSidebar.json"
      None => profile_path + "/StorableSidebar.json"
    }
  } else {
    profile_path + "/StorableSidebar.json"
  }
}
