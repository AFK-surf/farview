///| Pure-Pion Portable Multi-Profile & Arc Spaces Storage Partitioning.
///| Zero `extern "C"`, zero `World`, no module-level mutable state.

fn hex_digit_upper(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (55 + n).unsafe_to_char()
  }
}

fn pct_encode_byte(sb : StringBuilder, c : Int) -> Unit {
  sb.write_char('%')
  sb.write_char(hex_digit_upper((c >> 4) & 0xF))
  sb.write_char(hex_digit_upper(c & 0xF))
}

fn is_ascii_alnum(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

///| Injective component encoding for partition keys.
///| Leaves normal identifier chars `[A-Za-z0-9._-]` intact while escaping `%`, `:`,
///| `/`, `\`, `|`, whitespace, and control bytes so `"a::b" + "c"` never collides
///| with `"a" + "b::c"`.
fn encode_key_component(s : String) -> String {
  let b = s.to_bytes()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if is_ascii_alnum(c) || c == 45 || c == 46 || c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      pct_encode_byte(sb, c)
    }
    i = i + 1
  }
  sb.to_string()
}

///| Injective, path-traversal-safe encoding for filesystem directory segments.
///| Escapes `.` as `%2E` as well so `".."` and `"."` can never escape their root.
fn encode_path_component(s : String) -> String {
  let b = s.to_bytes()
  let sb = StringBuilder::new()
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if is_ascii_alnum(c) || c == 45 || c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      pct_encode_byte(sb, c)
    }
    i = i + 1
  }
  sb.to_string()
}

fn normalize_root_dir(root : String) -> String {
  let t = root.trim()
  if t == "" {
    return "."
  }
  let b = t.to_bytes()
  let mut end = b.length()
  while end > 1 && ((b[end - 1].to_int() & 0xFF) == 47 || (b[end - 1].to_int() & 0xFF) == 92) {
    end = end - 1
  }
  if end == b.length() {
    return t
  }
  let out = Bytes::new(end)
  let mut i = 0
  while i < end {
    out[i] = b[i]
    i = i + 1
  }
  out.to_string()
}

///| Default auto-archive window for Arc `Today` tabs (12 hours).
pub fn default_auto_archive_secs() -> Int64 {
  43200L
}

pub struct Profile {
  pub id : String
  pub name : String
  pub ephemeral : Bool
  pub root_dir : String
}

pub fn Profile::new(id : String, name : String, root_dir : String) -> Profile {
  Profile::{ id: id, name: name, ephemeral: false, root_dir: root_dir }
}

pub fn Profile::ephemeral(id : String, name : String) -> Profile {
  Profile::{ id: id, name: name, ephemeral: true, root_dir: "" }
}

pub fn Profile::eq(self : Profile, other : Profile) -> Bool {
  self.id == other.id &&
  self.name == other.name &&
  self.ephemeral == other.ephemeral &&
  self.root_dir == other.root_dir
}

pub struct Space {
  pub id : String
  pub profile_id : String
  pub name : String
  pub auto_archive_secs : Int64
}

pub fn Space::new(
  id : String,
  profile_id : String,
  name : String,
  auto_archive_secs : Int64,
) -> Space {
  Space::{
    id: id,
    profile_id: profile_id,
    name: name,
    auto_archive_secs: auto_archive_secs,
  }
}

pub fn Space::eq(self : Space, other : Space) -> Bool {
  self.id == other.id &&
  self.profile_id == other.profile_id &&
  self.name == other.name &&
  self.auto_archive_secs == other.auto_archive_secs
}

///| Deterministic storage isolation descriptor derived from `(Profile, Space)`.
///| Connects directly to `security::CookieJar` (`space_partition_key`),
///| `page_aux::HttpDiskCache` (`partition_key`), `page_aux::PermissionStore` (`partition_key`),
///| IndexedDB / localStorage / ServiceWorker Cache directories, and Safe Storage AAD.
pub struct StoragePartition {
  pub profile_id : String
  pub space_id : String
  pub ephemeral : Bool
  pub persist_to_disk : Bool
  pub partition_key : String
  pub cookie_partition_key : String
  pub http_cache_partition_key : String
  pub permission_partition_key : String
  pub idb_dir : String
  pub local_storage_dir : String
  pub sw_cache_dir : String
  pub safe_storage_aad : String
}

pub fn StoragePartition::eq(self : StoragePartition, other : StoragePartition) -> Bool {
  self.profile_id == other.profile_id &&
  self.space_id == other.space_id &&
  self.ephemeral == other.ephemeral &&
  self.persist_to_disk == other.persist_to_disk &&
  self.partition_key == other.partition_key &&
  self.cookie_partition_key == other.cookie_partition_key &&
  self.http_cache_partition_key == other.http_cache_partition_key &&
  self.permission_partition_key == other.permission_partition_key &&
  self.idb_dir == other.idb_dir &&
  self.local_storage_dir == other.local_storage_dir &&
  self.sw_cache_dir == other.sw_cache_dir &&
  self.safe_storage_aad == other.safe_storage_aad
}

///| Derives a deterministic, collision-free `StoragePartition` for `(profile, space)`.
///| Persistent profiles yield `"<profile_id>::<space_id>"` (with injective escaping) and
///| `persist_to_disk = true`. Ephemeral profiles yield `"ephemeral::<profile_id>::<space_id>"`,
///| `persist_to_disk = false`, and empty disk directory paths.
pub fn derive_storage_partition(
  profile : Profile,
  space : Space,
) -> Result[StoragePartition, String] {
  if profile.id == "" {
    return Err("browser_ctx: profile id must not be empty")
  }
  if space.id == "" {
    return Err("browser_ctx: space id must not be empty")
  }
  if space.profile_id != profile.id {
    return Err(
      "browser_ctx: space profile_id (" +
      space.profile_id +
      ") does not match profile id (" +
      profile.id +
      ")",
    )
  }
  let enc_pid = encode_key_component(profile.id)
  let enc_sid = encode_key_component(space.id)
  let partition_key = if profile.ephemeral {
    "ephemeral::" + enc_pid + "::" + enc_sid
  } else {
    enc_pid + "::" + enc_sid
  }
  let persist_to_disk = !profile.ephemeral
  let mut idb_dir = ""
  let mut local_storage_dir = ""
  let mut sw_cache_dir = ""
  if persist_to_disk {
    let base = normalize_root_dir(profile.root_dir) +
    "/profiles/" +
    encode_path_component(profile.id) +
    "/spaces/" +
    encode_path_component(space.id)
    idb_dir = base + "/indexeddb"
    local_storage_dir = base + "/local_storage"
    sw_cache_dir = base + "/sw_cache"
  }
  Ok(StoragePartition::{
    profile_id: profile.id,
    space_id: space.id,
    ephemeral: profile.ephemeral,
    persist_to_disk: persist_to_disk,
    partition_key: partition_key,
    cookie_partition_key: partition_key,
    http_cache_partition_key: "http_cache::" + partition_key,
    permission_partition_key: "perm::" + partition_key,
    idb_dir: idb_dir,
    local_storage_dir: local_storage_dir,
    sw_cache_dir: sw_cache_dir,
    safe_storage_aad: "farview-safe-storage-v1::" + partition_key,
  })
}

///| Builds a CHIPS-compatible composite cookie partition key scoped to both
///| this Space partition and the top-level schemeful site.
pub fn StoragePartition::chips_cookie_key(
  self : StoragePartition,
  top_level_site : String,
) -> String {
  self.cookie_partition_key + "|" + top_level_site
}
