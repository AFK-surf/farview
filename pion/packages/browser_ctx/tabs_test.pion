///| A tab dragged next to another in the sidebar keeps every other tab where it was.

fn tt_order(m : TabManager) -> String {
  let ids : Array[String] = []
  for t in m.all_tabs() {
    ids.push(t.id.to_string())
  }
  ids.join(",")
}

test "tabs: move_tab_next_to places the tab before or after its anchor" {
  let m = TabManager::new()
  let a = m.create_tab("p", "s", TabTier::Today, "https://a.test/", "A", 1L, false)
  let b = m.create_tab("p", "s", TabTier::Today, "https://b.test/", "B", 1L, false)
  let c = m.create_tab("p", "s", TabTier::Today, "https://c.test/", "C", 1L, false)
  debug_assert(tt_order(m) == "\{a.id},\{b.id},\{c.id}", "made in order")
  debug_assert(m.move_tab_next_to(c.id, a.id, false) is Ok(true), "moved")
  debug_assert(tt_order(m) == "\{c.id},\{a.id},\{b.id}", "C before A: \{tt_order(m)}")
  debug_assert(m.move_tab_next_to(c.id, b.id, true) is Ok(true), "moved")
  debug_assert(tt_order(m) == "\{a.id},\{b.id},\{c.id}", "C after B: \{tt_order(m)}")
  debug_assert(m.move_tab_next_to(a.id, a.id, true) is Ok(false), "onto itself: nothing")
  debug_assert(m.move_tab_next_to(a.id, 999L, true) is Ok(false), "no anchor: nothing")
  debug_assert(m.len() == 3, "no tab lost")
}
