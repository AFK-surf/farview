///| Pure-Pion Portable Arc Tab Lifecycle, Tiering & Navigation History Manager.
///| Zero `extern "C"`, zero `World`, no module-level mutable state.

pub enum TabLifecycleState {
  Active
  Background
  Frozen
  Discarded
}

pub fn TabLifecycleState::eq(
  self : TabLifecycleState,
  other : TabLifecycleState,
) -> Bool {
  match (self, other) {
    (TabLifecycleState::Active, TabLifecycleState::Active) => true
    (TabLifecycleState::Background, TabLifecycleState::Background) => true
    (TabLifecycleState::Frozen, TabLifecycleState::Frozen) => true
    (TabLifecycleState::Discarded, TabLifecycleState::Discarded) => true
    _ => false
  }
}

pub fn TabLifecycleState::to_token(self : TabLifecycleState) -> String {
  match self {
    TabLifecycleState::Active => "active"
    TabLifecycleState::Background => "background"
    TabLifecycleState::Frozen => "frozen"
    TabLifecycleState::Discarded => "discarded"
  }
}

pub fn TabLifecycleState::from_token(s : String) -> Option[TabLifecycleState] {
  if s == "active" {
    Some(TabLifecycleState::Active)
  } else if s == "background" {
    Some(TabLifecycleState::Background)
  } else if s == "frozen" {
    Some(TabLifecycleState::Frozen)
  } else if s == "discarded" {
    Some(TabLifecycleState::Discarded)
  } else {
    None
  }
}

///| Arc 3-tier tab hierarchy:
///| - `Favorite`: persistent top-grid essentials across a Profile
///| - `Pinned`: pinned space tabs exempt from auto-archive
///| - `Today`: ephemeral daily tabs subject to `auto_archive_secs`
pub enum TabTier {
  Favorite
  Pinned
  Today
}

pub fn TabTier::eq(self : TabTier, other : TabTier) -> Bool {
  match (self, other) {
    (TabTier::Favorite, TabTier::Favorite) => true
    (TabTier::Pinned, TabTier::Pinned) => true
    (TabTier::Today, TabTier::Today) => true
    _ => false
  }
}

pub fn TabTier::to_token(self : TabTier) -> String {
  match self {
    TabTier::Favorite => "favorite"
    TabTier::Pinned => "pinned"
    TabTier::Today => "today"
  }
}

pub fn TabTier::from_token(s : String) -> Option[TabTier] {
  if s == "favorite" {
    Some(TabTier::Favorite)
  } else if s == "pinned" {
    Some(TabTier::Pinned)
  } else if s == "today" {
    Some(TabTier::Today)
  } else {
    None
  }
}

pub struct NavEntry {
  pub url : String
  pub title : String
  pub mut scroll_x : Double
  pub mut scroll_y : Double
  pub timestamp_secs : Int64
}

pub struct Tab {
  pub id : Int64
  pub profile_id : String
  pub mut space_id : String
  pub mut tier : TabTier
  pub mut state : TabLifecycleState
  pub mut is_audible : Bool
  pub mut is_capturing_media : Bool
  pub mut has_unsaved_form : Bool
  pub mut archived : Bool
  pub mut archived_at_secs : Option[Int64]
  pub mut last_active_secs : Int64
  pub mut process_id : Option[Int64]
  pub mut site_instance_id : Option[Int64]
  pub mut history : Array[NavEntry]
  pub mut history_index : Int
}

pub fn Tab::current_entry(self : Tab) -> Option[NavEntry] {
  if self.history_index >= 0 && self.history_index < self.history.length() {
    Some(self.history[self.history_index])
  } else {
    None
  }
}

pub fn Tab::current_url(self : Tab) -> String {
  match self.current_entry() {
    Some(e) => e.url
    None => ""
  }
}

pub fn Tab::current_title(self : Tab) -> String {
  match self.current_entry() {
    Some(e) => e.title
    None => ""
  }
}

pub fn Tab::scroll_x(self : Tab) -> Double {
  match self.current_entry() {
    Some(e) => e.scroll_x
    None => 0.0
  }
}

pub fn Tab::scroll_y(self : Tab) -> Double {
  match self.current_entry() {
    Some(e) => e.scroll_y
    None => 0.0
  }
}

pub fn Tab::can_go_back(self : Tab) -> Bool {
  self.history_index > 0
}

pub fn Tab::can_go_forward(self : Tab) -> Bool {
  self.history_index >= 0 && self.history_index + 1 < self.history.length()
}

///| Returns `true` if this tab must NEVER be auto-frozen, auto-discarded,
///| or auto-archived (Active, playing audio like YouTube, capturing mic/cam/screen
///| like Google Meet, or holding an unsaved form).
pub fn Tab::is_protected(self : Tab) -> Bool {
  self.state.eq(TabLifecycleState::Active) ||
  self.is_audible ||
  self.is_capturing_media ||
  self.has_unsaved_form
}

pub fn Tab::can_freeze(self : Tab) -> Bool {
  !self.archived &&
  self.state.eq(TabLifecycleState::Background) &&
  !self.is_protected()
}

pub fn Tab::can_discard(self : Tab) -> Bool {
  !self.archived &&
  (self.state.eq(TabLifecycleState::Background) ||
    self.state.eq(TabLifecycleState::Frozen)) &&
  !self.is_protected()
}

///| Computes the process eviction protection priority for this tab:
///| Active > Audible > Capturing > UnsavedForm > Pinned/Favorite > Background.
pub fn Tab::priority(self : Tab) -> ProcessPriority {
  if self.state.eq(TabLifecycleState::Active) {
    ProcessPriority::Active
  } else if self.is_audible {
    ProcessPriority::Audible
  } else if self.is_capturing_media {
    ProcessPriority::Capturing
  } else if self.has_unsaved_form {
    ProcessPriority::UnsavedForm
  } else if self.tier.eq(TabTier::Favorite) || self.tier.eq(TabTier::Pinned) {
    ProcessPriority::Pinned
  } else {
    ProcessPriority::Background
  }
}

pub struct TabFolder {
  pub id : String
  pub space_id : String
  pub mut name : String
  pub mut collapsed : Bool
}

pub struct TabManager {
  mut next_tab_id : Int64
  tabs : Array[Tab]
  folders : Array[TabFolder]
  tab_folders : Map[Int64, String]
}

pub fn TabManager::new() -> TabManager {
  TabManager::{ next_tab_id: 1L, tabs: [], folders: [], tab_folders: Map::new() }
}

pub fn TabManager::len(self : TabManager) -> Int {
  self.tabs.length()
}

pub fn TabManager::all_tabs(self : TabManager) -> Array[Tab] {
  let out : Array[Tab] = []
  let mut i = 0
  while i < self.tabs.length() {
    out.push(self.tabs[i])
    i = i + 1
  }
  out
}

pub fn TabManager::insert_restored_tab(self : TabManager, tab : Tab) -> Unit {
  if tab.id >= self.next_tab_id {
    self.next_tab_id = tab.id + 1L
  }
  self.tabs.push(tab)
}

fn TabManager::find_index(self : TabManager, tab_id : Int64) -> Int {
  let mut i = 0
  while i < self.tabs.length() {
    if self.tabs[i].id == tab_id {
      return i
    }
    i = i + 1
  }
  -1
}

pub fn TabManager::get_tab(self : TabManager, tab_id : Int64) -> Option[Tab] {
  let idx = self.find_index(tab_id)
  if idx >= 0 {
    Some(self.tabs[idx])
  } else {
    None
  }
}

pub fn TabManager::priority_of(
  self : TabManager,
  tab_id : Int64,
) -> ProcessPriority {
  match self.get_tab(tab_id) {
    Some(t) => t.priority()
    None => ProcessPriority::Background
  }
}

pub fn TabManager::tabs_in_space(
  self : TabManager,
  space_id : String,
  include_archived : Bool,
) -> Array[Tab] {
  let out : Array[Tab] = []
  let mut i = 0
  while i < self.tabs.length() {
    let t = self.tabs[i]
    if t.space_id == space_id && (include_archived || !t.archived) {
      out.push(t)
    }
    i = i + 1
  }
  out
}

fn TabManager::deactivate_space_tabs(
  self : TabManager,
  space_id : String,
  except_tab_id : Int64,
  now_secs : Int64,
) -> Unit {
  let mut i = 0
  while i < self.tabs.length() {
    let t = self.tabs[i]
    if t.space_id == space_id &&
    t.id != except_tab_id &&
    t.state.eq(TabLifecycleState::Active) {
      t.state = TabLifecycleState::Background
      t.last_active_secs = now_secs
    }
    i = i + 1
  }
}

pub fn TabManager::create_tab(
  self : TabManager,
  profile_id : String,
  space_id : String,
  tier : TabTier,
  url : String,
  title : String,
  now_secs : Int64,
  activate : Bool,
) -> Tab {
  let id = self.next_tab_id
  self.next_tab_id = self.next_tab_id + 1L
  if activate {
    self.deactivate_space_tabs(space_id, id, now_secs)
  }
  let history : Array[NavEntry] = []
  let mut h_idx = -1
  if url != "" {
    history.push(NavEntry::{
      url: url,
      title: title,
      scroll_x: 0.0,
      scroll_y: 0.0,
      timestamp_secs: now_secs,
    })
    h_idx = 0
  }
  let tab = Tab::{
    id: id,
    profile_id: profile_id,
    space_id: space_id,
    tier: tier,
    state: if activate {
      TabLifecycleState::Active
    } else {
      TabLifecycleState::Background
    },
    is_audible: false,
    is_capturing_media: false,
    has_unsaved_form: false,
    archived: false,
    archived_at_secs: None,
    last_active_secs: now_secs,
    process_id: None,
    site_instance_id: None,
    history: history,
    history_index: h_idx,
  }
  self.tabs.push(tab)
  tab
}

///| Activates a tab (waking it from Background, Frozen, or Discarded while
///| preserving its URL, title, navigation stack, and scroll position).
pub fn TabManager::activate_tab(
  self : TabManager,
  tab_id : Int64,
  now_secs : Int64,
) -> Result[Tab, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let space_id = self.tabs[idx].space_id
  self.deactivate_space_tabs(space_id, tab_id, now_secs)
  let tab = self.tabs[idx]
  tab.archived = false
  tab.archived_at_secs = None
  tab.state = TabLifecycleState::Active
  tab.last_active_secs = now_secs
  Ok(tab)
}

///| Pushes a new navigation entry, truncating any forward history after `history_index`.
pub fn TabManager::navigate(
  self : TabManager,
  tab_id : Int64,
  url : String,
  title : String,
  now_secs : Int64,
) -> Result[NavEntry, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  while tab.history.length() > tab.history_index + 1 {
    let _ = tab.history.pop()
  }
  let entry = NavEntry::{
    url: url,
    title: title,
    scroll_x: 0.0,
    scroll_y: 0.0,
    timestamp_secs: now_secs,
  }
  tab.history.push(entry)
  tab.history_index = tab.history.length() - 1
  tab.last_active_secs = now_secs
  Ok(entry)
}

pub fn TabManager::go_back(
  self : TabManager,
  tab_id : Int64,
  now_secs : Int64,
) -> Result[Option[NavEntry], String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  if !tab.can_go_back() {
    return Ok(None)
  }
  tab.history_index = tab.history_index - 1
  tab.last_active_secs = now_secs
  Ok(Some(tab.history[tab.history_index]))
}

pub fn TabManager::go_forward(
  self : TabManager,
  tab_id : Int64,
  now_secs : Int64,
) -> Result[Option[NavEntry], String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  if !tab.can_go_forward() {
    return Ok(None)
  }
  tab.history_index = tab.history_index + 1
  tab.last_active_secs = now_secs
  Ok(Some(tab.history[tab.history_index]))
}

pub fn TabManager::update_scroll(
  self : TabManager,
  tab_id : Int64,
  scroll_x : Double,
  scroll_y : Double,
) -> Result[Unit, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  if tab.history_index < 0 || tab.history_index >= tab.history.length() {
    return Err("browser_ctx: tab has no active navigation entry")
  }
  tab.history[tab.history_index].scroll_x = scroll_x
  tab.history[tab.history_index].scroll_y = scroll_y
  Ok(())
}

pub fn TabManager::set_audible(
  self : TabManager,
  tab_id : Int64,
  audible : Bool,
) -> Result[Unit, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  self.tabs[idx].is_audible = audible
  Ok(())
}

pub fn TabManager::set_capturing_media(
  self : TabManager,
  tab_id : Int64,
  capturing : Bool,
) -> Result[Unit, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  self.tabs[idx].is_capturing_media = capturing
  Ok(())
}

pub fn TabManager::set_unsaved_form(
  self : TabManager,
  tab_id : Int64,
  unsaved : Bool,
) -> Result[Unit, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  self.tabs[idx].has_unsaved_form = unsaved
  Ok(())
}

pub fn TabManager::set_tier(
  self : TabManager,
  tab_id : Int64,
  tier : TabTier,
) -> Result[Unit, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  self.tabs[idx].tier = tier
  if !tier.eq(TabTier::Pinned) {
    let _ = self.tab_folders.remove(tab_id)
  }
  Ok(())
}

///| Freezes a background tab's timers. Returns `Ok(false)` if protected or ineligible.
pub fn TabManager::freeze_tab(
  self : TabManager,
  tab_id : Int64,
) -> Result[Bool, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  if !tab.can_freeze() {
    return Ok(false)
  }
  tab.state = TabLifecycleState::Frozen
  Ok(true)
}

///| Discards a background/frozen tab's renderer process while keeping its URL,
///| title, navigation history stack, and scroll offsets intact.
///| Returns `Ok(false)` if protected (Active, Audible, Capturing, UnsavedForm).
pub fn TabManager::discard_tab(
  self : TabManager,
  tab_id : Int64,
) -> Result[Bool, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  if !tab.can_discard() {
    return Ok(false)
  }
  tab.state = TabLifecycleState::Discarded
  tab.process_id = None
  tab.site_instance_id = None
  Ok(true)
}

///| Marks a tab as discarded after its renderer process was evicted by `ProcessPool`.
pub fn TabManager::mark_process_evicted(self : TabManager, tab_id : Int64) -> Unit {
  let idx = self.find_index(tab_id)
  if idx >= 0 {
    let tab = self.tabs[idx]
    tab.state = TabLifecycleState::Discarded
    tab.process_id = None
    tab.site_instance_id = None
  }
}

///| Sweeps a Space and auto-archives stale `Today` tabs whose idle duration
///| `now_secs - tab.last_active_secs >= auto_archive_secs`.
///| Never archives `Favorite`, `Pinned`, `Active`, `is_audible`, `is_capturing_media`,
///| or `has_unsaved_form` tabs.
pub fn TabManager::sweep_auto_archive(
  self : TabManager,
  space_id : String,
  auto_archive_secs : Int64,
  now_secs : Int64,
) -> Array[Int64] {
  let archived_ids : Array[Int64] = []
  if auto_archive_secs <= 0L {
    return archived_ids
  }
  let mut i = 0
  while i < self.tabs.length() {
    let tab = self.tabs[i]
    if tab.space_id == space_id &&
    !tab.archived &&
    tab.tier.eq(TabTier::Today) &&
    !tab.is_protected() &&
    now_secs - tab.last_active_secs >= auto_archive_secs {
      tab.archived = true
      tab.archived_at_secs = Some(now_secs)
      tab.state = TabLifecycleState::Discarded
      tab.process_id = None
      tab.site_instance_id = None
      archived_ids.push(tab.id)
    }
    i = i + 1
  }
  archived_ids
}

///| Restores an archived tab back into its Space with full navigation history and scroll state.
pub fn TabManager::restore_archived_tab(
  self : TabManager,
  tab_id : Int64,
  now_secs : Int64,
  activate : Bool,
) -> Result[Tab, String] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  let tab = self.tabs[idx]
  if !tab.archived {
    return Err("browser_ctx: tab is not archived: " + tab_id.to_string())
  }
  if activate {
    self.deactivate_space_tabs(tab.space_id, tab_id, now_secs)
  }
  tab.archived = false
  tab.archived_at_secs = None
  tab.last_active_secs = now_secs
  tab.state = if activate {
    TabLifecycleState::Active
  } else {
    TabLifecycleState::Background
  }
  Ok(tab)
}

pub fn TabManager::close_tab(self : TabManager, tab_id : Int64) -> Option[Tab] {
  let idx = self.find_index(tab_id)
  if idx < 0 {
    return None
  }
  let _ = self.tab_folders.remove(tab_id)
  let removed = self.tabs[idx]
  let mut j = idx
  while j + 1 < self.tabs.length() {
    self.tabs[j] = self.tabs[j + 1]
    j = j + 1
  }
  let _ = self.tabs.pop()
  Some(removed)
}

fn TabManager::find_folder_index(self : TabManager, folder_id : String) -> Int {
  let mut i = 0
  while i < self.folders.length() {
    if self.folders[i].id == folder_id {
      return i
    }
    i = i + 1
  }
  -1
}

pub fn TabManager::all_folders(self : TabManager) -> Array[TabFolder] {
  let out : Array[TabFolder] = []
  let mut i = 0
  while i < self.folders.length() {
    out.push(self.folders[i])
    i = i + 1
  }
  out
}

pub fn TabManager::all_tab_folders(self : TabManager) -> Map[Int64, String] {
  let out : Map[Int64, String] = Map::new()
  for tid in self.tab_folders.keys() {
    match self.tab_folders.get(tid) {
      Some(fid) if fid != "" => out.set(tid, fid)
      _ => ()
    }
  }
  out
}

pub fn TabManager::folders_in_space(
  self : TabManager,
  space_id : String,
) -> Array[TabFolder] {
  let out : Array[TabFolder] = []
  let mut i = 0
  while i < self.folders.length() {
    if self.folders[i].space_id == space_id {
      out.push(self.folders[i])
    }
    i = i + 1
  }
  out
}

pub fn TabManager::get_folder(
  self : TabManager,
  folder_id : String,
) -> Option[TabFolder] {
  let idx = self.find_folder_index(folder_id)
  if idx >= 0 {
    Some(self.folders[idx])
  } else {
    None
  }
}

pub fn TabManager::create_folder(
  self : TabManager,
  id : String,
  space_id : String,
  name : String,
  collapsed : Bool,
) -> Result[TabFolder, String] {
  if id == "" {
    return Err("browser_ctx: folder id must not be empty")
  }
  if space_id == "" {
    return Err("browser_ctx: folder space_id must not be empty")
  }
  if self.find_folder_index(id) >= 0 {
    return Err("browser_ctx: duplicate folder id: " + id)
  }
  let clean_name = if name.trim() != "" { name.trim() } else { "Folder" }
  let folder = TabFolder::{
    id: id,
    space_id: space_id,
    name: clean_name,
    collapsed: collapsed,
  }
  self.folders.push(folder)
  Ok(folder)
}

pub fn TabManager::rename_folder(
  self : TabManager,
  folder_id : String,
  new_name : String,
) -> Result[Unit, String] {
  let idx = self.find_folder_index(folder_id)
  if idx < 0 {
    return Err("browser_ctx: folder not found: " + folder_id)
  }
  let trimmed = new_name.trim()
  if trimmed == "" {
    return Err("browser_ctx: folder name must not be empty")
  }
  self.folders[idx].name = trimmed
  Ok(())
}

pub fn TabManager::set_folder_collapsed(
  self : TabManager,
  folder_id : String,
  collapsed : Bool,
) -> Result[Unit, String] {
  let idx = self.find_folder_index(folder_id)
  if idx < 0 {
    return Err("browser_ctx: folder not found: " + folder_id)
  }
  self.folders[idx].collapsed = collapsed
  Ok(())
}

pub fn TabManager::toggle_folder_collapsed(
  self : TabManager,
  folder_id : String,
) -> Result[Bool, String] {
  let idx = self.find_folder_index(folder_id)
  if idx < 0 {
    return Err("browser_ctx: folder not found: " + folder_id)
  }
  let next = !self.folders[idx].collapsed
  self.folders[idx].collapsed = next
  Ok(next)
}

///| Deletes a Pinned folder and safely returns all tabs inside it to top-level Pinned
///| (never deletes or drops any tabs). Returns the number of detached tabs.
pub fn TabManager::delete_folder(
  self : TabManager,
  folder_id : String,
) -> Result[Int, String] {
  let idx = self.find_folder_index(folder_id)
  if idx < 0 {
    return Err("browser_ctx: folder not found: " + folder_id)
  }
  let mut detached = 0
  let mut ti = 0
  while ti < self.tabs.length() {
    let tid = self.tabs[ti].id
    match self.tab_folders.get(tid) {
      Some(fid) if fid == folder_id => {
        let _ = self.tab_folders.remove(tid)
        detached = detached + 1
      }
      _ => ()
    }
    ti = ti + 1
  }
  let mut j = idx
  while j + 1 < self.folders.length() {
    self.folders[j] = self.folders[j + 1]
    j = j + 1
  }
  let _ = self.folders.pop()
  Ok(detached)
}

pub fn TabManager::tab_folder_id(self : TabManager, tab_id : Int64) -> String {
  match self.get_tab(tab_id) {
    Some(t) if t.tier.eq(TabTier::Pinned) =>
    match self.tab_folders.get(tab_id) {
      Some(fid) => if self.find_folder_index(fid) >= 0 { fid } else { "" }
      None => ""
    }
    _ => ""
  }
}

///| Places a tab into a Pinned folder (promoting it to `TabTier::Pinned`),
///| or removes it from any folder when `folder_id == ""` (keeping it top-level Pinned).
pub fn TabManager::set_tab_folder(
  self : TabManager,
  tab_id : Int64,
  folder_id : String,
) -> Result[Unit, String] {
  let tidx = self.find_index(tab_id)
  if tidx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  if folder_id == "" {
    let _ = self.tab_folders.remove(tab_id)
    return Ok(())
  }
  let fidx = self.find_folder_index(folder_id)
  if fidx < 0 {
    return Err("browser_ctx: folder not found: " + folder_id)
  }
  if self.folders[fidx].space_id != self.tabs[tidx].space_id {
    return Err("browser_ctx: folder belongs to a different space")
  }
  self.tabs[tidx].tier = TabTier::Pinned
  self.tab_folders.set(tab_id, folder_id)
  Ok(())
}

///| Moves a tab to `target_space_id`, clearing any Pinned folder binding from the
///| source Space to prevent cross-Space dangling folder references.
///| Returns `Ok(true)` if moved, `Ok(false)` if already in `target_space_id`.
pub fn TabManager::move_tab_to_space(
  self : TabManager,
  tab_id : Int64,
  target_space_id : String,
  now_secs : Int64,
) -> Result[Bool, String] {
  let tidx = self.find_index(tab_id)
  if tidx < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  if target_space_id == "" {
    return Err("browser_ctx: target space_id must not be empty")
  }
  let tab = self.tabs[tidx]
  if tab.space_id == target_space_id {
    return Ok(false)
  }
  let _ = self.tab_folders.remove(tab_id)
  tab.space_id = target_space_id
  tab.last_active_secs = now_secs
  if tab.state.eq(TabLifecycleState::Active) {
    tab.state = TabLifecycleState::Background
  }
  Ok(true)
}

///| Moves `tab_id` just before `before_id` in the tab order (what the sidebar draws, and the session keeps), or to
///| the end when `before_id` is 0 or not found. Returns `Ok(false)` when it already stands there.
pub fn TabManager::move_tab_before(self : TabManager, tab_id : Int64, before_id : Int64) -> Result[Bool, String] {
  let src = self.find_index(tab_id)
  if src < 0 {
    return Err("browser_ctx: tab not found: " + tab_id.to_string())
  }
  if before_id == tab_id {
    return Ok(false)
  }
  let tab = self.tabs[src]
  let rest : Array[Tab] = []
  let mut i = 0
  while i < self.tabs.length() {
    if i != src {
      rest.push(self.tabs[i])
    }
    i = i + 1
  }
  let mut at = rest.length()
  let mut j = 0
  while j < rest.length() {
    if before_id != 0L && rest[j].id == before_id {
      at = j
      break
    }
    j = j + 1
  }
  if at == src {
    return Ok(false)
  }
  self.tabs.clear()
  let mut k = 0
  while k < rest.length() {
    if k == at {
      self.tabs.push(tab)
    }
    self.tabs.push(rest[k])
    k = k + 1
  }
  if at == rest.length() {
    self.tabs.push(tab)
  }
  Ok(true)
}
