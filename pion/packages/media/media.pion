fn take_mb_bytes(p : Ptr) -> Bytes {
  let n = c_mb_len(p)
  let out = bytes_from_ptr(p, n)
  c_mb_free(p)
  out
}

pub fn register_dir(dir : String) -> Unit {
  c_register_dir(str_data_ptr(dir), dir.length())
}

pub fn cleanup_dir(dir : String) -> Unit {
  c_cleanup_dir(str_data_ptr(dir), dir.length())
}

pub fn unlink_file(path : String) -> Unit {
  c_unlink(str_data_ptr(path), path.length())
}

fn keep_bytes_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

pub fn append_file(path : String, data : Bytes) -> Bool {
  let b = if data.length() == 0 { Bytes::new(1) } else { data }
  let ok = c_append_file(str_data_ptr(path), path.length(), bytes_data_ptr(b), data.length()) != 0
  keep_bytes_alive(b)
  ok
}

pub fn probe(path : String) -> String {
  take_mb_bytes(c_probe(str_data_ptr(path), path.length())).to_string()
}

pub fn frame_jpeg(path : String, time_ms : Int, scale_w : Int) -> Bytes {
  take_mb_bytes(c_frame_jpeg(str_data_ptr(path), path.length(), time_ms, scale_w))
}

pub fn stream_open(path : String, start_ms : Int, scale_w : Int, fps : Int) -> Int {
  c_stream_open(str_data_ptr(path), path.length(), start_ms, scale_w, fps)
}

pub fn stream_read(handle : Int) -> Bytes {
  take_mb_bytes(c_stream_read(handle))
}

pub fn audio_open(path : String, start_ms : Int) -> Int {
  c_audio_open(str_data_ptr(path), path.length(), start_ms)
}

pub fn audio_read(handle : Int, max_bytes : Int) -> Bytes {
  take_mb_bytes(c_audio_read(handle, max_bytes))
}

pub fn inproc_available() -> Bool {
  c_inproc_available() != 0
}

pub fn probe_mem(data : Bytes) -> String {
  if data.length() == 0 {
    return ""
  }
  let res = take_mb_bytes(c_probe_mem(bytes_data_ptr(data), data.length())).to_string()
  keep_bytes_alive(data)
  res
}

pub fn frame_jpeg_mem(data : Bytes, time_ms : Int, scale_w : Int) -> Bytes {
  if data.length() == 0 {
    return Bytes::new(0)
  }
  let res = take_mb_bytes(c_frame_jpeg_mem(bytes_data_ptr(data), data.length(), time_ms, scale_w))
  keep_bytes_alive(data)
  res
}

pub fn mem_stream_append(handle : Int, data : Bytes) -> Bool {
  if data.length() == 0 {
    return false
  }
  let ok = c_mem_stream_append(handle, bytes_data_ptr(data), data.length()) != 0
  keep_bytes_alive(data)
  ok
}

pub fn mem_stream_probe(handle : Int) -> String {
  take_mb_bytes(c_mem_stream_probe(handle)).to_string()
}

pub fn stream_read_rgba(handle : Int) -> Bytes {
  take_mb_bytes(c_stream_read_rgba(handle))
}

pub fn stream_seek(handle : Int, target_ms : Int) -> Bool {
  c_stream_seek(handle, target_ms) != 0
}

pub fn mem_audio_append(handle : Int, data : Bytes) -> Bool {
  if data.length() == 0 {
