  ok
}

pub fn audio_seek(handle : Int, target_ms : Int) -> Bool {
  c_audio_seek(handle, target_ms) != 0
}

pub fn decode_audio(data : Bytes) -> Bytes {
  if data.length() == 0 {
    return Bytes::new(0)
  }
  let res = take_mb_bytes(c_decode_audio(bytes_data_ptr(data), data.length()))
  keep_bytes_alive(data)
  res
}

pub fn play_decoded_audio(fvad : Bytes, out_handle : Int) -> Int {
  if fvad.length() == 0 || out_handle <= 0 {
    return -1
  }
  let r = c_play_decoded_audio(bytes_data_ptr(fvad), fvad.length(), out_handle)
  keep_bytes_alive(fvad)
  r
}

pub fn audio_out_write(handle : Int, pcm : Bytes) -> Int {
  if pcm.length() == 0 {
    return 0
  }
  let r = c_audio_out_write(handle, bytes_data_ptr(pcm), pcm.length())
  keep_bytes_alive(pcm)
  r
}

pub fn audio_out_stats(handle : Int) -> String {
  let buf = Bytes::new(512)
  let n = c_audio_out_stats_string(handle, bytes_data_ptr(buf), 512)
  if n <= 0 {
    ""
  } else {
    buf.slice(0, n).to_string()
  }
}

pub fn media_b64_encode(src : Bytes) -> String {
  let n = src.length()
  if n == 0 {
    return ""
  }
  let tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".to_bytes()
  let out_len = ((n + 2) / 3) * 4
  let out = Bytes::new(out_len)
  let mut i = 0
  let mut o = 0
  while i < n {
    let b0 = src[i].to_int() & 0xFF
    let has1 = i + 1 < n
    let has2 = i + 2 < n
    let b1 = if has1 { src[i + 1].to_int() & 0xFF } else { 0 }
    let b2 = if has2 { src[i + 2].to_int() & 0xFF } else { 0 }
    let triple = (b0 << 16) | (b1 << 8) | b2
    out[o] = tbl[(triple >> 18) & 63]
    out[o + 1] = tbl[(triple >> 12) & 63]
    out[o + 2] = if has1 { tbl[(triple >> 6) & 63] } else { 61.to_byte() }
    out[o + 3] = if has2 { tbl[triple & 63] } else { 61.to_byte() }
    i = i + 3
    o = o + 4
  }
  out.to_string()
}

// --- WAV duration parser ---

fn media_fourcc(b : Bytes, off : Int) -> String {
  if off + 4 > b.length() {
    return ""
  }
  b.slice(off, off + 4).to_string()
}

fn media_u32_le(b : Bytes, off : Int) -> Int {
  (b[off].to_int() & 0xFF) | ((b[off + 1].to_int() & 0xFF) << 8) | ((b[off + 2].to_int() & 0xFF) << 16) | ((b[off + 3].to_int() & 0xFF) << 24)
}

pub fn parse_wav_duration(b : Bytes) -> Option[Double] {
  if b.length() < 44 {
    return Option::None
  }
  if media_fourcc(b, 0) != "RIFF" || media_fourcc(b, 8) != "WAVE" {
    return Option::None
  }
  let mut byte_rate = 0
  let mut data_size = 0
  let mut pos = 12
  while pos + 8 <= b.length() {
    let tag = media_fourcc(b, pos)
    let sz = media_u32_le(b, pos + 4)
    if sz < 0 || pos + 8 + sz > b.length() {
      break
    }
    if tag == "fmt " && sz >= 16 {
      byte_rate = media_u32_le(b, pos + 8 + 8)
    } else if tag == "data" {
      data_size = sz
    }
    pos = pos + 8 + sz + (sz & 1)
  }
  if byte_rate > 0 && data_size > 0 {
    Option::Some((data_size as Double) / (byte_rate as Double))
  } else {
    Option::None
  }
}

// --- Base64 decoder ---

fn b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

pub fn media_b64_decode(s : String) -> Bytes {
  let src = s.to_bytes()
  let n = src.length()
  let out : Array[Int] = []
  let mut acc = 0
  let mut bits = 0
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c == 61 {
      break
    }
    let v = b64_val(c)
    if v >= 0 {
      acc = (acc << 6) | v
      bits = bits + 6
      if bits >= 8 {
        bits = bits - 8
        out.push((acc >> bits) & 0xFF)
      }
    }
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j].to_byte()
    j = j + 1
  }
  res
}

// --- HLS Master & Media Playlist parsers ---

fn to_ascii_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

pub fn is_hls_playlist(u : String, data : Bytes) -> Bool {
  let q = u.index_of("?")
  let clean = if q >= 0 { u.slice(0, q) } else { u }
  if to_ascii_lower(clean).ends_with(".m3u8") {
    return true
  }
  let n = if data.length() < 64 { data.length() } else { 64 }
  if n < 7 {
    return false
  }
  let head = data.slice(0, n).to_string().trim()
  head.starts_with("#EXTM3U") || head.starts_with("\u{feff}#EXTM3U")
}

///| The highest-bandwidth `#EXT-X-STREAM-INF` variant of a Master Playlist, absolute; `None` for a
///| Media Playlist or a playlist `hls` rejects.
pub fn parse_hls_master(txt : String, base_url : String) -> Option[String] {
  match select_hls_variant_abr(txt, base_url, -1L, "") {
    Some(v) => Some(v.uri)
    None => None
  }
}

///| `(total seconds, absolute EXT-X-MAP of the first segment, [(seconds, absolute URI)])` for the first
///| `hls_max_segs` segments of a Media Playlist; empty for a Master Playlist or a playlist `hls` rejects.
pub fn parse_hls_media(txt : String, base_url : String) -> (Double, Option[String], Array[(Double, String)]) {
  let segs : Array[(Double, String)] = []
  match resolve_hls_timeline(txt, base_url, hls_max_segs) {
    Ok(tl) => {
      let mut i = 0
      while i < tl.segments.length() {
        segs.push((tl.segments[i].duration_s, tl.segments[i].uri))
        i = i + 1
      }
      (tl.total_duration_us.to_double() / 1000000.0, tl.init_map_uri, segs)
    }
    Err(_) => (0.0, None, segs)
  }
}

// --- MediaEntry & MediaManager (MSE dual-track + play/seek state machine + path traversal hardening) ---

pub struct MediaEntry {
  pub id : Int
  pub is_video : Bool
  pub mut url : String
  pub mut local_path : String
  pub mut video_path : String
  pub mut audio_path : String
  pub mut is_mse : Bool
  pub mut mse_tracks : Map[String, String]
  pub mut mse_total_bytes : Int
  pub mut mse_track_seq : Int
  pub mut duration : Double
  pub mut video_w : Int
  pub mut video_h : Int
  pub mut ready_state : Int
  pub mut playing : Bool
  pub mut want_play : Bool
  pub mut pending_seek : Double
  pub mut current_time : Double
  pub mut stream_handle : Int
  pub mut audio_handle : Int
}

pub fn MediaEntry::new(id : Int, is_video : Bool) -> MediaEntry {
  MediaEntry::{
    id: id,
    is_video: is_video,
    url: "",
    local_path: "",
    video_path: "",
    audio_path: "",
    is_mse: false,
    mse_tracks: Map::new(),
    mse_total_bytes: 0,
    mse_track_seq: 0,
    duration: -1.0,
    video_w: 0,
    video_h: 0,
    ready_state: 0,
    playing: false,
    want_play: false,
    pending_seek: -1.0,
    current_time: 0.0,
    stream_handle: -1,
    audio_handle: -1,
  }
}

pub fn MediaEntry::video_src(self : MediaEntry) -> String {
  if self.video_path != "" {
    self.video_path
  } else {
    self.local_path
  }
}

pub fn MediaEntry::audio_src(self : MediaEntry) -> String {
  if self.audio_path != "" {
    self.audio_path
  } else {
    self.local_path
  }
}

pub struct MediaManager {
  pub mut entries : Map[String, MediaEntry]
  pub mut tmp_dir : String
}

pub fn MediaManager::new() -> MediaManager {
  MediaManager::{ entries: Map::new(), tmp_dir: "" }
}

pub fn MediaManager::ensure_tmp_dir(self : MediaManager) -> String {
  if self.tmp_dir == "" {
    let dir = "/tmp/fv_pion_media_" + media_pid().to_string()
    c_mkdir(str_data_ptr(dir))
    register_dir(dir)
    self.tmp_dir = dir
  }
  self.tmp_dir
}

pub fn MediaManager::mse_init(self : MediaManager, id : Int, is_video : Bool) -> MediaEntry {
  let m = MediaEntry::new(id, is_video)
  m.is_mse = true
  self.entries.set(id.to_string(), m)
  m
}

pub fn MediaManager::mse_append(self : MediaManager, id : Int, track_id : String, mime : String, b64_data : String) -> Bool {
  match self.entries.get(id.to_string()) {
    Option::None => false
    Option::Some(m) => {
      let data = media_b64_decode(b64_data)
      if data.length() == 0 || m.mse_total_bytes + data.length() > mse_max_bytes {
        return false
      }
      let dir = self.ensure_tmp_dir()
      let path = match m.mse_tracks.get(track_id) {
        Option::Some(p) => p
        Option::None => {
          // Never embed raw track_id into path (prevents path traversal).
          let seq = m.mse_track_seq
          m.mse_track_seq = seq + 1
          let p = dir + "/mse_" + id.to_string() + "_t" + seq.to_string() + ".bin"
          m.mse_tracks.set(track_id, p)
          let lower = to_ascii_lower(mime)
          if lower.starts_with("audio/") {
            if m.audio_path == "" {
              m.audio_path = p
            }
          } else if m.video_path == "" {
            m.video_path = p
          }
          p
        }
      }
      if !append_file(path, data) {
        return false
      }
      m.mse_total_bytes = m.mse_total_bytes + data.length()
      true
    }
  }
}

pub fn MediaManager::finish_wav_load(self : MediaManager, id : Int, wav_bytes : Bytes) -> Bool {
  match self.entries.get(id.to_string()) {
    Option::None => false
    Option::Some(m) => match parse_wav_duration(wav_bytes) {
      Option::None => false
      Option::Some(dur) => {
        m.duration = dur
        m.ready_state = 4
        if m.pending_seek >= 0.0 {
          m.current_time = m.pending_seek
          m.pending_seek = -1.0
        }
        if m.want_play {
          m.playing = true
          m.want_play = false
        }
        true
      }
    }
  }
}

pub fn MediaManager::clear(self : MediaManager) -> Unit {
  let keys = self.entries.keys()
  let mut i = 0
  while i < keys.length() {
    match self.entries.get(keys[i]) {
      Option::Some(m) => {
        if m.stream_handle >= 0 {
          stream_close(m.stream_handle)
          m.stream_handle = -1
        }
        if m.audio_handle >= 0 {
          audio_close(m.audio_handle)
          m.audio_handle = -1
        }
      }
      Option::None => ()
    }
    i = i + 1
  }
  self.entries = Map::new()
  if self.tmp_dir != "" {
    cleanup_dir(self.tmp_dir)
    self.tmp_dir = ""
  }
}
