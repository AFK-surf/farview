///| Pure Pion zero-subprocess MSE container fast-path demuxer (`fv_mp4` + `fv_webm`).
///| Extracts tracks, RFC 6381 / MSE codec strings, duration, and keyframe timestamps
///| from fMP4 (`ftyp`/`moov`/`moof`/`mdat`) and WebM (`0x1A45DFA3`/Init/Cluster) in <0.2 ms.

import "fv_mp4"
import "fv_webm"

pub enum MseContainerKind {
  Fmp4
  Webm
  Unknown
}

pub struct MseTrackInfo {
  pub track_id : Int64
  pub kind : String
  pub codec : String
  pub width : Int
  pub height : Int
  pub sample_rate : Int
  pub channels : Int
  pub timescale : Int64
}

pub struct MseProbeInfo {
  pub container : MseContainerKind
  pub is_init : Bool
  pub is_media : Bool
  pub tracks : Array[MseTrackInfo]
  pub codecs : Array[String]
  pub duration_ms : Int64
  pub keyframe_pts_ms : Array[Int64]
}

pub enum MseInit {
  Mp4(fv_mp4::InitSegment)
  Webm(fv_webm::WebmInitSegment)
}

pub struct MseSegmentInfo {
  pub container : MseContainerKind
  pub start_pts_ms : Int64
  pub end_pts_ms : Int64
  pub sample_count : Int
  pub keyframe_pts_ms : Array[Int64]
}

fn mse_is_ebml_header(data : Bytes) -> Bool {
  data.length() >= 4 &&
  (data[0].to_int() & 0xFF) == 0x1A &&
  (data[1].to_int() & 0xFF) == 0x45 &&
  (data[2].to_int() & 0xFF) == 0xDF &&
  (data[3].to_int() & 0xFF) == 0xA3
}

fn mse_is_webm_cluster(data : Bytes) -> Bool {
  data.length() >= 4 &&
  (data[0].to_int() & 0xFF) == 0x1F &&
  (data[1].to_int() & 0xFF) == 0x43 &&
  (data[2].to_int() & 0xFF) == 0xB6 &&
  (data[3].to_int() & 0xFF) == 0x75
}

fn mse_is_bmff_box_fourcc(tag : String) -> Bool {
  tag == "ftyp" ||
  tag == "styp" ||
  tag == "sidx" ||
  tag == "moov" ||
  tag == "moof" ||
  tag == "mdat" ||
  tag == "free" ||
  tag == "skip" ||
  tag == "wide" ||
  tag == "emsg"
}

fn mse_is_fmp4(data : Bytes) -> Bool {
  if data.length() < 8 {
    return false
  }
  let tag = data.slice(4, 8).to_string()
  mse_is_bmff_box_fourcc(tag)
}

fn mp4_track_kind_str(k : fv_mp4::TrackKind) -> String {
  match k {
    fv_mp4::TrackKind::Video => "video"
    fv_mp4::TrackKind::Audio => "audio"
    fv_mp4::TrackKind::Subtitle => "subtitle"
    fv_mp4::TrackKind::Other(s) => s
  }
}

fn mp4_tracks_to_mse(tracks : Array[fv_mp4::Track]) -> (Array[MseTrackInfo], Array[String]) {
  let out : Array[MseTrackInfo] = []
  let codecs : Array[String] = []
  for t in tracks {
    let codec = fv_mp4::probe_codec_string(t)
    out.push(MseTrackInfo::{
      track_id: t.track_id.to_int64() & 0xFFFFFFFFL,
      kind: mp4_track_kind_str(t.kind),
      codec: codec,
      width: t.width,
      height: t.height,
      sample_rate: t.sample_rate,
      channels: t.channels,
      timescale: t.timescale.to_int64() & 0xFFFFFFFFL,
    })
    if codec != "" {
      codecs.push(codec)
    }
  }
  (out, codecs)
}

fn webm_track_kind_str(tt : Int) -> String {
  if tt == fv_webm::track_type_video {
    "video"
  } else if tt == fv_webm::track_type_audio {
    "audio"
  } else if tt == fv_webm::track_type_subtitle {
    "subtitle"
  } else {
    "other"
  }
}

fn webm_tracks_to_mse(tracks : Array[fv_webm::TrackEntry], ts_scale : Int64) -> (Array[MseTrackInfo], Array[String]) {
  let out : Array[MseTrackInfo] = []
  let codecs : Array[String] = []
  for t in tracks {
    let codec = fv_webm::probe_codec_string(t)
    let (w, h) = match t.video {
      Some(v) => (v.pixel_width.to_int(), v.pixel_height.to_int())
      None => (0, 0)
    }
    let (sr, ch) = match t.audio {
      Some(a) => (a.sampling_frequency.to_int(), a.channels.to_int())
      None => (0, 0)
    }
    out.push(MseTrackInfo::{
      track_id: t.track_number,
      kind: webm_track_kind_str(t.track_type),
      codec: codec,
      width: w,
      height: h,
      sample_rate: sr,
      channels: ch,
      timescale: ts_scale,
    })
    if codec != "" {
      codecs.push(codec)
    }
  }
  (out, codecs)
}

fn mp4_collect_fragment_keyframes(
  init : fv_mp4::InitSegment,
  seg : fv_mp4::MediaSegment,
) -> (Int, Array[Int64]) {
  let kfs : Array[Int64] = []
  let mut total_samples = 0
  for frag in seg.fragments {
    let mut ts = 0L
    for tr in init.tracks {
      if tr.track_id == frag.track_id {
        ts = tr.timescale.to_int64() & 0xFFFFFFFFL
        break
      }
    }
    for s in frag.samples {
      total_samples = total_samples + 1
      if s.is_sync && ts > 0L {
        kfs.push((s.pts * 1000L) / ts)
      }
    }
  }
  (total_samples, kfs)
}

///| Fast zero-subprocess container probe for MSE fMP4 (`ftyp`/`moov`/`moof`/`mdat`)
///| and WebM (`0x1A45DFA3`/Init/Cluster) byte streams.
pub fn probe_mse_container(data : Bytes) -> MseProbeInfo {
  if mse_is_ebml_header(data) {
    let limits = fv_webm::DecodeLimits::default()
    match fv_webm::parse_webm_with_limits(data, limits) {
      Ok(wf) => {
        let (tracks, codecs) = webm_tracks_to_mse(wf.tracks, wf.info.timestamp_scale)
        let kfs : Array[Int64] = []
        for fr in wf.frames {
          if fr.is_keyframe {
            kfs.push(fr.pts_ms)
          }
        }
        return MseProbeInfo::{
          container: MseContainerKind::Webm,
          is_init: tracks.length() > 0,
          is_media: wf.clusters.length() > 0,
          tracks: tracks,
          codecs: codecs,
          duration_ms: wf.info.duration_ms,
          keyframe_pts_ms: kfs,
        }
      }
      Err(_) => match fv_webm::parse_init_segment(data, limits) {
        Ok(init) => {
          let (tracks, codecs) = webm_tracks_to_mse(init.tracks, init.info.timestamp_scale)
          return MseProbeInfo::{
            container: MseContainerKind::Webm,
            is_init: true,
            is_media: false,
            tracks: tracks,
            codecs: codecs,
            duration_ms: init.info.duration_ms,
            keyframe_pts_ms: [],
          }
        }
        Err(_) => ()
      }
    }
  }
  if mse_is_webm_cluster(data) {
    return MseProbeInfo::{
      container: MseContainerKind::Webm,
      is_init: false,
      is_media: true,
      tracks: [],
      codecs: [],
      duration_ms: 0L,
      keyframe_pts_ms: [],
    }
  }
  if mse_is_fmp4(data) {
    let limits = fv_mp4::DecodeLimits::default()
    match fv_mp4::parse_init_segment(data, limits) {
      Ok(init) => {
        let (tracks, codecs) = mp4_tracks_to_mse(init.tracks)
        let mvhd_ts = init.mvhd.timescale.to_int64() & 0xFFFFFFFFL
        let dur_ms = if mvhd_ts > 0L && init.mvhd.duration > 0L {
          (init.mvhd.duration * 1000L) / mvhd_ts
        } else {
          0L
        }
        let mut is_media = false
        let mut kfs : Array[Int64] = []
        match fv_mp4::parse_media_segment(init, data, limits) {
          Ok(seg) => if seg.fragments.length() > 0 {
            is_media = true
            let (_, seg_kfs) = mp4_collect_fragment_keyframes(init, seg)
            kfs = seg_kfs
          }
          Err(_) => ()
        }
        if !is_media {
          for tr in init.tracks {
            let ts = tr.timescale.to_int64() & 0xFFFFFFFFL
            if ts > 0L {
              for s in tr.samples {
                if s.is_sync {
                  kfs.push((s.pts * 1000L) / ts)
                }
              }
            }
          }
        }
        return MseProbeInfo::{
          container: MseContainerKind::Fmp4,
          is_init: true,
          is_media: is_media,
          tracks: tracks,
          codecs: codecs,
          duration_ms: dur_ms,
          keyframe_pts_ms: kfs,
        }
      }
      Err(_) => {
        let tag = data.slice(4, 8).to_string()
        if tag == "styp" || tag == "sidx" || tag == "moof" || tag == "mdat" {
          return MseProbeInfo::{
            container: MseContainerKind::Fmp4,
            is_init: false,
            is_media: true,
            tracks: [],
            codecs: [],
            duration_ms: 0L,
            keyframe_pts_ms: [],
          }
        }
      }
    }
  }
  MseProbeInfo::{
    container: MseContainerKind::Unknown,
    is_init: false,
    is_media: false,
    tracks: [],
    codecs: [],
    duration_ms: 0L,
    keyframe_pts_ms: [],
  }
}

///| Parse an MSE initialization segment (fMP4 `ftyp`+`moov` or WebM EBML+Info+Tracks).
pub fn parse_mse_init(data : Bytes) -> Result[MseInit, String] {
  if mse_is_ebml_header(data) {
    match fv_webm::parse_init_segment(data, fv_webm::DecodeLimits::default()) {
      Ok(init) => Ok(MseInit::Webm(init))
      Err(e) => Err(fv_webm::webm_error_message(e))
    }
  } else if mse_is_fmp4(data) {
    match fv_mp4::parse_init_segment(data, fv_mp4::DecodeLimits::default()) {
      Ok(init) => Ok(MseInit::Mp4(init))
      Err(e) => Err(fv_mp4::mp4_error_message(e))
    }
  } else {
    Err("unrecognized MSE initialization segment container")
  }
}

///| Parse an MSE media segment (`moof`+`mdat` or WebM `Cluster`) against a parsed `MseInit`.
pub fn parse_mse_segment(init : MseInit, data : Bytes) -> Result[MseSegmentInfo, String] {
  match init {
    MseInit::Mp4(mp4_init) => match fv_mp4::parse_media_segment(mp4_init, data, fv_mp4::DecodeLimits::default()) {
      Ok(seg) => {
        let (sample_count, kfs) = mp4_collect_fragment_keyframes(mp4_init, seg)
        Ok(MseSegmentInfo::{
          container: MseContainerKind::Fmp4,
          start_pts_ms: seg.start_pts_ms,
          end_pts_ms: seg.end_pts_ms,
          sample_count: sample_count,
          keyframe_pts_ms: kfs,
        })
      }
      Err(e) => Err(fv_mp4::mp4_error_message(e))
    }
    MseInit::Webm(webm_init) => match fv_webm::parse_media_segment(webm_init, data, fv_webm::DecodeLimits::default()) {
      Ok(seg) => {
        let kfs : Array[Int64] = []
        for fr in seg.frames {
          if fr.is_keyframe {
            kfs.push(fr.pts_ms)
          }
        }
        Ok(MseSegmentInfo::{
          container: MseContainerKind::Webm,
          start_pts_ms: seg.start_pts_ms,
          end_pts_ms: seg.end_pts_ms,
          sample_count: seg.frames.length(),
          keyframe_pts_ms: kfs,
        })
      }
      Err(e) => Err(fv_webm::webm_error_message(e))
    }
  }
}

///| Extract normalized track descriptors from a parsed `MseInit`.
pub fn MseInit::tracks(self : MseInit) -> Array[MseTrackInfo] {
  match self {
    MseInit::Mp4(init) => mp4_tracks_to_mse(init.tracks).0
    MseInit::Webm(init) => webm_tracks_to_mse(init.tracks, init.info.timestamp_scale).0
  }
}

///| Extract RFC 6381 / MSE codec strings from a parsed `MseInit`.
pub fn MseInit::codecs(self : MseInit) -> Array[String] {
  match self {
    MseInit::Mp4(init) => mp4_tracks_to_mse(init.tracks).1
    MseInit::Webm(init) => webm_tracks_to_mse(init.tracks, init.info.timestamp_scale).1
  }
}
