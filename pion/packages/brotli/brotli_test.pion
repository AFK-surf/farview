fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

fn from_hex(s : String) -> Bytes {
  let n = s.length() / 2
  let b = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(s.code_unit_at(i * 2))
    let lo = hex_nibble(s.code_unit_at(i * 2 + 1))
    b[i] = (hi * 16 + lo).to_byte()
    i = i + 1
  }
  b
}

test "decode empty brotli stream" {
  // RFC 7932 empty stream: 0x06 (or 0x3b)
  let empty = from_hex("06")
  match decode(empty) {
    Ok(out) => debug_assert(out.length() == 0, "empty output")
    Err(e) => debug_assert(false, e)
  }
}

test "decode hello world and dictionary transforms" {
  // Standard brotli compressed "hello world\n"
  let br_hello = from_hex("8b058068656c6c6f20776f726c640a03")
  match decode(br_hello) {
    Ok(out) => debug_assert(out.to_string() == "hello world\n", "hello world")
    Err(e) => debug_assert(false, e)
  }
  // Verify tables integrity
  debug_assert(TRANSFORMS.length() == 121, "121 transforms")
  let dict = decode_base64(DICTIONARY_B64)
  debug_assert(dict.length() == 122784, "dictionary 122784 bytes")
  let lut = decode_base64(CONTEXT_LUT_B64)
  debug_assert(lut.length() == 2048, "context lut 2048 bytes")
}
