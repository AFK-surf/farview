///| Farview Shell 3 — DevTools (Elements, Console, Network), docked or floating.
///|
///| - Docked: a second solid card under the page card, separated by the frame gap. The gap itself is the
///|   resize handle (a grabber shows while it is hovered or dragged). Zero glass.
///| - Floating: one layer of `lg` glass (`liquid_dialog_shell_node`) around the same solid content.
///| Both share one `DevToolsPanelState`, so the selected node, collapsed tree, Console filter and draft, and
///| Network filter, query and selection survive a switch.
///|
///| Layout: one 40pt toolbar (segmented tab control, the inspected page, icon buttons), then the tab body.
///| Code is monospace; everything else is the system face on the type scale. Colors come from
///| `lg::surface()` semantic tokens (accent, positive, warning, danger) and the shell tile palette.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "text"
import "ui"
import "view"

pub let DEVTOOLS_TAB_ELEMENTS : Int = 0
pub let DEVTOOLS_TAB_CONSOLE : Int = 1
pub let DEVTOOLS_TAB_NETWORK : Int = 2

// Package-level lets initialize in file order, so these are literals (tokens in the comments).
let dt_disclosure_w : Double = 16.0 // SP_16
let dt_indent_step : Double = 16.0 // SP_16
let dt_row_h : Double = 32.0 // SP_32 (a 32pt hit target per row, DESIGN.md §2)
let dt_net_row_h : Double = 32.0 // SP_32
let dt_line_h : Double = 16.0 // SP_16
let dt_inspector_w : Double = 288.0 // SP_160 + SP_128
let dt_fallback_w : Double = 1280.0 // SP_160 * 8
let dt_fallback_h : Double = 800.0 // SP_160 * 5

#derive(Eq)
pub enum DevToolsPresentation {
  Docked
  Floating
}

///| Shared reactive state preserved across Docked <-> Floating switches.
pub struct DevToolsPanelState {
  pub presentation : signals::Signal[DevToolsPresentation]
  pub tab : signals::Signal[Int]
  pub height : signals::Signal[Double]
  pub dragging : signals::Signal[Bool]
  pub selected_path : signals::Signal[String]
  pub collapsed_paths : Map[String, Bool]
  pub collapse_rev : signals::Signal[Int]
  pub console_filter : signals::Signal[Int]
  pub repl_field : ui::Field
  pub net_filter : signals::Signal[String]
  pub net_query : signals::Signal[String]
  pub net_search_field : ui::Field
  pub net_selected_idx : signals::Signal[Int]
}

pub fn DevToolsPanelState::new(
  repl_field? : ui::Field,
  net_search_field? : ui::Field,
  presentation~ : DevToolsPresentation = DevToolsPresentation::Docked,
) -> DevToolsPanelState {
  DevToolsPanelState::{
    presentation: signals::signal(presentation),
    tab: signals::signal(DEVTOOLS_TAB_ELEMENTS),
    height: signals::signal(proto::DEVTOOLS_HEIGHT_DEFAULT),
    dragging: signals::signal(false),
    selected_path: signals::signal(""),
    collapsed_paths: Map::new(),
    collapse_rev: signals::signal(0),
    console_filter: signals::signal(0),
    repl_field: match repl_field {
      Some(f) => f
      None => ui::Field::new()
    },
    net_filter: signals::signal("all"),
    net_query: signals::signal(""),
    net_search_field: match net_search_field {
      Some(f) => f
      None => ui::Field::new()
    },
    net_selected_idx: signals::signal(-1),
  }
}

///| Strongly typed props for `build_devtools_panel`.
pub struct DevToolsPanelProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub owner_pane : () -> PaneId
  pub snapshot : () -> proto::DevToolsSnapshot
  pub rev : () -> Int
  pub state : DevToolsPanelState
  pub on_inspect : (String) -> Unit
  pub on_eval : (String) -> Unit
  pub on_clear_console : () -> Unit
  pub on_copy_curl : (String) -> Unit
  pub on_refresh : () -> Unit
  pub on_close : () -> Unit
  pub on_presentation_change : Option[(DevToolsPresentation) -> Unit]
  pub anchor_top : () -> Double
}

// ---------------------------------------------------------------------------------------------------------
// Color tokens (all derived from `lg::surface()` and the shell tile palette).

///| Blue for code values (attribute values, numbers): the accent, deepened in light mode to read as text.
fn dt_code_blue() -> Int64 {
  let s = lg::surface()
  if lg::is_dark() { shell_mix(s.accent, 0xFFFFFFFFL, 0.30) } else { shell_mix(s.accent, 0x000000FFL, 0.30) }
}

///| Purple for tag names and keywords (`true`, `null`): the system purple tile color, readable as text.
fn dt_code_purple() -> Int64 {
  if lg::is_dark() { shell_mix(0xAF52DEFFL, 0xFFFFFFFFL, 0.35) } else { shell_mix(0xAF52DEFFL, 0x000000FFL, 0.25) }
}

///| Solid tint of `color` over the card (box model layers).
fn dt_card_tint(color : Int64, share : Double) -> Int64 {
  shell_mix(lg::surface().card, color | 0xFFL, share)
}

///| Ground of the side inspector panes (a step back from the card, like a grouped list background).
fn dt_pane_bg() -> Int64 {
  lg::surface().sidebar
}

///| Key bit for rebuilding colored lists on an appearance change. Keys on `lg::is_dark()` (what the colors read),
///| so a list never rebuilds between the app's flag flipping and the palette following it.
fn dt_dark_bit(props : DevToolsPanelProps) -> Int {
  let _ = (props.dark)()
  if lg::is_dark() { 1 } else { 0 }
}

// ---------------------------------------------------------------------------------------------------------
// Pure helpers.

fn dt_pane_label(pane : PaneId) -> String {
  match pane {
    PaneId::Primary => "Left pane"
    PaneId::Secondary => "Right pane"
  }
}

fn dt_is_hidden_by_collapse(collapsed : Map[String, Bool], path : String) -> Bool {
  let mut i = 0
  while i < path.length() {
    if path.code_unit_at(i).to_int() == 0x2E {
      let anc = path.slice(0, i)
      if collapsed.get(anc).unwrap_or(false) {
        return true
      }
    }
    i += 1
  }
  false
}

fn dt_clip(s : String, n : Int) -> String {
  if s.length() > n { s.slice(0, n) + "\u{2026}" } else { s }
}

fn dt_mono_run(s : String, color : Int64, weight~ : Int = 400) -> text::Run {
  text::Run::{ ..text::plain(s), mono: true, color, weight }
}

fn dt_dom_summary(nd : proto::DevToolsDomNode, collapsed : Bool) -> String {
  let mut s = "<" + nd.tag
  if nd.id_attr != "" {
    s = s + " id=\"" + nd.id_attr + "\""
  }
  if nd.class_attr != "" {
    s = s + " class=\"" + dt_clip(nd.class_attr, 28) + "\""
  }
  let mut ai = 0
  while ai < nd.attrs.length() && ai < 2 {
    let at = nd.attrs[ai]
    s = s + " " + at.name + "=\"" + dt_clip(at.value, 28) + "\""
    ai += 1
  }
  s = s + ">"
  if nd.text_preview != "" {
    s = s + dt_clip(nd.text_preview, 36)
  }
  if nd.child_count == 0 {
    s = s + "</" + nd.tag + ">"
  } else if collapsed {
    s = s + "\u{2026}</" + nd.tag + ">"
  }
  s
}

fn dt_dom_node_runs(nd : proto::DevToolsDomNode, collapsed : Bool) -> Array[text::Run] {
  let s = lg::surface()
  let runs : Array[text::Run] = []
  let c_punct = s.ink_secondary
  let c_tag = dt_code_purple()
  let c_attr = s.warning
  let c_val = dt_code_blue()
  runs.push(dt_mono_run("<", c_punct))
  runs.push(dt_mono_run(nd.tag, c_tag))
  if nd.id_attr != "" {
    runs.push(dt_mono_run(" id", c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + nd.id_attr + "\"", c_val))
  }
  if nd.class_attr != "" {
    runs.push(dt_mono_run(" class", c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + dt_clip(nd.class_attr, 28) + "\"", c_val))
  }
  let mut ai = 0
  while ai < nd.attrs.length() && ai < 2 {
    let at = nd.attrs[ai]
    runs.push(dt_mono_run(" " + at.name, c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + dt_clip(at.value, 28) + "\"", c_val))
    ai += 1
  }
  runs.push(dt_mono_run(">", c_punct))
  if nd.text_preview != "" {
    runs.push(dt_mono_run(dt_clip(nd.text_preview, 36), s.ink))
  }
  if nd.child_count == 0 {
    runs.push(dt_mono_run("</", c_punct))
    runs.push(dt_mono_run(nd.tag, c_tag))
    runs.push(dt_mono_run(">", c_punct))
  } else if collapsed {
    runs.push(dt_mono_run("\u{2026}", s.ink_secondary))
    runs.push(dt_mono_run("</", c_punct))
    runs.push(dt_mono_run(nd.tag, c_tag))
    runs.push(dt_mono_run(">", c_punct))
  }
  runs
}

///| Selector-style label for a node: `main#app.shell-root`.
fn dt_node_selector(nd : proto::DevToolsDomNode) -> String {
  let mut s = nd.tag
  if nd.id_attr != "" {
    s = s + "#" + nd.id_attr
  }
  if nd.class_attr != "" {
    let cls = nd.class_attr.trim()
    let mut end = 0
    while end < cls.length() && cls.code_unit_at(end).to_int() != 0x20 {
      end += 1
    }
    let first = cls.slice(0, end)
    if first != "" {
      s = s + "." + first
    }
  }
  s
}

fn dt_console_result_color_for(ce : proto::DevToolsConsoleEntry, dark : Bool) -> Int64 {
  let ink = lg::surface().ink
  if ce.level != "result" {
    return ink
  }
  let src = ce.source.trim()
  if src == "string" {
    shell_positive_text()
  } else if src == "number" {
    dt_code_blue()
  } else if src == "boolean" {
    dt_code_purple()
  } else if src == "undefined" || src == "null" {
    lg::surface().ink_secondary
  } else if src == "" {
    dt_console_result_color(ce.text, dark)
  } else {
    ink
  }
}

///| Typed color of a REPL result by its printed form: strings green, numbers blue, keywords purple.
fn dt_console_result_color(txt : String, dark : Bool) -> Int64 {
  let _ = dark
  let ink = lg::surface().ink
  let s = txt.trim()
  if s == "" {
    return ink
  }
  if (s.starts_with("\"") && s.ends_with("\"")) || (s.starts_with("'") && s.ends_with("'")) {
    shell_positive_text()
  } else if s == "true" || s == "false" || s == "null" || s == "undefined" || s == "NaN" {
    dt_code_purple()
  } else {
    let c0 = s.code_unit_at(0).to_int()
    let digit_at = fn(i : Int) -> Bool {
      let c = s.code_unit_at(i).to_int()
      c >= 48 && c <= 57
    }
    if (c0 >= 48 && c0 <= 57) || (c0 == 45 && s.length() > 1 && digit_at(1)) {
      dt_code_blue()
    } else {
      ink
    }
  }
}

fn dt_console_matches(filter : Int, level : String) -> Bool {
  if filter == 0 {
    true
  } else if filter == 1 {
    level == "log" || level == "info" || level == "input" || level == "result"
  } else if filter == 2 {
    level == "warn"
  } else {
    level == "error"
  }
}

///| A request category's glyph (its tile is monochrome) and the color of its waterfall bar (a legend for the timing
///| chart, where color tells the request types apart).
fn dt_net_tile(kind : String, url : String) -> (String, Int64) {
  let cat = proto::devtools_net_category(kind, url)
  if cat == "doc" {
    ("file-text", 0x007AFFFFL)
  } else if cat == "js" {
    ("file-code", 0xFF9500FFL)
  } else if cat == "css" {
    ("palette", 0xAF52DEFFL)
  } else if cat == "img" {
    ("image", 0x34C759FFL)
  } else if cat == "fetch" {
    ("server", 0x30B0C7FFL)
  } else {
    ("file", 0x8E8E93FFL)
  }
}

///| Plain-word type of a request (`document`, `script`, `stylesheet`, `image`, `fetch`).
fn dt_net_type_word(kind : String, url : String) -> String {
  let cat = proto::devtools_net_category(kind, url)
  if cat == "doc" {
    "document"
  } else if cat == "js" {
    "script"
  } else if cat == "css" {
    "stylesheet"
  } else if cat == "img" {
    "image"
  } else if cat == "fetch" {
    "fetch"
  } else if kind != "" {
    kind
  } else {
    "other"
  }
}

fn dt_status_ink(status : Int) -> Int64 {
  if status >= 400 || status <= 0 {
    lg::surface().danger
  } else if status >= 300 {
    // Redirects and 304 Not Modified are healthy: quieter ink, never a warning color.
    lg::surface().ink_secondary
  } else {
    lg::surface().ink
  }
}

fn dt_net_footer(shown : Array[proto::DevToolsNetworkEntry], total : Int) -> String {
  let mut bytes = 0
  for ne in shown {
    if ne.size_bytes > 0 {
      bytes = bytes + ne.size_bytes
    }
  }
  let n = shown.length()
  let word = if total == 1 { "request" } else { "requests" }
  let count = if n == total { n.to_string() + " " + word } else { n.to_string() + " of " + total.to_string() + " " + word }
  count + ", " + proto::format_devtools_bytes(bytes)
}

fn dt_bm_value(v : Double) -> String {
  if v == 0.0 { "–" } else { proto::format_devtools_px(v) }
}

// ---------------------------------------------------------------------------------------------------------
// Small views.

///| Monospace text (one run). `wrap` lets long values break; otherwise it truncates with an ellipsis.
fn dt_mono(
  parent : view::View,
  text_by : () -> String,
  color_by : () -> Int64,
  size~ : Double = TX_FOOTNOTE,
  weight~ : Int = 400,
  wrap~ : Bool = false,
  grow~ : Bool = false,
) -> view::View {
  parent.box(fn(mv : view::View) -> Unit {
    if grow {
      let _ = mv.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
    }
    if !wrap {
      let _ = mv.cut().allow_ellipsis(view::Live::Is(true))
    }
    let _ = mv.words_runs(
      view::Live::By(fn() { [dt_mono_run(text_by(), color_by(), weight=weight)] }),
      ink=signals::untracked(color_by),
      look=view::WordsLook::{ ..view::words_plain, size, line: dt_line_h, wrap },
    )
  })
}

///| DevTools' icon button: the shell's one panel icon button (`shell_panel_icon_btn`) with a live glyph.
fn dt_icon_btn(
  parent : view::View,
  label : () -> String,
  icon_by : () -> String,
  on_press : () -> Unit,
  ink_by? : () -> Int64,
) -> view::View {
  shell_panel_icon_btn(parent, label, "", on_press, icon_by=icon_by, ink_by?=ink_by)
}

///| Segmented control with fixed text weight (selection never changes weight). `names` are shown;
///| each segment is announced as `a11y_prefix + name`.
fn dt_segmented(
  parent : view::View,
  said : String,
  names : Array[String],
  a11y_prefix : String,
  selected : () -> Int,
  on_select : (Int) -> Unit,
) -> Unit {
  let widths : Array[Double] = []
  let labels : Array[String] = []
  let mut total = SP_2 * 2.0
  for n in names {
    let tw = ui::measure_text_width(n, TX_FOOTNOTE, weight=500).ceil() + SP_24
    let w = if tw < SP_48 { SP_48 } else { tw }
    widths.push(w)
    labels.push(a11y_prefix + n)
    total = total + w
  }
  let seg = lg::liquid_segmented_node(
    parent,
    fn() { labels },
    selected,
    on_select,
    width=total,
    height=SP_32,
    pad=SP_2,
    widths=fn() { widths },
    said=said,
    flat=true,
    render_item=fn(item : view::View, idx : Int, chosen : () -> Bool) -> Unit {
      let lit = shell_fade(item, chosen)
      <ui::Text
        in={item}
        size={TX_FOOTNOTE}
        weight={500}
        color_by=>{shell_mix(lg::surface().ink_secondary, lg::surface().ink, lit())}
        text={names[idx]}
      />
    },
  )
  let _ = seg.shrink(view::Live::Is(0.0))
}

///| A hairline. `strong` marks the boundary between two panes of different grounds (the card and the inspector's
///| step-back ground), which the quiet separator does not carry in light mode.
///| Second-level filter (Console level, request type): quieter than the tab control above it. Plain words with
///| no track; the chosen one reads in full ink on a 24pt selected wash. Each word is a 32pt-tall hit target and is
///| announced as `a11y_prefix + name` (selected state included); the group is announced as `said`.
fn dt_filter_pills(
  parent : view::View,
  said : String,
  names : Array[String],
  a11y_prefix : String,
  selected : () -> Int,
  on_select : (Int) -> Unit,
) -> Unit {
  let _ = parent.box(fn(grp : view::View) -> Unit {
    let _ = grp
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .gap(view::Live::Is(SP_2))
    .says(view::Live::Is(Some(view::said(view::Role::Group, label=said))))
    let mut i = 0
    while i < names.length() {
      let idx = i
      let name = names[idx]
      let chosen = fn() -> Bool { selected() == idx }
      let b = headless::button(
        grp,
        fn() { a11y_prefix + name },
        fn(_v : view::View) -> Unit { on_select(idx) },
        fn(hit : view::View, btn : headless::Button) -> Unit {
          let _ = hit.height(view::Live::Is(Some(SP_32))).rigid().center()
          let hover_t = shell_fade(hit, fn() { btn.hovered() || btn.pressed() })
          let lit = shell_fade(hit, chosen)
          let _ = hit.box(fn(pill : view::View) -> Unit {
            let _ = pill
            .height(view::Live::Is(Some(SP_24)))
            .rigid()
            .center()
            .points(view::Live::Is(false))
            .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
            .radius(view::Live::Is(SP_6))
            .ground(view::Live::By(fn() {
              let s = lg::surface()
              if chosen() { s.row_selected } else { lg::alpha(s.row_hover, hover_t()) }
            }))
            <ui::Text
              in={pill}
              size={TX_FOOTNOTE}
              weight={500}
              color_by=>{shell_mix(lg::surface().ink_secondary, lg::surface().ink, lit())}
              text={name}
            />
          })
        },
      )
      let _ = b.says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(view::Role::Button, label=a11y_prefix + name, selected=chosen()))
      }))
      i += 1
    }
  })
}

fn dt_hairline(
  parent : view::View,
  vertical~ : () -> Bool = fn() { false },
  hidden~ : () -> Bool = fn() { false },
  strong~ : Bool = false,
) -> Unit {
  let _ = parent.box(fn(sep : view::View) -> Unit {
    let w = fn() -> Double { if hidden() { SP_0 } else { lg::hairline_w } }
    let _ = sep
    .width(view::Live::By(fn() -> Option[Double] { if vertical() { Some(w()) } else { None } }))
    .height(view::Live::By(fn() -> Option[Double] { if vertical() { None } else { Some(w()) } }))
    .rigid()
    .ground(view::Live::By(fn() { if strong { lg::surface().separator_strong } else { lg::surface().separator } }))
  })
}

///| Hairline between rows of a card list, inset to the row text.
fn dt_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((SP_12, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| Quiet sentence-case caption above a group.
fn dt_caption(parent : view::View, text : String) -> Unit {
  let _ = parent.box(fn(cap : view::View) -> Unit {
    let _ = cap.padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0))).rigid()
    <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={text} />
  })
}

///| Toolbar row under the main toolbar (filters, search, actions).
fn dt_toolbar(parent : view::View, body : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(bar : view::View) -> Unit {
    let _ = bar
    .row(view::Live::Is(true))
    .wraps(view::Live::Is(Some(SP_4)))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
    .gap(view::Live::Is(SP_8))
    body(bar)
  })
  dt_hairline(parent)
}

fn dt_spacer(parent : view::View) -> Unit {
  let _ = parent.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)).min_width(view::Live::Is(Some(SP_0))) })
}

fn dt_empty(parent : view::View, title : String, detail : String) -> Unit {
  let _ = parent.box(fn(emp : view::View) -> Unit {
    let _ = emp.padding(view::Live::Is((SP_16, SP_16, SP_16, SP_16))).gap(view::Live::Is(SP_4))
    <ui::Text in={emp} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text={title} />
    if detail != "" {
      <ui::Text in={emp} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text={detail} />
    }
  })
}

///| A label / value row of an inspector card (min 40pt like every grouped-list row, label left, value right).
fn dt_kv_row(parent : view::View, label : String, value : String, value_ink : () -> Int64, mono~ : Bool = false) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
    .gap(view::Live::Is(SP_12))
    let _ = row.box(fn(lc : view::View) -> Unit {
      let _ = lc.rigid()
      <ui::Text in={lc} size={TX_BODY} color_by=>{lg::surface().ink_secondary} text={label} />
    })
    let _ = row.box(fn(vc : view::View) -> Unit {
      let _ = vc
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_0)))
      .row(view::Live::Is(true))
      .lies_along(view::Live::Is(view::Lies::End))
      if mono {
        let _ = dt_mono(vc, fn() { value }, value_ink)
      } else {
        let _ = <ui::Text in={vc} size={TX_BODY} color_by=>{value_ink()} text={value} />.cut().allow_ellipsis(view::Live::Is(true))
      }
    })
  })
}

// ---------------------------------------------------------------------------------------------------------
// Elements.

///| One layer of the box model diagram: label at top left, four side values around `inner`.
fn dt_bm_layer(
  parent : view::View,
  name : String,
  ground_by : () -> Int64,
  top : Double,
  right : Double,
  bottom : Double,
  left : Double,
  radius : Double,
  inner : (view::View) -> Unit,
  edged~ : Bool = false,
) -> Unit {
  let side_val = fn(p : view::View, v : Double) -> Unit {
    let _ = p.box(fn(cell : view::View) -> Unit {
      let _ = cell.width(view::Live::Is(Some(SP_24))).rigid().center()
      let _ = dt_mono(cell, fn() { dt_bm_value(v) }, fn() { lg::surface().ink }, size=TX_CAPTION)
    })
  }
  let _ = parent.box(fn(layer : view::View) -> Unit {
    let _ = layer
    .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
    .gap(view::Live::Is(SP_2))
    .radius(view::Live::Is(radius))
    .ground(view::Live::By(ground_by))
    if edged {
      let _ = layer.edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
    }
    // Top value centered on the full layer width; the layer name sits over its top-left corner.
    let _ = layer.box(fn(tr : view::View) -> Unit {
      let _ = tr.center()
      let _ = tr.box(fn(lc : view::View) -> Unit {
        let _ = lc.over_at(view::Live::Is((Some(SP_4), Some(SP_0), None, None))).points(view::Live::Is(false))
        <ui::Text in={lc} size={TX_CAPTION} color_by=>{lg::surface().ink_secondary} text={name} />
      })
      side_val(tr, top)
    })
    let _ = layer.box(fn(mr : view::View) -> Unit {
      let _ = mr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      side_val(mr, left)
      let _ = mr.box(fn(ib : view::View) -> Unit {
        let _ = ib.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
        inner(ib)
      })
      side_val(mr, right)
    })
    let _ = layer.box(fn(br : view::View) -> Unit {
      let _ = br.center()
      side_val(br, bottom)
    })
  })
}

fn dt_build_box_model(parent : view::View, bm : proto::DevToolsBoxModel) -> Unit {
  let _ = lg::surface_card_node(
    parent,
    fn(card : view::View) -> Unit {
      dt_bm_layer(
        card,
        "margin",
        fn() { dt_card_tint(lg::surface().warning, 0.16) },
        bm.margin_top,
        bm.margin_right,
        bm.margin_bottom,
        bm.margin_left,
        SP_8,
        fn(m_in : view::View) -> Unit {
          dt_bm_layer(
            m_in,
            "border",
            fn() { lg::surface().card },
            bm.border_top,
            bm.border_right,
            bm.border_bottom,
            bm.border_left,
            SP_6,
            edged=true,
            fn(b_in : view::View) -> Unit {
              dt_bm_layer(
                b_in,
                "padding",
                fn() { dt_card_tint(lg::surface().positive, 0.16) },
                bm.pad_top,
                bm.pad_right,
                bm.pad_bottom,
                bm.pad_left,
                SP_4,
                fn(p_in : view::View) -> Unit {
                  let _ = p_in.box(fn(content : view::View) -> Unit {
                    let _ = content
                    .height(view::Live::Is(Some(SP_24)))
                    .center()
                    .radius(view::Live::Is(SP_4))
                    .ground(view::Live::By(fn() { dt_card_tint(lg::surface().accent, 0.16) }))
                    let _ = dt_mono(
                      content,
                      fn() { proto::format_devtools_px(bm.width) + " \u{00D7} " + proto::format_devtools_px(bm.height) },
                      fn() { lg::surface().ink },
                      size=TX_CAPTION,
                      weight=500,
                    )
                  })
                },
              )
            },
          )
        },
      )
    },
    radius=SP_12,
    pad=SP_4,
  )
}

fn dt_build_element_inspector(ic : view::View, props : DevToolsPanelProps) -> Unit {
  let st = props.state
  let snap = signals::untracked(props.snapshot)
  let sel_p = st.selected_path.untracked()
  let target_p = if sel_p != "" { sel_p } else { snap.selected_path }
  let mut selector = ""
  for nd in snap.nodes {
    if nd.path == target_p {
      selector = dt_node_selector(nd)
      break
    }
  }
  let _ = ic.gap(view::Live::Is(SP_16))
  if selector == "" {
    dt_empty(ic, "No element selected", "Choose an element in the tree to see its box model and computed styles.")
    return
  }
  // Selected element: selector in code purple.
  let _ = ic.box(fn(hdr : view::View) -> Unit {
    let _ = hdr.padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
    let _ = dt_mono(hdr, fn() { selector }, dt_code_purple, size=TX_BODY, weight=500)
  })
  let _ = ic.box(fn(grp : view::View) -> Unit {
    let _ = grp.gap(view::Live::Is(SP_6))
    dt_caption(grp, "Box model")
    dt_build_box_model(grp, snap.box_model)
  })
  let _ = ic.box(fn(grp : view::View) -> Unit {
    let _ = grp.gap(view::Live::Is(SP_6))
    dt_caption(grp, "Computed")
    if snap.styles.length() == 0 {
      let _ = <ui::Text in={grp} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text="No computed styles for this element." />
      return
    }
    let _ = lg::surface_card_node(
      grp,
      fn(list : view::View) -> Unit {
        let mut i = 0
        while i < snap.styles.length() {
          let sp = snap.styles[i]
          if i > 0 {
            dt_rule(list)
          }
          let swatch = proto::parse_devtools_color_swatch(sp.color_hex)
          let _ = list.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Start)))
            .min_height(view::Live::Is(Some(SP_40)))
            .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
            .gap(view::Live::Is(SP_8))
            let _ = row.box(fn(nc : view::View) -> Unit {
              let _ = nc.width(view::Live::Is(Some(SP_96))).rigid()
              let _ = dt_mono(nc, fn() { sp.name }, fn() { lg::surface().ink_secondary })
            })
            match swatch {
              Some(col) => {
                let _ = row.box(fn(cell : view::View) -> Unit {
                  let _ = cell.height(view::Live::Is(Some(dt_line_h))).rigid().center()
                  let _ = cell.box(fn(sw : view::View) -> Unit {
                    let _ = sw
                    .width(view::Live::Is(Some(SP_12)))
                    .height(view::Live::Is(Some(SP_12)))
                    .rigid()
                    .radius(view::Live::Is(SP_4))
                    .ground(view::Live::Is(col))
                    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
                  })
                })
              }
              None => ()
            }
            let _ = dt_mono(row, fn() { sp.value }, fn() { lg::surface().ink }, wrap=true, grow=true)
          })
          i += 1
        }
      },
      radius=SP_12,
      pad=SP_0,
    )
  })
}

fn dt_build_elements_tab(parent : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state
  let _ = parent
  .row(view::Live::By(fn() { !is_narrow() }))
  .fill()

  // DOM tree.
  let _ = parent.box(fn(tree_pane : view::View) -> Unit {
    // Narrow: the tree and the inspector share the height 1:1; the 4pt foot keeps a scrolled row off the pane edge.
    let _ = tree_pane.fill().padding(view::Live::Is((SP_0, SP_0, SP_0, SP_4)))
    let _ = ui::scroll_box(tree_pane, fn(tree_list : view::View) -> Unit {
      let _ = tree_list.padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
      tree_list.switch_by(
        fn() -> Int {
          ((props.rev)() * 128 + st.collapse_rev.get()) * 2 + dt_dark_bit(props)
        },
        fn(nodes_box : view::View, _key : Int) -> Unit {
          let nodes = signals::untracked(props.snapshot).nodes
          if nodes.length() == 0 {
            dt_empty(nodes_box, "Loading the document tree", "")
          }
          let mut i = 0
          while i < nodes.length() {
            let nd = nodes[i]
            if !dt_is_hidden_by_collapse(st.collapsed_paths, nd.path) {
              let npath = nd.path
              let is_collapsed = st.collapsed_paths.get(npath).unwrap_or(false)
              let is_sel = fn() -> Bool { st.selected_path.get() == npath }
              let indent = SP_4 + nd.depth.to_double() * dt_indent_step
              let _ = nodes_box.box(fn(row : view::View) -> Unit {
                let hover_t = shell_fade(row, fn() { row.pointed() })
                let _ = row
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .min_height(view::Live::Is(Some(dt_row_h)))
                .rigid()
                .radius(view::Live::Is(SP_6))
                .clips(view::Live::Is(true))
                .ground(view::Live::By(fn() -> Int64 {
                  let s = lg::surface()
                  if is_sel() { s.row_selected } else { lg::alpha(s.row_hover, hover_t()) }
                }))
                let _ = row.box(fn(ind : view::View) -> Unit {
                  let _ = ind.width(view::Live::Is(Some(indent))).rigid()
                })
                // Disclosure and leaf placeholder share one width, so siblings line up.
                if nd.child_count > 0 {
                  let _ = headless::button(
                    row,
                    fn() { if is_collapsed { "Expand " + nd.tag } else { "Collapse " + nd.tag } },
                    fn(_v : view::View) -> Unit {
                      st.collapsed_paths.set(npath, !is_collapsed)
                      st.collapse_rev.set(st.collapse_rev.untracked() + 1)
                    },
                    fn(chb : view::View, _cbtn : headless::Button) -> Unit {
                      let _ = chb
                      .width(view::Live::Is(Some(dt_disclosure_w)))
                      .height(view::Live::Is(Some(dt_row_h)))
                      .rigid()
                      .center()
                      let _ = shell_icon(
                        chb,
                        if is_collapsed { ICON_CHEVRON_RIGHT } else { ICON_CHEVRON_DOWN },
                        size=IC_SM,
                        color_by=fn() { lg::surface().ink_secondary },
                      )
                    },
                  )
                } else {
                  let _ = row.box(fn(pad : view::View) -> Unit {
                    let _ = pad.width(view::Live::Is(Some(dt_disclosure_w))).rigid()
                  })
                }
                let _ = headless::button(
                  row,
                  fn() { "Inspect <" + nd.tag + ">" },
                  fn(_v : view::View) -> Unit {
                    st.selected_path.set(npath)
                    (props.on_inspect)(npath)
                  },
                  fn(nb : view::View, _nbtn : headless::Button) -> Unit {
                    let _ = nb
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(SP_0)))
                    .min_width(view::Live::Is(Some(SP_0)))
                    .min_height(view::Live::Is(Some(dt_row_h)))
                    .padding(view::Live::Is((SP_4, SP_0, SP_8, SP_0)))
                    let _ = nb.box(fn(tv : view::View) -> Unit {
                      let _ = tv
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(SP_0)))
                      .min_width(view::Live::Is(Some(SP_0)))
                      .cut()
                      .allow_ellipsis(view::Live::Is(true))
                      .words_runs(
                        view::Live::By(fn() { dt_dom_node_runs(nd, is_collapsed) }),
                        ink=lg::surface().ink,
                        look=view::WordsLook::{ ..view::words_plain, size: TX_FOOTNOTE, line: dt_line_h, wrap: false },
                      )
                    })
                  },
                )
              })
            }
            i += 1
          }
        },
      )
    })
  })

  dt_hairline(parent, vertical=fn() { !is_narrow() }, strong=true)

  // Inspector: selected element, box model, computed styles.
  let _ = parent.box(fn(insp_pane : view::View) -> Unit {
    let _ = insp_pane
    .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(dt_inspector_w) } }))
    .grow(view::Live::By(fn() { if is_narrow() { 1.0 } else { 0.0 } }))
    .shrink(view::Live::By(fn() { if is_narrow() { 1.0 } else { 0.0 } }))
    .basis(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(SP_0) } else { None } }))
    .min_width(view::Live::Is(Some(SP_0)))
    .min_height(view::Live::Is(Some(SP_0)))
    .ground(view::Live::By(dt_pane_bg))
    let _ = ui::scroll_box(insp_pane, fn(insp_body : view::View) -> Unit {
      let _ = insp_body.padding(view::Live::Is((SP_12, SP_12, SP_12, SP_16)))
      insp_body.switch_by(
        fn() -> Int {
          let _ = st.selected_path.get()
          (props.rev)() * 2 + dt_dark_bit(props)
        },
        fn(ic : view::View, _key : Int) -> Unit { dt_build_element_inspector(ic, props) },
      )
    })
  })
}

// ---------------------------------------------------------------------------------------------------------
// Console.

///| Row ground, level glyph, glyph ink and text ink of a console entry (read at draw time, so it follows dark mode).
fn dt_console_look(ce : proto::DevToolsConsoleEntry) -> (Int64, String, Int64, Int64) {
  let s = lg::surface()
  if ce.level == "warn" {
    (s.warning_bg, ICON_ALERT_TRIANGLE, s.warning, s.ink)
  } else if ce.level == "error" {
    (s.danger_bg, ICON_ALERT_CIRCLE, s.danger, if lg::is_dark() { shell_mix(s.danger, 0xFFFFFFFFL, 0.35) } else { s.danger })
  } else if ce.level == "input" {
    (0x00000000L, ICON_CHEVRON_RIGHT, s.accent, s.ink)
  } else if ce.level == "result" {
    (0x00000000L, "chevron-left", s.ink_secondary, dt_console_result_color_for(ce, lg::is_dark()))
  } else if ce.level == "info" {
    (0x00000000L, ICON_INFO, s.ink_secondary, s.ink)
  } else {
    (0x00000000L, "", s.ink_secondary, s.ink)
  }
}

fn dt_build_console_row(parent : view::View, ce : proto::DevToolsConsoleEntry, is_narrow : () -> Bool) -> Unit {
  let (_, icon_name, _, _) = signals::untracked(fn() { dt_console_look(ce) })
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Start)))
    .min_height(view::Live::Is(Some(dt_row_h)))
    .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
    .gap(view::Live::Is(SP_8))
    .ground(view::Live::By(fn() { dt_console_look(ce).0 }))
    // Level glyph, centered on the first line of the message.
    let _ = row.box(fn(gc : view::View) -> Unit {
      let _ = gc.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(dt_line_h))).rigid().center()
      if icon_name != "" {
        let _ = shell_icon(gc, icon_name, size=IC_SM, color_by=fn() { dt_console_look(ce).2 })
      }
    })
    // Message; on narrow widths the source drops under it instead of taking a column.
    let has_src = ce.source != "" && ce.level != "result" && ce.level != "input"
    let _ = row.box(fn(col : view::View) -> Unit {
      let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).gap(view::Live::Is(SP_2))
      let _ = dt_mono(col, fn() { ce.text }, fn() { dt_console_look(ce).3 }, wrap=true)
      if has_src {
        col.show(is_narrow, fn(src : view::View) -> Unit {
          let _ = dt_mono(src, fn() { ce.source }, fn() { lg::surface().ink_secondary }, size=TX_CAPTION)
        })
      }
    })
    if has_src {
      row.show(fn() { !is_narrow() }, fn(src : view::View) -> Unit {
        let _ = src.rigid().max_width(view::Live::Is(Some(SP_160)))
        let _ = dt_mono(src, fn() { ce.source }, fn() { lg::surface().ink_secondary })
      })
    }
  })
}

fn dt_build_console_tab(parent : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state
  let _ = parent.fill()

  dt_toolbar(parent, fn(bar : view::View) -> Unit {
    dt_filter_pills(
      bar,
      "Console Level",
      ["All", "Logs", "Warnings", "Errors"],
      "Filter Console ",
      fn() { st.console_filter.get() },
      fn(i : Int) -> Unit { st.console_filter.set(i) },
    )
    dt_spacer(bar)
    let _ = dt_icon_btn(bar, fn() { "Clear Console Output" }, fn() { "eraser" }, props.on_clear_console)
  })

  // Message stream.
  let _ = parent.box(fn(log_pane : view::View) -> Unit {
    let _ = log_pane.fill()
    let _ = ui::scroll_box(log_pane, fn(log_list : view::View) -> Unit {
      log_list.switch_by(
        fn() -> Int { ((props.rev)() * 16 + st.console_filter.get()) * 2 + dt_dark_bit(props) },
        fn(entries_box : view::View, _key : Int) -> Unit {
          let filt = st.console_filter.untracked()
          let entries = signals::untracked(props.snapshot).console_entries
          let filtered : Array[proto::DevToolsConsoleEntry] = []
          for ce in entries {
            if dt_console_matches(filt, ce.level) {
              filtered.push(ce)
            }
          }
          if filtered.length() == 0 {
            if entries.length() == 0 {
              dt_empty(entries_box, "No messages", "Type a JavaScript expression below and press Return to run it in the page.")
            } else {
              dt_empty(entries_box, "No messages at this level", "")
            }
          }
          let mut i = 0
          while i < filtered.length() {
            if i > 0 {
              dt_hairline(entries_box)
            }
            dt_build_console_row(entries_box, filtered[i], is_narrow)
            i += 1
          }
        },
      )
    })
  })

  // Prompt.
  dt_hairline(parent)
  let _ = parent.box(fn(rbar : view::View) -> Unit {
    let _ = rbar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_4, SP_4, SP_4)))
    .gap(view::Live::Is(SP_8))

    let submit_repl = fn(raw : String) -> Unit {
      let trimmed = raw.trim()
      if trimmed != "" {
        (props.on_eval)(trimmed)
        st.repl_field.set("")
      }
    }
    let _ = rbar.box(fn(gc : view::View) -> Unit {
      let _ = gc.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(SP_16))).rigid().center()
      // Focus without a box: the prompt chevron eases to accent while typing goes to the REPL.
      let focus_t = shell_fade(gc, fn() { st.repl_field.focused() }, duration_ms=MO_KEY_MS)
      let _ = shell_icon(gc, ICON_CHEVRON_RIGHT, size=IC_SM, color_by=fn() {
        let s = lg::surface()
        shell_mix(s.ink_tertiary, s.accent, focus_t())
      })
    })
    let _ = rbar.box(fn(inp : view::View) -> Unit {
      let _ = inp
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_0)))
      .clips(view::Live::Is(true))
      let typed = ui::field(
        inp,
        st.repl_field,
        placeholder="Evaluate in page",
        font_size=TX_BODY,
        max_lines=1,
        enter_sends=true,
        label="Console REPL Input",
        colors_by=fn() {
          let s = lg::surface()
          (s.ink, s.ink_secondary, s.accent)
        },
        submitted=submit_repl,
      )
      let _ = typed.on_key(fn(k : view::Key) -> Bool {
        if k.code == proto::KEY_ESCAPE && st.repl_field.composing() {
          st.repl_field.compose("")
          true
        } else {
          false
        }
      })
    })
    let _ = dt_icon_btn(
      rbar,
      fn() { "Run Console Expression" },
      fn() { ICON_ARROW_RIGHT },
      fn() { submit_repl(st.repl_field.text()) },
      ink_by=fn() {
        if st.repl_field.text().trim() != "" { lg::surface().accent } else { lg::surface().ink_tertiary }
      },
    )
  })
}

// ---------------------------------------------------------------------------------------------------------
// Network.

///| The fixed-width cells of the request grid (header and rows use the same widths).
fn dt_net_cell(parent : view::View, w : Double, end~ : Bool = false, body : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(c : view::View) -> Unit {
    let _ = c.width(view::Live::Is(Some(w))).rigid().row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
    if end {
      let _ = c.lies_along(view::Live::Is(view::Lies::End))
    }
    body(c)
  })
}

fn dt_net_head_text(parent : view::View, t : String) -> Unit {
  <ui::Text in={parent} size={TX_CAPTION} weight={500} color_by=>{lg::surface().ink_secondary} text={t} />
}

let dt_net_time_w : Double = 152.0 // SP_96 + SP_8 + SP_48

fn dt_build_request_inspector(card : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state
  let idx = st.net_selected_idx.untracked()
  let entries = signals::untracked(props.snapshot).network_entries
  if idx < 0 || idx >= entries.length() {
    return
  }
  let ne = entries[idx]
  let curl_cmd = proto::devtools_net_curl_command(ne)
  let (tile_icon, tile_color) = dt_net_tile(ne.kind, ne.url)
  let _ = card.gap(view::Live::Is(SP_12))

  let _ = card.box(fn(hdr : view::View) -> Unit {
    let _ = hdr.gap(view::Live::Is(SP_4))
    let _ = hdr.box(fn(top : view::View) -> Unit {
      let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8))
      // Narrow: the inspector replaces the list, so the way back leads the header as a back chevron.
      top.show(is_narrow, fn(back : view::View) -> Unit {
        let _ = back.rigid()
        let _ = dt_icon_btn(back, fn() { "Close Request Inspector" }, fn() { "chevron-left" }, fn() { st.net_selected_idx.set(-1) })
      })
      let _ = shell_glyph_tile(top, tile_icon, size=SP_24)
      let _ = top.box(fn(nc : view::View) -> Unit {
        let _ = nc.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
        let _ = <ui::Text in={nc} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text={ne.name} />.cut().allow_ellipsis(view::Live::Is(true))
      })
      let _ = top.box(fn(acts : view::View) -> Unit {
        let _ = acts.row(view::Live::Is(true)).rigid().gap(view::Live::Is(SP_0))
        let _ = dt_icon_btn(acts, fn() { "Copy as cURL" }, fn() { ICON_COPY }, fn() { (props.on_copy_curl)(curl_cmd) })
        acts.show(fn() { !is_narrow() }, fn(cl : view::View) -> Unit {
          let _ = cl.rigid()
          let _ = dt_icon_btn(cl, fn() { "Close Request Inspector" }, fn() { ICON_CLOSE }, fn() { st.net_selected_idx.set(-1) })
        })
      })
    })
    let _ = dt_mono(hdr, fn() { if ne.url != "" { ne.url } else { ne.name } }, fn() { lg::surface().ink_secondary }, wrap=true)
  })

  let _ = lg::surface_card_node(
    card,
    fn(list : view::View) -> Unit {
      dt_kv_row(list, "Status", proto::devtools_net_status_text(ne.status), fn() { dt_status_ink(ne.status) })
      dt_rule(list)
      dt_kv_row(list, "Type", proto::devtools_net_mime(ne), fn() { lg::surface().ink })
      dt_rule(list)
      dt_kv_row(list, "Size", proto::format_devtools_bytes(ne.size_bytes), fn() { lg::surface().ink })
      dt_rule(list)
      dt_kv_row(list, "Time", ne.duration_ms.to_string() + " ms", fn() { lg::surface().ink })
    },
    radius=SP_12,
    pad=SP_0,
  )
}

fn dt_build_network_tab(parent : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state
  let _ = parent.fill()
  let cats = ["all", "doc", "js", "css", "img", "fetch"]
  let cat_names = ["All", "Doc", "JS", "CSS", "Img", "Fetch"]
  let live_query = fn() -> String {
    let live_q = st.net_search_field.text()
    if live_q != "" { live_q } else { st.net_query.get() }
  }

  let has_sel = fn() -> Bool {
    let _ = (props.rev)()
    let idx = st.net_selected_idx.get()
    idx >= 0 && idx < (props.snapshot)().network_entries.length()
  }
  // Narrow with a request open, the list is gone: its filter and summary go with it.
  let list_shown = fn() -> Bool { !(is_narrow() && has_sel()) }

  parent.show(list_shown, fn(tb : view::View) -> Unit {
    let _ = tb.rigid()
    dt_toolbar(tb, fn(bar : view::View) -> Unit {
      dt_filter_pills(
        bar,
        "Request Type",
        cat_names,
        "Filter Network ",
        fn() {
          let cur = st.net_filter.get()
          let mut k = 0
          while k < cats.length() {
            if cats[k] == cur {
              return k
            }
            k += 1
          }
          0
        },
        fn(i : Int) -> Unit { st.net_filter.set(cats[i]) },
      )
      dt_spacer(bar)
      let _ = bar.box(fn(sbox : view::View) -> Unit {
        // Wide: a fixed field at the trailing end. Narrow: it wraps to its own row and takes the full width.
        let _ = sbox
        .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(SP_160 + SP_40) } }))
        .grow(view::Live::By(fn() { if is_narrow() { 1.0 } else { 0.0 } }))
        .basis(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(SP_160 * 2.0) } else { None } }))
        .shrink(view::Live::Is(0.0))
        let _ = lg::liquid_text_field_node(
          sbox,
          st.net_search_field,
          placeholder="Filter",
          label=fn() { "Filter Network Requests" },
          show_label=false,
          flat=true,
          radius=SP_8,
          height_by=fn() { SP_32 },
          lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
            let _ = shell_icon(ic, ICON_SEARCH, size=IC_SM, color_by=ink)
          },
          edited=fn(q : String) -> Unit { st.net_query.set(q) },
          submitted=fn(q : String) -> Unit { st.net_query.set(q) },
        )
      })
    })
  })

  // Table + request inspector.
  let _ = parent.box(fn(net_split : view::View) -> Unit {
    let _ = net_split
    .row(view::Live::By(fn() { !is_narrow() }))
    .fill()
    .clips(view::Live::Is(true))

    // Narrow: a selected request replaces the table (closing it returns to the list).
    net_split.show(list_shown, fn(tbl : view::View) -> Unit {
      let _ = tbl.fill()
      // Column header: Name | Status | Type | Size | Time
      let _ = tbl.box(fn(thdr : view::View) -> Unit {
        let _ = thdr
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .height(view::Live::Is(Some(SP_24)))
        .rigid()
        .padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
        .gap(view::Live::Is(SP_12))
        let _ = thdr.box(fn(cn : view::View) -> Unit {
          let _ = cn.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
          .padding(view::Live::Is((SP_16 + SP_8, SP_0, SP_0, SP_0)))
          dt_net_head_text(cn, "Name")
        })
        dt_net_cell(thdr, SP_48, fn(c) { dt_net_head_text(c, "Status") })
        dt_net_cell(thdr, SP_64, fn(c) { dt_net_head_text(c, "Type") })
        dt_net_cell(thdr, SP_64, end=true, fn(c) { dt_net_head_text(c, "Size") })
        thdr.show(fn() { !is_narrow() }, fn(wide : view::View) -> Unit {
          let _ = wide.rigid()
          dt_net_cell(wide, dt_net_time_w, end=true, fn(c) { dt_net_head_text(c, "Time") })
        })
        thdr.show(fn() { is_narrow() }, fn(nar : view::View) -> Unit {
          let _ = nar.rigid()
          dt_net_cell(nar, SP_48, end=true, fn(c) { dt_net_head_text(c, "Time") })
        })
      })
      dt_hairline(tbl)
      let _ = ui::scroll_box(tbl, fn(net_list : view::View) -> Unit {
        let _ = net_list.padding(view::Live::Is((SP_0, SP_4, SP_0, SP_4)))
        net_list.switch_by(
          fn() -> Int {
            let cat_s = st.net_filter.get()
            let mut cat_code = 6
            let mut k = 0
            while k < cats.length() {
              if cats[k] == cat_s {
                cat_code = k
              }
              k += 1
            }
            let qb = live_query().to_bytes()
            let mut qh = 0
            let mut qi = 0
            while qi < qb.length() {
              qh = (qh * 31 + (qb[qi].to_int() & 0xFF)) & 0x3FFF
              qi += 1
            }
            ((((props.rev)() & 0xFF) * 8 + cat_code) * 16384 + qh) * 2 + dt_dark_bit(props)
          },
          fn(rows_box : view::View, _key : Int) -> Unit {
            let entries = signals::untracked(props.snapshot).network_entries
            let cat = st.net_filter.untracked()
            let q = signals::untracked(live_query)
            let mut max_ms = 1
            for e in entries {
              if e.duration_ms > max_ms {
                max_ms = e.duration_ms
              }
            }
            let matched : Array[Int] = []
            let mut fi = 0
            while fi < entries.length() {
              if proto::devtools_net_matches_filter(entries[fi], cat, q) {
                matched.push(fi)
              }
              fi += 1
            }
            if matched.length() == 0 {
              if entries.length() == 0 {
                dt_empty(rows_box, "No requests yet", "Requests appear here as the page loads. Reload the page to record them from the start.")
              } else {
                dt_empty(rows_box, "No matching requests", "")
              }
            }
            let mut ri = 0
            while ri < matched.length() {
              let idx = matched[ri]
              let ne = entries[idx]
              let (tile_icon, tile_color) = dt_net_tile(ne.kind, ne.url)
              let wf_ratio = proto::devtools_net_waterfall_ratio(ne.duration_ms, max_ms)
              let is_sel = fn() -> Bool { st.net_selected_idx.get() == idx }
              let _ = headless::button(
                rows_box,
                fn() { "Inspect request " + ne.name },
                fn(_v : view::View) -> Unit {
                  if st.net_selected_idx.untracked() == idx {
                    st.net_selected_idx.set(-1)
                  } else {
                    st.net_selected_idx.set(idx)
                  }
                },
                fn(nrow : view::View, nbtn : headless::Button) -> Unit {
                  let hover_t = shell_fade(nrow, fn() { nbtn.hovered() })
                  let _ = nrow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .min_height(view::Live::Is(Some(dt_net_row_h)))
                  .rigid()
                  .margin(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
                  .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
                  .gap(view::Live::Is(SP_12))
                  .radius(view::Live::Is(SP_6))
                  .ground(view::Live::By(fn() -> Int64 {
                    let s = lg::surface()
                    if is_sel() { s.row_selected } else { lg::alpha(s.row_hover, hover_t()) }
                  }))
                  let _ = nrow.box(fn(nm : view::View) -> Unit {
                    let _ = nm
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(SP_8))
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(SP_0)))
                    .min_width(view::Live::Is(Some(SP_0)))
                    let _ = shell_glyph_tile(nm, tile_icon, size=SP_16)
                    let _ = nm.box(fn(nt : view::View) -> Unit {
                      let _ = nt.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
                      let _ = <ui::Text in={nt} size={TX_BODY} color_by=>{lg::surface().ink} text={ne.name} />.cut().allow_ellipsis(view::Live::Is(true))
                    })
                  })
                  dt_net_cell(nrow, SP_48, fn(c) {
                    let _ = dt_mono(c, fn() { ne.status.to_string() }, fn() { dt_status_ink(ne.status) })
                  })
                  dt_net_cell(nrow, SP_64, fn(c) {
                    let _ = <ui::Text in={c} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={dt_net_type_word(ne.kind, ne.url)} />.cut().allow_ellipsis(view::Live::Is(true))
                  })
                  dt_net_cell(nrow, SP_64, end=true, fn(c) {
                    <ui::Text in={c} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={proto::format_devtools_bytes(ne.size_bytes)} />
                  })
                  nrow.show(fn() { !is_narrow() }, fn(wide : view::View) -> Unit {
                    let _ = wide.rigid().row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8))
                    let _ = wide.box(fn(track : view::View) -> Unit {
                      let _ = track
                      .width(view::Live::Is(Some(SP_96)))
                      .height(view::Live::Is(Some(SP_4)))
                      .rigid()
                      .radius(view::Live::Is(SP_2))
                      .clips(view::Live::Is(true))
                      .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                      let _ = track.box(fn(fill : view::View) -> Unit {
                        let fw = SP_96 * wf_ratio
                        let _ = fill
                        .width(view::Live::Is(Some(if fw < SP_4 { SP_4 } else { fw })))
                        .height(view::Live::Is(Some(SP_4)))
                        .rigid()
                        .radius(view::Live::Is(SP_2))
                        .ground(view::Live::Is(tile_color))
                      })
                    })
                    dt_net_cell(wide, SP_48, end=true, fn(c) {
                      <ui::Text in={c} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={ne.duration_ms.to_string() + " ms"} />
                    })
                  })
                  nrow.show(fn() { is_narrow() }, fn(nar : view::View) -> Unit {
                    let _ = nar.rigid()
                    dt_net_cell(nar, SP_48, end=true, fn(c) {
                      <ui::Text in={c} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={ne.duration_ms.to_string() + " ms"} />
                    })
                  })
                },
              )
              ri += 1
            }
          },
        )
      })
    })

    // Request inspector.
    net_split.show(
      has_sel,
      fn(insp_wrap : view::View) -> Unit {
        let _ = insp_wrap
        .row(view::Live::By(fn() { !is_narrow() }))
        .grow(view::Live::By(fn() { if is_narrow() { 1.0 } else { 0.0 } }))
        .shrink(view::Live::Is(0.0))
        .basis(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(SP_0) } else { None } }))
        .min_height(view::Live::Is(Some(SP_0)))
        dt_hairline(insp_wrap, vertical=fn() { !is_narrow() }, hidden=is_narrow, strong=true)
        let _ = insp_wrap.box(fn(insp : view::View) -> Unit {
          let _ = insp
          .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(dt_inspector_w) } }))
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .basis(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(SP_0) } else { None } }))
          .min_height(view::Live::Is(Some(SP_0)))
          .ground(view::Live::By(dt_pane_bg))
          let _ = ui::scroll_box(insp, fn(insp_body : view::View) -> Unit {
            let _ = insp_body.padding(view::Live::Is((SP_12, SP_12, SP_12, SP_16)))
            insp_body.switch_by(
              fn() -> Int { ((props.rev)() * 128 + st.net_selected_idx.get() + 1) * 2 + dt_dark_bit(props) },
              fn(card : view::View, _key : Int) -> Unit { dt_build_request_inspector(card, props, is_narrow) },
            )
          })
        })
      },
    )
  })

  // Summary.
  parent.show(list_shown, fn(foot_wrap : view::View) -> Unit {
    let _ = foot_wrap.rigid()
    dt_hairline(foot_wrap)
    let _ = foot_wrap.box(fn(foot : view::View) -> Unit {
      let _ = foot
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .rigid()
      .padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      <ui::Text
        in={foot}
        size={TX_FOOTNOTE}
        color_by=>{lg::surface().ink_secondary}
        text_by=>{
          let _ = (props.rev)()
          let cat = st.net_filter.get()
          let q = live_query()
          let all = (props.snapshot)().network_entries
          let shown : Array[proto::DevToolsNetworkEntry] = []
          for ne in all {
            if proto::devtools_net_matches_filter(ne, cat, q) {
              shown.push(ne)
            }
          }
          dt_net_footer(shown, all.length())
        }
      />
    })
  })
}

// ---------------------------------------------------------------------------------------------------------
// Shared surface: toolbar + active tab.

fn dt_build_inner_surface(container : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state

  // Toolbar: tabs, the inspected page, then Refresh / Float-Dock / Close.
  let _ = container.box(fn(bar : view::View) -> Unit {
    let _ = bar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .min_height(view::Live::Is(Some(SP_48)))
    .padding(view::Live::By(fn() {
      let p = if st.presentation.get() is DevToolsPresentation::Floating { SP_8 } else { SP_12 }
      (p, p, p, p)
    }))
    .gap(view::Live::Is(SP_12))
    .says(view::Live::Is(Some(view::said(view::Role::Toolbar, label="DevTools"))))

    dt_segmented(
      bar,
      "DevTools Tabs",
      ["Elements", "Console", "Network"],
      "DevTools Tab ",
      fn() { st.tab.get() },
      fn(i : Int) -> Unit {
        st.tab.set(i)
        (props.on_inspect)(st.selected_path.untracked())
      },
    )

    // The inspected page: title, host (and which pane, when it is the right one).
    let _ = bar.box(fn(pg : view::View) -> Unit {
      let _ = pg
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_0)))
      .gap(view::Live::Is(SP_8))
      .clips(view::Live::Is(true))
      let host_by = fn() -> String {
        let _ = (props.rev)()
        let u = (props.snapshot)().page_url
        if u != "" { proto::omnibox_display_host(u) } else { "" }
      }
      // Narrow: no room for a title worth reading next to the tabs, so the page is named only where it is wide.
      pg.show(fn() { !is_narrow() }, fn(tc : view::View) -> Unit {
        let _ = tc.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(SP_0)))
        let _ = <ui::Text
          in={tc}
          size={TX_BODY}
          weight={500}
          color_by=>{lg::surface().ink}
          text_by=>{
            let _ = (props.rev)()
            let snap = (props.snapshot)()
            if snap.page_title != "" { snap.page_title } else if host_by() != "" { host_by() } else { "about:blank" }
          }
        />.cut().allow_ellipsis(view::Live::Is(true))
      })
      // The host only fits beside the title in the full-width docked card; the floating panel names the page alone.
      let host_fits = fn() -> Bool { !is_narrow() && (st.presentation.get() is DevToolsPresentation::Docked) }
      pg.show(fn() { host_fits() && host_by() != "" }, fn(hc : view::View) -> Unit {
        let _ = hc.shrink(view::Live::Is(2.0)).min_width(view::Live::Is(Some(SP_0)))
        let _ = <ui::Text in={hc} size={TX_BODY} color_by=>{lg::surface().ink_secondary} text_by=>{host_by()} />.cut().allow_ellipsis(view::Live::Is(true))
      })
      pg.show(fn() { (props.owner_pane)() is PaneId::Secondary }, fn(pc : view::View) -> Unit {
        // A quiet tag, so the pane reads as a fact about the page rather than more of its title.
        let _ = pc
        .rigid()
        .height(view::Live::Is(Some(SP_24)))
        .center()
        .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
        .radius(view::Live::Is(SP_6))
        .ground(view::Live::By(fn() { lg::surface().card_secondary }))
        <ui::Text
          in={pc}
          size={TX_FOOTNOTE}
          weight={500}
          color_by=>{lg::surface().ink_secondary}
          text_by=>{dt_pane_label((props.owner_pane)())}
        />
      })
    })

    let _ = bar.box(fn(acts : view::View) -> Unit {
      let _ = acts.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2)).rigid()
      let _ = dt_icon_btn(acts, fn() { "Refresh DevTools" }, fn() { ICON_RELOAD }, props.on_refresh)
      let _ = dt_icon_btn(
        acts,
        fn() {
          match st.presentation.get() {
            DevToolsPresentation::Docked => "Float DevTools"
            DevToolsPresentation::Floating => "Dock DevTools"
          }
        },
        fn() {
          match st.presentation.get() {
            DevToolsPresentation::Docked => "arrow-up-right"
            DevToolsPresentation::Floating => "arrow-down"
          }
        },
        fn() -> Unit {
          let next = match st.presentation.untracked() {
            DevToolsPresentation::Docked => DevToolsPresentation::Floating
            DevToolsPresentation::Floating => DevToolsPresentation::Docked
          }
          st.presentation.set(next)
          match props.on_presentation_change {
            Some(cb) => cb(next)
            None => ()
          }
        },
      )
      let _ = dt_icon_btn(acts, fn() { "Close DevTools" }, fn() { ICON_CLOSE }, props.on_close)
    })
  })

  dt_hairline(container)

  let _ = container.box(fn(panel_host : view::View) -> Unit {
    let _ = panel_host.fill().clips(view::Live::Is(true))
    panel_host.show(fn() { st.tab.get() == DEVTOOLS_TAB_ELEMENTS }, fn(v : view::View) -> Unit {
      dt_build_elements_tab(v, props, is_narrow)
    })
    panel_host.show(fn() { st.tab.get() == DEVTOOLS_TAB_CONSOLE }, fn(v : view::View) -> Unit {
      dt_build_console_tab(v, props, is_narrow)
    })
    panel_host.show(fn() { st.tab.get() == DEVTOOLS_TAB_NETWORK }, fn(v : view::View) -> Unit {
      dt_build_network_tab(v, props, is_narrow)
    })
  })
}

///| Builds DevTools docked (a solid card under the page) or floating (one layer of glass around the same
///| solid content), sharing one `DevToolsPanelState`.
pub fn build_devtools_panel(
  parent : view::View,
  props : DevToolsPanelProps,
  docked_only~ : Bool = false,
  floating_only~ : Bool = false,
) -> Unit {
  let st = props.state
  let drag_start_wy = ui::ref_new(0.0)
  let drag_start_h = ui::ref_new(proto::DEVTOOLS_HEIGHT_DEFAULT)

  let live_win_w = fn() -> Double {
    let _ = parent.laid_size_told()
    let ww = parent.window_w()
    if ww > SP_96 {
      ww
    } else {
      let (_, _, pw, _) = parent.placed_now()
      if pw > SP_96 { pw } else { dt_fallback_w }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = parent.laid_size_told()
    let wh = parent.window_h()
    if wh > SP_96 {
      wh
    } else {
      let (_, _, _, ph) = parent.placed_now()
      if ph > SP_96 { ph } else { dt_fallback_h }
    }
  }
  let is_narrow = fn() -> Bool { live_win_w() < SHELL_SIDEBAR_BREAKPOINT }

  // Docked: the frame gap above the card is the resize handle.
  if !floating_only {
    parent.show(
      fn() { (props.open)() && (st.presentation.get() is DevToolsPresentation::Docked) },
      fn(drawer : view::View) -> Unit {
        let _ = drawer
        .height(view::Live::By(fn() -> Option[Double] {
          let wh = live_win_h()
          let cap = if wh > SP_160 * 2.0 { wh - SP_160 } else { proto::DEVTOOLS_HEIGHT_MIN }
          let desired = st.height.get()
          let clamped = if desired > cap { cap } else { desired }
          Some(if clamped < proto::DEVTOOLS_HEIGHT_MIN { proto::DEVTOOLS_HEIGHT_MIN } else { clamped })
        }))
        .rigid()
        .min_width(view::Live::Is(Some(SP_0)))
        .min_height(view::Live::Is(Some(proto::DEVTOOLS_HEIGHT_MIN)))

        // The 8pt frame gap is the visual handle; its drag target is a 24pt invisible strip that straddles the gap
        // (12pt into the page card above, 4pt into the toolbar's top padding below, clear of its controls).
        let _ = drawer.box(fn(handle : view::View) -> Unit {
          let _ = handle.height(view::Live::Is(Some(SHELL_CANVAS_GAP))).rigid().center()
          let _ = handle.box(fn(hit : view::View) -> Unit {
            let is_hot = fn() -> Bool { st.dragging.get() || hit.pointed() }
            let _ = hit
            .over_at(view::Live::Is((Some(SP_0), Some(SP_0 - SP_12), Some(SP_0), Some(SP_0 - SP_4))))
            .center()
            .cursor(view::Live::Is(Some(view::Cursor::ResizeY)))
            .says(view::Live::Is(Some(view::said(view::Role::Group, label="Resize DevTools"))))
            .on_drag(
              fn(d : view::Drag) -> Unit {
                match d.kind {
                  view::DragIs::Down => {
                    drag_start_wy.v = d.wy
                    drag_start_h.v = st.height.untracked()
                    st.dragging.set(true)
                  }
                  view::DragIs::Moved => {
                    if st.dragging.untracked() {
                      let dy = d.wy - drag_start_wy.v
                      st.height.set(proto::devtools_height_from_drag(drag_start_h.v, dy))
                    }
                  }
                  view::DragIs::Up | view::DragIs::Off => st.dragging.set(false)
                }
              },
              captures=true,
            )
            hit.show(is_hot, fn(grab : view::View) -> Unit {
              let _ = grab
              .width(view::Live::Is(Some(SP_32)))
              .height(view::Live::Is(Some(SP_4)))
              .rigid()
              .points(view::Live::Is(false))
              .radius(view::Live::Is(SP_2))
              .ground(view::Live::By(fn() {
                if st.dragging.get() { lg::surface().accent } else { lg::surface().ink_tertiary }
              }))
            })
          })
        })

        let _ = drawer.box(fn(card : view::View) -> Unit {
          let _ = card
          .fill()
          .radius(view::Live::By(shell_canvas_radius))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() { lg::surface().card }))
          .edge(view::Live::By(fn() { (lg::hairline_w, if (props.dark)() { 0xFFFFFF14L } else { 0x0000000FL }) }))
          .shadow(view::Live::By(fn() { shell_card_shadow((props.dark)()) }))
          dt_build_inner_surface(card, props, is_narrow)
        })
      },
    )
  }

  // Floating: in-window overlay, one layer of glass around solid content.
  if !docked_only {
    parent.show(
      fn() { (props.open)() && (st.presentation.get() is DevToolsPresentation::Floating) },
      fn(float_wrap : view::View) -> Unit {
        // It floats over the page, never level with the frame: wide, a panel of at most 720pt at the trailing end,
        // clear of the sidebar, 24pt inside the page card's right and bottom edges; narrow (no sidebar), 16pt inside
        // the page card on every side. No edge runs beside the card's own outline or leaves slivers of the frame.
        let wide = fn() -> Bool { live_win_w() >= SHELL_SIDEBAR_BREAKPOINT }
        let side_inset = fn() -> Double { if wide() { SP_32 } else { SP_24 } }
        let float_max_w = fn() -> Double {
          let ww = live_win_w()
          let avail = if wide() { ww - SHELL_SIDEBAR_W_WIDE - SP_64 } else { ww - SP_24 * 2.0 }
          let cap = SP_160 * 4.0 + SP_80
          let w = if avail < cap { avail } else { cap }
          if w > SP_160 * 2.0 { w } else { SP_160 * 2.0 }
        }
        let _ = float_wrap
        .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
          let side = side_inset()
          (Some(side), None, Some(side), Some(side))
        }))
        .lies_along(view::Live::Is(view::Lies::End))
        .lines_up(view::Live::Is(Some(view::Along::End)))

        let _ = lg::liquid_dialog_shell_node(
          float_wrap,
          fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() -> Option[Double] { Some(float_max_w()) }))
            .max_width(view::Live::By(fn() -> Option[Double] { Some(float_max_w()) }))
            .height(view::Live::By(fn() -> Option[Double] {
              let wh = live_win_h()
              let desired = st.height.get() + SP_48
              // Stay below the title band (and bookmarks bar) with a margin above and below.
              let top_clear = (props.anchor_top)()
              let max_h = wh - top_clear - side_inset() - SP_16
              let floor_h = SP_160 + SP_64
              let cap = if max_h > floor_h { max_h } else { floor_h }
              let clamped = if desired > cap { cap } else { desired }
              Some(if clamped < floor_h { floor_h } else { clamped })
            }))
            .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            let _ = shell.box(fn(inner : view::View) -> Unit {
              let _ = inner
              .fill()
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(lg::concentric(SP_32, SP_8)))
              .ground(view::Live::By(fn() { lg::surface().card }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              dt_build_inner_surface(inner, props, is_narrow)
            })
          },
          radius=SP_32,
        )
      },
    )
  }
}
