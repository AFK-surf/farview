///| Farview Desktop Shell 2.0 — DevTools Panel (Docked Solid & In-Window Floating Liquid Glass).
///|
///| Architectural invariants:
///| 1. Two presentations sharing ONE `DevToolsPanelState` / `DevToolsPanelProps`:
///|    - `DevToolsPresentation::Docked`: part of the window (`bottom_dock`), 100% solid
///|      `lg::surface()` with draggable 6pt top resize handle (ZERO Liquid Glass).
///|    - `DevToolsPresentation::Floating`: in-window overlay with single-layer Liquid Glass
///|      outer frame (`lg::liquid_dialog_shell_node`) + solid `lg::surface()` inner content.
///|    Switching Docked <-> Floating preserves selected DOM node, collapsed tree state,
///|    Console filter & REPL draft (`ui::Field`), and Network category/search/selection!
///| 2. Preserves the 3 real tabs ONLY (`Elements`, `Console`, `Network`), inspected page
///|    title/URL + bound `owner_pane` indicator, Box Model & Computed Styles, Network
///|    category & search filters, Waterfall bars, Request Inspector + Copy as cURL,
///|    and Console REPL + Clear.
///| 3. Pure `packages/lg` overlays, vector icons only, 100% explicit `color_by`.

import "headless"
import "lg"
import "proto"
import "signals"
import "text"
import "ui"
import "view"

pub let DEVTOOLS_TAB_ELEMENTS : Int = 0
pub let DEVTOOLS_TAB_CONSOLE : Int = 1
pub let DEVTOOLS_TAB_NETWORK : Int = 2

let dt_disclosure_w : Double = 24.0
let dt_row_h : Double = 24.0
let dt_net_row_h : Double = 28.0

#derive(Eq)
pub enum DevToolsPresentation {
  Docked
  Floating
}

impl signals::Eq for DevToolsPresentation {
  fn eq(self : DevToolsPresentation, other : DevToolsPresentation) -> Bool {
    match (self, other) {
      (DevToolsPresentation::Docked, DevToolsPresentation::Docked) => true
      (DevToolsPresentation::Floating, DevToolsPresentation::Floating) => true
      _ => false
    }
  }
}

///| Shared reactive state preserved seamlessly across Docked <-> Floating switches.
pub struct DevToolsPanelState {
  pub presentation : signals::Signal[DevToolsPresentation]
  pub tab : signals::Signal[Int]
  pub height : signals::Signal[Double]
  pub dragging : signals::Signal[Bool]
  pub selected_path : signals::Signal[String]
  pub collapsed_paths : Map[String, Bool]
  pub collapse_rev : signals::Signal[Int]
  pub console_filter : signals::Signal[Int]
  pub repl_field : ui::Field
  pub net_filter : signals::Signal[String]
  pub net_query : signals::Signal[String]
  pub net_search_field : ui::Field
  pub net_selected_idx : signals::Signal[Int]
}

pub fn DevToolsPanelState::new(
  repl_field? : ui::Field,
  net_search_field? : ui::Field,
  presentation~ : DevToolsPresentation = DevToolsPresentation::Docked,
) -> DevToolsPanelState {
  DevToolsPanelState::{
    presentation: signals::signal(presentation),
    tab: signals::signal(DEVTOOLS_TAB_ELEMENTS),
    height: signals::signal(proto::DEVTOOLS_HEIGHT_DEFAULT),
    dragging: signals::signal(false),
    selected_path: signals::signal(""),
    collapsed_paths: Map::new(),
    collapse_rev: signals::signal(0),
    console_filter: signals::signal(0),
    repl_field: match repl_field {
      Some(f) => f
      None => ui::Field::new()
    },
    net_filter: signals::signal("all"),
    net_query: signals::signal(""),
    net_search_field: match net_search_field {
      Some(f) => f
      None => ui::Field::new()
    },
    net_selected_idx: signals::signal(-1),
  }
}

///| Strongly typed props for `build_devtools_panel`.
pub struct DevToolsPanelProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub owner_pane : () -> PaneId
  pub snapshot : () -> proto::DevToolsSnapshot
  pub rev : () -> Int
  pub state : DevToolsPanelState
  pub on_inspect : (String) -> Unit
  pub on_eval : (String) -> Unit
  pub on_clear_console : () -> Unit
  pub on_copy_curl : (String) -> Unit
  pub on_refresh : () -> Unit
  pub on_close : () -> Unit
  pub on_presentation_change : Option[(DevToolsPresentation) -> Unit]
  pub anchor_top : () -> Double
}

fn dt_accent_ink(dark : Bool) -> Int64 {
  if dark { 0x60A5FAFFL } else { 0x0055CCFFL }
}

fn dt_accent_soft(dark : Bool) -> Int64 {
  if dark { 0x1E3A5FFFL } else { 0xE8F1FFFFL }
}

fn dt_panel_bg(dark : Bool) -> Int64 {
  if dark { 0x16181FFFL } else { lg::surface().card }
}

fn dt_chrome_bg(dark : Bool) -> Int64 {
  if dark { 0x1C1F27FFL } else { lg::surface().grouped_bg }
}

fn dt_net_waterfall_color(kind : String, url : String, dark : Bool) -> Int64 {
  let cat = proto::devtools_net_category(kind, url)
  if dark {
    if cat == "doc" {
      0x60A5FAFFL
    } else if cat == "js" {
      0xFBBF24FFL
    } else if cat == "css" {
      0xA78BFAFFL
    } else if cat == "img" {
      0x34D399FFL
    } else if cat == "fetch" {
      0x22D3EEFFL
    } else {
      0x94A3B8FFL
    }
  } else if cat == "doc" {
    0x2563EBFFL
  } else if cat == "js" {
    0xD97706FFL
  } else if cat == "css" {
    0x7C3AEDFFL
  } else if cat == "img" {
    0x059669FFL
  } else if cat == "fetch" {
    0x0891B2FFL
  } else {
    0x64748BFFL
  }
}

fn dt_pane_label(pane : PaneId) -> String {
  match pane {
    PaneId::Primary => "Primary"
    PaneId::Secondary => "Secondary"
  }
}

fn dt_is_hidden_by_collapse(collapsed : Map[String, Bool], path : String) -> Bool {
  let mut i = 0
  while i < path.length() {
    if path.code_unit_at(i).to_int() == 0x2E {
      let anc = path.slice(0, i)
      if collapsed.get(anc).unwrap_or(false) {
        return true
      }
    }
    i += 1
  }
  false
}

fn dt_mono_run(s : String, color : Int64, weight~ : Int = 400) -> text::Run {
  text::Run::{ ..text::plain(s), mono: true, color, weight }
}

fn dt_dom_summary(nd : proto::DevToolsDomNode, collapsed : Bool) -> String {
  let mut s = "<" + nd.tag
  if nd.id_attr != "" {
    s = s + " id=\"" + nd.id_attr + "\""
  }
  if nd.class_attr != "" {
    let cls = if nd.class_attr.length() > 28 { nd.class_attr.slice(0, 28) + "..." } else { nd.class_attr }
    s = s + " class=\"" + cls + "\""
  }
  let mut ai = 0
  while ai < nd.attrs.length() && ai < 2 {
    let at = nd.attrs[ai]
    let v_show = if at.value.length() > 28 { at.value.slice(0, 28) + "..." } else { at.value }
    s = s + " " + at.name + "=\"" + v_show + "\""
    ai += 1
  }
  s = s + ">"
  if nd.text_preview != "" {
    let tp = if nd.text_preview.length() > 36 { nd.text_preview.slice(0, 36) + "..." } else { nd.text_preview }
    s = s + " " + tp
  }
  if nd.child_count == 0 {
    s = s + "</" + nd.tag + ">"
  } else if collapsed {
    s = s + " ... </" + nd.tag + ">"
  }
  s
}

fn dt_dom_node_runs(nd : proto::DevToolsDomNode, collapsed : Bool, dark : Bool, selected : Bool) -> Array[text::Run] {
  let runs : Array[text::Run] = []
  let c_punct = if dark { 0x94A3B8FFL } else { 0x64748BFFL }
  let c_tag = if selected {
    dt_accent_ink(dark)
  } else if dark {
    0xC084FCFFL
  } else {
    0x6D28D9FFL
  }
  let c_attr = if dark { 0xFBBF24FFL } else { 0xB45309FFL }
  let c_val = if dark { 0x34D399FFL } else { 0x047857FFL }
  let c_text = if dark { 0xE2E8F0FFL } else { 0x1E293BFFL }
  let c_muted = if dark { 0x94A3B8FFL } else { 0x64748BFFL }
  runs.push(dt_mono_run("<", c_punct))
  runs.push(dt_mono_run(nd.tag, c_tag, weight=500))
  if nd.id_attr != "" {
    runs.push(dt_mono_run(" id", c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + nd.id_attr + "\"", c_val))
  }
  if nd.class_attr != "" {
    let cls_show = if nd.class_attr.length() > 28 { nd.class_attr.slice(0, 28) + "..." } else { nd.class_attr }
    runs.push(dt_mono_run(" class", c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + cls_show + "\"", c_val))
  }
  let mut ai = 0
  while ai < nd.attrs.length() && ai < 2 {
    let at = nd.attrs[ai]
    let v_show = if at.value.length() > 28 { at.value.slice(0, 28) + "..." } else { at.value }
    runs.push(dt_mono_run(" " + at.name, c_attr))
    runs.push(dt_mono_run("=", c_punct))
    runs.push(dt_mono_run("\"" + v_show + "\"", c_val))
    ai += 1
  }
  runs.push(dt_mono_run(">", c_punct))
  if nd.text_preview != "" {
    let tp = if nd.text_preview.length() > 36 { nd.text_preview.slice(0, 36) + "..." } else { nd.text_preview }
    runs.push(dt_mono_run(" " + tp, c_text))
  }
  if nd.child_count == 0 {
    runs.push(dt_mono_run("</" + nd.tag + ">", c_muted))
  } else if collapsed {
    runs.push(dt_mono_run(" ... </" + nd.tag + ">", c_muted))
  }
  runs
}

fn dt_console_result_color_for(ce : proto::DevToolsConsoleEntry, dark : Bool) -> Int64 {
  let default_ink = if dark { 0xE2E8F0FFL } else { 0x1E293BFFL }
  if ce.level != "result" {
    return default_ink
  }
  let src = ce.source.trim()
  if src == "string" {
    if dark { 0x34D399FFL } else { 0x047857FFL }
  } else if src == "number" || src == "boolean" {
    if dark { 0x60A5FAFFL } else { 0x1D4ED8FFL }
  } else if src == "undefined" || src == "null" {
    if dark { 0x94A3B8FFL } else { 0x64748BFFL }
  } else if src == "" {
    dt_console_result_color(ce.text, dark)
  } else {
    default_ink
  }
}

fn dt_console_result_color(txt : String, dark : Bool) -> Int64 {
  let default_ink = if dark { 0xE2E8F0FFL } else { 0x1E293BFFL }
  let s = txt.trim()
  if s == "" {
    return default_ink
  }
  if (s.starts_with("\"") && s.ends_with("\"")) || (s.starts_with("'") && s.ends_with("'")) {
    if dark { 0x34D399FFL } else { 0x047857FFL }
  } else if s == "true" || s == "false" || s == "null" || s == "undefined" || s == "NaN" {
    if dark { 0xC084FCFFL } else { 0x6D28D9FFL }
  } else {
    let c0 = s.code_unit_at(0).to_int()
    if (c0 >= 48 && c0 <= 57) || (c0 == 45 && s.length() > 1 && s.code_unit_at(1).to_int() >= 48 && s.code_unit_at(1).to_int() <= 57) {
      if dark { 0x60A5FAFFL } else { 0x1D4ED8FFL }
    } else {
      default_ink
    }
  }
}

fn dt_console_matches(filter : Int, level : String) -> Bool {
  if filter == 0 {
    true
  } else if filter == 1 {
    level == "log" || level == "info" || level == "input" || level == "result"
  } else if filter == 2 {
    level == "warn"
  } else {
    level == "error"
  }
}

fn dt_net_status_palette(status : Int, dark : Bool) -> (Int64, Int64) {
  if status >= 400 {
    if dark { (0x3B1D1EFFL, 0xFCA5A5FFL) } else { (0xFEE2E2FFL, 0x991B1BFFL) }
  } else if status >= 300 {
    if dark { (0x382A12FFL, 0xFCD34DFFL) } else { (0xFEF3C7FFL, 0x92400EFFL) }
  } else if dark {
    (0x102F24FFL, 0x6EE7B7FFL)
  } else {
    (0xDCFCE7FFL, 0x065F46FFL)
  }
}

fn dt_net_kind_palette(kind : String, dark : Bool) -> (Int64, Int64, String) {
  let cat = proto::devtools_net_category(kind, "")
  if dark {
    if cat == "doc" {
      (0x1E3A5FFFL, 0x93C5FDFFL, "doc")
    } else if cat == "js" {
      (0x3B2D14FFL, 0xFCD34DFFL, "js")
    } else if cat == "css" {
      (0x2E1F4BFFL, 0xD8B4FEFFL, "css")
    } else if cat == "img" {
      (0x113227FFL, 0x6EE7B7FFL, "img")
    } else if cat == "fetch" {
      (0x10333EFFL, 0x67E8F9FFL, "fetch")
    } else {
      (0x262B38FFL, 0xCBD5E1FFL, if kind != "" { kind } else { "other" })
    }
  } else if cat == "doc" {
    (0xDBEAFEFFL, 0x1E40AFFFL, "doc")
  } else if cat == "js" {
    (0xFEF3C7FFL, 0x92400EFFL, "js")
  } else if cat == "css" {
    (0xEDE9FEFFL, 0x5B21B6FFL, "css")
  } else if cat == "img" {
    (0xD1FAE5FFL, 0x065F46FFL, "img")
  } else if cat == "fetch" {
    (0xCFFAFEFFL, 0x155E75FFL, "fetch")
  } else {
    (0xF1F5F9FFL, 0x334155FFL, if kind != "" { kind } else { "other" })
  }
}

fn dt_header_icon_btn(
  parent : view::View,
  label : () -> String,
  icon_name : () -> String,
  on_press : () -> Unit,
  danger~ : Bool = false,
) -> Unit {
  let _ = lg::liquid_button_node(
    parent,
    label,
    on_press,
    content=fn(inner : view::View) -> Unit {
      let _ = shell_icon(
        inner,
        icon_name(),
        size=14.0,
        color_by=fn() { if danger { lg::surface().danger } else { lg::surface().ink } },
      )
    },
    flat=true,
    ghost=true,
    height=30.0,
    pad_x=9.0,
  )
}

fn dt_build_elements_tab(parent : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state
  let _ = parent
  .row(view::Live::By(fn() { !is_narrow() }))
  .fill()

  // Left: DOM Tree scroller
  let _ = parent.box(fn(tree_pane : view::View) -> Unit {
    let _ = tree_pane.fill().ground(view::Live::By(fn() { dt_panel_bg((props.dark)()) }))
    let _ = ui::scroll_box(tree_pane, fn(tree_list : view::View) -> Unit {
      let _ = tree_list.padding(view::Live::Is((6.0, 6.0, 6.0, 6.0))).gap(view::Live::Is(2.0))
      tree_list.switch_by(
        fn() -> Int {
          ((props.rev)() * 128 + st.collapse_rev.get()) * 2 + (if (props.dark)() { 1 } else { 0 })
        },
        fn(nodes_box : view::View, key : Int) -> Unit {
          let dark = (key % 2) == 1
          let _ = nodes_box.gap(view::Live::Is(2.0))
          let nodes = signals::untracked(props.snapshot).nodes
          if nodes.length() == 0 {
            let _ = nodes_box.box(fn(emp : view::View) -> Unit {
              let _ = emp.padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
              <ui::Text in={emp} size={12.0} color_by=>{lg::surface().ink_secondary} text="Inspecting document DOM..." />
            })
          }
          let mut i = 0
          while i < nodes.length() {
            let nd = nodes[i]
            if !dt_is_hidden_by_collapse(st.collapsed_paths, nd.path) {
              let npath = nd.path
              let is_collapsed = st.collapsed_paths.get(npath).unwrap_or(false)
              let is_sel = fn() -> Bool { st.selected_path.get() == npath }
              let indent = 6.0 + nd.depth.to_double() * 14.0
              let summary = dt_dom_summary(nd, is_collapsed)
              let _ = nodes_box.box(fn(row_outer : view::View) -> Unit {
                let _ = row_outer
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .min_height(view::Live::Is(Some(dt_row_h)))
                .rigid()
                .radius(view::Live::Is(5.0))
                .clips(view::Live::Is(true))
                .ground(view::Live::By(fn() -> Int64 {
                  if is_sel() { dt_accent_soft(dark) } else { 0x00000000L }
                }))

                // Left selection bar
                let _ = row_outer.box(fn(sbar : view::View) -> Unit {
                  let _ = sbar
                  .width(view::Live::Is(Some(2.0)))
                  .height(view::Live::Is(Some(16.0)))
                  .rigid()
                  .radius(view::Live::Is(1.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_sel() { dt_accent_ink(dark) } else { 0x00000000L }
                  }))
                })

                // Indent spacer
                let _ = row_outer.box(fn(ind : view::View) -> Unit {
                  let _ = ind.width(view::Live::Is(Some(indent))).rigid()
                })

                // Disclosure chevron button & leaf placeholder share EXACT `dt_disclosure_w`
                if nd.child_count > 0 {
                  let _ = headless::button(
                    row_outer,
                    fn() { if is_collapsed { "Expand " + nd.tag } else { "Collapse " + nd.tag } },
                    fn(_v : view::View) -> Unit {
                      st.collapsed_paths.set(npath, !is_collapsed)
                      st.collapse_rev.set(st.collapse_rev.untracked() + 1)
                    },
                    fn(chb : view::View, cbtn : headless::Button) -> Unit {
                      let _ = chb
                      .width(view::Live::Is(Some(dt_disclosure_w)))
                      .height(view::Live::Is(Some(dt_row_h)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(4.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        if cbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
                      }))
                      let _ = shell_icon(
                        chb,
                        if is_collapsed { ICON_CHEVRON_RIGHT } else { ICON_CHEVRON_DOWN },
                        size=11.0,
                        color_by=fn() { lg::surface().ink_secondary },
                      )
                    },
                  )
                } else {
                  let _ = row_outer.box(fn(pad : view::View) -> Unit {
                    let _ = pad.width(view::Live::Is(Some(dt_disclosure_w))).rigid()
                  })
                }

                // Selectable DOM node button (syntax-highlighted monospace runs)
                let _ = headless::button(
                  row_outer,
                  fn() { "Inspect <" + nd.tag + ">" },
                  fn(_v : view::View) -> Unit {
                    st.selected_path.set(npath)
                    (props.on_inspect)(npath)
                  },
                  fn(nb : view::View, nbtn : headless::Button) -> Unit {
                    let _ = nb
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .min_height(view::Live::Is(Some(dt_row_h)))
                    .padding(view::Live::Is((2.0, 0.0, 8.0, 0.0)))
                    .clips(view::Live::Is(true))
                    .ground(view::Live::By(fn() -> Int64 {
                      if !is_sel() && nbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
                    }))
                    let _ = nb.box(fn(tv : view::View) -> Unit {
                      let _ = tv
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .cut()
                      .allow_ellipsis(view::Live::Is(true))
                      .words_runs(
                        view::Live::By(fn() { dt_dom_node_runs(nd, is_collapsed, dark, is_sel()) }),
                        ink=lg::surface().ink,
                        look=view::WordsLook::{ ..view::words_plain, size: 11.5, wrap: false },
                      )
                    })
                  },
                )
              })
            }
            i += 1
          }
        },
      )
    })
  })

  // Hairline divider
  let _ = parent.box(fn(sep : view::View) -> Unit {
    let _ = sep
    .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(lg::hairline_w) } }))
    .height(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(lg::hairline_w) } else { None } }))
    .rigid()
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })

  // Right (or bottom on narrow): Box Model & Computed Styles Inspector
  let _ = parent.box(fn(insp_pane : view::View) -> Unit {
    let _ = insp_pane
    .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(280.0) } }))
    .height(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(140.0) } else { None } }))
    .rigid()
    .min_height(view::Live::Is(Some(0.0)))
    .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))

    let _ = ui::scroll_box(insp_pane, fn(insp_body : view::View) -> Unit {
      let _ = insp_body.padding(view::Live::Is((12.0, 10.0, 12.0, 14.0))).gap(view::Live::Is(8.0))
      insp_body.switch_by(
        fn() -> Int {
          let _ = st.selected_path.get()
          (props.rev)() * 2 + (if (props.dark)() { 1 } else { 0 })
        },
        fn(ic : view::View, key : Int) -> Unit {
          let dark = (key % 2) == 1
          let snap = signals::untracked(props.snapshot)
          let bm = snap.box_model
          let sel_p = st.selected_path.untracked()
          let target_p = if sel_p != "" { sel_p } else { snap.selected_path }
          let mut sel_label = ""
          for nd in snap.nodes {
            if nd.path == target_p {
              sel_label = nd.tag
              if nd.id_attr != "" {
                sel_label = sel_label + "#" + nd.id_attr
              }
              break
            }
          }
          let _ = ic.gap(view::Live::Is(8.0))
          let _ = ic.box(fn(bhdr : view::View) -> Unit {
            let _ = bhdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between)).gap(view::Live::Is(6.0))
            <ui::Text in={bhdr} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="BOX MODEL" />
            if sel_label != "" {
              let _ = bhdr.box(fn(sp : view::View) -> Unit {
                let sc = dt_accent_ink(dark)
                let _ = sp.padding(view::Live::Is((6.0, 2.0, 6.0, 2.0))).radius(view::Live::Is(4.0)).ground(view::Live::Is(dt_accent_soft(dark)))
                let _ = sp.box(fn(sv : view::View) -> Unit {
                  let _ = sv.words_runs(
                    view::Live::Is([dt_mono_run(sel_label, sc, weight=600)]),
                    ink=sc,
                    look=view::WordsLook::{ ..view::words_plain, size: 10.5, wrap: false },
                  )
                })
              })
            }
          })

          // Concentric 4-sided Box Model Diagram (margin -> padding -> content W x H, monospace values)
          let margin_bg = if dark { 0x332815FFL } else { 0xFEF3C7FFL }
          let margin_ink = if dark { 0xFCD34DFFL } else { 0x78350FFFL }
          let pad_bg = if dark { 0x112E24FFL } else { 0xDCFCE7FFL }
          let pad_ink = if dark { 0x6EE7B7FFL } else { 0x065F46FFL }
          let content_bg = if dark { 0x1B2B4BFFL } else { 0xDBEAFEFFL }
          let content_ink = if dark { 0x93C5FDFFL } else { 0x1E3A8AFFL }
          let dim_txt = proto::format_devtools_px(bm.width) + " x " + proto::format_devtools_px(bm.height)
          let mono_val = fn(p : view::View, txt : String, col : Int64, sz : Double, wt : Int) -> Unit {
            let _ = p.box(fn(mv : view::View) -> Unit {
              let _ = mv.words_runs(
                view::Live::Is([dt_mono_run(txt, col, weight=wt)]),
                ink=col,
                look=view::WordsLook::{ ..view::words_plain, size: sz, wrap: false },
              )
            })
          }

          let _ = ic.box(fn(m_box : view::View) -> Unit {
            let _ = m_box.padding(view::Live::Is((8.0, 5.0, 8.0, 5.0))).gap(view::Live::Is(3.0)).radius(view::Live::Is(8.0)).ground(view::Live::Is(margin_bg))
            // Margin top row: label left + top value centered
            let _ = m_box.box(fn(mt : view::View) -> Unit {
              let _ = mt.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between))
              <ui::Text in={mt} size={9.5} weight={500} color_by=>{margin_ink} text="margin" />
              mono_val(mt, proto::format_devtools_px(bm.margin_top), margin_ink, 10.0, 600)
              let _ = mt.box(fn(sp : view::View) -> Unit { let _ = sp.width(view::Live::Is(Some(34.0))).rigid() })
            })
            // Margin middle row: left + padding box + right
            let _ = m_box.box(fn(mmid : view::View) -> Unit {
              let _ = mmid.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
              let _ = mmid.box(fn(ml : view::View) -> Unit {
                let _ = ml.width(view::Live::Is(Some(22.0))).rigid().center()
                mono_val(ml, proto::format_devtools_px(bm.margin_left), margin_ink, 10.0, 400)
              })
              let _ = mmid.box(fn(p_box : view::View) -> Unit {
                let _ = p_box.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).padding(view::Live::Is((7.0, 5.0, 7.0, 5.0))).gap(view::Live::Is(3.0)).radius(view::Live::Is(6.0)).ground(view::Live::Is(pad_bg))
                let _ = p_box.box(fn(pt : view::View) -> Unit {
                  let _ = pt.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between))
                  <ui::Text in={pt} size={9.5} weight={500} color_by=>{pad_ink} text="padding" />
                  mono_val(pt, proto::format_devtools_px(bm.pad_top), pad_ink, 10.0, 600)
                  let _ = pt.box(fn(sp : view::View) -> Unit { let _ = sp.width(view::Live::Is(Some(36.0))).rigid() })
                })
                let _ = p_box.box(fn(pmid : view::View) -> Unit {
                  let _ = pmid.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(5.0))
                  let _ = pmid.box(fn(pl : view::View) -> Unit {
                    let _ = pl.width(view::Live::Is(Some(20.0))).rigid().center()
                    mono_val(pl, proto::format_devtools_px(bm.pad_left), pad_ink, 10.0, 400)
                  })
                  let _ = pmid.box(fn(c_box : view::View) -> Unit {
                    let _ = c_box.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).height(view::Live::Is(Some(24.0))).center().radius(view::Live::Is(4.0)).ground(view::Live::Is(content_bg))
                    mono_val(c_box, dim_txt, content_ink, 10.5, 600)
                  })
                  let _ = pmid.box(fn(pr : view::View) -> Unit {
                    let _ = pr.width(view::Live::Is(Some(20.0))).rigid().center()
                    mono_val(pr, proto::format_devtools_px(bm.pad_right), pad_ink, 10.0, 400)
                  })
                })
                let _ = p_box.box(fn(pb : view::View) -> Unit {
                  let _ = pb.center()
                  mono_val(pb, proto::format_devtools_px(bm.pad_bottom), pad_ink, 10.0, 400)
                })
              })
              let _ = mmid.box(fn(mr : view::View) -> Unit {
                let _ = mr.width(view::Live::Is(Some(22.0))).rigid().center()
                mono_val(mr, proto::format_devtools_px(bm.margin_right), margin_ink, 10.0, 400)
              })
            })
            // Margin bottom row: centered
            let _ = m_box.box(fn(mb : view::View) -> Unit {
              let _ = mb.center()
              mono_val(mb, proto::format_devtools_px(bm.margin_bottom), margin_ink, 10.0, 400)
            })
          })

          // Optional non-zero border readout row (monospace)
          if bm.border_top > 0.0 || bm.border_right > 0.0 || bm.border_bottom > 0.0 || bm.border_left > 0.0 {
            let b_str = "border: " +
            proto::format_devtools_px(bm.border_top) +
            " " +
            proto::format_devtools_px(bm.border_right) +
            " " +
            proto::format_devtools_px(bm.border_bottom) +
            " " +
            proto::format_devtools_px(bm.border_left) +
            " px"
            let _ = ic.box(fn(br : view::View) -> Unit {
              let b_col = if dark { 0x94A3B8FFL } else { 0x475569FFL }
              let _ = br.words_runs(
                view::Live::Is([dt_mono_run(b_str, b_col)]),
                ink=b_col,
                look=view::WordsLook::{ ..view::words_plain, size: 10.5, wrap: false },
              )
            })
          }

          // Computed styles list (monospace property name & value)
          <ui::Text in={ic} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="COMPUTED STYLES" />
          let _ = ic.box(fn(slist : view::View) -> Unit {
            let _ = slist.gap(view::Live::Is(4.0))
            let val_col = if dark { 0xE2E8F0FFL } else { 0x1E293BFFL }
            for sp in snap.styles {
              let swatch = proto::parse_devtools_color_swatch(sp.color_hex)
              let _ = slist.box(fn(srow : view::View) -> Unit {
                let _ = srow.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                let _ = srow.box(fn(pn : view::View) -> Unit {
                  let _ = pn.width(view::Live::Is(Some(108.0))).rigid().cut().allow_ellipsis(view::Live::Is(true)).words_runs(
                    view::Live::Is([dt_mono_run(sp.name, dt_accent_ink(dark), weight=500)]),
                    ink=dt_accent_ink(dark),
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, wrap: false },
                  )
                })
                match swatch {
                  Some(col) => {
                    let _ = srow.box(fn(sw : view::View) -> Unit {
                      let _ = sw.width(view::Live::Is(Some(10.0))).height(view::Live::Is(Some(10.0))).rigid().radius(view::Live::Is(2.5)).ground(view::Live::Is(col)).edge(view::Live::By(fn() { (1.0, lg::surface().separator_strong) }))
                    })
                  }
                  None => ()
                }
                let _ = srow.box(fn(pv : view::View) -> Unit {
                  let _ = pv.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).words_runs(
                    view::Live::Is([dt_mono_run(sp.value, val_col)]),
                    ink=val_col,
                    look=view::WordsLook::{ ..view::words_plain, size: 11.0, line: 15.0, wrap: true },
                  )
                })
              })
            }
          })
        },
      )
    })
  })
}

fn dt_build_console_tab(parent : view::View, props : DevToolsPanelProps) -> Unit {
  let st = props.state
  let _ = parent.fill()

  // Filter sub-bar
  let _ = parent.box(fn(fbar : view::View) -> Unit {
    let _ = fbar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .padding(view::Live::Is((10.0, 4.0, 10.0, 4.0)))
    .gap(view::Live::Is(4.0))
    .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))

    let count_for = fn(fidx : Int) -> Int {
      let _ = (props.rev)()
      let mut c = 0
      for ce in (props.snapshot)().console_entries {
        if dt_console_matches(fidx, ce.level) {
          c += 1
        }
      }
      c
    }
    let filter_pill = fn(fidx : Int, lbl : String) -> Unit {
      let is_on = fn() -> Bool { st.console_filter.get() == fidx }
      let _ = headless::button(
        fbar,
        fn() { "Filter Console " + lbl },
        fn(_v : view::View) -> Unit { st.console_filter.set(fidx) },
        fn(fb : view::View, fbtn : headless::Button) -> Unit {
          let _ = fb
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .min_height(view::Live::Is(Some(36.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .radius(view::Live::Is(lg::r_chip))
          .ground(view::Live::By(fn() -> Int64 {
            if is_on() { lg::surface().card } else if fbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            if is_on() { (lg::hairline_w, lg::surface().separator_strong) } else { (0.0, 0x00000000L) }
          }))
          <ui::Text
            in={fb}
            size={11.5}
            weight={500}
            color_by=>{if is_on() { lg::surface().ink } else { lg::surface().ink_secondary }}
            text_by=>{
              let c = count_for(fidx)
              if c > 0 { lbl + " (" + c.to_string() + ")" } else { lbl }
            }
          />
        },
      )
    }
    filter_pill(0, "All")
    filter_pill(1, "Log")
    filter_pill(2, "Warn")
    filter_pill(3, "Error")

    let _ = fbar.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

    let _ = headless::button(
      fbar,
      fn() { "Clear Console Output" },
      fn(_v : view::View) -> Unit { (props.on_clear_console)() },
      fn(cb : view::View, cbtn : headless::Button) -> Unit {
        let _ = cb
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .min_height(view::Live::Is(Some(36.0)))
        .rigid()
        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
        .gap(view::Live::Is(5.0))
        .radius(view::Live::Is(lg::r_chip))
        .ground(view::Live::By(fn() -> Int64 {
          if cbtn.pressed() { lg::surface().row_selected } else if cbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
        }))
        let _ = shell_icon(cb, "eraser", size=13.0, color_by=fn() { lg::surface().ink_secondary })
        <ui::Text in={cb} size={11.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Clear" />
      },
    )
  })

  let _ = parent.box(fn(csep : view::View) -> Unit {
    let _ = csep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
  })

  // Scrollable console log stream
  let _ = parent.box(fn(log_pane : view::View) -> Unit {
    let _ = log_pane.fill().ground(view::Live::By(fn() { dt_panel_bg((props.dark)()) }))
    let _ = ui::scroll_box(log_pane, fn(log_list : view::View) -> Unit {
      log_list.switch_by(
        fn() -> Int { ((props.rev)() * 16 + st.console_filter.get()) * 2 + (if (props.dark)() { 1 } else { 0 }) },
        fn(entries_box : view::View, key : Int) -> Unit {
          let dark = (key % 2) == 1
          let filt = st.console_filter.untracked()
          let entries = signals::untracked(props.snapshot).console_entries
          let filtered : Array[proto::DevToolsConsoleEntry] = []
          for ce in entries {
            if dt_console_matches(filt, ce.level) {
              filtered.push(ce)
            }
          }
          if filtered.length() == 0 {
            let _ = entries_box.box(fn(emp : view::View) -> Unit {
              let _ = emp.padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
              <ui::Text in={emp} size={12.0} wrap color_by=>{lg::surface().ink_secondary} text="No console messages. Type a JavaScript expression below and press Enter." />
            })
          }
          let mut i = 0
          while i < filtered.length() {
            let ce = filtered[i]
            let (row_bg, icon_name, icon_col, text_col) = if ce.level == "warn" {
              if dark { (0x2E2411FFL, "alert-triangle", 0xFCD34DFFL, 0xFDE68AFFL) } else { (0xFFFBEBFFL, "alert-triangle", 0xB45309FFL, 0x78350FFFL) }
            } else if ce.level == "error" {
              if dark { (0x331B20FFL, "alert-circle", 0xFCA5A5FFL, 0xFECACAFFL) } else { (0xFEF2F2FFL, "alert-circle", 0xB91C1CFFL, 0x7F1D1DFFL) }
            } else if ce.level == "input" {
              (lg::surface().card_secondary, ICON_CHEVRON_RIGHT, dt_accent_ink(dark), dt_accent_ink(dark))
            } else if ce.level == "result" {
              (dt_panel_bg(dark), ICON_CHEVRON_RIGHT, lg::surface().ink_secondary, dt_console_result_color_for(ce, dark))
            } else {
              (dt_panel_bg(dark), "info", lg::surface().ink_secondary, dt_console_result_color_for(ce, dark))
            }
            let _ = entries_box.box(fn(crow : view::View) -> Unit {
              let _ = crow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .padding(view::Live::Is((10.0, 5.0, 12.0, 5.0)))
              .gap(view::Live::Is(8.0))
              .ground(view::Live::Is(row_bg))
              let _ = shell_icon(crow, icon_name, size=13.0, color_by=fn() { icon_col })
              let _ = crow.box(fn(msg : view::View) -> Unit {
                let _ = msg.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).words_runs(
                  view::Live::Is([dt_mono_run(ce.text, text_col)]),
                  ink=text_col,
                  look=view::WordsLook::{ ..view::words_plain, size: 12.0, line: 16.5, wrap: true },
                )
              })
              if ce.source != "" {
                let _ = crow.box(fn(src : view::View) -> Unit {
                  let _ = src.rigid().padding(view::Live::Is((6.0, 2.0, 6.0, 2.0))).radius(view::Live::Is(4.0)).ground(view::Live::By(fn() { lg::surface().card_secondary }))
                  <ui::Text in={src} size={10.5} color_by=>{lg::surface().ink_secondary} text={ce.source} />
                })
              }
            })
            i += 1
          }
        },
      )
    })
  })

  // Bottom REPL input bar reusing `st.repl_field`
  let _ = parent.box(fn(rsep : view::View) -> Unit {
    let _ = rsep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
  })
  let _ = parent.box(fn(rbar : view::View) -> Unit {
    let _ = rbar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
    .gap(view::Live::Is(8.0))
    .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))

    let submit_repl = fn(raw : String) -> Unit {
      let trimmed = raw.trim()
      if trimmed != "" {
        (props.on_eval)(trimmed)
        st.repl_field.set("")
      }
    }

    let _ = rbar.box(fn(fw : view::View) -> Unit {
      let _ = fw
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      .height(view::Live::Is(Some(36.0)))
      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
      .gap(view::Live::Is(6.0))
      .radius(view::Live::Is(6.0))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() { lg::surface().card }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if st.repl_field.focused() { (1.5, dt_accent_ink((props.dark)())) } else { (1.0, lg::surface().separator_strong) }
      }))
      let _ = shell_icon(fw, ICON_CHEVRON_RIGHT, size=14.0, color_by=fn() { dt_accent_ink((props.dark)()) })
      let _ = fw.box(fn(inp : view::View) -> Unit {
        let _ = inp.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
        inp.reacts(fn() { (props.dark)() }, fn(_d : Bool) -> Unit {
          st.repl_field.color = lg::surface().ink
          st.repl_field.ph_color = lg::surface().ink_secondary
          st.repl_field.caret_color = dt_accent_ink((props.dark)())
        })
        let typed = ui::field(
          inp,
          st.repl_field,
          placeholder="Evaluate JavaScript in page context...",
          font_size=12.5,
          max_lines=1,
          enter_sends=true,
          label="Console REPL Input",
          color=lg::surface().ink,
          placeholder_color=lg::surface().ink_secondary,
          caret_color=dt_accent_ink((props.dark)()),
          submitted=submit_repl,
        )
        let _ = typed
        .min_height(view::Live::Is(Some(36.0)))
        .drawn_off(view::Live::Is((0.0, 9.0)))
        .ink(view::Live::By(fn() {
          if st.repl_field.text().length() > 0 || st.repl_field.composing() { lg::surface().ink } else { lg::surface().ink_secondary }
        }))
        .on_key(fn(k : view::Key) -> Bool {
          if k.code == proto::KEY_ESCAPE && st.repl_field.composing() {
            st.repl_field.compose("")
            true
          } else {
            false
          }
        })
      })
    })

    let _ = headless::button(
      rbar,
      fn() { "Run Console Expression" },
      fn(_v : view::View) -> Unit { submit_repl(st.repl_field.text()) },
      fn(rb : view::View, rbtn : headless::Button) -> Unit {
        let _ = rb
        .min_height(view::Live::Is(Some(36.0)))
        .rigid()
        .center()
        .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::By(fn() -> Int64 {
          if rbtn.pressed() { lg::surface().row_selected } else if rbtn.hovered() { lg::surface().row_hover } else { lg::surface().card }
        }))
        .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
        <ui::Text in={rb} size={12.0} weight={500} color_by=>{lg::surface().ink} text="Run" />
      },
    )
  })
}

fn dt_build_network_tab(parent : view::View, props : DevToolsPanelProps, is_narrow : () -> Bool) -> Unit {
  let st = props.state
  let _ = parent.fill()

  // 1. Network Filter & Search Sub-Bar
  let _ = parent.box(fn(nfbar : view::View) -> Unit {
    let _ = nfbar
    .row(view::Live::Is(true))
    .wraps(view::Live::Is(Some(4.0)))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .padding(view::Live::Is((10.0, 4.0, 10.0, 4.0)))
    .gap(view::Live::Is(4.0))
    .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))

    let net_pill = fn(cat_id : String, lbl : String) -> Unit {
      let is_on = fn() -> Bool { st.net_filter.get() == cat_id }
      let _ = headless::button(
        nfbar,
        fn() { "Filter Network " + lbl },
        fn(_v : view::View) -> Unit { st.net_filter.set(cat_id) },
        fn(fb : view::View, fbtn : headless::Button) -> Unit {
          let _ = fb
          .min_height(view::Live::Is(Some(36.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
          .radius(view::Live::Is(lg::r_chip))
          .ground(view::Live::By(fn() -> Int64 {
            if is_on() { lg::surface().card } else if fbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            if is_on() { (lg::hairline_w, lg::surface().separator_strong) } else { (0.0, 0x00000000L) }
          }))
          <ui::Text
            in={fb}
            size={11.5}
            weight={500}
            color_by=>{if is_on() { lg::surface().ink } else { lg::surface().ink_secondary }}
            text={lbl}
          />
        },
      )
    }
    net_pill("all", "All")
    net_pill("doc", "Doc")
    net_pill("js", "JS")
    net_pill("css", "CSS")
    net_pill("img", "Img")
    net_pill("fetch", "Fetch")

    let _ = nfbar.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

    // Reused `st.net_search_field`
    let _ = nfbar.box(fn(sbox : view::View) -> Unit {
      let _ = sbox.width(view::Live::Is(Some(196.0))).rigid()
      let _ = lg::liquid_text_field_node(
        sbox,
        st.net_search_field,
        placeholder="Filter URL, type, status...",
        label=fn() { "Filter Network Requests" },
        show_label=false,
        flat=true,
        height_by=fn() { 32.0 },
        lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
          let _ = shell_icon(ic, ICON_SEARCH, size=13.0, color_by=ink)
        },
        edited=fn(q : String) -> Unit { st.net_query.set(q) },
        submitted=fn(q : String) -> Unit { st.net_query.set(q) },
      )
    })
  })

  let _ = parent.box(fn(nfsep : view::View) -> Unit {
    let _ = nfsep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
  })

  // 2. Main Split: Request Table + Optional Request Inspector
  let _ = parent.box(fn(net_split : view::View) -> Unit {
    let _ = net_split
    .row(view::Live::By(fn() { !is_narrow() }))
    .fill()
    .clips(view::Live::Is(true))

    // Left: Request table (column header + scrollable rows)
    let _ = net_split.box(fn(tbl_col : view::View) -> Unit {
      let _ = tbl_col.fill().ground(view::Live::By(fn() { dt_panel_bg((props.dark)()) }))
      // Column Header Row: Name | Status | Type | Size | Waterfall
      let _ = tbl_col.box(fn(thdr : view::View) -> Unit {
        let _ = thdr
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .height(view::Live::Is(Some(24.0)))
        .rigid()
        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
        .gap(view::Live::Is(8.0))
        .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))
        let _ = thdr.box(fn(cn : view::View) -> Unit {
          let _ = cn.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
          <ui::Text in={cn} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="Name" />
        })
        let _ = thdr.box(fn(cs : view::View) -> Unit {
          let _ = cs.width(view::Live::Is(Some(42.0))).rigid()
          <ui::Text in={cs} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="Status" />
        })
        let _ = thdr.box(fn(ct : view::View) -> Unit {
          let _ = ct.width(view::Live::Is(Some(46.0))).rigid()
          <ui::Text in={ct} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="Type" />
        })
        let _ = thdr.box(fn(cz : view::View) -> Unit {
          let _ = cz.width(view::Live::Is(Some(58.0))).rigid()
          <ui::Text in={cz} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="Size" />
        })
        let _ = thdr.box(fn(cw : view::View) -> Unit {
          let _ = cw.width(view::Live::Is(Some(114.0))).rigid()
          <ui::Text in={cw} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="Waterfall" />
        })
      })
      let _ = tbl_col.box(fn(thsep : view::View) -> Unit {
        let _ = thsep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
      })
      let _ = ui::scroll_box(tbl_col, fn(net_list : view::View) -> Unit {
        net_list.switch_by(
          fn() -> Int {
            let cat_s = st.net_filter.get()
            let cat_code = if cat_s == "all" {
              0
            } else if cat_s == "doc" {
              1
            } else if cat_s == "js" {
              2
            } else if cat_s == "css" {
              3
            } else if cat_s == "img" {
              4
            } else if cat_s == "fetch" {
              5
            } else {
              6
            }
            let live_q = st.net_search_field.text()
            let eff_q = if live_q != "" { live_q } else { st.net_query.get() }
            let mut qh = 0
            let qb = eff_q.to_bytes()
            let mut qi = 0
            while qi < qb.length() {
              qh = (qh * 31 + (qb[qi].to_int() & 0xFF)) & 0x3FFF
              qi += 1
            }
            ((((props.rev)() & 0xFF) * 8 + cat_code) * 16384 + qh) * 2 + (if (props.dark)() { 1 } else { 0 })
          },
          fn(rows_box : view::View, key : Int) -> Unit {
            let dark = (key % 2) == 1
            let entries = signals::untracked(props.snapshot).network_entries
            let cat = st.net_filter.untracked()
            let live_q = st.net_search_field.text()
            let q = if live_q != "" { live_q } else { st.net_query.untracked() }
            let mut max_ms = 1
            for e in entries {
              if e.duration_ms > max_ms {
                max_ms = e.duration_ms
              }
            }
            let matched : Array[Int] = []
            let mut fi = 0
            while fi < entries.length() {
              if proto::devtools_net_matches_filter(entries[fi], cat, q) {
                matched.push(fi)
              }
              fi += 1
            }
            if matched.length() == 0 {
              let _ = rows_box.box(fn(emp : view::View) -> Unit {
                let _ = emp.padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                <ui::Text in={emp} size={12.0} color_by=>{lg::surface().ink_secondary} text="No network requests match the current filter." />
              })
            }
            let mut ri = 0
            while ri < matched.length() {
              let idx = matched[ri]
              let ne = entries[idx]
              let (st_bg, st_fg) = dt_net_status_palette(ne.status, dark)
              let (pill_bg, pill_fg, pill_lbl) = dt_net_kind_palette(ne.kind, dark)
              let wf_ratio = proto::devtools_net_waterfall_ratio(ne.duration_ms, max_ms)
              let is_sel = fn() -> Bool { st.net_selected_idx.get() == idx }
              let _ = headless::button(
                rows_box,
                fn() { "Inspect request " + ne.name },
                fn(_v : view::View) -> Unit {
                  if st.net_selected_idx.untracked() == idx {
                    st.net_selected_idx.set(-1)
                  } else {
                    st.net_selected_idx.set(idx)
                  }
                },
                fn(nrow : view::View, nbtn : headless::Button) -> Unit {
                  let _ = nrow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .min_height(view::Live::Is(Some(dt_net_row_h)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(8.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_sel() { dt_accent_soft(dark) } else if nbtn.hovered() { lg::surface().row_hover } else { dt_panel_bg(dark) }
                  }))
                  let _ = nrow.box(fn(nm : view::View) -> Unit {
                    let _ = nm.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
                    <ui::Text in={nm} size={12.0} weight={500} color_by=>{lg::surface().ink} text={ne.name} />
                  })
                  let _ = nrow.box(fn(sp : view::View) -> Unit {
                    let _ = sp.width(view::Live::Is(Some(42.0))).rigid()
                    let _ = sp.box(fn(sp_pill : view::View) -> Unit {
                      let _ = sp_pill.padding(view::Live::Is((6.0, 2.0, 6.0, 2.0))).rigid().radius(view::Live::Is(4.0)).ground(view::Live::Is(st_bg))
                      <ui::Text in={sp_pill} size={10.5} weight={600} color_by=>{st_fg} text={ne.status.to_string()} />
                    })
                  })
                  let _ = nrow.box(fn(tp : view::View) -> Unit {
                    let _ = tp.width(view::Live::Is(Some(46.0))).rigid()
                    let _ = tp.box(fn(tp_pill : view::View) -> Unit {
                      let _ = tp_pill.padding(view::Live::Is((6.0, 2.0, 6.0, 2.0))).rigid().radius(view::Live::Is(4.0)).ground(view::Live::Is(pill_bg))
                      <ui::Text in={tp_pill} size={10.5} weight={500} color_by=>{pill_fg} text={pill_lbl} />
                    })
                  })
                  let _ = nrow.box(fn(sz : view::View) -> Unit {
                    let _ = sz.width(view::Live::Is(Some(58.0))).rigid()
                    <ui::Text in={sz} size={11.0} color_by=>{lg::surface().ink_secondary} text={proto::format_devtools_bytes(ne.size_bytes)} />
                  })
                  let wf_col = dt_net_waterfall_color(ne.kind, ne.url, dark)
                  let _ = nrow.box(fn(wf : view::View) -> Unit {
                    let _ = wf.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).width(view::Live::Is(Some(114.0))).rigid().gap(view::Live::Is(6.0))
                    let _ = wf.box(fn(track : view::View) -> Unit {
                      let _ = track.width(view::Live::Is(Some(64.0))).height(view::Live::Is(Some(6.0))).rigid().radius(view::Live::Is(3.0)).clips(view::Live::Is(true)).ground(view::Live::By(fn() { lg::surface().card_secondary }))
                      let _ = track.box(fn(fill : view::View) -> Unit {
                        let _ = fill.width(view::Live::Is(Some(64.0 * wf_ratio))).height(view::Live::Is(Some(6.0))).rigid().radius(view::Live::Is(3.0)).ground(view::Live::Is(wf_col))
                      })
                    })
                    <ui::Text in={wf} size={10.5} color_by=>{lg::surface().ink_secondary} text={ne.duration_ms.to_string() + " ms"} />
                  })
                },
              )
              ri += 1
            }
          },
        )
      })
    })

    // Right: Request Inspector + Copy as cURL
    net_split.show(
      fn() -> Bool {
        let _ = (props.rev)()
        let idx = st.net_selected_idx.get()
        idx >= 0 && idx < (props.snapshot)().network_entries.length()
      },
      fn(insp_wrap : view::View) -> Unit {
        let _ = insp_wrap.row(view::Live::By(fn() { !is_narrow() })).rigid().min_height(view::Live::Is(Some(0.0)))
        let _ = insp_wrap.box(fn(vsep : view::View) -> Unit {
          let _ = vsep
          .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(lg::hairline_w) } }))
          .height(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(lg::hairline_w) } else { None } }))
          .rigid()
          .ground(view::Live::By(fn() { lg::surface().separator }))
        })
        let _ = insp_wrap.box(fn(insp : view::View) -> Unit {
          let _ = insp
          .width(view::Live::By(fn() -> Option[Double] { if is_narrow() { None } else { Some(296.0) } }))
          .height(view::Live::By(fn() -> Option[Double] { if is_narrow() { Some(160.0) } else { None } }))
          .rigid()
          .min_height(view::Live::Is(Some(0.0)))
          .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))

          let _ = ui::scroll_box(insp, fn(insp_body : view::View) -> Unit {
            let _ = insp_body.padding(view::Live::Is((10.0, 8.0, 10.0, 6.0))).gap(view::Live::Is(3.0))
            insp_body.switch_by(
              fn() -> Int { ((props.rev)() * 128 + st.net_selected_idx.get() + 1) * 2 + (if (props.dark)() { 1 } else { 0 }) },
              fn(card : view::View, key : Int) -> Unit {
                let dark = (key % 2) == 1
                let idx = st.net_selected_idx.untracked()
                let entries = signals::untracked(props.snapshot).network_entries
                if idx < 0 || idx >= entries.length() {
                  return
                }
                let ne = entries[idx]
                let curl_cmd = proto::devtools_net_curl_command(ne)
                let (st_bg, st_fg) = dt_net_status_palette(ne.status, dark)
                let _ = card.gap(view::Live::Is(2.0))

                // Header + Status Badge + Close button
                let _ = card.box(fn(hdr : view::View) -> Unit {
                  let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                  let _ = hdr.box(fn(hl : view::View) -> Unit {
                    let _ = hl.grow(view::Live::Is(1.0))
                    <ui::Text in={hl} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="REQUEST INSPECTOR" />
                  })
                  let _ = hdr.box(fn(sb : view::View) -> Unit {
                    let _ = sb.padding(view::Live::Is((6.0, 2.0, 6.0, 2.0))).rigid().radius(view::Live::Is(4.0)).ground(view::Live::Is(st_bg))
                    <ui::Text in={sb} size={10.0} weight={600} color_by=>{st_fg} text={proto::devtools_net_status_text(ne.status)} />
                  })
                  dt_header_icon_btn(hdr, fn() { "Close Request Inspector" }, fn() { ICON_CLOSE }, fn() { st.net_selected_idx.set(-1) })
                })

                // Full URL card
                let _ = lg::surface_card_node(
                  card,
                  fn(uc : view::View) -> Unit {
                    <ui::Text in={uc} size={10.5} wrap color_by=>{lg::surface().ink} text={if ne.url != "" { ne.url } else { ne.name }} />
                  },
                  radius=lg::r_chip,
                  pad=5.0,
                )

                // Compact metadata grid (3 rows: Method+Status, MIME, Size+Duration) so Copy as cURL always fits above fold
                let kv_pair = fn(k1 : String, v1 : String, k2 : String, v2 : String) -> Unit {
                  let _ = card.box(fn(kr : view::View) -> Unit {
                    let _ = kr.row(view::Live::Is(true)).gap(view::Live::Is(8.0))
                    let _ = kr.box(fn(c1 : view::View) -> Unit {
                      let _ = c1.row(view::Live::Is(true)).grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(4.0))
                      <ui::Text in={c1} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text={k1} />
                      <ui::Text in={c1} size={10.5} color_by=>{lg::surface().ink} text={v1} />
                    })
                    let _ = kr.box(fn(c2 : view::View) -> Unit {
                      let _ = c2.row(view::Live::Is(true)).grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(4.0))
                      <ui::Text in={c2} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text={k2} />
                      <ui::Text in={c2} size={10.5} color_by=>{lg::surface().ink} text={v2} />
                    })
                  })
                }
                kv_pair("Method", "GET", "Status", proto::devtools_net_status_text(ne.status))
                let _ = card.box(fn(mr : view::View) -> Unit {
                  let _ = mr.row(view::Live::Is(true)).gap(view::Live::Is(6.0))
                  <ui::Text in={mr} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text="MIME" />
                  let _ = mr.box(fn(mv : view::View) -> Unit {
                    let _ = mv.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                    let mt = <ui::Text in={mv} size={10.5} color_by=>{lg::surface().ink} text={proto::devtools_net_mime(ne)} />
                    let _ = mt.cut().allow_ellipsis(view::Live::Is(true))
                  })
                })
                kv_pair("Size", proto::format_devtools_bytes(ne.size_bytes), "Time", ne.duration_ms.to_string() + " ms")

                // Bottom action button: Copy as cURL (fits completely above fold in 280pt dock)
                let _ = headless::button(
                  card,
                  fn() { "Copy as cURL" },
                  fn(_v : view::View) -> Unit { (props.on_copy_curl)(curl_cmd) },
                  fn(cb : view::View, cbtn : headless::Button) -> Unit {
                    let _ = cb
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .center()
                    .min_height(view::Live::Is(Some(30.0)))
                    .rigid()
                    .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                    .gap(view::Live::Is(6.0))
                    .radius(view::Live::Is(lg::r_chip))
                    .ground(view::Live::By(fn() -> Int64 {
                      if cbtn.pressed() { dt_accent_ink(dark) } else if cbtn.hovered() { dt_accent_soft(dark) } else { dt_panel_bg(dark) }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      (1.0, if cbtn.hovered() || cbtn.pressed() { dt_accent_ink(dark) } else { lg::surface().separator_strong })
                    }))
                    let _ = shell_icon(cb, ICON_COPY, size=13.0, color_by=fn() { if cbtn.pressed() { 0xFFFFFFFFL } else { dt_accent_ink(dark) } })
                    <ui::Text
                      in={cb}
                      size={12.0}
                      weight={600}
                      color_by=>{if cbtn.pressed() { 0xFFFFFFFFL } else { dt_accent_ink(dark) }}
                      text="Copy as cURL"
                    />
                  },
                )
              },
            )
          })
        })
      },
    )
  })

  // 3. Bottom Summary Bar
  let _ = parent.box(fn(fsep : view::View) -> Unit {
    let _ = fsep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
  })
  let _ = parent.box(fn(foot : view::View) -> Unit {
    let _ = foot
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(26.0)))
    .rigid()
    .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
    .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))
    <ui::Text
      in={foot}
      size={11.0}
      color_by=>{lg::surface().ink_secondary}
      text_by=>{
        let _ = (props.rev)()
        let cat = st.net_filter.get()
        let live_q = st.net_search_field.text()
        let q = if live_q != "" { live_q } else { st.net_query.get() }
        let filtered : Array[proto::DevToolsNetworkEntry] = []
        for ne in (props.snapshot)().network_entries {
          if proto::devtools_net_matches_filter(ne, cat, q) {
            filtered.push(ne)
          }
        }
        proto::devtools_network_summary(filtered)
      }
    />
  })
}

///| Builds the shared solid inner surface (titlebar + 3 tabs + body) used by BOTH
///| Docked (solid) and Floating (single-layer glass outer frame + solid inner content) modes.
fn dt_build_inner_surface(
  container : view::View,
  props : DevToolsPanelProps,
  is_narrow : () -> Bool,
) -> Unit {
  let st = props.state

  // 1. Header Bar: 3 Tabs + Inspected Page Title/URL & Pane Badge + Mode Toggle / Refresh / Clear / Close
  let _ = container.box(fn(bar : view::View) -> Unit {
    let _ = bar
    .row(view::Live::Is(true))
    .wraps(view::Live::Is(Some(4.0)))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .padding(view::Live::Is((10.0, 4.0, 8.0, 4.0)))
    .gap(view::Live::Is(4.0))
    .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))

    let tab_btn = fn(idx : Int, label : String, badge_fn : () -> String) -> Unit {
      let is_active = fn() -> Bool { st.tab.get() == idx }
      let _ = headless::button(
        bar,
        fn() { "DevTools Tab " + label },
        fn(_v : view::View) -> Unit {
          st.tab.set(idx)
          (props.on_inspect)(st.selected_path.untracked())
        },
        fn(tb : view::View, tbtn : headless::Button) -> Unit {
          let _ = tb
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .min_height(view::Live::Is(Some(36.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(5.0))
          .radius(view::Live::Is(lg::r_chip))
          .ground(view::Live::By(fn() -> Int64 {
            if is_active() { lg::surface().card } else if tbtn.pressed() { lg::surface().row_selected } else if tbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
          }))
          .edge(view::Live::By(fn() -> (Double, Int64) {
            if is_active() { (lg::hairline_w, lg::surface().separator_strong) } else { (0.0, 0x00000000L) }
          }))
          <ui::Text
            in={tb}
            size={12.0}
            weight={500}
            color_by=>{if is_active() { dt_accent_ink((props.dark)()) } else { lg::surface().ink }}
            text={label}
          />
          tb.show(fn() { badge_fn() != "" }, fn(bg : view::View) -> Unit {
            let _ = bg
            .height(view::Live::Is(Some(18.0)))
            .rigid()
            .center()
            .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
            .radius(view::Live::Is(9.0))
            .ground(view::Live::By(fn() { if is_active() { dt_accent_soft((props.dark)()) } else { lg::surface().card_secondary } }))
            <ui::Text
              in={bg}
              size={10.0}
              weight={600}
              color_by=>{if is_active() { dt_accent_ink((props.dark)()) } else { lg::surface().ink_secondary }}
              text_by=>{badge_fn()}
            />
          })
        },
      )
    }

    tab_btn(DEVTOOLS_TAB_ELEMENTS, "Elements", fn() { "" })
    tab_btn(DEVTOOLS_TAB_CONSOLE, "Console", fn() {
      let _ = (props.rev)()
      let n = (props.snapshot)().console_entries.length()
      if n > 0 { n.to_string() } else { "" }
    })
    tab_btn(DEVTOOLS_TAB_NETWORK, "Network", fn() {
      let _ = (props.rev)()
      let n = (props.snapshot)().network_entries.length()
      if n > 0 { n.to_string() } else { "" }
    })

    // Inspected target page title/URL + bound `owner_pane` pill
    let _ = bar.box(fn(sp : view::View) -> Unit {
      let _ = sp
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .min_width(view::Live::Is(Some(80.0)))
      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
      .gap(view::Live::Is(6.0))
      .clips(view::Live::Is(true))

      let _ = sp.box(fn(pb : view::View) -> Unit {
        let _ = pb.padding(view::Live::Is((6.0, 2.0, 6.0, 2.0))).rigid().radius(view::Live::Is(5.0)).ground(view::Live::By(fn() { dt_accent_soft((props.dark)()) }))
        <ui::Text in={pb} size={10.5} weight={600} color_by=>{dt_accent_ink((props.dark)())} text_by=>{dt_pane_label((props.owner_pane)())} />
      })
      let _ = sp.box(fn(ul : view::View) -> Unit {
        let _ = ul.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
        <ui::Text
          in={ul}
          size={11.0}
          color_by=>{lg::surface().ink_secondary}
          text_by=>{
            let _ = (props.rev)()
            let snap = (props.snapshot)()
            let host = if snap.page_url != "" { proto::omnibox_display_host(snap.page_url) } else { "" }
            if snap.page_title != "" && host != "" {
              snap.page_title + " - " + host
            } else if snap.page_title != "" {
              snap.page_title
            } else if host != "" {
              host
            } else {
              "about:blank"
            }
          }
        />
      })
    })

    // Right actions: Toggle Docked/Floating, Refresh, Clear Console, Close
    dt_header_icon_btn(
      bar,
      fn() {
        match st.presentation.get() {
          DevToolsPresentation::Docked => "Float DevTools"
          DevToolsPresentation::Floating => "Dock DevTools"
        }
      },
      fn() {
        match st.presentation.get() {
          DevToolsPresentation::Docked => ICON_EXTERNAL
          DevToolsPresentation::Floating => ICON_LAYERS
        }
      },
      fn() -> Unit {
        let next = match st.presentation.untracked() {
          DevToolsPresentation::Docked => DevToolsPresentation::Floating
          DevToolsPresentation::Floating => DevToolsPresentation::Docked
        }
        st.presentation.set(next)
        match props.on_presentation_change {
          Some(cb) => cb(next)
          None => ()
        }
      },
    )
    dt_header_icon_btn(bar, fn() { "Refresh DevTools" }, fn() { ICON_RELOAD }, props.on_refresh)
    dt_header_icon_btn(bar, fn() { "Close DevTools" }, fn() { ICON_CLOSE }, props.on_close, danger=true)
  })

  let _ = container.box(fn(sep : view::View) -> Unit {
    let _ = sep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
  })

  // 2. Active Tab Body (bounded flex container)
  let _ = container.box(fn(panel_host : view::View) -> Unit {
    let _ = panel_host.fill().clips(view::Live::Is(true))
    panel_host.show(fn() { st.tab.get() == DEVTOOLS_TAB_ELEMENTS }, fn(v : view::View) -> Unit {
      dt_build_elements_tab(v, props, is_narrow)
    })
    panel_host.show(fn() { st.tab.get() == DEVTOOLS_TAB_CONSOLE }, fn(v : view::View) -> Unit {
      dt_build_console_tab(v, props)
    })
    panel_host.show(fn() { st.tab.get() == DEVTOOLS_TAB_NETWORK }, fn(v : view::View) -> Unit {
      dt_build_network_tab(v, props, is_narrow)
    })
  })
}

///| Builds the DevTools panel in either Docked (solid bottom dock) or Floating (single-layer
///| Liquid Glass outer overlay + solid inner content) presentation, sharing one `DevToolsPanelState`.
pub fn build_devtools_panel(
  parent : view::View,
  props : DevToolsPanelProps,
  docked_only~ : Bool = false,
  floating_only~ : Bool = false,
) -> Unit {
  let st = props.state
  let drag_start_wy = ui::ref_new(0.0)
  let drag_start_h = ui::ref_new(proto::DEVTOOLS_HEIGHT_DEFAULT)

  let live_win_w = fn() -> Double {
    let _ = parent.laid_size_told()
    let ww = parent.window_w()
    if ww > 100.0 {
      ww
    } else {
      let (_, _, pw, _) = parent.placed_now()
      if pw > 100.0 { pw } else { 1280.0 }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = parent.laid_size_told()
    let wh = parent.window_h()
    if wh > 100.0 {
      wh
    } else {
      let (_, _, _, ph) = parent.placed_now()
      if ph > 100.0 { ph } else { 800.0 }
    }
  }
  let is_narrow = fn() -> Bool { live_win_w() < 680.0 }

  // Presentation 1: Docked (solid window panel, zero Liquid Glass)
  if !floating_only {
    parent.show(
      fn() { (props.open)() && (st.presentation.get() is DevToolsPresentation::Docked) },
      fn(drawer : view::View) -> Unit {
        let _ = drawer
        .height(view::Live::By(fn() -> Option[Double] {
          let wh = live_win_h()
          let cap = if wh > 320.0 { wh - 160.0 } else { proto::DEVTOOLS_HEIGHT_MIN }
          let desired = st.height.get()
          let clamped = if desired > cap { cap } else { desired }
          Some(if clamped < proto::DEVTOOLS_HEIGHT_MIN { proto::DEVTOOLS_HEIGHT_MIN } else { clamped })
        }))
        .rigid()
        .min_width(view::Live::Is(Some(0.0)))
        .min_height(view::Live::Is(Some(proto::DEVTOOLS_HEIGHT_MIN)))
        .clips(view::Live::Is(true))
        .ground(view::Live::By(fn() { dt_panel_bg((props.dark)()) }))

        // Draggable 6pt top resize handle
        let _ = drawer.box(fn(handle : view::View) -> Unit {
          let is_hot = fn() -> Bool { st.dragging.get() || handle.pointed() }
          let _ = handle
          .height(view::Live::Is(Some(proto::DEVTOOLS_DIVIDER_HEIGHT)))
          .rigid()
          .center()
          .ground(view::Live::By(fn() { dt_chrome_bg((props.dark)()) }))
          .cursor(view::Live::Is(Some(view::Cursor::ResizeY)))
          .on_drag(
            fn(d : view::Drag) -> Unit {
              match d.kind {
                view::DragIs::Down => {
                  drag_start_wy.v = d.wy
                  drag_start_h.v = st.height.untracked()
                  st.dragging.set(true)
                }
                view::DragIs::Moved => {
                  if st.dragging.untracked() {
                    let dy = d.wy - drag_start_wy.v
                    st.height.set(proto::devtools_height_from_drag(drag_start_h.v, dy))
                  }
                }
                view::DragIs::Up | view::DragIs::Off => st.dragging.set(false)
              }
            },
            captures=true,
          )
          let _ = handle.box(fn(pill : view::View) -> Unit {
            let _ = pill
            .width(view::Live::Is(Some(32.0)))
            .height(view::Live::Is(Some(3.0)))
            .rigid()
            .radius(view::Live::Is(1.5))
            .ground(view::Live::By(fn() {
              if is_hot() { dt_accent_ink((props.dark)()) } else { lg::surface().separator_strong }
            }))
          })
        })

        let _ = drawer.box(fn(body_box : view::View) -> Unit {
          let _ = body_box.fill()
          dt_build_inner_surface(body_box, props, is_narrow)
        })
      },
    )
  }

  // Presentation 2: Floating in-window overlay (single-layer Liquid Glass outer frame + solid inner content)
  if !docked_only {
    parent.show(
      fn() { (props.open)() && (st.presentation.get() is DevToolsPresentation::Floating) },
      fn(float_wrap : view::View) -> Unit {
        let _ = float_wrap
        .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
          let ww = live_win_w()
          let side = if ww < 560.0 { 12.0 } else { 24.0 }
          (Some(side), None, Some(side), Some(16.0))
        }))
        .lies_along(view::Live::Is(view::Lies::End))

        let _ = lg::liquid_dialog_shell_node(
          float_wrap,
          fn(shell : view::View) -> Unit {
            let _ = shell
            .max_width(view::Live::By(fn() -> Option[Double] {
              let ww = live_win_w()
              let side = if ww < 560.0 { 24.0 } else { 48.0 }
              let max_w = ww - side
              Some(if max_w > 320.0 { max_w } else { 320.0 })
            }))
            .height(view::Live::By(fn() -> Option[Double] {
              let wh = live_win_h()
              let desired = st.height.get() + 48.0
              // Never overlap the top titleband + optional bookmarks bar (`anchor_top`) + 16pt breathing room + 16pt bottom inset
              let top_clear = (props.anchor_top)()
              let max_h = wh - top_clear - 32.0
              let cap = if max_h > 220.0 { max_h } else { 220.0 }
              let clamped = if desired > cap { cap } else { desired }
              Some(if clamped < 220.0 { 220.0 } else { clamped })
            }))
            .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // Solid inner panel frame (concentric r = 24 - 8 = 16pt)
            let _ = shell.box(fn(inner : view::View) -> Unit {
              let _ = inner
              .fill()
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(lg::concentric(24.0, 8.0)))
              .ground(view::Live::By(fn() { dt_panel_bg((props.dark)()) }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              dt_build_inner_surface(inner, props, is_narrow)
            })
          },
          radius=24.0,
        )
      },
    )
  }
}
