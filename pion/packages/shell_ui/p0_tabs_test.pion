///| p0 parity (tabs, sidebar): the speaker on a playing tab mutes it without switching to it, the middle button
///| closes the tab row under the pointer, the Today divider's Clear closes Today's tabs, and a hidden docked sidebar
///| comes back from the window's leading edge and goes again once the pointer leaves it.

import "view"

fn p0_tab(ctrl : ShellController, id : String) -> Option[ShellTabItem] {
  for t in ctrl.tabs.untracked() {
    if t.id == id {
      return Some(t)
    }
  }
  None
}

test "p0 tabs: the speaker on a playing tab is its own 32pt button; it mutes that tab and never switches to it" {
  let ctrl = make_demo_controller()
  let tabs = ctrl.tabs.untracked().copy()
  tabs[2] = ShellTabItem::{ ..tabs[2], playing_audio: true, muted: false }
  ctrl.tabs.set(tabs)
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let title = "Groove Salad — SomaFM"
  let (_, ry, _, rh) = sf_rect(t, title)
  let mid = ry + rh / 2.0
  t.move_to(900.0, 400.0)
  t.frame(ms=16.0)
  // At rest the speaker takes the row's trailing 32pt; the rest of the row still selects the tab.
  debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE - 1.0, mid) == "Mute " + title, "the trailing edge mutes (got \{sf_hit(SHELL_SIDEBAR_W_WIDE - 1.0, mid)})")
  debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE - SP_40, mid) == title, "left of the speaker is the row")
  let (_, _, mw, mh) = sf_rect(t, "Mute " + title)
  debug_assert(mw >= 32.0 && mh >= 32.0, "a 32pt target (\{mw} x \{mh})")
  let before = sf_active(ctrl)
  t.press("Mute " + title)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "toggle_tab_mute:t3", "it asks to mute that tab: \{ctrl.last_intent.untracked()}")
  debug_assert(sf_active(ctrl) == before, "and the selection stays where it was")
  match p0_tab(ctrl, "t3") {
    Some(tb) => debug_assert(tb.muted, "the tab is muted")
    None => debug_assert(false, "t3 there")
  }
  t.frame(ms=16.0)
  debug_assert(t.get("Unmute " + title, role=view::Role::Button) is Some(_), "the speaker now unmutes")
  // Hovered, the close button takes the trailing 32pt and the speaker sits just left of it.
  t.move_to(100.0, mid)
  t.frame(ms=200.0)
  debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE - 1.0, mid) == "Close " + title, "Close at the edge while hovered")
  debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE - SP_32 - SP_16, mid) == "Unmute " + title, "the speaker left of it (got \{sf_hit(SHELL_SIDEBAR_W_WIDE - SP_32 - SP_16, mid)})")
  t.dispose()
}

test "p0 tabs: the middle button closes the tab row under the pointer, nowhere else" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  t.move_to(900.0, 400.0)
  t.frame(ms=16.0)
  debug_assert(!shell_middle_press(), "over the page: not the shell's")
  let (rx, ry, rw, rh) = sf_rect(t, "WPT Dashboard: css")
  t.move_to(rx + rw / 2.0, ry + rh / 2.0)
  t.frame(ms=16.0)
  debug_assert(shell_middle_press(), "over a tab row: the shell takes it")
  // (the row fades out first, then its close is told, as its X does)
  t.frame(ms=400.0)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "close_tab:t4", "that tab closes: \{ctrl.last_intent.untracked()}")
  debug_assert(p0_tab(ctrl, "t4") is None, "it is gone")
  t.dispose()
}

test "p0 tabs: the Today divider shows Clear while hovered; it closes every Today tab but the shown one" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  t.move_to(900.0, 400.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Clear Today tabs", role=view::Role::Button) is None, "no Clear at rest")
  let today = match t.rect_of("Today") {
    Some(r) => r
    None => {
      debug_assert(false, "the divider is drawn")
      return
    }
  }
  let before_new = t.rect_of("New tab")
  t.move_to(today.0 + SP_4, today.1 + today.3 / 2.0)
  t.frame(ms=200.0)
  let (cx, cy, cw, ch) = sf_rect(t, "Clear Today tabs")
  debug_assert(cw >= 32.0 && ch >= 32.0, "a 32pt target (\{cw} x \{ch})")
  debug_assert(cx + cw <= SHELL_SIDEBAR_W_WIDE, "at the divider's trailing end")
  match (before_new, t.rect_of("New tab")) {
    (Some(a), Some(b)) => debug_assert(a.1 == b.1, "nothing below moves as it shows")
    _ => debug_assert(false, "New tab drawn")
  }
  t.move_to(cx + cw / 2.0, cy + ch / 2.0)
  t.frame(ms=16.0)
  t.press("Clear Today tabs")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "clear_today", "Clear: \{ctrl.last_intent.untracked()}")
  debug_assert(p0_tab(ctrl, "t3") is None && p0_tab(ctrl, "t4") is None, "Today's tabs go")
  debug_assert(p0_tab(ctrl, "t1") is Some(_) && p0_tab(ctrl, "t2") is Some(_), "pinned tabs stay")
  t.frame(ms=200.0)
  debug_assert(t.get("Clear Today tabs", role=view::Role::Button) is None, "with nothing left to clear, no Clear")
  t.dispose()
}

test "p0 sidebar: a hidden docked sidebar comes back from the window's leading edge and goes once the pointer leaves" {
  let ctrl = make_demo_controller()
  ctrl.dock.set(DockState::{ ..ctrl.dock.untracked(), sidebar_open: false })
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  t.move_to(600.0, 400.0)
  t.frame(ms=16.0)
  debug_assert(t.get("WPT Dashboard: css", role=view::Role::Button) is None, "hidden: no tab rows")
  let zone = match t.get("Sidebar Edge") {
    Some(d) => d
    None => {
      debug_assert(false, "the leading edge is there while the sidebar is hidden")
      return
    }
  }
  debug_assert(zone.x <= 0.5 && zone.w <= SP_8 + 0.5 && zone.h > SP_160, "a strip along the window's edge (\{zone.x}, \{zone.w} x \{zone.h})")
  t.move_to(2.0, 400.0)
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  let (rx, ry, rw, rh) = sf_rect(t, "WPT Dashboard: css")
  debug_assert(rx < SP_80, "the sidebar floats in from the edge (x=\{rx})")
  debug_assert(!ctrl.dock.untracked().sidebar_open, "the docked sidebar stays hidden: the page does not reflow")
  // Into it, and pressing a tab, keeps it up.
  t.move_to(rx + rw / 2.0, ry + rh / 2.0)
  t.frame(ms=400.0)
  debug_assert(t.get("WPT Dashboard: css", role=view::Role::Button) is Some(_), "still up while the pointer is on it")
  t.click(rx + rw / 2.0, ry + rh / 2.0)
  t.frame(ms=16.0)
  debug_assert(sf_active(ctrl) == "t4", "its rows select tabs")
  // Away from it: gone after a moment, not at once.
  t.move_to(900.0, 400.0)
  t.frame(ms=16.0)
  debug_assert(t.get("WPT Dashboard: css", role=view::Role::Button) is Some(_), "a short overshoot keeps it")
  t.frame(ms=400.0)
  t.frame(ms=400.0)
  debug_assert(t.get("WPT Dashboard: css", role=view::Role::Button) is None, "then it goes (\{t.get("WPT Dashboard: css", role=view::Role::Button) is Some(_)})")
  debug_assert(t.get("Sidebar Edge") is Some(_), "and the edge reveals it again")
  t.dispose()
}
