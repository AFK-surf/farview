///| Shell motion in the built frame (DESIGN.md section 4): toast, menus, the narrow sidebar drawer, Peek, Split View
///| and the Space tint, each sampled mid-way and at rest on the Tester clock; first mount instant.

import "lg"
import "ui"
import "view"

fn mf_tree(ctrl : ShellController, width~ : Double = 1280.0) -> ui::Tester {
  ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=width,
    height=800.0,
    theme=lg::ui_theme,
  )
}

///| Drawn opacity of the node said or worded `name` (-1 when it is not there).
fn mf_alpha(t : ui::Tester, name : String) -> Double {
  match t.get(name) {
    Some(d) => d.alpha
    None => -1.0
  }
}

fn mf_toast(ctrl : ShellController, on : Bool) -> Unit {
  let p = ctrl.passive.untracked()
  ctrl.passive.set(PassiveState::{ ..p, toast_visible: on, toast_title: "Copied Link", toast_subtitle: "", toast_kind: ToastKind::Success })
}

test "motion frame: the toast fades in over 140ms and out over 100ms when it runs out (told as a transition)" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = mf_tree(ctrl)
  t.frame(ms=16.0)
  mf_toast(ctrl, true)
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let a40 = mf_alpha(t, "Copied Link")
  debug_assert(a40 > 0.0 && a40 < 1.0, "toast at 40ms: 0 < alpha < 1 (alpha \{a40})")
  t.frame(ms=300.0)
  debug_assert(mf_alpha(t, "Copied Link") == 1.0, "toast at rest: alpha 1")
  view::transition(fn() { mf_toast(ctrl, false) })
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let l40 = mf_alpha(t, "Copied Link")
  debug_assert(l40 > 0.0 && l40 < 1.0, "toast leaving at 40ms: still on screen, fading (alpha \{l40})")
  t.frame(ms=200.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Copied Link").is_none(), "toast gone after its exit")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion frame: a toast already up as the frame is built is there at once" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  mf_toast(ctrl, true)
  let t = mf_tree(ctrl)
  debug_assert(mf_alpha(t, "Copied Link") == 1.0, "restored toast: alpha 1 on the first frame")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion frame: the More menu's items are there from the first frame and the menu is at rest by 200ms" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = mf_tree(ctrl)
  t.press("More Actions")
  t.frame(ms=16.0)
  debug_assert(t.get("Export PDF…").is_some(), "items are laid out on the first frame (no content delay)")
  t.frame(ms=24.0)
  let a40 = mf_alpha(t, "Export PDF…")
  debug_assert(a40 > 0.3 && a40 < 1.0, "menu at 40ms: readable, still easing (alpha \{a40})")
  t.frame(ms=160.0)
  debug_assert(mf_alpha(t, "Export PDF…") == 1.0, "menu at rest by 200ms")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion frame: the narrow sidebar drawer (Cmd+S) is done within 120ms, and instant when built open" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = mf_tree(ctrl, width=480.0)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::ToggleNarrowSidebar)
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let a40 = mf_alpha(t, "Tabs")
  debug_assert(a40 > 0.0 && a40 < 1.0, "drawer at 40ms: mid fade (alpha \{a40})")
  t.frame(ms=80.0)
  debug_assert(mf_alpha(t, "Tabs") == 1.0, "drawer at rest by 120ms")
  t.dispose()

  let ctrl2 = make_demo_controller(dark=false)
  ctrl2.dispatch(ShellIntent::ToggleNarrowSidebar)
  let t2 = mf_tree(ctrl2, width=480.0)
  debug_assert(mf_alpha(t2, "Tabs") == 1.0, "already open as built: alpha 1 on the first frame")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "motion frame: Peek front-loads the card's opacity while it grows 0.97 -> 1 over 200ms" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = mf_tree(ctrl)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OpenPeek("https://developer.mozilla.org/en-US/docs/Web/CSS/grid"))
  t.frame(ms=16.0)
  t.frame(ms=44.0)
  let a60 = mf_alpha(t, "Secondary Pane")
  debug_assert(a60 > 0.9, "Peek card at 60ms: nearly opaque already (no long double exposure; alpha \{a60})")
  t.frame(ms=300.0)
  debug_assert(mf_alpha(t, "Secondary Pane") == 1.0, "Peek at rest")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion frame: Split View's new pane fades in (opacity only) and only when it opens after build" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = mf_tree(ctrl)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let a40 = mf_alpha(t, "Secondary Pane")
  debug_assert(a40 > 0.0 && a40 < 1.0, "new pane at 40ms: mid fade (alpha \{a40})")
  t.frame(ms=300.0)
  debug_assert(mf_alpha(t, "Secondary Pane") == 1.0, "new pane at rest")
  t.dispose()

  let t2 = mf_tree(make_demo_controller(dark=false, split=true))
  debug_assert(mf_alpha(t2, "Secondary Pane") == 1.0, "Split View restored at build: there at once")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "motion frame: switching Space recolors the frame tint over MO_KEY_MS, kept under reduced motion" {
  ui::set_reduced_motion(Some(true))
  let ctrl = make_demo_controller(dark=false)
  let t = mf_tree(ctrl)
  t.frame(ms=16.0)
  let ground_now = fn() -> Int64 {
    let mut g = 0L
    for d in t.drawn() {
      if g == 0L && d.x == 0.0 && d.y == 0.0 && d.w == 1280.0 && d.h == 800.0 && d.ground != 0L {
        g = d.ground
      }
    }
    g
  }
  let before = ground_now()
  ctrl.dispatch(ShellIntent::SelectSpace("personal"))
  let after = shell_frame_color(ctrl.model())
  debug_assert(before != after, "the Spaces have different tints")
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let mid = ground_now()
  debug_assert(mid != before && mid != after, "tint at 40ms: between the two (color eases even under reduced motion)")
  t.frame(ms=200.0)
  debug_assert(ground_now() == after, "tint at rest: the new Space's color")
  ui::set_reduced_motion(None)
  t.dispose()
}
