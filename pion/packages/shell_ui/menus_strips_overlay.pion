///| Shell 3 strips, menus and small overlays:
///| - Bookmarks bar (`top_strip` slot): chips straight on the frame, washes on hover, one star button.
///| - Page details HUD: the page's own numbers from the host, in two grouped lists.
///| - Tab hover preview: site tile, title, host, a quiet status line.
///| - Context menus `page_ctx`, `tab_ctx`, `bm_bar_ctx` and the Back/Forward list `nav_hist`: `lg` menus with one
///|   icon column, right-aligned shortcuts, separators cleaned (never doubled, never first or last).
///| - Folder settings `folder_ctx` and Customize Space `space_theme`: grouped lists (name, color, toggles).
///| - Recent tabs switcher `mru` (`Ctrl+Tab`): a grid of preview cards, keycap hints underneath.
///|
///| Invariants: every callback carries its stable `tab_id` / `folder_id` / `owner_pane`; floating panels are one
///| layer of `lg` glass with solid content inside; every size comes from the `SP_*` / `TX_*` / `IC_*` scales.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// Shared pieces (private to this file)
// ============================================================================

let MSO_TILE_TABS : Int64 = 0x5856D6FFL // indigo
let MSO_TILE_BOOKMARK : Int64 = 0xFF9500FFL // orange
let MSO_TILE_GRAY : Int64 = 0x8E8E93FFL // gray
let MSO_TILE_RED : Int64 = 0xFF3B30FFL // red

///| The host a site tile should name: a short language or mobile label (`en.`, `m.`) is dropped, so
///| `en.wikipedia.org` reads as W, not E.
fn mso_tile_host(url_or_host : String) -> String {
  let host = if url_or_host.contains("/") { shell_url_parts(url_or_host).0 } else { url_or_host }
  let mut dots = 0
  let mut first = -1
  let mut i = 0
  while i < host.length() {
    if host.code_unit_at(i).to_int() == 0x2E {
      dots += 1
      if first < 0 {
        first = i
      }
    }
    i += 1
  }
  if dots >= 2 && first > 0 && first <= 2 {
    host.slice(first + 1, host.length())
  } else {
    host
  }
}

///| A bookmark chip title, cut to 24 characters with an ellipsis (chips never squeeze each other).
fn mso_chip_title(title : String) -> String {
  let t = title.trim()
  if t.length() > 24 { t.slice(0, 23).trim() + "…" } else { t }
}

fn menu_shortcut(mac : String, other : String) -> String {
  if ui::keys_apple() { mac } else { other }
}

///| A flat 32pt icon button: no face at rest, an eased wash on hover. `on_frame` picks the frame wash
///| (translucent white over the Space tint) instead of the content-layer row hover.
fn mso_icon_btn(
  parent : view::View,
  label : () -> String,
  icon_by : () -> String,
  color_by : () -> Int64,
  on_press : () -> Unit,
  on_frame~ : Bool = false,
) -> Unit {
  let _ = headless::button(
    parent,
    label,
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .ground(view::Live::By(fn() {
        let wash = if on_frame { shell_wash_hover(lg::is_dark()) } else { lg::surface().row_hover }
        lg::alpha(wash, hover_t())
      }))
      let _ = shell_icon_by(b, icon_by, size=IC_MD, color_by=color_by)
    },
  )
}

///| Hairline between rows of a grouped card, starting at `inset` (where the row labels start).
fn mso_rule(parent : view::View, inset : Double) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((inset, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| A grouped list section: quiet sentence-case caption, one solid card, optional footnote.
fn mso_group(parent : view::View, caption : String, footnote : String, rows : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(sec : view::View) -> Unit {
    let _ = sec.gap(view::Live::Is(SP_6)).rigid()
    if caption != "" {
      let _ = sec.box(fn(cap : view::View) -> Unit {
        let _ = cap.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={caption} />
      })
    }
    let _ = lg::surface_card_node(sec, fn(card : view::View) -> Unit { rows(card) }, radius=SP_12, pad=SP_0)
    if footnote != "" {
      let _ = sec.box(fn(fn_box : view::View) -> Unit {
        let _ = fn_box.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={fn_box} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text={footnote} />
      })
    }
  })
}

///| A row of a grouped card: 24pt glyph tile, label, trailing control (min 40pt, SP_12 padding).
fn mso_tile_row(
  parent : view::View,
  icon_name : String,
  tile_color : () -> Int64,
  label : String,
  trailing : (view::View) -> Unit,
  label_color~ : () -> Int64 = fn() { lg::surface().ink },
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_6, SP_12, SP_6)))
    .gap(view::Live::Is(SP_12))
    let _ = shell_glyph_tile(row, icon_name, tile_color, size=SP_24)
    let _ = row.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{label_color()} text={label} />
    })
    trailing(row)
  })
}

///| A label / value row (no tile) for read-only numbers: 32pt, value right-aligned.
fn mso_value_row(
  parent : view::View,
  label : String,
  value_by : () -> String,
  value_color~ : () -> Int64 = fn() { lg::surface().ink },
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_32)))
    .padding(view::Live::Is((SP_12, SP_6, SP_12, SP_6)))
    .gap(view::Live::Is(SP_12))
    let _ = row.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink_secondary} text={label} />
    })
    <ui::Text in={row} size={TX_BODY} weight={500} lines={1} color_by=>{value_color()} text_by=>{value_by()} />
  })
}

///| A keycap pill (`⌃`, `Tab`, `Return`) for keyboard hints.
fn mso_keycap(parent : view::View, key : String) -> Unit {
  let _ = parent.box(fn(cap : view::View) -> Unit {
    let _ = cap
    .min_width(view::Live::Is(Some(SP_20)))
    .height(view::Live::Is(Some(SP_20)))
    .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
    .radius(view::Live::Is(SP_4))
    .rigid()
    .center()
    .ground(view::Live::By(fn() { lg::surface().card }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
    <ui::Text in={cap} size={TX_CAPTION} weight={500} color_by=>{lg::surface().ink_secondary} text={key} />
  })
}

///| Popover header: glyph tile, title, close button (one 32pt row).
fn mso_popover_header(
  parent : view::View,
  icon_name : String,
  tile_color : () -> Int64,
  title_by : () -> String,
  close_label : String,
  on_close : () -> Unit,
) -> Unit {
  let _ = parent.box(fn(hdr : view::View) -> Unit {
    let _ = hdr
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(SP_12))
    .padding(view::Live::Is((SP_12, SP_4, SP_4, SP_0)))
    .rigid()
    let _ = shell_glyph_tile(hdr, icon_name, tile_color, size=SP_24)
    let _ = hdr.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={tw} size={TX_BODY} weight={600} lines={1} color_by=>{lg::surface().ink} text_by=>{title_by()} />
    })
    mso_icon_btn(
      hdr,
      fn() { close_label },
      fn() { ICON_CLOSE },
      fn() { lg::surface().ink_secondary },
      on_close,
    )
  })
}

///| Name editor inside a grouped card: a borderless field and a Save button (Return also saves).
fn mso_name_editor(
  parent : view::View,
  field : ui::Field,
  placeholder : String,
  save_label : String,
  on_save : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
    .gap(view::Live::Is(SP_8))
    let _ = row.box(fn(fw : view::View) -> Unit {
      let _ = fw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
      let _ = ui::field(
        fw,
        field,
        placeholder=placeholder,
        font_size=TX_BODY,
        max_lines=1,
        enter_sends=true,
        colors_by=fn() { (lg::surface().ink, lg::surface().ink_tertiary, lg::surface().accent) },
        submitted=fn(txt : String) -> Unit { on_save(txt) },
      )
    })
    let _ = lg::liquid_button_node(
      row,
      fn() { save_label },
      fn() -> Unit { on_save(field.text()) },
      content=fn(inner : view::View) -> Unit {
        <ui::Text in={inner} size={TX_BODY} weight={500} color_by=>{lg::surface().accent} text="Save" />
      },
      flat=true,
      ghost=true,
      height=SP_32,
      pad_x=SP_4,
    )
  })
}

///| A row of round color swatches inside a grouped card; the chosen one carries a ring and a check.
fn mso_swatches(
  parent : view::View,
  palette : Array[String],
  label_prefix : String,
  is_chosen : (String) -> Bool,
  on_pick : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(sw_row : view::View) -> Unit {
    let _ = sw_row
    .row(view::Live::Is(true))
    .wraps(view::Live::Is(Some(SP_10)))
    .gap(view::Live::Is(SP_10))
    .padding(view::Live::Is((SP_12, SP_10, SP_12, SP_10)))
    let mut i = 0
    while i < palette.length() {
      let hex = palette[i]
      let rgba = proto::workspace_accent_color(hex)
      let _ = headless::button(
        sw_row,
        fn() { label_prefix + hex },
        fn(_e) -> Unit { on_pick(hex) },
        fn(sw : view::View, _btn : headless::Button) -> Unit {
          let chosen = fn() -> Bool { is_chosen(hex) }
          let _ = sw
          .width(view::Live::Is(Some(SP_24)))
          .height(view::Live::Is(Some(SP_24)))
          .radius(view::Live::Is(SP_12))
          .center()
          .rigid()
          .ground(view::Live::Is(rgba))
          .edge(view::Live::By(fn() {
            if chosen() { (SP_2, lg::surface().ink) } else { (lg::hairline_w, lg::alpha(0x000000FFL, 0.12)) }
          }))
          sw.show(chosen, fn(ck : view::View) -> Unit {
            let _ = shell_icon(ck, ICON_CHECK, size=IC_SM, color_by=fn() { 0xFFFFFFFFL })
          })
        },
      )
      i += 1
    }
  })
}

///| Height a cleaned `lg` menu will take (32pt items + 2pt gaps, 9pt separators, 6pt padding), for placement.
fn mso_menu_height(entries : Array[lg::LiquidMenuEntry], has_header~ : Bool = false) -> Double {
  let mut h = SP_12 + (if has_header { SP_24 } else { SP_0 })
  let mut i = 0
  while i < entries.length() {
    h = h + SP_32 + SP_2
    i += 1
  }
  h
}

///| Menu icon: one 16pt glyph, so every row's label starts on the same line.
fn mso_menu_icon(name : String) -> (view::View, () -> Int64) -> Unit {
  fn(ic : view::View, ink : () -> Int64) -> Unit { let _ = shell_icon(ic, name, size=IC_MD, color_by=ink) }
}

// ============================================================================
// 1. Bookmarks Bar Strip (mounts in the `top_strip` slot, straight on the frame)
// ============================================================================

pub struct BookmarkChipItem {
  pub id : String
  pub title : String
  pub url : String
}

pub struct BookmarksBarProps {
  pub open : () -> Bool
  pub items : () -> Array[BookmarkChipItem]
  pub page_saved : () -> Bool
  pub on_navigate : (String) -> Unit
  pub on_context_menu : (String, String, Double, Double) -> Unit
  pub on_toggle_bookmark : () -> Unit
}

///| Builds the Bookmarks Bar for the `top_strip` slot: it sits on the window frame (no box of its own, no rule),
///| chips are a site tile + title with a frame wash on hover. Left-click navigates; right-click opens `bm_bar_ctx`.
pub fn build_bookmarks_bar_strip(parent : view::View, props : BookmarksBarProps) -> Unit {
  parent.show(props.open, fn(strip : view::View) -> Unit {
    let _ = strip
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_32)))
    .rigid()
    .gap(view::Live::Is(SP_8))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Bookmarks Bar"))))

    let _ = strip.box(fn(chips : view::View) -> Unit {
      let _ = chips
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      .gap(view::Live::Is(SP_2))
      .clips(view::Live::Is(true))

      chips.show(
        fn() { (props.items)().length() == 0 },
        fn(emp : view::View) -> Unit {
          let _ = emp.padding(view::Live::Is((SP_8, SP_0, SP_0, SP_0)))
          <ui::Text
            in={emp}
            size={TX_FOOTNOTE}
            color_by=>{shell_frame_ink_tertiary(lg::is_dark())}
            text="Bookmarks you save appear here"
          />
        },
      )

      chips.each(
        props.items,
        fn(bm : BookmarkChipItem) -> String { bm.id },
        fn(slot : view::View, bm_sig : signals::Signal[BookmarkChipItem]) -> Unit {
          // Chips keep their size; the ones past the edge are clipped by the row, never squeezed.
          let _ = slot.rigid()
          let _ = headless::button(
            slot,
            fn() { "Open bookmark \{bm_sig.get().title}" },
            fn(_e) -> Unit { (props.on_navigate)(bm_sig.untracked().url) },
            fn(chip : view::View, btn : headless::Button) -> Unit {
              let hover_t = motion::hover_fade(chip, fn() { btn.hovered() || btn.pressed() })
              let _ = chip
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(SP_32)))
              .rigid()
              .padding(view::Live::Is((SP_8, SP_0, SP_10, SP_0)))
              .gap(view::Live::Is(SP_8))
              .radius(view::Live::Is(SP_8))
              .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(lg::is_dark()), hover_t()) }))
              .on_menu(fn(_m : view::Menu) -> Unit {
                let (cx, cy, _, ch) = chip.placed_window_now()
                let cur = bm_sig.untracked()
                (props.on_context_menu)(cur.id, cur.url, cx, cy + ch + SP_4)
              })
              let _ = shell_site_tile(chip, fn() { mso_tile_host(proto::omnibox_display_host(bm_sig.get().url)) }, size=SP_16)
              let _ = <ui::Text
                in={chip}
                size={TX_FOOTNOTE}
                weight={500}
                lines={1}
                color_by=>{
                  if btn.hovered() || btn.pressed() {
                    lg::surface().ink
                  } else {
                    shell_frame_ink_secondary(lg::is_dark())
                  }
                }
                text_by=>{mso_chip_title(bm_sig.get().title)}
              />.rigid()
            },
          )
        },
      )
    })

    // Bookmark this page: one star, filled orange once saved.
    mso_icon_btn(
      strip,
      fn() { if (props.page_saved)() { "Remove Bookmark" } else { "Bookmark Page" } },
      fn() { if (props.page_saved)() { ICON_STAR_FILLED } else { ICON_STAR } },
      fn() { if (props.page_saved)() { MSO_TILE_BOOKMARK } else { shell_frame_ink_secondary(lg::is_dark()) } },
      props.on_toggle_bookmark,
      on_frame=true,
    )
  })
}

// ============================================================================
// 2. Page details HUD (real host metrics only)
// ============================================================================

pub struct PerfHudMetrics {
  pub host_label : String
  pub scheme : String
  pub tls_secure : Bool
  pub dom_nodes : Int
  pub stylesheets : Int
  pub images : Int
  pub doc_width : Int
  pub doc_height : Int
  pub zoom_percent : Int
  pub cookies_count : Int
  pub space_name : String
  pub space_accent : Int64
}

pub struct PerfHudProps {
  pub open : () -> Bool
  pub metrics : () -> PerfHudMetrics
  pub top_offset : () -> Double
  pub on_refresh : () -> Unit
  pub on_close : () -> Unit
}

fn hud_connection_label(m : PerfHudMetrics) -> String {
  let badge = proto::perf_hud_security_badge(m.scheme, m.tls_secure)
  if badge == "HTTPS" {
    "Secure (HTTPS)"
  } else if badge == "LOCAL" {
    "Local file"
  } else {
    "Not secure (HTTP)"
  }
}

///| Builds the Page details HUD pinned to the top right of the page: the site, then two grouped lists of the
///| numbers the host reports (connection, zoom, cookies; elements, stylesheets, images, document size).
pub fn build_perf_hud_overlay(root : view::View, props : PerfHudProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over_at(view::Live::By(fn() { (None, Some((props.top_offset)()), Some(SP_16), None) }))

    let _ = lg::liquid_panel_shell_node(
      layer,
      fn(card : view::View) -> Unit {
        let _ = card
        .width(view::Live::Is(Some(SP_160 + SP_128)))
        .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
        .gap(view::Live::Is(SP_16))
        .presses(view::Live::Is(true))
        .on_press(fn() { () })
        .says(view::Live::Is(Some(view::said(view::Role::Region, label="Page details"))))

        // Site + actions
        let _ = card.box(fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(SP_10))
          .padding(view::Live::Is((SP_4, SP_0, SP_0, SP_0)))
          .rigid()
          let _ = shell_site_tile(hdr, fn() { mso_tile_host((props.metrics)().host_label) }, size=SP_32)
          let _ = hdr.box(fn(col : view::View) -> Unit {
            let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
            <ui::Text in={col} size={TX_BODY} weight={600} color_by=>{lg::surface().ink} text="Page details" />
            <ui::Text
              in={col}
              size={TX_FOOTNOTE}
              lines={1}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{(props.metrics)().host_label}
            />
          })
          mso_icon_btn(hdr, fn() { "Refresh Perf HUD" }, fn() { ICON_RELOAD }, fn() { lg::surface().ink_secondary }, props.on_refresh)
          mso_icon_btn(hdr, fn() { "Close Perf HUD" }, fn() { ICON_CLOSE }, fn() { lg::surface().ink_secondary }, props.on_close)
        })

        mso_group(card, "This site", "", fn(g : view::View) -> Unit {
          mso_value_row(
            g,
            "Connection",
            fn() { hud_connection_label((props.metrics)()) },
            value_color=fn() { if (props.metrics)().tls_secure { lg::surface().positive } else { lg::surface().warning } },
          )
          mso_rule(g, SP_12)
          mso_value_row(g, "Zoom", fn() { "\{(props.metrics)().zoom_percent}%" })
          mso_rule(g, SP_12)
          mso_value_row(g, "Cookies", fn() { (props.metrics)().cookies_count.to_string() })
        })

        mso_group(card, "Document", "", fn(g : view::View) -> Unit {
          mso_value_row(g, "DOM nodes", fn() { (props.metrics)().dom_nodes.to_string() })
          mso_rule(g, SP_12)
          mso_value_row(g, "Stylesheets", fn() { (props.metrics)().stylesheets.to_string() })
          mso_rule(g, SP_12)
          mso_value_row(g, "Images", fn() { (props.metrics)().images.to_string() })
          mso_rule(g, SP_12)
          mso_value_row(g, "Document size", fn() {
            let m = (props.metrics)()
            "\{m.doc_width} × \{m.doc_height}"
          })
        })
      },
      radius=SP_24,
    )
  })
}

// ============================================================================
// 3. Tab Hover Preview Card
// ============================================================================

pub struct TabHoverPreviewSnapshot {
  pub tab_id : String
  pub title : String
  pub clean_host : String
  pub space_name : String
  pub playing : Bool
  pub muted : Bool
  pub in_split : Bool
  pub in_reader : Bool
}

pub struct TabHoverPreviewProps {
  pub open : () -> Bool
  pub snapshot : () -> Option[TabHoverPreviewSnapshot]
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
}

///| Builds the floating Tab Hover Preview (click-through): site tile, title (two lines), host, and a status line
///| only when the tab is playing, muted, in Split View or in Reader.
pub fn build_tab_hover_preview_card(root : view::View, props : TabHoverPreviewProps) -> Unit {
  let card_w = SP_160 + SP_96
  let card_h = SP_96
  let snap_has = fn(f : (TabHoverPreviewSnapshot) -> Bool) -> Bool {
    match (props.snapshot)() {
      Some(s) => f(s)
      None => false
    }
  }
  root.show(
    fn() { (props.open)() && (props.snapshot)().is_some() },
    fn(layer : view::View) -> Unit {
      let _ = layer
      .over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement((props.anchor_x)(), (props.anchor_y)(), vw, vh, card_w, card_h)
        (Some(px), Some(py), None, None)
      }))
      .points(view::Live::Is(false))

      let _ = lg::liquid_panel_shell_node(
        layer,
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(card_w)))
          .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
          .gap(view::Live::Is(SP_8))
          .points(view::Live::Is(false))

          let _ = card.box(fn(top : view::View) -> Unit {
            let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_10)).rigid()
            // 20pt tile: its center sits on the title's first line.
            let _ = top.box(fn(tw : view::View) -> Unit {
              let _ = tw.rigid()
              let _ = shell_site_tile(
                tw,
                fn() {
                  match (props.snapshot)() {
                    Some(s) => mso_tile_host(s.clean_host)
                    None => ""
                  }
                },
                size=SP_20,
              )
            })
            let _ = top.box(fn(col : view::View) -> Unit {
              let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
              <ui::Text
                in={col}
                size={TX_BODY}
                weight={500}
                lines={2}
                color_by=>{lg::surface().ink}
                text_by=>{
                  match (props.snapshot)() {
                    Some(s) => s.title
                    None => ""
                  }
                }
              />
              <ui::Text
                in={col}
                size={TX_FOOTNOTE}
                lines={1}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{
                  match (props.snapshot)() {
                    Some(s) => s.clean_host
                    None => ""
                  }
                }
              />
            })
          })

          // Status line (only what is true right now).
          card.show(
            fn() { snap_has(fn(s) { s.playing || s.muted || s.in_split || s.in_reader }) },
            fn(st : view::View) -> Unit {
              let _ = st
              .row(view::Live::Is(true))
              .wraps(view::Live::Is(Some(SP_4)))
              .gap(view::Live::Is(SP_12))
              .padding(view::Live::Is((SP_20 + SP_10, SP_0, SP_0, SP_0)))
              .rigid()
              let status = fn(cond : () -> Bool, icon_name : String, label : String, ink : () -> Int64) -> Unit {
                st.show(cond, fn(b : view::View) -> Unit {
                  let _ = b.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4))
                  let _ = shell_icon(b, icon_name, size=IC_SM, color_by=ink)
                  <ui::Text in={b} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={label} />
                })
              }
              status(fn() { snap_has(fn(s) { s.playing && !s.muted }) }, ICON_VOLUME, "Playing", fn() { lg::surface().positive })
              status(fn() { snap_has(fn(s) { s.muted }) }, ICON_VOLUME_MUTE, "Muted", fn() { lg::surface().ink_secondary })
              status(fn() { snap_has(fn(s) { s.in_split }) }, ICON_SPLIT, "Split View", fn() { lg::surface().accent })
              status(fn() { snap_has(fn(s) { s.in_reader }) }, ICON_READER, "Reader", fn() { MSO_TILE_BOOKMARK })
            },
          )
        },
        radius=SP_20,
      )
    },
  )
}

// ============================================================================
// 4. Context menus (`page_ctx`, `tab_ctx`, `bm_bar_ctx`)
// ============================================================================

fn build_anchored_menu_overlay(
  root : view::View,
  open : () -> Bool,
  anchor_x : () -> Double,
  anchor_y : () -> Double,
  menu_w : Double,
  menu_label : String,
  entries : () -> Array[lg::LiquidMenuEntry],
  on_close : () -> Unit,
) -> Unit {
  root.show(open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let est_h = mso_menu_height(entries())
        let (px, py) = compute_menu_placement(anchor_x(), anchor_y(), vw, vh, menu_w, est_h)
        (Some(px), Some(py), None, None)
      }))
      let _ = lg::liquid_menu_panel_node(
        pos,
        entries,
        on_close,
        menu_label=fn() { menu_label },
        min_width=menu_w,
      )
    })
  })
}

///| Hit-test context payload for `PageContextMenu` (`page_ctx`).
pub struct PageContextTarget {
  pub link_url : String
  pub image_url : String
  pub selection_text : String
  pub can_back : Bool
  pub can_forward : Bool
}

pub struct PageContextCallbacks {
  pub on_open_peek : (String) -> Unit
  pub on_open_split : (String) -> Unit
  pub on_open_new_tab : (String) -> Unit
  pub on_copy_link : (String) -> Unit
  pub on_open_image : (String) -> Unit
  pub on_copy_image_url : (String) -> Unit
  pub on_copy_selection : (String) -> Unit
  pub on_search_selection : (String) -> Unit
  pub on_back : () -> Unit
  pub on_forward : () -> Unit
  pub on_reload : () -> Unit
  pub on_copy_page_url : () -> Unit
  pub on_close : () -> Unit
}

pub struct PageContextMenuProps {
  pub open : () -> Bool
  pub target : () -> PageContextTarget
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : PageContextCallbacks
}

///| Builds the webpage context menu (tag `"page_ctx"`): link, image and selection groups when present, then the
///| page group. Back and Forward always keep their place and dim when unavailable, so the menu shape is stable.
pub fn build_page_context_menu(root : view::View, props : PageContextMenuProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    SP_160 + SP_80,
    "Page Context Menu",
    fn() -> Array[lg::LiquidMenuEntry] {
      let t = (props.target)()
      let cb = props.callbacks
      let items : Array[lg::LiquidMenuEntry] = []
      if t.link_url != "" {
        let u = t.link_url
        items.push(lg::LiquidMenuEntry::item(
          label="Open Link in New Tab",
          icon=mso_menu_icon(ICON_PLUS),
          on_select=fn() { (cb.on_open_new_tab)(u) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Open in Peek",
          shortcut=menu_shortcut("⇧ Click", "Shift+Click"),
          icon=mso_menu_icon(ICON_EXTERNAL),
          on_select=fn() { (cb.on_open_peek)(u) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Open Link in Split View",
          icon=mso_menu_icon(ICON_SPLIT),
          on_select=fn() { (cb.on_open_split)(u) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Copy Clean Link",
          icon=mso_menu_icon(ICON_COPY),
          on_select=fn() { (cb.on_copy_link)(u) },
        ))
        items.push(lg::LiquidMenuEntry::separator())
      }
      if t.image_url != "" {
        let img = t.image_url
        items.push(lg::LiquidMenuEntry::item(
          label="Open Image in New Tab",
          icon=mso_menu_icon(ICON_CAMERA),
          on_select=fn() { (cb.on_open_image)(img) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Copy Image URL",
          icon=mso_menu_icon(ICON_COPY),
          on_select=fn() { (cb.on_copy_image_url)(img) },
        ))
        items.push(lg::LiquidMenuEntry::separator())
      }
      if t.selection_text != "" {
        let sel = t.selection_text
        items.push(lg::LiquidMenuEntry::item(
          label="Copy Selection",
          shortcut=menu_shortcut("⌘C", "Ctrl+C"),
          icon=mso_menu_icon(ICON_COPY),
          on_select=fn() { (cb.on_copy_selection)(sel) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Search the Web",
          icon=mso_menu_icon(ICON_SEARCH),
          on_select=fn() { (cb.on_search_selection)(sel) },
        ))
        items.push(lg::LiquidMenuEntry::separator())
      }
      items.push(lg::LiquidMenuEntry::item(
        label="Back",
        shortcut=menu_shortcut("⌘[", "Alt+Left"),
        icon=mso_menu_icon(ICON_BACK),
        disabled=!t.can_back,
        on_select=cb.on_back,
      ))
      items.push(lg::LiquidMenuEntry::item(
        label="Forward",
        shortcut=menu_shortcut("⌘]", "Alt+Right"),
        icon=mso_menu_icon(ICON_FORWARD),
        disabled=!t.can_forward,
        on_select=cb.on_forward,
      ))
      items.push(lg::LiquidMenuEntry::item(
        label="Reload",
        shortcut=menu_shortcut("⌘R", "Ctrl+R"),
        icon=mso_menu_icon(ICON_RELOAD),
        on_select=cb.on_reload,
      ))
      items.push(lg::LiquidMenuEntry::separator())
      items.push(lg::LiquidMenuEntry::item(
        label="Copy Clean Page URL",
        shortcut=menu_shortcut("⇧⌘C", "Ctrl+Shift+C"),
        icon=mso_menu_icon(ICON_COPY),
        on_select=cb.on_copy_page_url,
      ))
      items
    },
    props.callbacks.on_close,
  )
}

///| Target payload for `TabContextMenu` (`tab_ctx`), routed strictly by stable `tab_id`.
pub struct TabContextTarget {
  pub tab_id : String
  pub is_active : Bool
  pub pinned : Bool
  pub favorite : Bool
  pub muted : Bool
  pub folder_id : String
  pub can_close_others : Bool
  pub folders : Array[(String, String)]
  pub spaces : Array[(String, String)]
}

pub struct TabContextCallbacks {
  pub on_open_split : (String) -> Unit
  pub on_open_peek : (String) -> Unit
  pub on_duplicate : (String) -> Unit
  pub on_copy_clean_url : (String) -> Unit
  pub on_toggle_pin : (String) -> Unit
  pub on_toggle_favorite : (String) -> Unit
  pub on_toggle_mute : (String) -> Unit
  pub on_move_to_folder : (String, String) -> Unit
  pub on_move_to_space : (String, String) -> Unit
  pub on_close_others : (String) -> Unit
  pub on_close_tab : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct TabContextMenuProps {
  pub open : () -> Bool
  pub target : () -> TabContextTarget
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : TabContextCallbacks
}

///| Builds the tab context menu (tag `"tab_ctx"`): open, keep (pin / favorite / mute), move, close.
///| Shortcuts show only for the active tab (they act on it); Move to Folder and Move to Space list real targets.
pub fn build_tab_context_menu(root : view::View, props : TabContextMenuProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    SP_160 + SP_80,
    "Tab Context Menu",
    fn() -> Array[lg::LiquidMenuEntry] {
      let t = (props.target)()
      let tid = t.tab_id
      let cb = props.callbacks
      let items : Array[lg::LiquidMenuEntry] = [
        lg::LiquidMenuEntry::item(
          label="Open in Split View",
          icon=mso_menu_icon(ICON_SPLIT),
          on_select=fn() { (cb.on_open_split)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label="Open in Peek",
          icon=mso_menu_icon(ICON_EXTERNAL),
          on_select=fn() { (cb.on_open_peek)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label="Duplicate Tab",
          icon=mso_menu_icon(ICON_LAYERS),
          on_select=fn() { (cb.on_duplicate)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label="Copy Clean URL",
          icon=mso_menu_icon(ICON_COPY),
          on_select=fn() { (cb.on_copy_clean_url)(tid) },
        ),
        lg::LiquidMenuEntry::separator(),
        lg::LiquidMenuEntry::item(
          label=if t.pinned { "Unpin Tab" } else { "Pin Tab" },
          icon=mso_menu_icon(ICON_PIN),
          on_select=fn() { (cb.on_toggle_pin)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label=if t.favorite { "Remove from Favorites" } else { "Add to Favorites" },
          icon=mso_menu_icon(if t.favorite { ICON_STAR_FILLED } else { ICON_STAR }),
          on_select=fn() { (cb.on_toggle_favorite)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label=if t.muted { "Unmute Tab" } else { "Mute Tab" },
          shortcut=if t.is_active { menu_shortcut("⌘M", "Ctrl+M") } else { "" },
          icon=mso_menu_icon(if t.muted { ICON_VOLUME } else { ICON_VOLUME_MUTE }),
          on_select=fn() { (cb.on_toggle_mute)(tid) },
        ),
        lg::LiquidMenuEntry::separator(),
      ]
      if t.folder_id != "" {
        items.push(lg::LiquidMenuEntry::item(
          label="Move to Top-Level Pinned",
          icon=mso_menu_icon(ICON_PIN),
          on_select=fn() { (cb.on_move_to_folder)(tid, "") },
        ))
      }
      let mut fj = 0
      while fj < t.folders.length() {
        let (fid, fname) = t.folders[fj]
        if fid != t.folder_id {
          items.push(lg::LiquidMenuEntry::item(
            label="Move to \{fname}",
            icon=mso_menu_icon(ICON_FOLDER),
            on_select=fn() { (cb.on_move_to_folder)(tid, fid) },
          ))
        }
        fj += 1
      }
      let mut i = 0
      while i < t.spaces.length() {
        let (sid, sname) = t.spaces[i]
        items.push(lg::LiquidMenuEntry::item(
          label="Move to \{sname}",
          icon=mso_menu_icon(ICON_ARROW_RIGHT),
          on_select=fn() { (cb.on_move_to_space)(tid, sid) },
        ))
        i += 1
      }
      items.push(lg::LiquidMenuEntry::separator())
      if t.can_close_others {
        items.push(lg::LiquidMenuEntry::item(
          label="Close Other Tabs",
          icon=mso_menu_icon(ICON_CLOSE),
          on_select=fn() { (cb.on_close_others)(tid) },
        ))
      }
      items.push(lg::LiquidMenuEntry::item(
        label="Close Tab",
        shortcut=if t.is_active { menu_shortcut("⌘W", "Ctrl+W") } else { "" },
        destructive=true,
        icon=mso_menu_icon(ICON_CLOSE),
        on_select=fn() { (cb.on_close_tab)(tid) },
      ))
      items
    },
    props.callbacks.on_close,
  )
}

pub struct BookmarksBarContextProps {
  pub open : () -> Bool
  pub bookmark_id : () -> String
  pub bookmark_url : () -> String
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub on_open_split : (String) -> Unit
  pub on_open_peek : (String) -> Unit
  pub on_remove : (String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the bookmarks bar context menu (tag `"bm_bar_ctx"`).
pub fn build_bookmarks_bar_context_menu(root : view::View, props : BookmarksBarContextProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    SP_160 + SP_48,
    "Bookmark Context Menu",
    fn() -> Array[lg::LiquidMenuEntry] {
      let url = (props.bookmark_url)()
      let bid = (props.bookmark_id)()
      [
        lg::LiquidMenuEntry::item(
          label="Open in Split View",
          icon=mso_menu_icon(ICON_SPLIT),
          on_select=fn() { (props.on_open_split)(url) },
        ),
        lg::LiquidMenuEntry::item(
          label="Open in Peek",
          icon=mso_menu_icon(ICON_EXTERNAL),
          on_select=fn() { (props.on_open_peek)(url) },
        ),
        lg::LiquidMenuEntry::separator(),
        lg::LiquidMenuEntry::item(
          label="Remove Bookmark",
          destructive=true,
          icon=mso_menu_icon("trash"),
          on_select=fn() { (props.on_remove)(bid) },
        ),
      ]
    },
    props.on_close,
  )
}

// ============================================================================
// 5. Back / Forward history menu (tag: "nav_hist")
// ============================================================================

pub struct NavHistoryItem {
  pub index : Int
  pub title : String
  pub url : String
}

pub struct NavHistoryPopoverProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub is_forward : () -> Bool
  pub entries : () -> Array[NavHistoryItem]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_jump : (Int, Int) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Back / Forward history list (tag `"nav_hist"`) as an `lg` menu under its button: one row per
///| entry with the site tile and the page title, keyboard navigable. Selecting dispatches
///| `on_jump(owner_pane, entry.index)`.
pub fn build_nav_history_popover(root : view::View, props : NavHistoryPopoverProps) -> Unit {
  let nominal_w = SP_160 + SP_128
  let entries = fn() -> Array[lg::LiquidMenuEntry] {
    let src = (props.entries)()
    let out : Array[lg::LiquidMenuEntry] = []
    let mut i = 0
    while i < src.length() {
      let e = src[i]
      let host = mso_tile_host(shell_url_parts(e.url).0)
      let idx = e.index
      out.push(lg::LiquidMenuEntry::item(
        label=if e.title.trim() != "" { e.title } else { host },
        icon=fn(ic : view::View, _ink : () -> Int64) -> Unit { let _ = shell_site_tile(ic, fn() { host }, size=SP_16) },
        on_select=fn() {
          let owner = signals::untracked(props.owner_pane)
          (props.on_jump)(owner, idx)
        },
      ))
      i += 1
    }
    out
  }
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos
      .over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          mso_menu_height(entries(), has_header=true),
        )
        (Some(px), Some(py), None, None)
      }))
      .width(view::Live::By(fn() {
        let (vw, _) = overlay_window_size(root)
        Some(clamp_popover_width(nominal_w, vw))
      }))
      let _ = lg::liquid_menu_panel_node(
        pos,
        entries,
        props.on_close,
        header=fn() { if (props.is_forward)() { "Forward" } else { "Back" } },
        menu_label=fn() { "Navigation History" },
        min_width=SP_160 + SP_64,
      )
    })
  })
}

// ============================================================================
// 6. Folder settings (tag: "folder_ctx")
// ============================================================================

pub struct FolderContextTarget {
  pub folder_id : String
  pub name : String
  pub color : String
  pub collapsed : Bool
}

pub struct FolderContextCallbacks {
  pub on_rename : (String, String) -> Unit
  pub on_pick_color : (String, String) -> Unit
  pub on_toggle_collapse : (String) -> Unit
  pub on_delete : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct FolderContextMenuProps {
  pub open : () -> Bool
  pub target : () -> FolderContextTarget
  pub palette : Array[String]
  pub rename_field : ui::Field
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : FolderContextCallbacks
}

///| Builds the folder settings popover (tag `"folder_ctx"`): the folder's tile and name as the title, then
///| Name, Color, a Collapsed toggle and Delete — all routed by stable `folder_id`.
pub fn build_folder_context_menu(root : view::View, props : FolderContextMenuProps) -> Unit {
  let pop_w = SP_160 + SP_128
  let est_h = SP_160 + SP_160 + SP_48
  let fid_now = fn() -> String { signals::untracked(props.target).folder_id }
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.callbacks.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement((props.anchor_x)(), (props.anchor_y)(), vw, vh, pop_w, est_h)
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::Is(Some(pop_w)))
          .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
          .gap(view::Live::Is(SP_16))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Folder Settings"))))

          mso_popover_header(
            panel,
            ICON_FOLDER,
            fn() { proto::workspace_accent_color((props.target)().color) },
            fn() {
              let n = (props.target)().name
              if n.trim() != "" { n } else { "Folder" }
            },
            "Close Folder Settings",
            props.callbacks.on_close,
          )

          mso_group(panel, "Name", "", fn(g : view::View) -> Unit {
            mso_name_editor(g, props.rename_field, "Folder name", "Save Folder Name", fn(txt : String) -> Unit {
              (props.callbacks.on_rename)(fid_now(), txt)
            })
          })

          if props.palette.length() > 0 {
            mso_group(panel, "Color", "", fn(g : view::View) -> Unit {
              mso_swatches(
                g,
                props.palette,
                "Folder Color ",
                fn(hex : String) -> Bool { (props.target)().color == hex },
                fn(hex : String) -> Unit { (props.callbacks.on_pick_color)(fid_now(), hex) },
              )
            })
          }

          mso_group(panel, "", "", fn(g : view::View) -> Unit {
            mso_tile_row(g, ICON_CHEVRON_RIGHT, fn() { MSO_TILE_GRAY }, "Collapsed", fn(tr : view::View) -> Unit {
              let _ = lg::liquid_toggle_node(
                tr,
                fn() { (props.target)().collapsed },
                fn(_v : Bool) -> Unit { (props.callbacks.on_toggle_collapse)(fid_now()) },
                fn() { if (props.target)().collapsed { "Expand Folder" } else { "Collapse Folder" } },
              )
            })
            mso_rule(g, SP_12 + SP_24 + SP_12)
            let _ = headless::button(
              g,
              fn() { "Delete Folder" },
              fn(_e) -> Unit { (props.callbacks.on_delete)(fid_now()) },
              fn(b : view::View, btn : headless::Button) -> Unit {
                let hover_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
                let _ = b.ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
                mso_tile_row(
                  b,
                  "trash",
                  fn() { MSO_TILE_RED },
                  "Delete Folder",
                  fn(_tr : view::View) -> Unit { () },
                  label_color=fn() { lg::surface().danger },
                )
              },
            )
          })
        },
        radius=SP_24,
      )
    })
  })
}

// ============================================================================
// 7. Customize Space (tag: "space_theme")
// ============================================================================

pub struct SpaceThemeProps {
  pub open : () -> Bool
  pub space_id : () -> String
  pub active_accent : () -> String
  pub palette : Array[String]
  pub name_field : ui::Field
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_rename : (String, String) -> Unit
  pub on_pick_accent : (String, String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Customize Space popover (tag `"space_theme"`): name and color of the Space, with a footnote on
///| what the color does (it tints the window frame).
pub fn build_space_theme_popover(root : view::View, props : SpaceThemeProps) -> Unit {
  let nominal_w = SP_160 + SP_128
  let est_h = SP_160 + SP_128 + SP_16
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
          .gap(view::Live::Is(SP_16))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Customize Space"))))

          mso_popover_header(
            panel,
            ICON_LAYERS,
            fn() { proto::workspace_accent_color((props.active_accent)()) },
            fn() { "Customize Space" },
            "Close Space Customizer",
            props.on_close,
          )

          mso_group(panel, "Name", "", fn(g : view::View) -> Unit {
            mso_name_editor(g, props.name_field, "Space name", "Rename Space", fn(txt : String) -> Unit {
              (props.on_rename)(signals::untracked(props.space_id), txt)
            })
          })

          mso_group(panel, "Color", "Tints the window frame of this Space.", fn(g : view::View) -> Unit {
            mso_swatches(
              g,
              props.palette,
              "Space color ",
              fn(hex : String) -> Bool { (props.active_accent)() == hex },
              fn(hex : String) -> Unit { (props.on_pick_accent)(signals::untracked(props.space_id), hex) },
            )
          })
        },
        radius=SP_24,
      )
    })
  })
}

// ============================================================================
// 8. Recent tabs switcher (tag: "mru")
// ============================================================================

pub struct MruTabEntry {
  pub tab_id : String
  pub title : String
  pub host : String
  pub playing : Bool
  pub active : Bool
}

pub struct MruSwitcherModalProps {
  pub open : () -> Bool
  pub space_name : () -> String
  pub items : () -> Array[MruTabEntry]
  pub selected_index : () -> Int
  pub on_select_tab : (String) -> Unit
  pub on_close : () -> Unit
}

let MRU_CARD_W : Double = 160.0 // SP_160
let MRU_GRID_GAP : Double = 12.0 // SP_12
let MRU_PAD : Double = 16.0 // SP_16

///| Columns of preview cards that fit: up to 4, fewer when the window or the list is small.
fn mru_columns(vw : Double, n : Int) -> Int {
  let avail = vw - SP_32 - MRU_PAD * 2.0
  let mut cols = 1
  while cols < 4 && (cols + 1).to_double() * MRU_CARD_W + cols.to_double() * MRU_GRID_GAP <= avail {
    cols += 1
  }
  let k = if n < 1 { 1 } else { n }
  if k < cols { k } else { cols }
}

///| Builds the recent tabs switcher (`Ctrl+Tab`, tag `"mru"`): a modal grid of preview cards (site color wash
///| with a large site tile, title, host); the selected card carries the accent ring. Keycap hints underneath.
pub fn build_mru_switcher_modal(root : view::View, props : MruSwitcherModalProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true)).center()
    let _ = layer.box(fn(scrim : view::View) -> Unit {
      let _ = scrim
      .over(view::Live::Is(true))
      .points(view::Live::Is(true))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0x00000066L } else { 0x0000002EL } }))
    })

    let modal_w = fn() -> Double {
      let (vw, _) = overlay_window_size(root)
      let cols = mru_columns(vw, (props.items)().length())
      cols.to_double() * MRU_CARD_W + (cols - 1).to_double() * MRU_GRID_GAP + MRU_PAD * 2.0
    }

    let _ = layer.box(fn(anchor : view::View) -> Unit {
      let _ = anchor.width(view::Live::By(fn() { Some(modal_w()) }))
      let _ = headless::dialog(
        anchor,
        fn() { "Quick Tab Switch" },
        props.open,
        props.on_close,
        fn(dlg : view::View, _d : headless::Dialog) -> Unit {
          let _ = dlg.width(view::Live::By(fn() { Some(modal_w()) }))
          let _ = lg::liquid_dialog_shell_node(dlg, fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() { Some(modal_w()) }))
            .padding(view::Live::Is((MRU_PAD, MRU_PAD, MRU_PAD, MRU_PAD)))
            .gap(view::Live::Is(SP_16))
            .presses(view::Live::Is(true))
            .on_press(fn() { () })

            // Header: title, Space name.
            let _ = shell.box(fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(SP_8))
              .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
              .rigid()
              let _ = hdr.box(fn(tw : view::View) -> Unit {
                let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                <ui::Text in={tw} size={TX_BODY} weight={600} color_by=>{lg::surface().ink} text="Recent tabs" />
              })
              <ui::Text
                in={hdr}
                size={TX_FOOTNOTE}
                lines={1}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{(props.space_name)()}
              />
            })

            // Card grid.
            let _ = shell.box(fn(grid : view::View) -> Unit {
              let _ = grid.row(view::Live::Is(true)).wraps(view::Live::Is(Some(MRU_GRID_GAP))).gap(view::Live::Is(MRU_GRID_GAP))
              grid.each(
                props.items,
                fn(it : MruTabEntry) -> String { it.tab_id },
                fn(slot : view::View, it_sig : signals::Signal[MruTabEntry]) -> Unit {
                  let is_sel = fn() -> Bool {
                    let all = (props.items)()
                    let sel_i = (props.selected_index)()
                    let cur_id = it_sig.get().tab_id
                    sel_i >= 0 && sel_i < all.length() && all[sel_i].tab_id == cur_id
                  }
                  let _ = headless::button(
                    slot,
                    fn() { "Switch to \{it_sig.get().title}" },
                    fn(_e) -> Unit { (props.on_select_tab)(it_sig.untracked().tab_id) },
                    fn(card : view::View, btn : headless::Button) -> Unit {
                      let hover_t = motion::hover_fade(card, fn() { btn.hovered() || btn.pressed() })
                      let _ = card
                      .width(view::Live::Is(Some(MRU_CARD_W)))
                      .padding(view::Live::Is((SP_6, SP_6, SP_6, SP_8)))
                      .gap(view::Live::Is(SP_8))
                      .radius(view::Live::Is(SP_12))
                      .ground(view::Live::By(fn() {
                        if is_sel() { lg::surface().accent_tint } else { lg::alpha(lg::surface().row_hover, hover_t()) }
                      }))
                      // Preview: the site's color, washed, with its tile.
                      let _ = card.box(fn(pv : view::View) -> Unit {
                        let _ = pv
                        .height(view::Live::Is(Some(SP_96)))
                        .radius(view::Live::Is(lg::concentric(SP_12, SP_6)))
                        .center()
                        .rigid()
                        .ground(view::Live::By(fn() {
                          shell_mix(lg::surface().card, shell_site_color(mso_tile_host(it_sig.get().host)), if lg::is_dark() { 0.20 } else { 0.16 })
                        }))
                        .edge(view::Live::By(fn() {
                          if is_sel() { (SP_2, lg::surface().accent) } else { (lg::hairline_w, lg::surface().separator) }
                        }))
                        let _ = shell_site_tile(pv, fn() { mso_tile_host(it_sig.get().host) }, size=SP_40)
                        pv.show(fn() { it_sig.get().playing }, fn(badge : view::View) -> Unit {
                          let _ = badge
                          .over_at(view::Live::Is((None, Some(SP_6), Some(SP_6), None)))
                          .width(view::Live::Is(Some(SP_20)))
                          .height(view::Live::Is(Some(SP_20)))
                          .radius(view::Live::Is(SP_10))
                          .center()
                          .ground(view::Live::By(fn() { lg::surface().card }))
                          let _ = shell_icon(badge, ICON_VOLUME, size=IC_SM, color_by=fn() { lg::surface().positive })
                        })
                      })
                      let _ = card.box(fn(txt : view::View) -> Unit {
                        let _ = txt.gap(view::Live::Is(SP_2)).padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0))).rigid()
                        <ui::Text
                          in={txt}
                          size={TX_FOOTNOTE}
                          weight={500}
                          lines={1}
                          color_by=>{lg::surface().ink}
                          text_by=>{it_sig.get().title}
                        />
                        <ui::Text
                          in={txt}
                          size={TX_CAPTION}
                          lines={1}
                          color_by=>{lg::surface().ink_secondary}
                          text_by=>{if it_sig.get().active { "Current tab" } else { it_sig.get().host }}
                        />
                      })
                    },
                  )
                },
              )
            })

            // Keyboard hints.
            let _ = shell.box(fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .wraps(view::Live::Is(Some(SP_8)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(SP_16))
              .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
              .rigid()
              let hint = fn(keys : Array[String], what : String) -> Unit {
                let _ = ftr.box(fn(h : view::View) -> Unit {
                  let _ = h.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).rigid()
                  let mut k = 0
                  while k < keys.length() {
                    mso_keycap(h, keys[k])
                    k += 1
                  }
                  let _ = h.box(fn(lw : view::View) -> Unit {
                    let _ = lw.padding(view::Live::Is((SP_2, SP_0, SP_0, SP_0)))
                    <ui::Text in={lw} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={what} />
                  })
                })
              }
              let apple = ui::keys_apple()
              hint([if apple { "⌃" } else { "Ctrl" }, "Tab"], "Next")
              hint([if apple { "↩" } else { "Enter" }], "Switch")
              hint([if apple { "esc" } else { "Esc" }], "Close")
            })
          })
        },
        modal=true,
        close_on_escape=true,
        close_on_outside=true,
      )
    })
  })
}
