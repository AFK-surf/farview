          on_select=fn() { (props.on_open_split)(url) },
        ),
        lg::LiquidMenuEntry::item(
          label="Open in Peek",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_EXTERNAL, size=14.0, color_by=ink) },
          on_select=fn() { (props.on_open_peek)(url) },
        ),
        lg::LiquidMenuEntry::separator(),
        lg::LiquidMenuEntry::item(
          label="Remove Bookmark",
          destructive=true,
          icon=fn(ic, ink) { let _ = shell_icon(ic, "trash", size=14.0, color_by=ink) },
          on_select=fn() { (props.on_remove)(bid) },
        ),
      ]
    },
    props.on_close,
  )
}

// ============================================================================
// 5. Navigation History Popover (tag: "nav_hist")
// ============================================================================

pub struct NavHistoryItem {
  pub index : Int
  pub title : String
  pub url : String
}

pub struct NavHistoryPopoverProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub is_forward : () -> Bool
  pub entries : () -> Array[NavHistoryItem]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_jump : (Int, Int) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Liquid Glass Back / Forward Navigation History Popover (tag `"nav_hist"`).
///| Preserves `owner_pane` and dispatches `on_jump(owner_pane, entry.index)`.
pub fn build_nav_history_popover(root : view::View, props : NavHistoryPopoverProps) -> Unit {
  let nominal_w = 276.0
  let est_h = 260.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((10.0, 10.0, 10.0, 10.0)))
          .gap(view::Live::Is(6.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Menu, label="Navigation History"))))

          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((4.0, 2.0, 4.0, 2.0))).gap(view::Live::Is(6.0)).rigid()
            let _ = hdr.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0))
              let _ = <ui::Text
                in={tw}
                size={10.5}
                weight={600}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{if (props.is_forward)() { "FORWARD HISTORY" } else { "BACK HISTORY" }}
              />
            })
            let _ = <ui::Text in={hdr} size={10.5} color_by=>{lg::surface().ink_tertiary} text_by=>{"\{(props.entries)().length()}"} />
          })

          panel.each(
            props.entries,
            fn(e : NavHistoryItem) -> String { "\{e.index}:\{e.url}" },
            fn(slot : view::View, e_sig : signals::Signal[NavHistoryItem]) -> Unit {
              let _ = headless::button(
                slot,
                fn() { e_sig.get().title },
                fn(_e) -> Unit {
                  let owner = signals::untracked(props.owner_pane)
                  let idx = e_sig.untracked().index
                  (props.on_jump)(owner, idx)
                },
                fn(row : view::View, btn : headless::Button) -> Unit {
                  let _ = row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Start)))
                  .min_height(view::Live::Is(Some(36.0)))
                  .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
                  .gap(view::Live::Is(8.0))
                  .radius(view::Live::Is(lg::r_chip))
                  .ground(view::Live::By(fn() {
                    if btn.hovered() || btn.pressed() { lg::surface().row_hover } else { 0x00000000L }
                  }))
                  let _ = shell_icon(row, ICON_CLOCK, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                  let _ = row.box(fn(col : view::View) -> Unit {
                    let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(1.0))
                    let _ = <ui::Text in={col} size={12.0} weight={500} color_by=>{lg::surface().ink} text_by=>{e_sig.get().title} />.allow_ellipsis(view::Live::Is(true))
                    let _ = <ui::Text in={col} size={10.5} color_by=>{lg::surface().ink_tertiary} text_by=>{e_sig.get().url} />.allow_ellipsis(view::Live::Is(true))
                  })
                },
              )
            },
          )
        },
        radius=lg::r_card,
      )
    })
  })
}

// ============================================================================
// 6. Folder Context Popover (tag: "folder_ctx")
// ============================================================================

pub struct FolderContextTarget {
  pub folder_id : String
  pub name : String
  pub color : String
  pub collapsed : Bool
}

pub struct FolderContextCallbacks {
  pub on_rename : (String, String) -> Unit
  pub on_pick_color : (String, String) -> Unit
  pub on_toggle_collapse : (String) -> Unit
  pub on_delete : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct FolderContextMenuProps {
  pub open : () -> Bool
  pub target : () -> FolderContextTarget
  pub palette : Array[String]
  pub rename_field : ui::Field
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : FolderContextCallbacks
}

///| Builds the Liquid Glass Folder Context Popover (tag `"folder_ctx"`).
///| Routes Rename, Color, Toggle Collapse, and Delete strictly by stable `folder_id`.
pub fn build_folder_context_menu(root : view::View, props : FolderContextMenuProps) -> Unit {
  let pop_w = 248.0
  let est_h = 236.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.callbacks.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement((props.anchor_x)(), (props.anchor_y)(), vw, vh, pop_w, est_h)
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::Is(Some(pop_w)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Folder Settings"))))

          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
            let _ = shell_icon(hdr, ICON_FOLDER, size=14.0, color_by=fn() { lg::surface().accent })
            let _ = hdr.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0))
              let _ = <ui::Text in={tw} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Folder Settings" />
            })
            build_close_icon_btn(hdr, "Close Folder Settings", props.callbacks.on_close)
          })

          // Rename row
          let _ = panel.box(fn(rn : view::View) -> Unit {
            let _ = rn.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
            let _ = rn.box(fn(fw : view::View) -> Unit {
              let _ = fw
              .grow(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(30.0)))
              .padding(view::Live::Is((8.0, 4.0, 8.0, 4.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              .cut()
              let _ = ui::field(
                fw,
                props.rename_field,
                placeholder="Folder name",
                font_size=12.5,
                max_lines=1,
                enter_sends=true,
                submitted=fn(txt : String) -> Unit {
                  let fid = signals::untracked(props.target).folder_id
                  (props.callbacks.on_rename)(fid, txt)
                },
              )
            })
            let _ = lg::liquid_button_node(
              rn,
              fn() { "Save Folder Name" },
              fn() -> Unit {
                let fid = signals::untracked(props.target).folder_id
                (props.callbacks.on_rename)(fid, props.rename_field.text())
              },
              content=fn(inner : view::View) -> Unit {
                let _ = <ui::Text in={inner} size={12.0} weight={500} color_by=>{lg::surface().accent} text="Save" />
              },
              flat=true,
              height=30.0,
              pad_x=9.0,
            )
          })

          // Folder color palette swatches
          if props.palette.length() > 0 {
            let _ = panel.box(fn(csec : view::View) -> Unit {
              let _ = csec.gap(view::Live::Is(6.0)).rigid()
              let _ = <ui::Text in={csec} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="FOLDER COLOR" />
              let _ = csec.box(fn(sw : view::View) -> Unit {
                let _ = sw.row(view::Live::Is(true)).wraps(view::Live::Is(Some(6.0))).gap(view::Live::Is(6.0)).rigid()
                let mut ci = 0
                while ci < props.palette.length() {
                  let hex = props.palette[ci]
                  let rgba = proto::workspace_accent_color(hex)
                  let _ = headless::button(
                    sw,
                    fn() { "Folder Color \{hex}" },
                    fn(_e) -> Unit {
                      let fid = signals::untracked(props.target).folder_id
                      (props.callbacks.on_pick_color)(fid, hex)
                    },
                    fn(dot : view::View, _btn : headless::Button) -> Unit {
                      let _ = dot
                      .width(view::Live::Is(Some(22.0)))
                      .height(view::Live::Is(Some(22.0)))
                      .radius(view::Live::Is(11.0))
                      .rigid()
                      .ground(view::Live::Is(rgba))
                      .edge(view::Live::By(fn() {
                        if (props.target)().color == hex {
                          (2.0, lg::surface().ink)
                        } else {
                          (lg::hairline_w, lg::surface().separator)
                        }
                      }))
                    },
                  )
                  ci += 1
                }
              })
            })
          }

          // Toggle collapse + Delete actions
          let _ = panel.box(fn(acts : view::View) -> Unit {
            let _ = acts.gap(view::Live::Is(6.0)).rigid()
            let _ = lg::liquid_button_node(
              acts,
              fn() { if (props.target)().collapsed { "Expand Folder" } else { "Collapse Folder" } },
              fn() -> Unit {
                let fid = signals::untracked(props.target).folder_id
                (props.callbacks.on_toggle_collapse)(fid)
              },
              flat=true,
              height=30.0,
            )
            let _ = lg::liquid_button_node(
              acts,
              fn() { "Delete Folder" },
              fn() -> Unit {
                let fid = signals::untracked(props.target).folder_id
                (props.callbacks.on_delete)(fid)
              },
              content=fn(inner : view::View) -> Unit {
                let _ = inner.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                let _ = shell_icon(inner, "trash", size=13.0, color_by=fn() { lg::surface().danger })
                let _ = <ui::Text in={inner} size={12.0} weight={600} color_by=>{lg::surface().danger} text="Delete Folder" />
              },
              flat=true,
              height=30.0,
            )
          })
        },
        radius=lg::r_card,
      )
    })
  })
}

// ============================================================================
// 7. Space Theme Popover (tag: "space_theme")
// ============================================================================

pub struct SpaceThemeProps {
  pub open : () -> Bool
  pub space_id : () -> String
  pub active_accent : () -> String
  pub palette : Array[String]
  pub name_field : ui::Field
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_rename : (String, String) -> Unit
  pub on_pick_accent : (String, String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Liquid Glass Space Theme Customizer Popover (tag `"space_theme"`).
pub fn build_space_theme_popover(root : view::View, props : SpaceThemeProps) -> Unit {
  let nominal_w = 248.0
  let est_h = 192.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Customize Space"))))

          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
            let _ = shell_icon(hdr, ICON_LAYERS, size=14.0, color_by=fn() { lg::surface().accent })
            let _ = hdr.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0))
              let _ = <ui::Text in={tw} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Customize Space" />
            })
            build_close_icon_btn(hdr, "Close Space Customizer", props.on_close)
          })

          // Space name editor
          let _ = panel.box(fn(rn : view::View) -> Unit {
            let _ = rn.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
            let _ = rn.box(fn(fw : view::View) -> Unit {
              let _ = fw
              .grow(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(30.0)))
              .padding(view::Live::Is((8.0, 4.0, 8.0, 4.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              .cut()
              let _ = ui::field(
                fw,
                props.name_field,
                placeholder="Space name...",
                font_size=12.5,
                max_lines=1,
                enter_sends=true,
                submitted=fn(txt : String) -> Unit {
                  (props.on_rename)(signals::untracked(props.space_id), txt)
                },
              )
            })
            let _ = lg::liquid_button_node(
              rn,
              fn() { "Rename Space" },
              fn() -> Unit {
                (props.on_rename)(signals::untracked(props.space_id), props.name_field.text())
              },
              content=fn(inner : view::View) -> Unit {
                let _ = <ui::Text in={inner} size={12.0} weight={500} color_by=>{lg::surface().accent} text="Save" />
              },
              flat=true,
              height=30.0,
              pad_x=9.0,
            )
          })

          // Swatch palette row
          let _ = panel.box(fn(psec : view::View) -> Unit {
            let _ = psec.gap(view::Live::Is(6.0)).rigid()
            let _ = <ui::Text in={psec} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="THEME COLOR" />
            let _ = psec.box(fn(sw_row : view::View) -> Unit {
              let _ = sw_row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(6.0))).gap(view::Live::Is(8.0)).rigid()
              let mut i = 0
              while i < props.palette.length() {
                let hex = props.palette[i]
                let rgba = proto::workspace_accent_color(hex)
                let _ = headless::button(
                  sw_row,
                  fn() { "Space color \{hex}" },
                  fn(_e) -> Unit {
                    (props.on_pick_accent)(signals::untracked(props.space_id), hex)
                  },
                  fn(sw : view::View, _btn : headless::Button) -> Unit {
                    let is_sel = fn() -> Bool { (props.active_accent)() == hex }
                    let _ = sw
                    .width(view::Live::Is(Some(28.0)))
                    .height(view::Live::Is(Some(28.0)))
                    .radius(view::Live::Is(14.0))
                    .center()
                    .rigid()
                    .ground(view::Live::Is(rgba))
                    .edge(view::Live::By(fn() {
                      if is_sel() { (2.0, lg::surface().ink) } else { (lg::hairline_w, lg::surface().separator) }
                    }))
                    sw.show(is_sel, fn(ck : view::View) -> Unit {
                      let _ = shell_icon(ck, ICON_CHECK, size=13.0, color_by=fn() { 0xFFFFFFFFL })
                    })
                  },
                )
                i += 1
              }
            })
          })
        },
        radius=lg::r_card,
      )
    })
  })
}

// ============================================================================
// 8. MRU Switcher Modal (tag: "mru")
// ============================================================================

pub struct MruTabEntry {
  pub tab_id : String
  pub title : String
  pub host : String
  pub playing : Bool
  pub active : Bool
}

pub struct MruSwitcherModalProps {
  pub open : () -> Bool
  pub space_name : () -> String
  pub items : () -> Array[MruTabEntry]
  pub selected_index : () -> Int
  pub on_select_tab : (String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Liquid Glass MRU Tab Switcher Modal (`Ctrl+Tab`, tag `"mru"`).
pub fn build_mru_switcher_modal(root : view::View, props : MruSwitcherModalProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true)).center()
    let _ = layer.box(fn(scrim : view::View) -> Unit {
      let _ = scrim
      .over(view::Live::Is(true))
      .points(view::Live::Is(true))
      .ground(view::Live::By(fn() {
        if lg::is_dark() { 0x05070C80L } else { 0x0F172A38L }
      }))
    })

    let modal_w = fn() -> Double {
      let (vw, _) = overlay_window_size(root)
      let w = vw - 24.0
      if w > 460.0 { 460.0 } else if w < 260.0 { 260.0 } else { w }
    }

    let _ = layer.box(fn(anchor : view::View) -> Unit {
      let _ = anchor.width(view::Live::By(fn() { Some(modal_w()) }))
      let _ = headless::dialog(
        anchor,
        fn() { "Quick Tab Switch" },
        props.open,
        props.on_close,
        fn(dlg : view::View, _d : headless::Dialog) -> Unit {
          let _ = dlg.width(view::Live::By(fn() { Some(modal_w()) }))
          let _ = lg::liquid_dialog_shell_node(dlg, fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() { Some(modal_w()) }))
            .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
            .gap(view::Live::Is(10.0))
            .presses(view::Live::Is(true))
            .on_press(fn() { () })

            // Header
            let _ = shell.box(fn(hdr : view::View) -> Unit {
              let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
              let _ = <ui::Text in={hdr} size={14.0} weight={600} color_by=>{lg::surface().ink} text="Quick Tab Switch" />
              hdr.show(
                fn() { (props.space_name)() != "" },
                fn(sp : view::View) -> Unit {
                  let _ = sp
                  .padding(view::Live::Is((7.0, 2.0, 7.0, 2.0)))
                  .radius(view::Live::Is(lg::r_chip))
                  .rigid()
                  .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                  let _ = <ui::Text in={sp} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text_by=>{(props.space_name)()} />
                },
              )
              let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
              let _ = hdr.box(fn(hk : view::View) -> Unit {
                let _ = hk
                .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                .radius(view::Live::Is(lg::r_chip))
                .rigid()
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                let _ = <ui::Text in={hk} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Ctrl+Tab" />
              })
            })

            // Keyed MRU tab list
            let _ = shell.box(fn(list_box : view::View) -> Unit {
              let _ = list_box.gap(view::Live::Is(4.0))
              list_box.each(
                props.items,
                fn(it : MruTabEntry) -> String { it.tab_id },
                fn(slot : view::View, it_sig : signals::Signal[MruTabEntry]) -> Unit {
                  let is_sel = fn() -> Bool {
                    let all = (props.items)()
                    let sel_i = (props.selected_index)()
                    let cur_id = it_sig.get().tab_id
                    sel_i >= 0 && sel_i < all.length() && all[sel_i].tab_id == cur_id
                  }
                  let _ = headless::button(
                    slot,
                    fn() { "Switch to \{it_sig.get().title}" },
                    fn(_e) -> Unit { (props.on_select_tab)(it_sig.untracked().tab_id) },
                    fn(row : view::View, btn : headless::Button) -> Unit {
                      let _ = row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .min_height(view::Live::Is(Some(40.0)))
                      .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
                      .gap(view::Live::Is(8.0))
                      .radius(view::Live::Is(lg::r_row))
                      .ground(view::Live::By(fn() {
                        if is_sel() {
                          lg::surface().row_selected
                        } else if btn.hovered() || btn.pressed() {
                          lg::surface().row_hover
                        } else {
                          0x00000000L
                        }
                      }))
                      let _ = shell_icon(
                        row,
                        ICON_GLOBE,
                        size=14.0,
                        color_by=fn() { if is_sel() { lg::surface().accent } else { lg::surface().ink_secondary } },
                      )
                      let _ = row.box(fn(col : view::View) -> Unit {
                        let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(1.0))
                        let _ = <ui::Text in={col} size={12.5} weight={600} color_by=>{lg::surface().ink} text_by=>{it_sig.get().title} />.allow_ellipsis(view::Live::Is(true))
                        let _ = <ui::Text in={col} size={11.0} color_by=>{lg::surface().ink_secondary} text_by=>{it_sig.get().host} />.allow_ellipsis(view::Live::Is(true))
                      })
                      row.show(fn() { it_sig.get().playing }, fn(ic : view::View) -> Unit {
                        let _ = shell_icon(ic, ICON_VOLUME, size=13.0, color_by=fn() { lg::surface().positive })
                      })
                    },
                  )
                },
              )
            })
          })
        },
        modal=true,
        close_on_escape=true,
        close_on_outside=true,
      )
    })
  })
}
