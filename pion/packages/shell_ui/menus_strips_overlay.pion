///| Shell 3 strips, menus and small overlays:
///| - Bookmarks bar (`top_strip` slot): chips straight on the frame, washes on hover, one star button.
///| - Page details HUD: the page's own numbers from the host, in two grouped lists.
///| - Tab hover preview: site tile, title, host, a quiet status line.
///| - Context menus `page_ctx`, `tab_ctx`, `bm_bar_ctx` and the Back/Forward list `nav_hist`: `lg` menus with one
///|   icon column, right-aligned shortcuts, separators cleaned (never doubled, never first or last).
///| - Folder settings `folder_ctx` and Customize Space `space_theme`: grouped lists (name, color, toggles).
///| - Recent tabs switcher `mru` (`Ctrl+Tab`): Arc's one strip of preview cells, no header, no hints.
///|
///| Invariants: every callback carries its stable `tab_id` / `folder_id` / `owner_pane`; floating panels are one
///| layer of `lg` glass with solid content inside; every size comes from the `SP_*` / `TX_*` / `IC_*` scales.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// Shared pieces (private to this file)
// ============================================================================

let MSO_TILE_BOOKMARK : Int64 = 0xFF9500FFL // orange
let MSO_TILE_GRAY : Int64 = 0x8E8E93FFL // gray
let MSO_TILE_RED : Int64 = 0xFF3B30FFL // red

///| A site tile whose icon is the site's own (`site_by`: its host as it is) and whose letter and color, when it
///| has none, come from the host a tile should name (`mso_tile_host`).
fn mso_site_tile(parent : view::View, site_by : () -> String, size~ : Double = SP_16) -> view::View {
  shell_favicon_tile(
    parent,
    site_by,
    size=size,
    letter_by=fn() { shell_site_monogram(mso_tile_host(site_by())) },
    ground_by=fn() { shell_site_color(mso_tile_host(site_by())) },
  )
}

///| The host a site tile should name: a short language or mobile label (`en.`, `m.`) is dropped, so
///| `en.wikipedia.org` reads as W, not E.
fn mso_tile_host(url_or_host : String) -> String {
  let host = if url_or_host.contains("/") { shell_url_parts(url_or_host).0 } else { url_or_host }
  let mut dots = 0
  let mut first = -1
  let mut i = 0
  while i < host.length() {
    if host.code_unit_at(i).to_int() == 0x2E {
      dots += 1
      if first < 0 {
        first = i
      }
    }
    i += 1
  }
  if dots >= 2 && first > 0 && first <= 2 {
    host.slice(first + 1, host.length())
  } else {
    host
  }
}

///| A bookmark chip title, cut to 24 characters with an ellipsis (chips never squeeze each other).
fn mso_chip_title(title : String) -> String {
  let t = title.trim()
  if t.length() > 24 { t.slice(0, 23).trim() + "…" } else { t }
}

fn menu_shortcut(mac : String, other : String) -> String {
  if ui::keys_apple() { mac } else { other }
}

///| Where a popover placed by `compute_popover_placement` grows from (the side facing its trigger).
fn mso_popover_origin(
  trigger : Option[AnchorRect],
  capsule : AnchorRect,
  vw : Double,
  vh : Double,
  pw : Double,
  ph : Double,
) -> (Double, Double) {
  let (px, py) = compute_popover_placement(trigger, capsule, vw, vh, pw, ph)
  let anchor = match trigger {
    Some(tr) if tr.is_valid() => tr
    _ => capsule
  }
  shell_popover_origin(anchor, px, py, pw, ph)
}

///| Where a popover placed at a point by `compute_menu_placement` grows from: that point, as fractions of it.
fn mso_point_origin(ax : Double, ay : Double, px : Double, py : Double, pw : Double, ph : Double) -> (Double, Double) {
  let fx = if pw > 0.0 { (ax - px) / pw } else { 0.0 }
  let fy = if ph > 0.0 { (ay - py) / ph } else { 0.0 }
  (if fx < 0.0 { 0.0 } else if fx > 1.0 { 1.0 } else { fx }, if fy < 0.0 { 0.0 } else if fy > 1.0 { 1.0 } else { fy })
}

///| The window's root view, where a menu opened from a strip must mount so nothing clips it.
fn mso_top(v : view::View) -> view::View {
  let mut cur = v
  let mut up = v.parent()
  while up.is_some() {
    match up {
      Some(p) => {
        cur = p
        up = p.parent()
      }
      None => ()
    }
  }
  cur
}

///| A flat 32pt icon button for the panels that are not handed the `ShellModel` (`shell_frame_icon_btn` and
///| `capsule_icon_btn` read the theme from it): no face at rest, an eased wash on hover. `on_frame` picks the
///| frame wash (translucent white over the Space tint) instead of the content-layer row hover.
fn mso_icon_btn(
  parent : view::View,
  label : () -> String,
  icon_by : () -> String,
  color_by : () -> Int64,
  on_press : () -> Unit,
  on_frame~ : Bool = false,
) -> Unit {
  let _ = headless::button(
    parent,
    label,
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      shell_press(b, fn() { btn.pressed() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .ground(view::Live::By(fn() {
        let wash = if on_frame { shell_wash_hover(lg::is_dark()) } else { lg::surface().row_hover }
        lg::alpha(wash, hover_t())
      }))
      let _ = shell_icon_by(b, icon_by, size=IC_MD, color_by=color_by)
    },
  )
}

///| A grouped list section: the shared `settings_group` when it has a caption; a bare card otherwise (so no empty
///| caption line is laid out above it).
fn mso_group(parent : view::View, caption : String, footnote : String, rows : (view::View) -> Unit) -> Unit {
  if caption != "" {
    settings_group(parent, caption, footnote, rows)
  } else {
    let _ = lg::surface_card_node(parent, rows, radius=SP_12, pad=SP_0)
  }
}

///| Hairline between label / value rows (they have no tile, so the rule starts at the row padding).
fn mso_value_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((SP_12, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| A label / value row (no tile) for read-only numbers: min 40pt like every grouped row, value right-aligned.
fn mso_value_row(
  parent : view::View,
  label : String,
  value_by : () -> String,
  value_color~ : () -> Int64 = fn() { lg::surface().ink },
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_6, SP_12, SP_6)))
    .gap(view::Live::Is(SP_12))
    let _ = row.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink_secondary} text={label} />
    })
    <ui::Text in={row} size={TX_BODY} weight={500} lines={1} color_by=>{value_color()} text_by=>{value_by()} />
  })
}

///| A destructive row of a grouped card (`settings_row`'s shape, red tile, label in the danger ink).
fn mso_danger_row(parent : view::View, icon_name : String, label : String) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_6, SP_12, SP_6)))
    .gap(view::Live::Is(SP_12))
    let _ = shell_glyph_tile(row, icon_name, fn() { MSO_TILE_RED }, size=SP_24)
    <ui::Text in={row} size={TX_BODY} lines={1} color_by=>{lg::surface().danger} text={label} />
  })
}

///| Popover header: glyph tile, title, close button (one 32pt row).
fn mso_popover_header(
  parent : view::View,
  icon_name : String,
  tile_color : () -> Int64,
  title_by : () -> String,
  close_label : String,
  on_close : () -> Unit,
) -> Unit {
  let _ = parent.box(fn(hdr : view::View) -> Unit {
    let _ = hdr
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(SP_12))
    .padding(view::Live::Is((SP_12, SP_4, SP_4, SP_0)))
    .rigid()
    let _ = shell_glyph_tile(hdr, icon_name, tile_color, size=SP_24)
    let _ = hdr.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={tw} size={TX_BODY} weight={600} lines={1} color_by=>{lg::surface().ink} text_by=>{title_by()} />
    })
    mso_icon_btn(
      hdr,
      fn() { close_label },
      fn() { ICON_CLOSE },
      fn() { lg::surface().ink_secondary },
      on_close,
    )
  })
}

///| Name editor inside a grouped card: a borderless field and a Save button (Return also saves).
fn mso_name_editor(
  parent : view::View,
  field : ui::Field,
  placeholder : String,
  save_label : String,
  on_save : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
    .gap(view::Live::Is(SP_8))
    let _ = row.box(fn(fw : view::View) -> Unit {
      let _ = fw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
      let _ = ui::field(
        fw,
        field,
        placeholder=placeholder,
        font_size=TX_BODY,
        max_lines=1,
        enter_sends=true,
        colors_by=fn() { (lg::surface().ink, lg::surface().ink_tertiary, lg::surface().accent) },
        submitted=fn(txt : String) -> Unit { on_save(txt) },
      )
    })
    let _ = lg::liquid_button_node(
      row,
      fn() { save_label },
      fn() -> Unit { on_save(field.text()) },
      content=fn(inner : view::View) -> Unit {
        <ui::Text in={inner} size={TX_BODY} weight={500} color_by=>{lg::surface().accent} text="Save" />
      },
      flat=true,
      ghost=true,
      height=SP_32,
      pad_x=SP_4,
    )
  })
}

///| A row of round color swatches inside a grouped card. The chosen one carries a white check and an outer ring in
///| its own color, `SP_2` away from the swatch (the macOS selection ring), so the color itself is never darkened.
fn mso_swatches(
  parent : view::View,
  palette : Array[String],
  label_prefix : String,
  is_chosen : (String) -> Bool,
  on_pick : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(sw_row : view::View) -> Unit {
    let _ = sw_row
    .row(view::Live::Is(true))
    .wraps(view::Live::Is(Some(SP_6)))
    .gap(view::Live::Is(SP_6))
    // The ring holders start on the label column (`SP_12`), clear of the card's 12pt corner arcs.
    .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
    let mut i = 0
    while i < palette.length() {
      let hex = palette[i]
      let rgba = proto::workspace_accent_color(hex)
      let _ = headless::button(
        sw_row,
        fn() { label_prefix + hex },
        fn(_e) -> Unit { on_pick(hex) },
        fn(holder : view::View, btn : headless::Button) -> Unit {
          let chosen = fn() -> Bool { is_chosen(hex) }
          let ring_t = shell_fade(holder, chosen)
          let hover_t = shell_fade(holder, fn() { btn.hovered() && !chosen() })
          let _ = holder
          .width(view::Live::Is(Some(SP_32)))
          .height(view::Live::Is(Some(SP_32)))
          .radius(view::Live::Is(SP_16))
          .center()
          .rigid()
          .edge(view::Live::By(fn() {
            let ring = if ring_t() > hover_t() { ring_t() } else { hover_t() * 0.4 }
            (SP_2, lg::alpha(rgba, ring))
          }))
          let _ = holder.box(fn(sw : view::View) -> Unit {
            let _ = sw
            .width(view::Live::Is(Some(SP_24)))
            .height(view::Live::Is(Some(SP_24)))
            .radius(view::Live::Is(SP_12))
            .center()
            .points(view::Live::Is(false))
            .ground(view::Live::Is(rgba))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::alpha(0x000000FFL, 0.12)) }))
            sw.show(chosen, fn(ck : view::View) -> Unit {
              let _ = shell_icon(ck, ICON_CHECK, size=IC_SM, color_by=fn() { 0xFFFFFFFFL })
            })
          })
        },
      )
      i += 1
    }
  })
}

///| A menu's entries, cleaned as they are added (a separator is never first, last or doubled, as `lg` would show
///| them), with the height they take in an `lg` menu: used to place the menu until it has been measured.
struct MsoMenu {
  entries : Array[lg::LiquidMenuEntry]
  seps : Array[Bool]
}

fn MsoMenu::new() -> MsoMenu {
  MsoMenu::{ entries: [], seps: [] }
}

fn MsoMenu::add(self : MsoMenu, e : lg::LiquidMenuEntry) -> Unit {
  self.entries.push(e)
  self.seps.push(false)
}

fn MsoMenu::sep(self : MsoMenu) -> Unit {
  let n = self.seps.length()
  if n > 0 && !self.seps[n - 1] {
    self.entries.push(lg::LiquidMenuEntry::separator())
    self.seps.push(true)
  }
}

///| Drops a trailing separator; call once all entries are added.
fn MsoMenu::done(self : MsoMenu) -> MsoMenu {
  let n = self.seps.length()
  if n > 0 && self.seps[n - 1] {
    let _ = self.entries.pop()
    let _ = self.seps.pop()
  }
  self
}

///| Height of the `lg` menu: `SP_6` padding top and bottom, 32pt items, separators of `SP_4` padding above and below
///| a hairline, `SP_2` between rows, and the header line when there is one.
fn MsoMenu::height(self : MsoMenu, has_header~ : Bool = false) -> Double {
  let n = self.seps.length()
  let mut h = SP_6 + SP_6 + (if has_header { SP_24 + SP_2 } else { SP_0 })
  let mut i = 0
  while i < n {
    h = h + (if self.seps[i] { SP_8 + lg::hairline_w } else { SP_32 })
    if i > 0 {
      h = h + SP_2
    }
    i += 1
  }
  h
}

///| Height a placed panel really has once laid out, else `fallback` (the first frame, before it is measured).
fn mso_measured_h(v : view::View, fallback : Double) -> Double {
  match v.laid_size_told() {
    Some((_, h)) if h > SP_0 => h
    _ => fallback
  }
}

///| Top of a point-anchored menu `h` tall: at the pointer when it fits below, above the pointer when it fits there,
///| else as low as the window allows (shifted up just enough, the macOS way, never flung to the window top).
fn mso_menu_y(anchor_y : Double, h : Double, vh : Double) -> Double {
  let lo = SP_8
  let hi = vh - h - SP_8
  if anchor_y + h <= vh - SP_8 {
    anchor_y
  } else if anchor_y - h >= lo {
    anchor_y - h
  } else if hi > lo {
    hi
  } else {
    lo
  }
}

///| Menu icon: one 16pt glyph, so every row's label starts on the same line.
fn mso_menu_icon(name : String) -> (view::View, () -> Int64) -> Unit {
  fn(ic : view::View, ink : () -> Int64) -> Unit { let _ = shell_icon(ic, name, size=IC_MD, color_by=ink) }
}

// ============================================================================
// 1. Bookmarks Bar Strip (mounts in the `top_strip` slot, straight on the frame)
// ============================================================================

pub struct BookmarkChipItem {
  pub id : String
  pub title : String
  pub url : String
}

pub struct BookmarksBarProps {
  pub open : () -> Bool
  pub items : () -> Array[BookmarkChipItem]
  pub page_saved : () -> Bool
  pub on_navigate : (String) -> Unit
  pub on_context_menu : (String, String, Double, Double) -> Unit
  pub on_toggle_bookmark : () -> Unit
}

///| Width a chip takes: `SP_8` lead, 16pt site tile, `SP_8` gap, the title, `SP_10` trail.
fn mso_chip_width(bm : BookmarkChipItem) -> Double {
  let tw = ui::measure_text_width(mso_chip_title(bm.title), TX_FOOTNOTE, weight=500)
  SP_8 + SP_16 + SP_8 + tw + SP_2 + SP_10
}

///| How many chips fit whole in `avail` (the chips' area, the overflow button included when some do not fit).
///| Before the strip is measured (`avail` 0) every chip is shown.
fn mso_chips_fit(items : Array[BookmarkChipItem], avail : Double) -> Int {
  let n = items.length()
  if avail <= SP_0 {
    return n
  }
  let widths : Array[Double] = []
  let mut total = SP_0
  let mut i = 0
  while i < n {
    let w = mso_chip_width(items[i])
    widths.push(w)
    total = total + w + (if i > 0 { SP_2 } else { SP_0 })
    i += 1
  }
  if total <= avail {
    return n
  }
  let room = avail - SP_32 - SP_4
  let mut used = SP_0
  let mut k = 0
  while k < n {
    let w = widths[k] + (if k > 0 { SP_2 } else { SP_0 })
    if used + w > room {
      break
    }
    used = used + w
    k += 1
  }
  k
}

///| Builds the Bookmarks Bar for the `top_strip` slot: it sits on the window frame (no box of its own, no rule),
///| chips are a site tile + title with a frame wash on hover. Left-click navigates; right-click opens `bm_bar_ctx`.
///| Only chips that fit whole are shown; the rest are one click away in the overflow menu before the star.
///| Beside the docked sidebar the strip takes the window's top 40pt row, so its chips center on the same line as
///| the sidebar's Back / Forward / Reload buttons.
pub fn build_bookmarks_bar_strip(parent : view::View, props : BookmarksBarProps) -> Unit {
  let overflow_open = signals::signal(false)
  parent.show(props.open, fn(strip : view::View) -> Unit {
    let at_window_top = fn() -> Bool {
      let _ = parent.laid_size_told()
      let (_, py, _, _) = parent.placed_window_now()
      py < SP_4
    }
    let _ = strip
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::By(fn() { Some(if at_window_top() { SP_40 } else { SP_32 }) }))
    .margin(view::Live::By(fn() { (SP_0, if at_window_top() { SP_0 - SP_8 } else { SP_0 }, SP_0, SP_0) }))
    .rigid()
    .gap(view::Live::Is(SP_4))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Bookmarks Bar"))))

    let _ = strip.box(fn(area : view::View) -> Unit {
      let _ = area
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      .gap(view::Live::Is(SP_4))
      let fit = fn() -> Int {
        let avail = match area.laid_size_told() {
          Some((w, _)) => w
          None => SP_0
        }
        mso_chips_fit((props.items)(), avail)
      }
      let shown = fn() -> Array[BookmarkChipItem] {
        let all = (props.items)()
        let k = fit()
        let out : Array[BookmarkChipItem] = []
        let mut i = 0
        while i < k && i < all.length() {
          out.push(all[i])
          i += 1
        }
        out
      }
      let hidden = fn() -> Array[BookmarkChipItem] {
        let all = (props.items)()
        let out : Array[BookmarkChipItem] = []
        let mut i = fit()
        while i < all.length() {
          out.push(all[i])
          i += 1
        }
        out
      }

      let _ = area.box(fn(chips : view::View) -> Unit {
        let _ = chips
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(SP_2))

        chips.show(
          fn() { (props.items)().length() == 0 },
          fn(emp : view::View) -> Unit {
            let _ = emp.padding(view::Live::Is((SP_8, SP_0, SP_0, SP_0)))
            <ui::Text
              in={emp}
              size={TX_FOOTNOTE}
              color_by=>{shell_frame_ink_tertiary(lg::is_dark())}
              text="Bookmarks you save appear here"
            />
          },
        )

        chips.each(
          shown,
          fn(bm : BookmarkChipItem) -> String { bm.id },
          fn(slot : view::View, bm_sig : signals::Signal[BookmarkChipItem]) -> Unit {
            let _ = slot.rigid()
            let _ = headless::button(
              slot,
              fn() { "Open bookmark \{bm_sig.get().title}" },
              fn(_e) -> Unit { (props.on_navigate)(bm_sig.untracked().url) },
              fn(chip : view::View, btn : headless::Button) -> Unit {
                let hover_t = shell_fade(chip, fn() { btn.hovered() || btn.pressed() })
                let _ = chip
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(SP_32)))
                .rigid()
                .padding(view::Live::Is((SP_8, SP_0, SP_10, SP_0)))
                .gap(view::Live::Is(SP_8))
                .radius(view::Live::Is(SP_8))
                .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(lg::is_dark()), hover_t()) }))
                .on_menu(fn(_m : view::Menu) -> Unit {
                  let (cx, cy, _, ch) = chip.placed_window_now()
                  let cur = bm_sig.untracked()
                  (props.on_context_menu)(cur.id, cur.url, cx, cy + ch + SP_4)
                })
                let _ = mso_site_tile(chip, fn() { proto::omnibox_display_host(bm_sig.get().url) }, size=SP_16)
                let _ = <ui::Text
                  in={chip}
                  size={TX_FOOTNOTE}
                  weight={500}
                  lines={1}
                  color_by=>{
                    if btn.hovered() || btn.pressed() {
                      lg::surface().ink
                    } else {
                      shell_frame_ink_secondary(lg::is_dark())
                    }
                  }
                  text_by=>{mso_chip_title(bm_sig.get().title)}
                />.rigid()
              },
            )
          },
        )
      })

      // Overflow: the bookmarks that do not fit whole, as a menu with their site tiles.
      area.show(fn() { hidden().length() > 0 }, fn(ov : view::View) -> Unit {
        let _ = ov.rigid()
        let _ = shell_menu_node(
          ov,
          mso_top(strip),
          fn() { overflow_open.get() },
          fn(v : Bool) -> Unit { overflow_open.set(v) },
          fn() { "More Bookmarks" },
          fn(trig : view::View, disc : headless::Disclosure) -> Unit {
            let hover_t = shell_fade(trig, fn() { disc.open() || disc.hovered() })
            let _ = trig
            .width(view::Live::Is(Some(SP_32)))
            .height(view::Live::Is(Some(SP_32)))
            .radius(view::Live::Is(SP_8))
            .rigid()
            .center()
            .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(lg::is_dark()), hover_t()) }))
            let _ = shell_icon(trig, ICON_CHEVRON_DOWN, size=IC_MD, color_by=fn() { shell_frame_ink_secondary(lg::is_dark()) })
          },
          fn() -> Array[lg::LiquidMenuEntry] {
            let rest = hidden()
            let out : Array[lg::LiquidMenuEntry] = []
            let mut i = 0
            while i < rest.length() {
              let bm = rest[i]
              let site = proto::omnibox_display_host(bm.url)
              out.push(lg::LiquidMenuEntry::item(
                label=bm.title,
                icon=fn(ic : view::View, _ink : () -> Int64) -> Unit { let _ = mso_site_tile(ic, fn() { site }, size=SP_16) },
                on_select=fn() { (props.on_navigate)(bm.url) },
              ))
              i += 1
            }
            out
          },
          menu_label=fn() { "More Bookmarks" },
        )
      })
    })

    // Bookmark this page: one star, filled orange once saved.
    mso_icon_btn(
      strip,
      fn() { if (props.page_saved)() { "Remove Bookmark" } else { "Bookmark Page" } },
      fn() { if (props.page_saved)() { ICON_STAR_FILLED } else { ICON_STAR } },
      fn() { if (props.page_saved)() { MSO_TILE_BOOKMARK } else { shell_frame_ink_secondary(lg::is_dark()) } },
      props.on_toggle_bookmark,
      on_frame=true,
    )
  })
}

// ============================================================================
// 2. Page details HUD (real host metrics only)
// ============================================================================

pub struct PerfHudMetrics {
  pub host_label : String
  pub scheme : String
  pub tls_secure : Bool
  pub dom_nodes : Int
  pub stylesheets : Int
  pub images : Int
  pub doc_width : Int
  pub doc_height : Int
  pub zoom_percent : Int
  pub cookies_count : Int
  pub space_name : String
  pub space_accent : Int64
}

pub struct PerfHudProps {
  pub open : () -> Bool
  pub metrics : () -> PerfHudMetrics
  pub top_offset : () -> Double
  pub on_refresh : () -> Unit
  pub on_close : () -> Unit
}

fn hud_connection_label(m : PerfHudMetrics) -> String {
  let badge = proto::perf_hud_security_badge(m.scheme, m.tls_secure)
  if badge == "HTTPS" {
    "Secure (HTTPS)"
  } else if badge == "LOCAL" {
    "Local file"
  } else {
    "Not secure (HTTP)"
  }
}

///| The Connection value's color, from the same badge as its words: secure green, a local file quiet, plain HTTP
///| orange (a local file is not an insecure page).
fn hud_connection_color(m : PerfHudMetrics) -> Int64 {
  let badge = proto::perf_hud_security_badge(m.scheme, m.tls_secure)
  if badge == "HTTPS" {
    lg::surface().positive
  } else if badge == "LOCAL" {
    lg::surface().ink_secondary
  } else {
    lg::surface().warning
  }
}

///| Builds the Page details HUD pinned to the top right of the page: the site, then two grouped lists of the
///| numbers the host reports (connection, zoom, cookies; elements, stylesheets, images, document size).
pub fn build_perf_hud_overlay(root : view::View, props : PerfHudProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over_at(view::Live::By(fn() { (None, Some((props.top_offset)()), Some(SP_16), None) }))

    let _ = lg::liquid_panel_shell_node(
      layer,
      fn(card : view::View) -> Unit {
        let _ = card
        .width(view::Live::Is(Some(SP_160 + SP_128)))
        .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
        .gap(view::Live::Is(SP_16))
        .presses(view::Live::Is(true))
        .on_press(fn() { () })
        .says(view::Live::Is(Some(view::said(view::Role::Region, label="Page details"))))

        // Site + actions
        let _ = card.box(fn(hdr : view::View) -> Unit {
          let _ = hdr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(SP_10))
          .padding(view::Live::Is((SP_4, SP_0, SP_0, SP_0)))
          .rigid()
          let _ = mso_site_tile(hdr, fn() { (props.metrics)().host_label }, size=SP_32)
          let _ = hdr.box(fn(col : view::View) -> Unit {
            let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
            <ui::Text in={col} size={TX_BODY} weight={600} color_by=>{lg::surface().ink} text="Page details" />
            <ui::Text
              in={col}
              size={TX_FOOTNOTE}
              lines={1}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{(props.metrics)().host_label}
            />
          })
          mso_icon_btn(hdr, fn() { "Refresh Page Details" }, fn() { ICON_RELOAD }, fn() { lg::surface().ink_secondary }, props.on_refresh)
          mso_icon_btn(hdr, fn() { "Close Page Details" }, fn() { ICON_CLOSE }, fn() { lg::surface().ink_secondary }, props.on_close)
        })

        mso_group(card, "This site", "", fn(g : view::View) -> Unit {
          mso_value_row(
            g,
            "Connection",
            fn() { hud_connection_label((props.metrics)()) },
            value_color=fn() { hud_connection_color((props.metrics)()) },
          )
          mso_value_rule(g)
          mso_value_row(g, "Zoom", fn() { "\{(props.metrics)().zoom_percent}%" })
          mso_value_rule(g)
          mso_value_row(g, "Cookies", fn() { (props.metrics)().cookies_count.to_string() })
        })

        mso_group(card, "Document", "", fn(g : view::View) -> Unit {
          mso_value_row(g, "DOM nodes", fn() { (props.metrics)().dom_nodes.to_string() })
          mso_value_rule(g)
          mso_value_row(g, "Stylesheets", fn() { (props.metrics)().stylesheets.to_string() })
          mso_value_rule(g)
          mso_value_row(g, "Images", fn() { (props.metrics)().images.to_string() })
          mso_value_rule(g)
          mso_value_row(g, "Document size", fn() {
            let m = (props.metrics)()
            "\{m.doc_width} × \{m.doc_height}"
          })
        })
      },
      radius=SP_24,
    )
  })
}

// ============================================================================
// 3. Tab Hover Preview Card
// ============================================================================

pub struct TabHoverPreviewSnapshot {
  pub tab_id : String
  pub title : String
  pub clean_host : String
  pub space_name : String
  pub playing : Bool
  pub muted : Bool
  pub in_split : Bool
  pub in_reader : Bool
}

pub struct TabHoverPreviewProps {
  pub open : () -> Bool
  pub snapshot : () -> Option[TabHoverPreviewSnapshot]
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
}

///| Builds the floating Tab Hover Preview (click-through): site tile, title (two lines), host, and a status line
///| only when the tab is playing, muted, in Split View or in Reader.
pub fn build_tab_hover_preview_card(root : view::View, props : TabHoverPreviewProps) -> Unit {
  // Wide enough for the longest status line (Muted, Split View, Reader) on one line.
  let card_w = SP_160 + SP_128
  let card_h = SP_96
  let snap_has = fn(f : (TabHoverPreviewSnapshot) -> Bool) -> Bool {
    match (props.snapshot)() {
      Some(s) => f(s)
      None => false
    }
  }
  // Tooltip-class: the first card fades in with a 0.98 -> 1 scale over MO_TIP_MS from the edge facing the
  // hovered tab (after the host's dwell, never adding to it). While it is open, moving to another tab swaps the
  // snapshot at once, and a card opened again within MO_TIP_WARM_MS of the last one closing is there at once
  // ("instant after the first"). It goes at once. Already open when built: there at once.
  let is_up = fn() -> Bool { (props.open)() && (props.snapshot)().is_some() }
  let built : signals::Ref[Bool] = ui::ref_new(false)
  let gone_at : signals::Ref[Double] = ui::ref_new(-1.0e9)
  root.reacts(is_up, fn(on : Bool) -> Unit {
    if !on {
      gone_at.v = root.cause_at()
    }
  }, at_start=false)
  root.show(
    is_up,
    fn(layer : view::View) -> Unit {
      let warm = layer.cause_at() - gone_at.v < MO_TIP_WARM_MS
      let reveal = shell_reveal(layer, built.v && !warm, enter_ms=MO_TIP_MS, exit_ms=0.0, from_scale=MO_TIP_SCALE)
      layer.reacts(fn() {
        match (props.snapshot)() {
          Some(sn) => sn.tab_id
          None => ""
        }
      }, fn(_id : String) -> Unit { reveal.settle() }, at_start=false)
      let (ox, oy) = signals::untracked(fn() {
        let (vw, vh) = overlay_window_size(root)
        let ax = (props.anchor_x)()
        let ay = (props.anchor_y)()
        let (px, py) = compute_menu_placement(ax, ay, vw, vh, card_w, card_h)
        mso_point_origin(ax, ay, px, py, card_w, card_h)
      })
      reveal.grows(layer, ox=ox, oy=oy)
      let _ = layer
      .over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement((props.anchor_x)(), (props.anchor_y)(), vw, vh, card_w, card_h)
        (Some(px), Some(py), None, None)
      }))
      .points(view::Live::Is(false))

      let _ = lg::liquid_panel_shell_node(
        layer,
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(card_w)))
          .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
          .gap(view::Live::Is(SP_8))
          .points(view::Live::Is(false))

          let _ = card.box(fn(top : view::View) -> Unit {
            let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_10)).rigid()
            // 20pt tile: its center sits on the title's first line.
            let _ = top.box(fn(tw : view::View) -> Unit {
              let _ = tw.rigid()
              let _ = mso_site_tile(
                tw,
                fn() {
                  match (props.snapshot)() {
                    Some(s) => s.clean_host
                    None => ""
                  }
                },
                size=SP_20,
              )
            })
            let _ = top.box(fn(col : view::View) -> Unit {
              let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
              <ui::Text
                in={col}
                size={TX_BODY}
                weight={500}
                lines={2}
                color_by=>{lg::surface().ink}
                text_by=>{
                  match (props.snapshot)() {
                    Some(s) => s.title
                    None => ""
                  }
                }
              />
              <ui::Text
                in={col}
                size={TX_FOOTNOTE}
                lines={1}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{
                  match (props.snapshot)() {
                    Some(s) => s.clean_host
                    None => ""
                  }
                }
              />
            })
          })

          // Status line (only what is true right now).
          card.show(
            fn() { snap_has(fn(s) { s.playing || s.muted || s.in_split || s.in_reader }) },
            fn(st : view::View) -> Unit {
              let _ = st
              .row(view::Live::Is(true))
              .wraps(view::Live::Is(Some(SP_4)))
              .gap(view::Live::Is(SP_12))
              .padding(view::Live::Is((SP_20 + SP_10, SP_0, SP_0, SP_0)))
              .rigid()
              let status = fn(cond : () -> Bool, icon_name : String, label : String, ink : () -> Int64) -> Unit {
                st.show(cond, fn(b : view::View) -> Unit {
                  let _ = b.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4))
                  let _ = shell_icon(b, icon_name, size=IC_SM, color_by=ink)
                  <ui::Text in={b} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={label} />
                })
              }
              status(fn() { snap_has(fn(s) { s.playing && !s.muted }) }, ICON_VOLUME, "Playing", fn() { lg::surface().positive })
              status(fn() { snap_has(fn(s) { s.muted }) }, ICON_VOLUME_MUTE, "Muted", fn() { lg::surface().ink_secondary })
              status(fn() { snap_has(fn(s) { s.in_split }) }, ICON_SPLIT, "Split View", fn() { lg::surface().accent })
              status(fn() { snap_has(fn(s) { s.in_reader }) }, ICON_READER, "Reader", fn() { MSO_TILE_BOOKMARK })
            },
          )
        },
        radius=SP_20,
      )
    },
  )
  built.v = true
}

// ============================================================================
// 4. Context menus (`page_ctx`, `tab_ctx`, `bm_bar_ctx`)
// ============================================================================

///| A context menu at a point: dismiss scrim, then the `lg` menu placed by its measured height (by the entries'
///| height until it is first laid out), so it opens at the pointer whenever it fits below it. It comes in like
///| every shell menu (`shell_popover_reveal`, the one menu rule in DESIGN.md section 4), grown out of the pointer
///| point; a person's close from inside it (the scrim, an item, Escape) plays its way out. Already open when
///| built: there at once.
fn build_anchored_menu_overlay(
  root : view::View,
  open : () -> Bool,
  anchor_x : () -> Double,
  anchor_y : () -> Double,
  menu_w : Double,
  menu_label : String,
  menu : () -> MsoMenu,
  on_close : () -> Unit,
) -> Unit {
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, on_close)
    let reveal = shell_popover_reveal(layer, built.v)
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let est_h = mso_measured_h(pos, menu().height())
        let (px, _) = compute_menu_placement(anchor_x(), anchor_y(), vw, vh, menu_w, est_h)
        (Some(px), Some(mso_menu_y(anchor_y(), est_h, vh)), None, None)
      }))
      let (ox, oy) = signals::untracked(fn() {
        let (vw, vh) = overlay_window_size(root)
        let ax = anchor_x()
        let ay = anchor_y()
        let est_h = menu().height()
        let (px, _) = compute_menu_placement(ax, ay, vw, vh, menu_w, est_h)
        mso_point_origin(ax, ay, px, mso_menu_y(ay, est_h, vh), menu_w, est_h)
      })
      reveal.grows(pos, ox=ox, oy=oy)
      let _ = lg::liquid_menu_panel_node(
        pos,
        fn() { menu().entries },
        close_now,
        menu_label=fn() { menu_label },
        min_width=menu_w,
      )
    })
  })
  built.v = true
}

///| Hit-test context payload for `PageContextMenu` (`page_ctx`).
pub struct PageContextTarget {
  pub link_url : String
  pub image_url : String
  pub selection_text : String
  pub can_back : Bool
  pub can_forward : Bool
}

pub struct PageContextCallbacks {
  pub on_open_peek : (String) -> Unit
  pub on_open_split : (String) -> Unit
  pub on_open_new_tab : (String) -> Unit
  pub on_copy_link : (String) -> Unit
  pub on_open_image : (String) -> Unit
  pub on_copy_image_url : (String) -> Unit
  pub on_copy_selection : (String) -> Unit
  pub on_search_selection : (String) -> Unit
  pub on_back : () -> Unit
  pub on_forward : () -> Unit
  pub on_reload : () -> Unit
  pub on_copy_page_url : () -> Unit
  pub on_close : () -> Unit
}

pub struct PageContextMenuProps {
  pub open : () -> Bool
  pub target : () -> PageContextTarget
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : PageContextCallbacks
}

///| Builds the webpage context menu (tag `"page_ctx"`): link, image and selection groups when present, then the
///| page group. Back and Forward always keep their place and dim when unavailable, so the menu shape is stable.
pub fn build_page_context_menu(root : view::View, props : PageContextMenuProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    SP_160 + SP_96,
    "Page Context Menu",
    fn() -> MsoMenu {
      let t = (props.target)()
      let cb = props.callbacks
      let m = MsoMenu::new()
      if t.link_url != "" {
        let u = t.link_url
        m.add(lg::LiquidMenuEntry::item(
          label="Open Link in New Tab",
          icon=mso_menu_icon(ICON_PLUS),
          on_select=fn() { (cb.on_open_new_tab)(u) },
        ))
        m.add(lg::LiquidMenuEntry::item(
          label="Open Link in Peek",
          icon=mso_menu_icon(ICON_EXTERNAL),
          on_select=fn() { (cb.on_open_peek)(u) },
        ))
        m.add(lg::LiquidMenuEntry::item(
          label="Open Link in Split View",
          icon=mso_menu_icon(ICON_SPLIT),
          on_select=fn() { (cb.on_open_split)(u) },
        ))
        m.add(lg::LiquidMenuEntry::item(
          label="Copy Clean Link",
          icon=mso_menu_icon("link"),
          on_select=fn() { (cb.on_copy_link)(u) },
        ))
        m.sep()
      }
      if t.image_url != "" {
        let img = t.image_url
        m.add(lg::LiquidMenuEntry::item(
          label="Open Image in New Tab",
          icon=mso_menu_icon(ICON_CAMERA),
          on_select=fn() { (cb.on_open_image)(img) },
        ))
        m.add(lg::LiquidMenuEntry::item(
          label="Copy Image URL",
          icon=mso_menu_icon(ICON_COPY),
          on_select=fn() { (cb.on_copy_image_url)(img) },
        ))
        m.sep()
      }
      if t.selection_text != "" {
        let sel = t.selection_text
        m.add(lg::LiquidMenuEntry::item(
          label="Copy Selection",
          shortcut=menu_shortcut("⌘C", "Ctrl+C"),
          icon=mso_menu_icon(ICON_COPY),
          on_select=fn() { (cb.on_copy_selection)(sel) },
        ))
        m.add(lg::LiquidMenuEntry::item(
          label="Search the Web",
          icon=mso_menu_icon(ICON_SEARCH),
          on_select=fn() { (cb.on_search_selection)(sel) },
        ))
        m.sep()
      }
      m.add(lg::LiquidMenuEntry::item(
        label="Back",
        shortcut=menu_shortcut("⌘[", "Alt+Left"),
        icon=mso_menu_icon(ICON_BACK),
        disabled=!t.can_back,
        on_select=cb.on_back,
      ))
      m.add(lg::LiquidMenuEntry::item(
        label="Forward",
        shortcut=menu_shortcut("⌘]", "Alt+Right"),
        icon=mso_menu_icon(ICON_FORWARD),
        disabled=!t.can_forward,
        on_select=cb.on_forward,
      ))
      m.add(lg::LiquidMenuEntry::item(
        label="Reload",
        shortcut=menu_shortcut("⌘R", "Ctrl+R"),
        icon=mso_menu_icon(ICON_RELOAD),
        on_select=cb.on_reload,
      ))
      m.sep()
      m.add(lg::LiquidMenuEntry::item(
        label="Copy Clean Page URL",
        shortcut=menu_shortcut("⇧⌘C", "Ctrl+Shift+C"),
        icon=mso_menu_icon(ICON_COPY),
        on_select=cb.on_copy_page_url,
      ))
      m.done()
    },
    props.callbacks.on_close,
  )
}

///| Target payload for `TabContextMenu` (`tab_ctx`), routed strictly by stable `tab_id`.
pub struct TabContextTarget {
  pub tab_id : String
  pub is_active : Bool
  pub pinned : Bool
  pub favorite : Bool
  pub muted : Bool
  pub folder_id : String
  pub can_close_others : Bool
  pub folders : Array[(String, String)]
  pub spaces : Array[(String, String)]
}

pub struct TabContextCallbacks {
  pub on_open_split : (String) -> Unit
  pub on_open_peek : (String) -> Unit
  pub on_duplicate : (String) -> Unit
  pub on_copy_clean_url : (String) -> Unit
  pub on_toggle_pin : (String) -> Unit
  pub on_toggle_favorite : (String) -> Unit
  pub on_toggle_mute : (String) -> Unit
  pub on_move_to_folder : (String, String) -> Unit
  pub on_move_to_space : (String, String) -> Unit
  pub on_close_others : (String) -> Unit
  pub on_close_tab : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct TabContextMenuProps {
  pub open : () -> Bool
  pub target : () -> TabContextTarget
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : TabContextCallbacks
}

///| Builds the tab context menu (tag `"tab_ctx"`): open, keep (pin / favorite / mute), move, close.
///| Shortcuts show only for the active tab (they act on it). Moves come in two groups, folders of this Space and
///| then the other Spaces (named "<Space> Space"); the app already leaves the current Space out.
pub fn build_tab_context_menu(root : view::View, props : TabContextMenuProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    SP_160 + SP_96,
    "Tab Context Menu",
    fn() -> MsoMenu {
      let t = (props.target)()
      let tid = t.tab_id
      let cb = props.callbacks
      let m = MsoMenu::new()
      m.add(lg::LiquidMenuEntry::item(
        label="Open in Split View",
        icon=mso_menu_icon(ICON_SPLIT),
        on_select=fn() { (cb.on_open_split)(tid) },
      ))
      m.add(lg::LiquidMenuEntry::item(
        label="Open in Peek",
        icon=mso_menu_icon(ICON_EXTERNAL),
        on_select=fn() { (cb.on_open_peek)(tid) },
      ))
      m.add(lg::LiquidMenuEntry::item(
        label="Duplicate Tab",
        icon=mso_menu_icon(ICON_LAYERS),
        on_select=fn() { (cb.on_duplicate)(tid) },
      ))
      m.add(lg::LiquidMenuEntry::item(
        label="Copy Clean URL",
        icon=mso_menu_icon("link"),
        on_select=fn() { (cb.on_copy_clean_url)(tid) },
      ))
      m.sep()
      m.add(lg::LiquidMenuEntry::item(
        label=if t.pinned { "Unpin Tab" } else { "Pin Tab" },
        icon=mso_menu_icon(ICON_PIN),
        on_select=fn() { (cb.on_toggle_pin)(tid) },
      ))
      m.add(lg::LiquidMenuEntry::item(
        label=if t.favorite { "Remove from Favorites" } else { "Add to Favorites" },
        icon=mso_menu_icon(if t.favorite { ICON_STAR_FILLED } else { ICON_STAR }),
        on_select=fn() { (cb.on_toggle_favorite)(tid) },
      ))
      m.add(lg::LiquidMenuEntry::item(
        label=if t.muted { "Unmute Tab" } else { "Mute Tab" },
        shortcut=if t.is_active { menu_shortcut("⌘M", "Ctrl+M") } else { "" },
        icon=mso_menu_icon(if t.muted { ICON_VOLUME } else { ICON_VOLUME_MUTE }),
        on_select=fn() { (cb.on_toggle_mute)(tid) },
      ))
      m.sep()
      // Folders of this Space.
      if t.folder_id != "" {
        m.add(lg::LiquidMenuEntry::item(
          label="Move to Top-Level Pinned",
          icon=mso_menu_icon(ICON_PIN),
          on_select=fn() { (cb.on_move_to_folder)(tid, "") },
        ))
      }
      let mut fj = 0
      while fj < t.folders.length() {
        let (fid, fname) = t.folders[fj]
        if fid != t.folder_id {
          m.add(lg::LiquidMenuEntry::item(
            label="Move to \{fname}",
            icon=mso_menu_icon(ICON_FOLDER),
            on_select=fn() { (cb.on_move_to_folder)(tid, fid) },
          ))
        }
        fj += 1
      }
      m.sep()
      // Other Spaces.
      let mut i = 0
      while i < t.spaces.length() {
        let (sid, sname) = t.spaces[i]
        m.add(lg::LiquidMenuEntry::item(
          label="Move to \{sname} Space",
          icon=mso_menu_icon(ICON_ARROW_RIGHT),
          on_select=fn() { (cb.on_move_to_space)(tid, sid) },
        ))
        i += 1
      }
      m.sep()
      if t.can_close_others {
        m.add(lg::LiquidMenuEntry::item(
          label="Close Other Tabs",
          icon=mso_menu_icon(ICON_CLOSE),
          on_select=fn() { (cb.on_close_others)(tid) },
        ))
      }
      m.add(lg::LiquidMenuEntry::item(
        label="Close Tab",
        shortcut=if t.is_active { menu_shortcut("⌘W", "Ctrl+W") } else { "" },
        destructive=true,
        icon=mso_menu_icon(ICON_CLOSE),
        on_select=fn() { (cb.on_close_tab)(tid) },
      ))
      m.done()
    },
    props.callbacks.on_close,
  )
}

pub struct BookmarksBarContextProps {
  pub open : () -> Bool
  pub bookmark_id : () -> String
  pub bookmark_url : () -> String
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub on_open_split : (String) -> Unit
  pub on_open_peek : (String) -> Unit
  pub on_remove : (String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the bookmarks bar context menu (tag `"bm_bar_ctx"`): open (new tab, Split View, Peek), copy the link,
///| remove. `on_open_new_tab` / `on_copy_link` are optional so existing callers keep compiling; their rows show
///| only when given.
pub fn build_bookmarks_bar_context_menu(
  root : view::View,
  props : BookmarksBarContextProps,
  on_open_new_tab~ : Option[(String) -> Unit] = None,
  on_copy_link~ : Option[(String) -> Unit] = None,
) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    SP_160 + SP_64,
    "Bookmark Context Menu",
    fn() -> MsoMenu {
      let url = (props.bookmark_url)()
      let bid = (props.bookmark_id)()
      let m = MsoMenu::new()
      match on_open_new_tab {
        Some(f) => m.add(lg::LiquidMenuEntry::item(label="Open in New Tab", icon=mso_menu_icon(ICON_PLUS), on_select=fn() { f(url) }))
        None => ()
      }
      m.add(lg::LiquidMenuEntry::item(
        label="Open in Split View",
        icon=mso_menu_icon(ICON_SPLIT),
        on_select=fn() { (props.on_open_split)(url) },
      ))
      m.add(lg::LiquidMenuEntry::item(
        label="Open in Peek",
        icon=mso_menu_icon(ICON_EXTERNAL),
        on_select=fn() { (props.on_open_peek)(url) },
      ))
      match on_copy_link {
        Some(f) => {
          m.sep()
          m.add(lg::LiquidMenuEntry::item(label="Copy Link", icon=mso_menu_icon("link"), on_select=fn() { f(url) }))
        }
        None => ()
      }
      m.sep()
      m.add(lg::LiquidMenuEntry::item(
        label="Remove Bookmark",
        destructive=true,
        icon=mso_menu_icon("trash"),
        on_select=fn() { (props.on_remove)(bid) },
      ))
      m.done()
    },
    props.on_close,
  )
}

// ============================================================================
// 5. Back / Forward history menu (tag: "nav_hist")
// ============================================================================

pub struct NavHistoryItem {
  pub index : Int
  pub title : String
  pub url : String
}

pub struct NavHistoryPopoverProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub is_forward : () -> Bool
  pub entries : () -> Array[NavHistoryItem]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_jump : (Int, Int) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Back / Forward history list (tag `"nav_hist"`) as an `lg` menu under its button: one row per
///| entry with the site tile and the page title, keyboard navigable. Selecting dispatches
///| `on_jump(owner_pane, entry.index)`.
pub fn build_nav_history_popover(root : view::View, props : NavHistoryPopoverProps) -> Unit {
  let nominal_w = SP_160 + SP_128
  let menu = fn() -> MsoMenu {
    let src = (props.entries)()
    let out = MsoMenu::new()
    let mut i = 0
    while i < src.length() {
      let e = src[i]
      let site = shell_url_parts(e.url).0
      let host = mso_tile_host(site)
      let idx = e.index
      out.add(lg::LiquidMenuEntry::item(
        label=if e.title.trim() != "" { e.title } else { host },
        icon=fn(ic : view::View, _ink : () -> Int64) -> Unit { let _ = mso_site_tile(ic, fn() { site }, size=SP_16) },
        on_select=fn() {
          let owner = signals::untracked(props.owner_pane)
          (props.on_jump)(owner, idx)
        },
      ))
      i += 1
    }
    out.done()
  }
  // Opened by the person: grows out of its trigger (see `shell_popover_reveal`). Already open when built: there
  // at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, props.on_close)
    let reveal = shell_popover_reveal(layer, built.v)
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let (ox, oy) = signals::untracked(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let ph = menu().height(has_header=true)
        mso_popover_origin((props.trigger_anchor)(), (props.fallback_capsule)(), vw, vh, pw, ph)
      })
      reveal.grows(pos, ox=ox, oy=oy)
      let _ = pos
      .over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          mso_measured_h(pos, menu().height(has_header=true)),
        )
        (Some(px), Some(py), None, None)
      }))
      .width(view::Live::By(fn() {
        let (vw, _) = overlay_window_size(root)
        Some(clamp_popover_width(nominal_w, vw))
      }))
      let _ = lg::liquid_menu_panel_node(
        pos,
        fn() { menu().entries },
        close_now,
        header=fn() { if (props.is_forward)() { "Forward" } else { "Back" } },
        menu_label=fn() { "Navigation History" },
        min_width=SP_160 + SP_64,
      )
    })
  })
  built.v = true
}

// ============================================================================
// 6. Folder settings (tag: "folder_ctx")
// ============================================================================

pub struct FolderContextTarget {
  pub folder_id : String
  pub name : String
  pub color : String
  pub collapsed : Bool
}

pub struct FolderContextCallbacks {
  pub on_rename : (String, String) -> Unit
  pub on_pick_color : (String, String) -> Unit
  pub on_toggle_collapse : (String) -> Unit
  pub on_delete : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct FolderContextMenuProps {
  pub open : () -> Bool
  pub target : () -> FolderContextTarget
  pub palette : Array[String]
  pub rename_field : ui::Field
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : FolderContextCallbacks
}

///| Builds the folder settings popover (tag `"folder_ctx"`): "Folder settings" beside a tile in the folder's
///| color, then Name (the only place the name shows), Color, a Collapsed toggle and Delete — all routed by stable
///| `folder_id`. Placed by its measured height (an estimate of the same layout before the first layout).
pub fn build_folder_context_menu(root : view::View, props : FolderContextMenuProps) -> Unit {
  let pop_w = SP_160 + SP_128
  // Header 32 + three captioned groups (caption + card) + gaps + padding.
  let est_h = SP_160 + SP_128 + SP_32
  let fid_now = fn() -> String { signals::untracked(props.target).folder_id }
  // Opened by the person: grows out of the point it was asked for at (see `shell_popover_reveal`). Already open
  // when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, props.callbacks.on_close)
    let reveal = shell_popover_reveal(layer, built.v)
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement((props.anchor_x)(), (props.anchor_y)(), vw, vh, pop_w, mso_measured_h(pos, est_h))
        (Some(px), Some(py), None, None)
      }))
      let (ox, oy) = signals::untracked(fn() {
        let (vw, vh) = overlay_window_size(root)
        let ax = (props.anchor_x)()
        let ay = (props.anchor_y)()
        let (px, py) = compute_menu_placement(ax, ay, vw, vh, pop_w, est_h)
        mso_point_origin(ax, ay, px, py, pop_w, est_h)
      })
      reveal.grows(pos, ox=ox, oy=oy)

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::Is(Some(pop_w)))
          .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
          .gap(view::Live::Is(SP_16))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Folder Settings"))))

          mso_popover_header(
            panel,
            ICON_FOLDER,
            fn() { proto::workspace_accent_color((props.target)().color) },
            fn() { "Folder settings" },
            "Close Folder Settings",
            close_now,
          )

          mso_group(panel, "Name", "", fn(g : view::View) -> Unit {
            mso_name_editor(g, props.rename_field, "Folder name", "Save Folder Name", fn(txt : String) -> Unit {
              (props.callbacks.on_rename)(fid_now(), txt)
            })
          })

          if props.palette.length() > 0 {
            mso_group(panel, "Color", "", fn(g : view::View) -> Unit {
              mso_swatches(
                g,
                props.palette,
                "Folder Color ",
                fn(hex : String) -> Bool { (props.target)().color == hex },
                fn(hex : String) -> Unit { (props.callbacks.on_pick_color)(fid_now(), hex) },
              )
            })
          }

          mso_group(panel, "", "", fn(g : view::View) -> Unit {
            settings_row(g, ICON_CHEVRON_RIGHT, MSO_TILE_GRAY, "Collapsed", fn(tr : view::View) -> Unit {
              let _ = lg::liquid_toggle_node(
                tr,
                fn() { (props.target)().collapsed },
                fn(_v : Bool) -> Unit { (props.callbacks.on_toggle_collapse)(fid_now()) },
                fn() { if (props.target)().collapsed { "Expand Folder" } else { "Collapse Folder" } },
              )
            })
            settings_rule(g)
            let _ = headless::button(
              g,
              fn() { "Delete Folder" },
              fn(_e) -> Unit { (props.callbacks.on_delete)(fid_now()) },
              fn(b : view::View, btn : headless::Button) -> Unit {
                let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                let _ = b.ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
                mso_danger_row(b, "trash", "Delete Folder")
              },
            )
          })
        },
        radius=SP_24,
      )
    })
  })
  built.v = true
}

// ============================================================================
// 7. Customize Space (tag: "space_theme")
// ============================================================================

pub struct SpaceThemeProps {
  pub open : () -> Bool
  pub space_id : () -> String
  pub active_accent : () -> String
  pub palette : Array[String]
  pub name_field : ui::Field
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_rename : (String, String) -> Unit
  pub on_pick_accent : (String, String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Customize Space popover (tag `"space_theme"`): name and color of the Space, with a footnote on
///| what the color does (it tints the window frame).
pub fn build_space_theme_popover(root : view::View, props : SpaceThemeProps) -> Unit {
  let nominal_w = SP_160 + SP_128
  // Header 32 + two captioned groups + footnote + gaps + padding.
  let est_h = SP_160 + SP_80
  // Opened by the person: grows out of its trigger (see `shell_popover_reveal`). Already open when built: there
  // at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, props.on_close)
    let reveal = shell_popover_reveal(layer, built.v)
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let (ox, oy) = signals::untracked(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        mso_popover_origin((props.trigger_anchor)(), (props.fallback_capsule)(), vw, vh, pw, est_h)
      })
      reveal.grows(pos, ox=ox, oy=oy)
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          mso_measured_h(pos, est_h),
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
          .gap(view::Live::Is(SP_16))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Customize Space"))))

          mso_popover_header(
            panel,
            ICON_LAYERS,
            fn() { proto::workspace_accent_color((props.active_accent)()) },
            fn() { "Customize Space" },
            "Close Space Customizer",
            close_now,
          )

          mso_group(panel, "Name", "", fn(g : view::View) -> Unit {
            mso_name_editor(g, props.name_field, "Space name", "Rename Space", fn(txt : String) -> Unit {
              (props.on_rename)(signals::untracked(props.space_id), txt)
            })
          })

          mso_group(panel, "Color", "Tints the window frame of this Space.", fn(g : view::View) -> Unit {
            mso_swatches(
              g,
              props.palette,
              "Space color ",
              fn(hex : String) -> Bool { (props.active_accent)() == hex },
              fn(hex : String) -> Unit { (props.on_pick_accent)(signals::untracked(props.space_id), hex) },
            )
          })
        },
        radius=SP_24,
      )
    })
  })
  built.v = true
}

// ============================================================================
// 8. Recent tabs switcher (tag: "mru")
// ============================================================================

pub struct MruTabEntry {
  pub tab_id : String
  pub title : String
  pub host : String
  pub playing : Bool
  ///| The tab now in front. The strip does not mark it (Arc doesn't): it is always the first cell.
  pub active : Bool
}

pub struct MruSwitcherModalProps {
  pub open : () -> Bool
  ///| Kept for callers; the strip has no header, so it is not shown.
  pub space_name : () -> String
  pub items : () -> Array[MruTabEntry]
  pub selected_index : () -> Int
  pub on_select_tab : (String) -> Unit
  ///| The pointer moved onto the cell of item `i` (its index in `items`): the one highlight follows it, so letting
  ///| go of Ctrl opens what the pointer is on, as macOS's Cmd+Tab and Arc do.
  pub on_hover_index : (Int) -> Unit
  pub on_close : () -> Unit
  ///| Window x where the page area starts for a window this wide (the docked sidebar's width; `0` with no
  ///| sidebar). The strip is centered over the page, as Arc centers it over the web content.
  pub content_left : (Double) -> Double
}

///| Strip geometry, after Arc's `Ctrl+Tab`: each cell is a 16:10 preview over one favicon + title line, and the
///| cell itself is the selection highlight. `SP_12` panel padding and the `SP_12` cell corner make the
///| `SP_24` panel corner concentric.
let MRU_CELL_W : Double = 160.0 // SP_160
let MRU_CELL_PAD : Double = 8.0 // SP_8
let MRU_CELL_GAP : Double = 4.0 // SP_4
let MRU_PAD : Double = 12.0 // SP_12
///| Least room kept between the strip and the window edge.
let MRU_EDGE : Double = 16.0 // SP_16
let MRU_MAX_CELLS : Int = 5

fn mru_thumb_w() -> Double {
  MRU_CELL_W - MRU_CELL_PAD * 2.0
}

fn mru_thumb_h() -> Double {
  mru_thumb_w() * 10.0 / 16.0
}

///| Cells that fit on the one row in a `vw`-wide window: up to 5, fewer when the window or the list is small.
fn mru_visible_count(vw : Double, n : Int) -> Int {
  let avail = vw - MRU_EDGE * 2.0 - MRU_PAD * 2.0
  let mut k = 1
  while k < MRU_MAX_CELLS && (k + 1).to_double() * MRU_CELL_W + k.to_double() * MRU_CELL_GAP <= avail {
    k += 1
  }
  if n < 1 {
    1
  } else if n < k {
    n
  } else {
    k
  }
}

///| Index of the first cell shown, from the one shown before (`prev_first`). The strip scrolls only when the
///| selection leaves it, by just enough to bring it back at the edge it left by, so the highlight keeps moving the
///| way the key points; wrapping (last to first or back) lands on the matching end. The strip is never half empty.
fn mru_first_visible(prev_first : Int, sel : Int, n : Int, vis : Int) -> Int {
  if n <= vis || vis < 1 || sel < 0 {
    return 0
  }
  let mut first = prev_first
  if sel >= first + vis {
    first = sel - vis + 1
  }
  if sel < first {
    first = sel
  }
  if first > n - vis {
    first = n - vis
  }
  if first < 0 {
    0
  } else {
    first
  }
}

///| Window x of the strip's left edge: centered over the page area (`content_left` to the window's right edge)
///| when it fits there, else centered on the window, and never closer than `MRU_EDGE` to either edge.
fn mru_panel_left(vw : Double, content_left : Double, pw : Double) -> Double {
  let page_w = vw - content_left
  if content_left > 0.0 && page_w >= pw + MRU_EDGE * 2.0 {
    content_left + (page_w - pw) / 2.0
  } else if vw > pw + MRU_EDGE * 2.0 {
    (vw - pw) / 2.0
  } else {
    MRU_EDGE
  }
}

fn mru_panel_w(vis : Int) -> Double {
  vis.to_double() * MRU_CELL_W + (vis - 1).to_double() * MRU_CELL_GAP + MRU_PAD * 2.0
}

fn mru_panel_h() -> Double {
  MRU_PAD * 2.0 + MRU_CELL_PAD * 2.0 + mru_thumb_h() + SP_8 + SP_16
}

///| The selected cell's fill: a neutral gray of its own, as Arc's (the accent `row_selected` would tint the
///| previews blue), as the command bar keeps `CMD_SELECTED_*`. Light: black at 8% on the white strip; dark: white
///| at 12% on `card`, both stronger than `row_hover` so the selection reads at a glance.
let MRU_SELECTED_LIGHT : Int64 = 0x00000014L
let MRU_SELECTED_DARK : Int64 = 0xFFFFFF1FL

fn mru_selected_fill() -> Int64 {
  if lg::is_dark() { MRU_SELECTED_DARK } else { MRU_SELECTED_LIGHT }
}

///| Builds the recent tabs switcher (`Ctrl+Tab`, tag `"mru"`), after Arc: one strip of cells centered over the
///| upper middle of the page, no header and no hints. Each cell is a preview (no tab snapshots exist yet, so it
///| is an honest blank page with the site tile) over the site tile and title; the selected cell carries a soft
///| neutral fill that jumps, never slides. With more tabs than fit, the strip scrolls just enough to keep the
///| selection in view.
///| It appears at once: it answers a held key, so it never animates in.
pub fn build_mru_switcher_modal(root : view::View, props : MruSwitcherModalProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0))))
    // Clear catcher: the page stays undimmed, but a click outside reaches the dialog's dismissal, not the page.
    let _ = layer.box(fn(catcher : view::View) -> Unit {
      let _ = catcher.over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0)))).points(view::Live::Is(true))
    })

    let vis = fn() -> Int {
      let (vw, _) = overlay_window_size(root)
      mru_visible_count(vw, (props.items)().length())
    }
    let panel_w = fn() -> Double { mru_panel_w(vis()) }
    // The first cell shown, kept across steps (plain state, not a signal: it only follows the selection).
    let first_shown : signals::Ref[Int] = signals::ref_new(0)
    // A pointer resting where a cell appears is no choice: hovers count once the strip has been up a moment
    // (the pointer moved since), never the hover a cell starts with.
    let armed : signals::Ref[Bool] = signals::ref_new(false)
    let _ = layer.at_moment(layer.cause_at() + MO_HOVER_MS, fn() { armed.v = true })
    let shown = fn() -> Array[MruTabEntry] {
      let all = (props.items)()
      let k = vis()
      let first = mru_first_visible(first_shown.v, (props.selected_index)(), all.length(), k)
      first_shown.v = first
      let out : Array[MruTabEntry] = []
      let mut i = first
      while i < all.length() && i < first + k {
        out.push(all[i])
        i += 1
      }
      out
    }

    let _ = layer.box(fn(anchor : view::View) -> Unit {
      let _ = anchor
      .over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let left = mru_panel_left(vw, (props.content_left)(vw), panel_w())
        let top = (vh - mru_panel_h()) / 2.0 - SP_32
        (Some(left), Some(if top > MRU_EDGE { top } else { MRU_EDGE }), None, None)
      }))
      .width(view::Live::By(fn() { Some(panel_w()) }))
      let _ = headless::dialog(
        anchor,
        fn() { "Quick Tab Switch" },
        props.open,
        props.on_close,
        fn(dlg : view::View, _d : headless::Dialog) -> Unit {
          let _ = dlg.width(view::Live::By(fn() { Some(panel_w()) }))
          let _ = lg::liquid_dialog_shell_node(
            dlg,
            fn(shell : view::View) -> Unit {
              let _ = shell
              .width(view::Live::By(fn() { Some(panel_w()) }))
              .padding(view::Live::Is((MRU_PAD, MRU_PAD, MRU_PAD, MRU_PAD)))
              .row(view::Live::Is(true))
              .gap(view::Live::Is(MRU_CELL_GAP))
              // Solid in both themes, as Arc's: the page never shows through the strip.
              .ground(view::Live::By(fn() { lg::surface().card }))
              // A hairline keeps the solid strip apart from a page of the same color (dark pages on `card`).
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
              .presses(view::Live::Is(true))
              .on_press(fn() { () })
              shell.each(
                shown,
                fn(it : MruTabEntry) -> String { it.tab_id },
                fn(slot : view::View, it_sig : signals::Signal[MruTabEntry]) -> Unit {
                  let is_sel = fn() -> Bool {
                    let all = (props.items)()
                    let sel_i = (props.selected_index)()
                    sel_i >= 0 && sel_i < all.length() && all[sel_i].tab_id == it_sig.get().tab_id
                  }
                  let _ = headless::button(
                    slot,
                    fn() { "Switch to \{it_sig.get().title}" },
                    fn(_e) -> Unit { (props.on_select_tab)(it_sig.untracked().tab_id) },
                    fn(cell : view::View, btn : headless::Button) -> Unit {
                      cell.reacts(fn() { btn.hovered() }, fn(on : Bool) -> Unit {
                        if on && armed.v {
                          let all = signals::untracked(props.items)
                          let id = it_sig.untracked().tab_id
                          let mut i = 0
                          while i < all.length() {
                            if all[i].tab_id == id {
                              (props.on_hover_index)(i)
                            }
                            i += 1
                          }
                        }
                      }, at_start=false)
                      let _ = cell
                      .width(view::Live::Is(Some(MRU_CELL_W)))
                      .padding(view::Live::Is((MRU_CELL_PAD, MRU_CELL_PAD, MRU_CELL_PAD, MRU_CELL_PAD)))
                      .gap(view::Live::Is(SP_8))
                      .radius(view::Live::Is(lg::concentric(SP_24, MRU_PAD)))
                      .rigid()
                      // One highlight only: the selection releasing Ctrl opens. No hover wash of its own (a second
                      // gray cell under a resting pointer); the selection follows the pointer instead.
                      .ground(view::Live::By(fn() { if is_sel() { mru_selected_fill() } else { lg::clear } }))
                      // Preview: a blank page with the site tile (no tab snapshot to show yet).
                      let _ = cell.box(fn(pv : view::View) -> Unit {
                        let _ = pv
                        .width(view::Live::Is(Some(mru_thumb_w())))
                        .height(view::Live::Is(Some(mru_thumb_h())))
                        .radius(view::Live::Is(lg::concentric(lg::concentric(SP_24, MRU_PAD), MRU_CELL_PAD)))
                        .center()
                        .rigid()
                        .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                        .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                        let _ = mso_site_tile(pv, fn() { it_sig.get().host }, size=SP_20)
                        pv.show(fn() { it_sig.get().playing }, fn(badge : view::View) -> Unit {
                          let _ = badge
                          .over_at(view::Live::Is((None, Some(SP_6), Some(SP_6), None)))
                          .width(view::Live::Is(Some(SP_20)))
                          .height(view::Live::Is(Some(SP_20)))
                          .radius(view::Live::Is(SP_10))
                          .center()
                          .ground(view::Live::By(fn() { lg::surface().card }))
                          let _ = shell_icon(badge, ICON_VOLUME, size=IC_SM, color_by=fn() { lg::surface().positive })
                        })
                      })
                      // Favicon + title, one line; the favicon sits on the preview's left edge (its corner stays concentric).
                      let _ = cell.box(fn(line : view::View) -> Unit {
                        let _ = line
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .gap(view::Live::Is(SP_6))
                        .height(view::Live::Is(Some(SP_16)))
                        .rigid()
                        let _ = line.box(fn(tw : view::View) -> Unit {
                          let _ = tw.rigid()
                          let _ = mso_site_tile(tw, fn() { it_sig.get().host }, size=SP_16)
                        })
                        let _ = line.box(fn(txt : view::View) -> Unit {
                          let _ = txt
                          .grow(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(SP_0)))
                          .min_width(view::Live::Is(Some(SP_0)))
                          .shrink(view::Live::Is(1.0))
                          .cut()
                          // One line, ending in an ellipsis where the title has no room (as Arc's "cauyxy (Xinyu Y...").
                          let _ = <ui::Text
                            in={txt}
                            size={TX_FOOTNOTE}
                            weight={500}
                            color_by=>{lg::surface().ink}
                            text_by=>{it_sig.get().title}
                          />.allow_ellipsis(view::Live::Is(true))
                        })
                      })
                    },
                  )
                },
              )
            },
            radius=SP_24,
            solid=fn() { lg::surface().card },
          )
        },
        modal=true,
        close_on_escape=true,
        close_on_outside=true,
      )
    })
  })
}
