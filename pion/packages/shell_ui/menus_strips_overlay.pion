///| Farview Desktop Shell 2.0 Phase 2B — Bookmarks Bar Strip, Click-Through Perf HUD,
///| Tab Hover Preview Card, and Unified Liquid Glass Menus & Light Popovers:
///| - `PageContextMenu` (`page_ctx`)
///| - `NavHistoryPopover` (`nav_hist`)
///| - `TabContextMenu` (`tab_ctx`)
///| - `FolderContextMenu` (`folder_ctx`)
///| - `BookmarksBarContextMenu` (`bm_bar_ctx`)
///| - `SpaceThemePopover` (`space_theme`)
///| - `MruSwitcherModal` (`mru`)
///|
///| Architectural invariants:
///| - 100% backed by `packages/lg` and `packages/icons`, zero Unicode pseudo-icons, 100% explicit `color_by`.
///| - Perf HUD is strictly click-through (`points(Is(false))`) so it never intercepts webpage clicks.
///| - All tab/folder/nav callbacks carry stable `tab_id` / `folder_id` / `owner_pane` identifiers.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Bookmarks Bar Strip (mounts in `top_strip` slot)
// ============================================================================

pub struct BookmarkChipItem {
  pub id : String
  pub title : String
  pub url : String
}

pub struct BookmarksBarProps {
  pub open : () -> Bool
  pub items : () -> Array[BookmarkChipItem]
  pub page_saved : () -> Bool
  pub on_navigate : (String) -> Unit
  pub on_context_menu : (String, String, Double, Double) -> Unit
  pub on_toggle_bookmark : () -> Unit
}

fn bm_brand_badge_colors(url : String, dark : Bool) -> (Int64, Int64) {
  let host = proto::omnibox_display_host(url)
  let b = host.to_bytes()
  let mut h = 0
  let mut i = 0
  while i < b.length() {
    h = (h * 31 + (b[i].to_int() & 0xFF)) & 0x7FFFFFFF
    i = i + 1
  }
  let slot = h % 6
  if dark {
    if slot == 0 {
      (0x1E3A5FFFL, 0x93C5FDFFL)
    } else if slot == 1 {
      (0x2E1F4BFFL, 0xC4B5FDFFL)
    } else if slot == 2 {
      (0x113227FFL, 0x6EE7B7FFL)
    } else if slot == 3 {
      (0x3B2D14FFL, 0xFCD34DFFL)
    } else if slot == 4 {
      (0x3D1B30FFL, 0xF9A8D4FFL)
    } else {
      (0x10333EFFL, 0x67E8F9FFL)
    }
  } else if slot == 0 {
    (0xDBEAFEFFL, 0x1D4ED8FFL)
  } else if slot == 1 {
    (0xEDE9FEFFL, 0x6D28D9FFL)
  } else if slot == 2 {
    (0xD1FAE5FFL, 0x047857FFL)
  } else if slot == 3 {
    (0xFEF3C7FFL, 0xB45309FFL)
  } else if slot == 4 {
    (0xFCE7F3FFL, 0xBE185DFFL)
  } else {
    (0xCFFAFEFFL, 0x0E7490FFL)
  }
}

fn menu_shortcut(mac : String, other : String) -> String {
  if ui::keys_system() <= 0 { mac } else { other }
}

///| Builds the toggleable Bookmarks Bar Strip for the `top_strip` slot.
///| Left-click navigates; right-click invokes `on_context_menu` for `bm_bar_ctx`.
pub fn build_bookmarks_bar_strip(parent : view::View, props : BookmarksBarProps) -> Unit {
  parent.show(props.open, fn(wrap : view::View) -> Unit {
    let _ = wrap.rigid()
    let _ = wrap.box(fn(strip : view::View) -> Unit {
      let _ = strip
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(32.0)))
      .rigid()
      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
      .gap(view::Live::Is(6.0))
      .ground(view::Live::By(fn() { lg::surface().canvas }))
      .says(view::Live::Is(Some(view::said(view::Role::Region, label="Bookmarks Bar"))))

      // Clipped bookmark chips row
      let _ = strip.box(fn(chips : view::View) -> Unit {
        let _ = chips
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(4.0))
        .cut()

        chips.show(
          fn() { (props.items)().length() == 0 },
          fn(emp : view::View) -> Unit {
            let _ = <ui::Text in={emp} size={11.0} color_by=>{lg::surface().ink_tertiary} text="No bookmarks yet" />
          },
        )

        chips.each(
          props.items,
          fn(bm : BookmarkChipItem) -> String { bm.id },
          fn(slot : view::View, bm_sig : signals::Signal[BookmarkChipItem]) -> Unit {
            let _ = headless::button(
              slot,
              fn() { "Open bookmark \{bm_sig.get().title}" },
              fn(_e) -> Unit { (props.on_navigate)(bm_sig.untracked().url) },
              fn(chip : view::View, btn : headless::Button) -> Unit {
                let _ = chip
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(24.0)))
                .max_width(view::Live::Is(Some(156.0)))
                .rigid()
                .padding(view::Live::Is((5.0, 0.0, 8.0, 0.0)))
                .gap(view::Live::Is(5.0))
                .radius(view::Live::Is(lg::r_chip))
                .cut()
                .ground(view::Live::By(fn() {
                  if btn.hovered() || btn.pressed() { lg::surface().row_hover } else { 0x00000000L }
                }))
                .on_menu(fn(_m : view::Menu) -> Unit {
                  let (cx, cy, _, ch) = chip.placed_window_now()
                  let cur = bm_sig.untracked()
                  (props.on_context_menu)(cur.id, cur.url, cx, cy + ch + 4.0)
                })
                let _ = chip.box(fn(badge : view::View) -> Unit {
                  let _ = badge
                  .width(view::Live::Is(Some(16.0)))
                  .height(view::Live::Is(Some(16.0)))
                  .radius(view::Live::Is(4.5))
                  .center()
                  .rigid()
                  .ground(view::Live::By(fn() { bm_brand_badge_colors(bm_sig.get().url, lg::is_dark()).0 }))
                  let _ = <ui::Text
                    in={badge}
                    size={9.5}
                    weight={700}
                    color_by=>{bm_brand_badge_colors(bm_sig.get().url, lg::is_dark()).1}
                    text_by=>{
                      let cur = bm_sig.get()
                      proto::omnibox_initial_letter(cur.url, cur.title)
                    }
                  />
                })
                let _ = <ui::Text
                  in={chip}
                  size={11.5}
                  weight={500}
                  color_by=>{
                    if btn.hovered() || btn.pressed() { lg::surface().ink } else { lg::surface().ink_secondary }
                  }
                  text_by=>{bm_sig.get().title}
                />.allow_ellipsis(view::Live::Is(true))
              },
            )
          },
        )
      })

      // Trailing quick-bookmark toggle button
      let _ = lg::liquid_button_node(
        strip,
        fn() { if (props.page_saved)() { "Remove Bookmark" } else { "Bookmark Page" } },
        props.on_toggle_bookmark,
        content=fn(inner : view::View) -> Unit {
          let _ = inner.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(4.0))
          inner.show(props.page_saved, fn(ic : view::View) -> Unit {
            let _ = shell_icon(ic, ICON_STAR_FILLED, size=12.0, color_by=fn() { lg::surface().accent })
          })
          inner.show(fn() { !(props.page_saved)() }, fn(ic : view::View) -> Unit {
            let _ = shell_icon(ic, ICON_STAR, size=12.0, color_by=fn() { lg::surface().ink_secondary })
          })
          let _ = <ui::Text
            in={inner}
            size={11.0}
            weight={500}
            color_by=>{if (props.page_saved)() { lg::surface().accent } else { lg::surface().ink_secondary }}
            text_by=>{if (props.page_saved)() { "Saved" } else { "Bookmark" }}
          />
        },
        flat=true,
        height=24.0,
        pad_x=8.0,
      )
    })

    // Single bottom hairline separating strip from web canvas
    let _ = wrap.box(fn(sep : view::View) -> Unit {
      let _ = sep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
    })
  })
}

// ============================================================================
// 2. Live Page Performance & Security HUD Overlay (real host metrics)
// ============================================================================

pub struct PerfHudMetrics {
  pub host_label : String
  pub scheme : String
  pub tls_secure : Bool
  pub dom_nodes : Int
  pub stylesheets : Int
  pub images : Int
  pub doc_width : Int
  pub doc_height : Int
  pub zoom_percent : Int
  pub cookies_count : Int
  pub space_name : String
  pub space_accent : Int64
}

pub struct PerfHudProps {
  pub open : () -> Bool
  pub metrics : () -> PerfHudMetrics
  pub top_offset : () -> Double
  pub on_refresh : () -> Unit
  pub on_close : () -> Unit
}

///| Builds the Liquid Glass Live Page Performance & Security HUD card.
///| Uses 100% real host `PerfHudSnapshot` metrics (zero fabricated FPS/frame/memory numbers)
///| and positions dynamically below the titleband, bookmarks bar, and split bar.
pub fn build_perf_hud_overlay(root : view::View, props : PerfHudProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over_at(view::Live::By(fn() {
      (None, Some((props.top_offset)()), Some(14.0), None)
    }))

    let _ = lg::liquid_panel_shell_node(
      layer,
      fn(card : view::View) -> Unit {
        let _ = card
        .width(view::Live::Is(Some(312.0)))
        .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
        .gap(view::Live::Is(8.0))
        .presses(view::Live::Is(true))
        .on_press(fn() { () })
        .says(view::Live::Is(Some(view::said(view::Role::Region, label="Page & Engine HUD"))))

        // Header: status dot + title + HTTPS/HTTP/LOCAL badge + Refresh + Close
        let _ = card.box(fn(hdr : view::View) -> Unit {
          let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
          let _ = hdr.box(fn(dot : view::View) -> Unit {
            let _ = dot
            .width(view::Live::Is(Some(7.0)))
            .height(view::Live::Is(Some(7.0)))
            .radius(view::Live::Is(3.5))
            .rigid()
            .ground(view::Live::By(fn() {
              if (props.metrics)().tls_secure { lg::surface().positive } else { lg::surface().warning }
            }))
          })
          let _ = <ui::Text in={hdr} size={12.0} weight={600} color_by=>{lg::surface().ink} text="Page & Engine HUD" />
          let _ = hdr.box(fn(sec : view::View) -> Unit {
            let _ = sec
            .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
            .radius(view::Live::Is(5.0))
            .rigid()
            .ground(view::Live::By(fn() {
              if (props.metrics)().tls_secure { lg::surface().positive_bg } else { lg::surface().warning_bg }
            }))
            let _ = <ui::Text
              in={sec}
              size={9.5}
              weight={600}
              color_by=>{
                if (props.metrics)().tls_secure { lg::surface().positive } else { lg::surface().warning }
              }
              text_by=>{
                let m = (props.metrics)()
                proto::perf_hud_security_badge(m.scheme, m.tls_secure)
              }
            />
          })
          let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
          let _ = lg::liquid_button_node(
            hdr,
            fn() { "Refresh Perf HUD" },
            props.on_refresh,
            content=fn(inner : view::View) -> Unit {
              let _ = shell_icon(inner, ICON_RELOAD, size=12.0, color_by=fn() { lg::surface().ink_secondary })
            },
            flat=true,
            ghost=true,
            height=22.0,
            pad_x=5.0,
          )
          build_close_icon_btn(hdr, "Close Perf HUD", props.on_close)
        })

        let metric_tile = fn(row : view::View, k : String, v_fn : () -> String) -> Unit {
          let _ = row.box(fn(cell : view::View) -> Unit {
            let _ = cell
            .grow(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
            .gap(view::Live::Is(2.0))
            .radius(view::Live::Is(lg::r_chip))
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .cut()
            let _ = <ui::Text in={cell} size={9.5} weight={500} color_by=>{lg::surface().ink_tertiary} text={k} />
            let _ = <ui::Text
              in={cell}
              size={12.0}
              weight={600}
              color_by=>{lg::surface().ink}
              text_by=>{v_fn()}
            />.allow_ellipsis(view::Live::Is(true))
          })
        }

        // 2x3 real host metrics grid
        let _ = card.box(fn(r1 : view::View) -> Unit {
          let _ = r1.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).rigid()
          metric_tile(r1, "DOM Nodes", fn() { (props.metrics)().dom_nodes.to_string() })
          metric_tile(r1, "Stylesheets", fn() { (props.metrics)().stylesheets.to_string() })
          metric_tile(r1, "Images", fn() { (props.metrics)().images.to_string() })
        })
        let _ = card.box(fn(r2 : view::View) -> Unit {
          let _ = r2.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).rigid()
          metric_tile(r2, "Viewport / Doc", fn() {
            let m = (props.metrics)()
            "\{m.doc_width}x\{m.doc_height}"
          })
          metric_tile(r2, "Zoom", fn() { "\{(props.metrics)().zoom_percent}%" })
          metric_tile(r2, "Site Cookies", fn() { (props.metrics)().cookies_count.to_string() })
        })

        // Footer: Space dot + Space name + Host
        let _ = card.box(fn(ftr : view::View) -> Unit {
          let _ = ftr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
          let _ = ftr.box(fn(sdot : view::View) -> Unit {
            let _ = sdot
            .width(view::Live::Is(Some(7.0)))
            .height(view::Live::Is(Some(7.0)))
            .radius(view::Live::Is(3.5))
            .rigid()
            .ground(view::Live::By(fn() { (props.metrics)().space_accent }))
          })
          let _ = <ui::Text in={ftr} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text_by=>{(props.metrics)().space_name} />
          let _ = ftr.box(fn(hw : view::View) -> Unit {
            let _ = hw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
            let _ = <ui::Text in={hw} size={10.5} color_by=>{lg::surface().ink_tertiary} text_by=>{(props.metrics)().host_label} />.allow_ellipsis(view::Live::Is(true))
          })
        })
      },
      radius=lg::r_row,
    )
  })
}

// ============================================================================
// 3. Tab Hover Preview Card
// ============================================================================

pub struct TabHoverPreviewSnapshot {
  pub tab_id : String
  pub title : String
  pub clean_host : String
  pub space_name : String
  pub playing : Bool
  pub muted : Bool
  pub in_split : Bool
  pub in_reader : Bool
}

pub struct TabHoverPreviewProps {
  pub open : () -> Bool
  pub snapshot : () -> Option[TabHoverPreviewSnapshot]
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
}

///| Builds the floating Liquid Glass Tab Hover Preview Card (title, clean host, media/mode badges).
pub fn build_tab_hover_preview_card(root : view::View, props : TabHoverPreviewProps) -> Unit {
  let card_w = 264.0
  let card_h = 104.0
  root.show(
    fn() { (props.open)() && (props.snapshot)().is_some() },
    fn(layer : view::View) -> Unit {
      let _ = layer
      .over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement((props.anchor_x)(), (props.anchor_y)(), vw, vh, card_w, card_h)
        (Some(px), Some(py), None, None)
      }))
      .points(view::Live::Is(false))

      let _ = lg::liquid_panel_shell_node(
        layer,
        fn(card : view::View) -> Unit {
          let _ = card
          .width(view::Live::Is(Some(card_w)))
          .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
          .gap(view::Live::Is(6.0))
          .points(view::Live::Is(false))

          let _ = <ui::Text
            in={card}
            size={12.5}
            weight={600}
            wrap
            color_by=>{lg::surface().ink}
            text_by=>{
              match (props.snapshot)() {
                Some(s) => s.title
                None => ""
              }
            }
          />
          let _ = <ui::Text
            in={card}
            size={11.0}
            color_by=>{lg::surface().ink_secondary}
            text_by=>{
              match (props.snapshot)() {
                Some(s) => s.clean_host
                None => ""
              }
            }
          />.allow_ellipsis(view::Live::Is(true))

          // Media & mode status badges row
          let _ = card.box(fn(badges : view::View) -> Unit {
            let _ = badges.row(view::Live::Is(true)).wraps(view::Live::Is(Some(4.0))).gap(view::Live::Is(5.0)).rigid()
            let badge_chip = fn(cond : () -> Bool, icon_name : String, label : String, tint_fn : () -> Int64, ink_fn : () -> Int64) -> Unit {
              badges.show(cond, fn(b : view::View) -> Unit {
                let _ = b
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                .gap(view::Live::Is(4.0))
                .radius(view::Live::Is(lg::r_chip))
                .rigid()
                .ground(view::Live::By(tint_fn))
                let _ = shell_icon(b, icon_name, size=11.0, color_by=ink_fn)
                let _ = <ui::Text in={b} size={10.5} weight={500} color_by=>{ink_fn()} text={label} />
              })
            }
            badge_chip(
              fn() { match (props.snapshot)() { Some(s) => s.playing && !s.muted; None => false } },
              ICON_VOLUME,
              "Playing",
              fn() { lg::surface().positive_bg },
              fn() { lg::surface().positive },
            )
            badge_chip(
              fn() { match (props.snapshot)() { Some(s) => s.muted; None => false } },
              ICON_VOLUME_MUTE,
              "Muted",
              fn() { lg::surface().danger_bg },
              fn() { lg::surface().danger },
            )
            badge_chip(
              fn() { match (props.snapshot)() { Some(s) => s.in_split; None => false } },
              ICON_SPLIT,
              "Split",
              fn() { lg::surface().accent_tint },
              fn() { lg::surface().accent },
            )
            badge_chip(
              fn() { match (props.snapshot)() { Some(s) => s.in_reader; None => false } },
              ICON_READER,
              "Reader",
              fn() { lg::surface().warning_bg },
              fn() { lg::surface().warning },
            )
          })
        },
        radius=lg::r_row,
      )
    },
  )
}

// ============================================================================
// 4. Unified Liquid Glass Context Menus (`page_ctx`, `tab_ctx`, `bm_bar_ctx`)
// ============================================================================

fn build_anchored_menu_overlay(
  root : view::View,
  open : () -> Bool,
  anchor_x : () -> Double,
  anchor_y : () -> Double,
  menu_w : Double,
  est_h : Double,
  menu_label : String,
  entries : () -> Array[lg::LiquidMenuEntry],
  on_close : () -> Unit,
) -> Unit {
  root.show(open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let (px, py) = compute_menu_placement(anchor_x(), anchor_y(), vw, vh, menu_w, est_h)
        (Some(px), Some(py), None, None)
      }))
      let _ = lg::liquid_menu_panel_node(
        pos,
        entries,
        on_close,
        menu_label=fn() { menu_label },
        min_width=menu_w,
      )
    })
  })
}

///| Hit-test context payload for `PageContextMenu` (`page_ctx`).
pub struct PageContextTarget {
  pub link_url : String
  pub image_url : String
  pub selection_text : String
  pub can_back : Bool
  pub can_forward : Bool
}

pub struct PageContextCallbacks {
  pub on_open_peek : (String) -> Unit
  pub on_open_split : (String) -> Unit
  pub on_open_new_tab : (String) -> Unit
  pub on_copy_link : (String) -> Unit
  pub on_open_image : (String) -> Unit
  pub on_copy_image_url : (String) -> Unit
  pub on_copy_selection : (String) -> Unit
  pub on_search_selection : (String) -> Unit
  pub on_back : () -> Unit
  pub on_forward : () -> Unit
  pub on_reload : () -> Unit
  pub on_copy_page_url : () -> Unit
  pub on_close : () -> Unit
}

pub struct PageContextMenuProps {
  pub open : () -> Bool
  pub target : () -> PageContextTarget
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : PageContextCallbacks
}

///| Builds the Liquid Glass Webpage Context Menu (tag `"page_ctx"`).
///| Preserves link, image, selection, and page navigation actions with zero double dividers.
pub fn build_page_context_menu(root : view::View, props : PageContextMenuProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    228.0,
    240.0,
    "Page Context Menu",
    fn() -> Array[lg::LiquidMenuEntry] {
      let t = (props.target)()
      let items : Array[lg::LiquidMenuEntry] = []
      if t.link_url != "" {
        let u = t.link_url
        items.push(lg::LiquidMenuEntry::item(
          label="Open in Peek",
          shortcut="Shift+Click",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_EXTERNAL, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_open_peek)(u) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Open Link in Split View",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_SPLIT, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_open_split)(u) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Open Link in New Tab",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_PLUS, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_open_new_tab)(u) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Copy Clean Link",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_COPY, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_copy_link)(u) },
        ))
        items.push(lg::LiquidMenuEntry::separator())
      }
      if t.image_url != "" {
        let img = t.image_url
        items.push(lg::LiquidMenuEntry::item(
          label="Open Image in New Tab",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_EXTERNAL, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_open_image)(img) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Copy Image URL",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_COPY, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_copy_image_url)(img) },
        ))
        items.push(lg::LiquidMenuEntry::separator())
      }
      if t.selection_text != "" {
        let sel = t.selection_text
        items.push(lg::LiquidMenuEntry::item(
          label="Copy Selection",
          shortcut=menu_shortcut("⌘C", "Ctrl+C"),
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_COPY, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_copy_selection)(sel) },
        ))
        items.push(lg::LiquidMenuEntry::item(
          label="Search Selection",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_search_selection)(sel) },
        ))
        items.push(lg::LiquidMenuEntry::separator())
      }
      if t.can_back {
        items.push(lg::LiquidMenuEntry::item(
          label="Back",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_BACK, size=14.0, color_by=ink) },
          on_select=props.callbacks.on_back,
        ))
      }
      if t.can_forward {
        items.push(lg::LiquidMenuEntry::item(
          label="Forward",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_FORWARD, size=14.0, color_by=ink) },
          on_select=props.callbacks.on_forward,
        ))
      }
      items.push(lg::LiquidMenuEntry::item(
        label="Reload Page",
        shortcut=menu_shortcut("⌘R", "Ctrl+R"),
        icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_RELOAD, size=14.0, color_by=ink) },
        on_select=props.callbacks.on_reload,
      ))
      items.push(lg::LiquidMenuEntry::item(
        label="Copy Clean Page URL",
        shortcut=menu_shortcut("⇧⌘C", "Ctrl+Shift+C"),
        icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_COPY, size=14.0, color_by=ink) },
        on_select=props.callbacks.on_copy_page_url,
      ))
      items
    },
    props.callbacks.on_close,
  )
}

///| Target payload for `TabContextMenu` (`tab_ctx`), routed strictly by stable `tab_id`.
pub struct TabContextTarget {
  pub tab_id : String
  pub is_active : Bool
  pub pinned : Bool
  pub favorite : Bool
  pub muted : Bool
  pub folder_id : String
  pub can_close_others : Bool
  pub folders : Array[(String, String)]
  pub spaces : Array[(String, String)]
}

pub struct TabContextCallbacks {
  pub on_open_split : (String) -> Unit
  pub on_open_peek : (String) -> Unit
  pub on_duplicate : (String) -> Unit
  pub on_copy_clean_url : (String) -> Unit
  pub on_toggle_pin : (String) -> Unit
  pub on_toggle_favorite : (String) -> Unit
  pub on_toggle_mute : (String) -> Unit
  pub on_move_to_folder : (String, String) -> Unit
  pub on_move_to_space : (String, String) -> Unit
  pub on_close_others : (String) -> Unit
  pub on_close_tab : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct TabContextMenuProps {
  pub open : () -> Bool
  pub target : () -> TabContextTarget
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub callbacks : TabContextCallbacks
}

///| Builds the Liquid Glass Tab Context Menu (tag `"tab_ctx"`).
///| Only labels `⌘M` / `⌘W` when the right-clicked tab is the active tab; supports Move to Folder & Move to Space.
pub fn build_tab_context_menu(root : view::View, props : TabContextMenuProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
    props.anchor_x,
    props.anchor_y,
    236.0,
    380.0,
    "Tab Context Menu",
    fn() -> Array[lg::LiquidMenuEntry] {
      let t = (props.target)()
      let tid = t.tab_id
      let items : Array[lg::LiquidMenuEntry] = [
        lg::LiquidMenuEntry::item(
          label="Open in Split View",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_SPLIT, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_open_split)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label="Open in Peek",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_EXTERNAL, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_open_peek)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label="Duplicate Tab",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_COPY, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_duplicate)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label="Copy Clean URL",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_COPY, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_copy_clean_url)(tid) },
        ),
        lg::LiquidMenuEntry::separator(),
        lg::LiquidMenuEntry::item(
          label=if t.pinned { "Unpin Tab" } else { "Pin Tab" },
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_PIN, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_toggle_pin)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label=if t.favorite { "Remove Favorite" } else { "Add to Favorites" },
          icon=fn(ic, ink) { let _ = shell_icon(ic, if t.favorite { ICON_STAR_FILLED } else { ICON_STAR }, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_toggle_favorite)(tid) },
        ),
        lg::LiquidMenuEntry::item(
          label=if t.muted { "Unmute Tab" } else { "Mute Tab" },
          shortcut=if t.is_active { menu_shortcut("⌘M", "Ctrl+M") } else { "" },
          icon=fn(ic, ink) {
            let _ = shell_icon(ic, if t.muted { ICON_VOLUME } else { ICON_VOLUME_MUTE }, size=14.0, color_by=ink)
          },
          on_select=fn() { (props.callbacks.on_toggle_mute)(tid) },
        ),
      ]
      let mut has_folder_dest = t.folder_id != ""
      let mut fi = 0
      while fi < t.folders.length() {
        if t.folders[fi].0 != t.folder_id {
          has_folder_dest = true
        }
        fi += 1
      }
      if has_folder_dest {
        items.push(lg::LiquidMenuEntry::separator())
        if t.folder_id != "" {
          items.push(lg::LiquidMenuEntry::item(
            label="Move to Top-Level Pinned",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_PIN, size=14.0, color_by=ink) },
            on_select=fn() { (props.callbacks.on_move_to_folder)(tid, "") },
          ))
        }
        let mut fj = 0
        while fj < t.folders.length() {
          let (fid, fname) = t.folders[fj]
          if fid != t.folder_id {
            items.push(lg::LiquidMenuEntry::item(
              label="Move to \{fname}",
              icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_FOLDER, size=14.0, color_by=ink) },
              on_select=fn() { (props.callbacks.on_move_to_folder)(tid, fid) },
            ))
          }
          fj += 1
        }
      }
      if t.spaces.length() > 0 {
        items.push(lg::LiquidMenuEntry::separator())
        let mut i = 0
        while i < t.spaces.length() {
          let (sid, sname) = t.spaces[i]
          items.push(lg::LiquidMenuEntry::item(
            label="Move to \{sname}",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_LAYERS, size=14.0, color_by=ink) },
            on_select=fn() { (props.callbacks.on_move_to_space)(tid, sid) },
          ))
          i += 1
        }
      }
      items.push(lg::LiquidMenuEntry::separator())
      if t.can_close_others {
        items.push(lg::LiquidMenuEntry::item(
          label="Close Other Tabs",
          icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_CLOSE, size=14.0, color_by=ink) },
          on_select=fn() { (props.callbacks.on_close_others)(tid) },
        ))
      }
      items.push(lg::LiquidMenuEntry::item(
        label="Close Tab",
        shortcut=if t.is_active { menu_shortcut("⌘W", "Ctrl+W") } else { "" },
        destructive=true,
        icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_CLOSE, size=14.0, color_by=ink) },
        on_select=fn() { (props.callbacks.on_close_tab)(tid) },
      ))
      items
    },
    props.callbacks.on_close,
  )
}

pub struct BookmarksBarContextProps {
  pub open : () -> Bool
  pub bookmark_id : () -> String
  pub bookmark_url : () -> String
  pub anchor_x : () -> Double
  pub anchor_y : () -> Double
  pub on_open_split : (String) -> Unit
  pub on_open_peek : (String) -> Unit
  pub on_remove : (String) -> Unit
  pub on_close : () -> Unit
}

///| Builds the Liquid Glass Bookmarks Bar Context Menu (tag `"bm_bar_ctx"`).
pub fn build_bookmarks_bar_context_menu(root : view::View, props : BookmarksBarContextProps) -> Unit {
  build_anchored_menu_overlay(
    root,
    props.open,
