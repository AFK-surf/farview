///| Synthetic site icons for the demo shell, the offscreen scenes and tests: plain shapes drawn here and encoded to
///| PNG at run time. They stand in for real favicons, which are other people's marks and never kept in the repo.

import "pixels"

///| Shapes `shell_favicon_demo_png` draws.
pub enum DemoIconShape {
  Disc
  Ring
  Triangle
  Quadrants
  Diagonal
  Bar
}

fn demo_inside(shape : DemoIconShape, x : Double, y : Double) -> Int {
  // (x, y) in 0..1; 0 outside, 1 the main color, 2 the second
  let dx = x - 0.5
  let dy = y - 0.5
  let r2 = dx * dx + dy * dy
  match shape {
    DemoIconShape::Disc => if r2 <= 0.2025 { 1 } else { 0 }
    DemoIconShape::Ring => if r2 <= 0.2025 && r2 >= 0.0729 { 1 } else if r2 < 0.0225 { 1 } else { 0 }
    DemoIconShape::Triangle => {
      let half = (y - 0.12) * 0.62
      let ax = if dx < 0.0 { 0.0 - dx } else { dx }
      if y >= 0.12 && y <= 0.86 && ax <= half { 1 } else { 0 }
    }
    DemoIconShape::Quadrants => {
      if x < 0.08 || x > 0.92 || y < 0.08 || y > 0.92 {
        0
      } else if (x < 0.5) == (y < 0.5) {
        1
      } else {
        2
      }
    }
    DemoIconShape::Diagonal => {
      if x < 0.1 || x > 0.9 || y < 0.1 || y > 0.9 {
        0
      } else if x + y < 1.0 {
        1
      } else {
        2
      }
    }
    DemoIconShape::Bar => {
      if x < 0.06 || x > 0.94 || y < 0.06 || y > 0.94 {
        0
      } else if y > 0.4 && y < 0.6 && x > 0.22 && x < 0.78 {
        2
      } else {
        1
      }
    }
  }
}

///| A square PNG of `edge` px: `shape` in `color` (0xRRGGBBAA), its second part (if any) in `second`, clear
///| around it; edges smoothed by 4x4 samples per pixel.
pub fn shell_favicon_demo_png(shape : DemoIconShape, color : Int64, second~ : Int64 = 0xFFFFFFFFL, edge~ : Int = 64) -> Bytes {
  let rgba = Bytes::new(edge * edge * 4)
  let cols = [color, second]
  let mut y = 0
  while y < edge {
    let mut x = 0
    while x < edge {
      let counts = [0, 0]
      let mut sy = 0
      while sy < 4 {
        let mut sx = 0
        while sx < 4 {
          let fx = (x.to_double() + (sx.to_double() + 0.5) / 4.0) / edge.to_double()
          let fy = (y.to_double() + (sy.to_double() + 0.5) / 4.0) / edge.to_double()
          let k = demo_inside(shape, fx, fy)
          if k > 0 {
            counts[k - 1] = counts[k - 1] + 1
          }
          sx = sx + 1
        }
        sy = sy + 1
      }
      let total = counts[0] + counts[1]
      if total > 0 {
        let c = if counts[1] > counts[0] { cols[1] } else { cols[0] }
        let o = (y * edge + x) * 4
        rgba[o] = ((c >> 24) & 0xFFL).to_int().to_byte()
        rgba[o + 1] = ((c >> 16) & 0xFFL).to_int().to_byte()
        rgba[o + 2] = ((c >> 8) & 0xFFL).to_int().to_byte()
        rgba[o + 3] = ((c & 0xFFL).to_int() * total / 16).to_byte()
      }
      x = x + 1
    }
    y = y + 1
  }
  pixels::png(edge, edge, rgba)
}

///| The demo shell's sites with a synthetic icon each (the others keep their letter tiles, as a site without an
///| icon would): host, shape, color, second color.
pub fn shell_favicon_demo_sites() -> Array[(String, DemoIconShape, Int64, Int64)] {
  [
    ("github.com", DemoIconShape::Ring, 0x24292FFFL, 0xFFFFFFFFL),
    ("developer.mozilla.org", DemoIconShape::Triangle, 0x1B1B1BFFL, 0xFFFFFFFFL),
    ("drafts.csswg.org", DemoIconShape::Quadrants, 0x2F6FD8FFL, 0xF2B233FFL),
    ("soma.fm", DemoIconShape::Disc, 0xE8590CFFL, 0xFFFFFFFFL),
    ("en.wikipedia.org", DemoIconShape::Diagonal, 0x3A3A3CFFL, 0xA2A2A8FFL),
    ("linear.app", DemoIconShape::Bar, 0x5E6AD2FFL, 0xFFFFFFFFL),
    ("figma.com", DemoIconShape::Quadrants, 0xF24E1EFFL, 0x0ACF83FFL),
  ]
}

///| Gives the demo shell's sites their synthetic icons (`shell_site_icon_put`, as the app does with the host's).
pub fn shell_favicon_demo_install() -> Unit {
  for s in shell_favicon_demo_sites() {
    let png = shell_favicon_demo_png(s.1, s.2, second=s.3)
    shell_site_icon_put(s.0, "", png)
  }
}
