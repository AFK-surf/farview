///| Farview Desktop Shell 2.0 — Liquid Glass Settings Panel (`Cmd+,` / `Ctrl+,`).
///|
///| Architectural invariants:
///| - Single-layer dense Liquid Glass outer dialog frame (`lg::liquid_dialog_shell_node`)
///|   with `headless::dialog` focus trap and full-window pointer-blocking scrim.
///| - Solid Apple Content Layer (`lg::surface()`) inside the dialog for BOTH the
///|   left navigation sidebar AND the right content pane (zero glass-on-glass).
///| - Preserves the 3 real settings tabs: General (5-engine default search, default zoom,
///|   auto-archive), Appearance (Light/Dark visual cards, Compact Sidebar), and
///|   Privacy & Data (HTTPS-Only, Block 3P Cookies, DNT, per-category Clear Browsing Data
///|   for bookmarks / history / cookies / downloads / boosts).
///| - Responsive Light/Dark + narrow viewport (< 640pt switches sidebar to top tab bar).
///| - Pure `packages/lg` overlays, vector icons only, 100% explicit `color_by`.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

pub let SETTINGS_TAB_GENERAL : Int = 0
pub let SETTINGS_TAB_APPEARANCE : Int = 1
pub let SETTINGS_TAB_PRIVACY : Int = 2

let sp_narrow_breakpoint : Double = 640.0

///| Per-category Clear Browsing Data selection (unchecked categories are preserved).
#derive(Eq)
pub struct ClearBrowsingDataSelection {
  pub bookmarks : Bool
  pub history : Bool
  pub downloads : Bool
  pub boosts : Bool
}

pub fn ClearBrowsingDataSelection::default() -> ClearBrowsingDataSelection {
  ClearBrowsingDataSelection::{
    bookmarks: false,
    history: true,
    downloads: true,
    boosts: false,
  }
}

pub fn ClearBrowsingDataSelection::any_selected(self : ClearBrowsingDataSelection) -> Bool {
  self.bookmarks || self.history || self.downloads || self.boosts
}

///| Strongly typed props for `build_settings_panel`.
pub struct SettingsPanelProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub active_tab : signals::Signal[Int]
  pub settings : () -> proto::BrowserSettings
  pub clear_bookmarks : signals::Signal[Bool]
  pub clear_history : signals::Signal[Bool]
  pub clear_downloads : signals::Signal[Bool]
  pub clear_boosts : signals::Signal[Bool]
  pub filter_field : Option[ui::Field]
  pub on_save_settings : (proto::BrowserSettings, String) -> Unit
  pub on_step_zoom : (Int) -> Unit
  pub on_clear_browsing_data : (ClearBrowsingDataSelection) -> Unit
  pub on_close : () -> Unit
}

fn sp_content_bg(dark : Bool) -> Int64 {
  if dark { 0x16181FFFL } else { lg::surface().grouped_bg }
}

fn sp_header_bg(dark : Bool) -> Int64 {
  if dark { 0x1C1F27FFL } else { lg::surface().card }
}

fn sp_accent_ink(dark : Bool) -> Int64 {
  if dark { 0x60A5FAFFL } else { 0x0055CCFFL }
}

fn sp_accent_fill(dark : Bool) -> Int64 {
  if dark { 0x1E3A5FFFL } else { 0xE8F1FFFFL }
}

fn sp_accent_border(dark : Bool) -> Int64 {
  if dark { 0x3B82F6FFL } else { 0x93C5FDFFL }
}

fn sp_danger_ink(dark : Bool) -> Int64 {
  if dark { 0xFF6961FFL } else { 0xB91C1CFFL }
}

fn sp_danger_fill(dark : Bool) -> Int64 {
  if dark { 0x3A1D20FFL } else { 0xFEF2F2FFL }
}

fn sp_danger_border(dark : Bool) -> Int64 {
  if dark { 0x7F2931FFL } else { 0xFCA5A5FFL }
}

fn sp_ascii_lower(s : String) -> String {
  let lower_az = "abcdefghijklmnopqrstuvwxyz"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 65 && c <= 90 {
      sb.write_string(lower_az.slice(c - 65, c - 64))
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i += 1
  }
  sb.to_string()
}

let sp_kw_search : String = "default search engine google duckduckgo kagi perplexity bing"
let sp_kw_zoom : String = "default page zoom scale percent 75 150"
let sp_kw_archive : String = "auto-archive auto archive today tabs sweep unpinned inactivity 12 24 7 days never"
let sp_kw_appearance : String = "browser appearance light dark theme chrome"
let sp_kw_sidebar : String = "compact sidebar narrower width 204 204pt page"
let sp_kw_privacy : String = "https-only https only mode block third-party third party cookies send do not track dnt privacy"
let sp_kw_clear_data : String = "clear browsing data bookmarks history downloads site boosts"

fn sp_matches_filter(query : String, haystack : String) -> Bool {
  let q = sp_ascii_lower(query.trim())
  if q == "" {
    return true
  }
  sp_ascii_lower(haystack).contains(q)
}

fn sp_icon_btn(
  parent : view::View,
  label : String,
  icon_name : String,
  on_press : () -> Unit,
) -> Unit {
  let _ = lg::liquid_button_node(
    parent,
    fn() { label },
    on_press,
    content=fn(inner : view::View) -> Unit {
      let _ = shell_icon(
        inner,
        icon_name,
        size=15.0,
        color_by=fn() { lg::surface().ink },
      )
    },
    flat=true,
    ghost=true,
    height=30.0,
    pad_x=9.0,
  )
}

fn sp_toggle_row(
  parent : view::View,
  title : String,
  subtitle : String,
  is_on : () -> Bool,
  on_change : (Bool) -> Unit,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
    .gap(view::Live::Is(12.0))
    let _ = row.box(fn(col : view::View) -> Unit {
      let _ = col
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      .gap(view::Live::Is(2.0))
      <ui::Text in={col} size={13.0} weight={500} color_by=>{lg::surface().ink} text={title} />
      <ui::Text in={col} size={11.5} wrap color_by=>{lg::surface().ink_secondary} text={subtitle} />
    })
    let _ = lg::liquid_toggle_node(row, is_on, on_change, fn() { title }, width=44.0, height=24.0)
  })
}

fn sp_divider(parent : view::View) -> Unit {
  let _ = parent.box(fn(sep : view::View) -> Unit {
    let _ = sep
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

fn sp_nav_item(
  parent : view::View,
  idx : Int,
  icon_name : String,
  label : String,
  props : SettingsPanelProps,
  compact : Bool,
) -> Unit {
  let is_act = fn() -> Bool { props.active_tab.get() == idx }
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_v : view::View) -> Unit { props.active_tab.set(idx) },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .min_height(view::Live::Is(Some(36.0)))
      .min_width(view::Live::Is(Some(36.0)))
      .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
      .gap(view::Live::Is(8.0))
      .radius(view::Live::Is(lg::r_row))
      .ground(view::Live::By(fn() -> Int64 {
        let s = lg::surface()
        if is_act() {
          if props.dark() { 0x2A2D36FFL } else { s.card }
        } else if btn.pressed() {
          s.row_selected
        } else if btn.hovered() {
          s.row_hover
        } else {
          0x00000000L
        }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if is_act() { (lg::hairline_w, lg::surface().separator_strong) } else { (0.0, 0x00000000L) }
      }))
      if compact {
        let _ = b.grow(view::Live::Is(1.0)).lies_along(view::Live::Is(view::Lies::Middle))
      } else {
        let _ = b.rigid()
      }
      let _ = shell_icon(
        b,
        icon_name,
        size=15.0,
        color_by=fn() {
          if is_act() { sp_accent_ink(props.dark()) } else { lg::surface().ink_secondary }
        },
      )
      <ui::Text
        in={b}
        size={13.0}
        weight={500}
        color_by=>{if is_act() { lg::surface().ink } else { lg::surface().ink_secondary }}
        text={label}
      />
    },
  )
}

fn sp_build_general_tab(parent : view::View, props : SettingsPanelProps, filter_query : () -> String) -> Unit {
  let _ = parent.gap(view::Live::Is(14.0))

  // Card 1: Default Search Engine (5 real engines)
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_search) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          let _ = card.box(fn(hdr : view::View) -> Unit {
            let _ = hdr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .gap(view::Live::Is(8.0))
            <ui::Text in={hdr} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Default Search Engine" />
            <ui::Text
              in={hdr}
              size={11.5}
              weight={500}
              color_by=>{sp_accent_ink(props.dark())}
              text_by=>{proto::search_engine_host((props.settings)().search_engine)}
            />
          })
          let _ = card.box(fn(pills : view::View) -> Unit {
            let _ = pills
            .row(view::Live::Is(true))
            .wraps(view::Live::Is(Some(6.0)))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(6.0))
            let engine_pill = fn(id : String, label : String) -> Unit {
              let is_sel = fn() -> Bool {
                proto::normalize_search_engine((props.settings)().search_engine) == id
              }
              let _ = headless::button(
                pills,
                fn() { "Search Engine " + label },
                fn(_v : view::View) -> Unit {
                  let cur = signals::untracked(props.settings)
                  (props.on_save_settings)(
                    proto::BrowserSettings::{ ..cur, search_engine: id },
                    "Search Engine: " + label,
                  )
                },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .min_height(view::Live::Is(Some(36.0)))
                  .min_width(view::Live::Is(Some(36.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                  .radius(view::Live::Is(lg::r_chip))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_sel() {
                      sp_accent_fill(props.dark())
                    } else if btn.pressed() {
                      lg::surface().row_selected
                    } else if btn.hovered() {
                      lg::surface().row_hover
                    } else {
                      lg::surface().card_secondary
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    if is_sel() { (1.0, sp_accent_border(props.dark())) } else { (lg::hairline_w, lg::surface().separator_strong) }
                  }))
                  <ui::Text
                    in={b}
                    size={12.0}
                    weight={500}
                    color_by=>{if is_sel() { sp_accent_ink(props.dark()) } else { lg::surface().ink }}
                    text={label}
                  />
                },
              )
            }
            engine_pill("google", "Google")
            engine_pill("duckduckgo", "DuckDuckGo")
            engine_pill("kagi", "Kagi")
            engine_pill("perplexity", "Perplexity")
            engine_pill("bing", "Bing")
          })
        },
        radius=lg::r_row,
        pad=14.0,
        gap=10.0,
        label=fn() { "Default Search Engine" },
      )
    },
  )

  // Card 2: Default Page Zoom (75% - 150%)
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_zoom) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          let _ = card.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(12.0))
            let _ = row.box(fn(info : view::View) -> Unit {
              let _ = info
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .gap(view::Live::Is(2.0))
              <ui::Text in={info} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Default Page Zoom" />
              <ui::Text in={info} size={11.5} wrap color_by=>{lg::surface().ink_secondary} text="Applies baseline scale between 75% and 150%" />
            })
            let _ = row.box(fn(ctrl : view::View) -> Unit {
              let _ = ctrl
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .gap(view::Live::Is(6.0))
              let zoom_btn = fn(icon_name : String, aria : String, delta : Int) -> Unit {
                let _ = headless::button(
                  ctrl,
                  fn() { aria },
                  fn(_v : view::View) -> Unit { (props.on_step_zoom)(delta) },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let _ = b
                    .width(view::Live::Is(Some(36.0)))
                    .height(view::Live::Is(Some(36.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(lg::r_chip))
                    .ground(view::Live::By(fn() -> Int64 {
                      if btn.pressed() {
                        lg::surface().row_selected
                      } else if btn.hovered() {
                        lg::surface().row_hover
                      } else {
                        lg::surface().card_secondary
                      }
                    }))
                    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
                    let _ = shell_icon(b, icon_name, size=14.0, color_by=fn() { lg::surface().ink })
                  },
                )
              }
              zoom_btn("minus", "Decrease Default Zoom", -1)
              let _ = ctrl.box(fn(zbox : view::View) -> Unit {
                let _ = zbox
                .width(view::Live::Is(Some(56.0)))
                .height(view::Live::Is(Some(36.0)))
                .rigid()
                .center()
                .radius(view::Live::Is(lg::r_chip))
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                <ui::Text
                  in={zbox}
                  size={12.0}
                  weight={600}
                  color_by=>{lg::surface().ink}
                  text_by=>{(props.settings)().default_zoom_pct.to_string() + "%"}
                />
              })
              zoom_btn("plus", "Increase Default Zoom", 1)
            })
          })
        },
        radius=lg::r_row,
        pad=14.0,
        label=fn() { "Default Page Zoom" },
      )
    },
  )

  // Card 3: Auto-Archive Today Tabs (12h / 24h / 7d / Never)
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_archive) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          let _ = card.box(fn(info : view::View) -> Unit {
            let _ = info.gap(view::Live::Is(2.0))
            <ui::Text in={info} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Auto-Archive Today Tabs" />
            <ui::Text in={info} size={11.5} wrap color_by=>{lg::surface().ink_secondary} text="Automatically sweep unpinned tabs after inactivity" />
          })
          let _ = card.box(fn(seg : view::View) -> Unit {
            let _ = seg
            .row(view::Live::Is(true))
            .wraps(view::Live::Is(Some(6.0)))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(6.0))
            let arch_pill = fn(hours : Int, label : String) -> Unit {
              let is_sel = fn() -> Bool {
                proto::normalize_auto_archive_hours((props.settings)().auto_archive_hours) == hours
              }
              let _ = headless::button(
                seg,
                fn() { "Auto-Archive " + label },
                fn(_v : view::View) -> Unit {
                  let cur = signals::untracked(props.settings)
                  (props.on_save_settings)(
                    proto::BrowserSettings::{ ..cur, auto_archive_hours: hours },
                    "Auto-Archive: " + label,
                  )
                },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .min_height(view::Live::Is(Some(36.0)))
                  .min_width(view::Live::Is(Some(72.0)))
                  .grow(view::Live::Is(1.0))
                  .center()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .radius(view::Live::Is(lg::r_chip))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_sel() {
                      sp_accent_fill(props.dark())
                    } else if btn.pressed() {
                      lg::surface().row_selected
                    } else if btn.hovered() {
                      lg::surface().row_hover
                    } else {
                      lg::surface().card_secondary
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    if is_sel() { (1.0, sp_accent_border(props.dark())) } else { (lg::hairline_w, lg::surface().separator_strong) }
                  }))
                  <ui::Text
                    in={b}
                    size={12.0}
                    weight={500}
                    color_by=>{if is_sel() { sp_accent_ink(props.dark()) } else { lg::surface().ink }}
                    text={label}
                  />
                },
              )
            }
            arch_pill(12, "12 hours")
            arch_pill(24, "24 hours")
            arch_pill(168, "7 days")
            arch_pill(0, "Never")
          })
        },
        radius=lg::r_row,
        pad=14.0,
        gap=10.0,
        label=fn() { "Auto-Archive Today Tabs" },
      )
    },
  )
}

fn sp_build_appearance_tab(parent : view::View, props : SettingsPanelProps, filter_query : () -> String) -> Unit {
  let _ = parent.gap(view::Live::Is(14.0))

  // Card 1: Browser Appearance (Light / Dark)
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_appearance) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          let _ = card.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.gap(view::Live::Is(2.0))
            <ui::Text in={hdr} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Browser Appearance" />
            <ui::Text in={hdr} size={11.5} wrap color_by=>{lg::surface().ink_secondary} text="Switches toolbar, sidebar, address bar, and panels instantly" />
          })
          let _ = card.box(fn(grid : view::View) -> Unit {
            let _ = grid.row(view::Live::Is(true)).gap(view::Live::Is(12.0))
            let theme_card = fn(
              id : String,
              title : String,
              desc : String,
              pv_bar : Int64,
              pv_side : Int64,
              pv_addr : Int64,
              pv_page : Int64,
              pv_line : Int64,
            ) -> Unit {
              let is_sel = fn() -> Bool {
                if id == "dark" { (props.dark)() } else { !(props.dark)() }
              }
              let _ = headless::button(
                grid,
                fn() { "Theme " + title },
                fn(_v : view::View) -> Unit {
                  let cur = signals::untracked(props.settings)
                  (props.on_save_settings)(
                    proto::BrowserSettings::{ ..cur, chrome_theme: id },
                    title + " Appearance Enabled",
                  )
                },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
                  .gap(view::Live::Is(8.0))
                  .radius(view::Live::Is(14.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_sel() {
                      sp_accent_fill(props.dark())
                    } else if btn.pressed() {
                      lg::surface().row_selected
                    } else if btn.hovered() {
                      lg::surface().row_hover
                    } else {
                      lg::surface().card_secondary
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    if is_sel() { (1.5, sp_accent_ink(props.dark())) } else { (lg::hairline_w, lg::surface().separator_strong) }
                  }))

                  // Miniature solid browser chrome preview swatch (concentric r = 14 - 8 = 6pt)
                  let _ = b.box(fn(pv : view::View) -> Unit {
                    let _ = pv
                    .height(view::Live::Is(Some(68.0)))
                    .clips(view::Live::Is(true))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::Is(pv_page))
                    .edge(view::Live::Is((1.0, pv_line)))

                    let _ = pv.box(fn(mb : view::View) -> Unit {
                      let _ = mb
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .height(view::Live::Is(Some(18.0)))
                      .rigid()
                      .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                      .gap(view::Live::Is(4.0))
                      .ground(view::Live::Is(pv_bar))
                      let _ = mb.box(fn(d : view::View) -> Unit { let _ = d.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(0xEF4444FFL)) })
                      let _ = mb.box(fn(d : view::View) -> Unit { let _ = d.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(0xF59E0BFFL)) })
                      let _ = mb.box(fn(d : view::View) -> Unit { let _ = d.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.5)).ground(view::Live::Is(0x10B981FFL)) })
                      let _ = mb.box(fn(ma : view::View) -> Unit {
                        let _ = ma
                        .grow(view::Live::Is(1.0))
                        .height(view::Live::Is(Some(9.0)))
                        .radius(view::Live::Is(3.0))
                        .ground(view::Live::Is(pv_addr))
                        .edge(view::Live::Is((1.0, pv_line)))
                      })
                    })
                    let _ = pv.box(fn(mbody : view::View) -> Unit {
                      let _ = mbody.row(view::Live::Is(true)).grow(view::Live::Is(1.0))
                      let _ = mbody.box(fn(ms : view::View) -> Unit {
                        let _ = ms
                        .width(view::Live::Is(Some(42.0)))
                        .rigid()
                        .padding(view::Live::Is((5.0, 5.0, 5.0, 5.0)))
                        .gap(view::Live::Is(4.0))
                        .ground(view::Live::Is(pv_side))
                        let _ = ms.box(fn(r : view::View) -> Unit { let _ = r.height(view::Live::Is(Some(7.0))).radius(view::Live::Is(2.0)).ground(view::Live::Is(pv_addr)) })
                        let _ = ms.box(fn(r : view::View) -> Unit { let _ = r.height(view::Live::Is(Some(5.0))).radius(view::Live::Is(2.0)).ground(view::Live::Is(pv_line)) })
                      })
                      let _ = mbody.box(fn(mp : view::View) -> Unit { let _ = mp.grow(view::Live::Is(1.0)).ground(view::Live::Is(pv_page)) })
                    })
                  })

                  // Label + Active vector check badge (first-line aligned)
                  let _ = b.box(fn(ft : view::View) -> Unit {
                    let _ = ft
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Start)))
                    .gap(view::Live::Is(6.0))
                    let _ = ft.box(fn(col : view::View) -> Unit {
                      let _ = col
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .gap(view::Live::Is(1.0))
                      <ui::Text in={col} size={12.5} weight={600} color_by=>{lg::surface().ink} text={title} />
                      <ui::Text in={col} size={11.0} wrap color_by=>{lg::surface().ink_secondary} text={desc} />
                    })
                    ft.show(is_sel, fn(chk : view::View) -> Unit {
                      let _ = chk
                      .width(view::Live::Is(Some(16.0)))
                      .height(view::Live::Is(Some(16.0)))
                      .rigid()
                      .center()
                      let _ = shell_icon(chk, ICON_CHECK, size=14.0, color_by=fn() { sp_accent_ink(props.dark()) })
                    })
                  })
                },
              )
            }
            theme_card("light", "Light", "Clean solid silver chrome", 0xF2F2F7FFL, 0xECECEFFFL, 0xFFFFFFFFL, 0xFAFBFFFFL, 0xDCDCE2FFL)
            theme_card("dark", "Dark", "Deep slate desktop chrome", 0x181A20FFL, 0x141518FFL, 0x22252EFFL, 0x0F1117FFL, 0x2C303CFFL)
          })
        },
        radius=lg::r_row,
        pad=14.0,
        gap=12.0,
        label=fn() { "Browser Appearance" },
      )
    },
  )

  // Card 2: Compact Sidebar Toggle
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_sidebar) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          sp_toggle_row(
            card,
            "Compact Sidebar",
            "Use a narrower 204pt sidebar to maximize page width",
            fn() { (props.settings)().compact_sidebar },
            fn(next_v : Bool) -> Unit {
              let cur = signals::untracked(props.settings)
              (props.on_save_settings)(
                proto::BrowserSettings::{ ..cur, compact_sidebar: next_v },
                if next_v { "Compact Sidebar Enabled" } else { "Standard Sidebar Width" },
              )
            },
          )
        },
        radius=lg::r_row,
        pad=0.0,
        label=fn() { "Sidebar Layout" },
      )
    },
  )
}

fn sp_build_privacy_tab(parent : view::View, props : SettingsPanelProps, filter_query : () -> String) -> Unit {
  let _ = parent.gap(view::Live::Is(14.0))

  // Card 1: Privacy Switches
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_privacy) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          sp_toggle_row(
            card,
            "HTTPS-Only Mode",
            "Automatically upgrade external http:// URLs (keeps localhost)",
            fn() { (props.settings)().https_only },
            fn(next_v : Bool) -> Unit {
              let cur = signals::untracked(props.settings)
              (props.on_save_settings)(
                proto::BrowserSettings::{ ..cur, https_only: next_v },
                if next_v { "HTTPS-Only Mode On" } else { "HTTPS-Only Mode Off" },
              )
            },
          )
          sp_divider(card)
          sp_toggle_row(
            card,
            "Block Third-Party Cookies",
            "Restrict cross-site tracking cookies across Spaces",
            fn() { (props.settings)().block_third_party_cookies },
            fn(next_v : Bool) -> Unit {
              let cur = signals::untracked(props.settings)
              (props.on_save_settings)(
                proto::BrowserSettings::{ ..cur, block_third_party_cookies: next_v },
                "",
              )
            },
          )
          sp_divider(card)
          sp_toggle_row(
            card,
            "Send Do Not Track",
            "Include DNT: 1 preference header on outgoing requests",
            fn() { (props.settings)().send_dnt },
            fn(next_v : Bool) -> Unit {
              let cur = signals::untracked(props.settings)
              (props.on_save_settings)(
                proto::BrowserSettings::{ ..cur, send_dnt: next_v },
                "",
              )
            },
          )
        },
        radius=lg::r_row,
        pad=0.0,
        label=fn() { "Privacy Protections" },
      )
    },
  )

  // Card 2: Clear Browsing Data (independent per-category checkboxes)
  parent.show(
    fn() { sp_matches_filter(filter_query(), sp_kw_clear_data) },
    fn(wrap : view::View) -> Unit {
      let _ = lg::surface_card_node(
        wrap,
        fn(card : view::View) -> Unit {
          let _ = card.box(fn(info : view::View) -> Unit {
            let _ = info.gap(view::Live::Is(2.0))
            <ui::Text in={info} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Clear Browsing Data" />
            <ui::Text in={info} size={11.5} wrap color_by=>{lg::surface().ink_secondary} text="Remove selected categories only; unchecked data is preserved" />
          })

          let _ = card.box(fn(chips : view::View) -> Unit {
            let _ = chips
            .row(view::Live::Is(true))
            .wraps(view::Live::Is(Some(8.0)))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(8.0))

            let check_chip = fn(label : String, sig : signals::Signal[Bool]) -> Unit {
              let _ = headless::button(
                chips,
                fn() { "Toggle Clear " + label },
                fn(_v : view::View) -> Unit { sig.set(!sig.untracked()) },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .min_height(view::Live::Is(Some(36.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 12.0, 0.0)))
                  .gap(view::Live::Is(7.0))
                  .radius(view::Live::Is(lg::r_chip))
                  .ground(view::Live::By(fn() -> Int64 {
                    if sig.get() {
                      sp_accent_fill(props.dark())
                    } else if btn.pressed() {
                      lg::surface().row_selected
                    } else if btn.hovered() {
                      lg::surface().row_hover
                    } else {
                      lg::surface().card_secondary
                    }
                  }))
                  .edge(view::Live::By(fn() -> (Double, Int64) {
                    if sig.get() { (1.0, sp_accent_border(props.dark())) } else { (lg::hairline_w, lg::surface().separator_strong) }
                  }))
                  let _ = b.box(fn(box_c : view::View) -> Unit {
                    let _ = box_c
                    .width(view::Live::Is(Some(16.0)))
                    .height(view::Live::Is(Some(16.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(4.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if sig.get() { sp_accent_ink(props.dark()) } else { 0x00000000L }
                    }))
                    .edge(view::Live::By(fn() -> (Double, Int64) {
                      if sig.get() { (1.0, sp_accent_ink(props.dark())) } else { (1.2, lg::surface().ink_secondary) }
                    }))
                    box_c.show(fn() { sig.get() }, fn(ck : view::View) -> Unit {
                      let _ = shell_icon(ck, ICON_CHECK, size=11.0, color_by=fn() { 0xFFFFFFFFL })
                    })
                  })
                  <ui::Text
                    in={b}
                    size={12.0}
                    weight={500}
                    color_by=>{if sig.get() { sp_accent_ink(props.dark()) } else { lg::surface().ink }}
                    text={label}
                  />
                },
              )
            }
            check_chip("Bookmarks", props.clear_bookmarks)
            check_chip("History", props.clear_history)
            check_chip("Downloads", props.clear_downloads)
            check_chip("Site Boosts", props.clear_boosts)
          })

          // Destructive action row
          let _ = card.box(fn(act_row : view::View) -> Unit {
            let _ = act_row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(10.0))
            let _ = headless::button(
              act_row,
              fn() { "Clear Selected Data" },
              fn(_v : view::View) -> Unit {
                (props.on_clear_browsing_data)(ClearBrowsingDataSelection::{
                  bookmarks: props.clear_bookmarks.untracked(),
                  history: props.clear_history.untracked(),
                  downloads: props.clear_downloads.untracked(),
                  boosts: props.clear_boosts.untracked(),
                })
              },
              fn(b : view::View, btn : headless::Button) -> Unit {
                let _ = b
                .min_height(view::Live::Is(Some(36.0)))
                .rigid()
                .center()
                .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
                .radius(view::Live::Is(lg::r_chip))
                .ground(view::Live::By(fn() -> Int64 {
                  if btn.pressed() { sp_danger_border(props.dark()) } else { sp_danger_fill(props.dark()) }
                }))
                .edge(view::Live::By(fn() { (1.0, sp_danger_border(props.dark())) }))
                <ui::Text
                  in={b}
                  size={12.5}
                  weight={600}
                  color_by=>{sp_danger_ink(props.dark())}
                  text="Clear Selected Data"
                />
              },
            )
          })
        },
        radius=lg::r_row,
        pad=14.0,
        gap=12.0,
        label=fn() { "Clear Browsing Data" },
      )
    },
  )
}

///| Builds the Farview Desktop Shell 2.0 Settings Modal Dialog.
///| Outer frame is single-layer Liquid Glass; inner sidebar and content pane are solid `lg::surface()`.
pub fn build_settings_panel(root : view::View, props : SettingsPanelProps) -> Unit {
  let live_win_w = fn() -> Double {
    let _ = root.laid_size_told()
    let ww = root.window_w()
    if ww > 100.0 {
      ww
    } else {
      let (_, _, rw, _) = root.placed_now()
      if rw > 100.0 { rw } else { 1280.0 }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = root.laid_size_told()
    let wh = root.window_h()
    if wh > 100.0 {
      wh
    } else {
      let (_, _, _, rh) = root.placed_now()
      if rh > 100.0 { rh } else { 800.0 }
    }
  }
  let is_narrow = fn() -> Bool { live_win_w() < sp_narrow_breakpoint }
  let filter_query = fn() -> String {
    match props.filter_field {
      Some(f) => f.text()
      None => ""
    }
  }

  root.show(props.open, fn(dlg_wrap : view::View) -> Unit {
    let _ = dlg_wrap.over(view::Live::Is(true)).center()
    // Visual dimmed backdrop (sibling outside headless::dialog so close_on_outside catches backdrop clicks)
    let _ = dlg_wrap.box(fn(scrim : view::View) -> Unit {
      let _ = scrim
      .over(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 {
        if (props.dark)() { 0x05070B88L } else { 0x0F172A46L }
      }))
    })
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Settings" },
      props.open,
      props.on_close,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        // Outer single-layer Liquid Glass dialog frame
        let _ = lg::liquid_dialog_shell_node(
          dlg_box,
          fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() -> Option[Double] {
              let rw = live_win_w()
              if rw < 732.0 {
                let w = rw - 32.0
                Some(if w > 320.0 { w } else { 320.0 })
              } else {
                Some(700.0)
              }
            }))
            .height(view::Live::By(fn() -> Option[Double] {
              let rh = live_win_h()
              if rh < 560.0 {
                let h = rh - 48.0
                Some(if h > 360.0 { h } else { 360.0 })
              } else {
                Some(512.0)
              }
            }))
            .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // Inner solid content frame (concentric r = 24 - 8 = 16pt)
            let _ = shell.box(fn(inner : view::View) -> Unit {
              let _ = inner
              .fill()
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(lg::concentric(24.0, 8.0)))
              .ground(view::Live::By(fn() { sp_content_bg((props.dark)()) }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

              // 1. Header Bar (solid)
              let _ = inner.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(48.0)))
                .rigid()
                .padding(view::Live::Is((16.0, 0.0, 10.0, 0.0)))
                .gap(view::Live::Is(10.0))
                .ground(view::Live::By(fn() { sp_header_bg((props.dark)()) }))

                let _ = shell_icon(hdr, ICON_SETTINGS, size=16.0, color_by=fn() { sp_accent_ink(props.dark()) })
                let _ = hdr.box(fn(title_wrap : view::View) -> Unit {
                  let _ = title_wrap.grow(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0)))
                  <ui::Text in={title_wrap} size={15.0} weight={600} color_by=>{lg::surface().ink} text="Settings" />
                })

                // Optional reused `ui::Field` for quick settings filtering
                match props.filter_field {
                  Some(ff) => {
                    let _ = hdr.box(fn(fw : view::View) -> Unit {
                      let _ = fw
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .width(view::Live::By(fn() -> Option[Double] {
                        if is_narrow() { Some(140.0) } else { Some(184.0) }
                      }))
                      .height(view::Live::Is(Some(36.0)))
                      .rigid()
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .gap(view::Live::Is(6.0))
                      .radius(view::Live::Is(lg::r_chip))
                      .ground(view::Live::By(fn() { lg::surface().card }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        if ff.focused() { (1.5, sp_accent_ink((props.dark)())) } else { (1.0, lg::surface().separator_strong) }
                      }))
                      let _ = shell_icon(fw, ICON_SEARCH, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                      let _ = fw.box(fn(inp : view::View) -> Unit {
                        let _ = inp.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
                        inp.reacts(fn() { (props.dark)() }, fn(_d : Bool) -> Unit {
                          ff.color = lg::surface().ink
                          ff.ph_color = lg::surface().ink_secondary
                          ff.caret_color = sp_accent_ink((props.dark)())
                        })
                        let typed = ui::field(
                          inp,
                          ff,
                          placeholder="Filter settings...",
                          font_size=12.5,
                          max_lines=1,
                          enter_sends=true,
                          label="Filter Settings",
                          color=lg::surface().ink,
                          placeholder_color=lg::surface().ink_secondary,
                          caret_color=sp_accent_ink((props.dark)()),
                        )
                        let _ = typed
                        .min_height(view::Live::Is(Some(36.0)))
                        .drawn_off(view::Live::Is((0.0, 9.0)))
                        .ink(view::Live::By(fn() {
                          if ff.text().length() > 0 || ff.composing() { lg::surface().ink } else { lg::surface().ink_secondary }
                        }))
                      })
                    })
                  }
                  None => ()
                }

                sp_icon_btn(hdr, "Close Settings", ICON_CLOSE, props.on_close)
              })

              sp_divider(inner)

              // 2. Narrow mode: top horizontal solid tab strip
              inner.show(is_narrow, fn(top_nav : view::View) -> Unit {
                let _ = top_nav
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .rigid()
                .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
                .gap(view::Live::Is(6.0))
                .ground(view::Live::By(fn() { lg::surface().sidebar }))
                sp_nav_item(top_nav, SETTINGS_TAB_GENERAL, ICON_SETTINGS, "General", props, true)
                sp_nav_item(top_nav, SETTINGS_TAB_APPEARANCE, "palette", "Appearance", props, true)
                sp_nav_item(top_nav, SETTINGS_TAB_PRIVACY, ICON_SHIELD, "Privacy", props, true)
              })

              // 3. Body: Solid left nav sidebar (wide) + Solid scrollable right content pane
              let _ = inner.box(fn(body : view::View) -> Unit {
                let _ = body.row(view::Live::Is(true)).fill()

                body.show(fn() { !is_narrow() }, fn(nav_wrap : view::View) -> Unit {
                  let _ = nav_wrap.row(view::Live::Is(true)).rigid()
                  let _ = nav_wrap.box(fn(nav : view::View) -> Unit {
                    let _ = nav
                    .width(view::Live::Is(Some(188.0)))
                    .rigid()
                    .padding(view::Live::Is((10.0, 12.0, 10.0, 12.0)))
                    .gap(view::Live::Is(4.0))
                    .ground(view::Live::By(fn() { lg::surface().sidebar }))

                    sp_nav_item(nav, SETTINGS_TAB_GENERAL, ICON_SETTINGS, "General", props, false)
                    sp_nav_item(nav, SETTINGS_TAB_APPEARANCE, "palette", "Appearance", props, false)
                    sp_nav_item(nav, SETTINGS_TAB_PRIVACY, ICON_SHIELD, "Privacy & Data", props, false)

                    let _ = nav.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                    let _ = nav.box(fn(foot : view::View) -> Unit {
                      let _ = foot.padding(view::Live::Is((10.0, 4.0, 10.0, 4.0)))
                      <ui::Text in={foot} size={11.0} color_by=>{lg::surface().ink_secondary} text="Farview Browser" />
                    })
                  })
                  let _ = nav_wrap.box(fn(vsep : view::View) -> Unit {
                    let _ = vsep
                    .width(view::Live::Is(Some(lg::hairline_w)))
                    .rigid()
                    .ground(view::Live::By(fn() { lg::surface().separator }))
                  })
                })

                // Right scrollable solid content pane
                let _ = body.box(fn(pane : view::View) -> Unit {
                  let _ = pane.fill().ground(view::Live::By(fn() { sp_content_bg((props.dark)()) }))
                  let _ = ui::scroll_box(pane, fn(sc : view::View) -> Unit {
                    let _ = sc.padding(view::Live::Is((18.0, 16.0, 18.0, 18.0))).gap(view::Live::Is(14.0))
                    sc.show(fn() { props.active_tab.get() == SETTINGS_TAB_GENERAL }, fn(g : view::View) -> Unit {
                      sp_build_general_tab(g, props, filter_query)
                    })
                    sc.show(fn() { props.active_tab.get() == SETTINGS_TAB_APPEARANCE }, fn(a : view::View) -> Unit {
                      sp_build_appearance_tab(a, props, filter_query)
                    })
                    sc.show(fn() { props.active_tab.get() == SETTINGS_TAB_PRIVACY }, fn(p : view::View) -> Unit {
                      sp_build_privacy_tab(p, props, filter_query)
                    })
                    // S3: Clear empty state when filter query matches 0 cards in active section
                    let tab_has_match = fn(tab_idx : Int, q : String) -> Bool {
                      if tab_idx == SETTINGS_TAB_GENERAL {
                        sp_matches_filter(q, sp_kw_search) ||
                        sp_matches_filter(q, sp_kw_zoom) ||
                        sp_matches_filter(q, sp_kw_archive)
                      } else if tab_idx == SETTINGS_TAB_APPEARANCE {
                        sp_matches_filter(q, sp_kw_appearance) ||
                        sp_matches_filter(q, sp_kw_sidebar)
                      } else {
                        sp_matches_filter(q, sp_kw_privacy) ||
                        sp_matches_filter(q, sp_kw_clear_data)
                      }
                    }
                    sc.show(
                      fn() -> Bool {
                        let q = filter_query().trim()
                        q != "" && !tab_has_match(props.active_tab.get(), q)
                      },
                      fn(emp : view::View) -> Unit {
                        let _ = lg::surface_card_node(
                          emp,
                          fn(card : view::View) -> Unit {
                            let _ = card.gap(view::Live::Is(4.0))
                            <ui::Text in={card} size={13.0} weight={600} color_by=>{lg::surface().ink} text="No matching settings in this section" />
                            <ui::Text
                              in={card}
                              size={11.5}
                              wrap
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                let q = filter_query().trim()
                                let cur = props.active_tab.get()
                                let hints : Array[String] = []
                                if cur != SETTINGS_TAB_GENERAL && tab_has_match(SETTINGS_TAB_GENERAL, q) {
                                  hints.push("General")
                                }
                                if cur != SETTINGS_TAB_APPEARANCE && tab_has_match(SETTINGS_TAB_APPEARANCE, q) {
                                  hints.push("Appearance")
                                }
                                if cur != SETTINGS_TAB_PRIVACY && tab_has_match(SETTINGS_TAB_PRIVACY, q) {
                                  hints.push("Privacy & Data")
                                }
                                if hints.length() > 0 {
                                  "Matches found in: " + hints.join(", ")
                                } else {
                                  "Try a different keyword such as theme, zoom, search, or privacy."
                                }
                              }
                            />
                          },
                          radius=lg::r_row,
                          pad=14.0,
                          label=fn() { "No Matching Settings" },
                        )
                      },
                    )
                  })
                })
              })
            })
          },
          radius=24.0,
        )
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          match props.filter_field {
            Some(ff) if ff.composing() => {
              ff.compose("")
              return true
            }
            _ => ()
          }
        }
        false
      },
    )
  })
}
