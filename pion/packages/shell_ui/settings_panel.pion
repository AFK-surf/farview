///| Farview Shell 3 Settings (`Cmd+,` / `Ctrl+,`).
///|
///| - One layer of `lg` glass (`lg::liquid_dialog_shell_node`) holds a sidebar of categories, each with its glyph
///|   tile, and a solid content pane of grouped inset lists (caption above, solid card, footnote below).
///| - Categories: General, Appearance, Tabs, Search, Privacy, Downloads, Shortcuts, About. Every `BrowserSettings`
///|   field has exactly one control; on/off settings are toggles, single choices are checkmarked rows.
///| - Clear browsing data keeps its per-category selection (`clear_*` signals) and `on_clear_browsing_data` path;
///|   the Downloads category clears just the download list through the same callback.
///| - The filter field hides groups that don't match, dims categories with no match, and says where matches are.
///| - Below 640pt the sidebar becomes a strip of category tiles above the pane.
///| - `headless::dialog` keeps the focus trap, Escape (after an IME preedit is cancelled) and outside-click close.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

pub let SETTINGS_TAB_GENERAL : Int = 0
pub let SETTINGS_TAB_APPEARANCE : Int = 1
pub let SETTINGS_TAB_PRIVACY : Int = 2
pub let SETTINGS_TAB_TABS : Int = 3
pub let SETTINGS_TAB_SEARCH : Int = 4
pub let SETTINGS_TAB_DOWNLOADS : Int = 5
pub let SETTINGS_TAB_SHORTCUTS : Int = 6
pub let SETTINGS_TAB_ABOUT : Int = 7

///| Per-category Clear Browsing Data selection (unchecked categories are preserved).
#derive(Eq)
pub struct ClearBrowsingDataSelection {
  pub bookmarks : Bool
  pub history : Bool
  pub downloads : Bool
  pub boosts : Bool
}

pub fn ClearBrowsingDataSelection::default() -> ClearBrowsingDataSelection {
  ClearBrowsingDataSelection::{
    bookmarks: false,
    history: true,
    downloads: true,
    boosts: false,
  }
}

pub fn ClearBrowsingDataSelection::any_selected(self : ClearBrowsingDataSelection) -> Bool {
  self.bookmarks || self.history || self.downloads || self.boosts
}

///| Strongly typed props for `build_settings_panel`.
pub struct SettingsPanelProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub active_tab : signals::Signal[Int]
  pub settings : () -> proto::BrowserSettings
  pub clear_bookmarks : signals::Signal[Bool]
  pub clear_history : signals::Signal[Bool]
  pub clear_downloads : signals::Signal[Bool]
  pub clear_boosts : signals::Signal[Bool]
  pub filter_field : Option[ui::Field]
  pub on_save_settings : (proto::BrowserSettings, String) -> Unit
  pub on_step_zoom : (Int) -> Unit
  pub on_clear_browsing_data : (ClearBrowsingDataSelection) -> Unit
  pub on_close : () -> Unit
}

// Tile colors (Apple system palette, one per kind, as in DESIGN.md section 3).
let sp_gray : Int64 = 0x8E8E93FFL
let sp_blue : Int64 = 0x007AFFFFL
let sp_indigo : Int64 = 0x5856D6FFL
let sp_purple : Int64 = 0xAF52DEFFL
let sp_red : Int64 = 0xFF3B30FFL
let sp_orange : Int64 = 0xFF9500FFL
let sp_green : Int64 = 0x34C759FFL
let sp_teal : Int64 = 0x30B0C7FFL

///| Below this window width the sidebar turns into a strip of category tiles.
let sp_narrow_breakpoint : Double = 640.0 // SP_160 * 4

///| One settings category: its tab index, glyph tile and name.
struct SpCategory {
  idx : Int
  icon : String
  color : Int64
  name : String
}

fn sp_categories() -> Array[SpCategory] {
  [
    SpCategory::{ idx: SETTINGS_TAB_GENERAL, icon: ICON_SETTINGS, color: sp_gray, name: "General" },
    SpCategory::{ idx: SETTINGS_TAB_APPEARANCE, icon: "palette", color: sp_purple, name: "Appearance" },
    SpCategory::{ idx: SETTINGS_TAB_TABS, icon: ICON_LAYERS, color: sp_indigo, name: "Tabs" },
    SpCategory::{ idx: SETTINGS_TAB_SEARCH, icon: ICON_SEARCH, color: sp_blue, name: "Search" },
    SpCategory::{ idx: SETTINGS_TAB_PRIVACY, icon: ICON_SHIELD, color: sp_red, name: "Privacy" },
    SpCategory::{ idx: SETTINGS_TAB_DOWNLOADS, icon: ICON_DOWNLOAD, color: sp_blue, name: "Downloads" },
    SpCategory::{ idx: SETTINGS_TAB_SHORTCUTS, icon: ICON_COMMAND, color: sp_teal, name: "Shortcuts" },
    SpCategory::{ idx: SETTINGS_TAB_ABOUT, icon: ICON_INFO, color: sp_gray, name: "About" },
  ]
}

fn sp_category(idx : Int) -> SpCategory {
  let cats = sp_categories()
  for c in cats {
    if c.idx == idx {
      return c
    }
  }
  cats[0]
}

fn sp_ascii_lower(s : String) -> String {
  let lower_az = "abcdefghijklmnopqrstuvwxyz"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 65 && c <= 90 {
      sb.write_string(lower_az.slice(c - 65, c - 64))
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i += 1
  }
  sb.to_string()
}

// Filter keywords, one string per group.
let sp_kw_zoom : String = "general default page zoom scale percent 75 150"
let sp_kw_overview : String = "general search engine theme appearance archive tabs"
let sp_kw_appearance : String = "appearance browser theme light dark mode chrome"
let sp_kw_sidebar : String = "appearance compact sidebar narrow width layout"
let sp_kw_archive : String = "tabs auto-archive auto archive today unpinned inactivity 12 24 hours 7 days never"
let sp_kw_search : String = "search default search engine google duckduckgo kagi perplexity bing"
let sp_kw_privacy : String = "privacy https-only https only mode block third-party third party cookies send do not track dnt tracking"
let sp_kw_clear_data : String = "privacy clear browsing data bookmarks history downloads site boosts delete"
let sp_kw_downloads : String = "downloads download list clear files"
let sp_kw_about : String = "about farview version license mit source pion invar"

fn sp_kw_shortcuts() -> String {
  let sb = StringBuilder::new()
  sb.write_string("shortcuts keyboard keys")
  for g in default_macos_shortcut_groups() {
    for it in g.items {
      sb.write_string(" ")
      sb.write_string(it.action)
    }
  }
  sb.to_string()
}

fn sp_matches_filter(query : String, haystack : String) -> Bool {
  let q = sp_ascii_lower(query.trim())
  if q == "" {
    return true
  }
  sp_ascii_lower(haystack).contains(q)
}

fn sp_tab_keywords(tab : Int) -> Array[String] {
  if tab == SETTINGS_TAB_GENERAL {
    [sp_kw_zoom, sp_kw_overview]
  } else if tab == SETTINGS_TAB_APPEARANCE {
    [sp_kw_appearance, sp_kw_sidebar]
  } else if tab == SETTINGS_TAB_TABS {
    [sp_kw_archive]
  } else if tab == SETTINGS_TAB_SEARCH {
    [sp_kw_search]
  } else if tab == SETTINGS_TAB_PRIVACY {
    [sp_kw_privacy, sp_kw_clear_data]
  } else if tab == SETTINGS_TAB_DOWNLOADS {
    [sp_kw_downloads]
  } else if tab == SETTINGS_TAB_SHORTCUTS {
    [sp_kw_shortcuts()]
  } else {
    [sp_kw_about]
  }
}

fn sp_tab_has_match(tab : Int, q : String) -> Bool {
  for kw in sp_tab_keywords(tab) {
    if sp_matches_filter(q, kw) {
      return true
    }
  }
  false
}

///| Pane ground: grouped background in light, near-black canvas in dark (cards sit one step above it).
fn sp_pane_ground() -> Int64 {
  let s = lg::surface()
  if lg::is_dark() { s.canvas } else { s.grouped_bg }
}

///| Lays out a grouped-list row: min 40pt, SP_12 sides, SP_12 between tile, label and control.
fn sp_row_layout(row : view::View) -> Unit {
  let _ = row
  .row(view::Live::Is(true))
  .lines_up(view::Live::Is(Some(view::Along::Middle)))
  .min_height(view::Live::Is(Some(SP_40)))
  .padding(view::Live::Is((SP_12, SP_6, SP_12, SP_6)))
  .gap(view::Live::Is(SP_12))
}

///| The label column of a row: takes the free width, one line, ellipsis.
fn sp_row_label(row : view::View, text_by : () -> String, color_by~ : () -> Int64 = fn() { lg::surface().ink }) -> Unit {
  let _ = row.box(fn(tw : view::View) -> Unit {
    let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
    <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{color_by()} text_by=>{text_by()} />
  })
}

///| A trailing value in secondary ink (`Light`, `After 24 hours`).
fn sp_row_value(row : view::View, text_by : () -> String) -> Unit {
  let _ = row.box(fn(vw : view::View) -> Unit {
    let _ = vw.shrink(view::Live::Is(0.0))
    <ui::Text in={vw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{text_by()} />
  })
}

///| A static row: glyph tile (or none), label, trailing control.
fn sp_row(
  parent : view::View,
  icon_name : String,
  tile_color : Int64,
  label : String,
  trailing : (view::View) -> Unit,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    sp_row_layout(row)
    if icon_name != "" {
      let _ = shell_glyph_tile(row, icon_name, fn() { tile_color }, size=SP_24)
    }
    sp_row_label(row, fn() { label })
    trailing(row)
  })
}

///| A pressable row (choice, navigation or action): the wash eases in on hover and press.
fn sp_press_row(
  parent : view::View,
  a11y : String,
  on_press : () -> Unit,
  body : (view::View) -> Unit,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { a11y },
    fn(_v : view::View) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let wash_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
      sp_row_layout(b)
      let _ = b.ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
      body(b)
    },
  )
}

///| A choice row: leading tile, label, accent checkmark on the chosen one.
fn sp_choice_row(
  parent : view::View,
  a11y : String,
  label : String,
  lead : (view::View) -> Unit,
  chosen : () -> Bool,
  on_pick : () -> Unit,
  detail~ : String = "",
) -> Unit {
  sp_press_row(parent, a11y, on_pick, fn(b : view::View) -> Unit {
    lead(b)
    sp_row_label(b, fn() { label })
    if detail != "" {
      sp_row_value(b, fn() { detail })
    }
    let _ = b.box(fn(ck : view::View) -> Unit {
      let _ = ck.width(view::Live::Is(Some(IC_MD))).height(view::Live::Is(Some(IC_MD))).shrink(view::Live::Is(0.0)).center()
      ck.show(chosen, at_once=true, fn(ic : view::View) -> Unit {
        let _ = shell_icon(ic, ICON_CHECK, size=IC_MD, color_by=fn() { lg::surface().accent })
      })
    })
  })
}

///| A navigation row: tile, label, current value and a chevron.
fn sp_nav_row(
  parent : view::View,
  a11y : String,
  icon_name : String,
  tile_color : Int64,
  label : String,
  value : () -> String,
  on_press : () -> Unit,
) -> Unit {
  sp_press_row(parent, a11y, on_press, fn(b : view::View) -> Unit {
    let _ = shell_glyph_tile(b, icon_name, fn() { tile_color }, size=SP_24)
    sp_row_label(b, fn() { label })
    sp_row_value(b, value)
    let _ = shell_icon(b, ICON_CHEVRON_RIGHT, size=IC_SM, color_by=fn() { lg::surface().ink_tertiary })
  })
}

///| Hairline between rows, starting where the labels start (`inset_tile=false` for rows without a tile).
fn sp_rule(parent : view::View, inset_tile~ : Bool = true) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .margin(view::Live::Is((if inset_tile { SP_12 + SP_24 + SP_12 } else { SP_12 }, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| A grouped list section: quiet caption, one solid card, optional footnote. Hidden when `shown` is false.
fn sp_group(
  parent : view::View,
  caption : String,
  footnote : String,
  shown : () -> Bool,
  rows : (view::View) -> Unit,
) -> Unit {
  parent.show(shown, at_once=true, fn(sec : view::View) -> Unit {
    let _ = sec.gap(view::Live::Is(SP_6))
    if caption != "" {
      let _ = sec.box(fn(cap : view::View) -> Unit {
        let _ = cap.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={caption} />
      })
    }
    let card = lg::surface_card_node(sec, rows, radius=SP_12, pad=SP_0, label=fn() { caption })
    let _ = card.clips(view::Live::Is(true))
    if footnote != "" {
      let _ = sec.box(fn(fn_box : view::View) -> Unit {
        let _ = fn_box.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={fn_box} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text={footnote} />
      })
    }
  })
}

///| Flat icon button (close): 32pt face, wash eased in on hover.
fn sp_icon_btn(parent : view::View, label : String, icon_name : String, on_press : () -> Unit) -> Unit {
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_v : view::View) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let wash_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
      let _ = shell_icon(b, icon_name, size=IC_MD, color_by=fn() { lg::surface().ink_secondary })
    },
  )
}

///| Splits a shortcut (`⇧⌘T`, `Ctrl+Shift+T`, `⌘[  ⌘]`) into combos of keycaps.
fn sp_shortcut_combos(keys : String) -> Array[Array[String]] {
  let out : Array[Array[String]] = []
  for combo in keys.split("  ") {
    let c = combo.trim()
    if c == "" {
      continue
    }
    let caps : Array[String] = []
    if c.contains("+") && c.length() > 1 {
      for part in c.split("+") {
        if part != "" {
          caps.push(part)
        }
      }
      if c.ends_with("+") {
        caps.push("+")
      }
    } else {
      // macOS: one cap per modifier glyph, the rest of the combo as the key.
      let mods = ["⌘", "⇧", "⌥", "⌃"]
      let mut rest = c
      let mut more = true
      while more && rest != "" {
        more = false
        for m in mods {
          if rest.starts_with(m) {
            caps.push(m)
            rest = rest.slice(m.length(), rest.length())
            more = true
            break
          }
        }
      }
      if rest != "" {
        caps.push(rest)
      }
    }
    out.push(caps)
  }
  out
}

///| Keycap pills for one shortcut.
fn sp_keycaps(parent : view::View, keys : String) -> Unit {
  let _ = parent.box(fn(kc_row : view::View) -> Unit {
    let _ = kc_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).shrink(view::Live::Is(0.0)).gap(view::Live::Is(SP_8))
    for combo in sp_shortcut_combos(keys) {
      let _ = kc_row.box(fn(cb : view::View) -> Unit {
        let _ = cb.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4))
        for cap in combo {
          let _ = cb.box(fn(k : view::View) -> Unit {
            let _ = k
            .height(view::Live::Is(Some(SP_24)))
            .min_width(view::Live::Is(Some(SP_24)))
            .shrink(view::Live::Is(0.0))
            .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
            .radius(view::Live::Is(SP_6))
            .center()
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
            <ui::Text in={k} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={cap} />
          })
        }
      })
    }
  })
}

///| Sentence-case caption for a shortcut group title (`NAVIGATION & TABS` -> `Navigation and tabs`).
fn sp_sentence_case(title : String) -> String {
  let low = sp_ascii_lower(title)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < low.length() {
    let ch = low.slice(i, i + 1)
    sb.write_string(if ch == "&" { "and" } else { ch })
    i += 1
  }
  let lower = sb.to_string()
  if lower.length() == 0 {
    return lower
  }
  let c = lower.code_unit_at(0).to_int()
  if c >= 0x61 && c <= 0x7A {
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    upper.slice(c - 0x61, c - 0x60) + lower.slice(1, lower.length())
  } else {
    lower
  }
}

fn sp_archive_label(hours : Int) -> String {
  let h = proto::normalize_auto_archive_hours(hours)
  if h == 12 {
    "After 12 hours"
  } else if h == 168 {
    "After 7 days"
  } else if h == 0 {
    "Never"
  } else {
    "After 24 hours"
  }
}

fn sp_save(props : SettingsPanelProps, next : (proto::BrowserSettings) -> proto::BrowserSettings, msg : String) -> Unit {
  let cur = signals::untracked(props.settings)
  (props.on_save_settings)(next(cur), msg)
}

// ---------------------------------------------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------------------------------------------

fn sp_build_general(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(parent, "Pages", "New pages open at this zoom. Change it for one site with the zoom shortcuts.", fn() {
    sp_matches_filter(q(), sp_kw_zoom)
  }, fn(g : view::View) -> Unit {
    sp_row(g, "layout-grid", sp_teal, "Default page zoom", fn(tr : view::View) -> Unit {
      let _ = tr.box(fn(st : view::View) -> Unit {
        let _ = st
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .shrink(view::Live::Is(0.0))
        .height(view::Live::Is(Some(SP_32)))
        .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
        .radius(view::Live::Is(SP_8))
        .ground(view::Live::By(fn() { lg::surface().card_secondary }))
        let step_btn = fn(icon_name : String, aria : String, delta : Int) -> Unit {
          let _ = headless::button(
            st,
            fn() { aria },
            fn(_v : view::View) -> Unit { (props.on_step_zoom)(delta) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let wash_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
              let _ = b
              .width(view::Live::Is(Some(SP_32)))
              .height(view::Live::Is(Some(SP_32)))
              .shrink(view::Live::Is(0.0))
              .radius(view::Live::Is(SP_8))
              .center()
              .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
              let _ = shell_icon(b, icon_name, size=IC_SM, color_by=fn() { lg::surface().ink })
            },
          )
        }
        step_btn("minus", "Decrease Default Zoom", -1)
        let _ = st.box(fn(vb : view::View) -> Unit {
          let _ = vb.width(view::Live::Is(Some(SP_48))).shrink(view::Live::Is(0.0)).center()
          <ui::Text
            in={vb}
            size={TX_BODY}
            weight={500}
            color_by=>{lg::surface().ink}
            text_by=>{(props.settings)().default_zoom_pct.to_string() + "%"}
          />
        })
        step_btn(ICON_PLUS, "Increase Default Zoom", 1)
      })
    })
  })
  sp_group(parent, "Browser", "", fn() { sp_matches_filter(q(), sp_kw_overview) }, fn(g : view::View) -> Unit {
    sp_nav_row(
      g,
      "Show Search Settings",
      ICON_SEARCH,
      sp_blue,
      "Search engine",
      fn() { proto::search_engine_label((props.settings)().search_engine) },
      fn() { props.active_tab.set(SETTINGS_TAB_SEARCH) },
    )
    sp_rule(g)
    sp_nav_row(
      g,
      "Show Appearance Settings",
      "palette",
      sp_purple,
      "Theme",
      fn() { if (props.dark)() { "Dark" } else { "Light" } },
      fn() { props.active_tab.set(SETTINGS_TAB_APPEARANCE) },
    )
    sp_rule(g)
    sp_nav_row(
      g,
      "Show Tabs Settings",
      ICON_LAYERS,
      sp_indigo,
      "Archive tabs",
      fn() { sp_archive_label((props.settings)().auto_archive_hours) },
      fn() { props.active_tab.set(SETTINGS_TAB_TABS) },
    )
  })
}

///| A miniature of the window in one theme: tinted frame, sidebar lines, solid page card.
fn sp_theme_thumb(parent : view::View, dark : Bool) -> Unit {
  let pal = if dark { lg::surface_dark } else { lg::surface_light }
  let frame = shell_frame_tint(sp_blue, dark)
  let _ = parent.box(fn(pv : view::View) -> Unit {
    let _ = pv
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(SP_64)))
    .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
    .gap(view::Live::Is(SP_4))
    .radius(view::Live::Is(SP_8))
    .clips(view::Live::Is(true))
    .ground(view::Live::Is(frame))
    .points(view::Live::Is(false))
    let _ = pv.box(fn(side : view::View) -> Unit {
      let _ = side.width(view::Live::Is(Some(SP_24))).shrink(view::Live::Is(0.0)).gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
      let _ = side.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_6))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(shell_wash_strong(dark)))
      })
      let _ = side.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
      let _ = side.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
    })
    let _ = pv.box(fn(page : view::View) -> Unit {
      let _ = page
      .grow(view::Live::Is(1.0))
      .padding(view::Live::Is((SP_6, SP_6, SP_6, SP_6)))
      .gap(view::Live::Is(SP_4))
      .radius(view::Live::Is(SP_4))
      .ground(view::Live::Is(pal.card))
      let _ = page.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).width(view::Live::Is(Some(SP_32))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.ink_tertiary))
      })
      let _ = page.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
      let _ = page.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).width(view::Live::Is(Some(SP_40))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
    })
  })
}

fn sp_build_appearance(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(parent, "Theme", "", fn() { sp_matches_filter(q(), sp_kw_appearance) }, fn(g : view::View) -> Unit {
    let _ = g.box(fn(pick : view::View) -> Unit {
      let _ = pick.row(view::Live::Is(true)).padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12))).gap(view::Live::Is(SP_12))
      let choice = fn(id : String, title : String) -> Unit {
        let is_sel = fn() -> Bool { if id == "dark" { (props.dark)() } else { !(props.dark)() } }
        let _ = headless::button(
          pick,
          fn() { "Theme " + title },
          fn(_v : view::View) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, chrome_theme: id } }, title + " appearance")
          },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let sel_t = motion::hover_fade(b, is_sel)
            let hov_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
            let _ = b
            .grow(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(SP_0)))
            .min_width(view::Live::Is(Some(SP_0)))
            .gap(view::Live::Is(SP_8))
            let _ = b.box(fn(ring : view::View) -> Unit {
              let _ = ring
              .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
              .radius(view::Live::Is(SP_10))
              .edge(view::Live::By(fn() {
                let s = lg::surface()
                let t = sel_t()
                if t > 0.01 {
                  (SP_2, lg::alpha(s.accent, t))
                } else {
                  (SP_2, lg::alpha(s.separator_strong, hov_t()))
                }
              }))
              .min_width(view::Live::Is(Some(SP_0)))
              sp_theme_thumb(ring, id == "dark")
            })
            let _ = b.box(fn(cap : view::View) -> Unit {
              let _ = cap.lines_up(view::Live::Is(Some(view::Along::Middle)))
              <ui::Text
                in={cap}
                size={TX_FOOTNOTE}
                weight={500}
                color_by=>{if is_sel() { lg::surface().ink } else { lg::surface().ink_secondary }}
                text={title}
              />
            })
          },
        )
      }
      choice("light", "Light")
      choice("dark", "Dark")
    })
  })
  sp_group(parent, "Sidebar", "A narrower sidebar leaves more of the window to the page.", fn() {
    sp_matches_filter(q(), sp_kw_sidebar)
  }, fn(g : view::View) -> Unit {
    sp_row(g, ICON_SIDEBAR, sp_purple, "Compact sidebar", fn(tr : view::View) -> Unit {
      let _ = lg::liquid_toggle_node(
        tr,
        fn() { (props.settings)().compact_sidebar },
        fn(next_v : Bool) -> Unit {
          sp_save(
            props,
            fn(cur) { proto::BrowserSettings::{ ..cur, compact_sidebar: next_v } },
            if next_v { "Compact sidebar on" } else { "Compact sidebar off" },
          )
        },
        fn() { "Compact Sidebar" },
      )
    })
  })
}

fn sp_build_tabs(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(
    parent,
    "Archive unpinned tabs",
    "Unpinned tabs you haven't opened in this time move to the archive. Pinned tabs stay.",
    fn() { sp_matches_filter(q(), sp_kw_archive) },
    fn(g : view::View) -> Unit {
      let opts : Array[(Int, String)] = [(12, "12 hours"), (24, "24 hours"), (168, "7 days"), (0, "Never")]
      let mut i = 0
      while i < opts.length() {
        let (hours, short) = opts[i]
        if i > 0 {
          sp_rule(g, inset_tile=false)
        }
        sp_choice_row(
          g,
          "Auto-Archive " + short,
          sp_archive_label(hours),
          fn(_b : view::View) -> Unit { () },
          fn() { proto::normalize_auto_archive_hours((props.settings)().auto_archive_hours) == hours },
          fn() {
            sp_save(
              props,
              fn(cur) { proto::BrowserSettings::{ ..cur, auto_archive_hours: hours } },
              "Archive tabs: " + sp_archive_label(hours),
            )
          },
        )
        i += 1
      }
    },
  )
}

fn sp_build_search(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(
    parent,
    "Search engine",
    "Used for searches from the address bar and the start page.",
    fn() { sp_matches_filter(q(), sp_kw_search) },
    fn(g : view::View) -> Unit {
      let engines = ["google", "duckduckgo", "kagi", "perplexity", "bing"]
      let mut i = 0
      while i < engines.length() {
        let id = engines[i]
        let label = proto::search_engine_label(id)
        let host = proto::search_engine_host(id)
        if i > 0 {
          sp_rule(g, inset_tile=false)
        }
        sp_choice_row(
          g,
          "Search Engine " + label,
          label,
          fn(_b : view::View) -> Unit { () },
          fn() { proto::normalize_search_engine((props.settings)().search_engine) == id },
          fn() {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, search_engine: id } }, "Search engine: " + label)
          },
          detail=host,
        )
        i += 1
      }
    },
  )
}

fn sp_build_privacy(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(
    parent,
    "Protections",
    "HTTPS-only upgrades http:// addresses, except localhost. Sites may ignore Do Not Track.",
    fn() { sp_matches_filter(q(), sp_kw_privacy) },
    fn(g : view::View) -> Unit {
      let toggle_row = fn(icon_name : String, color : Int64, label : String, a11y : String, on : () -> Bool, set : (Bool) -> Unit) -> Unit {
        sp_row(g, icon_name, color, label, fn(tr : view::View) -> Unit {
          let _ = lg::liquid_toggle_node(tr, on, set, fn() { a11y })
        })
      }
      toggle_row(ICON_LOCK, sp_green, "HTTPS-only mode", "HTTPS-Only Mode", fn() { (props.settings)().https_only }, fn(v : Bool) -> Unit {
        sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, https_only: v } }, if v { "HTTPS-only mode on" } else { "HTTPS-only mode off" })
      })
      sp_rule(g)
      toggle_row(ICON_SHIELD, sp_red, "Block third-party cookies", "Block Third-Party Cookies", fn() { (props.settings)().block_third_party_cookies }, fn(v : Bool) -> Unit {
        sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, block_third_party_cookies: v } }, "")
      })
      sp_rule(g)
      toggle_row("eye-off", sp_gray, "Ask sites not to track", "Send Do Not Track", fn() { (props.settings)().send_dnt }, fn(v : Bool) -> Unit {
        sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, send_dnt: v } }, "")
      })
    },
  )
  sp_group(
    parent,
    "Clear browsing data",
    "Only the kinds turned on above are removed. Everything else stays.",
    fn() { sp_matches_filter(q(), sp_kw_clear_data) },
    fn(g : view::View) -> Unit {
      let pick_row = fn(icon_name : String, color : Int64, label : String, a11y : String, sig : signals::Signal[Bool]) -> Unit {
        sp_row(g, icon_name, color, label, fn(tr : view::View) -> Unit {
          let _ = lg::liquid_toggle_node(tr, fn() { sig.get() }, fn(v : Bool) -> Unit { sig.set(v) }, fn() { a11y })
        })
      }
      pick_row(ICON_BOOKMARK, sp_orange, "Bookmarks", "Toggle Clear Bookmarks", props.clear_bookmarks)
      sp_rule(g)
      pick_row(ICON_CLOCK, sp_gray, "History", "Toggle Clear History", props.clear_history)
      sp_rule(g)
      pick_row(ICON_DOWNLOAD, sp_blue, "Download list", "Toggle Clear Downloads", props.clear_downloads)
      sp_rule(g)
      pick_row(ICON_SPARKLES, sp_purple, "Site boosts", "Toggle Clear Site Boosts", props.clear_boosts)
      sp_rule(g)
      let any_on = fn() -> Bool {
        props.clear_bookmarks.get() || props.clear_history.get() || props.clear_downloads.get() || props.clear_boosts.get()
      }
      sp_press_row(
        g,
        "Clear Selected Data",
        fn() {
          (props.on_clear_browsing_data)(ClearBrowsingDataSelection::{
            bookmarks: props.clear_bookmarks.untracked(),
            history: props.clear_history.untracked(),
            downloads: props.clear_downloads.untracked(),
            boosts: props.clear_boosts.untracked(),
          })
        },
        fn(b : view::View) -> Unit {
          let _ = shell_glyph_tile(b, "trash", fn() { if any_on() { sp_red } else { sp_gray } }, size=SP_24)
          sp_row_label(b, fn() { "Clear selected data" }, color_by=fn() {
            if any_on() { lg::surface().danger } else { lg::surface().ink_tertiary }
          })
        },
      )
    },
  )
}

fn sp_build_downloads(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  let dl_keys = fn() -> String {
    for g in default_macos_shortcut_groups() {
      for it in g.items {
        if it.action == "Downloads Manager" {
          return it.keys
        }
      }
    }
    ""
  }
  let keys = dl_keys()
  sp_group(
    parent,
    "Download list",
    "Removes finished downloads from the list. Files you saved stay on disk.",
    fn() { sp_matches_filter(q(), sp_kw_downloads) },
    fn(g : view::View) -> Unit {
      if keys != "" {
        sp_row(g, ICON_DOWNLOAD, sp_blue, "Show downloads", fn(tr : view::View) -> Unit { sp_keycaps(tr, keys) })
        sp_rule(g)
      }
      sp_press_row(
        g,
        "Clear Download List",
        fn() {
          (props.on_clear_browsing_data)(ClearBrowsingDataSelection::{
            bookmarks: false,
            history: false,
            downloads: true,
            boosts: false,
          })
        },
        fn(b : view::View) -> Unit {
          let _ = shell_glyph_tile(b, "trash", fn() { sp_red }, size=SP_24)
          sp_row_label(b, fn() { "Clear download list" }, color_by=fn() { lg::surface().danger })
        },
      )
    },
  )
}

fn sp_build_shortcuts(parent : view::View, q : () -> String) -> Unit {
  let groups = default_macos_shortcut_groups()
  let mut gi = 0
  while gi < groups.length() {
    let grp = groups[gi]
    let kw = sp_sentence_case(grp.title) + " shortcuts keyboard keys"
    let footnote = if gi == groups.length() - 1 { "Shortcuts can't be changed yet." } else { "" }
    sp_group(
      parent,
      sp_sentence_case(grp.title),
      footnote,
      fn() -> Bool {
        let qq = q()
        if sp_matches_filter(qq, kw) {
          return true
        }
        for it in grp.items {
          if sp_matches_filter(qq, it.action) {
            return true
          }
        }
        false
      },
      fn(g : view::View) -> Unit {
        let mut i = 0
        while i < grp.items.length() {
          let it = grp.items[i]
          if i > 0 {
            sp_rule(g, inset_tile=false)
          }
          let _ = g.box(fn(row : view::View) -> Unit {
            sp_row_layout(row)
            sp_row_label(row, fn() { it.action })
            sp_keycaps(row, it.keys)
          })
          i += 1
        }
      },
    )
    gi += 1
  }
}

fn sp_build_about(parent : view::View, q : () -> String) -> Unit {
  parent.show(fn() { sp_matches_filter(q(), sp_kw_about) }, at_once=true, fn(hero : view::View) -> Unit {
    let _ = hero
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((SP_0, SP_16, SP_0, SP_8)))
    .gap(view::Live::Is(SP_8))
    let _ = shell_glyph_tile(hero, ICON_GLOBE, fn() { sp_blue }, size=SP_64)
    let _ = hero.box(fn(spacer : view::View) -> Unit { let _ = spacer.height(view::Live::Is(Some(SP_4))) })
    <ui::Text in={hero} size={TX_TITLE3} weight={600} color_by=>{lg::surface().ink} text="Farview" />
    <ui::Text
      in={hero}
      size={TX_FOOTNOTE}
      wrap
      color_by=>{lg::surface().ink_secondary}
      text="A browser engine written in Pion."
    />
  })
  sp_group(parent, "", "", fn() { sp_matches_filter(q(), sp_kw_about) }, fn(g : view::View) -> Unit {
    sp_row(g, ICON_LAYERS, sp_gray, "Interface", fn(tr : view::View) -> Unit { sp_row_value(tr, fn() { "Invar" }) })
    sp_rule(g)
    sp_row(g, ICON_READER, sp_gray, "License", fn(tr : view::View) -> Unit { sp_row_value(tr, fn() { "MIT" }) })
    sp_rule(g)
    sp_row(g, "git-branch", sp_gray, "Source", fn(tr : view::View) -> Unit {
      sp_row_value(tr, fn() { "github.com/AFK-surf/farview" })
    })
  })
}

// ---------------------------------------------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------------------------------------------

///| Sidebar row: 20pt tile, name; the selection wash eases between rows (radius 12 = tile 6 + inset 6).
fn sp_nav_item(parent : view::View, cat : SpCategory, props : SettingsPanelProps, q : () -> String) -> Unit {
  let is_act = fn() -> Bool { props.active_tab.get() == cat.idx }
  let dimmed = fn() -> Bool {
    let qq = q()
    qq.trim() != "" && !sp_tab_has_match(cat.idx, qq)
  }
  let _ = headless::button(
    parent,
    fn() { cat.name },
    fn(_v : view::View) -> Unit { props.active_tab.set(cat.idx) },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let sel_t = motion::hover_fade(b, is_act)
      let hov_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .padding(view::Live::Is((SP_6, SP_0, SP_8, SP_0)))
      .gap(view::Live::Is(SP_8))
      .radius(view::Live::Is(SP_12))
      .ground(view::Live::By(fn() {
        let s = lg::surface()
        let t = sel_t()
        if t > 0.01 { lg::alpha(s.row_selected, t) } else { lg::alpha(s.row_hover, hov_t()) }
      }))
      .alpha(view::Live::By(fn() { if dimmed() { 0.45 } else { 1.0 } }))
      let _ = shell_glyph_tile(b, cat.icon, fn() { cat.color }, size=SP_20)
      let _ = b.box(fn(tw : view::View) -> Unit {
        let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
        <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text={cat.name} />
      })
    },
  )
}

///| Narrow strip item: the 32pt category tile alone in a 40pt square (radius 12 = tile 8 + inset 4).
fn sp_strip_item(parent : view::View, cat : SpCategory, props : SettingsPanelProps, q : () -> String) -> Unit {
  let is_act = fn() -> Bool { props.active_tab.get() == cat.idx }
  let dimmed = fn() -> Bool {
    let qq = q()
    qq.trim() != "" && !sp_tab_has_match(cat.idx, qq)
  }
  let _ = headless::button(
    parent,
    fn() { cat.name },
    fn(_v : view::View) -> Unit { props.active_tab.set(cat.idx) },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let sel_t = motion::hover_fade(b, is_act)
      let hov_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .width(view::Live::Is(Some(SP_40)))
      .height(view::Live::Is(Some(SP_40)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_12))
      .center()
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hov_t()) }))
      .edge(view::Live::By(fn() { (SP_2, lg::alpha(lg::surface().accent, sel_t())) }))
      .alpha(view::Live::By(fn() { if dimmed() { 0.45 } else { 1.0 } }))
      let _ = shell_glyph_tile(b, cat.icon, fn() { cat.color }, size=SP_32)
    },
  )
}

fn sp_filter_bar(parent : view::View, ff : ui::Field) -> Unit {
  let _ = parent.box(fn(host : view::View) -> Unit {
    // A solid field on the glass keeps the placeholder readable over any backdrop.
    let _ = host.height(view::Live::Is(Some(SP_32))).rigid().radius(view::Live::Is(SP_16)).ground(view::Live::By(fn() {
      let s = lg::surface()
      if lg::is_dark() { s.canvas } else { s.card }
    }))
    let _ = lg::liquid_search_bar_node(
      host,
      ff,
      placeholder="Find a setting",
      height_by=fn() { SP_32 },
      flat=true,
      label=fn() { "Filter Settings" },
      leading=fn(lead : view::View, ink : () -> Int64) -> Unit {
        let _ = shell_icon(lead, ICON_SEARCH, size=IC_SM, color_by=ink)
      },
    )
  })
}

///| Builds the Settings dialog.
pub fn build_settings_panel(root : view::View, props : SettingsPanelProps) -> Unit {
  let live_win_w = fn() -> Double {
    let _ = root.laid_size_told()
    let ww = root.window_w()
    if ww > SP_96 {
      ww
    } else {
      let (_, _, rw, _) = root.placed_now()
      if rw > SP_96 { rw } else { 1280.0 }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = root.laid_size_told()
    let wh = root.window_h()
    if wh > SP_96 {
      wh
    } else {
      let (_, _, _, rh) = root.placed_now()
      if rh > SP_96 { rh } else { 800.0 }
    }
  }
  let is_narrow = fn() -> Bool { live_win_w() < sp_narrow_breakpoint }
  let filter_query = fn() -> String {
    match props.filter_field {
      Some(f) => f.text()
      None => ""
    }
  }
  // Dialog size: 736 x 560 (SP_160 * 4 + SP_96, SP_160 * 3 + SP_80), shrinking with the window.
  let dlg_w = fn() -> Double {
    let full = SP_160 * 4.0 + SP_96
    let room = live_win_w() - SP_32
    if room < full { if room > SP_160 * 2.0 { room } else { SP_160 * 2.0 } } else { full }
  }
  let dlg_h = fn() -> Double {
    let full = SP_160 * 3.0 + SP_80
    let room = live_win_h() - SP_48
    if room < full { if room > SP_160 * 2.0 { room } else { SP_160 * 2.0 } } else { full }
  }
  let shell_r = SP_24
  let pane_r = lg::concentric(shell_r, SP_8)
  // Opened by the person: fade and lift in. Already open when the panel is built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)

  root.show(props.open, leave=140.0, fn(dlg_wrap : view::View) -> Unit {
    let reveal = motion::NodeWay::new(if built.v { 0.0 } else { 1.0 })
    if built.v {
      reveal.go(dlg_wrap, 1.0, motion::move_damped)
    }
    dlg_wrap.reacts(props.open, fn(on : Bool) -> Unit {
      if !on {
        reveal.go(dlg_wrap, 0.0, motion::move_damped)
      }
    }, at_start=false)
    let _ = dlg_wrap.over(view::Live::Is(true)).center().points(view::Live::By(props.open))
    // Dimmed backdrop (outside `headless::dialog` so `close_on_outside` sees backdrop clicks).
    let _ = dlg_wrap.box(fn(scrim : view::View) -> Unit {
      let _ = scrim
      .over(view::Live::Is(true))
      .ground(view::Live::By(fn() {
        let base = if (props.dark)() { 0x00000066L } else { 0x0000002EL }
        lg::alpha(base, reveal.shown(scrim))
      }))
    })
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Settings" },
      props.open,
      props.on_close,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box
        .margin(view::Live::By(fn() { (SP_0, SP_8 * (1.0 - reveal.shown(dlg_box)), SP_0, SP_0) }))
        .alpha(view::Live::By(fn() { reveal.shown(dlg_box) }))
        let _ = lg::liquid_dialog_shell_node(
          dlg_box,
          fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() { Some(dlg_w()) }))
            .height(view::Live::By(fn() { Some(dlg_h()) }))
            .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
            .gap(view::Live::Is(SP_8))
            .row(view::Live::By(fn() { !is_narrow() }))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // 1a. Wide: sidebar of categories straight on the glass.
            shell.show(fn() { !is_narrow() }, at_once=true, fn(side : view::View) -> Unit {
              let _ = side
              .width(view::Live::Is(Some(SP_160 + SP_32)))
              .shrink(view::Live::Is(0.0))
              // SP_16 on top puts the filter capsule 24 in, clear of the dialog's corner arc.
              .padding(view::Live::Is((SP_4, SP_16, SP_4, SP_0)))
              .gap(view::Live::Is(SP_16))
              match props.filter_field {
                Some(ff) => sp_filter_bar(side, ff)
                None => ()
              }
              let cats = sp_categories()
              // Clusters: settings, data, reference.
              let clusters : Array[(Int, Int)] = [(0, 4), (4, 6), (6, 8)]
              for cl in clusters {
                let (from, to) = cl
                let _ = side.box(fn(grp : view::View) -> Unit {
                  let _ = grp.gap(view::Live::Is(SP_2))
                  let mut i = from
                  while i < to {
                    sp_nav_item(grp, cats[i], props, filter_query)
                    i += 1
                  }
                })
              }
            })

            // 1b. Narrow: filter and a strip of category tiles above the pane.
            shell.show(is_narrow, at_once=true, fn(top : view::View) -> Unit {
              let _ = top.rigid().gap(view::Live::Is(SP_12)).padding(view::Live::Is((SP_4, SP_16, SP_4, SP_0)))
              match props.filter_field {
                Some(ff) => sp_filter_bar(top, ff)
                None => ()
              }
              let _ = top.box(fn(strip : view::View) -> Unit {
                let _ = strip
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Between))
                for c in sp_categories() {
                  sp_strip_item(strip, c, props, filter_query)
                }
              })
            })

            // 2. Solid content pane: breadcrumb header, then the grouped lists of the active category.
            let _ = shell.box(fn(pane : view::View) -> Unit {
              let _ = pane
              .fill()
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(pane_r))
              .ground(view::Live::By(fn() {
                let _ = (props.dark)()
                sp_pane_ground()
              }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

              let _ = pane.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(SP_48)))
                .rigid()
                .margin(view::Live::Is((SP_0, SP_8, SP_0, SP_0)))
                .padding(view::Live::Is((SP_20, SP_0, SP_8, SP_0)))
                .gap(view::Live::Is(SP_10))
                for c in sp_categories() {
                  hdr.show(fn() { props.active_tab.get() == c.idx }, along_row=true, fn(tile_host : view::View) -> Unit {
                    let _ = tile_host.shrink(view::Live::Is(0.0))
                    let _ = shell_glyph_tile(tile_host, c.icon, fn() { c.color }, size=SP_24)
                  })
                }
                let _ = hdr.box(fn(tw : view::View) -> Unit {
                  let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
                  <ui::Text
                    in={tw}
                    size={TX_HEADLINE}
                    weight={600}
                    lines={1}
                    color_by=>{lg::surface().ink}
                    text_by=>{sp_category(props.active_tab.get()).name}
                  />
                })
                sp_icon_btn(hdr, "Close Settings", ICON_CLOSE, props.on_close)
              })

              let _ = ui::scroll_box(pane, fn(sc : view::View) -> Unit {
                let _ = sc.padding(view::Live::Is((SP_20, SP_4, SP_20, SP_24))).gap(view::Live::Is(SP_24))
                let tab_view = fn(idx : Int, build : (view::View) -> Unit) -> Unit {
                  sc.show(fn() { props.active_tab.get() == idx }, at_once=true, fn(v : view::View) -> Unit {
                    let _ = v.gap(view::Live::Is(SP_24))
                    build(v)
                  })
                }
                tab_view(SETTINGS_TAB_GENERAL, fn(v) { sp_build_general(v, props, filter_query) })
                tab_view(SETTINGS_TAB_APPEARANCE, fn(v) { sp_build_appearance(v, props, filter_query) })
                tab_view(SETTINGS_TAB_TABS, fn(v) { sp_build_tabs(v, props, filter_query) })
                tab_view(SETTINGS_TAB_SEARCH, fn(v) { sp_build_search(v, props, filter_query) })
                tab_view(SETTINGS_TAB_PRIVACY, fn(v) { sp_build_privacy(v, props, filter_query) })
                tab_view(SETTINGS_TAB_DOWNLOADS, fn(v) { sp_build_downloads(v, props, filter_query) })
                tab_view(SETTINGS_TAB_SHORTCUTS, fn(v) { sp_build_shortcuts(v, filter_query) })
                tab_view(SETTINGS_TAB_ABOUT, fn(v) { sp_build_about(v, filter_query) })

                // Nothing in this category matches the filter: say so, and where matches are.
                sc.show(
                  fn() -> Bool {
                    let qq = filter_query().trim()
                    qq != "" && !sp_tab_has_match(props.active_tab.get(), qq)
                  },
                  at_once=true,
                  fn(emp : view::View) -> Unit {
                    let _ = emp.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_0, SP_48, SP_0, SP_0)))
                    <ui::Text in={emp} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text="No matching settings in this section" />
                    <ui::Text
                      in={emp}
                      size={TX_FOOTNOTE}
                      wrap
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{
                        let qq = filter_query().trim()
                        let cur = props.active_tab.get()
                        let hints : Array[String] = []
                        for c in sp_categories() {
                          if c.idx != cur && sp_tab_has_match(c.idx, qq) {
                            hints.push(c.name)
                          }
                        }
                        if hints.length() > 0 {
                          "Found in " + hints.join(", ")
                        } else {
                          "Try another word, like zoom, theme or cookies."
                        }
                      }
                    />
                  },
                )
              })
            })
          },
          radius=shell_r,
        )
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          match props.filter_field {
            Some(ff) if ff.composing() => {
              ff.compose("")
              return true
            }
            _ => ()
          }
        }
        false
      },
    )
  })
  built.v = true
}
