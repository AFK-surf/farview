///| Farview Shell 3 Settings (`Cmd+,` / `Ctrl+,`).
///|
///| - One layer of `lg` glass (`lg::liquid_dialog_shell_node`) holds a sidebar of categories, each with its glyph
///|   tile, and a solid content pane of grouped inset lists (caption above, solid card, footnote below).
///| - Categories: General, Appearance, Tabs, Search, Privacy, Downloads, Shortcuts, About. Every `BrowserSettings`
///|   field has exactly one control; on/off settings are toggles, single choices are checkmarked rows.
///| - Clear browsing data keeps its per-category selection (`clear_*` signals) and `on_clear_browsing_data` path;
///|   the Downloads category clears just the download list through the same callback.
///| - The filter field hides groups that don't match, dims other categories with no match, and moves to the first
///|   category that has one when the open one has none.
///| - Below 640pt the sidebar becomes a strip of category tiles above the pane.
///| - `headless::dialog` keeps the focus trap, Escape (after an IME preedit is cancelled) and outside-click close.

import "headless"
import "icons"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

pub let SETTINGS_TAB_GENERAL : Int = 0
pub let SETTINGS_TAB_APPEARANCE : Int = 1
pub let SETTINGS_TAB_PRIVACY : Int = 2
pub let SETTINGS_TAB_TABS : Int = 3
pub let SETTINGS_TAB_SEARCH : Int = 4
pub let SETTINGS_TAB_DOWNLOADS : Int = 5
pub let SETTINGS_TAB_SHORTCUTS : Int = 6
pub let SETTINGS_TAB_ABOUT : Int = 7

///| Per-category Clear Browsing Data selection (unchecked categories are preserved).
#derive(Eq)
pub struct ClearBrowsingDataSelection {
  pub bookmarks : Bool
  pub history : Bool
  pub downloads : Bool
  pub boosts : Bool
}

pub fn ClearBrowsingDataSelection::default() -> ClearBrowsingDataSelection {
  ClearBrowsingDataSelection::{
    bookmarks: false,
    history: true,
    downloads: true,
    boosts: false,
  }
}

pub fn ClearBrowsingDataSelection::any_selected(self : ClearBrowsingDataSelection) -> Bool {
  self.bookmarks || self.history || self.downloads || self.boosts
}

///| Cross-browser migration props for the Settings -> General "Import from another browser" section.
pub struct SettingsMigrateProps {
  pub sources : () -> Array[proto::MigrateSourceInfo]
  pub selected_id : signals::Signal[String]
  pub import_bookmarks : signals::Signal[Bool]
  pub import_history : signals::Signal[Bool]
  pub import_extensions : signals::Signal[Bool]
  pub busy : () -> Bool
  pub status_text : () -> String
  pub on_refresh : () -> Unit
  pub on_import : (proto::MigrateRequest) -> Unit
}

///| Strongly typed props for `build_settings_panel`.
pub struct SettingsPanelProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub active_tab : signals::Signal[Int]
  pub settings : () -> proto::BrowserSettings
  pub clear_bookmarks : signals::Signal[Bool]
  pub clear_history : signals::Signal[Bool]
  pub clear_downloads : signals::Signal[Bool]
  pub clear_boosts : signals::Signal[Bool]
  pub filter_field : Option[ui::Field]
  pub on_save_settings : (proto::BrowserSettings, String) -> Unit
  pub on_step_zoom : (Int) -> Unit
  pub on_clear_browsing_data : (ClearBrowsingDataSelection) -> Unit
  pub on_close : () -> Unit
  pub migrate : Option[SettingsMigrateProps]
  ///| Air Traffic Control's rules (Settings > Tabs); `None` hides the editor.
  pub atc : Option[AtcEditorProps]
  ///| Settings -> Privacy -> Passwords (`passwords_panel.pion`); `None` leaves the group out
  pub passwords : Option[SettingsPasswordsProps]
}

// Semantic category tile colors (grouped by function: System gray, Browsing blue, Privacy/Controls obsidian).
let sp_gray : Int64 = 0x8E8E93FFL
let sp_blue : Int64 = 0x007AFFFFL
let sp_red : Int64 = 0xFF3B30FFL

fn sp_tile_gray() -> Int64 {
  if lg::is_dark() { 0x636366FFL } else { 0xA1A1A6FFL }
}

fn sp_tile_blue() -> Int64 {
  if lg::is_dark() { 0x0A84FFFFL } else { 0x0088FFFFL }
}

fn sp_tile_obsidian() -> Int64 {
  if lg::is_dark() { 0x2C2C2EFFL } else { 0x1C1C1EFFL }
}

fn sp_group_color(group : Int) -> Int64 {
  if group == 1 {
    sp_tile_blue()
  } else if group == 2 {
    sp_tile_obsidian()
  } else {
    sp_tile_gray()
  }
}

///| Solid-filled category squircle tile: white filled glyph inside a semantic color-coded rounded square.
fn sp_filled_tile(
  parent : view::View,
  icon_name : String,
  group : Int,
  size~ : Double = SP_24,
) -> view::View {
  parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(fn() { sp_group_color(group) }))
    .edge(view::Live::By(fn() {
      if group == 2 && lg::is_dark() {
        (lg::hairline_w, 0xFFFFFF22L)
      } else {
        (0.0, 0x00000000L)
      }
    }))
    .points(view::Live::Is(false))
    .center()
    let glyph_sz = if size <= SP_20 { IC_SM } else { SP_12 + SP_2 }
    let _ = shell_icon(tile, icon_name, size=glyph_sz, color_by=fn() { 0xFFFFFFFFL })
  })
}

///| Below this window width the sidebar turns into a strip of category tiles.
let sp_narrow_breakpoint : Double = 640.0 // SP_160 * 4

///| One settings category: its tab index, semantic color group (0=system gray, 1=browsing blue, 2=controls obsidian),
///| solid-filled glyph name, and label.
struct SpCategory {
  idx : Int
  group : Int
  icon : String
  name : String
}

fn sp_categories() -> Array[SpCategory] {
  [
    SpCategory::{ idx: SETTINGS_TAB_GENERAL, group: 0, icon: "settings-filled", name: "General" },
    SpCategory::{ idx: SETTINGS_TAB_APPEARANCE, group: 0, icon: "appearance-filled", name: "Appearance" },
    SpCategory::{ idx: SETTINGS_TAB_TABS, group: 1, icon: "layers-filled", name: "Tabs" },
    SpCategory::{ idx: SETTINGS_TAB_SEARCH, group: 1, icon: "search-filled", name: "Search" },
    SpCategory::{ idx: SETTINGS_TAB_DOWNLOADS, group: 1, icon: "inbox-filled", name: "Downloads" },
    SpCategory::{ idx: SETTINGS_TAB_PRIVACY, group: 2, icon: "shield-filled", name: "Privacy" },
    SpCategory::{ idx: SETTINGS_TAB_SHORTCUTS, group: 2, icon: "keyboard-filled", name: "Shortcuts" },
    SpCategory::{ idx: SETTINGS_TAB_ABOUT, group: 0, icon: "info-filled", name: "About" },
  ]
}

fn sp_category(idx : Int) -> SpCategory {
  let cats = sp_categories()
  for c in cats {
    if c.idx == idx {
      return c
    }
  }
  cats[0]
}

fn sp_ascii_lower(s : String) -> String {
  let lower_az = "abcdefghijklmnopqrstuvwxyz"
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 65 && c <= 90 {
      sb.write_string(lower_az.slice(c - 65, c - 64))
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i += 1
  }
  sb.to_string()
}

// Filter keywords, one string per group.
let sp_kw_zoom : String = "general default page zoom scale percent 75 150"
let sp_kw_overview : String = "general search engine theme appearance archive tabs"
let sp_kw_import : String = "general import migrate browser chrome arc safari firefox brave edge vivaldi chromium bookmarks spaces history extensions crx"
let sp_kw_appearance : String = "appearance browser theme light dark auto system mode chrome"
let sp_kw_sidebar : String = "appearance compact sidebar narrow width layout"
let sp_kw_panels : String = "appearance panels glass translucent transparency liquid"
let sp_kw_archive : String = "tabs auto-archive auto archive today unpinned inactivity 12 24 hours 7 days never little arc peek shift"
let sp_kw_atc : String = "tabs air traffic control atc routing rules links route space quick window external apps"
let sp_kw_search : String = "search default search engine google duckduckgo kagi perplexity bing"
let sp_kw_suggest : String = "search suggestions autocomplete address bar typing engine privacy"
let sp_kw_privacy : String = "privacy https-only https only mode block third-party third party cookies send do not track dnt tracking"
let sp_kw_clear_data : String = "privacy clear browsing data bookmarks history downloads site boosts delete"
let sp_kw_downloads : String = "downloads download list clear files"
let sp_kw_about : String = "about farview version license mit source pion invar"

fn sp_kw_shortcuts() -> String {
  let sb = StringBuilder::new()
  sb.write_string("shortcuts keyboard keys")
  for g in default_macos_shortcut_groups() {
    for it in g.items {
      sb.write_string(" ")
      sb.write_string(it.action)
    }
  }
  sb.to_string()
}

fn sp_matches_filter(query : String, haystack : String) -> Bool {
  let q = sp_ascii_lower(query.trim())
  if q == "" {
    return true
  }
  sp_ascii_lower(haystack).contains(q)
}

fn sp_tab_keywords(tab : Int) -> Array[String] {
  if tab == SETTINGS_TAB_GENERAL {
    [sp_kw_zoom, sp_kw_overview, sp_kw_import]
  } else if tab == SETTINGS_TAB_APPEARANCE {
    [sp_kw_appearance, sp_kw_panels, sp_kw_sidebar]
  } else if tab == SETTINGS_TAB_TABS {
    [sp_kw_archive, sp_kw_atc]
  } else if tab == SETTINGS_TAB_SEARCH {
    [sp_kw_search]
  } else if tab == SETTINGS_TAB_PRIVACY {
    [sp_kw_privacy, sp_kw_clear_data, sp_kw_passwords()]
  } else if tab == SETTINGS_TAB_DOWNLOADS {
    [sp_kw_downloads]
  } else if tab == SETTINGS_TAB_SHORTCUTS {
    [sp_kw_shortcuts()]
  } else {
    [sp_kw_about]
  }
}

fn sp_tab_has_match(tab : Int, q : String) -> Bool {
  for kw in sp_tab_keywords(tab) {
    if sp_matches_filter(q, kw) {
      return true
    }
  }
  false
}

///| Pane ground: grouped background in light, near-black canvas in dark (cards sit one step above it).
fn sp_pane_ground() -> Int64 {
  let s = lg::surface()
  if lg::is_dark() { s.canvas } else { s.grouped_bg }
}

///| Lays out a grouped-list row: macOS Sequoia 44pt min height, SP_16 horizontal & SP_8 vertical breathing room.
fn sp_row_layout(row : view::View) -> Unit {
  let _ = row
  .row(view::Live::Is(true))
  .lines_up(view::Live::Is(Some(view::Along::Middle)))
  .min_height(view::Live::Is(Some(SP_40 + SP_4)))
  .padding(view::Live::Is((SP_16, SP_8, SP_16, SP_8)))
  .gap(view::Live::Is(SP_12))
}

///| macOS desktop-proportioned switch (38x22pt visual capsule, 38x36pt hit target >= 32pt).
fn sp_toggle(
  parent : view::View,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  label : () -> String,
) -> view::View {
  shell_desktop_toggle(parent, on, turn, label)
}

///| The label column of a row: takes the free width, one line, ellipsis.
fn sp_row_label(row : view::View, text_by : () -> String, color_by~ : () -> Int64 = fn() { lg::surface().ink }) -> Unit {
  let _ = row.box(fn(tw : view::View) -> Unit {
    let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
    <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{color_by()} text_by=>{text_by()} />
  })
}

///| A trailing value in secondary ink (`Light`, `After 24 hours`).
fn sp_row_value(row : view::View, text_by : () -> String) -> Unit {
  let _ = row.box(fn(vw : view::View) -> Unit {
    let _ = vw.shrink(view::Live::Is(0.0))
    <ui::Text in={vw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{text_by()} />
  })
}

///| The zoom tile: a 24pt System-gray squircle with a crisp solid-filled zoom-in magnifier.
fn sp_zoom_tile(parent : view::View) -> Unit {
  let _ = sp_filled_tile(parent, "zoom-in-filled", 0, size=SP_24)
}

///| A static row: color-grouped filled glyph tile (or none), label, trailing control.
fn sp_row(
  parent : view::View,
  icon_name : String,
  label : String,
  trailing : (view::View) -> Unit,
  lead? : (view::View) -> Unit,
  group~ : Int = 0,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    sp_row_layout(row)
    match lead {
      Some(f) => f(row)
      None =>
      if icon_name != "" {
        let _ = sp_filled_tile(row, icon_name, group, size=SP_24)
      }
    }
    sp_row_label(row, fn() { label })
    trailing(row)
  })
}

///| A pressable row (choice, navigation or action): the wash eases in on hover and press.
fn sp_press_row(
  parent : view::View,
  a11y : String,
  on_press : () -> Unit,
  body : (view::View) -> Unit,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { a11y },
    fn(_v : view::View) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let wash_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      sp_row_layout(b)
      let _ = b.ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
      body(b)
    },
  )
}

///| A choice row: leading tile, label, accent checkmark on the chosen one.
fn sp_choice_row(
  parent : view::View,
  a11y : String,
  label : String,
  lead : (view::View) -> Unit,
  chosen : () -> Bool,
  on_pick : () -> Unit,
  detail~ : String = "",
) -> Unit {
  sp_press_row(parent, a11y, on_pick, fn(b : view::View) -> Unit {
    lead(b)
    sp_row_label(b, fn() { label })
    if detail != "" {
      sp_row_value(b, fn() { detail })
    }
    let _ = b.box(fn(ck : view::View) -> Unit {
      let _ = ck.width(view::Live::Is(Some(IC_MD))).height(view::Live::Is(Some(IC_MD))).shrink(view::Live::Is(0.0)).center()
      ck.show(chosen, at_once=true, fn(ic : view::View) -> Unit {
        let _ = shell_icon(ic, ICON_CHECK, size=IC_MD, color_by=fn() { lg::surface().accent })
      })
    })
  })
}

///| A navigation row: color-grouped filled tile, label, current value and a chevron.
fn sp_nav_row(
  parent : view::View,
  a11y : String,
  icon_name : String,
  label : String,
  value : () -> String,
  on_press : () -> Unit,
  group~ : Int = 0,
) -> Unit {
  sp_press_row(parent, a11y, on_press, fn(b : view::View) -> Unit {
    let _ = sp_filled_tile(b, icon_name, group, size=SP_24)
    sp_row_label(b, fn() { label })
    sp_row_value(b, value)
    let _ = shell_icon(b, ICON_CHEVRON_RIGHT, size=IC_SM, color_by=fn() { lg::surface().ink_tertiary })
  })
}

///| Hairline between rows, starting where the labels start (`inset_tile=false` for rows without a tile).
fn sp_rule(parent : view::View, inset_tile~ : Bool = true) -> Unit {
  let _ = inset_tile
  shell_full_divider(parent)
}

///| A grouped list section with reactive footnote text.
fn sp_group_dyn(
  parent : view::View,
  caption : String,
  footnote_by : () -> String,
  shown : () -> Bool,
  rows : (view::View) -> Unit,
) -> Unit {
  parent.show(shown, at_once=true, fn(sec : view::View) -> Unit {
    let _ = sec.gap(view::Live::Is(SP_6))
    if caption != "" {
      let _ = sec.box(fn(cap : view::View) -> Unit {
        let _ = cap.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={caption} />
      })
    }
    let card = shell_card_rim(lg::surface_card_node(sec, rows, radius=SP_12, pad=SP_0, label=fn() { caption }))
    let _ = card.clips(view::Live::Is(true))
    sec.show(fn() { footnote_by() != "" }, at_once=true, fn(fn_box : view::View) -> Unit {
      let _ = fn_box.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
      <ui::Text in={fn_box} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text_by=>{footnote_by()} />
    })
  })
}

///| A grouped list section: quiet caption, one solid card, optional footnote. Hidden when `shown` is false.
fn sp_group(
  parent : view::View,
  caption : String,
  footnote : String,
  shown : () -> Bool,
  rows : (view::View) -> Unit,
) -> Unit {
  parent.show(shown, at_once=true, fn(sec : view::View) -> Unit {
    let _ = sec.gap(view::Live::Is(SP_6))
    if caption != "" {
      let _ = sec.box(fn(cap : view::View) -> Unit {
        let _ = cap.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={caption} />
      })
    }
    let card = shell_card_rim(lg::surface_card_node(sec, rows, radius=SP_12, pad=SP_0, label=fn() { caption }))
    let _ = card.clips(view::Live::Is(true))
    if footnote != "" {
      let _ = sec.box(fn(fn_box : view::View) -> Unit {
        let _ = fn_box.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={fn_box} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text={footnote} />
      })
    }
  })
}

///| Splits a shortcut (`⇧⌘T`, `Ctrl+Shift+T`, `⌘[  ⌘]`) into combos of keycaps.
fn sp_shortcut_combos(keys : String) -> Array[Array[String]] {
  let out : Array[Array[String]] = []
  for combo in keys.split("  ") {
    let c = combo.trim()
    if c == "" {
      continue
    }
    let caps : Array[String] = []
    if c.contains("+") && c.length() > 1 {
      for part in c.split("+") {
        if part != "" {
          caps.push(part)
        }
      }
      if c.ends_with("+") {
        caps.push("+")
      }
    } else {
      // macOS: one cap per modifier glyph, the rest of the combo as the key.
      let mods = ["⌘", "⇧", "⌥", "⌃"]
      let mut rest = c
      let mut more = true
      while more && rest != "" {
        more = false
        for m in mods {
          if rest.starts_with(m) {
            caps.push(m)
            rest = rest.slice(m.length(), rest.length())
            more = true
            break
          }
        }
      }
      if rest != "" {
        caps.push(rest)
      }
    }
    out.push(caps)
  }
  out
}

///| Keycap pills for one shortcut.
fn sp_keycaps(parent : view::View, keys : String) -> Unit {
  let _ = parent.box(fn(kc_row : view::View) -> Unit {
    let _ = kc_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).shrink(view::Live::Is(0.0)).gap(view::Live::Is(SP_6))
    let combos = sp_shortcut_combos(keys)
    let mut ci = 0
    while ci < combos.length() {
      let combo = combos[ci]
      if ci > 0 {
        // Two shortcuts in one row (`⌘[ / ⌘]`): a quiet slash keeps them from reading as one chord.
        <ui::Text in={kc_row} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_tertiary} text="/" />
      }
      ci += 1
      let _ = kc_row.box(fn(cb : view::View) -> Unit {
        let _ = cb.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4))
        for cap in combo {
          let _ = cb.box(fn(k : view::View) -> Unit {
            let _ = k
            .height(view::Live::Is(Some(SP_24)))
            .min_width(view::Live::Is(Some(SP_24)))
            .shrink(view::Live::Is(0.0))
            .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
            .radius(view::Live::Is(SP_6))
            .center()
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
            <ui::Text in={k} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={cap} />
          })
        }
      })
    }
  })
}

///| Sentence-case caption for a shortcut group title (`NAVIGATION & TABS` -> `Navigation and tabs`).
fn sp_sentence_case(title : String) -> String {
  let low = sp_ascii_lower(title)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < low.length() {
    let ch = low.slice(i, i + 1)
    sb.write_string(if ch == "&" { "and" } else { ch })
    i += 1
  }
  let lower = sb.to_string()
  if lower.length() == 0 {
    return lower
  }
  let c = lower.code_unit_at(0).to_int()
  if c >= 0x61 && c <= 0x7A {
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    upper.slice(c - 0x61, c - 0x60) + lower.slice(1, lower.length())
  } else {
    lower
  }
}

///| Sentence case for a catalog action (`Focus Address Bar` -> `Focus address bar`, `Site Info & Cookies` ->
///| `Site info and cookies`). Words after the first are lowercased only when they are plain capitalized words, so
///| `PDF`, `URL` and `DevTools` keep their spelling; `Arc` is a name and stays.
fn sp_action_label(action : String) -> String {
  let words = action.split(" ")
  let out : Array[String] = []
  let mut wi = 0
  for w in words {
    if w == "&" {
      out.push("and")
    } else if wi == 0 || w == "Arc" || w.length() < 2 {
      out.push(w)
    } else {
      let c0 = w.code_unit_at(0).to_int()
      let mut plain = c0 >= 65 && c0 <= 90
      let mut i = 1
      while plain && i < w.length() {
        let c = w.code_unit_at(i).to_int()
        if c >= 65 && c <= 90 {
          plain = false
        }
        i += 1
      }
      out.push(if plain { sp_ascii_lower(w) } else { w })
    }
    wi += 1
  }
  out.join(" ")
}

fn sp_archive_label(hours : Int) -> String {
  let h = proto::normalize_auto_archive_hours(hours)
  if h == 12 {
    "After 12 hours"
  } else if h == 168 {
    "After 7 days"
  } else if h == 720 {
    "After 30 days"
  } else if h == 0 {
    "Never"
  } else {
    "After 24 hours"
  }
}

fn sp_save(props : SettingsPanelProps, next : (proto::BrowserSettings) -> proto::BrowserSettings, msg : String) -> Unit {
  let cur = signals::untracked(props.settings)
  (props.on_save_settings)(next(cur), msg)
}

// ---------------------------------------------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------------------------------------------

fn sp_build_general(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(parent, "Pages", "New pages open at this zoom. Change it for one site with the zoom shortcuts.", fn() {
    sp_matches_filter(q(), sp_kw_zoom)
  }, fn(g : view::View) -> Unit {
    sp_row(
      g,
      "",
      "Default page zoom",
      fn(tr : view::View) -> Unit {
        let _ = tr.box(fn(st : view::View) -> Unit {
          let _ = st
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .shrink(view::Live::Is(0.0))
          .height(view::Live::Is(Some(SP_32)))
          .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
          .radius(view::Live::Is(SP_8))
          .ground(view::Live::By(fn() { lg::surface().card_secondary }))
          let step_btn = fn(icon_name : String, aria : String, delta : Int) -> Unit {
            let _ = headless::button(
              st,
              fn() { aria },
              fn(_v : view::View) -> Unit { (props.on_step_zoom)(delta) },
              fn(b : view::View, btn : headless::Button) -> Unit {
                let wash_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                let _ = b
                .width(view::Live::Is(Some(SP_32)))
                .height(view::Live::Is(Some(SP_32)))
                .shrink(view::Live::Is(0.0))
                .radius(view::Live::Is(SP_8))
                .center()
                .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
                let _ = shell_icon(b, icon_name, size=IC_SM, color_by=fn() { lg::surface().ink })
              },
            )
          }
          step_btn("minus", "Decrease Default Zoom", -1)
          let _ = st.box(fn(vb : view::View) -> Unit {
            let _ = vb.width(view::Live::Is(Some(SP_48))).shrink(view::Live::Is(0.0)).center()
            <ui::Text
              in={vb}
              size={TX_BODY}
              weight={500}
              color_by=>{lg::surface().ink}
              text_by=>{(props.settings)().default_zoom_pct.to_string() + "%"}
            />
          })
          step_btn(ICON_PLUS, "Increase Default Zoom", 1)
        })
      },
      lead=fn(row : view::View) -> Unit { sp_zoom_tile(row) },
    )
  })
  sp_group(parent, "Browser", "", fn() { sp_matches_filter(q(), sp_kw_overview) }, fn(g : view::View) -> Unit {
    sp_nav_row(
      g,
      "Show Search Settings",
      "search-filled",
      "Search engine",
      fn() { proto::search_engine_label((props.settings)().search_engine) },
      fn() { props.active_tab.set(SETTINGS_TAB_SEARCH) },
      group=1,
    )
    sp_rule(g)
    sp_nav_row(
      g,
      "Show Appearance Settings",
      "appearance-filled",
      "Theme",
      fn() { proto::chrome_theme_label((props.settings)().chrome_theme) },
      fn() { props.active_tab.set(SETTINGS_TAB_APPEARANCE) },
      group=0,
    )
    sp_rule(g)
    sp_nav_row(
      g,
      "Show Tabs Settings",
      "layers-filled",
      "Archive tabs",
      fn() { sp_archive_label((props.settings)().auto_archive_hours) },
      fn() { props.active_tab.set(SETTINGS_TAB_TABS) },
      group=1,
    )
  })
  match props.migrate {
    Some(mp) => sp_build_migrate_group(parent, mp, q)
    None => ()
  }
}

#derive(Eq)
struct SpMigSourceRow {
  idx : Int
  info : proto::MigrateSourceInfo
}

fn sp_build_migrate_group(parent : view::View, mp : SettingsMigrateProps, q : () -> String) -> Unit {
  let footnote = fn() -> String {
    let st = (mp.status_text)()
    if st != "" {
      st
    } else {
      "Read-only import from Chromium-based browsers, Arc, Safari and Firefox. Your other browser is never modified."
    }
  }
  let keyed_rows = fn() -> Array[SpMigSourceRow] {
    let srcs = (mp.sources)()
    let out : Array[SpMigSourceRow] = []
    let mut i = 0
    while i < srcs.length() && i < 6 {
      out.push(SpMigSourceRow::{ idx: i, info: srcs[i] })
      i += 1
    }
    out
  }
  let active_src = fn() -> Option[proto::MigrateSourceInfo] {
    let sel = mp.selected_id.get()
    let srcs = (mp.sources)()
    for s in srcs {
      if s.id == sel {
        return Some(s)
      }
    }
    if srcs.length() > 0 { Some(srcs[0]) } else { None }
  }
  let active_src_id = fn() -> String {
    match active_src() {
      Some(s) => s.id
      None => ""
    }
  }
  let active_browser_short = fn() -> String {
    match active_src() {
      Some(s) => shell_browser_short_name(s.browser)
      None => "browser"
    }
  }
  sp_group_dyn(
    parent,
    "Import from another browser",
    footnote,
    fn() { sp_matches_filter(q(), sp_kw_import) },
    fn(g : view::View) -> Unit {
      // 1. Empty state when no browsers detected yet
      g.show(fn() { (mp.sources)().length() == 0 }, at_once=true, fn(empty_box : view::View) -> Unit {
        sp_press_row(
          empty_box,
          "Scan for installed browsers",
          fn() { (mp.on_refresh)() },
          fn(b : view::View) -> Unit {
            let _ = shell_glyph_tile(b, ICON_RELOAD, size=SP_24)
            sp_row_label(b, fn() { "Scan for installed browsers" })
            sp_row_value(b, fn() { "Arc, Chrome, Safari, Firefox" })
          },
        )
      })
      g.show(fn() { (mp.sources)().length() > 0 }, at_once=true, fn(list_box : view::View) -> Unit {
        // Zone 1: Clean borderless Browser App Icon Shelf (real @2x product logos, zero box-soup)
        let _ = list_box.box(fn(pick : view::View) -> Unit {
          let _ = pick
          .row(view::Live::Is(true))
          .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
          .gap(view::Live::Is(SP_4))
          pick.each(
            keyed_rows,
            fn(r : SpMigSourceRow) -> String { r.info.id },
            fn(cell : view::View, rsig : signals::Signal[SpMigSourceRow]) -> Unit {
              let _ = cell.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
              let _ = headless::button(
                cell,
                fn() {
                  let s = rsig.get().info
                  "Import Source " + s.browser + " " + s.profile_name
                },
                fn(_v : view::View) -> Unit { mp.selected_id.set(rsig.untracked().info.id) },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let is_sel = fn() -> Bool { active_src_id() == rsig.get().info.id }
                  let sel_t = shell_fade(b, is_sel)
                  let hov_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                  let _ = b
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((SP_6, SP_8, SP_6, SP_6)))
                  .gap(view::Live::Is(SP_4))
                  .radius(view::Live::Is(SP_8))
                  .ground(view::Live::By(fn() {
                    let s = lg::surface()
                    let t = sel_t()
                    lg::over(
                      lg::alpha(s.row_hover, hov_t() * (1.0 - t)),
                      lg::alpha(s.card_secondary, t),
                    )
                  }))
                  .edge(view::Live::By(fn() {
                    let s = lg::surface()
                    let t = sel_t()
                    (SP_2, lg::alpha(s.accent, t))
                  }))
                  shell_press(b, fn() { btn.pressed() })
                  shell_focus_ring(b, fn() { btn.focus_shown() }, SP_8)
                  // Genuine @2x browser product logo
                  shell_browser_logo(b, fn() { rsig.get().info.browser }, size=SP_32)
                  let _ = b.box(fn(meta : view::View) -> Unit {
                    let _ = meta.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2))
                    let _ = <ui::Text
                      in={meta}
                      size={TX_BODY}
                      weight={500}
                      lines={1}
                      color_by=>{if is_sel() { lg::surface().ink } else { lg::surface().ink_secondary }}
                      text_by=>{shell_browser_short_name(rsig.get().info.browser)}
                    />.allow_ellipsis(view::Live::Is(true))
                    let _ = <ui::Text
                      in={meta}
                      size={TX_CAPTION}
                      lines={1}
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{rsig.get().info.profile_name}
                    />.allow_ellipsis(view::Live::Is(true))
                  })
                },
              )
            },
          )
        })
        sp_rule(list_box, inset_tile=false)
        // Zone 2: Clean native borderless macOS checkboxes (zero blue-box borders)
        let _ = list_box.box(fn(checks : view::View) -> Unit {
          let _ = checks
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .padding(view::Live::Is((SP_8, SP_6, SP_8, SP_6)))
          .gap(view::Live::Is(SP_4))
          let check_item = fn(a11y : String, label : String, sig : signals::Signal[Bool]) -> Unit {
            let _ = checks.box(fn(wrap : view::View) -> Unit {
              let _ = wrap.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
              let _ = headless::button(
                wrap,
                fn() { a11y },
                fn(_v : view::View) -> Unit { sig.set(!sig.untracked()) },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let on_t = shell_fade(b, fn() { sig.get() })
                  let hov_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                  let _ = b
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .center()
                  .height(view::Live::Is(Some(SP_32)))
                  .padding(view::Live::Is((SP_6, SP_0, SP_8, SP_0)))
                  .gap(view::Live::Is(SP_8))
                  .radius(view::Live::Is(SP_8))
                  .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hov_t()) }))
                  shell_press(b, fn() { btn.pressed() })
                  shell_focus_ring(b, fn() { btn.focus_shown() }, SP_8)
                  // Crisp 16x16 macOS native rounded checkbox
                  let _ = b.box(fn(cb : view::View) -> Unit {
                    let _ = cb
                    .width(view::Live::Is(Some(SP_16)))
                    .height(view::Live::Is(Some(SP_16)))
                    .shrink(view::Live::Is(0.0))
                    .radius(view::Live::Is(SP_4))
                    .center()
                    .points(view::Live::Is(false))
                    .ground(view::Live::By(fn() { lg::alpha(lg::surface().accent, on_t()) }))
                    .edge(view::Live::By(fn() {
                      let s = lg::surface()
                      let t = on_t()
                      (1.5, lg::alpha(s.separator_strong, 1.0 - t))
                    }))
                    cb.show(fn() { sig.get() }, at_once=true, fn(ic : view::View) -> Unit {
                      let _ = shell_icon(ic, ICON_CHECK, size=IC_SM, color_by=fn() { 0xFFFFFFFFL })
                    })
                  })
                  let _ = <ui::Text
                    in={b}
                    size={TX_BODY}
                    lines={1}
                    color_by=>{if sig.get() { lg::surface().ink } else { lg::surface().ink_secondary }}
                    text={label}
                  />.allow_ellipsis(view::Live::Is(true))
                },
              )
            })
          }
          check_item("Import Bookmarks and Spaces", "Bookmarks", mp.import_bookmarks)
          check_item("Import History", "History", mp.import_history)
          check_item("Import Extensions", "Extensions", mp.import_extensions)
        })
        sp_rule(list_box, inset_tile=false)
        // Zone 3: Calm contextual summary + rescan + single prominent primary CTA button
        let can_run = fn() -> Bool {
          !(mp.busy)() &&
          active_src_id() != "" &&
          (mp.import_bookmarks.get() || mp.import_history.get() || mp.import_extensions.get())
        }
        let run_import = fn() -> Unit {
          let sid = active_src_id()
          if (mp.busy)() || sid == "" {
            return
          }
          let bm = mp.import_bookmarks.untracked()
          let hi = mp.import_history.untracked()
          let ex = mp.import_extensions.untracked()
          if !bm && !hi && !ex {
            return
          }
          (mp.on_import)(proto::MigrateRequest::{
            source_id: sid,
            import_bookmarks: bm,
            import_history: hi,
            import_spaces: bm,
            import_extensions: ex,
            custom_path: "",
          })
        }
        let summary_text = fn() -> String {
          let bm = mp.import_bookmarks.get()
          let hi = mp.import_history.get()
          let ex = mp.import_extensions.get()
          let n = (if bm { 1 } else { 0 }) + (if hi { 1 } else { 0 }) + (if ex { 1 } else { 0 })
          if n == 0 {
            "Select at least one category"
          } else if bm && shell_browser_logo_key(active_browser_short()) == "arc" {
            "Includes Arc Spaces & pinned"
          } else if n == 3 {
            "All selected categories"
          } else if n == 1 {
            "1 category selected"
          } else {
            "2 categories selected"
          }
        }
        let _ = list_box.box(fn(foot : view::View) -> Unit {
          let _ = foot
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
          .gap(view::Live::Is(SP_8))
          let _ = foot.box(fn(left : view::View) -> Unit {
            let _ = left.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
            let _ = <ui::Text
              in={left}
              size={TX_FOOTNOTE}
              lines={1}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{summary_text()}
            />.allow_ellipsis(view::Live::Is(true))
          })
          let _ = shell_panel_icon_btn(foot, fn() { "Rescan installed browsers" }, ICON_RELOAD, fn() { (mp.on_refresh)() })
          let _ = foot.box(fn(cta : view::View) -> Unit {
            let _ = cta.shrink(view::Live::Is(0.0))
            let _ = headless::button(
              cta,
              fn() { "Import from " + active_browser_short() },
              fn(_e) -> Unit {
                if can_run() {
                  run_import()
                }
              },
              disabled=fn() { !can_run() },
              fn(b : view::View, btn : headless::Button) -> Unit {
                let dis = fn() { !can_run() }
                let hov_t = shell_fade(b, fn() { btn.hovered() && !btn.pressed() && !dis() })
                let _ = b
                .height(view::Live::Is(Some(SP_32)))
                .padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
                .radius(view::Live::Is(SP_8))
                .center()
                .ground(view::Live::By(fn() {
                  let base = if lg::is_dark() { 0x0A6FE8FFL } else { 0x0062CCFFL }
                  if dis() {
                    lg::surface().card_secondary
                  } else {
                    lg::over(base, lg::alpha(0xFFFFFF18L, hov_t()))
                  }
                }))
                shell_press(b, fn() { btn.pressed() && !dis() })
                shell_focus_ring(b, fn() { btn.focus_shown() }, SP_8)
                <ui::Text
                  in={b}
                  size={TX_BODY}
                  weight={500}
                  lines={1}
                  color_by=>{if dis() { lg::surface().ink_secondary } else { 0xFFFFFFFFL }}
                  text_by=>{if (mp.busy)() { "Importing…" } else { "Import from " + active_browser_short() }}
                />
              },
            )
          })
        })
      })
    },
  )
}

///| A miniature of the window in one theme: tinted frame, sidebar lines, solid page card.
fn sp_theme_thumb(parent : view::View, dark : Bool, radius~ : Double = SP_8) -> Unit {
  let pal = if dark { lg::surface_dark } else { lg::surface_light }
  let frame = shell_frame_tint(sp_blue, dark)
  let _ = parent.box(fn(pv : view::View) -> Unit {
    let _ = pv
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(SP_64)))
    .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
    .gap(view::Live::Is(SP_4))
    .radius(view::Live::Is(radius))
    .clips(view::Live::Is(true))
    .ground(view::Live::Is(frame))
    .points(view::Live::Is(false))
    let _ = pv.box(fn(side : view::View) -> Unit {
      let _ = side.width(view::Live::Is(Some(SP_24))).shrink(view::Live::Is(0.0)).gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
      let _ = side.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_6))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(shell_wash_strong(dark)))
      })
      let _ = side.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
      let _ = side.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
    })
    let _ = pv.box(fn(page : view::View) -> Unit {
      let _ = page
      .grow(view::Live::Is(1.0))
      .padding(view::Live::Is((SP_6, SP_6, SP_6, SP_6)))
      .gap(view::Live::Is(SP_4))
      .radius(view::Live::Is(SP_4))
      .ground(view::Live::Is(pal.card))
      let _ = page.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).width(view::Live::Is(Some(SP_32))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.ink_tertiary))
      })
      let _ = page.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
      let _ = page.box(fn(r : view::View) -> Unit {
        let _ = r.height(view::Live::Is(Some(SP_4))).width(view::Live::Is(Some(SP_40))).radius(view::Live::Is(SP_2)).ground(view::Live::Is(pal.separator_strong))
      })
    })
  })
}

///| Auto's miniature: the light window's left half beside the dark one's right half, as the system switches them.
fn sp_theme_thumb_auto(parent : view::View) -> Unit {
  let _ = parent.box(fn(pv : view::View) -> Unit {
    let _ = pv.row(view::Live::Is(true)).height(view::Live::Is(Some(SP_64))).radius(view::Live::Is(SP_8)).clips(view::Live::Is(true)).points(view::Live::Is(false))
    let _ = pv.box(fn(l : view::View) -> Unit {
      let _ = l.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).clips(view::Live::Is(true))
      sp_theme_thumb(l, false, radius=SP_0)
    })
    let _ = pv.box(fn(r : view::View) -> Unit {
      let _ = r.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).clips(view::Live::Is(true))
      sp_theme_thumb(r, true, radius=SP_0)
    })
  })
}

fn sp_build_appearance(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(parent, "Theme", "", fn() { sp_matches_filter(q(), sp_kw_appearance) }, fn(g : view::View) -> Unit {
    let _ = g.box(fn(pick : view::View) -> Unit {
      let _ = pick.row(view::Live::Is(true)).padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12))).gap(view::Live::Is(SP_12))
      let choice = fn(id : String, title : String) -> Unit {
        let is_sel = fn() -> Bool { proto::normalize_chrome_theme((props.settings)().chrome_theme) == id }
        let _ = headless::button(
          pick,
          fn() { "Theme " + title },
          fn(_v : view::View) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, chrome_theme: id } }, title + " appearance")
          },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let sel_t = shell_fade(b, is_sel)
            let hov_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
            let _ = b
            .grow(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(SP_0)))
            .min_width(view::Live::Is(Some(SP_0)))
            .gap(view::Live::Is(SP_8))
            let _ = b.box(fn(ring : view::View) -> Unit {
              let _ = ring
              .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
              .radius(view::Live::Is(SP_10))
              .edge(view::Live::By(fn() {
                let s = lg::surface()
                let t = sel_t()
                (SP_2, lg::over(lg::alpha(s.separator_strong, hov_t() * (1.0 - t)), lg::alpha(s.accent, t)))
              }))
              .min_width(view::Live::Is(Some(SP_0)))
              if id == "system" {
                sp_theme_thumb_auto(ring)
              } else {
                sp_theme_thumb(ring, id == "dark")
              }
            })
            let _ = b.box(fn(cap : view::View) -> Unit {
              let _ = cap.lines_up(view::Live::Is(Some(view::Along::Middle)))
              <ui::Text
                in={cap}
                size={TX_FOOTNOTE}
                weight={500}
                color_by=>{if is_sel() { lg::surface().ink } else { lg::surface().ink_secondary }}
                text={title}
              />
            })
          },
        )
      }
      choice("light", "Light")
      choice("dark", "Dark")
      choice("system", "Auto")
    })
  })
  sp_group(parent, "Panels", "Menus, popovers and drawers let the page show through. Off draws them solid.", fn() {
    sp_matches_filter(q(), sp_kw_panels)
  }, fn(g : view::View) -> Unit {
    sp_row(g, "layers-filled", "Translucent panels", fn(tr : view::View) -> Unit {
      let _ = sp_toggle(
        tr,
        fn() { (props.settings)().glass },
        fn(next_v : Bool) -> Unit {
          sp_save(
            props,
            fn(cur) { proto::BrowserSettings::{ ..cur, glass: next_v } },
            if next_v { "Translucent panels on" } else { "Translucent panels off" },
          )
        },
        fn() { "Translucent panels" },
      )
    }, group=0)
  })
  sp_group(parent, "Sidebar", "A narrower sidebar leaves more of the window to the page.", fn() {
    sp_matches_filter(q(), sp_kw_sidebar)
  }, fn(g : view::View) -> Unit {
    sp_row(g, "sidebar-filled", "Compact sidebar", fn(tr : view::View) -> Unit {
      let _ = sp_toggle(
        tr,
        fn() { (props.settings)().compact_sidebar },
        fn(next_v : Bool) -> Unit {
          sp_save(
            props,
            fn(cur) { proto::BrowserSettings::{ ..cur, compact_sidebar: next_v } },
            if next_v { "Compact sidebar on" } else { "Compact sidebar off" },
          )
        },
        fn() { "Compact sidebar" },
      )
    }, group=0)
  })
}

fn sp_build_tabs(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(
    parent,
    "Archive unpinned tabs",
    "Unpinned tabs you haven't opened in this time move to the archive. Pinned tabs stay.",
    fn() { sp_matches_filter(q(), sp_kw_archive) },
    fn(g : view::View) -> Unit {
      let opts : Array[(Int, String)] = [(12, "12 hours"), (24, "24 hours"), (168, "7 days"), (720, "30 days"), (0, "Never")]
      let mut i = 0
      while i < opts.length() {
        let (hours, short) = opts[i]
        if i > 0 {
          sp_rule(g, inset_tile=false)
        }
        sp_choice_row(
          g,
          "Auto-Archive " + short,
          sp_archive_label(hours),
          fn(_b : view::View) -> Unit { () },
          fn() { proto::normalize_auto_archive_hours((props.settings)().auto_archive_hours) == hours },
          fn() {
            sp_save(
              props,
              fn(cur) { proto::BrowserSettings::{ ..cur, auto_archive_hours: hours } },
              "Archive tabs: " + sp_archive_label(hours),
            )
          },
        )
        i += 1
      }
    },
  )
  sp_group(
    parent,
    "Quick Window",
    "A compact, temporary window for quick lookups and links from other apps.",
    fn() { sp_matches_filter(q(), sp_kw_archive) },
    fn(g : view::View) -> Unit {
      let qw_key = if shell_keys_mac() { "⌥⌘N" } else { "Ctrl+Alt+N" }
      let qw_click = if shell_keys_mac() { "⌥⌘" } else { "Alt+Ctrl" }
      sp_row(g, "window-filled", "Open Quick Window with " + qw_key, fn(tr : view::View) -> Unit {
        let _ = sp_toggle(
          tr,
          fn() { (props.settings)().little_arc_shortcut },
          fn(v : Bool) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, little_arc_shortcut: v } }, "")
          },
          fn() { "Open Quick Window shortcut" },
        )
      }, group=1)
      sp_rule(g)
      sp_row(g, "zap-filled", "Open Quick Window on " + qw_click + " link click", fn(tr : view::View) -> Unit {
        let _ = sp_toggle(
          tr,
          fn() { (props.settings)().little_arc_opt_click },
          fn(v : Bool) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, little_arc_opt_click: v } }, "")
          },
          fn() { "Open Quick Window on link click" },
        )
      }, group=1)
      sp_rule(g)
      sp_row(g, "globe-filled", "Links from other apps open in Quick Window", fn(tr : view::View) -> Unit {
        let _ = sp_toggle(
          tr,
          fn() { (props.settings)().little_arc_external_links },
          fn(v : Bool) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, little_arc_external_links: v } }, "")
          },
          fn() { "Links from other apps open in Quick Window" },
        )
      }, group=1)
    },
  )
  sp_group(
    parent,
    "Peek",
    "Preview links without opening a new tab. External-site Peek applies to Favorites and Pinned tabs.",
    fn() { sp_matches_filter(q(), sp_kw_archive) },
    fn(g : view::View) -> Unit {
      sp_row(g, "layers-filled", "Open Peek when clicking links with Shift held", fn(tr : view::View) -> Unit {
        let _ = sp_toggle(
          tr,
          fn() { (props.settings)().peek_shift_click },
          fn(v : Bool) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, peek_shift_click: v } }, "")
          },
          fn() { "Open Peek on Shift click" },
        )
      }, group=1)
      sp_rule(g)
      sp_row(g, "star-filled", "Open Peek for links to other sites", fn(tr : view::View) -> Unit {
        let _ = sp_toggle(
          tr,
          fn() { (props.settings)().peek_external_sites },
          fn(v : Bool) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, peek_external_sites: v } }, "")
          },
          fn() { "Open Peek for links to other sites" },
        )
      }, group=1)
    },
  )
  match props.atc {
    Some(ap) => parent.show(fn() { sp_matches_filter(q(), sp_kw_atc) }, at_once=true, fn(sec : view::View) -> Unit { build_atc_editor(sec, ap) })
    None => ()
  }
}

fn sp_build_search(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(
    parent,
    "Search engine",
    "Used for searches from the address bar and the start page.",
    fn() { sp_matches_filter(q(), sp_kw_search) },
    fn(g : view::View) -> Unit {
      let engines = ["google", "duckduckgo", "kagi", "perplexity", "bing"]
      let mut i = 0
      while i < engines.length() {
        let id = engines[i]
        let label = proto::search_engine_label(id)
        let host = proto::search_engine_host(id)
        if i > 0 {
          sp_rule(g, inset_tile=false)
        }
        sp_choice_row(
          g,
          "Search Engine " + label,
          label,
          fn(_b : view::View) -> Unit { () },
          fn() { proto::normalize_search_engine((props.settings)().search_engine) == id },
          fn() {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, search_engine: id } }, "Search engine: " + label)
          },
          detail=host,
        )
        i += 1
      }
    },
  )
  sp_group(
    parent,
    "Suggestions",
    "What you type in the address bar is sent to your search engine for suggestions. Addresses and private windows never are.",
    fn() { sp_matches_filter(q(), sp_kw_suggest) },
    fn(g : view::View) -> Unit {
      sp_row(g, "sparkles-filled", "Show search suggestions", fn(tr : view::View) -> Unit {
        let _ = sp_toggle(
          tr,
          fn() { (props.settings)().search_suggest },
          fn(v : Bool) -> Unit {
            sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, search_suggest: v } }, if v { "Search suggestions on" } else { "Search suggestions off" })
          },
          fn() { "Show search suggestions" },
        )
      }, group=1)
    },
  )
}

fn sp_build_privacy(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  sp_group(
    parent,
    "Protections",
    "HTTPS-only upgrades http:// addresses, except localhost. Sites may ignore Do Not Track.",
    fn() { sp_matches_filter(q(), sp_kw_privacy) },
    fn(g : view::View) -> Unit {
      let toggle_row = fn(icon_name : String, label : String, a11y : String, on : () -> Bool, set : (Bool) -> Unit) -> Unit {
        sp_row(g, icon_name, label, fn(tr : view::View) -> Unit {
          let _ = sp_toggle(tr, on, set, fn() { a11y })
        }, group=2)
      }
      toggle_row("lock-filled", "HTTPS-only mode", "HTTPS-only mode", fn() { (props.settings)().https_only }, fn(v : Bool) -> Unit {
        sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, https_only: v } }, if v { "HTTPS-only mode on" } else { "HTTPS-only mode off" })
      })
      sp_rule(g)
      toggle_row("database-filled", "Block third-party cookies", "Block third-party cookies", fn() { (props.settings)().block_third_party_cookies }, fn(v : Bool) -> Unit {
        sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, block_third_party_cookies: v } }, "")
      })
      sp_rule(g)
      toggle_row("eye-off-filled", "Ask sites not to track", "Ask sites not to track", fn() { (props.settings)().send_dnt }, fn(v : Bool) -> Unit {
        sp_save(props, fn(cur) { proto::BrowserSettings::{ ..cur, send_dnt: v } }, "")
      })
    },
  )
  sp_group(
    parent,
    "Clear browsing data",
    "Only the kinds turned on above are removed. Everything else stays.",
    fn() { sp_matches_filter(q(), sp_kw_clear_data) },
    fn(g : view::View) -> Unit {
      let pick_row = fn(icon_name : String, label : String, a11y : String, sig : signals::Signal[Bool]) -> Unit {
        sp_row(g, icon_name, label, fn(tr : view::View) -> Unit {
          let _ = sp_toggle(tr, fn() { sig.get() }, fn(v : Bool) -> Unit { sig.set(v) }, fn() { a11y })
        }, group=2)
      }
      pick_row("bookmark-filled", "Bookmarks", "Bookmarks", props.clear_bookmarks)
      sp_rule(g)
      pick_row("clock-filled", "History", "History", props.clear_history)
      sp_rule(g)
      pick_row("inbox-filled", "Download list", "Download list", props.clear_downloads)
      sp_rule(g)
      pick_row("sparkles-filled", "Site Boosts", "Site Boosts", props.clear_boosts)
      sp_rule(g)
      let any_on = fn() -> Bool {
        props.clear_bookmarks.get() || props.clear_history.get() || props.clear_downloads.get() || props.clear_boosts.get()
      }
      sp_press_row(
        g,
        "Clear selected data",
        fn() {
          (props.on_clear_browsing_data)(ClearBrowsingDataSelection::{
            bookmarks: props.clear_bookmarks.untracked(),
            history: props.clear_history.untracked(),
            downloads: props.clear_downloads.untracked(),
            boosts: props.clear_boosts.untracked(),
          })
        },
        fn(b : view::View) -> Unit {
          let _ = shell_tint_tile(b, "trash-filled", fn() { if any_on() { sp_red } else { sp_tile_gray() } }, size=SP_24)
          sp_row_label(b, fn() { "Clear selected data" }, color_by=fn() {
            if any_on() { lg::surface().danger } else { lg::surface().ink_tertiary }
          })
        },
      )
    },
  )
  match props.passwords {
    Some(pp) => sp_build_passwords(parent, pp, q)
    None => ()
  }
}

fn sp_build_downloads(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  let dl_keys = fn() -> String {
    for g in default_macos_shortcut_groups() {
      for it in g.items {
        if it.action == "Downloads Manager" {
          return it.keys
        }
      }
    }
    ""
  }
  let keys = dl_keys()
  sp_group(
    parent,
    "Download list",
    "Removes finished downloads from the list. Files you saved stay on disk.",
    fn() { sp_matches_filter(q(), sp_kw_downloads) },
    fn(g : view::View) -> Unit {
      if keys != "" {
        sp_row(g, "keyboard-filled", "Keyboard shortcut", fn(tr : view::View) -> Unit { sp_keycaps(tr, keys) }, group=1)
        sp_rule(g)
      }
      sp_press_row(
        g,
        "Clear Download List",
        fn() {
          (props.on_clear_browsing_data)(ClearBrowsingDataSelection::{
            bookmarks: false,
            history: false,
            downloads: true,
            boosts: false,
          })
        },
        fn(b : view::View) -> Unit {
          let _ = shell_tint_tile(b, "trash-filled", fn() { sp_red }, size=SP_24)
          sp_row_label(b, fn() { "Clear download list" }, color_by=fn() { lg::surface().danger })
        },
      )
    },
  )
}

fn sp_build_shortcuts(parent : view::View, q : () -> String) -> Unit {
  let groups = default_macos_shortcut_groups()
  let mut gi = 0
  while gi < groups.length() {
    let grp = groups[gi]
    let kw = sp_sentence_case(grp.title) + " shortcuts keyboard keys"
    let footnote = if gi == groups.length() - 1 { "Shortcuts can't be changed yet." } else { "" }
    sp_group(
      parent,
      sp_sentence_case(grp.title),
      footnote,
      fn() -> Bool {
        let qq = q()
        if sp_matches_filter(qq, kw) {
          return true
        }
        for it in grp.items {
          if sp_matches_filter(qq, it.action) {
            return true
          }
        }
        false
      },
      fn(g : view::View) -> Unit {
        let mut i = 0
        while i < grp.items.length() {
          let it = grp.items[i]
          if i > 0 {
            sp_rule(g, inset_tile=false)
          }
          let _ = g.box(fn(row : view::View) -> Unit {
            sp_row_layout(row)
            sp_row_label(row, fn() { sp_action_label(it.action) })
            sp_keycaps(row, it.keys)
          })
          i += 1
        }
      },
    )
    gi += 1
  }
}

fn sp_build_about(parent : view::View, q : () -> String) -> Unit {
  parent.show(fn() { sp_matches_filter(q(), sp_kw_about) }, at_once=true, fn(hero : view::View) -> Unit {
    let _ = hero
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((SP_0, SP_16, SP_0, SP_8)))
    .gap(view::Live::Is(SP_4))
    // No stand-in mark: the name and one line say what this is. Weight 500, the pane header holds the title.
    <ui::Text in={hero} size={TX_TITLE3} weight={500} color_by=>{lg::surface().ink} text="Farview" />
    <ui::Text
      in={hero}
      size={TX_FOOTNOTE}
      wrap
      color_by=>{lg::surface().ink_secondary}
      text="A browser engine written in Pion."
    />
  })
  sp_group(parent, "", "", fn() { sp_matches_filter(q(), sp_kw_about) }, fn(g : view::View) -> Unit {
    sp_row(g, "layers-filled", "Interface", fn(tr : view::View) -> Unit { sp_row_value(tr, fn() { "Invar" }) }, group=0)
    sp_rule(g)
    sp_row(g, "file-filled", "License", fn(tr : view::View) -> Unit { sp_row_value(tr, fn() { "MIT" }) }, group=0)
    sp_rule(g)
    sp_row(g, "code-filled", "Source", fn(tr : view::View) -> Unit {
      sp_row_value(tr, fn() { "github.com/AFK-surf/farview" })
    }, group=0)
  })
}

// ---------------------------------------------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------------------------------------------

///| Sidebar row: 24pt semantic color-grouped filled tile, medium label (radius 12 = tile 6 + inset 6).
fn sp_nav_item(parent : view::View, cat : SpCategory, props : SettingsPanelProps, q : () -> String) -> Unit {
  let is_act = fn() -> Bool { props.active_tab.get() == cat.idx }
  let dimmed = fn() -> Bool {
    let qq = q()
    qq.trim() != "" && !sp_tab_has_match(cat.idx, qq) && !is_act()
  }
  let _ = headless::button(
    parent,
    fn() { cat.name },
    fn(_v : view::View) -> Unit { props.active_tab.set(cat.idx) },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let sel_t = shell_fade(b, is_act)
      let hov_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32 + SP_4)))
      .padding(view::Live::Is((SP_6, SP_0, SP_10, SP_0)))
      .gap(view::Live::Is(SP_10))
      .radius(view::Live::Is(SP_12))
      .ground(view::Live::By(fn() {
        let s = lg::surface()
        let t = sel_t()
        // (the hover wash gives way as the selection comes: layered, never switched, so nothing dips between them)
        lg::over(lg::alpha(s.row_hover, hov_t() * (1.0 - t)), lg::alpha(s.row_selected, t))
      }))
      .alpha(view::Live::By(fn() { if dimmed() { 0.45 } else { 1.0 } }))
      let _ = sp_filled_tile(b, cat.icon, cat.group, size=SP_24)
      let _ = b.box(fn(tw : view::View) -> Unit {
        let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
        <ui::Text in={tw} size={TX_BODY} weight={500} lines={1} color_by=>{lg::surface().ink} text={cat.name} />
      })
    },
  )
}

///| Narrow grid item: the category's name alone (a quarter of the strip has no room for a tile and "Appearance"),
///| centered on a 32pt row, `row_selected` ground on the open category as in the wide sidebar.
fn sp_strip_item(parent : view::View, cat : SpCategory, props : SettingsPanelProps, q : () -> String) -> Unit {
  let is_act = fn() -> Bool { props.active_tab.get() == cat.idx }
  let dimmed = fn() -> Bool {
    let qq = q()
    qq.trim() != "" && !sp_tab_has_match(cat.idx, qq) && !is_act()
  }
  let _ = parent.box(fn(cell : view::View) -> Unit {
    let _ = cell.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
    let _ = headless::button(
      cell,
      fn() { cat.name },
      fn(_v : view::View) -> Unit { props.active_tab.set(cat.idx) },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let sel_t = shell_fade(b, is_act)
        let hov_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
        let _ = b
        .height(view::Live::Is(Some(SP_32)))
        .padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
        .radius(view::Live::Is(SP_12))
        .center()
        .cut()
        .ground(view::Live::By(fn() {
          let s = lg::surface()
          let t = sel_t()
          if t > 0.01 { lg::alpha(s.row_selected, t) } else { lg::alpha(s.row_hover, hov_t()) }
        }))
        .alpha(view::Live::By(fn() { if dimmed() { 0.45 } else { 1.0 } }))
        let _ = <ui::Text in={b} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text={cat.name} />.allow_ellipsis(
          view::Live::Is(true),
        )
      },
    )
  })
}

fn sp_filter_bar(parent : view::View, ff : ui::Field) -> Unit {
  let _ = parent.box(fn(host : view::View) -> Unit {
    // A solid field on the glass keeps the placeholder readable over any backdrop.
    let _ = host.height(view::Live::Is(Some(SP_32))).rigid().radius(view::Live::Is(SP_16)).ground(view::Live::By(fn() {
      let s = lg::surface()
      if lg::is_dark() { s.canvas } else { s.card }
    }))
    let _ = lg::liquid_search_bar_node(
      host,
      ff,
      placeholder="Find a setting",
      height_by=fn() { SP_32 },
      flat=true,
      label=fn() { "Filter Settings" },
      leading=fn(lead : view::View, ink : () -> Int64) -> Unit {
        let _ = shell_icon(lead, ICON_SEARCH, size=IC_SM, color_by=ink)
      },
    )
  })
}

///| Builds the Settings dialog.
pub fn build_settings_panel(root : view::View, props : SettingsPanelProps) -> Unit {
  let live_win_w = fn() -> Double {
    let _ = root.laid_size_told()
    let ww = root.window_w()
    if ww > SP_96 {
      ww
    } else {
      let (_, _, rw, _) = root.placed_now()
      if rw > SP_96 { rw } else { 1280.0 }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = root.laid_size_told()
    let wh = root.window_h()
    if wh > SP_96 {
      wh
    } else {
      let (_, _, _, rh) = root.placed_now()
      if rh > SP_96 { rh } else { 800.0 }
    }
  }
  let is_narrow = fn() -> Bool { live_win_w() < sp_narrow_breakpoint }
  let filter_query = fn() -> String {
    match props.filter_field {
      Some(f) => f.text()
      None => ""
    }
  }
  // Dialog size: 736 x 560 (SP_160 * 4 + SP_96, SP_160 * 3 + SP_80), shrinking with the window.
  let dlg_w = fn() -> Double {
    let full = SP_160 * 4.0 + SP_96
    let room = live_win_w() - SP_32
    if room < full { if room > SP_160 * 2.0 { room } else { SP_160 * 2.0 } } else { full }
  }
  let dlg_h = fn() -> Double {
    // Narrow windows get a sheet as tall as the window allows: the tile strip already costs height.
    let room = live_win_h() - (if is_narrow() { SP_32 } else { SP_48 })
    let full = if is_narrow() { room } else { SP_160 * 3.0 + SP_80 }
    if room < full { if room > SP_160 * 2.0 { room } else { SP_160 * 2.0 } } else { full }
  }
  let shell_r = SP_24
  let pane_r = lg::concentric(shell_r, SP_8)
  // Opened by the person: the shared dialog presence (fade + 0.98 -> 1, centered). Already open when the panel
  // is built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)

  root.show(props.open, leave=MO_DIALOG_OUT_MS, fn(dlg_wrap : view::View) -> Unit {
    let close_now = shell_closes(dlg_wrap, props.on_close)
    let reveal = shell_dialog_reveal(dlg_wrap, built.v)
    let _ = dlg_wrap.over(view::Live::Is(true)).center().points(view::Live::By(props.open))
    // A filter with no match in the open category moves to the first category that has one.
    dlg_wrap.reacts(filter_query, fn(raw : String) -> Unit {
      let qq = raw.trim()
      let cur = props.active_tab.untracked()
      if qq != "" && !sp_tab_has_match(cur, qq) {
        for c in sp_categories() {
          if sp_tab_has_match(c.idx, qq) {
            props.active_tab.set(c.idx)
            break
          }
        }
      }
    })
    // Dimmed backdrop (outside `headless::dialog` so `close_on_outside` sees backdrop clicks).
    let _ = dlg_wrap.box(fn(scrim : view::View) -> Unit {
      let _ = scrim
      .over(view::Live::Is(true))
      .ground(view::Live::By(fn() {
        let base = if (props.dark)() { 0x00000066L } else { 0x0000002EL }
        lg::alpha(base, reveal.shown_on(scrim))
      }))
    })
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Settings" },
      props.open,
      close_now,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        reveal.grows(dlg_box)
        let _ = lg::liquid_dialog_shell_node(
          dlg_box,
          fn(shell : view::View) -> Unit {
            let _ = shell_float_rim(shell)
            let _ = shell
            .width(view::Live::By(fn() { Some(dlg_w()) }))
            .height(view::Live::By(fn() { Some(dlg_h()) }))
            .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
            .gap(view::Live::Is(SP_8))
            .row(view::Live::By(fn() { !is_narrow() }))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // 1a. Wide: sidebar of categories straight on the glass.
            shell.show(fn() { !is_narrow() }, at_once=true, fn(side : view::View) -> Unit {
              let _ = side
              .width(view::Live::Is(Some(SP_160 + SP_32)))
              .shrink(view::Live::Is(0.0))
              // SP_16 on top puts the filter capsule 24 in, clear of the dialog's corner arc.
              .padding(view::Live::Is((SP_4, SP_16, SP_4, SP_0)))
              .gap(view::Live::Is(SP_16))
              match props.filter_field {
                Some(ff) => sp_filter_bar(side, ff)
                None => ()
              }
              let cats = sp_categories()
              // Semantic color-coded clusters matching macOS Settings reference:
              // System (gray): General, Appearance
              // Browsing (blue): Tabs, Search, Downloads
              // Privacy & Controls (obsidian): Privacy, Shortcuts
              // Info (gray): About (separated by a subtle hairline)
              let clusters : Array[(Int, Int)] = [(0, 2), (2, 5), (5, 7), (7, 8)]
              let mut ci = 0
              while ci < clusters.length() {
                let (from, to) = clusters[ci]
                if ci == 3 {
                  let _ = side.box(fn(sep : view::View) -> Unit {
                    let _ = sep
                    .height(view::Live::Is(Some(lg::hairline_w)))
                    .margin(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
                    .ground(view::Live::By(fn() { lg::surface().separator }))
                  })
                }
                let _ = side.box(fn(grp : view::View) -> Unit {
                  let _ = grp.gap(view::Live::Is(SP_2))
                  let mut i = from
                  while i < to {
                    sp_nav_item(grp, cats[i], props, filter_query)
                    i += 1
                  }
                })
                ci += 1
              }
            })

            // 1b. Narrow: filter and a strip of category tiles above the pane.
            shell.show(is_narrow, at_once=true, fn(top : view::View) -> Unit {
              let _ = top.rigid().gap(view::Live::Is(SP_12)).padding(view::Live::Is((SP_4, SP_16, SP_4, SP_0)))
              match props.filter_field {
                Some(ff) => sp_filter_bar(top, ff)
                None => ()
              }
              // Two rows of four labeled categories: every category says its name (no guessing from a tile).
              let _ = top.box(fn(strip : view::View) -> Unit {
                let _ = strip.gap(view::Live::Is(SP_2)).rigid()
                let cats = sp_categories()
                let mut r = 0
                while r < 2 {
                  let from = r * 4
                  let _ = strip.box(fn(line : view::View) -> Unit {
                    let _ = line.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2))
                    let mut i = from
                    while i < from + 4 && i < cats.length() {
                      sp_strip_item(line, cats[i], props, filter_query)
                      i += 1
                    }
                  })
                  r += 1
                }
              })
            })

            // 2. Solid content pane: breadcrumb header, then the grouped lists of the active category.
            let _ = shell.box(fn(pane : view::View) -> Unit {
              let _ = pane
              .fill()
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(pane_r))
              .ground(view::Live::By(fn() {
                let _ = (props.dark)()
                sp_pane_ground()
              }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

              // The one panel header: the open category's name (TX_HEADLINE/600) and the flat close.
              let _ = pane.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                .height(view::Live::Is(Some(SP_48)))
                .rigid()
                .lies_along(view::Live::Is(view::Lies::Middle))
                .margin(view::Live::Is((SP_0, SP_8, SP_0, SP_0)))
                .padding(view::Live::Is((SP_20, SP_0, SP_8, SP_0)))
                let _ = shell_panel_header(hdr, fn() { sp_category(props.active_tab.get()).name }, "Close Settings", close_now)
              })

              let _ = ui::scroll_box(pane, fn(sc : view::View) -> Unit {
                let _ = sc.padding(view::Live::Is((SP_20, SP_4, SP_20, SP_24))).gap(view::Live::Is(SP_24))
                let tab_view = fn(idx : Int, build : (view::View) -> Unit) -> Unit {
                  sc.show(fn() { props.active_tab.get() == idx }, at_once=true, fn(v : view::View) -> Unit {
                    let _ = v.gap(view::Live::Is(SP_24))
                    build(v)
                  })
                }
                tab_view(SETTINGS_TAB_GENERAL, fn(v) { sp_build_general(v, props, filter_query) })
                tab_view(SETTINGS_TAB_APPEARANCE, fn(v) { sp_build_appearance(v, props, filter_query) })
                tab_view(SETTINGS_TAB_TABS, fn(v) { sp_build_tabs(v, props, filter_query) })
                tab_view(SETTINGS_TAB_SEARCH, fn(v) { sp_build_search(v, props, filter_query) })
                tab_view(SETTINGS_TAB_PRIVACY, fn(v) { sp_build_privacy(v, props, filter_query) })
                tab_view(SETTINGS_TAB_DOWNLOADS, fn(v) { sp_build_downloads(v, props, filter_query) })
                tab_view(SETTINGS_TAB_SHORTCUTS, fn(v) { sp_build_shortcuts(v, filter_query) })
                tab_view(SETTINGS_TAB_ABOUT, fn(v) { sp_build_about(v, filter_query) })

                // Nothing in this category matches the filter: say so, and where matches are.
                sc.show(
                  fn() -> Bool {
                    let qq = filter_query().trim()
                    qq != "" && !sp_tab_has_match(props.active_tab.get(), qq)
                  },
                  at_once=true,
                  fn(emp : view::View) -> Unit {
                    let _ = emp.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_0, SP_48, SP_0, SP_0)))
                    <ui::Text in={emp} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text="No matching settings in this section" />
                    <ui::Text
                      in={emp}
                      size={TX_FOOTNOTE}
                      wrap
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{
                        let qq = filter_query().trim()
                        let cur = props.active_tab.get()
                        let hints : Array[String] = []
                        for c in sp_categories() {
                          if c.idx != cur && sp_tab_has_match(c.idx, qq) {
                            hints.push(c.name)
                          }
                        }
                        if hints.length() > 0 {
                          "Found in " + hints.join(", ")
                        } else {
                          "Try another word, like zoom, theme or cookies."
                        }
                      }
                    />
                  },
                )
              })
            })
          },
          radius=shell_r,
        )
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          match props.filter_field {
            Some(ff) if ff.composing() => {
              ff.compose("")
              return true
            }
            _ => ()
          }
        }
        false
      },
    )
  })
  built.v = true
}
