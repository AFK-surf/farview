///| Shell motion (DESIGN.md section 4): the shared presences, washes and press feedback sampled mid-way and at
///| rest on the Tester clock, first mount instant, reduced motion gentler (opacity kept, no scale).

import "headless"
import "lg"
import "signals"
import "ui"
import "view"

///| A box shown by `open` with the dialog presence (or the popover one), what it draws read back from `got`.
fn mo_reveal_tree(
  open : signals::Signal[Bool],
  got : signals::Ref[Option[(ShellReveal, view::View)]],
  popover~ : Bool = false,
) -> ui::Tester {
  ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let built : signals::Ref[Bool] = ui::ref_new(false)
      root.show(fn() { open.get() }, leave=if popover { MO_POP_OUT_MS } else { MO_DIALOG_OUT_MS }, fn(w : view::View) -> Unit {
        let r = if popover { shell_popover_reveal(w, built.v) } else { shell_dialog_reveal(w, built.v) }
        let _ = w.box(fn(card : view::View) -> Unit {
          let _ = card.width(view::Live::Is(Some(SP_160))).height(view::Live::Is(Some(SP_96))).ground(view::Live::Is(0xFFFFFFFFL))
          r.grows(card, ox=0.0, oy=0.0)
          got.v = Some((r, card))
        })
      })
      built.v = true
    },
    width=640.0,
    height=480.0,
  )
}

fn mo_alpha(got : signals::Ref[Option[(ShellReveal, view::View)]]) -> Double {
  match got.v {
    Some((r, card)) => r.shown_on(card)
    None => -1.0
  }
}

fn mo_scale(got : signals::Ref[Option[(ShellReveal, view::View)]]) -> Double {
  match got.v {
    Some((_, card)) => card.drawn_scale()
    None => -1.0
  }
}

test "motion: dialog presence fades and grows 0.98 -> 1 over 200ms, leaves over 100ms, retargets when reopened" {
  ui::set_reduced_motion(Some(false))
  let open = signals::signal(false)
  let got : signals::Ref[Option[(ShellReveal, view::View)]] = ui::ref_new(None)
  let t = mo_reveal_tree(open, got)
  open.set(true)
  t.frame()
  let a0 = mo_alpha(got)
  debug_assert(a0 >= 0.0 && a0 < 0.05, "opened by the person: starts transparent (alpha \{a0})")
  t.frame(ms=50.0)
  let a50 = mo_alpha(got)
  let s50 = mo_scale(got)
  debug_assert(a50 > 0.2 && a50 < 1.0, "mid-way at 50ms: 0 < alpha < 1 (alpha \{a50})")
  debug_assert(s50 >= MO_DIALOG_SCALE && s50 < 1.0, "mid-way at 50ms: 0.98 <= scale < 1 (scale \{s50})")
  // Strong ease-out: most of the way there early (the person sees it respond at once).
  debug_assert(a50 > 0.5, "strong ease-out is past half at a quarter of the time (alpha \{a50})")
  t.frame(ms=400.0)
  debug_assert(mo_alpha(got) == 1.0 && mo_scale(got) == 1.0, "at rest: alpha 1, scale 1")

  // Leave (a person's close, told as a transition): faster than the enter, eased out, on screen while it goes.
  view::transition(fn() { open.set(false) })
  t.frame(ms=16.0)
  t.frame(ms=34.0)
  let l50 = mo_alpha(got)
  debug_assert(l50 > 0.0 && l50 < 1.0, "leaving at 50ms: 0 < alpha < 1 (alpha \{l50})")
  // Reopened while leaving: from where it is, never from 0.
  view::transition(fn() { open.set(true) })
  t.frame(ms=16.0)
  let back = mo_alpha(got)
  debug_assert(back > 0.0, "reopened mid-leave: continues from its current alpha (alpha \{back})")
  t.frame(ms=400.0)
  debug_assert(mo_alpha(got) == 1.0 && mo_scale(got) == 1.0, "back at rest")
  open.set(false)
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  t.frame(ms=16.0)
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion: already open when built appears at once (no first-mount animation)" {
  ui::set_reduced_motion(Some(false))
  let open = signals::signal(true)
  let got : signals::Ref[Option[(ShellReveal, view::View)]] = ui::ref_new(None)
  let t = mo_reveal_tree(open, got, popover=true)
  debug_assert(mo_alpha(got) == 1.0 && mo_scale(got) == 1.0, "restored state: alpha 1 and scale 1 on the first frame")
  t.frame(ms=16.0)
  debug_assert(mo_alpha(got) == 1.0, "and stays there")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion: popover presence grows 0.97 -> 1 over 140ms from its origin" {
  ui::set_reduced_motion(Some(false))
  let open = signals::signal(false)
  let got : signals::Ref[Option[(ShellReveal, view::View)]] = ui::ref_new(None)
  let t = mo_reveal_tree(open, got, popover=true)
  open.set(true)
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let a40 = mo_alpha(got)
  let s40 = mo_scale(got)
  debug_assert(a40 > 0.0 && a40 < 1.0, "popover at 40ms: 0 < alpha < 1 (alpha \{a40})")
  debug_assert(s40 >= MO_POP_SCALE && s40 < 1.0, "popover at 40ms: scale from 0.97, never 0 (scale \{s40})")
  t.frame(ms=200.0)
  debug_assert(mo_alpha(got) == 1.0 && mo_scale(got) == 1.0, "popover at rest")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion: reduced motion keeps the fade (gentler, not zero) and drops the scale" {
  ui::set_reduced_motion(Some(true))
  let open = signals::signal(false)
  let got : signals::Ref[Option[(ShellReveal, view::View)]] = ui::ref_new(None)
  let t = mo_reveal_tree(open, got)
  open.set(true)
  t.frame(ms=16.0)
  t.frame(ms=34.0)
  let a50 = mo_alpha(got)
  debug_assert(a50 > 0.0 && a50 < 1.0, "reduced motion at 50ms: opacity still eases (alpha \{a50})")
  debug_assert(mo_scale(got) == 1.0, "reduced motion: no scale")
  debug_assert(ui::reduced_motion(), "the reduced-motion override is put back after the fade starts")
  t.frame(ms=MO_REDUCED_MS + 16.0)
  debug_assert(mo_alpha(got) == 1.0, "reduced motion: at rest by MO_REDUCED_MS")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion: keyboard-speed fade (address palette / command bar) is done within 120ms" {
  ui::set_reduced_motion(Some(false))
  let open = signals::signal(false)
  let shown : signals::Ref[Option[(ShellReveal, view::View)]] = ui::ref_new(None)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let built : signals::Ref[Bool] = ui::ref_new(false)
      root.show(fn() { open.get() }, fn(w : view::View) -> Unit {
        let r = shell_reveal(w, built.v, enter_ms=MO_KEY_MS, exit_ms=0.0)
        let _ = w.box(fn(card : view::View) -> Unit {
          let _ = card.width(view::Live::Is(Some(SP_160))).height(view::Live::Is(Some(SP_48)))
          r.fades(card)
          shown.v = Some((r, card))
        })
      })
      built.v = true
    },
    width=640.0,
    height=480.0,
  )
  open.set(true)
  t.frame(ms=16.0)
  t.frame(ms=34.0)
  let a = mo_alpha(shown)
  debug_assert(a > 0.0 && a < 1.0, "palette at 50ms: mid fade (alpha \{a})")
  debug_assert(mo_scale(shown) == 1.0, "palette: opacity only")
  t.frame(ms=70.0)
  debug_assert(mo_alpha(shown) == 1.0, "palette: at rest by 120ms")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "motion: press feedback sinks the face to 0.97 and snaps back faster; hover wash eases on ease" {
  debug_assert(MO_RELEASE_MS < MO_PRESS_MS && MO_PRESS_MS <= 160.0 && MO_RELEASE_MS >= 100.0, "release (the answer) faster than the press")
  ui::set_reduced_motion(Some(false))
  let face_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let wash : signals::Ref[Option[() -> Double]] = ui::ref_new(None)
  let presses = ui::ref_new(0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = headless::button(
        root,
        fn() { "Reload" },
        fn(_e) -> Unit { presses.v = presses.v + 1 },
        fn(b : view::View, btn : headless::Button) -> Unit {
          wash.v = Some(shell_fade(b, fn() { btn.hovered() || btn.pressed() }))
          let _ = b.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_40))).center()
          let _ = b.box(fn(face : view::View) -> Unit {
            let _ = face.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).points(view::Live::Is(false))
            shell_press(face, fn() { btn.pressed() })
            face_ref.v = Some(face)
          })
        },
      )
    },
    width=320.0,
    height=240.0,
  )
  let face_scale = fn() -> Double {
    match face_ref.v {
      Some(f) => f.drawn_scale()
      None => -1.0
    }
  }
  let (x, y, w, h) = match t.get("Reload") {
    Some(d) => (d.x, d.y, d.w, d.h)
    None => (0.0, 0.0, 0.0, 0.0)
  }
  t.press_at(x + w / 2.0, y + h / 2.0)
  t.frame(ms=40.0)
  let s_down = face_scale()
  debug_assert(s_down < 1.0 && s_down >= 1.0 - MO_PRESS_SINK, "pressed at 40ms: sinking toward 0.97 (scale \{s_down})")
  let w_mid = match wash.v {
    Some(f) => f()
    None => -1.0
  }
  debug_assert(w_mid > 0.0 && w_mid < 1.0, "hover wash at 40ms: mid ease (wash \{w_mid})")
  t.frame(ms=200.0)
  debug_assert(face_scale() == 1.0 - MO_PRESS_SINK, "held: rests at 0.97 (scale \{face_scale()})")
  t.release(x + w / 2.0, y + h / 2.0)
  debug_assert(presses.v == 1, "the press itself is never delayed")
  t.frame(ms=20.0)
  let s_up = face_scale()
  debug_assert(s_up > 1.0 - MO_PRESS_SINK && s_up < 1.0, "released at 20ms: coming back (scale \{s_up})")
  t.frame(ms=200.0)
  debug_assert(face_scale() == 1.0, "released: back at 1")
  lg::set_dark(Some(false))
  ui::set_reduced_motion(None)
  t.dispose()
}
