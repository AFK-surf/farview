///| Space themes on the window frame, and the theme editor (Arc's Space theme picker in Shell 3 style).
///|
///| Frame: one color point paints the frame flat (exactly the old accent tint at the default intensity); two or
///| three paint a soft gradient, built from solid layers under `View::fades` (Invar has no gradient primitive).
///| Intensity scales how much of the theme mixes into the paper / graphite, held back where it would cost the
///| sidebar inks their 4.5:1 contrast. Grain is a tiled noise picture over the frame, under the page card; its
///| strength is the layer's opacity, so moving the grain slider never lays anything out again. A Space set to
///| light or dark forces that appearance while it is the active Space (`shell_model_with_space_mode`).
///|
///| Editor: a floating panel (three appearance buttons, a dotted canvas with 1-3 draggable color handles, − / +,
///| preset swatches with paging, a wavy grain slider and an intensity dial). Changes preview on the frame at once
///| (`space_theme_preview`) and are committed to the app on release / on each discrete change.
///|
///| Motion: dragging is direct manipulation (no easing on the handle or the frame). The panel comes and goes like
///| every popover (`shell_popover_reveal`: 0.97 and a fade from its trigger, MO_POP_MS in, MO_POP_OUT_MS out, for
///| every close a person makes from it); a handle being added or removed is 0.9 and a fade over ST_POINT_MS; under
///| reduced motion they only fade.

import "dmath"
import "headless"
import "lg"
import "motion"
import "paint"
import "pixels"
import "proto"
import "signals"
import "ui"
import "view"

// Literals with their token (package lets initialize in file order).
let ST_PANEL_W : Double = 320.0 // SP_160 * 2
let ST_CANVAS : Double = 304.0 // SP_160 + SP_128 + SP_16
let ST_HANDLE_HIT : Double = 32.0 // SP_32
let ST_HANDLE : Double = 24.0 // SP_24
let ST_DIAL : Double = 64.0 // SP_64
let ST_WAVE_W : Double = 224.0 // ST_CANVAS - ST_DIAL - SP_16
let ST_THUMB_W : Double = 20.0 // SP_20
let ST_ROW_H : Double = 48.0 // SP_48
let ST_GRAIN_TILE : Double = 256.0 // SP_128 * 2
let ST_PER_PAGE : Int = 7
let ST_DIAL_SWEEP : Double = 5.235987755982988 // 300 degrees
let ST_DIAL_TICKS : Int = 25
let ST_POINT_MS : Double = 150.0
let ST_KEY_COMMIT_MS : Double = 250.0
let ST_KEY_STEP : Double = 0.02
let ST_GRAIN_KEY : String = "fv-space-theme-grain"
///| Strongest the grain layer is drawn (grain 1.0): a texture under the inks, never a pattern over them.
let ST_GRAIN_MAX_ALPHA : Double = 0.5
let ST_RING : Double = 3.0 // SP_6 / 2: the handle's white ring, the wave's stroke, a dial tick
let ST_HAIR : Double = 1.0 // lg::hairline_w at 1x: rims of the dial and swatches
let ST_DOT : Double = 1.5 // ST_RING / 2: a dial tick's half
let ST_EST_H : Double = 500.0 // name row + canvas + presets + grain row + padding, before it is measured

// ============================================================================
// Live preview (what the frame paints while the editor changes a theme)
// ============================================================================

fn st_preview_same(a : Option[(String, proto::SpaceTheme)], b : Option[(String, proto::SpaceTheme)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((sa, ta)), Some((sb, tb))) => sa == sb && ta.same(tb)
    _ => false
  }
}

///| The theme being edited (Space id, theme) before the app has it back; the frame paints it for that Space.
pub let space_theme_preview : signals::Signal[Option[(String, proto::SpaceTheme)]] = signals::signal_by(
  None,
  st_preview_same,
)

fn st_draft_same(a : Option[proto::SpaceTheme], b : Option[proto::SpaceTheme]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(ta), Some(tb)) => ta.same(tb)
    _ => false
  }
}

///| The theme of a Space being created (Create a Space in the sidebar): the frame paints it for the active Space
///| while the Space is being made and until it arrives (`sidebar_modes.pion`). Below a live edit in the theme editor.
pub let space_theme_draft : signals::Signal[Option[proto::SpaceTheme]] = signals::signal_by(None, st_draft_same)

fn st_theme_of_item(it : ShellSpaceItem) -> proto::SpaceTheme {
  if it.theme.is_unset() {
    let (x, y) = proto::space_theme_position_of(it.accent_rgba)
    proto::SpaceTheme::{ ..it.theme, points: [proto::SpaceThemePoint::{ x, y, rgba: it.accent_rgba }] }
  } else {
    it.theme
  }
}

///| The active Space's theme as drawn now: the preview while it is being edited, else its own (an accent-only
///| Space: one point of its accent).
pub fn shell_space_theme(model : ShellModel) -> proto::SpaceTheme {
  let sid = model.active_space_id()
  match space_theme_preview.get() {
    Some((psid, t)) if psid == sid && !t.is_unset() => return t
    _ => ()
  }
  match space_theme_draft.get() {
    Some(t) if !t.is_unset() => return t
    _ => ()
  }
  let list = model.spaces()
  let mut i = 0
  while i < list.length() {
    if list[i].id == sid {
      return st_theme_of_item(list[i])
    }
    i += 1
  }
  st_theme_of_item(ShellSpaceItem::{ id: "", name: "", accent_rgba: 0x007AFFFFL, theme: proto::space_theme_unset() })
}

///| Whether a theme is being edited live (a drag, arrow keys, a slider): a frame color change then is direct
///| manipulation and must not be eased (a Space-switch tint crossfade should snap while this holds).
pub fn shell_space_theme_editing() -> Bool {
  space_theme_preview.get().is_some()
}

///| Dark or light as the active Space says: its mode when forced, else the app's (`base`).
pub fn shell_space_dark(model : ShellModel, base : () -> Bool) -> Bool {
  match shell_space_theme(model).mode {
    proto::SpaceThemeMode::Light => false
    proto::SpaceThemeMode::Dark => true
    proto::SpaceThemeMode::Auto => base()
  }
}

///| `model` whose `dark` follows the active Space's appearance (auto: the app's).
pub fn shell_model_with_space_mode(model : ShellModel) -> ShellModel {
  let base = model.dark
  ShellModel::{ ..model, dark: fn() -> Bool { shell_space_dark(model, base) } }
}

// ============================================================================
// Frame colors
// ============================================================================

fn st_paper(dark : Bool) -> Int64 {
  if dark { 0x1A1B1EFFL } else { 0xEDEDEFFFL }
}

///| How much of a theme color the frame takes at full intensity (a quarter of it is the old accent tint).
fn st_mix_full(dark : Bool) -> Double {
  if dark { 0.40 } else { 0.44 }
}

///| Primary ink on the frame (`lg::surface().ink` of that appearance).
fn st_frame_ink(dark : Bool) -> Int64 {
  if dark { 0xF5F5F7FFL } else { 0x1C1C1EFFL }
}

///| The frame color for one theme color: the paper / graphite with `intensity` of the theme color mixed in, held
///| back until the frame inks keep 4.5:1 (the sidebar's primary and secondary inks).
pub fn shell_theme_tint(rgba : Int64, dark : Bool, intensity : Double) -> Int64 {
  let paper = st_paper(dark)
  let i = if intensity < 0.0 { 0.0 } else if intensity > 1.0 { 1.0 } else { intensity }
  let mut t = i * st_mix_full(dark)
  let mut c = shell_mix(paper, rgba, t)
  while t > 0.0 &&
  (ui::contrast_ratio(shell_frame_ink_secondary(dark), c) < 4.5 || ui::contrast_ratio(st_frame_ink(dark), c) < 4.5) {
    t = t - 0.01
    c = shell_mix(paper, rgba, if t > 0.0 { t } else { 0.0 })
  }
  c
}

///| The frame's color stops for the active Space, in point order: point 0 is the dominant color (the whole frame's
///| ground and the Space's accent), the last comes in from the right, a third rises from the foot.
pub fn shell_space_frame_stops(model : ShellModel) -> Array[Int64] {
  let t = shell_space_theme(model)
  let dark = model.dark()
  let out : Array[Int64] = []
  for p in t.points {
    out.push(shell_theme_tint(p.rgba, dark, t.intensity))
  }
  if out.length() == 0 {
    out.push(shell_theme_tint(0x007AFFFFL, dark, proto::SPACE_THEME_DEFAULT_INTENSITY))
  }
  out
}

///| `s` as `n` stops drawn the same: copies of the ground (point 0) go in before the last stop, so a layer that a
///| shorter theme lacks starts out painting the ground (nothing to see) as a longer theme eases in.
fn st_pad_stops(s : Array[Int64], n : Int) -> Array[Int64] {
  if s.length() >= n || s.length() == 0 {
    return s
  }
  let out : Array[Int64] = [s[0]]
  let mut k = 0
  while k < n - s.length() {
    out.push(s[0])
    k += 1
  }
  let mut i = 1
  while i < s.length() {
    out.push(s[i])
    i += 1
  }
  out
}

fn st_mix_stops(a : Array[Int64], b : Array[Int64], t : Double) -> Array[Int64] {
  let n = if a.length() > b.length() { a.length() } else { b.length() }
  let pa = st_pad_stops(a, n)
  let pb = st_pad_stops(b, n)
  let out : Array[Int64] = []
  let mut i = 0
  while i < n {
    out.push(shell_mix(pa[i], pb[i], t))
    i += 1
  }
  out
}

fn st_stops_key(s : Array[Int64]) -> String {
  let parts : Array[String] = []
  for c in s {
    parts.push(c.to_string())
  }
  parts.join(",")
}

///| The frame's color stops as drawn now (`root`'s ground and `build_space_theme_ground`): they ease from what is
///| shown to the active Space's whenever those change. Over MO_DIALOG_MS on the strong ease-out when the change is a
///| new Space's theme coming or going (`space_theme_draft`: Create a Space opening, cancelled, a Space made), at once
///| while the theme editor edits live (direct manipulation), else (a Space switch, the appearance) over MO_KEY_MS on
///| `shell_ease`. At once until `built`.
pub fn shell_frame_stops_shown(root : view::View, model : ShellModel, built : () -> Bool) -> () -> Array[Int64] {
  let start = signals::untracked(fn() { shell_space_frame_stops(model) })
  let from : signals::Ref[Array[Int64]] = signals::ref_new(start)
  let to : signals::Ref[Array[Int64]] = signals::ref_new(start)
  let way = motion::NodeWay::new(1.0)
  let last_draft : signals::Ref[Option[proto::SpaceTheme]] = signals::ref_new(signals::untracked(fn() { space_theme_draft.get() }))
  root.reacts(fn() { st_stops_key(shell_space_frame_stops(model)) }, fn(_k : String) -> Unit {
    let now = signals::untracked(fn() { shell_space_frame_stops(model) })
    let d = signals::untracked(fn() { space_theme_draft.get() })
    let draft_moved = !st_draft_same(d, last_draft.v) && (d.is_none() || last_draft.v.is_none())
    last_draft.v = d
    if !built() || signals::untracked(shell_space_theme_editing) {
      from.v = now
      to.v = now
      way.put(1.0)
      return
    }
    let p = way.shown(root)
    from.v = if p >= 1.0 { to.v } else { st_mix_stops(from.v, to.v, p) }
    to.v = now
    way.put(0.0)
    if draft_moved {
      shell_go(way, root, 1.0, MO_DIALOG_MS)
    } else {
      shell_go(way, root, 1.0, MO_KEY_MS, ease=shell_ease())
    }
  }, at_start=false)
  fn() -> Array[Int64] {
    let p = way.shown(root)
    if p >= 1.0 { shell_space_frame_stops(model) } else { st_mix_stops(from.v, to.v, p) }
  }
}

///| The frame's base color (point 0's stop): what `shell_frame_color` paints.
pub fn shell_space_frame_base(model : ShellModel) -> Int64 {
  shell_space_frame_stops(model)[0]
}

// ============================================================================
// Frame ground: gradient layers and grain
// ============================================================================

let st_grain_png : signals::Ref[Option[Bytes]] = signals::ref_new(None)
let st_grain_hook : signals::Ref[Int] = signals::ref_new(-1)

///| The grain tile's PNG, made once: sparse speckles, dark and light, at low opacity.
fn st_grain_bytes() -> Bytes {
  match st_grain_png.v {
    Some(b) => b
    None => {
      // One device pixel per speckle at 2x (512 px over a 256pt tile), xorshift noise (no lattice pattern), faint
      // enough that at full grain (ST_GRAIN_MAX_ALPHA) hairlines and secondary ink still read through it.
      let n = 512
      let rgba = FixedArray::make(n * n * 4, 0 as Byte)
      let mut x = 0x2F6B3A1DL
      let mut i = 0
      while i < n * n {
        x = x ^ ((x << 13) & 0xFFFFFFFFL)
        x = x ^ (x >> 17)
        x = x ^ ((x << 5) & 0xFFFFFFFFL)
        let r = x & 0xFFL
        let a = (x >> 8) & 0xFFL
        if r < 110L {
          let v = if r < 40L { 255 } else { 0 }
          rgba[i * 4] = v.to_byte()
          rgba[i * 4 + 1] = v.to_byte()
          rgba[i * 4 + 2] = v.to_byte()
          rgba[i * 4 + 3] = (16L + a * 28L / 255L).to_int().to_byte()
        }
        i += 1
      }
      let png = pixels::png(n, n, rgba)
      st_grain_png.v = Some(png)
      png
    }
  }
}

fn st_grain_register() -> Unit {
  if ui::image_bytes_for(ST_GRAIN_KEY).is_none() {
    ui::add_image(ST_GRAIN_KEY, st_grain_bytes())
  }
}

///| Makes the grain tile ahead of its first use (the editor calls it as it opens, so the first grain move does not
///| wait on it).
pub fn shell_grain_prepare() -> Unit {
  let _ = st_grain_bytes()
}

///| The grain tile's image key. Registered now, and again before any frame that finds it gone (a host may reset
///| its pictures, as the offscreen renderer does after building the tree): one map lookup a frame, only while the
///| grain layer is mounted (`st_grain_release` as it goes).
fn st_grain_image() -> String {
  st_grain_register()
  // Registered anew on each mount (a host or test that cleared its hooks leaves a stale id: removing it is a no-op).
  st_grain_release()
  st_grain_hook.v = ui::on_before_frame(st_grain_register)
  ST_GRAIN_KEY
}

fn st_grain_release() -> Unit {
  if st_grain_hook.v >= 0 {
    ui::remove_before_frame(st_grain_hook.v)
    st_grain_hook.v = -1
  }
}

///| How strong the grain layer is drawn for a grain setting (0..1): at most ST_GRAIN_MAX_ALPHA.
pub fn shell_grain_alpha(grain : Double) -> Double {
  let g = if grain <= 0.0 { 0.0 } else if grain >= 1.0 { 1.0 } else { grain }
  g * ST_GRAIN_MAX_ALPHA
}

///| Mounts the theme's gradient and grain under everything else on the frame root (call it right after the root's
///| ground, before any other child): solid layers faded across the window paint the extra stops, and the grain is a
///| wrap of noise tiles. Both are placed once per window size; colors and strengths only repaint.
pub fn build_space_theme_ground(root : view::View, model : ShellModel, stops_by? : () -> Array[Int64]) -> Unit {
  let stops = match stops_by {
    Some(f) => f
    None => fn() -> Array[Int64] { shell_space_frame_stops(model) }
  }
  let size = fn() -> (Double, Double) {
    let _ = root.laid_size_told()
    root.laid_size()
  }
  let _ = root.box(fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true)).points(view::Live::Is(false)).clips(view::Live::Is(true))
    // Two or more stops: the last one comes in from the right.
    layer.show(fn() { stops().length() >= 2 }, fn(g : view::View) -> Unit {
      let _ = g
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .fades(view::Live::By(fn() { (size().0, SP_0, SP_0, SP_0) }))
      let _ = g.box(fn(solid : view::View) -> Unit {
        let _ = solid
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .ground(view::Live::By(fn() {
          let s = stops()
          s[s.length() - 1]
        }))
      })
    })
    // Three stops: the middle one rises from the foot.
    layer.show(fn() { stops().length() >= 3 }, fn(g : view::View) -> Unit {
      let _ = g
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .fades(view::Live::By(fn() { (SP_0, size().1, SP_0, SP_0) }))
      let _ = g.box(fn(solid : view::View) -> Unit {
        let _ = solid
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .ground(view::Live::By(fn() {
          let s = stops()
          if s.length() >= 3 { s[1] } else { s[0] }
        }))
      })
    })
    // Grain: tiles of one noise picture; the slider moves only the layer's opacity. A Space switch eases it with
    // the frame tint (MO_KEY_MS on `shell_ease`), so the grain never jumps while the colors fade; a live edit in
    // the theme editor moves it at once.
    let grain_a = shell_follow(layer, fn() { shell_grain_alpha(shell_space_theme(model).grain) }, instant=shell_space_theme_editing)
    layer.show(fn() { grain_a() > 0.0 }, fn(gr : view::View) -> Unit {
      let key = st_grain_image()
      let _ = gr.on_leaving(st_grain_release)
      let _ = gr
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .row(view::Live::Is(true))
      .wrap_on()
      .alpha(view::Live::By(grain_a))
      let tiles = fn() -> Int {
        let (w, h) = size()
        let cols = (w / ST_GRAIN_TILE).ceil().to_int() + 1
        let rows = (h / ST_GRAIN_TILE).ceil().to_int() + 1
        let n = cols * rows
        if n < 1 { 1 } else { n }
      }
      gr.each(
        fn() -> Array[Int] {
          let out : Array[Int] = []
          let n = tiles()
          let mut i = 0
          while i < n {
            out.push(i)
            i += 1
          }
          out
        },
        fn(k : Int) -> String { k.to_string() },
        fn(tile : view::View, _k : signals::Signal[Int]) -> Unit {
          let _ = tile
          .width(view::Live::Is(Some(ST_GRAIN_TILE)))
          .height(view::Live::Is(Some(ST_GRAIN_TILE)))
          .shrink(view::Live::Is(0.0))
          .points(view::Live::Is(false))
          .image(view::Live::Is(Some((key, "", 0))))
        },
      )
    })
  })
}

// ============================================================================
// Editor
// ============================================================================

pub struct SpaceThemeEditorProps {
  pub open : () -> Bool
  ///| The Space being themed (the active one: the frame previews it).
  pub space_id : () -> String
  ///| Its theme as the app has it (an accent-only Space: derived, `proto::space_theme_effective`).
  pub theme : () -> proto::SpaceTheme
  ///| What opened it (the Space name in the sidebar): the panel grows from there. None (opened from the command bar
  ///| or the Spaces manager, or no sidebar): the panel sits in the middle of the window and grows from its middle.
  pub trigger_anchor : () -> Option[AnchorRect]
  ///| The Space's name, renamed in the row at the top of the panel (None: no name row).
  pub name_field : Option[ui::Field]
  pub on_rename : (String, String) -> Unit
  ///| A change to keep (on release of a drag, a short pause after arrow keys, and every discrete change).
  pub on_change : (String, proto::SpaceTheme) -> Unit
  pub on_close : () -> Unit
}

fn st_pct(v : Double) -> String {
  (v * 100.0 + 0.5).floor().to_int().to_string() + "%"
}

///| A 32pt icon button on the editor (flat, a wash on hover, dimmed when it cannot act).
fn st_icon_btn(
  parent : view::View,
  label : String,
  icon : String,
  on_press : () -> Unit,
  disabled~ : () -> Bool = fn() { false },
  size~ : Double = IC_MD,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      shell_press(b, fn() { btn.pressed() && !disabled() })
      let _ = shell_icon(b, icon, size=size, color_by=fn() {
        if disabled() { lg::alpha(lg::surface().ink_tertiary, 0.45) } else { lg::surface().ink_secondary }
      })
    },
    disabled=disabled,
  )
}

///| One appearance button (a radio of three): the chosen one sits on a wash.
fn st_mode_btn(
  parent : view::View,
  label : String,
  icon : String,
  chosen : () -> Bool,
  pick : () -> Unit,
) -> Unit {
  let _ = parent.box(fn(b : view::View) -> Unit {
    let hover_t = shell_fade(b, fn() { b.pointed() && !chosen() })
    // (the chosen wash eases like the hover, never in one frame)
    let chosen_t = shell_fade(b, chosen)
    shell_press(b, fn() { b.pressed() })
    let _ = b
    .width(view::Live::Is(Some(SP_32)))
    .height(view::Live::Is(Some(SP_32)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(SP_8))
    .center()
    .presses(view::Live::Is(true))
    .focusable(view::Live::Is(true))
    .focus_ring_theme()
    .says(view::Live::By(fn() { Some(view::said(view::Role::Radio, label=label, selected=chosen())) }))
    .on_press(pick)
    .ground(view::Live::By(fn() {
      let s = lg::surface()
      let c = chosen_t()
      lg::over(lg::alpha(s.row_hover, hover_t() * (1.0 - c)), lg::alpha(s.separator_strong, c))
    }))
    let _ = shell_icon(b, icon, size=IC_LG, color_by=fn() {
      shell_mix(lg::surface().ink_secondary, lg::surface().ink, chosen_t())
    })
  })
}

///| Points of the grain slider's wave: `periods` sine periods across `w`, `amp` high either side of the middle.
fn st_wave_points(w : Double, h : Double, amp : Double, periods : Double) -> Array[(Double, Double)] {
  let pts : Array[(Double, Double)] = []
  let x0 = SP_8
  let x1 = w - SP_8
  let steps = 96
  let mut i = 0
  while i <= steps {
    let f = i.to_double() / steps.to_double()
    let x = x0 + (x1 - x0) * f
    pts.push((x, h / 2.0 - amp * dmath::sin(f * periods * 2.0 * 3.141592653589793)))
    i += 1
  }
  pts
}

fn st_build_grain_slider(
  parent : view::View,
  value : () -> Double,
  change : (Double) -> Unit,
  commit : (Double) -> Unit,
) -> Unit {
  let wave = st_wave_points(ST_WAVE_W, ST_ROW_H, SP_6, 6.5)
  let _ = headless::slider(
    parent,
    fn() { "Grain" },
    value,
    min=0.0,
    max=1.0,
    step=0.01,
    change,
    fn(v : view::View, s : headless::Slider) -> Unit {
      let _ = v
      .width(view::Live::Is(Some(ST_WAVE_W)))
      .height(view::Live::Is(Some(ST_ROW_H)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .focus_ring_theme()
      // The track: a soft pill behind the wave.
      let _ = v.box(fn(track : view::View) -> Unit {
        let _ = track
        .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_16), Some(SP_0), Some(SP_16)))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(SP_8))
        .ground(view::Live::By(fn() { lg::surface().row_hover }))
      })
      // The wave: the part up to the value in ink, the rest quiet.
      let _ = v.box(fn(w : view::View) -> Unit {
        let _ = w
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .lines(view::Live::By(fn() {
          // Split where the thumb's middle is: ink before it, quiet after.
          let cut = ST_THUMB_W / 2.0 + s.part() * (ST_WAVE_W - ST_THUMB_W)
          let before : Array[(Double, Double)] = []
          let after : Array[(Double, Double)] = []
          for pt in wave {
            if pt.0 <= cut {
              before.push(pt)
            } else {
              if after.length() == 0 && before.length() > 0 {
                after.push(before[before.length() - 1])
              }
              after.push(pt)
            }
          }
          let out : Array[paint::Line] = []
          if after.length() > 1 {
            // Opaque (an alpha stroke beads where its segments overlap).
            out.push(paint::line(after, width=ST_RING, color=shell_mix(lg::surface().card, lg::surface().ink_tertiary, 0.5)))
          }
          if before.length() > 1 {
            out.push(paint::line(before, width=ST_RING, color=lg::surface().ink_secondary))
          }
          out
        }))
      })
      // The thumb: a tall white pill.
      let _ = v.box(fn(th : view::View) -> Unit {
        let _ = th
        .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_0), None, None))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(ST_THUMB_W)))
        .height(view::Live::Is(Some(ST_ROW_H)))
        .radius(view::Live::Is(SP_10))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0xE5E5EAFFL } else { 0xFFFFFFFFL } }))
        // Keep the 2*sigma shadow halo inside the popover's 8pt horizontal padding at 0% grain.
        .shadow(view::Live::Is((SP_4, SP_2, 0x00000038L)))
        .shadow_outside(view::Live::Is(true))
        .offset(view::Live::By(fn() { (s.part() * (ST_WAVE_W - ST_THUMB_W), SP_0) }))
      })
    },
    thumb_room=ST_THUMB_W,
    value_text=st_pct,
    on_commit=commit,
  )
}

fn st_build_dial(
  parent : view::View,
  value : () -> Double,
  change : (Double) -> Unit,
  commit : (Double) -> Unit,
) -> Unit {
  let r = ST_DIAL / 2.0 - SP_4
  let c = ST_DIAL / 2.0
  let angle_of = fn(v : Double) -> Double { -ST_DIAL_SWEEP / 2.0 + ST_DIAL_SWEEP * v }
  let _ = headless::slider(
    parent,
    fn() { "Intensity" },
    value,
    min=0.0,
    max=1.0,
    step=0.01,
    change,
    fn(v : view::View, s : headless::Slider) -> Unit {
      let _ = v
      .width(view::Live::Is(Some(ST_DIAL)))
      .height(view::Live::Is(Some(ST_DIAL)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_32))
      .focus_ring_theme()
      // Ring of ticks: those up to the value in ink.
      let _ = v.box(fn(ring : view::View) -> Unit {
        let _ = ring
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .rects(view::Live::By(fn() {
          let p = s.part()
          let out : Array[paint::Rect] = []
          let mut i = 0
          while i < ST_DIAL_TICKS {
            let f = i.to_double() / (ST_DIAL_TICKS - 1).to_double()
            let a = angle_of(f)
            let x = c + r * dmath::sin(a)
            let y = c - r * dmath::cos(a)
            let on = f <= p + 0.001
            let col = if on { lg::surface().ink_secondary } else { lg::alpha(lg::surface().ink_tertiary, 0.4) }
            out.push(paint::rect(x - ST_DOT, y - ST_DOT, ST_RING, ST_RING, color=col, corners=(ST_DOT, ST_DOT, ST_DOT, ST_DOT)))
            i += 1
          }
          out
        }))
      })
      // Inner circle.
      let _ = v.box(fn(inner : view::View) -> Unit {
        let _ = inner
        .over(view::Live::Is(true), edges=(Some(SP_12), Some(SP_12), Some(SP_12), Some(SP_12)))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(SP_20))
        .edge(view::Live::By(fn() { (ST_HAIR, lg::alpha(lg::surface().ink_tertiary, 0.5)) }))
      })
      // The knob: a small pill on the ring, turned to the value.
      let _ = v.box(fn(knob : view::View) -> Unit {
        let _ = knob
        .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_0), None, None))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(SP_6)))
        .height(view::Live::Is(Some(SP_12)))
        .radius(view::Live::Is(ST_RING))
        .ground(view::Live::By(fn() { lg::surface().ink }))
        .offset(view::Live::By(fn() {
          let a = angle_of(s.part())
          (c + r * dmath::sin(a) - SP_6 / 2.0, c - r * dmath::cos(a) - SP_12 / 2.0)
        }))
        .turn(view::Live::By(fn() { angle_of(s.part()) }))
      })
    },
    value_text=st_pct,
    drag=fn(d : view::Drag) -> Unit {
      match d.kind {
        Down | Moved => {
          let dx = d.x - d.w / 2.0
          let dy = d.y - d.h / 2.0
          if dx * dx + dy * dy > 4.0 {
            let a = dmath::atan2(dx, -dy)
            let f = (a + ST_DIAL_SWEEP / 2.0) / ST_DIAL_SWEEP
            change(if f < 0.0 { 0.0 } else if f > 1.0 { 1.0 } else { f })
          }
        }
        _ => ()
      }
    },
    on_commit=commit,
  )
}

///| The panel's own ground, opaque under the controls (the glass shows only at its rim): content moving behind the
///| panel never shows through the canvas, swatches or sliders.
fn st_panel_ground() -> Int64 {
  if lg::is_dark() { lg::surface().card } else { lg::surface().canvas }
}

///| The dotted canvas's field: a clearly deeper well inside the panel in both appearances.
fn st_canvas_ground() -> Int64 {
  cc_field_ground(st_panel_ground())
}

fn st_ghost_same(a : Option[(Int, proto::SpaceThemePoint)], b : Option[(Int, proto::SpaceThemePoint)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((ga, _)), Some((gb, _))) => ga == gb
    _ => false
  }
}

fn st_same_points(a : Array[proto::SpaceThemePoint], b : Array[proto::SpaceThemePoint]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].rgba != b[i].rgba || (a[i].x - b[i].x).abs() > 0.0005 || (a[i].y - b[i].y).abs() > 0.0005 {
      return false
    }
    i += 1
  }
  true
}

///| Builds the Space theme editor (tag `"space_theme"`), grown from its trigger. Replaces the Customize Space
///| popover.
pub fn build_space_theme_editor(root : view::View, props : SpaceThemeEditorProps) -> Unit {
  let sid = fn() -> String { props.space_id() }
  // The theme shown: the preview of this Space while editing, else the app's.
  let cur = fn() -> proto::SpaceTheme {
    match space_theme_preview.get() {
      Some((psid, t)) if psid == sid() && !t.is_unset() => t
      _ => props.theme()
    }
  }
  let cur_now = fn() -> proto::SpaceTheme { signals::untracked(cur) }
  // Set by a live change not yet sent to the app (a drag in progress, arrow keys before their pause).
  let dirty : signals::Ref[Bool] = ui::ref_new(false)
  // Calls off the pending arrow-key commit.
  let key_commit : signals::Ref[Option[() -> Unit]] = ui::ref_new(None)
  let cancel_key_commit = fn() -> Unit {
    match key_commit.v {
      Some(f) => f()
      None => ()
    }
    key_commit.v = None
  }
  let live = fn(t : proto::SpaceTheme) -> Unit {
    space_theme_preview.set(Some((signals::untracked(sid), t)))
    dirty.v = true
  }
  let commit = fn(t : proto::SpaceTheme) -> Unit {
    cancel_key_commit()
    space_theme_preview.set(Some((signals::untracked(sid), t)))
    dirty.v = false
    (props.on_change)(signals::untracked(sid), t)
  }
  // The preview steps aside once the app's theme changes: to the previewed one (it has it back), or to anything
  // else while nothing is pending (another source's change wins); and at once when the Space changes.
  root.reacts(fn() { (sid(), props.theme()) }, fn(pair : (String, proto::SpaceTheme)) -> Unit {
    match signals::untracked(fn() { space_theme_preview.get() }) {
      Some((psid, t)) if psid != pair.0 || t.same(pair.1) || !dirty.v => {
        dirty.v = false
        space_theme_preview.set(None)
      }
      _ => ()
    }
  })
  // Closing (Escape, the scrim, a Space switch) sends what is still pending, then drops the preview: it never
  // outlives the editor, whether or not the app answers.
  root.reacts(props.open, fn(open : Bool) -> Unit {
    if !open {
      cancel_key_commit()
      match signals::untracked(fn() { space_theme_preview.get() }) {
        Some((psid, t)) => {
          if dirty.v {
            (props.on_change)(psid, t)
          }
          dirty.v = false
          space_theme_preview.set(None)
        }
        None => ()
      }
    }
  }, at_start=false)
  let dragging : signals::Signal[Int] = signals::signal(-1)
  let page : signals::Signal[Int] = signals::signal(0)
  // Set by + so only a point a person adds grows in (not points of a preset or of the theme on open).
  let adding : signals::Ref[Bool] = ui::ref_new(false)
  // The handle last dragged, stepped or focused: what − removes (else the last point).
  let picked : signals::Ref[Int] = ui::ref_new(-1)
  // A removed point fading out where it was (its generation, its point): the handle slots themselves change at once.
  let ghost : signals::Signal[Option[(Int, proto::SpaceThemePoint)]] = signals::signal_by(None, st_ghost_same)
  let ghost_gen : signals::Ref[Int] = ui::ref_new(0)
  let handle_views : Array[Option[view::View]] = []
  let mut hv = 0
  while hv < proto::SPACE_THEME_MAX_POINTS {
    handle_views.push(None)
    hv += 1
  }
  let built : signals::Ref[Bool] = ui::ref_new(false)
  let presets = proto::space_theme_presets()
  let pages = (presets.length() + ST_PER_PAGE - 1) / ST_PER_PAGE
  // Removes point `idx` (the picked one, else the last): it fades out in place; focus goes to a handle left.
  let remove_point = fn(idx : Int, refocus : Bool) -> Unit {
    let t = cur_now()
    let n = t.points.length()
    if n <= 1 {
      return
    }
    let k = if idx >= 0 && idx < n { idx } else { n - 1 }
    ghost_gen.v = ghost_gen.v + 1
    ghost.set(Some((ghost_gen.v, t.points[k])))
    commit(proto::space_theme_remove_point(t, k))
    let left = if k < n - 1 { k } else { n - 2 }
    picked.v = left
    if refocus {
      match handle_views[left] {
        Some(v) => {
          let _ = v.ask_focus()
        }
        None => ()
      }
    }
  }

  root.show(props.open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let animate = built.v
    let close_now = shell_closes(layer, props.on_close)
    let reveal = shell_popover_reveal(layer, animate)
    shell_grain_prepare()
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let place = fn() -> (Double, Double, Double) {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(ST_PANEL_W, vw)
        let ph = mso_measured_h(pos, ST_EST_H)
        match (props.trigger_anchor)() {
          Some(a) if a.is_valid() => {
            let (px, py) = compute_popover_placement(Some(a), a, vw, vh, pw, ph)
            (px, py, pw)
          }
          _ => {
            let py = (vh - ph) / 2.0
            ((vw - pw) / 2.0, if py > SP_8 { py } else { SP_8 }, pw)
          }
        }
      }
      let _ = pos.over_at(view::Live::By(fn() {
        let (px, py, _) = place()
        (Some(px), Some(py), None, None)
      }))
      // Open: 0.97 and a fade, from the side facing the trigger (no trigger: from the middle); close: a quick fade.
      // Already open when built: there.
      let (ox, oy) = signals::untracked(fn() {
        let (px, py, pw) = place()
        match (props.trigger_anchor)() {
          Some(anchor) if anchor.is_valid() => {
            let fx = if pw > 0.0 { (anchor.x + anchor.w / 2.0 - px) / pw } else { 0.5 }
            (if fx < 0.0 { 0.0 } else if fx > 1.0 { 1.0 } else { fx }, if anchor.y > py { 1.0 } else { 0.0 })
          }
          _ => (0.5, 0.5)
        }
      })
      reveal.grows(pos, ox=ox, oy=oy)

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = shell_float_rim(panel)
          let _ = panel
          .width(view::Live::By(fn() { Some(place().2) }))
          .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_16)))
          .gap(view::Live::Is(SP_12))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Space Theme"))))
          let _ = panel.on_key(fn(k : view::Key) -> Bool {
            if k.code == ui::key_escape && k.mods == 0 {
              close_now()
              true
            } else {
              false
            }
          })
          // The panel's opaque ground (first child: under everything else in it).
          let _ = panel.box(fn(bg : view::View) -> Unit {
            let _ = bg.over(view::Live::Is(true)).points(view::Live::Is(false)).ground(view::Live::By(st_panel_ground))
          })

          // 0. The Space's name (rename), when the app gives a field for it.
          match props.name_field {
            Some(field) => {
              let _ = panel.box(fn(nr : view::View) -> Unit {
                let _ = nr.width(view::Live::Is(Some(ST_CANVAS))).shrink(view::Live::Is(0.0))
                mso_name_editor(nr, field, "Space name", "Rename Space", fn(txt : String) -> Unit {
                  (props.on_rename)(signals::untracked(sid), txt)
                })
              })
            }
            None => ()
          }

          // 1. Canvas: dots, appearance, − / +, and the handles (not clipped: they may sit over its edge).
          let _ = panel.box(fn(cv : view::View) -> Unit {
            let _ = cv
            .width(view::Live::Is(Some(ST_CANVAS)))
            .height(view::Live::Is(Some(ST_CANVAS)))
            .shrink(view::Live::Is(0.0))
            color_canvas_field(cv, ST_CANVAS, SP_12, st_canvas_ground)
            // Appearance.
            let _ = cv.box(fn(modes : view::View) -> Unit {
              let _ = modes
              .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_16), Some(SP_0), None))
              .row(view::Live::Is(true))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .gap(view::Live::Is(SP_8))
              .says(view::Live::Is(Some(view::said(view::Role::RadioGroup, label="Appearance"))))
              let mode_is = fn(m : proto::SpaceThemeMode) -> () -> Bool { fn() { cur().mode.same(m) } }
              let pick = fn(m : proto::SpaceThemeMode) -> () -> Unit {
                fn() { commit(proto::space_theme_with_mode(cur_now(), m)) }
              }
              st_mode_btn(modes, "Appearance Automatic", ICON_SPARKLES, mode_is(proto::SpaceThemeMode::Auto), pick(proto::SpaceThemeMode::Auto))
              st_mode_btn(modes, "Appearance Light", ICON_SUN, mode_is(proto::SpaceThemeMode::Light), pick(proto::SpaceThemeMode::Light))
              st_mode_btn(modes, "Appearance Dark", ICON_MOON, mode_is(proto::SpaceThemeMode::Dark), pick(proto::SpaceThemeMode::Dark))
            })
            // − / +.
            let _ = cv.box(fn(pm : view::View) -> Unit {
              let _ = pm
              .over(view::Live::Is(true), edges=(Some(SP_0), None, Some(SP_0), Some(SP_12)))
              .row(view::Live::Is(true))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .gap(view::Live::Is(SP_8))
              st_icon_btn(
                pm,
                "Remove Color",
                "minus",
                fn() { remove_point(picked.v, false) },
                disabled=fn() { cur().points.length() <= 1 },
              )
              st_icon_btn(
                pm,
                "Add Color",
                ICON_PLUS,
                fn() {
                  let t = cur_now()
                  if t.points.length() < proto::SPACE_THEME_MAX_POINTS {
                    adding.v = true
                    picked.v = t.points.length()
                    commit(proto::space_theme_add_point(t))
                  }
                },
                disabled=fn() { cur().points.length() >= proto::SPACE_THEME_MAX_POINTS },
              )
            })
            // A removed point, fading out where it was (0.9 and a fade; reduced motion: the fade only).
            cv.show(fn() { ghost.get().is_some() }, fn(g : view::View) -> Unit {
              // (a NodeWay on shell_go: its fade kept under reduced motion, shell_motion_kept)
              let gway = motion::NodeWay::new(1.0)
              let gpt = fn() -> proto::SpaceThemePoint {
                match ghost.get() {
                  Some((_, p)) => p
                  None => proto::space_theme_point_at(0.5, 0.5)
                }
              }
              g.reacts(fn() { ghost.get() }, fn(v : Option[(Int, proto::SpaceThemePoint)]) -> Unit {
                match v {
                  Some((gen, _)) => {
                    gway.put(1.0)
                    shell_go(gway, g, 0.0, ST_POINT_MS)
                    let _ = g.at_moment(g.cause_at() + ST_POINT_MS, fn() {
                      match ghost.untracked() {
                        Some((now, _)) if now == gen => ghost.set(None)
                        _ => ()
                      }
                    })
                  }
                  None => ()
                }
              })
              let _ = g
              .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_0), None, None))
              .width(view::Live::Is(Some(ST_HANDLE_HIT)))
              .height(view::Live::Is(Some(ST_HANDLE_HIT)))
              .center()
              .points(view::Live::Is(false))
              .offset(view::Live::By(fn() {
                let p = gpt()
                (p.x * ST_CANVAS - ST_HANDLE_HIT / 2.0, p.y * ST_CANVAS - ST_HANDLE_HIT / 2.0)
              }))
              .alpha(view::Live::By(fn() { gway.shown(g) }))
              .scale(view::Live::By(fn() {
                let p = gway.shown(g)
                if ui::reduced_motion() || p >= 0.98 { 1.0 } else { 0.9 + 0.1 * p }
              }))
              color_canvas_face(g, ST_HANDLE, fn() { gpt().rgba }, fn() { false })
            })
            // Handles: one slot per possible point, shown while the theme has it. A slot comes and goes at once
            // (a preset, the app's theme); only a point added with + grows in, and − fades the removed point out
            // where it was (the ghost above), so no handle ever jumps.
            let mut slot = 0
            while slot < proto::SPACE_THEME_MAX_POINTS {
              let idx = slot
              cv.show(fn() { cur().points.length() > idx }, fn(h : view::View) -> Unit {
                let grow = adding.v
                adding.v = false
                handle_views[idx] = Some(h)
                let _ = h.on_leaving(fn() { handle_views[idx] = None })
                let pway = motion::NodeWay::new(if grow { 0.0 } else { 1.0 })
                if grow {
                  shell_go(pway, h, 1.0, ST_POINT_MS)
                }
                let pt = fn() -> proto::SpaceThemePoint {
                  let ps = cur().points
                  if idx < ps.length() { ps[idx] } else { ps[ps.length() - 1] }
                }
                let move_to = fn(x : Double, y : Double) -> proto::SpaceTheme {
                  proto::space_theme_move_point(cur_now(), idx, x, y)
                }
                // Arrow keys: each step previews at once; the app gets the place after a short pause (a held key
                // sends one change, not one a repeat).
                let step_to = fn(x : Double, y : Double) -> Unit {
                  picked.v = idx
                  live(move_to(x, y))
                  cancel_key_commit()
                  key_commit.v = Some(
                    h.at_moment(h.cause_at() + ST_KEY_COMMIT_MS, fn() {
                      key_commit.v = None
                      if dirty.v {
                        commit(cur_now())
                      }
                    }),
                  )
                }
                color_canvas_handle(h, CanvasHandle::{
                  side: ST_CANVAS,
                  face: ST_HANDLE,
                  hit: ST_HANDLE_HIT,
                  label: "Color \{idx + 1}",
                  value: fn() {
                    let p = pt()
                    "Hue \{st_pct(p.x)}, depth \{st_pct(p.y)}"
                  },
                  point: fn() {
                    let p = pt()
                    (p.x, p.y)
                  },
                  rgba: fn() { pt().rgba },
                  big: fn() { dragging.get() == idx },
                  on_down: fn() {
                    picked.v = idx
                    dragging.set(idx)
                  },
                  on_move: fn(x, y) { live(move_to(x, y)) },
                  on_up: fn() {
                    dragging.set(-1)
                    commit(cur_now())
                  },
                  on_step: fn(by : Int) {
                    let p = signals::untracked(pt)
                    picked.v = idx
                    commit(move_to(p.x + by.to_double() * ST_KEY_STEP, p.y))
                  },
                  on_arrow: fn(x, y) { step_to(x, y) },
                  on_delete: fn() {
                    if signals::untracked(fn() { cur().points.length() }) > 1 {
                      remove_point(idx, true)
                      true
                    } else {
                      false
                    }
                  },
                })
                // A point added with + grows in (0.9 and a fade; reduced motion: the fade only).
                let _ = h
                .alpha(view::Live::By(fn() { pway.shown(h) }))
                .scale(view::Live::By(fn() {
                  let p = pway.shown(h)
                  if ui::reduced_motion() || p >= 0.98 { 1.0 } else { 0.9 + 0.1 * p }
                }))
              })
              slot += 1
            }
          })

          // 2. Presets, a page at a time. A preset is a choice of colors: it keeps the Space's appearance, grain and
          // intensity.
          let _ = panel.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .width(view::Live::Is(Some(ST_CANVAS)))
            .shrink(view::Live::Is(0.0))
            st_icon_btn(row, "Previous Themes", ICON_BACK, fn() { page.set(page.untracked() - 1) }, disabled=fn() { page.get() <= 0 })
            let _ = row.box(fn(sw : view::View) -> Unit {
              let _ = sw.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
              let mut k = 0
              while k < ST_PER_PAGE {
                let slot_k = k
                let preset_at = fn() -> Option[proto::SpaceThemePreset] {
                  let i = page.get() * ST_PER_PAGE + slot_k
                  if i < presets.length() { Some(presets[i]) } else { None }
                }
                let stop_at = fn(which : Int) -> Int64 {
                  match preset_at() {
                    Some(p) if which < p.theme.points.length() => p.theme.points[which].rgba
                    _ => 0L
                  }
                }
                let _ = headless::button(
                  sw,
                  fn() {
                    match preset_at() {
                      Some(p) => "Theme " + p.label
                      None => ""
                    }
                  },
                  fn(_e) -> Unit {
                    match signals::untracked(preset_at) {
                      Some(p) => commit(proto::SpaceTheme::{ ..cur_now(), points: p.theme.points })
                      None => ()
                    }
                  },
                  fn(b : view::View, _btn : headless::Button) -> Unit {
                    let chosen = fn() -> Bool {
                      match preset_at() {
                        Some(p) => st_same_points(cur().points, p.theme.points)
                        None => false
                      }
                    }
                    let count = fn() -> Int {
                      match preset_at() {
                        Some(p) => p.theme.points.length()
                        None => 0
                      }
                    }
                    let _ = b
                    .width(view::Live::Is(Some(SP_32)))
                    .height(view::Live::Is(Some(SP_32)))
                    .shrink(view::Live::Is(0.0))
                    .center()
                    .radius(view::Live::Is(SP_16))
                    .edge(view::Live::By(fn() { if chosen() { (SP_2, lg::surface().ink_secondary) } else { (SP_0, 0L) } }))
                    .alpha(view::Live::By(fn() { if preset_at().is_some() { 1.0 } else { 0.0 } }))
                    let _ = b.box(fn(dot : view::View) -> Unit {
                      let _ = dot
                      .width(view::Live::Is(Some(SP_24)))
                      .height(view::Live::Is(Some(SP_24)))
                      .radius(view::Live::Is(SP_12))
                      .clips(view::Live::Is(true))
                      .points(view::Live::Is(false))
                      .edge(view::Live::Is((ST_HAIR, 0x0000001AL)))
                      .ground(view::Live::By(fn() { stop_at(0) }))
                      // A blend as the frame paints it: its last color from the right, a third from the foot.
                      dot.show(fn() { count() >= 2 }, fn(f : view::View) -> Unit {
                        let _ = f.over(view::Live::Is(true)).points(view::Live::Is(false)).fades(view::Live::Is((SP_24, SP_0, SP_0, SP_0)))
                        let _ = f.box(fn(s : view::View) -> Unit {
                          let _ = s.over(view::Live::Is(true)).points(view::Live::Is(false)).ground(view::Live::By(fn() { stop_at(count() - 1) }))
                        })
                      })
                      dot.show(fn() { count() >= 3 }, fn(f : view::View) -> Unit {
                        let _ = f.over(view::Live::Is(true)).points(view::Live::Is(false)).fades(view::Live::Is((SP_0, SP_24, SP_0, SP_0)))
                        let _ = f.box(fn(s : view::View) -> Unit {
                          let _ = s.over(view::Live::Is(true)).points(view::Live::Is(false)).ground(view::Live::By(fn() { stop_at(1) }))
                        })
                      })
                    })
                  },
                  disabled=fn() { preset_at().is_none() },
                )
                k += 1
              }
            })
            st_icon_btn(
              row,
              "More Themes",
              ICON_FORWARD,
              fn() { page.set(page.untracked() + 1) },
              disabled=fn() { page.get() >= pages - 1 },
            )
          })

          // 3. Grain (wave slider) and intensity (dial).
          let _ = panel.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .width(view::Live::Is(Some(ST_CANVAS)))
            .shrink(view::Live::Is(0.0))
            st_build_grain_slider(
              row,
              fn() { cur().grain },
              fn(v : Double) { live(proto::space_theme_with_grain(cur_now(), v)) },
              fn(v : Double) { commit(proto::space_theme_with_grain(cur_now(), v)) },
            )
            st_build_dial(
              row,
              fn() { cur().intensity },
              fn(v : Double) { live(proto::space_theme_with_intensity(cur_now(), v)) },
              fn(v : Double) { commit(proto::space_theme_with_intensity(cur_now(), v)) },
            )
          })
        },
        radius=SP_24,
      )
    })
  })
  built.v = true
}
