///| Shell 3 Find in Page bar (`Cmd+F`): one compact floating capsule in the page's top-right corner.
///|
///| - Mounted per pane (`PaneId::Primary` / `PaneId::Secondary`) and subscribed to `visible`
///|   (which tracks `find_open` and `find_owner_pane_sig` so pane migration & split/peek cleanup work identically).
///| - One layer of `lg` glass (`lg::liquid_popover_surface_decorate`, radius 12 -> 32pt controls at 8, concentric
///|   over the 4pt inset). The field is frameless: the bar itself is the field.
///| - Order: search glyph, query, match count ("3 / 14", red "No matches" on a miss), Match Case, previous / next,
///|   close. Vector icons only, every button named for assistive tech.

import "headless"
import "lg"
import "motion"
import "proto"
import "ui"
import "view"

pub struct FindBarProps {
  pub visible : () -> Bool
  pub dark : () -> Bool
  pub field : ui::Field
  pub case_sensitive : () -> Bool
  pub counts : () -> (Int, Int)
  pub on_query_change : (String) -> Unit
  pub on_prev : () -> Unit
  pub on_next : () -> Unit
  pub on_toggle_case : () -> Unit
  pub on_close : () -> Unit
}

///| Text of the match counter: empty for an empty query, "No matches" on a miss, else "3 / 14".
pub fn find_bar_count_text(query : String, active : Int, total : Int) -> String {
  if proto::find_is_empty_result(query, total) {
    "No matches"
  } else {
    proto::format_find_counter(query, active, total)
  }
}

///| A 32pt control inside the bar: eased wash on hover, accent tint while `active`.
fn fb_control(
  parent : view::View,
  label : String,
  on_press : () -> Unit,
  face : (view::View, () -> Int64) -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_v : view::View) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .ground(view::Live::By(fn() {
        if active() { lg::surface().accent_tint } else { lg::alpha(lg::surface().row_hover, hover_t()) }
      }))
      shell_press(b, fn() { btn.pressed() && !disabled() })
      face(b, fn() {
        if disabled() {
          lg::surface().ink_tertiary
        } else if active() {
          lg::surface().accent
        } else {
          shell_mix(lg::surface().ink_secondary, lg::surface().ink, hover_t())
        }
      })
    },
  )
}

///| Builds the per-pane floating Find in Page bar.
pub fn build_find_bar_panel(parent : view::View, props : FindBarProps) -> Unit {
  parent.show(props.visible, fn(fbar : view::View) -> Unit {
    let missed = fn() -> Bool {
      let (_, tot) = (props.counts)()
      proto::find_is_empty_result(props.field.text(), tot)
    }
    let no_matches = fn() -> Bool {
      let (_, tot) = (props.counts)()
      tot <= 0
    }
    let _ = fbar
    .over_at(view::Live::Is((None, Some(SP_12), Some(SP_12), None)))
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_40)))
    // Never wider than the pane (SP_12 from each edge): on a narrow pane the query field gives up its width first.
    .max_width(view::Live::By(fn() {
      let _ = parent.laid_size_told()
      let (pw, _) = parent.laid_size()
      if pw > SP_160 { Some(pw - SP_24) } else { None }
    }))
    .gap(view::Live::Is(SP_2))
    .padding(view::Live::Is((SP_12, SP_4, SP_4, SP_4)))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Find in Page"))))

    let _ = lg::liquid_popover_surface_decorate(
      fbar,
      radius=SP_12,
      solid=fn() { lg::surface().card },
    )
    // The bar always floats over page text: a solid card fill over the glass keeps that text from showing through
    // as ghost letters next to the query.
    let _ = fbar.ground(view::Live::By(fn() { lg::surface().card }))

    fbar.reacts(fn() { props.field.text() }, fn(q : String) -> Unit {
      (props.on_query_change)(q)
    })

    // Search glyph + frameless query field.
    let _ = shell_icon(fbar, ICON_SEARCH, size=IC_MD, color_by=fn() {
      if missed() { lg::surface().danger } else { lg::surface().ink_secondary }
    })
    // The field box takes the field's own line height; the bar's Middle line-up centres it, whatever the font.
    let _ = fbar.box(fn(in_wrap : view::View) -> Unit {
      let _ = in_wrap
      .basis(view::Live::Is(Some(SP_160 + SP_32)))
      .shrink(view::Live::Is(1.0))
      .min_width(view::Live::Is(Some(SP_80)))
      .margin(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
      .clips(view::Live::Is(true))
      let typed = ui::field(
        in_wrap,
        props.field,
        placeholder="Find in page",
        font_size=TX_BODY,
        color=if (props.dark)() { 0xF5F5F7FFL } else { 0x1D1D1FFFL },
        placeholder_color=if (props.dark)() { 0x98989DFFL } else { 0x8E8E93FFL },
        caret_color=if (props.dark)() { 0x0A84FFFFL } else { 0x007AFFFFL },
        max_lines=1,
        enter_sends=true,
        submitted=fn(_t : String) -> Unit { (props.on_next)() },
      )
      let _ = typed.grow(view::Live::Is(1.0))
      // Follow the theme without remounting the field (keeps focus, selection and IME state).
      in_wrap.reacts(props.dark, fn(d : Bool) -> Unit {
        props.field.color = if d { 0xF5F5F7FFL } else { 0x1D1D1FFFL }
        props.field.ph_color = if d { 0x98989DFFL } else { 0x8E8E93FFL }
        props.field.caret_color = if d { 0x0A84FFFFL } else { 0x007AFFFFL }
      }, at_start=false)
    })

    // Match counter: a fixed slot wide enough for "No matches", always mounted and right-aligned, so the bar keeps
    // its width while the count changes or the query empties.
    let _ = fbar.box(fn(cnt : view::View) -> Unit {
      let _ = cnt
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::End))
      .width(view::Live::Is(Some(SP_80)))
      .height(view::Live::Is(Some(SP_24)))
      .padding(view::Live::Is((SP_4, SP_0, SP_8, SP_0)))
      .rigid()
      <ui::Text
        in={cnt}
        size={TX_FOOTNOTE}
        weight={500}
        color_by=>{if missed() { lg::surface().danger } else { lg::surface().ink_secondary }}
        text_by=>{
          let (idx, tot) = (props.counts)()
          find_bar_count_text(props.field.text(), idx, tot)
        }
      />
    })

    // Match Case: a two-state control, tinted while on.
    fb_control(
      fbar,
      "Match Case",
      props.on_toggle_case,
      fn(b : view::View, ink : () -> Int64) -> Unit {
        <ui::Text in={b} size={TX_FOOTNOTE} weight={500} color_by=>{ink()} text="Aa" />
      },
      active=props.case_sensitive,
    )

    let _ = fbar.box(fn(vsep : view::View) -> Unit {
      let _ = vsep
      .width(view::Live::Is(Some(lg::hairline_w)))
      .height(view::Live::Is(Some(SP_16)))
      .margin(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
      .rigid()
      .ground(view::Live::By(fn() { lg::surface().separator }))
    })

    let icon_face = fn(name : String) -> (view::View, () -> Int64) -> Unit {
      fn(b : view::View, ink : () -> Int64) -> Unit { let _ = shell_icon(b, name, size=IC_MD, color_by=ink) }
    }
    fb_control(fbar, "Previous Match (Shift+Enter)", props.on_prev, icon_face(ICON_CHEVRON_UP), disabled=no_matches)
    fb_control(fbar, "Next Match (Enter)", props.on_next, icon_face(ICON_CHEVRON_DOWN), disabled=no_matches)
    fb_control(fbar, "Close Find Bar (Esc)", props.on_close, icon_face(ICON_CLOSE))
  })
}
