///| Farview Desktop Shell 2.0 Floating Liquid Glass Find-in-Page Capsule (`Cmd+F`).
///|
///| Architectural invariants:
///| - Mounted per pane (`PaneId::Primary` / `PaneId::Secondary`) and subscribed to `visible`
///|   (which tracks `find_open` and `find_owner_pane_sig` so pane migration & split/peek cleanup work identically).
///| - Single-layer Liquid Glass (`lg::liquid_popover_surface_decorate`, radius 14pt -> inner controls 8pt).
///| - Top-right inset `(None, Some(12.0), Some(16.0), None)` inside pane container: never overlaps titleband or split bar.
///| - Zero Unicode pseudo-icons (100% `packages/icons` vector icons + accessible button names).
///| - 100% explicit `color_by` on every `ui::Text` node.

import "headless"
import "lg"
import "proto"
import "ui"
import "view"

pub struct FindBarProps {
  pub visible : () -> Bool
  pub dark : () -> Bool
  pub field : ui::Field
  pub case_sensitive : () -> Bool
  pub counts : () -> (Int, Int)
  pub on_query_change : (String) -> Unit
  pub on_prev : () -> Unit
  pub on_next : () -> Unit
  pub on_toggle_case : () -> Unit
  pub on_close : () -> Unit
}

///| Builds the per-pane floating Liquid Glass Find-in-Page capsule.
pub fn build_find_bar_panel(parent : view::View, props : FindBarProps) -> Unit {
  parent.show(props.visible, fn(fbar : view::View) -> Unit {
    let _ = fbar
    .over_at(view::Live::Is((None, Some(12.0), Some(16.0), None)))
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(42.0)))
    .gap(view::Live::Is(5.0))
    .padding(view::Live::Is((8.0, 6.0, 6.0, 6.0)))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Find in Page"))))

    let _ = lg::liquid_popover_surface_decorate(
      fbar,
      radius=14.0,
      solid=fn() { lg::surface().card },
    )

    fbar.reacts(fn() { props.field.text() }, fn(q : String) -> Unit {
      (props.on_query_change)(q)
    })

    // Single-line Find input box
    let _ = fbar.box(fn(fw : view::View) -> Unit {
      let _ = fw
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .width(view::Live::Is(Some(196.0)))
      .height(view::Live::Is(Some(28.0)))
      .rigid()
      .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
      .gap(view::Live::Is(6.0))
      .radius(view::Live::Is(6.0))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() { lg::surface().card_secondary }))
      .edge(view::Live::By(fn() {
        let q = props.field.text()
        let (_, tot) = (props.counts)()
        if proto::find_is_empty_result(q, tot) {
          (1.0, lg::surface().danger)
        } else {
          (lg::hairline_w, lg::surface().separator)
        }
      }))

      let _ = shell_icon(
        fw,
        ICON_SEARCH,
        size=13.0,
        color_by=fn() { lg::surface().ink_secondary },
      )

      let _ = fw.box(fn(in_wrap : view::View) -> Unit {
        let _ = in_wrap
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .height(view::Live::Is(Some(20.0)))
        .clips(view::Live::Is(true))
        in_wrap.show(fn() { !(props.dark)() }, fn(fl : view::View) -> Unit {
          let _ = fl.fill()
          let _ = ui::field(
            fl,
            props.field,
            placeholder="Find in page",
            font_size=13.0,
            color=0x1D1D1FFFL,
            placeholder_color=0x8E8E93FFL,
            caret_color=0x007AFFFFL,
            max_lines=1,
            enter_sends=true,
            submitted=fn(_t : String) -> Unit { (props.on_next)() },
          )
        })
        in_wrap.show(fn() { (props.dark)() }, fn(fd : view::View) -> Unit {
          let _ = fd.fill()
          let _ = ui::field(
            fd,
            props.field,
            placeholder="Find in page",
            font_size=13.0,
            color=0xF5F5F7FFL,
            placeholder_color=0x98989DFFL,
            caret_color=0x0A84FFFFL,
            max_lines=1,
            enter_sends=true,
            submitted=fn(_t : String) -> Unit { (props.on_next)() },
          )
        })
      })
    })

    // Real-time match counter (`3 / 14`, soft red `0 / 0` on miss, hidden when query is empty)
    fbar.show(fn() { props.field.text().trim() != "" }, fn(cnt_wrap : view::View) -> Unit {
      let _ = cnt_wrap
      .height(view::Live::Is(Some(24.0)))
      .rigid()
      .center()
      .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
      .radius(view::Live::Is(6.0))
      .ground(view::Live::By(fn() {
        let q = props.field.text()
        let (_, tot) = (props.counts)()
        if proto::find_is_empty_result(q, tot) {
          if (props.dark)() { 0xFF453A30L } else { 0xFF3B301AL }
        } else {
          lg::surface().card_secondary
        }
      }))
      let _ = <ui::Text
        in={cnt_wrap}
        size={11.5}
        weight={500}
        color_by=>{
          let q = props.field.text()
          let (_, tot) = (props.counts)()
          if proto::find_is_empty_result(q, tot) {
            lg::surface().danger
          } else {
            lg::surface().ink_secondary
          }
        }
        text_by=>{
          let q = props.field.text()
          let (idx, tot) = (props.counts)()
          proto::format_find_counter(q, idx, tot)
        }
      />
    })

    // `Aa` Case-Sensitivity Toggle Button
    let _ = headless::button(
      fbar,
      fn() { "Match Case" },
      fn(_v : view::View) -> Unit { (props.on_toggle_case)() },
      fn(ab : view::View, abtn : headless::Button) -> Unit {
        let _ = ab
        .width(view::Live::Is(Some(28.0)))
        .height(view::Live::Is(Some(26.0)))
        .rigid()
        .center()
        .radius(view::Live::Is(6.0))
        .ground(view::Live::By(fn() {
          if (props.case_sensitive)() {
            if (props.dark)() { 0x0A84FF38L } else { 0x007AFF1EL }
          } else if abtn.hovered() || abtn.pressed() {
            lg::surface().row_hover
          } else {
            0x00000000L
          }
        }))
        let _ = <ui::Text
          in={ab}
          size={11.5}
          weight={600}
          color_by=>{
            if (props.case_sensitive)() {
              lg::surface().accent
            } else if abtn.hovered() || abtn.pressed() {
              lg::surface().ink
            } else {
              lg::surface().ink_secondary
            }
          }
          text="Aa"
        />
      },
    )

    // Single vertical hairline separator
    let _ = fbar.box(fn(vsep : view::View) -> Unit {
      let _ = vsep
      .width(view::Live::Is(Some(1.0)))
      .height(view::Live::Is(Some(16.0)))
      .rigid()
      .ground(view::Live::By(fn() { lg::surface().separator }))
    })

    // Accessible vector icon navigation buttons
    let find_icon_btn = fn(icon_name : String, label : String, danger : Bool, on_click : () -> Unit) -> Unit {
      let _ = headless::button(
        fbar,
        fn() { label },
        fn(_v : view::View) -> Unit { on_click() },
        fn(nb : view::View, nbtn : headless::Button) -> Unit {
          let _ = nb
          .width(view::Live::Is(Some(26.0)))
          .height(view::Live::Is(Some(26.0)))
          .rigid()
          .center()
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() {
            if danger && (nbtn.hovered() || nbtn.pressed()) {
              if (props.dark)() { 0xFF453A30L } else { 0xFF3B301AL }
            } else if nbtn.hovered() || nbtn.pressed() {
              lg::surface().row_hover
            } else {
              0x00000000L
            }
          }))
          let _ = shell_icon(
            nb,
            icon_name,
            size=13.5,
            color_by=fn() {
              if danger && (nbtn.hovered() || nbtn.pressed()) {
                lg::surface().danger
              } else if nbtn.hovered() || nbtn.pressed() {
                lg::surface().ink
              } else {
                lg::surface().ink_secondary
              }
            },
          )
        },
      )
    }

    find_icon_btn(ICON_BACK, "Previous Match (Shift+Enter)", false, props.on_prev)
    find_icon_btn(ICON_FORWARD, "Next Match (Enter)", false, props.on_next)
    find_icon_btn(ICON_CLOSE, "Close Find Bar (Esc)", true, props.on_close)
  })
}
