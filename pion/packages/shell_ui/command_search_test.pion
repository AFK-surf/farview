///| Command Bar and Tab Search layout: the Space column is fixed (dots line up whatever the Space is called,
///| a long name truncates), rows without a shortcut get no trailing gap (a tab row's Space column ends where a
///| command row's last keycap does), the close button shows on hover alone, and the empty Tab Search footer
///| offers only Esc.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn cst_open_item(id : String, title : String, host : String, space : String, accent : Int64, pinned~ : Bool = false) -> proto::TabSearchItem {
  proto::TabSearchItem::{
    is_open: true,
    id,
    title,
    url: "https://" + host + "/",
    display_host: host,
    space_name: space,
    space_accent: "",
    space_accent_rgba: accent,
    is_active: false,
    is_pinned: pinned,
    is_favorite: false,
    is_playing_audio: false,
    closed_index: -1,
  }
}

fn cst_tab_search(ctrl : ShellController, items : Array[proto::TabSearchItem], selected : Int) -> TabSearchProps {
  TabSearchProps::{
    field: ui::Field::new(),
    results: fn() { proto::TabSearchResult::{ open_items: items, closed_items: [], total_open: items.length(), total_closed: 0 } },
    selected: fn() { selected },
    on_query_change: fn(_q) { () },
    on_submit: fn() { () },
    on_activate: fn(_it) { () },
    on_close_tab: fn(_id) { () },
    on_close: fn() { ctrl.exclusive.set(ctrl.exclusive.untracked().begin_close()) },
  }
}

///| The 8pt Space dots drawn in the last frame, as (x, y, color).
fn cst_dots(t : ui::Tester, color : Int64) -> Array[(Double, Double)] {
  let out : Array[(Double, Double)] = []
  for d in t.drawn() {
    if d.w == 8.0 && d.h == 8.0 && d.ground == color {
      out.push((d.x, d.y))
    }
  }
  out
}

test "command: Tab Search Space column is fixed, close shows on hover, empty footer offers only Esc" {
  let ctrl = make_demo_controller()
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::TabSearch, tag="tab_search"))
  let lab = 0xAF52DEFFL
  let work = 0x007AFFFFL
  let items = [
    cst_open_item("a", "Pull requests", "github.com", "Laboratory Notebook", lab, pinned=true),
    cst_open_item("b", "Hacker News", "news.ycombinator.com", "Work", work),
  ]
  let empty = signals::signal(false)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_tab_search_overlay(root, ctrl.model(), TabSearchProps::{
        ..cst_tab_search(ctrl, items, -1),
        results: fn() {
          if empty.get() {
            proto::TabSearchResult::{ open_items: [], closed_items: [], total_open: 0, total_closed: 0 }
          } else {
            proto::TabSearchResult::{
              open_items: items,
              closed_items: [
                proto::TabSearchItem::{
                  ..cst_open_item("c", "Bauhaus - Wikipedia", "en.wikipedia.org", "Laboratory Notebook", lab),
                  is_open: false,
                  closed_index: 0,
                },
              ],
              total_open: 2,
              total_closed: 1,
            }
          }
        },
      })
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=600.0)
  let a = cst_dots(t, lab)
  let b = cst_dots(t, work)
  debug_assert(a.length() == 2 && b.length() == 1, "one Space dot per row")
  debug_assert(a[1].0 == b[0].0, "a recently closed row's dot is in the same column")
  debug_assert(a[0].0 == b[0].0, "Space dots form one column: \{a[0].0} vs \{b[0].0}")
  let mut name_ok = false
  for d in t.drawn() {
    if d.words == "Laboratory Notebook" {
      name_ok = d.w > 0.0 && d.w <= SP_96 - SP_8 - SP_6 + 0.5
    }
  }
  debug_assert(name_ok, "a long Space name truncates inside its column")
  debug_assert(t.get("Pinned").is_some(), "the pinned tab's state glyph is named Pinned")

  // No selection: no close button until the pointer is over a row (over its main button, not the row itself).
  debug_assert(t.get("Close Tab").is_none(), "no close button without hover or selection")
  match t.get("Switch to Hacker News") {
    Some(d) => t.move_to(d.x + d.w * 0.5, d.y + d.h * 0.5)
    None => debug_assert(false, "open tab row is a button")
  }
  t.frame(ms=300.0)
  debug_assert(t.get("Close Tab").is_some(), "hovering a row shows its close button")

  empty.set(true)
  t.frame(ms=300.0)
  debug_assert(t.find("No open or recently closed tabs").is_some(), "empty state says so")
  debug_assert(t.find("Navigate").is_none() && t.find("Switch or reopen").is_none(), "no dead hints when nothing matches")
  debug_assert(t.find("Close").is_some(), "Esc Close stays")
  lg::assert_apple_ui(t, label="command_tab_search")
  t.dispose()
}

test "command: Command Bar tab rows end where command keycaps end; current Space is named" {
  let ctrl = make_demo_controller()
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::CommandBar, tag="command_bar"))
  let work = 0x007AFFFFL
  let items : Array[proto::CommandBarItem] = [
    proto::CommandBarItem::{
      kind: proto::CommandKind::SwitchTab,
      id: "t-hn",
      title: "Hacker News",
      subtitle: "news.ycombinator.com",
      badge: "Work",
      shortcut: "",
      monogram: "",
      accent: work,
      is_space: false,
      is_tab: true,
    },
    proto::CommandBarItem::{
      kind: proto::CommandKind::SwitchSpace,
      id: "work",
      title: "Switch to Work",
      subtitle: "4 tabs",
      badge: "Active",
      shortcut: "",
      monogram: "",
      accent: work,
      is_space: true,
      is_tab: false,
    },
    proto::CommandBarItem::{
      kind: proto::CommandKind::Action,
      id: "toggle_bookmark",
      title: "Bookmark Current Page",
      subtitle: "Save or remove this page in Bookmarks",
      badge: "",
      shortcut: "⌘D",
      monogram: "",
      accent: 0L,
      is_space: false,
      is_tab: false,
    },
  ]
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_command_bar_overlay(root, ctrl.model(), CommandBarProps::{
        field: ui::Field::new(),
        items: fn() { items },
        selected: fn() { 0 },
        on_query_change: fn(_q) { () },
        on_step: fn(_d) { true },
        on_submit: fn(_t) { () },
        on_execute: fn(_it) { () },
        on_close: fn() { () },
        on_row_view: None,
        on_clear_rows: None,
      })
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=600.0)
  let dots = cst_dots(t, work)
  debug_assert(dots.length() == 1, "only the tab row has a Space dot")
  let col_right = dots[0].0 + SP_96
  // The command row's keycaps: 20pt pills; the rightmost one's right edge.
  let mut kc_right = 0.0
  for d in t.drawn() {
    if d.h == SP_20 && d.w >= SP_20 && d.w < SP_40 && d.words == "" && d.ground != 0L && d.y > dots[0].1 + SP_40 {
      if d.x + d.w > kc_right && d.y < dots[0].1 + SP_160 {
        kc_right = d.x + d.w
      }
    }
  }
  debug_assert(kc_right > 0.0, "the command row draws keycaps")
  let diff = if col_right > kc_right { col_right - kc_right } else { kc_right - col_right }
  debug_assert(diff < 0.5, "the tab row's Space column ends at the last keycap: \{col_right} vs \{kc_right}")
  debug_assert(t.find("Current Space").is_some(), "the Space in front reads Current Space")
  lg::assert_apple_ui(t, label="command_bar_columns")
  t.dispose()
}
