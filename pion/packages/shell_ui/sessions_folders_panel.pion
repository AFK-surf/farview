///| Shell 3 spaces area, part 1: the Saved Sessions dialog (`build_sessions_modal_panel`) and the sidebar's inline
///| New Folder card (`build_inline_folder_creator_bar`), plus the small private pieces both spaces-area files share
///| (`spx_*`: dialog header, grouped list, rules, icon buttons, color swatches).
///|
///| Invariants kept from Shell 2:
///| - Restore and Delete forward the exact `session_id`.
///| - The folder card fits both the docked sidebar and the 480pt drawer.
///| - One layer of glass (the dialog shell); everything inside is solid `lg::surface()`.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// Shared private pieces (spaces area)
// ============================================================================

///| Dialog scrim: the same quiet dim the frame's own dialog uses.
fn spx_scrim(dlg_box : view::View, close : () -> Unit) -> Unit {
  let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
    let _ = scrim
    .over(view::Live::Is(true))
    .ground(view::Live::By(fn() { if lg::is_dark() { 0x00000059L } else { 0x00000038L } }))
    .presses(view::Live::Is(true))
    .on_press(fn() -> Unit { close() })
  })
}

///| Width of a centered dialog: `max_w`, or the window less a 16pt gutter on each side when narrower.
fn spx_dialog_width(root : view::View, max_w : Double) -> () -> Option[Double] {
  fn() {
    let ww = root.window_w()
    if ww > 0.0 && ww < max_w + SP_32 {
      let avail = ww - SP_32
      Some(if avail > SP_160 + SP_80 { avail } else { SP_160 + SP_80 })
    } else {
      Some(max_w)
    }
  }
}

///| A short flat text button (`Restore`, `Switch`, `Cancel`): accessible name `label_fn`, visible `text`.
fn spx_text_btn(
  parent : view::View,
  label_fn : () -> String,
  text : String,
  on_press : () -> Unit,
  ink~ : () -> Int64 = fn() { shell_accent_text() },
) -> view::View {
  shell_text_btn(parent, label_fn, on_press, text_by=fn() { text }, ink=ink)
}

///| The prominent (blue) button of a dialog or card.
fn spx_primary_btn(parent : view::View, label_fn : () -> String, text : String, on_press : () -> Unit) -> view::View {
  shell_primary_btn(parent, label_fn, on_press, text_by=fn() { text })
}

///| One line of text that ends in an ellipsis when it has no room. `grow` for rows, not for columns.
fn spx_line(
  parent : view::View,
  text_by : () -> String,
  size~ : Double = TX_BODY,
  weight~ : Int = 400,
  color_by~ : () -> Int64 = fn() { lg::surface().ink },
  grow~ : Bool = false,
) -> Unit {
  let _ = parent.box(fn(b : view::View) -> Unit {
    let _ = b.min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(1.0)).cut()
    if grow {
      let _ = b.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0)))
    }
    let _ = <ui::Text in={b} size={size} weight={weight} color_by=>{color_by()} text_by=>{text_by()} />.allow_ellipsis(
      view::Live::Is(true),
    )
  })
}

///| Dialog header: the one panel header (`shell_panel_header`, TX_HEADLINE/600, flat close) with an optional
///| one-line description (never a counter).
fn spx_dialog_header(
  parent : view::View,
  title : String,
  subtitle_by : () -> String,
  close_label : String,
  on_close : () -> Unit,
) -> Unit {
  let _ = shell_panel_header(parent, fn() { title }, close_label, on_close, subtitle_by=subtitle_by)
}

///| A grouped-list section: quiet sentence-case caption, one solid card, optional footnote.
fn spx_group(
  parent : view::View,
  caption : String,
  rows : (view::View) -> Unit,
  footnote_by~ : () -> String = fn() { "" },
  pad~ : Double = SP_0,
) -> Unit {
  <ui::Col in={parent} gap={SP_6} rigid>
    <ui::Show when=>{caption != ""}>
      <ui::Box pad_x={SP_12} rigid>
        <ui::Text size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={caption} />
      </ui::Box>
    </ui::Show>
    <lg::SurfaceCard radius={SP_12} pad={pad}>
      <ui::Col ref_view={rows} />
    </lg::SurfaceCard>
    <ui::Show when=>{footnote_by() != ""}>
      <ui::Box pad_x={SP_12} rigid>
        <ui::Text size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text_by=>{footnote_by()} />
      </ui::Box>
    </ui::Show>
  </ui::Col>
}

///| Hairline between grouped rows, starting at `inset` (where the row labels start).
fn spx_rule(parent : view::View, inset~ : Double = SP_12 + SP_24 + SP_12) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((inset, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| A round color swatch: 16pt dot, a 2pt ring in its own color when selected, 32pt hit target.
fn spx_swatch(
  parent : view::View,
  label_fn : () -> String,
  rgba : Int64,
  selected : () -> Bool,
  on_pick : () -> Unit,
  grow~ : Bool = false,
) -> view::View {
  headless::button(
    parent,
    label_fn,
    fn(_v : view::View) -> Unit { on_pick() },
    fn(sw : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(sw, fn() { btn.hovered() || btn.pressed() })
      let _ = sw.height(view::Live::Is(Some(SP_32))).min_width(view::Live::Is(Some(SP_32))).center()
      if grow {
        let _ = sw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
      } else {
        let _ = sw.width(view::Live::Is(Some(SP_32))).shrink(view::Live::Is(0.0))
      }
      let _ = sw.box(fn(ring : view::View) -> Unit {
        let _ = ring
        .width(view::Live::Is(Some(SP_24)))
        .height(view::Live::Is(Some(SP_24)))
        .rigid()
        .center()
        .radius(view::Live::Is(SP_12))
        .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
        .edge(view::Live::By(fn() { if selected() { (SP_2, rgba) } else { (SP_0, 0x00000000L) } }))
        let _ = ring.box(fn(dot : view::View) -> Unit {
          let _ = dot
          .width(view::Live::Is(Some(SP_16)))
          .height(view::Live::Is(Some(SP_16)))
          .rigid()
          .radius(view::Live::Is(SP_8))
          .ground(view::Live::Is(rgba))
        })
      })
    },
  )
}

///| The accent color of a session's active Space (falls back to its first Space).
///| The accent of the Space a session was saved from (the color its person chose for it), 0 when it has none.
fn spx_session_accent(s : proto::NamedSessionSnapshot) -> Int64 {
  let mut i = 0
  while i < s.spaces.length() {
    if s.spaces[i].id == s.active_space_id {
      return proto::workspace_accent_color(s.spaces[i].accent)
    }
    i += 1
  }
  if s.spaces.length() > 0 {
    proto::workspace_accent_color(s.spaces[0].accent)
  } else {
    0L
  }
}

fn spx_join(parts : Array[String], sep : String) -> String {
  let mut out = ""
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      out = out + sep
    }
    out = out + parts[i]
    i += 1
  }
  out
}

fn spx_plural(n : Int, one : String, many : String) -> String {
  if n == 1 { "1 " + one } else { n.to_string() + " " + many }
}

// ============================================================================
// 1. Saved Sessions dialog
// ============================================================================

///| Props for `build_sessions_modal_panel`.
pub struct SessionsModalProps {
  pub open : () -> Bool
  pub sessions : () -> Array[proto::NamedSessionSnapshot]
  pub current_space_count : () -> Int
  pub current_tab_count : () -> Int
  pub now_secs : () -> Int64
  pub name_field : ui::Field
  pub filter_field : ui::Field
  pub on_save_session : (String) -> Unit
  pub on_restore_session : (String, String) -> Unit
  pub on_delete_session : (String, String) -> Unit
  pub on_close : () -> Unit
  pub return_focus : Option[view::View]
}

#derive(Eq)
struct SessionKeyedRow {
  id : String
  name : String
  created_secs : Int64
  accent_rgba : Int64
  spaces_joined : String
  preview_hosts_joined : String
  first : Bool
}

///| Builds the Saved Sessions dialog: save the current window under a name, then restore or delete saved ones.
///| Restores and deletes strictly by exact `session_id`.
pub fn build_sessions_modal_panel(root : view::View, props : SessionsModalProps) -> Unit {
  let close_fn = props.on_close
  let filtered_rows = fn() -> Array[SessionKeyedRow] {
    let raw = proto::filter_named_sessions((props.sessions)(), props.filter_field.text())
    let out : Array[SessionKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let s = raw[i]
      let names : Array[String] = []
      let mut k = 0
      while k < s.spaces.length() {
        if s.spaces[k].name.trim() != "" {
          names.push(s.spaces[k].name)
        }
        k += 1
      }
      out.push(SessionKeyedRow::{
        id: s.id,
        name: s.name,
        created_secs: s.created_secs,
        accent_rgba: spx_session_accent(s),
        spaces_joined: spx_join(names, ", "),
        preview_hosts_joined: spx_join(proto::session_preview_hosts(s, max_hosts=3), ", "),
        first: i == 0,
      })
      i += 1
    }
    out
  }

  let save_current = fn() -> Unit {
    let raw_name = props.name_field.text()
    (props.on_save_session)(raw_name)
    props.name_field.set("")
  }

  // Opened by the person: the shared dialog presence. Already open when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_DIALOG_OUT_MS, fn(dlg_wrap : view::View) -> Unit {
    let close_now = shell_closes(dlg_wrap, close_fn)
    let reveal = shell_dialog_reveal(dlg_wrap, built.v)
    reveal.fades(dlg_wrap)
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Saved Sessions" },
      props.open,
      close_now,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center()
        spx_scrim(dlg_box, close_now)

        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          reveal.grows_only(shell)
          let _ = shell
          .width(view::Live::By(spx_dialog_width(root, SP_160 * 3.0 + SP_40)))
          .max_height(view::Live::By(fn() {
            let wh = root.window_h()
            if wh > 0.0 { Some(wh - SP_64) } else { Some(SP_160 * 4.0) }
          }))
          .padding(view::Live::Is((SP_24, SP_24, SP_24, SP_24)))
          .gap(view::Live::Is(SP_20))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          spx_dialog_header(
            shell,
            "Saved sessions",
            fn() { "Keep a set of Spaces and tabs to come back to." },
            "Close Saved Sessions",
            close_now,
          )

          // Save the current window.
          spx_group(
            shell,
            "Save this window",
            fn(g : view::View) -> Unit {
              let _ = g.box(fn(srow : view::View) -> Unit {
                let _ = srow
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .gap(view::Live::Is(SP_8))
                .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
                let _ = srow.box(fn(fw : view::View) -> Unit {
                  let _ = fw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                  let _ = lg::liquid_text_field_node(
                    fw,
                    props.name_field,
                    placeholder="Session name",
                    height_by=fn() { SP_32 },
                    label=fn() { "Session Name" },
                    show_label=false,
                    flat=true,
                    radius=SP_8,
                    submitted=fn(_t : String) -> Unit { save_current() },
                  )
                })
                let _ = spx_primary_btn(srow, fn() { "Save Current Session" }, "Save", save_current)
              })
            },
            footnote_by=fn() {
              "Saves " +
              spx_plural((props.current_space_count)(), "Space", "Spaces") +
              " and " +
              spx_plural((props.current_tab_count)(), "tab", "tabs") +
              "."
            },
          )

          // Saved sessions: search, then the "Saved" caption sitting on its card (scrolls when long).
          let _ = shell.box(fn(saved : view::View) -> Unit {
            let _ = saved.gap(view::Live::Is(SP_12)).min_height(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(1.0))
            saved.show(fn() { (props.sessions)().length() > 0 }, fn(sw : view::View) -> Unit {
              let _ = sw.rigid()
              let _ = lg::liquid_text_field_node(
                sw,
                props.filter_field,
                placeholder="Search sessions, Spaces and sites",
                height_by=fn() { SP_32 },
                label=fn() { "Filter Sessions" },
                show_label=false,
                flat=true,
                radius=SP_8,
                lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
                  let _ = shell_icon(ic, ICON_SEARCH, size=IC_SM, color_by=ink)
                },
                trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
                  tr.show(fn() { props.filter_field.text() != "" }, fn(cw : view::View) -> Unit {
                    let _ = shell_panel_icon_btn(cw, fn() { "Clear Session Filter" }, ICON_CLOSE, fn() { props.filter_field.set("") })
                  })
                },
              )
            })

            let _ = saved.box(fn(group : view::View) -> Unit {
              let _ = group.gap(view::Live::Is(SP_6)).min_height(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(1.0))
              <ui::Box in={group} pad_x={SP_12} rigid>
                <ui::Text size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text="Saved" />
              </ui::Box>
              let _ = group.box(fn(card_wrap : view::View) -> Unit {
                let _ = card_wrap
                .min_height(view::Live::Is(Some(SP_0)))
                .min_width(view::Live::Is(Some(SP_0)))
                .shrink(view::Live::Is(1.0))
                .max_height(view::Live::Is(Some(SP_160 + SP_160)))
                .clips(view::Live::Is(true))
                .radius(view::Live::Is(SP_12))
                .ground(view::Live::By(fn() { lg::surface().card }))
                let _ = ui::scroll_box(card_wrap, fn(sc : view::View) -> Unit {
                  let _ = sc.padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))

                  // Empty / no-match state, inside the same card.
                  sc.show(fn() { filtered_rows().length() == 0 }, fn(emp : view::View) -> Unit {
                    let _ = emp
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Start)))
                    .min_height(view::Live::Is(Some(SP_48)))
                    .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
                    .gap(view::Live::Is(SP_12))
                    let _ = shell_glyph_tile(emp, ICON_BOOKMARK, size=SP_24)
                    <ui::Col in={emp} fill gap={SP_2} pad_y={SP_4}>
                      <ui::Text
                        size={TX_BODY}
                        color_by=>{lg::surface().ink}
                        text_by=>{
                          let q = props.filter_field.text().trim()
                          if q != "" { "No sessions match \u{201C}" + q + "\u{201D}" } else { "No saved sessions" }
                        }
                      />
                      <ui::Text
                        size={TX_FOOTNOTE}
                        wrap
                        color_by=>{lg::surface().ink_secondary}
                        text_by=>{
                          if props.filter_field.text().trim() != "" {
                            "Search looks at session names, Spaces, page titles and sites."
                          } else {
                            "Name this window above to save its Spaces and tabs."
                          }
                        }
                      />
                    </ui::Col>
                  })

                  sc.each(
                    filtered_rows,
                    fn(r : SessionKeyedRow) -> String { r.id },
                    fn(slot : view::View, row_sig : signals::Signal[SessionKeyedRow]) -> Unit {
                      slot.show(fn() { !row_sig.get().first }, fn(rw : view::View) -> Unit {
                        spx_rule(rw, inset=SP_8 + SP_24 + SP_12)
                      })
                      let _ = slot.box(fn(row : view::View) -> Unit {
                        let hover_t = shell_fade(row, fn() { row.pointed() || row.pointed_in() })
                        let _ = row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Start)))
                        .min_height(view::Live::Is(Some(SP_48)))
                        .padding(view::Live::Is((SP_8, SP_6, SP_8, SP_6)))
                        .gap(view::Live::Is(SP_12))
                        .radius(view::Live::Is(SP_8))
                        .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))

                        // The color of the Space it was saved from is the person's own (DESIGN.md section 3), so
                        // it stays; a session with no Space draws the neutral tile.
                        if signals::untracked(fn() { row_sig.get().accent_rgba }) != 0L {
                          let _ = shell_tint_tile(row, ICON_BOOKMARK, fn() { row_sig.get().accent_rgba }, size=SP_24)
                        } else {
                          let _ = shell_glyph_tile(row, ICON_BOOKMARK, size=SP_24)
                        }
                        let _ = row.box(fn(col : view::View) -> Unit {
                          let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).gap(view::Live::Is(SP_2)).padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
                          let _ = col.box(fn(l1 : view::View) -> Unit {
                            let _ = l1.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8))
                            spx_line(l1, fn() { row_sig.get().name }, weight=500, grow=true)
                            <ui::Text
                              in={l1}
                              size={TX_FOOTNOTE}
                              color_by=>{lg::surface().ink_tertiary}
                              text_by=>{proto::format_session_timestamp(row_sig.get().created_secs, (props.now_secs)())}
                            />
                          })
                          spx_line(
                            col,
                            fn() {
                              let r = row_sig.get()
                              if r.spaces_joined != "" && r.preview_hosts_joined != "" {
                                r.spaces_joined + " \u{2014} " + r.preview_hosts_joined
                              } else if r.spaces_joined != "" {
                                r.spaces_joined
                              } else {
                                r.preview_hosts_joined
                              }
                            },
                            size=TX_FOOTNOTE,
                            color_by=fn() { lg::surface().ink_secondary },
                          )
                        })
                        let _ = spx_text_btn(
                          row,
                          fn() { "Restore Session " + row_sig.get().name },
                          "Restore",
                          fn() -> Unit {
                            let r = row_sig.untracked()
                            (props.on_restore_session)(r.id, r.name)
                          },
                        )
                        let _ = shell_panel_icon_btn(
                          row,
                          fn() { "Delete Session " + row_sig.get().name },
                          ICON_CLOSE,
                          fn() -> Unit {
                            let r = row_sig.untracked()
                            (props.on_delete_session)(r.id, r.name)
                          },
                          danger=true,
                        )
                      })
                    },
                  )
                })
              })
            })
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if props.name_field.composing() {
            props.name_field.compose("")
            return true
          }
          if props.filter_field.composing() {
            props.filter_field.compose("")
            return true
          }
        }
        false
      },
      return_focus?=props.return_focus,
    )
  })
  built.v = true
}

// ============================================================================
// 2. Inline New Folder card (docked sidebar and the 480pt sidebar drawer)
// ============================================================================

///| Props for `build_inline_folder_creator_bar`.
pub struct InlineFolderCreatorProps {
  pub open : () -> Bool
  pub name_field : ui::Field
  pub color : signals::Signal[String]
  pub move_active_tab : signals::Signal[Bool]
  pub on_submit : (String, String, Bool) -> Unit
  pub on_cancel : () -> Unit
  pub return_focus : Option[view::View]
}

///| Builds the inline New Folder card in the sidebar: name, color, whether the current tab moves in, Create.
///| Enter or Create submits (`folder_new`); Escape or Cancel closes and restores focus.
pub fn build_inline_folder_creator_bar(
  parent : view::View,
  props : InlineFolderCreatorProps,
) -> Unit {
  let cancel_and_restore = fn() -> Unit {
    if props.name_field.focused() {
      props.name_field.let_go()
    }
    (props.on_cancel)()
    match props.return_focus {
      Some(target) => {
        let _ = target.ask_focus()
      }
      None => ()
    }
  }

  let submit_folder = fn() -> Unit {
    let name = props.name_field.text()
    let color = proto::normalize_folder_color(props.color.untracked())
    let move_active = props.move_active_tab.untracked()
    (props.on_submit)(name, color, move_active)
  }

  parent.show(props.open, fn(wrap : view::View) -> Unit {
    let _ = wrap
    .min_width(view::Live::Is(Some(SP_0)))
    .on_key(fn(k : view::Key) -> Bool {
      if k.code == ui::key_escape && k.mods == 0 {
        if props.name_field.composing() {
          props.name_field.compose("")
          return true
        }
        cancel_and_restore()
        return true
      }
      false
    })

    // A frame surface, not a solid card: the page is the only solid card in the window (DESIGN section 1).
    let _ = wrap.box(fn(card : view::View) -> Unit {
      let _ = card
      .gap(view::Live::Is(SP_12))
      .min_width(view::Live::Is(Some(SP_0)))
      .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
      .radius(view::Live::Is(SP_12))
      .ground(view::Live::By(fn() { shell_wash_strong(lg::is_dark()) }))
      .shadow(view::Live::By(fn() { shell_row_lift(lg::is_dark()) }))

      // Name, with the folder glyph in the chosen color.
      let _ = lg::liquid_text_field_node(
        card,
        props.name_field,
        placeholder="Folder name",
        height_by=fn() { SP_32 },
        label=fn() { "Folder Name" },
        show_label=false,
        flat=true,
        radius=SP_8,
        lead=fn(ic : view::View, _ink : () -> Int64) -> Unit {
          let _ = shell_icon(ic, ICON_FOLDER, size=IC_MD, color_by=fn() { proto::folder_color_rgba(props.color.get()) })
        },
        submitted=fn(_txt : String) -> Unit { submit_folder() },
      )

      // Color: six swatches sharing the row's width.
      let _ = card.box(fn(crow : view::View) -> Unit {
        let _ = crow.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).min_width(view::Live::Is(Some(SP_0)))
        let keys = proto::folder_color_keys()
        let mut ci = 0
        while ci < keys.length() {
          let ck = keys[ci]
          let _ = spx_swatch(
            crow,
            fn() { "Folder Color " + proto::folder_color_label(ck) },
            proto::folder_color_rgba(ck),
            fn() { proto::normalize_folder_color(props.color.get()) == ck },
            fn() { props.color.set(ck) },
            grow=true,
          )
          ci += 1
        }
      })

      // Move the current tab into the new folder.
      let _ = card.box(fn(mrow : view::View) -> Unit {
        let _ = mrow
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_8))
        .min_height(view::Live::Is(Some(SP_32)))
        .padding(view::Live::Is((SP_4, SP_0, SP_0, SP_0)))
        <ui::Box in={mrow} fill cut>
          <ui::Text size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text="Move current tab" />
        </ui::Box>
        let _ = shell_desktop_toggle(
          mrow,
          fn() { props.move_active_tab.get() },
          fn(next : Bool) -> Unit { props.move_active_tab.set(next) },
          fn() { "Move current tab" },
        )
      })

      // Cancel / Create, trailing.
      let _ = card.box(fn(arow : view::View) -> Unit {
        let _ = arow.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8)).min_width(view::Live::Is(Some(SP_0)))
        let _ = arow.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
        let _ = spx_text_btn(arow, fn() { "Cancel New Folder" }, "Cancel", cancel_and_restore, ink=fn() { lg::surface().ink })
        let _ = spx_primary_btn(arow, fn() { "Create Folder" }, "Create", submit_folder)
      })
    })
  })
}
