///| Farview Desktop Shell 2.0 Phase 3B — Liquid Glass Deep Drawers & Modals (Part 2):
///| 1. Named Workspace Sessions Manager Modal (`build_sessions_modal_panel`)
///| 2. Sidebar Inline Folder Creator Bar (`build_inline_folder_creator_bar`)
///|
///| Architecture invariants:
///| - Exact `session_id` propagation on both Restore and Delete callbacks.
///| - Inline Folder Creator adapts cleanly to both 244pt wide sidebar and 480pt narrow sidebar drawer.
///| - Single-layer Liquid Glass on outermost Dialog container only; 100% solid `lg::surface()` inside.
///| - 100% vector icons via `shell_icon`, 100% explicit `color_by`, point-unit layout, zero Unicode pseudo-icons.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Named Workspace Sessions Manager Modal
// ============================================================================

///| Props for `build_sessions_modal_panel`.
pub struct SessionsModalProps {
  pub open : () -> Bool
  pub sessions : () -> Array[proto::NamedSessionSnapshot]
  pub current_space_count : () -> Int
  pub current_tab_count : () -> Int
  pub now_secs : () -> Int64
  pub name_field : ui::Field
  pub filter_field : ui::Field
  pub on_save_session : (String) -> Unit
  pub on_restore_session : (String, String) -> Unit
  pub on_delete_session : (String, String) -> Unit
  pub on_close : () -> Unit
  pub return_focus : Option[view::View]
}

#derive(Eq)
struct SessionKeyedRow {
  id : String
  name : String
  created_secs : Int64
  space_count : Int
  tab_count : Int
  preview_hosts_joined : String
}

impl signals::Eq for SessionKeyedRow {
  fn eq(self : SessionKeyedRow, other : SessionKeyedRow) -> Bool {
    self.id == other.id &&
    self.name == other.name &&
    self.created_secs == other.created_secs &&
    self.space_count == other.space_count &&
    self.tab_count == other.tab_count &&
    self.preview_hosts_joined == other.preview_hosts_joined
  }
}

fn join_preview_hosts(hosts : Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < hosts.length() {
    if i > 0 {
      out = out + ", "
    }
    out = out + hosts[i]
    i += 1
  }
  out
}

///| Builds the Liquid Glass Saved Sessions Manager Modal.
///| Restores and deletes strictly by exact `session_id`.
pub fn build_sessions_modal_panel(root : view::View, props : SessionsModalProps) -> Unit {
  let close_fn = props.on_close
  let filtered_rows = fn() -> Array[SessionKeyedRow] {
    let raw = proto::filter_named_sessions((props.sessions)(), props.filter_field.text())
    let out : Array[SessionKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let s = raw[i]
      let hosts = proto::session_preview_hosts(s, max_hosts=4)
      out.push(SessionKeyedRow::{
        id: s.id,
        name: s.name,
        created_secs: s.created_secs,
        space_count: s.spaces.length(),
        tab_count: s.tabs.length(),
        preview_hosts_joined: join_preview_hosts(hosts),
      })
      i += 1
    }
    out
  }

  let save_current = fn() -> Unit {
    let raw_name = props.name_field.text()
    (props.on_save_session)(raw_name)
    props.name_field.set("")
  }

  root.show(props.open, fn(dlg_wrap : view::View) -> Unit {
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Saved Sessions" },
      props.open,
      close_fn,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center().padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))

        // Full-window pointer-blocking scrim
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x05081068L } else { 0x0F172A40L } }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { close_fn() })
        })

        // Outermost Liquid Glass Dialog Shell
        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          let _ = shell
          .width(view::Live::Is(Some(604.0)))
          .max_height(view::Live::Is(Some(620.0)))
          .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
          .gap(view::Live::Is(12.0))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          // 1. Header: Title + Snapshot count + Close
          let _ = shell.box(fn(hdr : view::View) -> Unit {
            let _ = hdr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(8.0))
            .rigid()

            let _ = shell_icon(hdr, ICON_LAYERS, size=16.0, color_by=fn() { lg::surface().accent })
            let _ = <ui::Text in={hdr} size={15.0} weight={600} color_by=>{lg::surface().ink} text="Saved Sessions" />

            let _ = hdr.box(fn(cpill : view::View) -> Unit {
              let _ = cpill
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              let _ = <ui::Text
                in={cpill}
                size={11.0}
                weight={500}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{
                  let n = (props.sessions)().length()
                  if n == 1 { "1 snapshot" } else { n.to_string() + " snapshots" }
                }
              />
            })

            let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

            let _ = phase3b_icon_action_btn(hdr, fn() { "Close Saved Sessions" }, ICON_CLOSE, close_fn)
          })

          // 2. Save Current Session solid card
          let _ = lg::surface_card_node(
            shell,
            fn(save_card : view::View) -> Unit {
              let _ = save_card.gap(view::Live::Is(10.0))

              // Workspace summary badges
              let _ = save_card.box(fn(meta : view::View) -> Unit {
                let _ = meta.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                let _ = <ui::Text
                  in={meta}
                  size={12.0}
                  weight={600}
                  color_by=>{lg::surface().ink_secondary}
                  text="Current Workspace"
                />
                let _ = meta.box(fn(sp_b : view::View) -> Unit {
                  let _ = sp_b
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                  let _ = <ui::Text
                    in={sp_b}
                    size={10.5}
                    weight={600}
                    color_by=>{lg::surface().accent}
                    text_by=>{
                      let n = (props.current_space_count)()
                      if n == 1 { "1 space" } else { n.to_string() + " spaces" }
                    }
                  />
                })
                let _ = meta.box(fn(tb_b : view::View) -> Unit {
                  let _ = tb_b
                  .height(view::Live::Is(Some(20.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() { lg::surface().card }))
                  .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                  let _ = <ui::Text
                    in={tb_b}
                    size={10.5}
                    weight={500}
                    color_by=>{lg::surface().ink_secondary}
                    text_by=>{
                      let n = (props.current_tab_count)()
                      if n == 1 { "1 tab" } else { n.to_string() + " tabs" }
                    }
                  />
                })
              })

              // Input + Save button row
              let _ = save_card.box(fn(srow : view::View) -> Unit {
                let _ = srow.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                let _ = srow.box(fn(fw : view::View) -> Unit {
                  let _ = fw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                  let _ = lg::liquid_text_field_node(
                    fw,
                    props.name_field,
                    placeholder="Snapshot name (e.g. Architecture Research)...",
                    height_by=fn() { 36.0 },
                    label=fn() { "Session Name" },
                    show_label=false,
                    flat=true,
                    radius=10.0,
                    submitted=fn(_t : String) -> Unit { save_current() },
                  )
                })
                let _ = lg::liquid_button_node(
                  srow,
                  fn() { "Save Current Session" },
                  save_current,
                  prominent=true,
                  height=36.0,
                  pad_x=14.0,
                )
              })
            },
            radius=lg::r_row,
            pad=12.0,
            secondary=true,
          )

          // 3. Filter Input (reuses `props.filter_field`)
          let _ = lg::liquid_text_field_node(
            shell,
            props.filter_field,
            placeholder="Filter sessions by name, space, or domain...",
            height_by=fn() { 36.0 },
            label=fn() { "Filter Sessions" },
            show_label=false,
            flat=true,
            radius=10.0,
            lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
              let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink)
            },
            trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
              tr.show(fn() { props.filter_field.text() != "" }, fn(cw : view::View) -> Unit {
                let _ = phase3b_icon_action_btn(
                  cw,
                  fn() { "Clear Session Filter" },
                  ICON_CLOSE,
                  fn() { props.filter_field.set("") },
                )
              })
            },
          )

          // 4. Scrollable Session Snapshot Cards (keyed by exact `session_id`)
          let _ = shell.box(fn(list_wrap : view::View) -> Unit {
            let _ = list_wrap
            .height(view::Live::Is(Some(300.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .min_height(view::Live::Is(Some(0.0)))
            .rigid()
            .clips(view::Live::Is(true))
            .radius(view::Live::Is(lg::r_row))
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

            let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
              let _ = sc.padding(view::Live::Is((10.0, 10.0, 10.0, 10.0))).gap(view::Live::Is(8.0))

              sc.show(fn() { filtered_rows().length() == 0 }, fn(emp_wrap : view::View) -> Unit {
                let _ = lg::surface_card_node(
                  emp_wrap,
                  fn(emp : view::View) -> Unit {
                    let _ = emp.min_height(view::Live::Is(Some(100.0))).center().gap(view::Live::Is(4.0))
                    let _ = <ui::Text
                      in={emp}
                      size={13.0}
                      weight={600}
                      color_by=>{lg::surface().ink}
                      text_by=>{
                        let q = props.filter_field.text().trim()
                        if q != "" {
                          "No saved sessions match \"" + q + "\""
                        } else {
                          "No saved sessions yet"
                        }
                      }
                    />
                    let _ = <ui::Text
                      in={emp}
                      size={11.5}
                      color_by=>{lg::surface().ink_secondary}
                      text="Capture your current spaces, folders, and tabs above."
                    />
                  },
                  radius=lg::r_row,
                  pad=16.0,
                )
              })

              sc.each(
                filtered_rows,
                fn(r : SessionKeyedRow) -> String { r.id },
                fn(slot : view::View, row_sig : signals::Signal[SessionKeyedRow]) -> Unit {
                  let _ = lg::surface_card_node(
                    slot,
                    fn(card : view::View) -> Unit {
                      let _ = card.gap(view::Live::Is(8.0))

                      // Top row: Name + Timestamp + Restore + Delete
                      let _ = card.box(fn(top : view::View) -> Unit {
                        let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))

                        let _ = top.box(fn(tw : view::View) -> Unit {
                          let _ = tw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                          let _ = <ui::Text
                            in={tw}
                            size={13.5}
                            weight={600}
                            color_by=>{lg::surface().ink}
                            text_by=>{row_sig.get().name}
                          />.allow_ellipsis(view::Live::Is(true))
                        })

                        let _ = <ui::Text
                          in={top}
                          size={11.0}
                          color_by=>{lg::surface().ink_tertiary}
                          text_by=>{proto::format_session_timestamp(row_sig.get().created_secs, (props.now_secs)())}
                        />

                        let _ = lg::liquid_button_node(
                          top,
                          fn() { "Restore Session " + row_sig.get().name },
                          fn() -> Unit {
                            let r = row_sig.untracked()
                            (props.on_restore_session)(r.id, r.name)
                          },
                          content=fn(inner : view::View) -> Unit {
                            let _ = <ui::Text in={inner} size={12.0} weight={600} color_by=>{lg::surface().accent} text="Restore" />
                          },
                          flat=true,
                          height=30.0,
                          pad_x=10.0,
                        )

                        let _ = lg::liquid_button_node(
                          top,
                          fn() { "Delete Session " + row_sig.get().name },
                          fn() -> Unit {
                            let r = row_sig.untracked()
                            (props.on_delete_session)(r.id, r.name)
                          },
                          content=fn(inner : view::View) -> Unit {
                            let _ = <ui::Text in={inner} size={12.0} weight={600} color_by=>{0xFFFFFFFFL} text="Delete" />
                          },
                          flat=true,
                          height=30.0,
                          pad_x=10.0,
                          tint=lg::surface().danger,
                        )
                      })

                      // Bottom row: space count + tab count + preview hosts
                      let _ = card.box(fn(bot : view::View) -> Unit {
                        let _ = bot.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).min_width(view::Live::Is(Some(0.0)))

                        let _ = bot.box(fn(sp_p : view::View) -> Unit {
                          let _ = sp_p
                          .height(view::Live::Is(Some(20.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                          .radius(view::Live::Is(6.0))
                          .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                          let _ = <ui::Text
                            in={sp_p}
                            size={10.5}
                            weight={600}
                            color_by=>{lg::surface().accent}
                            text_by=>{
                              let n = row_sig.get().space_count
                              if n == 1 { "1 space" } else { n.to_string() + " spaces" }
                            }
                          />
                        })

                        let _ = bot.box(fn(tb_p : view::View) -> Unit {
                          let _ = tb_p
                          .height(view::Live::Is(Some(20.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                          .radius(view::Live::Is(6.0))
                          .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                          let _ = <ui::Text
                            in={tb_p}
                            size={10.5}
                            weight={500}
                            color_by=>{lg::surface().ink_secondary}
                            text_by=>{
                              let n = row_sig.get().tab_count
                              if n == 1 { "1 tab" } else { n.to_string() + " tabs" }
                            }
                          />
                        })

                        let _ = bot.box(fn(hw : view::View) -> Unit {
                          let _ = hw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                          let _ = <ui::Text
                            in={hw}
                            size={11.0}
                            color_by=>{lg::surface().ink_tertiary}
                            text_by=>{row_sig.get().preview_hosts_joined}
                          />.allow_ellipsis(view::Live::Is(true))
                        })
                      })
                    },
                    radius=lg::r_row,
                    pad=12.0,
                  )
                },
              )
            })
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if props.name_field.composing() {
            props.name_field.compose("")
            return true
          }
          if props.filter_field.composing() {
            props.filter_field.compose("")
            return true
          }
        }
        false
      },
      return_focus?=props.return_focus,
    )
  })
}

// ============================================================================
// 2. Sidebar Inline Folder Creator Bar (works at 244pt wide AND 480pt narrow drawer)
// ============================================================================

///| Props for `build_inline_folder_creator_bar`.
pub struct InlineFolderCreatorProps {
  pub open : () -> Bool
  pub name_field : ui::Field
  pub color : signals::Signal[String]
  pub move_active_tab : signals::Signal[Bool]
  pub on_submit : (String, String, Bool) -> Unit
  pub on_cancel : () -> Unit
  pub return_focus : Option[view::View]
}

///| Builds the solid-surface inline folder creator bar inside the sidebar (docked or narrow floating drawer).
///| Supports Enter/click submit (`folder_new`) and Esc/Cancel close with focus restoration.
pub fn build_inline_folder_creator_bar(
  parent : view::View,
  props : InlineFolderCreatorProps,
) -> Unit {
  let cancel_and_restore = fn() -> Unit {
    if props.name_field.focused() {
      props.name_field.let_go()
    }
    (props.on_cancel)()
    match props.return_focus {
      Some(target) => {
        let _ = target.ask_focus()
      }
      None => ()
    }
  }

  let submit_folder = fn() -> Unit {
    let name = props.name_field.text()
    let color = proto::normalize_folder_color(props.color.untracked())
    let move_active = props.move_active_tab.untracked()
    (props.on_submit)(name, color, move_active)
  }

  parent.show(props.open, fn(wrap : view::View) -> Unit {
    let _ = wrap
    .min_width(view::Live::Is(Some(0.0)))
    .on_key(fn(k : view::Key) -> Bool {
      if k.code == ui::key_escape && k.mods == 0 {
        if props.name_field.composing() {
          props.name_field.compose("")
          return true
        }
        cancel_and_restore()
        return true
      }
      false
    })

    let _ = lg::surface_card_node(
      wrap,
      fn(card : view::View) -> Unit {
        let _ = card.gap(view::Live::Is(8.0)).min_width(view::Live::Is(Some(0.0)))

        // Row 1: Folder Name input (reuses `props.name_field`, fills available width cleanly)
        let _ = lg::liquid_text_field_node(
          card,
          props.name_field,
          placeholder="Folder name...",
          height_by=fn() { 36.0 },
          label=fn() { "Folder Name" },
          show_label=false,
          flat=true,
          radius=8.0,
          lead=fn(ic : view::View, _ink : () -> Int64) -> Unit {
            let _ = shell_icon(
              ic,
              ICON_FOLDER,
              size=13.5,
              color_by=fn() { proto::folder_color_rgba(props.color.get()) },
            )
          },
          submitted=fn(_txt : String) -> Unit { submit_folder() },
        )

        // Row 2: 6 semantic folder color swatches (compact flexible row that never clips at 480pt narrow drawer)
        let _ = card.box(fn(crow : view::View) -> Unit {
          let _ = crow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Between))
          .min_width(view::Live::Is(Some(0.0)))

          let keys = proto::folder_color_keys()
          let mut ci = 0
          while ci < keys.length() {
            let ck = keys[ci]
            let rgba = proto::folder_color_rgba(ck)
            let is_sel = fn() -> Bool { proto::normalize_folder_color(props.color.get()) == ck }
            let _ = headless::button(
              crow,
              fn() { "Folder Color " + proto::folder_color_label(ck) },
              fn(_v : view::View) -> Unit { props.color.set(ck) },
              fn(cb : view::View, _cbtn : headless::Button) -> Unit {
                let _ = cb
                .grow(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(24.0)))
                .height(view::Live::Is(Some(36.0)))
                .center()
                .radius(view::Live::Is(8.0))
                .ground(view::Live::By(fn() { if is_sel() { lg::surface().row_selected } else { 0x00000000L } }))
                let _ = cb.box(fn(ring : view::View) -> Unit {
                  let _ = ring
                  .width(view::Live::Is(Some(18.0)))
                  .height(view::Live::Is(Some(18.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(9.0))
                  .edge(view::Live::By(fn() { if is_sel() { (1.5, rgba) } else { (0.0, 0x00000000L) } }))
                  let _ = ring.box(fn(dot : view::View) -> Unit {
                    let _ = dot
                    .width(view::Live::Is(Some(11.0)))
                    .height(view::Live::Is(Some(11.0)))
                    .rigid()
                    .radius(view::Live::Is(5.5))
                    .ground(view::Live::Is(rgba))
                  })
                })
              },
            )
            ci += 1
          }
        })

        // Row 3: Move active tab toggle + Cancel + Create
        let _ = card.box(fn(arow : view::View) -> Unit {
          let _ = arow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(4.0))
          .min_width(view::Live::Is(Some(0.0)))

          let _ = headless::button(
            arow,
            fn() { "Toggle Move Active Tab into Folder" },
            fn(_v : view::View) -> Unit {
              props.move_active_tab.set(!props.move_active_tab.untracked())
            },
            fn(mb : view::View, mbtn : headless::Button) -> Unit {
              let _ = mb
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(36.0)))
              .gap(view::Live::Is(5.0))
              .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() { if mbtn.hovered() || mbtn.pressed() { lg::surface().row_hover } else { 0x00000000L } }))

              let _ = mb.box(fn(chk : view::View) -> Unit {
                let _ = chk
                .width(view::Live::Is(Some(14.0)))
                .height(view::Live::Is(Some(14.0)))
                .rigid()
                .center()
                .radius(view::Live::Is(4.0))
                .ground(view::Live::By(fn() {
                  if props.move_active_tab.get() { lg::surface().accent } else { lg::surface().card }
                }))
                .edge(view::Live::By(fn() {
                  if props.move_active_tab.get() { (1.0, lg::surface().accent) } else { (1.0, lg::surface().separator_strong) }
                }))
                chk.show(fn() { props.move_active_tab.get() }, fn(ic : view::View) -> Unit {
                  let _ = shell_icon(ic, ICON_CHECK, size=10.0, color_by=fn() { 0xFFFFFFFFL })
                })
              })
              let _ = mb.box(fn(ml : view::View) -> Unit {
                let _ = ml.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                let _ = <ui::Text
                  in={ml}
                  size={11.0}
                  weight={500}
                  color_by=>{lg::surface().ink_secondary}
                  text="Move tab"
                />.allow_ellipsis(view::Live::Is(true))
              })
            },
          )

          let _ = phase3b_icon_action_btn(arow, fn() { "Cancel New Folder" }, ICON_CLOSE, cancel_and_restore)

          let _ = lg::liquid_button_node(
            arow,
            fn() { "Create Folder" },
            submit_folder,
            content=fn(inner : view::View) -> Unit {
              let _ = <ui::Text in={inner} size={11.5} weight={600} color_by=>{0xFFFFFFFFL} text="Create" />
            },
            prominent=true,
            height=30.0,
            pad_x=10.0,
          )
        })
      },
      radius=lg::r_row,
      pad=8.0,
      secondary=true,
    )
  })
}
