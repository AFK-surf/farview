///| Farview Desktop Shell 2.0 Unified Liquid Glass Command Bar (`Cmd+K`, tag `"command_bar"`)
///| and Cross-Space Tab Search (`Cmd+Shift+A`, tag `"tab_search"`).
///|
///| Architectural invariants:
///| - Opus B3: Mounted in `shell_frame.pion` using EXACT tag matching (`ex.tag == "command_bar"`
///|   and `ex.tag == "tab_search"`), NEVER wildcard `matches_tag`.
///| - Single-layer Liquid Glass (`lg::liquid_dialog_shell_node`, radius 20pt -> inner rows 12pt -> badges 6pt).
///| - Zero Unicode pseudo-icons (100% `packages/icons` vector icons + accessible button names).
///| - 100% explicit `color_by` on every `ui::Text` node.
///| - Zero `alpha=0` clickable controls (hover/selected close button mounted via `.show(...)`).
///| - Zero double or dangling hairline dividers.

import "headless"
import "lg"
import "proto"
import "ui"
import "view"

pub struct CommandBarProps {
  pub field : ui::Field
  pub items : () -> Array[proto::CommandBarItem]
  pub selected : () -> Int
  pub on_query_change : (String) -> Unit
  pub on_step : (Int) -> Bool
  pub on_submit : (String) -> Unit
  pub on_execute : (proto::CommandBarItem) -> Unit
  pub on_close : () -> Unit
  pub on_row_view : Option[(view::View) -> Unit]
  pub on_clear_rows : Option[() -> Unit]
}

pub struct TabSearchProps {
  pub field : ui::Field
  pub results : () -> proto::TabSearchResult
  pub selected : () -> Int
  pub on_query_change : (String) -> Unit
  pub on_submit : () -> Unit
  pub on_activate : (proto::TabSearchItem) -> Unit
  pub on_close_tab : (String) -> Unit
  pub on_close : () -> Unit
}

fn cmd_space_tint(accent : Int64, dark : Bool) -> (Int64, Int64) {
  let rgb = accent & 0xFFFFFF00L
  if dark {
    (rgb | 0x26L, rgb | 0x55L)
  } else {
    (rgb | 0x18L, rgb | 0x38L)
  }
}

///| Maps every CommandBar item kind/id to a `packages/icons` vector icon name (Opus C3: zero proto Unicode glyphs).
pub fn command_bar_icon_name(item : proto::CommandBarItem) -> String {
  match item.kind {
    proto::CommandKind::SwitchTab => ICON_GLOBE
    proto::CommandKind::SwitchSpace => ICON_LAYERS
    proto::CommandKind::NewSpace => ICON_PLUS
    proto::CommandKind::NavigateUrl => ICON_ARROW_RIGHT
    proto::CommandKind::SearchWeb => ICON_SEARCH
    proto::CommandKind::Action =>
    if item.id == "toggle_bookmark" || item.id == "favorite_tab" {
      ICON_STAR
    } else if item.id == "toggle_bookmarks_bar" || item.id == "bookmarks" {
      ICON_BOOKMARK
    } else if item.id == "toggle_reader_mode" || item.id == "export_pdf" {
      ICON_READER
    } else if item.id == "toggle_boosts" || item.id == "space_theme" {
      ICON_SPARKLES
    } else if item.id == "search_all_tabs" {
      ICON_SEARCH
    } else if item.id == "capture_screenshot" {
      ICON_CAMERA
    } else if item.id == "pin_tab" {
      ICON_PIN
    } else if item.id == "global_media_controls" || item.id == "toggle_play_media" {
      ICON_PLAY
    } else if item.id == "toggle_mute_audio" {
      ICON_VOLUME_MUTE
    } else if item.id == "reopen_tab" || item.id == "recently_closed_tabs" {
      ICON_UNDO
    } else if item.id == "new_tab" || item.id == "new_space" {
      ICON_PLUS
    } else if item.id == "new_start_page" {
      ICON_GLOBE
    } else if item.id == "manage_spaces" || item.id == "saved_sessions" {
      ICON_LAYERS
    } else if item.id == "new_folder" {
      ICON_FOLDER
    } else if item.id == "today_clear" || item.id == "close_split_view" {
      ICON_CLOSE
    } else if item.id == "toggle_sidebar" {
      ICON_SIDEBAR
    } else if item.id == "toggle_split_view" || item.id == "swap_split_panes" {
      ICON_SPLIT
    } else if item.id == "toggle_peek" || item.id == "open_current_in_peek" {
      ICON_EXTERNAL
    } else if item.id == "site_info" || item.id == "inspect_cookies" {
      ICON_SHIELD
    } else if item.id == "toggle_devtools" {
      ICON_TERMINAL
    } else if item.id == "toggle_perf_hud" {
      ICON_ZAP
    } else if item.id == "downloads" {
      ICON_DOWNLOAD
    } else if item.id == "history" {
      ICON_CLOCK
    } else if item.id == "copy_url" {
      ICON_COPY
    } else if item.id == "open_settings" {
      ICON_SETTINGS
    } else if item.id == "toggle_dark_chrome" {
      ICON_MOON
    } else if item.id == "reload" {
      ICON_RELOAD
    } else {
      ICON_COMMAND
    }
  }
}

///| Builds the centered Liquid Glass Command Bar overlay (`Cmd+K`, exact tag `"command_bar"`).
pub fn build_command_bar_overlay(
  root : view::View,
  model : ShellModel,
  props : CommandBarProps,
) -> Unit {
  let is_open = fn() -> Bool {
    let ex = model.exclusive()
    (ex.active is ExclusiveKind::CommandBar) && ex.tag == "command_bar"
  }
  root.show(is_open, fn(cb_layer : view::View) -> Unit {
    match props.on_clear_rows {
      Some(cb) => cb()
      None => ()
    }
    let _ = cb_layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))

    // Full-window click-outside backdrop scrim
    let _ = headless::button(
      cb_layer,
      fn() { "Dismiss Command Bar" },
      fn(_v : view::View) -> Unit { (props.on_close)() },
      fn(bg : view::View, _btn : headless::Button) -> Unit {
        let _ = bg
        .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
        .ground(view::Live::By(fn() {
          if model.dark() { 0x05070C80L } else { 0x0F172A38L }
        }))
      },
    )

    let panel_w = fn() -> Double {
      let rw = root.window_w()
      let avail = if rw > 120.0 { rw - 32.0 } else { 560.0 }
      if avail < 560.0 { avail } else { 560.0 }
    }

    let _ = cb_layer.box(fn(anchor : view::View) -> Unit {
      let _ = anchor
      .over_at(view::Live::By(fn() {
        let rw = root.window_w()
        let pw = panel_w()
        let left = if rw > pw + 32.0 { (rw - pw) / 2.0 } else { 16.0 }
        (Some(left), Some(84.0), None, None)
      }))
      .width(view::Live::By(fn() { Some(panel_w()) }))

      let _ = lg::liquid_dialog_shell_node(
        anchor,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() { Some(panel_w()) }))
          .says(view::Live::Is(Some(view::said(view::Role::Region, label="Command Bar"))))

          panel.reacts(fn() { props.field.text() }, fn(q : String) -> Unit {
            if is_open() {
              (props.on_query_change)(q)
            }
          })

          // Top input row (`CommandBarField` key context for Up/Down/Escape)
          let _ = panel.box(fn(in_row : view::View) -> Unit {
            let _ = in_row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .height(view::Live::Is(Some(52.0)))
            .rigid()
            .gap(view::Live::Is(10.0))
            .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
            .key_context("CommandBarField")
            .on_action("commandbar.down", fn(_a : view::ActionAt) -> Bool { (props.on_step)(1) })
            .on_action("commandbar.up", fn(_a : view::ActionAt) -> Bool { (props.on_step)(-1) })
            .on_action("commandbar.escape", fn(_a : view::ActionAt) -> Bool {
              (props.on_close)()
              true
            })

            // Vector Command icon badge
            let _ = in_row.box(fn(ico : view::View) -> Unit {
              let _ = ico
              .width(view::Live::Is(Some(26.0)))
              .height(view::Live::Is(Some(26.0)))
              .rigid()
              .center()
              .radius(view::Live::Is(8.0))
              .ground(view::Live::By(fn() {
                if model.dark() { 0x0A84FF30L } else { 0x007AFF1AL }
              }))
              let _ = shell_icon(ico, ICON_COMMAND, size=14.0, color_by=fn() { lg::surface().accent })
            })

            // Single-line Command Bar input field
            let _ = in_row.box(fn(fw : view::View) -> Unit {
              let _ = fw
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .min_width(view::Live::Is(Some(0.0)))
              .height(view::Live::Is(Some(26.0)))
              .clips(view::Live::Is(true))
              .padding(view::Live::Is((0.0, 2.0, 0.0, 2.0)))
              fw.show(fn() { !model.dark() }, fn(fl : view::View) -> Unit {
                let _ = fl.fill()
                let _ = ui::field(
                  fl,
                  props.field,
                  placeholder="Type a URL, tab, space, or command...",
                  font_size=15.0,
                  color=0x1D1D1FFFL,
                  placeholder_color=0x8E8E93FFL,
                  caret_color=0x007AFFFFL,
                  max_lines=1,
                  enter_sends=true,
                  submitted=fn(t : String) -> Unit { (props.on_submit)(t) },
                )
              })
              fw.show(fn() { model.dark() }, fn(fd : view::View) -> Unit {
                let _ = fd.fill()
                let _ = ui::field(
                  fd,
                  props.field,
                  placeholder="Type a URL, tab, space, or command...",
                  font_size=15.0,
                  color=0xF5F5F7FFL,
                  placeholder_color=0x98989DFFL,
                  caret_color=0x0A84FFFFL,
                  max_lines=1,
                  enter_sends=true,
                  submitted=fn(t : String) -> Unit { (props.on_submit)(t) },
                )
              })
            })

            // Right ESC keycap hint
            let _ = in_row.box(fn(esc : view::View) -> Unit {
              let _ = esc
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              let _ = <ui::Text in={esc} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="ESC" />
            })
          })

          // Single hairline divider only when items exist
          panel.show(fn() { (props.items)().length() > 0 }, fn(sep : view::View) -> Unit {
            let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
          })

          // Up to COMMAND_BAR_MAX_ITEMS result rows (concentric R_inner = 20 - 8 = 12pt)
          let _ = panel.box(fn(list_box : view::View) -> Unit {
            let _ = list_box.padding(view::Live::Is((8.0, 8.0, 8.0, 8.0))).gap(view::Live::Is(2.0))
            let mut cslot = 0
            while cslot < proto::COMMAND_BAR_MAX_ITEMS {
              let cidx = cslot
              list_box.show(
                fn() { cidx < (props.items)().length() },
                fn(rwrap : view::View) -> Unit {
                  let get_item = fn() -> Option[proto::CommandBarItem] {
                    let list = (props.items)()
                    if cidx < list.length() { Some(list[cidx]) } else { None }
                  }
                  let title_fn = fn() -> String {
                    match get_item() {
                      Some(it) => it.title
                      None => ""
                    }
                  }
                  let _ = headless::button(
                    rwrap,
                    title_fn,
                    fn(_v : view::View) -> Unit {
                      match get_item() {
                        Some(it) => (props.on_execute)(it)
                        None => ()
                      }
                    },
                    fn(b : view::View, btn : headless::Button) -> Unit {
                      match props.on_row_view {
                        Some(cb) => cb(b)
                        None => ()
                      }
                      let is_sel = fn() -> Bool { (props.selected)() == cidx }
                      let _ = b
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .height(view::Live::Is(Some(42.0)))
                      .rigid()
                      .clips(view::Live::Is(true))
                      .gap(view::Live::Is(10.0))
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .radius(view::Live::Is(lg::concentric(20.0, 8.0)))
                      .ground(view::Live::By(fn() {
                        if is_sel() {
                          if model.dark() { 0x0A84FF38L } else { 0x007AFF20L }
                        } else if btn.hovered() || btn.pressed() {
                          lg::surface().row_hover
                        } else {
                          0x00000000L
                        }
                      }))

                      // Left 26x26 vector icon / Space dot tile (zero proto Unicode glyphs)
                      let _ = b.box(fn(ico : view::View) -> Unit {
                        let _ = ico
                        .width(view::Live::Is(Some(26.0)))
                        .height(view::Live::Is(Some(26.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(7.0))
                        .ground(view::Live::By(fn() {
                          if is_sel() {
                            if model.dark() { 0x0A84FF45L } else { 0x007AFF24L }
                          } else {
                            lg::surface().card_secondary
                          }
                        }))
                        let is_space_dot = fn() -> Bool {
                          match get_item() {
                            Some(it) => it.is_space && !(it.kind is proto::CommandKind::NewSpace)
                            None => false
                          }
                        }
                        ico.show(
                          is_space_dot,
                          fn(dot : view::View) -> Unit {
                            let _ = dot
                            .width(view::Live::Is(Some(9.0)))
                            .height(view::Live::Is(Some(9.0)))
                            .rigid()
                            .radius(view::Live::Is(4.5))
                            .ground(view::Live::By(fn() {
                              match get_item() {
                                Some(it) if it.accent != 0L => it.accent
                                _ => lg::surface().accent
                              }
                            }))
                          },
                        )
                        ico.show(
                          fn() { !is_space_dot() },
                          fn(ch : view::View) -> Unit {
                            let _ = shell_icon_by(
                              ch,
                              fn() {
                                match get_item() {
                                  Some(it) => command_bar_icon_name(it)
                                  None => ICON_COMMAND
                                }
                              },
                              size=13.5,
                              color_by=fn() {
                                if is_sel() { lg::surface().accent } else { lg::surface().ink_secondary }
                              },
                            )
                          },
                        )
                      })

                      // Primary title
                      let _ = b.box(fn(tw : view::View) -> Unit {
                        let _ = tw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                        let _ = <ui::Text
                          in={tw}
                          size={13.5}
                          weight={500}
                          color_by=>{lg::surface().ink}
                          text_by=>{title_fn()}
                        />.cut().allow_ellipsis(view::Live::Is(true))
                      })

                      // Trailing metadata: subtitle + category/space badge + shortcut
                      let _ = b.box(fn(meta : view::View) -> Unit {
                        let _ = meta
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .rigid()
                        .gap(view::Live::Is(6.0))
                        meta.show(
                          fn() {
                            match get_item() {
                              Some(it) => it.subtitle != ""
                              None => false
                            }
                          },
                          fn(sub : view::View) -> Unit {
                            let _ = sub.max_width(view::Live::Is(Some(164.0))).cut()
                            let _ = <ui::Text
                              in={sub}
                              size={11.5}
                              weight={400}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                match get_item() {
                                  Some(it) => it.subtitle
                                  None => ""
                                }
                              }
                            />.max_width(view::Live::Is(Some(164.0))).cut().allow_ellipsis(view::Live::Is(true))
                          },
                        )
                        meta.show(
                          fn() {
                            match get_item() {
                              Some(it) => it.badge != ""
                              None => false
                            }
                          },
                          fn(bdg : view::View) -> Unit {
                            let _ = bdg
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .height(view::Live::Is(Some(22.0)))
                            .rigid()
                            .gap(view::Live::Is(5.0))
                            .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                            .radius(view::Live::Is(6.0))
                            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                            bdg.show(
                              fn() {
                                match get_item() {
                                  Some(it) => it.is_tab && it.accent != 0L
                                  None => false
                                }
                              },
                              fn(sdot : view::View) -> Unit {
                                let _ = sdot
                                .width(view::Live::Is(Some(6.0)))
                                .height(view::Live::Is(Some(6.0)))
                                .rigid()
                                .radius(view::Live::Is(3.0))
                                .ground(view::Live::By(fn() {
                                  match get_item() {
                                    Some(it) => it.accent
                                    None => lg::surface().accent
                                  }
                                }))
                              },
                            )
                            let _ = <ui::Text
                              in={bdg}
                              size={10.5}
                              weight={500}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                match get_item() {
                                  Some(it) => it.badge
                                  None => ""
                                }
                              }
                            />
                          },
                        )
                        meta.show(
                          fn() {
                            match get_item() {
                              Some(it) => it.shortcut != ""
                              None => false
                            }
                          },
                          fn(sc : view::View) -> Unit {
                            let _ = sc
                            .height(view::Live::Is(Some(20.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                            .radius(view::Live::Is(5.0))
                            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                            let _ = <ui::Text
                              in={sc}
                              size={10.0}
                              weight={600}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                match get_item() {
                                  Some(it) => it.shortcut
                                  None => ""
                                }
                              }
                            />
                          },
                        )
                      })
                    },
                  )
                },
              )
              cslot += 1
            }
          })

          // Single hairline divider + uniform ASCII shortcut footer bar (matches TabSearch)
          let _ = panel.box(fn(fsep : view::View) -> Unit {
            let _ = fsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
          })
          let _ = panel.box(fn(ftr : view::View) -> Unit {
            let _ = ftr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .padding(view::Live::Is((14.0, 8.0, 14.0, 10.0)))
            .gap(view::Live::Is(14.0))

            let hint_item = fn(keycap : String, desc : String) -> Unit {
              let _ = ftr.box(fn(hi : view::View) -> Unit {
                let _ = hi.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid().gap(view::Live::Is(5.0))
                let _ = hi.box(fn(kc : view::View) -> Unit {
                  let _ = kc
                  .height(view::Live::Is(Some(18.0)))
                  .rigid()
                  .center()
                  .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                  .radius(view::Live::Is(4.5))
                  .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                  .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                  let _ = <ui::Text in={kc} size={10.0} weight={600} color_by=>{lg::surface().ink_secondary} text={keycap} />
                })
                let _ = <ui::Text in={hi} size={10.5} weight={400} color_by=>{lg::surface().ink_tertiary} text={desc} />
              })
            }

            hint_item("Up/Down", "Navigate")
            hint_item("Enter", "Run")
            let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
            hint_item("Esc", "Close")
          })
        },
        radius=20.0,
        solid=fn() { lg::surface().card },
        tint_light=0xFBFBFDECL,
      )
    })
  })
}

///| Builds the centered Liquid Glass Cross-Space Tab Search overlay (`Cmd+Shift+A`, exact tag `"tab_search"`).
pub fn build_tab_search_overlay(
  root : view::View,
  model : ShellModel,
  props : TabSearchProps,
) -> Unit {
  let is_open = fn() -> Bool {
    let ex = model.exclusive()
    (ex.active is ExclusiveKind::TabSearch) && ex.tag == "tab_search"
  }
  root.show(is_open, fn(layer : view::View) -> Unit {
    let _ = layer.over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0)))).center()

    // Click-outside dismiss backdrop
    let _ = headless::button(
      layer,
      fn() { "Dismiss Tab Search" },
      fn(_v : view::View) -> Unit { (props.on_close)() },
      fn(bg : view::View, _btn : headless::Button) -> Unit {
        let _ = bg
        .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
        .ground(view::Live::By(fn() {
          if model.dark() { 0x05070C90L } else { 0x0F172A38L }
        }))
      },
    )

    let panel_w = fn() -> Double {
      let rw = root.window_w()
      let avail = if rw > 120.0 { rw - 32.0 } else { 560.0 }
      if avail < 560.0 { avail } else { 560.0 }
    }

    let _ = lg::liquid_dialog_shell_node(
      layer,
      fn(card : view::View) -> Unit {
        let _ = card
        .width(view::Live::By(fn() { Some(panel_w()) }))
        .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
        .gap(view::Live::Is(8.0))
        .says(view::Live::Is(Some(view::said(view::Role::Region, label="Tab Search"))))

        card.reacts(fn() { props.field.text() }, fn(q : String) -> Unit {
          if is_open() {
            (props.on_query_change)(q)
          }
        })

        // 1. Top Search Row + Independent Open/Closed Count Capsules
        let _ = card.box(fn(srow : view::View) -> Unit {
          let _ = srow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(38.0)))
          .rigid()
          .padding(view::Live::Is((10.0, 0.0, 8.0, 0.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(lg::concentric(20.0, 10.0)))
          .ground(view::Live::By(fn() { lg::surface().card_secondary }))
          .edge(view::Live::By(fn() {
            if props.field.focused() {
              (1.2, lg::surface().accent)
            } else {
              (lg::hairline_w, lg::surface().separator)
            }
          }))

          let _ = shell_icon(
            srow,
            ICON_SEARCH,
            size=15.0,
            color_by=fn() {
              if props.field.focused() { lg::surface().accent } else { lg::surface().ink_secondary }
            },
          )

          let _ = srow.box(fn(fw : view::View) -> Unit {
            let _ = fw
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .height(view::Live::Is(Some(28.0)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            fw.show(fn() { !model.dark() }, fn(fl : view::View) -> Unit {
              let _ = fl.fill()
              let _ = ui::field(
                fl,
                props.field,
                placeholder="Search open & recently closed tabs...",
                font_size=13.5,
                color=0x1D1D1FFFL,
                placeholder_color=0x8E8E93FFL,
                caret_color=0x007AFFFFL,
                max_lines=1,
                enter_sends=true,
                submitted=fn(_v : String) -> Unit { (props.on_submit)() },
              )
            })
            fw.show(fn() { model.dark() }, fn(fd : view::View) -> Unit {
              let _ = fd.fill()
              let _ = ui::field(
                fd,
                props.field,
                placeholder="Search open & recently closed tabs...",
                font_size=13.5,
                color=0xF5F5F7FFL,
                placeholder_color=0x98989DFFL,
                caret_color=0x0A84FFFFL,
                max_lines=1,
                enter_sends=true,
                submitted=fn(_v : String) -> Unit { (props.on_submit)() },
              )
            })
          })

          // Independent Open count capsule
          let _ = srow.box(fn(open_pill : view::View) -> Unit {
            let _ = open_pill
            .height(view::Live::Is(Some(22.0)))
            .rigid()
            .center()
            .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() {
              if model.dark() { 0x0A84FF2EL } else { 0x007AFF18L }
            }))
            let _ = <ui::Text
              in={open_pill}
              size={11.0}
              weight={600}
              color_by=>{lg::surface().accent}
              text_by=>{(props.results)().total_open.to_string() + " Open"}
            />
          })

          // Independent Closed count capsule
          let _ = srow.box(fn(closed_pill : view::View) -> Unit {
            let _ = closed_pill
            .height(view::Live::Is(Some(22.0)))
            .rigid()
            .center()
            .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() { lg::surface().card }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
            let _ = <ui::Text
              in={closed_pill}
              size={11.0}
              weight={500}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{(props.results)().total_closed.to_string() + " Closed"}
            />
          })
        })

        // Single hairline divider below search row
        let _ = card.box(fn(sep : view::View) -> Unit {
          let _ = sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
        })

        // 2. OPEN TABS Group
        card.show(fn() { (props.results)().open_items.length() > 0 }, fn(osec : view::View) -> Unit {
          let _ = osec.gap(view::Live::Is(3.0))
          let _ = osec.box(fn(ohdr : view::View) -> Unit {
            let _ = ohdr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
            let _ = <ui::Text in={ohdr} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="OPEN TABS" />
            let _ = <ui::Text
              in={ohdr}
              size={10.5}
              weight={400}
              color_by=>{lg::surface().ink_tertiary}
              text_by=>{
                let n = (props.results)().total_open
                if n == 1 { "1 tab across Spaces" } else { n.to_string() + " tabs across Spaces" }
              }
            />
          })

          let mut slot = 0
          while slot < proto::TAB_SEARCH_MAX_OPEN {
            let idx = slot
            osec.show(fn() { idx < (props.results)().open_items.length() }, fn(row_slot : view::View) -> Unit {
              let is_selected = fn() -> Bool { (props.selected)() == idx }
              let get_item = fn() -> Option[proto::TabSearchItem] {
                let items = (props.results)().open_items
                if idx < items.length() { Some(items[idx]) } else { None }
              }
              let _ = row_slot
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(46.0)))
              .rigid()
              .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
              .gap(view::Live::Is(8.0))
              .radius(view::Live::Is(10.0))
              .ground(view::Live::By(fn() {
                if is_selected() {
                  if model.dark() { 0x0A84FF38L } else { 0x007AFF20L }
                } else if row_slot.pointed() {
                  lg::surface().row_hover
                } else {
                  0x00000000L
                }
              }))

              let _ = headless::button(
                row_slot,
                fn() {
                  match get_item() {
                    Some(it) => "Switch to " + it.title
                    None => "Switch Tab"
                  }
                },
                fn(_v : view::View) -> Unit {
                  match get_item() {
                    Some(it) => (props.on_activate)(it)
                    None => ()
                  }
                },
                fn(main_b : view::View, _btn : headless::Button) -> Unit {
                  let _ = main_b
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(42.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(10.0))

                  // Monogram badge
                  let _ = main_b.box(fn(mono : view::View) -> Unit {
                    let _ = mono
                    .width(view::Live::Is(Some(26.0)))
                    .height(view::Live::Is(Some(26.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() {
                      match get_item() {
                        Some(it) => cmd_space_tint(it.space_accent_rgba, model.dark()).0
                        None => lg::surface().card_secondary
                      }
                    }))
                    .edge(view::Live::By(fn() {
                      match get_item() {
                        Some(it) => (lg::hairline_w, cmd_space_tint(it.space_accent_rgba, model.dark()).1)
                        None => (lg::hairline_w, lg::surface().separator)
                      }
                    }))
                    let _ = <ui::Text
                      in={mono}
                      size={12.0}
                      weight={700}
                      color_by=>{
                        match get_item() {
                          Some(it) => it.space_accent_rgba
                          None => lg::surface().accent
                        }
                      }
                      text_by=>{
                        match get_item() {
                          Some(it) => proto::omnibox_initial_letter(it.url, it.title)
                          None => "T"
                        }
                      }
                    />
                  })

                  // Title + Host/Badges stack
                  let _ = main_b.box(fn(meta : view::View) -> Unit {
                    let _ = meta
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .gap(view::Live::Is(2.0))
                    .cut()

                    let _ = <ui::Text
                      in={meta}
                      size={13.0}
                      weight={500}
                      color_by=>{lg::surface().ink}
                      text_by=>{
                        match get_item() {
                          Some(it) => it.title
                          None => ""
                        }
                      }
                    />.cut().allow_ellipsis(view::Live::Is(true))

                    let _ = meta.box(fn(srow2 : view::View) -> Unit {
                      let _ = srow2
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .gap(view::Live::Is(6.0))
                      let _ = srow2.box(fn(hl : view::View) -> Unit {
                        let _ = hl.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).cut()
                        let _ = <ui::Text
                          in={hl}
                          size={11.0}
                          weight={400}
                          color_by=>{lg::surface().ink_secondary}
                          text_by=>{
                            match get_item() {
                              Some(it) => it.display_host
                              None => ""
                            }
                          }
                        />.cut().allow_ellipsis(view::Live::Is(true))
                      })
                      srow2.show(
                        fn() {
                          match get_item() {
                            Some(it) => it.is_active
                            None => false
                          }
                        },
                        fn(act_b : view::View) -> Unit {
                          let _ = act_b
                          .rigid()
                          .padding(view::Live::Is((5.0, 1.0, 5.0, 1.0)))
                          .radius(view::Live::Is(4.0))
                          .ground(view::Live::By(fn() {
                            if model.dark() { 0x0A84FF30L } else { 0x007AFF1AL }
                          }))
                          let _ = <ui::Text in={act_b} size={9.5} weight={600} color_by=>{lg::surface().accent} text="Current" />
                        },
                      )
                      srow2.show(
                        fn() {
                          match get_item() {
                            Some(it) => it.is_playing_audio
                            None => false
                          }
                        },
                        fn(pl_b : view::View) -> Unit {
                          let _ = pl_b
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .rigid()
                          .gap(view::Live::Is(4.0))
                          .padding(view::Live::Is((5.0, 1.0, 5.0, 1.0)))
                          .radius(view::Live::Is(4.0))
                          .ground(view::Live::By(fn() {
                            if model.dark() { 0x132A21FFL } else { 0xDCFCE7FFL }
                          }))
                          let _ = pl_b.box(fn(pd : view::View) -> Unit {
                            let _ = pd.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).rigid().radius(view::Live::Is(2.5)).ground(view::Live::Is(0x10B981FFL))
                          })
                          let _ = <ui::Text
                            in={pl_b}
                            size={9.5}
                            weight={600}
                            color_by=>{if model.dark() { 0x6EE7B7FFL } else { 0x15803DFFL }}
                            text="Playing"
                          />
                        },
                      )
                      srow2.show(
                        fn() {
                          match get_item() {
                            Some(it) => (it.is_pinned || it.is_favorite) && !it.is_playing_audio
                            None => false
                          }
                        },
                        fn(pn_b : view::View) -> Unit {
                          let _ = pn_b
                          .rigid()
                          .padding(view::Live::Is((5.0, 1.0, 5.0, 1.0)))
                          .radius(view::Live::Is(4.0))
                          .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                          .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                          let _ = <ui::Text
                            in={pn_b}
                            size={9.5}
                            weight={500}
                            color_by=>{lg::surface().ink_secondary}
                            text_by=>{
                              match get_item() {
                                Some(it) => if it.is_favorite { "Favorite" } else { "Pinned" }
                                None => "Pinned"
                              }
                            }
                          />
                        },
                      )
                    })
                  })

                  // Space colored pill
                  let _ = main_b.box(fn(sp_pill : view::View) -> Unit {
                    let _ = sp_pill
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .height(view::Live::Is(Some(22.0)))
                    .rigid()
                    .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                    .gap(view::Live::Is(5.0))
                    .radius(view::Live::Is(6.0))
                    .ground(view::Live::By(fn() {
                      match get_item() {
                        Some(it) => cmd_space_tint(it.space_accent_rgba, model.dark()).0
                        None => lg::surface().card_secondary
                      }
                    }))
                    let _ = sp_pill.box(fn(sd : view::View) -> Unit {
                      let _ = sd
                      .width(view::Live::Is(Some(6.0)))
                      .height(view::Live::Is(Some(6.0)))
                      .rigid()
                      .radius(view::Live::Is(3.0))
                      .ground(view::Live::By(fn() {
                        match get_item() {
                          Some(it) => it.space_accent_rgba
                          None => lg::surface().accent
                        }
                      }))
                    })
                    let _ = <ui::Text
                      in={sp_pill}
                      size={10.5}
                      weight={500}
                      color_by=>{lg::surface().ink}
                      text_by=>{
                        match get_item() {
                          Some(it) => it.space_name
                          None => ""
                        }
                      }
                    />
                  })
                },
              )

              // Inline Close button mounted via `.show(...)` (NEVER alpha=0 clickable!)
              row_slot.show(
                fn() { row_slot.pointed() || is_selected() },
                fn(x_wrap : view::View) -> Unit {
                  let _ = x_wrap.rigid()
                  let _ = headless::button(
                    x_wrap,
                    fn() { "Close Tab" },
                    fn(_v : view::View) -> Unit {
                      match get_item() {
                        Some(it) => (props.on_close_tab)(it.id)
                        None => ()
                      }
                    },
                    fn(xb : view::View, xbtn : headless::Button) -> Unit {
                      let _ = xb
                      .width(view::Live::Is(Some(24.0)))
                      .height(view::Live::Is(Some(24.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(6.0))
                      .ground(view::Live::By(fn() {
                        if xbtn.hovered() || xbtn.pressed() { lg::surface().row_hover } else { 0x00000000L }
                      }))
                      let _ = shell_icon(xb, ICON_CLOSE, size=12.0, color_by=fn() { lg::surface().ink_secondary })
                    },
                  )
                },
              )
            })
            slot += 1
          }
        })

        // Conditional single hairline divider ONLY when both Open & Recently Closed sections exist
        card.show(
          fn() {
            let r = (props.results)()
            r.open_items.length() > 0 && r.closed_items.length() > 0
          },
          fn(mid_sep : view::View) -> Unit {
            let _ = mid_sep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
          },
        )

        // 3. RECENTLY CLOSED Group
        card.show(fn() { (props.results)().closed_items.length() > 0 }, fn(csec : view::View) -> Unit {
          let _ = csec.gap(view::Live::Is(3.0))
          let _ = csec.box(fn(chdr : view::View) -> Unit {
            let _ = chdr.padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
            let _ = <ui::Text in={chdr} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="RECENTLY CLOSED" />
          })

          let mut cslot = 0
          while cslot < proto::TAB_SEARCH_MAX_CLOSED {
            let cidx = cslot
            csec.show(fn() { cidx < (props.results)().closed_items.length() }, fn(crow : view::View) -> Unit {
              let flat_idx = fn() -> Int { (props.results)().open_items.length() + cidx }
              let is_selected = fn() -> Bool { (props.selected)() == flat_idx() }
              let get_item = fn() -> Option[proto::TabSearchItem] {
                let items = (props.results)().closed_items
                if cidx < items.length() { Some(items[cidx]) } else { None }
              }
              let _ = crow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .height(view::Live::Is(Some(42.0)))
              .rigid()
              .padding(view::Live::Is((8.0, 0.0, 6.0, 0.0)))
              .gap(view::Live::Is(8.0))
              .radius(view::Live::Is(10.0))
              .ground(view::Live::By(fn() {
                if is_selected() {
                  if model.dark() { 0x0A84FF38L } else { 0x007AFF20L }
                } else if crow.pointed() {
                  lg::surface().row_hover
                } else {
                  0x00000000L
                }
              }))

              // Vector Undo icon badge
              let _ = crow.box(fn(ri : view::View) -> Unit {
                let _ = ri
                .width(view::Live::Is(Some(24.0)))
                .height(view::Live::Is(Some(24.0)))
                .rigid()
                .center()
                .radius(view::Live::Is(6.0))
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                let _ = shell_icon(ri, ICON_UNDO, size=12.5, color_by=fn() { lg::surface().ink_secondary })
              })

              // Title + Host stack
              let _ = crow.box(fn(cm : view::View) -> Unit {
                let _ = cm
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(0.0)))
                .gap(view::Live::Is(1.0))
                .cut()
                let _ = <ui::Text
                  in={cm}
                  size={12.5}
                  weight={500}
                  color_by=>{lg::surface().ink}
                  text_by=>{
                    match get_item() {
                      Some(it) => it.title
                      None => ""
                    }
                  }
                />.cut().allow_ellipsis(view::Live::Is(true))
                let _ = <ui::Text
                  in={cm}
                  size={10.5}
                  weight={400}
                  color_by=>{lg::surface().ink_secondary}
                  text_by=>{
                    match get_item() {
                      Some(it) => it.display_host
                      None => ""
                    }
                  }
                />.cut().allow_ellipsis(view::Live::Is(true))
              })

              // Space pill
              let _ = crow.box(fn(csp : view::View) -> Unit {
                let _ = csp
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(20.0)))
                .rigid()
                .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                .gap(view::Live::Is(4.0))
                .radius(view::Live::Is(5.0))
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                let _ = csp.box(fn(sd : view::View) -> Unit {
                  let _ = sd
                  .width(view::Live::Is(Some(5.0)))
                  .height(view::Live::Is(Some(5.0)))
                  .rigid()
                  .radius(view::Live::Is(2.5))
                  .ground(view::Live::By(fn() {
                    match get_item() {
                      Some(it) => it.space_accent_rgba
                      None => lg::surface().ink_tertiary
                    }
                  }))
                })
                let _ = <ui::Text
                  in={csp}
                  size={10.0}
                  weight={500}
                  color_by=>{lg::surface().ink_secondary}
                  text_by=>{
                    match get_item() {
                      Some(it) => it.space_name
                      None => ""
                    }
                  }
                />
              })

              // One-click Reopen button
              let _ = lg::liquid_button_node(
                crow,
                fn() { "Reopen Closed Tab" },
                fn() {
                  match get_item() {
                    Some(it) => (props.on_activate)(it)
                    None => ()
                  }
                },
                content=fn(inner : view::View) -> Unit {
                  let _ = <ui::Text in={inner} size={11.0} weight={600} color_by=>{lg::surface().ink} text="Reopen" />
                },
                flat=true,
                height=24.0,
                pad_x=9.0,
              )
            })
            cslot += 1
          }
        })

        // Empty state when no tabs match query
        card.show(fn() { (props.results)().total_count() == 0 }, fn(empty_box : view::View) -> Unit {
          let _ = empty_box
          .height(view::Live::Is(Some(80.0)))
          .center()
          .radius(view::Live::Is(10.0))
          .ground(view::Live::By(fn() { lg::surface().card_secondary }))
          let _ = <ui::Text
            in={empty_box}
            size={12.5}
            weight={400}
            color_by=>{lg::surface().ink_secondary}
            text="No open or recently closed tabs match your search"
          />
        })

        // Single hairline divider before footer hints
        let _ = card.box(fn(fsep : view::View) -> Unit {
          let _ = fsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
        })

        // Footer shortcut hints (ASCII keycaps, zero Unicode glyphs, zero middle-dot concatenation)
        let _ = card.box(fn(ftr : view::View) -> Unit {
          let _ = ftr
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .padding(view::Live::Is((4.0, 2.0, 4.0, 0.0)))
          .gap(view::Live::Is(14.0))

          let hint_item = fn(keycap : String, desc : String) -> Unit {
            let _ = ftr.box(fn(hi : view::View) -> Unit {
              let _ = hi.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid().gap(view::Live::Is(5.0))
              let _ = hi.box(fn(kc : view::View) -> Unit {
                let _ = kc
                .height(view::Live::Is(Some(18.0)))
                .rigid()
                .center()
                .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                .radius(view::Live::Is(4.5))
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                let _ = <ui::Text in={kc} size={10.0} weight={600} color_by=>{lg::surface().ink_secondary} text={keycap} />
              })
              let _ = <ui::Text in={hi} size={10.5} weight={400} color_by=>{lg::surface().ink_tertiary} text={desc} />
            })
          }

          hint_item("Up/Down", "Select")
          hint_item("Enter", "Switch or Reopen")
          let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
          hint_item("Esc", "Close")
        })
      },
      radius=20.0,
      solid=fn() { lg::surface().card },
      tint_light=0xFBFBFDECL,
    )
  })
}
