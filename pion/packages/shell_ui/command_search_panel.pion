///| Command Bar (`Cmd+K`, tag `"command_bar"`) and Tab Search (`Cmd+Shift+A`, tag `"tab_search"`).
///|
///| Both are built from the one palette shared with the address palette in `shell_frame.pion`
///| (`shell_palette_panel`, `shell_palette_w` / `shell_palette_left` / `shell_palette_top`, `cmd_field_row`):
///| one layer of `lg` glass (radius 20, solid card, SP_6 in), `SHELL_PALETTE_W` wide and centered over the page
///| column, no dimming, a 48pt frameless field, then keyed rows (min 40pt, 24pt tile, title + quiet subtitle on
///| one line) grouped under quiet sentence-case captions, and a footer of keycap hints.
///|
///| Invariants kept from Shell 2:
///| - Mounted only on the EXACT tag (`ex.tag == "command_bar"` / `"tab_search"`), never `matches_tag`.
///| - Modal `headless::dialog`: Tab/Shift+Tab stay inside, outside click closes without reaching the page,
///|   the first Escape during IME composition only cancels the preedit.
///| - No Unicode pseudo-icons from `proto` (`monogram`): every glyph is a `packages/icons` vector.
///| - Hover-only controls are mounted with `.show(...)`, never hidden with `alpha=0`.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

pub struct CommandBarProps {
  pub field : ui::Field
  pub items : () -> Array[proto::CommandBarItem]
  pub selected : () -> Int
  pub on_query_change : (String) -> Unit
  pub on_step : (Int) -> Bool
  pub on_submit : (String) -> Unit
  pub on_execute : (proto::CommandBarItem) -> Unit
  pub on_close : () -> Unit
  pub on_row_view : Option[(view::View) -> Unit]
  pub on_clear_rows : Option[() -> Unit]
}

pub struct TabSearchProps {
  pub field : ui::Field
  pub results : () -> proto::TabSearchResult
  pub selected : () -> Int
  pub on_query_change : (String) -> Unit
  pub on_submit : () -> Unit
  pub on_activate : (proto::TabSearchItem) -> Unit
  pub on_close_tab : (String) -> Unit
  pub on_close : () -> Unit
}

fn cmd_ime_composing(field : ui::Field) -> Bool {
  if field.composing() {
    return true
  }
  match ui::focused_field_now() {
    Some(f) => f.composing()
    None => false
  }
}

///| Glyphs only this panel needs (`packages/icons` names), so neighbouring commands never share a tile:
///| the bookmarks bar is a strip, swapping panes is a pair of arrows, closing a split is one pane, sweeping
///| Today archives.
let CMD_ICON_BAR : String = "menu"
let CMD_ICON_SWAP : String = "chevrons-up-down"
let CMD_ICON_SINGLE_PANE : String = "square"
let CMD_ICON_ARCHIVE : String = "archive"

///| Maps every CommandBar item kind/id to a `packages/icons` vector icon name (never the proto Unicode monogram).
pub fn command_bar_icon_name(item : proto::CommandBarItem) -> String {
  match item.kind {
    proto::CommandKind::SwitchTab => "globe-filled"
    proto::CommandKind::SwitchSpace => "layers-filled"
    proto::CommandKind::NewSpace => ICON_PLUS
    proto::CommandKind::NavigateUrl => ICON_ARROW_RIGHT
    proto::CommandKind::SearchWeb => "search-filled"
    proto::CommandKind::Action =>
    if item.id == "toggle_bookmark" || item.id == "favorite_tab" {
      "star-filled"
    } else if item.id == "bookmarks" {
      "bookmark-filled"
    } else if item.id == "toggle_bookmarks_bar" {
      CMD_ICON_BAR
    } else if item.id == "toggle_reader_mode" || item.id == "export_pdf" {
      "file-filled"
    } else if item.id == "toggle_boosts" || item.id == "space_theme" {
      "sparkles-filled"
    } else if item.id == "search_all_tabs" {
      "search-filled"
    } else if item.id == "capture_screenshot" {
      "camera-filled"
    } else if item.id == "pin_tab" {
      ICON_PIN
    } else if item.id == "global_media_controls" || item.id == "toggle_play_media" {
      ICON_PLAY
    } else if item.id == "toggle_mute_audio" {
      ICON_VOLUME_MUTE
    } else if item.id == "reopen_tab" || item.id == "recently_closed_tabs" {
      ICON_UNDO
    } else if item.id == "new_tab" || item.id == "new_space" {
      ICON_PLUS
    } else if item.id == "new_start_page" {
      "globe-filled"
    } else if item.id == "manage_spaces" || item.id == "saved_sessions" {
      "layers-filled"
    } else if item.id == "new_folder" {
      "folder-filled"
    } else if item.id == "today_clear" {
      CMD_ICON_ARCHIVE
    } else if item.id == "close_split_view" {
      CMD_ICON_SINGLE_PANE
    } else if item.id == "toggle_sidebar" {
      "sidebar-filled"
    } else if item.id == "toggle_split_view" {
      ICON_SPLIT
    } else if item.id == "swap_split_panes" {
      CMD_ICON_SWAP
    } else if item.id == "toggle_peek" || item.id == "open_current_in_peek" {
      "window-filled"
    } else if item.id == "site_info" || item.id == "inspect_cookies" {
      "shield-filled"
    } else if item.id == "toggle_devtools" {
      "code-filled"
    } else if item.id == "toggle_perf_hud" {
      "zap-filled"
    } else if item.id == "downloads" {
      "inbox-filled"
    } else if item.id == "library" {
      "layout-grid"
    } else if item.id == "history" {
      "clock-filled"
    } else if item.id == "copy_url" {
      "clipboard-filled"
    } else if item.id == "open_settings" {
      "settings-filled"
    } else if item.id == "toggle_dark_chrome" {
      "moon-filled"
    } else if item.id == "reload" {
      ICON_RELOAD
    } else {
      "keyboard-filled"
    }
  }
}

///| Tile ground for a Command Bar item: the neutral tile, or a Space's own accent on its row.
fn command_bar_tile_color(item : proto::CommandBarItem) -> Int64 {
  // Monochrome (DESIGN.md section 3): a command is told by its glyph and title. The one color kept is a Space's
  // own accent on a Space row (the color the person chose for it).
  match item.kind {
    proto::CommandKind::SwitchSpace if item.accent != 0L => item.accent
    _ => mono_tile_ground()
  }
}

///| The trailing action a Command Bar row names (Arc's "Switch to Tab" + arrow pill); "" for commands, which show
///| their shortcut instead.
fn command_bar_action_label(item : proto::CommandBarItem) -> String {
  match item.kind {
    proto::CommandKind::SwitchTab => "Switch to Tab"
    proto::CommandKind::SwitchSpace => if item.badge == "Active" { "" } else { "Switch to Space" }
    proto::CommandKind::NewSpace => ""
    proto::CommandKind::NavigateUrl => "Open"
    proto::CommandKind::SearchWeb => "Search"
    proto::CommandKind::Action => ""
  }
}

///| Section caption for a Command Bar item (rows arrive ranked and grouped by kind).
fn command_bar_section(item : proto::CommandBarItem) -> String {
  match item.kind {
    proto::CommandKind::SwitchTab => "Tabs"
    proto::CommandKind::SwitchSpace | proto::CommandKind::NewSpace => "Spaces"
    proto::CommandKind::Action => "Commands"
    proto::CommandKind::NavigateUrl | proto::CommandKind::SearchWeb => "Web"
  }
}

///| Splits a shortcut label into its keys: `Ctrl+Shift+A` -> `Ctrl` `Shift` `A`, `⇧⌘A` -> `⇧` `⌘` `A`.
fn command_bar_shortcut_keys(s : String) -> Array[String] {
  let out : Array[String] = []
  if s == "" {
    return out
  }
  if s.contains("+") && s.length() > 1 {
    let mut start = 0
    let mut i = 0
    while i < s.length() {
      if s.code_unit_at(i).to_int() == 0x2B && i > start {
        out.push(s.slice(start, i))
        start = i + 1
      }
      i += 1
    }
    if start < s.length() {
      out.push(s.slice(start, s.length()))
    }
    return out
  }
  // One key per character (UTF-8: a lead byte and its continuation bytes stay together).
  let mut j = 0
  while j < s.length() {
    let c = s.code_unit_at(j).to_int()
    let n = if c >= 0xF0 { 4 } else if c >= 0xE0 { 3 } else if c >= 0xC0 { 2 } else { 1 }
    let end = if j + n > s.length() { s.length() } else { j + n }
    out.push(s.slice(j, end))
    j = end
  }
  out
}

///| The bare host of a display URL (`github.com/rust-lang/rust/pulls` -> `github.com`): rows name the site,
///| the path only crowds out the title.
fn cmd_host(display : String) -> String {
  shell_url_parts(display).0
}

///| The palette colors this panel shares with the address command palette (`shell_frame.pion`: selected row
///| and light tint). They are named here once; `shell_style.pion` is outside this area, so moving them into
///| a shared token is left to its owner.
let CMD_SELECTED_DARK : Int64 = 0x0A84FF4DL
let CMD_SELECTED_LIGHT : Int64 = 0x007AFF26L
let CMD_TINT_LIGHT : Int64 = 0xFBFBFDF0L

///| Selected-row fill, the same blue wash as the address palette.
fn cmd_selected_fill(dark : Bool) -> Int64 {
  if dark { CMD_SELECTED_DARK } else { CMD_SELECTED_LIGHT }
}

///| A glyph tile whose glyph and color follow the row's data (slots are reused as results change).
fn cmd_glyph_tile_by(parent : view::View, icon_by : () -> String, color_by : () -> Int64) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(SP_24)))
    .height(view::Live::Is(Some(SP_24)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(SP_24)))
    .ground(view::Live::By(color_by))
    .points(view::Live::Is(false))
    .center()
    // Ink on the neutral tile, white on a Space's color.
    let _ = shell_icon_by(tile, icon_by, size=shell_tile_glyph(SP_24), color_by=fn() {
      if color_by() == mono_tile_ground() { lg::surface().ink } else { 0xFFFFFFFFL }
    })
  })
}

///| One keycap pill (`⌘`, `Shift`, `K`).
fn cmd_keycap(parent : view::View, text_by : () -> String) -> Unit {
  let _ = parent.box(fn(kc : view::View) -> Unit {
    let _ = kc
    .height(view::Live::Is(Some(SP_20)))
    .min_width(view::Live::Is(Some(SP_20)))
    .rigid()
    .center()
    .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
    .radius(view::Live::Is(SP_4))
    .ground(view::Live::By(fn() { lg::surface().card_secondary }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
    let _ = <ui::Text in={kc} size={TX_CAPTION} weight={500} color_by=>{lg::surface().ink_secondary} text_by=>{text_by()} />
  })
}

///| A keycap holding a vector glyph (arrow keys).
fn cmd_icon_keycap(parent : view::View, icon_name : String) -> Unit {
  let _ = parent.box(fn(kc : view::View) -> Unit {
    let _ = kc
    .width(view::Live::Is(Some(SP_20)))
    .height(view::Live::Is(Some(SP_20)))
    .rigid()
    .center()
    .radius(view::Live::Is(SP_4))
    .ground(view::Live::By(fn() { lg::surface().card_secondary }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
    let _ = shell_icon(kc, icon_name, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
  })
}

///| A run of keycaps for a shortcut label that can change (up to 4 keys).
///| Mounted only when there is a shortcut, so a row without one gets no trailing gap.
fn cmd_shortcut_keycaps(parent : view::View, shortcut_by : () -> String) -> Unit {
  parent.show(fn() { shortcut_by() != "" }, fn(keys : view::View) -> Unit {
    let _ = keys.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2)).rigid()
    let mut k = 0
    while k < 4 {
      let ki = k
      keys.show(fn() { ki < command_bar_shortcut_keys(shortcut_by()).length() }, fn(slot : view::View) -> Unit {
        let _ = slot.rigid()
        cmd_keycap(slot, fn() {
          let parts = command_bar_shortcut_keys(shortcut_by())
          if ki < parts.length() { parts[ki] } else { "" }
        })
      })
      k += 1
    }
  })
}

///| Hairline between the field, the results and the footer (inset like the address palette's).
fn cmd_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((SP_6, SP_4, SP_6, SP_4)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| Quiet sentence-case caption above a group of rows, aligned with the row tiles.
fn cmd_caption(parent : view::View, text_by : () -> String) -> Unit {
  let _ = parent.box(fn(cap : view::View) -> Unit {
    let _ = cap.padding(view::Live::Is((SP_8, SP_8, SP_8, SP_4))).rigid()
    let _ = <ui::Text in={cap} size={TX_CAPTION} weight={500} color_by=>{lg::surface().ink_secondary} text_by=>{text_by()} />
  })
}

///| One footer hint: keycaps then what they do. Keys `"up"` / `"down"` draw arrow glyphs.
fn cmd_hint(parent : view::View, keys : Array[String], desc : String) -> Unit {
  let _ = parent.box(fn(hi : view::View) -> Unit {
    let _ = hi.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid().gap(view::Live::Is(SP_6))
    let _ = hi.box(fn(kr : view::View) -> Unit {
      let _ = kr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid().gap(view::Live::Is(SP_2))
      for key in keys {
        if key == "up" {
          cmd_icon_keycap(kr, ICON_CHEVRON_UP)
        } else if key == "down" {
          cmd_icon_keycap(kr, ICON_CHEVRON_DOWN)
        } else {
          let label = key
          cmd_keycap(kr, fn() { label })
        }
      }
    })
    let _ = <ui::Text in={hi} size={TX_CAPTION} color_by=>{lg::surface().ink_secondary} text={desc} />
  })
}

///| Footer row of keycap hints; the last hint sits at the trailing edge.
///| `lead_when` hides the leading hints when there is nothing to move to or act on.
fn cmd_footer(
  parent : view::View,
  lead : Array[(Array[String], String)],
  trail : (Array[String], String),
  lead_when~ : () -> Bool = fn() { true },
) -> Unit {
  let _ = parent.box(fn(ftr : view::View) -> Unit {
    let _ = ftr
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_32)))
    .rigid()
    .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
    .gap(view::Live::Is(SP_16))
    for h in lead {
      let hint = h
      ftr.show(lead_when, fn(hs : view::View) -> Unit {
        let _ = hs.rigid()
        cmd_hint(hs, hint.0, hint.1)
      })
    }
    let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
    cmd_hint(ftr, trail.0, trail.1)
  })
}

///| The 48pt frameless field row of every palette: leading glyph (`lead` draws a live one instead), single-line
///| field (colors follow the theme), and, with `on_clear`, a flat Clear button while there is text.
fn cmd_field_row(
  parent : view::View,
  field : ui::Field,
  icon_name : String,
  placeholder : String,
  submitted : (String) -> Unit,
  setup : (view::View) -> Unit,
  lead? : (view::View) -> Unit,
  edited? : (String) -> Unit,
  on_clear? : () -> Unit,
  label~ : String = "",
) -> Unit {
  let _ = parent.box(fn(in_row : view::View) -> Unit {
    let _ = in_row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_48)))
    .rigid()
    .gap(view::Live::Is(SP_12))
    .padding(view::Live::Is((SP_12, SP_0, if on_clear is None { SP_12 } else { SP_8 }, SP_0)))
    setup(in_row)
    match lead {
      Some(f) => {
        let _ = in_row.box(fn(l : view::View) -> Unit {
          let _ = l.rigid().center()
          f(l)
        })
      }
      None => {
        let _ = shell_icon(in_row, icon_name, size=IC_MD, color_by=fn() { lg::surface().ink_secondary })
      }
    }
    let _ = in_row.box(fn(fw : view::View) -> Unit {
      let _ = fw
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_0)))
      .height(view::Live::Is(Some(SP_24)))
      .clips(view::Live::Is(true))
      let _ = ui::field(
        fw,
        field,
        placeholder=placeholder,
        font_size=TX_CALLOUT,
        max_lines=1,
        enter_sends=true,
        colors_by=fn() { (lg::surface().ink, lg::surface().ink_tertiary, lg::surface().accent) },
        submitted=submitted,
        edited?=edited,
        label=label,
      )
    })
    match on_clear {
      Some(clear) =>
      in_row.show(fn() { field.text() != "" }, fn(cw : view::View) -> Unit {
        let _ = cw.rigid()
        let _ = shell_panel_icon_btn(cw, fn() { "Clear" }, ICON_CLOSE, fn() {
          // As lg's clear button: the press took the focus to Clear, which leaves with the text, so hand the
          // focus back to the field (typing, arrows and Escape all need it there).
          field.set("")
          clear()
          field.focus()
        })
      })
      None => ()
    }
  })
}

///| Title and quiet subtitle on one line; the subtitle gives way first, and is left out when the panel is
///| narrow (a phone-width window) so the title keeps its room.
fn cmd_title_line(parent : view::View, root : view::View, title_by : () -> String, subtitle_by : () -> String) -> Unit {
  let _ = parent.box(fn(tw : view::View) -> Unit {
    let _ = tw
    .grow(view::Live::Is(1.0))
    .shrink(view::Live::Is(1.0))
    .basis(view::Live::Is(Some(SP_0)))
    .min_width(view::Live::Is(Some(SP_0)))
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(SP_8))
    .cut()
    let _ = tw.box(fn(t1 : view::View) -> Unit {
      let _ = t1.min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(1.0)).cut()
      let _ = <ui::Text in={t1} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text_by=>{title_by()} />.allow_ellipsis(
        view::Live::Is(true),
      )
    })
    tw.show(fn() { subtitle_by() != "" && cmd_panel_w(root) >= SP_160 * 3.0 }, fn(t2 : view::View) -> Unit {
      let _ = t2.min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(10.0)).cut()
      let _ = <ui::Text in={t2} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text_by=>{subtitle_by()} />.allow_ellipsis(
        view::Live::Is(true),
      )
    })
  })
}

///| Width of the Space column (dot + name): fixed, so the dots of every row form one straight column whatever
///| the Space is called; a long name truncates. (A function, not a top-level `let`: a global initialized
///| from another file's `SP_*` can read 0 depending on initialization order.)
fn cmd_space_col_w() -> Double {
  SP_96
}

///| A Space label in its fixed column: the Space's color dot and its name, quiet. `when` says whether the row
///| has a Space column at all (Command Bar commands do not); an empty name keeps the column empty.
fn cmd_space_label(parent : view::View, name_by : () -> String, accent_by : () -> Int64, when~ : () -> Bool = fn() { true }) -> Unit {
  parent.show(when, fn(slot : view::View) -> Unit {
    let _ = slot.rigid()
    let _ = slot.box(fn(col : view::View) -> Unit {
      let _ = col
      .width(view::Live::Is(Some(cmd_space_col_w())))
      .rigid()
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(SP_6))
      let _ = col.box(fn(dot : view::View) -> Unit {
        let _ = dot
        .width(view::Live::Is(Some(SP_8)))
        .height(view::Live::Is(Some(SP_8)))
        .rigid()
        .radius(view::Live::Is(SP_4))
        .ground(view::Live::By(fn() { if name_by() != "" { accent_by() } else { 0L } }))
      })
      let _ = col.box(fn(nm : view::View) -> Unit {
        let _ = nm
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(SP_0)))
        .min_width(view::Live::Is(Some(SP_0)))
        .cut()
        let _ = <ui::Text in={nm} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text_by=>{name_by()} />.allow_ellipsis(
          view::Live::Is(true),
        )
      })
    })
  })
}

///| An open tab's state in one fixed 16pt column: one glyph (Playing before Favorite before Pinned) named
///| with every state that applies, so the column stays straight and nothing is lost to assistive tech.
fn cmd_state_slot(parent : view::View, item_by : () -> Option[proto::TabSearchItem]) -> Unit {
  let icon_by = fn() -> String {
    match item_by() {
      Some(it) => if it.is_playing_audio { ICON_VOLUME } else if it.is_favorite { ICON_STAR } else if it.is_pinned { ICON_PIN } else { "" }
      None => ""
    }
  }
  let label_by = fn() -> String {
    match item_by() {
      Some(it) => {
        let parts : Array[String] = []
        if it.is_playing_audio {
          parts.push("Playing")
        }
        if it.is_favorite {
          parts.push("Favorite")
        } else if it.is_pinned {
          parts.push("Pinned")
        }
        let sb = StringBuilder::new()
        let mut i = 0
        while i < parts.length() {
          if i > 0 {
            sb.write_string(", ")
          }
          sb.write_string(parts[i])
          i += 1
        }
        sb.to_string()
      }
      None => ""
    }
  }
  let _ = parent.box(fn(col : view::View) -> Unit {
    let _ = col.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(SP_16))).rigid().center()
    col.show(fn() { icon_by() != "" }, fn(st : view::View) -> Unit {
      let _ = st
      .width(view::Live::Is(Some(SP_16)))
      .height(view::Live::Is(Some(SP_16)))
      .rigid()
      .center()
      .says(view::Live::By(fn() { Some(view::said(view::Role::Image, label=label_by())) }))
      let _ = shell_icon_by(st, icon_by, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
    })
  })
}

///| Palette top: 14% down the window, between 48 and 128pt (the address palette, the Command Bar, Tab Search).
pub fn shell_palette_top(window_h : Double) -> Double {
  let h = if window_h > 0.0 { window_h } else { SP_160 * 5.0 }
  let t = h * 0.14
  if t < SP_48 { SP_48 } else if t > SP_128 { SP_128 } else { t }
}

///| Palette width in a column `avail` wide: `SHELL_PALETTE_W`, narrowing with it (24pt from each edge, 8pt when
///| very narrow).
pub fn shell_palette_w(avail : Double) -> Double {
  let w = avail - SP_48
  if w > SHELL_PALETTE_W {
    SHELL_PALETTE_W
  } else if w < SP_160 + SP_128 {
    if avail - SP_16 > 0.0 { avail - SP_16 } else { SP_0 }
  } else {
    w
  }
}

///| Palette left edge: centered over the column (`column_left`, `column_w`), so it sits over the page whether
///| the sidebar is docked or not.
pub fn shell_palette_left(column_left : Double, column_w : Double) -> Double {
  let pw = shell_palette_w(column_w)
  if column_w > pw { column_left + (column_w - pw) / 2.0 } else { column_left + SP_8 }
}

///| The one palette surface: `lg` dialog glass at radius SP_20 with a solid card, SP_6 in, `width_by` wide; rows
///| inside use SP_12-SP_16 corners (concentric). Every palette (address, Command Bar, Tab Search) is this.
pub fn shell_palette_panel(
  parent : view::View,
  width_by : () -> Double,
  body : (view::View) -> Unit,
  outer? : (view::View) -> Unit,
) -> view::View {
  shell_float_rim(lg::liquid_dialog_shell_node(
    parent,
    fn(panel : view::View) -> Unit {
      let _ = panel
      .width(view::Live::By(fn() { Some(width_by()) }))
      .padding(view::Live::Is((SP_6, SP_6, SP_6, SP_6)))
      .gap(view::Live::Is(SP_0))
      match outer {
        Some(f) => f(panel)
        None => ()
      }
      // Content sits on one solid card (the glass is only the SP_6 rim), so nothing behind the palette lowers the
      // contrast of its rows; concentric with the glass.
      let _ = panel.box(fn(card : view::View) -> Unit {
        let _ = card
        .radius(view::Live::Is(lg::concentric(SP_20, SP_6)))
        .clips(view::Live::Is(true))
        .ground(view::Live::By(fn() { lg::surface().card }))
        body(card)
      })
    },
    radius=SP_20,
    solid=fn() { lg::surface().card },
    tint_light=CMD_TINT_LIGHT,
  ))
}

///| Panel top in the window of `root`.
fn cmd_panel_top(root : view::View) -> Double {
  shell_palette_top(root.window_h())
}

///| Panel width in the window of `root` (used for the narrow-window subtitle rule).
fn cmd_panel_w(root : view::View) -> Double {
  let rw = root.window_w()
  shell_palette_w(if rw > 0.0 { rw } else { SHELL_PALETTE_W + SP_48 })
}

///| The shared modal panel: the one palette (`shell_palette_panel`) centered over the page column, no dimming. Cmd+K and
///| Cmd+Shift+A open it 100+ times a day, so like the address palette the panel only fades in over MO_KEY_MS with
///| no dimming, no lift and nothing laid out again per frame; it closes at once. Already open when the shell is
///| built, it is there at once.
fn cmd_modal_panel(
  layer : view::View,
  root : view::View,
  model : ShellModel,
  label : String,
  is_open : () -> Bool,
  on_close : () -> Unit,
  field : ui::Field,
  animate : Bool,
  column : Option[(() -> Double, () -> Double)],
  body : (view::View) -> Unit,
) -> Unit {
  let _ = layer.over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0))))
  // The page column the palette centers over: as the frame says, else after the docked sidebar the model has.
  let win_w = fn() -> Double {
    let rw = root.window_w()
    if rw > 0.0 { rw } else { SHELL_PALETTE_W + SP_48 }
  }
  let col_left = fn() -> Double {
    match column {
      Some(c) => (c.0)()
      None => {
        let d = model.dock()
        shell_sidebar_width(win_w(), d.sidebar_open, custom_w=d.sidebar_width)
      }
    }
  }
  let col_w = fn() -> Double {
    match column {
      Some(c) => (c.1)()
      None => {
        let rw = win_w() - col_left()
        if rw > SP_128 { rw } else { SP_128 }
      }
    }
  }
  let pal_w = fn() -> Double { shell_palette_w(col_w()) }
  let reveal = motion::NodeWay::new(if animate { 0.0 } else { 1.0 })
  if animate {
    shell_go(reveal, layer, 1.0, MO_KEY_MS)
  }
  // No dimming (as the address palette): the page stays as it is. This clear layer only takes the outside click,
  // which the modal dialog owns (it closes the panel without reaching the page).
  let _ = layer.box(fn(bg : view::View) -> Unit {
    let _ = bg.over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0)))).points(view::Live::Is(true))
  })
  let _ = layer.box(fn(anchor : view::View) -> Unit {
    let _ = anchor
    .over_at(view::Live::By(fn() { (Some(shell_palette_left(col_left(), col_w())), Some(cmd_panel_top(root)), None, None) }))
    .width(view::Live::By(fn() { Some(pal_w()) }))
    .alpha(view::Live::By(fn() { reveal.shown(anchor) }))
    .scale(view::Live::By(fn() {
      if ui::reduced_motion() {
        1.0
      } else {
        let p = reveal.shown(anchor)
        if p >= MO_SCALE_LANDS { 1.0 } else { 0.975 + 0.025 * p }
      }
    }))
    .offset(view::Live::By(fn() {
      if ui::reduced_motion() {
        (SP_0, SP_0)
      } else {
        let p = reveal.shown(anchor)
        if p >= MO_SCALE_LANDS { (SP_0, SP_0) } else { (SP_0, -4.0 * (1.0 - p)) }
      }
    }))
    let _ = headless::dialog(
      anchor,
      fn() { label },
      is_open,
      on_close,
      fn(dlg : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg.width(view::Live::By(fn() { Some(pal_w()) }))
        let _ = shell_palette_panel(dlg, pal_w, body)
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if (how is headless::OverlayDismiss::Escape) && cmd_ime_composing(field) {
          field.compose("")
          true
        } else {
          false
        }
      },
    )
  })
}

///| Builds the Command Bar overlay (`Cmd+K`, exact tag `"command_bar"`): tabs, Spaces, commands and the
///| web fallback in one ranked list with no captions (`palette_look.pion`), inside the shared palette panel.
pub fn build_command_bar_overlay(
  root : view::View,
  model : ShellModel,
  props : CommandBarProps,
  column? : (() -> Double, () -> Double),
) -> Unit {
  let is_open = fn() -> Bool {
    let ex = model.exclusive()
    (ex.active is ExclusiveKind::CommandBar) && ex.tag == "command_bar"
  }
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(is_open, fn(cb_layer : view::View) -> Unit {
    match props.on_clear_rows {
      Some(cb) => cb()
      None => ()
    }
    cmd_modal_panel(cb_layer, root, model, "Command Bar", is_open, props.on_close, props.field, built.v, column, fn(panel : view::View) -> Unit {
      panel.reacts(fn() { props.field.text() }, fn(q : String) -> Unit {
        if is_open() {
          (props.on_query_change)(q)
        }
      })

      // Field row (`CommandBarField` key context: Up/Down move the selection, Escape closes). The same Arc field
      // as the address palette (`palette_look.pion`); its info button shows the keyboard hints.
      let hints_open = signals::signal(false)
      shell_palette_field_row(
        panel,
        props.field,
        PALETTE_PLACEHOLDER,
        "Command Bar Search",
        fn() { hints_open.get() },
        fn() { hints_open.set(!hints_open.untracked()) },
        submitted=fn(t : String) -> Unit { (props.on_submit)(t) },
        setup=fn(in_row : view::View) -> Unit {
          let _ = in_row
          .key_context("CommandBarField")
          .on_action("commandbar.down", fn(_a : view::ActionAt) -> Bool { (props.on_step)(1) })
          .on_action("commandbar.up", fn(_a : view::ActionAt) -> Bool { (props.on_step)(-1) })
          .on_action("commandbar.escape", fn(_a : view::ActionAt) -> Bool {
            if cmd_ime_composing(props.field) {
              props.field.compose("")
              return true
            }
            (props.on_close)()
            true
          })
        },
      )

      // One ranked list, no captions (Arc): tabs, Spaces, commands, then the web fallback.
      panel.show(fn() { (props.items)().length() > 0 }, fn(rows : view::View) -> Unit {
        let _ = rows.gap(view::Live::Is(SP_2)).padding(view::Live::Is((SP_4, SP_0, SP_4, SP_4)))
        let mut cslot = 0
        while cslot < proto::COMMAND_BAR_MAX_ITEMS {
          let cidx = cslot
          rows.show(fn() { cidx < (props.items)().length() }, fn(rwrap : view::View) -> Unit {
            let get_item = fn() -> Option[proto::CommandBarItem] {
              let list = (props.items)()
              if cidx < list.length() { Some(list[cidx]) } else { None }
            }
            let title_fn = fn() -> String {
              match get_item() {
                Some(it) => it.title
                None => ""
              }
            }
            let is_sel = fn() -> Bool { (props.selected)() == cidx }
            // A tab, or a URL to a site whose icon the shell has: the site's own icon. Everything else: a monochrome
            // command glyph.
            let site_of = fn() -> String {
              match get_item() {
                Some(it) =>
                if it.kind is proto::CommandKind::SwitchTab {
                  cmd_host(it.subtitle)
                } else if it.kind is proto::CommandKind::NavigateUrl {
                  it.id
                } else {
                  ""
                }
                None => ""
              }
            }
            let is_site = fn() -> Bool {
              match get_item() {
                Some(it) =>
                it.kind is proto::CommandKind::SwitchTab ||
                (it.kind is proto::CommandKind::NavigateUrl && shell_site_icon(it.id).is_some())
                None => false
              }
            }
            let row_v = shell_palette_row(
              rwrap,
              model,
              PaletteRowSpec::{
                label: title_fn,
                title: title_fn,
                detail: fn() {
                  match get_item() {
                    Some(it) => if it.is_space && it.badge == "Active" { "Current Space" } else { "" }
                    None => ""
                  }
                },
                action: fn() {
                  match get_item() {
                    Some(it) => command_bar_action_label(it)
                    None => ""
                  }
                },
                hint: fn() {
                  match get_item() {
                    Some(it) => it.shortcut
                    None => ""
                  }
                },
                leading: fn(lead : view::View, selected : () -> Bool) -> Unit {
                  lead.show(is_site, at_once=true, fn(st : view::View) -> Unit {
                    let _ = shell_site_tile(st, site_of, size=SP_24, awaits_cached=true)
                  })
                  lead.show(fn() { !is_site() }, at_once=true, fn(gt : view::View) -> Unit {
                    shell_palette_glyph(
                      gt,
                      fn() {
                        match get_item() {
                          Some(it) => command_bar_icon_name(it)
                          None => ICON_COMMAND
                        }
                      },
                      selected,
                    )
                  })
                },
              },
              is_sel,
              fn() {
                match get_item() {
                  Some(it) => (props.on_execute)(it)
                  None => ()
                }
              },
              // The pointer moves the selection (never a second hover wash): step from the selected row to this one.
              fn() {
                let cur = (props.selected)()
                if cur != cidx {
                  let _ = (props.on_step)(cidx - cur)
                }
              },
              radius=SP_10,
            )
            match props.on_row_view {
              Some(cb) => cb(row_v)
              None => ()
            }
          })
          cslot += 1
        }
      })

      panel.show(fn() { hints_open.get() }, at_once=true, fn(h : view::View) -> Unit { shell_palette_hints(h, "Run") })
    })
  })
  built.v = true
}

///| Builds the Tab Search overlay (`Cmd+Shift+A`, exact tag `"tab_search"`): open tabs across Spaces, then
///| recently closed tabs, each with its site tile, its Space and its state.
pub fn build_tab_search_overlay(
  root : view::View,
  model : ShellModel,
  props : TabSearchProps,
  column? : (() -> Double, () -> Double),
) -> Unit {
  let is_open = fn() -> Bool {
    let ex = model.exclusive()
    (ex.active is ExclusiveKind::TabSearch) && ex.tag == "tab_search"
  }
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(is_open, fn(layer : view::View) -> Unit {
    cmd_modal_panel(layer, root, model, "Tab Search", is_open, props.on_close, props.field, built.v, column, fn(card : view::View) -> Unit {
      card.reacts(fn() { props.field.text() }, fn(q : String) -> Unit {
        if is_open() {
          (props.on_query_change)(q)
        }
      })

      cmd_field_row(
        card,
        props.field,
        ICON_SEARCH,
        "Search open and recently closed tabs",
        fn(_v : String) -> Unit { (props.on_submit)() },
        fn(_r : view::View) -> Unit { () },
      )
      cmd_rule(card)

      // Open tabs
      card.show(fn() { (props.results)().open_items.length() > 0 }, fn(osec : view::View) -> Unit {
        let _ = osec.gap(view::Live::Is(SP_2))
        cmd_caption(osec, fn() { "Open tabs" })
        let mut slot = 0
        while slot < proto::TAB_SEARCH_MAX_OPEN {
          let idx = slot
          osec.show(fn() { idx < (props.results)().open_items.length() }, fn(row_slot : view::View) -> Unit {
            let is_selected = fn() -> Bool { (props.selected)() == idx }
            let get_item = fn() -> Option[proto::TabSearchItem] {
              let items = (props.results)().open_items
              if idx < items.length() { Some(items[idx]) } else { None }
            }
            let hover_t = shell_fade(row_slot, fn() { row_slot.pointed_in() })
            let _ = row_slot
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .min_height(view::Live::Is(Some(SP_40)))
            .rigid()
            // (no gap or padding of the row's own: Switch meets Close, and Close reaches the fill's edge)
            .padding(view::Live::Is((SP_0, SP_0, SP_0, SP_0)))
            .gap(view::Live::Is(SP_0))
            .radius(view::Live::Is(lg::concentric(SP_20, SP_6)))
            .ground(view::Live::By(fn() {
              if is_selected() {
                cmd_selected_fill(model.dark())
              } else {
                lg::alpha(lg::surface().row_hover, hover_t())
              }
            }))

            let _ = headless::button(
              row_slot,
              fn() {
                match get_item() {
                  Some(it) => "Switch to " + it.title
                  None => "Switch Tab"
                }
              },
              fn(_v : view::View) -> Unit {
                match get_item() {
                  Some(it) => (props.on_activate)(it)
                  None => ()
                }
              },
              fn(main_b : view::View, _btn : headless::Button) -> Unit {
                let _ = main_b
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(SP_0)))
                .min_width(view::Live::Is(Some(SP_0)))
                .min_height(view::Live::Is(Some(SP_40)))
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((SP_8, SP_6, SP_10, SP_6)))
                .gap(view::Live::Is(SP_10))
                let _ = shell_site_tile(
                  main_b,
                  fn() {
                    match get_item() {
                      Some(it) => cmd_host(it.display_host)
                      None => ""
                    }
                  },
                  size=SP_24,
                  awaits_cached=true,
                )
                cmd_title_line(
                  main_b,
                  root,
                  fn() {
                    match get_item() {
                      Some(it) => it.title
                      None => ""
                    }
                  },
                  fn() {
                    match get_item() {
                      Some(it) => cmd_host(it.display_host)
                      None => ""
                    }
                  },
                )
                // "Current tab" for the tab already in front, then the state column and the Space column.
                main_b.show(
                  fn() {
                    match get_item() {
                      Some(it) => it.is_active
                      None => false
                    }
                  },
                  fn(cur : view::View) -> Unit {
                    let _ = cur.rigid()
                    let _ = <ui::Text in={cur} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text="Current tab" />
                  },
                )
                cmd_state_slot(main_b, get_item)
                cmd_space_label(
                  main_b,
                  fn() {
                    match get_item() {
                      Some(it) => it.space_name
                      None => ""
                    }
                  },
                  fn() {
                    match get_item() {
                      Some(it) => it.space_accent_rgba
                      None => lg::surface().accent
                    }
                  },
                )
              },
            )

            // Close: a fixed trailing slot so the row never reflows; the button itself appears on hover or
            // selection (mounted with `.show`, never an invisible clickable).
            let _ = row_slot.box(fn(x_slot : view::View) -> Unit {
              let _ = x_slot.width(view::Live::Is(Some(SP_32 + SP_4))).height(view::Live::Is(Some(SP_40))).rigid().center()
              x_slot.show(fn() { row_slot.pointed_in() || is_selected() }, fn(x_wrap : view::View) -> Unit {
                let _ = x_wrap.rigid()
                let _ = headless::button(
                  x_wrap,
                  fn() { "Close Tab" },
                  fn(_v : view::View) -> Unit {
                    match get_item() {
                      Some(it) => (props.on_close_tab)(it.id)
                      None => ()
                    }
                  },
                  fn(xb : view::View, xbtn : headless::Button) -> Unit {
                    let x_hover = shell_fade(xb, fn() { xbtn.hovered() || xbtn.pressed() })
                    // 36 x 40 target to the fill's trailing edge; the 32pt face keeps its 4pt inset.
                    let _ = xb
                    .width(view::Live::Is(Some(SP_32 + SP_4)))
                    .height(view::Live::Is(Some(SP_40)))
                    .rigid()
                    .padding(view::Live::Is((SP_0, SP_0, SP_4, SP_0)))
                    .center()
                    let _ = xb.box(fn(face : view::View) -> Unit {
                      let _ = face
                      .width(view::Live::Is(Some(SP_32)))
                      .height(view::Live::Is(Some(SP_32)))
                      .rigid()
                      .center()
                      .points(view::Live::Is(false))
                      .radius(view::Live::Is(SP_8))
                      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, x_hover()) }))
                      shell_press(face, fn() { xbtn.pressed() })
                      let _ = shell_icon(face, ICON_CLOSE, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
                    })
                  },
                )
              })
            })
          })
          slot += 1
        }
      })

      // Recently closed
      card.show(fn() { (props.results)().closed_items.length() > 0 }, fn(csec : view::View) -> Unit {
        let _ = csec.gap(view::Live::Is(SP_2))
        cmd_caption(csec, fn() { "Recently closed" })
        let mut cslot = 0
        while cslot < proto::TAB_SEARCH_MAX_CLOSED {
          let cidx = cslot
          csec.show(fn() { cidx < (props.results)().closed_items.length() }, fn(crow_wrap : view::View) -> Unit {
            let flat_idx = fn() -> Int { (props.results)().open_items.length() + cidx }
            let is_selected = fn() -> Bool { (props.selected)() == flat_idx() }
            let get_item = fn() -> Option[proto::TabSearchItem] {
              let items = (props.results)().closed_items
              if cidx < items.length() { Some(items[cidx]) } else { None }
            }
            let _ = headless::button(
              crow_wrap,
              fn() {
                match get_item() {
                  Some(it) => "Reopen " + it.title
                  None => "Reopen Closed Tab"
                }
              },
              fn(_v : view::View) -> Unit {
                match get_item() {
                  Some(it) => (props.on_activate)(it)
                  None => ()
                }
              },
              fn(crow : view::View, cbtn : headless::Button) -> Unit {
                let hover_t = shell_fade(crow, fn() { cbtn.hovered() || cbtn.pressed() })
                let _ = crow
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .min_height(view::Live::Is(Some(SP_40)))
                .rigid()
                .padding(view::Live::Is((SP_8, SP_6, SP_4, SP_6)))
                .gap(view::Live::Is(SP_10))
                .radius(view::Live::Is(lg::concentric(SP_20, SP_6)))
                .ground(view::Live::By(fn() {
                  if is_selected() {
                    cmd_selected_fill(model.dark())
                  } else {
                    lg::alpha(lg::surface().row_hover, hover_t())
                  }
                }))
                let _ = shell_site_tile(
                  crow,
                  fn() {
                    match get_item() {
                      Some(it) => cmd_host(it.display_host)
                      None => ""
                    }
                  },
                  size=SP_24,
                  awaits_cached=true,
                )
                cmd_title_line(
                  crow,
                  root,
                  fn() {
                    match get_item() {
                      Some(it) => it.title
                      None => ""
                    }
                  },
                  fn() {
                    match get_item() {
                      Some(it) => cmd_host(it.display_host)
                      None => ""
                    }
                  },
                )
                cmd_space_label(
                  crow,
                  fn() {
                    match get_item() {
                      Some(it) => it.space_name
                      None => ""
                    }
                  },
                  fn() {
                    match get_item() {
                      Some(it) if it.space_accent_rgba != 0L => it.space_accent_rgba
                      _ => lg::surface().ink_tertiary
                    }
                  },
                )
                // Says what the row does: Enter or a click reopens it.
                let _ = crow.box(fn(ri : view::View) -> Unit {
                  let _ = ri.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_24))).rigid().center()
                  let _ = shell_icon(ri, ICON_UNDO, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
                })
              },
            )
          })
          cslot += 1
        }
      })

      // Nothing matches
      card.show(fn() { (props.results)().total_count() == 0 }, fn(empty_box : view::View) -> Unit {
        let _ = empty_box.padding(view::Live::Is((SP_16, SP_24, SP_16, SP_24))).center()
        let _ = <ui::Text
          in={empty_box}
          size={TX_BODY}
          color_by=>{lg::surface().ink_secondary}
          text_by=>{
            if props.field.text().trim() == "" { "No open or recently closed tabs" } else { "No tabs match your search" }
          }
        />
      })

      cmd_rule(card)
      cmd_footer(
        card,
        [(["up", "down"], "Navigate"), (["Enter"], "Switch or reopen")],
        (["Esc"], "Close"),
        lead_when=fn() { (props.results)().total_count() > 0 },
      )
    })
  })
  built.v = true
}
