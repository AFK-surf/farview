///| Shell 3 bookmark bubble (Chrome's "Bookmark added" bubble, `bookmark_bubble`): after Cmd+D (or the star) it
///| names the page's bookmark and its folder, with Remove and Done.
///|
///| - One glass layer (`pop_mount`), solid content inside; a press outside or Escape keeps the bookmark as edited
///|   (Done), Remove takes it away.
///| - The folders already in use are offered as one-press choices under the folder field.

import "headless"
import "lg"
import "signals"
import "ui"
import "view"

pub struct BookmarkBubbleProps {
  pub open : () -> Bool
  ///| just added (Cmd+D on a page not yet bookmarked: "Bookmark added"), or opened on one kept already ("Edit
  ///| bookmark")
  pub added : () -> Bool
  ///| the page's host, for its site tile
  pub host : () -> String
  pub name_field : ui::Field
  pub folder_field : ui::Field
  ///| folders already in use (offered as choices, up to `BOOKMARK_BUBBLE_FOLDER_CHOICES`)
  pub folders : () -> Array[String]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  ///| keep the bookmark as the fields say (Done, Enter, Escape, a press outside)
  pub on_done : () -> Unit
  pub on_remove : () -> Unit
}

///| How many folders in use the bubble offers under its folder field.
pub let BOOKMARK_BUBBLE_FOLDER_CHOICES : Int = 4

///| The folders offered: those in use, the one in the field left out, at most `BOOKMARK_BUBBLE_FOLDER_CHOICES`.
pub fn bookmark_bubble_folder_choices(folders : Array[String], current : String) -> Array[String] {
  let out : Array[String] = []
  let cur = current.trim()
  for f0 in folders {
    let f = f0.trim()
    if f == "" || f == cur {
      continue
    }
    let mut seen = false
    for o in out {
      if o == f {
        seen = true
        break
      }
    }
    if !seen && out.length() < BOOKMARK_BUBBLE_FOLDER_CHOICES {
      out.push(f)
    }
  }
  out
}

pub fn build_bookmark_bubble(root : view::View, props : BookmarkBubbleProps) -> Unit {
  pop_mount(
    root,
    props.open,
    props.on_done,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 + SP_128,
    "Bookmark",
    fn(hw : view::View, close : () -> Unit) -> Unit {
      pop_header(
        hw,
        fn(lw : view::View) -> Unit { let _ = shell_site_tile(lw, props.host, size=SP_24) },
        false,
        fn() { if (props.added)() { "Bookmark added" } else { "Edit bookmark" } },
        fn() { "" },
        "Close Bookmark",
        close,
      )
    },
    fn(panel : view::View) -> Unit {
      let _ = panel.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(SP_12)).padding(view::Live::Is((SP_4, SP_0, SP_4, SP_4))).rigid()
        let _ = lg::liquid_text_field_node(
          sec,
          props.name_field,
          placeholder="Name",
          height_by=fn() { SP_32 },
          label=fn() { "Name" },
          radius=SP_8,
          submitted=fn(_t : String) -> Unit { (props.on_done)() },
        )
        let _ = lg::liquid_text_field_node(
          sec,
          props.folder_field,
          placeholder="Bookmarks",
          height_by=fn() { SP_32 },
          label=fn() { "Folder" },
          radius=SP_8,
          submitted=fn(_t : String) -> Unit { (props.on_done)() },
        )
        // Folders in use, one press each (only when there are any besides the one in the field).
        let choices = fn() { bookmark_bubble_folder_choices((props.folders)(), props.folder_field.text()) }
        sec.show(fn() { choices().length() > 0 }, fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(SP_4))).gap(view::Live::Is(SP_4)).rigid()
          let _ = row.each(choices, fn(f : String) -> String { f }, fn(slot : view::View, f_sig : signals::Signal[String]) -> Unit {
            bookmark_folder_chip(slot, f_sig, fn() { props.folder_field.set(f_sig.untracked()) })
          })
        })
      })
      props.name_field.focus()
    },
    footer=fn(fw : view::View, _layer : view::View) -> Unit {
      let _ = fw
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(SP_8))
      .padding(view::Live::Is((SP_8, SP_4, SP_4, SP_4)))
      let _ = shell_text_btn(fw, fn() { "Remove" }, props.on_remove, ink=fn() { lg::surface().danger })
      let _ = fw.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
      let _ = shell_primary_btn(fw, fn() { "Done" }, props.on_done)
    },
  )
}

///| A folder in use, as a small capsule (folder glyph and name): pressing it puts the bookmark there.
fn bookmark_folder_chip(slot : view::View, f_sig : signals::Signal[String], pick : () -> Unit) -> Unit {
  let _ = headless::button(
    slot,
    fn() { "Move to " + f_sig.get() },
    fn(_e) -> Unit { pick() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(SP_4))
      .min_height(view::Live::Is(Some(SP_24)))
      .padding(view::Live::Is((SP_8, SP_0, SP_10, SP_0)))
      .radius(view::Live::Is(SP_12))
      .focus_ring_theme()
      .ground(view::Live::By(fn() { lg::over(lg::surface().row_hover, lg::alpha(lg::surface().row_hover, hover_t())) }))
      shell_press(b, fn() { btn.pressed() })
      let _ = shell_icon(b, ICON_FOLDER, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
      let _ = <ui::Text in={b} size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink} text_by=>{f_sig.get()} />
    },
  )
}
