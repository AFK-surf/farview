///| Farview password manager surfaces (Chrome / Arc daily-driver parity):
///|
///| - **Save / Update password popover** (`build_password_save_popover`): after a login form was sent, anchored under
///|   the address bar like the bookmark bubble (one glass layer from `pop_mount`, `shell_float_rim`, crisp 1pt
///|   rims): the site, an editable username, the password as dots (it stays on the host), Never / Save (or Update),
///|   and Close.
///| - **Inline autofill dropdown** (`build_autofill_dropdown`): over the focused login or password field, the saved
///|   logins of the site (another host of it named under the username), "Generate strong password" on a new-password
///|   field, and "Manage passwords".
///| - **Settings -> Privacy -> Passwords** (`sp_build_passwords`): search, show / hide, copy username or password
///|   (the app shows the toast), delete, and import / export.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

// ---------------------------------------------------------------------------
// Save / Update popover
// ---------------------------------------------------------------------------

pub struct PasswordSavePopoverProps {
  pub open : () -> Bool
  pub prompt : () -> proto::PasswordPromptState
  ///| the username to save under (edits before Save are kept)
  pub username_field : ui::Field
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  ///| Save or Update with the username in the field
  pub on_save : (String) -> Unit
  ///| never offer to save on this site
  pub on_never : () -> Unit
  ///| Close, Escape, a press outside: not now
  pub on_close : () -> Unit
}

///| The title the popover shows for a prompt.
pub fn password_prompt_title(p : proto::PasswordPromptState) -> String {
  if p.kind == "update" { "Update password?" } else { "Save password?" }
}

///| What stands for the password: one dot per character, at most 16.
pub fn password_dots(n : Int) -> String {
  let k = if n > 16 { 16 } else if n < 0 { 0 } else { n }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < k {
    sb.write_string("\u{2022}")
    i = i + 1
  }
  sb.to_string()
}

pub fn build_password_save_popover(root : view::View, props : PasswordSavePopoverProps) -> Unit {
  pop_mount(
    root,
    props.open,
    props.on_close,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 + SP_128,
    "Save password",
    fn(hw : view::View, close : () -> Unit) -> Unit {
      pop_header(
        hw,
        fn(lw : view::View) -> Unit {
          let _ = shell_site_tile(lw, fn() { proto::password_origin_host((props.prompt)().origin) }, size=SP_24)
        },
        false,
        fn() { password_prompt_title((props.prompt)()) },
        fn() { proto::password_origin_host((props.prompt)().origin) },
        "Close Save password",
        close,
      )
    },
    fn(panel : view::View) -> Unit {
      let _ = panel.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(SP_12)).padding(view::Live::Is((SP_4, SP_0, SP_4, SP_4))).rigid()
        let _ = lg::liquid_text_field_node(
          sec,
          props.username_field,
          placeholder="Username",
          height_by=fn() { SP_32 },
          label=fn() { "Username" },
          radius=SP_8,
          submitted=fn(_t : String) -> Unit { (props.on_save)(props.username_field.text()) },
        )
        let _ = shell_card_rim(lg::surface_card_node(
          sec,
          fn(card : view::View) -> Unit {
            let _ = card
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(SP_8))
            .min_height(view::Live::Is(Some(SP_32)))
            .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
            .says(view::Live::Is(Some(view::said(view::Role::Text, label="Password hidden"))))
            let _ = shell_icon(card, "key", size=IC_SM, color_by=fn() { shell_ink_muted() })
            let _ = card.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
              let _ = <ui::Text
                in={tw}
                size={TX_BODY}
                lines={1}
                color_by=>{lg::surface().ink}
                text_by=>{password_dots((props.prompt)().password_len)}
              />
            })
          },
          radius=SP_8,
          pad=SP_0,
        ))
      })
      props.username_field.focus()
    },
    footer=fn(fw : view::View, _layer : view::View) -> Unit {
      let _ = fw
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(SP_8))
      .padding(view::Live::Is((SP_8, SP_4, SP_4, SP_4)))
      let _ = shell_text_btn(fw, fn() { "Never" }, props.on_never, ink=fn() { shell_ink_muted() })
      let _ = fw.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
      let _ = shell_primary_btn(
        fw,
        fn() { if (props.prompt)().kind == "update" { "Update" } else { "Save" } },
        fn() { (props.on_save)(props.username_field.text()) },
      )
    },
  )
}

// ---------------------------------------------------------------------------
// Autofill dropdown
// ---------------------------------------------------------------------------

pub struct AutofillDropdownProps {
  pub open : () -> Bool
  ///| the focused field's window-space rectangle (the dropdown opens under it, or above when there is no room)
  pub field_rect : () -> AnchorRect
  pub suggestions : () -> Array[proto::AutofillSuggestion]
  pub can_generate : () -> Bool
  pub on_pick : (String) -> Unit
  pub on_generate : () -> Unit
  pub on_manage : () -> Unit
  pub on_close : () -> Unit
}

///| a row's height for placement: two lines (a login from another host, Generate) and its padding
pub let AUTOFILL_ROW_H : Double = 52.0
pub let AUTOFILL_MIN_W : Double = 280.0
pub let AUTOFILL_MAX_W : Double = 400.0

///| How many rows the dropdown has (logins, Generate, Manage).
pub fn autofill_row_count(n_suggestions : Int, can_generate : Bool) -> Int {
  n_suggestions + (if can_generate { 1 } else { 0 }) + 1
}

///| Where the dropdown goes: `(x, y, w)` in window space, under the field (above it when the window has no room
///| below), as wide as the field within `AUTOFILL_MIN_W..AUTOFILL_MAX_W`, kept inside the window.
pub fn autofill_place(field : AnchorRect, rows : Int, vw : Double, vh : Double) -> (Double, Double, Double) {
  let w0 = if field.w < AUTOFILL_MIN_W { AUTOFILL_MIN_W } else if field.w > AUTOFILL_MAX_W { AUTOFILL_MAX_W } else { field.w }
  let w = if w0 > vw - SP_16 { vw - SP_16 } else { w0 }
  let h = rows.to_double() * AUTOFILL_ROW_H + SP_8 * 2.0 + 1.0
  let mut x = field.x
  if x + w > vw - SP_8 {
    x = vw - SP_8 - w
  }
  if x < SP_8 {
    x = SP_8
  }
  let below = field.y + field.h + SP_4
  let y = if below + h > vh - SP_8 && field.y - SP_4 - h >= SP_8 { field.y - SP_4 - h } else { below }
  (x, y, w)
}

fn autofill_row(
  parent : view::View,
  a11y : () -> String,
  on_press : () -> Unit,
  icon_name : String,
  title_by : () -> String,
  sub_by : () -> String,
  accent~ : Bool = false,
) -> Unit {
  let _ = headless::button(
    parent,
    a11y,
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let wash_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      // (the glyph sits on the username's line, the origin under both)
      let _ = b
      .row(view::Live::Is(true))
      .lines_up_first_line(view::Live::Is(true))
      .gap(view::Live::Is(SP_10))
      .padding(view::Live::Is((SP_10, SP_8, SP_10, SP_8)))
      .radius(view::Live::Is(SP_8))
      .focus_ring_theme()
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
      shell_press(b, fn() { btn.pressed() })
      let _ = shell_icon(b, icon_name, size=IC_MD, color_by=fn() {
        if accent { lg::surface().accent } else { shell_ink_muted() }
      })
      let _ = b.box(fn(col : view::View) -> Unit {
        let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
        let _ = <ui::Text
          in={col}
          size={TX_BODY}
          lines={1}
          color_by=>{if accent { lg::surface().accent } else { lg::surface().ink }}
          text_by=>{title_by()}
        />
        col.show(fn() { sub_by() != "" }, at_once=true, fn(s : view::View) -> Unit {
          let _ = <ui::Text in={s} size={TX_FOOTNOTE} lines={1} color_by=>{shell_ink_muted()} text_by=>{sub_by()} />
        })
      })
    },
  )
}

///| The subtitle of a suggestion: its origin's host when it was saved on another host of the site, else none.
pub fn autofill_suggestion_detail(s : proto::AutofillSuggestion) -> String {
  if s.exact { "" } else { "From " + proto::password_origin_host(s.origin) }
}

pub fn build_autofill_dropdown(root : view::View, props : AutofillDropdownProps) -> Unit {
  root.show(props.open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, props.on_close)
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)
    let place = fn() {
      let (vw, vh) = overlay_window_size(root)
      let rows = autofill_row_count((props.suggestions)().length(), (props.can_generate)())
      autofill_place((props.field_rect)(), rows, vw, vh)
    }
    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (x, y, _) = place()
        (Some(x), Some(y), None, None)
      }))
      let _ = shell_float_rim(lg::liquid_panel_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (_, _, w) = place()
            Some(w)
          }))
          .padding(view::Live::Is((SP_6, SP_8, SP_6, SP_8)))
          .clips(view::Live::Is(true))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Group, label="Saved passwords"))))
          let _ = panel.each(
            props.suggestions,
            fn(s : proto::AutofillSuggestion) -> String { s.id },
            fn(slot : view::View, s_sig : signals::Signal[proto::AutofillSuggestion]) -> Unit {
              autofill_row(
                slot,
                fn() {
                  let s = s_sig.get()
                  "Fill " + (if s.username != "" { s.username } else { "password" }) + " for " + proto::password_origin_host(s.origin)
                },
                fn() { (props.on_pick)(s_sig.untracked().id) },
                "key",
                fn() {
                  let s = s_sig.get()
                  if s.username != "" { s.username } else { "(no username)" }
                },
                fn() { autofill_suggestion_detail(s_sig.get()) },
              )
            },
          )
          panel.show(props.can_generate, at_once=true, fn(g : view::View) -> Unit {
            autofill_row(
              g,
              fn() { "Generate strong password" },
              props.on_generate,
              "sparkles",
              fn() { "Generate strong password" },
              fn() { "Saved when the form is sent" },
              accent=true,
            )
          })
          shell_full_divider(panel, pad_top=SP_4, pad_bottom=SP_4)
          autofill_row(panel, fn() { "Manage passwords" }, props.on_manage, "settings", fn() { "Manage passwords\u{2026}" }, fn() { "" })
        },
        radius=lg::r_card,
        pad=SP_0,
        floating=true,
        label=fn() { "Saved passwords" },
      ))
    })
  })
}

// ---------------------------------------------------------------------------
// Settings -> Privacy -> Passwords
// ---------------------------------------------------------------------------

pub struct SettingsPasswordsProps {
  pub items : () -> Array[proto::PasswordItemSummary]
  pub search_field : ui::Field
  ///| the password of a login shown with Show password, `None` while hidden
  pub revealed : (String) -> Option[String]
  pub on_show : (String) -> Unit
  pub on_hide : (String) -> Unit
  pub on_copy_username : (String) -> Unit
  pub on_copy_password : (String) -> Unit
  pub on_delete : (String) -> Unit
  pub on_import : () -> Unit
  pub on_export : () -> Unit
}

fn sp_kw_passwords() -> String {
  "privacy passwords password manager saved logins sign in autofill keychain credentials import export csv"
}

///| What a login row is called (its accessibility name and the target of its buttons).
pub fn password_row_name(it : proto::PasswordItemSummary) -> String {
  (if it.username != "" { it.username } else { "(no username)" }) + " on " + proto::password_origin_host(it.origin)
}

fn sp_password_row(
  slot : view::View,
  it_sig : signals::Signal[proto::PasswordItemSummary],
  pp : SettingsPasswordsProps,
) -> Unit {
  let _ = slot.box(fn(row : view::View) -> Unit {
    sp_row_layout(row)
    let _ = row.says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=password_row_name(it_sig.get()))) }))
    let _ = shell_site_tile(row, fn() { proto::password_origin_host(it_sig.get().origin) }, size=SP_24)
    let _ = row.box(fn(col : view::View) -> Unit {
      let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
      let _ = <ui::Text
        in={col}
        size={TX_BODY}
        lines={1}
        color_by=>{lg::surface().ink}
        text_by=>{proto::password_origin_host(it_sig.get().origin)}
      />
      let _ = <ui::Text
        in={col}
        size={TX_FOOTNOTE}
        lines={1}
        color_by=>{shell_ink_muted()}
        text_by=>{if it_sig.get().username != "" { it_sig.get().username } else { "(no username)" }}
      />
    })
    let shown = fn() { (pp.revealed)(it_sig.get().id) }
    let _ = row.box(fn(pw : view::View) -> Unit {
      let _ = pw.shrink(view::Live::Is(0.0)).max_width(view::Live::Is(Some(SP_160)))
      let _ = <ui::Text
        in={pw}
        size={TX_BODY}
        lines={1}
        color_by=>{if shown() is Some(_) { lg::surface().ink } else { shell_ink_muted() }}
        text_by=>{
          match shown() {
            Some(p) => p
            None => password_dots(10)
          }
        }
      />
    })
    let _ = shell_icon_face_btn(
      row,
      fn() { (if shown() is Some(_) { "Hide password of " } else { "Show password of " }) + password_row_name(it_sig.get()) },
      fn() {
        let id = it_sig.untracked().id
        if (pp.revealed)(id) is Some(_) {
          (pp.on_hide)(id)
        } else {
          (pp.on_show)(id)
        }
      },
      fn() { if shown() is Some(_) { "eye-off" } else { "eye" } },
    )
    let _ = shell_icon_face_btn(
      row,
      fn() { "Copy username of " + password_row_name(it_sig.get()) },
      fn() { (pp.on_copy_username)(it_sig.untracked().id) },
      fn() { "user" },
    )
    let _ = shell_icon_face_btn(
      row,
      fn() { "Copy password of " + password_row_name(it_sig.get()) },
      fn() { (pp.on_copy_password)(it_sig.untracked().id) },
      fn() { ICON_COPY },
    )
    let _ = shell_icon_face_btn(
      row,
      fn() { "Delete " + password_row_name(it_sig.get()) },
      fn() { (pp.on_delete)(it_sig.untracked().id) },
      fn() { "trash" },
      danger=true,
    )
  })
}

fn sp_build_passwords(parent : view::View, pp : SettingsPasswordsProps, q : () -> String) -> Unit {
  let shown = fn() { sp_matches_filter(q(), sp_kw_passwords()) }
  let filtered = fn() { proto::password_list_filter((pp.items)(), pp.search_field.text()) }
  sp_group_dyn(
    parent,
    "Passwords",
    fn() {
      let n = (pp.items)().length()
      if n == 0 {
        "Logins you save are kept encrypted on this device. Import a passwords CSV from another browser."
      } else if pp.search_field.text().trim() != "" && filtered().length() == 0 {
        "No saved login matches \u{201C}" + pp.search_field.text().trim() + "\u{201D}."
      } else {
        n.to_string() + (if n == 1 { " saved login" } else { " saved logins" }) + ", encrypted on this device."
      }
    },
    shown,
    fn(g : view::View) -> Unit {
      let _ = g.box(fn(sb : view::View) -> Unit {
        let _ = sb.padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8))).rigid()
        let _ = lg::liquid_text_field_node(
          sb,
          pp.search_field,
          placeholder="Search passwords",
          height_by=fn() { SP_32 },
          label=fn() { "Search passwords" },
          show_label=false,
          radius=SP_8,
          clearable=true,
        )
      })
      shell_full_divider(g)
      let _ = g.each(
        filtered,
        fn(it : proto::PasswordItemSummary) -> String { it.id },
        fn(slot : view::View, it_sig : signals::Signal[proto::PasswordItemSummary]) -> Unit {
          sp_password_row(slot, it_sig, pp)
          shell_full_divider(slot)
        },
      )
      let _ = g.box(fn(acts : view::View) -> Unit {
        let _ = acts
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_8))
        .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
        let _ = shell_text_btn(acts, fn() { "Import passwords" }, pp.on_import, text_by=fn() { "Import\u{2026}" })
        let _ = shell_text_btn(acts, fn() { "Export passwords" }, pp.on_export, text_by=fn() { "Export\u{2026}" })
      })
    },
  )
}
