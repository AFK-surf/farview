///| Farview Shell 3 — Reader Mode and Site Boosts.
///|
///| 1. Reader Mode (`build_reader_mode_panel`): a solid reading surface over the pane it belongs to (Light / Sepia /
///|    Night paper, no glass). One quiet bar on top: the site, then paper, text size, typeface and column width,
///|    and Exit; a 2pt reading progress line under it; the article in a centered column below.
///| 2. Site Boosts (`build_site_boosts_panel`): one floating glass panel bound to `target_origin` with solid grouped
///|    lists inside. Header: the site's tile and host, the boost's on/off toggle, Close. Sections (segmented):
///|    Colors (theme, tint swatches + hue + intensity, brightness, contrast, invert), Fonts (typeface, text size),
///|    Zap (pick elements on the page to hide, the list of hidden ones to restore, hide pop-ups), Code (custom CSS
///|    and custom JavaScript for the site). Footer: All Boosts (every boosted site: on/off, open, delete) and Reset.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "text"
import "ui"
import "view"

pub let READER_STATUS_LOADING : Int = 0
pub let READER_STATUS_INCOMPATIBLE : Int = 1
pub let READER_STATUS_READY : Int = 2

///| Strongly typed props for `build_reader_mode_panel`.
pub struct ReaderModeProps {
  pub open : () -> Bool
  pub owner_pane : PaneId
  pub article : () -> proto::ReaderArticle
  pub rev : () -> Int
  pub status : () -> Int
  pub theme : () -> String
  pub font : () -> String
  pub font_size : () -> Int
  pub width_mode : () -> String
  pub progress : () -> Double
  pub on_theme : (String) -> Unit
  pub on_font : (String) -> Unit
  pub on_font_size : (Int) -> Unit
  pub on_width_mode : (String) -> Unit
  pub on_progress : (Double) -> Unit
  pub on_close : () -> Unit
}

///| Strongly typed props for `build_site_boosts_panel`.
pub struct SiteBoostsProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub target_origin : () -> String
  pub owner_pane : () -> PaneId
  pub boost : () -> proto::SiteBoost
  pub css_field : ui::Field
  pub anchor_top : () -> Double
  pub accent_color : () -> Int64
  pub on_save : (String, proto::SiteBoost) -> Unit
  pub on_reset : (String) -> Unit
  pub on_close : () -> Unit
  pub on_css_edited : Option[(String) -> Unit]
  pub on_apply_css : Option[(String, proto::SiteBoost) -> Unit]
  ///| The site's own script (Code section).
  pub js_field : ui::Field
  ///| Whether Zap is picking elements on the page, and turning it on or off.
  pub zap_active : () -> Bool
  pub on_zap : (Bool) -> Unit
  ///| Every boosted site (All Boosts), and what its rows do: save one (on/off), open it, delete its boost.
  pub all_boosts : () -> Array[proto::SiteBoost]
  pub on_site_save : (proto::SiteBoost) -> Unit
  pub on_site_open : (String) -> Unit
  pub on_site_delete : (String) -> Unit
}

// ---------------------------------------------------------------------------------------------------------------
// Reader Mode
// ---------------------------------------------------------------------------------------------------------------

struct ReaderPaperPalette {
  page_bg : Int64
  bar_bg : Int64
  ink_primary : Int64
  ink_muted : Int64
  hairline : Int64
  surface_bg : Int64
  accent : Int64
  pill_active_bg : Int64
  pill_active_ink : Int64
}

///| The three reading papers (content colors of the reading surface, not shell chrome).
fn rb_paper_palette(raw_theme : String) -> ReaderPaperPalette {
  let th = proto::normalize_reader_paper_theme(raw_theme)
  if th == "sepia" {
    ReaderPaperPalette::{
      page_bg: 0xF8F2E4FFL,
      bar_bg: 0xF1E8D6FFL,
      ink_primary: 0x2F2217FFL,
      ink_muted: 0x6B5641FFL,
      hairline: 0xE0D2BAFFL,
      surface_bg: 0xE8DCC4FFL,
      accent: 0x9A4A16FFL,
      pill_active_bg: 0xFDF9F0FFL,
      pill_active_ink: 0x2F2217FFL,
    }
  } else if th == "night" {
    ReaderPaperPalette::{
      page_bg: 0x17181CFFL,
      bar_bg: 0x1E1F24FFL,
      ink_primary: 0xE8E8EDFFL,
      ink_muted: 0xA1A1A8FFL,
      hairline: 0x2E2F35FFL,
      surface_bg: 0x2A2B31FFL,
      accent: 0x64A8FFFFL,
      pill_active_bg: 0x3A3B42FFL,
      pill_active_ink: 0xF5F5F7FFL,
    }
  } else {
    ReaderPaperPalette::{
      page_bg: 0xFDFCFAFFL,
      bar_bg: 0xF5F4F1FFL,
      ink_primary: 0x1D1D1FFFL,
      ink_muted: 0x5E5E63FFL,
      hairline: 0xE5E4E0FFL,
      surface_bg: 0xEBEAE6FFL,
      accent: 0x0066CCFFL,
      pill_active_bg: 0xFFFFFFFFL,
      pill_active_ink: 0x1D1D1FFFL,
    }
  }
}

fn rb_make_run(
  s : String,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
) -> text::Run {
  let is_mono = force_mono || font == "mono"
  let is_serif = !is_mono && font == "serif"
  text::Run::{ ..text::plain(s), color, weight, italic, mono: is_mono, serif: is_serif }
}

fn rb_rich_block(
  in_v : view::View,
  s : String,
  sz : Double,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
  lh~ : Double = 1.65,
) -> Unit {
  let _ = in_v.box(fn(tv : view::View) -> Unit {
    let _ = tv.words_runs(
      view::Live::Is([rb_make_run(s, color, font, weight=weight, italic=italic, force_mono=force_mono)]),
      ink=color,
      look=view::WordsLook::{ ..view::words_plain, size: sz, line: sz * lh, wrap: true },
    )
  })
}

///| A recessed group of choices on the reader bar (paper, typeface, width): one track, the chosen one raised.
fn rb_bar_choices(
  bar : view::View,
  pal : () -> ReaderPaperPalette,
  items : Array[(String, String)],
  selected : () -> String,
  said_prefix : String,
  on_pick : (String) -> Unit,
  dot~ : Option[(String) -> Int64] = None,
  labels~ : Bool = true,
) -> Unit {
  let _ = bar.box(fn(track : view::View) -> Unit {
    let _ = track
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
    .gap(view::Live::Is(SP_2))
    .radius(view::Live::Is(SP_10))
    .ground(view::Live::By(fn() { pal().surface_bg }))
    for item in items {
      let (id, label) = item
      let is_on = fn() -> Bool { selected() == id }
      let _ = headless::button(
        track,
        fn() { said_prefix + label },
        fn(_v : view::View) -> Unit { on_pick(id) },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let hover_t = motion::hover_fade(b, fn() { (btn.hovered() || btn.pressed()) && !is_on() })
          let _ = b
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(SP_32)))
          .min_width(view::Live::Is(Some(SP_32)))
          .rigid()
          .center()
          .padding(view::Live::Is((SP_10, SP_0, SP_10, SP_0)))
          .gap(view::Live::Is(SP_6))
          .radius(view::Live::Is(SP_8))
          .ground(view::Live::By(fn() -> Int64 {
            if is_on() {
              pal().pill_active_bg
            } else {
              lg::alpha(pal().hairline, hover_t())
            }
          }))
          .shadow(view::Live::By(fn() {
            let (blur, dy, col) = shell_row_lift(pal().page_bg == rb_paper_palette("night").page_bg)
            if is_on() { (blur, dy, col) } else { (blur, dy, lg::alpha(col, 0.0)) }
          }))
          match dot {
            Some(color_of) => {
              let _ = b.box(fn(d : view::View) -> Unit {
                let _ = d
                .width(view::Live::Is(Some(SP_12)))
                .height(view::Live::Is(Some(SP_12)))
                .rigid()
                .radius(view::Live::Is(SP_6))
                .ground(view::Live::Is(color_of(id)))
                // (a ring in the bar's own muted ink: a light paper's swatch reads on a light bar)
                .edge(view::Live::By(fn() { (lg::hairline_w * 2.0, lg::alpha(pal().ink_muted, 0.45)) }))
              })
            }
            None => ()
          }
          if labels {
            <ui::Text
              in={b}
              size={TX_FOOTNOTE}
              weight={500}
              color_by=>{if is_on() { pal().pill_active_ink } else { pal().ink_muted }}
              text={label}
            />
          }
        },
      )
    }
  })
}

///| A flat icon or text button on the reader bar (32pt high, eased wash on hover).
fn rb_bar_button(
  parent : view::View,
  pal : () -> ReaderPaperPalette,
  said : String,
  on_press : () -> Unit,
  draw : (view::View) -> Unit,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { said },
    fn(_v : view::View) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .min_width(view::Live::Is(Some(SP_32)))
      .rigid()
      .center()
      .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
      .radius(view::Live::Is(SP_8))
      .ground(view::Live::By(fn() { lg::alpha(pal().surface_bg, hover_t()) }))
      draw(b)
    },
  )
}

///| Builds the solid Reader Mode reading surface over the pane `props.owner_pane`.
pub fn build_reader_mode_panel(parent : view::View, props : ReaderModeProps) -> Unit {
  let pal = fn() -> ReaderPaperPalette { rb_paper_palette((props.theme)()) }
  let reader_metrics = fn() -> proto::ReaderMetrics {
    let _ = (props.rev)()
    let art = (props.article)()
    let m = proto::compute_reader_metrics(art.blocks, title=art.title)
    if m.word_count > 0 {
      m
    } else {
      proto::ReaderMetrics::{
        word_count: art.word_count,
        cjk_chars: 0,
        latin_words: art.word_count,
        read_minutes: if art.read_minutes > 0 { art.read_minutes } else { 1 },
      }
    }
  }

  parent.show(props.open, fn(shell : view::View) -> Unit {
    let _ = shell
    .over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0))))
    .min_width(view::Live::Is(Some(SP_0)))
    .min_height(view::Live::Is(Some(SP_0)))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { pal().page_bg }))

    // 1. The reading bar. Wide: the site, the reading controls, Exit at the trailing edge, on one row. Narrow: the
    // site and Exit on the first row, the paper (swatches only), text size and typeface on the second.
    // (decided by the pane's own width: the one-row bar needs about 800pt)
    let narrow = fn() -> Bool {
      let _ = shell.laid_size_told()
      let (_, _, pw, _) = shell.placed_now()
      let w = if pw > SP_96 { pw } else { parent.window_w() }
      w < SP_160 * 5.0
    }
    let site_of = fn(row : view::View) -> Unit {
      let _ = row.box(fn(site : view::View) -> Unit {
        let _ = site
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .min_width(view::Live::Is(Some(SP_96)))
        .gap(view::Live::Is(SP_8))
        .clips(view::Live::Is(true))
        let _ = shell_glyph_tile(site, ICON_READER, fn() { shell_tile_palette()[5] }, size=SP_24)
        let host_txt = <ui::Text
          in={site}
          size={TX_BODY}
          weight={500}
          lines={1}
          color_by=>{pal().ink_primary}
          text_by=>{
            let h = (props.article)().host
            if h != "" { h } else { "Reader" }
          }
        />
        let _ = host_txt.cut().allow_ellipsis(view::Live::Is(true))
      })
    }
    let exit_of = fn(row : view::View) -> Unit {
      rb_bar_button(row, pal, "Exit Reader Mode", props.on_close, fn(b : view::View) -> Unit {
        let _ = shell_icon(b, ICON_CLOSE, size=IC_MD, color_by=fn() { pal().ink_primary })
      })
    }
    let controls_of = fn(row : view::View, wide : Bool) -> Unit {
      rb_bar_choices(
        row,
        pal,
        [("light", "Light"), ("sepia", "Sepia"), ("night", "Night")],
        fn() { proto::normalize_reader_paper_theme((props.theme)()) },
        "Reader Paper Theme ",
        props.on_theme,
        dot=Some(fn(id : String) -> Int64 { rb_paper_palette(id).page_bg }),
        labels=wide,
      )
      // Text size: smaller / current / larger
      let _ = row.box(fn(sseg : view::View) -> Unit {
        let _ = sseg
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .rigid()
        .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
        .radius(view::Live::Is(SP_10))
        .ground(view::Live::By(fn() { pal().surface_bg }))
        let step = fn(label : String, said : String, delta : Int, size : Double) -> Unit {
          rb_bar_button(
            sseg,
            pal,
            said,
            fn() {
              let cur = signals::untracked(props.font_size)
              (props.on_font_size)(proto::step_reader_font_size(cur, delta))
            },
            fn(b : view::View) -> Unit {
              <ui::Text in={b} size={size} weight={500} color_by=>{pal().ink_primary} text={label} />
            },
          )
        }
        step("A", "Decrease Reader Font Size", 0 - proto::READER_FONT_SIZE_STEP, TX_FOOTNOTE)
        let _ = sseg.box(fn(sz : view::View) -> Unit {
          let _ = sz.width(view::Live::Is(Some(SP_32))).rigid().center()
          <ui::Text
            in={sz}
            size={TX_FOOTNOTE}
            weight={500}
            color_by=>{pal().ink_muted}
            text_by=>{proto::clamp_reader_font_size((props.font_size)()).to_string()}
          />
        })
        step("A", "Increase Reader Font Size", proto::READER_FONT_SIZE_STEP, TX_HEADLINE)
      })
      rb_bar_choices(
        row,
        pal,
        [("sans", "Sans"), ("serif", "Serif"), ("mono", "Mono")],
        fn() { proto::normalize_reader_font((props.font)()) },
        "Reader Font ",
        props.on_font,
      )
      // (a narrow pane is one column already: no width to choose)
      if wide {
        rb_bar_choices(
          row,
          pal,
          [("narrow", "Narrow"), ("medium", "Medium"), ("wide", "Wide")],
          fn() { proto::normalize_reader_width((props.width_mode)()) },
          "Column Width ",
          props.on_width_mode,
        )
      }
    }
    let _ = shell.box(fn(bar : view::View) -> Unit {
      let _ = bar.rigid().ground(view::Live::By(fn() { pal().bar_bg }))
      bar.show(fn() { !narrow() }, fn(row : view::View) -> Unit {
        let _ = row
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((SP_16, SP_8, SP_12, SP_8)))
        .gap(view::Live::Is(SP_12))
        site_of(row)
        controls_of(row, true)
        exit_of(row)
      })
      bar.show(narrow, fn(col : view::View) -> Unit {
        let _ = col.padding(view::Live::Is((SP_16, SP_8, SP_12, SP_8))).gap(view::Live::Is(SP_8))
        let _ = col.box(fn(top : view::View) -> Unit {
          let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_12))
          site_of(top)
          exit_of(top)
        })
        let _ = col.box(fn(ctl : view::View) -> Unit {
          let _ = ctl
          .row(view::Live::Is(true))
          .wraps(view::Live::Is(Some(SP_8)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(SP_8))
          controls_of(ctl, false)
        })
      })
    })

    // 2. Reading progress (a 2pt line under the bar)
    let _ = shell.box(fn(prog_track : view::View) -> Unit {
      let _ = prog_track
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(SP_2)))
      .rigid()
      .ground(view::Live::By(fn() { pal().hairline }))
      let _ = prog_track.box(fn(prog_fill : view::View) -> Unit {
        let _ = prog_fill
        .height(view::Live::Is(Some(SP_2)))
        .rigid()
        .width(view::Live::By(fn() -> Option[Double] {
          let (_, _, tw, _) = prog_track.placed_now()
          let base_w = if tw > SP_8 { tw } else { parent.window_w() }
          Some(base_w * proto::clamp_reader_progress((props.progress)()))
        }))
        .ground(view::Live::By(fn() { pal().accent }))
      })
    })

    // 3. The article in a centered column
    let _ = shell.box(fn(scroll_host : view::View) -> Unit {
      let _ = scroll_host
      .fill()
      .clips(view::Live::Is(true))
      .on_wheel(fn(wh : view::Wheel) -> Unit {
        let cur = signals::untracked(props.progress)
        let delta = (0.0 - wh.dy) / 1400.0
        (props.on_progress)(proto::clamp_reader_progress(cur + delta))
      })

      let _ = ui::scroll_box(scroll_host, fn(sc : view::View) -> Unit {
        let _ = sc
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((SP_24, SP_40, SP_24, SP_64)))

        let _ = sc.box(fn(col : view::View) -> Unit {
          let col_w = fn() -> Option[Double] {
            let _ = scroll_host.laid_size_told()
            let target = proto::reader_column_width_pt((props.width_mode)())
            let (_, _, sw, _) = scroll_host.placed_now()
            let eff_sw = if sw > SP_64 { sw } else { parent.window_w() }
            if eff_sw > SP_64 && target > eff_sw - SP_48 {
              Some(eff_sw - SP_48)
            } else {
              Some(target)
            }
          }
          let _ = col
          .width(view::Live::By(col_w))
          .max_width(view::Live::By(col_w))
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(SP_0)))

          col.switch_by(
            fn() -> Int {
              let rev = (props.rev)()
              let st = (props.status)()
              let th = proto::normalize_reader_paper_theme((props.theme)())
              let fnm = proto::normalize_reader_font((props.font)())
              let fsz = proto::clamp_reader_font_size((props.font_size)())
              let th_i = if th == "sepia" { 1 } else if th == "night" { 2 } else { 0 }
              let fn_i = if fnm == "serif" { 1 } else if fnm == "mono" { 2 } else { 0 }
              rev * 200000 + st * 10000 + fsz * 16 + th_i * 4 + fn_i
            },
            fn(doc_box : view::View, _key : Int) -> Unit {
              let art = signals::untracked(props.article)
              let font = proto::normalize_reader_font(signals::untracked(props.font))
              let body_size = proto::clamp_reader_font_size(signals::untracked(props.font_size)).to_double()
              let scale = body_size / TX_HEADLINE
              let p = rb_paper_palette(signals::untracked(props.theme))
              let metrics = reader_metrics()
              let _ = doc_box.gap(view::Live::Is(SP_16))

              // The reading time, quiet above the title (the bar already names the site)
              let eyebrow = proto::format_read_minutes_badge(metrics.read_minutes)
              <ui::Text in={doc_box} size={TX_FOOTNOTE} weight={500} color_by=>{p.ink_muted} text={eyebrow} />

              let title_text = if art.title != "" { art.title } else { "Reading the page" }
              rb_rich_block(doc_box, title_text, TX_TITLE1 * scale, p.ink_primary, font, weight=700, lh=1.25)
              if art.byline != "" {
                rb_rich_block(doc_box, art.byline, TX_CALLOUT * scale, p.ink_muted, font, lh=1.45)
              }
              let _ = doc_box.box(fn(hsep : view::View) -> Unit {
                let _ = hsep.height(view::Live::Is(Some(lg::hairline_w * 2.0))).rigid().ground(view::Live::Is(p.hairline))
              })

              if art.blocks.length() == 0 {
                let st = signals::untracked(props.status)
                let empty_msg = if st == READER_STATUS_LOADING {
                  "Reading the article on this page."
                } else if st == READER_STATUS_INCOMPATIBLE {
                  "This page did not answer with an article."
                } else {
                  "No article found on this page."
                }
                rb_rich_block(doc_box, empty_msg, TX_CALLOUT * scale, p.ink_muted, font, lh=1.5)
              }

              let mut i = 0
              while i < art.blocks.length() {
                let blk = art.blocks[i]
                match blk.kind {
                  proto::ReaderBlockKind::Heading => {
                    let h_size = if blk.level <= 2 { TX_TITLE3 * scale } else { (TX_HEADLINE + SP_2) * scale }
                    let _ = doc_box.box(fn(hb : view::View) -> Unit {
                      let _ = hb.padding(view::Live::Is((SP_0, SP_8, SP_0, SP_0)))
                      rb_rich_block(hb, blk.text, h_size, p.ink_primary, font, weight=600, lh=1.35)
                    })
                  }
                  proto::ReaderBlockKind::Quote => {
                    let _ = doc_box.box(fn(qb : view::View) -> Unit {
                      let _ = qb.row(view::Live::Is(true)).padding(view::Live::Is((SP_4, SP_2, SP_0, SP_2))).gap(view::Live::Is(SP_16))
                      let _ = qb.box(fn(vbar : view::View) -> Unit {
                        let _ = vbar.width(view::Live::Is(Some(SP_2))).rigid().radius(view::Live::Is(SP_2)).ground(view::Live::Is(p.accent))
                      })
                      let _ = qb.box(fn(qt : view::View) -> Unit {
                        let _ = qt.fill()
                        rb_rich_block(qt, blk.text, body_size, p.ink_primary, font, italic=true, lh=1.6)
                      })
                    })
                  }
                  proto::ReaderBlockKind::Code => {
                    let _ = doc_box.box(fn(cb : view::View) -> Unit {
                      let _ = cb.padding(view::Live::Is((SP_16, SP_12, SP_16, SP_12))).radius(view::Live::Is(SP_8)).ground(view::Live::Is(p.surface_bg))
                      rb_rich_block(cb, blk.text, TX_BODY * scale, p.ink_primary, font, force_mono=true, lh=1.5)
                    })
                  }
                  proto::ReaderBlockKind::ListItem => {
                    let _ = doc_box.box(fn(li : view::View) -> Unit {
                      let _ = li.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_12))
                      let _ = li.box(fn(bwrap : view::View) -> Unit {
                        let _ = bwrap.width(view::Live::Is(Some(SP_8))).height(view::Live::Is(Some(body_size * 1.65))).rigid().center()
                        let _ = bwrap.box(fn(dot : view::View) -> Unit {
                          let _ = dot.width(view::Live::Is(Some(SP_6))).height(view::Live::Is(Some(SP_6))).rigid().radius(view::Live::Is(SP_4)).ground(view::Live::Is(p.ink_muted))
                        })
                      })
                      let _ = li.box(fn(lt : view::View) -> Unit {
                        let _ = lt.fill()
                        rb_rich_block(lt, blk.text, body_size, p.ink_primary, font, lh=1.65)
                      })
                    })
                  }
                  proto::ReaderBlockKind::Paragraph => rb_rich_block(doc_box, blk.text, body_size, p.ink_primary, font, lh=1.65)
                }
                i += 1
              }
            },
          )
        })
      })
    })
  })
}

// ---------------------------------------------------------------------------------------------------------------
// Site Boosts
// ---------------------------------------------------------------------------------------------------------------

// Tile colors (index into `shell_tile_palette()`): one per kind of control, the same everywhere in the panel.
let BP_BLUE : Int = 0
let BP_INDIGO : Int = 1
let BP_PURPLE : Int = 2
let BP_PINK : Int = 3
let BP_RED : Int = 4
let BP_ORANGE : Int = 5
let BP_GREEN : Int = 6
let BP_TEAL : Int = 7
let BP_GRAY : Int = 8

// Glyphs of the panel's own rows (names from `packages/icons`).
let BP_IC_PALETTE : String = "palette"
let BP_IC_CODE : String = "code"
let BP_IC_FILE_CODE : String = "file-code"
let BP_IC_EYE : String = "eye"
let BP_IC_TRASH : String = "trash"
let BP_IC_LIST : String = "list"
let BP_IC_OPEN : String = "arrow-up-right"

///| A tile drawn rather than taken from the icon set (Hue, Intensity, Contrast, Typeface, Text size): the same
///| rounded square and color as `shell_glyph_tile`, its mark built from boxes and letters.
fn bp_drawn_tile(parent : view::View, color_by : () -> Int64, mark : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(SP_24)))
    .height(view::Live::Is(Some(SP_24)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(SP_24)))
    .ground(view::Live::By(color_by))
    .clips(view::Live::Is(true))
    .points(view::Live::Is(false))
    .center()
    mark(tile)
  })
}

///| Hue: the color wheel's hues side by side on the tile.
fn bp_hue_tile(parent : view::View) -> Unit {
  bp_drawn_tile(parent, fn() { 0xFFFFFFFFL }, fn(tile : view::View) -> Unit {
    let _ = tile.row(view::Live::Is(true))
    let mut i = 0
    while i < 6 {
      let c = proto::boost_tint_rgba(proto::boost_hue_hex(i * 60))
      let _ = tile.box(fn(band : view::View) -> Unit {
        let _ = band.grow(view::Live::Is(1.0)).height(view::Live::Is(Some(SP_24))).ground(view::Live::Is(c))
      })
      i += 1
    }
  })
}

///| A 12pt white ring with a part of it filled: `left` fills the left half (contrast), else the lower half (a
///| level: intensity).
fn bp_ring_tile(parent : view::View, color_by : () -> Int64, left : Bool) -> Unit {
  bp_drawn_tile(parent, color_by, fn(tile : view::View) -> Unit {
    let _ = tile.box(fn(ring : view::View) -> Unit {
      let _ = ring
      .width(view::Live::Is(Some(IC_SM)))
      .height(view::Live::Is(Some(IC_SM)))
      .rigid()
      .radius(view::Live::Is(SP_6))
      .clips(view::Live::Is(true))
      .edge(view::Live::Is((lg::hairline_w * 3.0, 0xFFFFFFFFL)))
      .row(view::Live::Is(left))
      .lies_along(view::Live::Is(if left { view::Lies::Start } else { view::Lies::End }))
      let _ = ring.box(fn(fill : view::View) -> Unit {
        let _ = fill
        .width(view::Live::Is(Some(if left { SP_6 } else { IC_SM })))
        .height(view::Live::Is(Some(if left { IC_SM } else { SP_6 })))
        .rigid()
        .ground(view::Live::Is(0xFFFFFFFFL))
      })
    })
  })
}

///| Typeface ("Aa") and Text size (a small and a large "A") tiles.
fn bp_letters_tile(parent : view::View, color_by : () -> Int64, sizes : Bool) -> Unit {
  // (letters are text: the tile color is deepened by the lg rule until white reads at 4.5:1)
  bp_drawn_tile(parent, fn() { lg::prominent_accent_fill(color_by(), high_contrast=true) }, fn(tile : view::View) -> Unit {
    let _ = tile.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::End))).gap(view::Live::Is(SP_0))
    if sizes {
      <ui::Text in={tile} size={TX_CAPTION} weight={600} color_by=>{0xFFFFFFFFL} text="A" />
      <ui::Text in={tile} size={TX_CALLOUT} weight={600} color_by=>{0xFFFFFFFFL} text="A" />
    } else {
      <ui::Text in={tile} size={TX_FOOTNOTE} weight={600} color_by=>{0xFFFFFFFFL} text="Aa" />
    }
  })
}

///| A site monogram tile in the site's own `shell_site_color`, taken by `lg::prominent_accent_fill` to the depth
///| where its white letter reads at 4.5:1 (no palette of its own: the same hue as the sidebar's tile).
fn bp_site_tile(parent : view::View, host_by : () -> String, size~ : Double = SP_24) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(fn() { lg::prominent_accent_fill(shell_site_color(host_by()), high_contrast=true) }))
    .points(view::Live::Is(false))
    .center()
    <ui::Text
      in={tile}
      size={shell_tile_letter(size)}
      weight={600}
      color_by=>{0xFFFFFFFFL}
      text_by=>{shell_site_monogram(host_by())}
    />
  })
}

///| Ink of a text button that acts (Apply, Show all): the accent, deep enough on a light card to read at 4.5:1.
fn bp_link_ink() -> Int64 {
  if lg::is_dark() { lg::surface().accent } else { 0x0066CCFFL }
}

fn bp_tile(k : Int) -> () -> Int64 {
  fn() { shell_tile_palette()[k] }
}

///| Rows of a grouped list sit SP_12 in; a row's label starts after its 24pt tile and SP_12.
fn bp_label_inset() -> Double {
  SP_12 + SP_24 + SP_12
}

///| A grouped list: a quiet caption, one solid card, an optional footnote.
fn bp_group(
  parent : view::View,
  caption : () -> String,
  footnote : () -> String,
  rows : (view::View) -> Unit,
) -> Unit {
  let _ = parent.box(fn(g : view::View) -> Unit {
    let _ = g.gap(view::Live::Is(SP_6)).rigid()
    g.show(fn() { caption() != "" }, fn(c : view::View) -> Unit {
      let _ = c.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      <ui::Text in={c} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text_by=>{caption()} />
    })
    let _ = g.box(fn(card : view::View) -> Unit {
      // (a hairline edge keeps the solid card apart from the light glass around it)
      let _ = card
      .radius(view::Live::Is(SP_12))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() { lg::surface().card }))
      .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
      rows(card)
    })
    g.show(fn() { footnote() != "" }, fn(f : view::View) -> Unit {
      let _ = f.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      <ui::Text in={f} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text_by=>{footnote()} />
    })
  })
}

///| Hairline between rows, starting where the labels start.
fn bp_rule(parent : view::View, inset~ : Double = bp_label_inset()) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((inset, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| One row: glyph tile, label (and an optional second line), trailing control. At least 40pt.
fn bp_row(
  parent : view::View,
  icon : String,
  color_by : () -> Int64,
  label : () -> String,
  trailing : (view::View) -> Unit,
  sub~ : () -> String = fn() { "" },
  tile? : (view::View) -> Unit,
  trail_pad~ : Double = SP_12,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_8, trail_pad, SP_8)))
    .gap(view::Live::Is(SP_12))
    // (the tile sits beside the label's line; a second line runs under the label)
    let _ = row.box(fn(main : view::View) -> Unit {
      let _ = main.fill()
      let _ = main.box(fn(head : view::View) -> Unit {
        let _ = head.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_12))
        match tile {
          Some(draw) => draw(head)
          None => {
            let _ = shell_glyph_tile(head, icon, color_by, size=SP_24)
          }
        }
        let _ = head.box(fn(tw : view::View) -> Unit {
          let _ = tw.fill()
          let l = <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text_by=>{label()} />
          let _ = l.cut().allow_ellipsis(view::Live::Is(true))
        })
      })
      main.show(fn() { sub() != "" }, fn(sv : view::View) -> Unit {
        let _ = sv.padding(view::Live::Is((SP_24 + SP_12, SP_0, SP_0, SP_0)))
        let s = <ui::Text in={sv} size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{sub()} />
        let _ = s.cut().allow_ellipsis(view::Live::Is(true))
      })
    })
    trailing(row)
  })
}

///| A trailing value in a row (secondary ink).
fn bp_value(parent : view::View, value : () -> String) -> Unit {
  <ui::Text in={parent} size={TX_BODY} color_by=>{lg::surface().ink_secondary} text_by=>{value()} />
}

///| A row whose control is a slider under its label (brightness, contrast, intensity, hue).
fn bp_slider_row(
  parent : view::View,
  icon : String,
  color_by : () -> Int64,
  label : String,
  value_text : () -> String,
  value : () -> Double,
  least : Double,
  most : Double,
  step : Double,
  on_change : (Double) -> Unit,
  on_commit : (Double) -> Unit,
  said : String,
  fill_color? : () -> Int64,
  tile? : (view::View) -> Unit,
  swatch? : () -> Int64,
  spectrum~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = parent.box(fn(blk : view::View) -> Unit {
    let _ = blk.padding(view::Live::Is((SP_0, SP_0, SP_0, SP_8)))
    bp_row(
      blk,
      icon,
      color_by,
      fn() { label },
      fn(tr : view::View) -> Unit {
        let _ = tr.box(fn(v : view::View) -> Unit {
          let _ = v.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_6)).rigid()
          match swatch {
            Some(col) => {
              let _ = v.box(fn(dot : view::View) -> Unit {
                let _ = dot
                .width(view::Live::Is(Some(SP_12)))
                .height(view::Live::Is(Some(SP_12)))
                .rigid()
                .radius(view::Live::Is(SP_6))
                .ground(view::Live::By(col))
                .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
              })
            }
            None => ()
          }
          bp_value(v, value_text)
        })
      },
      tile?=tile,
    )
    let _ = blk.box(fn(sl : view::View) -> Unit {
      let _ = sl.padding(view::Live::Is((bp_label_inset(), SP_0, SP_12, SP_0)))
      let _ = sl.box(fn(sw : view::View) -> Unit {
        if spectrum {
          // (the hue track is the color wheel itself, laid out under the slider's own clear track)
          let _ = sw.box(fn(under : view::View) -> Unit {
            let _ = under.over(view::Live::Is(true)).presses(view::Live::Is(false)).center()
            let _ = under.box(fn(strip : view::View) -> Unit {
              let _ = strip
              .row(view::Live::Is(true))
              .height(view::Live::Is(Some(SP_6)))
              .width(view::Live::By(fn() {
                let _ = under.laid_size_told()
                let (_, _, uw, _) = under.placed_now()
                Some(if uw > SP_8 { uw } else { SP_160 })
              }))
              .rigid()
              .radius(view::Live::Is(SP_4))
              .clips(view::Live::Is(true))
              let mut i = 0
              while i < 24 {
                let c = proto::boost_tint_rgba(proto::boost_hue_hex(i * 15))
                let _ = strip.box(fn(band : view::View) -> Unit {
                  let _ = band.grow(view::Live::Is(1.0)).ground(view::Live::Is(c))
                })
                i += 1
              }
            })
          })
        }
        let _ = lg::liquid_slider_node(
          sw,
          value,
          on_change,
          fn() { said },
          least=least,
          most=most,
          step=step,
          committed=on_commit,
          disabled~,
          fill_color?=if spectrum { Some(fn() { 0x00000000L }) } else { fill_color },
          track_color?=if spectrum { Some(fn() { 0x00000000L }) } else { None },
        )
      })
    })
  })
}

///| A recessed set of choices inside a card row (theme, typeface): the chosen one raised.
fn bp_choices(
  parent : view::View,
  items : Array[(String, String)],
  selected : () -> String,
  said_prefix : String,
  on_pick : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(track : view::View) -> Unit {
    let _ = track
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
    .gap(view::Live::Is(SP_2))
    .radius(view::Live::Is(SP_10))
    .ground(view::Live::By(fn() { lg::surface().card_secondary }))
    for item in items {
      let (id, label) = item
      let is_on = fn() -> Bool { selected() == id }
      let _ = headless::button(
        track,
        fn() { said_prefix + label },
        fn(_v : view::View) -> Unit { on_pick(id) },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let hover_t = motion::hover_fade(b, fn() { (btn.hovered() || btn.pressed()) && !is_on() })
          let _ = b
          .fill()
          .height(view::Live::Is(Some(SP_32)))
          .center()
          .radius(view::Live::Is(SP_8))
          .ground(view::Live::By(fn() -> Int64 {
            if is_on() {
              if lg::is_dark() { shell_wash_strong(true) } else { lg::surface().card }
            } else {
              lg::alpha(lg::surface().row_hover, hover_t())
            }
          }))
          .shadow(view::Live::By(fn() {
            let (blur, dy, col) = shell_row_lift(lg::is_dark())
            if is_on() { (blur, dy, col) } else { (blur, dy, lg::alpha(col, 0.0)) }
          }))
          let t = <ui::Text
            in={b}
            size={TX_FOOTNOTE}
            weight={500}
            lines={1}
            color_by=>{if is_on() { lg::surface().ink } else { lg::surface().ink_secondary }}
            text={label}
          />
          let _ = t.cut().allow_ellipsis(view::Live::Is(true))
        },
      )
    }
  })
}

///| A flat icon button inside the panel (32pt, eased wash on hover).
fn bp_icon_btn(
  parent : view::View,
  said : () -> String,
  icon : String,
  on_press : () -> Unit,
  color_by~ : () -> Int64 = fn() { lg::surface().ink_secondary },
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = headless::button(
    parent,
    said,
    fn(_v : view::View) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .rigid()
      .center()
      .radius(view::Live::Is(SP_8))
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      let _ = shell_icon(b, icon, size=IC_MD, color_by=fn() {
        if disabled() { lg::alpha(color_by(), 0.4) } else { color_by() }
      })
    },
  )
}

///| A text button in a card or the footer (32pt; `tinted` for the action of a group, `danger` for Reset).
fn bp_text_btn(
  parent : view::View,
  said : () -> String,
  text : String,
  on_press : () -> Unit,
  tinted~ : Bool = false,
  danger~ : Bool = false,
  icon~ : String = "",
  disabled~ : () -> Bool = fn() { false },
  corner~ : Double = SP_8,
) -> Unit {
  let _ = headless::button(
    parent,
    said,
    fn(_v : view::View) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let ink = fn() -> Int64 {
        let base = if danger { lg::surface().danger } else if tinted { bp_link_ink() } else { lg::surface().ink }
        if disabled() { lg::alpha(base, 0.4) } else { base }
      }
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .rigid()
      .padding(view::Live::Is((SP_10, SP_0, SP_10, SP_0)))
      .gap(view::Live::Is(SP_6))
      .radius(view::Live::Is(corner))
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      if icon != "" {
        let _ = shell_icon(b, icon, size=IC_MD, color_by=ink)
      }
      <ui::Text in={b} size={TX_BODY} weight={500} color_by=>{ink()} text={text} />
    },
  )
}

///| A code editor under its header row (whose trailing control is Apply): the field over a code ground.
fn bp_code_card(
  parent : view::View,
  field : ui::Field,
  said : String,
  placeholder : String,
  on_edited~ : Option[(String) -> Unit] = None,
) -> Unit {
  let _ = parent.box(fn(blk : view::View) -> Unit {
    let _ = blk.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_12)))
    let _ = blk.box(fn(fw : view::View) -> Unit {
      let _ = fw
      .min_height(view::Live::Is(Some(SP_80)))
      .padding(view::Live::Is((SP_10, SP_8, SP_10, SP_8)))
      .radius(view::Live::Is(SP_8))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() { lg::surface().code_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if field.focused() { (lg::hairline_w * 3.0, lg::surface().accent) } else { (lg::hairline_w, lg::surface().separator) }
      }))
      let typed = ui::field(
        fw,
        field,
        placeholder=placeholder,
        font_size=TX_FOOTNOTE,
        min_lines=4,
        max_lines=10,
        enter_sends=false,
        label=said,
        colors_by=fn() { (lg::surface().ink, lg::surface().ink_tertiary, lg::surface().accent) },
        edited=fn(raw : String) -> Unit {
          match on_edited {
            Some(cb) => cb(raw)
            None => ()
          }
        },
      )
      let _ = typed.fill()
    })
  })
}

///| What a boost changes, in a few words (the All Boosts rows).
fn bp_boost_summary(b : proto::SiteBoost) -> String {
  let parts : Array[String] = []
  let theme = proto::normalize_boost_theme(b.theme)
  if theme == "dark" {
    parts.push("Dark")
  } else if theme == "sepia" {
    parts.push("Sepia")
  } else if theme == "contrast" {
    parts.push("High contrast")
  }
  if proto::normalize_boost_tint(b.tint) != "" {
    parts.push("Tint")
  }
  if b.invert {
    parts.push("Inverted")
  }
  let font = proto::normalize_boost_font(b.font)
  if font == "sans" {
    parts.push("Sans")
  } else if font == "serif" {
    parts.push("Serif")
  } else if font == "mono" {
    parts.push("Mono")
  }
  let scale = proto::clamp_boost_scale_pct(b.scale_pct)
  if scale != proto::BOOST_SCALE_DEFAULT {
    parts.push(scale.to_string() + "% text")
  }
  let zapped = proto::normalize_boost_zapped(b.zapped).length()
  if zapped == 1 {
    parts.push("1 hidden")
  } else if zapped > 1 {
    parts.push(zapped.to_string() + " hidden")
  }
  if proto::sanitize_boost_custom_css(b.custom_css) != "" {
    parts.push("CSS")
  }
  if proto::sanitize_boost_custom_js(b.custom_js) != "" {
    parts.push("JavaScript")
  }
  if parts.length() == 0 {
    "No changes"
  } else if parts.length() > 3 {
    // (one line: the first two, then how many more)
    parts[0] + ", " + parts[1] + ", " + (parts.length() - 2).to_string() + " more"
  } else {
    parts.join(", ")
  }
}

///| The name of a tint in the palette, or "Custom".
fn bp_tint_name(hex : String) -> String {
  let h = proto::normalize_boost_tint(hex)
  if h == "" {
    return "None"
  }
  for sw in proto::boost_tint_palette() {
    if sw.1 == h {
      return sw.0
    }
  }
  // (a hue off the swatches is named by its color code)
  bp_hex_upper(h)
}

///| `#5a57d6` as `#5A57D6`.
fn bp_hex_upper(h : String) -> String {
  let digits = "0123456789ABCDEF"
  let mut out = ""
  let mut i = 0
  while i < h.length() {
    let c = h.code_unit_at(i).to_int()
    if c >= 0x61 && c <= 0x66 {
      let k = c - 0x61 + 10
      out = out + digits.slice(k, k + 1)
    } else {
      out = out + h.slice(i, i + 1)
    }
    i += 1
  }
  out
}

///| A slider's value while it is dragged (`-1` at rest: the boost's own value shows); back to rest when the
///| boost's value changes (the save came back).
fn bp_drag_value(host : view::View, saved : () -> Int) -> signals::Signal[Double] {
  let live : signals::Signal[Double] = signals::signal(-1.0)
  host.reacts(at_start=false, saved, fn(_v : Int) -> Unit { live.set(-1.0) })
  live
}

///| Builds the Site Boosts panel bound to `props.target_origin` (floating glass, solid grouped lists inside).
pub fn build_site_boosts_panel(
  root : view::View,
  props : SiteBoostsProps,
  initial_section~ : Int = 0,
  initial_all~ : Bool = false,
) -> Unit {
  let bound_origin = fn() -> String { (props.target_origin)().trim() }
  let has_origin = fn() -> Bool { bound_origin() != "" }
  let no_origin = fn() -> Bool { !has_origin() }
  let live_win_w = fn() -> Double {
    let _ = root.laid_size_told()
    let ww = root.window_w()
    if ww > SP_96 {
      ww
    } else {
      let (_, _, rw, _) = root.placed_now()
      if rw > SP_96 { rw } else { SP_160 * 8.0 }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = root.laid_size_told()
    let wh = root.window_h()
    if wh > SP_96 {
      wh
    } else {
      let (_, _, _, rh) = root.placed_now()
      if rh > SP_96 { rh } else { SP_160 * 5.0 }
    }
  }
  let panel_top = fn() -> Double {
    let top = (props.anchor_top)()
    if top > SP_8 { top } else { SP_8 }
  }
  let safe_save = fn(next_b : proto::SiteBoost) -> Unit {
    let origin = signals::untracked(bound_origin)
    if origin == "" {
      return
    }
    (props.on_save)(origin, proto::SiteBoost::{ ..next_b, host: origin })
  }
  let cur = fn() -> proto::SiteBoost { signals::untracked(props.boost) }
  let apply_code = fn(next_b : proto::SiteBoost) -> Unit {
    let origin = signals::untracked(bound_origin)
    if origin == "" {
      return
    }
    let target = proto::SiteBoost::{ ..next_b, host: origin, enabled: true }
    match props.on_apply_css {
      Some(cb) => cb(origin, target)
      None => (props.on_save)(origin, target)
    }
  }
  // Sections: 0 Colors, 1 Fonts, 2 Zap, 3 Code; `sites` shows All Boosts instead.
  let section : signals::Signal[Int] = signals::signal(initial_section)
  let sites : signals::Signal[Bool] = signals::signal(initial_all)
  let host_label = fn() -> String {
    let o = bound_origin()
    if o != "" { o } else { "This page" }
  }

  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    let hue_drag = bp_drag_value(layer, fn() { proto::boost_tint_hue((props.boost)().tint) })
    let tint_drag = bp_drag_value(layer, fn() { (props.boost)().tint_pct })
    let bright_drag = bp_drag_value(layer, fn() { (props.boost)().brightness_pct })
    let contrast_drag = bp_drag_value(layer, fn() { (props.boost)().contrast_pct })
    let _ = headless::dialog(
      layer,
      fn() { "Site Boosts" },
      props.open,
      props.on_close,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
          (None, Some(panel_top()), Some(SP_8), None)
        }))

        let _ = lg::liquid_dialog_shell_node(
          dlg_box,
          fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() -> Option[Double] {
              let rw = live_win_w()
              let wide = SP_160 * 2.0 + SP_64
              if rw < SHELL_SIDEBAR_BREAKPOINT || rw < wide + SP_16 { Some(rw - SP_16) } else { Some(wide) }
            }))
            .height(view::Live::By(fn() -> Option[Double] {
              let avail = live_win_h() - panel_top() - SP_8
              let most = SP_160 * 5.0
              Some(if avail < most { avail } else { most })
            }))
            .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
            .gap(view::Live::Is(SP_8))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // 1. Header: the site (or the All Boosts breadcrumb), the boost's toggle, Close.
            let _ = shell.box(fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .min_height(view::Live::Is(Some(SP_48)))
              .padding(view::Live::Is((SP_8, SP_4, SP_4, SP_4)))
              .gap(view::Live::Is(SP_10))
              hdr.show(fn() { sites.get() }, fn(back : view::View) -> Unit {
                let _ = back.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_10)).fill()
                bp_icon_btn(back, fn() { "Back to Boost" }, ICON_BACK, fn() { sites.set(false) }, color_by=fn() { lg::surface().ink })
                let _ = shell_glyph_tile(back, ICON_SPARKLES, bp_tile(BP_PURPLE), size=SP_24)
                <ui::Text in={back} size={TX_CALLOUT} weight={600} color_by=>{lg::surface().ink} text="All Boosts" />
              })
              hdr.show(fn() { !sites.get() }, fn(site : view::View) -> Unit {
                let _ = site.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_10)).fill()
                bp_site_tile(site, bound_origin, size=SP_32)
                let _ = site.box(fn(tcol : view::View) -> Unit {
                  let _ = tcol.fill().gap(view::Live::Is(SP_2))
                  <ui::Text in={tcol} size={TX_CALLOUT} weight={600} color_by=>{lg::surface().ink} text="Boost" />
                  let sub = <ui::Text
                    in={tcol}
                    size={TX_FOOTNOTE}
                    lines={1}
                    color_by=>{lg::surface().ink_secondary}
                    text_by=>{if has_origin() { bound_origin() } else { "Boosts work on http and https sites" }}
                  />
                  let _ = sub.cut().allow_ellipsis(view::Live::Is(true))
                })
                let _ = lg::liquid_toggle_node(
                  site,
                  fn() { has_origin() && (props.boost)().enabled },
                  fn(on : Bool) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: on }) },
                  fn() { "Toggle Boost Active" },
                  disabled=no_origin,
                )
              })
              bp_icon_btn(hdr, fn() { "Close Site Boosts" }, ICON_CLOSE, props.on_close)
            })

            // 2. Sections
            hdr_sections(shell, section, sites)

            // 3. The section's grouped lists, scrolling under the header.
            let _ = shell.box(fn(body_host : view::View) -> Unit {
              let _ = body_host.fill().clips(view::Live::Is(true))
              let _ = ui::scroll_box(body_host, fn(body : view::View) -> Unit {
                let _ = body.padding(view::Live::Is((SP_0, SP_4, SP_0, SP_8))).gap(view::Live::Is(SP_20))
                body.switch_by(
                  fn() -> Int { if sites.get() { 9 } else { section.get() } },
                  fn(page : view::View, key : Int) -> Unit {
                    let _ = page.gap(view::Live::Is(SP_20))
                    if key == 0 {
                      build_colors_section(page, props, has_origin, safe_save, cur, hue_drag, tint_drag, bright_drag, contrast_drag)
                    } else if key == 1 {
                      build_fonts_section(page, props, has_origin, safe_save, cur)
                    } else if key == 2 {
                      build_zap_section(page, props, has_origin, no_origin, safe_save, cur, host_label)
                    } else if key == 3 {
                      build_code_section(page, props, no_origin, cur, apply_code, host_label)
                    } else {
                      build_sites_section(page, props, bound_origin)
                    }
                  },
                )
              })
            })

            // 4. Footer: All Boosts and Reset.
            shell.show(fn() { !sites.get() }, fn(ftr : view::View) -> Unit {
              let _ = ftr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Between))
              .rigid()
              .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
              bp_text_btn(ftr, fn() { "Show All Boosts" }, "All Boosts", fn() { sites.set(true) }, icon=BP_IC_LIST)
              bp_text_btn(
                ftr,
                fn() { "Reset Site Boost" },
                "Reset",
                fn() {
                  let origin = signals::untracked(bound_origin)
                  if origin == "" {
                    return
                  }
                  props.css_field.set("")
                  props.js_field.set("")
                  if signals::untracked(props.zap_active) {
                    (props.on_zap)(false)
                  }
                  (props.on_reset)(origin)
                },
                danger=true,
                disabled=no_origin,
              )
            })
          },
          radius=SP_24,
        )
      },
      modal=false,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if props.css_field.composing() {
            props.css_field.compose("")
            return true
          }
          if props.js_field.composing() {
            props.js_field.compose("")
            return true
          }
          // (Escape while picking ends Zap first; the next one closes the panel)
          if signals::untracked(props.zap_active) {
            (props.on_zap)(false)
            return true
          }
          false
        } else if how is headless::OverlayDismiss::Outside {
          // (while Zap is on, a click on the page picks an element: the panel stays)
          signals::untracked(props.zap_active)
        } else {
          false
        }
      },
    )
  })
}

///| The section switch under the header (hidden on All Boosts).
fn hdr_sections(shell : view::View, section : signals::Signal[Int], sites : signals::Signal[Bool]) -> Unit {
  shell.show(fn() { !sites.get() }, fn(segw : view::View) -> Unit {
    let _ = segw.rigid().padding(view::Live::Is((SP_4, SP_0, SP_4, SP_4)))
    let _ = lg::liquid_segmented_node(
      segw,
      fn() { ["Colors", "Fonts", "Zap", "Code"] },
      fn() { section.get() },
      fn(i : Int) -> Unit { section.set(i) },
      height=SP_32,
      text_size=fn() { TX_FOOTNOTE },
      said="Boost Sections",
      flat=true,
      widths=fn() {
        let _ = segw.laid_size_told()
        let (_, _, w, _) = segw.placed_now()
        let inner = if w > SP_160 { w - SP_8 - SP_4 } else { SP_160 * 2.0 - SP_12 }
        let each = inner / 4.0
        [each, each, each, each]
      },
    )
  })
}

fn build_colors_section(
  page : view::View,
  props : SiteBoostsProps,
  has_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
  hue_drag : signals::Signal[Double],
  tint_drag : signals::Signal[Double],
  bright_drag : signals::Signal[Double],
  contrast_drag : signals::Signal[Double],
) -> Unit {
  let boost = props.boost
  let tint_on = fn() -> Bool { has_origin() && proto::normalize_boost_tint(boost().tint) != "" }
  let tint_color = fn() -> Int64 {
    let h = hue_drag.get()
    if h >= 0.0 {
      proto::boost_tint_rgba(proto::boost_hue_hex(h.to_int()))
    } else if tint_on() {
      proto::boost_tint_rgba(boost().tint)
    } else {
      shell_tile_palette()[BP_GRAY]
    }
  }

  // The tint's name as the hue slider moves (or the saved tint's): the Tint subtitle and the Hue value.
  let tint_label = fn() -> String {
    if hue_drag.get() >= 0.0 {
      bp_tint_name(proto::boost_hue_hex(hue_drag.get().to_int()))
    } else if tint_on() {
      bp_tint_name(boost().tint)
    } else {
      ""
    }
  }

  // Theme
  bp_group(page, fn() { "" }, fn() { "" }, fn(card : view::View) -> Unit {
    let _ = card.box(fn(blk : view::View) -> Unit {
      let _ = blk.padding(view::Live::Is((SP_0, SP_0, SP_0, SP_12)))
      bp_row(blk, ICON_LAYERS, bp_tile(BP_PURPLE), fn() { "Theme" }, fn(_t : view::View) -> Unit { () })
      let _ = blk.box(fn(ch : view::View) -> Unit {
        let _ = ch.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
        bp_choices(
          ch,
          [("auto", "Original"), ("dark", "Dark"), ("sepia", "Sepia"), ("contrast", "Contrast")],
          fn() { if has_origin() { proto::normalize_boost_theme(boost().theme) } else { "auto" } },
          "Boost Theme ",
          fn(id : String) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, theme: id }) },
        )
      })
    })
  })

  // Tint: on/off, swatches, hue, intensity
  bp_group(page, fn() { "" }, fn() { "" }, fn(card : view::View) -> Unit {
    bp_row(card, BP_IC_PALETTE, tint_color, fn() { "Tint" }, fn(tr : view::View) -> Unit {
      let _ = lg::liquid_toggle_node(
        tr,
        tint_on,
        fn(on : Bool) -> Unit {
          let b = cur()
          if on {
            let t = if proto::normalize_boost_tint(b.tint) != "" { b.tint } else { "#007aff" }
            safe_save(proto::SiteBoost::{ ..b, enabled: true, tint: t })
          } else {
            safe_save(proto::SiteBoost::{ ..b, tint: "" })
          }
        },
        fn() { "Toggle Boost Tint" },
        disabled=fn() { !has_origin() },
      )
    }, sub=fn() { if tint_on() { tint_label() } else { "Colors the page's background and links" } })
    card.show(tint_on, fn(more : view::View) -> Unit {
      bp_rule(more)
      // Swatches
      let _ = more.box(fn(sw : view::View) -> Unit {
        let _ = sw
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
        for item in proto::boost_tint_palette() {
          let (name, hex) = item
          let rgba = proto::boost_tint_rgba(hex)
          let is_sel = fn() -> Bool { hue_drag.get() < 0.0 && proto::normalize_boost_tint(boost().tint) == hex }
          let _ = headless::button(
            sw,
            fn() { "Boost Tint " + name },
            fn(_v : view::View) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, tint: hex }) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let hover_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
              let _ = b.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).rigid().center()
              let _ = b.box(fn(ring : view::View) -> Unit {
                let _ = ring
                .width(view::Live::Is(Some(SP_24)))
                .height(view::Live::Is(Some(SP_24)))
                .rigid()
                .center()
                .radius(view::Live::Is(SP_12))
                .ground(view::Live::By(fn() { if is_sel() { 0x00000000L } else { rgba } }))
                .edge(view::Live::By(fn() { if is_sel() { (SP_2, rgba) } else { (SP_0, 0x00000000L) } }))
                .offset(view::Live::By(fn() { (SP_0, SP_0 - hover_t()) }))
                ring.show(is_sel, fn(dot : view::View) -> Unit {
                  let _ = dot.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(SP_16))).rigid().radius(view::Live::Is(SP_8)).ground(view::Live::Is(rgba))
                })
              })
            },
          )
        }
      })
      bp_rule(more)
      bp_slider_row(
        more,
        "",
        tint_color,
        "Hue",
        tint_label,
        fn() { if hue_drag.get() >= 0.0 { hue_drag.get() } else { proto::boost_tint_hue(boost().tint).to_double() } },
        0.0,
        359.0,
        1.0,
        fn(v : Double) -> Unit { hue_drag.set(v) },
        fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, tint: proto::boost_hue_hex(v.to_int()) }) },
        "Boost Tint Hue",
        tile=fn(h : view::View) { bp_hue_tile(h) },
        swatch=tint_color,
        spectrum=true,
      )
      bp_rule(more)
      bp_slider_row(
        more,
        "",
        tint_color,
        "Intensity",
        fn() {
          let v = if tint_drag.get() >= 0.0 { tint_drag.get().to_int() } else { boost().tint_pct }
          v.to_string() + "%"
        },
        fn() { if tint_drag.get() >= 0.0 { tint_drag.get() } else { boost().tint_pct.to_double() } },
        0.0,
        100.0,
        5.0,
        fn(v : Double) -> Unit { tint_drag.set(v) },
        fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, tint_pct: proto::clamp_boost_tint_pct(v.to_int()) }) },
        "Boost Tint Intensity",
        fill_color=tint_color,
        tile=fn(h : view::View) { bp_ring_tile(h, tint_color, false) },
      )
    })
  })

  // Brightness, contrast, invert
  bp_group(page, fn() { "Adjust" }, fn() { "Invert keeps pictures and video in their own colors." }, fn(card : view::View) -> Unit {
    let pct_text = fn(drag : signals::Signal[Double], saved : () -> Int) -> () -> String {
      fn() {
        let v = if drag.get() >= 0.0 { drag.get().to_int() } else { saved() }
        v.to_string() + "%"
      }
    }
    bp_slider_row(
      card,
      ICON_SUN,
      bp_tile(BP_ORANGE),
      "Brightness",
      pct_text(bright_drag, fn() { boost().brightness_pct }),
      fn() { if bright_drag.get() >= 0.0 { bright_drag.get() } else { boost().brightness_pct.to_double() } },
      proto::BOOST_ADJUST_MIN.to_double(),
      proto::BOOST_ADJUST_MAX.to_double(),
      5.0,
      fn(v : Double) -> Unit { bright_drag.set(v) },
      fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, brightness_pct: proto::clamp_boost_adjust_pct(v.to_int()) }) },
      "Boost Brightness",
      disabled=fn() { !has_origin() },
    )
    bp_rule(card)
    bp_slider_row(
      card,
      "",
      bp_tile(BP_GRAY),
      "Contrast",
      pct_text(contrast_drag, fn() { boost().contrast_pct }),
      fn() { if contrast_drag.get() >= 0.0 { contrast_drag.get() } else { boost().contrast_pct.to_double() } },
      proto::BOOST_ADJUST_MIN.to_double(),
      proto::BOOST_ADJUST_MAX.to_double(),
      5.0,
      fn(v : Double) -> Unit { contrast_drag.set(v) },
      fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, contrast_pct: proto::clamp_boost_adjust_pct(v.to_int()) }) },
      "Boost Contrast",
      disabled=fn() { !has_origin() },
      tile=fn(h : view::View) { bp_ring_tile(h, bp_tile(BP_GRAY), true) },
    )
    bp_rule(card)
    bp_row(card, ICON_MOON, bp_tile(BP_INDIGO), fn() { "Invert colors" }, fn(tr : view::View) -> Unit {
      let _ = lg::liquid_toggle_node(
        tr,
        fn() { has_origin() && boost().invert },
        fn(on : Bool) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, invert: on }) },
        fn() { "Toggle Boost Invert" },
        disabled=fn() { !has_origin() },
      )
    })
  })
}

fn build_fonts_section(
  page : view::View,
  props : SiteBoostsProps,
  has_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
) -> Unit {
  let boost = props.boost
  bp_group(page, fn() { "" }, fn() { "" }, fn(card : view::View) -> Unit {
    let _ = card.box(fn(blk : view::View) -> Unit {
      let _ = blk.padding(view::Live::Is((SP_0, SP_0, SP_0, SP_12)))
      bp_row(blk, "", bp_tile(BP_BLUE), fn() { "Typeface" }, fn(_t : view::View) -> Unit { () }, tile=fn(h : view::View) {
        bp_letters_tile(h, bp_tile(BP_BLUE), false)
      })
      let _ = blk.box(fn(ch : view::View) -> Unit {
        let _ = ch.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
        bp_choices(
          ch,
          [("default", "Original"), ("sans", "Sans"), ("serif", "Serif"), ("mono", "Mono")],
          fn() { if has_origin() { proto::normalize_boost_font(boost().font) } else { "default" } },
          "Boost Font ",
          fn(id : String) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, font: id }) },
        )
      })
    })
  })
  bp_group(page, fn() { "" }, fn() { "Scales the page's text from 90% to 130%." }, fn(card : view::View) -> Unit {
    bp_row(card, "", bp_tile(BP_TEAL), fn() { "Text size" }, fn(tr : view::View) -> Unit {
      let _ = tr.box(fn(st : view::View) -> Unit {
        let _ = st.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).rigid()
        let step = fn(icon : String, said : String, delta : Int) -> Unit {
          bp_icon_btn(
            st,
            fn() { said },
            icon,
            fn() {
              let b = cur()
              safe_save(proto::SiteBoost::{ ..b, enabled: true, scale_pct: proto::clamp_boost_scale_pct(b.scale_pct + delta) })
            },
            color_by=fn() { lg::surface().ink },
            disabled=fn() { !has_origin() },
          )
        }
        step("minus", "Decrease Boost Text Size", -5)
        let _ = st.box(fn(pv : view::View) -> Unit {
          let _ = pv.width(view::Live::Is(Some(SP_40))).rigid().center()
          <ui::Text
            in={pv}
            size={TX_BODY}
            weight={500}
            color_by=>{lg::surface().ink}
            text_by=>{proto::clamp_boost_scale_pct(boost().scale_pct).to_string() + "%"}
          />
        })
        step(ICON_PLUS, "Increase Boost Text Size", 5)
      })
    }, tile=fn(h : view::View) { bp_letters_tile(h, bp_tile(BP_TEAL), true) })
  })
}

fn build_zap_section(
  page : view::View,
  props : SiteBoostsProps,
  has_origin : () -> Bool,
  no_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
  host_label : () -> String,
) -> Unit {
  let boost = props.boost
  let zapped = fn() -> Array[String] { if has_origin() { proto::normalize_boost_zapped(boost().zapped) } else { [] } }
  bp_group(
    page,
    fn() { "" },
    fn() {
      if (props.zap_active)() {
        "Click anything on the page to hide it. Press Escape when you are done."
      } else {
        "Hide parts of " + host_label() + " you never want to see. They stay hidden on every visit."
      }
    },
    fn(card : view::View) -> Unit {
      bp_row(card, ICON_ZAP, bp_tile(BP_PINK), fn() { "Zap elements" }, fn(tr : view::View) -> Unit {
        let _ = lg::liquid_toggle_node(
          tr,
          fn() { has_origin() && (props.zap_active)() },
          fn(on : Bool) -> Unit { (props.on_zap)(on) },
          fn() { "Zap Elements" },
          disabled=no_origin,
        )
      })
      bp_rule(card)
      bp_row(card, ICON_SHIELD, bp_tile(BP_RED), fn() { "Hide pop-ups and banners" }, fn(tr : view::View) -> Unit {
        let _ = lg::liquid_toggle_node(
          tr,
          fn() { has_origin() && boost().hide_sticky },
          fn(next_hide : Bool) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, hide_sticky: next_hide }) },
          fn() { "Toggle Hide Sticky Overlays" },
          disabled=no_origin,
        )
      }, sub=fn() { "Cookie notices and promos" })
    },
  )
  page.show(fn() { zapped().length() > 0 }, fn(hidden : view::View) -> Unit {
    bp_group(hidden, fn() { "Hidden on " + host_label() }, fn() { "" }, fn(card : view::View) -> Unit {
      card.switch_by(
        fn() -> String { zapped().join("\n") },
        fn(list : view::View, _k : String) -> Unit {
          let items = signals::untracked(zapped)
          let mut i = 0
          while i < items.length() {
            let sel = items[i]
            if i > 0 {
              bp_rule(list, inset=SP_12)
            }
            // (a selector per row at the card's inset: no tile, the caption says what they are)
            let _ = list.box(fn(row : view::View) -> Unit {
              let _ = row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .min_height(view::Live::Is(Some(SP_40)))
              .padding(view::Live::Is((SP_12, SP_4, SP_8, SP_4)))
              .gap(view::Live::Is(SP_12))
              let _ = row.box(fn(tw : view::View) -> Unit {
                let _ = tw.fill().clips(view::Live::Is(true))
                let _ = tw.words_runs(
                  view::Live::By(fn() { [rb_make_run(sel, lg::surface().ink, "mono")] }),
                  ink=lg::surface().ink,
                  look=view::WordsLook::of(TX_FOOTNOTE, wrap=true, max_lines=2),
                )
              })
              bp_icon_btn(
                row,
                fn() { "Restore " + sel },
                BP_IC_EYE,
                fn() { safe_save(proto::boost_zap_remove(cur(), sel)) },
                color_by=fn() { lg::surface().accent },
              )
            })
            i += 1
          }
          bp_rule(list, inset=SP_12)
          let _ = list.box(fn(all_row : view::View) -> Unit {
            // (the button's own SP_10 padding puts its label at the card's SP_12 inset)
            let _ = all_row.row(view::Live::Is(true)).padding(view::Live::Is((SP_2, SP_4, SP_8, SP_4)))
            bp_text_btn(
              all_row,
              fn() { "Restore All Zapped" },
              "Show all hidden elements",
              fn() { safe_save(proto::SiteBoost::{ ..cur(), zapped: [] }) },
              tinted=true,
            )
          })
        },
      )
    })
  })
}

fn build_code_section(
  page : view::View,
  props : SiteBoostsProps,
  no_origin : () -> Bool,
  cur : () -> proto::SiteBoost,
  apply_code : (proto::SiteBoost) -> Unit,
  host_label : () -> String,
) -> Unit {
  bp_group(page, fn() { "" }, fn() { "Added after the page's own styles." }, fn(card : view::View) -> Unit {
    bp_row(card, BP_IC_CODE, bp_tile(BP_BLUE), fn() { "CSS" }, fn(tr : view::View) -> Unit {
      bp_text_btn(
        tr,
        fn() { "Apply Custom CSS" },
        "Apply",
        fn() { apply_code(proto::SiteBoost::{ ..cur(), custom_css: props.css_field.text() }) },
        tinted=true,
        disabled=no_origin,
        corner=lg::concentric(SP_12, SP_8),
      )
    }, trail_pad=SP_2)
    bp_code_card(card, props.css_field, "Custom CSS", "article { max-width: 72ch; }", on_edited=props.on_css_edited)
  })
  bp_group(
    page,
    fn() { "" },
    fn() { "Runs on " + host_label() + " each time one of its pages loads, with the same access as the page's own scripts." },
    fn(card : view::View) -> Unit {
      bp_row(card, BP_IC_FILE_CODE, bp_tile(BP_ORANGE), fn() { "JavaScript" }, fn(tr : view::View) -> Unit {
        bp_text_btn(
          tr,
          fn() { "Apply Custom JavaScript" },
          "Apply",
          fn() { apply_code(proto::SiteBoost::{ ..cur(), custom_js: props.js_field.text() }) },
          tinted=true,
          disabled=no_origin,
          corner=lg::concentric(SP_12, SP_8),
        )
      }, trail_pad=SP_2)
      bp_code_card(card, props.js_field, "Custom JavaScript", "document.querySelector('#comments')?.remove();")
    },
  )
}

fn build_sites_section(page : view::View, props : SiteBoostsProps, bound_origin : () -> String) -> Unit {
  let list_all = fn() -> Array[proto::SiteBoost] {
    let out : Array[proto::SiteBoost] = []
    for b in (props.all_boosts)() {
      if proto::normalize_boost_host(b.host) != "" {
        out.push(b)
      }
    }
    out
  }
  let here = fn() -> String { proto::normalize_boost_host(bound_origin()) }
  let pick = fn(mine : Bool) -> Array[proto::SiteBoost] {
    let h = here()
    let out : Array[proto::SiteBoost] = []
    for b in list_all() {
      if (h != "" && proto::normalize_boost_host(b.host) == h) == mine {
        out.push(b)
      }
    }
    out
  }
  let this_site = fn() -> Array[proto::SiteBoost] { pick(true) }
  let others = fn() -> Array[proto::SiteBoost] { pick(false) }
  // (the host whose row asks to confirm its delete, "" for none)
  let confirm : signals::Signal[String] = signals::signal("")
  let key_of = fn(items : Array[proto::SiteBoost]) -> String {
    let parts : Array[String] = [confirm.get()]
    for b in items {
      parts.push(b.host + (if b.enabled { "+" } else { "-" }) + bp_boost_summary(b))
    }
    parts.join("\n")
  }
  let rows_of = fn(list : view::View, items : Array[proto::SiteBoost]) -> Unit {
    let mut i = 0
    while i < items.length() {
      let b = items[i]
      let host = proto::normalize_boost_host(b.host)
      if i > 0 {
        bp_rule(list)
      }
      bp_site_row(list, props, b, host, confirm)
      i += 1
    }
  }
  page.show(fn() { list_all().length() == 0 }, fn(empty : view::View) -> Unit {
    bp_group(empty, fn() { "Boosted sites" }, fn() { "" }, fn(card : view::View) -> Unit {
      let _ = card.box(fn(e : view::View) -> Unit {
        let _ = e.padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
        <ui::Text
          in={e}
          size={TX_BODY}
          wrap
          color_by=>{lg::surface().ink_secondary}
          text="No boosts yet. Change anything in a site's Boost and it is listed here."
        />
      })
    })
  })
  page.show(fn() { this_site().length() > 0 }, fn(g : view::View) -> Unit {
    bp_group(g, fn() { "This site" }, fn() { "" }, fn(card : view::View) -> Unit {
      card.switch_by(fn() -> String { key_of(this_site()) }, fn(list : view::View, _k : String) -> Unit {
        rows_of(list, signals::untracked(this_site))
      })
    })
  })
  page.show(fn() { others().length() > 0 }, fn(g : view::View) -> Unit {
    bp_group(
      g,
      fn() { if this_site().length() > 0 { "Other sites" } else { "Boosted sites" } },
      fn() { "A boost applies to every page of its site." },
      fn(card : view::View) -> Unit {
        card.switch_by(fn() -> String { key_of(others()) }, fn(list : view::View, _k : String) -> Unit {
          rows_of(list, signals::untracked(others))
        })
      },
    )
  })
}

///| One boosted site: its tile beside the host, what the boost changes under it; trailing delete, open in a new
///| tab and the boost's toggle. Delete asks once more in place (it drops the site's code and hidden elements too).
fn bp_site_row(
  list : view::View,
  props : SiteBoostsProps,
  b : proto::SiteBoost,
  host : String,
  confirm : signals::Signal[String],
) -> Unit {
  let asking = fn() -> Bool { confirm.get() == host }
  let _ = list.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_48)))
    .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
    .gap(view::Live::Is(SP_8))
    let _ = row.box(fn(main : view::View) -> Unit {
      let _ = main.fill().gap(view::Live::Is(SP_2))
      let _ = main.box(fn(head : view::View) -> Unit {
        let _ = head.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_12))
        bp_site_tile(head, fn() { host }, size=SP_24)
        let _ = head.box(fn(tw : view::View) -> Unit {
          let _ = tw.fill()
          let h = <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text={host} />
          let _ = h.cut().allow_ellipsis(view::Live::Is(true))
        })
      })
      let _ = main.box(fn(sv : view::View) -> Unit {
        let _ = sv.padding(view::Live::Is((SP_24 + SP_12, SP_0, SP_0, SP_0)))
        let s = <ui::Text
          in={sv}
          size={TX_FOOTNOTE}
          lines={1}
          color_by=>{if asking() { lg::surface().danger } else { lg::surface().ink_secondary }}
          text_by=>{if asking() { "Its colors, code and hidden elements go too." } else { bp_boost_summary(b) }}
        />
        let _ = s.cut().allow_ellipsis(view::Live::Is(true))
      })
    })
    row.show(asking, fn(ask : view::View) -> Unit {
      let _ = ask.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).rigid()
      bp_text_btn(ask, fn() { "Keep Boost for " + host }, "Cancel", fn() { confirm.set("") })
      bp_text_btn(
        ask,
        fn() { "Confirm Delete Boost for " + host },
        "Delete",
        fn() {
          confirm.set("")
          (props.on_site_delete)(host)
        },
        danger=true,
      )
    })
    row.show(fn() { !asking() }, fn(acts : view::View) -> Unit {
      let _ = acts.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).rigid()
      bp_icon_btn(acts, fn() { "Delete Boost for " + host }, BP_IC_TRASH, fn() { confirm.set(host) })
      bp_icon_btn(acts, fn() { "Open " + host }, BP_IC_OPEN, fn() { (props.on_site_open)(host) })
      let _ = acts.box(fn(gap : view::View) -> Unit {
        let _ = gap.width(view::Live::Is(Some(SP_4))).rigid()
      })
      let _ = lg::liquid_toggle_node(
        acts,
        fn() { b.enabled },
        fn(on : Bool) -> Unit { (props.on_site_save)(proto::SiteBoost::{ ..b, host, enabled: on }) },
        fn() { "Boost " + host },
      )
    })
  })
}

