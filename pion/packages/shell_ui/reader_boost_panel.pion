///| Farview Shell 3 — Reader Mode and Site Boosts.
///|
///| 1. Reader Mode (`build_reader_mode_panel`): a solid reading surface over the pane it belongs to (Light / Sepia /
///|    Night paper, no glass). One quiet bar on top: the site, then paper, text size, typeface and column width,
///|    and Exit; a 2pt reading progress line under it; the article in a centered column below.
///| 2. Site Boosts (`build_site_boosts_panel`): Arc's compact Boost editor, one floating glass panel at the page's
///|    right edge bound to `target_origin`, solid content inside. Header: close, the site's name (its chevron opens
///|    All Boosts: every boosted site, on/off, open, delete), reset. Then a color canvas (the tint and a second
///|    color as handles in a gradient frame), Dark / fine controls (themes, intensity, brightness, contrast, invert,
///|    pop-ups) / no color, the typeface grid, Size and Case, Zap (filled while picking, with what it hid) and Code
///|    (the site's CSS and JavaScript). Glyph tiles are monochrome; color is the boost's own.

import "headless"
import "lg"
import "motion"
import "paint"
import "proto"
import "signals"
import "text"
import "ui"
import "view"

pub let READER_STATUS_LOADING : Int = 0
pub let READER_STATUS_INCOMPATIBLE : Int = 1
pub let READER_STATUS_READY : Int = 2

///| Strongly typed props for `build_reader_mode_panel`.
pub struct ReaderModeProps {
  pub open : () -> Bool
  pub owner_pane : PaneId
  pub article : () -> proto::ReaderArticle
  pub rev : () -> Int
  pub status : () -> Int
  pub theme : () -> String
  pub font : () -> String
  pub font_size : () -> Int
  pub width_mode : () -> String
  pub progress : () -> Double
  pub on_theme : (String) -> Unit
  pub on_font : (String) -> Unit
  pub on_font_size : (Int) -> Unit
  pub on_width_mode : (String) -> Unit
  pub on_progress : (Double) -> Unit
  pub on_close : () -> Unit
}

///| Strongly typed props for `build_site_boosts_panel`.
pub struct SiteBoostsProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub target_origin : () -> String
  pub owner_pane : () -> PaneId
  pub boost : () -> proto::SiteBoost
  pub css_field : ui::Field
  pub anchor_top : () -> Double
  pub accent_color : () -> Int64
  pub on_save : (String, proto::SiteBoost) -> Unit
  pub on_reset : (String) -> Unit
  pub on_close : () -> Unit
  pub on_css_edited : Option[(String) -> Unit]
  pub on_apply_css : Option[(String, proto::SiteBoost) -> Unit]
  ///| The site's own script (Code section).
  pub js_field : ui::Field
  ///| Whether Zap is picking elements on the page, and turning it on or off.
  pub zap_active : () -> Bool
  pub on_zap : (Bool) -> Unit
  ///| Every boosted site (All Boosts), and what its rows do: save one (on/off), open it, delete its boost.
  pub all_boosts : () -> Array[proto::SiteBoost]
  pub on_site_save : (proto::SiteBoost) -> Unit
  pub on_site_open : (String) -> Unit
  pub on_site_delete : (String) -> Unit
}

// ---------------------------------------------------------------------------------------------------------------
// Reader Mode
// ---------------------------------------------------------------------------------------------------------------

struct ReaderPaperPalette {
  page_bg : Int64
  bar_bg : Int64
  ink_primary : Int64
  ink_muted : Int64
  hairline : Int64
  surface_bg : Int64
  accent : Int64
  pill_active_bg : Int64
  pill_active_ink : Int64
}

///| The three reading papers (content colors of the reading surface, not shell chrome).
fn rb_paper_palette(raw_theme : String) -> ReaderPaperPalette {
  let th = proto::normalize_reader_paper_theme(raw_theme)
  if th == "sepia" {
    ReaderPaperPalette::{
      page_bg: 0xF8F2E4FFL,
      bar_bg: 0xF1E8D6FFL,
      ink_primary: 0x2F2217FFL,
      ink_muted: 0x6B5641FFL,
      hairline: 0xE0D2BAFFL,
      surface_bg: 0xE8DCC4FFL,
      accent: 0x9A4A16FFL,
      pill_active_bg: 0xFDF9F0FFL,
      pill_active_ink: 0x2F2217FFL,
    }
  } else if th == "night" {
    ReaderPaperPalette::{
      page_bg: 0x17181CFFL,
      bar_bg: 0x1E1F24FFL,
      ink_primary: 0xE8E8EDFFL,
      ink_muted: 0xA1A1A8FFL,
      hairline: 0x2E2F35FFL,
      surface_bg: 0x2A2B31FFL,
      accent: 0x64A8FFFFL,
      pill_active_bg: 0x3A3B42FFL,
      pill_active_ink: 0xF5F5F7FFL,
    }
  } else {
    ReaderPaperPalette::{
      page_bg: 0xFDFCFAFFL,
      bar_bg: 0xF5F4F1FFL,
      ink_primary: 0x1D1D1FFFL,
      ink_muted: 0x5E5E63FFL,
      hairline: 0xE5E4E0FFL,
      surface_bg: 0xEBEAE6FFL,
      accent: 0x0066CCFFL,
      pill_active_bg: 0xFFFFFFFFL,
      pill_active_ink: 0x1D1D1FFFL,
    }
  }
}

fn rb_make_run(
  s : String,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
) -> text::Run {
  let is_mono = force_mono || font == "mono"
  let is_serif = !is_mono && font == "serif"
  text::Run::{ ..text::plain(s), color, weight, italic, mono: is_mono, serif: is_serif }
}

fn rb_rich_block(
  in_v : view::View,
  s : String,
  sz : Double,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
  lh~ : Double = 1.65,
) -> Unit {
  let _ = in_v.box(fn(tv : view::View) -> Unit {
    let _ = tv.words_runs(
      view::Live::Is([rb_make_run(s, color, font, weight=weight, italic=italic, force_mono=force_mono)]),
      ink=color,
      look=view::WordsLook::{ ..view::words_plain, size: sz, line: sz * lh, wrap: true },
    )
  })
}

///| A recessed group of choices on the reader bar (paper, typeface, width): one track, the chosen one raised.
fn rb_bar_choices(
  bar : view::View,
  pal : () -> ReaderPaperPalette,
  items : Array[(String, String)],
  selected : () -> String,
  said_prefix : String,
  on_pick : (String) -> Unit,
  dot~ : Option[(String) -> Int64] = None,
  labels~ : Bool = true,
) -> Unit {
  let _ = bar.box(fn(track : view::View) -> Unit {
    let _ = track
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
    .gap(view::Live::Is(SP_2))
    .radius(view::Live::Is(SP_10))
    .ground(view::Live::By(fn() { pal().surface_bg }))
    for item in items {
      let (id, label) = item
      let is_on = fn() -> Bool { selected() == id }
      let _ = headless::button(
        track,
        fn() { said_prefix + label },
        fn(_v : view::View) -> Unit { on_pick(id) },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !is_on() })
          let _ = b
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(SP_32)))
          .min_width(view::Live::Is(Some(SP_32)))
          .rigid()
          .center()
          .padding(view::Live::Is((SP_10, SP_0, SP_10, SP_0)))
          .gap(view::Live::Is(SP_6))
          .radius(view::Live::Is(SP_8))
          .ground(view::Live::By(fn() -> Int64 {
            if is_on() {
              pal().pill_active_bg
            } else {
              lg::alpha(pal().hairline, hover_t())
            }
          }))
          .shadow(view::Live::By(fn() {
            let (blur, dy, col) = shell_row_lift(pal().page_bg == rb_paper_palette("night").page_bg)
            if is_on() { (blur, dy, col) } else { (blur, dy, lg::alpha(col, 0.0)) }
          }))
          match dot {
            Some(color_of) => {
              let _ = b.box(fn(d : view::View) -> Unit {
                let _ = d
                .width(view::Live::Is(Some(SP_12)))
                .height(view::Live::Is(Some(SP_12)))
                .rigid()
                .radius(view::Live::Is(SP_6))
                .ground(view::Live::Is(color_of(id)))
                // (a ring in the bar's own muted ink: a light paper's swatch reads on a light bar)
                .edge(view::Live::By(fn() { (lg::hairline_w * 2.0, lg::alpha(pal().ink_muted, 0.45)) }))
              })
            }
            None => ()
          }
          if labels {
            <ui::Text
              in={b}
              size={TX_FOOTNOTE}
              weight={500}
              color_by=>{if is_on() { pal().pill_active_ink } else { pal().ink_muted }}
              text={label}
            />
          }
        },
      )
    }
  })
}

///| A flat icon or text button on the reader bar (32pt high, eased wash on hover).
fn rb_bar_button(
  parent : view::View,
  pal : () -> ReaderPaperPalette,
  said : String,
  on_press : () -> Unit,
  draw : (view::View) -> Unit,
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { said },
    fn(_v : view::View) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .min_width(view::Live::Is(Some(SP_32)))
      .rigid()
      .center()
      .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
      .radius(view::Live::Is(SP_8))
      .ground(view::Live::By(fn() { lg::alpha(pal().surface_bg, hover_t()) }))
      draw(b)
    },
  )
}

///| Builds the solid Reader Mode reading surface over the pane `props.owner_pane`.
pub fn build_reader_mode_panel(parent : view::View, props : ReaderModeProps) -> Unit {
  let pal = fn() -> ReaderPaperPalette { rb_paper_palette((props.theme)()) }
  let reader_metrics = fn() -> proto::ReaderMetrics {
    let _ = (props.rev)()
    let art = (props.article)()
    let m = proto::compute_reader_metrics(art.blocks, title=art.title)
    if m.word_count > 0 {
      m
    } else {
      proto::ReaderMetrics::{
        word_count: art.word_count,
        cjk_chars: 0,
        latin_words: art.word_count,
        read_minutes: if art.read_minutes > 0 { art.read_minutes } else { 1 },
      }
    }
  }

  // Opened by the person: the cover fades in over MO_POP_MS and out over MO_POP_OUT_MS (opacity only: it covers the
  // whole page, nothing to grow or slide). Already open when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  parent.show(props.open, leave=MO_POP_OUT_MS, fn(shell : view::View) -> Unit {
    let cover = shell_reveal(shell, built.v, enter_ms=MO_POP_MS, exit_ms=MO_POP_OUT_MS)
    cover.fades(shell)
    let close_now = shell_closes(shell, props.on_close)
    let _ = shell
    .points(view::Live::By(fn() { !shell.leaving() }))
    .over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0))))
    .min_width(view::Live::Is(Some(SP_0)))
    .min_height(view::Live::Is(Some(SP_0)))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { pal().page_bg }))

    // 1. The reading bar. Wide: the site, the reading controls, Exit at the trailing edge, on one row. Narrow: the
    // site and Exit on the first row, the paper (swatches only), text size and typeface on the second.
    // (decided by the pane's own width: the one-row bar needs about 800pt)
    let narrow = fn() -> Bool {
      let _ = shell.laid_size_told()
      let (_, _, pw, _) = shell.placed_now()
      let w = if pw > SP_96 { pw } else { parent.window_w() }
      w < SP_160 * 5.0
    }
    let site_of = fn(row : view::View) -> Unit {
      let _ = row.box(fn(site : view::View) -> Unit {
        let _ = site
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .min_width(view::Live::Is(Some(SP_96)))
        .gap(view::Live::Is(SP_8))
        .clips(view::Live::Is(true))
        let _ = shell_glyph_tile(site, ICON_READER, size=SP_24)
        let host_txt = <ui::Text
          in={site}
          size={TX_BODY}
          weight={500}
          lines={1}
          color_by=>{pal().ink_primary}
          text_by=>{
            let h = (props.article)().host
            if h != "" { h } else { "Reader" }
          }
        />
        let _ = host_txt.cut().allow_ellipsis(view::Live::Is(true))
      })
    }
    let exit_of = fn(row : view::View) -> Unit {
      rb_bar_button(row, pal, "Exit Reader Mode", close_now, fn(b : view::View) -> Unit {
        let _ = shell_icon(b, ICON_CLOSE, size=IC_MD, color_by=fn() { pal().ink_primary })
      })
    }
    let controls_of = fn(row : view::View, wide : Bool) -> Unit {
      rb_bar_choices(
        row,
        pal,
        [("light", "Light"), ("sepia", "Sepia"), ("night", "Night")],
        fn() { proto::normalize_reader_paper_theme((props.theme)()) },
        "Reader Paper Theme ",
        props.on_theme,
        dot=Some(fn(id : String) -> Int64 { rb_paper_palette(id).page_bg }),
        labels=wide,
      )
      // Text size: smaller / current / larger
      let _ = row.box(fn(sseg : view::View) -> Unit {
        let _ = sseg
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .rigid()
        .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
        .radius(view::Live::Is(SP_10))
        .ground(view::Live::By(fn() { pal().surface_bg }))
        let step = fn(label : String, said : String, delta : Int, size : Double) -> Unit {
          rb_bar_button(
            sseg,
            pal,
            said,
            fn() {
              let cur = signals::untracked(props.font_size)
              (props.on_font_size)(proto::step_reader_font_size(cur, delta))
            },
            fn(b : view::View) -> Unit {
              <ui::Text in={b} size={size} weight={500} color_by=>{pal().ink_primary} text={label} />
            },
          )
        }
        step("A", "Decrease Reader Font Size", 0 - proto::READER_FONT_SIZE_STEP, TX_FOOTNOTE)
        let _ = sseg.box(fn(sz : view::View) -> Unit {
          let _ = sz.width(view::Live::Is(Some(SP_32))).rigid().center()
          <ui::Text
            in={sz}
            size={TX_FOOTNOTE}
            weight={500}
            color_by=>{pal().ink_muted}
            text_by=>{proto::clamp_reader_font_size((props.font_size)()).to_string()}
          />
        })
        step("A", "Increase Reader Font Size", proto::READER_FONT_SIZE_STEP, TX_HEADLINE)
      })
      rb_bar_choices(
        row,
        pal,
        [("sans", "Sans"), ("serif", "Serif"), ("mono", "Mono")],
        fn() { proto::normalize_reader_font((props.font)()) },
        "Reader Font ",
        props.on_font,
      )
      // (a narrow pane is one column already: no width to choose)
      if wide {
        rb_bar_choices(
          row,
          pal,
          [("narrow", "Narrow"), ("medium", "Medium"), ("wide", "Wide")],
          fn() { proto::normalize_reader_width((props.width_mode)()) },
          "Column Width ",
          props.on_width_mode,
        )
      }
    }
    let _ = shell.box(fn(bar : view::View) -> Unit {
      let _ = bar.rigid().ground(view::Live::By(fn() { pal().bar_bg }))
      bar.show(fn() { !narrow() }, fn(row : view::View) -> Unit {
        let _ = row
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((SP_16, SP_8, SP_12, SP_8)))
        .gap(view::Live::Is(SP_12))
        site_of(row)
        controls_of(row, true)
        exit_of(row)
      })
      bar.show(narrow, fn(col : view::View) -> Unit {
        let _ = col.padding(view::Live::Is((SP_16, SP_8, SP_12, SP_8))).gap(view::Live::Is(SP_8))
        let _ = col.box(fn(top : view::View) -> Unit {
          let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_12))
          site_of(top)
          exit_of(top)
        })
        let _ = col.box(fn(ctl : view::View) -> Unit {
          let _ = ctl
          .row(view::Live::Is(true))
          .wraps(view::Live::Is(Some(SP_8)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(SP_8))
          controls_of(ctl, false)
        })
      })
    })

    // 2. Reading progress (a 2pt line under the bar)
    let _ = shell.box(fn(prog_track : view::View) -> Unit {
      let _ = prog_track
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(SP_2)))
      .rigid()
      .ground(view::Live::By(fn() { pal().hairline }))
      let _ = prog_track.box(fn(prog_fill : view::View) -> Unit {
        let _ = prog_fill
        .height(view::Live::Is(Some(SP_2)))
        .rigid()
        .width(view::Live::By(fn() -> Option[Double] {
          let (_, _, tw, _) = prog_track.placed_now()
          let base_w = if tw > SP_8 { tw } else { parent.window_w() }
          Some(base_w * proto::clamp_reader_progress((props.progress)()))
        }))
        .ground(view::Live::By(fn() { pal().accent }))
      })
    })

    // 3. The article in a centered column
    let _ = shell.box(fn(scroll_host : view::View) -> Unit {
      let _ = scroll_host
      .fill()
      .clips(view::Live::Is(true))
      .on_wheel(fn(wh : view::Wheel) -> Unit {
        let cur = signals::untracked(props.progress)
        let delta = (0.0 - wh.dy) / 1400.0
        (props.on_progress)(proto::clamp_reader_progress(cur + delta))
      })

      let _ = ui::scroll_box(scroll_host, fn(sc : view::View) -> Unit {
        let _ = sc
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((SP_24, SP_40, SP_24, SP_64)))

        let _ = sc.box(fn(col : view::View) -> Unit {
          let col_w = fn() -> Option[Double] {
            let _ = scroll_host.laid_size_told()
            let target = proto::reader_column_width_pt((props.width_mode)())
            let (_, _, sw, _) = scroll_host.placed_now()
            let eff_sw = if sw > SP_64 { sw } else { parent.window_w() }
            if eff_sw > SP_64 && target > eff_sw - SP_48 {
              Some(eff_sw - SP_48)
            } else {
              Some(target)
            }
          }
          let _ = col
          .width(view::Live::By(col_w))
          .max_width(view::Live::By(col_w))
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(SP_0)))

          col.switch_by(
            fn() -> Int {
              let rev = (props.rev)()
              let st = (props.status)()
              let th = proto::normalize_reader_paper_theme((props.theme)())
              let fnm = proto::normalize_reader_font((props.font)())
              let fsz = proto::clamp_reader_font_size((props.font_size)())
              let th_i = if th == "sepia" { 1 } else if th == "night" { 2 } else { 0 }
              let fn_i = if fnm == "serif" { 1 } else if fnm == "mono" { 2 } else { 0 }
              rev * 200000 + st * 10000 + fsz * 16 + th_i * 4 + fn_i
            },
            fn(doc_box : view::View, _key : Int) -> Unit {
              let art = signals::untracked(props.article)
              let font = proto::normalize_reader_font(signals::untracked(props.font))
              let body_size = proto::clamp_reader_font_size(signals::untracked(props.font_size)).to_double()
              let scale = body_size / TX_HEADLINE
              let p = rb_paper_palette(signals::untracked(props.theme))
              let metrics = reader_metrics()
              let _ = doc_box.gap(view::Live::Is(SP_16))

              // The reading time, quiet above the title (the bar already names the site)
              let eyebrow = proto::format_read_minutes_badge(metrics.read_minutes)
              <ui::Text in={doc_box} size={TX_FOOTNOTE} weight={500} color_by=>{p.ink_muted} text={eyebrow} />

              let title_text = if art.title != "" { art.title } else { "Reading the page" }
              rb_rich_block(doc_box, title_text, TX_TITLE1 * scale, p.ink_primary, font, weight=700, lh=1.25)
              if art.byline != "" {
                rb_rich_block(doc_box, art.byline, TX_CALLOUT * scale, p.ink_muted, font, lh=1.45)
              }
              let _ = doc_box.box(fn(hsep : view::View) -> Unit {
                let _ = hsep.height(view::Live::Is(Some(lg::hairline_w * 2.0))).rigid().ground(view::Live::Is(p.hairline))
              })

              if art.blocks.length() == 0 {
                let st = signals::untracked(props.status)
                let empty_msg = if st == READER_STATUS_LOADING {
                  "Reading the article on this page."
                } else if st == READER_STATUS_INCOMPATIBLE {
                  "This page did not answer with an article."
                } else {
                  "No article found on this page."
                }
                rb_rich_block(doc_box, empty_msg, TX_CALLOUT * scale, p.ink_muted, font, lh=1.5)
              }

              let mut i = 0
              while i < art.blocks.length() {
                let blk = art.blocks[i]
                match blk.kind {
                  proto::ReaderBlockKind::Heading => {
                    let h_size = if blk.level <= 2 { TX_TITLE3 * scale } else { (TX_HEADLINE + SP_2) * scale }
                    let _ = doc_box.box(fn(hb : view::View) -> Unit {
                      let _ = hb.padding(view::Live::Is((SP_0, SP_8, SP_0, SP_0)))
                      rb_rich_block(hb, blk.text, h_size, p.ink_primary, font, weight=600, lh=1.35)
                    })
                  }
                  proto::ReaderBlockKind::Quote => {
                    let _ = doc_box.box(fn(qb : view::View) -> Unit {
                      let _ = qb.row(view::Live::Is(true)).padding(view::Live::Is((SP_4, SP_2, SP_0, SP_2))).gap(view::Live::Is(SP_16))
                      let _ = qb.box(fn(vbar : view::View) -> Unit {
                        let _ = vbar.width(view::Live::Is(Some(SP_2))).rigid().radius(view::Live::Is(SP_2)).ground(view::Live::Is(p.accent))
                      })
                      let _ = qb.box(fn(qt : view::View) -> Unit {
                        let _ = qt.fill()
                        rb_rich_block(qt, blk.text, body_size, p.ink_primary, font, italic=true, lh=1.6)
                      })
                    })
                  }
                  proto::ReaderBlockKind::Code => {
                    let _ = doc_box.box(fn(cb : view::View) -> Unit {
                      let _ = cb.padding(view::Live::Is((SP_16, SP_12, SP_16, SP_12))).radius(view::Live::Is(SP_8)).ground(view::Live::Is(p.surface_bg))
                      rb_rich_block(cb, blk.text, TX_BODY * scale, p.ink_primary, font, force_mono=true, lh=1.5)
                    })
                  }
                  proto::ReaderBlockKind::ListItem => {
                    let _ = doc_box.box(fn(li : view::View) -> Unit {
                      let _ = li.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_12))
                      let _ = li.box(fn(bwrap : view::View) -> Unit {
                        let _ = bwrap.width(view::Live::Is(Some(SP_8))).height(view::Live::Is(Some(body_size * 1.65))).rigid().center()
                        let _ = bwrap.box(fn(dot : view::View) -> Unit {
                          let _ = dot.width(view::Live::Is(Some(SP_6))).height(view::Live::Is(Some(SP_6))).rigid().radius(view::Live::Is(SP_4)).ground(view::Live::Is(p.ink_muted))
                        })
                      })
                      let _ = li.box(fn(lt : view::View) -> Unit {
                        let _ = lt.fill()
                        rb_rich_block(lt, blk.text, body_size, p.ink_primary, font, lh=1.65)
                      })
                    })
                  }
                  proto::ReaderBlockKind::Paragraph => rb_rich_block(doc_box, blk.text, body_size, p.ink_primary, font, lh=1.65)
                }
                i += 1
              }
            },
          )
        })
      })
    })
  })
  built.v = true
}

// ---------------------------------------------------------------------------------------------------------------
// Site Boosts
// ---------------------------------------------------------------------------------------------------------------

// Literals with their token (package lets initialize in file order).
let BP_W : Double = 208.0 // SP_160 + SP_48: the editor at the page's right edge
let BP_W_WIDE : Double = 352.0 // SP_160 * 2 + SP_32: its Code and All Boosts pages
let BP_CANVAS : Double = 184.0 // BP_W - SP_12 * 2
let BP_RING : Double = 8.0 // SP_8: the gradient frame round the dotted field
let BP_FIELD : Double = 168.0 // BP_CANVAS - BP_RING * 2
let BP_FONT_COLS : Int = 3

// Glyphs of the panel's own rows (names from `packages/icons`).
let BP_IC_CODE : String = "code"
let BP_IC_FILE_CODE : String = "file-code"
let BP_IC_EYE : String = "eye"

// Pages of the editor.
let BP_PAGE_MAIN : Int = 0
let BP_PAGE_CODE : Int = 1
let BP_PAGE_SITES : Int = 2

///| A site tile: the one site tile (`shell_site_tile`), the same color as in the sidebar and Site controls.
fn bp_site_tile(parent : view::View, host_by : () -> String, size~ : Double = SP_24) -> Unit {
  let _ = shell_site_tile(parent, host_by, size=size)
}

///| A switch's track while on: ink in light, a mid gray in dark (its white thumb stays in view); no color of its
///| own in a panel whose color is the boost's.
fn bp_toggle_on() -> Int64 {
  if lg::is_dark() { 0x636366FFL } else { lg::surface().ink }
}

///| Ink of a text button that acts (Apply, Show all): the accent, deep enough on a light card to read at 4.5:1.
fn bp_link_ink() -> Int64 {
  shell_accent_text()
}

///| Rows of a grouped list sit SP_12 in; a row's label starts after its 24pt tile and SP_12.
fn bp_label_inset() -> Double {
  SP_12 + SP_24 + SP_12
}

///| A grouped list: a quiet caption, one solid card, an optional footnote.
fn bp_group(
  parent : view::View,
  caption : () -> String,
  footnote : () -> String,
  rows : (view::View) -> Unit,
) -> Unit {
  let _ = parent.box(fn(g : view::View) -> Unit {
    let _ = g.gap(view::Live::Is(SP_6)).rigid()
    g.show(fn() { caption() != "" }, fn(c : view::View) -> Unit {
      let _ = c.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      <ui::Text in={c} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text_by=>{caption()} />
    })
    let _ = g.box(fn(card : view::View) -> Unit {
      // (a hairline edge keeps the solid card apart from the light glass around it)
      let _ = card
      .radius(view::Live::Is(SP_12))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() { lg::surface().card }))
      .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
      rows(card)
    })
    g.show(fn() { footnote() != "" }, fn(f : view::View) -> Unit {
      let _ = f.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      // (on the glass, over whatever page is under it: a little deeper than the secondary ink keeps 4.5:1)
      <ui::Text
        in={f}
        size={TX_FOOTNOTE}
        wrap
        color_by=>{shell_mix(lg::surface().ink_secondary, lg::surface().ink, 0.25)}
        text_by=>{footnote()}
      />
    })
  })
}

///| Hairline between rows, starting where the labels start.
fn bp_rule(parent : view::View, inset~ : Double = bp_label_inset()) -> Unit {
  let _ = inset
  shell_full_divider(parent)
}

///| One row: a monochrome glyph tile, label, trailing control. At least 40pt.
fn bp_row(
  parent : view::View,
  icon : String,
  label : () -> String,
  trailing : (view::View) -> Unit,
  trail_pad~ : Double = SP_12,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_8, trail_pad, SP_8)))
    .gap(view::Live::Is(SP_12))
    let _ = mono_tile(row, fn() { icon }, size=SP_24, round=false)
    let _ = row.box(fn(tw : view::View) -> Unit {
      let _ = tw.fill()
      let l = <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text_by=>{label()} />
      let _ = l.cut().allow_ellipsis(view::Live::Is(true))
    })
    trailing(row)
  })
}

///| Boost's icon button: the shell's one panel icon button (`shell_panel_icon_btn`).
fn bp_icon_btn(
  parent : view::View,
  said : () -> String,
  icon : String,
  on_press : () -> Unit,
  color_by? : () -> Int64,
  disabled~ : () -> Bool = fn() { false },
  glyph? : (view::View, () -> Int64) -> Unit,
  made? : (view::View) -> Unit,
) -> Unit {
  let made_v = shell_panel_icon_btn(parent, said, icon, on_press, ink_by?=color_by, disabled=disabled, glyph?=glyph)
  match made {
    Some(f) => f(made_v)
    None => ()
  }
}

///| A text button in a card or the footer (32pt; `tinted` for the action of a group, `danger` for Reset).
fn bp_text_btn(
  parent : view::View,
  said : () -> String,
  text : String,
  on_press : () -> Unit,
  tinted~ : Bool = false,
  danger~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  corner~ : Double = SP_8,
  made? : (view::View) -> Unit,
) -> Unit {
  let made_v = headless::button(
    parent,
    said,
    fn(_v : view::View) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let ink = fn() -> Int64 {
        let base = if danger { lg::surface().danger } else if tinted { bp_link_ink() } else { lg::surface().ink }
        if disabled() { lg::alpha(base, 0.4) } else { base }
      }
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .rigid()
      .padding(view::Live::Is((SP_10, SP_0, SP_10, SP_0)))
      .gap(view::Live::Is(SP_6))
      .radius(view::Live::Is(corner))
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      <ui::Text in={b} size={TX_BODY} weight={500} color_by=>{ink()} text={text} />
    },
  )
  match made {
    Some(f) => f(made_v)
    None => ()
  }
}

///| Gives the keyboard to `b` as it is made, shown as the focus was shown before (a swap in place under the
///| keyboard keeps the keyboard where the person is; one under the pointer shows no ring).
fn bp_take_focus(b : view::View) -> Unit {
  let (_, shown) = b.tree.focused_now()
  let _ = b.ask_focus(visible=shown)
}

///| A code editor under its header row (whose trailing control is Apply): the field over a code ground.
fn bp_code_card(
  parent : view::View,
  field : ui::Field,
  said : String,
  placeholder : String,
  on_edited~ : Option[(String) -> Unit] = None,
) -> Unit {
  let _ = parent.box(fn(blk : view::View) -> Unit {
    let _ = blk.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_12)))
    let _ = blk.box(fn(fw : view::View) -> Unit {
      let _ = fw
      .min_height(view::Live::Is(Some(SP_80)))
      .padding(view::Live::Is((SP_10, SP_8, SP_10, SP_8)))
      .radius(view::Live::Is(SP_8))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() { lg::surface().code_bg }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if field.focused() { (lg::hairline_w * 3.0, lg::surface().accent) } else { (lg::hairline_w, lg::surface().separator) }
      }))
      let typed = ui::field(
        fw,
        field,
        placeholder=placeholder,
        font_size=TX_FOOTNOTE,
        min_lines=4,
        max_lines=10,
        enter_sends=false,
        label=said,
        colors_by=fn() { (lg::surface().ink, lg::surface().ink_tertiary, lg::surface().accent) },
        edited=fn(raw : String) -> Unit {
          match on_edited {
            Some(cb) => cb(raw)
            None => ()
          }
        },
      )
      let _ = typed.fill()
    })
  })
}

///| What a boost changes, in a few words (the All Boosts rows).
fn bp_boost_summary(b : proto::SiteBoost) -> String {
  let parts : Array[String] = []
  let theme = proto::normalize_boost_theme(b.theme)
  if theme == "dark" {
    parts.push("Dark")
  } else if theme == "sepia" {
    parts.push("Sepia")
  } else if theme == "contrast" {
    parts.push("High contrast")
  }
  if proto::normalize_boost_tint(b.tint) != "" {
    parts.push("Tint")
  }
  if b.invert {
    parts.push("Inverted")
  }
  match proto::boost_font_of(proto::normalize_boost_font(b.font)) {
    Some(f) => parts.push(f.label)
    None => ()
  }
  let scale = proto::clamp_boost_scale_pct(b.scale_pct)
  if scale != proto::BOOST_SCALE_DEFAULT {
    parts.push(scale.to_string() + "% text")
  }
  let tcase = proto::normalize_boost_case(b.text_case)
  if tcase == "upper" {
    parts.push("Uppercase")
  } else if tcase == "lower" {
    parts.push("Lowercase")
  }
  let zapped = proto::normalize_boost_zapped(b.zapped).length()
  if zapped == 1 {
    parts.push("1 hidden")
  } else if zapped > 1 {
    parts.push(zapped.to_string() + " hidden")
  }
  if proto::sanitize_boost_custom_css(b.custom_css) != "" {
    parts.push("CSS")
  }
  if proto::sanitize_boost_custom_js(b.custom_js) != "" {
    parts.push("JavaScript")
  }
  if parts.length() == 0 {
    "No changes"
  } else if parts.length() > 2 {
    // (one line: the first two, then how many more)
    parts[0] + ", " + parts[1] + " +" + (parts.length() - 2).to_string()
  } else {
    parts.join(", ")
  }
}

///| A slider's value while it is dragged (`-1` at rest: the boost's own value shows); back to rest when the
///| boost's value changes (the save came back).
fn bp_drag_value(host : view::View, saved : () -> Int) -> signals::Signal[Double] {
  let live : signals::Signal[Double] = signals::signal(-1.0)
  host.reacts(at_start=false, saved, fn(_v : Int) -> Unit { live.set(-1.0) })
  live
}

fn bp_clamp01(v : Double) -> Double {
  if v < 0.0 {
    0.0
  } else if v > 1.0 {
    1.0
  } else {
    v
  }
}

///| A square button of the editor (the lightbulb row, Size and Case, Zap, Code): a quiet gray face that fills with
///| ink while `on`, the wash on hover, a 0.97 press. `content` draws inside it with the ink it is given.
fn bp_face_btn(
  parent : view::View,
  said : () -> String,
  on_press : () -> Unit,
  content : (view::View, () -> Int64) -> Unit,
  on~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  grow~ : Bool = true,
  pad_x~ : Double = SP_0,
  value~ : () -> String = fn() { "" },
) -> Unit {
  let _ = headless::button(
    parent,
    said,
    fn(_v : view::View) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let on_t = shell_fade(b, fn() { on() && !disabled() }, duration_ms=MO_KEY_MS)
      shell_press(b, fn() { btn.pressed() && !disabled() })
      let _ = b
      .height(view::Live::Is(Some(SP_40)))
      // (concentric with the panel: the last one sits in its corner)
      .radius(view::Live::Is(lg::concentric(SP_20, SP_12)))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .padding(view::Live::Is((pad_x, SP_0, pad_x, SP_0)))
      .gap(view::Live::Is(SP_6))
      // (opaque: the gray of a monochrome tile laid on the card, so the ink fill reaches full ink)
      .ground(view::Live::By(fn() {
        let rest = shell_mix(lg::surface().card, lg::surface().ink, (if lg::is_dark() { 0.14 } else { 0.07 }) + 0.05 * hover_t())
        shell_mix(rest, lg::surface().ink, on_t())
      }))
      .says(view::Live::By(fn() {
        Some(view::said(view::Role::Button, label=said(), value=value(), pressed=on()))
      }))
      if grow {
        let _ = b.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      }
      if pad_x == SP_0 {
        let _ = b.lies_along(view::Live::Is(view::Lies::Middle))
      } else {
        let _ = b.lies_along(view::Live::Is(view::Lies::Between))
      }
      let ink = fn() -> Int64 {
        let c = shell_mix(lg::surface().ink, lg::surface().card, on_t())
        if disabled() { lg::alpha(c, 0.35) } else { c }
      }
      content(b, ink)
    },
  )
}

///| A lightbulb glyph (16pt), drawn: a round bulb open at its foot, its neck and two base lines.
fn bp_bulb_glyph(parent : view::View, ink : () -> Int64) -> Unit {
  let _ = parent.box(fn(g : view::View) -> Unit {
    let _ = g
    .width(view::Live::Is(Some(IC_MD)))
    .height(view::Live::Is(Some(IC_MD)))
    .rigid()
    .points(view::Live::Is(false))
    .lines(view::Live::By(fn() {
      let c = ink()
      let w = 1.5
      let pi = 3.141592653589793
      [
        paint::line(paint::arc(8.0, 6.0, 4.5, from=pi * 0.75, sweep=pi * 1.5), width=w, color=c),
        paint::line([(4.8, 9.2), (6.0, 11.0), (6.0, 12.0), (10.0, 12.0), (10.0, 11.0), (11.2, 9.2)], width=w, color=c),
        paint::line([(6.5, 14.25), (9.5, 14.25)], width=w, color=c),
      ]
    }))
  })
}

///| A "no color" glyph (16pt), drawn: a ring with a stroke across it.
fn bp_none_glyph(parent : view::View, ink : () -> Int64) -> Unit {
  let _ = parent.box(fn(g : view::View) -> Unit {
    let _ = g
    .width(view::Live::Is(Some(IC_MD)))
    .height(view::Live::Is(Some(IC_MD)))
    .rigid()
    .points(view::Live::Is(false))
    .lines(view::Live::By(fn() {
      let c = ink()
      [
        paint::line(paint::arc(8.0, 8.0, 6.25, from=0.0, sweep=6.283185307179586), width=1.5, color=c),
        paint::line([(3.6, 3.6), (12.4, 12.4)], width=1.5, color=c),
      ]
    }))
  })
}

///| A reset glyph (16pt), drawn: a circular arrow turning back (counterclockwise), its head at the top.
fn bp_reset_glyph(parent : view::View, ink : () -> Int64) -> Unit {
  let _ = parent.box(fn(g : view::View) -> Unit {
    let _ = g
    .width(view::Live::Is(Some(IC_MD)))
    .height(view::Live::Is(Some(IC_MD)))
    .rigid()
    .points(view::Live::Is(false))
    .lines(view::Live::By(fn() {
      let c = ink()
      let pi = 3.141592653589793
      [
        paint::line(paint::arc(8.0, 8.5, 5.75, from=pi * 1.5, sweep=pi * 1.6), width=1.5, color=c),
        paint::line([(9.6, 0.9), (7.6, 2.75), (9.6, 4.6)], width=1.5, color=c),
      ]
    }))
  })
}

///| A label in a face button.
fn bp_face_text(parent : view::View, text : () -> String, ink : () -> Int64, mono~ : Bool = false) -> Unit {
  if mono {
    let _ = parent.box(fn(tw : view::View) -> Unit {
      let _ = tw.rigid().points(view::Live::Is(false))
      let _ = tw.words_runs(
        view::Live::By(fn() { [rb_make_run(text(), ink(), "mono", weight=500)] }),
        look=view::WordsLook::of(TX_BODY, wrap=false),
      )
      // (the words' own ink follows the appearance too, not only their runs)
      let _ = tw.ink(view::Live::By(ink))
    })
  } else {
    <ui::Text in={parent} size={TX_BODY} weight={500} lines={1} color_by=>{ink()} text_by=>{text()} />
  }
}

///| A compact slider of the fine controls: its name and value on one line, the slider under them.
fn bp_fine_slider(
  parent : view::View,
  label : String,
  value_text : () -> String,
  value : () -> Double,
  least : Double,
  most : Double,
  step : Double,
  on_change : (Double) -> Unit,
  on_commit : (Double) -> Unit,
  said : String,
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = parent.box(fn(blk : view::View) -> Unit {
    let _ = blk.padding(view::Live::Is((SP_12, SP_8, SP_12, SP_4))).gap(view::Live::Is(SP_2))
    let _ = blk.box(fn(top : view::View) -> Unit {
      let _ = top.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
      <ui::Text
        in={top}
        size={TX_FOOTNOTE}
        weight={500}
        color_by=>{if disabled() { lg::surface().ink_secondary } else { lg::surface().ink }}
        text={label}
      />
      <ui::Text in={top} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text_by=>{value_text()} />
    })
    let _ = lg::liquid_slider_node(
      blk,
      value,
      on_change,
      fn() { said },
      least~,
      most~,
      step~,
      committed=on_commit,
      disabled~,
      // (the thumb is white with a faint edge: a deeper track under it on the gray card keeps it in view)
      track_color=fn() { shell_mix(lg::surface().card, lg::surface().ink, if lg::is_dark() { 0.28 } else { 0.16 }) },
      fill_color=fn() { if disabled() { lg::alpha(lg::surface().ink_secondary, 0.4) } else { lg::surface().ink_secondary } },
    )
  })
}

///| A switch row of the fine controls (no tile: the card is about one thing).
fn bp_fine_toggle(parent : view::View, label : String, said : String, on : () -> Bool, set : (Bool) -> Unit, disabled : () -> Bool) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_4, SP_12, SP_4)))
    .gap(view::Live::Is(SP_8))
    let _ = row.box(fn(tw : view::View) -> Unit {
      let _ = tw.fill()
      <ui::Text in={tw} size={TX_FOOTNOTE} weight={500} wrap color_by=>{lg::surface().ink} text={label} />
    })
    let _ = shell_desktop_toggle(row, on, set, fn() { said }, disabled~, on_color=bp_toggle_on)
  })
}

///| Builds the Boost editor bound to `props.target_origin`: Arc's compact floating panel at the page's right edge
///| (one glass layer, solid content). Header: close, the site's name (its chevron opens All Boosts), reset. Then
///| the color canvas (the tint and a second color as two handles in a gradient frame), the dark / fine controls /
///| no color buttons, the typeface grid, Size and Case, Zap (filled while picking, with what it hid) and Code (the
///| CSS and JavaScript editors).
pub fn build_site_boosts_panel(
  root : view::View,
  props : SiteBoostsProps,
  initial_section~ : Int = 0,
  initial_all~ : Bool = false,
  initial_fine~ : Bool = false,
) -> Unit {
  let bound_origin = fn() -> String { (props.target_origin)().trim() }
  let has_origin = fn() -> Bool { bound_origin() != "" }
  let no_origin = fn() -> Bool { !has_origin() }
  let live_win_w = fn() -> Double {
    let _ = root.laid_size_told()
    let ww = root.window_w()
    if ww > SP_96 {
      ww
    } else {
      let (_, _, rw, _) = root.placed_now()
      if rw > SP_96 { rw } else { SP_160 * 8.0 }
    }
  }
  let live_win_h = fn() -> Double {
    let _ = root.laid_size_told()
    let wh = root.window_h()
    if wh > SP_96 {
      wh
    } else {
      let (_, _, _, rh) = root.placed_now()
      if rh > SP_96 { rh } else { SP_160 * 5.0 }
    }
  }
  let panel_top = fn() -> Double {
    let top = (props.anchor_top)()
    if top > SP_8 { top } else { SP_8 }
  }
  let safe_save = fn(next_b : proto::SiteBoost) -> Unit {
    let origin = signals::untracked(bound_origin)
    if origin == "" {
      return
    }
    (props.on_save)(origin, proto::SiteBoost::{ ..next_b, host: origin })
  }
  let cur = fn() -> proto::SiteBoost { signals::untracked(props.boost) }
  let apply_code = fn(next_b : proto::SiteBoost) -> Unit {
    let origin = signals::untracked(bound_origin)
    if origin == "" {
      return
    }
    let target = proto::SiteBoost::{ ..next_b, host: origin, enabled: true }
    match props.on_apply_css {
      Some(cb) => cb(origin, target)
      None => (props.on_save)(origin, target)
    }
  }
  let reset = fn() {
    let origin = signals::untracked(bound_origin)
    if origin == "" {
      return
    }
    props.css_field.set("")
    props.js_field.set("")
    if signals::untracked(props.zap_active) {
      (props.on_zap)(false)
    }
    (props.on_reset)(origin)
  }
  // Pages: the editor, Code (`initial_section` 3, as the old Code section), All Boosts.
  let page : signals::Signal[Int] = signals::signal(
    if initial_all {
      BP_PAGE_SITES
    } else if initial_section == 3 {
      BP_PAGE_CODE
    } else {
      BP_PAGE_MAIN
    },
  )
  let host_label = fn() -> String {
    let o = proto::normalize_boost_host(bound_origin())
    if o != "" { o } else { "This page" }
  }

  // Opened by the person: it comes in like every popover (`shell_popover_reveal`), grown from its pinned top-right
  // corner, toward the toolbar's Boost button, and leaves over MO_POP_OUT_MS for every close a person makes from it
  // (Close, Escape, a click outside). Already open when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, props.on_close)
    let reveal = shell_popover_reveal(layer, built.v)
    let _ = layer.over(view::Live::Is(true)).points(view::Live::By(fn() { !layer.leaving() }))
    // Changing page is a push: the new page's header and body come in from SP_8 along the way it goes (forward
    // from the right, back from the left) over MO_POP_MS, fading in; the old one goes at once. The page it opens
    // with is there at once; reduced motion keeps only the fade.
    let page_way = motion::NodeWay::new(1.0)
    let page_dir = ui::ref_new(1.0)
    let page_last = ui::ref_new(signals::untracked(fn() { page.get() }))
    layer.reacts(at_start=false, fn() { page.get() }, fn(pg : Int) -> Unit {
      page_dir.v = if pg == BP_PAGE_MAIN || (page_last.v == BP_PAGE_CODE && pg == BP_PAGE_SITES) { -1.0 } else { 1.0 }
      page_last.v = pg
      page_way.put(0.0)
      shell_go(page_way, layer, 1.0, MO_POP_MS)
    })
    let page_push = fn(n : view::View) -> Unit {
      let _ = n
      .alpha(view::Live::By(fn() { page_way.shown(n) }))
      .offset(view::Live::By(fn() {
        if ui::reduced_motion() { (SP_0, SP_0) } else { (page_dir.v * SP_8 * (1.0 - page_way.shown(n)), SP_0) }
      }))
    }
    let fine : signals::Signal[Bool] = signals::signal(initial_fine)
    // Reset asks once more in place (as Delete Boost does in All Boosts): it takes the site's colors, code and
    // hidden elements in one go. Another site or another page lets the question go.
    let resetting : signals::Signal[Bool] = signals::signal(false)
    // (the question was asked: when it goes, the keyboard goes back to Reset, where it was)
    let asked : signals::Ref[Bool] = ui::ref_new(false)
    layer.reacts(at_start=false, fn() { (bound_origin(), page.get()) }, fn(_k : (String, Int)) -> Unit {
      if resetting.untracked() { resetting.set(false) }
    })
    // (0 the editor's width, 1 the wide pages': a page change widens or narrows the panel over the standard
    // surface time; the page it opens with is there at once)
    let wide_way = motion::NodeWay::new(if signals::untracked(fn() { page.get() }) == BP_PAGE_MAIN { 0.0 } else { 1.0 })
    layer.reacts(at_start=false, fn() { page.get() }, fn(pg : Int) -> Unit {
      shell_go(wide_way, layer, if pg == BP_PAGE_MAIN { 0.0 } else { 1.0 }, MO_POP_MS, ease=shell_ease_out())
    })
    let _ = headless::dialog(
      layer,
      fn() { "Site Boosts" },
      props.open,
      close_now,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        reveal.fades(dlg_box)
        let _ = dlg_box.over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
          (None, Some(panel_top()), Some(SP_16), None)
        }))

        let _ = lg::liquid_dialog_shell_node(
          dlg_box,
          fn(shell : view::View) -> Unit {
            let _ = shell_float_rim(shell)
            reveal.grows_only(shell, ox=1.0, oy=0.0)
            let _ = shell
            .width(view::Live::By(fn() -> Option[Double] {
              let rw = live_win_w()
              let want = BP_W + (BP_W_WIDE - BP_W) * wide_way.shown(shell)
              Some(if want + SP_16 > rw { rw - SP_16 } else { want })
            }))
            .max_height(view::Live::By(fn() -> Option[Double] { Some(live_win_h() - panel_top() - SP_8) }))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // 1. Header: close, the site's boost (its chevron opens All Boosts), reset; on a page: back, its name.
            let _ = shell.box(fn(hdr : view::View) -> Unit {
              let _ = hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .rigid()
              .height(view::Live::Is(Some(SP_48)))
              .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
              .gap(view::Live::Is(SP_2))
              .ground(view::Live::By(fn() { lg::alpha(lg::surface().ink, 0.03) }))
              hdr.show(fn() { page.get() == BP_PAGE_MAIN && !resetting.get() }, at_once=true, fn(main : view::View) -> Unit {
                let _ = main.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).fill().gap(view::Live::Is(SP_2))
                page_push(main)
                bp_icon_btn(main, fn() { "Close Site Boosts" }, ICON_CLOSE, close_now)
                let _ = headless::button(
                  main,
                  fn() { "Show All Boosts" },
                  fn(_v : view::View) -> Unit { page.set(BP_PAGE_SITES) },
                  fn(b : view::View, btn : headless::Button) -> Unit {
                    let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                    let _ = b
                    .fill()
                    .height(view::Live::Is(Some(SP_32)))
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    .gap(view::Live::Is(SP_4))
                    .padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
                    .radius(view::Live::Is(SP_8))
                    .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
                    // The boost's name with its chevron, on one line as Arc's "My Boost" (the site it is for is in
                    // the panel's accessible name: the panel lies on that site's page).
                    <ui::Text in={b} size={TX_BODY} weight={600} lines={1} color_by=>{lg::surface().ink} text="Boost" />
                    let _ = shell_icon(b, ICON_CHEVRON_DOWN, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
                  },
                )
                bp_icon_btn(
                  main,
                  fn() { "Reset Site Boost" },
                  ICON_UNDO,
                  fn() { resetting.set(true) },
                  disabled=no_origin,
                  glyph=fn(g, ink) { bp_reset_glyph(g, ink) },
                  made=fn(b) {
                    if asked.v {
                      asked.v = false
                      bp_take_focus(b)
                    }
                  },
                )
              })
              // The question in place of the header's buttons; what goes is said on the line under it. Each button's
              // name starts with the words it shows (voice control finds it by them); the keyboard comes to Cancel.
              hdr.show(fn() { page.get() == BP_PAGE_MAIN && resetting.get() }, at_once=true, fn(ask : view::View) -> Unit {
                let _ = ask.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).fill().gap(view::Live::Is(SP_4))
                asked.v = true
                bp_icon_btn(ask, fn() { "Close Site Boosts" }, ICON_CLOSE, props.on_close)
                let _ = ask.box(fn(gap : view::View) -> Unit { let _ = gap.fill() })
                bp_text_btn(ask, fn() { "Cancel" }, "Cancel", fn() { resetting.set(false) }, made=bp_take_focus)
                bp_text_btn(
                  ask,
                  fn() { "Reset Boost for " + host_label() },
                  "Reset Boost",
                  fn() {
                    resetting.set(false)
                    reset()
                  },
                  danger=true,
                  disabled=no_origin,
                )
              })
              hdr.show(fn() { page.get() != BP_PAGE_MAIN }, at_once=true, fn(sub : view::View) -> Unit {
                let _ = sub.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).fill().gap(view::Live::Is(SP_4))
                page_push(sub)
                bp_icon_btn(sub, fn() { "Back to Boost" }, ICON_BACK, fn() { page.set(BP_PAGE_MAIN) }, color_by=fn() { lg::surface().ink })
                let _ = sub.box(fn(tw : view::View) -> Unit {
                  let _ = tw.fill()
                  <ui::Text
                    in={tw}
                    size={TX_BODY}
                    weight={600}
                    lines={1}
                    color_by=>{lg::surface().ink}
                    text_by=>{if page.get() == BP_PAGE_CODE { "Code" } else { "All Boosts" }}
                  />
                })
                bp_icon_btn(sub, fn() { "Close Site Boosts" }, ICON_CLOSE, close_now)
              })
            })
            shell.show(fn() { page.get() == BP_PAGE_MAIN && resetting.get() }, at_once=true, fn(cap : view::View) -> Unit {
              let _ = cap.rigid().padding(view::Live::Is((SP_16, SP_0, SP_16, SP_10))).ground(view::Live::By(fn() { lg::alpha(lg::surface().ink, 0.03) }))
              <ui::Text
                in={cap}
                size={TX_FOOTNOTE}
                wrap
                color_by=>{lg::surface().ink_secondary}
                text_by=>{host_label() + " loses its Boost: its colors, code and hidden elements."}
              />
            })
            let _ = shell.box(fn(rule : view::View) -> Unit {
              let _ = rule.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
            })

            // 2. The page, scrolling under the header when the window is short.
            let _ = shell.box(fn(bw : view::View) -> Unit {
              let _ = bw.shrink(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let vp = ui::scroll_box(bw, fn(body : view::View) -> Unit {
                let _ = body.padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
                body.switch_by(fn() -> Int { page.get() }, fn(pg : view::View, key : Int) -> Unit {
                  let _ = pg.gap(view::Live::Is(SP_12))
                  page_push(pg)
                  if key == BP_PAGE_CODE {
                    build_code_section(pg, props, no_origin, cur, apply_code, host_label)
                  } else if key == BP_PAGE_SITES {
                    // (its rows' menus are hosted inside the dialog, so a press on one is not a press outside it)
                    build_sites_section(pg, props, bound_origin, dlg_box)
                  } else {
                    build_boost_editor(pg, props, has_origin, no_origin, safe_save, cur, fine, layer, fn() {
                      page.set(BP_PAGE_CODE)
                    })
                  }
                })
              }, fill=false)
              let _ = vp.shrink(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
            })
          },
          radius=SP_20,
        )
      },
      modal=false,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if props.css_field.composing() {
            props.css_field.compose("")
            return true
          }
          if props.js_field.composing() {
            props.js_field.compose("")
            return true
          }
          // (Escape while picking ends Zap first; the next one closes the panel)
          if signals::untracked(props.zap_active) {
            (props.on_zap)(false)
            return true
          }
          false
        } else if how is headless::OverlayDismiss::Outside {
          // (while Zap is on, a click on the page picks an element: the panel stays)
          signals::untracked(props.zap_active)
        } else {
          false
        }
      },
    )
  })
  built.v = true
}

///| The editor's main page.
fn build_boost_editor(
  page : view::View,
  props : SiteBoostsProps,
  has_origin : () -> Bool,
  no_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
  fine : signals::Signal[Bool],
  tip_host : view::View,
  open_code : () -> Unit,
) -> Unit {
  let boost = props.boost
  // (what opens later comes in with the standard surface motion; what the editor opens with is there at once)
  let mounted : signals::Ref[Bool] = ui::ref_new(false)
  page.reacts(fn() { 0 }, fn(_z : Int) -> Unit { mounted.v = true })
  page.show(no_origin, at_once=true, fn(note : view::View) -> Unit {
    <ui::Text in={note} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text="Boosts work on http and https sites." />
  })
  build_boost_canvas(page, boost, has_origin, safe_save, cur)

  // Dark, the fine controls, no color.
  let tint_set = fn() -> Bool {
    has_origin() && (proto::normalize_boost_tint(boost().tint) != "" || proto::normalize_boost_tint(boost().tint2) != "")
  }
  let _ = page.box(fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(SP_8)).rigid()
    bp_face_btn(
      row,
      fn() { "Boost Theme Dark" },
      fn() {
        let b = cur()
        let dark = proto::normalize_boost_theme(b.theme) == "dark"
        safe_save(proto::SiteBoost::{ ..b, enabled: true, theme: if dark { "auto" } else { "dark" } })
      },
      fn(b, ink) { bp_bulb_glyph(b, ink) },
      on=fn() { has_origin() && proto::normalize_boost_theme(boost().theme) == "dark" },
      disabled=no_origin,
    )
    bp_face_btn(
      row,
      fn() { "Fine Color Controls" },
      // (told as a person's act, so the section's way out plays)
      shell_closes(page, fn() { fine.set(!fine.untracked()) }),
      fn(b, ink) {
        let _ = shell_icon(b, ICON_DRAWER, size=IC_MD, color_by=ink)
      },
      on=fn() { fine.get() && has_origin() },
      disabled=no_origin,
    )
    bp_face_btn(
      row,
      fn() { "Remove Boost Colors" },
      fn() { safe_save(proto::SiteBoost::{ ..cur(), tint: "", tint2: "" }) },
      fn(b, ink) { bp_none_glyph(b, ink) },
      disabled=fn() { !tint_set() },
    )
  })
  page.show(fn() { fine.get() && has_origin() }, leave=MO_POP_OUT_MS, fn(fc : view::View) -> Unit {
    shell_reveal(fc, mounted.v).fades(fc)
    build_boost_fine_controls(fc, props, has_origin, safe_save, cur)
  })

  // Typefaces: an "Aa" in each, the chosen one in ink on a quiet ground; the chosen one again goes back to the
  // page's own.
  build_boost_fonts(page, boost, has_origin, safe_save, cur, tip_host)

  // Size and Case.
  let _ = page.box(fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(SP_8)).rigid()
    let scale = fn() -> Int { if has_origin() { proto::clamp_boost_scale_pct(boost().scale_pct) } else { proto::BOOST_SCALE_DEFAULT } }
    let tcase = fn() -> String { if has_origin() { proto::normalize_boost_case(boost().text_case) } else { "none" } }
    bp_face_btn(
      row,
      fn() { "Boost Text Size" },
      fn() {
        let b = cur()
        safe_save(proto::SiteBoost::{ ..b, enabled: true, scale_pct: proto::boost_next_scale(b.scale_pct) })
      },
      fn(b, ink) {
        bp_face_text(b, fn() { "Size" }, ink)
        b.show(fn() { scale() != proto::BOOST_SCALE_DEFAULT }, at_once=true, fn(v : view::View) -> Unit {
          bp_face_text(v, fn() { scale().to_string() + "%" }, fn() { lg::alpha(ink(), 0.72) })
        })
      },
      disabled=no_origin,
      value=fn() { scale().to_string() + "%" },
    )
    bp_face_btn(
      row,
      fn() { "Boost Letter Case" },
      fn() {
        let b = cur()
        safe_save(proto::SiteBoost::{ ..b, enabled: true, text_case: proto::boost_next_case(b.text_case) })
      },
      fn(b, ink) {
        bp_face_text(b, fn() { "Case" }, ink)
        b.show(fn() { tcase() != "none" }, at_once=true, fn(v : view::View) -> Unit {
          bp_face_text(v, fn() { if tcase() == "upper" { "AA" } else { "aa" } }, fn() { lg::alpha(ink(), 0.72) })
        })
      },
      disabled=no_origin,
      value=fn() {
        let c = tcase()
        if c == "upper" {
          "Uppercase"
        } else if c == "lower" {
          "Lowercase"
        } else {
          "As the page sets it"
        }
      },
    )
  })

  // Zap: filled while picking, the count of what this site hides.
  let zapped = fn() -> Array[String] { if has_origin() { proto::normalize_boost_zapped(boost().zapped) } else { [] } }
  let zap_on = fn() -> Bool { has_origin() && (props.zap_active)() }
  bp_face_btn(
    page,
    fn() { "Zap Elements" },
    shell_closes(page, fn() { (props.on_zap)(!signals::untracked(props.zap_active)) }),
    fn(b, ink) {
      bp_face_text(b, fn() { "Zap" }, ink)
      // (what this site hides, whenever it hides anything, beside the bolt)
      let _ = b.box(fn(tr : view::View) -> Unit {
        let _ = tr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_6)).rigid()
        tr.show(fn() { zapped().length() > 0 }, at_once=true, fn(v : view::View) -> Unit {
          bp_face_text(v, fn() { zapped().length().to_string() }, ink)
        })
        let _ = shell_icon(tr, ICON_ZAP, size=IC_MD, color_by=ink)
      })
    },
    on=zap_on,
    disabled=no_origin,
    grow=false,
    pad_x=SP_16,
    value=fn() {
      let n = zapped().length()
      if n == 1 {
        "1 hidden"
      } else {
        n.to_string() + " hidden"
      }
    },
  )
  page.show(fn() { zap_on() }, leave=MO_POP_OUT_MS, fn(zs : view::View) -> Unit {
    shell_reveal(zs, mounted.v).fades(zs)
    build_zap_list(zs, props, zapped, safe_save, cur)
  })

  // Code.
  bp_face_btn(
    page,
    fn() { "Edit Boost Code" },
    open_code,
    fn(b, ink) {
      bp_face_text(b, fn() { "Code" }, ink)
      bp_face_text(b, fn() { "{}" }, ink, mono=true)
    },
    disabled=no_origin,
    grow=false,
    pad_x=SP_16,
  )
}

///| The color canvas: a dotted field in a gradient frame of the boost's two colors, the tint's handle (large) and
///| the second color's (small). A place on the field is a hue (across) and a depth (down), as on the Space theme
///| canvas; a handle with no color of its own rests gray where Arc puts it.
fn build_boost_canvas(
  page : view::View,
  boost : () -> proto::SiteBoost,
  has_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
) -> Unit {
  // The handle being dragged and where it is, before it is saved on release.
  let live : signals::Signal[Option[(Int, Double, Double)]] = signals::signal_by(None, fn(a, b) {
    match (a, b) {
      (None, None) => true
      (Some((wa, xa, ya)), Some((wb, xb, yb))) => wa == wb && xa == xb && ya == yb
      _ => false
    }
  })
  let dragging : signals::Signal[Int] = signals::signal(-1)
  let hex_of = fn(which : Int) -> String {
    if !has_origin() {
      return ""
    }
    let b = boost()
    proto::normalize_boost_tint(if which == 0 { b.tint } else { b.tint2 })
  }
  let point = fn(which : Int) -> (Double, Double) {
    match live.get() {
      Some((w, x, y)) if w == which => return (x, y)
      _ => ()
    }
    let h = hex_of(which)
    if h == "" {
      if which == 0 { (0.72, 0.42) } else { (0.6, 0.7) }
    } else {
      proto::space_theme_position_of(proto::boost_tint_rgba(h))
    }
  }
  let rgba = fn(which : Int) -> Int64 {
    match live.get() {
      Some((w, x, y)) if w == which => return proto::space_theme_color_at(x, y)
      _ => ()
    }
    let h = hex_of(which)
    if h != "" {
      proto::boost_tint_rgba(h)
    } else if which == 0 {
      if lg::is_dark() { 0x8E8E93FFL } else { 0x6E6E73FFL }
    } else if lg::is_dark() {
      0x48484AFFL
    } else {
      0x2C2C2EFFL
    }
  }
  // The frame's two ends: the colors themselves, or (no color yet) a dark gray fading to a light one.
  let ring = fn(which : Int) -> Int64 {
    if hex_of(which) != "" || live.get().is_some() {
      rgba(which)
    } else if which == 0 {
      if lg::is_dark() { 0x8E8E93FFL } else { 0x48484AFFL }
    } else if lg::is_dark() {
      0x3A3A3CFFL
    } else {
      0xD1D1D6FFL
    }
  }
  let save_at = fn(which : Int, x : Double, y : Double) -> Unit {
    let hex = proto::normalize_boost_tint(proto::space_theme_hex(proto::space_theme_color_at(bp_clamp01(x), bp_clamp01(y))))
    let b = cur()
    safe_save(if which == 0 { proto::SiteBoost::{ ..b, enabled: true, tint: hex } } else { proto::SiteBoost::{ ..b, enabled: true, tint2: hex } })
  }
  // (the saved color comes back from the app: the live place gives way to it)
  page.reacts(at_start=false, fn() { (boost().tint, boost().tint2) }, fn(_v : (String, String)) -> Unit {
    if dragging.untracked() < 0 {
      live.set(None)
    }
  })
  let _ = page.box(fn(frame : view::View) -> Unit {
    // The frame: the tint at its top left, the second color at its foot right, blended across.
    let _ = frame
    .width(view::Live::Is(Some(BP_CANVAS)))
    .height(view::Live::Is(Some(BP_CANVAS)))
    .rigid()
    .radius(view::Live::Is(SP_20))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { ring(0) }))
    // (a page that cannot be boosted shows the canvas at rest, dimmed)
    .alpha(view::Live::By(fn() { if has_origin() { 1.0 } else { 0.5 } }))
    .says(view::Live::Is(Some(view::said(view::Role::Group, label="Boost Colors"))))
    let _ = frame.box(fn(blend : view::View) -> Unit {
      let _ = blend
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .fades(view::Live::Is((BP_CANVAS, BP_CANVAS, SP_0, SP_0)))
      let _ = blend.box(fn(s : view::View) -> Unit {
        let _ = s.over(view::Live::Is(true)).points(view::Live::Is(false)).ground(view::Live::By(fn() { ring(1) }))
      })
    })
    let _ = frame.box(fn(field : view::View) -> Unit {
      let _ = field.over(view::Live::Is(true), edges=(Some(BP_RING), Some(BP_RING), Some(BP_RING), Some(BP_RING)))
      color_canvas_field(field, BP_FIELD, SP_12, fn() { if lg::is_dark() { lg::surface().card_secondary } else { lg::surface().card } })
      // The second color under the tint (the tint's handle is the larger, on top).
      for which in [1, 0] {
        let w = which
        let _ = field.box(fn(h : view::View) -> Unit {
          color_canvas_handle(h, CanvasHandle::{
            side: BP_FIELD,
            face: if w == 0 { SP_32 } else { SP_20 },
            hit: if w == 0 { SP_40 } else { SP_32 },
            label: if w == 0 { "Boost Tint" } else { "Boost Second Color" },
            value: fn() {
              let h = hex_of(w)
              if h == "" { "None" } else { h }
            },
            point: fn() { point(w) },
            rgba: fn() { rgba(w) },
            big: fn() { dragging.get() == w },
            on_down: fn() {
              if signals::untracked(has_origin) {
                dragging.set(w)
              }
            },
            on_move: fn(x, y) {
              if dragging.untracked() == w {
                live.set(Some((w, bp_clamp01(x), bp_clamp01(y))))
              }
            },
            on_up: fn() {
              if dragging.untracked() == w {
                dragging.set(-1)
                match live.untracked() {
                  Some((lw, x, y)) if lw == w => save_at(w, x, y)
                  _ => ()
                }
              }
            },
            on_step: fn(by : Int) {
              let (x, y) = signals::untracked(fn() { point(w) })
              save_at(w, x + by.to_double() * 0.02, y)
            },
            on_arrow: fn(x, y) {
              if signals::untracked(has_origin) {
                live.set(Some((w, bp_clamp01(x), bp_clamp01(y))))
                save_at(w, x, y)
              }
            },
            on_delete: fn() {
              let b = cur()
              if hex_of(w) == "" {
                false
              } else {
                safe_save(if w == 0 { proto::SiteBoost::{ ..b, tint: "" } } else { proto::SiteBoost::{ ..b, tint2: "" } })
                true
              }
            },
          })
        })
      }
    })
  })
}

///| The fine controls under the sliders button: the other themes, tint intensity, brightness, contrast, invert,
///| hiding pop-ups.
fn build_boost_fine_controls(
  parent : view::View,
  props : SiteBoostsProps,
  has_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
) -> Unit {
  let boost = props.boost
  let no_origin = fn() -> Bool { !has_origin() }
  let tint_drag = bp_drag_value(parent, fn() { boost().tint_pct })
  let bright_drag = bp_drag_value(parent, fn() { boost().brightness_pct })
  let contrast_drag = bp_drag_value(parent, fn() { boost().contrast_pct })
  let pct_text = fn(drag : signals::Signal[Double], saved : () -> Int) -> () -> String {
    fn() {
      let v = if drag.get() >= 0.0 { drag.get().to_int() } else { saved() }
      v.to_string() + "%"
    }
  }
  // (on the gray of the editor's buttons: the sliders' white thumbs stand off it)
  let _ = parent.box(fn(card : view::View) -> Unit {
    let _ = card
    .rigid()
    .radius(view::Live::Is(SP_12))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { shell_mix(lg::surface().card, lg::surface().ink, if lg::is_dark() { 0.14 } else { 0.07 }) }))
    let _ = card.box(fn(ch : view::View) -> Unit {
      let _ = ch.padding(view::Live::Is((SP_12, SP_12, SP_12, SP_4)))
      bp_choices(
        ch,
        [("auto", "Off"), ("sepia", "Sepia"), ("contrast", "Contrast")],
        fn() {
          let t = if has_origin() { proto::normalize_boost_theme(boost().theme) } else { "auto" }
          if t == "dark" { "" } else { t }
        },
        "Boost Theme ",
        fn(id : String) -> Unit {
          if signals::untracked(has_origin) {
            safe_save(proto::SiteBoost::{ ..cur(), enabled: true, theme: id })
          }
        },
        disabled=no_origin,
      )
    })
    bp_fine_slider(
      card,
      "Intensity",
      pct_text(tint_drag, fn() { boost().tint_pct }),
      fn() { if tint_drag.get() >= 0.0 { tint_drag.get() } else { boost().tint_pct.to_double() } },
      0.0,
      100.0,
      5.0,
      fn(v : Double) -> Unit { tint_drag.set(v) },
      fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, tint_pct: proto::clamp_boost_tint_pct(v.to_int()) }) },
      "Boost Tint Intensity",
      disabled=fn() { !has_origin() || proto::normalize_boost_tint(boost().tint) == "" },
    )
    bp_fine_slider(
      card,
      "Brightness",
      pct_text(bright_drag, fn() { boost().brightness_pct }),
      fn() { if bright_drag.get() >= 0.0 { bright_drag.get() } else { boost().brightness_pct.to_double() } },
      proto::BOOST_ADJUST_MIN.to_double(),
      proto::BOOST_ADJUST_MAX.to_double(),
      5.0,
      fn(v : Double) -> Unit { bright_drag.set(v) },
      fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, brightness_pct: proto::clamp_boost_adjust_pct(v.to_int()) }) },
      "Boost Brightness",
      disabled=no_origin,
    )
    bp_fine_slider(
      card,
      "Contrast",
      pct_text(contrast_drag, fn() { boost().contrast_pct }),
      fn() { if contrast_drag.get() >= 0.0 { contrast_drag.get() } else { boost().contrast_pct.to_double() } },
      proto::BOOST_ADJUST_MIN.to_double(),
      proto::BOOST_ADJUST_MAX.to_double(),
      5.0,
      fn(v : Double) -> Unit { contrast_drag.set(v) },
      fn(v : Double) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, contrast_pct: proto::clamp_boost_adjust_pct(v.to_int()) }) },
      "Boost Contrast",
      disabled=no_origin,
    )
    bp_rule(card, inset=SP_12)
    bp_fine_toggle(
      card,
      "Invert colors",
      "Invert colors",
      fn() { has_origin() && boost().invert },
      fn(on : Bool) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, invert: on }) },
      no_origin,
    )
    bp_rule(card, inset=SP_12)
    bp_fine_toggle(
      card,
      "Hide pop-ups and banners",
      "Hide pop-ups and banners",
      fn() { has_origin() && boost().hide_sticky },
      fn(on : Bool) -> Unit { safe_save(proto::SiteBoost::{ ..cur(), enabled: true, hide_sticky: on }) },
      no_origin,
    )
  })
}

///| The typeface grid: one "Aa" per typeface the panel can draw apart (`proto::boost_grid_fonts`), each in the
///| nearest of the panel's own faces, named in its tooltip. The chosen one is in ink on a quiet ground; a page that
///| cannot be boosted shows the grid dimmed and inert.
fn build_boost_fonts(
  page : view::View,
  boost : () -> proto::SiteBoost,
  has_origin : () -> Bool,
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
  tip_host : view::View,
) -> Unit {
  let fonts = proto::boost_grid_fonts()
  let off = fn() -> Bool { !has_origin() }
  let chosen = fn() -> String { if has_origin() { proto::normalize_boost_font(boost().font) } else { "default" } }
  let _ = page.box(fn(card : view::View) -> Unit {
    let _ = card
    .rigid()
    .radius(view::Live::Is(SP_12))
    .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
    .gap(view::Live::Is(SP_2))
    .ground(view::Live::By(fn() { lg::surface().card }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
    .says(view::Live::Is(Some(view::said(view::Role::Group, label="Boost Typefaces"))))
    let mut start = 0
    while start < fonts.length() {
      let row_from = start
      let _ = card.box(fn(row : view::View) -> Unit {
        let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(SP_2))
        let mut i = row_from
        while i < row_from + BP_FONT_COLS && i < fonts.length() {
          let f = fonts[i]
          let is_on = fn() -> Bool { chosen() == f.id }
          let _ = lg::liquid_tooltip_node(
            row,
            tip_host,
            fn() { f.label },
            fn(trig : view::View) -> Unit {
              let _ = trig.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = headless::button(
                trig,
                fn() { "Boost Font " + f.label },
                fn(_v : view::View) -> Unit {
                  if signals::untracked(has_origin) {
                    let b = cur()
                    let next = if proto::normalize_boost_font(b.font) == f.id { "default" } else { f.id }
                    safe_save(proto::SiteBoost::{ ..b, enabled: true, font: next })
                  }
                },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !off() })
                  let on_t = shell_fade(b, is_on, duration_ms=MO_KEY_MS)
                  let _ = b
                  .fill()
                  .height(view::Live::Is(Some(SP_40)))
                  .center()
                  .radius(view::Live::Is(SP_8))
                  // (the chosen one on the gray of a monochrome tile, the hover a lighter wash of it)
                  .ground(view::Live::By(fn() {
                    lg::alpha(lg::surface().ink, (if lg::is_dark() { 0.16 } else { 0.08 }) * on_t() + 0.04 * hover_t() * (1.0 - on_t()))
                  }))
                  .says(view::Live::By(fn() {
                    Some(view::said(view::Role::Button, label="Boost Font " + f.label, selected=is_on()))
                  }))
                  let _ = b.box(fn(tw : view::View) -> Unit {
                    let _ = tw.rigid().points(view::Live::Is(false))
                    let _ = tw.words_runs(
                      view::Live::By(fn() {
                        let base = if is_on() { lg::surface().ink } else { lg::surface().ink_secondary }
                        let ink = if off() { lg::alpha(base, 0.35) } else { base }
                        [
                          text::Run::{
                            ..text::plain("Aa"),
                            color: ink,
                            weight: f.weight,
                            italic: f.italic,
                            mono: f.family == "mono",
                            serif: f.family == "serif",
                          },
                        ]
                      }),
                      look=view::WordsLook::of(TX_CALLOUT, wrap=false),
                    )
                    // (the words' own ink follows the appearance and the choice too, not only their run)
                    let _ = tw.ink(view::Live::By(fn() {
                      let base = if is_on() { lg::surface().ink } else { lg::surface().ink_secondary }
                      if off() { lg::alpha(base, 0.35) } else { base }
                    }))
                  })
                },
              )
            },
          )
          i += 1
        }
      })
      start += BP_FONT_COLS
    }
  })
}

///| What Zap hid on this site, while Zap is on: each to bring back, or all of them.
fn build_zap_list(
  parent : view::View,
  props : SiteBoostsProps,
  zapped : () -> Array[String],
  safe_save : (proto::SiteBoost) -> Unit,
  cur : () -> proto::SiteBoost,
) -> Unit {
  let _ = props
  bp_group(
    parent,
    fn() { "" },
    fn() { if zapped().length() == 0 { "Click anything on the page to select it." } else { "Hidden on every visit." } },
    fn(card : view::View) -> Unit {
      card.switch_by(fn() -> String { zapped().join("\n") }, fn(list : view::View, _k : String) -> Unit {
        let items = signals::untracked(zapped)
        if items.length() == 0 {
          let _ = list.box(fn(e : view::View) -> Unit {
            let _ = e.padding(view::Live::Is((SP_12, SP_10, SP_12, SP_10)))
            <ui::Text in={e} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text="Nothing hidden yet" />
          })
          return
        }
        let mut i = 0
        while i < items.length() {
          let sel = items[i]
          if i > 0 {
            bp_rule(list, inset=SP_12)
          }
          let _ = list.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .height(view::Live::Is(Some(SP_40)))
            .padding(view::Live::Is((SP_12, SP_4, SP_4, SP_4)))
            .gap(view::Live::Is(SP_4))
            // (one line each, cut with an ellipsis; the full selector is the row's name and its Restore button's)
            let _ = row.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).clips(view::Live::Is(true)).says(view::Live::Is(Some(view::said(view::Role::Text, label=sel))))
              // (the words in a box of their own, which the clipping one around them cuts at its edge)
              let _ = tw.box(fn(wd : view::View) -> Unit {
                let _ = wd.rigid().points(view::Live::Is(false))
                let _ = wd.words_runs(
                  view::Live::By(fn() { [rb_make_run(sel, lg::surface().ink, "mono")] }),
                  look=view::WordsLook::of(TX_CAPTION, wrap=false, max_lines=1),
                )
                let _ = wd.ink(view::Live::By(fn() { lg::surface().ink }))
              })
            })
            bp_icon_btn(row, fn() { "Restore " + sel }, BP_IC_EYE, fn() { safe_save(proto::boost_zap_remove(cur(), sel)) }, color_by=fn() {
              lg::surface().ink
            })
          })
          i += 1
        }
        bp_rule(list, inset=SP_12)
        let _ = list.box(fn(all_row : view::View) -> Unit {
          // (the button's own SP_10 padding puts its label at the card's SP_12 inset)
          let _ = all_row.row(view::Live::Is(true)).padding(view::Live::Is((SP_2, SP_4, SP_8, SP_4)))
          bp_text_btn(
            all_row,
            fn() { "Restore All Zapped" },
            "Show all",
            fn() { safe_save(proto::SiteBoost::{ ..cur(), zapped: [] }) },
            tinted=true,
          )
        })
      })
    },
  )
}

fn build_code_section(
  page : view::View,
  props : SiteBoostsProps,
  no_origin : () -> Bool,
  cur : () -> proto::SiteBoost,
  apply_code : (proto::SiteBoost) -> Unit,
  host_label : () -> String,
) -> Unit {
  bp_group(page, fn() { "" }, fn() { "Added after the page's own styles." }, fn(card : view::View) -> Unit {
    bp_row(card, BP_IC_CODE, fn() { "CSS" }, fn(tr : view::View) -> Unit {
      bp_text_btn(
        tr,
        fn() { "Apply Custom CSS" },
        "Apply",
        fn() { apply_code(proto::SiteBoost::{ ..cur(), custom_css: props.css_field.text() }) },
        tinted=true,
        disabled=no_origin,
        corner=lg::concentric(SP_12, SP_8),
      )
    }, trail_pad=SP_2)
    bp_code_card(card, props.css_field, "Custom CSS", "article { max-width: 72ch; }", on_edited=props.on_css_edited)
  })
  bp_group(
    page,
    fn() { "" },
    fn() { "Runs on " + host_label() + " each time one of its pages loads, with the same access as the page's own scripts." },
    fn(card : view::View) -> Unit {
      bp_row(card, BP_IC_FILE_CODE, fn() { "JavaScript" }, fn(tr : view::View) -> Unit {
        bp_text_btn(
          tr,
          fn() { "Apply Custom JavaScript" },
          "Apply",
          fn() { apply_code(proto::SiteBoost::{ ..cur(), custom_js: props.js_field.text() }) },
          tinted=true,
          disabled=no_origin,
          corner=lg::concentric(SP_12, SP_8),
        )
      }, trail_pad=SP_2)
      bp_code_card(card, props.js_field, "Custom JavaScript", "document.querySelector('#comments')?.remove();")
    },
  )
}

///| A recessed set of choices inside a card row (the themes): the chosen one raised. Each segment is as wide as
///| its label and SP_8 either side, the room left shared among them.
fn bp_choices(
  parent : view::View,
  items : Array[(String, String)],
  selected : () -> String,
  said_prefix : String,
  on_pick : (String) -> Unit,
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = parent.box(fn(track : view::View) -> Unit {
    let _ = track
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
    .gap(view::Live::Is(SP_2))
    .radius(view::Live::Is(SP_10))
    .ground(view::Live::By(fn() { lg::alpha(lg::surface().ink, if lg::is_dark() { 0.14 } else { 0.07 }) }))
    for item in items {
      let (id, label) = item
      let is_on = fn() -> Bool { selected() == id && !disabled() }
      let _ = headless::button(
        track,
        fn() { said_prefix + label },
        fn(_v : view::View) -> Unit {
          if !disabled() {
            on_pick(id)
          }
        },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !is_on() && !disabled() })
          let _ = b
          .grow(view::Live::Is(1.0))
          .height(view::Live::Is(Some(SP_32)))
          .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
          .center()
          .radius(view::Live::Is(SP_8))
          .ground(view::Live::By(fn() -> Int64 {
            if is_on() {
              if lg::is_dark() { shell_wash_strong(true) } else { lg::surface().card }
            } else {
              lg::alpha(lg::surface().row_hover, hover_t())
            }
          }))
          .shadow(view::Live::By(fn() {
            let (blur, dy, col) = shell_row_lift(lg::is_dark())
            if is_on() { (blur, dy, col) } else { (blur, dy, lg::alpha(col, 0.0)) }
          }))
          .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label=said_prefix + label, selected=is_on())) }))
          let t = <ui::Text
            in={b}
            size={TX_FOOTNOTE}
            weight={500}
            lines={1}
            color_by=>{
              if disabled() {
                lg::alpha(lg::surface().ink_secondary, 0.5)
              } else if is_on() {
                lg::surface().ink
              } else {
                // (a little deeper than the secondary ink: the track is gray on the gray card)
                shell_mix(lg::surface().ink_secondary, lg::surface().ink, 0.35)
              }
            }
            text={label}
          />
          let _ = t.rigid()
        },
      )
    }
  })
}

fn build_sites_section(page : view::View, props : SiteBoostsProps, bound_origin : () -> String, layer : view::View) -> Unit {
  let list_all = fn() -> Array[proto::SiteBoost] {
    let out : Array[proto::SiteBoost] = []
    for b in (props.all_boosts)() {
      if proto::normalize_boost_host(b.host) != "" {
        out.push(b)
      }
    }
    out
  }
  let here = fn() -> String { proto::normalize_boost_host(bound_origin()) }
  let pick = fn(mine : Bool) -> Array[proto::SiteBoost] {
    let h = here()
    let out : Array[proto::SiteBoost] = []
    for b in list_all() {
      if (h != "" && proto::normalize_boost_host(b.host) == h) == mine {
        out.push(b)
      }
    }
    out
  }
  let this_site = fn() -> Array[proto::SiteBoost] { pick(true) }
  let others = fn() -> Array[proto::SiteBoost] { pick(false) }
  // (the host whose row asks to confirm its delete, "" for none)
  let confirm : signals::Signal[String] = signals::signal("")
  let key_of = fn(items : Array[proto::SiteBoost]) -> String {
    // (not the row asking to confirm: each row follows that itself, and a rebuild would take an open menu's
    // trigger from under it)
    let parts : Array[String] = []
    for b in items {
      parts.push(b.host + (if b.enabled { "+" } else { "-" }) + bp_boost_summary(b))
    }
    parts.join("\n")
  }
  let rows_of = fn(list : view::View, items : Array[proto::SiteBoost]) -> Unit {
    let mut i = 0
    while i < items.length() {
      let b = items[i]
      let host = proto::normalize_boost_host(b.host)
      if i > 0 {
        bp_rule(list)
      }
      bp_site_row(list, props, b, host, confirm, layer)
      i += 1
    }
  }
  page.show(fn() { list_all().length() == 0 }, fn(empty : view::View) -> Unit {
    bp_group(empty, fn() { "Boosted sites" }, fn() { "" }, fn(card : view::View) -> Unit {
      let _ = card.box(fn(e : view::View) -> Unit {
        let _ = e.padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
        <ui::Text
          in={e}
          size={TX_BODY}
          wrap
          color_by=>{lg::surface().ink_secondary}
          text="No Boosts yet. Change anything in a site's Boost and it is listed here."
        />
      })
    })
  })
  page.show(fn() { this_site().length() > 0 }, fn(g : view::View) -> Unit {
    bp_group(g, fn() { "This site" }, fn() { "" }, fn(card : view::View) -> Unit {
      card.switch_by(fn() -> String { key_of(this_site()) }, fn(list : view::View, _k : String) -> Unit {
        rows_of(list, signals::untracked(this_site))
      })
    })
  })
  page.show(fn() { others().length() > 0 }, fn(g : view::View) -> Unit {
    bp_group(
      g,
      fn() { if this_site().length() > 0 { "Other sites" } else { "Boosted sites" } },
      fn() { "A boost applies to every page of its site." },
      fn(card : view::View) -> Unit {
        card.switch_by(fn() -> String { key_of(others()) }, fn(list : view::View, _k : String) -> Unit {
          rows_of(list, signals::untracked(others))
        })
      },
    )
  })
}

///| One boosted site: its monochrome monogram beside the host, what the boost changes under it; trailing More
///| (open the site, delete its boost) and the boost's toggle, so the host keeps the room. Delete asks once more in
///| place (it drops the site's code and hidden elements too).
fn bp_site_row(
  list : view::View,
  props : SiteBoostsProps,
  b : proto::SiteBoost,
  host : String,
  confirm : signals::Signal[String],
  layer : view::View,
) -> Unit {
  let asking = fn() -> Bool { confirm.get() == host }
  let more_open : signals::Signal[Bool] = signals::signal(false)
  let _ = list.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_48)))
    .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
    .gap(view::Live::Is(SP_12))
    bp_site_tile(row, fn() { host }, size=SP_24)
    let _ = row.box(fn(main : view::View) -> Unit {
      let _ = main.fill().min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
      let h = <ui::Text in={main} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text={host} />
      let _ = h.cut().allow_ellipsis(view::Live::Is(true))
      let sm = <ui::Text
        in={main}
        size={TX_FOOTNOTE}
        lines={1}
        color_by=>{if asking() { lg::surface().danger } else { lg::surface().ink_secondary }}
        text_by=>{if asking() { "Its colors, code and hidden elements go too." } else { bp_boost_summary(b) }}
      />
      let _ = sm.cut().allow_ellipsis(view::Live::Is(true))
    })
    row.show(asking, at_once=true, fn(ask : view::View) -> Unit {
      let _ = ask.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).rigid()
      bp_text_btn(ask, fn() { "Keep Boost for " + host }, "Cancel", fn() { confirm.set("") })
      bp_text_btn(
        ask,
        fn() { "Confirm Delete Boost for " + host },
        "Delete",
        fn() {
          confirm.set("")
          (props.on_site_delete)(host)
        },
        danger=true,
      )
    })
    // (More and the toggle stay mounted while the row asks, folded away: the menu's trigger never goes from under
    // its own menu)
    let _ = row.box(fn(acts : view::View) -> Unit {
      let _ = acts
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(SP_8))
      .rigid()
      .clips(view::Live::Is(true))
      .width(view::Live::By(fn() -> Option[Double] { if asking() { Some(0.0) } else { None } }))
      .alpha(view::Live::By(fn() { if asking() { 0.0 } else { 1.0 } }))
      .points(view::Live::By(fn() { !asking() }))
      let _ = shell_menu_node(
        acts,
        layer,
        fn() { more_open.get() },
        fn(v : Bool) -> Unit { more_open.set(v) },
        fn() { "More for " + host },
        fn(trig : view::View, disc : headless::Disclosure) -> Unit {
          let hover_t = shell_fade(trig, fn() { disc.open() || disc.hovered() })
          shell_press(trig, fn() { disc.pressed() })
          let _ = trig
          .width(view::Live::Is(Some(SP_32)))
          .height(view::Live::Is(Some(SP_32)))
          .radius(view::Live::Is(SP_16))
          .rigid()
          .center()
          .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
          let _ = shell_icon(trig, ICON_MORE, size=IC_MD, color_by=fn() { lg::surface().ink_secondary })
        },
        fn() -> Array[ShellMenuEntry] {
          [
            ShellMenuEntry::item(label="Open " + host, on_select=fn() { (props.on_site_open)(host) }),
            ShellMenuEntry::item(label="Delete Boost", destructive=true, on_select=fn() {
              // (the menu closes before its row swaps to the confirmation, so it is closed when the row comes back)
              more_open.set(false)
              confirm.set(host)
            }),
          ]
        },
        menu_label=fn() { host + " Actions" },
        min_width=SP_160 + SP_16,
      )
      let _ = shell_desktop_toggle(
        acts,
        fn() { b.enabled },
        fn(on : Bool) -> Unit { (props.on_site_save)(proto::SiteBoost::{ ..b, host, enabled: on }) },
        fn() { "Boost " + host },
        on_color=bp_toggle_on,
      )
    })
  })
}

// ---------------------------------------------------------------------------------------------------------------
// Gallery demos (`pion/cmd/shell_shots`, `FV_SHOTS_ONLY=boosts`): the panels with sample data.
// ---------------------------------------------------------------------------------------------------------------

fn demo_reader_article() -> proto::ReaderArticle {
  let blk = fn(kind : proto::ReaderBlockKind, level : Int, t : String) -> proto::ReaderBlock {
    proto::ReaderBlock::{ kind, level, text: t }
  }
  // (the article of the demo shell's own page: notes.example.com, "Designing for Reading")
  proto::ReaderArticle::{
    url: "https://notes.example.com/designing-for-reading",
    host: "notes.example.com",
    title: "Designing for Reading",
    byline: "Mara Lind",
    read_minutes: 6,
    word_count: 1240,
    blocks: [
      blk(
        proto::ReaderBlockKind::Paragraph,
        0,
        "A page is easy to read when the eye never has to search: lines short enough to follow back, space between paragraphs that says where a thought ends, and nothing beside the text asking to be looked at.",
      ),
      blk(
        proto::ReaderBlockKind::Paragraph,
        0,
        "Most of the work happens before a single word is styled. Choose the measure first, sixty to seventy-five characters, then let the type size and the leading follow from it.",
      ),
      blk(proto::ReaderBlockKind::Heading, 2, "Start with the measure"),
      blk(
        proto::ReaderBlockKind::Paragraph,
        0,
        "A wide column tires the reader on the way back to the start of each line; a narrow one breaks phrases apart. The measure sets the rhythm every other choice on the page keeps.",
      ),
      blk(proto::ReaderBlockKind::Code, 0, "article {\n  max-width: 68ch;\n  line-height: 1.6;\n}"),
      blk(proto::ReaderBlockKind::Quote, 0, "Leading is the space a line needs to be found again."),
      blk(proto::ReaderBlockKind::ListItem, 0, "Set the body between 16 and 20 points on a screen read at arm's length."),
      blk(proto::ReaderBlockKind::ListItem, 0, "Give headings more space above than below, so they belong to what follows."),
    ],
  }
}

///| The page card's place in the demo shell (where a pane's overlays sit).
fn demo_card_rect(root : view::View) -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
  let _ = root.laid_size_told()
  let w = root.window_w()
  let side = shell_sidebar_width(w, true)
  if side > SP_0 {
    (Some(side + SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP))
  } else {
    (Some(SHELL_FRAME_GAP), Some(SHELL_TOP_ROW_H), Some(SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP))
  }
}

///| Reader Mode over the demo shell's page card, with a sample MDN article.
pub fn build_demo_reader_mode(root : view::View, theme~ : String = "light", font~ : String = "serif") -> Unit {
  let theme_s = signals::signal(theme)
  let font_s = signals::signal(font)
  let size_s = signals::signal(17)
  let width_s = signals::signal("medium")
  let progress_s = signals::signal(0.18)
  let art = demo_reader_article()
  let _ = root.box(fn(card : view::View) -> Unit {
    let _ = card
    .over_at(view::Live::By(fn() { demo_card_rect(root) }))
    .radius(view::Live::By(fn() { shell_canvas_radius() }))
    .clips(view::Live::Is(true))
    build_reader_mode_panel(card, ReaderModeProps::{
      open: fn() { true },
      owner_pane: PaneId::Primary,
      article: fn() { art },
      rev: fn() { 1 },
      status: fn() { READER_STATUS_READY },
      theme: fn() { theme_s.get() },
      font: fn() { font_s.get() },
      font_size: fn() { size_s.get() },
      width_mode: fn() { width_s.get() },
      progress: fn() { progress_s.get() },
      on_theme: fn(v) { theme_s.set(v) },
      on_font: fn(v) { font_s.set(v) },
      on_font_size: fn(v) { size_s.set(v) },
      on_width_mode: fn(v) { width_s.set(v) },
      on_progress: fn(v) { progress_s.set(v) },
      on_close: fn() { () },
    })
  })
}

fn demo_boosts() -> Array[proto::SiteBoost] {
  [
    // (the demo shell's own page, notes.example.com: what the Boost panel is bound to)
    proto::SiteBoost::{
      ..proto::SiteBoost::default_for("notes.example.com"),
      enabled: true,
      tint: "#5856d6",
      tint_pct: 35,
      tint2: "#ff9500",
      contrast_pct: 110,
      zapped: ["aside.newsletter-signup", "div.related-posts"],
      custom_css: "article pre {\n  font-size: 13px;\n  line-height: 1.5;\n}",
      custom_js: "document.querySelector('.share-bar')?.remove();",
    },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("github.com"), enabled: true, font: "sans", zapped: ["div.js-notice"] },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("developer.mozilla.org"), enabled: true, theme: "dark" },
    proto::SiteBoost::{
      ..proto::SiteBoost::default_for("en.wikipedia.org"),
      enabled: true,
      font: "serif",
      scale_pct: 110,
      zapped: ["#siteNotice"],
    },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("news.ycombinator.com"), enabled: false, theme: "sepia", scale_pct: 115 },
  ]
}

///| Site Boosts in the demo shell, bound to its page (`origin`, notes.example.com; `""` for a page that is not on
///| http or https): `section` 3 opens Code; `all` shows All Boosts; `zap` turns Zap on; `fine` opens the fine
///| controls; `font` and `text_case` set the boost's typeface and case; `plain` starts from a boost with no colors;
///| `hidden = false` starts with nothing hidden; `no_sites` shows an empty All Boosts.
pub fn build_demo_site_boosts(
  root : view::View,
  section~ : Int = 0,
  fine~ : Bool = false,
  font~ : String = "",
  text_case~ : String = "",
  plain~ : Bool = false,
  all~ : Bool = false,
  zap~ : Bool = false,
  origin~ : String = "notes.example.com",
  hidden~ : Bool = true,
  no_sites~ : Bool = false,
) -> Unit {
  let list = if no_sites { [] } else { demo_boosts() }
  let first = if origin == "" {
    proto::SiteBoost::default_for("")
  } else if no_sites {
    proto::SiteBoost::default_for(origin)
  } else if hidden {
    list[0]
  } else {
    proto::SiteBoost::{ ..list[0], zapped: [] }
  }
  let shaped = proto::SiteBoost::{
    ..first,
    font: if font != "" { font } else { first.font },
    text_case: if text_case != "" { text_case } else { first.text_case },
    tint: if plain { "" } else { first.tint },
    tint2: if plain { "" } else { first.tint2 },
  }
  let boost = signals::signal_ref(shaped)
  let zap_s = signals::signal(zap)
  let css_field = ui::Field::new()
  css_field.set(first.custom_css)
  let js_field = ui::Field::new()
  js_field.set(first.custom_js)
  build_site_boosts_panel(
    root,
    SiteBoostsProps::{
      open: fn() { true },
      dark: fn() { lg::is_dark() },
      target_origin: fn() { origin },
      owner_pane: fn() { PaneId::Primary },
      boost: fn() { boost.get() },
      css_field,
      anchor_top: fn() {
        let (_, top, _, _) = demo_card_rect(root)
        top.unwrap_or(SP_8) + SP_8
      },
      accent_color: fn() { 0L },
      on_save: fn(_o, b) { boost.set(b) },
      on_reset: fn(o) { boost.set(proto::SiteBoost::default_for(o)) },
      on_close: fn() { () },
      on_css_edited: None,
      on_apply_css: None,
      js_field,
      zap_active: fn() { zap_s.get() },
      on_zap: fn(on) { zap_s.set(on) },
      all_boosts: fn() { list },
      on_site_save: fn(_b) { () },
      on_site_open: fn(_h) { () },
      on_site_delete: fn(_h) { () },
    },
    initial_section=section,
    initial_all=all,
    initial_fine=fine,
  )
}
