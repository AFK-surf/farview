///| Farview Desktop Shell 2.0 — Reader Mode & Site Boosts Panels.
///|
///| Architectural invariants:
///| 1. Reader Mode (`build_reader_mode_panel`): 100% solid reading typography paper
///|    (Light / Sepia / Night calibrated solid palettes, zero Liquid Glass layers),
///|    bound to `owner_pane : PaneId` and article data, preserving paper theme, font size
///|    stepper (14..24), typeface (Sans/Serif/Mono), column width (Narrow/Medium/Wide),
///|    reading progress bar, read-time & word-count badges, and Close button.
///| 2. Site Boosts (`build_site_boosts_panel`): Single-layer Liquid Glass outer sheet
///|    (`lg::liquid_dialog_shell_node`) with solid `lg::surface()` inner content sections,
///|    bound to `target_origin` & `owner_pane`, preserving active switch, theme swatches,
///|    typography selector, text scale stepper (90%..130%), hide sticky overlays toggle,
///|    custom CSS draft via reused `ui::Field`, Save and Reset callbacks.
///| 3. Pure `packages/lg` overlays, vector icons only, 100% explicit `color_by`.

import "headless"
import "lg"
import "proto"
import "signals"
import "text"
import "ui"
import "view"

pub let READER_STATUS_LOADING : Int = 0
pub let READER_STATUS_INCOMPATIBLE : Int = 1
pub let READER_STATUS_READY : Int = 2

///| Strongly typed props for `build_reader_mode_panel`.
pub struct ReaderModeProps {
  pub open : () -> Bool
  pub owner_pane : PaneId
  pub article : () -> proto::ReaderArticle
  pub rev : () -> Int
  pub status : () -> Int
  pub theme : () -> String
  pub font : () -> String
  pub font_size : () -> Int
  pub width_mode : () -> String
  pub progress : () -> Double
  pub on_theme : (String) -> Unit
  pub on_font : (String) -> Unit
  pub on_font_size : (Int) -> Unit
  pub on_width_mode : (String) -> Unit
  pub on_progress : (Double) -> Unit
  pub on_close : () -> Unit
}

///| Strongly typed props for `build_site_boosts_panel`.
pub struct SiteBoostsProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub target_origin : () -> String
  pub owner_pane : () -> PaneId
  pub boost : () -> proto::SiteBoost
  pub css_field : ui::Field
  pub anchor_top : () -> Double
  pub accent_color : () -> Int64
  pub on_save : (String, proto::SiteBoost) -> Unit
  pub on_reset : (String) -> Unit
  pub on_close : () -> Unit
  pub on_css_edited : Option[(String) -> Unit]
  pub on_apply_css : Option[(String, proto::SiteBoost) -> Unit]
}

struct ReaderPaperPalette {
  page_bg : Int64
  bar_bg : Int64
  ink_primary : Int64
  ink_muted : Int64
  hairline : Int64
  surface_bg : Int64
  accent : Int64
  pill_active_bg : Int64
  pill_active_ink : Int64
}

fn rb_paper_palette(raw_theme : String) -> ReaderPaperPalette {
  let th = proto::normalize_reader_paper_theme(raw_theme)
  if th == "sepia" {
    ReaderPaperPalette::{
      page_bg: 0xF8F2E4FFL,
      bar_bg: 0xEFE6D4FFL,
      ink_primary: 0x2F2217FFL,
      ink_muted: 0x5C4835FFL,
      hairline: 0xDCCEB6FFL,
      surface_bg: 0xEAE0CAFFL,
      accent: 0x8C4315FFL,
      pill_active_bg: 0xFDF9F0FFL,
      pill_active_ink: 0x2F2217FFL,
    }
  } else if th == "night" {
    ReaderPaperPalette::{
      page_bg: 0x16181EFFL,
      bar_bg: 0x1D2029FFL,
      ink_primary: 0xE6EAF2FFL,
      ink_muted: 0xA8B5C8FFL,
      hairline: 0x2B3040FFL,
      surface_bg: 0x232734FFL,
      accent: 0x60A5FAFFL,
      pill_active_bg: 0x2E3548FFL,
      pill_active_ink: 0xF8FAFCFFL,
    }
  } else {
    ReaderPaperPalette::{
      page_bg: 0xFCFBF9FFL,
      bar_bg: 0xF3F4F6FFL,
      ink_primary: 0x1C1917FFL,
      ink_muted: 0x525866FFL,
      hairline: 0xE2E5ECFFL,
      surface_bg: 0xECEEF2FFL,
      accent: 0x0055CCFFL,
      pill_active_bg: 0xFFFFFFFFL,
      pill_active_ink: 0x1C1917FFL,
    }
  }
}

fn rb_pane_badge_label(pane : PaneId) -> String {
  match pane {
    PaneId::Primary => "Primary"
    PaneId::Secondary => "Secondary"
  }
}

fn rb_make_run(
  s : String,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
) -> text::Run {
  let is_mono = force_mono || font == "mono"
  let is_serif = !is_mono && font == "serif"
  text::Run::{ ..text::plain(s), color, weight, italic, mono: is_mono, serif: is_serif }
}

fn rb_rich_block(
  in_v : view::View,
  s : String,
  sz : Double,
  color : Int64,
  font : String,
  weight~ : Int = 400,
  italic~ : Bool = false,
  force_mono~ : Bool = false,
  lh~ : Double = 1.65,
) -> Unit {
  let _ = in_v.box(fn(tv : view::View) -> Unit {
    let _ = tv.words_runs(
      view::Live::Is([rb_make_run(s, color, font, weight=weight, italic=italic, force_mono=force_mono)]),
      ink=color,
      look=view::WordsLook::{ ..view::words_plain, size: sz, line: sz * lh, wrap: true },
    )
  })
}

fn rb_boost_accent(dark : Bool, custom : Int64) -> Int64 {
  if custom != 0L {
    custom
  } else if dark {
    0x60A5FAFFL
  } else {
    0x0055CCFFL
  }
}

///| Builds the solid Reader Mode typography surface bound to `props.owner_pane`.
pub fn build_reader_mode_panel(parent : view::View, props : ReaderModeProps) -> Unit {
  let pal = fn() -> ReaderPaperPalette { rb_paper_palette((props.theme)()) }
  let reader_metrics = fn() -> proto::ReaderMetrics {
    let _ = (props.rev)()
    let art = (props.article)()
    let m = proto::compute_reader_metrics(art.blocks, title=art.title)
    if m.word_count > 0 {
      m
    } else {
      proto::ReaderMetrics::{
        word_count: art.word_count,
        cjk_chars: 0,
        latin_words: art.word_count,
        read_minutes: if art.read_minutes > 0 { art.read_minutes } else { 1 },
      }
    }
  }

  parent.show(props.open, fn(shell : view::View) -> Unit {
    let _ = shell
    .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
    .min_width(view::Live::Is(Some(0.0)))
    .min_height(view::Live::Is(Some(0.0)))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { pal().page_bg }))

    // 1. Top Solid Typography Control Bar (wraps cleanly on narrow viewports)
    let _ = shell.box(fn(bar : view::View) -> Unit {
      let _ = bar
      .row(view::Live::Is(true))
      .wraps(view::Live::Is(Some(6.0)))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .rigid()
      .padding(view::Live::Is((12.0, 6.0, 12.0, 6.0)))
      .gap(view::Live::Is(8.0))
      .ground(view::Live::By(fn() { pal().bar_bg }))

      // Left: Reader icon + pane badge + read time & word count badges
      let _ = bar.box(fn(left : view::View) -> Unit {
        let _ = left
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .min_width(view::Live::Is(Some(140.0)))
        .gap(view::Live::Is(6.0))
        .clips(view::Live::Is(true))

        let _ = left.box(fn(tag : view::View) -> Unit {
          let _ = tag
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(24.0)))
          .rigid()
          .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
          .gap(view::Live::Is(5.0))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() { pal().surface_bg }))
          .edge(view::Live::By(fn() { (1.0, pal().hairline) }))
          let _ = shell_icon(tag, ICON_READER, size=12.0, color_by=fn() { pal().accent })
          <ui::Text in={tag} size={11.0} weight={600} color_by=>{pal().accent} text={"Reader (" + rb_pane_badge_label(props.owner_pane) + ")"} />
        })

        let _ = left.box(fn(min_pill : view::View) -> Unit {
          let _ = min_pill
          .height(view::Live::Is(Some(24.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() { pal().surface_bg }))
          <ui::Text
            in={min_pill}
            size={11.0}
            weight={500}
            color_by=>{pal().ink_muted}
            text_by=>{proto::format_read_minutes_badge(reader_metrics().read_minutes)}
          />
        })

        left.show(fn() { reader_metrics().word_count > 0 }, fn(wc_pill : view::View) -> Unit {
          let _ = wc_pill
          .height(view::Live::Is(Some(24.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() { pal().surface_bg }))
          <ui::Text
            in={wc_pill}
            size={11.0}
            weight={500}
            color_by=>{pal().ink_muted}
            text_by=>{proto::format_word_count_badge(reader_metrics().word_count)}
          />
        })
      })

      // Paper Theme selector: Light / Sepia / Night
      let _ = bar.box(fn(tseg : view::View) -> Unit {
        let _ = tseg
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .rigid()
        .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
        .gap(view::Live::Is(2.0))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::By(fn() { pal().surface_bg }))
        .edge(view::Live::By(fn() { (1.0, pal().hairline) }))

        let theme_btn = fn(id : String, label : String, dot_color : Int64) -> Unit {
          let is_on = fn() -> Bool { proto::normalize_reader_paper_theme((props.theme)()) == id }
          let _ = headless::button(
            tseg,
            fn() { "Reader Paper Theme " + label },
            fn(_v : view::View) -> Unit { (props.on_theme)(id) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .min_height(view::Live::Is(Some(36.0)))
              .rigid()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .gap(view::Live::Is(5.0))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_on() {
                  pal().pill_active_bg
                } else if btn.hovered() || btn.pressed() {
                  pal().hairline
                } else {
                  0x00000000L
                }
              }))
              let _ = b.box(fn(dot : view::View) -> Unit {
                let _ = dot
                .width(view::Live::Is(Some(8.0)))
                .height(view::Live::Is(Some(8.0)))
                .rigid()
                .radius(view::Live::Is(4.0))
                .ground(view::Live::Is(dot_color))
                .edge(view::Live::Is((1.0, 0x94A3B888L)))
              })
              <ui::Text
                in={b}
                size={11.5}
                weight={500}
                color_by=>{if is_on() { pal().pill_active_ink } else { pal().ink_muted }}
                text={label}
              />
            },
          )
        }
        theme_btn("light", "Light", 0xFFFFFFFFL)
        theme_btn("sepia", "Sepia", 0xF8F2E4FFL)
        theme_btn("night", "Night", 0x16181EFFL)
      })

      // Font size stepper: A- / 14..24 / A+
      let _ = bar.box(fn(sseg : view::View) -> Unit {
        let _ = sseg
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .rigid()
        .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
        .gap(view::Live::Is(2.0))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::By(fn() { pal().surface_bg }))
        .edge(view::Live::By(fn() { (1.0, pal().hairline) }))

        let step_btn = fn(label : String, aria : String, delta : Int) -> Unit {
          let _ = headless::button(
            sseg,
            fn() { aria },
            fn(_v : view::View) -> Unit {
              let cur = signals::untracked(props.font_size)
              let next = proto::step_reader_font_size(cur, delta)
              (props.on_font_size)(next)
            },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .min_width(view::Live::Is(Some(36.0)))
              .min_height(view::Live::Is(Some(36.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if btn.hovered() || btn.pressed() { pal().pill_active_bg } else { 0x00000000L }
              }))
              <ui::Text in={b} size={11.5} weight={600} color_by=>{pal().ink_primary} text={label} />
            },
          )
        }
        step_btn("A-", "Decrease Reader Font Size", 0 - proto::READER_FONT_SIZE_STEP)
        let _ = sseg.box(fn(sz : view::View) -> Unit {
          let _ = sz.width(view::Live::Is(Some(38.0))).rigid().center()
          <ui::Text
            in={sz}
            size={11.5}
            weight={500}
            color_by=>{pal().ink_muted}
            text_by=>{proto::clamp_reader_font_size((props.font_size)()).to_string() + "pt"}
          />
        })
        step_btn("A+", "Increase Reader Font Size", proto::READER_FONT_SIZE_STEP)
      })

      // Typeface selector: Sans / Serif / Mono
      let _ = bar.box(fn(fseg : view::View) -> Unit {
        let _ = fseg
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .rigid()
        .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
        .gap(view::Live::Is(2.0))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::By(fn() { pal().surface_bg }))
        .edge(view::Live::By(fn() { (1.0, pal().hairline) }))

        let font_btn = fn(id : String, label : String) -> Unit {
          let is_on = fn() -> Bool { proto::normalize_reader_font((props.font)()) == id }
          let _ = headless::button(
            fseg,
            fn() { "Reader Font " + label },
            fn(_v : view::View) -> Unit { (props.on_font)(id) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .min_height(view::Live::Is(Some(36.0)))
              .min_width(view::Live::Is(Some(36.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_on() {
                  pal().pill_active_bg
                } else if btn.hovered() || btn.pressed() {
                  pal().hairline
                } else {
                  0x00000000L
                }
              }))
              <ui::Text
                in={b}
                size={11.5}
                weight={500}
                color_by=>{if is_on() { pal().pill_active_ink } else { pal().ink_muted }}
                text={label}
              />
            },
          )
        }
        font_btn("sans", "Sans")
        font_btn("serif", "Serif")
        font_btn("mono", "Mono")
      })

      // Column width selector: Narrow / Medium / Wide
      let _ = bar.box(fn(wseg : view::View) -> Unit {
        let _ = wseg
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .rigid()
        .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
        .gap(view::Live::Is(2.0))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::By(fn() { pal().surface_bg }))
        .edge(view::Live::By(fn() { (1.0, pal().hairline) }))

        let width_btn = fn(id : String, label : String) -> Unit {
          let is_on = fn() -> Bool { proto::normalize_reader_width((props.width_mode)()) == id }
          let _ = headless::button(
            wseg,
            fn() { "Column Width " + label },
            fn(_v : view::View) -> Unit { (props.on_width_mode)(id) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let _ = b
              .min_height(view::Live::Is(Some(36.0)))
              .min_width(view::Live::Is(Some(36.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(6.0))
              .ground(view::Live::By(fn() -> Int64 {
                if is_on() {
                  pal().pill_active_bg
                } else if btn.hovered() || btn.pressed() {
                  pal().hairline
                } else {
                  0x00000000L
                }
              }))
              <ui::Text
                in={b}
                size={11.5}
                weight={500}
                color_by=>{if is_on() { pal().pill_active_ink } else { pal().ink_muted }}
                text={label}
              />
            },
          )
        }
        width_btn("narrow", "Narrow")
        width_btn("medium", "Medium")
        width_btn("wide", "Wide")
      })

      // Close / Exit Reader button (vector icon + label)
      let _ = headless::button(
        bar,
        fn() { "Exit Reader Mode" },
        fn(_v : view::View) -> Unit { (props.on_close)() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .min_height(view::Live::Is(Some(36.0)))
          .min_width(view::Live::Is(Some(36.0)))
          .rigid()
          .center()
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .gap(view::Live::Is(5.0))
          .radius(view::Live::Is(6.0))
          .ground(view::Live::By(fn() -> Int64 {
            if btn.pressed() {
              pal().hairline
            } else if btn.hovered() {
              pal().pill_active_bg
            } else {
              pal().surface_bg
            }
          }))
          .edge(view::Live::By(fn() { (1.0, pal().hairline) }))
          let _ = shell_icon(b, ICON_CLOSE, size=13.0, color_by=fn() { pal().ink_primary })
          <ui::Text in={b} size={11.5} weight={500} color_by=>{pal().ink_primary} text="Exit" />
        },
      )
    })

    // 2. Slim 2pt reading progress bar
    let _ = shell.box(fn(prog_track : view::View) -> Unit {
      let _ = prog_track
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(2.0)))
      .rigid()
      .ground(view::Live::By(fn() { pal().hairline }))
      let _ = prog_track.box(fn(prog_fill : view::View) -> Unit {
        let _ = prog_fill
        .height(view::Live::Is(Some(2.0)))
        .rigid()
        .width(view::Live::By(fn() -> Option[Double] {
          let (_, _, tw, _) = prog_track.placed_now()
          let base_w = if tw > 10.0 { tw } else { 960.0 }
          let p = proto::clamp_reader_progress((props.progress)())
          Some(base_w * p)
        }))
        .ground(view::Live::By(fn() { pal().accent }))
      })
    })

    // 3. Scrollable centered solid paper column
    let _ = shell.box(fn(scroll_host : view::View) -> Unit {
      let _ = scroll_host
      .fill()
      .clips(view::Live::Is(true))
      .on_wheel(fn(wh : view::Wheel) -> Unit {
        let cur = signals::untracked(props.progress)
        let delta = (0.0 - wh.dy) / 1400.0
        (props.on_progress)(proto::clamp_reader_progress(cur + delta))
      })

      let _ = ui::scroll_box(scroll_host, fn(sc : view::View) -> Unit {
        let _ = sc
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((24.0, 28.0, 24.0, 56.0)))

        let _ = sc.box(fn(col : view::View) -> Unit {
          let col_w = fn() -> Option[Double] {
            let _ = scroll_host.laid_size_told()
            let target = proto::reader_column_width_pt((props.width_mode)())
            let (_, _, sw, _) = scroll_host.placed_now()
            let eff_sw = if sw > 64.0 { sw } else { parent.window_w() }
            if eff_sw > 64.0 && target > eff_sw - 48.0 {
              Some(eff_sw - 48.0)
            } else {
              Some(target)
            }
          }
          let _ = col
          .width(view::Live::By(col_w))
          .max_width(view::Live::By(col_w))
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(0.0)))
          .gap(view::Live::Is(14.0))

          col.switch_by(
            fn() -> Int {
              let rev = (props.rev)()
              let st = (props.status)()
              let th = proto::normalize_reader_paper_theme((props.theme)())
              let fnm = proto::normalize_reader_font((props.font)())
              let fsz = proto::clamp_reader_font_size((props.font_size)())
              let wm = proto::normalize_reader_width((props.width_mode)())
              let th_i = if th == "sepia" { 1 } else if th == "night" { 2 } else { 0 }
              let fn_i = if fnm == "serif" { 1 } else if fnm == "mono" { 2 } else { 0 }
              let wm_i = if wm == "narrow" { 0 } else if wm == "wide" { 2 } else { 1 }
              rev * 200000 + st * 10000 + fsz * 64 + wm_i * 16 + th_i * 4 + fn_i
            },
            fn(doc_box : view::View, _key : Int) -> Unit {
              let art = signals::untracked(props.article)
              let font = proto::normalize_reader_font(signals::untracked(props.font))
              let body_size = proto::clamp_reader_font_size(signals::untracked(props.font_size)).to_double()
              let scale = body_size / 17.0
              let p = rb_paper_palette(signals::untracked(props.theme))
              let metrics = reader_metrics()
              let _ = doc_box.gap(view::Live::Is(14.0))

              // Eyebrow: host + read-time + word-count
              let _ = doc_box.box(fn(eyebrow : view::View) -> Unit {
                let _ = eyebrow
                .row(view::Live::Is(true))
                .wraps(view::Live::Is(Some(6.0)))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .gap(view::Live::Is(8.0))
                if art.host != "" {
                  <ui::Text in={eyebrow} size={12.5} weight={600} color_by=>{p.accent} text={art.host} />
                }
                let _ = eyebrow.box(fn(rm : view::View) -> Unit {
                  let _ = rm.padding(view::Live::Is((7.0, 2.0, 7.0, 2.0))).radius(view::Live::Is(5.0)).ground(view::Live::Is(p.surface_bg))
                  <ui::Text in={rm} size={11.0} weight={500} color_by=>{p.ink_muted} text={proto::format_read_minutes_badge(metrics.read_minutes)} />
                })
                if metrics.word_count > 0 {
                  let _ = eyebrow.box(fn(wc : view::View) -> Unit {
                    let _ = wc.padding(view::Live::Is((7.0, 2.0, 7.0, 2.0))).radius(view::Live::Is(5.0)).ground(view::Live::Is(p.surface_bg))
                    <ui::Text in={wc} size={11.0} weight={500} color_by=>{p.ink_muted} text={proto::format_word_count_badge(metrics.word_count)} />
                  })
                }
              })

              // Article title
              let title_text = if art.title != "" { art.title } else { "Extracting article..." }
              rb_rich_block(doc_box, title_text, 28.0 * scale, p.ink_primary, font, weight=700, lh=1.25)

              // Optional byline
              if art.byline != "" {
                rb_rich_block(doc_box, art.byline, 13.5 * scale, p.ink_muted, font, lh=1.45)
              }

              // Single hairline separator
              let _ = doc_box.box(fn(hsep : view::View) -> Unit {
                let _ = hsep.height(view::Live::Is(Some(1.0))).rigid().ground(view::Live::Is(p.hairline))
              })

              if art.blocks.length() == 0 {
                let st = signals::untracked(props.status)
                let empty_msg = if st == READER_STATUS_LOADING {
                  "Extracting readable article..."
                } else if st == READER_STATUS_INCOMPATIBLE {
                  "Reader mode requires a compatible host response."
                } else {
                  "No article body detected on this page."
                }
                let _ = doc_box.box(fn(emp : view::View) -> Unit {
                  let _ = emp.padding(view::Live::Is((0.0, 12.0, 0.0, 12.0)))
                  rb_rich_block(emp, empty_msg, 15.0 * scale, p.ink_muted, font, lh=1.5)
                })
              }

              let mut i = 0
              while i < art.blocks.length() {
                let blk = art.blocks[i]
                match blk.kind {
                  proto::ReaderBlockKind::Heading => {
                    let h_size = if blk.level <= 2 { 21.0 * scale } else { 18.0 * scale }
                    let _ = doc_box.box(fn(hb : view::View) -> Unit {
                      let _ = hb.padding(view::Live::Is((0.0, 8.0, 0.0, 0.0)))
                      rb_rich_block(hb, blk.text, h_size, p.ink_primary, font, weight=600, lh=1.35)
                    })
                  }
                  proto::ReaderBlockKind::Quote => {
                    let _ = doc_box.box(fn(qb : view::View) -> Unit {
                      let _ = qb
                      .row(view::Live::Is(true))
                      .padding(view::Live::Is((14.0, 12.0, 16.0, 12.0)))
                      .gap(view::Live::Is(12.0))
                      .radius(view::Live::Is(8.0))
                      .ground(view::Live::Is(p.surface_bg))
                      let _ = qb.box(fn(vbar : view::View) -> Unit {
                        let _ = vbar.width(view::Live::Is(Some(3.0))).rigid().radius(view::Live::Is(1.5)).ground(view::Live::Is(p.accent))
                      })
                      let _ = qb.box(fn(qt : view::View) -> Unit {
                        let _ = qt.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                        rb_rich_block(qt, blk.text, body_size, p.ink_primary, font, italic=true, lh=1.6)
                      })
                    })
                  }
                  proto::ReaderBlockKind::Code => {
                    let _ = doc_box.box(fn(cb : view::View) -> Unit {
                      let _ = cb
                      .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
                      .radius(view::Live::Is(8.0))
                      .ground(view::Live::Is(p.surface_bg))
                      .edge(view::Live::Is((1.0, p.hairline)))
                      rb_rich_block(cb, blk.text, 13.0 * scale, p.ink_primary, font, force_mono=true, lh=1.5)
                    })
                  }
                  proto::ReaderBlockKind::ListItem => {
                    let _ = doc_box.box(fn(li : view::View) -> Unit {
                      let _ = li
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Start)))
                      .padding(view::Live::Is((6.0, 0.0, 0.0, 0.0)))
                      .gap(view::Live::Is(10.0))
                      let _ = li.box(fn(bwrap : view::View) -> Unit {
                        let _ = bwrap.width(view::Live::Is(Some(10.0))).height(view::Live::Is(Some(body_size * 1.4))).rigid().center()
                        let _ = bwrap.box(fn(dot : view::View) -> Unit {
                          let _ = dot.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0))).rigid().radius(view::Live::Is(2.5)).ground(view::Live::Is(p.accent))
                        })
                      })
                      let _ = li.box(fn(lt : view::View) -> Unit {
                        let _ = lt.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                        rb_rich_block(lt, blk.text, body_size, p.ink_primary, font, lh=1.65)
                      })
                    })
                  }
                  proto::ReaderBlockKind::Paragraph => {
                    rb_rich_block(doc_box, blk.text, body_size, p.ink_primary, font, lh=1.65)
                  }
                }
                i += 1
              }
            },
          )
        })
      })
    })
  })
}

///| Builds the Site Boosts floating sheet bound to `props.target_origin` and `props.owner_pane`.
///| Outer frame uses single-layer Liquid Glass; inner controls use solid `lg::surface()`.
pub fn build_site_boosts_panel(root : view::View, props : SiteBoostsProps) -> Unit {
  let active_accent = fn() -> Int64 { rb_boost_accent((props.dark)(), (props.accent_color)()) }
  let bound_origin = fn() -> String { (props.target_origin)().trim() }
  let has_origin = fn() -> Bool { bound_origin() != "" }
  let live_win_w = fn() -> Double {
    let _ = root.laid_size_told()
    let ww = root.window_w()
    if ww > 100.0 {
      ww
    } else {
      let (_, _, rw, _) = root.placed_now()
      if rw > 100.0 { rw } else { 1280.0 }
    }
  }
  let safe_save = fn(next_b : proto::SiteBoost) -> Unit {
    let origin = signals::untracked(bound_origin)
    if origin == "" {
      return
    }
    (props.on_save)(origin, proto::SiteBoost::{ ..next_b, host: origin })
  }

  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    let _ = headless::dialog(
      layer,
      fn() { "Site Boosts" },
      props.open,
      props.on_close,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box
        .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
          let _ = root.laid_size_told()
          let _ = root.window_w()
          let _ = root.window_h()
          let top = (props.anchor_top)()
          let eff_top = if top > 48.0 { top } else { 52.0 }
          (None, Some(eff_top), Some(14.0), None)
        }))

        let _ = lg::liquid_dialog_shell_node(
          dlg_box,
          fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() -> Option[Double] {
              let rw = live_win_w()
              if rw < 380.0 {
                let w = rw - 28.0
                Some(if w > 280.0 { w } else { 280.0 })
              } else {
                Some(352.0)
              }
            }))
            .padding(view::Live::Is((6.0, 6.0, 6.0, 6.0)))
            .presses(view::Live::Is(true))
            .on_press(fn() -> Unit { () })

            // Inner solid content surface (concentric r = 26 - 6 = 20pt)
            let _ = shell.box(fn(card : view::View) -> Unit {
              let _ = card
              .clips(view::Live::Is(true))
              .radius(view::Live::Is(lg::concentric(26.0, 6.0)))
              .ground(view::Live::By(fn() { lg::surface().card }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

              // 1. Header: Sparkles icon + Site Boosts + bound origin & pane + Active toggle + Close
              let _ = card.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((12.0, 10.0, 10.0, 10.0)))
                .gap(view::Live::Is(8.0))

                let _ = hdr.box(fn(ico : view::View) -> Unit {
                  let _ = ico
                  .width(view::Live::Is(Some(28.0)))
                  .height(view::Live::Is(Some(28.0)))
                  .rigid()
                  .center()
                  .radius(view::Live::Is(6.0))
                  .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                  let _ = shell_icon(ico, ICON_SPARKLES, size=15.0, color_by=active_accent)
                })

                let _ = hdr.box(fn(tcol : view::View) -> Unit {
                  let _ = tcol
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .cut()
                  .gap(view::Live::Is(1.0))
                  <ui::Text in={tcol} size={13.5} weight={600} color_by=>{lg::surface().ink} text="Site Boosts" />
                  let sub = <ui::Text
                    in={tcol}
                    size={11.0}
                    color_by=>{lg::surface().ink_secondary}
                    text_by=>{
                      let orig = bound_origin()
                      if orig != "" {
                        orig + " (" + rb_pane_badge_label((props.owner_pane)()) + ")"
                      } else {
                        "Unavailable on this page (" + rb_pane_badge_label((props.owner_pane)()) + ")"
                      }
                    }
                  />
                  let _ = sub.cut().allow_ellipsis(view::Live::Is(true))
                })

                // Active master toggle button
                let _ = headless::button(
                  hdr,
                  fn() { "Toggle Boost Active" },
                  fn(_v : view::View) -> Unit {
                    let b = signals::untracked(props.boost)
                    let next_on = !b.enabled
                    let next_theme = if next_on && b.theme == "auto" && b.font == "default" && b.scale_pct == 100 && !b.hide_sticky && b.custom_css == "" {
                      "dark"
                    } else {
                      b.theme
                    }
                    safe_save(proto::SiteBoost::{ ..b, enabled: next_on, theme: next_theme })
                  },
                  fn(sw : view::View, btn : headless::Button) -> Unit {
                    let is_on = fn() -> Bool { has_origin() && (props.boost)().enabled }
                    let _ = sw
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .min_height(view::Live::Is(Some(36.0)))
                    .rigid()
                    .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                    .gap(view::Live::Is(5.0))
                    .radius(view::Live::Is(10.0))
                    .ground(view::Live::By(fn() -> Int64 {
                      if is_on() {
                        active_accent()
                      } else if btn.hovered() || btn.pressed() {
                        lg::surface().row_hover
                      } else {
                        lg::surface().card_secondary
                      }
                    }))
                    <ui::Text
                      in={sw}
                      size={11.5}
                      weight={600}
                      color_by=>{if is_on() { 0xFFFFFFFFL } else { lg::surface().ink }}
                      text_by=>{if is_on() { "Active" } else { "Off" }}
                    />
                  },
                )

                // Close button (vector icon + accessible label)
                let _ = lg::liquid_button_node(
                  hdr,
                  fn() { "Close Site Boosts" },
                  props.on_close,
                  content=fn(inner : view::View) -> Unit {
                    let _ = shell_icon(inner, ICON_CLOSE, size=14.0, color_by=fn() { lg::surface().ink })
                  },
                  flat=true,
                  ghost=true,
                  height=30.0,
                  pad_x=9.0,
                )
              })

              let _ = card.box(fn(hsep : view::View) -> Unit {
                let _ = hsep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
              })

              // 2. Body controls (concentric inset 12pt inside r=20pt card -> inner r <= 8pt)
              let _ = card.box(fn(body : view::View) -> Unit {
                let _ = body.padding(view::Live::Is((12.0, 12.0, 12.0, 12.0))).gap(view::Live::Is(12.0))

                // Section A: Theme Swatches (Auto / Dark / Sepia / Contrast)
                let _ = body.box(fn(sec : view::View) -> Unit {
                  let _ = sec.gap(view::Live::Is(6.0))
                  <ui::Text in={sec} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="THEME" />
                  let _ = sec.box(fn(row : view::View) -> Unit {
                    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(6.0))
                    let swatch_btn = fn(id : String, label : String, fill : Int64, dot : Int64) -> Unit {
                      let is_sel = fn() -> Bool { has_origin() && proto::normalize_boost_theme((props.boost)().theme) == id }
                      let _ = headless::button(
                        row,
                        fn() { "Boost Theme " + label },
                        fn(_v : view::View) -> Unit {
                          let b = signals::untracked(props.boost)
                          safe_save(proto::SiteBoost::{ ..b, enabled: true, theme: id })
                        },
                        fn(sb : view::View, sbtn : headless::Button) -> Unit {
                          let _ = sb
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_height(view::Live::Is(Some(48.0)))
                          .center()
                          .gap(view::Live::Is(4.0))
                          .radius(view::Live::Is(lg::r_chip))
                          .ground(view::Live::By(fn() -> Int64 {
                            if is_sel() {
                              lg::surface().accent_tint
                            } else if sbtn.hovered() || sbtn.pressed() {
                              lg::surface().row_hover
                            } else {
                              lg::surface().card_secondary
                            }
                          }))
                          .edge(view::Live::By(fn() -> (Double, Int64) {
                            if is_sel() { (1.5, active_accent()) } else { (lg::hairline_w, lg::surface().separator_strong) }
                          }))
                          let _ = sb.box(fn(chip : view::View) -> Unit {
                            let _ = chip
                            .width(view::Live::Is(Some(18.0)))
                            .height(view::Live::Is(Some(18.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(9.0))
                            .ground(view::Live::Is(fill))
                            .edge(view::Live::Is((1.0, 0x94A3B888L)))
                            let _ = chip.box(fn(inner : view::View) -> Unit {
                              let _ = inner.width(view::Live::Is(Some(6.0))).height(view::Live::Is(Some(6.0))).rigid().radius(view::Live::Is(3.0)).ground(view::Live::Is(dot))
                            })
                          })
                          <ui::Text
                            in={sb}
                            size={11.0}
                            weight={500}
                            color_by=>{if is_sel() { active_accent() } else { lg::surface().ink }}
                            text={label}
                          />
                        },
                      )
                    }
                    swatch_btn("auto", "Auto", 0xFFFFFFFFL, 0x94A3B8FFL)
                    swatch_btn("dark", "Dark", 0x14161DFFL, 0x60A5FAFFL)
                    swatch_btn("sepia", "Sepia", 0xF5ECDCFFL, 0x9A501FFFL)
                    swatch_btn("contrast", "Contrast", 0x000000FFL, 0xFFE600FFL)
                  })
                })

                // Section B: Font Family Pills (Default / Sans / Serif / Mono)
                let _ = body.box(fn(sec : view::View) -> Unit {
                  let _ = sec.gap(view::Live::Is(6.0))
                  <ui::Text in={sec} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="TYPOGRAPHY" />
                  let _ = sec.box(fn(seg : view::View) -> Unit {
                    let _ = seg
                    .row(view::Live::Is(true))
                    .padding(view::Live::Is((3.0, 3.0, 3.0, 3.0)))
                    .gap(view::Live::Is(3.0))
                    .radius(view::Live::Is(10.0))
                    .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

                    let font_pill = fn(id : String, label : String) -> Unit {
                      let is_sel = fn() -> Bool { has_origin() && proto::normalize_boost_font((props.boost)().font) == id }
                      let _ = headless::button(
                        seg,
                        fn() { "Boost Font " + label },
                        fn(_v : view::View) -> Unit {
                          let b = signals::untracked(props.boost)
                          safe_save(proto::SiteBoost::{ ..b, enabled: true, font: id })
                        },
                        fn(fb : view::View, fbtn : headless::Button) -> Unit {
                          let _ = fb
                          .grow(view::Live::Is(1.0))
                          .shrink(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_height(view::Live::Is(Some(36.0)))
                          .center()
                          .radius(view::Live::Is(7.0))
                          .ground(view::Live::By(fn() -> Int64 {
                            if is_sel() {
                              lg::surface().card
                            } else if fbtn.hovered() || fbtn.pressed() {
                              lg::surface().row_hover
                            } else {
                              0x00000000L
                            }
                          }))
                          .edge(view::Live::By(fn() -> (Double, Int64) {
                            if is_sel() { (lg::hairline_w, lg::surface().separator_strong) } else { (0.0, 0x00000000L) }
                          }))
                          <ui::Text
                            in={fb}
                            size={11.5}
                            weight={500}
                            color_by=>{if is_sel() { active_accent() } else { lg::surface().ink }}
                            text={label}
                          />
                        },
                      )
                    }
                    font_pill("default", "Default")
                    font_pill("sans", "Sans")
                    font_pill("serif", "Serif")
                    font_pill("mono", "Mono")
                  })
                })

                // Section C: Text Size Stepper (90%..130%) & Hide Sticky Overlays Switch
                let _ = lg::surface_card_node(
                  body,
                  fn(opts : view::View) -> Unit {
                    let _ = opts.box(fn(srow : view::View) -> Unit {
                      let _ = srow
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .gap(view::Live::Is(8.0))
                      let _ = srow.box(fn(sl : view::View) -> Unit {
                        let _ = sl.grow(view::Live::Is(1.0))
                        <ui::Text in={sl} size={12.0} weight={500} color_by=>{lg::surface().ink} text="Text Size" />
                      })
                      let step_size = fn(icon_name : String, aria : String, delta : Int) -> Unit {
                        let _ = headless::button(
                          srow,
                          fn() { aria },
                          fn(_v : view::View) -> Unit {
                            let b = signals::untracked(props.boost)
                            let next_pct = proto::clamp_boost_scale_pct(b.scale_pct + delta)
                            safe_save(proto::SiteBoost::{ ..b, enabled: true, scale_pct: next_pct })
                          },
                          fn(sb : view::View, sbtn : headless::Button) -> Unit {
                            let _ = sb
                            .width(view::Live::Is(Some(36.0)))
                            .height(view::Live::Is(Some(36.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(lg::r_chip))
                            .ground(view::Live::By(fn() -> Int64 {
                              if sbtn.pressed() { lg::surface().row_selected } else if sbtn.hovered() { lg::surface().row_hover } else { lg::surface().card }
                            }))
                            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
                            let _ = shell_icon(sb, icon_name, size=13.0, color_by=fn() { lg::surface().ink })
                          },
                        )
                      }
                      step_size("minus", "Decrease Boost Text Size", -5)
                      let _ = srow.box(fn(pv : view::View) -> Unit {
                        let _ = pv.width(view::Live::Is(Some(42.0))).rigid().center()
                        <ui::Text
                          in={pv}
                          size={11.5}
                          weight={600}
                          color_by=>{lg::surface().ink}
                          text_by=>{(props.boost)().scale_pct.to_string() + "%"}
                        />
                      })
                      step_size("plus", "Increase Boost Text Size", 5)
                    })

                    let _ = opts.box(fn(msep : view::View) -> Unit {
                      let _ = msep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
                    })

                    let _ = opts.box(fn(hrow : view::View) -> Unit {
                      let _ = hrow
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .gap(view::Live::Is(8.0))
                      let _ = hrow.box(fn(hl : view::View) -> Unit {
                        let _ = hl.grow(view::Live::Is(1.0))
                        <ui::Text in={hl} size={12.0} weight={500} color_by=>{lg::surface().ink} text="Hide sticky overlays" />
                      })
                      let _ = lg::liquid_toggle_node(
                        hrow,
                        fn() { has_origin() && (props.boost)().hide_sticky },
                        fn(next_hide : Bool) -> Unit {
                          let b = signals::untracked(props.boost)
                          safe_save(proto::SiteBoost::{ ..b, enabled: true, hide_sticky: next_hide })
                        },
                        fn() { "Toggle Hide Sticky Overlays" },
                      )
                    })
                  },
                  radius=lg::r_card,
                  pad=6.0,
                  gap=8.0,
                  secondary=true,
                  label=fn() { "Boost Page Controls" },
                )

                // Section D: Custom CSS Draft Input (reusing passed-in `ui::Field`)
                let _ = body.box(fn(sec : view::View) -> Unit {
                  let _ = sec.gap(view::Live::Is(6.0))
                  <ui::Text in={sec} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="CUSTOM CSS" />
                  let _ = sec.box(fn(crow : view::View) -> Unit {
                    let _ = crow
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(6.0))
                    let _ = crow.box(fn(fw : view::View) -> Unit {
                      let _ = fw
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .height(view::Live::Is(Some(36.0)))
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .radius(view::Live::Is(lg::r_chip))
                      .clips(view::Live::Is(true))
                      .ground(view::Live::By(fn() { lg::surface().card }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        if props.css_field.focused() { (1.5, active_accent()) } else { (1.0, lg::surface().separator_strong) }
                      }))
                      let _ = fw.box(fn(inp : view::View) -> Unit {
                        let _ = inp.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
                        inp.reacts(fn() { (props.dark)() }, fn(_d : Bool) -> Unit {
                          props.css_field.color = lg::surface().ink
                          props.css_field.ph_color = lg::surface().ink_secondary
                          props.css_field.caret_color = active_accent()
                        })
                        let typed = ui::field(
                          inp,
                          props.css_field,
                          placeholder="e.g. article p { line-height: 1.8; }",
                          font_size=12.0,
                          max_lines=1,
                          enter_sends=true,
                          label="Custom CSS",
                          color=lg::surface().ink,
                          placeholder_color=lg::surface().ink_secondary,
                          caret_color=active_accent(),
                          edited=fn(raw : String) -> Unit {
                            match props.on_css_edited {
                              Some(cb) => cb(raw)
                              None => ()
                            }
                          },
                          submitted=fn(raw : String) -> Unit {
                            let b = signals::untracked(props.boost)
                            let origin = signals::untracked(bound_origin)
                            if origin == "" {
                              return
                            }
                            let next_b = proto::SiteBoost::{ ..b, host: origin, enabled: true, custom_css: raw }
                            match props.on_apply_css {
                              Some(cb) => cb(origin, next_b)
                              None => (props.on_save)(origin, next_b)
                            }
                          },
                        )
                        let _ = typed
                        .min_height(view::Live::Is(Some(36.0)))
                        .drawn_off(view::Live::Is((0.0, 9.0)))
                        .ink(view::Live::By(fn() {
                          if props.css_field.text().length() > 0 || props.css_field.composing() { lg::surface().ink } else { lg::surface().ink_secondary }
                        }))
                      })
                    })
                    let _ = headless::button(
                      crow,
                      fn() { "Apply Custom CSS" },
                      fn(_v : view::View) -> Unit {
                        let b = signals::untracked(props.boost)
                        let origin = signals::untracked(bound_origin)
                        if origin == "" {
                          return
                        }
                        let raw = props.css_field.text()
                        let next_b = proto::SiteBoost::{ ..b, host: origin, enabled: true, custom_css: raw }
                        match props.on_apply_css {
                          Some(cb) => cb(origin, next_b)
                          None => (props.on_save)(origin, next_b)
                        }
                      },
                      fn(ab : view::View, abtn : headless::Button) -> Unit {
                        let _ = ab
                        .min_height(view::Live::Is(Some(36.0)))
                        .rigid()
                        .center()
                        .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                        .radius(view::Live::Is(lg::r_chip))
                        .ground(view::Live::By(fn() -> Int64 {
                          if abtn.pressed() { lg::surface().row_selected } else if abtn.hovered() { lg::surface().row_hover } else { lg::surface().card_secondary }
                        }))
                        .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
                        <ui::Text in={ab} size={12.0} weight={500} color_by=>{lg::surface().ink} text="Apply" />
                      },
                    )
                  })
                })

                // Footer: live status + Reset button
                let _ = body.box(fn(ftr : view::View) -> Unit {
                  let _ = ftr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(8.0))
                  let _ = ftr.box(fn(st : view::View) -> Unit {
                    let _ = st.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                    let st_txt = <ui::Text
                      in={st}
                      size={11.0}
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{
                        let orig = bound_origin()
                        if orig == "" {
                          "Boosts require an http/https site"
                        } else if (props.boost)().enabled {
                          "Live on " + orig
                        } else {
                          "Applies live without reload"
                        }
                      }
                    />
                    let _ = st_txt.cut().allow_ellipsis(view::Live::Is(true))
                  })
                  let _ = headless::button(
                    ftr,
                    fn() { "Reset Site Boost" },
                    fn(_v : view::View) -> Unit {
                      let origin = signals::untracked(bound_origin)
                      if origin == "" {
                        return
                      }
                      props.css_field.set("")
                      (props.on_reset)(origin)
                    },
                    fn(rb : view::View, rbtn : headless::Button) -> Unit {
                      let _ = rb
                      .min_height(view::Live::Is(Some(36.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
                      .radius(view::Live::Is(lg::r_chip))
                      .ground(view::Live::By(fn() -> Int64 {
                        if rbtn.pressed() || rbtn.hovered() { lg::surface().danger_bg } else { lg::surface().card_secondary }
                      }))
                      .edge(view::Live::By(fn() -> (Double, Int64) {
                        if rbtn.hovered() || rbtn.pressed() { (1.0, lg::surface().danger) } else { (lg::hairline_w, lg::surface().separator_strong) }
                      }))
                      <ui::Text
                        in={rb}
                        size={12.0}
                        weight={500}
                        color_by=>{
                          if rbtn.hovered() || rbtn.pressed() {
                            if (props.dark)() { 0xFFA8A3FFL } else { 0xB91C1CFFL }
                          } else {
                            lg::surface().ink
                          }
                        }
                        text="Reset"
                      />
                    },
                  )
                })
              })
            })
          },
          radius=26.0,
        )
      },
      modal=false,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if (how is headless::OverlayDismiss::Escape) && props.css_field.composing() {
          props.css_field.compose("")
          true
        } else {
          false
        }
      },
    )
  })
}
