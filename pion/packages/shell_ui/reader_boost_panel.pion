fn demo_reader_article() -> proto::ReaderArticle {
  let blk = fn(kind : proto::ReaderBlockKind, level : Int, t : String) -> proto::ReaderBlock {
    proto::ReaderBlock::{ kind, level, text: t }
  }
  // (the article of the demo shell's own page: notes.example.com, "Designing for Reading")
  proto::ReaderArticle::{
    url: "https://notes.example.com/designing-for-reading",
    host: "notes.example.com",
    title: "Designing for Reading",
    byline: "Mara Lind",
    read_minutes: 6,
    word_count: 1240,
    blocks: [
      blk(
        proto::ReaderBlockKind::Paragraph,
        0,
        "A page is easy to read when the eye never has to search: lines short enough to follow back, space between paragraphs that says where a thought ends, and nothing beside the text asking to be looked at.",
      ),
      blk(
        proto::ReaderBlockKind::Paragraph,
        0,
        "Most of the work happens before a single word is styled. Choose the measure first, sixty to seventy-five characters, then let the type size and the leading follow from it.",
      ),
      blk(proto::ReaderBlockKind::Heading, 2, "Start with the measure"),
      blk(
        proto::ReaderBlockKind::Paragraph,
        0,
        "A wide column tires the reader on the way back to the start of each line; a narrow one breaks phrases apart. The measure sets the rhythm every other choice on the page keeps.",
      ),
      blk(proto::ReaderBlockKind::Code, 0, "article {\n  max-width: 68ch;\n  line-height: 1.6;\n}"),
      blk(proto::ReaderBlockKind::Quote, 0, "Leading is the space a line needs to be found again."),
      blk(proto::ReaderBlockKind::ListItem, 0, "Set the body between 16 and 20 points on a screen read at arm's length."),
      blk(proto::ReaderBlockKind::ListItem, 0, "Give headings more space above than below, so they belong to what follows."),
    ],
  }
}

///| The page card's place in the demo shell (where a pane's overlays sit).
fn demo_card_rect(root : view::View) -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
  let _ = root.laid_size_told()
  let w = root.window_w()
  let side = shell_sidebar_width(w, true)
  if side > SP_0 {
    (Some(side + SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP))
  } else {
    (Some(SHELL_FRAME_GAP), Some(SHELL_TOP_ROW_H), Some(SHELL_FRAME_GAP), Some(SHELL_FRAME_GAP))
  }
}

///| Reader Mode over the demo shell's page card, with a sample MDN article.
pub fn build_demo_reader_mode(root : view::View, theme~ : String = "light", font~ : String = "serif") -> Unit {
  let theme_s = signals::signal(theme)
  let font_s = signals::signal(font)
  let size_s = signals::signal(17)
  let width_s = signals::signal("medium")
  let progress_s = signals::signal(0.18)
  let art = demo_reader_article()
  let _ = root.box(fn(card : view::View) -> Unit {
    let _ = card
    .over_at(view::Live::By(fn() { demo_card_rect(root) }))
    .radius(view::Live::By(fn() { shell_canvas_radius() }))
    .clips(view::Live::Is(true))
    build_reader_mode_panel(card, ReaderModeProps::{
      open: fn() { true },
      owner_pane: PaneId::Primary,
      article: fn() { art },
      rev: fn() { 1 },
      status: fn() { READER_STATUS_READY },
      theme: fn() { theme_s.get() },
      font: fn() { font_s.get() },
      font_size: fn() { size_s.get() },
      width_mode: fn() { width_s.get() },
      progress: fn() { progress_s.get() },
      on_theme: fn(v) { theme_s.set(v) },
      on_font: fn(v) { font_s.set(v) },
      on_font_size: fn(v) { size_s.set(v) },
      on_width_mode: fn(v) { width_s.set(v) },
      on_progress: fn(v) { progress_s.set(v) },
      on_close: fn() { () },
    })
  })
}

fn demo_boosts() -> Array[proto::SiteBoost] {
  [
    // (the demo shell's own page, notes.example.com: what the Boost panel is bound to)
    proto::SiteBoost::{
      ..proto::SiteBoost::default_for("notes.example.com"),
      enabled: true,
      tint: "#5856d6",
      tint_pct: 35,
      contrast_pct: 110,
      zapped: ["aside.newsletter-signup", "div.related-posts"],
      custom_css: "article pre {\n  font-size: 13px;\n  line-height: 1.5;\n}",
      custom_js: "document.querySelector('.share-bar')?.remove();",
    },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("github.com"), enabled: true, font: "sans", zapped: ["div.js-notice"] },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("developer.mozilla.org"), enabled: true, theme: "dark" },
    proto::SiteBoost::{
      ..proto::SiteBoost::default_for("en.wikipedia.org"),
      enabled: true,
      font: "serif",
      scale_pct: 110,
      zapped: ["#siteNotice"],
    },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("news.ycombinator.com"), enabled: false, theme: "sepia", scale_pct: 115 },
  ]
}

///| Site Boosts in the demo shell, bound to its page (`origin`, notes.example.com; `""` for a page that is not on
///| http or https): `section` 0 Colors, 1 Fonts, 2 Zap, 3 Code; `all` shows All Boosts; `zap` turns Zap on;
///| `hidden = false` starts with nothing hidden; `no_sites` shows an empty All Boosts.
pub fn build_demo_site_boosts(
  root : view::View,
  section~ : Int = 0,
  all~ : Bool = false,
  zap~ : Bool = false,
  origin~ : String = "notes.example.com",
  hidden~ : Bool = true,
  no_sites~ : Bool = false,
) -> Unit {
  let list = if no_sites { [] } else { demo_boosts() }
  let first = if origin == "" {
    proto::SiteBoost::default_for("")
  } else if no_sites {
    proto::SiteBoost::default_for(origin)
  } else if hidden {
    list[0]
  } else {
    proto::SiteBoost::{ ..list[0], zapped: [] }
  }
  let boost = signals::signal_ref(first)
  let zap_s = signals::signal(zap)
  let css_field = ui::Field::new()
  css_field.set(first.custom_css)
  let js_field = ui::Field::new()
  js_field.set(first.custom_js)
  build_site_boosts_panel(
    root,
    SiteBoostsProps::{
      open: fn() { true },
      dark: fn() { lg::is_dark() },
      target_origin: fn() { origin },
      owner_pane: fn() { PaneId::Primary },
      boost: fn() { boost.get() },
      css_field,
      anchor_top: fn() { SP_16 },
      accent_color: fn() { 0L },
      on_save: fn(_o, b) { boost.set(b) },
      on_reset: fn(o) { boost.set(proto::SiteBoost::default_for(o)) },
      on_close: fn() { () },
      on_css_edited: None,
      on_apply_css: None,
      js_field,
      zap_active: fn() { zap_s.get() },
      on_zap: fn(on) { zap_s.set(on) },
      all_boosts: fn() { list },
      on_site_save: fn(_b) { () },
      on_site_open: fn(_h) { () },
      on_site_delete: fn(_h) { () },
    },
    initial_section=section,
    initial_all=all,
  )
}
