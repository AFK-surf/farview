fn bl_ensure_image(key : String) -> Option[String] {
  if key == "" {
    return None
  }
  let img_key = "fvbrowser:" + key
  match bl_png.get(key) {
    Some(png) => {
      if ui::image_bytes_for(img_key).is_none() {
        ui::add_image(img_key, png)
      }
      Some(img_key)
    }
    None => {
      let b64 = bl_logo_b64(key)
      if b64 == "" {
        return None
      }
      let png = bl_decode_b64(b64)
      if png.length() > 0 {
        bl_png[key] = png
        ui::add_image(img_key, png)
        Some(img_key)
      } else {
        None
      }
    }
  }
}

///| Renders a crisp @2x product logo for a detected browser (`Arc`, `Chrome`, `Safari`, `Firefox`, etc.),
///| falling back to a calm monochrome glyph tile for unrecognized custom browser paths.
pub fn shell_browser_logo(parent : view::View, browser_by : () -> String, size~ : Double = SP_32) -> Unit {
  bl_register()
  let img_by = fn() -> Option[(String, String, Int)] {
    let key = shell_browser_logo_key(browser_by())
    match bl_ensure_image(key) {
      Some(k) => Some((k, "", 0))
      None => None
    }
  }
  let has_logo = fn() -> Bool { img_by().is_some() }
  let _ = parent.box(fn(box : view::View) -> Unit {
    let _ = box
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .points(view::Live::Is(false))
    .center()
    box.show(has_logo, at_once=true, fn(img : view::View) -> Unit {
      let _ = img
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .image(view::Live::By(img_by))
      .image_contains(view::Live::Is(true))
    })
    box.show(fn() { !has_logo() }, at_once=true, fn(fb : view::View) -> Unit {
      let _ = shell_glyph_tile(fb, ICON_GLOBE, size=size)
    })
  })
}
