///| Embedded @2x 64x64 product logos for supported browser migration sources
///| (Arc, Google Chrome, Safari, Firefox, Brave, Microsoft Edge, Vivaldi, Chromium).
///| Decoded lazily once per browser key and registered via `ui::add_image`.

import "lg"
import "signals"
import "ui"
import "view"

let bl_png : Map[String, Bytes] = Map::new()
let bl_hook : signals::Ref[Int] = ui::ref_new(-1)

fn bl_register() -> Unit {
  if bl_hook.v >= 0 {
    ui::remove_before_frame(bl_hook.v)
  }
  bl_hook.v = ui::on_before_frame(fn() {
    for k in bl_png.keys() {
      let img_key = "fvbrowser:" + k
      if ui::image_bytes_for(img_key).is_none() {
        match bl_png.get(k) {
          Some(png) => ui::add_image(img_key, png)
          None => ()
        }
      }
    }
  })
}

fn bl_b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

fn bl_decode_b64(s : String) -> Bytes {
  let buf : Array[Byte] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let v0 = bl_b64_val(s.code_unit_at(i).to_int())
    if v0 < 0 {
      i += 1
      continue
    }
    let v1 = if i + 1 < n { bl_b64_val(s.code_unit_at(i + 1).to_int()) } else { -1 }
    let v2 = if i + 2 < n { bl_b64_val(s.code_unit_at(i + 2).to_int()) } else { -1 }
    let v3 = if i + 3 < n { bl_b64_val(s.code_unit_at(i + 3).to_int()) } else { -1 }
    if v1 >= 0 {
      buf.push(((v0 << 2) | (v1 >> 4)).to_byte())
      if v2 >= 0 {
        buf.push((((v1 & 0xF) << 4) | (v2 >> 2)).to_byte())
        if v3 >= 0 {
          buf.push((((v2 & 0x3) << 6) | v3).to_byte())
        }
      }
    }
    i += 4
  }
  let out = Bytes::new(buf.length())
  let mut j = 0
  while j < buf.length() {
    out[j] = buf[j]
    j += 1
  }
  out
}

///| Maps a detected browser display name (e.g. "Google Chrome", "Arc", "Safari") to its canonical logo key.
pub fn shell_browser_logo_key(browser : String) -> String {
  let b = sp_ascii_lower(browser)
  if b.contains("arc") {
    "arc"
  } else if b.contains("chromium") {
    "chromium"
  } else if b.contains("chrome") {
    "chrome"
  } else if b.contains("safari") {
    "safari"
  } else if b.contains("firefox") || b.contains("zen") || b.contains("librewolf") {
    "firefox"
  } else if b.contains("brave") {
    "brave"
  } else if b.contains("edge") {
    "edge"
  } else if b.contains("vivaldi") {
    "vivaldi"
  } else {
    ""
  }
}

///| Compact human-friendly short name for a browser tile ("Google Chrome" -> "Chrome", "Microsoft Edge" -> "Edge").
pub fn shell_browser_short_name(browser : String) -> String {
  let b = sp_ascii_lower(browser)
  if b.contains("google chrome") {
    "Chrome"
  } else if b.contains("microsoft edge") {
    "Edge"
  } else if b.contains("brave browser") {
    "Brave"
  } else {
    browser
  }
}

