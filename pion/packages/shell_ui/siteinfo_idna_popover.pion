///| Farview Desktop Shell 2.0 Phase 2B — Dynamic Popover Anchor Calculator,
///| SiteInfo & Permissions Popover (`site_info`), and IDNA Spoof Warning Popover (`idn_popover`).
///|
///| Architectural invariants:
///| - Pure `shell_ui` components: zero host/net/stage/wire dependencies, 100% backed by `packages/lg`.
///| - Dynamic window-coordinate placement (`compute_popover_placement`) anchors to the live trigger
///|   button rect (`placed_window_now`), falls back to the address capsule when hidden/narrow, and
///|   clamps safely within an 8pt viewport margin across 1280 / 760 / 480 widths.
///| - SiteInfo strictly separates IDNA safe `display_host` from canonical `committed_origin` and
///|   locks `owner_pane` so permission toggles always route to the intended pane and origin.
///| - Zero hardcoded pixel suffixes, zero Unicode pseudo-icons (`packages/icons` only), 100% explicit `color_by`.

import "headless"
import "lg"
import "signals"
import "ui"
import "view"

pub let POPOVER_VIEWPORT_MARGIN : Double = 8.0
pub let POPOVER_ANCHOR_GAP : Double = 6.0

///| Window-space rectangle used for dynamic popover and menu anchoring.
pub struct AnchorRect {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
}

pub fn AnchorRect::empty() -> AnchorRect {
  AnchorRect::{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
}

pub fn AnchorRect::is_valid(self : AnchorRect) -> Bool {
  self.w > 1.0 && self.h > 1.0
}

///| Reads a mounted view's live window-space rectangle via `placed_window_now()`.
///| Subscribes to reactive layout/window signals so open popovers track resizes & sidebar drags.
///| Returns `None` when the view is absent, unmounted, or collapsed.
pub fn anchor_from_view(v : Option[view::View]) -> Option[AnchorRect] {
  match v {
    Some(node) => {
      let _ = node.laid_size_told()
      let _ = node.window_w()
      let (x, y, w, h) = node.placed_window_now()
      if w > 1.0 && h > 1.0 {
        Some(AnchorRect::{ x, y, w, h })
      } else {
        None
      }
    }
    None => None
  }
}

fn clamp_d(v : Double, lo : Double, hi : Double) -> Double {
  if hi <= lo {
    lo
  } else if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

///| Clamps a nominal popover width to fit within the viewport with 8pt horizontal margins.
pub fn clamp_popover_width(nominal_w : Double, win_w : Double) -> Double {
  let avail = win_w - 2.0 * POPOVER_VIEWPORT_MARGIN
  if avail <= 200.0 {
    if avail > 120.0 { avail } else { 120.0 }
  } else if nominal_w > avail {
    avail
  } else {
    nominal_w
  }
}

///| Computes safe window-space `(x, y)` coordinates for an anchored popover.
///| Prefers `trigger` when valid; falls back to `fallback_capsule` when the trigger button
///| is collapsed into a More menu or not laid out; clamps strictly within an 8pt viewport margin.
pub fn compute_popover_placement(
  trigger : Option[AnchorRect],
  fallback_capsule : AnchorRect,
  win_w : Double,
  win_h : Double,
  pop_w : Double,
  pop_h : Double,
) -> (Double, Double) {
  let vw = if win_w > 100.0 { win_w } else { 1280.0 }
  let vh = if win_h > 100.0 { win_h } else { 800.0 }
  let pw = clamp_popover_width(pop_w, vw)
  let ph = if pop_h > 0.0 { pop_h } else { 180.0 }

  let anchor = match trigger {
    Some(tr) if tr.is_valid() => tr
    _ =>
    if fallback_capsule.is_valid() {
      fallback_capsule
    } else {
      AnchorRect::{ x: POPOVER_VIEWPORT_MARGIN, y: SHELL_TITLEBAND_H, w: 0.0, h: 0.0 }
    }
  }

  let anchor_mid_x = anchor.x + anchor.w * 0.5
  let raw_x = if anchor_mid_x > vw * 0.5 && anchor.w > 0.0 {
    anchor.x + anchor.w - pw
  } else {
    anchor.x
  }
  let max_x = vw - pw - POPOVER_VIEWPORT_MARGIN
  let x = clamp_d(raw_x, POPOVER_VIEWPORT_MARGIN, max_x)

  let below_y = anchor.y + anchor.h + POPOVER_ANCHOR_GAP
  let max_y = vh - ph - POPOVER_VIEWPORT_MARGIN
  let y = if below_y + ph <= vh - POPOVER_VIEWPORT_MARGIN {
    clamp_d(below_y, POPOVER_VIEWPORT_MARGIN, max_y)
  } else {
    let above_y = anchor.y - ph - POPOVER_ANCHOR_GAP
    if above_y >= POPOVER_VIEWPORT_MARGIN {
      above_y
    } else {
      clamp_d(below_y, POPOVER_VIEWPORT_MARGIN, max_y)
    }
  }
  (x, y)
}

///| Computes safe window-space `(x, y)` coordinates for a point-anchored context menu or hover card.
pub fn compute_menu_placement(
  anchor_x : Double,
  anchor_y : Double,
  win_w : Double,
  win_h : Double,
  menu_w : Double,
  menu_h : Double,
) -> (Double, Double) {
  let vw = if win_w > 100.0 { win_w } else { 1280.0 }
  let vh = if win_h > 100.0 { win_h } else { 800.0 }
  let mw = clamp_popover_width(menu_w, vw)
  let mh = if menu_h > 0.0 { menu_h } else { 140.0 }
  let max_x = vw - mw - POPOVER_VIEWPORT_MARGIN
  let max_y = vh - mh - POPOVER_VIEWPORT_MARGIN
  let raw_x = if anchor_x + mw > vw - POPOVER_VIEWPORT_MARGIN {
    anchor_x - mw
  } else {
    anchor_x
  }
  let raw_y = if anchor_y + mh > vh - POPOVER_VIEWPORT_MARGIN {
    anchor_y - mh
  } else {
    anchor_y
  }
  (
    clamp_d(raw_x, POPOVER_VIEWPORT_MARGIN, max_x),
    clamp_d(raw_y, POPOVER_VIEWPORT_MARGIN, max_y),
  )
}

fn overlay_window_size(root : view::View) -> (Double, Double) {
  let _ = root.laid_size_told()
  let ww = root.window_w()
  let wh = root.window_h()
  if ww > 100.0 && wh > 100.0 {
    (ww, wh)
  } else {
    let (rw, rh) = root.laid_size()
    (if rw > 100.0 { rw } else { 1280.0 }, if rh > 100.0 { rh } else { 800.0 })
  }
}

fn build_dismiss_scrim(layer : view::View, on_close : () -> Unit) -> Unit {
  let _ = layer.box(fn(scrim : view::View) -> Unit {
    let _ = scrim
    .over(view::Live::Is(true))
    .presses(view::Live::Is(true))
    .on_press(on_close)
  })
}

fn build_close_icon_btn(
  parent : view::View,
  label : String,
  on_close : () -> Unit,
) -> Unit {
  let _ = lg::liquid_button_node(
    parent,
    fn() { label },
    on_close,
    content=fn(inner : view::View) -> Unit {
      let _ = shell_icon(inner, ICON_CLOSE, size=13.0, color_by=fn() { lg::surface().ink_secondary })
    },
    flat=true,
    ghost=true,
    height=28.0,
    pad_x=7.0,
  )
}

// ============================================================================
// SiteInfo & Permissions Popover (tag: "site_info")
// ============================================================================

///| A single site permission row bound inside the SiteInfo popover.
pub struct SitePermissionEntry {
  pub kind : String
  pub label : String
  pub state : String
}

///| Immutable snapshot locked to the target pane and canonical origin when SiteInfo opens.
///| Separates safe IDNA `display_host` from canonical `committed_origin`.
pub struct SiteInfoSnapshot {
  pub owner_pane : Int
  pub committed_origin : String
  pub display_host : String
  pub tls_secure : Bool
  pub tls_local : Bool
  pub tls_summary : String
  pub idn_warning : Bool
  pub idn_badge : String
  pub idn_detail : String
  pub cookies_count : Int
  pub zoom_percent : Int
  pub boost_active : Bool
  pub permissions : Array[SitePermissionEntry]
}

pub fn SiteInfoSnapshot::empty() -> SiteInfoSnapshot {
  SiteInfoSnapshot::{
    owner_pane: 0,
    committed_origin: "",
    display_host: "about:blank",
    tls_secure: false,
    tls_local: true,
    tls_summary: "Local or internal document",
    idn_warning: false,
    idn_badge: "",
    idn_detail: "",
    cookies_count: 0,
    zoom_percent: 100,
    boost_active: false,
    permissions: [],
  }
}

pub struct SiteInfoCallbacks {
  pub on_close : () -> Unit
  pub on_permission_change : (Int, String, String, String) -> Unit
  pub on_open_cookies : (Int, String) -> Unit
  pub on_open_zoom : (Int) -> Unit
  pub on_open_boosts : (Int, String) -> Unit
  pub on_reset_permissions : (Int, String) -> Unit
  pub on_clear_site_data : (Int, String) -> Unit
}

pub struct SiteInfoPopoverProps {
  pub open : () -> Bool
  pub snapshot : () -> SiteInfoSnapshot
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub callbacks : SiteInfoCallbacks
}

fn site_info_cookies_label(n : Int) -> String {
  if n == 1 { "1 cookie" } else { "\{n} cookies" }
}

///| Builds the Liquid Glass SiteInfo & Site Permissions Popover (tag `"site_info"`).
pub fn build_site_info_popover(root : view::View, props : SiteInfoPopoverProps) -> Unit {
  let nominal_w = 356.0
  let est_h = 420.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.callbacks.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Site Information"))))

          // 1. Header: IDNA safe display host + canonical origin subtitle + close icon button
          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(8.0)).rigid()
            let _ = hdr.box(fn(titles : view::View) -> Unit {
              let _ = titles.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0))
              let _ = <ui::Text
                in={titles}
                size={14.0}
                weight={600}
                color_by=>{lg::surface().ink}
                text_by=>{(props.snapshot)().display_host}
              />.allow_ellipsis(view::Live::Is(true))
              titles.show(
                fn() {
                  let s = (props.snapshot)()
                  s.committed_origin != "" && s.committed_origin != s.display_host
                },
                fn(orig_box : view::View) -> Unit {
                  let _ = <ui::Text
                    in={orig_box}
                    size={11.0}
                    color_by=>{lg::surface().ink_secondary}
                    text_by=>{(props.snapshot)().committed_origin}
                  />.allow_ellipsis(view::Live::Is(true))
                },
              )
            })
            build_close_icon_btn(hdr, "Close Site Info", props.callbacks.on_close)
          })

          // 2. Connection TLS status card (only factual transport info; zero fabricated CA)
          let _ = lg::surface_card_node(
            panel,
            fn(sec : view::View) -> Unit {
              let _ = sec.gap(view::Live::Is(6.0))
              let _ = sec.box(fn(crow : view::View) -> Unit {
                let _ = crow.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(8.0)).rigid()
                let _ = crow.box(fn(ic : view::View) -> Unit {
                  let _ = ic.width(view::Live::Is(Some(18.0))).height(view::Live::Is(Some(18.0))).center().rigid()
                  ic.show(fn() { (props.snapshot)().tls_secure }, fn(v : view::View) -> Unit {
                    let _ = shell_icon(v, ICON_LOCK, size=14.0, color_by=fn() { lg::surface().positive })
                  })
                  ic.show(fn() { !(props.snapshot)().tls_secure && (props.snapshot)().tls_local }, fn(v : view::View) -> Unit {
                    let _ = shell_icon(v, ICON_GLOBE, size=14.0, color_by=fn() { lg::surface().accent })
                  })
                  ic.show(fn() { !(props.snapshot)().tls_secure && !(props.snapshot)().tls_local }, fn(v : view::View) -> Unit {
                    let _ = shell_icon(v, ICON_SHIELD, size=14.0, color_by=fn() { lg::surface().warning })
                  })
                })
                let _ = crow.box(fn(stxt : view::View) -> Unit {
                  let _ = stxt.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0))
                  let _ = <ui::Text
                    in={stxt}
                    size={12.5}
                    weight={600}
                    color_by=>{
                      let s = (props.snapshot)()
                      if s.tls_secure {
                        lg::surface().positive
                      } else if s.tls_local {
                        lg::surface().accent
                      } else {
                        lg::surface().warning
                      }
                    }
                    text_by=>{
                      let s = (props.snapshot)()
                      if s.tls_secure {
                        "HTTPS Encrypted"
                      } else if s.tls_local {
                        "Local Document"
                      } else {
                        "Not Secure (HTTP)"
                      }
                    }
                  />
                  let _ = <ui::Text
                    in={stxt}
                    size={11.5}
                    wrap
                    color_by=>{lg::surface().ink_secondary}
                    text_by=>{(props.snapshot)().tls_summary}
                  />
                })
              })

              // Optional IDN verification note
              sec.show(
                fn() { (props.snapshot)().idn_badge != "" },
                fn(idn_row : view::View) -> Unit {
                  let _ = idn_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(6.0))
                  .padding(view::Live::Is((8.0, 5.0, 8.0, 5.0)))
                  .radius(view::Live::Is(lg::r_chip))
                  .ground(view::Live::By(fn() {
                    if (props.snapshot)().idn_warning {
                      lg::surface().warning_bg
                    } else {
                      lg::surface().card_secondary
                    }
                  }))
                  let _ = shell_icon(
                    idn_row,
                    if (props.snapshot)().idn_warning { "alert-triangle" } else { ICON_CHECK },
                    size=12.0,
                    color_by=fn() {
                      if (props.snapshot)().idn_warning { lg::surface().warning } else { lg::surface().positive }
                    },
                  )
                  let _ = <ui::Text
                    in={idn_row}
                    size={11.0}
                    weight={600}
                    color_by=>{
                      if (props.snapshot)().idn_warning { lg::surface().warning } else { lg::surface().ink }
                    }
                    text_by=>{(props.snapshot)().idn_badge}
                  />
                  let _ = idn_row.box(fn(det : view::View) -> Unit {
                    let _ = det.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                    let _ = <ui::Text
                      in={det}
                      size={11.0}
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{(props.snapshot)().idn_detail}
                    />.allow_ellipsis(view::Live::Is(true))
                  })
                },
              )
            },
            radius=lg::concentric(lg::r_card, 8.0),
            pad=10.0,
            secondary=true,
          )

          // 3. Quick Site Status Row: Cookies + Zoom + optional Site Boosts
          let _ = panel.box(fn(qrow : view::View) -> Unit {
            let _ = qrow.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).rigid()
            let _ = headless::button(
              qrow,
              fn() { "Inspect Site Cookies" },
              fn(_e) -> Unit {
                let s = signals::untracked(props.snapshot)
                (props.callbacks.on_open_cookies)(s.owner_pane, s.committed_origin)
              },
              fn(cb : view::View, btn : headless::Button) -> Unit {
                let _ = cb
                .grow(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(0.0)))
                .min_height(view::Live::Is(Some(44.0)))
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((10.0, 6.0, 8.0, 6.0)))
                .gap(view::Live::Is(6.0))
                .radius(view::Live::Is(lg::r_row))
                .ground(view::Live::By(fn() {
                  if btn.hovered() || btn.pressed() { lg::surface().row_hover } else { lg::surface().card }
                }))
                .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                let _ = cb.box(fn(cm : view::View) -> Unit {
                  let _ = cm.grow(view::Live::Is(1.0)).gap(view::Live::Is(2.0))
                  let _ = <ui::Text in={cm} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Cookies" />
                  let _ = <ui::Text
                    in={cm}
                    size={12.5}
                    weight={600}
                    color_by=>{lg::surface().ink}
                    text_by=>{site_info_cookies_label((props.snapshot)().cookies_count)}
                  />
                })
                let _ = shell_icon(cb, ICON_CHEVRON_RIGHT, size=13.0, color_by=fn() { lg::surface().ink_tertiary })
              },
            )
            let _ = headless::button(
              qrow,
              fn() { "Open Page Zoom" },
              fn(_e) -> Unit {
                let s = signals::untracked(props.snapshot)
                (props.callbacks.on_open_zoom)(s.owner_pane)
              },
              fn(zb : view::View, btn : headless::Button) -> Unit {
                let _ = zb
                .grow(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(0.0)))
                .min_width(view::Live::Is(Some(0.0)))
                .min_height(view::Live::Is(Some(44.0)))
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((10.0, 6.0, 8.0, 6.0)))
                .gap(view::Live::Is(6.0))
                .radius(view::Live::Is(lg::r_row))
                .ground(view::Live::By(fn() {
                  if btn.hovered() || btn.pressed() { lg::surface().row_hover } else { lg::surface().card }
                }))
                .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                let _ = zb.box(fn(zm : view::View) -> Unit {
                  let _ = zm.grow(view::Live::Is(1.0)).gap(view::Live::Is(2.0))
                  let _ = <ui::Text in={zm} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Page Zoom" />
                  let _ = <ui::Text
                    in={zm}
                    size={12.5}
                    weight={600}
                    color_by=>{lg::surface().ink}
                    text_by=>{"\{(props.snapshot)().zoom_percent}%"}
                  />
                })
                let _ = shell_icon(zb, ICON_CHEVRON_RIGHT, size=13.0, color_by=fn() { lg::surface().ink_tertiary })
              },
            )
          })

          // Optional Site Boosts shortcut
          panel.show(
            fn() { (props.snapshot)().boost_active },
            fn(bw : view::View) -> Unit {
              let _ = lg::liquid_button_node(
                bw,
                fn() { "Edit Site Boosts" },
                fn() -> Unit {
                  let s = signals::untracked(props.snapshot)
                  (props.callbacks.on_open_boosts)(s.owner_pane, s.committed_origin)
                },
                content=fn(inner : view::View) -> Unit {
                  let _ = inner.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                  let _ = shell_icon(inner, ICON_SPARKLES, size=13.5, color_by=fn() { lg::surface().accent })
                  let _ = <ui::Text in={inner} size={12.0} weight={500} color_by=>{lg::surface().accent} text="Site Boost active — Edit" />
                },
                flat=true,
                height=32.0,
              )
            },
          )

          // 4. Site Permissions list (strictly routes `(owner_pane, committed_origin, kind, next_state)`)
          panel.show(
            fn() { (props.snapshot)().permissions.length() > 0 },
            fn(psec : view::View) -> Unit {
              let _ = psec.gap(view::Live::Is(6.0))
              let _ = <ui::Text in={psec} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="SITE PERMISSIONS" />
              let _ = lg::surface_card_node(
                psec,
                fn(plist : view::View) -> Unit {
                  let _ = plist.gap(view::Live::Is(4.0))
                  plist.each(
                    fn() { (props.snapshot)().permissions },
                    fn(e : SitePermissionEntry) -> String { e.kind },
                    fn(slot : view::View, entry_sig : signals::Signal[SitePermissionEntry]) -> Unit {
                      let _ = slot
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .min_height(view::Live::Is(Some(36.0)))
                      .gap(view::Live::Is(8.0))
                      .rigid()

                      let _ = slot.box(fn(lbl_w : view::View) -> Unit {
                        let _ = lbl_w.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                        let _ = <ui::Text
                          in={lbl_w}
                          size={12.5}
                          weight={500}
                          color_by=>{lg::surface().ink}
                          text_by=>{entry_sig.get().label}
                        />.allow_ellipsis(view::Live::Is(true))
                      })

                      let _ = slot.box(fn(seg : view::View) -> Unit {
                        let _ = seg
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .padding(view::Live::Is((2.0, 2.0, 2.0, 2.0)))
                        .gap(view::Live::Is(2.0))
                        .radius(view::Live::Is(9.0))
                        .rigid()
                        .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                        .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

                        let state_btn = fn(btn_text : String, target_state : String) -> Unit {
                          let is_sel = fn() -> Bool { entry_sig.get().state == target_state }
                          let _ = headless::button(
                            seg,
                            fn() { "\{entry_sig.get().label} \{btn_text}" },
                            fn(_e) -> Unit {
                              let s = signals::untracked(props.snapshot)
                              let ent = entry_sig.untracked()
                              (props.callbacks.on_permission_change)(s.owner_pane, s.committed_origin, ent.kind, target_state)
                            },
                            fn(b : view::View, btn : headless::Button) -> Unit {
                              let _ = b
                              .height(view::Live::Is(Some(24.0)))
                              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                              .radius(view::Live::Is(7.0))
                              .center()
                              .rigid()
                              .ground(view::Live::By(fn() {
                                if is_sel() {
                                  if target_state == "allow" {
                                    lg::surface().positive_bg
                                  } else if target_state == "block" {
                                    lg::surface().danger_bg
                                  } else {
                                    lg::surface().card
                                  }
                                } else if btn.hovered() || btn.pressed() {
                                  lg::surface().row_hover
                                } else {
                                  0x00000000L
                                }
                              }))
                              .edge(view::Live::By(fn() {
                                if is_sel() {
                                  if target_state == "allow" {
                                    (0.8, lg::surface().positive)
                                  } else if target_state == "block" {
                                    (0.8, lg::surface().danger)
                                  } else {
                                    (lg::hairline_w, lg::surface().separator_strong)
                                  }
                                } else {
                                  (0.0, 0x00000000L)
                                }
                              }))
                              let _ = <ui::Text
                                in={b}
                                size={11.0}
                                weight={600}
                                color_by=>{
                                  if is_sel() {
                                    if target_state == "allow" {
                                      lg::surface().positive
                                    } else if target_state == "block" {
                                      lg::surface().danger
                                    } else {
                                      lg::surface().ink
                                    }
                                  } else {
                                    lg::surface().ink_secondary
                                  }
                                }
                                text={btn_text}
                              />
                            },
                          )
                        }
                        state_btn("Ask", "ask")
                        state_btn("Allow", "allow")
                        state_btn("Block", "block")
                      })
                    },
                  )
                },
                radius=lg::r_row,
                pad=8.0,
              )
            },
          )

          // 5. Footer actions: Reset Permissions + Clear Site Data
          let _ = panel.box(fn(arow : view::View) -> Unit {
            let _ = arow.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lies_along(view::Live::Is(view::Lies::Between)).rigid()
            let _ = lg::liquid_button_node(
              arow,
              fn() { "Reset Permissions" },
              fn() -> Unit {
                let s = signals::untracked(props.snapshot)
                (props.callbacks.on_reset_permissions)(s.owner_pane, s.committed_origin)
              },
              flat=true,
              height=30.0,
            )
            let _ = lg::liquid_button_node(
              arow,
              fn() { "Clear Site Data" },
              fn() -> Unit {
                let s = signals::untracked(props.snapshot)
                (props.callbacks.on_clear_site_data)(s.owner_pane, s.committed_origin)
              },
              content=fn(inner : view::View) -> Unit {
                let _ = <ui::Text in={inner} size={12.0} weight={600} color_by=>{lg::surface().danger} text="Clear Site Data" />
              },
              flat=true,
              height=30.0,
            )
          })
        },
        radius=lg::r_card,
      )
    })
  })
}

// ============================================================================
// IDNA Spoof Warning Popover (tag: "idn_popover")
// ============================================================================

pub struct IdnaSpoofSnapshot {
  pub unicode_host : String
  pub punycode_host : String
  pub warning_summary : String
  pub warning_detail : String
}

pub struct IdnaSpoofPopoverProps {
  pub open : () -> Bool
  pub snapshot : () -> IdnaSpoofSnapshot
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_close : () -> Unit
}

///| Builds the compact amber IDN Spoofing Warning capsule mounted inside the address bar.
///| Completely unmounted via `.show(visible)` for normal ASCII URLs and legitimate IDNs.
pub fn build_idna_spoof_capsule(
  parent : view::View,
  visible : () -> Bool,
  active : () -> Bool,
  on_press : () -> Unit,
) -> Unit {
  parent.show(visible, fn(wrap : view::View) -> Unit {
    let _ = wrap.rigid()
    let _ = headless::button(
      wrap,
      fn() { "IDN Spoofing Warning" },
      fn(_e) -> Unit { on_press() },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let _ = b
        .keeps_held(view::Live::Is(true))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .height(view::Live::Is(Some(22.0)))
        .rigid()
        .gap(view::Live::Is(5.0))
        .padding(view::Live::Is((6.0, 0.0, 8.0, 0.0)))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::By(fn() {
          if active() || btn.hovered() || btn.pressed() {
            lg::surface().warning_bg
          } else {
            lg::surface().warning_bg
          }
        }))
        .edge(view::Live::By(fn() {
          (1.0, lg::surface().warning)
        }))
        let _ = shell_icon(b, "alert-triangle", size=12.0, color_by=fn() { lg::surface().warning })
        let _ = <ui::Text in={b} size={11.0} weight={600} color_by=>{lg::surface().warning} text="IDN Warning" />
      },
    )
  })
}

///| Builds the Liquid Glass IDNA Homograph / Spoof Warning Popover (tag `"idn_popover"`).
///| Displays the confusable Unicode form alongside the canonical Punycode host and risk summary.
pub fn build_idna_spoof_popover(root : view::View, props : IdnaSpoofPopoverProps) -> Unit {
  let nominal_w = 356.0
  let est_h = 276.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((14.0, 14.0, 14.0, 14.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Lookalike Domain Warning"))))

          // Header
          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
            let _ = hdr.box(fn(badge : view::View) -> Unit {
              let _ = badge
              .width(view::Live::Is(Some(24.0)))
              .height(view::Live::Is(Some(24.0)))
              .radius(view::Live::Is(lg::r_chip))
              .center()
              .rigid()
              .ground(view::Live::By(fn() { lg::surface().warning_bg }))
              let _ = shell_icon(badge, "alert-triangle", size=14.0, color_by=fn() { lg::surface().warning })
            })
            let _ = hdr.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = <ui::Text in={tw} size={13.5} weight={600} color_by=>{lg::surface().ink} text="Lookalike Domain Warning" />
            })
            build_close_icon_btn(hdr, "Close IDN Warning", props.on_close)
          })

          // Confusable Unicode vs Canonical Punycode comparison card
          let _ = lg::surface_card_node(
            panel,
            fn(cmp : view::View) -> Unit {
              let _ = cmp.gap(view::Live::Is(8.0))
              let _ = cmp.box(fn(u_sec : view::View) -> Unit {
                let _ = u_sec.gap(view::Live::Is(2.0))
                let _ = <ui::Text in={u_sec} size={10.0} weight={600} color_by=>{lg::surface().ink_secondary} text="CONFUSABLE UNICODE FORM" />
                let _ = <ui::Text in={u_sec} size={12.5} weight={500} wrap color_by=>{lg::surface().warning} text_by=>{(props.snapshot)().unicode_host} />
              })
              let _ = cmp.box(fn(sep : view::View) -> Unit {
                let _ = sep.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
              })
              let _ = cmp.box(fn(p_sec : view::View) -> Unit {
                let _ = p_sec.gap(view::Live::Is(2.0))
                let _ = <ui::Text in={p_sec} size={10.0} weight={600} color_by=>{lg::surface().ink_secondary} text="CANONICAL PUNYCODE HOST" />
                let _ = <ui::Text in={p_sec} size={12.5} weight={600} wrap color_by=>{lg::surface().ink} text_by=>{(props.snapshot)().punycode_host} />
              })
            },
            radius=lg::r_row,
            pad=10.0,
            secondary=true,
          )

          // Risk summary + detail explanation
          let _ = lg::surface_card_node(
            panel,
            fn(risk : view::View) -> Unit {
              let _ = risk.gap(view::Live::Is(4.0))
              let _ = <ui::Text in={risk} size={12.0} weight={600} wrap color_by=>{lg::surface().warning} text_by=>{(props.snapshot)().warning_summary} />
              let _ = <ui::Text in={risk} size={11.5} wrap color_by=>{lg::surface().ink_secondary} text_by=>{(props.snapshot)().warning_detail} />
            },
            radius=lg::r_row,
            pad=10.0,
          )
        },
        radius=lg::r_card,
      )
    })
  })
}
