///| Shell 3 popovers anchored to the address field: the popover placement calculator, Site controls
///| (`site_info`) and the lookalike-domain warning (`idn_popover`), plus the small pieces every popover in
///| this area shares (header with breadcrumb, grouped-list rows, value picker, keycaps).
///|
///| - Placement (`compute_popover_placement`) anchors to the live trigger rect, falls back to the address
///|   field when the trigger is hidden, and stays `POPOVER_VIEWPORT_MARGIN` inside the window.
///| - Site Information separates the IDNA-safe `display_host` from the canonical `committed_origin` and
///|   routes every change with the `owner_pane` it was opened for.
///| - Inside the one glass layer, content is solid grouped lists (DESIGN.md section 3).

import "headless"
import "lg"
import "motion"
import "signals"
import "ui"
import "view"

pub let POPOVER_VIEWPORT_MARGIN : Double = 8.0 // SP_8
pub let POPOVER_ANCHOR_GAP : Double = 6.0 // SP_6

// Window size assumed before the first layout pass, and the narrowest width a popover shrinks to.
let POP_FALLBACK_W : Double = 1280.0
let POP_FALLBACK_H : Double = 800.0
let POP_MIN_SIZE : Double = 100.0
let POP_MIN_W : Double = 120.0 // SP_96 + SP_24
let POP_TIGHT_W : Double = 200.0 // SP_160 + SP_40

// Glyph tile colors: named entries of `shell_tile_palette()` (shell_style.pion), so a palette change reaches
// every tile in this area. One color per kind, the same wherever the kind appears.
fn tile_at(i : Int) -> Int64 {
  shell_tile_palette()[i]
}

fn tile_blue() -> Int64 {
  tile_at(0)
}

fn tile_indigo() -> Int64 {
  tile_at(1)
}

fn tile_purple() -> Int64 {
  tile_at(2)
}

fn tile_pink() -> Int64 {
  tile_at(3)
}

fn tile_red() -> Int64 {
  tile_at(4)
}

fn tile_orange() -> Int64 {
  tile_at(5)
}

fn tile_green() -> Int64 {
  tile_at(6)
}

fn tile_teal() -> Int64 {
  tile_at(7)
}

fn tile_gray() -> Int64 {
  tile_at(8)
}

///| Window-space rectangle used for dynamic popover and menu anchoring.
pub struct AnchorRect {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
}

pub fn AnchorRect::empty() -> AnchorRect {
  AnchorRect::{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
}

pub fn AnchorRect::is_valid(self : AnchorRect) -> Bool {
  self.w > 1.0 && self.h > 1.0
}

///| Reads a mounted view's live window-space rectangle via `placed_window_now()`.
///| Subscribes to reactive layout/window signals so open popovers track resizes & sidebar drags.
///| Returns `None` when the view is absent, unmounted, or collapsed.
pub fn anchor_from_view(v : Option[view::View]) -> Option[AnchorRect] {
  match v {
    Some(node) => {
      let _ = node.laid_size_told()
      let _ = node.window_w()
      let (x, y, w, h) = node.placed_window_now()
      if w > 1.0 && h > 1.0 {
        Some(AnchorRect::{ x, y, w, h })
      } else {
        None
      }
    }
    None => None
  }
}

fn clamp_d(v : Double, lo : Double, hi : Double) -> Double {
  if hi <= lo {
    lo
  } else if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

///| Clamps a nominal popover width to fit within the viewport with 8pt horizontal margins.
pub fn clamp_popover_width(nominal_w : Double, win_w : Double) -> Double {
  let avail = win_w - 2.0 * POPOVER_VIEWPORT_MARGIN
  if avail <= POP_TIGHT_W {
    if avail > POP_MIN_W { avail } else { POP_MIN_W }
  } else if nominal_w > avail {
    avail
  } else {
    nominal_w
  }
}

///| Computes safe window-space `(x, y)` coordinates for an anchored popover.
///| Prefers `trigger` when valid; falls back to `fallback_capsule` when the trigger button
///| is collapsed into a More menu or not laid out; clamps strictly within an 8pt viewport margin.
pub fn compute_popover_placement(
  trigger : Option[AnchorRect],
  fallback_capsule : AnchorRect,
  win_w : Double,
  win_h : Double,
  pop_w : Double,
  pop_h : Double,
) -> (Double, Double) {
  let vw = if win_w > POP_MIN_SIZE { win_w } else { POP_FALLBACK_W }
  let vh = if win_h > POP_MIN_SIZE { win_h } else { POP_FALLBACK_H }
  let pw = clamp_popover_width(pop_w, vw)
  let ph = if pop_h > 0.0 { pop_h } else { SP_160 + SP_20 }

  let anchor = match trigger {
    Some(tr) if tr.is_valid() => tr
    _ =>
    if fallback_capsule.is_valid() {
      fallback_capsule
    } else {
      AnchorRect::{ x: POPOVER_VIEWPORT_MARGIN, y: SHELL_TITLEBAND_H, w: 0.0, h: 0.0 }
    }
  }

  let anchor_mid_x = anchor.x + anchor.w * 0.5
  let raw_x = if anchor_mid_x > vw * 0.5 && anchor.w > 0.0 {
    anchor.x + anchor.w - pw
  } else {
    anchor.x
  }
  let max_x = vw - pw - POPOVER_VIEWPORT_MARGIN
  let x = clamp_d(raw_x, POPOVER_VIEWPORT_MARGIN, max_x)

  let below_y = anchor.y + anchor.h + POPOVER_ANCHOR_GAP
  let max_y = vh - ph - POPOVER_VIEWPORT_MARGIN
  let y = if below_y + ph <= vh - POPOVER_VIEWPORT_MARGIN {
    clamp_d(below_y, POPOVER_VIEWPORT_MARGIN, max_y)
  } else {
    let above_y = anchor.y - ph - POPOVER_ANCHOR_GAP
    if above_y >= POPOVER_VIEWPORT_MARGIN {
      above_y
    } else {
      clamp_d(below_y, POPOVER_VIEWPORT_MARGIN, max_y)
    }
  }
  (x, y)
}

///| Computes safe window-space `(x, y)` coordinates for a point-anchored context menu or hover card.
pub fn compute_menu_placement(
  anchor_x : Double,
  anchor_y : Double,
  win_w : Double,
  win_h : Double,
  menu_w : Double,
  menu_h : Double,
) -> (Double, Double) {
  let vw = if win_w > POP_MIN_SIZE { win_w } else { POP_FALLBACK_W }
  let vh = if win_h > POP_MIN_SIZE { win_h } else { POP_FALLBACK_H }
  let mw = clamp_popover_width(menu_w, vw)
  let mh = if menu_h > 0.0 { menu_h } else { SP_128 + SP_12 }
  let max_x = vw - mw - POPOVER_VIEWPORT_MARGIN
  let max_y = vh - mh - POPOVER_VIEWPORT_MARGIN
  let raw_x = if anchor_x + mw > vw - POPOVER_VIEWPORT_MARGIN {
    anchor_x - mw
  } else {
    anchor_x
  }
  let raw_y = if anchor_y + mh > vh - POPOVER_VIEWPORT_MARGIN {
    anchor_y - mh
  } else {
    anchor_y
  }
  (
    clamp_d(raw_x, POPOVER_VIEWPORT_MARGIN, max_x),
    clamp_d(raw_y, POPOVER_VIEWPORT_MARGIN, max_y),
  )
}

fn overlay_window_size(root : view::View) -> (Double, Double) {
  let _ = root.laid_size_told()
  let ww = root.window_w()
  let wh = root.window_h()
  if ww > POP_MIN_SIZE && wh > POP_MIN_SIZE {
    (ww, wh)
  } else {
    let (rw, rh) = root.laid_size()
    (if rw > POP_MIN_SIZE { rw } else { POP_FALLBACK_W }, if rh > POP_MIN_SIZE { rh } else { POP_FALLBACK_H })
  }
}

fn build_dismiss_scrim(layer : view::View, on_close : () -> Unit) -> Unit {
  let _ = layer.box(fn(scrim : view::View) -> Unit {
    let _ = scrim
    .over(view::Live::Is(true))
    .presses(view::Live::Is(true))
    .on_press(on_close)
  })
}

// ============================================================================
// Shared popover pieces
// ============================================================================

// The popover panel is lg's floating panel at its own corner (`lg::r_card`); the content inside is inset `SP_8`,
// so the grouped-list cards are concentric with it: lg::concentric(20, 8) == 12.
let POP_PANEL_PAD : Double = 8.0 // SP_8

fn pop_card_radius() -> Double {
  lg::concentric(lg::r_card, POP_PANEL_PAD)
}

///| Where an anchored popover goes: `(x, y, max_h)`.
///| With the sidebar docked (the address field sits at the window's leading edge on a wide window) the popover
///| opens beside the sidebar, top-aligned with the address field, so it lies over the page card instead of the
///| favorites. Otherwise it opens under its trigger (`compute_popover_placement` for x). It always opens
///| downward and its height is capped at what is left of the window, so a long panel scrolls instead of
///| running past the bottom edge.
fn pop_place(
  trigger : Option[AnchorRect],
  capsule : AnchorRect,
  vw : Double,
  vh : Double,
  pw : Double,
) -> (Double, Double, Double) {
  let in_sidebar = vw >= SHELL_SIDEBAR_BREAKPOINT &&
  capsule.is_valid() &&
  capsule.x < SP_32 &&
  capsule.x + capsule.w < vw * 0.5
  let (x, y) = if in_sidebar {
    let max_x = vw - pw - POPOVER_VIEWPORT_MARGIN
    (clamp_d(capsule.x + capsule.w + SHELL_FRAME_GAP * 2.0, POPOVER_VIEWPORT_MARGIN, max_x), capsule.y)
  } else {
    let anchor = match trigger {
      Some(tr) if tr.is_valid() => tr
      _ => capsule
    }
    let (px, _) = compute_popover_placement(trigger, capsule, vw, vh, pw, SP_160)
    (px, anchor.y + anchor.h + POPOVER_ANCHOR_GAP)
  }
  let top = clamp_d(y, POPOVER_VIEWPORT_MARGIN, vh - SP_160 - POPOVER_VIEWPORT_MARGIN)
  let room = vh - top - POPOVER_VIEWPORT_MARGIN
  (x, top, if room > SP_160 { room } else { SP_160 })
}

///| Mounts an anchored popover: the dismiss scrim, the placed position box and the one glass panel.
///| `header` stays fixed at the top; `body` scrolls below it when the window is too short (groups `SP_16`
///| apart, cards inset `SP_8` from the panel edge).
fn pop_mount(
  root : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  trigger_anchor : () -> Option[AnchorRect],
  fallback_capsule : () -> AnchorRect,
  nominal_w : Double,
  label : String,
  header : (view::View, () -> Unit) -> Unit,
  body : (view::View) -> Unit,
  footer? : (view::View, view::View) -> Unit,
  header_pad~ : (Double, Double, Double, Double) = (SP_12, SP_4, SP_4, SP_8),
) -> Unit {
  // Opened by the person: grows out of its trigger (see `shell_popover_reveal`). Already open when built: there
  // at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(open, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    let close_now = shell_closes(layer, on_close)
    let reveal = shell_popover_reveal(layer, built.v)
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, close_now)
    let place = fn() {
      let (vw, vh) = overlay_window_size(root)
      let pw = clamp_popover_width(nominal_w, vw)
      pop_place(trigger_anchor(), fallback_capsule(), vw, vh, pw)
    }
    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (px, py, _) = place()
        (Some(px), Some(py), None, None)
      }))
      let (ox, oy) = signals::untracked(fn() {
        let (vw, _) = overlay_window_size(root)
        let (px, py, mh) = place()
        let anchor = match trigger_anchor() {
          Some(tr) if tr.is_valid() => tr
          _ => fallback_capsule()
        }
        shell_popover_origin(anchor, px, py, clamp_popover_width(nominal_w, vw), mh)
      })
      reveal.grows(pos, ox=ox, oy=oy)
      let _ = lg::liquid_panel_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .max_height(view::Live::By(fn() {
            let (_, _, mh) = place()
            Some(mh)
          }))
          .clips(view::Live::Is(true))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label=label))))
          let _ = panel.box(fn(hw : view::View) -> Unit {
            // Tile at SP_8 + SP_12, the same edge as the row tiles in the cards below.
            let _ = hw.padding(view::Live::Is(header_pad)).rigid()
            // (the header's Close is the person's close too: it plays the same way out as a click outside)
            header(hw, close_now)
          })
          let _ = panel.box(fn(bw : view::View) -> Unit {
            let _ = bw.shrink(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
            let vp = ui::scroll_box(bw, fn(sc : view::View) -> Unit {
              let _ = sc.gap(view::Live::Is(SP_16))
              body(sc)
            }, fill=false)
            let _ = vp.shrink(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
          })
          // A footer that stays under the scrolling body (it gets the overlay layer too, for a menu of its own).
          match footer {
            Some(f) => {
              let _ = panel.box(fn(fw : view::View) -> Unit {
                let _ = fw.rigid().padding(view::Live::Is((SP_0, SP_8, SP_0, SP_0)))
                f(fw, layer)
              })
            }
            None => ()
          }
        },
        radius=lg::r_card,
        pad=POP_PANEL_PAD,
        floating=true,
        label=fn() { label },
      )
    })
  })
  built.v = true
}

///| A flat 32pt icon button (close, play, mute): the shell's one icon face (`shell_icon_face_btn`).
fn pop_icon_btn(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  icon_by : () -> String,
  color_by~ : () -> Int64 = fn() { lg::surface().ink_secondary },
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = shell_icon_face_btn(parent, label, on_press, icon_by, color_by=color_by, disabled=disabled)
}

fn build_close_icon_btn(parent : view::View, label : String, on_close : () -> Unit) -> Unit {
  pop_icon_btn(parent, fn() { label }, on_close, fn() { ICON_CLOSE })
}

///| Title + optional subtitle beside a tile. The first line is a 32pt band so the tile, a breadcrumb
///| chevron and the close button all center on it.
fn pop_title_block(parent : view::View, title_by : () -> String, sub_by : () -> String) -> Unit {
  let _ = parent.box(fn(col : view::View) -> Unit {
    let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
    let _ = col.box(fn(band : view::View) -> Unit {
      let _ = band
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .min_width(view::Live::Is(Some(0.0)))
      let _ = band.box(fn(tw : view::View) -> Unit {
        let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
        <ui::Text in={tw} size={TX_CALLOUT} weight={600} lines={1} color_by=>{lg::surface().ink} text_by=>{title_by()} />
      })
    })
    col.show(fn() { sub_by() != "" }, fn(sub : view::View) -> Unit {
      let _ = sub.min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={sub} size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{sub_by()} />
    })
  })
}

///| Popover header: `lead` (a 24pt tile), an optional breadcrumb chevron, the title, and close.
///| A child popover reads as `[site] > Title`, like the settings breadcrumbs.
fn pop_header(
  panel : view::View,
  lead : (view::View) -> Unit,
  crumb : Bool,
  title_by : () -> String,
  sub_by : () -> String,
  close_label : String,
  on_close : () -> Unit,
  trailing~ : (view::View) -> Unit = fn(_v) { () },
) -> Unit {
  let _ = panel.box(fn(hdr : view::View) -> Unit {
    let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_8)).rigid()
    let _ = hdr.box(fn(lw : view::View) -> Unit {
      let _ = lw.height(view::Live::Is(Some(SP_32))).rigid().row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_6))
      lead(lw)
      if crumb {
        let _ = shell_icon(lw, ICON_CHEVRON_RIGHT, size=IC_SM, color_by=fn() { lg::surface().ink_tertiary })
      }
    })
    pop_title_block(hdr, title_by, sub_by)
    trailing(hdr)
    build_close_icon_btn(hdr, close_label, on_close)
  })
}

///| Quiet sentence-case caption above a group.
fn pop_caption(parent : view::View, text : String) -> Unit {
  <ui::Box in={parent} pad_x={SP_12} rigid>
    <ui::Text size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={text} />
  </ui::Box>
}

///| Footnote below a group (wraps).
fn pop_footnote(parent : view::View, text_by : () -> String) -> Unit {
  let _ = parent.box(fn(fb : view::View) -> Unit {
    // A little air under the last line when the footnote closes the panel.
    let _ = fb.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_4))).rigid()
    <ui::Text in={fb} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text_by=>{text_by()} />
  })
}

///| One solid grouped-list card (rows go in `rows`, rules between them via `pop_rule`).
fn pop_group(parent : view::View, rows : (view::View) -> Unit) -> Unit {
  let card = lg::surface_card_node(parent, fn(c : view::View) -> Unit { rows(c) }, radius=pop_card_radius(), pad=SP_0)
  let _ = card.cut().rigid()
}

///| Hairline between rows of a group, starting where the row labels start (after the 24pt tile).
fn pop_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((SP_12 + SP_24 + SP_12, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| Row body shared by static and pressable rows: 24pt tile, label (+ optional second line), trailing.
///| Two-line rows line up on the first line so the tile sits beside the label, not the block's middle.
fn pop_row_body(
  row : view::View,
  lead : (view::View) -> Unit,
  title_by : () -> String,
  sub_by : Option[() -> String],
  trailing : (view::View) -> Unit,
  title_color~ : () -> Int64 = fn() { lg::surface().ink },
  sub_color~ : () -> Int64 = fn() { lg::surface().ink_secondary },
  pad_y~ : Double = SP_8,
) -> Unit {
  let two = sub_by.is_some()
  let _ = row
  .row(view::Live::Is(true))
  .lines_up(view::Live::Is(Some(if two { view::Along::Start } else { view::Along::Middle })))
  .min_height(view::Live::Is(Some(SP_40)))
  .padding(view::Live::Is((SP_12, pad_y, SP_12, pad_y)))
  .gap(view::Live::Is(SP_12))
  lead(row)
  let _ = row.box(fn(col : view::View) -> Unit {
    let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
    let _ = col.box(fn(band : view::View) -> Unit {
      let _ = band.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).min_height(view::Live::Is(Some(SP_24))).min_width(view::Live::Is(Some(0.0)))
      let _ = band.box(fn(tw : view::View) -> Unit {
        let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
        <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{title_color()} text_by=>{title_by()} />
      })
    })
    match sub_by {
      Some(sb) =>
      col.show(fn() { sb() != "" }, fn(sw : view::View) -> Unit {
        let _ = sw.min_width(view::Live::Is(Some(0.0)))
        <ui::Text in={sw} size={TX_FOOTNOTE} wrap color_by=>{sub_color()} text_by=>{sb()} />
      })
      None => ()
    }
  })
  let _ = row.box(fn(tr : view::View) -> Unit {
    let _ = tr
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_24)))
    .gap(view::Live::Is(SP_6))
    .rigid()
    trailing(tr)
  })
}

///| A static grouped-list row.
fn pop_row(
  parent : view::View,
  lead : (view::View) -> Unit,
  title_by : () -> String,
  sub_by : Option[() -> String],
  trailing : (view::View) -> Unit,
  title_color~ : () -> Int64 = fn() { lg::surface().ink },
  sub_color~ : () -> Int64 = fn() { lg::surface().ink_secondary },
  pad_y~ : Double = SP_8,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    pop_row_body(row, lead, title_by, sub_by, trailing, title_color=title_color, sub_color=sub_color, pad_y=pad_y)
  })
}

///| A pressable grouped-list row: value and chevron trailing, the row wash eases in on hover.
fn pop_nav_row(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  lead : (view::View) -> Unit,
  title_by : () -> String,
  value_by : () -> String,
  chevron~ : Bool = true,
  disabled~ : () -> Bool = fn() { false },
  trailing~ : (view::View) -> Unit = fn(_v) { () },
) -> Unit {
  let _ = headless::button(
    parent,
    label,
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let _ = b.ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      pop_row_body(
        b,
        lead,
        title_by,
        None,
        fn(tr : view::View) -> Unit {
          tr.show(fn() { value_by() != "" }, fn(vw : view::View) -> Unit {
            <ui::Text in={vw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{value_by()} />
          })
          trailing(tr)
          if chevron {
            let _ = shell_icon(tr, ICON_CHEVRON_RIGHT, size=IC_SM, color_by=fn() { lg::surface().ink_tertiary })
          }
        },
        title_color=fn() { if disabled() { lg::surface().ink_tertiary } else { lg::surface().ink } },
      )
    },
    disabled=disabled,
  )
}

///| A 24pt glyph tile with a fixed color.
fn pop_tile(parent : view::View, icon_name : String, color : Int64) -> Unit {
  let _ = shell_glyph_tile(parent, icon_name, fn() { color }, size=SP_24)
}

///| A 24pt glyph tile whose glyph and color follow live state.
fn pop_tile_by(parent : view::View, icon_by : () -> String, color_by : () -> Int64) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(SP_24)))
    .height(view::Live::Is(Some(SP_24)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(SP_24)))
    .ground(view::Live::By(color_by))
    .points(view::Live::Is(false))
    .center()
    let _ = shell_icon_by(tile, icon_by, size=shell_tile_glyph(SP_24), color_by=fn() { 0xFFFFFFFFL })
  })
}

///| A keycap pill (`⌘`, `0`), as in the keyboard settings.
fn pop_keycap(parent : view::View, key : String) -> Unit {
  let _ = parent.box(fn(cap : view::View) -> Unit {
    let _ = cap
    .height(view::Live::Is(Some(SP_20)))
    .min_width(view::Live::Is(Some(SP_20)))
    .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
    .radius(view::Live::Is(SP_6))
    .rigid()
    .center()
    .ground(view::Live::By(fn() { lg::surface().card_secondary }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
    <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={key} />
  })
}

///| The platform's command modifier as keycap text.
fn pop_mod_key() -> String {
  if ui::keys_system() <= 0 { "⌘" } else { "Ctrl" }
}

///| A compact value picker (segmented, neutral): one segment per value, the chosen one lifted.
///| Each segment is its own button named `"<row> <Value>"`, so every value is one press away. The track and
///| pills are drawn 24pt tall, but each segment presses over the full 32pt band (DESIGN.md: hit targets >= 32).
fn pop_value_picker(
  parent : view::View,
  row_label : () -> String,
  current : () -> String,
  values : Array[(String, String)],
  on_pick : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(band : view::View) -> Unit {
    let _ = band
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_32)))
    .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
    .gap(view::Live::Is(SP_2))
    .rigid()
    // The visible 24pt track, behind the segments.
    let _ = band.box(fn(track : view::View) -> Unit {
      let _ = track
      .over_at(view::Live::Is((Some(SP_0), Some(SP_4), Some(SP_0), Some(SP_4))))
      .radius(view::Live::Is(SP_8))
      .points(view::Live::Is(false))
      .ground(view::Live::By(fn() { lg::surface().separator }))
    })
    for pair in values {
      let (shown, value) = pair
      let _ = headless::button(
        band,
        fn() { "\{row_label()} \{shown}" },
        fn(_e) -> Unit {
          if signals::untracked(current) != value {
            on_pick(value)
          }
        },
        fn(seg : view::View, btn : headless::Button) -> Unit {
          let sel_t = shell_fade(seg, fn() { current() == value })
          let hover_t = shell_fade(seg, fn() { btn.hovered() && current() != value })
          let _ = seg.height(view::Live::Is(Some(SP_32))).rigid().center()
          let _ = seg.box(fn(pill : view::View) -> Unit {
            let _ = pill
            .height(view::Live::Is(Some(SP_20)))
            .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
            .radius(view::Live::Is(SP_6))
            .points(view::Live::Is(false))
            .center()
            .ground(view::Live::By(fn() {
              let lift = if lg::is_dark() { lg::surface().separator_strong } else { lg::surface().card }
              let s = sel_t()
              if s > 0.001 {
                lg::alpha(lift, s)
              } else {
                lg::alpha(lg::surface().row_hover, hover_t())
              }
            }))
            <ui::Text
              in={pill}
              size={TX_FOOTNOTE}
              weight={500}
              color_by=>{if current() == value { lg::surface().ink } else { lg::surface().ink_secondary }}
              text={shown}
            />
          })
        },
      )
    }
  })
}

// ============================================================================
// SiteInfo & Permissions Popover (tag: "site_info")
// ============================================================================

///| A single site permission row bound inside the SiteInfo popover.
pub struct SitePermissionEntry {
  pub kind : String
  pub label : String
  pub state : String
}

///| Immutable snapshot locked to the target pane and canonical origin when SiteInfo opens.
///| Separates safe IDNA `display_host` from canonical `committed_origin`.
pub struct SiteInfoSnapshot {
  pub owner_pane : Int
  pub committed_origin : String
  pub display_host : String
  pub tls_secure : Bool
  pub tls_local : Bool
  pub tls_summary : String
  pub idn_warning : Bool
  pub idn_badge : String
  pub idn_detail : String
  pub cookies_count : Int
  pub zoom_percent : Int
  pub boost_active : Bool
  ///| Reader Mode is on in the page (the Reader button shows it pressed in).
  pub reader_active : Bool
  pub permissions : Array[SitePermissionEntry]
}

pub fn SiteInfoSnapshot::empty() -> SiteInfoSnapshot {
  SiteInfoSnapshot::{
    owner_pane: 0,
    committed_origin: "",
    display_host: "about:blank",
    tls_secure: false,
    tls_local: true,
    tls_summary: "Local or internal document",
    idn_warning: false,
    idn_badge: "",
    idn_detail: "",
    cookies_count: 0,
    zoom_percent: 100,
    boost_active: false,
    reader_active: false,
    permissions: [],
  }
}

pub struct SiteInfoCallbacks {
  pub on_close : () -> Unit
  ///| The four actions on top: copy the page's link, the Boost editor, a screenshot, Reader Mode.
  pub on_share : (Int, String) -> Unit
  pub on_capture : (Int) -> Unit
  pub on_reader : (Int) -> Unit
  pub on_permission_change : (Int, String, String, String) -> Unit
  pub on_open_cookies : (Int, String) -> Unit
  pub on_open_zoom : (Int) -> Unit
  pub on_open_boosts : (Int, String) -> Unit
  pub on_reset_permissions : (Int, String) -> Unit
  pub on_clear_site_data : (Int, String) -> Unit
}

pub struct SiteInfoPopoverProps {
  pub open : () -> Bool
  pub snapshot : () -> SiteInfoSnapshot
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub callbacks : SiteInfoCallbacks
}

fn site_info_cookies_label(n : Int) -> String {
  if n == 0 { "None" } else if n == 1 { "1 cookie" } else { "\{n} cookies" }
}

///| Glyph for a permission kind (on a monochrome tile: the glyph alone says the kind).
fn site_perm_icon(kind : String) -> String {
  if kind == "camera" {
    ICON_CAMERA
  } else if kind == "microphone" {
    "mic"
  } else if kind == "notifications" {
    "bell"
  } else if kind == "geolocation" {
    "send"
  } else if kind == "clipboard" {
    ICON_COPY
  } else {
    ICON_SHIELD
  }
}

///| A permission's state as its row's second line.
fn site_perm_value(state : String) -> String {
  if state == "allow" {
    "Allowed"
  } else if state == "block" {
    "Blocked"
  } else {
    "Ask"
  }
}

///| Host (with a non-default port) of a canonical origin: `https://github.com` -> `github.com`,
///| `http://localhost:8080` -> `localhost:8080`.
fn site_origin_host(origin : String) -> String {
  let (rest, default_port) = if origin.starts_with("https://") {
    (origin.slice(8, origin.length()), ":443")
  } else if origin.starts_with("http://") {
    (origin.slice(7, origin.length()), ":80")
  } else {
    (origin, "")
  }
  let mut i = 0
  while i < rest.length() {
    let c = rest.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      break
    }
    i += 1
  }
  let host = rest.slice(0, i)
  if default_port != "" && host.ends_with(default_port) {
    host.slice(0, host.length() - default_port.length())
  } else {
    host
  }
}

///| The canonical origin, shown under the host only when its host differs from it (Unicode vs ASCII name, a
///| non-default port). An ordinary site shows its host once.
fn site_origin_subtitle(s : SiteInfoSnapshot) -> String {
  if s.committed_origin == "" {
    return ""
  }
  let host = site_origin_host(s.committed_origin)
  if host == s.display_host || "www." + host == s.display_host || host == "www." + s.display_host {
    ""
  } else {
    s.committed_origin
  }
}

fn site_conn_title(s : SiteInfoSnapshot) -> String {
  if s.tls_secure {
    "Connection is secure"
  } else if s.tls_local {
    "Local page"
  } else {
    "Connection is not secure"
  }
}

fn site_conn_icon(s : SiteInfoSnapshot) -> String {
  if s.tls_secure {
    ICON_LOCK
  } else if s.tls_local {
    "file"
  } else {
    "unlock"
  }
}

///| The footer chip's word for the connection.
fn site_conn_chip(s : SiteInfoSnapshot) -> String {
  if s.idn_warning {
    "Lookalike name"
  } else if s.tls_secure {
    "Secure"
  } else if s.tls_local {
    "Local"
  } else {
    "Not secure"
  }
}

///| The chip's ink: green for a secure connection, orange for one that is not, quiet for a local page (the one
///| place in the panel where color says something).
fn site_conn_ink(s : SiteInfoSnapshot) -> Int64 {
  if s.idn_warning {
    lg::surface().warning
  } else if s.tls_secure {
    lg::surface().positive
  } else if s.tls_local {
    lg::surface().ink_secondary
  } else {
    lg::surface().warning
  }
}

fn site_conn_ground(s : SiteInfoSnapshot) -> Int64 {
  if s.idn_warning {
    lg::surface().warning_bg
  } else if s.tls_secure {
    lg::surface().positive_bg
  } else if s.tls_local {
    mono_tile_ground()
  } else {
    lg::surface().warning_bg
  }
}

///| One of the four actions on top: a solid square face with its glyph, the wash on hover, a 0.97 press; `on`
///| (Reader Mode on, a Boost in use) fills it with ink.
fn site_action_btn(parent : view::View, label : String, icon : String, on : () -> Bool, on_press : () -> Unit) -> Unit {
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      let on_t = shell_fade(b, on)
      shell_press(b, fn() { btn.pressed() })
      let _ = b
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .min_width(view::Live::Is(Some(0.0)))
      .height(view::Live::Is(Some(SP_40)))
      .radius(view::Live::Is(SP_10))
      .center()
      .ground(view::Live::By(fn() {
        let rest = shell_mix(lg::surface().card, lg::surface().ink, 0.05 * hover_t())
        shell_mix(rest, lg::surface().ink, on_t())
      }))
      .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator_strong) }))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Button, label~, pressed=on())) }))
      let _ = shell_icon(b, icon, size=IC_LG, color_by=fn() { shell_mix(lg::surface().ink, lg::surface().card, on_t()) })
    },
  )
}

///| A row of the Settings list: a round monochrome tile, the title over its value; pressing it opens its picker
///| or detail.
fn site_setting_row(
  parent : view::View,
  label : () -> String,
  icon : String,
  title : () -> String,
  value : () -> String,
  on_press : () -> Unit,
  open~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = headless::button(
    parent,
    label,
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() || open() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .min_height(view::Live::Is(Some(SP_48)))
      // (flat on the panel: the tile lines up with the actions above; the hover wash is concentric with the round
      // tile SP_8 inside it at the 48pt row's top)
      .padding(view::Live::Is((SP_4, SP_4, SP_8, SP_4)))
      .gap(view::Live::Is(SP_12))
      .radius(view::Live::Is(SP_24))
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      let _ = mono_tile(b, fn() { icon }, size=SP_32)
      let _ = b.box(fn(col : view::View) -> Unit {
        let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
        let t = <ui::Text in={col} size={TX_BODY} weight={500} lines={1} color_by=>{lg::surface().ink} text_by=>{title()} />
        let _ = t.cut().allow_ellipsis(view::Live::Is(true))
        let v = <ui::Text in={col} size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{value()} />
        let _ = v.cut().allow_ellipsis(view::Live::Is(true))
      })
    },
  )
}

///| Builds Site controls (tag `"site_info"`), Arc's page controls in Shell 3 form: four actions on top (copy the
///| link, Boost, a screenshot, Reader Mode), the site's Settings as rows that open their picker or detail, and a
///| footer with the connection's state (it opens the connection detail) and More (reset permissions, clear site
///| data). Every change carries the locked `(owner_pane, committed_origin)`.
///| `initial_picking` (a permission kind), `initial_more` and `initial_detail` open that part with the first
///| opening (the gallery's scenes); later openings start closed up.
pub fn build_site_info_popover(
  root : view::View,
  props : SiteInfoPopoverProps,
  initial_picking~ : String = "",
  initial_more~ : Bool = false,
  initial_detail~ : Bool = false,
) -> Unit {
  let snap = props.snapshot
  let cb = props.callbacks
  // The permission whose picker is open ("" none), the connection detail, the More menu.
  let picking : signals::Signal[String] = signals::signal("")
  let detail : signals::Signal[Bool] = signals::signal(false)
  let more_open : signals::Signal[Bool] = signals::signal(false)
  let first : signals::Ref[Bool] = ui::ref_new(true)
  // (each opening starts closed up, except that a lookalike name shows who the site really is at once)
  root.reacts(props.open, fn(on : Bool) -> Unit {
    if on {
      let f = first.v
      first.v = false
      picking.set(if f { initial_picking } else { "" })
      more_open.set(f && initial_more)
      detail.set(signals::untracked(snap).idn_warning || (f && initial_detail))
    }
  })
  let pane = fn() -> Int { signals::untracked(snap).owner_pane }
  let origin = fn() -> String { signals::untracked(snap).committed_origin }
  pop_mount(
    root,
    props.open,
    cb.on_close,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 + SP_96 + SP_16,
    "Site Controls",
    fn(hw : view::View, _close : () -> Unit) -> Unit {
      let _ = hw.box(fn(acts : view::View) -> Unit {
        let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(SP_8))
        site_action_btn(acts, "Copy Link", "share", fn() { false }, fn() { (cb.on_share)(pane(), origin()) })
        site_action_btn(acts, "Edit Site Boosts", ICON_SPARKLES, fn() { snap().boost_active }, fn() {
          (cb.on_open_boosts)(pane(), origin())
        })
        site_action_btn(acts, "Capture Screenshot", ICON_CAMERA, fn() { false }, fn() { (cb.on_capture)(pane()) })
        site_action_btn(acts, "Reader Mode", ICON_READER, fn() { snap().reader_active }, fn() { (cb.on_reader)(pane()) })
      })
    },
    fn(panel : view::View) -> Unit {
      // Who the site is and how it is reached (opened from the footer chip; at once for a lookalike name).
      panel.show(fn() { detail.get() }, at_once=true, fn(dsec : view::View) -> Unit {
        pop_group(dsec, fn(g : view::View) -> Unit {
          pop_row(
            g,
            fn(r : view::View) {
              let _ = mono_tile(r, fn() { site_conn_icon(snap()) }, size=SP_24, round=false)
            },
            fn() { snap().display_host },
            Some(fn() { site_origin_subtitle(snap()) }),
            fn(_t) { () },
          )
          pop_rule(g)
          pop_row(g, fn(r : view::View) {
            let _ = mono_tile(r, fn() { ICON_SHIELD }, size=SP_24, round=false)
          }, fn() { site_conn_title(snap()) }, Some(fn() { snap().tls_summary }), fn(_t) { () })
          g.show(fn() { snap().idn_badge != "" }, fn(idn : view::View) -> Unit {
            pop_rule(idn)
            pop_row(
              idn,
              fn(r : view::View) {
                // (a lookalike warning keeps its orange: it is the state, not decoration)
                if signals::untracked(snap).idn_warning {
                  pop_tile(r, ICON_ALERT_TRIANGLE, tile_orange())
                } else {
                  let _ = mono_tile(r, fn() { ICON_CHECK }, size=SP_24, round=false)
                }
              },
              fn() { snap().idn_badge },
              Some(fn() { snap().idn_detail }),
              fn(_t) { () },
            )
          })
        })
      })

      // Settings: what the site may use and what it keeps.
      let _ = panel.box(fn(ssec : view::View) -> Unit {
        let _ = ssec.gap(view::Live::Is(SP_4)).rigid()
        // (a section title as Arc's: semibold ink; the rows sit on the panel itself, no card of their own)
        let _ = ssec.box(fn(tw : view::View) -> Unit {
          let _ = tw.padding(view::Live::Is((SP_4, SP_4, SP_4, SP_2))).rigid()
          <ui::Text in={tw} size={TX_CALLOUT} weight={600} color_by=>{lg::surface().ink} text="Settings" />
        })
        let _ = ssec.box(fn(list : view::View) -> Unit {
          let _ = list.rigid()
          list.each(
            fn() { snap().permissions },
            fn(e : SitePermissionEntry) -> String { e.kind },
            fn(slot : view::View, entry_sig : signals::Signal[SitePermissionEntry]) -> Unit {
              let kind = entry_sig.untracked().kind
              site_setting_row(
                slot,
                fn() { "Change " + entry_sig.get().label + " Permission" },
                site_perm_icon(kind),
                fn() { entry_sig.get().label },
                fn() { site_perm_value(entry_sig.get().state) },
                fn() { picking.set(if picking.untracked() == kind { "" } else { kind }) },
                open=fn() { picking.get() == kind },
              )
              slot.show(fn() { picking.get() == kind }, at_once=true, fn(pk : view::View) -> Unit {
                // (the picker lines up with the row's title)
                let _ = pk.padding(view::Live::Is((SP_4 + SP_32 + SP_12, SP_0, SP_8, SP_6)))
                pop_value_picker(
                  pk,
                  fn() { entry_sig.get().label },
                  fn() { entry_sig.get().state },
                  [("Ask", "ask"), ("Allow", "allow"), ("Block", "block")],
                  fn(next : String) -> Unit {
                    let s = signals::untracked(snap)
                    (cb.on_permission_change)(s.owner_pane, s.committed_origin, kind, next)
                  },
                )
              })
            },
          )
          site_setting_row(
            list,
            fn() { "Inspect Site Cookies" },
            "database",
            fn() { "Cookies" },
            fn() { site_info_cookies_label(snap().cookies_count) },
            fn() { (cb.on_open_cookies)(pane(), origin()) },
          )
          site_setting_row(
            list,
            fn() { "Open Page Zoom" },
            ICON_SEARCH,
            fn() { "Zoom" },
            fn() { "\{snap().zoom_percent}%" },
            fn() { (cb.on_open_zoom)(pane()) },
          )
        })
      })
    },
    footer=fn(fw : view::View, layer : view::View) -> Unit {
      let _ = fw.box(fn(bar : view::View) -> Unit {
        let _ = bar
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
        // The connection's state: opens (and closes) the connection detail.
        let _ = headless::button(
          bar,
          fn() { "Connection Details" },
          fn(_e) -> Unit { detail.set(!detail.untracked()) },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
            shell_press(b, fn() { btn.pressed() })
            let _ = b
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .height(view::Live::Is(Some(SP_32)))
            .padding(view::Live::Is((SP_10, SP_0, SP_12, SP_0)))
            .gap(view::Live::Is(SP_6))
            .radius(view::Live::Is(SP_8))
            .rigid()
            .ground(view::Live::By(fn() { shell_mix(site_conn_ground(snap()), site_conn_ink(snap()), 0.08 * hover_t()) }))
            let _ = shell_icon_by(
              b,
              fn() { if snap().idn_warning { ICON_ALERT_TRIANGLE } else { site_conn_icon(snap()) } },
              size=IC_MD,
              color_by=fn() { site_conn_ink(snap()) },
            )
            <ui::Text in={b} size={TX_BODY} weight={500} lines={1} color_by=>{site_conn_ink(snap())} text_by=>{site_conn_chip(snap())} />
          },
        )
        // More: what clears the site's state.
        let _ = shell_menu_node(
          bar,
          layer,
          fn() { more_open.get() },
          fn(v : Bool) -> Unit { more_open.set(v) },
          fn() { "More Site Actions" },
          fn(trig : view::View, disc : headless::Disclosure) -> Unit {
            let hover_t = shell_fade(trig, fn() { disc.open() || disc.hovered() })
            shell_press(trig, fn() { disc.pressed() })
            let _ = trig
            .width(view::Live::Is(Some(SP_32)))
            .height(view::Live::Is(Some(SP_32)))
            // (in the panel's corner: concentric with it)
            // (in the panel's corner: concentric with it; a full circle here breaks the corner ladder)
            .radius(view::Live::Is(lg::concentric(lg::r_card, POP_PANEL_PAD)))
            .rigid()
            .center()
            .ground(view::Live::By(fn() { shell_mix(mono_tile_ground(), lg::surface().ink, 0.06 * hover_t()) }))
            let _ = shell_icon(trig, ICON_MORE, size=IC_MD, color_by=fn() { lg::surface().ink })
          },
          fn() -> Array[lg::LiquidMenuEntry] {
            [
              lg::LiquidMenuEntry::item(label="Reset permissions", on_select=fn() { (cb.on_reset_permissions)(pane(), origin()) }),
              lg::LiquidMenuEntry::item(
                label="Clear site data",
                destructive=true,
                on_select=fn() { (cb.on_clear_site_data)(pane(), origin()) },
              ),
            ]
          },
          menu_label=fn() { "More Site Actions" },
          min_width=SP_160 + SP_40,
        )
      })
    },
    header_pad=(SP_0, SP_0, SP_0, SP_12),
  )
}

// ============================================================================
// IDNA Spoof Warning Popover (tag: "idn_popover")
// ============================================================================

pub struct IdnaSpoofSnapshot {
  pub unicode_host : String
  pub punycode_host : String
  pub warning_summary : String
  pub warning_detail : String
}

pub struct IdnaSpoofPopoverProps {
  pub open : () -> Bool
  pub snapshot : () -> IdnaSpoofSnapshot
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_close : () -> Unit
}

///| The amber lookalike-domain marker inside the address field. Unmounted (`show`) for ordinary hosts.
pub fn build_idna_spoof_capsule(
  parent : view::View,
  visible : () -> Bool,
  active : () -> Bool,
  on_press : () -> Unit,
) -> Unit {
  parent.show(visible, fn(wrap : view::View) -> Unit {
    let _ = wrap.rigid()
    let _ = headless::button(
      wrap,
      fn() { "IDN Spoofing Warning" },
      fn(_e) -> Unit { on_press() },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let hover_t = shell_fade(b, fn() { active() || btn.hovered() || btn.pressed() })
        // A 32pt pressable band (the address field's height) around the 24pt amber fill.
        let _ = b.keeps_held(view::Live::Is(true)).height(view::Live::Is(Some(SP_32))).rigid().center()
        let _ = b.box(fn(fill : view::View) -> Unit {
          let _ = fill
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(SP_24)))
          .gap(view::Live::Is(SP_4))
          .padding(view::Live::Is((SP_6, SP_0, SP_8, SP_0)))
          .radius(view::Live::Is(SP_6))
          .points(view::Live::Is(false))
          .ground(view::Live::By(fn() {
            // The amber fill deepens a little while hovered or open.
            lg::over(lg::surface().warning_bg, lg::alpha(lg::surface().warning_bg, hover_t()))
          }))
          let _ = shell_icon(fill, ICON_ALERT_TRIANGLE, size=IC_SM, color_by=fn() { lg::surface().warning })
          <ui::Text in={fill} size={TX_CAPTION} weight={500} color_by=>{lg::surface().warning} text="Lookalike" />
        })
      },
    )
  })
}

///| Builds the lookalike-domain warning (tag `"idn_popover"`): what the address looks like, what it
///| really is, and why it is shown in Punycode.
pub fn build_idna_spoof_popover(root : view::View, props : IdnaSpoofPopoverProps) -> Unit {
  let snap = props.snapshot
  pop_mount(
    root,
    props.open,
    props.on_close,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 * 2.0 + SP_40,
    "Lookalike Domain Warning",
    fn(hw : view::View, close : () -> Unit) -> Unit {
      pop_header(
        hw,
        fn(lw : view::View) -> Unit { pop_tile(lw, ICON_ALERT_TRIANGLE, tile_orange()) },
        false,
        fn() { "Lookalike domain" },
        fn() { "" },
        "Close IDN Warning",
        close,
      )
    },
    fn(panel : view::View) -> Unit {
      // Same text edge as the card labels and the footnote (card edge + SP_12).
      panel.show(fn() { snap().warning_summary != "" }, fn(sw : view::View) -> Unit {
        let _ = sw.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={sw} size={TX_BODY} wrap color_by=>{lg::surface().ink} text_by=>{snap().warning_summary} />
      })
      let _ = panel.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(SP_6)).rigid()
        pop_group(sec, fn(g : view::View) -> Unit {
          pop_addr_row(g, "Looks like", fn() { snap().unicode_host }, fn() { lg::surface().warning })
          pop_rule_flush(g)
          pop_addr_row(g, "Actual address", fn() { snap().punycode_host }, fn() { lg::surface().ink })
        })
        sec.show(fn() { snap().warning_detail != "" }, fn(fw : view::View) -> Unit {
          pop_footnote(fw, fn() { snap().warning_detail })
        })
      })
    },
  )
}

///| Label above value (an address) inside a group, no tile.
fn pop_addr_row(parent : view::View, label : String, value_by : () -> String, value_color : () -> Int64) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row.padding(view::Live::Is((SP_12, SP_10, SP_12, SP_10))).gap(view::Live::Is(SP_2)).rigid()
    <ui::Text in={row} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text={label} />
    <ui::Text in={row} size={TX_BODY} weight={500} wrap color_by=>{value_color()} text_by=>{value_by()} />
  })
}

///| Hairline for a group whose rows have no tile (inset to the text, `SP_12`).
fn pop_rule_flush(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((SP_12, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| An action as a text row of a group (accent for neutral actions, danger for destructive ones).
fn pop_action_row(
  parent : view::View,
  label : String,
  text : () -> String,
  color_by : () -> Int64,
  on_press : () -> Unit,
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .min_height(view::Live::Is(Some(SP_40)))
      .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      <ui::Text
        in={b}
        size={TX_BODY}
        lines={1}
        color_by=>{if disabled() { lg::surface().ink_tertiary } else { color_by() }}
        text_by=>{text()}
      />
    },
    disabled=disabled,
  )
}
