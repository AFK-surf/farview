///| Phase 3A unit & UI-craft audit suite for Settings, Reader Mode, Site Boosts, and DevTools panels.
///| Uses `ui::Tester` (`invar/tester`) to verify:
///| - Settings: 3-tab switching, per-category Clear Browsing Data callback preserving unchecked items, Light/Dark & narrow layout
///| - Reader Mode: paper theme (Light/Sepia/Night), font size stepper, typeface, column width, close callback, solid 0-glass surface
///| - Site Boosts: bound origin & pane, theme/font/scale/sticky/CSS draft save & reset callbacks, single-layer glass
///| - DevTools: Elements/Console/Network tabs, Copy as cURL, Docked (0-glass solid) <-> Floating (single-layer glass)
///|   seamless state preservation (selected DOM node, Network filter/query, Console REPL draft), Light/Dark & narrow layout.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn p3a_audit(t : ui::Tester, label : String, allow_large_overlay~ : Bool = false) -> Unit {
  t.set_a11y(true)
  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label=label, allow_large_overlay=allow_large_overlay)
  t.assert_scrollable(label=label)
  t.assert_contrast(label=label)
  let craft = t.ui_craft_audit()
  if craft.length() > 0 {
    let mut msg = "ui_craft_audit failed in \{label} (\{craft.length()} fault(s)):"
    for f in craft {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
  let a11y = t.a11y_faults()
  if a11y.length() > 0 {
    let mut msg = "a11y_faults in \{label} (\{a11y.length()}):"
    for f in a11y {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

fn p3a_sample_article() -> proto::ReaderArticle {
  let blocks : Array[proto::ReaderBlock] = [
    proto::ReaderBlock::{ kind: proto::ReaderBlockKind::Paragraph, level: 0, text: "Farview renders web documents with pure-Pion layout and retained GPU trees." },
    proto::ReaderBlock::{ kind: proto::ReaderBlockKind::Heading, level: 2, text: "Solid Reading Paper" },
    proto::ReaderBlock::{ kind: proto::ReaderBlockKind::Quote, level: 0, text: "Good reading typography stays calm and legible across daylight and night." },
    proto::ReaderBlock::{ kind: proto::ReaderBlockKind::ListItem, level: 0, text: "Three calibrated paper surfaces: Light, Sepia, and Night." },
    proto::ReaderBlock::{ kind: proto::ReaderBlockKind::Code, level: 0, text: "let col = proto::reader_column_width_pt(\"medium\")" },
  ]
  let title = "Retained GPU Reading Typography"
  let metrics = proto::compute_reader_metrics(blocks, title=title)
  proto::ReaderArticle::{
    url: "https://farview.dev/notes/reader",
    host: "farview.dev",
    title,
    byline: "Farview Engineering",
    read_minutes: metrics.read_minutes,
    word_count: metrics.word_count,
    blocks,
  }
}

