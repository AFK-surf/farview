test "phase3a: settings panel 8 categories, per-category clear browsing data, light/dark and narrow" {
  let open = signals::signal(true)
  let dark = signals::signal(false)
  let active_tab = signals::signal(SETTINGS_TAB_GENERAL)
  let settings = signals::signal_ref(proto::BrowserSettings::default())
  let clear_bookmarks = signals::signal(false)
  let clear_history = signals::signal(true)
  let clear_downloads = signals::signal(false)
  let clear_boosts = signals::signal(false)
  let filter_field = ui::Field::new()
  let last_clear : signals::Ref[Option[ClearBrowsingDataSelection]] = ui::ref_new(None)
  let last_import : signals::Ref[Option[proto::MigrateRequest]] = ui::ref_new(None)
  let mig_selected = signals::signal("arc:default")
  let mig_bm = signals::signal(true)
  let mig_hist = signals::signal(true)
  let mig_ext = signals::signal(true)
  let zoom_steps : Array[Int] = []

  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_settings_panel(
        root,
        SettingsPanelProps::{
          atc: None,
          open: fn() { open.get() },
          dark: fn() { dark.get() },
          active_tab,
          settings: fn() { settings.get() },
          clear_bookmarks,
          clear_history,
          clear_downloads,
          clear_boosts,
          filter_field: Some(filter_field),
          on_save_settings: fn(next_s, _msg) {
            settings.set(next_s)
            let is_d = next_s.chrome_theme == "dark"
            dark.set(is_d)
            lg::set_dark(Some(is_d))
          },
          on_step_zoom: fn(delta) { zoom_steps.push(delta) },
          on_clear_browsing_data: fn(sel) { last_clear.v = Some(sel) },
          on_close: fn() { open.set(false) },
          migrate: Some(SettingsMigrateProps::{
            sources: fn() {
              [
                proto::MigrateSourceInfo::{
                  id: "arc:default",
                  browser: "Arc",
                  profile_name: "Default",
                  profile_path: "",
                  has_bookmarks: true,
                  has_history: true,
                  has_spaces: true,
                  has_extensions: true,
                },
                proto::MigrateSourceInfo::{
                  id: "chrome:default",
                  browser: "Google Chrome",
                  profile_name: "Work",
                  profile_path: "",
                  has_bookmarks: true,
                  has_history: true,
                  has_spaces: false,
                  has_extensions: true,
                },
              ]
            },
            selected_id: mig_selected,
            import_bookmarks: mig_bm,
            import_history: mig_hist,
            import_extensions: mig_ext,
            busy: fn() { false },
            status_text: fn() { "" },
            on_refresh: fn() { () },
            on_import: fn(req) { last_import.v = Some(req) },
          }),
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  p3a_audit(t, "settings-general-light", allow_large_overlay=true)
  debug_assert(lg::count_liquid_glass(t) == 1, "settings dialog uses single-layer glass outer frame only")

  // General: step the default zoom
  t.press("Increase Default Zoom")
  debug_assert(zoom_steps.length() == 1 && zoom_steps[0] == 1, "zoom stepper callback invoked")

  // General: pick Google Chrome Work and trigger migration
  t.press("Import Source Google Chrome Work")
  t.frame(ms=16.0)
  t.press("Import from Chrome")
  t.frame(ms=16.0)
  match last_import.v {
    Some(req) => {
      debug_assert(req.source_id == "chrome:default" && req.import_bookmarks && req.import_history && req.import_extensions, "migration request emitted for selected browser")
    }
    None => debug_assert(false, "expected on_import callback")
  }

  // S3 shared keyword consistency: "150" matches Zoom card so empty state stays hidden; "zzz_none" shows empty state
  filter_field.set("150")
  t.frame(ms=16.0)
  debug_assert(t.rect_of("No matching settings in this section").is_none(), "filter '150' matches Zoom card without showing empty state")
  filter_field.set("zzz_none")
  t.frame(ms=16.0)
  debug_assert(t.rect_of("No matching settings in this section").is_some(), "unmatched filter shows empty state card")
  // A filter with no match on the open category moves to the first category that has one, and the empty state goes
  filter_field.set("cookies")
  t.frame(ms=16.0)
  debug_assert(active_tab.untracked() == SETTINGS_TAB_PRIVACY, "filter 'cookies' from General opens Privacy")
  debug_assert(t.rect_of("No matching settings in this section").is_none(), "after moving to Privacy the empty state is hidden")
  filter_field.set("")
  t.frame(ms=16.0)
  active_tab.set(SETTINGS_TAB_GENERAL)
  t.frame(ms=16.0)

  // Search: pick Kagi (checkmarked choice row); General's navigation row leads here too
  t.press("Show Search Settings")
  t.frame(ms=16.0)
  debug_assert(active_tab.untracked() == SETTINGS_TAB_SEARCH, "General's Search engine row opens Search")
  t.press("Search Engine Kagi")
  t.frame(ms=16.0)
  debug_assert(settings.untracked().search_engine == "kagi", "search engine updated to kagi")
  p3a_audit(t, "settings-search-light", allow_large_overlay=true)

  // Tabs: archive after 7 days
  t.press("Tabs")
  t.frame(ms=16.0)
  t.press("Auto-Archive 7 days")
  t.frame(ms=16.0)
  debug_assert(settings.untracked().auto_archive_hours == 168, "auto-archive set to 7 days")

  // Appearance tab: switch to Dark theme
  t.press("Appearance")
  t.frame(ms=16.0)
  debug_assert(active_tab.untracked() == SETTINGS_TAB_APPEARANCE, "active tab is Appearance")
  t.press("Theme Dark")
  t.frame(ms=16.0)
  debug_assert(dark.untracked(), "dark theme activated")
  p3a_audit(t, "settings-appearance-dark", allow_large_overlay=true)

  // Privacy & Data tab: check Bookmarks (History already checked, Downloads & Boosts unchecked)
  t.press("Privacy")
  t.frame(ms=16.0)
  debug_assert(active_tab.untracked() == SETTINGS_TAB_PRIVACY, "Privacy keeps tab index 2 (the app opens it by index)")
  t.press("HTTPS-only mode")
  t.frame(ms=16.0)
  debug_assert(settings.untracked().https_only, "HTTPS-only toggle saved")
  t.press("Bookmarks")
  t.press("Clear selected data")
  t.frame(ms=16.0)
  match last_clear.v {
    Some(sel) => {
      debug_assert(sel.bookmarks && sel.history, "checked categories passed as true")
      debug_assert(!sel.downloads && !sel.boosts, "unchecked categories preserved as false")
    }
    None => debug_assert(false, "expected on_clear_browsing_data callback")
  }
  p3a_audit(t, "settings-privacy-dark", allow_large_overlay=true)

  // Downloads: clearing the list sends downloads only
  t.press("Downloads")
  t.frame(ms=16.0)
  t.press("Clear Download List")
  t.frame(ms=16.0)
  match last_clear.v {
    Some(sel) => debug_assert(sel.downloads && !sel.bookmarks && !sel.history && !sel.boosts, "download list clear sends downloads only")
    None => debug_assert(false, "expected on_clear_browsing_data from Downloads")
  }

  // Shortcuts and About render as grouped lists
  t.press("Shortcuts")
  t.frame(ms=16.0)
  debug_assert(t.rect_of("Open address bar").is_some(), "Shortcuts lists the shortcut catalog")
  p3a_audit(t, "settings-shortcuts-dark", allow_large_overlay=true)
  t.press("About")
  t.frame(ms=16.0)
  debug_assert(t.rect_of("Farview").is_some(), "About shows the app name")
  p3a_audit(t, "settings-about-dark", allow_large_overlay=true)
  t.press("Privacy")
  t.frame(ms=16.0)

  // Narrow viewport adaptation (480x800)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  p3a_audit(t, "settings-narrow-480", allow_large_overlay=true)

  // IME double-Esc: first Escape clears preedit without closing; second Escape closes modal
  filter_field.focus()
  filter_field.compose("nihao")
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(open.untracked(), "first Escape during IME composition keeps Settings open")
  debug_assert(!filter_field.composing(), "first Escape cleared IME preedit")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!open.untracked(), "second Escape closes Settings modal")

  // Reopen and verify outside-click dismissal (`close_on_outside=true`)
  open.set(true)
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  t.click(12.0, 12.0)
  t.frame(ms=16.0)
  debug_assert(!open.untracked(), "outside click closes Settings modal")

  t.dispose()
  lg::set_dark(None)
}

test "phase3a: reader mode paper themes, typography controls, and zero-glass solid surface" {
  let open = signals::signal(true)
  let art = signals::signal_ref(p3a_sample_article())
  let rev = signals::signal(1)
  let theme = signals::signal("light")
  let font = signals::signal("serif")
  let font_size = signals::signal(17)
  let width_mode = signals::signal("medium")
  let progress = signals::signal(0.25)
  let closed = ui::ref_new(false)

  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_reader_mode_panel(
        root,
        ReaderModeProps::{
          open: fn() { open.get() },
          owner_pane: PaneId::Secondary,
          article: fn() { art.get() },
          rev: fn() { rev.get() },
          status: fn() { READER_STATUS_READY },
          theme: fn() { theme.get() },
          font: fn() { font.get() },
          font_size: fn() { font_size.get() },
          width_mode: fn() { width_mode.get() },
          progress: fn() { progress.get() },
          on_theme: fn(th) { theme.set(th) },
          on_font: fn(f) { font.set(f) },
          on_font_size: fn(sz) { font_size.set(sz) },
          on_width_mode: fn(w) { width_mode.set(w) },
          on_progress: fn(p) { progress.set(p) },
          on_close: fn() {
            closed.v = true
            open.set(false)
          },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  p3a_audit(t, "reader-light")
  debug_assert(lg::count_liquid_glass(t) == 0, "reader mode uses 100% solid reading paper (zero glass)")

  // Switch paper theme to Sepia and Night
  t.press("Reader Paper Theme Sepia")
  t.frame(ms=16.0)
  debug_assert(theme.untracked() == "sepia", "sepia theme callback applied")
  p3a_audit(t, "reader-sepia")

  t.press("Reader Paper Theme Night")
  t.frame(ms=16.0)
  debug_assert(theme.untracked() == "night", "night theme callback applied")
  p3a_audit(t, "reader-night")

  // Font size stepper + column width + typeface
  t.press("Increase Reader Font Size")
  t.frame(ms=16.0)
  debug_assert(font_size.untracked() == 19, "font size stepped 17 -> 19")

  t.press("Column Width Wide")
  t.frame(ms=16.0)
  debug_assert(width_mode.untracked() == "wide", "width mode updated to wide")

  t.press("Reader Font Mono")
  t.frame(ms=16.0)
  debug_assert(font.untracked() == "mono", "font updated to mono")

  // Close callback
  t.press("Exit Reader Mode")
  t.frame(ms=16.0)
  debug_assert(closed.v && !open.untracked(), "close callback invoked")

  t.dispose()
}

test "phase3a: site boosts bound origin save, custom css draft, and reset callbacks" {
  let open = signals::signal(true)
  let dark = signals::signal(false)
  let origin = signals::signal("www.docs.farview.dev")
  let boost = signals::signal_ref(proto::SiteBoost::default_for("www.docs.farview.dev"))
  let css_field = ui::Field::new()
  let js_field = ui::Field::new()
  let zap = signals::signal(false)
  let saved_origins : Array[String] = []
  let reset_origins : Array[String] = []
  let site_saves : Array[proto::SiteBoost] = []
  let opened : Array[String] = []
  let deleted : Array[String] = []
  let others = [
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("github.com"), enabled: true, theme: "dark" },
    proto::SiteBoost::{ ..proto::SiteBoost::default_for("news.ycombinator.com"), enabled: false, scale_pct: 115 },
  ]

  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_site_boosts_panel(
        root,
        SiteBoostsProps::{
          open: fn() { open.get() },
          dark: fn() { dark.get() },
          target_origin: fn() { origin.get() },
          owner_pane: fn() { PaneId::Primary },
          boost: fn() { boost.get() },
          css_field,
          anchor_top: fn() { 52.0 },
          accent_color: fn() { 0L },
          on_save: fn(orig, b) {
            saved_origins.push(orig)
            boost.set(b)
          },
          on_reset: fn(orig) {
            reset_origins.push(orig)
            boost.set(proto::SiteBoost::default_for(orig))
          },
          on_close: fn() { open.set(false) },
          on_css_edited: None,
          on_apply_css: None,
          js_field,
          zap_active: fn() { zap.get() },
          on_zap: fn(on) { zap.set(on) },
          all_boosts: fn() { others },
          on_site_save: fn(b) { site_saves.push(b) },
          on_site_open: fn(h) { opened.push(h) },
          on_site_delete: fn(h) { deleted.push(h) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  p3a_audit(t, "boosts-light", allow_large_overlay=true)
  debug_assert(lg::count_liquid_glass(t) == 1, "site boosts uses single-layer glass outer frame only")

  // Dark (the lightbulb), then the fine controls: invert, another theme, hiding pop-ups.
  t.press("Boost Theme Dark")
  t.frame(ms=16.0)
  debug_assert(saved_origins.length() == 1 && saved_origins[0] == "www.docs.farview.dev", "saved for canonical bound origin preserving www.")
  debug_assert(boost.untracked().enabled && boost.untracked().theme == "dark", "boost enabled with dark theme")
  debug_assert(t.get("Invert colors").is_none(), "fine controls start closed")
  t.press("Fine Color Controls")
  t.frame(ms=16.0)
  t.press("Invert colors")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().invert, "invert on")
  t.press("Hide pop-ups and banners")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().hide_sticky, "pop-ups hidden")
  t.press("Boost Theme Sepia")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().theme == "sepia", "sepia from the fine controls")
  p3a_audit(t, "boosts-fine", allow_large_overlay=true)
  t.press("Fine Color Controls")
  t.frame(ms=16.0)

  // Colors on the canvas: dragging the tint's handle saves the canvas color under it on release; the second color
  // has its own handle; no color clears both.
  match t.get("Boost Tint") {
    Some(d) => {
      let (hx, hy) = (d.x + d.w / 2.0, d.y + d.h / 2.0)
      t.drag(hx, hy, hx - 60.0, hy + 20.0, steps=6)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "tint handle on the canvas")
  }
  let tint = boost.untracked().tint
  debug_assert(tint != "" && proto::normalize_boost_tint(tint) == tint, "tint saved from the canvas: " + tint)
  match t.get("Boost Second Color") {
    Some(d) => {
      let (hx, hy) = (d.x + d.w / 2.0, d.y + d.h / 2.0)
      t.drag(hx, hy, hx + 30.0, hy - 40.0, steps=6)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "second color handle on the canvas")
  }
  debug_assert(boost.untracked().tint2 != "" && boost.untracked().tint == tint, "second color saved on its own")
  p3a_audit(t, "boosts-colors-tint", allow_large_overlay=true)
  t.press("Remove Boost Colors")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().tint == "" && boost.untracked().tint2 == "", "no color clears both")

  // Typefaces, Size and Case.
  t.press("Boost Font Serif")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().font == "serif", "a typeface from the grid")
  t.press("Boost Font Slab")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().font == "slab", "another typeface replaces it")
  // (only typefaces the panel draws apart are in the grid)
  debug_assert(t.get("Boost Font Didone").is_none(), "a look-alike sample is not offered")
  t.press("Boost Font Slab")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().font == "default", "the chosen typeface again goes back to the page's own")
  t.press("Boost Text Size")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().scale_pct == 110, "Size steps the text up")
  t.press("Boost Letter Case")
  t.press("Boost Letter Case")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().text_case == "upper", "Case cycles none, lowercase, uppercase")
  p3a_audit(t, "boosts-fonts", allow_large_overlay=true)

  // Zap: the row turns it on and lists what is hidden; restore one, restore all; Escape ends Zap first.
  t.press("Zap Elements")
  t.frame(ms=16.0)
  debug_assert(zap.untracked(), "zap mode turned on")
  boost.set(proto::SiteBoost::{ ..boost.untracked(), zapped: ["#onetrust-banner-sdk", "aside.promo"] })
  t.frame(ms=16.0)
  p3a_audit(t, "boosts-zap", allow_large_overlay=true)
  t.press("Restore aside.promo")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().zapped.length() == 1 && boost.untracked().zapped[0] == "#onetrust-banner-sdk", "one zapped element restored")
  t.press("Restore All Zapped")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().zapped.length() == 0, "all zapped elements restored")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!zap.untracked() && open.untracked(), "Escape ends Zap and keeps the panel")

  // Code: custom CSS and JS on their page.
  t.press("Edit Boost Code")
  t.frame(ms=16.0)
  css_field.set("body { max-width: 70ch; }")
  t.press("Apply Custom CSS")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().custom_css == "body { max-width: 70ch; }", "custom CSS draft saved")
  js_field.set("document.body.dataset.boosted = '1';")
  t.press("Apply Custom JavaScript")
  t.frame(ms=16.0)
  debug_assert(boost.untracked().custom_js == "document.body.dataset.boosted = '1';", "custom JS saved")
  p3a_audit(t, "boosts-code", allow_large_overlay=true)
  t.press("Back to Boost")
  t.frame(ms=16.0)

  // All Boosts (the name's chevron): toggle, open, delete, back
  t.press("Show All Boosts")
  t.frame(ms=16.0)
  // (the page pushes in over MO_POP_MS: audited at rest)
  t.frame(ms=200.0)
  p3a_audit(t, "boosts-sites", allow_large_overlay=true)
  t.press("Boost news.ycombinator.com")
  // (Open and Delete sit in each row's More menu, so the host keeps the room)
  t.press("More for github.com")
  t.frame(ms=160.0)
  t.press("Open github.com")
  t.frame(ms=160.0)
  t.frame(ms=16.0)
  t.press("More for github.com")
  t.frame(ms=160.0)
  t.press("Delete Boost")
  t.frame(ms=160.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Confirm Delete Boost for github.com").is_some(), "Delete asks in the row")
  debug_assert(t.get("Delete Boost").is_none(), "the menu closes on a choice")
  debug_assert(deleted.length() == 0, "delete asks once more before it drops the boost")
  t.press("Keep Boost for github.com")
  t.frame(ms=16.0)
  debug_assert(deleted.length() == 0, "Cancel keeps the boost")
  t.press("More for github.com")
  t.frame(ms=160.0)
  t.press("Delete Boost")
  t.frame(ms=160.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Confirm Delete Boost for github.com").is_some(), "Delete asks again")
  t.press("Confirm Delete Boost for github.com")
  t.frame(ms=16.0)
  debug_assert(site_saves.length() == 1 && site_saves[0].host == "news.ycombinator.com" && site_saves[0].enabled, "site toggled on from the list")
  debug_assert(opened.length() == 1 && opened[0] == "github.com", "site opened from the list: " + opened.join(","))
  debug_assert(deleted.length() == 1 && deleted[0] == "github.com", "site boost deleted from the list: " + deleted.join(","))
  t.press("Back to Boost")
  t.frame(ms=16.0)

  // Reset asks once more in place: nothing goes until it is confirmed; Cancel keeps the boost.
  // Each button's name starts with its visible words; the line under the header says which site and what goes;
  // the keyboard comes to Cancel and goes back to Reset.
  let confirm_name = "Reset Boost for " + proto::normalize_boost_host("www.docs.farview.dev")
  let has_focus = fn(name : String) -> Bool {
    match (ui::view_tree(), t.get(name)) {
      (Some(tr), Some(d)) => match tr.focused_now().0 {
        Some(f) => f.at == d.id.at
        None => false
      }
      _ => false
    }
  }
  t.press("Reset Site Boost")
  t.frame(ms=16.0)
  debug_assert(reset_origins.length() == 0 && t.get(confirm_name).is_some(), "Reset asks before it resets (\{confirm_name})")
  debug_assert(t.get("Reset Site Boost").is_none(), "the question takes the reset button's place")
  debug_assert(t.get("Close Site Boosts").is_some(), "the panel can still be closed while it asks")
  debug_assert(t.find("loses its Boost: its colors, code and hidden elements.").is_some(), "the danger caption names what goes")
  debug_assert(has_focus("Cancel"), "the keyboard comes to Cancel")
  t.press("Cancel")
  t.frame(ms=16.0)
  debug_assert(reset_origins.length() == 0 && t.get("Reset Site Boost").is_some(), "Cancel keeps the boost")
  debug_assert(has_focus("Reset Site Boost"), "the keyboard goes back to Reset")
  t.press("Reset Site Boost")
  t.frame(ms=16.0)
  t.press(confirm_name)
  t.frame(ms=16.0)
  debug_assert(reset_origins.length() == 1 && reset_origins[0] == "www.docs.farview.dev", "reset callback received canonical bound origin")
  debug_assert(css_field.text() == "" && js_field.text() == "", "code fields cleared on reset")

  // Empty origin (file:// / about:blank) MUST emit 0 save/reset callbacks
  origin.set("")
  t.frame(ms=16.0)
  let saved_before = saved_origins.length()
  let reset_before = reset_origins.length()
  t.press("Reset Site Boost")
  t.press("Boost Theme Dark")
  t.press("Boost Font Serif")
  t.press("Boost Text Size")
  // (a page that cannot be boosted: the fine controls and Code do not open, nothing in them looks live)
  t.press("Fine Color Controls")
  t.frame(ms=200.0)
  debug_assert(t.get("Boost Theme Sepia").is_none() && t.get("Invert colors").is_none(), "no fine controls without an origin")
  t.press("Edit Boost Code")
  t.frame(ms=200.0)
  debug_assert(t.get("Apply Custom CSS").is_none(), "Code does not open without an origin")
  t.press("Back to Boost")
  t.frame(ms=16.0)
  debug_assert(saved_origins.length() == saved_before, "empty origin emitted 0 save callbacks")
  debug_assert(reset_origins.length() == reset_before, "empty origin emitted 0 reset callbacks")

  // Restore origin for Dark mode audit, then a narrow window
  origin.set("www.docs.farview.dev")
  dark.set(true)
  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  p3a_audit(t, "boosts-dark", allow_large_overlay=true)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  p3a_audit(t, "boosts-dark-narrow", allow_large_overlay=true)
  lg::assert_apple_ui(t, label="boosts-dark-narrow", allow_large_overlay=true)

  // Escape closes the panel when nothing else is pending
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!open.untracked(), "Escape closes Site Boosts")

  t.dispose()
  lg::set_dark(None)
}

test "phase3a: devtools 3 tabs, copy as curl, and docked<->floating state preservation" {
  let open = signals::signal(true)
  let dark = signals::signal(false)
  let snap = signals::signal_ref(p3a_sample_devtools_snapshot())
  let rev = signals::signal(1)
  let st = DevToolsPanelState::new()
  let inspected : Array[String] = []
  let evaluated : Array[String] = []
  let copied_curls : Array[String] = []
  let cleared = ui::ref_new(0)

  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      let _ = root.box(fn(spacer : view::View) -> Unit { let _ = spacer.fill() })
      build_devtools_panel(
        root,
        DevToolsPanelProps::{
          open: fn() { open.get() },
          dark: fn() { dark.get() },
          owner_pane: fn() { PaneId::Primary },
          snapshot: fn() { snap.get() },
          rev: fn() { rev.get() },
          state: st,
          on_inspect: fn(p) { inspected.push(p) },
          on_eval: fn(expr) { evaluated.push(expr) },
          on_clear_console: fn() { cleared.v = cleared.v + 1 },
          on_copy_curl: fn(cmd) { copied_curls.push(cmd) },
          on_refresh: fn() { rev.set(rev.untracked() + 1) },
          on_close: fn() { open.set(false) },
          on_presentation_change: None,
          anchor_top: fn() { 44.0 },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Docked mode MUST be 100% solid (0 glass nodes)
  p3a_audit(t, "devtools-docked-elements-light")
  debug_assert(lg::count_liquid_glass(t) == 0, "docked DevTools is solid window chrome (zero glass)")

  // Select DOM node <main>
  t.press("Inspect <main>")
  t.frame(ms=16.0)
  debug_assert(st.selected_path.untracked() == "0.0", "selected DOM node path stored")
  debug_assert(inspected.length() == 1 && inspected[0] == "0.0", "on_inspect fired")

  // Switch to Console, type REPL draft (do not submit yet), test Clear
  t.press("DevTools Tab Console")
  t.frame(ms=16.0)
  st.repl_field.set("document.title")
  t.press("Clear Console Output")
  debug_assert(cleared.v == 1, "on_clear_console invoked")
  p3a_audit(t, "devtools-docked-console-light")

  // Switch to Network, set filter + search query, select request, test Copy as cURL
  t.press("DevTools Tab Network")
  t.frame(ms=16.0)
  t.press("Filter Network Fetch")
  st.net_search_field.set("sync")
  st.net_query.set("sync")
  t.frame(ms=16.0)
  t.press("Inspect request sync.json")
  t.frame(ms=16.0)
  t.press("Copy as cURL")
  debug_assert(copied_curls.length() == 1 && copied_curls[0].contains("https://api.farview.dev/v1/sync"), "Copy as cURL emitted valid curl command")
  p3a_audit(t, "devtools-docked-network-light")

  // Switch Docked -> Floating: single-layer glass, ALL state preserved!
  t.press("Float DevTools")
  t.frame(ms=16.0)
  debug_assert(st.presentation.untracked() is DevToolsPresentation::Floating, "presentation switched to Floating")
  debug_assert(lg::count_liquid_glass(t) == 1, "floating DevTools uses single-layer glass outer frame only")
  debug_assert(st.selected_path.untracked() == "0.0", "selected DOM node preserved across Docked -> Floating")
  debug_assert(st.net_filter.untracked() == "fetch", "Network filter preserved across Docked -> Floating")
  debug_assert(st.net_search_field.text() == "sync", "Network search query preserved across Docked -> Floating")
  debug_assert(st.repl_field.text() == "document.title", "Console REPL draft preserved across Docked -> Floating")
  p3a_audit(t, "devtools-floating-network-light", allow_large_overlay=true)

  // Switch back to Console in Floating mode and submit the preserved REPL draft!
  t.press("DevTools Tab Console")
  t.frame(ms=16.0)
  // Let the segmented control's press lens (a transient glass droplet) finish fading before auditing.
  t.frame(ms=600.0)
  t.press("Run Console Expression")
  debug_assert(evaluated.length() == 1 && evaluated[0] == "document.title", "preserved REPL draft evaluated")

  // Dark + narrow viewport audit, then Floating -> Docked
  dark.set(true)
  lg::set_dark(Some(true))
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  p3a_audit(t, "devtools-floating-dark-narrow", allow_large_overlay=true)

  t.press("Dock DevTools")
  t.frame(ms=16.0)
  debug_assert(st.presentation.untracked() is DevToolsPresentation::Docked, "presentation returned to Docked")
  debug_assert(lg::count_liquid_glass(t) == 0, "re-docked DevTools returns to 0-glass solid surface")

  t.dispose()
  lg::set_dark(None)
}

test "phase3a_r1: Elements DOM leaf alignment, ordinary attrs, border readout, Console typed colors, and Network category-only filter redraw" {
  // 1. Ordinary attributes in dt_dom_summary
  let img_nd = proto::DevToolsDomNode::{
    path: "0.0.1",
    depth: 2,
    tag: "img",
    id_attr: "",
    class_attr: "",
    attrs: [proto::DevToolsAttr::{ name: "alt", value: "site logo" }],
    text_preview: "",
    child_count: 0,
  }
  let img_sum = dt_dom_summary(img_nd, false)
  debug_assert(img_sum.contains("alt=\"site logo\""), "ordinary attribute present in dt_dom_summary: " + img_sum)

  // 2. Console typed result colors are distinct for string / number / boolean
  let c_str = dt_console_result_color("\"hello\"", false)
  let c_num = dt_console_result_color("42", false)
  let c_bool = dt_console_result_color("true", false)
  debug_assert(c_str != c_num && c_num != c_bool && c_str != c_bool, "console typed result colors are distinct")

  // 3. Elements leaf alignment (child leaf x > parent x, sibling leaf x == sibling branch x) + Network category-only redraw
  let snap_data = proto::DevToolsSnapshot::{
    ..p3a_sample_devtools_snapshot(),
    nodes: [
      proto::DevToolsDomNode::{ path: "0", depth: 0, tag: "html", id_attr: "", class_attr: "", attrs: [], text_preview: "", child_count: 2 },
      proto::DevToolsDomNode::{ path: "0.0", depth: 1, tag: "head", id_attr: "", class_attr: "", attrs: [], text_preview: "", child_count: 1 },
      proto::DevToolsDomNode::{ path: "0.0.0", depth: 2, tag: "meta", id_attr: "", class_attr: "", attrs: [proto::DevToolsAttr::{ name: "charset", value: "utf-8" }], text_preview: "", child_count: 0 },
      proto::DevToolsDomNode::{ path: "0.1", depth: 1, tag: "footer", id_attr: "", class_attr: "", attrs: [], text_preview: "", child_count: 0 },
    ],
  }
  let open = signals::signal(true)
  let dark = signals::signal(false)
  let snap = signals::signal_ref(snap_data)
  let rev = signals::signal(1)
  let st = DevToolsPanelState::new()

  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      let _ = root.box(fn(spacer : view::View) -> Unit { let _ = spacer.fill() })
      build_devtools_panel(
        root,
        DevToolsPanelProps::{
          open: fn() { open.get() },
          dark: fn() { dark.get() },
          owner_pane: fn() { PaneId::Primary },
          snapshot: fn() { snap.get() },
          rev: fn() { rev.get() },
          state: st,
          on_inspect: fn(_p) { () },
          on_eval: fn(_e) { () },
          on_clear_console: fn() { () },
          on_copy_curl: fn(_c) { () },
          on_refresh: fn() { () },
          on_close: fn() { open.set(false) },
          on_presentation_change: None,
          anchor_top: fn() { 77.0 },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  let head_b = match t.get("Inspect <head>") { Some(b) => b; None => panic("missing Inspect <head>") }
  let meta_b = match t.get("Inspect <meta>") { Some(b) => b; None => panic("missing Inspect <meta>") }
  let foot_b = match t.get("Inspect <footer>") { Some(b) => b; None => panic("missing Inspect <footer>") }
  debug_assert(meta_b.x > head_b.x + 10.0, "leaf child <meta> indented right of parent <head>")
  debug_assert((foot_b.x - head_b.x).abs() < 0.5, "sibling leaf <footer> aligns exactly with sibling branch <head>")

  // Network category-only filter redraw (no search query or rev change)
  t.press("DevTools Tab Network")
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect request index.html").is_some() && t.get("Inspect request sync.json").is_some(), "initial mixed requests visible")
  t.press("Filter Network Fetch")
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect request sync.json").is_some() && t.get("Inspect request index.html").is_none(), "Fetch filter hides Doc row immediately")
  t.press("Filter Network Doc")
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect request index.html").is_some() && t.get("Inspect request sync.json").is_none(), "Doc filter hides Fetch row immediately")
  t.press("Filter Network All")
  t.frame(ms=16.0)
  debug_assert(t.get("Inspect request index.html").is_some() && t.get("Inspect request sync.json").is_some(), "All filter restores both rows")

  t.dispose()
  lg::set_dark(None)
}

test "shell3 devtools: 32pt tree rows, 24pt resize strip, quiet filters, narrow request back chevron" {
  let open = signals::signal(true)
  let snap = signals::signal_ref(p3a_sample_devtools_snapshot())
  let st = DevToolsPanelState::new()
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      let _ = root.box(fn(spacer : view::View) -> Unit { let _ = spacer.fill() })
      build_devtools_panel(
        root,
        DevToolsPanelProps::{
          open: fn() { open.get() },
          dark: fn() { false },
          owner_pane: fn() { PaneId::Primary },
          snapshot: fn() { snap.get() },
          rev: fn() { 1 },
          state: st,
          on_inspect: fn(_p) { () },
          on_eval: fn(_e) { () },
          on_clear_console: fn() { () },
          on_copy_curl: fn(_c) { () },
          on_refresh: fn() { () },
          on_close: fn() { open.set(false) },
          on_presentation_change: None,
          anchor_top: fn() { 40.0 },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)

  // Every tree row's press target is at least 32pt tall.
  let row_b = match t.get("Inspect <html>") { Some(b) => b; None => panic("missing Inspect <html>") }
  debug_assert(row_b.h >= 31.5, "tree row hit target >= 32pt, got \{row_b.h}")

  // The resize drag target is a 24pt strip straddling the 8pt gap; a drag starting above the gap resizes.
  let grip = match t.get("Resize DevTools") { Some(b) => b; None => panic("missing Resize DevTools") }
  debug_assert(grip.h >= 23.5, "resize hit strip >= 24pt, got \{grip.h}")
  let h0 = st.height.untracked()
  let gx = grip.x + grip.w / 2.0
  t.drag(gx, grip.y + 2.0, gx, grip.y - 60.0)
  t.frame(ms=16.0)
  debug_assert(st.height.untracked() > h0 + 30.0, "dragging from the strip's top edge grows DevTools")
  debug_assert(!st.dragging.untracked(), "drag ends")

  // Second-level filters stay pressable by their labels and report selection.
  t.press("DevTools Tab Console")
  t.frame(ms=16.0)
  t.press("Filter Console Errors")
  t.frame(ms=16.0)
  debug_assert(st.console_filter.untracked() == 3, "console level filter selects Errors")
  let errs = match t.get("Filter Console Errors") { Some(b) => b; None => panic("missing Filter Console Errors") }
  debug_assert(errs.h >= 31.5, "filter hit target >= 32pt")
  t.press("Filter Console All")
  t.frame(ms=600.0)
  lg::assert_apple_ui(t, label="devtools-shell3-console")

  // Narrow: an open request replaces the list, its filters and summary; a back chevron returns.
  t.press("DevTools Tab Network")
  t.frame(ms=16.0)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(t.get("Filter Network Requests").is_some(), "narrow list shows its filter field")
  t.press("Inspect request index.html")
  t.frame(ms=16.0)
  debug_assert(t.get("Filter Network Requests").is_none(), "narrow inspector hides the list's filter field")
  debug_assert(t.get("Filter Network All").is_none(), "narrow inspector hides the type filter")
  let back = match t.get("Close Request Inspector") { Some(b) => b; None => panic("missing back chevron") }
  let copy = match t.get("Copy as cURL") { Some(b) => b; None => panic("missing Copy as cURL") }
  debug_assert(back.x < copy.x, "back chevron leads the inspector header")
  t.press("Close Request Inspector")
  t.frame(ms=16.0)
  debug_assert(st.net_selected_idx.untracked() == -1, "back returns to the list")
  debug_assert(t.get("Filter Network All").is_some(), "list filters return")
  lg::assert_apple_ui(t, label="devtools-shell3-network-narrow")

  t.dispose()
  lg::set_dark(None)
}

test "settings: shortcut labels are sentence case, start page monograms come from titles" {
  debug_assert(sp_action_label("Focus Address Bar") == "Focus address bar", "plain words lowercased")
  debug_assert(sp_action_label("Toggle DevTools") == "Toggle DevTools", "DevTools keeps its spelling")
  debug_assert(sp_action_label("Save Page as PDF") == "Save page as PDF", "acronyms stay")
  debug_assert(sp_action_label("Site Info & Cookies") == "Site info and cookies", "ampersand spelled out")
  debug_assert(sp_action_label("Arc Boosts") == "Arc boosts", "Arc is a name")
  debug_assert(startpage_monogram("Wikipedia", "en.wikipedia.org", "E") == "W", "title wins over host")
  debug_assert(startpage_monogram("  mdn web docs", "developer.mozilla.org", "D") == "M", "trimmed, uppercased")
  debug_assert(startpage_monogram("", "github.com", "") == "G", "empty title falls back to host")
  debug_assert(startpage_monogram("— ", "", "X") == "X", "no letter and no host uses the given monogram")
}
