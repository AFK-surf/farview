///| Solid-filled macOS Settings & shell icons on a 24x24 viewBox (even-odd vector fills).
///| Kept inside `shell_ui` so `deps/invar` stays untouched.

import "paint"

fn fi_scaled(pts : Array[Double], scale : Double) -> Array[Double] {
  let out : Array[Double] = []
  for p in pts {
    out.push(p * scale)
  }
  out
}

pub fn shell_filled_icon_shapes(name : String, scale : Double, ink : Int64) -> Option[Array[paint::Shape]] {
