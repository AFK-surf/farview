///| The one command palette look (Arc's Cmd+T bar), shared by the address palette (Cmd+L / Cmd+T,
///| `shell_frame.pion`) and the Command Bar (Cmd+K, `command_search_panel.pion`):
///| - a large frameless field (`TX_TITLE3`, "Search or Enter URL…") with the search glyph leading and an info
///|   button at the trailing edge that shows the keyboard hints;
///| - no section captions: rows arrive ranked, one list;
///| - single-line 48pt rows: the site's own icon (`shell_favicon_tile`) or a monochrome command glyph, the title,
///|   and a trailing action ("Switch to Tab" + an arrow pill) in tertiary ink;
///| - exactly one highlighted row, the selected one, filled with the active Space's color (deepened until white
///|   text reads on it) with white text and a white arrow pill. The pointer moves the selection (no second hover
///|   wash), so what is lit is what Enter runs.

import "headless"
import "lg"
import "signals"
import "ui"
import "view"

///| The palette's quiet ink (trailing actions, a site's host, shortcuts): Arc's tertiary gray, the darkest such gray
///| that still reads at 4.5:1 on the palette's solid card.
pub fn shell_palette_ink_quiet(dark : Bool) -> Int64 {
  let _ = dark
  lg::alpha(lg::surface().ink, 0.66)
}

///| Row height of the palette (Arc's ~48pt single-line rows).
pub let PALETTE_ROW_H : Double = 48.0 // SP_48

///| Selected-row fill: the active Space's color, deepened toward black until white text on it reaches 4.5:1
///| (Arc fills the selected row with the Space theme color). Always opaque.
pub fn shell_palette_selected(model : ShellModel) -> Int64 {
  shell_palette_fill_for(shell_space_accent(model))
}

///| The selected-row fill for an accent (see `shell_palette_selected`).
pub fn shell_palette_fill_for(accent : Int64) -> Int64 {
  let base = (accent & 0xFFFFFF00L) | 0xFFL
  let mut c = base
  let mut i = 0
  while i < 12 && ui::contrast_ratio(c, 0xFFFFFFFFL) < 4.5 {
    i += 1
    c = shell_mix(base, 0x000000FFL, 0.06 * i.to_double())
  }
  c
}

///| The palette's field row: search glyph, a large frameless single-line field, and the info button.
///| `info_open` / `on_info` drive the keyboard-hints footer; the field keeps the focus when it is pressed.
pub fn shell_palette_field_row(
  parent : view::View,
  field : ui::Field,
  placeholder : String,
  label : String,
  info_open : () -> Bool,
  on_info : () -> Unit,
  submitted~ : (String) -> Unit = fn(_s) { () },
  edited? : (String) -> Unit,
  setup~ : (view::View) -> Unit = fn(_v) { () },
) -> Unit {
  let _ = parent.box(fn(in_row : view::View) -> Unit {
    let _ = in_row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_48 + SP_8)))
    .rigid()
    .gap(view::Live::Is(SP_12))
    // SP_12 trailing: the info button's circle then sits >= the panel's corner radius in from its corner.
    .padding(view::Live::Is((SP_16, SP_0, SP_12, SP_0)))
    setup(in_row)
    let _ = shell_icon(in_row, ICON_SEARCH, size=IC_LG, color_by=fn() { lg::surface().ink })
    let _ = in_row.box(fn(fw : view::View) -> Unit {
      let _ = fw
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_0)))
      .height(view::Live::Is(Some(SP_32)))
      .clips(view::Live::Is(true))
      let _ = ui::field(
        fw,
        field,
        placeholder=placeholder,
        font_size=TX_TITLE3,
        max_lines=1,
        enter_sends=true,
        label=label,
        colors_by=fn() { (lg::surface().ink, shell_palette_ink_quiet(lg::is_dark()), lg::surface().accent) },
        submitted=submitted,
        edited?=edited,
      )
    })
    let _ = headless::button(
      in_row,
      fn() { if info_open() { "Hide Keyboard Hints" } else { "Keyboard Hints" } },
      fn(_e) -> Unit {
        on_info()
        field.focus()
      },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
        let _ = b.width(view::Live::Is(Some(SP_40))).height(view::Live::Is(Some(SP_40))).rigid().center()
        let _ = b.box(fn(face : view::View) -> Unit {
          let _ = face
          .width(view::Live::Is(Some(SP_32)))
          .height(view::Live::Is(Some(SP_32)))
          .radius(view::Live::Is(SP_16))
          .points(view::Live::Is(false))
          .center()
          .ground(view::Live::By(fn() {
            if info_open() {
              lg::surface().card_secondary
            } else {
              lg::over(lg::surface().card, lg::alpha(lg::surface().row_hover, hover_t()))
            }
          }))
          .shadow(view::Live::By(fn() { shell_row_lift(lg::is_dark()) }))
          shell_press(face, fn() { btn.pressed() })
          shell_focus_ring(face, fn() { btn.focus_shown() }, SP_16)
          let _ = shell_icon(face, ICON_INFO, size=IC_LG, color_by=fn() { lg::surface().ink_secondary })
        })
      },
    )
  })
}

///| Hairline under the field (inset like Arc's).
pub fn shell_palette_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((SP_8, SP_0, SP_8, SP_6)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| The leading 24pt glyph for a row that is not a site: a monochrome glyph on a quiet plate (white over the
///| selected fill).
pub fn shell_palette_glyph(parent : view::View, icon_by : () -> String, selected : () -> Bool) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(SP_24)))
    .height(view::Live::Is(Some(SP_24)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(SP_24)))
    .ground(view::Live::By(fn() { if selected() { 0xFFFFFF33L } else { lg::surface().card_secondary } }))
    .points(view::Live::Is(false))
    .center()
    let _ = shell_icon_by(tile, icon_by, size=IC_MD, color_by=fn() {
      if selected() { 0xFFFFFFFFL } else { lg::surface().ink_secondary }
    })
  })
}

///| What a palette row shows.
pub struct PaletteRowSpec {
  ///| Accessible name (usually the title).
  label : () -> String
  title : () -> String
  ///| Quiet text after the title (a site's host); "" for none.
  detail : () -> String
  ///| The trailing action ("Switch to Tab", "Open", "Search"); "" for none (then `hint` shows, if any).
  action : () -> String
  ///| A keyboard shortcut shown at the trailing edge of a row without an action ("⌘D").
  hint : () -> String
  ///| Draws the 24pt leading tile; told whether the row is selected.
  leading : (view::View, () -> Bool) -> Unit
}

///| One palette row: a 48pt single-line button whose whole box is the press target and the only highlight.
///| `selected` lights it; `on_point` is told when the pointer really moves over it (not when results slide under
///| a still pointer), so the host moves the selection there without committing.
pub fn shell_palette_row(
  parent : view::View,
  model : ShellModel,
  spec : PaletteRowSpec,
  selected : () -> Bool,
  on_press : () -> Unit,
  on_point : () -> Unit,
  radius~ : Double = SP_10,
) -> view::View {
  let white = 0xFFFFFFFFL
  let row_v = headless::button(
    parent,
    spec.label,
    fn(_e) -> Unit { on_press() },
    fn(row : view::View, _btn : headless::Button) -> Unit {
      let _ = row
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(PALETTE_ROW_H)))
      .rigid()
      // SP_16 each side: the tile and the arrow pill sit at least the row's (and the panel's) corner radius in from
      // its corners, so their own corners never fight the outer ones.
      .padding(view::Live::Is((SP_16, SP_0, SP_16, SP_0)))
      .gap(view::Live::Is(SP_12))
      .radius(view::Live::Is(radius))
      .ground(view::Live::By(fn() { if selected() { shell_palette_selected(model) } else { 0x00000000L } }))
      .focus_ring_theme()
      let _ = row.box(fn(lead : view::View) -> Unit {
        let _ = lead.rigid().center()
        (spec.leading)(lead, selected)
      })
      let _ = row.box(fn(tw : view::View) -> Unit {
        let _ = tw
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(SP_0)))
        .min_width(view::Live::Is(Some(SP_0)))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_8))
        .cut()
        let _ = tw.box(fn(t1 : view::View) -> Unit {
          let _ = t1.min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(1.0)).cut()
          let _ = <ui::Text
            in={t1}
            size={TX_CALLOUT}
            weight={500}
            color_by=>{if selected() { white } else { lg::surface().ink }}
            text_by=>{(spec.title)()}
          />.allow_ellipsis(view::Live::Is(true))
        })
        tw.show(fn() { (spec.detail)() != "" }, fn(t2 : view::View) -> Unit {
          let _ = t2.min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(10.0)).cut()
          let _ = <ui::Text
            in={t2}
            size={TX_BODY}
            color_by=>{if selected() { lg::alpha(white, 0.9) } else { shell_palette_ink_quiet(lg::is_dark()) }}
            text_by=>{(spec.detail)()}
          />.allow_ellipsis(view::Live::Is(true))
        })
      })
      row.show(fn() { (spec.action)() != "" }, fn(act : view::View) -> Unit {
        let _ = act.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_12)).rigid()
        let _ = <ui::Text
          in={act}
          size={TX_CALLOUT}
          weight={500}
          color_by=>{if selected() { white } else { shell_palette_ink_quiet(lg::is_dark()) }}
          text_by=>{(spec.action)()}
        />
        let _ = act.box(fn(pill : view::View) -> Unit {
          let _ = pill
          .width(view::Live::Is(Some(SP_32)))
          .height(view::Live::Is(Some(SP_32)))
          .rigid()
          .center()
          .radius(view::Live::Is(SP_6))
          .points(view::Live::Is(false))
          .ground(view::Live::By(fn() { if selected() { white } else { lg::surface().card_secondary } }))
          let _ = shell_icon(pill, ICON_ARROW_RIGHT, size=IC_LG, color_by=fn() {
            if selected() { shell_palette_selected(model) } else { shell_palette_ink_quiet(lg::is_dark()) }
          })
        })
      })
      row.show(fn() { (spec.action)() == "" && (spec.hint)() != "" }, fn(h : view::View) -> Unit {
        let _ = h.rigid()
        let _ = <ui::Text
          in={h}
          size={TX_BODY}
          weight={500}
          color_by=>{if selected() { lg::alpha(white, 0.9) } else { shell_palette_ink_quiet(lg::is_dark()) }}
          text_by=>{(spec.hint)()}
        />
      })
    },
  )
  let _ = row_v.on_pointer_moved(fn() {
    if !signals::untracked(selected) {
      on_point()
    }
  })
  row_v
}

///| The keyboard-hints footer the info button shows (arrow keys, Enter, Escape).
pub fn shell_palette_hints(parent : view::View, run_label : String) -> Unit {
  let _ = parent.box(fn(ft : view::View) -> Unit {
    let _ = ft.rigid().padding(view::Live::Is((SP_6, SP_4, SP_6, SP_0)))
    shell_palette_rule(ft)
    cmd_footer(ft, [(["up", "down"], "Navigate"), (["Enter"], run_label)], (["Esc"], "Close"))
  })
}
