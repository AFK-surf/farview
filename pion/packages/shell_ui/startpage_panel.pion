///| Farview Shell 3 Start page (`about:newtab` / blank tab), Arc-like: calm, the page card left mostly empty.
///|
///| - A quiet Space label and one search field (solid, flat: it is page content, not a floating layer).
///| - Favorites: bookmarked tiles as site tiles in a grid of four. Frequently visited: the rest of the tiles
///|   (merged from history by `proto::build_start_page_tiles`) as a plain list. No counters, no widgets.
///| - Quick actions as quiet pills at the foot; each pill's shortcut shows in a pill tooltip.
///| - Everything sits on the page card's own ground; washes ease in on hover.

import "headless"
import "lg"
import "motion"
import "proto"
import "ui"
import "view"

pub struct StartPageQuickAction {
  pub label : String
  pub shortcut : String
  pub icon_name : String
  pub on_press : () -> Unit
}

pub struct StartPageProps {
  pub visible : () -> Bool
  pub dark : () -> Bool
  pub space_name : () -> String
  pub space_accent : () -> Int64
  pub search_engine_label : () -> String
  pub tiles : () -> Array[proto::StartPageTile]
  pub field : ui::Field
  pub on_show : () -> Unit
  pub on_submit : (String) -> Unit
  pub on_open_tile : (String) -> Unit
  pub quick_actions : Array[StartPageQuickAction]
}

///| The `k`-th tile that is (or is not) a bookmark.
fn startpage_pick(tiles : Array[proto::StartPageTile], bookmarks : Bool, k : Int) -> Option[proto::StartPageTile] {
  let mut seen = 0
  for t in tiles {
    if t.is_bookmark == bookmarks {
      if seen == k {
        return Some(t)
      }
      seen += 1
    }
  }
  None
}

fn startpage_count(tiles : Array[proto::StartPageTile], bookmarks : Bool) -> Int {
  let mut n = 0
  for t in tiles {
    if t.is_bookmark == bookmarks {
      n += 1
    }
  }
  n
}

///| A site tile carrying the tile's own monogram (from its title, so `en.wikipedia.org` reads W) in the stable
///| per-host color the sidebar uses.
fn startpage_site_tile(parent : view::View, tile : () -> Option[proto::StartPageTile], size : Double) -> Unit {
  let host = fn() -> String {
    match tile() {
      Some(t) => t.host
      None => ""
    }
  }
  let _ = parent.box(fn(t : view::View) -> Unit {
    let _ = t
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(fn() { shell_site_color(host()) }))
    .points(view::Live::Is(false))
    .center()
    <ui::Text
      in={t}
      size={if size >= SP_48 { TX_HEADLINE } else { shell_tile_letter(size) }}
      weight={600}
      color_by=>{0xFFFFFFFFL}
      text_by=>{
        match tile() {
          Some(tt) => if tt.monogram != "" { tt.monogram } else { shell_site_monogram(tt.host) }
          None => ""
        }
      }
    />
  })
}

fn startpage_caption(parent : view::View, text : String) -> Unit {
  let _ = parent.box(fn(cap : view::View) -> Unit {
    let _ = cap.rigid().padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
    <ui::Text in={cap} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={text} />
  })
}

///| One Favorites cell: 48pt site tile over its title (radius 20 = tile 12 + inset 8).
fn startpage_favorite(parent : view::View, props : StartPageProps, k : Int) -> Unit {
  let tile = fn() -> Option[proto::StartPageTile] { startpage_pick((props.tiles)(), true, k) }
  let _ = parent.box(fn(cell : view::View) -> Unit {
    let _ = cell.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
    cell.show(fn() { tile().is_some() }, at_once=true, fn(slot : view::View) -> Unit {
      let _ = headless::button(
        slot,
        fn() {
          match tile() {
            Some(t) => t.title
            None => ""
          }
        },
        fn(_v : view::View) -> Unit {
          match tile() {
            Some(t) => (props.on_open_tile)(t.url)
            None => ()
          }
        },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let wash_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
          let _ = b
          .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_10)))
          .gap(view::Live::Is(SP_8))
          .radius(view::Live::Is(SP_20))
          .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
          let _ = b.box(fn(tile_row : view::View) -> Unit {
            let _ = tile_row.lines_up(view::Live::Is(Some(view::Along::Middle)))
            startpage_site_tile(tile_row, tile, SP_48)
          })
          let _ = b.box(fn(tw : view::View) -> Unit {
            let _ = tw.lines_up(view::Live::Is(Some(view::Along::Middle))).min_width(view::Live::Is(Some(SP_0))).cut()
            let _ = <ui::Text
              in={tw}
              size={TX_FOOTNOTE}
              color_by=>{lg::surface().ink}
              text_by=>{
                match tile() {
                  Some(t) => t.title
                  None => ""
                }
              }
            />.allow_ellipsis(view::Live::Is(true))
          })
        },
      )
    })
  })
}

///| One Frequently visited row: site tile, title, host.
fn startpage_recent(parent : view::View, props : StartPageProps, k : Int) -> Unit {
  let tile = fn() -> Option[proto::StartPageTile] { startpage_pick((props.tiles)(), false, k) }
  parent.show(fn() { tile().is_some() }, at_once=true, fn(slot : view::View) -> Unit {
    let _ = headless::button(
      slot,
      fn() {
        match tile() {
          Some(t) => t.title
          None => ""
        }
      },
      fn(_v : view::View) -> Unit {
        match tile() {
          Some(t) => (props.on_open_tile)(t.url)
          None => ()
        }
      },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let wash_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
        let _ = b
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .min_height(view::Live::Is(Some(SP_40)))
        .padding(view::Live::Is((SP_8, SP_6, SP_8, SP_6)))
        .gap(view::Live::Is(SP_12))
        .radius(view::Live::Is(SP_12))
        .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, wash_t()) }))
        let host = fn() -> String {
          match tile() {
            Some(t) => t.host
            None => ""
          }
        }
        startpage_site_tile(b, tile, SP_24)
        let _ = b.box(fn(tw : view::View) -> Unit {
          let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).cut()
          let _ = <ui::Text
            in={tw}
            size={TX_BODY}
            color_by=>{lg::surface().ink}
            text_by=>{
              match tile() {
                Some(t) => t.title
                None => ""
              }
            }
          />.allow_ellipsis(view::Live::Is(true))
        })
        let _ = b.box(fn(hw : view::View) -> Unit {
          let _ = hw.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(SP_0))).cut()
          let _ = <ui::Text in={hw} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text_by=>{host()} />.allow_ellipsis(
            view::Live::Is(true),
          )
        })
      },
    )
  })
}

///| A quiet quick-action pill; its shortcut shows in a pill tooltip.
fn startpage_action(parent : view::View, host : view::View, act : StartPageQuickAction) -> Unit {
  let _ = lg::liquid_tooltip_node(
    parent,
    host,
    fn() { act.label },
    fn(trig : view::View) -> Unit {
      let _ = trig.shrink(view::Live::Is(0.0))
      let _ = headless::button(
        trig,
        fn() { act.label },
        fn(_v : view::View) -> Unit { (act.on_press)() },
        fn(b : view::View, btn : headless::Button) -> Unit {
          let wash_t = motion::hover_fade(b, fn() { btn.hovered() || btn.pressed() })
          let _ = b
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(SP_32)))
          .shrink(view::Live::Is(0.0))
          .padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
          .gap(view::Live::Is(SP_6))
          .radius(view::Live::Is(SP_16))
          .ground(view::Live::By(fn() {
            let s = lg::surface()
            shell_mix(s.card_secondary, s.ink, 0.06 * wash_t())
          }))
          let _ = shell_icon(b, act.icon_name, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
          <ui::Text in={b} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink} text={act.label} />
        },
      )
    },
    shortcut=fn() { act.shortcut },
  )
}

///| Builds the Start page inside a pane container (`pane_v`), never adding or remounting `stage_node`.
pub fn build_startpage_panel(parent : view::View, props : StartPageProps) -> Unit {
  parent.show(
    props.visible,
    fn(sp_root : view::View) -> Unit {
      (props.on_show)()
      let _ = sp_root
      .over_at(view::Live::Is((Some(SP_0), Some(SP_0), Some(SP_0), Some(SP_0))))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() {
        let _ = (props.dark)()
        lg::surface().card
      }))
      .says(view::Live::Is(Some(view::said(view::Role::Region, label="Start Page"))))

      let avail_w = fn() -> Double {
        let _ = sp_root.laid_size_told()
        let (_, _, sw, _) = sp_root.placed_window_now()
        if sw > SP_128 { sw } else { 1280.0 }
      }
      let avail_h = fn() -> Double {
        let _ = sp_root.laid_size_told()
        let (_, _, _, sh) = sp_root.placed_window_now()
        if sh > SP_128 { sh } else { 800.0 }
      }
      // Column: at most 640pt (SP_160 * 4), SP_24 from the card edges.
      let col_w = fn() -> Double {
        let a = avail_w() - SP_48
        let cap = SP_160 * 4.0
        if a < SP_160 { SP_160 } else if a > cap { cap } else { a }
      }
      // The column starts about a sixth of the way down, never tighter than 48pt or lower than 128pt.
      let top_pad = fn() -> Double {
        let t = avail_h() / 6.0
        if t < SP_48 { SP_48 } else if t > SP_128 { SP_128 } else { t }
      }

      let _ = ui::scroll_box(sp_root, fn(sc : view::View) -> Unit {
        let _ = sc
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::By(fn() { (SP_24, top_pad(), SP_24, SP_48) }))
        let _ = sc.box(fn(col : view::View) -> Unit {
          let _ = col.width(view::Live::By(fn() { Some(col_w()) })).gap(view::Live::Is(SP_32))

          // 1. Space and search.
          let _ = col.box(fn(top : view::View) -> Unit {
            let _ = top.gap(view::Live::Is(SP_16))
            let _ = top.box(fn(space : view::View) -> Unit {
              let _ = space
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .gap(view::Live::Is(SP_8))
              let _ = space.box(fn(dot : view::View) -> Unit {
                let _ = dot
                .width(view::Live::Is(Some(SP_8)))
                .height(view::Live::Is(Some(SP_8)))
                .shrink(view::Live::Is(0.0))
                .radius(view::Live::Is(SP_4))
                .ground(view::Live::By(props.space_accent))
              })
              <ui::Text in={space} size={TX_BODY} weight={500} color_by=>{lg::surface().ink_secondary} text_by=>{(props.space_name)()} />
            })
            let _ = top.box(fn(sbox : view::View) -> Unit {
              let _ = sbox.height(view::Live::Is(Some(SP_48))).rigid()
              let _ = lg::liquid_search_bar_node(
                sbox,
                props.field,
                placeholder_by=fn() { "Search with " + (props.search_engine_label)() + " or enter address" },
                height_by=fn() { SP_48 },
                flat=true,
                label=fn() { "Start Page Search" },
                leading=fn(lead : view::View, ink : () -> Int64) -> Unit {
                  let _ = shell_icon(lead, ICON_SEARCH, size=IC_MD, color_by=ink)
                },
                submitted=fn(q : String) -> Unit {
                  if q.trim() != "" {
                    (props.on_submit)(q)
                  }
                },
              )
            })
          })

          // 2. Favorites (bookmarks) as site tiles, four to a row.
          col.show(fn() { startpage_count((props.tiles)(), true) > 0 }, at_once=true, fn(fav : view::View) -> Unit {
            let _ = fav.gap(view::Live::Is(SP_8))
            startpage_caption(fav, "Favorites")
            let grid_row = fn(start : Int) -> Unit {
              fav.show(fn() { startpage_count((props.tiles)(), true) > start }, at_once=true, fn(r : view::View) -> Unit {
                let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(SP_8))
                let mut c = 0
                while c < 4 {
                  startpage_favorite(r, props, start + c)
                  c += 1
                }
              })
            }
            grid_row(0)
            grid_row(4)
          })

          // 3. Frequently visited (history), a plain list.
          col.show(fn() { startpage_count((props.tiles)(), false) > 0 }, at_once=true, fn(rec : view::View) -> Unit {
            let _ = rec.gap(view::Live::Is(SP_4))
            startpage_caption(rec, "Frequently visited")
            let _ = rec.box(fn(list : view::View) -> Unit {
              let _ = list.gap(view::Live::Is(SP_2))
              let mut k = 0
              while k < proto::START_PAGE_MAX_TILES {
                startpage_recent(list, props, k)
                k += 1
              }
            })
          })

          // Nothing yet: say what will appear.
          col.show(fn() { (props.tiles)().length() == 0 }, at_once=true, fn(empty : view::View) -> Unit {
            let _ = empty.lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((SP_0, SP_16, SP_0, SP_16)))
            <ui::Text
              in={empty}
              size={TX_FOOTNOTE}
              color_by=>{lg::surface().ink_secondary}
              text="Sites you bookmark or visit often will show up here."
            />
          })

          // 4. Quick actions.
          if props.quick_actions.length() > 0 {
            let _ = col.box(fn(acts : view::View) -> Unit {
              let _ = acts
              .row(view::Live::Is(true))
              .wraps(view::Live::Is(Some(SP_8)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .gap(view::Live::Is(SP_8))
              for act in props.quick_actions {
                startpage_action(acts, sp_root, act)
              }
            })
          }
        })
      })
    },
  )
}
