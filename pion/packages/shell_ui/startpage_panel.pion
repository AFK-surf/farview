///| Farview Desktop Shell 2.0 Start Page (`about:newtab` / blank tab).
///|
///| Architectural invariants (Astra #6):
///| - Content background (`lg::surface().canvas`) and Quick Access cards (`lg::surface().card`)
///|   remain 100% solid opaque layers (zero double-layer glass).
///| - ONLY the centered Search/URL input capsule uses single-layer Liquid Glass (`lg::liquid_bar_pill_group_node`).
///| - Zero Unicode pseudo-icons (100% `packages/icons` vector icons + accessible button names).
///| - 100% explicit `color_by` on every `ui::Text` node.
///| - Concentric corner radii, zero double dividers, zero `alpha=0` clickable controls, narrow-screen safe.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

pub struct StartPageQuickAction {
  pub label : String
  pub shortcut : String
  pub icon_name : String
  pub on_press : () -> Unit
}

pub struct StartPageProps {
  pub visible : () -> Bool
  pub dark : () -> Bool
  pub space_name : () -> String
  pub space_accent : () -> Int64
  pub search_engine_label : () -> String
  pub tiles : () -> Array[proto::StartPageTile]
  pub field : ui::Field
  pub on_show : () -> Unit
  pub on_submit : (String) -> Unit
  pub on_open_tile : (String) -> Unit
  pub quick_actions : Array[StartPageQuickAction]
}

fn startpage_space_tint(accent : Int64, dark : Bool) -> (Int64, Int64) {
  let rgb = accent & 0xFFFFFF00L
  if dark {
    (rgb | 0x26L, rgb | 0x55L)
  } else {
    (rgb | 0x18L, rgb | 0x38L)
  }
}

///| Builds the Shell 2.0 Start Page inside a pane container (`pane_v`), never adding or remounting `stage_node`.
pub fn build_startpage_panel(parent : view::View, props : StartPageProps) -> Unit {
  parent.show(
    props.visible,
    fn(sp_root : view::View) -> Unit {
      (props.on_show)()
      let _ = sp_root
      .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
      .clips(view::Live::Is(true))
      .padding(view::Live::Is((12.0, 8.0, 12.0, 12.0)))
      .ground(view::Live::By(fn() {
        if (props.dark)() { 0x0B0C10FFL } else { 0xEEF0F4FFL }
      }))
      .says(view::Live::Is(Some(view::said(view::Role::Region, label="Start Page"))))

      let avail_w = fn() -> Double {
        let _ = sp_root.laid_size_told()
        let (_, _, sw, _) = sp_root.placed_window_now()
        if sw > 120.0 { sw } else { 1280.0 }
      }
      let col_w = fn() -> Double {
        let a = avail_w() - 64.0
        if a < 120.0 {
          120.0
        } else if a < 604.0 {
          a
        } else {
          604.0
        }
      }

      // Solid rounded paper document well (zero glass; separates content well from window chrome)
      let _ = sp_root.box(fn(well : view::View) -> Unit {
        let _ = well
        .fill()
        .clips(view::Live::Is(true))
        .center()
        .padding(view::Live::Is((20.0, 20.0, 20.0, 20.0)))
        .radius(view::Live::Is(14.0))
        .ground(view::Live::By(fn() {
          if (props.dark)() { 0x131419FFL } else { 0xFAFBFDFFL }
        }))
        .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

        let _ = well.box(fn(col : view::View) -> Unit {
          let _ = col
          .width(view::Live::By(fn() { Some(col_w()) }))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(24.0))

          // 1. Centered Header: Farview Emblem + Title + Active Space Pill + Subtitle
          let _ = col.box(fn(hdr : view::View) -> Unit {
            let _ = hdr
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(10.0))

            let _ = hdr.box(fn(brow : view::View) -> Unit {
              let _ = brow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(10.0))

              // 34x34 Farview emblem following Space accent
              let _ = brow.box(fn(em : view::View) -> Unit {
                let _ = em
                .width(view::Live::Is(Some(34.0)))
                .height(view::Live::Is(Some(34.0)))
                .rigid()
                .center()
                .radius(view::Live::Is(10.0))
                .ground(view::Live::By(props.space_accent))
                let _ = <ui::Text in={em} size={17.0} weight={700} color_by=>{0xFFFFFFFFL} text="F" />
              })

              let _ = <ui::Text in={brow} size={22.0} weight={600} color_by=>{lg::surface().ink} text="Farview" />

              // Active Space pill badge
              let _ = brow.box(fn(sp_pill : view::View) -> Unit {
                let _ = sp_pill
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .height(view::Live::Is(Some(24.0)))
                .rigid()
                .padding(view::Live::Is((9.0, 0.0, 9.0, 0.0)))
                .gap(view::Live::Is(6.0))
                .radius(view::Live::Is(12.0))
                .ground(view::Live::By(fn() { startpage_space_tint((props.space_accent)(), (props.dark)()).0 }))
                .edge(view::Live::By(fn() { (lg::hairline_w, startpage_space_tint((props.space_accent)(), (props.dark)()).1) }))
                let _ = sp_pill.box(fn(dot : view::View) -> Unit {
                  let _ = dot
                  .width(view::Live::Is(Some(7.0)))
                  .height(view::Live::Is(Some(7.0)))
                  .rigid()
                  .radius(view::Live::Is(3.5))
                  .ground(view::Live::By(props.space_accent))
                })
                let _ = <ui::Text
                  in={sp_pill}
                  size={11.5}
                  weight={600}
                  color_by=>{lg::surface().ink}
                  text_by=>{(props.space_name)()}
                />
              })
            })

            let _ = <ui::Text
              in={hdr}
              size={13.0}
              weight={400}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{"Search with " + (props.search_engine_label)() + " or jump straight to your pinned sites"}
            />
          })

          // 2. Centered Single-Layer Liquid Glass Search/URL Capsule (ONLY glass layer on StartPage)
          let _ = col.box(fn(sbox_host : view::View) -> Unit {
            let _ = sbox_host
            .width(view::Live::By(fn() { Some(col_w()) }))
            .height(view::Live::Is(Some(48.0)))
            .rigid()

            let _ = lg::liquid_bar_pill_group_node(
              sbox_host,
              fn(sbox : view::View) -> Unit {
                let _ = sbox
                .fill()
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((14.0, 0.0, 8.0, 0.0)))
                .gap(view::Live::Is(10.0))

                // Vector Search icon
                let _ = shell_icon(
                  sbox,
                  ICON_SEARCH,
                  size=16.0,
                  color_by=fn() {
                    if props.field.focused() {
                      lg::surface().accent
                    } else {
                      lg::surface().ink_secondary
                    }
                  },
                )

                // Single-line Search Input + Reactive Placeholder
                let sp_empty = signals::signal(props.field.text() == "")
                let _ = sbox.box(fn(fw : view::View) -> Unit {
                  let _ = fw
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .height(view::Live::Is(Some(32.0)))
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))

                  fw.show(fn() { sp_empty.get() }, fn(ph : view::View) -> Unit {
                    let _ = ph
                    .over_at(view::Live::Is((Some(0.0), Some(0.0), Some(0.0), Some(0.0))))
                    .points(view::Live::Is(false))
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    let _ = <ui::Text
                      in={ph}
                      size={14.0}
                      weight={400}
                      color_by=>{lg::surface().ink_tertiary}
                      text_by=>{"Search with " + (props.search_engine_label)() + " or enter URL..."}
                    />.allow_ellipsis(view::Live::Is(true))
                  })

                  fw.show(fn() { !(props.dark)() }, fn(fl : view::View) -> Unit {
                    let _ = fl.fill()
                    let _ = ui::field(
                      fl,
                      props.field,
                      placeholder="",
                      font_size=14.0,
                      color=0x1D1D1FFFL,
                      placeholder_color=0x8E8E93FFL,
                      caret_color=0x007AFFFFL,
                      max_lines=1,
                      enter_sends=true,
                      edited=fn(v : String) -> Unit { sp_empty.set(v == "") },
                      submitted=fn(v : String) -> Unit {
                        sp_empty.set(true)
                        (props.on_submit)(v)
                      },
                    )
                  })
                  fw.show(fn() { (props.dark)() }, fn(fd : view::View) -> Unit {
                    let _ = fd.fill()
                    let _ = ui::field(
                      fd,
                      props.field,
                      placeholder="",
                      font_size=14.0,
                      color=0xF5F5F7FFL,
                      placeholder_color=0x98989DFFL,
                      caret_color=0x0A84FFFFL,
                      max_lines=1,
                      enter_sends=true,
                      edited=fn(v : String) -> Unit { sp_empty.set(v == "") },
                      submitted=fn(v : String) -> Unit {
                        sp_empty.set(true)
                        (props.on_submit)(v)
                      },
                    )
                  })
                })

                // Accessible Submit Search button inside glass pill (`flat=true`)
                let _ = lg::liquid_button_node(
                  sbox,
                  fn() { "Submit Search" },
                  fn() {
                    let q = props.field.text()
                    if q.trim() != "" {
                      (props.on_submit)(q)
                    } else {
                      props.field.focus()
                    }
                  },
                  content=fn(inner : view::View) -> Unit {
                    let _ = inner
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(6.0))
                    let _ = <ui::Text
                      in={inner}
                      size={12.0}
                      weight={600}
                      color_by=>{lg::surface().ink}
                      text_by=>{(props.search_engine_label)()}
                    />
                    let _ = shell_icon(inner, ICON_ARROW_RIGHT, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                  },
                  flat=true,
                  ghost=true,
                  height=32.0,
                  pad_x=10.0,
                )
              },
              height=48.0,
              label=fn() { "Start Page Search" },
            )
          })

          // 3. Quick Access Speed-Dial Grid (100% Solid Opaque Cards, ZERO glass)
          let _ = col.box(fn(grid_sec : view::View) -> Unit {
            let _ = grid_sec
            .width(view::Live::By(fn() { Some(col_w()) }))
            .gap(view::Live::Is(10.0))

            let _ = grid_sec.box(fn(g_hdr : view::View) -> Unit {
              let _ = g_hdr
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Between))
              .padding(view::Live::Is((2.0, 0.0, 2.0, 0.0)))
              let _ = <ui::Text
                in={g_hdr}
                size={11.0}
                weight={600}
                color_by=>{lg::surface().ink_secondary}
                text="QUICK ACCESS"
              />
              let _ = <ui::Text
                in={g_hdr}
                size={11.0}
                weight={400}
                color_by=>{lg::surface().ink_tertiary}
                text_by=>{
                  let n = (props.tiles)().length()
                  if n == 0 {
                    ""
                  } else if n == 1 {
                    "1 pinned site"
                  } else {
                    n.to_string() + " sites"
                  }
                }
              />
            })

            // Solid empty state card
            grid_sec.show(fn() { (props.tiles)().length() == 0 }, fn(empty_box : view::View) -> Unit {
              let _ = empty_box
              .height(view::Live::Is(Some(104.0)))
              .center()
              .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
              .radius(view::Live::Is(lg::r_panel))
              .ground(view::Live::By(fn() { lg::surface().card }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              let _ = <ui::Text
                in={empty_box}
                size={12.5}
                weight={400}
                color_by=>{lg::surface().ink_secondary}
                text="Your bookmarks and frequently visited sites will appear here"
              />
            })

            // 2 rows x 4 solid speed-dial cards (flexible width so narrow viewports never overflow)
            let render_tile_row = fn(row_start : Int) -> Unit {
              grid_sec.show(fn() { (props.tiles)().length() > row_start }, fn(trow : view::View) -> Unit {
                let _ = trow.row(view::Live::Is(true)).gap(view::Live::Is(12.0))
                let mut c = 0
                while c < 4 {
                  let idx = row_start + c
                  let _ = trow.box(fn(cell : view::View) -> Unit {
                    let _ = cell.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                    cell.show(fn() { idx < (props.tiles)().length() }, fn(slot : view::View) -> Unit {
                      let _ = headless::button(
                        slot,
                        fn() {
                          let ts = (props.tiles)()
                          if idx < ts.length() { ts[idx].title } else { "Site" }
                        },
                        fn(_v : view::View) -> Unit {
                          let ts = (props.tiles)()
                          if idx < ts.length() {
                            (props.on_open_tile)(ts[idx].url)
                          }
                        },
                        fn(card : view::View, btn : headless::Button) -> Unit {
                          let _ = card
                          .fill()
                          .height(view::Live::Is(Some(96.0)))
                          .padding(view::Live::Is((10.0, 12.0, 10.0, 10.0)))
                          .gap(view::Live::Is(8.0))
                          .radius(view::Live::Is(lg::r_panel))
                          .ground(view::Live::By(fn() {
                            if btn.pressed() {
                              lg::surface().row_hover
                            } else if btn.hovered() {
                              lg::surface().card_secondary
                            } else {
                              lg::surface().card
                            }
                          }))
                          .edge(view::Live::By(fn() {
                            if btn.hovered() {
                              (lg::hairline_w, lg::surface().accent)
                            } else {
                              (lg::hairline_w, lg::surface().separator)
                            }
                          }))

                          let _ = card.box(fn(top : view::View) -> Unit {
                            let _ = top
                            .row(view::Live::Is(true))
                            .lines_up(view::Live::Is(Some(view::Along::Middle)))
                            .lies_along(view::Live::Is(view::Lies::Between))
                            .gap(view::Live::Is(6.0))
                            let _ = top.box(fn(ico : view::View) -> Unit {
                              let _ = ico
                              .width(view::Live::Is(Some(32.0)))
                              .height(view::Live::Is(Some(32.0)))
                              .rigid()
                              .center()
                              .radius(view::Live::Is(8.0))
                              .ground(view::Live::By(fn() {
                                let ts = (props.tiles)()
                                if idx < ts.length() { ts[idx].accent } else { lg::surface().accent }
                              }))
                              let _ = <ui::Text
                                in={ico}
                                size={14.0}
                                weight={700}
                                color_by=>{0xFFFFFFFFL}
                                text_by=>{
                                  let ts = (props.tiles)()
                                  if idx < ts.length() { ts[idx].monogram } else { "F" }
                                }
                              />
                            })
                            top.show(
                              fn() {
                                let ts = (props.tiles)()
                                idx < ts.length() && ts[idx].is_bookmark
                              },
                              fn(st_badge : view::View) -> Unit {
                                let _ = shell_icon(st_badge, ICON_STAR_FILLED, size=12.0, color_by=fn() { 0xF59E0BFFL })
                              },
                            )
                          })

                          let _ = card.box(fn(meta : view::View) -> Unit {
                            let _ = meta.gap(view::Live::Is(2.0)).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={meta}
                              size={12.5}
                              weight={600}
                              color_by=>{lg::surface().ink}
                              text_by=>{
                                let ts = (props.tiles)()
                                if idx < ts.length() { ts[idx].title } else { "" }
                              }
                            />.cut().allow_ellipsis(view::Live::Is(true))
                            let _ = <ui::Text
                              in={meta}
                              size={11.0}
                              weight={400}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                let ts = (props.tiles)()
                                if idx < ts.length() { ts[idx].host } else { "" }
                              }
                            />.cut().allow_ellipsis(view::Live::Is(true))
                          })
                        },
                      )
                    })
                  })
                  c += 1
                }
              })
            }
            render_tile_row(0)
            render_tile_row(4)
          })

          // 4. Bottom Lightweight Solid Quick-Action Capsules (responsive: <820pt hides keycaps, <600pt wraps 3+2)
          if props.quick_actions.length() > 0 {
            let show_keycaps = fn() -> Bool { avail_w() >= 820.0 }
            let two_rows = fn() -> Bool { avail_w() < 600.0 }
            let pills_w = fn() -> Double {
              let a = avail_w() - 64.0
              if a < 120.0 {
                120.0
              } else if a < 680.0 {
                a
              } else {
                680.0
              }
            }
            let render_action_pill = fn(row : view::View, act : StartPageQuickAction) -> Unit {
              let _ = headless::button(
                row,
                fn() { act.label },
                fn(_v : view::View) -> Unit { (act.on_press)() },
                fn(b : view::View, btn : headless::Button) -> Unit {
                  let _ = b
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .height(view::Live::Is(Some(32.0)))
                  .rigid()
                  .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                  .gap(view::Live::Is(6.0))
                  .radius(view::Live::Is(lg::r_chip))
                  .ground(view::Live::By(fn() {
                    if btn.pressed() {
                      lg::surface().row_hover
                    } else if btn.hovered() {
                      lg::surface().card_secondary
                    } else {
                      lg::surface().card
                    }
                  }))
                  .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                  let _ = shell_icon(b, act.icon_name, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                  let _ = <ui::Text
                    in={b}
                    size={12.0}
                    weight={500}
                    color_by=>{lg::surface().ink}
                    text={act.label}
                  />
                  if act.shortcut != "" {
                    b.show(show_keycaps, fn(kc : view::View) -> Unit {
                      let _ = kc
                      .height(view::Live::Is(Some(19.0)))
                      .rigid()
                      .center()
                      .padding(view::Live::Is((5.0, 0.0, 5.0, 0.0)))
                      .radius(view::Live::Is(4.5))
                      .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                      .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
                      let _ = <ui::Text
                        in={kc}
                        size={10.0}
                        weight={500}
                        color_by=>{lg::surface().ink_secondary}
                        text={act.shortcut}
                      />
                    })
                  }
                },
              )
            }

            let _ = col.box(fn(pills_wrap : view::View) -> Unit {
              let _ = pills_wrap
              .width(view::Live::By(fn() { Some(pills_w()) }))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))

              pills_wrap.show(fn() { !two_rows() }, fn(pills : view::View) -> Unit {
                let _ = pills
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .gap(view::Live::Is(8.0))
                let mut ai = 0
                while ai < props.quick_actions.length() {
                  render_action_pill(pills, props.quick_actions[ai])
                  ai += 1
                }
              })

              pills_wrap.show(two_rows, fn(stack : view::View) -> Unit {
                let _ = stack
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .gap(view::Live::Is(8.0))
                let split_at = if props.quick_actions.length() >= 4 { 3 } else { props.quick_actions.length() }
                let _ = stack.box(fn(r1 : view::View) -> Unit {
                  let _ = r1
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .gap(view::Live::Is(8.0))
                  let mut i = 0
                  while i < split_at {
                    render_action_pill(r1, props.quick_actions[i])
                    i += 1
                  }
                })
                if split_at < props.quick_actions.length() {
                  let _ = stack.box(fn(r2 : view::View) -> Unit {
                    let _ = r2
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    .gap(view::Live::Is(8.0))
                    let mut i = split_at
                    while i < props.quick_actions.length() {
                      render_action_pill(r2, props.quick_actions[i])
                      i += 1
                    }
                  })
                }
              })
            })
          }
        })
      })
    },
  )
}
