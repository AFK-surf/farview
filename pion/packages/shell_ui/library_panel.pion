///| The Library mode of the sidebar (`sidebar_modes.pion`): a rail of sections on the left (Media, Downloads, Spaces,
///| Boosts, Archived Tabs) with a back arrow at its foot, and beside it a search field over the section's content.
///|
///| - Media / Downloads: a grid of previews. An image that is on this computer shows itself; any other file is a
///|   type card (a monochrome type glyph and its extension); a download in progress shows its bytes (and its share
///|   when the size is known), a failed one is red. Open, Show in Folder and Copy Path appear over a card on hover.
///| - Spaces: every Space with its theme and how many tabs it holds; switch, or customize its theme.
///| - Boosts: every boosted site, on or off, opened by its row.
///| - Archived Tabs: recently closed tabs, reopened by their row.
///| Glyph tiles are monochrome (DESIGN rule "few colored icons"); color only where it means something (a failed
///| download, a Space's own theme). Site rows use the one site tile (`shell_site_tile`), as the sidebar does.
///| Sections switch at once (the rail is a high-frequency control).

import "headless"
import "lg"
import "pixels"
import "proto"
import "signals"
import "ui"
import "view"

let LIB_RAIL_W : Double = 76.0 // SP_64 + SP_12: a 72pt tile keeps SP_6+ around its longest label ("Downloads")
let LIB_RAIL_ITEM_H : Double = 48.0 // SP_48
let LIB_PREVIEW_H : Double = 80.0 // SP_80
let LIB_EMPTY_H : Double = 480.0 // SP_160 * 3: an empty section sits about the middle of the sidebar
let LIB_MIN_COL : Double = 104.0 // SP_96 + SP_8: two columns from 216pt of content

///| One file the Library shows (a download or a capture).
pub struct LibraryFile {
  pub id : String
  pub name : String
  ///| Upper-case extension ("PNG", "PDF"), "" when it has none.
  pub ext : String
  pub size_label : String
  ///| "completed", "in_progress", "failed" or "cancelled".
  pub state : String
  pub state_label : String
  ///| Share received, 0..1, while it runs and its size is known; below 0 when unknown.
  pub progress : Double
  ///| A registered picture of the file (`ui::add_image` key) when it is an image on this computer; "" otherwise.
  pub image : String
  pub source_host : String
}

pub impl Eq for LibraryFile {
  fn equal(self : LibraryFile, other : LibraryFile) -> Bool {
    self.id == other.id &&
    self.name == other.name &&
    self.ext == other.ext &&
    self.size_label == other.size_label &&
    self.state == other.state &&
    self.state_label == other.state_label &&
    self.progress == other.progress &&
    self.image == other.image &&
    self.source_host == other.source_host
  }
}

///| What the Library shows and what its rows do.
pub struct LibraryProps {
  pub files : () -> Array[LibraryFile]
  pub boosts : () -> Array[proto::SiteBoost]
  pub closed_tabs : () -> Array[proto::ClosedTabItem]
  pub now_secs : () -> Int64
  pub on_open_file : (String) -> Unit
  pub on_reveal_file : (String) -> Unit
  pub on_copy_path : (String) -> Unit
  ///| How many tabs a Space holds (the host's count, every Space's, unfiltered); below 0 when unknown.
  pub space_tab_count : (String) -> Int
  pub on_switch_space : (String) -> Unit
  pub on_customize_space : (String) -> Unit
  ///| Saves a boost as given (its row's switch flips `enabled`).
  pub on_save_boost : (proto::SiteBoost) -> Unit
  ///| Opens a boosted site (its host).
  pub on_open_boost : (String) -> Unit
  ///| Reopens a closed tab (its index in the closed list, its URL).
  pub on_reopen_tab : (Int, String) -> Unit
}

///| A Library with nothing in it and rows that do nothing (tests, scenes that only show Create a Space).
pub fn LibraryProps::empty() -> LibraryProps {
  LibraryProps::{
    files: fn() { [] },
    boosts: fn() { [] },
    closed_tabs: fn() { [] },
    now_secs: fn() { 0L },
    on_open_file: fn(_id) { () },
    on_reveal_file: fn(_id) { () },
    on_copy_path: fn(_id) { () },
    space_tab_count: fn(_id) { -1 },
    on_switch_space: fn(_id) { () },
    on_customize_space: fn(_id) { () },
    on_save_boost: fn(_b) { () },
    on_open_boost: fn(_h) { () },
    on_reopen_tab: fn(_i, _u) { () },
  }
}

///| The kind of a file by its extension: "image", "video", "audio", "archive", "code", "doc" or "file".
pub fn library_file_kind(ext : String) -> String {
  let e = ext
  if e == "PNG" || e == "JPG" || e == "JPEG" || e == "GIF" || e == "WEBP" || e == "SVG" || e == "HEIC" || e == "AVIF" ||
  e == "BMP" || e == "TIFF" {
    "image"
  } else if e == "MP4" || e == "MOV" || e == "WEBM" || e == "MKV" || e == "AVI" || e == "M4V" {
    "video"
  } else if e == "MP3" || e == "WAV" || e == "M4A" || e == "AAC" || e == "FLAC" || e == "OGG" || e == "OPUS" {
    "audio"
  } else if e == "ZIP" || e == "DMG" || e == "TAR" || e == "GZ" || e == "TGZ" || e == "7Z" || e == "PKG" || e == "ISO" ||
  e == "XZ" || e == "BZ2" || e == "RAR" {
    "archive"
  } else if e == "JSON" || e == "CSV" || e == "JS" || e == "TS" || e == "PY" || e == "HTML" || e == "CSS" || e == "XML" ||
  e == "MD" || e == "WASM" {
    "code"
  } else if e == "PDF" || e == "TXT" || e == "DOC" || e == "DOCX" || e == "PAGES" || e == "RTF" || e == "EPUB" {
    "doc"
  } else {
    "file"
  }
}

///| The type glyph for a file kind.
pub fn library_kind_glyph(kind : String) -> String {
  if kind == "image" {
    "image"
  } else if kind == "video" {
    "video"
  } else if kind == "audio" {
    ICON_VOLUME
  } else if kind == "archive" {
    "archive"
  } else if kind == "code" {
    "file-code"
  } else if kind == "doc" {
    "file-text"
  } else {
    "file"
  }
}

///| Whether a file belongs in Media (pictures, video, sound).
pub fn library_is_media(f : LibraryFile) -> Bool {
  let k = library_file_kind(f.ext)
  k == "image" || k == "video" || k == "audio"
}

fn lib_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 0x41 && c <= 0x5A {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i += 1
  }
  sb.to_string()
}

///| Whether `hay` contains the search `q` (any case); an empty search matches everything.
pub fn library_matches(q : String, hays : Array[String]) -> Bool {
  let want = lib_lower(q.trim())
  if want == "" {
    return true
  }
  for h in hays {
    if lib_lower(h).contains(want) {
      return true
    }
  }
  false
}

///| The files a section shows for a search, in the order given (newest first).
pub fn library_files_for(section : String, files : Array[LibraryFile], q : String) -> Array[LibraryFile] {
  let out : Array[LibraryFile] = []
  for f in files {
    let in_section = if section == LIBRARY_MEDIA { library_is_media(f) } else { true }
    if in_section && library_matches(q, [f.name, f.source_host, f.ext]) {
      out.push(f)
    }
  }
  out
}

///| Whether a downloaded file of this extension may be handed to the system's default app by one press: pictures,
///| video, sound, PDF and plain text only. Anything else (an app, a script, a `.command`, an installer, an archive, an
///| office document, a web page, no extension) is shown in its folder instead, so a page cannot get a program run by
///| one click on its card.
pub fn library_opens_directly(ext : String) -> Bool {
  let e = ext.trim()
  e == "PNG" || e == "JPG" || e == "JPEG" || e == "GIF" || e == "WEBP" || e == "HEIC" || e == "AVIF" || e == "BMP" ||
  e == "TIFF" ||
  e == "MP4" ||
  e == "MOV" ||
  e == "WEBM" ||
  e == "MKV" ||
  e == "M4V" ||
  e == "MP3" ||
  e == "WAV" ||
  e == "M4A" ||
  e == "AAC" ||
  e == "FLAC" ||
  e == "OGG" ||
  e == "OPUS" ||
  e == "PDF" ||
  e == "TXT" ||
  e == "MD" ||
  e == "CSV" ||
  e == "JSON" ||
  e == "RTF" ||
  e == "EPUB"
}

///| The upper-case extension of a file name ("" when it has none, or the dot leads).
pub fn library_ext_of(name : String) -> String {
  let mut i = name.length() - 1
  while i > 0 {
    if name.code_unit_at(i).to_int() == 0x2E {
      let ext = name.slice(i + 1, name.length())
      let sb = StringBuilder::new()
      let mut k = 0
      while k < ext.length() {
        let c = ext.code_unit_at(k).to_int()
        sb.write_char((if c >= 0x61 && c <= 0x7A { c - 32 } else { c }).unsafe_to_char())
        k += 1
      }
      return sb.to_string()
    }
    i -= 1
  }
  ""
}

///| A file name cut in the middle to fit `width` (as `measure` sets it): the start of the name, an ellipsis, then its
///| last characters and the extension kept whole (what people scan downloads by). Whole when it fits.
pub fn library_middle_cut(name : String, width : Double, measure : (String) -> Double) -> String {
  if width <= 0.0 || measure(name) <= width {
    return name
  }
  // The tail kept: the extension (up to 6 characters after the dot) and the 3 characters before it.
  let mut dot = -1
  let mut i = name.length() - 1
  while i > 0 && dot < 0 {
    if name.code_unit_at(i).to_int() == 0x2E && name.length() - i <= 7 {
      dot = i
    }
    i -= 1
  }
  let tail_from0 = if dot > 0 { dot - 3 } else { name.length() - 3 }
  let tail_from = lib_char_start(name, if tail_from0 < 1 { 1 } else { tail_from0 })
  let tail = name.slice(tail_from, name.length())
  // The longest start that fits beside it.
  let mut lo = 0
  let mut hi = tail_from
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if measure(name.slice(0, lib_char_start(name, mid)) + "\u{2026}" + tail) <= width {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  name.slice(0, lib_char_start(name, lo)) + "\u{2026}" + tail
}

///| `i` moved back to the start of the character it falls in (never inside a multi-byte character).
fn lib_char_start(s : String, i : Int) -> Int {
  let mut k = if i > s.length() { s.length() } else { i }
  while k > 0 && k < s.length() && (s.code_unit_at(k).to_int() & 0xC0) == 0x80 {
    k -= 1
  }
  k
}

///| Pictures of downloads are drawn at most this big (pixels): twice the preview (104 x 80pt).
pub let LIBRARY_THUMB_W : Int = 208
pub let LIBRARY_THUMB_H : Int = 160

///| A small PNG of an image file's bytes (PNG, JPEG or WebP), scaled down to cover LIBRARY_THUMB_W x LIBRARY_THUMB_H
///| (area average). Heavy: call it on a worker thread, never on the render thread. None when it cannot be read or is
///| too large to decode (over 40 megapixels).
pub fn library_thumbnail_png(b : Bytes) -> Option[Bytes] {
  let decoded = if pixels::is_png(b) {
    pixels::decode_png(b)
  } else if b.length() > 3 && b[0].to_int() == 0xFF && b[1].to_int() == 0xD8 {
    pixels::decode_jpeg(b)
  } else {
    pixels::decode_webp(b)
  }
  match decoded {
    Some((w, h, rgba)) if w > 0 && h > 0 && w.to_int64() * h.to_int64() <= 40_000_000L =>
    Some(lib_downscale_png(w, h, rgba, LIBRARY_THUMB_W, LIBRARY_THUMB_H))
    _ => None
  }
}

fn lib_downscale_png(w : Int, h : Int, rgba : FixedArray[Byte], tw : Int, th : Int) -> Bytes {
  // Cover the target box, never enlarge.
  let sx = tw.to_double() / w.to_double()
  let sy = th.to_double() / h.to_double()
  let s0 = if sx > sy { sx } else { sy }
  let s = if s0 > 1.0 { 1.0 } else { s0 }
  let nw0 = (w.to_double() * s + 0.5).to_int()
  let nh0 = (h.to_double() * s + 0.5).to_int()
  let nw = if nw0 < 1 { 1 } else { nw0 }
  let nh = if nh0 < 1 { 1 } else { nh0 }
  if nw == w && nh == h {
    return pixels::png(w, h, rgba)
  }
  let out = FixedArray::make(nw * nh * 4, 0 as Byte)
  let mut y = 0
  while y < nh {
    let y0 = y * h / nh
    let y1a = (y + 1) * h / nh
    let y1 = if y1a > y0 { y1a } else { y0 + 1 }
    let mut x = 0
    while x < nw {
      let x0 = x * w / nw
      let x1a = (x + 1) * w / nw
      let x1 = if x1a > x0 { x1a } else { x0 + 1 }
      let mut r = 0
      let mut g = 0
      let mut bl = 0
      let mut a = 0
      let mut n = 0
      let mut yy = y0
      while yy < y1 && yy < h {
        let mut xx = x0
        while xx < x1 && xx < w {
          let i = (yy * w + xx) * 4
          r += rgba[i].to_int()
          g += rgba[i + 1].to_int()
          bl += rgba[i + 2].to_int()
          a += rgba[i + 3].to_int()
          n += 1
          xx += 1
        }
        yy += 1
      }
      let o = (y * nw + x) * 4
      if n > 0 {
        out[o] = (r / n).to_byte()
        out[o + 1] = (g / n).to_byte()
        out[o + 2] = (bl / n).to_byte()
        out[o + 3] = (a / n).to_byte()
      }
      x += 1
    }
    y += 1
  }
  pixels::png(nw, nh, out)
}

///| Whether any of `views` (a card's or row's own controls) has the keyboard's focus: what shows their actions to
///| the keyboard as hovering shows them to the pointer.
fn lib_focus_within(views : signals::Ref[Array[view::View]]) -> Bool {
  let mut any = false
  for v in views.v {
    if v.alive() && v.focused() {
      any = true
    }
  }
  any
}

///| Adds `v` to a card's or row's own controls (dropping those let go of).
fn lib_keep(views : signals::Ref[Array[view::View]], v : view::View) -> Unit {
  let kept : Array[view::View] = []
  for x in views.v {
    if x.alive() {
      kept.push(x)
    }
  }
  kept.push(v)
  views.v = kept
}

///| (rail label, accessible name, glyph, section key, search placeholder)
fn lib_sections() -> Array[(String, String, String, String, String)] {
  [
    ("Media", "Media", "image", LIBRARY_MEDIA, "Search Media"),
    ("Downloads", "Downloads", ICON_DOWNLOAD, LIBRARY_DOWNLOADS, "Search Downloads"),
    ("Spaces", "Spaces", ICON_LAYERS, LIBRARY_SPACES, "Search Spaces"),
    ("Boosts", "Boosts", ICON_SPARKLES, LIBRARY_BOOSTS, "Search Boosts"),
    ("Archived", "Archived Tabs", "archive", LIBRARY_ARCHIVED, "Search Archived Tabs"),
  ]
}

fn lib_placeholder(section : String) -> String {
  for s in lib_sections() {
    if s.3 == section {
      return s.4
    }
  }
  "Search"
}

///| What an empty section says (the sentence under "Nothing here yet").
fn lib_empty_line(section : String) -> String {
  if section == LIBRARY_MEDIA {
    "Pictures, video and sound you download show up here."
  } else if section == LIBRARY_DOWNLOADS {
    "Files you download show up here."
  } else if section == LIBRARY_BOOSTS {
    "Change a site's colors or fonts with Boost and it shows up here."
  } else if section == LIBRARY_ARCHIVED {
    "Tabs you close show up here, ready to reopen."
  } else {
    "Spaces you make show up here."
  }
}

fn lib_empty_glyph(section : String) -> String {
  for s in lib_sections() {
    if s.3 == section {
      return s.2
    }
  }
  "file"
}

///| Neutral tile ground behind a glyph on the frame (the inverse in dark).
fn lib_tile_ground(dark : Bool) -> Int64 {
  if dark { 0xFFFFFF1AL } else { 0x0000000FL }
}

///| A monochrome glyph tile: neutral gray ground, ink glyph (red for a failure).
fn lib_mono_tile(parent : view::View, model : ShellModel, icon_by : () -> String, size~ : Double = SP_32, danger~ : () -> Bool = fn() { false }) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .points(view::Live::Is(false))
    .center()
    .ground(view::Live::By(fn() { if danger() { lg::surface().danger_bg } else { lib_tile_ground(model.dark()) } }))
    let _ = shell_icon_by(tile, icon_by, size=shell_tile_glyph(size), color_by=fn() {
      if danger() { lg::surface().danger } else { shell_frame_ink_secondary(model.dark()) }
    })
  })
}

///| One line of text that takes the remaining width and ends in an ellipsis.
fn lib_line(parent : view::View, size : Double, weight : Int, color_by : () -> Int64, text_by : () -> String, grow~ : Bool = true) -> Unit {
  let _ = parent.box(fn(w : view::View) -> Unit {
    let _ = w.min_width(view::Live::Is(Some(SP_0))).shrink(view::Live::Is(1.0)).cut()
    if grow {
      let _ = w.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0)))
    }
    let _ = <ui::Text in={w} size={size} weight={weight} color_by=>{color_by()} text_by=>{text_by()} />.allow_ellipsis(
      view::Live::Is(true),
    )
  })
}

///| A small icon button laid over a preview (on a solid capsule): 32pt hit target, a wash on hover.
fn lib_overlay_btn(parent : view::View, label : String, icon_name : String, on_press : () -> Unit) -> view::View {
  headless::button(
    parent,
    fn() { label },
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      shell_press(b, fn() { btn.pressed() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      let _ = shell_icon(b, icon_name, size=IC_MD, color_by=fn() { lg::surface().ink })
    },
  )
}

///| The drawing of an empty section: two cards, the front one holding the section's glyph.
fn lib_empty_drawing(parent : view::View, model : ShellModel, glyph : String) -> Unit {
  let _ = parent.box(fn(art : view::View) -> Unit {
    let _ = art.width(view::Live::Is(Some(SP_64))).height(view::Live::Is(Some(SP_48))).rigid().hides(view::Live::Is(true))
    let card = fn(x : Double, y : Double, turn : Double, front : Bool) -> Unit {
      let _ = art.box(fn(c : view::View) -> Unit {
        let _ = c
        .over_at(view::Live::Is((Some(x), Some(y), None, None)))
        .width(view::Live::Is(Some(SP_48)))
        .height(view::Live::Is(Some(SP_40)))
        .radius(view::Live::Is(SP_8))
        .turn(view::Live::Is(turn))
        .center()
        .ground(view::Live::By(fn() { if front { lg::surface().card } else { shell_wash(model.dark()) } }))
        .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
        if front {
          let _ = c.shadow(view::Live::By(fn() { shell_row_lift(model.dark()) })).shadow_outside(view::Live::Is(true))
          let _ = shell_icon(c, glyph, size=IC_LG, color_by=fn() { shell_frame_ink_tertiary(model.dark()) })
        }
      })
    }
    card(SP_16, SP_0, 0.14, false)
    card(SP_4, SP_8, -0.07, true)
  })
}

///| "Nothing here yet" (or, while searching, that nothing matches) with the section's drawing.
fn lib_empty_state(parent : view::View, model : ShellModel, section : String, query : () -> String) -> Unit {
  let _ = parent.box(fn(e : view::View) -> Unit {
    let _ = e
    .grow(view::Live::Is(1.0))
    .min_height(view::Live::Is(Some(LIB_EMPTY_H)))
    .center()
    .gap(view::Live::Is(SP_8))
    .padding(view::Live::Is((SP_8, SP_32, SP_8, SP_32)))
    lib_empty_drawing(e, model, lib_empty_glyph(section))
    <ui::Text
      in={e}
      size={TX_BODY}
      weight={600}
      center
      color_by=>{lg::surface().ink}
      text_by=>{if query().trim() == "" { "Nothing here yet" } else { "No matches" }}
    />
    let _ = e.box(fn(d : view::View) -> Unit {
      let _ = d.max_width(view::Live::Is(Some(SP_160 + SP_20))).rigid()
      <ui::Text
        in={d}
        size={TX_FOOTNOTE}
        wrap
        center
        color_by=>{shell_frame_ink_secondary(model.dark())}
        text_by=>{
          let q = query().trim()
          if q == "" { lib_empty_line(section) } else { "Nothing here matches \u{201C}" + q + "\u{201D}." }
        }
      />
    })
  })
}

// ============================================================================
// Files (Media / Downloads)
// ============================================================================

fn lib_file_status(f : LibraryFile) -> String {
  if f.state == "completed" {
    if f.size_label != "" { f.size_label } else { f.state_label }
  } else if f.state == "in_progress" && f.size_label != "" {
    if f.progress >= 0.0 {
      let pct = (f.progress * 100.0 + 0.5).to_int()
      "\{pct}% of \{f.size_label}"
    } else {
      "\{f.state_label} \{f.size_label}"
    }
  } else {
    f.state_label
  }
}

///| What pressing a card does: "open" (a finished picture, video, sound, PDF or text), "reveal" (any other finished
///| file: shown in its folder, never run) or "" (not finished: the card is only read out, it does nothing).
pub fn library_card_action(f : LibraryFile) -> String {
  if f.state != "completed" {
    ""
  } else if library_opens_directly(f.ext) {
    "open"
  } else {
    "reveal"
  }
}

///| The card's look (preview area): picture or type card, red edge when failed, a running bar while it downloads.
fn lib_card_face(pv : view::View, model : ShellModel, file : () -> LibraryFile, hover_t : () -> Double) -> Unit {
  let failed = fn() -> Bool { file().state == "failed" || file().state == "cancelled" }
  let running = fn() -> Bool { file().state == "in_progress" }
  let _ = pv
  .height(view::Live::Is(Some(LIB_PREVIEW_H)))
  .rigid()
  .radius(view::Live::Is(SP_10))
  .cut()
  .center()
  .gap(view::Live::Is(SP_4))
  .ground(view::Live::By(fn() { lg::over(sm_field_ground(model.dark()), lg::alpha(shell_wash_hover(model.dark()), hover_t())) }))
  .edge(view::Live::By(fn() { if failed() { (lg::hairline_w, lg::alpha(lg::surface().danger, 0.5)) } else { (SP_0, 0L) } }))
  // A picture of the file itself.
  pv.show(fn() { file().image != "" }, fn(img : view::View) -> Unit {
    let _ = img
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .image(view::Live::By(fn() { Some((file().image, "", 0)) }))
    .image_covers(view::Live::Is(true))
  })
  // Otherwise a type card: the kind's glyph and the extension.
  pv.show(fn() { file().image == "" }, fn(tc : view::View) -> Unit {
    let _ = tc.center().gap(view::Live::Is(SP_4)).points(view::Live::Is(false))
    lib_mono_tile(
      tc,
      model,
      fn() { if failed() { ICON_ALERT_CIRCLE } else { library_kind_glyph(library_file_kind(file().ext)) } },
      danger=failed,
    )
    tc.show(fn() { file().ext != "" }, fn(badge : view::View) -> Unit {
      let _ = badge
      .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
      .radius(view::Live::Is(SP_4))
      .rigid()
      .ground(view::Live::By(fn() { lib_tile_ground(model.dark()) }))
      <ui::Text in={badge} size={TX_CAPTION} weight={600} color_by=>{shell_frame_ink_secondary(model.dark())} text_by=>{file().ext} />
    })
  })
  // While it downloads: its share when the size is known, else a sweep that needs no total.
  pv.show(running, fn(track : view::View) -> Unit {
    let _ = track.over_at(view::Live::Is((Some(SP_8), None, Some(SP_8), Some(SP_8)))).points(view::Live::Is(false))
    let _ = lg::liquid_progress_bar_node(
      track,
      fn() {
        let r = file().progress
        if r < 0.0 { None } else if r > 1.0 { Some(1.0) } else { Some(r) }
      },
      label=fn() { "" },
      tint=lg::surface().accent,
      height=SP_4,
    )
  })
}

fn lib_file_cell(cell : view::View, model : ShellModel, props : LibraryProps, file : () -> LibraryFile) -> Unit {
  let _ = cell.gap(view::Live::Is(SP_4)).min_width(view::Live::Is(Some(SP_0)))
  // The card's own controls (its press, Open, Show in Folder, Copy Path): any of them focused shows the actions.
  let mine : signals::Ref[Array[view::View]] = signals::ref_new([])
  let keep = fn(v : view::View) -> Unit { lib_keep(mine, v) }
  let shown_acts = fn() -> Bool { cell.pointer_within() || lib_focus_within(mine) }
  let failed = fn() -> Bool { file().state == "failed" || file().state == "cancelled" }
  let running = fn() -> Bool { file().state == "in_progress" }
  // The card: a button named for what it does (open, or show in its folder) once finished; before that only read
  // out ("name, Failed"), with no press.
  let _ = cell.box(fn(face_host : view::View) -> Unit {
    let _ = face_host.rigid()
    face_host.switch_by(fn() { library_card_action(file()) }, fn(slot : view::View, act : String) -> Unit {
      if act == "" {
        let _ = slot.says(view::Live::By(fn() { Some(view::said(view::Role::Image, label=file().name + ", " + lib_file_status(file()))) }))
        lib_card_face(slot, model, file, fn() { 0.0 })
      } else {
        let b = headless::button(
          slot,
          fn() { if act == "open" { "Open " + file().name } else { "Show " + file().name + " in Folder" } },
          fn(_e) -> Unit {
            let f = signals::untracked(file)
            if library_card_action(f) == "open" {
              (props.on_open_file)(f.id)
            } else if library_card_action(f) == "reveal" {
              (props.on_reveal_file)(f.id)
            }
          },
          fn(pv : view::View, btn : headless::Button) -> Unit {
            let hover_t = shell_fade(pv, fn() { btn.hovered() || btn.pressed() })
            lib_card_face(pv, model, file, hover_t)
          },
        )
        keep(b)
      }
    })
  })
  // Name (cut in the middle: the extension stays) and status.
  let _ = cell.box(fn(nm : view::View) -> Unit {
    let _ = nm.rigid().min_width(view::Live::Is(Some(SP_0))).cut().hides(view::Live::Is(true))
    let _ = nm.by_room(fn(inner : view::View, room : view::Room) -> Unit {
      <ui::Text
        in={inner}
        size={TX_FOOTNOTE}
        weight={500}
        color_by=>{lg::surface().ink}
        text_by=>{
          library_middle_cut(file().name, room.width(), fn(t : String) -> Double {
            ui::measure_text_width(t, TX_FOOTNOTE, weight=500)
          })
        }
      />
    })
  })
  lib_line(
    cell,
    TX_CAPTION,
    400,
    fn() {
      if failed() {
        lg::surface().danger
      } else if running() {
        shell_accent_text()
      } else {
        shell_frame_ink_secondary(model.dark())
      }
    },
    fn() { lib_file_status(file()) },
    grow=false,
  )
  // Open (only what opens safely), Show in Folder and Copy Path over a finished file, while the pointer is on its
  // card or the keyboard is on one of its controls.
  cell.show(fn() { shown_acts() && file().state == "completed" }, fn(acts : view::View) -> Unit {
    let _ = acts
    .over_at(view::Live::Is((None, Some(SP_4), Some(SP_4), None)))
    .row(view::Live::Is(true))
    .radius(view::Live::Is(SP_10))
    .padding(view::Live::Is((SP_2, SP_2, SP_2, SP_2)))
    .ground(view::Live::By(fn() { lg::surface().card }))
    .shadow(view::Live::By(fn() { shell_row_lift(model.dark()) }))
    .shadow_outside(view::Live::Is(true))
    acts.show(fn() { library_opens_directly(file().ext) }, fn(o : view::View) -> Unit {
      let _ = o.rigid()
      keep(lib_overlay_btn(o, "Open", ICON_EXTERNAL, fn() { (props.on_open_file)(signals::untracked(file).id) }))
    })
    keep(lib_overlay_btn(acts, "Show in Folder", ICON_FOLDER, fn() { (props.on_reveal_file)(signals::untracked(file).id) }))
    keep(lib_overlay_btn(acts, "Copy Path", ICON_COPY, fn() { (props.on_copy_path)(signals::untracked(file).id) }))
  })
}

fn lib_files_section(page : view::View, model : ShellModel, props : LibraryProps, section : String, query : () -> String) -> Unit {
  let list = fn() -> Array[LibraryFile] { library_files_for(section, (props.files)(), query()) }
  page.show(fn() { list().length() == 0 }, fn(e : view::View) -> Unit {
    let _ = e.fill()
    lib_empty_state(e, model, section, query)
  })
  page.show(fn() { list().length() > 0 }, fn(g : view::View) -> Unit {
    let _ = g.grid(
      fn() { list().length() },
      min_col_w=LIB_MIN_COL,
      gap=SP_8,
      row_gap=SP_12,
      max_cols=3,
      fn(cell : view::View, idx : Int) -> Unit {
        let file = fn() -> LibraryFile {
          let l = list()
          if idx < l.length() {
            l[idx]
          } else {
            LibraryFile::{
              id: "",
              name: "",
              ext: "",
              size_label: "",
              state: "",
              state_label: "",
              progress: -1.0,
              image: "",
              source_host: "",
            }
          }
        }
        lib_file_cell(cell, model, props, file)
      },
    )
  })
}

// ============================================================================
// Spaces, Boosts, Archived Tabs
// ============================================================================

///| A Space's theme as a small rounded tile painted the way the frame paints it: point 0 the ground, the last point
///| coming in from the right, a third rising from the foot (the theme's own colors, not the frame's paled tints).
fn lib_theme_square(parent : view::View, theme : () -> proto::SpaceTheme) -> Unit {
  let stops = fn() -> Array[Int64] {
    let out : Array[Int64] = []
    for p in theme().points {
      out.push(p.rgba)
    }
    if out.length() == 0 {
      out.push(0x007AFFFFL)
    }
    out
  }
  let size = SP_24
  let _ = parent.box(fn(sq : view::View) -> Unit {
    let _ = sq
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(SP_6))
    .cut()
    .points(view::Live::Is(false))
    .ground(view::Live::By(fn() { stops()[0] }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
    sq.show(fn() { stops().length() >= 2 }, fn(g : view::View) -> Unit {
      let _ = g.over(view::Live::Is(true)).points(view::Live::Is(false)).fades(view::Live::Is((size, SP_0, SP_0, SP_0))).radius(view::Live::Is(SP_6)).cut()
      let _ = g.box(fn(solid : view::View) -> Unit {
        let _ = solid
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(SP_6))
        .ground(view::Live::By(fn() {
          let s = stops()
          s[s.length() - 1]
        }))
      })
    })
    sq.show(fn() { stops().length() >= 3 }, fn(g : view::View) -> Unit {
      let _ = g.over(view::Live::Is(true)).points(view::Live::Is(false)).fades(view::Live::Is((SP_0, size, SP_0, SP_0))).radius(view::Live::Is(SP_6)).cut()
      let _ = g.box(fn(solid : view::View) -> Unit {
        let _ = solid
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(SP_6))
        .ground(view::Live::By(fn() {
          let s = stops()
          if s.length() >= 3 { s[1] } else { s[0] }
        }))
      })
    })
  })
}

///| A list row on the frame: hover wash; `body` lays out its content; `trail` (shown while the pointer is on the
///| row, when given) holds controls of its own beside the row's press.
fn lib_row(
  parent : view::View,
  model : ShellModel,
  label : () -> String,
  on_press : () -> Unit,
  body : (view::View) -> Unit,
  trail? : (view::View, (view::View) -> Unit) -> Unit,
  trail_always~ : Bool = false,
) -> Unit {
  let _ = parent.box(fn(wrap : view::View) -> Unit {
    let _ = wrap.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid().gap(view::Live::Is(SP_2))
    // The row's own controls: any of them focused shows the trail to the keyboard as hovering does to the pointer.
    let mine : signals::Ref[Array[view::View]] = signals::ref_new([])
    let keep = fn(v : view::View) -> Unit { lib_keep(mine, v) }
    let hovered = fn() -> Bool { wrap.pointer_within() }
    let hover_t = shell_fade(wrap, fn() { hovered() || lib_focus_within(mine) })
    let _ = wrap.radius(view::Live::Is(SP_8)).ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(model.dark()), hover_t()) }))
    let main = headless::button(
      wrap,
      label,
      fn(_e) -> Unit { on_press() },
      fn(r : view::View, btn : headless::Button) -> Unit {
        let _ = btn
        let _ = r
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(SP_0)))
        .min_width(view::Live::Is(Some(SP_0)))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .min_height(view::Live::Is(Some(SP_40)))
        .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
        .gap(view::Live::Is(SP_8))
        body(r)
      },
    )
    keep(main)
    match trail {
      Some(t) =>
      if trail_always {
        let _ = wrap.box(fn(tr : view::View) -> Unit {
          let _ = tr.rigid().padding(view::Live::Is((SP_0, SP_0, SP_4, SP_0)))
          t(tr, keep)
        })
      } else {
        wrap.show(fn() { hovered() || lib_focus_within(mine) }, fn(tr : view::View) -> Unit {
          let _ = tr.rigid().padding(view::Live::Is((SP_0, SP_0, SP_4, SP_0)))
          t(tr, keep)
        })
      }
      None => ()
    }
  })
}

fn lib_two_lines(parent : view::View, model : ShellModel, title : () -> String, sub : () -> String) -> Unit {
  let _ = parent.box(fn(col : view::View) -> Unit {
    let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).gap(view::Live::Is(SP_2))
    lib_line(col, TX_BODY, 500, fn() { lg::surface().ink }, title, grow=false)
    col.show(fn() { sub() != "" }, fn(s : view::View) -> Unit {
      lib_line(s, TX_CAPTION, 400, fn() { shell_frame_ink_secondary(model.dark()) }, sub, grow=false)
    })
  })
}

fn lib_spaces_section(page : view::View, model : ShellModel, props : LibraryProps, query : () -> String) -> Unit {
  let list = fn() -> Array[ShellSpaceItem] {
    let out : Array[ShellSpaceItem] = []
    for sp in model.spaces() {
      if library_matches(query(), [sp.name]) {
        out.push(sp)
      }
    }
    out
  }
  page.show(fn() { list().length() == 0 }, fn(e : view::View) -> Unit {
    let _ = e.fill()
    lib_empty_state(e, model, LIBRARY_SPACES, query)
  })
  let _ = page.box(fn(col : view::View) -> Unit {
    let _ = col.gap(view::Live::Is(SP_2))
    col.each(
      list,
      fn(sp : ShellSpaceItem) -> String { sp.id },
      fn(slot : view::View, sp_sig : signals::Signal[ShellSpaceItem]) -> Unit {
        let is_active = fn() -> Bool { model.active_space_id() == sp_sig.get().id }
        lib_row(
          slot,
          model,
          fn() { "Switch to " + sp_sig.get().name },
          fn() { (props.on_switch_space)(sp_sig.untracked().id) },
          fn(r : view::View) -> Unit {
            lib_theme_square(r, fn() { st_theme_of_item(sp_sig.get()) })
            lib_two_lines(r, model, fn() { sp_sig.get().name }, fn() {
              let n = (props.space_tab_count)(sp_sig.get().id)
              if n < 0 { "" } else if n == 1 { "1 tab" } else { n.to_string() + " tabs" }
            })
            r.show(is_active, fn(ck : view::View) -> Unit {
              let _ = ck.rigid()
              let _ = shell_icon(ck, ICON_CHECK, size=IC_MD, color_by=fn() { lg::surface().ink })
            })
          },
          trail=fn(tr : view::View, keep : (view::View) -> Unit) -> Unit {
            keep(
              lib_overlay_btn(tr, "Customize " + sp_sig.untracked().name, "palette", fn() {
                (props.on_customize_space)(sp_sig.untracked().id)
              }),
            )
          },
        )
      },
      at_once=true,
    )
  })
}

///| What a boost changes, in a few words.
fn lib_boost_summary(b : proto::SiteBoost) -> String {
  let parts : Array[String] = []
  let theme = proto::normalize_boost_theme(b.theme)
  if theme == "dark" {
    parts.push("Dark")
  } else if theme == "sepia" {
    parts.push("Sepia")
  } else if theme == "contrast" {
    parts.push("High contrast")
  }
  if proto::normalize_boost_tint(b.tint) != "" {
    parts.push("Tint")
  }
  let font = proto::normalize_boost_font(b.font)
  if font != "" && font != "default" {
    parts.push("Font")
  }
  if b.zapped.length() > 0 {
    parts.push("Zapped")
  }
  if b.custom_css.trim() != "" || b.custom_js.trim() != "" {
    parts.push("Code")
  }
  if !b.enabled {
    "Off"
  } else if parts.length() == 0 {
    "On"
  } else {
    parts.join(", ")
  }
}

fn lib_boosts_section(page : view::View, model : ShellModel, props : LibraryProps, query : () -> String) -> Unit {
  let list = fn() -> Array[proto::SiteBoost] {
    let out : Array[proto::SiteBoost] = []
    for b in (props.boosts)() {
      let h = proto::normalize_boost_host(b.host)
      if h != "" && library_matches(query(), [h]) {
        out.push(b)
      }
    }
    out
  }
  page.show(fn() { list().length() == 0 }, fn(e : view::View) -> Unit {
    let _ = e.fill()
    lib_empty_state(e, model, LIBRARY_BOOSTS, query)
  })
  let _ = page.box(fn(col : view::View) -> Unit {
    let _ = col.gap(view::Live::Is(SP_2))
    col.each(
      fn() -> Array[(String, proto::SiteBoost)] {
        let out : Array[(String, proto::SiteBoost)] = []
        for b in list() {
          out.push((proto::normalize_boost_host(b.host), b))
        }
        out
      },
      fn(e : (String, proto::SiteBoost)) -> String { e.0 },
      fn(slot : view::View, e : signals::Signal[(String, proto::SiteBoost)]) -> Unit {
        lib_row(
          slot,
          model,
          fn() { "Open " + e.get().0 },
          fn() { (props.on_open_boost)(e.untracked().0) },
          fn(r : view::View) -> Unit {
            // (no site tile: the sidebar's width goes to the host, which is what the row is about)
            lib_two_lines(r, model, fn() { e.get().0 }, fn() { lib_boost_summary(e.get().1) })
          },
          trail=fn(tr : view::View, keep : (view::View) -> Unit) -> Unit {
            // Compact (as in the menu rows): the host keeps its room and the switches recede.
            keep(
              lg::liquid_toggle_node(
                tr,
                fn() { e.get().1.enabled },
                fn(v : Bool) -> Unit { (props.on_save_boost)(proto::SiteBoost::{ ..e.untracked().1, enabled: v }) },
                fn() { "Boost " + e.get().0 },
                width=SP_32 + SP_4,
                height=SP_20,
              ),
            )
          },
          trail_always=true,
        )
      },
      at_once=true,
    )
  })
}

fn lib_archived_section(page : view::View, model : ShellModel, props : LibraryProps, query : () -> String) -> Unit {
  let list = fn() -> Array[proto::ClosedTabItem] { proto::filter_closed_tabs((props.closed_tabs)(), query()) }
  page.show(fn() { list().length() == 0 }, fn(e : view::View) -> Unit {
    let _ = e.fill()
    lib_empty_state(e, model, LIBRARY_ARCHIVED, query)
  })
  let _ = page.box(fn(col : view::View) -> Unit {
    let _ = col.gap(view::Live::Is(SP_2))
    col.each(
      list,
      fn(it : proto::ClosedTabItem) -> String { it.index.to_string() + "|" + it.url },
      fn(slot : view::View, it : signals::Signal[proto::ClosedTabItem]) -> Unit {
        let host = fn() -> String {
          let h = it.get().host
          if h != "" { h } else { shell_url_parts(it.get().url).0 }
        }
        lib_row(
          slot,
          model,
          fn() { "Reopen " + it.get().title },
          fn() { (props.on_reopen_tab)(it.untracked().index, it.untracked().url) },
          fn(r : view::View) -> Unit {
            // The one site tile (as in the sidebar): the site's icon, else its monogram.
            let _ = shell_site_tile(r, host, size=SP_24)
            lib_two_lines(r, model, fn() { if it.get().title != "" { it.get().title } else { host() } }, host)
            let _ = r.box(fn(tm : view::View) -> Unit {
              let _ = tm.rigid()
              <ui::Text
                in={tm}
                size={TX_CAPTION}
                color_by=>{shell_frame_ink_tertiary(model.dark())}
                text_by=>{proto::format_closed_relative_time(it.get().closed_secs, (props.now_secs)())}
              />
            })
          },
        )
      },
      at_once=true,
    )
  })
}

// ============================================================================
// The Library view
// ============================================================================

fn lib_rail_item(rail : view::View, model : ShellModel, st : SidebarModeState, entry : (String, String, String, String, String)) -> Unit {
  let (label, name, glyph, key, _) = entry
  let selected = fn() -> Bool { st.section.get() == key }
  let _ = headless::button(
    rail,
    fn() { name },
    fn(_e) -> Unit { st.show_section(key) },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b
      .width(view::Live::Is(Some(LIB_RAIL_W - SP_4)))
      .height(view::Live::Is(Some(LIB_RAIL_ITEM_H + SP_4)))
      .rigid()
      .radius(view::Live::Is(SP_10))
      .center()
      .gap(view::Live::Is(SP_2))
      .ground(view::Live::By(fn() {
        if selected() { shell_wash_strong(model.dark()) } else { lg::alpha(shell_wash_hover(model.dark()), hover_t()) }
      }))
      .shadow(view::Live::By(fn() { if selected() { shell_row_lift(model.dark()) } else { (SP_0, SP_0, 0L) } }))
      let ink = fn() -> Int64 { if selected() { lg::surface().ink } else { shell_frame_ink_secondary(model.dark()) } }
      let _ = shell_icon(b, glyph, size=IC_LG, color_by=ink)
      <ui::Text in={b} size={TX_CAPTION} weight={500} color_by=>{ink()} text={label} />
    },
  )
}

///| The Library in the sidebar (under the top row): the rail, the search, the section.
fn build_library_view(layer : view::View, model : ShellModel, p : SidebarModeProps, narrow : Bool) -> Unit {
  let st = p.state
  let props = p.library
  let back = shell_closes(layer, fn() { st.back() })
  let _ = layer
  .row(view::Live::Is(true))
  .gap(view::Live::Is(SP_8))
  .padding(view::Live::Is((SP_0, SP_0, SP_0, if narrow { SP_0 } else { SP_8 })))
  .says(view::Live::Is(Some(view::said(view::Role::Region, label="Library"))))
  // Rail: the sections in the middle, back to the tabs at the foot.
  let _ = layer.box(fn(rail : view::View) -> Unit {
    let _ = rail
    .width(view::Live::Is(Some(LIB_RAIL_W)))
    .shrink(view::Live::Is(0.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(SP_8))
    .says(view::Live::Is(Some(view::said(view::Role::Group, label="Library Sections"))))
    let _ = rail.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
    for entry in lib_sections() {
      lib_rail_item(rail, model, st, entry)
    }
    let _ = rail.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
    let _ = shell_frame_icon_btn(rail, model, "Back to Tabs", "arrow-left", back)
  })
  // Search and the section.
  let _ = layer.box(fn(col : view::View) -> Unit {
    // (SP_12 under the search: its 36pt hit area reaches past its 32pt face)
    let _ = col.fill().gap(view::Live::Is(SP_12)).min_width(view::Live::Is(Some(SP_0)))
    let _ = col.box(fn(fw : view::View) -> Unit {
      let _ = fw.rigid().radius(view::Live::Is(SP_8)).ground(view::Live::By(fn() { shell_wash_strong(model.dark()) }))
      let _ = lg::liquid_text_field_node(
        fw,
        st.search_field,
        placeholder="Search",
        height_by=fn() { SP_32 },
        label=fn() { lib_placeholder(st.section.get()) },
        show_label=false,
        flat=true,
        radius=SP_8,
        lead=fn(lead : view::View, _ink : () -> Int64) -> Unit {
          let _ = shell_icon(lead, ICON_SEARCH, size=IC_MD, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
        },
      )
    })
    let query = fn() -> String { st.search_field.text() }
    let _ = col.box(fn(scroll_host : view::View) -> Unit {
      let _ = scroll_host.fill()
      let _ = ui::scroll_box(scroll_host, fn(page : view::View) -> Unit {
        let _ = page.padding(view::Live::Is((SP_0, SP_0, SP_0, SP_8))).min_height(view::Live::Is(Some(SP_0)))
        page.switch_by(fn() { st.section.get() }, fn(sec : view::View, key : String) -> Unit {
          let _ = sec.grow(view::Live::Is(1.0))
          if key == LIBRARY_MEDIA || key == LIBRARY_DOWNLOADS {
            lib_files_section(sec, model, props, key, query)
          } else if key == LIBRARY_SPACES {
            lib_spaces_section(sec, model, props, query)
          } else if key == LIBRARY_BOOSTS {
            lib_boosts_section(sec, model, props, query)
          } else {
            lib_archived_section(sec, model, props, query)
          }
        })
      })
    })
  })
}
