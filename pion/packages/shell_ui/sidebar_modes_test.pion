///| Sidebar modes: Create a Space (disabled until named, Escape cancels, the theme previews and lands on the new
///| Space, the theme editor) and the Library (sections switch, search filters, back returns), with the audits.

import "lg"
import "pixels"
import "proto"
import "signals"
import "ui"
import "view"

struct SmRig {
  t : ui::Tester
  ctrl : ShellController
  state : SidebarModeState
  created : Array[(String, proto::SpaceTheme)]
}

fn sm_rig(width~ : Double = 1280.0, height~ : Double = 800.0, dark~ : Bool = false, empty~ : Bool = false, two_step~ : Bool = false) -> SmRig {
  space_theme_preview.set(None)
  space_theme_draft.set(None)
  let ctrl = make_demo_controller(dark=dark)
  let state = SidebarModeState::new()
  let created : Array[(String, proto::SpaceTheme)] = []
  let modes = demo_sidebar_modes(ctrl, state, empty=empty, created=created, two_step=two_step)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
        build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) })
      })
      let hooks = ShellHostHooks::{ ..ShellHostHooks::empty(), sidebar_modes: Some(modes) }
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    width=width,
    height=height,
    theme=lg::ui_theme,
    dark=dark,
  )
  sm_settle(t)
  SmRig::{ t, ctrl, state, created }
}

fn sm_settle(t : ui::Tester) -> Unit {
  let mut i = 0
  while i < 20 {
    t.frame(ms=16.0)
    i += 1
  }
}

///| Whether the control called `name` is announced as dimmed.
fn sm_disabled(t : ui::Tester, name : String) -> Bool {
  for e in t.agent_snapshot() {
    if e.label == name {
      return e.disabled
    }
  }
  false
}

fn sm_first_tab_y(t : ui::Tester) -> Double {
  match t.get("WPT Dashboard: css") {
    Some(d) => d.y
    None => -1.0
  }
}

fn sm_is(state : SidebarModeState, m : SidebarMode) -> Bool {
  state.mode.untracked() == m
}

test "library helpers: file kinds, media, search" {
  debug_assert(library_file_kind("PNG") == "image" && library_file_kind("MP4") == "video", "image, video")
  debug_assert(library_file_kind("MP3") == "audio" && library_file_kind("ZIP") == "archive", "audio, archive")
  debug_assert(library_file_kind("PDF") == "doc" && library_file_kind("JSON") == "code", "doc, code")
  debug_assert(library_file_kind("") == "file" && library_file_kind("XYZ") == "file", "anything else: file")
  let files = demo_library_files()
  let media = library_files_for(LIBRARY_MEDIA, files, "")
  for f in media {
    debug_assert(library_is_media(f), "Media holds only pictures, video and sound: " + f.name)
  }
  debug_assert(media.length() == 4, "three pictures and a recording")
  debug_assert(library_files_for(LIBRARY_DOWNLOADS, files, "").length() == files.length(), "Downloads holds every file")
  let zips = library_files_for(LIBRARY_DOWNLOADS, files, "ZIP")
  debug_assert(zips.length() == 1 && zips[0].name == "invar-0.9.2.zip", "search matches any case, by name or kind")
  debug_assert(library_files_for(LIBRARY_DOWNLOADS, files, "unsplash").length() == 2, "search matches the source site")
  debug_assert(library_matches("", ["x"]) && !library_matches("q", ["x"]), "empty search matches all")
}

test "create a space: Create Space waits for a name; it makes the Space with its theme and switches to it" {
  let rig = sm_rig()
  let t = rig.t
  debug_assert(t.get("New Space").is_some(), "New Space on the space bar")
  t.press("New Space")
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::CreateSpace), "the sidebar switched to Create a Space")
  debug_assert(t.find("Create a Space").is_some(), "title shown")
  debug_assert(t.find("Separate your tabs for life, work, projects, and more.").is_some(), "one line under it")
  // The frame previews the theme being chosen at once.
  let draft = rig.state.draft.untracked()
  debug_assert(shell_space_theme(rig.ctrl.model()).same(draft), "the frame paints the new Space's theme")
  // No name: the button is dimmed (and said so) and pressing it does nothing.
  debug_assert(sm_disabled(t, "Create Space"), "Create Space is announced as dimmed while unnamed")
  t.press("Create Space")
  sm_settle(t)
  debug_assert(rig.created.length() == 0, "nothing made without a name")
  debug_assert(sm_is(rig.state, SidebarMode::CreateSpace), "still creating")
  debug_assert(!rig.state.can_create(), "disabled while unnamed")
  rig.state.name_field.set("   ")
  debug_assert(!rig.state.can_create(), "blanks are no name")
  rig.state.name_field.set("Studio")
  debug_assert(rig.state.can_create(), "enabled once named")
  sm_settle(t)
  debug_assert(!sm_disabled(t, "Create Space"), "and no longer dimmed")
  let spaces_before = rig.ctrl.spaces.untracked().length()
  t.press("Create Space")
  sm_settle(t)
  debug_assert(rig.created.length() == 1 && rig.created[0].0 == "Studio", "made with the name")
  debug_assert(rig.created[0].1.same(draft), "made with the theme chosen")
  debug_assert(rig.ctrl.spaces.untracked().length() == spaces_before + 1, "one more Space")
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "back to the tabs")
  let model = rig.ctrl.model()
  debug_assert(model.spaces()[model.spaces().length() - 1].id == model.active_space_id(), "the new Space is active")
  debug_assert(space_theme_draft.untracked().is_none(), "the preview ends once the Space arrived")
  debug_assert(shell_space_theme(model).same(draft), "the active Space shows its theme")
  lg::assert_apple_ui(t, label="create_space_after")
  t.dispose()
}

test "create a space: Escape cancels and the frame goes back to the Space's own theme" {
  let rig = sm_rig()
  let t = rig.t
  let before = shell_space_theme(rig.ctrl.model())
  rig.state.start_create(proto::space_theme_from_accent("#F43F5E"), name="Half typed")
  sm_settle(t)
  debug_assert(!shell_space_theme(rig.ctrl.model()).same(before), "previewing the new theme")
  lg::assert_apple_ui(t, label="create_space_light")
  t.key(ui::key_escape)
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "Escape went back to the tabs")
  debug_assert(rig.created.length() == 0, "nothing made")
  debug_assert(space_theme_draft.untracked().is_none(), "no preview left")
  debug_assert(shell_space_theme(rig.ctrl.model()).same(before), "the frame shows the Space's own theme again")
  // Cancel does the same.
  rig.state.start_create(proto::space_theme_from_accent("#F43F5E"))
  sm_settle(t)
  t.press("Cancel")
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs) && space_theme_draft.untracked().is_none(), "Cancel cancels")
  t.dispose()
}

test "create a space: Choose a Theme opens the editor, a preset changes the theme, Escape closes the editor first" {
  let rig = sm_rig()
  let t = rig.t
  rig.state.start_create(create_space_default_theme(3), name="Studio")
  sm_settle(t)
  t.press("Choose a Theme")
  sm_settle(t)
  debug_assert(rig.state.theme_open.untracked(), "the theme editor is open")
  debug_assert(t.get("More Themes").is_some(), "its presets are there")
  let before = rig.state.draft.untracked()
  t.press("Theme Blossom")
  sm_settle(t)
  let after = rig.state.draft.untracked()
  debug_assert(!after.same(before), "a preset changes the theme being chosen")
  debug_assert(shell_space_theme(rig.ctrl.model()).same(after), "and the frame previews it")
  // One Escape key press closes the editor only (never also cancels Create a Space).
  t.key(ui::key_escape)
  sm_settle(t)
  debug_assert(!rig.state.theme_open.untracked() && sm_is(rig.state, SidebarMode::CreateSpace), "Escape: the editor closes first")
  t.press("Create Space")
  sm_settle(t)
  debug_assert(rig.created.length() == 1 && rig.created[0].1.same(after), "the Space is made with the preset")
  t.dispose()
}

test "create a space: narrow window shows it in the sidebar drawer, with the page dimmed" {
  let rig = sm_rig(width=480.0)
  let t = rig.t
  rig.state.start_create(create_space_default_theme(0))
  sm_settle(t)
  debug_assert(t.find("Create a Space").is_some(), "in the drawer")
  debug_assert(t.get("Create Space").is_some(), "with its button")
  lg::assert_apple_ui(t, label="create_space_480", allow_large_overlay=true)
  t.key(ui::key_escape)
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "Escape cancels there too")
  t.dispose()
}

test "library: opens from the space bar, sections switch, search filters, back returns" {
  let rig = sm_rig()
  let t = rig.t
  t.press("Library")
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Library), "Library mode")
  debug_assert(t.get("Open coast-path.jpg").is_some() && t.get("Open fonts.json").is_some(), "Downloads: every file")
  debug_assert(t.find(".jpg").is_some() && t.find(".pdf").is_some(), "names cut in the middle keep the extension")
  debug_assert(t.find("Downloading 7.6 MB").is_some(), "a running download shows its bytes (no total known)")
  debug_assert(t.get("quarterly-report.pdf, Downloading 7.6 MB").is_some(), "a running card is read out, not a button")
  debug_assert(t.get("Open quarterly-report.pdf").is_none(), "and nothing claims to open it")
  debug_assert(t.get("Open coast-path.jpg").is_some(), "a finished picture opens")
  debug_assert(t.get("Show invar-0.9.2.zip in Folder").is_some(), "an archive is only shown in its folder")
  debug_assert(t.find("Failed").is_some(), "a failed one says so")
  lg::assert_apple_ui(t, label="library_downloads")
  t.press("Media")
  sm_settle(t)
  debug_assert(rig.state.section.untracked() == LIBRARY_MEDIA, "Media shown")
  debug_assert(t.get("Open coast-path.jpg").is_some() && t.get("Open fonts.json").is_none(), "Media: pictures, not data")
  t.press("Downloads")
  sm_settle(t)
  rig.state.search_field.set("zip")
  sm_settle(t)
  debug_assert(t.get("Show invar-0.9.2.zip in Folder").is_some() && t.get("Open coast-path.jpg").is_none(), "search filters")
  rig.state.search_field.set("nothing-like-this")
  sm_settle(t)
  debug_assert(t.find("No matches").is_some(), "says when nothing matches")
  t.press("Spaces")
  sm_settle(t)
  debug_assert(rig.state.search_field.text() == "", "a new section starts with an empty search")
  debug_assert(t.find("4 tabs").is_some() && t.get("Switch to Life").is_some(), "Spaces with their tabs")
  debug_assert(t.find("7 tabs").is_some() && t.find("3 tabs").is_some(), "every Space's own count, not the active one's")
  t.press("Switch to Life")
  sm_settle(t)
  debug_assert(rig.ctrl.active_space_id.untracked() == "personal", "a Space row switches to it")
  t.press("Boosts")
  sm_settle(t)
  debug_assert(t.find("news.ycombinator.com").is_some(), "every boost")
  debug_assert(t.get("Boost news.ycombinator.com").is_some() && t.get("Boost github.com").is_some(), "each switch named for its site")
  debug_assert(t.get("Boost On").is_none(), "no switches with one shared name")
  t.press("Archived Tabs")
  sm_settle(t)
  debug_assert(t.find("Pion language tour").is_some(), "recently closed tabs")
  lg::assert_apple_ui(t, label="library_archived")
  t.press("Back to Tabs")
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "back returns to the tabs")
  t.press("Library")
  sm_settle(t)
  t.key(ui::key_escape)
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "Escape returns too")
  t.dispose()
}

test "library: empty sections say so, light and dark" {
  for d in [false, true] {
    let rig = sm_rig(dark=d, empty=true)
    let t = rig.t
    rig.state.open_library(section=LIBRARY_BOOSTS)
    sm_settle(t)
    debug_assert(t.find("Nothing here yet").is_some(), "empty Boosts")
    lg::assert_apple_ui(t, label="library_empty_" + (if d { "dark" } else { "light" }))
    t.dispose()
  }
}

test "library: what a card's press may do (never runs a program)" {
  debug_assert(library_opens_directly("PDF") && library_opens_directly("JPG") && library_opens_directly("MP3"), "documents and media open")
  for e in ["COMMAND", "APP", "SH", "JAR", "TERMINAL", "PKG", "DMG", "EXE", "HTML", "ZIP", "DOCX", ""] {
    debug_assert(!library_opens_directly(e), "not opened directly: " + e)
  }
  debug_assert(library_ext_of("evil.Command") == "COMMAND" && library_ext_of("noext") == "" && library_ext_of(".bashrc") == "", "extensions")
  let base = demo_library_files()[0]
  debug_assert(library_card_action(base) == "open", "a finished picture opens")
  debug_assert(library_card_action(LibraryFile::{ ..base, name: "run.command", ext: "COMMAND" }) == "reveal", "a script is shown in its folder")
  debug_assert(library_card_action(LibraryFile::{ ..base, state: "failed" }) == "", "an unfinished file does nothing")
}

test "library: thumbnails are made small" {
  // A 400x300 PNG comes back covering 208x160 at most.
  let w = 400
  let h = 300
  let rgba = Bytes::new(w * h * 4)
  let png = pixels::png(w, h, rgba)
  match library_thumbnail_png(png) {
    Some(small) =>
    match pixels::decode_png(small) {
      Some((sw, sh, _)) => debug_assert(sw == 213 && sh == 160, "scaled to cover the preview: \{sw}x\{sh}")
      None => debug_assert(false, "a PNG back")
    }
    None => debug_assert(false, "a thumbnail")
  }
  debug_assert(library_thumbnail_png("not an image".to_bytes()).is_none(), "nothing for what is not a picture")
}

test "create a space: the frame keeps the new theme between the host's two broadcasts" {
  let rig = sm_rig(two_step=true)
  let t = rig.t
  rig.state.start_create(create_space_default_theme(1), name="Studio")
  sm_settle(t)
  let draft = rig.state.draft.untracked()
  t.press("Create Space")
  sm_settle(t)
  let model = rig.ctrl.model()
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "back to the tabs")
  debug_assert(space_theme_draft.untracked().is_some(), "the preview holds while the Space has only its accent")
  debug_assert(shell_space_theme(model).same(draft), "the frame still shows the chosen theme, not the lone accent")
  demo_land_space_theme(rig.ctrl, model.active_space_id(), draft)
  sm_settle(t)
  debug_assert(space_theme_draft.untracked().is_none(), "the preview ends once the theme landed")
  debug_assert(shell_space_theme(model).same(draft), "and the Space draws it itself")
  t.dispose()
}

test "create a space: the frame tint eases in and out, not in one frame" {
  let rig = sm_rig()
  let t = rig.t
  let model = rig.ctrl.model()
  let before = shell_space_frame_base(model)
  // (the root's ground is the frame base color as drawn)
  let ground_now = fn() -> Int64 {
    let mut g = 0L
    for d in t.drawn() {
      if d.x == 0.0 && d.y == 0.0 && d.w >= 1279.0 && d.h >= 799.0 && (d.ground & 0xFFL) == 0xFFL && g == 0L {
        g = d.ground
      }
    }
    g
  }
  debug_assert(ground_now() == before, "the frame ground is the Space's color")
  rig.state.start_create(proto::space_theme_from_accent("#F43F5E"))
  t.frame(ms=16.0)
  t.frame(ms=50.0)
  let target = shell_space_frame_base(model)
  let mid = ground_now()
  debug_assert(mid != before && mid != target, "part way after 50ms")
  sm_settle(t)
  debug_assert(ground_now() == target, "there after the fade")
  t.dispose()
}

test "library: back brings the tabs where they were, at once" {
  let rig = sm_rig(height=300.0)
  let t = rig.t
  // Scroll the tab list down, open the Library, come back.
  let y0 = sm_first_tab_y(t)
  t.move_to(SP_80, 160.0)
  t.wheel(SP_80, 160.0, 120.0)
  sm_settle(t)
  t.wheel(SP_80, 160.0, 120.0)
  sm_settle(t)
  let before = sm_first_tab_y(t)
  debug_assert(before != y0, "the tab list scrolled: \{y0} -> \{before}")
  t.press("Library")
  sm_settle(t)
  t.press("Back to Tabs")
  t.frame(ms=16.0)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "back to the tabs")
  debug_assert(t.get("New Space").is_some() && t.get("WPT Dashboard: css").is_some(), "the tabs are there on the first frame")
  sm_settle(t)
  let after = sm_first_tab_y(t)
  debug_assert(after == before, "the tab list kept its scroll: \{before} -> \{after}")
  t.dispose()
}

test "library: the sidebar toggle leaves the Library instead of hiding nothing" {
  let rig = sm_rig()
  let t = rig.t
  let open_before = rig.ctrl.model().dock().sidebar_open
  t.press("Library")
  sm_settle(t)
  t.press("Toggle Sidebar")
  sm_settle(t)
  debug_assert(sm_is(rig.state, SidebarMode::Tabs), "the toggle went back to the tabs")
  debug_assert(rig.ctrl.model().dock().sidebar_open == open_before, "and did not flip the sidebar's hidden state")
  t.dispose()
}

test "library: a card's actions show to the keyboard too" {
  let rig = sm_rig()
  let t = rig.t
  rig.state.open_library()
  sm_settle(t)
  debug_assert(t.get("Show in Folder").is_none(), "no actions at rest")
  let mut i = 0
  while i < 40 && t.get("Show in Folder").is_none() {
    t.key(ui::key_tab)
    t.frame(ms=16.0)
    i += 1
  }
  debug_assert(t.get("Show in Folder").is_some(), "tabbing onto a finished card shows its actions")
  t.dispose()
}

test "library: file names are cut in the middle, keeping the extension" {
  let m = fn(t : String) -> Double { t.length().to_double() }
  debug_assert(library_middle_cut("fonts.json", 20.0, m) == "fonts.json", "whole when it fits")
  let cut = library_middle_cut("quarterly-report.pdf", 14.0, m)
  debug_assert(cut.ends_with("ort.pdf") && cut.length() <= 14 && cut.contains("\u{2026}"), "cut keeps the end: " + cut)
  debug_assert(cut.starts_with("quar"), "and the start: " + cut)
  // Never cuts inside a character.
  let wide = library_middle_cut("\u{62A5}\u{544A}\u{62A5}\u{544A}\u{62A5}\u{544A}.pdf", 16.0, m)
  debug_assert(wide.ends_with(".pdf") && wide.starts_with("\u{62A5}"), "whole characters: " + wide)
}
