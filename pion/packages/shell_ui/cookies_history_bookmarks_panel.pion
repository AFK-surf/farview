///| Shell 3 — site data and saved pages:
///| 1. Cookies inspector (`build_cookies_inspector_modal`): one dialog per site, cookies grouped by the domain
///|    they belong to, a glyph tile per cookie saying how it travels (Secure, partitioned, or sent over HTTP).
///| 2. History drawer (`build_history_drawer_panel`): Today / Yesterday / Earlier groups, a site tile per page,
///|    the remove button shown only while a row is hovered or focused.
///| 3. Bookmarks drawer (`build_bookmarks_drawer_panel`): a toggle for the page you are on, then bookmarks grouped
///|    by folder, the same rows as History.
///|
///| One `lg` glass layer only (the drawer or the dialog shell); everything inside is solid grouped lists
///| (`DESIGN.md` §1, §3). Every size is a `SP_*` / `TX_*` / `IC_*` token.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// Shared pieces (private to this file)
// ============================================================================

///| Width the History and Bookmarks drawers ask for (the drawer narrows itself to the window): SP_160 * 2 + SP_80.
///| A function, not a `let`: a package-level `let` built from other files' tokens can be read before they are set.
fn chb_drawer_w() -> Double {
  SP_160 * 2.0 + SP_80
}

///| Where a row's label starts inside its card: card pad + row pad + tile + gap. Rules start here.
fn chb_label_inset() -> Double {
  SP_4 + SP_8 + SP_24 + SP_12
}

///| A flat 32pt icon button: a 24pt face that washes in on hover (eased), red ink on hover when `danger`.
fn chb_icon_btn(
  parent : view::View,
  label_fn : () -> String,
  icon_name : String,
  on_press : () -> Unit,
  danger~ : Bool = false,
  capture_ref? : signals::Ref[Option[view::View]],
) -> view::View {
  let v = headless::button(
    parent,
    label_fn,
    fn(_v : view::View) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      let _ = b.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).rigid().center().radius(view::Live::Is(SP_8)).focus_ring_theme()
      let _ = b.box(fn(face : view::View) -> Unit {
        let _ = face
        .width(view::Live::Is(Some(SP_24)))
        .height(view::Live::Is(Some(SP_24)))
        .radius(view::Live::Is(SP_6))
        .points(view::Live::Is(false))
        .center()
        .ground(view::Live::By(fn() {
          if lg::is_dark() {
            lg::alpha(0xFFFFFF1FL, hover_t())
          } else {
            lg::alpha(0x0000000FL, hover_t())
          }
        }))
        shell_press(face, fn() { btn.pressed() })
        let _ = shell_icon(
          face,
          icon_name,
          size=IC_SM,
          color_by=fn() {
            if danger && (btn.hovered() || btn.pressed()) {
              lg::surface().danger
            } else if btn.hovered() || btn.pressed() {
              lg::surface().ink
            } else {
              lg::surface().ink_secondary
            }
          },
        )
      })
    },
  )
  match capture_ref {
    Some(r) => r.v = Some(v)
    None => ()
  }
  v
}

///| Flat icon button kept for the other drawers that call it (sessions, folders, spaces, closed tabs, print):
///| same 32pt button as this file's rows.
fn phase3b_icon_action_btn(
  parent : view::View,
  label_fn : () -> String,
  icon_name : String,
  on_press : () -> Unit,
  danger~ : Bool = false,
) -> view::View {
  chb_icon_btn(parent, label_fn, icon_name, on_press, danger=danger)
}

///| Content for a flat destructive button: red words on the neutral flat face (no red fill competing with Done).
fn chb_danger_label(text : String) -> (view::View) -> Unit {
  fn(inner : view::View) -> Unit {
    let _ = <ui::Text in={inner} size={TX_BODY} weight={500} color_by=>{lg::surface().danger} text={text} />
  }
}

///| The search field every panel here uses: 32pt, `SP_8` corners, a search glyph, a clear button while it holds text.
fn chb_search_field(
  parent : view::View,
  field : ui::Field,
  placeholder : String,
  label : String,
  clear_label : String,
  on_clear : () -> Unit,
  submitted? : (String) -> Unit,
) -> Unit {
  let _ = parent.box(fn(wrap : view::View) -> Unit {
    let _ = wrap.rigid()
    let _ = lg::liquid_text_field_node(
      wrap,
      field,
      placeholder=placeholder,
      height_by=fn() { SP_32 },
      label=fn() { label },
      show_label=false,
      flat=true,
      radius=SP_8,
      lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
        let _ = shell_icon(ic, ICON_SEARCH, size=IC_SM, color_by=ink)
      },
      trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
        tr.show(fn() { field.text() != "" }, fn(cw : view::View) -> Unit {
          let _ = chb_icon_btn(cw, fn() { clear_label }, ICON_CLOSE, on_clear)
        })
      },
      submitted?=submitted,
    )
  })
}

///| A grouped list section: quiet caption (shown when not empty), one solid card, optional footnote.
fn chb_group(
  parent : view::View,
  caption : () -> String,
  footnote : () -> String,
  rows : (view::View) -> Unit,
) -> Unit {
  let _ = parent.box(fn(g : view::View) -> Unit {
    let _ = g.rigid().gap(view::Live::Is(SP_6))
    g.show(fn() { caption() != "" }, fn(cap : view::View) -> Unit {
      let _ = cap.rigid().padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      let _ = <ui::Text
        in={cap}
        size={TX_FOOTNOTE}
        weight={500}
        color_by=>{lg::surface().ink_secondary}
        text_by=>{caption()}
      />
    })
    let _ = lg::surface_card_node(g, rows, radius=SP_12, pad=SP_4)
    g.show(fn() { footnote() != "" }, fn(fw : view::View) -> Unit {
      let _ = fw.rigid().padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      let _ = <ui::Text
        in={fw}
        size={TX_FOOTNOTE}
        wrap
        color_by=>{lg::surface().ink_secondary}
        text_by=>{footnote()}
      />
    })
  })
}

///| Hairline between two rows of a card, starting where the labels start.
fn chb_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .rigid()
    .margin(view::Live::Is((chb_label_inset() - SP_4, SP_0, SP_8, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| A two-line text block that truncates: title (body) over a secondary line (footnote).
fn chb_two_lines(parent : view::View, title : () -> String, sub : () -> String, title_weight~ : Int = 400) -> Unit {
  let _ = parent.box(fn(mid : view::View) -> Unit {
    let _ = mid
    .grow(view::Live::Is(1.0))
    .shrink(view::Live::Is(1.0))
    .basis(view::Live::Is(Some(SP_0)))
    .min_width(view::Live::Is(Some(SP_0)))
    .gap(view::Live::Is(SP_2))
    .cut()
    let _ = <ui::Text
      in={mid}
      size={TX_BODY}
      weight={title_weight}
      color_by=>{lg::surface().ink}
      text_by=>{title()}
    />.allow_ellipsis(view::Live::Is(true))
    mid.show(fn() { sub() != "" }, fn(sw : view::View) -> Unit {
      let _ = sw.min_width(view::Live::Is(Some(SP_0))).cut()
      let _ = <ui::Text
        in={sw}
        size={TX_FOOTNOTE}
        color_by=>{lg::surface().ink_secondary}
        text_by=>{sub()}
      />.allow_ellipsis(view::Live::Is(true))
    })
  })
}

///| A 24pt glyph tile whose glyph and color follow the row it stands for.
fn chb_glyph_tile_by(parent : view::View, icon_by : () -> String, color_by : () -> Int64) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(SP_24)))
    .height(view::Live::Is(Some(SP_24)))
    .rigid()
    .radius(view::Live::Is(shell_tile_radius(SP_24)))
    .ground(view::Live::By(color_by))
    .points(view::Live::Is(false))
    .center()
    // Ink on the neutral tile, white on a color that says something (an insecure cookie).
    let _ = shell_icon_by(tile, icon_by, size=shell_tile_glyph(SP_24), color_by=fn() {
      if color_by() == mono_tile_ground() { lg::surface().ink } else { 0xFFFFFFFFL }
    })
  })
}

///| Empty state: a glyph tile, what is (not) here, why, and the one thing to do next.
fn chb_empty_state(
  parent : view::View,
  icon_name : String,
  title : () -> String,
  body : () -> String,
  action_label~ : () -> String = fn() { "" },
  on_action~ : () -> Unit = fn() { () },
) -> Unit {
  let _ = parent.box(fn(emp : view::View) -> Unit {
    let _ = emp
    .rigid()
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((SP_24, SP_40, SP_24, SP_40)))
    .gap(view::Live::Is(SP_6))
    let _ = emp.box(fn(tw : view::View) -> Unit {
      let _ = tw.rigid().padding(view::Live::Is((SP_0, SP_0, SP_0, SP_6)))
      let _ = shell_glyph_tile(tw, icon_name, size=SP_40)
    })
    let _ = <ui::Text
      in={emp}
      size={TX_CALLOUT}
      weight={500}
      center
      wrap
      color_by=>{lg::surface().ink}
      text_by=>{title()}
    />
    let _ = <ui::Text
      in={emp}
      size={TX_FOOTNOTE}
      center
      wrap
      color_by=>{lg::surface().ink_secondary}
      text_by=>{body()}
    />
    emp.show(fn() { action_label() != "" }, fn(aw : view::View) -> Unit {
      let _ = aw.rigid().padding(view::Live::Is((SP_0, SP_6, SP_0, SP_0)))
      let _ = lg::liquid_button_node(aw, action_label, on_action, flat=true, height=SP_32, pad_x=SP_12)
    })
  })
}

///| One page row (History, Bookmarks): site tile, title over host, a trailing value (`meta`, may be empty) that the
///| remove button replaces while the row is hovered or its open button is focused. The remove button is mounted with
///| `show` only then, so it never takes space or focus while hidden.
fn chb_page_row(
  parent : view::View,
  host : () -> String,
  title : () -> String,
  meta : () -> String,
  open_label : () -> String,
  remove_label : () -> String,
  on_open : () -> Unit,
  on_remove : () -> Unit,
  trailing_w : Double,
) -> Unit {
  let open_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let remove_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let _ = parent.box(fn(slot : view::View) -> Unit {
    let reveal = fn() -> Bool {
      let opened = match open_ref.v {
        Some(v) => v.focused()
        None => false
      }
      let removing = match remove_ref.v {
        Some(v) => v.focused()
        None => false
      }
      slot.pointed() || slot.pointed_in() || opened || removing
    }
    let hover_t = shell_fade(slot, fn() { slot.pointed() || slot.pointed_in() })
    // First-line alignment: the age sits on the title's line, the revealed remove button on its middle.
    let _ = slot
    .row(view::Live::Is(true))
    .lines_up_first_line(view::Live::Is(true))
    .rigid()
    .min_height(view::Live::Is(Some(SP_40)))
    .radius(view::Live::Is(SP_8))
    .padding(view::Live::Is((SP_0, SP_0, SP_4, SP_0)))
    .gap(view::Live::Is(SP_4))
    .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))

    let open_v = headless::button(
      slot,
      open_label,
      fn(_v : view::View) -> Unit { on_open() },
      fn(main : view::View, _b : headless::Button) -> Unit {
        let _ = main
        .row(view::Live::Is(true))
        .lines_up_first_line(view::Live::Is(true))
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(SP_0)))
        .min_width(view::Live::Is(Some(SP_0)))
        .min_height(view::Live::Is(Some(SP_40)))
        .padding(view::Live::Is((SP_8, SP_6, SP_0, SP_6)))
        .gap(view::Live::Is(SP_12))
        .radius(view::Live::Is(SP_8))
        .focus_ring_theme()
        let _ = shell_site_tile(main, host, size=SP_24)
        chb_two_lines(main, title, host)
      },
    )
    open_ref.v = Some(open_v)

    chb_trailing_reveal(slot, trailing_w, reveal, meta, remove_label, on_remove, remove_ref)
  })
}

///| A row's trailing slot: its value (`meta`) on the row's first line, or the remove button while `reveal` holds.
///| The slot keeps its width either way, so the title never re-truncates as the button comes and goes.
fn chb_trailing_reveal(
  row : view::View,
  trailing_w : Double,
  reveal : () -> Bool,
  meta : () -> String,
  remove_label : () -> String,
  on_remove : () -> Unit,
  remove_ref : signals::Ref[Option[view::View]],
) -> Unit {
  let _ = row.box(fn(tr : view::View) -> Unit {
    let _ = tr
    .width(view::Live::Is(Some(trailing_w)))
    .margin(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
    .rigid()
    .row(view::Live::Is(true))
    .lines_up_first_line(view::Live::Is(true))
    .justify(view::Lies::End)
    tr.show(fn() { !reveal() && meta() != "" }, fn(mw : view::View) -> Unit {
      let _ = mw.rigid().padding(view::Live::Is((SP_0, SP_0, SP_8, SP_0)))
      let _ = <ui::Text
        in={mw}
        size={TX_FOOTNOTE}
        color_by=>{lg::surface().ink_tertiary}
        text_by=>{meta()}
      />
    })
    tr.show(reveal, fn(rw : view::View) -> Unit {
      // Laid out as tall as its 24pt face, so revealing it never makes the row taller; the 32pt target overhangs.
      let _ = rw.rigid().height(view::Live::Is(Some(SP_24))).center()
      let _ = chb_icon_btn(rw, remove_label, ICON_CLOSE, on_remove, danger=true, capture_ref=remove_ref)
    })
  })
}

///| The History and Bookmarks drawer: 400pt on the trailing side; below 560pt it spans the window (less its inset), so
///| no clipped sliver of the page is left beside it. `footer` is mounted only while `footer_when` holds, so an empty
///| drawer has no footer bar or rule. Each width / footer combination is its own mount, one shown at a time.
fn chb_drawer(
  root : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  body : (view::View) -> Unit,
  footer? : (view::View) -> Unit,
  footer_when~ : () -> Bool = fn() { true },
) -> Unit {
  let narrow = fn() -> Bool {
    let ww = root.window_w()
    ww > SP_0 && ww < SP_160 * 3.0 + SP_80
  }
  let has_footer = fn() -> Bool { footer.is_some() && footer_when() }
  let mount = fn(slot : view::View, width : Double, with_footer : Bool) -> Unit {
    let _ = slot.over(view::Live::Is(true))
    // Inside the page card like Page Controls (SHELL_FRAME_GAP + SP_8 from the window), so the drawer's corner
    // never sits on the card's corner; the shell's own header (`shell_panel_header`) instead of lg's.
    let _ = lg::liquid_drawer_node(
      slot,
      open,
      on_close,
      title,
      fn(b : view::View) -> Unit {
        let _ = shell_panel_header(b, title, "Close " + signals::untracked(title), on_close)
        body(b)
      },
      side=lg::DrawerSide::Trailing,
      width=width,
      footer?=if with_footer { footer } else { None },
      scrim=true,
      inset=SHELL_FRAME_GAP + SP_8,
      show_header=false,
    )
  }
  // Narrow: ask for more than the window has; the drawer narrows itself to the window less its inset.
  for nf in [(true, true), (true, false), (false, true), (false, false)] {
    let (is_narrow, with_footer) = nf
    root.show(fn() { narrow() == is_narrow && has_footer() == with_footer }, fn(slot : view::View) -> Unit {
      mount(slot, if is_narrow { SP_160 * 4.0 } else { chb_drawer_w() }, with_footer)
    })
  }
}

// ============================================================================
// 1. Cookies inspector
// ============================================================================

///| Props for `build_cookies_inspector_modal`.
///| `owner_pane`, `site_host` and `space_id` are read when a delete or clear happens, so they always target the pane
///| and host the inspector was opened for.
pub struct CookiesInspectorProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub site_host : () -> String
  pub space_id : () -> String
  pub cookies : () -> Array[proto::SiteCookieRow]
  pub filter_field : ui::Field
  pub show_back_to_site_info : () -> Bool
  pub on_back_to_site_info : () -> Unit
  pub on_delete_cookie : (Int, String, String, String, String) -> Unit
  pub on_clear_site : (Int, String) -> Unit
  pub on_close : () -> Unit
  pub return_focus : Option[view::View]
}

#derive(Eq)
struct CookieKeyedRow {
  key : String
  name : String
  domain : String
  path : String
  secure : Bool
  http_only : Bool
  same_site : String
  partitioned : Bool
  expires_label : String
  is_session : Bool
  is_first_in_group : Bool
}

impl signals::Eq for CookieKeyedRow {
  fn eq(self : CookieKeyedRow, other : CookieKeyedRow) -> Bool {
    self.key == other.key &&
    self.name == other.name &&
    self.domain == other.domain &&
    self.path == other.path &&
    self.secure == other.secure &&
    self.http_only == other.http_only &&
    self.same_site == other.same_site &&
    self.partitioned == other.partitioned &&
    self.expires_label == other.expires_label &&
    self.is_session == other.is_session &&
    self.is_first_in_group == other.is_first_in_group
  }
}

///| The cookie's attributes as one plain phrase (`Path /v2, Secure, HttpOnly, SameSite Lax`).
fn cookie_attr_phrase(r : CookieKeyedRow) -> String {
  let parts : Array[String] = []
  if r.path != "" && r.path != "/" {
    parts.push("Path " + r.path)
  }
  if r.secure {
    parts.push("Secure")
  }
  if r.http_only {
    parts.push("HttpOnly")
  }
  parts.push("SameSite " + proto::normalize_cookie_same_site(r.same_site))
  if r.partitioned {
    parts.push("Partitioned")
  }
  let mut out = ""
  let mut i = 0
  while i < parts.length() {
    out = if i == 0 { parts[i] } else { out + ", " + parts[i] }
    i += 1
  }
  out
}

///| How a cookie travels, as a tile: partitioned (teal layers), Secure (green lock), or sent over HTTP (orange).
fn cookie_tile(r : CookieKeyedRow) -> (String, Int64) {
  // Color only for the security state worth a look (sent over plain HTTP); the rest monochrome.
  if !r.secure {
    (ICON_ALERT_CIRCLE, 0xFF9500FFL)
  } else if r.partitioned {
    (ICON_LAYERS, mono_tile_ground())
  } else {
    (ICON_LOCK, mono_tile_ground())
  }
}

///| Caption for a cookie domain group: a leading dot means the host and every subdomain.
fn cookie_domain_caption(domain : String) -> String {
  if domain.starts_with(".") && domain.length() > 1 {
    domain.slice(1, domain.length()) + " and subdomains"
  } else {
    domain
  }
}

///| One cookie: its tile, name over attributes, and when it expires, which the delete button replaces while the row
///| is hovered or focused. The row itself takes the focus (said as "Cookie <name>"), so Tab reaches it and then its
///| delete button, the same reveal as a History row.
fn chb_cookie_row(parent : view::View, row_sig : signals::Signal[CookieKeyedRow], on_delete : () -> Unit) -> Unit {
  let del_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let _ = parent.box(fn(crow : view::View) -> Unit {
    let reveal = fn() -> Bool {
      let deleting = match del_ref.v {
        Some(v) => v.focused()
        None => false
      }
      crow.pointed() || crow.pointed_in() || crow.focused() || deleting
    }
    let hover_t = shell_fade(crow, fn() { crow.pointed() || crow.pointed_in() })
    let _ = crow
    .row(view::Live::Is(true))
    .lines_up_first_line(view::Live::Is(true))
    .rigid()
    .min_height(view::Live::Is(Some(SP_40)))
    .radius(view::Live::Is(SP_8))
    .padding(view::Live::Is((SP_0, SP_0, SP_4, SP_0)))
    .gap(view::Live::Is(SP_4))
    .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
    .focusable(view::Live::Is(true), keys=0)
    .says(view::Live::By(fn() {
      let r = row_sig.get()
      Some(view::said(view::Role::Row, label="Cookie " + r.name, description=cookie_attr_phrase(r)))
    }))
    let _ = crow.box(fn(main : view::View) -> Unit {
      let _ = main
      .row(view::Live::Is(true))
      .lines_up_first_line(view::Live::Is(true))
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_0)))
      .min_height(view::Live::Is(Some(SP_40)))
      .padding(view::Live::Is((SP_8, SP_6, SP_0, SP_6)))
      .gap(view::Live::Is(SP_12))
      let _ = main.box(fn(tw : view::View) -> Unit {
        let _ = tw.rigid()
        chb_glyph_tile_by(tw, fn() { cookie_tile(row_sig.get()).0 }, fn() { cookie_tile(row_sig.get()).1 })
      })
      chb_two_lines(main, fn() { row_sig.get().name }, fn() { cookie_attr_phrase(row_sig.get()) }, title_weight=500)
    })
    chb_trailing_reveal(
      crow,
      SP_96,
      reveal,
      fn() {
        let r = row_sig.get()
        if r.is_session || r.expires_label == "" { "Session" } else { r.expires_label }
      },
      fn() { "Delete cookie " + row_sig.get().name },
      on_delete,
      del_ref,
    )
  })
}

///| Builds the centered cookies inspector dialog for one site.
pub fn build_cookies_inspector_modal(root : view::View, props : CookiesInspectorProps) -> Unit {
  let close_fn = props.on_close
  let filtered = fn() -> Array[proto::SiteCookieRow] {
    proto::filter_site_cookies((props.cookies)(), props.filter_field.text())
  }
  // Domains in the order they first appear.
  let domains = fn() -> Array[String] {
    let raw = filtered()
    let out : Array[String] = []
    let mut i = 0
    while i < raw.length() {
      let d = raw[i].domain
      let mut seen = false
      let mut j = 0
      while j < out.length() {
        if out[j] == d {
          seen = true
          break
        }
        j += 1
      }
      if !seen {
        out.push(d)
      }
      i += 1
    }
    out
  }
  let rows_in = fn(domain : String) -> Array[CookieKeyedRow] {
    let raw = filtered()
    let out : Array[CookieKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let c = raw[i]
      if c.domain == domain {
        out.push(CookieKeyedRow::{
          key: c.domain + "|" + c.path + "|" + c.name + "|" + i.to_string(),
          name: c.name,
          domain: c.domain,
          path: c.path,
          secure: c.secure,
          http_only: c.http_only,
          same_site: c.same_site,
          partitioned: c.partitioned,
          expires_label: c.expires_label,
          is_session: c.is_session,
          is_first_in_group: out.length() == 0,
        })
      }
      i += 1
    }
    out
  }
  let shown_host = fn() -> String {
    let h = (props.site_host)().trim()
    if h == "" {
      "This site"
    } else {
      let disp = proto::omnibox_display_host(h)
      if disp != "" { disp } else { h }
    }
  }

  // Opened by the person: the shared dialog presence. Already open when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_DIALOG_OUT_MS, fn(dlg_wrap : view::View) -> Unit {
    let close_now = shell_closes(dlg_wrap, close_fn)
    let reveal = shell_dialog_reveal(dlg_wrap, built.v)
    reveal.fades(dlg_wrap)
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Cookies and site data" },
      props.open,
      close_now,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center().padding(view::Live::Is((SP_16, SP_16, SP_16, SP_16)))

        // Pointer-blocking scrim.
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x00000066L } else { 0x0000002EL } }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { close_now() })
        })

        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          reveal.grows_only(shell)
          let _ = shell
          .width(view::Live::By(fn() -> Option[Double] {
            let want = SP_160 * 3.0 + SP_80
            let ww = shell.window_w()
            Some(if ww > SP_0 && ww - SP_32 < want { ww - SP_32 } else { want })
          }))
          .padding(view::Live::Is((SP_24, SP_24, SP_24, SP_24)))
          .gap(view::Live::Is(SP_16))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          // Header: the shell's one panel header; leading is what identifies the subject (Back to Site Info, then
          // the site's tile), the host under the title.
          let _ = shell_panel_header(
            shell,
            fn() { "Cookies and site data" },
            "Close Site Cookies",
            close_now,
            subtitle_by=shown_host,
            leading=Some(fn(lw : view::View) -> Unit {
              lw.show(props.show_back_to_site_info, fn(back_slot : view::View) -> Unit {
                let _ = back_slot.rigid()
                let _ = shell_panel_icon_btn(back_slot, fn() { "Back to Site Info" }, ICON_BACK, props.on_back_to_site_info)
              })
              let _ = shell_site_tile(lw, fn() { (props.site_host)().trim() }, size=SP_32)
            }),
          )

          // The filter comes with the first cookie (and stays while it holds text).
          shell.show(fn() { (props.cookies)().length() > 0 || props.filter_field.text() != "" }, fn(fw : view::View) -> Unit {
            let _ = fw.rigid()
            chb_search_field(
              fw,
              props.filter_field,
              "Filter by name, domain or attribute",
              "Filter Cookies",
              "Clear Cookie Filter",
              fn() { props.filter_field.set("") },
            )
          })

          // Cookies grouped by domain: as tall as they are, up to the window less the header, search and footer;
          // a hairline at the foot while more is below.
          let list_scroll = view::Scroll::new()
          let _ = shell.box(fn(body_wrap : view::View) -> Unit {
            let _ = body_wrap
            .max_height(view::Live::By(fn() -> Option[Double] {
              let wh = body_wrap.window_h()
              let room = wh - SP_160 - SP_80
              Some(if wh <= SP_0 { SP_160 * 3.0 } else if room < SP_160 { SP_160 } else { room })
            }))
            .min_height(view::Live::Is(Some(SP_160)))
            .min_width(view::Live::Is(Some(SP_0)))
            .cut()
            let _ = ui::scroll_box(body_wrap, scroll=list_scroll, fn(sc : view::View) -> Unit {
              let _ = sc.gap(view::Live::Is(SP_16))

              sc.show(fn() { filtered().length() == 0 }, fn(ew : view::View) -> Unit {
                let filtering = fn() { props.filter_field.text().trim() != "" }
                chb_empty_state(
                  ew,
                  ICON_SHIELD,
                  fn() {
                    if filtering() {
                      "No cookies match “" + props.filter_field.text().trim() + "”"
                    } else {
                      "No cookies for " + shown_host()
                    }
                  },
                  fn() {
                    if filtering() {
                      "Filter by a cookie's name, its domain, or an attribute such as Secure."
                    } else {
                      "Cookies this site sets in this Space will be listed here."
                    }
                  },
                  action_label=fn() { if filtering() { "Show All Cookies" } else { "" } },
                  on_action=fn() { props.filter_field.set("") },
                )
              })

              sc.each(
                domains,
                fn(d : String) -> String { d },
                fn(gslot : view::View, dom_sig : signals::Signal[String]) -> Unit {
                  chb_group(
                    gslot,
                    fn() { cookie_domain_caption(dom_sig.get()) },
                    fn() { "" },
                    fn(card : view::View) -> Unit {
                      card.each(
                        fn() { rows_in(dom_sig.get()) },
                        fn(r : CookieKeyedRow) -> String { r.key },
                        fn(rslot : view::View, row_sig : signals::Signal[CookieKeyedRow]) -> Unit {
                          rslot.show(fn() { !row_sig.get().is_first_in_group }, fn(rw : view::View) -> Unit {
                            chb_rule(rw)
                          })
                          chb_cookie_row(rslot, row_sig, fn() -> Unit {
                            // Forwards `(owner_pane, site_host, name, domain, path)` read at the press.
                            let r = row_sig.untracked()
                            let pane = signals::untracked(props.owner_pane)
                            let host = signals::untracked(props.site_host)
                            (props.on_delete_cookie)(pane, host, r.name, r.domain, r.path)
                          })
                        },
                      )
                    },
                  )
                },
              )

              sc.show(fn() { filtered().length() > 0 }, fn(fw : view::View) -> Unit {
                let _ = fw.rigid().padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
                let _ = <ui::Text
                  in={fw}
                  size={TX_FOOTNOTE}
                  wrap
                  color_by=>{lg::surface().ink_secondary}
                  text="Secure cookies travel only over HTTPS. Partitioned cookies are kept apart for each site you visit. Orange marks a cookie that can be sent over plain HTTP."
                />
              })
            })
          })
          // Scroll edge: shown only while the list runs past the bottom of its box.
          shell.show(fn() { list_scroll.reach() > SP_0 && !list_scroll.at_foot_now() }, fn(edge : view::View) -> Unit {
            let _ = edge
            .height(view::Live::Is(Some(lg::hairline_w)))
            .rigid()
            .margin(view::Live::Is((SP_0, -SP_16, SP_0, SP_0)))
            .ground(view::Live::By(fn() { lg::surface().separator }))
          })

          // Footer: which Space holds them, clear, done.
          let _ = shell.box(fn(ftr : view::View) -> Unit {
            let _ = ftr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(SP_8))
            .rigid()
            let _ = ftr.box(fn(info : view::View) -> Unit {
              let _ = info.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
              let _ = <ui::Text
                in={info}
                size={TX_FOOTNOTE}
                wrap
                color_by=>{lg::surface().ink_secondary}
                text_by=>{
                  let sp = (props.space_id)().trim()
                  if sp != "" { "Stored in the " + sp + " Space" } else { "" }
                }
              />
            })
            // Nothing to clear on a site that set nothing.
            ftr.show(fn() { (props.cookies)().length() > 0 }, fn(cw : view::View) -> Unit {
              let _ = cw.rigid()
              let _ = lg::liquid_button_node(
                cw,
                fn() { "Clear Site Cookies" },
                fn() -> Unit {
                  let pane = signals::untracked(props.owner_pane)
                  let host = signals::untracked(props.site_host)
                  (props.on_clear_site)(pane, host)
                },
                flat=true,
                height=SP_32,
                pad_x=SP_12,
                content=chb_danger_label("Clear Site Cookies"),
              )
            })
            let done_btn = lg::liquid_button_node(ftr, fn() { "Done" }, close_now, prominent=true, height=SP_32, pad_x=SP_16)
            let _ = done_btn.ask_focus()
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if (how is headless::OverlayDismiss::Escape) && props.filter_field.composing() {
          props.filter_field.compose("")
          return true
        }
        false
      },
      return_focus?=props.return_focus,
    )
  })
  built.v = true
}

// ============================================================================
// 2. History drawer
// ============================================================================

///| Props for `build_history_drawer_panel`.
pub struct HistoryDrawerProps {
  pub open : () -> Bool
  pub items : () -> Array[proto::HistoryItemSummary]
  pub total_count : () -> Int
  pub now_secs : () -> Int64
  pub search_field : ui::Field
  pub on_query_change : (String) -> Unit
  pub on_open_url : (String) -> Unit
  pub on_delete_url : (String) -> Unit
  pub on_clear_range : (String) -> Unit
  pub on_close : () -> Unit
}

#derive(Eq)
struct HistoryKeyedRow {
  key : String
  url : String
  title : String
  host : String
  last_visit_secs : Int64
  is_first_in_group : Bool
}

impl signals::Eq for HistoryKeyedRow {
  fn eq(self : HistoryKeyedRow, other : HistoryKeyedRow) -> Bool {
    self.key == other.key &&
    self.url == other.url &&
    self.title == other.title &&
    self.host == other.host &&
    self.last_visit_secs == other.last_visit_secs &&
    self.is_first_in_group == other.is_first_in_group
  }
}

fn history_shown_count(items : Array[proto::HistoryItemSummary], query : String) -> Int {
  let n = proto::history_filter_items(items, query).length()
  if n > proto::HISTORY_DRAWER_MAX_ITEMS { proto::HISTORY_DRAWER_MAX_ITEMS } else { n }
}

fn history_bucket_rows(
  items : Array[proto::HistoryItemSummary],
  query : String,
  now_s : Int64,
  target_bucket : Int,
) -> Array[HistoryKeyedRow] {
  let filtered = proto::history_filter_items(items, query)
  let limit = history_shown_count(items, query)
  let out : Array[HistoryKeyedRow] = []
  let mut i = 0
  while i < limit {
    let it = filtered[i]
    if proto::history_time_bucket(it.last_visit_secs, now_s) == target_bucket {
      let (h, _) = shell_url_parts(it.url)
      let host = if it.host != "" { it.host } else { h }
      out.push(HistoryKeyedRow::{
        key: it.url + "|" + it.last_visit_secs.to_string() + "|" + i.to_string(),
        url: it.url,
        title: if it.title.trim() != "" { it.title } else if host != "" { host } else { it.url },
        host,
        last_visit_secs: it.last_visit_secs,
        is_first_in_group: out.length() == 0,
      })
    }
    i += 1
  }
  out
}

///| What a History row shows at its end, chosen so it never repeats its group's caption: how long ago (Today), the
///| time of day (Yesterday), or the date (Earlier). Same UTC calendar as `proto::history_time_bucket`.
fn history_row_meta(bucket : Int, last_visit_secs : Int64, now_secs : Int64) -> String {
  if last_visit_secs <= 0L {
    return ""
  }
  if bucket == proto::HISTORY_BUCKET_TODAY {
    proto::format_history_age(last_visit_secs, now_secs)
  } else if bucket == proto::HISTORY_BUCKET_YESTERDAY {
    let secs = last_visit_secs % 86400L
    let h24 = (secs / 3600L).to_int()
    let m = ((secs % 3600L) / 60L).to_int()
    let h12 = if h24 % 12 == 0 { 12 } else { h24 % 12 }
    let mm = if m < 10 { "0" + m.to_string() } else { m.to_string() }
    h12.to_string() + ":" + mm + (if h24 < 12 { " AM" } else { " PM" })
  } else {
    // Asked as of two days on, `format_history_age` always gives the date.
    proto::format_history_age(last_visit_secs, last_visit_secs + 172800L)
  }
}

fn build_history_group_section(parent : view::View, bucket : Int, props : HistoryDrawerProps) -> Unit {
  let rows_fn = fn() -> Array[HistoryKeyedRow] {
    history_bucket_rows((props.items)(), props.search_field.text(), (props.now_secs)(), bucket)
  }
  // A group mounts only while its day has at least one page.
  parent.show(fn() { rows_fn().length() > 0 }, fn(sec_wrap : view::View) -> Unit {
    chb_group(
      sec_wrap,
      fn() { proto::history_bucket_label(bucket) },
      fn() { "" },
      fn(card : view::View) -> Unit {
        card.each(
          rows_fn,
          fn(r : HistoryKeyedRow) -> String { r.key },
          fn(rwrap : view::View, row_sig : signals::Signal[HistoryKeyedRow]) -> Unit {
            rwrap.show(fn() { !row_sig.get().is_first_in_group }, fn(rw : view::View) -> Unit { chb_rule(rw) })
            chb_page_row(
              rwrap,
              fn() { row_sig.get().host },
              fn() { row_sig.get().title },
              fn() { history_row_meta(bucket, row_sig.get().last_visit_secs, (props.now_secs)()) },
              fn() { "Open " + row_sig.get().title },
              fn() { "Remove " + row_sig.get().title + " from History" },
              fn() {
                let u = row_sig.untracked().url
                (props.on_close)()
                if u != "" {
                  (props.on_open_url)(u)
                }
              },
              fn() { (props.on_delete_url)(row_sig.untracked().url) },
              SP_80,
            )
          },
        )
      },
    )
  })
}

///| Range keys `on_clear_range` takes, with the labels of the segmented control that picks one.
fn history_clear_ranges() -> Array[(String, String)] {
  [("hour", "Past hour"), ("24h", "Past day"), ("7d", "Past week"), ("all", "All time")]
}

///| Builds the History drawer: search, then Today / Yesterday / Earlier (empty days never shown), then a footer
///| that picks a time range and clears it.
pub fn build_history_drawer_panel(root : view::View, props : HistoryDrawerProps) -> Unit {
  let guarded_close = fn() -> Unit {
    if props.search_field.composing() {
      props.search_field.compose("")
      return
    }
    (props.on_close)()
  }
  let clear_pick = signals::signal(0)
  let has_query = fn() { props.search_field.text().trim() != "" }

  chb_drawer(
    root,
    props.open,
    guarded_close,
    fn() { "History" },
    fn(body : view::View) -> Unit {
      let _ = body.fill().gap(view::Live::Is(SP_16))

      body.reacts(at_start=false, fn() { props.search_field.text() }, fn(q : String) -> Unit {
        if signals::untracked(props.open) {
          (props.on_query_change)(q)
        }
      })

      // Search comes with the first page (and stays while a query is typed, since the host answers the query).
      body.show(fn() { (props.items)().length() > 0 || props.search_field.text() != "" }, fn(sw : view::View) -> Unit {
        let _ = sw.rigid()
        chb_search_field(
          sw,
          props.search_field,
          "Search history",
          "Search History",
          "Clear History Search",
          fn() {
            props.search_field.set("")
            (props.on_query_change)("")
          },
          submitted=fn(_q : String) -> Unit {
            let list = proto::history_filter_items(signals::untracked(props.items), props.search_field.text())
            if list.length() > 0 {
              let u = list[0].url
              (props.on_close)()
              if u != "" {
                (props.on_open_url)(u)
              }
            }
          },
        )
      })

      let _ = body.box(fn(list_wrap : view::View) -> Unit {
        let _ = list_wrap.fill().clips(view::Live::Is(true))
        let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
          let _ = sc.gap(view::Live::Is(SP_20)).padding(view::Live::Is((SP_0, SP_0, SP_0, SP_8)))

          sc.show(
            fn() { proto::history_filter_items((props.items)(), props.search_field.text()).length() == 0 },
            fn(ew : view::View) -> Unit {
              chb_empty_state(
                ew,
                ICON_CLOCK,
                fn() {
                  if has_query() {
                    "No pages match “" + props.search_field.text().trim() + "”"
                  } else {
                    "No history yet"
                  }
                },
                fn() {
                  if has_query() {
                    "Search looks at page titles and addresses."
                  } else {
                    "Pages you visit appear here, grouped by day."
                  }
                },
                action_label=fn() { if has_query() { "Show All History" } else { "" } },
                on_action=fn() {
                  props.search_field.set("")
                  (props.on_query_change)("")
                },
              )
            },
          )

          build_history_group_section(sc, proto::HISTORY_BUCKET_TODAY, props)
          build_history_group_section(sc, proto::HISTORY_BUCKET_YESTERDAY, props)
          build_history_group_section(sc, proto::HISTORY_BUCKET_EARLIER, props)

          // Only the most recent pages are listed; say how to reach the rest.
          sc.show(
            fn() {
              let shown = history_shown_count((props.items)(), props.search_field.text())
              shown > 0 && (props.total_count)() > shown && !has_query()
            },
            fn(fw : view::View) -> Unit {
              let _ = fw.rigid().padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
              let _ = <ui::Text
                in={fw}
                size={TX_FOOTNOTE}
                wrap
                color_by=>{lg::surface().ink_secondary}
                text="Showing your most recent pages. Search to find older ones."
              />
            },
          )
        })
      })
    },
    // Nothing to clear without history: the footer comes with the first page.
    footer_when=fn() { (props.items)().length() > 0 || has_query() },
    footer=fn(ftr : view::View) -> Unit {
      let _ = ftr.box(fn(fw : view::View) -> Unit {
        let _ = fw.gap(view::Live::Is(SP_8))
        // The range picker spans the drawer; Clear History ends on the same right edge below it.
        let _ = lg::liquid_segmented_node(
          fw,
          fn() {
            let out : Array[String] = []
            for r in history_clear_ranges() {
              out.push(r.1)
            }
            out
          },
          fn() { clear_pick.get() },
          fn(i : Int) -> Unit { clear_pick.set(i) },
          height=SP_32,
          said="Clear History Range",
          // Selection moves the thumb and the ink only, never the weight (DESIGN.md §2).
          render_item=fn(seg : view::View, idx : Int, chosen : () -> Bool) -> Unit {
            let ranges = history_clear_ranges()
            let label = if idx >= 0 && idx < ranges.length() { ranges[idx].1 } else { "" }
            let _ = <ui::Text
              in={seg}
              size={TX_FOOTNOTE}
              weight={500}
              color_by=>{if chosen() { lg::surface().ink } else { lg::surface().ink_secondary }}
              text={label}
            />
          },
        )
        let _ = fw.box(fn(brow : view::View) -> Unit {
          let _ = brow.row(view::Live::Is(true)).justify(view::Lies::End).rigid()
          let _ = lg::liquid_button_node(
            brow,
            fn() { "Clear History" },
            fn() {
              let ranges = history_clear_ranges()
              let i = clear_pick.untracked()
              if i >= 0 && i < ranges.length() {
                (props.on_clear_range)(ranges[i].0)
              }
            },
            flat=true,
            height=SP_32,
            pad_x=SP_12,
            content=chb_danger_label("Clear history"),
          )
        })
      })
    },
  )
}

// ============================================================================
// 3. Bookmarks drawer
// ============================================================================

///| Props for `build_bookmarks_drawer_panel`.
pub struct BookmarksDrawerProps {
  pub open : () -> Bool
  pub snapshot : () -> proto::BookmarksSnapshot
  pub current_url : () -> String
  pub search_field : ui::Field
  pub on_toggle_current : () -> Unit
  pub on_open_url : (String) -> Unit
  pub on_delete_bookmark : (String) -> Unit
  pub on_close : () -> Unit
}

#derive(Eq)
struct BookmarkKeyedRow {
  key : String
  id : String
  title : String
  url : String
  host : String
  folder : String
  is_first_in_group : Bool
}

impl signals::Eq for BookmarkKeyedRow {
  fn eq(self : BookmarkKeyedRow, other : BookmarkKeyedRow) -> Bool {
    self.key == other.key &&
    self.id == other.id &&
    self.title == other.title &&
    self.url == other.url &&
    self.host == other.host &&
    self.folder == other.folder &&
    self.is_first_in_group == other.is_first_in_group
  }
}

///| Builds the Bookmarks drawer: a toggle for the current page, search, then bookmarks grouped by folder
///| (bookmarks outside any folder last, under "Other bookmarks" when folders exist).
pub fn build_bookmarks_drawer_panel(root : view::View, props : BookmarksDrawerProps) -> Unit {
  let filtered = fn() -> Array[proto::BookmarkEntry] {
    proto::bookmarks_filter((props.snapshot)(), props.search_field.text())
  }
  let folders = fn() -> Array[String] {
    let raw = filtered()
    let out : Array[String] = []
    let mut loose = false
    let mut i = 0
    while i < raw.length() {
      let f = raw[i].folder.trim()
      if f == "" {
        loose = true
      } else {
        let mut seen = false
        let mut j = 0
        while j < out.length() {
          if out[j] == f {
            seen = true
            break
          }
          j += 1
        }
        if !seen {
          out.push(f)
        }
      }
      i += 1
    }
    if loose {
      out.push("")
    }
    out
  }
  let rows_in = fn(folder : String) -> Array[BookmarkKeyedRow] {
    let raw = filtered()
    let out : Array[BookmarkKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let b = raw[i]
      if b.folder.trim() == folder {
        let h = shell_url_parts(b.url).0
        out.push(BookmarkKeyedRow::{
          key: (if b.id != "" { b.id } else { b.url }) + "|" + i.to_string(),
          id: b.id,
          title: if b.title.trim() != "" { b.title } else if h != "" { h } else { b.url },
          url: b.url,
          host: if h != "" { h } else { b.url },
          folder,
          is_first_in_group: out.length() == 0,
        })
      }
      i += 1
    }
    out
  }
  let is_current_saved = fn() -> Bool { proto::bookmarks_contains_url((props.snapshot)(), (props.current_url)()) }
  let has_query = fn() { props.search_field.text().trim() != "" }
  let open_first = fn() -> Unit {
    let list = filtered()
    if list.length() > 0 {
      let u = list[0].url
      (props.on_close)()
      if u != "" {
        (props.on_open_url)(u)
      }
    }
  }
  let guarded_close = fn() -> Unit {
    if props.search_field.composing() {
      props.search_field.compose("")
      return
    }
    (props.on_close)()
  }

  chb_drawer(
    root,
    props.open,
    guarded_close,
    fn() { "Bookmarks" },
    fn(body : view::View) -> Unit {
      let _ = body.fill().gap(view::Live::Is(SP_16))

      // The page you are on: one toggle, its host under the label.
      let _ = body.box(fn(cur : view::View) -> Unit {
        let _ = cur.rigid()
        let _ = lg::surface_card_node(
          cur,
          fn(card : view::View) -> Unit {
            // Tile and words on the first line; the toggle in the middle of the row, as a settings row's control.
            let _ = card.box(fn(row : view::View) -> Unit {
              let _ = row
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .min_height(view::Live::Is(Some(SP_40)))
              .padding(view::Live::Is((SP_8, SP_6, SP_8, SP_6)))
              .gap(view::Live::Is(SP_12))
              let _ = row.box(fn(lead : view::View) -> Unit {
                let _ = lead
                .row(view::Live::Is(true))
                .lines_up_first_line(view::Live::Is(true))
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(SP_0)))
                .min_width(view::Live::Is(Some(SP_0)))
                .gap(view::Live::Is(SP_12))
                let _ = shell_glyph_tile(lead, ICON_STAR_FILLED, size=SP_24)
                chb_two_lines(
                  lead,
                  fn() { "Bookmark this page" },
                  fn() {
                    let h = shell_url_parts((props.current_url)()).0
                    if h != "" { h } else { "No page open" }
                  },
                )
              })
              let _ = lg::liquid_toggle_node(
                row,
                is_current_saved,
                fn(_v : Bool) -> Unit { (props.on_toggle_current)() },
                fn() { "Bookmark Current Page" },
                disabled=fn() { (props.current_url)().trim() == "" },
              )
            })
          },
          radius=SP_12,
          pad=SP_4,
        )
      })

      // Search comes with the first bookmark (and stays while a query is typed).
      body.show(fn() { (props.snapshot)().items.length() > 0 || props.search_field.text() != "" }, fn(sw : view::View) -> Unit {
        let _ = sw.rigid()
        chb_search_field(
          sw,
          props.search_field,
          "Search bookmarks",
          "Search Bookmarks",
          "Clear Bookmark Search",
          fn() { props.search_field.set("") },
          submitted=fn(_q : String) -> Unit { open_first() },
        )
      })

      let _ = body.box(fn(list_wrap : view::View) -> Unit {
        let _ = list_wrap.fill().clips(view::Live::Is(true))
        let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
          let _ = sc.gap(view::Live::Is(SP_20)).padding(view::Live::Is((SP_0, SP_0, SP_0, SP_8)))

          sc.show(fn() { filtered().length() == 0 }, fn(ew : view::View) -> Unit {
            chb_empty_state(
              ew,
              ICON_STAR_FILLED,
              fn() { if has_query() { "No matching bookmarks" } else { "No bookmarks yet" } },
              fn() {
                if has_query() {
                  "Search looks at bookmark titles and addresses."
                } else {
                  "Turn on Bookmark this page to save the page you're on."
                }
              },
              action_label=fn() { if has_query() { "Show All Bookmarks" } else { "" } },
              on_action=fn() { props.search_field.set("") },
            )
          })

          sc.each(
            folders,
            fn(f : String) -> String { if f == "" { "~loose" } else { f } },
            fn(gslot : view::View, folder_sig : signals::Signal[String]) -> Unit {
              chb_group(
                gslot,
                fn() {
                  let f = folder_sig.get()
                  if f != "" {
                    f
                  } else if folders().length() > 1 {
                    "Other bookmarks"
                  } else {
                    ""
                  }
                },
                fn() { "" },
                fn(card : view::View) -> Unit {
                  card.each(
                    fn() { rows_in(folder_sig.get()) },
                    fn(r : BookmarkKeyedRow) -> String { r.key },
                    fn(rwrap : view::View, row_sig : signals::Signal[BookmarkKeyedRow]) -> Unit {
                      rwrap.show(fn() { !row_sig.get().is_first_in_group }, fn(rw : view::View) -> Unit { chb_rule(rw) })
                      chb_page_row(
                        rwrap,
                        fn() { row_sig.get().host },
                        fn() { row_sig.get().title },
                        fn() { "" },
                        fn() { "Open bookmark " + row_sig.get().title },
                        fn() { "Delete bookmark " + row_sig.get().title },
                        fn() {
                          let u = row_sig.untracked().url
                          (props.on_close)()
                          if u != "" {
                            (props.on_open_url)(u)
                          }
                        },
                        fn() {
                          let r = row_sig.untracked()
                          (props.on_delete_bookmark)(if r.id != "" { r.id } else { r.url })
                        },
                        SP_32,
                      )
                    },
                  )
                },
              )
            },
          )
        })
      })
    },
  )
}
