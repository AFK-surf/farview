///| Farview Desktop Shell 2.0 Phase 3B — Liquid Glass Deep Drawers & Modals (Part 1):
///| 1. Site Cookies & Storage Inspector Modal (`build_cookies_inspector_modal`)
///| 2. History Drawer (`build_history_drawer_panel`)
///| 3. Bookmarks Drawer (`build_bookmarks_drawer_panel`)
///|
///| Architecture invariants:
///| - Single-layer Liquid Glass ONLY on outermost Drawer (`lg::liquid_drawer_node`) or Dialog
///|   (`lg::liquid_dialog_shell_node`); 100% solid `lg::surface()` / `lg::surface_card_node` for
///|   all inner content sections, search bars, and list rows (zero nested glass).
///| - 100% vector icons from `packages/icons` via `shell_icon` (zero Unicode pseudo-icons).
///| - 100% explicit reactive `color_by` on every text node, Light + Dark parity.
///| - Accessible names on every interactive button and icon button.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Site Cookies & Storage Inspector Modal
// ============================================================================

///| Props for `build_cookies_inspector_modal`.
///| Explicitly binds `owner_pane`, `site_host`, and `space_id` so deletions and
///| site-wide clears always target the exact pane and host captured on open.
pub struct CookiesInspectorProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub site_host : () -> String
  pub space_id : () -> String
  pub cookies : () -> Array[proto::SiteCookieRow]
  pub filter_field : ui::Field
  pub show_back_to_site_info : () -> Bool
  pub on_back_to_site_info : () -> Unit
  pub on_delete_cookie : (Int, String, String, String, String) -> Unit
  pub on_clear_site : (Int, String) -> Unit
  pub on_close : () -> Unit
  pub return_focus : Option[view::View]
}

#derive(Eq)
struct CookieKeyedRow {
  key : String
  name : String
  domain : String
  path : String
  value_preview : String
  secure : Bool
  http_only : Bool
  same_site : String
  partitioned : Bool
  expires_label : String
  is_session : Bool
}

impl signals::Eq for CookieKeyedRow {
  fn eq(self : CookieKeyedRow, other : CookieKeyedRow) -> Bool {
    self.key == other.key &&
    self.name == other.name &&
    self.domain == other.domain &&
    self.path == other.path &&
    self.value_preview == other.value_preview &&
    self.secure == other.secure &&
    self.http_only == other.http_only &&
    self.same_site == other.same_site &&
    self.partitioned == other.partitioned &&
    self.expires_label == other.expires_label &&
    self.is_session == other.is_session
  }
}

fn cookie_badge(
  parent : view::View,
  label_fn : () -> String,
  bg_fn : () -> Int64,
  bd_fn : () -> Int64,
  ink_fn : () -> Int64,
) -> Unit {
  let _ = parent.box(fn(b : view::View) -> Unit {
    let _ = b
    .height(view::Live::Is(Some(20.0)))
    .rigid()
    .center()
    .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
    .radius(view::Live::Is(6.0))
    .ground(view::Live::By(bg_fn))
    .edge(view::Live::By(fn() { (lg::hairline_w, bd_fn()) }))
    let _ = <ui::Text in={b} size={10.0} weight={600} color_by=>{ink_fn()} text_by=>{label_fn()} />
  })
}

fn phase3b_icon_action_btn(
  parent : view::View,
  label_fn : () -> String,
  icon_name : String,
  on_press : () -> Unit,
  danger~ : Bool = false,
) -> view::View {
  headless::button(
    parent,
    label_fn,
    fn(_v : view::View) -> Unit { on_press() },
    fn(btn_v : view::View, btn : headless::Button) -> Unit {
      let _ = btn_v
      .width(view::Live::Is(Some(36.0)))
      .height(view::Live::Is(Some(36.0)))
      .rigid()
      .center()
      .radius(view::Live::Is(10.0))
      .ground(view::Live::By(fn() {
        if danger {
          if btn.pressed() || btn.hovered() {
            if lg::is_dark() { 0x451A22FFL } else { 0xFEE2E2FFL }
          } else {
            0x00000000L
          }
        } else if btn.pressed() || btn.hovered() {
          lg::surface().row_hover
        } else {
          0x00000000L
        }
      }))
      let _ = shell_icon(
        btn_v,
        icon_name,
        size=14.0,
        color_by=fn() {
          if danger && (btn.hovered() || btn.pressed()) {
            lg::surface().danger
          } else if btn.hovered() || btn.pressed() {
            lg::surface().ink
          } else {
            lg::surface().ink_secondary
          }
        },
      )
    },
  )
}

///| Builds the centered Liquid Glass Site Cookies & Data Inspector modal.
pub fn build_cookies_inspector_modal(root : view::View, props : CookiesInspectorProps) -> Unit {
  let close_fn = props.on_close
  let filtered_rows = fn() -> Array[CookieKeyedRow] {
    let raw = proto::filter_site_cookies((props.cookies)(), props.filter_field.text())
    let out : Array[CookieKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let c = raw[i]
      out.push(CookieKeyedRow::{
        key: c.domain + "|" + c.path + "|" + c.name + "|" + i.to_string(),
        name: c.name,
        domain: c.domain,
        path: c.path,
        value_preview: c.value_preview,
        secure: c.secure,
        http_only: c.http_only,
        same_site: c.same_site,
        partitioned: c.partitioned,
        expires_label: c.expires_label,
        is_session: c.is_session,
      })
      i += 1
    }
    out
  }

  root.show(props.open, fn(dlg_wrap : view::View) -> Unit {
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Site Cookies and Data" },
      props.open,
      close_fn,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center().padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))

        // Full-window pointer-blocking scrim
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x05081068L } else { 0x0F172A40L } }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { close_fn() })
        })

        // Outermost Liquid Glass Dialog Shell; all interior sections use solid `lg::surface()`
        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          let _ = shell
          .width(view::Live::Is(Some(584.0)))
          .max_height(view::Live::Is(Some(568.0)))
          .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
          .gap(view::Live::Is(12.0))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          // 1. Header: optional Back to SiteInfo + Title + Domain Pill + Count + Close
          let _ = shell.box(fn(hdr : view::View) -> Unit {
            let _ = hdr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(8.0))
            .rigid()

            hdr.show(props.show_back_to_site_info, fn(back_slot : view::View) -> Unit {
              let _ = phase3b_icon_action_btn(
                back_slot,
                fn() { "Back to Site Info" },
                ICON_BACK,
                props.on_back_to_site_info,
              )
            })

            let _ = <ui::Text
              in={hdr}
              size={15.0}
              weight={600}
              color_by=>{lg::surface().ink}
              text="Site Cookies & Data"
            />

            // Domain badge
            let _ = hdr.box(fn(dpill : view::View) -> Unit {
              let _ = dpill
              .height(view::Live::Is(Some(22.0)))
              .max_width(view::Live::Is(Some(180.0)))
              .shrink(view::Live::Is(1.0))
              .min_width(view::Live::Is(Some(0.0)))
              .clips(view::Live::Is(true))
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().accent_tint }))
              let _ = <ui::Text
                in={dpill}
                size={11.0}
                weight={600}
                color_by=>{lg::surface().accent}
                text_by=>{
                  let h = (props.site_host)().trim()
                  if h == "" {
                    "Current Site"
                  } else {
                    let disp = proto::omnibox_display_host(h)
                    if disp != "" { disp } else { h }
                  }
                }
              />.allow_ellipsis(view::Live::Is(true))
            })

            // Cookie count pill
            let _ = hdr.box(fn(cpill : view::View) -> Unit {
              let _ = cpill
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              let _ = <ui::Text
                in={cpill}
                size={11.0}
                weight={500}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{
                  let n = (props.cookies)().length()
                  if n == 1 { "1 cookie" } else { n.to_string() + " cookies" }
                }
              />
            })

            let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

            let _ = phase3b_icon_action_btn(hdr, fn() { "Close Site Cookies" }, ICON_CLOSE, close_fn)
          })

          // 2. Search Filter Input (solid surface, reuses `props.filter_field`)
          let _ = lg::liquid_text_field_node(
            shell,
            props.filter_field,
            placeholder="Filter cookies by name, domain, or attribute (Secure, CHIPS)...",
            height_by=fn() { 36.0 },
            label=fn() { "Filter Cookies" },
            show_label=false,
            flat=true,
            radius=10.0,
            lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
              let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink)
            },
            trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
              tr.show(fn() { props.filter_field.text() != "" }, fn(cw : view::View) -> Unit {
                let _ = phase3b_icon_action_btn(
                  cw,
                  fn() { "Clear Cookie Filter" },
                  ICON_CLOSE,
                  fn() { props.filter_field.set("") },
                )
              })
            },
          )

          // 3. Scrollable Solid Cookie Rows Body (bounded height for deterministic scrolling)
          let _ = shell.box(fn(body_wrap : view::View) -> Unit {
            let _ = body_wrap
            .height(view::Live::Is(Some(324.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .min_height(view::Live::Is(Some(0.0)))
            .rigid()
            .clips(view::Live::Is(true))
            .radius(view::Live::Is(lg::r_row))
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

            let _ = ui::scroll_box(body_wrap, fn(sc : view::View) -> Unit {
              let _ = sc.padding(view::Live::Is((10.0, 10.0, 10.0, 10.0))).gap(view::Live::Is(8.0))

              sc.show(fn() { filtered_rows().length() == 0 }, fn(emp_wrap : view::View) -> Unit {
                let _ = lg::surface_card_node(
                  emp_wrap,
                  fn(emp : view::View) -> Unit {
                    let _ = emp.min_height(view::Live::Is(Some(110.0))).center().gap(view::Live::Is(4.0))
                    let _ = <ui::Text
                      in={emp}
                      size={13.0}
                      weight={600}
                      color_by=>{lg::surface().ink}
                      text_by=>{
                        if props.filter_field.text().trim() != "" {
                          "No cookies match your filter"
                        } else {
                          "No cookies stored for this site"
                        }
                      }
                    />
                    let _ = <ui::Text
                      in={emp}
                      size={11.5}
                      color_by=>{lg::surface().ink_secondary}
                      text="Cookies set by HTTP headers or document.cookie appear here."
                    />
                  },
                  radius=lg::r_row,
                  pad=16.0,
                )
              })

              sc.each(
                filtered_rows,
                fn(r : CookieKeyedRow) -> String { r.key },
                fn(slot : view::View, row_sig : signals::Signal[CookieKeyedRow]) -> Unit {
                  let _ = lg::surface_card_node(
                    slot,
                    fn(crow : view::View) -> Unit {
                      let _ = crow
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Start)))
                      .gap(view::Live::Is(10.0))

                      // Left column: name + security badges, then domain/path + value preview + expiry
                      let _ = crow.box(fn(left : view::View) -> Unit {
                        let _ = left
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .gap(view::Live::Is(5.0))

                        let _ = left.box(fn(top_line : view::View) -> Unit {
                          let _ = top_line
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .gap(view::Live::Is(6.0))

                          let _ = top_line.box(fn(nm : view::View) -> Unit {
                            let _ = nm.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={nm}
                              size={13.0}
                              weight={600}
                              color_by=>{lg::surface().ink}
                              text_by=>{row_sig.get().name}
                            />.allow_ellipsis(view::Live::Is(true))
                          })

                          top_line.show(fn() { row_sig.get().secure }, fn(w : view::View) -> Unit {
                            cookie_badge(
                              w,
                              fn() { "Secure" },
                              fn() { if lg::is_dark() { 0x132C22FFL } else { 0xE6F4EAFFL } },
                              fn() { if lg::is_dark() { 0x204D3AFFL } else { 0xB7E1C4FFL } },
                              fn() { if lg::is_dark() { 0x6EE7B7FFL } else { 0x137333FFL } },
                            )
                          })

                          top_line.show(fn() { row_sig.get().http_only }, fn(w : view::View) -> Unit {
                            cookie_badge(
                              w,
                              fn() { "HttpOnly" },
                              fn() { lg::surface().accent_tint },
                              fn() { lg::surface().separator },
                              fn() { lg::surface().accent },
                            )
                          })

                          cookie_badge(
                            top_line,
                            fn() { "SameSite=" + proto::normalize_cookie_same_site(row_sig.get().same_site) },
                            fn() {
                              let is_none = proto::normalize_cookie_same_site(row_sig.get().same_site) == "None"
                              if is_none {
                                if lg::is_dark() { 0x342613FFL } else { 0xFEF3C7FFL }
                              } else {
                                lg::surface().card_secondary
                              }
                            },
                            fn() { lg::surface().separator },
                            fn() {
                              let is_none = proto::normalize_cookie_same_site(row_sig.get().same_site) == "None"
                              if is_none { lg::surface().warning } else { lg::surface().ink_secondary }
                            },
                          )

                          top_line.show(fn() { row_sig.get().partitioned }, fn(w : view::View) -> Unit {
                            cookie_badge(
                              w,
                              fn() { "CHIPS" },
                              fn() { if lg::is_dark() { 0x2A1F46FFL } else { 0xF3E8FFFFL } },
                              fn() { if lg::is_dark() { 0x4A3678FFL } else { 0xDDD6FEFFL } },
                              fn() { if lg::is_dark() { 0xC4B5FDFFL } else { 0x6D28D9FFL } },
                            )
                          })
                        })

                        let _ = left.box(fn(meta_line : view::View) -> Unit {
                          let _ = meta_line
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .gap(view::Live::Is(10.0))

                          let _ = meta_line.box(fn(dp : view::View) -> Unit {
                            let _ = dp.max_width(view::Live::Is(Some(180.0))).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={dp}
                              size={11.0}
                              weight={500}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                let r = row_sig.get()
                                r.domain + r.path
                              }
                            />.allow_ellipsis(view::Live::Is(true))
                          })

                          let _ = meta_line.box(fn(vp : view::View) -> Unit {
                            let _ = vp.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={vp}
                              size={11.0}
                              color_by=>{lg::surface().ink_tertiary}
                              text_by=>{row_sig.get().value_preview}
                            />.allow_ellipsis(view::Live::Is(true))
                          })

                          let _ = <ui::Text
                            in={meta_line}
                            size={10.5}
                            weight={500}
                            color_by=>{lg::surface().ink_tertiary}
                            text_by=>{
                              let r = row_sig.get()
                              if r.is_session { "Session" } else { "Exp " + r.expires_label }
                            }
                          />
                        })
                      })

                      // Trailing single-cookie delete button: explicitly forwards `(owner_pane, site_host, name, domain, path)`
                      let _ = phase3b_icon_action_btn(
                        crow,
                        fn() { "Delete cookie " + row_sig.get().name },
                        ICON_CLOSE,
                        fn() -> Unit {
                          let r = row_sig.untracked()
                          let pane = signals::untracked(props.owner_pane)
                          let host = signals::untracked(props.site_host)
                          (props.on_delete_cookie)(pane, host, r.name, r.domain, r.path)
                        },
                        danger=true,
                      )
                    },
                    radius=lg::r_row,
                    pad=10.0,
                  )
                },
              )
            })
          })

          // 4. Footer: Space partition info + Clear Site Cookies + Done
          let _ = shell.box(fn(ftr : view::View) -> Unit {
            let _ = ftr
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(8.0))
            .rigid()

            let _ = ftr.box(fn(info : view::View) -> Unit {
              let _ = info.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
              let _ = <ui::Text
                in={info}
                size={11.5}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{
                  let sp = (props.space_id)().trim()
                  let sp_lbl = if sp != "" { sp } else { "Default" }
                  let shown = filtered_rows().length()
                  let total = (props.cookies)().length()
                  if shown == total {
                    "Space: " + sp_lbl + "  |  " + total.to_string() + " stored"
                  } else {
                    "Space: " + sp_lbl + "  |  " + shown.to_string() + " of " + total.to_string()
                  }
                }
              />.allow_ellipsis(view::Live::Is(true))
            })

            let _ = lg::liquid_button_node(
              ftr,
              fn() { "Clear Site Cookies" },
              fn() -> Unit {
                let pane = signals::untracked(props.owner_pane)
                let host = signals::untracked(props.site_host)
                (props.on_clear_site)(pane, host)
              },
              flat=true,
              tint=lg::surface().danger,
            )

            let done_btn = lg::liquid_button_node(
              ftr,
              fn() { "Done" },
              close_fn,
              prominent=true,
            )
            let _ = done_btn.ask_focus()
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if (how is headless::OverlayDismiss::Escape) && props.filter_field.composing() {
          props.filter_field.compose("")
          return true
        }
        false
      },
      return_focus?=props.return_focus,
    )
  })
}

// ============================================================================
// 2. History Drawer (`lg::liquid_drawer_node`, solid content groups)
// ============================================================================

///| Props for `build_history_drawer_panel`.
pub struct HistoryDrawerProps {
  pub open : () -> Bool
  pub items : () -> Array[proto::HistoryItemSummary]
  pub total_count : () -> Int
  pub now_secs : () -> Int64
  pub search_field : ui::Field
  pub on_query_change : (String) -> Unit
  pub on_open_url : (String) -> Unit
  pub on_delete_url : (String) -> Unit
  pub on_clear_range : (String) -> Unit
  pub on_close : () -> Unit
}

#derive(Eq)
struct HistoryKeyedRow {
  key : String
  url : String
  title : String
  host : String
  visit_count : Int
  last_visit_secs : Int64
  is_first_in_group : Bool
}

impl signals::Eq for HistoryKeyedRow {
  fn eq(self : HistoryKeyedRow, other : HistoryKeyedRow) -> Bool {
    self.key == other.key &&
    self.url == other.url &&
    self.title == other.title &&
    self.host == other.host &&
    self.visit_count == other.visit_count &&
    self.last_visit_secs == other.last_visit_secs &&
    self.is_first_in_group == other.is_first_in_group
  }
}

fn history_bucket_rows(
  items : Array[proto::HistoryItemSummary],
  query : String,
  now_s : Int64,
  target_bucket : Int,
) -> Array[HistoryKeyedRow] {
  let filtered = proto::history_filter_items(items, query)
  let limit = if filtered.length() > proto::HISTORY_DRAWER_MAX_ITEMS {
    proto::HISTORY_DRAWER_MAX_ITEMS
  } else {
    filtered.length()
  }
  let out : Array[HistoryKeyedRow] = []
  let mut i = 0
  while i < limit {
    let it = filtered[i]
    if proto::history_time_bucket(it.last_visit_secs, now_s) == target_bucket {
      out.push(HistoryKeyedRow::{
        key: it.url + "|" + it.last_visit_secs.to_string() + "|" + i.to_string(),
        url: it.url,
        title: it.title,
        host: it.host,
        visit_count: it.visit_count,
        last_visit_secs: it.last_visit_secs,
        is_first_in_group: out.length() == 0,
      })
    }
    i += 1
  }
  out
}

fn build_history_group_section(
  parent : view::View,
  bucket : Int,
  props : HistoryDrawerProps,
) -> Unit {
  let rows_fn = fn() -> Array[HistoryKeyedRow] {
    history_bucket_rows(
      (props.items)(),
      props.search_field.text(),
      (props.now_secs)(),
      bucket,
    )
  }
  // Zero empty groups: section mounts ONLY when this time bucket has >= 1 item!
  parent.show(fn() { rows_fn().length() > 0 }, fn(sec_wrap : view::View) -> Unit {
    let _ = lg::surface_section_node(
      sec_wrap,
      fn(card : view::View) -> Unit {
        card.each(
          rows_fn,
          fn(r : HistoryKeyedRow) -> String { r.key },
          fn(rwrap : view::View, row_sig : signals::Signal[HistoryKeyedRow]) -> Unit {
            // Hairline separator strictly BETWEEN items (zero leading/trailing dangling dividers!)
            rwrap.show(fn() { !row_sig.get().is_first_in_group }, fn(sep_host : view::View) -> Unit {
              let _ = sep_host.padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
              let _ = sep_host.box(fn(hl : view::View) -> Unit {
                let _ = hl.height(view::Live::Is(Some(lg::hairline_w))).rigid().ground(view::Live::By(fn() { lg::surface().separator }))
              })
            })

            let _ = rwrap.box(fn(hrow : view::View) -> Unit {
              let _ = hrow
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .min_height(view::Live::Is(Some(48.0)))
              .padding(view::Live::Is((6.0, 4.0, 6.0, 4.0)))
              .gap(view::Live::Is(6.0))

              // Clickable main area
              let _ = headless::button(
                hrow,
                fn() { "Open " + row_sig.get().title },
                fn(_v : view::View) -> Unit {
                  let u = row_sig.untracked().url
                  (props.on_close)()
                  if u != "" {
                    (props.on_open_url)(u)
                  }
                },
                fn(hmain : view::View, hbtn : headless::Button) -> Unit {
                  let _ = hmain
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .basis(view::Live::Is(Some(0.0)))
                  .min_width(view::Live::Is(Some(0.0)))
                  .min_height(view::Live::Is(Some(40.0)))
                  .padding(view::Live::Is((6.0, 4.0, 6.0, 4.0)))
                  .gap(view::Live::Is(8.0))
                  .radius(view::Live::Is(10.0))
                  .ground(view::Live::By(fn() {
                    if hbtn.pressed() || hbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
                  }))

                  // Clock vector icon tile
                  let _ = hmain.box(fn(ic : view::View) -> Unit {
                    let _ = ic
                    .width(view::Live::Is(Some(26.0)))
                    .height(view::Live::Is(Some(26.0)))
                    .rigid()
                    .center()
                    .radius(view::Live::Is(lg::r_chip))
                    .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                    let _ = shell_icon(ic, ICON_CLOCK, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                  })

                  // Title + Host
                  let _ = hmain.box(fn(mid : view::View) -> Unit {
                    let _ = mid
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .gap(view::Live::Is(2.0))
                    .cut()
                    let _ = <ui::Text
                      in={mid}
                      size={12.5}
                      weight={500}
                      color_by=>{lg::surface().ink}
                      text_by=>{row_sig.get().title}
                    />.allow_ellipsis(view::Live::Is(true))
                    let _ = <ui::Text
                      in={mid}
                      size={11.0}
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{row_sig.get().host}
                    />.allow_ellipsis(view::Live::Is(true))
                  })

                  // Relative age + visit count
                  let _ = hmain.box(fn(meta : view::View) -> Unit {
                    let _ = meta.lines_up(view::Live::Is(Some(view::Along::End))).gap(view::Live::Is(2.0)).rigid()
                    let _ = <ui::Text
                      in={meta}
                      size={10.5}
                      color_by=>{lg::surface().ink_tertiary}
                      text_by=>{proto::format_history_age(row_sig.get().last_visit_secs, (props.now_secs)())}
                    />
                    let _ = <ui::Text
                      in={meta}
                      size={10.0}
                      weight={600}
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{
                        let v = row_sig.get().visit_count
                        if v == 1 { "1 visit" } else { v.to_string() + " visits" }
                      }
                    />
                  })
                },
              )

              // Per-item delete button
              let _ = phase3b_icon_action_btn(
                hrow,
                fn() { "Remove " + row_sig.get().title + " from History" },
                ICON_CLOSE,
                fn() -> Unit { (props.on_delete_url)(row_sig.untracked().url) },
                danger=true,
              )
            })
          },
        )
      },
      header=fn() { proto::history_bucket_label(bucket) },
      radius=lg::r_row,
      pad=0.0,
    )
  })
}

///| Builds the Liquid Glass History Drawer (`Today` / `Yesterday` / `Earlier` grouped, zero empty groups).
pub fn build_history_drawer_panel(root : view::View, props : HistoryDrawerProps) -> Unit {
  let subtitle_fn = fn() -> String {
    let q = props.search_field.text().trim()
    let total = (props.total_count)()
    let shown = proto::history_filter_items((props.items)(), q).length()
    if q != "" {
      shown.to_string() + " of " + total.to_string() + " matching"
    } else if total == 1 {
      "1 site visited"
    } else {
      total.to_string() + " sites visited"
    }
  }

  let guarded_close = fn() -> Unit {
    if props.search_field.composing() {
      props.search_field.compose("")
      return
    }
    (props.on_close)()
  }

  let _ = lg::liquid_drawer_node(
    root,
    props.open,
    guarded_close,
    fn() { "History" },
    fn(body : view::View) -> Unit {
      let _ = body.fill().gap(view::Live::Is(12.0))

      // Notify query changes reactively
      body.reacts(at_start=false, fn() { props.search_field.text() }, fn(q : String) -> Unit {
        if signals::untracked(props.open) {
          (props.on_query_change)(q)
        }
      })

      // Real-time Search Bar (solid flat surface, reuses `props.search_field`)
      let _ = lg::liquid_text_field_node(
        body,
        props.search_field,
        placeholder="Search history by title or URL...",
        height_by=fn() { 36.0 },
        label=fn() { "Search History" },
        show_label=false,
        flat=true,
        radius=10.0,
        lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
          let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink)
        },
        trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
          tr.show(fn() { props.search_field.text() != "" }, fn(cw : view::View) -> Unit {
            let _ = phase3b_icon_action_btn(
              cw,
              fn() { "Clear History Search" },
              ICON_CLOSE,
              fn() {
                props.search_field.set("")
                (props.on_query_change)("")
              },
            )
          })
        },
        submitted=fn(_q : String) -> Unit {
          let list = proto::history_filter_items(signals::untracked(props.items), props.search_field.text())
          if list.length() > 0 {
            let u = list[0].url
            (props.on_close)()
            if u != "" {
              (props.on_open_url)(u)
            }
          }
        },
      )

      // Bounded Scrollable Time-Grouped List (`Today` / `Yesterday` / `Earlier`)
      let _ = body.box(fn(list_wrap : view::View) -> Unit {
        let _ = list_wrap.fill().clips(view::Live::Is(true))
        let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
          let _ = sc.gap(view::Live::Is(12.0)).padding(view::Live::Is((0.0, 2.0, 0.0, 8.0)))

          // Empty state
          sc.show(
            fn() { proto::history_filter_items((props.items)(), props.search_field.text()).length() == 0 },
            fn(emp_wrap : view::View) -> Unit {
              let _ = lg::surface_card_node(
                emp_wrap,
                fn(emp : view::View) -> Unit {
                  let _ = emp.min_height(view::Live::Is(Some(100.0))).center().gap(view::Live::Is(4.0))
                  let _ = <ui::Text
                    in={emp}
                    size={13.0}
                    weight={600}
                    color_by=>{lg::surface().ink}
                    text_by=>{
                      let q = props.search_field.text().trim()
                      if q != "" {
                        "No matching history for \"" + q + "\""
                      } else {
                        "No browsing history yet"
                      }
                    }
                  />
                  let _ = <ui::Text
                    in={emp}
                    size={11.5}
                    color_by=>{lg::surface().ink_secondary}
                    text="Pages you visit appear here grouped by recency."
                  />
                },
                radius=lg::r_row,
                pad=16.0,
              )
            },
          )

          // 3 time buckets: 0 = Today, 1 = Yesterday, 2 = Earlier (zero empty groups!)
          build_history_group_section(sc, 0, props)
          build_history_group_section(sc, 1, props)
          build_history_group_section(sc, 2, props)
        })
      })
    },
    side=lg::DrawerSide::Trailing,
    width=444.0,
    subtitle=subtitle_fn,
    footer=fn(ftr : view::View) -> Unit {
      let _ = ftr.gap(view::Live::Is(6.0))
      let _ = <ui::Text
        in={ftr}
        size={11.0}
        weight={600}
        color_by=>{lg::surface().ink_secondary}
        text="Clear History"
      />
      let _ = ftr.box(fn(brow : view::View) -> Unit {
        let _ = brow.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_button_node(
          brow,
          fn() { "Last Hour" },
          fn() { (props.on_clear_range)("hour") },
          flat=true,
          height=30.0,
          pad_x=10.0,
        )
        let _ = lg::liquid_button_node(
          brow,
          fn() { "Last 24h" },
          fn() { (props.on_clear_range)("24h") },
          flat=true,
          height=30.0,
          pad_x=10.0,
        )
        let _ = lg::liquid_button_node(
          brow,
          fn() { "Last 7d" },
          fn() { (props.on_clear_range)("7d") },
          flat=true,
          height=30.0,
          pad_x=10.0,
        )
        let _ = lg::liquid_button_node(
          brow,
          fn() { "All" },
          fn() { (props.on_clear_range)("all") },
          flat=true,
          height=30.0,
          pad_x=10.0,
          tint=lg::surface().danger,
        )
      })
    },
    scrim=true,
    inset=12.0,
  )
}

// ============================================================================
// 3. Bookmarks Drawer (`lg::liquid_drawer_node`, solid content cards)
// ============================================================================

///| Props for `build_bookmarks_drawer_panel`.
pub struct BookmarksDrawerProps {
  pub open : () -> Bool
  pub snapshot : () -> proto::BookmarksSnapshot
  pub current_url : () -> String
  pub search_field : ui::Field
  pub on_toggle_current : () -> Unit
  pub on_open_url : (String) -> Unit
  pub on_delete_bookmark : (String) -> Unit
  pub on_close : () -> Unit
}

#derive(Eq)
struct BookmarkKeyedRow {
  key : String
  id : String
  title : String
  url : String
  host : String
  folder : String
}

impl signals::Eq for BookmarkKeyedRow {
  fn eq(self : BookmarkKeyedRow, other : BookmarkKeyedRow) -> Bool {
    self.key == other.key &&
    self.id == other.id &&
    self.title == other.title &&
    self.url == other.url &&
    self.host == other.host &&
    self.folder == other.folder
  }
}

///| Builds the Liquid Glass Bookmarks Drawer (live search, open, delete, toggle current page).
pub fn build_bookmarks_drawer_panel(root : view::View, props : BookmarksDrawerProps) -> Unit {
  let filtered_rows = fn() -> Array[BookmarkKeyedRow] {
    let raw = proto::bookmarks_filter((props.snapshot)(), props.search_field.text())
    let out : Array[BookmarkKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let b = raw[i]
      let h = proto::omnibox_display_host(b.url)
      out.push(BookmarkKeyedRow::{
        key: (if b.id != "" { b.id } else { b.url }) + "|" + i.to_string(),
        id: b.id,
        title: if b.title.trim() != "" { b.title } else if h != "" { h } else { b.url },
        url: b.url,
        host: if h != "" { h } else { b.url },
        folder: b.folder,
      })
      i += 1
    }
    out
  }

  let is_current_saved = fn() -> Bool {
    proto::bookmarks_contains_url((props.snapshot)(), (props.current_url)())
  }

  let guarded_close = fn() -> Unit {
    if props.search_field.composing() {
      props.search_field.compose("")
      return
    }
    (props.on_close)()
  }

  let _ = lg::liquid_drawer_node(
    root,
    props.open,
    guarded_close,
    fn() { "Bookmarks" },
    fn(body : view::View) -> Unit {
      let _ = body.fill().gap(view::Live::Is(12.0))

      // Top action: Bookmark / Bookmarked toggle for current page
      let _ = lg::liquid_button_node(
        body,
        fn() { if is_current_saved() { "Remove Bookmark for Current Page" } else { "Bookmark Current Page" } },
        props.on_toggle_current,
        content=fn(inner : view::View) -> Unit {
          let _ = inner.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(7.0))
          inner.show(is_current_saved, fn(ic : view::View) -> Unit {
            let _ = shell_icon(ic, ICON_STAR_FILLED, size=14.0, color_by=fn() { lg::surface().warning })
          })
          inner.show(fn() { !is_current_saved() }, fn(ic : view::View) -> Unit {
            let _ = shell_icon(ic, ICON_STAR, size=14.0, color_by=fn() { lg::surface().accent })
          })
          let _ = <ui::Text
            in={inner}
            size={12.5}
            weight={600}
            color_by=>{if is_current_saved() { lg::surface().warning } else { lg::surface().accent }}
            text_by=>{if is_current_saved() { "Bookmarked" } else { "Bookmark Current Page" }}
          />
        },
        flat=true,
        height=34.0,
      )

      // Search Input (reuses `props.search_field`)
      let _ = lg::liquid_text_field_node(
        body,
        props.search_field,
        placeholder="Search bookmarks by title or URL...",
        height_by=fn() { 36.0 },
        label=fn() { "Search Bookmarks" },
        show_label=false,
        flat=true,
        radius=10.0,
        lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
          let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink)
        },
        trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
          tr.show(fn() { props.search_field.text() != "" }, fn(cw : view::View) -> Unit {
            let _ = phase3b_icon_action_btn(
              cw,
              fn() { "Clear Bookmark Search" },
              ICON_CLOSE,
              fn() { props.search_field.set("") },
            )
          })
        },
        submitted=fn(_q : String) -> Unit {
          let list = filtered_rows()
          if list.length() > 0 {
            let u = list[0].url
            (props.on_close)()
            if u != "" {
              (props.on_open_url)(u)
            }
          }
        },
      )

      // Scrollable Bookmark Rows List
      let _ = body.box(fn(list_wrap : view::View) -> Unit {
        let _ = list_wrap.fill().clips(view::Live::Is(true))
        let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
          let _ = sc.gap(view::Live::Is(8.0)).padding(view::Live::Is((0.0, 2.0, 0.0, 8.0)))

          sc.show(fn() { filtered_rows().length() == 0 }, fn(emp_wrap : view::View) -> Unit {
            let _ = lg::surface_card_node(
              emp_wrap,
              fn(emp : view::View) -> Unit {
                let _ = emp.min_height(view::Live::Is(Some(100.0))).center().gap(view::Live::Is(4.0))
                let _ = <ui::Text
                  in={emp}
                  size={13.0}
                  weight={600}
                  color_by=>{lg::surface().ink}
                  text_by=>{
                    if props.search_field.text().trim() != "" {
                      "No matching bookmarks"
                    } else {
                      "No bookmarks saved yet"
                    }
                  }
                />
                let _ = <ui::Text
                  in={emp}
                  size={11.5}
                  color_by=>{lg::surface().ink_secondary}
                  text="Save pages here for instant access across sessions."
                />
              },
              radius=lg::r_row,
              pad=16.0,
            )
          })

          sc.each(
            filtered_rows,
            fn(r : BookmarkKeyedRow) -> String { r.key },
            fn(slot : view::View, row_sig : signals::Signal[BookmarkKeyedRow]) -> Unit {
              let _ = lg::surface_card_node(
                slot,
                fn(brow : view::View) -> Unit {
                  let _ = brow
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(6.0))

                  let _ = headless::button(
                    brow,
                    fn() { "Open bookmark " + row_sig.get().title },
                    fn(_v : view::View) -> Unit {
                      let u = row_sig.untracked().url
                      (props.on_close)()
                      if u != "" {
                        (props.on_open_url)(u)
                      }
                    },
                    fn(bmain : view::View, bbtn : headless::Button) -> Unit {
                      let _ = bmain
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .min_height(view::Live::Is(Some(40.0)))
                      .padding(view::Live::Is((6.0, 4.0, 6.0, 4.0)))
                      .gap(view::Live::Is(8.0))
                      .radius(view::Live::Is(8.0))
                      .ground(view::Live::By(fn() {
                        if bbtn.pressed() || bbtn.hovered() { lg::surface().row_hover } else { 0x00000000L }
                      }))

                      let _ = bmain.box(fn(sico : view::View) -> Unit {
                        let _ = sico
                        .width(view::Live::Is(Some(26.0)))
                        .height(view::Live::Is(Some(26.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(lg::r_chip))
                        .ground(view::Live::By(fn() { if lg::is_dark() { 0x362A14FFL } else { 0xFEF3C7FFL } }))
                        let _ = shell_icon(sico, ICON_STAR_FILLED, size=13.0, color_by=fn() { lg::surface().warning })
                      })

                      let _ = bmain.box(fn(mid : view::View) -> Unit {
                        let _ = mid
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .gap(view::Live::Is(2.0))
                        .cut()
                        let _ = <ui::Text
                          in={mid}
                          size={12.5}
                          weight={500}
                          color_by=>{lg::surface().ink}
                          text_by=>{row_sig.get().title}
                        />.allow_ellipsis(view::Live::Is(true))
                        let _ = mid.box(fn(sub_row : view::View) -> Unit {
                          let _ = sub_row
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .gap(view::Live::Is(6.0))
                          .min_width(view::Live::Is(Some(0.0)))
                          let _ = sub_row.box(fn(hw : view::View) -> Unit {
                            let _ = hw
                            .grow(view::Live::Is(1.0))
                            .shrink(view::Live::Is(1.0))
                            .basis(view::Live::Is(Some(0.0)))
                            .min_width(view::Live::Is(Some(0.0)))
                            .cut()
                            let _ = <ui::Text
                              in={hw}
                              size={11.0}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{row_sig.get().host}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                          sub_row.show(fn() { row_sig.get().folder.trim() != "" }, fn(fp : view::View) -> Unit {
                            let _ = fp
                            .height(view::Live::Is(Some(18.0)))
                            .max_width(view::Live::Is(Some(136.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                            .radius(view::Live::Is(5.0))
                            .cut()
                            .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                            let _ = <ui::Text
                              in={fp}
                              size={10.5}
                              weight={500}
                              color_by=>{lg::surface().accent}
                              text_by=>{row_sig.get().folder.trim()}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                        })
                      })
                    },
                  )

                  let _ = phase3b_icon_action_btn(
                    brow,
                    fn() { "Delete bookmark " + row_sig.get().title },
                    ICON_CLOSE,
                    fn() -> Unit {
                      let r = row_sig.untracked()
                      let target = if r.id != "" { r.id } else { r.url }
                      (props.on_delete_bookmark)(target)
                    },
                    danger=true,
                  )
                },
                radius=lg::r_row,
                pad=6.0,
              )
            },
          )
        })
      })
    },
    side=lg::DrawerSide::Trailing,
    width=420.0,
    subtitle=fn() {
      let n = (props.snapshot)().items.length()
      if n == 1 { "1 saved bookmark" } else { n.to_string() + " saved bookmarks" }
    },
    scrim=true,
    inset=12.0,
  )
}
