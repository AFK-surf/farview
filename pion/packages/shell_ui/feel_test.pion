///| Feel (hit areas, feedback, one highlight) regressions for the address palette, the Command Bar and the frame:
///| - every keyboard stop in a scene is at least 32pt and shows the keyboard focus (`Tree::focus_blind`);
///| - a palette row's lit area is its press area (the button node itself carries the fill), exactly one row is
///|   lit, in the Space color, and the pointer moves the selection without committing;
///| - Arc's Cmd+T bar: no captions, 48pt single-line rows, a 22pt field, the info button.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

///| Every live keyboard stop drawn in the window that is smaller than `min` on either side, by label.
fn feel_small_stops(min~ : Double = SP_32) -> Array[String] {
  let out : Array[String] = []
  match ui::view_tree() {
    Some(tree) => {
      for fa in tree.focus_order() {
        if fa.hosted {
          continue
        }
        match tree.drawn_of(fa.id) {
          Some(d) if d.w > 0.0 && d.h > 0.0 && d.alpha > 0.01 =>
          if d.w < min - 0.5 || d.h < min - 0.5 {
            out.push(tree.said_label(fa.id) + " \{d.w}x\{d.h}")
          }
          _ => ()
        }
      }
    }
    None => ()
  }
  out
}

///| Keyboard stops that show nothing of the focus, by label.
fn feel_focus_blind() -> Array[String] {
  let out : Array[String] = []
  match ui::view_tree() {
    Some(tree) => {
      for id in tree.focus_blind() {
        out.push(tree.said_label(id))
      }
    }
    None => ()
  }
  out
}

fn feel_join(xs : Array[String]) -> String {
  let mut s = ""
  for x in xs {
    s = if s == "" { x } else { s + ", " + x }
  }
  s
}

fn feel_cmd_item(kind : proto::CommandKind, id : String, title : String, subtitle : String, shortcut~ : String = "") -> proto::CommandBarItem {
  proto::CommandBarItem::{
    kind,
    id,
    title,
    subtitle,
    badge: if kind is proto::CommandKind::SwitchTab { "Work" } else { "" },
    shortcut,
    monogram: "",
    accent: 0L,
    is_space: kind is proto::CommandKind::SwitchSpace,
    is_tab: kind is proto::CommandKind::SwitchTab,
  }
}

///| Drawn nodes filled with exactly `ground`.
fn feel_count_ground(t : ui::Tester, ground : Int64) -> Int {
  let mut n = 0
  for d in t.drawn() {
    if d.ground == ground && d.w > SP_160 {
      n += 1
    }
  }
  n
}

test "feel: Command Bar is Arc's bar - no captions, 48pt rows, one lit row in the Space color, pointer selects" {
  let ctrl = make_demo_controller()
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::CommandBar, tag="command_bar"))
  let items = [
    feel_cmd_item(proto::CommandKind::SwitchTab, "t-hn", "Hacker News", "news.ycombinator.com"),
    feel_cmd_item(proto::CommandKind::SwitchTab, "t-gh", "Pull requests", "github.com/AFK-surf/farview/pulls"),
    feel_cmd_item(proto::CommandKind::Action, "toggle_bookmark", "Bookmark Current Page", "Save or remove", shortcut="⌘D"),
  ]
  let sel = signals::signal(0)
  let executed : signals::Ref[String] = ui::ref_new("")
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_command_bar_overlay(root, ctrl.model(), CommandBarProps::{
        field: ui::Field::new(),
        items: fn() { items },
        selected: fn() { sel.get() },
        on_query_change: fn(_q) { () },
        on_step: fn(d) {
          let n = sel.untracked() + d
          if n >= 0 && n < items.length() { sel.set(n) }
          true
        },
        on_submit: fn(_t) { () },
        on_execute: fn(it) { executed.v = it.id },
        on_close: fn() { () },
        on_row_view: None,
        on_clear_rows: None,
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=600.0)
  // No section captions; the field is the big Arc field with the info button.
  debug_assert(t.find("Tabs").is_none() && t.find("Commands").is_none(), "no section captions")
  debug_assert(t.get("Keyboard Hints").is_some(), "the info button is at the field's trailing edge")
  let fill = shell_palette_selected(ctrl.model())
  // The selected row: its own button box (the press area) carries the Space-colored fill, 48pt, white title.
  match t.get("Hacker News") {
    Some(r) => {
      debug_assert(r.ground == fill, "selected row's press box is the lit box")
      debug_assert((r.h - SP_48).abs() < 0.5, "48pt single-line row: \{r.h}")
    }
    None => debug_assert(false, "Hacker News row")
  }
  debug_assert(ui::contrast_ratio(fill, 0xFFFFFFFFL) >= 4.5, "white text reads on the selected fill")
  debug_assert(feel_count_ground(t, fill) == 1, "exactly one lit row")
  debug_assert(t.find("Switch to Tab").is_some(), "tab rows name their action")
  debug_assert(t.find("⌘D").is_some(), "a command row shows its shortcut")
  // The pointer moving onto row 2 moves the selection there (no second hover wash, nothing committed).
  match t.get("Bookmark Current Page") {
    Some(r) => {
      t.move_to(r.x + r.w / 2.0, r.y + r.h / 2.0)
      t.frame(ms=16.0)
      t.move_to(r.x + r.w / 2.0 + SP_4, r.y + r.h / 2.0)
      t.frame(ms=200.0)
    }
    None => debug_assert(false, "Bookmark row")
  }
  debug_assert(sel.untracked() == 2, "hover selected the pointed row: \{sel.untracked()}")
  debug_assert(executed.v == "", "hover never commits")
  match (t.get("Bookmark Current Page"), t.get("Hacker News")) {
    (Some(b), Some(h)) => {
      debug_assert(b.ground == fill, "the pointed row is the lit one")
      debug_assert(h.ground != fill, "the old row is no longer lit")
    }
    _ => debug_assert(false, "rows")
  }
  debug_assert(feel_count_ground(t, fill) == 1, "still exactly one lit row while hovering")
  t.press("Bookmark Current Page")
  t.frame(ms=16.0)
  debug_assert(executed.v == "toggle_bookmark", "a press runs the row")
  lg::assert_apple_ui(t, label="feel_command_bar")
  t.dispose()
}

test "feel: address palette - Arc field, no captions, one lit row, pointer moves the selection, Enter takes it" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }))
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.press("Address Bar")
  t.frame(ms=16.0)
  ctrl.omnibox_field.set("grid")
  ctrl.dispatch(ShellIntent::OmniboxEdit("grid"))
  t.frame(ms=200.0)
  let st = ctrl.omnibox_suggest.untracked()
  debug_assert(st.open && st.items.length() >= 2, "suggestions open: \{st.items.length()}")
  debug_assert(st.selected == 0, "the first row is preselected")
  debug_assert(t.find("Open tabs").is_none() && t.find("History").is_none() && t.find("Web search").is_none(), "no captions")
  debug_assert(t.get("Keyboard Hints").is_some(), "info button")
  let fill = shell_palette_selected(ctrl.model())
  debug_assert(feel_count_ground(t, fill) == 1, "exactly one lit row")
  // The last row (a history entry; the open tab's title is also a sidebar row).
  let last = st.items.length() - 1
  let second = st.items[last].title
  match t.get(second) {
    Some(r) => {
      debug_assert((r.h - SP_48).abs() < 0.5, "48pt row")
      t.move_to(r.x + r.w / 2.0, r.y + r.h / 2.0)
      t.frame(ms=16.0)
      t.move_to(r.x + r.w / 2.0 + SP_4, r.y + r.h / 2.0)
      t.frame(ms=200.0)
    }
    None => debug_assert(false, "second row " + second)
  }
  debug_assert(ctrl.omnibox_suggest.untracked().selected == last, "pointer moved the selection to the pointed row")
  debug_assert(ctrl.omnibox_editing.untracked(), "hover never commits")
  match t.get(second) {
    Some(r) => debug_assert(r.ground == fill, "the pointed row's press box is the lit box")
    None => ()
  }
  debug_assert(feel_count_ground(t, fill) == 1, "one lit row, never two (arrow + hover)")
  lg::assert_apple_ui(t, label="feel_address_palette", allow_large_overlay=true)
  t.dispose()
}

test "feel: every frame keyboard stop is >= 32pt and shows the keyboard focus (light, dark, palette open)" {
  for dark in [false, true] {
    let ctrl = make_demo_controller(dark=dark)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }))
      },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
    )
    t.frame(ms=200.0)
    let blind = feel_focus_blind()
    debug_assert(blind.length() == 0, "focus-blind stops: " + feel_join(blind))
    let small = feel_small_stops()
    debug_assert(small.length() == 0, "stops under 32pt: " + feel_join(small))
    // Tabbing draws a ring: after a Tab, some drawn node carries the accent ring edge.
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    let mut rings = 0
    for d in t.drawn() {
      if d.ring.0 > 0.0 || d.edge.0 >= 2.0 {
        rings += 1
      }
    }
    debug_assert(rings > 0, "a Tab shows a focus ring")
    t.dispose()
  }
}
