///| Farview Desktop Shell 2.0 Phase 2B — Zoom Popover (`zoom_popover`),
///| Tab Filter Bar (`tab_filter`), and Global Media Hub Popover (`media_hub`).
///|
///| Architectural invariants:
///| - Single-layer Liquid Glass panels via `lg::liquid_panel_shell_node` (`packages/lg` only).
///| - Dynamic placement via `compute_popover_placement` (never hardcoded window coordinates).
///| - Media Hub routes Play/Pause, Mute/Unmute, and Jump strictly by stable `tab_id`.
///| - Zero Unicode pseudo-icons, 100% explicit `color_by`, accessible labels on all icon buttons.

import "headless"
import "lg"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Zoom Popover (tag: "zoom_popover")
// ============================================================================

pub struct ZoomPopoverProps {
  pub open : () -> Bool
  pub host_label : () -> String
  pub zoom_percent : () -> Int
  pub can_zoom_out : () -> Bool
  pub can_zoom_in : () -> Bool
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_zoom_out : () -> Unit
  pub on_zoom_in : () -> Unit
  pub on_reset : () -> Unit
  pub on_save_default : () -> Unit
  pub on_close : () -> Unit
}

fn zoom_percent_fraction(pct : Int) -> Double {
  let clamped = if pct < 50 { 50 } else if pct > 300 { 300 } else { pct }
  (clamped - 50).to_double() / 250.0
}

///| Builds the Liquid Glass Page Zoom Popover (tag `"zoom_popover"`).
pub fn build_zoom_popover(root : view::View, props : ZoomPopoverProps) -> Unit {
  let nominal_w = 276.0
  let est_h = 196.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Page Zoom Controls"))))

          // Header: Page Zoom + host pill + close
          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).rigid()
            let _ = hdr.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = <ui::Text in={tw} size={13.0} weight={600} color_by=>{lg::surface().ink} text="Page Zoom" />
            })
            hdr.show(
              fn() { (props.host_label)() != "" },
              fn(hp : view::View) -> Unit {
                let _ = hp
                .max_width(view::Live::Is(Some(110.0)))
                .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                .radius(view::Live::Is(lg::r_chip))
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                .cut()
                let _ = <ui::Text in={hp} size={10.5} color_by=>{lg::surface().ink_secondary} text_by=>{(props.host_label)()} />.allow_ellipsis(view::Live::Is(true))
              },
            )
            build_close_icon_btn(hdr, "Close Zoom Controls", props.on_close)
          })

          // Stepper control row: [-]  100%  [+]
          let _ = lg::surface_card_node(
            panel,
            fn(ctrl : view::View) -> Unit {
              let _ = ctrl.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
              let _ = lg::liquid_button_node(
                ctrl,
                fn() { "Zoom Out" },
                props.on_zoom_out,
                content=fn(inner : view::View) -> Unit {
                  let _ = shell_icon(
                    inner,
                    "minus",
                    size=14.0,
                    color_by=fn() {
                      if (props.can_zoom_out)() { lg::surface().ink } else { lg::surface().ink_tertiary }
                    },
                  )
                },
                flat=true,
                disabled=fn() { !(props.can_zoom_out)() },
                height=30.0,
                pad_x=10.0,
              )
              let _ = ctrl.box(fn(readout : view::View) -> Unit {
                let _ = readout.grow(view::Live::Is(1.0)).center()
                let _ = <ui::Text
                  in={readout}
                  size={16.0}
                  weight={600}
                  color_by=>{lg::surface().ink}
                  text_by=>{"\{(props.zoom_percent)()}%"}
                />
              })
              let _ = lg::liquid_button_node(
                ctrl,
                fn() { "Zoom In" },
                props.on_zoom_in,
                content=fn(inner : view::View) -> Unit {
                  let _ = shell_icon(
                    inner,
                    ICON_PLUS,
                    size=14.0,
                    color_by=fn() {
                      if (props.can_zoom_in)() { lg::surface().ink } else { lg::surface().ink_tertiary }
                    },
                  )
                },
                flat=true,
                disabled=fn() { !(props.can_zoom_in)() },
                height=30.0,
                pad_x=10.0,
              )
            },
            radius=lg::r_row,
            pad=6.0,
            secondary=true,
          )

          // Visual scale bar + 50% / 100% / 300% ticks
          let _ = panel.box(fn(scale_wrap : view::View) -> Unit {
            let _ = scale_wrap.gap(view::Live::Is(5.0)).rigid()
            let _ = scale_wrap.box(fn(track : view::View) -> Unit {
              let _ = track.height(view::Live::Is(Some(6.0))).radius(view::Live::Is(3.0)).ground(view::Live::By(fn() { lg::surface().separator_strong })).cut()
              let _ = track.box(fn(fill : view::View) -> Unit {
                let _ = fill
                .over_at(view::Live::Is((Some(0.0), Some(0.0), None, Some(0.0))))
                .width(view::Live::By(fn() {
                  let frac = zoom_percent_fraction((props.zoom_percent)())
                  Some(frac * 244.0 + 4.0)
                }))
                .radius(view::Live::Is(3.0))
                .ground(view::Live::By(fn() { lg::surface().accent }))
              })
            })
            let _ = scale_wrap.box(fn(ticks : view::View) -> Unit {
              let _ = ticks.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid()
              let _ = ticks.box(fn(l50 : view::View) -> Unit {
                let _ = l50.grow(view::Live::Is(5.0))
                let _ = <ui::Text in={l50} size={10.0} weight={500} color_by=>{lg::surface().ink_tertiary} text="50%" />
              })
              let _ = ticks.box(fn(l100 : view::View) -> Unit {
                let _ = l100.grow(view::Live::Is(7.0))
                let _ = <ui::Text in={l100} size={10.0} weight={500} color_by=>{lg::surface().ink_tertiary} text="100%" />
              })
              let _ = ticks.box(fn(l300 : view::View) -> Unit {
                let _ = l300.rigid()
                let _ = <ui::Text in={l300} size={10.0} weight={500} color_by=>{lg::surface().ink_tertiary} text="300%" />
              })
            })
          })

          // Footer actions: Reset 100% (⌘0) + Save as Default
          let reset_hint = if ui::keys_system() <= 0 { "⌘0" } else { "Ctrl+0" }
          let _ = panel.box(fn(foot : view::View) -> Unit {
            let _ = foot.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
            let _ = foot.box(fn(rw : view::View) -> Unit {
              let _ = rw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = lg::liquid_button_node(
                rw,
                fn() { "Reset" },
                props.on_reset,
                content=fn(inner : view::View) -> Unit {
                  let _ = inner.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(5.0))
                  let _ = <ui::Text
                    in={inner}
                    size={11.5}
                    weight={500}
                    color_by=>{if (props.zoom_percent)() == 100 { lg::surface().ink_tertiary } else { lg::surface().ink }}
                    text="Reset 100%"
                  />
                  let _ = <ui::Text
                    in={inner}
                    size={10.5}
                    weight={500}
                    color_by=>{lg::surface().ink_tertiary}
                    text={reset_hint}
                  />
                },
                flat=true,
                disabled=fn() { (props.zoom_percent)() == 100 },
                height=28.0,
                pad_x=8.0,
              )
            })
            let _ = foot.box(fn(sw : view::View) -> Unit {
              let _ = sw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = lg::liquid_button_node(
                sw,
                fn() { "Save as Default" },
                props.on_save_default,
                content=fn(inner : view::View) -> Unit {
                  let _ = <ui::Text in={inner} size={11.5} weight={600} color_by=>{0xFFFFFFFFL} text="Save as Default" />
                },
                flat=true,
                active=fn() { true },
                height=28.0,
                pad_x=8.0,
              )
            })
          })
        },
        radius=lg::r_card,
      )
    })
  })
}

// ============================================================================
// 2. Tab Filter Bar (tag: "tab_filter")
// ============================================================================

pub struct TabFilterBarProps {
  pub open : () -> Bool
  pub field : ui::Field
  pub matched_count : () -> Int
  pub total_count : () -> Int
  pub on_query_change : (String) -> Unit
  pub on_clear : () -> Unit
  pub on_close : () -> Unit
}

///| Builds the compact Liquid Glass Tab Filter Bar (tag `"tab_filter"`).
///| Displays search input, live match count pill, and conditional Clear button (mounted via `.show`).
pub fn build_tab_filter_bar(parent : view::View, props : TabFilterBarProps) -> Unit {
  parent.show(props.open, fn(wrap : view::View) -> Unit {
    let _ = wrap.rigid()
    wrap.reacts(at_start=false, fn() { props.field.text() }, fn(q : String) -> Unit {
      (props.on_query_change)(q)
    })

    let _ = lg::liquid_panel_shell_node(
      wrap,
      fn(bar : view::View) -> Unit {
        let _ = bar
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .min_height(view::Live::Is(Some(36.0)))
        .padding(view::Live::Is((10.0, 3.0, 6.0, 3.0)))
        .gap(view::Live::Is(6.0))
        .says(view::Live::Is(Some(view::said(view::Role::Region, label="Tab Filter Bar"))))
        .key_context("TabFilterField")
        .on_action("tabfilter.escape", fn(_a : view::ActionAt) -> Bool {
          if props.field.composing() {
            props.field.compose("")
            return true
          }
          (props.on_close)()
          true
        })

        let _ = shell_icon(
          bar,
          ICON_SEARCH,
          size=13.5,
          color_by=fn() {
            if props.field.text().trim() != "" { lg::surface().accent } else { lg::surface().ink_secondary }
          },
        )

        let _ = bar.box(fn(fw : view::View) -> Unit {
          let _ = fw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
          fw.show(fn() { !lg::is_dark() }, fn(fl : view::View) -> Unit {
            let _ = fl.fill()
            let _ = ui::field(
              fl,
              props.field,
              placeholder="Filter tabs...",
              font_size=12.5,
              color=0x1C1C1EFFL,
              placeholder_color=0x8E8E93FFL,
              caret_color=0x007AFFFFL,
              max_lines=1,
              enter_sends=true,
              submitted=fn(_s : String) -> Unit { () },
            )
          }, at_once=true)
          fw.show(fn() { lg::is_dark() }, fn(fd : view::View) -> Unit {
            let _ = fd.fill()
            let _ = ui::field(
              fd,
              props.field,
              placeholder="Filter tabs...",
              font_size=12.5,
              color=0xF5F5F7FFL,
              placeholder_color=0x98989DFFL,
              caret_color=0x0A84FFFFL,
              max_lines=1,
              enter_sends=true,
              submitted=fn(_s : String) -> Unit { () },
            )
          }, at_once=true)
        })

        // Live match count pill
        bar.show(
          fn() { props.field.text().trim() != "" },
          fn(cnt : view::View) -> Unit {
            let _ = cnt
            .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
            .radius(view::Live::Is(lg::r_chip))
            .rigid()
            .ground(view::Live::By(fn() {
              if (props.matched_count)() == 0 { lg::surface().danger_bg } else { lg::surface().accent_tint }
            }))
            let _ = <ui::Text
              in={cnt}
              size={10.5}
              weight={600}
              color_by=>{
                if (props.matched_count)() == 0 { lg::surface().danger } else { lg::surface().accent }
              }
              text_by=>{"\{(props.matched_count)()} / \{(props.total_count)()}"}
            />
          },
        )

        // Conditional Clear button (mounted via `.show`, NEVER `alpha=0`)
        bar.show(
          fn() { props.field.text() != "" },
          fn(cw : view::View) -> Unit {
            let _ = lg::liquid_button_node(
              cw,
              fn() { "Clear Tab Filter" },
              fn() -> Unit {
                props.field.set("")
                (props.on_clear)()
              },
              content=fn(inner : view::View) -> Unit {
                let _ = shell_icon(inner, ICON_CLOSE, size=12.0, color_by=fn() { lg::surface().ink_secondary })
              },
              flat=true,
              ghost=true,
              height=26.0,
              pad_x=6.0,
            )
          },
        )
      },
      radius=lg::r_row,
    )
  })
}

// ============================================================================
// 3. Global Media Hub Popover (tag: "media_hub")
// ============================================================================

///| Single active audio/video tab entry routed strictly by stable `tab_id`.
pub struct MediaHubEntry {
  pub tab_id : String
  pub title : String
  pub source_host : String
  pub playing : Bool
  pub muted : Bool
  pub is_live_call : Bool
}

pub struct MediaHubCallbacks {
  pub on_toggle_play : (String) -> Unit
  pub on_toggle_mute : (String) -> Unit
  pub on_mute_all : () -> Unit
  pub on_jump_tab : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct MediaHubPopoverProps {
  pub open : () -> Bool
  pub entries : () -> Array[MediaHubEntry]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub callbacks : MediaHubCallbacks
}

fn media_hub_count_label(n : Int) -> String {
  if n == 1 { "1 active" } else { "\{n} active" }
}

///| Builds the Liquid Glass Global Media Hub Popover (tag `"media_hub"`).
///| Every row routes Play/Pause, Mute/Unmute, and Jump strictly by stable `tab_id`.
pub fn build_media_hub_popover(root : view::View, props : MediaHubPopoverProps) -> Unit {
  let nominal_w = 352.0
  let est_h = 260.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.callbacks.on_close)

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Media Controls"))))

          // Header
          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
            let _ = hdr.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = <ui::Text in={tw} size={13.5} weight={600} color_by=>{lg::surface().ink} text="Media Controls" />
            })
            let _ = hdr.box(fn(pill : view::View) -> Unit {
              let _ = pill
              .padding(view::Live::Is((7.0, 2.0, 7.0, 2.0)))
              .radius(view::Live::Is(lg::r_chip))
              .rigid()
              .ground(view::Live::By(fn() { lg::surface().accent_tint }))
              let _ = <ui::Text
                in={pill}
                size={10.5}
                weight={600}
                color_by=>{lg::surface().accent}
                text_by=>{media_hub_count_label((props.entries)().length())}
              />
            })
            hdr.show(
              fn() -> Bool {
                let list = (props.entries)()
                let mut i = 0
                while i < list.length() {
                  if list[i].playing {
                    return true
                  }
                  i += 1
                }
                false
              },
              fn(mw : view::View) -> Unit {
                let _ = lg::liquid_button_node(
                  mw,
                  fn() { "Mute all" },
                  props.callbacks.on_mute_all,
                  content=fn(inner : view::View) -> Unit {
                    let _ = <ui::Text in={inner} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text="Mute all" />
                  },
                  flat=true,
                  height=24.0,
                  pad_x=8.0,
                )
              },
            )
            build_close_icon_btn(hdr, "Close Media Controls", props.callbacks.on_close)
          })

          // Empty state
          panel.show(
            fn() { (props.entries)().length() == 0 },
            fn(emp : view::View) -> Unit {
              let _ = lg::surface_card_node(
                emp,
                fn(eb : view::View) -> Unit {
                  let _ = eb.center().gap(view::Live::Is(6.0)).padding(view::Live::Is((8.0, 14.0, 8.0, 14.0)))
                  let _ = shell_icon(eb, ICON_VOLUME, size=18.0, color_by=fn() { lg::surface().ink_tertiary })
                  let _ = <ui::Text in={eb} size={12.0} color_by=>{lg::surface().ink_secondary} text="No active media or live calls" />
                },
                radius=lg::r_row,
                pad=8.0,
                secondary=true,
              )
            },
          )

          // Keyed session rows by stable `tab_id`
          panel.show(
            fn() { (props.entries)().length() > 0 },
            fn(list_wrap : view::View) -> Unit {
              let _ = list_wrap.gap(view::Live::Is(6.0))
              list_wrap.each(
                props.entries,
                fn(item : MediaHubEntry) -> String { item.tab_id },
                fn(slot : view::View, item_sig : signals::Signal[MediaHubEntry]) -> Unit {
                  let _ = lg::surface_card_node(
                    slot,
                    fn(row : view::View) -> Unit {
                      let _ = row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .gap(view::Live::Is(8.0))
                      .rigid()

                      // Jump-to-tab button (title + host)
                      let _ = headless::button(
                        row,
                        fn() { "Jump to \{item_sig.get().title}" },
                        fn(_e) -> Unit {
                          let tid = item_sig.untracked().tab_id
                          (props.callbacks.on_jump_tab)(tid)
                        },
                        fn(jb : view::View, btn : headless::Button) -> Unit {
                          let _ = jb
                          .grow(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .min_height(view::Live::Is(Some(36.0)))
                          .padding(view::Live::Is((4.0, 2.0, 4.0, 2.0)))
                          .radius(view::Live::Is(lg::r_chip))
                          .gap(view::Live::Is(2.0))
                          .ground(view::Live::By(fn() {
                            if btn.hovered() || btn.pressed() { lg::surface().row_hover } else { 0x00000000L }
                          }))
                          let _ = <ui::Text
                            in={jb}
                            size={12.5}
                            weight={600}
                            color_by=>{lg::surface().ink}
                            text_by=>{item_sig.get().title}
                          />.allow_ellipsis(view::Live::Is(true))
                          let _ = <ui::Text
                            in={jb}
                            size={11.0}
                            color_by=>{
                              if item_sig.get().is_live_call { lg::surface().positive } else { lg::surface().ink_secondary }
                            }
                            text_by=>{
                              let m = item_sig.get()
                              if m.is_live_call { "\{m.source_host} (Live)" } else { m.source_host }
                            }
                          />.allow_ellipsis(view::Live::Is(true))
                        },
                      )

                      // Play / Pause button routed by stable `tab_id`
                      let _ = lg::liquid_button_node(
                        row,
                        fn() {
                          let m = item_sig.get()
                          if m.playing { "Pause \{m.title}" } else { "Play \{m.title}" }
                        },
                        fn() -> Unit { (props.callbacks.on_toggle_play)(item_sig.untracked().tab_id) },
                        content=fn(inner : view::View) -> Unit {
                          inner.show(fn() { item_sig.get().playing }, fn(ic : view::View) -> Unit {
                            let _ = shell_icon(ic, ICON_PAUSE, size=14.0, color_by=fn() { lg::surface().ink })
                          })
                          inner.show(fn() { !item_sig.get().playing }, fn(ic : view::View) -> Unit {
                            let _ = shell_icon(ic, ICON_PLAY, size=14.0, color_by=fn() { lg::surface().ink })
                          })
                        },
                        flat=true,
                        height=30.0,
                        pad_x=8.0,
                      )

                      // Mute / Unmute button routed by stable `tab_id`
                      let _ = lg::liquid_button_node(
                        row,
                        fn() {
                          let m = item_sig.get()
                          if m.muted { "Unmute \{m.title}" } else { "Mute \{m.title}" }
                        },
                        fn() -> Unit { (props.callbacks.on_toggle_mute)(item_sig.untracked().tab_id) },
                        content=fn(inner : view::View) -> Unit {
                          inner.show(fn() { item_sig.get().muted }, fn(ic : view::View) -> Unit {
                            let _ = shell_icon(ic, ICON_VOLUME_MUTE, size=14.0, color_by=fn() { lg::surface().danger })
                          })
                          inner.show(fn() { !item_sig.get().muted }, fn(ic : view::View) -> Unit {
                            let _ = shell_icon(ic, ICON_VOLUME, size=14.0, color_by=fn() { lg::surface().ink_secondary })
                          })
                        },
                        flat=true,
                        height=30.0,
                        pad_x=8.0,
                      )
                    },
                    radius=lg::r_row,
                    pad=8.0,
                  )
                },
              )
            },
          )
        },
        radius=lg::r_card,
      )
    })
  })
}
