///| Shell 3 Zoom popover (`zoom_popover`), tab filter bar (`tab_filter`) and media hub (`media_hub`).
///|
///| - One glass layer per popover (`pop_mount` in `siteinfo_idna_popover.pion`), solid grouped lists inside.
///| - Placement through `compute_popover_placement`, never fixed window coordinates.
///| - The media hub routes play/pause, mute and jump strictly by stable `tab_id`.

import "headless"
import "icons"
import "lg"
import "motion"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Zoom Popover (tag: "zoom_popover")
// ============================================================================

pub struct ZoomPopoverProps {
  pub open : () -> Bool
  pub host_label : () -> String
  pub zoom_percent : () -> Int
  pub can_zoom_out : () -> Bool
  pub can_zoom_in : () -> Bool
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_zoom_out : () -> Unit
  pub on_zoom_in : () -> Unit
  pub on_reset : () -> Unit
  pub on_save_default : () -> Unit
  pub on_close : () -> Unit
}

///| Builds the Zoom popover (tag `"zoom_popover"`): `[site] > Zoom`, a stepper, actual size with its
///| shortcut, and making the current zoom the default.
pub fn build_zoom_popover(root : view::View, props : ZoomPopoverProps) -> Unit {
  let modk = pop_mod_key()
  pop_mount(
    root,
    props.open,
    props.on_close,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 + SP_128,
    "Page Zoom Controls",
    fn(hw : view::View) -> Unit {
      pop_header(
        hw,
        fn(lw : view::View) -> Unit {
          lw.show(fn() { (props.host_label)() != "" }, fn(sv : view::View) -> Unit {
            let _ = shell_site_tile(sv, props.host_label, size=SP_24)
          }, at_once=true)
          lw.show(fn() { (props.host_label)() == "" }, fn(gv : view::View) -> Unit {
            pop_tile(gv, ICON_SEARCH, tile_teal())
          }, at_once=true)
        },
        true,
        fn() { "Zoom" },
        props.host_label,
        "Close Zoom Controls",
        props.on_close,
      )
    },
    fn(panel : view::View) -> Unit {

      let _ = panel.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(SP_6)).rigid()
        pop_group(sec, fn(g : view::View) -> Unit {
          // Stepper: [-] 125% [+]
          let _ = g.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .min_height(view::Live::Is(Some(SP_48)))
            .padding(view::Live::Is((SP_12, SP_8, SP_8, SP_8)))
            .gap(view::Live::Is(SP_4))
            let _ = row.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              <ui::Text in={tw} size={TX_TITLE3} weight={500} lines={1} color_by=>{lg::surface().ink} text_by=>{"\{(props.zoom_percent)()}%"} />
            })
            pop_icon_btn(
              row,
              fn() { "Zoom Out" },
              props.on_zoom_out,
              fn() { "minus" },
              color_by=fn() { lg::surface().ink },
              disabled=fn() { !(props.can_zoom_out)() },
            )
            pop_icon_btn(
              row,
              fn() { "Zoom In" },
              props.on_zoom_in,
              fn() { ICON_PLUS },
              color_by=fn() { lg::surface().ink },
              disabled=fn() { !(props.can_zoom_in)() },
            )
          })
          pop_rule_flush(g)
          // Actual size, with its shortcut as keycaps.
          let _ = headless::button(
            g,
            fn() { "Reset" },
            fn(_e) -> Unit {
              if (props.zoom_percent)() != 100 {
                (props.on_reset)()
              }
            },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let off = fn() { (props.zoom_percent)() == 100 }
              let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !off() })
              let _ = b
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .min_height(view::Live::Is(Some(SP_40)))
              .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
              .gap(view::Live::Is(SP_4))
              .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
              let _ = b.box(fn(tw : view::View) -> Unit {
                let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                <ui::Text
                  in={tw}
                  size={TX_BODY}
                  lines={1}
                  color_by=>{if off() { lg::surface().ink_tertiary } else { shell_accent_text() }}
                  text="Actual size"
                />
              })
              pop_keycap(b, modk)
              pop_keycap(b, "0")
            },
          )
          pop_rule_flush(g)
          pop_action_row(
            g,
            "Save as Default",
            fn() { "Use \{(props.zoom_percent)()}% for all sites" },
            fn() { shell_accent_text() },
            props.on_save_default,
          )
        })
        pop_footnote(sec, fn() { "\{modk} + and \{modk} − zoom from the page too." })
      })

    },
  )
}

// ============================================================================
// 2. Tab Filter Bar (tag: "tab_filter")
// ============================================================================

pub struct TabFilterBarProps {
  pub open : () -> Bool
  pub field : ui::Field
  pub matched_count : () -> Int
  pub total_count : () -> Int
  pub on_query_change : (String) -> Unit
  pub on_clear : () -> Unit
  pub on_close : () -> Unit
}

fn tab_filter_count_label(matched : Int, total : Int) -> String {
  if matched == 0 { "No matches" } else { "\{matched} of \{total}" }
}

///| Builds the compact tab filter bar (tag `"tab_filter"`): search glyph, field, match count, clear.
///| It lives in the sidebar flow under the address field, so it is a frame control like the address field
///| (DESIGN.md section 1): `shell_wash` at rest, `shell_wash_strong` while focused, radius `SP_8`, no glass.
pub fn build_tab_filter_bar(parent : view::View, props : TabFilterBarProps) -> Unit {
  parent.show(props.open, fn(wrap : view::View) -> Unit {
    let _ = wrap.rigid()
    wrap.reacts(at_start=false, fn() { props.field.text() }, fn(q : String) -> Unit {
      (props.on_query_change)(q)
    })

    let _ = wrap.box(fn(bar : view::View) -> Unit {
      let focus_t = shell_fade(bar, fn() { props.field.focused() }, duration_ms=MO_KEY_MS)
      let _ = bar
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SHELL_ADDRESS_H)))
      .padding(view::Live::Is((SP_10, SP_0, SP_0, SP_0)))
      .gap(view::Live::Is(SP_8))
      .radius(view::Live::Is(SP_8))
      .ground(view::Live::By(fn() {
        let d = lg::is_dark()
        lg::over(shell_wash(d), lg::alpha(shell_wash_strong(d), focus_t()))
      }))
      .says(view::Live::Is(Some(view::said(view::Role::Region, label="Tab Filter Bar"))))
      .key_context("TabFilterField")
      .on_action("tabfilter.escape", fn(_a : view::ActionAt) -> Bool {
        if props.field.composing() {
          props.field.compose("")
          return true
        }
        (props.on_close)()
        true
      })

      let _ = shell_icon(
        bar,
        ICON_SEARCH,
        size=IC_SM,
        color_by=fn() {
          if props.field.text().trim() != "" { lg::surface().accent } else { shell_frame_ink_secondary(lg::is_dark()) }
        },
      )

      // One field for both themes: its colors follow the theme, so a theme switch never remounts it
      // (focus, caret and any composition survive).
      let _ = bar.box(fn(fw : view::View) -> Unit {
        let _ = fw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
        let _ = ui::field(
          fw,
          props.field,
          placeholder="Filter tabs",
          font_size=TX_BODY,
          max_lines=1,
          enter_sends=true,
          submitted=fn(_s : String) -> Unit { () },
          colors_by=fn() {
            let d = lg::is_dark()
            (lg::surface().ink, shell_frame_ink_tertiary(d), lg::surface().accent)
          },
        )
      })

      // Match count, quiet text (danger ink when nothing matches).
      bar.show(
        fn() { props.field.text().trim() != "" },
        fn(cnt : view::View) -> Unit {
          let _ = cnt.rigid()
          <ui::Text
            in={cnt}
            size={TX_FOOTNOTE}
            color_by=>{
              if (props.matched_count)() == 0 { lg::surface().danger } else { shell_frame_ink_secondary(lg::is_dark()) }
            }
            text_by=>{tab_filter_count_label((props.matched_count)(), (props.total_count)())}
          />
        },
      )

      // Clear (mounted with `show`, never `alpha=0`): a 32pt square, flush with the bar's trailing edge.
      bar.show(
        fn() { props.field.text() != "" },
        fn(cw : view::View) -> Unit {
          let _ = headless::button(
            cw,
            fn() { "Clear Tab Filter" },
            fn(_e) -> Unit {
              props.field.set("")
              (props.on_clear)()
            },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
              let _ = b
              .width(view::Live::Is(Some(SP_32)))
              .height(view::Live::Is(Some(SP_32)))
              .radius(view::Live::Is(SP_8))
              .rigid()
              .center()
              .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(lg::is_dark()), hover_t()) }))
              shell_press(b, fn() { btn.pressed() })
              let _ = shell_icon(b, ICON_CLOSE, size=IC_SM, color_by=fn() { shell_frame_ink_secondary(lg::is_dark()) })
            },
          )
        },
        at_once=true,
      )
      // Trailing inset while there is nothing to clear.
      bar.show(fn() { props.field.text() == "" }, fn(sp : view::View) -> Unit {
        let _ = sp.width(view::Live::Is(Some(SP_10))).rigid()
      }, at_once=true)
    })
  })
}

// ============================================================================
// 3. Global Media Hub Popover (tag: "media_hub")
// ============================================================================

///| Single active audio/video tab entry routed strictly by stable `tab_id`.
pub struct MediaHubEntry {
  pub tab_id : String
  pub title : String
  pub source_host : String
  pub playing : Bool
  pub muted : Bool
  pub is_live_call : Bool
}

pub struct MediaHubCallbacks {
  pub on_toggle_play : (String) -> Unit
  pub on_toggle_mute : (String) -> Unit
  pub on_mute_all : () -> Unit
  pub on_jump_tab : (String) -> Unit
  pub on_close : () -> Unit
}

pub struct MediaHubPopoverProps {
  pub open : () -> Bool
  pub entries : () -> Array[MediaHubEntry]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub callbacks : MediaHubCallbacks
}

fn media_any_playing(list : Array[MediaHubEntry]) -> Bool {
  let mut i = 0
  while i < list.length() {
    if list[i].playing {
      return true
    }
    i += 1
  }
  false
}

///| Builds the media hub (tag `"media_hub"`): one row per tab with sound or a call — the site, what it is
///| playing, and play/pause + mute. Every control routes by stable `tab_id`.
pub fn build_media_hub_popover(root : view::View, props : MediaHubPopoverProps) -> Unit {
  let cb = props.callbacks
  pop_mount(
    root,
    props.open,
    cb.on_close,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 * 2.0 + SP_40,
    "Media Controls",
    fn(hw : view::View) -> Unit {
      pop_header(
        hw,
        fn(lw : view::View) -> Unit { pop_tile(lw, ICON_VOLUME, tile_pink()) },
        false,
        fn() { "Now playing" },
        fn() { "" },
        "Close Media Controls",
        cb.on_close,
        trailing=fn(hdr : view::View) -> Unit {
          hdr.show(fn() { media_any_playing((props.entries)()) }, fn(mw : view::View) -> Unit {
            let _ = lg::liquid_button_node(
              mw,
              fn() { "Mute all" },
              cb.on_mute_all,
              content=fn(inner : view::View) -> Unit {
                <ui::Text in={inner} size={TX_BODY} color_by=>{shell_accent_text()} text="Mute all" />
              },
              flat=true,
              ghost=true,
              height=SP_32,
              pad_x=SP_10,
            )
          })
        },
      )
    },
    fn(panel : view::View) -> Unit {
      // Empty state
      panel.show(fn() { (props.entries)().length() == 0 }, fn(emp : view::View) -> Unit {
        pop_group(emp, fn(g : view::View) -> Unit {
          let _ = g.box(fn(eb : view::View) -> Unit {
            let _ = eb.center().gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_16, SP_20, SP_16, SP_20)))
            <ui::Text in={eb} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text="Nothing is playing" />
            <ui::Text in={eb} size={TX_FOOTNOTE} center wrap color_by=>{lg::surface().ink_secondary} text="Tabs playing sound and calls show up here." />
          })
        })
      })

      // One row per tab, keyed by stable `tab_id`.
      panel.show(fn() { (props.entries)().length() > 0 }, fn(list_wrap : view::View) -> Unit {
        pop_group(list_wrap, fn(g : view::View) -> Unit {
          g.each(
            props.entries,
            fn(item : MediaHubEntry) -> String { item.tab_id },
            fn(slot : view::View, item_sig : signals::Signal[MediaHubEntry]) -> Unit {
              slot.show(
                fn() {
                  let list = (props.entries)()
                  list.length() > 0 && list[0].tab_id != item_sig.get().tab_id
                },
                fn(rw : view::View) -> Unit { pop_rule(rw) },
                at_once=true,
              )
              // One row, one rhythm: SP_12 lead, 24pt tile, title + host, then play/pause and mute (32pt each).
              // The row has no hover wash of its own (it would stop short of the buttons); the title takes the
              // accent while the jump target is hovered.
              let _ = slot.box(fn(row : view::View) -> Unit {
                let _ = row
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .min_height(view::Live::Is(Some(SP_48)))
                .padding(view::Live::Is((SP_12, SP_8, SP_8, SP_8)))
                .gap(view::Live::Is(SP_2))
                let _ = headless::button(
                  row,
                  fn() { "Jump to \{item_sig.get().title}" },
                  fn(_e) -> Unit { (cb.on_jump_tab)(item_sig.untracked().tab_id) },
                  fn(jb : view::View, btn : headless::Button) -> Unit {
                    let hover_t = shell_fade(jb, fn() { btn.hovered() || btn.pressed() })
                    let _ = jb
                    .grow(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Start)))
                    .gap(view::Live::Is(SP_12))
                    let _ = shell_site_tile(jb, fn() { item_sig.get().source_host }, size=SP_24)
                    let _ = jb.box(fn(col : view::View) -> Unit {
                      let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                      let _ = col.box(fn(band : view::View) -> Unit {
                        let _ = band.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).min_height(view::Live::Is(Some(SP_24))).min_width(view::Live::Is(Some(0.0)))
                        let _ = band.box(fn(tw : view::View) -> Unit {
                          let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                          <ui::Text
                            in={tw}
                            size={TX_BODY}
                            lines={1}
                            color_by=>{lg::over(lg::surface().ink, lg::alpha(lg::surface().accent, hover_t()))}
                            text_by=>{item_sig.get().title}
                          />
                        })
                      })
                      let _ = col.box(fn(sub : view::View) -> Unit {
                        let _ = sub.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).min_width(view::Live::Is(Some(0.0)))
                        sub.show(fn() { item_sig.get().is_live_call }, fn(lv : view::View) -> Unit {
                          let _ = lv.rigid()
                          <ui::Text in={lv} size={TX_FOOTNOTE} weight={500} color_by=>{shell_positive_text()} text="Live call" />
                        })
                        let _ = sub.box(fn(hw : view::View) -> Unit {
                          let _ = hw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                          <ui::Text in={hw} size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{item_sig.get().source_host} />
                        })
                      })
                    })
                  },
                )
                media_play_btn(
                  row,
                  fn() {
                    let m = item_sig.get()
                    if m.playing { "Pause \{m.title}" } else { "Play \{m.title}" }
                  },
                  fn() { (cb.on_toggle_play)(item_sig.untracked().tab_id) },
                  fn() { item_sig.get().playing },
                )
                // Muted is a state the person chose, not a fault: same ink as unmuted, the slashed glyph says it.
                pop_icon_btn(
                  row,
                  fn() {
                    let m = item_sig.get()
                    if m.muted { "Unmute \{m.title}" } else { "Mute \{m.title}" }
                  },
                  fn() { (cb.on_toggle_mute)(item_sig.untracked().tab_id) },
                  fn() { if item_sig.get().muted { ICON_VOLUME_MUTE } else { ICON_VOLUME } },
                )
              })
            },
          )
        })
      })
    },
  )
}

///| Play/pause as one glyph family: the icon set's pause is filled, its play is an outline, so play is
///| filled here too (the same shapes, filled with the ink) and both sit at the speaker icon's size.
fn media_play_btn(parent : view::View, label : () -> String, on_press : () -> Unit, playing : () -> Bool) -> Unit {
  let _ = lg::liquid_button_node(
    parent,
    label,
    on_press,
    content=fn(inner : view::View) -> Unit {
      let _ = inner.box(fn(g : view::View) -> Unit {
        let _ = g
        .width(view::Live::Is(Some(IC_MD)))
        .height(view::Live::Is(Some(IC_MD)))
        .shrink(view::Live::Is(0.0))
        .points(view::Live::Is(false))
        .shapes(view::Live::By(fn() {
          let ink = 0x01010100L
          if playing() {
            icons::icon_shapes(ICON_PAUSE, IC_MD, ink)
          } else {
            let src = icons::icon_shapes(ICON_PLAY, IC_MD, ink)
            let out = []
            for sh in src {
              out.push({ ..sh, fill: ink })
            }
            out
          }
        }))
        .tint(view::Live::By(fn() { lg::surface().ink }))
      })
    },
    flat=true,
    ghost=true,
    height=SP_32,
    pad_x=SP_8,
  )
}
