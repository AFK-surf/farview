///| Shell 3 spaces area, part 2:
///| 1. Spaces dialog (`build_spaces_modal_panel`): a live preview of the window frame tinted by the Space being
///|    looked at, the Spaces list (switch, edit name / color / delete in place) and New Space.
///| 2. Recently Closed drawer (`build_closed_tabs_drawer_panel`).
///| 3. Export PDF dialog (`build_print_pdf_modal_panel`): paper preview + grouped settings.
///|
///| Invariants kept from Shell 2:
///| - Closed tabs restore by the original `it.index`, never the filtered position.
///| - Export PDF forwards the `owner_pane` locked on open and a `proto::PrintPdfConfig`.
///| - One layer of glass (dialog shell / drawer); everything inside is solid `lg::surface()`.
///| Shared private pieces (`spx_*`) live in `sessions_folders_panel.pion`.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Spaces dialog
// ============================================================================

///| Props for `build_spaces_modal_panel`.
pub struct SpacesModalProps {
  pub open : () -> Bool
  pub spaces : () -> Array[proto::SpaceSummary]
  pub active_space_id : () -> String
  pub new_name_field : ui::Field
  pub new_accent : signals::Signal[String]
  pub rename_space_id : signals::Signal[String]
  pub rename_field : ui::Field
  pub color_edit_space_id : signals::Signal[String]
  pub on_create_space : (String, String) -> Unit
  ///| New Space as the sidebar's Create a Space (the manager closes and the sidebar takes over); None keeps the
  ///| inline name field here.
  pub on_new_space : Option[() -> Unit]
  pub on_switch_space : (String) -> Unit
  pub on_rename_space : (String, String) -> Unit
  pub on_recolor_space : (String, String) -> Unit
  ///| Opens the Space theme editor for the Space (switching to it first: the frame previews the active Space).
  pub on_customize_space : (String) -> Unit
  pub on_delete_space : (String) -> Unit
  pub on_close : () -> Unit
  pub return_focus : Option[view::View]
}

#derive(Eq)
struct SpaceKeyedRow {
  id : String
  name : String
  accent : String
  active : Bool
  tab_count : Int
  can_delete : Bool
  first : Bool
}

impl signals::Eq for SpaceKeyedRow {
  fn eq(self : SpaceKeyedRow, other : SpaceKeyedRow) -> Bool {
    self.id == other.id &&
    self.name == other.name &&
    self.accent == other.accent &&
    self.active == other.active &&
    self.tab_count == other.tab_count &&
    self.can_delete == other.can_delete &&
    self.first == other.first
  }
}

///| A rounded-square tile in a Space's color carrying the Space's initial.
fn spx_space_tile(parent : view::View, accent_by : () -> Int64, name_by : () -> String, size~ : Double = SP_24) -> Unit {
  let _ = parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(accent_by))
    .points(view::Live::Is(false))
    .center()
    <ui::Text
      in={tile}
      size={shell_tile_letter(size)}
      weight={600}
      color_by=>{0xFFFFFFFFL}
      text_by=>{shell_site_monogram(name_by())}
    />
  })
}

///| A miniature of the window as a Space colors it: the tinted frame, the sidebar's washes and Space dots, and
///| the page card. `accent_by` is the Space being looked at; `dots_by` gives every Space's color and whether it is
///| the one shown.
fn spx_frame_preview(parent : view::View, accent_by : () -> Int64, dots_by : () -> Array[(Int64, Bool)]) -> Unit {
  let dark = fn() { lg::is_dark() }
  let _ = parent.box(fn(win : view::View) -> Unit {
    let _ = win
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(SP_128 + SP_32)))
    .rigid()
    .radius(view::Live::Is(SP_12))
    .clips(view::Live::Is(true))
    .padding(view::Live::Is((SP_6, SP_6, SP_6, SP_6)))
    .gap(view::Live::Is(SP_6))
    .ground(view::Live::By(fn() { shell_frame_tint(accent_by(), dark()) }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
    .points(view::Live::Is(false))

    // Sidebar: traffic lights, address field, tab rows, Space dots.
    let _ = win.box(fn(side : view::View) -> Unit {
      let _ = side.width(view::Live::Is(Some(SP_96 + SP_16))).rigid().gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_2, SP_4, SP_2, SP_4)))
      let _ = side.box(fn(lights : view::View) -> Unit {
        let _ = lights.row(view::Live::Is(true)).gap(view::Live::Is(SP_4)).height(view::Live::Is(Some(SP_10))).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((SP_2, SP_0, SP_0, SP_0)))
        let mut li = 0
        while li < 3 {
          let _ = lights.box(fn(d : view::View) -> Unit {
            let _ = d
            .width(view::Live::Is(Some(SP_6)))
            .height(view::Live::Is(Some(SP_6)))
            .radius(view::Live::Is(SP_4))
            .ground(view::Live::By(fn() { lg::alpha(shell_frame_ink_tertiary(dark()), 0.55) }))
          })
          li += 1
        }
      })
      // Address field.
      let _ = side.box(fn(addr : view::View) -> Unit {
        let _ = addr.height(view::Live::Is(Some(SP_16))).radius(view::Live::Is(SP_4)).ground(view::Live::By(fn() { shell_wash(dark()) }))
      })
      let _ = side.box(fn(gap_box : view::View) -> Unit { let _ = gap_box.height(view::Live::Is(Some(SP_4))) })
      // Tab rows: the selected one lifted, the rest a site dot and a quiet line.
      let widths : Array[Double] = [SP_64, SP_48 + SP_6, SP_64 + SP_4, SP_40]
      let mut ri = 0
      while ri < widths.length() {
        let selected = ri == 0
        let line_w = widths[ri]
        let _ = side.box(fn(row : view::View) -> Unit {
          let _ = row
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(SP_12)))
          .gap(view::Live::Is(SP_4))
          .padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
          .radius(view::Live::Is(SP_4))
          .ground(view::Live::By(fn() { if selected { shell_wash_strong(dark()) } else { 0x00000000L } }))
          let _ = row.box(fn(dot : view::View) -> Unit {
            let _ = dot.width(view::Live::Is(Some(SP_6))).height(view::Live::Is(Some(SP_6))).radius(view::Live::Is(SP_2)).ground(view::Live::By(fn() { lg::alpha(shell_frame_ink_tertiary(dark()), 0.7) }))
          })
          let _ = row.box(fn(ln : view::View) -> Unit {
            let _ = ln.width(view::Live::Is(Some(line_w))).height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::By(fn() { lg::alpha(shell_frame_ink_tertiary(dark()), 0.45) }))
          })
        })
        ri += 1
      }
      let _ = side.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
      // Space dots at the foot of the sidebar.
      let _ = side.box(fn(dots_row : view::View) -> Unit {
        let _ = dots_row.row(view::Live::Is(true)).gap(view::Live::Is(SP_4)).lies_along(view::Live::Is(view::Lies::Middle)).height(view::Live::Is(Some(SP_10))).lines_up(view::Live::Is(Some(view::Along::Middle)))
        dots_row.each(
          fn() {
            let src = dots_by()
            let out : Array[(Int, Int64, Bool)] = []
            let mut i = 0
            while i < src.length() {
              let (c, on) = src[i]
              out.push((i, c, on))
              i += 1
            }
            out
          },
          fn(d : (Int, Int64, Bool)) -> String { d.0.to_string() },
          fn(slot : view::View, d_sig : signals::Signal[(Int, Int64, Bool)]) -> Unit {
            let _ = slot.box(fn(dot : view::View) -> Unit {
              let _ = dot
              .width(view::Live::Is(Some(SP_6)))
              .height(view::Live::Is(Some(SP_6)))
              .radius(view::Live::Is(SP_4))
              .ground(view::Live::By(fn() {
                let (_, c, on) = d_sig.get()
                if on { c } else { lg::alpha(c, 0.4) }
              }))
            })
          },
        )
      })
    })

    // Page card.
    let _ = win.box(fn(page : view::View) -> Unit {
      let _ = page
      .fill()
      .radius(view::Live::Is(SP_6))
      .ground(view::Live::By(fn() { lg::surface().card }))
      .shadow(view::Live::By(fn() { shell_card_shadow(dark()) }))
      .shadow_outside(view::Live::Is(true))
      .padding(view::Live::Is((SP_16, SP_16, SP_16, SP_16)))
      .gap(view::Live::Is(SP_6))
      let _ = page.box(fn(h : view::View) -> Unit {
        let _ = h.width(view::Live::Is(Some(SP_128))).height(view::Live::Is(Some(SP_8))).radius(view::Live::Is(SP_2)).ground(view::Live::By(fn() { lg::alpha(lg::surface().ink, 0.7) }))
      })
      let _ = page.box(fn(gap_box : view::View) -> Unit { let _ = gap_box.height(view::Live::Is(Some(SP_2))) })
      let fracs : Array[Double] = [1.0, 0.94, 0.97, 0.6]
      let mut fi = 0
      while fi < fracs.length() {
        let f = fracs[fi]
        let _ = page.box(fn(ln : view::View) -> Unit {
          let _ = ln.height(view::Live::Is(Some(SP_4))).radius(view::Live::Is(SP_2)).ground(view::Live::By(fn() { lg::alpha(lg::surface().ink_tertiary, 0.35) }))
          if f < 1.0 {
            let _ = ln.width(view::Live::Is(Some(SP_160 * f)))
          }
        })
        fi += 1
      }
    })
  })
}

///| Builds the Spaces dialog: preview of the tinted frame, the Spaces (switch; name, color and delete under each
///| Space's disclosure) and New Space.
pub fn build_spaces_modal_panel(root : view::View, props : SpacesModalProps) -> Unit {
  let close_fn = props.on_close
  let submit_new_space = fn() -> Unit {
    let raw_name = props.new_name_field.text().trim()
    let hex = props.new_accent.untracked()
    (props.on_create_space)(raw_name, hex)
    props.new_name_field.set("")
  }

  let keyed_spaces = fn() -> Array[SpaceKeyedRow] {
    let list = (props.spaces)()
    let act_id = (props.active_space_id)()
    let allow_delete = list.length() > 1
    let out : Array[SpaceKeyedRow] = []
    let mut i = 0
    while i < list.length() {
      let sp = list[i]
      let is_act = sp.active || (sp.id != "" && sp.id == act_id)
      out.push(SpaceKeyedRow::{
        id: sp.id,
        name: if sp.name != "" { sp.name } else { sp.id },
        accent: sp.accent,
        active: is_act,
        tab_count: sp.tab_count,
        can_delete: allow_delete,
        first: i == 0,
      })
      i += 1
    }
    out
  }

  // The Space the preview shows: the one being edited, else the one being created, else the current one.
  let preview_target = fn() -> (String, String, String) {
    let rows = keyed_spaces()
    let edit_id = if props.rename_space_id.get() != "" { props.rename_space_id.get() } else { props.color_edit_space_id.get() }
    if edit_id != "" {
      for r in rows {
        if r.id == edit_id {
          return (r.id, r.name, r.accent)
        }
      }
    }
    let typed = props.new_name_field.text().trim()
    if typed != "" {
      return ("", typed, props.new_accent.get())
    }
    for r in rows {
      if r.active {
        return (r.id, r.name, r.accent)
      }
    }
    if rows.length() > 0 {
      (rows[0].id, rows[0].name, rows[0].accent)
    } else {
      ("", "", props.new_accent.get())
    }
  }

  let close_editor = fn() -> Unit {
    props.rename_space_id.set("")
    props.color_edit_space_id.set("")
  }

  // Opened by the person: the shared dialog presence. Already open when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_DIALOG_OUT_MS, fn(dlg_wrap : view::View) -> Unit {
    let close_now = shell_closes(dlg_wrap, close_fn)
    let reveal = shell_dialog_reveal(dlg_wrap, built.v)
    reveal.fades(dlg_wrap)
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Spaces Manager" },
      props.open,
      close_now,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center()
        spx_scrim(dlg_box, close_now)

        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          reveal.grows_only(shell)
          let _ = shell
          .width(view::Live::By(spx_dialog_width(root, SP_160 * 3.0 + SP_40)))
          .max_height(view::Live::By(fn() {
            let wh = root.window_h()
            if wh > 0.0 { Some(wh - SP_64) } else { Some(SP_160 * 4.0) }
          }))
          .padding(view::Live::Is((SP_24, SP_24, SP_24, SP_24)))
          .gap(view::Live::Is(SP_20))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          spx_dialog_header(
            shell,
            ICON_LAYERS,
            0x5856D6FFL,
            "Spaces",
            fn() { "Each Space keeps its own tabs, cookies and storage." },
            "Close Spaces Manager",
            close_now,
          )

          let _ = ui::scroll_box(shell, fn(sc : view::View) -> Unit {
            let _ = sc.gap(view::Live::Is(SP_20))

            // Live preview of the frame color.
            let _ = sc.box(fn(pv : view::View) -> Unit {
              let _ = pv.gap(view::Live::Is(SP_8)).rigid()
              spx_frame_preview(
                pv,
                fn() { proto::workspace_accent_color(preview_target().2) },
                fn() {
                  let (tid, _, tacc) = preview_target()
                  let out : Array[(Int64, Bool)] = []
                  for r in keyed_spaces() {
                    out.push((proto::workspace_accent_color(r.accent), tid != "" && r.id == tid))
                  }
                  if tid == "" {
                    out.push((proto::workspace_accent_color(tacc), true))
                  }
                  out
                },
              )
              <ui::Row in={pv} align={.Middle} gap={SP_8} pad_x={SP_12} rigid>
                <ui::Text size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink} text_by=>{preview_target().1} />
                <ui::Text
                  size={TX_FOOTNOTE}
                  color_by=>{lg::surface().ink_secondary}
                  text_by=>{proto::space_accent_label_for_hex(preview_target().2)}
                />
              </ui::Row>
            })

            // The Spaces.
            spx_group(
              sc,
              "Your Spaces",
              fn(g : view::View) -> Unit {
                let _ = g.padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
                g.each(
                  keyed_spaces,
                  fn(r : SpaceKeyedRow) -> String { r.id },
                  fn(slot : view::View, row_sig : signals::Signal[SpaceKeyedRow]) -> Unit {
                    let is_editing = fn() -> Bool {
                      let id = row_sig.get().id
                      id != "" && (props.rename_space_id.get() == id || props.color_edit_space_id.get() == id)
                    }
                    let toggle_editor = fn() -> Unit {
                      let r = row_sig.untracked()
                      if r.id == "" {
                        return
                      }
                      if props.rename_space_id.untracked() == r.id || props.color_edit_space_id.untracked() == r.id {
                        close_editor()
                      } else {
                        props.rename_space_id.set(r.id)
                        props.color_edit_space_id.set(r.id)
                        props.rename_field.set(r.name)
                        props.rename_field.focus()
                      }
                    }
                    slot.show(fn() { !row_sig.get().first }, fn(rw : view::View) -> Unit {
                      spx_rule(rw, inset=SP_8 + SP_24 + SP_12)
                    })

                    // Row: the row itself switches to the Space (tile, name, and Current on the active one), the
                    // disclosure at its end opens the editor. The active row takes no hover wash: pressing it
                    // does nothing.
                    let _ = slot.box(fn(row : view::View) -> Unit {
                      let hover_t = shell_fade(row, fn() { (row.pointed() || row.pointed_in()) && !row_sig.get().active })
                      let _ = row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .min_height(view::Live::Is(Some(SP_40)))
                      .padding(view::Live::Is((SP_0, SP_0, SP_8, SP_0)))
                      .gap(view::Live::Is(SP_0))
                      .radius(view::Live::Is(SP_8))
                      .ground(view::Live::By(fn() {
                        if is_editing() { lg::surface().row_selected } else { lg::alpha(lg::surface().row_hover, hover_t()) }
                      }))
                      let _ = headless::button(
                        row,
                        fn() { (if row_sig.get().active { "Current Space " } else { "Switch to Space " }) + row_sig.get().name },
                        fn(_v : view::View) -> Unit {
                          let r = row_sig.untracked()
                          if r.id != "" && !r.active {
                            (props.on_switch_space)(r.id)
                          }
                        },
                        // (the current Space is no switch: not pressable, not a stop for the keyboard, read out as
                        // what it is)
                        disabled=fn() { row_sig.get().active },
                        fn(sw : view::View, _b : headless::Button) -> Unit {
                          let _ = sw
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .grow(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(SP_0)))
                          .min_width(view::Live::Is(Some(SP_0)))
                          .min_height(view::Live::Is(Some(SP_40)))
                          .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
                          .gap(view::Live::Is(SP_12))
                          spx_space_tile(sw, fn() { proto::workspace_accent_color(row_sig.get().accent) }, fn() { row_sig.get().name })
                          spx_line(sw, fn() { row_sig.get().name }, grow=true)
                          sw.show(fn() { row_sig.get().active }, fn(cur : view::View) -> Unit {
                            let _ = cur.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).rigid()
                            let _ = shell_icon(cur, ICON_CHECK, size=IC_SM, color_by=fn() { lg::surface().accent })
                            <ui::Text in={cur} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text="Current" />
                          })
                        },
                      )
                      // A disclosure (reports expanded): it opens the editor with name, color and Delete. The label
                      // keeps "Rename Space <name>", which tests and the app press.
                      let _ = headless::disclosure(
                        row,
                        fn() { "Rename Space " + row_sig.get().name },
                        is_editing,
                        fn(_v : view::View) -> Unit { toggle_editor() },
                        fn(b : view::View, btn : headless::Disclosure) -> Unit {
                          let bt = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                          let _ = b
                          .width(view::Live::Is(Some(SP_32)))
                          .height(view::Live::Is(Some(SP_32)))
                          .shrink(view::Live::Is(0.0))
                          .center()
                          .radius(view::Live::Is(SP_8))
                          .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, bt()) }))
                          let _ = shell_icon_by(
                            b,
                            fn() { if is_editing() { ICON_CHEVRON_UP } else { ICON_CHEVRON_DOWN } },
                            size=IC_SM,
                            color_by=fn() { lg::surface().ink_secondary },
                          )
                        },
                      )
                    })

                    // Disclosure: name, color, delete.
                    slot.show(is_editing, fn(ed : view::View) -> Unit {
                      let commit_rename = fn() -> Unit {
                        let id = row_sig.untracked().id
                        let nm = props.rename_field.text().trim()
                        if id != "" && nm != "" {
                          (props.on_rename_space)(id, nm)
                        }
                      }
                      let _ = ed.padding(view::Live::Is((SP_8 + SP_24 + SP_12, SP_8, SP_4, SP_12))).gap(view::Live::Is(SP_8))
                      // Name.
                      let _ = ed.box(fn(nrow : view::View) -> Unit {
                        let _ = nrow.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8))
                        let _ = nrow.box(fn(fw : view::View) -> Unit {
                          let _ = fw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                          let _ = lg::liquid_text_field_node(
                            fw,
                            props.rename_field,
                            placeholder="Space name",
                            height_by=fn() { SP_32 },
                            label=fn() { "Rename Space Input" },
                            show_label=false,
                            flat=true,
                            radius=SP_8,
                            submitted=fn(_t : String) -> Unit { commit_rename() },
                          )
                        })
                        let _ = spx_text_btn(nrow, fn() { "Save Space Name" }, "Save", commit_rename)
                      })
                      // Color: applies at once, the preview follows. The row starts -SP_8 ((32pt hit - 16pt dot) / 2)
                      // so the first dot's edge lines up with the name field above.
                      let _ = ed.box(fn(crow : view::View) -> Unit {
                        let _ = crow
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .gap(view::Live::Is(SP_4))
                        .min_width(view::Live::Is(Some(SP_0)))
                        .margin(view::Live::Is((-SP_8, SP_0, SP_0, SP_0)))
                        let presets = proto::arc_space_accent_presets()
                        let mut ci = 0
                        while ci < presets.length() {
                          let p = presets[ci]
                          let p_hex = p.hex
                          let p_lbl = p.label
                          let _ = spx_swatch(
                            crow,
                            fn() { "Set Space color " + p_lbl },
                            p.rgba,
                            fn() { proto::normalize_space_accent(row_sig.get().accent) == p_hex },
                            fn() {
                              let id = row_sig.untracked().id
                              if id != "" {
                                (props.on_recolor_space)(id, p_hex)
                              }
                            },
                          )
                          ci += 1
                        }
                        let _ = spx_text_btn(
                          crow,
                          fn() { "Customize Space " + row_sig.get().name },
                          "Customize",
                          fn() -> Unit {
                            let id = row_sig.untracked().id
                            if id != "" {
                              (props.on_customize_space)(id)
                            }
                          },
                        )
                        let _ = crow.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                        crow.show(fn() { row_sig.get().can_delete }, fn(del_wrap : view::View) -> Unit {
                          let _ = spx_text_btn(
                            del_wrap,
                            fn() { "Delete Space " + row_sig.get().name },
                            "Delete Space",
                            fn() -> Unit {
                              let id = row_sig.untracked().id
                              if id != "" {
                                if props.rename_space_id.untracked() == id || props.color_edit_space_id.untracked() == id {
                                  close_editor()
                                }
                                (props.on_delete_space)(id)
                              }
                            },
                            ink=fn() { lg::surface().danger },
                          )
                        })
                      })
                    })
                  },
                )
              },
            )

            // New Space: the sidebar's Create a Space when the app has it (name and theme are chosen there).
            match props.on_new_space {
              Some(start) =>
              spx_group(sc, "", fn(g : view::View) -> Unit {
                let _ = headless::button(
                  g,
                  fn() { "New Space" },
                  fn(_e) -> Unit { start() },
                  fn(row : view::View, btn : headless::Button) -> Unit {
                    let hover_t = shell_fade(row, fn() { btn.hovered() || btn.pressed() })
                    let _ = row
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(SP_12))
                    .min_height(view::Live::Is(Some(SP_40)))
                    .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
                    .radius(view::Live::Is(SP_12))
                    .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
                    let _ = row.box(fn(tile : view::View) -> Unit {
                      let _ = tile
                      .width(view::Live::Is(Some(SP_24)))
                      .height(view::Live::Is(Some(SP_24)))
                      .shrink(view::Live::Is(0.0))
                      .radius(view::Live::Is(SP_6))
                      .center()
                      .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                      let _ = shell_icon(tile, ICON_PLUS, size=IC_SM, color_by=fn() { lg::surface().ink })
                    })
                    <ui::Box in={row} fill cut>
                      <ui::Text size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text="New Space" />
                    </ui::Box>
                    let _ = shell_icon(row, ICON_CHEVRON_RIGHT, size=IC_SM, color_by=fn() { lg::surface().ink_tertiary })
                  },
                )
              })
              None =>
              spx_group(
                sc,
                "New Space",
                fn(g : view::View) -> Unit {
                  let _ = g.box(fn(in_row : view::View) -> Unit {
                    let _ = in_row
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(SP_12))
                    .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
                    let _ = shell_glyph_tile(in_row, ICON_PLUS, fn() { proto::workspace_accent_color(props.new_accent.get()) }, size=SP_24)
                    let _ = in_row.box(fn(fw : view::View) -> Unit {
                      let _ = fw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                      let _ = lg::liquid_text_field_node(
                        fw,
                        props.new_name_field,
                        placeholder="Name",
                        height_by=fn() { SP_32 },
                        label=fn() { "New Space Name" },
                        show_label=false,
                        flat=true,
                        radius=SP_8,
                        submitted=fn(_t : String) -> Unit { submit_new_space() },
                      )
                    })
                    let _ = spx_primary_btn(in_row, fn() { "Create Space" }, "Create", submit_new_space)
                  })
                  spx_rule(g)
                  let _ = g.box(fn(sw_row : view::View) -> Unit {
                    let _ = sw_row
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(SP_4))
                    .min_height(view::Live::Is(Some(SP_40)))
                    .padding(view::Live::Is((SP_12 + SP_24 + SP_12, SP_4, SP_8, SP_4)))
                    <ui::Box in={sw_row} fill cut>
                      <ui::Text size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text="Color" />
                    </ui::Box>
                    let presets = proto::arc_space_accent_presets()
                    let mut pi = 0
                    while pi < presets.length() {
                      let preset = presets[pi]
                      let hex = preset.hex
                      let lbl_name = preset.label
                      let _ = spx_swatch(
                        sw_row,
                        fn() { "Accent " + lbl_name },
                        preset.rgba,
                        fn() { proto::normalize_space_accent(props.new_accent.get()) == hex },
                        fn() { props.new_accent.set(hex) },
                      )
                      pi += 1
                    }
                  })
                },
                footnote_by=fn() { "The window frame takes the color of the Space you are in." },
              )
            }
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if props.new_name_field.composing() {
            props.new_name_field.compose("")
            return true
          }
          if props.rename_field.composing() {
            props.rename_field.compose("")
            return true
          }
        }
        false
      },
      return_focus?=props.return_focus,
    )
  })
  built.v = true
}

// ============================================================================
// 2. Recently Closed drawer (restores by the original `it.index` after filtering)
// ============================================================================

///| Props for `build_closed_tabs_drawer_panel`.
pub struct ClosedTabsDrawerProps {
  pub open : () -> Bool
  pub items : () -> Array[proto::ClosedTabItem]
  pub now_secs : () -> Int64
  pub search_field : ui::Field
  pub on_restore_tab : (Int, String) -> Unit
  pub on_clear_all : () -> Unit
  pub on_close : () -> Unit
}

#derive(Eq)
struct ClosedTabKeyedRow {
  key : String
  orig_index : Int
  title : String
  url : String
  host : String
  space_name : String
  closed_secs : Int64
  first : Bool
}

impl signals::Eq for ClosedTabKeyedRow {
  fn eq(self : ClosedTabKeyedRow, other : ClosedTabKeyedRow) -> Bool {
    self.key == other.key &&
    self.orig_index == other.orig_index &&
    self.title == other.title &&
    self.url == other.url &&
    self.host == other.host &&
    self.space_name == other.space_name &&
    self.closed_secs == other.closed_secs &&
    self.first == other.first
  }
}

///| Builds the Recently Closed drawer: search, then one grouped list of closed tabs, newest first.
///| Restoring any row (filtered or not) forwards the original `it.index`.
pub fn build_closed_tabs_drawer_panel(root : view::View, props : ClosedTabsDrawerProps) -> Unit {
  let filtered_rows = fn() -> Array[ClosedTabKeyedRow] {
    let raw = proto::filter_closed_tabs((props.items)(), props.search_field.text())
    let out : Array[ClosedTabKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let it = raw[i]
      out.push(ClosedTabKeyedRow::{
        key: it.index.to_string() + "|" + it.url + "|" + it.closed_secs.to_string(),
        orig_index: it.index,
        title: it.title,
        url: it.url,
        host: it.host,
        space_name: it.space_name,
        closed_secs: it.closed_secs,
        first: i == 0,
      })
      i += 1
    }
    out
  }

  let guarded_close = fn() -> Unit {
    if props.search_field.composing() {
      props.search_field.compose("")
      return
    }
    (props.on_close)()
  }

  let _ = lg::liquid_drawer_node(
    root,
    props.open,
    guarded_close,
    fn() { "Recently Closed" },
    fn(body : view::View) -> Unit {
      let _ = body.fill().gap(view::Live::Is(SP_12))

      // The same header as the area's dialogs: glyph tile, TX_CALLOUT/600 title, flat close.
      let _ = body.box(fn(hw : view::View) -> Unit {
        let _ = hw.rigid().padding(view::Live::Is((SP_0, SP_0, SP_0, SP_4)))
        spx_dialog_header(
          hw,
          ICON_CLOCK,
          0x8E8E93FFL,
          "Recently Closed",
          fn() {
            let n = (props.items)().length()
            if n > 0 { spx_plural(n, "closed tab", "closed tabs") } else { "" }
          },
          "Close Recently Closed",
          guarded_close,
        )
      })

      // Search (Enter restores the first match, by its original index).
      let _ = lg::liquid_text_field_node(
        body,
        props.search_field,
        placeholder="Search closed tabs",
        height_by=fn() { SP_32 },
        label=fn() { "Filter Closed Tabs" },
        show_label=false,
        flat=true,
        radius=SP_8,
        lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
          let _ = shell_icon(ic, ICON_SEARCH, size=IC_SM, color_by=ink)
        },
        trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
          tr.show(fn() { props.search_field.text() != "" }, fn(cw : view::View) -> Unit {
            let _ = spx_icon_btn(cw, fn() { "Clear Closed Tabs Filter" }, ICON_CLOSE, fn() { props.search_field.set("") })
          })
        },
        submitted=fn(_q : String) -> Unit {
          let list = filtered_rows()
          if list.length() > 0 {
            let first = list[0]
            (props.on_close)()
            (props.on_restore_tab)(first.orig_index, first.title)
          }
        },
      )

      let _ = body.box(fn(list_wrap : view::View) -> Unit {
        let _ = list_wrap.fill().clips(view::Live::Is(true))
        let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
          let _ = sc.gap(view::Live::Is(SP_8)).padding(view::Live::Is((SP_0, SP_0, SP_0, SP_8)))

          // Empty / no-match state.
          sc.show(fn() { filtered_rows().length() == 0 }, fn(emp : view::View) -> Unit {
            let _ = emp.padding(view::Live::Is((SP_16, SP_40, SP_16, SP_40))).gap(view::Live::Is(SP_8)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = shell_glyph_tile(emp, ICON_CLOCK, fn() { 0x8E8E93FFL }, size=SP_32)
            <ui::Text
              in={emp}
              size={TX_BODY}
              weight={500}
              color_by=>{lg::surface().ink}
              text_by=>{
                if props.search_field.text().trim() != "" { "No closed tabs match" } else { "No recently closed tabs" }
              }
            />
            <ui::Text
              in={emp}
              size={TX_FOOTNOTE}
              wrap
              center
              color_by=>{lg::surface().ink_secondary}
              text_by=>{
                if props.search_field.text().trim() != "" {
                  "Search looks at titles, sites and Spaces."
                } else {
                  "Tabs you close show up here, newest first."
                }
              }
            />
          })

          sc.show(fn() { filtered_rows().length() > 0 }, fn(card_wrap : view::View) -> Unit {
            let _ = lg::surface_card_node(
              card_wrap,
              fn(card : view::View) -> Unit {
                card.each(
                  filtered_rows,
                  fn(r : ClosedTabKeyedRow) -> String { r.key },
                  fn(slot : view::View, row_sig : signals::Signal[ClosedTabKeyedRow]) -> Unit {
                    slot.show(fn() { !row_sig.get().first }, fn(rw : view::View) -> Unit {
                      spx_rule(rw, inset=SP_8 + SP_24 + SP_12)
                    })
                    let _ = headless::button(
                      slot,
                      fn() { "Restore " + row_sig.get().title },
                      fn(_v : view::View) -> Unit {
                        let r = row_sig.untracked()
                        (props.on_close)()
                        (props.on_restore_tab)(r.orig_index, r.title)
                      },
                      fn(row : view::View, btn : headless::Button) -> Unit {
                        let hover_t = shell_fade(row, fn() { btn.hovered() || btn.pressed() })
                        let _ = row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Start)))
                        .min_height(view::Live::Is(Some(SP_48)))
                        .padding(view::Live::Is((SP_8, SP_6, SP_8, SP_6)))
                        .gap(view::Live::Is(SP_12))
                        .radius(view::Live::Is(SP_8))
                        .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
                        let _ = shell_site_tile(row, fn() { row_sig.get().host }, size=SP_24)
                        let _ = row.box(fn(col : view::View) -> Unit {
                          let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).gap(view::Live::Is(SP_2)).padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
                          let _ = col.box(fn(l1 : view::View) -> Unit {
                            let _ = l1.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8))
                            spx_line(l1, fn() { row_sig.get().title }, grow=true)
                            <ui::Text
                              in={l1}
                              size={TX_FOOTNOTE}
                              color_by=>{lg::surface().ink_tertiary}
                              text_by=>{proto::format_closed_relative_time(row_sig.get().closed_secs, (props.now_secs)())}
                            />
                          })
                          let _ = col.box(fn(l2 : view::View) -> Unit {
                            let _ = l2.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8))
                            spx_line(l2, fn() { row_sig.get().host }, size=TX_FOOTNOTE, color_by=fn() { lg::surface().ink_secondary }, grow=true)
                            <ui::Text
                              in={l2}
                              size={TX_FOOTNOTE}
                              color_by=>{lg::surface().ink_tertiary}
                              text_by=>{row_sig.get().space_name.trim()}
                            />
                          })
                        })
                      },
                    )
                  },
                )
              },
              radius=SP_12,
              pad=SP_4,
            )
          })

          // Clear the whole list: only while it is shown unfiltered, so the button never sits under a no-match state.
          sc.show(fn() { props.search_field.text().trim() == "" && filtered_rows().length() > 0 }, fn(fw : view::View) -> Unit {
            let _ = fw.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid()
            let _ = fw.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
            let _ = spx_text_btn(fw, fn() { "Clear All Closed Tabs" }, "Clear All", props.on_clear_all, ink=fn() { lg::surface().danger })
          })
        })
      })
    },
    side=lg::DrawerSide::Trailing,
    width=SP_160 + SP_160 + SP_40,
    scrim=true,
    inset=SP_8,
    show_header=false,
    body_pad=SP_16,
  )
}

///| A segment label drawn at one weight (500) whether chosen or not: selection shows only through the thumb.
fn print_seg_item(labels : Array[String]) -> (view::View, Int, () -> Bool) -> Unit {
  fn(seg : view::View, idx : Int, _chosen : () -> Bool) -> Unit {
    let text = if idx >= 0 && idx < labels.length() { labels[idx] } else { "" }
    let _ = <ui::Text in={seg} size={TX_FOOTNOTE} weight={500} lines={1} color_by=>{lg::surface().ink} text={text} />
  }
}

// ============================================================================
// 3. Export PDF dialog
// ============================================================================

///| Props for `build_print_pdf_modal_panel`.
///| `owner_pane` is locked when the dialog opens so `Save as PDF` routes to that exact pane.
pub struct PrintPdfModalProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub page_title : () -> String
  pub page_url : () -> String
  pub paper : signals::Signal[String]
  pub orientation : signals::Signal[String]
  pub margins : signals::Signal[String]
  pub background_graphics : signals::Signal[Bool]
  pub on_save_pdf : (Int, proto::PrintPdfConfig) -> Unit
  pub on_cancel : () -> Unit
  pub return_focus : Option[view::View]
}

fn print_paper_key(raw : String) -> String {
  let s = raw.trim()
  if s == "legal" || s == "Legal" || s == "LEGAL" {
    "legal"
  } else if s == "letter" || s == "Letter" || s == "LETTER" {
    "letter"
  } else {
    "a4"
  }
}

fn print_paper_index(raw : String) -> Int {
  let k = print_paper_key(raw)
  if k == "letter" { 1 } else if k == "legal" { 2 } else { 0 }
}

fn print_orientation_key(raw : String) -> String {
  proto::normalize_print_orientation(raw)
}

fn print_orientation_index(raw : String) -> Int {
  if print_orientation_key(raw) == "landscape" { 1 } else { 0 }
}

fn print_margins_key(raw : String) -> String {
  proto::normalize_print_margins(raw)
}

fn print_margins_index(raw : String) -> Int {
  let k = print_margins_key(raw)
  if k == "narrow" {
    1
  } else if k == "wide" {
    2
  } else if k == "none" {
    3
  } else {
    0
  }
}

fn print_preview_dims_mm(paper : String, orientation : String) -> (Double, Double) {
  let p = print_paper_key(paper)
  let o = print_orientation_key(orientation)
  let (bw, bh) = if p == "legal" {
    (215.9, 355.6)
  } else if p == "letter" {
    (215.9, 279.4)
  } else {
    (210.0, 297.0)
  }
  if o == "landscape" { (bh, bw) } else { (bw, bh) }
}

fn print_preview_spec_label(paper : String, orientation : String) -> String {
  let (w, h) = print_preview_dims_mm(paper, orientation)
  let wi = (w + 0.5).floor().to_int()
  let hi = (h + 0.5).floor().to_int()
  wi.to_string() + " \u{00D7} " + hi.to_string() + " mm"
}

///| On-screen size of the preview sheet: the paper's proportions fitted into `max_w` x `max_h`.
fn print_sheet_size(paper : String, orientation : String, max_w : Double, max_h : Double) -> (Double, Double) {
  let (w, h) = print_preview_dims_mm(paper, orientation)
  if w <= 0.0 || h <= 0.0 {
    return (max_w, max_h)
  }
  let sx = max_w / w
  let sy = max_h / h
  let s = if sx < sy { sx } else { sy }
  ((w * s).floor(), (h * s).floor())
}

///| A row of the settings list: label on the leading side, a control on the trailing side.
fn print_setting_row(parent : view::View, label : String, control : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_48)))
    .padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8)))
    .gap(view::Live::Is(SP_12))
    <ui::Box in={row} fill cut>
      <ui::Text size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text={label} />
    </ui::Box>
    control(row)
  })
}

///| Builds the Export PDF dialog: a paper preview beside grouped settings (stacked below 720pt), Save as PDF.
pub fn build_print_pdf_modal_panel(root : view::View, props : PrintPdfModalProps) -> Unit {
  let cancel_fn = props.on_cancel

  let resolved_title = fn() -> String {
    let t = (props.page_title)().trim()
    if t != "" {
      t
    } else {
      let h = proto::omnibox_display_host((props.page_url)())
      if h != "" { h } else { "Untitled page" }
    }
  }

  let resolved_clean_url = fn() -> String {
    let u = proto::clean_tracking_url((props.page_url)())
    let h = proto::omnibox_display_host(u)
    if h != "" { h } else if u != "" { u } else { "about:blank" }
  }

  let snapshot_config_untracked = fn() -> proto::PrintPdfConfig {
    proto::PrintPdfConfig::{
      paper: print_paper_key(props.paper.untracked()),
      orientation: print_orientation_key(props.orientation.untracked()),
      margins: print_margins_key(props.margins.untracked()),
      background_graphics: props.background_graphics.untracked(),
    }
  }

  let is_narrow = fn() -> Bool {
    let ww = root.window_w()
    ww > 0.0 && ww < SP_160 * 4.0 + SP_80
  }
  // Segmented controls share one width so their edges line up.
  let seg_w = SP_160 + SP_80

  // Opened by the person: the shared dialog presence. Already open when built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  root.show(props.open, leave=MO_DIALOG_OUT_MS, fn(dlg_wrap : view::View) -> Unit {
    let cancel_now = shell_closes(dlg_wrap, cancel_fn)
    let reveal = shell_dialog_reveal(dlg_wrap, built.v)
    reveal.fades(dlg_wrap)
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Export PDF" },
      props.open,
      cancel_now,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center()
        spx_scrim(dlg_box, cancel_now)

        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          reveal.grows_only(shell)
          let _ = shell
          .width(view::Live::By(spx_dialog_width(root, SP_160 * 4.0 + SP_40)))
          .max_height(view::Live::By(fn() {
            let wh = root.window_h()
            if wh > 0.0 { Some(wh - SP_32) } else { None }
          }))
          .padding(view::Live::By(fn() {
            (SP_24, SP_24, SP_24, SP_24)
          }))
          .gap(view::Live::Is(SP_20))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          spx_dialog_header(
            shell,
            ICON_DOWNLOAD,
            0x007AFFFFL,
            "Export PDF",
            resolved_title,
            "Close Export PDF Dialog",
            cancel_now,
          )

          let _ = shell.box(fn(body : view::View) -> Unit {
            let _ = body.row(view::Live::By(fn() { !is_narrow() })).gap(view::Live::By(fn() { if is_narrow() { SP_16 } else { SP_20 } })).rigid()

            // Paper preview: the sheet in its proportions, margins and background graphics.
            let _ = body.box(fn(stage : view::View) -> Unit {
              let max_w = fn() { if is_narrow() { SP_96 + SP_16 } else { SP_160 + SP_32 } }
              let max_h = fn() { if is_narrow() { SP_128 + SP_16 } else { SP_160 + SP_64 } }
              let _ = stage
              .width(view::Live::By(fn() { if is_narrow() { None } else { Some(SP_160 + SP_80) } }))
              .rigid()
              .radius(view::Live::Is(SP_12))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              .padding(view::Live::By(fn() { if is_narrow() { (SP_16, SP_16, SP_16, SP_12) } else { (SP_20, SP_24, SP_20, SP_16) } }))
              .gap(view::Live::Is(SP_12))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              let _ = stage.box(fn(frame : view::View) -> Unit {
                let _ = frame
                .width(view::Live::By(fn() { Some(max_w()) }))
                .height(view::Live::By(fn() { Some(max_h()) }))
                .rigid()
                .center()
                let _ = frame.box(fn(sheet : view::View) -> Unit {
                  let size = fn() { print_sheet_size(props.paper.get(), props.orientation.get(), max_w(), max_h()) }
                  let _ = sheet
                  .width(view::Live::By(fn() { Some(size().0) }))
                  .height(view::Live::By(fn() { Some(size().1) }))
                  .rigid()
                  .radius(view::Live::Is(SP_2))
                  .clips(view::Live::Is(true))
                  .ground(view::Live::Is(0xFFFFFFFFL))
                  .shadow(view::Live::Is((SP_8, SP_2, 0x00000026L)))
                  .shadow_outside(view::Live::Is(true))
                  .padding(view::Live::By(fn() {
                    let (wmm, _) = print_preview_dims_mm(props.paper.get(), props.orientation.get())
                    let m = proto::print_pdf_margin_mm(props.margins.get())
                    let p = if wmm > 0.0 { (size().0 * m / wmm).floor() } else { SP_8 }
                    (p, p, p, p)
                  }))
                  let _ = sheet.box(fn(inner : view::View) -> Unit {
                    let _ = inner.fill().gap(view::Live::Is(SP_4)).clips(view::Live::Is(true))
                    // Background graphics: the page's own header band.
                    inner.show(fn() { props.background_graphics.get() }, fn(band : view::View) -> Unit {
                      let _ = band.height(view::Live::Is(Some(SP_12))).rigid().radius(view::Live::Is(SP_2)).ground(view::Live::Is(0xDCE9FBFFL))
                    })
                    spx_line(inner, resolved_title, size=TX_CAPTION, weight=600, color_by=fn() { 0x1D1D1FFFL })
                    spx_line(inner, resolved_clean_url, size=TX_CAPTION, color_by=fn() { 0x6E6E73FFL })
                    let fracs : Array[Double] = [1.0, 0.92, 0.97, 0.84, 1.0, 0.9, 0.62]
                    let mut li = 0
                    while li < fracs.length() {
                      let f = fracs[li]
                      let _ = inner.box(fn(ln : view::View) -> Unit {
                        let _ = ln.height(view::Live::Is(Some(SP_2))).rigid().radius(view::Live::Is(SP_2)).ground(view::Live::Is(0xE5E5EAFFL))
                        if f < 1.0 {
                          let _ = ln.margin(view::Live::By(fn() {
                            let (sw, _) = size()
                            (SP_0, SP_0, (sw * (1.0 - f) * 0.5).floor(), SP_0)
                          }))
                        }
                      })
                      li += 1
                    }
                  })
                })
              })
              <ui::Text
                in={stage}
                size={TX_FOOTNOTE}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{print_preview_spec_label(props.paper.get(), props.orientation.get())}
              />
            })

            // Settings.
            let _ = body.box(fn(cfg : view::View) -> Unit {
              let _ = cfg
              .grow(view::Live::By(fn() { if is_narrow() { 0.0 } else { 1.0 } }))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::By(fn() { if is_narrow() { None } else { Some(0.0) } }))
              .min_width(view::Live::Is(Some(SP_0)))
              .gap(view::Live::Is(SP_20))
              spx_group(cfg, "Page", fn(g : view::View) -> Unit {
                print_setting_row(g, "Paper size", fn(tr : view::View) -> Unit {
                  let _ = lg::liquid_segmented_node(
                    tr,
                    fn() { ["A4", "Letter", "Legal"] },
                    fn() { print_paper_index(props.paper.get()) },
                    fn(idx : Int) -> Unit {
                      if idx == 1 {
                        props.paper.set("letter")
                      } else if idx == 2 {
                        props.paper.set("legal")
                      } else {
                        props.paper.set("a4")
                      }
                    },
                    width=seg_w,
                    height=SP_32,
                    text_size=fn() { TX_FOOTNOTE },
                    said="Paper size",
                    render_item=print_seg_item(["A4", "Letter", "Legal"]),
                    flat=true,
                  )
                })
                spx_rule(g, inset=SP_12)
                print_setting_row(g, "Orientation", fn(tr : view::View) -> Unit {
                  let _ = lg::liquid_segmented_node(
                    tr,
                    fn() { ["Portrait", "Landscape"] },
                    fn() { print_orientation_index(props.orientation.get()) },
                    fn(idx : Int) -> Unit {
                      if idx == 1 {
                        props.orientation.set("landscape")
                      } else {
                        props.orientation.set("portrait")
                      }
                    },
                    width=seg_w,
                    height=SP_32,
                    text_size=fn() { TX_FOOTNOTE },
                    said="Orientation",
                    render_item=print_seg_item(["Portrait", "Landscape"]),
                    flat=true,
                  )
                })
                spx_rule(g, inset=SP_12)
                print_setting_row(g, "Margins", fn(tr : view::View) -> Unit {
                  let _ = lg::liquid_segmented_node(
                    tr,
                    fn() { ["Default", "Narrow", "Wide", "None"] },
                    fn() { print_margins_index(props.margins.get()) },
                    fn(idx : Int) -> Unit {
                      if idx == 1 {
                        props.margins.set("narrow")
                      } else if idx == 2 {
                        props.margins.set("wide")
                      } else if idx == 3 {
                        props.margins.set("none")
                      } else {
                        props.margins.set("default")
                      }
                    },
                    width=seg_w,
                    height=SP_32,
                    text_size=fn() { TX_FOOTNOTE },
                    said="Margins",
                    render_item=print_seg_item(["Default", "Narrow", "Wide", "None"]),
                    flat=true,
                  )
                })
              })
              spx_group(
                cfg,
                "",
                fn(g : view::View) -> Unit {
                  print_setting_row(g, "Background graphics", fn(tr : view::View) -> Unit {
                    let _ = lg::liquid_toggle_node(
                      tr,
                      fn() { props.background_graphics.get() },
                      fn(next : Bool) -> Unit { props.background_graphics.set(next) },
                      fn() { "Background graphics" },
                    )
                  })
                },
                footnote_by=fn() { "Keeps the page's background colors and images." },
              )
            })
          })

          // Footer: where it goes, Cancel, Save as PDF.
          let _ = shell.box(fn(ftr : view::View) -> Unit {
            let _ = ftr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8)).rigid()
            <ui::Box in={ftr} fill cut>
              <ui::Text size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink_secondary} text="Saves to Downloads" />
            </ui::Box>
            let cancel_btn = lg::liquid_button_node(
              ftr,
              fn() { "Cancel Export PDF" },
              cancel_now,
              content=fn(inner : view::View) -> Unit {
                let _ = <ui::Text in={inner} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text="Cancel" />
              },
              flat=true,
              height=SP_32,
              pad_x=SP_16,
            )
            let _ = spx_primary_btn(
              ftr,
              fn() { "Save as PDF" },
              "Save as PDF",
              fn() -> Unit {
                let pane = signals::untracked(props.owner_pane)
                let cfg = snapshot_config_untracked()
                (props.on_save_pdf)(pane, cfg)
              },
            )
            let _ = cancel_btn.ask_focus()
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      return_focus?=props.return_focus,
    )
  })
  built.v = true
}
