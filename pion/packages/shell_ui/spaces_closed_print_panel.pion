///| Farview Desktop Shell 2.0 Phase 3B — Liquid Glass Deep Drawers & Modals (Part 3):
///| 1. Arc Spaces Manager Modal (`build_spaces_modal_panel`)
///| 2. Recently Closed Tabs Drawer (`build_closed_tabs_drawer_panel`)
///| 3. Print / Export PDF Settings Modal (`build_print_pdf_modal_panel`)
///|
///| Architecture invariants:
///| - Closed Tabs click-to-restore strictly forwards original `it.index` (NEVER filtered array index).
///| - Print / PDF Modal binds `owner_pane` locked on open, supports Paper (A4/Letter/Legal),
///|   Orientation (Portrait/Landscape), Margins (Default/Narrow/Wide), Background Graphics toggle,
///|   solid paper preview card, and strict `proto::PrintPdfConfig` save callback.
///| - Single-layer Liquid Glass on outermost Drawer/Dialog only; 100% solid `lg::surface()` inside.
///| - 100% vector icons via `shell_icon`, 100% explicit `color_by`, point-unit layout, zero Unicode pseudo-icons.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Arc Spaces Manager Modal
// ============================================================================

///| Props for `build_spaces_modal_panel`.
pub struct SpacesModalProps {
  pub open : () -> Bool
  pub spaces : () -> Array[proto::SpaceSummary]
  pub active_space_id : () -> String
  pub new_name_field : ui::Field
  pub new_accent : signals::Signal[String]
  pub rename_space_id : signals::Signal[String]
  pub rename_field : ui::Field
  pub color_edit_space_id : signals::Signal[String]
  pub on_create_space : (String, String) -> Unit
  pub on_switch_space : (String) -> Unit
  pub on_rename_space : (String, String) -> Unit
  pub on_recolor_space : (String, String) -> Unit
  pub on_delete_space : (String) -> Unit
  pub on_close : () -> Unit
  pub return_focus : Option[view::View]
}

#derive(Eq)
struct SpaceKeyedRow {
  id : String
  name : String
  accent : String
  active : Bool
  tab_count : Int
  can_delete : Bool
}

impl signals::Eq for SpaceKeyedRow {
  fn eq(self : SpaceKeyedRow, other : SpaceKeyedRow) -> Bool {
    self.id == other.id &&
    self.name == other.name &&
    self.accent == other.accent &&
    self.active == other.active &&
    self.tab_count == other.tab_count &&
    self.can_delete == other.can_delete
  }
}

///| Builds the Liquid Glass Spaces Manager Modal (create, switch, rename, recolor, delete).
pub fn build_spaces_modal_panel(root : view::View, props : SpacesModalProps) -> Unit {
  let close_fn = props.on_close
  let submit_new_space = fn() -> Unit {
    let raw_name = props.new_name_field.text().trim()
    let hex = props.new_accent.untracked()
    (props.on_create_space)(raw_name, hex)
    props.new_name_field.set("")
  }

  let keyed_spaces = fn() -> Array[SpaceKeyedRow] {
    let list = (props.spaces)()
    let act_id = (props.active_space_id)()
    let allow_delete = list.length() > 1
    let out : Array[SpaceKeyedRow] = []
    let mut i = 0
    while i < list.length() {
      let sp = list[i]
      let is_act = sp.active || (sp.id != "" && sp.id == act_id)
      out.push(SpaceKeyedRow::{
        id: sp.id,
        name: if sp.name != "" { sp.name } else { sp.id },
        accent: sp.accent,
        active: is_act,
        tab_count: sp.tab_count,
        can_delete: allow_delete,
      })
      i += 1
    }
    out
  }

  root.show(props.open, fn(dlg_wrap : view::View) -> Unit {
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Spaces Manager" },
      props.open,
      close_fn,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center().padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))

        // Full-window pointer-blocking scrim
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x05081068L } else { 0x0F172A40L } }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { close_fn() })
        })

        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          let _ = shell
          .width(view::Live::Is(Some(560.0)))
          .max_height(view::Live::Is(Some(608.0)))
          .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
          .gap(view::Live::Is(12.0))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          // 1. Header
          let _ = shell.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
            let _ = shell_icon(hdr, ICON_LAYERS, size=16.0, color_by=fn() { lg::surface().accent })
            let _ = <ui::Text in={hdr} size={15.0} weight={600} color_by=>{lg::surface().ink} text="Spaces" />
            let _ = hdr.box(fn(iso : view::View) -> Unit {
              let _ = iso
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().accent_tint }))
              let _ = <ui::Text
                in={iso}
                size={11.0}
                weight={500}
                color_by=>{lg::surface().accent}
                text="Isolated Cookie Partition"
              />
            })
            let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
            let _ = phase3b_icon_action_btn(hdr, fn() { "Close Spaces Manager" }, ICON_CLOSE, close_fn)
          })

          // 2. Create New Space solid card
          let _ = lg::surface_card_node(
            shell,
            fn(new_sec : view::View) -> Unit {
              let _ = new_sec.gap(view::Live::Is(10.0))

              let _ = new_sec.box(fn(sh : view::View) -> Unit {
                let _ = sh.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                let _ = <ui::Text in={sh} size={11.0} weight={600} color_by=>{lg::surface().ink_secondary} text="NEW SPACE" />
                let _ = sh.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                let _ = <ui::Text in={sh} size={11.0} color_by=>{lg::surface().ink_tertiary} text="Separate cookies, storage & pinned tabs" />
              })

              // Input + Create CTA
              let _ = new_sec.box(fn(in_row : view::View) -> Unit {
                let _ = in_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                let _ = in_row.box(fn(fw : view::View) -> Unit {
                  let _ = fw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                  let _ = lg::liquid_text_field_node(
                    fw,
                    props.new_name_field,
                    placeholder="Space name (e.g. Design, Research)...",
                    height_by=fn() { 36.0 },
                    label=fn() { "New Space Name" },
                    show_label=false,
                    flat=true,
                    radius=10.0,
                    lead=fn(dot_host : view::View, _ink : () -> Int64) -> Unit {
                      let _ = dot_host.box(fn(dot : view::View) -> Unit {
                        let _ = dot
                        .width(view::Live::Is(Some(10.0)))
                        .height(view::Live::Is(Some(10.0)))
                        .rigid()
                        .radius(view::Live::Is(5.0))
                        .ground(view::Live::By(fn() { proto::workspace_accent_color(props.new_accent.get()) }))
                      })
                    },
                    submitted=fn(_t : String) -> Unit { submit_new_space() },
                  )
                })
                let _ = lg::liquid_button_node(
                  in_row,
                  fn() { "Create Space" },
                  submit_new_space,
                  prominent=true,
                  height=36.0,
                  pad_x=14.0,
                )
              })

              // Theme accent swatches
              let _ = new_sec.box(fn(sw_row : view::View) -> Unit {
                let _ = sw_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                let _ = <ui::Text in={sw_row} size={11.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Accent" />

                let presets = proto::arc_space_accent_presets()
                let mut pi = 0
                while pi < presets.length() {
                  let preset = presets[pi]
                  let hex = preset.hex
                  let rgba = preset.rgba
                  let lbl_name = preset.label
                  let is_sel = fn() -> Bool { proto::normalize_space_accent(props.new_accent.get()) == hex }
                  let _ = headless::button(
                    sw_row,
                    fn() { "Accent " + lbl_name },
                    fn(_v : view::View) -> Unit { props.new_accent.set(hex) },
                    fn(sw : view::View, _btn : headless::Button) -> Unit {
                      let _ = sw
                      .width(view::Live::Is(Some(36.0)))
                      .height(view::Live::Is(Some(36.0)))
                      .rigid()
                      .center()
                      .radius(view::Live::Is(18.0))
                      .ground(view::Live::By(fn() { if is_sel() { lg::surface().row_selected } else { 0x00000000L } }))
                      let _ = sw.box(fn(ring : view::View) -> Unit {
                        let _ = ring
                        .width(view::Live::Is(Some(24.0)))
                        .height(view::Live::Is(Some(24.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(12.0))
                        .edge(view::Live::By(fn() { if is_sel() { (2.0, rgba) } else { (0.0, 0x00000000L) } }))
                        let _ = ring.box(fn(dot : view::View) -> Unit {
                          let _ = dot
                          .width(view::Live::Is(Some(16.0)))
                          .height(view::Live::Is(Some(16.0)))
                          .rigid()
                          .radius(view::Live::Is(8.0))
                          .ground(view::Live::Is(rgba))
                        })
                      })
                    },
                  )
                  pi += 1
                }

                let _ = sw_row.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
                let _ = <ui::Text
                  in={sw_row}
                  size={11.0}
                  weight={500}
                  color_by=>{lg::surface().ink_secondary}
                  text_by=>{proto::space_accent_label_for_hex(props.new_accent.get())}
                />
              })
            },
            radius=lg::r_row,
            pad=12.0,
            secondary=true,
          )

          // 3. Scrollable Spaces List (solid cards)
          let _ = shell.box(fn(list_wrap : view::View) -> Unit {
            let _ = list_wrap
            .height(view::Live::Is(Some(288.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .min_height(view::Live::Is(Some(0.0)))
            .rigid()
            .clips(view::Live::Is(true))
            .radius(view::Live::Is(lg::r_row))
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

            let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
              let _ = sc.padding(view::Live::Is((10.0, 10.0, 10.0, 10.0))).gap(view::Live::Is(8.0))

              sc.each(
                keyed_spaces,
                fn(r : SpaceKeyedRow) -> String { r.id },
                fn(slot : view::View, row_sig : signals::Signal[SpaceKeyedRow]) -> Unit {
                  let is_renaming = fn() -> Bool {
                    let id = row_sig.get().id
                    id != "" && props.rename_space_id.get() == id
                  }
                  let is_recoloring = fn() -> Bool {
                    let id = row_sig.get().id
                    id != "" && props.color_edit_space_id.get() == id
                  }

                  let _ = lg::surface_card_node(
                    slot,
                    fn(card : view::View) -> Unit {
                      let _ = card.gap(view::Live::Is(8.0))

                      // Primary row
                      let _ = card.box(fn(main_row : view::View) -> Unit {
                        let _ = main_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))

                        // Accent color dot button
                        let _ = headless::button(
                          main_row,
                          fn() { "Recolor Space " + row_sig.get().name },
                          fn(_v : view::View) -> Unit {
                            let id = row_sig.untracked().id
                            if id != "" {
                              if props.color_edit_space_id.untracked() == id {
                                props.color_edit_space_id.set("")
                              } else {
                                props.rename_space_id.set("")
                                props.color_edit_space_id.set(id)
                              }
                            }
                          },
                          fn(db : view::View, dbtn : headless::Button) -> Unit {
                            let _ = db
                            .width(view::Live::Is(Some(36.0)))
                            .height(view::Live::Is(Some(36.0)))
                            .rigid()
                            .center()
                            .radius(view::Live::Is(18.0))
                            .ground(view::Live::By(fn() { if dbtn.hovered() || is_recoloring() { lg::surface().row_hover } else { 0x00000000L } }))
                            let _ = db.box(fn(dot : view::View) -> Unit {
                              let _ = dot
                              .width(view::Live::Is(Some(14.0)))
                              .height(view::Live::Is(Some(14.0)))
                              .rigid()
                              .radius(view::Live::Is(7.0))
                              .ground(view::Live::By(fn() { proto::workspace_accent_color(row_sig.get().accent) }))
                            })
                          },
                        )

                        // Space name
                        let _ = main_row.box(fn(nm : view::View) -> Unit {
                          let _ = nm.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).cut()
                          let _ = <ui::Text
                            in={nm}
                            size={13.5}
                            weight={600}
                            color_by=>{lg::surface().ink}
                            text_by=>{row_sig.get().name}
                          />.allow_ellipsis(view::Live::Is(true))
                        })

                        // Tab count pill
                        let _ = main_row.box(fn(tc : view::View) -> Unit {
                          let _ = tc
                          .height(view::Live::Is(Some(20.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                          .radius(view::Live::Is(6.0))
                          .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                          let _ = <ui::Text
                            in={tc}
                            size={10.5}
                            weight={500}
                            color_by=>{lg::surface().ink_secondary}
                            text_by=>{proto::space_tab_count_label(row_sig.get().tab_count)}
                          />
                        })

                        // Active badge
                        main_row.show(fn() { row_sig.get().active }, fn(ab : view::View) -> Unit {
                          let _ = ab
                          .height(view::Live::Is(Some(20.0)))
                          .rigid()
                          .center()
                          .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                          .radius(view::Live::Is(6.0))
                          .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                          let _ = <ui::Text in={ab} size={10.5} weight={600} color_by=>{lg::surface().accent} text="Active" />
                        })

                        let _ = main_row.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

                        // Switch button (only for non-active spaces)
                        main_row.show(fn() { !row_sig.get().active }, fn(sw_wrap : view::View) -> Unit {
                          let _ = lg::liquid_button_node(
                            sw_wrap,
                            fn() { "Switch to Space " + row_sig.get().name },
                            fn() -> Unit {
                              let id = row_sig.untracked().id
                              if id != "" {
                                (props.on_switch_space)(id)
                              }
                            },
                            content=fn(inner : view::View) -> Unit {
                              let _ = <ui::Text in={inner} size={11.5} weight={600} color_by=>{lg::surface().ink} text="Switch" />
                            },
                            flat=true,
                            height=30.0,
                            pad_x=10.0,
                          )
                        })

                        // Rename button
                        let _ = lg::liquid_button_node(
                          main_row,
                          fn() { "Rename Space " + row_sig.get().name },
                          fn() -> Unit {
                            let r = row_sig.untracked()
                            if r.id != "" {
                              if props.rename_space_id.untracked() == r.id {
                                props.rename_space_id.set("")
                              } else {
                                props.color_edit_space_id.set("")
                                props.rename_space_id.set(r.id)
                                props.rename_field.set(r.name)
                                props.rename_field.focus()
                              }
                            }
                          },
                          content=fn(inner : view::View) -> Unit {
                            let _ = <ui::Text in={inner} size={11.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Rename" />
                          },
                          flat=true,
                          height=30.0,
                          pad_x=10.0,
                        )

                        // Delete button (only when > 1 space exists)
                        main_row.show(fn() { row_sig.get().can_delete }, fn(del_wrap : view::View) -> Unit {
                          let _ = lg::liquid_button_node(
                            del_wrap,
                            fn() { "Delete Space " + row_sig.get().name },
                            fn() -> Unit {
                              let id = row_sig.untracked().id
                              if id != "" {
                                if props.rename_space_id.untracked() == id {
                                  props.rename_space_id.set("")
                                }
                                if props.color_edit_space_id.untracked() == id {
                                  props.color_edit_space_id.set("")
                                }
                                (props.on_delete_space)(id)
                              }
                            },
                            content=fn(inner : view::View) -> Unit {
                              let _ = <ui::Text in={inner} size={11.5} weight={600} color_by=>{0xFFFFFFFFL} text="Delete" />
                            },
                            flat=true,
                            height=30.0,
                            pad_x=10.0,
                            tint=lg::surface().danger,
                          )
                        })
                      })

                      // Inline Rename Row
                      card.show(is_renaming, fn(ren_row : view::View) -> Unit {
                        let commit_rename = fn() -> Unit {
                          let id = row_sig.untracked().id
                          let nm = props.rename_field.text().trim()
                          if id != "" && nm != "" {
                            (props.on_rename_space)(id, nm)
                          }
                          props.rename_space_id.set("")
                        }
                        let _ = ren_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                        let _ = ren_row.box(fn(fw : view::View) -> Unit {
                          let _ = fw.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                          let _ = lg::liquid_text_field_node(
                            fw,
                            props.rename_field,
                            placeholder="New Space name...",
                            height_by=fn() { 36.0 },
                            label=fn() { "Rename Space Input" },
                            show_label=false,
                            flat=true,
                            radius=8.0,
                            submitted=fn(_t : String) -> Unit { commit_rename() },
                          )
                        })
                        let _ = lg::liquid_button_node(
                          ren_row,
                          fn() { "Save Space Name" },
                          commit_rename,
                          content=fn(inner : view::View) -> Unit {
                            let _ = <ui::Text in={inner} size={12.0} weight={600} color_by=>{0xFFFFFFFFL} text="Save" />
                          },
                          prominent=true,
                          height=36.0,
                          pad_x=14.0,
                        )
                      })

                      // Inline Accent Recolor Row
                      card.show(is_recoloring, fn(col_row : view::View) -> Unit {
                        let _ = col_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                        let presets = proto::arc_space_accent_presets()
                        let mut ci = 0
                        while ci < presets.length() {
                          let p_item = presets[ci]
                          let p_hex = p_item.hex
                          let p_rgba = p_item.rgba
                          let p_lbl = p_item.label
                          let is_cur = fn() -> Bool { proto::normalize_space_accent(row_sig.get().accent) == p_hex }
                          let _ = headless::button(
                            col_row,
                            fn() { "Set Space color " + p_lbl },
                            fn(_v : view::View) -> Unit {
                              let id = row_sig.untracked().id
                              if id != "" {
                                (props.on_recolor_space)(id, p_hex)
                                props.color_edit_space_id.set("")
                              }
                            },
                            fn(sw : view::View, _btn : headless::Button) -> Unit {
                              let _ = sw
                              .width(view::Live::Is(Some(36.0)))
                              .height(view::Live::Is(Some(36.0)))
                              .rigid()
                              .center()
                              .radius(view::Live::Is(18.0))
                              .ground(view::Live::By(fn() { if is_cur() { lg::surface().row_selected } else { 0x00000000L } }))
                              let _ = sw.box(fn(d : view::View) -> Unit {
                                let _ = d
                                .width(view::Live::Is(Some(16.0)))
                                .height(view::Live::Is(Some(16.0)))
                                .rigid()
                                .radius(view::Live::Is(8.0))
                                .ground(view::Live::Is(p_rgba))
                              })
                            },
                          )
                          ci += 1
                        }
                      })
                    },
                    radius=lg::r_row,
                    pad=10.0,
                  )
                },
              )
            })
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if props.new_name_field.composing() {
            props.new_name_field.compose("")
            return true
          }
          if props.rename_field.composing() {
            props.rename_field.compose("")
            return true
          }
        }
        false
      },
      return_focus?=props.return_focus,
    )
  })
}

// ============================================================================
// 2. Recently Closed Tabs Drawer (preserves original `it.index` after filtering!)
// ============================================================================

///| Props for `build_closed_tabs_drawer_panel`.
pub struct ClosedTabsDrawerProps {
  pub open : () -> Bool
  pub items : () -> Array[proto::ClosedTabItem]
  pub now_secs : () -> Int64
  pub search_field : ui::Field
  pub on_restore_tab : (Int, String) -> Unit
  pub on_clear_all : () -> Unit
  pub on_close : () -> Unit
}

#derive(Eq)
struct ClosedTabKeyedRow {
  key : String
  orig_index : Int
  title : String
  url : String
  host : String
  space_name : String
  closed_secs : Int64
}

impl signals::Eq for ClosedTabKeyedRow {
  fn eq(self : ClosedTabKeyedRow, other : ClosedTabKeyedRow) -> Bool {
    self.key == other.key &&
    self.orig_index == other.orig_index &&
    self.title == other.title &&
    self.url == other.url &&
    self.host == other.host &&
    self.space_name == other.space_name &&
    self.closed_secs == other.closed_secs
  }
}

///| Builds the Liquid Glass Recently Closed Tabs Drawer.
///| Clicking any row (including after search filtering) ALWAYS forwards the original `it.index`!
pub fn build_closed_tabs_drawer_panel(root : view::View, props : ClosedTabsDrawerProps) -> Unit {
  let filtered_rows = fn() -> Array[ClosedTabKeyedRow] {
    let raw = proto::filter_closed_tabs((props.items)(), props.search_field.text())
    let out : Array[ClosedTabKeyedRow] = []
    let mut i = 0
    while i < raw.length() {
      let it = raw[i]
      out.push(ClosedTabKeyedRow::{
        key: it.index.to_string() + "|" + it.url + "|" + it.closed_secs.to_string(),
        orig_index: it.index,
        title: it.title,
        url: it.url,
        host: it.host,
        space_name: it.space_name,
        closed_secs: it.closed_secs,
      })
      i += 1
    }
    out
  }

  let guarded_close = fn() -> Unit {
    if props.search_field.composing() {
      props.search_field.compose("")
      return
    }
    (props.on_close)()
  }

  let _ = lg::liquid_drawer_node(
    root,
    props.open,
    guarded_close,
    fn() { "Recently Closed Tabs" },
    fn(body : view::View) -> Unit {
      let _ = body.fill().gap(view::Live::Is(12.0))

      // Search input (Enter restores first filtered item using its original `orig_index`!)
      let _ = lg::liquid_text_field_node(
        body,
        props.search_field,
        placeholder="Filter closed tabs by title, domain or Space...",
        height_by=fn() { 36.0 },
        label=fn() { "Filter Closed Tabs" },
        show_label=false,
        flat=true,
        radius=10.0,
        lead=fn(ic : view::View, ink : () -> Int64) -> Unit {
          let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink)
        },
        trail=fn(tr : view::View, _ink : () -> Int64) -> Unit {
          tr.show(fn() { props.search_field.text() != "" }, fn(cw : view::View) -> Unit {
            let _ = phase3b_icon_action_btn(
              cw,
              fn() { "Clear Closed Tabs Filter" },
              ICON_CLOSE,
              fn() { props.search_field.set("") },
            )
          })
        },
        submitted=fn(_q : String) -> Unit {
          let list = filtered_rows()
          if list.length() > 0 {
            let first = list[0]
            (props.on_close)()
            (props.on_restore_tab)(first.orig_index, first.title)
          }
        },
      )

      // Scrollable closed tabs list
      let _ = body.box(fn(list_wrap : view::View) -> Unit {
        let _ = list_wrap.fill().clips(view::Live::Is(true))
        let _ = ui::scroll_box(list_wrap, fn(sc : view::View) -> Unit {
          let _ = sc.gap(view::Live::Is(8.0)).padding(view::Live::Is((0.0, 2.0, 0.0, 8.0)))

          sc.show(fn() { filtered_rows().length() == 0 }, fn(emp_wrap : view::View) -> Unit {
            let _ = lg::surface_card_node(
              emp_wrap,
              fn(emp : view::View) -> Unit {
                let _ = emp.min_height(view::Live::Is(Some(100.0))).center().gap(view::Live::Is(4.0))
                let _ = <ui::Text
                  in={emp}
                  size={13.0}
                  weight={600}
                  color_by=>{lg::surface().ink}
                  text_by=>{
                    if props.search_field.text().trim() != "" {
                      "No matching closed tabs"
                    } else {
                      "No recently closed tabs"
                    }
                  }
                />
                let _ = <ui::Text
                  in={emp}
                  size={11.5}
                  color_by=>{lg::surface().ink_secondary}
                  text="Tabs you close appear here for one-click restoration."
                />
              },
              radius=lg::r_row,
              pad=16.0,
            )
          })

          sc.each(
            filtered_rows,
            fn(r : ClosedTabKeyedRow) -> String { r.key },
            fn(slot : view::View, row_sig : signals::Signal[ClosedTabKeyedRow]) -> Unit {
              let _ = lg::surface_card_node(
                slot,
                fn(card : view::View) -> Unit {
                  let _ = headless::button(
                    card,
                    fn() { "Restore " + row_sig.get().title },
                    fn(_v : view::View) -> Unit {
                      let r = row_sig.untracked()
                      (props.on_close)()
                      (props.on_restore_tab)(r.orig_index, r.title)
                    },
                    fn(row : view::View, btn : headless::Button) -> Unit {
                      let _ = row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Start)))
                      .min_height(view::Live::Is(Some(44.0)))
                      .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
                      .gap(view::Live::Is(10.0))
                      .radius(view::Live::Is(10.0))
                      .ground(view::Live::By(fn() {
                        if btn.pressed() || btn.hovered() { lg::surface().row_hover } else { 0x00000000L }
                      }))

                      // Vector globe tile
                      let _ = row.box(fn(ic : view::View) -> Unit {
                        let _ = ic
                        .width(view::Live::Is(Some(26.0)))
                        .height(view::Live::Is(Some(26.0)))
                        .rigid()
                        .center()
                        .radius(view::Live::Is(lg::r_chip))
                        .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                        let _ = shell_icon(ic, ICON_GLOBE, size=13.5, color_by=fn() { lg::surface().ink_secondary })
                      })

                      let _ = row.box(fn(col : view::View) -> Unit {
                        let _ = col
                        .grow(view::Live::Is(1.0))
                        .shrink(view::Live::Is(1.0))
                        .basis(view::Live::Is(Some(0.0)))
                        .min_width(view::Live::Is(Some(0.0)))
                        .gap(view::Live::Is(4.0))

                        // Line 1: Title + Relative Time
                        let _ = col.box(fn(l1 : view::View) -> Unit {
                          let _ = l1.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                          let _ = l1.box(fn(tt : view::View) -> Unit {
                            let _ = tt.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={tt}
                              size={13.0}
                              weight={500}
                              color_by=>{lg::surface().ink}
                              text_by=>{row_sig.get().title}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                          let _ = <ui::Text
                            in={l1}
                            size={11.0}
                            color_by=>{lg::surface().ink_tertiary}
                            text_by=>{proto::format_closed_relative_time(row_sig.get().closed_secs, (props.now_secs)())}
                          />
                        })

                        // Line 2: Host + Space Badge
                        let _ = col.box(fn(l2 : view::View) -> Unit {
                          let _ = l2.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                          let _ = l2.box(fn(hs : view::View) -> Unit {
                            let _ = hs.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={hs}
                              size={11.5}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{row_sig.get().host}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                          l2.show(fn() { row_sig.get().space_name.trim() != "" }, fn(sp_b : view::View) -> Unit {
                            let _ = sp_b
                            .height(view::Live::Is(Some(18.0)))
                            .rigid()
                            .center()
                            .padding(view::Live::Is((6.0, 0.0, 6.0, 0.0)))
                            .radius(view::Live::Is(5.0))
                            .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                            let _ = <ui::Text
                              in={sp_b}
                              size={10.5}
                              weight={500}
                              color_by=>{lg::surface().accent}
                              text_by=>{row_sig.get().space_name}
                            />
                          })
                        })
                      })
                    },
                  )
                },
                radius=lg::r_row,
                pad=4.0,
              )
            },
          )
        })
      })
    },
    side=lg::DrawerSide::Trailing,
    width=440.0,
    subtitle=fn() {
      let n = (props.items)().length()
      if n == 1 { "1 closed tab" } else { n.to_string() + " closed tabs" }
    },
    footer=fn(ftr : view::View) -> Unit {
      ftr.show(fn() { (props.items)().length() > 0 }, fn(fw : view::View) -> Unit {
        let _ = lg::liquid_button_node(
          fw,
          fn() { "Clear All Closed Tabs" },
          props.on_clear_all,
          content=fn(inner : view::View) -> Unit {
            let _ = <ui::Text in={inner} size={12.0} weight={600} color_by=>{0xFFFFFFFFL} text="Clear All" />
          },
          flat=true,
          height=32.0,
          tint=lg::surface().danger,
        )
      })
    },
    scrim=true,
    inset=12.0,
  )
}

// ============================================================================
// 3. Print / Export PDF Settings Modal
// ============================================================================

///| Props for `build_print_pdf_modal_panel`.
///| `owner_pane` is locked when the modal opens so `Save as PDF` routes to the exact pane
///| and integrates cleanly with `proto::PrintPdfConfig` and FIFO `reqId` export tracking.
pub struct PrintPdfModalProps {
  pub open : () -> Bool
  pub owner_pane : () -> Int
  pub page_title : () -> String
  pub page_url : () -> String
  pub paper : signals::Signal[String]
  pub orientation : signals::Signal[String]
  pub margins : signals::Signal[String]
  pub background_graphics : signals::Signal[Bool]
  pub on_save_pdf : (Int, proto::PrintPdfConfig) -> Unit
  pub on_cancel : () -> Unit
  pub return_focus : Option[view::View]
}

fn print_paper_key(raw : String) -> String {
  let s = raw.trim()
  if s == "legal" || s == "Legal" || s == "LEGAL" {
    "legal"
  } else if s == "letter" || s == "Letter" || s == "LETTER" {
    "letter"
  } else {
    "a4"
  }
}

fn print_paper_index(raw : String) -> Int {
  let k = print_paper_key(raw)
  if k == "letter" { 1 } else if k == "legal" { 2 } else { 0 }
}

fn print_orientation_key(raw : String) -> String {
  proto::normalize_print_orientation(raw)
}

fn print_orientation_index(raw : String) -> Int {
  if print_orientation_key(raw) == "landscape" { 1 } else { 0 }
}

fn print_margins_key(raw : String) -> String {
  proto::normalize_print_margins(raw)
}

fn print_margins_index(raw : String) -> Int {
  let k = print_margins_key(raw)
  if k == "narrow" {
    1
  } else if k == "wide" {
    2
  } else if k == "none" {
    3
  } else {
    0
  }
}

fn print_preview_dims_mm(paper : String, orientation : String) -> (Double, Double) {
  let p = print_paper_key(paper)
  let o = print_orientation_key(orientation)
  let (bw, bh) = if p == "legal" {
    (215.9, 355.6)
  } else if p == "letter" {
    (215.9, 279.4)
  } else {
    (210.0, 297.0)
  }
  if o == "landscape" { (bh, bw) } else { (bw, bh) }
}

fn print_preview_spec_label(paper : String, orientation : String) -> String {
  let (w, h) = print_preview_dims_mm(paper, orientation)
  let wi = (w + 0.5).floor().to_int()
  let hi = (h + 0.5).floor().to_int()
  wi.to_string() + " x " + hi.to_string() + " mm"
}

fn print_preview_margin_mm(margins : String) -> Double {
  proto::print_pdf_margin_mm(margins)
}

///| Builds the Liquid Glass Print / Export PDF Settings Modal.
pub fn build_print_pdf_modal_panel(root : view::View, props : PrintPdfModalProps) -> Unit {
  let cancel_fn = props.on_cancel

  let resolved_title = fn() -> String {
    let t = (props.page_title)().trim()
    if t != "" {
      t
    } else {
      let h = proto::omnibox_display_host((props.page_url)())
      if h != "" { h } else { "Untitled Document" }
    }
  }

  let resolved_clean_url = fn() -> String {
    let u = proto::clean_tracking_url((props.page_url)())
    let h = proto::omnibox_display_host(u)
    if h != "" { h } else if u != "" { u } else { "about:blank" }
  }

  let snapshot_config_untracked = fn() -> proto::PrintPdfConfig {
    proto::PrintPdfConfig::{
      paper: print_paper_key(props.paper.untracked()),
      orientation: print_orientation_key(props.orientation.untracked()),
      margins: print_margins_key(props.margins.untracked()),
      background_graphics: props.background_graphics.untracked(),
    }
  }

  root.show(props.open, fn(dlg_wrap : view::View) -> Unit {
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Export PDF" },
      props.open,
      cancel_fn,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center().padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))

        // Full-window pointer-blocking scrim
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x05081068L } else { 0x0F172A40L } }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { cancel_fn() })
        })

        // Outermost Liquid Glass Dialog Shell (responsive for narrow 480pt windows)
        let is_narrow = fn() -> Bool {
          let ww = root.window_w()
          ww > 0.0 && ww < 680.0
        }
        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          let _ = shell
          .width(view::Live::By(fn() {
            let ww = root.window_w()
            if ww > 0.0 && ww < 684.0 {
              let avail = ww - 24.0
              Some(if avail > 280.0 { avail } else { 280.0 })
            } else {
              Some(660.0)
            }
          }))
          .max_height(view::Live::By(fn() {
            let wh = root.window_h()
            if wh > 0.0 {
              let avail = wh - 24.0
              Some(if avail > 320.0 { avail } else { 320.0 })
            } else {
              None
            }
          }))
          .padding(view::Live::By(fn() {
            if is_narrow() { (12.0, 12.0, 12.0, 12.0) } else { (18.0, 14.0, 18.0, 14.0) }
          }))
          .gap(view::Live::By(fn() { if is_narrow() { 10.0 } else { 14.0 } }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })

          // 1. Header: Title + Spec Pill + Close
          let _ = shell.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(10.0)).rigid()
            let _ = shell_icon(hdr, ICON_DOWNLOAD, size=16.0, color_by=fn() { lg::surface().accent })
            let _ = <ui::Text in={hdr} size={15.5} weight={600} color_by=>{lg::surface().ink} text="Export PDF" />
            let _ = hdr.box(fn(sp_pill : view::View) -> Unit {
              let _ = sp_pill
              .height(view::Live::Is(Some(22.0)))
              .rigid()
              .center()
              .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
              .radius(view::Live::Is(lg::r_chip))
              .ground(view::Live::By(fn() { lg::surface().accent_tint }))
              let _ = <ui::Text
                in={sp_pill}
                size={11.0}
                weight={600}
                color_by=>{lg::surface().accent}
                text_by=>{print_preview_spec_label(props.paper.get(), props.orientation.get())}
              />
            })
            let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
            let _ = phase3b_icon_action_btn(hdr, fn() { "Close Export PDF Dialog" }, ICON_CLOSE, cancel_fn)
          })

          // 2. Main Body: Left Solid Preview Card + Right Solid Controls Column (stacks on < 680pt)
          let _ = shell.box(fn(body : view::View) -> Unit {
            let _ = body
            .row(view::Live::By(fn() { !is_narrow() }))
            .gap(view::Live::By(fn() { if is_narrow() { 10.0 } else { 14.0 } }))
            .rigid()

            // Left Solid Paper Preview Card (compact caption on narrow windows)
            let _ = lg::surface_card_node(
              body,
              fn(prev_col : view::View) -> Unit {
                let _ = prev_col
                .width(view::Live::By(fn() { if is_narrow() { None } else { Some(244.0) } }))
                .gap(view::Live::By(fn() { if is_narrow() { 4.0 } else { 10.0 } }))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .rigid()

                prev_col.show(fn() { !is_narrow() }, fn(stage : view::View) -> Unit {
                  let _ = stage.width(view::Live::Is(Some(212.0))).height(view::Live::Is(Some(236.0))).rigid().center()

                  // White paper sheet proportional to A4 / Letter / Legal x Portrait / Landscape
                  let _ = stage.box(fn(sheet : view::View) -> Unit {
                    let _ = sheet
                    .width(view::Live::By(fn() {
                      let (w, h) = print_preview_dims_mm(props.paper.get(), props.orientation.get())
                      let ratio = if h > 0.0 { w / h } else { 0.707 }
                      if ratio >= 1.0 { Some(200.0) } else { Some((220.0 * ratio).floor()) }
                    }))
                    .height(view::Live::By(fn() {
                      let (w, h) = print_preview_dims_mm(props.paper.get(), props.orientation.get())
                      let ratio = if h > 0.0 { w / h } else { 0.707 }
                      if ratio >= 1.0 { Some((200.0 / ratio).floor()) } else { Some(220.0) }
                    }))
                    .rigid()
                    .radius(view::Live::Is(6.0))
                    .clips(view::Live::Is(true))
                    .ground(view::Live::Is(0xFFFFFFFFL))
                    .edge(view::Live::By(fn() { (1.0, lg::surface().separator_strong) }))
                    .padding(view::Live::By(fn() {
                      let (w, h) = print_preview_dims_mm(props.paper.get(), props.orientation.get())
                      let m = print_preview_margin_mm(props.margins.get())
                      let ratio = if h > 0.0 { w / h } else { 0.707 }
                      let sw = if ratio >= 1.0 { 200.0 } else { 220.0 * ratio }
                      let sh = if ratio >= 1.0 { 200.0 / ratio } else { 220.0 }
                      let px = if w > 0.0 { (sw * (m / w) * 1.2).floor() } else { 8.0 }
                      let py = if h > 0.0 { (sh * (m / h) * 1.2).floor() } else { 8.0 }
                      (px, py, px, py)
                    }))

                    let _ = sheet.box(fn(inner : view::View) -> Unit {
                      let _ = inner
                      .fill()
                      .padding(view::Live::Is((7.0, 7.0, 7.0, 7.0)))
                      .gap(view::Live::Is(5.0))
                      .radius(view::Live::Is(3.0))
                      .clips(view::Live::Is(true))
                      .edge(view::Live::Is((1.0, 0xCBD5E1FFL)))

                      // Optional Background Graphics accent strip
                      inner.show(fn() { props.background_graphics.get() }, fn(bg_bar : view::View) -> Unit {
                        let _ = bg_bar
                        .height(view::Live::Is(Some(18.0)))
                        .rigid()
                        .radius(view::Live::Is(3.0))
                        .ground(view::Live::Is(0xEAF3FFFFL))
                        .edge(view::Live::Is((1.0, 0xBFD7FFFFL)))
                      })

                      let _ = <ui::Text
                        in={inner}
                        size={9.5}
                        weight={600}
                        color_by=>{0x111827FFL}
                        text_by=>{resolved_title()}
                      />.allow_ellipsis(view::Live::Is(true))
                      let _ = <ui::Text
                        in={inner}
                        size={7.5}
                        weight={500}
                        color_by=>{0x2563EBFFL}
                        text_by=>{resolved_clean_url()}
                      />.allow_ellipsis(view::Live::Is(true))

                      // Wireframe body lines
                      let _ = inner.box(fn(lines : view::View) -> Unit {
                        let _ = lines.padding(view::Live::Is((0.0, 4.0, 0.0, 0.0))).gap(view::Live::Is(4.0)).rigid()
                        let widths : Array[Double] = [1.0, 0.9, 0.82, 0.94, 0.66]
                        let mut li = 0
                        while li < widths.length() {
                          let frac = widths[li]
                          let _ = lines.box(fn(ln : view::View) -> Unit {
                            let _ = ln
                            .height(view::Live::Is(Some(4.0)))
                            .width(view::Live::Is(Some((104.0 * frac).floor())))
                            .rigid()
                            .radius(view::Live::Is(2.0))
                            .ground(view::Live::Is(0xE2E8F0FFL))
                          })
                          li += 1
                        }
                      })
                    })
                  })
                })

                // Preview caption
                let _ = prev_col.box(fn(cap : view::View) -> Unit {
                  let _ = cap.max_width(view::Live::Is(Some(220.0))).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(2.0)).cut()
                  let _ = <ui::Text
                    in={cap}
                    size={12.0}
                    weight={600}
                    color_by=>{lg::surface().ink}
                    text_by=>{resolved_title()}
                  />.allow_ellipsis(view::Live::Is(true))
                  let _ = <ui::Text
                    in={cap}
                    size={11.0}
                    color_by=>{lg::surface().ink_secondary}
                    text_by=>{resolved_clean_url()}
                  />.allow_ellipsis(view::Live::Is(true))
                })
              },
              radius=lg::r_row,
              pad=14.0,
              secondary=true,
            )

            // Right Controls Column (solid surface)
            let _ = lg::surface_card_node(
              body,
              fn(cfg_col : view::View) -> Unit {
                let _ = cfg_col
                .grow(view::Live::By(fn() { if is_narrow() { 0.0 } else { 1.0 } }))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::By(fn() { if is_narrow() { None } else { Some(0.0) } }))
                .min_width(view::Live::Is(Some(0.0)))
                .gap(view::Live::By(fn() { if is_narrow() { 10.0 } else { 14.0 } }))

                // 1. Paper Size: A4 / Letter / Legal
                let _ = cfg_col.box(fn(sec : view::View) -> Unit {
                  let _ = sec.gap(view::Live::Is(6.0)).rigid()
                  let _ = <ui::Text in={sec} size={12.0} weight={600} color_by=>{lg::surface().ink_secondary} text="Paper Size" />
                  let _ = lg::liquid_segmented_node(
                    sec,
                    fn() { ["A4", "Letter", "Legal"] },
                    fn() { print_paper_index(props.paper.get()) },
                    fn(idx : Int) -> Unit {
                      if idx == 1 {
                        props.paper.set("letter")
                      } else if idx == 2 {
                        props.paper.set("legal")
                      } else {
                        props.paper.set("a4")
                      }
                    },
                    height=36.0,
                    flat=true,
                  )
                })

                // 2. Orientation: Portrait / Landscape
                let _ = cfg_col.box(fn(sec : view::View) -> Unit {
                  let _ = sec.gap(view::Live::Is(6.0)).rigid()
                  let _ = <ui::Text in={sec} size={12.0} weight={600} color_by=>{lg::surface().ink_secondary} text="Orientation" />
                  let _ = lg::liquid_segmented_node(
                    sec,
                    fn() { ["Portrait", "Landscape"] },
                    fn() { print_orientation_index(props.orientation.get()) },
                    fn(idx : Int) -> Unit {
                      if idx == 1 {
                        props.orientation.set("landscape")
                      } else {
                        props.orientation.set("portrait")
                      }
                    },
                    height=36.0,
                    flat=true,
                  )
                })

                // 3. Margins: Default / Narrow / Wide / None
                let _ = cfg_col.box(fn(sec : view::View) -> Unit {
                  let _ = sec.gap(view::Live::Is(6.0)).rigid()
                  let _ = <ui::Text in={sec} size={12.0} weight={600} color_by=>{lg::surface().ink_secondary} text="Margins" />
                  let _ = lg::liquid_segmented_node(
                    sec,
                    fn() { ["Default", "Narrow", "Wide", "None"] },
                    fn() { print_margins_index(props.margins.get()) },
                    fn(idx : Int) -> Unit {
                      if idx == 1 {
                        props.margins.set("narrow")
                      } else if idx == 2 {
                        props.margins.set("wide")
                      } else if idx == 3 {
                        props.margins.set("none")
                      } else {
                        props.margins.set("default")
                      }
                    },
                    height=36.0,
                    flat=true,
                  )
                })

                // 4. Background Graphics Toggle
                let _ = cfg_col.box(fn(bg_row : view::View) -> Unit {
                  let _ = bg_row
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .padding(view::Live::Is((10.0, 8.0, 10.0, 8.0)))
                  .gap(view::Live::Is(10.0))
                  .radius(view::Live::Is(10.0))
                  .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                  .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))

                  let _ = bg_row.box(fn(txt : view::View) -> Unit {
                    let _ = txt.grow(view::Live::Is(1.0)).gap(view::Live::Is(2.0))
                    let _ = <ui::Text in={txt} size={12.5} weight={600} color_by=>{lg::surface().ink} text="Background graphics" />
                    let _ = <ui::Text in={txt} size={11.0} color_by=>{lg::surface().ink_secondary} text="Include CSS background colors & images" />
                  })

                  let _ = lg::liquid_toggle_node(
                    bg_row,
                    fn() { props.background_graphics.get() },
                    fn(next : Bool) -> Unit { props.background_graphics.set(next) },
                    fn() { "Background graphics" },
                  )
                })
              },
              radius=lg::r_row,
              pad=14.0,
            )
          })

          // 3. Footer: Destination info + Cancel + Save as PDF
          let _ = shell.box(fn(ftr : view::View) -> Unit {
            let _ = ftr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(10.0)).rigid()
            let _ = <ui::Text
              in={ftr}
              size={11.5}
              color_by=>{lg::surface().ink_secondary}
              text="Destination: Downloads folder"
            />
            let _ = ftr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })

            let cancel_btn = lg::liquid_button_node(
              ftr,
              fn() { "Cancel Export PDF" },
              cancel_fn,
              content=fn(inner : view::View) -> Unit {
                let _ = <ui::Text in={inner} size={13.0} weight={500} color_by=>{lg::surface().ink} text="Cancel" />
              },
              flat=true,
              height=34.0,
              pad_x=14.0,
            )
            let _ = lg::liquid_button_node(
              ftr,
              fn() { "Save as PDF" },
              fn() -> Unit {
                let pane = signals::untracked(props.owner_pane)
                let cfg = snapshot_config_untracked()
                (props.on_save_pdf)(pane, cfg)
              },
              prominent=true,
              height=34.0,
              pad_x=16.0,
            )
            let _ = cancel_btn.ask_focus()
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      return_focus?=props.return_focus,
    )
  })
}
