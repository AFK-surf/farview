///| Phase 2B independent unit test suite for `pion/packages/shell_ui`:
///| - Dynamic popover placement across 1280x800, 760x720, 480x720 (trigger, fallback capsule, sidebar drag, bookmarks bar).
///| - SiteInfo locked `(owner_pane=1, committed_origin="https://beta.test")` separated from IDNA `display_host`.
///| - IDNA Spoof Warning, Zoom, Tab Filter, Media Hub (stable `tab_id`), Downloads (search + clear), Shortcuts (wide + 480pt narrow).
///| - Bookmarks Bar, click-through Perf HUD, Tab Hover Preview, Page/Tab/Folder/BookmarksBar Context Menus,
///|   NavHistory (`owner_pane`), SpaceTheme, and MRU Switcher across Light & Dark themes.

import "lg"
import "signals"
import "ui"
import "view"

fn assert_rect_in_viewport(x : Double, y : Double, w : Double, h : Double, vw : Double, vh : Double, ctx : String) -> Unit {
  let eff_w = clamp_popover_width(w, vw)
  debug_assert(x >= POPOVER_VIEWPORT_MARGIN - 0.01, "\{ctx}: x=\{x} < 8pt margin")
  debug_assert(x + eff_w <= vw - POPOVER_VIEWPORT_MARGIN + 0.01, "\{ctx}: x+w=\{x + eff_w} > vw-8=\{vw - POPOVER_VIEWPORT_MARGIN}")
  debug_assert(y >= POPOVER_VIEWPORT_MARGIN - 0.01, "\{ctx}: y=\{y} < 8pt margin")
  debug_assert(y + h <= vh - POPOVER_VIEWPORT_MARGIN + 0.01, "\{ctx}: y+h=\{y + h} > vh-8=\{vh - POPOVER_VIEWPORT_MARGIN}")
}

test "phase2b: compute_popover_placement across 1280, 760, 480, fallback capsule, sidebar drag, bookmarks bar" {
  let capsule_1280 = AnchorRect::{ x: 360.0, y: 4.0, w: 560.0, h: 36.0 }
  let left_trig = AnchorRect::{ x: 372.0, y: 8.0, w: 28.0, h: 28.0 }
  let right_trig = AnchorRect::{ x: 1180.0, y: 8.0, w: 32.0, h: 28.0 }

  // 1280x800 left trigger aligns directly under trigger
  let (lx, ly) = compute_popover_placement(Some(left_trig), capsule_1280, 1280.0, 800.0, 356.0, 320.0)
  debug_assert((lx - 372.0).abs() < 0.01, "1280 left trigger aligns x=372")
  debug_assert((ly - 42.0).abs() < 0.01, "1280 left trigger aligns y=8+28+6=42")
  assert_rect_in_viewport(lx, ly, 356.0, 320.0, 1280.0, 800.0, "1280 left")

  // 1280x800 right trigger right-aligns and stays within 8pt margin
  let (rx, ry) = compute_popover_placement(Some(right_trig), capsule_1280, 1280.0, 800.0, 408.0, 360.0)
  debug_assert((rx - (1180.0 + 32.0 - 408.0)).abs() < 0.01, "1280 right trigger right-aligns")
  assert_rect_in_viewport(rx, ry, 408.0, 360.0, 1280.0, 800.0, "1280 right")

  // 760x720 with sidebar dragged wider (capsule shifted right) + bookmarks bar open (y shifted down)
  let capsule_760_bm = AnchorRect::{ x: 310.0, y: 36.0, w: 320.0, h: 36.0 }
  let (mx, my) = compute_popover_placement(None, capsule_760_bm, 760.0, 720.0, 356.0, 320.0)
  assert_rect_in_viewport(mx, my, 356.0, 320.0, 760.0, 720.0, "760 fallback + bookmarks")
  debug_assert(my >= 78.0 - 0.01, "bookmarks bar pushes popover below shifted capsule")

  // 480x720 narrow mode: collapsed trigger (None) falls back to capsule and clamps cleanly
  let capsule_480 = AnchorRect::{ x: 96.0, y: 4.0, w: 280.0, h: 36.0 }
  let (nx, ny) = compute_popover_placement(None, capsule_480, 480.0, 720.0, 408.0, 360.0)
  assert_rect_in_viewport(nx, ny, 408.0, 360.0, 480.0, 720.0, "480 narrow fallback")

  // Invalid zero-size trigger falls back to capsule
  let (zx, zy) = compute_popover_placement(Some(AnchorRect::empty()), capsule_480, 480.0, 720.0, 356.0, 260.0)
  assert_rect_in_viewport(zx, zy, 356.0, 260.0, 480.0, 720.0, "480 invalid trigger fallback")

  // Near bottom flips above anchor
  let bottom_trig = AnchorRect::{ x: 200.0, y: 660.0, w: 32.0, h: 28.0 }
  let (bx, by) = compute_popover_placement(Some(bottom_trig), capsule_1280, 1280.0, 720.0, 260.0, 180.0)
  debug_assert(by < 660.0, "near-bottom anchor flips popover above")
  assert_rect_in_viewport(bx, by, 260.0, 180.0, 1280.0, 720.0, "bottom flip")
}

test "phase2b: SiteInfo locks owner_pane=1 & canonical committed_origin separate from IDNA display_host (Light + Dark)" {
  let open = signals::signal(true)
  let perm_events : Array[String] = []
  let other_events : Array[String] = []

  let snap = SiteInfoSnapshot::{
    owner_pane: 1,
    committed_origin: "https://beta.test",
    display_host: "xn--bta-9la.test",
    tls_secure: true,
    tls_local: false,
    tls_summary: "Encrypted HTTPS transport active",
    idn_warning: true,
    idn_badge: "IDN Punycode",
    idn_detail: "xn--bta-9la.test",
    cookies_count: 4,
    zoom_percent: 125,
    boost_active: true,
    permissions: [
      SitePermissionEntry::{ kind: "camera", label: "Camera", state: "ask" },
      SitePermissionEntry::{ kind: "microphone", label: "Microphone", state: "block" },
    ],
  }

  let capsule = AnchorRect::{ x: 300.0, y: 4.0, w: 500.0, h: 36.0 }
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_site_info_popover(
        root,
        SiteInfoPopoverProps::{
          open: fn() { open.get() },
          snapshot: fn() { snap },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 312.0, y: 8.0, w: 28.0, h: 28.0 }) },
          fallback_capsule: fn() { capsule },
          callbacks: SiteInfoCallbacks::{
            on_close: fn() { open.set(false) },
            on_permission_change: fn(pane : Int, origin : String, kind : String, next : String) -> Unit {
              perm_events.push("\{pane}|\{origin}|\{kind}|\{next}")
            },
            on_open_cookies: fn(pane : Int, origin : String) -> Unit { other_events.push("cookies:\{pane}:\{origin}") },
            on_open_zoom: fn(pane : Int) -> Unit { other_events.push("zoom:\{pane}") },
            on_open_boosts: fn(pane : Int, origin : String) -> Unit { other_events.push("boosts:\{pane}:\{origin}") },
            on_reset_permissions: fn(pane : Int, origin : String) -> Unit { other_events.push("reset:\{pane}:\{origin}") },
            on_clear_site_data: fn(pane : Int, origin : String) -> Unit { other_events.push("clear:\{pane}:\{origin}") },
          },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  t.frame(ms=16.0)
  debug_assert(t.find("xn--bta-9la.test").is_some(), "renders IDNA display_host")
  debug_assert(t.find("https://beta.test").is_some(), "renders canonical committed_origin separately")
  lg::assert_apple_ui(t, label="site_info_light")

  t.press("Camera Allow")
  t.frame(ms=16.0)
  debug_assert(
    perm_events.length() == 1 && perm_events[0] == "1|https://beta.test|camera|allow",
    "permission callback strictly carries owner_pane=1 and committed_origin",
  )

  t.press("Inspect Site Cookies")
  t.press("Open Page Zoom")
  t.press("Edit Site Boosts")
  t.press("Reset Permissions")
  t.press("Clear Site Data")
  t.frame(ms=16.0)
  debug_assert(other_events.length() == 5, "all 5 SiteInfo quick actions dispatched")
  debug_assert(other_events[0] == "cookies:1:https://beta.test", "cookies carries owner_pane=1 + origin")
  debug_assert(other_events[1] == "zoom:1", "zoom carries owner_pane=1")
  debug_assert(other_events[2] == "boosts:1:https://beta.test", "boosts carries owner_pane=1 + origin")
  debug_assert(other_events[3] == "reset:1:https://beta.test", "reset carries owner_pane=1 + origin")
  debug_assert(other_events[4] == "clear:1:https://beta.test", "clear carries owner_pane=1 + origin")

  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  lg::assert_apple_ui(t, label="site_info_dark")
  lg::set_dark(Some(false))
  t.dispose()
}

test "phase2b: IDNA Spoof Warning, Zoom, TabFilter, and MediaHub (stable tab_id) in Light + Dark" {
  let idn_open = signals::signal(true)
  let zoom_open = signals::signal(false)
  let zoom_pct = signals::signal(100)
  let filter_open = signals::signal(true)
  let filter_field = ui::Field::new()
  let filter_queries : Array[String] = []
  let filter_cleared = ui::ref_new(false)
  let media_open = signals::signal(false)
  let media_events : Array[String] = []
  let media_rev = signals::signal(0)
  let media_entries : signals::Ref[Array[MediaHubEntry]] = ui::ref_new([])
  let capsule = AnchorRect::{ x: 260.0, y: 4.0, w: 500.0, h: 36.0 }

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_tab_filter_bar(
        root,
        TabFilterBarProps::{
          open: fn() { filter_open.get() },
          field: filter_field,
          matched_count: fn() { 2 },
          total_count: fn() { 5 },
          on_query_change: fn(q : String) -> Unit { filter_queries.push(q) },
          on_clear: fn() -> Unit { filter_cleared.v = true },
          on_close: fn() -> Unit { filter_open.set(false) },
        },
      )
      build_idna_spoof_popover(
        root,
        IdnaSpoofPopoverProps::{
          open: fn() { idn_open.get() },
          snapshot: fn() {
            IdnaSpoofSnapshot::{
              unicode_host: "example-unicode.test",
              punycode_host: "xn--example-9xa.test",
              warning_summary: "Mixed-script confusable label detected",
              warning_detail: "Displayed in Punycode to prevent lookalike spoofing.",
            }
          },
          trigger_anchor: fn() { None },
          fallback_capsule: fn() { capsule },
          on_close: fn() { idn_open.set(false) },
        },
      )
      build_zoom_popover(
        root,
        ZoomPopoverProps::{
          open: fn() { zoom_open.get() },
          host_label: fn() { "docs.example" },
          zoom_percent: fn() { zoom_pct.get() },
          can_zoom_out: fn() { zoom_pct.get() > 50 },
          can_zoom_in: fn() { zoom_pct.get() < 300 },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 960.0, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { capsule },
          on_zoom_out: fn() { zoom_pct.set(zoom_pct.untracked() - 10) },
          on_zoom_in: fn() { zoom_pct.set(zoom_pct.untracked() + 10) },
          on_reset: fn() { zoom_pct.set(100) },
          on_save_default: fn() { () },
          on_close: fn() { zoom_open.set(false) },
        },
      )
      build_media_hub_popover(
        root,
        MediaHubPopoverProps::{
          open: fn() { media_open.get() },
          entries: fn() {
            let _ = media_rev.get()
            media_entries.v
          },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 1080.0, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { capsule },
          callbacks: MediaHubCallbacks::{
            on_toggle_play: fn(tid : String) -> Unit { media_events.push("play:\{tid}") },
            on_toggle_mute: fn(tid : String) -> Unit { media_events.push("mute:\{tid}") },
            on_mute_all: fn() -> Unit { media_events.push("mute_all") },
            on_jump_tab: fn(tid : String) -> Unit { media_events.push("jump:\{tid}") },
            on_close: fn() -> Unit { media_open.set(false) },
          },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // IDNA popover visible
  t.frame(ms=16.0)
  debug_assert(t.find("xn--example-9xa.test").is_some(), "IDNA popover shows Punycode")
  lg::assert_apple_ui(t, label="idna_light")
  t.press("Close IDN Warning")
  t.frame(ms=16.0)
  debug_assert(!idn_open.untracked(), "IDNA popover closes")

  // Tab Filter Bar query + clear
  filter_field.set("docs")
  t.frame(ms=16.0)
  debug_assert(t.find("2 of 5").is_some(), "TabFilter shows match count")
  lg::assert_apple_ui(t, label="tab_filter_light")
  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  debug_assert(t.find("2 of 5").is_some(), "TabFilter keeps its field and count across a theme switch")
  lg::assert_apple_ui(t, label="tab_filter_dark")
  lg::set_dark(Some(false))
  t.frame(ms=16.0)
  t.press("Clear Tab Filter")
  t.frame(ms=16.0)
  debug_assert(filter_field.text() == "" && filter_cleared.v, "TabFilter clear resets field and invokes callback")

  // Zoom Popover +/-/Reset
  zoom_open.set(true)
  t.frame(ms=16.0)
  lg::assert_apple_ui(t, label="zoom_light")
  t.press("Zoom In")
  t.frame(ms=16.0)
  debug_assert(zoom_pct.untracked() == 110, "Zoom In increments")
  t.press("Zoom Out")
  t.frame(ms=16.0)
  debug_assert(zoom_pct.untracked() == 100, "Zoom Out decrements")
  zoom_pct.set(150)
  t.frame(ms=16.0)
  t.press("Reset")
  t.frame(ms=16.0)
  debug_assert(zoom_pct.untracked() == 100, "Zoom Reset restores 100%")
  zoom_open.set(false)

  // Media Hub empty -> active rows routed by stable tab_id
  media_open.set(true)
  t.frame(ms=16.0)
  debug_assert(t.find("Nothing is playing").is_some(), "MediaHub shows empty state")
  lg::assert_apple_ui(t, label="media_hub_empty_light")
  media_entries.v = [
    MediaHubEntry::{ tab_id: "tab-alpha", title: "Alpha Stream", source_host: "alpha.test", playing: true, muted: false, is_live_call: false },
    MediaHubEntry::{ tab_id: "tab-beta", title: "Beta Call", source_host: "meet.test", playing: false, muted: true, is_live_call: true },
  ]
  media_rev.set(1)
  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  lg::assert_apple_ui(t, label="media_hub_dark")
  t.press("Play Beta Call")
  t.press("Unmute Beta Call")
  t.press("Jump to Beta Call")
  t.frame(ms=16.0)
  debug_assert(
    media_events.length() == 3 &&
    media_events[0] == "play:tab-beta" &&
    media_events[1] == "mute:tab-beta" &&
    media_events[2] == "jump:tab-beta",
    "MediaHub routes all controls strictly by stable tab_id",
  )

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase2b: Downloads Popover and Shortcuts Modal (wide + 480pt narrow, Light + Dark)" {
  let dl_open = signals::signal(true)
  let dl_field = ui::Field::new()
  let dl_cat = signals::signal("all")
  let dl_events : Array[String] = []
  let dl_rev = signals::signal(0)
  let dl_items = ui::ref_new([
    DownloadItemView::{
      id: "dl-1",
      filename: "report-2026.pdf",
      source_host: "docs.example",
      ext_badge: "PDF",
      size_label: "2.4 MB",
      state: "completed",
      state_label: "Done",
    },
  ])
  let sc_open = signals::signal(false)
  let capsule = AnchorRect::{ x: 260.0, y: 4.0, w: 500.0, h: 36.0 }

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_downloads_popover(
        root,
        DownloadsPopoverProps::{
          open: fn() { dl_open.get() },
          search_field: dl_field,
          active_category: fn() { dl_cat.get() },
          total_count: fn() {
            let _ = dl_rev.get()
            dl_items.v.length()
          },
          items: fn() {
            let _ = dl_rev.get()
            dl_items.v
          },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 1120.0, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { capsule },
          callbacks: DownloadsCallbacks::{
            on_search_change: fn(q : String) -> Unit { dl_events.push("search:\{q}") },
            on_category_change: fn(c : String) -> Unit {
              dl_cat.set(c)
              dl_events.push("cat:\{c}")
            },
            on_copy_path: fn(id : String) -> Unit { dl_events.push("copy:\{id}") },
            on_reveal: fn(id : String) -> Unit { dl_events.push("reveal:\{id}") },
            on_clear_list: fn() -> Unit {
              dl_items.v = []
              dl_rev.set(dl_rev.untracked() + 1)
              dl_events.push("clear")
            },
            on_close: fn() -> Unit { dl_open.set(false) },
          },
        },
      )
      build_shortcuts_modal(
        root,
        ShortcutsModalProps::{
          open: fn() { sc_open.get() },
          groups: default_macos_shortcut_groups,
          on_close: fn() { sc_open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label="downloads_light")
  dl_field.set("report")
  t.frame(ms=16.0)
  t.press("Filter PDF")
  t.press("Copy Path")
  t.press("Reveal")
  t.press("Clear List")
  t.frame(ms=16.0)
  debug_assert(dl_items.v.length() == 0, "Clear List clears items via callback")
  debug_assert(t.find("No matching downloads").is_some(), "Downloads shows filtered empty state")
  dl_open.set(false)

  // Shortcuts Modal wide (1280x800) + narrow (480x720) + Dark
  sc_open.set(true)
  t.frame(ms=16.0)
  debug_assert(t.find("NAVIGATION & TABS").is_some() && t.find("TOOLS & READING").is_some(), "Shortcuts renders grouped cheatsheet")
  t.assert_scrollable(label="shortcuts_wide")
  lg::assert_no_nested_glass(t, label="shortcuts_wide", allow_large_overlay=true)

  t.resize(480.0, 720.0)
  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  t.assert_scrollable(label="shortcuts_narrow_dark")
  t.press("Close Shortcuts")
  t.frame(ms=16.0)
  debug_assert(!sc_open.untracked(), "Shortcuts modal closes cleanly")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase2b: BookmarksBar, click-through PerfHUD, TabHoverPreview, ContextMenus, NavHistory, SpaceTheme, MRU" {
  let events : Array[String] = []
  let hud_open = signals::signal(true)
  let preview_open = signals::signal(true)
  let page_ctx_open = signals::signal(false)
  let nav_hist_open = signals::signal(false)
  let tab_ctx_open = signals::signal(false)
  let folder_ctx_open = signals::signal(false)
  let bm_ctx_open = signals::signal(false)
  let space_theme_open = signals::signal(false)
  let mru_open = signals::signal(false)
  let folder_field = ui::Field::new()
  let space_field = ui::Field::new()
  let capsule = AnchorRect::{ x: 260.0, y: 4.0, w: 500.0, h: 36.0 }

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))

      build_bookmarks_bar_strip(
        root,
        BookmarksBarProps::{
          open: fn() { true },
          items: fn() {
            [BookmarkChipItem::{ id: "bm-1", title: "Example Docs", url: "https://docs.example" }]
          },
          page_saved: fn() { false },
          on_navigate: fn(u : String) -> Unit { events.push("bm_nav:\{u}") },
          on_context_menu: fn(id : String, u : String, _x : Double, _y : Double) -> Unit {
            events.push("bm_ctx:\{id}:\{u}")
          },
          on_toggle_bookmark: fn() -> Unit { events.push("bm_toggle") },
        },
      )

      build_perf_hud_overlay(
        root,
        PerfHudProps::{
          open: fn() { hud_open.get() },
          metrics: fn() {
            PerfHudMetrics::{
              host_label: "docs.example",
              scheme: "https",
              tls_secure: true,
              dom_nodes: 420,
              stylesheets: 4,
              images: 12,
              doc_width: 1280,
              doc_height: 2400,
              zoom_percent: 100,
              cookies_count: 3,
              space_name: "Work",
              space_accent: 0x2563EBFFL,
            }
          },
          top_offset: fn() { SHELL_TITLEBAND_H + 44.0 },
          on_refresh: fn() { events.push("hud_refresh") },
          on_close: fn() { hud_open.set(false) },
        },
      )

      build_tab_hover_preview_card(
        root,
        TabHoverPreviewProps::{
          open: fn() { preview_open.get() },
          snapshot: fn() {
            Some(TabHoverPreviewSnapshot::{
              tab_id: "t-9",
              title: "Audio Workspace",
              clean_host: "radio.example",
              space_name: "Work",
              playing: true,
              muted: false,
              in_split: true,
              in_reader: false,
            })
          },
          anchor_x: fn() { 260.0 },
          anchor_y: fn() { 180.0 },
        },
      )

      build_page_context_menu(
        root,
        PageContextMenuProps::{
          open: fn() { page_ctx_open.get() },
          target: fn() {
            PageContextTarget::{
              link_url: "https://link.example",
              image_url: "https://img.example/a.png",
              selection_text: "hello",
              can_back: true,
              can_forward: false,
            }
          },
          anchor_x: fn() { 400.0 },
          anchor_y: fn() { 240.0 },
          callbacks: PageContextCallbacks::{
            on_open_peek: fn(u) { events.push("peek:\{u}") },
            on_open_split: fn(u) { events.push("split:\{u}") },
            on_open_new_tab: fn(u) { events.push("newtab:\{u}") },
            on_copy_link: fn(u) { events.push("copylink:\{u}") },
            on_open_image: fn(u) { events.push("openimg:\{u}") },
            on_copy_image_url: fn(u) { events.push("copyimg:\{u}") },
            on_copy_selection: fn(s) { events.push("copysel:\{s}") },
            on_search_selection: fn(s) { events.push("searchsel:\{s}") },
            on_back: fn() { events.push("back") },
            on_forward: fn() { events.push("forward") },
            on_reload: fn() { events.push("reload") },
            on_copy_page_url: fn() { events.push("copypage") },
            on_close: fn() { page_ctx_open.set(false) },
          },
        },
      )

      build_nav_history_popover(
        root,
        NavHistoryPopoverProps::{
          open: fn() { nav_hist_open.get() },
          owner_pane: fn() { 1 },
          is_forward: fn() { false },
          entries: fn() {
            [NavHistoryItem::{ index: 3, title: "Previous Docs", url: "https://prev.example" }]
          },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 80.0, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { capsule },
          on_jump: fn(pane : Int, idx : Int) -> Unit { events.push("nav_jump:\{pane}:\{idx}") },
          on_close: fn() { nav_hist_open.set(false) },
        },
      )

      build_tab_context_menu(
        root,
        TabContextMenuProps::{
          open: fn() { tab_ctx_open.get() },
          target: fn() {
            TabContextTarget::{
              tab_id: "tab-42",
              is_active: true,
              pinned: false,
              favorite: false,
              muted: false,
              folder_id: "",
              can_close_others: true,
              folders: [("fld-7", "Reading")],
              spaces: [("sp-2", "Research")],
            }
          },
          anchor_x: fn() { 260.0 },
          anchor_y: fn() { 160.0 },
          callbacks: TabContextCallbacks::{
            on_open_split: fn(tid) { events.push("tsplit:\{tid}") },
            on_open_peek: fn(tid) { events.push("tpeek:\{tid}") },
            on_duplicate: fn(tid) { events.push("dup:\{tid}") },
            on_copy_clean_url: fn(tid) { events.push("tcopy:\{tid}") },
            on_toggle_pin: fn(tid) { events.push("pin:\{tid}") },
            on_toggle_favorite: fn(tid) { events.push("tfav:\{tid}") },
            on_toggle_mute: fn(tid) { events.push("tmute:\{tid}") },
            on_move_to_folder: fn(tid, fid) { events.push("tfolder:\{tid}:\{fid}") },
            on_move_to_space: fn(tid, sid) { events.push("move:\{tid}:\{sid}") },
            on_close_others: fn(tid) { events.push("tothers:\{tid}") },
            on_close_tab: fn(tid) { events.push("tclose:\{tid}") },
            on_close: fn() { tab_ctx_open.set(false) },
          },
        },
      )

      build_folder_context_menu(
        root,
        FolderContextMenuProps::{
          open: fn() { folder_ctx_open.get() },
          target: fn() { FolderContextTarget::{ folder_id: "fld-7", name: "Reading", color: "#2563EB", collapsed: false } },
          palette: ["#2563EB", "#10B981"],
          rename_field: folder_field,
          anchor_x: fn() { 260.0 },
          anchor_y: fn() { 180.0 },
          callbacks: FolderContextCallbacks::{
            on_rename: fn(fid, nm) { events.push("frename:\{fid}:\{nm}") },
            on_pick_color: fn(fid, hex) { events.push("fcolor:\{fid}:\{hex}") },
            on_toggle_collapse: fn(fid) { events.push("ftoggle:\{fid}") },
            on_delete: fn(fid) { events.push("fdel:\{fid}") },
            on_close: fn() { folder_ctx_open.set(false) },
          },
        },
      )

      build_bookmarks_bar_context_menu(
        root,
        BookmarksBarContextProps::{
          open: fn() { bm_ctx_open.get() },
          bookmark_id: fn() { "bm-1" },
          bookmark_url: fn() { "https://docs.example" },
          anchor_x: fn() { 120.0 },
          anchor_y: fn() { 80.0 },
          on_open_split: fn(u) { events.push("bmsplit:\{u}") },
          on_open_peek: fn(u) { events.push("bmpeek:\{u}") },
          on_remove: fn(id) { events.push("bmrm:\{id}") },
          on_close: fn() { bm_ctx_open.set(false) },
        },
      )

      build_space_theme_popover(
        root,
        SpaceThemeProps::{
          open: fn() { space_theme_open.get() },
          space_id: fn() { "sp-1" },
          active_accent: fn() { "#2563EB" },
          palette: ["#2563EB", "#10B981"],
          name_field: space_field,
          trigger_anchor: fn() { None },
          fallback_capsule: fn() { capsule },
          on_rename: fn(sid, nm) { events.push("srename:\{sid}:\{nm}") },
          on_pick_accent: fn(sid, hex) { events.push("saccent:\{sid}:\{hex}") },
          on_close: fn() { space_theme_open.set(false) },
        },
      )

      build_mru_switcher_modal(
        root,
        MruSwitcherModalProps::{
          open: fn() { mru_open.get() },
          space_name: fn() { "Work" },
          items: fn() {
            [
              MruTabEntry::{ tab_id: "t-1", title: "Home", host: "home.example", playing: false, active: true },
              MruTabEntry::{ tab_id: "t-2", title: "Music", host: "music.example", playing: true, active: false },
            ]
          },
          selected_index: fn() { 1 },
          on_select_tab: fn(tid) { events.push("mru:\{tid}") },
          on_close: fn() { mru_open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Bookmarks bar + real-metrics Perf HUD + Tab Hover Preview
  t.frame(ms=16.0)
  t.press("Open bookmark Example Docs")
  t.press("Bookmark Page")
  t.press("Refresh Perf HUD")
  t.frame(ms=16.0)
  debug_assert(events.length() == 3, "bookmarks & Perf HUD fired 3 events")
  debug_assert(events[0] == "bm_nav:https://docs.example", "bookmark click navigates")
  debug_assert(events[1] == "bm_toggle", "bookmark toggle fires")
  debug_assert(events[2] == "hud_refresh", "Perf HUD refresh callback fires")
  debug_assert(t.find("DOM Nodes").is_some() && t.find("1280x2400").is_some(), "Perf HUD shows real host metrics")
  debug_assert(t.find("Audio Workspace").is_some(), "Tab hover preview renders")
  t.press("Close Perf HUD")
  t.frame(ms=16.0)
  debug_assert(!hud_open.untracked(), "Perf HUD close button closes HUD")
  preview_open.set(false)

  // PageContextMenu
  page_ctx_open.set(true)
  t.frame(ms=16.0)
  t.press("Open in Peek")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "peek:https://link.example", "PageCtx Open in Peek routes link")
  page_ctx_open.set(false)

  // NavHistoryPopover
  nav_hist_open.set(true)
  t.frame(ms=16.0)
  t.press("Previous Docs")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "nav_jump:1:3", "NavHistory routes owner_pane=1 and index=3")
  nav_hist_open.set(false)

  // TabContextMenu
  tab_ctx_open.set(true)
  t.frame(ms=16.0)
  t.press("Move to Research")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "move:tab-42:sp-2", "TabCtx routes stable tab_id and space_id")
  tab_ctx_open.set(false)

  // FolderContextMenu
  folder_ctx_open.set(true)
  folder_field.set("Archive")
  t.frame(ms=16.0)
  t.press("Save Folder Name")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "frename:fld-7:Archive", "FolderCtx routes stable folder_id")
  folder_ctx_open.set(false)

  // BookmarksBarContextMenu
  bm_ctx_open.set(true)
  t.frame(ms=16.0)
  t.press("Remove Bookmark")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "bmrm:bm-1", "BookmarksBarCtx routes bookmark_id")
  bm_ctx_open.set(false)

  // SpaceThemePopover + Dark theme check
  lg::set_dark(Some(true))
  space_theme_open.set(true)
  t.frame(ms=16.0)
  t.press("Space color #10B981")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "saccent:sp-1:#10B981", "SpaceTheme routes space_id + accent")
  space_theme_open.set(false)

  // MruSwitcherModal
  mru_open.set(true)
  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label="mru_dark", allow_large_overlay=true)
  t.press("Switch to Music")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "mru:t-2", "MRU routes stable tab_id")

  lg::set_dark(Some(false))
  t.dispose()
}
