  debug_assert(!hud_open.untracked(), "Perf HUD close button closes HUD")
  preview_open.set(false)

  // PageContextMenu
  page_ctx_open.set(true)
  t.frame(ms=16.0)
  t.press("Open Link in Peek")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "peek:https://link.example", "PageCtx Open in Peek routes link")
  debug_assert(!page_ctx_open.untracked(), "PageCtx closes on select")
  page_ctx_open.set(true)
  t.frame(ms=16.0)
  lg::assert_apple_ui(t, label="page_ctx_light")
  let n_before_fwd = events.length()
  t.press("Forward")
  t.frame(ms=16.0)
  debug_assert(events.length() == n_before_fwd, "PageCtx Forward is disabled when can_forward=false")
  page_ctx_open.set(false)

  // NavHistoryPopover
  nav_hist_open.set(true)
  t.frame(ms=16.0)
  t.press("Previous Docs")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "nav_jump:1:3", "NavHistory routes owner_pane=1 and index=3")
  debug_assert(!nav_hist_open.untracked(), "NavHistory closes on jump")
  nav_hist_open.set(false)

  // TabContextMenu
  tab_ctx_open.set(true)
  t.frame(ms=16.0)
  t.press("Move to Research Space")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "move:tab-42:sp-2", "TabCtx routes stable tab_id and space_id")
  tab_ctx_open.set(false)

  // FolderContextMenu
  folder_ctx_open.set(true)
  folder_field.set("Archive")
  t.frame(ms=16.0)
  t.press("Save Folder Name")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "frename:fld-7:Archive", "FolderCtx routes stable folder_id")
  p2b_settle(t)
  lg::assert_apple_ui(t, label="folder_ctx_light")
  t.press("Collapse Folder")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "ftoggle:fld-7", "FolderCtx Collapsed toggle routes folder_id")
  t.press("Folder Color #10B981")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "fcolor:fld-7:#10B981", "FolderCtx color swatch routes folder_id + hex")
  t.press("Delete Folder")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "fdel:fld-7", "FolderCtx Delete routes folder_id")
  folder_ctx_open.set(false)

  // BookmarksBarContextMenu
  bm_ctx_open.set(true)
  t.frame(ms=16.0)
  t.press("Remove Bookmark")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "bmrm:bm-1", "BookmarksBarCtx routes bookmark_id")
  bm_ctx_open.set(false)

  // SpaceThemePopover + Dark theme check
  lg::set_dark(Some(true))
  space_theme_open.set(true)
  t.frame(ms=16.0)
  t.press("Space color #10B981")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "saccent:sp-1:#10B981", "SpaceTheme routes space_id + accent")
  p2b_settle(t)
  lg::assert_apple_ui(t, label="space_theme_dark")
  space_theme_open.set(false)

  // MruSwitcherModal
  mru_open.set(true)
  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label="mru_dark", allow_large_overlay=true)
  lg::assert_apple_ui(t, label="mru_dark", allow_large_overlay=true)
  // Arc's strip: the cells alone, no header, no keyboard hints.
  debug_assert(t.get("Quick Tab Switch").is_some(), "MRU dialog keeps its a11y label")
  debug_assert(t.find("Recent tabs").is_none() && t.find("Current tab").is_none(), "MRU has no header or current-tab caption")
  debug_assert(t.find("Home").is_some() && t.find("Music").is_some(), "MRU shows each tab's title")
  t.press("Switch to Music")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "mru:t-2", "MRU routes stable tab_id")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase2b: menu height counts separators thin, menus open at the pointer when they fit, bookmarks overflow" {
  // Entries are cleaned as added: no leading, doubled or trailing separator.
  let m = MsoMenu::new()
  m.sep()
  m.add(lg::LiquidMenuEntry::item(label="One", on_select=fn() { () }))
  m.sep()
  m.sep()
  m.add(lg::LiquidMenuEntry::item(label="Two", on_select=fn() { () }))
  m.sep()
  let done = m.done()
  debug_assert(done.entries.length() == 3, "menu keeps item, one separator, item")
  // 6 + 32 + 2 + 9 + 2 + 32 + 6 = 89 (a separator is not a full row).
  let h = done.height()
  debug_assert(h > 88.0 && h < 90.0, "menu height counts the separator as SP_8 + hairline, got \{h}")
  // Fits below: at the pointer. Fits neither way: shifted up just enough, never to the window top.
  debug_assert(mso_menu_y(340.0, 440.0, 800.0) == 340.0, "menu opens at the pointer when it fits")
  debug_assert(mso_menu_y(600.0, 300.0, 800.0) == 300.0, "menu flips above when only that fits")
  debug_assert(mso_menu_y(340.0, 460.0, 800.0) == 332.0, "menu shifts up just enough when neither fits")
  // Before the strip is measured every bookmark is shown; a narrow strip shows only whole chips.
  let items = [
    BookmarkChipItem::{ id: "a", title: "GitHub", url: "https://github.com" },
    BookmarkChipItem::{ id: "b", title: "MDN Web Docs", url: "https://developer.mozilla.org" },
    BookmarkChipItem::{ id: "c", title: "Wikipedia", url: "https://en.wikipedia.org" },
  ]
  debug_assert(mso_chips_fit(items, 0.0) == 3, "unmeasured strip shows every chip")
  let one = mso_chip_width(items[0])
  debug_assert(mso_chips_fit(items, one + 40.0) <= 1, "narrow strip keeps only whole chips and room for overflow")
}

test "phase2b: MRU strip fits one row and pages to keep the selection in view" {
  // One row: 5 cells at 1280, fewer in a narrow window, never more than the tabs.
  debug_assert(mru_visible_count(1280.0, 12) == 5, "five cells at 1280")
  debug_assert(mru_visible_count(1280.0, 3) == 3, "no empty cells")
  debug_assert(mru_visible_count(1280.0, 0) == 1, "at least one cell")
  let narrow = mru_visible_count(480.0, 12)
  debug_assert(narrow >= 1 && narrow < 5, "fewer cells at 480")
  debug_assert(mru_panel_w(narrow) <= 480.0 - SP_32, "the 480 strip keeps its margins")
  // Scrolling: the strip moves only when the selection leaves it, by one cell, so the highlight keeps moving the
  // way the key points (12 tabs, 5 shown).
  debug_assert(mru_first_visible(0, 1, 12, 5) == 0, "selection in view: no scroll")
  debug_assert(mru_first_visible(0, 4, 12, 5) == 0, "last cell of the strip: no scroll")
  debug_assert(mru_first_visible(0, 5, 12, 5) == 1, "Tab past the right edge scrolls by one")
  debug_assert(mru_first_visible(5, 9, 12, 5) == 5, "9 is the last cell of 5-9: no scroll")
  debug_assert(mru_first_visible(5, 10, 12, 5) == 6, "9 -> 10 scrolls by one, the highlight stays at the right edge")
  debug_assert(mru_first_visible(6, 8, 12, 5) == 6, "Shift+Tab inside the strip: no scroll")
  debug_assert(mru_first_visible(6, 5, 12, 5) == 5, "Shift+Tab past the left edge scrolls by one")
  debug_assert(mru_first_visible(7, 0, 12, 5) == 0, "wrap to the first tab resets the strip")
  debug_assert(mru_first_visible(0, 11, 12, 5) == 7, "Shift+Tab wrap to the last tab ends the strip on it")
  debug_assert(mru_first_visible(9, 10, 12, 5) == 7, "never half empty")
  debug_assert(mru_first_visible(0, 3, 4, 5) == 0, "all fit: no scroll")
  // Walking Tab through all 12: each step moves the highlight right by one cell or keeps it at the right edge.
  let mut first = 0
  let mut prev_cell = 0
  let mut sel = 1
  while sel < 12 {
    first = mru_first_visible(first, sel, 12, 5)
    let cell = sel - first
    debug_assert(cell >= 0 && cell < 5 && (cell == prev_cell + 1 || cell == 4), "highlight never moves against Tab")
    prev_cell = cell
    sel += 1
  }
  // Centered over the page (right of the sidebar) when it fits there, else on the window.
  let pw = mru_panel_w(5)
  debug_assert(mru_panel_left(1280.0, 240.0, pw) == 240.0 + (1040.0 - pw) / 2.0, "centered over the page")
  debug_assert(mru_panel_left(1280.0, 0.0, pw) == (1280.0 - pw) / 2.0, "no sidebar: centered on the window")
  let pw2 = mru_panel_w(2)
  debug_assert(mru_panel_left(480.0, 0.0, pw2) == (480.0 - pw2) / 2.0, "480: centered on the window")
  debug_assert(mru_panel_left(900.0, 400.0, pw) == (900.0 - pw) / 2.0, "too wide for the page: centered on the window")
}

test "phase2b: MRU strip scrolls to keep the selection in view, with one highlight" {
  let sel = signals::signal(1)
  let items : Array[MruTabEntry] = []
  let mut i = 0
  while i < 9 {
    items.push(MruTabEntry::{ tab_id: "t-\{i}", title: "Tab \{i}", host: "h\{i}.example", playing: false, active: i == 0 })
    i += 1
  }
  let picked : Array[String] = []
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_mru_switcher_modal(
        root,
        MruSwitcherModalProps::{
          open: fn() { true },
          space_name: fn() { "Work" },
          items: fn() { items },
          selected_index: fn() { sel.get() },
          on_select_tab: fn(tid) { picked.push(tid) },
          on_close: fn() { () },
          content_left: fn(_vw) { 240.0 },
        },
      )
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)
  lg::assert_apple_ui(t, label="mru_paged", allow_large_overlay=true)
  debug_assert(t.find("Next").is_none() && t.find("Work").is_none(), "no keyboard hints, no Space header")
  debug_assert(t.get("Switch to Tab 0").is_some() && t.get("Switch to Tab 4").is_some(), "first page shows tabs 0-4")
  debug_assert(t.get("Switch to Tab 5").is_none(), "tab 5 is past the right edge")
  sel.set(5)
  t.frame(ms=16.0)
  debug_assert(t.get("Switch to Tab 1").is_some() && t.get("Switch to Tab 5").is_some(), "Tab past the edge scrolls by one")
  debug_assert(t.get("Switch to Tab 0").is_none(), "tab 0 scrolled out")
  sel.set(8)
  t.frame(ms=16.0)
  debug_assert(t.get("Switch to Tab 8").is_some() && t.get("Switch to Tab 4").is_some(), "the strip ends on the last tab")
  debug_assert(t.get("Switch to Tab 3").is_none(), "earlier tabs scroll out")
  sel.set(0)
  t.frame(ms=16.0)
  debug_assert(t.get("Switch to Tab 0").is_some() && t.get("Switch to Tab 5").is_none(), "wrap to the first tab resets the strip")
  sel.set(8)
  t.frame(ms=16.0)
  t.press("Switch to Tab 6")
  t.frame(ms=16.0)
  debug_assert(picked.length() == 1 && picked[0] == "t-6", "a click routes the stable tab_id")
  t.dispose()
}
