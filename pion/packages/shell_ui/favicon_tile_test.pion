///| Site icon tiles (`favicon_tile.pion`): the icon when the shell has one, the letter tile otherwise, swapped in
///| place when the icon comes. Icons are synthetic (`favicon_demo.pion`).

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn fv_settle(t : ui::Tester) -> Unit {
  let mut i = 0
  while i < 12 {
    t.frame(ms=16.0)
    i += 1
  }
}

fn fv_drawn_icons(t : ui::Tester) -> Array[view::Drawn] {
  let out : Array[view::Drawn] = []
  for d in t.drawn() {
    match d.image {
      Some((k, _, _)) => if k.starts_with("fvicon:") && d.alpha > 0.05 { out.push(d) }
      None => ()
    }
  }
  out
}

fn fv_find_ground(t : ui::Tester, ground : Int64, edge : Double) -> Option[view::Drawn] {
  for d in t.drawn() {
    if d.ground == ground && d.w == edge && d.h == edge {
      return Some(d)
    }
  }
  None
}

fn fv_has_words(t : ui::Tester, s : String) -> Bool {
  for d in t.drawn() {
    if d.words == s && d.alpha > 0.05 {
      return true
    }
  }
  false
}

test "favicon tile: letter tile first, the icon swaps in on a plate with no layout shift" {
  shell_site_icons_clear()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.row(view::Live::Is(true)).gap(view::Live::Is(SP_8)).padding(view::Live::Is((SP_16, SP_16, SP_16, SP_16)))
      let _ = shell_site_tile(root, fn() { "github.com" }, size=SP_24)
      let _ = shell_site_tile(root, fn() { "wpt.fyi" }, size=SP_24)
      let _ = shell_site_tile(root, fn() { "www.github.com" }, size=SP_16)
    },
    width=400.0,
    height=200.0,
    theme=lg::ui_theme,
  )
  fv_settle(t)
  debug_assert(fv_drawn_icons(t).length() == 0, "no icon before the host sends one")
  debug_assert(fv_has_words(t, "G") && fv_has_words(t, "W"), "letter tiles")
  let before = match fv_find_ground(t, shell_site_letter_ground("github.com"), SP_24) {
    Some(d) => d
    None => {
      debug_assert(false, "github.com letter tile")
      return
    }
  }
  let other_before = fv_find_ground(t, shell_site_letter_ground("wpt.fyi"), SP_24)
  debug_assert(other_before.is_some(), "wpt.fyi letter tile")
  // The icon comes (as the app hands it over from the wire), keyed by a URL of the site.
  let png = shell_favicon_demo_png(DemoIconShape::Ring, 0x24292FFFL)
  shell_site_icon_put("https://www.GitHub.com/AFK-surf", "", png)
  t.frame(ms=16.0)
  let icons = fv_drawn_icons(t)
  debug_assert(icons.length() == 2, "both github.com tiles show the icon: " + icons.length().to_string())
  let after = match fv_find_ground(t, shell_favicon_plate(false), SP_24) {
    Some(d) => d
    None => {
      debug_assert(false, "the 24pt tile is on its plate")
      return
    }
  }
  debug_assert(after.x == before.x && after.y == before.y && after.radius == before.radius, "same place, same corner")
  // The icon sits in the middle at the tile's glyph size: 16 in a 24pt tile, 12 in a 16pt one.
  let mut saw16 = false
  let mut saw12 = false
  for d in icons {
    if d.w == IC_MD && d.x == before.x + SP_4 && d.y == before.y + SP_4 {
      saw16 = true
    }
    if d.w == IC_SM {
      saw12 = true
    }
  }
  debug_assert(saw16 && saw12, "icon edges and centering")
  debug_assert(!fv_has_words(t, "G"), "the letter is gone where the icon is")
  match (other_before, fv_find_ground(t, shell_site_letter_ground("wpt.fyi"), SP_24)) {
    (Some(a), Some(b)) => debug_assert(a.x == b.x && a.y == b.y, "the other tile did not move")
    _ => debug_assert(false, "wpt.fyi keeps its letter tile")
  }
  debug_assert(fv_has_words(t, "W"), "a site with no icon keeps its letter")
  // Sending the same icon again changes nothing; an empty one forgets it (letter tile back, same place).
  shell_site_icon_put("github.com", "", png)
  t.frame(ms=16.0)
  debug_assert(fv_drawn_icons(t).length() == 2, "same icon again")
  shell_site_icon_put("github.com", "", Bytes::new(0))
  t.frame(ms=16.0)
  debug_assert(fv_drawn_icons(t).length() == 0, "forgotten")
  match fv_find_ground(t, shell_site_letter_ground("github.com"), SP_24) {
    Some(d) => debug_assert(d.x == before.x && d.y == before.y, "letter tile back in place")
    None => debug_assert(false, "letter tile back")
  }
  t.dispose()
  shell_site_icons_clear()
}

test "favicon tile: dark plate, custom letter and ground (favorites), the swap is not animated" {
  shell_site_icons_clear()
  lg::set_dark(Some(true))
  let show = signals::signal(false)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = shell_favicon_tile(
        root,
        fn() { "https://linear.app/team" },
        size=SP_20,
        letter_by=fn() { "L" },
        ground_by=fn() { 0x4338CAFFL },
        letter_size=TX_CAPTION,
      )
      root.show(fn() { show.get() }, fn(v : view::View) -> Unit { let _ = shell_site_tile(v, fn() { "soma.fm" }, size=SP_32) })
    },
    width=200.0,
    height=200.0,
    theme=lg::ui_theme,
    dark=true,
  )
  fv_settle(t)
  debug_assert(fv_find_ground(t, 0x4338CAFFL, SP_20).is_some(), "the favorite's own color")
  debug_assert(fv_has_words(t, "L"), "the favorite's monogram")
  shell_favicon_demo_install()
  t.frame(ms=16.0)
  // At once on the very next frame: fully drawn, no fade.
  let icons = fv_drawn_icons(t)
  debug_assert(icons.length() == 1 && icons[0].alpha >= 0.999 && icons[0].w == IC_SM, "linear.app icon at once")
  debug_assert(fv_find_ground(t, shell_favicon_plate(true), SP_20).is_some(), "dark plate")
  // A tile mounted after the icon came draws it from its first paint.
  show.set(true)
  t.frame(ms=16.0)
  let mut big = false
  for d in fv_drawn_icons(t) {
    if d.w == IC_MD {
      big = true
    }
  }
  debug_assert(big, "a new 32pt tile starts with the icon (16pt)")
  t.dispose()
  lg::set_dark(Some(false))
  shell_site_icons_clear()
}

test "favicon tile: the sidebar, favorites and audits with synthetic icons, light and dark" {
  for dark in [false, true] {
    shell_site_icons_clear()
    lg::set_dark(Some(dark))
    let ctrl = make_demo_controller(dark=dark)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
          build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) })
        })
        build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
      dark=dark,
    )
    fv_settle(t)
    let letters_before = fv_drawn_icons(t).length()
    debug_assert(letters_before == 0, "no icons yet")
    shell_favicon_demo_install()
    t.frame(ms=16.0)
    let mut in_sidebar = 0
    for d in fv_drawn_icons(t) {
      if d.x < SHELL_SIDEBAR_W_WIDE {
        in_sidebar += 1
      }
    }
    debug_assert(in_sidebar >= 3, "sidebar tabs and favorites show icons: " + in_sidebar.to_string())
    lg::assert_apple_ui(t, label="favicon_sidebar_" + (if dark { "dark" } else { "light" }))
    t.dispose()
  }
  lg::set_dark(Some(false))
  shell_site_icons_clear()
}

fn fv_url_item(url : String) -> proto::CommandBarItem {
  proto::CommandBarItem::{
    kind: proto::CommandKind::NavigateUrl,
    id: url,
    title: "Open " + url,
    subtitle: proto::omnibox_display_host(url),
    badge: "URL",
    shortcut: "",
    monogram: "→",
    accent: 0L,
    is_tab: false,
    is_space: false,
  }
}

test "favicon tile: a command bar URL row to a site with an icon shows it, in the glyph tile's box" {
  shell_site_icons_clear()
  let ctrl = make_demo_controller()
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::CommandBar, tag="command_bar"))
  let items = [fv_url_item("https://figma.com/files")]
  // The only row is selected: its monochrome glyph sits on a white wash over the Space color.
  let glyph_ground = 0xFFFFFF33L
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_command_bar_overlay(root, ctrl.model(), CommandBarProps::{
        field: ui::Field::new(),
        items: fn() { items },
        selected: fn() { 0 },
        on_query_change: fn(_q) { () },
        on_step: fn(_d) { true },
        on_submit: fn(_t) { () },
        on_execute: fn(_it) { () },
        on_close: fn() { () },
        on_row_view: None,
        on_clear_rows: None,
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=600.0)
  debug_assert(fv_drawn_icons(t).length() == 0, "no icon yet")
  let before = match fv_find_ground(t, glyph_ground, SP_24) {
    Some(d) => d
    None => {
      debug_assert(false, "the URL row's glyph tile")
      return
    }
  }
  shell_favicon_demo_install()
  t.frame(ms=16.0)
  let icons = fv_drawn_icons(t)
  debug_assert(icons.length() == 1 && icons[0].w == IC_MD, "the site's icon on the URL row: " + icons.length().to_string())
  match fv_find_ground(t, shell_favicon_plate(false), SP_24) {
    Some(d) => debug_assert(d.x == before.x && d.y == before.y, "same box as the glyph tile")
    None => debug_assert(false, "on its plate")
  }
  debug_assert(fv_find_ground(t, glyph_ground, SP_24) is None, "the glyph tile is gone")
  t.dispose()
  shell_site_icons_clear()
}

test "favicon tile: a miss for a site whose icon is here keeps the icon; an explicit forget lets it go" {
  shell_site_icons_clear()
  shell_favicon_demo_install()
  debug_assert(shell_site_icon("github.com").is_some(), "the icon is here")
  shell_site_icon_put("github.com", SHELL_SITE_ICON_MISS, Bytes::new(0))
  debug_assert(shell_site_icon("github.com").is_some(), "a failed re-check (a miss) keeps it")
  shell_site_icon_put("github.com", "0123456789abcdef", Bytes::new(0))
  debug_assert(shell_site_icon("github.com").is_none(), "an explicit forget lets it go")
  shell_site_icon_put("github.com", SHELL_SITE_ICON_MISS, Bytes::new(0))
  debug_assert(shell_site_icon_known("github.com"), "a miss for a site with none: known (its letter tile)")
  shell_site_icons_clear()
}

test "favicon tile: palette and history rows wait for a cached icon while the host's icons come in, then at once" {
  shell_site_icons_clear()
  shell_site_icons_answered(true)
  let later = signals::signal(false)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.row(view::Live::Is(true)).gap(view::Live::Is(SP_8)).padding(view::Live::Is((SP_16, SP_16, SP_16, SP_16)))
      let _ = shell_site_tile(root, fn() { "github.com" }, size=SP_24, awaits_cached=true)
      root.show(fn() { later.get() }, fn(v : view::View) -> Unit {
        let _ = shell_site_tile(v, fn() { "never-seen.example" }, size=SP_24, awaits_cached=true)
      })
    },
    width=400.0,
    height=200.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  debug_assert(fv_find_ground(t, shell_site_letter_ground("github.com"), SP_24).is_none(), "no saturated letter tile while its icon may come")
  debug_assert(fv_find_ground(t, lg::alpha(shell_favicon_plate(false), 0.5), SP_24).is_some(), "a quiet plate meanwhile")
  // (the host's batch of the icons it knows: github.com's comes)
  shell_favicon_demo_install()
  t.frame(ms=16.0)
  debug_assert(fv_drawn_icons(t).length() == 1, "the cached icon, straight from the quiet plate")
  // (past the batch: a row for a site the host never had draws its letter tile at once, no wait)
  t.frame(ms=2000.0)
  later.set(true)
  t.frame(ms=16.0)
  debug_assert(fv_find_ground(t, shell_site_letter_ground("never-seen.example"), SP_24).is_some(), "later: its letter tile at once")
  t.dispose()
  shell_site_icons_answered(false)
  shell_site_icons_clear()
}
