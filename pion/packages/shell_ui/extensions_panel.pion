///| Extensions: the manager (Settings > Extensions), the toolbar's pinned extension buttons with their badges, and
///| the popover a press on one opens.
///|
///| - Manager (`sp_build_extensions`): Load unpacked / Install `.crx` rows, then one card per installed extension:
///|   its monogram tile, name, version, description, permission chips (host access first), the 38x22pt
///|   `shell_desktop_toggle` that enables it, and Pin / Options / Remove. A failed load shows why, in red.
///| - Toolbar (`build_extension_toolbar`): a 32pt face per pinned, enabled extension with a toolbar button, its
///|   badge a crisp pill over the face's bottom-right corner, as Chrome's (`badge_text` in `badge_bg`, ink chosen for
///|   contrast); `always_manage` adds a face that opens the manager. A press goes to `on_press` with the face's window rectangle.
///| - Popover (`build_extension_popup_popover`): the anchored floating panel (`shell_float_rim`) of the extension
///|   pressed: its tile, name and toolbar title, a full-bleed `shell_full_divider`, then the popup page (opened
///|   from here), Options, Unpin and Manage.
///|
///| Pure UI: data comes in as `proto::ExtensionsUiSnapshot`, every act goes out through the props' callbacks.

import "headless"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

pub struct ExtensionsPanelProps {
  pub snapshot : () -> proto::ExtensionsUiSnapshot
  pub on_toggle : (String, Bool) -> Unit
  pub on_pin : (String, Bool) -> Unit
  pub on_remove : (String) -> Unit
  pub on_options : (String) -> Unit
  ///| where the extension to load is: a folder with its manifest.json, or a .crx file (on the machine the pages
  ///| run on)
  pub path_field : ui::Field
  pub on_load_unpacked : (String) -> Unit
  pub on_install_crx : (String) -> Unit
}

pub struct ExtensionToolbarProps {
  ///| the pinned extensions to show (`proto::extensions_pinned_items`)
  pub items : () -> Array[proto::ExtensionUiItem]
  ///| a press on one: its id and the face's window rectangle (the popover's anchor)
  pub on_press : (String, AnchorRect) -> Unit
  pub on_manage : () -> Unit
  ///| the extension whose popover is open (its face shows pressed)
  pub open_id : () -> String
}

pub struct ExtensionPopupProps {
  pub open : () -> Bool
  pub item : () -> Option[proto::ExtensionUiItem]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub on_open_popup : (String) -> Unit
  pub on_options : (String) -> Unit
  pub on_unpin : (String) -> Unit
  pub on_manage : () -> Unit
  pub on_close : () -> Unit
}

// ============================================================================
// Shared pieces
// ============================================================================

///| An extension's tile: a neutral monochrome square with its name's first letter (the monochrome rule: an
///| extension is told by its name; its own icon is not sent to the client).
fn ext_tile(parent : view::View, name_by : () -> String, size~ : Double = SP_24) -> view::View {
  parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(mono_tile_ground))
    .edge(view::Live::By(fn() { (lg::hairline_w, if lg::is_dark() { 0xFFFFFF1AL } else { 0x00000018L }) }))
    .points(view::Live::Is(false))
    .center()
    <ui::Text
      in={tile}
      size={shell_tile_letter(size)}
      weight={500}
      lines={1}
      color_by=>{lg::surface().ink}
      text_by=>{proto::extension_monogram(name_by())}
    />
  })
}

///| The badge fill: the extension's own color, else the theme's accent.
fn ext_badge_fill(bg : Int64) -> Int64 {
  if bg == 0L {
    lg::surface().accent
  } else {
    bg
  }
}

///| A badge pill (`badge_text` on `badge_bg`): 16pt tall, at least as wide, 4pt side padding, a 1pt ring of the
///| frame color so it reads crisply over the face under it.
fn ext_badge_pill(parent : view::View, item_by : () -> proto::ExtensionUiItem, name : String) -> Unit {
  parent.show(fn() { proto::extension_badge_display(item_by().badge_text) != "" }, at_once=true, fn(pill : view::View) -> Unit {
    let _ = pill
    .height(view::Live::Is(Some(SP_16)))
    .min_width(view::Live::Is(Some(SP_16)))
    .padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
    .radius(view::Live::Is(SP_8))
    .center()
    .points(view::Live::Is(false))
    .ground(view::Live::By(fn() { ext_badge_fill(item_by().badge_bg) }))
    .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0x1C1C1EFFL } else { 0xFFFFFFFFL }) }))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Status, label=name + " badge " + proto::extension_badge_display(item_by().badge_text))) }))
    <ui::Text
      in={pill}
      size={TX_CAPTION}
      weight={500}
      lines={1}
      color_by=>{
        let it = item_by()
        if it.badge_bg == 0L { 0xFFFFFFFFL } else { proto::extension_badge_ink(it.badge_bg) }
      }
      text_by=>{proto::extension_badge_display(item_by().badge_text)}
    />
  })
}

///| A permission chip: `TX_CAPTION` in muted ink on the frame wash, 20pt tall, radius 6.
fn ext_chip(parent : view::View, text : String) -> Unit {
  let _ = parent.box(fn(chip : view::View) -> Unit {
    let _ = chip
    .height(view::Live::Is(Some(SP_20)))
    .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_0)))
    .radius(view::Live::Is(SP_6))
    .center()
    .rigid()
    .ground(view::Live::By(fn() { shell_wash(lg::is_dark()) }))
    <ui::Text in={chip} size={TX_CAPTION} lines={1} color_by=>{shell_ink_muted()} text={text} />
  })
}

fn ext_find(snap : proto::ExtensionsUiSnapshot, id : String) -> proto::ExtensionUiItem {
  proto::extensions_find(snap, id).unwrap_or(proto::ExtensionUiItem::blank(id))
}

// ============================================================================
// Manager (Settings > Extensions)
// ============================================================================

let sp_kw_extensions : String = "extensions extension add-ons addons plugins load unpacked install crx developer chrome web store pin toolbar badge popup permissions remove"

///| One installed extension's card body: tile, name + version, description, chips, error; the enable toggle; then
///| Pin / Options / Remove.
fn ext_manager_row(parent : view::View, ep : ExtensionsPanelProps, item_sig : signals::Signal[proto::ExtensionUiItem]) -> Unit {
  let it = fn() { item_sig.get() }
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row.padding(view::Live::Is((SP_16, SP_12, SP_16, SP_12))).gap(view::Live::Is(SP_8))
    let _ = row.box(fn(top : view::View) -> Unit {
      let _ = top.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_12))
      let _ = ext_tile(top, fn() { it().name }, size=SP_32)
      let _ = top.box(fn(col : view::View) -> Unit {
        let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0))).gap(view::Live::Is(SP_2))
        let _ = col.box(fn(line : view::View) -> Unit {
          let _ = line.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_6)).min_width(view::Live::Is(Some(SP_0)))
          let _ = line.box(fn(nw : view::View) -> Unit {
            let _ = nw.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(SP_0)))
            <ui::Text in={nw} size={TX_BODY} weight={500} lines={1} color_by=>{lg::surface().ink} text_by=>{it().name} />
          })
          let _ = line.box(fn(vw : view::View) -> Unit {
            let _ = vw.rigid()
            <ui::Text in={vw} size={TX_FOOTNOTE} lines={1} color_by=>{shell_ink_muted()} text_by=>{it().version} />
          })
        })
        col.show(fn() { it().description.trim() != "" }, at_once=true, fn(dw : view::View) -> Unit {
          let _ = dw.min_width(view::Live::Is(Some(SP_0)))
          <ui::Text in={dw} size={TX_FOOTNOTE} lines={2} wrap color_by=>{lg::surface().ink_secondary} text_by=>{it().description.trim()} />
        })
        col.show(fn() { it().error != "" }, at_once=true, fn(ew : view::View) -> Unit {
          let _ = ew.min_width(view::Live::Is(Some(SP_0)))
          <ui::Text in={ew} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().danger} text_by=>{it().error} />
        })
      })
      let _ = top.box(fn(tg : view::View) -> Unit {
        let _ = tg.rigid()
        let _ = shell_desktop_toggle(
          tg,
          fn() { it().enabled },
          fn(on : Bool) { (ep.on_toggle)(item_sig.untracked().id, on) },
          fn() { "Enable " + it().name },
        )
      })
    })
    // Permission chips: what it may touch, host access first.
    row.show(fn() { proto::extension_permission_chips(it()).length() > 0 }, at_once=true, fn(cw : view::View) -> Unit {
      let _ = cw
      .row(view::Live::Is(true))
      .wraps(view::Live::Is(Some(SP_4)))
      .gap(view::Live::Is(SP_4))
      .margin(view::Live::Is((SP_32 + SP_12, SP_0, SP_0, SP_0)))
      cw.each(
        fn() { proto::extension_permission_chips(it()) },
        fn(s : String) -> String { s },
        fn(slot : view::View, chip_sig : signals::Signal[String]) -> Unit { ext_chip(slot, chip_sig.untracked()) },
      )
    })
    let _ = row.box(fn(acts : view::View) -> Unit {
      let _ = acts
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(SP_4))
      .margin(view::Live::Is((SP_32, SP_0, SP_0, SP_0)))
      acts.show(fn() { it().has_action && it().enabled }, at_once=true, fn(pw : view::View) -> Unit {
        let _ = shell_text_btn(
          pw,
          fn() { (if it().pinned { "Unpin " } else { "Pin " }) + it().name },
          fn() {
            let cur = item_sig.untracked()
            (ep.on_pin)(cur.id, !cur.pinned)
          },
          text_by=fn() { if it().pinned { "Unpin from Toolbar" } else { "Pin to Toolbar" } },
        )
      })
      acts.show(fn() { it().options_url != "" && it().enabled }, at_once=true, fn(ow : view::View) -> Unit {
        let _ = shell_text_btn(ow, fn() { "Options for " + it().name }, fn() { (ep.on_options)(item_sig.untracked().id) }, text_by=fn() {
          "Options"
        })
      })
      let _ = acts.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
      let _ = shell_text_btn(
        acts,
        fn() { "Remove " + it().name },
        fn() { (ep.on_remove)(item_sig.untracked().id) },
        text_by=fn() { "Remove" },
        ink=fn() { lg::surface().danger },
      )
    })
  })
}

///| Settings > Extensions.
fn sp_build_extensions(parent : view::View, props : SettingsPanelProps, q : () -> String) -> Unit {
  match props.extensions {
    None => ()
    Some(ep) => {
      let shown = fn() { sp_matches_filter(q(), sp_kw_extensions) }
      sp_group_dyn(
        parent,
        "Developer",
        fn() {
          let s = (ep.snapshot)()
          if s.status != "" {
            s.status
          } else {
            "Load an unpacked extension's folder (the one with manifest.json) or install a .crx file. Manifest V3 only."
          }
        },
        shown,
        fn(g : view::View) -> Unit {
          let path = fn() { ep.path_field.text().trim() }
          let _ = g.box(fn(fb : view::View) -> Unit {
            let _ = fb.padding(view::Live::Is((SP_12, SP_8, SP_12, SP_8))).rigid()
            let _ = lg::liquid_text_field_node(
              fb,
              ep.path_field,
              placeholder="Folder with manifest.json, or a .crx file",
              height_by=fn() { SP_32 },
              label=fn() { "Extension Path" },
              show_label=false,
              radius=SP_8,
            )
          })
          shell_full_divider(g)
          let _ = g.box(fn(acts : view::View) -> Unit {
            let _ = acts
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(SP_4))
            .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
            let _ = shell_text_btn(
              acts,
              fn() { "Load Unpacked Extension" },
              fn() { (ep.on_load_unpacked)(path()) },
              text_by=fn() { "Load Unpacked" },
              disabled=fn() { path() == "" },
            )
            let _ = shell_text_btn(
              acts,
              fn() { "Install CRX File" },
              fn() { (ep.on_install_crx)(path()) },
              text_by=fn() { "Install .crx" },
              disabled=fn() { path() == "" },
            )
          })
        },
      )
      parent.show(fn() { shown() && (ep.snapshot)().status_error }, at_once=true, fn(err : view::View) -> Unit {
        let _ = err.padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0))).rigid()
        <ui::Text in={err} size={TX_FOOTNOTE} wrap color_by=>{lg::surface().danger} text_by=>{(ep.snapshot)().status} />
      })
      // Installed extensions: one card holding a row each, full-bleed rules between them.
      sp_group(parent, "Installed", "", fn() { shown() && (ep.snapshot)().items.length() > 0 }, fn(g : view::View) -> Unit {
        g.each(
          fn() { (ep.snapshot)().items },
          fn(it : proto::ExtensionUiItem) -> String { it.id },
          fn(slot : view::View, item_sig : signals::Signal[proto::ExtensionUiItem]) -> Unit {
            slot.show(
              fn() {
                let items = (ep.snapshot)().items
                items.length() > 0 && items[0].id != item_sig.get().id
              },
              fn(rw : view::View) -> Unit { shell_full_divider(rw) },
              at_once=true,
            )
            ext_manager_row(slot, ep, item_sig)
          },
        )
      })
      // Empty state: what is not there and why (no list controls over an empty list).
      parent.show(fn() { shown() && (ep.snapshot)().items.length() == 0 }, at_once=true, fn(emp : view::View) -> Unit {
        let _ = emp.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_0, SP_24, SP_0, SP_0)))
        <ui::Text in={emp} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text="No extensions" />
        <ui::Text
          in={emp}
          size={TX_FOOTNOTE}
          center
          wrap
          color_by=>{lg::surface().ink_secondary}
          text="Extensions you load or import from another browser show up here."
        />
      })
    }
  }
}

// ============================================================================
// Toolbar
// ============================================================================

///| The last face drawn for each pinned extension (the popover's anchor).
let ext_toolbar_faces : Map[String, view::View] = Map::new()

///| The window rectangle of a pinned extension's toolbar face, while it is on screen.
pub fn extension_toolbar_anchor(id : String) -> Option[AnchorRect] {
  anchor_from_view(ext_toolbar_faces.get(id))
}

///| One pinned extension's toolbar face: its 18pt tile on a 32pt round flat face (wash on hover, the 0.97 press, the
///| pressed wash while its popover is open), the badge pill over the bottom-right corner (the letter stays readable).
fn ext_toolbar_face(parent : view::View, props : ExtensionToolbarProps, item_sig : signals::Signal[proto::ExtensionUiItem]) -> Unit {
  let it = fn() { item_sig.get() }
  let _ = parent.box(fn(cell : view::View) -> Unit {
    let _ = cell.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).rigid()
    let face = headless::button(
      cell,
      fn() {
        let i = it()
        let badge = proto::extension_badge_display(i.badge_text)
        (if i.title != "" { i.title } else { i.name }) + (if badge != "" { ", " + badge } else { "" })
      },
      fn(_e) -> Unit {
        let id = item_sig.untracked().id
        let rect = extension_toolbar_anchor(id).unwrap_or(AnchorRect::empty())
        (props.on_press)(id, rect)
      },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let hover_t = shell_fade_asym(b, fn() { btn.hovered() || btn.pressed() })
        let open_t = shell_fade(b, fn() { (props.open_id)() == item_sig.get().id }, duration_ms=MO_KEY_MS)
        let _ = b
        .width(view::Live::Is(Some(SP_32)))
        .height(view::Live::Is(Some(SP_32)))
        // (round, as every shell icon face: concentric with the tile inside it)
        .radius(view::Live::Is(SP_16))
        .center()
        .focus_ring_theme()
        .ground(view::Live::By(fn() {
          let s = lg::surface()
          let rest = if lg::is_dark() { 0xFFFFFF22L } else { 0x00000016L }
          let a = open_t()
          lg::over(lg::alpha(s.row_hover, hover_t() * (1.0 - a)), lg::alpha(rest, a))
        }))
        shell_press(b, fn() { btn.pressed() })
        let _ = ext_tile(b, fn() { it().name }, size=SP_16 + SP_2)
      },
    )
    ext_toolbar_faces.set(item_sig.untracked().id, face)
    // (over the face's bottom-right corner, as Chrome's; it takes no press)
    let _ = cell.box(fn(corner : view::View) -> Unit {
      let _ = corner.over(view::Live::Is(true), edges=(None, None, Some(SP_0 - SP_4), Some(SP_0 - SP_2))).points(view::Live::Is(false))
      ext_badge_pill(corner, fn() { item_sig.get() }, item_sig.untracked().name)
    })
  })
}

///| The toolbar's extension buttons: the pinned ones, then (with `always_manage`) Extensions, the manager. Nothing
///| when none is pinned and `always_manage` is false (the Address Bar keeps its width).
pub fn build_extension_toolbar(parent : view::View, props : ExtensionToolbarProps, always_manage~ : Bool = true) -> Unit {
  parent.show(fn() { always_manage || (props.items)().length() > 0 }, at_once=true, fn(bar : view::View) -> Unit {
    let _ = bar.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2)).rigid()
    bar.each(
      props.items,
      fn(it : proto::ExtensionUiItem) -> String { it.id },
      fn(slot : view::View, item_sig : signals::Signal[proto::ExtensionUiItem]) -> Unit { ext_toolbar_face(slot, props, item_sig) },
    )
    if always_manage {
      let _ = shell_icon_face_btn(bar, fn() { "Extensions" }, props.on_manage, fn() { "layout-grid" })
    }
  })
}

// ============================================================================
// Popover
// ============================================================================

///| The popover of a pressed toolbar extension (tag `"extension_popup"`): the anchored floating panel with its
///| header (tile, name, toolbar title, close), a full-bleed divider, then the popup page and its other acts.
pub fn build_extension_popup_popover(root : view::View, props : ExtensionPopupProps) -> Unit {
  let cur = fn() -> proto::ExtensionUiItem { (props.item)().unwrap_or(proto::ExtensionUiItem::blank("")) }
  pop_mount(
    root,
    fn() { (props.open)() && (props.item)() is Some(_) },
    props.on_close,
    props.trigger_anchor,
    props.fallback_capsule,
    SP_160 * 2.0,
    "Extension",
    fn(hw : view::View, close : () -> Unit) -> Unit {
      pop_header(
        hw,
        fn(lw : view::View) -> Unit {
          let _ = ext_tile(lw, fn() { cur().name }, size=SP_24)
        },
        false,
        fn() { cur().name },
        fn() {
          let i = cur()
          let badge = proto::extension_badge_display(i.badge_text)
          let t = if i.title != "" && i.title != i.name { i.title } else { "Version " + i.version }
          if badge != "" { t + " \u{00B7} " + badge } else { t }
        },
        "Close Extension",
        close,
      )
    },
    fn(panel : view::View) -> Unit {
      pop_group(panel, fn(g : view::View) -> Unit {
        g.show(fn() { cur().popup_html_path != "" }, at_once=true, fn(pw : view::View) -> Unit {
          pop_nav_row(
            pw,
            fn() { "Open " + cur().name + " Popup" },
            fn() { (props.on_open_popup)(cur().popup_html_path) },
            fn(lw : view::View) -> Unit { let _ = shell_glyph_tile(lw, "external-link", size=SP_24) },
            fn() { "Open Popup" },
            fn() { "" },
          )
          pop_rule(pw)
        })
        g.show(fn() { cur().options_url != "" }, at_once=true, fn(ow : view::View) -> Unit {
          pop_nav_row(
            ow,
            fn() { "Options for " + cur().name },
            fn() { (props.on_options)(cur().id) },
            fn(lw : view::View) -> Unit { let _ = shell_glyph_tile(lw, "settings", size=SP_24) },
            fn() { "Options" },
            fn() { "" },
          )
          pop_rule(ow)
        })
        pop_nav_row(
          g,
          fn() { "Unpin " + cur().name },
          fn() { (props.on_unpin)(cur().id) },
          fn(lw : view::View) -> Unit { let _ = shell_glyph_tile(lw, "pin", size=SP_24) },
          fn() { "Unpin from Toolbar" },
          fn() { "" },
          chevron=false,
        )
        pop_rule(g)
        pop_nav_row(
          g,
          fn() { "Manage Extensions" },
          props.on_manage,
          fn(lw : view::View) -> Unit { let _ = shell_glyph_tile(lw, "layout-grid", size=SP_24) },
          fn() { "Manage Extensions" },
          fn() { "" },
        )
      })
      panel.show(fn() { proto::extension_permission_chips(cur()).length() > 0 }, at_once=true, fn(cw : view::View) -> Unit {
        let _ = cw.row(view::Live::Is(true)).wraps(view::Live::Is(Some(SP_4))).gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
        cw.each(
          fn() { proto::extension_permission_chips(cur()) },
          fn(s : String) -> String { s },
          fn(slot : view::View, chip_sig : signals::Signal[String]) -> Unit { ext_chip(slot, chip_sig.untracked()) },
        )
      })
    },
    header_divider=true,
  )
}
