///| Quick Window: compact floating quick-lookup browser window (`⌥⌘N` / `Ctrl+Alt+N`),
///| centered cleanly over the right page stage (never overlapping the docked sidebar) with
///| Apple-design spring physics (`shell_spring_window()`):
///|   - Minimal 40pt Space-tinted chrome: close dot, Space pill, recessed centered URL capsule
///|     (`🔒 host`), and elevated white split-pill `Open in <Space> ⌘O | ∨` with inline Space picker.
///|   - Enter: real closed-form Apple spring (`ratio=0.86, stiffness=430`) blooming `0.72 -> 1.0`
///|     with `+28pt -> 0` upward lift and rapid 65ms front-loaded opacity.
///|   - Exit (Close): crisp 120ms collapse (`1.0 -> 0.88`, `dy 0 -> +12pt`, fast fade).
///|   - Promote (`Open in <Space> ⌘O`): smooth spring expansion (`1.0 -> 1.05`, `dy 0 -> -8pt`)
///|     into the target Space.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

pub struct LittleArcProps {
  pub open : () -> Bool
  pub dark : () -> Bool
  pub stage_left : () -> Double
  pub url : () -> String
  pub title : () -> String
  pub spaces : () -> Array[ShellSpaceItem]
  pub target_space_id : signals::Signal[String]
  pub url_field : ui::Field
  pub on_navigate : (String) -> Unit
  pub on_promote : (String, String) -> Unit
  pub on_close : () -> Unit
  pub content : Option[(view::View) -> Unit]
}

fn la_space_for(spaces : Array[ShellSpaceItem], sid : String) -> ShellSpaceItem {
  for s in spaces {
    if s.id == sid {
      return s
    }
  }
  if spaces.length() > 0 {
    spaces[0]
  } else {
    ShellSpaceItem::{
      id: "work",
      name: "Work",
      accent_rgba: 0x007AFFFFL,
      theme: proto::space_theme_unset(),
    }
  }
}

///| Builds Quick Window as a standalone compact OS window (fills 100% of its own OS window:
///| no sidebar, no backdrop scrim, Space-tinted 40pt top chrome + Open in <Space> ⌘O | ∨ + full rounded page card).
pub fn build_quick_window_standalone(root : view::View, props : LittleArcProps) -> Unit {
  let editing_url : signals::Signal[Bool] = signals::signal(false)
  let space_picker_open : signals::Signal[Bool] = signals::signal(false)
  let close_now = fn() -> Unit {
    editing_url.set(false)
    space_picker_open.set(false)
    (props.on_close)()
  }
  let promote_now = fn() -> Unit {
    let cur_u = (props.url)()
    let sp = la_space_for((props.spaces)(), props.target_space_id.untracked())
    editing_url.set(false)
    space_picker_open.set(false)
    (props.on_promote)(cur_u, sp.id)
  }
  let sp_now = fn() -> ShellSpaceItem { la_space_for((props.spaces)(), props.target_space_id.get()) }
  let frame_bg = fn() -> Int64 { shell_frame_tint(sp_now().accent_rgba, (props.dark)()) }
  let _ = root.box(fn(win : view::View) -> Unit {
    let _ = win
    .fill()
    .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_6)))
    .ground(view::Live::By(frame_bg))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Quick Window"))))
    qw_build_inner_chrome(win, props, editing_url, space_picker_open, close_now, promote_now)
  })
}

///| Builds the Quick Window floating compact browser overlay (single-window fallback: no modal dimming veil,
///| centered over the right page stage with Apple spring motion so it stays visually distinct from in-app Peek).
pub fn build_little_arc_window(root : view::View, props : LittleArcProps) -> Unit {
  let built : signals::Ref[Bool] = ui::ref_new(false)
  let promoting : signals::Signal[Bool] = signals::signal(false)
  let editing_url : signals::Signal[Bool] = signals::signal(false)
  let space_picker_open : signals::Signal[Bool] = signals::signal(false)

  let stage_x = fn() -> Double {
    let sx = (props.stage_left)()
    if sx > SP_0 { sx } else { SHELL_FRAME_GAP }
  }
  let stage_w = fn() -> Double {
    let rw = root.window_w()
    let sw = rw - stage_x() - SHELL_FRAME_GAP
    if sw > 360.0 { sw } else if rw > SP_32 { rw - SP_16 } else { 760.0 }
  }
  let win_w = fn() -> Double {
    let avail = stage_w() - SP_64
    if avail > 780.0 { 780.0 } else if avail < 360.0 { 360.0 } else { avail }
  }
  let win_h = fn() -> Double {
    let rh = root.window_h()
    let avail = if rh > SP_96 { rh - SP_96 } else { 540.0 }
    if avail > 580.0 { 580.0 } else if avail < 300.0 { 300.0 } else { avail }
  }
  let win_x = fn() -> Double {
    let sx = stage_x()
    let sw = stage_w()
    let w = win_w()
    sx + (sw - w) * 0.5
  }
  let win_y = fn() -> Double {
    let rh = root.window_h()
    let h = win_h()
    let y = (rh - h) * 0.5
    if y > SP_16 { y } else { SP_16 }
  }

  root.show(props.open, leave=MO_LITTLE_ARC_OUT_MS, fn(wrap : view::View) -> Unit {
    let animate = built.v
    let enter = motion::NodeWay::new(if animate { 0.0 } else { 1.0 })
    let fade = motion::NodeWay::new(if animate { 0.0 } else { 1.0 })
    if animate {
      shell_go_spring(enter, wrap, 1.0, shell_spring_window())
      shell_go(fade, wrap, 1.0, 65.0, ease=shell_ease_out())
    }
    let exit_way = motion::NodeWay::new(1.0)
    wrap.reacts(fn() { wrap.leaving() }, fn(leaving : Bool) -> Unit {
      if leaving {
        if promoting.untracked() {
          shell_go_spring(exit_way, wrap, 0.0, shell_spring_promote())
        } else {
          shell_go(exit_way, wrap, 0.0, MO_LITTLE_ARC_OUT_MS, ease=shell_ease_out())
        }
      }
    }, at_start=false)

    let close_now = fn() -> Unit {
      promoting.set(false)
      editing_url.set(false)
      space_picker_open.set(false)
      view::transition(within=wrap, props.on_close)
    }
    let promote_now = fn() -> Unit {
      let cur_u = (props.url)()
      let sp = la_space_for((props.spaces)(), props.target_space_id.untracked())
      promoting.set(true)
      editing_url.set(false)
      space_picker_open.set(false)
      view::transition(within=wrap, fn() { (props.on_promote)(cur_u, sp.id) })
    }

    let _ = wrap.over(view::Live::Is(true)).points(view::Live::By(props.open))

    // Transparent outside click-catcher (NO dimming veil: Quick Window is an independent floating window, not a Peek modal)
    let _ = headless::dialog(
      wrap,
      fn() { "Quick Window" },
      props.open,
      close_now,
      fn(dlg : view::View, _d : headless::Dialog) -> Unit {
        let sp_now = fn() -> ShellSpaceItem { la_space_for((props.spaces)(), props.target_space_id.get()) }
        let frame_bg = fn() -> Int64 { shell_frame_tint(sp_now().accent_rgba, (props.dark)()) }
        let _ = dlg
        .over_at(view::Live::By(fn() { (Some(win_x()), Some(win_y()), None, None) }))
        .width(view::Live::By(fn() { Some(win_w()) }))
        .height(view::Live::By(fn() { Some(win_h()) }))
        .padding(view::Live::Is((SP_6, SP_0, SP_6, SP_6)))
        .radius(view::Live::Is(SP_16))
        .ground(view::Live::By(frame_bg))
        .edge(view::Live::By(fn() {
          (lg::hairline_w, if (props.dark)() { 0xFFFFFF2AL } else { 0x0000001EL })
        }))
        .shadow(view::Live::By(fn() {
          if (props.dark)() { (36.0, SP_16, 0x00000078L) } else { (32.0, SP_16, 0x00000030L) }
        }))
        .shadow_outside(view::Live::Is(true))
        .presses(view::Live::Is(true))
        .on_press(fn() -> Unit { () })
        .alpha(view::Live::By(fn() { fade.shown(dlg) * exit_way.shown(dlg) }))
        .scale(
          view::Live::By(fn() {
            if ui::reduced_motion() {
              1.0
            } else if wrap.leaving() {
              let e = exit_way.shown(dlg)
              if promoting.get() {
                1.0 + 0.05 * (1.0 - e)
              } else {
                0.88 + 0.12 * e
              }
            } else {
              let t = enter.shown(dlg)
              if (1.0 - t).abs() < 0.002 && !enter.goes(dlg) {
                1.0
              } else {
                MO_LITTLE_ARC_SCALE + (1.0 - MO_LITTLE_ARC_SCALE) * t
              }
            }
          }),
          about=view::Pivot::At(0.5, 0.54),
        )
        .offset(view::Live::By(fn() {
          if ui::reduced_motion() {
            (SP_0, SP_0)
          } else if wrap.leaving() {
            let e = exit_way.shown(dlg)
            if e <= 0.001 {
              (SP_0, SP_0)
            } else {
              let dy = if promoting.get() { (0.0 - SP_8) * (1.0 - e) } else { SP_12 * (1.0 - e) }
              (SP_0, dy)
            }
          } else {
            let t = enter.shown(dlg)
            if (1.0 - t).abs() < 0.002 && !enter.goes(dlg) {
              (SP_0, SP_0)
            } else {
              (SP_0, MO_LITTLE_ARC_RISE * (1.0 - t))
            }
          }
        }))
        qw_build_inner_chrome(dlg, props, editing_url, space_picker_open, close_now, promote_now)
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=true,
      before_dismiss=fn(how : headless::OverlayDismiss) -> Bool {
        if how is headless::OverlayDismiss::Escape {
          if space_picker_open.untracked() {
            space_picker_open.set(false)
            return true
          }
          if editing_url.untracked() {
            editing_url.set(false)
            return true
          }
        }
        false
      },
    )
  })
  built.v = true
}

fn qw_build_inner_chrome(
  dlg : view::View,
  props : LittleArcProps,
  editing_url : signals::Signal[Bool],
  space_picker_open : signals::Signal[Bool],
  close_now : () -> Unit,
  promote_now : () -> Unit,
) -> Unit {
  let sp_now = fn() -> ShellSpaceItem { la_space_for((props.spaces)(), props.target_space_id.get()) }
  // 1. Minimal Quick Window Top Chrome Bar (40pt)
  let _ = dlg.box(fn(bar : view::View) -> Unit {
    let _ = bar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SP_40)))
    .rigid()
    .padding(view::Live::Is((SP_2, SP_0, SP_2, SP_0)))
    .gap(view::Live::Is(SP_8))

    // 1a. Left: Close button + Space badge pill
    let _ = bar.box(fn(left : view::View) -> Unit {
      let _ = left.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid().gap(view::Live::Is(SP_6))
      let _ = headless::button(
        left,
        fn() { "Close Quick Window" },
        fn(_e) -> Unit { close_now() },
        fn(cb : view::View, btn : headless::Button) -> Unit {
          let ht = shell_fade_asym(cb, fn() { btn.hovered() || btn.pressed() })
          let _ = cb.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).rigid().center()
          let _ = cb.box(fn(face : view::View) -> Unit {
            let _ = face
            .width(view::Live::Is(Some(SP_24)))
            .height(view::Live::Is(Some(SP_24)))
            .radius(view::Live::Is(SP_12))
            .center()
            .points(view::Live::Is(false))
            .ground(view::Live::By(fn() {
              lg::over(shell_wash((props.dark)()), lg::alpha(shell_close_hover_wash((props.dark)()), ht()))
            }))
            shell_press(face, fn() { btn.pressed() })
            shell_focus_ring(face, fn() { btn.focus_shown() }, SP_12)
            let _ = shell_icon(face, ICON_CLOSE, size=IC_SM, color_by=fn() {
              shell_mix(shell_frame_ink_secondary((props.dark)()), shell_close_hover_ink((props.dark)()), ht())
            })
          })
        },
      )
      // Space badge pill (`Work`)
      let _ = left.box(fn(pill : view::View) -> Unit {
        let _ = pill
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .height(view::Live::Is(Some(SP_24)))
        .rigid()
        .padding(view::Live::Is((SP_8, SP_0, SP_10, SP_0)))
        .gap(view::Live::Is(SP_6))
        .radius(view::Live::Is(SP_12))
        .ground(view::Live::By(fn() { shell_wash((props.dark)()) }))
        let _ = pill.box(fn(dot : view::View) -> Unit {
          let _ = dot
          .width(view::Live::Is(Some(SP_8)))
          .height(view::Live::Is(Some(SP_8)))
          .radius(view::Live::Is(SP_4))
          .rigid()
          .ground(view::Live::By(fn() { sp_now().accent_rgba }))
        })
        let _ = <ui::Text
          in={pill}
          size={TX_FOOTNOTE}
          weight={500}
          lines={1}
          color_by=>{lg::surface().ink}
          text_by=>{sp_now().name}
        />
      })
    })

    // 1b. Center: Recessed centered URL capsule (click to edit inline)
    let _ = bar.box(fn(mid : view::View) -> Unit {
      let ht = shell_fade_asym(mid, fn() { mid.pointed() || mid.pointed_in() })
      let _ = mid
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(SP_0)))
      .min_width(view::Live::Is(Some(SP_96)))
      .height(view::Live::Is(Some(SP_32)))
      .radius(view::Live::Is(SP_8))
      .ground(view::Live::By(fn() {
        let d = (props.dark)()
        lg::over(shell_wash(d), lg::alpha(shell_wash_hover(d), ht()))
      }))
      .edge(view::Live::By(fn() {
        (lg::hairline_w, lg::alpha(if (props.dark)() { 0xFFFFFF1EL } else { 0x00000014L }, ht()))
      }))
      mid.show(fn() { !editing_url.get() }, at_once=true, fn(rest_v : view::View) -> Unit {
        let _ = headless::button(
          rest_v,
          fn() { "Quick Window Address" },
          fn(_e) -> Unit {
            props.url_field.set((props.url)())
            editing_url.set(true)
            props.url_field.focus()
          },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let _ = b
            .fill()
            .height(view::Live::Is(Some(SP_32)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .padding(view::Live::Is((SP_10, SP_0, SP_10, SP_0)))
            .gap(view::Live::Is(SP_6))
            shell_focus_ring(b, fn() { btn.focus_shown() }, SP_8)
            let _ = shell_icon(b, ICON_LOCK, size=IC_SM, color_by=fn() { shell_frame_ink_secondary((props.dark)()) })
            let _ = <ui::Text
              in={b}
              size={TX_BODY}
              weight={500}
              lines={1}
              color_by=>{lg::surface().ink}
              text_by=>{
                let u = (props.url)()
                let (h, rest) = shell_url_parts(u)
                if h != "" { h } else if rest != "" { rest } else { "Search or enter URL…" }
              }
            />.allow_ellipsis(view::Live::Is(true))
          },
        )
      })
      mid.show(fn() { editing_url.get() }, at_once=true, fn(ed_v : view::View) -> Unit {
        let _ = ed_v
        .fill()
        .height(view::Live::Is(Some(SP_32)))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((SP_10, SP_0, SP_10, SP_0)))
        let _ = ui::field(
          ed_v,
          props.url_field,
          placeholder="Search or enter URL…",
          font_size=TX_BODY,
          max_lines=1,
          enter_sends=true,
          label="Quick Window Address Input",
          colors_by=fn() { (lg::surface().ink, lg::surface().ink_tertiary, lg::surface().accent) },
          submitted=fn(t : String) -> Unit {
            let clean = t.trim()
            editing_url.set(false)
            if clean != "" {
              (props.on_navigate)(clean)
            }
          },
        )
      })
    })

    // 1c. Right: Arc's signature crisp elevated split-pill button `Open in Work ⌘O | ∨`
    let _ = bar.box(fn(split_pill : view::View) -> Unit {
      let _ = split_pill
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(SP_32)))
      .rigid()
      .radius(view::Live::Is(SP_8))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() {
        if (props.dark)() { lg::surface().card } else { 0xFFFFFFFFL }
      }))
      .edge(view::Live::By(fn() {
        (lg::hairline_w, if (props.dark)() { 0xFFFFFF22L } else { 0x00000014L })
      }))
      .shadow(view::Live::By(fn() {
        if (props.dark)() { (SP_6, SP_2, 0x00000044L) } else { (SP_6, SP_2, 0x00000014L) }
      }))
      .shadow_outside(view::Live::Is(true))

      // Primary promote button (`Open in <Space> ⌘O`)
      let _ = headless::button(
        split_pill,
        fn() { "Open in " + sp_now().name },
        fn(_e) -> Unit { promote_now() },
        fn(pb : view::View, btn : headless::Button) -> Unit {
          let ht = shell_fade_asym(pb, fn() { btn.hovered() || btn.pressed() })
          let _ = pb
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(SP_32)))
          .padding(view::Live::Is((SP_10, SP_0, SP_8, SP_0)))
          .gap(view::Live::Is(SP_6))
          .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, ht()) }))
          shell_press(pb, fn() { btn.pressed() })
          <ui::Text in={pb} size={TX_FOOTNOTE} weight={500} lines={1} color_by=>{lg::surface().ink_secondary} text="Open in" />
          <ui::Text in={pb} size={TX_FOOTNOTE} weight={600} lines={1} color_by=>{shell_accent_text()} text_by=>{sp_now().name} />
          let _ = pb.box(fn(kc : view::View) -> Unit {
            let _ = kc
            .height(view::Live::Is(Some(SP_20)))
            .padding(view::Live::Is((SP_4, SP_0, SP_4, SP_0)))
            .radius(view::Live::Is(SP_4))
            .center()
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            <ui::Text
              in={kc}
              size={TX_CAPTION}
              weight={500}
              color_by=>{lg::surface().ink_secondary}
              text={if shell_keys_mac() { "⌘O" } else { "Ctrl+O" }}
            />
          })
        },
      )
      // Hairline divider
      let _ = split_pill.box(fn(sep : view::View) -> Unit {
        let _ = sep
        .width(view::Live::Is(Some(lg::hairline_w)))
        .height(view::Live::Is(Some(SP_16)))
        .ground(view::Live::By(fn() { lg::surface().separator_strong }))
      })
      // Chevron Space switcher trigger (`∨`)
      let _ = headless::button(
        split_pill,
        fn() { "Choose Space for Quick Window" },
        fn(_e) -> Unit { space_picker_open.set(!space_picker_open.untracked()) },
        fn(cb : view::View, btn : headless::Button) -> Unit {
          let ht = shell_fade_asym(cb, fn() { btn.hovered() || btn.pressed() || space_picker_open.get() })
          let _ = cb
          .width(view::Live::Is(Some(SP_32)))
          .height(view::Live::Is(Some(SP_32)))
          .center()
          .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, ht()) }))
          shell_press(cb, fn() { btn.pressed() })
          let _ = shell_icon(cb, ICON_CHEVRON_DOWN, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
        },
      )
    })
  })

  // 2. Rounded Inner Page Card (concentric radius 16 - 6 = 10pt)
  let _ = dlg.box(fn(card : view::View) -> Unit {
    let _ = card
    .fill()
    .radius(view::Live::Is(lg::concentric(SP_16, SP_6)))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { lg::surface().card }))
    .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
    match props.content {
      Some(render_page) => render_page(card)
      None => {
        let _ = card.box(fn(body : view::View) -> Unit {
          let _ = body.fill().center().padding(view::Live::Is((SP_32, SP_24, SP_32, SP_24))).gap(view::Live::Is(SP_8))
          let _ = shell_site_tile(body, fn() { shell_url_parts((props.url)()).0 }, size=SP_32)
          <ui::Text
            in={body}
            size={TX_HEADLINE}
            weight={600}
            color_by=>{lg::surface().ink}
            text_by=>{
              let t = (props.title)()
              if t != "" { t } else { shell_pane_label((props.url)(), "") }
            }
          />
          <ui::Text
            in={body}
            size={TX_FOOTNOTE}
            color_by=>{lg::surface().ink_secondary}
            text_by=>{(props.url)()}
          />
        })
      }
    }
  })

  // 3. Anchored Space Picker Popover (under the split-pill chevron)
  dlg.show(fn() { space_picker_open.get() }, leave=MO_POP_OUT_MS, fn(pop : view::View) -> Unit {
    let rev = shell_popover_reveal(pop, true)
    rev.grows(pop, ox=1.0, oy=0.0)
    let _ = pop
    .over_at(view::Live::Is((None, Some(SP_40 + SP_2), Some(SP_8), None)))
    .width(view::Live::Is(Some(SP_160 + SP_20)))
    .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
    .gap(view::Live::Is(SP_2))
    .radius(view::Live::Is(SP_12))
    .ground(view::Live::By(fn() { lg::surface().card }))
    let _ = shell_float_rim(pop)
    pop.each(
      props.spaces,
      fn(sp : ShellSpaceItem) -> String { sp.id },
      fn(row_w : view::View, sp_sig : signals::Signal[ShellSpaceItem]) -> Unit {
        let _ = headless::button(
          row_w,
          fn() { "Target Space " + sp_sig.get().name },
          fn(_e) -> Unit {
            props.target_space_id.set(sp_sig.untracked().id)
            space_picker_open.set(false)
          },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let ht = shell_fade_asym(b, fn() { btn.hovered() || btn.pressed() })
            let is_sel = fn() -> Bool { sp_now().id == sp_sig.get().id }
            let _ = b
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .height(view::Live::Is(Some(SP_32)))
            .padding(view::Live::Is((SP_8, SP_0, SP_8, SP_0)))
            .gap(view::Live::Is(SP_8))
            .radius(view::Live::Is(SP_8))
            .ground(view::Live::By(fn() {
              let s = lg::surface()
              if is_sel() { s.row_selected } else { lg::alpha(s.row_hover, ht()) }
            }))
            let _ = b.box(fn(dot : view::View) -> Unit {
              let _ = dot
              .width(view::Live::Is(Some(SP_8)))
              .height(view::Live::Is(Some(SP_8)))
              .radius(view::Live::Is(SP_4))
              .rigid()
              .ground(view::Live::By(fn() { sp_sig.get().accent_rgba }))
            })
            let _ = b.box(fn(tw : view::View) -> Unit {
              let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
              <ui::Text in={tw} size={TX_BODY} lines={1} color_by=>{lg::surface().ink} text_by=>{sp_sig.get().name} />
            })
            b.show(is_sel, at_once=true, fn(ic : view::View) -> Unit {
              let _ = shell_icon(ic, ICON_CHECK, size=IC_SM, color_by=fn() { lg::surface().accent })
            })
          },
        )
      },
    )
  })
}
