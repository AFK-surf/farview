///| Demo controllers and realistic fake web/reader `PaneSlot` scenes shared by
///| `shell_ui` Tier 1 tests and `pion/cmd/shell_shots` Metal @2x offscreen renderer.

import "headless"
import "icons"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

#derive(Eq)
pub enum DemoBackdrop {
  EditorialLight
  DocsDark
  ColorfulPoster
}

///| Builds a rich demo `ShellController` with Favorites, Folders, Tabs, Spaces,
///| Mini Media Player, History, and Bookmarks.
///| Idle `omnibox_field` holds the real full URL (`https://...`), never an empty placeholder.
pub fn make_demo_controller(
  dark~ : Bool = false,
  split~ : Bool = false,
  left_reader~ : Bool = false,
  omnibox_open~ : Bool = false,
  drawer_open~ : Bool = false,
  dialog_open~ : Bool = false,
  capture_sheet~ : Bool = false,
  window_inset_override? : Double,
) -> ShellController {
  let field = ui::Field::new()
  let initial_url = "https://webkit.org/blog/tahoe-liquid-glass"
  field.set(if omnibox_open { "webkit" } else { proto::omnibox_safe_display_url(initial_url) })

  let favs : Array[ShellFavoriteItem] = [
    ShellFavoriteItem::{
      id: "f1",
      title: "GitHub",
      url: "https://github.com",
      monogram: "G",
      accent_rgba: if dark { 0x3F4652FFL } else { 0x24292EFFL },
    },
    ShellFavoriteItem::{ id: "f2", title: "Linear", url: "https://linear.app", monogram: "L", accent_rgba: 0x4338CAFFL },
    ShellFavoriteItem::{ id: "f3", title: "Docs", url: "https://developer.apple.com", monogram: "D", accent_rgba: 0x0055CCFFL },
  ]
  let folders : Array[ShellFolderItem] = [
    ShellFolderItem::{ id: "research", name: "Research", collapsed: false },
  ]
  let tabs : Array[ShellTabItem] = [
    ShellTabItem::{
      id: "t1",
      title: "Liquid Glass Optical Spec",
      url: initial_url,
      folder_id: "research",
      space_id: "work",
      pinned: true,
      active: true,
      playing_audio: false,
      muted: false,
    },
    ShellTabItem::{
      id: "t2",
      title: "CSS Grid Level 3 Masonry",
      url: "https://drafts.csswg.org/css-grid-3/",
      folder_id: "research",
      space_id: "work",
      pinned: true,
      active: false,
      playing_audio: false,
      muted: false,
    },
    ShellTabItem::{
      id: "t3",
      title: "Ambient Synth Radio",
      url: "https://soma.fm/groovesalad",
      folder_id: "",
      space_id: "work",
      pinned: false,
      active: false,
      playing_audio: true,
      muted: false,
    },
    ShellTabItem::{
      id: "t4",
      title: "WPT Layout Dashboard",
      url: "https://wpt.fyi/results/css",
      folder_id: "",
      space_id: "work",
      pinned: false,
      active: false,
      playing_audio: false,
      muted: false,
    },
  ]
  let spaces : Array[ShellSpaceItem] = [
    ShellSpaceItem::{ id: "work", name: "Work", accent_rgba: 0x007AFFFFL },
    ShellSpaceItem::{ id: "personal", name: "Life", accent_rgba: 0x34C759FFL },
    ShellSpaceItem::{ id: "lab", name: "Lab", accent_rgba: 0xAF52DEFFL },
  ]
  let history_items : Array[proto::HistoryItemSummary] = [
    proto::HistoryItemSummary::{
      url: "https://webkit.org/blog/tahoe-liquid-glass",
      title: "WebKit Optical Material & Refraction Notes",
      host: "webkit.org",
      visit_count: 14,
      last_visit_secs: 1000L,
    },
    proto::HistoryItemSummary::{
      url: "https://webkit.org/demos/typography",
      title: "WebKit Variable Font & CoreText Metrics",
      host: "webkit.org",
      visit_count: 6,
      last_visit_secs: 900L,
    },
  ]
  let bookmark_items : Array[proto::BookmarkEntry] = [
    proto::BookmarkEntry::{
      id: "bm-1",
      url: "https://webkit.org/specs/css-compositing",
      title: "WebKit Compositing & Backdrop Filter Spec",
      folder: "Research",
      created_ms: 500L,
    },
  ]

  let mp = proto::MiniPlayerState::{
    active: true,
    dismissed: false,
    tab_id: "t3",
    title: "Groove Salad — SomaFM",
    domain: "soma.fm",
    url: "https://soma.fm/groovesalad",
    playing: true,
    muted: false,
    is_live: false,
    duration_secs: 240,
    position_secs: 138,
  }

  let mut page = PageLayoutState::default()
  if split {
    let (p2, _) = page.with_layout(PageLayout::Split)
    page = p2
  }
  if left_reader {
    page = page.set_surface(PaneId::Primary, PaneSurface::Reader)
  }

  let mut passive = PassiveState::empty()
  if capture_sheet {
    passive = PassiveState::{
      ..passive,
      capture_sheet_open: true,
      capture_sheet: proto::CaptureSheetMeta::{
        filename: "farview-2026-11-24.png",
        path: "/tmp/farview-2026-11-24.png",
        width: 1280,
        height: 800,
        format: "PNG",
        size_bytes: 284120L,
        saved_at_label: "Just now",
      },
    }
  }

  let ctrl = ShellController::{
    url: signals::signal(initial_url),
    title: signals::signal("Liquid Glass Optical Spec"),
    secondary_url: signals::signal("https://drafts.csswg.org/css-grid-3/"),
    secondary_title: signals::signal("CSS Grid Level 3 Masonry"),
    loading: signals::signal(false),
    can_back: signals::signal(true),
    can_forward: signals::signal(false),
    omnibox_editing: signals::signal(omnibox_open),
    dark: signals::signal(dark),
    dock: signals::signal_ref(DockState::default()),
    page: signals::signal_ref(page),
    exclusive: signals::signal_ref(ExclusiveState::empty()),
    passive: signals::signal_ref(passive),
    omnibox_field: field,
    omnibox_suggest: signals::signal_ref(proto::OmniSuggestState::empty()),
    omnibox_gate: signals::signal_ref(OmniboxRequestGate::new()),
    favorites: signals::signal_ref(favs),
    folders: signals::signal_ref(folders),
    tabs: signals::signal_ref(tabs),
    spaces: signals::signal_ref(spaces),
    active_space_id: signals::signal("work"),
    mini_player: signals::signal_ref(mp),
    last_intent: signals::signal(""),
    dispatched_omnibox_queries: [],
    history_items,
    bookmark_items,
    next_tab_seq: ui::ref_new(100),
    next_folder_seq: ui::ref_new(100),
    window_inset_override,
  }

  if omnibox_open {
    ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  } else if drawer_open {
    ctrl.dispatch(ShellIntent::ToggleDrawer)
  } else if dialog_open {
    ctrl.dispatch(ShellIntent::OpenDialog)
  }

  ctrl
}

///| Builds a fake web/reader pane surface with real focusable controls so
///| clicking/focusing either pane dispatches `SetPaneFocus(pane)`.
pub fn build_demo_pane(
  parent : view::View,
  pane : PaneId,
  model : ShellModel,
  emit~ : (ShellIntent) -> Unit = fn(_i) { () },
  backdrop~ : DemoBackdrop = DemoBackdrop::EditorialLight,
) -> Unit {
  let surface_of = fn() -> PaneSurface {
    match pane {
      PaneId::Primary => model.page().primary_surface
      PaneId::Secondary => model.page().secondary_surface
    }
  }
  let is_reader = fn() -> Bool { surface_of() is PaneSurface::Reader }
  let pane_action_label = match pane {
    PaneId::Primary => "Primary Pane Focus"
    PaneId::Secondary => "Secondary Pane Focus"
  }

  let _ = parent.box(fn(page : view::View) -> Unit {
    let _ = page.fill()
    // Reader surface vs Web surface
    page.show(is_reader, fn(r : view::View) -> Unit {
      let _ = r.fill().ground(view::Live::By(fn() {
        if model.dark() { 0x161618FFL } else { 0xFAF8F3FFL }
      }))
      let _ = ui::scroll_box(r, fn(col : view::View) -> Unit {
        let _ = col.padding(view::Live::Is((32.0, 28.0, 32.0, 28.0))).gap(view::Live::Is(14.0))
        let _ = col.box(fn(hdr : view::View) -> Unit {
          let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between)).rigid()
          let _ = <ui::Row in={hdr} align={.Middle} gap={8.0} rigid>
            <icons::Icon name={ICON_READER} size={14.0} color_by=>{if model.dark() { 0x60A5FAFFL } else { 0x0055CCFFL }} />
            <ui::Text size={11.0} weight={600} color_by=>{if model.dark() { 0x60A5FAFFL } else { 0x0055CCFFL }} text="READER VIEW" />
          </ui::Row>
          let _ = headless::button(
            hdr,
            fn() { pane_action_label },
            fn(_e) -> Unit { emit(ShellIntent::SetPaneFocus(pane)) },
            fn(b : view::View, _btn : headless::Button) -> Unit {
              let _ = b.min_width(view::Live::Is(Some(36.0))).min_height(view::Live::Is(Some(36.0))).padding(view::Live::Is((8.0, 0.0, 8.0, 0.0))).center()
              let _ = <ui::Text in={b} size={11.0} color_by=>{lg::surface().ink_secondary} text="webkit.org · 6 min read" />
            },
          )
        })
        <ui::Text
          in={col}
          size={24.0}
          weight={700}
          wrap
          color_by=>{lg::surface().ink}
          text="Optical Restraint in Modern Desktop Shells"
        />
        <ui::Text
          in={col}
          size={15.0}
          wrap
          color_by=>{lg::surface().ink}
          text="A calm, high-contrast reading surface keeps typography crisp while floating navigation controls remain lightweight and unobtrusive above the viewport."
        />
        <ui::Text
          in={col}
          size={15.0}
          wrap
          color_by=>{lg::surface().ink}
          text="Concentric corner geometry aligns every nested surface from the outer window frame down to individual cards, rows, and action pills."
        />
      })
    })

    page.show(fn() { !is_reader() }, fn(w : view::View) -> Unit {
      let _ = w.fill()
      match backdrop {
        DemoBackdrop::ColorfulPoster => {
          let _ = w.ground(view::Live::Is(0x1E1B4BFFL))
          let _ = ui::scroll_box(w, fn(col : view::View) -> Unit {
            let _ = col.padding(view::Live::Is((24.0, 24.0, 24.0, 24.0))).gap(view::Live::Is(16.0))
            <ui::Row in={col} gap={14.0} rigid>
              <ui::Box fill height={140.0} radius={16.0} pad={18.0} bg_by=>{0x9F1239FFL} gap={6.0}>
                <ui::Text size={18.0} weight={700} color_by=>{0xFFFFFFFFL} text="Crimson Editorial Hero" />
                <ui::Text size={13.0} wrap color_by=>{0xFFFFFFFFL} text="High-chroma magenta and coral backdrop behind floating Liquid Glass overlays." />
              </ui::Box>
              <ui::Box fill height={140.0} radius={16.0} pad={18.0} bg_by=>{0x065F46FFL} gap={6.0}>
                <ui::Text size={18.0} weight={700} color_by=>{0xFFFFFFFFL} text="Emerald Studio Canvas" />
                <ui::Text size={13.0} wrap color_by=>{0xFFFFFFFFL} text="Verifies that dense panel glass maintains >= 4.5:1 text contrast over vibrant color." />
              </ui::Box>
            </ui::Row>
            <ui::Row in={col} gap={14.0} rigid>
              <ui::Box fill height={140.0} radius={16.0} pad={18.0} bg_by=>{0x9A3412FFL} gap={6.0}>
                <ui::Text size={18.0} weight={700} color_by=>{0xFFFFFFFFL} text="Amber Signal Grid" />
                <ui::Text size={13.0} wrap color_by=>{0xFFFFFFFFL} text="Warm saturated orange band testing light/dark refraction legibility." />
              </ui::Box>
              <ui::Box fill height={140.0} radius={16.0} pad={18.0} bg_by=>{0x1D4ED8FFL} gap={6.0}>
                <ui::Text size={18.0} weight={700} color_by=>{0xFFFFFFFFL} text="Cobalt Interactive Deck" />
                <ui::Text size={13.0} wrap color_by=>{0xFFFFFFFFL} text="Deep saturated blue surface under Omnibox suggestions." />
              </ui::Box>
            </ui::Row>
            <ui::Box in={col} height={160.0} radius={16.0} pad={18.0} bg_by=>{0x6D28D9FFL} gap={8.0} rigid>
              <ui::Text size={20.0} weight={700} color_by=>{0xFFFFFFFFL} text="Ultraviolet Typography Band" />
              <ui::Text size={14.0} wrap color_by=>{0xFFFFFFFFL} text="High-contrast display typography across saturated bands ensures any floating glass popover remains effortless to scan." />
            </ui::Box>
          })
        }
        _ => {
          let _ = w.ground(view::Live::By(fn() { lg::surface().card }))
          let _ = ui::scroll_box(w, fn(col : view::View) -> Unit {
            let _ = col.padding(view::Live::Is((28.0, 24.0, 28.0, 24.0))).gap(view::Live::Is(16.0))
            let host_label = fn() -> String {
              match pane {
                PaneId::Primary => proto::omnibox_display_host(model.url())
                PaneId::Secondary => proto::omnibox_display_host(model.secondary_url())
              }
            }
            let heading = match pane {
              PaneId::Primary => "Farview Pure-Pion Engine"
              PaneId::Secondary => "CSS Grid Level 3 Specification"
            }
            let _ = col.box(fn(hdr : view::View) -> Unit {
              let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between)).rigid()
              let _ = <ui::Text in={hdr} size={12.0} weight={600} color_by=>{if model.dark() { 0x60A5FAFFL } else { 0x0055CCFFL }} text_by=>{host_label()} />
              let _ = headless::button(
                hdr,
                fn() { pane_action_label },
                fn(_e) -> Unit { emit(ShellIntent::SetPaneFocus(pane)) },
                fn(b : view::View, _btn : headless::Button) -> Unit {
                  let _ = b.min_width(view::Live::Is(Some(36.0))).min_height(view::Live::Is(Some(36.0))).padding(view::Live::Is((8.0, 0.0, 8.0, 0.0))).center()
                  let _ = <ui::Text in={b} size={12.0} color_by=>{lg::surface().ink_secondary} text="Document Sync Active" />
                },
              )
            })
            <ui::Text in={col} size={26.0} weight={700} wrap color_by=>{lg::surface().ink} text={heading} />
            <ui::Text
              in={col}
              size={14.0}
              wrap
              color_by=>{lg::surface().ink_secondary}
              text="Authoritative DOM, stylesheets, and incremental layout synchronized cleanly to native GPU nodes."
            />
            <ui::Row in={col} gap={12.0} rigid>
              <lg::SurfaceCard pad={14.0} gap={6.0} secondary label="Metrics Card">
                <ui::Text size={12.0} weight={600} color_by=>{lg::surface().ink_secondary} text="FRAME BUDGET" />
                <ui::Text size={20.0} weight={700} color_by=>{lg::surface().ink} text="8.3 ms" />
                <ui::Text size={12.0} color_by=>{if model.dark() { 0x30D158FFL } else { 0x166534FFL }} text="120 Hz Metal Lock" />
              </lg::SurfaceCard>
              <lg::SurfaceCard pad={14.0} gap={6.0} secondary label="Layout Card">
                <ui::Text size={12.0} weight={600} color_by=>{lg::surface().ink_secondary} text="INCREMENTAL PASS" />
                <ui::Text size={20.0} weight={700} color_by=>{lg::surface().ink} text="0.4 ms" />
                <ui::Text size={12.0} color_by=>{lg::surface().ink_secondary} text="Dirty Subtree Only" />
              </lg::SurfaceCard>
            </ui::Row>
            <lg::SurfaceCard in={col} pad={16.0} gap={8.0} label="Architecture Overview">
              <ui::Text size={15.0} weight={600} color_by=>{lg::surface().ink} text="Two-Layer Desktop Architecture" />
              <ui::Text
                size={13.0}
                wrap
                color_by=>{lg::surface().ink_secondary}
                text="Content surfaces remain crisp solid paper while floating navigation islands and transient overlays use calibrated single-layer Liquid Glass."
              />
            </lg::SurfaceCard>
          })
        }
      }
    })
  })
}
