///| Demo controllers and realistic fake web/reader `PaneSlot` scenes shared by
///| `shell_ui` Tier 1 tests and `pion/cmd/shell_shots` Metal @2x offscreen renderer.

import "headless"
import "icons"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

#derive(Eq)
pub enum DemoBackdrop {
  EditorialLight
  DocsDark
  ColorfulPoster
}

///| A screenshot of an MDN page saved to Downloads (demo data for the capture sheet).
pub fn demo_capture_meta() -> proto::CaptureSheetMeta {
  proto::CaptureSheetMeta::{
    filename: "developer.mozilla.org-2026-11-24-at-14.32.png",
    path: "~/Downloads/developer.mozilla.org-2026-11-24-at-14.32.png",
    width: 2560,
    height: 1600,
    format: "PNG",
    size_bytes: 1468006L,
    saved_at_label: "Just now",
  }
}

///| Builds a rich demo `ShellController` with Favorites, Folders, Tabs, Spaces,
///| Mini Media Player, History, and Bookmarks.
///| Idle `omnibox_field` holds the real full URL (`https://...`), never an empty placeholder.
pub fn make_demo_controller(
  dark~ : Bool = false,
  split~ : Bool = false,
  left_reader~ : Bool = false,
  omnibox_open~ : Bool = false,
  drawer_open~ : Bool = false,
  dialog_open~ : Bool = false,
  capture_sheet~ : Bool = false,
  window_inset_override? : Double,
) -> ShellController {
  let field = ui::Field::new()
  let initial_url = "https://notes.example.com/designing-for-reading"
  field.set(if omnibox_open { "grid" } else { proto::omnibox_safe_display_url(initial_url) })

  let favs : Array[ShellFavoriteItem] = [
    ShellFavoriteItem::{
      id: "f1",
      title: "GitHub",
      url: "https://github.com",
      monogram: "G",
      accent_rgba: if dark { 0x3F4652FFL } else { 0x24292EFFL },
      active: false,
    },
    ShellFavoriteItem::{ id: "f2", title: "Linear", url: "https://linear.app", monogram: "L", accent_rgba: 0x4338CAFFL, active: false },
    ShellFavoriteItem::{ id: "f3", title: "Figma", url: "https://figma.com", monogram: "F", accent_rgba: 0xF24E1EFFL, active: false },
    ShellFavoriteItem::{ id: "f4", title: "Wikipedia", url: "https://en.wikipedia.org", monogram: "W", accent_rgba: 0x54595DFFL, active: false },
  ]
  let folders : Array[ShellFolderItem] = [
    ShellFolderItem::{ id: "research", name: "Research", collapsed: false },
  ]
  let tabs : Array[ShellTabItem] = [
    ShellTabItem::{
      id: "t1",
      title: "Designing for Reading",
      url: initial_url,
      folder_id: "research",
      space_id: "work",
      pinned: true,
      favorite: false,
      active: true,
      playing_audio: false,
      muted: false,
      loading: false,
      unloaded: false,
    },
    ShellTabItem::{
      id: "t2",
      title: "CSS Grid Layout Module Level 3",
      url: "https://drafts.csswg.org/css-grid-3/",
      folder_id: "research",
      space_id: "work",
      pinned: true,
      favorite: false,
      active: false,
      playing_audio: false,
      muted: false,
      loading: false,
      unloaded: false,
    },
    ShellTabItem::{
      id: "t3",
      title: "Groove Salad — SomaFM",
      url: "https://soma.fm/groovesalad",
      folder_id: "",
      space_id: "work",
      pinned: false,
      favorite: false,
      active: false,
      playing_audio: true,
      muted: false,
      loading: false,
      unloaded: false,
    },
    ShellTabItem::{
      id: "t4",
      title: "WPT Dashboard: css",
      url: "https://wpt.fyi/results/css",
      folder_id: "",
      space_id: "work",
      pinned: false,
      favorite: false,
      active: false,
      playing_audio: false,
      muted: false,
      loading: false,
      unloaded: false,
    },
  ]
  let spaces : Array[ShellSpaceItem] = [
    ShellSpaceItem::{ id: "work", name: "Work", accent_rgba: 0x007AFFFFL, theme: proto::space_theme_unset() },
    ShellSpaceItem::{ id: "personal", name: "Life", accent_rgba: 0x34C759FFL, theme: proto::space_theme_unset() },
    ShellSpaceItem::{ id: "lab", name: "Lab", accent_rgba: 0xAF52DEFFL, theme: proto::space_theme_unset() },
  ]
  let history_items : Array[proto::HistoryItemSummary] = [
    proto::HistoryItemSummary::{
      url: "https://gridbyexample.com/examples/",
      title: "Grid by Example",
      host: "gridbyexample.com",
      visit_count: 14,
      last_visit_secs: 1000L,
    },
    proto::HistoryItemSummary::{
      url: "https://developer.mozilla.org/en-US/docs/Web/CSS/grid",
      title: "grid - CSS | MDN",
      host: "developer.mozilla.org",
      visit_count: 6,
      last_visit_secs: 900L,
    },
  ]
  let bookmark_items : Array[proto::BookmarkEntry] = [
    proto::BookmarkEntry::{
      id: "bm-1",
      url: "https://drafts.csswg.org/css-grid-3/",
      title: "CSS Grid Layout Module Level 3",
      folder: "Research",
      created_ms: 500L,
    },
  ]

  let mp = proto::MiniPlayerState::{
    active: true,
    dismissed: false,
    tab_id: "t3",
    title: "Groove Salad — SomaFM",
    domain: "soma.fm",
    url: "https://soma.fm/groovesalad",
    playing: true,
    muted: false,
    is_live: false,
    duration_secs: 240,
    position_secs: 138,
  }

  let mut page = PageLayoutState::default()
  if split {
    let (p2, _) = page.with_layout(PageLayout::Split)
    page = p2
  }
  if left_reader {
    page = page.set_surface(PaneId::Primary, PaneSurface::Reader)
  }

  let mut passive = PassiveState::empty()
  if capture_sheet {
    passive = PassiveState::{
      ..passive,
      capture_sheet_open: true,
      capture_sheet: demo_capture_meta(),
    }
  }

  let ctrl = ShellController::{
    url: signals::signal(initial_url),
    title: signals::signal("Designing for Reading"),
    secondary_url: signals::signal("https://drafts.csswg.org/css-grid-3/"),
    secondary_title: signals::signal("CSS Grid Layout Module Level 3"),
    loading: signals::signal(false),
    can_back: signals::signal(true),
    can_forward: signals::signal(false),
    omnibox_editing: signals::signal(omnibox_open),
    dark: signals::signal(dark),
    dock: signals::signal_ref(DockState::default()),
    page: signals::signal_ref(page),
    exclusive: signals::signal_ref(ExclusiveState::empty()),
    passive: signals::signal_ref(passive),
    omnibox_field: field,
    omnibox_suggest: signals::signal_ref(proto::OmniSuggestState::empty()),
    omnibox_gate: signals::signal_ref(OmniboxRequestGate::new()),
    favorites: signals::signal_ref(favs),
    folders: signals::signal_ref(folders),
    tabs: signals::signal_ref(tabs),
    spaces: signals::signal_ref(spaces),
    active_space_id: signals::signal("work"),
    mini_player: signals::signal_ref(mp),
    last_intent: signals::signal(""),
    dispatched_omnibox_queries: [],
    history_items,
    bookmark_items,
    next_tab_seq: ui::ref_new(100),
    next_folder_seq: ui::ref_new(100),
    window_inset_override,
  }

  if omnibox_open {
    ctrl.dispatch(ShellIntent::OmniboxEdit("grid"))
  } else if drawer_open {
    ctrl.dispatch(ShellIntent::ToggleDrawer)
  } else if dialog_open {
    ctrl.dispatch(ShellIntent::OpenDialog)
  }

  ctrl
}

///| Builds a fake web/reader pane surface with real focusable controls so
///| clicking/focusing either pane dispatches `SetPaneFocus(pane)`.
pub fn build_demo_pane(
  parent : view::View,
  pane : PaneId,
  model : ShellModel,
  emit~ : (ShellIntent) -> Unit = fn(_i) { () },
  backdrop~ : DemoBackdrop = DemoBackdrop::EditorialLight,
) -> Unit {
  let surface_of = fn() -> PaneSurface {
    match pane {
      PaneId::Primary => model.page().primary_surface
      PaneId::Secondary => model.page().secondary_surface
    }
  }
  let is_reader = fn() -> Bool { surface_of() is PaneSurface::Reader }
  let pane_action_label = match pane {
    PaneId::Primary => "Primary Pane Focus"
    PaneId::Secondary => "Secondary Pane Focus"
  }

  let _ = parent.box(fn(page : view::View) -> Unit {
    let _ = page.fill()
    // Reader surface vs Web surface
    page.show(is_reader, fn(r : view::View) -> Unit {
      let _ = r.fill().ground(view::Live::By(fn() {
        if lg::is_dark() { 0x161618FFL } else { 0xFAF8F3FFL }
      }))
      let _ = ui::scroll_box(r, fn(outer : view::View) -> Unit {
        let _ = outer.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle)).padding(view::Live::Is((SP_32, SP_40, SP_32, SP_48)))
        let _ = outer.box(fn(col : view::View) -> Unit {
          let _ = col.grow(view::Live::Is(1.0)).max_width(view::Live::Is(Some(SP_160 * 4.0))).gap(view::Live::Is(SP_16))
          let _ = col.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8)).rigid()
            let _ = shell_site_tile(hdr, fn() { "notes.example.com" }, size=SP_16)
            let _ = headless::button(
              hdr,
              fn() { pane_action_label },
              fn(_e) -> Unit { emit(ShellIntent::SetPaneFocus(pane)) },
              fn(b : view::View, _btn : headless::Button) -> Unit {
                let _ = b.radius(view::Live::Is(SP_8)).focus_ring_theme().min_height(view::Live::Is(Some(SP_40))).row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_12))
                let _ = <ui::Text in={b} size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text="notes.example.com" />
                let _ = <ui::Text in={b} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text="6 min read" />
              },
            )
          })
          <ui::Text in={col} size={TX_TITLE1} weight={700} wrap color_by=>{lg::surface().ink} text="Designing for Reading" />
          <ui::Text
            in={col}
            size={TX_HEADLINE}
            wrap
            color_by=>{lg::surface().ink}
            text="A page is easy to read when the eye never has to search: lines short enough to follow back, space between paragraphs that says where a thought ends, and nothing beside the text asking to be looked at."
          />
          <ui::Text
            in={col}
            size={TX_HEADLINE}
            wrap
            color_by=>{lg::surface().ink}
            text="Most of the work happens before a single word is styled. Choose the measure first, then let the type size and the leading follow from it."
          />
        })
      })
    })

    page.show(fn() { !is_reader() }, fn(w : view::View) -> Unit {
      let _ = w.fill()
      match backdrop {
        DemoBackdrop::ColorfulPoster => {
          let _ = w.ground(view::Live::Is(0x1E1B4BFFL))
          let _ = ui::scroll_box(w, fn(col : view::View) -> Unit {
            let _ = col.padding(view::Live::Is((SP_24, SP_24, SP_24, SP_24))).gap(view::Live::Is(SP_16))
            <ui::Row in={col} gap={SP_16} rigid>
              <ui::Box fill height={SP_160} radius={SP_16} pad={SP_20} bg_by=>{0x9F1239FFL} gap={SP_6}>
                <ui::Text size={TX_HEADLINE} weight={700} color_by=>{0xFFFFFFFFL} text="Autumn Editions" />
                <ui::Text size={TX_BODY} wrap color_by=>{0xFFFFFFFFL} text="Twelve new titles in cloth bindings, printed on uncoated paper." />
              </ui::Box>
              <ui::Box fill height={SP_160} radius={SP_16} pad={SP_20} bg_by=>{0x065F46FFL} gap={SP_6}>
                <ui::Text size={TX_HEADLINE} weight={700} color_by=>{0xFFFFFFFFL} text="Studio Hours" />
                <ui::Text size={TX_BODY} wrap color_by=>{0xFFFFFFFFL} text="Open Thursday to Sunday, ten until six. Walk-ins welcome." />
              </ui::Box>
            </ui::Row>
            <ui::Row in={col} gap={SP_16} rigid>
              <ui::Box fill height={SP_160} radius={SP_16} pad={SP_20} bg_by=>{0x9A3412FFL} gap={SP_6}>
                <ui::Text size={TX_HEADLINE} weight={700} color_by=>{0xFFFFFFFFL} text="Workshops" />
                <ui::Text size={TX_BODY} wrap color_by=>{0xFFFFFFFFL} text="Letterpress, binding and paper marbling, in small groups." />
              </ui::Box>
              <ui::Box fill height={SP_160} radius={SP_16} pad={SP_20} bg_by=>{0x1D4ED8FFL} gap={SP_6}>
                <ui::Text size={TX_HEADLINE} weight={700} color_by=>{0xFFFFFFFFL} text="Newsletter" />
                <ui::Text size={TX_BODY} wrap color_by=>{0xFFFFFFFFL} text="One letter a month about the books we are making." />
              </ui::Box>
            </ui::Row>
            <ui::Box in={col} height={SP_160} radius={SP_16} pad={SP_20} bg_by=>{0x6D28D9FFL} gap={SP_8} rigid>
              <ui::Text size={TX_TITLE3} weight={700} color_by=>{0xFFFFFFFFL} text="Visit the Shop" />
              <ui::Text size={TX_CALLOUT} wrap color_by=>{0xFFFFFFFFL} text="Every book in the catalogue, with shipping to most countries in five to seven days." />
            </ui::Box>
          })
        }
        _ => {
          // A plain article page: masthead, headline, byline and body copy.
          let _ = w.ground(view::Live::By(fn() { lg::surface().card }))
          let _ = ui::scroll_box(w, fn(col : view::View) -> Unit {
            let _ = col.padding(view::Live::Is((SP_0, SP_0, SP_0, SP_48)))
            let heading = match pane {
              PaneId::Primary => "Designing for Reading"
              PaneId::Secondary => "CSS Grid Layout Module Level 3"
            }
            let site = match pane {
              PaneId::Primary => "Field Notes"
              PaneId::Secondary => "CSS Working Group Drafts"
            }
            let primary = pane is PaneId::Primary
            let nav = if primary { ["Essays", "Archive", "About"] } else { ["Specifications", "Issues", "About"] }
            let kicker = if primary { "Typography" } else { "Editor's Draft" }
            let author = if primary { "Mara Lind" } else { "CSS Working Group" }
            let date = if primary { "November 24, 2026" } else { "Updated November 20, 2026" }
            let paras = if primary {
              [
                "A page is easy to read when the eye never has to search: lines short enough to follow back, space between paragraphs that says where a thought ends, and nothing beside the text asking to be looked at.",
                "Most of the work happens before a single word is styled. Choose the measure first — sixty to seventy-five characters — then let the type size and the leading follow from it.",
              ]
            } else {
              [
                "This module introduces masonry layout as an additional layout mode for CSS Grid containers.",
                "Masonry layout places items along one axis using the normal grid algorithm, while the other axis packs items tightly in order, filling gaps left by shorter items.",
              ]
            }
            let sub = if primary { "Start with the measure" } else { "Masonry layout" }
            let last = if primary {
              "A wide column tires the reader on the way back to the start of each line; a narrow one breaks phrases apart. The measure sets the rhythm the rest of the page keeps."
            } else {
              "The grid axis is defined as usual with grid-template-columns or grid-template-rows; the masonry axis is declared with the masonry keyword."
            }
            // Masthead
            let _ = col.box(fn(mast : view::View) -> Unit {
              let _ = mast
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Between))
              .padding(view::Live::Is((SP_32, SP_20, SP_32, SP_20)))
              .rigid()
              let _ = headless::button(
                mast,
                fn() { pane_action_label },
                fn(_e) -> Unit { emit(ShellIntent::SetPaneFocus(pane)) },
                fn(b : view::View, _btn : headless::Button) -> Unit {
                  let _ = b.radius(view::Live::Is(SP_8)).focus_ring_theme().min_height(view::Live::Is(Some(SP_40))).center()
                  let _ = <ui::Text in={b} size={TX_CALLOUT} weight={600} color_by=>{lg::surface().ink} text={site} />
                },
              )
              <ui::Row in={mast} gap={SP_20} rigid>
                <ui::Text size={TX_BODY} color_by=>{lg::surface().ink_secondary} text={nav[0]} />
                <ui::Text size={TX_BODY} color_by=>{lg::surface().ink_secondary} text={nav[1]} />
                <ui::Text size={TX_BODY} color_by=>{lg::surface().ink_secondary} text={nav[2]} />
              </ui::Row>
            })
            let _ = col.box(fn(rule : view::View) -> Unit {
              let _ = rule.height(view::Live::Is(Some(lg::hairline_w))).ground(view::Live::By(fn() { lg::surface().separator }))
            })
            // Article, held to a readable measure
            let _ = col.box(fn(wrap : view::View) -> Unit {
              let _ = wrap.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle)).padding(view::Live::Is((SP_32, SP_48, SP_32, SP_0)))
              let _ = wrap.box(fn(art : view::View) -> Unit {
                let _ = art.grow(view::Live::Is(1.0)).max_width(view::Live::Is(Some(SP_160 * 4.0))).gap(view::Live::Is(SP_16))
                <ui::Text in={art} size={TX_FOOTNOTE} weight={500} color_by=>{demo_kicker_ink(lg::is_dark())} text={kicker} />
                <ui::Text in={art} size={TX_TITLE1} weight={700} wrap color_by=>{lg::surface().ink} text={heading} />
                <ui::Row in={art} gap={SP_12} rigid>
                  <ui::Text size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text={author} />
                  <ui::Text size={TX_BODY} color_by=>{lg::surface().ink_secondary} text={date} />
                </ui::Row>
                <ui::Box in={art} height={SP_8} rigid />
                <ui::Text
                  in={art}
                  size={TX_HEADLINE}
                  wrap
                  color_by=>{lg::surface().ink}
                  text={paras[0]}
                />
                <ui::Text
                  in={art}
                  size={TX_HEADLINE}
                  wrap
                  color_by=>{lg::surface().ink}
                  text={paras[1]}
                />
                <ui::Text in={art} size={TX_TITLE3} weight={600} wrap color_by=>{lg::surface().ink} text={sub} />
                <ui::Text
                  in={art}
                  size={TX_HEADLINE}
                  wrap
                  color_by=>{lg::surface().ink}
                  text={last}
                />
              })
            })
          })
        }
      }
    })
  })
}

///| The demo article's section kicker: a deeper and a lighter system blue, because `lg::surface().accent`
///| (#007AFF) reaches only 4.0:1 on the white page at 12pt. #0058C4 is 6.6:1 on white (lg card, light);
///| #6CB4FF is 7.8:1 on #1C1C1E (lg card, dark). Both pass WCAG AA for body text. Callers pass lg's dark (the
///| page card's appearance, which a Space set to light or dark forces), not the app flag.
fn demo_kicker_ink(dark : Bool) -> Int64 {
  if dark { 0x6CB4FFFFL } else { 0x0058C4FFL }
}

///| Demo only (offscreen shots): the address palette as Cmd+T opens it in the app, empty and focused for a new
///| tab, listing what is open with the first row lit (the same `OmniSuggestState::update` rule the app uses, in
///| new-tab mode).
pub fn ShellController::demo_open_new_tab_palette(self : ShellController) -> Unit {
  self.omnibox_field.set("")
  self.omnibox_editing.set(true)
  self.omnibox_field.focus()
  let st = proto::OmniSuggestState::empty().update(
    "",
    ctrl_tab_summaries(self.tabs.untracked()),
    self.bookmark_items,
    self.history_items,
    new_tab=true,
  )
  self.omnibox_suggest.set(st)
  if st.open {
    self.exclusive.set(self.exclusive.untracked().open(ExclusiveKind::OmniboxSuggest, return_focus="omnibox"))
  }
}
