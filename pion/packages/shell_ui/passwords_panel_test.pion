///| Password manager surfaces: the Save / Update popover, the autofill dropdown over a focused field, and Settings ->
///| Privacy -> Passwords (search, show / hide, copy, delete), each through `ui::Tester` and the Apple UI gates.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn pwp_prompt(kind : String) -> proto::PasswordPromptState {
  proto::PasswordPromptState::{
    visible: true,
    prompt_id: "pp-1",
    kind,
    origin: "https://accounts.example.com",
    username: "ada@example.com",
    display_name: "accounts.example.com",
    password_len: 12,
  }
}

test "passwords: Save popover names the site, keeps the edited username, offers Never, and hides the password" {
  let events : Array[String] = []
  let open = signals::signal(true)
  let prompt = signals::signal(pwp_prompt("save"))
  let user_f = ui::Field::new()
  user_f.set("ada@example.com")
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_password_save_popover(root, PasswordSavePopoverProps::{
        open: fn() { open.get() },
        prompt: fn() { prompt.get() },
        username_field: user_f,
        trigger_anchor: fn() { None },
        fallback_capsule: fn() { AnchorRect::{ x: 8.0, y: 48.0, w: 232.0, h: 32.0 } },
        on_save: fn(u) { events.push("save:" + u) },
        on_never: fn() { events.push("never") },
        on_close: fn() {
          events.push("close")
          open.set(false)
        },
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(t.find("Save password?").is_some(), "titled Save password?")
  debug_assert(t.find("accounts.example.com").is_some(), "names the site")
  debug_assert(t.find(password_dots(12)).is_some(), "the password as twelve dots")
  debug_assert(t.find("ada@example.com").is_some(), "username in its field")
  debug_assert(t.get("Save").is_some() && t.get("Never").is_some() && t.get("Close Save password").is_some(), "Save, Never, Close")
  lg::assert_apple_ui(t, label="password_save_popover_light")
  // the person edits the username, then saves
  user_f.set("ada")
  t.frame(ms=16.0)
  t.press("Save")
  t.frame(ms=16.0)
  debug_assert(events.length() == 1 && events[0] == "save:ada", "Save with the edited username (\{events.length()})")
  t.press("Never")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "never", "Never")
  // an update prompt reads Update
  prompt.set(pwp_prompt("update"))
  t.frame(ms=16.0)
  debug_assert(t.find("Update password?").is_some() && t.get("Update").is_some(), "Update password? / Update")
  t.press("Close Save password")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(events[events.length() - 1] == "close", "Close is not now")
  debug_assert(t.find("Update password?").is_none(), "closed")
  // dark appearance passes the same gates
  lg::set_dark(Some(true))
  open.set(true)
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  lg::assert_apple_ui(t, label="password_save_popover_dark")
  lg::set_dark(Some(false))
  t.dispose()
}

test "passwords: password_dots stands for the length, at most sixteen" {
  debug_assert(password_dots(0) == "", "none")
  debug_assert(password_dots(3) == "\u{2022}\u{2022}\u{2022}", "three")
  debug_assert(password_dots(40) == password_dots(16), "capped")
  debug_assert(password_prompt_title(pwp_prompt("save")) == "Save password?", "save title")
  debug_assert(password_prompt_title(pwp_prompt("update")) == "Update password?", "update title")
}

test "passwords: the autofill dropdown sits under the field (above near the bottom) and stays in the window" {
  let f = AnchorRect::{ x: 400.0, y: 200.0, w: 320.0, h: 32.0 }
  let (x, y, w) = autofill_place(f, 3, 1280.0, 800.0)
  debug_assert(x == 400.0 && y == 236.0 && w == 320.0, "under the field, its width (\{x},\{y},\{w})")
  let (_, _, w2) = autofill_place(AnchorRect::{ ..f, w: 120.0 }, 3, 1280.0, 800.0)
  debug_assert(w2 == AUTOFILL_MIN_W, "at least the minimum width")
  let (_, y3, _) = autofill_place(AnchorRect::{ ..f, y: 740.0 }, 3, 1280.0, 800.0)
  debug_assert(y3 + 3.0 * AUTOFILL_ROW_H < 740.0, "above the field when there is no room below (\{y3})")
  let (x4, _, _) = autofill_place(AnchorRect::{ ..f, x: 1200.0 }, 3, 1280.0, 800.0)
  debug_assert(x4 + 320.0 <= 1272.0, "kept inside the window")
  debug_assert(autofill_row_count(2, true) == 4 && autofill_row_count(0, false) == 1, "rows")
}

test "passwords: autofill dropdown offers the site's logins, names another host's, generates, and manages" {
  let events : Array[String] = []
  let open = signals::signal(true)
  let gen = signals::signal(false)
  let sugg = [
    proto::AutofillSuggestion::{ id: "pw-1", origin: "https://www.example.com", username: "ada", display_name: "", exact: true },
    proto::AutofillSuggestion::{ id: "pw-2", origin: "https://accounts.example.com", username: "bob", display_name: "", exact: false },
  ]
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_autofill_dropdown(root, AutofillDropdownProps::{
        open: fn() { open.get() },
        field_rect: fn() { AnchorRect::{ x: 400.0, y: 200.0, w: 320.0, h: 32.0 } },
        suggestions: fn() { sugg },
        can_generate: fn() { gen.get() },
        on_pick: fn(id) { events.push("pick:" + id) },
        on_generate: fn() { events.push("generate") },
        on_manage: fn() { events.push("manage") },
        on_close: fn() {
          events.push("close")
          open.set(false)
        },
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  match t.get("Fill ada for www.example.com") {
    Some(d) => debug_assert(d.y >= 232.0 && d.x >= 400.0, "first row under the field (\{d.x},\{d.y})")
    None => debug_assert(false, "exact login offered")
  }
  debug_assert(t.get("Fill bob for accounts.example.com").is_some(), "same-site login offered")
  debug_assert(t.find("From accounts.example.com").is_some(), "another host's login names it")
  debug_assert(t.get("Generate strong password").is_none(), "no Generate on a login field")
  debug_assert(t.get("Manage passwords").is_some(), "Manage passwords")
  lg::assert_apple_ui(t, label="autofill_dropdown_light")
  t.press("Fill bob for accounts.example.com")
  t.frame(ms=16.0)
  debug_assert(events.length() == 1 && events[0] == "pick:pw-2", "picked the second")
  gen.set(true)
  t.frame(ms=16.0)
  t.press("Generate strong password")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "generate", "generate")
  t.press("Manage passwords")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "manage", "manage")
  lg::assert_apple_ui(t, label="autofill_dropdown_generate")
  // a press outside closes it
  t.click(20.0, 700.0)
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(events[events.length() - 1] == "close", "outside press closes")
  debug_assert(t.get("Manage passwords").is_none(), "gone")
  t.dispose()
}

fn pwp_item(id : String, origin : String, user : String) -> proto::PasswordItemSummary {
  proto::PasswordItemSummary::{
    id,
    origin,
    signon_realm: origin + "/",
    username: user,
    display_name: "",
    created_at: 0L,
    updated_at: 0L,
    last_used_at: 0L,
    times_used: 0,
  }
}

test "passwords: Settings -> Privacy lists saved logins; search, show / hide, copy and delete" {
  let events : Array[String] = []
  let items = signals::signal([
    pwp_item("pw-1", "https://github.com", "octo"),
    pwp_item("pw-2", "https://example.com", "ada"),
  ])
  let shown : signals::Signal[String] = signals::signal("")
  let search = ui::Field::new()
  // (Settings' own filter: only the Passwords group shows, at the top of the pane)
  let filter = ui::Field::new()
  filter.set("passwords")
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_settings_panel(
        root,
        SettingsPanelProps::{
          open: fn() { true },
          dark: fn() { false },
          active_tab: signals::signal(SETTINGS_TAB_PRIVACY),
          settings: fn() { proto::BrowserSettings::default() },
          clear_bookmarks: signals::signal(false),
          clear_history: signals::signal(true),
          clear_downloads: signals::signal(false),
          clear_boosts: signals::signal(false),
          filter_field: Some(filter),
          on_save_settings: fn(_s, _m) { () },
          on_step_zoom: fn(_d) { () },
          on_clear_browsing_data: fn(_sel) { () },
          on_close: fn() { () },
          migrate: None,
          atc: None,
          passwords: Some(SettingsPasswordsProps::{
            items: fn() { items.get() },
            search_field: search,
            revealed: fn(id) { if shown.get() == id { Some("hunter2-secret") } else { None } },
            on_show: fn(id) {
              events.push("show:" + id)
              shown.set(id)
            },
            on_hide: fn(id) {
              events.push("hide:" + id)
              shown.set("")
            },
            on_copy_username: fn(id) { events.push("copy_user:" + id) },
            on_copy_password: fn(id) { events.push("copy_pw:" + id) },
            on_delete: fn(id) {
              events.push("delete:" + id)
              let kept : Array[proto::PasswordItemSummary] = []
              for it in items.untracked() {
                if it.id != id {
                  kept.push(it)
                }
              }
              items.set(kept)
            },
            on_import: fn() { events.push("import") },
            on_export: fn() { events.push("export") },
          }),
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  debug_assert(t.find("Passwords").is_some(), "Passwords group")
  debug_assert(t.get("octo on github.com").is_some() && t.get("ada on example.com").is_some(), "both logins listed")
  debug_assert(t.find("2 saved logins, encrypted on this device.").is_some(), "count footnote")
  debug_assert(t.find("hunter2-secret").is_none(), "passwords hidden")
  debug_assert(t.find("Clear browsing data").is_none(), "the filter shows Passwords alone")
  lg::assert_apple_ui(t, label="settings_passwords_light")
  // show, then hide
  t.press("Show password of ada on example.com")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "show:pw-2", "show asked")
  debug_assert(t.find("hunter2-secret").is_some(), "the password shown")
  t.press("Hide password of ada on example.com")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 1] == "hide:pw-2" && t.find("hunter2-secret").is_none(), "hidden again")
  // copy
  t.press("Copy username of octo on github.com")
  t.press("Copy password of octo on github.com")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 2] == "copy_user:pw-1" && events[events.length() - 1] == "copy_pw:pw-1", "copies")
  // search
  search.set("GIT")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(t.get("octo on github.com").is_some() && t.get("ada on example.com").is_none(), "search filters")
  search.set("zzz")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(t.find("No saved login matches \u{201C}zzz\u{201D}.").is_some(), "no-match footnote")
  search.set("")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  // delete
  t.press("Delete ada on example.com")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(events[events.length() - 1] == "delete:pw-2", "delete asked")
  debug_assert(t.get("ada on example.com").is_none() && t.find("1 saved login, encrypted on this device.").is_some(), "one left")
  t.press("Import passwords")
  t.press("Export passwords")
  t.frame(ms=16.0)
  debug_assert(events[events.length() - 2] == "import" && events[events.length() - 1] == "export", "import / export")
  lg::assert_apple_ui(t, label="settings_passwords_after")
  t.dispose()
}
