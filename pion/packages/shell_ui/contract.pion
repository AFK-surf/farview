///| Mounts a primary or secondary web/reader stage inside the ShellFrame.
pub struct PaneSlot {
  pub mount : (view::View, PaneId) -> Unit
}

pub fn PaneSlot::new(mount : (view::View, PaneId) -> Unit) -> PaneSlot {
  PaneSlot::{ mount }
}

pub struct ShellFavoriteItem {
  pub id : String
  pub title : String
  pub url : String
  pub monogram : String
  pub accent_rgba : Int64
}

impl view::ViewEq for ShellFavoriteItem {
  fn eq(self : ShellFavoriteItem, other : ShellFavoriteItem) -> Bool {
    self.id == other.id &&
    self.title == other.title &&
    self.url == other.url &&
    self.monogram == other.monogram &&
    self.accent_rgba == other.accent_rgba
  }
}

pub struct ShellTabItem {
  pub id : String
  pub title : String
  pub url : String
  pub folder_id : String
  pub space_id : String
  pub pinned : Bool
  pub active : Bool
  pub playing_audio : Bool
  pub muted : Bool
}

impl view::ViewEq for ShellTabItem {
  fn eq(self : ShellTabItem, other : ShellTabItem) -> Bool {
    self.id == other.id &&
    self.title == other.title &&
    self.url == other.url &&
    self.folder_id == other.folder_id &&
    self.space_id == other.space_id &&
    self.pinned == other.pinned &&
    self.active == other.active &&
    self.playing_audio == other.playing_audio &&
    self.muted == other.muted
  }
}

pub struct ShellFolderItem {
  pub id : String
  pub name : String
  pub collapsed : Bool
}

impl view::ViewEq for ShellFolderItem {
  fn eq(self : ShellFolderItem, other : ShellFolderItem) -> Bool {
    self.id == other.id && self.name == other.name && self.collapsed == other.collapsed
  }
}

pub struct ShellSpaceItem {
  pub id : String
  pub name : String
  pub accent_rgba : Int64
}

impl view::ViewEq for ShellSpaceItem {
  fn eq(self : ShellSpaceItem, other : ShellSpaceItem) -> Bool {
    self.id == other.id && self.name == other.name && self.accent_rgba == other.accent_rgba
  }
}

///| Keyed reactive row for Omnibox suggestions (`View::each`).
pub struct ShellOmniboxRow {
  pub key : String
  pub idx : Int
  pub section_header : String
  pub title : String
  pub subtitle : String
  pub badge_label : String
  pub icon_name : String
  pub url : String
  pub tab_id : String
}

impl view::ViewEq for ShellOmniboxRow {
  fn eq(self : ShellOmniboxRow, other : ShellOmniboxRow) -> Bool {
    self.key == other.key &&
    self.idx == other.idx &&
    self.section_header == other.section_header &&
    self.title == other.title &&
    self.subtitle == other.subtitle &&
    self.badge_label == other.badge_label &&
    self.icon_name == other.icon_name &&
    self.url == other.url &&
    self.tab_id == other.tab_id
  }
}

pub fn build_omnibox_rows(items : Array[proto::OmniSuggestItem]) -> Array[ShellOmniboxRow] {
  let out : Array[ShellOmniboxRow] = []
  let mut i = 0
  while i < items.length() {
    let it = items[i]
    let sec = match proto::omni_suggest_section_header(items, i) {
      Some(s) => s
      None => ""
    }
    let icon_name = match it.category {
      proto::OmniSuggestCategory::SwitchTab => ICON_LAYERS
      proto::OmniSuggestCategory::Bookmark => ICON_STAR_FILLED
      proto::OmniSuggestCategory::History => ICON_CLOCK
      proto::OmniSuggestCategory::Calc => ICON_ZAP
      proto::OmniSuggestCategory::SiteSearch => ICON_SEARCH
      proto::OmniSuggestCategory::DirectUrl => ICON_GLOBE
      proto::OmniSuggestCategory::Search => ICON_SEARCH
    }
    let key = if it.tab_id != "" { "tab:" + it.tab_id } else { "url:" + it.url + ":" + i.to_string() }
    out.push(ShellOmniboxRow::{
      key,
      idx: i,
      section_header: sec,
      title: it.title,
      subtitle: it.subtitle,
      badge_label: it.badge_label,
      icon_name,
      url: it.url,
      tab_id: it.tab_id,
    })
    i += 1
  }
  out
}

