///| Classifies URL security/edit state reactively.
pub fn classify_omnibox_security(url : String, editing : Bool) -> OmniboxSecurity {
  if editing {
    return OmniboxSecurity::EditingSearch
  }
  let u = url.trim()
  if u.starts_with("https://") {
    OmniboxSecurity::SecureHttps
  } else if u.starts_with("http://") {
    OmniboxSecurity::InsecureHttp
  } else {
    OmniboxSecurity::InternalPage
  }
}

///| Read-only reactive view model consumed by `ShellFrame`.
///| Zero global singletons: every instance owns its own signals.
pub struct ShellModel {
  pub url : () -> String
  pub title : () -> String
  pub secondary_url : () -> String
  pub secondary_title : () -> String
  pub active_url : () -> String
  pub active_title : () -> String
  pub loading : () -> Bool
  pub can_back : () -> Bool
  pub can_forward : () -> Bool
  pub omnibox_security : () -> OmniboxSecurity
  pub omnibox_editing : () -> Bool
  pub dark : () -> Bool
  pub dock : () -> DockState
  pub page : () -> PageLayoutState
  pub exclusive : () -> ExclusiveState
  pub passive : () -> PassiveState
  pub omnibox_field : ui::Field
  pub omnibox_suggest : () -> proto::OmniSuggestState
  pub favorites : () -> Array[ShellFavoriteItem]
  pub folders : () -> Array[ShellFolderItem]
  pub tabs : () -> Array[ShellTabItem]
  pub spaces : () -> Array[ShellSpaceItem]
  pub active_space_id : () -> String
  pub mini_player : () -> proto::MiniPlayerState
  pub window_inset_override : Option[Double]
}

///| Stateful controller backing `ShellModel` + `emit : (ShellIntent) -> Unit`
///| for interactive slices, unit tests, and offscreen shots.
pub struct ShellController {
  pub url : signals::Signal[String]
  pub title : signals::Signal[String]
  pub secondary_url : signals::Signal[String]
  pub secondary_title : signals::Signal[String]
  pub loading : signals::Signal[Bool]
  pub can_back : signals::Signal[Bool]
  pub can_forward : signals::Signal[Bool]
  pub omnibox_editing : signals::Signal[Bool]
  pub dark : signals::Signal[Bool]
  pub dock : signals::Signal[DockState]
  pub page : signals::Signal[PageLayoutState]
  pub exclusive : signals::Signal[ExclusiveState]
  pub passive : signals::Signal[PassiveState]
  pub omnibox_field : ui::Field
  pub omnibox_suggest : signals::Signal[proto::OmniSuggestState]
  pub omnibox_gate : signals::Signal[OmniboxRequestGate]
  pub favorites : signals::Signal[Array[ShellFavoriteItem]]
  pub folders : signals::Signal[Array[ShellFolderItem]]
  pub tabs : signals::Signal[Array[ShellTabItem]]
  pub spaces : signals::Signal[Array[ShellSpaceItem]]
  pub active_space_id : signals::Signal[String]
  pub mini_player : signals::Signal[proto::MiniPlayerState]
  pub last_intent : signals::Signal[String]
  pub dispatched_omnibox_queries : Array[String]
  pub history_items : Array[proto::HistoryItemSummary]
  pub bookmark_items : Array[proto::BookmarkEntry]
  pub next_tab_seq : signals::Ref[Int]
  pub next_folder_seq : signals::Ref[Int]
  pub window_inset_override : Option[Double]
}

pub fn ShellController::active_url_now(self : ShellController) -> String {
  match self.page.untracked().active_pane {
    PaneId::Primary => self.url.untracked()
    PaneId::Secondary => self.secondary_url.untracked()
  }
}

pub fn ShellController::active_safe_url_now(self : ShellController) -> String {
  proto::omnibox_safe_display_url(self.active_url_now())
}

pub fn ShellController::model(self : ShellController) -> ShellModel {
  let active_url_fn = fn() -> String {
    match self.page.get().active_pane {
      PaneId::Primary => self.url.get()
      PaneId::Secondary => self.secondary_url.get()
    }
  }
  let active_title_fn = fn() -> String {
    match self.page.get().active_pane {
      PaneId::Primary => self.title.get()
      PaneId::Secondary => self.secondary_title.get()
    }
  }
  ShellModel::{
    url: fn() { self.url.get() },
    title: fn() { self.title.get() },
    secondary_url: fn() { self.secondary_url.get() },
    secondary_title: fn() { self.secondary_title.get() },
    active_url: active_url_fn,
    active_title: active_title_fn,
    loading: fn() { self.loading.get() },
    can_back: fn() { self.can_back.get() },
    can_forward: fn() { self.can_forward.get() },
    omnibox_security: fn() {
      let cur = active_url_fn()
      let safe = proto::omnibox_safe_display_url(cur)
      let editing = self.omnibox_editing.get() || self.omnibox_field.focused()
      // Security defense: NEVER show HTTPS lock if the field text differs from the verified safe display URL
      if editing || self.omnibox_field.text() != safe {
        OmniboxSecurity::EditingSearch
      } else {
        classify_omnibox_security(cur, false)
      }
    },
    omnibox_editing: fn() { self.omnibox_editing.get() },
    dark: fn() { self.dark.get() },
    dock: fn() { self.dock.get() },
    page: fn() { self.page.get() },
    exclusive: fn() { self.exclusive.get() },
    passive: fn() { self.passive.get() },
    omnibox_field: self.omnibox_field,
    omnibox_suggest: fn() { self.omnibox_suggest.get() },
    favorites: fn() { self.favorites.get() },
    folders: fn() { self.folders.get() },
    tabs: fn() { self.tabs.get() },
    spaces: fn() { self.spaces.get() },
    active_space_id: fn() { self.active_space_id.get() },
    mini_player: fn() { self.mini_player.get() },
    window_inset_override: self.window_inset_override,
  }
}

fn ctrl_tab_summaries(tabs : Array[ShellTabItem]) -> Array[proto::TabSummary] {
  let out : Array[proto::TabSummary] = []
  let mut i = 0
  while i < tabs.length() {
    let t = tabs[i]
    out.push(proto::TabSummary::{
      id: t.id,
      title: t.title,
      url: t.url,
      space_id: t.space_id,
      folder_id: t.folder_id,
      pinned: t.pinned,
      favorite: false,
      active: t.active,
      state: if t.playing_audio { "playing" } else { "idle" },
      last_active_secs: 1000L,
    })
    i += 1
  }
  out
}

fn ctrl_has_tab_id(tabs : Array[ShellTabItem], id : String) -> Bool {
  if id == "" {
    return false
  }
  let mut i = 0
  while i < tabs.length() {
    if tabs[i].id == id {
      return true
    }
    i += 1
  }
  false
}

fn ctrl_find_tab_id_by_url(tabs : Array[ShellTabItem], target_url : String) -> Option[String] {
  let want = target_url.trim()
  if want == "" {
    return None
  }
  let mut i = 0
  while i < tabs.length() {
    if tabs[i].url.trim() == want {
      return Some(tabs[i].id)
    }
    i += 1
  }
  None
}

fn ctrl_restore_omnibox_idle(self : ShellController) -> Unit {
  self.omnibox_editing.set(false)
  self.omnibox_field.set(self.active_safe_url_now())
  self.omnibox_field.let_go()
  self.omnibox_suggest.set(self.omnibox_suggest.untracked().close())
  self.omnibox_gate.set(self.omnibox_gate.untracked().close_suggestions())
}

fn ctrl_close_omnibox_if_open(self : ShellController) -> Unit {
  if self.omnibox_editing.untracked() || self.omnibox_suggest.untracked().open || (self.exclusive.untracked().active is ExclusiveKind::OmniboxSuggest) {
    ctrl_restore_omnibox_idle(self)
    let ex = self.exclusive.untracked()
    if ex.active is ExclusiveKind::OmniboxSuggest {
      self.exclusive.set(ex.begin_close())
    }
  }
}

fn ctrl_commit_omnibox_item(self : ShellController, item : proto::OmniSuggestItem) -> Unit {
  if item.category is proto::OmniSuggestCategory::SwitchTab {
    let tabs = self.tabs.untracked()
    let target_id = if ctrl_has_tab_id(tabs, item.tab_id) {
      Some(item.tab_id)
    } else {
      ctrl_find_tab_id_by_url(tabs, item.url)
    }
    match target_id {
      Some(tid) => {
        self.dispatch(ShellIntent::SelectTab(tid))
        self.dispatch(ShellIntent::OmniboxClose)
        return
      }
      None => ()
    }
  }
  // Normal navigation, or fallback when SwitchTab target is stale/closed (NEVER deactivates all tabs!)
  self.dispatch(ShellIntent::Navigate(item.url))
}

pub fn ShellController::dispatch(self : ShellController, intent : ShellIntent) -> Unit {
  match intent {
    ShellIntent::GoBack => {
      ctrl_close_omnibox_if_open(self)
      self.last_intent.set("back")
    }
    ShellIntent::GoForward => {
      ctrl_close_omnibox_if_open(self)
      self.last_intent.set("forward")
    }
    ShellIntent::Reload => {
      ctrl_close_omnibox_if_open(self)
      self.last_intent.set("reload")
    }
    ShellIntent::StopLoading => {
      ctrl_close_omnibox_if_open(self)
      self.loading.set(false)
      self.last_intent.set("stop")
    }
    ShellIntent::Navigate(raw) => {
      let norm = proto::omnibox_normalize_input(raw)
      if norm != "" {
        match self.page.untracked().active_pane {
          PaneId::Primary => self.url.set(norm)
          PaneId::Secondary => self.secondary_url.set(norm)
        }
        ctrl_restore_omnibox_idle(self)
        let ex = self.exclusive.untracked()
        if ex.active is ExclusiveKind::OmniboxSuggest {
          self.exclusive.set(ex.begin_close())
        }
        self.last_intent.set("navigate:" + norm)
      }
    }
    ShellIntent::SyncActiveUrl(pane, new_url, new_title) => {
      match pane {
        PaneId::Primary => {
          self.url.set(new_url)
          if new_title != "" {
            self.title.set(new_title)
          }
        }
        PaneId::Secondary => {
          self.secondary_url.set(new_url)
          if new_title != "" {
            self.secondary_title.set(new_title)
          }
        }
      }
      // Do NOT clobber the user's in-progress omnibox edit on async host navigation updates!
      if !self.omnibox_editing.untracked() && !self.omnibox_field.focused() && self.page.untracked().active_pane == pane {
        self.omnibox_field.set(proto::omnibox_safe_display_url(new_url))
      }
      self.last_intent.set("sync_url:" + new_url)
    }
    ShellIntent::OmniboxFocus => {
      // Set safe display URL BEFORE flipping `omnibox_editing = true` so mount-time auto-select (`pick(0, len)`)
      // is never wiped by a subsequent `set(...)` on programmatic `⌘L` / `OmniboxFocus`!
      self.omnibox_field.set(self.active_safe_url_now())
      self.omnibox_editing.set(true)
      self.last_intent.set("omnibox_focus")
    }
    ShellIntent::OmniboxBlur => {
      ctrl_restore_omnibox_idle(self)
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::OmniboxSuggest {
        self.exclusive.set(ex.begin_close())
      }
      self.last_intent.set("omnibox_blur")
    }
    ShellIntent::OmniboxEdit(q) => {
      self.omnibox_editing.set(true)
      let (next_gate, to_dispatch) = self.omnibox_gate.untracked().submit_query(q)
      self.omnibox_gate.set(next_gate)
      match to_dispatch {
        Some(dq) => self.dispatched_omnibox_queries.push(dq)
        None => ()
      }
      let trimmed = q.trim()
      if trimmed == "" {
        self.omnibox_suggest.set(self.omnibox_suggest.untracked().close())
        self.omnibox_gate.set(self.omnibox_gate.untracked().close_suggestions())
        let ex = self.exclusive.untracked()
        if ex.active is ExclusiveKind::OmniboxSuggest {
          self.exclusive.set(ex.begin_close())
        }
      } else {
        let next_s = self.omnibox_suggest.untracked().update(
          q,
          ctrl_tab_summaries(self.tabs.untracked()),
          self.bookmark_items,
          self.history_items,
          open=true,
        )
        self.omnibox_suggest.set(next_s)
        if next_s.open {
          self.exclusive.set(self.exclusive.untracked().open(ExclusiveKind::OmniboxSuggest, return_focus="omnibox"))
        }
      }
      self.last_intent.set("omnibox_edit:" + q)
    }
    ShellIntent::OmniboxResultsArrived(remote_items) => {
      let (next_gate, accepted, next_dispatch) = self.omnibox_gate.untracked().on_results(remote_items)
      self.omnibox_gate.set(next_gate)
      match next_dispatch {
        Some(nq) => self.dispatched_omnibox_queries.push(nq)
        None => ()
      }
      // Guard: never let late results clobber a newer non-Omnibox overlay (Drawer / Menu / Dialog)
      let cur_ex = self.exclusive.untracked()
      let overlay_allows_omnibox = (cur_ex.active is ExclusiveKind::None) || (cur_ex.active is ExclusiveKind::OmniboxSuggest)
      match accepted {
        Some(items) if next_gate.suggestions_open && overlay_allows_omnibox => {
          let tabs_now = self.tabs.untracked()
          let converted : Array[proto::OmniSuggestItem] = []
          let mut i = 0
          while i < items.length() {
            let it = items[i]
            let cat = if it.switch_to_tab {
              proto::OmniSuggestCategory::SwitchTab
            } else {
              proto::OmniSuggestCategory::History
            }
            let resolved_tab_id = if it.switch_to_tab {
              match ctrl_find_tab_id_by_url(tabs_now, it.url) {
                Some(tid) => tid
                None => ""
              }
            } else {
              ""
            }
            converted.push(proto::OmniSuggestItem::{
              category: cat,
              title: if it.title != "" { it.title } else { proto::omnibox_display_host(it.url) },
              url: it.url,
              subtitle: proto::omnibox_display_host(it.url),
              badge_label: proto::omni_suggest_category_badge(cat),
              section_title: proto::omni_suggest_category_section(cat),
              tab_id: resolved_tab_id,
              visits: it.visits,
              score: it.score,
            })
            i += 1
          }
          if converted.length() > 0 {
            self.omnibox_suggest.set(proto::OmniSuggestState::{
              open: true,
              query: next_gate.latest_desired,
              items: converted,
              selected: 0,
            })
            self.exclusive.set(cur_ex.open(ExclusiveKind::OmniboxSuggest, return_focus="omnibox"))
          }
        }
        _ => ()
      }
    }
    ShellIntent::OmniboxSubmit(raw) => {
      let st = self.omnibox_suggest.untracked()
      if st.open {
        match st.resolve_enter() {
          Some(item) => {
            ctrl_commit_omnibox_item(self, item)
            return
          }
          None => ()
        }
      }
      let target = proto::omnibox_normalize_input(raw)
      if target != "" {
        self.dispatch(ShellIntent::Navigate(target))
      }
    }
    ShellIntent::OmniboxMoveSelection(delta) => {
      let st = self.omnibox_suggest.untracked()
      if st.open {
        self.omnibox_suggest.set(if delta >= 0 { st.move_down() } else { st.move_up() })
      }
    }
    ShellIntent::OmniboxSelectIndex(idx) => {
      let st = self.omnibox_suggest.untracked()
      if idx >= 0 && idx < st.items.length() {
        ctrl_commit_omnibox_item(self, st.items[idx])
      }
    }
    ShellIntent::OmniboxEscape => {
      ctrl_restore_omnibox_idle(self)
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::OmniboxSuggest {
        self.exclusive.set(ex.begin_close())
      }
      self.last_intent.set("omnibox_escape")
    }
    ShellIntent::OmniboxClose => {
      ctrl_restore_omnibox_idle(self)
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::OmniboxSuggest {
        self.exclusive.set(ex.begin_close())
      }
      self.last_intent.set("omnibox_close")
    }
    ShellIntent::ToggleSidebar => {
      ctrl_close_omnibox_if_open(self)
      let d = self.dock.untracked()
      self.dock.set(DockState::{ ..d, sidebar_open: !d.sidebar_open })
      self.last_intent.set("toggle_sidebar")
    }
    ShellIntent::ToggleNarrowSidebar => {
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::SidebarDrawer {
        self.exclusive.set(ex.begin_close())
      } else {
        ctrl_close_omnibox_if_open(self)
        self.exclusive.set(self.exclusive.untracked().open(ExclusiveKind::SidebarDrawer, return_focus="sidebar_btn"))
      }
      self.last_intent.set("toggle_narrow_sidebar")
    }
    ShellIntent::ToggleSplitView => {
      ctrl_close_omnibox_if_open(self)
      let (next_p, _) = self.page.untracked().toggle_split()
      self.page.set(next_p)
      if !self.omnibox_editing.untracked() {
        self.omnibox_field.set(self.active_safe_url_now())
      }
      self.last_intent.set("toggle_split")
    }
    ShellIntent::SwapSplitPanes => {
      ctrl_close_omnibox_if_open(self)
      self.page.set(self.page.untracked().swap_panes())
      self.last_intent.set("swap_split")
    }
    ShellIntent::SoloActivePane => {
      ctrl_close_omnibox_if_open(self)
      let p = self.page.untracked()
      if p.active_pane is PaneId::Secondary {
        let su = self.secondary_url.untracked()
        let st = self.secondary_title.untracked()
        if su != "" {
          self.url.set(su)
        }
        if st != "" {
          self.title.set(st)
        }
      }
      self.dispatch(ShellIntent::CloseSecondaryPane)
      self.last_intent.set("solo_active_pane")
    }
    ShellIntent::SetSplitRatio(r) => {
      self.page.set(self.page.untracked().set_ratio(r))
    }
    ShellIntent::OpenPeek(u) => {
      ctrl_close_omnibox_if_open(self)
      let (next_p, _) = self.page.untracked().open_peek()
      self.secondary_url.set(u)
      self.page.set(next_p)
      self.last_intent.set("open_peek:" + u)
    }
    ShellIntent::PromotePeekToSplit => {
      ctrl_close_omnibox_if_open(self)
      let (next_p, _) = self.page.untracked().promote_peek_to_split()
      self.page.set(next_p)
      self.last_intent.set("promote_peek")
    }
    ShellIntent::PeekGoBack => {
      self.last_intent.set("peek_back")
    }
    ShellIntent::PeekGoForward => {
      self.last_intent.set("peek_forward")
    }
    ShellIntent::PeekCopyUrl => {
      self.last_intent.set("peek_copy_url:" + self.secondary_url.untracked())
    }
    ShellIntent::PeekExpandToTab => {
      let u = self.secondary_url.untracked()
      self.dispatch(ShellIntent::CloseSecondaryPane)
      if u != "" {
        self.dispatch(ShellIntent::Navigate(u))
      }
      self.last_intent.set("peek_expand:" + u)
    }
    ShellIntent::CloseSecondaryPane => {
      ctrl_close_omnibox_if_open(self)
      let (next_p, _) = self.page.untracked().with_layout(PageLayout::Single)
      self.page.set(next_p)
      if !self.omnibox_editing.untracked() {
        self.omnibox_field.set(proto::omnibox_safe_display_url(self.url.untracked()))
      }
      self.last_intent.set("close_secondary")
    }
    ShellIntent::ToggleReaderMode(pane) => {
      ctrl_close_omnibox_if_open(self)
      let p = self.page.untracked()
      let cur = match pane {
        PaneId::Primary => p.primary_surface
        PaneId::Secondary => p.secondary_surface
      }
      let next_s = match cur {
        PaneSurface::Reader => PaneSurface::Web
        _ => PaneSurface::Reader
      }
      self.page.set(p.set_surface(pane, next_s))
      self.last_intent.set("toggle_reader")
    }
    ShellIntent::ToggleActiveReaderMode => {
      let active = self.page.untracked().active_pane
      self.dispatch(ShellIntent::ToggleReaderMode(active))
    }
    ShellIntent::SetPaneFocus(pane) => {
      ctrl_close_omnibox_if_open(self)
      let p = self.page.untracked()
      if p.active_pane != pane {
        self.page.set(PageLayoutState::{ ..p, active_pane: pane })
      }
      if !self.omnibox_editing.untracked() {
        self.omnibox_field.set(proto::omnibox_safe_display_url(match pane {
          PaneId::Primary => self.url.untracked()
          PaneId::Secondary => self.secondary_url.untracked()
        }))
      }
      self.last_intent.set(match pane {
        PaneId::Primary => "focus_pane:primary"
        PaneId::Secondary => "focus_pane:secondary"
      })
    }
    ShellIntent::SelectFavorite(id_or_url) => {
      let favs = self.favorites.untracked()
      let mut target_url = id_or_url
      let mut i = 0
      while i < favs.length() {
        if favs[i].id == id_or_url || favs[i].url == id_or_url {
          target_url = favs[i].url
          break
        }
        i += 1
      }
      if target_url != "" {
        self.dispatch(ShellIntent::Navigate(target_url))
      }
      self.last_intent.set("select_favorite:" + id_or_url)
    }
    ShellIntent::SelectTab(id) => {
      let cur = self.tabs.untracked()
      // Guard: if target tab id does not exist, do NOT deactivate all tabs!
      if !ctrl_has_tab_id(cur, id) {
        return
      }
      ctrl_close_omnibox_if_open(self)
      // Tabs belong to Primary pane: if Secondary pane was active in Split, focus Primary
      // so active_pane, visible page URL, Address Bar, and active tab ID stay strictly consistent!
      let p = self.page.untracked()
      if p.active_pane is PaneId::Secondary {
        self.page.set(PageLayoutState::{ ..p, active_pane: PaneId::Primary })
      }
      let next : Array[ShellTabItem] = []
      let mut i = 0
      while i < cur.length() {
        let t = cur[i]
        let is_hit = t.id == id
        if is_hit {
          self.url.set(t.url)
          self.title.set(t.title)
          self.omnibox_editing.set(false)
          self.omnibox_field.set(proto::omnibox_safe_display_url(t.url))
        }
        next.push(ShellTabItem::{ ..t, active: is_hit })
        i += 1
      }
      self.tabs.set(next)
      self.last_intent.set("select_tab:" + id)
    }
    ShellIntent::CloseTab(id) => {
      ctrl_close_omnibox_if_open(self)
      let cur = self.tabs.untracked()
      let next : Array[ShellTabItem] = []
      let mut i = 0
      while i < cur.length() {
        if cur[i].id != id {
          next.push(cur[i])
        }
        i += 1
      }
      self.tabs.set(next)
      self.last_intent.set("close_tab:" + id)
    }
    ShellIntent::NewTab => {
      ctrl_close_omnibox_if_open(self)
      let p = self.page.untracked()
      if p.active_pane is PaneId::Secondary {
        self.page.set(PageLayoutState::{ ..p, active_pane: PaneId::Primary })
      }
      let cur = self.tabs.untracked()
      let next : Array[ShellTabItem] = []
      let mut i = 0
      while i < cur.length() {
        next.push(ShellTabItem::{ ..cur[i], active: false })
        i += 1
      }
      let seq = self.next_tab_seq.v
      self.next_tab_seq.v = seq + 1
      let new_id = "tab-" + seq.to_string()
      let sid = self.active_space_id.untracked()
      next.push(ShellTabItem::{
        id: new_id,
        title: "New Tab",
        url: "about:start",
        folder_id: "",
        space_id: sid,
        pinned: false,
        active: true,
        playing_audio: false,
        muted: false,
      })
      self.tabs.set(next)
      self.url.set("about:start")
      self.title.set("New Tab")
      self.omnibox_editing.set(false)
      self.omnibox_field.set("about:start")
      self.last_intent.set("new_tab:" + new_id)
    }
    ShellIntent::CreateFolder(name) => {
      ctrl_close_omnibox_if_open(self)
      let cur = self.folders.untracked()
      let next = cur.copy()
      let seq = self.next_folder_seq.v
      self.next_folder_seq.v = seq + 1
      let fid = "folder-" + seq.to_string()
      next.push(ShellFolderItem::{ id: fid, name, collapsed: false })
      self.folders.set(next)
      self.last_intent.set("create_folder:" + name)
    }
    ShellIntent::ToggleFolder(fid) => {
      ctrl_close_omnibox_if_open(self)
      let cur = self.folders.untracked()
      let next : Array[ShellFolderItem] = []
      let mut i = 0
      while i < cur.length() {
        let f = cur[i]
        if f.id == fid {
          next.push(ShellFolderItem::{ ..f, collapsed: !f.collapsed })
        } else {
          next.push(f)
        }
        i += 1
      }
      self.folders.set(next)
    }
    ShellIntent::SelectSpace(sid) => {
      ctrl_close_omnibox_if_open(self)
      self.active_space_id.set(sid)
      self.last_intent.set("space:" + sid)
    }
    ShellIntent::ToggleDrawer => {
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::Drawer {
        self.exclusive.set(ex.begin_close())
      } else {
        ctrl_restore_omnibox_idle(self)
        self.exclusive.set(ex.open(ExclusiveKind::Drawer, return_focus="drawer_btn"))
      }
    }
    ShellIntent::CloseExclusive => {
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::OmniboxSuggest {
        ctrl_restore_omnibox_idle(self)
      }
      self.exclusive.set(ex.begin_close())
    }
    ShellIntent::OpenMoreMenu => {
      ctrl_restore_omnibox_idle(self)
      self.exclusive.set(self.exclusive.untracked().open(ExclusiveKind::Menu, return_focus="more_btn"))
    }
    ShellIntent::CloseMoreMenu => {
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::Menu {
        self.exclusive.set(ex.begin_close())
      }
    }
    ShellIntent::ToggleDarkTheme => {
      let next = !self.dark.untracked()
      self.dark.set(next)
      self.last_intent.set(if next { "theme:dark" } else { "theme:light" })
    }
    ShellIntent::MediaTogglePlay => {
      self.mini_player.set(self.mini_player.untracked().toggle_play())
      self.last_intent.set("media:play")
    }
    ShellIntent::MediaToggleMute => {
      self.mini_player.set(self.mini_player.untracked().toggle_mute())
      self.last_intent.set("media:mute")
    }
    ShellIntent::MediaJumpToTab => {
      match self.mini_player.untracked().jump_to_tab() {
        Some(tid) => self.dispatch(ShellIntent::SelectTab(tid))
        None => ()
      }
    }
    ShellIntent::MediaDismiss => {
      self.mini_player.set(self.mini_player.untracked().dismiss())
      self.last_intent.set("media:dismiss")
    }
    ShellIntent::CaptureCopyPath => {
      let p = self.passive.untracked()
      self.passive.set(PassiveState::{
        ..p,
        toast_visible: true,
        toast_title: "Copied Capture Path",
        toast_subtitle: p.capture_sheet.filename,
        toast_kind: ToastKind::Success,
      })
      self.last_intent.set("capture:copy")
    }
    ShellIntent::CaptureRevealFile => {
      self.last_intent.set("capture:reveal")
    }
    ShellIntent::CaptureDismiss => {
      let p = self.passive.untracked()
      self.passive.set(PassiveState::{ ..p, capture_sheet_open: false })
      self.last_intent.set("capture:dismiss")
    }
    ShellIntent::TogglePerfHud => {
      let p = self.passive.untracked()
      self.passive.set(PassiveState::{ ..p, perf_hud_open: !p.perf_hud_open })
    }
    ShellIntent::OpenDialog => {
      ctrl_restore_omnibox_idle(self)
      self.exclusive.set(self.exclusive.untracked().open(ExclusiveKind::Dialog, return_focus="more_btn"))
    }
    ShellIntent::CloseDialog => {
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::Dialog {
        self.exclusive.set(ex.begin_close())
      }
    }
    ShellIntent::EscapePressed => {
      let ex = self.exclusive.untracked()
      if ex.active is ExclusiveKind::OmniboxSuggest {
        self.dispatch(ShellIntent::OmniboxEscape)
      } else if ex.is_open() {
        self.dispatch(ShellIntent::CloseExclusive)
      } else {
        let (next_p, handled) = dismiss_top_passive(self.passive.untracked())
        if handled {
          self.passive.set(next_p)
        }
      }
    }
  }
}
