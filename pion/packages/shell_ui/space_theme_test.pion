///| Space theme: frame painting (accent-only Spaces unchanged, gradients, grain, forced appearance, contrast) and the
///| theme editor (drag, keyboard, add / remove, appearance, presets, grain, intensity, Escape, audits).

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn st_theme_of(ctrl : ShellController) -> proto::SpaceTheme {
  let sid = ctrl.active_space_id.untracked()
  for sp in ctrl.spaces.untracked() {
    if sp.id == sid {
      return if sp.theme.is_unset() { proto::space_theme_from_accent(proto::space_theme_hex(sp.accent_rgba)) } else { sp.theme }
    }
  }
  proto::space_theme_unset()
}

fn st_set_theme(ctrl : ShellController, t : proto::SpaceTheme) -> Unit {
  let sid = ctrl.active_space_id.untracked()
  let out : Array[ShellSpaceItem] = []
  for sp in ctrl.spaces.untracked() {
    out.push(if sp.id == sid { ShellSpaceItem::{ ..sp, theme: t, accent_rgba: t.points[0].rgba } } else { sp })
  }
  ctrl.spaces.set(out)
}

struct StRig {
  t : ui::Tester
  ctrl : ShellController
  open : signals::Signal[Bool]
  changes : Array[proto::SpaceTheme]
  root : signals::Ref[Option[view::View]]
}

fn st_rig(dark~ : Bool = false, open~ : Bool = true, width~ : Double = 1280.0, drop~ : Bool = false) -> StRig {
  space_theme_preview.set(None)
  let ctrl = make_demo_controller(dark=dark)
  let open_sig = signals::signal(open)
  let changes : Array[proto::SpaceTheme] = []
  let root_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      root_ref.v = Some(root)
      let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
        build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) })
      })
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
      build_space_theme_editor(
        root,
        SpaceThemeEditorProps::{
          open: fn() { open_sig.get() },
          space_id: fn() { ctrl.active_space_id.get() },
          theme: fn() {
            let _ = ctrl.spaces.get()
            st_theme_of(ctrl)
          },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 16.0, y: 756.0, w: 160.0, h: 32.0 }) },
          name_field: None,
          on_rename: fn(_sid, _name) { () },
          on_change: fn(_sid, th) {
            changes.push(th)
            // `drop`: an app that never takes the change (the Space went away, the wire is down).
            if !drop {
              st_set_theme(ctrl, th)
            }
          },
          on_close: fn() { open_sig.set(false) },
        },
      )
    },
    width=width,
    height=800.0,
    theme=lg::ui_theme,
    dark=dark,
  )
  let mut i = 0
  while i < 20 {
    t.frame(ms=16.0)
    i += 1
  }
  StRig::{ t, ctrl, open: open_sig, changes, root: root_ref }
}

fn st_settle(t : ui::Tester) -> Unit {
  let mut i = 0
  while i < 20 {
    t.frame(ms=16.0)
    i += 1
  }
}

fn st_center(t : ui::Tester, label : String) -> (Double, Double) {
  match t.get(label) {
    Some(d) => (d.x + d.w / 2.0, d.y + d.h / 2.0)
    None => {
      debug_assert(false, "found " + label)
      (0.0, 0.0)
    }
  }
}

fn st_root_ground(rig : StRig) -> Int64 {
  match rig.root.v {
    Some(r) => {
      for d in rig.t.drawn() {
        if d.id == r.id() {
          return d.ground
        }
      }
      0L
    }
    None => 0L
  }
}

test "space theme frame: accent-only Space paints exactly the old tint, light and dark" {
  let accents = [0x007AFFFFL, 0x34C759FFL, 0xAF52DEFFL, 0xF59E0BFFL, 0xEC4899FFL, 0x64748BFFL]
  for a in accents {
    for d in [false, true] {
      debug_assert(
        shell_theme_tint(a, d, proto::SPACE_THEME_DEFAULT_INTENSITY) == shell_frame_tint(a, d),
        "default intensity == old tint for " + proto::space_theme_hex(a),
      )
    }
  }
  let rig = st_rig(open=false)
  let model = rig.ctrl.model()
  debug_assert(shell_frame_color(model) == shell_frame_tint(0x007AFFFFL, false), "frame color as before")
  debug_assert(shell_space_accent(model) == 0x007AFFFFL, "accent as before")
  debug_assert(shell_space_frame_stops(model).length() == 1, "one stop: flat")
  debug_assert(st_root_ground(rig) == shell_frame_tint(0x007AFFFFL, false), "the window root paints the old tint")
  rig.t.dispose()
  let dark_rig = st_rig(dark=true, open=false)
  debug_assert(shell_frame_color(dark_rig.ctrl.model()) == shell_frame_tint(0x007AFFFFL, true), "dark frame as before")
  dark_rig.t.dispose()
}

test "space theme frame: gradient stops, intensity keeps sidebar ink contrast, grain layer" {
  let rig = st_rig(open=false)
  let three = proto::SpaceTheme::{
    points: [proto::space_theme_point_at(0.9, 0.3), proto::space_theme_point_at(0.1, 0.2), proto::space_theme_point_at(0.5, 0.5)],
    mode: proto::SpaceThemeMode::Auto,
    grain: 0.8,
    intensity: 0.6,
  }
  st_set_theme(rig.ctrl, three)
  st_settle(rig.t)
  let stops = shell_space_frame_stops(rig.ctrl.model())
  debug_assert(stops.length() == 3, "three stops")
  debug_assert(
    stops[0] == shell_theme_tint(proto::space_theme_color_at(0.9, 0.3), false, 0.6),
    "stops in point order: point 0 is the frame's ground",
  )
  debug_assert(shell_frame_color(rig.ctrl.model()) == stops[0], "frame base is the first stop")
  debug_assert(shell_space_accent(rig.ctrl.model()) == three.points[0].rgba, "the accent is the same point 0")
  // Grain: a layer of noise tiles drawn at the grain's strength.
  let mut tiles = 0
  for d in rig.t.drawn() {
    match d.image {
      Some(_) => if d.w == 256.0 { tiles += 1 }
      None => ()
    }
  }
  debug_assert(tiles >= 4, "grain tiles cover the window: " + tiles.to_string())
  rig.t.dispose()
  // Full intensity of strong colors never drops frame ink below 4.5:1.
  for c in [0xFFD60AFFL, 0x000080FFL, 0xFF2D55FFL, 0x34C759FFL, 0x111111FFL, 0xFFFFFFFFL] {
    for d in [false, true] {
      let f = shell_theme_tint(c, d, 1.0)
      debug_assert(ui::contrast_ratio(shell_frame_ink_secondary(d), f) >= 4.5, "secondary ink contrast")
      debug_assert(ui::contrast_ratio(lg::surface_light.ink, f) >= 4.5 || d, "ink contrast light")
      debug_assert(ui::contrast_ratio(lg::surface_dark.ink, f) >= 4.5 || !d, "ink contrast dark")
    }
  }
}

test "space theme editor: dragging a handle moves its point and recolors the frame at once" {
  let rig = st_rig()
  let t = rig.t
  let before = st_theme_of(rig.ctrl).points[0]
  let (hx, hy) = st_center(t, "Color 1")
  t.drag(hx, hy, hx + 60.0, hy + 30.0, steps=6)
  st_settle(t)
  let after = st_theme_of(rig.ctrl).points[0]
  debug_assert((after.x - (before.x + 60.0 / 304.0)).abs() < 0.02, "x follows the pointer exactly")
  debug_assert((after.y - (before.y + 30.0 / 304.0)).abs() < 0.02, "y follows the pointer exactly")
  debug_assert(after.rgba == proto::space_theme_color_at(after.x, after.y), "color is the canvas color there")
  debug_assert(rig.changes.length() == 1, "one commit, on release")
  debug_assert(shell_frame_color(rig.ctrl.model()) == shell_theme_tint(after.rgba, false, proto::SPACE_THEME_DEFAULT_INTENSITY), "frame follows")
  // Keyboard: arrows move the focused handle; the frame previews each step, the app gets one change after a pause.
  let p0 = st_theme_of(rig.ctrl).points[0]
  t.key(ui::key_code_right)
  t.key(ui::key_code_down)
  t.frame(ms=16.0)
  debug_assert(rig.changes.length() == 1, "held arrows send nothing yet")
  debug_assert(
    shell_frame_color(rig.ctrl.model()) ==
    shell_theme_tint(proto::space_theme_color_at(p0.x + 0.02, p0.y + 0.02), false, proto::SPACE_THEME_DEFAULT_INTENSITY),
    "the frame follows each step at once",
  )
  st_settle(t)
  let p1 = st_theme_of(rig.ctrl).points[0]
  debug_assert((p1.x - p0.x - 0.02).abs() < 0.001 && (p1.y - p0.y - 0.02).abs() < 0.001, "arrows move the focused handle")
  debug_assert(rig.changes.length() == 2, "one change for the steps: " + rig.changes.length().to_string())
  t.dispose()
}

test "space theme editor: live preview paints the frame before the app has the change" {
  let rig = st_rig()
  let t = rig.t
  space_theme_preview.set(Some(("work", proto::SpaceTheme::{ ..proto::space_theme_from_accent("#FF2D55"), intensity: 0.5 })))
  t.frame(ms=16.0)
  debug_assert(shell_frame_color(rig.ctrl.model()) == shell_theme_tint(0xFF2D55FFL, false, 0.5), "preview painted")
  space_theme_preview.set(None)
  t.dispose()
}

test "space theme editor: add and remove points, appearance forces dark, presets apply" {
  let rig = st_rig()
  let t = rig.t
  t.press("Add Color")
  st_settle(t)
  debug_assert(st_theme_of(rig.ctrl).points.length() == 2, "added a point")
  debug_assert(t.get("Color 2").is_some(), "its handle shows")
  t.press("Add Color")
  st_settle(t)
  debug_assert(st_theme_of(rig.ctrl).points.length() == 3, "three points")
  t.press("Add Color")
  st_settle(t)
  debug_assert(st_theme_of(rig.ctrl).points.length() == 3, "never more than three")
  debug_assert(shell_space_frame_stops(rig.ctrl.model()).length() == 3, "frame paints three stops")
  t.press("Remove Color")
  st_settle(t)
  debug_assert(st_theme_of(rig.ctrl).points.length() == 2, "removed a point")
  debug_assert(t.get("Color 3").is_none(), "its handle left")

  // Appearance: Dark forces the frame and lg dark while this Space is active; Automatic follows the app.
  t.press("Appearance Dark")
  st_settle(t)
  debug_assert(st_theme_of(rig.ctrl).mode.name() == "dark", "mode stored")
  debug_assert(shell_model_with_space_mode(rig.ctrl.model()).dark(), "forced dark")
  debug_assert(lg::is_dark(), "lg follows the forced appearance")
  t.press("Appearance Automatic")
  st_settle(t)
  debug_assert(!lg::is_dark(), "auto follows the app (light)")

  // Presets: page to a blend and apply it. A preset sets the colors only: appearance, grain, intensity stay.
  st_set_theme(rig.ctrl, proto::SpaceTheme::{ ..st_theme_of(rig.ctrl), mode: proto::SpaceThemeMode::Light, grain: 0.3, intensity: 0.7 })
  st_settle(t)
  t.press("Theme Blossom")
  st_settle(t)
  let after_preset = st_theme_of(rig.ctrl)
  debug_assert(after_preset.points.length() == 1 && after_preset.points[0].rgba == proto::space_theme_presets()[1].theme.points[0].rgba, "preset colors applied")
  debug_assert(after_preset.mode.name() == "light", "appearance kept")
  debug_assert((after_preset.grain - 0.3).abs() < 0.001 && (after_preset.intensity - 0.7).abs() < 0.001, "grain and intensity kept")
  debug_assert(t.get("Color 2").is_none() && t.get("Color 3").is_none(), "a one-color preset leaves one handle at once")
  debug_assert(t.get("Theme Sunset").is_none(), "second page not shown yet")
  t.press("More Themes")
  st_settle(t)
  t.press("Theme Sunset")
  st_settle(t)
  let mut sunset = proto::space_theme_presets()[0]
  for p in proto::space_theme_presets() {
    if p.key == "sunset" {
      sunset = p
    }
  }
  debug_assert(st_theme_of(rig.ctrl).points.length() == sunset.theme.points.length(), "blend preset applied")
  debug_assert(st_theme_of(rig.ctrl).points[2].rgba == sunset.theme.points[2].rgba, "with its colors")
  debug_assert(st_theme_of(rig.ctrl).points.length() == 3, "with its three points")
  t.dispose()
  lg::set_dark(Some(false))
}

test "space theme editor: grain and intensity change their values; Escape closes" {
  let rig = st_rig()
  let t = rig.t
  t.press("Grain")
  t.key(ui::key_code_right)
  t.key(ui::key_code_right)
  st_settle(t)
  let g = st_theme_of(rig.ctrl).grain
  debug_assert(g > 0.0, "grain went up: " + g.to_string())
  t.press("Intensity")
  let i0 = st_theme_of(rig.ctrl).intensity
  t.key(ui::key_code_page_up)
  st_settle(t)
  let i1 = st_theme_of(rig.ctrl).intensity
  debug_assert(i1 > i0, "intensity went up")
  debug_assert(shell_grain_alpha(st_theme_of(rig.ctrl).grain) > 0.0, "grain draws its layer")
  debug_assert(shell_grain_alpha(1.0) <= 0.5 && shell_grain_alpha(0.0) == 0.0, "full grain stays a subtle texture")
  // Dragging round the dial sets intensity by angle: straight up is the middle.
  let (dx, dy) = st_center(t, "Intensity")
  t.drag(dx, dy - 24.0, dx, dy - 26.0, steps=2)
  st_settle(t)
  debug_assert((st_theme_of(rig.ctrl).intensity - 0.5).abs() < 0.05, "dial top is half")
  t.key(ui::key_escape)
  st_settle(t)
  debug_assert(!rig.open.untracked(), "Escape closes")
  t.dispose()
}

test "space theme editor: Apple UI audits in light and dark, every control labelled" {
  for d in [false, true] {
    let rig = st_rig(dark=d)
    let t = rig.t
    lg::set_dark(Some(d))
    st_settle(t)
    for label in [
      "Space Theme", "Appearance Automatic", "Appearance Light", "Appearance Dark", "Color 1", "Add Color", "Remove Color",
      "Previous Themes", "More Themes", "Theme Paper", "Grain", "Intensity",
    ] {
      debug_assert(t.get(label).is_some(), "labelled: " + label)
    }
    lg::assert_apple_ui(t, label="space_theme_editor_" + (if d { "dark" } else { "light" }), allow_large_overlay=true)
    t.dispose()
  }
  lg::set_dark(Some(false))
}

fn st_face_of(t : ui::Tester, rgba : Int64) -> Option[view::Drawn] {
  for d in t.drawn() {
    if d.ground == rgba && d.edge.0 == 3.0 && d.w <= 31.0 {
      return Some(d)
    }
  }
  None
}

fn st_disabled(label : String) -> Bool {
  match ui::view_tree() {
    Some(tree) => {
      for sn in tree.said_order() {
        match sn.said {
          Some(sd) if sd.label == label => return sn.disabled
          _ => ()
        }
      }
      false
    }
    None => false
  }
}

test "space theme editor: − removes the picked point, which fades out where it was; no handle jumps" {
  for reduced in [false, true] {
    ui::set_reduced_motion(Some(reduced))
    let rig = st_rig()
    let t = rig.t
    debug_assert(st_disabled("Remove Color"), "− is off at one point")
    t.press("Add Color")
    st_settle(t)
    t.press("Add Color")
    st_settle(t)
    debug_assert(st_disabled("Add Color"), "+ is off at three points")
    debug_assert(!st_disabled("Remove Color"), "− is on")
    let (c2x, c2y) = st_center(t, "Color 2")
    // Pick the first handle (a press on it), then −: that point goes, not the last.
    let (c1x, c1y) = st_center(t, "Color 1")
    t.drag(c1x, c1y, c1x, c1y, steps=1)
    st_settle(t)
    let before = st_theme_of(rig.ctrl).points
    t.press("Remove Color")
    t.frame(ms=48.0)
    let now = st_theme_of(rig.ctrl).points
    debug_assert(now.length() == 2, "one point fewer")
    debug_assert(now[0].rgba == before[1].rgba && now[1].rgba == before[2].rgba, "the picked point went")
    // Mid-way: the removed color is still drawn where it was, fading (and shrinking unless motion is reduced).
    match st_face_of(t, before[0].rgba) {
      Some(d) => {
        let mut info = ""
        for e in t.drawn() {
          if e.ground == before[0].rgba {
            info = info + " [a" + e.alpha.to_string() + " w" + e.w.to_string() + " e" + e.edge.0.to_string() + "]"
          }
        }
        debug_assert(d.alpha > 0.0 && d.alpha < 1.0, "fading: " + d.alpha.to_string() + info + " reduced " + reduced.to_string())
        debug_assert((d.x + d.w / 2.0 - c1x).abs() < 1.0 && (d.y + d.h / 2.0 - c1y).abs() < 1.0, "in place")
        if reduced {
          debug_assert((d.w - 24.0).abs() < 0.01, "reduced motion: opacity only")
        } else {
          debug_assert(d.w < 24.0, "shrinks toward 0.9: " + d.w.to_string())
        }
      }
      None => {
        let mut info = ""
        for d in t.drawn() {
          if d.ground == before[0].rgba || d.edge.0 == 3.0 {
            info = info + " [" + d.ground.to_string() + " a" + d.alpha.to_string() + " w" + d.w.to_string() + " e" + d.edge.0.to_string() + "]"
          }
        }
        debug_assert(false, "the removed point fades out " + before[0].rgba.to_string() + info)
      }
    }
    // The color that was second is drawn exactly where it was (by the first slot now): nothing jumped.
    let (n1x, n1y) = st_center(t, "Color 1")
    debug_assert((n1x - c2x).abs() < 0.5 && (n1y - c2y).abs() < 0.5, "remaining handle stays put")
    st_settle(t)
    debug_assert(st_face_of(t, before[0].rgba).is_none(), "gone after the fade")
    debug_assert(t.get("Color 3").is_none(), "two handles")
    t.dispose()
  }
  ui::set_reduced_motion(None)
}

test "space theme editor: Delete on a focused handle removes it and focus moves to a handle left" {
  let rig = st_rig()
  let t = rig.t
  t.press("Add Color")
  st_settle(t)
  let (cx, cy) = st_center(t, "Color 2")
  t.drag(cx, cy, cx, cy, steps=1)
  st_settle(t)
  t.key(ui::key_code_delete)
  st_settle(t)
  debug_assert(st_theme_of(rig.ctrl).points.length() == 1, "removed")
  t.key(ui::key_code_right)
  st_settle(t)
  debug_assert(rig.changes.length() >= 3, "arrows still move a handle: focus moved to the one left")
  t.dispose()
}

test "space theme editor: the preview never outlives the editor" {
  // Closing during a change not yet sent: it is sent, and the preview is dropped.
  let rig = st_rig()
  let t = rig.t
  let (hx, hy) = st_center(t, "Color 1")
  t.drag(hx, hy, hx, hy, steps=1)
  st_settle(t)
  let n0 = rig.changes.length()
  t.key(ui::key_code_right)
  t.key(ui::key_escape)
  st_settle(t)
  debug_assert(!rig.open.untracked(), "closed")
  debug_assert(rig.changes.length() == n0 + 1, "the pending step was sent on close")
  debug_assert(space_theme_preview.untracked().is_none(), "preview dropped")
  t.dispose()
  // An app that drops the change: once closed, the frame paints the app's theme again.
  let lost = st_rig(drop=true)
  let lt = lost.t
  let base = shell_frame_color(lost.ctrl.model())
  lt.press("Theme Coral")
  st_settle(lt)
  debug_assert(shell_frame_color(lost.ctrl.model()) != base, "previewed while open")
  lost.open.set(false)
  st_settle(lt)
  debug_assert(space_theme_preview.untracked().is_none(), "preview dropped on close")
  debug_assert(shell_frame_color(lost.ctrl.model()) == base, "frame back to the app's theme")
  lt.dispose()
  // Another source changes the theme while nothing is pending: its value wins over a stale preview.
  let other = st_rig(drop=true)
  let ot = other.t
  ot.press("Theme Mint")
  st_settle(ot)
  st_set_theme(other.ctrl, proto::SpaceTheme::{ ..proto::space_theme_from_accent("#FF2D55"), intensity: 0.5 })
  st_settle(ot)
  debug_assert(space_theme_preview.untracked().is_none(), "stale preview dropped")
  debug_assert(shell_frame_color(other.ctrl.model()) == shell_theme_tint(0xFF2D55FFL, false, 0.5), "the new theme shows")
  ot.dispose()
}

test "space theme: switching from a forced-dark Space to an Auto one gives the app's appearance back" {
  let rig = st_rig(open=false)
  let t = rig.t
  let out : Array[ShellSpaceItem] = []
  for sp in rig.ctrl.spaces.untracked() {
    out.push(
      if sp.id == "personal" {
        ShellSpaceItem::{ ..sp, theme: proto::SpaceTheme::{ ..proto::space_theme_from_accent("#34C759"), mode: proto::SpaceThemeMode::Dark } }
      } else {
        sp
      },
    )
  }
  rig.ctrl.spaces.set(out)
  st_settle(t)
  let wrapped = shell_model_with_space_mode(rig.ctrl.model())
  debug_assert(!wrapped.dark() && !lg::is_dark(), "Auto Space in a light app: light")
  rig.ctrl.active_space_id.set("personal")
  st_settle(t)
  debug_assert(wrapped.dark() && lg::is_dark(), "forced-dark Space: dark frame and lg")
  debug_assert(shell_frame_color(rig.ctrl.model()) == shell_frame_tint(0x34C759FFL, false), "unwrapped model keeps the app flag")
  rig.ctrl.active_space_id.set("work")
  st_settle(t)
  debug_assert(!wrapped.dark() && !lg::is_dark(), "back to an Auto Space: the app's light again")
  t.dispose()
  lg::set_dark(Some(false))
}

test "space theme editor: no trigger (command bar, no sidebar) centers the panel" {
  space_theme_preview.set(None)
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_space_theme_editor(
        root,
        SpaceThemeEditorProps::{
          open: fn() { true },
          space_id: fn() { ctrl.active_space_id.get() },
          theme: fn() { proto::space_theme_from_accent("#007AFF") },
          trigger_anchor: fn() { None },
          name_field: None,
          on_rename: fn(_s, _n) { () },
          on_change: fn(_s, _t) { () },
          on_close: fn() { () },
        },
      )
    },
    width=480.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  st_settle(t)
  match t.get("Space Theme") {
    Some(d) => debug_assert((d.x + d.w / 2.0 - 240.0).abs() < 1.0 && (d.y + d.h / 2.0 - 400.0).abs() < 2.0, "centered")
    None => debug_assert(false, "panel shows")
  }
  t.dispose()
}
