///| Unit & motion tests for Little Arc window (`emil-design-eng` motion physics),
///| Arc frameless Peek floating action rail, and Arc Favorite active ring + Peek corner badge.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

test "Quick Window: Apple spring enter/exit motion, right-stage centering, Space switcher, and promote" {
  let open = signals::signal(false)
  let url = signals::signal("https://arc.net")
  let target_sp = signals::signal("work")
  let url_field = ui::Field::new()
  let promoted : signals::Ref[Option[(String, String)]] = ui::ref_new(None)
  let navigated : signals::Ref[String] = ui::ref_new("")

  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_little_arc_window(
        root,
        LittleArcProps::{
          open: fn() { open.get() },
          dark: fn() { false },
          stage_left: fn() { 248.0 },
          url: fn() { url.get() },
          title: fn() { "Quick Lookup" },
          spaces: fn() {
            [
              ShellSpaceItem::{ id: "work", name: "Work", accent_rgba: 0x007AFFFFL, theme: proto::space_theme_unset() },
              ShellSpaceItem::{ id: "life", name: "Life", accent_rgba: 0x10B981FFL, theme: proto::space_theme_unset() },
            ]
          },
          target_space_id: target_sp,
          url_field,
          on_navigate: fn(u) {
            navigated.v = u
            url.set(u)
          },
          on_promote: fn(u, sid) {
            promoted.v = Some((u, sid))
            open.set(false)
          },
          on_close: fn() { open.set(false) },
          content: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Open Quick Window after mount -> Apple spring bloom over ~240ms
  open.set(true)
  t.frame(ms=16.0)
  t.frame(ms=100.0)
  t.frame(ms=260.0)
  match t.get("Quick Window") {
    Some(d) => {
      // Centered relative to right page stage [248..1272] -> center ~ 760, NEVER overlapping sidebar (< 248)
      let cx = d.x + d.w / 2.0
      debug_assert(d.x >= 248.0, "Quick Window does not overlap docked sidebar")
      debug_assert((cx - 760.0).abs() < 4.0, "Quick Window centered over right page stage (cx=\{cx})")
    }
    None => debug_assert(false, "Quick Window visible")
  }
  debug_assert(t.get("Open in Work").is_some(), "Open in Work promote pill visible")
  debug_assert(t.get("Choose Space for Quick Window").is_some(), "Space chevron switcher visible")

  // Switch target Space to Life via anchored chevron popover
  t.press("Choose Space for Quick Window")
  t.frame(ms=16.0)
  t.frame(ms=160.0)
  t.press("Target Space Life")
  t.frame(ms=16.0)
  debug_assert(target_sp.untracked() == "life", "target Space switched to Life")
  debug_assert(t.get("Open in Life").is_some(), "promote pill updated to Open in Life")

  // Click Open in Life -> promotes URL to Life Space and closes smoothly
  t.press("Open in Life")
  t.frame(ms=16.0)
  match promoted.v {
    Some((u, sid)) => debug_assert(u == "https://arc.net" && sid == "life", "promoted URL into Life Space")
    None => debug_assert(false, "expected on_promote callback")
  }
  t.frame(ms=240.0)
  debug_assert(!open.untracked(), "Quick Window closed after promote")
  t.dispose()
}

test "Arc Peek: frameless card exposes outside top-right floating Close, Expand, and Split buttons" {
  lg::set_dark(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
        build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=DemoBackdrop::EditorialLight)
      })
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OpenPeek("https://thetype.com/"))
  t.frame(ms=16.0)
  t.frame(ms=240.0)
  let card = t.get("Secondary Pane")
  let close_btn = t.get("Close Peek")
  let expand_btn = t.get("Open in New Tab")
  let split_btn = t.get("Open in Split View")
  match (card, close_btn, expand_btn, split_btn) {
    (Some(c), Some(cl), Some(ex), Some(sp)) => {
      // Floating buttons MUST sit outside the right edge of the Peek card (Arc Image 4 geometry!)
      debug_assert(cl.x >= c.x + c.w, "Close Peek sits outside right edge of Peek card")
      debug_assert(ex.y > cl.y && sp.y > ex.y, "floating buttons stacked vertically: Close -> Expand -> Split")
    }
    _ => debug_assert(false, "expected Secondary Pane and all 3 outside floating Peek buttons")
  }
  t.dispose()
}
