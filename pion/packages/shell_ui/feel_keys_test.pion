///| Feel (g5): the page-load line out of flow, the tab title fading under its close button, the split divider's
///| drag target, press feedback on the More trigger, platform shortcut labels, and a hit-scan of the frame's
///| pressables. Each motion is sampled mid-way and at rest on the Tester clock.

import "hostapi"
import "lg"
import "proto"
import "ui"
import "view"

fn fk_tree(ctrl : ShellController, width~ : Double = 1280.0) -> ui::Tester {
  ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=width,
    height=800.0,
    theme=lg::ui_theme,
  )
}

fn fk_rect(t : ui::Tester, name : String) -> (Double, Double, Double, Double) {
  match t.get(name) {
    Some(d) => (d.x, d.y, d.w, d.h)
    None => (-1.0, -1.0, -1.0, -1.0)
  }
}

fn fk_same(a : (Double, Double, Double, Double), b : (Double, Double, Double, Double)) -> Bool {
  (a.0 - b.0).abs() < 0.01 && (a.1 - b.1).abs() < 0.01 && (a.2 - b.2).abs() < 0.01 && (a.3 - b.3).abs() < 0.01
}

fn fk_str(a : (Double, Double, Double, Double)) -> String {
  "\{a.0},\{a.1} \{a.2}x\{a.3}"
}

fn fk_at(p : Option[(Double, Double)]) -> (Double, Double) {
  match p {
    Some(v) => v
    None => (-1.0, -1.0)
  }
}

///| Every button, link, menu item, tab and separator on screen whose rect lies inside `area` (x, y, w, h) and is
///| narrower or shorter than `least`: "label w x h" for each (none: every pressable meets the hit target).
fn fk_small_pressables(t : ui::Tester, area : (Double, Double, Double, Double), least : Double) -> Array[String] {
  let (ax, ay, aw, ah) = area
  let out : Array[String] = []
  for e in t.agent_snapshot() {
    let pressable = match e.role {
      view::Role::Button | view::Role::Link | view::Role::MenuItem | view::Role::Tab => true
      _ => false
    }
    if !pressable || e.disabled {
      continue
    }
    let (x, y, w, h) = e.rect
    if w <= 0.0 || h <= 0.0 || x < ax || y < ay || x + w > ax + aw + 0.5 || y + h > ay + ah + 0.5 {
      continue
    }
    if w < least - 0.5 || h < least - 0.5 {
      out.push("\{e.label} \{w}x\{h}")
    }
  }
  out
}

test "g5 feel: the page-load line overlays the card's top edge, so the page never moves when a load starts or ends" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let card0 = fk_rect(t, "Primary Pane")
  debug_assert(t.get("Page Loading").is_none(), "no load line at rest")
  ctrl.loading.set(true)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  debug_assert(fk_same(fk_rect(t, "Primary Pane"), card0), "card frame unchanged as the load starts: \{fk_str(fk_rect(t, "Primary Pane"))} vs \{fk_str(card0)}")
  let (lx, ly, lw, lh) = fk_rect(t, "Page Loading")
  let (cx, cy, cw, _) = card0
  debug_assert((lx - cx).abs() < 0.5 && (ly - cy).abs() < 0.5 && (lh - SP_2).abs() < 0.5, "line along the card's top edge: \{lx},\{ly} h \{lh}")
  match t.get("Page Loading") {
    Some(d) => debug_assert(d.alpha > 0.0 && d.alpha < 1.0, "line at 56ms: fading in (alpha \{d.alpha})")
    None => debug_assert(false, "line present while loading")
  }
  debug_assert(lw > 0.0 && lw < cw * MO_LOAD_CREEP, "line at 56ms: creeping (w \{lw} of \{cw})")
  t.frame(ms=MO_LOAD_CREEP_MS + 200.0)
  let (_, _, lw2, _) = fk_rect(t, "Page Loading")
  debug_assert((lw2 - cw * MO_LOAD_CREEP).abs() < 1.0, "line rests at MO_LOAD_CREEP of the width while the page loads (w \{lw2})")
  match t.get("Page Loading") {
    Some(d) => debug_assert(d.alpha == 1.0, "line at rest: alpha 1 (\{d.alpha})")
    None => debug_assert(false, "line present at rest")
  }
  // The line is drawn in the Space accent, not a fixed blue.
  match t.get("Page Loading") {
    Some(d) => debug_assert(d.ground == lg::alpha(shell_space_accent(ctrl.model()), 0.8), "line in the Space accent")
    None => ()
  }
  ctrl.loading.set(false)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  debug_assert(fk_same(fk_rect(t, "Primary Pane"), card0), "card frame unchanged as the load ends")
  let (_, _, lw3, _) = fk_rect(t, "Page Loading")
  debug_assert(lw3 > lw2, "the line runs on toward the end as the load finishes (w \{lw3})")
  t.frame(ms=300.0)
  debug_assert(t.get("Page Loading").is_none(), "line gone at rest after the load")
  debug_assert(fk_same(fk_rect(t, "Primary Pane"), card0), "card frame unchanged at rest")
  // A load that starts while the last line still fades out (a redirect) takes the line up where it is: it never
  // jumps back to 0 width while it shows.
  ctrl.loading.set(true)
  t.frame(ms=MO_LOAD_CREEP_MS + 200.0)
  ctrl.loading.set(false)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  let (_, _, fw, _) = fk_rect(t, "Page Loading")
  let fading_a = match t.get("Page Loading") { Some(d) => d.alpha None => 0.0 }
  debug_assert(fading_a > 0.0 && fading_a < 1.0 && fw > cw * MO_LOAD_CREEP, "fading out on its way to the end (a \{fading_a}, w \{fw})")
  ctrl.loading.set(true)
  t.frame(ms=16.0)
  let (_, _, rw1, _) = fk_rect(t, "Page Loading")
  debug_assert(rw1 >= fw - 0.5, "restarted mid-fade: the line keeps its width (\{fw} -> \{rw1})")
  t.frame(ms=60.0)
  let (_, _, rw2, _) = fk_rect(t, "Page Loading")
  let back_a = match t.get("Page Loading") { Some(d) => d.alpha None => 0.0 }
  debug_assert(rw2 >= fw - 0.5 && back_a > fading_a, "the fade turns back, the width holds (w \{rw2}, a \{back_a})")
  ctrl.loading.set(false)
  t.frame(ms=400.0)
  ui::set_reduced_motion(None)
  t.dispose()

  // Already loading when the frame is built: shown at once.
  let ctrl2 = make_demo_controller(dark=false)
  ctrl2.loading.set(true)
  let t2 = fk_tree(ctrl2)
  match t2.get("Page Loading") {
    Some(d) => debug_assert(d.alpha == 1.0, "restored load: line at once")
    None => debug_assert(false, "restored load: line present")
  }
  t2.dispose()
}

test "g5 feel: the load line belongs to the loading pane's card in Split View" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false, split=true)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  ctrl.page.set({ ..ctrl.page.untracked(), active_pane: PaneId::Secondary })
  ctrl.loading.set(true)
  t.frame(ms=200.0)
  let (lx, _, _, _) = fk_rect(t, "Page Loading")
  let (sx, _, _, _) = fk_rect(t, "Secondary Pane")
  debug_assert((lx - sx).abs() < 0.5, "secondary active: the line is on the secondary card (\{lx} vs \{sx})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: hovering a tab overlays its close button; the title ends, faded out, at the button's leading edge" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let title = "CSS Grid Layout Module Level 3"
  let row0 = fk_rect(t, title)
  let words = fn() -> Option[view::Drawn] {
    for d in t.drawn() {
      if d.words.contains("CSS Grid") {
        return Some(d)
      }
    }
    None
  }
  let w0 = match words() { Some(d) => d None => { debug_assert(false, "title drawn"); return } }
  let (rx, ry, rw, rh) = row0
  t.move_to(rx + rw / 2.0, ry + rh / 2.0)
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(t.get("Close " + title).is_some(), "close button shows on hover")
  debug_assert(fk_same(fk_rect(t, title), row0), "the tab's press area does not move or resize on hover")
  let (bx, by, bw, bh) = fk_rect(t, "Close " + title)
  debug_assert(bw >= SP_32 - 0.5 && bh >= SP_32 - 0.5, "close button meets the 32pt hit target (\{bw}x\{bh})")
  // (the tab's press area is the whole row, from the window edge; the close button takes its trailing 32pt)
  debug_assert((bx + bw - (rx + rw)).abs() < 0.5, "close button on the row's trailing edge (\{bx + bw} vs \{rx + rw})")
  match words() {
    Some(d) => {
      debug_assert((d.x - w0.x).abs() < 0.01 && (d.y - w0.y).abs() < 0.01, "the title starts where it did (\{w0.x} -> \{d.x})")
      // No ink of the title inside the close button's rect: its text ends at the button's leading edge.
      debug_assert(d.x + d.w <= bx + 0.5, "title ink ends at the close button (\{d.x + d.w} vs \{bx})")
      let _ = by
    }
    None => debug_assert(false, "title still drawn while hovered")
  }
  // At rest again: the title takes the whole row back, no fade.
  t.move_to(rx + rw / 2.0, ry + rh + SP_80)
  t.frame(ms=300.0)
  match words() {
    Some(d) => debug_assert(d.x + d.w > bx + 0.5, "at rest the title runs on to the row's end (\{d.x + d.w})")
    None => ()
  }
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: the split divider is a 24pt drag strip with the resize cursor that tracks the pointer 1:1" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false, split=true)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  // (away from the soft detent at the middle, which holds a drag within SPLIT_DETENT of 0.5 there)
  ctrl.dispatch(ShellIntent::SetSplitRatio(0.4))
  t.frame(ms=16.0)
  let (px, _, pw, _) = fk_rect(t, "Primary Pane")
  let (sx, _, _, _) = fk_rect(t, "Secondary Pane")
  let (dx, dy, dw, dh) = fk_rect(t, "Resize Split View")
  debug_assert((sx - (px + pw) - proto::SPLIT_DIVIDER_WIDTH).abs() < 0.5, "the visible gap stays 6pt")
  debug_assert((dw - SP_24).abs() < 0.5, "drag strip is 24pt wide (\{dw})")
  let gap_mid = px + pw + proto::SPLIT_DIVIDER_WIDTH / 2.0
  debug_assert((dx - (px + pw - SHELL_SPLIT_HIT_LEAD)).abs() < 0.5, "only 2pt over the primary card's edge (\{dx} vs \{px + pw})")
  // The grabber stays centred on the gap.
  let mut pill_mid = -1.0
  for d in t.drawn() {
    if (d.w - SP_4).abs() < 0.01 && (d.h - SP_40).abs() < 0.01 && d.x >= dx && d.x + d.w <= dx + dw { pill_mid = d.x + d.w / 2.0 }
  }
  debug_assert((pill_mid - gap_mid).abs() < 0.5, "grabber centred on the gap (\{pill_mid} vs \{gap_mid})")
  // The primary page's overlay scrollbar edge (its last 8pt but the strip's 2pt) is the page's, not the divider's.
  t.move_to(px + pw - SP_6, dy + dh / 2.0)
  t.frame(ms=16.0)
  debug_assert(t.fake.cursor_id != view::cursor_code(view::Cursor::ResizeX), "no resize cursor over the primary card's scrollbar")
  // The cursor says it resizes, also over the strip's part on the card's edge.
  t.move_to(dx + dw - SP_2, dy + dh / 2.0)
  t.frame(ms=16.0)
  debug_assert(t.fake.cursor_id == view::cursor_code(view::Cursor::ResizeX), "resize cursor over the strip (\{t.fake.cursor_id})")
  // Dragging 7pt moves the divider 7pt (no 5% snapping).
  let r0 = ctrl.page.untracked().split_ratio
  t.drag(gap_mid, dy + dh / 2.0, gap_mid + 7.0, dy + dh / 2.0)
  t.frame(ms=16.0)
  let (_, _, pw2, _) = fk_rect(t, "Primary Pane")
  debug_assert((pw2 - pw - 7.0).abs() < 1.0, "a 7pt drag moves the divider 7pt (\{pw} -> \{pw2})")
  debug_assert(ctrl.page.untracked().split_ratio != r0, "the ratio follows the drag")
  // A press on the strip's edge over the secondary card drags too.
  t.drag(dx + dw - SP_2, dy + dh / 2.0, dx + dw - SP_2 - 20.0, dy + dh / 2.0)
  t.frame(ms=16.0)
  let (_, _, pw3, _) = fk_rect(t, "Primary Pane")
  debug_assert((pw3 - pw2 + 20.0).abs() < 1.0, "the strip's outer edge drags as well (\{pw2} -> \{pw3})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: the More trigger washes and sinks on press like its neighbours" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let (mx, my, mw, mh) = fk_rect(t, "More Actions")
  // The face is the 24pt box with its corner of SP_6 inside the trigger.
  let face = fn() -> Option[view::Drawn] {
    for d in t.drawn() {
      if d.radius == SP_6 && d.x >= mx - 0.5 && d.y >= my - 0.5 && d.x + d.w <= mx + mw + 0.5 && d.y + d.h <= my + mh + 0.5 && d.w > SP_16 {
        return Some(d)
      }
    }
    None
  }
  let w_rest = match face() { Some(d) => d.w None => -1.0 }
  debug_assert((w_rest - SP_24).abs() < 0.5, "More face at rest: 24pt (\{w_rest})")
  t.press_at(mx + mw / 2.0, my + mh / 2.0)
  t.frame(ms=60.0)
  match face() {
    Some(d) => {
      debug_assert(d.w < SP_24 - 0.05 && d.w >= SP_24 * (1.0 - MO_PRESS_SINK) - 0.05, "More face sinks while pressed (w \{d.w})")
      debug_assert((d.ground & 0xFFL) > 0L, "More face washes while pressed")
    }
    None => debug_assert(false, "More face present while pressed")
  }
  t.release(mx + mw / 2.0, my + mh / 2.0)
  t.frame(ms=300.0)
  t.key(proto::KEY_ESCAPE)
  t.frame(ms=300.0)
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: every pressable in the frame's sidebar and toolbar meets the 32pt hit target" {
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let sb_w = shell_sidebar_width(1280.0, true)
  let small = fk_small_pressables(t, (0.0, 0.0, sb_w, 800.0), SP_32)
  debug_assert(small.length() == 0, "sidebar pressables under 32pt: " + small.join(", "))
  t.dispose()
  let t2 = fk_tree(make_demo_controller(dark=false), width=640.0)
  t2.frame(ms=16.0)
  let small2 = fk_small_pressables(t2, (0.0, 0.0, 640.0, SHELL_TITLEBAND_H), SP_32)
  debug_assert(small2.length() == 0, "toolbar pressables under 32pt: " + small2.join(", "))
  t2.dispose()
}

test "g5 feel: the More menu names each item's keys for the platform it runs on" {
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  t.press("More Actions")
  t.frame(ms=300.0)
  let mac = shell_keys_mac()
  for k in [proto::shortcut_mod_label(mac, "T"), proto::shortcut_mod_label(mac, "R"), proto::shortcut_alt_mod_label(mac, "R")] {
    debug_assert(t.find(k).is_some(), "More menu shows \{k}")
  }
  t.dispose()
  // Labels for Linux / Windows never carry the macOS glyphs.
  for k in [
    proto::shortcut_mod_label(false, "T"),
    proto::shortcut_shift_mod_label(false, "\\"),
    proto::shortcut_alt_mod_label(false, "R"),
    proto::bookmarks_shortcut_label(false),
    proto::mute_shortcut_label(false),
    proto::devtools_shortcut_label(false),
    shell_back_forward_label(false),
  ] {
    debug_assert(!k.contains("⌘") && !k.contains("⇧") && !k.contains("⌥"), "no macOS glyphs off macOS: \{k}")
  }
  // The shortcuts sheet lists the drawer and the bar under their own chords.
  let mut drawer = ""
  let mut bar = ""
  for g in default_macos_shortcut_groups() {
    for it in g.items {
      if it.action == "Bookmarks" { drawer = it.keys }
      if it.action == "Bookmarks bar" { bar = it.keys }
    }
  }
  debug_assert(drawer == proto::bookmarks_shortcut_label(mac) && bar == proto::bookmarks_bar_shortcut_label(mac), "sheet: drawer \{drawer}, bar \{bar}")
}

test "windows/linux fused titlebar: inset removes macOS left gap, adds top-right window controls, Snap rect, and zero-jump sidebar toggle" {
  let acts : Array[Int] = []
  let drags : Array[Int] = [0]
  let snaps : Array[(Double, Double, Double, Double)] = []
  let ctrl = make_demo_controller(dark=false)
  let t = ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=1280.0,
    height=800.0,
    platform=3,
    theme=lg::ui_theme,
  )
  let h = hostapi::host()
  h.window_act = fn(what : Int) -> Unit { acts.push(what) }
  h.window_drag = fn() -> Unit { drags[0] = drags[0] + 1 }
  h.window_snap = fn(x : Double, y : Double, w : Double, hh : Double) -> Unit { snaps.push((x, y, w, hh)) }
  t.fake.window_inset_flag = true
  t.fake.window_corner_r = 8.0
  t.frame(ms=16.0)

  // 1. No phantom macOS left traffic-light inset on Windows; window_keys_own is true.
  debug_assert(shell_traffic_light_inset(ctrl.model()) == 0.0, "Windows inset has zero left traffic-light gap")
  debug_assert(shell_window_keys_own(ctrl.model()), "Windows inset owns top-right window buttons")
  match t.get("Toggle Sidebar") {
    Some(sb_btn) => debug_assert(sb_btn.x <= SP_16, "Windows sidebar toggle starts near left edge (x=\{sb_btn.x})")
    None => debug_assert(false, "Toggle Sidebar present on Windows")
  }

  // 2. Top-right Minimize / Maximize / Close Window controls sit inside the 40pt fused titleband and meet 32pt hit targets.
  let (min_x, min_y, min_w, min_h) = fk_rect(t, "Minimize")
  let (max_x, max_y, max_w, max_h) = fk_rect(t, "Maximize")
  let (cls_x, cls_y, cls_w, cls_h) = fk_rect(t, "Close Window")
  debug_assert(min_w >= SP_32 - 0.5 && min_h >= SP_32 - 0.5 && min_y >= 0.0 && min_y + min_h <= SHELL_TITLEBAND_H + 0.5, "Minimize hit target inside 40pt bar")
  debug_assert(max_w >= SP_32 - 0.5 && max_h >= SP_32 - 0.5 && max_y >= 0.0 && max_y + max_h <= SHELL_TITLEBAND_H + 0.5, "Maximize hit target inside 40pt bar")
  debug_assert(cls_w >= SP_32 - 0.5 && cls_h >= SP_32 - 0.5 && cls_y >= 0.0 && cls_y + cls_h <= SHELL_TITLEBAND_H + 0.5, "Close Window hit target inside 40pt bar")
  debug_assert(((cls_x + cls_w) - (1280.0 - SP_8)).abs() < 0.5, "Close Window aligns with page card right edge")
  debug_assert(min_x < max_x && max_x < cls_x, "Window buttons ordered Minimize < Maximize < Close")

  // 3. Snap Layouts rect matches the Maximize button's 32x32 face.
  debug_assert(snaps.length() > 0, "window_snap reported on Windows inset")
  let last_snap = snaps[snaps.length() - 1]
  debug_assert((last_snap.0 - max_x).abs() < 0.5 && (last_snap.1 - SP_4).abs() < 0.5 && (last_snap.2 - SP_32).abs() < 0.5 && (last_snap.3 - SP_32).abs() < 0.5, "window_snap matches Maximize face")

  // 4. Docked sidebar page card starts below the 40pt fused titleband, which carries the centered Address Bar;
  //    dragging the empty titleband space beside the Address Bar drags the window.
  let (_, card_y_docked, _, _) = fk_rect(t, "Primary Pane")
  debug_assert((card_y_docked - SHELL_TITLEBAND_H).abs() <= 0.5, "Windows docked page card starts at 40pt (y=\{card_y_docked})")
  let sb_w = shell_sidebar_width(1280.0, true)
  let (ab_dock_x, ab_dock_y, ab_dock_w, ab_dock_h) = fk_rect(t, "Address Bar")
  debug_assert(ab_dock_x >= sb_w && ab_dock_x + ab_dock_w <= min_x + 0.5, "Windows docked Address Bar sits in top fused band clear of sidebar and window buttons")
  debug_assert(ab_dock_y >= 0.0 && ab_dock_y + ab_dock_h <= SHELL_TITLEBAND_H + 0.5, "Windows docked Address Bar inside 40pt top band")
  let drags_before = drags[0]
  t.press_at(sb_w + SP_32, 20.0)
  t.release(sb_w + SP_32, 20.0)
  t.frame(ms=16.0)
  debug_assert(drags[0] > drags_before, "pressing fused titleband left of Address Bar initiates window_drag")
  let drags_mid = drags[0]
  t.press_at(min_x - SP_32, 20.0)
  t.release(min_x - SP_32, 20.0)
  t.frame(ms=16.0)
  debug_assert(drags[0] > drags_mid, "pressing fused titleband right of Address Bar initiates window_drag")
  lg::assert_apple_ui(t, label="win_inset_docked_1280")

  // 5. Pressing Minimize, Maximize, Close Window dispatches window_act(1/2/3).
  t.press("Minimize")
  t.frame(ms=16.0)
  t.press("Maximize")
  t.frame(ms=16.0)
  t.press("Close Window")
  t.frame(ms=16.0)
  debug_assert(acts.length() == 3 && acts[0] == 1 && acts[1] == 2 && acts[2] == 3, "window_act(1,2,3) dispatched")

  // 6. Maximized state switches Maximize -> Restore.
  t.fake.window_zoomed_flag = true
  t.frame(ms=16.0)
  debug_assert(t.get("Restore").is_some() && t.get("Maximize").is_none(), "zoomed window switches Maximize to Restore")
  t.fake.window_zoomed_flag = false
  t.frame(ms=16.0)

  // 7. Hiding the sidebar keeps the page card at y=40pt (zero vertical jump) and keeps window buttons clear of Address Bar.
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=200.0)
  let (_, card_y_hidden, _, _) = fk_rect(t, "Primary Pane")
  debug_assert((card_y_hidden - SHELL_TITLEBAND_H).abs() <= 0.5, "Windows hidden-sidebar page card stays at 40pt (y=\{card_y_hidden})")
  let (ab_x, _, ab_w, _) = fk_rect(t, "Address Bar")
  debug_assert(ab_x + ab_w <= min_x + 0.5, "compact toolbar Address Bar stays clear of window buttons")
  lg::assert_apple_ui(t, label="win_inset_hidden_1280")

  // 8. Narrow 480px window updates window_snap and passes UI craft audit with zero overlap.
  t.resize(480.0, 800.0)
  t.frame(ms=200.0)
  let (min480_x, _, _, _) = fk_rect(t, "Minimize")
  let (max480_x, _, _, _) = fk_rect(t, "Maximize")
  let (ab480_x, _, ab480_w, _) = fk_rect(t, "Address Bar")
  debug_assert(ab480_x + ab480_w <= min480_x + 0.5, "narrow 480px Address Bar stays clear of window buttons")
  let snap480 = snaps[snaps.length() - 1]
  debug_assert((snap480.0 - max480_x).abs() < 0.5, "window_snap updates on resize to 480px")
  lg::assert_apple_ui(t, label="win_inset_narrow_480")

  // 9. Leaving inset (e.g. fullscreen) hides custom window controls, clears window_snap, and restores Address Bar to sidebar when docked.
  t.resize(1280.0, 800.0)
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=200.0)
  t.fake.window_inset_flag = false
  t.frame(ms=16.0)
  debug_assert(t.get("Minimize").is_none() && t.get("Close Window").is_none(), "fullscreen unmounts window buttons")
  let (ab_fs_x, _, ab_fs_w, _) = fk_rect(t, "Address Bar")
  debug_assert(ab_fs_x >= 0.0 && ab_fs_x + ab_fs_w <= sb_w + 0.5, "fullscreen returns Address Bar to docked sidebar")
  let snap_off = snaps[snaps.length() - 1]
  debug_assert(snap_off.2 == 0.0 && snap_off.3 == 0.0, "leaving inset clears window_snap rect")

  t.dispose()

  // 10. macOS (platform 0) inset still uses left traffic lights, renders zero custom window buttons, and clamps
  //     docked narrow/180pt sidebar width to 216pt so the four 32pt nav buttons never collide or overflow.
  let ctrl_mac = make_demo_controller(dark=false)
  let tm = ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl_mac.model(), fn(i) { ctrl_mac.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl_mac.model()) })) },
    width=1280.0,
    height=800.0,
    platform=0,
    theme=lg::ui_theme,
  )
  tm.fake.window_inset_flag = true
  tm.frame(ms=16.0)
  debug_assert((shell_traffic_light_inset(ctrl_mac.model()) - SHELL_TRAFFIC_LIGHT_INSET).abs() < 0.5, "macOS inset keeps 80pt traffic light clearance")
  debug_assert(!shell_window_keys_own(ctrl_mac.model()), "macOS does not draw custom window buttons")
  debug_assert(tm.get("Minimize").is_none() && tm.get("Close Window").is_none(), "macOS renders zero custom window buttons")
  let (_, mac_card_y, _, _) = fk_rect(tm, "Primary Pane")
  debug_assert((mac_card_y - SHELL_CANVAS_GAP).abs() <= 0.5, "macOS docked page card stays at SHELL_CANVAS_GAP (8pt)")
  // Saved 180pt sidebar clamps to 216pt under macOS inset so Toggle and Back keep >= 8pt breathing room.
  ctrl_mac.dispatch(ShellIntent::SetSidebarWidth(180.0, true))
  tm.frame(ms=16.0)
  let (mac_sb_x, _, mac_sb_w, _) = fk_rect(tm, "Toggle Sidebar")
  let (mac_bk_x, _, _, _) = fk_rect(tm, "Back")
  let (mac_pane_x, _, _, _) = fk_rect(tm, "Primary Pane")
  debug_assert(mac_sb_x >= SHELL_TRAFFIC_LIGHT_INSET - 0.5, "macOS Toggle Sidebar clears 80pt traffic lights")
  debug_assert(mac_bk_x - (mac_sb_x + mac_sb_w) >= SP_8 - 0.5, "macOS 180pt saved sidebar clamps with >=8pt nav gap")
  debug_assert(mac_pane_x >= 216.0, "macOS inset sidebar clamps to at least 216pt (pane_x=\{mac_pane_x})")
  debug_assert(
    (shell_sidebar_width(1280.0, true, custom_w=180.0) - 216.0).abs() < 0.5,
    "shell_sidebar_width defaults inset to live macOS traffic-light clearance (216pt)",
  )
  // Narrow 720pt window under macOS inset also clamps to 216pt with zero overlap.
  tm.resize(720.0, 800.0)
  tm.frame(ms=16.0)
  let (mac720_sb_x, _, mac720_sb_w, _) = fk_rect(tm, "Toggle Sidebar")
  let (mac720_bk_x, _, _, _) = fk_rect(tm, "Back")
  debug_assert(mac720_bk_x - (mac720_sb_x + mac720_sb_w) >= SP_8 - 0.5, "macOS 720pt narrow sidebar keeps >=8pt nav gap")
  lg::assert_apple_ui(tm, label="mac_inset_narrow_720")
  // Leaving inset (fullscreen) restores 180pt sidebar minimum and removes traffic-light clearance.
  tm.resize(1280.0, 800.0)
  tm.fake.window_inset_flag = false
  tm.frame(ms=16.0)
  let (mac_fs_sb_x, _, _, _) = fk_rect(tm, "Toggle Sidebar")
  let (mac_fs_pane_x, _, _, _) = fk_rect(tm, "Primary Pane")
  debug_assert(mac_fs_sb_x <= SP_16, "macOS fullscreen removes traffic-light clearance")
  debug_assert(mac_fs_pane_x < 200.0, "macOS fullscreen allows 180pt saved sidebar (pane_x=\{mac_fs_pane_x})")
  debug_assert(
    (shell_sidebar_width(1280.0, true, custom_w=180.0) - 180.0).abs() < 0.5,
    "shell_sidebar_width defaults back to 180pt when leaving macOS inset",
  )
  tm.dispose()
}

fn fk_count_label(t : ui::Tester, label : String) -> Int {
  let mut n = 0
  for e in t.agent_snapshot() {
    if e.label == label {
      n = n + 1
    }
  }
  n
}

test "windows/linux fused titlebar: single address bar mid-animation, 720/760 drag room, DPI scale snap, Fitts corner, Tab skip, modals, sidebar modes and Linux" {
  ui::set_reduced_motion(Some(false))
  let acts : Array[Int] = []
  let drags : Array[Int] = [0]
  let snaps : Array[(Double, Double, Double, Double)] = []
  let ctrl = make_demo_controller(dark=false)
  let modes_state = SidebarModeState::new()
  let cmd_field = ui::Field::new()
  let settings_open = signals::signal(false)
  let settings_tab = signals::signal(0)
  let root_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let hooks = ShellHostHooks::{
    ..ShellHostHooks::empty(),
    sidebar_modes: Some(SidebarModeProps::{
      state: modes_state,
      on_new_space: fn() { () },
      on_create: fn(_n : String, _th : proto::SpaceTheme) { () },
      on_open_library: fn() { () },
      library: LibraryProps::empty(),
      escape_in_frame: true,
    }),
    command_bar: Some(CommandBarProps::{
      field: cmd_field,
      items: fn() { [] },
      selected: fn() { 0 },
      on_query_change: fn(_q : String) { () },
      on_step: fn(_d : Int) { false },
      on_submit: fn(_s : String) { () },
      on_execute: fn(_item : proto::CommandBarItem) { () },
      on_close: fn() { ctrl.dispatch(ShellIntent::EscapePressed) },
      on_row_view: None,
      on_clear_rows: None,
    }),
  }
  let t = ui::Tester::tree(
    fn(root) {
      root_ref.v = Some(root)
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
        hooks=Some(hooks),
      )
      build_settings_panel(
        root,
        SettingsPanelProps::{
          open: fn() { settings_open.get() },
          dark: fn() { ctrl.dark.get() },
          active_tab: settings_tab,
          settings: fn() { proto::BrowserSettings::default() },
          clear_bookmarks: signals::signal(false),
          clear_history: signals::signal(true),
          clear_downloads: signals::signal(false),
          clear_boosts: signals::signal(false),
          filter_field: None,
          on_save_settings: fn(_s : proto::BrowserSettings, _k : String) { () },
          on_step_zoom: fn(_d : Int) { () },
          on_clear_browsing_data: fn(_sel : ClearBrowsingDataSelection) { () },
          on_close: fn() { settings_open.set(false) },
          migrate: None,
          atc: None,
          passwords: None,
          extensions: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    platform=3,
    theme=lg::ui_theme,
  )
  let h = hostapi::host()
  h.window_act = fn(what : Int) -> Unit { acts.push(what) }
  h.window_drag = fn() -> Unit { drags[0] = drags[0] + 1 }
  h.window_snap = fn(x : Double, y : Double, w : Double, hh : Double) -> Unit { snaps.push((x, y, w, hh)) }
  t.fake.window_inset_flag = true
  t.fake.window_corner_r = 8.0
  t.frame(ms=16.0)

  // 1. Window buttons are NOT Tab stops, while remaining exposed in the a11y tree.
  let focus_stops = match root_ref.v {
    Some(r) => r.tree.focus_order()
    None => []
  }
  for lbl in ["Minimize", "Maximize", "Close Window"] {
    match t.get(lbl) {
      Some(d) => {
        for fa in focus_stops {
          debug_assert(fa.id != d.id, "\{lbl} must not be a keyboard Tab stop")
        }
      }
      None => debug_assert(false, "\{lbl} exposed in a11y tree")
    }
  }

  // 2. Frame-by-frame sidebar toggle (hide AND show) at 1280pt and 720pt:
  //    - ALWAYS exactly 1 Address Bar, NEVER >= 2 Toggle Sidebar / Back buttons visible at once;
  //    - Address Bar x moves strictly monotonically (zero jump/reversal) and NEVER overlaps Minimize or sidebar/nav;
  //    - Page card stays locked at y=40pt on every frame.
  for ww in [1280.0, 720.0] {
    t.resize(ww, 800.0)
    t.frame(ms=16.0)
    let (min_x_now, _, _, _) = fk_rect(t, "Minimize")
    let (start_x, _, _, _) = fk_rect(t, "Address Bar")
    let mut prev_x = start_x
    ctrl.dispatch(ShellIntent::ToggleSidebar)
    for step in 0..<22 {
      t.frame(ms=16.0)
      debug_assert(fk_count_label(t, "Address Bar") == 1, "w=\{ww} hide step=\{step}: exactly one Address Bar")
      debug_assert(fk_count_label(t, "Toggle Sidebar") <= 1, "w=\{ww} hide step=\{step}: no duplicate nav row")
      let (ax, _, aw, _) = fk_rect(t, "Address Bar")
      debug_assert(ax <= prev_x + 0.5, "w=\{ww} hide step=\{step}: Address Bar x monotonic left (prev=\{prev_x}, cur=\{ax})")
      debug_assert(ax + aw <= min_x_now - SP_8 + 0.5, "w=\{ww} hide step=\{step}: Address Bar clears Minimize (right=\{ax + aw}, min=\{min_x_now})")
      match t.get("Reload") {
        Some(rl) => debug_assert(ax >= rl.x + rl.w - 0.5, "w=\{ww} hide step=\{step}: Address Bar clears nav Reload (ax=\{ax}, rl_r=\{rl.x + rl.w})")
        None => ()
      }
      let (_, cy, _, _) = fk_rect(t, "Primary Pane")
      debug_assert((cy - SHELL_TITLEBAND_H).abs() <= 0.5, "w=\{ww} hide step=\{step}: page card stays at 40pt (y=\{cy})")
      prev_x = ax
    }
    ctrl.dispatch(ShellIntent::ToggleSidebar)
    for step in 0..<22 {
      t.frame(ms=16.0)
      debug_assert(fk_count_label(t, "Address Bar") == 1, "w=\{ww} show step=\{step}: exactly one Address Bar")
      debug_assert(fk_count_label(t, "Toggle Sidebar") <= 1, "w=\{ww} show step=\{step}: no duplicate nav row")
      let (ax, _, aw, _) = fk_rect(t, "Address Bar")
      debug_assert(ax >= prev_x - 0.5, "w=\{ww} show step=\{step}: Address Bar x monotonic right (prev=\{prev_x}, cur=\{ax})")
      debug_assert(ax + aw <= min_x_now - SP_8 + 0.5, "w=\{ww} show step=\{step}: Address Bar clears Minimize (right=\{ax + aw}, min=\{min_x_now})")
      match t.get("Reload") {
        Some(rl) => debug_assert(ax >= rl.x + rl.w - 0.5, "w=\{ww} show step=\{step}: Address Bar clears sidebar Reload (ax=\{ax}, rl_r=\{rl.x + rl.w})")
        None => ()
      }
      let (_, cy, _, _) = fk_rect(t, "Primary Pane")
      debug_assert((cy - SHELL_TITLEBAND_H).abs() <= 0.5, "w=\{ww} show step=\{step}: page card stays at 40pt (y=\{cy})")
      prev_x = ax
    }
  }
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)

  // 3. Narrow docked 720pt and 760pt windows keep >= 48pt draggable titleband on BOTH sides of the Address Bar.
  for ww in [720.0, 760.0] {
    t.resize(ww, 800.0)
    t.frame(ms=16.0)
    let sw = shell_sidebar_width(ww, true)
    let (ab_x, _, ab_w, _) = fk_rect(t, "Address Bar")
    let (min_x, _, _, _) = fk_rect(t, "Minimize")
    debug_assert(ab_x - (sw + SP_8) >= SHELL_WIN_BAND_DRAG_MIN - 1.0, "w=\{ww}: >=48pt drag left of Address Bar (\{ab_x - (sw + SP_8)})")
    debug_assert(min_x - (ab_x + ab_w) >= SHELL_WIN_BAND_DRAG_MIN - 1.0, "w=\{ww}: >=48pt drag right of Address Bar (\{min_x - (ab_x + ab_w)})")
    let d0 = drags[0]
    t.press_at(sw + SP_24, 20.0)
    t.release(sw + SP_24, 20.0)
    t.frame(ms=16.0)
    debug_assert(drags[0] > d0, "w=\{ww}: left drag strip initiates window_drag")
    let d1 = drags[0]
    t.press_at(min_x - SP_24, 20.0)
    t.release(min_x - SP_24, 20.0)
    t.frame(ms=16.0)
    debug_assert(drags[0] > d1, "w=\{ww}: right drag strip initiates window_drag")
  }
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)

  // 4. DPI / display scale change: logical-point snap rect stays matched to the actual Maximize face across scale
  //    changes (win_app.c converts snap_pt[4] by live win_scale(h) on WM_NCHITTEST), and updates on resize + DPI.
  t.fake.scale = 1.5
  t.frame(ms=16.0)
  let (mx_dpi, _, _, _) = fk_rect(t, "Maximize")
  let s_dpi = snaps[snaps.length() - 1]
  debug_assert((s_dpi.0 - mx_dpi).abs() < 0.5 && (s_dpi.1 - SP_4).abs() < 0.5 && (s_dpi.2 - SP_32).abs() < 0.5 && (s_dpi.3 - SP_32).abs() < 0.5, "DPI scale 1.5: logical snap rect matches Maximize face")
  let snaps_before_dpi_resize = snaps.length()
  t.resize(960.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(snaps.length() > snaps_before_dpi_resize, "DPI + resize re-reports window_snap")
  let (mx_dpi2, _, _, _) = fk_rect(t, "Maximize")
  let s_dpi2 = snaps[snaps.length() - 1]
  debug_assert((s_dpi2.0 - mx_dpi2).abs() < 0.5 && (s_dpi2.2 - SP_32).abs() < 0.5, "DPI + resize 960pt: snap rect matches actual Maximize face")
  t.fake.scale = 2.0
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)

  // 5. Maximized Fitts's Law corner: slamming cursor to (1279, 1) hits Close Window, and Restore snap stays accurate.
  t.fake.window_zoomed_flag = true
  t.frame(ms=16.0)
  let (cls_z_x, cls_z_y, cls_z_w, cls_z_h) = fk_rect(t, "Close Window")
  debug_assert((cls_z_x + cls_z_w - 1280.0).abs() < 0.5 && cls_z_y <= 0.5 && cls_z_h >= SP_40 - 0.5, "maximized Close reaches top-right screen corner")
  let acts_z = acts.length()
  t.click(1279.0, 1.0)
  t.frame(ms=16.0)
  debug_assert(acts.length() == acts_z + 1 && acts[acts_z] == 3, "clicking top-right pixel (1279, 1) closes maximized window")
  let (rst_x, _, _, _) = fk_rect(t, "Restore")
  let s_zoom = snaps[snaps.length() - 1]
  debug_assert((s_zoom.0 - rst_x).abs() < 0.5 && (s_zoom.2 - SP_32).abs() < 0.5, "maximized snap rect matches Restore face")
  t.fake.window_zoomed_flag = false
  t.frame(ms=16.0)

  // 6. Modals (Export PDF, Settings, Command Bar): window buttons & titleband drag stay live without closing modals.
  let (min_mx, min_my, min_mw, min_mh) = fk_rect(t, "Minimize")
  // 6a. Export PDF modal dialog
  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=250.0)
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "Export PDF dialog open")
  let a0 = acts.length()
  t.click(min_mx + min_mw / 2.0, min_my + min_mh / 2.0)
  t.frame(ms=16.0)
  debug_assert(acts.length() == a0 + 1 && acts[a0] == 1, "Minimize fires over Export PDF modal")
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "Minimize keeps Export PDF open")
  let d_exp = drags[0]
  t.press_at(400.0, 20.0)
  t.release(400.0, 20.0)
  t.frame(ms=16.0)
  debug_assert(drags[0] > d_exp, "titleband drag fires over Export PDF modal")
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "titleband drag keeps Export PDF open")
  ctrl.dispatch(ShellIntent::CloseDialog)
  t.frame(ms=250.0)

  // 6b. Settings modal dialog (mounted AFTER build_shell_frame on root with full-window scrim + close_on_outside=true)
  settings_open.set(true)
  t.frame(ms=250.0)
  let a1 = acts.length()
  t.click(min_mx + min_mw / 2.0, min_my + min_mh / 2.0)
  t.frame(ms=16.0)
  debug_assert(acts.length() == a1 + 1 && acts[a1] == 1, "Minimize fires above Settings scrim")
  debug_assert(settings_open.untracked(), "Minimize must not close Settings modal")
  let d_set = drags[0]
  t.press_at(400.0, 20.0)
  t.release(400.0, 20.0)
  t.frame(ms=16.0)
  debug_assert(drags[0] > d_set, "titleband drag fires over Settings modal")
  debug_assert(settings_open.untracked(), "titleband drag must not close Settings modal")
  // Clicking the scrim below the 40pt titleband still closes Settings normally.
  t.click(20.0, 200.0)
  t.frame(ms=250.0)
  debug_assert(!settings_open.untracked(), "outside click below titleband still closes Settings")

  // 6c. Command Bar modal (`Cmd+K`)
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::CommandBar, tag="command_bar"))
  t.frame(ms=250.0)
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::CommandBar, "Command Bar open")
  let a2 = acts.length()
  t.click(min_mx + min_mw / 2.0, min_my + min_mh / 2.0)
  t.frame(ms=16.0)
  debug_assert(acts.length() == a2 + 1 && acts[a2] == 1, "Minimize fires over Command Bar modal")
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::CommandBar, "Minimize keeps Command Bar open")
  let d_cb = drags[0]
  t.press_at(400.0, 20.0)
  t.release(400.0, 20.0)
  t.frame(ms=16.0)
  debug_assert(drags[0] > d_cb, "titleband drag fires over Command Bar modal")
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::CommandBar, "titleband drag keeps Command Bar open")
  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=250.0)

  // 7. Create a Space sidebar mode hides the top-bar Address Bar on Windows (matching macOS).
  modes_state.start_create(create_space_default_theme(0))
  t.frame(ms=300.0)
  debug_assert(t.get("Address Bar").is_none(), "Create a Space mode hides top-bar Address Bar on Windows")
  modes_state.back()
  t.frame(ms=300.0)
  debug_assert(t.get("Address Bar").is_some(), "leaving Create a Space restores top-bar Address Bar")
  t.dispose()

  // 8. Linux (platform=5) inset behaves identically to Windows: zero left inset, top-right window controls, drag.
  let lin_acts : Array[Int] = []
  let lin_drags : Array[Int] = [0]
  let ctrl_lin = make_demo_controller(dark=false)
  let tl = ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl_lin.model(), fn(i) { ctrl_lin.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl_lin.model()) })) },
    width=1280.0,
    height=800.0,
    platform=5,
    theme=lg::ui_theme,
  )
  let hl = hostapi::host()
  hl.window_act = fn(what : Int) -> Unit { lin_acts.push(what) }
  hl.window_drag = fn() -> Unit { lin_drags[0] = lin_drags[0] + 1 }
  tl.fake.window_inset_flag = true
  tl.frame(ms=16.0)
  debug_assert(shell_traffic_light_inset(ctrl_lin.model()) == 0.0, "Linux inset has zero left traffic-light gap")
  debug_assert(shell_window_keys_own(ctrl_lin.model()), "Linux inset owns top-right window controls")
  tl.press("Minimize")
  tl.press("Close Window")
  tl.frame(ms=16.0)
  debug_assert(lin_acts.length() == 2 && lin_acts[0] == 1 && lin_acts[1] == 3, "Linux window controls dispatch window_act")
  tl.press_at(320.0, 20.0)
  tl.release(320.0, 20.0)
  tl.frame(ms=16.0)
  debug_assert(lin_drags[0] > 0, "Linux fused titleband drags window")
  tl.dispose()
  ui::set_reduced_motion(None)
}
