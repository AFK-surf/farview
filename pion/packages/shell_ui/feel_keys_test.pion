///| Feel (g5): the page-load line out of flow, the tab title fading under its close button, the split divider's
///| drag target, press feedback on the More trigger, platform shortcut labels, and a hit-scan of the frame's
///| pressables. Each motion is sampled mid-way and at rest on the Tester clock.

import "lg"
import "proto"
import "ui"
import "view"

fn fk_tree(ctrl : ShellController, width~ : Double = 1280.0) -> ui::Tester {
  ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=width,
    height=800.0,
    theme=lg::ui_theme,
  )
}

fn fk_rect(t : ui::Tester, name : String) -> (Double, Double, Double, Double) {
  match t.get(name) {
    Some(d) => (d.x, d.y, d.w, d.h)
    None => (-1.0, -1.0, -1.0, -1.0)
  }
}

fn fk_same(a : (Double, Double, Double, Double), b : (Double, Double, Double, Double)) -> Bool {
  (a.0 - b.0).abs() < 0.01 && (a.1 - b.1).abs() < 0.01 && (a.2 - b.2).abs() < 0.01 && (a.3 - b.3).abs() < 0.01
}

fn fk_str(a : (Double, Double, Double, Double)) -> String {
  "\{a.0},\{a.1} \{a.2}x\{a.3}"
}

fn fk_at(p : Option[(Double, Double)]) -> (Double, Double) {
  match p {
    Some(v) => v
    None => (-1.0, -1.0)
  }
}

///| Every button, link, menu item, tab and separator on screen whose rect lies inside `area` (x, y, w, h) and is
///| narrower or shorter than `least`: "label w x h" for each (none: every pressable meets the hit target).
fn fk_small_pressables(t : ui::Tester, area : (Double, Double, Double, Double), least : Double) -> Array[String] {
  let (ax, ay, aw, ah) = area
  let out : Array[String] = []
  for e in t.agent_snapshot() {
    let pressable = match e.role {
      view::Role::Button | view::Role::Link | view::Role::MenuItem | view::Role::Tab => true
      _ => false
    }
    if !pressable || e.disabled {
      continue
    }
    let (x, y, w, h) = e.rect
    if w <= 0.0 || h <= 0.0 || x < ax || y < ay || x + w > ax + aw + 0.5 || y + h > ay + ah + 0.5 {
      continue
    }
    if w < least - 0.5 || h < least - 0.5 {
      out.push("\{e.label} \{w}x\{h}")
    }
  }
  out
}

test "g5 feel: the page-load line overlays the card's top edge, so the page never moves when a load starts or ends" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let card0 = fk_rect(t, "Primary Pane")
  debug_assert(t.get("Page Loading").is_none(), "no load line at rest")
  ctrl.loading.set(true)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  debug_assert(fk_same(fk_rect(t, "Primary Pane"), card0), "card frame unchanged as the load starts: \{fk_str(fk_rect(t, "Primary Pane"))} vs \{fk_str(card0)}")
  let (lx, ly, lw, lh) = fk_rect(t, "Page Loading")
  let (cx, cy, cw, _) = card0
  debug_assert((lx - cx).abs() < 0.5 && (ly - cy).abs() < 0.5 && (lh - SP_2).abs() < 0.5, "line along the card's top edge: \{lx},\{ly} h \{lh}")
  match t.get("Page Loading") {
    Some(d) => debug_assert(d.alpha > 0.0 && d.alpha < 1.0, "line at 56ms: fading in (alpha \{d.alpha})")
    None => debug_assert(false, "line present while loading")
  }
  debug_assert(lw > 0.0 && lw < cw * MO_LOAD_CREEP, "line at 56ms: creeping (w \{lw} of \{cw})")
  t.frame(ms=MO_LOAD_CREEP_MS + 200.0)
  let (_, _, lw2, _) = fk_rect(t, "Page Loading")
  debug_assert((lw2 - cw * MO_LOAD_CREEP).abs() < 1.0, "line rests at MO_LOAD_CREEP of the width while the page loads (w \{lw2})")
  match t.get("Page Loading") {
    Some(d) => debug_assert(d.alpha == 1.0, "line at rest: alpha 1 (\{d.alpha})")
    None => debug_assert(false, "line present at rest")
  }
  // The line is drawn in the Space accent, not a fixed blue.
  match t.get("Page Loading") {
    Some(d) => debug_assert(d.ground == lg::alpha(shell_space_accent(ctrl.model()), 0.8), "line in the Space accent")
    None => ()
  }
  ctrl.loading.set(false)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  debug_assert(fk_same(fk_rect(t, "Primary Pane"), card0), "card frame unchanged as the load ends")
  let (_, _, lw3, _) = fk_rect(t, "Page Loading")
  debug_assert(lw3 > lw2, "the line runs on toward the end as the load finishes (w \{lw3})")
  t.frame(ms=300.0)
  debug_assert(t.get("Page Loading").is_none(), "line gone at rest after the load")
  debug_assert(fk_same(fk_rect(t, "Primary Pane"), card0), "card frame unchanged at rest")
  // A load that starts while the last line still fades out (a redirect) takes the line up where it is: it never
  // jumps back to 0 width while it shows.
  ctrl.loading.set(true)
  t.frame(ms=MO_LOAD_CREEP_MS + 200.0)
  ctrl.loading.set(false)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  let (_, _, fw, _) = fk_rect(t, "Page Loading")
  let fading_a = match t.get("Page Loading") { Some(d) => d.alpha None => 0.0 }
  debug_assert(fading_a > 0.0 && fading_a < 1.0 && fw > cw * MO_LOAD_CREEP, "fading out on its way to the end (a \{fading_a}, w \{fw})")
  ctrl.loading.set(true)
  t.frame(ms=16.0)
  let (_, _, rw1, _) = fk_rect(t, "Page Loading")
  debug_assert(rw1 >= fw - 0.5, "restarted mid-fade: the line keeps its width (\{fw} -> \{rw1})")
  t.frame(ms=60.0)
  let (_, _, rw2, _) = fk_rect(t, "Page Loading")
  let back_a = match t.get("Page Loading") { Some(d) => d.alpha None => 0.0 }
  debug_assert(rw2 >= fw - 0.5 && back_a > fading_a, "the fade turns back, the width holds (w \{rw2}, a \{back_a})")
  ctrl.loading.set(false)
  t.frame(ms=400.0)
  ui::set_reduced_motion(None)
  t.dispose()

  // Already loading when the frame is built: shown at once.
  let ctrl2 = make_demo_controller(dark=false)
  ctrl2.loading.set(true)
  let t2 = fk_tree(ctrl2)
  match t2.get("Page Loading") {
    Some(d) => debug_assert(d.alpha == 1.0, "restored load: line at once")
    None => debug_assert(false, "restored load: line present")
  }
  t2.dispose()
}

test "g5 feel: the load line belongs to the loading pane's card in Split View" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false, split=true)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  ctrl.page.set({ ..ctrl.page.untracked(), active_pane: PaneId::Secondary })
  ctrl.loading.set(true)
  t.frame(ms=200.0)
  let (lx, _, _, _) = fk_rect(t, "Page Loading")
  let (sx, _, _, _) = fk_rect(t, "Secondary Pane")
  debug_assert((lx - sx).abs() < 0.5, "secondary active: the line is on the secondary card (\{lx} vs \{sx})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: hovering a tab overlays its close button; the title ends, faded out, at the button's leading edge" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let title = "CSS Grid Layout Module Level 3"
  let row0 = fk_rect(t, title)
  let words = fn() -> Option[view::Drawn] {
    for d in t.drawn() {
      if d.words.contains("CSS Grid") {
        return Some(d)
      }
    }
    None
  }
  let w0 = match words() { Some(d) => d None => { debug_assert(false, "title drawn"); return } }
  let (rx, ry, rw, rh) = row0
  t.move_to(rx + rw / 2.0, ry + rh / 2.0)
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(t.get("Close " + title).is_some(), "close button shows on hover")
  debug_assert(fk_same(fk_rect(t, title), row0), "the tab's press area does not move or resize on hover")
  let (bx, by, bw, bh) = fk_rect(t, "Close " + title)
  debug_assert(bw >= SP_32 - 0.5 && bh >= SP_32 - 0.5, "close button meets the 32pt hit target (\{bw}x\{bh})")
  // (the tab's press area ends at the row's 6pt trailing padding; the button sits 2pt in from the row's edge)
  debug_assert((bx + bw - (rx + rw + SP_6 - SP_2)).abs() < 0.5, "close button on the row's trailing edge (\{bx + bw} vs \{rx + rw})")
  match words() {
    Some(d) => {
      debug_assert((d.x - w0.x).abs() < 0.01 && (d.y - w0.y).abs() < 0.01, "the title starts where it did (\{w0.x} -> \{d.x})")
      // No ink of the title inside the close button's rect: its text ends at the button's leading edge.
      debug_assert(d.x + d.w <= bx + 0.5, "title ink ends at the close button (\{d.x + d.w} vs \{bx})")
      let _ = by
    }
    None => debug_assert(false, "title still drawn while hovered")
  }
  // At rest again: the title takes the whole row back, no fade.
  t.move_to(rx + rw / 2.0, ry + rh + SP_80)
  t.frame(ms=300.0)
  match words() {
    Some(d) => debug_assert(d.x + d.w > bx + 0.5, "at rest the title runs on to the row's end (\{d.x + d.w})")
    None => ()
  }
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: the split divider is a 24pt drag strip with the resize cursor that tracks the pointer 1:1" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false, split=true)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let (px, _, pw, _) = fk_rect(t, "Primary Pane")
  let (sx, _, _, _) = fk_rect(t, "Secondary Pane")
  let (dx, dy, dw, dh) = fk_rect(t, "Resize Split View")
  debug_assert((sx - (px + pw) - proto::SPLIT_DIVIDER_WIDTH).abs() < 0.5, "the visible gap stays 6pt")
  debug_assert((dw - SP_24).abs() < 0.5, "drag strip is 24pt wide (\{dw})")
  let gap_mid = px + pw + proto::SPLIT_DIVIDER_WIDTH / 2.0
  debug_assert((dx - (px + pw - SHELL_SPLIT_HIT_LEAD)).abs() < 0.5, "only 2pt over the primary card's edge (\{dx} vs \{px + pw})")
  // The grabber stays centred on the gap.
  let mut pill_mid = -1.0
  for d in t.drawn() {
    if (d.w - SP_4).abs() < 0.01 && (d.h - SP_40).abs() < 0.01 && d.x >= dx && d.x + d.w <= dx + dw { pill_mid = d.x + d.w / 2.0 }
  }
  debug_assert((pill_mid - gap_mid).abs() < 0.5, "grabber centred on the gap (\{pill_mid} vs \{gap_mid})")
  // The primary page's overlay scrollbar edge (its last 8pt but the strip's 2pt) is the page's, not the divider's.
  t.move_to(px + pw - SP_6, dy + dh / 2.0)
  t.frame(ms=16.0)
  debug_assert(t.fake.cursor_id != view::cursor_code(view::Cursor::ResizeX), "no resize cursor over the primary card's scrollbar")
  // The cursor says it resizes, also over the strip's part on the card's edge.
  t.move_to(dx + dw - SP_2, dy + dh / 2.0)
  t.frame(ms=16.0)
  debug_assert(t.fake.cursor_id == view::cursor_code(view::Cursor::ResizeX), "resize cursor over the strip (\{t.fake.cursor_id})")
  // Dragging 7pt moves the divider 7pt (no 5% snapping).
  let r0 = ctrl.page.untracked().split_ratio
  t.drag(gap_mid, dy + dh / 2.0, gap_mid + 7.0, dy + dh / 2.0)
  t.frame(ms=16.0)
  let (_, _, pw2, _) = fk_rect(t, "Primary Pane")
  debug_assert((pw2 - pw - 7.0).abs() < 1.0, "a 7pt drag moves the divider 7pt (\{pw} -> \{pw2})")
  debug_assert(ctrl.page.untracked().split_ratio != r0, "the ratio follows the drag")
  // A press on the strip's edge over the secondary card drags too.
  t.drag(dx + dw - SP_2, dy + dh / 2.0, dx + dw - SP_2 - 20.0, dy + dh / 2.0)
  t.frame(ms=16.0)
  let (_, _, pw3, _) = fk_rect(t, "Primary Pane")
  debug_assert((pw3 - pw2 + 20.0).abs() < 1.0, "the strip's outer edge drags as well (\{pw2} -> \{pw3})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: the More trigger washes and sinks on press like its neighbours" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let (mx, my, mw, mh) = fk_rect(t, "More Actions")
  // The face is the 24pt box with its corner of SP_6 inside the trigger.
  let face = fn() -> Option[view::Drawn] {
    for d in t.drawn() {
      if d.radius == SP_6 && d.x >= mx - 0.5 && d.y >= my - 0.5 && d.x + d.w <= mx + mw + 0.5 && d.y + d.h <= my + mh + 0.5 && d.w > SP_16 {
        return Some(d)
      }
    }
    None
  }
  let w_rest = match face() { Some(d) => d.w None => -1.0 }
  debug_assert((w_rest - SP_24).abs() < 0.5, "More face at rest: 24pt (\{w_rest})")
  t.press_at(mx + mw / 2.0, my + mh / 2.0)
  t.frame(ms=60.0)
  match face() {
    Some(d) => {
      debug_assert(d.w < SP_24 - 0.05 && d.w >= SP_24 * (1.0 - MO_PRESS_SINK) - 0.05, "More face sinks while pressed (w \{d.w})")
      debug_assert((d.ground & 0xFFL) > 0L, "More face washes while pressed")
    }
    None => debug_assert(false, "More face present while pressed")
  }
  t.release(mx + mw / 2.0, my + mh / 2.0)
  t.frame(ms=300.0)
  t.key(proto::KEY_ESCAPE)
  t.frame(ms=300.0)
  ui::set_reduced_motion(None)
  t.dispose()
}

test "g5 feel: every pressable in the frame's sidebar and toolbar meets the 32pt hit target" {
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  let sb_w = shell_sidebar_width(1280.0, true)
  let small = fk_small_pressables(t, (0.0, 0.0, sb_w, 800.0), SP_32)
  debug_assert(small.length() == 0, "sidebar pressables under 32pt: " + small.join(", "))
  t.dispose()
  let t2 = fk_tree(make_demo_controller(dark=false), width=640.0)
  t2.frame(ms=16.0)
  let small2 = fk_small_pressables(t2, (0.0, 0.0, 640.0, SHELL_TITLEBAND_H), SP_32)
  debug_assert(small2.length() == 0, "toolbar pressables under 32pt: " + small2.join(", "))
  t2.dispose()
}

test "g5 feel: the More menu names each item's keys for the platform it runs on" {
  let ctrl = make_demo_controller(dark=false)
  let t = fk_tree(ctrl)
  t.frame(ms=16.0)
  t.press("More Actions")
  t.frame(ms=300.0)
  let mac = shell_keys_mac()
  for k in [proto::shortcut_mod_label(mac, "T"), proto::shortcut_mod_label(mac, "R"), proto::shortcut_alt_mod_label(mac, "R")] {
    debug_assert(t.find(k).is_some(), "More menu shows \{k}")
  }
  t.dispose()
  // Labels for Linux / Windows never carry the macOS glyphs.
  for k in [
    proto::shortcut_mod_label(false, "T"),
    proto::shortcut_shift_mod_label(false, "\\"),
    proto::shortcut_alt_mod_label(false, "R"),
    proto::bookmarks_shortcut_label(false),
    proto::mute_shortcut_label(false),
    proto::devtools_shortcut_label(false),
    shell_back_forward_label(false),
  ] {
    debug_assert(!k.contains("⌘") && !k.contains("⇧") && !k.contains("⌥"), "no macOS glyphs off macOS: \{k}")
  }
  // The shortcuts sheet lists the drawer and the bar under their own chords.
  let mut drawer = ""
  let mut bar = ""
  for g in default_macos_shortcut_groups() {
    for it in g.items {
      if it.action == "Bookmarks" { drawer = it.keys }
      if it.action == "Bookmarks Bar" { bar = it.keys }
    }
  }
  debug_assert(drawer == proto::bookmarks_shortcut_label(mac) && bar == proto::bookmarks_bar_shortcut_label(mac), "sheet: drawer \{drawer}, bar \{bar}")
}
