///| Automated unit & UI-craft tests for Farview Desktop Shell 2.0 Phase 3B drawers & modals:
///| - Cookies Inspector (bound `owner_pane=1`, single-cookie delete, clear site, back to SiteInfo, Light + Dark)
///| - History Drawer (Today / Yesterday / Earlier zero empty groups, search, open/delete, clear range)
///| - Bookmarks Drawer (search, open, delete, toggle current, empty state)
///| - Sessions Manager (save current, restore & delete non-first item by exact `session_id`)
///| - Inline Folder Creator (input submit `folder_new`, Esc/Cancel close, 480pt narrow sidebar width)
///| - Spaces Manager (create with accent, switch, inline rename, delete)
///| - Closed Tabs Drawer (filtered click on non-first item asserts original `it.index`, NOT filtered index!)
///| - Print / PDF Modal (A4/Letter/Legal, Portrait/Landscape, Default/Narrow/Wide, Background Graphics,
///|   Save forwards locked `owner_pane` + `proto::PrintPdfConfig`, Cancel emits 0 exports)

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn phase3b_audit(t : ui::Tester, label : String) -> Unit {
  t.set_a11y(true)
  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label=label, allow_large_overlay=true)
  t.assert_scrollable(label=label)
  let a11y = t.a11y_faults()
  if a11y.length() > 0 {
    let mut msg = "a11y_faults in \{label} (\{a11y.length()}):"
    for f in a11y {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

test "phase3b: Cookies Inspector binds owner_pane=1 on delete & clear site in Light and Dark" {
  let open = signals::signal(true)
  let pane_sig = signals::signal(1)
  let host_sig = signals::signal("docs.example.com")
  let space_sig = signals::signal("work")
  let cookies_sig : signals::Signal[Array[proto::SiteCookieRow]] = signals::signal_ref([
    proto::SiteCookieRow::{
      name: "sid",
      domain: ".example.com",
      path: "/",
      value_preview: "abc***",
      secure: true,
      http_only: true,
      same_site: "Lax",
      partitioned: false,
      expires_label: "2027-01-01",
      is_session: false,
    },
    proto::SiteCookieRow::{
      name: "prefs",
      domain: "docs.example.com",
      path: "/v2",
      value_preview: "dark=1",
      secure: true,
      http_only: false,
      same_site: "None",
      partitioned: true,
      expires_label: "",
      is_session: true,
    },
  ])
  let filter_field = ui::Field::new()
  let deleted : Array[String] = []
  let cleared : Array[String] = []
  let back_clicks = ui::ref_new(0)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_cookies_inspector_modal(
        root,
        CookiesInspectorProps::{
          open: fn() { open.get() },
          owner_pane: fn() { pane_sig.get() },
          site_host: fn() { host_sig.get() },
          space_id: fn() { space_sig.get() },
          cookies: fn() { cookies_sig.get() },
          filter_field,
          show_back_to_site_info: fn() { true },
          on_back_to_site_info: fn() { back_clicks.v = back_clicks.v + 1 },
          on_delete_cookie: fn(pane, host, name, domain, path) {
            deleted.push(pane.to_string() + "|" + host + "|" + name + "|" + domain + "|" + path)
          },
          on_clear_site: fn(pane, host) {
            cleared.push(pane.to_string() + "|" + host)
          },
          on_close: fn() { open.set(false) },
          return_focus: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "cookies_light")

  // Filter to second cookie ("prefs") and delete it -> verify owner_pane=1 + exact tuple
  filter_field.set("prefs")
  t.frame(ms=16.0)
  debug_assert(t.find("prefs").is_some(), "filtered cookie visible")
  debug_assert(t.find("sid").is_none(), "non-matching cookie hidden")
  t.press("Delete cookie prefs")
  t.frame(ms=16.0)
  debug_assert(
    deleted.length() == 1 && deleted[0] == "1|docs.example.com|prefs|docs.example.com|/v2",
    "delete callback must pass bound owner_pane=1 and exact cookie tuple",
  )

  // Clear site cookies + Back to SiteInfo in Dark mode
  lg::set_dark(Some(true))
  phase3b_audit(t, "cookies_dark")
  t.press("Clear Site Cookies")
  t.press("Back to Site Info")
  t.frame(ms=16.0)
  debug_assert(cleared.length() == 1 && cleared[0] == "1|docs.example.com", "clear site passes owner_pane=1")
  debug_assert(back_clicks.v == 1, "back to Site Info callback fires")

  // Verify IDN punycode host displays human-readable Unicode in header while keeping punycode in RPC callbacks
  host_sig.set("xn--mnchen-3ya.de")
  filter_field.set("")
  t.frame(ms=16.0)
  debug_assert(t.find("münchen.de").is_some(), "IDN host header renders human-readable Unicode")
  t.press("Clear Site Cookies")
  t.frame(ms=16.0)
  debug_assert(cleared.length() == 2 && cleared[1] == "1|xn--mnchen-3ya.de", "RPC clear site preserves canonical ASCII punycode")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: History Drawer renders Today/Earlier with zero empty Yesterday group and clear ranges" {
  let open = signals::signal(true)
  let now_s : Int64 = 1795522600L
  let items_sig : signals::Signal[Array[proto::HistoryItemSummary]] = signals::signal_ref([
    proto::HistoryItemSummary::{
      url: "https://farview.dev/today",
      title: "Farview Architecture",
      host: "farview.dev",
      visit_count: 5,
      last_visit_secs: now_s - 600L,
    },
    proto::HistoryItemSummary::{
      url: "https://w3.org/spec",
      title: "W3C CSS Spec",
      host: "w3.org",
      visit_count: 2,
      last_visit_secs: now_s - 400000L,
    },
  ])
  let search_field = ui::Field::new()
  let opened : Array[String] = []
  let deleted : Array[String] = []
  let cleared_ranges : Array[String] = []

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_history_drawer_panel(
        root,
        HistoryDrawerProps::{
          open: fn() { open.get() },
          items: fn() { items_sig.get() },
          total_count: fn() { items_sig.get().length() },
          now_secs: fn() { now_s },
          search_field,
          on_query_change: fn(_q) { () },
          on_open_url: fn(u) { opened.push(u) },
          on_delete_url: fn(u) { deleted.push(u) },
          on_clear_range: fn(r) { cleared_ranges.push(r) },
          on_close: fn() { open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "history_light")
  debug_assert(t.find("Today").is_some(), "Today section rendered")
  debug_assert(t.find("Earlier").is_some(), "Earlier section rendered")
  debug_assert(t.find("Yesterday").is_none(), "Empty Yesterday section MUST NOT be rendered")

  t.press("Remove W3C CSS Spec from History")
  t.press("Last 24h")
  t.press("All")
  t.frame(ms=16.0)
  debug_assert(deleted.length() == 1 && deleted[0] == "https://w3.org/spec", "history delete forwards exact URL")
  debug_assert(cleared_ranges.length() == 2 && cleared_ranges[0] == "24h" && cleared_ranges[1] == "all", "clear ranges forward keys")

  lg::set_dark(Some(true))
  phase3b_audit(t, "history_dark")
  t.press("Open Farview Architecture")
  t.frame(ms=16.0)
  debug_assert(opened.length() == 1 && opened[0] == "https://farview.dev/today", "history click opens URL")

  // IME double-Esc guard: first Esc while composing keeps History drawer open
  open.set(true)
  t.frame(ms=16.0)
  search_field.focus()
  search_field.compose("ni")
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(open.untracked() && !search_field.composing(), "History IME first Esc cancels composition without closing drawer")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!open.untracked(), "History second Esc closes drawer")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: Bookmarks Drawer supports search, open, delete, toggle current, and empty state" {
  let open = signals::signal(true)
  let snap_sig = signals::signal_ref(
    proto::BookmarksSnapshot::{
      items: [
        proto::BookmarkEntry::{ id: "bm-1", title: "Invar UI", url: "https://github.com/AFK-surf/invar", folder: "", created_ms: 100L },
        proto::BookmarkEntry::{ id: "bm-2", title: "Farview Engine", url: "https://github.com/AFK-surf/farview", folder: "", created_ms: 200L },
      ],
    },
  )
  let search_field = ui::Field::new()
  let toggled = ui::ref_new(0)
  let opened : Array[String] = []
  let deleted : Array[String] = []

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_bookmarks_drawer_panel(
        root,
        BookmarksDrawerProps::{
          open: fn() { open.get() },
          snapshot: fn() { snap_sig.get() },
          current_url: fn() { "https://example.org/new" },
          search_field,
          on_toggle_current: fn() { toggled.v = toggled.v + 1 },
          on_open_url: fn(u) { opened.push(u) },
          on_delete_bookmark: fn(id) { deleted.push(id) },
          on_close: fn() { open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "bookmarks_light")
  t.press("Bookmark Current Page")
  t.press("Delete bookmark Farview Engine")
  t.frame(ms=16.0)
  debug_assert(toggled.v == 1, "toggle current page fires")
  debug_assert(deleted.length() == 1 && deleted[0] == "bm-2", "delete bookmark passes exact id")

  search_field.set("no-such-bookmark")
  t.frame(ms=16.0)
  debug_assert(t.find("No matching bookmarks").is_some(), "empty state shown when filter has 0 matches")

  search_field.set("Invar")
  lg::set_dark(Some(true))
  phase3b_audit(t, "bookmarks_dark")
  t.press("Open bookmark Invar UI")
  t.frame(ms=16.0)
  debug_assert(opened.length() == 1 && opened[0] == "https://github.com/AFK-surf/invar", "open bookmark forwards URL")

  // IME double-Esc guard: first Esc while composing keeps Bookmarks drawer open
  open.set(true)
  t.frame(ms=16.0)
  search_field.focus()
  search_field.compose("ni")
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(open.untracked() && !search_field.composing(), "Bookmarks IME first Esc cancels composition without closing drawer")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!open.untracked(), "Bookmarks second Esc closes drawer")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: Sessions Manager restores and deletes non-first item by exact session_id" {
  let open = signals::signal(true)
  let now_s : Int64 = 1795522600L
  let sessions_sig : signals::Signal[Array[proto::NamedSessionSnapshot]] = signals::signal_ref([
    proto::NamedSessionSnapshot::{
      id: "sess-first",
      name: "Morning Sprint",
      created_secs: now_s - 600L,
      active_space_id: "work",
      spaces: [proto::SessionSpaceItem::{ id: "work", name: "Work", accent: "#2563EB" }],
      folders: [],
      tabs: [proto::SessionTabItem::{ space_id: "work", title: "Home", url: "https://example.com", pinned: false, favorite: false, folder_id: "" }],
    },
    proto::NamedSessionSnapshot::{
      id: "sess-second-exact",
      name: "Release Triage",
      created_secs: now_s - 3600L,
      active_space_id: "ops",
      spaces: [proto::SessionSpaceItem::{ id: "ops", name: "Ops", accent: "#F59E0B" }],
      folders: [],
      tabs: [proto::SessionTabItem::{ space_id: "ops", title: "CI", url: "https://github.com/AFK-surf/farview", pinned: true, favorite: false, folder_id: "" }],
    },
  ])
  let name_field = ui::Field::new()
  let filter_field = ui::Field::new()
  let saved : Array[String] = []
  let restored : Array[String] = []
  let deleted : Array[String] = []

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_sessions_modal_panel(
        root,
        SessionsModalProps::{
          open: fn() { open.get() },
          sessions: fn() { sessions_sig.get() },
          current_space_count: fn() { 2 },
          current_tab_count: fn() { 6 },
          now_secs: fn() { now_s },
          name_field,
          filter_field,
          on_save_session: fn(nm) { saved.push(nm) },
          on_restore_session: fn(sid, nm) { restored.push(sid + "|" + nm) },
          on_delete_session: fn(sid, nm) { deleted.push(sid + "|" + nm) },
          on_close: fn() { open.set(false) },
          return_focus: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "sessions_light")

  // Save current session
  name_field.set("Deep Research")
  t.frame(ms=16.0)
  t.press("Save Current Session")
  t.frame(ms=16.0)
  debug_assert(saved.length() == 1 && saved[0] == "Deep Research", "save session forwards field text")

  // Restore non-first session -> verify exact session_id
  t.press("Restore Session Release Triage")
  t.press("Delete Session Release Triage")
  t.frame(ms=16.0)
  debug_assert(restored.length() == 1 && restored[0] == "sess-second-exact|Release Triage", "restore must pass exact session_id")
  debug_assert(deleted.length() == 1 && deleted[0] == "sess-second-exact|Release Triage", "delete must pass exact session_id")

  lg::set_dark(Some(true))
  phase3b_audit(t, "sessions_dark")
  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: Inline Folder Creator submits folder_new and cancels cleanly at 480pt narrow sidebar" {
  let open = signals::signal(true)
  let name_field = ui::Field::new()
  let color = signals::signal("blue")
  let move_active = signals::signal(false)
  let submitted : Array[String] = []
  let cancelled = ui::ref_new(0)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().sidebar })).padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
      let _ = root.box(fn(sidebar_col : view::View) -> Unit {
        let _ = sidebar_col.width(view::Live::Is(Some(220.0))).rigid()
        build_inline_folder_creator_bar(
          sidebar_col,
          InlineFolderCreatorProps::{
            open: fn() { open.get() },
            name_field,
            color,
            move_active_tab: move_active,
            on_submit: fn(nm, col, mv) {
              submitted.push(nm + "|" + col + "|" + (if mv { "1" } else { "0" }))
            },
            on_cancel: fn() {
              cancelled.v = cancelled.v + 1
              open.set(false)
            },
            return_focus: None,
          },
        )
      })
    },
    width=480.0,
    height=720.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "inline_folder_480_light")

  name_field.set("Design Specs")
  t.press("Folder Color Emerald")
  t.press("Toggle Move Active Tab into Folder")
  t.press("Create Folder")
  t.frame(ms=16.0)
  debug_assert(submitted.length() == 1 && submitted[0] == "Design Specs|emerald|1", "inline folder creator submits name/color/move")

  lg::set_dark(Some(true))
  phase3b_audit(t, "inline_folder_480_dark")
  t.press("Cancel New Folder")
  t.frame(ms=16.0)
  debug_assert(cancelled.v == 1 && !open.untracked(), "cancel closes inline folder creator")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: Spaces Manager creates, switches, renames, and deletes spaces in Light and Dark" {
  let open = signals::signal(true)
  let spaces_sig : signals::Signal[Array[proto::SpaceSummary]] = signals::signal_ref([
    proto::SpaceSummary::{ id: "work", name: "Work", accent: "#2563EB", active: true, tab_count: 5 },
    proto::SpaceSummary::{ id: "personal", name: "Personal", accent: "#10B981", active: false, tab_count: 2 },
  ])
  let active_id = signals::signal("work")
  let new_field = ui::Field::new()
  let new_accent = signals::signal("#2563EB")
  let rename_id = signals::signal("")
  let rename_field = ui::Field::new()
  let color_edit_id = signals::signal("")
  let created : Array[String] = []
  let switched : Array[String] = []
  let renamed : Array[String] = []
  let deleted : Array[String] = []

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_spaces_modal_panel(
        root,
        SpacesModalProps::{
          open: fn() { open.get() },
          spaces: fn() { spaces_sig.get() },
          active_space_id: fn() { active_id.get() },
          new_name_field: new_field,
          new_accent,
          rename_space_id: rename_id,
          rename_field,
          color_edit_space_id: color_edit_id,
          on_create_space: fn(nm, hex) { created.push(nm + "|" + hex) },
          on_switch_space: fn(sid) { switched.push(sid) },
          on_rename_space: fn(sid, nm) { renamed.push(sid + "|" + nm) },
          on_recolor_space: fn(_sid, _hex) { () },
          on_delete_space: fn(sid) { deleted.push(sid) },
          on_close: fn() { open.set(false) },
          return_focus: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "spaces_light")

  new_field.set("Research")
  t.press("Accent Emerald")
  t.press("Create Space")
  t.frame(ms=16.0)
  debug_assert(created.length() == 1 && created[0].starts_with("Research|"), "create space passes name and accent")

  t.press("Switch to Space Personal")
  t.press("Rename Space Personal")
  t.frame(ms=16.0)
  rename_field.set("Life")
  t.press("Save Space Name")
  t.press("Delete Space Personal")
  t.frame(ms=16.0)
  debug_assert(switched.length() == 1 && switched[0] == "personal", "switch space passes exact id")
  debug_assert(renamed.length() == 1 && renamed[0] == "personal|Life", "rename space passes exact id and name")
  debug_assert(deleted.length() == 1 && deleted[0] == "personal", "delete space passes exact id")

  lg::set_dark(Some(true))
  phase3b_audit(t, "spaces_dark")
  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: Closed Tabs Drawer forwards original it.index after search filtering" {
  let open = signals::signal(true)
  let now_s : Int64 = 1795522600L
  let items_sig : signals::Signal[Array[proto::ClosedTabItem]] = signals::signal_ref([
    proto::ClosedTabItem::{ index: 0, title: "Alpha Docs", url: "https://alpha.dev", host: "alpha.dev", space_name: "Work", closed_secs: now_s - 30L },
    proto::ClosedTabItem::{ index: 1, title: "Beta Spec", url: "https://beta.dev", host: "beta.dev", space_name: "Work", closed_secs: now_s - 120L },
    proto::ClosedTabItem::{ index: 2, title: "Gamma Target", url: "https://gamma.dev", host: "gamma.dev", space_name: "Research", closed_secs: now_s - 300L },
    proto::ClosedTabItem::{ index: 3, title: "Gamma Secondary", url: "https://gamma2.dev", host: "gamma2.dev", space_name: "Research", closed_secs: now_s - 500L },
  ])
  let search_field = ui::Field::new()
  let restored_indices : Array[Int] = []
  let cleared = ui::ref_new(0)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_closed_tabs_drawer_panel(
        root,
        ClosedTabsDrawerProps::{
          open: fn() { open.get() },
          items: fn() { items_sig.get() },
          now_secs: fn() { now_s },
          search_field,
          on_restore_tab: fn(orig_idx, _title) { restored_indices.push(orig_idx) },
          on_clear_all: fn() { cleared.v = cleared.v + 1 },
          on_close: fn() { open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "closed_tabs_light")

  // Filter so only Gamma items (orig indices 2 and 3) appear, then click the second filtered item (orig index 3!)
  search_field.set("Gamma")
  t.frame(ms=16.0)
  debug_assert(t.find("Alpha Docs").is_none(), "non-matching closed tab hidden")
  debug_assert(t.find("Gamma Secondary").is_some(), "matching non-first closed tab visible")
  t.press("Restore Gamma Secondary")
  t.frame(ms=16.0)
  debug_assert(
    restored_indices.length() == 1 && restored_indices[0] == 3,
    "filtered closed tab click MUST return original it.index=3 (NOT filtered index 1!)",
  )

  open.set(true)
  lg::set_dark(Some(true))
  phase3b_audit(t, "closed_tabs_dark")
  t.press("Clear All Closed Tabs")
  t.frame(ms=16.0)
  debug_assert(cleared.v == 1, "clear all closed tabs callback fires")

  // IME double-Esc guard: first Esc while composing keeps Closed Tabs drawer open
  open.set(true)
  t.frame(ms=16.0)
  search_field.focus()
  search_field.compose("ni")
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(open.untracked() && !search_field.composing(), "Closed Tabs IME first Esc cancels composition without closing drawer")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!open.untracked(), "Closed Tabs second Esc closes drawer")

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b: Print PDF Modal toggles Paper/Orientation/Margins/BgGraphics, Save forwards config, Cancel emits 0 exports" {
  let open = signals::signal(true)
  let owner_pane = signals::signal(1)
  let paper = signals::signal("a4")
  let orientation = signals::signal("portrait")
  let margins = signals::signal("default")
  let bg_graphics = signals::signal(true)
  let exports : Array[String] = []
  let cancels = ui::ref_new(0)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_print_pdf_modal_panel(
        root,
        PrintPdfModalProps::{
          open: fn() { open.get() },
          owner_pane: fn() { owner_pane.get() },
          page_title: fn() { "Quarterly Report" },
          page_url: fn() { "https://reports.example.com/q4?utm_source=email" },
          paper,
          orientation,
          margins,
          background_graphics: bg_graphics,
          on_save_pdf: fn(pane, cfg) {
            exports.push(
              pane.to_string() +
              "|" +
              cfg.paper +
              "|" +
              cfg.orientation +
              "|" +
              cfg.margins +
              "|" +
              (if cfg.background_graphics { "1" } else { "0" }),
            )
          },
          on_cancel: fn() {
            cancels.v = cancels.v + 1
            open.set(false)
          },
          return_focus: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  lg::set_dark(Some(false))
  phase3b_audit(t, "print_pdf_light")

  // Cancel emits 0 exports
  t.press("Cancel Export PDF")
  t.frame(ms=16.0)
  debug_assert(cancels.v == 1 && exports.length() == 0, "Cancel must emit 0 PDF exports")

  // Reopen, verify all 4 Margins presets (Default / Narrow / Wide / None) + Legal + Landscape + BgGraphics
  open.set(true)
  lg::set_dark(Some(true))
  phase3b_audit(t, "print_pdf_dark")

  t.press("Legal")
  t.press("Landscape")
  t.press("Narrow")
  t.frame(ms=16.0)
  debug_assert(margins.untracked() == "narrow", "Margins Narrow selected")
  t.press("Wide")
  t.frame(ms=16.0)
  debug_assert(margins.untracked() == "wide", "Margins Wide selected")
  t.press("None")
  t.frame(ms=16.0)
  debug_assert(margins.untracked() == "none", "Margins None selected")
  t.press("Default")
  t.frame(ms=16.0)
  debug_assert(margins.untracked() == "default", "Margins Default selected")
  t.press("None")
  t.press("Background graphics")
  t.frame(ms=16.0)
  t.press("Save as PDF")
  t.frame(ms=16.0)
  debug_assert(
    exports.length() == 1 && exports[0] == "1|legal|landscape|none|0",
    "Save as PDF must forward locked owner_pane=1 and selected config including none margins",
  )

  lg::set_dark(Some(false))
  t.dispose()
}

test "phase3b_r1: Bookmarks Drawer renders non-empty folder pill and Print PDF Modal fits 480pt narrow viewport" {
  // 1. Bookmarks Drawer folder pill (`Research Sources`)
  let bm_open = signals::signal(true)
  let snap_sig = signals::signal_ref(
    proto::BookmarksSnapshot::{
      items: [
        proto::BookmarkEntry::{ id: "bm-1", title: "Invar UI", url: "https://github.com/AFK-surf/invar", folder: "Research Sources", created_ms: 100L },
        proto::BookmarkEntry::{ id: "bm-2", title: "Farview Engine", url: "https://github.com/AFK-surf/farview", folder: "", created_ms: 200L },
      ],
    },
  )
  let bm_field = ui::Field::new()
  let t_bm = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_bookmarks_drawer_panel(
        root,
        BookmarksDrawerProps::{
          open: fn() { bm_open.get() },
          snapshot: fn() { snap_sig.get() },
          current_url: fn() { "https://example.org/new" },
          search_field: bm_field,
          on_toggle_current: fn() { () },
          on_open_url: fn(_u) { () },
          on_delete_bookmark: fn(_id) { () },
          on_close: fn() { bm_open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  let mut f0 = 0
  while f0 < 48 {
    t_bm.frame(ms=16.67)
    f0 += 1
  }
  debug_assert(t_bm.find("Research Sources").is_some(), "saved bookmark folder pill must be rendered")
  t_bm.dispose()

  // 2. Print PDF Modal at 480pt narrow viewport: all controls inside [0, 480]
  let open = signals::signal(true)
  let owner_pane = signals::signal(1)
  let paper = signals::signal("a4")
  let orientation = signals::signal("portrait")
  let margins = signals::signal("default")
  let bg_graphics = signals::signal(true)
  let t_pdf = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_print_pdf_modal_panel(
        root,
        PrintPdfModalProps::{
          open: fn() { open.get() },
          owner_pane: fn() { owner_pane.get() },
          page_title: fn() { "Quarterly Report" },
          page_url: fn() { "https://reports.example.com/q4?utm_source=email" },
          paper,
          orientation,
          margins,
          background_graphics: bg_graphics,
          on_save_pdf: fn(_p, _c) { () },
          on_cancel: fn() { open.set(false) },
          return_focus: None,
        },
      )
    },
    width=480.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t_pdf.frame(ms=16.0)
  for label in ["Save as PDF", "Cancel Export PDF", "Wide", "None", "Background graphics", "Close Export PDF Dialog"] {
    let bx = match t_pdf.get(label) {
      Some(v) => v
      None => panic("missing " + label)
    }
    debug_assert(
      bx.x >= 0.0 && bx.x + bx.w <= 480.0,
      label + " out of 480pt viewport: x=" + bx.x.to_string() + " right=" + (bx.x + bx.w).to_string(),
    )
  }
  t_pdf.dispose()
}
