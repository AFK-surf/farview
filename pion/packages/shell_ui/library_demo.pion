///| Demo data for the sidebar modes (offscreen scenes and tests): a few downloads (two pictures drawn here, a PDF, an
///| archive, one running, one failed), boosts and closed tabs, and a Create a Space that adds the Space to the demo
///| controller and switches to it.

import "pixels"
import "proto"
import "signals"
import "ui"

let LIBDEMO_IMG_W : Int = 240
let LIBDEMO_IMG_H : Int = 160

let libdemo_pngs : signals::Ref[Array[(String, Bytes)]] = signals::ref_new([])
let libdemo_hook : signals::Ref[Int] = signals::ref_new(-1)

fn libdemo_mix(a : Int, b : Int, t : Double) -> Int {
  let v = a.to_double() + (b - a).to_double() * t
  if v < 0.0 { 0 } else if v > 255.0 { 255 } else { v.to_int() }
}

///| A small landscape: sky fading to the horizon, a sun, two rolling hills.
fn libdemo_landscape(warm : Bool) -> Bytes {
  let w = LIBDEMO_IMG_W
  let h = LIBDEMO_IMG_H
  let rgba = Bytes::new(w * h * 4)
  let mut y = 0
  while y < h {
    let mut x = 0
    while x < w {
      let fy = y.to_double() / h.to_double()
      let fx = x.to_double() / w.to_double()
      let (sr, sg, sb) = if warm { (255, 176, 120) } else { (120, 170, 235) }
      let (hr, hg, hb) = if warm { (255, 226, 190) } else { (215, 232, 250) }
      let mut r = libdemo_mix(sr, hr, fy * 1.4)
      let mut g = libdemo_mix(sg, hg, fy * 1.4)
      let mut b = libdemo_mix(sb, hb, fy * 1.4)
      // sun
      let dx = fx - 0.7
      let dy = fy - 0.32
      if dx * dx + dy * dy * 2.25 < 0.006 {
        r = 255
        g = if warm { 240 } else { 250 }
        b = if warm { 200 } else { 230 }
      }
      // hills
      let hill1 = 0.62 + 0.08 * dmath_sin(fx * 5.0 + 0.6)
      let hill2 = 0.74 + 0.06 * dmath_sin(fx * 3.4 + 2.0)
      if fy > hill2 {
        r = if warm { 120 } else { 52 }
        g = if warm { 92 } else { 110 }
        b = if warm { 70 } else { 72 }
      } else if fy > hill1 {
        r = if warm { 176 } else { 92 }
        g = if warm { 128 } else { 150 }
        b = if warm { 96 } else { 100 }
      }
      let i = (y * w + x) * 4
      rgba[i] = r.to_byte()
      rgba[i + 1] = g.to_byte()
      rgba[i + 2] = b.to_byte()
      rgba[i + 3] = (255).to_byte()
      x += 1
    }
    y += 1
  }
  pixels::png(w, h, rgba)
}

///| A screenshot-like picture: a window with a bar and text lines.
fn libdemo_screenshot() -> Bytes {
  let w = LIBDEMO_IMG_W
  let h = LIBDEMO_IMG_H
  let rgba = Bytes::new(w * h * 4)
  let mut y = 0
  while y < h {
    let mut x = 0
    while x < w {
      let mut c = 0xF4
      let mut cg = 0xF5
      let mut cb = 0xF7
      if y < 22 {
        c = 0xE3
        cg = 0xE5
        cb = 0xEA
      } else if x > 20 && x < 220 && (y - 34) % 16 < 6 && y < 140 {
        let line_end = 200 - ((y / 16) % 3) * 40
        if x < line_end {
          c = 0xC6
          cg = 0xCA
          cb = 0xD2
        }
      }
      if y > 40 && y < 100 && x > 150 && x < 214 {
        c = 0x6E
        cg = 0x8F
        cb = 0xD8
      }
      let i = (y * w + x) * 4
      rgba[i] = c.to_byte()
      rgba[i + 1] = cg.to_byte()
      rgba[i + 2] = cb.to_byte()
      rgba[i + 3] = (255).to_byte()
      x += 1
    }
    y += 1
  }
  pixels::png(w, h, rgba)
}

fn dmath_sin(x : Double) -> Double {
  // (a short series is plenty for a hill line)
  let pi = 3.141592653589793
  let mut v = x
  while v > pi {
    v = v - 2.0 * pi
  }
  while v < -pi {
    v = v + 2.0 * pi
  }
  let v2 = v * v
  v * (1.0 - v2 / 6.0 * (1.0 - v2 / 20.0 * (1.0 - v2 / 42.0)))
}

fn libdemo_register() -> Unit {
  for e in libdemo_pngs.v {
    if ui::image_bytes_for(e.0).is_none() {
      ui::add_image(e.0, e.1)
    }
  }
}

///| Registers the demo pictures (again before any frame that finds them gone: an offscreen renderer resets its
///| pictures after building the tree).
pub fn demo_library_images() -> Unit {
  if libdemo_pngs.v.length() == 0 {
    libdemo_pngs.v = [
      ("fv-demo-lib-coast", libdemo_landscape(false)),
      ("fv-demo-lib-dusk", libdemo_landscape(true)),
      ("fv-demo-lib-shot", libdemo_screenshot()),
    ]
  }
  libdemo_register()
  // (anew on each call: a host or test that cleared its hooks leaves a stale id; removing it is a no-op)
  if libdemo_hook.v >= 0 {
    ui::remove_before_frame(libdemo_hook.v)
  }
  libdemo_hook.v = ui::on_before_frame(libdemo_register)
}

