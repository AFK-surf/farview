fn libdemo_boost(host : String, theme : String, enabled : Bool) -> proto::SiteBoost {
  proto::SiteBoost::{
    host,
    enabled,
    theme,
    font: "",
    scale_pct: proto::BOOST_SCALE_DEFAULT,
    hide_sticky: false,
    custom_css: "",
    tint: "",
    tint_pct: 0,
    brightness_pct: 100,
    contrast_pct: 100,
    invert: false,
    zapped: [],
    custom_js: "",
  }
}

pub fn demo_library_boosts() -> Array[proto::SiteBoost] {
  [
    libdemo_boost("news.ycombinator.com", "dark", true),
    proto::SiteBoost::{ ..libdemo_boost("en.wikipedia.org", "sepia", true), font: "serif" },
    proto::SiteBoost::{ ..libdemo_boost("github.com", "", true), zapped: [".footer"] },
    libdemo_boost("example.com", "contrast", false),
  ]
}

pub fn demo_library_closed(now : Int64) -> Array[proto::ClosedTabItem] {
  [
    proto::ClosedTabItem::{ index: 0, title: "Flexbox — Invar docs", url: "https://invar.dev/docs/flex", host: "invar.dev", space_name: "Work", closed_secs: now - 120L, tab_id: "" },
    proto::ClosedTabItem::{ index: 1, title: "Train times — Zürich HB", url: "https://sbb.ch/en", host: "sbb.ch", space_name: "Life", closed_secs: now - 3000L, tab_id: "" },
    proto::ClosedTabItem::{ index: 2, title: "Pion language tour", url: "https://pion-lang.org/tour", host: "pion-lang.org", space_name: "Work", closed_secs: now - 9000L, tab_id: "" },
    proto::ClosedTabItem::{ index: 3, title: "Sourdough starter guide", url: "https://bread.example.com/starter", host: "bread.example.com", space_name: "Life", closed_secs: now - 100000L, tab_id: "" },
  ]
}

///| How many tabs a demo Space holds (the active one: its tabs as listed; the others: fixed counts, a new one 1).
fn demo_space_tab_count(ctrl : ShellController, id : String) -> Int {
  if id == "personal" {
    7
  } else if id == "lab" {
    3
  } else if id == "work" {
    let mut n = 0
    for t in ctrl.model().tabs() {
      if t.space_id == "work" {
        n += 1
      }
    }
    n
  } else {
    1
  }
}

///| The host's second broadcast after a new Space (demo): its theme lands on it.
pub fn demo_land_space_theme(ctrl : ShellController, id : String, theme : proto::SpaceTheme) -> Unit {
  let out : Array[ShellSpaceItem] = []
  for sp in ctrl.spaces.untracked() {
    out.push(if sp.id == id { ShellSpaceItem::{ ..sp, theme } } else { sp })
  }
  ctrl.spaces.set(out)
}

///| Sidebar modes over the demo controller: Create Space adds the Space (with its theme) and switches to it; the
///| Library shows the demo data (`empty`: nothing). `created` collects what Create Space made.
pub fn demo_sidebar_modes(
  ctrl : ShellController,
  state : SidebarModeState,
  empty~ : Bool = false,
  created? : Array[(String, proto::SpaceTheme)],
  two_step~ : Bool = false,
) -> SidebarModeProps {
  let now = 1_800_000_000L
  let boosts : signals::Signal[Array[proto::SiteBoost]] = signals::signal_ref(if empty { [] } else { demo_library_boosts() })
  SidebarModeProps::{
    state,
    on_new_space: fn() { state.start_create(create_space_default_theme(ctrl.spaces.untracked().length())) },
    on_create: fn(name, theme) {
      match created {
        Some(c) => c.push((name, theme))
        None => ()
      }
      let id = "space-" + ctrl.spaces.untracked().length().to_string()
      let list = ctrl.spaces.untracked().copy()
      // (`two_step`: as the app's host does, the Space first arrives with its accent alone; its theme lands later,
      // `demo_land_space_theme`)
      list.push(ShellSpaceItem::{ id, name, accent_rgba: theme.points[0].rgba, theme: if two_step { proto::space_theme_unset() } else { theme } })
      ctrl.spaces.set(list)
      ctrl.active_space_id.set(id)
    },
    escape_in_frame: true,
    on_open_library: fn() { state.open_library() },
    library: LibraryProps::{
      ..LibraryProps::empty(),
      files: fn() { if empty { [] } else { demo_library_files() } },
      boosts: fn() { boosts.get() },
      closed_tabs: fn() { if empty { [] } else { demo_library_closed(now) } },
      now_secs: fn() { now },
      space_tab_count: fn(id) { demo_space_tab_count(ctrl, id) },
      on_switch_space: fn(id) { ctrl.dispatch(ShellIntent::SelectSpace(id)) },
      on_save_boost: fn(b) {
        let out : Array[proto::SiteBoost] = []
        for x in boosts.untracked() {
          out.push(if x.host == b.host { b } else { x })
        }
        boosts.set(out)
      },
    },
  }
}
