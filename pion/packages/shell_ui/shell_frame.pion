///| Farview Desktop Shell 2.0 — Tahoe / Arc Liquid Glass v8 ShellFrame (pure Pion-JSX `.pion`).
///|
///| Architectural invariants:
///| 1. Solid Content Layer (`lg::surface()`) for window canvas, Arc full-height sidebar,
///|    Mini Media Player, and web/reader panes. NEVER wraps web canvas in `lg::SplitShell`/`lg::PageShell`.
///| 2. Explicit `DESIGN.md` scroll-under exception: dedicated 44pt solid titleband above the web
///|    viewport so browser chrome never obscures page inputs, always shows the verified URL,
///|    supports `.moves_window(true)` dragging on empty space, and unifies dynamic traffic-light
///|    clearance (`ui::window_inset_now()` / `window_inset_override`) across full-height sidebar
///|    and collapsed titleband.
///| 3. All 5 dynamic lists (Favorites, Folders, Tabs, Spaces, Omnibox Suggestions) use keyed
///|    `View::each` for true reactive updates (zero `untracked` frozen loops).
///| 4. Address bar security indicator (`OmniboxSecurity`) is 100% reactive: HTTPS lock, HTTP
///|    insecure warning, Editing/Search icon, Internal globe. Idle Field holds full URL.
///| 5. All overlays mount inside `body` (`y >= 44`): Omnibox suggestions aligned to Address Bar
///|    with dense high-contrast glass (`>= 4.5:1` over colorful pages) + click-outside dismiss;
///|    Page Controls Drawer is non-modal (`scrim=false`, no 44pt scrim cut line); Modal Dialog uses
///|    `headless::dialog` for real `Tab`/`Shift+Tab` focus trap and `return_focus`.
///| 6. Narrow `< 720pt` turns Sidebar into a toggleable Leading floating drawer; `480pt` keeps
///|    Back button directly in the left titleband pill (Reload moves to More Menu).
///| 7. Primary `PaneSlot` mounts ONCE (live == 1, mount delta == 0 across all layout/resize/swap);
///|    Secondary `PaneSlot` reuses across `Split <-> Peek` (0 remounts) and unmounts cleanly on `Single`.

import "headless"
import "icons"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

pub let SHELL_TITLEBAND_H : Double = 44.0
pub let SHELL_PILL_H : Double = 36.0
pub let SHELL_SIDEBAR_W_WIDE : Double = 244.0
pub let SHELL_SIDEBAR_W_NARROW : Double = 208.0
pub let SHELL_SIDEBAR_BREAKPOINT : Double = 720.0
pub let SHELL_COMPACT_BREAKPOINT : Double = 560.0
pub let SHELL_CANVAS_GAP : Double = 8.0
pub let SHELL_TRAFFIC_LIGHT_INSET : Double = 74.0
pub let SHELL_SPLIT_BAR_H : Double = 42.0

///| Computes the web canvas corner radius concentrically from the window corner radius.
pub fn shell_canvas_radius() -> Double {
  let win_r = ui::tree_corner_roots_now().window
  let outer = if win_r > 0.0 { win_r } else { 20.0 }
  lg::concentric(outer, SHELL_CANVAS_GAP)
}

///| Computes effective docked sidebar width for a window width and dock state.
pub fn shell_sidebar_width(window_w : Double, sidebar_open : Bool) -> Double {
  if !sidebar_open || window_w < SHELL_SIDEBAR_BREAKPOINT {
    0.0
  } else if window_w < 960.0 {
    SHELL_SIDEBAR_W_NARROW
  } else {
    SHELL_SIDEBAR_W_WIDE
  }
}

///| Computes dynamic macOS traffic-light clearance (supports deterministic test/shot override).
pub fn shell_traffic_light_inset(model : ShellModel) -> Double {
  match model.window_inset_override {
    Some(px) => if px > 0.0 { px } else { 0.0 }
    None => if ui::window_inset_now() { SHELL_TRAFFIC_LIGHT_INSET } else { 0.0 }
  }
}

fn bar_icon_btn(
  parent : view::View,
  label : String,
  icon_name : String,
  on_press : () -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  capture_ref? : signals::Ref[Option[view::View]],
  loc~ : String = "",
) -> Unit {
  let v = lg::liquid_button_node(
    parent,
    fn() { label },
    on_press,
    content=fn(inner : view::View) -> Unit {
      let _ = shell_icon(
        inner,
        icon_name,
        size=15.0,
        color_by=fn() {
          if disabled() {
            lg::surface().ink_tertiary
          } else if active() {
            lg::surface().accent
          } else {
            lg::surface().ink
          }
        },
        loc=loc,
      )
    },
    flat=true,
    ghost=true,
    height=30.0,
    pad_x=11.0,
    active=active,
    neutral_active=true,
    disabled=disabled,
    loc=loc,
  )
  match capture_ref {
    Some(r) => r.v = Some(v)
    None => ()
  }
}

///| Renders a single sidebar tab row (`r_row = 12pt`, keyed `Signal[ShellTabItem]`).
///| Hover close button overlays the trailing edge (`.over`) so hovering NEVER reflows the title!
fn build_tab_row(
  parent : view::View,
  item_sig : signals::Signal[ShellTabItem],
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
) -> Unit {
  let is_active = fn() -> Bool { item_sig.get().active }
  let tab_title = fn() -> String { item_sig.get().title }
  let _ = parent.box(fn(slot : view::View) -> Unit {
    let _ = slot
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(36.0)))
    .radius(view::Live::Is(lg::r_row))
    .padding(view::Live::Is((8.0, 2.0, 8.0, 2.0)))
    .gap(view::Live::Is(6.0))
    .ground(view::Live::By(fn() {
      if is_active() {
        if model.dark() { 0x2A2C32FFL } else { lg::surface().card }
      } else if slot.pointed() || slot.pointed_in() {
        lg::surface().row_hover
      } else {
        0x00000000L
      }
    }))
    .edge(view::Live::By(fn() {
      if is_active() {
        (lg::hairline_w, lg::surface().separator_strong)
      } else {
        (0.0, 0x00000000L)
      }
    }))

    let _ = headless::button(
      slot,
      tab_title,
      fn(_e) -> Unit { emit(ShellIntent::SelectTab(item_sig.untracked().id)) },
      fn(btn_v : view::View, _btn : headless::Button) -> Unit {
        let _ = btn_v
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .min_height(view::Live::Is(Some(36.0)))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(7.0))
        let _ = shell_icon(
          btn_v,
          ICON_GLOBE,
          size=14.0,
          color_by=fn() { if is_active() { lg::surface().accent } else { lg::surface().ink_secondary } },
        )
        let _ = btn_v.box(fn(tw : view::View) -> Unit {
          let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
          let _ = <ui::Text
            in={tw}
            size={13.0}
            weight={500}
            color_by=>{if is_active() { lg::surface().ink } else { lg::surface().ink_secondary }}
            text_by=>{tab_title()}
          />.allow_ellipsis(view::Live::Is(true))
        })
      },
    )

    // Hover-revealed close button: mounted via `show` (NEVER `alpha=0`) and overlaid at trailing edge
    // so hovering a tab row never reflows or shifts the title!
    slot.show(fn() { slot.pointed() || slot.pointed_in() }, fn(close_wrap : view::View) -> Unit {
      let _ = close_wrap
      .over(view::Live::Is(true), edges=(None, Some(0.0), Some(2.0), Some(0.0)))
      .center()
      let _ = headless::button(
        close_wrap,
        fn() { "Close " + tab_title() },
        fn(_e) -> Unit { emit(ShellIntent::CloseTab(item_sig.untracked().id)) },
        fn(cb : view::View, btn : headless::Button) -> Unit {
          let _ = cb
          .width(view::Live::Is(Some(36.0)))
          .height(view::Live::Is(Some(36.0)))
          .radius(view::Live::Is(10.0))
          .center()
          .ground(view::Live::By(fn() {
            if btn.hovered() {
              lg::surface().card_secondary
            } else {
              if model.dark() { 0x2A2C32E6L } else { 0xFFFFFFE6L }
            }
          }))
          let _ = shell_icon(cb, ICON_CLOSE, size=12.0, color_by=fn() { lg::surface().ink_secondary })
        },
      )
    })
  })
}

///| Builds the reusable Arc Sidebar contents (100% keyed `View::each`, 100% solid `lg::surface()`).
///| Shared between the docked full-height sidebar (`w >= 720`) and the narrow floating drawer (`w < 720`).
fn build_sidebar_contents(
  sb : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  include_top_drag_header : Bool,
) -> Unit {
  // 1. Optional 44pt full-height top drag band absorbing macOS traffic-light clearance
  if include_top_drag_header {
    let _ = sb.box(fn(drag_hdr : view::View) -> Unit {
      let _ = drag_hdr
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(SHELL_TITLEBAND_H)))
      .shrink(view::Live::Is(0.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Between))
      .padding(view::Live::By(fn() {
        let inset = shell_traffic_light_inset(model)
        let pl = if inset > 0.0 { inset } else { 4.0 }
        (pl, 0.0, 4.0, 0.0)
      }))
      .moves_window(view::Live::Is(true))

      let _ = <ui::Row in={drag_hdr} align={.Middle} gap={6.0} rigid>
        <icons::Icon name={ICON_LAYERS} size={14.0} color_by=>{lg::surface().accent} />
        <ui::Text
          size={13.0}
          weight={600}
          color_by=>{lg::surface().ink}
          text_by=>{
            let sid = model.active_space_id()
            let list = model.spaces()
            let mut name = "Work"
            let mut i = 0
            while i < list.length() {
              if list[i].id == sid {
                name = list[i].name
                break
              }
              i += 1
            }
            name
          }
        />
      </ui::Row>
      let _ = <ui::Text
        in={drag_hdr}
        size={11.0}
        color_by=>{lg::surface().ink_secondary}
        text_by=>{
          let sid = model.active_space_id()
          let all = model.tabs()
          let mut n = 0
          let mut i = 0
          while i < all.length() {
            if all[i].space_id == sid || all[i].space_id == "" {
              n += 1
            }
            i += 1
          }
          n.to_string() + (if n == 1 { " tab" } else { " tabs" })
        }
      />
    })
  }

  // 2. Favorites 3-column grid (keyed `View::each`)
  let _ = sb.box(fn(fav_grid : view::View) -> Unit {
    let _ = fav_grid.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).rigid()
    fav_grid.each(
      model.favorites,
      fn(f : ShellFavoriteItem) -> String { f.id },
      fn(row : view::View, fav_sig : signals::Signal[ShellFavoriteItem]) -> Unit {
        let _ = row.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
        let _ = headless::button(
          row,
          fn() { fav_sig.get().title },
          fn(_e) -> Unit { emit(ShellIntent::Navigate(fav_sig.untracked().url)) },
          fn(tile : view::View, btn : headless::Button) -> Unit {
            let _ = tile
            .fill()
            .height(view::Live::Is(Some(46.0)))
            .radius(view::Live::Is(lg::r_row))
            .center()
            .ground(view::Live::By(fn() {
              if btn.pressed() || btn.hovered() {
                lg::surface().card_secondary
              } else {
                lg::surface().card
              }
            }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
            <ui::Box in={tile} width={22.0} height={22.0} radius={6.0} center bg_by=>{fav_sig.get().accent_rgba}>
              <ui::Text size={11.0} weight={700} color_by=>{0xFFFFFFFFL} text_by=>{fav_sig.get().monogram} />
            </ui::Box>
          },
        )
      },
      at_once=true,
    )
  })

  // 3. Scrollable Pinned Folders + Today Tabs list (all keyed `View::each`, uniform `gap=4.0`)
  let _ = sb.box(fn(scroll_host : view::View) -> Unit {
    let _ = scroll_host.fill()
    let _ = ui::scroll_box(scroll_host, fn(list : view::View) -> Unit {
      let _ = list.gap(view::Live::Is(4.0)).padding(view::Live::Is((0.0, 2.0, 2.0, 4.0)))

      // Keyed folders list
      let _ = list.box(fn(folders_col : view::View) -> Unit {
        let _ = folders_col.gap(view::Live::Is(4.0))
        folders_col.each(
          model.folders,
          fn(f : ShellFolderItem) -> String { f.id },
          fn(fwrap : view::View, folder_sig : signals::Signal[ShellFolderItem]) -> Unit {
            let _ = fwrap.gap(view::Live::Is(4.0))
            let is_collapsed = fn() -> Bool { folder_sig.get().collapsed }
            let _ = headless::button(
              fwrap,
              fn() { folder_sig.get().name },
              fn(_e) -> Unit { emit(ShellIntent::ToggleFolder(folder_sig.untracked().id)) },
              fn(fh : view::View, btn : headless::Button) -> Unit {
                let _ = fh
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .min_height(view::Live::Is(Some(36.0)))
                .padding(view::Live::Is((8.0, 4.0, 8.0, 4.0)))
                .gap(view::Live::Is(6.0))
                .radius(view::Live::Is(lg::r_row))
                .ground(view::Live::By(fn() {
                  if btn.hovered() { lg::surface().row_hover } else { 0x00000000L }
                }))
                fh.show(fn() { is_collapsed() }, fn(ic : view::View) -> Unit {
                  let _ = shell_icon(ic, ICON_CHEVRON_RIGHT, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                })
                fh.show(fn() { !is_collapsed() }, fn(ic : view::View) -> Unit {
                  let _ = shell_icon(ic, ICON_CHEVRON_DOWN, size=13.0, color_by=fn() { lg::surface().ink_secondary })
                })
                let _ = shell_icon(fh, ICON_FOLDER, size=14.0, color_by=fn() { lg::surface().ink_secondary })
                <ui::Text in={fh} size={12.0} weight={600} color_by=>{lg::surface().ink} text_by=>{folder_sig.get().name} />
              },
            )
            // Folder children tabs (keyed `View::each`, uniform `gap=4.0`)
            fwrap.show(fn() { !is_collapsed() }, fn(fc : view::View) -> Unit {
              let _ = fc.padding(view::Live::Is((12.0, 0.0, 0.0, 0.0))).gap(view::Live::Is(4.0))
              fc.each(
                fn() -> Array[ShellTabItem] {
                  let fid = folder_sig.get().id
                  let sid = model.active_space_id()
                  let all = model.tabs()
                  let out : Array[ShellTabItem] = []
                  let mut i = 0
                  while i < all.length() {
                    let t = all[i]
                    if t.folder_id == fid && (t.space_id == sid || t.space_id == "") {
                      out.push(t)
                    }
                    i += 1
                  }
                  out
                },
                fn(t : ShellTabItem) -> String { t.id },
                fn(row : view::View, tsig : signals::Signal[ShellTabItem]) -> Unit {
                  build_tab_row(row, tsig, model, emit)
                },
                at_once=true,
              )
            })
          },
          at_once=true,
        )
      })

      // TODAY header
      <ui::Row in={list} align={.Middle} along={.Between} pad_x={8.0} pad_y={4.0} rigid>
        <ui::Text size={11.0} weight={600} color_by=>{lg::surface().ink_secondary} text="TODAY" />
      </ui::Row>

      // New Tab button
      let _ = headless::button(
        list,
        fn() { "New Tab" },
        fn(_e) -> Unit { emit(ShellIntent::NewTab) },
        fn(nt : view::View, btn : headless::Button) -> Unit {
          let _ = nt
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .min_height(view::Live::Is(Some(36.0)))
          .padding(view::Live::Is((8.0, 4.0, 8.0, 4.0)))
          .gap(view::Live::Is(8.0))
          .radius(view::Live::Is(lg::r_row))
          .ground(view::Live::By(fn() {
            if btn.hovered() { lg::surface().row_hover } else { 0x00000000L }
          }))
          let _ = shell_icon(nt, ICON_PLUS, size=14.0, color_by=fn() { lg::surface().ink_secondary })
          <ui::Text in={nt} size={13.0} color_by=>{lg::surface().ink_secondary} text="New Tab" />
        },
      )

      // Keyed Today tabs list (uniform `gap=4.0`)
      let _ = list.box(fn(today_col : view::View) -> Unit {
        let _ = today_col.gap(view::Live::Is(4.0))
        today_col.each(
          fn() -> Array[ShellTabItem] {
            let sid = model.active_space_id()
            let all = model.tabs()
            let out : Array[ShellTabItem] = []
            let mut i = 0
            while i < all.length() {
              let t = all[i]
              if t.folder_id == "" && (t.space_id == sid || t.space_id == "") {
                out.push(t)
              }
              i += 1
            }
            out
          },
          fn(t : ShellTabItem) -> String { t.id },
          fn(row : view::View, tsig : signals::Signal[ShellTabItem]) -> Unit {
            build_tab_row(row, tsig, model, emit)
          },
          at_once=true,
        )
      })
    })
  })

  // 4. Solid Mini Media Player Card (ZERO glass, true flex-ratio progress bar!)
  sb.show(fn() { model.mini_player().is_visible() }, fn(mp_host : view::View) -> Unit {
    let _ = mp_host.rigid()
    <lg::SurfaceCard in={mp_host} radius={lg::r_row} pad={10.0} gap={8.0} label="Mini Media Player">
      <ui::Col gap={2.0} rigid>
        <ui::Text
          size={12.0}
          weight={600}
          lines={1}
          color_by=>{lg::surface().ink}
          text_by=>{model.mini_player().title}
        />
        <ui::Text
          size={11.0}
          lines={1}
          color_by=>{lg::surface().ink_secondary}
          text_by=>{model.mini_player().domain}
        />
      </ui::Col>
      // True proportional progress track (flex grow = ratio vs 1 - ratio, identical at 1280 & 760!)
      <ui::Row height={3.0} radius={1.5} clip bg_by=>{lg::surface().separator} rigid>
        <ui::Box
          height={3.0}
          radius={1.5}
          grow={1.0}
          bg_by=>{lg::surface().accent}
          ref_view={fn(bar : view::View) -> Unit {
            let _ = bar
            .grow(view::Live::By(fn() {
              let r = model.mini_player().progress_ratio()
              if r < 0.001 { 0.001 } else if r > 1.0 { 1.0 } else { r }
            }))
            .basis(view::Live::Is(Some(0.0)))
          }}
        />
        <ui::Box
          height={3.0}
          grow={1.0}
          ref_view={fn(rem : view::View) -> Unit {
            let _ = rem
            .grow(view::Live::By(fn() {
              let r = model.mini_player().progress_ratio()
              let left = 1.0 - r
              if left < 0.001 { 0.001 } else if left > 1.0 { 1.0 } else { left }
            }))
            .basis(view::Live::Is(Some(0.0)))
          }}
        />
      </ui::Row>
      <ui::Row align={.Middle} along={.Between} gap={6.0} rigid>
        <ui::Text
          size={11.0}
          weight={500}
          color_by=>{lg::surface().ink_secondary}
          text_by=>{model.mini_player().status_label()}
        />
        <ui::Row align={.Middle} gap={4.0} rigid>
          <lg::Button
            flat
            ghost
            height={30.0}
            pad_x={11.0}
            label_by=>{if model.mini_player().playing { "Pause Media" } else { "Play Media" }}
            on_press=>{emit(ShellIntent::MediaTogglePlay)}
          >
            <ui::Show when=>{model.mini_player().playing}>
              <icons::Icon name={ICON_PAUSE} size={14.0} color_by=>{lg::surface().ink} />
            </ui::Show>
            <ui::Show when=>{!model.mini_player().playing}>
              <icons::Icon name={ICON_PLAY} size={14.0} color_by=>{lg::surface().ink} />
            </ui::Show>
          </lg::Button>
          <lg::Button
            flat
            ghost
            height={30.0}
            pad_x={11.0}
            label_by=>{if model.mini_player().muted { "Unmute Media" } else { "Mute Media" }}
            on_press=>{emit(ShellIntent::MediaToggleMute)}
          >
            <ui::Show when=>{model.mini_player().muted}>
              <icons::Icon name={ICON_VOLUME_MUTE} size={14.0} color_by=>{lg::surface().ink_secondary} />
            </ui::Show>
            <ui::Show when=>{!model.mini_player().muted}>
              <icons::Icon name={ICON_VOLUME} size={14.0} color_by=>{lg::surface().ink_secondary} />
            </ui::Show>
          </lg::Button>
        </ui::Row>
      </ui::Row>
    </lg::SurfaceCard>
  })

  // 5. Bottom Space switcher bar (keyed `View::each`, solid chips)
  let _ = sb.box(fn(sp_bar : view::View) -> Unit {
    let _ = sp_bar
    .row(view::Live::Is(true))
    .gap(view::Live::Is(4.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .rigid()
    sp_bar.each(
      model.spaces,
      fn(sp : ShellSpaceItem) -> String { sp.id },
      fn(wrap : view::View, sp_sig : signals::Signal[ShellSpaceItem]) -> Unit {
        let _ = wrap.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
        let is_active = fn() -> Bool { model.active_space_id() == sp_sig.get().id }
        let _ = headless::button(
          wrap,
          fn() { "Space " + sp_sig.get().name },
          fn(_e) -> Unit { emit(ShellIntent::SelectSpace(sp_sig.untracked().id)) },
          fn(b : view::View, btn : headless::Button) -> Unit {
            let _ = b
            .fill()
            .height(view::Live::Is(Some(36.0)))
            .radius(view::Live::Is(lg::r_chip))
            .center()
            .ground(view::Live::By(fn() {
              if is_active() {
                if model.dark() { 0x2A2C32FFL } else { lg::surface().card }
              } else if btn.hovered() {
                lg::surface().row_hover
              } else {
                0x00000000L
              }
            }))
            .edge(view::Live::By(fn() {
              if is_active() {
                (lg::hairline_w, lg::surface().separator_strong)
              } else {
                (0.0, 0x00000000L)
              }
            }))
            <ui::Text
              in={b}
              size={12.0}
              weight={500}
              color_by=>{if is_active() { lg::surface().ink } else { lg::surface().ink_secondary }}
              text_by=>{sp_sig.get().name}
            />
          },
        )
      },
      at_once=true,
    )
  })
}

///| Builds the Omnibox Liquid Glass suggestion popover inside `body` (`y >= 52`, zero topbar overlap).
///| - Aligned horizontally with the Address Bar (`left_inset` / `width` matching the Omnibox pill).
///| - Click-outside transparent backdrop closes suggestions.
///| - Keyed `View::each` updates rows reactively as query/results change.
///| - Dense high-contrast glass (`tint_light = 0xFBFBFDE8L`) + `lg::surface().ink` guarantees
///|   >= 4.5:1 measured pixel contrast on Light, Dark, AND high-saturation Colorful backdrops!
fn build_omnibox_overlay(
  body : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  omni_wrap_ref : signals::Ref[Option[view::View]],
  omni_panel_ref : signals::Ref[Option[view::View]],
  content_w : () -> Double,
  is_compact : () -> Bool,
) -> Unit {
  let is_open = fn() -> Bool {
    model.omnibox_suggest().open && (model.exclusive().active is ExclusiveKind::OmniboxSuggest)
  }
  let _ = body.box(fn(ov_host : view::View) -> Unit {
    let _ = ov_host.over(view::Live::Is(true)).points(view::Live::Is(false))
    ov_host.show(is_open, fn(layer : view::View) -> Unit {
      let _ = layer.over(view::Live::Is(true))

      // Click-outside dismiss scrim (starts at y>=5 so zero overlap with Address Bar 36pt hit area)
      let _ = headless::button(
        layer,
        fn() { "Dismiss Suggestions" },
        fn(_e) -> Unit { emit(ShellIntent::OmniboxClose) },
        fn(outside : view::View, _btn : headless::Button) -> Unit {
          let _ = outside
          .over(view::Live::Is(true), edges=(Some(0.0), Some(5.0), Some(0.0), Some(0.0)))
          .ground(view::Live::Is(0x00000001L))
        },
      )

      // Dynamically align popover left edge & width to the ACTUAL placed Address Bar capsule!
      // Reading `laid_size_told()` reactively subscribes to frame-0 layout AND every resize/sidebar/inset change.
      // When Address Bar width >= 240pt, BOTH left and right edges align within <= 1pt;
      // when < 240pt, panel keeps 240pt minimum width and shifts left if needed to stay inside window bounds.
      let calc_geom = fn() -> (Double, Double) {
        let cw = content_w()
        let _ = model.dock()
        let _ = shell_traffic_light_inset(model)
        let _ = body.laid_size_told()
        let _ = is_compact()
        match omni_wrap_ref.v {
          Some(ov) => {
            let _ = ov.laid_size_told()
            let (ox, _, ow, _) = ov.placed_window_now()
            let (bx, _, bw, _) = body.placed_window_now()
            let avail_bw = if bw > 20.0 { bw } else { cw }
            if ow > 20.0 {
              let raw_left = if ox - bx >= 0.0 { ox - bx } else { 0.0 }
              let min_w = if avail_bw - 16.0 < 240.0 { avail_bw - 16.0 } else { 240.0 }
              let w = if ow >= min_w { ow } else { min_w }
              let max_left = avail_bw - w - 8.0
              let left = if raw_left > max_left {
                if max_left >= 8.0 { max_left } else { 0.0 }
              } else {
                raw_left
              }
              (left, w)
            } else {
              (8.0, if cw - 16.0 > 240.0 { cw - 16.0 } else { 240.0 })
            }
          }
          None => (8.0, if cw - 16.0 > 240.0 { cw - 16.0 } else { 240.0 })
        }
      }
      let left_offset = fn() -> Double {
        let (l, _) = calc_geom()
        l
      }
      let pop_w = fn() -> Double {
        let (_, w) = calc_geom()
        w
      }

      let _ = layer.box(fn(anchor_wrap : view::View) -> Unit {
        let _ = anchor_wrap
        .over(view::Live::Is(true), edges=(Some(0.0), Some(5.0), None, None))
        .margin(view::Live::By(fn() { (left_offset(), 0.0, 0.0, 0.0) }))
        .width(view::Live::By(fn() { Some(pop_w()) }))

        // Dense high-contrast single-layer Liquid Glass shell (>= 4.5:1 even over vivid crimson/cobalt!)
        let _ = lg::liquid_dialog_shell_node(
          anchor_wrap,
          fn(panel : view::View) -> Unit {
            omni_panel_ref.v = Some(panel)
            let _ = panel
            .width(view::Live::By(fn() { Some(pop_w()) }))
            .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
            .gap(view::Live::Is(4.0))
            .says(view::Live::Is(Some(view::said(view::Role::Region, label="Omnibox Suggestions"))))

            // Keyed reactive Omnibox suggestion rows
            panel.each(
              fn() -> Array[ShellOmniboxRow] { build_omnibox_rows(model.omnibox_suggest().items) },
              fn(r : ShellOmniboxRow) -> String { r.key },
              fn(slot : view::View, row_sig : signals::Signal[ShellOmniboxRow]) -> Unit {
                let _ = slot.gap(view::Live::Is(2.0))
                slot.show(fn() { row_sig.get().section_header != "" }, fn(sh : view::View) -> Unit {
                  let _ = sh.padding(view::Live::Is((10.0, 4.0, 10.0, 2.0))).rigid()
                  let _ = <ui::Text
                    in={sh}
                    size={11.0}
                    weight={600}
                    color_by=>{lg::surface().ink}
                    text_by=>{row_sig.get().section_header}
                  />
                })

                let is_sel = fn() -> Bool { model.omnibox_suggest().selected == row_sig.get().idx }
                let _ = headless::button(
                  slot,
                  fn() { row_sig.get().title },
                  fn(_e) -> Unit { emit(ShellIntent::OmniboxSelectIndex(row_sig.untracked().idx)) },
                  fn(row : view::View, btn : headless::Button) -> Unit {
                    let _ = row
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Start)))
                    .min_height(view::Live::Is(Some(42.0)))
                    .padding(view::Live::Is((10.0, 7.0, 10.0, 7.0)))
                    .gap(view::Live::Is(10.0))
                    .radius(view::Live::Is(lg::concentric(20.0, 8.0)))
                    .ground(view::Live::By(fn() {
                      if is_sel() {
                        if model.dark() { 0x0A84FF40L } else { 0x007AFF24L }
                      } else if btn.hovered() {
                        lg::surface().row_hover
                      } else {
                        0x00000000L
                      }
                    }))
                    let _ = row.box(fn(ic_wrap : view::View) -> Unit {
                      let _ = ic_wrap
                      .width(view::Live::Is(Some(15.0)))
                      .height(view::Live::Is(Some(15.0)))
                      .shrink(view::Live::Is(0.0))
                      .center()
                      let _ = shell_icon(
                        ic_wrap,
                        row_sig.untracked().icon_name,
                        size=15.0,
                        color_by=fn() { if is_sel() { lg::surface().accent } else { lg::surface().ink } },
                      )
                    })
                    <ui::Col in={row} fill gap={2.0}>
                      <ui::Text
                        size={13.0}
                        weight={600}
                        lines={1}
                        color_by=>{lg::surface().ink}
                        text_by=>{row_sig.get().title}
                      />
                      <ui::Text
                        size={11.0}
                        weight={500}
                        lines={1}
                        color_by=>{if model.dark() { 0xE5E5EAFFL } else { 0x2C2C2EFFL }}
                        text_by=>{row_sig.get().subtitle}
                      />
                    </ui::Col>
                    <ui::Box in={row} pad_x={4.0} pad_y={1.0} rigid>
                      <ui::Text
                        size={11.0}
                        weight={600}
                        color_by=>{if model.dark() { 0xE5E5EAFFL } else { 0x2C2C2EFFL }}
                        text_by=>{row_sig.get().badge_label}
                      />
                    </ui::Box>
                  },
                )
              },
              at_once=true,
            )
          },
          radius=20.0,
          solid=fn() { lg::surface().card },
          tint_light=0xFBFBFDECL,
        )
      })
    })
  })
}

///| Builds the non-modal actionable CaptureSheet (Passive layer) inside `body`.
///| Only the control card region intercepts pointer events; exits focus order when a modal is open.
fn build_capture_sheet_overlay(
  body : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
) -> Unit {
  body.show(fn() { model.passive().capture_sheet_open }, fn(wrap : view::View) -> Unit {
    let _ = wrap
    .over(view::Live::Is(true), edges=(None, None, Some(16.0), Some(16.0)))
    .points(view::Live::Is(false))

    let _ = wrap.box(fn(card : view::View) -> Unit {
      let _ = card
      .width(view::Live::Is(Some(312.0)))
      .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
      .gap(view::Live::Is(8.0))
      .points(view::Live::Is(true))
      .says(view::Live::Is(Some(view::said(view::Role::Region, label="Capture Completed"))))
      let _ = lg::liquid_popover_surface_decorate(
        card,
        radius=20.0,
        solid=fn() { lg::surface().card },
      )
      <ui::Row in={card} align={.Middle} along={.Between} gap={8.0} rigid>
        <ui::Col fill gap={2.0}>
          <ui::Text
            size={13.0}
            weight={600}
            color_by=>{lg::surface().ink}
            text="Screenshot Saved"
          />
          <ui::Text
            size={11.0}
            lines={1}
            color_by=>{lg::surface().ink_secondary}
            text_by=>{model.passive().capture_sheet.filename}
          />
        </ui::Col>
        <ui::Box pad_x={6.0} pad_y={2.0} radius={6.0} bg_by=>{lg::surface().card_secondary} rigid>
          <ui::Text
            size={11.0}
            weight={500}
            color_by=>{lg::surface().ink}
            text_by=>{
              let m = model.passive().capture_sheet
              proto::capture_sheet_dims_badge(m.width, m.height)
            }
          />
        </ui::Box>
      </ui::Row>
      let in_focus = fn() -> Bool { capture_sheet_in_focus_order(model.exclusive(), model.passive()) }
      <ui::Row in={card} align={.Middle} gap={6.0} rigid>
        <lg::Button
          flat
          label="Copy Path"
          disabled_by=>{!in_focus()}
          on_press=>{emit(ShellIntent::CaptureCopyPath)}
        />
        <lg::Button
          flat
          label="Reveal"
          disabled_by=>{!in_focus()}
          on_press=>{emit(ShellIntent::CaptureRevealFile)}
        />
        <ui::Spacer />
        <lg::Button
          flat
          ghost
          label="Dismiss"
          disabled_by=>{!in_focus()}
          on_press=>{emit(ShellIntent::CaptureDismiss)}
        />
      </ui::Row>
    })
  })
}

///| Builds the complete Farview Desktop Shell 2.0 `ShellFrame`.
///| Mounts `pane_slot` for `PaneId::Primary` (always alive, mount delta == 0) and
///| `PaneId::Secondary` (shared across Split and Peek with 0 remounts).
pub fn build_shell_frame(
  root : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  pane_slot : PaneSlot,
) -> Unit {
  let window_w = fn() -> Double {
    let w = root.window_w()
    if w > 0.0 { w } else { 1280.0 }
  }
  let is_narrow = fn() -> Bool { window_w() < SHELL_SIDEBAR_BREAKPOINT }
  let is_compact = fn() -> Bool { window_w() < SHELL_COMPACT_BREAKPOINT }
  let docked_sidebar_visible = fn() -> Bool {
    model.dock().sidebar_open && !is_narrow()
  }
  let right_col_w = fn() -> Double {
    let sw = shell_sidebar_width(window_w(), model.dock().sidebar_open)
    let rw = window_w() - sw
    if rw > 120.0 { rw } else { 120.0 }
  }

  // Sync `lg` dark mode with model
  lg::set_dark(Some(signals::untracked(model.dark)))
  root.reacts(model.dark, fn(d : Bool) -> Unit { lg::set_dark(Some(d)) }, at_start=false)

  // Global Escape routing: Exclusive first (restoring Omnibox URL on OmniboxSuggest),
  // then topmost interactive Passive. Passes through during active IME composition
  // and lets `headless::dialog` handle Escape for modal Dialog so `return_focus` runs cleanly.
  let _ = root.on_key(fn(k : view::Key) -> Bool {
    if model.omnibox_field.composing() {
      return false
    }
    if k.code == ui::key_escape && k.mods == 0 {
      if model.exclusive().active is ExclusiveKind::Dialog {
        return false
      }
      if model.exclusive().is_open() || model.passive().capture_sheet_open || model.passive().perf_hud_open || model.passive().toast_visible {
        emit(ShellIntent::EscapePressed)
        return true
      }
    }
    false
  })

  // Solid calm paper window background
  let _ = root.ground(view::Live::By(fn() { lg::surface().canvas })).fill()

  let body_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let topbar_host_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let omni_wrap_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let omni_panel_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let dialog_trigger_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let primary_pane_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let secondary_pane_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)

  let focus_active_pane = fn() -> Unit {
    let target = match signals::untracked(model.page).active_pane {
      PaneId::Primary => primary_pane_ref.v
      PaneId::Secondary => secondary_pane_ref.v
    }
    match target {
      Some(pv) => {
        let _ = pv.ask_focus()
      }
      None => ()
    }
  }

  // Track omnibox field blur: when focus leaves the Address Bar while editing,
  // close suggestions, invalidate request gate, and restore the verified safe URL
  // UNLESS the pointer is currently pressing a suggestion row inside `omni_panel_ref`!
  let prev_omni_focused : signals::Ref[Bool] = ui::ref_new(false)
  root.reacts(fn() { model.omnibox_field.focused() }, fn(now_focused : Bool) -> Unit {
    let was = prev_omni_focused.v
    prev_omni_focused.v = now_focused
    if was && !now_focused && signals::untracked(model.omnibox_editing) {
      let in_suggest_panel = match omni_panel_ref.v {
        Some(p) => p.pointed() || p.pointed_in()
        None => false
      }
      let in_omni_capsule = match omni_wrap_ref.v {
        Some(ov) => ov.pointed() || ov.pointed_in()
        None => false
      }
      if !in_suggest_panel && !in_omni_capsule {
        emit(ShellIntent::OmniboxBlur)
      }
    }
  })

  // Arc / Tahoe Full-Height Shell Layout:
  // `[Full-Height Docked Sidebar (y=0..H)] | [Right Column: [44pt Titleband] / [Body + Canvas + Overlays]]`
  let _ = root.box(fn(outer_row : view::View) -> Unit {
    let _ = outer_row.fill().row(view::Live::Is(true))

    // 1. Full-Height Docked Arc Sidebar (`y = 0`, absorbs traffic lights when open)
    outer_row.show(docked_sidebar_visible, fn(sb : view::View) -> Unit {
      let _ = sb
      .width(view::Live::By(fn() { Some(shell_sidebar_width(window_w(), true)) }))
      .shrink(view::Live::Is(0.0))
      .ground(view::Live::By(fn() { lg::surface().sidebar }))
      .padding(view::Live::Is((10.0, 0.0, 10.0, 10.0)))
      .gap(view::Live::Is(10.0))
      .min_height(view::Live::Is(Some(0.0)))
      .says(view::Live::Is(Some(view::said(view::Role::Navigation, label="Sidebar"))))
      build_sidebar_contents(sb, model, emit, true)
    })

    // 2. Right Column: 44pt Titleband + Body (Canvas + Overlays)
    let _ = outer_row.box(fn(frame : view::View) -> Unit {
      let _ = frame.fill()

      // =========================================================================
      // 2a. 44pt Independent Solid Titleband
      // Explicit browser exception to DESIGN.md scroll-under:
      // - Never obscures page top inputs or sticky headers
      // - Always shows the verified domain & security indicator
      // - Empty space drags the native window via `.moves_window(true)`
      // - When sidebar is closed/narrow, left padding absorbs `ui::window_inset_now()`
      // =========================================================================
      let _ = frame.box(fn(titleband : view::View) -> Unit {
        let _ = titleband
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(SHELL_TITLEBAND_H)))
        .shrink(view::Live::Is(0.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(8.0))
        .padding(view::Live::By(fn() {
          let inset = if docked_sidebar_visible() { 0.0 } else { shell_traffic_light_inset(model) }
          let pl = if inset > 0.0 { inset } else { 8.0 }
          (pl, 4.0, 8.0, 4.0)
        }))
        .ground(view::Live::By(fn() { lg::surface().canvas }))
        .moves_window(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Toolbar, label="Browser Toolbar"))))
        topbar_host_ref.v = Some(titleband)
      })

      // =========================================================================
      // 2b. Body container (`y >= 44`): Split Bar + Web/Reader Canvas + ALL Overlays
      // =========================================================================
      let _ = frame.box(fn(body : view::View) -> Unit {
        body_ref.v = Some(body)
        let _ = body
        .fill()
        .ground(view::Live::By(fn() { lg::surface().canvas }))
        .clips(view::Live::Is(true))

        // Compact single-layer Split View quick-switch micro-bar (Swap / Solo / Close)
        body.show(fn() { model.page().layout is PageLayout::Split }, fn(sbar : view::View) -> Unit {
          let _ = sbar
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(SHELL_SPLIT_BAR_H)))
          .shrink(view::Live::Is(0.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Between))
          .padding(view::Live::Is((12.0, 6.0, 12.0, 0.0)))
          .gap(view::Live::Is(8.0))
          .ground(view::Live::By(fn() { lg::surface().canvas }))

          let _ = sbar.box(fn(panes_row : view::View) -> Unit {
            let _ = panes_row.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = <lg::Button
              in={panes_row}
              flat
              ghost
              height={30.0}
              pad_x={10.0}
              active_by=>{model.page().active_pane is PaneId::Primary}
              neutral_active
              label_by=>{proto::split_pane_display_host(model.url())}
              on_press=>{emit(ShellIntent::SetPaneFocus(PaneId::Primary))}
            />
            let _ = <lg::Button
              in={panes_row}
              flat
              ghost
              height={30.0}
              pad_x={10.0}
              active_by=>{model.page().active_pane is PaneId::Secondary}
              neutral_active
              label_by=>{proto::split_pane_display_host(model.secondary_url())}
              on_press=>{emit(ShellIntent::SetPaneFocus(PaneId::Secondary))}
            />
          })

          let _ = sbar.box(fn(acts : view::View) -> Unit {
            let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(4.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = <lg::Button in={acts} flat ghost height={30.0} pad_x={10.0} label="Swap" on_press=>{emit(ShellIntent::SwapSplitPanes)} />
            let _ = <lg::Button in={acts} flat ghost height={30.0} pad_x={10.0} label="Solo" on_press=>{emit(ShellIntent::CloseSecondaryPane)} />
          })
        })

        // Web / Reader Canvas Area (uniform 8pt padding on all 4 sides, zero Stage remounts)
        let _ = body.box(fn(canvas_pad : view::View) -> Unit {
          let _ = canvas_pad
          .fill()
          .padding(view::Live::Is((SHELL_CANVAS_GAP, SHELL_CANVAS_GAP, SHELL_CANVAS_GAP, SHELL_CANVAS_GAP)))

          let _ = canvas_pad.box(fn(stage_host : view::View) -> Unit {
            let _ = stage_host.fill().clips(view::Live::Is(true))

            let avail_w = fn() -> Double {
              let w = right_col_w() - SHELL_CANVAS_GAP * 2.0
              if w > 64.0 { w } else { 64.0 }
            }
            let avail_h = fn() -> Double {
              let wh = root.window_h()
              let split_h = if model.page().layout is PageLayout::Split { SHELL_SPLIT_BAR_H } else { 0.0 }
              let h = (if wh > 0.0 { wh } else { 800.0 }) - SHELL_TITLEBAND_H - split_h - SHELL_CANVAS_GAP * 2.0
              if h > 64.0 { h } else { 64.0 }
            }

            // Primary Pane: ALWAYS mounted in this single stable node (live == 1, mount delta == 0!)
            let _ = stage_host.box(fn(primary_box : view::View) -> Unit {
              primary_pane_ref.v = Some(primary_box)
              let _ = primary_box
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
              .margin(view::Live::By(fn() {
                let p = model.page()
                if (p.layout is PageLayout::Split) && p.panes_swapped {
                  let (lw, _) = proto::split_pane_widths(avail_w(), p.split_ratio)
                  (lw + proto::SPLIT_DIVIDER_WIDTH, 0.0, 0.0, 0.0)
                } else {
                  (0.0, 0.0, 0.0, 0.0)
                }
              }))
              .width(view::Live::By(fn() {
                let p = model.page()
                let w = avail_w()
                if p.layout is PageLayout::Split {
                  let (lw, rw) = proto::split_pane_widths(w, p.split_ratio)
                  Some(if p.panes_swapped { rw } else { lw })
                } else {
                  Some(w)
                }
              }))
              .radius(view::Live::By(shell_canvas_radius))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() { lg::surface().card }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              .focusable(view::Live::Is(true), keys=0, tab=false)
              .says(view::Live::Is(Some(view::said(view::Role::Region, label="Primary Pane"))))
              (pane_slot.mount)(primary_box, PaneId::Primary)
              // Active split-pane accent border painted ABOVE content layer (`points=false`)
              // so opaque page/Stage backgrounds never cover the active indicator!
              primary_box.show(
                fn() { (model.page().layout is PageLayout::Split) && (model.page().active_pane is PaneId::Primary) },
                fn(ring : view::View) -> Unit {
                  let _ = ring
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .radius(view::Live::By(shell_canvas_radius))
                  .edge(view::Live::By(fn() { (2.0, lg::surface().accent) }))
                },
              )
            })

            // Split Divider (`headless::split`, single hairline, zero double dividers)
            stage_host.show(fn() { model.page().layout is PageLayout::Split }, fn(div_wrap : view::View) -> Unit {
              let _ = div_wrap
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
              .margin(view::Live::By(fn() {
                let (lw, _) = proto::split_pane_widths(avail_w(), model.page().split_ratio)
                (lw, 0.0, 0.0, 0.0)
              }))
              .width(view::Live::Is(Some(proto::SPLIT_DIVIDER_WIDTH)))
              let _ = headless::split(
                div_wrap,
                fn() { "Resize Split View" },
                fn() { model.page().split_ratio },
                min=proto::SPLIT_RATIO_MIN,
                max=proto::SPLIT_RATIO_MAX,
                step=0.05,
                fn(r : Double) -> Unit { emit(ShellIntent::SetSplitRatio(r)) },
                fn(handle : view::View, sp : headless::Split) -> Unit {
                  let _ = handle.fill().center()
                  let _ = handle.box(fn(pill : view::View) -> Unit {
                    let _ = pill
                    .width(view::Live::By(fn() { if sp.hovered() || sp.dragging() { Some(3.0) } else { Some(1.0) } }))
                    .height(view::Live::By(fn() { if sp.hovered() || sp.dragging() { Some(44.0) } else { Some(28.0) } }))
                    .radius(view::Live::Is(1.5))
                    .ground(view::Live::By(fn() {
                      if sp.dragging() || sp.hovered() {
                        lg::surface().accent
                      } else {
                        lg::surface().separator_strong
                      }
                    }))
                  })
                },
                span=avail_w,
                reset=fn() -> Unit { emit(ShellIntent::SetSplitRatio(proto::split_reset_ratio())) },
              )
            })

            // Secondary Pane: mounted ONCE across `Split` and `Peek` (no `leave`, 0 remount on Peek <-> Split!)
            stage_host.show(fn() { model.page().has_secondary() }, fn(sec_box : view::View) -> Unit {
              secondary_pane_ref.v = Some(sec_box)
              let _ = sec_box
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
              .margin(view::Live::By(fn() {
                let p = model.page()
                if p.layout is PageLayout::Peek {
                  (44.0, 28.0, 0.0, 0.0)
                } else if p.panes_swapped {
                  (0.0, 0.0, 0.0, 0.0)
                } else {
                  let (lw, _) = proto::split_pane_widths(avail_w(), p.split_ratio)
                  (lw + proto::SPLIT_DIVIDER_WIDTH, 0.0, 0.0, 0.0)
                }
              }))
              .width(view::Live::By(fn() {
                let p = model.page()
                let w = avail_w()
                if p.layout is PageLayout::Peek {
                  let pw = w - 88.0
                  Some(if pw > 240.0 { pw } else { w - 16.0 })
                } else {
                  let (lw, rw) = proto::split_pane_widths(w, p.split_ratio)
                  Some(if p.panes_swapped { lw } else { rw })
                }
              }))
              .height(view::Live::By(fn() {
                let p = model.page()
                let h = avail_h()
                if p.layout is PageLayout::Peek {
                  let ph = h - 56.0
                  Some(if ph > 200.0 { ph } else { h - 16.0 })
                } else {
                  Some(h)
                }
              }))
              .radius(view::Live::By(shell_canvas_radius))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() { lg::surface().card }))
              .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
              .focusable(view::Live::Is(true), keys=0, tab=false)
              .says(view::Live::Is(Some(view::said(view::Role::Region, label="Secondary Pane"))))
              (pane_slot.mount)(sec_box, PaneId::Secondary)
              sec_box.show(
                fn() { (model.page().layout is PageLayout::Split) && (model.page().active_pane is PaneId::Secondary) },
                fn(ring : view::View) -> Unit {
                  let _ = ring
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .radius(view::Live::By(shell_canvas_radius))
                  .edge(view::Live::By(fn() { (2.0, lg::surface().accent) }))
                },
              )
            })
          })
        })

        // 2c. ALL overlays mounted inside `body` (`y >= 44`, Drawer `y >= 54`)
        // Narrow (< 720pt) Toggleable Leading Sidebar Drawer (`scrim=false`, no 44pt cut line!)
        let _ = lg::liquid_drawer_node(
          body,
          fn() { is_narrow() && (model.exclusive().active is ExclusiveKind::SidebarDrawer) },
          fn() { emit(ShellIntent::CloseExclusive) },
          fn() { "Tabs" },
          fn(drawer_body : view::View) -> Unit {
            let _ = drawer_body.fill().gap(view::Live::Is(10.0))
            build_sidebar_contents(drawer_body, model, emit, false)
          },
          side=lg::DrawerSide::Leading,
          width=260.0,
          scrim=false,
          inset=10.0,
        )

        // Trailing Non-Modal Liquid Glass Page Controls Drawer (`scrim=false`, ZERO 44pt scrim cut line!)
        // Section headers and card labels share exact 12pt left alignment (zero 4pt misalignment).
        let _ = lg::liquid_drawer_node(
          body,
          fn() { model.exclusive().active is ExclusiveKind::Drawer },
          fn() { emit(ShellIntent::CloseExclusive) },
          fn() { "Page Controls" },
          fn(drawer_body : view::View) -> Unit {
            <ui::Col in={drawer_body} gap={14.0}>
              <ui::Col gap={6.0}>
                <ui::Box pad_x={12.0} rigid>
                  <ui::Text size={11.0} weight={600} color_by=>{lg::surface().ink_secondary} text="APPEARANCE" />
                </ui::Box>
                <lg::SurfaceCard radius={lg::r_panel} pad={12.0}>
                  <ui::Row align={.Middle} along={.Between} gap={8.0} rigid>
                    <ui::Text size={13.0} weight={500} color_by=>{lg::surface().ink} text="Dark Appearance" />
                    <lg::Toggle
                      on_by=>{model.dark()}
                      on_change={fn(_v : Bool) -> Unit { emit(ShellIntent::ToggleDarkTheme) }}
                      label="Dark Appearance"
                    />
                  </ui::Row>
                </lg::SurfaceCard>
              </ui::Col>
              <ui::Col gap={6.0}>
                <ui::Box pad_x={12.0} rigid>
                  <ui::Text size={11.0} weight={600} color_by=>{lg::surface().ink_secondary} text="WORKSPACE" />
                </ui::Box>
                <lg::SurfaceCard radius={lg::r_panel} pad={12.0} gap={8.0}>
                  <ui::Row align={.Middle} along={.Between} gap={8.0} rigid>
                    <ui::Text size={13.0} weight={500} color_by=>{lg::surface().ink} text="Split View" />
                    <lg::Button
                      flat
                      label_by=>{if model.page().layout is PageLayout::Split { "Close" } else { "Open" }}
                      on_press=>{emit(ShellIntent::ToggleSplitView)}
                    />
                  </ui::Row>
                  <ui::Row align={.Middle} along={.Between} gap={8.0} rigid>
                    <ui::Text size={13.0} weight={500} color_by=>{lg::surface().ink} text="Reader Mode" />
                    <lg::Button
                      flat
                      label_by=>{if model.page().active_surface() is PaneSurface::Reader { "Web" } else { "Reader" }}
                      on_press=>{emit(ShellIntent::ToggleActiveReaderMode)}
                    />
                  </ui::Row>
                </lg::SurfaceCard>
              </ui::Col>
            </ui::Col>
          },
          side=lg::DrawerSide::Trailing,
          width=308.0,
          scrim=false,
          inset=10.0,
        )

        // Non-modal actionable CaptureSheet (Passive)
        build_capture_sheet_overlay(body, model, emit)

        // Toast (Passive)
        let _ = body.box(fn(toast_host : view::View) -> Unit {
          let _ = toast_host
          .over(view::Live::Is(true), edges=(Some(16.0), None, Some(16.0), Some(16.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .points(view::Live::Is(false))
          let _ = lg::liquid_toast_node(
            toast_host,
            fn() { model.passive().toast_visible },
            fn() { model.passive().toast_title },
            subtitle=fn() { model.passive().toast_subtitle },
            status=lg::LiquidStatus::Success,
          )
        })
      })

      // Populate titleband floating Liquid Glass islands now that `body_ref` is ready
      match (topbar_host_ref.v, body_ref.v) {
        (Some(titleband), Some(body)) => {
          // Left floating Liquid Glass island (36pt tall)
          // At 480pt compact: keeps `Toggle Sidebar` + `Back` (Reload moves into More Menu!)
          let _ = lg::liquid_bar_pill_group_node(
            titleband,
            fn(left_pill : view::View) -> Unit {
              bar_icon_btn(
                left_pill,
                "Toggle Sidebar",
                ICON_SIDEBAR,
                fn() {
                  if is_narrow() {
                    emit(ShellIntent::ToggleNarrowSidebar)
                  } else {
                    emit(ShellIntent::ToggleSidebar)
                  }
                },
                active=fn() { is_narrow() && (model.exclusive().active is ExclusiveKind::SidebarDrawer) },
              )
              bar_icon_btn(
                left_pill,
                "Back",
                ICON_BACK,
                fn() { emit(ShellIntent::GoBack) },
                disabled=fn() { !model.can_back() },
              )
              left_pill.show(fn() { !is_compact() }, fn(extra_nav : view::View) -> Unit {
                let _ = extra_nav.row(view::Live::Is(true)).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                bar_icon_btn(
                  extra_nav,
                  "Forward",
                  ICON_FORWARD,
                  fn() { emit(ShellIntent::GoForward) },
                  disabled=fn() { !model.can_forward() },
                )
                bar_icon_btn(
                  extra_nav,
                  "Reload",
                  ICON_RELOAD,
                  fn() { emit(ShellIntent::Reload) },
                )
              })
            },
            height=SHELL_PILL_H,
            label=fn() { "Navigation" },
          )

          // Center Omnibox:
          // - Idle unfocused: clean liquid glass capsule (`lg::liquid_bar_pill_group_node`) with ZERO clear `×` button,
          //   displaying reactive security icon + verified `omnibox_safe_display_url`.
          // - Focused/editing: full `lg::liquid_search_bar_node(..., height_by=fn() { 36.0 })` with IME guard & clear button.
          let _ = titleband.box(fn(omni_wrap : view::View) -> Unit {
            omni_wrap_ref.v = Some(omni_wrap)
            let is_omni_active = fn() -> Bool { model.omnibox_editing() || model.omnibox_field.focused() }
            let _ = omni_wrap
            .fill()
            .height(view::Live::Is(Some(SHELL_PILL_H)))
            .says(view::Live::Is(Some(view::said(view::Role::Region, label="Address Bar Host"))))
            .on_key(fn(k : view::Key) -> Bool {
              // Respect active IME composition: pass Arrow/Enter/Escape through to IME!
              if !model.omnibox_field.focused() || model.omnibox_field.composing() {
                return false
              }
              if k.code == proto::KEY_DOWN && k.mods == 0 && model.omnibox_suggest().open {
                emit(ShellIntent::OmniboxMoveSelection(1))
                return true
              }
              if k.code == proto::KEY_UP && k.mods == 0 && model.omnibox_suggest().open {
                emit(ShellIntent::OmniboxMoveSelection(-1))
                return true
              }
              false
            })

            // Idle clean display capsule (no `×` clear button when unfocused!)
            omni_wrap.show(fn() { !is_omni_active() }, fn(idle_host : view::View) -> Unit {
              let _ = idle_host.fill().height(view::Live::Is(Some(SHELL_PILL_H)))
              let _ = lg::liquid_bar_pill_group_node(
                idle_host,
                fn(pill : view::View) -> Unit {
                  let _ = pill.fill()
                  let _ = headless::button(
                    pill,
                    fn() { "Address Bar" },
                    fn(_e) -> Unit { emit(ShellIntent::OmniboxFocus) },
                    fn(btn_v : view::View, _btn : headless::Button) -> Unit {
                      let _ = btn_v
                      .fill()
                      .height(view::Live::Is(Some(SHELL_PILL_H)))
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                      .gap(view::Live::Is(7.0))
                      // Reactive security indicator (HTTPS lock / HTTP warning / Internal globe)
                      btn_v.show(fn() { model.omnibox_security() is OmniboxSecurity::SecureHttps }, fn(ic : view::View) -> Unit {
                        let _ = shell_icon(ic, ICON_LOCK, size=13.5, color_by=fn() { lg::surface().ink_secondary })
                      })
                      btn_v.show(fn() { model.omnibox_security() is OmniboxSecurity::InsecureHttp }, fn(ic : view::View) -> Unit {
                        let _ = shell_icon(ic, ICON_SHIELD, size=13.5, color_by=fn() { lg::surface().warning })
                      })
                      btn_v.show(fn() { model.omnibox_security() is OmniboxSecurity::InternalPage }, fn(ic : view::View) -> Unit {
                        let _ = shell_icon(ic, ICON_GLOBE, size=13.5, color_by=fn() { lg::surface().ink_secondary })
                      })
                      btn_v.show(fn() { model.omnibox_security() is OmniboxSecurity::EditingSearch }, fn(ic : view::View) -> Unit {
                        let _ = shell_icon(ic, ICON_SEARCH, size=13.5, color_by=fn() { lg::surface().ink_secondary })
                      })
                      let _ = btn_v.box(fn(tw : view::View) -> Unit {
                        let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                        let _ = <ui::Text
                          in={tw}
                          size={13.0}
                          weight={500}
                          color_by=>{lg::surface().ink}
                          text_by=>{proto::omnibox_safe_display_url(model.active_url())}
                        />.allow_ellipsis(view::Live::Is(true))
                      })
                    },
                  )
                },
                height=SHELL_PILL_H,
                label=fn() { "Address Bar Capsule" },
              )
            }, at_once=true)

            // Active editing `liquid_search_bar_node` (shows full `omnibox_safe_display_url` + clear button)
            omni_wrap.show(is_omni_active, fn(edit_host : view::View) -> Unit {
              let _ = edit_host.fill().height(view::Live::Is(Some(SHELL_PILL_H)))
              let _ = lg::liquid_search_bar_node(
                edit_host,
                model.omnibox_field,
                placeholder="Search or enter website",
                height_by=fn() { SHELL_PILL_H },
                label=fn() { "Address Bar" },
                leading=fn(lead : view::View, ink : () -> Int64) -> Unit {
                  // 100% reactive security / editing indicator (never untracked!)
                  lead.show(fn() { model.omnibox_security() is OmniboxSecurity::EditingSearch }, fn(ic : view::View) -> Unit {
                    let _ = shell_icon(ic, ICON_SEARCH, size=14.0, color_by=ink)
                  })
                  lead.show(fn() { model.omnibox_security() is OmniboxSecurity::SecureHttps }, fn(ic : view::View) -> Unit {
                    let _ = shell_icon(ic, ICON_LOCK, size=14.0, color_by=ink)
                  })
                  lead.show(fn() { model.omnibox_security() is OmniboxSecurity::InsecureHttp }, fn(ic : view::View) -> Unit {
                    let _ = shell_icon(ic, ICON_SHIELD, size=14.0, color_by=fn() { lg::surface().warning })
                  })
                  lead.show(fn() { model.omnibox_security() is OmniboxSecurity::InternalPage }, fn(ic : view::View) -> Unit {
                    let _ = shell_icon(ic, ICON_GLOBE, size=14.0, color_by=ink)
                  })
                },
                edited=fn(q : String) -> Unit { emit(ShellIntent::OmniboxEdit(q)) },
                submitted=fn(q : String) -> Unit { emit(ShellIntent::OmniboxSubmit(q)) },
                on_clear=fn() -> Unit { emit(ShellIntent::OmniboxEdit("")) },
                on_escape=fn() -> Unit {
                  if !model.omnibox_field.composing() {
                    emit(ShellIntent::OmniboxEscape)
                    focus_active_pane()
                  }
                },
              )
              // Auto-select all on initial idle -> editing transition (never re-selects once already editing!)
              if signals::untracked(model.omnibox_editing) && !model.omnibox_field.focused() {
                model.omnibox_field.focus()
                let len = model.omnibox_field.text().length()
                if len > 0 {
                  model.omnibox_field.pick(0, len)
                }
              }
            }, at_once=true)
          })

          // Right floating Liquid Glass island (36pt tall)
          let _ = lg::liquid_bar_pill_group_node(
            titleband,
            fn(right_pill : view::View) -> Unit {
              right_pill.show(fn() { !is_compact() }, fn(tool_pair : view::View) -> Unit {
                let _ = tool_pair.row(view::Live::Is(true)).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                bar_icon_btn(
                  tool_pair,
                  "Split View",
                  ICON_SPLIT,
                  fn() { emit(ShellIntent::ToggleSplitView) },
                  active=fn() { model.page().layout is PageLayout::Split },
                )
                bar_icon_btn(
                  tool_pair,
                  "Reader Mode",
                  ICON_READER,
                  fn() { emit(ShellIntent::ToggleActiveReaderMode) },
                  active=fn() { model.page().active_surface() is PaneSurface::Reader },
                )
              })
              bar_icon_btn(
                right_pill,
                "Page Controls",
                ICON_DRAWER,
                fn() { emit(ShellIntent::ToggleDrawer) },
                active=fn() { model.exclusive().active is ExclusiveKind::Drawer },
              )
              // Right-side More Menu: ALWAYS uses `Placement::BelowEnd` and mounts in `body`!
              // Includes Forward + Reload so 480pt compact users always have full nav access.
              let _ = lg::liquid_menu_node(
                right_pill,
                body,
                fn() { model.exclusive().active is ExclusiveKind::Menu },
                fn(open : Bool) -> Unit {
                  if open {
                    emit(ShellIntent::OpenMoreMenu)
                  } else {
                    emit(ShellIntent::CloseMoreMenu)
                  }
                },
                fn() { "More Actions" },
                fn(trig : view::View, disc : headless::Disclosure) -> Unit {
                  dialog_trigger_ref.v = Some(trig)
                  let _ = trig
                  .width(view::Live::Is(Some(36.0)))
                  .height(view::Live::Is(Some(36.0)))
                  .margin(view::Live::Is((0.0, -3.0, 0.0, -3.0)))
                  .radius(view::Live::Is(15.0))
                  .center()
                  .ground(view::Live::By(fn() {
                    if disc.open() || disc.hovered() { lg::surface().row_hover } else { 0x00000000L }
                  }))
                  let _ = shell_icon(trig, ICON_MORE, size=15.0, color_by=fn() { lg::surface().ink })
                },
                fn() -> Array[lg::LiquidMenuEntry] {
                  [
                    lg::LiquidMenuEntry::item(
                      label="New Tab",
                      shortcut="Cmd+T",
                      icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_PLUS, size=14.0, color_by=ink) },
                      on_select=fn() { emit(ShellIntent::NewTab) },
                    ),
                    lg::LiquidMenuEntry::item(
                      label="Reload Page",
                      shortcut="Cmd+R",
                      icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_RELOAD, size=14.0, color_by=ink) },
                      on_select=fn() { emit(ShellIntent::Reload) },
                    ),
                    lg::LiquidMenuEntry::item(
                      label="Forward",
                      shortcut="Cmd+]",
                      icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_FORWARD, size=14.0, color_by=ink) },
                      on_select=fn() { emit(ShellIntent::GoForward) },
                    ),
                    lg::LiquidMenuEntry::separator(),
                    lg::LiquidMenuEntry::item(
                      label="Toggle Split View",
                      shortcut="Cmd+Shift+\\",
                      icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_SPLIT, size=14.0, color_by=ink) },
                      on_select=fn() { emit(ShellIntent::ToggleSplitView) },
                    ),
                    lg::LiquidMenuEntry::item(
                      label="Toggle Reader Mode",
                      shortcut="Cmd+Alt+R",
                      icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_READER, size=14.0, color_by=ink) },
                      on_select=fn() { emit(ShellIntent::ToggleActiveReaderMode) },
                    ),
                    lg::LiquidMenuEntry::separator(),
                    lg::LiquidMenuEntry::item(
                      label="Export PDF…",
                      shortcut="Cmd+P",
                      icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_DOWNLOAD, size=14.0, color_by=ink) },
                      on_select=fn() { emit(ShellIntent::OpenDialog) },
                    ),
                    lg::LiquidMenuEntry::check(
                      label="Dark Appearance",
                      checked=model.dark,
                      on_toggle=fn() { emit(ShellIntent::ToggleDarkTheme) },
                    ),
                  ]
                },
                menu_label=fn() { "Browser Menu" },
                placement=headless::Placement::BelowEnd,
                min_width=220.0,
                anchor_size=(36.0, 30.0),
              )
            },
            height=SHELL_PILL_H,
            label=fn() { "Tools" },
          )
          // Mount Omnibox overlay AFTER menu layer so click-outside scrim is never shadowed by closed popover hosts
          build_omnibox_overlay(body, model, emit, omni_wrap_ref, omni_panel_ref, right_col_w, is_compact)
        }
        _ => ()
      }
    })
  })

  // Full-window Modal Dialog mounted at `root` level (covers entire 1280x800 window — ZERO L-shaped scrim cut!).
  // Full-window interactive scrim blocks all pointer pass-through to underlying topbar/sidebar/address/canvas controls.
  // Real `headless::dialog` provides initial focus, `Tab`/`Shift+Tab` trap, `Esc` close, and `return_focus` to `More Actions`.
  let close_dialog_and_return_focus = fn() -> Unit {
    if signals::untracked(model.exclusive).active is ExclusiveKind::Dialog {
      emit(ShellIntent::CloseDialog)
    }
  }
  root.show(fn() { model.exclusive().active is ExclusiveKind::Dialog }, fn(dlg_wrap : view::View) -> Unit {
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Export Page as PDF" },
      fn() { model.exclusive().active is ExclusiveKind::Dialog },
      close_dialog_and_return_focus,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center()
        // Full-window pointer-blocking scrim INSIDE `dlg_box` (not a tab stop, so Tab stays strictly Cancel <-> Export,
        // while consuming pointer-down AND pointer-up across the entire window with ZERO pass-through to underlying controls!).
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::Is(0x00000038L))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { close_dialog_and_return_focus() })
        })
        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          let _ = shell.width(view::Live::Is(Some(320.0))).padding(view::Live::Is((16.0, 16.0, 16.0, 16.0))).gap(view::Live::Is(12.0))
          <ui::Text in={shell} size={15.0} weight={600} color_by=>{lg::surface().ink} text="Export Page as PDF" />
          <ui::Text in={shell} size={13.0} wrap color_by=>{lg::surface().ink_secondary} text="Save the active document with vector text and embedded fonts." />
          let _ = shell.box(fn(btn_row : view::View) -> Unit {
            let _ = btn_row.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lies_along(view::Live::Is(view::Lies::End)).rigid()
            let cancel_v = lg::liquid_button_node(btn_row, fn() { "Cancel" }, close_dialog_and_return_focus, flat=true)
            let _ = lg::liquid_button_node(btn_row, fn() { "Export" }, close_dialog_and_return_focus, prominent=true)
            let _ = cancel_v.ask_focus()
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      return_focus?=dialog_trigger_ref.v,
    )
  })
  // Registered AFTER `root.show(...)` so it runs right after the modal dialog unmounts and restores focus to trigger!
  root.reacts(at_start=false, fn() { model.exclusive().active is ExclusiveKind::Dialog }, fn(is_open : Bool) -> Unit {
    if !is_open {
      match dialog_trigger_ref.v {
        Some(trig) => {
          let _ = trig.ask_focus()
        }
        None => ()
      }
    }
  })
}
