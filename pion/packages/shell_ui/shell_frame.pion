///| Farview Desktop Shell 3 — ShellFrame (pure Pion-JSX `.pion`).
///|
///| Layout:
///| 1. The window frame is one quiet color taken from the active Space (`shell_frame_color`). The docked sidebar
///|    sits straight on it with no box of its own; the page is the single solid card, inset `SHELL_FRAME_GAP` from
///|    the frame on every side, with one soft shadow.
///| 2. With the sidebar docked there is no toolbar: the traffic lights, navigation buttons and the address field
///|    live at the top of the sidebar, so the page starts 8pt below the window top. With the sidebar hidden or the
///|    window narrower than 720pt, a 40pt toolbar row carries the same controls above the card.
///| 3. Editing the address opens a command palette centered over the page (dense single-layer glass), holding the
///|    field and the keyed suggestion rows; Escape, a click outside or leaving focus restores the verified URL.
///| 4. Lists (favorites, folders, tabs, spaces, suggestions) are keyed `View::each`; hover-only controls mount
///|    with `show` (never `alpha = 0`); hover washes ease in and out with `shell_fade`.
///| 5. Primary `PaneSlot` mounts once (live == 1, mount delta == 0 across all layout/resize/swap); Secondary
///|    `PaneSlot` is reused across `Split <-> Peek` and unmounts cleanly on `Single`.

import "headless"
import "icons"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

///| Height of the toolbar row shown above the page when the sidebar is not docked.
///| Overlays anchored "below the toolbar" use this as their top offset in every layout.
pub let SHELL_TITLEBAND_H : Double = 40.0 // SP_40 (literal: package-level lets initialize in file order)
pub let SHELL_PILL_H : Double = 32.0 // SP_32
pub let SHELL_SIDEBAR_W_WIDE : Double = 240.0 // SP_160 + SP_80
pub let SHELL_SIDEBAR_W_NARROW : Double = 208.0 // SP_160 + SP_48
pub let SHELL_SIDEBAR_BREAKPOINT : Double = 720.0
pub let SHELL_COMPACT_BREAKPOINT : Double = 560.0
pub let SHELL_CANVAS_GAP : Double = 8.0 // SP_8
pub let SHELL_TRAFFIC_LIGHT_INSET : Double = 80.0 // SP_80
pub let SHELL_SPLIT_BAR_H : Double = 0.0 // SP_0
pub let SHELL_PEEK_BAR_H : Double = 40.0 // SP_40

///| Optional production host hooks for `build_shell_frame`.
///| Keeps `shell_ui` 100% pure (zero host/net/stage/wire dependencies) while allowing
///| `pion/cmd/app` to plug in live top strips, bottom docks, context menus, and badges.
pub struct ShellHostHooks {
  pub on_address_bar_view : Option[(view::View) -> Unit]
  pub on_omnibox_panel_view : Option[(view::View) -> Unit]
  pub top_strip : Option[(view::View) -> Unit]
  pub bottom_dock : Option[(view::View) -> Unit]
  pub sidebar_filter_slot : Option[(view::View) -> Unit]
  pub sidebar_folder_create_slot : Option[(view::View) -> Unit]
  pub address_trailing_slot : Option[(view::View) -> Unit]
  pub on_site_info : Option[() -> Unit]
  pub on_nav_history : Option[(Int, Double) -> Unit]
  pub on_tab_context : Option[(String, Double) -> Unit]
  pub on_tab_hover : Option[(String, Double, Bool) -> Unit]
  pub on_folder_context : Option[(String, Double) -> Unit]
  pub on_space_header_click : Option[() -> Unit]
  pub on_tab_count_click : Option[() -> Unit]
  pub extra_more_items : Option[() -> Array[lg::LiquidMenuEntry]]
  pub hide_demo_export_pdf : Bool
  pub peek_can_back : Option[() -> Bool]
  pub peek_can_forward : Option[() -> Bool]
  pub command_bar : Option[CommandBarProps]
  pub tab_search : Option[TabSearchProps]
  pub body_overlays : Option[(view::View) -> Unit]
  ///| Sidebar modes (Create a Space, Library): the sidebar switching wholesale into another mode.
  pub sidebar_modes : Option[SidebarModeProps]
  ///| A download the page started, shown at the foot of the sidebar while it runs (and a moment after), pressing
  ///| it opens Downloads.
  pub downloads_activity : Option[() -> ShellDownloadActivity]
  pub on_downloads_activity : Option[() -> Unit]
}

///| What the sidebar's download row shows.
pub struct ShellDownloadActivity {
  pub visible : Bool
  ///| the file running (or the last one), and how many more run with it
  pub name : String
  pub more : Int
  ///| 0...1, or below 0 while the size is not known (an indeterminate band)
  pub progress : Double
  pub done : Bool
  pub failed : Bool
}

pub fn ShellDownloadActivity::none() -> ShellDownloadActivity {
  ShellDownloadActivity::{ visible: false, name: "", more: 0, progress: -1.0, done: false, failed: false }
}

pub fn ShellHostHooks::empty() -> ShellHostHooks {
  ShellHostHooks::{
    on_address_bar_view: None,
    on_omnibox_panel_view: None,
    top_strip: None,
    bottom_dock: None,
    sidebar_filter_slot: None,
    sidebar_folder_create_slot: None,
    address_trailing_slot: None,
    on_site_info: None,
    on_nav_history: None,
    on_tab_context: None,
    on_tab_hover: None,
    on_folder_context: None,
    on_space_header_click: None,
    on_tab_count_click: None,
    extra_more_items: None,
    hide_demo_export_pdf: false,
    peek_can_back: None,
    peek_can_forward: None,
    command_bar: None,
    tab_search: None,
    body_overlays: None,
    sidebar_modes: None,
    downloads_activity: None,
    on_downloads_activity: None,
  }
}

fn shell_pane_label(url : String, title : String) -> String {
  let host = proto::split_pane_display_host(url)
  if host != "" && host != "file:" && host != "about:blank" {
    return host
  }
  let t = title.trim()
  if t != "" {
    return t
  }
  let u = url.trim()
  let mut last_slash = -1
  let mut i = 0
  while i < u.length() {
    if u.code_unit_at(i).to_int() == 0x2F {
      last_slash = i
    }
    i += 1
  }
  if last_slash >= 0 && last_slash + 1 < u.length() {
    let base = u.slice(last_slash + 1, u.length())
    if base != "" {
      return base
    }
  }
  if host != "" { host } else { "about:blank" }
}

///| Computes the page card corner radius concentrically from the window corner radius.
pub fn shell_canvas_radius() -> Double {
  let win_r = ui::tree_corner_roots_now().window
  let outer = if win_r > 0.0 { win_r } else { SP_16 }
  lg::concentric(outer, SHELL_CANVAS_GAP)
}

///| The widest the docked sidebar is drawn in a window `window_w` wide: the stored bound
///| (`proto::SETTINGS_SIDEBAR_W_MAX`, which the edge handle and the settings share), and never so wide that the page
///| keeps under 360pt (but never under the narrowest, `proto::SETTINGS_SIDEBAR_W_MIN`).
pub fn shell_sidebar_max_width(window_w : Double) -> Double {
  let room = window_w - 360.0
  let cap = if room < proto::SETTINGS_SIDEBAR_W_MAX { room } else { proto::SETTINGS_SIDEBAR_W_MAX }
  if cap > proto::SETTINGS_SIDEBAR_W_MIN { cap } else { proto::SETTINGS_SIDEBAR_W_MIN }
}

///| Computes effective docked sidebar width for a window width and dock state.
pub fn shell_sidebar_width(window_w : Double, sidebar_open : Bool, custom_w~ : Double = 0.0) -> Double {
  if !sidebar_open || window_w < SHELL_SIDEBAR_BREAKPOINT {
    0.0
  } else if custom_w >= proto::SETTINGS_SIDEBAR_W_MIN {
    let cap = shell_sidebar_max_width(window_w)
    if custom_w > cap { cap } else { custom_w }
  } else if window_w < 960.0 {
    SHELL_SIDEBAR_W_NARROW
  } else {
    SHELL_SIDEBAR_W_WIDE
  }
}

///| Whether the sidebar is docked (on the frame, carrying the navigation row and the address field).
pub fn shell_sidebar_docked(dock : DockState, window_w : Double) -> Bool {
  dock.sidebar_open && window_w >= SHELL_SIDEBAR_BREAKPOINT
}

///| Window y where the page column's content (top strip, page card, overlays anchored "below the toolbar") starts:
///| `SHELL_CANVAS_GAP` while the sidebar is docked (no toolbar), `SHELL_TITLEBAND_H` when the toolbar row shows
///| (window narrower than 720pt or sidebar hidden).
pub fn shell_content_top_for(dock : DockState, window_w : Double) -> Double {
  if shell_sidebar_docked(dock, window_w) { SHELL_CANVAS_GAP } else { SHELL_TITLEBAND_H }
}

///| `shell_content_top_for` for a `ShellModel`.
pub fn shell_content_top(model : ShellModel, window_w : Double) -> Double {
  shell_content_top_for(model.dock(), window_w)
}

///| Whether the toolbar row (sidebar not docked) carries Forward and Reload; below 560pt it keeps Toggle and Back.
pub fn shell_toolbar_shows_forward(window_w : Double) -> Bool {
  window_w >= SHELL_COMPACT_BREAKPOINT
}

///| Width of the toolbar row in front of the address field: its buttons (32pt each, SP_4 apart; Forward and Reload
///| touch) and the address row's SP_4 lead. Mirrors the toolbar built in `build_shell_frame_with_probe`.
fn shell_toolbar_lead_w(window_w : Double) -> Double {
  let base = SP_32 + SP_4 + SP_32 + SP_4
  let fwd = if shell_toolbar_shows_forward(window_w) { SP_32 + SP_32 + SP_4 } else { SP_0 }
  base + fwd + SP_4
}

///| Where the address field sits before it is laid out (fallback anchor for popovers that hang from it):
///| docked, at the top of the sidebar below the navigation row; otherwise in the toolbar row, after the buttons
///| that row shows at this width, centered in what is left up to the palette width. `inset` is the traffic-light
///| clearance (`shell_traffic_light_inset` / `shell_live_traffic_light_inset`).
pub fn shell_address_fallback_rect(dock : DockState, window_w : Double, inset~ : Double = 0.0) -> AnchorRect {
  if shell_sidebar_docked(dock, window_w) {
    let sw = shell_sidebar_width(window_w, true, custom_w=dock.sidebar_width)
    AnchorRect::{ x: SHELL_CANVAS_GAP, y: SHELL_TOP_ROW_H + SHELL_CANVAS_GAP, w: sw - SHELL_CANVAS_GAP, h: SHELL_ADDRESS_H }
  } else {
    let left = (if inset > 0.0 { inset } else { SP_8 }) + shell_toolbar_lead_w(window_w)
    let avail0 = window_w - left - SP_8
    let avail = if avail0 > SP_160 { avail0 } else { SP_160 }
    let w = if avail > SHELL_PALETTE_W { SHELL_PALETTE_W } else { avail }
    AnchorRect::{ x: left + (avail - w) / 2.0, y: (SHELL_TITLEBAND_H - SHELL_ADDRESS_H) / 2.0, w, h: SHELL_ADDRESS_H }
  }
}

///| The live traffic-light clearance for callers without a `ShellModel` (no test override).
pub fn shell_live_traffic_light_inset() -> Double {
  if ui::window_inset_now() { SHELL_TRAFFIC_LIGHT_INSET } else { 0.0 }
}

///| Computes dynamic macOS traffic-light clearance (supports deterministic test/shot override).
pub fn shell_traffic_light_inset(model : ShellModel) -> Double {
  match model.window_inset_override {
    Some(px) => if px > 0.0 { px } else { 0.0 }
    None => if ui::window_inset_now() { SHELL_TRAFFIC_LIGHT_INSET } else { 0.0 }
  }
}

///| Flat icon button used inside floating glass (Peek header): no capsule at rest.
fn bar_icon_btn(
  parent : view::View,
  label : String,
  icon_name : String,
  on_press : () -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = lg::liquid_button_node(
    parent,
    fn() { label },
    on_press,
    content=fn(inner : view::View) -> Unit {
      let _ = shell_icon(
        inner,
        icon_name,
        size=IC_MD,
        color_by=fn() {
          if disabled() {
            lg::surface().ink_tertiary
          } else if active() {
            lg::surface().accent
          } else {
            lg::surface().ink_secondary
          }
        },
      )
    },
    flat=true,
    ghost=true,
    height=SP_32,
    pad_x=SP_8,
    active=active,
    neutral_active=true,
    disabled=disabled,
  )
}

fn shell_space_name(model : ShellModel) -> String {
  let sid = model.active_space_id()
  let list = model.spaces()
  let mut i = 0
  while i < list.length() {
    if list[i].id == sid {
      return list[i].name
    }
    i += 1
  }
  "Work"
}

///| One tab drag in the sidebar (Arc's way of organizing it): the held tab follows the pointer 1:1, lifted (scale
///| 1.02 and the selected row's shadow); a 2pt accent line shows where it lands between rows, a folder or the
///| Favorites grid it is over takes the strong wash; letting go emits `MoveTab`, Escape or a drop outside puts it
///| back (easing home over MO_KEY_MS). A click (moved less than `TAB_DRAG_SLOP`) still selects, a right-click still
///| opens the menu, a finger drags only after a long press (so it scrolls the list otherwise).
struct TabDrag {
  ///| the tab held ("" while none)
  id : signals::Signal[String]
  ///| where the pointer went down and where it is now (window terms)
  start : signals::Ref[(Double, Double)]
  at_x : signals::Signal[Double]
  at_y : signals::Signal[Double]
  ///| where it would land: a `proto::TAB_DROP_*` container ("" none) and the tab it lands before ("" the end)
  target : signals::Signal[String]
  before : signals::Signal[String]
  ///| a drag called off by Escape: its let go does nothing
  cancelled : signals::Ref[Bool]
  ///| what is laid out where, by id: tab rows, folder headers, the Favorites grid, the Today divider
  rows : Map[String, view::View]
  folders : Map[String, view::View]
  favs : signals::Ref[Option[view::View]]
  ///| each favorite tile, by id (a drop in the grid lands before the tile under the pointer)
  fav_tiles : Map[String, view::View]
  divider : signals::Ref[Option[view::View]]
  ///| the room left of the rows that still takes their presses (the window edge, Fitts): docked SP_8, drawer 0
  edge : Double
  ///| A held tab row is drawn as a lifted copy over the whole sidebar (`ghost_*`), outside the tab list's scroll
  ///| clip, so it stays seen over the Favorites grid and past the list's ends; the row itself leaves its gap.
  ghost_on : signals::Signal[Bool]
  ///| the held row's wash where it stood (window terms), its title and address
  ghost_at : signals::Ref[(Double, Double, Double, Double)]
  ghost_title : signals::Ref[String]
  ghost_url : signals::Ref[String]
}

///| How an unloaded tab's tile and title are drawn (alpha).
pub let TAB_UNLOADED_ALPHA : Double = 0.55

///| How far a press moves before it drags the tab (pt).
let TAB_DRAG_SLOP : Double = 4.0 // SP_4

///| How long a finger holds still on a tab before it drags it (ms).
let TAB_DRAG_HOLD_MS : Double = 400.0

fn TabDrag::new(edge : Double) -> TabDrag {
  TabDrag::{
    id: signals::signal(""),
    start: view::ref_new((0.0, 0.0)),
    at_x: signals::signal(0.0),
    at_y: signals::signal(0.0),
    target: signals::signal(""),
    before: signals::signal(""),
    cancelled: view::ref_new(false),
    rows: Map::new(),
    folders: Map::new(),
    favs: view::ref_new(None),
    fav_tiles: Map::new(),
    divider: view::ref_new(None),
    edge,
    ghost_on: signals::signal(false),
    ghost_at: view::ref_new((0.0, 0.0, 0.0, 0.0)),
    ghost_title: view::ref_new(""),
    ghost_url: view::ref_new(""),
  }
}

///| Whether `id` is the tab held now (followed).
fn TabDrag::holds(self : TabDrag, id : String) -> Bool {
  let h = self.id.get()
  h != "" && h == id
}

///| How far the held tab is drawn off its place (followed).
fn TabDrag::moved(self : TabDrag) -> (Double, Double) {
  let x = self.at_x.get()
  let y = self.at_y.get()
  let (x0, y0) = self.start.v
  (x - x0, y - y0)
}

///| How the tab drag in progress is called off (None: no tab is held). The app's own key handler asks it first,
///| so Escape cancels a drag before it closes whatever layer is open (`shell_tab_drag_cancel`).
let tab_drag_live : signals::Ref[Option[() -> Unit]] = view::ref_new(None)

///| Whether a tab (or favorite) is held in a sidebar drag now.
pub fn shell_tab_drag_active() -> Bool {
  tab_drag_live.v is Some(_)
}

///| Calls off the sidebar tab drag in progress (the tab eases home, its let go does nothing); false when none.
pub fn shell_tab_drag_cancel() -> Bool {
  match tab_drag_live.v {
    Some(cancel) => {
      tab_drag_live.v = None
      cancel()
      true
    }
    None => false
  }
}

///| Stands for a drag in progress that `cancel` calls off (tests of an app's key handling, which has no pointer).
pub fn shell_tab_drag_hold_for_test(cancel : () -> Unit) -> Unit {
  tab_drag_live.v = Some(cancel)
}

fn TabDrag::clear(self : TabDrag) -> Unit {
  tab_drag_live.v = None
  signals::start_batch()
  self.ghost_on.set(false)
  self.id.set("")
  self.target.set("")
  self.before.set("")
  signals::end_batch_in_turn()
}

///| The tab rows of a folder, the Pinned area and Today, as the sidebar draws them (one filter for drawing,
///| hit-testing a drag and its drop line).
fn sidebar_space_tab(model : ShellModel, t : ShellTabItem) -> Bool {
  let sid = model.active_space_id()
  t.space_id == sid || t.space_id == ""
}

fn sidebar_folder_tabs(model : ShellModel, fid : String) -> Array[ShellTabItem] {
  let out : Array[ShellTabItem] = []
  for t in model.tabs() {
    if !t.favorite && t.folder_id == fid && sidebar_space_tab(model, t) {
      out.push(t)
    }
  }
  out
}

fn sidebar_has_folder(model : ShellModel, fid : String) -> Bool {
  for f in model.folders() {
    if f.id == fid {
      return true
    }
  }
  false
}

///| Top-level Pinned tabs: pinned, not a favorite, in no folder the sidebar draws.
fn sidebar_pinned_tabs(model : ShellModel) -> Array[ShellTabItem] {
  let out : Array[ShellTabItem] = []
  for t in model.tabs() {
    if t.pinned && !t.favorite && (t.folder_id == "" || !sidebar_has_folder(model, t.folder_id)) && sidebar_space_tab(model, t) {
      out.push(t)
    }
  }
  out
}

///| Today: neither pinned nor a favorite.
fn sidebar_today_tabs(model : ShellModel) -> Array[ShellTabItem] {
  let out : Array[ShellTabItem] = []
  for t in model.tabs() {
    if !t.pinned && !t.favorite && t.folder_id == "" && sidebar_space_tab(model, t) {
      out.push(t)
    }
  }
  out
}

///| Where a tab row is drawn: its folder's container, Pinned or Today (`proto::TAB_DROP_*`).
fn sidebar_row_container(model : ShellModel, t : ShellTabItem) -> String {
  if t.folder_id != "" && sidebar_has_folder(model, t.folder_id) {
    proto::TAB_DROP_FOLDER + t.folder_id
  } else if t.pinned {
    proto::TAB_DROP_PINNED
  } else {
    proto::TAB_DROP_TODAY
  }
}

///| Every tab row the sidebar draws, in its order: each expanded folder's, Pinned, Today; with its container.
fn sidebar_drop_rows(model : ShellModel) -> Array[(String, String)] {
  let out : Array[(String, String)] = []
  for f in model.folders() {
    if !f.collapsed {
      for t in sidebar_folder_tabs(model, f.id) {
        out.push((proto::TAB_DROP_FOLDER + f.id, t.id))
      }
    }
  }
  for t in sidebar_pinned_tabs(model) {
    out.push((proto::TAB_DROP_PINNED, t.id))
  }
  for t in sidebar_today_tabs(model) {
    out.push((proto::TAB_DROP_TODAY, t.id))
  }
  out
}

///| The first row after `k` in container `c` that is not the held tab ("" none: the end).
fn sidebar_next_in(rows : Array[(String, String)], k : Int, c : String, held : String) -> String {
  let mut i = k + 1
  while i < rows.length() {
    let (ci, id) = rows[i]
    if ci != c {
      return ""
    }
    if id != held {
      return id
    }
    i += 1
  }
  ""
}

///| The last row of container `c` that is not the held tab ("" none).
fn sidebar_last_in(model : ShellModel, c : String, held : String) -> String {
  let mut last = ""
  for r in sidebar_drop_rows(model) {
    let (ci, id) = r
    if ci == c && id != held {
      last = id
    }
  }
  last
}

fn tab_drag_inside(v : view::View, wy : Double, slack : Double) -> (Bool, Double) {
  let (_, y, _, h) = v.laid_window_now()
  (h > 0.0 && wy >= y - slack && wy < y + h + slack, y + h / 2.0)
}

///| Where the held tab would land with the pointer at window y `wy`: (container, before). ("", "") over nothing.
fn tab_drag_aim(dr : TabDrag, model : ShellModel, wx : Double, wy : Double) -> (String, String) {
  let held = dr.id.untracked()
  // (off the sidebar sideways: nowhere)
  match dr.divider.v {
    Some(dv) => {
      let (x, _, w, _) = dv.laid_window_now()
      if w > 0.0 && (wx < x - SP_40 || wx > x + w + SP_40) {
        return ("", "")
      }
    }
    None => ()
  }
  match dr.favs.v {
    Some(g) =>
    if signals::untracked(fn() { model.favorites().length() > 0 }) {
      let (on, _) = tab_drag_inside(g, wy, SP_4)
      if on {
        return (proto::TAB_DROP_FAVORITES, tab_drag_fav_before(dr, model, wx, held))
      }
    }
    None => ()
  }
  let folders = signals::untracked(model.folders)
  for f in folders {
    match dr.folders.get(f.id) {
      Some(fv) => {
        let (on, _) = tab_drag_inside(fv, wy, SP_0)
        if on {
          return (proto::TAB_DROP_FOLDER + f.id, "")
        }
      }
      None => ()
    }
  }
  let rows = signals::untracked(fn() { sidebar_drop_rows(model) })
  let mut k = 0
  let mut bottom = 0.0
  while k < rows.length() {
    let (c, id) = rows[k]
    match dr.rows.get(id) {
      Some(rv) => {
        let (_, y, _, h) = rv.laid_window_now()
        if h > 0.0 && id != held {
          if y + h > bottom {
            bottom = y + h
          }
          // (the held row is drawn where the pointer is, not where it stands: it is no target; over the gap it left
          // there is no target either, so letting go there leaves it where it was)
          if id != held && wy >= y - SP_2 && wy < y + h {
            return if wy < y + h / 2.0 { (c, id) } else { (c, sidebar_next_in(rows, k, c, held)) }
          }
        }
      }
      None => ()
    }
    k += 1
  }
  match dr.divider.v {
    Some(dv) => {
      let (on, mid) = tab_drag_inside(dv, wy, SP_2)
      if on {
        if wy < mid {
          return (proto::TAB_DROP_PINNED, "")
        }
        let mut first = ""
        for r in rows {
          let (c, id) = r
          if first == "" && c == proto::TAB_DROP_TODAY && id != held {
            first = id
          }
        }
        return (proto::TAB_DROP_TODAY, first)
      }
      let (_, dy, _, _) = dv.laid_window_now()
      if wy > dy && wy >= bottom {
        return (proto::TAB_DROP_TODAY, "")
      }
    }
    None => ()
  }
  ("", "")
}

///| The favorite a tab dropped on the grid at window x `wx` lands before: the first tile (not the held one) whose
///| middle is right of the pointer; "" past the last (the end).
fn tab_drag_fav_before(dr : TabDrag, model : ShellModel, wx : Double, held : String) -> String {
  let favs = signals::untracked(model.favorites)
  for f in favs {
    if f.id != held {
      match dr.fav_tiles.get(f.id) {
        Some(tv) => {
          let (x, _, w, _) = tv.laid_window_now()
          if w > 0.0 && wx < x + w / 2.0 {
            return f.id
          }
        }
        None => ()
      }
    }
  }
  ""
}

///| The favorite after `id` in the grid that is not `id` ("" it is the last; `id` not a favorite: None).
fn sidebar_fav_next(model : ShellModel, id : String) -> Option[String] {
  let favs = signals::untracked(model.favorites)
  let mut k = 0
  while k < favs.length() {
    if favs[k].id == id {
      return Some(if k + 1 < favs.length() { favs[k + 1].id } else { "" })
    }
    k += 1
  }
  None
}

///| The last favorite that is not `held` ("" none).
fn fav_last_not(model : ShellModel, held : String) -> String {
  let mut last = ""
  for f in model.favorites() {
    if f.id != held {
      last = f.id
    }
  }
  last
}

fn tab_drag_move(dr : TabDrag, model : ShellModel, wx : Double, wy : Double) -> Unit {
  let (c, b) = tab_drag_aim(dr, model, wx, wy)
  signals::start_batch()
  dr.at_x.set(wx)
  dr.at_y.set(wy)
  dr.target.set(c)
  dr.before.set(b)
  signals::end_batch_in_turn()
}

///| Whether landing `id` in `c` before `b` leaves it where it is.
fn tab_drag_same_place(model : ShellModel, id : String, c : String, b : String) -> Bool {
  let rows = signals::untracked(fn() { sidebar_drop_rows(model) })
  let mut k = 0
  while k < rows.length() {
    let (ck, idk) = rows[k]
    if idk == id {
      return ck == c && sidebar_next_in(rows, k, c, id) == b
    }
    k += 1
  }
  // (a favorite dropped on the grid: the same place when it lands before the tile after it)
  match sidebar_fav_next(model, id) {
    Some(next) => c == proto::TAB_DROP_FAVORITES && next == b
    None => false
  }
}

///| Lets go of the held tab: a move where it lands somewhere new, nothing otherwise.
fn tab_drag_drop(dr : TabDrag, model : ShellModel, emit : (ShellIntent) -> Unit) -> Unit {
  let id = dr.id.untracked()
  let c = dr.target.untracked()
  let b = dr.before.untracked()
  dr.clear()
  if id != "" && c != "" && !tab_drag_same_place(model, id, c, b) {
    emit(ShellIntent::MoveTab(id, c, b))
  }
}

///| The press and drag of a tab row (or a favorite tile) `v`, whose tab is `id_of()`: the primary mouse button selects
///| on its way down (Arc's mouse-down select, which is also what lets a drag start from the selected tab); a finger
///| and the keyboard select on their way up (`v.press()`); moved past the slop it drags. `home` eases a called-off
///| drag back to its place.
fn tab_drag_gesture(
  v : view::View,
  dr : TabDrag,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  id_of : () -> String,
  select_on_down : () -> Bool,
  home : (Double, Double) -> Unit,
  lifted~ : () -> Unit = fn() { () },
) -> Unit {
  let down_at = view::ref_new((0.0, 0.0))
  let picked = view::ref_new(false)
  let mouse = fn() -> Bool { ui::pointing() is ui::Pointing::Mouse }
  // (Escape, from this row's keys or the app's key handler: back home, and the let go does nothing)
  let cancel = fn() -> Unit {
    let (mx, my) = signals::untracked(fn() { dr.moved() })
    dr.cancelled.v = true
    dr.clear()
    home(mx, my)
  }
  let _ = v.gesture(
    TAB_DRAG_SLOP,
    press=fn(d : view::Drag) {
      down_at.v = (d.wx, d.wy)
      picked.v = false
      dr.cancelled.v = false
      if mouse() && select_on_down() {
        picked.v = true
        let _ = v.press()
      }
    },
    tap=fn(d : view::Drag) {
      if !picked.v && v.finger_target(d.wx, d.wy) {
        let _ = v.press()
      }
    },
    hold=(TAB_DRAG_HOLD_MS, fn(_d : view::Drag) { () }),
    held_first=fn(_d : view::Drag) { !mouse() },
    drag=fn(d : view::Drag) {
      let id = id_of()
      match d.kind {
        Down =>
        if !dr.cancelled.v {
          dr.start.v = down_at.v
          signals::start_batch()
          lifted()
          dr.id.set(id)
          signals::end_batch_in_turn()
          tab_drag_live.v = Some(cancel)
          tab_drag_move(dr, model, d.wx, d.wy)
        }
        Moved => if dr.id.untracked() == id { tab_drag_move(dr, model, d.wx, d.wy) }
        Up =>
        if dr.id.untracked() == id {
          tab_drag_drop(dr, model, emit)
        } else if !dr.cancelled.v && !picked.v && v.finger_target(d.wx, d.wy) {
          // (let go after a long press, never dragged: still a press)
          let _ = v.press()
        }
        Off =>
        if dr.id.untracked() == id {
          let (mx, my) = signals::untracked(fn() { dr.moved() })
          dr.clear()
          home(mx, my)
        }
      }
    },
  )
  let _ = v.on_key(fn(k : view::Key) -> Bool {
    let id = id_of()
    if k.code == ui::key_escape && id != "" && dr.id.untracked() == id {
      cancel()
      true
    } else {
      false
    }
  })
}

///| The 2pt accent drop line, over `host`'s top edge (or its foot) while the held tab lands there.
fn tab_drop_line(host : view::View, inset : Double, on : () -> Bool, foot~ : Bool = false) -> Unit {
  host.show(on, fn(line : view::View) -> Unit {
    let _ = line
    .over(view::Live::Is(true), edges=if foot {
      (Some(inset), None, Some(SP_8), Some(SP_0 - SP_2))
    } else {
      (Some(inset), Some(SP_0 - SP_2), Some(SP_8), None)
    })
    .height(view::Live::Is(Some(SP_2)))
    .radius(view::Live::Is(SP_2))
    .points(view::Live::Is(false))
    .ground(view::Live::By(fn() { lg::surface().accent }))
  })
}

///| A tab's site tile, or a monochrome spinner ring in its place while the page loads (same 16pt box, so the row
///| never reflows; a static partial ring under reduced motion).
fn shell_tab_tile(parent : view::View, model : ShellModel, host_by : () -> String, loading : () -> Bool) -> Unit {
  let _ = parent.box(fn(slot : view::View) -> Unit {
    let _ = slot.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(SP_16))).rigid().center()
    slot.show(fn() { !loading() }, fn(tile : view::View) -> Unit {
      let _ = shell_site_tile(tile, host_by, size=SP_16)
    })
    slot.show(loading, fn(sp : view::View) -> Unit {
      shell_spinner(sp, model, SP_16)
    })
  })
}

///| A monochrome spinner `size` big: a faint ring with a dot running round it once a second.
pub fn shell_spinner(parent : view::View, model : ShellModel, size : Double) -> Unit {
  let _ = parent.box(fn(ring : view::View) -> Unit {
    let _ = ring
    .width(view::Live::Is(Some(size - SP_2)))
    .height(view::Live::Is(Some(size - SP_2)))
    .radius(view::Live::Is((size - SP_2) / 2.0))
    .center()
    .points(view::Live::Is(false))
    .edge(view::Live::By(fn() { (SP_2, lg::alpha(shell_frame_ink_tertiary(model.dark()), 0.45)) }))
    .says(view::Live::Is(Some(view::said(view::Role::Status, label="Loading"))))
    let _ = ring.box(fn(dot : view::View) -> Unit {
      let r = (size - SP_2) / 2.0 - 1.0
      let _ = dot
      .width(view::Live::Is(Some(SP_4)))
      .height(view::Live::Is(Some(SP_4)))
      .radius(view::Live::Is(SP_2))
      .points(view::Live::Is(false))
      .ground(view::Live::By(fn() { shell_frame_ink_secondary(model.dark()) }))
      .offset(view::Live::By(fn() {
        let p = if ui::reduced_motion() { 0.125 } else { dot.cycle(1000.0) }
        let a = p * 2.0 * 3.141592653589793
        (r * dmath::sin(a), 0.0 - r * dmath::cos(a))
      }))
    })
  })
}

///| Renders a single sidebar tab row (keyed `Signal[ShellTabItem]`).
///| The selected tab is a raised white wash with one soft lift; others are bare until hovered. The row's press
///| reaches from the window edge (`dr.edge` left of the drawn wash, Fitts) to its trailing edge, and its lit area
///| is its press area. The primary mouse button selects on its way down and the row answers the press with a
///| wash while held; it drags (see `TabDrag`). The hover close button is overlaid on the trailing edge (`.over`),
///| so hovering never reflows the title. `indent` sets a folder's children in under its name.
fn build_tab_row(
  parent : view::View,
  item_sig : signals::Signal[ShellTabItem],
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  hooks : Option[ShellHostHooks],
  dr : TabDrag,
  indent~ : Double = SP_0,
) -> Unit {
  let is_active = fn() -> Bool { item_sig.get().active }
  let tab_title = fn() -> String { item_sig.get().title }
  let tab_host = fn() -> String {
    let (h, _) = shell_url_parts(item_sig.get().url)
    h
  }
  let lead = dr.edge + indent
  let held = fn() -> Bool { dr.holds(item_sig.get().id) }
  let _ = parent.box(fn(slot : view::View) -> Unit {
    dr.rows.set(item_sig.untracked().id, slot)
    // (the button's press, lifted to the row: the wash is the row's)
    let pressed = signals::signal(false)
    let hover_t = shell_fade(slot, fn() { (slot.pointed() || slot.pointed_in() || pressed.get()) && dr.id.get() == "" })
    // Selected wash and lift cross-fade over MO_KEY_MS (tab switches are often Cmd+1...9 / Ctrl+Tab); the page
    // itself switches at once. A row built selected is selected at once.
    let act_t = shell_fade(slot, is_active, duration_ms=MO_KEY_MS)
    // Pressed: half the selected wash, over MO_KEY_MS, so a press is answered before the host is.
    let press_t = shell_fade(slot, fn() { pressed.get() && !is_active() }, duration_ms=MO_KEY_MS)
    // Held in a drag: lifted (1.02 and the selected row's shadow) over MO_KEY_MS; it follows the pointer 1:1.
    let lift_t = shell_fade(slot, held, duration_ms=MO_KEY_MS)
    let home = motion::NodeWay::new(0.0)
    let home_from = view::ref_new((0.0, 0.0))
    let _ = slot
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SHELL_ROW_H)))
    // (held, it is drawn as the lifted copy over the sidebar, `build_tab_drag_ghost`; its own place stays as the
    // gap it left. Called off, it eases home from where it was let go.)
    .alpha(view::Live::By(fn() { if held() { 0.0 } else { 1.0 } }))
    .offset(view::Live::By(fn() {
      if held() {
        (SP_0, SP_0)
      } else {
        let k = home.shown(slot)
        let (_, hy) = home_from.v
        (SP_0, hy * k)
      }
    }))
    .on_menu(fn(_m : view::Menu) -> Unit {
      match hooks {
        Some(h) => match h.on_tab_context {
          Some(cb) => {
            let (_, sy, _, _) = slot.placed_window_now()
            cb(item_sig.untracked().id, sy)
          }
          None => ()
        }
        None => ()
      }
    })
    match hooks {
      Some(h) => match h.on_tab_hover {
        Some(cb) => {
          slot.reacts(at_start=false, fn() { slot.pointed() || slot.pointed_in() }, fn(entered : Bool) -> Unit {
            let (_, sy, _, _) = slot.placed_window_now()
            cb(item_sig.untracked().id, sy, entered)
          })
        }
        None => ()
      }
      None => ()
    }
    // The wash: under the content (the slot's first child), drawn from `lead` in; the press starts at the slot's
    // own edge.
    let wash_v : signals::Ref[Option[view::View]] = view::ref_new(None)
    let _ = slot.box(fn(wash : view::View) -> Unit {
      wash_v.v = Some(wash)
      let _ = wash
      .over(view::Live::Is(true), edges=(Some(lead), Some(SP_0), Some(SP_0), Some(SP_0)))
      .points(view::Live::Is(false))
      .radius(view::Live::Is(SP_8))
      .ground(view::Live::By(fn() {
        let a = act_t()
        let l = lift_t()
        let d = model.dark()
        let rest = lg::over(lg::alpha(shell_wash_hover(d), hover_t() * (1.0 - a)), lg::alpha(shell_wash_strong(d), 0.5 * press_t() * (1.0 - a)))
        lg::over(rest, lg::alpha(shell_wash_strong(d), if a > l { a } else { l }))
      }))
      .shadow(view::Live::By(fn() {
        let a = act_t()
        let l = lift_t()
        let k = if a > l { a } else { l }
        if k <= 0.0 {
          (0.0, 0.0, 0x00000000L)
        } else {
          let (blur, dy, c) = shell_row_lift(model.dark())
          (blur, dy, lg::alpha(c, k))
        }
      }))
      .shadow_outside(view::Live::Is(true))
    })
    // Where the held tab lands: before this row, or after it when it ends its container.
    tab_drop_line(slot, lead + SP_8, fn() {
      let t = item_sig.get()
      dr.id.get() != "" && dr.id.get() != t.id && dr.before.get() == t.id && dr.target.get() == sidebar_row_container(model, t)
    })
    tab_drop_line(slot, lead + SP_8, foot=true, fn() {
      let t = item_sig.get()
      let c = dr.target.get()
      dr.id.get() != "" && dr.before.get() == "" && c == sidebar_row_container(model, t) &&
      !c.starts_with(proto::TAB_DROP_FOLDER) &&
      sidebar_last_in(model, c, dr.id.get()) == t.id
    })

    let _ = headless::button(
      slot,
      tab_title,
      fn(_e) -> Unit { emit(ShellIntent::SelectTab(item_sig.untracked().id)) },
      fn(btn_v : view::View, btn : headless::Button) -> Unit {
        btn_v.reacts(fn() { btn.pressed() }, fn(p : Bool) -> Unit { pressed.set(p) }, at_start=false)
        let _ = btn_v
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .min_height(view::Live::Is(Some(SHELL_ROW_H)))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((lead + SP_8, SP_0, SP_6, SP_0)))
        .gap(view::Live::Is(SP_8))
        .cursor(view::Live::By(fn() { if held() { Some(view::Cursor::Grabbing) } else { None } }))
        tab_drag_gesture(
          btn_v,
          dr,
          model,
          emit,
          fn() { item_sig.untracked().id },
          fn() { !item_sig.untracked().active },
          fn(_mx : Double, my : Double) -> Unit {
            home_from.v = (SP_0, my)
            home.put(1.0)
            shell_go(home, slot, 0.0, MO_KEY_MS)
          },
          lifted=fn() {
            match wash_v.v {
              Some(w) => dr.ghost_at.v = w.laid_window_now()
              None => ()
            }
            let it = item_sig.untracked()
            dr.ghost_title.v = it.title
            dr.ghost_url.v = it.url
            dr.ghost_on.set(true)
          },
        )
        // An unloaded tab (a closed Pinned or Favorite tab keeps its entry) draws its tile and title dimmed, as in
        // Arc; pressing it loads it again.
        let unloaded_t = shell_fade(btn_v, fn() { item_sig.get().unloaded && !item_sig.get().active }, duration_ms=MO_KEY_MS)
        let dim = fn() -> Double { 1.0 - (1.0 - TAB_UNLOADED_ALPHA) * unloaded_t() }
        let _ = btn_v.box(fn(tile_wrap : view::View) -> Unit {
          let _ = tile_wrap.rigid().alpha(view::Live::By(dim))
          shell_tab_tile(tile_wrap, model, tab_host, fn() { item_sig.get().loading })
        })
        let _ = btn_v.box(fn(tw : view::View) -> Unit {
          let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut().alpha(view::Live::By(dim))
          let _ = <ui::Text
            in={tw}
            size={TX_BODY}
            color_by=>{lg::surface().ink}
            text_by=>{tab_title()}
          />.allow_ellipsis(view::Live::Is(true))
        })
        // Playing / muted media: a real state, shown only while it holds.
        btn_v.show(fn() { item_sig.get().playing_audio }, fn(au : view::View) -> Unit {
          let _ = au.rigid().padding(view::Live::Is((SP_0, SP_0, SP_4, SP_0)))
          let _ = shell_icon_by(
            au,
            fn() { if item_sig.get().muted { ICON_VOLUME_MUTE } else { ICON_VOLUME } },
            size=IC_SM,
            color_by=fn() { shell_frame_ink_secondary(model.dark()) },
          )
        })
      },
    )

    // Hover-revealed close button: mounted via `show` (NEVER `alpha=0`), overlaid on the trailing edge.
    // It fades in over MO_HOVER_MS (pressable from its first frame) and goes at once when the pointer leaves.
    slot.show(fn() { (slot.pointed() || slot.pointed_in()) && dr.id.get() == "" }, fn(close_wrap : view::View) -> Unit {
      let close_in = motion::NodeWay::new(0.0)
      shell_go(close_in, close_wrap, 1.0, MO_HOVER_MS)
      let _ = close_wrap
      .over(view::Live::Is(true), edges=(None, Some(SP_0), Some(SP_0), Some(SP_0)))
      .center()
      .alpha(view::Live::By(fn() { close_in.shown(close_wrap) }))
      let _ = headless::button(
        close_wrap,
        fn() { "Close " + tab_title() },
        fn(_e) -> Unit { emit(ShellIntent::CloseTab(item_sig.untracked().id)) },
        fn(cb : view::View, btn : headless::Button) -> Unit {
          let face_t = shell_fade(cb, fn() { btn.hovered() || btn.pressed() })
          // 32pt wide to the row's trailing edge (the face sits 2pt in from it, as before).
          let _ = cb
          .width(view::Live::Is(Some(SP_32)))
          .height(view::Live::Is(Some(SHELL_ROW_H)))
          .padding(view::Live::Is((SP_0, SP_0, SP_2, SP_0)))
          .center()
          let _ = cb.box(fn(face : view::View) -> Unit {
            let _ = face
            .width(view::Live::Is(Some(SP_24)))
            .height(view::Live::Is(Some(SP_24)))
            .radius(view::Live::Is(SP_6))
            .points(view::Live::Is(false))
            .center()
            .ground(view::Live::By(fn() {
              lg::alpha(if model.dark() { 0xFFFFFF1FL } else { 0x0000000FL }, face_t())
            }))
            shell_press(face, fn() { btn.pressed() })
            let _ = shell_icon(face, ICON_CLOSE, size=IC_SM, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
          })
        },
      )
    })
  })
}

///| The lifted copy of a held tab row: where the row's wash stood, following the pointer 1:1 down and up, at 1.02
///| with the selected row's shadow (eased in over MO_KEY_MS; none under reduced motion). It is laid over `sb`, not in
///| the tab list, so the list's scroll clip never cuts it: it is seen over the Favorites grid and past the list's
///| ends. It takes no presses (the row's own gesture holds the pointer).
fn build_tab_drag_ghost(sb : view::View, model : ShellModel, dr : TabDrag) -> Unit {
  sb.show(fn() { dr.ghost_on.get() }, fn(g : view::View) -> Unit {
    let lift = motion::NodeWay::new(0.0)
    shell_go(lift, g, 1.0, MO_KEY_MS)
    let (gx, gy, gw, gh) = dr.ghost_at.v
    let title = dr.ghost_title.v
    let url = dr.ghost_url.v
    let _ = g
    .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_0), None, None))
    .width(view::Live::Is(Some(gw)))
    .height(view::Live::Is(Some(gh)))
    .points(view::Live::Is(false))
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(SP_8))
    .padding(view::Live::Is((SP_8, SP_0, SP_6, SP_0)))
    .radius(view::Live::Is(SP_8))
    // (solid: the rows it passes over never show through it; the strong wash over the card keeps the selected
    // row's tone)
    .ground(view::Live::By(fn() { lg::over(lg::surface().card, shell_wash_strong(model.dark())) }))
    .shadow(view::Live::By(fn() {
      let (blur, dy, c) = shell_row_lift(model.dark())
      (blur, dy, lg::alpha(c, lift.shown(g)))
    }))
    .shadow_outside(view::Live::Is(true))
    .scale(view::Live::By(fn() { if ui::reduced_motion() { 1.0 } else { 1.0 + 0.02 * lift.shown(g) } }))
    .offset(view::Live::By(fn() {
      let (_, dy) = dr.moved()
      let (sx, sy, _, _) = sb.laid_window_now()
      (gx - sx, gy - sy + dy)
    }))
    .cursor(view::Live::Is(Some(view::Cursor::Grabbing)))
    let host = fn() -> String {
      let (h, _) = shell_url_parts(url)
      h
    }
    shell_tab_tile(g, model, host, fn() { false })
    let _ = g.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
      let _ = <ui::Text in={tw} size={TX_BODY} color_by=>{lg::surface().ink} text={title} />.allow_ellipsis(view::Live::Is(true))
    })
  })
}

///| A sidebar row with an icon and a label (folders, New Tab). Like a tab row, its press reaches `edge` left of its
///| drawn wash (the window edge) and its lit area is its press area. `strong` lights it as a drop target.
fn sidebar_plain_row(
  parent : view::View,
  model : ShellModel,
  label : () -> String,
  on_press : () -> Unit,
  leading : (view::View) -> Unit,
  on_menu~ : Option[(view::View) -> Unit] = None,
  weight~ : Int = 400,
  secondary~ : Bool = false,
  edge~ : Double = SP_0,
  strong~ : () -> Bool = fn() { false },
  made~ : (view::View) -> Unit = fn(_v : view::View) { () },
) -> Unit {
  let _ = headless::button(
    parent,
    label,
    fn(_e) -> Unit { on_press() },
    fn(fh : view::View, btn : headless::Button) -> Unit {
      made(fh)
      let hover_t = shell_fade(fh, fn() { btn.hovered() || btn.pressed() })
      let strong_t = shell_fade(fh, strong, duration_ms=MO_KEY_MS)
      let _ = fh
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .min_height(view::Live::Is(Some(SHELL_ROW_H)))
      .padding(view::Live::Is((edge + SP_8, SP_0, SP_8, SP_0)))
      .gap(view::Live::Is(SP_8))
      let _ = fh.box(fn(wash : view::View) -> Unit {
        let _ = wash
        .over(view::Live::Is(true), edges=(Some(edge), Some(SP_0), Some(SP_0), Some(SP_0)))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(SP_8))
        .ground(view::Live::By(fn() {
          let d = model.dark()
          lg::over(lg::alpha(shell_wash_hover(d), hover_t()), lg::alpha(shell_wash_strong(d), strong_t()))
        }))
      })
      match on_menu {
        Some(cb) => {
          let _ = fh.on_menu(fn(_m : view::Menu) -> Unit { cb(fh) })
        }
        None => ()
      }
      let _ = fh.box(fn(lead : view::View) -> Unit {
        let _ = lead.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(SP_16))).shrink(view::Live::Is(0.0)).center()
        leading(lead)
      })
      let _ = fh.box(fn(tw : view::View) -> Unit {
        let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
        let _ = <ui::Text
          in={tw}
          size={TX_BODY}
          weight={weight}
          color_by=>{if secondary { shell_frame_ink_secondary(model.dark()) } else { lg::surface().ink }}
          text_by=>{label()}
        />.allow_ellipsis(view::Live::Is(true))
      })
    },
  )
}

///| The address field on the frame: verified host in full ink, the rest of the address dimmed.
///| Pressing it opens the command palette. Used by the sidebar and the compact toolbar.
fn build_address_capsule(
  parent : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  hooks : Option[ShellHostHooks],
  trailing : (view::View) -> Unit,
) -> Unit {
  let site_info_cb = match hooks {
    Some(h) => h.on_site_info
    None => None
  }
  let _ = parent.box(fn(cap : view::View) -> Unit {
    let hover_t = shell_fade(cap, fn() { cap.pointed() || cap.pointed_in() })
    let _ = cap
    .fill()
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(SHELL_ADDRESS_H)))
    .min_height(view::Live::Is(Some(SHELL_ADDRESS_H)))
    .max_height(view::Live::Is(Some(SHELL_ADDRESS_H)))
    .shrink(view::Live::Is(1.0))
    .radius(view::Live::Is(SP_10))
    .padding(view::Live::Is((if site_info_cb.is_some() { SP_0 } else { SP_4 }, SP_0, SP_0, SP_0)))
    .gap(view::Live::Is(SP_0))
    .ground(view::Live::By(fn() {
      lg::over(shell_wash(model.dark()), lg::alpha(shell_wash_hover(model.dark()), hover_t()))
    }))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Address Bar Host"))))
    match hooks {
      Some(h) => match h.on_address_bar_view {
        Some(cb) => cb(cap)
        None => ()
      }
      None => ()
    }
    let security_icon = fn(host : view::View) -> Unit {
      host.show(fn() { model.omnibox_security() is OmniboxSecurity::SecureHttps }, fn(ic : view::View) -> Unit {
        let _ = shell_icon(ic, ICON_LOCK, size=IC_SM, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
      })
      host.show(fn() { model.omnibox_security() is OmniboxSecurity::InsecureHttp }, fn(ic : view::View) -> Unit {
        let _ = shell_icon(ic, ICON_SHIELD, size=IC_SM, color_by=fn() { lg::surface().warning })
      })
      host.show(fn() { model.omnibox_security() is OmniboxSecurity::InternalPage }, fn(ic : view::View) -> Unit {
        let _ = shell_icon(ic, ICON_GLOBE, size=IC_SM, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
      })
      host.show(fn() { model.omnibox_security() is OmniboxSecurity::EditingSearch }, fn(ic : view::View) -> Unit {
        let _ = shell_icon(ic, ICON_SEARCH, size=IC_SM, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
      })
    }
    match site_info_cb {
      Some(cb) => {
        let _ = headless::button(
          cap,
          fn() { "Site Controls" },
          fn(_e) -> Unit { cb() },
          fn(sec_btn : view::View, btn : headless::Button) -> Unit {
            let hover_t = shell_fade(sec_btn, fn() { btn.hovered() || btn.pressed() })
            let _ = sec_btn.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).center().rigid()
            let _ = sec_btn.box(fn(face : view::View) -> Unit {
              let _ = face
              .width(view::Live::Is(Some(SP_24)))
              .height(view::Live::Is(Some(SP_24)))
              .radius(view::Live::Is(SP_6))
              .points(view::Live::Is(false))
              .center()
              .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(model.dark()), hover_t()) }))
              shell_press(face, fn() { btn.pressed() })
              security_icon(face)
            })
          },
        )
      }
      None => ()
    }
    let _ = headless::button(
      cap,
      fn() { "Address Bar" },
      fn(_e) -> Unit { emit(ShellIntent::OmniboxFocus) },
      fn(btn_v : view::View, _btn : headless::Button) -> Unit {
        let _ = btn_v
        .fill()
        .height(view::Live::Is(Some(SHELL_ADDRESS_H)))
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .padding(view::Live::Is((if site_info_cb.is_some() { SP_0 } else { SP_6 }, SP_0, SP_4, SP_0)))
        .gap(view::Live::Is(SP_6))
        if site_info_cb.is_none() {
          let _ = btn_v.box(fn(ic : view::View) -> Unit {
            let _ = ic.rigid().center()
            security_icon(ic)
          })
        }
        let _ = btn_v.box(fn(tw : view::View) -> Unit {
          let _ = tw
          .grow(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_width(view::Live::Is(Some(0.0)))
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .cut()
          let _ = <ui::Text
            in={tw}
            size={TX_BODY}
            weight={500}
            color_by=>{lg::surface().ink}
            text_by=>{
              let (h, rest) = shell_url_parts(model.active_url())
              if h == "" { rest } else { h }
            }
          />.allow_ellipsis(view::Live::Is(true))
        })
      },
    )
    match hooks {
      Some(h) => match h.address_trailing_slot {
        Some(cb) => cb(cap)
        None => ()
      }
      None => ()
    }
    trailing(cap)
  })
}

///| Small flat icon button living inside the address field (Page Controls, More).
fn capsule_icon_btn(
  parent : view::View,
  model : ShellModel,
  label : String,
  icon_name : String,
  on_press : () -> Unit,
  active~ : () -> Bool = fn() { false },
) -> Unit {
  let _ = headless::button(
    parent,
    fn() { label },
    fn(_e) -> Unit { on_press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
      // 32pt square hit target around a 24pt face, so the field keeps its 4pt inner margin.
      let _ = b.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).rigid().center()
      let _ = b.box(fn(face : view::View) -> Unit {
        let _ = face
        .width(view::Live::Is(Some(SP_24)))
        .height(view::Live::Is(Some(SP_24)))
        .radius(view::Live::Is(SP_6))
        .points(view::Live::Is(false))
        .center()
        .ground(view::Live::By(fn() {
          if active() {
            shell_wash_strong(model.dark())
          } else {
            lg::alpha(shell_wash_hover(model.dark()), hover_t())
          }
        }))
        shell_press(face, fn() { btn.pressed() })
        let _ = shell_icon(
          face,
          icon_name,
          size=IC_MD,
          color_by=fn() { if active() { lg::surface().ink } else { shell_frame_ink_secondary(model.dark()) } },
        )
      })
    },
  )
}

///| Builds the sidebar contents (keyed `View::each` throughout). Shared between the docked sidebar
///| (`w >= 720`, `include_top_row = true`) and the narrow floating drawer (`w < 720`).
fn build_sidebar_contents(
  sb : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  include_top_row : Bool,
  hooks : Option[ShellHostHooks],
  nav_row~ : Option[(view::View) -> Unit] = None,
  address~ : Option[(view::View) -> Unit] = None,
  tabs_scroll~ : Option[view::Scroll] = None,
  edge~ : Double = SP_0,
) -> Unit {
  // Tab drag state shared by every row of this sidebar. `edge`: the room between the window edge and the rows
  // that still takes their presses (the docked sidebar's inset; 0 in the drawer).
  let dr = TabDrag::new(edge)
  // 1. Top row: traffic-light clearance + navigation (docked only), then the address field.
  if include_top_row {
    match nav_row {
      Some(cb) => cb(sb)
      None => ()
    }
    match address {
      Some(cb) => cb(sb)
      None => ()
    }
  }

  // Optional inline Tab Filter & Folder Creator slots (mounted when provided by production host)
  match hooks {
    Some(h) => {
      match h.sidebar_filter_slot {
        Some(cb) => cb(sb)
        None => ()
      }
      match h.sidebar_folder_create_slot {
        Some(cb) => cb(sb)
        None => ()
      }
    }
    None => ()
  }

  // 2. Favorites: up to four per row, translucent tiles carrying the site's icon (else its monogram).
  sb.show(fn() { model.favorites().length() > 0 }, fn(fav_grid : view::View) -> Unit {
    dr.favs.v = Some(fav_grid)
    let drop_t = shell_fade(fav_grid, fn() { dr.id.get() != "" && dr.target.get() == proto::TAB_DROP_FAVORITES }, duration_ms=MO_KEY_MS)
    let _ = fav_grid
    .row(view::Live::Is(true))
    .gap(view::Live::Is(SP_6))
    .rigid()
    .padding(view::Live::Is((SP_0, SP_4, SP_0, SP_2)))
    .radius(view::Live::Is(SP_12))
    .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(model.dark()), drop_t()) }))
    fav_grid.each(
      model.favorites,
      fn(f : ShellFavoriteItem) -> String { f.id },
      fn(row : view::View, fav_sig : signals::Signal[ShellFavoriteItem]) -> Unit {
        let _ = row.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
        dr.fav_tiles.set(fav_sig.untracked().id, row)
        // Where a tab dropped in the grid lands: a 2pt accent line in the gap before this tile (or after the last).
        let lands_here = fn(trailing : Bool) -> Bool {
          let me = fav_sig.get().id
          let h = dr.id.get()
          if h == "" || h == me || dr.target.get() != proto::TAB_DROP_FAVORITES {
            return false
          }
          let b = dr.before.get()
          // (the tile after the held one; "#" when the held tab is no favorite yet)
          let next = match sidebar_fav_next(model, h) {
            Some(n) => n
            None => "#"
          }
          if trailing {
            b == "" && fav_last_not(model, h) == me && next != ""
          } else {
            b == me && next != me
          }
        }
        for trailing in [false, true] {
          row.show(fn() { lands_here(trailing) }, fn(line : view::View) -> Unit {
            let _ = line
            .over(view::Live::Is(true), edges=if trailing {
              (None, Some(SP_8), Some(SP_0 - SP_4), Some(SP_8))
            } else {
              (Some(SP_0 - SP_4), Some(SP_8), None, Some(SP_8))
            })
            .width(view::Live::Is(Some(SP_2)))
            .radius(view::Live::Is(SP_2))
            .points(view::Live::Is(false))
            .ground(view::Live::By(fn() { lg::surface().accent }))
          })
        }
        let _ = headless::button(
          row,
          fn() { fav_sig.get().title },
          fn(_e) -> Unit { emit(ShellIntent::SelectFavorite(fav_sig.untracked().id)) },
          fn(tile : view::View, btn : headless::Button) -> Unit {
            let hover_t = shell_fade(tile, fn() { btn.hovered() || btn.pressed() })
            // The open favorite is raised like the selected tab row (strong wash + lift, over MO_KEY_MS).
            let act_t = shell_fade(tile, fn() { fav_sig.get().active }, duration_ms=MO_KEY_MS)
            let held = fn() -> Bool { dr.holds(fav_sig.get().id) }
            let home = motion::NodeWay::new(0.0)
            let home_from = view::ref_new((0.0, 0.0))
            let _ = tile
            .fill()
            .height(view::Live::Is(Some(SP_48)))
            .radius(view::Live::Is(SP_12))
            .center()
            .ground(view::Live::By(fn() {
              let d = model.dark()
              let a = act_t()
              lg::over(
                lg::over(shell_wash(d), lg::alpha(shell_wash_hover(d), hover_t() * (1.0 - a))),
                lg::alpha(shell_wash_strong(d), a),
              )
            }))
            .shadow(view::Live::By(fn() {
              let a = act_t()
              if a <= 0.0 {
                (0.0, 0.0, 0x00000000L)
              } else {
                let (blur, dy, c) = shell_row_lift(model.dark())
                (blur, dy, lg::alpha(c, a))
              }
            }))
            .shadow_outside(view::Live::Is(true))
            .offset(view::Live::By(fn() {
              if held() {
                dr.moved()
              } else {
                let k = home.shown(tile)
                let (hx, hy) = home_from.v
                (hx * k, hy * k)
              }
            }))
            .cursor(view::Live::By(fn() { if held() { Some(view::Cursor::Grabbing) } else { None } }))
            shell_press(tile, fn() { btn.pressed() && !held() })
            // A favorite drags out to Pinned, Today or a folder like a tab row; a mouse press opens it at once.
            tab_drag_gesture(
              tile,
              dr,
              model,
              emit,
              fn() { fav_sig.untracked().id },
              fn() { !fav_sig.untracked().active },
              fn(mx : Double, my : Double) -> Unit {
                home_from.v = (mx, my)
                home.put(1.0)
                shell_go(home, tile, 0.0, MO_KEY_MS)
              },
            )
            let _ = tile
            .on_menu(fn(_m : view::Menu) -> Unit {
              match hooks {
                Some(h) => match h.on_tab_context {
                  Some(cb) => {
                    let (_, ty, _, _) = tile.placed_window_now()
                    cb(fav_sig.untracked().id, ty)
                  }
                  None => ()
                }
                None => ()
              }
            })
            let _ = shell_favicon_tile(
              tile,
              fn() { fav_sig.get().url },
              size=SP_20,
              letter_by=fn() { fav_sig.get().monogram },
              ground_by=fn() { fav_sig.get().accent_rgba },
              letter_size=TX_CAPTION,
            )
          },
        )
      },
      at_once=true,
    )
  })

  // 3. Scrollable folders + Today tabs.
  let _ = sb.box(fn(scroll_host : view::View) -> Unit {
    // (reaching back over the sidebar's inset to the window edge: the rows' presses start there)
    let _ = scroll_host.fill().margin(view::Live::Is((SP_0 - edge, SP_0, SP_0, SP_0)))
    let _ = ui::scroll_box(scroll?=tabs_scroll, scroll_host, fn(list : view::View) -> Unit {
      let _ = list.gap(view::Live::Is(SP_2)).padding(view::Live::Is((SP_0, SP_2, SP_0, SP_6)))

      // Keyed folders list
      let _ = list.box(fn(folders_col : view::View) -> Unit {
        let _ = folders_col.gap(view::Live::Is(SP_2))
        folders_col.each(
          model.folders,
          fn(f : ShellFolderItem) -> String { f.id },
          fn(fwrap : view::View, folder_sig : signals::Signal[ShellFolderItem]) -> Unit {
            let _ = fwrap.gap(view::Live::Is(SP_2))
            let is_collapsed = fn() -> Bool { folder_sig.get().collapsed }
            sidebar_plain_row(
              fwrap,
              model,
              fn() { folder_sig.get().name },
              fn() { emit(ShellIntent::ToggleFolder(folder_sig.untracked().id)) },
              edge=edge,
              strong=fn() { dr.id.get() != "" && dr.target.get() == proto::TAB_DROP_FOLDER + folder_sig.get().id },
              made=fn(fh : view::View) { dr.folders.set(folder_sig.untracked().id, fh) },
              fn(lead : view::View) -> Unit {
                let _ = shell_icon_by(
                  lead,
                  fn() { if is_collapsed() { ICON_CHEVRON_RIGHT } else { ICON_CHEVRON_DOWN } },
                  size=IC_SM,
                  color_by=fn() { shell_frame_ink_secondary(model.dark()) },
                )
              },
              on_menu=Some(fn(fh : view::View) -> Unit {
                match hooks {
                  Some(h) => match h.on_folder_context {
                    Some(cb) => {
                      let (_, fy, _, _) = fh.placed_window_now()
                      cb(folder_sig.untracked().id, fy)
                    }
                    None => ()
                  }
                  None => ()
                }
              }),
              weight=500,
            )
            // Folder children tabs (keyed `View::each`), indented under the folder name
            fwrap.show(fn() { !is_collapsed() }, fn(fc : view::View) -> Unit {
              // (the indent is the rows' own, so their presses still start at the window edge)
              let _ = fc.gap(view::Live::Is(SP_2))
              fc.each(
                fn() -> Array[ShellTabItem] { sidebar_folder_tabs(model, folder_sig.get().id) },
                fn(t : ShellTabItem) -> String { t.id },
                fn(row : view::View, tsig : signals::Signal[ShellTabItem]) -> Unit {
                  build_tab_row(row, tsig, model, emit, hooks, dr, indent=SP_10)
                },
                at_once=true,
              )
            })
          },
          at_once=true,
        )
      })

      // Pinned tabs (not in a folder) above the divider, under the folders: pinning moves a tab up here.
      let _ = list.box(fn(pinned_col : view::View) -> Unit {
        let _ = pinned_col.gap(view::Live::Is(SP_2))
        pinned_col.each(
          fn() -> Array[ShellTabItem] { sidebar_pinned_tabs(model) },
          fn(t : ShellTabItem) -> String { t.id },
          fn(row : view::View, tsig : signals::Signal[ShellTabItem]) -> Unit {
            build_tab_row(row, tsig, model, emit, hooks, dr)
          },
          at_once=true,
        )
      })

      // Today divider: a hairline with the section name, the pinned area above, today's tabs below.
      let _ = list.box(fn(divider : view::View) -> Unit {
        dr.divider.v = Some(divider)
        let _ = divider.rigid()
        let _ = divider
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_8))
        .padding(view::Live::Is((edge + SP_8, SP_6, SP_8, SP_6)))
        <ui::Text in={divider} size={TX_CAPTION} weight={500} color_by=>{shell_frame_ink_secondary(model.dark())} text="Today" />
        <ui::Box in={divider} fill height={SP_2} bg_by=>{if model.dark() { 0xFFFFFF14L } else { 0x0000000FL }} />
        // A drop on the empty Pinned area (the upper half of the divider) pins the tab.
        tab_drop_line(divider, edge + SP_8, fn() {
          dr.id.get() != "" && dr.target.get() == proto::TAB_DROP_PINNED && dr.before.get() == "" &&
          sidebar_last_in(model, proto::TAB_DROP_PINNED, dr.id.get()) == ""
        })
      })

      sidebar_plain_row(
        list,
        model,
        fn() { "New Tab" },
        fn() { emit(ShellIntent::NewTab) },
        fn(lead : view::View) -> Unit {
          let _ = shell_icon(lead, ICON_PLUS, size=IC_MD, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
        },
        secondary=true,
        edge=edge,
      )

      // Keyed Today tabs list
      let _ = list.box(fn(today_col : view::View) -> Unit {
        let _ = today_col.gap(view::Live::Is(SP_2))
        today_col.each(
          fn() -> Array[ShellTabItem] { sidebar_today_tabs(model) },
          fn(t : ShellTabItem) -> String { t.id },
          fn(row : view::View, tsig : signals::Signal[ShellTabItem]) -> Unit {
            build_tab_row(row, tsig, model, emit, hooks, dr)
          },
          at_once=true,
        )
      })
    })
  })

  // 4. Now Playing: the source and the two controls on the first line, the title on its own line below (so it
  //    keeps the full width even in a narrow sidebar), a hairline progress track.
  //    The whole card outside the two controls goes to the playing tab (MediaJumpToTab) and lights as one.
  sb.show(fn() { model.mini_player().is_visible() }, fn(mp_host : view::View) -> Unit {
    let hover_t = shell_fade(mp_host, fn() { mp_host.pointed() || mp_host.pointed_in() })
    let jump_label = fn() -> String { "Go to " + model.mini_player().title }
    let _ = mp_host
    .rigid()
    .radius(view::Live::Is(SP_12))
    .padding(view::Live::Is((SP_0, SP_4, SP_4, SP_0)))
    .gap(view::Live::Is(SP_2))
    .ground(view::Live::By(fn() {
      lg::over(shell_wash(model.dark()), lg::alpha(shell_wash_hover(model.dark()), hover_t()))
    }))
    .says(view::Live::Is(Some(view::said(view::Role::Region, label="Mini Media Player"))))
    let _ = mp_host.box(fn(src : view::View) -> Unit {
      let _ = src.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_0)).rigid()
      let _ = headless::button(src, jump_label, fn(_e) -> Unit { emit(ShellIntent::MediaJumpToTab) }, fn(
        jb : view::View,
        _btn : headless::Button,
      ) -> Unit {
        let _ = jb
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_8))
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_width(view::Live::Is(Some(0.0)))
        .min_height(view::Live::Is(Some(SP_32)))
        .padding(view::Live::Is((SP_12, SP_0, SP_0, SP_0)))
        let _ = shell_site_tile(jb, fn() { model.mini_player().domain }, size=SP_16)
        let _ = jb.box(fn(dw : view::View) -> Unit {
          let _ = dw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
          let _ = <ui::Text
            in={dw}
            size={TX_CAPTION}
            weight={500}
            color_by=>{shell_frame_ink_secondary(model.dark())}
            text_by=>{model.mini_player().domain}
          />.allow_ellipsis(view::Live::Is(true))
        })
      })
      let _ = src.box(fn(ctl : view::View) -> Unit {
        let _ = ctl.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_0)).rigid()
        <lg::Button
          in={ctl}
          flat
          ghost
          height={SP_32}
          pad_x={SP_8}
          label_by=>{if model.mini_player().muted { "Unmute Media" } else { "Mute Media" }}
          on_press=>{emit(ShellIntent::MediaToggleMute)}
        >
          <ui::Show when=>{model.mini_player().muted}>
            <icons::Icon name={ICON_VOLUME_MUTE} size={IC_MD} color_by=>{shell_frame_ink_secondary(model.dark())} />
          </ui::Show>
          <ui::Show when=>{!model.mini_player().muted}>
            <icons::Icon name={ICON_VOLUME} size={IC_MD} color_by=>{shell_frame_ink_secondary(model.dark())} />
          </ui::Show>
        </lg::Button>
        <lg::Button
          in={ctl}
          flat
          ghost
          height={SP_32}
          pad_x={SP_8}
          label_by=>{if model.mini_player().playing { "Pause Media" } else { "Play Media" }}
          on_press=>{emit(ShellIntent::MediaTogglePlay)}
        >
          <ui::Show when=>{model.mini_player().playing}>
            <icons::Icon name={ICON_PAUSE} size={IC_MD} color_by=>{lg::surface().ink} />
          </ui::Show>
          <ui::Show when=>{!model.mini_player().playing}>
            <icons::Icon name={ICON_PLAY} size={IC_MD} color_by=>{lg::surface().ink} />
          </ui::Show>
        </lg::Button>
      })
    })
    // The title and the progress track: the second half of the jump target (no button inside a button). It takes
    // the pointer's press only: the jump is one focus stop and one button read out (the source row above), not two.
    let _ = mp_host.box(fn(body : view::View) -> Unit {
      let _ = body.presses(view::Live::Is(true)).on_press(fn() { emit(ShellIntent::MediaJumpToTab) })
      let _ = body.rigid().gap(view::Live::Is(SP_4)).padding(view::Live::Is((SP_12, SP_2, SP_8, SP_12)))
      let _ = body.box(fn(tw : view::View) -> Unit {
        let _ = tw.padding(view::Live::Is((SP_0, SP_0, SP_8, SP_0))).min_width(view::Live::Is(Some(0.0))).rigid().cut()
        let _ = <ui::Text
          in={tw}
          size={TX_FOOTNOTE}
          weight={500}
          color_by=>{lg::surface().ink}
          text_by=>{model.mini_player().title}
        />.allow_ellipsis(view::Live::Is(true))
      })
      // Proportional progress track (flex grow = ratio vs 1 - ratio), inset to the same 12pt on both sides.
      let _ = body.box(fn(track_wrap : view::View) -> Unit {
        let _ = track_wrap.padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0))).rigid()
        <ui::Row in={track_wrap} height={SP_2} radius={SP_2} clip bg_by=>{if model.dark() { 0xFFFFFF1FL } else { 0x0000001AL }} rigid>
          <ui::Box
            height={SP_2}
            radius={SP_2}
            grow={1.0}
            bg_by=>{lg::surface().ink}
            ref_view={fn(bar : view::View) -> Unit {
              let _ = bar
              .grow(view::Live::By(fn() {
                let r = model.mini_player().progress_ratio()
                if r < 0.001 { 0.001 } else if r > 1.0 { 1.0 } else { r }
              }))
              .basis(view::Live::Is(Some(0.0)))
            }}
          />
          <ui::Box
            height={SP_2}
            grow={1.0}
            ref_view={fn(rem : view::View) -> Unit {
              let _ = rem
              .grow(view::Live::By(fn() {
                let r = model.mini_player().progress_ratio()
                let left = 1.0 - r
                if left < 0.001 { 0.001 } else if left > 1.0 { 1.0 } else { left }
              }))
              .basis(view::Live::Is(Some(0.0)))
            }}
          />
        </ui::Row>
      })
    })
  })

  // 4b. A download the page started: the file, a hairline of its progress; it comes in like a popover the first
  //     time (fade + 0.97 from its foot), leaves a moment after it finishes; pressing it opens Downloads.
  match hooks {
    Some(h) => match (h.downloads_activity, h.on_downloads_activity) {
      (Some(act), Some(open_dl)) => build_sidebar_download_row(sb, model, act, open_dl)
      _ => ()
    }
    None => ()
  }

  // 5. Space bar: the active Space's name on the left, one dot per Space on the right.
  let _ = sb.box(fn(sp_bar : view::View) -> Unit {
    let _ = sp_bar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Between))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_2, SP_0, SP_0, SP_0)))
    .rigid()
    let header_cb = match hooks {
      Some(h) => h.on_space_header_click
      None => None
    }
    let modes = sm_hooks_modes(hooks)
    match modes {
      Some(p) => {
        let _ = shell_frame_icon_btn(sp_bar, model, "Library", "layout-grid", fn() { (p.on_open_library)() })
      }
      None => ()
    }
    let _ = headless::button(
      sp_bar,
      fn() { "Customize Space" },
      fn(_e) -> Unit {
        match header_cb {
          Some(f) => f()
          None => ()
        }
      },
      fn(sh : view::View, btn : headless::Button) -> Unit {
        let hover_t = shell_fade(sh, fn() { header_cb.is_some() && (btn.hovered() || btn.pressed()) })
        let _ = sh
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_8))
        .height(view::Live::Is(Some(SP_32)))
        .padding(view::Live::Is((SP_6, SP_0, SP_8, SP_0)))
        .radius(view::Live::Is(SP_8))
        .min_width(view::Live::Is(Some(0.0)))
        .shrink(view::Live::Is(1.0))
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(model.dark()), hover_t()) }))
        let _ = sh.box(fn(dot : view::View) -> Unit {
          let _ = dot
          .width(view::Live::Is(Some(SP_8)))
          .height(view::Live::Is(Some(SP_8)))
          .radius(view::Live::Is(SP_4))
          .shrink(view::Live::Is(0.0))
          .ground(view::Live::By(fn() { shell_space_accent(model) }))
        })
        let _ = sh.box(fn(tw : view::View) -> Unit {
          // (the room the bar leaves it; a name cut to a letter or two is left out: the active dot says it)
          let _ = tw.min_width(view::Live::Is(Some(0.0))).shrink(view::Live::Is(1.0)).grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).cut()
          let _ = tw.by_room(fn(inner : view::View, room : view::Room) -> Unit {
            inner.show(fn() { room.width() >= SP_40 }, fn(nm : view::View) -> Unit {
              let _ = <ui::Text in={nm} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text_by=>{shell_space_name(model)} />.allow_ellipsis(
                view::Live::Is(true),
              )
            })
          })
        })
      },
    )
    let _ = sp_bar.box(fn(right : view::View) -> Unit {
      let _ = right.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_0)).rigid()
      match hooks {
        Some(h) => match h.on_tab_count_click {
          Some(cb) => {
            let _ = shell_frame_icon_btn(right, model, "Filter Tabs", ICON_SEARCH, fn() { cb() })
          }
          None => ()
        }
        None => ()
      }
      right.each(
        model.spaces,
        fn(sp : ShellSpaceItem) -> String { sp.id },
        fn(wrap : view::View, sp_sig : signals::Signal[ShellSpaceItem]) -> Unit {
          let is_active = fn() -> Bool { model.active_space_id() == sp_sig.get().id }
          let _ = headless::button(
            wrap,
            fn() { "Space " + sp_sig.get().name },
            fn(_e) -> Unit { emit(ShellIntent::SelectSpace(sp_sig.untracked().id)) },
            fn(b : view::View, btn : headless::Button) -> Unit {
              let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
              let _ = b
              .width(view::Live::Is(Some(SP_32)))
              .height(view::Live::Is(Some(SP_40)))
              .center()
              let _ = b.box(fn(face : view::View) -> Unit {
                let _ = face
                .width(view::Live::Is(Some(SP_24)))
                .height(view::Live::Is(Some(SP_24)))
                .radius(view::Live::Is(SP_12))
                .points(view::Live::Is(false))
                .center()
                .ground(view::Live::By(fn() {
                  if is_active() {
                    shell_wash_strong(model.dark())
                  } else {
                    lg::alpha(shell_wash_hover(model.dark()), hover_t())
                  }
                }))
                shell_press(face, fn() { btn.pressed() })
                let _ = face.box(fn(dot : view::View) -> Unit {
                  let _ = dot
                  .width(view::Live::Is(Some(SP_8)))
                  .height(view::Live::Is(Some(SP_8)))
                  .radius(view::Live::Is(SP_4))
                  .ground(view::Live::By(fn() {
                    if is_active() { sp_sig.get().accent_rgba } else { lg::alpha(sp_sig.get().accent_rgba, 0.55) }
                  }))
                })
              })
            },
          )
        },
        at_once=true,
      )
      match modes {
        Some(p) => {
          let _ = shell_frame_icon_btn(right, model, "New Space", ICON_PLUS, fn() { (p.on_new_space)() })
        }
        None => ()
      }
    })
  })

  // 6. The held tab row, drawn last over the whole sidebar (outside the tab list's clip).
  build_tab_drag_ghost(sb, model, dr)
}

///| Category tile colors (DESIGN.md section 3), one per kind, shared by every frame panel.
let FRAME_TILE_BOOKMARKS : Int64 = 0xFF9500FFL // orange

let FRAME_TILE_HISTORY : Int64 = 0x8E8E93FFL // gray

let FRAME_TILE_SEARCH : Int64 = 0x007AFFFFL // blue

let FRAME_TILE_TABS : Int64 = 0x5856D6FFL // indigo

let FRAME_TILE_DOWNLOADS : Int64 = 0x007AFFFFL // blue: downloads and saved files

let FRAME_TILE_APPEARANCE : Int64 = 0xAF52DEFFL // purple

let FRAME_TILE_READER : Int64 = 0xFF9500FFL // orange

let FRAME_TILE_LAYOUT : Int64 = 0x007AFFFFL // blue

let FRAME_TILE_OTHER : Int64 = 0x30B0C7FFL // teal

fn omnibox_row_tile_color(icon_name : String) -> Int64 {
  if icon_name == ICON_STAR || icon_name == ICON_STAR_FILLED || icon_name == ICON_BOOKMARK {
    FRAME_TILE_BOOKMARKS
  } else if icon_name == ICON_CLOCK {
    FRAME_TILE_HISTORY
  } else if icon_name == ICON_SEARCH {
    FRAME_TILE_SEARCH
  } else if icon_name == ICON_LAYERS {
    FRAME_TILE_TABS
  } else if icon_name == ICON_SPARKLES || icon_name == ICON_ZAP {
    FRAME_TILE_APPEARANCE
  } else {
    FRAME_TILE_OTHER
  }
}

///| Sentence case for palette captions and badges: every word after the first that is written as a capitalized
///| word (`Tabs`, `Search`) is lowered; acronyms (`URL`) and the first word stay as they are.
fn palette_sentence_case(s : String) -> String {
  let words = s.split(" ")
  let mut out = ""
  let mut i = 0
  while i < words.length() {
    let w = words[i]
    let fixed = if i > 0 && w.length() > 1 && palette_is_capitalized(w) { proto::omni_suggest_utf8_lower(w) } else { w }
    out = if i == 0 { fixed } else { out + " " + fixed }
    i += 1
  }
  out
}

fn palette_is_capitalized(w : String) -> Bool {
  let b = w.to_bytes()
  let c0 = b[0].to_int()
  if c0 < 65 || c0 > 90 {
    return false
  }
  let mut i = 1
  while i < b.length() {
    let c = b[i].to_int()
    if c >= 65 && c <= 90 {
      return false
    }
    i += 1
  }
  true
}

///| The palette's rows as shown: captions and badges in sentence case, and a trailing badge only where it names
///| an action the section caption does not already say (`Switch to tab` under `Open tabs`; no `History` badge on
///| every row under `History`, no `Search` under `Web search`).
fn palette_rows(items : Array[proto::OmniSuggestItem]) -> Array[ShellOmniboxRow] {
  let rows = build_omnibox_rows(items)
  let out : Array[ShellOmniboxRow] = []
  let mut section = ""
  let mut i = 0
  while i < rows.length() {
    let r = rows[i]
    if r.section_header != "" {
      section = proto::omni_suggest_utf8_lower(r.section_header)
    }
    let badge = proto::omni_suggest_utf8_lower(r.badge_label)
    let redundant = badge == "" || section.contains(badge) || badge.contains(section) && section != ""
    out.push(ShellOmniboxRow::{
      ..r,
      section_header: palette_sentence_case(r.section_header),
      badge_label: if redundant { "" } else { palette_sentence_case(r.badge_label) },
    })
    i += 1
  }
  out
}

///| Builds the command palette shown while the address is being edited: a dense single-layer glass panel
///| centered over the page column, holding the address field and the keyed suggestion rows.
///| - Click outside (non-swallowing: the same click still reaches the page) or Escape restores the URL.
///| - Opened 100+ times a day, mostly by Cmd+L: it only fades in over MO_KEY_MS (opacity, no lift, nothing laid out
///|   again per frame) and closes at once; the field takes keys from its first frame.
fn build_omnibox_palette(
  host : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  omni_wrap_ref : signals::Ref[Option[view::View]],
  omni_panel_ref : signals::Ref[Option[view::View]],
  column_left : () -> Double,
  column_w : () -> Double,
  focus_active_pane : () -> Unit,
  hooks : Option[ShellHostHooks],
) -> Unit {
  let is_open = fn() -> Bool { model.omnibox_editing() }
  let has_rows = fn() -> Bool {
    let ex = model.exclusive()
    model.omnibox_suggest().open && model.omnibox_suggest().items.length() > 0 &&
    (ex.active is ExclusiveKind::OmniboxSuggest) &&
    (ex.matches_tag("shell_omnibox") || ex.matches_tag("omnibox"))
  }
  // Opened by the person: fade in. Already open when the shell is built: there at once.
  let built : signals::Ref[Bool] = ui::ref_new(false)
  let _ = host.box(fn(ov_host : view::View) -> Unit {
    let _ = ov_host.over(view::Live::Is(true)).points(view::Live::Is(false))
    // Closes at once: Cmd+L, type, Enter, Cmd+L again must never meet a palette still on its way out.
    ov_host.show(is_open, fn(layer : view::View) -> Unit {
      let reveal = shell_reveal(layer, built.v, enter_ms=MO_KEY_MS, exit_ms=0.0)
      let _ = layer.over(view::Live::Is(true)).points(view::Live::Is(false))

      // Non-swallowing click-outside observer: a press outside the palette closes it and still lands on the page.
      let mut last_down = signals::untracked(fn() -> Int { layer.window_downs() })
      layer.reacts(fn() -> Int { layer.window_downs() }, fn(cnt : Int) -> Unit {
        if cnt == last_down {
          return
        }
        last_down = cnt
        if !is_open() {
          return
        }
        let (dx, dy) = layer.window_down_point()
        let in_box = fn(v_opt : Option[view::View]) -> Bool {
          match v_opt {
            Some(v) if v.alive() => {
              let (vx, vy, vw, vh) = v.placed_window_now()
              vw > 0.0 && vh > 0.0 && dx >= vx && dx <= vx + vw && dy >= vy && dy <= vy + vh
            }
            _ => false
          }
        }
        if !in_box(omni_wrap_ref.v) && !in_box(omni_panel_ref.v) {
          emit(ShellIntent::OmniboxBlur)
        }
      })

      let pal_w = fn() -> Double {
        let cw = column_w()
        let w = cw - SP_48
        if w > SHELL_PALETTE_W { SHELL_PALETTE_W } else if w < SP_160 + SP_128 { if cw - SP_16 > 0.0 { cw - SP_16 } else { 0.0 } } else { w }
      }
      let pal_left = fn() -> Double { column_left() + (column_w() - pal_w()) / 2.0 }
      let pal_top = fn() -> Double {
        let wh = layer.window_h()
        let h = if wh > 0.0 { wh } else { 800.0 }
        let t = h * 0.14
        if t < SP_48 { SP_48 } else if t > SP_128 { SP_128 } else { t }
      }

      let _ = layer.box(fn(anchor_wrap : view::View) -> Unit {
        let _ = anchor_wrap
        .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_0), None, None))
        .margin(view::Live::By(fn() { (pal_left(), pal_top(), 0.0, 0.0) }))
        .width(view::Live::By(fn() { Some(pal_w()) }))
        .alpha(view::Live::By(fn() { reveal.shown_on(anchor_wrap) }))
        .points(view::Live::By(is_open))

        let _ = lg::liquid_dialog_shell_node(
          anchor_wrap,
          fn(panel : view::View) -> Unit {
            omni_panel_ref.v = Some(panel)
            omni_wrap_ref.v = Some(panel)
            match hooks {
              Some(h) => match h.on_omnibox_panel_view {
                Some(cb) => cb(panel)
                None => ()
              }
              None => ()
            }
            let _ = panel
            .width(view::Live::By(fn() { Some(pal_w()) }))
            .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
            .gap(view::Live::Is(SP_0))
            .points(view::Live::Is(true))
            .says(view::Live::Is(Some(view::said(view::Role::Region, label="Omnibox Suggestions"))))
            // A press anywhere on the palette (rim, captions, gaps) stays in it and never reaches the page under it.
            .on_press(fn() -> Unit { () })
            .on_key(fn(k : view::Key) -> Bool {
              // Respect active IME composition: pass Arrow/Enter/Escape through to IME!
              if model.omnibox_field.composing() {
                return false
              }
              if k.code == ui::key_escape && k.mods == 0 && signals::untracked(model.omnibox_editing) {
                emit(ShellIntent::OmniboxEscape)
                focus_active_pane()
                return true
              }
              if !model.omnibox_field.focused() {
                return false
              }
              if k.code == proto::KEY_DOWN && k.mods == 0 && model.omnibox_suggest().open {
                emit(ShellIntent::OmniboxMoveSelection(1))
                return true
              }
              if k.code == proto::KEY_UP && k.mods == 0 && model.omnibox_suggest().open {
                emit(ShellIntent::OmniboxMoveSelection(-1))
                return true
              }
              false
            })

            // The address field: large, frameless, the security / search glyph leading.
            // Content sits on one solid card; the glass is only the SP_8 rim around it, so nothing behind
            // the palette shows through its rows.
            let _ = panel.box(fn(card : view::View) -> Unit {
              let _ = card
              .radius(view::Live::Is(SP_32))
              .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_8)))
              .gap(view::Live::Is(SP_2))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() { lg::surface().card }))
              let _ = card.box(fn(edit_host : view::View) -> Unit {
                let _ = edit_host.height(view::Live::Is(Some(SP_48))).rigid()
                let _ = lg::liquid_search_bar_node(
                  edit_host,
                  model.omnibox_field,
                  placeholder="Search or enter address",
                  height_by=fn() { SP_48 },
                  flat=true,
                  label=fn() { "Address Bar" },
                  leading=fn(lead : view::View, ink : () -> Int64) -> Unit {
                    lead.show(fn() { model.omnibox_security() is OmniboxSecurity::EditingSearch }, fn(ic : view::View) -> Unit {
                      let _ = shell_icon(ic, ICON_SEARCH, size=IC_MD, color_by=ink)
                    })
                    lead.show(fn() { model.omnibox_security() is OmniboxSecurity::SecureHttps }, fn(ic : view::View) -> Unit {
                      let _ = shell_icon(ic, ICON_LOCK, size=IC_MD, color_by=ink)
                    })
                    lead.show(fn() { model.omnibox_security() is OmniboxSecurity::InsecureHttp }, fn(ic : view::View) -> Unit {
                      let _ = shell_icon(ic, ICON_SHIELD, size=IC_MD, color_by=fn() { lg::surface().warning })
                    })
                    lead.show(fn() { model.omnibox_security() is OmniboxSecurity::InternalPage }, fn(ic : view::View) -> Unit {
                      let _ = shell_icon(ic, ICON_GLOBE, size=IC_MD, color_by=ink)
                    })
                  },
                  edited=fn(q : String) -> Unit { emit(ShellIntent::OmniboxEdit(q)) },
                  submitted=fn(q : String) -> Unit { emit(ShellIntent::OmniboxSubmit(q)) },
                  on_clear=fn() -> Unit { emit(ShellIntent::OmniboxEdit("")) },
                  on_escape=fn() -> Unit {
                    if !model.omnibox_field.composing() {
                      emit(ShellIntent::OmniboxEscape)
                      focus_active_pane()
                    }
                  },
                )
                // Select all on the idle -> editing transition (never re-selects once already editing).
                if signals::untracked(model.omnibox_editing) {
                  let was_focused = model.omnibox_field.focused()
                  if was_focused {
                    model.omnibox_field.let_go()
                  }
                  model.omnibox_field.focus()
                  if !was_focused {
                    let len = model.omnibox_field.text().length()
                    if len > 0 {
                      model.omnibox_field.pick(0, len)
                    }
                  }
                }
              })

              card.show(has_rows, fn(rows : view::View) -> Unit {
                let _ = rows.gap(view::Live::Is(SP_2)).padding(view::Live::Is((SP_0, SP_6, SP_0, SP_0)))
                let _ = rows.box(fn(rule : view::View) -> Unit {
                  let _ = rule
                  .height(view::Live::Is(Some(lg::hairline_w)))
                  .margin(view::Live::Is((SP_6, SP_0, SP_6, SP_4)))
                  .ground(view::Live::By(fn() { lg::surface().separator }))
                })
                rows.each(
                  fn() -> Array[ShellOmniboxRow] { palette_rows(model.omnibox_suggest().items) },
                  fn(r : ShellOmniboxRow) -> String { r.key },
                  fn(slot : view::View, row_sig : signals::Signal[ShellOmniboxRow]) -> Unit {
                    let _ = slot.gap(view::Live::Is(SP_2))
                    slot.show(fn() { row_sig.get().section_header != "" }, fn(sh : view::View) -> Unit {
                      let _ = sh.padding(view::Live::Is((SP_10, SP_6, SP_10, SP_2))).rigid()
                      let _ = <ui::Text
                        in={sh}
                        size={TX_CAPTION}
                        weight={500}
                        color_by=>{lg::surface().ink_secondary}
                        text_by=>{row_sig.get().section_header}
                      />
                    })

                    let is_sel = fn() -> Bool { model.omnibox_suggest().selected == row_sig.get().idx }
                    let row_v = headless::button(
                      slot,
                      fn() { row_sig.get().title },
                      fn(_e) -> Unit { emit(ShellIntent::OmniboxSelectIndex(row_sig.untracked().idx)) },
                      fn(row : view::View, btn : headless::Button) -> Unit {
                        let hover_t = shell_fade(row, fn() { btn.hovered() })
                        let _ = row
                        .row(view::Live::Is(true))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .min_height(view::Live::Is(Some(SP_40)))
                        .padding(view::Live::Is((SP_8, SP_6, SP_10, SP_6)))
                        .gap(view::Live::Is(SP_10))
                        .radius(view::Live::Is(SP_16))
                        .ground(view::Live::By(fn() {
                          if is_sel() {
                            if model.dark() { 0x0A84FF4DL } else { 0x007AFF26L }
                          } else {
                            lg::alpha(lg::surface().row_hover, hover_t())
                          }
                        }))
                        let _ = shell_glyph_tile(
                          row,
                          row_sig.untracked().icon_name,
                          fn() { omnibox_row_tile_color(row_sig.get().icon_name) },
                          size=SP_24,
                        )
                        let _ = row.box(fn(tw : view::View) -> Unit {
                          let _ = tw
                          .grow(view::Live::Is(1.0))
                          .basis(view::Live::Is(Some(0.0)))
                          .min_width(view::Live::Is(Some(0.0)))
                          .row(view::Live::Is(true))
                          .lines_up(view::Live::Is(Some(view::Along::Middle)))
                          .gap(view::Live::Is(SP_8))
                          .cut()
                          let _ = tw.box(fn(t1 : view::View) -> Unit {
                            let _ = t1.min_width(view::Live::Is(Some(0.0))).shrink(view::Live::Is(1.0)).cut()
                            let _ = <ui::Text
                              in={t1}
                              size={TX_BODY}
                              weight={500}
                              color_by=>{lg::surface().ink}
                              text_by=>{row_sig.get().title}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                          let _ = tw.box(fn(t2 : view::View) -> Unit {
                            let _ = t2.min_width(view::Live::Is(Some(0.0))).shrink(view::Live::Is(10.0)).cut()
                            let _ = <ui::Text
                              in={t2}
                              size={TX_FOOTNOTE}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{row_sig.get().subtitle}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                        })
                        <ui::Box in={row} rigid>
                          <ui::Text
                            size={TX_CAPTION}
                            color_by=>{lg::surface().ink_secondary}
                            text_by=>{row_sig.get().badge_label}
                          />
                        </ui::Box>
                      },
                    )
                    // Rows are reached with the arrow keys (the field keeps the focus); Tab leaves the palette.
                    // They still take focus when given it directly, and Enter / Space then commit them.
                    let _ = row_v.focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space, tab=false)
                  },
                  at_once=true,
                )
              })
            })
          },
          // Concentric: the 48pt pill field sits SP_8 inside the SP_32 card (24 + 8), the card SP_8 inside the glass.
          radius=SP_40,
          solid=fn() { lg::surface().card },
        )
      })
    })
  })
  built.v = true
}

///| Builds the non-modal CaptureSheet (Passive layer) inside `body`: one popover in the bottom-right corner
///| (stretched across the page column below 720pt). A downloads-blue camera tile says what happened; the file name
///| and its facts sit beside it with Dismiss in the corner; Copy Path and Reveal follow under the text.
///| Content sits on a solid card; the glass is only the rim. Only the card intercepts pointer events, and its
///| buttons leave the focus order while any Exclusive is open.
fn build_capture_sheet_overlay(
  body : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  animate : () -> Bool,
) -> Unit {
  let narrow = fn() -> Bool {
    let w = body.window_w()
    w > 0.0 && w < SHELL_SIDEBAR_BREAKPOINT
  }
  // Grows 0.97 -> 1 out of the bottom-right corner it is pinned to, MO_POP_MS in and MO_POP_OUT_MS out, both
  // eased out (the same presence as the toast and the popovers); at once when it is already up as the frame is
  // built.
  body.show(fn() { model.passive().capture_sheet_open }, leave=MO_POP_OUT_MS, fn(wrap : view::View) -> Unit {
    let reveal = shell_popover_reveal(wrap, animate())
    let emit = fn(i : ShellIntent) -> Unit { view::transition(fn() { emit(i) }, within=wrap) }
    let _ = wrap
    .over(view::Live::Is(true), edges=(Some(SP_16), None, Some(SP_16), Some(SP_16)))
    .lines_up(view::Live::By(fn() { if narrow() { None } else { Some(view::Along::End) } }))
    .points(view::Live::Is(false))

    let in_focus = fn() -> Bool { capture_sheet_in_focus_order(model.exclusive(), model.passive()) }
    let has_actions = fn() -> Bool {
      model.passive().capture_sheet.path.trim() != "" || model.passive().capture_sheet_revealable
    }
    let _ = wrap.box(fn(shell : view::View) -> Unit {
      let _ = shell
      .width(view::Live::By(fn() { if narrow() { None } else { Some(SP_160 + SP_160) } }))
      .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
      .points(view::Live::Is(true))
      .says(view::Live::Is(Some(view::said(view::Role::Region, label="Capture Completed"))))
      // A press on the sheet (text, gaps) stays in it and never reaches the page under it.
      .on_press(fn() -> Unit { () })
      reveal.grows(shell, ox=1.0, oy=1.0)
      // Corners nest: glass SP_24 -> card SP_20 (4pt rim) -> 32pt pill buttons SP_4 in (16 + 4 = 20).
      let _ = lg::liquid_popover_surface_decorate(shell, radius=SP_24, solid=fn() { lg::surface().card })
      let _ = shell.box(fn(card : view::View) -> Unit {
        let _ = card
        .radius(view::Live::Is(SP_20))
        // Pill buttons on the bottom edge sit SP_4 in (concentric); with no actions the text keeps SP_12 below.
        .padding(view::Live::By(fn() { (SP_4, SP_4, SP_4, if has_actions() { SP_4 } else { SP_12 }) }))
        .gap(view::Live::Is(SP_8))
        .ground(view::Live::By(fn() { lg::surface().card }))

        // 1. What happened, and to which file; Dismiss in the top-right corner.
        let _ = card.box(fn(head : view::View) -> Unit {
          let _ = head.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(SP_12)).rigid()
          let _ = head.box(fn(tile_box : view::View) -> Unit {
            let _ = tile_box.padding(view::Live::Is((SP_8, SP_8, SP_0, SP_0))).rigid()
            let _ = shell_glyph_tile(tile_box, ICON_CAMERA, fn() { FRAME_TILE_DOWNLOADS }, size=SP_32)
          })
          let _ = head.box(fn(col : view::View) -> Unit {
            let _ = col
            .grow(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .gap(view::Live::Is(SP_2))
            .padding(view::Live::Is((SP_0, SP_8, SP_0, SP_0)))
            <ui::Text in={col} size={TX_BODY} weight={600} lines={1} color_by=>{lg::surface().ink} text="Screenshot saved" />
            // The whole name on up to two lines: its end (the time and the extension) tells two captures apart.
            <ui::Text
              in={col}
              size={TX_FOOTNOTE}
              lines={2}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{
                let m = model.passive().capture_sheet
                if m.filename != "" { m.filename } else { "farview-capture.png" }
              }
            />
            <ui::Text
              in={col}
              size={TX_FOOTNOTE}
              lines={1}
              color_by=>{lg::surface().ink_secondary}
              text_by=>{capture_sheet_facts(model.passive().capture_sheet)}
            />
            // The file lives on the host and cannot be shown here.
            col.show(fn() { model.passive().capture_sheet_file_unavailable }, fn(note : view::View) -> Unit {
              let _ = note
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(SP_4))
              .padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
              .rigid()
              let _ = shell_icon(note, ICON_INFO, size=IC_SM, color_by=fn() { lg::surface().ink_secondary })
              <ui::Text in={note} size={TX_FOOTNOTE} color_by=>{lg::surface().ink_secondary} text="File not accessible on this device" />
            })
          })
          bar_icon_btn(head, "Dismiss", ICON_CLOSE, fn() { emit(ShellIntent::CaptureDismiss) }, disabled=fn() { !in_focus() })
        })

        // 2. Actions under the text column (they leave the focus order whenever any Exclusive overlay is open).
        card.show(has_actions, fn(act_row : view::View) -> Unit {
          let _ = act_row
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(SP_8))
          .padding(view::Live::Is((SP_8 + SP_32 + SP_12, SP_0, SP_0, SP_0)))
          .rigid()
          act_row.show(fn() { model.passive().capture_sheet.path.trim() != "" }, fn(cp_wrap : view::View) -> Unit {
            let _ = cp_wrap.rigid()
            let _ = <lg::Button
              in={cp_wrap}
              flat
              prominent
              height={SP_32}
              label="Copy Path"
              disabled_by=>{!in_focus()}
              on_press=>{emit(ShellIntent::CaptureCopyPath)}
            />
          })
          act_row.show(fn() { model.passive().capture_sheet_revealable }, fn(rev_wrap : view::View) -> Unit {
            let _ = rev_wrap.rigid()
            let _ = <lg::Button
              in={rev_wrap}
              flat
              height={SP_32}
              label="Reveal"
              disabled_by=>{!in_focus()}
              on_press=>{emit(ShellIntent::CaptureRevealFile)}
            />
          })
        })
      })
    })
  })
}

///| The capture's facts in one quiet line: format, pixel size, file size (`PNG, 1280×800, 277 KB`).
fn capture_sheet_facts(m : proto::CaptureSheetMeta) -> String {
  let parts : Array[String] = [if m.format != "" { m.format } else { "PNG" }, proto::capture_sheet_dims_badge(m.width, m.height)]
  let size = proto::capture_sheet_size_label(m.size_bytes)
  if size != "" {
    parts.push(size)
  }
  let mut out = ""
  let mut i = 0
  while i < parts.length() {
    out = if i == 0 { parts[i] } else { out + ", " + parts[i] }
    i += 1
  }
  out
}

fn toast_kind_name(kind : ToastKind) -> String {
  match kind {
    ToastKind::Success => "success"
    ToastKind::Info => "info"
    ToastKind::Warning => "warning"
    ToastKind::Error => "error"
  }
}

fn toast_kind_color(kind : ToastKind) -> Int64 {
  match kind {
    ToastKind::Success => lg::surface().positive
    // (neutral: a note, not a state; color is kept for meaning)
    ToastKind::Info => lg::surface().ink_secondary
    ToastKind::Warning => lg::surface().warning
    ToastKind::Error => lg::surface().danger
  }
}

fn toast_kind_icon(kind : ToastKind) -> String {
  match kind {
    ToastKind::Success => ICON_CHECK_CIRCLE
    ToastKind::Info => ICON_INFO
    ToastKind::Warning => ICON_ALERT_TRIANGLE
    ToastKind::Error => ICON_ALERT_CIRCLE
  }
}

///| Builds the non-blocking toast: one glass pill centered at the top of the page, a status glyph in the kind's
///| color, the message, and an optional second line. Never intercepts pointer clicks (`points = false`).
///| The narrow-window (< 720pt) sidebar drawer: the docked sidebar's contents on a floating `lg` drawer island
///| at the leading edge. It is toggled by Cmd+S (the same shortcut that shows and hides the docked sidebar, tens of
///| times a day), so it moves like the other keyboard surfaces, not like an occasional drawer: it fades in with a
///| MO_DRAWER_NUDGE slide (transform only) over MO_KEY_MS and out over MO_POP_OUT_MS, both eased out, and is
///| usable from its first frame; already open as the frame is built, it is there at once. (`lg::liquid_drawer_node`
///| slides on a 280ms spring, leaves over 320ms and slides even when mounted open, with no knob for either.)
///| Escape, a click outside, Close and a flick toward the edge close it, as with the `lg` drawer.
fn build_narrow_sidebar_drawer(
  parent : view::View,
  animate : () -> Bool,
  asked : () -> Bool,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  body : (view::View) -> Unit,
  base_width : Double,
  wide_width~ : () -> Bool = fn() { false },
) -> Unit {
  let inset = SP_8
  let _ = parent.box(fn(h : view::View) -> Unit {
    let _ = h.over(view::Live::Is(true))
    // (the open as shown follows the model through a transition, so the way out plays for every close)
    let shown = signals::signal(signals::untracked(open))
    h.reacts(open, fn(on : Bool) -> Unit { view::transition(within=h, fn() { shown.set(on) }) }, at_start=false)
    // (asked for as the frame is built: there at once when it first shows, even if the window is found narrow
    // only on the first layout)
    let open_at_build = ui::ref_new(signals::untracked(asked))
    let eff_w = fn(n : view::View) -> Double {
      let width = if wide_width() { SM_LIBRARY_W } else { base_width }
      let ww = n.window_w()
      let avail = ww - 2.0 * inset
      if ww <= 0.0 || width < avail { width } else if avail > 0.0 { avail } else { 0.0 }
    }
    h.show(fn() { shown.get() }, leave=MO_POP_OUT_MS, fn(s : view::View) -> Unit {
      let reveal = shell_reveal(s, !open_at_build.v && animate(), enter_ms=MO_KEY_MS, exit_ms=MO_POP_OUT_MS)
      open_at_build.v = false
      // Where a drag let go of the card, eased back to 0 when it does not close.
      let settle = motion::NodeWay::new(0.0)
      let _ = s
      .over(view::Live::Is(true))
      .points(view::Live::By(open))
      .row(view::Live::Is(true))
      .lies_along(view::Live::Is(view::Lies::Start))
      .fills_across(view::Live::Is(true))
      let _ = s.box(fn(room : view::View) -> Unit {
        let _ = room
        .width(view::Live::By(fn() { Some(eff_w(room) + 2.0 * inset) }))
        .max_width(view::Live::By(fn() { Some(eff_w(room) + 2.0 * inset) }), within=true)
        .padding(view::Live::Is((inset, inset, inset, inset)))
        let _ = headless::drawer(
          room,
          title,
          open,
          on_close,
          edge=headless::DrawerEdge::Left,
          close_threshold=0.68,
          velocity_threshold=0.45,
          overpull_max=SP_16,
          drag_surface=false,
          on_release=fn(off : Double, _vel : Double, will_close : Bool) -> Unit {
            settle.put(-off)
            if !will_close {
              shell_go(settle, s, 0.0, MO_KEY_MS)
            }
          },
          fn(card : view::View, dr : headless::Drawer) -> Unit {
            reveal.fades(card)
            let _ = card
            .grow(view::Live::Is(1.0))
            .offset(view::Live::By(fn() {
              let nudge = if ui::reduced_motion() { 0.0 } else { MO_DRAWER_NUDGE * (1.0 - reveal.progress_on(card)) }
              let x = if dr.dragging() { -dr.drag_offset() } else { settle.shown(card) }
              (x - nudge, 0.0)
            }))
            let _ = lg::liquid_drawer_surface_decorate(card, radius=SP_24)
            let _ = dr.handle(
              card,
              extent_by=fn() { signals::untracked(fn() { eff_w(card) }) },
              slop=ui::touch_slop(),
              fn(pan : view::View, _d : headless::Drawer) -> Unit {
                let _ = pan.grow(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0)))
                // Header: the title and Close (8 + 16 = 24, concentric with the island).
                let _ = pan.box(fn(hdr : view::View) -> Unit {
                  let _ = hdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Between))
                  .gap(view::Live::Is(SP_8))
                  .padding(view::Live::Is((SP_16, SP_8, SP_8, SP_8)))
                  let _ = <ui::Text in={hdr} size={TX_HEADLINE} weight={600} color_by=>{lg::surface().ink} text_by=>{title()} />
                  bar_icon_btn(hdr, "Close", ICON_CLOSE, fn() { dr.close() })
                })
                let _ = pan.box(fn(sep : view::View) -> Unit {
                  let _ = sep.height(view::Live::Is(Some(lg::hairline_w))).ground(view::Live::By(fn() { lg::surface().separator }))
                })
                let _ = pan.box(fn(b : view::View) -> Unit {
                  let _ = b
                  .grow(view::Live::Is(1.0))
                  .min_height(view::Live::Is(Some(0.0)))
                  .padding(view::Live::Is((SP_12, SP_12, SP_12, SP_12)))
                  body(b)
                })
              },
            )
          },
        )
      })
    })
  })
}

///| The toast pill at the top center. It comes in like every other occasional surface: fade + 0.97 -> 1 about its
///| top edge (the edge it is pinned to) over MO_POP_MS, out over MO_POP_OUT_MS, both eased out; at once when it
///| is already up as the frame is built. Its exit plays when the close is told as a transition (the app's expiry
///| timer tells it so); a message replacing another in a toast that is up swaps in place.
///| A toast with an action (`toast_action`, "Undo") takes the pointer on its pill alone: the button presses, and
///| while the pointer is over the pill its timer holds (`ToastHover`); the page still gets every click round it.
fn build_toast_overlay(body : view::View, model : ShellModel, animate : () -> Bool, emit : (ShellIntent) -> Unit) -> Unit {
  let _ = body.box(fn(toast_host : view::View) -> Unit {
    let _ = toast_host
    .over(view::Live::Is(true), edges=(Some(SP_16), Some(SP_16), Some(SP_16), None))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .points(view::Live::Is(false))

    toast_host.show(fn() { model.passive().toast_visible }, leave=MO_POP_OUT_MS, fn(wrap : view::View) -> Unit {
      let reveal = shell_popover_reveal(wrap, animate())
      reveal.grows(wrap, ox=0.5, oy=0.0)
      let _ = wrap.points(view::Live::Is(false))
      let _ = lg::liquid_toast_shell_node(
        wrap,
        fn(rim : view::View) -> Unit {
          // The glass is a SP_4 rim; the message sits on a solid pill inside it (24 = 20 + 4, concentric).
          let _ = rim
          .padding(view::Live::Is((SP_4, SP_4, SP_4, SP_4)))
          .points(view::Live::Is(false))
          .says(view::Live::By(fn() {
            let p = model.passive()
            Some(view::said(view::Role::Status, label=p.toast_title, description=toast_kind_name(p.toast_kind)))
          }))
          let _ = rim.box(fn(pill : view::View) -> Unit {
            let _ = pill
            // The glyph lines up with the title (first line); one line gives a 40pt pill.
            .radius(view::Live::Is(SP_20))
            .ground(view::Live::By(fn() { lg::surface().card }))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Start)))
            .gap(view::Live::Is(SP_8))
            .padding(view::Live::By(fn() {
              if model.passive().toast_action != "" { (SP_12, SP_4, SP_4, SP_4) } else { (SP_12, SP_10, SP_16, SP_10) }
            }))
            .points(view::Live::By(fn() { model.passive().toast_action != "" }))
            pill.reacts(fn() { pill.pointed() || pill.pointed_in() }, fn(on : Bool) -> Unit { emit(ShellIntent::ToastHover(on)) }, at_start=false)
            let _ = pill.box(fn(ic_host : view::View) -> Unit {
              let _ = ic_host.width(view::Live::Is(Some(SP_20))).height(view::Live::Is(Some(SP_20))).rigid().center().points(view::Live::Is(false))
              let _ = shell_icon_by(
                ic_host,
                fn() { toast_kind_icon(model.passive().toast_kind) },
                size=IC_MD,
                color_by=fn() { toast_kind_color(model.passive().toast_kind) },
              )
            })
            let _ = pill.box(fn(col : view::View) -> Unit {
              let _ = col
              .gap(view::Live::Is(SP_2))
              .points(view::Live::Is(false))
              .padding(view::Live::By(fn() {
                if model.passive().toast_action != "" { (SP_0, SP_6, SP_0, SP_6) } else { (SP_0, SP_0, SP_0, SP_0) }
              }))
              let _ = <ui::Text
                in={col}
                size={TX_BODY}
                weight={500}
                color_by=>{lg::surface().ink}
                text_by=>{model.passive().toast_title}
              />
              col.show(fn() { model.passive().toast_subtitle != "" }, fn(sub : view::View) -> Unit {
                let _ = <ui::Text
                  in={sub}
                  size={TX_FOOTNOTE}
                  color_by=>{lg::surface().ink_secondary}
                  text_by=>{model.passive().toast_subtitle}
                />
              })
            })
            // The action: a text button at the trailing end (32pt tall, its own wash and press).
            pill.show(fn() { model.passive().toast_action != "" }, fn(act : view::View) -> Unit {
              let _ = act.rigid()
              let _ = headless::button(act, fn() { model.passive().toast_action }, fn(_e) -> Unit { emit(ShellIntent::ToastAction) }, fn(
                b : view::View,
                btn : headless::Button,
              ) -> Unit {
                let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
                let _ = b
                .height(view::Live::Is(Some(SP_32)))
                .min_width(view::Live::Is(Some(SP_48)))
                .padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
                .radius(view::Live::Is(SP_16))
                .center()
                .ground(view::Live::By(fn() { lg::over(lg::surface().card_secondary, lg::alpha(lg::surface().row_hover, hover_t())) }))
                shell_press(b, fn() { btn.pressed() })
                let _ = <ui::Text in={b} size={TX_BODY} weight={500} color_by=>{lg::surface().ink} text_by=>{model.passive().toast_action} />
              })
            })
          })
        },
        radius=SP_24,
        solid=fn() { lg::surface().card },
      )
    })
  })
}

struct FocusObserveProbe {
  mut node_visits : Int
  mut callbacks : Int
}

fn FocusObserveProbe::new() -> FocusObserveProbe {
  FocusObserveProbe::{ node_visits: 0, callbacks: 0 }
}

fn FocusObserveProbe::reset(self : FocusObserveProbe) -> Unit {
  self.node_visits = 0
  self.callbacks = 0
}

fn subtree_has_focus(
  v : view::View,
  probe : Option[FocusObserveProbe],
  exclude~ : Option[view::NodeId] = None,
) -> Bool {
  match probe {
    Some(p) => p.node_visits = p.node_visits + 1
    None => ()
  }
  if !v.alive() {
    return false
  }
  let excluded = match exclude {
    Some(ex) => v.id() == ex
    None => false
  }
  if !excluded && v.focused() {
    return true
  }
  let kids = v.kids()
  let mut i = 0
  while i < kids.length() {
    if subtree_has_focus(kids[i], probe, exclude=exclude) {
      return true
    }
    i += 1
  }
  false
}

fn subtree_has_focus_opt(
  v_opt : Option[view::View],
  probe : Option[FocusObserveProbe],
  exclude~ : Option[view::NodeId] = None,
) -> Bool {
  match v_opt {
    Some(v) => subtree_has_focus(v, probe, exclude=exclude)
    None => false
  }
}

fn omnibox_owns_focus(
  omni_wrap : Option[view::View],
  omni_panel : Option[view::View],
  probe : Option[FocusObserveProbe],
  exclude~ : Option[view::NodeId] = None,
) -> Bool {
  subtree_has_focus_opt(omni_wrap, probe, exclude=exclude) ||
  subtree_has_focus_opt(omni_panel, probe, exclude=exclude)
}

fn subtree_is_pressed(v : view::View, probe : Option[FocusObserveProbe]) -> Bool {
  match probe {
    Some(p) => p.node_visits = p.node_visits + 1
    None => ()
  }
  if !v.alive() {
    return false
  }
  if v.pressed() {
    return true
  }
  let kids = v.kids()
  let mut i = 0
  while i < kids.length() {
    if subtree_is_pressed(kids[i], probe) {
      return true
    }
    i += 1
  }
  false
}

fn subtree_is_pressed_opt(v_opt : Option[view::View], probe : Option[FocusObserveProbe]) -> Bool {
  match v_opt {
    Some(v) => subtree_is_pressed(v, probe)
    None => false
  }
}

///| Builds the complete Farview Desktop Shell 2.0 `ShellFrame`.
///| Mounts `pane_slot` for `PaneId::Primary` (always alive, mount delta == 0) and
///| `PaneId::Secondary` (shared across Split and Peek with 0 remounts).
pub fn build_shell_frame(
  root : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  pane_slot : PaneSlot,
  render_passive_overlays~ : Bool = true,
  on_focus_pane~ : Option[(PaneId) -> Unit] = None,
  hooks~ : Option[ShellHostHooks] = None,
) -> Unit {
  build_shell_frame_with_probe(
    root,
    model,
    emit,
    pane_slot,
    probe=None,
    render_passive_overlays=render_passive_overlays,
    on_focus_pane=on_focus_pane,
    hooks=hooks,
  )
}

///| One row of a grouped settings list: glyph tile, label, trailing control.
fn settings_row(
  parent : view::View,
  icon_name : String,
  tile_color : Int64,
  label : String,
  trailing : (view::View) -> Unit,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let _ = row
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(SP_40)))
    .padding(view::Live::Is((SP_12, SP_6, SP_12, SP_6)))
    .gap(view::Live::Is(SP_12))
    let _ = shell_glyph_tile(row, icon_name, fn() { tile_color }, size=SP_24)
    let _ = row.box(fn(tw : view::View) -> Unit {
      let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
      <ui::Text in={tw} size={TX_BODY} color_by=>{lg::surface().ink} text={label} />
    })
    trailing(row)
  })
}

///| Hairline between rows of a grouped list, starting where the row labels start.
fn settings_rule(parent : view::View) -> Unit {
  let _ = parent.box(fn(rule : view::View) -> Unit {
    let _ = rule
    .height(view::Live::Is(Some(lg::hairline_w)))
    .margin(view::Live::Is((SP_12 + SP_24 + SP_12, SP_0, SP_0, SP_0)))
    .ground(view::Live::By(fn() { lg::surface().separator }))
  })
}

///| A grouped list section: a quiet caption, a solid card, an optional footnote.
fn settings_group(
  parent : view::View,
  caption : String,
  footnote : String,
  rows : (view::View) -> Unit,
) -> Unit {
  <ui::Col in={parent} gap={SP_6}>
    <ui::Box pad_x={SP_12} rigid>
      <ui::Text size={TX_FOOTNOTE} weight={500} color_by=>{lg::surface().ink_secondary} text={caption} />
    </ui::Box>
    <lg::SurfaceCard radius={SP_12} pad={SP_0}>
      <ui::Col ref_view={rows} />
    </lg::SurfaceCard>
    <ui::Show when=>{footnote != ""}>
      <ui::Box pad_x={SP_12} rigid>
        <ui::Text size={TX_FOOTNOTE} wrap color_by=>{lg::surface().ink_secondary} text={footnote} />
      </ui::Box>
    </ui::Show>
  </ui::Col>
}

fn build_shell_frame_with_probe(
  root : view::View,
  model : ShellModel,
  emit : (ShellIntent) -> Unit,
  pane_slot : PaneSlot,
  probe~ : Option[FocusObserveProbe] = None,
  render_passive_overlays~ : Bool = true,
  on_focus_pane~ : Option[(PaneId) -> Unit] = None,
  hooks~ : Option[ShellHostHooks] = None,
) -> Unit {
  // A Space set to light or dark forces that appearance while it is active.
  let model = shell_model_with_space_mode(model)
  let window_w = fn() -> Double {
    let w = root.window_w()
    if w > 0.0 { w } else { 1280.0 }
  }
  let is_narrow = fn() -> Bool { window_w() < SHELL_SIDEBAR_BREAKPOINT }
  // Sidebar modes (Create a Space, Library): a mode shows the sidebar even where it was hidden.
  let modes = sm_hooks_modes(hooks)
  let in_mode = fn() -> Bool { !(sm_mode_of(modes) is SidebarMode::Tabs) }
  let creating = fn() -> Bool { sm_mode_of(modes) is SidebarMode::CreateSpace }
  // The tab lists' scroll (docked, drawer): kept by the frame, so a mode that lets go of the tabs brings them back
  // where they were.
  let docked_tabs_scroll = view::Scroll::new()
  let drawer_tabs_scroll = view::Scroll::new()
  let docked_sidebar_visible = fn() -> Bool {
    (model.dock().sidebar_open || in_mode()) && !is_narrow()
  }
  let docked_sidebar_w = fn() -> Double {
    let d = model.dock()
    // (a mode keeps the sidebar's own width: the page column never reflows as a mode opens or closes)
    shell_sidebar_width(window_w(), d.sidebar_open || in_mode(), custom_w=d.sidebar_width)
  }
  // A docked sidebar narrower than its wide width: trailing controls give way to the host and the title.
  let dock_tight = fn() -> Bool { docked_sidebar_visible() && docked_sidebar_w() < SHELL_SIDEBAR_W_WIDE }
  let right_col_w = fn() -> Double {
    let rw = window_w() - docked_sidebar_w()
    if rw > SP_128 { rw } else { SP_128 }
  }

  // True once the frame is built: what opens after this was opened by the person and may move in; what is
  // already open while the frame is built is there at once.
  let frame_built : signals::Ref[Bool] = ui::ref_new(false)

  // Sync `lg` dark mode with model
  lg::set_dark(Some(signals::untracked(model.dark)))
  root.reacts(model.dark, fn(d : Bool) -> Unit { lg::set_dark(Some(d)) }, at_start=false)

  // Global Escape routing: Exclusive first (restoring Omnibox URL on OmniboxSuggest),
  // then topmost interactive Passive. Passes through during active IME composition
  // and lets `headless::dialog` handle Escape for modal Dialog so `return_focus` runs cleanly.
  let is_shell_dialog_open = fn() -> Bool {
    let ex = model.exclusive()
    (ex.active is ExclusiveKind::Dialog) && ex.matches_tag("shell_dialog")
  }
  let _ = root.on_key(fn(k : view::Key) -> Bool {
    if k.code == ui::key_escape && k.mods == 0 {
      let ex = model.exclusive()
      if (ex.active is ExclusiveKind::CommandBar && ex.tag == "command_bar") ||
      (ex.active is ExclusiveKind::TabSearch && ex.tag == "tab_search") {
        // Let headless::dialog modal overlay handle Escape (including IME compose("") cancel)
        return false
      }
      if model.omnibox_field.composing() {
        model.omnibox_field.compose("")
        return true
      }
      match ui::focused_field_now() {
        Some(f) if f.composing() => {
          f.compose("")
          return true
        }
        _ => ()
      }
      if is_shell_dialog_open() {
        return false
      }
      // A sidebar mode: the theme editor first, then back to the tabs (an open overlay goes before it).
      match modes {
        Some(p) if p.escape_in_frame && !ex.is_open() && p.state.escape() => return true
        _ => ()
      }
      let passive_open = render_passive_overlays && (model.passive().capture_sheet_open || model.passive().perf_hud_open || model.passive().toast_visible)
      if ex.is_open() || passive_open {
        emit(ShellIntent::EscapePressed)
        return true
      }
    }
    false
  })

  // The window frame: the active Space's colors. Switching Space (a Space dot, or its shortcut) or the appearance
  // recolors them over MO_KEY_MS on `shell_ease`; starting or leaving Create a Space (its theme previewed on the
  // frame) over MO_DIALOG_MS on the strong ease-out; a live edit in the theme editor at once. Always from whatever
  // the frame shows now; the content swaps at once. As built: at once.
  let frame_stops = shell_frame_stops_shown(root, model, fn() { frame_built.v })
  let _ = root.ground(view::Live::By(fn() { frame_stops()[0] })).fill()
  build_space_theme_ground(root, model, stops_by=frame_stops)

  let canvas_pad_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let omni_wrap_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let omni_panel_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let dialog_trigger_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let primary_pane_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let secondary_pane_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)

  let focus_active_pane = fn() -> Unit {
    let active = signals::untracked(model.page).active_pane
    match on_focus_pane {
      Some(cb) => cb(active)
      None => {
        let target = match active {
          PaneId::Primary => primary_pane_ref.v
          PaneId::Secondary => secondary_pane_ref.v
        }
        match target {
          Some(pv) => {
            let _ = pv.ask_focus()
          }
          None => ()
        }
      }
    }
  }

  let nav_hist_cb = match hooks {
    Some(h) => h.on_nav_history
    None => None
  }
  let toggle_sidebar = fn() {
    // In the Library the sidebar cannot hide (the mode shows it): the toggle leaves the mode instead, so it never
    // flips a hidden state that would surprise on the way back.
    match modes {
      Some(p) if signals::untracked(in_mode) => {
        p.state.back()
        return
      }
      _ => ()
    }
    if is_narrow() {
      emit(ShellIntent::ToggleNarrowSidebar)
    } else {
      emit(ShellIntent::ToggleSidebar)
    }
  }
  let sidebar_btn = fn(parent : view::View) -> Unit {
    let _ = shell_frame_icon_btn(
      parent,
      model,
      "Toggle Sidebar",
      ICON_SIDEBAR,
      toggle_sidebar,
      active=fn() { is_narrow() && (model.exclusive().active is ExclusiveKind::SidebarDrawer) },
      disabled=creating,
    )
  }
  let back_btn = fn(parent : view::View) -> Unit {
    let _ = shell_frame_icon_btn(
      parent,
      model,
      "Back",
      ICON_BACK,
      fn() { emit(ShellIntent::GoBack) },
      disabled=fn() { !model.can_back() || creating() },
      on_menu=match nav_hist_cb {
        Some(cb) => Some(fn(ax : Double) -> Unit { cb(0, ax) })
        None => None
      },
    )
  }
  let forward_reload = fn(parent : view::View) -> Unit {
    let _ = shell_frame_icon_btn(
      parent,
      model,
      "Forward",
      ICON_FORWARD,
      fn() { emit(ShellIntent::GoForward) },
      disabled=fn() { !model.can_forward() || creating() },
      on_menu=match nav_hist_cb {
        Some(cb) => Some(fn(ax : Double) -> Unit { cb(1, ax) })
        None => None
      },
    )
    // Reload turns into Stop while the page loads (same target, glyph swapped in place).
    let _ = shell_frame_icon_btn(
      parent,
      model,
      "Reload",
      ICON_RELOAD,
      fn() { emit(if signals::untracked(model.loading) { ShellIntent::StopLoading } else { ShellIntent::Reload }) },
      disabled=creating,
      label_by=fn() { if model.loading() { "Stop Loading" } else { "Reload" } },
      icon_by=fn() { if model.loading() { ICON_CLOSE } else { ICON_RELOAD } },
    )
  }

  // The More menu (always `BelowEnd`, mounted at `root` so it is never clipped by the sidebar or the page).
  let more_menu = fn(parent : view::View) -> Unit {
    let _ = shell_menu_node(
      parent,
      root,
      fn() {
        let ex = model.exclusive()
        (ex.active is ExclusiveKind::Menu) && ex.matches_tag("shell_menu")
      },
      fn(open : Bool) -> Unit {
        if open {
          emit(ShellIntent::OpenMoreMenu)
        } else {
          let ex = signals::untracked(model.exclusive)
          if (ex.active is ExclusiveKind::Menu) && ex.matches_tag("shell_menu") {
            emit(ShellIntent::CloseMoreMenu)
          }
        }
      },
      fn() { "More Actions" },
      fn(trig : view::View, disc : headless::Disclosure) -> Unit {
        dialog_trigger_ref.v = Some(trig)
        let hover_t = shell_fade(trig, fn() { disc.open() || disc.hovered() })
        let _ = trig.width(view::Live::Is(Some(SP_32))).height(view::Live::Is(Some(SP_32))).rigid().center()
        let _ = trig.box(fn(face : view::View) -> Unit {
          let _ = face
          .width(view::Live::Is(Some(SP_24)))
          .height(view::Live::Is(Some(SP_24)))
          .radius(view::Live::Is(SP_6))
          .points(view::Live::Is(false))
          .center()
          .ground(view::Live::By(fn() { lg::alpha(shell_wash_hover(model.dark()), hover_t()) }))
          let _ = shell_icon(face, ICON_MORE, size=IC_MD, color_by=fn() { shell_frame_ink_secondary(model.dark()) })
        })
      },
      fn() -> Array[lg::LiquidMenuEntry] {
        let split_on = model.page().layout is PageLayout::Split
        let base : Array[lg::LiquidMenuEntry] = [
          lg::LiquidMenuEntry::item(
            label="New Tab",
            shortcut="⌘T",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_PLUS, size=IC_MD, color_by=ink) },
            on_select=fn() { emit(ShellIntent::NewTab) },
          ),
          lg::LiquidMenuEntry::item(
            label="Reload Page",
            shortcut="⌘R",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_RELOAD, size=IC_MD, color_by=ink) },
            on_select=fn() { emit(ShellIntent::Reload) },
          ),
          lg::LiquidMenuEntry::item(
            label="Forward",
            shortcut="⌘]",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_FORWARD, size=IC_MD, color_by=ink) },
            on_select=fn() { emit(ShellIntent::GoForward) },
          ),
          lg::LiquidMenuEntry::separator(),
          lg::LiquidMenuEntry::item(
            label=if split_on { "Close Split View" } else { "Split View" },
            shortcut="⇧⌘\\",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_SPLIT, size=IC_MD, color_by=ink) },
            on_select=fn() { emit(ShellIntent::ToggleSplitView) },
          ),
        ]
        if split_on {
          base.push(
            lg::LiquidMenuEntry::item(
              label="Swap Panes",
              icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_UNDO, size=IC_MD, color_by=ink) },
              on_select=fn() { emit(ShellIntent::SwapSplitPanes) },
            ),
          )
          base.push(
            lg::LiquidMenuEntry::item(
              label="Keep Focused Pane Only",
              icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_EXTERNAL, size=IC_MD, color_by=ink) },
              on_select=fn() { emit(ShellIntent::SoloActivePane) },
            ),
          )
        }
        base.push(
          lg::LiquidMenuEntry::item(
            label=if model.page().active_surface() is PaneSurface::Reader { "Exit Reader" } else { "Reader" },
            shortcut="⌥⌘R",
            icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_READER, size=IC_MD, color_by=ink) },
            on_select=fn() { emit(ShellIntent::ToggleActiveReaderMode) },
          ),
        )
        if dock_tight() {
          base.push(
            lg::LiquidMenuEntry::item(
              label="Page Controls",
              icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_DRAWER, size=IC_MD, color_by=ink) },
              on_select=fn() { emit(ShellIntent::ToggleDrawer) },
            ),
          )
        }
        base.push(lg::LiquidMenuEntry::separator())
        let hide_demo_pdf = match hooks {
          Some(h) => h.hide_demo_export_pdf
          None => false
        }
        if !hide_demo_pdf {
          base.push(
            lg::LiquidMenuEntry::item(
              label="Export PDF…",
              shortcut="⌘P",
              icon=fn(ic, ink) { let _ = shell_icon(ic, ICON_DOWNLOAD, size=IC_MD, color_by=ink) },
              on_select=fn() { emit(ShellIntent::OpenDialog) },
            ),
          )
        }
        base.push(
          lg::LiquidMenuEntry::check(
            label="Dark Appearance",
            checked=model.dark,
            on_toggle=fn() { emit(ShellIntent::ToggleDarkTheme) },
          ),
        )
        match hooks {
          Some(h) => match h.extra_more_items {
            Some(cb) => {
              let extras = cb()
              if extras.length() > 0 {
                base.push(lg::LiquidMenuEntry::separator())
                let mut ei = 0
                while ei < extras.length() {
                  base.push(extras[ei])
                  ei += 1
                }
              }
            }
            None => ()
          }
          None => ()
        }
        base
      },
      menu_label=fn() { "Browser Menu" },
    )
  }

  // Address field trailing tools: Page Controls and More.
  //   In a docked sidebar narrower than 240pt the host keeps the room: Page Controls moves into the More menu.
  let address_tools = fn(cap : view::View) -> Unit {
    cap.show(fn() { !dock_tight() }, fn(pc : view::View) -> Unit {
      let _ = pc.rigid()
      capsule_icon_btn(
        pc,
        model,
        "Page Controls",
        ICON_DRAWER,
        fn() { emit(ShellIntent::ToggleDrawer) },
        active=fn() {
          let ex = model.exclusive()
          (ex.active is ExclusiveKind::Drawer) && ex.matches_tag("shell_drawer")
        },
      )
    })
    more_menu(cap)
  }

  // [Docked Sidebar (y = 0..H, on the frame)] | [Page column: optional toolbar / page card + overlays]
  let _ = root.box(fn(outer_row : view::View) -> Unit {
    let _ = outer_row.fill().row(view::Live::Is(true))

    // 1. Docked sidebar: no box of its own, straight on the frame.
    outer_row.show(docked_sidebar_visible, fn(sb : view::View) -> Unit {
      let _ = sb
      .width(view::Live::By(fn() { Some(docked_sidebar_w()) }))
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((SP_8, SP_0, SP_0, SP_8)))
      .gap(view::Live::Is(SP_8))
      .min_height(view::Live::Is(Some(0.0)))
      .says(view::Live::Is(Some(view::said(view::Role::Navigation, label="Sidebar"))))
      // Top row (stays in every mode), then the tabs or the mode's content under it.
      let nav_row = fn(p : view::View) -> Unit {
        let _ = p.box(fn(top : view::View) -> Unit {
          let _ = top
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(SHELL_TOP_ROW_H)))
          .shrink(view::Live::Is(0.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .padding(view::Live::By(fn() {
            let inset = shell_traffic_light_inset(model)
            ((if inset > 0.0 { inset - SP_8 } else { SP_0 }), SP_0, SP_0, SP_0)
          }))
          .moves_window(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Toolbar, label="Browser Toolbar"))))
          sidebar_btn(top)
          let _ = top.box(fn(spacer : view::View) -> Unit {
            let _ = spacer.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
          })
          back_btn(top)
          forward_reload(top)
        })
      }
      nav_row(sb)
      build_sidebar_mode_host(sb, model, modes, fn() { frame_built.v }, false, fn(tabs : view::View) -> Unit {
        build_sidebar_contents(
          tabs,
          model,
          emit,
          true,
          hooks,
          tabs_scroll=Some(docked_tabs_scroll),
          edge=SP_8,
          address=Some(fn(p : view::View) -> Unit {
            let _ = p.box(fn(row : view::View) -> Unit {
              let _ = row.row(view::Live::Is(true)).rigid().height(view::Live::Is(Some(SHELL_ADDRESS_H)))
              build_address_capsule(row, model, emit, hooks, address_tools)
            })
          }),
        )
      })
    })

    // 1b. The sidebar's trailing edge is a resize handle (Arc): the 8pt gap before the page card, below the
    //     top row, ResizeX; a 2pt hairline shows on hover (accent while dragging). The width follows the pointer
    //     directly (no easing), clamped as `shell_sidebar_width` clamps it; letting go keeps it; a double click goes
    //     back to the default width; arrow keys move it by 8pt.
    outer_row.show(fn() { docked_sidebar_visible() && !in_mode() }, fn(edge_wrap : view::View) -> Unit {
      let _ = edge_wrap
      .over(view::Live::Is(true), edges=(Some(SP_0), Some(SHELL_TOP_ROW_H), None, Some(SP_0)))
      .width(view::Live::Is(Some(SP_8)))
      .margin(view::Live::By(fn() { (docked_sidebar_w(), SP_0, SP_0, SP_0) }))
      // (the handle's range is the stored one; the window's own bound is applied as it is now, so it follows a
      // window resize and a saved width never outruns the handle)
      let _ = headless::split(
        edge_wrap,
        fn() { "Resize Sidebar" },
        docked_sidebar_w,
        min=proto::SETTINGS_SIDEBAR_W_MIN,
        max=proto::SETTINGS_SIDEBAR_W_MAX,
        step=SP_8,
        fn(w : Double) -> Unit {
          let cap = shell_sidebar_max_width(signals::untracked(window_w))
          emit(ShellIntent::SetSidebarWidth(if w > cap { cap } else { w }, false))
        },
        fn(handle : view::View, sp : headless::Split) -> Unit {
          let hover_t = shell_fade(handle, fn() { sp.hovered() || sp.dragging() })
          let _ = handle.fill().center().cursor(view::Live::Is(Some(view::Cursor::ResizeX)))
          handle.reacts(fn() { sp.dragging() }, fn(on : Bool) -> Unit {
            if !on {
              emit(ShellIntent::SetSidebarWidth(signals::untracked(docked_sidebar_w), true))
            }
          }, at_start=false)
          let _ = handle.box(fn(line : view::View) -> Unit {
            let _ = line
            .width(view::Live::Is(Some(SP_2)))
            .height(view::Live::Is(Some(SP_40)))
            .radius(view::Live::Is(SP_2))
            .points(view::Live::Is(false))
            .alpha(view::Live::By(hover_t))
            .ground(view::Live::By(fn() {
              if sp.dragging() { lg::surface().accent } else { shell_frame_ink_tertiary(model.dark()) }
            }))
          })
        },
        reset=fn() -> Unit { emit(ShellIntent::SetSidebarWidth(0.0, true)) },
      )
    })

    // 2. Page column
    let _ = outer_row.box(fn(frame : view::View) -> Unit {
      let _ = frame.fill()

      // 2a. Compact toolbar: only while the sidebar is not docked.
      frame.show(fn() { !docked_sidebar_visible() }, fn(bar : view::View) -> Unit {
        let _ = bar
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(SHELL_TITLEBAND_H)))
        .shrink(view::Live::Is(0.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(SP_4))
        .padding(view::Live::By(fn() {
          let inset = shell_traffic_light_inset(model)
          ((if inset > 0.0 { inset } else { SP_8 }), SP_0, SP_8, SP_0)
        }))
        .moves_window(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Toolbar, label="Browser Toolbar"))))
        sidebar_btn(bar)
        back_btn(bar)
        bar.show(fn() { shell_toolbar_shows_forward(window_w()) }, fn(extra : view::View) -> Unit {
          let _ = extra.row(view::Live::Is(true)).gap(view::Live::Is(SP_0)).lines_up(view::Live::Is(Some(view::Along::Middle))).rigid()
          forward_reload(extra)
        })
        let _ = bar.box(fn(cap_row : view::View) -> Unit {
          let _ = cap_row
          .fill()
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .padding(view::Live::Is((SP_4, SP_0, SP_0, SP_0)))
          let _ = cap_row.box(fn(cap_max : view::View) -> Unit {
            let _ = cap_max.fill().max_width(view::Live::Is(Some(SHELL_PALETTE_W))).row(view::Live::Is(true))
            build_address_capsule(cap_max, model, emit, hooks, address_tools)
          })
        })
      })

      // 2b. Body: top strip + page card(s) + every overlay that belongs to the page column.
      let _ = frame.box(fn(body : view::View) -> Unit {
        let _ = body
        .fill()
        .padding(view::Live::By(fn() { (SP_8, if docked_sidebar_visible() { SP_8 } else { SP_0 }, SP_8, SP_8) }))
        .gap(view::Live::Is(SP_8))

        // Optional Top Strip slot (Agent Takeover Bar + Bookmarks Bar + loading progress)
        match hooks {
          Some(h) => match h.top_strip {
            Some(cb) => cb(body)
            None => ()
          }
          None => ()
        }

        let _ = body.box(fn(body_content : view::View) -> Unit {
          let _ = body_content.fill()

          let _ = body_content.box(fn(canvas_pad : view::View) -> Unit {
            canvas_pad_ref.v = Some(canvas_pad)
            let _ = canvas_pad.fill()

            let _ = canvas_pad.box(fn(stage_host : view::View) -> Unit {
              let _ = stage_host.fill()

              let avail_w = fn() -> Double {
                let _ = stage_host.laid_size_told()
                let (_, _, sw, _) = stage_host.placed_window_now()
                if sw > SP_64 {
                  sw
                } else {
                  let w = right_col_w() - SHELL_CANVAS_GAP * 2.0
                  if w > SP_64 { w } else { SP_64 }
                }
              }
              let avail_h = fn() -> Double {
                let _ = stage_host.laid_size_told()
                let (_, _, _, sh) = stage_host.placed_window_now()
                if sh > SP_64 {
                  sh
                } else {
                  let wh = root.window_h()
                  let top = if docked_sidebar_visible() { SHELL_CANVAS_GAP } else { SHELL_TITLEBAND_H }
                  let h = (if wh > 0.0 { wh } else { 800.0 }) - top - SHELL_CANVAS_GAP
                  if h > SP_64 { h } else { SP_64 }
                }
              }
              let card_look = fn(card : view::View) -> Unit {
                let _ = card
                .radius(view::Live::By(shell_canvas_radius))
                .clips(view::Live::Is(true))
                .ground(view::Live::By(fn() { lg::surface().card }))
                .edge(view::Live::By(fn() {
                  (lg::hairline_w, if model.dark() { 0xFFFFFF14L } else { 0x0000000FL })
                }))
                .shadow(view::Live::By(fn() { shell_card_shadow(model.dark()) }))
                .shadow_outside(view::Live::Is(true))
              }

              // Primary Pane: ALWAYS mounted in this single stable node (live == 1, mount delta == 0!)
              let _ = stage_host.box(fn(primary_box : view::View) -> Unit {
                primary_pane_ref.v = Some(primary_box)
                let _ = primary_box
                .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
                .margin(view::Live::By(fn() {
                  let p = model.page()
                  if (p.layout is PageLayout::Split) && p.panes_swapped {
                    let (lw, _) = proto::split_pane_widths(avail_w(), p.split_ratio)
                    (lw + proto::SPLIT_DIVIDER_WIDTH, 0.0, 0.0, 0.0)
                  } else {
                    (0.0, 0.0, 0.0, 0.0)
                  }
                }))
                .width(view::Live::By(fn() {
                  let p = model.page()
                  let w = avail_w()
                  if p.layout is PageLayout::Split {
                    let (lw, rw) = proto::split_pane_widths(w, p.split_ratio)
                    Some(if p.panes_swapped { rw } else { lw })
                  } else {
                    Some(w)
                  }
                }))
                .focusable(view::Live::Is(true), keys=0, tab=false)
                .says(view::Live::Is(Some(view::said(view::Role::Region, label="Primary Pane"))))
                card_look(primary_box)
                (pane_slot.mount)(primary_box, PaneId::Primary)
                // Focused split-pane ring painted ABOVE content (`points=false`) so opaque pages never cover it.
                primary_box.show(
                  fn() { (model.page().layout is PageLayout::Split) && (model.page().active_pane is PaneId::Primary) },
                  fn(ring : view::View) -> Unit {
                    let _ = ring
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .radius(view::Live::By(shell_canvas_radius))
                    .edge(view::Live::By(fn() { (SP_2, lg::alpha(lg::surface().accent, 0.85)) }))
                  },
                )
              })

              // Split Divider (`headless::split`): a gap between two cards with a grabber that shows on hover.
              stage_host.show(fn() { model.page().layout is PageLayout::Split }, fn(div_wrap : view::View) -> Unit {
                let _ = div_wrap
                .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
                .margin(view::Live::By(fn() {
                  let (lw, _) = proto::split_pane_widths(avail_w(), model.page().split_ratio)
                  (lw, 0.0, 0.0, 0.0)
                }))
                .width(view::Live::Is(Some(proto::SPLIT_DIVIDER_WIDTH)))
                let _ = headless::split(
                  div_wrap,
                  fn() { "Resize Split View" },
                  fn() { model.page().split_ratio },
                  min=proto::SPLIT_RATIO_MIN,
                  max=proto::SPLIT_RATIO_MAX,
                  step=0.05,
                  fn(r : Double) -> Unit { emit(ShellIntent::SetSplitRatio(r)) },
                  fn(handle : view::View, sp : headless::Split) -> Unit {
                    let hover_t = shell_fade(handle, fn() { sp.hovered() || sp.dragging() })
                    let _ = handle.fill().center()
                    let _ = handle.box(fn(pill : view::View) -> Unit {
                      let _ = pill
                      .width(view::Live::Is(Some(SP_4)))
                      .height(view::Live::Is(Some(SP_40)))
                      .radius(view::Live::Is(SP_2))
                      .ground(view::Live::By(fn() {
                        if sp.dragging() {
                          lg::surface().accent
                        } else {
                          lg::alpha(shell_frame_ink_tertiary(model.dark()), 0.35 + 0.65 * hover_t())
                        }
                      }))
                    })
                  },
                  span=avail_w,
                  reset=fn() -> Unit { emit(ShellIntent::SetSplitRatio(proto::split_reset_ratio())) },
                )
              })

              // Peek coming in over the page: the card grows 0.97 -> 1 and its scrim fades in over MO_PEEK_MS, while
              // the card's own opacity is front-loaded over MO_PEEK_FADE_MS (an opaque card half-faded over the page
              // shows both pages' text on top of each other). Scale only: its margin and size never animate, so the
              // Stage is not laid out again. Only on a change into Peek after the frame is built; leaving Peek, and
              // Split <-> Peek, are instant.
              let is_peek = fn() -> Bool { model.page().layout is PageLayout::Peek }
              let peek = shell_reveal(
                stage_host,
                false,
                enter_ms=MO_PEEK_MS,
                exit_ms=0.0,
                from_scale=MO_PEEK_SCALE,
                fade_ms=MO_PEEK_FADE_MS,
              )
              stage_host.reacts(is_peek, fn(on : Bool) -> Unit {
                if on && frame_built.v { peek.replay() } else { peek.settle() }
              }, at_start=false)
              // Peek click-outside scrim inside `stage_host` (mounted BEFORE `sec_box` so clicks outside close Peek)
              stage_host.show(is_peek, fn(peek_scrim : view::View) -> Unit {
                let _ = peek_scrim
                .alpha(view::Live::By(fn() { peek.progress_on(peek_scrim) }))
                .over(view::Live::Is(true))
                .radius(view::Live::By(shell_canvas_radius))
                .ground(view::Live::Is(0x00000038L))
                .presses(view::Live::Is(true))
                .on_press(fn() -> Unit { emit(ShellIntent::CloseSecondaryPane) })
              })

              // Secondary Pane: mounted ONCE across `Split` and `Peek` (no `leave`, 0 remount on Peek <-> Split!)
              stage_host.show(fn() { model.page().has_secondary() }, fn(sec_box : view::View) -> Unit {
                secondary_pane_ref.v = Some(sec_box)
                // The new pane when Split View opens from one pane after the frame is built: it fades in over
                // MO_SPLIT_MS (opacity only; its width and margin are the client's layout and never animate).
                let split_in = shell_reveal(
                  sec_box,
                  frame_built.v && !signals::untracked(is_peek),
                  enter_ms=MO_SPLIT_MS,
                  exit_ms=0.0,
                )
                let _ = sec_box
                .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
                .margin(view::Live::By(fn() {
                  let p = model.page()
                  if p.layout is PageLayout::Peek {
                    (SP_48, SP_32, 0.0, 0.0)
                  } else if p.panes_swapped {
                    (0.0, 0.0, 0.0, 0.0)
                  } else {
                    let (lw, _) = proto::split_pane_widths(avail_w(), p.split_ratio)
                    (lw + proto::SPLIT_DIVIDER_WIDTH, 0.0, 0.0, 0.0)
                  }
                }))
                .width(view::Live::By(fn() {
                  let p = model.page()
                  let w = avail_w()
                  if p.layout is PageLayout::Peek {
                    let pw = w - SP_96
                    Some(if pw > SP_160 + SP_80 { pw } else { w - SP_16 })
                  } else {
                    let (lw, rw) = proto::split_pane_widths(w, p.split_ratio)
                    Some(if p.panes_swapped { lw } else { rw })
                  }
                }))
                .height(view::Live::By(fn() {
                  let p = model.page()
                  let h = avail_h()
                  if p.layout is PageLayout::Peek {
                    let ph = h - SP_64
                    Some(if ph > SP_160 + SP_40 { ph } else { h - SP_16 })
                  } else {
                    Some(h)
                  }
                }))
                .focusable(view::Live::Is(true), keys=0, tab=false)
                .says(view::Live::Is(Some(view::said(view::Role::Region, label="Secondary Pane"))))
                // (both reveals rest at 1 outside their own entrance, so the product is the one playing)
                .alpha(view::Live::By(fn() { peek.shown_on(sec_box) * split_in.shown_on(sec_box) }))
                .scale(view::Live::By(fn() { peek.scale_on(sec_box) }), about=view::Pivot::At(0.5, 0.5))
                card_look(sec_box)

                // Peek header (only in Peek; sibling above `sec_content` -> 0 Stage remount!)
                sec_box.show(fn() { model.page().layout is PageLayout::Peek }, fn(pbar : view::View) -> Unit {
                  let can_back_fn = match hooks {
                    Some(h) => match h.peek_can_back {
                      Some(cb) => cb
                      None => fn() { true }
                    }
                    None => fn() { true }
                  }
                  let can_fwd_fn = match hooks {
                    Some(h) => match h.peek_can_forward {
                      Some(cb) => cb
                      None => fn() { true }
                    }
                    None => fn() { true }
                  }
                  let _ = pbar
                  .row(view::Live::Is(true))
                  .height(view::Live::Is(Some(SHELL_PEEK_BAR_H)))
                  .shrink(view::Live::Is(0.0))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Between))
                  .padding(view::Live::Is((SP_8, SP_4, SP_8, SP_4)))
                  .gap(view::Live::Is(SP_8))
                  .ground(view::Live::By(fn() { lg::surface().card_secondary }))

                  let _ = pbar.box(fn(pleft : view::View) -> Unit {
                    let _ = pleft.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2)).rigid()
                    bar_icon_btn(pleft, "Peek Back", ICON_BACK, fn() { emit(ShellIntent::PeekGoBack) }, disabled=fn() { !can_back_fn() })
                    bar_icon_btn(pleft, "Peek Forward", ICON_FORWARD, fn() { emit(ShellIntent::PeekGoForward) }, disabled=fn() { !can_fwd_fn() })
                  })
                  let _ = pbar.box(fn(phost : view::View) -> Unit {
                    let _ = phost
                    .grow(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .gap(view::Live::Is(SP_8))
                    .cut()
                    let _ = shell_site_tile(phost, fn() { shell_url_parts(model.secondary_url()).0 }, size=SP_16)
                    let _ = <ui::Text
                      in={phost}
                      size={TX_BODY}
                      weight={500}
                      color_by=>{lg::surface().ink}
                      text_by=>{shell_pane_label(model.secondary_url(), model.secondary_title())}
                    />.allow_ellipsis(view::Live::Is(true))
                  })
                  let _ = pbar.box(fn(pright : view::View) -> Unit {
                    let _ = pright.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_2)).rigid()
                    bar_icon_btn(pright, "Copy Peek URL", ICON_COPY, fn() { emit(ShellIntent::PeekCopyUrl) })
                    bar_icon_btn(pright, "Open in Split View", ICON_SPLIT, fn() { emit(ShellIntent::PromotePeekToSplit) })
                    bar_icon_btn(pright, "Open in New Tab", ICON_EXTERNAL, fn() { emit(ShellIntent::PeekExpandToTab) })
                    bar_icon_btn(pright, "Close Peek", ICON_CLOSE, fn() { emit(ShellIntent::CloseSecondaryPane) })
                  })
                })

                // Stable flex-fill content host for Secondary Stage (0 remount on Split <-> Peek!)
                let _ = sec_box.box(fn(sec_content : view::View) -> Unit {
                  let _ = sec_content.fill()
                  (pane_slot.mount)(sec_content, PaneId::Secondary)
                })

                sec_box.show(
                  fn() { (model.page().layout is PageLayout::Split) && (model.page().active_pane is PaneId::Secondary) },
                  fn(ring : view::View) -> Unit {
                    let _ = ring
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .radius(view::Live::By(shell_canvas_radius))
                    .edge(view::Live::By(fn() { (SP_2, lg::alpha(lg::surface().accent, 0.85)) }))
                  },
                )
              })
            })
          })

          // Optional Bottom Dock slot (Docked DevTools Drawer spanning the page column; 0 Stage remount!)
          match hooks {
            Some(h) => match h.bottom_dock {
              Some(cb) => cb(body_content)
              None => ()
            }
            None => ()
          }

          // 2c. Overlays inside the page column.
          // Create a Space: the page column dimmed, frosted and blurred, taking every press.
          build_create_space_scrim(body_content, canvas_pad_ref.v, model, modes, fn() { frame_built.v })
          // Narrow (< 720pt) Leading Sidebar Drawer (no scrim): the same sidebar, floating.
          let sidebar_drawer_asked = fn() -> Bool {
            let ex = model.exclusive()
            ((ex.active is ExclusiveKind::SidebarDrawer) && ex.matches_tag("shell_sidebar_drawer")) ||
            ((ex.active is ExclusiveKind::Popover) && ex.tag == "folder_create")
          }
          // A sidebar mode opens the drawer too (closing it leaves the mode).
          build_narrow_sidebar_drawer(
            body_content,
            fn() { frame_built.v },
            fn() { sidebar_drawer_asked() || in_mode() },
            fn() { is_narrow() && (sidebar_drawer_asked() || in_mode()) },
            fn() {
              match modes {
                Some(p) if signals::untracked(in_mode) => {
                  p.state.back()
                  return
                }
                _ => ()
              }
              let ex = signals::untracked(model.exclusive)
              if ((ex.active is ExclusiveKind::SidebarDrawer) && ex.matches_tag("shell_sidebar_drawer")) ||
              ((ex.active is ExclusiveKind::Popover) && ex.tag == "folder_create") {
                emit(ShellIntent::CloseExclusive)
              }
            },
            fn() {
              match sm_mode_of(modes) {
                SidebarMode::Tabs => "Tabs"
                SidebarMode::CreateSpace => "Spaces"
                SidebarMode::Library => "Library"
              }
            },
            fn(drawer_body : view::View) -> Unit {
              let _ = drawer_body.fill().gap(view::Live::Is(SP_8))
              build_sidebar_mode_host(drawer_body, model, modes, fn() { frame_built.v }, true, fn(tabs : view::View) -> Unit {
                build_sidebar_contents(tabs, model, emit, false, hooks, tabs_scroll=Some(drawer_tabs_scroll))
              })
            },
            SP_160 + SP_96,
            wide_width=fn() { sm_mode_of(modes) is SidebarMode::Library },
          )

          // Trailing non-modal Page Controls drawer: grouped settings with glyph tiles.
          let _ = lg::liquid_drawer_node(
            body_content,
            fn() {
              let ex = model.exclusive()
              (ex.active is ExclusiveKind::Drawer) && ex.matches_tag("shell_drawer")
            },
            fn() {
              let ex = signals::untracked(model.exclusive)
              if (ex.active is ExclusiveKind::Drawer) && ex.matches_tag("shell_drawer") {
                emit(ShellIntent::CloseExclusive)
              }
            },
            fn() { "Page Controls" },
            fn(drawer_body : view::View) -> Unit {
              // The grouped list sits on one solid settings ground (white cards on it), so captions and footnotes
              // read on lg::surface() inks rather than over the glass. Cards SP_8 in: 12 + 8 = 20 (concentric).
              let _ = drawer_body
              .gap(view::Live::Is(SP_20))
              .padding(view::Live::Is((SP_8, SP_8, SP_8, SP_16)))
              .radius(view::Live::Is(SP_20))
              .ground(view::Live::By(fn() { lg::surface().grouped_bg }))
              // The page these controls act on, as the first card: its site tile, its title, its host below.
              // Same leading edge as the group cards; the title is body weight so only the panel title is bold.
              <lg::SurfaceCard in={drawer_body} radius={SP_12} pad={SP_0}>
                <ui::Row pad_x={SP_12} pad_y={SP_12} gap={SP_12} rigid ref_view={fn(site : view::View) -> Unit {
                  let _ = site.lines_up(view::Live::Is(Some(view::Along::Middle)))
                  let _ = shell_site_tile(site, fn() { shell_url_parts(model.active_url()).0 }, size=SP_32)
                  let _ = site.box(fn(col : view::View) -> Unit {
                    let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(SP_2))
                    let _ = col.box(fn(tw : view::View) -> Unit {
                      let _ = tw.min_width(view::Live::Is(Some(0.0))).cut()
                      let _ = <ui::Text
                        in={tw}
                        size={TX_BODY}
                        weight={500}
                        color_by=>{lg::surface().ink}
                        text_by=>{model.title()}
                      />.allow_ellipsis(view::Live::Is(true))
                    })
                    <ui::Text
                      in={col}
                      size={TX_FOOTNOTE}
                      lines={1}
                      color_by=>{lg::surface().ink_secondary}
                      text_by=>{shell_url_parts(model.active_url()).0}
                    />
                  })
                }} />
              </lg::SurfaceCard>
              settings_group(drawer_body, "Appearance", "", fn(g : view::View) -> Unit {
                settings_row(g, ICON_MOON, FRAME_TILE_APPEARANCE, "Dark Appearance", fn(tr : view::View) -> Unit {
                  <lg::Toggle
                    in={tr}
                    on_by=>{model.dark()}
                    on_change={fn(_v : Bool) -> Unit { emit(ShellIntent::ToggleDarkTheme) }}
                    label="Dark Appearance"
                  />
                })
              })
              settings_group(drawer_body, "Layout", "Reader applies to the focused pane.", fn(g : view::View) -> Unit {
                settings_row(g, ICON_SPLIT, FRAME_TILE_LAYOUT, "Split View", fn(tr : view::View) -> Unit {
                  <lg::Toggle
                    in={tr}
                    on_by=>{model.page().layout is PageLayout::Split}
                    on_change={fn(_v : Bool) -> Unit { emit(ShellIntent::ToggleSplitView) }}
                    label="Split View"
                  />
                })
                settings_rule(g)
                settings_row(g, ICON_READER, FRAME_TILE_READER, "Reader Mode", fn(tr : view::View) -> Unit {
                  <lg::Toggle
                    in={tr}
                    on_by=>{model.page().active_surface() is PaneSurface::Reader}
                    on_change={fn(_v : Bool) -> Unit { emit(ShellIntent::ToggleActiveReaderMode) }}
                    label="Reader Mode"
                  />
                })
              })
            },
            side=lg::DrawerSide::Trailing,
            width=SP_160 + SP_160,
            scrim=false,
            inset=SP_8,
          )

          // Optional host body overlays (History / Bookmarks / Closed Tabs drawers)
          match hooks {
            Some(h) => match h.body_overlays {
              Some(cb) => cb(body_content)
              None => ()
            }
            None => ()
          }

          // Single-renderer guard for Passive overlays (`render_passive_overlays=false` when host renders them)
          if render_passive_overlays {
            build_capture_sheet_overlay(body_content, model, emit, fn() { frame_built.v })
            let toast_parent = match canvas_pad_ref.v {
              Some(cp) => cp
              None => body_content
            }
            build_toast_overlay(toast_parent, model, fn() { frame_built.v }, emit)
          }
        })
      })
    })
  })

  // Command palette (Address Bar while editing), centered over the page column.
  build_omnibox_palette(
    root,
    model,
    emit,
    omni_wrap_ref,
    omni_panel_ref,
    fn() { docked_sidebar_w() },
    right_col_w,
    focus_active_pane,
    hooks,
  )

  // Create a Space: its theme editor (over everything), and the end of its frame preview once the Space arrives.
  build_create_space_theme_editor(root, model, modes)
  build_sidebar_mode_watch(root, model, modes)

  // Full-window Command Bar (`Cmd+K`, exact tag `"command_bar"`) & Tab Search (`Cmd+Shift+A`, exact tag `"tab_search"`)
  match hooks {
    Some(h) => {
      match h.command_bar {
        Some(cb_props) => build_command_bar_overlay(root, model, cb_props)
        None => ()
      }
      match h.tab_search {
        Some(ts_props) => build_tab_search_overlay(root, model, ts_props)
        None => ()
      }
    }
    None => ()
  }

  // Full-window Modal Dialog mounted at `root` level (covers the whole window — no L-shaped scrim cut).
  // Real `headless::dialog` provides initial focus, `Tab`/`Shift+Tab` trap, `Esc` close, and `return_focus` to `More Actions`.
  let close_dialog_and_return_focus = fn() -> Unit {
    let ex = signals::untracked(model.exclusive)
    if (ex.active is ExclusiveKind::Dialog) && ex.matches_tag("shell_dialog") {
      emit(ShellIntent::CloseDialog)
    }
  }
  root.show(is_shell_dialog_open, leave=MO_DIALOG_OUT_MS, fn(dlg_wrap : view::View) -> Unit {
    let close_dialog = shell_closes(dlg_wrap, close_dialog_and_return_focus)
    let reveal = shell_dialog_reveal(dlg_wrap, frame_built.v)
    reveal.fades(dlg_wrap)
    let _ = dlg_wrap.over(view::Live::Is(true))
    let _ = headless::dialog(
      dlg_wrap,
      fn() { "Export Page as PDF" },
      is_shell_dialog_open,
      close_dialog,
      fn(dlg_box : view::View, _d : headless::Dialog) -> Unit {
        let _ = dlg_box.over(view::Live::Is(true)).center()
        // Full-window pointer-blocking scrim INSIDE `dlg_box` (not a tab stop, so Tab stays strictly Cancel <-> Export).
        let _ = dlg_box.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::Is(0x00000038L))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { close_dialog() })
        })
        let _ = lg::liquid_dialog_shell_node(dlg_box, fn(shell : view::View) -> Unit {
          reveal.grows_only(shell)
          let _ = shell
          .width(view::Live::Is(Some(SP_160 + SP_160)))
          .padding(view::Live::Is((SP_20, SP_20, SP_20, SP_16)))
          .gap(view::Live::Is(SP_12))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { () })
          let _ = shell_glyph_tile(shell, ICON_DOWNLOAD, fn() { FRAME_TILE_DOWNLOADS }, size=SP_32)
          <ui::Col in={shell} gap={SP_4}>
            <ui::Text size={TX_CALLOUT} weight={600} color_by=>{lg::surface().ink} text="Export Page as PDF" />
            <ui::Text size={TX_BODY} wrap color_by=>{lg::surface().ink_secondary} text="Saves the page with selectable text and its own fonts." />
          </ui::Col>
          let _ = shell.box(fn(btn_row : view::View) -> Unit {
            let _ = btn_row.row(view::Live::Is(true)).gap(view::Live::Is(SP_8)).lies_along(view::Live::Is(view::Lies::End)).rigid().padding(view::Live::Is((SP_0, SP_4, SP_0, SP_0)))
            let cancel_v = lg::liquid_button_node(btn_row, fn() { "Cancel" }, close_dialog, flat=true)
            let _ = lg::liquid_button_node(btn_row, fn() { "Export" }, close_dialog, prominent=true)
            let _ = cancel_v.ask_focus()
          })
        })
      },
      modal=true,
      close_on_escape=true,
      close_on_outside=false,
      return_focus?=dialog_trigger_ref.v,
    )
  })
  // Registered AFTER `root.show(...)` so it runs right after the modal dialog unmounts and restores focus to trigger!
  root.reacts(at_start=false, is_shell_dialog_open, fn(is_open : Bool) -> Unit {
    if !is_open {
      match dialog_trigger_ref.v {
        Some(trig) => {
          let _ = trig.ask_focus()
        }
        None => ()
      }
    }
  })

  // Hover-free, O(1)-idle Omnibox focus-leave handling (registered AFTER `outer_row`; ZERO `root`/pane traversal!).
  // Only inspects the palette subtree while `omnibox_editing()` is true.
  let prev_omni_focused : signals::Ref[Bool] = ui::ref_new(false)

  // Path 1 (Keyboard Tab / programmatic focus out of the palette):
  root.reacts(
    fn() {
      if !model.omnibox_editing() {
        return false
      }
      match probe {
        Some(p) => p.callbacks = p.callbacks + 1
        None => ()
      }
      let any_focus = root.tree.focused is Some(_)
      if !any_focus {
        return false
      }
      !omnibox_owns_focus(omni_wrap_ref.v, omni_panel_ref.v, probe)
    },
    fn(left_omnibox : Bool) -> Unit {
      if left_omnibox && signals::untracked(model.omnibox_editing) {
        emit(ShellIntent::OmniboxBlur)
      }
    },
  )

  // Path 2 (Pointer or direct tree focus move releasing `omnibox_field`): when `omnibox_field.focused()`
  // drops true -> false, dispatch `OmniboxBlur` unless a control inside the palette is pressed or focused.
  //   A new pointer down on the palette's own surface (rim, captions, gaps: nothing focusable) gives the focus
  //   back to the field instead, so the palette stays open and the click never reaches the page under it.
  let seen_downs : signals::Ref[Int] = ui::ref_new(signals::untracked(fn() -> Int { root.window_downs() }))
  root.reacts(fn() { model.omnibox_field.focused() }, fn(now_focused : Bool) -> Unit {
    let was = prev_omni_focused.v
    prev_omni_focused.v = now_focused
    let downs = root.window_downs()
    let new_down = downs != seen_downs.v
    seen_downs.v = downs
    if was && !now_focused && signals::untracked(model.omnibox_editing) {
      match probe {
        Some(p) => p.callbacks = p.callbacks + 1
        None => ()
      }
      let active_inside = subtree_is_pressed_opt(omni_panel_ref.v, probe) ||
      subtree_is_pressed_opt(omni_wrap_ref.v, probe) ||
      omnibox_owns_focus(omni_wrap_ref.v, omni_panel_ref.v, probe, exclude=model.omnibox_field.tree_node)
      if active_inside {
        return
      }
      let on_panel = new_down && {
        let (dx, dy) = root.window_down_point()
        match omni_panel_ref.v {
          Some(pv) if pv.alive() => {
            let (px, py, pw, ph) = pv.placed_window_now()
            pw > 0.0 && ph > 0.0 && dx >= px && dx <= px + pw && dy >= py && dy <= py + ph
          }
          _ => false
        }
      }
      if on_panel {
        model.omnibox_field.focus()
      } else {
        emit(ShellIntent::OmniboxBlur)
      }
    }
  })
  frame_built.v = true
}

///| The sidebar's download row (see `ShellHostHooks.downloads_activity`).
pub fn build_sidebar_download_row(
  sb : view::View,
  model : ShellModel,
  act : () -> ShellDownloadActivity,
  open_dl : () -> Unit,
) -> Unit {
  let built = view::ref_new(false)
  sb.show(fn() { act().visible }, leave=MO_POP_OUT_MS, fn(wrap : view::View) -> Unit {
    let reveal = shell_popover_reveal(wrap, built.v)
    reveal.grows(wrap, ox=0.5, oy=1.0)
    let _ = wrap.rigid()
    let _ = headless::button(
      wrap,
      fn() {
        let a = act()
        if a.failed { "Download failed: " + a.name } else { "Downloads: " + a.name }
      },
      fn(_e) -> Unit { open_dl() },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let hover_t = shell_fade(b, fn() { btn.hovered() || btn.pressed() })
        let _ = b
        .radius(view::Live::Is(SP_12))
        .padding(view::Live::Is((SP_8, SP_8, SP_12, SP_8)))
        .gap(view::Live::Is(SP_6))
        .ground(view::Live::By(fn() {
          lg::over(shell_wash(model.dark()), lg::alpha(shell_wash_hover(model.dark()), hover_t()))
        }))
        shell_press(b, fn() { btn.pressed() })
        let _ = b.box(fn(line : view::View) -> Unit {
          let _ = line.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_8)).rigid()
          let _ = line.box(fn(ic : view::View) -> Unit {
            let _ = ic.width(view::Live::Is(Some(SP_16))).height(view::Live::Is(Some(SP_16))).rigid().center()
            let _ = shell_icon_by(
              ic,
              fn() { if act().failed { ICON_ALERT_CIRCLE } else if act().done { ICON_CHECK } else { ICON_DOWNLOAD } },
              size=IC_MD,
              color_by=fn() { if act().failed { lg::surface().danger } else { shell_frame_ink_secondary(model.dark()) } },
            )
          })
          let _ = line.box(fn(tw : view::View) -> Unit {
            let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
            let _ = <ui::Text
              in={tw}
              size={TX_FOOTNOTE}
              weight={500}
              color_by=>{lg::surface().ink}
              text_by=>{act().name}
            />.allow_ellipsis(view::Live::Is(true))
          })
          line.show(fn() { act().more > 0 }, fn(m : view::View) -> Unit {
            let _ = m.rigid()
            let _ = <ui::Text
              in={m}
              size={TX_FOOTNOTE}
              color_by=>{shell_frame_ink_secondary(model.dark())}
              text_by=>{"+" + act().more.to_string()}
            />
          })
        })
        // Progress: a hairline filled to the ratio, or a band running along it while the size is not known.
        b.show(fn() { !act().done && !act().failed }, fn(track : view::View) -> Unit {
          let _ = track
          .height(view::Live::Is(Some(SP_2)))
          .radius(view::Live::Is(SP_2))
          .rigid()
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() { if model.dark() { 0xFFFFFF1FL } else { 0x0000001AL } }))
          let _ = track.box(fn(bar : view::View) -> Unit {
            let _ = bar
            .height(view::Live::Is(Some(SP_2)))
            .radius(view::Live::Is(SP_2))
            .points(view::Live::Is(false))
            .ground(view::Live::By(fn() { lg::surface().ink }))
            .width(view::Live::By(fn() {
              // (the track's width as laid out, followed: the first layout comes after this is first read)
              let w = match track.laid_size_told() {
                Some((tw, _)) => tw
                None => 0.0
              }
              let p = act().progress
              Some(if p >= 0.0 { w * (if p > 1.0 { 1.0 } else { p }) } else { w * 0.3 })
            }))
            .offset(view::Live::By(fn() {
              if act().progress >= 0.0 || ui::reduced_motion() {
                (SP_0, SP_0)
              } else {
                let w = match track.laid_size_told() {
                  Some((tw, _)) => tw
                  None => 0.0
                }
                ((bar.cycle(1400.0) * 1.3 - 0.3) * w, SP_0)
              }
            }))
          })
        })
      },
    )
  })
  built.v = true
}
