///| Extensions Manager (Settings > Extensions), toolbar badges and the extension popover: every act reaches its
///| callback by the extension's id, badges read crisply over their face, the surfaces pass the Apple UI audit in
///| light and dark.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn ext_t_item(id : String, name : String) -> proto::ExtensionUiItem {
  proto::ExtensionUiItem::{
    ..proto::ExtensionUiItem::blank(id),
    name,
    version: "1.4.2",
    description: "Keeps a note for every tab.",
    title: name,
    has_action: true,
    has_popup: true,
    popup_html_path: "chrome-extension://" + id + "/popup.html",
    options_url: "chrome-extension://" + id + "/options.html",
    permissions: ["storage", "contextMenus"],
    host_permissions: ["https://*.example.com/*"],
    source: "unpacked:/exts/" + id,
  }
}

fn ext_t_snapshot() -> proto::ExtensionsUiSnapshot {
  proto::ExtensionsUiSnapshot::{
    ..proto::ExtensionsUiSnapshot::empty(),
    items: [
      proto::ExtensionUiItem::{ ..ext_t_item("notes", "Tab Notes"), pinned: true, badge_text: "12", badge_bg: 0xFF3B30FFL },
      proto::ExtensionUiItem::{ ..ext_t_item("dark", "Dark Mode"), options_url: "", description: "" },
      proto::ExtensionUiItem::{ ..ext_t_item("old", "Old Thing"), enabled: false, error: "This extension's files are no longer available. Load it again." },
    ],
  }
}

fn ext_t_settings_props(
  snap : signals::Signal[proto::ExtensionsUiSnapshot],
  log : Array[String],
  open : signals::Signal[Bool],
  path_field~ : ui::Field = ui::Field::new(),
) -> SettingsPanelProps {
  SettingsPanelProps::{
    open: fn() { open.get() },
    dark: fn() { lg::is_dark() },
    active_tab: signals::signal(SETTINGS_TAB_EXTENSIONS),
    settings: fn() { proto::BrowserSettings::default() },
    clear_bookmarks: signals::signal(false),
    clear_history: signals::signal(false),
    clear_downloads: signals::signal(false),
    clear_boosts: signals::signal(false),
    filter_field: None,
    on_save_settings: fn(_s, _m) { () },
    on_step_zoom: fn(_d) { () },
    on_clear_browsing_data: fn(_sel) { () },
    on_close: fn() { open.set(false) },
    migrate: None,
    atc: None,
    passwords: None,
    extensions: Some(ExtensionsPanelProps::{
      snapshot: fn() { snap.get() },
      on_toggle: fn(id, on) { log.push("toggle:" + id + ":" + on.to_string()) },
      on_pin: fn(id, on) { log.push("pin:" + id + ":" + on.to_string()) },
      on_remove: fn(id) { log.push("remove:" + id) },
      on_options: fn(id) { log.push("options:" + id) },
      path_field,
      on_load_unpacked: fn(p) { log.push("load-unpacked:" + p) },
      on_install_crx: fn(p) { log.push("install-crx:" + p) },
    }),
  }
}

test "extensions manager: list, permission chips, toggle / pin / options / remove, load rows, error and empty state" {
  lg::set_dark(Some(false))
  let snap = signals::signal_ref(ext_t_snapshot())
  let log : Array[String] = []
  let open = signals::signal(true)
  let path_field = ui::Field::new()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_settings_panel(root, ext_t_settings_props(snap, log, open, path_field=path_field))
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.set_a11y(true)
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  debug_assert(t.rect_of("Extensions").is_some(), "the Extensions category is listed")
  debug_assert(t.find("Tab Notes").is_some() && t.find("Dark Mode").is_some() && t.find("1.4.2").is_some(), "names and versions")
  debug_assert(t.find("*.example.com").is_some() && t.find("Storage").is_some() && t.find("Context menus").is_some(), "permission chips")
  debug_assert(t.find("This extension's files are no longer available. Load it again.").is_some(), "load error in red")
  lg::assert_apple_ui(t, label="extensions_manager_light", allow_large_overlay=true)

  t.press("Enable Tab Notes")
  t.press("Unpin Tab Notes")
  t.press("Pin Dark Mode")
  t.press("Options for Tab Notes")
  t.press("Remove Dark Mode")
  // the load buttons wait for a path
  t.press("Load Unpacked Extension")
  t.frame(ms=16.0)
  path_field.set("/exts/new-one")
  t.frame(ms=16.0)
  t.press("Load Unpacked Extension")
  path_field.set("/dl/shield.crx")
  t.frame(ms=16.0)
  t.press("Install CRX File")
  t.frame(ms=16.0)
  debug_assert(
    log.join(",") == "toggle:notes:false,pin:notes:false,pin:dark:true,options:notes,remove:dark,load-unpacked:/exts/new-one,install-crx:/dl/shield.crx",
    "acts by id: " + log.join(","),
  )
  // no Options for one without an options page; no Pin while disabled
  debug_assert(t.get("Options for Dark Mode").is_none(), "no Options without an options page")
  debug_assert(t.get("Pin Old Thing").is_none(), "a disabled extension cannot be pinned")

  // the host's status: an error under Developer
  snap.set(proto::ExtensionsUiSnapshot::{ ..snap.untracked(), status: "manifest.json missing required field: name", status_error: true })
  t.frame(ms=16.0)
  debug_assert(t.find("manifest.json missing required field: name").is_some(), "status shown")

  // dark
  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  lg::assert_apple_ui(t, label="extensions_manager_dark", allow_large_overlay=true)
  lg::set_dark(Some(false))

  // empty: says so, keeps the load rows
  snap.set(proto::ExtensionsUiSnapshot::empty())
  t.frame(ms=16.0)
  debug_assert(t.find("No extensions").is_some(), "empty state")
  debug_assert(t.get("Load Unpacked Extension").is_some() && t.get("Install CRX File").is_some(), "load buttons stay")
  debug_assert(t.get("Enable Tab Notes").is_none(), "no rows left")
  t.dispose()
}

test "settings without extension props: no Extensions category" {
  lg::set_dark(Some(false))
  let snap = signals::signal_ref(ext_t_snapshot())
  let log : Array[String] = []
  let open = signals::signal(true)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_settings_panel(root, SettingsPanelProps::{ ..ext_t_settings_props(snap, log, open), active_tab: signals::signal(SETTINGS_TAB_GENERAL), extensions: None })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.set_a11y(true)
  t.frame(ms=400.0)
  debug_assert(t.rect_of("General").is_some() && t.rect_of("Extensions").is_none(), "category hidden without props")
  t.dispose()
}

test "toolbar: pinned faces with crisp badge pills, press opens the popover, its rows act by id" {
  lg::set_dark(Some(false))
  let snap = signals::signal_ref(ext_t_snapshot())
  let open_id = signals::signal("")
  let pressed : Array[String] = []
  let acts : Array[String] = []
  let anchor : signals::Ref[Option[AnchorRect]] = ui::ref_new(None)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      let _ = root.box(fn(bar : view::View) -> Unit {
        let _ = bar.row(view::Live::Is(true)).padding(view::Live::Is((SP_160 * 3.0, SP_12, SP_12, SP_12))).rigid()
        build_extension_toolbar(
          bar,
          ExtensionToolbarProps::{
            items: fn() { proto::extensions_pinned_items(snap.get()) },
            on_press: fn(id, rect) {
              pressed.push(id)
              anchor.v = Some(rect)
              open_id.set(id)
            },
            on_manage: fn() { acts.push("manage") },
            open_id: fn() { open_id.get() },
          },
        )
      })
      build_extension_popup_popover(
        root,
        ExtensionPopupProps::{
          open: fn() { open_id.get() != "" },
          item: fn() { proto::extensions_find(snap.get(), open_id.get()) },
          trigger_anchor: fn() { extension_toolbar_anchor(open_id.get()) },
          fallback_capsule: fn() { AnchorRect::{ x: 480.0, y: 12.0, w: 320.0, h: 32.0 } },
          on_open_popup: fn(url) { acts.push("popup:" + url) },
          on_options: fn(id) { acts.push("options:" + id) },
          on_unpin: fn(id) { acts.push("unpin:" + id) },
          on_manage: fn() { acts.push("manage") },
          on_close: fn() { open_id.set("") },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.set_a11y(true)
  t.frame(ms=16.0)
  // one pinned, enabled face (Dark Mode is not pinned, Old Thing is disabled)
  let face = t.get("Tab Notes, 12")
  debug_assert(face.is_some(), "pinned face labelled with its badge")
  debug_assert(t.get("Dark Mode").is_none() && t.get("Dark Mode, ").is_none(), "unpinned extensions stay off the toolbar")
  match (face, t.get("Tab Notes badge 12")) {
    (Some(f), Some(b)) => {
      let (fx, fy, fw, fh) = (f.x, f.y, f.w, f.h)
      let (bx, by, bw, bh) = (b.x, b.y, b.w, b.h)
      debug_assert(bh == SP_16 && bw >= SP_16, "pill 16pt tall, at least as wide")
      debug_assert(bx + bw > fx + fw - SP_8 && bx + bw <= fx + fw + SP_8 && by + bh > fy + fh - SP_4 && by > fy, "pill over the face's bottom-right corner")
    }
    _ => debug_assert(false, "badge pill drawn")
  }
  debug_assert(t.find("12").is_some(), "badge text")
  lg::assert_apple_ui(t, label="extensions_toolbar_light")

  // the badge follows the extension (a new count, a cleared badge)
  snap.set(proto::extensions_with_item(snap.untracked(), proto::ExtensionUiItem::{ ..ext_t_item("notes", "Tab Notes"), pinned: true, badge_text: "99999", badge_bg: 0xFFCC00FFL }))
  t.frame(ms=16.0)
  debug_assert(t.get("Tab Notes badge 9999").is_some(), "badge cut to 4 characters")

  t.press("Tab Notes, 9999")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(pressed.join(",") == "notes", "press reaches on_press with the id")
  match anchor.v {
    Some(r) => debug_assert(r.is_valid(), "press gives the face's rectangle")
    None => debug_assert(false, "anchor")
  }
  debug_assert(t.get("Extension").is_some(), "popover open")
  debug_assert(t.find("Open Popup").is_some() && t.find("Options").is_some() && t.find("Unpin from Toolbar").is_some(), "popover rows")
  lg::assert_apple_ui(t, label="extensions_popover_light")
  t.press("Open Tab Notes Popup")
  t.press("Options for Tab Notes")
  t.press("Unpin Tab Notes")
  t.press("Manage Extensions")
  debug_assert(
    acts.join(",") == "popup:chrome-extension://notes/popup.html,options:notes,unpin:notes,manage",
    "popover acts: " + acts.join(","),
  )
  lg::set_dark(Some(true))
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  lg::assert_apple_ui(t, label="extensions_popover_dark")
  t.press("Close Extension")
  t.frame(ms=300.0)
  debug_assert(t.get("Open Tab Notes Popup").is_none(), "closed")
  t.press("Extensions")
  debug_assert(acts[acts.length() - 1] == "manage", "the toolbar's Extensions face opens the manager")
  lg::set_dark(Some(false))
  t.dispose()
}
