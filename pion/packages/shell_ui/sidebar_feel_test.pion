///| Sidebar 手感: hit areas match what lights, presses answer on the way down, tabs drag (reorder, into folders,
///| to Pinned and Favorites), pinning moves the row above Today, the open favorite is raised, the sidebar edge
///| drags, the mini player jumps to its tab, Reload turns into Stop, and the toast's Undo presses.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn sf_frame(ctrl : ShellController) -> ui::Tester {
  ui::Tester::tree(
    fn(root) {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }))
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
}

///| What a press at (x, y) is for: the label it is read out by ("" nothing, "#drag" a drag-only node).
fn sf_hit(x : Double, y : Double) -> String {
  match ui::view_tree() {
    Some(tree) =>
    match tree.target_at(x, y) {
      view::Target::Pressed(id) | view::Target::Dragged(id) =>
      match tree.said_of(id) {
        Some(s) => s.label
        None => "#unlabelled"
      }
      _ => ""
    }
    None => ""
  }
}

///| The rect of the button read out as `label`.
fn sf_rect(t : ui::Tester, label : String) -> (Double, Double, Double, Double) {
  match t.get(label, role=view::Role::Button) {
    Some(d) => (d.x, d.y, d.w, d.h)
    None => {
      debug_assert(false, "no button \{label}")
      (0.0, 0.0, 0.0, 0.0)
    }
  }
}

fn sf_tab_ids(tabs : Array[ShellTabItem]) -> String {
  let parts : Array[String] = []
  for t in tabs {
    parts.push(t.id)
  }
  parts.join(",")
}

///| The id of the active demo tab.
fn sf_active(ctrl : ShellController) -> String {
  for t in ctrl.tabs.untracked() {
    if t.active {
      return t.id
    }
  }
  ""
}

test "sidebar feel: every tab row presses edge to edge, from the window edge; its close takes only its trailing 32pt" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  for title in ["WPT Dashboard: css", "Groove Salad — SomaFM", "Designing for Reading", "CSS Grid Layout Module Level 3"] {
    let (x, y, w, h) = sf_rect(t, title)
    debug_assert(h >= 32.0, "\{title}: at least 32pt tall (\{h})")
    debug_assert(x <= 0.5, "\{title}: its press starts at the window edge (x=\{x})")
    debug_assert(x + w >= SHELL_SIDEBAR_W_WIDE - 0.5, "\{title}: it reaches the sidebar's trailing edge (\{x + w})")
    let mid = y + h / 2.0
    t.move_to(900.0, 400.0)
    t.frame(ms=16.0)
    // Scan the whole row with the pointer away (no close shown): every point selects the tab.
    let mut sx = 1.0
    while sx < SHELL_SIDEBAR_W_WIDE {
      debug_assert(sf_hit(sx, mid) == title, "\{title}: x=\{sx} presses the row (got \{sf_hit(sx, mid)})")
      sx += 8.0
    }
    // Hovered: the trailing 32pt is Close, the rest still the row.
    t.move_to(100.0, mid)
    t.frame(ms=200.0)
    debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE - 1.0, mid) == "Close " + title, "\{title}: the trailing edge closes while hovered")
    debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE - SP_40, mid) == title, "\{title}: left of Close is still the row")
  }
  // A folder row and New Tab reach the window edge the same way.
  for label in ["Research", "New Tab"] {
    let (x, _, w, h) = sf_rect(t, label)
    debug_assert(x <= 0.5 && x + w >= SHELL_SIDEBAR_W_WIDE - 0.5 && h >= 32.0, "\{label}: edge to edge, 32pt")
  }
  // The gap between the sidebar and the page card is the sidebar's resize handle (no dead gutter).
  let (_, ty, _, th) = sf_rect(t, "WPT Dashboard: css")
  debug_assert(sf_hit(SHELL_SIDEBAR_W_WIDE + 4.0, ty + th / 2.0) == "Resize Sidebar", "the gutter resizes the sidebar")
  t.dispose()
}

test "sidebar feel: the mouse selects a tab on its way down, and the selected wash eases in over MO_KEY_MS" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let (x, y, w, h) = sf_rect(t, "WPT Dashboard: css")
  let mx = x + w / 2.0
  let my = y + h / 2.0
  t.move_to(mx, my)
  t.frame(ms=200.0)
  t.press_at(mx, my)
  t.frame(ms=16.0)
  debug_assert(sf_active(ctrl) == "t4", "selected while the button is still held (got \{sf_active(ctrl)})")
  // The wash is mid-way soon after and at rest by MO_KEY_MS (sampled on the wash's own drawn rect).
  let wash_alpha = fn() -> Int {
    let mut best = 0
    for d in t.drawn() {
      if d.y <= my && d.y + d.h >= my && d.x >= SP_8 - 0.5 && d.x <= SP_8 + 0.5 && d.w > SP_160 {
        let a = (d.ground & 0xFFL).to_int()
        if a > best {
          best = a
        }
      }
    }
    best
  }
  t.release(mx, my)
  t.frame(ms=16.0)
  let a_mid = wash_alpha()
  t.frame(ms=200.0)
  let a_rest = wash_alpha()
  debug_assert(a_rest > 0 && a_mid <= a_rest, "the selected wash grows to rest (mid \{a_mid}, rest \{a_rest})")
  t.frame(ms=200.0)
  debug_assert(wash_alpha() == a_rest, "and holds at rest")
  // A press on the selected tab does not select it again, a right-click never selects.
  t.dispose()
}

test "sidebar feel: a tab drags to reorder Today, into a folder, to Pinned and onto Favorites; a short move is a click" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let row_mid = fn(title : String) -> (Double, Double) {
    let (x, y, w, h) = sf_rect(t, title)
    (x + w / 2.0, y + h / 2.0)
  }
  // 1. Reorder: WPT (last in Today) dropped on the upper half of Groove Salad lands before it.
  let (wx, wy) = row_mid("WPT Dashboard: css")
  let (_, gy) = row_mid("Groove Salad — SomaFM")
  t.drag(wx, wy, wx, gy - SP_8, steps=6)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "move_tab:t4>today<t3", "reordered: \{ctrl.last_intent.untracked()}")
  debug_assert(sf_tab_ids(ctrl.tabs.untracked()).ends_with("t4,t3"), "t4 now before t3: \{sf_tab_ids(ctrl.tabs.untracked())}")
  debug_assert(row_mid("WPT Dashboard: css").1 < row_mid("Groove Salad — SomaFM").1, "and drawn above it")

  // 2. Into a folder: dropped on the folder's row.
  let (wx2, wy2) = row_mid("WPT Dashboard: css")
  let (_, fy) = row_mid("Research")
  t.drag(wx2, wy2, wx2, fy, steps=6)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "move_tab:t4>folder:research<", "into the folder: \{ctrl.last_intent.untracked()}")

  // 3. Out to Pinned: a folder's tab dropped on the upper half of the Today divider moves above Today; the playing
  //    tab (whose selection hides the mini player under the pointer's hold) drags the same.
  for pair in [("CSS Grid Layout Module Level 3", "t2"), ("Groove Salad — SomaFM", "t3")] {
    let (title, id) = pair
    let (gx, gy2) = row_mid(title)
    let (_, today_y, _, today_h) = match t.rect_of("Today") {
      Some(r) => r
      None => (0.0, 0.0, 0.0, 0.0)
    }
    t.drag(gx, gy2, gx, today_y + today_h / 2.0 - SP_6, steps=6)
    t.frame(ms=16.0)
    debug_assert(ctrl.last_intent.untracked() == "move_tab:" + id + ">pinned<", "\{title} to Pinned: \{ctrl.last_intent.untracked()}")
    let today_now = match t.rect_of("Today") {
      Some(r) => r.1
      None => 0.0
    }
    debug_assert(row_mid(title).1 < today_now, "\{title}: a pinned tab is drawn above Today")
  }

  // 4. Onto Favorites: it gets a tile and leaves the rows.
  let (gx3, gy3) = row_mid("Groove Salad — SomaFM")
  let (_, fav_y, _, fav_h) = sf_rect(t, "GitHub")
  t.drag(gx3, gy3, gx3, fav_y + fav_h / 2.0, steps=8)
  t.frame(ms=16.0)
  // (dropped on GitHub's right half: it lands before the next tile)
  debug_assert(ctrl.last_intent.untracked().starts_with("move_tab:t3>favorites<"), "to Favorites: \{ctrl.last_intent.untracked()}")
  debug_assert(t.get("Groove Salad — SomaFM", role=view::Role::Button) is Some(_), "the favorite tile is there")
  // (the one text left is the mini player's title: the tab still plays)
  debug_assert(sidebar_text_count(t, "Groove Salad — SomaFM") <= 1, "and no row shows it twice")

  // 5. A press that moves less than the slop is a click: it selects, nothing moves.
  ctrl.last_intent.set("")
  let (dx, dy) = row_mid("CSS Grid Layout Module Level 3")
  t.press_at(dx, dy)
  t.frame(ms=16.0)
  t.move_to(dx + 2.0, dy + 1.0)
  t.frame(ms=16.0)
  t.release(dx + 2.0, dy + 1.0)
  t.frame(ms=16.0)
  debug_assert(sf_active(ctrl) == "t2" && !ctrl.last_intent.untracked().starts_with("move_tab"), "a short move selects (\{ctrl.last_intent.untracked()})")
  t.dispose()
}

test "sidebar feel: Escape puts a dragged tab back where it was, easing home" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let before = sf_tab_ids(ctrl.tabs.untracked())
  let (x, y, w, h) = sf_rect(t, "WPT Dashboard: css")
  let mx = x + w / 2.0
  let my = y + h / 2.0
  t.press_at(mx, my)
  t.frame(ms=16.0)
  t.move_to(mx, my - SP_40)
  t.frame(ms=16.0)
  t.move_to(mx, my - SP_80)
  t.frame(ms=16.0)
  // Lifted and following the pointer: the row's title is drawn off its place.
  let lifted_y = match t.rect_of("WPT Dashboard: css") {
    Some(r) => r.1
    None => 0.0
  }
  debug_assert(lifted_y < y - SP_40, "the held row follows the pointer 1:1 (\{lifted_y} vs \{y})")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  t.release(mx, my - SP_80)
  t.frame(ms=40.0)
  let mid_y = match t.rect_of("WPT Dashboard: css") {
    Some(r) => r.1
    None => 0.0
  }
  t.frame(ms=200.0)
  let home_y = match t.rect_of("WPT Dashboard: css") {
    Some(r) => r.1
    None => 0.0
  }
  debug_assert(sf_tab_ids(ctrl.tabs.untracked()) == before, "nothing moved")
  debug_assert(!ctrl.last_intent.untracked().starts_with("move_tab"), "no move was emitted")
  debug_assert(mid_y < home_y - 0.5 && home_y > lifted_y, "it eases home (mid \{mid_y}, home \{home_y})")
  t.dispose()
}

test "sidebar feel: pinned tabs sit above Today, favorites are not rows, the open favorite is raised" {
  let ctrl = make_demo_controller()
  let tabs = ctrl.tabs.untracked().copy()
  tabs.push(ShellTabItem::{ ..tabs[3], id: "t5", title: "Team Calendar", pinned: true, folder_id: "", active: false })
  tabs.push(ShellTabItem::{ ..tabs[3], id: "f1", title: "GitHub", url: "https://github.com", favorite: true, active: false })
  ctrl.tabs.set(tabs)
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let y_of = fn(s : String) -> Double {
    match t.rect_of(s) {
      Some(r) => r.1
      None => -1.0
    }
  }
  debug_assert(y_of("Team Calendar") > 0.0 && y_of("Team Calendar") < y_of("Today"), "the pinned tab is above Today")
  debug_assert(sidebar_text_count(t, "GitHub") == 0, "a favorite is a tile, not a row")
  let fav_ground = fn() -> Int64 {
    let (fx, fy, fw, fh) = sf_rect(t, "GitHub")
    let mut g = 0L
    for d in t.drawn() {
      if (d.x - fx).abs() < 0.5 && (d.y - fy).abs() < 0.5 && (d.w - fw).abs() < 0.5 && (d.h - fh).abs() < 0.5 {
        g = d.ground
      }
    }
    g
  }
  let rest = fav_ground()
  let favs = ctrl.favorites.untracked().copy()
  favs[0] = ShellFavoriteItem::{ ..favs[0], active: true }
  ctrl.favorites.set(favs)
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert((fav_ground() & 0xFFL) > (rest & 0xFFL), "the open favorite takes the strong wash (\{rest} -> \{fav_ground()})")
  t.dispose()
}

test "sidebar feel: the sidebar edge drags its width, the mini player jumps to its tab, Reload turns into Stop" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let (_, ty, _, th) = sf_rect(t, "WPT Dashboard: css")
  let hy = ty + th / 2.0
  t.drag(SHELL_SIDEBAR_W_WIDE + 4.0, hy, SHELL_SIDEBAR_W_WIDE + 64.0, hy, steps=6)
  t.frame(ms=16.0)
  let w = ctrl.dock.untracked().sidebar_width
  debug_assert(w >= 296.0 && w <= 308.0, "the sidebar follows the pointer (\{w})")
  debug_assert(ctrl.last_intent.untracked().starts_with("sidebar_width:"), "and keeps the width on release")
  let (_, _, rw, _) = sf_rect(t, "WPT Dashboard: css")
  debug_assert(rw >= w - 0.5, "the rows widen with it (\{rw})")

  // Mini player: the card outside its two controls goes to the playing tab.
  t.press("Go to " + ctrl.mini_player.untracked().title)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked().starts_with("select_tab:"), "the card jumps to its tab: \{ctrl.last_intent.untracked()}")

  // Reload / Stop: one target, the glyph and the act swap in place.
  let (rx, ry, _, _) = sf_rect(t, "Reload")
  ctrl.loading.set(true)
  t.frame(ms=16.0)
  let (sx, sy, _, _) = sf_rect(t, "Stop Loading")
  debug_assert(rx == sx && ry == sy, "Stop sits where Reload was")
  t.press("Stop Loading")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "stop" && !ctrl.loading.untracked(), "Stop stops")
  t.dispose()
}

test "sidebar feel: a loading tab shows a spinner in its tile's place, the row does not move" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let before = t.rect_of("WPT Dashboard: css")
  let tabs = ctrl.tabs.untracked().copy()
  tabs[3] = ShellTabItem::{ ..tabs[3], loading: true }
  ctrl.tabs.set(tabs)
  t.frame(ms=16.0)
  debug_assert(t.get("Loading", role=view::Role::Status) is Some(_), "the spinner says Loading")
  let after = t.rect_of("WPT Dashboard: css")
  match (before, after) {
    (Some(a), Some(b)) => debug_assert(a.0 == b.0 && a.1 == b.1, "the title never shifts")
    _ => debug_assert(false, "title drawn")
  }
  t.dispose()
}

test "sidebar feel: a toast with an action presses on its pill, holds while hovered, and still lets the page get clicks" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  ctrl.passive.set(PassiveState::{
    ..ctrl.passive.untracked(),
    toast_visible: true,
    toast_title: "Closed 3 other tabs",
    toast_kind: toast_kind_from_tag("close"),
    toast_action: "Undo",
  })
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  let (ux, uy, uw, uh) = sf_rect(t, "Undo")
  debug_assert(uh >= 32.0, "Undo is a 32pt target")
  t.move_to(ux + uw / 2.0, uy + uh / 2.0)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "toast_hover:on", "the pointer over the pill holds its timer")
  t.press("Undo")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "toast_action" && !ctrl.passive.untracked().toast_visible, "Undo runs and the toast goes")
  // Info is neutral: no accent glyph on a routine close.
  debug_assert(toast_kind_from_tag("close") is ToastKind::Info, "close is a note")
  t.dispose()
}

test "sidebar feel: the held row is drawn over the Favorites grid, outside the list's clip; favorites reorder" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let title = "WPT Dashboard: css"
  let (x, y, w, h) = sf_rect(t, title)
  let mx = x + w / 2.0
  let my = y + h / 2.0
  let (_, fav_y, _, fav_h) = sf_rect(t, "GitHub")
  let start_title = match t.rect_of(title) {
    Some(r) => r
    None => (0.0, 0.0, 0.0, 0.0)
  }
  t.press_at(mx, my)
  t.frame(ms=16.0)
  // Mid-lift: one copy only (the row's own place is the gap it left), where the row stood.
  t.move_to(mx, my - SP_8)
  t.frame(ms=16.0)
  debug_assert(sidebar_text_count(t, title) == 1, "one copy of the held row is drawn (\{sidebar_text_count(t, title)})")
  match t.rect_of(title) {
    Some(r) => debug_assert((r.0 - start_title.0).abs() < 1.0 && (r.1 - (start_title.1 - SP_8)).abs() < 1.5, "the copy starts where the row was (\{r.0},\{r.1} vs \{start_title.0},\{start_title.1})")
    None => debug_assert(false, "the held row is drawn")
  }
  let mut py = my - SP_8
  while py > fav_y + fav_h / 2.0 {
    py -= SP_40
    if py < fav_y + fav_h / 2.0 {
      py = fav_y + fav_h / 2.0
    }
    t.move_to(mx, py)
    t.frame(ms=16.0)
  }
  t.frame(ms=200.0)
  // Over the grid, the held row is still seen (the tab list's scroll clip does not cut it), lifted to 1.02.
  match t.rect_of(title) {
    Some(r) => {
      let cy = r.1 + r.3 / 2.0
      debug_assert(cy >= fav_y - SP_8 && cy <= fav_y + fav_h + SP_8, "drawn over the Favorites grid (title y \{cy}, grid \{fav_y}..\{fav_y + fav_h})")
    }
    None => debug_assert(false, "the held row is seen over the Favorites grid")
  }
  t.release(mx, py)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked().starts_with("move_tab:t4>favorites<"), "dropped on Favorites: \{ctrl.last_intent.untracked()}")
  t.frame(ms=200.0)
  debug_assert(sidebar_text_count(t, title) == 0, "the copy goes with the drop")

  // A favorite dragged past the last tile lands at the end of the grid.
  let ids = fn() -> String {
    let parts : Array[String] = []
    for f in ctrl.favorites.untracked() {
      parts.push(f.id)
    }
    parts.join(",")
  }
  let (gx, gy, gw, gh) = sf_rect(t, "GitHub")
  let (lx, _, lw, _) = sf_rect(t, "Wikipedia")
  t.drag(gx + gw / 2.0, gy + gh / 2.0, lx + lw * 0.8, gy + gh / 2.0, steps=8)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "move_tab:f1>favorites<t4" || ctrl.last_intent.untracked() == "move_tab:f1>favorites<", "a favorite moves within the grid: \{ctrl.last_intent.untracked()}")
  debug_assert(!ids().starts_with("f1"), "GitHub left the front: \{ids()}")
  // Dropped back where it stands: no move.
  ctrl.last_intent.set("")
  let (lx2, ly2, lw2, lh2) = sf_rect(t, "Linear")
  t.drag(lx2 + lw2 / 2.0, ly2 + lh2 / 2.0, lx2 + lw2 / 2.0 + 2.0 * SP_4, ly2 + lh2 / 2.0, steps=4)
  t.frame(ms=16.0)
  debug_assert(!ctrl.last_intent.untracked().starts_with("move_tab"), "a favorite let go in its own place does not move (\{ctrl.last_intent.untracked()})")
  t.dispose()
}

test "sidebar feel: an unloaded tab is dimmed, the mini player is one focus stop, the current Space row is no button" {
  let ctrl = make_demo_controller()
  let t = sf_frame(ctrl)
  t.frame(ms=16.0)
  let title = "WPT Dashboard: css"
  let alpha_of = fn() -> Double {
    let mut a = -1.0
    for d in t.drawn() {
      if d.words == title && d.x < SHELL_SIDEBAR_W_WIDE {
        a = d.alpha
      }
    }
    a
  }
  let rest = alpha_of()
  let tabs = ctrl.tabs.untracked().copy()
  tabs[3] = ShellTabItem::{ ..tabs[3], unloaded: true, active: false }
  ctrl.tabs.set(tabs)
  t.frame(ms=40.0)
  let mid = alpha_of()
  t.frame(ms=200.0)
  let dim = alpha_of()
  debug_assert(rest > 0.9 && dim < rest - 0.3 && dim > 0.3, "an unloaded tab's title is dimmed (\{rest} -> \{dim})")
  debug_assert(mid >= dim && mid <= rest, "over MO_KEY_MS, no jump (mid \{mid})")
  // Still a full-size target: pressing it loads it again.
  let (_, _, _, rh) = sf_rect(t, title)
  debug_assert(rh >= 32.0, "unloaded rows press the same")

  // The mini player's jump is one button (one focus stop), not two.
  let label = "Go to " + ctrl.mini_player.untracked().title
  let mut n = 0
  match ui::view_tree() {
    Some(tree) => {
      for d in t.drawn() {
        match tree.said_of(d.id) {
          Some(s) => if s.label == label { n += 1 }
          None => ()
        }
      }
    }
    None => ()
  }
  debug_assert(n == 1, "one jump button is read out (\{n})")
  t.dispose()
}

test "sidebar feel: Ctrl+Tab's strip follows the pointer's moves, never a cell stepped under a resting pointer" {
  let open = signals::signal(true)
  let sel = signals::signal(0)
  let hovers : Array[Int] = []
  let items : Array[MruTabEntry] = []
  let mut i = 0
  while i < 14 {
    items.push(MruTabEntry::{ tab_id: "t\{i}", title: "Tab \{i}", host: "h\{i}.test", playing: false, active: i == 0 })
    i += 1
  }
  let t = ui::Tester::tree(
    fn(root) {
      build_mru_switcher_modal(root, MruSwitcherModalProps::{
        open: fn() { open.get() },
        space_name: fn() { "Work" },
        items: fn() { items },
        selected_index: fn() { sel.get() },
        on_select_tab: fn(_id) { () },
        on_hover_index: fn(k) {
          hovers.push(k)
          sel.set(k)
        },
        on_close: fn() { open.set(false) },
        content_left: fn(_vw) { 0.0 },
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  let (cx, cy, cw, ch) = sf_rect(t, "Switch to Tab 1")
  t.move_to(cx + cw / 2.0, cy + ch / 2.0)
  t.frame(ms=16.0)
  debug_assert(hovers.length() >= 1 && hovers[hovers.length() - 1] == 1, "moving onto a cell takes the selection (\{hovers.length()})")
  let n = hovers.length()
  // Tab steps on past the cells shown (the strip scrolls under the still pointer): the keyboard keeps the selection.
  let mut k = 2
  while k < 14 {
    sel.set(k)
    t.frame(ms=16.0)
    k += 1
  }
  t.frame(ms=200.0)
  debug_assert(hovers.length() == n, "no hover from cells passing under a resting pointer (\{hovers.length() - n})")
  debug_assert(sel.untracked() == 13, "the selection is where the keyboard put it")
  t.dispose()
}
