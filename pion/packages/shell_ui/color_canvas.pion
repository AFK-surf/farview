///| The color canvas shared by the Space theme editor (`space_theme.pion`) and the Boost editor
///| (`reader_boost_panel.pion`): a dotted square field and round handles a person drags (or moves with the arrow
///| keys) across it. A handle's place is `(x, y)` in 0..1 of the canvas; what a place means (a hue and a depth) is
///| the caller's.
///|
///| Motion: dragging is direct manipulation: the handle's place follows the pointer exactly, never eased. The one
///| held lifts (scale 1 -> 1.15 and a deeper shadow) over MO_KEY_MS on the strong ease-out and settles back over
///| MO_RELEASE_MS as it is let go; under reduced motion the scale stays 1.

import "lg"
import "motion"
import "pixels"
import "signals"
import "ui"
import "view"

// Literals with their token (package lets initialize in file order).
let CC_DOT_STEP : Double = 8.0 // SP_8
let CC_DOT : Double = 1.5 // SP_2 * 0.75: one canvas dot
let CC_RING : Double = 3.0 // SP_6 / 2: the handle's white ring
let CC_KEY_STEP : Double = 0.02
let CC_KEY_STEP_BIG : Double = 0.1
let CC_LIFT : Double = 0.15

///| The dot pattern of a canvas `side` points square: a 1.5pt dot every 8pt, ink at 18%.
fn cc_dot_vector(dark : Bool, side : Double) -> pixels::Vector {
  let sb = StringBuilder::new()
  let d = CC_DOT.to_string()
  let mut y = CC_DOT_STEP / 2.0
  while y < side {
    let mut x = CC_DOT_STEP / 2.0
    while x < side {
      sb.write_string("M" + x.to_string() + " " + y.to_string() + "h" + d + "v" + d + "h-" + d + "z")
      x = x + CC_DOT_STEP
    }
    y = y + CC_DOT_STEP
  }
  pixels::Vector::{
    w: side,
    h: side,
    layers: [
      pixels::VectorPath::{
        d: sb.to_string(),
        fill: if dark { 0xFFFFFF2EL } else { 0x0000002EL },
        stroke: 0L,
        width: 0.0,
        even_odd: false,
        sx: 1.0,
        sy: 1.0,
        tx: 0.0,
        ty: 0.0,
      },
    ],
  }
}

// (built once per appearance and size: a canvas is drawn again on every frame of a drag)
let cc_dot_cache : Array[(Bool, Double, pixels::Vector)] = []

fn cc_dots(dark : Bool, side : Double) -> pixels::Vector {
  for c in cc_dot_cache {
    if c.0 == dark && c.1 == side {
      return c.2
    }
  }
  let v = cc_dot_vector(dark, side)
  cc_dot_cache.push((dark, side, v))
  v
}

///| The canvas's field: a clearly deeper well than the panel it sits in, in both appearances.
fn cc_field_ground(panel : Int64) -> Int64 {
  if lg::is_dark() { lg::surface().card_secondary } else { shell_mix(panel, lg::surface().ink, 0.07) }
}

///| The dotted field of a canvas `side` points square, laid over all of `cv` (behind what comes after it).
fn color_canvas_field(cv : view::View, side : Double, radius : Double, ground : () -> Int64) -> Unit {
  let _ = cv.box(fn(field : view::View) -> Unit {
    let _ = field
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .radius(view::Live::Is(radius))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(ground))
    .picture(view::Live::By(fn() { Some(cc_dots(lg::is_dark(), side)) }))
  })
}

///| A handle's face: a white ring round the color and a soft shadow; `big` (the one being dragged) lifts a little
///| (1.15, a deeper shadow) over MO_KEY_MS and back over MO_RELEASE_MS; its place is never eased.
fn color_canvas_face(parent : view::View, size : Double, rgba : () -> Int64, big : () -> Bool) -> Unit {
  let _ = parent.box(fn(face : view::View) -> Unit {
    let lift = motion::NodeWay::new(if signals::untracked(big) { 1.0 } else { 0.0 })
    face.reacts(big, fn(on : Bool) -> Unit {
      if on {
        lift.go(face, 1.0, shell_spec(MO_KEY_MS))
      } else {
        lift.go(face, 0.0, shell_spec(MO_RELEASE_MS))
      }
    }, at_start=false)
    let t = fn() -> Double { if ui::reduced_motion() { 0.0 } else { lift.shown(face) } }
    let _ = face
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .radius(view::Live::Is(size / 2.0))
    .points(view::Live::Is(false))
    .ground(view::Live::By(rgba))
    .edge(view::Live::Is((CC_RING, 0xFFFFFFFFL)))
    .shadow(view::Live::By(fn() {
      let k = t()
      (SP_6 + (SP_12 - SP_6) * k, SP_2 + (SP_4 - SP_2) * k, 0x00000040L)
    }))
    .shadow_outside(view::Live::Is(true))
    .scale(view::Live::By(fn() { 1.0 + CC_LIFT * t() }))
  })
}

///| What one handle on a color canvas shows and does.
struct CanvasHandle {
  ///| The canvas's side, the handle's face and its (larger) hit square, in points.
  side : Double
  face : Double
  hit : Double
  ///| What assistive tech calls it ("Color 1") and its value ("Hue 40%, depth 20%").
  label : String
  value : () -> String
  point : () -> (Double, Double)
  rgba : () -> Int64
  ///| Being dragged (the face grows).
  big : () -> Bool
  ///| A press on it (before any move), each move of a drag (to an absolute place), the drag's end.
  on_down : () -> Unit
  on_move : (Double, Double) -> Unit
  on_up : () -> Unit
  ///| Assistive increment / decrement.
  on_step : (Int) -> Unit
  ///| An arrow key moved it (to an absolute place: the caller decides when to keep it).
  on_arrow : (Double, Double) -> Unit
  ///| Backspace / Delete while focused; true when it acted.
  on_delete : () -> Bool
}

///| Makes `h` (a box laid over the canvas) a draggable, focusable color handle.
fn color_canvas_handle(h : view::View, spec : CanvasHandle) -> Unit {
  // Where a drag started: the point's place and the pointer's, so the handle follows the pointer exactly.
  let start : signals::Ref[(Double, Double, Double, Double)] = ui::ref_new((0.0, 0.0, 0.0, 0.0))
  let _ = h
  .over(view::Live::Is(true), edges=(Some(SP_0), Some(SP_0), None, None))
  .width(view::Live::Is(Some(spec.hit)))
  .height(view::Live::Is(Some(spec.hit)))
  .center()
  .offset(view::Live::By(fn() {
    let (x, y) = (spec.point)()
    (x * spec.side - spec.hit / 2.0, y * spec.side - spec.hit / 2.0)
  }))
  .presses(view::Live::Is(true))
  .focusable(view::Live::Is(true), keys=0)
  .focus_ring_theme()
  .says(view::Live::By(fn() {
    Some(
      view::said(
        view::Role::Slider,
        label=spec.label,
        value=(spec.value)(),
        actions=[view::Action::Increment, view::Action::Decrement],
      ),
    )
  }))
  // (an open hand over it, a closed one while it is held: the handle is in the hand)
  .cursor(view::Live::By(fn() { Some(if (spec.big)() { view::Cursor::Grabbing } else { view::Cursor::Grab }) }))
  .on_step(fn(by : Int) { (spec.on_step)(by) })
  .on_drag(fn(d : view::Drag) -> Unit {
    match d.kind {
      Down => {
        let _ = h.ask_focus()
        let (x, y) = signals::untracked(spec.point)
        start.v = (x, y, d.wx, d.wy)
        (spec.on_down)()
      }
      Moved => {
        let (sx, sy, swx, swy) = start.v
        (spec.on_move)(sx + (d.wx - swx) / spec.side, sy + (d.wy - swy) / spec.side)
      }
      Up | Off => (spec.on_up)()
    }
  }, captures=true)
  .on_key(fn(k : view::Key) -> Bool {
    if !h.focused() {
      return false
    }
    if (k.code == ui::key_code_backspace || k.code == ui::key_code_delete) && k.mods == 0 {
      return (spec.on_delete)()
    }
    let stp = if k.mods != 0 { CC_KEY_STEP_BIG } else { CC_KEY_STEP }
    let (x, y) = signals::untracked(spec.point)
    let to = if k.code == ui::key_code_left {
      Some((x - stp, y))
    } else if k.code == ui::key_code_right {
      Some((x + stp, y))
    } else if k.code == ui::key_code_up {
      Some((x, y - stp))
    } else if k.code == ui::key_code_down {
      Some((x, y + stp))
    } else {
      None
    }
    match to {
      Some((nx, ny)) => {
        (spec.on_arrow)(nx, ny)
        true
      }
      None => false
    }
  })
  color_canvas_face(h, spec.face, spec.rgba, spec.big)
}
