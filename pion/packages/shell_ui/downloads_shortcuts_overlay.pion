///| Farview Desktop Shell 2.0 Phase 2B — Downloads Popover (`downloads`) and
///| macOS Keyboard Shortcuts Cheatsheet Modal (`shortcuts`).
///|
///| Architectural invariants:
///| - Pure UI + callbacks: never touches `DownloadsTracker` / `clear_ack_id` / `reqId` protocol logic.
///| - Single-layer Liquid Glass containers via `lg::liquid_panel_shell_node` / `lg::liquid_dialog_shell_node`.
///| - Dynamic placement (`compute_popover_placement`) and responsive width/scroll clamping on narrow viewports.
///| - Zero Unicode pseudo-icons, 100% explicit `color_by`, accessible labels on all icon buttons.

import "headless"
import "lg"
import "signals"
import "ui"
import "view"

// ============================================================================
// 1. Downloads Popover (tag: "downloads")
// ============================================================================

///| Pure presentation model for a single download item row.
pub struct DownloadItemView {
  pub id : String
  pub filename : String
  pub source_host : String
  pub ext_badge : String
  pub size_label : String
  pub state : String
  pub state_label : String
}

pub struct DownloadsCallbacks {
  pub on_search_change : (String) -> Unit
  pub on_category_change : (String) -> Unit
  pub on_copy_path : (String) -> Unit
  pub on_reveal : (String) -> Unit
  pub on_clear_list : () -> Unit
  pub on_close : () -> Unit
}

pub struct DownloadsPopoverProps {
  pub open : () -> Bool
  pub search_field : ui::Field
  pub active_category : () -> String
  pub total_count : () -> Int
  pub items : () -> Array[DownloadItemView]
  pub trigger_anchor : () -> Option[AnchorRect]
  pub fallback_capsule : () -> AnchorRect
  pub callbacks : DownloadsCallbacks
}

fn downloads_count_label(n : Int) -> String {
  if n == 1 { "1 file" } else { "\{n} files" }
}

fn downloads_footer_summary(shown : Int, total : Int) -> String {
  if total == 0 {
    "Saved to Downloads"
  } else if shown == total {
    "Showing all \{total} downloads"
  } else {
    "Showing \{shown} of \{total}"
  }
}

///| Builds the Liquid Glass Downloads Popover (tag `"downloads"`).
pub fn build_downloads_popover(root : view::View, props : DownloadsPopoverProps) -> Unit {
  let nominal_w = 408.0
  let est_h = 440.0
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true))
    build_dismiss_scrim(layer, props.callbacks.on_close)

    layer.reacts(at_start=false, fn() { props.search_field.text() }, fn(q : String) -> Unit {
      (props.callbacks.on_search_change)(q)
    })

    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.over_at(view::Live::By(fn() {
        let (vw, vh) = overlay_window_size(root)
        let pw = clamp_popover_width(nominal_w, vw)
        let (px, py) = compute_popover_placement(
          (props.trigger_anchor)(),
          (props.fallback_capsule)(),
          vw,
          vh,
          pw,
          est_h,
        )
        (Some(px), Some(py), None, None)
      }))

      let _ = lg::liquid_panel_shell_node(
        pos,
        fn(panel : view::View) -> Unit {
          let _ = panel
          .width(view::Live::By(fn() {
            let (vw, _) = overlay_window_size(root)
            Some(clamp_popover_width(nominal_w, vw))
          }))
          .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .presses(view::Live::Is(true))
          .on_press(fn() { () })
          .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Downloads"))))

          // 1. Header: Downloads + total count pill + close icon button
          let _ = panel.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
            let _ = shell_icon(hdr, ICON_DOWNLOAD, size=15.0, color_by=fn() { lg::surface().accent })
            let _ = <ui::Text in={hdr} size={14.0} weight={600} color_by=>{lg::surface().ink} text="Downloads" />
            let _ = hdr.box(fn(cnt : view::View) -> Unit {
              let _ = cnt
              .padding(view::Live::Is((7.0, 2.0, 7.0, 2.0)))
              .radius(view::Live::Is(lg::r_chip))
              .rigid()
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              let _ = <ui::Text
                in={cnt}
                size={10.5}
                weight={500}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{downloads_count_label((props.total_count)())}
              />
            })
            let _ = hdr.box(fn(sp : view::View) -> Unit { let _ = sp.grow(view::Live::Is(1.0)) })
            build_close_icon_btn(hdr, "Close Downloads", props.callbacks.on_close)
          })

          // 2. Search input + Category filter pills
          let _ = panel.box(fn(ctrl : view::View) -> Unit {
            let _ = ctrl.gap(view::Live::Is(8.0)).rigid()

            let _ = ctrl.box(fn(sbox : view::View) -> Unit {
              let _ = sbox
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .min_height(view::Live::Is(Some(32.0)))
              .padding(view::Live::Is((9.0, 2.0, 6.0, 2.0)))
              .gap(view::Live::Is(6.0))
              .radius(view::Live::Is(lg::r_row))
              .ground(view::Live::By(fn() { lg::surface().card_secondary }))
              .edge(view::Live::By(fn() {
                if props.search_field.focused() {
                  (1.2, lg::surface().accent)
                } else {
                  (lg::hairline_w, lg::surface().separator)
                }
              }))
              .key_context("DownloadsField")
              .on_action("downloads.escape", fn(_a : view::ActionAt) -> Bool {
                if props.search_field.composing() {
                  props.search_field.compose("")
                  return true
                }
                (props.callbacks.on_close)()
                true
              })
              let _ = shell_icon(sbox, ICON_SEARCH, size=13.0, color_by=fn() { lg::surface().ink_secondary })
              let _ = sbox.box(fn(fw : view::View) -> Unit {
                let _ = fw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                fw.show(fn() { !lg::is_dark() }, fn(fl : view::View) -> Unit {
                  let _ = fl.fill()
                  let _ = ui::field(
                    fl,
                    props.search_field,
                    placeholder="Search downloads...",
                    font_size=12.0,
                    color=0x1C1C1EFFL,
                    placeholder_color=0x8E8E93FFL,
                    caret_color=0x007AFFFFL,
                    max_lines=1,
                    enter_sends=true,
                  )
                }, at_once=true)
                fw.show(fn() { lg::is_dark() }, fn(fd : view::View) -> Unit {
                  let _ = fd.fill()
                  let _ = ui::field(
                    fd,
                    props.search_field,
                    placeholder="Search downloads...",
                    font_size=12.0,
                    color=0xF5F5F7FFL,
                    placeholder_color=0x98989DFFL,
                    caret_color=0x0A84FFFFL,
                    max_lines=1,
                    enter_sends=true,
                  )
                }, at_once=true)
              })
              sbox.show(
                fn() { props.search_field.text() != "" },
                fn(cw : view::View) -> Unit {
                  let _ = lg::liquid_button_node(
                    cw,
                    fn() { "Clear Downloads Search" },
                    fn() -> Unit {
                      props.search_field.set("")
                      (props.callbacks.on_search_change)("")
                    },
                    content=fn(inner : view::View) -> Unit {
                      let _ = shell_icon(inner, ICON_CLOSE, size=12.0, color_by=fn() { lg::surface().ink_secondary })
                    },
                    flat=true,
                    ghost=true,
                    height=24.0,
                    pad_x=5.0,
                  )
                },
              )
            })

            let _ = ctrl.box(fn(cats : view::View) -> Unit {
              let _ = cats.row(view::Live::Is(true)).wraps(view::Live::Is(Some(6.0))).gap(view::Live::Is(6.0)).rigid()
              let cat_btn = fn(lbl : String, key : String) -> Unit {
                let _ = lg::liquid_button_node(
                  cats,
                  fn() { "Filter \{lbl}" },
                  fn() -> Unit { (props.callbacks.on_category_change)(key) },
                  content=fn(inner : view::View) -> Unit {
                    let _ = <ui::Text
                      in={inner}
                      size={11.0}
                      weight={500}
                      color_by=>{
                        if (props.active_category)() == key { lg::surface().accent } else { lg::surface().ink_secondary }
                      }
                      text={lbl}
                    />
                  },
                  flat=true,
                  active=fn() { (props.active_category)() == key },
                  neutral_active=true,
                  height=26.0,
                  pad_x=10.0,
                )
              }
              cat_btn("All", "all")
              cat_btn("PDF", "pdf")
              cat_btn("Images", "images")
              cat_btn("Other", "other")
            })
          })

          // 3. Scrollable downloads list
          let _ = panel.box(fn(list_host : view::View) -> Unit {
            let _ = list_host.max_height(view::Live::Is(Some(260.0))).min_height(view::Live::Is(Some(72.0))).cut()
            let _ = ui::scroll_box(list_host, fn(sc : view::View) -> Unit {
              let _ = sc.gap(view::Live::Is(6.0))

              sc.show(
                fn() { (props.items)().length() == 0 },
                fn(emp : view::View) -> Unit {
                  let _ = lg::surface_card_node(
                    emp,
                    fn(eb : view::View) -> Unit {
                      let _ = eb.center().gap(view::Live::Is(4.0)).padding(view::Live::Is((8.0, 14.0, 8.0, 14.0)))
                      let _ = <ui::Text
                        in={eb}
                        size={12.0}
                        color_by=>{lg::surface().ink_secondary}
                        text_by=>{
                          if props.search_field.text().trim() != "" || (props.active_category)() != "all" {
                            "No matching downloads"
                          } else {
                            "No recent downloads"
                          }
                        }
                      />
                    },
                    radius=lg::r_row,
                    pad=8.0,
                    secondary=true,
                  )
                },
              )

              sc.each(
                props.items,
                fn(it : DownloadItemView) -> String { it.id },
                fn(slot : view::View, it_sig : signals::Signal[DownloadItemView]) -> Unit {
                  let _ = lg::surface_card_node(
                    slot,
                    fn(row : view::View) -> Unit {
                      let _ = row
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Start)))
                      .gap(view::Live::Is(9.0))
                      .rigid()

                      // Extension badge aligned to first line
                      let _ = row.box(fn(badge : view::View) -> Unit {
                        let _ = badge
                        .width(view::Live::Is(Some(36.0)))
                        .height(view::Live::Is(Some(26.0)))
                        .center()
                        .rigid()
                        .radius(view::Live::Is(lg::r_chip))
                        .ground(view::Live::By(fn() { lg::surface().accent_tint }))
                        let _ = <ui::Text
                          in={badge}
                          size={9.5}
                          weight={600}
                          color_by=>{lg::surface().accent}
                          text_by=>{it_sig.get().ext_badge}
                        />
                      })

                      // Info + Actions column
                      let _ = row.box(fn(col : view::View) -> Unit {
                        let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(4.0))

                        let _ = col.box(fn(top_r : view::View) -> Unit {
                          let _ = top_r.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                          let _ = top_r.box(fn(fnm : view::View) -> Unit {
                            let _ = fnm.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={fnm}
                              size={12.5}
                              weight={500}
                              color_by=>{lg::surface().ink}
                              text_by=>{it_sig.get().filename}
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                          let _ = top_r.box(fn(st_pill : view::View) -> Unit {
                            let _ = st_pill
                            .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                            .radius(view::Live::Is(lg::r_chip))
                            .rigid()
                            .ground(view::Live::By(fn() {
                              let st = it_sig.get().state
                              if st == "failed" {
                                lg::surface().danger_bg
                              } else if st == "in_progress" {
                                lg::surface().accent_tint
                              } else {
                                lg::surface().positive_bg
                              }
                            }))
                            let _ = <ui::Text
                              in={st_pill}
                              size={10.0}
                              weight={500}
                              color_by=>{
                                let st = it_sig.get().state
                                if st == "failed" {
                                  lg::surface().danger
                                } else if st == "in_progress" {
                                  lg::surface().accent
                                } else {
                                  lg::surface().positive
                                }
                              }
                              text_by=>{it_sig.get().state_label}
                            />
                          })
                        })

                        let _ = col.box(fn(bot_r : view::View) -> Unit {
                          let _ = bot_r.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0))
                          let _ = bot_r.box(fn(meta : view::View) -> Unit {
                            let _ = meta.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
                            let _ = <ui::Text
                              in={meta}
                              size={11.0}
                              color_by=>{lg::surface().ink_secondary}
                              text_by=>{
                                let d = it_sig.get()
                                if d.size_label != "" { "\{d.source_host}  \{d.size_label}" } else { d.source_host }
                              }
                            />.allow_ellipsis(view::Live::Is(true))
                          })
                          let _ = lg::liquid_button_node(
                            bot_r,
                            fn() { "Copy Path" },
                            fn() -> Unit { (props.callbacks.on_copy_path)(it_sig.untracked().id) },
                            flat=true,
                            height=24.0,
                            pad_x=7.0,
                          )
                          let _ = lg::liquid_button_node(
                            bot_r,
                            fn() { "Reveal" },
                            fn() -> Unit { (props.callbacks.on_reveal)(it_sig.untracked().id) },
                            flat=true,
                            height=24.0,
                            pad_x=7.0,
                          )
                        })
                      })
                    },
                    radius=lg::r_row,
                    pad=8.0,
                  )
                },
              )
            })
          })

          // 4. Footer: summary + Clear List button
          let _ = panel.box(fn(ftr : view::View) -> Unit {
            let _ = ftr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
            let _ = ftr.box(fn(sum_w : view::View) -> Unit {
              let _ = sum_w.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
              let _ = <ui::Text
                in={sum_w}
                size={11.0}
                color_by=>{lg::surface().ink_secondary}
                text_by=>{downloads_footer_summary((props.items)().length(), (props.total_count)())}
              />.allow_ellipsis(view::Live::Is(true))
            })
            let _ = lg::liquid_button_node(
              ftr,
              fn() { "Clear List" },
              props.callbacks.on_clear_list,
              flat=true,
              height=28.0,
              pad_x=10.0,
            )
          })
        },
        radius=lg::r_card,
      )
    })
  })
}

// ============================================================================
// 2. Keyboard Shortcuts Modal (tag: "shortcuts")
// ============================================================================

pub struct ShortcutEntry {
  pub action : String
  pub keys : String
}

pub struct ShortcutGroup {
  pub title : String
  pub items : Array[ShortcutEntry]
}

///| Default grouped keyboard shortcuts catalog (matches macOS `⌘⇧⌥⌃` symbols or `Ctrl`/`Alt` on Linux/Windows).
pub fn default_macos_shortcut_groups() -> Array[ShortcutGroup] {
  let is_mac = ui::keys_system() <= 0
  let mod_k = fn(k : String) -> String { if is_mac { "⌘\{k}" } else { "Ctrl+\{k}" } }
  let shift_mod_k = fn(k : String) -> String { if is_mac { "⇧⌘\{k}" } else { "Ctrl+Shift+\{k}" } }
  let alt_mod_k = fn(k : String) -> String { if is_mac { "⌥⌘\{k}" } else { "Alt+Shift+\{k}" } }
  [
    ShortcutGroup::{
      title: "NAVIGATION & TABS",
      items: [
        ShortcutEntry::{ action: "Focus Address Bar", keys: mod_k("L") },
        ShortcutEntry::{ action: "New Tab", keys: mod_k("T") },
        ShortcutEntry::{ action: "Close Tab", keys: mod_k("W") },
        ShortcutEntry::{ action: "Reopen Closed Tab", keys: shift_mod_k("T") },
        ShortcutEntry::{ action: "Toggle Sidebar", keys: mod_k("S") },
        ShortcutEntry::{ action: "Split View", keys: shift_mod_k("\\") },
        ShortcutEntry::{ action: "Peek Preview", keys: shift_mod_k("P") },
        ShortcutEntry::{ action: "Expand Peek", keys: mod_k("O") },
        ShortcutEntry::{ action: "Quick Tab Switch", keys: if is_mac { "⌃Tab" } else { "Ctrl+Tab" } },
        ShortcutEntry::{ action: "Switch Tab 1-9", keys: mod_k("1-9") },
        ShortcutEntry::{ action: "Back / Forward", keys: "\{mod_k("[")}  \{mod_k("]")}" },
        ShortcutEntry::{ action: "Reload Page", keys: mod_k("R") },
      ],
    },
    ShortcutGroup::{
      title: "VIEW & AUDIO",
      items: [
        ShortcutEntry::{ action: "Zoom In / Out", keys: "\{mod_k("+")}  \{mod_k("-")}" },
        ShortcutEntry::{ action: "Reset Zoom", keys: mod_k("0") },
        ShortcutEntry::{ action: "Mute / Unmute Audio", keys: mod_k("M") },
        ShortcutEntry::{ action: "Save Page as PDF", keys: mod_k("P") },
      ],
    },
    ShortcutGroup::{
      title: "TOOLS & READING",
      items: [
        ShortcutEntry::{ action: "Command Bar", keys: mod_k("K") },
        ShortcutEntry::{ action: "Find in Page", keys: mod_k("F") },
        ShortcutEntry::{ action: "Browsing History", keys: mod_k("Y") },
        ShortcutEntry::{ action: "Downloads Manager", keys: mod_k("J") },
        ShortcutEntry::{ action: "Bookmarks Drawer", keys: shift_mod_k("B") },
        ShortcutEntry::{ action: "Bookmark Page", keys: mod_k("D") },
        ShortcutEntry::{ action: "Reader Mode", keys: alt_mod_k("R") },
        ShortcutEntry::{ action: "Arc Boosts", keys: shift_mod_k("E") },
        ShortcutEntry::{ action: "Toggle DevTools", keys: if is_mac { "⌥⌘I" } else { "Ctrl+Shift+I" } },
        ShortcutEntry::{ action: "Copy Clean URL", keys: shift_mod_k("C") },
        ShortcutEntry::{ action: "Capture Screenshot", keys: shift_mod_k("S") },
        ShortcutEntry::{ action: "Site Info & Cookies", keys: mod_k("I") },
        ShortcutEntry::{ action: "Open Settings", keys: mod_k(",") },
        ShortcutEntry::{ action: "Shortcuts Guide", keys: mod_k("/") },
      ],
    },
  ]
}

pub struct ShortcutsModalProps {
  pub open : () -> Bool
  pub groups : () -> Array[ShortcutGroup]
  pub on_close : () -> Unit
}

fn render_shortcut_group_card(parent : view::View, grp : ShortcutGroup) -> Unit {
  let _ = lg::surface_card_node(
    parent,
    fn(card : view::View) -> Unit {
      let _ = card.gap(view::Live::Is(4.0))
      let _ = <ui::Text in={card} size={10.5} weight={600} color_by=>{lg::surface().ink_secondary} text={grp.title} />
      let mut i = 0
      while i < grp.items.length() {
        let entry = grp.items[i]
        let _ = card.box(fn(row : view::View) -> Unit {
          let _ = row
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .min_height(view::Live::Is(Some(22.0)))
          .gap(view::Live::Is(8.0))
          .rigid()
          let _ = row.box(fn(act : view::View) -> Unit {
            let _ = act.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).cut()
            let _ = <ui::Text in={act} size={12.0} color_by=>{lg::surface().ink} text={entry.action} />.allow_ellipsis(view::Live::Is(true))
          })
          let _ = row.box(fn(cap : view::View) -> Unit {
            let _ = cap
            .padding(view::Live::Is((7.0, 2.0, 7.0, 2.0)))
            .radius(view::Live::Is(lg::r_chip))
            .rigid()
            .ground(view::Live::By(fn() { lg::surface().card_secondary }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
            let _ = <ui::Text in={cap} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text={entry.keys} />
          })
        })
        i += 1
      }
    },
    radius=lg::r_row,
    pad=10.0,
  )
}

///| Builds the Liquid Glass Keyboard Shortcuts Cheatsheet Modal (tag `"shortcuts"`).
///| Adapts between 2-column (wide) and single-column scrollable layout on narrow screens without truncation.
pub fn build_shortcuts_modal(root : view::View, props : ShortcutsModalProps) -> Unit {
  root.show(props.open, fn(layer : view::View) -> Unit {
    let _ = layer.over(view::Live::Is(true)).center()
    // Dimmed visual scrim backdrop (`headless::dialog` handles outside-click dismiss cleanly without leaking clicks)
    let _ = layer.box(fn(scrim : view::View) -> Unit {
      let _ = scrim
      .over(view::Live::Is(true))
      .points(view::Live::Is(true))
      .ground(view::Live::By(fn() {
        if lg::is_dark() { 0x05070C80L } else { 0x0F172A38L }
      }))
    })

    let modal_w = fn() -> Double {
      let (vw, _) = overlay_window_size(root)
      let w = vw - 24.0
      if w > 600.0 { 600.0 } else if w < 280.0 { 280.0 } else { w }
    }
    let modal_h = fn() -> Double {
      let (_, vh) = overlay_window_size(root)
      let h = vh - 40.0
      if h > 680.0 { 680.0 } else if h < 240.0 { 240.0 } else { h }
    }

    let _ = layer.box(fn(anchor : view::View) -> Unit {
      let _ = anchor.width(view::Live::By(fn() { Some(modal_w()) }))
      let _ = headless::dialog(
        anchor,
        fn() { "Keyboard Shortcuts" },
        props.open,
        props.on_close,
        fn(dlg : view::View, _d : headless::Dialog) -> Unit {
          let _ = dlg.width(view::Live::By(fn() { Some(modal_w()) }))
          let _ = lg::liquid_dialog_shell_node(dlg, fn(shell : view::View) -> Unit {
            let _ = shell
            .width(view::Live::By(fn() { Some(modal_w()) }))
            .max_height(view::Live::By(fn() { Some(modal_h()) }))
            .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
            .gap(view::Live::Is(12.0))
            .presses(view::Live::Is(true))
            .on_press(fn() { () })

            // Header
            let _ = shell.box(fn(hdr : view::View) -> Unit {
              let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0)).rigid()
              let _ = shell_icon(hdr, ICON_COMMAND, size=15.0, color_by=fn() { lg::surface().accent })
              let _ = hdr.box(fn(tw : view::View) -> Unit {
                let _ = tw.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
                let _ = <ui::Text in={tw} size={15.0} weight={600} color_by=>{lg::surface().ink} text="Keyboard Shortcuts" />
              })
              let _ = hdr.box(fn(esc : view::View) -> Unit {
                let _ = esc
                .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
                .radius(view::Live::Is(lg::r_chip))
                .rigid()
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                let _ = <ui::Text in={esc} size={10.5} weight={500} color_by=>{lg::surface().ink_secondary} text="Esc" />
              })
              build_close_icon_btn(hdr, "Close Shortcuts", props.on_close)
            })

            // Scrollable responsive body
            let _ = shell.box(fn(scroll_host : view::View) -> Unit {
              let _ = scroll_host.fill()
              let _ = ui::scroll_box(scroll_host, fn(sc : view::View) -> Unit {
                let _ = sc.gap(view::Live::Is(10.0))
                let is_wide = fn() -> Bool {
                  let (vw, _) = overlay_window_size(root)
                  vw >= 580.0
                }
                sc.show(is_wide, fn(two_col : view::View) -> Unit {
                  let _ = two_col.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Start))).gap(view::Live::Is(10.0))
                  let groups = (props.groups)()
                  let mid = (groups.length() + 1) / 2
                  let _ = two_col.box(fn(left : view::View) -> Unit {
                    let _ = left.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(10.0))
                    let mut i = 0
                    while i < mid && i < groups.length() {
                      render_shortcut_group_card(left, groups[i])
                      i += 1
                    }
                  })
                  let _ = two_col.box(fn(right : view::View) -> Unit {
                    let _ = right.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(10.0))
                    let mut i = mid
                    while i < groups.length() {
                      render_shortcut_group_card(right, groups[i])
                      i += 1
                    }
                  })
                })
                sc.show(fn() { !is_wide() }, fn(one_col : view::View) -> Unit {
                  let _ = one_col.gap(view::Live::Is(10.0))
                  let groups = (props.groups)()
                  let mut i = 0
                  while i < groups.length() {
                    render_shortcut_group_card(one_col, groups[i])
                    i += 1
                  }
                })
              })
            })
          })
        },
        modal=true,
        close_on_escape=true,
        close_on_outside=true,
      )
    })
  })
}
