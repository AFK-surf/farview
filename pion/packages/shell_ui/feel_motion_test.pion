///| Interaction and element motion in the sidebar and the frame (feel audit, group g3): a folder opening and
///| closing, a tab closed by the pointer, the tab hover preview's dwell, the active tab kept in sight, the sidebar
///| shown and hidden, Peek closing, the page-load line, Space dots, press feedback. Each is sampled mid-way and at
///| rest on the Tester clock; keyboard paths, what is true as built, and reduced motion stay instant where DESIGN.md
///| says so. `fm_hit_faults` scans a region for press targets under 32pt.

import "lg"
import "signals"
import "ui"
import "view"

fn fm_tree(ctrl : ShellController, width~ : Double = 1280.0, hooks~ : Option[ShellHostHooks] = None) -> ui::Tester {
  ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
        hooks=hooks,
      )
    },
    width=width,
    height=800.0,
    theme=lg::ui_theme,
  )
}

fn fm_get(t : ui::Tester, name : String) -> Option[view::Drawn] {
  t.get(name)
}

fn fm_y(t : ui::Tester, name : String) -> Double {
  match t.get(name) {
    Some(d) => d.y
    None => -1.0
  }
}

fn fm_x(t : ui::Tester, name : String) -> Double {
  match t.get(name) {
    Some(d) => d.x
    None => -1.0
  }
}

fn fm_alpha(t : ui::Tester, name : String) -> Double {
  match t.get(name) {
    Some(d) => d.alpha
    None => -1.0
  }
}

///| The drawn opacity of the leaving docked sidebar (hidden from what is read out as it leaves): the node at the
///| window's left edge as wide as a docked sidebar.
fn fm_leaving_alpha(t : ui::Tester) -> Double {
  let mut a = -1.0
  for d in t.drawn() {
    if a < 0.0 && d.x <= SP_0 && d.x > -SP_16 && d.y == SP_0 && d.w >= SP_160 && d.w <= SP_160 + SP_96 && d.h == 800.0 {
      a = d.alpha
    }
  }
  a
}

fn fm_hover(t : ui::Tester, name : String) -> Unit {
  match t.get(name) {
    Some(d) => t.move_to(d.x + d.w * 0.5, d.y + d.h * 0.5)
    None => ()
  }
}

///| Press targets drawn inside `(x0, y0)..(x1, y1)` (seen, taking presses) smaller than 32pt across either way:
///| each a line naming it and its size. What a press does there must be as big as the shell's hit rule.
fn fm_hit_faults(x0 : Double, y0 : Double, x1 : Double, y1 : Double) -> Array[String] {
  let tree = match ui::view_tree() {
    Some(tr) => tr
    None => return ["no tree"]
  }
  let out : Array[String] = []
  for e in tree.drawn_held() {
    let (d, _, _) = e
    if d.alpha > 0.02 && tree.presses_do(d.id) && tree.takes_presses(d.id) &&
    d.x >= x0 && d.y >= y0 && d.x + d.w <= x1 && d.y + d.h <= y1 {
      if d.w < SP_32 - 0.5 || d.h < SP_32 - 0.5 {
        let name = match tree.said_of(d.id) {
          Some(s) => s.label
          None => "node"
        }
        out.push("\{name} \{d.w}x\{d.h} at (\{d.x}, \{d.y})")
      }
    }
  }
  out
}

test "feel: every press target in the sidebar and the address field is at least 32pt" {
  ui::set_reduced_motion(Some(false))
  let t = fm_tree(make_demo_controller(dark=false))
  t.frame(ms=16.0)
  // (the docked sidebar: its top row, the address field and its buttons, favorites, the Space bar, tab rows)
  let faults = fm_hit_faults(SP_0, SP_0, SP_160 + SP_80 + SP_8, 800.0)
  debug_assert(faults.length() == 0, "press targets under 32pt: " + faults.join("; "))
  // (a hovered tab row's close button too)
  fm_hover(t, "Groove Salad — SomaFM")
  t.frame(ms=200.0)
  let hovered = fm_hit_faults(SP_0, SP_0, SP_160 + SP_80 + SP_8, 800.0)
  debug_assert(hovered.length() == 0, "with a row hovered: " + hovered.join("; "))
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: a folder opens and closes down the column, the rows below following, the chevron turning" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let open_y = fm_y(t, "WPT Dashboard: css")
  t.press("Research")
  t.frame(ms=16.0)
  t.frame(ms=32.0)
  let mid = fm_y(t, "WPT Dashboard: css")
  t.frame(ms=400.0)
  let closed_y = fm_y(t, "WPT Dashboard: css")
  debug_assert(closed_y < open_y - SP_32, "closed: the row below moved up by the folder's children (\{open_y} -> \{closed_y})")
  debug_assert(mid < open_y - 1.0 && mid > closed_y + 1.0, "closing at 48ms: the row below is between (\{mid})")
  debug_assert(t.get("Designing for Reading").is_none(), "closed: the children are gone")
  t.press("Research")
  t.frame(ms=16.0)
  t.frame(ms=32.0)
  let mid2 = fm_y(t, "WPT Dashboard: css")
  debug_assert(mid2 > closed_y + 1.0 && mid2 < open_y - 1.0, "opening at 48ms: between (\{mid2})")
  let child_a = fm_alpha(t, "Designing for Reading")
  debug_assert(child_a > 0.0 && child_a < 1.0, "opening: the children fade in with the height (alpha \{child_a})")
  t.frame(ms=400.0)
  debug_assert(fm_y(t, "WPT Dashboard: css") == open_y, "open again: where it was")
  debug_assert(fm_alpha(t, "Designing for Reading") == 1.0, "open: children at rest")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: a folder synced closed by the host (not a person's act) and under reduced motion changes at once" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let open_y = fm_y(t, "WPT Dashboard: css")
  ctrl.dispatch(ShellIntent::ToggleFolder("research"))
  t.frame(ms=16.0)
  debug_assert(fm_y(t, "WPT Dashboard: css") < open_y - SP_32, "host sync: at once")
  t.dispose()
  ui::set_reduced_motion(Some(true))
  let ctrl2 = make_demo_controller(dark=false)
  let t2 = fm_tree(ctrl2)
  t2.frame(ms=16.0)
  t2.press("Research")
  t2.frame(ms=16.0)
  debug_assert(fm_y(t2, "WPT Dashboard: css") < open_y - SP_32, "reduced motion: the rows move at once (\{fm_y(t2, "WPT Dashboard: css")} vs \{open_y})")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "feel: a tab closed by its X closes its way, the rows below follow; closed from the keyboard, at once" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let y0 = fm_y(t, "WPT Dashboard: css")
  fm_hover(t, "Groove Salad — SomaFM")
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  t.press("Close Groove Salad — SomaFM")
  t.frame(ms=16.0)
  t.frame(ms=32.0)
  let mid = fm_y(t, "WPT Dashboard: css")
  t.frame(ms=400.0)
  let y1 = fm_y(t, "WPT Dashboard: css")
  debug_assert(y1 < y0 - SP_24, "the row below took the closed row's place (\{y0} -> \{y1})")
  debug_assert(mid < y0 - 1.0 && mid > y1 + 1.0, "at 48ms the row below is on its way (\{mid})")
  t.dispose()

  let ctrl2 = make_demo_controller(dark=false)
  let t2 = fm_tree(ctrl2)
  t2.frame(ms=16.0)
  ctrl2.dispatch(ShellIntent::CloseTab("t3"))
  t2.frame(ms=16.0)
  debug_assert(fm_y(t2, "WPT Dashboard: css") == y1, "a close not told as a person's act (Cmd+W, host sync): at once")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "feel: the tab hover preview waits TAB_PREVIEW_DELAY_MS of rest, then the next opens at once; a press closes it" {
  ui::set_reduced_motion(Some(false))
  let log : signals::Ref[Array[String]] = signals::ref_new([])
  let hooks = ShellHostHooks::{
    ..ShellHostHooks::empty(),
    on_tab_hover: Some(fn(id : String, _y : Double, entered : Bool) -> Unit {
      log.v.push((if entered { "open " } else { "close " }) + id)
    }),
  }
  tab_hover_owner.v = ""
  tab_hover_gone_at.v = -1.0e9
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl, hooks=Some(hooks))
  t.frame(ms=16.0)
  fm_hover(t, "Groove Salad — SomaFM")
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(log.v.length() == 0, "crossing a row (200ms): no card (\{log.v.join(",")})")
  t.frame(ms=400.0)
  debug_assert(log.v.length() == 1 && log.v[0].starts_with("open "), "resting past the dwell: one open (\{log.v.join(",")})")
  // (warm: the next row's card opens at once)
  fm_hover(t, "WPT Dashboard: css")
  t.frame(ms=16.0)
  debug_assert(log.v.length() >= 2 && log.v[log.v.length() - 1].starts_with("open "), "warm: the next opens at once (\{log.v.join(",")})")
  // (a press on the row closes it)
  t.press("WPT Dashboard: css")
  t.frame(ms=16.0)
  debug_assert(log.v[log.v.length() - 1].starts_with("close "), "a press closes the card (\{log.v.join(",")})")
  t.dispose()

  // Crossing rows quickly never opens one.
  let log2 : signals::Ref[Array[String]] = signals::ref_new([])
  let hooks2 = ShellHostHooks::{
    ..ShellHostHooks::empty(),
    on_tab_hover: Some(fn(id : String, _y : Double, entered : Bool) -> Unit {
      if entered {
        log2.v.push(id)
      }
    }),
  }
  tab_hover_owner.v = ""
  tab_hover_gone_at.v = -1.0e9
  let t2 = fm_tree(make_demo_controller(dark=false), hooks=Some(hooks2))
  t2.frame(ms=16.0)
  for name in ["Groove Salad — SomaFM", "WPT Dashboard: css", "Groove Salad — SomaFM"] {
    fm_hover(t2, name)
    t2.frame(ms=150.0)
  }
  t2.move_to(SP_160 * 4.0, SP_160 * 2.0)
  t2.frame(ms=800.0)
  debug_assert(log2.v.length() == 0, "crossing rows at 150ms each: no card (\{log2.v.join(",")})")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "feel: a tab made active from the keyboard out of sight is brought into the sidebar's sight" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let base = ctrl.tabs.untracked()
  let many : Array[ShellTabItem] = []
  for tb in base {
    many.push({ ..tb, active: false })
  }
  let mut i = 0
  while i < 30 {
    many.push(ShellTabItem::{
      id: "x\{i}",
      title: "Extra tab \{i}",
      url: "https://example.com/\{i}",
      folder_id: "",
      space_id: "work",
      pinned: false,
      active: false,
      playing_audio: false,
      muted: false,
    })
    i += 1
  }
  ctrl.tabs.set(many)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let far = fm_y(t, "Extra tab 29")
  debug_assert(far < 0.0 || far > 800.0, "the last row starts out of sight (\{far})")
  ctrl.dispatch(ShellIntent::SelectTab("x29"))
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  let y = fm_y(t, "Extra tab 29")
  debug_assert(y > 0.0 && y + SHELL_ROW_H <= 800.0, "after the switch the row is in sight (\{y})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: hiding and showing the docked sidebar lays the page out at once and fades the sidebar" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let docked_x = fm_x(t, "Primary Pane")
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  let wide_x = fm_x(t, "Primary Pane")
  debug_assert(wide_x < docked_x - SP_128, "the page takes the room in the first frame (\{docked_x} -> \{wide_x})")
  t.frame(ms=24.0)
  let sb = fm_leaving_alpha(t)
  debug_assert(sb > 0.0 && sb < 1.0, "the sidebar fades out over MO_POP_OUT_MS (alpha \{sb})")
  t.frame(ms=200.0)
  debug_assert(t.get("Sidebar").is_none(), "gone after its exit")
  debug_assert(fm_x(t, "Primary Pane") == wide_x, "the page never moved after the first frame")
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  debug_assert(fm_x(t, "Primary Pane") == docked_x, "back: the page in its place at once")
  t.frame(ms=24.0)
  let sb2 = fm_alpha(t, "Sidebar")
  debug_assert(sb2 > 0.0 && sb2 < 1.0, "the sidebar fades in (alpha \{sb2})")
  t.frame(ms=200.0)
  debug_assert(fm_alpha(t, "Sidebar") == 1.0, "at rest")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: closing Peek plays its way out over MO_POP_OUT_MS; closing Split View stays instant" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OpenPeek("https://developer.mozilla.org/en-US/docs/Web/CSS/grid"))
  t.frame(ms=400.0)
  let mid_y = fn() -> Double {
    match t.get("Secondary Pane") {
      Some(d) => d.y + d.h / 2.0
      None => -1.0
    }
  }
  let peek_y = mid_y()
  t.press("Close Peek")
  t.frame(ms=16.0)
  t.frame(ms=34.0)
  let a50 = fm_alpha(t, "Secondary Pane")
  debug_assert(a50 > 0.0 && a50 < 1.0, "Peek at 50ms: fading out (alpha \{a50})")
  debug_assert((mid_y() - peek_y).abs() < 0.5, "it keeps the Peek geometry while it leaves (\{peek_y} vs \{mid_y()})")
  t.frame(ms=100.0)
  debug_assert(t.get("Secondary Pane").is_none(), "gone by 150ms")
  t.dispose()

  let ctrl2 = make_demo_controller(dark=false, split=true)
  let t2 = fm_tree(ctrl2)
  t2.frame(ms=16.0)
  ctrl2.dispatch(ShellIntent::CloseSecondaryPane)
  t2.frame(ms=16.0)
  debug_assert(t2.get("Secondary Pane").is_none(), "Split View closes at once")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "feel: the page-load line never moves the page, waits LOAD_BAR_DELAY_MS, and fills before it fades" {
  ui::set_reduced_motion(Some(false))
  let loading = signals::signal(false)
  let hooks = ShellHostHooks::{
    ..ShellHostHooks::empty(),
    page_loading: Some(fn(p : PaneId) -> Bool { (p is PaneId::Primary) && loading.get() }),
  }
  let t = fm_tree(make_demo_controller(dark=false), hooks=Some(hooks))
  t.frame(ms=16.0)
  let rect = fn() -> String {
    match t.get("Primary Pane") {
      Some(d) => "\{d.x},\{d.y},\{d.w},\{d.h}"
      None => "-"
    }
  }
  let top = fm_y(t, "Primary Pane")
  let idle = rect()
  loading.set(true)
  t.frame(ms=16.0)
  t.frame(ms=100.0)
  debug_assert(t.get("Loading").is_none(), "a load under LOAD_BAR_DELAY_MS shows nothing")
  debug_assert(rect() == idle, "loading: the page has not moved")
  t.frame(ms=100.0)
  debug_assert(t.get("Loading").is_some(), "past the delay the line shows")
  t.frame(ms=300.0)
  match t.get("Loading") {
    Some(d) => {
      debug_assert(d.h == SP_2 && d.y == top, "a 2pt line on the card's top edge (\{d.y}, \{d.h})")
      debug_assert(d.alpha == 1.0, "faded in")
    }
    None => debug_assert(false, "line shown")
  }
  debug_assert(rect() == idle, "while the line shows the page is where it was")
  loading.set(false)
  t.frame(ms=16.0)
  t.frame(ms=40.0)
  debug_assert(fm_alpha(t, "Loading") == 1.0, "ending: it fills first, still opaque (MO_KEY_MS)")
  t.frame(ms=300.0)
  debug_assert(t.get("Loading").is_none(), "then gone")
  debug_assert(rect() == idle, "after loading the page is where it was")
  // (a fast load never shows it)
  loading.set(true)
  t.frame(ms=60.0)
  loading.set(false)
  t.frame(ms=300.0)
  debug_assert(t.get("Loading").is_none(), "a fast load never flashes the line")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: a Space dot's selected wash eases with the frame tint instead of snapping" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let sp = ctrl.spaces.untracked()
  debug_assert(sp.length() >= 2, "two Spaces in the demo")
  let other = sp[1]
  let name = "Space " + other.name
  // the dot's face: the drawn node right under the button with a round 24pt ground
  let face_ground = fn() -> Int64 {
    match t.get(name) {
      Some(b) => {
        let mut g = 0L
        for d in t.drawn() {
          if d.w == SP_24 && d.h == SP_24 && d.x >= b.x && d.x + d.w <= b.x + b.w && d.y >= b.y && d.y + d.h <= b.y + b.h {
            g = d.ground
          }
        }
        g
      }
      None => -1L
    }
  }
  let before = face_ground()
  ctrl.dispatch(ShellIntent::SelectSpace(other.id))
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let mid = face_ground()
  t.frame(ms=300.0)
  let after = face_ground()
  debug_assert(before != after, "the chosen Space's dot gets the selected wash (\{before} -> \{after})")
  debug_assert(mid != before && mid != after, "at 40ms the wash is between the two (\{mid})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: shell icon faces give press feedback (shell_icon_face_btn sinks to 0.97)" {
  ui::set_reduced_motion(Some(false))
  let t = ui::Tester::tree(
    fn(root) {
      let _ = shell_icon_face_btn(root, fn() { "Close Panel" }, fn() { () }, fn() { ICON_CLOSE })
    },
    width=200.0,
    height=200.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  let d = match t.get("Close Panel") {
    Some(d) => d
    None => {
      debug_assert(false, "button drawn")
      return
    }
  }
  debug_assert(d.w == SP_32 && d.h == SP_32, "a 32pt hit (\{d.w}x\{d.h})")
  t.move_to(d.x + d.w * 0.5, d.y + d.h * 0.5)
  t.press_at(d.x + d.w * 0.5, d.y + d.h * 0.5)
  t.frame(ms=16.0)
  t.frame(ms=60.0)
  let mid = match t.get("Close Panel") {
    Some(p) => p.w
    None => -1.0
  }
  debug_assert(mid < SP_32 && mid > SP_32 * 0.96, "pressed: sinking toward 0.97 (\{mid})")
  t.release(d.x + d.w * 0.5, d.y + d.h * 0.5)
  t.frame(ms=200.0)
  let rest = match t.get("Close Panel") {
    Some(p) => p.w
    None => -1.0
  }
  debug_assert(rest == SP_32, "released: back at rest (\{rest})")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "feel: the address palette shows one highlight: the pointer moving onto a row selects it without committing" {
  let ctrl = make_demo_controller(dark=false, omnibox_open=true)
  let st = ctrl.omnibox_suggest.untracked()
  if st.items.length() >= 3 {
    ctrl.dispatch(ShellIntent::OmniboxMoveSelection(1))
    ctrl.dispatch(ShellIntent::OmniboxHoverIndex(2))
    let now = ctrl.omnibox_suggest.untracked()
    debug_assert(now.selected == 2, "hover moved the selection (\{now.selected})")
    debug_assert(now.open, "nothing committed: the palette is still open")
  }
}

fn fm_tab(ctrl : ShellController, id : String) -> Option[ShellTabItem] {
  for t in ctrl.tabs.untracked() {
    if t.id == id {
      return Some(t)
    }
  }
  None
}

fn fm_today_ids(ctrl : ShellController) -> String {
  let out : Array[String] = []
  for t in ctrl.tabs.untracked() {
    if t.folder_id == "" && (t.space_id == "work" || t.space_id == "") {
      out.push(t.id)
    }
  }
  out.join(",")
}

test "feel: dragging a tab row drops it into a folder or next to another row; a press without a move still selects" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  let wpt = match t.get("WPT Dashboard: css") {
    Some(d) => d
    None => {
      debug_assert(false, "WPT row")
      return
    }
  }
  let folder = match t.get("Research") {
    Some(d) => d
    None => {
      debug_assert(false, "Research row")
      return
    }
  }
  // (a press that does not move selects the tab, as ever)
  t.press_at(wpt.x + SP_40, wpt.y + wpt.h * 0.5)
  t.release(wpt.x + SP_40 + SP_2, wpt.y + wpt.h * 0.5)
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked().starts_with("select_tab") || (match fm_tab(ctrl, "t4") { Some(x) => x.active; None => false }), "a 2pt wobble is a press: \{ctrl.last_intent.untracked()}")
  // (dragged onto the folder's row: into the folder)
  let x0 = wpt.x + SP_40
  let y0 = wpt.y + wpt.h * 0.5
  t.press_at(x0, y0)
  t.move_to(x0, y0 - SP_8)
  t.frame(ms=16.0)
  t.move_to(x0, folder.y + folder.h * 0.5)
  t.frame(ms=16.0)
  t.release(x0, folder.y + folder.h * 0.5)
  t.frame(ms=400.0)
  match fm_tab(ctrl, "t4") {
    Some(x) => debug_assert(x.folder_id == "research", "dropped into Research (folder \{x.folder_id})")
    None => debug_assert(false, "t4 still there")
  }
  t.dispose()

  // Dragged above another Today row: the order changes, nothing else does.
  let ctrl2 = make_demo_controller(dark=false)
  let t2 = fm_tree(ctrl2)
  t2.frame(ms=16.0)
  let before = fm_today_ids(ctrl2)
  match (t2.get("WPT Dashboard: css"), t2.get("Groove Salad — SomaFM")) {
    (Some(w), Some(g)) => {
      let x = w.x + SP_40
      t2.press_at(x, w.y + w.h * 0.5)
      t2.move_to(x, w.y + w.h * 0.5 - SP_8)
      t2.frame(ms=16.0)
      t2.move_to(x, g.y + SP_4)
      t2.frame(ms=16.0)
      debug_assert(t2.get("WPT Dashboard: css").is_some(), "the dragged row is still drawn")
      t2.release(x, g.y + SP_4)
      t2.frame(ms=400.0)
    }
    _ => debug_assert(false, "rows")
  }
  let after = fm_today_ids(ctrl2)
  debug_assert(after != before && after.length() == before.length(), "reordered: \{before} -> \{after}")
  let wi = after.split(",")
  let mut iw = -1
  let mut ig = -1
  let mut k = 0
  while k < wi.length() {
    if wi[k] == "t4" {
      iw = k
    }
    if wi[k] == "t3" {
      ig = k
    }
    k += 1
  }
  debug_assert(iw >= 0 && iw + 1 == ig, "WPT now right before Groove Salad (\{after})")
  ui::set_reduced_motion(None)
  t2.dispose()
}

test "feel: the folder chevron eases between right and down with the folder (never swapped in one frame)" {
  ui::set_reduced_motion(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let t = fm_tree(ctrl)
  t.frame(ms=16.0)
  // (the chevrons: 12pt glyphs at the folder row's start)
  let chevrons = fn() -> Array[Double] {
    let out : Array[Double] = []
    match t.get("Research") {
      Some(r) => {
        for d in t.drawn() {
          if d.w == IC_SM && d.h == IC_SM && d.x < r.x + SP_32 && d.y >= r.y && d.y + d.h <= r.y + r.h {
            out.push(d.alpha)
          }
        }
      }
      None => ()
    }
    out
  }
  let open_a = chevrons()
  t.press("Research")
  t.frame(ms=16.0)
  t.frame(ms=24.0)
  let mid = chevrons()
  t.frame(ms=300.0)
  let closed = chevrons()
  debug_assert(open_a.length() == 2 && closed.length() == 2, "two chevrons stacked (\{open_a.length()})")
  let mut mid_between = false
  for a in mid {
    if a > 0.0 && a < 1.0 {
      mid_between = true
    }
  }
  debug_assert(mid_between, "at 40ms the chevrons are cross-fading (\{mid.length()})")
  debug_assert(open_a[0] != closed[0] && open_a[1] != closed[1], "right and down trade places ")
  ui::set_reduced_motion(None)
  t.dispose()
}
