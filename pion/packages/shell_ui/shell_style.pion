///| Farview Shell 3 design tokens and small shared pieces.
///|
///| The window frame takes the active Space's color (a quiet tint of it, never the raw accent), the sidebar
///| sits directly on that frame with no box of its own, and the page is the one solid card in the window.
///| Everything on the frame (tab rows, the address field, favorites) is a translucent white wash over the tint,
///| so a Space change recolors the whole frame at once.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

///| Spacing scale (pt). Every padding, margin, gap, size and corner radius in the shell is one of these.
pub let SP_0 : Double = 0.0
pub let SP_2 : Double = 2.0
pub let SP_4 : Double = 4.0
pub let SP_6 : Double = 6.0
pub let SP_8 : Double = 8.0
pub let SP_10 : Double = 10.0
pub let SP_12 : Double = 12.0
pub let SP_16 : Double = 16.0
pub let SP_20 : Double = 20.0
pub let SP_24 : Double = 24.0
pub let SP_32 : Double = 32.0
pub let SP_40 : Double = 40.0
pub let SP_48 : Double = 48.0
pub let SP_64 : Double = 64.0
pub let SP_80 : Double = 80.0
pub let SP_96 : Double = 96.0
pub let SP_128 : Double = 128.0
pub let SP_160 : Double = 160.0

///| Type scale (pt): caption, footnote, body, callout, headline, title 3, title 1.
pub let TX_CAPTION : Double = 11.0
pub let TX_FOOTNOTE : Double = 12.0
pub let TX_BODY : Double = 13.0
pub let TX_CALLOUT : Double = 15.0
pub let TX_HEADLINE : Double = 17.0
pub let TX_TITLE3 : Double = 22.0
pub let TX_TITLE1 : Double = 28.0

///| Icon glyph sizes (pt).
pub let IC_SM : Double = 12.0
pub let IC_MD : Double = 16.0
pub let IC_LG : Double = 20.0

///| Gap between the window edge, the sidebar and the page card.
pub let SHELL_FRAME_GAP : Double = SP_8
///| Height of the sidebar's top row (traffic lights + navigation buttons) and of the compact toolbar.
pub let SHELL_TOP_ROW_H : Double = SP_40
///| Address field height (sidebar and compact toolbar).
pub let SHELL_ADDRESS_H : Double = SP_32
///| Sidebar row height (tabs, folders, New Tab).
pub let SHELL_ROW_H : Double = SP_32
///| Command palette width (Address Bar while editing): 4 x 160.
pub let SHELL_PALETTE_W : Double = SP_160 * 4.0

fn mix_channel(a : Int64, b : Int64, shift : Int, t : Double) -> Int64 {
  let ca = ((a >> shift) & 0xFFL).to_double()
  let cb = ((b >> shift) & 0xFFL).to_double()
  let v = ca + (cb - ca) * t
  let r = (v + 0.5).to_int64()
  (if r < 0L { 0L } else if r > 255L { 255L } else { r }) << shift
}

///| Mixes two opaque `0xRRGGBBAA` colors (`t = 0` gives `a`), keeping `a`'s alpha.
pub fn shell_mix(a : Int64, b : Int64, t : Double) -> Int64 {
  mix_channel(a, b, 24, t) | mix_channel(a, b, 16, t) | mix_channel(a, b, 8, t) | (a & 0xFFL)
}

///| The window frame color for a Space accent: a light paper or deep graphite carrying a little of the accent.
pub fn shell_frame_tint(accent : Int64, dark : Bool) -> Int64 {
  if dark {
    shell_mix(0x1A1B1EFFL, accent, 0.10)
  } else {
    shell_mix(0xEDEDEFFFL, accent, 0.11)
  }
}

///| Active Space accent (falls back to system blue).
pub fn shell_space_accent(model : ShellModel) -> Int64 {
  let sid = model.active_space_id()
  let list = model.spaces()
  let mut i = 0
  while i < list.length() {
    if list[i].id == sid {
      return list[i].accent_rgba
    }
    i += 1
  }
  0x007AFFFFL
}

///| Frame color of the active Space.
pub fn shell_frame_color(model : ShellModel) -> Int64 {
  shell_frame_tint(shell_space_accent(model), model.dark())
}

///| Wash for the selected sidebar row and the address field: white over the tint.
pub fn shell_wash_strong(dark : Bool) -> Int64 {
  if dark { 0xFFFFFF1CL } else { 0xFFFFFFC8L }
}

///| Wash for resting translucent surfaces on the frame (favorites, address field at rest).
pub fn shell_wash(dark : Bool) -> Int64 {
  if dark { 0xFFFFFF12L } else { 0xFFFFFF80L }
}

///| Hover wash for rows and icon buttons on the frame.
pub fn shell_wash_hover(dark : Bool) -> Int64 {
  if dark { 0xFFFFFF0FL } else { 0xFFFFFF59L }
}

///| Lift shadow for the selected row (one soft layer, never on hover).
pub fn shell_row_lift(dark : Bool) -> (Double, Double, Int64) {
  if dark { (SP_4, SP_2, 0x00000040L) } else { (SP_4, SP_2, 0x00000014L) }
}

///| Shadow of the page card over the frame.
pub fn shell_card_shadow(dark : Bool) -> (Double, Double, Int64) {
  if dark { (SP_20, SP_4, 0x00000070L) } else { (SP_16, SP_2, 0x0000001CL) }
}

///| Ink on the frame (secondary labels, idle icons): a touch more contrast than `ink_secondary` over the tint.
pub fn shell_frame_ink_secondary(dark : Bool) -> Int64 {
  if dark { 0xC7C7CCFFL } else { 0x55565BFFL }
}

///| Tertiary ink on the frame (section labels, path tails).
pub fn shell_frame_ink_tertiary(dark : Bool) -> Int64 {
  if dark { 0x8E8E93FFL } else { 0x7C7D82FFL }
}

///| The fixed set of tile colors (Apple system palette) used for glyph tiles and site monograms.
pub fn shell_tile_palette() -> Array[Int64] {
  [
    0x007AFFFFL, // blue
    0x5856D6FFL, // indigo
    0xAF52DEFFL, // purple
    0xFF2D55FFL, // pink
    0xFF3B30FFL, // red
    0xFF9500FFL, // orange
    0x34C759FFL, // green
    0x30B0C7FFL, // teal
    0x8E8E93FFL, // gray
  ]
}

///| Stable tile color for a site host (same host, same color, every launch).
pub fn shell_site_color(host : String) -> Int64 {
  let pal = shell_tile_palette()
  if host == "" {
    return pal[pal.length() - 1]
  }
  let mut h = 5381
  let mut i = 0
  while i < host.length() {
    h = ((h * 33) + host.code_unit_at(i).to_int()) & 0x7FFFFFFF
    i += 1
  }
  pal[h % (pal.length() - 1)]
}

///| One-letter monogram for a host (`www.` dropped).
pub fn shell_site_monogram(host : String) -> String {
  let h = if host.starts_with("www.") { host.slice(4, host.length()) } else { host }
  if h.length() == 0 {
    return "·"
  }
  let c = h.code_unit_at(0).to_int()
  if c >= 0x61 && c <= 0x7A {
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let i = c - 0x61
    upper.slice(i, i + 1)
  } else {
    h.slice(0, 1)
  }
}

///| Corner radius of a tile of edge `size` (a quarter of the edge, snapped to the spacing scale).
pub fn shell_tile_radius(size : Double) -> Double {
  if size <= SP_16 { SP_4 } else if size <= SP_24 { SP_6 } else if size <= SP_32 { SP_8 } else { SP_12 }
}

///| Glyph size drawn inside a tile of edge `size`.
pub fn shell_tile_glyph(size : Double) -> Double {
  if size <= SP_20 { IC_SM } else if size <= SP_32 { IC_MD } else { IC_LG }
}

///| Monogram letter size inside a tile of edge `size`.
pub fn shell_tile_letter(size : Double) -> Double {
  if size <= SP_16 { TX_CAPTION } else if size <= SP_24 { TX_FOOTNOTE } else { TX_CALLOUT }
}

///| A rounded-square glyph tile: white vector glyph on a solid system color (the settings-icon idiom).
///| `size` is the tile edge; the glyph is drawn at 58% of it.
pub fn shell_glyph_tile(
  parent : view::View,
  icon_name : String,
  color_by : () -> Int64,
  size~ : Double = SP_24,
) -> view::View {
  parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(color_by))
    .points(view::Live::Is(false))
    .center()
    let _ = shell_icon(tile, icon_name, size=shell_tile_glyph(size), color_by=fn() { 0xFFFFFFFFL })
  })
}

///| A site monogram tile (stands in for a favicon until the host sends one).
pub fn shell_site_tile(parent : view::View, host_by : () -> String, size~ : Double = SP_16) -> view::View {
  parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(fn() { shell_site_color(host_by()) }))
    .points(view::Live::Is(false))
    .center()
    <ui::Text
      in={tile}
      size={shell_tile_letter(size)}
      weight={600}
      color_by=>{0xFFFFFFFFL}
      text_by=>{shell_site_monogram(host_by())}
    />
  })
}

///| A flat icon button on the frame (sidebar top row, compact toolbar): no capsule at rest, a soft wash on hover,
///| eased in and out. 32pt square face inside a 32 x 40 hit target.
pub fn shell_frame_icon_btn(
  parent : view::View,
  model : ShellModel,
  label : String,
  icon_name : String,
  on_press : () -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  on_menu~ : Option[(Double) -> Unit] = None,
  capture_ref? : signals::Ref[Option[view::View]],
) -> view::View {
  let v = headless::button(
    parent,
    fn() { label },
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_40)))
      .shrink(view::Live::Is(0.0))
      .center()
      let _ = b.box(fn(face : view::View) -> Unit {
        let _ = face
        .width(view::Live::Is(Some(SP_32)))
        .height(view::Live::Is(Some(SP_32)))
        .radius(view::Live::Is(SP_8))
        .points(view::Live::Is(false))
        .center()
        .ground(view::Live::By(fn() {
          if active() {
            shell_wash_strong(model.dark())
          } else {
            lg::alpha(shell_wash_hover(model.dark()), hover_t())
          }
        }))
        let _ = shell_icon(
          face,
          icon_name,
          size=IC_MD,
          color_by=fn() {
            if disabled() {
              lg::alpha(shell_frame_ink_tertiary(model.dark()), 0.55)
            } else if active() {
              lg::surface().ink
            } else {
              shell_frame_ink_secondary(model.dark())
            }
          },
        )
      })
    },
  )
  match on_menu {
    Some(cb) => {
      let _ = v.on_menu(fn(_m : view::Menu) -> Unit {
        let (bx, _, _, _) = v.placed_window_now()
        cb(bx)
      })
    }
    None => ()
  }
  match capture_ref {
    Some(r) => r.v = Some(v)
    None => ()
  }
  v
}

///| Splits a display URL into its host and the rest (`webkit.org`, `/blog/post`), scheme dropped.
pub fn shell_url_parts(url : String) -> (String, String) {
  let shown = proto::omnibox_safe_display_url(url)
  let mut s = shown
  if s.starts_with("https://") {
    s = s.slice(8, s.length())
  } else if s.starts_with("http://") {
    s = s.slice(7, s.length())
  }
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      break
    }
    i += 1
  }
  let host = s.slice(0, i)
  let rest = s.slice(i, s.length())
  if host.starts_with("www.") {
    (host.slice(4, host.length()), if rest == "/" { "" } else { rest })
  } else {
    (host, if rest == "/" { "" } else { rest })
  }
}
