///| Farview Shell 3 design tokens and small shared pieces.
///|
///| The window frame takes the active Space's color (a quiet tint of it, never the raw accent), the sidebar
///| sits directly on that frame with no box of its own, and the page is the one solid card in the window.
///| Everything on the frame (tab rows, the address field, favorites) is a translucent white wash over the tint,
///| so a Space change recolors the whole frame at once.

import "headless"
import "lg"
import "motion"
import "proto"
import "signals"
import "ui"
import "view"

///| Spacing scale (pt). Every padding, margin, gap, size and corner radius in the shell is one of these.
pub let SP_0 : Double = 0.0
pub let SP_2 : Double = 2.0
pub let SP_4 : Double = 4.0
pub let SP_6 : Double = 6.0
pub let SP_8 : Double = 8.0
pub let SP_10 : Double = 10.0
pub let SP_12 : Double = 12.0
pub let SP_16 : Double = 16.0
pub let SP_20 : Double = 20.0
pub let SP_24 : Double = 24.0
pub let SP_32 : Double = 32.0
pub let SP_40 : Double = 40.0
pub let SP_48 : Double = 48.0
pub let SP_64 : Double = 64.0
pub let SP_80 : Double = 80.0
pub let SP_96 : Double = 96.0
pub let SP_128 : Double = 128.0
pub let SP_160 : Double = 160.0

///| Type scale (pt): caption, footnote, body, callout, headline, title 3, title 1.
pub let TX_CAPTION : Double = 11.0
pub let TX_FOOTNOTE : Double = 12.0
pub let TX_BODY : Double = 13.0
pub let TX_CALLOUT : Double = 15.0
pub let TX_HEADLINE : Double = 17.0
pub let TX_TITLE3 : Double = 22.0
pub let TX_TITLE1 : Double = 28.0

///| Icon glyph sizes (pt).
pub let IC_SM : Double = 12.0
pub let IC_MD : Double = 16.0
pub let IC_LG : Double = 20.0

///| Gap between the window edge, the sidebar and the page card.
pub let SHELL_FRAME_GAP : Double = SP_8
///| Height of the sidebar's top row (traffic lights + navigation buttons) and of the compact toolbar.
pub let SHELL_TOP_ROW_H : Double = SP_40
///| Address field height (sidebar and compact toolbar).
pub let SHELL_ADDRESS_H : Double = SP_32
///| Sidebar row height (tabs, folders, New Tab).
pub let SHELL_ROW_H : Double = SP_32
///| (Frame measures built from the tokens live here, after them: a file's globals are made in order, another
///| file's may be made before these tokens are.)
///| How far the split divider's drag target reaches past the 6pt gap over each card (24pt in all). Little over the
///| primary card, whose overlay scrollbar runs down its trailing edge (a drag there scrolls that page); the rest
///| over the secondary card's leading edge, where pages keep a margin.
pub let SHELL_SPLIT_HIT_LEAD : Double = SP_2
pub let SHELL_SPLIT_HIT_TRAIL : Double = SP_24 - proto::SPLIT_DIVIDER_WIDTH - SHELL_SPLIT_HIT_LEAD
///| The room a hovered tab keeps clear at its trailing edge for the close button (its 32pt less the row's own 6pt
///| trailing padding, plus the button's 2pt inset): the title's box ends at the button's leading edge.
pub let SHELL_TAB_CLOSE_ROOM : Double = SP_32 - SP_6 + SP_2
///| How far before its (hover-shortened) end a hovered tab's title fades to nothing: it is gone at the close
///| button's leading edge, never under the X.
pub let SHELL_TAB_TITLE_FADE : Double = SP_16
///| Command palette width (Address Bar while editing): 4 x 160.
pub let SHELL_PALETTE_W : Double = SP_160 * 4.0

fn mix_channel(a : Int64, b : Int64, shift : Int, t : Double) -> Int64 {
  let ca = ((a >> shift) & 0xFFL).to_double()
  let cb = ((b >> shift) & 0xFFL).to_double()
  let v = ca + (cb - ca) * t
  let r = (v + 0.5).to_int64()
  (if r < 0L { 0L } else if r > 255L { 255L } else { r }) << shift
}

///| Mixes two opaque `0xRRGGBBAA` colors (`t = 0` gives `a`), keeping `a`'s alpha.
pub fn shell_mix(a : Int64, b : Int64, t : Double) -> Int64 {
  mix_channel(a, b, 24, t) | mix_channel(a, b, 16, t) | mix_channel(a, b, 8, t) | (a & 0xFFL)
}

///| The window frame color for a Space accent: a light paper or deep graphite carrying a little of the accent.
pub fn shell_frame_tint(accent : Int64, dark : Bool) -> Int64 {
  if dark {
    shell_mix(0x1A1B1EFFL, accent, 0.10)
  } else {
    shell_mix(0xEDEDEFFFL, accent, 0.11)
  }
}

///| Whether shortcut labels use the macOS glyphs (`⌘T`) or the Linux/Windows words (`Ctrl+T`). Matches how the
///| app decodes keys (`proto::keys_are_macos`, the one test every decoding site uses), so a label never names a
///| chord that does nothing.
pub fn shell_keys_mac() -> Bool {
  proto::keys_are_macos(ui::keys_system())
}

///| Back and Forward as the platform's keys: `⌘[  ⌘]` on macOS, `Alt+Left  Alt+Right` elsewhere (Ctrl+[ / ] work
///| too, but Alt+arrows are what Linux and Windows browsers name).
pub fn shell_back_forward_label(is_mac : Bool) -> String {
  if is_mac { "⌘[  ⌘]" } else { "Alt+Left  Alt+Right" }
}

///| Active Space accent: its theme's first color (falls back to system blue).
pub fn shell_space_accent(model : ShellModel) -> Int64 {
  shell_space_theme(model).points[0].rgba
}

///| Frame color of the active Space: its theme's first stop (the whole frame for a one-color theme, the left edge
///| of a gradient; see `build_space_theme_ground`).
pub fn shell_frame_color(model : ShellModel) -> Int64 {
  shell_space_frame_base(model)
}

///| Wash for the selected sidebar row and raised surfaces: translucent white over the tint.
pub fn shell_wash_strong(dark : Bool) -> Int64 {
  if dark { 0xFFFFFF22L } else { 0xFFFFFFB8L }
}

///| Wash for resting translucent surfaces on the sidebar frame (favorites, address field at rest):
///| subtle black translucency so controls sit gently recessed into the tinted sidebar.
pub fn shell_wash(dark : Bool) -> Int64 {
  if dark { 0x00000033L } else { 0x00000012L }
}

///| The mark of an active Site Boost (a state worth seeing, so it has a color: the system purple Boosts use).
pub fn shell_boost_mark() -> Int64 {
  0xAF52DEFFL
}

///| Hover wash for rows and icon buttons on the frame.
pub fn shell_wash_hover(dark : Bool) -> Int64 {
  if dark { 0xFFFFFF18L } else { 0x00000010L }
}

///| Arc-style soft luminous Space-accent border ring for the active Favorite tile.
pub fn shell_favorite_active_ring(accent : Int64, dark : Bool) -> Int64 {
  let clean = (accent & 0xFFFFFF00L) | 0xFFL
  let tinted = if dark {
    shell_mix(clean, 0x8CC8FFFFL, 0.30)
  } else {
    shell_mix(clean, 0x6EB6FFFFL, 0.28)
  }
  lg::alpha(tinted, if dark { 0.72 } else { 0.82 })
}

///| Soft frosted veil behind Arc Peek and Little Arc overlays (recedes the page without turning muddy).
pub fn shell_peek_veil(dark : Bool) -> Int64 {
  if dark { 0x0A0B0FA8L } else { 0xEFF1F6B4L }
}

///| Warm coral tint for destructive close-button hover states (Arc Peek floating Close & tab close).
pub fn shell_close_hover_ink(dark : Bool) -> Int64 {
  if dark { 0xFF6B6BFFL } else { 0xD9383AFFL }
}

pub fn shell_close_hover_wash(dark : Bool) -> Int64 {
  if dark { 0xFF5A5A26L } else { 0xE5484D18L }
}

///| Lift shadow for the selected row (one soft layer, never on hover).
pub fn shell_row_lift(dark : Bool) -> (Double, Double, Int64) {
  if dark { (SP_4, SP_2, 0x00000040L) } else { (SP_4, SP_2, 0x00000014L) }
}

///| Shadow of the page card over the frame (light & crisp: ~0 4px 20px rgba(0,0,0,0.08..0.22), Gaussian sigma = 10pt).
pub fn shell_card_shadow(dark : Bool) -> (Double, Double, Int64) {
  if dark { (10.0, SP_4, 0x00000038L) } else { (10.0, SP_4, 0x00000014L) }
}

///| Ink on the frame (secondary labels, idle icons): a touch more contrast than `ink_secondary` over the tint.
pub fn shell_frame_ink_secondary(dark : Bool) -> Int64 {
  if dark { 0xC7C7CCFFL } else { 0x55565BFFL }
}

///| Tertiary ink on the frame (section labels, path tails).
pub fn shell_frame_ink_tertiary(dark : Bool) -> Int64 {
  if dark { 0x8E8E93FFL } else { 0x7C7D82FFL }
}

///| The accent as the color of words (a text button, a progress line, a link): deeper than `lg::surface().accent`
///| in light so 12-13pt text reads at 4.5:1 on the card and the canvas (0x0066CC is 5.6:1 on white; 0x007AFF only
///| 4.0:1). Fills, toggles, selection, icons and focus rings keep `lg::surface().accent`.
pub fn shell_accent_text() -> Int64 {
  if lg::is_dark() { 0x4DA3FFFFL } else { 0x0066CCFFL }
}

///| The positive (green) state as the color of words ("Live call"): 0x1E7B34 is 5.3:1 on white.
pub fn shell_positive_text() -> Int64 {
  if lg::is_dark() { 0x30D158FFL } else { 0x1E7B34FFL }
}

///| The fixed set of system colors behind site monograms (`shell_site_color`) and the few tiles whose color means
///| something (`shell_tint_tile`); glyph tiles themselves are monochrome.
pub fn shell_tile_palette() -> Array[Int64] {
  [
    0x007AFFFFL, // blue
    0x5856D6FFL, // indigo
    0xAF52DEFFL, // purple
    0xFF2D55FFL, // pink
    0xFF3B30FFL, // red
    0xFF9500FFL, // orange
    0x34C759FFL, // green
    0x30B0C7FFL, // teal
    0x8E8E93FFL, // gray
  ]
}

///| Stable tile color for a site host (same host, same color, every launch).
pub fn shell_site_color(host : String) -> Int64 {
  let pal = shell_tile_palette()
  if host == "" {
    return pal[pal.length() - 1]
  }
  let mut h = 5381
  let mut i = 0
  while i < host.length() {
    h = ((h * 33) + host.code_unit_at(i).to_int()) & 0x7FFFFFFF
    i += 1
  }
  pal[h % (pal.length() - 1)]
}

///| One-letter monogram for a host (`www.` dropped).
pub fn shell_site_monogram(host : String) -> String {
  let h = if host.starts_with("www.") { host.slice(4, host.length()) } else { host }
  if h.length() == 0 {
    return "·"
  }
  let c = h.code_unit_at(0).to_int()
  if c >= 0x61 && c <= 0x7A {
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let i = c - 0x61
    upper.slice(i, i + 1)
  } else {
    h.slice(0, 1)
  }
}

///| Corner radius of a tile of edge `size` (a quarter of the edge, snapped to the spacing scale).
pub fn shell_tile_radius(size : Double) -> Double {
  if size <= SP_16 { SP_4 } else if size <= SP_24 { SP_6 } else if size <= SP_32 { SP_8 } else { SP_12 }
}

///| Glyph size drawn inside a tile of edge `size`.
pub fn shell_tile_glyph(size : Double) -> Double {
  if size <= SP_20 { IC_SM } else if size <= SP_32 { IC_MD } else { IC_LG }
}

///| Monogram letter size inside a tile of edge `size`.
pub fn shell_tile_letter(size : Double) -> Double {
  if size <= SP_16 { TX_CAPTION } else if size <= SP_24 { TX_FOOTNOTE } else { TX_CALLOUT }
}

///| A rounded-square glyph tile, monochrome (DESIGN.md section 3): a neutral tile (`mono_tile_ground`) with the
///| glyph in ink. This is every list's and header's tile; a category is told by its glyph and label, not a color.
///| `size` is the tile edge.
pub fn shell_glyph_tile(parent : view::View, icon_name : String, size~ : Double = SP_24) -> view::View {
  mono_tile(parent, fn() { icon_name }, size=size, round=false)
}

///| A glyph tile that carries a meaning in its color: white glyph on `color_by`. Only for security state (a
///| warning, an insecure connection), a destructive action (red), or a color the person chose (a Space's accent).
///| Never for a list's identity: use `shell_glyph_tile`.
pub fn shell_tint_tile(
  parent : view::View,
  icon_name : String,
  color_by : () -> Int64,
  size~ : Double = SP_24,
) -> view::View {
  parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(shell_tile_radius(size)))
    .ground(view::Live::By(color_by))
    .points(view::Live::Is(false))
    .center()
    let _ = shell_icon(tile, icon_name, size=shell_tile_glyph(size), color_by=fn() { 0xFFFFFFFFL })
  })
}

///| A site tile: the site's icon when the host sent one, else its monogram in a stable per-host color
///| (`shell_favicon_tile`, `favicon_tile.pion`).
///| `awaits_cached`: a row naming a site with no live tab (the palette, history) waits for the host's cached icon on a
///| neutral plate while those are still coming in (`shell_favicon_tile`).
pub fn shell_site_tile(
  parent : view::View,
  host_by : () -> String,
  size~ : Double = SP_16,
  awaits_cached~ : Bool = false,
) -> view::View {
  shell_favicon_tile(parent, host_by, size=size, awaits_cached=awaits_cached)
}

///| A flat icon button on the frame (sidebar top row, compact toolbar): no capsule at rest, a soft wash on hover,
///| eased in and out. 32pt square face inside a 32 x 40 hit target.
pub fn shell_frame_icon_btn(
  parent : view::View,
  model : ShellModel,
  label : String,
  icon_name : String,
  on_press : () -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  on_menu~ : Option[(Double) -> Unit] = None,
  capture_ref? : signals::Ref[Option[view::View]],
  label_by? : () -> String,
  icon_by? : () -> String,
) -> view::View {
  // (a button that changes what it does in place, Reload / Stop: the same hit target, its glyph swapped at once)
  let label_now : () -> String = match label_by {
    Some(f) => f
    None => fn() { label }
  }
  let icon_now : () -> String = match icon_by {
    Some(f) => f
    None => fn() { icon_name }
  }
  // `disabled` goes to headless: a disabled button takes no press and no focus and is read out as disabled.
  let v = headless::button(
    parent,
    label_now,
    fn(_e) -> Unit { on_press() },
    disabled=disabled,
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      // Active and disabled ease like the hover (Back / Forward turn on and off on nearly every navigation).
      let act_t = shell_fade(b, active, duration_ms=MO_KEY_MS)
      let dis_t = shell_fade(b, disabled)
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_40)))
      .shrink(view::Live::Is(0.0))
      .center()
      let _ = b.box(fn(face : view::View) -> Unit {
        let _ = face
        .width(view::Live::Is(Some(SP_32)))
        .height(view::Live::Is(Some(SP_32)))
        .radius(view::Live::Is(SP_8))
        .points(view::Live::Is(false))
        .center()
        .ground(view::Live::By(fn() { shell_state_wash(model.dark(), hover_t(), act_t()) }))
        shell_press(face, fn() { btn.pressed() && !disabled() })
        shell_focus_ring(face, fn() { btn.focus_shown() }, SP_8)
        let _ = shell_icon_by(
          face,
          icon_now,
          size=IC_MD,
          color_by=fn() {
            let d = model.dark()
            let ink = shell_mix(shell_frame_ink_secondary(d), lg::surface().ink, act_t())
            shell_mix(ink, lg::alpha(shell_frame_ink_tertiary(d), 0.55), dis_t())
          },
        )
      })
    },
  )
  match on_menu {
    Some(cb) => {
      let _ = v.on_menu(fn(_m : view::Menu) -> Unit {
        let (bx, _, _, _) = v.placed_window_now()
        cb(bx)
      })
    }
    None => ()
  }
  match capture_ref {
    Some(r) => r.v = Some(v)
    None => ()
  }
  v
}

///| The one flat icon button of a panel's content and header (close, back, copy, reveal, clear): a 32pt square face,
///| no fill at rest, `row_hover` washed in on hover (`shell_fade`), 0.97 press (`shell_press`), the theme's focus ring
///| while the keyboard is on it, an `IC_MD` glyph in ink_secondary that turns ink on hover (`danger`: the danger ink,
///| over the danger ground). `icon_by` swaps the glyph live (a toggle), `ink_by` fixes its ink (a state that carries
///| meaning, such as a toggle that is on), `disabled` dims it and drops the press, `glyph` draws a custom mark.
pub fn shell_panel_icon_btn(
  parent : view::View,
  label_fn : () -> String,
  icon_name : String,
  on_press : () -> Unit,
  danger~ : Bool = false,
  icon_by? : () -> String,
  ink_by? : () -> Int64,
  disabled~ : () -> Bool = fn() { false },
  glyph? : (view::View, () -> Int64) -> Unit,
) -> view::View {
  headless::button(
    parent,
    label_fn,
    fn(_v : view::View) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let lit = fn() -> Bool { (btn.hovered() || btn.pressed()) && !disabled() }
      let hover_t = shell_fade(b, lit)
      shell_press(b, fn() { btn.pressed() && !disabled() })
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      .center()
      .radius(view::Live::Is(SP_8))
      .focus_ring_theme()
      .ground(view::Live::By(fn() {
        if danger { lg::alpha(lg::surface().danger_bg, hover_t()) } else { lg::alpha(lg::surface().row_hover, hover_t()) }
      }))
      let ink = fn() -> Int64 {
        let c = match ink_by {
          Some(f) => f()
          None =>
          // (the glyph turns ink, or red, with the same progress as its wash, never in one frame half-way)
          shell_mix(lg::surface().ink_secondary, if danger { lg::surface().danger } else { lg::surface().ink }, hover_t())
        }
        if disabled() { lg::alpha(c, 0.4) } else { c }
      }
      match glyph {
        Some(g) => g(b, ink)
        None =>
        match icon_by {
          Some(f) => {
            let _ = shell_icon_by(b, f, size=IC_MD, color_by=ink)
          }
          None => {
            let _ = shell_icon(b, icon_name, size=IC_MD, color_by=ink)
          }
        }
      }
    },
  )
}

///| The one close button of every panel header (dialogs, popovers, drawers built in the shell).
pub fn shell_panel_close_btn(parent : view::View, label : String, on_close : () -> Unit) -> view::View {
  shell_panel_icon_btn(parent, fn() { label }, ICON_CLOSE, on_close)
}

///| The one panel header: the title (`TX_HEADLINE` 600 for dialogs and sheets, `size=TX_CALLOUT` for popovers),
///| an optional one-line footnote under it (a description, never a counter), `trailing` controls, and the close
///| button. No decorative leading tile: the title names the panel. `leading` is only for what identifies the
///| subject (the site's tile in a site popover, the color a person chose for a Space or folder).
pub fn shell_panel_header(
  parent : view::View,
  title_by : () -> String,
  close_label : String,
  on_close : () -> Unit,
  size~ : Double = TX_HEADLINE,
  subtitle_by~ : () -> String = fn() { "" },
  leading~ : Option[(view::View) -> Unit] = None,
  trailing~ : (view::View) -> Unit = fn(_v) { () },
  close_ref? : signals::Ref[Option[view::View]],
) -> view::View {
  parent.box(fn(hdr : view::View) -> Unit {
    let _ = hdr
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Start)))
    .gap(view::Live::Is(SP_8))
    .rigid()
    match leading {
      Some(lead) => {
        let _ = hdr.box(fn(lw : view::View) -> Unit {
          let _ = lw.height(view::Live::Is(Some(SP_32))).rigid().row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(SP_6))
          lead(lw)
        })
      }
      None => ()
    }
    let _ = hdr.box(fn(col : view::View) -> Unit {
      let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(SP_0))).min_width(view::Live::Is(Some(SP_0)))
      // The title sits on a 32pt band so it centers on the close button.
      let _ = col.box(fn(band : view::View) -> Unit {
        let _ = band.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).height(view::Live::Is(Some(SP_32))).min_width(view::Live::Is(Some(SP_0))).cut()
        let _ = <ui::Text in={band} size={size} weight={600} lines={1} color_by=>{lg::surface().ink} text_by=>{title_by()} />.allow_ellipsis(
          view::Live::Is(true),
        )
      })
      col.show(fn() { subtitle_by() != "" }, fn(st : view::View) -> Unit {
        let _ = st.min_width(view::Live::Is(Some(SP_0))).cut()
        let _ = <ui::Text in={st} size={TX_FOOTNOTE} lines={1} color_by=>{lg::surface().ink_secondary} text_by=>{subtitle_by()} />.allow_ellipsis(
          view::Live::Is(true),
        )
      })
    })
    trailing(hdr)
    let close = shell_panel_close_btn(hdr, close_label, on_close)
    match close_ref {
      Some(r) => r.v = Some(close)
      None => ()
    }
  })
}

///| Splits a display URL into its host and the rest (`webkit.org`, `/blog/post`), scheme dropped.
pub fn shell_url_parts(url : String) -> (String, String) {
  let shown = proto::omnibox_safe_display_url(url)
  let mut s = shown
  if s.starts_with("https://") {
    s = s.slice(8, s.length())
  } else if s.starts_with("http://") {
    s = s.slice(7, s.length())
  }
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c == 0x2F || c == 0x3F || c == 0x23 {
      break
    }
    i += 1
  }
  let host = s.slice(0, i)
  let rest = s.slice(i, s.length())
  if host.starts_with("www.") {
    (host.slice(4, host.length()), if rest == "/" { "" } else { rest })
  } else {
    (host, if rest == "/" { "" } else { rest })
  }
}

// ============================================================================
// Motion (DESIGN.md section 4)
// ============================================================================
//
// Judged from the browser: what a person does a hundred times a day (switching tabs, Cmd+L / Cmd+T, the
// address palette, the command bar, sidebar hover, closing a tab) may move, but only by opacity or a tiny
// scale, within MO_KEY_MS when the keyboard starts it and 160ms when the pointer does, and never holds back
// input or content. Occasional surfaces (dialogs, popovers, menus, Peek, toasts, the capture sheet) get standard
// motion. Enter and exit both ease out (`shell_ease_out`); hover and color changes use `shell_ease`. Anything
// already true when the view is built appears at once. Exits are faster than enters.

///| Durations (ms). Literals: package lets in other files read these only inside functions.
///| Keyboard-initiated, high-frequency (address palette, command bar, tab switch, focus washes): <= 120.
pub let MO_KEY_MS : Double = 100.0
///| Crisp selection highlight handoff inside palettes and segmented strips.
pub let MO_SELECT_MS : Double = 65.0
///| The one hover / focus wash speed across the shell (sidebar rows, icon buttons, rows, chips): <= 160.
pub let MO_HOVER_MS : Double = 120.0
///| Asymmetric hover timings (emil-design-eng): crisp 90ms enter, silky 140ms release.
pub let MO_HOVER_IN_MS : Double = 90.0
pub let MO_HOVER_OUT_MS : Double = 140.0
///| Little Arc floating window enter / exit / promote timings (emil-design-eng crisp ease-out).
pub let MO_LITTLE_ARC_MS : Double = 220.0
pub let MO_LITTLE_ARC_OUT_MS : Double = 110.0
pub let MO_LITTLE_ARC_PROMOTE_MS : Double = 150.0
pub let MO_LITTLE_ARC_SCALE : Double = 0.94
pub let MO_LITTLE_ARC_RISE : Double = 14.0
///| Press feedback: the face sinks over MO_PRESS_MS (the person's act) and the release (the system's answer)
///| snaps back faster, over MO_RELEASE_MS.
pub let MO_PRESS_MS : Double = 160.0
pub let MO_RELEASE_MS : Double = 100.0
///| How far a pressed face sinks (scale 0.97).
pub let MO_PRESS_SINK : Double = 0.03
///| Tooltip-class hover cards (tab hover preview), first one only.
pub let MO_TIP_MS : Double = 120.0
pub let MO_TIP_SCALE : Double = 0.98
///| How long after a hover card closes the next one still opens at once (no fade: "instant after the first").
pub let MO_TIP_WARM_MS : Double = 400.0
///| How long the pointer rests on a tab row before its hover preview opens (the first one; warm ones open at once).
pub let TAB_PREVIEW_DELAY_MS : Double = 500.0
///| Anchored popovers, menus (the More menu, bookmarks overflow, context menus), toasts and the capture sheet.
pub let MO_POP_MS : Double = 140.0
pub let MO_POP_OUT_MS : Double = 100.0
///| Modal dialogs (centered).
pub let MO_DIALOG_MS : Double = 200.0
pub let MO_DIALOG_OUT_MS : Double = 100.0
///| Peek card entering over the page: scale and scrim over MO_PEEK_MS, the card's opacity front-loaded over
///| MO_PEEK_FADE_MS so the card and the page under it are seen on top of each other for only a few frames.
pub let MO_PEEK_MS : Double = 200.0
pub let MO_PEEK_FADE_MS : Double = 100.0
///| The new pane fading in when Split View opens from one pane (opacity only; its size never animates).
pub let MO_SPLIT_MS : Double = 180.0
///| The narrow-window sidebar drawer (Cmd+S): opacity and a small slide, in over MO_KEY_MS, out over
///| MO_POP_OUT_MS; how far it slides in from (pt).
pub let MO_DRAWER_NUDGE : Double = 12.0
///| Reduced motion: opacity keeps easing (gentler, not zero), capped at this; scale and offset are dropped.
pub let MO_REDUCED_MS : Double = 150.0
///| Start scales (never 0): popovers / sheets, dialogs, Peek.
pub let MO_POP_SCALE : Double = 0.97
pub let MO_DIALOG_SCALE : Double = 0.98
///| Progress past which a growing scale is drawn at exactly 1.
pub let MO_SCALE_LANDS : Double = 0.98
pub let MO_PEEK_SCALE : Double = 0.97
///| The page-load line (`shell_page_progress`): while a load runs it creeps toward MO_LOAD_CREEP of the card's
///| width over MO_LOAD_CREEP_MS (eased out: quick at first, then waiting on the page); when the load ends it runs
///| to the end and fades over MO_HOVER_MS. No host fraction comes over the wire, so this is the honest shape.
pub let MO_LOAD_CREEP_MS : Double = 2400.0
pub let MO_LOAD_CREEP : Double = 0.8

///| Strong ease-out for every enter and exit: cubic-bezier(0.23, 1, 0.32, 1).
pub fn shell_ease_out() -> (Double) -> Double {
  motion::cubic_bezier(0.23, 1.0, 0.32, 1.0)
}

///| Crisp emil-design-eng exponential ease-out for floating sheets, Little Arc, and Peek: cubic-bezier(0.22, 1, 0.36, 1).
pub fn shell_ease_emil() -> (Double) -> Double {
  motion::cubic_bezier(0.22, 1.0, 0.36, 1.0)
}

///| CSS `ease` for hover and color changes (washes, rings, inks): cubic-bezier(0.25, 0.1, 0.25, 1).
pub fn shell_ease() -> (Double) -> Double {
  motion::cubic_bezier(0.25, 0.1, 0.25, 1.0)
}

///| A tween of `ms` on `ease` (the shell's strong ease-out when not given).
pub fn shell_spec(ms : Double, ease? : (Double) -> Double) -> motion::Spec {
  let e = match ease {
    Some(f) => f
    None => shell_ease_out()
  }
  motion::tween_to(duration=ms, ease=e)
}

///| Runs `f` with Invar's reduced-motion zeroing lifted, so an opacity tween keeps its (capped) duration under
///| reduced motion. Invar's `Way::go` sets every duration to 0 while `ui::reduced_motion()` holds; the shell's
///| policy is "gentler, not zero": opacity and color still ease, transforms are dropped by the callers.
///| A stopgap until `Way::go` keeps short opacity tweens itself (upstream): the override is lifted only for the
///| synchronous `go`, inside a batch, so nothing the way's write sets off runs before it is put back.
fn shell_motion_kept(f : () -> Unit) -> Unit {
  if !ui::reduced_motion() {
    f()
    return
  }
  // What the host says without an override tells which override to put back: none when the host itself asks
  // for reduced motion, a forced `Some(true)` otherwise.
  ui::set_reduced_motion(None)
  let host_reduces = ui::reduced_motion()
  signals::start_batch()
  ui::set_reduced_motion(Some(false))
  f()
  ui::set_reduced_motion(if host_reduces { None } else { Some(true) })
  signals::end_batch_in_turn()
}

///| `way.go` toward `to` over `ms` with the shell's reduced-motion policy (opacity ways only: under reduced
///| motion the tween is kept, capped at MO_REDUCED_MS).
pub fn shell_go(
  way : motion::NodeWay,
  n : view::View,
  to : Double,
  ms : Double,
  ease? : (Double) -> Double,
) -> Unit {
  if ui::reduced_motion() {
    let capped = if ms > MO_REDUCED_MS { MO_REDUCED_MS } else { ms }
    shell_motion_kept(fn() { way.go(n, to, shell_spec(capped, ease?=ease)) })
  } else {
    way.go(n, to, shell_spec(ms, ease?=ease))
  }
}

///| Asymmetric hover wash: fast `in_ms` enter (90ms) + silky `out_ms` exit (140ms) for tactile Arc feel.
pub fn shell_fade_asym(
  v : view::View,
  active : () -> Bool,
  in_ms~ : Double = MO_HOVER_IN_MS,
  out_ms~ : Double = MO_HOVER_OUT_MS,
) -> () -> Double {
  let way = motion::NodeWay::new(if signals::untracked(active) { 1.0 } else { 0.0 })
  v.reacts(active, fn(on : Bool) -> Unit {
    if on {
      shell_go(way, v, 1.0, in_ms, ease=shell_ease_emil())
    } else {
      shell_go(way, v, 0.0, out_ms, ease=shell_ease())
    }
  }, at_start=false)
  fn() -> Double { way.shown(v) }
}

///| The shell's hover / focus / state wash: 0 -> 1 while `active` holds, over `duration_ms` on `ease` (a color
///| change, not an entrance), at its resting value at once when built. Same contract as `motion::hover_fade`, plus the reduced-motion policy
///| (the wash still eases; it is color, not movement).
pub fn shell_fade(
  v : view::View,
  active : () -> Bool,
  duration_ms~ : Double = MO_HOVER_MS,
  instant_off~ : () -> Bool = fn() -> Bool { false },
) -> () -> Double {
  let way = motion::NodeWay::new(if signals::untracked(active) { 1.0 } else { 0.0 })
  v.reacts(active, fn(on : Bool) -> Unit {
    if on {
      shell_go(way, v, 1.0, duration_ms, ease=shell_ease())
    } else if signals::untracked(instant_off) {
      way.put(0.0)
    } else {
      shell_go(way, v, 0.0, duration_ms, ease=shell_ease())
    }
  }, at_start=false)
  fn() -> Double { way.shown(v) }
}

///| An enter / exit presence for a view mounted by `show(..., leave=exit_ms)`: 0 -> 1 over `enter_ms` when
///| mounted with `animate` (a person opened it), 1 at once otherwise (already open when built); back to 0 over
///| `exit_ms` while it leaves, and toward 1 again if it is opened while still leaving (retargeted from where it
///| is, never restarted). `from_scale` is where the scale starts (never 0); reduced motion keeps it at 1.
///| `fade_ms` (when given) front-loads the opacity: it reaches 1 over `fade_ms` while the scale (and anything
///| reading `progress_on`, such as a scrim) keeps `enter_ms`.
pub struct ShellReveal {
  way : motion::NodeWay
  fade : Option[motion::NodeWay]
  node : view::View
  from_scale : Double
  enter_ms : Double
  fade_ms : Double
}

pub fn shell_reveal(
  v : view::View,
  animate : Bool,
  enter_ms~ : Double = MO_POP_MS,
  exit_ms~ : Double = MO_POP_OUT_MS,
  from_scale~ : Double = 1.0,
  fade_ms? : Double,
) -> ShellReveal {
  let start = if animate { 0.0 } else { 1.0 }
  let way = motion::NodeWay::new(start)
  let fade : Option[motion::NodeWay] = match fade_ms {
    Some(_) => Some(motion::NodeWay::new(start))
    None => None
  }
  let f_ms = match fade_ms {
    Some(ms) => ms
    None => enter_ms
  }
  // (run at start too: that is the enter, a no-op when it is already shown; the read also ties it to leaving)
  v.reacts(fn() { v.leaving() }, fn(going : Bool) -> Unit {
    if going {
      shell_go(way, v, 0.0, exit_ms)
      match fade {
        Some(fw) => shell_go(fw, v, 0.0, exit_ms)
        None => ()
      }
    } else {
      shell_go(way, v, 1.0, enter_ms)
      match fade {
        Some(fw) => shell_go(fw, v, 1.0, f_ms)
        None => ()
      }
    }
  })
  if from_scale != 1.0 {
    let _ = v.carries_until(fn() -> Double { way.ends_at() })
  }
  ShellReveal::{ way, fade, node: v, from_scale, enter_ms, fade_ms: f_ms }
}

///| Puts it at rest, shown, at once (a hover card swapping to another tab mid-way through its first fade; a
///| state that is not an entrance, such as Split View turning into Peek).
pub fn ShellReveal::settle(self : ShellReveal) -> Unit {
  if !self.node.leaving() {
    self.way.put(1.0)
    match self.fade {
      Some(fw) => fw.put(1.0)
      None => ()
    }
  }
}

///| Plays the enter again from 0, for a surface that stays mounted and comes in on a state change (Peek, the
///| new Split View pane).
pub fn ShellReveal::replay(self : ShellReveal) -> Unit {
  self.way.put(0.0)
  shell_go(self.way, self.node, 1.0, self.enter_ms)
  match self.fade {
    Some(fw) => {
      fw.put(0.0)
      shell_go(fw, self.node, 1.0, self.fade_ms)
    }
    None => ()
  }
}

///| `close` told as a person's act within `v` (`view::transition`): the app's views move only for a cause, so a
///| `show(..., leave=)` plays its way out only when what closes it is told inside one. Wrap the closes a person
///| makes from inside a surface (Cancel, the scrim, Escape) so the exit plays; closes from elsewhere stay instant.
pub fn shell_closes(v : view::View, close : () -> Unit) -> () -> Unit {
  fn() { view::transition(close, within=v) }
}

///| Opacity 0 -> 1 as drawn on `n` (front-loaded when the reveal has a `fade_ms`).
pub fn ShellReveal::shown_on(self : ShellReveal, n : view::View) -> Double {
  match self.fade {
    Some(fw) => fw.shown(n)
    None => self.way.shown(n)
  }
}

///| Progress 0 -> 1 over the whole enter as drawn on `n` (what a scrim under the surface follows).
pub fn ShellReveal::progress_on(self : ShellReveal, n : view::View) -> Double {
  self.way.shown(n)
}

///| Scale as drawn on `n`: `from_scale` -> 1 with the progress, 1 under reduced motion.
pub fn ShellReveal::scale_on(self : ShellReveal, n : view::View) -> Double {
  if ui::reduced_motion() || self.from_scale == 1.0 {
    1.0
  } else {
    let p = self.way.shown(n)
    // The last stretch lands on exactly 1 (a 0.0004 step nobody sees), so the frame that settles it draws the
    // resting geometry and what the accessibility mirror last read is where everything rests.
    if p >= MO_SCALE_LANDS { 1.0 } else { self.from_scale + (1.0 - self.from_scale) * p }
  }
}

///| Fades `n` with the reveal.
pub fn ShellReveal::fades(self : ShellReveal, n : view::View) -> Unit {
  let _ = n.alpha(view::Live::By(fn() { self.shown_on(n) }))
}

///| Fades `n` and grows it from `from_scale` about `(ox, oy)` (fractions of its own box).
pub fn ShellReveal::grows(self : ShellReveal, n : view::View, ox~ : Double = 0.5, oy~ : Double = 0.5) -> Unit {
  let _ = n
  .alpha(view::Live::By(fn() { self.shown_on(n) }))
  .scale(view::Live::By(fn() { self.scale_on(n) }), about=view::Pivot::At(ox, oy))
}

///| Grows `n` about `(ox, oy)` without fading it (the fade is on an ancestor that also holds the scrim).
pub fn ShellReveal::grows_only(self : ShellReveal, n : view::View, ox~ : Double = 0.5, oy~ : Double = 0.5) -> Unit {
  let _ = n.scale(view::Live::By(fn() { self.scale_on(n) }), about=view::Pivot::At(ox, oy))
}

///| The presence every modal dialog uses: fade in with a 0.98 -> 1 scale over MO_DIALOG_MS, out over
///| MO_DIALOG_OUT_MS, both on the strong ease-out. Modals stay centered (scale about the middle). Mount the
///| dialog with `show(open, leave=MO_DIALOG_OUT_MS, ...)`; call `fades` on the wrapper holding the scrim and
///| `grows_only` on the dialog's glass shell.
pub fn shell_dialog_reveal(v : view::View, animate : Bool) -> ShellReveal {
  shell_reveal(v, animate, enter_ms=MO_DIALOG_MS, exit_ms=MO_DIALOG_OUT_MS, from_scale=MO_DIALOG_SCALE)
}

///| The presence every anchored popover uses: fade in with a 0.97 -> 1 scale over MO_POP_MS from the side of
///| the popover that faces its trigger, out over MO_POP_OUT_MS. Mount with `show(open, leave=MO_POP_OUT_MS)`.
pub fn shell_popover_reveal(v : view::View, animate : Bool) -> ShellReveal {
  shell_reveal(v, animate, enter_ms=MO_POP_MS, exit_ms=MO_POP_OUT_MS, from_scale=MO_POP_SCALE)
}

///| Where a popover at `(px, py)` of `pw x ph` grows from: the trigger's center across it, the edge facing it
///| down it (top when it opens below, bottom when above).
pub fn shell_popover_origin(anchor : AnchorRect, px : Double, py : Double, pw : Double, ph : Double) -> (Double, Double) {
  if !anchor.is_valid() || pw <= 0.0 {
    return (0.5, 0.0)
  }
  let mid = anchor.x + anchor.w * 0.5
  let fx = (mid - px) / pw
  let ox = if fx < 0.0 { 0.0 } else if fx > 1.0 { 1.0 } else { fx }
  let oy = if ph > 0.0 && py + ph * 0.5 < anchor.y { 1.0 } else { 0.0 }
  (ox, oy)
}

///| Keyboard focus ring on a button's visible face (the rounded rect a person sees, not its larger hit box):
///| a 2pt accent ring 3pt outside the face, concentric with its `radius`, while `shown` holds. Reading
///| `Button::focus_shown` inside `shown` also tells the tree that this stop shows its focus (`Tree::focus_blind`).
///| Rows whose focusable node is the visible rect itself use `.focus_ring_theme()` on that node instead.
pub fn shell_focus_ring(face : view::View, shown : () -> Bool, radius : Double) -> Unit {
  face.show(shown, at_once=true, fn(ring : view::View) -> Unit {
    let _ = ring
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
    .radius(view::Live::Is(radius + 3.0))
    .edge(view::Live::By(fn() { (2.0, lg::surface().accent) }))
  })
}

///| Press feedback on a pressable face: it sinks to scale 0.97 over MO_PRESS_MS while `pressed` holds and
///| snaps back over MO_RELEASE_MS, faster than the press (both within 100-160ms; never delays the press
///| itself). Reduced motion: no scale.
pub fn shell_press(face : view::View, pressed : () -> Bool) -> Unit {
  let way = motion::NodeWay::new(0.0)
  face.reacts(pressed, fn(on : Bool) -> Unit {
    if on {
      way.go(face, 1.0, shell_spec(MO_PRESS_MS))
    } else {
      way.go(face, 0.0, shell_spec(MO_RELEASE_MS))
    }
  }, at_start=false)
  let _ = face.scale(view::Live::By(fn() {
    if ui::reduced_motion() { 1.0 } else { 1.0 - MO_PRESS_SINK * way.shown(face) }
  }))
}

///| The shell's dropdown menu (the More menu, the bookmarks overflow): an `lg` menu panel under its trigger that
///| comes in like every popover (`shell_popover_reveal`: fade + 0.97 -> 1 out of the trigger's corner, MO_POP_MS
///| in, MO_POP_OUT_MS out, eased out) with its items readable from the first frame. It replaces `lg`'s menu morph,
///| whose content waits 170ms and finishes near 330ms, too slow for a dropdown and out of step with the rest of
///| the shell (DESIGN.md section 4, one menu rule). `open` / `set_open` as `lg::liquid_menu_node`; Escape, a
///| click outside and choosing an item close it, and focus goes back to the trigger.
pub fn shell_menu_node(
  parent : view::View,
  host : view::View,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  trigger_label : () -> String,
  trigger_look : (view::View, headless::Disclosure) -> Unit,
  entries : () -> Array[lg::LiquidMenuEntry],
  menu_label~ : () -> String = fn() { "Menu" },
  align_end~ : Bool = true,
  min_width~ : Double = SP_160 + SP_80,
  anchor_w~ : Double = SP_32,
) -> view::View {
  // (a person's open or close, told as a transition so the presence plays even where the tree moves only for a
  // cause; the open as shown follows the model through one)
  let shown = signals::signal(signals::untracked(open))
  parent.reacts(open, fn(on : Bool) -> Unit {
    view::transition(within=host, fn() { shown.set(on) })
  }, at_start=false)
  let set_open_tx = fn(v : Bool) -> Unit { view::transition(within=host, fn() { set_open(v) }) }
  let pop = headless::Popover::new(fn() { shown.get() }, set_open_tx)
  let trigger = pop.trigger(parent, trigger_label, trigger_look)
  // The trigger's middle across the menu, on the edge facing it.
  let frac = anchor_w * 0.5 / min_width
  let ox = if align_end { 1.0 - frac } else { frac }
  let open_at_build = ui::ref_new(signals::untracked(open))
  // The menu in `host` over the window: a click outside it lands on its scrim and closes it; the focus goes into
  // it as it opens and back to what had it (the trigger) as it goes.
  host.show(fn() { shown.get() }, leave=MO_POP_OUT_MS, fn(layer : view::View) -> Unit {
    // (already open as the shell is built: there at once)
    let reveal = shell_popover_reveal(layer, !open_at_build.v)
    open_at_build.v = false
    let close_now = fn() { set_open_tx(false) }
    let _ = layer.over(view::Live::Is(true)).focus_opens_first()
    let _ = layer.box(fn(scrim : view::View) -> Unit {
      let _ = scrim.over(view::Live::Is(true)).presses(view::Live::Is(true)).on_press(close_now)
    })
    // Beside the trigger, drawn over the sidebar and the page; its glass is the menu's own.
    let _ = layer.box(fn(pos : view::View) -> Unit {
      let _ = pos.float_beside(
        Some(trigger),
        side=view::Side::Bottom,
        along=if align_end { view::Along::End } else { view::Along::Start },
        offset=SP_8,
        padding=SP_8,
      )
      reveal.grows(pos, ox=ox, oy=0.0)
      let _ = shell_menu_panel(pos, entries, close_now, menu_label=menu_label, min_width=min_width)
    })
  })
  trigger
}

///| The rim every floating surface draws (menus): a 1pt hairline, ink at 10% on light and white at 12% on dark, so
///| a solid panel keeps its edge over a white page, plus one soft shadow under it. Glass or solid, the same rim.
pub fn shell_float_rim(v : view::View) -> view::View {
  v
  .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0xFFFFFF1FL } else { 0x0000001AL }) }))
  .shadow(view::Live::By(fn() { if lg::is_dark() { (SP_24, SP_8, 0x00000066L) } else { (SP_20, SP_6, 0x0000001FL) } }))
  .shadow_outside(view::Live::Is(true))
}

///| The shell's menu panel (dropdowns, context menus, Back/Forward history): `lg`'s menu panel with the shell's
///| rim (`shell_float_rim`). Every menu goes through here, never `lg::liquid_menu_panel_node` directly.
pub fn shell_menu_panel(
  parent : view::View,
  entries : () -> Array[lg::LiquidMenuEntry],
  on_close : () -> Unit,
  header~ : () -> String = fn() { "" },
  menu_label~ : () -> String = fn() { "Menu" },
  min_width~ : Double = SP_160 + SP_48,
) -> view::View {
  shell_float_rim(lg::liquid_menu_panel_node(parent, entries, on_close, header=header, menu_label=menu_label, min_width=min_width))
}

///| The ground of a face on the frame with a hover and an active (selected) state, both eased: the hover wash
///| under the strong wash, the hover giving way as the active one comes, so nothing dips between them (tab rows,
///| icon buttons, Space dots).
pub fn shell_state_wash(dark : Bool, hover : Double, active : Double) -> Int64 {
  lg::over(lg::alpha(shell_wash_hover(dark), hover * (1.0 - active)), lg::alpha(shell_wash_strong(dark), active))
}

///| A flat icon button for panel content and floating glass (popover close, Peek header, media play): a 32pt
///| square with no face at rest, `lg::surface().row_hover` eased in over MO_HOVER_MS on hover, a 0.97 press
///| (`shell_press`), active (neutral resting fill, accent ink) and disabled (tertiary ink, no wash, no press)
///| eased the same way. The one face every shell icon button uses, so a popover's X and a panel's X feel alike.
pub fn shell_icon_face_btn(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  icon_by : () -> String,
  color_by~ : () -> Int64 = fn() { lg::surface().ink_secondary },
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  danger~ : Bool = false,
  content? : (view::View) -> Unit,
) -> view::View {
  headless::button(
    parent,
    label,
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    disabled=disabled,
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let act_t = shell_fade(b, active, duration_ms=MO_KEY_MS)
      let dis_t = shell_fade(b, disabled)
      let _ = b
      .width(view::Live::Is(Some(SP_32)))
      .height(view::Live::Is(Some(SP_32)))
      .shrink(view::Live::Is(0.0))
      // (round, as the lg button it replaces: inside a panel a round face is concentric with any corner)
      .radius(view::Live::Is(SP_16))
      .center()
      .focus_ring_theme()
      .ground(view::Live::By(fn() {
        let s = lg::surface()
        let hover = if danger { s.danger_bg } else { s.row_hover }
        let rest = if lg::is_dark() { 0xFFFFFF22L } else { 0x00000016L }
        let a = act_t()
        lg::over(lg::alpha(hover, hover_t() * (1.0 - a)), lg::alpha(rest, a))
      }))
      shell_press(b, fn() { btn.pressed() && !disabled() })
      match content {
        Some(f) => f(b)
        None => {
          let _ = shell_icon_by(b, icon_by, size=IC_MD, color_by=fn() {
            let s = lg::surface()
            let base = if danger { shell_mix(color_by(), s.danger, hover_t()) } else { color_by() }
            let ink = shell_mix(base, s.accent, act_t())
            shell_mix(ink, s.ink_tertiary, dis_t())
          })
        }
      }
    },
  )
}

///| A flat accent text button for dialogs and sheets (Cancel, Done): 32pt tall, 12pt side padding, the row hover
///| wash eased over MO_HOVER_MS and the 0.97 press, on the same timings as every shell face.
pub fn shell_text_btn(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  text_by? : () -> String,
  ink~ : () -> Int64 = fn() { shell_accent_text() },
  disabled~ : () -> Bool = fn() { false },
) -> view::View {
  let shown = match text_by {
    Some(f) => f
    None => label
  }
  headless::button(
    parent,
    label,
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    disabled=disabled,
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { (btn.hovered() || btn.pressed()) && !disabled() })
      let dis_t = shell_fade(b, disabled)
      let _ = b
      .height(view::Live::Is(Some(SP_32)))
      .min_width(view::Live::Is(Some(SP_32)))
      .padding(view::Live::Is((SP_12, SP_0, SP_12, SP_0)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .focus_ring_theme()
      .ground(view::Live::By(fn() { lg::alpha(lg::surface().row_hover, hover_t()) }))
      shell_press(b, fn() { btn.pressed() && !disabled() })
      let _ = <ui::Text
        in={b}
        size={TX_BODY}
        weight={500}
        color_by=>{shell_mix(ink(), lg::surface().ink_tertiary, dis_t())}
        text_by=>{shown()}
      />
    },
  )
}

///| A solid accent button (the one primary action of a dialog or sheet): 32pt tall, 16pt side padding, white
///| ink; a light overlay eased in on hover, a darker one over MO_PRESS_MS while pressed, and the 0.97 press.
pub fn shell_primary_btn(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  text_by? : () -> String,
  disabled~ : () -> Bool = fn() { false },
) -> view::View {
  let shown = match text_by {
    Some(f) => f
    None => label
  }
  headless::button(
    parent,
    label,
    fn(_e) -> Unit {
      if !disabled() {
        on_press()
      }
    },
    disabled=disabled,
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = shell_fade(b, fn() { btn.hovered() && !btn.pressed() && !disabled() })
      let press_t = shell_fade(b, fn() { btn.pressed() && !disabled() }, duration_ms=MO_PRESS_MS)
      let dis_t = shell_fade(b, disabled)
      let _ = b
      .height(view::Live::Is(Some(SP_32)))
      .min_width(view::Live::Is(Some(SP_32)))
      .padding(view::Live::Is((SP_16, SP_0, SP_16, SP_0)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(SP_8))
      .center()
      .focus_ring_theme()
      .ground(view::Live::By(fn() {
        let s = lg::surface()
        let base = shell_mix(s.accent, s.separator_strong, dis_t())
        let lit = shell_mix(base, 0xFFFFFFFFL, 0.12 * hover_t())
        shell_mix(lit, 0x000000FFL, 0.14 * press_t())
      }))
      shell_press(b, fn() { btn.pressed() && !disabled() })
      let _ = <ui::Text in={b} size={TX_BODY} weight={500} color_by=>{0xFFFFFFFFL} text_by=>{shown()} />
    },
  )
}

///| A number as drawn on `v` that eases from what is shown to `value` whenever it changes, over `ms` on
///| `shell_ease` (a color or strength following the frame tint); at once when built and while `instant` holds
///| (a live edit). Retargeted from where it is, never restarted.
pub fn shell_follow(
  v : view::View,
  value : () -> Double,
  ms~ : Double = MO_KEY_MS,
  instant~ : () -> Bool = fn() -> Bool { false },
) -> () -> Double {
  let start = signals::untracked(value)
  let from = ui::ref_new(start)
  let to = ui::ref_new(start)
  let way = motion::NodeWay::new(1.0)
  v.reacts(value, fn(now : Double) -> Unit {
    let p = way.shown(v)
    if signals::untracked(instant) {
      from.v = now
      to.v = now
      way.put(1.0)
      return
    }
    from.v = if p >= 1.0 { to.v } else { from.v + (to.v - from.v) * p }
    to.v = now
    way.put(0.0)
    shell_go(way, v, 1.0, ms, ease=shell_ease())
  }, at_start=false)
  fn() -> Double {
    let p = way.shown(v)
    if p >= 1.0 { value() } else { from.v + (to.v - from.v) * p }
  }
}

///| `shell_follow` for a color.
pub fn shell_follow_color(
  v : view::View,
  value : () -> Int64,
  ms~ : Double = MO_KEY_MS,
  instant~ : () -> Bool = fn() -> Bool { false },
) -> () -> Int64 {
  let start = signals::untracked(value)
  let from = ui::ref_new(start)
  let to = ui::ref_new(start)
  let way = motion::NodeWay::new(1.0)
  v.reacts(value, fn(now : Int64) -> Unit {
    let p = way.shown(v)
    if signals::untracked(instant) {
      from.v = now
      to.v = now
      way.put(1.0)
      return
    }
    from.v = if p >= 1.0 { to.v } else { shell_mix(from.v, to.v, p) }
    to.v = now
    way.put(0.0)
    shell_go(way, v, 1.0, ms, ease=shell_ease())
  }, at_start=false)
  fn() -> Int64 {
    let p = way.shown(v)
    if p >= 1.0 { value() } else { shell_mix(from.v, to.v, p) }
  }
}

///| A confirmation as `on` turns true (a page bookmarked): progress 0 -> 1 over MO_POP_MS on the strong ease-out
///| from that moment, kept as a fade under reduced motion; 1 at once as built and when `on` turns false (turning
///| something off is not confirmed with motion). `confirms` is asked as `on` turns true: whether the person's own act
///| turned it so (read once there); where it says no (`on` true because the page or the tab changed to one already
///| so: a switch from the keyboard, back/forward), it is at rest at once, so no keyboard path replays it.
pub fn shell_pop_in(v : view::View, on : () -> Bool, confirms~ : () -> Bool = fn() { true }) -> () -> Double {
  let way = motion::NodeWay::new(1.0)
  v.reacts(on, fn(now : Bool) -> Unit {
    if now && confirms() {
      way.put(0.0)
      shell_go(way, v, 1.0, MO_POP_MS)
    } else {
      way.put(1.0)
    }
  }, at_start=false)
  fn() -> Double { way.shown(v) }
}
