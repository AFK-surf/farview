///| Arc workflows in the shell: the Auto-PiP mini player (render, hover controls, actions, drag-to-corner snap,
///| resize), the Air Traffic Control editor (add, toggle, edit, delete with live preview) and the Library's
///| Archived Tabs (restore, clear, search).

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn pip_test_state(active : Bool) -> proto::AutoPipState {
  proto::AutoPipState::{
    ..proto::AutoPipState::hidden(),
    active,
    tab_id: "42",
    title: "Lo-fi beats to relax to",
    host: "video.example",
    playing: true,
    progress: 0.4,
    duration_secs: 245,
  }
}

test "auto pip: floats 320x180 at the bottom-right, shows controls on hover, and every control acts" {
  let state = signals::signal(pip_test_state(false))
  let acts : Array[String] = []
  let placed : signals::Ref[(String, Double)] = ui::ref_new(("", 0.0))
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_auto_pip_overlay(root, AutoPipProps::{
        state: fn() { state.get() },
        on_back: fn() {
          acts.push("back")
          state.set(proto::AutoPipState::{ ..state.untracked(), active: false })
        },
        on_toggle_play: fn() {
          acts.push("play")
          state.set(proto::AutoPipState::{ ..state.untracked(), playing: !state.untracked().playing })
        },
        on_toggle_mute: fn() {
          acts.push("mute")
          state.set(proto::AutoPipState::{ ..state.untracked(), muted: !state.untracked().muted })
        },
        on_close: fn() {
          acts.push("close")
          state.set(proto::AutoPipState::{ ..state.untracked(), active: false })
        },
        on_place: fn(c, w) { placed.v = (c, w) },
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  debug_assert(t.get("Mini Video Player").is_none(), "hidden until the host says")
  state.set(pip_test_state(true))
  t.frame(ms=16.0)
  t.frame(ms=120.0)
  t.frame(ms=400.0)
  let card = match t.get("Mini Video Player") {
    Some(c) => c
    None => {
      debug_assert(false, "the mini player floats")
      return
    }
  }
  debug_assert((card.w - 320.0).abs() < 0.5 && (card.h - 180.0).abs() < 0.5, "320x180 (\{card.w}x\{card.h})")
  debug_assert((card.x + card.w - (1280.0 - PIP_MARGIN)).abs() < 1.0 && (card.y + card.h - (800.0 - PIP_MARGIN)).abs() < 1.0, "held to the bottom-right corner (\{card.x},\{card.y})")
  debug_assert(t.get("Back to Tab").is_none() && t.get("Pause").is_none(), "controls hidden at rest")
  // Hover: the controls fade in.
  t.move_to(card.x + card.w / 2.0, card.y + card.h / 2.0)
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(t.get("Back to Tab").is_some() && t.get("Pause").is_some() && t.get("Mute").is_some() && t.get("Close Mini Player").is_some(), "four controls on hover")
  lg::assert_apple_ui(t, label="auto-pip-hover")
  t.press("Pause")
  t.frame(ms=16.0)
  debug_assert(!state.untracked().playing && t.get("Play").is_some(), "pause then reads Play")
  t.press("Mute")
  t.frame(ms=16.0)
  debug_assert(state.untracked().muted && t.get("Unmute").is_some(), "mute then reads Unmute")
  t.press("Back to Tab")
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(acts.length() == 3 && acts[2] == "back", "back to tab: " + acts.join(","))
  debug_assert(t.get("Mini Video Player").is_none(), "docked: gone once its tab shows")
  // Shown again, Close dismisses it.
  state.set(pip_test_state(true))
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  match t.get("Mini Video Player") {
    Some(c) => t.move_to(c.x + c.w / 2.0, c.y + c.h / 2.0)
    None => debug_assert(false, "shown again")
  }
  t.frame(ms=200.0)
  t.press("Close Mini Player")
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(acts[acts.length() - 1] == "close" && t.get("Mini Video Player").is_none(), "closed")
  let _ = placed
  t.dispose()
}

test "auto pip: dragged and let go, it snaps to the nearest corner with a spring; its inner corner resizes 16:9" {
  let state = signals::signal(pip_test_state(true))
  let placed : signals::Ref[(String, Double)] = ui::ref_new(("", 0.0))
  let toggles : signals::Ref[Int] = ui::ref_new(0)
  lg::set_dark(Some(true))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_auto_pip_overlay(root, AutoPipProps::{
        state: fn() { state.get() },
        on_back: fn() { () },
        on_toggle_play: fn() { toggles.v += 1 },
        on_toggle_mute: fn() { () },
        on_close: fn() { () },
        on_place: fn(c, w) {
          placed.v = (c, w)
          state.set(proto::normalize_auto_pip_state(proto::AutoPipState::{ ..state.untracked(), corner: c, w }))
        },
      })
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  let c0 = match t.get("Mini Video Player") {
    Some(c) => c
    None => {
      debug_assert(false, "shown")
      return
    }
  }
  // Drag it up and to the left, past the middle: it goes to the top-left.
  let sx = c0.x + c0.w / 2.0
  let sy = c0.y + c0.h / 2.0
  t.drag(sx, sy, 300.0, 200.0, steps=8)
  t.frame(ms=16.0)
  let (corner, _) = placed.v
  debug_assert(corner == "tl", "snapped to the top-left (\{corner})")
  debug_assert(toggles.v == 0, "a drag that starts on a control is a drag, not a press")
  // Mid-spring it is on its way, not there yet; settled it sits in the corner.
  t.frame(ms=40.0)
  t.frame(ms=600.0)
  t.frame(ms=600.0)
  match t.get("Mini Video Player") {
    Some(c) => debug_assert((c.x - PIP_MARGIN).abs() < 1.5 && (c.y - PIP_MARGIN).abs() < 1.5, "settled at the top-left (\{c.x},\{c.y})")
    None => debug_assert(false, "still shown")
  }
  // The resize grip sits at the foot's inner (right) corner now; dragging it out widens it, 16:9 kept.
  match t.get("Resize Mini Player") {
    Some(g) => {
      t.drag(g.x + g.w / 2.0, g.y + g.h / 2.0, g.x + g.w / 2.0 + 80.0, g.y + g.h / 2.0, steps=6)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "resize grip")
  }
  let (_, w) = placed.v
  debug_assert((w - 400.0).abs() < 1.0, "widened to 400 (\{w})")
  match t.get("Mini Video Player") {
    Some(c) => debug_assert((c.w - 400.0).abs() < 1.0 && (c.h - 225.0).abs() < 1.0, "400x225 (\{c.w}x\{c.h})")
    None => debug_assert(false, "still shown")
  }
  lg::assert_apple_ui(t, label="auto-pip-dark")
  t.dispose()
}

fn atc_test_spaces() -> Array[ShellSpaceItem] {
  [
    ShellSpaceItem::{ id: "work", name: "Work", accent_rgba: 0x007AFFFFL, theme: proto::space_theme_unset() },
    ShellSpaceItem::{ id: "life", name: "Life", accent_rgba: 0x10B981FFL, theme: proto::space_theme_unset() },
  ]
}

test "ATC editor: add with live preview, toggle, edit and delete rules" {
  let rules : signals::Signal[Array[proto::AtcRule]] = signals::signal([])
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().grouped_bg })).padding(view::Live::Is((SP_24, SP_24, SP_24, SP_24)))
      let _ = ui::scroll_box(root, fn(page : view::View) -> Unit {
        build_atc_editor(page, AtcEditorProps::{
          rules: fn() { rules.get() },
          spaces: atc_test_spaces,
          on_upsert: fn(r) { rules.set(proto::atc_rules_upsert(rules.untracked(), r)) },
          on_toggle: fn(id, on) { rules.set(proto::atc_rules_toggle(rules.untracked(), id, on)) },
          on_delete: fn(id) { rules.set(proto::atc_rules_delete(rules.untracked(), id)) },
        })
      })
    },
    width=720.0,
    height=720.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  debug_assert(t.find("No rules yet. Links open where they always have.").is_some(), "empty state")
  debug_assert(t.find("Type a site, like github.com").is_some(), "preview before typing")
  // Add: type a wildcard host, pick Life; the preview follows the typing.
  t.press("Rule Pattern")
  t.frame(ms=16.0)
  t.type_text("*.github.com")
  t.frame(ms=16.0)
  debug_assert(t.find("Links to any subdomain of github.com").is_some(), "live preview")
  t.press("Open in Life")
  t.frame(ms=16.0)
  t.press("Add Rule")
  t.frame(ms=16.0)
  debug_assert(rules.untracked().length() == 1, "one rule added")
  let r0 = rules.untracked()[0]
  debug_assert(r0.pattern == "*.github.com" && r0.target_space_id == "life" && r0.enabled && r0.match_kind == "host", "added as typed")
  debug_assert(t.get("Enable rule *.github.com").is_some() && t.find("Site \u{00B7} Opens in Life").is_some(), "listed with where it goes")
  // A prefix rule for the Quick Window.
  t.press("Rule Pattern")
  t.type_text("docs.google.com/spreadsheets")
  t.press("Match by Prefix")
  t.press("Open in Quick Window")
  t.frame(ms=16.0)
  debug_assert(t.find("Links starting with docs.google.com/spreadsheets").is_some(), "prefix preview")
  t.press("Add Rule")
  t.frame(ms=16.0)
  debug_assert(rules.untracked().length() == 2 && rules.untracked()[1].open_in_quick_window && rules.untracked()[1].match_kind == "prefix", "quick window prefix rule")
  // Toggle the first off.
  t.press("Enable rule *.github.com")
  t.frame(ms=16.0)
  debug_assert(!rules.untracked()[0].enabled && rules.untracked()[1].enabled, "toggled off")
  // Edit the first: its pattern comes into the form; Save keeps its id.
  t.press("Edit rule *.github.com")
  t.frame(ms=16.0)
  debug_assert(t.get("Save Rule").is_some() && t.get("Cancel").is_some(), "editing")
  t.press("Open in Work")
  t.press("Save Rule")
  t.frame(ms=16.0)
  debug_assert(rules.untracked().length() == 2 && rules.untracked()[0].target_space_id == "work" && rules.untracked()[0].id == r0.id, "saved in place")
  debug_assert(t.get("Add Rule").is_some(), "back to adding")
  // Delete the second.
  t.press("Delete rule docs.google.com/spreadsheets")
  t.frame(ms=16.0)
  debug_assert(rules.untracked().length() == 1 && t.get("Delete rule docs.google.com/spreadsheets").is_none(), "deleted")
  lg::assert_apple_ui(t, label="atc-editor")
  t.dispose()
}

test "Library Archived Tabs: the record lists with Restore and Clear, searchable, closed tabs below" {
  lg::set_dark(Some(false))
  let ctrl = make_demo_controller(dark=false)
  let state = SidebarModeState::new()
  let restored : Array[String] = []
  let cleared : signals::Ref[Int] = ui::ref_new(0)
  let archived : signals::Signal[Array[proto::ArchivedTabItem]] = signals::signal(demo_library_archived(100000L))
  let base = demo_sidebar_modes(ctrl, state)
  let modes = SidebarModeProps::{
    ..base,
    library: LibraryProps::{
      ..base.library,
      closed_tabs: fn() { demo_library_closed(100000L) },
      archived_tabs: fn() { archived.get() },
      now_secs: fn() { 100000L },
      on_restore_archived: fn(id) {
        restored.push(id)
        archived.set(proto::archived_tabs_remove(archived.untracked(), id))
      },
      on_clear_archived: fn() {
        cleared.v += 1
        archived.set([])
      },
    },
  }
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
        build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) }, backdrop=DemoBackdrop::EditorialLight)
      })
      let hooks = ShellHostHooks::{ ..ShellHostHooks::empty(), sidebar_modes: Some(modes) }
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, hooks=Some(hooks))
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  let settle = fn() {
    let mut i = 0
    while i < 20 {
      t.frame(ms=16.0)
      i += 1
    }
  }
  settle()
  t.press("Library")
  settle()
  t.press("Archived Tabs")
  settle()
  debug_assert(t.find("2 Archived Tabs").is_some(), "count header")
  debug_assert(t.get("Restore Release checklist").is_some() && t.get("Restore Q3 planning notes").is_some(), "Restore on each")
  debug_assert(t.find("Recently Closed").is_some() && t.get("Reopen Pion language tour").is_some(), "closed tabs below")
  t.press("Restore Release checklist")
  t.frame(ms=16.0)
  debug_assert(restored.length() == 1 && restored[0] == "901", "restored by id")
  debug_assert(t.find("1 Archived Tab").is_some(), "one left")
  t.press("Clear Archived Tabs")
  t.frame(ms=16.0)
  t.frame(ms=200.0)
  debug_assert(cleared.v == 1 && t.get("Restore Q3 planning notes").is_none(), "cleared")
  debug_assert(t.find("Recently Closed").is_none(), "no caption without archived ones")
  t.dispose()
}
