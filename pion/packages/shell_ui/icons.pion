  ]
}

///| The outlines of icon `name` in a `size`-point square: the icon pack's when it has the name, else invar's.
pub fn shell_icon_shapes(
  name : String,
  size : Double,
  ink : Int64,
  weight~ : icons::IconWeight = icons::IconWeight::Regular,
) -> Array[paint::Shape] {
  if !(size > 0.0) {
    return []
  }
  let w = match weight {
    Thin => 1.35
    Regular => 1.75
    Medium => 2.0
    Semibold => 2.25
  }
  let scale = size / 24.0
  match icon_pack::pack_shapes(name, scale, ink, ui::dmax(1.0, w * icon_pack::pack_stroke_ratio() * scale)) {
    Some(shapes) => shapes
    None => icons::icon_shapes(name, size, ink, weight=weight)
  }
}

///| The name of the icon pack this build draws: "central" or "invar".
pub fn shell_icon_pack() -> String {
  icon_pack::pack_name()
}

///| Renders a crisp vector icon with reactive color.
pub fn shell_icon(
  parent : view::View,
  name : String,
  size~ : Double = 15.0,
  color_by~ : () -> Int64,
  weight~ : icons::IconWeight = icons::IconWeight::Regular,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .points(view::Live::Is(false))
    .shapes(view::Live::Is(shell_icon_shapes(name, size, 0x01010100L, weight=weight)))
    .tint(view::Live::By(color_by), loc=loc)
  })
}

///| `shell_icon` as a Pion-JSX element: `<ShellIcon name={ICON_PLAY} size={IC_MD} color_by=>{ink} />`.
pub fn ShellIcon(
  parent : view::View,
  name~ : String,
  size~ : Double = 16.0,
  color_by~ : () -> Int64,
  loc~ : String = "",
) -> view::View {
  shell_icon(parent, name, size=size, color_by=color_by, loc=loc)
}

///| Renders a crisp vector icon with both reactive name and reactive color.
pub fn shell_icon_by(
  parent : view::View,
  name_by : () -> String,
  size~ : Double = 15.0,
  color_by~ : () -> Int64,
  weight~ : icons::IconWeight = icons::IconWeight::Regular,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .points(view::Live::Is(false))
    .shapes(view::Live::By(fn() { shell_icon_shapes(name_by(), size, 0x01010100L, weight=weight) }))
    .tint(view::Live::By(color_by), loc=loc)
  })
}

///| A vector icon turned `turn_by` radians (read on the icon's node) about its middle as that changes (a folder's chevron turning right ->
///| down). The turn is put into the drawn outlines themselves: invar binds View::turn in the Place phase while the
///| drawn scene copies the turn with the node's look, so a turn changed alone after the node is first drawn is never
///| redrawn (deps/invar view_props.pion View::turn, view_tree.pion Tree::made_again; to fix upstream: Turn marking the
///| look). New outlines each turn are a look change, drawn the frame they are made.
pub fn shell_icon_turned(
  parent : view::View,
  name : String,
  turn_by : (view::View) -> Double,
  size~ : Double = 15.0,
  color_by~ : () -> Int64,
) -> view::View {
  let base = shell_icon_shapes(name, size, 0x01010100L)
  parent.box(fn(node : view::View) -> Unit {
    let _ = node
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .points(view::Live::Is(false))
    .shapes(view::Live::By(fn() { shell_shapes_turned(base, turn_by(node), size / 2.0, size / 2.0) }))
    .tint(view::Live::By(color_by))
  })
}

///| `shapes` with every outline point turned `r` radians about `(cx, cy)` (outlines are flat x, y pairs).
pub fn shell_shapes_turned(shapes : Array[paint::Shape], r : Double, cx : Double, cy : Double) -> Array[paint::Shape] {
  if r == 0.0 {
    return shapes
  }
  let c = dmath::cos(r)
  let sn = dmath::sin(r)
  let out : Array[paint::Shape] = []
  for sh in shapes {
    let outs : Array[(Array[Double], Bool)] = []
    for o in sh.outlines {
      let (pts, closed) = o
      let q : Array[Double] = []
      let mut i = 0
      while i + 1 < pts.length() {
        let dx = pts[i] - cx
        let dy = pts[i + 1] - cy
        q.push(cx + dx * c - dy * sn)
        q.push(cy + dx * sn + dy * c)
        i += 2
      }
      outs.push((q, closed))
    }
    out.push({ ..sh, outlines: outs })
  }
  out
}
