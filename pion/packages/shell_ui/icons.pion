///| Vector icon catalog for Farview Desktop Shell 2.0.
///| Every icon is drawn through `shell_icon_shapes`: from the icon pack `deps/icon_pack` (Central Icons in Farview's
///| own builds, `FV_ICONS=central sh tools/deps_icons.sh`), else from invar's open `packages/icons` by the same name.
///| Never call `icons::icon_node` / `icons::Icon` / `icons::icon_shapes` directly in shell_ui.

import "dmath"
import "icon_pack"
import "icons"
import "ui"
import "paint"
import "view"

