///| All icon names referenced anywhere in `shell_ui`.
///| Unit tests assert every entry produces non-empty vector geometry from `packages/icons`.
pub fn shell_icon_names() -> Array[String] {
  [
    ICON_SIDEBAR,
    ICON_BACK,
    ICON_FORWARD,
    ICON_RELOAD,
    ICON_STOP,
    ICON_LOCK,
    ICON_SHIELD,
    ICON_SEARCH,
    ICON_BOOKMARK,
    ICON_STAR,
    ICON_STAR_FILLED,
    ICON_SPLIT,
    ICON_READER,
    ICON_DOWNLOAD,
    ICON_SPARKLES,
    ICON_DRAWER,
    ICON_SETTINGS,
    ICON_MORE,
    ICON_CLOSE,
    ICON_PLUS,
    ICON_FOLDER,
    ICON_CHEVRON_DOWN,
    ICON_CHEVRON_RIGHT,
    ICON_PLAY,
    ICON_PAUSE,
    ICON_VOLUME,
    ICON_VOLUME_MUTE,
    ICON_GLOBE,
    ICON_COPY,
    ICON_EXTERNAL,
    ICON_SUN,
    ICON_MOON,
    ICON_COMMAND,
    ICON_PIN,
    ICON_CHECK,
    ICON_ZAP,
    ICON_LAYERS,
    ICON_CLOCK,
  ]
}

///| Renders a crisp vector icon from `packages/icons` with reactive color.
pub fn shell_icon(
  parent : view::View,
  name : String,
  size~ : Double = 15.0,
  color_by~ : () -> Int64,
  weight~ : icons::IconWeight = icons::IconWeight::Regular,
  loc~ : String = "",
) -> view::View {
  icons::icon_node(parent, name, size=size, ink=color_by, weight=weight, loc=loc)
}
