///| Monochrome glyph tiles for the panels built after the "too many colored icons" rule (Site controls, the Boost
///| editor): a neutral gray tile with an ink glyph (in dark a light gray tile on the dark card with a white glyph).
///| Color is kept for what it says (security state, a destructive action), never for a list's identity.

import "lg"
import "view"

///| The tile's ground: ink at a low alpha over the card it sits on (a quiet gray in both appearances).
fn mono_tile_ground() -> Int64 {
  lg::alpha(lg::surface().ink, if lg::is_dark() { 0.16 } else { 0.08 })
}

///| A neutral tile `size` square (`round`: a circle) with `icon_by`'s glyph in ink.
fn mono_tile(parent : view::View, icon_by : () -> String, size~ : Double = SP_32, round~ : Bool = true) -> view::View {
  parent.box(fn(tile : view::View) -> Unit {
    let _ = tile
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(if round { size / 2.0 } else { shell_tile_radius(size) }))
    .ground(view::Live::By(mono_tile_ground))
    .points(view::Live::Is(false))
    .center()
    let _ = shell_icon_by(tile, icon_by, size=shell_tile_glyph(size), color_by=fn() { lg::surface().ink })
  })
}
