///| Tier 1 automated audit suite for `pion/packages/shell_ui` (S1–S8 full closure):
///| - Real `t.set_a11y(true)` enabled on every audited scene
///| - Exact-label-only upstream `invar/packages/lg` hit-target exemptions (Clear 18x18 & 32pt menu items)
///| - >= 32pt frame control hit targets (docked sidebar top rows and the narrow toolbar)
///| - S1: Reactive keyed Omnibox suggestions, live `OmniboxRequestGate`, Click == Enter parity
///| - S2: Reactive keyed Sidebar lists (Favorites, Folders, Tabs, Spaces)
///| - S3: Reactive HTTPS/HTTP/Edit/Internal security icon, full URL in Field, edit guard, Esc restore, click-outside
///| - S4: Dual-pane focus routing, `headless::dialog` Tab/Shift+Tab focus trap + return_focus, IME guard
///| - S5: 480pt narrow sidebar drawer toggle, 480pt Back button, Split 1280->480->1280 stability
///| - S8: `MotionProbe` 60/120/24/7 fps steady + cross-FPS same-timestamp trajectory convergence.

import "icons"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

///| Rests the pointer on the address field (Page Controls shows only while the capsule is hovered).
fn hover_address(t : ui::Tester) -> Unit {
  match t.get("Address Bar") {
    Some(ab) => t.move_to(ab.x + ab.w / 2.0, ab.y + ab.h / 2.0)
    None => debug_assert(false, "Address Bar present to hover")
  }
  t.frame(ms=16.0)
}

fn step_frames(t : ui::Tester, n : Int, ms : Double) -> Unit {
  let mut i = 0
  while i < n {
    t.frame(ms=ms)
    i += 1
  }
}

///| Exact-label exemption ONLY for known upstream `invar/packages/lg` sub-36pt internals:
///| 1. `ctrl_clear_button` inside `liquid_search_bar_node` (`room: Clear (18x18 < 36pt)`)
///| 2. `ovl_menu_item_h = 32pt` rows inside `liquid_menu_node` (exact item labels only)
fn is_known_upstream_lg_room_fault(f : String, allow_menu_items : Bool) -> Bool {
  if f == "room: Clear (18x18 < 36pt)" {
    return true
  }
  if allow_menu_items {
    let menu_labels = [
      "room: New Tab (",
      "room: Reload Page (",
      "room: Forward (",
      "room: Toggle Split View (",
      "room: Toggle Reader Mode (",
      "room: Export PDF… (",
      "room: Dark Appearance (",
    ]
    let mut i = 0
    while i < menu_labels.length() {
      if f.starts_with(menu_labels[i]) && f.ends_with("x32 < 36pt)") {
        return true
      }
      i += 1
    }
  }
  false
}

///| A contrast fault on a one-character text node (a tile monogram such as `G` or `S`).
fn is_tile_monogram_fault(f : String) -> Bool {
  let head = "contrast: "
  if !f.starts_with(head) {
    return false
  }
  let rest = f.slice(head.length(), f.length())
  rest.length() > 8 && rest.slice(1, 8) == " ratio="
}

///| Number of drawn text runs reading exactly `s` inside the docked sidebar column (x < sidebar width).
fn sidebar_text_count(t : ui::Tester, s : String) -> Int {
  let drawn = t.drawn()
  let mut n = 0
  let mut i = 0
  while i < drawn.length() {
    let d = drawn[i]
    if d.words == s && d.alpha > 0.05 && d.w > 0.5 && d.x < SHELL_SIDEBAR_W_WIDE {
      n += 1
    }
    i += 1
  }
  n
}

fn audit_scene(
  t : ui::Tester,
  label : String,
  allow_large_overlay~ : Bool = false,
  allow_menu_items~ : Bool = false,
) -> Unit {
  // Explicitly enable a11y tree synchronization so `a11y_faults()` is genuinely active (S8)!
  t.set_a11y(true)
  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label=label, allow_large_overlay=allow_large_overlay)
  t.assert_scrollable(label=label)
  // Text contrast (WCAG 4.5:1 / 3:1 large). One-glyph monograms on solid site / favorite tiles are icons
  // (white glyph on a system color, the settings-tile idiom), not reading text, so they are left out here.
  let contrast_real : Array[String] = []
  for f in t.contrast_faults() {
    if !is_tile_monogram_fault(f) {
      contrast_real.push(f)
    }
  }
  if contrast_real.length() > 0 {
    let mut msg = "contrast_faults failed in \{label} (\{contrast_real.length()} fault(s)):"
    for f in contrast_real {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
  let craft = t.ui_craft_audit()
  let real_faults : Array[String] = []
  for f in craft {
    if !is_known_upstream_lg_room_fault(f, allow_menu_items) {
      real_faults.push(f)
    }
  }
  if real_faults.length() > 0 {
    let mut msg = "ui_craft_audit failed in \{label} (\{real_faults.length()} fault(s)):"
    for f in real_faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
  let a11y = t.a11y_faults()
  if a11y.length() > 0 {
    let mut msg = "a11y_faults in \{label} (\{a11y.length()}):"
    for f in a11y {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

test "shell_ui: all icon names resolve to non-empty vector shapes" {
  let names = shell_icon_names()
  debug_assert(names.length() >= 30, "expected >= 30 shell icons")
  let mut i = 0
  while i < names.length() {
    let name = names[i]
    let shapes = icons::icon_shapes(name, 16.0, 0x1C1C1EFFL)
    debug_assert(shapes.length() > 0, "missing vector icon in packages/icons: " + name)
    i += 1
  }
}

test "shell_ui: stage mount invariants across sidebar, resize, split, peek, swap, and narrow split" {
  let ctrl = make_demo_controller()
  let primary_live = ui::ref_new(0)
  let primary_mounts = ui::ref_new(0)
  let secondary_live = ui::ref_new(0)
  let secondary_mounts = ui::ref_new(0)
  let events : Array[String] = []

  let slot = PaneSlot::new(fn(parent : view::View, pane : PaneId) -> Unit {
    match pane {
      PaneId::Primary => {
        let _ = signals::effect_cleanup(fn() -> () -> Unit {
          primary_live.v = primary_live.v + 1
          primary_mounts.v = primary_mounts.v + 1
          events.push("mount:primary")
          fn() -> Unit {
            primary_live.v = primary_live.v - 1
            events.push("unmount:primary")
          }
        })
      }
      PaneId::Secondary => {
        let _ = signals::effect_cleanup(fn() -> () -> Unit {
          secondary_live.v = secondary_live.v + 1
          secondary_mounts.v = secondary_mounts.v + 1
          events.push("mount:secondary")
          fn() -> Unit {
            secondary_live.v = secondary_live.v - 1
            events.push("unmount:secondary")
          }
        })
      }
    }
    build_demo_pane(parent, pane, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) })
  })

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "initial primary mounted once")
  debug_assert(secondary_live.v == 0 && secondary_mounts.v == 0, "initial secondary unmounted")

  // Sidebar toggle
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "sidebar toggle preserves primary stage")

  // Responsive resize 1280 -> 760 -> 480 -> 1280
  t.resize(760.0, 800.0)
  t.frame(ms=16.0)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "resize preserves primary stage")

  // Single -> Split (Secondary 0 -> 1), then Split at 1280 -> 480 -> 1280 (S5)
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "split keeps primary delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "split mounts secondary once")
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && secondary_live.v == 1 && secondary_mounts.v == 1, "split survives 480pt without remount")
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && secondary_live.v == 1 && secondary_mounts.v == 1, "split survives 480->1280 without remount")

  // Swap panes + Split -> Peek -> Split (0 remounts!)
  ctrl.dispatch(ShellIntent::SwapSplitPanes)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OpenPeek("https://example.org/peek"))
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::PromotePeekToSplit)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "swap/peek keeps primary delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "peek<->split reuses secondary stage")

  // Close Secondary -> clean unmount, then re-open -> old cleanup strictly precedes new mount
  ctrl.dispatch(ShellIntent::CloseSecondaryPane)
  t.frame(ms=16.0)
  debug_assert(secondary_live.v == 0, "close secondary unmounts immediately")
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 2, "re-open split mounts fresh secondary")
  let n_ev = events.length()
  debug_assert(
    n_ev >= 4 && events[n_ev - 2] == "unmount:secondary" && events[n_ev - 1] == "mount:secondary",
    "old secondary cleanup precedes new mount",
  )

  t.dispose()
}

test "shell_ui: S1 reactive Omnibox suggestions, live request gate, and Click == Enter parity" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Type "alpha" -> gate dispatches "alpha"
  ctrl.dispatch(ShellIntent::OmniboxEdit("alpha"))
  t.frame(ms=16.0)
  debug_assert(ctrl.dispatched_omnibox_queries.length() == 1 && ctrl.dispatched_omnibox_queries[0] == "alpha", "dispatches alpha")

  // Type "beta" while "alpha" is in flight -> coalesced as pending, NOT dispatched yet
  ctrl.dispatch(ShellIntent::OmniboxEdit("beta"))
  t.frame(ms=16.0)
  debug_assert(ctrl.dispatched_omnibox_queries.length() == 1, "max 1 in-flight query")

  // Stale results for "alpha" arrive -> dropped, gate dispatches "beta" next!
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://stale-alpha.example", title: "Stale Alpha", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(t.find("Stale Alpha").is_none(), "stale alpha results dropped from UI")
  debug_assert(ctrl.dispatched_omnibox_queries.length() == 2 && ctrl.dispatched_omnibox_queries[1] == "beta", "pending beta dispatched next")

  // Fresh results for "beta" arrive (including a real-URL SwitchTab candidate with suggestion-only title!)
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://soma.fm/groovesalad", title: "Switch: Ambient Synth Radio", visits: 9, score: 99.0, switch_to_tab: true },
      proto::OmniboxItem::{ url: "https://beta.example", title: "Beta Docs", visits: 4, score: 50.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(t.find("Beta Docs").is_some(), "reactive each renders updated Beta Docs row")
  debug_assert(t.get("Beta Docs").is_some(), "a11y label updates live to Beta Docs")

  // Verify real click on suggestion row (unambiguous title NOT in sidebar!) selects stable tab_id t3
  t.press("Switch: Ambient Synth Radio")
  t.frame(ms=16.0)
  debug_assert(ctrl.url.untracked() == "https://soma.fm/groovesalad", "click SwitchTab activates t3 by URL")
  let mut active_id_click = ""
  let mut ti = 0
  while ti < ctrl.tabs.untracked().length() {
    if ctrl.tabs.untracked()[ti].active {
      active_id_click = ctrl.tabs.untracked()[ti].id
    }
    ti += 1
  }
  debug_assert(active_id_click == "t3", "click SwitchTab resolved stable tab_id t3")

  // Astra #1: real click on Clear (`×`) button clears field, closes suggestions, invalidates gate, Enter does NOT navigate!
  t.press("Address Bar")
  t.frame(ms=16.0)
  let url_before_clear = ctrl.url.untracked()
  ctrl.omnibox_field.set("webkit")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "suggestions open before clicking Clear")
  // Arc's palette has no Clear button: the field is cleared by editing it (select all, delete).
  debug_assert(t.get("Clear").is_none(), "no Clear button in the Arc palette")
  ctrl.omnibox_field.set("")
  ctrl.dispatch(ShellIntent::OmniboxEdit(""))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "", "clicking Clear empties field")
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "clicking Clear closes suggestions")
  // Late results for old query must NOT reopen popup after Clear!
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://stale-after-clear.example", title: "Stale Clear", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Stale Clear").is_none(), "late results after Clear dropped")
  t.enter()
  t.frame(ms=16.0)
  debug_assert(ctrl.url.untracked() == url_before_clear, "Enter after Clear does NOT navigate to stale suggestion")
  ctrl.dispatch(ShellIntent::OmniboxEscape)
  t.frame(ms=16.0)

  // Opus U2 + Astra #2: suggestions open -> click sidebar tab closes suggestions, updates URL, drops late results!
  t.press("Address Bar")
  t.frame(ms=16.0)
  ctrl.omnibox_field.set("webkit")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "suggestions open before clicking sidebar tab")
  t.press("WPT Dashboard: css")
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "clicking sidebar tab closes Omnibox suggestions")
  debug_assert(!(ctrl.exclusive.untracked().active is ExclusiveKind::OmniboxSuggest), "exclusive cleared after sidebar tab click")
  debug_assert(ctrl.omnibox_field.text() == "https://wpt.fyi/results/css", "Address Bar updated to clicked sidebar tab URL")
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://late-after-tab.example", title: "Late After Tab", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Late After Tab").is_none(), "late results after sidebar tab click dropped")

  // Opus U2 + Astra #2: suggestions open -> clicking topbar button (Reload) closes suggestions & drops late results!
  t.press("Address Bar")
  t.frame(ms=16.0)
  ctrl.omnibox_field.set("webkit")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  t.press("Reload")
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "clicking topbar Reload closes suggestions")
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://late-after-reload.example", title: "Late After Reload", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Late After Reload").is_none(), "late results after Reload dropped")

  // Round 5 (Astra #1 + Opus Tab): hover-free Tab focus-leave!
  // Keep mouse pointer parked ON TOP OF Address Bar the entire time so hover (`pointed`/`pointed_in`) is true.
  match t.get("Address Bar Host") {
    Some(host) => {
      t.move_to(host.x + 24.0, host.y + host.h * 0.5)
      t.frame(ms=16.0)
    }
    None => debug_assert(false, "Address Bar Host present for hover-parked Tab test")
  }
  let url_before_tab = ctrl.url.untracked()
  t.press("Address Bar")
  t.frame(ms=16.0)
  ctrl.omnibox_field.set("webkit")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open && ctrl.omnibox_editing.untracked(), "suggestions open before Tab")

  // Tab once -> lands on the info button (`Keyboard Hints`) inside the palette: MUST stay in editing mode!
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_editing.untracked(), "Tabbing to the info button inside the palette keeps editing active")
  t.enter()
  t.frame(ms=16.0)
  debug_assert(t.find("Navigate").is_some(), "Enter on the focused info button shows the keyboard hints")
  debug_assert(ctrl.omnibox_field.focused() && ctrl.omnibox_field.text() == "webkit", "the field gets the focus back, text kept")

  // Re-open suggestions while mouse pointer STILL hovers Address Bar, then Tab out past Clear to external button!
  ctrl.omnibox_field.set("webkit")
  ctrl.omnibox_field.focus()
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  match t.get("Address Bar Host") {
    Some(host) => t.move_to(host.x + 24.0, host.y + host.h * 0.5)
    None => ()
  }
  t.frame(ms=16.0)
  // Tab past Clear: suggestion rows are arrow-key targets, so the next stop is outside the palette
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "Tab out of Address Bar closes suggestions even while pointer hovers capsule")
  debug_assert(!ctrl.omnibox_editing.untracked(), "Tab out sets omnibox_editing == false")
  debug_assert(!ctrl.omnibox_field.focused(), "Tab out calls omnibox_field.let_go()")
  debug_assert(
    ctrl.omnibox_field.text() == proto::omnibox_safe_display_url(url_before_tab),
    "Tab out restores safe display URL: got=" + ctrl.omnibox_field.text(),
  )
  // Late results after Tab-out must NOT reopen popup
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://late-after-tab-out.example", title: "Late Tab Out", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Late Tab Out").is_none(), "late results after Tab-out dropped")
  // Pressing Enter on the focused external button must NOT navigate the Address Bar!
  t.enter()
  t.frame(ms=16.0)
  debug_assert(ctrl.url.untracked() == url_before_tab, "Enter on external button does NOT navigate Address Bar")

  // Round 6 (G2 + Astra exact acceptance test — NO manual focus()!):
  // Focus Address Bar -> type "ab" -> Tab to Clear (do NOT activate) -> Shift+Tab back -> type "c" -> "abc" + suggestions updated!
  t.press("Address Bar")
  t.frame(ms=16.0)
  t.type_text("ab")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "ab", "typed draft is ab")
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_editing.untracked(), "Tab to Clear keeps editing active")
  t.key(proto::KEY_TAB, mods=proto::SHORTCUT_MOD_SHIFT)
  t.frame(ms=16.0)
  t.type_text("c")
  t.frame(ms=16.0)
  debug_assert(
    ctrl.omnibox_field.text() == "abc",
    "Shift+Tab back from Clear restores field focus & appends 'c' -> 'abc': got=" + ctrl.omnibox_field.text(),
  )
  debug_assert(
    ctrl.omnibox_suggest.untracked().open && ctrl.omnibox_suggest.untracked().query == "abc",
    "Omnibox suggestions updated live for 'abc'",
  )
  // Tab to Clear and press Esc -> restores verified URL and returns focus out of omnibox!
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_editing.untracked() && !ctrl.omnibox_field.focused(), "Esc on Clear exits editing and blurs field")
  debug_assert(
    ctrl.omnibox_field.text() == proto::omnibox_safe_display_url(url_before_tab),
    "Esc on Clear restores verified safe URL",
  )

  // Re-open with real-URL SwitchTab result and press Enter via real focused Field -> identical stable tab_id!
  // Drain any in-flight query from the "ab"/"abc" typing test before asserting fresh "wpt" results.
  ctrl.dispatch(ShellIntent::OmniboxResultsArrived([]))
  ctrl.dispatch(ShellIntent::OmniboxFocus)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OmniboxEdit("wpt"))
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://wpt.fyi/results/css", title: "WPT Layout Dashboard", visits: 5, score: 99.0, switch_to_tab: true },
    ]),
  )
  t.frame(ms=16.0)
  t.enter()
  t.frame(ms=16.0)
  debug_assert(ctrl.url.untracked() == "https://wpt.fyi/results/css", "Enter SwitchTab selects tab t4 identically to click")
  let mut active_id_enter = ""
  let mut tj = 0
  while tj < ctrl.tabs.untracked().length() {
    if ctrl.tabs.untracked()[tj].active {
      active_id_enter = ctrl.tabs.untracked()[tj].id
    }
    tj += 1
  }
  debug_assert(active_id_enter == "t4", "Enter SwitchTab resolved stable tab_id t4")

  // Stale SwitchTab candidate (tab already closed) -> navigates cleanly instead of deactivating all tabs!
  ctrl.dispatch(ShellIntent::OmniboxEdit("stale"))
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://closed-tab.example/old", title: "Closed Tab", visits: 1, score: 99.0, switch_to_tab: true },
    ]),
  )
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OmniboxSubmit("stale"))
  t.frame(ms=16.0)
  debug_assert(ctrl.url.untracked() == "https://closed-tab.example/old", "stale SwitchTab falls back to Navigate")
  let mut active_count = 0
  let mut tk = 0
  while tk < ctrl.tabs.untracked().length() {
    if ctrl.tabs.untracked()[tk].active {
      active_count += 1
    }
    tk += 1
  }
  debug_assert(active_count == 1, "stale SwitchTab NEVER deactivates all tabs")

  // Close suggestions, then late stale results arrive -> MUST NOT reopen popup!
  ctrl.dispatch(ShellIntent::OmniboxEdit("gamma"))
  ctrl.dispatch(ShellIntent::OmniboxClose)
  t.frame(ms=16.0)
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://late-gamma.example", title: "Late Gamma", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Late Gamma").is_none(), "late results after close never reopen suggestions")

  // Astra #4: Type query A -> open Drawer/Dialog -> late results for A arrive -> MUST NOT clobber Drawer/Dialog!
  ctrl.dispatch(ShellIntent::OmniboxEdit("delta"))
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::ToggleDrawer)
  t.frame(ms=16.0)
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Drawer, "Drawer opened")
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://late-delta.example", title: "Late Delta", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Drawer, "late Omnibox results never clobber Drawer")
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Late Delta").is_none(), "late Omnibox results suppressed while Drawer open")

  // Round 6 (G3): programmatic `OmniboxFocus` (⌘L equivalent, without clicking!) auto-selects full URL!
  ctrl.dispatch(ShellIntent::ToggleDrawer)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OmniboxFocus)
  t.frame(ms=16.0)
  let safe_now = proto::omnibox_safe_display_url(ctrl.url.untracked())
  let (g3_a, g3_b) = ctrl.omnibox_field.selection()
  debug_assert(
    g3_a == 0 && g3_b == safe_now.length(),
    "programmatic OmniboxFocus auto-selects full URL: got=(" + g3_a.to_string() + "," + g3_b.to_string() + ") len=" + safe_now.length().to_string(),
  )
  t.type_text("z")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "z", "typing 'z' after programmatic OmniboxFocus replaces whole URL")

  t.dispose()
}

test "shell_ui: S2 sidebar 4 keyed reactive lists (New Tab, CreateFolder, Space switch)" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Click New Tab twice, close first new tab, create third -> monotonic unique IDs (NEVER duplicate!)
  // The sidebar draws one row per tab of the active Space (no counter label): "New Tab" appears once (the button).
  debug_assert(sidebar_text_count(t, "New Tab") == 1, "initially only the New Tab button")
  debug_assert(sidebar_text_count(t, "WPT Dashboard: css") == 1, "initially the Today tab row is drawn")
  debug_assert(sidebar_text_count(t, "Designing for Reading") == 1, "initially the folder tab row is drawn")
  t.press("New Tab")
  t.frame(ms=16.0)
  let id_a = ctrl.tabs.untracked()[ctrl.tabs.untracked().length() - 1].id
  t.press("New Tab")
  t.frame(ms=16.0)
  let id_b = ctrl.tabs.untracked()[ctrl.tabs.untracked().length() - 1].id
  debug_assert(id_a != id_b, "two created tabs have distinct IDs")
  ctrl.dispatch(ShellIntent::CloseTab(id_a))
  t.frame(ms=16.0)
  t.press("New Tab")
  t.frame(ms=16.0)
  let id_c = ctrl.tabs.untracked()[ctrl.tabs.untracked().length() - 1].id
  debug_assert(id_c != id_a && id_c != id_b, "monotonic tab ID never collides after delete")
  let tabs_now = ctrl.tabs.untracked()
  let mut has_b = false
  let mut has_a = false
  let mut ti = 0
  while ti < tabs_now.length() {
    if tabs_now[ti].id == id_b { has_b = true }
    if tabs_now[ti].id == id_a { has_a = true }
    ti += 1
  }
  debug_assert(has_b && !has_a, "closing id_a removes only id_a and preserves id_b")
  debug_assert(sidebar_text_count(t, "New Tab") == 3, "two live New Tab rows plus the New Tab button")

  // CreateFolder -> visible folder row appears live!
  ctrl.dispatch(ShellIntent::CreateFolder("Design Specs"))
  t.frame(ms=16.0)
  debug_assert(t.find("Design Specs").is_some(), "keyed folders each renders new folder live")

  // Switch Space -> sidebar updates live!
  t.press("Space Life")
  t.frame(ms=16.0)
  debug_assert(ctrl.active_space_id.untracked() == "personal", "Space button switches active space")
  debug_assert(
    sidebar_text_count(t, "New Tab") == 1 && sidebar_text_count(t, "WPT Dashboard: css") == 0 &&
    sidebar_text_count(t, "Designing for Reading") == 0,
    "Life space reactively shows no Work tabs",
  )

  t.dispose()
}

test "shell_ui: S3 reactive security indicator, full URL in Field, edit guard, Esc restore, click-outside" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // 1. Idle field holds real full URL with scheme, and idle UI hides Clear `×` button
  debug_assert(
    ctrl.omnibox_field.text() == "https://notes.example.com/designing-for-reading",
    "idle omnibox holds real full HTTPS URL",
  )
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::SecureHttps, "HTTPS -> SecureHttps")
  debug_assert(t.get("Clear").is_none(), "idle unfocused Address Bar hides Clear × button")

  // 1b. IDN homograph protection: Cyrillic `аррӏе.com` MUST display as Punycode `xn--80ak6aa92e.com`!
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "https://аррӏе.com/login", "IDN Test"))
  t.frame(ms=16.0)
  debug_assert(
    ctrl.omnibox_field.text() == "https://xn--80ak6aa92e.com/login",
    "IDN homograph renders as Punycode: got=" + ctrl.omnibox_field.text(),
  )
  debug_assert(t.find("xn--80ak6aa92e.com").is_some(), "IDN Punycode visible in idle Address Bar")

  // 2. Switch HTTPS -> HTTP -> Internal on same tree (reactive security!)
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "http://insecure.example/test", "HTTP Page"))
  t.frame(ms=16.0)
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::InsecureHttp, "HTTP -> InsecureHttp")
  debug_assert(ctrl.omnibox_field.text() == "http://insecure.example/test", "field syncs when not editing")

  ctrl.dispatch(ShellIntent::NewTab)
  t.frame(ms=16.0)
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::InternalPage, "about:start -> InternalPage")

  // 3. Focusing Address Bar mounts full Field with scheme + auto-selects all (Opus U3)!
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "https://webkit.org/blog/tahoe-liquid-glass", "WebKit"))
  t.frame(ms=16.0)
  t.press("Address Bar")
  t.frame(ms=16.0)
  let full_u = "https://webkit.org/blog/tahoe-liquid-glass"
  debug_assert(
    ctrl.omnibox_field.text() == full_u,
    "focused Address Bar preserves full URL with scheme",
  )
  let (sel_a, sel_b) = ctrl.omnibox_field.selection()
  debug_assert(
    sel_a == 0 && sel_b == full_u.length(),
    "initial click on idle Address Bar auto-selects all",
  )
  // Typing 'z' replaces the entire selected URL -> "z"; typing 'x' while already editing appends -> "zx"
  t.type_text("z")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "z", "typing z after initial focus replaces whole URL: got=" + ctrl.omnibox_field.text())
  t.type_text("x")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "zx", "typing x while already editing appends without re-selecting all: got=" + ctrl.omnibox_field.text())

  ctrl.omnibox_field.set("bank.com")
  ctrl.dispatch(ShellIntent::OmniboxEdit("bank.com"))
  t.frame(ms=16.0)
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::EditingSearch, "editing bank.com NEVER shows HTTPS lock")
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "https://async-bg.example/nav", "BG"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "bank.com", "async nav must not overwrite active user edit")

  // 4. Click outside suggestions overlay restores verified URL & security icon (NO spoofed bank.com + lock!)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "suggestions open before outside click")
  // The palette has no scrim: a press anywhere outside it closes it (and still reaches the page).
  match t.get("Omnibox Suggestions") {
    Some(box) => {
      debug_assert(box.y + box.h < 760.0, "palette leaves page below it to click")
      t.click(box.x + 20.0, 780.0)
      t.frame(ms=16.0)
      debug_assert(!ctrl.omnibox_suggest.untracked().open, "click outside closes suggestions")
      debug_assert(
        ctrl.omnibox_field.text() == "https://async-bg.example/nav",
        "click outside restores verified URL (no leftover bank.com): got=" + ctrl.omnibox_field.text(),
      )
      debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::SecureHttps, "restored URL restores SecureHttps")
    }
    None => debug_assert(false, "Omnibox Suggestions palette missing")
  }

  // 5. Clear Address Bar -> click page -> exits editing cleanly so next async nav syncs!
  t.press("Address Bar")
  t.frame(ms=16.0)
  ctrl.omnibox_field.set("")
  ctrl.dispatch(ShellIntent::OmniboxEdit(""))
  t.frame(ms=16.0)
  t.press("Primary Pane Focus")
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_editing.untracked(), "clicking page after clearing Address Bar exits editing")
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "https://next.example/landing", "Next"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "https://next.example/landing", "subsequent async nav syncs cleanly")

  // 6. Security lock defense: even if editing=false, mismatched field text NEVER shows SecureHttps!
  ctrl.omnibox_field.set("https://spoofed.evil")
  debug_assert(
    ctrl.model().omnibox_security() is OmniboxSecurity::EditingSearch,
    "mismatched field text NEVER shows HTTPS lock",
  )

  t.dispose()
}

test "shell_ui: S4 dual-pane focus routing, headless::dialog Tab focus trap + return_focus, and IME guard" {
  let ctrl = make_demo_controller(split=true)
  let root_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t = ui::Tester::tree(
    fn(root) {
      root_ref.v = Some(root)
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model(), emit=fn(e) { ctrl.dispatch(e) }) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  let focused_id_now = fn() -> Option[view::NodeId] {
    match root_ref.v {
      Some(r) => r.tree.focused
      None => None
    }
  }

  // Clicking focusable control inside Secondary pane routes focus + address bar + Reader toggle to Secondary!
  t.press("Secondary Pane Focus")
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().active_pane is PaneId::Secondary, "clicking secondary pane sets active_pane = Secondary")
  debug_assert(ctrl.omnibox_field.text() == "https://drafts.csswg.org/css-grid-3/", "address bar updates to Secondary URL")

  // Reader Mode is a toggle in the Page Controls drawer (shown while the address capsule is hovered).
  hover_address(t)
  t.press("Page Controls")
  step_frames(t, 25, 16.0)
  debug_assert(ctrl.page.untracked().active_pane is PaneId::Secondary, "opening Page Controls keeps Secondary active")
  t.press("Reader Mode")
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().secondary_surface is PaneSurface::Reader, "Reader toggle affects active Secondary pane")
  ctrl.dispatch(ShellIntent::ToggleDrawer)
  step_frames(t, 25, 16.0)
  debug_assert(ctrl.page.untracked().primary_surface is PaneSurface::Web, "Primary pane surface remains untouched")

  // Astra #3: SwitchTab from Secondary pane keeps active_pane (Primary), visible URL, Address Bar, and active tab strictly consistent!
  ctrl.dispatch(ShellIntent::OmniboxEdit("soma"))
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://soma.fm/groovesalad", title: "Switch: Groove Salad", visits: 9, score: 99.0, switch_to_tab: true },
    ]),
  )
  t.frame(ms=16.0)
  t.press("Switch: Groove Salad")
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().active_pane is PaneId::Primary, "SwitchTab from Secondary focuses Primary pane")
  debug_assert(ctrl.url.untracked() == "https://soma.fm/groovesalad", "SwitchTab updates Primary URL")
  debug_assert(ctrl.omnibox_field.text() == "https://soma.fm/groovesalad", "SwitchTab updates Address Bar to target tab URL")
  let mut active_tid_after_split_sw = ""
  let mut si = 0
  while si < ctrl.tabs.untracked().length() {
    if ctrl.tabs.untracked()[si].active { active_tid_after_split_sw = ctrl.tabs.untracked()[si].id }
    si += 1
  }
  debug_assert(active_tid_after_split_sw == "t3", "SwitchTab from Secondary activates tab t3 consistently")

  let is_focused_label = fn(lbl : String) -> Bool {
    match (focused_id_now(), t.get(lbl)) {
      (Some(fid), Some(b)) => fid == b.id
      _ => false
    }
  }

  // Opus U1: Modal Dialog scrim MUST block pointer pass-through to Reload, Sidebar tab, Address Bar, and Canvas!
  let underlying_targets = ["Reload", "WPT Dashboard: css", "Address Bar", "Primary Pane Focus"]
  let mut ui_idx = 0
  while ui_idx < underlying_targets.length() {
    let target_lbl = underlying_targets[ui_idx]
    match t.get(target_lbl) {
      Some(tbox) => {
        ctrl.last_intent.set("before_dialog")
        ctrl.dispatch(ShellIntent::OpenDialog)
        t.frame(ms=16.0)
        debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "Dialog open before scrim click: " + target_lbl)
        t.click(tbox.x + tbox.w * 0.5, tbox.y + tbox.h * 0.5)
        t.frame(ms=16.0)
        debug_assert(
          !(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog),
          "clicking scrim over " + target_lbl + " closes Dialog",
        )
        debug_assert(
          ctrl.last_intent.untracked() == "before_dialog",
          "scrim blocked pass-through to " + target_lbl + ": got last_intent=" + ctrl.last_intent.untracked(),
        )
        debug_assert(is_focused_label("More Actions"), "scrim close returns focus to More Actions")
      }
      None => debug_assert(false, "missing underlying control for scrim test: " + target_lbl)
    }
    ui_idx += 1
  }

  // Opus W1 + Astra #2: clicking INSIDE Dialog glass card (title, description, top-left padding, left of Cancel)
  // MUST keep Dialog open (never fall through to scrim)!
  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=16.0)
  match (t.find("Export Page as PDF"), t.get("Cancel")) {
    (Some((tx, ty)), Some(cbox)) => {
      // 1. Click Dialog title
      t.click(tx, ty)
      t.frame(ms=16.0)
      debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "clicking Dialog title keeps Dialog open")
      // 2. Click Dialog description text
      t.click(tx, ty + 28.0)
      t.frame(ms=16.0)
      debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "clicking Dialog description keeps Dialog open")
      // 3. Click card top-left blank padding
      t.click(tx - 10.0, ty - 10.0)
      t.frame(ms=16.0)
      debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "clicking Dialog top-left padding keeps Dialog open")
      // 4. Click blank area left of Cancel button
      t.click(cbox.x - 40.0, cbox.y + cbox.h * 0.5)
      t.frame(ms=16.0)
      debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog, "clicking blank space left of Cancel keeps Dialog open")
      // 5. Clicking Cancel closes Dialog and returns focus to More Actions
      t.press("Cancel")
      t.frame(ms=16.0)
      debug_assert(!(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog), "clicking Cancel closes Dialog")
      debug_assert(is_focused_label("More Actions"), "Cancel close returns focus to More Actions")
    }
    _ => debug_assert(false, "Dialog title & Cancel button present for interior click test")
  }

  // Real modal Dialog Tab/Shift+Tab focus trap via `headless::dialog` + exact focused control assertions + return_focus!
  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=16.0)
  debug_assert(
    t.get("Cancel").is_some() && t.get("Export").is_some() && t.get("More Actions").is_some(),
    "modal dialog buttons & trigger mounted",
  )

  // Initial focus lands inside the modal dialog (first focusable button = Cancel)
  debug_assert(is_focused_label("Cancel"), "Dialog initial focus lands on Cancel")
  // Tab advances Cancel -> Export
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  debug_assert(is_focused_label("Export"), "Dialog Tab moves focus to Export")
  // Tab wraps inside modal trap Export -> Cancel (never escapes to background!)
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  debug_assert(is_focused_label("Cancel"), "Dialog Tab wraps back to Cancel inside modal trap")
  // Shift+Tab reverses Cancel -> Export
  t.key(proto::KEY_TAB, mods=proto::SHORTCUT_MOD_SHIFT)
  t.frame(ms=16.0)
  debug_assert(is_focused_label("Export"), "Dialog Shift+Tab reverses to Export")
  // Esc closes modal dialog AND returns focus to `More Actions` trigger!
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog), "real Esc closes modal dialog")
  debug_assert(is_focused_label("More Actions"), "Dialog Esc returns focus to More Actions trigger")

  // IME composition guard: focus Address Bar, start IME composition, press Esc -> NOT swallowed!
  t.press("Address Bar")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.focused(), "Address Bar is actually focused")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  ctrl.omnibox_field.compose("ni")
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "IME composing prevents focused Address Bar from stealing Escape")
  ctrl.omnibox_field.compose("")

  // Now press Esc when NOT composing -> closes suggestions, restores URL, AND returns focus out of omnibox_field!
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "non-composing Esc closes suggestions")
  debug_assert(!ctrl.omnibox_field.focused(), "Address Bar Esc hands focus back to active pane")

  t.dispose()
}

test "shell_ui: N6 command palette centers over the page column, min(640, column - 48) wide, inside the window, across 6 layouts" {
  let cases : Array[(String, Double, Bool, Option[Double])] = [
    ("1280_sidebar_open", 1280.0, true, None),
    ("1280_sidebar_closed_inset", 1280.0, false, Some(72.0)),
    ("900_sidebar_open", 900.0, true, None),
    ("760_sidebar_open", 760.0, true, None),
    ("640_closed_inset", 640.0, false, Some(72.0)),
    ("480_closed_inset", 480.0, false, Some(72.0)),
  ]
  let mut i = 0
  while i < cases.length() {
    let (name, w, sb_open, inset) = cases[i]
    let ctrl = make_demo_controller(omnibox_open=true, window_inset_override?=inset)
    if !sb_open {
      ctrl.dispatch(ShellIntent::ToggleSidebar)
      // Re-open omnibox after ToggleSidebar (ToggleSidebar closes open omnibox per U2!)
      ctrl.dispatch(ShellIntent::OmniboxEdit("grid"))
    }
    let t = ui::Tester::tree(
      fn(root) {
        build_shell_frame(
          root,
          ctrl.model(),
          fn(ev) { ctrl.dispatch(ev) },
          PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
        )
      },
      width=w,
      height=800.0,
      theme=lg::ui_theme,
    )
    step_frames(t, 20, 16.0)
    // The page column starts after the docked sidebar (none below 720pt or when hidden).
    let col_left = shell_sidebar_width(w, sb_open)
    let col_w = w - col_left
    let want_w = if col_w - SP_48 < SHELL_PALETTE_W { col_w - SP_48 } else { SHELL_PALETTE_W }
    match t.get("Omnibox Suggestions") {
      Some(pop) => {
        debug_assert(
          (pop.w - want_w).abs() <= 1.0,
          "palette width is min(640, column - 48) (" + name + "): w=" + pop.w.to_string() + " want=" + want_w.to_string(),
        )
        let center = pop.x + pop.w / 2.0
        let col_center = col_left + col_w / 2.0
        debug_assert(
          (center - col_center).abs() <= 1.0,
          "palette centered over the page column (" + name + "): center=" + center.to_string() + " column=" + col_center.to_string(),
        )
        debug_assert(
          pop.x >= col_left - 0.5 && pop.x + pop.w <= w + 0.5 && pop.y >= SP_48 - 0.5 && pop.y + pop.h <= 800.0,
          "palette stays inside the page column and the window (" + name + ")",
        )
        // Suggestion rows live inside the palette.
        match t.get("Grid by Example") {
          Some(row) => {
            debug_assert(
              row.x >= pop.x && row.x + row.w <= pop.x + pop.w + 0.5 && row.y >= pop.y && row.y + row.h <= pop.y + pop.h + 0.5,
              "suggestion row inside the palette (" + name + ")",
            )
            debug_assert(row.h >= SP_40 - 0.5, "suggestion row is at least 40pt tall (" + name + ")")
          }
          None => debug_assert(false, "suggestion row present: " + name)
        }
      }
      None => debug_assert(false, "Omnibox Suggestions palette present: " + name)
    }
    t.dispose()
    i += 1
  }
}

test "shell_ui: S5 480pt narrow sidebar drawer toggle & Back button" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=480.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Back button MUST remain directly accessible at 480pt!
  debug_assert(t.get("Back").is_some(), "480pt compact titleband preserves Back button")
  t.press("Back")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "back", "480pt Back button dispatches GoBack")

  // Toggle Sidebar opens Leading floating drawer at 480pt!
  t.press("Toggle Sidebar")
  step_frames(t, 20, 16.0)
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::SidebarDrawer, "480pt Toggle Sidebar opens SidebarDrawer")
  debug_assert(t.find("Tabs").is_some(), "480pt SidebarDrawer shows Tabs header")

  // Pressing Close inside drawer (or Escape) closes it cleanly
  t.press("Close")
  step_frames(t, 20, 16.0)
  debug_assert(!(ctrl.exclusive.untracked().active is ExclusiveKind::SidebarDrawer), "480pt SidebarDrawer closes cleanly")

  t.dispose()
}

///| The Address Bar's press box is at least 60% of the capsule it sits in (Arc keeps the URL field one wide target).
fn address_press_share_ok(t : ui::Tester, where_ : String) -> Unit {
  match (t.get("Address Bar"), t.get("Address Bar Host")) {
    (Some(ab), Some(cap)) => {
      debug_assert(cap.w > 0.0 && ab.w >= cap.w * 0.6 - 0.5, "address field >= 60% of the capsule (" + where_ + "): \{ab.w} of \{cap.w}")
      debug_assert(ab.h >= SP_32 - 0.5, "address field is 32pt tall (" + where_ + ")")
    }
    _ => debug_assert(false, "Address Bar and its capsule present (" + where_ + ")")
  }
}

test "shell_ui: S8 frame controls meet 32pt hit targets in the docked sidebar and in the narrow toolbar" {
  let ctrl = make_demo_controller()
  let slot = PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  let labels = ["Toggle Sidebar", "Back", "Forward", "Reload", "Address Bar", "More Actions"]

  // 1. Docked (1280): no toolbar. Navigation and the address field sit at the top of the sidebar,
  //    and the page card starts SHELL_CANVAS_GAP below the window top.
  let sb_w = shell_sidebar_width(1280.0, true)
  let address_bottom = SHELL_TOP_ROW_H + SHELL_CANVAS_GAP + SHELL_ADDRESS_H
  let mut i = 0
  while i < labels.length() {
    let lbl = labels[i]
    match t.get(lbl) {
      Some(box) => {
        debug_assert(box.x >= 0.0 && box.x + box.w <= sb_w + 0.5, "docked control inside the sidebar column: " + lbl)
        debug_assert(box.y >= 0.0 && box.y + box.h <= address_bottom + 0.5, "docked control in the sidebar top rows: " + lbl)
        debug_assert(box.w >= SP_32 - 0.5 && box.h >= SP_32 - 0.5, "docked control meets the 32pt hit target: " + lbl)
      }
      None => debug_assert(false, "docked control present: " + lbl)
    }
    i += 1
  }
  // HIT-01: at rest the address field is one wide target (>= 60% of the capsule); Page Controls appears on hover,
  // laid over the trailing end (the Address Bar's box does not change), and meets 32pt.
  address_press_share_ok(t, "docked 240")
  debug_assert(t.get("Page Controls").is_none(), "Page Controls is not in the resting capsule")
  let ab_rest = t.get("Address Bar")
  hover_address(t)
  match t.get("Page Controls") {
    Some(pc) => debug_assert(pc.w >= SP_32 - 0.5 && pc.h >= SP_32 - 0.5, "hovered Page Controls meets 32pt")
    None => debug_assert(false, "Page Controls shows while the capsule is hovered")
  }
  match (ab_rest, t.get("Address Bar")) {
    (Some(a), Some(b)) => debug_assert((a.w - b.w).abs() < 0.5, "hovering never reflows the address field")
    _ => debug_assert(false, "Address Bar present")
  }
  t.move_to(900.0, 600.0)
  t.frame(ms=16.0)
  match t.get("Primary Pane") {
    Some(card) => {
      debug_assert((card.y - shell_content_top(ctrl.model(), 1280.0)).abs() <= 0.5, "docked: page card starts SHELL_CANVAS_GAP from the top")
      debug_assert((card.x - (sb_w + SHELL_CANVAS_GAP)).abs() <= 0.5, "docked: page card starts SHELL_CANVAS_GAP after the sidebar")
    }
    None => debug_assert(false, "Primary Pane present")
  }
  t.press("Reload")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "reload", "Reload dispatches Reload intent")

  // 2. Narrow (640): the 40pt toolbar row carries the same controls above the page card.
  t.resize(640.0, 800.0)
  step_frames(t, 4, 16.0)
  let mut j = 0
  while j < labels.length() {
    let lbl = labels[j]
    match t.get(lbl) {
      Some(box) => {
        debug_assert(box.y >= 0.0 && box.y + box.h <= SHELL_TITLEBAND_H + 0.5, "narrow control inside the 40pt toolbar: " + lbl)
        debug_assert(box.w >= SP_32 - 0.5 && box.h >= SP_32 - 0.5, "narrow control meets the 32pt hit target: " + lbl)
      }
      None => debug_assert(false, "narrow toolbar control present: " + lbl)
    }
    j += 1
  }
  match t.get("Primary Pane") {
    Some(card) => debug_assert((card.y - shell_content_top(ctrl.model(), 640.0)).abs() <= 0.5, "narrow: page card starts below the toolbar")
    None => debug_assert(false, "Primary Pane present (narrow)")
  }
  t.press("Back")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "back", "toolbar Back dispatches GoBack")

  // 3. Wide with the sidebar hidden: the toolbar row returns.
  t.resize(1280.0, 800.0)
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  step_frames(t, 4, 16.0)
  match (t.get("Address Bar"), t.get("Primary Pane")) {
    (Some(ab), Some(card)) => {
      debug_assert(ab.y + ab.h <= SHELL_TITLEBAND_H + 0.5, "hidden sidebar: address field in the toolbar")
      debug_assert((card.y - SHELL_TITLEBAND_H).abs() <= 0.5 && card.x <= SHELL_CANVAS_GAP + 0.5, "hidden sidebar: page card below the toolbar, full width")
    }
    _ => debug_assert(false, "hidden sidebar: Address Bar and Primary Pane present")
  }

  t.dispose()
}

