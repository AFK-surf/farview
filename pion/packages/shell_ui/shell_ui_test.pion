///| Tier 1 automated audit suite for `pion/packages/shell_ui` (S1–S8 full closure):
///| - Real `t.set_a11y(true)` enabled on every audited scene
///| - Exact-label-only upstream `invar/packages/lg` hit-target exemptions (Clear 18x18 & 32pt menu items)
///| - True >= 36.0pt titleband hit-target verification
///| - S1: Reactive keyed Omnibox suggestions, live `OmniboxRequestGate`, Click == Enter parity
///| - S2: Reactive keyed Sidebar lists (Favorites, Folders, Tabs, Spaces)
///| - S3: Reactive HTTPS/HTTP/Edit/Internal security icon, full URL in Field, edit guard, Esc restore, click-outside
///| - S4: Dual-pane focus routing, `headless::dialog` Tab/Shift+Tab focus trap + return_focus, IME guard
///| - S5: 480pt narrow sidebar drawer toggle, 480pt Back button, Split 1280->480->1280 stability
///| - S8: `MotionProbe` 60/120/24/7 fps steady + cross-FPS same-timestamp trajectory convergence.

import "icons"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn step_frames(t : ui::Tester, n : Int, ms : Double) -> Unit {
  let mut i = 0
  while i < n {
    t.frame(ms=ms)
    i += 1
  }
}

///| Exact-label exemption ONLY for known upstream `invar/packages/lg` sub-36pt internals:
///| 1. `ctrl_clear_button` inside `liquid_search_bar_node` (`room: Clear (18x18 < 36pt)`)
///| 2. `ovl_menu_item_h = 32pt` rows inside `liquid_menu_node` (exact item labels only)
fn is_known_upstream_lg_room_fault(f : String, allow_menu_items : Bool) -> Bool {
  if f == "room: Clear (18x18 < 36pt)" {
    return true
  }
  if allow_menu_items {
    let menu_labels = [
      "room: New Tab (",
      "room: Reload Page (",
      "room: Forward (",
      "room: Toggle Split View (",
      "room: Toggle Reader Mode (",
      "room: Export PDF… (",
      "room: Dark Appearance (",
    ]
    let mut i = 0
    while i < menu_labels.length() {
      if f.starts_with(menu_labels[i]) && f.ends_with("x32 < 36pt)") {
        return true
      }
      i += 1
    }
  }
  false
}

fn audit_scene(
  t : ui::Tester,
  label : String,
  allow_large_overlay~ : Bool = false,
  allow_menu_items~ : Bool = false,
) -> Unit {
  // Explicitly enable a11y tree synchronization so `a11y_faults()` is genuinely active (S8)!
  t.set_a11y(true)
  t.frame(ms=16.0)
  lg::assert_no_nested_glass(t, label=label, allow_large_overlay=allow_large_overlay)
  t.assert_scrollable(label=label)
  t.assert_contrast(label=label)
  let craft = t.ui_craft_audit()
  let real_faults : Array[String] = []
  for f in craft {
    if !is_known_upstream_lg_room_fault(f, allow_menu_items) {
      real_faults.push(f)
    }
  }
  if real_faults.length() > 0 {
    let mut msg = "ui_craft_audit failed in \{label} (\{real_faults.length()} fault(s)):"
    for f in real_faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
  let a11y = t.a11y_faults()
  if a11y.length() > 0 {
    let mut msg = "a11y_faults in \{label} (\{a11y.length()}):"
    for f in a11y {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

test "shell_ui: all icon names resolve to non-empty vector shapes" {
  let names = shell_icon_names()
  debug_assert(names.length() >= 30, "expected >= 30 shell icons")
  let mut i = 0
  while i < names.length() {
    let name = names[i]
    let shapes = icons::icon_shapes(name, 16.0, 0x1C1C1EFFL)
    debug_assert(shapes.length() > 0, "missing vector icon in packages/icons: " + name)
    i += 1
  }
}

test "shell_ui: stage mount invariants across sidebar, resize, split, peek, swap, and narrow split" {
  let ctrl = make_demo_controller()
  let primary_live = ui::ref_new(0)
  let primary_mounts = ui::ref_new(0)
  let secondary_live = ui::ref_new(0)
  let secondary_mounts = ui::ref_new(0)
  let events : Array[String] = []

  let slot = PaneSlot::new(fn(parent : view::View, pane : PaneId) -> Unit {
    match pane {
      PaneId::Primary => {
        let _ = signals::effect_cleanup(fn() -> () -> Unit {
          primary_live.v = primary_live.v + 1
          primary_mounts.v = primary_mounts.v + 1
          events.push("mount:primary")
          fn() -> Unit {
            primary_live.v = primary_live.v - 1
            events.push("unmount:primary")
          }
        })
      }
      PaneId::Secondary => {
        let _ = signals::effect_cleanup(fn() -> () -> Unit {
          secondary_live.v = secondary_live.v + 1
          secondary_mounts.v = secondary_mounts.v + 1
          events.push("mount:secondary")
          fn() -> Unit {
            secondary_live.v = secondary_live.v - 1
            events.push("unmount:secondary")
          }
        })
      }
    }
    build_demo_pane(parent, pane, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) })
  })

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "initial primary mounted once")
  debug_assert(secondary_live.v == 0 && secondary_mounts.v == 0, "initial secondary unmounted")

  // Sidebar toggle
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "sidebar toggle preserves primary stage")

  // Responsive resize 1280 -> 760 -> 480 -> 1280
  t.resize(760.0, 800.0)
  t.frame(ms=16.0)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "resize preserves primary stage")

  // Single -> Split (Secondary 0 -> 1), then Split at 1280 -> 480 -> 1280 (S5)
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "split keeps primary delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "split mounts secondary once")
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && secondary_live.v == 1 && secondary_mounts.v == 1, "split survives 480pt without remount")
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && secondary_live.v == 1 && secondary_mounts.v == 1, "split survives 480->1280 without remount")

  // Swap panes + Split -> Peek -> Split (0 remounts!)
  ctrl.dispatch(ShellIntent::SwapSplitPanes)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OpenPeek("https://example.org/peek"))
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::PromotePeekToSplit)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "swap/peek keeps primary delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "peek<->split reuses secondary stage")

  // Close Secondary -> clean unmount, then re-open -> old cleanup strictly precedes new mount
  ctrl.dispatch(ShellIntent::CloseSecondaryPane)
  t.frame(ms=16.0)
  debug_assert(secondary_live.v == 0, "close secondary unmounts immediately")
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 2, "re-open split mounts fresh secondary")
  let n_ev = events.length()
  debug_assert(
    n_ev >= 4 && events[n_ev - 2] == "unmount:secondary" && events[n_ev - 1] == "mount:secondary",
    "old secondary cleanup precedes new mount",
  )

  t.dispose()
}

test "shell_ui: S1 reactive Omnibox suggestions, live request gate, and Click == Enter parity" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Type "alpha" -> gate dispatches "alpha"
  ctrl.dispatch(ShellIntent::OmniboxEdit("alpha"))
  t.frame(ms=16.0)
  debug_assert(ctrl.dispatched_omnibox_queries.length() == 1 && ctrl.dispatched_omnibox_queries[0] == "alpha", "dispatches alpha")

  // Type "beta" while "alpha" is in flight -> coalesced as pending, NOT dispatched yet
  ctrl.dispatch(ShellIntent::OmniboxEdit("beta"))
  t.frame(ms=16.0)
  debug_assert(ctrl.dispatched_omnibox_queries.length() == 1, "max 1 in-flight query")

  // Stale results for "alpha" arrive -> dropped, gate dispatches "beta" next!
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://stale-alpha.example", title: "Stale Alpha", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(t.find("Stale Alpha").is_none(), "stale alpha results dropped from UI")
  debug_assert(ctrl.dispatched_omnibox_queries.length() == 2 && ctrl.dispatched_omnibox_queries[1] == "beta", "pending beta dispatched next")

  // Fresh results for "beta" arrive (including a SwitchTab candidate!) -> reactive `each` updates visible rows live!
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "t3", title: "Ambient Synth Radio", visits: 9, score: 99.0, switch_to_tab: true },
      proto::OmniboxItem::{ url: "https://beta.example", title: "Beta Docs", visits: 4, score: 50.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(t.find("Beta Docs").is_some(), "reactive each renders updated Beta Docs row")
  debug_assert(t.get("Beta Docs").is_some(), "a11y label updates live to Beta Docs")

  // Verify Click and Enter hit the exact same SwitchTab target
  t.press("Ambient Synth Radio")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "select_tab:t3" || ctrl.url.untracked() == "https://soma.fm/groovesalad", "click SwitchTab selects tab t3")

  // Re-open with same SwitchTab result and press Enter -> identical tab selection!
  ctrl.dispatch(ShellIntent::OmniboxEdit("beta"))
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "t4", title: "WPT Layout Dashboard", visits: 5, score: 99.0, switch_to_tab: true },
    ]),
  )
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::OmniboxSubmit("beta"))
  t.frame(ms=16.0)
  debug_assert(ctrl.url.untracked() == "https://wpt.fyi/results/css", "Enter SwitchTab selects tab t4 identically to click")

  // Close suggestions, then late stale results arrive -> MUST NOT reopen popup!
  ctrl.dispatch(ShellIntent::OmniboxEdit("gamma"))
  ctrl.dispatch(ShellIntent::OmniboxClose)
  t.frame(ms=16.0)
  ctrl.dispatch(
    ShellIntent::OmniboxResultsArrived([
      proto::OmniboxItem::{ url: "https://late-gamma.example", title: "Late Gamma", visits: 1, score: 1.0, switch_to_tab: false },
    ]),
  )
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_suggest.untracked().open && t.find("Late Gamma").is_none(), "late results after close never reopen suggestions")

  t.dispose()
}

test "shell_ui: S2 sidebar 4 keyed reactive lists (New Tab, CreateFolder, Space switch)" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Click New Tab -> visible row count updates live!
  debug_assert(t.find("4 tabs").is_some(), "initially 4 tabs")
  t.press("New Tab")
  t.frame(ms=16.0)
  debug_assert(t.find("5 tabs").is_some(), "clicking New Tab adds live reactive tab row")

  // CreateFolder -> visible folder row appears live!
  ctrl.dispatch(ShellIntent::CreateFolder("Design Specs"))
  t.frame(ms=16.0)
  debug_assert(t.find("Design Specs").is_some(), "keyed folders each renders new folder live")

  // Switch Space -> sidebar updates live!
  t.press("Space Life")
  t.frame(ms=16.0)
  debug_assert(ctrl.active_space_id.untracked() == "personal", "Space button switches active space")
  debug_assert(t.find("0 tabs").is_some(), "Life space reactively shows 0 tabs")

  t.dispose()
}

test "shell_ui: S3 reactive security indicator, full URL in Field, edit guard, Esc restore, click-outside" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // 1. Idle field holds real full URL with scheme
  debug_assert(
    ctrl.omnibox_field.text() == "https://webkit.org/blog/tahoe-liquid-glass",
    "idle omnibox holds real full HTTPS URL",
  )
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::SecureHttps, "HTTPS -> SecureHttps")

  // 2. Switch HTTPS -> HTTP -> Internal on same tree (reactive security!)
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "http://insecure.example/test", "HTTP Page"))
  t.frame(ms=16.0)
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::InsecureHttp, "HTTP -> InsecureHttp")
  debug_assert(ctrl.omnibox_field.text() == "http://insecure.example/test", "field syncs when not editing")

  ctrl.dispatch(ShellIntent::NewTab)
  t.frame(ms=16.0)
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::InternalPage, "about:start -> InternalPage")

  // 3. While user is editing, async navigation MUST NOT clobber Field text, and security switches to EditingSearch
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "https://webkit.org/blog/tahoe-liquid-glass", "WebKit"))
  ctrl.omnibox_field.set("webkit")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  debug_assert(ctrl.model().omnibox_security() is OmniboxSecurity::EditingSearch, "editing shows search icon, not stale HTTPS lock")
  ctrl.dispatch(ShellIntent::SyncActiveUrl(PaneId::Primary, "https://async-bg.example/nav", "BG"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "webkit", "async nav must not overwrite active user edit")

  // 4. Esc restores active pane's real full URL and closes suggestions
  ctrl.dispatch(ShellIntent::OmniboxEscape)
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_field.text() == "https://async-bg.example/nav", "Esc restores active pane full URL")
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "Esc closes suggestions")

  // 5. Click outside suggestions overlay closes it
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "suggestions open before outside click")
  match t.get("Dismiss Suggestions") {
    Some(box) => {
      debug_assert(box.w > 100.0 && box.h > 100.0, "outside dismiss scrim covers body")
      t.click(box.x + 20.0, box.y + box.h - 20.0)
      t.frame(ms=16.0)
      debug_assert(
        !ctrl.omnibox_suggest.untracked().open,
        "click outside failed at (\{box.x}, \{box.y}, \{box.w}x\{box.h}), last=\{ctrl.last_intent.untracked()}",
      )
    }
    None => debug_assert(false, "Dismiss Suggestions scrim missing")
  }

  t.dispose()
}

test "shell_ui: S4 dual-pane focus routing, headless::dialog Tab focus trap + return_focus, and IME guard" {
  let ctrl = make_demo_controller(split=true)
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model(), emit=fn(e) { ctrl.dispatch(e) }) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Clicking focusable control inside Secondary pane routes focus + address bar + Reader toggle to Secondary!
  t.press("Secondary Pane Focus")
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().active_pane is PaneId::Secondary, "clicking secondary pane sets active_pane = Secondary")
  debug_assert(ctrl.omnibox_field.text() == "https://drafts.csswg.org/css-grid-3/", "address bar updates to Secondary URL")

  t.press("Reader Mode")
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().secondary_surface is PaneSurface::Reader, "Reader toggle affects active Secondary pane")
  debug_assert(ctrl.page.untracked().primary_surface is PaneSurface::Web, "Primary pane surface remains untouched")

  // Real modal Dialog Tab/Shift+Tab focus trap via `headless::dialog` + Esc return_focus
  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=16.0)
  debug_assert(t.get("Cancel").is_some() && t.get("Export").is_some(), "modal dialog buttons mounted")
  t.key(proto::KEY_TAB, mods=0)
  t.frame(ms=16.0)
  t.key(proto::KEY_TAB, mods=proto::SHORTCUT_MOD_SHIFT)
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(!(ctrl.exclusive.untracked().active is ExclusiveKind::Dialog), "real Esc closes modal dialog")

  // IME composition guard: while composing, Esc is NOT swallowed by global shell key handler
  ctrl.omnibox_field.compose("ni")
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  t.key(ui::key_escape, mods=0)
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "IME composing prevents shell from stealing Escape")
  ctrl.omnibox_field.compose("")

  t.dispose()
}

test "shell_ui: S5 480pt narrow sidebar drawer toggle & Back button" {
  let ctrl = make_demo_controller()
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=480.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Back button MUST remain directly accessible at 480pt!
  debug_assert(t.get("Back").is_some(), "480pt compact titleband preserves Back button")
  t.press("Back")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "back", "480pt Back button dispatches GoBack")

  // Toggle Sidebar opens Leading floating drawer at 480pt!
  t.press("Toggle Sidebar")
  step_frames(t, 20, 16.0)
  debug_assert(ctrl.exclusive.untracked().active is ExclusiveKind::SidebarDrawer, "480pt Toggle Sidebar opens SidebarDrawer")
  debug_assert(t.find("Tabs").is_some(), "480pt SidebarDrawer shows Tabs header")

  // Pressing Close inside drawer (or Escape) closes it cleanly
  t.press("Close")
  step_frames(t, 20, 16.0)
  debug_assert(!(ctrl.exclusive.untracked().active is ExclusiveKind::SidebarDrawer), "480pt SidebarDrawer closes cleanly")

  t.dispose()
}

test "shell_ui: S8 true >= 36pt titleband controls hit targets and dispatch" {
  let ctrl = make_demo_controller()
  let slot = PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  let labels = [
    "Toggle Sidebar",
    "Back",
    "Forward",
    "Reload",
    "Address Bar",
    "Split View",
    "Reader Mode",
    "Page Controls",
    "More Actions",
  ]
  let mut i = 0
  while i < labels.length() {
    let lbl = labels[i]
    let d = t.get(lbl)
    debug_assert(d.is_some(), "titleband control present: " + lbl)
    match d {
      Some(box) => {
        debug_assert(box.y >= 0.0 && box.y + box.h <= SHELL_TITLEBAND_H + 6.0, "control inside 44pt titleband: " + lbl)
        debug_assert(box.w >= 36.0 && box.h >= 36.0, "control meets >= 36.0pt hit target: " + lbl)
      }
      None => ()
    }
    i += 1
  }

  t.press("Reload")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "reload", "Reload dispatches Reload intent")

  t.dispose()
}

test "shell_ui: full Tier 1 visual/craft/contrast/a11y audit matrix (1280/760/480/inset, Light/Dark/Split/Omnibox/Drawer/Menu)" {
  // 1. 1280x800 Light (with real full URL in Field!)
  let c1 = make_demo_controller(dark=false)
  let t1 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c1.model(), fn(i) { c1.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c1.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t1, "light_1280")
  t1.dispose()

  // 2. 1280x800 Dark
  let c2 = make_demo_controller(dark=true)
  let t2 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c2.model(), fn(i) { c2.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c2.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
    dark=true,
  )
  audit_scene(t2, "dark_1280")
  t2.dispose()

  // 3. 1280x800 Split (Left Reader + Right Web + Split Micro-Bar)
  let c3 = make_demo_controller(dark=false, split=true, left_reader=true)
  let t3 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c3.model(), fn(i) { c3.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c3.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t3, "split_reader_web_1280")
  t3.dispose()

  // 4. 1280x800 Omnibox Suggestions Open (real non-empty "webkit" + ColorfulPoster)
  let c4 = make_demo_controller(dark=false, omnibox_open=true)
  let t4 = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        c4.model(),
        fn(i) { c4.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c4.model(), backdrop=DemoBackdrop::ColorfulPoster) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  debug_assert(t4.get("Omnibox Suggestions").is_some(), "omnibox suggestions overlay mounted")
  audit_scene(t4, "omnibox_open_colorful_1280")
  t4.dispose()

  // 5. 1280x800 Non-Modal Drawer Open (`scrim=false`, `y >= 54`)
  let c5 = make_demo_controller(dark=false, drawer_open=true)
  let t5 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c5.model(), fn(i) { c5.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c5.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  step_frames(t5, 25, 16.0)
  audit_scene(t5, "drawer_open_1280", allow_large_overlay=true)
  t5.dispose()

  // 6. 1280x800 More Menu Open (`BelowEnd`, exact-label upstream 32pt menu exemption only)
  let c6 = make_demo_controller(dark=false)
  let t6 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c6.model(), fn(i) { c6.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c6.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t6.press("More Actions")
  step_frames(t6, 25, 16.0)
  audit_scene(t6, "more_menu_open_1280", allow_menu_items=true)
  t6.dispose()

  // 7. 760x800 Narrow
  let c7 = make_demo_controller(dark=false)
  let t7 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c7.model(), fn(i) { c7.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c7.model()) })) },
    width=760.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t7, "narrow_760")
  t7.dispose()

  // 8. 480x800 Compact + 72pt macOS traffic-light inset override
  let c8 = make_demo_controller(dark=false, window_inset_override=72.0)
  let t8 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c8.model(), fn(i) { c8.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c8.model()) })) },
    width=480.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t8, "compact_480_inset")
  t8.dispose()
}

test "shell_ui: S8 MotionProbe steady + cross-FPS same-timestamp trajectory convergence (60/120/24/7 fps)" {
  let rates = [60, 120, 24, 7]
  let final_xs : Array[Double] = []
  let mid_xs : Array[Double] = []
  let mut ri = 0
  while ri < rates.length() {
    let fps = rates[ri]
    let step_ms = 1000.0 / fps.to_double()
    let ctrl = make_demo_controller(dark=false)
    let t = ui::Tester::tree(
      fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
    )
    let probe = ui::MotionProbe::new("Dark Appearance")
    ctrl.dispatch(ShellIntent::ToggleDrawer)
    probe.attach(t)
    let mut elapsed = 0.0
    let mut captured_mid = false
    while elapsed < 650.0 {
      t.frame(ms=step_ms)
      elapsed += step_ms
      // Sample at ~285ms (near-exact common timestamp across 7/24/60/120 fps: 285.7/291.7/283.3/283.3ms)
      if !captured_mid && elapsed >= 280.0 && probe.samples.length() > 0 {
        mid_xs.push(probe.samples[probe.samples.length() - 1].0)
        captured_mid = true
      }
    }
    probe.assert_steady(t, max_jump_pt=120.0, label="drawer_" + fps.to_string() + "fps")
    debug_assert(probe.samples.length() > 0, "collected motion samples")
    final_xs.push(probe.samples[probe.samples.length() - 1].0)
    t.dispose()
    ri += 1
  }
  // Cross-FPS trajectory convergence: final settled X identical across 60/120/24/7 fps (<= 1.0pt)
  let base_final = final_xs[0]
  let mut k = 1
  while k < final_xs.length() {
    let diff = (final_xs[k] - base_final).abs()
    debug_assert(diff <= 1.0, "final drawer X diverged across FPS rates")
    k += 1
  }
  // Same logical timestamp (~285ms) position matches within 12pt across all 4 FPS rates!
  let base_mid = mid_xs[0]
  let mut m = 1
  while m < mid_xs.length() {
    let diff = (mid_xs[m] - base_mid).abs()
    debug_assert(diff <= 12.0, "same-timestamp drawer trajectory diverged across FPS rates")
    m += 1
  }
}

test "shell_ui: CaptureSheet non-modal actions, modal focus exclusion, and Escape layering" {
  let ctrl = make_demo_controller(dark=false, capture_sheet=true)
  let t = ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  debug_assert(capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "capture sheet in focus order initially")
  t.press("Copy Path")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "capture:copy", "Copy Path works non-modally")

  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=16.0)
  debug_assert(!capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "capture sheet exits focus order while modal is open")

  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=16.0)
  debug_assert(!ctrl.exclusive.untracked().is_open(), "Escape closes modal Dialog first")
  debug_assert(ctrl.passive.untracked().capture_sheet_open, "CaptureSheet still open after Dialog closes")

  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=16.0)
  debug_assert(!ctrl.passive.untracked().capture_sheet_open, "Second Escape dismisses CaptureSheet")

  t.dispose()
}
