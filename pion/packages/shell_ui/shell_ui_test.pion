///| Tier 1 automated audit suite for `pion/packages/shell_ui`:
///| - Stage mount invariants (Primary live == 1 & delta == 0; Secondary 0->1, Peek<->Split delta == 0, clean unmount)
///| - 100% vector icon non-empty assertion (`packages/icons`)
///| - 36pt titleband hit-target verification
///| - Omnibox stale-response dropper state machine (`A -> B -> close -> stale A arrives`)
///| - Full `ui::Tester` audit matrix: 1280x800 (Light/Dark/Split/Omnibox/Drawer/MoreMenu), 760x800, 480x800
///|   (`lg::assert_apple_ui`, `t.assert_contrast`, `t.a11y_faults`, `lg::audit_glass`)
///| - `MotionProbe` at 60 / 120 / 24 / 7 fps
///| - Keyboard navigation, focus return, and non-modal `CaptureSheet` focus-order exclusion.

import "icons"
import "lg"
import "proto"
import "signals"
import "ui"
import "view"

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn step_frames(t : ui::Tester, n : Int, ms : Double) -> Unit {
  let mut i = 0
  while i < n {
    t.frame(ms=ms)
    i += 1
  }
}

fn audit_scene(t : ui::Tester, label : String, allow_large_overlay~ : Bool = false) -> Unit {
  lg::assert_apple_ui(t, label=label, allow_large_overlay=allow_large_overlay)
  t.assert_contrast(label=label)
  let a11y = t.a11y_faults()
  if a11y.length() > 0 {
    let mut msg = "a11y_faults in \{label} (\{a11y.length()}):"
    for f in a11y {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

test "shell_ui: all icon names resolve to non-empty vector shapes" {
  let names = shell_icon_names()
  debug_assert(names.length() >= 30, "expected >= 30 shell icons")
  let mut i = 0
  while i < names.length() {
    let name = names[i]
    let shapes = icons::icon_shapes(name, 16.0, 0x1C1C1EFFL)
    debug_assert(shapes.length() > 0, "missing vector icon in packages/icons: " + name)
    i += 1
  }
}

test "shell_ui: stage mount invariants across sidebar, resize, split, peek, and swap" {
  let ctrl = make_demo_controller()
  let primary_live = ui::ref_new(0)
  let primary_mounts = ui::ref_new(0)
  let secondary_live = ui::ref_new(0)
  let secondary_mounts = ui::ref_new(0)
  let events : Array[String] = []

  let slot = PaneSlot::new(fn(parent : view::View, pane : PaneId) -> Unit {
    match pane {
      PaneId::Primary => {
        let _ = signals::effect_cleanup(fn() -> () -> Unit {
          primary_live.v = primary_live.v + 1
          primary_mounts.v = primary_mounts.v + 1
          events.push("mount:primary")
          fn() -> Unit {
            primary_live.v = primary_live.v - 1
            events.push("unmount:primary")
          }
        })
      }
      PaneId::Secondary => {
        let _ = signals::effect_cleanup(fn() -> () -> Unit {
          secondary_live.v = secondary_live.v + 1
          secondary_mounts.v = secondary_mounts.v + 1
          events.push("mount:secondary")
          fn() -> Unit {
            secondary_live.v = secondary_live.v - 1
            events.push("unmount:secondary")
          }
        })
      }
    }
    build_demo_pane(parent, pane, ctrl.model())
  })

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Initial: Primary == 1, Secondary == 0
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "initial primary mounted once")
  debug_assert(secondary_live.v == 0 && secondary_mounts.v == 0, "initial secondary unmounted")

  // Sidebar toggle
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  ctrl.dispatch(ShellIntent::ToggleSidebar)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "sidebar toggle preserves primary stage")

  // Responsive resize 1280 -> 760 -> 480 -> 1280
  t.resize(760.0, 800.0)
  t.frame(ms=16.0)
  t.resize(480.0, 800.0)
  t.frame(ms=16.0)
  t.resize(1280.0, 800.0)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "resize 1280<->760<->480 preserves primary stage")

  // Single -> Split (Secondary 0 -> 1)
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "split keeps primary mount delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "split mounts secondary once")

  // Swap panes in Split (0 remounts for both Primary and Secondary!)
  ctrl.dispatch(ShellIntent::SwapSplitPanes)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "swap keeps primary mount delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "swap keeps secondary mount delta == 0")

  // Split -> Peek -> Split (shared Secondary Stage handoff: mount delta == 0!)
  ctrl.dispatch(ShellIntent::OpenPeek("https://example.org/peek"))
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "split->peek keeps primary delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "split->peek reuses secondary stage")

  ctrl.dispatch(ShellIntent::PromotePeekToSplit)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "peek->split keeps primary delta == 0")
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 1, "peek->split reuses secondary stage")

  // Close Secondary back to Single -> clean unmount (live == 0, no leaving subtree holds stage)
  ctrl.dispatch(ShellIntent::CloseSecondaryPane)
  t.frame(ms=16.0)
  debug_assert(primary_live.v == 1 && primary_mounts.v == 1, "close secondary keeps primary live == 1")
  debug_assert(secondary_live.v == 0, "close secondary unmounts immediately with live == 0")

  // Re-open Split -> old unmount strictly precedes new mount
  ctrl.dispatch(ShellIntent::ToggleSplitView)
  t.frame(ms=16.0)
  debug_assert(secondary_live.v == 1 && secondary_mounts.v == 2, "re-open split mounts fresh secondary")
  let n_ev = events.length()
  debug_assert(
    n_ev >= 4 && events[n_ev - 2] == "unmount:secondary" && events[n_ev - 1] == "mount:secondary",
    "old secondary cleanup must precede new secondary mount",
  )

  t.dispose()
}

test "shell_ui: omnibox stale-response dropper (A -> B -> close -> stale A arrives)" {
  let g0 = OmniboxRequestGate::new()
  // User types "A" -> dispatched immediately
  let (g1, send1) = g0.submit_query("A")
  debug_assert(opt_str_eq(send1, Some("A")), "first query A dispatched immediately")
  debug_assert(opt_str_eq(g1.in_flight, Some("A")), "A is in flight")

  // User types "B" while "A" is in flight -> coalesced into pending, max 1 in flight
  let (g2, send2) = g1.submit_query("B")
  debug_assert(opt_str_eq(send2, None), "at most 1 query in flight")
  debug_assert(opt_str_eq(g2.in_flight, Some("A")) && opt_str_eq(g2.pending_query, Some("B")), "B queued as latest pending")

  // User closes suggestions before A arrives
  let g3 = g2.close_suggestions()
  debug_assert(!g3.suggestions_open && opt_str_eq(g3.pending_query, None), "closing suggestions clears pending")

  // Stale results for A arrive -> MUST be dropped and NOT dispatch B
  let stale_items : Array[proto::OmniboxItem] = [
    proto::OmniboxItem::{ url: "https://a.example", title: "Stale A", visits: 1, score: 1.0, switch_to_tab: false },
  ]
  let (g4, accepted, next_send) = g3.on_results(stale_items)
  debug_assert(accepted.is_none(), "stale A results must be dropped after close")
  debug_assert(opt_str_eq(next_send, None), "no follow-up query after close")
  debug_assert(opt_str_eq(g4.in_flight, None), "in_flight cleared after stale response")

  // Burst coalescing: A -> B -> C while A in flight -> A finishes, drops A, dispatches C (skipping B), C accepted
  let (b1, _) = g4.submit_query("A")
  let (b2, _) = b1.submit_query("B")
  let (b3, _) = b2.submit_query("C")
  debug_assert(opt_str_eq(b3.pending_query, Some("C")), "latest pending coalesced to C")
  let (b4, acc_a, send_c) = b3.on_results(stale_items)
  debug_assert(acc_a.is_none(), "superseded A dropped")
  debug_assert(opt_str_eq(send_c, Some("C")), "latest query C dispatched next")
  let fresh_c : Array[proto::OmniboxItem] = [
    proto::OmniboxItem::{ url: "https://c.example", title: "Fresh C", visits: 3, score: 5.0, switch_to_tab: false },
  ]
  let (b5, acc_c, send_none) = b4.on_results(fresh_c)
  debug_assert(acc_c.is_some(), "matching latest query C accepted")
  debug_assert(opt_str_eq(send_none, None) && opt_str_eq(b5.in_flight, None), "queue drained cleanly")
}

test "shell_ui: 36pt titleband controls hit targets and dispatch" {
  let ctrl = make_demo_controller()
  let slot = PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot)
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  let labels = [
    "Toggle Sidebar",
    "Back",
    "Forward",
    "Reload",
    "Address Bar",
    "Split View",
    "Reader Mode",
    "Page Controls",
    "More Actions",
  ]
  let mut i = 0
  while i < labels.length() {
    let lbl = labels[i]
    let d = t.get(lbl)
    debug_assert(d.is_some(), "titleband control present: " + lbl)
    match d {
      Some(box) => {
        debug_assert(box.y >= 0.0 && box.y + box.h <= SHELL_TITLEBAND_H + 4.0, "control inside 44pt titleband: " + lbl)
        debug_assert(box.w >= 28.0 && box.h >= 28.0, "control hit target non-degenerate: " + lbl)
      }
      None => ()
    }
    i += 1
  }

  t.press("Reload")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "reload", "Reload button dispatches Reload intent")

  t.press("Split View")
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().layout is PageLayout::Split, "Split View button toggles Split layout")

  t.dispose()
}

test "shell_ui: full Tier 1 visual/craft/contrast/a11y audit matrix (1280/760/480, Light/Dark/Split/Omnibox/Drawer/Menu)" {
  // 1. 1280x800 Light
  let c1 = make_demo_controller(dark=false)
  let t1 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c1.model(), fn(i) { c1.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c1.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t1, "light_1280")
  t1.dispose()

  // 2. 1280x800 Dark
  let c2 = make_demo_controller(dark=true)
  let t2 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c2.model(), fn(i) { c2.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c2.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
    dark=true,
  )
  audit_scene(t2, "dark_1280")
  t2.dispose()

  // 3. 1280x800 Split (Left Reader + Right Web)
  let c3 = make_demo_controller(dark=false, split=true, left_reader=true)
  let t3 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c3.model(), fn(i) { c3.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c3.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t3, "split_reader_web_1280")
  t3.dispose()

  // 4. 1280x800 Omnibox Suggestions Open (Light + ColorfulPoster)
  let c4 = make_demo_controller(dark=false, omnibox_open=true)
  let t4 = ui::Tester::tree(
    fn(root) {
      build_shell_frame(
        root,
        c4.model(),
        fn(i) { c4.dispatch(i) },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c4.model(), backdrop=DemoBackdrop::ColorfulPoster) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  debug_assert(t4.get("Omnibox Suggestions").is_some(), "omnibox suggestions overlay mounted")
  audit_scene(t4, "omnibox_open_colorful_1280")
  t4.dispose()

  // 5. 1280x800 Drawer Open (y >= 54, zero topbar overlap!)
  let c5 = make_demo_controller(dark=false, drawer_open=true)
  let t5 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c5.model(), fn(i) { c5.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c5.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  step_frames(t5, 25, 16.0)
  match t5.get("Page Controls") {
    Some(_) => ()
    None => debug_assert(false, "drawer should be mounted")
  }
  audit_scene(t5, "drawer_open_1280", allow_large_overlay=true)
  t5.dispose()

  // 6. 1280x800 More Menu Open (BelowEnd, zero topbar overlap)
  // Note: upstream `lg::liquid_menu_node` uses `ovl_menu_item_h = 32pt` (< 36pt desktop room gate),
  // so we verify zero glass overlaps, zero scroll/contrast/a11y faults, and zero non-menu-row craft faults.
  let c6 = make_demo_controller(dark=false)
  let t6 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c6.model(), fn(i) { c6.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c6.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t6.press("More Actions")
  step_frames(t6, 25, 16.0)
  lg::assert_no_nested_glass(t6, label="more_menu_open_1280")
  t6.assert_scrollable(label="more_menu_open_1280")
  t6.assert_contrast(label="more_menu_open_1280")
  debug_assert(t6.a11y_faults().length() == 0, "more_menu_open_1280 a11y_faults == 0")
  let menu_craft = t6.ui_craft_audit()
  for f in menu_craft {
    debug_assert(f.contains("x32 < 36pt"), "unexpected craft fault in more_menu_open_1280: " + f)
  }
  t6.dispose()

  // 7. 760x800 Narrow
  let c7 = make_demo_controller(dark=false)
  let t7 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c7.model(), fn(i) { c7.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c7.model()) })) },
    width=760.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t7, "narrow_760")
  t7.dispose()

  // 8. 480x800 Compact
  let c8 = make_demo_controller(dark=false)
  let t8 = ui::Tester::tree(
    fn(root) { build_shell_frame(root, c8.model(), fn(i) { c8.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, c8.model()) })) },
    width=480.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  audit_scene(t8, "compact_480")
  t8.dispose()
}

test "shell_ui: MotionProbe steady convergence at 60 / 120 / 24 / 7 fps" {
  let rates = [60, 120, 24, 7]
  let mut ri = 0
  while ri < rates.length() {
    let fps = rates[ri]
    let step_ms = 1000.0 / fps.to_double()
    let ctrl = make_demo_controller(dark=false)
    let t = ui::Tester::tree(
      fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
    )
    let probe = ui::MotionProbe::new("Dark Appearance")
    ctrl.dispatch(ShellIntent::ToggleDrawer)
    probe.attach(t)
    let mut elapsed = 0.0
    while elapsed < 650.0 {
      t.frame(ms=step_ms)
      elapsed += step_ms
    }
    probe.assert_steady(t, max_jump_pt=120.0, label="drawer_" + fps.to_string() + "fps")
    t.dispose()
    ri += 1
  }
}

test "shell_ui: keyboard navigation, CaptureSheet non-modal actions, and modal focus exclusion" {
  let ctrl = make_demo_controller(dark=false, capture_sheet=true)
  let t = ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // CaptureSheet is non-modal and in focus order when no Exclusive modal is open
  debug_assert(capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "capture sheet in focus order initially")
  t.press("Copy Path")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "capture:copy", "Copy Path works non-modally")

  // Opening modal Dialog excludes CaptureSheet from focus order
  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=16.0)
  debug_assert(!capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "capture sheet exits focus order while modal is open")

  // Escape closes Exclusive Dialog first (leaves CaptureSheet intact)
  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=16.0)
  debug_assert(!ctrl.exclusive.untracked().is_open(), "Escape closes modal Dialog first")
  debug_assert(ctrl.passive.untracked().capture_sheet_open, "CaptureSheet still open after Dialog closes")
  debug_assert(capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "CaptureSheet returns to focus order")

  // Second Escape with no Exclusive dismisses topmost interactive Passive (CaptureSheet)
  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=16.0)
  debug_assert(!ctrl.passive.untracked().capture_sheet_open, "Second Escape dismisses CaptureSheet")

  // Omnibox keyboard selection: Edit -> ArrowDown -> Enter -> Navigate
  ctrl.dispatch(ShellIntent::OmniboxEdit("webkit"))
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_suggest.untracked().open, "omnibox suggestions open on edit")
  let sel0 = ctrl.omnibox_suggest.untracked().selected
  ctrl.dispatch(ShellIntent::OmniboxMoveSelection(1))
  let sel1 = ctrl.omnibox_suggest.untracked().selected
  debug_assert(sel1 != sel0 || ctrl.omnibox_suggest.untracked().items.length() <= 1, "ArrowDown steps selection")
  ctrl.dispatch(ShellIntent::OmniboxSubmit("webkit"))
  debug_assert(!ctrl.omnibox_suggest.untracked().open, "Submit closes suggestions")
  debug_assert(ctrl.last_intent.untracked().starts_with("navigate:"), "Submit navigates")

  t.dispose()
}
