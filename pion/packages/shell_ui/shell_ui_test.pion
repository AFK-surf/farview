test "shell_ui: S8 MotionProbe steady + cross-FPS same-timestamp trajectory convergence (60/120/24/7 fps)" {
  let rates = [60, 120, 24, 7]
  let final_xs : Array[Double] = []
  let mid_xs : Array[Double] = []
  let mut ri = 0
  while ri < rates.length() {
    let fps = rates[ri]
    let step_ms = 1000.0 / fps.to_double()
    let ctrl = make_demo_controller(dark=false)
    let t = ui::Tester::tree(
      fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
    )
    let probe = ui::MotionProbe::new("Dark Appearance")
    ctrl.dispatch(ShellIntent::ToggleDrawer)
    probe.attach(t)
    let mut elapsed = 0.0
    let mut captured_mid = false
    while elapsed < 650.0 {
      t.frame(ms=step_ms)
      elapsed += step_ms
      // Sample at ~285ms (near-exact common timestamp across 7/24/60/120 fps: 285.7/291.7/283.3/283.3ms)
      if !captured_mid && elapsed >= 280.0 && probe.samples.length() > 0 {
        mid_xs.push(probe.samples[probe.samples.length() - 1].0)
        captured_mid = true
      }
    }
    probe.assert_steady(t, max_jump_pt=120.0, label="drawer_" + fps.to_string() + "fps")
    debug_assert(probe.samples.length() > 0, "collected motion samples")
    final_xs.push(probe.samples[probe.samples.length() - 1].0)
    t.dispose()
    ri += 1
  }
  // Cross-FPS trajectory convergence: final settled X identical across 60/120/24/7 fps (<= 1.0pt)
  let base_final = final_xs[0]
  let mut k = 1
  while k < final_xs.length() {
    let diff = (final_xs[k] - base_final).abs()
    debug_assert(diff <= 1.0, "final drawer X diverged across FPS rates")
    k += 1
  }
  // Same logical timestamp (~285ms) position matches within 12pt across all 4 FPS rates!
  let base_mid = mid_xs[0]
  let mut m = 1
  while m < mid_xs.length() {
    let diff = (mid_xs[m] - base_mid).abs()
    debug_assert(diff <= 12.0, "same-timestamp drawer trajectory diverged across FPS rates")
    m += 1
  }
}

test "shell_ui: CaptureSheet non-modal actions, modal focus exclusion, and Escape layering" {
  let ctrl = make_demo_controller(dark=false, capture_sheet=true)
  let t = ui::Tester::tree(
    fn(root) { build_shell_frame(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) })) },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  debug_assert(capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "capture sheet in focus order initially")
  t.press("Copy Path")
  t.frame(ms=16.0)
  debug_assert(ctrl.last_intent.untracked() == "capture:copy", "Copy Path works non-modally")

  ctrl.dispatch(ShellIntent::OpenDialog)
  t.frame(ms=16.0)
  debug_assert(!capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "capture sheet exits focus order while modal is open")

  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=16.0)
  debug_assert(!ctrl.exclusive.untracked().is_open(), "Escape closes modal Dialog first")
  debug_assert(ctrl.passive.untracked().capture_sheet_open, "CaptureSheet still open after Dialog closes")

  ctrl.dispatch(ShellIntent::EscapePressed)
  t.frame(ms=16.0)
  debug_assert(!ctrl.passive.untracked().capture_sheet_open, "Second Escape dismisses CaptureSheet")

  t.dispose()
}

test "shell_ui: 0b G1 focus-observe path stays O(1) with 0 vs 5,000 pane children (instance probe + idle zero + unfocused frame)" {
  let run_focus_scenario = fn(pane_children : Int) -> (Int, Int, Int) {
    let ctrl = make_demo_controller()
    let probe = FocusObserveProbe::new()
    let root_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
    let slot = PaneSlot::new(fn(parent : view::View, pane : PaneId) -> Unit {
      if pane is PaneId::Primary && pane_children > 0 {
        let _ = parent.box(fn(holder : view::View) -> Unit {
          let _ = holder.fill()
          let mut i = 0
          while i < pane_children {
            let _ = holder.box(fn(leaf : view::View) -> Unit {
              let _ = leaf.width(view::Live::Is(Some(1.0))).height(view::Live::Is(Some(1.0)))
            })
            i += 1
          }
        })
      }
    })
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        root_ref.v = Some(root)
        build_shell_frame_with_probe(root, ctrl.model(), fn(i) { ctrl.dispatch(i) }, slot, probe=Some(probe))
      },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
    )
    t.frame(ms=16.0)
    probe.reset()

    // Idle check: while `!omnibox_editing`, advancing frames & moving tree focus must cause ZERO node visits!
    match t.get("Reload") {
      Some(rb) => match root_ref.v {
        Some(rv) => {
          let _ = rv.tree.focus_to(Some(rb.id), visible=false)
        }
        None => ()
      }
      None => ()
    }
    t.frame(ms=16.0)
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    let idle_visits = probe.node_visits
    probe.reset()

    // 1. Click Address Bar to focus and type a query
    t.press("Address Bar")
    t.frame(ms=16.0)
    t.type_text("webkit")
    t.frame(ms=16.0)
    debug_assert(ctrl.omnibox_editing.untracked() && ctrl.omnibox_suggest.untracked().open, "omnibox open after typing")

    // 2. Step a frame with cleared tree focus (`None`) while editing -> would hit full tree if regressed!
    match root_ref.v {
      Some(rv) => {
        let _ = rv.tree.focus_to(None, visible=false)
      }
      None => ()
    }
    t.frame(ms=16.0)

    // 3. Re-focus Address Bar, Tab to Clear, then Tab out of Address Bar to external control
    t.press("Address Bar")
    t.frame(ms=16.0)
    t.type_text("webkit")
    t.frame(ms=16.0)
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    t.key(proto::KEY_TAB, mods=0)
    t.frame(ms=16.0)
    debug_assert(!ctrl.omnibox_editing.untracked() && !ctrl.omnibox_suggest.untracked().open, "Tab out closed omnibox")

    // 4. Re-focus, type again, and close via Esc
    t.press("Address Bar")
    t.frame(ms=16.0)
    t.type_text("docs")
    t.frame(ms=16.0)
    t.key(ui::key_escape, mods=0)
    t.frame(ms=16.0)
    debug_assert(!ctrl.omnibox_editing.untracked() && !ctrl.omnibox_suggest.untracked().open, "Esc closed omnibox")

    let visits = probe.node_visits
    let cbs = probe.callbacks
    t.dispose()
    (idle_visits, visits, cbs)
  }

  let (idle_0, visits_0, cbs_0) = run_focus_scenario(0)
  let (idle_5000, visits_5000, cbs_5000) = run_focus_scenario(5000)
  debug_assert(idle_0 == 0 && idle_5000 == 0, "idle focus-observe must visit strictly 0 nodes: got " + idle_0.to_string() + "," + idle_5000.to_string())
  debug_assert(visits_0 > 0 && cbs_0 > 0, "focus-observe instrumentation observed real callbacks/visits")
  debug_assert(
    visits_5000 == visits_0,
    "0b G1 regression: focus-observe node visits grew with 5,000 pane children (0->" + visits_0.to_string() + ", 5000->" + visits_5000.to_string() + ")",
  )
  debug_assert(
    cbs_5000 == cbs_0,
    "0b G1 regression: focus-observe callback count grew with 5,000 pane children (0->" + cbs_0.to_string() + ", 5000->" + cbs_5000.to_string() + ")",
  )
  debug_assert(
    visits_5000 < 500,
    "0b G1 regression: focus-observe node visits must stay a small O(1) constant, got " + visits_5000.to_string(),
  )
}

test "shell_ui: direct tree focus onto Omnibox suggestion row without pointer press preserves popup and commits once on Enter" {
  let ctrl = make_demo_controller()
  let root_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let nav_urls : Array[String] = []
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      root_ref.v = Some(root)
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i : ShellIntent) -> Unit {
          match i {
            ShellIntent::OmniboxSelectIndex(idx) => {
              let items = ctrl.omnibox_suggest.untracked().items
              if idx >= 0 && idx < items.length() {
                nav_urls.push(items[idx].url)
              }
            }
            ShellIntent::Navigate(u) => nav_urls.push(u)
            _ => ()
          }
          ctrl.dispatch(i)
        },
        PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )

  // Open Address Bar and type "webkit" to show real suggestions
  t.press("Address Bar")
  t.frame(ms=16.0)
  t.type_text("grid")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_editing.untracked() && ctrl.omnibox_suggest.untracked().open, "suggestions open for grid")

  // Move tree focus directly onto a real suggestion button WITHOUT any pointer press!
  let target_label = "Grid by Example"
  let target_url = "https://gridbyexample.com/examples/"
  match (root_ref.v, t.get(target_label)) {
    (Some(rv), Some(sbox)) => {
      let ok = rv.tree.focus_to(Some(sbox.id), visible=false)
      debug_assert(ok, "suggestion button accepted direct tree focus")
    }
    _ => debug_assert(false, "suggestion button present for direct focus test")
  }
  t.frame(ms=16.0)
  // Path 2 must NOT mis-dismiss the suggestion popup when `omnibox_field.focused()` drops!
  debug_assert(
    ctrl.omnibox_editing.untracked() && ctrl.omnibox_suggest.untracked().open,
    "direct tree focus onto suggestion row keeps omnibox editing & suggestions open",
  )

  // Press Enter -> commits the focused suggestion navigation ONCE and closes omnibox!
  t.enter()
  t.frame(ms=16.0)
  debug_assert(nav_urls.length() == 1, "Enter on focused suggestion commits navigation exactly once, got " + nav_urls.length().to_string())
  debug_assert(nav_urls[0] == target_url, "committed URL matches focused suggestion: got=" + nav_urls[0])
  debug_assert(!ctrl.omnibox_editing.untracked() && !ctrl.omnibox_suggest.untracked().open, "omnibox closed after Enter commit")

  // Moving tree focus directly onto an external control (Reload, in the sidebar) STILL triggers OmniboxBlur!
  t.press("Address Bar")
  t.frame(ms=16.0)
  t.type_text("grid")
  t.frame(ms=16.0)
  debug_assert(ctrl.omnibox_editing.untracked() && ctrl.omnibox_suggest.untracked().open, "re-opened omnibox")
  match (root_ref.v, t.get("Reload")) {
    (Some(rv), Some(ext)) => {
      let ok = rv.tree.focus_to(Some(ext.id), visible=false)
      debug_assert(ok, "Reload accepted direct tree focus")
    }
    _ => debug_assert(false, "Reload present")
  }
  t.frame(ms=16.0)
  debug_assert(!ctrl.omnibox_editing.untracked() && !ctrl.omnibox_suggest.untracked().open, "direct focus to external Reload triggers OmniboxBlur")

  t.dispose()
}

test "shell_ui: Phase 1b ExclusiveState.tag isolation, render_passive_overlays=false, on_focus_pane, and SoloActivePane" {
  let ctrl = make_demo_controller(dark=false, split=true)
  ctrl.passive.set(PassiveState::{
    ..ctrl.passive.untracked(),
    capture_sheet_open: true,
    toast_visible: true,
    toast_title: "Host Toast",
  })
  let focused_panes : Array[PaneId] = []
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
        build_demo_pane(p, id, ctrl.model(), emit=fn(i) { ctrl.dispatch(i) })
      })
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        slot,
        render_passive_overlays=false,
        on_focus_pane=Some(fn(pid : PaneId) -> Unit { focused_panes.push(pid) }),
      )
    },
    width=1280.0,
    height=800.0,
  )
  t.frame(ms=16.0)

  // 1. render_passive_overlays=false -> shell_ui mounts 0 CaptureSheet / Toast nodes
  debug_assert(t.find("Capture Completed").is_none(), "no shell_ui CaptureSheet when render_passive_overlays=false")
  debug_assert(t.find("Screenshot saved").is_none(), "no shell_ui Screenshot saved when render_passive_overlays=false")

  // 2. ExclusiveState.tag isolation: foreign Dialog ("settings") must NOT mount shell_ui Export PDF dialog!
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::Dialog, tag="settings"))
  t.frame(ms=16.0)
  debug_assert(t.find("Export Page as PDF").is_none(), "foreign Dialog tag='settings' does not mount shell_ui Dialog")

  // Foreign Drawer ("history") must NOT mount shell_ui Page Controls drawer!
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::Drawer, tag="history"))
  t.frame(ms=16.0)
  hover_address(t)
  debug_assert(t.get("Page Controls").is_some(), "Page Controls button exists")
  debug_assert(t.find("Appearance").is_none(), "foreign Drawer tag='history' does not mount shell_ui Drawer")

  // Shell-owned Dialog tag ("shell_dialog") DOES mount Export PDF dialog
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::Dialog, tag="shell_dialog"))
  t.frame(ms=16.0)
  debug_assert(t.find("Export Page as PDF").is_some(), "shell_dialog tag mounts Export Page as PDF")
  ctrl.exclusive.set(ctrl.exclusive.untracked().begin_close())
  t.frame(ms=16.0)

  // 3. on_focus_pane callback fires on Omnibox Escape
  ctrl.dispatch(ShellIntent::OmniboxFocus)
  t.frame(ms=16.0)
  t.key(ui::key_escape)
  t.frame(ms=16.0)
  debug_assert(focused_panes.length() >= 1, "on_focus_pane called on Omnibox Escape")

  // 4. SoloActivePane preserves Secondary URL when Secondary is active
  ctrl.dispatch(ShellIntent::SetPaneFocus(PaneId::Secondary))
  let sec_url = ctrl.secondary_url.untracked()
  ctrl.dispatch(ShellIntent::SoloActivePane)
  t.frame(ms=16.0)
  debug_assert(ctrl.page.untracked().layout is PageLayout::Single, "SoloActivePane switches to Single")
  debug_assert(ctrl.url.untracked() == sec_url, "SoloActivePane promoted active Secondary URL into Primary")

  t.dispose()
}

test "shell_ui: Phase 2A ToastKind, exact-tag CommandBar/TabSearch, StartPage solid cards, FindBar, and CaptureSheet focus exclusion" {
  // 1. ToastKind tag mapping & CaptureSheet exits focus order for ANY Exclusive overlay (not just modals!)
  debug_assert(toast_kind_from_tag("error") is ToastKind::Error, "error -> ToastKind::Error")
  debug_assert(toast_kind_from_tag("fail") is ToastKind::Error, "fail -> ToastKind::Error")
  debug_assert(toast_kind_from_tag("close") is ToastKind::Warning, "close -> ToastKind::Warning")
  debug_assert(toast_kind_from_tag("copy") is ToastKind::Success, "copy -> ToastKind::Success")
  debug_assert(toast_kind_from_tag("info") is ToastKind::Info, "info -> ToastKind::Info")

  let ctrl = make_demo_controller(dark=false, capture_sheet=true)
  let cb_field = ui::Field::new()
  let ts_field = ui::Field::new()
  let find_field = ui::Field::new()
  let find_open = signals::signal(true)
  let find_case = signals::signal(false)
  let sp_open = signals::signal(true)
  let sp_field = ui::Field::new()
  let sp_submitted : signals::Ref[String] = ui::ref_new("")
  let cb_executed : signals::Ref[String] = ui::ref_new("")
  let ts_activated : signals::Ref[String] = ui::ref_new("")
  let find_next_hits : signals::Ref[Int] = ui::ref_new(0)

  let hooks = ShellHostHooks::{
    ..ShellHostHooks::empty(),
    command_bar: Some(CommandBarProps::{
      field: cb_field,
      items: fn() {
        [
          proto::CommandBarItem::{
            kind: proto::CommandKind::Action,
            id: "open_settings",
            title: "Open Settings",
            subtitle: "Search engine, appearance, privacy & data",
            badge: "Action",
            shortcut: "Cmd+,",
            monogram: "⚙",
            accent: 0x007AFFFFL,
            is_space: false,
            is_tab: false,
          },
          proto::CommandBarItem::{
            kind: proto::CommandKind::Action,
            id: "toggle_bookmark",
            title: "Bookmark Current Page",
            subtitle: "Save or remove page in Bookmarks",
            badge: "",
            shortcut: "Cmd+D",
            monogram: "★",
            accent: 0L,
            is_space: false,
            is_tab: false,
          },
          proto::CommandBarItem::{
            kind: proto::CommandKind::Action,
            id: "toggle_bookmarks_bar",
            title: "Toggle Bookmarks Bar",
            subtitle: "Show or hide horizontal bookmarks bar",
            badge: "",
            shortcut: "Cmd+Shift+B",
            monogram: "▤",
            accent: 0L,
            is_space: false,
            is_tab: false,
          },
          proto::CommandBarItem::{
            kind: proto::CommandKind::Action,
            id: "toggle_boosts",
            title: "Customize Site Style",
            subtitle: "Change colors, fonts and CSS for this site",
            badge: "",
            shortcut: "Cmd+Shift+E",
            monogram: "✦",
            accent: 0L,
            is_space: false,
            is_tab: false,
          },
          proto::CommandBarItem::{
            kind: proto::CommandKind::Action,
            id: "search_all_tabs",
            title: "Search All Tabs",
            subtitle: "Jump to any open or recently closed tab",
            badge: "",
            shortcut: "Cmd+Shift+A",
            monogram: "⌕",
            accent: 0L,
            is_space: false,
            is_tab: false,
          },
          proto::CommandBarItem::{
            kind: proto::CommandKind::Action,
            id: "capture_screenshot",
            title: "Capture Screenshot",
            subtitle: "Save visible webpage as PNG to Downloads",
            badge: "",
            shortcut: "Cmd+Shift+S",
            monogram: "⬚",
            accent: 0L,
            is_space: false,
            is_tab: false,
          },
        ]
      },
      selected: fn() { 0 },
      on_query_change: fn(_q) { () },
      on_step: fn(_d) { true },
      on_submit: fn(_t) { () },
      on_execute: fn(it) { cb_executed.v = it.id },
      on_close: fn() { ctrl.exclusive.set(ctrl.exclusive.untracked().begin_close()) },
      on_row_view: None,
      on_clear_rows: None,
    }),
    tab_search: Some(TabSearchProps::{
      field: ts_field,
      results: fn() {
        proto::TabSearchResult::{
          open_items: [
            proto::TabSearchItem::{
              is_open: true,
              id: "tab-design",
              title: "Design Tokens",
              url: "https://design.example/tokens",
              display_host: "design.example",
              space_name: "Design",
              space_accent: "#8B5CF6",
              space_accent_rgba: 0x8B5CF6FFL,
              is_active: false,
              is_pinned: true,
              is_favorite: false,
              is_playing_audio: false,
              closed_index: -1,
            },
          ],
          closed_items: [],
          total_open: 1,
          total_closed: 0,
        }
      },
      selected: fn() { 0 },
      on_query_change: fn(_q) { () },
      on_submit: fn() { () },
      on_activate: fn(it) { ts_activated.v = it.id },
      on_close_tab: fn(_id) { () },
      on_close: fn() { ctrl.exclusive.set(ctrl.exclusive.untracked().begin_close()) },
    }),
  }

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let slot = PaneSlot::new(fn(p : view::View, id : PaneId) -> Unit {
        if id is PaneId::Primary {
          build_startpage_panel(
            p,
            StartPageProps::{
              visible: fn() { sp_open.get() },
              dark: fn() { ctrl.dark.get() },
              space_name: fn() { "Work" },
              space_accent: fn() { 0x007AFFFFL },
              search_engine_label: fn() { "Google" },
              tiles: fn() {
                [
                  proto::StartPageTile::{
                    title: "GitHub",
                    url: "https://github.com",
                    host: "github.com",
                    monogram: "G",
                    accent: 0x24292EFFL,
                    is_bookmark: true,
                  },
                ]
              },
              field: sp_field,
              on_show: fn() { () },
              on_submit: fn(q) { sp_submitted.v = q },
              on_open_tile: fn(u) { sp_submitted.v = u },
              quick_actions: [
                StartPageQuickAction::{
                  label: "Settings",
                  shortcut: "Cmd+,",
                  icon_name: ICON_SETTINGS,
                  on_press: fn() { () },
                },
              ],
            },
          )
          build_find_bar_panel(
            p,
            FindBarProps::{
              visible: fn() { find_open.get() },
              dark: fn() { ctrl.dark.get() },
              field: find_field,
              case_sensitive: fn() { find_case.get() },
              counts: fn() { (0, 3) },
              on_query_change: fn(_q) { () },
              on_prev: fn() { () },
              on_next: fn() { find_next_hits.v = find_next_hits.v + 1 },
              on_toggle_case: fn() { find_case.set(!find_case.untracked()) },
              on_close: fn() { find_open.set(false) },
            },
          )
        }
      })
      build_shell_frame(
        root,
        ctrl.model(),
        fn(i) { ctrl.dispatch(i) },
        slot,
        render_passive_overlays=true,
        hooks=Some(hooks),
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)

  // StartPage solid cards + single-layer glass search capsule passes Apple UI audit (zero nested glass!)
  debug_assert(t.find("Favorites").is_some() && t.get("GitHub").is_some(), "StartPage rendered its Favorites")
  debug_assert(t.find("Find in Page").is_some() || t.get("Match Case").is_some(), "FindBar rendered")
  lg::assert_apple_ui(t, label="shell_ui_phase2a_startpage_findbar")

  // FindBar Match Case & Next Match interaction
  t.press("Match Case")
  t.frame(ms=16.0)
  debug_assert(find_case.untracked(), "Match Case toggled on")
  t.press("Next Match (Enter)")
  t.frame(ms=16.0)
  debug_assert(find_next_hits.v == 1, "Next Match button dispatched")

  // Opus B3: CommandBar & TabSearch require EXACT tag match (foreign/empty tag must NOT mount!)
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::CommandBar, tag=""))
  t.frame(ms=16.0)
  debug_assert(t.find("Open Settings").is_none(), "empty tag does NOT mount CommandBar (Opus B3)")
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::CommandBar, tag="command_bar"))
  t.frame(ms=16.0)
  debug_assert(t.find("Open Settings").is_some(), "exact tag 'command_bar' mounts CommandBar")
  // Opus C3: CommandBar NEVER renders proto Unicode pseudo-icons (`★`, `▤`, `✦`, `⌕`, `⬚`, `⚙`),
  // and renders uniform ASCII footer hints (`Navigate`, `Run`, `Close`).
  let forbidden_glyphs = ["★", "▤", "✦", "⌕", "⬚", "⚙"]
  let mut gi = 0
  while gi < forbidden_glyphs.length() {
    debug_assert(
      t.find(forbidden_glyphs[gi]).is_none(),
      "CommandBar must NEVER render proto Unicode glyph: " + forbidden_glyphs[gi],
    )
    gi += 1
  }
  // The keyboard hints sit behind the info button (Arc), not in a footer that is always there.
  debug_assert(t.find("Navigate").is_none(), "CommandBar keeps the hints behind the info button")
  t.press("Keyboard Hints")
  t.frame(ms=16.0)
  debug_assert(t.find("Navigate").is_some() && t.find("Run").is_some() && t.find("Close").is_some(), "the info button shows the shortcut hints")
  // CaptureSheet exits focus order while CommandBar (and even non-modal Menu!) is open
  debug_assert(!capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "CaptureSheet out of focus order during CommandBar")
  t.press("Open Settings")
  t.frame(ms=16.0)
  debug_assert(cb_executed.v == "open_settings", "CommandBar item executed")

  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::Menu, tag="shell_menu"))
  t.frame(ms=16.0)
  debug_assert(!capture_sheet_in_focus_order(ctrl.exclusive.untracked(), ctrl.passive.untracked()), "CaptureSheet out of focus order during ANY Exclusive (Menu)")

  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::TabSearch, tag="wrong_tag"))
  t.frame(ms=16.0)
  debug_assert(t.find("Design Tokens").is_none(), "wrong tag does NOT mount TabSearch (Opus B3)")
  ctrl.exclusive.set(ctrl.exclusive.untracked().open(ExclusiveKind::TabSearch, tag="tab_search"))
  t.frame(ms=16.0)
  debug_assert(t.find("Design Tokens").is_some(), "exact tag 'tab_search' mounts TabSearch")
  debug_assert(t.get("Pinned").is_some(), "TabSearch marks the pinned open tab with a named Pinned glyph")
  t.press("Switch to Design Tokens")
  t.frame(ms=16.0)
  debug_assert(ts_activated.v == "tab-design", "TabSearch activated cross-space tab")

  // Error ToastKind renders distinct status & does not block pointer clicks
  ctrl.exclusive.set(ctrl.exclusive.untracked().begin_close())
  let p = ctrl.passive.untracked()
  ctrl.passive.set(PassiveState::{ ..p, toast_visible: true, toast_title: "Failed to save PDF", toast_kind: ToastKind::Error })
  t.frame(ms=16.0)
  debug_assert(t.find("Failed to save PDF").is_some(), "Error toast visible in tree")

  t.dispose()
}
