    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=600.0)
  t
}

// ============================================================================
// Monochrome glyph tiles (DESIGN.md section 3)
// ============================================================================

test "ui quality: glyph tiles are monochrome; color is kept for meaning only" {
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      let _ = shell_glyph_tile(root, ICON_DOWNLOAD, size=SP_24)
      let _ = shell_tint_tile(root, "trash", fn() { 0xFF3B30FFL }, size=SP_32)
    },
    width=400.0,
    height=200.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  debug_assert(uq_has_ground(t, mono_tile_ground(), SP_24, 0.0, 400.0), "shell_glyph_tile draws the neutral ground")
  debug_assert(uq_has_ground(t, 0xFF3B30FFL, SP_32, 0.0, 400.0), "shell_tint_tile keeps a meaning color")
  t.dispose()

  // The Command Bar's command tiles are neutral; a Space row keeps its own color.
  let action = proto::CommandBarItem::{
    kind: proto::CommandKind::Action,
    id: "toggle_reader_mode",
    title: "Reader mode",
    subtitle: "",
    badge: "",
    shortcut: "",
    monogram: "R",
    accent: 0L,
    is_tab: false,
    is_space: false,
  }
  debug_assert(command_bar_tile_color(action) == mono_tile_ground(), "command tiles are neutral")
  let space = proto::CommandBarItem::{ ..action, kind: proto::CommandKind::SwitchSpace, accent: 0x34C759FFL, is_space: true }
  debug_assert(command_bar_tile_color(space) == 0x34C759FFL, "a Space row keeps the color its person chose")

  // Panels: no decorative palette-colored tiles in Settings or in a Downloads list.
  let st = uq_settings(1280.0, SETTINGS_TAB_GENERAL)
  debug_assert(uq_palette_tiles(st, SP_24) == 0 && uq_palette_tiles(st, SP_20) == 0, "Settings tiles are monochrome")
  st.dispose()
  let (dt, _) = uq_downloads([uq_download_item("a", "PDF", "completed"), uq_download_item("b", "PNG", "completed")])
  debug_assert(uq_palette_tiles(dt, SP_32) == 0, "Downloads file tiles are monochrome")
  dt.dispose()
  lg::set_dark(None)
}

// ============================================================================
// One site tile (Q3, Q14)
// ============================================================================

test "ui quality: an open tab shows the same site tile in the address palette as in the sidebar" {
  lg::set_dark(Some(false))
  let row = fn(icon : String, url : String) -> ShellOmniboxRow {
    ShellOmniboxRow::{ key: url, idx: 0, section_header: "", title: "", subtitle: "", badge_label: "", icon_name: icon, url, tab_id: "" }
  }
  debug_assert(omnibox_row_shows_site(row(ICON_LAYERS, "https://drafts.csswg.org/css-grid-3/")), "an open tab row shows its site")
  debug_assert(omnibox_row_shows_site(row(ICON_CLOCK, "https://gridbyexample.com/")), "a history row shows its site")
  debug_assert(omnibox_row_shows_site(row(ICON_STAR_FILLED, "https://webkit.org/")), "a bookmark row shows its site")
  debug_assert(!omnibox_row_shows_site(row(ICON_SEARCH, "https://google.com/search?q=grid")), "a web search keeps its glyph")

  let ctrl = make_demo_controller(omnibox_open=true)
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(root, ctrl.model(), fn(ev) { ctrl.dispatch(ev) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }))
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  let ground = shell_site_letter_ground("drafts.csswg.org")
  let side_w = shell_sidebar_width(1280.0, true)
  debug_assert(uq_has_ground(t, ground, SP_24, side_w, 1280.0), "the palette's open-tab row uses the site tile")
  let mut sidebar_has = false
  for d in t.drawn() {
    if d.ground == ground && d.x < side_w && d.w <= SP_24 && d.w >= SP_16 - 0.5 {
      sidebar_has = true
    }
  }
  debug_assert(sidebar_has, "the sidebar shows the same tile color for that tab")
  // The letter tile's ground carries its white letter at 4.5:1 (the one rule for every surface).
  debug_assert(ui::contrast_ratio(0xFFFFFFFFL, ground) >= 4.5, "site letter tile reads at 4.5:1")
  t.dispose()
  lg::set_dark(None)
}

// ============================================================================
// One palette (Q2)
// ============================================================================

test "ui quality: the address palette and the Command Bar are one panel: same left, width and corner" {
  lg::set_dark(Some(false))
  let ctrl = make_demo_controller(omnibox_open=true)
  let t = ui::Tester::tree(
    fn(root) {
      build_shell_frame(root, ctrl.model(), fn(ev) { ctrl.dispatch(ev) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }))
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  let omni = match t.get("Omnibox Suggestions") {
    Some(d) => d
    None => {
      debug_assert(false, "address palette open")
      return
    }
  }
  debug_assert(uq_corner_at(t, omni.x, omni.w) == SP_20, "address palette corner is SP_20: " + uq_corner_at(t, omni.x, omni.w).to_string())
  debug_assert(t.find("Navigate").is_some() && t.find("Close").is_some(), "address palette has the keycap footer")
  t.dispose()

  let ctrl2 = make_demo_controller()
  ctrl2.exclusive.set(ctrl2.exclusive.untracked().open(ExclusiveKind::CommandBar, tag="command_bar"))
  let t2 = ui::Tester::tree(
    fn(root) {
      build_shell_frame(root, ctrl2.model(), fn(ev) { ctrl2.dispatch(ev) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl2.model()) }))
      build_command_bar_overlay(
        root,
        ctrl2.model(),
        CommandBarProps::{
          field: ui::Field::new(),
          items: fn() { [] },
          selected: fn() { 0 },
          on_query_change: fn(_q) { () },
          on_step: fn(_d) { true },
          on_submit: fn(_t) { () },
          on_execute: fn(_it) { () },
          on_close: fn() { () },
          on_row_view: None,
          on_clear_rows: None,
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t2.frame(ms=16.0)
  t2.frame(ms=300.0)
  match t2.get("Command Bar") {
    Some(cb) => {
      debug_assert((cb.x - omni.x).abs() <= 1.0, "same left edge: palette " + omni.x.to_string() + ", bar " + cb.x.to_string())
      debug_assert((cb.w - omni.w).abs() <= 1.0, "same width: palette " + omni.w.to_string() + ", bar " + cb.w.to_string())
      debug_assert((cb.y - omni.y).abs() <= 1.0, "same top")
      debug_assert(uq_corner_at(t2, cb.x, cb.w) == SP_20, "Command Bar corner is SP_20: " + uq_corner_at(t2, cb.x, cb.w).to_string())
      debug_assert(t2.find("Navigate").is_some() && t2.find("Run").is_some(), "Command Bar has the keycap footer")
    }
    None => debug_assert(false, "Command Bar open")
  }
  // No dimming behind the Command Bar (as behind the address palette): no window-sized translucent ground.
  let mut dims = 0
  for d in t2.drawn() {
    if d.w >= 1279.0 && d.h >= 799.0 && (d.ground & 0xFFL) > 0L && (d.ground & 0xFFFFFF00L) == 0L {
      dims += 1
    }
  }
  debug_assert(dims == 0, "the Command Bar does not dim the page")
  t2.dispose()
  lg::set_dark(None)
}

// ============================================================================
// Text accents at 4.5:1 (Q4)
// ============================================================================

test "ui quality: accent and positive words read at 4.5:1 on the card in light and dark" {
  lg::set_dark(Some(false))
  debug_assert(ui::contrast_ratio(shell_accent_text(), 0xFFFFFFFFL) >= 4.5, "accent words on white")
  debug_assert(ui::contrast_ratio(shell_positive_text(), 0xFFFFFFFFL) >= 4.5, "positive words on white")
  debug_assert(ui::contrast_ratio(shell_accent_text(), lg::surface().canvas) >= 4.5, "accent words on the canvas")
  debug_assert(dlsc_status_ink("in_progress") == shell_accent_text(), "a running download's line uses the text accent")
  lg::set_dark(Some(true))
  debug_assert(ui::contrast_ratio(shell_accent_text(), 0x1C1C1EFFL) >= 4.5, "accent words on the dark card")
  debug_assert(ui::contrast_ratio(shell_positive_text(), 0x1C1C1EFFL) >= 4.5, "positive words on the dark card")
  lg::set_dark(None)
}

// ============================================================================
// One panel header and close button (Q6, Q12)
// ============================================================================

test "ui quality: every panel closes with the same 32pt flat button, which washes in on hover" {
  lg::set_dark(Some(false))
  let (dt, _) = uq_downloads([uq_download_item("a", "PDF", "completed")])
  let close = match dt.get("Close Downloads") {
    Some(d) => d
    None => {
      debug_assert(false, "Downloads close")
      return
    }
  }
  debug_assert(close.w == SP_32 && close.h == SP_32 && close.radius == SP_8, "Downloads close is 32pt, radius 8")
  debug_assert((close.ground & 0xFFL) == 0L, "no fill at rest")
  // Hover: mid-fade at 60ms (between none and the full wash), the full row_hover wash at rest.
  dt.move_to(close.x + SP_16, close.y + SP_16)
  dt.frame(ms=16.0)
  dt.frame(ms=44.0)
  let mid = match dt.get("Close Downloads") {
    Some(d) => d.ground & 0xFFL
    None => 0L
  }
  dt.frame(ms=300.0)
  let rest = match dt.get("Close Downloads") {
    Some(d) => d.ground
    None => 0L
  }
  let full = lg::surface().row_hover & 0xFFL
  debug_assert(mid > 0L && mid < full, "hover wash is mid-fade at 60ms: " + mid.to_string() + " of " + full.to_string())
  debug_assert(rest == lg::surface().row_hover, "hover wash at rest is row_hover")
  dt.dispose()

  let st = uq_settings(1280.0, SETTINGS_TAB_PRIVACY)
  match st.get("Close Settings") {
    Some(d) => debug_assert(d.w == SP_32 && d.h == SP_32 && d.radius == SP_8, "Settings close is the same button")
    None => debug_assert(false, "Settings close")
  }
  st.dispose()

  let open = signals::signal(true)
  let ht = uq_history(open)
  match ht.get("Close History") {
    Some(d) => debug_assert(d.w == SP_32 && d.h == SP_32 && d.radius == SP_8, "History drawer close is the same button")
    None => debug_assert(false, "History close")
  }
  debug_assert(ht.get("Close").is_none(), "no second (lg) close button in the drawer")
  ht.dispose()

  let ct = uq_closed_tabs()
  match ct.get("Close Recently Closed") {
    Some(d) => debug_assert(d.w == SP_32 && d.h == SP_32, "Recently closed close is the same button")
    None => debug_assert(false, "Recently closed close")
  }
  debug_assert(ct.find("Recently closed").is_some(), "sentence-case title")
  debug_assert(ct.find("2 closed tabs").is_none(), "no counter under the title (the rows say it)")
  ct.dispose()
  lg::set_dark(None)
}

// ============================================================================
// Drawers inside the page card (Q7)
// ============================================================================

test "ui quality: trailing drawers sit inside the page card, never on its edge" {
  lg::set_dark(Some(false))
  let open = signals::signal(true)
  let t = uq_history(open)
  // The drawer card: the tallest wide rounded box on the right.
  let mut right = 0.0
  let mut top = 9999.0
  for d in t.drawn() {
    if d.w >= SP_160 * 2.0 && d.h >= SP_160 * 3.0 && d.radius >= SP_20 && d.x > 640.0 {
      if d.x + d.w > right {
        right = d.x + d.w
      }
      if d.y < top {
        top = d.y
      }
    }
  }
  let want = 1280.0 - (SHELL_FRAME_GAP + SP_8)
  debug_assert((right - want).abs() <= 0.5, "History drawer right edge 16pt in: " + right.to_string())
  debug_assert(top >= SHELL_FRAME_GAP + SP_8 - 0.5, "History drawer top 16pt in: " + top.to_string())
  t.dispose()
  lg::set_dark(None)
}

// ============================================================================
// Empty states without useless controls (Q11)
// ============================================================================

test "ui quality: empty Downloads shows its empty state alone; the controls come with the first download" {
  lg::set_dark(Some(false))
  let (t, _) = uq_downloads([])
  debug_assert(t.find("No recent downloads").is_some(), "empty state shown")
  debug_assert(t.get("Search Downloads").is_none(), "no search field with nothing to search")
  debug_assert(t.find("PDFs").is_none(), "no type filter with nothing to filter")
  debug_assert(t.find("Clear list").is_none(), "no Clear list with nothing to clear")
  t.dispose()
  let (t2, _) = uq_downloads([uq_download_item("a", "PDF", "completed")])
  debug_assert(t2.get("Search Downloads").is_some() && t2.find("PDFs").is_some() && t2.find("Clear list").is_some(), "controls with a download")
  uq_assert_hits(t2, (SP_160 * 5.0, SP_0, SP_160 * 3.0, 800.0), "downloads")
  t2.dispose()
  // A search that matches nothing keeps the field (to change the query).
  let (t3, _) = uq_downloads([], query="zzz")
  debug_assert(t3.get("Search Downloads").is_some(), "the field stays while a query hides everything")
  t3.dispose()
  lg::set_dark(None)
}

// ============================================================================
// Settings at 480 (Q10)
// ============================================================================

test "ui quality: Settings at 480pt names every category, and each is a 32pt target" {
  lg::set_dark(Some(false))
  let t = uq_settings(480.0, SETTINGS_TAB_PRIVACY)
  for name in ["General", "Appearance", "Tabs", "Search", "Privacy", "Downloads", "Shortcuts", "About"] {
    match t.get(name) {
      Some(d) => {
        debug_assert(d.h >= SP_32 - 0.5 && d.w >= SP_32, name + " is a 32pt target")
        let mut drawn = false
        for w in t.drawn() {
          // Inside its target, and as wide as the whole word (an ellipsis drawn at paint time would still say
          // the whole name but have less room than it).
          if w.words == name && w.alpha > 0.5 && w.x >= d.x - 0.5 && w.x + w.w <= d.x + d.w + 0.5 &&
          w.w >= ui::measure_text_width(name, TX_BODY) - 0.5 {
            drawn = true
          }
        }
        debug_assert(drawn, name + " says its name in full inside its target")
      }
      None => debug_assert(false, "category " + name)
    }
  }
  // The open one is told by a ground, not a thin ring.
  match t.get("Privacy") {
    Some(d) => debug_assert(d.ground != 0L && (d.ground & 0xFFL) > 0L, "open category has the selected ground")
    None => ()
  }
  uq_assert_hits(t, (SP_0, SP_0, 480.0, 800.0), "settings 480")
  t.dispose()
  lg::set_dark(None)
}

test "ui quality: drawers' pressables are at least 32pt" {
  lg::set_dark(Some(false))
  let open = signals::signal(true)
  let ht = uq_history(open)
  uq_assert_hits(ht, (SP_160 * 5.0, SP_0, SP_160 * 3.0, 800.0), "history drawer")
  ht.dispose()
  let ct = uq_closed_tabs()
  uq_assert_hits(ct, (SP_160 * 5.0, SP_0, SP_160 * 3.0, 800.0), "recently closed")
  ct.dispose()
  lg::set_dark(None)
}

// ============================================================================
// Review follow-ups: focus, Clear list, popover inset, drawn contrast, full-frame monochrome
// ============================================================================

test "ui quality: the one panel icon button shows the keyboard focus (History drawer close)" {
  lg::set_dark(Some(false))
  let open = signals::signal(true)
  let t = uq_history(open)
  let close_id = match t.get("Close History") {
    Some(d) => d.id
    None => {
      debug_assert(false, "Close History")
      return
    }
  }
  let mut reached = false
  let mut i = 0
  while i < 24 && !reached {
    t.key(ui::key_tab)
    t.frame(ms=16.0)
    match ui::view_tree() {
      Some(tr) => {
        let (f, shown) = tr.focused_now()
        let on_close = match f {
          Some(fid) => fid == close_id
          None => false
        }
        if on_close {
          reached = true
          debug_assert(shown, "Tab shows the focus")
          debug_assert(!tr.focus_blind().contains(close_id), "Close History is not focus-blind")
          match t.get("Close History") {
            Some(d) => debug_assert(d.ring.0 != 0.0, "a focus ring is drawn round Close History")
            None => ()
          }
        }
      }
      None => ()
    }
    i += 1
  }
  debug_assert(reached, "Tab reaches Close History")
  // No Tab stop of the drawer is blind.
  match ui::view_tree() {
    Some(tr) => {
      let blind = tr.focus_blind()
      let mut names = ""
      for id in blind {
        for d in t.drawn() {
          if d.id == id {
            for e in t.agent_snapshot() {
              let (ex, ey, _, _) = e.rect
              if (ex - d.x).abs() < 0.5 && (ey - d.y).abs() < 0.5 {
                names = names + e.label + "; "
              }
            }
            names = names + "@" + d.x.to_string() + "," + d.y.to_string() + " " + d.w.to_string() + "x" + d.h.to_string() + "; "
          }
        }
      }
      debug_assert(blind.length() == 0, "no focus-blind Tab stop in the History drawer: " + names)
    }
    None => ()
  }
  t.dispose()
  lg::set_dark(None)
}

test "ui quality: Clear list hands the focus to Close, and Escape still closes Downloads" {
  lg::set_dark(Some(false))
  let live = signals::signal_by([uq_download_item("a", "PDF", "completed")], fn(a, b) { a.length() == b.length() })
  let closed : signals::Ref[Bool] = ui::ref_new(false)
  let (t, _) = uq_downloads([], live=live, closed=closed)
  debug_assert(t.find("Clear list").is_some(), "Clear list with a download")
  t.press("Clear list")
  t.frame(ms=16.0)
  t.frame(ms=300.0)
  debug_assert(live.untracked().length() == 0, "Clear list emptied the list")
  debug_assert(t.find("No recent downloads").is_some() && t.find("Clear list").is_none(), "empty state alone")
  match (ui::view_tree(), t.get("Close Downloads")) {
    (Some(tr), Some(d)) => {
      let (f, _) = tr.focused_now()
      let on_close = match f {
        Some(fid) => fid == d.id
        None => false
      }
      debug_assert(on_close, "the focus is on Close Downloads, not on the button that left")
    }
    _ => debug_assert(false, "Close Downloads")
  }
  t.key(ui::key_escape)
  t.frame(ms=16.0)
  debug_assert(closed.v, "Escape closes the popover after Clear list")
  t.dispose()
  lg::set_dark(None)
}

test "ui quality: the Downloads popover stays inside the page card on the right" {
  lg::set_dark(Some(false))
  // A trigger hard by the window's right edge: the popover would otherwise end on the card's edge.
  let (t, _) = uq_downloads([uq_download_item("a", "PDF", "completed")], trigger_x=1240.0)
  match t.get("Downloads", role=view::Role::Dialog) {
    Some(d) => {
      let want = 1280.0 - (SHELL_FRAME_GAP + SP_8)
      debug_assert(d.x + d.w <= want + 0.5, "Downloads right edge 16pt in: " + (d.x + d.w).to_string())
    }
    None => debug_assert(false, "Downloads popover")
  }
  t.dispose()
  lg::set_dark(None)
}

test "ui quality: accent and positive words as drawn in the zoom and media popovers read at 4.5:1" {
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_zoom_popover(
        root,
        ZoomPopoverProps::{
          open: fn() { true },
          host_label: fn() { "docs.example" },
          zoom_percent: fn() { 110 },
          can_zoom_out: fn() { true },
          can_zoom_in: fn() { true },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 200.0, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { AnchorRect::{ x: 160.0, y: 4.0, w: 500.0, h: 36.0 } },
          on_zoom_out: fn() { () },
          on_zoom_in: fn() { () },
          on_reset: fn() { () },
          on_save_default: fn() { () },
          on_close: fn() { () },
        },
      )
      build_media_hub_popover(
        root,
        MediaHubPopoverProps::{
          open: fn() { true },
          entries: fn() {
            [
              MediaHubEntry::{ tab_id: "t1", title: "Groove Salad", source_host: "soma.fm", playing: true, muted: false, is_live_call: false },
              MediaHubEntry::{ tab_id: "t2", title: "Standup", source_host: "meet.example", playing: true, muted: false, is_live_call: true },
            ]
          },
          trigger_anchor: fn() { Some(AnchorRect::{ x: 1080.0, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { AnchorRect::{ x: 700.0, y: 4.0, w: 500.0, h: 36.0 } },
          callbacks: MediaHubCallbacks::{
            on_toggle_play: fn(_t) { () },
            on_toggle_mute: fn(_t) { () },
            on_mute_all: fn() { () },
            on_jump_tab: fn(_t) { () },
            on_close: fn() { () },
          },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  for w in ["Actual size", "Mute all", "Live call"] {
    let c = uq_words_contrast(t, w)
    debug_assert(c >= 4.5, w + " reads at 4.5:1 as drawn: " + c.to_string())
  }
  t.dispose()
  lg::set_dark(None)
}

test "ui quality: no decorative palette tile anywhere in the frame (address palette, Page Controls, dialogs)" {
  lg::set_dark(Some(false))
  let scan = fn(ctrl : ShellController, what : String) -> Unit {
    let t = ui::Tester::tree(
      fn(root) {
        build_shell_frame(root, ctrl.model(), fn(ev) { ctrl.dispatch(ev) }, PaneSlot::new(fn(p, id) { build_demo_pane(p, id, ctrl.model()) }))
      },
      width=1280.0,
      height=800.0,
      theme=lg::ui_theme,
    )
    t.frame(ms=16.0)
    t.frame(ms=400.0)
    let mut n = 0
    for size in [SP_16, SP_20, SP_24, SP_32] {
      n += uq_palette_tiles(t, size)
    }
    debug_assert(n == 0, what + ": decorative palette tiles: " + n.to_string())
    t.dispose()
  }
  scan(make_demo_controller(omnibox_open=true), "address palette")
  scan(make_demo_controller(drawer_open=true), "Page Controls")
  scan(make_demo_controller(dialog_open=true), "dialog")
  scan(make_demo_controller(capture_sheet=true), "capture sheet")
  lg::set_dark(None)
}
