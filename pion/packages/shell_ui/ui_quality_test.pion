///| UI quality sweep regressions (DESIGN.md sections 3 and 5): monochrome glyph tiles, one site tile, one palette,
///| one panel header and close button, text accents at 4.5:1, drawers inside the page card, empty states without
///| controls, labeled narrow Settings, and every pressable in a panel at least 32pt.

import "lg"
import "proto"
import "signals"
import "ui"
import "view"

// ============================================================================
// Helpers
// ============================================================================

///| Hit scan: every button the panel exposes inside `region` (x, y, w, h) is at least 32pt on both axes.
///| Returns one fault per smaller button ("label w x h").
fn uq_hit_faults(t : ui::Tester, region : (Double, Double, Double, Double)) -> Array[String] {
  let (rx, ry, rw, rh) = region
  let out : Array[String] = []
  for e in t.agent_snapshot() {
    if !(e.role is view::Role::Button) || e.disabled {
      continue
    }
    let (x, y, w, h) = e.rect
    if w <= 0.0 || h <= 0.0 {
      continue
    }
    let cx = x + w / 2.0
    let cy = y + h / 2.0
    if cx < rx || cx > rx + rw || cy < ry || cy > ry + rh {
      continue
    }
    if w < SP_32 - 0.5 || h < SP_32 - 0.5 {
      out.push(e.label + " " + w.to_string() + "x" + h.to_string())
    }
  }
  out
}

fn uq_assert_hits(t : ui::Tester, region : (Double, Double, Double, Double), label : String) -> Unit {
  let f = uq_hit_faults(t, region)
  let mut msg = ""
  for x in f {
    msg = msg + x + "; "
  }
  debug_assert(f.length() == 0, label + ": pressables under 32pt: " + msg)
}

///| Square tiles drawn at `size` whose ground is one of the old decorative palette colors.
fn uq_palette_tiles(t : ui::Tester, size : Double) -> Int {
  let pal = shell_tile_palette()
  let mut n = 0
  for d in t.drawn() {
    if d.alpha > 0.05 && (d.w - size).abs() < 0.5 && (d.h - size).abs() < 0.5 {
      for c in pal {
        if d.ground == c {
          n += 1
        }
      }
    }
  }
  n
}

///| The corner of the panel surface drawn at `x`, `w` wide (the largest radius of a box that spans it).
fn uq_corner_at(t : ui::Tester, x : Double, w : Double) -> Double {
  let mut r = 0.0
  for d in t.drawn() {
    if (d.x - x).abs() <= 1.0 && (d.w - w).abs() <= 1.0 && d.h >= SP_48 && d.radius > r {
      r = d.radius
    }
  }
  r
}

///| The opaque ground drawn under the point (x, y): the last fully opaque box in paint order that holds it.
fn uq_ground_under(t : ui::Tester, x : Double, y : Double) -> Int64 {
  let mut g = 0L
  for d in t.drawn() {
    if d.alpha > 0.99 && (d.ground & 0xFFL) == 0xFFL && x >= d.x && x <= d.x + d.w && y >= d.y && y <= d.y + d.h {
      g = d.ground
    }
  }
  g
}

///| The contrast of the words `text` as drawn against the ground under them (0 when not drawn).
fn uq_words_contrast(t : ui::Tester, text : String) -> Double {
  for d in t.drawn() {
    if d.words == text && d.alpha > 0.5 {
      let g = uq_ground_under(t, d.x + d.w / 2.0, d.y + d.h / 2.0)
      if g == 0L {
        return 0.0
      }
      return ui::contrast_ratio(d.ink, g)
    }
  }
  0.0
}

fn uq_has_ground(t : ui::Tester, color : Int64, size : Double, x_from : Double, x_to : Double) -> Bool {
  for d in t.drawn() {
    if d.ground == color && d.alpha > 0.05 && (d.w - size).abs() < 0.5 && d.x >= x_from && d.x < x_to {
      return true
    }
  }
  false
}

fn uq_downloads(
  items : Array[DownloadItemView],
  query~ : String = "",
  trigger_x~ : Double = 1120.0,
  live? : signals::Signal[Array[DownloadItemView]],
  closed? : signals::Ref[Bool],
) -> (ui::Tester, ui::Field) {
  let field = ui::Field::new()
  field.set(query)
  let list = match live {
    Some(l) => l
    None => signals::signal_by(items, fn(a, b) { a.length() == b.length() })
  }
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_downloads_popover(
        root,
        DownloadsPopoverProps::{
          open: fn() { true },
          search_field: field,
          active_category: fn() { "all" },
          total_count: fn() { list.get().length() },
          items: fn() { list.get() },
          trigger_anchor: fn() { Some(AnchorRect::{ x: trigger_x, y: 8.0, w: 32.0, h: 28.0 }) },
          fallback_capsule: fn() { AnchorRect::{ x: 260.0, y: 4.0, w: 500.0, h: 36.0 } },
          callbacks: DownloadsCallbacks::{
            on_search_change: fn(_q) { () },
            on_category_change: fn(_c) { () },
            on_copy_path: fn(_id) { () },
            on_reveal: fn(_id) { () },
            on_clear_list: fn() { list.set([]) },
            on_close: fn() {
              match closed {
                Some(r) => r.v = true
                None => ()
              }
            },
          },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  (t, field)
}

fn uq_download_item(id : String, ext : String, state : String) -> DownloadItemView {
  DownloadItemView::{
    id,
    filename: id + "." + ext,
    source_host: "docs.example",
    ext_badge: ext,
    size_label: "2.4 MB",
    state,
    state_label: if state == "in_progress" { "Downloading" } else { "Done" },
  }
}

fn uq_settings(w : Double, tab : Int) -> ui::Tester {
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_settings_panel(
        root,
        SettingsPanelProps::{
          open: fn() { true },
          dark: fn() { false },
          active_tab: signals::signal(tab),
          settings: fn() { proto::BrowserSettings::default() },
          clear_bookmarks: signals::signal(false),
          clear_history: signals::signal(true),
          clear_downloads: signals::signal(false),
          clear_boosts: signals::signal(false),
          filter_field: Some(ui::Field::new()),
          on_save_settings: fn(_s, _m) { () },
          on_step_zoom: fn(_d) { () },
          on_clear_browsing_data: fn(_sel) { () },
          on_close: fn() { () },
        },
      )
    },
    width=w,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=400.0)
  t
}

fn uq_history(open : signals::Signal[Bool]) -> ui::Tester {
  let now_s : Int64 = 1795522600L
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_history_drawer_panel(
        root,
        HistoryDrawerProps::{
          open: fn() { open.get() },
          items: fn() {
            [
              proto::HistoryItemSummary::{
                url: "https://farview.dev/today",
                title: "Farview Architecture",
                host: "farview.dev",
                visit_count: 5,
                last_visit_secs: now_s - 600L,
              },
            ]
          },
          total_count: fn() { 1 },
          now_secs: fn() { now_s },
          search_field: ui::Field::new(),
          on_query_change: fn(_q) { () },
          on_open_url: fn(_u) { () },
          on_delete_url: fn(_u) { () },
          on_clear_range: fn(_r) { () },
          on_close: fn() { open.set(false) },
        },
      )
    },
    width=1280.0,
    height=800.0,
    theme=lg::ui_theme,
  )
  t.frame(ms=16.0)
  t.frame(ms=600.0)
  t
}

fn uq_closed_tabs() -> ui::Tester {
  let now_s : Int64 = 1795522600L
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))
      build_closed_tabs_drawer_panel(
