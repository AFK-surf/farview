///| Unit tests for `net` (TCP loopback listen/accept/poll/send/recv + file helpers).

test "tcp loopback listen_on, accept_now, poll, bidirectional send/recv, close" {
  let srv = listen_on("127.0.0.1", 0)
  debug_assert(srv >= 0, "listen_on failed")
  let port = port_of(srv)
  debug_assert(port > 0, "port_of should be > 0")
  debug_assert(accept_now(srv) == -1, "no pending client yet")
  let cli = connect("127.0.0.1", port)
  debug_assert(cli >= 0, "connect failed")
  let ready = poll([srv], 1000)
  debug_assert(ready >= 1, "poll should see incoming connection")
  let acc = accept_now(srv)
  debug_assert(acc >= 0, "accept_now should return client fd")

  let msg1 = "hello from client -> server".to_bytes()
  debug_assert(send(cli, msg1) == msg1.length(), "send msg1")
  debug_assert(poll([acc], 1000) >= 1, "poll should see readable data")
  match recv(acc, 1000) {
    Option::Some(got) => debug_assert(got.to_string() == "hello from client -> server", "recv msg1")
    Option::None => debug_assert(false, "unexpected EOF on msg1")
  }

  let msg2 = "reply from server -> client".to_bytes()
  debug_assert(send(acc, msg2) == msg2.length(), "send msg2")
  match recv(cli, 1000) {
    Option::Some(got) => debug_assert(got.to_string() == "reply from server -> client", "recv msg2")
    Option::None => debug_assert(false, "unexpected EOF on msg2")
  }

  // Non-blocking timeout returns empty bytes (0 bytes available, still open)
  match recv(cli, 5) {
    Option::Some(empty) => debug_assert(empty.length() == 0, "timeout should yield 0 bytes")
    Option::None => debug_assert(false, "should not be closed yet")
  }

  // Closing peer causes recv to return None
  close(acc)
  match recv(cli, 1000) {
    Option::None => debug_assert(true, "closed peer yields None")
    Option::Some(_) => debug_assert(false, "expected None after close")
  }
  close(cli)
  close(srv)
}

test "getpid, catch_term, setenv, and atomic file helpers" {
  let pid = getpid()
  debug_assert(pid > 0, "pid > 0")
  catch_term()
  debug_assert(!term_asked(), "term not asked")
  setenv("FV_PION_NET_TEST_ENV", "ok")
  let dir = "/tmp/fv_pion_net_test_" + pid.to_string()
  mkdir(dir)
  let p = dir + "/data.txt"
  write_file(p, "line1\n")
  append_file(p, "line2\n")
  write_file_atomic(p, "atomic_final\n")
}

fn make_tagged_frame(seq : Int, payload_len : Int) -> Bytes {
  let total = 4 + payload_len
  let b = Bytes::new(total)
  b[0] = ((payload_len >> 24) & 0xFF).to_byte()
  b[1] = ((payload_len >> 16) & 0xFF).to_byte()
  b[2] = ((payload_len >> 8) & 0xFF).to_byte()
  b[3] = (payload_len & 0xFF).to_byte()
  let mut i = 0
  while i < payload_len {
    b[4 + i] = ((seq * 31 + i * 7 + 13) & 0xFF).to_byte()
    i = i + 1
  }
  b
}

test "nb short write with tiny SO_SNDBUF preserves exact multi-frame byte stream" {
  let srv = listen_on("127.0.0.1", 0)
  debug_assert(srv >= 0, "listen_on failed")
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli >= 0, "connect_timeout failed")
  debug_assert(poll([srv], 1000) >= 1, "poll srv")
  let acc = accept_now(srv)
  debug_assert(acc >= 0, "accept_now failed")
  debug_assert(set_nonblock(acc, true), "set_nonblock acc")
  // Shrink socket buffers so large multi-frame burst forces short writes + WouldBlock
  let _ = set_sndbuf(cli, 4096)
  let _ = set_rcvbuf(acc, 4096)

  let conn = ConnIo::new(recv_buf_size=4096, max_frames=256, max_bytes=4194304)
  debug_assert(conn.attach(cli), "attach cli")

  let frame_count = 40
  let payload_len = 8192
  let expected_total = frame_count * (4 + payload_len)
  let mut s = 0
  while s < frame_count {
    let f = make_tagged_frame(s, payload_len)
    match conn.enqueue(f, coalescable=false) {
      EnqueueResult::Ok => ()
      _ => debug_assert(false, "enqueue should succeed")
    }
    s = s + 1
  }

  let recv_acc : Array[Bytes] = []
  let rbuf = Bytes::new(4096)
  let pfds = [cli, acc]
  let pevs = [POLL_OUT, POLL_IN]
  let prevs = [0, 0]
  let mut total_rx = 0
  let mut would_block_hits = 0
  let mut iters = 0
  while (conn.pending_frames() > 0 || total_rx < expected_total) && iters < 20000 {
    iters = iters + 1
    let mut progressed = false
    if conn.pending_frames() > 0 {
      let before_bytes = conn.pending_bytes()
      match conn.flush_write() {
        FlushResult::Flushed | FlushResult::BudgetReached => progressed = true
        FlushResult::WouldBlock => {
          would_block_hits = would_block_hits + 1
          if conn.pending_bytes() < before_bytes {
            progressed = true
          }
        }
        FlushResult::Err => debug_assert(false, "unexpected write err")
      }
    }
    // Throttled peer read: read at most 2048 bytes per turn to maximize short-write pressure
    match recv_nb(acc, rbuf, 0, 2048) {
      NbIo::Bytes(n) => {
        total_rx = total_rx + n
        recv_acc.push(rbuf.slice(0, n))
        progressed = true
      }
      NbIo::WouldBlock | NbIo::Intr => ()
      NbIo::Eof | NbIo::Err => debug_assert(false, "unexpected peer read err/eof")
    }
    if !progressed {
      pevs[0] = if conn.pending_frames() > 0 { POLL_OUT } else { 0 }
      pevs[1] = POLL_IN
      let _ = poll_fds(pfds, pevs, prevs, 50)
    }
  }

  debug_assert(conn.pending_frames() == 0, "all frames flushed")
  debug_assert(conn.pending_bytes() == 0, "pending bytes == 0")
  debug_assert(total_rx == expected_total, "exact byte count received")
  debug_assert(would_block_hits > 0, "short-write WouldBlock path must be exercised")

  // Reassemble and verify byte-for-byte integrity across all 40 frames (no duplicated prefix, no lost bytes)
  let all = Bytes::new(total_rx)
  let mut off = 0
  for ch in recv_acc {
    let mut i = 0
    while i < ch.length() {
      all[off + i] = ch[i]
      i = i + 1
    }
    off = off + ch.length()
  }
  let mut fi = 0
  let mut pos = 0
  while fi < frame_count {
    let exp = make_tagged_frame(fi, payload_len)
    let mut k = 0
    while k < exp.length() {
      debug_assert(all[pos + k] == exp[k], "byte mismatch at frame/offset")
      k = k + 1
    }
    pos = pos + exp.length()
    fi = fi + 1
  }

  let fd = conn.detach()
  close(fd)
  close(acc)
  close(srv)
}

test "nb slow read backpressure coalesces pointer moves, keeps critical commands, disconnects cleanly when full" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect/poll")
  let acc = accept_now(srv)
  debug_assert(acc >= 0 && set_nonblock(acc, true), "accept/nonblock")
  let _ = set_sndbuf(cli, 4096)
  let _ = set_rcvbuf(acc, 4096)

  // Small bounded queue (max 6 frames, 1 MiB) to deterministically exercise coalescing + QueueFull
  let conn = ConnIo::new(recv_buf_size=4096, max_frames=6, max_bytes=1048576)
  debug_assert(conn.attach(cli), "attach")

  // Saturate kernel send buffer so subsequent writes stay queued with head_off > 0
  let big = make_tagged_frame(1, 262144)
  debug_assert(match conn.enqueue(big, coalescable=false) { EnqueueResult::Ok => true; _ => false }, "enqueue big")
  let mut saturated = false
  let mut tries = 0
  while tries < 20 && !saturated {
    match conn.flush_write() {
      FlushResult::WouldBlock => saturated = true
      FlushResult::Flushed | FlushResult::BudgetReached => {
        // Enqueue another big frame until kernel buffer fills
        let _ = conn.enqueue(make_tagged_frame(10 + tries, 262144), coalescable=false)
      }
      FlushResult::Err => debug_assert(false, "err while saturating")
    }
    tries = tries + 1
  }
  debug_assert(saturated, "socket send buffer should saturate under unread peer")

  // Now enqueue 20 coalescable pointer moves interleaved with 2 critical commands
  let mut pm = 0
  while pm < 10 {
    let f = make_tagged_frame(100 + pm, 32)
    match conn.enqueue(f, coalescable=true) {
      EnqueueResult::Ok => ()
      _ => debug_assert(false, "coalescable pointer move should coalesce, not fail")
    }
    pm = pm + 1
  }
  let crit1 = make_tagged_frame(201, 48)
  debug_assert(match conn.enqueue(crit1, coalescable=false) { EnqueueResult::Ok => true; _ => false }, "crit1 ok")
  while pm < 20 {
    let f = make_tagged_frame(100 + pm, 32)
    match conn.enqueue(f, coalescable=true) {
      EnqueueResult::Ok => ()
      _ => debug_assert(false, "second burst of pointer moves should coalesce")
    }
    pm = pm + 1
  }
  let crit2 = make_tagged_frame(202, 48)
  debug_assert(match conn.enqueue(crit2, coalescable=false) { EnqueueResult::Ok => true; _ => false }, "crit2 ok")
  debug_assert(conn.coalesced_count() >= 18, "pointer moves must be coalesced")

  // Fill remaining slots with non-coalescable commands until QueueFull is returned
  let mut hit_full = false
  let mut extra = 0
  while extra < 20 {
    match conn.enqueue(make_tagged_frame(300 + extra, 48), coalescable=false) {
      EnqueueResult::QueueFull => {
        hit_full = true
        break
      }
      EnqueueResult::Ok => extra = extra + 1
      EnqueueResult::NotConnected | EnqueueResult::TooLarge => debug_assert(false, "unexpected enqueue status")
    }
  }
  debug_assert(hit_full, "non-coalescable overflow must return QueueFull instead of dropping silently")

  // Clean disconnect on QueueFull: detach & close without sending corrupted half-frame
  let fd = conn.detach()
  debug_assert(!conn.is_open(), "conn detached cleanly")
  close(fd)
  close(acc)
  close(srv)
}

test "nb EOF mid-frame distinguishes Eof from WouldBlock without spin" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect/poll")
  let acc = accept_now(srv)
  debug_assert(acc >= 0, "accept")

  let conn = ConnIo::new(recv_buf_size=4096)
  debug_assert(conn.attach(cli), "attach")

  // Peer sends only the first 6 bytes of a 100-byte length-prefixed frame (half-frame)
  let partial = Bytes::new(6)
  partial[0] = (0).to_byte()
  partial[1] = (0).to_byte()
  partial[2] = (0).to_byte()
  partial[3] = (100).to_byte()
  partial[4] = (0xAB).to_byte()
  partial[5] = (0xCD).to_byte()
  debug_assert(send(acc, partial) == 6, "peer send partial")
  debug_assert(poll([cli], 1000) >= 1, "wait partial readable")

  let got : Array[Bytes] = []
  let r1 = conn.pump_read(65536, 10.0, fn() -> Double { 0.0 }, fn(ch : Bytes) -> Unit { got.push(ch) })
  match r1 {
    ReadResult::WouldBlock(n) => debug_assert(n == 6, "should read 6 bytes then WouldBlock")
    _ => debug_assert(false, "expected WouldBlock(6) while peer still open")
  }
  // Second idle read returns WouldBlock(0) with zero allocation
  let r2 = conn.pump_read(65536, 10.0, fn() -> Double { 0.0 }, fn(ch : Bytes) -> Unit { got.push(ch) })
  match r2 {
    ReadResult::WouldBlock(n) => debug_assert(n == 0, "expected WouldBlock(0)")
    _ => debug_assert(false, "expected WouldBlock(0)")
  }

  // Peer closes mid-frame -> must return Eof(0), distinct from WouldBlock
  close(acc)
  debug_assert(poll([cli], 1000) >= 1, "wait EOF readable")
  let r3 = conn.pump_read(65536, 10.0, fn() -> Double { 0.0 }, fn(ch : Bytes) -> Unit { got.push(ch) })
  match r3 {
    ReadResult::Eof(n) => debug_assert(n == 0, "expected Eof(0) after peer close mid-frame")
    _ => debug_assert(false, "expected Eof(0) on peer close")
  }

  let fd = conn.detach()
  close(fd)
  close(srv)
}

test "nb per-frame byte budget pauses cleanly and resumes without data loss" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect/poll")
  let acc = accept_now(srv)
  debug_assert(acc >= 0, "accept")

  let conn = ConnIo::new(recv_buf_size=4096)
  debug_assert(conn.attach(cli), "attach")

  let payload = make_tagged_frame(77, 49152)
  debug_assert(send(acc, payload) == payload.length(), "peer send 48 KiB")
  debug_assert(poll([cli], 1000) >= 1, "wait readable")

  let chunks : Array[Bytes] = []
  let mut total = 0
  let mut budget_hits = 0
  let mut rounds = 0
  while total < payload.length() && rounds < 200 {
    rounds = rounds + 1
    match conn.pump_read(8192, 100.0, fn() -> Double { 0.0 }, fn(ch : Bytes) -> Unit { chunks.push(ch) }) {
      ReadResult::BudgetReached(n) => {
        budget_hits = budget_hits + 1
        total = total + n
      }
      ReadResult::WouldBlock(n) => total = total + n
      ReadResult::Eof(_) | ReadResult::Err(_) => debug_assert(false, "unexpected eof/err")
    }
  }
  debug_assert(total == payload.length(), "all bytes received across budgeted frames")
  debug_assert(budget_hits >= 5, "per-frame byte budget must pause multiple times")

  let fd = conn.detach()
  close(fd)
  close(acc)
  close(srv)
}

test "nb self-wake pipe, poll_fds, and rapid open/close fd reuse stress" {
  match pipe_open() {
    Option::Some((pr, pw)) => {
      let fds = [pr]
      let evs = [POLL_IN]
      let revs = [0]
      debug_assert(poll_fds(fds, evs, revs, 0) == 0, "empty pipe not readable")
      debug_assert(pipe_wake(pw), "pipe_wake")
      debug_assert(poll_fds(fds, evs, revs, 100) == 1, "pipe readable after wake")
      debug_assert((revs[0] & POLL_IN) != 0, "POLL_IN set")
      debug_assert(pipe_drain(pr) >= 1, "pipe_drain >= 1")
      debug_assert(poll_fds(fds, evs, revs, 0) == 0, "pipe empty after drain")
      close(pr)
      close(pw)
    }
    Option::None => debug_assert(false, "pipe_open failed")
  }

  // Rapid 100-cycle open/connect/attach/detach/close + IoWatcher remove_and_close stress
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  match IoWatcher::pair() {
    Option::Some((watcher, _ctx)) => {
      let mut i = 0
      while i < 100 {
        let cli = connect_timeout("127.0.0.1", port, 1000)
        debug_assert(cli >= 0, "rapid connect_timeout")
        debug_assert(poll([srv], 1000) >= 1, "rapid poll srv")
        let acc = accept_now(srv)
        debug_assert(acc >= 0, "rapid accept")
        let c = ConnIo::new(recv_buf_size=1024)
        debug_assert(c.attach(cli), "rapid attach")
        c.sync_watch(watcher, force=true)
        let old = c.detach()
        watcher.remove_and_close(old)
        close(acc)
        i = i + 1
      }
      watcher.shutdown()
    }
    Option::None => debug_assert(false, "IoWatcher::pair failed")
  }
  close(srv)
}

test "nb IoWatcher immediate shutdown and mark_started remove_and_close have zero double-close" {
  // Case 1: pair() followed immediately by shutdown() (never started) + idempotent second shutdown()
  match IoWatcher::pair() {
    Option::Some((w1, ctx1)) => {
      w1.shutdown()
      w1.shutdown()
      // Calling run_loop after already-stopped shutdown must be a safe no-op
      ctx1.run_loop(fn() -> Unit { () })
    }
    Option::None => debug_assert(false, "IoWatcher::pair 1 failed")
  }

  // Case 2: mark_started() BEFORE run_loop, queue Arm + RemoveAndClose + Shutdown, then run_loop
  // drains all commands in order and closes each fd exactly once before exiting.
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  match IoWatcher::pair() {
    Option::Some((w2, ctx2)) => {
      w2.mark_started()
      let c1 = connect_timeout("127.0.0.1", port, 1000)
      debug_assert(c1 >= 0 && poll([srv], 1000) >= 1, "c1 connect")
      let a1 = accept_now(srv)
      debug_assert(a1 >= 0, "a1 accept")
      w2.arm(c1, true, false)
      w2.remove_and_close(c1)
      w2.shutdown()
      ctx2.run_loop(fn() -> Unit { () })
      // After run_loop stopped, removing another fd closes it directly once without panic
      let c2 = connect_timeout("127.0.0.1", port, 1000)
      debug_assert(c2 >= 0 && poll([srv], 1000) >= 1, "c2 connect")
      let a2 = accept_now(srv)
      debug_assert(a2 >= 0, "a2 accept")
      w2.remove_and_close(c2)
      close(a1)
      close(a2)
    }
    Option::None => debug_assert(false, "IoWatcher::pair 2 failed")
  }
  close(srv)
}

test "nb FD_CLOEXEC set on connect_timeout and set_nonblock" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 1000)
  debug_assert(cli >= 0 && fd_is_cloexec(cli), "connect_timeout socket must have FD_CLOEXEC")
  debug_assert(poll([srv], 1000) >= 1, "poll srv")
  let acc = accept_now(srv)
  debug_assert(acc >= 0, "accept")
  debug_assert(set_nonblock(acc, true), "set_nonblock")
  debug_assert(fd_is_cloexec(acc), "set_nonblock must ensure FD_CLOEXEC")
  close(cli)
  close(acc)
  close(srv)
}

test "nb send_nb and recv_nb reject 32-bit integer overflow bounds" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 1000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect")
  let acc = accept_now(srv)
  let buf = Bytes::new(16)
  match send_nb(cli, buf, 2147483640, 100) {
    NbIo::Err => ()
    _ => debug_assert(false, "send_nb must reject off+len 32-bit overflow")
  }
  match recv_nb(cli, buf, 2147483640, 100) {
    NbIo::Err => ()
    _ => debug_assert(false, "recv_nb must reject off+cap 32-bit overflow")
  }
  match send_nb(cli, buf, 16, 1) {
    NbIo::Err => ()
    _ => debug_assert(false, "send_nb must reject off==len with len>0")
  }
  match recv_nb(cli, buf, 0, 17) {
    NbIo::Err => ()
    _ => debug_assert(false, "recv_nb must reject cap > buf.length()")
  }
  close(cli)
  close(acc)
  close(srv)
}

test "nb empty queue allows single oversized frame and TooLarge does not disconnect" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 1000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect")
  let acc = accept_now(srv)
  // Small max_bytes (1024), larger hard single-frame cap (8192)
  let conn = ConnIo::new(recv_buf_size=4096, max_frames=8, max_bytes=1024, max_single_frame_bytes=8192)
  debug_assert(conn.attach(cli), "attach")

  // Exceeding hard single-frame cap returns TooLarge and keeps connection open
  let huge = Bytes::new(8193)
  match conn.enqueue(huge, coalescable=false) {
    EnqueueResult::TooLarge => ()
    _ => debug_assert(false, "frame > max_single_frame_bytes must return TooLarge")
  }
  debug_assert(conn.is_open(), "TooLarge must NOT disconnect")

  // Single frame > max_bytes (4096 > 1024) on an empty queue succeeds
  let big_ok = Bytes::new(4096)
  match conn.enqueue(big_ok, coalescable=false) {
    EnqueueResult::Ok => ()
    _ => debug_assert(false, "empty queue must accept single frame > max_bytes up to hard cap")
  }
  // Per-frame write cap returns BudgetReached after 1024 bytes and resumes cleanly
  match conn.flush_write(max_bytes=1024) {
    FlushResult::BudgetReached | FlushResult::WouldBlock => ()
    _ => debug_assert(false, "flush_write(max_bytes=1024) must pause at write cap")
  }
  debug_assert(conn.pending_bytes() == 3072 || conn.pending_bytes() > 0, "remaining bytes stay queued")

  let fd = conn.detach()
  close(fd)
  close(acc)
  close(srv)
}

test "nb 6 MiB oversized frame followed by keyup and more commands delivers intact in order on same connection" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect")
  let acc = accept_now(srv)
  debug_assert(acc >= 0 && set_nonblock(acc, true), "accept")

  let conn = ConnIo::new(recv_buf_size=65536, max_frames=32, max_bytes=4194304, max_single_frame_bytes=67108864)
  debug_assert(conn.attach(cli), "attach")

  // 6 MiB oversized frame (> 4 MiB max_bytes) on empty queue
  let big_len = 6291456
  let big = Bytes::new(big_len)
  big[0] = (0x55).to_byte()
  big[big_len - 1] = (0xAA).to_byte()
  match conn.enqueue(big, coalescable=false) {
    EnqueueResult::Ok => ()
    _ => debug_assert(false, "6 MiB frame on empty queue must succeed")
  }

  // Trailing keyup + 5 small commands must NOT hit QueueFull while 6 MiB head frame is in flight
  let smalls : Array[Bytes] = []
  let mut si = 0
  while si < 6 {
    let f = make_tagged_frame(50 + si, 32)
    smalls.push(f)
    match conn.enqueue(f, coalescable=false) {
      EnqueueResult::Ok => ()
      _ => debug_assert(false, "small command after oversized head frame must not hit QueueFull")
    }
    si = si + 1
  }
  debug_assert(conn.is_open(), "connection stayed open")

  let expected_total = big_len + 6 * 36
  let pfds = [cli, acc]
  let pevs = [POLL_OUT, POLL_IN]
  let prevs = [0, 0]
  let rbuf = Bytes::new(65536)
  let mut rx_total = 0
  let mut first_byte = -1
  let mut big_last_byte = -1
  let tail_bytes = Bytes::new(6 * 36)
  let mut iters = 0
  while (conn.pending_frames() > 0 || rx_total < expected_total) && iters < 50000 {
    iters = iters + 1
    let mut progressed = false
    if conn.pending_frames() > 0 {
      let before = conn.pending_bytes()
      match conn.flush_write(max_bytes=524288) {
        FlushResult::Flushed | FlushResult::BudgetReached => progressed = true
        FlushResult::WouldBlock => if conn.pending_bytes() < before { progressed = true }
        FlushResult::Err => debug_assert(false, "unexpected write err")
      }
    }
    match recv_nb(acc, rbuf, 0, 65536) {
      NbIo::Bytes(n) => {
        if rx_total == 0 && n > 0 {
          first_byte = rbuf[0].to_int()
        }
        if rx_total <= big_len - 1 && rx_total + n > big_len - 1 {
          big_last_byte = rbuf[big_len - 1 - rx_total].to_int()
        }
        if rx_total + n > big_len {
          let start_in_buf = if rx_total < big_len { big_len - rx_total } else { 0 }
          let start_in_tail = if rx_total > big_len { rx_total - big_len } else { 0 }
          let mut bi = start_in_buf
          let mut ti = start_in_tail
          while bi < n && ti < tail_bytes.length() {
            tail_bytes[ti] = rbuf[bi]
            bi = bi + 1
            ti = ti + 1
          }
        }
        rx_total = rx_total + n
        progressed = true
      }
      NbIo::WouldBlock | NbIo::Intr => ()
      NbIo::Eof | NbIo::Err => debug_assert(false, "unexpected peer read err")
    }
    if !progressed {
      pevs[0] = if conn.pending_frames() > 0 { POLL_OUT } else { 0 }
      pevs[1] = POLL_IN
      let _ = poll_fds(pfds, pevs, prevs, 50)
    }
  }
  debug_assert(rx_total == expected_total, "peer received exact 6 MiB + 6 small frames")
  debug_assert(first_byte == 0x55 && big_last_byte == 0xAA, "6 MiB frame boundaries intact")
  let mut pos = 0
  for sf in smalls {
    let mut k = 0
    while k < sf.length() {
      debug_assert(tail_bytes[pos + k] == sf[k], "trailing command byte mismatch")
      k = k + 1
    }
    pos = pos + sf.length()
  }

  // Also verify non-empty queue orderings: (a) pointer move -> 6 MiB, (b) small key -> 6 MiB,
  // and (c) second 6 MiB while first is queued returns QueueFull without disconnecting.
  let cli2 = connect_timeout("127.0.0.1", port, 2000)
  debug_assert(cli2 >= 0 && poll([srv], 1000) >= 1, "connect2")
  let acc2 = accept_now(srv)
  debug_assert(acc2 >= 0 && set_nonblock(acc2, true), "accept2")
  let conn2 = ConnIo::new(
    recv_buf_size=65536,
    max_frames=32,
    max_bytes=4194304,
    max_single_frame_bytes=67108864,
  )
  debug_assert(conn2.attach(cli2), "attach2")
  let pm = make_tagged_frame(1, 24)
  let sk = make_tagged_frame(2, 24)
  debug_assert(
    match conn2.enqueue(pm, coalescable=true) {
      EnqueueResult::Ok => true
      _ => false
    },
    "pm ok",
  )
  debug_assert(
    match conn2.enqueue(sk, coalescable=false) {
      EnqueueResult::Ok => true
      _ => false
    },
    "sk ok",
  )
  debug_assert(
    match conn2.enqueue(big, coalescable=false) {
      EnqueueResult::Ok => true
      _ => false
    },
    "6 MiB after pm+sk ok",
  )
  debug_assert(
    match conn2.enqueue(big, coalescable=false) {
      EnqueueResult::QueueFull => true
      _ => false
    },
    "second 6 MiB returns QueueFull",
  )
  let exp2 = pm.length() + sk.length() + big_len
  let pfds2 = [cli2, acc2]
  let pevs2 = [POLL_OUT, POLL_IN]
  let prevs2 = [0, 0]
  let mut rx2 = 0
  let head_got = Bytes::new(pm.length() + sk.length())
  let mut it2 = 0
  while (conn2.pending_frames() > 0 || rx2 < exp2) && it2 < 50000 {
    it2 = it2 + 1
    let mut prog = false
    if conn2.pending_frames() > 0 {
      let bef = conn2.pending_bytes()
      match conn2.flush_write(max_bytes=524288) {
        FlushResult::Flushed | FlushResult::BudgetReached => prog = true
        FlushResult::WouldBlock => if conn2.pending_bytes() < bef { prog = true }
        FlushResult::Err => debug_assert(false, "err2")
      }
    }
    match recv_nb(acc2, rbuf, 0, 65536) {
      NbIo::Bytes(n) => {
        if rx2 < head_got.length() {
          let mut bi = 0
          while bi < n && rx2 + bi < head_got.length() {
            head_got[rx2 + bi] = rbuf[bi]
            bi = bi + 1
          }
        }
        rx2 = rx2 + n
        prog = true
      }
      NbIo::WouldBlock | NbIo::Intr => ()
      NbIo::Eof | NbIo::Err => debug_assert(false, "peer err2")
    }
    if !prog {
      pevs2[0] = if conn2.pending_frames() > 0 { POLL_OUT } else { 0 }
      pevs2[1] = POLL_IN
      let _ = poll_fds(pfds2, pevs2, prevs2, 50)
    }
  }
  debug_assert(rx2 == exp2, "peer received pm + sk + 6 MiB intact")
  let mut hi = 0
  while hi < pm.length() {
    debug_assert(head_got[hi] == pm[hi], "pm byte mismatch")
    hi = hi + 1
  }
  let mut ki = 0
  while ki < sk.length() {
    debug_assert(head_got[pm.length() + ki] == sk[ki], "sk byte mismatch")
    ki = ki + 1
  }
  let fd2 = conn2.detach()
  close(fd2)
  close(acc2)

  let fd = conn.detach()
  close(fd)
  close(acc)
  close(srv)
}

test "nb IoWatcher shutdown before owner remove_and_close closes fd exactly once" {
  let srv = listen_on("127.0.0.1", 0)
  let port = port_of(srv)
  let cli = connect_timeout("127.0.0.1", port, 1000)
  debug_assert(cli >= 0 && poll([srv], 1000) >= 1, "connect")
  let acc = accept_now(srv)
  match IoWatcher::pair() {
    Option::Some((wh, wctx)) => {
      wh.mark_started()
      wh.arm(cli, true, false)
      wh.shutdown()
      wctx.run_loop(fn() -> Unit { () })
      // run_loop must NOT have closed live ConnIo-owned `cli` on clean shutdown
      debug_assert(fd_is_cloexec(cli), "live fd must still be open after watcher shutdown")
      // Now owner detaches and calls remove_and_close: closes `cli` exactly once
      wh.remove_and_close(cli)
    }
    Option::None => debug_assert(false, "IoWatcher::pair failed")
  }
  close(acc)
  close(srv)
}
