///| TCP sockets and process/file helpers for Farview host.
///| 1:1 port of `src/net/net.mbt` linking `src/net/net.c` natively via `[link]`.

pub extern "C" fn listen(port : Int) -> Int = "fv_listen"

pub extern "C" fn accept(socket : Int) -> Int = "fv_accept"

pub extern "C" fn parent_gone() -> Bool = "fv_parent_gone"

pub extern "C" fn accept_now(socket : Int) -> Int = "fv_accept_now"

extern "C" fn c_connect(host : Ptr, port : Int) -> Int = "fv_connect"

extern "C" fn c_send(socket : Int, b : Ptr, n : Int) -> Int = "fv_send"

extern "C" fn c_recv(socket : Int, b : Ptr, n : Int, wait_ms : Int) -> Int = "fv_recv"

pub fn connect(host : String, port : Int) -> Int {
  c_connect(str_data_ptr(host), port)
}

pub fn send(socket : Int, b : Bytes) -> Int {
  c_send(socket, bytes_data_ptr(b), b.length())
}

///| What is there to read, waiting up to wait_ms; None: closed.
pub fn recv(socket : Int, wait_ms : Int) -> Option[Bytes] {
  let buf = Bytes::new(1048576)
  let n = c_recv(socket, bytes_data_ptr(buf), 1048576, wait_ms)
  if n < 0 {
    Option::None
  } else {
    Option::Some(buf.slice(0, n))
  }
}

///| Non-blocking / small-chunk read (64 KiB scratch instead of 1 MiB) for host event-loop polling.
pub fn recv_small(socket : Int, wait_ms : Int) -> Option[Bytes] {
  let buf = Bytes::new(65536)
  let n = c_recv(socket, bytes_data_ptr(buf), 65536, wait_ms)
  if n < 0 {
    Option::None
  } else if n == 0 {
    Option::Some(Bytes::new(0))
  } else {
    Option::Some(buf.slice(0, n))
  }
}

pub extern "C" fn fork() -> Int = "fv_fork"

extern "C" fn c_spawn_self_serve(
  sock : Int,
  close_fd : Int,
  port : Int,
  agent_port : Int,
  url : Ptr,
  url_len : Int,
) -> Int = "fv_spawn_self_serve"

fn keep_bytes_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

pub fn spawn_self_serve(
  sock : Int,
  close_fd : Int,
  port : Int,
  agent_port : Int,
  url : String,
) -> Int {
  let b = url.to_bytes()
  let pid = c_spawn_self_serve(sock, close_fd, port, agent_port, bytes_data_ptr(b), b.length())
  keep_bytes_alive(b)
  pid
}

pub extern "C" fn wait(pid : Int) -> Int = "fv_wait"

pub extern "C" fn close(socket : Int) -> Unit = "fv_close"

pub extern "C" fn exit(code : Int) -> Unit = "fv_exit"

extern "C" fn c_append(path : Ptr, text : Ptr, n : Int) -> Unit = "fv_append"

pub fn append_file(path : String, text : String) -> Unit {
  let b = text.to_bytes()
  c_append(str_data_ptr(path), bytes_data_ptr(b), b.length())
}

extern "C" fn c_write(path : Ptr, text : Ptr, n : Int) -> Unit = "fv_write_file"

pub fn write_file(path : String, text : String) -> Unit {
  let b = text.to_bytes()
  c_write(str_data_ptr(path), bytes_data_ptr(b), b.length())
}

extern "C" fn c_listen_on(addr : Ptr, port : Int) -> Int = "fv_listen_on"

pub fn listen_on(addr : String, port : Int) -> Int {
  c_listen_on(str_data_ptr(addr), port)
}

pub extern "C" fn port_of(socket : Int) -> Int = "fv_port_of"

extern "C" fn c_poll(fds : Ptr, n : Int, wait_ms : Int) -> Int = "pion_fv_poll"

pub fn poll(socks : Array[Int], wait_ms : Int) -> Int {
  c_poll(array_data_ptr(socks), socks.length(), wait_ms)
}

pub extern "C" fn catch_term() -> Unit = "fv_catch_term"

pub extern "C" fn term_asked() -> Bool = "fv_term_asked"

pub extern "C" fn getpid() -> Int = "fv_getpid"

extern "C" fn c_setenv(k : Ptr, v : Ptr) -> Unit = "fv_setenv"

pub fn setenv(k : String, v : String) -> Unit {
  c_setenv(str_data_ptr(k), str_data_ptr(v))
}

extern "C" fn c_write_atomic(path : Ptr, data : Ptr, n : Int) -> Unit = "fv_write_file_atomic"

pub fn write_bytes_atomic(path : String, data : Bytes) -> Unit {
  c_write_atomic(str_data_ptr(path), bytes_data_ptr(data), data.length())
}

pub fn write_file_atomic(path : String, text : String) -> Unit {
  write_bytes_atomic(path, text.to_bytes())
}

extern "C" fn c_write_private(path : Ptr, data : Ptr, n : Int) -> Int = "fv_write_file_private"
extern "C" fn c_file_mode(path : Ptr) -> Int = "fv_file_mode"
extern "C" fn c_random_bytes(out : Ptr, n : Int) -> Int = "fv_random_bytes"
extern "C" fn c_file_mtime(path : Ptr) -> Int64 = "fv_file_mtime"

///| A file's modification time in seconds since 1970, -1 when it cannot be read.
pub fn file_mtime(path : String) -> Int64 {
  c_file_mtime(str_data_ptr(path))
}

///| Writes a secret file atomically, created owner-only (0600) before any byte is written; false on failure.
pub fn write_bytes_private(path : String, data : Bytes) -> Bool {
  c_write_private(str_data_ptr(path), bytes_data_ptr(data), data.length()) == 0
}

///| A file's permission bits (`st_mode & 0o777`), -1 when it cannot be read.
pub fn file_mode(path : String) -> Int {
  c_file_mode(str_data_ptr(path))
}

///| `n` bytes from the operating system's CSPRNG (`arc4random_buf`, `getrandom`, `BCryptGenRandom`); empty when the
///| system gave none.
pub fn random_bytes(n : Int) -> Bytes {
  let out = Bytes::new(if n > 0 { n } else { 0 })
  if n <= 0 {
    return out
  }
  if c_random_bytes(bytes_data_ptr(out), n) != n {
    return Bytes::new(0)
  }
  out
}

extern "C" fn c_mkdir(path : Ptr) -> Unit = "fv_mkdir"

pub fn mkdir(path : String) -> Unit {
  c_mkdir(str_data_ptr(path))
}

// --- Non-blocking socket, self-wake pipe, and multi-fd poll APIs ---

pub let POLL_IN : Int = 1
pub let POLL_OUT : Int = 2
pub let POLL_ERR : Int = 4
pub let POLL_HUP : Int = 8
pub let POLL_NVAL : Int = 16

pub enum NbIo {
  Bytes(Int)
  WouldBlock
  Intr
  Eof
  Err
}

extern "C" fn c_set_nonblock(fd : Int, nonblock : Int) -> Int = "fv_set_nonblock"
extern "C" fn c_fd_is_cloexec(fd : Int) -> Int = "fv_fd_is_cloexec"
extern "C" fn c_set_sndbuf(fd : Int, size : Int) -> Int = "fv_set_sndbuf"
extern "C" fn c_set_rcvbuf(fd : Int, size : Int) -> Int = "fv_set_rcvbuf"
extern "C" fn c_send_nb(fd : Int, b : Ptr, off : Int, len : Int) -> Int = "fv_send_nb"
extern "C" fn c_recv_nb(fd : Int, b : Ptr, off : Int, cap : Int) -> Int = "fv_recv_nb"
extern "C" fn c_pipe_open(out : Ptr) -> Int = "pion_fv_pipe_open"
extern "C" fn c_pipe_wake(write_fd : Int) -> Int = "fv_pipe_wake"
extern "C" fn c_pipe_drain(read_fd : Int) -> Int = "fv_pipe_drain"
extern "C" fn c_poll_fds(fds : Ptr, events : Ptr, revents : Ptr, n : Int, wait_ms : Int) -> Int = "pion_fv_poll_fds"
extern "C" fn c_connect_timeout(host : Ptr, port : Int, timeout_ms : Int) -> Int = "fv_connect_timeout"

pub fn set_nonblock(fd : Int, nonblock : Bool) -> Bool {
  c_set_nonblock(fd, if nonblock { 1 } else { 0 }) == 0
}

pub fn fd_is_cloexec(fd : Int) -> Bool {
  c_fd_is_cloexec(fd) == 1
}

pub fn set_sndbuf(fd : Int, size : Int) -> Bool {
  c_set_sndbuf(fd, size) == 0
}

pub fn set_rcvbuf(fd : Int, size : Int) -> Bool {
  c_set_rcvbuf(fd, size) == 0
}

pub fn send_nb(fd : Int, buf : Bytes, off : Int, len : Int) -> NbIo {
  let blen = buf.length()
  if off < 0 || len < 0 || off > blen || len > blen - off {
    return NbIo::Err
  }
  if len == 0 {
    return NbIo::Bytes(0)
  }
  let r = c_send_nb(fd, bytes_data_ptr(buf), off, len)
  keep_bytes_alive(buf)
  if r > 0 {
    NbIo::Bytes(r)
  } else if r == -2 {
    NbIo::WouldBlock
  } else if r == -3 {
    NbIo::Intr
  } else {
    NbIo::Err
  }
}

pub fn recv_nb(fd : Int, buf : Bytes, off : Int, cap : Int) -> NbIo {
  let blen = buf.length()
  if off < 0 || cap <= 0 || off > blen || cap > blen - off {
    return NbIo::Err
  }
  let r = c_recv_nb(fd, bytes_data_ptr(buf), off, cap)
  keep_bytes_alive(buf)
  if r > 0 {
    NbIo::Bytes(r)
  } else if r == 0 {
    NbIo::Eof
  } else if r == -2 {
    NbIo::WouldBlock
  } else if r == -3 {
    NbIo::Intr
  } else {
    NbIo::Err
  }
}

pub fn pipe_open() -> Option[(Int, Int)] {
  let out : Array[Int] = [-1, -1]
  let rc = c_pipe_open(array_data_ptr(out))
  if rc == 0 && out[0] >= 0 && out[1] >= 0 {
    Option::Some((out[0], out[1]))
  } else {
    Option::None
  }
}

pub fn pipe_wake(write_fd : Int) -> Bool {
  c_pipe_wake(write_fd) == 0
}

pub fn pipe_drain(read_fd : Int) -> Int {
  c_pipe_drain(read_fd)
}

pub fn poll_fds(fds : Array[Int], events : Array[Int], revents : Array[Int], wait_ms : Int) -> Int {
  let n = fds.length()
  if n == 0 || events.length() < n || revents.length() < n {
    return 0
  }
  c_poll_fds(array_data_ptr(fds), array_data_ptr(events), array_data_ptr(revents), n, wait_ms)
}

pub fn connect_timeout(host : String, port : Int, timeout_ms : Int) -> Int {
  c_connect_timeout(str_data_ptr(host), port, timeout_ms)
}
