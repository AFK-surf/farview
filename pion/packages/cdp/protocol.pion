///| Pure-Pion Chrome DevTools Protocol (CDP) JSON-RPC router and domain engine.
///| Supports Browser, Target, Runtime, DOM, Page, Network, and Accessibility domains.

import "a11y"

pub struct CdpHooks {
  pub eval_js : (String, Bool) -> (Bool, String, String)
  pub get_document : () -> String
  pub query_selector : (Int, String) -> Int
  pub query_selector_all : (Int, String) -> Array[Int]
  pub get_outer_html : (Int) -> String
  pub set_attribute_value : (Int, String, String) -> Bool
  pub navigate : (String) -> String
  pub reload : () -> Bool
  pub get_frame_tree : () -> (String, String, String)
  pub capture_screenshot : () -> String
}

pub struct CdpSession {
  pub mut runtime_enabled : Bool
  pub mut dom_enabled : Bool
  pub mut page_enabled : Bool
  pub mut network_enabled : Bool
  pub mut accessibility_enabled : Bool
  pub mut a11y_root : Option[a11y::AxNode]
  pub mut a11y_provider : Option[() -> a11y::AxNode]
  pub extra_headers : Map[String, String]
  pub network_events : Array[String]
}

pub fn CdpSession::new() -> CdpSession {
  CdpSession::{
    runtime_enabled: false,
    dom_enabled: false,
    page_enabled: false,
    network_enabled: false,
    accessibility_enabled: false,
    a11y_root: None,
    a11y_provider: None,
    extra_headers: Map::new(),
    network_events: [],
  }
}

pub fn CdpSession::set_a11y_tree(self : CdpSession, root : a11y::AxNode) -> Unit {
  self.a11y_root = Some(root)
}

pub fn CdpSession::set_a11y_provider(self : CdpSession, provider : () -> a11y::AxNode) -> Unit {
  self.a11y_provider = Some(provider)
}

pub fn CdpSession::record_network_event(self : CdpSession, method : String, url : String, status : Int) -> Unit {
  if !self.network_enabled {
    return
  }
  let ev = "{\"method\":\"Network.responseReceived\",\"params\":{\"request\":{\"method\":" +
  json_escape(method) + ",\"url\":" + json_escape(url) +
  "},\"response\":{\"url\":" + json_escape(url) + ",\"status\":" + status.to_string() + "}}}"
  self.network_events.push(ev)
}

fn cdp_ok(id : Int, result_json : String) -> String {
  "{\"id\":" + id.to_string() + ",\"result\":" + result_json + "}"
}

fn cdp_err(id : Int, code : Int, msg : String) -> String {
  "{\"id\":" + id.to_string() + ",\"error\":{\"code\":" + code.to_string() +
  ",\"message\":" + json_escape(msg) + "}}"
}

pub fn CdpSession::dispatch(self : CdpSession, raw : String, hooks : CdpHooks) -> String {
  let root = match json_parse(raw) {
    Some(v) => v
    None => return cdp_err(0, -32700, "Parse error: invalid JSON")
  }
  let id = json_int(root, "id", 0)
  let method = json_str(root, "method")
  if method == "" {
    return cdp_err(id, -32600, "Invalid Request: missing method")
  }
  let params = match json_get(root, "params") {
    Some(p) => p
    None => JObj(Map::new())
  }

  match method {
    "Browser.getVersion" => {
      cdp_ok(
        id,
        "{\"protocolVersion\":\"1.3\",\"product\":\"Farview/1.0 (Chrome/131.0.0.0)\",\"revision\":\"@farview\",\"userAgent\":\"Mozilla/5.0 Farview/1.0\",\"jsVersion\":\"13.1\"}",
      )
    }
    "Target.getTargets" => {
      let (fid, url, title) = (hooks.get_frame_tree)()
      let tid = if fid == "" { "page-1" } else { fid }
      cdp_ok(
        id,
        "{\"targetInfos\":[{\"targetId\":" + json_escape(tid) +
        ",\"type\":\"page\",\"title\":" + json_escape(title) +
        ",\"url\":" + json_escape(url) + ",\"attached\":true}]}",
      )
    }
    "Runtime.enable" => {
      self.runtime_enabled = true
      cdp_ok(id, "{}")
    }
    "Runtime.evaluate" => {
      let expr = json_str(params, "expression")
      let by_val = json_bool(params, "returnByValue", true)
      let (is_err, typ, rval) = (hooks.eval_js)(expr, by_val)
      if is_err {
        cdp_ok(
          id,
          "{\"result\":{\"type\":\"object\",\"subtype\":\"error\",\"description\":" +
          json_escape(rval) + "},\"exceptionDetails\":{\"exceptionId\":1,\"text\":" +
          json_escape(rval) + "}}",
        )
      } else {
        let val_json = if typ == "number" || typ == "boolean" || typ == "null" {
          rval
        } else if typ == "undefined" {
          ""
        } else if typ == "object" {
          if rval.starts_with("{") || rval.starts_with("[") {
            rval
          } else {
            json_escape(rval)
          }
        } else {
          json_escape(rval)
        }
        if typ == "undefined" {
          cdp_ok(id, "{\"result\":{\"type\":\"undefined\"}}")
        } else {
          cdp_ok(
            id,
            "{\"result\":{\"type\":" + json_escape(typ) + ",\"value\":" + val_json + "}}",
          )
        }
      }
    }
    "DOM.enable" => {
      self.dom_enabled = true
      cdp_ok(id, "{}")
    }
    "DOM.getDocument" => {
      let root_json = (hooks.get_document)()
      cdp_ok(id, "{\"root\":" + root_json + "}")
    }
    "DOM.querySelector" => {
      let nid = json_int(params, "nodeId", 1)
      let sel = json_str(params, "selector")
      let found = (hooks.query_selector)(nid, sel)
      cdp_ok(id, "{\"nodeId\":" + found.to_string() + "}")
    }
    "DOM.querySelectorAll" => {
      let nid = json_int(params, "nodeId", 1)
      let sel = json_str(params, "selector")
      let ids = (hooks.query_selector_all)(nid, sel)
      let sb = StringBuilder::new()
      sb.write_string("{\"nodeIds\":[")
      let mut i = 0
      while i < ids.length() {
        if i > 0 {
          sb.write_string(",")
        }
        sb.write_string(ids[i].to_string())
        i = i + 1
      }
      sb.write_string("]}")
      cdp_ok(id, sb.to_string())
    }
    "DOM.getOuterHTML" => {
      let nid = json_int(params, "nodeId", 1)
      let html = (hooks.get_outer_html)(nid)
      cdp_ok(id, "{\"outerHTML\":" + json_escape(html) + "}")
    }
    "DOM.setAttributeValue" => {
      let nid = json_int(params, "nodeId", 0)
      let name = json_str(params, "name")
      let value = json_str(params, "value")
      if nid <= 0 || name == "" {
        cdp_err(id, -32602, "Invalid params: nodeId and name required")
      } else if (hooks.set_attribute_value)(nid, name, value) {
        cdp_ok(id, "{}")
      } else {
        cdp_err(id, -32000, "Could not find node with given id")
      }
    }
    "Page.enable" => {
      self.page_enabled = true
      cdp_ok(id, "{}")
    }
    "Page.navigate" => {
      let url = json_str(params, "url")
      if url == "" {
        cdp_err(id, -32602, "Invalid params: url required")
      } else {
        let fid = (hooks.navigate)(url)
        cdp_ok(id, "{\"frameId\":" + json_escape(fid) + "}")
      }
    }
    "Page.reload" => {
      let _ = (hooks.reload)()
      cdp_ok(id, "{}")
    }
    "Page.getFrameTree" => {
      let (fid, url, title) = (hooks.get_frame_tree)()
      cdp_ok(
        id,
        "{\"frameTree\":{\"frame\":{\"id\":" + json_escape(fid) +
        ",\"url\":" + json_escape(url) +
        ",\"name\":" + json_escape(title) +
        ",\"mimeType\":\"text/html\"},\"childFrames\":[]}}",
      )
    }
    "Page.captureScreenshot" => {
      let b64 = (hooks.capture_screenshot)()
      cdp_ok(id, "{\"data\":" + json_escape(b64) + "}")
    }
    "Network.enable" => {
      self.network_enabled = true
      cdp_ok(id, "{}")
    }
    "Network.disable" => {
      self.network_enabled = false
      cdp_ok(id, "{}")
    }
    "Network.setExtraHTTPHeaders" => {
      match json_get(params, "headers") {
        Some(JObj(m)) => {
          self.extra_headers.clear()
          for k in m.keys() {
            match m.get(k) {
              Some(JStr(v)) => self.extra_headers.set(k, v)
              _ => ()
            }
          }
          cdp_ok(id, "{}")
        }
        _ => cdp_err(id, -32602, "Invalid params: headers object required")
      }
    }
    "Accessibility.enable" => {
      self.accessibility_enabled = true
      cdp_ok(id, "{}")
    }
    "Accessibility.disable" => {
      self.accessibility_enabled = false
      cdp_ok(id, "{}")
    }
    "Accessibility.getFullAXTree" => {
      let depth = json_int(params, "depth", -1)
      let tree_opt = match self.a11y_provider {
        Some(f) => Some(f())
        None => self.a11y_root
      }
      match tree_opt {
        Some(root) => cdp_ok(id, cdp_get_full_ax_tree(root, depth))
        None => cdp_ok(id, "{\"nodes\":[]}")
      }
    }
    "Accessibility.queryAXTree" => {
      let bid = json_int(params, "backendNodeId", json_int(params, "nodeId", 0))
      let acc_name = json_str(params, "accessibleName")
      let role = json_str(params, "role")
      let tree_opt = match self.a11y_provider {
        Some(f) => Some(f())
        None => self.a11y_root
      }
      match tree_opt {
        Some(root) => cdp_ok(id, cdp_query_ax_tree(root, bid, acc_name, role))
        None => cdp_ok(id, "{\"nodes\":[]}")
      }
    }
    _ => cdp_err(id, -32601, "Method not found: " + method)
  }
}

pub struct CdpServer {
  pub handle : Int
  pub session : CdpSession
}

pub fn CdpServer::listen(port : Int) -> Option[CdpServer] {
  let h = cdp_listen(port)
  if h <= 0 {
    None
  } else {
    Some(CdpServer::{ handle: h, session: CdpSession::new() })
  }
}

pub fn CdpServer::port(self : CdpServer) -> Int {
  cdp_port(self.handle)
}

pub fn CdpServer::set_target_meta(self : CdpServer, title : String, url : String) -> Unit {
  let _ = cdp_set_target_meta(self.handle, title, url)
}

pub fn CdpServer::set_a11y_tree(self : CdpServer, root : a11y::AxNode) -> Unit {
  self.session.set_a11y_tree(root)
}

pub fn CdpServer::set_a11y_provider(self : CdpServer, provider : () -> a11y::AxNode) -> Unit {
  self.session.set_a11y_provider(provider)
}

pub fn CdpServer::poll_and_dispatch(self : CdpServer, hooks : CdpHooks) -> Int {
  let mut handled = 0
  let mut spins = 0
  while spins < 16 {
    match cdp_poll(self.handle) {
      Some((cid, req_json)) => {
        let resp = self.session.dispatch(req_json, hooks)
        let _ = cdp_send(self.handle, cid, resp)
        handled = handled + 1
      }
      None => break
    }
    spins = spins + 1
  }
  handled
}

pub fn CdpServer::close(self : CdpServer) -> Unit {
  cdp_close(self.handle)
}
