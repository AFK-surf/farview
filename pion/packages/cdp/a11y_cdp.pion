///| Chrome DevTools Protocol (CDP) `Accessibility` domain serializer and query engine.
///| Consumes `pion/packages/a11y` directly and formats standard CDP `AXNode` JSON objects.

import "a11y"

fn ax_ascii_lower(s : String) -> String {
  let b = s.to_bytes()
  let n = b.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = b[i]
    }
    i = i + 1
  }
  out.to_string()
}

fn ax_node_id(n : a11y::AxNode, fallback_idx : Int) -> String {
  if n.uid > 0 {
    n.uid.to_string()
  } else {
    "ax-" + fallback_idx.to_string()
  }
}

fn checked_state_str(c : a11y::CheckedState) -> String {
  match c {
    a11y::CheckedState::True => "true"
    a11y::CheckedState::False => "false"
    a11y::CheckedState::Mixed => "mixed"
  }
}

fn write_ax_prop_bool(sb : StringBuilder, first : Bool, name : String, v : Bool) -> Bool {
  if !first {
    sb.write_string(",")
  }
  sb.write_string("{\"name\":")
  sb.write_string(json_escape(name))
  sb.write_string(",\"value\":{\"type\":\"boolean\",\"value\":")
  sb.write_string(if v { "true" } else { "false" })
  sb.write_string("}}")
  false
}

fn write_ax_prop_str(sb : StringBuilder, first : Bool, name : String, typ : String, v : String) -> Bool {
  if !first {
    sb.write_string(",")
  }
  sb.write_string("{\"name\":")
  sb.write_string(json_escape(name))
  sb.write_string(",\"value\":{\"type\":")
  sb.write_string(json_escape(typ))
  sb.write_string(",\"value\":")
  sb.write_string(json_escape(v))
  sb.write_string("}}")
  false
}

fn write_ax_prop_int(sb : StringBuilder, first : Bool, name : String, v : Int) -> Bool {
  if !first {
    sb.write_string(",")
  }
  sb.write_string("{\"name\":")
  sb.write_string(json_escape(name))
  sb.write_string(",\"value\":{\"type\":\"integer\",\"value\":")
  sb.write_string(v.to_string())
  sb.write_string("}}")
  false
}

fn write_ax_prop_num(sb : StringBuilder, first : Bool, name : String, v : Double) -> Bool {
  if !first {
    sb.write_string(",")
  }
  sb.write_string("{\"name\":")
  sb.write_string(json_escape(name))
  sb.write_string(",\"value\":{\"type\":\"number\",\"value\":")
  sb.write_string(v.to_string())
  sb.write_string("}}")
  false
}

fn write_cdp_ax_node(
  sb : StringBuilder,
  n : a11y::AxNode,
  node_id : String,
  parent_id : String,
  child_ids : Array[String],
) -> Unit {
  sb.write_string("{\"nodeId\":")
  sb.write_string(json_escape(node_id))
  sb.write_string(",\"ignored\":")
  sb.write_string(if n.hidden { "true" } else { "false" })
  sb.write_string(",\"role\":{\"type\":\"role\",\"value\":")
  sb.write_string(json_escape(n.role))
  sb.write_string("},\"name\":{\"type\":\"computedString\",\"value\":")
  sb.write_string(json_escape(n.name))
  sb.write_string("}")
  if n.description.length() > 0 {
    sb.write_string(",\"description\":{\"type\":\"computedString\",\"value\":")
    sb.write_string(json_escape(n.description))
    sb.write_string("}")
  }
  if n.value.length() > 0 {
    sb.write_string(",\"value\":{\"type\":\"string\",\"value\":")
    sb.write_string(json_escape(n.value))
    sb.write_string("}")
  }
  sb.write_string(",\"properties\":[")
  let mut pfirst = true
  if n.disabled {
    pfirst = write_ax_prop_bool(sb, pfirst, "disabled", true)
  }
  if n.focused {
    pfirst = write_ax_prop_bool(sb, pfirst, "focused", true)
  }
  if n.required {
    pfirst = write_ax_prop_bool(sb, pfirst, "required", true)
  }
  if n.readonly {
    pfirst = write_ax_prop_bool(sb, pfirst, "readonly", true)
  }
  if n.modal {
    pfirst = write_ax_prop_bool(sb, pfirst, "modal", true)
  }
  match n.checked {
    Some(c) => {
      pfirst = write_ax_prop_str(sb, pfirst, "checked", "tristate", checked_state_str(c))
    }
    None => ()
  }
  match n.selected {
    Some(v) => {
      pfirst = write_ax_prop_bool(sb, pfirst, "selected", v)
    }
    None => ()
  }
  match n.expanded {
    Some(v) => {
      pfirst = write_ax_prop_bool(sb, pfirst, "expanded", v)
    }
    None => ()
  }
  match n.pressed {
    Some(p) => {
      pfirst = write_ax_prop_str(sb, pfirst, "pressed", "tristate", checked_state_str(p))
    }
    None => ()
  }
  if n.invalid.length() > 0 {
    pfirst = write_ax_prop_str(sb, pfirst, "invalid", "token", n.invalid)
  }
  if n.live.length() > 0 {
    pfirst = write_ax_prop_str(sb, pfirst, "live", "token", n.live)
  }
  if n.autocomplete.length() > 0 {
    pfirst = write_ax_prop_str(sb, pfirst, "autocomplete", "string", n.autocomplete)
  }
  if n.level > 0 {
    pfirst = write_ax_prop_int(sb, pfirst, "level", n.level)
  }
  match n.valuemin {
    Some(v) => {
      pfirst = write_ax_prop_num(sb, pfirst, "valuemin", v)
    }
    None => ()
  }
  match n.valuemax {
    Some(v) => {
      let _ = write_ax_prop_num(sb, pfirst, "valuemax", v)
    }
    None => ()
  }
  sb.write_string("]")
  if parent_id.length() > 0 {
    sb.write_string(",\"parentId\":")
    sb.write_string(json_escape(parent_id))
  }
  sb.write_string(",\"childIds\":[")
  let mut i = 0
  while i < child_ids.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_escape(child_ids[i]))
    i = i + 1
  }
  sb.write_string("]")
  if n.uid > 0 {
    sb.write_string(",\"backendDOMNodeId\":")
    sb.write_string(n.uid.to_string())
  }
  sb.write_string(",\"bounds\":{\"x\":")
  sb.write_string(n.bounds.x.to_string())
  sb.write_string(",\"y\":")
  sb.write_string(n.bounds.y.to_string())
  sb.write_string(",\"width\":")
  sb.write_string(n.bounds.w.to_string())
  sb.write_string(",\"height\":")
  sb.write_string(n.bounds.h.to_string())
  sb.write_string("}}")
}

fn flatten_ax_tree(
  n : a11y::AxNode,
  parent_id : String,
  cur_depth : Int,
  max_depth : Int,
  counter : Array[Int],
  out : Array[String],
) -> String {
  let idx = counter[0]
  counter[0] = idx + 1
  let my_id = ax_node_id(n, idx)

  // Pre-compute child IDs for this node
  let child_ids : Array[String] = []
  let include_children = max_depth <= 0 || cur_depth < max_depth
  let child_entries : Array[String] = []
  if include_children {
    let mut i = 0
    while i < n.children.length() {
      let cid = flatten_ax_tree(n.children[i], my_id, cur_depth + 1, max_depth, counter, child_entries)
      child_ids.push(cid)
      i = i + 1
    }
  }

  let sb = StringBuilder::new()
  write_cdp_ax_node(sb, n, my_id, parent_id, child_ids)
  out.push(sb.to_string())
  let mut j = 0
  while j < child_entries.length() {
    out.push(child_entries[j])
    j = j + 1
  }
  my_id
}

///| Serialize an `a11y::AxNode` tree into a CDP `Accessibility.getFullAXTree` result payload.
pub fn cdp_get_full_ax_tree(root : a11y::AxNode, max_depth : Int) -> String {
  let nodes : Array[String] = []
  let counter : Array[Int] = [0]
  let _ = flatten_ax_tree(root, "", 0, max_depth, counter, nodes)
  let sb = StringBuilder::new()
  sb.write_string("{\"nodes\":[")
  let mut i = 0
  while i < nodes.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(nodes[i])
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

fn collect_query_matches(
  n : a11y::AxNode,
  parent_id : String,
  want_name : String,
  want_role_lower : String,
  counter : Array[Int],
  out : Array[String],
) -> Unit {
  let idx = counter[0]
  counter[0] = idx + 1
  let my_id = ax_node_id(n, idx)

  let name_ok = want_name.length() == 0 || n.name == want_name
  let role_ok = want_role_lower.length() == 0 || ax_ascii_lower(n.role) == want_role_lower
  if name_ok && role_ok {
    let child_ids : Array[String] = []
    let mut ci = 0
    while ci < n.children.length() {
      let ch = n.children[ci]
      child_ids.push(if ch.uid > 0 { ch.uid.to_string() } else { "ax-" + (idx + ci + 1).to_string() })
      ci = ci + 1
    }
    let sb = StringBuilder::new()
    write_cdp_ax_node(sb, n, my_id, parent_id, child_ids)
    out.push(sb.to_string())
  }

  let mut i = 0
  while i < n.children.length() {
    collect_query_matches(n.children[i], my_id, want_name, want_role_lower, counter, out)
    i = i + 1
  }
}

///| Query an `a11y::AxNode` tree for CDP `Accessibility.queryAXTree` filtering by
///| optional `backend_node_id` (subtree root), `accessible_name`, and `role`.
pub fn cdp_query_ax_tree(
  root : a11y::AxNode,
  backend_node_id : Int,
  accessible_name : String,
  role : String,
) -> String {
  let start_node = if backend_node_id > 0 {
    match a11y::find_by_uid(root, backend_node_id) {
      Some(sub) => sub
      None => return "{\"nodes\":[]}"
    }
  } else {
    root
  }
  let matches : Array[String] = []
  let counter : Array[Int] = [0]
  collect_query_matches(start_node, "", accessible_name, ax_ascii_lower(role), counter, matches)
  let sb = StringBuilder::new()
  sb.write_string("{\"nodes\":[")
  let mut i = 0
  while i < matches.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(matches[i])
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}
