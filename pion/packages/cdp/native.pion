///| Native C FFI wrappers for loopback TCP/HTTP + RFC 6455 WebSocket CDP server.

pub extern "C" fn cdp_listen(port : Int) -> Int = "pion_cdp_listen"
pub extern "C" fn cdp_port(handle : Int) -> Int = "pion_cdp_port"
extern "C" fn c_cdp_set_target_meta(handle : Int, title : Ptr, title_len : Int, url : Ptr, url_len : Int) -> Int = "pion_cdp_set_target_meta"
extern "C" fn c_cdp_poll(handle : Int, out_buf : Ptr, cap : Int, out_client : Ptr) -> Int = "pion_cdp_poll"
extern "C" fn c_cdp_send(handle : Int, client_id : Int, json : Ptr, len : Int) -> Int = "pion_cdp_send"
pub extern "C" fn cdp_close(handle : Int) -> Unit = "pion_cdp_close"
pub extern "C" fn cdp_active_count() -> Int = "pion_cdp_active_count"
extern "C" fn c_cdp_ws_accept_key(key : Ptr, key_len : Int, out_buf : Ptr, cap : Int) -> Int = "pion_cdp_ws_accept_key"

pub extern "C" fn client_connect(port : Int) -> Int = "pion_cdp_client_connect"
extern "C" fn c_client_send_raw(fd : Int, data : Ptr, len : Int) -> Int = "pion_cdp_client_send_raw"
extern "C" fn c_client_recv_raw(fd : Int, out_buf : Ptr, cap : Int, timeout_ms : Int) -> Int = "pion_cdp_client_recv_raw"
pub extern "C" fn client_close(fd : Int) -> Unit = "pion_cdp_client_close"

fn non_empty_bytes(b : Bytes) -> Bytes {
  if b.length() == 0 {
    Bytes::new(1)
  } else {
    b
  }
}

fn copy_prefix(src : Bytes, n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = src[i]
    i = i + 1
  }
  out
}

fn read_i32_le(b : Bytes, off : Int) -> Int {
  let b0 = b[off].to_int() & 0xFF
  let b1 = b[off + 1].to_int() & 0xFF
  let b2 = b[off + 2].to_int() & 0xFF
  let b3 = b[off + 3].to_int() & 0xFF
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn keep_bytes_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

pub fn cdp_set_target_meta(handle : Int, title : String, url : String) -> Int {
  let tb = title.to_bytes()
  let ub = url.to_bytes()
  let ts = non_empty_bytes(tb)
  let us = non_empty_bytes(ub)
  let r = c_cdp_set_target_meta(handle, bytes_data_ptr(ts), tb.length(), bytes_data_ptr(us), ub.length())
  keep_bytes_alive(ts)
  keep_bytes_alive(us)
  r
}

pub fn cdp_poll(handle : Int) -> Option[(Int, String)] {
  let buf = Bytes::new(65536)
  let meta = Bytes::new(4)
  let n = c_cdp_poll(handle, bytes_data_ptr(buf), 65536, bytes_data_ptr(meta))
  if n <= 0 {
    keep_bytes_alive(buf)
    keep_bytes_alive(meta)
    return None
  }
  let cid = read_i32_le(meta, 0)
  Some((cid, copy_prefix(buf, n).to_string()))
}

pub fn cdp_send(handle : Int, client_id : Int, json : String) -> Int {
  let jb = json.to_bytes()
  let js = non_empty_bytes(jb)
  let r = c_cdp_send(handle, client_id, bytes_data_ptr(js), jb.length())
  keep_bytes_alive(js)
  r
}

pub fn ws_accept_key(key : String) -> String {
  let kb = key.to_bytes()
  let ks = non_empty_bytes(kb)
  let out = Bytes::new(64)
  let n = c_cdp_ws_accept_key(bytes_data_ptr(ks), kb.length(), bytes_data_ptr(out), 64)
  keep_bytes_alive(ks)
  if n <= 0 {
    keep_bytes_alive(out)
    ""
  } else {
    copy_prefix(out, n).to_string()
  }
}

pub fn client_send_raw(fd : Int, data : Bytes) -> Int {
  let ds = non_empty_bytes(data)
  let r = c_client_send_raw(fd, bytes_data_ptr(ds), data.length())
  keep_bytes_alive(ds)
  r
}

pub fn client_recv_raw(fd : Int, timeout_ms : Int) -> Bytes {
  let buf = Bytes::new(65536)
  let n = c_client_recv_raw(fd, bytes_data_ptr(buf), 65536, timeout_ms)
  if n <= 0 {
    Bytes::new(0)
  } else {
    copy_prefix(buf, n)
  }
}
