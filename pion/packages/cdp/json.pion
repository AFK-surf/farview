///| Lightweight pure-Pion JSON parser and serializer for CDP JSON-RPC messages.

pub enum JsonVal {
  JNull
  JBool(Bool)
  JInt(Int)
  JStr(String)
  JArr(Array[JsonVal])
  JObj(Map[String, JsonVal])
}

pub fn json_escape(s : String) -> String {
  let out = StringBuilder::new()
  out.write_string("\"")
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 34 {
      out.write_string("\\\"")
    } else if c == 92 {
      out.write_string("\\\\")
    } else if c == 10 {
      out.write_string("\\n")
    } else if c == 13 {
      out.write_string("\\r")
    } else if c == 9 {
      out.write_string("\\t")
    } else if c < 32 {
      out.write_string("\\u00")
      let hex = "0123456789abcdef"
      out.write_string(hex.slice((c >> 4) & 15, ((c >> 4) & 15) + 1))
      out.write_string(hex.slice(c & 15, (c & 15) + 1))
    } else {
      out.write_string(s.slice(i, i + 1))
    }
    i = i + 1
  }
  out.write_string("\"")
  out.to_string()
}

pub fn json_stringify(v : JsonVal) -> String {
  match v {
    JNull => "null"
    JBool(b) => if b { "true" } else { "false" }
    JInt(n) => n.to_string()
    JStr(s) => json_escape(s)
    JArr(items) => {
      let out = StringBuilder::new()
      out.write_string("[")
      let mut i = 0
      while i < items.length() {
        if i > 0 {
          out.write_string(",")
        }
        out.write_string(json_stringify(items[i]))
        i = i + 1
      }
      out.write_string("]")
      out.to_string()
    }
    JObj(m) => {
      let out = StringBuilder::new()
      out.write_string("{")
      let mut first = true
      for k in m.keys() {
        if !first {
          out.write_string(",")
        }
        first = false
        out.write_string(json_escape(k))
        out.write_string(":")
        match m.get(k) {
          Some(jv) => out.write_string(json_stringify(jv))
          None => out.write_string("null")
        }
      }
      out.write_string("}")
      out.to_string()
    }
  }
}

struct JsonParser {
  s : String
  n : Int
  mut pos : Int
}

fn JsonParser::skip_ws(self : JsonParser) -> Unit {
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn hex_digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else {
    -1
  }
}

fn JsonParser::parse_string(self : JsonParser) -> Option[String] {
  if self.pos >= self.n || self.s.code_unit_at(self.pos) != 34 {
    return None
  }
  self.pos = self.pos + 1
  let out = StringBuilder::new()
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 34 {
      self.pos = self.pos + 1
      return Some(out.to_string())
    }
    if c == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.n {
        return None
      }
      let esc = self.s.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if esc == 34 {
        out.write_string("\"")
      } else if esc == 92 {
        out.write_string("\\")
      } else if esc == 47 {
        out.write_string("/")
      } else if esc == 110 {
        out.write_string("\n")
      } else if esc == 114 {
        out.write_string("\r")
      } else if esc == 116 {
        out.write_string("\t")
      } else if esc == 98 {
        out.write_string("\u{08}")
      } else if esc == 102 {
        out.write_string("\u{0c}")
      } else if esc == 117 && self.pos + 4 <= self.n {
        let d0 = hex_digit(self.s.code_unit_at(self.pos))
        let d1 = hex_digit(self.s.code_unit_at(self.pos + 1))
        let d2 = hex_digit(self.s.code_unit_at(self.pos + 2))
        let d3 = hex_digit(self.s.code_unit_at(self.pos + 3))
        if d0 >= 0 && d1 >= 0 && d2 >= 0 && d3 >= 0 {
          let cp = (d0 << 12) | (d1 << 8) | (d2 << 4) | d3
          self.pos = self.pos + 4
          if cp < 128 {
            let b = Bytes::new(1)
            b[0] = cp.to_byte()
            out.write_string(b.to_string())
          } else if cp < 0x800 {
            let b = Bytes::new(2)
            b[0] = (0xC0 | (cp >> 6)).to_byte()
            b[1] = (0x80 | (cp & 0x3F)).to_byte()
            out.write_string(b.to_string())
          } else {
            let b = Bytes::new(3)
            b[0] = (0xE0 | (cp >> 12)).to_byte()
            b[1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
            b[2] = (0x80 | (cp & 0x3F)).to_byte()
            out.write_string(b.to_string())
          }
        } else {
          return None
        }
      } else {
        return None
      }
    } else {
      out.write_string(self.s.slice(self.pos, self.pos + 1))
      self.pos = self.pos + 1
    }
  }
  None
}

fn JsonParser::parse_value(self : JsonParser, depth : Int) -> Option[JsonVal] {
  if depth > 64 {
    return None
  }
  self.skip_ws()
  if self.pos >= self.n {
    return None
  }
  let c = self.s.code_unit_at(self.pos)
  if c == 34 {
    match self.parse_string() {
      Some(str) => Some(JStr(str))
      None => None
    }
  } else if c == 123 {
    self.pos = self.pos + 1
    let m : Map[String, JsonVal] = Map::new()
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
      self.pos = self.pos + 1
      return Some(JObj(m))
    }
    while self.pos < self.n {
      self.skip_ws()
      let key = match self.parse_string() {
        Some(k) => k
        None => return None
      }
      self.skip_ws()
      if self.pos >= self.n || self.s.code_unit_at(self.pos) != 58 {
        return None
      }
      self.pos = self.pos + 1
      let jv = match self.parse_value(depth + 1) {
        Some(v) => v
        None => return None
      }
      m.set(key, jv)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
        self.pos = self.pos + 1
        return Some(JObj(m))
      }
      return None
    }
    None
  } else if c == 91 {
    self.pos = self.pos + 1
    let arr : Array[JsonVal] = []
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
      self.pos = self.pos + 1
      return Some(JArr(arr))
    }
    while self.pos < self.n {
      let jv = match self.parse_value(depth + 1) {
        Some(v) => v
        None => return None
      }
      arr.push(jv)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
        self.pos = self.pos + 1
        return Some(JArr(arr))
      }
      return None
    }
    None
  } else if c == 116 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "true" {
    self.pos = self.pos + 4
    Some(JBool(true))
  } else if c == 102 && self.pos + 5 <= self.n && self.s.slice(self.pos, self.pos + 5) == "false" {
    self.pos = self.pos + 5
    Some(JBool(false))
  } else if c == 110 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "null" {
    self.pos = self.pos + 4
    Some(JNull)
  } else if c == 45 || (c >= 48 && c <= 57) {
    let mut neg = false
    if c == 45 {
      neg = true
      self.pos = self.pos + 1
    }
    let mut acc = 0
    let mut digits = 0
    while self.pos < self.n {
      let d = self.s.code_unit_at(self.pos)
      if d >= 48 && d <= 57 {
        acc = acc * 10 + (d - 48)
        digits = digits + 1
        self.pos = self.pos + 1
      } else {
        break
      }
    }
    if digits == 0 {
      return None
    }
    // Skip optional fractional/exponent part
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 46 {
      self.pos = self.pos + 1
      while self.pos < self.n {
        let d = self.s.code_unit_at(self.pos)
        if d >= 48 && d <= 57 {
          self.pos = self.pos + 1
        } else {
          break
        }
      }
    }
    if self.pos < self.n && (self.s.code_unit_at(self.pos) == 101 || self.s.code_unit_at(self.pos) == 69) {
      self.pos = self.pos + 1
      if self.pos < self.n && (self.s.code_unit_at(self.pos) == 43 || self.s.code_unit_at(self.pos) == 45) {
        self.pos = self.pos + 1
      }
      while self.pos < self.n {
        let d = self.s.code_unit_at(self.pos)
        if d >= 48 && d <= 57 {
          self.pos = self.pos + 1
        } else {
          break
        }
      }
    }
    Some(JInt(if neg { 0 - acc } else { acc }))
  } else {
    None
  }
}

pub fn json_parse(s : String) -> Option[JsonVal] {
  let p = JsonParser::{ s: s, n: s.length(), pos: 0 }
  p.parse_value(0)
}

pub fn json_get(v : JsonVal, key : String) -> Option[JsonVal] {
  match v {
    JObj(m) => m.get(key)
    _ => None
  }
}

pub fn json_str(v : JsonVal, key : String) -> String {
  match json_get(v, key) {
    Some(JStr(s)) => s
    _ => ""
  }
}

pub fn json_int(v : JsonVal, key : String, def : Int) -> Int {
  match json_get(v, key) {
    Some(JInt(n)) => n
    _ => def
  }
}

pub fn json_bool(v : JsonVal, key : String, def : Bool) -> Bool {
  match json_get(v, key) {
    Some(JBool(b)) => b
    _ => def
  }
}
