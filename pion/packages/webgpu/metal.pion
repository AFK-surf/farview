///| Farview WebGPU Apple Silicon Metal backend + pure-Pion PNG encoder.
///| Wires the pure-Pion WGSL->MSL compiler (`wgsl_to_msl`) to real Metal GPU execution.

// --- Texture Formats ---
pub let fmt_rgba8_unorm : Int = 0
pub let fmt_bgra8_unorm : Int = 1
pub let fmt_depth32_float : Int = 2

// --- Primitive Topologies ---
pub let prim_point_list : Int = 0
pub let prim_line_list : Int = 1
pub let prim_line_strip : Int = 2
pub let prim_triangle_list : Int = 3
pub let prim_triangle_strip : Int = 4

// --- Sampler Address Modes ---
pub let addr_clamp_to_edge : Int = 0
pub let addr_repeat : Int = 1
pub let addr_mirror_repeat : Int = 2

// --- Texture Usage Flags ---
pub let tex_usage_copy_src : Int = 1
pub let tex_usage_copy_dst : Int = 2
pub let tex_usage_texture_binding : Int = 4
pub let tex_usage_storage_binding : Int = 8
pub let tex_usage_render_attachment : Int = 16

// --- Buffer Usage Flags ---
pub let buf_usage_map_read : Int = 1
pub let buf_usage_map_write : Int = 2
pub let buf_usage_copy_src : Int = 4
pub let buf_usage_copy_dst : Int = 8
pub let buf_usage_uniform : Int = 64
pub let buf_usage_storage : Int = 128

// --- C FFI ---

extern "C" fn c_wgpu_available() -> Int = "pion_wgpu_available"
extern "C" fn c_wgpu_require_metal() -> Int = "pion_wgpu_require_metal"
extern "C" fn c_wgpu_log_skip() -> Unit = "pion_wgpu_log_skip"
extern "C" fn c_wgpu_create_device() -> Int = "pion_wgpu_create_device"
extern "C" fn c_wgpu_destroy_device(dev_id : Int) -> Unit = "pion_wgpu_destroy_device"
extern "C" fn c_wgpu_device_name(dev_id : Int, out_buf : Ptr, cap : Int) -> Int = "pion_wgpu_device_name"
extern "C" fn c_wgpu_device_max_buffer_length(dev_id : Int) -> Int64 = "pion_wgpu_device_max_buffer_length"
extern "C" fn c_wgpu_last_error(dev_id : Int, out_buf : Ptr, cap : Int) -> Int = "pion_wgpu_last_error"

extern "C" fn c_wgpu_create_buffer(dev_id : Int, size : Int, usage : Int) -> Int = "pion_wgpu_create_buffer"
extern "C" fn c_wgpu_destroy_buffer(dev_id : Int, buf_id : Int) -> Unit = "pion_wgpu_destroy_buffer"
extern "C" fn c_wgpu_buffer_write(dev_id : Int, buf_id : Int, offset : Int, data : Ptr, size : Int) -> Int = "pion_wgpu_buffer_write"
extern "C" fn c_wgpu_buffer_read(dev_id : Int, buf_id : Int, offset : Int, out_data : Ptr, size : Int) -> Int = "pion_wgpu_buffer_read"

extern "C" fn c_wgpu_create_texture_2d(dev_id : Int, w : Int, h : Int, fmt : Int, usage : Int) -> Int = "pion_wgpu_create_texture_2d"
extern "C" fn c_wgpu_destroy_texture(dev_id : Int, tex_id : Int) -> Unit = "pion_wgpu_destroy_texture"
extern "C" fn c_wgpu_texture_write_2d(dev_id : Int, tex_id : Int, w : Int, h : Int, rgba : Ptr, bpr : Int) -> Int = "pion_wgpu_texture_write_2d"
extern "C" fn c_wgpu_texture_read_rgba8(dev_id : Int, tex_id : Int, out_rgba : Ptr, out_cap : Int) -> Int = "pion_wgpu_texture_read_rgba8"

extern "C" fn c_wgpu_create_sampler(dev_id : Int, linear : Int, addr_mode : Int) -> Int = "pion_wgpu_create_sampler"
extern "C" fn c_wgpu_destroy_sampler(dev_id : Int, samp_id : Int) -> Unit = "pion_wgpu_destroy_sampler"

extern "C" fn c_wgpu_create_shader_module_msl(dev_id : Int, msl : Ptr, len : Int) -> Int = "pion_wgpu_create_shader_module_msl"
extern "C" fn c_wgpu_destroy_shader_module(dev_id : Int, mod_id : Int) -> Unit = "pion_wgpu_destroy_shader_module"

extern "C" fn c_wgpu_create_compute_pipeline(
  dev_id : Int,
  mod_id : Int,
  entry : Ptr,
  entry_len : Int,
  wgx : Int,
  wgy : Int,
  wgz : Int,
) -> Int = "pion_wgpu_create_compute_pipeline"
extern "C" fn c_wgpu_destroy_compute_pipeline(dev_id : Int, pipe_id : Int) -> Unit = "pion_wgpu_destroy_compute_pipeline"
extern "C" fn c_wgpu_dispatch_compute(
  dev_id : Int,
  pipe_id : Int,
  num_bufs : Int,
  buf_slots : Ptr,
  buf_ids : Ptr,
  num_texs : Int,
  tex_slots : Ptr,
  tex_ids : Ptr,
  num_samps : Int,
  samp_slots : Ptr,
  samp_ids : Ptr,
  gx : Int,
  gy : Int,
  gz : Int,
) -> Int = "pion_wgpu_dispatch_compute"

extern "C" fn c_wgpu_create_render_pipeline(
  dev_id : Int,
  vs_mod_id : Int,
  vs_ptr : Ptr,
  vs_len : Int,
  fs_mod_id : Int,
  fs_ptr : Ptr,
  fs_len : Int,
  color_fmt : Int,
  blend_enable : Int,
) -> Int = "pion_wgpu_create_render_pipeline"
extern "C" fn c_wgpu_destroy_render_pipeline(dev_id : Int, pipe_id : Int) -> Unit = "pion_wgpu_destroy_render_pipeline"
extern "C" fn c_wgpu_render_draw(
  dev_id : Int,
  pipe_id : Int,
  target_tex_id : Int,
  clear_enable : Int,
  cr : Double,
  cg : Double,
  cb : Double,
  ca : Double,
  num_bufs : Int,
  buf_slots : Ptr,
  buf_ids : Ptr,
  num_texs : Int,
  tex_slots : Ptr,
  tex_ids : Ptr,
  num_samps : Int,
  samp_slots : Ptr,
  samp_ids : Ptr,
  prim : Int,
  vstart : Int,
  vcount : Int,
  instances : Int,
) -> Int = "pion_wgpu_render_draw"

extern "C" fn c_wgpu_write_f32(buf : Ptr, byte_off : Int, v : Double) -> Unit = "pion_wgpu_write_f32"
extern "C" fn c_wgpu_read_f32(buf : Ptr, byte_off : Int) -> Double = "pion_wgpu_read_f32"
extern "C" fn c_wgpu_write_i32(buf : Ptr, byte_off : Int, v : Int) -> Unit = "pion_wgpu_write_i32"
extern "C" fn c_wgpu_write_file(path : Ptr, path_len : Int, data : Ptr, data_len : Int) -> Int = "pion_wgpu_write_file"

fn keep_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

fn bytes_to_string_len(b : Bytes, len : Int) -> String {
  if len <= 0 {
    return ""
  }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len && i < b.length() {
    sb.write_byte(b[i])
    i = i + 1
  }
  sb.to_string()
}

///| Pack an array of `Double` into little-endian IEEE 754 `f32` bytes.
pub fn pack_f32s(vals : Array[Double]) -> Bytes {
  let n = vals.length()
  let out = Bytes::new(n * 4)
  let ptr = bytes_data_ptr(out)
  let mut i = 0
  while i < n {
    c_wgpu_write_f32(ptr, i * 4, vals[i])
    i = i + 1
  }
  keep_alive(out)
  out
}

///| Unpack little-endian IEEE 754 `f32` bytes into an array of `Double`.
pub fn unpack_f32s(data : Bytes) -> Array[Double] {
  let n = data.length() / 4
  let out : Array[Double] = []
  let ptr = bytes_data_ptr(data)
  let mut i = 0
  while i < n {
    out.push(c_wgpu_read_f32(ptr, i * 4))
    i = i + 1
  }
  keep_alive(data)
  out
}

fn pack_i32s(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let out = Bytes::new(if n > 0 { n * 4 } else { 4 })
  let ptr = bytes_data_ptr(out)
  let mut i = 0
  while i < n {
    c_wgpu_write_i32(ptr, i * 4, vals[i])
    i = i + 1
  }
  keep_alive(out)
  out
}

///| Write raw bytes to a file path on disk. Returns true on success.
pub fn write_file_bytes(path : String, data : Bytes) -> Bool {
  let pb = path.to_bytes()
  let r = c_wgpu_write_file(bytes_data_ptr(pb), pb.length(), bytes_data_ptr(data), data.length())
  keep_alive(pb)
  keep_alive(data)
  r == 0
}

// --- High-Level WebGPU Metal Handles ---

pub struct GpuDevice {
  pub id : Int
}

pub struct GpuBuffer {
  pub dev_id : Int
  pub id : Int
  pub size : Int
}

pub struct GpuTexture {
  pub dev_id : Int
  pub id : Int
  pub width : Int
  pub height : Int
  pub format : Int
}

pub struct GpuSampler {
  pub dev_id : Int
  pub id : Int
}

pub struct GpuShaderModule {
  pub dev_id : Int
  pub id : Int
  pub compiled : CompiledShader
}

pub struct GpuComputePipeline {
  pub dev_id : Int
  pub id : Int
  pub entry : String
  pub wg_x : Int
  pub wg_y : Int
  pub wg_z : Int
}

pub struct GpuRenderPipeline {
  pub dev_id : Int
  pub id : Int
  pub color_format : Int
}

pub enum GpuBindEntry {
  Buffer(Int, Int, GpuBuffer)
  Texture(Int, Int, GpuTexture)
  Sampler(Int, Int, GpuSampler)
}

///| Check whether a real Apple Silicon Metal GPU device is available.
pub fn wgpu_available() -> Bool {
  c_wgpu_available() != 0
}

///| Create a Metal WebGPU device handle.
pub fn GpuDevice::create() -> Result[GpuDevice, String] {
  let id = c_wgpu_create_device()
  if id <= 0 {
    return Err("failed to create Metal WebGPU device (code " + id.to_string() + ")")
  }
  Ok(GpuDevice::{ id: id })
}

pub fn GpuDevice::destroy(self : GpuDevice) -> Unit {
  c_wgpu_destroy_device(self.id)
}

pub fn GpuDevice::name(self : GpuDevice) -> String {
  let buf = Bytes::new(256)
  let n = c_wgpu_device_name(self.id, bytes_data_ptr(buf), 256)
  keep_alive(buf)
  bytes_to_string_len(buf, n)
}

pub fn GpuDevice::max_buffer_length(self : GpuDevice) -> Int64 {
  c_wgpu_device_max_buffer_length(self.id)
}

pub fn GpuDevice::last_error(self : GpuDevice) -> String {
  let buf = Bytes::new(1024)
  let n = c_wgpu_last_error(self.id, bytes_data_ptr(buf), 1024)
  keep_alive(buf)
  bytes_to_string_len(buf, n)
}

pub fn GpuDevice::create_buffer(
  self : GpuDevice,
  size : Int,
  usage : Int,
) -> Result[GpuBuffer, String] {
  let id = c_wgpu_create_buffer(self.id, size, usage)
  if id <= 0 {
    return Err("create_buffer failed: " + self.last_error())
  }
  Ok(GpuBuffer::{ dev_id: self.id, id: id, size: size })
}

pub fn GpuBuffer::destroy(self : GpuBuffer) -> Unit {
  c_wgpu_destroy_buffer(self.dev_id, self.id)
}

pub fn GpuBuffer::write_bytes(self : GpuBuffer, offset : Int, data : Bytes) -> Result[Unit, String] {
  let r = c_wgpu_buffer_write(self.dev_id, self.id, offset, bytes_data_ptr(data), data.length())
  keep_alive(data)
  if r != 0 {
    return Err("buffer write failed (code " + r.to_string() + ")")
  }
  Ok(())
}

pub fn GpuBuffer::write_f32s(self : GpuBuffer, offset : Int, vals : Array[Double]) -> Result[Unit, String] {
  self.write_bytes(offset, pack_f32s(vals))
}

pub fn GpuBuffer::read_bytes(self : GpuBuffer, offset : Int, size : Int) -> Result[Bytes, String] {
  let out = Bytes::new(size)
  let r = c_wgpu_buffer_read(self.dev_id, self.id, offset, bytes_data_ptr(out), size)
  keep_alive(out)
  if r != 0 {
    return Err("buffer read failed (code " + r.to_string() + ")")
  }
  Ok(out)
}

pub fn GpuBuffer::read_f32s(self : GpuBuffer, count : Int) -> Result[Array[Double], String] {
  match self.read_bytes(0, count * 4) {
    Ok(bs) => Ok(unpack_f32s(bs))
    Err(e) => Err(e)
  }
}

pub fn GpuDevice::create_texture_2d(
  self : GpuDevice,
  width : Int,
  height : Int,
  format : Int,
  usage : Int,
) -> Result[GpuTexture, String] {
  let id = c_wgpu_create_texture_2d(self.id, width, height, format, usage)
  if id <= 0 {
    return Err("create_texture_2d failed: " + self.last_error())
  }
  Ok(GpuTexture::{ dev_id: self.id, id: id, width: width, height: height, format: format })
}

pub fn GpuTexture::destroy(self : GpuTexture) -> Unit {
  c_wgpu_destroy_texture(self.dev_id, self.id)
}

pub fn GpuTexture::write_rgba8(self : GpuTexture, rgba : Bytes) -> Result[Unit, String] {
  let r = c_wgpu_texture_write_2d(
    self.dev_id,
    self.id,
    self.width,
    self.height,
    bytes_data_ptr(rgba),
    self.width * 4,
  )
  keep_alive(rgba)
  if r != 0 {
    return Err("texture write failed (code " + r.to_string() + ")")
  }
  Ok(())
}

pub fn GpuTexture::read_rgba8(self : GpuTexture) -> Result[Bytes, String] {
  let cap = self.width * self.height * 4
  let out = Bytes::new(cap)
  let n = c_wgpu_texture_read_rgba8(self.dev_id, self.id, bytes_data_ptr(out), cap)
  keep_alive(out)
  if n != cap {
    return Err("texture read_rgba8 failed (got " + n.to_string() + ", expected " + cap.to_string() + ")")
  }
  Ok(out)
}

pub fn GpuDevice::create_sampler(
  self : GpuDevice,
  linear_filter : Bool,
  address_mode : Int,
) -> Result[GpuSampler, String] {
  let id = c_wgpu_create_sampler(self.id, if linear_filter { 1 } else { 0 }, address_mode)
  if id <= 0 {
    return Err("create_sampler failed: " + self.last_error())
  }
  Ok(GpuSampler::{ dev_id: self.id, id: id })
}

pub fn GpuSampler::destroy(self : GpuSampler) -> Unit {
  c_wgpu_destroy_sampler(self.dev_id, self.id)
}

///| Compile WGSL source using pure-Pion `wgsl_to_msl` and build a native Metal shader library.
pub fn GpuDevice::create_shader_module_wgsl(
  self : GpuDevice,
  wgsl_src : String,
) -> Result[GpuShaderModule, String] {
  let compiled = match wgsl_to_msl(wgsl_src) {
    Ok(c) => c
    Err(e) => return Err("WGSL compile error: " + wgsl_error_message(e))
  }
  let msl_bytes = compiled.msl.to_bytes()
  let id = c_wgpu_create_shader_module_msl(self.id, bytes_data_ptr(msl_bytes), msl_bytes.length())
  keep_alive(msl_bytes)
  if id <= 0 {
    return Err("Metal shader compile failed: " + self.last_error())
  }
  Ok(GpuShaderModule::{ dev_id: self.id, id: id, compiled: compiled })
}

pub fn GpuShaderModule::destroy(self : GpuShaderModule) -> Unit {
  c_wgpu_destroy_shader_module(self.dev_id, self.id)
}

pub fn GpuDevice::create_compute_pipeline(
  self : GpuDevice,
  mod : GpuShaderModule,
  entry_name : String,
) -> Result[GpuComputePipeline, String] {
  let ep = match find_entry_point(mod.compiled, entry_name) {
    Ok(e) => e
    Err(err) => return Err(wgsl_error_message(err))
  }
  match ep.stage {
    EntryStage::Compute => ()
    _ => return Err("entry point '" + entry_name + "' is not a @compute shader")
  }
  let eb = ep.msl_name.to_bytes()
  let id = c_wgpu_create_compute_pipeline(
    self.id,
    mod.id,
    bytes_data_ptr(eb),
    eb.length(),
    ep.workgroup_size_x,
    ep.workgroup_size_y,
    ep.workgroup_size_z,
  )
  keep_alive(eb)
  if id <= 0 {
    return Err("create_compute_pipeline failed: " + self.last_error())
  }
  Ok(
    GpuComputePipeline::{
      dev_id: self.id,
      id: id,
      entry: entry_name,
      wg_x: ep.workgroup_size_x,
      wg_y: ep.workgroup_size_y,
      wg_z: ep.workgroup_size_z,
    },
  )
}

pub fn GpuComputePipeline::destroy(self : GpuComputePipeline) -> Unit {
  c_wgpu_destroy_compute_pipeline(self.dev_id, self.id)
}

pub fn GpuDevice::dispatch_compute(
  self : GpuDevice,
  pipe : GpuComputePipeline,
  entries : Array[GpuBindEntry],
  gx : Int,
  gy : Int,
  gz : Int,
) -> Result[Unit, String] {
  let b_slots : Array[Int] = []
  let b_ids : Array[Int] = []
  let t_slots : Array[Int] = []
  let t_ids : Array[Int] = []
  let s_slots : Array[Int] = []
  let s_ids : Array[Int] = []
  let mut i = 0
  while i < entries.length() {
    match entries[i] {
      GpuBindEntry::Buffer(g, b, buf) => {
        b_slots.push(g * 8 + b)
        b_ids.push(buf.id)
      }
      GpuBindEntry::Texture(g, b, tex) => {
        t_slots.push(g * 8 + b)
        t_ids.push(tex.id)
      }
      GpuBindEntry::Sampler(g, b, samp) => {
        s_slots.push(g * 8 + b)
        s_ids.push(samp.id)
      }
    }
    i = i + 1
  }
  let p_bs = pack_i32s(b_slots)
  let p_bi = pack_i32s(b_ids)
  let p_ts = pack_i32s(t_slots)
  let p_ti = pack_i32s(t_ids)
  let p_ss = pack_i32s(s_slots)
  let p_si = pack_i32s(s_ids)
  let r = c_wgpu_dispatch_compute(
    self.id,
    pipe.id,
    b_slots.length(),
    bytes_data_ptr(p_bs),
    bytes_data_ptr(p_bi),
    t_slots.length(),
    bytes_data_ptr(p_ts),
    bytes_data_ptr(p_ti),
    s_slots.length(),
    bytes_data_ptr(p_ss),
    bytes_data_ptr(p_si),
    gx,
    gy,
    gz,
  )
  keep_alive(p_bs)
  keep_alive(p_bi)
  keep_alive(p_ts)
  keep_alive(p_ti)
  keep_alive(p_ss)
  keep_alive(p_si)
  if r != 0 {
    return Err("dispatch_compute failed: " + self.last_error())
  }
  Ok(())
}

pub fn GpuDevice::create_render_pipeline(
  self : GpuDevice,
  vs_mod : GpuShaderModule,
  vs_entry : String,
  fs_mod : GpuShaderModule,
  fs_entry : String,
  color_format : Int,
  blend_enable : Bool,
) -> Result[GpuRenderPipeline, String] {
  let vs_ep = match find_entry_point(vs_mod.compiled, vs_entry) {
    Ok(ep) =>
    match ep.stage {
      EntryStage::Vertex => ep
      _ => return Err("entry point '" + vs_entry + "' is not a @vertex shader")
    }
    Err(err) => return Err(wgsl_error_message(err))
  }
  let fs_ep = match find_entry_point(fs_mod.compiled, fs_entry) {
    Ok(ep) =>
    match ep.stage {
      EntryStage::Fragment => ep
      _ => return Err("entry point '" + fs_entry + "' is not a @fragment shader")
    }
    Err(err) => return Err(wgsl_error_message(err))
  }
  let vb = vs_ep.msl_name.to_bytes()
  let fb = fs_ep.msl_name.to_bytes()
  let id = c_wgpu_create_render_pipeline(
    self.id,
    vs_mod.id,
    bytes_data_ptr(vb),
    vb.length(),
    fs_mod.id,
    bytes_data_ptr(fb),
    fb.length(),
    color_format,
    if blend_enable { 1 } else { 0 },
  )
  keep_alive(vb)
  keep_alive(fb)
  if id <= 0 {
    return Err("create_render_pipeline failed: " + self.last_error())
  }
  Ok(GpuRenderPipeline::{ dev_id: self.id, id: id, color_format: color_format })
}

pub fn GpuRenderPipeline::destroy(self : GpuRenderPipeline) -> Unit {
  c_wgpu_destroy_render_pipeline(self.dev_id, self.id)
}

pub fn GpuDevice::render_draw(
  self : GpuDevice,
  pipe : GpuRenderPipeline,
  target : GpuTexture,
  clear_enable : Bool,
  clear_r : Double,
  clear_g : Double,
  clear_b : Double,
  clear_a : Double,
  entries : Array[GpuBindEntry],
  prim : Int,
  vertex_start : Int,
  vertex_count : Int,
  instance_count : Int,
) -> Result[Unit, String] {
  let b_slots : Array[Int] = []
  let b_ids : Array[Int] = []
  let t_slots : Array[Int] = []
  let t_ids : Array[Int] = []
  let s_slots : Array[Int] = []
  let s_ids : Array[Int] = []
  let mut i = 0
  while i < entries.length() {
    match entries[i] {
      GpuBindEntry::Buffer(g, b, buf) => {
        b_slots.push(g * 8 + b)
        b_ids.push(buf.id)
      }
      GpuBindEntry::Texture(g, b, tex) => {
        t_slots.push(g * 8 + b)
        t_ids.push(tex.id)
      }
      GpuBindEntry::Sampler(g, b, samp) => {
        s_slots.push(g * 8 + b)
        s_ids.push(samp.id)
      }
    }
    i = i + 1
  }
  let p_bs = pack_i32s(b_slots)
  let p_bi = pack_i32s(b_ids)
  let p_ts = pack_i32s(t_slots)
  let p_ti = pack_i32s(t_ids)
  let p_ss = pack_i32s(s_slots)
  let p_si = pack_i32s(s_ids)
  let r = c_wgpu_render_draw(
    self.id,
    pipe.id,
    target.id,
    if clear_enable { 1 } else { 0 },
    clear_r,
    clear_g,
    clear_b,
    clear_a,
    b_slots.length(),
    bytes_data_ptr(p_bs),
    bytes_data_ptr(p_bi),
    t_slots.length(),
    bytes_data_ptr(p_ts),
    bytes_data_ptr(p_ti),
    s_slots.length(),
    bytes_data_ptr(p_ss),
    bytes_data_ptr(p_si),
    prim,
    vertex_start,
    vertex_count,
    instance_count,
  )
  keep_alive(p_bs)
  keep_alive(p_bi)
  keep_alive(p_ts)
  keep_alive(p_ti)
  keep_alive(p_ss)
  keep_alive(p_si)
  if r != 0 {
    return Err("render_draw failed: " + self.last_error())
  }
  Ok(())
}

// --- Pure-Pion Compressed PNG Encoder (Sub Filter + RFC 1951 Fixed-Huffman LZ77) ---

struct BitWriter {
  out : Array[Byte]
  mut acc : Int
  mut bits : Int
}

fn BitWriter::new() -> BitWriter {
  BitWriter::{ out: [], acc: 0, bits: 0 }
}

fn BitWriter::write_lsb(self : BitWriter, v : Int, nbits : Int) -> Unit {
  self.acc = self.acc | (v << self.bits)
  self.bits = self.bits + nbits
  while self.bits >= 8 {
    self.out.push((self.acc & 0xFF).to_byte())
    self.acc = (self.acc >> 8) & 0x00FFFFFF
    self.bits = self.bits - 8
  }
}

fn BitWriter::write_msb(self : BitWriter, v : Int, nbits : Int) -> Unit {
  let mut i = nbits - 1
  while i >= 0 {
    let bit = (v >> i) & 1
    self.write_lsb(bit, 1)
    i = i - 1
  }
}

fn BitWriter::flush_byte(self : BitWriter) -> Unit {
  if self.bits > 0 {
    self.out.push((self.acc & 0xFF).to_byte())
    self.acc = 0
    self.bits = 0
  }
}

fn bw_write_lit(bw : BitWriter, sym : Int) -> Unit {
  if sym <= 143 {
    bw.write_msb(48 + sym, 8)
  } else if sym <= 255 {
    bw.write_msb(400 + (sym - 144), 9)
  } else if sym <= 279 {
    bw.write_msb(sym - 256, 7)
  } else {
    bw.write_msb(192 + (sym - 280), 8)
  }
}

fn bw_write_len(bw : BitWriter, length : Int) -> Unit {
  if length <= 10 {
    bw_write_lit(bw, 254 + length)
  } else if length <= 18 {
    let off = length - 11
    bw_write_lit(bw, 265 + (off >> 1))
    bw.write_lsb(off & 1, 1)
  } else if length <= 34 {
    let off = length - 19
    bw_write_lit(bw, 269 + (off >> 2))
    bw.write_lsb(off & 3, 2)
  } else if length <= 66 {
    let off = length - 35
    bw_write_lit(bw, 273 + (off >> 3))
    bw.write_lsb(off & 7, 3)
  } else if length <= 130 {
    let off = length - 67
    bw_write_lit(bw, 277 + (off >> 4))
    bw.write_lsb(off & 15, 4)
  } else if length <= 257 {
    let off = length - 131
    bw_write_lit(bw, 281 + (off >> 5))
    bw.write_lsb(off & 31, 5)
  } else {
    bw_write_lit(bw, 285)
  }
}

fn bw_write_dist(bw : BitWriter, dist : Int) -> Unit {
  if dist <= 4 {
    bw.write_msb(dist - 1, 5)
    return
  }
  let mut d = dist - 1
  let mut extra = 1
  let mut base_code = 4
  let mut span = 4
  while d >= span * 2 {
    span = span * 2
    extra = extra + 1
    base_code = base_code + 2
  }
  let rem = d - span
  let half = span >> 1
  if rem < half {
    bw.write_msb(base_code, 5)
    bw.write_lsb(rem, extra)
  } else {
    bw.write_msb(base_code + 1, 5)
    bw.write_lsb(rem - half, extra)
  }
}

fn png_crc_table() -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < 256 {
    let mut c = i
    let mut b = 0
    while b < 8 {
      c = if (c & 1) != 0 {
        0xEDB88320 ^ ((c >> 1) & 0x7FFFFFFF)
      } else {
        (c >> 1) & 0x7FFFFFFF
      }
      b = b + 1
    }
    out.push(c)
    i = i + 1
  }
  out
}

fn png_push_be32(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 24) & 0xFF).to_byte())
  out.push(((v >> 16) & 0xFF).to_byte())
  out.push(((v >> 8) & 0xFF).to_byte())
  out.push((v & 0xFF).to_byte())
}

fn png_push_chunk(out : Array[Byte], crcs : Array[Int], tag : String, body : Array[Byte]) -> Unit {
  png_push_be32(out, body.length())
  let tb = tag.to_bytes()
  let mut c = -1
  let mut i = 0
  while i < tb.length() {
    let b = tb[i]
    out.push(b)
    c = crcs[(c ^ (b.to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i = i + 1
  }
  i = 0
  while i < body.length() {
    let b = body[i]
    out.push(b)
    c = crcs[(c ^ (b.to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i = i + 1
  }
  png_push_be32(out, c ^ -1)
}

///| Pure-Pion PNG encoder (Sub filter + Fixed-Huffman LZ77 deflate).
///| Produces compact, valid RGBA PNG files (< 500 KB for 512x512 shaders).
pub fn encode_png_rgba(rgba : Bytes, w : Int, h : Int) -> Bytes {
  let row_bytes = w * 4
  let stride = row_bytes + 1
  let total = h * stride
  let filt = Bytes::new(total)
  let mut y = 0
  while y < h {
    let dst_row = y * stride
    let src_row = y * row_bytes
    // Filter type 1 (Sub): each byte minus the byte 4 positions to the left
    filt[dst_row] = 1 as Byte
    let mut x = 0
    while x < row_bytes {
      let cur = rgba[src_row + x].to_int() & 0xFF
      let left = if x >= 4 { rgba[src_row + x - 4].to_int() & 0xFF } else { 0 }
      filt[dst_row + 1 + x] = ((cur - left) & 0xFF).to_byte()
      x = x + 1
    }
    y = y + 1
  }

  // Zlib stream: header + single fixed-Huffman LZ77 deflate block + Adler-32
  let bw = BitWriter::new()
  bw.out.push(0x78 as Byte)
  bw.out.push(0x01 as Byte)
  // BFINAL = 1, BTYPE = 01 (fixed Huffman) -> LSB-first bits: 1, 1, 0 = 0b011 = 3
  bw.write_lsb(3, 3)

  let htab : Array[Int] = []
  let mut hi = 0
  while hi < 4096 {
    htab.push(-1)
    hi = hi + 1
  }

  let mut pos = 0
  while pos < total {
    let mut best_len = 0
    let mut best_dist = 0
    if pos + 3 <= total {
      let b0 = filt[pos].to_int() & 0xFF
      let b1 = filt[pos + 1].to_int() & 0xFF
      let b2 = filt[pos + 2].to_int() & 0xFF
      let hkey = ((b0 * 31 + b1) * 31 + b2) & 4095
      let prev = htab[hkey]
      htab[hkey] = pos
      if prev >= 0 {
        let dist = pos - prev
        if dist >= 1 && dist <= 32768 {
          let max_m = if total - pos < 258 { total - pos } else { 258 }
          let mut m = 0
          while m < max_m && filt[prev + m] == filt[pos + m] {
            m = m + 1
          }
          if m >= 3 {
            best_len = m
            best_dist = dist
          }
        }
      }
      // Also check distance 4 (repeated RGBA delta) and distance 1 (run of zeros)
      if best_len < 16 && pos >= 4 {
        let max_m = if total - pos < 258 { total - pos } else { 258 }
        let mut m = 0
        while m < max_m && filt[pos - 4 + m] == filt[pos + m] {
          m = m + 1
        }
        if m > best_len && m >= 3 {
          best_len = m
          best_dist = 4
        }
      }
      if best_len < 16 && pos >= 1 {
        let max_m = if total - pos < 258 { total - pos } else { 258 }
        let mut m = 0
        while m < max_m && filt[pos - 1 + m] == filt[pos + m] {
          m = m + 1
        }
        if m > best_len && m >= 3 {
          best_len = m
          best_dist = 1
        }
      }
    }
    if best_len >= 3 {
      bw_write_len(bw, best_len)
      bw_write_dist(bw, best_dist)
      pos = pos + best_len
    } else {
      bw_write_lit(bw, filt[pos].to_int() & 0xFF)
      pos = pos + 1
    }
  }
  // End-of-block symbol 256
  bw_write_lit(bw, 256)
  bw.flush_byte()

  // Adler-32 over uncompressed filtered scanlines
  let mut a = 1
  let mut b = 0
  let mut i = 0
  while i < total {
    a = (a + (filt[i].to_int() & 0xFF)) % 65521
    b = (b + a) % 65521
    i = i + 1
  }
  png_push_be32(bw.out, (b << 16) | a)

  let crcs = png_crc_table()
  let out : Array[Byte] = [
    0x89 as Byte, 0x50 as Byte, 0x4E as Byte, 0x47 as Byte,
    0x0D as Byte, 0x0A as Byte, 0x1A as Byte, 0x0A as Byte,
  ]
  let ihdr : Array[Byte] = []
  png_push_be32(ihdr, w)
  png_push_be32(ihdr, h)
  ihdr.push(8 as Byte) // bit depth 8
  ihdr.push(6 as Byte) // RGBA
  ihdr.push(0 as Byte)
  ihdr.push(0 as Byte)
  ihdr.push(0 as Byte)
  png_push_chunk(out, crcs, "IHDR", ihdr)
  png_push_chunk(out, crcs, "IDAT", bw.out)
  png_push_chunk(out, crcs, "IEND", [])

  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k]
    k = k + 1
  }
  res
}
