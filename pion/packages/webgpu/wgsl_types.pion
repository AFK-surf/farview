///| Thin compatibility adapter over the pure-Pion W3C WGSL compiler (`wgsl v0.1.0`).
///| Preserves all public `webgpu` WGSL types and functions while delegating lexing,
///| parsing, static validation, layout reflection, and MSL codegen to `wgsl::compile_to_msl`.

import "wgsl"

///| Pipeline stage for a WGSL entry point.
pub enum EntryStage {
  Vertex
  Fragment
  Compute
}

///| Reflected entry point metadata.
pub struct EntryPointInfo {
  pub name : String
  pub msl_name : String
  pub stage : EntryStage
  pub workgroup_size_x : Int
  pub workgroup_size_y : Int
  pub workgroup_size_z : Int
}

///| Resource binding kind for `@group(g) @binding(b)`.
pub enum BindingKind {
  Uniform
  StorageRead
  StorageReadWrite
  Texture2d
  Sampler
}

///| Deterministic binding layout entry mapping WGSL `@group(g) @binding(b)`
///| to Metal buffer/texture/sampler slot.
pub struct BindingInfo {
  pub name : String
  pub group : Int
  pub binding : Int
  pub msl_slot : Int
  pub kind : BindingKind
  pub wgsl_type : String
}

///| Result of compiling a WGSL shader module to Metal Shading Language (MSL 2.x).
pub struct CompiledShader {
  pub msl : String
  pub entries : Array[EntryPointInfo]
  pub bindings : Array[BindingInfo]
}

///| Security and resource limits for lexing and parsing untrusted WGSL shaders.
pub val struct WgslLimits {
  pub max_source_bytes : Int
  pub max_tokens : Int
  pub max_nesting_depth : Int
}

///| Default conservative limits for web WGSL shaders.
pub fn WgslLimits::default() -> WgslLimits {
  WgslLimits::{
    max_source_bytes: 2097152,
    max_tokens: 250000,
    max_nesting_depth: 64,
  }
}

///| Construct custom `WgslLimits`.
pub fn WgslLimits::new(
  max_source_bytes : Int,
  max_tokens : Int,
  max_nesting_depth : Int,
) -> WgslLimits {
  WgslLimits::{
    max_source_bytes: max_source_bytes,
    max_tokens: max_tokens,
    max_nesting_depth: max_nesting_depth,
  }
}

///| Structured WGSL compiler error with line numbers.
pub enum WgslError {
  EmptySource
  LimitExceeded(String)
  LexError(Int, String)
  ParseError(Int, String)
  ValidationError(Int, String)
  CodegenError(Int, String)
}

///| Human-readable diagnostic string for a `WgslError`.
pub fn wgsl_error_message(e : WgslError) -> String {
  match e {
    WgslError::EmptySource => "empty WGSL source"
    WgslError::LimitExceeded(msg) => "limit exceeded: " + msg
    WgslError::LexError(line, msg) => "lex error at line " + line.to_string() + ": " + msg
    WgslError::ParseError(line, msg) => "parse error at line " + line.to_string() + ": " + msg
    WgslError::ValidationError(line, msg) =>
    "validation error at line " + line.to_string() + ": " + msg
    WgslError::CodegenError(line, msg) =>
    "codegen error at line " + line.to_string() + ": " + msg
  }
}

fn convert_stage(stage : wgsl::EntryStage) -> EntryStage {
  match stage {
    wgsl::EntryStage::Vertex => EntryStage::Vertex
    wgsl::EntryStage::Fragment => EntryStage::Fragment
    wgsl::EntryStage::Compute => EntryStage::Compute
  }
}

fn convert_binding_kind(kind : wgsl::BindingKind) -> BindingKind {
  match kind {
    wgsl::BindingKind::Uniform => BindingKind::Uniform
    wgsl::BindingKind::StorageRead => BindingKind::StorageRead
    wgsl::BindingKind::StorageReadWrite => BindingKind::StorageReadWrite
    wgsl::BindingKind::Sampler | wgsl::BindingKind::SamplerComparison => BindingKind::Sampler
    _ => BindingKind::Texture2d
  }
}

fn convert_error(e : wgsl::WgslError) -> WgslError {
  match e.kind {
    wgsl::WgslErrorKind::EmptySource => WgslError::EmptySource
    wgsl::WgslErrorKind::LimitExceeded => WgslError::LimitExceeded(e.message)
    wgsl::WgslErrorKind::LexError => WgslError::LexError(e.line, e.message)
    wgsl::WgslErrorKind::ParseError => WgslError::ParseError(e.line, e.message)
    wgsl::WgslErrorKind::ValidationError => WgslError::ValidationError(e.line, e.message)
    wgsl::WgslErrorKind::CodegenError => WgslError::CodegenError(e.line, e.message)
  }
}

///| Compile a WGSL shader module into Metal Shading Language (MSL 2.x) with custom limits.
pub fn wgsl_to_msl_with_limits(
  source : String,
  limits : WgslLimits,
) -> Result[CompiledShader, WgslError] {
  let opts = wgsl::CompileOptions::with_limits(
    wgsl::ParseLimits::new(
      limits.max_source_bytes,
      limits.max_tokens,
      limits.max_nesting_depth,
    ),
  )
  let compiled = match wgsl::compile_to_msl(source, opts) {
    Ok(c) => c
    Err(e) => return Err(convert_error(e))
  }
  let entries : Array[EntryPointInfo] = []
  let mut i = 0
  while i < compiled.reflection.entries.length() {
    let ep = compiled.reflection.entries[i]
    entries.push(
      EntryPointInfo::{
        name: ep.name,
        msl_name: ep.msl_name,
        stage: convert_stage(ep.stage),
        workgroup_size_x: ep.workgroup_size_x,
        workgroup_size_y: ep.workgroup_size_y,
        workgroup_size_z: ep.workgroup_size_z,
      },
    )
    i = i + 1
  }
  let bindings : Array[BindingInfo] = []
  i = 0
  while i < compiled.reflection.bindings.length() {
    let b = compiled.reflection.bindings[i]
    bindings.push(
      BindingInfo::{
        name: b.name,
        group: b.group,
        binding: b.binding,
        msl_slot: b.msl_slot,
        kind: convert_binding_kind(b.kind),
        wgsl_type: b.wgsl_type,
      },
    )
    i = i + 1
  }
  Ok(
    CompiledShader::{
      msl: compiled.source,
      entries: entries,
      bindings: bindings,
    },
  )
}

///| Compile a WGSL shader module into Metal Shading Language (MSL 2.x) with default limits.
pub fn wgsl_to_msl(source : String) -> Result[CompiledShader, WgslError] {
  wgsl_to_msl_with_limits(source, WgslLimits::default())
}

///| Look up an entry point by name in a compiled shader.
pub fn find_entry_point(
  shader : CompiledShader,
  name : String,
) -> Result[EntryPointInfo, WgslError] {
  let mut i = 0
  while i < shader.entries.length() {
    if shader.entries[i].name == name {
      return Ok(shader.entries[i])
    }
    i = i + 1
  }
  Err(WgslError::ValidationError(0, "unknown entry point '" + name + "'"))
}
