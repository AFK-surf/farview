struct IdentityDecompressor {
  dummy : Int
}

impl Decompressor for IdentityDecompressor {
  fn brotli_decode(self : IdentityDecompressor, data : Bytes) -> Result[Bytes, String] {
    let _ = self.dummy
    Ok(data)
  }

  fn zlib_inflate(
    self : IdentityDecompressor,
    data : Bytes,
    start : Int,
    size : Int,
  ) -> Result[Bytes, String] {
    let _ = self.dummy
    Ok(data.slice(start, start + size))
  }
}

fn push_u16_be(w : Array[Int], v : Int) -> Unit {
  w.push((v >> 8) & 255)
  w.push(v & 255)
}

fn push_u32_be(w : Array[Int], v : Int) -> Unit {
  push_u16_be(w, (v >> 16) & 0xFFFF)
  push_u16_be(w, v & 0xFFFF)
}

fn arr_to_bytes(a : Array[Int]) -> Bytes {
  let b = Bytes::new(a.length())
  let mut i = 0
  while i < a.length() {
    b[i] = (a[i] & 255).to_byte()
    i = i + 1
  }
  b
}

fn read_u32_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

fn read_u16_be(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 8) | b[off + 1].to_int()
}

test "passthrough non-woff data" {
  let raw = Bytes::new(16)
  raw[0] = (0).to_byte()
  raw[1] = (1).to_byte()
  let dec = IdentityDecompressor::{ dummy: 0 }
  match decode_using(raw, dec) {
    Ok(out) => debug_assert(out.length() == 16 && out[1].to_int() == 1, "passthrough")
    Err(e) => debug_assert(false, e)
  }
}

test "woff1 uncompressed table assembly" {
  // Build minimal WOFF1 container with 2 uncompressed tables: "name" and "cmap"
  // Output sfnt must sort tables by tag ("cmap" before "name").
  let buf : Array[Int] = []
  // Header: 44 bytes
  push_u32_be(buf, 0x774F4646) // "wOFF"
  push_u32_be(buf, 0x00010000) // flavor TrueType
  push_u32_be(buf, 100) // length
  push_u16_be(buf, 2) // numTables
  push_u16_be(buf, 0) // reserved
  push_u32_be(buf, 100) // totalSfntSize
  push_u16_be(buf, 1) // majorVersion
  push_u16_be(buf, 0) // minorVersion
  push_u32_be(buf, 0) // metaOffset
  push_u32_be(buf, 0) // metaLength
  push_u32_be(buf, 0) // metaOrigLength
  push_u32_be(buf, 0) // privOffset
  push_u32_be(buf, 0) // privLength
  // Directory starts at 44; 2 entries * 20 bytes = 40 bytes -> data at 84
  // Entry 0: "name" (0x6E616D65), off=84, comp=4, orig=4
  push_u32_be(buf, 0x6E616D65)
  push_u32_be(buf, 84)
  push_u32_be(buf, 4)
  push_u32_be(buf, 4)
  push_u32_be(buf, 0)
  // Entry 1: "cmap" (0x636D6170), off=88, comp=4, orig=4
  push_u32_be(buf, 0x636D6170)
  push_u32_be(buf, 88)
  push_u32_be(buf, 4)
  push_u32_be(buf, 4)
  push_u32_be(buf, 0)
  // Table data: "name" = 11 22 33 44, "cmap" = AA BB CC DD
  buf.push(0x11)
  buf.push(0x22)
  buf.push(0x33)
  buf.push(0x44)
  buf.push(0xAA)
  buf.push(0xBB)
  buf.push(0xCC)
  buf.push(0xDD)

  let woff = arr_to_bytes(buf)
  let dec = IdentityDecompressor::{ dummy: 0 }
  match decode_using(woff, dec) {
    Ok(sfnt) => {
      debug_assert(read_u32_be(sfnt, 0) == 0x00010000, "sfnt flavor")
      debug_assert(read_u16_be(sfnt, 4) == 2, "sfnt 2 tables")
      // Sorted: cmap first at directory offset 12, name second at 28
      debug_assert(read_u32_be(sfnt, 12) == 0x636D6170, "first table cmap")
      debug_assert(read_u32_be(sfnt, 28) == 0x6E616D65, "second table name")
      let cmap_off = read_u32_be(sfnt, 20)
      let name_off = read_u32_be(sfnt, 36)
      debug_assert(sfnt[cmap_off].to_int() == 0xAA, "cmap data byte 0")
      debug_assert(sfnt[name_off].to_int() == 0x11, "name data byte 0")
    }
    Err(e) => debug_assert(false, e)
  }
}

test "woff2 minimal container with identity brotli" {
  // Build minimal WOFF2 container with 1 untransformed known table "cmap" (index 0)
  let buf : Array[Int] = []
  // 48-byte WOFF2 header
  push_u32_be(buf, 0x774F4632) // "wOF2"
  push_u32_be(buf, 0x00010000) // flavor
  push_u32_be(buf, 54) // length
  push_u16_be(buf, 1) // numTables
  push_u16_be(buf, 0) // reserved
  push_u32_be(buf, 32) // totalSfntSize
  push_u32_be(buf, 4) // totalCompressedSize
  push_u16_be(buf, 1) // majorVersion
  push_u16_be(buf, 0) // minorVersion
  push_u32_be(buf, 0) // metaOffset
  push_u32_be(buf, 0) // metaLength
  push_u32_be(buf, 0) // metaOrigLength
  push_u32_be(buf, 0) // privOffset
  push_u32_be(buf, 0) // privLength
  // Table directory entry: flags=0 (known tag 0 = "cmap", version 0 = untransformed), origLen=4 (base128)
  buf.push(0)
  buf.push(4)
  // Compressed stream (4 bytes, identity brotli returns as-is)
  buf.push(0xDE)
  buf.push(0xAD)
  buf.push(0xBE)
  buf.push(0xEF)

  let woff2 = arr_to_bytes(buf)
  let dec = IdentityDecompressor::{ dummy: 0 }
  match decode_using(woff2, dec) {
    Ok(sfnt) => {
      debug_assert(read_u32_be(sfnt, 0) == 0x00010000, "sfnt flavor")
      debug_assert(read_u16_be(sfnt, 4) == 1, "1 table")
      debug_assert(read_u32_be(sfnt, 12) == 0x636D6170, "cmap tag")
      let off = read_u32_be(sfnt, 20)
      debug_assert(sfnt[off].to_int() == 0xDE && sfnt[off + 3].to_int() == 0xEF, "cmap payload")
    }
    Err(e) => debug_assert(false, e)
  }
}

test "woff2 rejects collection flavor" {
  let buf : Array[Int] = []
  push_u32_be(buf, 0x774F4632) // "wOF2"
  push_u32_be(buf, 0x74746366) // "ttcf"
  let mut i = 0
  while i < 40 {
    buf.push(0)
    i = i + 1
  }
  let dec = IdentityDecompressor::{ dummy: 0 }
  match decode_using(arr_to_bytes(buf), dec) {
    Ok(_) => debug_assert(false, "expected error for ttcf")
    Err(e) => debug_assert(e == "woff2: collections are not read", "ttcf error msg")
  }
}
