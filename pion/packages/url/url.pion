///| WHATWG URL Standard parser, serializer, setters, and relative resolver.
///| 1:1 port of `client/src/url/url.mbt`.

pub struct Url {
  pub mut scheme : String
  pub mut username : String
  pub mut password : String
  pub mut host : Option[String]
  pub mut port : Option[Int]
  pub mut path : Array[String]
  pub mut opaque_path : Option[String]
  pub mut query : Option[String]
  pub mut fragment : Option[String]
}

fn special_port_code(s : String) -> Int {
  if s == "http" || s == "ws" {
    80
  } else if s == "https" || s == "wss" {
    443
  } else if s == "ftp" {
    21
  } else if s == "file" {
    -1
  } else {
    -2
  }
}

fn is_special(s : String) -> Bool {
  special_port_code(s) != -2
}

fn is_default_special_port(scheme : String, port : Int) -> Bool {
  let p = special_port_code(scheme)
  p != -2 && p == port
}

fn hex_upper(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (55 + n).unsafe_to_char()
  }
}

fn hex_lower(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (87 + n).unsafe_to_char()
  }
}

fn write_cp(out : StringBuilder, cp : Int) -> Unit {
  out.write_char(cp.unsafe_to_char())
}

fn pct_byte(out : StringBuilder, b : Int) -> Unit {
  out.write_char('%')
  out.write_char(hex_upper((b >> 4) & 15))
  out.write_char(hex_upper(b & 15))
}

/// The code point percent-encoded as UTF-8 when `encode` says it must be.
fn pct(out : StringBuilder, c : Int, encode : (Int) -> Bool) -> Unit {
  if !encode(c) {
    write_cp(out, c)
    return
  }
  if c < 0x80 {
    pct_byte(out, c)
  } else if c < 0x800 {
    pct_byte(out, 0xC0 | (c >> 6))
    pct_byte(out, 0x80 | (c & 0x3F))
  } else if c < 0x10000 {
    pct_byte(out, 0xE0 | (c >> 12))
    pct_byte(out, 0x80 | ((c >> 6) & 0x3F))
    pct_byte(out, 0x80 | (c & 0x3F))
  } else {
    pct_byte(out, 0xF0 | (c >> 18))
    pct_byte(out, 0x80 | ((c >> 12) & 0x3F))
    pct_byte(out, 0x80 | ((c >> 6) & 0x3F))
    pct_byte(out, 0x80 | (c & 0x3F))
  }
}

fn c0_control(n : Int) -> Bool {
  n < 0x20 || n > 0x7E
}

fn fragment_set(n : Int) -> Bool {
  c0_control(n) || n == 0x20 || n == 0x22 || n == 0x3C || n == 0x3E || n == 0x60
}

fn query_set(n : Int) -> Bool {
  c0_control(n) || n == 0x20 || n == 0x22 || n == 0x23 || n == 0x3C || n == 0x3E
}

fn special_query_set(n : Int) -> Bool {
  query_set(n) || n == 0x27
}

fn path_set(n : Int) -> Bool {
  query_set(n) || n == 0x3F || n == 0x5E || n == 0x60 || n == 0x7B || n == 0x7D
}

fn userinfo_set(n : Int) -> Bool {
  path_set(n) ||
  n == 0x2F ||
  n == 0x3A ||
  n == 0x3B ||
  n == 0x3D ||
  n == 0x40 ||
  (n >= 0x5B && n <= 0x5D) ||
  n == 0x7C
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
}

fn lower_cp(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn is_ascii_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_hex(c : Int) -> Bool {
  is_ascii_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
}

fn hex_val(c : Int) -> Int {
  if is_ascii_digit(c) {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    c - 55
  }
}

fn utf8_decode_bytes_to_cps(b : Bytes) -> Array[Int] {
  let n = b.length()
  let out : Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let b0 = b[i].to_int()
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 < n {
        let b1 = b[i + 1].to_int()
        if (b1 & 0xC0) == 0x80 {
          out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
          i = i + 2
          continue
        }
      }
      out.push(0xFFFD)
      i = i + 1
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 < n {
        let b1 = b[i + 1].to_int()
        let b2 = b[i + 2].to_int()
        let lo = if b0 == 0xE0 { 0xA0 } else { 0x80 }
        let hi = if b0 == 0xED { 0x9F } else { 0xBF }
        if b1 >= lo && b1 <= hi && (b2 & 0xC0) == 0x80 {
          out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
          i = i + 3
          continue
        }
      }
      out.push(0xFFFD)
      i = i + 1
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 < n {
        let b1 = b[i + 1].to_int()
        let b2 = b[i + 2].to_int()
        let b3 = b[i + 3].to_int()
        let lo = if b0 == 0xF0 { 0x90 } else { 0x80 }
        let hi = if b0 == 0xF4 { 0x8F } else { 0xBF }
        if b1 >= lo && b1 <= hi && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
          out.push(
            ((b0 & 0x07) << 18) |
            ((b1 & 0x3F) << 12) |
            ((b2 & 0x3F) << 6) |
            (b3 & 0x3F),
          )
          i = i + 4
          continue
        }
      }
      out.push(0xFFFD)
      i = i + 1
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

fn str_to_cps(s : String) -> Array[Int] {
  utf8_decode_bytes_to_cps(s.to_bytes())
}

fn cps_to_str(cps : Array[Int]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < cps.length() {
    write_cp(sb, cps[i])
    i = i + 1
  }
  sb.to_string()
}

fn pct_decode(s : String) -> Bytes {
  let b = s.to_bytes()
  let out : Array[Int] = []
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int()
    if c == 37 &&
    i + 2 < b.length() &&
    is_hex(b[i + 1].to_int()) &&
    is_hex(b[i + 2].to_int()) {
      out.push(hex_val(b[i + 1].to_int()) * 16 + hex_val(b[i + 2].to_int()))
      i = i + 3
    } else {
      out.push(c)
      i = i + 1
    }
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k].to_byte()
    k = k + 1
  }
  res
}

fn puny_digit(d : Int) -> Char {
  if d < 26 {
    (d + 97).unsafe_to_char()
  } else {
    (d - 26 + 48).unsafe_to_char()
  }
}

fn puny_adapt(delta0 : Int, num : Int, first : Bool) -> Int {
  let base = 36
  let tmin = 1
  let tmax = 26
  let skew = 38
  let damp = 700
  let mut d = if first { delta0 / damp } else { delta0 / 2 }
  d = d + d / num
  let mut k = 0
  while d > (base - tmin) * tmax / 2 {
    d = d / (base - tmin)
    k = k + base
  }
  k + (base - tmin + 1) * d / (d + skew)
}

fn punycode(cps : Array[Int]) -> Option[String] {
  let base = 36
  let tmin = 1
  let tmax = 26
  let out = StringBuilder()
  let mut b = 0
  let mut ci = 0
  while ci < cps.length() {
    if cps[ci] < 0x80 {
      out.write_char(cps[ci].unsafe_to_char())
      b = b + 1
    }
    ci = ci + 1
  }
  let mut h = b
  if b > 0 {
    out.write_char('-')
  }
  let mut n = 128
  let mut delta = 0
  let mut bias = 72
  while h < cps.length() {
    let mut m = 0x7FFFFFFF
    ci = 0
    while ci < cps.length() {
      let c = cps[ci]
      if c >= n && c < m {
        m = c
      }
      ci = ci + 1
    }
    delta = delta + (m - n) * (h + 1)
    n = m
    ci = 0
    while ci < cps.length() {
      let c = cps[ci]
      if c < n {
        delta = delta + 1
      }
      if c == n {
        let mut q = delta
        let mut k = base
        while true {
          let t = if k <= bias {
            tmin
          } else if k >= bias + tmax {
            tmax
          } else {
            k - bias
          }
          if q < t {
            break
          }
          out.write_char(puny_digit(t + (q - t) % (base - t)))
          q = (q - t) / (base - t)
          k = k + base
        }
        out.write_char(puny_digit(q))
        bias = puny_adapt(delta, h + 1, h == b)
        delta = 0
        h = h + 1
      }
      ci = ci + 1
    }
    delta = delta + 1
    n = n + 1
  }
  Some(out.to_string())
}

fn arr_insert_int(arr : Array[Int], idx : Int, v : Int) -> Unit {
  arr.push(0)
  let mut i = arr.length() - 1
  while i > idx {
    arr[i] = arr[i - 1]
    i = i - 1
  }
  arr[idx] = v
}

fn punycode_decode(s : String) -> Option[Array[Int]] {
  let a = str_to_cps(s)
  let out : Array[Int] = []
  let mut start = 0
  let mut last_dash = -1
  let mut k = a.length() - 1
  while k >= 0 {
    if a[k] == 45 {
      last_dash = k
      break
    }
    k = k - 1
  }
  if last_dash >= 0 {
    let mut j = 0
    while j < last_dash {
      if a[j] >= 0x80 {
        return None
      }
      out.push(a[j])
      j = j + 1
    }
    start = last_dash + 1
  }
  let mut n = 128
  let mut i = 0
  let mut bias = 72
  let mut p = start
  while p < a.length() {
    let old_i = i
    let mut w = 1
    let mut kv = 36
    while true {
      if p >= a.length() {
        return None
      }
      let c = a[p]
      p = p + 1
      let d = if c >= 97 && c <= 122 {
        c - 97
      } else if c >= 65 && c <= 90 {
        c - 65
      } else if c >= 48 && c <= 57 {
        c - 22
      } else {
        return None
      }
      i = i + d * w
      if i > 0x10FFFF * 4 {
        return None
      }
      let t = if kv <= bias {
        1
      } else if kv >= bias + 26 {
        26
      } else {
        kv - bias
      }
      if d < t {
        break
      }
      w = w * (36 - t)
      kv = kv + 36
    }
    let len = out.length() + 1
    let mut delta = if old_i == 0 {
      (i - old_i) / 700
    } else {
      (i - old_i) / 2
    }
    delta = delta + delta / len
    let mut kk = 0
    while delta > 35 * 26 / 2 {
      delta = delta / 35
      kk = kk + 36
    }
    bias = kk + 36 * delta / (delta + 38)
    n = n + i / len
    i = i % len
    if n > 0x10FFFF {
      return None
    }
    arr_insert_int(out, i, n)
    i = i + 1
  }
  Some(out)
}

fn idna_map(c : Int) -> Option[Int] {
  if c == 0xAD ||
  c == 0x34F ||
  (c >= 0x180B && c <= 0x180F) ||
  c == 0x200B ||
  c == 0x2060 ||
  c == 0x2064 ||
  (c >= 0xFE00 && c <= 0xFE0F) ||
  c == 0xFEFF ||
  (c >= 0x1BCA0 && c <= 0x1BCA3) ||
  (c >= 0xE0100 && c <= 0xE01EF) {
    Some(-1)
  } else if c == 0x3002 || c == 0xFF0E || c == 0xFF61 {
    Some(0x2E)
  } else if c >= 0xFF01 && c <= 0xFF5E {
    let a = c - 0xFEE0
    Some(if a >= 0x41 && a <= 0x5A { a + 32 } else { a })
  } else if c == 0x3000 {
    Some(0x20)
  } else if c == 0xFFFD ||
  (c >= 0xFDD0 && c <= 0xFDEF) ||
  (c & 0xFFFE) == 0xFFFE ||
  (c >= 0x80 && c <= 0x9F) ||
  (c >= 0xD800 && c <= 0xDFFF) {
    None
  } else if c >= 0x41 && c <= 0x5A {
    Some(c + 32)
  } else {
    Some(c)
  }
}

fn domain_to_ascii(d0 : String) -> Option[String] {
  let cps0 = str_to_cps(d0)
  let mapped = StringBuilder()
  let mut i = 0
  while i < cps0.length() {
    match idna_map(cps0[i]) {
      Some(-1) => ()
      Some(m) => write_cp(mapped, m)
      None => return None
    }
    i = i + 1
  }
  let d = ascii_lower(mapped.to_string())
  let raw_labels = d.split(".")
  let labels : Array[String] = []
  i = 0
  while i < raw_labels.length() {
    let label = raw_labels[i]
    let cps = str_to_cps(label)
    let mut all_ascii = true
    let mut k = 0
    while k < cps.length() {
      if cps[k] >= 0x80 {
        all_ascii = false
        break
      }
      k = k + 1
    }
    if all_ascii {
      if label.starts_with("xn--") {
        let mut valid_ldh = true
        k = 0
        while k < cps.length() {
          let c = cps[k]
          if !(is_ascii_alpha(c) || is_ascii_digit(c) || c == 45) {
            valid_ldh = false
            break
          }
          k = k + 1
        }
        if valid_ldh {
          match punycode_decode(label.slice(4, label.length())) {
            Some(u) => {
              if u.length() > 0 {
                let mut has_non_ascii = false
                let mut all_mapped_same = true
                let mut ui = 0
                while ui < u.length() {
                  if u[ui] >= 0x80 {
                    has_non_ascii = true
                  }
                  match idna_map(u[ui]) {
                    Some(mv) => {
                      if mv != u[ui] {
                        all_mapped_same = false
                      }
                    }
                    None => all_mapped_same = false
                  }
                  ui = ui + 1
                }
                if !(has_non_ascii && all_mapped_same) {
                  return None
                }
              }
            }
            None => return None
          }
        }
      }
      labels.push(label)
    } else {
      if label.starts_with("xn--") {
        return None
      }
      match punycode(cps) {
        Some(p) => labels.push("xn--" + p)
        None => return None
      }
    }
    i = i + 1
  }
  Some(labels.join("."))
}

fn forbidden_host(c : Int) -> Bool {
  c == 0 ||
  c == 9 ||
  c == 10 ||
  c == 13 ||
  c == 32 ||
  c == 35 ||
  c == 47 ||
  c == 58 ||
  c == 60 ||
  c == 62 ||
  c == 63 ||
  c == 64 ||
  c == 91 ||
  c == 92 ||
  c == 93 ||
  c == 94 ||
  c == 124
}

fn forbidden_domain(c : Int) -> Bool {
  forbidden_host(c) || c <= 0x1F || c == 37 || c == 0x7F
}

fn ipv4_number(p : String) -> Option[Int64] {
  if p == "" {
    return None
  }
  let mut s = p
  let mut radix = 10
  if s.length() >= 2 && (s.starts_with("0x") || s.starts_with("0X")) {
    s = s.slice(2, s.length())
    radix = 16
  } else if s.length() >= 2 && s.starts_with("0") {
    s = s.slice(1, s.length())
    radix = 8
  }
  if s == "" {
    return Some(0L)
  }
  let cps = str_to_cps(s)
  let mut v = 0L
  let mut i = 0
  while i < cps.length() {
    let c = cps[i]
    let d = if is_ascii_digit(c) {
      c - 48
    } else if radix == 16 && is_hex(c) {
      hex_val(c)
    } else {
      return None
    }
    if d >= radix {
      return None
    }
    v = v * radix.to_int64() + d.to_int64()
    if v > 0xFFFFFFFFFFL {
      v = 0xFFFFFFFFFFL
    }
    i = i + 1
  }
  Some(v)
}

fn ends_in_number(d : String) -> Bool {
  let parts = d.split(".")
  if parts.length() > 1 && parts[parts.length() - 1] == "" {
    let _ = parts.pop()
  }
  if parts.length() == 0 {
    return false
  }
  let last = parts[parts.length() - 1]
  if last != "" {
    let cps = str_to_cps(last)
    let mut all_dig = true
    let mut i = 0
    while i < cps.length() {
      if !is_ascii_digit(cps[i]) {
        all_dig = false
        break
      }
      i = i + 1
    }
    if all_dig {
      return true
    }
  }
  ipv4_number(last).is_some()
}

fn parse_ipv4(d : String) -> Option[String] {
  let parts = d.split(".")
  if parts.length() > 1 && parts[parts.length() - 1] == "" {
    let _ = parts.pop()
  }
  if parts.length() > 4 {
    return None
  }
  let nums : Array[Int64] = []
  let mut i = 0
  while i < parts.length() {
    match ipv4_number(parts[i]) {
      Some(n) => nums.push(n)
      None => return None
    }
    i = i + 1
  }
  i = 0
  while i < nums.length() - 1 {
    if nums[i] > 255L {
      return None
    }
    i = i + 1
  }
  let last = nums[nums.length() - 1]
  let shift = 8 * (5 - nums.length())
  let limit = 1L << shift.to_int64()
  if last >= limit {
    return None
  }
  let mut v = last
  i = 0
  while i < nums.length() - 1 {
    let sh = 8 * (3 - i)
    v = v + (nums[i] << sh.to_int64())
    i = i + 1
  }
  let out : Array[String] = []
  i = 0
  while i < 4 {
    let sh = 8 * (3 - i)
    out.push(((v >> sh.to_int64()) & 255L).to_string())
    i = i + 1
  }
  Some(out.join("."))
}

fn parse_ipv6(s : String) -> Option[String] {
  let addr : Array[Int] = [0, 0, 0, 0, 0, 0, 0, 0]
  let chars = str_to_cps(s)
  let n = chars.length()
  let mut piece = 0
  let mut compress = -1
  let mut i = 0
  if i < n && chars[i] == 58 {
    if i + 1 >= n || chars[i + 1] != 58 {
      return None
    }
    i = i + 2
    piece = piece + 1
    compress = piece
  }
  while i < n {
    if piece == 8 {
      return None
    }
    if chars[i] == 58 {
      if compress != -1 {
        return None
      }
      i = i + 1
      piece = piece + 1
      compress = piece
      continue
    }
    let mut v = 0
    let mut len = 0
    while len < 4 && i < n && is_hex(chars[i]) {
      v = v * 16 + hex_val(chars[i])
      i = i + 1
      len = len + 1
    }
    if i < n && chars[i] == 46 {
      if len == 0 {
        return None
      }
      i = i - len
      if piece > 6 {
        return None
      }
      let mut seen = 0
      while i < n {
        let mut v4 = -1
        if seen > 0 {
          if chars[i] == 46 && seen < 4 {
            i = i + 1
          } else {
            return None
          }
        }
        if i >= n || !is_ascii_digit(chars[i]) {
          return None
        }
        while i < n && is_ascii_digit(chars[i]) {
          let d = chars[i] - 48
          if v4 == -1 {
            v4 = d
          } else if v4 == 0 {
            return None
          } else {
            v4 = v4 * 10 + d
          }
          if v4 > 255 {
            return None
          }
          i = i + 1
        }
        addr[piece] = addr[piece] * 256 + v4
        seen = seen + 1
        if seen == 2 || seen == 4 {
          piece = piece + 1
        }
      }
      if seen != 4 {
        return None
      }
      break
    } else if i < n && chars[i] == 58 {
      i = i + 1
      if i >= n {
        return None
      }
    } else if i < n {
      return None
    }
    addr[piece] = v
    piece = piece + 1
  }
  if compress != -1 {
    let mut swaps = piece - compress
    piece = 7
    while piece != 0 && swaps > 0 {
      let t = addr[piece]
      addr[piece] = addr[compress + swaps - 1]
      addr[compress + swaps - 1] = t
      piece = piece - 1
      swaps = swaps - 1
    }
  } else if piece != 8 {
    return None
  }
  let mut best = -1
  let mut best_len = 1
  let mut k = 0
  while k < 8 {
    if addr[k] == 0 {
      let start = k
      while k < 8 && addr[k] == 0 {
        k = k + 1
      }
      if k - start > best_len {
        best = start
        best_len = k - start
      }
    } else {
      k = k + 1
    }
  }
  let out = StringBuilder()
  let mut j = 0
  let mut ignore0 = false
  while j < 8 {
    if ignore0 && addr[j] == 0 {
      j = j + 1
      continue
    }
    ignore0 = false
    if best == j {
      out.write_string(if j == 0 { "::" } else { ":" })
      ignore0 = true
      j = j + 1
      continue
    }
    let v = addr[j]
    let mut started = false
    let shifts : Array[Int] = [12, 8, 4, 0]
    let mut si = 0
    while si < 4 {
      let sh = shifts[si]
      let d = (v >> sh) & 15
      if d != 0 || started || sh == 0 {
        out.write_char(hex_lower(d))
        started = true
      }
      si = si + 1
    }
    if j != 7 {
      out.write_char(':')
    }
    j = j + 1
  }
  Some("[" + out.to_string() + "]")
}

fn parse_host(input : String, special : Bool) -> Option[String] {
  if input.starts_with("[") {
    if !input.ends_with("]") {
      return None
    }
    return parse_ipv6(input.slice(1, input.length() - 1))
  }
  if !special {
    let out = StringBuilder()
    let cps = str_to_cps(input)
    let mut i = 0
    while i < cps.length() {
      if forbidden_host(cps[i]) {
        return None
      }
      pct(out, cps[i], c0_control)
      i = i + 1
    }
    return Some(out.to_string())
  }
  let domain = cps_to_str(utf8_decode_bytes_to_cps(pct_decode(input)))
  let ascii = match domain_to_ascii(domain) {
    Some(a) => a
    None => return None
  }
  if ascii == "" {
    return None
  }
  let acps = str_to_cps(ascii)
  let mut i = 0
  while i < acps.length() {
    if forbidden_domain(acps[i]) {
      return None
    }
    i = i + 1
  }
  if ends_in_number(ascii) {
    return parse_ipv4(ascii)
  }
  Some(ascii)
}

fn windows_letter(s : String, normalized : Bool) -> Bool {
  let a = str_to_cps(s)
  a.length() == 2 &&
  is_ascii_alpha(a[0]) &&
  (a[1] == 58 || (!normalized && a[1] == 124))
}

fn shorten(u : Url) -> Unit {
  if u.scheme == "file" &&
  u.path.length() == 1 &&
  windows_letter(u.path[0], true) {
    return
  }
  if u.path.length() > 0 {
    let _ = u.path.pop()
  }
}

fn starts_windows_letter(chars : Array[Int], i : Int) -> Bool {
  if chars.length() - i < 2 {
    return false
  }
  if !(is_ascii_alpha(chars[i]) && (chars[i + 1] == 58 || chars[i + 1] == 124)) {
    return false
  }
  if chars.length() - i == 2 {
    return true
  }
  let c2 = chars[i + 2]
  c2 == 47 || c2 == 92 || c2 == 63 || c2 == 35
}

fn is_pct2e(s : String, i : Int) -> Bool {
  s.code_unit_at(i) == 37 &&
  s.code_unit_at(i + 1) == 50 &&
  (s.code_unit_at(i + 2) == 101 || s.code_unit_at(i + 2) == 69)
}

fn single_dot(s : String) -> Bool {
  let n = s.length()
  if n == 1 {
    s.code_unit_at(0) == 46
  } else if n == 3 {
    is_pct2e(s, 0)
  } else {
    false
  }
}

fn double_dot(s : String) -> Bool {
  let n = s.length()
  if n == 2 {
    s.code_unit_at(0) == 46 && s.code_unit_at(1) == 46
  } else if n == 4 {
    (s.code_unit_at(0) == 46 && is_pct2e(s, 1)) ||
    (is_pct2e(s, 0) && s.code_unit_at(3) == 46)
  } else if n == 6 {
    is_pct2e(s, 0) && is_pct2e(s, 3)
  } else {
    false
  }
}

fn is_canonical_ipv4_slice(s : String, start : Int, end : Int) -> Bool {
  let mut i = start
  let mut octets = 0
  while octets < 4 {
    if i >= end {
      return false
    }
    let c0 = s.code_unit_at(i)
    if !is_ascii_digit(c0) {
      return false
    }
    let mut v = c0 - 48
    i = i + 1
    if v == 0 {
      if i < end && is_ascii_digit(s.code_unit_at(i)) {
        return false
      }
    } else {
      while i < end && is_ascii_digit(s.code_unit_at(i)) {
        v = v * 10 + (s.code_unit_at(i) - 48)
        if v > 255 {
          return false
        }
        i = i + 1
      }
    }
    octets = octets + 1
    if octets < 4 {
      if i >= end || s.code_unit_at(i) != 46 {
        return false
      }
      i = i + 1
    }
  }
  i == end
}

/// Fast-path parser for ASCII path + query + fragment on http/https URLs.
/// Returns false if any byte requires percent-encoding, tab/newline stripping,
/// non-ASCII handling, backslash, or encoded dot-segments (caller falls back).
fn parse_ascii_pqf(
  s : String,
  start_i : Int,
  end : Int,
  path : Array[String],
  parse_path : Bool,
) -> Option[(Option[String], Option[String])] {
  let mut i = start_i
  if parse_path {
    let mut seg_start = i
    let mut seg_has_pct = false
    while true {
      let c = if i < end { s.code_unit_at(i) } else { -1 }
      if c == -1 || c == 47 || c == 63 || c == 35 {
        let seg_len = i - seg_start
        if seg_len == 1 && s.code_unit_at(seg_start) == 46 {
          if c != 47 {
            path.push("")
          }
        } else if seg_len == 2 &&
        s.code_unit_at(seg_start) == 46 &&
        s.code_unit_at(seg_start + 1) == 46 {
          if path.length() > 0 {
            let _ = path.pop()
          }
          if c != 47 {
            path.push("")
          }
        } else if seg_has_pct && (seg_len == 3 || seg_len == 4 || seg_len == 6) {
          return None
        } else {
          path.push(s.slice(seg_start, i))
        }
        if c == 47 {
          i = i + 1
          seg_start = i
          seg_has_pct = false
        } else {
          break
        }
      } else {
        if c <= 0x20 ||
        c >= 0x7F ||
        c == 34 ||
        c == 60 ||
        c == 62 ||
        c == 92 ||
        c == 94 ||
        c == 96 ||
        c == 123 ||
        c == 125 {
          return None
        }
        if c == 37 {
          seg_has_pct = true
        }
        i = i + 1
      }
    }
  }
  let mut query : Option[String] = None
  if i < end && s.code_unit_at(i) == 63 {
    i = i + 1
    let q_start = i
    while i < end {
      let c = s.code_unit_at(i)
      if c == 35 {
        break
      }
      if c <= 0x20 || c >= 0x7F || c == 34 || c == 39 || c == 60 || c == 62 {
        return None
      }
      i = i + 1
    }
    query = Some(s.slice(q_start, i))
  }
  let mut fragment : Option[String] = None
  if i < end && s.code_unit_at(i) == 35 {
    i = i + 1
    let f_start = i
    while i < end {
      let c = s.code_unit_at(i)
      if c <= 0x20 || c >= 0x7F || c == 34 || c == 60 || c == 62 || c == 96 {
        return None
      }
      i = i + 1
    }
    fragment = Some(s.slice(f_start, i))
  }
  Some((query, fragment))
}

fn try_parse_http_fast(
  input0 : String,
  base : Option[Url],
  trim : Bool,
) -> Option[Url] {
  let raw_len = input0.length()
  let mut start = 0
  let mut end = raw_len
  if trim {
    while start < end && input0.code_unit_at(start) <= 0x20 {
      start = start + 1
    }
    while end > start && input0.code_unit_at(end - 1) <= 0x20 {
      end = end - 1
    }
  }
  let n = end - start
  // Case 1: Absolute lowercase "http://" or "https://"
  if n >= 8 &&
  input0.code_unit_at(start) == 104 &&
  input0.code_unit_at(start + 1) == 116 &&
  input0.code_unit_at(start + 2) == 116 &&
  input0.code_unit_at(start + 3) == 112 {
    let mut is_https = false
    let mut after = -1
    if input0.code_unit_at(start + 4) == 58 &&
    input0.code_unit_at(start + 5) == 47 &&
    input0.code_unit_at(start + 6) == 47 {
      after = start + 7
    } else if n >= 9 &&
    input0.code_unit_at(start + 4) == 115 &&
    input0.code_unit_at(start + 5) == 58 &&
    input0.code_unit_at(start + 6) == 47 &&
    input0.code_unit_at(start + 7) == 47 {
      is_https = true
      after = start + 8
    }
    if after >= 0 && after < end {
      let first_h = input0.code_unit_at(after)
      if first_h == 47 || first_h == 92 {
        return None
      }
      let host_start = after
      let mut i = after
      let mut last_label_start = after
      let mut prev_dot = true
      while i < end {
        let c = input0.code_unit_at(i)
        if c == 58 || c == 47 || c == 63 || c == 35 {
          break
        }
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 {
          if prev_dot &&
          c == 120 &&
          i + 3 < end &&
          input0.code_unit_at(i + 1) == 110 &&
          input0.code_unit_at(i + 2) == 45 &&
          input0.code_unit_at(i + 3) == 45 {
            return None
          }
          prev_dot = false
        } else if c == 46 {
          prev_dot = true
          last_label_start = i + 1
        } else {
          return None
        }
        i = i + 1
      }
      let host_end = i
      if host_end == host_start || prev_dot {
        return None
      }
      let last_first = input0.code_unit_at(last_label_start)
      if is_ascii_digit(last_first) {
        if !is_canonical_ipv4_slice(input0, host_start, host_end) {
          return None
        }
      }
      let mut port : Option[Int] = None
      if i < end && input0.code_unit_at(i) == 58 {
        i = i + 1
        let port_start = i
        let mut pv = 0
        while i < end {
          let c = input0.code_unit_at(i)
          if is_ascii_digit(c) {
            pv = pv * 10 + (c - 48)
            if pv > 65535 {
              return None
            }
            i = i + 1
          } else if c == 47 || c == 63 || c == 35 {
            break
          } else {
            return None
          }
        }
        if i > port_start {
          let def_p = if is_https { 443 } else { 80 }
          if pv != def_p {
            port = Some(pv)
          }
        }
      }
      let path : Array[String] = Array::with_capacity(4)
      let parse_path = if i < end && input0.code_unit_at(i) == 47 {
        i = i + 1
        true
      } else {
        path.push("")
        false
      }
      match parse_ascii_pqf(input0, i, end, path, parse_path) {
        Some((query, fragment)) => {
          return Some(Url::{
            scheme: if is_https { "https" } else { "http" },
            username: "",
            password: "",
            host: Some(input0.slice(host_start, host_end)),
            port: port,
            path: path,
            opaque_path: None,
            query: query,
            fragment: fragment,
          })
        }
        None => return None
      }
    }
  }
  // Case 2: Relative ASCII URL against an http/https hierarchical base
  match base {
    Some(b) => {
      if b.opaque_path.is_some() || (b.scheme != "http" && b.scheme != "https") {
        return None
      }
      if n == 0 {
        return Some(Url::{
          scheme: b.scheme,
          username: b.username,
          password: b.password,
          host: b.host,
          port: b.port,
          path: b.path.copy(),
          opaque_path: None,
          query: b.query,
          fragment: None,
        })
      }
      let c0 = input0.code_unit_at(start)
      if c0 == 47 {
        // Root-relative "/path..." (not protocol-relative "//" or "/\")
        if n >= 2 {
          let c1 = input0.code_unit_at(start + 1)
          if c1 == 47 || c1 == 92 {
            return None
          }
        }
        let path : Array[String] = Array::with_capacity(4)
        match parse_ascii_pqf(input0, start + 1, end, path, true) {
          Some((query, fragment)) => {
            return Some(Url::{
              scheme: b.scheme,
              username: b.username,
              password: b.password,
              host: b.host,
              port: b.port,
              path: path,
              opaque_path: None,
              query: query,
              fragment: fragment,
            })
          }
          None => return None
        }
      } else if c0 == 63 {
        let path = b.path.copy()
        match parse_ascii_pqf(input0, start, end, path, false) {
          Some((query, fragment)) => {
            return Some(Url::{
              scheme: b.scheme,
              username: b.username,
              password: b.password,
              host: b.host,
              port: b.port,
              path: path,
              opaque_path: None,
              query: query,
              fragment: fragment,
            })
          }
          None => return None
        }
      } else if c0 == 35 {
        let path = b.path.copy()
        match parse_ascii_pqf(input0, start, end, path, false) {
          Some((_, fragment)) => {
            return Some(Url::{
              scheme: b.scheme,
              username: b.username,
              password: b.password,
              host: b.host,
              port: b.port,
              path: path,
              opaque_path: None,
              query: b.query,
              fragment: fragment,
            })
          }
          None => return None
        }
      } else if c0 == 92 {
        return None
      } else {
        // Check if input has a scheme prefix (alpha [alpha|digit|+|-|.]* ':')
        if is_ascii_alpha(c0) {
          let mut j = start + 1
          while j < end {
            let cj = input0.code_unit_at(j)
            if is_ascii_alpha(cj) || is_ascii_digit(cj) || cj == 43 || cj == 45 || cj == 46 {
              j = j + 1
            } else {
              if cj == 58 {
                return None
              }
              break
            }
          }
        }
        let path = b.path.copy()
        if path.length() > 0 {
          let _ = path.pop()
        }
        match parse_ascii_pqf(input0, start, end, path, true) {
          Some((query, fragment)) => {
            return Some(Url::{
              scheme: b.scheme,
              username: b.username,
              password: b.password,
              host: b.host,
              port: b.port,
              path: path,
              opaque_path: None,
              query: query,
              fragment: fragment,
            })
          }
          None => return None
        }
      }
    }
    None => None
  }
}

/// Parses `input0` as a standalone URL (equivalent to `parse_url_with(input0, None, true)`).
pub fn parse_url(input0 : String) -> Option[Url] {
  parse_url_with(input0, None, true)
}

/// Parses `input0` against optional `base` URL (WHATWG basic URL parser).
pub fn parse_url_with(
  input0 : String,
  base : Option[Url],
  trim : Bool,
) -> Option[Url] {
  match try_parse_http_fast(input0, base, trim) {
    Some(u) => return Some(u)
    None => ()
  }
  let raw_cps = str_to_cps(input0)
  let raw_len = raw_cps.length()
  let mut t_start = 0
  let mut t_end = raw_len
  if trim {
    while t_start < t_end && raw_cps[t_start] <= 0x20 {
      t_start = t_start + 1
    }
    while t_end > t_start && raw_cps[t_end - 1] <= 0x20 {
      t_end = t_end - 1
    }
  }
  let mut has_tab_nl = false
  let mut ci = t_start
  while ci < t_end {
    let ch = raw_cps[ci]
    if ch == 9 || ch == 10 || ch == 13 {
      has_tab_nl = true
      break
    }
    ci = ci + 1
  }
  let chars : Array[Int] = if t_start == 0 && t_end == raw_len && !has_tab_nl {
    raw_cps
  } else {
    let out : Array[Int] = Array::with_capacity(t_end - t_start)
    ci = t_start
    while ci < t_end {
      let ch = raw_cps[ci]
      if ch != 9 && ch != 10 && ch != 13 {
        out.push(ch)
      }
      ci = ci + 1
    }
    out
  }
  let n = chars.length()
  let url = Url::{
    scheme: "",
    username: "",
    password: "",
    host: None,
    port: None,
    path: [],
    opaque_path: None,
    query: None,
    fragment: None,
  }
  let buf = StringBuilder()
  let mut buf_chars = 0
  // State IDs:
  // 0: scheme start, 1: scheme, 2: no scheme, 3: special relative or authority,
  // 4: path or authority, 5: relative, 6: relative slash,
  // 7: special authority slashes, 8: special authority ignore slashes,
  // 9: authority, 10: host, 11: port, 12: file, 13: file slash, 14: file host,
  // 15: path start, 16: path, 17: opaque path, 18: query, 19: fragment
  let mut state = 0
  let mut p = 0
  let mut at_seen = false
  let mut inside_brackets = false
  let mut password_seen = false
  let eof = 0x110000
  while p <= n {
    let c = if p >= 0 && p < n { chars[p] } else { eof }
    let c_next = if p + 1 >= 0 && p + 1 < n { chars[p + 1] } else { eof }
    if state == 0 {
      if c != eof && is_ascii_alpha(c) {
        write_cp(buf, lower_cp(c))
        buf_chars = buf_chars + 1
        state = 1
      } else {
        state = 2
        p = p - 1
      }
    } else if state == 1 {
      if c != eof &&
      (is_ascii_alpha(c) || is_ascii_digit(c) || c == 43 || c == 45 || c == 46) {
        write_cp(buf, lower_cp(c))
        buf_chars = buf_chars + 1
      } else if c == 58 {
        url.scheme = buf.to_string()
        buf.reset()
        buf_chars = 0
        if url.scheme == "file" {
          state = 12
        } else if is_special(url.scheme) &&
        (match base {
          Some(b) => b.scheme == url.scheme
          None => false
        }) {
          state = 3
        } else if is_special(url.scheme) {
          state = 7
        } else if c_next == 47 {
          state = 4
          p = p + 1
        } else {
          url.opaque_path = Some("")
          state = 17
        }
      } else {
        buf.reset()
        buf_chars = 0
        state = 2
        p = -1
      }
    } else if state == 2 {
      match base {
        None => return None
        Some(b) => {
          match b.opaque_path {
            Some(o) => {
              if c != 35 {
                return None
              }
              url.scheme = b.scheme
              url.opaque_path = Some(o)
              url.query = b.query
              url.fragment = Some("")
              state = 19
            }
            None => {
              if b.scheme != "file" {
                state = 5
                p = p - 1
              } else {
                state = 12
                p = p - 1
              }
            }
          }
        }
      }
    } else if state == 3 {
      if c == 47 && c_next == 47 {
        state = 8
        p = p + 1
      } else {
        state = 5
        p = p - 1
      }
    } else if state == 4 {
      if c == 47 {
        state = 9
      } else {
        state = 16
        p = p - 1
      }
    } else if state == 5 {
      let b = match base {
        Some(b) => b
        None => return None
      }
      url.scheme = b.scheme
      if c == 47 {
        state = 6
      } else if is_special(url.scheme) && c == 92 {
        state = 6
      } else {
        url.username = b.username
        url.password = b.password
        url.host = b.host
        url.port = b.port
        url.path = b.path.copy()
        url.query = b.query
        if c == 63 {
          url.query = Some("")
          state = 18
        } else if c == 35 {
          url.fragment = Some("")
          state = 19
        } else if c != eof {
          url.query = None
          shorten(url)
          state = 16
          p = p - 1
        }
      }
    } else if state == 6 {
      if is_special(url.scheme) && (c == 47 || c == 92) {
        state = 8
      } else if c == 47 {
        state = 9
      } else {
        let b = match base {
          Some(b) => b
          None => return None
        }
        url.username = b.username
        url.password = b.password
        url.host = b.host
        url.port = b.port
        state = 16
        p = p - 1
      }
    } else if state == 7 {
      if c == 47 && c_next == 47 {
        state = 8
        p = p + 1
      } else {
        state = 8
        p = p - 1
      }
    } else if state == 8 {
      if c != 47 && c != 92 {
        state = 9
        p = p - 1
      }
    } else if state == 9 {
      if c == 64 {
        if at_seen {
          let cur = buf.to_string()
          buf.reset()
          buf.write_string("%40")
          buf.write_string(cur)
        }
        at_seen = true
        let info = str_to_cps(buf.to_string())
        buf.reset()
        buf_chars = 0
        let u_sb = StringBuilder()
        let p_sb = StringBuilder()
        if url.username != "" {
          u_sb.write_string(url.username)
        }
        if url.password != "" {
          p_sb.write_string(url.password)
        }
        let mut ii = 0
        while ii < info.length() {
          let ch = info[ii]
          if ch == 58 && !password_seen {
            password_seen = true
            ii = ii + 1
            continue
          }
          if password_seen {
            pct(p_sb, ch, userinfo_set)
          } else {
            pct(u_sb, ch, userinfo_set)
          }
          ii = ii + 1
        }
        url.username = u_sb.to_string()
        url.password = p_sb.to_string()
      } else if c == eof ||
      c == 47 ||
      c == 63 ||
      c == 35 ||
      (is_special(url.scheme) && c == 92) {
        if at_seen && buf.length() == 0 {
          return None
        }
        p = p - buf_chars - 1
        buf.reset()
        buf_chars = 0
        state = 10
      } else {
        write_cp(buf, c)
        buf_chars = buf_chars + 1
      }
    } else if state == 10 {
      if c == 58 && !inside_brackets {
        if buf.length() == 0 {
          return None
        }
        match parse_host(buf.to_string(), is_special(url.scheme)) {
          Some(h) => url.host = Some(h)
          None => return None
        }
        buf.reset()
        buf_chars = 0
        state = 11
      } else if c == eof ||
      c == 47 ||
      c == 63 ||
      c == 35 ||
      (is_special(url.scheme) && c == 92) {
        p = p - 1
        if is_special(url.scheme) && buf.length() == 0 {
          return None
        }
        match parse_host(buf.to_string(), is_special(url.scheme)) {
          Some(h) => url.host = Some(h)
          None => return None
        }
        buf.reset()
        buf_chars = 0
        state = 15
      } else {
        if c == 91 {
          inside_brackets = true
        }
        if c == 93 {
          inside_brackets = false
        }
        write_cp(buf, c)
        buf_chars = buf_chars + 1
      }
    } else if state == 11 {
      if c != eof && is_ascii_digit(c) {
        write_cp(buf, c)
        buf_chars = buf_chars + 1
      } else if c == eof ||
      c == 47 ||
      c == 63 ||
      c == 35 ||
      (is_special(url.scheme) && c == 92) {
        if buf.length() > 0 {
          let ps = buf.to_string()
          let mut v = 0
          let mut pi = 0
          while pi < ps.length() {
            v = v * 10 + (ps.code_unit_at(pi) - 48)
            if v > 65535 {
              return None
            }
            pi = pi + 1
          }
          url.port = if is_default_special_port(url.scheme, v) {
            None
          } else {
            Some(v)
          }
          buf.reset()
          buf_chars = 0
        }
        state = 15
        p = p - 1
      } else {
        return None
      }
    } else if state == 12 {
      url.scheme = "file"
      url.host = Some("")
      if c == 47 || c == 92 {
        state = 13
      } else {
        let handled = match base {
          Some(b) => {
            if b.scheme == "file" {
              url.host = b.host
              url.path = b.path.copy()
              url.query = b.query
              if c == 63 {
                url.query = Some("")
                state = 18
              } else if c == 35 {
                url.fragment = Some("")
                state = 19
              } else if c != eof {
                url.query = None
                if !starts_windows_letter(chars, p) {
                  shorten(url)
                } else {
                  url.path = []
                }
                state = 16
                p = p - 1
              }
              true
            } else {
              false
            }
          }
          None => false
        }
        if !handled {
          state = 16
          p = p - 1
        }
      }
    } else if state == 13 {
      if c == 47 || c == 92 {
        state = 14
      } else {
        match base {
          Some(b) => {
            if b.scheme == "file" {
              url.host = b.host
              if !starts_windows_letter(chars, p) &&
              b.path.length() > 0 &&
              windows_letter(b.path[0], true) {
                url.path.push(b.path[0])
              }
            }
          }
          None => ()
        }
        state = 16
        p = p - 1
      }
    } else if state == 14 {
      if c == eof || c == 47 || c == 92 || c == 63 || c == 35 {
        p = p - 1
        if windows_letter(buf.to_string(), false) {
          state = 16
        } else if buf.length() == 0 {
          url.host = Some("")
          state = 15
        } else {
          match parse_host(buf.to_string(), true) {
            Some(h) => url.host = Some(if h == "localhost" { "" } else { h })
            None => return None
          }
          buf.reset()
          buf_chars = 0
          state = 15
        }
      } else {
        write_cp(buf, c)
        buf_chars = buf_chars + 1
      }
    } else if state == 15 {
      if is_special(url.scheme) {
        state = 16
        if c != 47 && c != 92 {
          p = p - 1
        }
      } else if c == 63 {
        url.query = Some("")
        state = 18
      } else if c == 35 {
        url.fragment = Some("")
        state = 19
      } else if c != eof {
        state = 16
        if c != 47 {
          p = p - 1
        }
      }
    } else if state == 16 {
      if c == eof ||
      c == 47 ||
      (is_special(url.scheme) && c == 92) ||
      c == 63 ||
      c == 35 {
        let seg = buf.to_string()
        let slash = c == 47 || (is_special(url.scheme) && c == 92)
        if double_dot(seg) {
          shorten(url)
          if !slash {
            url.path.push("")
          }
        } else if single_dot(seg) && !slash {
          url.path.push("")
        } else if !single_dot(seg) {
          if url.scheme == "file" &&
          url.path.length() == 0 &&
          windows_letter(seg, false) {
            let a = str_to_cps(seg)
            let sb2 = StringBuilder()
            write_cp(sb2, a[0])
            sb2.write_char(':')
            url.path.push(sb2.to_string())
          } else {
            url.path.push(seg)
          }
        }
        buf.reset()
        buf_chars = 0
        if c == 63 {
          url.query = Some("")
          state = 18
        }
        if c == 35 {
          url.fragment = Some("")
          state = 19
        }
      } else {
        pct(buf, c, path_set)
      }
    } else if state == 17 {
      if c == 63 {
        url.opaque_path = Some(buf.to_string())
        buf.reset()
        buf_chars = 0
        url.query = Some("")
        state = 18
      } else if c == 35 {
        url.opaque_path = Some(buf.to_string())
        buf.reset()
        buf_chars = 0
        url.fragment = Some("")
        state = 19
      } else if c == 32 {
        if c_next == 63 || c_next == 35 {
          buf.write_string("%20")
        } else {
          buf.write_char(' ')
        }
      } else if c != eof {
        pct(buf, c, c0_control)
      } else {
        url.opaque_path = Some(buf.to_string())
        buf.reset()
        buf_chars = 0
      }
    } else if state == 18 {
      if c == 35 || c == eof {
        url.query = Some(buf.to_string())
        buf.reset()
        buf_chars = 0
        if c == 35 {
          url.fragment = Some("")
          state = 19
        }
      } else {
        if is_special(url.scheme) {
          pct(buf, c, special_query_set)
        } else {
          pct(buf, c, query_set)
        }
      }
    } else if state == 19 {
      if c != eof {
        pct(buf, c, fragment_set)
      } else {
        url.fragment = Some(buf.to_string())
        buf.reset()
        buf_chars = 0
      }
    } else {
      return None
    }
    p = p + 1
  }
  Some(url)
}

fn write_url_path(b : StringBuilder, u : Url, href : Bool) -> Unit {
  match u.opaque_path {
    Some(o) => b.write_string(o)
    None => {
      if href && u.host.is_none() && u.path.length() > 1 && u.path[0] == "" {
        b.write_string("/.")
      }
      let mut i = 0
      let n = u.path.length()
      while i < n {
        b.write_char('/')
        b.write_string(u.path[i])
        i = i + 1
      }
    }
  }
}

/// A URL's path as a string.
pub fn url_path(u : Url, href : Bool) -> String {
  match u.opaque_path {
    Some(o) => o
    None => {
      let b = StringBuilder()
      write_url_path(b, u, href)
      b.to_string()
    }
  }
}

/// A URL's host and port as written ("" for none).
pub fn url_host(u : Url) -> String {
  match u.host {
    Some(h) => {
      match u.port {
        Some(p) => h + ":" + p.to_string()
        None => h
      }
    }
    None => ""
  }
}

fn write_url_href(b : StringBuilder, u : Url, exclude_fragment : Bool) -> Unit {
  b.write_string(u.scheme)
  b.write_char(':')
  match u.host {
    Some(h) => {
      b.write_string("//")
      if u.username != "" || u.password != "" {
        b.write_string(u.username)
        if u.password != "" {
          b.write_char(':')
          b.write_string(u.password)
        }
        b.write_char('@')
      }
      b.write_string(h)
      match u.port {
        Some(p) => {
          b.write_char(':')
          b.write_string(p.to_string())
        }
        None => ()
      }
    }
    None => ()
  }
  write_url_path(b, u, true)
  match u.query {
    Some(q) => {
      b.write_char('?')
      b.write_string(q)
    }
    None => ()
  }
  if !exclude_fragment {
    match u.fragment {
      Some(f) => {
        b.write_char('#')
        b.write_string(f)
      }
      None => ()
    }
  }
}

/// A URL as text (the URL serializer).
pub fn url_href(u : Url, exclude_fragment : Bool) -> String {
  let b = StringBuilder()
  write_url_href(b, u, exclude_fragment)
  b.to_string()
}

/// A URL's origin as text ("null" for an opaque one).
pub fn url_origin(u : Url) -> String {
  if u.scheme == "http" ||
  u.scheme == "https" ||
  u.scheme == "ws" ||
  u.scheme == "wss" ||
  u.scheme == "ftp" {
    u.scheme + "://" + url_host(u)
  } else if u.scheme == "blob" {
    match parse_url(url_path(u, false)) {
      Some(inner) => {
        if inner.scheme == "http" || inner.scheme == "https" {
          url_origin(inner)
        } else {
          "null"
        }
      }
      None => "null"
    }
  } else {
    "null"
  }
}

/// A URL's parts for a page's URL object, joined by U+0001.
pub fn url_fields(u : Url) -> String {
  let sep = (1).unsafe_to_char()
  let b = StringBuilder()
  let port_s = match u.port {
    Some(p) => p.to_string()
    None => ""
  }
  let host_name = u.host.unwrap_or("")
  // 0: href
  write_url_href(b, u, false)
  b.write_char(sep)
  // 1: protocol
  b.write_string(u.scheme)
  b.write_char(':')
  b.write_char(sep)
  // 2: username
  b.write_string(u.username)
  b.write_char(sep)
  // 3: password
  b.write_string(u.password)
  b.write_char(sep)
  // 4: host
  if u.host.is_some() {
    b.write_string(host_name)
    if port_s != "" {
      b.write_char(':')
      b.write_string(port_s)
    }
  }
  b.write_char(sep)
  // 5: hostname
  b.write_string(host_name)
  b.write_char(sep)
  // 6: port
  b.write_string(port_s)
  b.write_char(sep)
  // 7: pathname
  write_url_path(b, u, false)
  b.write_char(sep)
  // 8: search
  match u.query {
    Some(q) => {
      if q != "" {
        b.write_char('?')
        b.write_string(q)
      }
    }
    None => ()
  }
  b.write_char(sep)
  // 9: hash
  match u.fragment {
    Some(f) => {
      if f != "" {
        b.write_char('#')
        b.write_string(f)
      }
    }
    None => ()
  }
  b.write_char(sep)
  // 10: origin
  if u.scheme == "http" ||
  u.scheme == "https" ||
  u.scheme == "ws" ||
  u.scheme == "wss" ||
  u.scheme == "ftp" {
    b.write_string(u.scheme)
    b.write_string("://")
    if u.host.is_some() {
      b.write_string(host_name)
      if port_s != "" {
        b.write_char(':')
        b.write_string(port_s)
      }
    }
  } else {
    b.write_string(url_origin(u))
  }
  b.to_string()
}

fn contains_cp(s : String, target : Int) -> Bool {
  let cps = str_to_cps(s)
  let mut i = 0
  while i < cps.length() {
    if cps[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

fn cut_at(v : String, stops : String) -> String {
  let b = StringBuilder()
  let cps = str_to_cps(v)
  let mut i = 0
  while i < cps.length() {
    if contains_cp(stops, cps[i]) {
      break
    }
    write_cp(b, cps[i])
    i = i + 1
  }
  b.to_string()
}

fn encoded(v : String, set : (Int) -> Bool) -> String {
  let b = StringBuilder()
  let cps = str_to_cps(v)
  let mut i = 0
  while i < cps.length() {
    pct(b, cps[i], set)
    i = i + 1
  }
  b.to_string()
}

fn strip_tabs_newlines(v0 : String) -> String {
  let cps = str_to_cps(v0)
  let sb = StringBuilder()
  let mut i = 0
  while i < cps.length() {
    let c = cps[i]
    if c != 9 && c != 10 && c != 13 {
      write_cp(sb, c)
    }
    i = i + 1
  }
  sb.to_string()
}

/// Sets one part of a URL as the URL object's setters do.
pub fn url_set(u : Url, part : String, v0 : String) -> Unit {
  let v = strip_tabs_newlines(v0)
  let special = is_special(u.scheme)
  let no_host = match u.host {
    None => true
    Some(h) => h == ""
  }
  if part == "protocol" {
    let s = ascii_lower(cut_at(v, ":"))
    let a = str_to_cps(s)
    if a.length() == 0 || !is_ascii_alpha(a[0]) {
      return
    }
    let mut i = 0
    while i < a.length() {
      let c = a[i]
      if !(is_ascii_alpha(c) || is_ascii_digit(c) || c == 43 || c == 45 || c == 46) {
        return
      }
      i = i + 1
    }
    if is_special(s) != special {
      return
    }
    if s == "file" && (u.username != "" || u.password != "" || u.port.is_some()) {
      return
    }
    if u.scheme == "file" && no_host {
      return
    }
    u.scheme = s
    match u.port {
      Some(p) => {
        if is_default_special_port(s, p) {
          u.port = None
        }
      }
      None => ()
    }
  } else if part == "username" {
    if !no_host && u.scheme != "file" {
      u.username = encoded(v0, userinfo_set)
    }
  } else if part == "password" {
    if !no_host && u.scheme != "file" {
      u.password = encoded(v0, userinfo_set)
    }
  } else if part == "host" || part == "hostname" {
    if u.opaque_path.is_some() {
      return
    }
    let stops = if special { "/?#\\" } else { "/?#" }
    let mut h = cut_at(v, stops)
    let mut port : Option[String] = None
    if u.scheme != "file" {
      let a = str_to_cps(h)
      let mut depth = 0
      let mut i = 0
      while i < a.length() {
        let c = a[i]
        if c == 91 {
          depth = depth + 1
        } else if c == 93 {
          depth = depth - 1
        } else if c == 58 && depth == 0 {
          let before : Array[Int] = []
          let after : Array[Int] = []
          let mut k = 0
          while k < i {
            before.push(a[k])
            k = k + 1
          }
          k = i + 1
          while k < a.length() {
            after.push(a[k])
            k = k + 1
          }
          h = cps_to_str(before)
          port = Some(cps_to_str(after))
          break
        }
        i = i + 1
      }
    }
    if port.is_some() && (part == "hostname" || h == "") {
      return
    }
    if h == "" {
      if u.scheme == "file" {
        u.host = Some("")
        return
      }
      if special {
        return
      }
      if u.username != "" || u.password != "" || u.port.is_some() {
        return
      }
    }
    let host = match parse_host(h, special) {
      Some(host) => host
      None => return
    }
    u.host = Some(if u.scheme == "file" && host == "localhost" { "" } else { host })
    match port {
      Some(p) => {
        if p != "" {
          url_set(u, "port", p)
        }
      }
      None => ()
    }
  } else if part == "port" {
    if no_host || u.scheme == "file" {
      return
    }
    if v0 == "" {
      u.port = None
      return
    }
    let vcps = str_to_cps(v)
    let digits = StringBuilder()
    let mut i = 0
    while i < vcps.length() {
      if !is_ascii_digit(vcps[i]) {
        break
      }
      write_cp(digits, vcps[i])
      i = i + 1
    }
    let d = digits.to_string()
    if d == "" {
      return
    }
    let mut n = 0
    i = 0
    while i < d.length() {
      n = n * 10 + (d.code_unit_at(i) - 48)
      if n > 65535 {
        return
      }
      i = i + 1
    }
    u.port = if is_default_special_port(u.scheme, n) { None } else { Some(n) }
  } else if part == "pathname" {
    if u.opaque_path.is_some() {
      return
    }
    let p = v.replace("?", "%3F").replace("#", "%23")
    let lead = if p.starts_with("/") || (special && p.starts_with("\\")) {
      ""
    } else {
      "/"
    }
    let base_s = u.scheme +
    ":" +
    (match u.host {
      Some(h) => "//" + h
      None => "/."
    })
    if p == "" && !special && u.host.is_some() {
      u.path = []
      return
    }
    match parse_url_with(base_s + lead + p, None, false) {
      Some(r) => u.path = r.path
      None => ()
    }
  } else if part == "search" {
    let q = if v.starts_with("?") { v.slice(1, v.length()) } else { v }
    if v == "" {
      u.query = None
      return
    }
    u.query = Some(
      if special {
        encoded(q, special_query_set)
      } else {
        encoded(q, query_set)
      },
    )
  } else if part == "hash" {
    let f = if v.starts_with("#") { v.slice(1, v.length()) } else { v }
    if v == "" {
      u.fragment = None
      return
    }
    u.fragment = Some(encoded(f, fragment_set))
  }
}

fn resolve_loose(base : String, r : String) -> String {
  if r.starts_with("http://") ||
  r.starts_with("https://") ||
  r.starts_with("data:") {
    return r
  }
  let se = base.index_of("://")
  let scheme_end = if se >= 0 { se + 3 } else { 0 }
  let rest = base.slice(scheme_end, base.length())
  let ps = rest.index_of("/")
  let path_start = if ps >= 0 { scheme_end + ps } else { base.length() }
  let origin = base.slice(0, path_start)
  if r.starts_with("//") {
    if se >= 0 {
      return base.slice(0, se + 1) + r
    }
    return "https:" + r
  }
  if r.starts_with("/") {
    return origin + r
  }
  if r.starts_with("#") || r.starts_with("?") {
    let cut = base.index_of(r.slice(0, 1))
    let c = if cut >= 0 { cut } else { base.length() }
    return base.slice(0, c) + r
  }
  let mut dir = base.slice(path_start, base.length())
  let qi = dir.index_of("?")
  if qi >= 0 {
    dir = dir.slice(0, qi)
  }
  let ls = rev_find_byte(dir, 47)
  if ls >= 0 {
    dir = dir.slice(0, ls + 1)
  } else {
    dir = "/"
  }
  let segs = (dir + r).split("/")
  let parts : Array[String] = []
  let mut i = 0
  while i < segs.length() {
    let s = segs[i]
    if s == ".." {
      if parts.length() > 0 {
        let _ = parts.pop()
      }
    } else if s != "." && s != "" {
      parts.push(s)
    }
    i = i + 1
  }
  let trailing = if r.ends_with("/") { "/" } else { "" }
  origin + "/" + parts.join("/") + trailing
}

/// A reference resolved against a base URL.
pub fn resolve(base : String, r : String) -> String {
  match try_parse_http_fast(r, None, true) {
    Some(u) => return url_href(u, false)
    None => ()
  }
  let b = parse_url(base)
  match parse_url_with(r, b, true) {
    Some(u) => url_href(u, false)
    None => resolve_loose(base, r)
  }
}
