test "data url bytes (ported from data_test.mbt)" {
  let d1 = data_url_bytes("data:image/svg+xml,%3Csvg width='2'%3E%3C/svg%3E")
  debug_assert(d1.is_some(), "d1 some")
  match d1 {
    Some(b) => debug_assert(b.to_string() == "<svg width='2'></svg>", "d1 content")
    None => ()
  }

  let d2 = data_url_bytes("data:image/svg+xml;utf8,<svg fill='%23f00'>é</svg>")
  match d2 {
    Some(b) => debug_assert(b.to_string() == "<svg fill='#f00'>é</svg>", "d2 content")
    None => debug_assert(false, "d2 none")
  }

  let d3 = data_url_bytes("DATA:text/plain;charset=utf-8;BASE64,aGk%3D")
  match d3 {
    Some(b) => debug_assert(b.to_string() == "hi", "d3 content")
    None => debug_assert(false, "d3 none")
  }

  let d4 = data_url_bytes("data:;base64,aGVs\n bG8=")
  match d4 {
    Some(b) => debug_assert(b.to_string() == "hello", "d4 content")
    None => debug_assert(false, "d4 none")
  }

  let d5 = data_url_bytes("data:,100%")
  match d5 {
    Some(b) => debug_assert(b.to_string() == "100%", "d5 content")
    None => debug_assert(false, "d5 none")
  }

  debug_assert(data_url_bytes("data:no-comma").is_none(), "no comma")
  debug_assert(data_url_bytes("https://a.b/c,d").is_none(), "not data scheme")
}

test "whatwg url parsing and serialization" {
  match parse_url("https://User:Pa%3Ass@Example.COM:443/a/b/../c?q=hello world&x='1'#frag ment") {
    Some(u) => {
      debug_assert(u.scheme == "https", "scheme")
      debug_assert(u.username == "User", "username")
      debug_assert(u.password == "Pa%3Ass", "password")
      debug_assert(u.host.unwrap_or("") == "example.com", "host")
      debug_assert(u.port.is_none(), "default port elided")
      debug_assert(
        url_href(u, false) == "https://User:Pa%3Ass@example.com/a/c?q=hello%20world&x=%271%27#frag%20ment",
        "href"
      )
      debug_assert(url_origin(u) == "https://example.com", "origin")
    }
    None => debug_assert(false, "parse failed")
  }

  // Non-default port
  match parse_url("http://example.com:8080/p") {
    Some(u) => {
      debug_assert(u.port.unwrap_or(-1) == 8080, "port 8080")
      debug_assert(url_host(u) == "example.com:8080", "url_host")
      debug_assert(url_origin(u) == "http://example.com:8080", "origin with port")
    }
    None => debug_assert(false, "port parse failed")
  }

  // IDN / Chinese domain (punycode)
  match parse_url("https://中文.测试/路径?名=值#锚") {
    Some(u) => {
      debug_assert(u.host.unwrap_or("") == "xn--fiq228c.xn--0zwm56d", "idn host")
      debug_assert(
        url_href(u, false) == "https://xn--fiq228c.xn--0zwm56d/%E8%B7%AF%E5%BE%84?%E5%90%8D=%E5%80%BC#%E9%94%9A",
        "idn href"
      )
    }
    None => debug_assert(false, "idn parse failed")
  }

  // IPv4 octal / hex / shorthand
  match parse_url("http://0x7f.0.0.1/") {
    Some(u) => debug_assert(u.host.unwrap_or("") == "127.0.0.1", "ipv4 hex")
    None => debug_assert(false, "ipv4 hex failed")
  }
  match parse_url("http://2130706433/") {
    Some(u) => debug_assert(u.host.unwrap_or("") == "127.0.0.1", "ipv4 int")
    None => debug_assert(false, "ipv4 int failed")
  }

  // IPv6 compression
  match parse_url("http://[2001:0db8:0000:0000:0000:ff00:0042:8329]/") {
    Some(u) => debug_assert(u.host.unwrap_or("") == "[2001:db8::ff00:42:8329]", "ipv6")
    None => debug_assert(false, "ipv6 failed")
  }

  // Opaque path (mailto)
  match parse_url("mailto:user@example.com?subject=hi") {
    Some(u) => {
      debug_assert(u.host.is_none(), "mailto no host")
      debug_assert(url_path(u, false) == "user@example.com", "mailto path")
      debug_assert(url_origin(u) == "null", "mailto origin")
    }
    None => debug_assert(false, "mailto failed")
  }

  // Invalid URLs
  debug_assert(parse_url("not a url").is_none(), "relative without base")
  debug_assert(parse_url("http://example.com:99999/").is_none(), "port overflow")
  debug_assert(parse_url("http://[invalid]/").is_none(), "bad ipv6")
}

test "relative resolution and setters" {
  debug_assert(
    resolve("https://example.com/a/b/c.html?x=1#y", "../d/e.html") == "https://example.com/a/d/e.html",
    "resolve dotdot"
  )
  debug_assert(
    resolve("https://example.com/a/b", "//cdn.example.com/x.js") == "https://cdn.example.com/x.js",
    "resolve scheme-relative"
  )
  debug_assert(
    resolve("https://example.com/a/b?k=1", "?k=2") == "https://example.com/a/b?k=2",
    "resolve query"
  )
  debug_assert(
    resolve("https://example.com/a/b?k=1", "#top") == "https://example.com/a/b?k=1#top",
    "resolve hash"
  )

  match parse_url("https://example.com/old?a=1#h") {
    Some(u) => {
      url_set(u, "hostname", "sub.example.org")
      url_set(u, "port", "8443")
      url_set(u, "pathname", "/new/path")
      url_set(u, "search", "?k=v")
      url_set(u, "hash", "#end")
      debug_assert(
        url_href(u, false) == "https://sub.example.org:8443/new/path?k=v#end",
        "setters result"
      )
    }
    None => debug_assert(false, "setter base parse failed")
  }
}

test "URLSearchParams" {
  let sp = URLSearchParams::parse("?a=1&b=hello+world&a=2&c=%E4%B8%AD%E6%96%87")
  debug_assert(sp.len() == 4, "len 4")
  debug_assert(sp.get("a").unwrap_or("") == "1", "get a")
  debug_assert(sp.get("b").unwrap_or("") == "hello world", "get b")
  debug_assert(sp.get("c").unwrap_or("") == "中文", "get c")
  debug_assert(!sp.has("missing"), "missing")

  let all_a = sp.get_all("a")
  debug_assert(all_a.length() == 2 && all_a[0] == "1" && all_a[1] == "2", "get_all a")

  sp.set("a", "99")
  debug_assert(sp.get_all("a").length() == 1 && sp.get("a").unwrap_or("") == "99", "set a")
  sp.delete("b")
  debug_assert(!sp.has("b"), "delete b")
  sp.append("k", "x y")
  debug_assert(sp.to_string() == "a=99&c=%E4%B8%AD%E6%96%87&k=x+y", "to_string")
}

///|
test "Wave 90B: url::resolve protocol-relative URL against scheme-less/opaque base does not panic OOB" {
  debug_assert(resolve("about:blank", "//cdn.example.com/a.js") == "https://cdn.example.com/a.js", "about:blank + //host")
  debug_assert(resolve("about:srcdoc", "//cdn.example.com/b.js") == "https://cdn.example.com/b.js", "about:srcdoc + //host")
  debug_assert(resolve("", "//cdn.example.com/c.js") == "https://cdn.example.com/c.js", "empty base + //host")
  debug_assert(resolve("http://a.test/x", "//cdn.example.com/d.js") == "http://cdn.example.com/d.js", "http base + //host preserves http")
}

///|
test "Wave 4: WHATWG url fast-path vs edge-case parity" {
  // Canonical IPv4 + non-default port + default port elision
  match parse_url("http://127.0.0.1:8765/assets/app.js?v=1&k=2#top") {
    Some(u) => {
      debug_assert(u.scheme == "http", "ipv4 scheme")
      debug_assert(u.host.unwrap_or("") == "127.0.0.1", "ipv4 host")
      debug_assert(u.port.unwrap_or(-1) == 8765, "ipv4 port")
      debug_assert(url_href(u, false) == "http://127.0.0.1:8765/assets/app.js?v=1&k=2#top", "ipv4 href")
      debug_assert(url_origin(u) == "http://127.0.0.1:8765", "ipv4 origin")
    }
    None => debug_assert(false, "ipv4 parse failed")
  }
  match parse_url("http://127.0.0.1:80") {
    Some(u) => {
      debug_assert(u.port.is_none(), "http default port 80 elided")
      debug_assert(url_href(u, false) == "http://127.0.0.1/", "empty path gets slash")
    }
    None => debug_assert(false, "http:80 failed")
  }
  match parse_url("https://example.com:443?a=1#b") {
    Some(u) => {
      debug_assert(u.port.is_none(), "https default port 443 elided")
      debug_assert(url_href(u, false) == "https://example.com/?a=1#b", "no-slash query+hash")
    }
    None => debug_assert(false, "https:443?a=1#b failed")
  }

  // Non-canonical IPv4 / invalid IPv4 must fall back properly
  match parse_url("http://0177.0.0.1/") {
    Some(u) => debug_assert(u.host.unwrap_or("") == "127.0.0.1", "octal ipv4 fallback")
    None => debug_assert(false, "octal ipv4 failed")
  }
  debug_assert(parse_url("http://127.0.0.256/").is_none(), "ipv4 octet > 255 invalid")

  // Dot segments and encoded dot segments
  debug_assert(resolve("https://example.com/a/b/c", ".") == "https://example.com/a/b/", "dot")
  debug_assert(resolve("https://example.com/a/b/c", "./") == "https://example.com/a/b/", "dot slash")
  debug_assert(resolve("https://example.com/a/b/c", "..") == "https://example.com/a/", "dotdot")
  debug_assert(resolve("https://example.com/a/b/c", "../") == "https://example.com/a/", "dotdot slash")
  debug_assert(resolve("https://example.com/a/b/c", "../../..") == "https://example.com/", "dotdot root")
  debug_assert(resolve("https://example.com/a/b/c", "/x/./y/../z") == "https://example.com/x/z", "root-rel dots")
  debug_assert(resolve("https://example.com/a/b/c", "/%2e%2e/z") == "https://example.com/z", "encoded dotdot fallback")
  debug_assert(resolve("https://example.com/a/b/c?q=1#f", "") == "https://example.com/a/b/c?q=1", "empty rel drops hash")
  debug_assert(resolve("https://example.com/a/b/c?q=1#f", "?x=2") == "https://example.com/a/b/c?x=2", "query rel")
  debug_assert(resolve("https://example.com/a/b/c?q=1#f", "#h2") == "https://example.com/a/b/c?q=1#h2", "hash rel")
  debug_assert(resolve("https://example.com/a/b/c?q=1#f", "/us") == "https://example.com/us", "root-rel /us")
  debug_assert(resolve("https://example.com/a/b/c?q=1#f", "http:other") == "http://other/", "diff special scheme")
  debug_assert(resolve("https://example.com/a/b/c", "https:other") == "https://example.com/a/b/other", "same https scheme rel")

  // Characters requiring percent-encoding in path / query / fragment
  match parse_url("https://example.com/a b?q='1'&r=<2>#f `3`") {
    Some(u) => {
      debug_assert(
        url_href(u, false) == "https://example.com/a%20b?q=%271%27&r=%3C2%3E#f%20%603%60",
        "percent-encoding fallback",
      )
    }
    None => debug_assert(false, "pct encoding parse failed")
  }

  // url_fields format check (11 U+0001-separated fields)
  match parse_url("https://u:p@example.com:8443/x/y?a=1#h") {
    Some(u) => {
      let sep_b = Bytes::new(1)
      sep_b[0] = (1).to_byte()
      let parts = url_fields(u).split(sep_b.to_string())
      debug_assert(parts.length() == 11, "url_fields has 11 parts")
      debug_assert(parts[0] == "https://u:p@example.com:8443/x/y?a=1#h", "fields[0] href")
      debug_assert(parts[1] == "https:", "fields[1] protocol")
      debug_assert(parts[2] == "u", "fields[2] username")
      debug_assert(parts[3] == "p", "fields[3] password")
      debug_assert(parts[4] == "example.com:8443", "fields[4] host")
      debug_assert(parts[5] == "example.com", "fields[5] hostname")
      debug_assert(parts[6] == "8443", "fields[6] port")
      debug_assert(parts[7] == "/x/y", "fields[7] pathname")
      debug_assert(parts[8] == "?a=1", "fields[8] search")
      debug_assert(parts[9] == "#h", "fields[9] hash")
      debug_assert(parts[10] == "https://example.com:8443", "fields[10] origin")
    }
    None => debug_assert(false, "url_fields parse failed")
  }

  // Leading/trailing C0 & whitespace + tabs/newlines stripped
  match parse_url("  https://example.com/a\tb\nc  ") {
    Some(u) => debug_assert(url_href(u, false) == "https://example.com/abc", "trim + strip tab/nl")
    None => debug_assert(false, "trim+tab parse failed")
  }

  // Punycode xn-- label validation still goes through IDNA path
  debug_assert(parse_url("https://xn--invalid---/").is_none(), "invalid punycode rejected")
}
