///| WHATWG `URLSearchParams` (`application/x-www-form-urlencoded`).

pub struct SearchParam {
  pub name : String
  pub value : String
}

pub struct URLSearchParams {
  mut entries : Array[SearchParam]
}

fn form_hex_char(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (55 + n).unsafe_to_char()
  }
}

fn form_encode_component(s : String) -> String {
  let sb = StringBuilder()
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 32 {
      sb.write_char('+')
    } else if b == 42 ||
    b == 45 ||
    b == 46 ||
    (b >= 48 && b <= 57) ||
    (b >= 65 && b <= 90) ||
    b == 95 ||
    (b >= 97 && b <= 122) {
      sb.write_char(b.unsafe_to_char())
    } else {
      sb.write_char('%')
      sb.write_char(form_hex_char((b >> 4) & 15))
      sb.write_char(form_hex_char(b & 15))
    }
    i = i + 1
  }
  sb.to_string()
}

fn form_decode_component(s : String) -> String {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 43 {
      out.push(32)
      i = i + 1
    } else if b == 37 && i + 2 < n {
      let h1 = data_hex_val(s.code_unit_at(i + 1))
      let h2 = data_hex_val(s.code_unit_at(i + 2))
      if h1 >= 0 && h2 >= 0 {
        out.push(h1 * 16 + h2)
        i = i + 3
        continue
      }
      out.push(b)
      i = i + 1
    } else {
      out.push(b)
      i = i + 1
    }
  }
  let raw = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    raw[k] = out[k].to_byte()
    k = k + 1
  }
  raw.to_string()
}

pub fn URLSearchParams::new() -> URLSearchParams {
  URLSearchParams::{ entries: [] }
}

pub fn URLSearchParams::parse(input : String) -> URLSearchParams {
  let s = if input.starts_with("?") {
    input.slice(1, input.length())
  } else {
    input
  }
  let entries : Array[SearchParam] = []
  if s.length() == 0 {
    return URLSearchParams::{ entries: entries }
  }
  let parts = s.split("&")
  let mut i = 0
  while i < parts.length() {
    let part = parts[i]
    if part.length() > 0 {
      let eq = part.index_of("=")
      if eq >= 0 {
        let k = form_decode_component(part.slice(0, eq))
        let v = form_decode_component(part.slice(eq + 1, part.length()))
        entries.push(SearchParam::{ name: k, value: v })
      } else {
        entries.push(SearchParam::{
          name: form_decode_component(part),
          value: "",
        })
      }
    }
    i = i + 1
  }
  URLSearchParams::{ entries: entries }
}

pub fn URLSearchParams::len(self : URLSearchParams) -> Int {
  self.entries.length()
}

pub fn URLSearchParams::append(
  self : URLSearchParams,
  name : String,
  value : String,
) -> Unit {
  self.entries.push(SearchParam::{ name: name, value: value })
}

pub fn URLSearchParams::get(
  self : URLSearchParams,
  name : String,
) -> Option[String] {
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].name == name {
      return Some(self.entries[i].value)
    }
    i = i + 1
  }
  None
}

pub fn URLSearchParams::get_all(
  self : URLSearchParams,
  name : String,
) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].name == name {
      out.push(self.entries[i].value)
    }
    i = i + 1
  }
  out
}

pub fn URLSearchParams::has(self : URLSearchParams, name : String) -> Bool {
  self.get(name).is_some()
}

pub fn URLSearchParams::set(
  self : URLSearchParams,
  name : String,
  value : String,
) -> Unit {
  let next : Array[SearchParam] = []
  let mut replaced = false
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].name == name {
      if !replaced {
        next.push(SearchParam::{ name: name, value: value })
        replaced = true
      }
    } else {
      next.push(self.entries[i])
    }
    i = i + 1
  }
  if !replaced {
    next.push(SearchParam::{ name: name, value: value })
  }
  self.entries = next
}

pub fn URLSearchParams::delete(self : URLSearchParams, name : String) -> Unit {
  let next : Array[SearchParam] = []
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].name != name {
      next.push(self.entries[i])
    }
    i = i + 1
  }
  self.entries = next
}

pub fn URLSearchParams::to_string(self : URLSearchParams) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < self.entries.length() {
    if i > 0 {
      sb.write_char('&')
    }
    sb.write_string(form_encode_component(self.entries[i].name))
    sb.write_char('=')
    sb.write_string(form_encode_component(self.entries[i].value))
    i = i + 1
  }
  sb.to_string()
}
