///| RFC 2397 / Fetch standard `data:` URL byte decoder.
///| 1:1 port of `client/src/url/data.mbt`.

fn data_hex_val(b : Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 97 && b <= 102 {
    b - 87
  } else if b >= 65 && b <= 70 {
    b - 55
  } else {
    -1
  }
}

fn percent_decoded(raw : Bytes) -> Bytes {
  let out : Array[Int] = []
  let n = raw.length()
  let mut i = 0
  while i < n {
    let b = raw[i].to_int()
    if b == 37 && i + 2 < n {
      let h1 = data_hex_val(raw[i + 1].to_int())
      let h2 = data_hex_val(raw[i + 2].to_int())
      if h1 >= 0 && h2 >= 0 {
        out.push(h1 * 16 + h2)
        i = i + 3
        continue
      }
    }
    out.push(b)
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k].to_byte()
    k = k + 1
  }
  res
}

fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let b = Bytes::new(n)
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      b[i] = (c + 32).to_byte()
    } else {
      b[i] = c.to_byte()
    }
    i = i + 1
  }
  b.to_string()
}

fn rev_find_byte(s : String, target : Int) -> Int {
  let mut i = s.length() - 1
  while i >= 0 {
    if s.code_unit_at(i) == target {
      return i
    }
    i = i - 1
  }
  -1
}

/// Decodes a `data:` URL's payload bytes (percent-decoded, plus base64 if `;base64`).
/// Returns `None` if `u` is not a `data:` URL or has no comma.
pub fn data_url_bytes(u : String) -> Option[Bytes] {
  if u.length() < 5 || ascii_lower(u.slice(0, 5)) != "data:" {
    return None
  }
  let comma = u.index_of(",")
  if comma < 0 {
    return None
  }
  let head = ascii_lower(u.slice(5, comma).trim())
  let body = percent_decoded(u.slice(comma + 1, u.length()).to_bytes())
  let semi = rev_find_byte(head, 59) // ';'
  let base64 = if semi >= 0 {
    head.slice(semi + 1, head.length()).trim() == "base64"
  } else {
    false
  }
  if !base64 {
    return Some(body)
  }
  let out : Array[Int] = []
  let mut acc = 0
  let mut bits = 0
  let mut i = 0
  while i < body.length() {
    let c = body[i].to_int()
    let v = if c >= 65 && c <= 90 {
      c - 65
    } else if c >= 97 && c <= 122 {
      c - 97 + 26
    } else if c >= 48 && c <= 57 {
      c - 48 + 52
    } else if c == 43 || c == 45 {
      62
    } else if c == 47 || c == 95 {
      63
    } else {
      -1
    }
    if v >= 0 {
      acc = ((acc << 6) | v) & 0xFFFFFF
      bits = bits + 6
      if bits >= 8 {
        bits = bits - 8
        out.push((acc >> bits) & 255)
      }
    }
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut k = 0
  while k < out.length() {
    res[k] = out[k].to_byte()
    k = k + 1
  }
  Some(res)
}
