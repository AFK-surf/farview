fn make_wire_el(
  id : Int,
  kind : html::Kind,
  tag : String,
  children : Array[proto::WireNode],
  shadow : Option[proto::WireNode],
) -> proto::WireNode {
  proto::WireNode::{
    id: id,
    kind: kind,
    ns: html::Ns::Html,
    ns_uri: "",
    prefix: "",
    tag: tag,
    attrs: [],
    data: "",
    value: None,
    checked: None,
    src_url: None,
    natural: None,
    quirks: false,
    public_id: None,
    system_id: None,
    defined: false,
    states: 0,
    shadow: shadow,
    children: children,
  }
}

test "doc: node_of_uid O(1) lookup across root, children, shadow, frames and removals (ported from doc_wbtest.mbt)" {
  let doc = Doc::new()
  let leaf = make_wire_el(4, html::Kind::Element, "span", [], None)
  let shadow_child = make_wire_el(6, html::Kind::Element, "em", [], None)
  let shadow_root = make_wire_el(5, html::Kind::Fragment, "", [shadow_child], None)
  let body = make_wire_el(3, html::Kind::Element, "body", [leaf], Some(shadow_root))
  let html_el = make_wire_el(2, html::Kind::Element, "html", [body], None)
  let root = make_wire_el(1, html::Kind::Document, "", [html_el], None)
  let frame_p = make_wire_el(11, html::Kind::Element, "p", [], None)
  let frame_doc = make_wire_el(10, html::Kind::Document, "", [frame_p], None)
  let wire_doc = proto::WireDoc::{
    base: "http://example.test/",
    target: "",
    root: root,
    sheets: [],
    cssom: [],
    frames: [proto::WireFrame::{ iframe: 4, url: "http://example.test/f", root: frame_doc }],
  }
  doc.reset(wire_doc)
  let ids : Array[Int] = [1, 2, 3, 4, 5, 6, 10, 11]
  let mut i = 0
  while i < ids.length() {
    match doc.node(ids[i]) {
      Some(n) => {
        match doc.node_of_uid(n.uid) {
          Some(f) => debug_assert(f.uid == n.uid, "uid matches")
          None => debug_assert(false, "node_of_uid missing")
        }
      }
      None => debug_assert(false, "node missing")
    }
    i = i + 1
  }
  let span_uid = match doc.node(4) {
    Some(n) => n.uid
    None => -1
  }
  doc.patch([proto::PatchOp::Remove(3, 4)])
  debug_assert(doc.node_of_uid(span_uid).is_none(), "removed span gone from by_uid")
  debug_assert(doc.node(4).is_none(), "removed span gone from by_wire")

  let p_uid = match doc.node(11) {
    Some(n) => n.uid
    None => -1
  }
  doc.patch([proto::PatchOp::SetFrame(4, None)])
  debug_assert(doc.node_of_uid(p_uid).is_none(), "cleared frame gone from by_uid")
  debug_assert(doc.frame_of(4).is_none(), "frame cleared")
}

test "doc: SetShadow bumps tree_changes (ported from doc_wbtest.mbt)" {
  let doc = Doc::new()
  let host = make_wire_el(4, html::Kind::Element, "div", [], None)
  let body = make_wire_el(3, html::Kind::Element, "body", [host], None)
  let html_el = make_wire_el(2, html::Kind::Element, "html", [body], None)
  let root = make_wire_el(1, html::Kind::Document, "", [html_el], None)
  doc.reset(proto::WireDoc::{
    base: "http://example.test/",
    target: "",
    root: root,
    sheets: [],
    cssom: [],
    frames: [],
  })
  let shadow_child = make_wire_el(6, html::Kind::Element, "span", [], None)
  let shadow_root = make_wire_el(5, html::Kind::Fragment, "", [shadow_child], None)
  let tc_before = html::tree_changes_count()
  doc.patch([proto::PatchOp::SetShadow(4, Some(shadow_root))])
  debug_assert(html::tree_changes_count() > tc_before, "tree_changes bumped")
  debug_assert(doc.node(6).is_some(), "shadow child indexed")
}

test "doc + mirror + proto end-to-end incremental sync roundtrip" {
  let host_doc = html::parse("<!DOCTYPE html><html><body><div id='a'>hello</div><input value='x'></body></html>")
  let mirror = Mirror::new()
  let st1 = DocState::{
    base: "https://example.test/p/",
    root: host_doc,
    frames: [],
    sheets: [("https://example.test/a.css", "div{color:red}")],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "a",
  }
  let wdoc = mirror.reset(st1)
  // Encode -> Decode over binary wire protocol
  let framed = proto::encode_host(proto::HostMsg::Reset(1, 0, wdoc))
  let framer = proto::Framer::new()
  framer.push(framed)
  let client_doc = Doc::new()
  match framer.next() {
    Some(body) => {
      match proto::decode_host(body) {
        Some(proto::HostMsg::Reset(_, _, decoded_wdoc)) => client_doc.reset(decoded_wdoc)
        _ => debug_assert(false, "expected Reset")
      }
    }
    None => debug_assert(false, "framer empty")
  }
  debug_assert(client_doc.base() == "https://example.test/p/", "base synced")
  debug_assert(client_doc.target() == "a", "target synced")
  debug_assert(client_doc.sheet("https://example.test/a.css").unwrap_or("") == "div{color:red}", "sheet synced")
  debug_assert(client_doc.resolve_url("../b.css") == "https://example.test/b.css", "resolve_url")

  // Mutate host DOM: append new <p>world</p>, update sheet, set Validation
  let body_node = host_doc.children[1].children[1]
  let p_el = html::Node::element(html::Ns::Html, "p", [html::Attr::new("", "class", "new", "")])
  p_el.append(html::Node::text("world"))
  body_node.append(p_el)

  let st2 = DocState::{
    base: "https://example.test/p/",
    root: host_doc,
    frames: [],
    sheets: [("https://example.test/a.css", "div{color:blue}")],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "b",
  }
  let ops = match mirror.diff(st2) {
    Some(o) => o
    None => []
  }
  debug_assert(ops.length() >= 3, "at least insert + sheet + target")
  ops.push(proto::PatchOp::Validation(p_el.uid, "Required"))
  let framed2 = proto::encode_host(proto::HostMsg::Patch(2, 1, ops))
  framer.push(framed2)
  match framer.next() {
    Some(body) => {
      match proto::decode_host(body) {
        Some(proto::HostMsg::Patch(_, _, decoded_ops)) => client_doc.patch(decoded_ops)
        _ => debug_assert(false, "expected Patch")
      }
    }
    None => debug_assert(false, "framer empty 2")
  }
  debug_assert(client_doc.target() == "b", "target updated")
  debug_assert(client_doc.sheet("https://example.test/a.css").unwrap_or("") == "div{color:blue}", "sheet updated")
  debug_assert(client_doc.node(p_el.uid).is_some(), "inserted p synced")
  let (vid, vmsg) = client_doc.validation_state()
  debug_assert(vid == p_el.uid && vmsg == "Required", "validation synced")

  // Verify client DOM matches host DOM html5lib dump
  let client_root = match client_doc.root() {
    Some(r) => r
    None => host_doc
  }
  debug_assert(html::dump(client_root) == html::dump(host_doc), "client DOM dump matches host DOM")
  html::cut(host_doc)
}

test "doc: SetAttrs invalidates class_bloom so has_class updates immediately" {
  let doc = Doc::new()
  let item = make_wire_el(4, html::Kind::Element, "li", [], None)
  let body = make_wire_el(3, html::Kind::Element, "body", [item], None)
  let html_el = make_wire_el(2, html::Kind::Element, "html", [body], None)
  let root = make_wire_el(1, html::Kind::Document, "", [html_el], None)
  doc.reset(proto::WireDoc::{
    base: "http://example.test/",
    target: "",
    root: root,
    sheets: [],
    cssom: [],
    frames: [],
  })
  let n = match doc.node(4) {
    Some(x) => x
    None => { debug_assert(false, "item node missing"); return }
  }
  // Populate class_bloom cache before SetAttrs
  debug_assert(!n.has_class("completed"), "initially not completed")
  doc.patch([proto::PatchOp::SetAttrs(4, [html::Attr::new("", "class", "todo completed", "")])])
  debug_assert(n.has_class("completed"), "has_class sees completed after SetAttrs")
  debug_assert(n.has_class("todo"), "has_class sees todo after SetAttrs")
  doc.patch([proto::PatchOp::SetAttrs(4, [html::Attr::new("", "class", "todo", "")])])
  debug_assert(!n.has_class("completed"), "has_class clears completed after SetAttrs")
  debug_assert(n.has_class("todo"), "has_class keeps todo after SetAttrs")
}

test "anim: color interpolation uses premultiplied alpha so white to transparent stays white" {
  let from = css::tokenize("rgba(255, 255, 255, 1)")
  let to = css::tokenize("rgba(0, 0, 0, 0)")
  let mid = interp_value("background-color", from, to, 0.5)
  match css::parse_color(mid, 0) {
    Some(c) => {
      debug_assert(c.r == 255 && c.g == 255 && c.b == 255, "premultiplied white->transparent midpoint must keep RGB=(255,255,255), got (" + c.r.to_string() + "," + c.g.to_string() + "," + c.b.to_string() + ")")
      debug_assert((c.a - 0.5).abs() < 0.02, "midpoint alpha must be ~0.5, got " + c.a.to_string())
    }
    None => debug_assert(false, "interpolated color must parse")
  }
}

test "Wave 63B: CSS Animations 1 §4.2 applies easing per keyframe segment so staggered negative-delay carousel shows only 1 logo" {
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet(
    "@keyframes cycle { 0%, 22.813% { opacity: 1; } 25% { opacity: 0; } 25.001%, 97.813% { opacity: 0; } 100% { opacity: 1; } }",
  )
  let kfs = match e.keyframes_named("cycle") {
    Some(k) => k
    None => { debug_assert(false, "cycle keyframes missing"); return }
  }
  let dom = html::parse("<!doctype html><html><body><div></div></body></html>")
  let base = match e.style_of(dom.children[1].children[1].children[0], None) {
    Some(s) => s
    None => { debug_assert(false, "base style missing"); return }
  }
  let easing = AnimEasing::Cubic(0.65, 0.0, 0.35, 1.0)
  let delays = [-3000.0, -7000.0, -11000.0, -15000.0]
  let mut visible = 0
  let mut i = 0
  while i < delays.length() {
    let tr = AnimTrack::{
      name: "cycle",
      start_ms: 0.0,
      dur_ms: 16000.0,
      delay_ms: delays[i],
      iterations: -1.0,
      direction: "normal",
      fill_mode: "none",
      easing: easing,
      paused: false,
      pause_ms: 0.0,
    }
    let p = match anim_progress(tr, 0.0) {
      Some(v) => v
      None => { debug_assert(false, "expected Some progress"); return }
    }
    let expected_p = (-delays[i]) / 16000.0
    debug_assert((p - expected_p).abs() < 1.0e-6, "anim_progress must be linear iteration progress, got " + p.to_string() + " vs " + expected_p.to_string())
    let kvs = sample_keyframes(kfs, base, p, easing)
    let mut op = 1.0
    for kv in kvs {
      if kv.0 == "opacity" {
        op = parse_opacity_toks(kv.1)
      }
    }
    if i == 0 {
      debug_assert((op - 1.0).abs() < 0.01, "active item (delay -3s, p=0.1875) must have opacity 1, got " + op.to_string())
      visible += 1
    } else {
      debug_assert(op < 0.01, "inactive item " + i.to_string() + " must have opacity 0, got " + op.to_string())
    }
    i += 1
  }
  debug_assert(visible == 1, "exactly 1 item visible")
  html::cut(dom)
}

test "Wave 78B: Mirror syncs DocState.anim_style to client via SetAttrs without mutating host DOM" {
  let host_doc = html::parse("<!doctype html><html><body><div id='a' style='color:red'>hi</div><div id='b'>bd</div></body></html>")
  let body = host_doc.children[1].children[1]
  let div_a = body.children[0]
  let div_b = body.children[1]
  let mirror = Mirror::new()
  let st_init = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(n : html::Node) -> String {
      if n.uid == div_b.uid { "opacity:0;" } else { "" }
    },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.reset(mirror.reset(st_init))
  let cb = match client_doc.node(div_b.uid) {
    Some(n) => n
    None => { debug_assert(false, "client div_b missing"); return }
  }
  let ca = match client_doc.node(div_a.uid) {
    Some(n) => n
    None => { debug_assert(false, "client div_a missing"); return }
  }
  debug_assert(cb.attr("style").unwrap_or("") == "opacity:0;", "initial anim_style must sync on reset")
  debug_assert(ca.attr("style").unwrap_or("") == "color:red", "unaffected element keeps original style")
  debug_assert(div_b.attr("style").is_none(), "host DOM div_b must not be mutated")

  // Diff: apply anim_style to div_a (with existing style) and clear div_b
  let st_next = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(n : html::Node) -> String {
      if n.uid == div_a.uid { "opacity:0;visibility:hidden;" } else { "" }
    },
    target: "",
  }
  let ops = match mirror.diff(st_next) {
    Some(o) => o
    None => { debug_assert(false, "expected diff ops"); return }
  }
  client_doc.patch(ops)
  debug_assert(ca.attr("style").unwrap_or("") == "color:red;opacity:0;visibility:hidden;", "merged anim_style must sync on diff")
  debug_assert(cb.attr("style").is_none(), "cleared anim_style must remove synthesized style attr on client")
  debug_assert(div_a.attr("style").unwrap_or("") == "color:red", "host DOM div_a must remain unmutated")
  html::cut(host_doc)
}

///|
test "Wave 27C: Doc::apply SetForm invalidates box reuse and style cache so KeptCache repaints checked and value" {
  let host_doc = html::parse(
    "<!doctype html><html><head><style>input:checked{opacity:0.5}</style></head><body style='margin:0'>" +
    "<input id='cb' type='checkbox'>" +
    "<input id='oct' type='text' placeholder='0666'>" +
    "</body></html>",
  )
  let walk_id = fn(root : html::Node, target : String) -> Option[html::Node] {
    let st : Array[html::Node] = [root]
    while st.length() > 0 {
      match st.pop() {
        Some(n) => {
          if n.attr("id").unwrap_or("") == target { return Some(n) }
          for c in n.children { st.push(c) }
        }
        None => ()
      }
    }
    None
  }
  let cb = match walk_id(host_doc, "cb") {
    Some(n) => n
    None => { debug_assert(false, "cb missing"); return }
  }
  let oct = match walk_id(host_doc, "oct") {
    Some(n) => n
    None => { debug_assert(false, "oct missing"); return }
  }
  let mirror = Mirror::new()
  let st = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc.reset(mirror.reset(st))
  let find_box = fn(root : layout::Box, id_val : String) -> Option[layout::Box] {
    let q : Array[layout::Box] = [root]
    while q.length() > 0 {
      match q.pop() {
        Some(b) => {
          match b.node {
            Some(n) if n.attr("id").unwrap_or("") == id_val => return Some(b)
            _ => ()
          }
          for c in b.children { q.push(c) }
        }
        None => ()
      }
    }
    None
  }
  let r1 = match client_doc.layout(600.0, 400.0) {
    Some(b) => b
    None => { debug_assert(false, "frame 1 layout missing"); return }
  }
  let cb_b1 = match find_box(r1, "cb") { Some(b) => b None => { debug_assert(false, "cb box 1"); return } }
  let oct_b1 = match find_box(r1, "oct") { Some(b) => b None => { debug_assert(false, "oct box 1"); return } }
  cb.set_checked(Some(true))
  oct.value = Some("755")
  let ops = match mirror.diff(st) {
    Some(o) => o
    None => { debug_assert(false, "expected SetForm diff ops"); return }
  }
  client_doc.patch(ops)
  let r2 = match client_doc.layout(600.0, 400.0) {
    Some(b) => b
    None => { debug_assert(false, "frame 2 layout missing"); return }
  }
  let cb_b2 = match find_box(r2, "cb") { Some(b) => b None => { debug_assert(false, "cb box 2"); return } }
  let oct_b2 = match find_box(r2, "oct") { Some(b) => b None => { debug_assert(false, "oct box 2"); return } }
  debug_assert(cb_b1.uid != cb_b2.uid, "SetForm checked=true must invalidate box reuse (new Box uid)")
  debug_assert(oct_b1.uid != oct_b2.uid, "SetForm value='755' must invalidate box reuse (new Box uid)")
  debug_assert(cb_b2.style.number("opacity", 1.0) < 0.6, "SetForm checked=true must recompute :checked style")
  html::cut(host_doc)
}

test "Doc syncs :defined / :not(:defined) into css::defined_custom on reset, SetDefined patch, and cleanup" {
  let host_doc = html::parse(
    "<!doctype html><html><head><style>gws-join-meeting:not(:defined){visibility:hidden;height:62px;} gws-join-meeting:defined{visibility:visible;}</style></head><body><gws-join-meeting id='jm'><span>Join</span></gws-join-meeting></body></html>",
  )
  let mut jm_opt : Option[html::Node] = None
  let q : Array[html::Node] = [host_doc]
  while q.length() > 0 {
    match q.pop() {
      Some(n) => {
        if n.kind == html::Kind::Element && n.tag == "gws-join-meeting" {
          jm_opt = Some(n)
          break
        }
        for c in n.children {
          q.push(c)
        }
      }
      None => ()
    }
  }
  let jm = match jm_opt {
    Some(n) => n
    None => {
      debug_assert(false, "gws-join-meeting missing")
      return
    }
  }
  let is_def : Array[Bool] = [false]
  let mirror = Mirror::new()
  let st = DocState::{
    base: "https://workspace.google.com/products/meet/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(n : html::Node) -> Bool { n.uid == jm.uid && is_def[0] },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc.reset(mirror.reset(st))
  let find_box = fn(root : layout::Box, id_val : String) -> Option[layout::Box] {
    let wk : Array[layout::Box] = [root]
    while wk.length() > 0 {
      match wk.pop() {
        Some(b) => {
          match b.node {
            Some(n) if n.attr("id").unwrap_or("") == id_val => return Some(b)
            _ => ()
          }
          for c in b.children {
            wk.push(c)
          }
        }
        None => ()
      }
    }
    None
  }
  // Frame 1: before customElements.define -> :not(:defined) -> visibility: hidden
  let r1 = match client_doc.layout(800.0, 600.0) {
    Some(b) => b
    None => {
      debug_assert(false, "frame 1 layout missing")
      return
    }
  }
  let b1 = match find_box(r1, "jm") {
    Some(b) => b
    None => {
      debug_assert(false, "jm box 1 missing")
      return
    }
  }
  debug_assert(b1.style.word("visibility") == "hidden", "before SetDefined, gws-join-meeting must match :not(:defined)")
  // Frame 2: SetDefined(true) patch -> css::defined_custom updated + style invalidated -> visibility: visible
  is_def[0] = true
  let ops = match mirror.diff(st) {
    Some(o) => o
    None => {
      debug_assert(false, "expected SetDefined diff ops")
      return
    }
  }
  client_doc.patch(ops)
  let r2 = match client_doc.layout(800.0, 600.0) {
    Some(b) => b
    None => {
      debug_assert(false, "frame 2 layout missing")
      return
    }
  }
  let b2 = match find_box(r2, "jm") {
    Some(b) => b
    None => {
      debug_assert(false, "jm box 2 missing")
      return
    }
  }
  debug_assert(b2.style.word("visibility") == "visible", "after SetDefined(true), gws-join-meeting must be visible")
  let client_jm_uid = match b2.node {
    Some(n) => n.uid
    None => 0
  }
  debug_assert(css::defined_custom.contains(client_jm_uid), "css::defined_custom must contain client node uid")
  // Reset clears previous document's css::defined_custom entry (no cross-page leak)
  let empty_doc = html::parse("<!doctype html><html><body></body></html>")
  let empty_st = DocState::{
    base: "about:blank",
    root: empty_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  client_doc.reset(mirror.reset(empty_st))
  debug_assert(!css::defined_custom.contains(client_jm_uid), "Doc::reset must clean up old css::defined_custom entries")
  html::cut(host_doc)
  html::cut(empty_doc)
}

test "paint-only CSS keyframe animation ticks in place without full CSS relayout and bumps ancestor geom" {
  let host_doc = html::parse(
    "<!doctype html><html><head><style>@keyframes pulse { 0% { opacity: 0.2; transform: translateX(0px); } 100% { opacity: 1; transform: translateX(100px); } } .wrap { width: 200px; } .dot { width: 20px; height: 20px; animation: pulse 1000ms linear infinite; }</style></head><body style='margin:0'><div class='wrap'><div id='d' class='dot'></div></div></body></html>",
  )
  let mirror = Mirror::new()
  let st = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc.reset(mirror.reset(st))
  client_doc.set_anim_time(0.0)
  let r0 = match client_doc.layout(800.0, 600.0) {
    Some(b) => b
    None => { debug_assert(false, "initial layout missing"); return }
  }
  let find_box = fn(root : layout::Box, id_val : String) -> Option[layout::Box] {
    let q : Array[layout::Box] = [root]
    while q.length() > 0 {
      match q.pop() {
        Some(b) => {
          match b.node {
            Some(n) if n.attr("id").unwrap_or("") == id_val => return Some(b)
            _ => ()
          }
          for c in b.children { q.push(c) }
        }
        None => ()
      }
    }
    None
  }
  let d0 = match find_box(r0, "d") { Some(b) => b None => { debug_assert(false, "d box missing"); return } }
  let root_geom0 = r0.geom
  let d_uid0 = d0.uid
  let op0 = d0.style.number("opacity", 1.0)
  debug_assert((op0 - 0.2).abs() < 0.05, "t=0 opacity ~0.2, got " + op0.to_string())

  // Advance to t=500ms: paint-only fast path must reuse the same Box uid, update opacity to ~0.6, and bump root.geom
  client_doc.set_anim_time(500.0)
  client_doc.tick_animations()
  let r1 = match client_doc.layout(800.0, 600.0) {
    Some(b) => b
    None => { debug_assert(false, "t=500 layout missing"); return }
  }
  debug_assert(client_doc.anim_fast_tick_count() == 1, "expected 1 paint-only fast tick, got " + client_doc.anim_fast_tick_count().to_string())
  let d1 = match find_box(r1, "d") { Some(b) => b None => { debug_assert(false, "d1 box missing"); return } }
  debug_assert(d1.uid == d_uid0, "paint-only tick must reuse existing Box in place")
  debug_assert(r1.geom != root_geom0, "paint-only tick must bump ancestor geom so KeptCache repaints")
  let op1 = d1.style.number("opacity", 1.0)
  debug_assert((op1 - 0.6).abs() < 0.05, "t=500ms opacity ~0.6, got " + op1.to_string())
  debug_assert(client_doc.has_visible_active_animations(500.0, 0.0, 100.0), "animation at y=0 is visible in [0,100]")
  debug_assert(!client_doc.has_visible_active_animations(500.0, 500.0, 1000.0), "animation at y=0..20 is off-screen for [500,1000]")
  html::cut(host_doc)
}

test "compositor animation fast path ticks transform/opacity without touching layout and falls back on width" {
  let css_comp =
  "@keyframes slide { from { opacity: 0.2; transform: translateX(0px); } to { opacity: 1.0; transform: translateX(100px); } }" +
  "#d { width: 40px; height: 20px; animation: slide 1s linear; }"
  let host_doc = html::parse(
    "<!doctype html><html><head><style>" + css_comp + "</style></head><body><div id='d'>hi</div></body></html>",
  )
  let mirror = Mirror::new()
  let st = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc.reset(mirror.reset(st))
  client_doc.set_anim_time(0.0)
  let r0 = match client_doc.layout(800.0, 600.0) {
    Some(b) => b
    None => { debug_assert(false, "initial layout missing"); return }
  }
  let _ = r0
  debug_assert(client_doc.has_compositor_only_animations(), "transform+opacity keyframe must be compositor-only")
  debug_assert(client_doc.compositor_anim_uids().length() == 1, "expected 1 compositor uid")
  client_doc.set_anim_time(500.0)
  match client_doc.tick_compositor_animations() {
    Some(updates) => {
      debug_assert(updates.length() == 1, "expected 1 updated compositor box")
      debug_assert(client_doc.anim_comp_tick_count() == 1, "expected anim_comp_tick_count == 1")
      let (_, b) = updates[0]
      let op = b.style.number("opacity", 1.0)
      debug_assert((op - 0.6).abs() < 0.05, "t=500ms compositor opacity ~0.6, got " + op.to_string())
      debug_assert(!client_doc.layout_dirty, "compositor tick must not dirty full CSS layout")
    }
    None => debug_assert(false, "tick_compositor_animations returned None for compositor-only animation")
  }
  html::cut(host_doc)

  // Layout-affecting animation (width) must NOT use compositor fast path
  let css_lay =
  "@keyframes grow { from { width: 10px; } to { width: 100px; } }" +
  "#g { width: 10px; height: 20px; animation: grow 1s linear; }"
  let host_doc2 = html::parse(
    "<!doctype html><html><head><style>" + css_lay + "</style></head><body><div id='g'>hi</div></body></html>",
  )
  let mirror2 = Mirror::new()
  let st2 = DocState::{
    base: "https://example.test/",
    root: host_doc2,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc2 = Doc::new()
  client_doc2.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc2.reset(mirror2.reset(st2))
  client_doc2.set_anim_time(0.0)
  let _ = client_doc2.layout(800.0, 600.0)
  debug_assert(!client_doc2.has_compositor_only_animations(), "width keyframe must not be compositor-only")
  client_doc2.set_anim_time(500.0)
  debug_assert(client_doc2.tick_compositor_animations().is_none(), "tick_compositor_animations must return None for width")
  html::cut(host_doc2)
}

fn doc_find_tag(n : html::Node, tag : String) -> Option[html::Node] {
  if n.kind is html::Kind::Element && n.tag == tag {
    return Some(n)
  }
  for c in n.children {
    match doc_find_tag(c, tag) {
      Some(hit) => return Some(hit)
      None => ()
    }
  }
  None
}

fn doc_find_id(n : html::Node, id : String) -> Option[html::Node] {
  if n.kind is html::Kind::Element && n.attr("id").unwrap_or("") == id {
    return Some(n)
  }
  for c in n.children {
    match doc_find_id(c, id) {
      Some(hit) => return Some(hit)
      None => ()
    }
  }
  None
}

test "Wave 5: preload link does not bump sheets_gen, appended style appends incrementally, and JS compositor style patches skip relayout" {
  let host_doc = html::parse(
    "<!doctype html><html><head><style>#box { width: 100px; height: 40px; opacity: 1; }</style></head><body><div id='box' style='transform: translateX(0px); opacity: 1;'>hi</div></body></html>",
  )
  let mirror = Mirror::new()
  let st = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc.reset(mirror.reset(st))
  let _ = client_doc.layout(800.0, 600.0)
  let gen_before = client_doc.sheets_gen()

  // 1. Inserting `<link rel="preload">` must NOT bump sheets_gen_val.
  let head = match doc_find_tag(host_doc, "head") {
    Some(h) => h
    None => {
      debug_assert(false, "missing head")
      host_doc
    }
  }
  let preload = html::Node::new(html::Kind::Element)
  preload.tag = "link"
  preload.push_attr(html::Attr::{ name: "rel", value: "preload", prefix: "", ns: "" })
  preload.push_attr(html::Attr::{ name: "as", value: "script", prefix: "", ns: "" })
  preload.push_attr(html::Attr::{ name: "href", value: "/chunk.js", prefix: "", ns: "" })
  head.append(preload)
  match mirror.diff(st) {
    Some(ops) => client_doc.patch(ops)
    None => ()
  }
  debug_assert(client_doc.sheets_gen() == gen_before, "preload link must not bump sheets_gen")

  // 2. Appending a new `<style>` incrementally applies its rule.
  let extra_style = html::Node::new(html::Kind::Element)
  extra_style.tag = "style"
  let css_txt = html::Node::new(html::Kind::Text)
  css_txt.data = "#box { width: 180px; }"
  extra_style.append(css_txt)
  head.append(extra_style)
  match mirror.diff(st) {
    Some(ops) => client_doc.patch(ops)
    None => ()
  }
  debug_assert(client_doc.sheets_gen() > gen_before, "appended style bumps sheets_gen")
  let host_box = match doc_find_id(host_doc, "box") {
    Some(b) => b
    None => {
      debug_assert(false, "missing #box")
      host_doc
    }
  }
  match (client_doc.layout(800.0, 600.0), client_doc.node(host_box.uid)) {
    (Some(root_box), Some(client_el)) => match layout::box_of(root_box, client_el) {
      Some(bf) => debug_assert((bf.w - 180.0).abs() < 0.5, "incrementally appended style must update #box width to 180px")
      None => debug_assert(false, "missing layout box for #box")
    }
    _ => debug_assert(false, "layout or client #box missing")
  }

  // 3. JS rAF compositor-only style patch promotes on frame 1 and updates in place on frame 2 with zero relayout.
  let ops1 : Array[proto::PatchOp] = [
    proto::PatchOp::SetAttrs(host_box.uid, [
      html::Attr::{ name: "id", value: "box", prefix: "", ns: "" },
      html::Attr::{ name: "style", value: "transform: translateX(10px); opacity: 0.8;", prefix: "", ns: "" },
    ]),
  ]
  let can_up = fn(_uid : Int, _b : layout::Box) -> Bool { true }
  debug_assert(client_doc.try_patch_compositor_styles(ops1, can_up).is_none(), "frame 1 promotes to CompLayer")
  client_doc.patch(ops1)
  let _ = client_doc.layout(800.0, 600.0)
  let ops2 : Array[proto::PatchOp] = [
    proto::PatchOp::SetAttrs(host_box.uid, [
      html::Attr::{ name: "id", value: "box", prefix: "", ns: "" },
      html::Attr::{ name: "style", value: "transform: translateX(25px); opacity: 0.5;", prefix: "", ns: "" },
    ]),
  ]
  match client_doc.try_patch_compositor_styles(ops2, can_up) {
    Some(ups) => debug_assert(ups.length() == 1, "frame 2 compositor fast path must update 1 box in place")
    None => debug_assert(false, "frame 2 compositor fast path returned None")
  }
  let ops3 : Array[proto::PatchOp] = [
    proto::PatchOp::SetAttrs(host_box.uid, [
      html::Attr::{ name: "id", value: "box", prefix: "", ns: "" },
      html::Attr::{ name: "style", value: "transform: translateX(25px); opacity: 0.5; width: 220px;", prefix: "", ns: "" },
    ]),
  ]
  debug_assert(client_doc.try_patch_compositor_styles(ops3, can_up).is_none(), "width change must fall back to full layout")
  html::cut(host_doc)
}

///|
test "hybrid compositor step keeps transform animations on CompLayer beside stepped or hidden non-comp animations" {
  let css_hyb =
  "@keyframes roll { from { transform: translate3d(0px, -20px, 0px); } to { transform: translateZ(0px); } }" +
  "@keyframes sprite { 0% { background-position: 0px 0px; } 50% { background-position: -320px 0px; } 100% { background-position: -640px 0px; } }" +
  "#dm { width: 100px; height: 20px; animation: roll 1s linear infinite; }" +
  "#sp { width: 320px; height: 184px; animation: sprite 1s steps(1) infinite; }" +
  "#wrap { opacity: 0; }" +
  "#hid { width: 50px; height: 50px; animation: sprite 1s linear infinite; }"
  let host_doc = html::parse(
    "<!doctype html><html><head><style>" + css_hyb + "</style></head><body>" +
    "<div id='dm'>dm</div><div id='sp'></div><div id='wrap'><div id='hid'></div></div>" +
    "</body></html>",
  )
  let mirror = Mirror::new()
  let st = DocState::{
    base: "https://example.test/",
    root: host_doc,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let client_doc = Doc::new()
  client_doc.fonts_opt = Some(layout::Fonts::new_portable([], []))
  client_doc.reset(mirror.reset(st))
  client_doc.set_anim_time(0.0)
  let _ = client_doc.layout(800.0, 600.0)
  // Per-element promotion: #dm is promoted even though #sp/#hid are non-compositor
  debug_assert(client_doc.compositor_anim_uids().length() == 1, "expected 1 promoted comp uid (#dm), got " + client_doc.compositor_anim_uids().length().to_string())
  // At t=100ms: #sp (steps(1)) has same background-position as t=0, #hid is under opacity:0 -> hybrid step succeeds!
  client_doc.set_anim_time(100.0)
  match client_doc.tick_compositor_step() {
    Some(ups) => {
      debug_assert(ups.length() == 1, "expected 1 compositor update (#dm) at t=100ms")
      let tf_toks = ups[0].1.style.get("transform")
      let is_t3d = tf_toks.length() > 0 && match tf_toks[0] { css::Tok::Function(nm) => nm == "translate3d" _ => false }
      debug_assert(is_t3d, "translate3d <-> translateZ must interpolate via translate3d")
    }
    None => debug_assert(false, "tick_compositor_step must succeed while stepped non-comp animation is unchanged")
  }
  // At t=600ms: #sp crossed the 50% step boundary -> hybrid step falls back to paint tick
  client_doc.set_anim_time(600.0)
  debug_assert(client_doc.tick_compositor_step().is_none(), "tick_compositor_step must fall back when stepped non-comp value changes")
  // Scroll-safe layer-only tick still updates #dm smoothly
  match client_doc.tick_compositor_layers_only() {
    Some(ups) => debug_assert(ups.length() == 1, "tick_compositor_layers_only must still update #dm during scroll")
    None => debug_assert(false, "tick_compositor_layers_only returned None")
  }
  html::cut(host_doc)
}

///|
test "anim_anc_hidden counterexamples: animated opacity ancestor and layout-affecting hidden animation must not skip" {
  // P1-1: modal fades opacity 0 -> 1 while child animates background-color; child must NOT be marked hidden
  let css_fade =
  "@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }" +
  "@keyframes spin { from { background-color: rgb(255, 0, 0); } to { background-color: rgb(0, 0, 255); } }" +
  "#modal { animation: fadeIn 1s linear; }" +
  "#sp { width: 40px; height: 40px; animation: spin 1s linear infinite; }"
  let doc1 = html::parse("<!doctype html><html><head><style>" + css_fade + "</style></head><body><div id='modal'><div id='sp'></div></div></body></html>")
  let mirror1 = Mirror::new()
  let st1 = DocState::{
    base: "https://example.test/",
    root: doc1,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let cdoc1 = Doc::new()
  cdoc1.fonts_opt = Some(layout::Fonts::new_portable([], []))
  cdoc1.reset(mirror1.reset(st1))
  cdoc1.set_anim_time(0.0)
  let _ = cdoc1.layout(800.0, 600.0)
  cdoc1.set_anim_time(250.0)
  debug_assert(cdoc1.tick_compositor_step().is_none(), "child under animated opacity:0->1 ancestor must NOT be skipped")
  html::cut(doc1)

  // P1-2: hidden element animating layout property (width) affects siblings and must NOT be skipped
  let css_lay =
  "@keyframes grow { from { width: 10px; } to { width: 100px; } }" +
  "#wrap { opacity: 0; }" +
  "#w { height: 20px; animation: grow 1s linear infinite; }"
  let doc2 = html::parse("<!doctype html><html><head><style>" + css_lay + "</style></head><body><div id='wrap'><div id='w'></div></div></body></html>")
  let mirror2 = Mirror::new()
  let st2 = DocState::{
    base: "https://example.test/",
    root: doc2,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let cdoc2 = Doc::new()
  cdoc2.fonts_opt = Some(layout::Fonts::new_portable([], []))
  cdoc2.reset(mirror2.reset(st2))
  cdoc2.set_anim_time(0.0)
  let _ = cdoc2.layout(800.0, 600.0)
  cdoc2.set_anim_time(250.0)
  debug_assert(cdoc2.tick_compositor_step().is_none(), "hidden layout-affecting animation (width) must NOT be skipped")
  html::cut(doc2)
}
