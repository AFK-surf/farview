///| Client-side synchronized document model (`Doc::reset`, `Doc::patch`, `Doc::apply`).
///| 1:1 port of the DOM/sync core of `client/src/doc/doc.mbt` (layout/css hooks plug in at P2/P3).

import "html"
import "proto"
import "url"
import "intmap"
import "css"
import "layout"

pub struct Frame {
  pub url : String
  pub root : html::Node
  reuse : layout::Reuse
  mut engine : Option[css::Engine]
  mut key : String
  mut size : (Double, Double)
  mut box_node : Option[layout::Box]
  mut dirty : Bool
}

pub struct RenderedInfo {
  pub key : String
  pub width : Double
  pub height : Double
}

pub struct Doc {
  by_wire : intmap::IntMap[html::Node]
  by_uid : intmap::IntMap[html::Node]
  sentinel : html::Node
  mut root_node : Option[html::Node]
  mut base_url : String
  mut sheets : Map[String, String]
  cssom : intmap::IntMap[String]
  frames : intmap::IntMap[Frame]
  mut target_id : String
  rendered : intmap::IntMap[RenderedInfo]
  font_files : Map[String, Bytes]
  defined_custom : intmap::IntMap[Bool]
  element_states : intmap::IntMap[Int]
  mut sheets_gen_val : Int
  mut fonts_gen_val : Int
  mut layout_dirty : Bool
  mut last_font_faces : Int
  mut lang_dirty : Bool
  mut hover_chain : Array[html::Node]
  mut active_chain : Array[html::Node]
  mut focus_wire_id : Int
  mut validation_wire_id : Int
  mut validation_msg : String
  mut fonts_opt : Option[layout::Fonts]
  mut engine : Option[css::Engine]
  mut engine_key : String
  mut engine_sheets : Array[(Int, String, String)]
  mut engine_adopted : String
  mut engine_quirks : Bool
  mut engine_has_imports : Bool
  mut web_fonts_gen : Int
  mut cached_lang : String
  reuse : layout::Reuse
  mut box_node : Option[layout::Box]
  cq : intmap::IntMap[(Double, Double)]
  mut anim_on : Bool
  mut anim_ms : Double
  anims : Map[Int, Array[AnimTrack]]
  trans : Map[Int, Map[String, TransTrack]]
  prev_vals : Map[Int, Map[String, Array[css::Tok]]]
  prev_style_uid : intmap::IntMap[Int]
  anim_tracked : intmap::IntMap[Bool]
  anim_nodes : Map[Int, html::Node]
  anim_boxes : Map[Int, (layout::Box, css::Style)]
  anim_ancestors : Array[layout::Box]
  js_comp_uids : intmap::IntMap[Bool]
  js_comp_boxes : Map[Int, (layout::Box, Array[layout::Box])]
  mut anim_paint_only : Bool
  mut anim_comp_only : Bool
  mut anim_tick_only : Bool
  mut anim_fast_ticks : Int
  mut anim_comp_ticks : Int
}

pub fn Doc::new() -> Doc {
  Doc::{
    by_wire: intmap::IntMap::new(),
    by_uid: intmap::IntMap::new(),
    sentinel: html::Node::new(html::Kind::Document),
    root_node: None,
    base_url: "",
    sheets: Map::new(),
    cssom: intmap::IntMap::new(),
    frames: intmap::IntMap::new(),
    target_id: "",
    rendered: intmap::IntMap::new(),
    font_files: Map::new(),
    defined_custom: intmap::IntMap::new(),
    element_states: intmap::IntMap::new(),
    sheets_gen_val: 0,
    fonts_gen_val: 0,
    layout_dirty: true,
    last_font_faces: -1,
    lang_dirty: true,
    hover_chain: [],
    active_chain: [],
    focus_wire_id: 0,
    validation_wire_id: 0,
    validation_msg: "",
    fonts_opt: None,
    engine: None,
    engine_key: "",
    engine_sheets: [],
    engine_adopted: "",
    engine_quirks: false,
    engine_has_imports: false,
    web_fonts_gen: -1,
    cached_lang: "",
    reuse: layout::Reuse::new(),
    box_node: None,
    cq: intmap::IntMap::new(),
    anim_on: false,
    anim_ms: 0.0,
    anims: Map::new(),
    trans: Map::new(),
    prev_vals: Map::new(),
    prev_style_uid: intmap::IntMap::new(),
    anim_tracked: intmap::IntMap::new(),
    anim_nodes: Map::new(),
    anim_boxes: Map::new(),
    anim_ancestors: [],
    js_comp_uids: intmap::IntMap::new(),
    js_comp_boxes: Map::new(),
    anim_paint_only: false,
    anim_comp_only: false,
    anim_tick_only: false,
    anim_fast_ticks: 0,
    anim_comp_ticks: 0,
  }
}

pub fn Doc::new_with_fonts(fonts : layout::Fonts) -> Doc {
  let d = Doc::new()
  d.fonts_opt = Some(fonts)
  d
}

pub fn Doc::root(self : Doc) -> Option[html::Node] {
  self.root_node
}

/// O(1) lookup by host wire id.
/// Uses `contains` + `get_or` to avoid pionc2's cross-package generic `Option[V]` ABI bug.
pub fn Doc::node(self : Doc, id : Int) -> Option[html::Node] {
  if self.by_wire.contains(id) {
    Some(self.by_wire.get_or(id, self.sentinel))
  } else {
    None
  }
}

/// O(1) lookup by local node uid.
pub fn Doc::node_of_uid(self : Doc, uid : Int) -> Option[html::Node] {
  if self.by_uid.contains(uid) {
    Some(self.by_uid.get_or(uid, self.sentinel))
  } else {
    None
  }
}

pub fn Doc::base(self : Doc) -> String {
  self.base_url
}

pub fn Doc::target(self : Doc) -> String {
  self.target_id
}

pub fn Doc::sheets_gen(self : Doc) -> Int {
  self.sheets_gen_val
}

pub fn Doc::sheet(self : Doc, u : String) -> Option[String] {
  self.sheets.get(u)
}

pub fn Doc::cssom_of(self : Doc, wire_id : Int) -> Option[String] {
  if self.cssom.contains(wire_id) {
    Some(self.cssom.get_or(wire_id, ""))
  } else {
    None
  }
}

pub fn Doc::frame_of(self : Doc, iframe_wire_id : Int) -> Option[Frame] {
  if self.frames.contains(iframe_wire_id) {
    let empty_fr = Frame::{
      url: "",
      root: self.sentinel,
      reuse: layout::Reuse::new(),
      engine: None,
      key: "",
      size: (0.0, 0.0),
      box_node: None,
      dirty: true,
    }
    Some(self.frames.get_or(iframe_wire_id, empty_fr))
  } else {
    None
  }
}

///| The address what `n` says is resolved against: its frame's document's (the frame's address, or the `<base href>`
///| in it), where it is in a frame's document; else the page's base.
pub fn Doc::base_of(self : Doc, n : html::Node) -> String {
  let mut top = n
  while true {
    match top.parent {
      Some(p) => top = p
      None => break
    }
  }
  for k in self.frames.keys() {
    match intmap::get(self.frames, k) {
      // (a srcdoc or about:blank frame's base is its parent's, as HTML says)
      Some(f) if f.root.uid == top.uid => return frame_base(f.root, if f.url == "" || f.url.starts_with("about:") { self.base_url } else { f.url })
      _ => ()
    }
  }
  self.base_url
}

///| A frame's document's base: its first `<base href>`, resolved against its address, else its address.
fn frame_base(root : html::Node, at : String) -> String {
  let stack : Array[html::Node] = [root]
  while stack.length() > 0 {
    let x = match stack.pop() {
      Some(v) => v
      None => break
    }
    if x.kind is html::Kind::Element && x.tag == "base" {
      match x.attr("href") {
        Some(h) if h.trim() != "" => return url::resolve(at, h.trim())
        _ => ()
      }
    }
    if x.kind is html::Kind::Element && x.tag == "body" {
      continue
    }
    let mut i = x.children.length() - 1
    while i >= 0 {
      stack.push(x.children[i])
      i -= 1
    }
  }
  at
}

pub fn Doc::defined_of(self : Doc, uid : Int) -> Bool {
  self.defined_custom.get_or(uid, false)
}

pub fn Doc::states_of(self : Doc, uid : Int) -> Int {
  self.element_states.get_or(uid, 0)
}

///| The element the page's focus is on, as the host says (its state 4, :focus), if any is.
pub fn Doc::focused(self : Doc) -> Option[html::Node] {
  for uid in self.element_states.keys() {
    if (self.element_states.get_or(uid, 0) & 4) != 0 {
      match self.node_of_uid(uid) {
        Some(n) => return Some(n)
        None => ()
      }
    }
  }
  None
}

///| The element shown fullscreen by the page (state 128, `:fullscreen`), if any: its uid. Only elements with a
///| state are looked at (a handful), never the tree.
pub fn Doc::fullscreen_uid(self : Doc) -> Option[Int] {
  for uid in self.element_states.keys() {
    if (self.element_states.get_or(uid, 0) & 128) != 0 {
      return Some(uid)
    }
  }
  None
}

pub fn Doc::rendered_of(self : Doc, wire_id : Int) -> Option[RenderedInfo] {
  if self.rendered.contains(wire_id) {
    let empty_r = RenderedInfo::{ key: "", width: 0.0, height: 0.0 }
    Some(self.rendered.get_or(wire_id, empty_r))
  } else {
    None
  }
}

pub fn Doc::resolve_url(self : Doc, rel : String) -> String {
  url::resolve(self.base_url, rel)
}

pub fn Doc::add_font_file(self : Doc, u : String, data : Bytes) -> Unit {
  self.font_files.set(u, data)
  self.fonts_gen_val = self.fonts_gen_val + 1
  self.layout_dirty = true
}

pub fn Doc::font_file(self : Doc, u : String) -> Option[Bytes] {
  match self.font_files.get(u) {
    Some(d) => Some(d)
    None => {
      if u.starts_with("data:") {
        match url::data_url_bytes(u) {
          Some(d) => {
            if d.length() > 0 {
              self.font_files.set(u, d)
              Some(d)
            } else {
              None
            }
          }
          None => None
        }
      } else {
        None
      }
    }
  }
}

fn Doc::build(self : Doc, w : proto::WireNode) -> html::Node {
  let attrs_copy : Array[html::Attr] = []
  let mut i = 0
  while i < w.attrs.length() {
    let a = w.attrs[i]
    attrs_copy.push(html::Attr::new(a.prefix, a.name, a.value, a.ns))
    i = i + 1
  }
  let n = html::Node::new_full(w.kind, w.ns, w.tag, attrs_copy, w.data, false)
  n.wire_id = w.id
  n.set_ns_uri(w.ns_uri)
  n.set_prefix(w.prefix)
  n.value = w.value
  n.set_checked(w.checked)
  n.src_url = w.src_url
  n.natural = w.natural
  n.set_quirks(w.quirks)
  n.set_public_id(w.public_id)
  n.set_system_id(w.system_id)
  if w.defined {
    self.defined_custom.set(n.uid, true)
    css::defined_custom.set(n.uid, true)
  }
  if w.states != 0 {
    self.element_states.set(n.uid, w.states)
    css::element_states.set(n.uid, w.states)
  }
  self.by_wire.set(w.id, n)
  self.by_uid.set(n.uid, n)
  i = 0
  while i < w.children.length() {
    n.append(self.build(w.children[i]))
    i = i + 1
  }
  match w.shadow {
    Some(s) => {
      let root = self.build(s)
      n.set_shadow(Some(root))
      root.set_host(Some(n))
    }
    None => ()
  }
  n
}

fn Doc::forget_subtree(self : Doc, n : html::Node) -> Unit {
  let walk : Array[html::Node] = [n]
  while walk.length() > 0 {
    match walk.pop() {
      Some(x) => {
        if self.by_wire.contains(x.wire_id) {
          let y = self.by_wire.get_or(x.wire_id, self.sentinel)
          if y.uid == x.uid {
            let _ = self.by_wire.delete(x.wire_id)
            let _ = self.rendered.delete(x.wire_id)
          }
        }
        let _ = self.by_uid.delete(x.uid)
        let _ = self.element_states.delete(x.uid)
        let _ = css::element_states.delete(x.uid)
        let _ = self.defined_custom.delete(x.uid)
        let _ = css::defined_custom.delete(x.uid)
        let _ = self.prev_style_uid.delete(x.uid)
        let _ = self.anim_tracked.delete(x.uid)
        let _ = self.js_comp_uids.delete(x.uid)
        self.js_comp_boxes.remove(x.uid)
        let mut i = 0
        while i < x.children.length() {
          walk.push(x.children[i])
          i = i + 1
        }
        match x.get_shadow() {
          Some(s) => walk.push(s)
          None => ()
        }
      }
      None => break
    }
  }
}

pub fn Doc::reset(self : Doc, d : proto::WireDoc) -> Unit {
  match self.root_node {
    Some(r) => {
      self.forget_subtree(r)
      html::cut(r)
    }
    None => ()
  }
  let old_fids = self.frames.keys()
  let mut i = 0
  while i < old_fids.length() {
    match self.frame_of(old_fids[i]) {
      Some(f) => {
        self.forget_subtree(f.root)
        html::cut(f.root)
      }
      None => ()
    }
    i = i + 1
  }
  self.by_wire.clear()
  self.by_uid.clear()
  self.frames.clear()
  self.sheets = Map::new()
  self.cssom.clear()
  self.rendered.clear()
  self.anims.clear()
  self.trans.clear()
  self.prev_vals.clear()
  self.prev_style_uid.clear()
  self.anim_tracked.clear()
  self.anim_nodes.clear()
  self.anim_boxes.clear()
  self.js_comp_uids.clear()
  self.js_comp_boxes.clear()
  self.anim_ancestors.clear()
  self.anim_paint_only = false
  self.anim_tick_only = false
  for uid in self.defined_custom.keys() {
    let _ = css::defined_custom.delete(uid)
  }
  for uid in self.element_states.keys() {
    let _ = css::element_states.delete(uid)
  }
  self.defined_custom.clear()
  self.element_states.clear()
  self.base_url = d.base
  self.target_id = d.target
  i = 0
  while i < d.sheets.length() {
    self.sheets.set(d.sheets[i].0, d.sheets[i].1)
    i = i + 1
  }
  i = 0
  while i < d.cssom.length() {
    self.cssom.set(d.cssom[i].0, d.cssom[i].1)
    i = i + 1
  }
  self.root_node = Some(self.build(d.root))
  i = 0
  while i < d.frames.length() {
    let f = d.frames[i]
    self.set_frame(f.iframe, Some(f))
    i = i + 1
  }
  self.hover_chain = []
  self.active_chain = []
  self.focus_wire_id = 0
  self.validation_wire_id = 0
  self.validation_msg = ""
  self.sheets_gen_val = self.sheets_gen_val + 1
  self.engine_sheets = []
  self.engine_adopted = ""
  self.engine_has_imports = false
  self.web_fonts_gen = -1
  self.layout_dirty = true
  self.lang_dirty = true
  html::bump_tree_changes()
}

fn Doc::set_frame(self : Doc, id : Int, f : Option[proto::WireFrame]) -> Unit {
  match self.frame_of(id) {
    Some(old) => {
      self.forget_subtree(old.root)
      html::cut(old.root)
      let _ = self.frames.delete(id)
    }
    None => ()
  }
  match f {
    Some(fr) => {
      let root = self.build(fr.root)
      self.frames.set(
        id,
        Frame::{
          url: fr.url,
          root: root,
          reuse: layout::Reuse::new(),
          engine: None,
          key: "",
          size: (0.0, 0.0),
          box_node: None,
          dirty: true,
        },
      )
    }
    None => ()
  }
  self.layout_dirty = true
  html::bump_tree_changes()
}

fn node_is_sheet_element(n : html::Node) -> Bool {
  if n.kind != html::Kind::Element {
    return false
  }
  if n.tag == "style" {
    return true
  }
  if n.tag == "link" {
    return doc_ascii_lower(n.attr("rel").unwrap_or("")).index_of("stylesheet") >= 0
  }
  false
}

fn subtree_has_sheet(n : html::Node) -> Bool {
  let walk : Array[html::Node] = [n]
  while walk.length() > 0 {
    match walk.pop() {
      Some(x) => {
        if node_is_sheet_element(x) {
          return true
        }
        let mut i = 0
        while i < x.children.length() {
          walk.push(x.children[i])
          i += 1
        }
      }
      None => break
    }
  }
  false
}

fn in_shadow_tree(n : html::Node) -> Bool {
  let mut cur = n
  while true {
    match cur.parent {
      Some(p) => cur = p
      None => return cur.get_host().is_some()
    }
  }
  false
}

fn Doc::touch_style_node_ex(
  self : Doc,
  n : html::Node,
  children_changed : Bool,
  attr : Option[(String, String)],
  moved : Option[html::Node],
) -> Unit {
  self.layout_dirty = true
  if node_is_sheet_element(n) {
    self.sheets_gen_val = self.sheets_gen_val + 1
  } else {
    match n.parent {
      Some(p) => {
        if p.kind == html::Kind::Element && p.tag == "style" {
          self.sheets_gen_val = self.sheets_gen_val + 1
        }
      }
      None => ()
    }
  }
  let top = top_of(n)
  match self.root_node {
    Some(r) => if top.uid == r.uid {
      match self.engine {
        Some(e) => e.forget(n, children_changed, attr, moved, false)
        None => ()
      }
    }
    None => ()
  }
  let fks = self.frames.keys()
  let mut fi = 0
  while fi < fks.length() {
    match self.frame_of(fks[fi]) {
      Some(fr) => if fr.root.uid == top.uid {
        match fr.engine {
          Some(e) => e.forget(n, children_changed, attr, moved, false)
          None => ()
        }
        fr.reuse.changed(n)
        fr.dirty = true
      }
      None => ()
    }
    fi += 1
  }
  self.reuse.changed(n)
}

fn Doc::touch_layout_only(self : Doc, n : html::Node) -> Unit {
  self.layout_dirty = true
  let top = top_of(n)
  let fks = self.frames.keys()
  let mut fi = 0
  while fi < fks.length() {
    match self.frame_of(fks[fi]) {
      Some(fr) => if fr.root.uid == top.uid {
        fr.reuse.changed(n)
        fr.dirty = true
      }
      None => ()
    }
    fi += 1
  }
  self.reuse.changed(n)
}

fn Doc::touch_style_node(self : Doc, n : html::Node) -> Unit {
  self.touch_style_node_ex(n, false, None, None)
}

fn Doc::forget_engine_subtree(self : Doc, n : html::Node) -> Unit {
  let top = top_of(n)
  match self.root_node {
    Some(r) => if top.uid == r.uid {
      match self.engine {
        Some(e) => e.forget_subtree_of(n)
        None => ()
      }
      return
    }
    None => ()
  }
  let fks = self.frames.keys()
  let mut fi = 0
  while fi < fks.length() {
    match self.frame_of(fks[fi]) {
      Some(fr) => if fr.root.uid == top.uid {
        match fr.engine {
          Some(e) => e.forget_subtree_of(n)
          None => ()
        }
        return
      }
      None => ()
    }
    fi += 1
  }
}

fn find_attr_in(arr : Array[html::Attr], a : html::Attr) -> Int {
  let mut i = 0
  while i < arr.length() {
    let b = arr[i]
    if b.name == a.name && b.prefix == a.prefix && b.ns == a.ns {
      return i
    }
    i += 1
  }
  -1
}

fn diff_attrs_single(
  old_attrs : Array[html::Attr],
  new_attrs : Array[html::Attr],
) -> (Int, String, String) {
  // Fast path: identical in order
  if old_attrs.length() == new_attrs.length() {
    let mut same = true
    let mut i = 0
    while i < old_attrs.length() {
      let a = old_attrs[i]
      let b = new_attrs[i]
      if a.name != b.name || a.value != b.value || a.prefix != b.prefix || a.ns != b.ns {
        same = false
        break
      }
      i += 1
    }
    if same {
      return (0, "", "")
    }
  }
  let mut changes = 0
  let mut ch_name = ""
  let mut ch_val = ""
  let mut i = 0
  while i < old_attrs.length() {
    let a = old_attrs[i]
    let j = find_attr_in(new_attrs, a)
    if j < 0 {
      if a.prefix != "" || a.ns != "" {
        return (2, "", "")
      }
      changes += 1
      if changes > 1 {
        return (2, "", "")
      }
      ch_name = a.name
      ch_val = "\u{0}"
    } else if new_attrs[j].value != a.value {
      if a.prefix != "" || a.ns != "" {
        return (2, "", "")
      }
      changes += 1
      if changes > 1 {
        return (2, "", "")
      }
      ch_name = a.name
      ch_val = new_attrs[j].value
    }
    i += 1
  }
  i = 0
  while i < new_attrs.length() {
    let b = new_attrs[i]
    if find_attr_in(old_attrs, b) < 0 {
      if b.prefix != "" || b.ns != "" {
        return (2, "", "")
      }
      changes += 1
      if changes > 1 {
        return (2, "", "")
      }
      ch_name = b.name
      ch_val = b.value
    }
    i += 1
  }
  (changes, ch_name, ch_val)
}

pub fn Doc::patch(self : Doc, ops : Array[proto::PatchOp]) -> Unit {
  let mut i = 0
  while i < ops.length() {
    self.apply(ops[i])
    i = i + 1
  }
}

pub fn Doc::apply(self : Doc, op : proto::PatchOp) -> Unit {
  match op {
    proto::PatchOp::Insert(p, idx, w) => {
      let parent = match self.node(p) {
        Some(n) => n
        None => return
      }
      let child = self.build(w)
      if parent.kind == html::Kind::Document ||
      (child.kind == html::Kind::Element && child.tag == "html") {
        self.lang_dirty = true
      }
      let before : Option[html::Node] = if idx >= 0 && idx < parent.children.length() {
        Some(parent.children[idx])
      } else {
        None
      }
      parent.insert_before(child, before)
      if subtree_has_sheet(child) {
        self.sheets_gen_val = self.sheets_gen_val + 1
      }
      self.touch_style_node_ex(parent, true, None, Some(child))
    }
    proto::PatchOp::Remove(p, c) => {
      let parent = match self.node(p) {
        Some(n) => n
        None => return
      }
      let mut found : Option[html::Node] = None
      let mut i = 0
      while i < parent.children.length() {
        if parent.children[i].wire_id == c {
          found = Some(parent.children[i])
          break
        }
        i = i + 1
      }
      let child = match found {
        Some(ch) => ch
        None => return
      }
      if parent.kind == html::Kind::Document ||
      (child.kind == html::Kind::Element && child.tag == "html") {
        self.lang_dirty = true
      }
      if subtree_has_sheet(child) {
        self.sheets_gen_val = self.sheets_gen_val + 1
      }
      self.forget_engine_subtree(child)
      self.touch_style_node_ex(parent, true, None, Some(child))
      child.detach()
      self.forget_subtree(child)
      html::cut(child)
    }
    proto::PatchOp::SetData(id, s) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      if n.data == s {
        return
      }
      let was_empty = n.data.length() == 0
      n.data = s
      if n.kind == html::Kind::Document {
        self.sheets_gen_val = self.sheets_gen_val + 1
        self.touch_style_node(n)
      } else if n.kind == html::Kind::Text {
        let in_style = match n.parent {
          Some(p) => p.kind == html::Kind::Element && p.tag == "style"
          None => false
        }
        if in_style || was_empty != (s.length() == 0) {
          self.touch_style_node(n)
        } else {
          self.touch_layout_only(n)
        }
      } else {
        self.touch_style_node(n)
      }
    }
    proto::PatchOp::SetAttrs(id, attrs) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      let (changes, ch_name, ch_val) = diff_attrs_single(n.attrs, attrs)
      if changes == 0 {
        return
      }
      if n.kind == html::Kind::Element && n.tag == "html" {
        self.lang_dirty = true
      }
      let was_sheet = node_is_sheet_element(n)
      let use_single = changes == 1 &&
      !(n.kind == html::Kind::Element && (n.tag == "style" || n.tag == "link"))
      if use_single {
        self.touch_style_node_ex(n, false, Some((ch_name, ch_val)), None)
      }
      n.clear_attrs()
      let mut i = 0
      while i < attrs.length() {
        html::note_name(attrs[i].name, attrs[i].value)
        n.push_attr(attrs[i])
        i = i + 1
      }
      n.invalidate_class()
      if was_sheet && !node_is_sheet_element(n) {
        self.sheets_gen_val = self.sheets_gen_val + 1
      }
      if !use_single {
        self.touch_style_node(n)
      }
    }
    proto::PatchOp::SetForm(id, v, c) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      n.value = v
      n.set_checked(c)
      self.touch_style_node(n)
      match n.parent {
        Some(p) if n.tag == "option" && p.tag == "select" => self.touch_style_node(p)
        Some(p) if n.tag == "option" && p.tag == "optgroup" =>
        match p.parent {
          Some(s) if s.tag == "select" => self.touch_style_node(s)
          _ => ()
        }
        _ => ()
      }
    }
    proto::PatchOp::SetImage(id, u, nat) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      let same_u = match (n.src_url, u) {
        (None, None) => true
        (Some(a), Some(b)) => a == b
        _ => false
      }
      let same_nat = match (n.natural, nat) {
        (None, None) => true
        (Some((aw, ah)), Some((bw, bh))) => aw == bw && ah == bh
        _ => false
      }
      if same_u && same_nat {
        return
      }
      n.src_url = u
      n.natural = nat
      self.touch_layout_only(n)
    }
    proto::PatchOp::SetShadow(id, s) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      match n.get_shadow() {
        Some(old) => {
          self.forget_subtree(old)
          html::cut(old)
        }
        None => ()
      }
      n.set_shadow(match s {
        Some(w) => {
          let r = self.build(w)
          r.set_host(Some(n))
          Some(r)
        }
        None => None
      })
      html::bump_tree_changes()
      self.touch_style_node(n)
    }
    proto::PatchOp::SetDefined(id, d) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      if d {
        self.defined_custom.set(n.uid, true)
        css::defined_custom.set(n.uid, true)
      } else {
        let _ = self.defined_custom.delete(n.uid)
        let _ = css::defined_custom.delete(n.uid)
      }
      self.touch_style_node(n)
    }
    proto::PatchOp::SetStates(id, b) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      let was = self.element_states.get_or(n.uid, 0)
      let now = (b & 31) | (was & 96)
      if now == was {
        return
      }
      if now == 0 {
        let _ = self.element_states.delete(n.uid)
        let _ = css::element_states.delete(n.uid)
      } else {
        self.element_states.set(n.uid, now)
        css::element_states.set(n.uid, now)
      }
      self.touch_style_node(n)
    }
    proto::PatchOp::SetQuirks(id, q) => {
      let n = match self.node(id) {
        Some(n) => n
        None => return
      }
      if n.is_quirks() == q {
        return
      }
      n.set_quirks(q)
      self.sheets_gen_val = self.sheets_gen_val + 1
      self.layout_dirty = true
    }
    proto::PatchOp::SetSheet(u, t) => {
      match self.sheets.get(u) {
        Some(old) if old == t => return
        _ => ()
      }
      self.sheets.set(u, t)
      self.sheets_gen_val = self.sheets_gen_val + 1
      self.layout_dirty = true
    }
    proto::PatchOp::SetCssom(id, t) => {
      let same = match (self.cssom_of(id), t) {
        (None, None) => true
        (Some(a), Some(b)) => a == b
        _ => false
      }
      if same {
        return
      }
      match t {
        Some(text) => self.cssom.set(id, text)
        None => {
          let _ = self.cssom.delete(id)
        }
      }
      self.sheets_gen_val = self.sheets_gen_val + 1
      self.layout_dirty = true
    }
    proto::PatchOp::SetFrame(id, f) => self.set_frame(id, f)
    proto::PatchOp::SetTarget(t) => {
      if t != self.target_id {
        self.target_id = t
        self.layout_dirty = true
        match self.engine {
          Some(e) => e.forget_all()
          None => ()
        }
        self.reuse.drop_all()
        let fks = self.frames.keys()
        let mut fi = 0
        while fi < fks.length() {
          match self.frame_of(fks[fi]) {
            Some(fr) => {
              match fr.engine {
                Some(e) => e.forget_all()
                None => ()
              }
              fr.reuse.drop_all()
              fr.dirty = true
            }
            None => ()
          }
          fi += 1
        }
      }
    }
    proto::PatchOp::Rendered(id, k, w, h) => {
      self.rendered.set(id, RenderedInfo::{ key: k, width: w, height: h })
    }
    proto::PatchOp::Focus(id) => self.focus_wire_id = id
    proto::PatchOp::ScrollTo(_, _, _) => ()
    proto::PatchOp::Selection(_, _, _, _, _) => ()
    proto::PatchOp::Validation(id, msg) => {
      self.validation_wire_id = id
      self.validation_msg = msg
    }
  }
}

fn element_chain(n : Option[html::Node]) -> Array[html::Node] {
  let out : Array[html::Node] = []
  let mut cur = n
  while true {
    match cur {
      Some(x) => {
        if x.kind == html::Kind::Element {
          out.push(x)
        }
        cur = match x.parent {
          Some(p) => Some(p)
          None => x.get_host()
        }
      }
      None => break
    }
  }
  out
}

fn chain_has_uid(arr : Array[html::Node], uid : Int) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i].uid == uid {
      return true
    }
    i = i + 1
  }
  false
}

fn chains_equal(a : Array[html::Node], b : Array[html::Node]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i].uid != b[i].uid {
      return false
    }
    i = i + 1
  }
  true
}

fn Doc::state_affects_style(self : Doc, x : html::Node, bit : Int) -> Bool {
  if in_shadow_tree(x) {
    return true
  }
  let top = top_of(x)
  let mut eng_opt : Option[css::Engine] = None
  let mut found_tree = false
  match self.root_node {
    Some(r) => if top.uid == r.uid {
      eng_opt = self.engine
      found_tree = true
    }
    None => ()
  }
  if !found_tree {
    let fks = self.frames.keys()
    let mut fi = 0
    while fi < fks.length() {
      match self.frame_of(fks[fi]) {
        Some(fr) => if fr.root.uid == top.uid {
          eng_opt = fr.engine
          found_tree = true
          break
        }
        None => ()
      }
      fi += 1
    }
  }
  match eng_opt {
    None => true
    Some(e) => if !e.asks_states(bit) {
      false
    } else if bit == 32 {
      e.hover_target(x)
    } else if bit == 64 {
      e.active_target(x)
    } else {
      true
    }
  }
}

fn Doc::move_state(
  self : Doc,
  was : Array[html::Node],
  now : Array[html::Node],
  bit : Int,
) -> Bool {
  let mut touched = false
  let mut i = 0
  while i < was.length() {
    let x = was[i]
    if !chain_has_uid(now, x.uid) {
      let v = self.element_states.get_or(x.uid, 0) & (bit ^ 0x7FFFFFFF)
      if v == 0 {
        let _ = self.element_states.delete(x.uid)
        let _ = css::element_states.delete(x.uid)
      } else {
        self.element_states.set(x.uid, v)
        css::element_states.set(x.uid, v)
      }
      if self.state_affects_style(x, bit) {
        self.touch_style_node(x)
        touched = true
      }
    }
    i = i + 1
  }
  i = 0
  while i < now.length() {
    let x = now[i]
    if !chain_has_uid(was, x.uid) {
      let v = self.element_states.get_or(x.uid, 0) | bit
      self.element_states.set(x.uid, v)
      css::element_states.set(x.uid, v)
      if self.state_affects_style(x, bit) {
        self.touch_style_node(x)
        touched = true
      }
    }
    i = i + 1
  }
  touched
}

pub fn Doc::hover(self : Doc, n : Option[html::Node]) -> Bool {
  let now = element_chain(n)
  let was = self.hover_chain
  if chains_equal(was, now) {
    return false
  }
  let touched = self.move_state(was, now, 32)
  self.hover_chain = now
  touched
}

pub fn Doc::press(self : Doc, n : Option[html::Node]) -> Bool {
  let now = element_chain(n)
  let was = self.active_chain
  if chains_equal(was, now) {
    return false
  }
  let touched = self.move_state(was, now, 64)
  self.active_chain = now
  touched
}

pub fn Doc::choose(self : Doc, sel : html::Node, index : Int) -> Unit {
  let opts = html::select_options(sel)
  let mut i = 0
  while i < opts.length() {
    let on = i == index
    opts[i].set_checked(Some(on))
    self.touch_style_node(opts[i])
    i = i + 1
  }
  self.touch_style_node(sel)
}

pub fn Doc::set_value(self : Doc, n : html::Node, v : String) -> Unit {
  n.value = Some(v)
  self.touch_style_node(n)
}

pub fn Doc::validation_state(self : Doc) -> (Int, String) {
  (self.validation_wire_id, self.validation_msg)
}
