///| CSS box-shadow / text-shadow interpolation (`src/page/shadow.mbt`) + Shadow DOM traversal helpers.

import "html"

pub struct ShadowSpec {
  pub color : String
  pub lens : Array[Double]
  pub inset : Bool
}

fn sh_to_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

fn split_top_level(s : String, sep : Int) -> Array[String] {
  let b = s.to_bytes()
  let out : Array[String] = []
  let mut depth = 0
  let mut start = 0
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 40 {
      depth = depth + 1
    } else if c == 41 {
      if depth > 0 {
        depth = depth - 1
      }
    } else if c == sep && depth == 0 {
      out.push(s.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()).trim())
  out
}

fn split_ws_top_level(s : String) -> Array[String] {
  let b = s.to_bytes()
  let out : Array[String] = []
  let mut depth = 0
  let mut start = -1
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    let is_sp = c == 32 || c == 9 || c == 10 || c == 13
    if c == 40 {
      if start < 0 {
        start = i
      }
      depth = depth + 1
    } else if c == 41 {
      if depth > 0 {
        depth = depth - 1
      }
    } else if is_sp && depth == 0 {
      if start >= 0 {
        out.push(s.slice(start, i))
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i = i + 1
  }
  if start >= 0 {
    out.push(s.slice(start, s.length()))
  }
  out
}

fn parse_px_tok(tok : String) -> Option[Double] {
  let lt = sh_to_lower(tok)
  if lt == "0" {
    return Option::Some(0.0)
  }
  if lt.ends_with("px") {
    let num = lt.slice(0, lt.length() - 2)
    return num.to_double()
  }
  Option::None
}

fn fmt_px(n : Double) -> String {
  let r = math_round(n * 1000.0) / 1000.0
  let v = if r == 0.0 { 0.0 } else { r }
  v.to_string() + "px"
}

pub fn parse_shadows(text : String, current_color : String, is_box : Bool) -> Option[Array[ShadowSpec]] {
  let trimmed = sh_to_lower(text.trim())
  if trimmed == "" || trimmed == "none" {
    return Option::None
  }
  let layers = split_top_level(text, 44)
  let out : Array[ShadowSpec] = []
  let max_lens = if is_box { 4 } else { 3 }
  let mut li = 0
  while li < layers.length() {
    let toks = split_ws_top_level(layers[li])
    let mut color = ""
    let lens : Array[Double] = []
    let mut inset = false
    let mut ti = 0
    while ti < toks.length() {
      let tk = toks[ti]
      let ltk = sh_to_lower(tk)
      if ltk == "inset" {
        inset = true
      } else {
        match parse_px_tok(tk) {
          Option::Some(v) => lens.push(v)
          Option::None => color = tk
        }
      }
      ti = ti + 1
    }
    if lens.length() < 2 || lens.length() > max_lens {
      return Option::None
    }
    while lens.length() < max_lens {
      lens.push(0.0)
    }
    out.push(ShadowSpec::{ color: if color == "" { current_color } else { color }, lens: lens, inset: inset })
    li = li + 1
  }
  Option::Some(out)
}

pub fn shadows_to_text(list : Option[Array[ShadowSpec]]) -> String {
  match list {
    Option::None => "none"
    Option::Some(l) => {
      let parts : Array[String] = []
      let mut i = 0
      while i < l.length() {
        let s = l[i]
        let toks : Array[String] = [s.color]
        let mut k = 0
        while k < s.lens.length() {
          toks.push(fmt_px(s.lens[k]))
          k = k + 1
        }
        if s.inset {
          toks.push("inset")
        }
        parts.push(toks.join(" "))
        i = i + 1
      }
      parts.join(", ")
    }
  }
}

pub fn shadow_mix(a : String, b : String, p : Double, prop : String) -> Option[String] {
  let is_box = prop == "box-shadow"
  let none_a = sh_to_lower(a.trim()) == "none"
  let none_b = sh_to_lower(b.trim()) == "none"
  if none_a && none_b {
    return Option::Some("none")
  }
  let la_opt = parse_shadows(a, "rgba(0, 0, 0, 0)", is_box)
  let lb_opt = parse_shadows(b, "rgba(0, 0, 0, 0)", is_box)
  if (la_opt.is_none() && !none_a) || (lb_opt.is_none() && !none_b) {
    return Option::None
  }
  let la = match la_opt {
    Option::Some(x) => x
    Option::None => []
  }
  let lb = match lb_opt {
    Option::Some(x) => x
    Option::None => []
  }
  let n = if la.length() > lb.length() { la.length() } else { lb.length() }
  let out : Array[ShadowSpec] = []
  let mut i = 0
  while i < n {
    let x = if i < la.length() {
      la[i]
    } else {
      let zeros : Array[Double] = []
      let mut z = 0
      while z < lb[i].lens.length() {
        zeros.push(0.0)
        z = z + 1
      }
      ShadowSpec::{ color: "rgba(0, 0, 0, 0)", lens: zeros, inset: lb[i].inset }
    }
    let y = if i < lb.length() {
      lb[i]
    } else {
      let zeros : Array[Double] = []
      let mut z = 0
      while z < la[i].lens.length() {
        zeros.push(0.0)
        z = z + 1
      }
      ShadowSpec::{ color: "rgba(0, 0, 0, 0)", lens: zeros, inset: la[i].inset }
    }
    if x.inset != y.inset || x.lens.length() != y.lens.length() {
      return Option::None
    }
    let color = if p < 0.5 { x.color } else { y.color }
    let lens : Array[Double] = []
    let mut k = 0
    while k < x.lens.length() {
      let r = x.lens[k] + (y.lens[k] - x.lens[k]) * p
      lens.push(if k == 2 && r < 0.0 { 0.0 } else { r })
      k = k + 1
    }
    out.push(ShadowSpec::{ color: color, lens: lens, inset: x.inset })
    i = i + 1
  }
  Option::Some(shadows_to_text(Option::Some(out)))
}

///| Traverses light DOM and shadow roots to collect all node uids in pre-order.
pub fn collect_shadow_tree_uids(root : html::Node) -> Array[Int] {
  let out : Array[Int] = []
  let stack : Array[html::Node] = [root]
  while stack.length() > 0 {
    match stack.pop() {
      Option::None => break
      Option::Some(n) => {
        out.push(n.uid)
        match n.get_shadow() {
          Option::Some(sr) => stack.push(sr)
          Option::None => ()
        }
        let mut i = n.children.length() - 1
        while i >= 0 {
          stack.push(n.children[i])
          i = i - 1
        }
      }
    }
  }
  out
}
