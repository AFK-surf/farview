///| Document sync state, `Mirror` state assembly, `active_focus_uid`, `validation_tip`,
///| `web_font_files`, and localStorage sharing (`src/page/sync.mbt`).

import "html"
import "doc"

pub struct SyncFrame {
  pub iframe_el : html::Node
  pub url : String
  pub doc : html::Node
}

pub struct SyncState {
  pub mut url : String
  pub mut root : html::Node
  pub mut frames : Array[SyncFrame]
  pub mut sheets : Map[String, String]
  pub mut cssom : Array[(html::Node, String)]
  pub mut defined_custom : Map[String, Bool]
  pub mut element_states : Map[String, Int]
  pub mut target_id : String
  pub mut font_files : Map[String, Bytes]
  pub mut pictures : Map[String, Bytes]
  pub mut pictures_ver : Int
  pub mut fonts_ver : Int
  pub mut svg_dirty : Bool
  pub mut assets_dirty : Bool
  pub mut storages : Map[String, Map[String, String]]
}

pub fn SyncState::new(url : String, root : html::Node) -> SyncState {
  SyncState::{
    url: url,
    root: root,
    frames: [],
    sheets: Map::new(),
    cssom: [],
    defined_custom: Map::new(),
    element_states: Map::new(),
    target_id: "",
    font_files: Map::new(),
    pictures: Map::new(),
    pictures_ver: 1,
    fonts_ver: 1,
    svg_dirty: true,
    assets_dirty: true,
    storages: Map::new(),
  }
}

pub fn SyncState::web_font_files(self : SyncState) -> Array[(String, Bytes)] {
  let out : Array[(String, Bytes)] = []
  let ks = self.font_files.keys()
  let mut i = 0
  while i < ks.length() {
    match self.font_files.get(ks[i]) {
      Option::Some(b) => out.push((ks[i], b))
      Option::None => ()
    }
    i = i + 1
  }
  out
}

pub fn SyncState::pictures_version(self : SyncState) -> Int {
  self.pictures_ver + self.pictures.length()
}

pub fn SyncState::fonts_version(self : SyncState) -> Int {
  self.fonts_ver + self.font_files.length()
}

pub fn SyncState::doc_needs_layout(self : SyncState) -> Bool {
  self.svg_dirty || self.assets_dirty
}

pub fn SyncState::build_doc_state(self : SyncState) -> doc::DocState {
  let sheets_arr : Array[(String, String)] = []
  let sks = self.sheets.keys()
  let mut si = 0
  while si < sks.length() {
    match self.sheets.get(sks[si]) {
      Option::Some(v) => sheets_arr.push((sks[si], v))
      Option::None => ()
    }
    si = si + 1
  }
  let frames_arr : Array[doc::DocFrameInput] = []
  let mut fi = 0
  while fi < self.frames.length() {
    let f = self.frames[fi]
    frames_arr.push(doc::DocFrameInput::{ iframe: f.iframe_el, url: f.url, root: f.doc })
    fi = fi + 1
  }
  let def_map = self.defined_custom
  let st_map = self.element_states
  doc::DocState::{
    base: self.url,
    root: self.root,
    frames: frames_arr,
    sheets: sheets_arr,
    cssom: self.cssom,
    defined: fn(n : html::Node) -> Bool { def_map.contains(n.uid.to_string()) },
    states: fn(n : html::Node) -> Int {
      match st_map.get(n.uid.to_string()) {
        Option::Some(v) => v & 31
        Option::None => 0
      }
    },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: self.target_id,
  }
}

///| Finds node by `uid` across main document, iframes, and shadow roots.
pub fn SyncState::node_of_uid(self : SyncState, uid : Int) -> Option[html::Node] {
  let stack : Array[html::Node] = [self.root]
  let mut fi = 0
  while fi < self.frames.length() {
    stack.push(self.frames[fi].doc)
    fi = fi + 1
  }
  while stack.length() > 0 {
    match stack.pop() {
      Option::None => break
      Option::Some(n) => {
        if n.uid == uid {
          return Option::Some(n)
        }
        let mut i = 0
        while i < n.children.length() {
          stack.push(n.children[i])
          i = i + 1
        }
        match n.shadow {
          Option::Some(sr) => stack.push(sr)
          Option::None => ()
        }
      }
    }
  }
  Option::None
}

///| Wire uid of the currently focused element (:focus bit 4), or 0 when none.
pub fn SyncState::active_focus_uid(self : SyncState) -> Int {
  let ks = self.element_states.keys()
  let mut i = 0
  while i < ks.length() {
    match self.element_states.get(ks[i]) {
      Option::Some(bits) => if (bits & 4) != 0 {
        match ks[i].to_int() {
          Option::Some(uid) => return uid
          Option::None => ()
        }
      }
      Option::None => ()
    }
    i = i + 1
  }
  0
}

fn soh_sep() -> String {
  let b = Bytes::new(1)
  b[0] = 1.to_byte()
  b.to_string()
}

///| Parses raw `<js_id>\x01<message>` returned by `__validationTip()` and maps js_id -> wire uid.
pub fn parse_validation_tip(raw : String, js_to_uid : Map[String, Int]) -> (Int, String) {
  if raw == "" {
    return (0, "")
  }
  let sep = raw.index_of(soh_sep())
  if sep < 0 {
    return (0, "")
  }
  let js_id = raw.slice(0, sep)
  let msg = raw.slice(sep + 1, raw.length())
  match js_to_uid.get(js_id) {
    Option::Some(uid) => (uid, msg)
    Option::None => (0, "")
  }
}

fn scan_svg_asset_rec(
  x : html::Node,
  need_svg : Bool,
  need_asset : Bool,
  found_svg : Bool,
  found_asset : Bool,
) -> (Bool, Bool) {
  let mut hs = found_svg
  let mut ha = found_asset
  if x.kind == html::Kind::Element {
    if need_svg && !hs {
      if x.ns == html::Ns::Svg || x.tag == "svg" {
        hs = true
      }
    }
    if need_asset && !ha {
      let l = x.tag.length()
      if (l == 3 && x.tag == "img") ||
      (l == 4 && x.tag == "link") ||
      (l == 5 && x.tag == "style") ||
      (l == 6 && (x.tag == "source" || x.tag == "canvas" || x.tag == "iframe")) ||
      (l == 7 && x.tag == "picture") {
        ha = true
      } else {
        let alen = x.attrs.length()
        let mut ai = 0
        while ai < alen {
          let an = x.attrs[ai].name
          if an.length() == 5 && (an == "style" || an == "class") {
            ha = true
            break
          }
          ai = ai + 1
        }
      }
    }
    if (!need_svg || hs) && (!need_asset || ha) {
      return (hs, ha)
    }
  }
  let ch = x.children
  let clen = ch.length()
  let mut i = 0
  while i < clen {
    let c = ch[i]
    if c.kind != html::Kind::Text && c.kind != html::Kind::Comment {
      let (ns, na) = scan_svg_asset_rec(c, need_svg, need_asset, hs, ha)
      hs = ns
      ha = na
      if (!need_svg || hs) && (!need_asset || ha) {
        return (hs, ha)
      }
    }
    i = i + 1
  }
  (hs, ha)
}

///| Zero-allocation early-exit subtree check for `<svg>` and asset-bearing nodes.
pub fn node_scan_svg_asset(
  root : html::Node,
  need_svg : Bool,
  need_asset : Bool,
) -> (Bool, Bool) {
  if !need_svg && !need_asset {
    return (false, false)
  }
  scan_svg_asset_rec(root, need_svg, need_asset, false, false)
}

///| Checks whether a subtree contains inline `<svg>` or asset-bearing elements.
pub fn node_has_svg_or_asset(root : html::Node) -> (Bool, Bool) {
  node_scan_svg_asset(root, true, true)
}

pub fn SyncState::storage_put(self : SyncState, origin : String, key : String, val_opt : Option[String]) -> Unit {
  let m = match self.storages.get(origin) {
    Option::Some(existing) => existing
    Option::None => {
      let fresh : Map[String, String] = Map::new()
      self.storages.set(origin, fresh)
      fresh
    }
  }
  match val_opt {
    Option::Some(v) => m.set(key, v)
    Option::None => m.remove(key)
  }
}

pub fn SyncState::storage_entries(self : SyncState) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  let origins = self.storages.keys()
  let mut i = 0
  while i < origins.length() {
    let o = origins[i]
    match self.storages.get(o) {
      Option::Some(m) => {
        let ks = m.keys()
        let mut j = 0
        while j < ks.length() {
          let k = ks[j]
          match m.get(k) {
            Option::Some(v) => out.set(o + soh_sep() + k, v)
            Option::None => ()
          }
          j = j + 1
        }
      }
      Option::None => ()
    }
    i = i + 1
  }
  out
}
