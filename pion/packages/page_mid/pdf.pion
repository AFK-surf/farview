///| Built-in inline PDF viewer: HTML generation + CoreGraphics PDF page rasterization (`src/page/pdf_stub.c`).
///| 1:1 port of `src/page/pdf.mbt`.

import "page_aux"
import "raster"

pub let pdf_max_render_pages : Int = 30

extern "C" fn c_pdf_mb_len(p : Ptr) -> Int = "pion_pdf_mb_len"

extern "C" fn c_pdf_mb_free(p : Ptr) -> Unit = "pion_pdf_mb_free"

extern "C" fn c_pdf_page_count(data : Ptr, len : Int) -> Int = "pion_pdf_page_count"

extern "C" fn c_pdf_title(data : Ptr, len : Int) -> Ptr = "pion_pdf_title"

extern "C" fn c_pdf_render_page(data : Ptr, len : Int, page_1based : Int, dpi : Int) -> Ptr = "pion_pdf_render_page"

extern "C" fn c_pdf_is_macos() -> Int = "pion_pdf_is_macos"

pub fn pdf_on_macos() -> Bool {
  c_pdf_is_macos() != 0
}

fn take_pdf_mb(p : Ptr) -> Bytes {
  let n = c_pdf_mb_len(p)
  let out = bytes_from_ptr(p, n)
  c_pdf_mb_free(p)
  out
}

pub fn pdf_page_count(pdf : Bytes) -> Int {
  if pdf.length() == 0 {
    return 0
  }
  c_pdf_page_count(bytes_data_ptr(pdf), pdf.length())
}

pub fn pdf_title(pdf : Bytes) -> String {
  if pdf.length() == 0 {
    return ""
  }
  take_pdf_mb(c_pdf_title(bytes_data_ptr(pdf), pdf.length())).to_string().trim()
}

pub fn pdf_render_page(pdf : Bytes, page_1based : Int, dpi : Int) -> Bytes {
  if pdf.length() == 0 {
    return Bytes::new(0)
  }
  take_pdf_mb(c_pdf_render_page(bytes_data_ptr(pdf), pdf.length(), page_1based, dpi))
}

pub fn pdf_has_magic(body : Bytes) -> Bool {
  let n = body.length()
  if n < 5 {
    return false
  }
  let limit = if n - 5 < 16 { n - 5 } else { 16 }
  let mut i = 0
  while i <= limit {
    if (body[i].to_int() & 0xFF) == 0x25 && (body[i + 1].to_int() & 0xFF) == 0x50 && (body[i + 2].to_int() & 0xFF) == 0x44 && (body[i + 3].to_int() & 0xFF) == 0x46 && (body[i + 4].to_int() & 0xFF) == 0x2D {
      return true
    }
    i = i + 1
  }
  false
}

fn pdf_content_type_essence(ct : String) -> String {
  let semi = ct.index_of(";")
  let base = if semi >= 0 { ct.slice(0, semi) } else { ct }
  sh_to_lower(base.trim())
}

fn pdf_url_ends_with_pdf(u : String) -> Bool {
  let mut p = u
  let kh = p.index_of("#")
  if kh >= 0 {
    p = p.slice(0, kh)
  }
  let kq = p.index_of("?")
  if kq >= 0 {
    p = p.slice(0, kq)
  }
  sh_to_lower(p).ends_with(".pdf")
}

pub fn is_inline_pdf(u : String, content_type : String, body : Bytes) -> Bool {
  if body.length() < 5 {
    return false
  }
  let ess = pdf_content_type_essence(content_type)
  if ess == "application/pdf" || ess == "application/x-pdf" {
    return true
  }
  if pdf_has_magic(body) && (ess == "" || ess == "application/octet-stream" || pdf_url_ends_with_pdf(u)) {
    return true
  }
  false
}

pub fn pdf_escape_html(s : String) -> String {
  let b = s.to_bytes()
  let parts : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 38 || c == 60 || c == 62 || c == 34 {
      if i > start {
        parts.push(s.slice(start, i))
      }
      if c == 38 {
        parts.push("&amp;")
      } else if c == 60 {
        parts.push("&lt;")
      } else if c == 62 {
        parts.push("&gt;")
      } else {
        parts.push("&quot;")
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < b.length() {
    parts.push(s.slice(start, b.length()))
  }
  parts.join("")
}

pub fn pdf_fmt_size(bytes : Int) -> String {
  if bytes < 1024 {
    bytes.to_string() + " B"
  } else if bytes < 1048576 {
    let kb10 = (bytes * 10) / 1024
    (kb10 / 10).to_string() + "." + (kb10 % 10).to_string() + " KB"
  } else {
    let mb10 = (bytes * 10) / 1048576
    (mb10 / 10).to_string() + "." + (mb10 % 10).to_string() + " MB"
  }
}

pub struct PdfViewerState {
  pub mut raw : Bytes
  pub mut url : String
  pub mut name : String
  pub mut pic_keys : Array[String]
  pub mut ver : Int
}

pub fn PdfViewerState::new() -> PdfViewerState {
  PdfViewerState::{ raw: Bytes::new(0), url: "", name: "", pic_keys: [], ver: 0 }
}

pub fn PdfViewerState::clear(self : PdfViewerState, pictures : Map[String, Bytes]) -> Unit {
  let mut i = 0
  while i < self.pic_keys.length() {
    pictures.remove(self.pic_keys[i])
    i = i + 1
  }
  self.pic_keys = []
  self.raw = Bytes::new(0)
  self.url = ""
  self.name = ""
}

pub fn PdfViewerState::render_viewer_html(
  self : PdfViewerState,
  u : String,
  disposition : String,
  body : Bytes,
  for_iframe : Bool,
  pictures : Map[String, Bytes],
) -> String {
  let raw_name = match page_aux::disposition_name(disposition) {
    Option::Some(n) => if n != "" { n } else { "document.pdf" }
    Option::None => {
      let un = page_aux::url_file_name(u)
      if un != "" { un } else { "document.pdf" }
    }
  }
  let filename = page_aux::safe_filename(raw_name)
  if !for_iframe {
    self.raw = body
    self.url = u
    self.name = filename
  }
  let count = pdf_page_count(body)
  let t = pdf_title(body)
  let doc_title = if t != "" { t } else { filename }
  let render_count = if count > pdf_max_render_pages {
    pdf_max_render_pages
  } else if count > 0 {
    count
  } else {
    0
  }
  self.ver = self.ver + 1
  let ver = self.ver
  let pages_parts : Array[String] = []
  let mut rendered = 0
  let mut p = 1
  while p <= render_count {
    let jpg = pdf_render_page(body, p, 144)
    if jpg.length() > 0 {
      rendered = rendered + 1
      let key = "fv-pdf://page/" + ver.to_string() + "/" + p.to_string()
      pictures.set(key, jpg)
      self.pic_keys.push(key)
      let dims = match raster::image_size(jpg) {
        Option::Some((pw, ph)) => " width=\"" + pw.to_string() + "\" height=\"" + ph.to_string() + "\""
        Option::None => ""
      }
      pages_parts.push(
        "<div class=\"fv-pdf-page\"><div class=\"fv-pdf-sheet\"><img src=\"" + key + "\" alt=\"Page " + p.to_string() + "\"" + dims + "></div><div class=\"fv-pdf-num\">" + p.to_string() + " / " + count.to_string() + "</div></div>",
      )
    }
    p = p + 1
  }
  let esc_title = pdf_escape_html(doc_title)
  let esc_name = pdf_escape_html(filename)
  let size_str = pdf_fmt_size(body.length())
  let count_label = if count > 0 { count.to_string() + " 页" } else { size_str }
  let dl_btn = if for_iframe {
    ""
  } else {
    "<button id=\"fv-pdf-dl\" class=\"fv-pdf-dl\" type=\"button\" data-fv-pdf-download=\"1\">下载 PDF</button>"
  }
  let main_content = if rendered > 0 {
    let trunc = if count > pdf_max_render_pages {
      "<div class=\"fv-pdf-trunc\">已显示前 " + pdf_max_render_pages.to_string() + " 页（共 " + count.to_string() + " 页）</div>"
    } else {
      ""
    }
    pages_parts.join("") + trunc
  } else {
    "<div class=\"fv-pdf-fallback\"><div class=\"fv-pdf-fb-name\">" + esc_name + "</div><div class=\"fv-pdf-fb-meta\">" + size_str + "</div></div>"
  }
  "<!doctype html><html><head><meta charset=\"utf-8\"><title>" + esc_title + "</title></head><body><header class=\"fv-pdf-bar\"><span class=\"fv-pdf-name\">" + esc_name + "</span><span class=\"fv-pdf-count\">" + count_label + "</span>" + dl_btn + "</header><main class=\"fv-pdf-stage\">" + main_content + "</main></body></html>"
}
