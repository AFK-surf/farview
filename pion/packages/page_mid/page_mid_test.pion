///| Unit tests for `page_mid`: shadow, indiv, pdf (with CoreGraphics rendering of real PDF), and sync.

import "html"
import "doc"
import "proto"
import "pdf_export"

test "shadow: box-shadow interpolation and Shadow DOM uid traversal" {
  match shadow_mix("0px 4px 8px 0px black", "10px 14px 2px 4px white", 0.5, "box-shadow") {
    Option::Some(s) => debug_assert(s.contains("5px") && s.contains("9px") && s.contains("2px"), "midpoint box-shadow: " + s)
    Option::None => debug_assert(false, "expected shadow_mix")
  }
  match shadow_mix("none", "none", 0.5, "box-shadow") {
    Option::Some(v) => debug_assert(v == "none", "none+none")
    Option::None => debug_assert(false, "none+none")
  }
  debug_assert(shadow_mix("0px 2px black inset", "0px 4px black", 0.5, "box-shadow").is_none(), "inset mismatch returns None")

  let root = html::parse("<div><span>hi</span></div>")
  let uids = collect_shadow_tree_uids(root)
  debug_assert(uids.length() >= 3, "collected DOM tree uids")
}

test "indiv: translate, scale, and 3D rotate quaternion SLERP interpolation & compositing" {
  match indiv_mix("10px 20px", "30px 60px", 0.5, "translate") {
    Option::Some(s) => debug_assert(s == "20px 40px", "translate midpoint: " + s)
    Option::None => debug_assert(false, "translate mix failed")
  }
  match indiv_mix("1 2", "3 4", 0.5, "scale") {
    Option::Some(s) => debug_assert(s == "2 3", "scale midpoint: " + s)
    Option::None => debug_assert(false, "scale mix failed")
  }
  match indiv_add("2 3", "4 5", false, "scale") {
    Option::Some(s) => debug_assert(s == "8 15", "scale multiply add: " + s)
    Option::None => debug_assert(false, "scale add failed")
  }
  match indiv_add("2 3", "4 5", true, "scale") {
    Option::Some(s) => debug_assert(s == "5 7", "scale accumulate: " + s)
    Option::None => debug_assert(false, "scale accumulate failed")
  }
  match indiv_mix("0deg", "90deg", 0.5, "rotate") {
    Option::Some(s) => debug_assert(s == "45deg", "rotate 2D midpoint: " + s)
    Option::None => debug_assert(false, "rotate mix failed")
  }
  match indiv_mix("x 90deg", "y 90deg", 0.5, "rotate") {
    Option::Some(s) => debug_assert(s.ends_with("deg"), "3D SLERP rotate produces angle: " + s)
    Option::None => debug_assert(false, "3D SLERP failed")
  }
}

test "pdf: CoreGraphics rasterizes real 2-page PDF into inline viewer HTML + JPEG assets" {
  let make_page = fn(r : Int, g : Int, b : Int) -> (Int, Int, Bytes) {
    let rgba = Bytes::new(8 * 8 * 4)
    let mut i = 0
    while i < 64 {
      rgba[i * 4] = r.to_byte()
      rgba[i * 4 + 1] = g.to_byte()
      rgba[i * 4 + 2] = b.to_byte()
      rgba[i * 4 + 3] = 255.to_byte()
      i = i + 1
    }
    (8, 8, rgba)
  }
  let pdf = pdf_export::encode_pdf_pages([make_page(0x25, 0x63, 0xEB), make_page(0x16, 0xA3, 0x4A)])
  debug_assert(is_inline_pdf("https://example.com/a.pdf", "application/pdf", pdf), "is_inline_pdf")
  debug_assert(pdf_page_count(pdf) == 2, "PDF page count is 2")
  let viewer = PdfViewerState::new()
  let pics : Map[String, Bytes] = Map::new()
  let html_out = viewer.render_viewer_html("https://example.com/spec.pdf", "inline; filename=\"spec.pdf\"", pdf, false, pics)
  debug_assert(html_out.contains("spec.pdf") && html_out.contains("2 页"), "viewer HTML title & page count")
  if pdf_on_macos() || pics.length() > 0 {
    debug_assert(pics.length() == 2, "2 page JPEGs registered in pictures map")
    viewer.clear(pics)
    debug_assert(pics.length() == 0, "viewer.clear removed page JPEGs")
  } else {
    // Non-macOS host without pdftoppm/mutool/gs installed: verify graceful fallback HTML.
    debug_assert(html_out.contains("fv-pdf-fallback"), "fallback viewer HTML")
    debug_assert(pics.length() == 0, "no page JPEGs without PDF rasterizer")
  }
}

test "sync: SyncState builds Mirror Reset/Patch, tracks focus, validation tip, and storage" {
  let root = html::parse("<!doctype html><html><body><div class=\"box\"><svg></svg></div></body></html>")
  let st = SyncState::new("https://example.com/", root)
  let (has_svg, has_asset) = node_has_svg_or_asset(root)
  debug_assert(has_svg && has_asset, "detected svg & asset class")

  let mirror = doc::Mirror::new()
  let doc_st = st.build_doc_state()
  debug_assert(mirror.diff(doc_st).is_none(), "diff before reset returns None")
  let wd = mirror.reset(doc_st)
  debug_assert(wd.base == "https://example.com/", "Mirror reset emitted WireDoc")
  match mirror.diff(st.build_doc_state()) {
    Option::Some(ops) => debug_assert(ops.length() == 0, "second diff with no change has 0 ops")
    Option::None => debug_assert(false, "expected Some([]) after reset")
  }

  st.element_states.set(root.uid.to_string(), 4)
  debug_assert(st.active_focus_uid() == root.uid, "active_focus_uid matches focused node")

  let js_map : Map[String, Int] = Map::new()
  js_map.set("12", root.uid)
  let soh = Bytes::new(1)
  soh[0] = 1.to_byte()
  let sep = soh.to_string()
  let (vuid, vmsg) = parse_validation_tip("12" + sep + "Please fill out this field.", js_map)
  debug_assert(vuid == root.uid && vmsg == "Please fill out this field.", "parse_validation_tip")

  st.storage_put("https://example.com", "token", Option::Some("abc"))
  let entries = st.storage_entries()
  match entries.get("https://example.com" + sep + "token") {
    Option::Some(v) => debug_assert(v == "abc", "storage_entries")
    Option::None => debug_assert(false, "storage_entries")
  }
}
