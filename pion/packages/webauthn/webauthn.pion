///| WebAuthn Level 3 software platform authenticator (P-256 ES256 & Ed25519 EdDSA).
///| 1:1 port of `src/page/webauthn.mbt` linking `src/page/webauthn.c` + BoringSSL natively.

extern "C" fn c_mb_len(p : Ptr) -> Int = "pion_wa_mb_len"

extern "C" fn c_mb_free(p : Ptr) -> Unit = "pion_wa_mb_free"

extern "C" fn c_sha256(data : Ptr, len : Int) -> Ptr = "pion_wa_sha256"

extern "C" fn c_random(n : Int) -> Ptr = "pion_wa_random"

extern "C" fn c_keygen(alg : Int) -> Ptr = "pion_wa_keygen"

extern "C" fn c_alg(pkcs8 : Ptr, len : Int) -> Int = "pion_wa_alg"

extern "C" fn c_sign(pkcs8 : Ptr, plen : Int, data : Ptr, dlen : Int) -> Ptr = "pion_wa_sign"

extern "C" fn c_save(path : Ptr, plen : Int, data : Ptr, dlen : Int) -> Int = "pion_wa_save"

extern "C" fn c_read_file(path : Ptr) -> Ptr = "pion_wa_read_file"

extern "C" fn c_verify(spki : Ptr, slen : Int, data : Ptr, dlen : Int, sig : Ptr, siglen : Int) -> Int = "pion_wa_verify"

extern "C" fn c_mkdir(dir : Ptr) -> Unit = "pion_wa_mkdir"

extern "C" fn c_unlink(path : Ptr) -> Unit = "pion_wa_unlink"

fn take_mb(p : Ptr) -> Bytes {
  let n = c_mb_len(p)
  let out = bytes_from_ptr(p, n)
  c_mb_free(p)
  out
}

///| Backing for empty inputs: C reads `len` bytes, so it never touches this; a global, so the pointer stays valid.
let empty_buf : Bytes = Bytes::new(1)

fn non_empty_ptr(b : Bytes) -> Ptr {
  if b.length() == 0 {
    bytes_data_ptr(empty_buf)
  } else {
    bytes_data_ptr(b)
  }
}

pub fn wa_sha256(data : Bytes) -> Bytes {
  take_mb(c_sha256(non_empty_ptr(data), data.length()))
}

pub fn wa_random(n : Int) -> Bytes {
  take_mb(c_random(n))
}

pub fn wa_keygen(alg : Int) -> Bytes {
  take_mb(c_keygen(alg))
}

pub fn wa_alg(pkcs8 : Bytes) -> Int {
  c_alg(non_empty_ptr(pkcs8), pkcs8.length())
}

pub fn wa_sign(pkcs8 : Bytes, data : Bytes) -> Bytes {
  take_mb(c_sign(non_empty_ptr(pkcs8), pkcs8.length(), non_empty_ptr(data), data.length()))
}

pub fn wa_save(path : String, data : Bytes) -> Bool {
  c_save(str_data_ptr(path), path.length(), non_empty_ptr(data), data.length()) == 1
}

pub fn wa_verify_raw(spki : Bytes, data : Bytes, sig : Bytes) -> Bool {
  c_verify(non_empty_ptr(spki), spki.length(), non_empty_ptr(data), data.length(), non_empty_ptr(sig), sig.length()) == 1
}

// --- Base64 & Base64URL ---

pub fn b64_encode(data : Bytes) -> String {
  let abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".to_bytes()
  let n = data.length()
  let groups = (n + 2) / 3
  let out = Bytes::new(groups * 4)
  let mut i = 0
  let mut o = 0
  while i < n {
    let b0 = data[i].to_int() & 0xFF
    let b1 = if i + 1 < n { data[i + 1].to_int() & 0xFF } else { 0 }
    let b2 = if i + 2 < n { data[i + 2].to_int() & 0xFF } else { 0 }
    out[o] = abc[b0 >> 2]
    out[o + 1] = abc[((b0 & 3) << 4) | (b1 >> 4)]
    out[o + 2] = if i + 1 < n { abc[((b1 & 15) << 2) | (b2 >> 6)] } else { (61).to_byte() }
    out[o + 3] = if i + 2 < n { abc[b2 & 63] } else { (61).to_byte() }
    i = i + 3
    o = o + 4
  }
  out.to_string()
}

pub fn b64url_encode(data : Bytes) -> String {
  let std = b64_encode(data).to_bytes()
  let out : Array[Int] = []
  let mut i = 0
  while i < std.length() {
    let c = std[i].to_int() & 0xFF
    if c == 43 {
      out.push(45)
    } else if c == 47 {
      out.push(95)
    } else if c != 61 {
      out.push(c)
    }
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j].to_byte()
    j = j + 1
  }
  res.to_string()
}

fn b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 || c == 45 {
    62
  } else if c == 47 || c == 95 {
    63
  } else {
    -1
  }
}

pub fn b64_decode(s : String) -> Bytes {
  let src = s.to_bytes()
  let out : Array[Int] = []
  let mut acc = 0
  let mut bits = 0
  let mut i = 0
  while i < src.length() {
    let c = src[i].to_int() & 0xFF
    if c == 61 {
      break
    }
    let v = b64_val(c)
    if v >= 0 {
      acc = (acc << 6) | v
      bits = bits + 6
      if bits >= 8 {
        bits = bits - 8
        out.push((acc >> bits) & 0xFF)
      }
    }
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j].to_byte()
    j = j + 1
  }
  res
}

pub fn b64_std(s : String) -> String {
  b64_encode(b64_decode(s))
}

// --- Growable ByteBuf + CBOR (RFC 8949) ---

struct ByteBuf {
  mut buf : Bytes
  mut n : Int
}

fn ByteBuf::new() -> ByteBuf {
  ByteBuf::{ buf: Bytes::new(128), n: 0 }
}

fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  if self.n + extra <= self.buf.length() {
    return
  }
  let mut cap = self.buf.length() * 2
  while cap < self.n + extra {
    cap = cap * 2
  }
  let bigger = Bytes::new(cap)
  let mut i = 0
  while i < self.n {
    bigger[i] = self.buf[i]
    i = i + 1
  }
  self.buf = bigger
}

fn ByteBuf::write_byte(self : ByteBuf, b : Int) -> Unit {
  self.ensure(1)
  self.buf[self.n] = (b & 0xFF).to_byte()
  self.n = self.n + 1
}

fn ByteBuf::write_bytes(self : ByteBuf, b : Bytes) -> Unit {
  let len = b.length()
  self.ensure(len)
  let mut i = 0
  while i < len {
    self.buf[self.n + i] = b[i]
    i = i + 1
  }
  self.n = self.n + len
}

fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  self.buf.slice(0, self.n)
}

fn cbor_head(b : ByteBuf, major : Int, n : Int) -> Unit {
  let m = major << 5
  if n < 24 {
    b.write_byte(m | n)
  } else if n < 256 {
    b.write_byte(m | 24)
    b.write_byte(n)
  } else if n < 65536 {
    b.write_byte(m | 25)
    b.write_byte(n >> 8)
    b.write_byte(n & 0xFF)
  } else {
    b.write_byte(m | 26)
    b.write_byte(n >> 24)
    b.write_byte((n >> 16) & 0xFF)
    b.write_byte((n >> 8) & 0xFF)
    b.write_byte(n & 0xFF)
  }
}

fn cbor_int(b : ByteBuf, v : Int) -> Unit {
  if v >= 0 {
    cbor_head(b, 0, v)
  } else {
    cbor_head(b, 1, -1 - v)
  }
}

fn cbor_bytes(b : ByteBuf, data : Bytes) -> Unit {
  cbor_head(b, 2, data.length())
  b.write_bytes(data)
}

fn cbor_text(b : ByteBuf, s : String) -> Unit {
  let data = s.to_bytes()
  cbor_head(b, 3, data.length())
  b.write_bytes(data)
}

fn be32(b : ByteBuf, v : Int) -> Unit {
  b.write_byte((v >> 24) & 0xFF)
  b.write_byte((v >> 16) & 0xFF)
  b.write_byte((v >> 8) & 0xFF)
  b.write_byte(v & 0xFF)
}

pub fn cose_key(alg : Int, spki : Bytes) -> Bytes {
  let b = ByteBuf::new()
  let n = spki.length()
  if alg == -8 {
    cbor_head(b, 5, 4)
    cbor_int(b, 1)
    cbor_int(b, 1)
    cbor_int(b, 3)
    cbor_int(b, -8)
    cbor_int(b, -1)
    cbor_int(b, 6)
    cbor_int(b, -2)
    cbor_bytes(b, spki.slice(n - 32, n))
  } else {
    cbor_head(b, 5, 5)
    cbor_int(b, 1)
    cbor_int(b, 2)
    cbor_int(b, 3)
    cbor_int(b, -7)
    cbor_int(b, -1)
    cbor_int(b, 1)
    cbor_int(b, -2)
    cbor_bytes(b, spki.slice(n - 64, n - 32))
    cbor_int(b, -3)
    cbor_bytes(b, spki.slice(n - 32, n))
  }
  b.to_bytes()
}

// --- Domain & RP helpers ---

fn to_ascii_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

pub fn domain_of(s : String) -> String {
  let k = s.index_of("://")
  let rest = if k >= 0 { s.slice(k + 3, s.length()) } else { s }
  let rb = rest.to_bytes()
  let mut end = rb.length()
  let mut i = 0
  while i < rb.length() {
    let c = rb[i].to_int() & 0xFF
    if c == 47 || c == 58 || c == 63 || c == 35 {
      end = i
      break
    }
    i = i + 1
  }
  to_ascii_lower(rest.slice(0, end))
}

pub fn rp_of_domain(rp : String, domain : String) -> Bool {
  let d0 = if domain.starts_with(".") { domain.slice(1, domain.length()) } else { domain }
  let d = to_ascii_lower(d0)
  d == "" || rp == d || rp.ends_with("." + d)
}

pub fn validate_origin_and_rp(origin : String, rp_asked : String) -> Result[String, String] {
  let host = domain_of(origin)
  let own = host == "localhost" || host.ends_with(".localhost") || host == "127.0.0.1" || host == "[::1]"
  if !(origin.starts_with("https://") || (origin.starts_with("http://") && own)) {
    return Result::Err("SecurityError: passkeys are for a secure page")
  }
  let rp = if rp_asked == "" { host } else { to_ascii_lower(rp_asked) }
  if !(host == rp || host.ends_with("." + rp)) || (!rp.contains(".") && rp != "localhost") {
    return Result::Err("SecurityError: " + rp + " is not this page's to name")
  }
  Result::Ok(rp)
}

fn json_escape(s : String) -> String {
  let b = s.to_bytes()
  let out : Array[Int] = [34]
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c == 34 || c == 92 {
      out.push(92)
      out.push(c)
    } else {
      out.push(c)
    }
    i = i + 1
  }
  out.push(34)
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j].to_byte()
    j = j + 1
  }
  res.to_string()
}

pub fn client_data_json(kind : String, challenge_b64url : String, origin : String) -> Bytes {
  ("{\"type\":" + json_escape(kind) + ",\"challenge\":" + json_escape(challenge_b64url) + ",\"origin\":" + json_escape(origin) + ",\"crossOrigin\":false}").to_bytes()
}

// --- Passkey Store & Authenticator ---

pub struct Passkey {
  pub id : String
  pub rp : String
  pub key : String
  pub user : String
  pub mut count : Int
}

pub struct CreateResult {
  pub id : String
  pub client_data_json : Bytes
  pub attestation_object : Bytes
  pub authenticator_data : Bytes
  pub public_key_spki : Bytes
  pub alg : Int
}

pub struct GetResult {
  pub id : String
  pub client_data_json : Bytes
  pub authenticator_data : Bytes
  pub signature : Bytes
  pub user_handle : String
  pub sign_count : Int
}

pub struct Authenticator {
  pub storage_path : String
  pub mut keys : Array[Passkey]
}

fn serialize_store(keys : Array[Passkey]) -> String {
  // Compact TSV-per-line store (safe base64 + rp + count) for zero-dependency persistence.
  let lines : Array[String] = []
  let mut i = 0
  while i < keys.length() {
    let p = keys[i]
    lines.push(p.id + "\t" + p.rp + "\t" + p.key + "\t" + p.user + "\t" + p.count.to_string())
    i = i + 1
  }
  lines.join("\n")
}

fn parse_store(text : String) -> Array[Passkey] {
  let out : Array[Passkey] = []
  if text == "" {
    return out
  }
  let lines = text.split("\n")
  let mut i = 0
  while i < lines.length() {
    let line = lines[i].trim()
    if line != "" {
      let f = line.split("\t")
      if f.length() >= 5 {
        let cnt = match f[4].to_int() {
          Option::Some(v) => v
          Option::None => 0
        }
        out.push(Passkey::{ id: f[0], rp: f[1], key: f[2], user: f[3], count: cnt })
      }
    }
    i = i + 1
  }
  out
}

pub fn Authenticator::new_memory() -> Authenticator {
  Authenticator::{ storage_path: "", keys: [] }
}

pub fn Authenticator::open_file(path : String) -> Authenticator {
  let raw = take_mb(c_read_file(str_data_ptr(path)))
  let keys = if raw.length() > 0 { parse_store(raw.to_string()) } else { [] }
  Authenticator::{ storage_path: path, keys: keys }
}

fn Authenticator::reload(self : Authenticator) -> Unit {
  if self.storage_path != "" {
    let raw = take_mb(c_read_file(str_data_ptr(self.storage_path)))
    if raw.length() > 0 {
      self.keys = parse_store(raw.to_string())
    }
  }
}

pub fn Authenticator::persist(self : Authenticator) -> Bool {
  if self.storage_path == "" {
    return true
  }
  wa_save(self.storage_path, serialize_store(self.keys).to_bytes())
}

pub fn Authenticator::create(
  self : Authenticator,
  origin : String,
  rp_asked : String,
  user_id_b64 : String,
  challenge_b64url : String,
  alg : Int,
  exclude_ids : Array[String],
) -> Result[CreateResult, String] {
  let rp = match validate_origin_and_rp(origin, rp_asked) {
    Result::Ok(r) => r
    Result::Err(e) => return Result::Err(e)
  }
  if user_id_b64 == "" {
    return Result::Err("TypeError: the user has no id")
  }
  if alg != -7 && alg != -8 {
    return Result::Err("NotSupportedError: unsupported alg")
  }
  self.reload()
  let mut ei = 0
  while ei < exclude_ids.length() {
    let ex_std = b64_std(exclude_ids[ei])
    let mut ki = 0
    while ki < self.keys.length() {
      if self.keys[ki].rp == rp && b64_std(self.keys[ki].id) == ex_std {
        return Result::Err("InvalidStateError: a passkey of this account is here already")
      }
      ki = ki + 1
    }
    ei = ei + 1
  }
  let made = wa_keygen(alg)
  let id = wa_random(16)
  if made.length() < 3 || id.length() != 16 {
    return Result::Err("UnknownError: no key could be made")
  }
  let n8 = ((made[0].to_int() & 0xFF) << 8) | (made[1].to_int() & 0xFF)
  let pkcs8 = made.slice(2, 2 + n8)
  let spki = made.slice(2 + n8, made.length())
  let cose = cose_key(alg, spki)

  // authenticatorData (WebAuthn §6.1)
  let auth = ByteBuf::new()
  auth.write_bytes(wa_sha256(rp.to_bytes()))
  auth.write_byte(0x45)
  be32(auth, 0)
  let mut z = 0
  while z < 16 {
    auth.write_byte(0)
    z = z + 1
  }
  auth.write_byte(0)
  auth.write_byte(16)
  auth.write_bytes(id)
  auth.write_bytes(cose)
  let auth_data = auth.to_bytes()

  // attestationObject "none" (WebAuthn §8.7)
  let att = ByteBuf::new()
  cbor_head(att, 5, 3)
  cbor_text(att, "fmt")
  cbor_text(att, "none")
  cbor_text(att, "attStmt")
  cbor_head(att, 5, 0)
  cbor_text(att, "authData")
  cbor_bytes(att, auth_data)

  let user_std = b64_std(user_id_b64)
  let kept = Passkey::{ id: b64_encode(id), rp: rp, key: b64_encode(pkcs8), user: user_std, count: 0 }
  let next : Array[Passkey] = []
  let mut i = 0
  while i < self.keys.length() {
    let p = self.keys[i]
    if !(p.rp == rp && p.user == user_std) {
      next.push(p)
    }
    i = i + 1
  }
  next.push(kept)
  self.keys = next
  if !self.persist() {
    return Result::Err("UnknownError: the passkey could not be kept")
  }
  let cdata = client_data_json("webauthn.create", challenge_b64url, origin)
  Result::Ok(
    CreateResult::{
      id: b64url_encode(id),
      client_data_json: cdata,
      attestation_object: att.to_bytes(),
      authenticator_data: auth_data,
      public_key_spki: spki,
      alg: alg,
    },
  )
}

pub fn Authenticator::get(
  self : Authenticator,
  origin : String,
  rp_asked : String,
  challenge_b64url : String,
  allow_ids : Array[String],
) -> Result[GetResult, String] {
  let rp = match validate_origin_and_rp(origin, rp_asked) {
    Result::Ok(r) => r
    Result::Err(e) => return Result::Err(e)
  }
  self.reload()
  let mut pick = -1
  let mut i = 0
  while i < self.keys.length() {
    let p = self.keys[i]
    if p.rp == rp {
      if allow_ids.length() == 0 {
        pick = i
      } else {
        let p_std = b64_std(p.id)
        let mut ai = 0
        while ai < allow_ids.length() {
          if b64_std(allow_ids[ai]) == p_std {
            pick = i
          }
          ai = ai + 1
        }
      }
    }
    i = i + 1
  }
  if pick < 0 {
    return Result::Err("NotAllowedError: no passkey here is for " + rp)
  }
  let p = self.keys[pick]
  let count = p.count + 1
  let auth = ByteBuf::new()
  auth.write_bytes(wa_sha256(rp.to_bytes()))
  auth.write_byte(0x05)
  be32(auth, count)
  let auth_data = auth.to_bytes()
  let cdata = client_data_json("webauthn.get", challenge_b64url, origin)
  let signed = ByteBuf::new()
  signed.write_bytes(auth_data)
  signed.write_bytes(wa_sha256(cdata))
  let sig = wa_sign(b64_decode(p.key), signed.to_bytes())
  if sig.length() == 0 {
    return Result::Err("NotAllowedError: signing failed")
  }
  p.count = count
  if !self.persist() {
    return Result::Err("UnknownError: could not persist signCount")
  }
  Result::Ok(
    GetResult::{
      id: b64url_encode(b64_decode(p.id)),
      client_data_json: cdata,
      authenticator_data: auth_data,
      signature: sig,
      user_handle: b64url_encode(b64_decode(p.user)),
      sign_count: count,
    },
  )
}

pub fn verify_assertion(spki : Bytes, authenticator_data : Bytes, cdata : Bytes, signature : Bytes) -> Bool {
  let signed = ByteBuf::new()
  signed.write_bytes(authenticator_data)
  signed.write_bytes(wa_sha256(cdata))
  wa_verify_raw(spki, signed.to_bytes(), signature)
}
