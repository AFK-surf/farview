test "Wave 2: AudioWorklet/AudioWorkletNode port round-trip, dataset.hasOwnProperty, window _-prefixed named access, and MSE/video APIs" {
  js::start_raw(c_fn_ptr(w2_mock_host))
  js::start_int_raw(c_fn_ptr(w76_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "if (typeof AudioWorklet !== 'function' || typeof AudioWorkletNode !== 'function' || typeof AudioWorkletProcessor !== 'function') return 'missing-aw';" +
    "const d = document.createElement('div');" +
    "if (typeof d.dataset.hasOwnProperty !== 'function' || d.dataset.hasOwnProperty('clientId') !== false) return 'bad-dataset-hasOwn';" +
    "const fnEl = window.__framer__appearAnimationsContent;" +
    "if (!fnEl || fnEl._id !== 70) return 'bad-win-underscore-named';" +
    "if (window.__fvInternalShouldSkip !== undefined) return 'bad-fv-skip';" +
    "const v = document.createElement('video');" +
    "if (typeof v.getVideoPlaybackQuality !== 'function' || typeof v.requestVideoFrameCallback !== 'function') return 'missing-video-apis';" +
    "const q = v.getVideoPlaybackQuality();" +
    "if (q.droppedVideoFrames !== 0 || typeof q.totalVideoFrames !== 'number') return 'bad-vpq';" +
    "const ms = new MediaSource(); ms._readyState = 'open';" +
    "const sb = ms.addSourceBuffer('video/webm; codecs=\"vp9\"');" +
    "if (typeof sb.changeType !== 'function') return 'missing-changeType';" +
    "sb.changeType('video/mp4; codecs=\"avc1.42E01E\"');" +
    "const ctx = new AudioContext();" +
    "if (!(ctx.audioWorklet instanceof AudioWorklet)) return 'bad-aw-inst';" +
    "const modSrc = 'class EchoProc extends AudioWorkletProcessor { static get parameterDescriptors() { return [{ name: \"gain\", defaultValue: 0.5, minValue: 0, maxValue: 1 }]; } constructor(opts) { super(); this.port.onmessage = (e) => { this.port.postMessage({ echo: e.data, opt: opts.processorOptions && opts.processorOptions.tag }); }; } process() { return true; } } registerProcessor(\"echo-proc\", EchoProc);';" +
    "const url = 'data:application/javascript,' + encodeURIComponent(modSrc);" +
    "globalThis.__awDone = '';" +
    "ctx.audioWorklet.addModule(url).then(() => {" +
    "  const node = new AudioWorkletNode(ctx, 'echo-proc', { processorOptions: { tag: 'meet' }, parameterData: { gain: 0.75 } });" +
    "  if (!(node instanceof AudioNode) || !(node.parameters instanceof Map)) { globalThis.__awDone = 'bad-node'; return; }" +
    "  if (node.parameters.get('gain').value !== 0.75) { globalThis.__awDone = 'bad-param'; return; }" +
    "  node.connect(ctx.destination); node.disconnect();" +
    "  node.port.onmessage = (ev) => { globalThis.__awDone = ev.data && ev.data.echo === 'ping' && ev.data.opt === 'meet' ? 'ok' : 'bad-msg'; };" +
    "  node.port.postMessage('ping');" +
    "}).catch(e => { globalThis.__awDone = 'err:' + e; });" +
    "return 'started';" +
    "})()",
  )
  debug_assert(r == "started", "Wave 2 setup failed: " + r)
  let _ = js::run("__tick(50)")
  let done = js::run("globalThis.__awDone")
  debug_assert(done == "ok", "AudioWorklet round-trip failed: " + done)
}

