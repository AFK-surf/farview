test "Wave 79A fvVer[2] isConnected cache + detach invalidation, template.content preserves single-doc ownerDocument, and fvVer[0] parentNode cache" {
  w79_rootof_calls[0] = 0
  w79_parent_calls[0] = 0
  w79_dom_ver[0] = 1
  w79_detach_ver[0] = 1
  w79_parent_of_40[0] = 0
  w79_parent_of_41[0] = 0
  js::start_raw(c_fn_ptr(w79_mock_host))
  js::start_int_raw(c_fn_ptr(w79_mock_int))
  js::new_context()
  js::set_dom_version(1)
  js::set_doc_names_version(1)
  js::set_detach_version(1)
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)

  w79_rootof_calls[0] = 0
  w79_parent_calls[0] = 0
  let r1 = js::run(
    "(() => {" +
    "const tpl = document.createElement('template');" +
    "const frag = tpl.content;" +
    "const d = document.createElement('div');" +
    "const s = document.createElement('span');" +
    "const okOwner = frag.ownerDocument === document && d.ownerDocument === document && s.ownerDocument === document;" +
    "document.appendChild(d);" +
    "d.appendChild(s);" +
    "const c1 = d.isConnected && s.isConnected && d.isConnected && s.isConnected;" +
    "const p1 = d.parentNode === document && d.parentNode === document && s.parentNode === d && s.parentNode === d;" +
    "d.remove();" +
    "const c2 = !d.isConnected && !s.isConnected && d.parentNode === null;" +
    "return okOwner && c1 && p1 && c2 ? 'ok' : [okOwner, c1, p1, c2].join(',');" +
    "})()",
  )
  debug_assert(r1 == "ok", "Wave 79A fast paths failed: " + r1)
  // template.content must NOT poison hasOtherDocs; isConnected propagation + fvVer[2] avoids repeated OP.ROOTOF;
  // only the post-detach isConnected checks on d and s should hit OP.ROOTOF (2 calls).
  debug_assert(w79_rootof_calls[0] == 2, "expected exactly 2 OP.ROOTOF calls (post-detach), got " + w79_rootof_calls[0].to_string())
  js::set_dom_version(0)
  js::set_doc_names_version(0)
  js::set_detach_version(0)
}

