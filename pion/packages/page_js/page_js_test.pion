  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "  const dRect = Object.getOwnPropertyDescriptor(globalThis, 'DOMRect');" +
    "  if (!dRect || dRect.enumerable !== false) return 'bad-domrect-enum';" +
    "  if (Object.prototype.toString.call(new DOMRect()) !== '[object DOMRect]') return 'bad-domrect-tag';" +
    "  const dSvg = Object.getOwnPropertyDescriptor(globalThis, 'SVGSVGElement');" +
    "  if (!dSvg || dSvg.enumerable !== false) return 'bad-svg-enum';" +
    "  if (SVGSVGElement.prototype[Symbol.toStringTag] !== 'SVGSVGElement') return 'bad-svg-tag';" +
    "  const dLen = Object.getOwnPropertyDescriptor(globalThis, 'SVGLength');" +
    "  if (!dLen || dLen.enumerable !== false) return 'bad-svglen-enum';" +
    "  if (SVGLength.prototype[Symbol.toStringTag] !== 'SVGLength') return 'bad-svglen-tag';" +
    "  if (typeof WebGLRenderingContext.prototype.clear !== 'function') return 'bad-gl';" +
    "  if (WebGLRenderingContext.prototype.hint !== WebGL2RenderingContext.prototype.beginQuery) return 'bad-glnoop';" +
    "  if (Object.prototype.hasOwnProperty.call(Element.prototype, 'ontouchstart')) return 'bad-touch-el';" +
    "  if (Object.prototype.hasOwnProperty.call(Document.prototype, 'ontouchstart')) return 'bad-touch-doc';" +
    "  if (!Object.prototype.hasOwnProperty.call(Element.prototype, 'onclick')) return 'bad-click-el';" +
    "  if (!Object.prototype.hasOwnProperty.call(Document.prototype, 'onclick')) return 'bad-click-doc';" +
    "  return 'ok';" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 89A WebIDL descriptors test failed: " + r)
}

test "Wave 11C: CSSStyleDeclaration prototype isolation, Element.prototype.style brand check & structuredClone WebAssembly.Module/SAB" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
