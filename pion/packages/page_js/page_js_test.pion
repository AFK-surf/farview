  }
}

test "Wave 78A ownerDocument fast path + cross-doc fallback, _check leaf/noKids OP 112 skip, insertedKinds OP 110 b=2, and fvVer[1] docNamed" {
  w78_rootof_calls[0] = 0
  w78_c112_calls[0] = 0
  w78_qsa_calls[0] = 0
  w78_named_calls[0] = 0
  js::start_raw(c_fn_ptr(w78_mock_host))
  js::start_int_raw(c_fn_ptr(w78_mock_int))
  js::new_context()
  js::set_dom_version(1)
  js::set_doc_names_version(1)
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)

  // 1. Single-doc ownerDocument uses 0 OP.ROOTOF; docNamed caches across fvVer[1]
  w78_rootof_calls[0] = 0
  w78_c112_calls[0] = 0
  w78_qsa_calls[0] = 0
  w78_named_calls[0] = 0
  let r1 = js::run(
    "(() => {" +
    "const d = document.createElement('div'); const s = document.createElement('span'); const t = document.createTextNode('hi');" +
    "const okOwner = d.ownerDocument === document && t.ownerDocument === document;" +
    "d.appendChild(t); d.appendChild(s);" +
    "let selfCycle = false; try { d.appendChild(d); } catch (e) { selfCycle = e.name === 'HierarchyRequestError'; }" +
    "const dn1 = document.getAttribute, dn2 = document.getAttribute;" +
    "return okOwner && selfCycle && dn1 === undefined && dn2 === undefined ? 'ok' : 'bad';" +
    "})()",
  )
  debug_assert(r1 == "ok", "Wave 78A fast paths failed: " + r1)
  debug_assert(w78_c112_calls[0] == 0, "leaf + fresh noKids + self must skip OP 112, calls=" + w78_c112_calls[0].to_string())
  debug_assert(w78_qsa_calls[0] == 0, "insertedKinds OP 110 b=2 must skip OP.QSA, calls=" + w78_qsa_calls[0].to_string())
  debug_assert(w78_named_calls[0] == 1, "fvVer[1] docNamed must cache negative lookup, calls=" + w78_named_calls[0].to_string())

  // 2. Real cycle on non-empty parent DOES invoke OP 112 and throws HierarchyRequestError
  let r2 = js::run(
    "(() => {" +
    "const d = document.createElement('div'); const s = document.createElement('span');" +
    "d.appendChild(s);" +
    "let cyc = false; try { s.appendChild(d); } catch (e) { cyc = e.name === 'HierarchyRequestError'; }" +
    "return cyc ? 'ok' : 'bad';" +
    "})()",
  )
  debug_assert(r2 == "ok" && w78_c112_calls[0] == 1, "real cycle must call OP 112 and throw")

  // 3. Cross-doc creation (createHTMLDocument) disables single-doc ownerDocument fast path
  let r3 = js::run(
    "(() => {" +
    "const d2 = document.implementation.createHTMLDocument('sub');" +
    "const el = d2.createElement('p');" +
    "return el.ownerDocument === d2 ? 'ok' : 'bad';" +
    "})()",
  )
  debug_assert(r3 == "ok", "cross-doc ownerDocument fallback failed: " + r3)
  js::set_dom_version(0)
  js::set_doc_names_version(0)
}

