  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const protoOk = CSSStyleDeclaration.prototype !== Object.prototype;" +
    "let brandErr = false; try { void Element.prototype.style; } catch (e) { brandErr = e instanceof TypeError; }" +
    "const d = document.createElement('div');" +
    "const instOk = d.style instanceof CSSStyleDeclaration;" +
    "CSSStyleDeclaration.prototype.__w11cHelper = function() { return 'delegated'; };" +
    "const delOk = typeof d.style.__w11cHelper === 'function' && d.style.__w11cHelper() === 'delegated';" +
    "delete CSSStyleDeclaration.prototype.__w11cHelper;" +
    "const u8 = new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0]);" +
    "const cloned = structuredClone({ wasm: u8 });" +
    "const binOk = cloned.wasm instanceof Uint8Array && cloned.wasm.length === 8 && cloned.wasm[1] === 97 && cloned.wasm !== u8;" +
    "const wm = new WebAssembly.Module(u8);" +
    "const wmOk = structuredClone(wm) === wm;" +
    "const ok = protoOk && brandErr && instOk && delOk && binOk && wmOk;" +
    "return ok ? 'ok' : JSON.stringify({protoOk, brandErr, instOk, delOk, binOk, wmOk});" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 11C prelude test failed: " + r)
}

test "Wave 13C: HTMLScriptElement.supports('importmap') & classic Worker global scope + async onmessage reassignment" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let _ = js::run("__setUrl('https://example.com/')")
  let r = js::run(
    "(() => {" +
    "const supOk = HTMLScriptElement.supports('classic') === true && HTMLScriptElement.supports('module') === true && HTMLScriptElement.supports('importmap') === true && HTMLScriptElement.supports('bogus') === false;" +
    "const fr = document.createElement('iframe'); fr.setAttribute('src', 'https://other.example/'); document.body && document.body.appendChild(fr);" +
    "const locOk = typeof fr.contentWindow === 'object' && (!fr.contentWindow || typeof fr.contentWindow.location.reload === 'function' && typeof fr.contentWindow.location.replace === 'function' && typeof fr.contentWindow.location.assign === 'function');" +
    "globalThis.__w13cOut = [];" +
    "const src = '(function(){ (typeof self !== \"undefined\" ? self : this).myLib = { v: 42 }; })(); onmessage = function(e) { const winUndef = typeof window === \"undefined\" && typeof document === \"undefined\"; Promise.resolve().then(() => { onmessage = function(e2) { postMessage([\"step2\", e2.data, myLib.v]); }; postMessage([\"step1\", e.data, myLib.v, winUndef]); }); };';" +
    "const u = URL.createObjectURL(new Blob([src], { type: 'application/javascript' }));" +
    "const w = new Worker(u);" +
    "w.onerror = e => { globalThis.__w13cOut.push(['err', e.message]); };" +
    "w.onmessage = ev => { globalThis.__w13cOut.push(ev.data); if (ev.data[0] === 'step1') w.postMessage('hi2'); };" +
    "w.postMessage('hi1');" +
    "const src2 = 'function onmessage(e) { postMessage(\"fn:\" + e.data); }';" +
    "const w2 = new Worker(URL.createObjectURL(new Blob([src2], { type: 'application/javascript' })));" +
    "w2.onerror = e => { globalThis.__w13cOut.push(['err2', e.message]); };" +
    "w2.onmessage = ev => { globalThis.__w13cOut.push(ev.data); };" +
    "w2.postMessage('ok');" +
    "return supOk && locOk ? 'started' : 'bad-supports';" +
    "})()",
  )
  debug_assert(r == "started", "Wave 13C setup failed: " + r)
  let mut i = 0
  while i < 8 {
    let _ = js::run("__tick(50)")
    i = i + 1
  }
  let res = js::run("JSON.stringify([globalThis.__w13cOut, globalThis.__errors || []])")
  debug_assert(
    res.contains("[\"step1\",\"hi1\",42,true]") &&
    res.contains("[\"step2\",\"hi2\",42]") &&
    res.contains("\"fn:ok\""),
    "Wave 13C classic Worker test failed: " + res,
  )
}

test "Wave 16C: Web Audio WebIDL prototype accessor descriptors for standardized-audio-context" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const ctx = new AudioContext();" +
    "const g = ctx.createGain();" +
    "const ws = ctx.createWaveShaper();" +
    "const bs = ctx.createBufferSource();" +
    "const an = ctx.createAnalyser();" +
    "const findDesc = (obj, prop) => { let p = Object.getPrototypeOf(obj); while (p && !Object.prototype.hasOwnProperty.call(p, prop)) p = Object.getPrototypeOf(p); return p ? Object.getOwnPropertyDescriptor(p, prop) : null; };" +
    "const dCh = findDesc(g, 'channelCount');" +
    "const dVal = findDesc(g.gain, 'value');" +
    "const dCurve = findDesc(ws, 'curve');" +
    "const dBuf = findDesc(bs, 'buffer');" +
    "const dFft = findDesc(an, 'fftSize');" +
    "const dOnEnded = findDesc(bs, 'onended');" +
    "const dOnState = findDesc(ctx, 'onstatechange');" +
    "g.channelCount = 1; g.gain.value = 0.5; an.fftSize = 1024;" +
    "const ok = !!(dCh && dCh.get && dCh.set && dVal && dVal.get && dVal.set && dCurve && dCurve.get && dCurve.set && dBuf && dBuf.get && dBuf.set && dFft && dFft.get && dFft.set && dOnEnded && dOnEnded.get && dOnEnded.set && dOnState && dOnState.get && dOnState.set) && g.channelCount === 1 && g.gain.value === 0.5 && an.fftSize === 1024 && an.frequencyBinCount === 512;" +
    "return ok ? 'ok' : 'bad';" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 16C Web Audio WebIDL prototype descriptor test failed: " + r)
}

