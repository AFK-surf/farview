test "Wave 2: WebGL2 texStorage2D allocates mip levels and texSubImage2D uploads HTMLImageElement via texSubImage2D_el" {
  w2_gl_ops.clear()
  js::start_raw(c_fn_ptr(w2_gl_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const c = document.createElement('canvas'); c.width = 64; c.height = 64;" +
    "const gl = c.getContext('webgl2');" +
    "if (!gl) return 'no-gl2';" +
    "gl.texStorage2D(gl.TEXTURE_2D, 3, gl.SRGB8_ALPHA8, 16, 16);" +
    "const img = document.createElement('img');" +
    "gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, gl.RGBA, gl.UNSIGNED_BYTE, img);" +
    "gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, 16, 16, gl.RGBA, gl.UNSIGNED_BYTE, img);" +
    "return 'ok';" +
    "})()",
  )
  debug_assert(r == "ok", "texStorage2D/texSubImage2D JS failed: " + r)
  let mut tex_allocs = 0
  let mut sub_el = 0
  for op in w2_gl_ops {
    if op.contains("\"k\":\"texImage2D\"") && op.contains("\"has\":0") {
      tex_allocs = tex_allocs + 1
    }
    if op.contains("\"k\":\"texSubImage2D_el\"") && op.contains("\"n\":81") {
      sub_el = sub_el + 1
    }
  }
  debug_assert(tex_allocs == 3, "texStorage2D must allocate 3 mip levels, got " + tex_allocs.to_string())
  debug_assert(sub_el == 2, "texSubImage2D 7-arg and 9-arg must emit texSubImage2D_el, got " + sub_el.to_string())
}

let w6_next_id : Array[Int] = [100]
let w6_geta_calls : Array[Int] = [0]
let w6_dela_calls : Array[Int] = [0]

extern "C" fn w6_mock_host(op : Int, a : Int, _b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 2 || op == 3 || op == 26 {
    let id = w6_next_id[0]
    w6_next_id[0] = id + 1
    id.to_string()
  } else if op == 11 {
    w6_geta_calls[0] = w6_geta_calls[0] + 1
    "\u{00}"
  } else if op == 13 {
    w6_dela_calls[0] = w6_dela_calls[0] + 1
    ""
  } else if op == 126 {
    // OP.PATH: non-shadow path with no inline on<type> attributes ('N')
    "N" + a.to_string() + ",1,W"
  } else {
    ""
  }
}

extern "C" fn w6_mock_int(op : Int, a : Int, _b : Int) -> Int {
  if op == 2 || op == 3 || op == 26 {
    let id = w6_next_id[0]
    w6_next_id[0] = id + 1
    id
  } else if op == 7 {
    if a == 1 {
      9
    } else {
      1
    }
  } else {
    0
  }
}

test "Wave 6: monomorphic Element/Event/NodeList shapes, classList/className fast paths, and skipAttr dispatch" {
  w6_next_id[0] = 100
  w6_geta_calls[0] = 0
  w6_dela_calls[0] = 0
  js::start_raw(c_fn_ptr(w6_mock_host))
  js::start_int_raw(c_fn_ptr(w6_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const d = document.createElement('div');" +
    "if (!(d instanceof HTMLDivElement) || !(d instanceof HTMLElement) || !(d instanceof Element) || !(d instanceof Node)) return 'bad-proto';" +
    "if (d.nodeType !== 1 || d.tagName !== 'DIV' || d.localName !== 'div') return 'bad-meta';" +
    "d.removeAttribute('nonexistent');" +
    "d.className = 'alpha'; if (d.className !== 'alpha' || d.getAttribute('class') !== 'alpha') return 'bad-cn';" +
    "d.classList.add('beta'); if (!d.classList.contains('alpha') || !d.classList.contains('beta')) return 'bad-cl-add';" +
    "d.classList.toggle('alpha'); if (d.classList.contains('alpha') || d.className !== 'beta') return 'bad-cl-tog1';" +
    "d.classList.toggle('alpha'); if (!d.classList.contains('alpha')) return 'bad-cl-tog2';" +
    "d.classList.remove('beta'); if (d.classList.contains('beta') || d.className !== 'alpha') return 'bad-cl-rem';" +
    "d.id = 'hero'; if (d.id !== 'hero' || d.getAttribute('id') !== 'hero') return 'bad-id';" +
    "const nl = document.querySelectorAll('div'); if (Object.keys(nl).includes('_a')) return 'bad-nl-enum';" +
    "let clicks = 0, onClicks = 0;" +
    "d.addEventListener('click', () => clicks++);" +
    "d.onclick = () => onClicks++;" +
    "const ev = new MouseEvent('click', { bubbles: true, clientX: 12, clientY: 34, shiftKey: true });" +
    "if (ev.clientX !== 12 || ev.clientY !== 34 || !ev.shiftKey || ev.ctrlKey) return 'bad-mev';" +
    "d.dispatchEvent(ev);" +
    "if (clicks !== 1 || onClicks !== 1) return 'bad-dispatch:' + clicks + ',' + onClicks;" +
    "const t = document.createTextNode('hello'); if (!(t instanceof Text) || t.nodeType !== 3) return 'bad-text';" +
    "return 'ok';" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 6 checks failed: " + r)
  debug_assert(w6_geta_calls[0] == 0, "Wave 6 skipAttr + _acFull must avoid redundant OP.GETA, got " + w6_geta_calls[0].to_string())
  debug_assert(w6_dela_calls[0] == 0, "Wave 6 removeAttribute on absent attr must avoid OP.DELA, got " + w6_dela_calls[0].to_string())
}
