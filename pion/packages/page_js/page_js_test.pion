test "Wave 4C: CompressionStream and DecompressionStream round-trip gzip/deflate/deflate-raw and Response.body.pipeThrough" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let _ = js::run(
    "(() => {" +
    "globalThis.__zRes = 'pending';" +
    "(async () => {" +
    "  const hiddenOk = typeof globalThis.__fvZlib === 'undefined';" +
    "  let badFmt = false; try { new CompressionStream('br'); } catch (e) { badFmt = e instanceof TypeError; }" +
    "  let badFmt2 = false; try { new DecompressionStream('unknown'); } catch (e) { badFmt2 = e instanceof TypeError; }" +
    "  const payload = 'Hello Farview CompressionStream! '.repeat(200);" +
    "  for (const fmt of ['gzip', 'deflate', 'deflate-raw']) {" +
    "    const comp = new Response(payload).body.pipeThrough(new CompressionStream(fmt));" +
    "    const compBuf = await new Response(comp).arrayBuffer();" +
    "    if (compBuf.byteLength === 0 || compBuf.byteLength >= payload.length) throw new Error('bad comp size for ' + fmt + ': ' + compBuf.byteLength);" +
    "    const decomp = new Response(compBuf).body.pipeThrough(new DecompressionStream(fmt));" +
    "    const out = await new Response(decomp).text();" +
    "    if (out !== payload) throw new Error('round-trip mismatch for ' + fmt);" +
    "  }" +
    "  let badData = false; try { const d = new Response(new Uint8Array([1,2,3,4,5])).body.pipeThrough(new DecompressionStream('gzip')); await new Response(d).arrayBuffer(); } catch (e) { badData = true; }" +
    "  const roOk = 'ResizeObserverEntry' in globalThis && 'contentBoxSize' in ResizeObserverEntry.prototype && 'borderBoxSize' in ResizeObserverEntry.prototype;" +
    "  globalThis.__zRes = (hiddenOk && badFmt && badFmt2 && badData && roOk) ? 'ok' : [hiddenOk, badFmt, badFmt2, badData, roOk].join(',');" +
    "})().catch(e => { globalThis.__zRes = 'ERR:' + e.message; });" +
    "})()",
  )
  let _ = js::run("__fvDrain()")
  let r = js::run("String(globalThis.__zRes)")
  debug_assert(r == "ok", "CompressionStream/DecompressionStream test failed: " + r)
}

test "Wave 10C: WebIDL §3.7.4 prototype enumerability & Window EventTarget inheritance" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const keys = []; for (const k in CanvasRenderingContext2D.prototype) keys.push(k);" +
    "const hasCanvasOps = keys.includes('beginPath') && keys.includes('moveTo') && keys.includes('bezierCurveTo') && keys.includes('stroke');" +
    "const noPrivate = !keys.includes('constructor') && !keys.some(k => k.startsWith('_'));" +
    "const nodeKeys = []; for (const k in Node.prototype) nodeKeys.push(k);" +
    "const hasNodeOps = nodeKeys.includes('appendChild') && nodeKeys.includes('removeChild');" +
    "const sameAdd = window.addEventListener === EventTarget.prototype.addEventListener;" +
    "const notOwn = !Object.prototype.hasOwnProperty.call(window, 'addEventListener');" +
    "const nativeAdd = window.addEventListener;" +
    "let bypass = false, fired = 0;" +
    "EventTarget.prototype.addEventListener = function(t, fn, o) { nativeAdd.call(this, t, function(e) { if (bypass) return fn.call(this, e); }, o); };" +
    "nativeAdd.call(window, 'w10c-load', function() { if (!bypass) fired++; });" +
    "window.dispatchEvent(new Event('w10c-load'));" +
    "const ok = hasCanvasOps && noPrivate && hasNodeOps && sameAdd && notOwn && fired === 1;" +
    "return ok ? 'ok' : JSON.stringify({hasCanvasOps, noPrivate, hasNodeOps, sameAdd, notOwn, fired});" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 10C prelude test failed: " + r)
}

test "Wave 89A: defGlobals, SVG iface/valueClass, glNoop, and desktop touchProtos preserve WebIDL descriptors" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
