test "Wave 2C: styleProxy preserves semicolons inside quoted data:image/svg+xml;base64 URLs" {
  w2c_id_seq[0] = 42
  w2c_style_attr[0] = ""
  w2c_style_attr[1] = ""
  js::start_raw(c_fn_ptr(style_data_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const d = document.createElement('div');" +
    "const bg = 'url(\"data:image/svg+xml;base64,PHN2Zz48L3N2Zz4=\")';" +
    "d.style.backgroundImage = bg;" +
    "d.style.backgroundColor = 'light-dark(#ffffff, #121212)';" +
    "const attr = d.getAttribute('style') || '';" +
    "const ok1 = attr.includes('data:image/svg+xml;base64,PHN2Zz48L3N2Zz4=') && !attr.includes('base64,PHN2Zz48L3N2Zz4=\":');" +
    "const ok2 = d.style.backgroundColor === 'light-dark(#ffffff, #121212)';" +
    "d.style.cssText = 'background-image: ' + bg + '; color: red;';" +
    "const ok3 = d.style.color === 'red' && (d.getAttribute('style') || '').includes('data:image/svg+xml;base64,');" +
    "return ok1 && ok2 && ok3 ? 'ok' : attr;" +
    "})()",
  )
  debug_assert(r == "ok", "styleProxy corrupted data:base64 URL: " + r)
}

