///| Unit tests for `page_js`: SHA-256 byte-exact match against `js/prelude.js` & `js/editing.js`,
///| plus real V8 execution of the full prelude + editing scripts via P26-B `c_fn_ptr`.

import "js"

extern "C" fn prelude_mock_host(op : Int, _a : Int, _b : Int, _s : String, _t : String) -> String {
  if op == 1 {
    // OP.VERSION / basic node queries
    "1"
  } else if op == 20 {
    // document URL
    "https://example.com/"
  } else if op == 11 {
    // innerHTML / text
    ""
  } else if op == 24 && _a == 3 && _s.starts_with("blob:") {
    _s + "\u{01}blob:\u{01}\u{01}\u{01}\u{01}\u{01}\u{01}\u{01}\u{01}\u{01}https://example.com"
  } else if op == 41 && _s == "transform" {
    "transform\u{01}initial"
  } else if op == 42 && _a == 2 && (_s == "transform" || _s == "flex") {
    "1"
  } else {
    ""
  }
}

extern "C" fn prelude_mock_int(_op : Int, _a : Int, _b : Int) -> Int {
  0
}

test "prelude_js and editing_js match js/prelude.js and js/editing.js SHA-256 byte-for-byte" {
  let p = prelude_js()
  let e = editing_js()
  debug_assert(p.length() > 500000, "prelude_js length > 500KB")
  debug_assert(e.length() > 200000, "editing_js length > 200KB")
  debug_assert(
    sha256_hex(p) == "9c0f6e8a33d71e374d40a286f0d461f780ebd9064cfecbdef817e318442bb176",
    "prelude_js SHA-256 must match js/prelude.js byte-for-byte",
  )
  debug_assert(
    sha256_hex(e) == "025015da9ebb9a22dfd226d2c3548f5b88266a7bf60803cca716d8f3a1b917fb",
    "editing_js SHA-256 must match js/editing.js byte-for-byte",
  )
}

test "V8 executes full prelude_js and editing_js with 0 syntax/init errors and hostOnly hidden" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()

  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js must initialize with 0 errors: " + r_pre)

  // Verify editing_js compiles cleanly in V8 (as prelude compiles it on demand via Function)
  let r_ed = js::run("new Function('__ed_test', " + "\"return 1;\")()")
  debug_assert(r_ed == "1", "Function constructor works")
  let r_ed_full = js::run(editing_js())
  debug_assert(!r_ed_full.starts_with("!error:"), "editing_js must execute with 0 errors: " + r_ed_full)

  debug_assert(js::run("typeof document") == "object", "typeof document === object")
  debug_assert(
    js::run("typeof HTMLInputElement.prototype.stepUp") == "function",
    "HTMLInputElement.prototype.stepUp === function",
  )
  debug_assert(
    js::run("typeof globalThis.__validationTip") == "undefined",
    "hostOnly __validationTip must be hidden from globalThis",
  )
}

let mock_released : Array[String] = []

extern "C" fn sweep_mock_host(op : Int, _a : Int, _b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 2 {
    "10"
  } else if op == 8 {
    "div"
  } else if op == 17 {
    if s == ".empty" {
      ""
    } else if s == ".one" {
      "1"
    } else {
      "12,345,6"
    }
  } else if op == 65 {
    "12,11;345,99"
  } else if op == 66 {
    mock_released.push(s)
    ""
  } else if op == 132 {
    "999,12,888,345"
  } else {
    ""
  }
}

extern "C" fn sweep_mock_int(op : Int, _a : Int, _b : Int) -> Int {
  if op == 7 {
    1
  } else {
    0
  }
}

test "Wave 29A zero-alloc ids, __held, and sweep preserve exact semantics" {
  mock_released.clear()
  js::start_raw(c_fn_ptr(sweep_mock_host))
  js::start_int_raw(c_fn_ptr(sweep_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)

  // ids("") / ids("1") / ids("12,345,6") via querySelectorAll
  debug_assert(js::run("document.querySelectorAll('.empty').length") == "0", "ids empty")
  debug_assert(js::run("document.querySelectorAll('.one').length") == "1", "ids single")
  debug_assert(
    js::run("Array.from(document.querySelectorAll('.many'), n => n._id).join(',')") == "12,345,6",
    "ids many",
  )

  // __held: empty, miss, hit on live wrappers (nodes 12 & 345 from QSA)
  let _ = js::run("var __many = document.querySelectorAll('.many'); globalThis.__keep12 = __many[0]; globalThis.__keep345 = __many[1];")
  debug_assert(js::run("globalThis.__held('')") == "", "__held empty")
  debug_assert(js::run("globalThis.__held('999,888')") == "", "__held all miss")
  let held_before = js::run("globalThis.__held('999,12,888,345')")
  debug_assert(held_before == "12,345", "__held hits: got=" + held_before)
  let held_host = js::run("globalThis.__heldHost()")
  debug_assert(held_host == "12,345", "__heldHost op 132 hits: got=" + held_host)

  // sweep: OP.SWEEP returns "12,11;345,99"; 12 & 345 are wrapped (moved to weakWrappers), 11 & 99 are unwrapped -> OP.RELEASE("11,99")
  let _ = js::run("var __origST = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = __origST;")
  debug_assert(
    mock_released.length() == 1 && mock_released[0] == "11,99",
    "sweep must release unwrapped detached ids 11,99 only",
  )
  debug_assert(
    js::run("globalThis.__held('12,11,345,99')") == "12,345",
    "__held keeps weak-wrapped 12 & 345",
  )

  // Wave 30A: when WeakRef.deref() returns undefined, sweep immediately reaps id into OP.RELEASE
  let _ = js::run("var __origDeref = WeakRef.prototype.deref; WeakRef.prototype.deref = function() { return undefined; }; var __origST2 = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = __origST2; WeakRef.prototype.deref = __origDeref;")
  debug_assert(
    mock_released.length() == 2 && mock_released[1] == "12,11,345,99",
    "sweep must immediately reap dead WeakRefs into OP.RELEASE",
  )
}

test "StorageEvent.initStorageEvent, attributes Proxy length invariant, and WebAssembly.instantiateStreaming" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let _ = js::run(prelude_js())
  let r = js::run(
    "(() => {" +
    "const ev = document.createEvent('StorageEvent');" +
    "ev.initStorageEvent('storage', false, false, 'k', null, 'v', 'https://example.com', null);" +
    "const okEv = ev.type === 'storage' && ev.key === 'k' && ev.newValue === 'v';" +
    "const d = document.createElement('div');" +
    "const okAttr = ('length' in d.attributes) === true;" +
    "const okStyle = ('cssText' in d.style) === true && ('flex' in d.style) === true && ('transform' in d.style) === true && ('notARealCssProp' in d.style) === false;" +
    "const sym = Symbol('vsh'); d.style[sym] = 42; const okSym = d.style[sym] === 42;" +
    "const okWasm = typeof WebAssembly.instantiateStreaming === 'function' && typeof WebAssembly.compileStreaming === 'function';" +
    "const origSetAttr = Element.prototype.setAttribute;" +
    "Element.prototype.setAttribute = function(k, v) { if (k === 'src') { this.src = v; return; } return origSetAttr.call(this, k, v); };" +
    "let okRefl = false; try { const s = document.createElement('script'); s.setAttribute('src', 'https://example.com/a.js'); s.async = true; okRefl = true; } finally { Element.prototype.setAttribute = origSetAttr; }" +
    "const ce = document.createElement('div'); const ei = ce.attachInternals(); ei.states.add('active'); ei.role = 'button'; const okEi = ei instanceof ElementInternals && ei.states.has('active') && ei.role === 'button' && ei.checkValidity() === true;" +
    "const okLink = typeof globalThis.__initialLinks === 'function';" +
    "let rafT = -1, tlT = -2; requestAnimationFrame(t => { rafT = t; tlT = document.timeline.currentTime; }); __tick(32); const okRaf = rafT === tlT && rafT >= 16;" +
    "const p0 = performance.now(); const spinEnd = Date.now() + 5; while (Date.now() < spinEnd) {} const p1 = performance.now(); const okPerf = p1 > p0;" +
    "__setUrl('https://example.com/a');" +
    "const locKeys = []; for (const k in location) locKeys.push(k); const okLoc = locKeys.includes('pathname') && locKeys.includes('protocol') && locKeys.includes('href') && !locKeys.includes('_u');" +
    "const urlKeys = []; for (const k in new URL('https://example.com/a')) urlKeys.push(k); const okUrl = urlKeys.includes('pathname') && urlKeys.includes('protocol');" +
    "globalThis.__ihRan = 0; const tmp = document.createElement('div'); tmp.innerHTML = '<script>globalThis.__ihRan++<\\/script>'; const sc = tmp.querySelector('script'); if (sc) document.body && document.body.appendChild(sc); const okIh = globalThis.__ihRan === 0;" +
    "return okEv && okAttr && okStyle && okSym && okWasm && okRefl && okEi && okLink && okRaf && okPerf && okLoc && okUrl && okIh ? 'ok' : 'bad';" +
    "})()",
  )
  debug_assert(r == "ok", "expected ok, got: " + r)
}

let w76_named_calls : Array[Int] = [0]
let w76_names_ver : Array[Int] = [1]
let w76_canvas_batches : Array[String] = []

extern "C" fn w76_mock_host(op : Int, _a : Int, _b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 2 {
    if s == "canvas" {
      "50"
    } else {
      "20"
    }
  } else if op == 8 {
    "div"
  } else if op == 11 {
    "\u{00}"
  } else if op == 103 {
    w76_named_calls[0] = w76_named_calls[0] + 1
    if w76_names_ver[0] >= 2 && s == "hero" {
      "20"
    } else {
      ""
    }
  } else if op == 75 {
    if s.starts_with("B\n") {
      w76_canvas_batches.push(s)
    }
    ""
  } else {
    ""
  }
}

extern "C" fn w76_mock_int(op : Int, a : Int, _b : Int) -> Int {
  if op == 102 {
    w76_names_ver[0]
  } else if op == 7 {
    if a == 1 {
      9
    } else {
      1
    }
  } else {
    0
  }
}

test "Wave 76A docNamed cache, lazy EventTarget._l, DOMTokenList, dataset, randomUUID, and canvas _syncClip" {
  w76_named_calls[0] = 0
  w76_names_ver[0] = 1
  w76_canvas_batches.clear()
  js::start_raw(c_fn_ptr(w76_mock_host))
  js::start_int_raw(c_fn_ptr(w76_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)

  // 1. docNamed negative caching + NAMESVER invalidation
  w76_named_calls[0] = 0
  let r1 = js::run("'' + document.missingProp + ',' + document.missingProp + ',' + document.missingProp")
  debug_assert(r1 == "undefined,undefined,undefined", "docNamed miss: " + r1)
  debug_assert(w76_named_calls[0] == 1, "docNamed must cache negative hits per NAMESVER, calls=" + w76_named_calls[0].to_string())
  w76_names_ver[0] = 2
  let r2 = js::run("document.hero && document.hero._id === 20 ? 'hit' : 'miss'")
  debug_assert(r2 == "hit", "docNamed must invalidate on NAMESVER bump: " + r2)
  let calls_after = w76_named_calls[0]
  let r3 = js::run("document.hero && document.hero._id === 20 ? 'hit' : 'miss'")
  debug_assert(r3 == "hit" && w76_named_calls[0] == calls_after, "docNamed must cache positive hits too")

  // 2. Lazy EventTarget._l + DOMTokenList + cached dataset + setAttribute validation + randomUUID
  let r4 = js::run(
    "(() => {" +
    "const d = document.createElement('div');" +
    "const noL = d._l === undefined && !Object.keys(d).includes('_l');" +
    "let fired = 0; const fn = () => fired++; d.addEventListener('ping', fn); d.dispatchEvent(new Event('ping')); d.removeEventListener('ping', fn); d.dispatchEvent(new Event('ping'));" +
    "const okEv = fired === 1 && !Object.keys(d).includes('_l');" +
    "d.setAttribute('class', '  foo\\tbar\\nfoo  baz ');" +
    "const okCl = d.classList.length === 3 && d.classList.contains('bar') && d.classList[0] === 'foo' && d.classList[2] === 'baz';" +
    "const ds1 = d.dataset, ds2 = d.dataset; ds1.fooBar = '42';" +
    "const okDs = ds1 === ds2 && d.dataset.fooBar === '42' && d.getAttribute('data-foo-bar') === '42';" +
    "let badAttr = false; try { d.setAttribute('bad name', '1'); } catch (e) { badAttr = e.name === 'InvalidCharacterError'; }" +
    "const u1 = crypto.randomUUID(), u2 = crypto.randomUUID();" +
    "const re = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;" +
    "const okUuid = re.test(u1) && re.test(u2) && u1 !== u2;" +
    "return noL && okEv && okCl && okDs && badAttr && okUuid ? 'ok' : [noL, okEv, okCl, okDs, badAttr, okUuid].join(',');" +
    "})()",
  )
  debug_assert(r4 == "ok", "Wave 76A DOM/UUID checks failed: " + r4)

  // 3. CanvasRenderingContext2D stateful _syncClip: repeated fills under 1 clip emit KS/KC once + balanced KR on flush
  let r5 = js::run(
    "(() => {" +
    "const c = document.createElement('canvas'); c.width = 100; c.height = 100;" +
    "const ctx = c.getContext('2d');" +
    "ctx.save(); ctx.beginPath(); ctx.rect(10, 10, 50, 50); ctx.clip();" +
    "ctx.fillStyle = '#f00'; ctx.fillRect(0, 0, 20, 20); ctx.fillRect(5, 5, 20, 20); ctx.fillRect(10, 10, 20, 20);" +
    "ctx.restore(); ctx.fillRect(0, 0, 10, 10);" +
    "ctx.getImageData(0, 0, 1, 1);" +
    "return 'ok';" +
    "})()",
  )
  debug_assert(r5 == "ok" && w76_canvas_batches.length() == 1, "canvas batch emitted")
  let batch = w76_canvas_batches[0]
  // Should have exactly 1 KS, 1 KC, 1 KR (after restore before unclipped fillRect), not 3 KS/KC/KR pairs
  let lines = batch.split("\n")
  let mut ks = 0
  let mut kc = 0
  let mut kr = 0
  let mut fr = 0
  for i = 0; i < lines.length(); i = i + 1 {
    let ln = lines[i]
    if ln == "KS" { ks = ks + 1 }
    else if ln.starts_with("KC\t") { kc = kc + 1 }
    else if ln == "KR" { kr = kr + 1 }
    else if ln.starts_with("FR\t") { fr = fr + 1 }
  }
  debug_assert(
    ks == 1 && kc == 1 && kr == 1 && fr == 4,
    "stateful _syncClip expected ks=1 kc=1 kr=1 fr=4, got ks=" + ks.to_string() + " kc=" + kc.to_string() + " kr=" + kr.to_string() + " fr=" + fr.to_string(),
  )
}

let w77_ver_calls : Array[Int] = [0]
let w77_kind_calls : Array[Int] = [0]
let w77_seta_calls : Array[Int] = [0]

extern "C" fn w77_mock_host(op : Int, _a : Int, b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 2 {
    if s == "canvas" {
      "60"
    } else {
      "30"
    }
  } else if op == 8 {
    if b == 2 {
      if _a == 0 {
        "div"
      } else {
        "svg"
      }
    } else {
      "div"
    }
  } else if op == 11 {
    "\u{00}"
  } else if op == 12 {
    w77_seta_calls[0] = w77_seta_calls[0] + 1
    ""
  } else if op == 17 {
    // b == 3 returns id:kn pairs: 101 -> HTML div (ns=0, tc=0 => kn=1), 102 -> SVG svg (ns=1, tc=1 => kn=1|(1<<8)|(1<<12)=4353)
    if b == 3 {
      "101:1,102:4353"
    } else {
      "101,102"
    }
  } else {
    ""
  }
}

extern "C" fn w77_mock_int(op : Int, a : Int, _b : Int) -> Int {
  if op == 60 {
    w77_ver_calls[0] = w77_ver_calls[0] + 1
    1
  } else if op == 7 {
    if a == 1 {
      9
    } else {
      w77_kind_calls[0] = w77_kind_calls[0] + 1
      1
    }
  } else {
    0
  }
}

test "Wave 77A shared __fvVer, QSA b=3 id:kn zero-KIND wrap, setAttribute same-value skip, and scalar canvas path" {
  w77_ver_calls[0] = 0
  w77_kind_calls[0] = 0
  w77_seta_calls[0] = 0
  js::start_raw(c_fn_ptr(w77_mock_host))
  js::start_int_raw(c_fn_ptr(w77_mock_int))
  js::new_context()
  js::set_dom_version(1)
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)

  // 1. QSA b=3 id:kn wraps HTML div + SVG svg with 0 OP.KIND calls & live listProxy reads 0 OP.VERSION calls
  w77_ver_calls[0] = 0
  w77_kind_calls[0] = 0
  let r1 = js::run(
    "(() => {" +
    "const list = document.getElementsByTagName('*');" +
    "const n = list.length; const a = list[0], b = list[1];" +
    "return n === 2 && a._id === 101 && a.localName === 'div' && a.namespaceURI === 'http://www.w3.org/1999/xhtml' && b._id === 102 && b.localName === 'svg' && b.namespaceURI === 'http://www.w3.org/2000/svg' ? 'ok' : 'bad';" +
    "})()",
  )
  debug_assert(r1 == "ok", "QSA b=3 wrap failed: " + r1)
  debug_assert(w77_kind_calls[0] == 0, "QSA b=3 must avoid OP.KIND, calls=" + w77_kind_calls[0].to_string())
  debug_assert(w77_ver_calls[0] == 0, "shared __fvVer must avoid OP.VERSION, calls=" + w77_ver_calls[0].to_string())

  // 2. setAttribute same-value skip (without observer) vs fires (with MutationObserver)
  w77_seta_calls[0] = 0
  let r2 = js::run(
    "(() => {" +
    "const d = document.createElement('div');" +
    "d.setAttribute('data-x', '1'); d.setAttribute('data-x', '1'); d.setAttribute('data-x', '1');" +
    "return d.getAttribute('data-x');" +
    "})()",
  )
  debug_assert(r2 == "1" && w77_seta_calls[0] == 1, "same-value setAttribute must skip redundant OP.SETA, calls=" + w77_seta_calls[0].to_string())
  let r3 = js::run(
    "(() => {" +
    "const d = document.createElement('div');" +
    "const mo = new MutationObserver(() => {}); mo.observe(d, { attributes: true });" +
    "d.setAttribute('data-y', '2'); d.setAttribute('data-y', '2');" +
    "mo.disconnect(); return 'ok';" +
    "})()",
  )
  debug_assert(r3 == "ok" && w77_seta_calls[0] == 3, "with MutationObserver, same-value setAttribute must still cross OP.SETA, calls=" + w77_seta_calls[0].to_string())

  // 3. Canvas scalar path & monomorphic save/restore
  let r4 = js::run(
    "(() => {" +
    "const c = document.createElement('canvas'); c.width = 50; c.height = 50;" +
    "const ctx = c.getContext('2d');" +
    "ctx.fillStyle = '#123456'; ctx.lineWidth = 3; ctx.save();" +
    "ctx.fillStyle = '#abcdef'; ctx.lineWidth = 7;" +
    "ctx.beginPath(); ctx.moveTo(1, 2); ctx.lineTo(10, 2); ctx.bezierCurveTo(12, 2, 14, 4, 14, 6); ctx.quadraticCurveTo(14, 10, 10, 10); ctx.closePath(); ctx.rect(0, 0, 5, 5); ctx.arc(20, 20, 5, 0, Math.PI);" +
    "const pLen = ctx._p.length;" +
    "ctx.restore();" +
    "return pLen > 20 && ctx.fillStyle === '#123456' && ctx.lineWidth === 3 ? 'ok' : 'bad:' + pLen;" +
    "})()",
  )
  debug_assert(r4 == "ok", "scalar canvas path & save/restore failed: " + r4)
  js::set_dom_version(0)
}

extern "C" fn origin_mock_host(op : Int, a : Int, _b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 24 && a == 3 {
    if s == "https://vscode.dev/path?q=1" {
      "https://vscode.dev/path?q=1\u{01}https:\u{01}\u{01}\u{01}vscode.dev\u{01}vscode.dev\u{01}\u{01}/path\u{01}?q=1\u{01}\u{01}https://vscode.dev"
    } else if s == "http://example.org/app" {
      "http://example.org/app\u{01}http:\u{01}\u{01}\u{01}example.org\u{01}example.org\u{01}\u{01}/app\u{01}\u{01}\u{01}http://example.org"
    } else if s == "http://localhost:8080/" {
      "http://localhost:8080/\u{01}http:\u{01}\u{01}\u{01}localhost:8080\u{01}localhost\u{01}8080\u{01}/\u{01}\u{01}\u{01}http://localhost:8080"
    } else {
      "\u{00}"
    }
  } else {
    ""
  }
}

test "Wave 1C: WindowOrWorkerGlobalScope.origin and isSecureContext match location" {
  js::start_raw(c_fn_ptr(origin_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r_https = js::run(
    "(() => {" +
    "__setUrl('https://vscode.dev/path?q=1');" +
    "const ok1 = window.origin === 'https://vscode.dev' && self.origin === 'https://vscode.dev' && origin === 'https://vscode.dev' && isSecureContext === true;" +
    "__setUrl('http://example.org/app');" +
    "const ok2 = window.origin === 'http://example.org' && isSecureContext === false;" +
    "__setUrl('http://localhost:8080/');" +
    "const ok3 = window.origin === 'http://localhost:8080' && isSecureContext === true;" +
    "return ok1 && ok2 && ok3 ? 'ok' : [ok1, ok2, ok3, window.origin, isSecureContext].join(',');" +
    "})()",
  )
  debug_assert(r_https == "ok", "WindowOrWorkerGlobalScope origin/isSecureContext failed: " + r_https)
}

let w78_rootof_calls : Array[Int] = [0]
let w78_c112_calls : Array[Int] = [0]
let w78_qsa_calls : Array[Int] = [0]
let w78_named_calls : Array[Int] = [0]

extern "C" fn w78_mock_host(op : Int, _a : Int, _b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 2 {
    if s == "div" {
      "40"
    } else if s == "span" {
      "41"
    } else {
      "42"
    }
  } else if op == 3 {
    "43"
  } else if op == 8 {
    "div"
  } else if op == 11 {
    "\u{00}"
  } else if op == 17 {
    w78_qsa_calls[0] = w78_qsa_calls[0] + 1
    ""
  } else if op == 31 {
    "99"
  } else if op == 103 {
    w78_named_calls[0] = w78_named_calls[0] + 1
    ""
  } else {
    ""
  }
}

