test "Wave 97A: direct History/Navigator/Screen/Performance prototypes, lazy FileReader/BroadcastChannel/DataTransfer/ElementInternals/ToggleEvent/rareHtml, and DOMParser parseHTMLUnsafe" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "if (!(history instanceof History) || Object.prototype.toString.call(history) !== '[object History]') return 'bad-history';" +
    "if (!(navigator instanceof Navigator) || Object.prototype.toString.call(navigator) !== '[object Navigator]') return 'bad-navigator';" +
    "if (!(screen instanceof Screen) || Object.prototype.toString.call(screen) !== '[object Screen]') return 'bad-screen';" +
    "if (!(performance instanceof Performance) || Object.prototype.toString.call(performance) !== '[object Performance]') return 'bad-perf';" +
    "if (typeof navigator.userAgent !== 'string' || navigator.language !== 'en-US' || !navigator.javaEnabled || navigator.javaEnabled.toString().indexOf('[native code]') < 0) return 'bad-nav-props';" +
    "const nativeFns = [navigator.javaEnabled, window.chrome.csi, navigator.permissions.query, Object.getOwnPropertyDescriptor(Navigator.prototype, 'webdriver').get, Object.getOwnPropertyDescriptor(Navigator.prototype, 'userAgent').get];" +
    "if (!nativeFns.every(fn => /^function\\s+[\\w\\s]*\\(\\)\\s*\\{\\s*\\[native code\\]\\s*\\}$/.test(Function.prototype.toString.call(fn)))) return 'bad-fn-toString-native';" +
    "for (const k of ['FileReader', 'BroadcastChannel', 'DataTransfer', 'FileList', 'ElementInternals', 'CustomStateSet', 'ToggleEvent', 'CommandEvent', 'ImageData', 'OffscreenCanvas', 'SubmitEvent', 'FormDataEvent', 'HTMLDialogElement', 'HTMLAreaElement', 'HTMLBaseElement', 'HTMLFieldSetElement', 'HTMLLegendElement', 'HTMLOptGroupElement', 'HTMLOutputElement']) {" +
    "  const d = Object.getOwnPropertyDescriptor(globalThis, k);" +
    "  if (!d || typeof d.get !== 'function' || d.enumerable !== false) return 'not-lazy-' + k;" +
    "}" +
    "if (typeof FileReader !== 'function' || FileReader.DONE !== 2) return 'bad-fr';" +
    "if (typeof BroadcastChannel !== 'function' || typeof DataTransfer !== 'function' || typeof FileList !== 'function') return 'bad-dt-bc';" +
    "if (typeof ElementInternals !== 'function' || typeof CustomStateSet !== 'function') return 'bad-ei';" +
    "if (typeof ToggleEvent !== 'function' || typeof CommandEvent !== 'function') return 'bad-toggle';" +
    "if (typeof ImageData !== 'function' || typeof OffscreenCanvas !== 'function' || typeof SubmitEvent !== 'function' || typeof FormDataEvent !== 'function') return 'bad-img-sub';" +
    "if (typeof HTMLDialogElement.prototype.showModal !== 'function' || typeof HTMLDialogElement.prototype.close !== 'function') return 'bad-dialog';" +
    "if (!('href' in HTMLAreaElement.prototype) || !('relList' in HTMLAreaElement.prototype) || !('href' in HTMLBaseElement.prototype)) return 'bad-area-base';" +
    "if (!('disabled' in HTMLFieldSetElement.prototype) || !('label' in HTMLOptGroupElement.prototype)) return 'bad-form-rare';" +
    "const dt = new DataTransfer(); dt.setData('text/plain', 'hi'); if (dt.getData('text/plain') !== 'hi') return 'bad-dt-ops';" +
    "const inp = document.createElement('input'); inp.setAttribute('type', 'file'); inp.files = dt.files; if (!inp.files || inp.files.length !== 0) return 'bad-input-files';" +
    "if (typeof Document.parseHTMLUnsafe !== 'function') return 'bad-parse-html-unsafe';" +
    "return 'ok';" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 97A test failed: " + r)
}

