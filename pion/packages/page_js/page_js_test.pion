}

test "Wave 95A: Response/Blob ReadableStream lazy regression & Workers/Media/XPath/RareHtml lazy init" {
  js::start_raw(c_fn_ptr(prelude_mock_host))
  js::start_int_raw(c_fn_ptr(prelude_mock_int))
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let r = js::run(
    "(() => {" +
    "const resp = new Response('hi');" +
    "const dBefore = Object.getOwnPropertyDescriptor(globalThis, 'ReadableStream');" +
    "if (!dBefore || typeof dBefore.get !== 'function') return 'eager-rs';" +
    "const body = resp.body;" +
    "const dAfter = Object.getOwnPropertyDescriptor(globalThis, 'ReadableStream');" +
    "if (!dAfter || typeof dAfter.value !== 'function' || !(body instanceof ReadableStream)) return 'bad-resp-body';" +
    "const bs = new Blob(['a']).stream();" +
    "if (!(bs instanceof ReadableStream)) return 'bad-blob-stream';" +
    "for (const k of ['Worker', 'HTMLVideoElement', 'MediaSource', 'Audio', 'XPathEvaluator', 'HTMLMarqueeElement', 'Animation', 'KeyframeEffect', 'Plugin', 'Permissions', 'CacheStorage', 'Geolocation']) {" +
    "  const d = Object.getOwnPropertyDescriptor(globalThis, k);" +
    "  if (!d || typeof d.get !== 'function' || d.enumerable !== false) return 'not-lazy-' + k;" +
    "}" +
    "if (typeof Worker !== 'function' || typeof HTMLVideoElement !== 'function' || Audio.prototype !== HTMLAudioElement.prototype) return 'bad-lazy-init';" +
    "if (typeof XPathEvaluator !== 'function' || typeof HTMLMarqueeElement !== 'function') return 'bad-xpath-rare';" +
    "if (typeof Animation !== 'function' || !(document.timeline instanceof DocumentTimeline)) return 'bad-anim';" +
    "if (navigator.plugins.length < 1 || typeof navigator.permissions.query !== 'function' || typeof caches.open !== 'function' || !chrome.runtime) return 'bad-nav-extra';" +
    "if (document.nodeType !== 9 || document.nodeName !== '#document') return 'bad-doc-node';" +
    "if (!(matchMedia('all') instanceof MediaQueryList)) return 'bad-mql';" +
    "return 'ok';" +
    "})()",
  )
  debug_assert(r == "ok", "Wave 95A lazy regression test failed: " + r)
}

let w95a_media_video_on : Array[Int] = [0]
let w95a_media_load_calls : Array[Int] = [0]

extern "C" fn w95a_media_mock_host(op : Int, _a : Int, _b : Int, s : String, _t : String) -> String {
  if op == 1 {
    "1"
  } else if op == 8 {
    "video"
  } else if op == 11 {
    if s == "src" { "https://example.com/hero.mp4" } else if s == "autoplay" { "" } else { "" }
  } else if op == 17 && s == "video, audio" {
    if w95a_media_video_on[0] == 1 { "42" } else { "" }
  } else if op == 122 {
    w95a_media_load_calls[0] = w95a_media_load_calls[0] + 1
    ""
  } else {
    ""
  }
}

extern "C" fn w95a_media_mock_int(op : Int, a : Int, _b : Int) -> Int {
  if op == 7 {
    if a == 1 { 9 } else { 1 }
  } else {
    0
  }
}

test "Wave 95A P0: __mediaAutoLoad keeps empty doc lazy, triggers ensureMedia+_autoLoad on static <video>, and no ABA on same-len anon scripts" {
  // 1. Same-length anonymous scripts in a fresh context (no prelude) must not ABA-collide
  w95a_media_video_on[0] = 0
  w95a_media_load_calls[0] = 0
  js::start_raw(c_fn_ptr(w95a_media_mock_host))
  js::start_int_raw(c_fn_ptr(w95a_media_mock_int))
  js::new_context()
  debug_assert(js::run("1+1") == "2", "anon 1+1 == 2")
  debug_assert(js::run("2+2") == "4", "anon 2+2 == 4")

  // 2. Empty doc __mediaAutoLoad keeps HTMLVideoElement lazy; static <video> doc triggers ensureMedia + _autoLoad
  js::new_context()
  let r_pre = js::run(prelude_js())
  debug_assert(!r_pre.starts_with("!error:"), "prelude_js init ok: " + r_pre)
  let hk = js::host_key()
  let _ = js::run("__fvHostKey(\"" + hk + "\")")
  let r_empty = js::run(
    "(() => {" +
    "__fvH(\"" + hk + "\").__mediaAutoLoad();" +
    "const d = Object.getOwnPropertyDescriptor(globalThis, 'HTMLVideoElement');" +
    "return d && typeof d.get === 'function' ? 'lazy' : 'eager';" +
    "})()",
  )
  debug_assert(r_empty == "lazy", "empty doc __mediaAutoLoad must keep HTMLVideoElement lazy, got: " + r_empty)

  w95a_media_video_on[0] = 1
  let r_vid = js::run(
    "(() => {" +
    "__fvH(\"" + hk + "\").__mediaAutoLoad();" +
    "const d = Object.getOwnPropertyDescriptor(globalThis, 'HTMLVideoElement');" +
    "return d && typeof d.value === 'function' ? 'loaded' : 'not-loaded';" +
    "})()",
  )
  debug_assert(r_vid == "loaded", "static <video> __mediaAutoLoad must trigger ensureMedia, got: " + r_vid)
  debug_assert(w95a_media_load_calls[0] >= 1, "static <video> __mediaAutoLoad must invoke _autoLoad (op 118)")
}

