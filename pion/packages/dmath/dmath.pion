///| Thin double-precision math wrapper (`libm` via `extern "C"`).
///| Portable math bridge wrapping libm for Farview.

pub let PI : Double = 3.14159265358979323846

extern "C" fn c_sin(x : Double) -> Double = "sin"
extern "C" fn c_cos(x : Double) -> Double = "cos"
extern "C" fn c_tan(x : Double) -> Double = "tan"
extern "C" fn c_asin(x : Double) -> Double = "asin"
extern "C" fn c_acos(x : Double) -> Double = "acos"
extern "C" fn c_atan(x : Double) -> Double = "atan"
extern "C" fn c_atan2(y : Double, x : Double) -> Double = "atan2"
extern "C" fn c_pow(x : Double, y : Double) -> Double = "pow"
extern "C" fn c_exp(x : Double) -> Double = "exp"
extern "C" fn c_log(x : Double) -> Double = "log"
extern "C" fn c_sqrt(x : Double) -> Double = "sqrt"
extern "C" fn c_hypot(x : Double, y : Double) -> Double = "hypot"
extern "C" fn c_floor(x : Double) -> Double = "floor"
extern "C" fn c_ceil(x : Double) -> Double = "ceil"
extern "C" fn c_round(x : Double) -> Double = "round"
extern "C" fn c_fabs(x : Double) -> Double = "fabs"
extern "C" fn c_trunc(x : Double) -> Double = "trunc"
extern "C" fn c_fmod(x : Double, y : Double) -> Double = "fmod"
extern "C" fn c_i2d(x : Int64) -> Double = "fv_dmath_i2d"
extern "C" fn c_d2i(x : Double) -> Int64 = "fv_dmath_d2i"

pub fn i2d(x : Int) -> Double { c_i2d(x.to_int64()) }
pub fn d2i(x : Double) -> Int { c_d2i(x).to_int() }
pub fn d2i64(x : Double) -> Int64 { c_d2i(x) }

pub fn sin(x : Double) -> Double { c_sin(x) }
pub fn cos(x : Double) -> Double { c_cos(x) }
pub fn tan(x : Double) -> Double { c_tan(x) }
pub fn asin(x : Double) -> Double { c_asin(x) }
pub fn acos(x : Double) -> Double { c_acos(x) }
pub fn atan(x : Double) -> Double { c_atan(x) }
pub fn atan2(y : Double, x : Double) -> Double { c_atan2(y, x) }
pub fn pow(x : Double, y : Double) -> Double { c_pow(x, y) }
pub fn exp(x : Double) -> Double { c_exp(x) }
pub fn ln(x : Double) -> Double { c_log(x) }
pub fn sqrt(x : Double) -> Double { c_sqrt(x) }
pub fn hypot(x : Double, y : Double) -> Double { c_hypot(x, y) }
pub fn floor(x : Double) -> Double { c_floor(x) }
pub fn ceil(x : Double) -> Double { c_ceil(x) }
pub fn round(x : Double) -> Double { c_round(x) }
pub fn abs(x : Double) -> Double { c_fabs(x) }
pub fn trunc(x : Double) -> Double { c_trunc(x) }
pub fn fmod(x : Double, y : Double) -> Double { c_fmod(x, y) }

pub fn min(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

pub fn max(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

pub fn clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo { lo } else if x > hi { hi } else { x }
}

pub fn is_nan(x : Double) -> Bool {
  x != x
}

pub fn is_inf(x : Double) -> Bool {
  x == (1.0 / 0.0) || x == (-1.0 / 0.0)
}
