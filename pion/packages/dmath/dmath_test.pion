test "dmath basic libm bindings" {
  debug_assert(abs(sin(0.0)) < 0.000001, "sin(0)")
  debug_assert(abs(cos(0.0) - 1.0) < 0.000001, "cos(0)")
  debug_assert(abs(sin(PI / 2.0) - 1.0) < 0.000001, "sin(pi/2)")
  debug_assert(abs(pow(2.0, 10.0) - 1024.0) < 0.000001, "pow")
  debug_assert(abs(sqrt(9.0) - 3.0) < 0.000001, "sqrt")
  debug_assert(abs(atan2(1.0, 1.0) - PI / 4.0) < 0.000001, "atan2")
  debug_assert(floor(2.9) == 2.0 && ceil(2.1) == 3.0 && round(2.5) == 3.0, "rounding")
  debug_assert(abs(exp(ln(5.0)) - 5.0) < 0.000001, "exp/ln")
  debug_assert(abs(hypot(3.0, 4.0) - 5.0) < 0.000001, "hypot")
}
