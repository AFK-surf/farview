pub extern "C" fn udp_port(handle : Int) -> Int = "pion_webrtc_udp_port"
extern "C" fn c_udp_send(handle : Int, ip : Ptr, ip_len : Int, port : Int, data : Ptr, len : Int) -> Int = "pion_webrtc_udp_send"
extern "C" fn c_udp_recv(handle : Int, out_buf : Ptr, cap : Int, out_ip : Ptr, ip_cap : Int, out_meta : Ptr) -> Int = "pion_webrtc_udp_recv"
pub extern "C" fn udp_close(handle : Int) -> Unit = "pion_webrtc_udp_close"
pub extern "C" fn udp_active_count() -> Int = "pion_webrtc_udp_active_count"
extern "C" fn c_local_ips(out_buf : Ptr, cap : Int) -> Int = "pion_webrtc_local_ips"

pub extern "C" fn dtls_new(is_server : Int) -> Int = "pion_dtls_new"
pub extern "C" fn dtls_set_role(handle : Int, is_server : Int) -> Int = "pion_dtls_set_role"
pub extern "C" fn dtls_close(handle : Int) -> Unit = "pion_dtls_close"
pub extern "C" fn dtls_active_count() -> Int = "pion_dtls_active_count"
extern "C" fn c_dtls_local_fingerprint(handle : Int, out_buf : Ptr, cap : Int) -> Int = "pion_dtls_local_fingerprint"
extern "C" fn c_dtls_feed(handle : Int, pkt : Ptr, len : Int) -> Int = "pion_dtls_feed"
pub extern "C" fn dtls_step(handle : Int) -> Int = "pion_dtls_step"
extern "C" fn c_dtls_poll_out(handle : Int, out_buf : Ptr, cap : Int) -> Int = "pion_dtls_poll_out"
pub extern "C" fn dtls_is_connected(handle : Int) -> Int = "pion_dtls_is_connected"
extern "C" fn c_dtls_peer_fingerprint(handle : Int, out_buf : Ptr, cap : Int) -> Int = "pion_dtls_peer_fingerprint"
extern "C" fn c_dtls_verify_peer_fingerprint(handle : Int, expected : Ptr, expected_len : Int) -> Int = "pion_dtls_verify_peer_fingerprint"
extern "C" fn c_dtls_export_srtp(handle : Int, out_buf : Ptr, cap : Int, out_profile : Ptr) -> Int = "pion_dtls_export_srtp"
extern "C" fn c_dtls_app_write(handle : Int, data : Ptr, len : Int) -> Int = "pion_dtls_app_write"
extern "C" fn c_dtls_app_read(handle : Int, out_buf : Ptr, cap : Int) -> Int = "pion_dtls_app_read"

extern "C" fn c_capture_enumerate_devices(out_buf : Ptr, cap : Int) -> Int = "pion_capture_enumerate_devices"
extern "C" fn c_capture_device_summary(out_buf : Ptr, cap : Int) -> Int = "pion_capture_device_summary"
pub extern "C" fn capture_open(kind : Int, width : Int, height : Int) -> Int = "pion_capture_open"
pub extern "C" fn capture_open_ex(kind : Int, width : Int, height : Int, flags : Int) -> Int = "pion_capture_open_ex"
extern "C" fn c_capture_read_frame(handle : Int, out_buf : Ptr, cap : Int) -> Int = "pion_capture_read_frame"
extern "C" fn c_capture_status(handle : Int, out_buf : Ptr, cap : Int) -> Int = "pion_capture_status"
pub extern "C" fn capture_close(handle : Int) -> Unit = "pion_capture_close"
pub extern "C" fn capture_active_count() -> Int = "pion_capture_active_count"

pub extern "C" fn webrtc_audio_out_open(sample_rate : Int, channels : Int, flags : Int) -> Int = "pion_webrtc_audio_out_open"
extern "C" fn c_webrtc_audio_out_write(handle : Int, pcm : Ptr, len : Int) -> Int = "pion_webrtc_audio_out_write"
pub extern "C" fn webrtc_audio_out_close(handle : Int) -> Unit = "pion_webrtc_audio_out_close"

extern "C" fn c_random_bytes(out_buf : Ptr, len : Int) -> Int = "pion_webrtc_random_bytes"

fn read_i32_le(b : Bytes, off : Int) -> Int {
  let b0 = b[off].to_int() & 0xFF
  let b1 = b[off + 1].to_int() & 0xFF
  let b2 = b[off + 2].to_int() & 0xFF
  let b3 = b[off + 3].to_int() & 0xFF
  b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn copy_prefix(src : Bytes, n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = src[i]
    i = i + 1
  }
  out
}

fn keep_bytes_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

pub fn udp_send(handle : Int, ip : String, port : Int, data : Bytes) -> Int {
  let ip_b = ip.to_bytes()
  let r = c_udp_send(handle, bytes_data_ptr(ip_b), ip_b.length(), port, bytes_data_ptr(data), data.length())
  keep_bytes_alive(ip_b)
  keep_bytes_alive(data)
  r
}

pub struct UdpPacket {
  pub data : Bytes
  pub ip : String
  pub port : Int
}

pub fn udp_recv(handle : Int) -> Option[UdpPacket] {
  let buf = Bytes::new(4096)
  let ip_buf = Bytes::new(64)
  let meta = Bytes::new(8)
  let n = c_udp_recv(handle, bytes_data_ptr(buf), 4096, bytes_data_ptr(ip_buf), 64, bytes_data_ptr(meta))
  if n <= 0 {
    return None
  }
  let ip_len = read_i32_le(meta, 0)
  let port = read_i32_le(meta, 4)
  let ip = if ip_len > 0 && ip_len <= 64 { copy_prefix(ip_buf, ip_len).to_string() } else { "" }
  Some(UdpPacket::{ data: copy_prefix(buf, n), ip: ip, port: port })
}

pub fn local_ips() -> Array[String] {
  let buf = Bytes::new(1024)
  let n = c_local_ips(bytes_data_ptr(buf), 1024)
  if n <= 0 {
    return ["127.0.0.1"]
  }
  let s = copy_prefix(buf, n).to_string()
  let parts = s.split(",")
  let out : Array[String] = []
  for p in parts {
    if p != "" {
      out.push(p)
    }
  }
  if out.length() == 0 {
    out.push("127.0.0.1")
  }
  out
}

pub fn dtls_local_fingerprint(handle : Int) -> String {
  let buf = Bytes::new(128)
  let n = c_dtls_local_fingerprint(handle, bytes_data_ptr(buf), 128)
  if n <= 0 {
    ""
  } else {
    copy_prefix(buf, n).to_string()
  }
}

pub fn dtls_feed(handle : Int, pkt : Bytes) -> Int {
  let r = c_dtls_feed(handle, bytes_data_ptr(pkt), pkt.length())
  keep_bytes_alive(pkt)
  r
}

pub fn dtls_poll_out(handle : Int) -> Option[Bytes] {
  let buf = Bytes::new(4096)
  let n = c_dtls_poll_out(handle, bytes_data_ptr(buf), 4096)
  if n <= 0 {
    None
  } else {
    Some(copy_prefix(buf, n))
  }
}

pub fn dtls_peer_fingerprint(handle : Int) -> String {
  let buf = Bytes::new(128)
  let n = c_dtls_peer_fingerprint(handle, bytes_data_ptr(buf), 128)
  if n <= 0 {
    ""
  } else {
    copy_prefix(buf, n).to_string()
  }
}

pub fn dtls_verify_peer_fingerprint(handle : Int, expected_fp : String) -> Bool {
  let b = expected_fp.to_bytes()
  let ok = c_dtls_verify_peer_fingerprint(handle, bytes_data_ptr(b), b.length()) == 1
  keep_bytes_alive(b)
  ok
}

pub struct SrtpExport {
  pub profile_id : Int
  pub material : Bytes
}

pub fn dtls_export_srtp(handle : Int) -> Option[SrtpExport] {
  let buf = Bytes::new(64)
  let prof = Bytes::new(4)
  let n = c_dtls_export_srtp(handle, bytes_data_ptr(buf), 64, bytes_data_ptr(prof))
  if n <= 0 {
    return None
  }
  Some(SrtpExport::{ profile_id: read_i32_le(prof, 0), material: copy_prefix(buf, n) })
}

pub fn dtls_app_write(handle : Int, data : Bytes) -> Int {
  let r = c_dtls_app_write(handle, bytes_data_ptr(data), data.length())
  keep_bytes_alive(data)
  r
}

pub fn dtls_app_read(handle : Int) -> Option[Bytes] {
  let buf = Bytes::new(8192)
  let n = c_dtls_app_read(handle, bytes_data_ptr(buf), 8192)
  if n <= 0 {
    None
  } else {
    Some(copy_prefix(buf, n))
  }
}

pub fn capture_enumerate_devices() -> String {
  let buf = Bytes::new(8192)
  let n = c_capture_enumerate_devices(bytes_data_ptr(buf), 8192)
  if n <= 0 {
    ""
  } else {
    copy_prefix(buf, n).to_string()
  }
}

pub fn capture_device_summary() -> String {
  let buf = Bytes::new(512)
  let n = c_capture_device_summary(bytes_data_ptr(buf), 512)
  if n <= 0 {
    ""
  } else {
    copy_prefix(buf, n).to_string()
  }
}

pub fn capture_status(handle : Int) -> String {
  let buf = Bytes::new(256)
  let n = c_capture_status(handle, bytes_data_ptr(buf), 256)
  if n <= 0 {
    ""
  } else {
    copy_prefix(buf, n).to_string()
  }
}

pub fn webrtc_audio_out_write(handle : Int, pcm : Bytes) -> Int {
  if pcm.length() == 0 {
    return 0
  }
  let r = c_webrtc_audio_out_write(handle, bytes_data_ptr(pcm), pcm.length())
  keep_bytes_alive(pcm)
  r
}

pub fn capture_read_frame(handle : Int, max_bytes : Int) -> Option[Bytes] {
  if max_bytes <= 0 {
    return None
  }
  let buf = Bytes::new(max_bytes)
  let n = c_capture_read_frame(handle, bytes_data_ptr(buf), max_bytes)
  if n <= 0 {
    None
  } else {
    Some(copy_prefix(buf, n))
  }
}

pub fn random_bytes(len : Int) -> Bytes {
  if len <= 0 {
    return Bytes::new(0)
  }
  let buf = Bytes::new(len)
  let _ = c_random_bytes(bytes_data_ptr(buf), len)
  buf
}
