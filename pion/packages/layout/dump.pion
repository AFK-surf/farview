///| Box tree queries: `rects`, `rect_down`, `node_at`, `link_at`, `page_height`, `box_scroll_sizes`, `fixed_ids`, `same_boxes`, `container_sizes`.
///| 1:1 port of `client/src/layout/dump.mbt`.

import "html"
import "css"
import "intmap"

pub let scrolls : intmap::IntMap[(Double, Double)] = intmap::IntMap::new()

pub fn scroll_of(b : Box) -> (Double, Double) {
  if scrolls.is_empty() { return (0.0, 0.0) }
  match b.node {
    Some(n) => scrolls.get_or(n.uid, (0.0, 0.0))
    None => (0.0, 0.0)
  }
}

fn collect_rects(b : Box, out : intmap::IntMap[(Double, Double, Double, Double)], dx0 : Double, dy0 : Double) -> Unit {
  let (tx, ty) = if b.kind is Inline || b.kind is Break { (0.0, 0.0) } else { translation(b) }
  let dx = dx0 + tx
  let dy = dy0 + ty
  match b.node {
    Some(n) =>
    if n.layout_id >= 0 {
      if b.kind is Inline || b.kind is Break {
        if b.has_frag {
          out.set(n.layout_id, (b.min_x + dx, b.min_y + dy, b.max_x - b.min_x, b.max_y - b.min_y))
        }
      } else {
        out.set(n.layout_id, (b.x + dx, b.y + dy, b.w, b.h))
        if n.tag == "svg" && b.kind is Replaced(_, _) {
          svg_boxes(b, n, dx, dy, out)
        }
      }
    }
    None => ()
  }
  let (sx, sy) = scroll_of(b)
  let mut i = 0
  while i < b.children.length() {
    collect_rects(b.children[i], out, dx - sx, dy - sy)
    i += 1
  }
}

pub fn rects(root : Box) -> intmap::IntMap[(Double, Double, Double, Double)] {
  let out : intmap::IntMap[(Double, Double, Double, Double)] = intmap::IntMap::with_capacity(128)
  collect_rects(root, out, 0.0, 0.0)
  out
}

fn collect_client_sizes(b : Box, out : intmap::IntMap[(Double, Double)]) -> Unit {
  match b.node {
    Some(n) =>
    if n.layout_id >= 0 && !out.contains(n.layout_id) {
      let cw = if b.w - b.bl - b.br > 0.0 { b.w - b.bl - b.br } else { 0.0 }
      let ch = if b.h - b.bt - b.bb > 0.0 { b.h - b.bt - b.bb } else { 0.0 }
      out.set(n.layout_id, (cw, ch))
    }
    None => ()
  }
  let mut i = 0
  let nch = b.children.length()
  while i < nch {
    collect_client_sizes(b.children[i], out)
    i += 1
  }
}

pub fn client_sizes(root : Box) -> intmap::IntMap[(Double, Double)] {
  let out : intmap::IntMap[(Double, Double)] = intmap::IntMap::with_capacity(128)
  collect_client_sizes(root, out)
  out
}

struct DumpGlobals {
  mut rect_visits : Int
}

let dump_globals : DumpGlobals = DumpGlobals::{ rect_visits: 0 }

pub fn get_rect_visits() -> Int {
  dump_globals.rect_visits
}

pub fn reset_rect_visits() -> Unit {
  dump_globals.rect_visits = 0
}

fn rect_down_walk(b : Box, n : html::Node, up : Array[Int], dx0 : Double, dy0 : Double) -> Option[(Double, Double, Double, Double)] {
  dump_globals.rect_visits += 1
  let (tx, ty) = if b.kind is Inline || b.kind is Break { (0.0, 0.0) } else { translation(b) }
  let dx = dx0 + tx
  let dy = dy0 + ty
  let mut found : Option[(Double, Double, Double, Double)] = None
  match b.node {
    Some(x) =>
    if x.uid == n.uid {
      if b.kind is Inline || b.kind is Break {
        if b.has_frag {
          found = Some((b.min_x + dx, b.min_y + dy, b.max_x - b.min_x, b.max_y - b.min_y))
        }
      } else {
        found = Some((b.x + dx, b.y + dy, b.w, b.h))
      }
    }
    None => ()
  }
  let (sx, sy) = scroll_of(b)
  let mut i = 0
  while i < b.children.length() {
    let c = b.children[i]
    let on_way = match c.node {
      None => true
      Some(x) => {
        let mut hit = false
        let mut ui = 0
        while ui < up.length() { if up[ui] == x.uid { hit = true; break }; ui += 1 }
        hit
      }
    }
    if on_way {
      match rect_down_walk(c, n, up, dx - sx, dy - sy) {
        Some(r) => found = Some(r)
        None => ()
      }
    }
    i += 1
  }
  found
}

pub fn rect_down(root : Box, n : html::Node) -> Option[(Double, Double, Double, Double)] {
  if n.layout_id < 0 { return None }
  let up : Array[Int] = [n.uid]
  let mut cur = n.parent
  while true {
    match cur {
      Some(x) => {
        if x.tag == "svg" { return None }
        up.push(x.uid)
        cur = x.parent
      }
      None => break
    }
  }
  rect_down_walk(root, n, up, 0.0, 0.0)
}

pub fn link_at(b : Box, x : Double, y : Double) -> Option[String] {
  let mut i = b.children.length() - 1
  while i >= 0 {
    match link_at(b.children[i], x, y) {
      Some(u) => return Some(u)
      None => ()
    }
    i -= 1
  }
  let inside = if b.kind is Inline {
    b.has_frag && x >= b.min_x && x <= b.max_x && y >= b.min_y && y <= b.max_y
  } else {
    x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h
  }
  match b.node {
    Some(n) => if inside && n.tag == "a" { n.attr("href") } else { None }
    None => None
  }
}

fn hit_layered(b : Box) -> Bool {
  b.style.pos_kind() >= 1
}

fn hit_z(b : Box) -> Int {
  let v = b.style.get_id(css::p_z_index)
  let mut found = 0
  let mut count = 0
  let mut i = 0
  while i < v.length() {
    match v[i] {
      css::Tok::Space => ()
      css::Tok::Number(n) => { found = n.to_int(); count += 1 }
      _ => return 0
    }
    i += 1
  }
  if count == 1 { found } else { 0 }
}

fn box_rect_hit(b : Box) -> (Double, Double, Double, Double) {
  if b.kind is Inline {
    (b.min_x, b.min_y, b.max_x - b.min_x, b.max_y - b.min_y)
  } else {
    (b.x, b.y, b.w, b.h)
  }
}

fn box_is_inert(b : Box) -> Bool {
  match b.node {
    Some(n) => n.kind is html::Kind::Element && n.attr("inert").is_some()
    None => false
  }
}

fn flow_at_box(b : Box, x : Double, y : Double) -> Option[(html::Node, Box)] {
  if box_is_inert(b) { return None }
  let in_box = x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h
  if !(b.kind is Inline) && !in_box {
    if !flow_masks.ready { ensure_flow_masks() }
    if b.style.values.has_any_mask(flow_masks.ov_m0, flow_masks.ov_m1, flow_masks.ov_m2, flow_masks.ov_m3) {
      let ox = b.style.word_id(css::p_overflow_x)
      let oy = b.style.word_id(css::p_overflow_y)
      if !((ox == "" || ox == "visible") && (oy == "" || oy == "visible")) {
        return None
      }
    }
  }
  let (sx, sy) = scroll_of(b)
  let mut i = b.children.length() - 1
  while i >= 0 {
    let c = b.children[i]
    if !hit_layered(c) && c.style.word_id(css::p_content_visibility) != "hidden" {
      match flow_at_box(c, x + sx, y + sy) {
        Some(hit) => return Some(hit)
        None => ()
      }
    }
    i -= 1
  }
  let inside = if b.kind is Inline {
    b.has_frag && x >= b.min_x && x <= b.max_x && y >= b.min_y && y <= b.max_y
  } else {
    in_box
  }
  if inside && b.style.word_id(css::p_visibility) != "hidden" && b.style.word_id(css::p_pointer_events) != "none" {
    match b.node {
      Some(n) => return Some((n, b))
      None => ()
    }
  }
  None
}

struct HitLayer {
  z : Int
  ord : Int
  bx : Box
  x : Double
  y : Double
}

fn node_box_at(b : Box, x : Double, y : Double) -> Option[(html::Node, Box)] {
  if b.style.word_id(css::p_content_visibility) == "hidden" || box_is_inert(b) { return None }
  let layers : Array[HitLayer] = []
  let (bx, by) = scroll_of(b)
  let walk : Array[(Box, Double, Double)] = []
  let mut i = b.children.length() - 1
  while i >= 0 { walk.push((b.children[i], x + bx, y + by)); i -= 1 }
  while walk.length() > 0 {
    match walk.pop() {
      Some((c, cx, cy)) => {
        if c.style.word_id(css::p_content_visibility) == "hidden" || box_is_inert(c) {
          continue
        }
        if hit_layered(c) {
          layers.push(HitLayer::{ z: hit_z(c), ord: layers.length(), bx: c, x: cx, y: cy })
          continue
        }
        let (sx, sy) = scroll_of(c)
        let mut ci = c.children.length() - 1
        while ci >= 0 { walk.push((c.children[ci], cx + sx, cy + sy)); ci -= 1 }
      }
      None => break
    }
  }
  if layers.length() == 0 { return flow_at_box(b, x, y) }
  // Insertion sort by (z, ord)
  i = 1
  while i < layers.length() {
    let cur = layers[i]
    let mut j = i - 1
    while j >= 0 && (layers[j].z > cur.z || (layers[j].z == cur.z && layers[j].ord > cur.ord)) {
      layers[j + 1] = layers[j]
      j -= 1
    }
    layers[j + 1] = cur
    i += 1
  }
  i = layers.length() - 1
  while i >= 0 {
    if layers[i].z >= 0 {
      match node_box_at(layers[i].bx, layers[i].x, layers[i].y) {
        Some(hit) => return Some(hit)
        None => ()
      }
    }
    i -= 1
  }
  match flow_at_box(b, x, y) {
    Some(hit) => return Some(hit)
    None => ()
  }
  i = layers.length() - 1
  while i >= 0 {
    if layers[i].z < 0 {
      match node_box_at(layers[i].bx, layers[i].x, layers[i].y) {
        Some(hit) => return Some(hit)
        None => ()
      }
    }
    i -= 1
  }
  None
}

pub fn node_at(b : Box, x : Double, y : Double) -> Option[html::Node] {
  match node_box_at(b, x, y) {
    Some((n, _)) => Some(n)
    None => None
  }
}

pub fn node_and_rect_at(b : Box, x : Double, y : Double) -> Option[(html::Node, (Double, Double, Double, Double))] {
  match node_box_at(b, x, y) {
    Some((n, bx)) => Some((n, box_rect_hit(bx)))
    None => None
  }
}

pub fn rect_of(b : Box, n : html::Node) -> Option[(Double, Double, Double, Double)] {
  match b.node {
    Some(m) => if m.uid == n.uid {
      return Some(if b.kind is Inline { (b.min_x, b.min_y, b.max_x - b.min_x, b.max_y - b.min_y) } else { (b.x, b.y, b.w, b.h) })
    }
    None => ()
  }
  let mut i = 0
  while i < b.children.length() {
    match rect_of(b.children[i], n) {
      Some(r) => return Some(r)
      None => ()
    }
    i += 1
  }
  None
}

pub fn page_height(b : Box) -> Double {
  if !flow_masks.ready { ensure_flow_masks() }
  page_height_in(b)
}

fn page_height_in(b : Box) -> Double {
  let mut h = b.y + b.h
  if b.has_frag { h = dmax(h, b.max_y) }
  let cn = b.children.length()
  if cn == 0 { return h }
  let mut clipped = false
  if b.style.values.has_any_mask(flow_masks.ov_m0, flow_masks.ov_m1, flow_masks.ov_m2, flow_masks.ov_m3) {
    let o = b.style.word_id(css::p_overflow_y)
    if o == "hidden" || o == "auto" || o == "scroll" {
      let is_root = match b.node { Some(n) => n.tag == "html" || n.tag == "body" None => false }
      clipped = !is_root
    }
  }
  if !clipped {
    let mut i = 0
    while i < cn {
      let c = b.children[i]
      if c.style.pos_kind() != 4 {
        h = dmax(h, page_height_in(c))
      }
      i += 1
    }
  }
  h
}

pub fn translation(b : Box) -> (Double, Double) {
  let v = b.style.get_id(css::p_transform)
  let mut dx = 0.0
  let mut dy = 0.0
  let mut i = 0
  while i < v.length() {
    match v[i] {
      css::Tok::Function(f) => {
        let name = ot_ascii_lower(f)
        let args : Array[Array[css::Tok]] = []
        let mut cur : Array[css::Tok] = []
        let mut j = i + 1
        let mut depth = 0
        while j < v.length() {
          match v[j] {
            css::Tok::Function(_) | css::Tok::OpenParen => depth += 1
            css::Tok::CloseParen => {
              if depth == 0 { break }
              depth -= 1
            }
            css::Tok::Comma => if depth == 0 { args.push(cur); cur = []; j += 1; continue }
            _ => ()
          }
          if !(v[j] is css::Tok::Space && depth == 0) { cur.push(v[j]) }
          j += 1
        }
        if cur.length() > 0 { args.push(cur) }
        let dlen = fn(a : Array[css::Tok], room : Double) -> Double {
          match b.style.length_of(a) { Some(l) => l.px + l.pct * room / 100.0 None => 0.0 }
        }
        if name == "translate" || name == "translate3d" {
          if args.length() > 0 { dx += dlen(args[0], b.w) }
          if args.length() > 1 { dy += dlen(args[1], b.h) }
        } else if name == "translatex" {
          if args.length() > 0 { dx += dlen(args[0], b.w) }
        } else if name == "translatey" {
          if args.length() > 0 { dy += dlen(args[0], b.h) }
        }
        i = j + 1
      }
      _ => i += 1
    }
  }
  (dx, dy)
}

fn box_of_all(b : Box, n : html::Node) -> Option[Box] {
  match b.node {
    Some(m) => if m.uid == n.uid && !(b.kind is TextRun(_)) { return Some(b) }
    None => ()
  }
  let mut i = 0
  while i < b.children.length() {
    match box_of_all(b.children[i], n) {
      Some(r) => return Some(r)
      None => ()
    }
    i += 1
  }
  None
}

fn box_of_walk(cur_b : Box, n : html::Node, up : Array[Int]) -> Option[Box] {
  match cur_b.node {
    Some(m) => if m.uid == n.uid && !(cur_b.kind is TextRun(_)) { return Some(cur_b) }
    None => ()
  }
  let mut i = 0
  while i < cur_b.children.length() {
    let c = cur_b.children[i]
    let on_way = match c.node {
      None => true
      Some(x) => {
        let mut hit = false
        let mut ui = 0
        while ui < up.length() { if up[ui] == x.uid { hit = true; break }; ui += 1 }
        hit
      }
    }
    if on_way {
      match box_of_walk(c, n, up) {
        Some(r) => return Some(r)
        None => ()
      }
    }
    i += 1
  }
  None
}

pub fn box_of(b : Box, n : html::Node) -> Option[Box] {
  match b.node {
    Some(m) => if m.uid == n.uid && !(b.kind is TextRun(_)) { return Some(b) }
    None => ()
  }
  let up : Array[Int] = [n.uid]
  let mut cur = n.parent
  while true {
    match cur { Some(x) => { up.push(x.uid); cur = x.parent } None => break }
  }
  match box_of_walk(b, n, up) {
    Some(r) => Some(r)
    None => box_of_all(b, n)
  }
}

pub fn scroll_sizes(root : Box, n : html::Node) -> Option[(Double, Double, Double, Double)] {
  match box_of(root, n) {
    None => None
    Some(b) => Some(box_scroll_sizes(b))
  }
}

fn scroll_clips(c : Box) -> Bool {
  // CSS Overflow 3 §3.2: when the HTML root element has overflow: visible,
  // <body>'s overflow propagates to the viewport and <body> itself has used overflow: visible.
  if is_body(c) {
    match c.style.parent {
      Some(p) => {
        let pox = p.word_id(css::p_overflow_x)
        let poy = p.word_id(css::p_overflow_y)
        if (pox == "" || pox == "visible") && (poy == "" || poy == "visible") {
          return false
        }
      }
      None => ()
    }
  }
  if !flow_masks.ready { ensure_flow_masks() }
  if !c.style.values.has_any_mask(flow_masks.ov_m0, flow_masks.ov_m1, flow_masks.ov_m2, flow_masks.ov_m3) { return false }
  let ox = c.style.word_id(css::p_overflow_x)
  let oy = c.style.word_id(css::p_overflow_y)
  !(ox == "" || ox == "visible") || !(oy == "" || oy == "visible")
}

fn scroll_ext_of(c : Box) -> ScrollExt {
  match c.scroll_ext {
    Some(e) => if c.geom > 0 && e.geom == c.geom && e.w == c.w && e.h == c.h { return e }
    None => ()
  }
  let inf = 1.0e300
  let mut max_bx = -inf
  let mut max_mx = -inf
  let mut max_by = -inf
  let mut max_my = -inf
  let mut min_bx = inf
  let mut min_mx = inf
  let mut min_by = inf
  let mut min_my = inf
  let mut has_zero = false
  // an absolutely positioned box below it, placed after the layout that stamped `geom`; and one with relatively
  // positioned boxes in it, which `rel_below` does not see (it looks at boxes in flow only)
  let mut has_abs = false
  let mut abs_rel = false
  if c.kind is Inline || c.kind is Break {
    if !c.has_frag { has_zero = true }
    else {
      max_bx = c.max_x - c.x; max_by = c.max_y - c.y
      min_mx = c.min_x - c.x; min_my = c.min_y - c.y
    }
  } else if c.kind is TextRun(_) {
    has_zero = true
    let cfrags = c.frags
    let cflen = cfrags.length()
    let mut fi = 0
    while fi < cflen { max_bx = dmax(max_bx, cfrags[fi].x + cfrags[fi].w - c.x); fi += 1 }
  } else {
    max_bx = c.w; max_mx = c.w + c.mr; max_by = c.h; max_my = c.h + c.mb
    min_bx = 0.0; min_mx = -c.ml; min_by = 0.0; min_my = -c.mt
  }
  let children = c.children
  let cn = children.length()
  if cn > 0 && !scroll_clips(c) {
    let mut i = 0
    while i < cn {
      let k = children[i]
      let kp = k.style.pos_kind()
      if kp != 4 {
        let dx = k.x - c.x
        let dy = k.y - c.y
        if k.children.length() == 0 {
          if k.kind is TextRun(_) {
            has_zero = true
            let kfrags = k.frags
            let flen = kfrags.length()
            let mut fi = 0
            while fi < flen {
              let f = kfrags[fi]
              max_bx = dmax(max_bx, f.x + f.w - c.x)
              fi += 1
            }
            if kp == 3 { has_abs = true }
          } else if k.kind is Inline || k.kind is Break {
            if !k.has_frag {
              has_zero = true
            } else {
              max_bx = dmax(max_bx, k.max_x - c.x)
              max_by = dmax(max_by, k.max_y - c.y)
              min_mx = dmin(min_mx, k.min_x - c.x)
              min_my = dmin(min_my, k.min_y - c.y)
            }
            if kp == 3 { has_abs = true }
          } else {
            max_bx = dmax(max_bx, dx + k.w)
            max_mx = dmax(max_mx, dx + k.w + k.mr)
            max_by = dmax(max_by, dy + k.h)
            max_my = dmax(max_my, dy + k.h + k.mb)
            min_bx = dmin(min_bx, dx)
            min_mx = dmin(min_mx, dx - k.ml)
            min_by = dmin(min_by, dy)
            min_my = dmin(min_my, dy - k.mt)
            if kp == 3 { has_abs = true }
          }
        } else {
          let ke = scroll_ext_of(k)
          if ke.max_bx > -1.0e299 { max_bx = dmax(max_bx, dx + ke.max_bx) }
          if ke.max_mx > -1.0e299 { max_mx = dmax(max_mx, dx + ke.max_mx) }
          if ke.max_by > -1.0e299 { max_by = dmax(max_by, dy + ke.max_by) }
          if ke.max_my > -1.0e299 { max_my = dmax(max_my, dy + ke.max_my) }
          if ke.min_bx < 1.0e299 { min_bx = dmin(min_bx, dx + ke.min_bx) }
          if ke.min_mx < 1.0e299 { min_mx = dmin(min_mx, dx + ke.min_mx) }
          if ke.min_by < 1.0e299 { min_by = dmin(min_by, dy + ke.min_by) }
          if ke.min_my < 1.0e299 { min_my = dmin(min_my, dy + ke.min_my) }
          if ke.has_zero { has_zero = true }
          if ke.has_abs || kp == 3 { has_abs = true }
          if ke.abs_rel || (kp == 3 && rel_below(k)) { abs_rel = true }
        }
      }
      i += 1
    }
  }
  // absolutely positioned boxes below it whose containing block is it or a box in it (none outside it, as its last
  // layout found: `memo_has_outer`) are placed again as that layout placed them as long as its `geom` holds
  let abs_held = has_abs && !abs_rel && c.memo_pass >= 0 && !c.memo_has_outer
  let res = ScrollExt::{
    geom: c.geom, w: c.w, h: c.h,
    max_bx: max_bx, max_mx: max_mx, max_by: max_by, max_my: max_my,
    min_bx: min_bx, min_mx: min_mx, min_by: min_by, min_my: min_my,
    has_zero: has_zero, has_abs: (has_abs && !abs_held) || c.style.pos_kind() == 3, abs_rel: abs_rel,
  }
  if c.geom > 0 && c.children.length() > 0 && !sticky_below(c) && !rel_below(c) && (!has_abs || abs_held) {
    c.scroll_ext = Some(res)
  }
  res
}

pub fn box_scroll_sizes(b : Box) -> (Double, Double, Double, Double) {
  let px = b.x + b.bl
  let py = b.y + b.bt
  let cw = dmax(b.w - b.bl - b.br, 0.0)
  let ch = dmax(b.h - b.bt - b.bb, 0.0)
  let mut right = px + cw
  let mut bottom = py + ch
  let mut left = px
  let mut top = py
  let mut i = 0
  while i < b.children.length() {
    let c = b.children[i]
    if !c.style.values.maybe_has_id(css::p_position) || c.style.word_id(css::p_position) != "fixed" {
      let e = scroll_ext_of(c)
      if e.max_bx > -1.0e299 { right = dmax(right, c.x + e.max_bx) }
      if e.max_mx > -1.0e299 { right = dmax(right, c.x + e.max_mx + b.pr) }
      if e.max_by > -1.0e299 { bottom = dmax(bottom, c.y + e.max_by) }
      if e.max_my > -1.0e299 { bottom = dmax(bottom, c.y + e.max_my + b.pb) }
      if e.min_bx < 1.0e299 { left = dmin(left, c.x + e.min_bx) }
      if e.min_mx < 1.0e299 { left = dmin(left, c.x + e.min_mx - b.pl) }
      if e.min_by < 1.0e299 { top = dmin(top, c.y + e.min_by) }
      if e.min_my < 1.0e299 { top = dmin(top, c.y + e.min_my - b.pt) }
      if e.has_zero { right = dmax(right, 0.0); bottom = dmax(bottom, 0.0) }
    }
    i += 1
  }
  let rtl = (b.style.flow_flags_val() & 4) != 0
  let flexy = inner_kind(b) is Flex
  let vm = vertical_mode(b.style)
  let (flip_x, flip_y) = if flexy {
    let dir = b.style.word_id(css::p_flex_direction)
    let column = str_has_prefix(dir, "column")
    let reverse = str_has_suffix(dir, "reverse")
    let wrap_rev = b.style.word_id(css::p_flex_wrap) == "wrap-reverse"
    if vm > 0 {
      let rl = vm == 2
      if column { (rl != reverse, rtl != wrap_rev) }
      else { (rl != wrap_rev, rtl != reverse) }
    } else {
      (if column { rtl != wrap_rev } else { rtl != reverse }, if column { reverse } else { wrap_rev })
    }
  } else if vm > 0 {
    (vm == 2, rtl)
  } else {
    (rtl, false)
  }
  let sw = if flip_x { dmax(cw, px + cw - left) } else { right - px }
  let sh = if flip_y { dmax(ch, py + ch - top) } else { bottom - py }
  (cw, ch, sw, sh)
}

fn fixed_walk(b : Box, inside : Bool, held : Bool, ids : intmap::IntMap[Bool], boxes : Array[Box]) -> Unit {
  if b.kind is TextRun(_) { return }
  let is_root_fixed = !inside && !held && b.style.pos_kind() == 4
  let fixed = inside || is_root_fixed
  if fixed {
    match b.node {
      Some(n) => if n.layout_id >= 0 {
        ids.set(n.layout_id, true)
        if is_root_fixed { boxes.push(b) }
      }
      None => ()
    }
  }
  let held_in = held || (!fixed && holds_fixed(b))
  if held_in && !fixed { return }
  let mut i = 0
  while i < b.children.length() {
    fixed_walk(b.children[i], fixed, held_in, ids, boxes)
    i += 1
  }
}

pub fn fixed_boxes_and_ids(root : Box) -> (intmap::IntMap[Bool], Array[Box]) {
  let ids : intmap::IntMap[Bool] = intmap::IntMap::new()
  let boxes : Array[Box] = []
  fixed_walk(root, false, false, ids, boxes)
  (ids, boxes)
}

pub fn fixed_ids(root : Box) -> intmap::IntMap[Bool] {
  fixed_boxes_and_ids(root).0
}

pub fn no_touch_ids(root : Box) -> Array[Int] {
  let out : Array[Int] = []
  let walk : Array[Box] = [root]
  while walk.length() > 0 {
    match walk.pop() {
      Some(b) => {
        if b.style.word_id(css::p_touch_action) == "none" {
          match b.node { Some(n) => if n.layout_id >= 0 { out.push(n.layout_id) } None => () }
        }
        let mut i = 0
        while i < b.children.length() { walk.push(b.children[i]); i += 1 }
      }
      None => break
    }
  }
  out
}

pub fn same_boxes(a : Box, b : Box, changed : (html::Node) -> Bool) -> Bool {
  if a.uid == b.uid { return true }
  let same_node = match (a.node, b.node) {
    (None, None) => true
    (Some(x), Some(y)) => x.uid == y.uid && !changed(x)
    _ => false
  }
  if !same_node || a.children.length() != b.children.length() { return false }
  let same_kind = match (a.kind, b.kind) {
    (TextRun(s), TextRun(t)) => s == t
    (Replaced(w1, h1), Replaced(w2, h2)) => w1 == w2 && h1 == h2
    (Block, Block) | (Inline, Inline) | (Atomic, Atomic) | (Break, Break) | (Flex, Flex) | (Grid, Grid) => true
    (Table, Table) | (Row, Row) | (RowGroup, RowGroup) | (Cell, Cell) | (Caption, Caption) => true
    _ => false
  }
  let same_style = a.style.uid == b.style.uid || (a.node.is_none() && a.style.same_values(b.style))
  if !same_kind || !same_style { return false }
  let mut i = 0
  while i < a.children.length() {
    if !same_boxes(a.children[i], b.children[i], changed) { return false }
    i += 1
  }
  true
}

pub fn container_sizes(root : Box) -> intmap::IntMap[(Double, Double)] {
  let out : intmap::IntMap[(Double, Double)] = intmap::IntMap::new()
  let walk : Array[Box] = [root]
  while walk.length() > 0 {
    match walk.pop() {
      Some(b) => {
        if !(b.kind is TextRun(_)) {
          if b.style.values.maybe_has_id(css::p_container_type) {
            match b.node {
              Some(n) => {
                let ct = b.style.word_id(css::p_container_type)
                if ct == "size" || ct == "inline-size" {
                  out.set(n.uid, (b.w - b.bl - b.br - b.pl - b.pr, b.h - b.bt - b.bb - b.pt - b.pb))
                }
              }
              None => ()
            }
          }
          let mut i = 0
          while i < b.children.length() { walk.push(b.children[i]); i += 1 }
        }
      }
      None => break
    }
  }
  out
}
