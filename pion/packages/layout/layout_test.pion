///|
test "Wave 123B: flex-wrap multi-row pill cluster with row-gap and column-gap" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='pills' style='display:flex;flex-wrap:wrap;column-gap:12px;row-gap:10px;width:360px'>" +
    "<a style='width:110px;height:36px'>Concepts</a>" +
    "<a style='width:110px;height:36px'>Deploying</a>" +
    "<a style='width:110px;height:36px'>Architecture</a>" +
    "<a style='width:110px;height:36px'>Scalers</a>" +
    "</div></body></html>",
  )
  let pills = doc.children[1].children[1].children[0]
  let p0 = pills.children[0]
  let p2 = pills.children[2]
  let p3 = pills.children[3]
  let e = css::Engine::new(css::Env::new(800.0, 400.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 400.0, 0.0)
  let b0 = match box_of(root, p0) { Some(b) => b None => panic("p0") }
  let b2 = match box_of(root, p2) { Some(b) => b None => panic("p2") }
  let b3 = match box_of(root, p3) { Some(b) => b None => panic("p3") }
  // 3 * 110 + 2 * 12 = 354 <= 360 -> 3 pills on row 1, 4th pill wraps to row 2 at y = 36 + 10 = 46
  debug_assert((b2.x - (b0.x + 244.0)).abs() < 1.0 && (b2.y - b0.y).abs() < 1.0, "third pill must stay on row 1 at x=244")
  debug_assert((b3.x - b0.x).abs() < 1.0 && (b3.y - (b0.y + 46.0)).abs() < 1.0, "fourth pill must wrap to row 2 with 10px row-gap at y=46")
  html::cut(doc)
}

///|
test "Wave 33C: CSS Flexbox §4 coalesces contiguous TextRun children into a single anonymous flex item preserving inter-node spaces" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='f' style='display:flex;width:400px;font-size:16px'>Your </div>" +
    "</body></html>",
  )
  let f = doc.children[1].children[1].children[0]
  // Simulate React multi-text-node interpolation: "Your " + "JSON" + " appears here."
  let t2 = html::Node::text("JSON")
  let t3 = html::Node::text(" appears here.")
  f.append(t2)
  f.append(t3)
  let e = css::Engine::new(css::Env::new(800.0, 400.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 400.0, 0.0)
  let bf = match box_of(root, f) { Some(b) => b None => panic("f") }
  let frags : Array[TextFrag] = []
  let stack : Array[Box] = [bf]
  while stack.length() > 0 {
    let cur = match stack.pop() { Some(x) => x None => break }
    for fr in cur.frags { frags.push(fr) }
    let mut i = cur.children.length() - 1
    while i >= 0 {
      stack.push(cur.children[i])
      i -= 1
    }
  }
  debug_assert(frags.length() >= 4, "expected 4 word frags (Your, JSON, appears, here.), got " + frags.length().to_string())
  let gap01 = frags[1].x - (frags[0].x + frags[0].w)
  let gap12 = frags[2].x - (frags[1].x + frags[1].w)
  debug_assert(gap01 > 1.0, "space between 'Your' and 'JSON' must be preserved (>1px), got " + gap01.to_string())
  debug_assert(gap12 > 1.0, "space between 'JSON' and 'appears' must be preserved (>1px), got " + gap12.to_string())
  html::cut(doc)
}

