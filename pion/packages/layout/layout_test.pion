}

///|
test "Wave 8C: CSS Text 3 overflow-wrap:anywhere & word-break:break-all wrap long unbreakable tokens" {
  let tok = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='ow' style='width:200px;font-size:16px;overflow-wrap:anywhere'>" + tok + "</div>" +
    "<div id='wb' style='width:200px;font-size:16px;word-break:break-all'>" + tok + "</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_ow = match box_of(root, body.children[0]) { Some(b) => b None => panic("ow") }
  let b_wb = match box_of(root, body.children[1]) { Some(b) => b None => panic("wb") }
  debug_assert(b_ow.h > 40.0, "overflow-wrap:anywhere must wrap long token into multiple lines (h>40), got " + b_ow.h.to_string())
  debug_assert(b_wb.h > 40.0, "word-break:break-all must wrap long token into multiple lines (h>40), got " + b_wb.h.to_string())
  html::cut(doc)
}

///|
test "Wave 9C: CSS Flexbox §9.4 row flex container with min-height:100% stretches children to full containing height" {
  let doc = html::parse(
    "<!doctype html><html style='height:100%'><body style='margin:0;display:flex;min-height:100%'>" +
    "<div id='next' style='display:flex;flex-direction:column;width:100%'>" +
    "<header style='height:60px'></header>" +
    "<main id='main' style='flex:1 1 auto'></main>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let next_el = body.children[0]
  let main_el = next_el.children[1]
  let b_next = match box_of(root, next_el) { Some(b) => b None => panic("next") }
  let b_main = match box_of(root, main_el) { Some(b) => b None => panic("main") }
  debug_assert((b_next.h - 800.0).abs() < 1.0, "#__next must stretch to body min-height:100% (800px), got " + b_next.h.to_string())
  debug_assert((b_main.h - 740.0).abs() < 1.0, "main flex:1 must fill remaining 740px, got " + b_main.h.to_string())
  html::cut(doc)
}

///|
test "Wave 84A: copy_frags empty no_frags fast path and pre-sized independent clone" {
  let empty = copy_frags([])
  debug_assert(empty.length() == 0, "copy_frags([]) returns empty")
  let src = [
    TextFrag::{ x: 1.0, y: 2.0, w: 10.0, text: "hi", font: 0, size: 14.0, ascent: 11.0 },
    TextFrag::{ x: 12.0, y: 2.0, w: 20.0, text: "world", font: 0, size: 14.0, ascent: 11.0 },
  ]
  let dst = copy_frags(src)
  debug_assert(dst.length() == 2 && dst[0].text == "hi" && dst[1].text == "world", "copy_frags preserves length and content")
  dst[0].x = 99.0
  debug_assert(src[0].x == 1.0 && dst[0].x == 99.0, "copy_frags clones TextFrag structs independently")
}

///|
test "Wave 85B: CSS 2.1 §9.5 BFC root / display:table drops below full-width preceding floats" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<header>" +
    "<div id='top' style='float:left;width:100%;height:48px'></div>" +
    "<div id='mid' style='float:left;width:100%;height:120px'></div>" +
    "<div id='nav' style='display:table;width:100%;height:50px'>Nav</div>" +
    "<div id='bfc' style='overflow:hidden;height:40px'>BFC</div>" +
    "</header></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let hdr = body.children[0]
  let b_nav = match box_of(root, hdr.children[2]) { Some(b) => b None => panic("nav") }
  let b_bfc = match box_of(root, hdr.children[3]) { Some(b) => b None => panic("bfc") }
  debug_assert((b_nav.y - 168.0).abs() < 1.0, "display:table width:100% must drop below two full-width floats (y=168), got y=" + b_nav.y.to_string())
  debug_assert((b_bfc.y - 218.0).abs() < 1.0, "following BFC root must sit below nav (y=218), got y=" + b_bfc.y.to_string())
  html::cut(doc)
}

///|
test "Wave 86B: CSS Flexbox 1 §9.5 column flex with height:auto and min-height aligns justify-content:flex-end" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='hero' style='display:flex;flex-direction:column;justify-content:flex-end;height:auto;min-height:800px;padding:60px 0 100px;box-sizing:border-box'>" +
    "<div id='content' style='height:200px'>Title</div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let hero = body.children[0]
  let b_content = match box_of(root, hero.children[0]) { Some(b) => b None => panic("content") }
  // Inner height = 800 - 60 - 100 = 640px; flex-end puts 200px child at y = 60 + (640 - 200) = 500px
  debug_assert((b_content.y - 500.0).abs() < 1.0, "column flex min-height justify-content:flex-end must place child at y=500, got y=" + b_content.y.to_string())
  html::cut(doc)
  // Also test specified height smaller than min-height (CSS 2.1 §10.7: clamp before layout_inner)
  let doc2 = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='hero2' style='display:flex;flex-direction:column;justify-content:flex-end;height:500px;min-height:800px;padding:60px 0 100px;box-sizing:border-box'>" +
    "<div id='content2' style='height:200px'>Title</div>" +
    "</div></body></html>",
  )
  let root2 = match generate(doc2, e) { Some(b) => b None => panic("root2") }
  layout_with_scrollbar(root2, fonts, 1280.0, 800.0, 0.0)
  let b_content2 = match box_of(root2, doc2.children[1].children[1].children[0].children[0]) { Some(b) => b None => panic("content2") }
  debug_assert((b_content2.y - 500.0).abs() < 1.0, "column flex height<min-height must clamp before layout_inner (y=500), got y=" + b_content2.y.to_string())
  html::cut(doc2)
}

///|
test "Wave 87B: relative-positioned ancestor shift settles into descendant containing block before run_abs" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:1000px;margin:0 auto'>" +
    "<div id='bleed' style='position:relative;left:50%;margin-left:-50vw;width:100vw'>" +
    "<div id='wrap' style='margin:0 auto;max-width:1000px'>" +
    "<div id='hero' style='position:relative;height:400px'>" +
    "<div id='card' style='position:absolute;top:50%;width:400px;height:120px'>Card</div>" +
    "</div></div></div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let hero = body.children[0].children[0].children[0].children[0]
  let card = hero.children[0]
  let b_hero = match box_of(root, hero) { Some(b) => b None => panic("hero") }
  let b_card = match box_of(root, card) { Some(b) => b None => panic("card") }
  // #bleed is at x = 140 - 640 + 500 = 0; #wrap centers 1000px inside 1280px -> hero.x = 140; card.x must match hero.x = 140!
  debug_assert((b_hero.x - 140.0).abs() < 1.0, "hero must be centered at x=140, got " + b_hero.x.to_string())
  debug_assert((b_card.x - 140.0).abs() < 1.0, "absolute card must reflect settled relative ancestor shift (x=140), got " + b_card.x.to_string())
  html::cut(doc)
}

///|
test "Wave 88B: CSS Flexbox 1 §8.1 stretched flex item preserves margin-left:auto after layout_root" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;width:1000px'>" +
    "<nav id='left' style='width:200px;height:40px'>Left</nav>" +
    "<nav id='right' style='display:flex;margin-left:auto;width:100px'>Right</nav>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1000.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1000.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let row = body.children[0]
  let b_right = match box_of(root, row.children[1]) { Some(b) => b None => panic("right") }
  // Stretched from 16px to 40px triggers layout_root -> set_edges; margin-left:auto must still push #right to x=900!
  debug_assert((b_right.x - 900.0).abs() < 1.0, "stretched flex item with margin-left:auto must sit at x=900, got x=" + b_right.x.to_string())
  debug_assert((b_right.ml - 700.0).abs() < 1.0, "stretched flex item ml must be 700, got ml=" + b_right.ml.to_string())
  html::cut(doc)
}

///|
test "Wave 89B: CSS 2.1 §10.3.2 inline replaced element with height:100% and width:auto preserves aspect ratio" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex'>" +
    "<a id='lnk' style='height:34px'><img id='logo' width='400' height='100' style='height:100%;width:auto'></a>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let lnk = body.children[0].children[0]
  let logo = lnk.children[0]
  let b_logo = match box_of(root, logo) { Some(b) => b None => panic("logo") }
  // 400x100 natural ratio = 4:1; at height 100% of 34px => width must be 34 * 4 = 136px (NOT 400px!)
  debug_assert((b_logo.h - 34.0).abs() < 1.0, "img height:100% must be 34px, got " + b_logo.h.to_string())
  debug_assert((b_logo.w - 136.0).abs() < 1.0, "img width:auto at height:100% must preserve 4:1 ratio (136px), got " + b_logo.w.to_string())
  html::cut(doc)
}

///|
test "Wave 89A: inline_utf8_last O(1) and inline_cp_to_string ASCII fast path" {
  debug_assert(inline_utf8_last("") == 0, "empty")
  debug_assert(inline_utf8_last("Hello") == 0x6F, "ascii o")
  debug_assert(inline_utf8_last("café") == 0xE9, "2-byte utf8")
  debug_assert(inline_utf8_last("abc中") == 0x4E2D, "3-byte utf8")
  debug_assert(inline_utf8_last("hi😀") == 0x1F600, "4-byte utf8")
  debug_assert(inline_cp_to_string(65) == "A", "ascii A")
  debug_assert(inline_cp_to_string(0x4E2D) == "中", "cjk")
}

///|
test "Wave 92B: SVG 2 §14.3.1 svg:not(:root) UA overflow:hidden enables Flexbox §4.5 shrinking" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;align-items:center;width:72px;height:44px'>" +
    "<div style='width:45.6px;height:100%'></div>" +
    "<svg height='44' viewBox='0 0 51 24' style='display:block;width:auto'></svg>" +
    "</div>" +
    "<div style='display:flex;align-items:center;width:72px;height:44px'>" +
    "<div style='width:45.6px;height:100%'></div>" +
    "<svg height='44' viewBox='0 0 51 24' style='display:block;width:auto;overflow:visible'></svg>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let row_default = body.children[0]
  let b_icons = match box_of(root, row_default.children[0]) { Some(b) => b None => panic("icons") }
  let b_svg = match box_of(root, row_default.children[1]) { Some(b) => b None => panic("svg") }
  // 45.6 / 139.1 * 72 ~= 23.6px, 93.5 / 139.1 * 72 ~= 48.4px
  debug_assert((b_icons.w - 23.6).abs() < 1.0, "sibling flex item must shrink to ~23.6px, got " + b_icons.w.to_string())
  debug_assert((b_svg.w - 48.4).abs() < 1.0, "svg with UA overflow:hidden must shrink to ~48.4px, got " + b_svg.w.to_string())
  let row_vis = body.children[1]
  let b_svg_vis = match box_of(root, row_vis.children[1]) { Some(b) => b None => panic("svg_vis") }
  debug_assert((b_svg_vis.w - 93.5).abs() < 1.0, "svg with overflow:visible must keep transferred min-width 93.5px, got " + b_svg_vis.w.to_string())
  html::cut(doc)
}

///|
test "Wave 97B: CSS Grid 1 §6.2 direction:rtl places columns right-to-left and mirrors start/end justify" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;direction:rtl;width:400px;grid-template-columns:200px 100px 100px'>" +
    "<div id='c0' style='height:40px'></div>" +
    "<div id='c1' style='height:40px'></div>" +
    "<div id='c2' style='height:40px;width:40px;justify-self:start'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let grid = doc.children[1].children[1].children[0]
  let b0 = match box_of(root, grid.children[0]) { Some(b) => b None => panic("c0") }
  let b1 = match box_of(root, grid.children[1]) { Some(b) => b None => panic("c1") }
  let b2 = match box_of(root, grid.children[2]) { Some(b) => b None => panic("c2") }
  // Column 0 (200px) on the right: x=200..400; Column 1 (100px): x=100..200; Column 2 (100px): x=0..100 with justify-self:start => right edge x=60..100
  debug_assert((b0.x - 200.0).abs() < 0.5 && (b0.w - 200.0).abs() < 0.5, "RTL col 0 must be at x=200, got " + b0.x.to_string())
  debug_assert((b1.x - 100.0).abs() < 0.5 && (b1.w - 100.0).abs() < 0.5, "RTL col 1 must be at x=100, got " + b1.x.to_string())
  debug_assert((b2.x - 60.0).abs() < 0.5 && (b2.w - 40.0).abs() < 0.5, "RTL col 2 justify-self:start must align to right of cell (x=60), got " + b2.x.to_string())
  html::cut(doc)
}

///|
test "Wave 92A: is_simple_ltr_cp boundaries (ASCII, Latin-1/Ext, smart punctuation vs combining/RTL/soft-hyphen)" {
  debug_assert(is_simple_ltr_cp(0x20) && is_simple_ltr_cp(0x7E), "printable ASCII included")
  debug_assert(is_simple_ltr_cp(0xE9) && is_simple_ltr_cp(0xEA) && is_simple_ltr_cp(0xE7), "French accented Latin included")
  debug_assert(is_simple_ltr_cp(0x2014) && is_simple_ltr_cp(0x2019) && is_simple_ltr_cp(0xAB), "em-dash/curly-apostrophe/guillemet included")
  debug_assert(!is_simple_ltr_cp(0xAD), "soft hyphen excluded")
  debug_assert(!is_simple_ltr_cp(0x0A) && !is_simple_ltr_cp(0x7F) && !is_simple_ltr_cp(0x80), "control chars excluded")
  debug_assert(!is_simple_ltr_cp(0x0301), "combining acute accent excluded")
  debug_assert(!is_simple_ltr_cp(0x05D0) && !is_simple_ltr_cp(0x0627), "Hebrew/Arabic RTL excluded")
}

///|
test "Wave 93A: inline_or_block_intrinsic dual min/max cache, scroll_ext_of inline TextRun & flatten direct space" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;width:400px'>" +
    "<div id='a' style='overflow:auto'>bonjour de la maison et pour tout le monde</div>" +
    "<div id='b' style='min-width:max-content'>hello world</div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let flex = doc.children[1].children[1].children[0]
  let ba = match box_of(root, flex.children[0]) { Some(b) => b None => panic("a") }
  let bb = match box_of(root, flex.children[1]) { Some(b) => b None => panic("b") }
  debug_assert(ba.w > 0.0 && bb.w > 0.0 && (ba.w + bb.w - 400.0).abs() < 2.0, "flex items with dual intrinsic cache laid out cleanly")
  let (sw, sh, _, _) = box_scroll_sizes(ba)
  debug_assert(sw >= ba.w - 0.5 && sh >= ba.h - 0.5, "scroll_ext_of inline TextRun preserves scrollWidth/scrollHeight")
  html::cut(doc)
}

///|
test "Wave 20C: inline/inline-block viewBox-only <svg> fills containing block width and preserves aspect ratio" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:1280px'><svg style='display:inline-block' viewBox='0 0 1440 320'></svg></div>" +
    "<div style='width:640px'><svg viewBox='0 0 1440 320'></svg></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let svg_ib = match box_of(root, body.children[0].children[0]) { Some(b) => b None => panic("svg_ib") }
  let svg_in = match box_of(root, body.children[1].children[0]) { Some(b) => b None => panic("svg_in") }
  let expected_h1 = 1280.0 * 320.0 / 1440.0
  let expected_h2 = 640.0 * 320.0 / 1440.0
  debug_assert((svg_ib.w - 1280.0).abs() < 0.5, "inline-block viewBox-only svg must fill 1280px CB, got " + svg_ib.w.to_string())
  debug_assert((svg_ib.h - expected_h1).abs() < 0.5, "inline-block viewBox-only svg height must match ratio, got " + svg_ib.h.to_string())
  debug_assert((svg_in.w - 640.0).abs() < 0.5, "inline viewBox-only svg must fill 640px CB, got " + svg_in.w.to_string())
  debug_assert((svg_in.h - expected_h2).abs() < 0.5, "inline viewBox-only svg height must match ratio, got " + svg_in.h.to_string())
  html::cut(doc)
}

///|
test "Wave 20C: floated grid container with height:100% resolves containing block height and distributes 1fr rows" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<main style='width:740px;height:510px'>" +
    "<section style='float:left;height:100%;display:grid;grid-template-columns:50px;grid-template-rows:repeat(5, 1fr)'>" +
    "<div style='height:30px;align-self:center'></div>" +
    "<div style='height:30px;align-self:center'></div>" +
    "<div style='height:30px;align-self:center'></div>" +
    "<div style='height:30px;align-self:center'></div>" +
    "<div style='height:30px;align-self:center'></div>" +
    "</section></main></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let sec = doc.children[1].children[1].children[0].children[0]
  let bsec = match box_of(root, sec) { Some(b) => b None => panic("sec") }
  let r0 = match box_of(root, sec.children[0]) { Some(b) => b None => panic("r0") }
  let r4 = match box_of(root, sec.children[4]) { Some(b) => b None => panic("r4") }
  debug_assert((bsec.h - 510.0).abs() < 0.5, "floated grid height:100% must resolve to 510px, got " + bsec.h.to_string())
  debug_assert((r4.y - r0.y - 408.0).abs() < 1.0, "5th 1fr row must be 408px below 1st row, got " + (r4.y - r0.y).to_string())
  html::cut(doc)
}

///|
test "Wave 102B: trailing negative-margin inline-block does not shrink max-content width & padded <select> reserves horizontal padding" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;width:600px'>" +
    "<div id='wrap' style='padding-left:24px;box-sizing:border-box'>" +
    "<span style='display:inline-block;width:20px;height:20px'></span>" +
    "<select id='sel' style='display:inline-block;padding:0 24px 0 8px;border:0;box-sizing:border-box'><option>Select language</option></select>" +
    "<span style='display:inline-block;width:10px;height:20px;margin-left:-22px'></span>" +
    "</div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let flex = doc.children[1].children[1].children[0]
  let wrap = flex.children[0]
  let sel = wrap.children[1]
  let bwrap = match box_of(root, wrap) { Some(b) => b None => panic("wrap") }
  let bsel = match box_of(root, sel) { Some(b) => b None => panic("sel") }
  // Without high-water mark in inline_widths, trailing margin-left:-22px shrinks wrap below icon+select and wraps select to y>=20
  debug_assert(bsel.y < 10.0, "select must stay on line 1 instead of wrapping due to trailing negative margin, got y=" + bsel.y.to_string())
  // With hedges(b)=32 > 22, select inner content box (bsel.w - 32) must fit "Select language" without clipping
  debug_assert(bsel.w - 32.0 >= 80.0, "padded select must reserve full horizontal padding, got w=" + bsel.w.to_string())
  debug_assert(bwrap.w >= 24.0 + 20.0 + bsel.w - 0.5, "flex item wrap must fit padding + icon + select, got w=" + bwrap.w.to_string())
  html::cut(doc)
}

///|
test "Wave 104B: CSS Grid 1 §11.7.1 multi-row spanning item crossing 1fr row in indefinite-height grid sizes the fr row instead of collapsing to 0" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;grid-template-columns:300px 200px;grid-template-rows:minmax(auto,54px) 1fr auto;row-gap:8px'>" +
    "<div id='quote' style='grid-column:1;grid-row:1 / span 2;height:140px'></div>" +
    "<div id='card' style='grid-column:1;grid-row:3;height:200px'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let grid = doc.children[1].children[1].children[0]
  let bq = match box_of(root, grid.children[0]) { Some(b) => b None => panic("quote") }
  let bc = match box_of(root, grid.children[1]) { Some(b) => b None => panic("card") }
  debug_assert(bq.h >= 139.5, "quote spanning row 1..2 must keep 140px height, got " + bq.h.to_string())
  debug_assert(bc.y >= 147.5, "card in row 3 must sit below 140px quote + 8px gap without overlapping, got y=" + bc.y.to_string())
  html::cut(doc)
}

///|
test "Wave 106B: CSS 2.1 §10.3.6 floated replaced element with width:auto and height:100% preserves intrinsic aspect ratio" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<a style='display:block;width:200px;height:40px'>" +
    "<img id='logo' style='float:left;width:auto;height:100%'>" +
    "</a></body></html>",
  )
  let a = doc.children[1].children[1].children[0]
  let img = a.children[0]
  img.natural = Some((584.0, 877.0))
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let bi = match box_of(root, img) { Some(b) => b None => panic("img") }
  let expected_w = 40.0 * 584.0 / 877.0
  debug_assert((bi.h - 40.0).abs() < 0.5, "floated img height:100% must resolve to 40px, got " + bi.h.to_string())
  debug_assert((bi.w - expected_w).abs() < 0.5, "floated img width:auto must preserve aspect ratio (~26.6px) instead of naturalWidth 584px, got " + bi.w.to_string())
  html::cut(doc)
}

///|
test "Wave 107B: CSS Overflow 4 §5.2 -webkit-line-clamp appends block overflow ellipsis on last kept line" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='clamped' style='display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;width:120px;font-size:16px;line-height:20px'>alpha beta gamma delta epsilon zeta eta theta iota kappa</div>" +
    "<div id='short' style='display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden;width:240px;font-size:16px;line-height:20px'>short text</div>" +
    "</body></html>",
  )
  let body = doc.children[1].children[1]
  let clamped = body.children[0]
  let short_el = body.children[1]
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let bc = match box_of(root, clamped) { Some(b) => b None => panic("clamped") }
  let bs = match box_of(root, short_el) { Some(b) => b None => panic("short") }
  let mut saw_ell = false
  let mut ell_overflow = false
  let limit_x = bc.x + bc.w
  for ch in bc.children {
    for f in ch.frags {
      if f.text.contains("\u{2026}") {
        saw_ell = true
        if f.x + f.w > limit_x + 1.0 { ell_overflow = true }
      }
    }
  }
  debug_assert(saw_ell, "clamped block must append U+2026 ellipsis on last kept line")
  debug_assert(!ell_overflow, "ellipsis fragment must not overflow container inline-end edge")
  let mut short_ell = false
  for ch in bs.children {
    for f in ch.frags {
      if f.text.contains("\u{2026}") { short_ell = true }
    }
  }
  debug_assert(!short_ell, "unclamped block must not receive ellipsis")
  html::cut(doc)
}

///|
test "Wave 22C: iframe has no intrinsic aspect ratio so tall flex/grid split panes do not inflate width" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='app' style='display:grid;grid-template-columns:max-content auto;width:1280px;height:800px'>" +
    "<div id='nav' style='width:180px'></div>" +
    "<div id='main'><div id='panels' style='display:grid;grid-template-columns:250px 1fr;height:800px'>" +
    "<div id='controls'></div>" +
    "<div id='split' style='display:flex;height:800px'>" +
    "<div id='left' style='flex:1 1 0;display:flex;flex-direction:column;height:800px'><iframe style='width:100%;height:100%'></iframe></div>" +
    "<div id='right' style='flex:1 1 0;display:flex;flex-direction:column;height:800px'><iframe style='width:100%;height:100%'></iframe></div>" +
    "</div></div></div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let app = doc.children[1].children[1].children[0]
  let main = app.children[1]
  let panels = main.children[0]
  let split = panels.children[1]
  let left = split.children[0]
  let right = split.children[1]
  let bmain = match box_of(root, main) { Some(b) => b None => panic("main") }
  let bleft = match box_of(root, left) { Some(b) => b None => panic("left") }
  let bright = match box_of(root, right) { Some(b) => b None => panic("right") }
  debug_assert((bmain.w - 1100.0).abs() < 1.0, "auto grid column must fit remaining 1100px, got " + bmain.w.to_string())
  debug_assert((bleft.w - 425.0).abs() < 1.0, "left split pane must be 425px, got " + bleft.w.to_string())
  debug_assert((bright.w - 425.0).abs() < 1.0, "right split pane must be 425px, got " + bright.w.to_string())
  debug_assert((bright.x - 855.0).abs() < 1.0, "right split pane must stay onscreen at x=855, got " + bright.x.to_string())
  html::cut(doc)
}

///|
test "Wave 24C: CSS Sizing 4 §2.1 flex-column item with definite width and aspect-ratio resolves child height:100%" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;flex-direction:column;width:300px'>" +
    "<div id='ar' style='width:100%;aspect-ratio:12/12'>" +
    "<div id='inner' style='position:relative;height:100%'>" +
    "<div id='abs' style='position:absolute;top:0;left:0;width:100%;height:100%'></div>" +
    "</div></div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let flex = doc.children[1].children[1].children[0]
  let ar = flex.children[0]
  let inner = ar.children[0]
  let abs = inner.children[0]
  let bar = match box_of(root, ar) { Some(b) => b None => panic("ar") }
  let binner = match box_of(root, inner) { Some(b) => b None => panic("inner") }
  let babs = match box_of(root, abs) { Some(b) => b None => panic("abs") }
  debug_assert((bar.h - 300.0).abs() < 1.0, "aspect-ratio 12/12 box must be 300px tall, got " + bar.h.to_string())
  debug_assert((binner.h - 300.0).abs() < 1.0, "child height:100% inside aspect-ratio flex-column item must resolve to 300px, got " + binner.h.to_string())
  debug_assert((babs.h - 300.0).abs() < 1.0, "abspos grandchild height:100% must resolve to 300px, got " + babs.h.to_string())
  html::cut(doc)
}

///|
test "Wave 108B: CSS Overflow 4 §5.2 -webkit-line-clamp ellipsis across nested inline spans" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='box' style='display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;width:110px;font-size:16px;line-height:20px'>" +
    "<span>PREFIX: </span><span>alpha beta gamma delta epsilon zeta eta theta</span>" +
    "</div></body></html>",
  )
  let box_el = doc.children[1].children[1].children[0]
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let b = match box_of(root, box_el) { Some(x) => x None => panic("box") }
  let mut ell_count = 0
  let mut ell_ok = true
  let limit_x = b.x + b.w
  let stack : Array[Box] = [b]
  while stack.length() > 0 {
    let n = match stack.pop() { Some(x) => x None => break }
    for f in n.frags {
      if f.text.contains("\u{2026}") {
        ell_count += 1
        if f.x + f.w > limit_x + 1.0 { ell_ok = false }
      }
    }
    for ch in n.children { stack.push(ch) }
  }
  debug_assert(ell_count == 1, "clamped block with nested inline spans must emit exactly one U+2026 ellipsis, got " + ell_count.to_string())
  debug_assert(ell_ok, "nested inline ellipsis must fit within container inline-end edge")
  html::cut(doc)
}

///|
test "Wave 109B: CSS Sizing 3 §5.2.1 replaced element with percentage width compresses min-content to 0 in flex item" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;flex-wrap:wrap;width:900px'>" +
    "<div id='c1' style='flex:0 1 33.3%'><img style='width:100%;height:auto'></div>" +
    "<div id='c2' style='flex:0 1 33.3%'><img style='width:100%;height:auto'></div>" +
    "<div id='c3' style='flex:0 1 33.3%'><img style='width:100%;height:auto'></div>" +
    "</div></body></html>",
  )
  let row = doc.children[1].children[1].children[0]
  let c1 = row.children[0]
  let c2 = row.children[1]
  let c3 = row.children[2]
  c1.children[0].natural = Some((768.0, 341.0))
  c2.children[0].natural = Some((768.0, 341.0))
  c3.children[0].natural = Some((768.0, 341.0))
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let b1 = match box_of(root, c1) { Some(b) => b None => panic("c1") }
  let b2 = match box_of(root, c2) { Some(b) => b None => panic("c2") }
  let b3 = match box_of(root, c3) { Some(b) => b None => panic("c3") }
  debug_assert((b1.w - 299.7).abs() < 2.0, "c1 must stay ~33.3% (~300px) instead of 768px naturalWidth, got " + b1.w.to_string())
  debug_assert((b2.y - b1.y).abs() < 1.0 && (b3.y - b1.y).abs() < 1.0, "all 3 cards must stay on one flex line without wrapping")
  html::cut(doc)
}

///|
test "Wave 99A: pct_h_independent caches intrinsic min_c/max_c under definite flex height while preserving height:100% replaced ratio" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='flex' style='display:flex;width:600px;height:300px'>" +
    "<div id='plain' style='flex:0 1 auto'><p>Hello world from TipTap editor</p></div>" +
    "<div id='pct' style='display:flex;height:100%'><img src='a.png' style='height:100%;width:auto'></div>" +
    "</div></body></html>",
  )
  let flex = doc.children[1].children[1].children[0]
  let plain = flex.children[0]
  let pct = flex.children[1]
  let img = pct.children[0]
  img.natural = Some((100.0, 200.0))
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout(root, fonts, 800.0, 600.0)
  let bplain = match box_of(root, plain) { Some(b) => b None => panic("plain") }
  let bpct = match box_of(root, pct) { Some(b) => b None => panic("pct") }
  debug_assert(bplain.min_c >= 0.0 || bplain.max_c >= 0.0, "pct_h-independent flex item must populate intrinsic cache under definite flex height")
  debug_assert((bpct.w - 150.0).abs() < 1.0, "height:100% replaced img (100x200 in 300px) must preserve 150px width, got " + bpct.w.to_string())
  let bp = bplain.children[0]
  debug_assert(bp.min_c >= 0.0 && bp.max_c >= 0.0, "Wave 100A: own=true all_inline intrinsic populates both min_c and max_c")
  html::cut(doc)
}

///|
test "Wave 112B: CSS Grid 1 §8.3 named line brackets around repeat(12, minmax(auto, 85px)) span full center track" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='g' style='display:grid;width:1280px;column-gap:20px;grid-template-columns:[fullWidth-start] minmax(80px, 1fr) [col-start] repeat(12, minmax(auto, 85px)) [col-end] minmax(80px, 1fr) [fullWidth-end]'>" +
    "<div id='fw' style='grid-column:fullWidth;height:20px'></div>" +
    "<div id='c' style='grid-column:col;height:20px'></div>" +
    "</div></body></html>",
  )
  let g = doc.children[1].children[1].children[0]
  let fw = g.children[0]
  let c = g.children[1]
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let bfw = match box_of(root, fw) { Some(b) => b None => panic("fw") }
  let bc = match box_of(root, c) { Some(b) => b None => panic("c") }
  debug_assert((bfw.w - 1280.0).abs() < 1.0, "fullWidth must span all 14 columns (1280px), got " + bfw.w.to_string())
  debug_assert((bc.x - 100.0).abs() < 1.0 && (bc.w - 1080.0).abs() < 1.0, "col must start at 100px and span 1080px, got x=" + bc.x.to_string() + " w=" + bc.w.to_string())
  html::cut(doc)
}

///|
test "Wave 114B: CSS Flexbox 1 §5.1 dir=rtl mirrors flex row main axis right-to-left" {
  let doc = html::parse(
    "<!doctype html><html dir='rtl'><body style='margin:0'>" +
    "<nav style='display:flex;width:1000px'>" +
    "<a id='first' style='width:120px;height:40px'>الشرق</a>" +
    "<a id='second' style='width:80px;height:40px'>سياسة</a>" +
    "</nav></body></html>",
  )
  let nav = doc.children[1].children[1].children[0]
  let first = nav.children[0]
  let second = nav.children[1]
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let bnav = match box_of(root, nav) { Some(b) => b None => panic("nav") }
  let bf = match box_of(root, first) { Some(b) => b None => panic("first") }
  let bs = match box_of(root, second) { Some(b) => b None => panic("second") }
  debug_assert((bf.x - (bnav.x + 880.0)).abs() < 1.0, "first RTL flex item must start at nav right edge, got " + bf.x.to_string())
  debug_assert((bs.x - (bnav.x + 800.0)).abs() < 1.0, "second RTL flex item must sit immediately left of first, got " + bs.x.to_string())
  html::cut(doc)
}

///|
test "Wave 102A: end_line precomputed inline extent y-bounds and column flex_content_size measured reuse" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='col' style='display:flex;flex-direction:column;width:300px'>" +
    "<div id='item'><span id='s1' style='padding:2px 4px;border:1px solid black'>alpha <strong id='s2'>beta gamma delta</strong> epsilon</span></div>" +
    "</div></body></html>",
  )
  let col = doc.children[1].children[1].children[0]
  let item = col.children[0]
  let s1 = item.children[0]
  let s2 = s1.children[1]
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let bs1 = match box_of(root, s1) { Some(b) => b None => panic("s1") }
  let bs2 = match box_of(root, s2) { Some(b) => b None => panic("s2") }
  let bitem = match box_of(root, item) { Some(b) => b None => panic("item") }
  debug_assert(bs1.has_frag && bs1.max_x > bs1.min_x && bs1.max_y > bs1.min_y, "outer span has valid precomputed extent")
  debug_assert(bs2.has_frag && bs2.min_x >= bs1.min_x && bs2.max_x <= bs1.max_x, "inner strong extent fits inside outer span")
  let h0 = bitem.h
  // Re-layout at same width to exercise flex_content_size measured() reuse and recursive keep_layout_rec
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  debug_assert((bitem.h - h0).abs() < 0.1 && bitem.h > 10.0, "column flex item preserves height across measured reuse")
  html::cut(doc)
}

