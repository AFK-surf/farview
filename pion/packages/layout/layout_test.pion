  engine.add_sheet(
    "body{margin:0} .lbl{width:60px;white-space:nowrap;font-size:13px;line-height:20px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let lbl = doc.children[1].children[1].children[0]
  match box_of(root, lbl) {
    Some(lb) => {
      debug_assert(lb.h <= 25.0, "white-space:nowrap with inline <a> tags must stay single-line (<=25px), got h=" + lb.h.to_string())
    }
    None => panic("missing lbl box")
  }
}

