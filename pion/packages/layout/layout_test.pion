///|
test "Wave 120B: CSS Grid asymmetric 1fr 2fr dashboard with absolute overlay badge" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='position:relative;display:grid;grid-template-columns:1fr 2fr;gap:20px;width:920px'>" +
    "<div id='kpi' style='height:200px'>1,228</div>" +
    "<div id='chart' style='height:200px'>Chart</div>" +
    "<div id='toast' style='position:absolute;right:16px;bottom:16px;width:240px;height:48px'>Alert</div>" +
    "</div></body></html>",
  )
  let wrap = doc.children[1].children[1].children[0]
  let kpi = wrap.children[0]
  let chart = wrap.children[1]
  let toast = wrap.children[2]
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let bk = match box_of(root, kpi) { Some(b) => b None => panic("kpi") }
  let bc = match box_of(root, chart) { Some(b) => b None => panic("chart") }
  let bt = match box_of(root, toast) { Some(b) => b None => panic("toast") }
  debug_assert((bk.w - 300.0).abs() < 1.0 && (bc.w - 600.0).abs() < 1.0, "1fr 2fr tracks in 920px grid with 20px gap must resolve to 300px and 600px")
  debug_assert((bc.x - 320.0).abs() < 1.0, "second grid column must start at x=320")
  debug_assert((bt.x - (920.0 - 16.0 - 240.0)).abs() < 1.0 && (bt.y - (200.0 - 16.0 - 48.0)).abs() < 1.0,
    "absolute overlay toast must anchor to bottom-right of grid container")
  html::cut(doc)
}

