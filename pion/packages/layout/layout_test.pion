test "flex item with definite height propagates pct_h to child img height:100%" {
  let doc = html::parse(
    "<!doctype html><html><body><a class=brand><div class=logo><img id=ic src=\"logo.svg\"></div><span>Electron</span></a></body></html>",
  )
  let walk = [doc]
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "img" {
      n.natural = Some((128.0, 128.0))
    }
    for ch in n.children { walk.push(ch) }
  }
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .brand{display:flex;align-items:center} .logo{flex:none;height:30px} .logo img{height:100%}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let logo = doc.children[1].children[1].children[0].children[0]
  match box_of(root, logo) {
    Some(lb) => {
      debug_assert((lb.w - 30.0).abs() < 0.5 && (lb.h - 30.0).abs() < 0.5, "logo div must shrink to 30x30 from img height:100%, got " + lb.w.to_string() + "x" + lb.h.to_string())
    }
    None => panic("missing logo box")
  }
}

test "absolute replaced img with inset:0 and margin:auto centers horizontally and preserves aspect ratio" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=hero><img id=gem src=\"gem.svg\"></div></body></html>",
  )
  let walk = [doc]
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "img" {
      n.natural = Some((400.0, 300.0))
    }
    for ch in n.children { walk.push(ch) }
  }
  let engine = css::Engine::new(css::Env::{ width: 1000.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .hero{position:relative;width:1000px;height:600px} #gem{position:absolute;left:0;right:0;top:0;bottom:0;width:400px;height:auto;margin:auto}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1000.0, 600.0, 0.0)
  let gem = doc.children[1].children[1].children[0].children[0]
  match box_of(root, gem) {
    Some(gb) => {
      debug_assert((gb.x - 300.0).abs() < 0.5 && (gb.y - 150.0).abs() < 0.5, "gem must center at (300, 150), got (" + gb.x.to_string() + ", " + gb.y.to_string() + ")")
      debug_assert((gb.w - 400.0).abs() < 0.5 && (gb.h - 300.0).abs() < 0.5, "gem must keep 400x300 aspect ratio instead of stretching to 600, got " + gb.w.to_string() + "x" + gb.h.to_string())
    }
    None => panic("missing gem box")
  }
}

test "wave36a_set_edges_zero_fastpath_cache_and_aspect_ratio" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=zero></div><div class=edged></div><div class=ar1></div><div class=ar2></div><div class=ar3></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .zero{display:block} .edged{display:block;margin-top:10px;padding-left:8px;border-right:2px solid black} .ar1{aspect-ratio:2} .ar2{aspect-ratio:4/2} .ar3{aspect-ratio:1 2 3}",
  )
  let root = test_unwrap(generate(doc, engine))
  let body = doc.children[1].children[1]
  let bz = test_unwrap(box_of(root, body.children[0]))
  let be = test_unwrap(box_of(root, body.children[1]))
  let bar1 = test_unwrap(box_of(root, body.children[2]))
  let bar2 = test_unwrap(box_of(root, body.children[3]))
  let bar3 = test_unwrap(box_of(root, body.children[4]))

  // Zero-edge fast path keeps b.edges == no_edges (length 0) and caches edges_uid/edges_cbw
  set_edges(bz, 800.0)
  debug_assert(bz.edges.length() == 0 && bz.edges_uid == bz.style.uid && bz.edges_cbw == 800.0, "zero edges stays zero-alloc")
  debug_assert(bz.mt == 0.0 && bz.pl == 0.0 && bz.br == 0.0, "zero edges values")

  // Non-zero edges allocate 12-elem cache and reuse on repeat call
  set_edges(be, 800.0)
  debug_assert(be.edges.length() == 12 && be.mt == 10.0 && be.pl == 8.0 && be.br == 2.0, "non-zero edges computed")
  be.mt = 999.0
  set_edges(be, 800.0)
  debug_assert(be.mt == 10.0 && be.pl == 8.0 && be.br == 2.0, "non-zero edges restored from cache")

  // Switching style back to zero-edge resets edges to 0 and drops 12-elem array
  be.set_style(bz.style)
  set_edges(be, 800.0)
  debug_assert(be.edges.length() == 0 && be.mt == 0.0 && be.pl == 0.0 && be.br == 0.0, "style switch back to zero-edge resets cleanly")

  // aspect_ratio 1 / 2 / 3 number boundaries (zero-alloc)
  match aspect_ratio(bar1) {
    Some(r) => debug_assert(r == 2.0, "aspect-ratio: 2")
    None => panic("ar1 missing")
  }
  match aspect_ratio(bar2) {
    Some(r) => debug_assert(r == 2.0, "aspect-ratio: 4/2")
    None => panic("ar2 missing")
  }
  debug_assert(aspect_ratio(bar3).is_none(), "aspect-ratio with 3 numbers must return None")
  debug_assert(aspect_ratio(bz).is_none(), "missing aspect-ratio must return None")
}

///|
test "intrinsic width with percentage height child does not recurse infinitely" {
  let doc = html::parse(
    "<!doctype html><html><body style=\"margin:0\"><div style=\"display:flex;flex-direction:row;height:40px\"><div id=bars style=\"display:flex;flex-direction:row;height:100%\"><div id=b1 style=\"width:20px;margin-right:5px;height:98.5%\"></div><div id=b2 style=\"width:20px;margin-right:5px;height:88.7%\"></div></div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  layout(root, Fonts::new(), 800.0, 600.0)
  let body = doc.children[1].children[1]
  let outer = body.children[0]
  let bars = outer.children[0]
  let b1 = test_unwrap(box_of(root, bars.children[0]))
  let b2 = test_unwrap(box_of(root, bars.children[1]))
  let bbars = test_unwrap(box_of(root, bars))
  debug_assert(bbars.w == 50.0, "bars intrinsic width should be 50px")
  debug_assert(b1.w == 20.0 && b2.w == 20.0, "bar widths should be 20px")
  debug_assert(b1.h > 39.0 && b1.h < 40.0, "b1 height should be 98.5% of 40px")
  debug_assert(b2.h > 35.0 && b2.h < 36.0, "b2 height should be 88.7% of 40px")
}

///|
test "inline-flex uses first baseline instead of last_baseline in inline formatting context" {
  let doc = html::parse(
    "<!doctype html><html><body style=\"margin:0;font-size:20px;line-height:30px\"><div id=wrap style=\"overflow:hidden\"><div id=fl style=\"display:inline-flex;flex-direction:column;height:30px;width:100px\"><span>assets</span><span>scripts</span></div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  layout(root, Fonts::new(), 800.0, 600.0)
  let body = doc.children[1].children[1]
  let wrap = body.children[0]
  let bwrap = test_unwrap(box_of(root, wrap))
  let bfl = test_unwrap(box_of(root, wrap.children[0]))
  debug_assert(bfl.h == 30.0, "inline-flex height should stay 30px")
  debug_assert(bwrap.h < 45.0, "overflow:hidden wrapper should match single-line height (~30px), not 60px, got " + bwrap.h.to_string())
}

test "flow_masks predicates and zero-alloc Bfc.floats" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<div id='plain'></div>" +
    "<div id='ov' style='overflow:hidden'></div>" +
    "<div id='fr' style='display:flow-root'></div>" +
    "<div id='cl' style='contain:layout'></div>" +
    "<div id='cs' style='contain:size'></div>" +
    "<div id='tr' style='transform:translateX(4px)'></div>" +
    "<div id='fi' style='filter:blur(2px)'></div>" +
    "<div id='wc' style='will-change:transform'></div>" +
    "<div id='pe' style='padding-left:10%'></div>" +
    "<div id='ph' style='height:50%'><div id='phi' style='height:inherit'></div></div>" +
    "<div id='flwrap'><div id='fl1' style='float:left;width:40px;height:20px'></div><div id='fl2' style='float:right;width:30px;height:15px'></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let find_id = fn(id : String) -> html::Node {
    let stack : Array[html::Node] = [doc]
    while stack.length() > 0 {
      match stack.pop() {
        Some(n) => {
          if n.attr("id").unwrap_or("") == id { return n }
          for c in n.children { stack.push(c) }
        }
        None => break
      }
    }
    panic("missing #" + id)
  }
  let mk = fn(n : html::Node) -> Box {
    let st = match e.style_of(n, None) {
      Some(s) => s
      None => panic("missing style")
    }
    new_box(Some(n), st, Kind::Block)
  }
  let html_node = doc.children[1]
  let b_html = mk(html_node)
  let b_plain = mk(find_id("plain"))
  let b_ov = mk(find_id("ov"))
  let b_fr = mk(find_id("fr"))
  let b_cl = mk(find_id("cl"))
  let b_cs = mk(find_id("cs"))
  let b_tr = mk(find_id("tr"))
  let b_fi = mk(find_id("fi"))
  let b_wc = mk(find_id("wc"))
  let b_pe = mk(find_id("pe"))
  let b_ph = mk(find_id("ph"))
  let phi_node = find_id("phi")
  let b_phi = new_box(
    Some(phi_node),
    match e.style_of(phi_node, Some(b_ph.style)) { Some(s) => s None => panic("missing phi style") },
    Kind::Block,
  )

  debug_assert(makes_bfc(b_html), "html makes_bfc")
  debug_assert(!makes_bfc(b_plain), "plain div not makes_bfc")
  debug_assert(makes_bfc(b_ov), "overflow:hidden makes_bfc")
  debug_assert(makes_bfc(b_fr), "display:flow-root makes_bfc")
  debug_assert(makes_bfc(b_cl), "contain:layout makes_bfc")
  debug_assert(size_contained(b_cs) && !size_contained(b_plain), "size_contained")
  debug_assert(!is_positioned(b_plain) && !holds_fixed(b_plain), "plain not positioned/holds_fixed")
  debug_assert(is_positioned(b_tr) && holds_fixed(b_tr), "transform is_positioned & holds_fixed")
  debug_assert(is_positioned(b_fi) && holds_fixed(b_fi), "filter is_positioned & holds_fixed")
  debug_assert(is_positioned(b_wc) && holds_fixed(b_wc), "will-change:transform is_positioned & holds_fixed")
  debug_assert(pct_edges(b_pe) && !pct_edges(b_plain), "pct_edges")
  debug_assert(pct_of_height(b_ph, false) && !pct_of_height(b_plain, false), "pct_of_height")
  debug_assert(pct_of_height(b_phi, false), "height:inherit from 50% parent preserves pct_of_height")

  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, e))
  layout(root, fonts, 800.0, 600.0)
  debug_assert(no_floats.length() == 0, "no_floats shared empty array must remain empty after float layout")
  html::cut(doc)
}

///|
test "row flex container definite height propagates pct_h to item intrinsic width with height:100% replaced img" {
  let doc = html::parse(
    "<!doctype html><html><body style=\"margin:0\"><div style=\"display:flex;height:48px\"><div id=logo style=\"flex:0 0 auto;height:100%\"><img style=\"height:100%\"></div></div></body></html>",
  )
  let body = doc.children[1].children[1]
  let brand = body.children[0]
  let logo = brand.children[0]
  let img = logo.children[0]
  img.natural = Some((253.0, 153.0))
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  layout(root, Fonts::new(), 800.0, 600.0)
  let blogo = test_unwrap(box_of(root, logo))
  // 48 * 253 / 153 = 79.3725...
  debug_assert(blogo.w > 78.0 && blogo.w < 81.0, "logo width should scale to ~79.37px, got " + blogo.w.to_string())
  debug_assert((blogo.h - 48.0).abs() < 0.5, "logo height should be 48px, got " + blogo.h.to_string())
}

test "offset_below, rel_below and sticky_below fast paths" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<div id='st'><span>plain</span></div>" +
    "<div id='rel0' style='position:relative'></div>" +
    "<div id='rel1' style='position:relative;top:5px'></div>" +
    "<div id='stk' style='position:sticky;top:0'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = test_unwrap(generate(doc, e))
  let body = doc.children[1].children[1]
  let b_st = test_unwrap(box_of(root, body.children[0]))
  let b_rel0 = test_unwrap(box_of(root, body.children[1]))
  let b_rel1 = test_unwrap(box_of(root, body.children[2]))
  let b_stk = test_unwrap(box_of(root, body.children[3]))
  debug_assert(!offset_below(b_st) && !rel_below(b_st) && !sticky_below(b_st), "static box false")
  debug_assert(!offset_below(b_rel0) && !rel_below(b_rel0), "relative with no inset false")
  debug_assert(offset_below(b_rel1) && rel_below(b_rel1) && !sticky_below(b_rel1), "relative+top:5px true")
  debug_assert(offset_below(b_stk) && sticky_below(b_stk) && !rel_below(b_stk), "sticky true")
  html::cut(doc)
}

test "box_scroll_sizes overflow:hidden clip, fixed skip, absolute & leaf" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='box' style='position:relative;width:100px;height:100px'>" +
    "<div id='leaf' style='width:50px;height:30px'></div>" +
    "<div id='clip' style='overflow:hidden;width:80px;height:40px'><div style='width:500px;height:500px'></div></div>" +
    "<div id='fix' style='position:fixed;left:0;top:0;width:900px;height:900px'></div>" +
    "<div id='abs' style='position:absolute;left:150px;top:120px;width:50px;height:60px'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = test_unwrap(generate(doc, e))
  layout(root, Fonts::new(), 800.0, 600.0)
  let b_box = test_unwrap(box_of(root, doc.children[1].children[1].children[0]))
  let (cw, ch, sw, sh) = box_scroll_sizes(b_box)
  debug_assert(cw == 100.0 && ch == 100.0, "client size 100x100")
  debug_assert(sw == 200.0 && sh == 180.0, "scroll size includes abs 200x180, skips fixed 900x900 and clipped 500x500, got " + sw.to_string() + "x" + sh.to_string())
  html::cut(doc)
}

///|
test "Wave 48A: ot_ascii_lower & inline_ascii_lower lowercase fast path and mixed case" {
  debug_assert(ot_ascii_lower("") == "", "ot empty")
  debug_assert(ot_ascii_lower("inline-block") == "inline-block", "ot already lower")
  debug_assert(ot_ascii_lower("Flex-Start_123") == "flex-start_123", "ot mixed case")
  debug_assert(inline_ascii_lower("nowrap") == "nowrap", "inline already lower")
  debug_assert(inline_ascii_lower("Pre-Wrap") == "pre-wrap", "inline mixed case")
}

///|
test "appearance:none checkbox with ::before content generates non-Replaced flex box with pseudo text" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'><input id='t' type='checkbox'></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "#t { appearance: none; display: flex; width: fit-content; font-size: 14px; } " +
    "#t::before { content: \"Made by Observable\"; }",
  )
  let root = test_unwrap(generate(doc, engine))
  layout(root, Fonts::new(), 800.0, 600.0)
  let inp = doc.children[1].children[1].children[0]
  let binp = test_unwrap(box_of(root, inp))
  let is_rep = match binp.kind { Kind::Replaced(_, _) => true _ => false }
  debug_assert(!is_rep, "appearance:none checkbox with ::before must not be Replaced")
  debug_assert(binp.children.length() > 0, "appearance:none checkbox must generate ::before child box")
  debug_assert(binp.w > 80.0, "checkbox with ::before 'Made by Observable' width must exceed 80px, got " + binp.w.to_string())
  html::cut(doc)
}

///|
test "pure-ratio SVG img sentinel (-1.0, vh/vw) respects definite height and CSS Images L3 300px default" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<img id='nav' style='display:block;height:24px'>" +
    "<div style='position:relative;width:400px;height:400px'><img id='hero' style='position:absolute;top:50%;left:50%;max-width:320px;max-height:320px'></div>" +
    "</body></html>",
  )
  let body = doc.children[1].children[1]
  let nav_img = body.children[0]
  let hero_img = body.children[1].children[0]
  nav_img.natural = Some((-1.0, 111.0 / 116.0))
  hero_img.natural = Some((-1.0, 111.0 / 116.0))
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  layout(root, Fonts::new(), 800.0, 600.0)
  let bnav = test_unwrap(box_of(root, nav_img))
  let bhero = test_unwrap(box_of(root, hero_img))
  debug_assert((bnav.h - 24.0).abs() < 0.5 && (bnav.w - 24.0 * 116.0 / 111.0).abs() < 0.5, "nav logo must be ~25.08x24, got " + bnav.w.to_string() + "x" + bnav.h.to_string())
  debug_assert(bhero.w >= 285.0 && bhero.w <= 320.5 && bhero.h >= 270.0 && bhero.h <= 320.5, "hero logo must scale to ~300x287, got " + bhero.w.to_string() + "x" + bhero.h.to_string())
  html::cut(doc)
}

///|
test "Wave 49A: said_width, clamp_w/h, clamp_keywords & constrained_replaced_width" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='plain' style='display:block'>hi</div>" +
    "<div id='clamped' style='width:200px;min-width:50px;max-width:120px;height:100px;min-height:30px;max-height:80px'></div>" +
    "<div id='ratio' style='height:40px;aspect-ratio:2/1'></div>" +
    "<div id='kw' style='width:min-content;max-width:max-content'>hello world</div>" +
    "<img id='im1' width='100' height='50' style='max-width:60px'>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_plain = match box_of(root, body.children[0]) { Some(b) => b None => panic("plain") }
  let b_clamped = match box_of(root, body.children[1]) { Some(b) => b None => panic("clamped") }
  let b_ratio = match box_of(root, body.children[2]) { Some(b) => b None => panic("ratio") }
  let b_kw = match box_of(root, body.children[3]) { Some(b) => b None => panic("kw") }
  let b_im1 = match box_of(root, body.children[4]) { Some(b) => b None => panic("im1") }
  debug_assert((b_clamped.w - 120.0).abs() < 0.5 && (b_clamped.h - 80.0).abs() < 0.5, "clamp_w and clamp_h enforce max-width/max-height")
  debug_assert((b_ratio.w - 80.0).abs() < 0.5 && (b_ratio.h - 40.0).abs() < 0.5, "said_width resolves aspect-ratio")
  debug_assert(b_kw.w > 0.0 && b_kw.w < 800.0, "said_width/clamp_keywords min-content")
  debug_assert((constrained_replaced_width(b_im1, 100.0, 50.0) - 60.0).abs() < 0.01, "constrained_replaced_width enforces max-width")
  debug_assert((constrained_replaced_width(b_plain, 100.0, 50.0) - 100.0).abs() < 0.01, "constrained_replaced_width fast-returns nw when unconstrained")
  debug_assert((clamp_w(b_plain, 250.0, Some(800.0)) - 250.0).abs() < 0.01, "clamp_w no-op when min/max absent")
  debug_assert((clamp_h(b_plain, 150.0, Some(600.0)) - 150.0).abs() < 0.01, "clamp_h no-op when min/max absent")
  html::cut(doc)
}

///|
test "Wave 51A: disp(s) cache hit & flow_flags rtl/-webkit-center/vertical_mode layout" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='rtl' style='width:200px;direction:rtl'><div id='rchild' style='width:60px;height:10px'></div></div>" +
    "<div id='wc' style='width:200px;text-align:-webkit-center'><div id='wchild' style='width:60px;height:10px'></div></div>" +
    "<div id='flx' style='display:inline flex'>a</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_rc = match box_of(root, body.children[0].children[0]) { Some(b) => b None => panic("rc") }
  let b_wc = match box_of(root, body.children[1].children[0]) { Some(b) => b None => panic("wc") }
  let b_flx = match box_of(root, body.children[2]) { Some(b) => b None => panic("flx") }
  debug_assert((b_rc.x - 140.0).abs() < 0.5, "rtl block child aligns right via flow_flags")
  debug_assert((b_wc.x - 70.0).abs() < 0.5, "-webkit-center block child centers via flow_flags")
  debug_assert(disp(b_flx.style) == "inline-flex" && b_flx.style.disp_str == "inline-flex", "disp(s) caches multi-keyword display")
  html::cut(doc)
}

///|
test "Wave 52A: flow_block height/aspect-ratio gates & run_abs_from aspect-ratio gate" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='auto_blk' style='width:200px'><div style='height:30px'></div></div>" +
    "<div id='def_blk' style='width:200px;height:55px'></div>" +
    "<div id='rat_blk' style='width:200px;aspect-ratio:4/1'></div>" +
    "<div id='abs_wrap' style='position:relative;width:300px;height:200px'>" +
    "<div id='abs_rat' style='position:absolute;top:0;left:0;height:40px;aspect-ratio:2/1'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_auto = match box_of(root, body.children[0]) { Some(b) => b None => panic("auto_blk") }
  let b_def = match box_of(root, body.children[1]) { Some(b) => b None => panic("def_blk") }
  let b_rat = match box_of(root, body.children[2]) { Some(b) => b None => panic("rat_blk") }
  let b_abs = match box_of(root, body.children[3].children[0]) { Some(b) => b None => panic("abs_rat") }
  debug_assert((b_auto.h - 30.0).abs() < 0.5, "flow_block without height/ratio sizes to child 30px, got " + b_auto.h.to_string())
  debug_assert((b_def.h - 55.0).abs() < 0.5, "flow_block with definite height 55px, got " + b_def.h.to_string())
  debug_assert((b_rat.h - 50.0).abs() < 0.5, "flow_block with aspect-ratio 4/1 at 200px -> 50px, got " + b_rat.h.to_string())
  debug_assert((b_abs.w - 80.0).abs() < 0.5 && (b_abs.h - 40.0).abs() < 0.5, "run_abs_from aspect-ratio 2/1 with height 40px -> width 80px, got w=" + b_abs.w.to_string())
  html::cut(doc)
}

///|
test "Wave 53A: zero/single-text element children fast paths, pseudo/details/table fallback & flow_children all-inline vs mixed" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='empty'></div>" +
    "<label id='lbl' style='display:block'>Buy milk</label>" +
    "<div id='pseudo_empty' class='hasp'></div>" +
    "<details id='det'></details>" +
    "<table id='tbl'><tr><td>cell</td></tr></table>" +
    "<div id='all_inl' style='width:200px'>hello <span>world</span></div>" +
    "<div id='mixed' style='position:relative;width:200px'>" +
    "<span style='float:left;width:40px;height:20px'></span>" +
    "<span style='position:absolute;top:0;left:0;width:10px;height:10px'></span>" +
    "<div style='height:25px'>blk</div>" +
    "</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet(".hasp::before { content: 'X'; } .hasp::after { content: 'Y'; }")
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_empty = match box_of(root, body.children[0]) { Some(b) => b None => panic("empty") }
  let b_lbl = match box_of(root, body.children[1]) { Some(b) => b None => panic("lbl") }
  let b_pseudo = match box_of(root, body.children[2]) { Some(b) => b None => panic("pseudo") }
  let b_det = match box_of(root, body.children[3]) { Some(b) => b None => panic("det") }
  let b_tbl = match box_of(root, body.children[4]) { Some(b) => b None => panic("tbl") }
  let b_inl = match box_of(root, body.children[5]) { Some(b) => b None => panic("all_inl") }
  let b_mix = match box_of(root, body.children[6]) { Some(b) => b None => panic("mixed") }
  debug_assert(b_empty.children.length() == 0, "empty div has 0 children")
  debug_assert(b_lbl.children.length() == 1 && b_lbl.children[0].text_node.is_some() && b_lbl.h > 0.0, "single-text label creates 1 TextRun with text_node and lays out")
  debug_assert(b_pseudo.children.length() == 2, "empty div with ::before/::after generates 2 pseudo children, got " + b_pseudo.children.length().to_string())
  debug_assert(b_det.children.length() >= 1, "empty details generates default Details summary box")
  debug_assert(b_tbl.children.length() >= 1 && b_tbl.h > 0.0, "table layout unaffected")
  debug_assert(b_inl.h > 0.0, "all-inline flow_children fast path lays out inline runs")
  debug_assert((b_mix.h - 25.0).abs() < 1.0, "mixed float/abs/block flow_children lays out block height 25px, got " + b_mix.h.to_string())
  html::cut(doc)
}

///|
test "Wave 54A: word_pieces fast path, flow_inline line/open reuse + float reentrancy & content_box fast/slow paths" {
  // 1. word_pieces: ASCII no-break, hyphen break, CJK break, prev causing first_break, nowrap
  let p_ascii = word_pieces("Active", false, 0, false)
  debug_assert(p_ascii.length() == 1 && p_ascii[0].0 == "Active" && !p_ascii[0].1, "ASCII word single piece without break")
  let p_prev = word_pieces("milk", false, 45, false)
  debug_assert(p_prev.length() == 1 && p_prev[0].0 == "milk" && p_prev[0].1, "prev hyphen sets first_break without splitting")
  let p_hyph = word_pieces("foo-bar", false, 0, false)
  debug_assert(p_hyph.length() == 2 && p_hyph[0].0 == "foo-" && !p_hyph[0].1 && p_hyph[1].0 == "bar" && p_hyph[1].1, "hyphen splits into 2 pieces")
  let p_cjk = word_pieces("你好", false, 0, false)
  debug_assert(p_cjk.length() == 2 && p_cjk[0].0 == "你" && p_cjk[1].0 == "好" && p_cjk[1].1, "CJK splits per char")
  let p_nw = word_pieces("foo-bar", true, 45, false)
  debug_assert(p_nw.length() == 1 && p_nw[0].0 == "foo-bar" && !p_nw[0].1, "nowrap skips splitting")

  // 2. flow_inline multi-line wrap + Open/Close + glued nowrap + nested float reentrancy + content_box fast/slow
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='wrap' style='width:80px'><span style='padding:0 2px'>alpha beta gamma delta</span> <span style='white-space:nowrap'>keep together</span></div>" +
    "<div id='flt_host' style='width:120px'><div style='float:left;width:40px'>flt text</div>main inline text wrapping</div>" +
    "<div id='c_empty' class='ce'></div>" +
    "<div id='c_single' class='cs'></div>" +
    "<div id='c_multi' class='cm' data-k='OK'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet(
    ".ce::before { content: ''; } .cs::before { content: '❯'; } body { counter-reset: n 3; } .cm::before { counter-increment: n 2; content: attr(data-k) '-' counter(n); }",
  )
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_wrap = match box_of(root, body.children[0]) { Some(b) => b None => panic("wrap") }
  let b_flt = match box_of(root, body.children[1]) { Some(b) => b None => panic("flt") }
  let b_ce = match box_of(root, body.children[2]) { Some(b) => b None => panic("ce") }
  let b_cs = match box_of(root, body.children[3]) { Some(b) => b None => panic("cs") }
  let b_cm = match box_of(root, body.children[4]) { Some(b) => b None => panic("cm") }
  debug_assert(b_wrap.h > 30.0, "multi-line wrap with spans & nowrap produces multiple lines, got h=" + b_wrap.h.to_string())
  debug_assert(b_flt.h > 15.0, "flow_inline with nested float text lays out cleanly, got h=" + b_flt.h.to_string())
  debug_assert(b_ce.children.length() == 1 && b_ce.children[0].children.length() == 0, "content: '' produces empty pseudo box")
  debug_assert(b_cs.children.length() == 1 && b_cs.children[0].children.length() == 1, "content: '❯' produces 1-child pseudo box")
  let cm_text = match b_cm.children[0].children[0].kind { TextRun(t) => t _ => "" }
  debug_assert(cm_text == "OK-5", "attr() + counter() content_box expected OK-5, got " + cm_text)
  html::cut(doc)
}

///|
test "Wave 55A: pieces_buf reentrancy (inline-block + float), whole-string single word & multi-word kern_across" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='outer' style='width:300px'>before <span id='ib' style='display:inline-block;padding:0 4px'>inner <b>nested</b></span> <div id='fl' style='float:left;width:60px'>float text</div> after</div>" +
    "<div id='single' style='width:200px'>SingleWord</div>" +
    "<div id='kern' style='width:200px'><span>A</span><span>V</span></div>" +
    "<div id='rtl_line' style='width:200px;direction:rtl'>hello</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_outer = match box_of(root, body.children[0]) { Some(b) => b None => panic("outer") }
  let b_ib = match box_of(root, body.children[0].children[1]) { Some(b) => b None => panic("ib") }
  let b_single = match box_of(root, body.children[1]) { Some(b) => b None => panic("single") }
  let b_kern = match box_of(root, body.children[2]) { Some(b) => b None => panic("kern") }
  let b_rtl = match box_of(root, body.children[3]) { Some(b) => b None => panic("rtl") }
  debug_assert(b_outer.h > 15.0 && b_ib.w > 20.0 && b_ib.h > 10.0, "reentrant inline-block + float inside flow_inline lays out cleanly")
  debug_assert(b_single.h > 10.0 && b_single.children.length() == 1 && b_single.children[0].frags.length() == 1 && b_single.children[0].frags[0].text == "SingleWord", "single word whole-string fast path")
  debug_assert(b_kern.h > 10.0 && b_kern.children.length() == 2, "multi-word kern_across preserves spans")
  debug_assert(b_rtl.children[0].frags.length() == 1 && b_rtl.children[0].frags[0].x > 100.0, "rtl line aligns right via flow_flags_val")
  html::cut(doc)
}

///|
test "Wave 57A: comment-only no_children fast path, floated gate, str_has_suffix/prefix, ratio_h & layout_root memo" {
  debug_assert(str_has_suffix("120px", "px") && !str_has_suffix("120em", "px") && !str_has_suffix("x", "px"), "zero-alloc str_has_suffix")
  debug_assert(str_has_prefix("zh-hant", "zh-") && !str_has_prefix("en", "zh-") && !str_has_prefix("z", "zh-"), "zero-alloc str_has_prefix")
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='cmt'><!-- svelte anchor --></div>" +
    "<div id='fl' style='float:left;width:50px;height:20px'></div>" +
    "<div id='nofl' style='width:50px;height:20px'></div>" +
    "<div id='rat' style='width:100px;aspect-ratio:2/1'></div>" +
    "<div id='box' style='width:200px'><div style='height:30px'></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_cmt = match box_of(root, body.children[0]) { Some(b) => b None => panic("cmt") }
  let b_fl = match box_of(root, body.children[1]) { Some(b) => b None => panic("fl") }
  let b_nofl = match box_of(root, body.children[2]) { Some(b) => b None => panic("nofl") }
  let b_rat = match box_of(root, body.children[3]) { Some(b) => b None => panic("rat") }
  let b_box = match box_of(root, body.children[4]) { Some(b) => b None => panic("box") }
  debug_assert(b_cmt.children.length() == 0, "comment-only element uses no_children fast path")
  debug_assert(floated(b_fl.style) && !floated(b_nofl.style), "floated maybe_has_id gate")
  debug_assert((b_rat.h - 50.0).abs() < 0.5 && ratio_h(b_nofl, 100.0).is_none(), "ratio_h gate and aspect-ratio calculation")
  debug_assert((b_box.h - 30.0).abs() < 0.5, "initial layout_root height 30px")
  // Re-layout at a different viewport width (memo miss) then same width (memo hit)
  layout_with_scrollbar(root, fonts, 600.0, 600.0, 0.0)
  layout_with_scrollbar(root, fonts, 600.0, 600.0, 0.0)
  debug_assert((b_box.h - 30.0).abs() < 0.5, "layout_root memo miss then hit preserves exact height")
  html::cut(doc)
}

///|
test "Wave 58A: inline_or_block_intrinsic (empty/inline/block/mixed+float), empty flow_block margin collapse & layout_root kept_on cleanup" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='i_empty' style='display:inline-block'></div>" +
    "<div id='i_inl' style='display:inline-block'>hello world</div>" +
    "<div id='i_blk' style='display:inline-block'><div style='width:80px;height:10px'></div><div style='width:120px;height:10px'></div></div>" +
    "<div id='i_mix' style='display:inline-block'><div style='float:left;width:40px;height:10px'></div><span>hi</span><div style='width:90px;height:10px'></div></div>" +
    "<div id='e_collapse' style='margin-top:20px;margin-bottom:30px'></div>" +
    "<div id='e_padded' style='padding-top:10px;margin-top:15px'></div>" +
    "<div id='after' style='height:10px'></div>" +
    "<div id='abs_host' style='position:relative;display:inline-block;width:100px;height:40px'><div style='position:absolute;top:5px;left:5px;width:10px;height:10px'></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_ie = match box_of(root, body.children[0]) { Some(b) => b None => panic("i_empty") }
  let b_ii = match box_of(root, body.children[1]) { Some(b) => b None => panic("i_inl") }
  let b_ib = match box_of(root, body.children[2]) { Some(b) => b None => panic("i_blk") }
  let b_im = match box_of(root, body.children[3]) { Some(b) => b None => panic("i_mix") }
  let b_ep = match box_of(root, body.children[5]) { Some(b) => b None => panic("e_padded") }
  let b_af = match box_of(root, body.children[6]) { Some(b) => b None => panic("after") }
  let b_ah = match box_of(root, body.children[7]) { Some(b) => b None => panic("abs_host") }
  debug_assert(b_ie.w == 0.0, "empty inline-block intrinsic width == 0")
  debug_assert(b_ii.w > 20.0, "all-inline intrinsic width > 20")
  debug_assert((b_ib.w - 120.0).abs() < 0.5, "all-block intrinsic width == 120")
  debug_assert((b_im.w - 130.0).abs() < 0.5, "mixed+float intrinsic width == 90 + 40 = 130, got " + b_im.w.to_string())
  debug_assert((b_ep.h - 10.0).abs() < 0.5 && (b_af.y - (b_ep.y + 10.0)).abs() < 0.5, "empty padded flow_block height=10 and next block starts below")
  // Second layout pass at different width to verify kept_on cleans up memo_pending/abs_cb
  layout_with_scrollbar(root, fonts, 600.0, 600.0, 0.0)
  debug_assert(b_ah.abs_cb.is_none(), "layout_root kept_on clears abs_cb after pass")
  html::cut(doc)
}

///|
test "Wave 50B: flex row replaced item with definite height and max-width:100% preserves transferred aspect-ratio width" {
  let long_copy = test_repeat("Sequelize ORM database query transaction relation ", 8)
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div class='row'><img id='svg_img' src='logo.svg'><div class='copy'>" + long_copy + "</div></div>" +
    "<div class='row'><img id='px_img' src='logo.png'><div class='copy'>" + long_copy + "</div></div>" +
    "<div class='narrow'><img id='clamped_img' src='logo.svg'><div class='copy'>hi</div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  e.add_sheet(
    "img { max-width: 100%; height: 300px } " +
    ".row { display: flex; flex-direction: row; width: 1140px } " +
    ".narrow { display: flex; flex-direction: row; width: 200px } " +
    ".copy { margin-left: 48px }",
  )
  let root = test_unwrap(generate(doc, e))
  let body = doc.children[1].children[1]
  let svg_img = body.children[0].children[0]
  let px_img = body.children[1].children[0]
  let clamped_img = body.children[2].children[0]
  // Pure viewBox SVG sentinel (nw=-1.0, nh=104.58/90.688) and intrinsic (260x300) replaced items
  let ratio_hw = 104.58 / 90.688
  match box_of(root, svg_img) {
    Some(b) => b.kind = Kind::Replaced(-1.0, ratio_hw)
    None => panic("missing svg_img box")
  }
  match box_of(root, px_img) {
    Some(b) => b.kind = Kind::Replaced(260.0, 300.0)
    None => panic("missing px_img box")
  }
  match box_of(root, clamped_img) {
    Some(b) => b.kind = Kind::Replaced(-1.0, ratio_hw)
    None => panic("missing clamped_img box")
  }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let rs = rects(root)
  let expected_svg_w = 300.0 / ratio_hw
  match intmap::get(rs, svg_img.layout_id) {
    Some((_, _, w, h)) => {
      debug_assert((w - expected_svg_w).abs() < 1.0, "viewBox svg img width squished: got " + w.to_string() + ", expected ~" + expected_svg_w.to_string())
      debug_assert((h - 300.0).abs() < 1.0, "viewBox svg img height expected 300, got " + h.to_string())
    }
    None => panic("missing svg_img rect")
  }
  match intmap::get(rs, px_img.layout_id) {
    Some((_, _, w, h)) => {
      debug_assert((w - 260.0).abs() < 1.0, "intrinsic img width squished: got " + w.to_string())
      debug_assert((h - 300.0).abs() < 1.0, "intrinsic img height expected 300, got " + h.to_string())
    }
    None => panic("missing px_img rect")
  }
  match intmap::get(rs, clamped_img.layout_id) {
    Some((_, _, w, _)) => {
      debug_assert(w <= 200.5, "max-width:100% must still clamp in narrow container, got " + w.to_string())
    }
    None => panic("missing clamped_img rect")
  }
  html::cut(doc)
}

///|
test "Wave 59A: end_line single pass ignores trailing space for right/center/justify alignment" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='r' style='width:200px;text-align:right'><span style='display:inline-block;width:40px;height:10px'></span> </div>" +
    "<div id='c' style='width:200px;text-align:center'><span style='display:inline-block;width:40px;height:10px'></span> </div>" +
    "<div id='j' style='width:200px;text-align:justify'><span style='display:inline-block;width:40px;height:10px'></span> <span style='display:inline-block;width:40px;height:10px'></span> <span style='display:inline-block;width:150px;height:10px'></span></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_r = match box_of(root, body.children[0]) { Some(b) => b None => panic("r") }
  let b_c = match box_of(root, body.children[1]) { Some(b) => b None => panic("c") }
  let b_j = match box_of(root, body.children[2]) { Some(b) => b None => panic("j") }
  let r_span = b_r.children[0]
  let c_span = b_c.children[0]
  let j_s1 = b_j.children[0]
  let j_s2 = b_j.children[2]
  debug_assert((r_span.x + r_span.w - 200.0).abs() < 0.5, "right-aligned box flushes to 200px ignoring trailing space, got x=" + r_span.x.to_string())
  debug_assert((c_span.x - 80.0).abs() < 0.5, "center-aligned 40px box starts at 80px ignoring trailing space, got x=" + c_span.x.to_string())
  debug_assert(j_s1.x.abs() < 0.5 && (j_s2.x + j_s2.w - 200.0).abs() < 0.5, "justify stretches non-last line ignoring trailing space, got s2.x=" + j_s2.x.to_string())
  html::cut(doc)
}

///|
test "Wave 60A: flow_children ws skip & white-space:pre, flow_run_buf reentrancy & flex intrinsic wrap/gap" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='ws_norm'>   <div style='height:10px'></div>   <div style='height:10px'></div>   </div>" +
    "<div id='ws_pre' style='white-space:pre'>\n<div style='height:10px'></div></div>" +
    "<div id='reent'><span>a</span><div style='display:inline-block'><div style='height:8px'></div><span>b</span><div style='height:8px'></div></div><span>c</span><div style='height:10px'></div></div>" +
    "<div id='fx_nowrap' style='display:inline-flex;column-gap:10px'><div style='width:30px;height:10px'></div><div style='width:40px;height:10px'></div></div>" +
    "<div id='fx_wrap' style='display:inline-flex;flex-wrap:wrap;column-gap:10px;width:min-content'><div style='width:30px;height:10px'></div><div style='width:50px;height:10px'></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_wn = match box_of(root, body.children[0]) { Some(b) => b None => panic("ws_norm") }
  let b_wp = match box_of(root, body.children[1]) { Some(b) => b None => panic("ws_pre") }
  let b_re = match box_of(root, body.children[2]) { Some(b) => b None => panic("reent") }
  let b_fn = match box_of(root, body.children[3]) { Some(b) => b None => panic("fx_nowrap") }
  let b_fw = match box_of(root, body.children[4]) { Some(b) => b None => panic("fx_wrap") }
  debug_assert((b_wn.h - 20.0).abs() < 0.5, "collapsed ws between blocks produces 20px height, got " + b_wn.h.to_string())
  debug_assert(b_wp.h > 15.0, "white-space:pre preserves leading newline height > 15px, got " + b_wp.h.to_string())
  debug_assert(b_re.h >= 26.0, "reentrant flow_run_buf inline-block + trailing block lays out cleanly, got " + b_re.h.to_string())
  debug_assert((b_fn.w - 80.0).abs() < 0.5, "inline-flex nowrap with column-gap:10px width == 30+40+10 == 80, got " + b_fn.w.to_string())
  debug_assert((b_fw.w - 50.0).abs() < 0.5, "inline-flex wrap min-content width == max(30,50) == 50, got " + b_fw.w.to_string())
  html::cut(doc)
}

///|
test "Wave 61A: flow_flags bits 4/5/6 in inline (RTL left vs start, nowrap, pre, pre-wrap)" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='rtl_start' style='width:200px;direction:rtl'><span style='display:inline-block;width:40px;height:10px'></span></div>" +
    "<div id='rtl_left' style='width:200px;direction:rtl;text-align:left'><span style='display:inline-block;width:40px;height:10px'></span></div>" +
    "<div id='nw' style='width:60px;white-space:nowrap'><span style='display:inline-block;width:40px;height:10px'></span> <span style='display:inline-block;width:40px;height:10px'></span></div>" +
    "<div id='pw' style='width:60px;white-space:pre-wrap'><span style='display:inline-block;width:40px;height:10px'></span> <span style='display:inline-block;width:40px;height:10px'></span></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_rs = match box_of(root, body.children[0]) { Some(b) => b None => panic("rtl_start") }
  let b_rl = match box_of(root, body.children[1]) { Some(b) => b None => panic("rtl_left") }
  let b_nw = match box_of(root, body.children[2]) { Some(b) => b None => panic("nw") }
  let b_pw = match box_of(root, body.children[3]) { Some(b) => b None => panic("pw") }
  debug_assert((b_rs.children[0].x + b_rs.children[0].w - 200.0).abs() < 0.5, "RTL default/start aligns right at 200px")
  debug_assert(b_rl.children[0].x.abs() < 0.5, "RTL text-align:left aligns left at 0px")
  debug_assert((b_nw.children[0].y - b_nw.children[2].y).abs() < 0.5, "white-space:nowrap keeps both boxes on 1 line")
  debug_assert(b_pw.children[2].y > b_pw.children[0].y + 5.0, "white-space:pre-wrap wraps second box to next line")
  html::cut(doc)
}

///|
test "Wave 62A: flatten_text flow_flags bits 7-10 (pre-line, letter-spacing, text-transform uppercase)" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='pl' style='white-space:pre-line'>a\nb</div>" +
    "<div id='ls0' style='display:inline-block'>hello</div>" +
    "<div id='ls4' style='display:inline-block;letter-spacing:4px'>hello</div>" +
    "<div id='tt' style='text-transform:uppercase'><span>abc</span></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_pl = match box_of(root, body.children[0]) { Some(b) => b None => panic("pl") }
  let b_ls0 = match box_of(root, body.children[1]) { Some(b) => b None => panic("ls0") }
  let b_ls4 = match box_of(root, body.children[2]) { Some(b) => b None => panic("ls4") }
  let b_tt = match box_of(root, body.children[3]) { Some(b) => b None => panic("tt") }
  debug_assert(b_pl.h > 24.0, "pre-line preserves newline into 2 lines")
  debug_assert(b_ls4.w > b_ls0.w + 12.0, "letter-spacing:4px widens hello by >=12px")
  let mut saw_upper = false
  for f in b_tt.children[0].children[0].frags { if f.text == "ABC" { saw_upper = true } }
  debug_assert(saw_upper, "inherited text-transform:uppercase transforms text to ABC")
  html::cut(doc)
}

///|
test "Wave 63A: grid_abs_area fast/numeric/named+RTL, makes_bfc & holds_fixed" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='g' style='display:grid;position:relative;width:200px;height:100px;grid-template-columns:[a] 80px [b] 120px [c];grid-template-rows:40px 60px'>" +
    "<div id='a_fast' style='position:absolute;inset:0'></div>" +
    "<div id='a_num' style='position:absolute;grid-column:2/3;grid-row:1/2;inset:0'></div>" +
    "<div id='a_named' style='position:absolute;grid-column:b/c;inset:0'></div>" +
    "</div>" +
    "<div id='g_rtl' style='display:grid;position:relative;direction:rtl;width:200px;height:60px;grid-template-columns:80px 120px'>" +
    "<div id='a_rtl' style='position:absolute;grid-column:1/2;inset:0'></div>" +
    "</div>" +
    "<div id='bfc_ov' style='overflow-x:hidden'></div>" +
    "<div id='bfc_fr' style='display:flow-root'></div>" +
    "<div id='hf_tf' style='transform:translateX(1px)'></div>" +
    "<div id='hf_ct' style='contain:paint'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let g = body.children[0]
  let b_fast = match box_of(root, g.children[0]) { Some(b) => b None => panic("a_fast") }
  let b_num = match box_of(root, g.children[1]) { Some(b) => b None => panic("a_num") }
  let b_named = match box_of(root, g.children[2]) { Some(b) => b None => panic("a_named") }
  let b_rtl = match box_of(root, body.children[1].children[0]) { Some(b) => b None => panic("a_rtl") }
  let b_ov = match box_of(root, body.children[2]) { Some(b) => b None => panic("bfc_ov") }
  let b_fr = match box_of(root, body.children[3]) { Some(b) => b None => panic("bfc_fr") }
  let b_tf = match box_of(root, body.children[4]) { Some(b) => b None => panic("hf_tf") }
  let b_ct = match box_of(root, body.children[5]) { Some(b) => b None => panic("hf_ct") }
  debug_assert((b_fast.w - 200.0).abs() < 0.5 && (b_fast.h - 100.0).abs() < 0.5, "grid_abs_area fast path fills 200x100")
  debug_assert((b_num.x - 80.0).abs() < 0.5 && (b_num.w - 120.0).abs() < 0.5 && (b_num.h - 40.0).abs() < 0.5, "grid_abs_area numeric 2/3 x 1/2")
  debug_assert((b_named.x - 80.0).abs() < 0.5 && (b_named.w - 120.0).abs() < 0.5, "grid_abs_area named b/c")
  debug_assert((b_rtl.x - 120.0).abs() < 0.5 && (b_rtl.w - 80.0).abs() < 0.5, "grid_abs_area RTL column 1/2 on right")
  debug_assert(makes_bfc(b_ov) && makes_bfc(b_fr), "makes_bfc overflow-x:hidden and display:flow-root")
  debug_assert(holds_fixed(b_tf) && holds_fixed(b_ct), "holds_fixed transform and contain:paint")
  html::cut(doc)
}

///|
test "Wave 64A: run_abs_from explicit inset & flex/grid static pos (incl RTL), clamp_w/h masks & line-height flag" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='fx' style='display:flex;position:relative;width:200px;height:100px;justify-content:center;align-items:flex-end'>" +
    "<div id='a_exp' style='position:absolute;left:12px;top:14px;width:20px;height:10px'></div>" +
    "<div id='a_st' style='position:absolute;width:40px;height:20px'></div>" +
    "</div>" +
    "<div id='fx_rtl' style='display:flex;position:relative;direction:rtl;width:200px;height:60px;justify-content:flex-start'>" +
    "<div id='a_rtl' style='position:absolute;width:40px;height:20px'></div>" +
    "</div>" +
    "<div id='cl' style='width:50px;min-width:80px;max-width:120px;height:20px;min-height:40px'></div>" +
    "<div id='lh' style='line-height:36px'><span>hi</span></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_exp = match box_of(root, body.children[0].children[0]) { Some(b) => b None => panic("a_exp") }
  let b_st = match box_of(root, body.children[0].children[1]) { Some(b) => b None => panic("a_st") }
  let b_rtl = match box_of(root, body.children[1].children[0]) { Some(b) => b None => panic("a_rtl") }
  let b_cl = match box_of(root, body.children[2]) { Some(b) => b None => panic("cl") }
  let b_lh = match box_of(root, body.children[3]) { Some(b) => b None => panic("lh") }
  debug_assert((b_exp.x - 12.0).abs() < 0.5 && (b_exp.y - 14.0).abs() < 0.5, "explicit inset positions at (12, 14)")
  debug_assert((b_st.x - 80.0).abs() < 0.5 && (b_st.y - 80.0).abs() < 0.5, "flex center/flex-end static pos at (80, 80)")
  debug_assert((b_rtl.x - 160.0).abs() < 0.5, "RTL flex-start static pos at x=160")
  debug_assert((b_cl.w - 80.0).abs() < 0.5 && (b_cl.h - 40.0).abs() < 0.5, "clamp_w/clamp_h min/max masks enforce 80x40")
  debug_assert((b_lh.h - 36.0).abs() < 0.5, "inherited line-height:36px yields 36px line box")
  html::cut(doc)
}

///|
test "Wave 65A: EdgeMasks submasks, border-width thin/thick/2px, said_width px/%/kw/neg & negative margin" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;width:400px'>" +
    "<div id='pad' style='padding:10px;width:100px;box-sizing:border-box;height:40px'></div>" +
    "<div id='bdr' style='border-top:thin solid #000;border-right:thick solid #000;border-bottom:2px solid #000;border-left:solid #000;width:50%;height:30px'></div>" +
    "<div id='neg' style='margin-left:-10px;width:-20px;height:12px'></div>" +
    "<div id='kw' style='width:max-content'><span>hello</span></div>" +
    "<div id='fit' style='width:fit-content'><span>world</span></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_pad = match box_of(root, body.children[0]) { Some(b) => b None => panic("pad") }
  let b_bdr = match box_of(root, body.children[1]) { Some(b) => b None => panic("bdr") }
  let b_neg = match box_of(root, body.children[2]) { Some(b) => b None => panic("neg") }
  let b_kw = match box_of(root, body.children[3]) { Some(b) => b None => panic("kw") }
  let b_fit = match box_of(root, body.children[4]) { Some(b) => b None => panic("fit") }
  debug_assert((b_pad.w - 100.0).abs() < 0.5 && (b_pad.pl - 10.0).abs() < 0.5 && b_pad.ml == 0.0 && b_pad.bl == 0.0, "padding-only submask + border-box 100px")
  debug_assert((b_bdr.bt - 1.0).abs() < 0.5 && (b_bdr.br - 5.0).abs() < 0.5 && (b_bdr.bb - 2.0).abs() < 0.5 && (b_bdr.bl - 3.0).abs() < 0.5, "border-width thin/thick/2px/default(3px)")
  debug_assert((b_bdr.w - 208.0).abs() < 0.5, "content-box 50% of 400px + 8px hborder = 208px")
  debug_assert((b_neg.ml + 10.0).abs() < 0.5 && (b_neg.w - 410.0).abs() < 0.5, "negative margin-left:-10px preserved and negative width:-20px ignored")
  debug_assert(b_kw.w > 0.0 && b_kw.w < 400.0 && b_fit.w > 0.0 && b_fit.w < 400.0, "max-content and fit-content shrink-wrap")
  html::cut(doc)
}

///|
test "Wave 57B: CSS Text Level 4 text-wrap:nowrap prevents wrapping inside flex/inline-flex buttons" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;width:120px'>" +
    "<a id='tw' style='display:inline-flex;text-wrap:nowrap;font-size:14px;line-height:20px'><span>Start free trial</span></a>" +
    "<a id='twm' style='display:inline-flex;text-wrap-mode:nowrap;font-size:14px;line-height:20px'><span>Contact sales</span></a>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_tw = match box_of(root, body.children[0].children[0]) { Some(b) => b None => panic("tw") }
  let b_twm = match box_of(root, body.children[0].children[1]) { Some(b) => b None => panic("twm") }
  debug_assert(b_tw.h <= 26.0, "text-wrap:nowrap must keep button single-line (<=26px), got h=" + b_tw.h.to_string())
  debug_assert(b_twm.h <= 26.0, "text-wrap-mode:nowrap must keep button single-line (<=26px), got h=" + b_twm.h.to_string())
  html::cut(doc)
}

///|
test "Wave 59B: grid-auto-flow:column intrinsic width counts non-whitespace direct text children" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<header style='display:flex;justify-content:space-between;width:1000px'>" +
    "<nav id='nav' style='display:grid;grid-auto-flow:column;gap:16px'>" +
    "<div style='display:grid'><button id='b1' style='display:grid;grid-auto-flow:column;gap:4px'>Products<span style='width:8px;height:8px'></span></button></div>" +
    "<div style='display:grid'><button id='b2' style='display:grid;grid-auto-flow:column;gap:4px'>Solutions<span style='width:8px;height:8px'></span></button></div>" +
    "<div style='display:grid'><button id='b3' style='display:grid;grid-auto-flow:column;gap:4px'>Why Twilio<span style='width:8px;height:8px'></span></button></div>" +
    "</nav></header></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1000.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1000.0, 600.0, 0.0)
  let nav = doc.children[1].children[1].children[0].children[0]
  let b_nav = match box_of(root, nav) { Some(b) => b None => panic("nav") }
  let b1 = match box_of(root, nav.children[0]) { Some(b) => b None => panic("b1") }
  let b2 = match box_of(root, nav.children[1]) { Some(b) => b None => panic("b2") }
  debug_assert(b_nav.w > 180.0, "grid-auto-flow:column nav must include direct text widths (>180px), got w=" + b_nav.w.to_string())
  debug_assert(b2.x >= b1.x + b1.w + 15.0, "second nav column must not overlap first column: b1=(" + b1.x.to_string() + "+" + b1.w.to_string() + ") b2.x=" + b2.x.to_string())
  html::cut(doc)
}

///|
test "Wave 66A: rem/em fast path, flex zero-closure & basis/order, grid default/named-lines/areas" {
  let doc = html::parse(
    "<!doctype html><html style='font-size:20px'><body style='margin:0;width:400px'>" +
    "<div id='rm' style='font-size:12px;width:2rem;height:3em;margin-left:-1.5rem'></div>" +
    "<div id='negw' style='width:-1rem;height:10px'></div>" +
    "<div id='fx' style='display:flex;width:200px'>" +
    "<div id='f1' style='order:2;flex:0 0 2rem;height:20px'></div>" +
    "<div id='f2' style='order:1;flex:0 0 50%;height:20px'></div>" +
    "</div>" +
    "<div id='gr' style='display:grid;width:200px;grid-template-columns:[c1] 100px [c2] 100px [c3];grid-template-areas:\"a b\"'>" +
    "<div id='g1' style='grid-area:b;height:20px'></div>" +
    "<div id='g2' style='grid-column:c1 / c2;height:20px'></div>" +
    "</div>" +
    "<div id='gr_def' style='display:grid;width:200px;grid-template-columns:100px 100px'>" +
    "<div id='gd1' style='height:15px'></div><div id='gd2' style='height:15px'></div>" +
    "</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_rm = match box_of(root, body.children[0]) { Some(b) => b None => panic("rm") }
  let b_negw = match box_of(root, body.children[1]) { Some(b) => b None => panic("negw") }
  let b_f1 = match box_of(root, body.children[2].children[0]) { Some(b) => b None => panic("f1") }
  let b_f2 = match box_of(root, body.children[2].children[1]) { Some(b) => b None => panic("f2") }
  let b_g1 = match box_of(root, body.children[3].children[0]) { Some(b) => b None => panic("g1") }
  let b_g2 = match box_of(root, body.children[3].children[1]) { Some(b) => b None => panic("g2") }
  let b_gd1 = match box_of(root, body.children[4].children[0]) { Some(b) => b None => panic("gd1") }
  let b_gd2 = match box_of(root, body.children[4].children[1]) { Some(b) => b None => panic("gd2") }
  debug_assert((b_rm.w - 40.0).abs() < 0.5 && (b_rm.h - 36.0).abs() < 0.5 && (b_rm.ml + 30.0).abs() < 0.5, "2rem=40px, 3em=36px, -1.5rem=-30px")
  debug_assert((b_negw.w - 400.0).abs() < 0.5, "negative width:-1rem rejected -> fills 400px")
  debug_assert((b_f2.x - 0.0).abs() < 0.5 && (b_f2.w - 100.0).abs() < 0.5 && (b_f1.x - 100.0).abs() < 0.5 && (b_f1.w - 40.0).abs() < 0.5, "flex order + 50% / 2rem basis")
  debug_assert((b_g1.x - 100.0).abs() < 0.5 && (b_g2.x - 0.0).abs() < 0.5, "grid-area b at col 2 and named line c1/c2 at col 1")
  debug_assert((b_gd1.x - 0.0).abs() < 0.5 && (b_gd2.x - 100.0).abs() < 0.5, "default grid flow places items at col 1 and col 2")
  html::cut(doc)
}

///|
test "Wave 69A: Box children with_capacity keeps no_children unpolluted, zero-closure counter_text & line_clamp" {
  debug_assert(counter_text(1, "lower-alpha") == "a", "counter_text lower-alpha 1")
  debug_assert(counter_text(27, "upper-alpha") == "AA", "counter_text upper-alpha 27")
  debug_assert(counter_text(42, "lower-roman") == "xlii", "counter_text lower-roman 42")
  debug_assert(counter_text(1999, "upper-roman") == "MCMXCIX", "counter_text upper-roman 1999")
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='empty'></div>" +
    "<div id='multi'><span>1</span><span>2</span><span>3</span><span>4</span></div>" +
    "<div id='clamp' style='display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;width:60px'>one two three four five six seven eight</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_empty = match box_of(root, body.children[0]) { Some(b) => b None => panic("empty") }
  let b_multi = match box_of(root, body.children[1]) { Some(b) => b None => panic("multi") }
  let b_clamp = match box_of(root, body.children[2]) { Some(b) => b None => panic("clamp") }
  debug_assert(b_empty.children.length() == 0 && no_children.length() == 0, "empty container shares unpolluted no_children")
  debug_assert(b_multi.children.length() == 4, "multi-child container with_capacity preserves all 4 children")
  debug_assert(line_clamp(b_clamp.style) == 2 && line_clamp(b_empty.style) == 0, "zero-closure line_clamp matches -webkit-line-clamp:2")
  html::cut(doc)
}

///|
test "Wave 70A: flatten_text ASCII whitespace skip, ASCII word tight loop, hyphen & CJK mixed wrapping" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='ws1' style='width:200px'>   \n\t  <span>   </span>hello   \n  world   </div>" +
    "<div id='ws2' style='width:200px'>hello world</div>" +
    "<div id='pre' style='white-space:pre;width:200px'>   \n   </div>" +
    "<div id='mix' style='width:90px'>alpha-beta gamma 你好世界</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_ws1 = match box_of(root, body.children[0]) { Some(b) => b None => panic("ws1") }
  let b_ws2 = match box_of(root, body.children[1]) { Some(b) => b None => panic("ws2") }
  let b_pre = match box_of(root, body.children[2]) { Some(b) => b None => panic("pre") }
  let b_mix = match box_of(root, body.children[3]) { Some(b) => b None => panic("mix") }
  debug_assert((b_ws1.h - b_ws2.h).abs() < 0.01, "collapsed leading/consecutive ASCII whitespace matches 'hello world'")
  debug_assert(b_pre.h > b_ws2.h * 1.5, "white-space:pre preserves newline height")
  debug_assert(b_mix.h > b_ws2.h * 1.5, "mixed ASCII + hyphen + CJK wraps cleanly onto multiple lines")
  html::cut(doc)
}

///|
test "Wave 71A: str_is_printable_ascii, Fonts::covers_printable_ascii & end_line ASCII vs CJK fallback line height" {
  debug_assert(str_is_printable_ascii("Hello, World! 0123456789 ~"), "printable ASCII returns true")
  debug_assert(!str_is_printable_ascii("hello\nworld"), "control char returns false")
  debug_assert(!str_is_printable_ascii("hello 世界"), "CJK UTF-8 returns false")
  let fonts = Fonts::new_portable([], [])
  debug_assert(fonts.covers_printable_ascii(SYNTHETIC), "SYNTHETIC font covers printable ASCII")
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;font-size:16px;line-height:normal'>" +
    "<div id='asc' style='width:300px'>The quick brown fox jumps over the lazy dog</div>" +
    "<div id='cjk' style='width:300px'>Hello 你好世界</div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let b_asc = match box_of(root, body.children[0]) { Some(b) => b None => panic("asc") }
  let b_cjk = match box_of(root, body.children[1]) { Some(b) => b None => panic("cjk") }
  debug_assert(b_asc.h > 10.0 && b_cjk.h > 10.0, "both ASCII fast-path and CJK fallback lines compute positive line height")
  html::cut(doc)
}

///|
test "Wave 61B: flex-stretched button vertically centers inline child content" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;height:72px'>" +
    "<button style='border:0;padding:0;line-height:1;font-size:16px'>" +
    "<span style='padding:12px 15px'>Resources</span>" +
    "</button></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let body = doc.children[1].children[1]
  let flex_div = body.children[0]
  let btn_node = flex_div.children[0]
  let span_node = btn_node.children[0]
  let b_btn = match box_of(root, btn_node) { Some(b) => b None => panic("button box") }
  let b_span = match box_of(root, span_node) { Some(b) => b None => panic("span box") }
  let span_cy = (b_span.min_y + b_span.max_y) * 0.5
  let btn_cy = b_btn.y + b_btn.h * 0.5
  debug_assert((b_btn.h - 72.0).abs() < 0.5, "stretched button should be 72px tall, got " + b_btn.h.to_string())
  debug_assert((span_cy - btn_cy).abs() < 4.0, "button inline child should be vertically centered: span_cy=" + span_cy.to_string() + " btn_cy=" + btn_cy.to_string())
  debug_assert(b_span.min_y >= b_btn.y, "button inline child must not overflow above button top: min_y=" + b_span.min_y.to_string() + " btn_y=" + b_btn.y.to_string())
  match b_btn.baseline {
    Some(fb) => debug_assert(fb > 25.0, "button baseline should be shifted with centered child, got " + fb.to_string())
    None => ()
  }
  html::cut(doc)
}

///|
test "Wave 72A: fs_int_key exact 1/16px integer key & layout::client_sizes cache equivalence" {
  debug_assert(fs_int_key(3, 16.0) == ((3 << 16) | 256), "fs_int_key exact 16.0px")
  debug_assert(fs_int_key(3, 14.5) == ((3 << 16) | 232), "fs_int_key exact 14.5px")
  debug_assert(fs_int_key(3, 14.333) == -1, "fs_int_key non-1/16px falls back to -1")
  debug_assert(fs_int_key(-1, 16.0) == -1 && fs_int_key(1, 5000.0) == -1, "fs_int_key out-of-range falls back to -1")
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='b1' style='width:120px;height:40px;border:5px solid black;padding:4px'></div>" +
    "<div id='b2' style='width:80px;height:20px'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let cs = client_sizes(root)
  let body = doc.children[1].children[1]
  match intmap::get(cs, body.children[0].layout_id) {
    Some((cw, ch)) => debug_assert((cw - 128.0).abs() < 0.5 && (ch - 48.0).abs() < 0.5, "client_sizes includes padding and excludes border, got " + cw.to_string() + "x" + ch.to_string())
    None => panic("missing b1 client_sizes")
  }
  match intmap::get(cs, body.children[1].layout_id) {
    Some((cw, ch)) => debug_assert((cw - 80.0).abs() < 0.5 && (ch - 20.0).abs() < 0.5, "b2 client_sizes 80x20")
    None => panic("missing b2 client_sizes")
  }
  html::cut(doc)
}

///|
test "Wave 74A: Fonts::shaped cache deduplicates shaping across font sizes and glyph_ops" {
  let fonts = Fonts::new()
  let before = font_globals.shape_count
  let ops1 = fonts.glyph_ops(0, 14.0, "Wave74AWordé")
  let after1 = font_globals.shape_count
  let ops2 = fonts.glyph_ops(0, 28.0, "Wave74AWordé")
  let after2 = font_globals.shape_count
  debug_assert(after1 >= before + 1, "first non-ASCII glyph_ops call shapes at least once, got delta=" + (after1 - before).to_string())
  debug_assert(after2 == after1, "different font size glyph_ops reuses Fonts::shaped cache without re-shaping")
  debug_assert(ops1.length() > 0 && ops2.length() == ops1.length(), "cached shaping produces matching glyph_ops runs")
}

///|
test "Wave 81A: pure-ASCII width_cached and glyph_ops skip Fonts::shaped and match bit-for-bit" {
  let fonts = Fonts::new()
  let s = "AVATAR To We 0123456789 hello-world!"
  let l0 = fonts.loaded(0)
  // Populate ascii_full=true on face 0 so the pure-ASCII fast path executes even with FontBackend::none().
  fonts.ascii_full.set(0, true)
  let before = font_globals.shape_count
  let w_fast = fonts.width(0, 16.0, s)
  let ops_fast = fonts.glyph_ops(0, 16.0, s)
  let after = font_globals.shape_count
  if l0.no_ot_layout {
    debug_assert(after == before, "pure-ASCII width & glyph_ops skip shaped(), got delta=" + (after - before).to_string())
  }
  let gs = fonts.shaped(0, s)
  let mut w_ref_i = 0
  let mut i = 0
  while i < gs.length() {
    w_ref_i += gs[i].x_advance
    i += 1
  }
  let sz = 16.0 * fonts.scale(0)
  let k = sz / l0.per_em
  let tr = tracking(fonts.track(0, l0), sz)
  let w_ref = (w_ref_i.to_double() + tr * gs.length().to_double()) / l0.per_em * sz
  debug_assert(w_fast == w_ref, "width_cached pure-ASCII fast path matches shaped() bit-for-bit")
  debug_assert(ops_fast.length() == 1, "single run for pure-ASCII glyph_ops")
  let (rf, gids, xs) = ops_fast[0]
  debug_assert(rf == 0 && gids.length() == gs.length() && xs.length() == gs.length(), "glyph_ops run length matches shaped()")
  let mut x_ref = 0.0
  i = 0
  while i < gs.length() {
    debug_assert(gids[i] == gs[i].gid, "gid matches at index " + i.to_string())
    debug_assert(xs[i] == x_ref + gs[i].x_offset.to_double() * k, "x matches bit-for-bit at index " + i.to_string())
    x_ref += (gs[i].x_advance.to_double() + tr) * k
    i += 1
  }
}

///|
test "Wave 75A: direct ASCII shaping matches shape_text_var & intern_inline_word exactness" {
  let fonts = Fonts::new()
  let s = "AVATAR the quick brown fox"
  let gs = fonts.shaped(0, s)
  debug_assert(gs.length() == s.length(), "direct ASCII shaping produces 1 glyph per ASCII char")
  let l = fonts.loaded(0)
  let ref_gs = shape_text_var(l.face, l.var_coords, s)
  if l.no_ot_layout && l.apple_kern.is_empty() {
    let mut i = 0
    while i < gs.length() {
      debug_assert(gs[i].gid == ref_gs[i].gid && gs[i].x_advance == ref_gs[i].x_advance, "direct ASCII shaping matches shape_text_var at " + i.to_string())
      i += 1
    }
  }
  debug_assert(intern_inline_word("x the y", 2, 5) == "the", "intern_inline_word 3-char hit")
  debug_assert(intern_inline_word("x with y", 2, 6) == "with", "intern_inline_word 4-char hit")
  debug_assert(intern_inline_word("x of y", 2, 4) == "of", "intern_inline_word 2-char hit")
  debug_assert(intern_inline_word("x zebra y", 2, 7) == "zebra", "intern_inline_word miss slices cleanly")
}

///|
test "Wave 62B: block-level viewBox-only <svg> with auto width/height fills containing block width and preserves aspect ratio" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:138px'><svg style='display:block' viewBox='0 0 512 120'></svg></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let svg_node = body.children[0].children[0]
  let b_svg = match box_of(root, svg_node) { Some(b) => b None => panic("svg box") }
  let expected_h = 138.0 * 120.0 / 512.0
  debug_assert((b_svg.w - 138.0).abs() < 0.5, "viewBox-only block svg should fill 138px parent, got " + b_svg.w.to_string())
  debug_assert((b_svg.h - expected_h).abs() < 0.5, "viewBox-only block svg height should match ratio, got " + b_svg.h.to_string())
  html::cut(doc)
}

///|
test "Wave 63B: grid-template-rows: 0fr collapses overflow:hidden child to 0px" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='g' style='display:grid;grid-template-rows:0fr'><div id='c' style='overflow:hidden'><div style='height:200px'></div></div></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let g_node = body.children[0]
  let c_node = g_node.children[0]
  let b_g = match box_of(root, g_node) { Some(b) => b None => panic("grid box") }
  let b_c = match box_of(root, c_node) { Some(b) => b None => panic("child box") }
  debug_assert(b_g.h.abs() < 0.5, "0fr grid container should collapse to 0px, got " + b_g.h.to_string())
  debug_assert(b_c.h.abs() < 0.5, "0fr overflow:hidden child should collapse to 0px, got " + b_c.h.to_string())
  html::cut(doc)
}

///|
test "Wave 67B: CSS Grid 2 grid-template-columns: subgrid inherits parent column track sizes and gap" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;grid-template-columns:repeat(12,1fr);column-gap:12px;width:1200px'>" +
    "<div id='sub' style='display:grid;grid-column:1/-1;grid-template-columns:subgrid'>" +
    "<div id='item' style='grid-column:1/span 4;height:40px'></div>" +
    "</div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let item_node = body.children[0].children[0].children[0]
  let b_item = match box_of(root, item_node) { Some(b) => b None => panic("item box") }
  // 12 cols in 1200px with 11*12=132px gaps => each col = (1200-132)/12 = 89px; span 4 = 4*89 + 3*12 = 392px
  debug_assert((b_item.w - 392.0).abs() < 1.0, "subgrid span 4 item must be ~392px wide, got " + b_item.w.to_string())
  html::cut(doc)
}

///|
test "Wave 1C: CSS Grid definite-height 1fr row respects scroll-container/min-height:0 automatic minimum size" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0;height:800px;display:grid;grid-template-rows:64px 38px 1fr 32px'>" +
    "<div id='menu'></div>" +
    "<div id='toolbar'></div>" +
    "<div id='diagram' style='overflow:auto;min-height:0'><div style='height:5000px'></div></div>" +
    "<div id='tabs'></div>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let diag_node = body.children[2]
  let tabs_node = body.children[3]
  let b_diag = match box_of(root, diag_node) { Some(b) => b None => panic("diagram box") }
  let b_tabs = match box_of(root, tabs_node) { Some(b) => b None => panic("tabs box") }
  // 800 - 64 - 38 - 32 = 666px; tabs at y = 768px
  debug_assert((b_diag.h - 666.0).abs() < 1.0, "1fr scroll container must be ~666px tall, got " + b_diag.h.to_string())
  debug_assert((b_tabs.y - 768.0).abs() < 1.0, "footer row must stay at y=768px, got " + b_tabs.y.to_string())
  html::cut(doc)
}

///|
test "Wave 71B: CSS Sizing 3 min-width: max-content prevents flex item and parent flex wrapper from shrinking/wrapping" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<ul id='nav' style='display:flex;overflow-x:auto;width:300px;margin:0;padding:0;list-style:none'>" +
    "<li style='display:flex;flex:0 0 auto'><a style='white-space:nowrap;padding:4px 8px'>Accessibility</a></li>" +
    "<li style='display:flex;flex:0 0 auto'><a style='white-space:nowrap;padding:4px 8px'>JavaScript</a></li>" +
    "<li style='display:flex;flex:0 0 auto'><a style='white-space:nowrap;padding:4px 8px'>Performance</a></li>" +
    "<li id='more' style='display:flex'><a id='btn' style='display:flex;min-width:max-content;padding:4px 8px'>Jump to all articles</a></li>" +
    "</ul></body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let body = doc.children[1].children[1]
  let ul = body.children[0]
  let more_li = ul.children[3]
  let btn_a = more_li.children[0]
  let b_ul = match box_of(root, ul) { Some(b) => b None => panic("ul box") }
  let b_more = match box_of(root, more_li) { Some(b) => b None => panic("more li box") }
  let b_btn = match box_of(root, btn_a) { Some(b) => b None => panic("btn a box") }
  // Without min-width:max-content in intrinsic/flex, #more shrinks to ~50px and wraps into 4 lines (~80px tall).
  // With min-width:max-content, #more stays single-line (< 40px tall) and >= 120px wide.
  debug_assert(b_more.w >= 120.0, "min-width:max-content child must keep parent flex item >= 120px wide, got " + b_more.w.to_string())
  debug_assert(b_btn.w >= 120.0, "min-width:max-content anchor must stay >= 120px wide, got " + b_btn.w.to_string())
  debug_assert(b_ul.h < 45.0, "flex nav must stay single-line (< 45px tall), got " + b_ul.h.to_string())
  html::cut(doc)
}

///|
test "Wave 75B: CSS Grid 1 §8.3 grid-column-start / grid-column-end spanning across distinct named template areas" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;grid-template-columns:repeat(12,72px);column-gap:32px;grid-template-areas:\"one two three four five six seven eight nine ten eleven twelve\"'>" +
    "<div id='hero' style='grid-column-start:three;grid-column-end:ten;height:40px'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let hero = body.children[0].children[0]
  let b_hero = match box_of(root, hero) { Some(b) => b None => panic("hero box") }
  // Columns 3..10 (8 columns) => x = 2*(72+32) = 208px, w = 8*72 + 7*32 = 800px
  debug_assert((b_hero.x - 208.0).abs() < 1.0, "hero must start at column 'three' (x=208), got " + b_hero.x.to_string())
  debug_assert((b_hero.w - 800.0).abs() < 1.0, "hero must span from 'three' to 'ten' (w=800), got " + b_hero.w.to_string())
  html::cut(doc)
}

///|
test "Wave 79B: CSS Grid 1 §11.5 multi-row spanning item sizes auto rows so subsequent rows do not overlap" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;height:600px;gap:8px;grid-template:\"top-banner top-banner\"\"global-nav global-nav\"\"sidebar main\"1fr/200px 1fr'>" +
    "<div id='nav' style='grid-area:top-banner/1/global-nav/-1;height:64px'></div>" +
    "<div id='side' style='grid-area:sidebar'></div>" +
    "<div id='main' style='grid-area:main'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let grid = body.children[0]
  let b_nav = match box_of(root, grid.children[0]) { Some(b) => b None => panic("nav box") }
  let b_main = match box_of(root, grid.children[2]) { Some(b) => b None => panic("main box") }
  // nav spans rows 0..2 with height 64px; row 2 (main) must start at y >= 64 + 8 = 72px (not overlapping nav!)
  debug_assert(b_main.y >= b_nav.y + b_nav.h + 7.5, "row 2 (main) must start below multi-row spanning nav (y>=72), got main.y=" + b_main.y.to_string() + " nav.y+h=" + (b_nav.y + b_nav.h).to_string())
  html::cut(doc)
}

///|
test "Wave 80B: CSS Positioned Layout §4.1 position:fixed inset:0 gives definite height for relative child top:50%" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='position:fixed;inset:0'>" +
    "<div id='dlg' style='position:relative;top:50%;left:50%;width:400px;height:200px'></div>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let dlg = body.children[0].children[0]
  let b_dlg = match box_of(root, dlg) { Some(b) => b None => panic("dlg box") }
  // fixed inset:0 has definite height 800px -> top:50% on relative child must offset y to 400px!
  debug_assert((b_dlg.y - 400.0).abs() < 1.0, "relative child top:50% inside fixed inset:0 must be y=400, got " + b_dlg.y.to_string())
  debug_assert((b_dlg.x - 640.0).abs() < 1.0, "relative child left:50% inside fixed inset:0 must be x=640, got " + b_dlg.x.to_string())
  html::cut(doc)
}

///|
test "Wave 82B: CSS 2.1 §10.1 positioned Inline element establishes containing block for absolute descendants" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='margin-left:300px;margin-top:40px'>" +
    "<a id='lnk' style='position:relative'>RT App<span id='badge' style='position:absolute;top:-20px;right:-15px;width:30px;height:14px'>NEW</span></a>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let lnk = body.children[0].children[0]
  let badge = lnk.children[1]
  let (lx, ly, lw, _) = match rect_of(root, lnk) { Some(r) => r None => panic("lnk rect") }
  let b_badge = match box_of(root, badge) { Some(b) => b None => panic("badge box") }
  // Badge right edge should be at lx + lw + 15px (NOT at viewport right edge 1280 + 15!)
  let expected_x = lx + lw + 15.0 - 30.0
  let expected_y = ly - 20.0
  debug_assert((b_badge.x - expected_x).abs() < 2.0, "badge must anchor to inline link (x~" + expected_x.to_string() + "), got x=" + b_badge.x.to_string())
  debug_assert((b_badge.y - expected_y).abs() < 2.0, "badge must anchor vertically to inline link (y~" + expected_y.to_string() + "), got y=" + b_badge.y.to_string())
  html::cut(doc)
}

///|
test "Wave 6C: CSS Grid 1 §6.6 stretched block grid item propagates definite height to height:100% children" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;height:600px;grid-template-columns:1fr 1fr;grid-template-rows:1fr'>" +
    "<div id='pane' style='display:block'>" +
    "<div id='inner' style='display:grid;height:100%;grid-template-rows:1fr 1px 1fr'>" +
    "<div id='top'>top</div><div id='g'></div><div id='bot'>bot</div>" +
    "</div></div></div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let pane = body.children[0].children[0]
  let inner = pane.children[0]
  let b_pane = match box_of(root, pane) { Some(b) => b None => panic("pane") }
  let b_inner = match box_of(root, inner) { Some(b) => b None => panic("inner") }
  let b_top = match box_of(root, inner.children[0]) { Some(b) => b None => panic("top") }
  let b_bot = match box_of(root, inner.children[2]) { Some(b) => b None => panic("bot") }
  debug_assert((b_pane.h - 600.0).abs() < 1.0, "stretched block grid item must be 600px, got " + b_pane.h.to_string())
  debug_assert((b_inner.h - 600.0).abs() < 1.0, "height:100% child inside stretched block grid item must be 600px, got " + b_inner.h.to_string())
  debug_assert((b_top.h - 299.5).abs() < 1.5 && (b_bot.h - 299.5).abs() < 1.5, "nested 1fr 1px 1fr panes must split 600px, got top=" + b_top.h.to_string() + " bot=" + b_bot.h.to_string())
  html::cut(doc)
}

///|
test "Wave 6C: CSS Grid 1 §11.5 multi-row spanning item over fr track does not inflate sibling auto header row" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;height:700px;grid-template-columns:250px 1fr;grid-template-rows:auto 1fr;grid-template-areas:\"side head\" \"side main\"'>" +
    "<aside style='grid-area:side'><div style='height:2000px'></div></aside>" +
    "<header style='grid-area:head;height:60px'></header>" +
    "<main style='grid-area:main'></main>" +
    "</div></body></html>",
  )
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let grid = body.children[0]
  let b_head = match box_of(root, grid.children[1]) { Some(b) => b None => panic("head") }
  let b_main = match box_of(root, grid.children[2]) { Some(b) => b None => panic("main") }
  debug_assert((b_head.h - 60.0).abs() < 1.0, "header row must stay 60px, got " + b_head.h.to_string())
  debug_assert((b_main.y - 60.0).abs() < 1.0, "main row must start at y=60px (not inflated by spanning sidebar), got " + b_main.y.to_string())
  html::cut(doc)
}

///|
test "Wave 8C: CSS Grid non-stretched item (justify-self:center) honors min-width:100% against grid area width" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:grid;width:630px;justify-items:center'>" +
    "<section id='ed' style='display:grid;justify-self:center;min-width:100%;grid-template-columns:1fr 1fr 1fr'>" +
