///| Layout unit tests: block/inline/flex/grid/table/positioned/sticky/vertical/RTL/hyphenation + Reuse incremental == full.

import "html"
import "css"
import "intmap"

fn assert(ok : Bool) -> Unit {
  if !ok { panic("assertion failed") }
}

fn test_unwrap(o : Option[Box]) -> Box {
  match o {
    Some(b) => b
    None => panic("expected Box")
  }
}

fn test_repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  for _ in 0..<n { sb.write_string(s) }
  sb.to_string()
}

fn rects_equal(a : intmap::IntMap[(Double, Double, Double, Double)], b : intmap::IntMap[(Double, Double, Double, Double)]) -> Bool {
  if a.len() != b.len() { return false }
  for k in a.keys() {
    match (intmap::get(a, k), intmap::get(b, k)) {
      (Some((x1, y1, w1, h1)), Some((x2, y2, w2, h2))) =>
      if (x1 - x2).abs() > 0.001 || (y1 - y2).abs() > 0.001 ||
      (w1 - w2).abs() > 0.001 || (h1 - h2).abs() > 0.001 {
        return false
      }
      _ => return false
    }
  }
  true
}

test "block and flex basic layout" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=row><div class=a></div><div class=b></div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine.add_sheet("body { margin: 0 } .row { display: flex; width: 300px } .a { width: 100px; height: 40px } .b { flex: 1; height: 60px }")
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let rs = rects(root)
  let row = doc.children[1].children[1].children[0]
  let a = row.children[0]
  let b = row.children[1]
  match intmap::get(rs, a.layout_id) {
    Some((x, y, w, h)) => assert(x == 0.0 && y == 0.0 && w == 100.0 && h == 40.0)
    None => panic("missing a")
  }
  match intmap::get(rs, b.layout_id) {
    Some((x, y, w, h)) => assert(x == 100.0 && y == 0.0 && w == 200.0 && h == 60.0)
    None => panic("missing b")
  }
  assert(page_height(root) == 60.0)
}

test "grid and table basic layout" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=g><div class=c1></div><div class=c2></div></div><table><tr><td>A</td><td>B</td></tr></table></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine.add_sheet("body { margin: 0 } .g { display: grid; grid-template-columns: 100px 1fr; width: 300px; gap: 10px } .c1, .c2 { height: 25px } table { width: 200px; border-collapse: collapse } td { padding: 4px }")
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 400.0, 300.0, 0.0)
  let rs = rects(root)
  let g = doc.children[1].children[1].children[0]
  let c1 = g.children[0]
  let c2 = g.children[1]
  match intmap::get(rs, c1.layout_id) {
    Some((x, y, w, h)) => assert(x == 0.0 && y == 0.0 && w == 100.0 && h == 25.0)
    None => panic("missing c1")
  }
  match intmap::get(rs, c2.layout_id) {
    Some((x, y, w, h)) => assert(x == 110.0 && y == 0.0 && w == 190.0 && h == 25.0)
    None => panic("missing c2")
  }
}

test "hyphenation points on English words" {
  let pts = hyphen_points("hyphenation")
  assert(pts.length() >= 2)
}

test "Reuse incremental relayout matches full layout with 0 diff" {
  let html_str = "<!doctype html><html><body><div class=view><div class=nums>" +
  test_repeat("<div class=n>1</div>", 40) +
  "</div><div class=lines>" +
  test_repeat("<div class=line><span class=k>let</span> x = 1</div>", 40) +
  "<div class=extra>more</div></div></div></body></html>"
  let sheet = "body { margin: 0 } .view { display: flex } .nums { width: 40px } .lines { flex: 1 } .line { padding: 2px } .extra { height: 120px } .hi { padding: 8px }"
  let doc = html::parse(html_str)
  let engine = css::Engine::new(css::Env::{ width: 412.0, height: 900.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let reuse = Reuse::new()
  let r0 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout(r0, fonts, 412.0, 900.0)
  // Mutate a line in the middle and do incremental relayout
  let target = doc.children[1].children[1].children[0].children[1].children[20]
  engine.forget(target, false, Some(("class", "line hi")), None, false)
  target.attrs[0].value = "line hi"
  reuse.changed(target)
  let r_inc = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  let taken = reuse.taken_count()
  reuse.fresh()
  layout(r_inc, fonts, 412.0, 900.0)
  let inc_rects = rects(r_inc)
  let inc_h = page_height(r_inc)
  // Compare with fresh full layout
  let engine_full = css::Engine::new(css::Env::{ width: 412.0, height: 900.0, media: "screen", dpr: 1.0 })
  engine_full.add_sheet(sheet)
  let r_full = test_unwrap(generate(doc, engine_full))
  layout(r_full, fonts, 412.0, 900.0)
  let full_rects = rects(r_full)
  let full_h = page_height(r_full)
  assert(taken > 0)
  assert((inc_h - full_h).abs() < 0.001)
  assert(rects_equal(inc_rects, full_rects))
}

test "grid min-content tracks preserve nowrap min-width pill width and minmax(0,1fr) does not blow up outer grid" {
  let html_str = "<!doctype html><html><body>" +
  "<div class=ctas><a id=b1 class=btn>Learn more</a><a id=b2 class=btn>Shop iPhone</a></div>" +
  "<div class=outer><div class=inner><div class=wide></div></div></div>" +
  "</body></html>"
  let sheet = "body { margin: 0 } " +
  ".ctas { display: grid; grid-template-columns: min-content min-content; column-gap: 17px } " +
  ".btn { display: inline-block; min-width: 26px; padding: 0 21px; border: 1px solid #000; white-space: nowrap; font-size: 17px } " +
  ".outer { display: grid; width: 600px } " +
  ".inner { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)) } " +
  ".wide { width: 2000px; height: 20px }"
  let doc = html::parse(html_str)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout(root, fonts, 800.0, 600.0)
  let rs = rects(root)
  let body = doc.children[1].children[1]
  let b1 = body.children[0].children[0]
  let b2 = body.children[0].children[1]
  let inner = body.children[1].children[0]
  match intmap::get(rs, b1.layout_id) {
    Some((_, _, w, _)) => if !(w > 95.0) { panic("b1 w=" + w.to_string()) }
    None => panic("missing b1")
  }
  match intmap::get(rs, b2.layout_id) {
    Some((_, _, w, _)) => if !(w > 100.0) { panic("b2 w=" + w.to_string()) }
    None => panic("missing b2")
  }
  match intmap::get(rs, inner.layout_id) {
    Some((_, _, w, _)) => if !((w - 600.0).abs() < 1.0) { panic("inner w=" + w.to_string()) }
    None => panic("missing inner")
  }
}

test "closed inline-block details hides non-summary intrinsic width and keeps baseline aligned" {
  let html_str = "<!doctype html><html><body><div class=byline><span>via user | </span><details class=caches><summary>caches</summary><ul><li><a href='#'>Very Long Archive Link That Must Stay Hidden</a></li></ul></details><span> | 1 comment</span></div></body></html>"
  let sheet = "body { margin: 0; font-size: 14px; line-height: 20px } .caches { display: inline-block }"
  let doc = html::parse(html_str)
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout(root, fonts, 800.0, 600.0)
  let rs = rects(root)
  let body = doc.children[1].children[1]
  let byline = body.children[0]
  let details = byline.children[1]
  match intmap::get(rs, details.layout_id) {
    Some((_, _, w, h)) => {
      assert(w < 120.0)
      assert(h <= 25.0)
    }
    None => panic("missing details")
  }
  match intmap::get(rs, byline.layout_id) {
    Some((_, _, _, h)) => assert(h <= 25.0)
    None => panic("missing byline")
  }
}

test "grid minmax(0,1.02fr)minmax(0,1fr) without space splits into 2 columns and cqw font-size resolves" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=hero><div class=left><h1 class=title>Bun</h1></div><div class=right>Card</div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body { margin: 0 } .hero { display: grid; width: 1000px; grid-template-columns: minmax(0,1.02fr)minmax(0,1fr); column-gap: 40px } .title { font-size: min(14.2cqw, 6rem); margin: 0 }",
  )
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let rs = rects(root)
  let hero = doc.children[1].children[1].children[0]
  let left = hero.children[0]
  let right = hero.children[1]
  match (intmap::get(rs, left.layout_id), intmap::get(rs, right.layout_id)) {
    (Some((lx, ly, lw, _)), Some((rx, ry, rw, _))) => {
      assert(lx == 0.0 && ly == 0.0 && ry == 0.0)
      assert(rx > lw + 35.0 && rw > 450.0)
    }
    _ => panic("missing left/right grid columns")
  }
  let h1 = left.children[0]
  match engine.style_of(h1, None) {
    Some(h1_st) => assert(h1_st.font_size > 60.0)
    None => panic("missing h1 style")
  }
}

test "cqw font-size resolves against ancestor container-type inline-size width via container_size hook" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=wrap><h1 class=title>Bun</h1></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body { margin: 0 } .wrap { width: 500px; container-type: inline-size } .title { font-size: min(14.2cqw, 6rem); margin: 0 }",
  )
  debug_assert(engine.has_container_rules(), "has_cq must be true for cqw unit")
  let fonts = Fonts::new_portable([], [])
  let root1 = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root1, fonts, 1280.0, 800.0, 0.0)
  let sizes = container_sizes(root1)
  css::set_container_size_hook(fn(uid : Int) -> Option[(Double, Double)] { intmap::get(sizes, uid) })
  engine.forget_all()
  let root2 = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root2, fonts, 1280.0, 800.0, 0.0)
  let wrap = doc.children[1].children[1].children[0]
  let h1 = wrap.children[0]
  let wrap_sz = intmap::get(sizes, wrap.uid)
  debug_assert(wrap_sz.is_some(), "sizes missing wrap.uid, len=" + sizes.len().to_string())
  match box_of(root2, h1) {
    Some(hb) => debug_assert((hb.style.font_size - 71.0).abs() < 0.5, "got h1 box font_size=" + hb.style.font_size.to_string())
    None => panic("missing h1 box")
  }
  css::set_container_size_hook(fn(_uid : Int) -> Option[(Double, Double)] { None })
}

test "grid-auto-flow: column intrinsic sizing inside flex sums all columns + gaps" {
  let doc = html::parse(
    "<!doctype html><html><body><header><div class=logo>Logo</div><ul class=nav><li>A</li><li>B</li><li>C</li><li>D</li></ul></header></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} header{display:flex;justify-content:space-between;width:1000px} .logo{width:100px} .nav{display:grid;grid-auto-flow:column;gap:32px;list-style:none;margin:0;padding:0} .nav li{width:80px;height:20px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let header = doc.children[1].children[1].children[0]
  let nav = header.children[1]
  match box_of(root, nav) {
    Some(nb) => {
      // 4 * 80px + 3 * 32px = 416px
      debug_assert((nb.w - 416.0).abs() < 1.0, "grid-auto-flow:column intrinsic width should be 416px, got " + nb.w.to_string())
    }
    None => panic("missing nav box")
  }
}

test "grid-column: -1 (implicit column past explicit tracks) does not runaway to row 100000" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=g><div class=a>Logo</div><div class=b>Nav</div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .g{display:grid;grid-template-columns:auto 1fr auto;width:1000px} .a{height:40px} .b{grid-column:-1;height:40px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let g = doc.children[1].children[1].children[0]
  match box_of(root, g) {
    Some(gb) => {
      debug_assert(gb.h > 30.0 && gb.h < 200.0, "grid with grid-column:-1 must stay single-row (~40px), got " + gb.h.to_string())
    }
    None => panic("missing grid box")
  }
}

test "backdrop-filter establishes abspos containing block" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=spacer></div><div class=card><div class=inner>Hello</div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .spacer{height:400px} .card{width:300px;height:100px;margin-left:200px;backdrop-filter:blur(6px)} .inner{position:absolute;inset:12px 16px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let card = doc.children[1].children[1].children[1]
  let inner = card.children[0]
  match (box_of(root, card), box_of(root, inner)) {
    (Some(cb), Some(ib)) => {
      debug_assert((ib.x - (cb.x + 16.0)).abs() < 1.0, "abspos child x must be inside backdrop-filter card, got " + ib.x.to_string() + " vs " + (cb.x + 16.0).to_string())
      debug_assert((ib.y - (cb.y + 12.0)).abs() < 1.0, "abspos child y must be inside backdrop-filter card, got " + ib.y.to_string() + " vs " + (cb.y + 12.0).to_string())
    }
    _ => panic("missing card or inner box")
  }
}

test "grid direct text node becomes anonymous grid item in auto 1fr auto track" {
  let doc = html::parse(
    "<!doctype html><html><body><button class=btn><span class=ico></span>Quick search<kbd class=k>K</kbd></button></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .btn{display:grid;grid-template-columns:auto 1fr auto;width:320px;padding:0;border:0} .ico{display:block;width:16px;height:16px} .k{display:block;width:24px;height:16px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let btn = doc.children[1].children[1].children[0]
  let kbd = btn.children[2]
  match box_of(root, kbd) {
    Some(kb) => {
      debug_assert(kb.x > 250.0, "kbd in 3rd column (after anonymous text item in 1fr) must be near right edge, got x=" + kb.x.to_string())
    }
    None => panic("missing kbd box")
  }
}

test "grid stretched flex item re-layouts to align-items center" {
  let doc = html::parse(
    "<!doctype html><html><body><nav class=nav><div class=links><a class=item>Docs</a></div></nav></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .nav{display:grid;height:60px} .links{display:flex;align-items:center} .item{display:block;height:20px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let nav = doc.children[1].children[1].children[0]
  let links = nav.children[0]
  let item = links.children[0]
  match box_of(root, item) {
    Some(ib) => {
      debug_assert((ib.y - 20.0).abs() < 1.0, "flex child inside grid-stretched 60px container must be centered at y=20, got y=" + ib.y.to_string())
    }
    None => panic("missing item box")
  }
}

test "grid minmax with nested max() comma preserves auto first column" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=hdr><div class=brand>Biome Docs</div><div class=mid>Search</div><div class=end>Menu</div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .hdr{display:grid;width:1200px;grid-template-columns:minmax(calc(0px + max(0px, 100px - 20px)), auto) 1fr auto} .brand{width:240px;height:40px} .mid{height:40px} .end{width:100px;height:40px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let hdr = doc.children[1].children[1].children[0]
  let brand = hdr.children[0]
  match box_of(root, brand) {
    Some(bb) => {
      debug_assert(bb.w >= 239.0, "minmax(calc(...max(a,b)), auto) must not collapse col 0 to 0px, got w=" + bb.w.to_string())
    }
    None => panic("missing brand box")
  }
}

test "grid sorts auto-placed items by CSS order" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=hero><div class=img>Logo</div><div class=copy>Heading</div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .hero{display:grid;width:1000px;grid-template-columns:7fr 4fr} .img{order:2;height:100px} .copy{order:0;height:100px}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let hero = doc.children[1].children[1].children[0]
  let img = hero.children[0]
  let copy = hero.children[1]
  match (box_of(root, img), box_of(root, copy)) {
    (Some(ib), Some(cb)) => {
      debug_assert(cb.x < ib.x, "order:0 copy must be placed left of order:2 img, got copy.x=" + cb.x.to_string() + " img.x=" + ib.x.to_string())
    }
    _ => panic("missing hero boxes")
  }
}

test "select intrinsic height includes vertical padding and border" {
  let doc = html::parse(
    "<!doctype html><html><body><select class=sel><option>Auto</option></select></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet("body{margin:0} .sel{font-size:14px;padding:10px 8px;border:0}")
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 800.0, 600.0, 0.0)
  let sel = doc.children[1].children[1].children[0]
  match box_of(root, sel) {
    Some(sb) => {
      debug_assert(sb.h >= 34.0, "select with 10px vertical padding must include padding in height, got h=" + sb.h.to_string())
    }
    None => panic("missing select box")
  }
}

test "six 16.6666667% left floats stay on one row without subpixel wrapping" {
  let doc = html::parse(
    "<!doctype html><html><body><ul class=bar><li>1</li><li>2</li><li>3</li><li>4</li><li>5</li><li>6</li></ul></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1200.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .bar{width:1200px;list-style:none;margin:0;padding:0} .bar li{float:left;width:16.6666667%;height:40px;box-sizing:border-box;border-left:1px solid #222;border-right:1px solid #111}",
  )
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root, fonts, 1200.0, 600.0, 0.0)
  let bar = doc.children[1].children[1].children[0]
  let li0 = bar.children[0]
  let li5 = bar.children[5]
  match (box_of(root, li0), box_of(root, li5)) {
    (Some(b0), Some(b5)) => {
      debug_assert((b5.y - b0.y).abs() < 1.0, "6th 16.6666667% float must stay on same row as 1st, got y0=" + b0.y.to_string() + " y5=" + b5.y.to_string())
    }
    _ => panic("missing float li boxes")
  }
}

test "cqw width and padding resolve against ancestor container-type inline-size during layout" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=win><div class=dot></div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .win{width:400px;container-type:inline-size} .dot{width:10cqw;height:5cqw;padding-left:2.5cqw}",
  )
  let fonts = Fonts::new_portable([], [])
  let root1 = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root1, fonts, 1280.0, 800.0, 0.0)
  let sizes = container_sizes(root1)
  css::set_container_size_hook(fn(uid : Int) -> Option[(Double, Double)] { intmap::get(sizes, uid) })
  engine.forget_all()
  let root2 = test_unwrap(generate(doc, engine))
  layout_with_scrollbar(root2, fonts, 1280.0, 800.0, 0.0)
  css::set_container_size_hook(fn(_uid : Int) -> Option[(Double, Double)] { None })
  let win = doc.children[1].children[1].children[0]
  let dot = win.children[0]
  match box_of(root2, dot) {
    Some(db) => {
      // 10cqw of 400px = 40px + 2.5cqw padding-left = 10px -> total border-box width 50px (NOT 128px+32px from viewport 1280px)
      debug_assert((db.w - 50.0).abs() < 1.0, "cqw width+padding must resolve against 400px container (50px), got " + db.w.to_string())
      debug_assert((db.h - 20.0).abs() < 1.0, "cqw height must resolve against 400px container (20px), got " + db.h.to_string())
    }
    None => panic("missing dot box")
  }
}

test "white-space nowrap does not break before inline open tag inside narrow box" {
  let doc = html::parse(
    "<!doctype html><html><body><div class=lbl><a href='#'>rollup 4</a> + <a href='#'>terser</a></div></body></html>",
