///|
test "Wave 124B: CSS Grid repeat(7, 1fr) two-row enterprise logo wall distributes columns and rows evenly" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='wall' style='display:grid;grid-template-columns:repeat(7,1fr);column-gap:10px;row-gap:16px;width:760px'>" +
    "<div style='height:32px'>A</div><div style='height:32px'>B</div><div style='height:32px'>C</div>" +
    "<div style='height:32px'>D</div><div style='height:32px'>E</div><div style='height:32px'>F</div>" +
    "<div style='height:32px'>G</div><div style='height:32px'>H</div>" +
    "</div></body></html>",
  )
  let wall = doc.children[1].children[1].children[0]
  let c0 = wall.children[0]
  let c6 = wall.children[6]
  let c7 = wall.children[7]
  let e = css::Engine::new(css::Env::new(1000.0, 400.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1000.0, 400.0, 0.0)
  let b0 = match box_of(root, c0) { Some(b) => b None => panic("c0") }
  let b6 = match box_of(root, c6) { Some(b) => b None => panic("c6") }
  let b7 = match box_of(root, c7) { Some(b) => b None => panic("c7") }
  // (760 - 6*10) / 7 = 100px per column; col 6 at x = 6*110 = 660; row 2 col 0 at y = 32 + 16 = 48
  debug_assert((b0.w - 100.0).abs() < 1.0 && (b6.x - 660.0).abs() < 1.0, "repeat(7,1fr) columns must resolve to 100px with col 6 at x=660")
  debug_assert((b7.x - b0.x).abs() < 1.0 && (b7.y - (b0.y + 48.0)).abs() < 1.0, "8th logo must wrap to row 2 at y=48")
  html::cut(doc)
}

///|
test "Wave 125B: split two-column hero with overhanging negative-margin tabbed card below" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<section id='hero' style='display:flex;justify-content:space-between;width:1000px;height:360px;padding:40px;box-sizing:border-box'>" +
    "<div id='left' style='width:440px'>Lightweight Kubernetes</div>" +
    "<pre id='code' style='width:400px;height:140px;margin:0'>curl -sfL https://get.k3s.io | sh -</pre>" +
    "</section>" +
    "<div id='card' style='width:800px;height:120px;margin:-40px auto 0'>Great For</div>" +
    "</body></html>",
  )
  let hero = doc.children[1].children[1].children[0]
  let left = hero.children[0]
  let code = hero.children[1]
  let card = doc.children[1].children[1].children[1]
  let e = css::Engine::new(css::Env::new(1000.0, 800.0))
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1000.0, 800.0, 0.0)
  let bl = match box_of(root, left) { Some(b) => b None => panic("left") }
  let bcode = match box_of(root, code) { Some(b) => b None => panic("code") }
  let bcard = match box_of(root, card) { Some(b) => b None => panic("card") }
  // Inner hero width = 1000 - 80 = 920 -> left at x=40, code at x = 40 + (920 - 400) = 560
  debug_assert((bl.x - 40.0).abs() < 1.0 && (bcode.x - 560.0).abs() < 1.0, "split hero columns must sit at x=40 and x=560")
  // Negative margin-top -40px pulls card up to y = 360 - 40 = 320, centered at x = (1000 - 800)/2 = 100
  debug_assert((bcard.x - 100.0).abs() < 1.0 && (bcard.y - 320.0).abs() < 1.0, "overhanging card must center at x=100 and overlap hero at y=320")
  html::cut(doc)
}

///|
test "Wave 1: CSS Grid grid-column / grid-column-end supports calc(), min/max/clamp(), and var()-expanded span calc()" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='g' style='display:grid;grid-template-columns:repeat(12, 100px);width:1200px;--s:2;--e:7'>" +
    "<div id='a' style='grid-column-start:2;grid-column-end:span calc(7 - 2 + 1);height:40px'></div>" +
    "<div id='b' style='grid-column:calc(1 + 1) / span calc(4 * 2);height:40px'></div>" +
    "<div id='c' style='grid-column-start:var(--s);grid-column-end:span calc(var(--e, 7) - var(--s, 2) + 1);height:40px'></div>" +
    "<div id='d' style='grid-column:calc(8 / 2) / span calc(6 / 2);height:40px'></div>" +
    "</div></body></html>",
  )
  let g = doc.children[1].children[1].children[0]
  let a = g.children[0]
  let b = g.children[1]
  let c = g.children[2]
  let d = g.children[3]
  let e = css::Engine::new(css::Env::new(1200.0, 600.0))
  let root = match generate(doc, e) { Some(r) => r None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1200.0, 600.0, 0.0)
  let ba = match box_of(root, a) { Some(x) => x None => panic("a") }
  let bb = match box_of(root, b) { Some(x) => x None => panic("b") }
  let bc = match box_of(root, c) { Some(x) => x None => panic("c") }
  let bd = match box_of(root, d) { Some(x) => x None => panic("d") }
  debug_assert((ba.x - 100.0).abs() < 1.0 && (ba.w - 600.0).abs() < 1.0, "a expected x=100,w=600 got x=" + ba.x.to_string() + ",w=" + ba.w.to_string())
  debug_assert((bb.x - 100.0).abs() < 1.0 && (bb.w - 800.0).abs() < 1.0, "b expected x=100,w=800 got x=" + bb.x.to_string() + ",w=" + bb.w.to_string())
  debug_assert((bc.x - 100.0).abs() < 1.0 && (bc.w - 600.0).abs() < 1.0, "c expected x=100,w=600 got x=" + bc.x.to_string() + ",w=" + bc.w.to_string())
  debug_assert((bd.x - 300.0).abs() < 1.0 && (bd.w - 300.0).abs() < 1.0, "d expected x=300,w=300 got x=" + bd.x.to_string() + ",w=" + bd.w.to_string())
  html::cut(doc)
}

///|
test "Wave 1: position:absolute inset:0 stretches text <input> to containing block width and height" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='wrap' style='position:relative;width:320px;height:42px'>" +
    "<input id='inp' type='text' placeholder='Search by Inspiration' style='position:absolute;inset:0;padding-left:38px;border:none;box-sizing:border-box'>" +
    "</div></body></html>",
  )
  let wrap = doc.children[1].children[1].children[0]
  let inp = wrap.children[0]
  let e = css::Engine::new(css::Env::new(800.0, 400.0))
  let root = match generate(doc, e) { Some(r) => r None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 400.0, 0.0)
  let bi = match box_of(root, inp) { Some(x) => x None => panic("inp") }
  debug_assert((bi.w - 320.0).abs() < 1.0 && (bi.h - 42.0).abs() < 1.0, "abs inset:0 input must stretch to 320x42, got " + bi.w.to_string() + "x" + bi.h.to_string())
  html::cut(doc)
}

///|
test "Batch 2: CSS Text 3 §5.1 white-space:nowrap inline-block and inline wrap at outer boundary inside wrapping parent" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='wrap_ib' style='width:120px;font-size:16px;line-height:20px'>" +
    "AlphaBetaGamma<span style='display:inline-block;white-space:nowrap'>DeltaEpsilon</span>" +
    "</div>" +
    "<div id='nowrap_parent' style='width:120px;font-size:16px;line-height:20px;white-space:nowrap'>" +
    "AlphaBetaGamma<span style='display:inline-block;white-space:nowrap'>DeltaEpsilon</span>" +
    "</div>" +
    "<div id='wrap_cjk' style='width:80px;font-size:16px;line-height:20px'>" +
    "日本語文字列<span style='white-space:nowrap'>改行境界</span>" +
    "</div>" +
    "</body></html>",
  )
  let body = doc.children[1].children[1]
  let wrap_ib = body.children[0]
  let nowrap_parent = body.children[1]
  let wrap_cjk = body.children[2]
  let e = css::Engine::new(css::Env::new(400.0, 400.0))
  let root = match generate(doc, e) { Some(r) => r None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let b1 = match box_of(root, wrap_ib) { Some(x) => x None => panic("wrap_ib") }
  let b2 = match box_of(root, nowrap_parent) { Some(x) => x None => panic("nowrap_parent") }
  let b3 = match box_of(root, wrap_cjk) { Some(x) => x None => panic("wrap_cjk") }
  debug_assert(b1.h >= 38.0, "inline-block with white-space:nowrap inside wrapping parent must wrap onto 2 lines, got h=" + b1.h.to_string())
  debug_assert(b2.h <= 22.0, "inline-block inside white-space:nowrap parent must stay on 1 line, got h=" + b2.h.to_string())
  debug_assert(b3.h >= 38.0, "inline white-space:nowrap after CJK inside wrapping parent must break at entry boundary, got h=" + b3.h.to_string())
  html::cut(doc)
}

///|
test "Batch 3: CSS Grid repeat(auto-fill, minmax(270px, 1fr)) with gap computes exact 3 columns on 1136px container" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='g' style='display:grid;width:1136px;grid-template-columns:repeat(auto-fill, minmax(270px, 1fr));gap:36px'>" +
    "<div id='c0' style='height:100px'></div>" +
    "<div id='c1' style='height:100px'></div>" +
    "<div id='c2' style='height:100px'></div>" +
    "<div id='c3' style='height:100px'></div>" +
    "</div></body></html>",
  )
  let body = doc.children[1].children[1]
  let grid = body.children[0]
  let c0 = grid.children[0]
  let c2 = grid.children[2]
  let c3 = grid.children[3]
  let e = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, e) { Some(r) => r None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let b0 = match box_of(root, c0) { Some(x) => x None => panic("c0") }
  let b2 = match box_of(root, c2) { Some(x) => x None => panic("c2") }
  let b3 = match box_of(root, c3) { Some(x) => x None => panic("c3") }
  // floor((1136 + 36) / (270 + 36)) = 3 columns -> each (1136 - 72) / 3 = 354.67px
  debug_assert((b0.w - 354.67).abs() < 1.5, "auto-fill minmax(270px,1fr) col width must be ~354.67px, got " + b0.w.to_string())
  debug_assert((b2.y - b0.y).abs() < 1.0, "3rd card must be on row 1, got y=" + b2.y.to_string())
  debug_assert(b3.y >= b0.y + 135.0, "4th card must wrap to row 2 (y>=136), got y=" + b3.y.to_string())
  debug_assert((b3.x - b0.x).abs() < 1.0, "4th card must align to col 0, got x=" + b3.x.to_string())
  html::cut(doc)
}

///|
test "Batch 3: CSS UI text-overflow:ellipsis appends U+2026 on overflowing single-line nowrap box" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='over' style='width:120px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:14px;line-height:20px'>Daniel Bodea / Kreatank Studio</div>" +
    "<div id='short' style='width:240px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:14px;line-height:20px'>Short Name</div>" +
    "</body></html>",
  )
  let body = doc.children[1].children[1]
  let over = body.children[0]
  let short = body.children[1]
  let e = css::Engine::new(css::Env::new(400.0, 200.0))
  let root = match generate(doc, e) { Some(r) => r None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 400.0, 200.0, 0.0)
  let b_over = match box_of(root, over) { Some(x) => x None => panic("over") }
  let b_short = match box_of(root, short) { Some(x) => x None => panic("short") }
  let mut saw_ell = false
  let mut ell_overflow = false
  let mut i = 0
  while i < b_over.children.length() {
    let c = b_over.children[i]
    let mut j = 0
    while j < c.frags.length() {
      let f = c.frags[j]
      if f.text.contains("\u{2026}") { saw_ell = true }
      if f.x + f.w > b_over.x + b_over.w + 1.0 { ell_overflow = true }
      j += 1
    }
    i += 1
  }
  let mut short_ell = false
  i = 0
  while i < b_short.children.length() {
    let c = b_short.children[i]
    let mut j = 0
    while j < c.frags.length() {
      if c.frags[j].text.contains("\u{2026}") { short_ell = true }
      j += 1
    }
    i += 1
  }
  debug_assert(saw_ell, "overflowing text-overflow:ellipsis box must emit U+2026 ellipsis")
  debug_assert(!ell_overflow, "truncated ellipsis fragment must fit within box width")
  debug_assert(!short_ell, "non-overflowing text-overflow:ellipsis box must not emit ellipsis")
  html::cut(doc)
}

///|
test "Batch 3: CSS Text 4 text-wrap:balance and text-wrap-style:balance equalize multi-line widths" {
  let text = "A collection of powerful productivity tools all within an extendable launcher. Fast, ergonomic and reliable."
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<p id='norm' style='width:580px;font-size:16px;line-height:24px;text-align:center'>" + text + "</p>" +
    "<p id='bal' style='width:580px;font-size:16px;line-height:24px;text-align:center;text-wrap:balance'>" + text + "</p>" +
    "<p id='bal2' style='width:580px;font-size:16px;line-height:24px;text-align:center;text-wrap-style:balance'>" + text + "</p>" +
    "</body></html>",
  )
  let body = doc.children[1].children[1]
  let norm = body.children[0]
  let bal = body.children[1]
  let bal2 = body.children[2]
  let e = css::Engine::new(css::Env::new(800.0, 400.0))
  let root = match generate(doc, e) { Some(r) => r None => panic("root") }
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 800.0, 400.0, 0.0)
  let line_spread = fn(b : Box) -> (Int, Double) {
    let ys : Array[Double] = []
    let mins : Array[Double] = []
    let maxs : Array[Double] = []
    let mut ci = 0
    while ci < b.children.length() {
      let c = b.children[ci]
      let mut fi = 0
      while fi < c.frags.length() {
        let f = c.frags[fi]
        let mut idx = -1
        let mut yi = 0
        while yi < ys.length() {
          if (ys[yi] - f.y).abs() <= 2.0 { idx = yi; break }
          yi += 1
        }
        if idx < 0 {
          ys.push(f.y)
          mins.push(f.x)
          maxs.push(f.x + f.w)
        } else {
          if f.x < mins[idx] { mins[idx] = f.x }
          if f.x + f.w > maxs[idx] { maxs[idx] = f.x + f.w }
        }
        fi += 1
      }
      ci += 1
    }
    let mut lo_w = 1.0e9
    let mut hi_w = 0.0
    let mut k = 0
    while k < ys.length() {
      let w = maxs[k] - mins[k]
      if w < lo_w { lo_w = w }
      if w > hi_w { hi_w = w }
      k += 1
    }
    (ys.length(), hi_w - lo_w)
  }
  let b_norm = match box_of(root, norm) { Some(x) => x None => panic("norm") }
  let b_bal = match box_of(root, bal) { Some(x) => x None => panic("bal") }
  let b_bal2 = match box_of(root, bal2) { Some(x) => x None => panic("bal2") }
  let (n_norm, sp_norm) = line_spread(b_norm)
  let (n_bal, sp_bal) = line_spread(b_bal)
  let (n_bal2, sp_bal2) = line_spread(b_bal2)
  debug_assert(n_norm == 2 && n_bal == 2 && n_bal2 == 2, "all three paragraphs must be 2 lines, got " + n_norm.to_string() + "/" + n_bal.to_string() + "/" + n_bal2.to_string())
  debug_assert(sp_bal < sp_norm - 50.0, "text-wrap:balance must drastically reduce line-width spread (" + sp_bal.to_string() + " vs " + sp_norm.to_string() + ")")
  debug_assert((sp_bal2 - sp_bal).abs() < 1.0, "text-wrap-style:balance must match text-wrap:balance")
  html::cut(doc)
}

test "Batch 4: zero-width variation selectors (U+FE0F) and ZWJ/ZWSP measure 0 width in synthetic fallback" {
  let fonts = Fonts::new_portable([], [])
  let w_base = fonts.width(SYNTHETIC, 20.0, "a 🌧 b")
  let w_vs16 = fonts.width(SYNTHETIC, 20.0, "a 🌧\u{FE0F} b")
  let w_zw = fonts.width(SYNTHETIC, 20.0, "a \u{200B}\u{200D}\u{FEFF}🌧\u{FE0F} b")
  debug_assert(
    (w_vs16 - w_base).abs() < 0.01,
    "U+FE0F must add 0 width in synthetic fallback: base=" + w_base.to_string() + " vs16=" + w_vs16.to_string(),
  )
  debug_assert(
    (w_zw - w_base).abs() < 0.01,
    "ZWSP/ZWJ/FEFF must add 0 width in synthetic fallback: base=" + w_base.to_string() + " zw=" + w_zw.to_string(),
  )
}

test "Batch 5: CSS Grid minmax() and Flex flex-basis resolve percentage inside min()/max()/calc() against container" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='g' style='display:grid;width:1280px;" +
    "--inset:48px;--gutter:24px;" +
    "--avail:calc(100% - (2 * var(--inset)));" +
    "--page:min(1252px, var(--avail));" +
    "--center:min(calc(1344px + (2 * var(--gutter))), var(--page));" +
    "--half:calc((var(--center) - (3 * var(--gutter))) / 2);" +
    "--rail:calc((var(--page) - var(--center)) / 2);" +
    "grid-template-columns:[full-start] minmax(0, 1fr) var(--inset) [content-start] var(--rail) var(--gutter) [center-start] minmax(0, var(--half)) [mid-start] var(--gutter) [mid-end] minmax(0, var(--half)) [center-end] var(--gutter) var(--rail) [content-end] var(--inset) minmax(0, 1fr) [full-end]'>" +
    "<div id='hero' style='grid-column:center-start / center-end;height:40px'></div>" +
    "</div>" +
    "<div id='f1' style='display:flex;width:1000px'><div id='fi1' style='flex:0 0 min(50%, 300px);height:20px'></div></div>" +
    "<div id='f2' style='display:flex;width:400px'><div id='fi2' style='flex:0 0 min(50%, 300px);height:20px'></div></div>" +
    "</body></html>",
  )
  let fonts = Fonts::new_portable([], [])
  let eng = css::Engine::new(css::Env::new(1280.0, 800.0))
  let root = match generate(doc, eng) { Some(r) => r None => panic("root") }
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let hero = body.children[0].children[0]
  let fi1 = body.children[1].children[0]
  let fi2 = body.children[2].children[0]
  let b_hero = match box_of(root, hero) { Some(x) => x None => panic("hero") }
  let b_fi1 = match box_of(root, fi1) { Some(x) => x None => panic("fi1") }
  let b_fi2 = match box_of(root, fi2) { Some(x) => x None => panic("fi2") }
  // At 1280px: avail=1184, page=1184, center=1184, half=(1184-72)/2=556, center span = 556 + 24 + 556 = 1136
  debug_assert(
    (b_hero.w - 1136.0).abs() < 1.5,
    "grid minmax(0, calc(min(..., 100% - ...))) hero width must be ~1136px, got " + b_hero.w.to_string(),
  )
  debug_assert(
    (b_fi1.w - 300.0).abs() < 1.0,
    "flex-basis:min(50%, 300px) in 1000px container must be 300px, got " + b_fi1.w.to_string(),
  )
  debug_assert(
    (b_fi2.w - 200.0).abs() < 1.0,
    "flex-basis:min(50%, 300px) in 400px container must be 200px, got " + b_fi2.w.to_string(),
  )
  html::cut(doc)
}

test "Batch 6: word-break: keep-all suppresses CJK mid-word breaks while <wbr> provides phrase wrap points" {
  // 1. Unit check on word_pieces_ex: keep-all does not split CJK chars
  let p_norm = word_pieces_ex("ビデオ通話", false, 0, false, false)
  let p_keep = word_pieces_ex("ビデオ通話", false, 0, false, true)
  debug_assert(p_norm.length() == 5, "normal CJK splits per char")
  debug_assert(p_keep.length() == 1 && p_keep[0].0 == "ビデオ通話", "keep-all keeps CJK word intact")
  // 2. Layout check: with <wbr> + word-break:keep-all, wraps cleanly at <wbr> instead of mid-word
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='keep' style='width:120px;font-size:20px;line-height:24px;word-break:keep-all'>AI を<wbr>活用した<wbr>ビデオ通話</div>" +
    "<div id='nowbr' style='width:120px;font-size:20px;line-height:24px;word-break:keep-all'>活用したビデオ通話</div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 400.0))
  let fonts = Fonts::new_portable([], [])
  let root = match generate(doc, eng) { Some(b) => b None => panic("root") }
  layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let body = doc.children[1].children[1]
  let b_keep = match box_of(root, body.children[0]) { Some(x) => x None => panic("keep") }
  let b_nowbr = match box_of(root, body.children[1]) { Some(x) => x None => panic("nowbr") }
  debug_assert(
    b_keep.h >= 48.0,
    "<wbr> inside word-break:keep-all must allow wrapping onto multiple lines (h>=48), got " + b_keep.h.to_string(),
  )
  debug_assert(
    (b_nowbr.h - 24.0).abs() < 1.0,
    "word-break:keep-all without <wbr> or spaces must keep CJK run on 1 line (h=24), got " + b_nowbr.h.to_string(),
  )
  html::cut(doc)
}

test "Batch 8: percentage height child inside non-BFC block with border/padding resolves against content-box height" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<span id='av' style='display:block;width:80px;height:80px;border:1px solid #ccc'>" +
    "<img id='im' style='display:inline-block;width:100%;height:100%' width='400' height='400'>" +
    "</span>" +
    "<div id='padbox' style='width:100px;height:60px;padding:10px 0;border:2px solid #000'>" +
    "<div id='child' style='height:50%'></div>" +
    "</div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(400.0, 400.0))
  let fonts = Fonts::new_portable([], [])
  let root = match generate(doc, eng) { Some(b) => b None => panic("root") }
  layout_with_scrollbar(root, fonts, 400.0, 400.0, 0.0)
  let body = doc.children[1].children[1]
  let av = body.children[0]
  let im = av.children[0]
  let padbox = body.children[1]
  let child = padbox.children[0]
  let b_av = match box_of(root, av) { Some(x) => x None => panic("av") }
  let b_im = match box_of(root, im) { Some(x) => x None => panic("im") }
  let b_ch = match box_of(root, child) { Some(x) => x None => panic("child") }
  debug_assert((b_av.h - 82.0).abs() < 0.5, "content-box 80px + 2px border = 82px, got " + b_av.h.to_string())
  debug_assert(
    (b_im.w - 80.0).abs() < 0.5 && (b_im.h - 80.0).abs() < 0.5,
    "img height:100% inside 80px content-box with 1px border must be 80x80, got " + b_im.w.to_string() + "x" + b_im.h.to_string(),
  )
  debug_assert(
    (b_ch.h - 30.0).abs() < 0.5,
    "div height:50% inside 60px content-box with 10px padding + 2px border must be 30px, got " + b_ch.h.to_string(),
  )
  html::cut(doc)
}

test "Perf Wave1: incremental relayout skips reused subtree with abs+rel descendants and matches full layout" {
  let html_str = "<!doctype html><html><body>" +
  "<div id='top' class='t0'>header</div>" +
  "<div id='big' class='wrap'>" +
  test_repeat("<div class='item'><div class='rel'>r</div><div class='abs'>a</div></div>", 80) +
  "</div></body></html>"
  let sheet = "body { margin: 0 } .t0 { height: 20px } .t1 { height: 60px } .wrap { position: relative } .item { position: relative; height: 10px } .rel { position: relative; top: 2px; left: 3px; height: 4px } .abs { position: absolute; top: 1px; right: 2px; width: 10px; height: 5px }"
  let doc = html::parse(html_str)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let reuse = Reuse::new()
  let r0 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout(r0, fonts, 400.0, 800.0)

  // Mutate top sibling height so #big is reused and shifted down by +40px
  let top = doc.children[1].children[1].children[0]
  engine.forget(top, false, Some(("class", "t1")), None, false)
  top.attrs[1].value = "t1"
  reuse.changed(top)
  reset_pass_visits()
  let r_inc = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  let taken = reuse.taken_count()
  reuse.fresh()
  layout(r_inc, fonts, 400.0, 800.0)
  let visits = get_pass_visits()
  debug_assert(taken >= 1, "reused #big subtree must be taken")
  debug_assert(
    visits < 40,
    "incremental relayout must not walk 80 reused rel+abs items (visits=" + visits.to_string() + ")",
  )

  // Compare every box rect with a fresh full layout
  let engine_full = css::Engine::new(css::Env::{ width: 400.0, height: 800.0, media: "screen", dpr: 1.0 })
  engine_full.add_sheet(sheet)
  let r_full = test_unwrap(generate(doc, engine_full))
  layout(r_full, fonts, 400.0, 800.0)
  let inc_rects = rects(r_inc)
  let full_rects = rects(r_full)
  debug_assert(inc_rects.len() == full_rects.len(), "rect count must match full layout")
  full_rects.each(fn(k : Int, b : (Double, Double, Double, Double)) -> Unit {
    match intmap::get(inc_rects, k) {
      Some(a) =>
      debug_assert(
        (a.0 - b.0).abs() < 0.01 && (a.1 - b.1).abs() < 0.01 && (a.2 - b.2).abs() < 0.01 && (a.3 - b.3).abs() < 0.01,
        "rect " + k.to_string() + " mismatch: inc=(" + a.0.to_string() + "," + a.1.to_string() + "," + a.2.to_string() + "," + a.3.to_string() + ") vs full=(" + b.0.to_string() + "," + b.1.to_string() + "," + b.2.to_string() + "," + b.3.to_string() + ")",
      )
      None => debug_assert(false, "missing rect for layout_id " + k.to_string())
    }
  })
  html::cut(doc)
}

fn find_by_id(b : Box, id : String) -> Option[Box] {
  match b.node {
    Some(n) => match n.attr("id") { Some(v) if v == id => return Some(b) _ => () }
    None => ()
  }
  let mut i = 0
  while i < b.children.length() {
    match find_by_id(b.children[i], id) {
      Some(hit) => return Some(hit)
      None => ()
    }
    i += 1
  }
  None
}

test "Batch 9: CSS Positioned Layout 3 §3.5 abspos inline-origin static inline position respects parent text-align" {
  let doc = html::parse(
    "<div id='c' style='position:relative;width:200px;text-align:center'>" +
    "<p style='margin:0;height:20px'>top</p>" +
    "<span id='inl-c' style='position:absolute;width:40px;height:10px'></span>" +
    "<div id='blk-c' style='position:absolute;width:40px;height:10px'></div>" +
    "</div>" +
    "<div id='r' style='position:relative;width:200px;text-align:right'>" +
    "<p style='margin:0;height:20px'>top</p>" +
    "<span id='inl-r' style='position:absolute;width:40px;height:10px'></span>" +
    "</div>",
  )
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 400.0, media: "screen", dpr: 1.0 })
  engine.add_sheet("body { margin: 0; }")
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout(root, fonts, 400.0, 400.0)
  let b_inl_c = test_unwrap(find_by_id(root, "inl-c"))
  let b_blk_c = test_unwrap(find_by_id(root, "blk-c"))
  let b_inl_r = test_unwrap(find_by_id(root, "inl-r"))
  debug_assert(
    (b_inl_c.x - 100.0).abs() < 0.5,
    "inline-origin abspos in text-align:center 200px block must have static x=100, got " + b_inl_c.x.to_string(),
  )
  debug_assert(
    b_blk_c.x.abs() < 0.5,
    "block-origin abspos in text-align:center 200px block must keep static x=0, got " + b_blk_c.x.to_string(),
  )
  debug_assert(
    (b_inl_r.x - 200.0).abs() < 0.5,
    "inline-origin abspos in text-align:right 200px block must have static x=200, got " + b_inl_r.x.to_string(),
  )
  html::cut(doc)
}

fn make_test_ot_face(id : Int, fam : String, weight : Int, lo_cp : Int, hi_cp : Int) -> OtFace {
  let segs : Array[Cmap4Seg] = [
    Cmap4Seg::{ end_code: hi_cp, start_code: lo_cp, id_delta: 1 - lo_cp, id_range_offset: 0, range_pos: 0 },
  ]
  OtFace::{
    id: id,
    data: Bytes::new(0),
    tables: Map::new(),
    units_per_em: 1000,
    hhea_ascent: 800,
    hhea_descent: -200,
    hhea_line_gap: 0,
    num_hmetrics: 0,
    os2_ascent: 800,
    os2_descent: -200,
    os2_line_gap: 0,
    os2_x_height: 500,
    os2_weight: weight,
    os2_width_class: 5,
    os2_fs_selection: 0,
    has_os2: true,
    families: [fam],
    postscript: fam,
    italic: false,
    has_outlines: true,
    cmap4: segs,
    cmap12: [],
    cmap_loaded: true,
    cmap12_base: -1,
    cmap12_count: 0,
    cmap4_seg_count: 0,
    cmap4_end_base: -1,
    cmap4_start_base: -1,
    cmap4_delta_base: -1,
    cmap4_range_base: -1,
    hmtx_off: 0,
    hmtx_len: 0,
    kern_loaded: true,
    kern_pairs: intmap::IntMap::new(),
    gpos_loaded: [true],
    gpos_pairs: intmap::IntMap::new(),
    glyph_cache: intmap::IntMap::new(),
  }
}

test "Batch 9: CSS Fonts 4 §5 subset web font falls back across subsequent CSS font-family entries preserving weight" {
  let fonts = Fonts::new_portable([], [])
  // Face 0: digits-only subset font ("geistNumbers", covers '0'..'9', weight 400)
  let f0 = make_test_ot_face(0, "geistNumbers", 400, 0x30, 0x39)
  // Face 1: regular Latin web font ("suisse", weight 400, covers ASCII 0x20..0x7E)
  let f1 = make_test_ot_face(1, "suisse", 400, 0x20, 0x7E)
  // Face 2: bold Latin web font ("suisse", weight 700, covers ASCII 0x20..0x7E)
  let f2 = make_test_ot_face(2, "suisse", 700, 0x20, 0x7E)
  fonts.db.faces.push(f0)
  fonts.db.infos.push(FaceInfo::{ id: 0, face_index: 0, data: Bytes::new(0), families: ["geistNumbers"], postscript: "geistNumbers", weight: 400, stretch: 5, italic: false })
  fonts.db.faces.push(f1)
  fonts.db.infos.push(FaceInfo::{ id: 1, face_index: 0, data: Bytes::new(0), families: ["suisse"], postscript: "suisse-400", weight: 400, stretch: 5, italic: false })
  fonts.db.faces.push(f2)
  fonts.db.infos.push(FaceInfo::{ id: 2, face_index: 0, data: Bytes::new(0), families: ["suisse"], postscript: "suisse-700", weight: 700, stretch: 5, italic: false })
  fonts.by_url.set("url:nums", 0)
  fonts.by_url.set("url:suisse-400", 1)
  fonts.by_url.set("url:suisse-700", 2)
  fonts.set_web(
    [
      css::FontFace::{ family: "geistnumbers", src: ["url:nums"], weight_lo: 100, weight_hi: 900, italic: false, size_adjust: 1.0, ranges: [] },
      css::FontFace::{ family: "suisse", src: ["url:suisse-400"], weight_lo: 400, weight_hi: 400, italic: false, size_adjust: 1.0, ranges: [] },
      css::FontFace::{ family: "suisse", src: ["url:suisse-700"], weight_lo: 700, weight_hi: 700, italic: false, size_adjust: 1.0, ranges: [] },
    ],
    fn(_u : String) -> Option[Bytes] { None },
    Map::new(),
  )
  let doc = html::parse("<h1 id='h'>Hello 42</h1><p id='p'>Hello 42</p><h2 id='h2'>Hello 42</h2>")
  let e = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  e.add_sheet(
    "h1, h2 { font-family: geistNumbers, suisse, sans-serif; font-weight: 700; } p { font-family: geistNumbers, suisse, sans-serif; font-weight: 400; }",
  )
  let body = doc.children[0].children[1]
  let sh = match e.style_of(body.children[0], None) { Some(s) => s None => panic("missing h1 style") }
  let sp = match e.style_of(body.children[1], None) { Some(s) => s None => panic("missing p style") }
  let sh2 = match e.style_of(body.children[2], None) { Some(s) => s None => panic("missing h2 style") }
  let id_h = fonts.pick(sh)
  let id_p = fonts.pick(sp)
  // Second element with the same family+weight exercises the `self.picks.get(key)` cache-hit path.
  let id_h2 = fonts.pick(sh2)
  let runs_h = fonts.runs(id_h, "Hello 42")
  let runs_p = fonts.runs(id_p, "Hello 42")
  let runs_h2 = fonts.runs(id_h2, "Hello 42")
  // "Hello " must fall back to suisse-700 (face 2) for h1/h2 and suisse-400 (face 1) for p; "42" stays on geistNumbers (face 0).
  debug_assert(runs_h.length() == 2, "h1 must split into 2 runs (Latin + digits), got " + runs_h.length().to_string())
  debug_assert(base_of(runs_h[0].0) == 2, "h1 Latin run must use bold suisse (face 2), got face " + base_of(runs_h[0].0).to_string())
  debug_assert(base_of(runs_h[1].0) == 0, "h1 digits run must use geistNumbers (face 0), got face " + base_of(runs_h[1].0).to_string())
  debug_assert(runs_p.length() == 2, "p must split into 2 runs (Latin + digits), got " + runs_p.length().to_string())
  debug_assert(base_of(runs_p[0].0) == 1, "p Latin run must use regular suisse (face 1), got face " + base_of(runs_p[0].0).to_string())
  debug_assert(base_of(runs_p[1].0) == 0, "p digits run must use geistNumbers (face 0), got face " + base_of(runs_p[1].0).to_string())
  debug_assert(runs_h2.length() == 2, "cached h2 must split into 2 runs (Latin + digits), got " + runs_h2.length().to_string())
  debug_assert(base_of(runs_h2[0].0) == 2, "cached h2 Latin run must still use bold suisse (face 2), got face " + base_of(runs_h2[0].0).to_string())
  debug_assert(base_of(runs_h2[1].0) == 0, "cached h2 digits run must use geistNumbers (face 0), got face " + base_of(runs_h2[1].0).to_string())
  html::cut(doc)
}

test "Perf Wave3: grid stretched block item reuses memo across sibling height changes and matches full layout" {
  let sb = StringBuilder::new()
  sb.write_string("<div class=grid><div class=sidebar>")
  let mut i = 0
  while i < 20 {
    sb.write_string("<div class=row><span class=rel>R")
    sb.write_string(i.to_string())
    sb.write_string("</span><span class=abs>A</span></div>")
    i += 1
  }
  sb.write_string("</div><div class=main><div class=tall>M</div></div></div>")
  let css_str =
  ".grid { display: grid; grid-template-columns: 200px 200px; } " +
  ".sidebar { overflow-y: scroll; padding-left: 5px; } " +
  ".row { position: relative; height: 24px; } " +
  ".rel { position: relative; top: 2px; display: inline-block; } " +
  ".abs { position: absolute; right: 4px; top: 3px; width: 10px; height: 10px; } " +
  ".main { padding: 4px; } .tall { height: 600px; } .tall.big { height: 1200px; }"
  let doc = html::parse(sb.to_string())
  let eng = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  eng.add_sheet(css_str)
  let fonts = Fonts::new_portable([], [])
  let reuse = Reuse::new()
  let root1 = match generate_with_reuse(doc, eng, Some(reuse)) { Some(b) => b None => panic("root1") }
  layout(root1, fonts, 800.0, 600.0)

  // Grow .tall to 1200px so grid row height stretches .sidebar, then shrink back to 600px.
  let grid_n = doc.children[0].children[1].children[0]
  let tall_n = grid_n.children[1].children[0]
  eng.forget(tall_n, false, Some(("class", "tall big")), None, false)
  tall_n.attrs[0].value = "tall big"
  reuse.changed(tall_n)
  reset_pass_visits()
  let root2 = match generate_with_reuse(doc, eng, Some(reuse)) { Some(b) => b None => panic("root2") }
  reuse.fresh()
  layout(root2, fonts, 800.0, 600.0)
  let visits_grow = get_pass_visits()

  // Compare against fresh full layout.
  let eng_f = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  eng_f.add_sheet(css_str)
  let full2 = match generate(doc, eng_f) { Some(b) => b None => panic("full2") }
  layout(full2, fonts, 800.0, 600.0)
  let inc2_rects = rects(root2)
  let full2_rects = rects(full2)
  debug_assert(inc2_rects.len() == full2_rects.len(), "grow rect count must match full layout")
  full2_rects.each(fn(k : Int, b : (Double, Double, Double, Double)) -> Unit {
    match intmap::get(inc2_rects, k) {
      Some(a) =>
      debug_assert(
        (a.0 - b.0).abs() < 0.01 && (a.1 - b.1).abs() < 0.01 && (a.2 - b.2).abs() < 0.01 && (a.3 - b.3).abs() < 0.01,
        "grow rect " + k.to_string() + " mismatch",
      )
      None => debug_assert(false, "grow missing rect " + k.to_string())
    }
  })
  debug_assert(visits_grow < 25, "reused grid sidebar must not walk its 60+ descendants in apply_relative, got " + visits_grow.to_string())

  // Shrink back to 600px and re-verify.
  eng.forget(tall_n, false, Some(("class", "tall")), None, false)
  tall_n.attrs[0].value = "tall"
  reuse.changed(tall_n)
  reset_pass_visits()
  let root3 = match generate_with_reuse(doc, eng, Some(reuse)) { Some(b) => b None => panic("root3") }
  reuse.fresh()
  layout(root3, fonts, 800.0, 600.0)
  let visits_shrink = get_pass_visits()
  let eng_f3 = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  eng_f3.add_sheet(css_str)
  let full3 = match generate(doc, eng_f3) { Some(b) => b None => panic("full3") }
  layout(full3, fonts, 800.0, 600.0)
  let inc3_rects = rects(root3)
  let full3_rects = rects(full3)
  debug_assert(inc3_rects.len() == full3_rects.len(), "shrink rect count must match full layout")
  full3_rects.each(fn(k : Int, b : (Double, Double, Double, Double)) -> Unit {
    match intmap::get(inc3_rects, k) {
      Some(a) =>
      debug_assert(
        (a.0 - b.0).abs() < 0.01 && (a.1 - b.1).abs() < 0.01 && (a.2 - b.2).abs() < 0.01 && (a.3 - b.3).abs() < 0.01,
        "shrink rect " + k.to_string() + " mismatch",
      )
      None => debug_assert(false, "shrink missing rect " + k.to_string())
    }
  })
  debug_assert(visits_shrink < 25, "shrunk grid sidebar must keep minimal pass_visits, got " + visits_shrink.to_string())
  html::cut(doc)
}

test "Batch 11: CSS Box Sizing 3 height:fit-content/min-content/max-content does not stretch in abspos inset, flex, or grid" {
  let doc = html::parse(
    "<div id='cb' style='position:relative;width:300px;height:400px'>" +
    "<div id='abs_fit' style='position:absolute;inset:0;top:45%;height:fit-content;padding:6px 10px;font-size:16px;line-height:20px'>deploy</div>" +
    "<div id='abs_auto' style='position:absolute;inset:0;top:45%;height:auto'>auto</div>" +
    "</div>" +
    "<div id='flex' style='display:flex;height:200px;width:300px'>" +
    "<div id='flex_fit' style='height:fit-content;line-height:24px'>fit</div>" +
    "<div id='flex_auto' style='height:auto;line-height:24px'>auto</div>" +
    "</div>" +
    "<div id='grid' style='display:grid;grid-template-columns:150px 150px;grid-template-rows:200px'>" +
    "<div id='grid_fit' style='height:fit-content;line-height:24px'>fit</div>" +
    "<div id='grid_auto' style='height:auto;line-height:24px'>auto</div>" +
    "</div>",
  )
  let e = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  layout(root, Fonts::new_portable([], []), 800.0, 600.0)
  let b_cb = match find_by_id(root, "cb") { Some(b) => b None => panic("cb") }
  let b_abs_fit = match find_by_id(root, "abs_fit") { Some(b) => b None => panic("abs_fit") }
  let b_abs_auto = match find_by_id(root, "abs_auto") { Some(b) => b None => panic("abs_auto") }
  let b_flex_fit = match find_by_id(root, "flex_fit") { Some(b) => b None => panic("flex_fit") }
  let b_flex_auto = match find_by_id(root, "flex_auto") { Some(b) => b None => panic("flex_auto") }
  let b_grid_fit = match find_by_id(root, "grid_fit") { Some(b) => b None => panic("grid_fit") }
  let b_grid_auto = match find_by_id(root, "grid_auto") { Some(b) => b None => panic("grid_auto") }
  // abspos: top:45% of 400px = 180px; fit-content must stay intrinsic (~32px), not stretch to 220px.
  debug_assert((b_abs_fit.y - b_cb.y - 180.0).abs() < 1.0, "abs_fit y offset should be 180, got " + (b_abs_fit.y - b_cb.y).to_string())
  debug_assert(b_abs_fit.h > 20.0 && b_abs_fit.h < 50.0, "abs_fit must not stretch via inset:0, got h=" + b_abs_fit.h.to_string())
  debug_assert((b_abs_auto.h - 220.0).abs() < 1.0, "abs_auto must still stretch to 220px, got h=" + b_abs_auto.h.to_string())
  // flex row stretch: fit-content stays 24px while auto stretches to 200px.
  debug_assert(b_flex_fit.h < 40.0, "flex_fit must not stretch to 200px, got h=" + b_flex_fit.h.to_string())
  debug_assert((b_flex_auto.h - 200.0).abs() < 1.0, "flex_auto must still stretch to 200px, got h=" + b_flex_auto.h.to_string())
  // grid stretch: fit-content stays 24px while auto stretches to 200px.
  debug_assert(b_grid_fit.h < 40.0, "grid_fit must not stretch to 200px, got h=" + b_grid_fit.h.to_string())
  debug_assert((b_grid_auto.h - 200.0).abs() < 1.0, "grid_auto must still stretch to 200px, got h=" + b_grid_auto.h.to_string())
  html::cut(doc)
}

test "Batch 11: CSS Fonts 4 §5 multi-script family_fallbacks walks unicode-range siblings after ASCII-covering primary font" {
  let fonts = Fonts::new_portable([], [])
  // Primary Latin-only webfont covers ASCII (0x20..0x7E) at weight 500 only.
  // Fallback webfont "NotoJP" has unicode-range slices: slice 0 covers Latin, slice 1 covers Hiragana (0x3040..0x309F) at weight 400 and 700.
  let f_latin = make_test_ot_face(0, "LatinPrimary", 500, 0x20, 0x7E)
  let f_jp_lat700 = make_test_ot_face(1, "NotoJP", 700, 0x20, 0x7E)
  let f_jp_kana400 = make_test_ot_face(2, "NotoJP", 400, 0x3040, 0x309F)
  let f_jp_kana700 = make_test_ot_face(3, "NotoJP", 700, 0x3040, 0x309F)
  fonts.db.faces.push(f_latin)
  fonts.db.infos.push(FaceInfo::{ id: 0, face_index: 0, data: Bytes::new(0), families: ["LatinPrimary"], postscript: "LatinPrimary-500", weight: 500, stretch: 5, italic: false })
  fonts.db.faces.push(f_jp_lat700)
  fonts.db.infos.push(FaceInfo::{ id: 1, face_index: 0, data: Bytes::new(0), families: ["NotoJP"], postscript: "NotoJP-Lat-700", weight: 700, stretch: 5, italic: false })
  fonts.db.faces.push(f_jp_kana400)
  fonts.db.infos.push(FaceInfo::{ id: 2, face_index: 0, data: Bytes::new(0), families: ["NotoJP"], postscript: "NotoJP-Kana-400", weight: 400, stretch: 5, italic: false })
  fonts.db.faces.push(f_jp_kana700)
  fonts.db.infos.push(FaceInfo::{ id: 3, face_index: 0, data: Bytes::new(0), families: ["NotoJP"], postscript: "NotoJP-Kana-700", weight: 700, stretch: 5, italic: false })
  fonts.by_url.set("url:latin-500", 0)
  fonts.by_url.set("url:notojp-lat-700", 1)
  fonts.by_url.set("url:notojp-kana-400", 2)
  fonts.by_url.set("url:notojp-kana-700", 3)
  fonts.set_web(
    [
      css::FontFace::{ family: "latinprimary", src: ["url:latin-500"], weight_lo: 500, weight_hi: 500, italic: false, size_adjust: 1.0, ranges: [] },
      css::FontFace::{ family: "notojp", src: ["url:notojp-lat-700"], weight_lo: 700, weight_hi: 700, italic: false, size_adjust: 1.0, ranges: [(0x20, 0x7E)] },
      css::FontFace::{ family: "notojp", src: ["url:notojp-kana-400"], weight_lo: 400, weight_hi: 400, italic: false, size_adjust: 1.0, ranges: [(0x3040, 0x309F)] },
      css::FontFace::{ family: "notojp", src: ["url:notojp-kana-700"], weight_lo: 700, weight_hi: 700, italic: false, size_adjust: 1.0, ranges: [(0x3040, 0x309F)] },
    ],
    fn(_u : String) -> Option[Bytes] { None },
    Map::new(),
  )
  let doc = html::parse("<h1 id='h'>AI をした</h1>")
  let e = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  e.add_sheet("h1 { font-family: LatinPrimary, NotoJP, sans-serif; font-weight: 700; }")
  let body = doc.children[0].children[1]
  let sh = match e.style_of(body.children[0], None) { Some(s) => s None => panic("missing h1 style") }
  let id_h = fonts.pick(sh)
  let runs_h = fonts.runs(id_h, "AI をした")
  debug_assert(runs_h.length() == 2, "must split into Latin + Hiragana runs, got " + runs_h.length().to_string())
  debug_assert(base_of(runs_h[0].0) == 0, "Latin run must use LatinPrimary (face 0), got " + base_of(runs_h[0].0).to_string())
  debug_assert(base_of(runs_h[1].0) == 3, "Hiragana run must resolve NotoJP-Kana-700 sibling (face 3), got " + base_of(runs_h[1].0).to_string())
  html::cut(doc)
}

test "Batch 11: CSS Text 4 text-wrap:balance minimizes line-width variance instead of greedy packing" {
  // 3-line paragraph where line 3 is long so greedy-at-bal_w would pack an extra word onto line 1
  // leaving line 2 disproportionately short, whereas minimum-variance DP equalizes all 3 lines.
  let text = "Start your project with a Postgres database. Add Authentication, Data APIs, Edge Functions, Realtime Data, Storage, and Vector embeddings."
  let doc = html::parse(
    "<p id='bal' style='width:536px;font-size:16px;line-height:24px;text-wrap:balance'>" + text + "</p>",
  )
  let e = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let root = match generate(doc, e) { Some(b) => b None => panic("root") }
  layout(root, Fonts::new_portable([], []), 800.0, 600.0)
  let b_bal = match find_by_id(root, "bal") { Some(b) => b None => panic("bal") }
  let line_ys : Array[Double] = []
  let line_max_x : Array[Double] = []
  let line_min_x : Array[Double] = []
  let mut ci = 0
  while ci < b_bal.children.length() {
    let ch = b_bal.children[ci]
    let mut fi = 0
    while fi < ch.frags.length() {
      let it = ch.frags[fi]
      let mut found = -1
      let mut k = 0
      while k < line_ys.length() {
        if (line_ys[k] - it.y).abs() < 2.0 { found = k; break }
        k += 1
      }
      if found < 0 {
        line_ys.push(it.y)
        line_min_x.push(it.x)
        line_max_x.push(it.x + it.w)
      } else {
        if it.x < line_min_x[found] { line_min_x[found] = it.x }
        if it.x + it.w > line_max_x[found] { line_max_x[found] = it.x + it.w }
      }
      fi += 1
    }
    ci += 1
  }
  debug_assert(line_ys.length() == 3, "balanced paragraph must keep 3 lines, got " + line_ys.length().to_string())
  let w0 = line_max_x[0] - line_min_x[0]
  let w1 = line_max_x[1] - line_min_x[1]
  let w2 = line_max_x[2] - line_min_x[2]
  let hi = dmax(w0, dmax(w1, w2))
  let lo = dmin(w0, dmin(w1, w2))
  debug_assert(hi - lo < 60.0, "DP text-wrap:balance must equalize all 3 line widths (spread < 60px), got " + (hi - lo).to_string() + " (" + w0.to_string() + ", " + w1.to_string() + ", " + w2.to_string() + ")")
  html::cut(doc)
}

test "Batch 13: W3C CSS 2.2 §10.6.7 BFC auto height honors negative trailing margin-bottom" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<ul><li id='item1'><div class='wrap'><div class='btn'></div></div></li>" +
    "<li id='item2'><div class='neg-clamp'></div></li></ul>" +
    "</body></html>",
  )
  let engine = css::Engine::new(css::Env::new(800.0, 600.0))
  engine.add_sheet(
    "* { box-sizing: border-box; } body { margin: 0; }" +
    "ul { display: flex; margin: 0; padding: 0; list-style: none; align-items: flex-start; }" +
    ".wrap { display: block; margin-block: -20px; padding-block: 20px; }" +
    ".btn { height: 28px; width: 60px; }" +
    ".neg-clamp { display: block; margin-bottom: -50px; height: 10px; width: 40px; }",
  )
  let fonts = Fonts::new_portable([], [])
  match generate(doc, engine) {
    Some(root) => {
      layout(root, fonts, 800.0, 600.0)
      let mut h1 = -1.0
      let mut h2 = -1.0
      let stack = [root]
      while stack.pop() is Some(b) {
        match b.node {
          Some(n) => {
            let id = n.attr("id").unwrap_or("")
            if id == "item1" { h1 = b.h }
            if id == "item2" { h2 = b.h }
          }
          None => ()
        }
        for ch in b.children { stack.push(ch) }
      }
      debug_assert((h1 - 28.0).abs() < 0.5, "BFC flex item with -20px/+20px child must have auto height 28px, got " + h1.to_string())
      debug_assert(h2 >= 0.0 && h2 < 0.5, "BFC flex item with negative margin exceeding child height must clamp to 0px, got " + h2.to_string())
    }
    None => debug_assert(false, "layout root missing")
  }
  html::cut(doc)
}

test "Batch 13: W3C SVG 2 / CSS Masking 1 svg_overflow_viewbox intersects ancestor <clipPath> bounds" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<svg id='clipped' width='5' height='8' viewBox='0 0.5 5 8'>" +
    "<defs><clipPath id='cp1'><rect x='0' y='0' width='12' height='9'></rect></clipPath></defs>" +
    "<g clip-path='url(#cp1)'><g><rect x='-10' y='3.375' width='13' height='1.75'></rect>" +
    "<path d='M4.8 3.6L5.4 4.25L4.8 4.8L1.2 8.5L0 7.2L3 4.25L0 1.2L1.2 0Z'></path></g></g></svg>" +
    "<svg id='unclipped' width='10' height='20' viewBox='0 0 10 20'>" +
    "<rect x='-10' y='0' width='20' height='20'></rect></svg>" +
    "</body></html>",
  )
  let mut clipped : Option[html::Node] = None
  let mut unclipped : Option[html::Node] = None
  let stack = [doc]
  while stack.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.tag == "svg" {
      if n.attr("id").unwrap_or("") == "clipped" { clipped = Some(n) }
      if n.attr("id").unwrap_or("") == "unclipped" { unclipped = Some(n) }
    }
    for ch in n.children { stack.push(ch) }
  }
  match clipped {
    Some(cn) => debug_assert(svg_overflow_viewbox(cn).is_none(), "clipped-away shaft outside <clipPath> must not expand overflow viewBox")
    None => debug_assert(false, "clipped svg missing")
  }
  match unclipped {
    Some(un) => match svg_overflow_viewbox(un) {
      Some((_, _, vw, vh, ex0, _, ew, _)) => {
        debug_assert(vw == 10.0 && vh == 20.0 && ex0 < -9.0 && ew > 19.0, "unclipped overflow shape must expand viewBox")
      }
      None => debug_assert(false, "unclipped overflow shape must return expanded viewBox")
    }
    None => debug_assert(false, "unclipped svg missing")
  }
  html::cut(doc)
}

test "Batch 14: W3C CSS Flexbox 1 §9.9.1 shrinkable row flex item with min-width:0 or overflow-x:hidden caps min-content contribution" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='outer' style='display:flex;width:600px'>" +
    "<div id='search' style='display:flex;flex:1 1 0px;padding:0 24px'>" +
    "<div id='twocol' style='display:flex;flex:1 1 0px;min-width:0'>" +
    "<div id='primary' style='flex:1 1 auto;min-width:0'>" +
    "<div style='width:950px;height:20px'></div>" +
    "</div></div></div></div>" +
    "<div id='outer2' style='display:flex;width:600px'>" +
    "<div id='ovwrap' style='display:flex;flex:1 1 0px'>" +
    "<div id='ovchild' style='flex:1 1 0px;overflow-x:hidden'>" +
    "<div style='width:900px;height:20px'></div>" +
    "</div></div></div>" +
    "<div id='outer3' style='display:flex;width:600px'>" +
    "<div id='noshrink_wrap' style='display:flex;flex:1 1 0px'>" +
    "<div id='noshrink' style='flex:0 0 auto;min-width:0'>" +
    "<div style='width:750px;height:20px'></div>" +
    "</div></div></div></body></html>",
  )
  let eng = css::Engine::new(css::Env::new(800.0, 600.0))
  let fonts = Fonts::new_portable([], [])
  match generate(doc, eng) {
    Some(root) => {
      layout(root, fonts, 800.0, 600.0)
      let mut search_w = -1.0
      let mut primary_w = -1.0
      let mut ovwrap_w = -1.0
      let mut noshrink_wrap_w = -1.0
      let stack = [root]
      while stack.pop() is Some(b) {
        match b.node {
          Some(n) => {
            let id = n.attr("id").unwrap_or("")
            if id == "search" { search_w = b.w }
            else if id == "primary" { primary_w = b.w }
            else if id == "ovwrap" { ovwrap_w = b.w }
            else if id == "noshrink_wrap" { noshrink_wrap_w = b.w }
          }
          None => ()
        }
        for ch in b.children { stack.push(ch) }
      }
      debug_assert((search_w - 600.0).abs() < 1.0, "nested flex item with min-width:0 shrinkable descendant must fit 600px outer flex, got " + search_w.to_string())
      debug_assert((primary_w - 552.0).abs() < 1.0, "primary column must shrink to 600 - 48 = 552px, got " + primary_w.to_string())
      debug_assert((ovwrap_w - 600.0).abs() < 1.0, "overflow-x:hidden shrinkable child must cap min-content contribution to 600px, got " + ovwrap_w.to_string())
      debug_assert((noshrink_wrap_w - 750.0).abs() < 1.0, "flex-shrink:0 item must NOT shrink its min-content contribution below 750px, got " + noshrink_wrap_w.to_string())
    }
    None => debug_assert(false, "layout root missing")
  }
  html::cut(doc)
}

test "Batch 15: CSS Flexbox 1 §9.2 + Sizing 4 §5.1 non-replaced aspect-ratio cross-to-main transfer" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    // Row flex with definite height and align-items:stretch (Bluesky feed media card pattern)
    "<div style='display:flex;flex-direction:row;align-items:stretch;width:515px;height:515px'>" +
    "<div id='sq' style='display:flex;flex-direction:column;flex:0 0 auto;aspect-ratio:1'></div>" +
    "</div>" +
    "<div style='display:flex;flex-direction:row;align-items:stretch;width:515px;height:515px'>" +
    "<div id='port' style='display:flex;flex-direction:column;flex:0 0 auto;aspect-ratio:0.6'></div>" +
    "</div>" +
    // Row flex with border-box padding + aspect-ratio
    "<div style='display:flex;flex-direction:row;align-items:stretch;width:400px;height:200px'>" +
    "<div id='bb' style='box-sizing:border-box;padding:10px;flex:0 0 auto;aspect-ratio:1.5'></div>" +
    "</div>" +
    // Row flex with explicit percentage height + aspect-ratio
    "<div style='display:flex;flex-direction:row;align-items:flex-start;width:400px;height:200px'>" +
    "<div id='pcth' style='flex:0 0 auto;height:50%;aspect-ratio:2'></div>" +
    "</div>" +
    // Column flex with definite width + stretch + aspect-ratio
    "<div style='display:flex;flex-direction:column;align-items:stretch;width:300px'>" +
    "<div id='colar' style='flex:0 0 auto;aspect-ratio:2'></div>" +
    "</div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(800.0, 1600.0))
  let fonts = Fonts::new_portable([], [])
  match generate(doc, eng) {
    Some(root) => {
      layout(root, fonts, 800.0, 1600.0)
      let mut sq_w = -1.0
      let mut port_w = -1.0
      let mut bb_w = -1.0
      let mut pcth_w = -1.0
      let mut colar_h = -1.0
      let stack = [root]
      while stack.pop() is Some(b) {
        match b.node {
          Some(n) => {
            let id = n.attr("id").unwrap_or("")
            if id == "sq" { sq_w = b.w }
            else if id == "port" { port_w = b.w }
            else if id == "bb" { bb_w = b.w }
            else if id == "pcth" { pcth_w = b.w }
            else if id == "colar" { colar_h = b.h }
          }
          None => ()
        }
        for ch in b.children { stack.push(ch) }
      }
      debug_assert((sq_w - 515.0).abs() < 1.0, "stretched row flex item with aspect-ratio:1 must transfer 515px cross height to 515px width, got " + sq_w.to_string())
      debug_assert((port_w - 309.0).abs() < 1.0, "stretched row flex item with aspect-ratio:0.6 must transfer 515*0.6=309px width, got " + port_w.to_string())
      debug_assert((bb_w - 300.0).abs() < 1.0, "border-box stretched row flex item with aspect-ratio:1.5 and height:200px must resolve to 300px border-box width, got " + bb_w.to_string())
      debug_assert((pcth_w - 200.0).abs() < 1.0, "row flex item with height:50% (100px) and aspect-ratio:2 must resolve to 200px width, got " + pcth_w.to_string())
      debug_assert((colar_h - 150.0).abs() < 1.0, "stretched column flex item with width:300px and aspect-ratio:2 must resolve to 150px height, got " + colar_h.to_string())
    }
    None => debug_assert(false, "layout root missing")
  }
  html::cut(doc)
}

test "Batch 15: CSS Sizing 4 §5.1 ratio_w resolves percentage height against definite containing block height" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='width:500px;height:200px'>" +
    "<div id='pct' style='display:inline-block;height:100%;aspect-ratio:1.5'></div>" +
    "<div id='clamped' style='display:inline-block;height:100%;max-height:100px;aspect-ratio:2'></div>" +
    "</div></body></html>",
  )
  let eng = css::Engine::new(css::Env::new(800.0, 600.0))
  let fonts = Fonts::new_portable([], [])
  match generate(doc, eng) {
    Some(root) => {
      layout(root, fonts, 800.0, 600.0)
      let mut pct_w = -1.0
      let mut clamped_w = -1.0
      let stack = [root]
      while stack.pop() is Some(b) {
        match b.node {
          Some(n) => {
            let id = n.attr("id").unwrap_or("")
            if id == "pct" { pct_w = b.w }
            else if id == "clamped" { clamped_w = b.w }
          }
          None => ()
        }
        for ch in b.children { stack.push(ch) }
      }
      debug_assert((pct_w - 300.0).abs() < 1.0, "height:100% (200px) with aspect-ratio:1.5 must resolve width to 300px, got " + pct_w.to_string())
      debug_assert((clamped_w - 200.0).abs() < 1.0, "height:100% clamped by max-height:100px with aspect-ratio:2 must resolve width to 200px, got " + clamped_w.to_string())
    }
    None => debug_assert(false, "layout root missing")
  }
  html::cut(doc)
}

test "Batch 16: CSS Grid 1 §11.5 grid-template-columns: 0fr collapses intrinsic width to automatic minimum size" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div style='display:flex;width:1000px'>" +
    "<div id='slot' style='display:grid;grid-template-columns:0fr;flex:none'>" +
    "<div style='min-width:0;overflow:hidden'><div style='width:200px;height:40px'>LOGO</div></div>" +
    "</div>" +
    "<div id='pills' style='flex:1;height:40px'>PILLS</div>" +
    "</div>" +
    "<div style='display:flex;width:600px'>" +
    "<div id='vis' style='display:grid;grid-template-columns:0fr;flex:none'>" +
    "<div style='width:120px;height:20px'></div>" +
    "</div>" +
    "</div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(1000.0, 600.0))
  let fonts = Fonts::new_portable([], [])
  match generate(doc, eng) {
    Some(root) => {
      layout(root, fonts, 1000.0, 600.0)
      let mut slot_w = -1.0
      let mut pills_x = -1.0
      let mut pills_w = -1.0
      let mut vis_w = -1.0
      let stack = [root]
      while stack.pop() is Some(b) {
        match b.node {
          Some(n) => {
            let id = n.attr("id").unwrap_or("")
            if id == "slot" { slot_w = b.w }
            else if id == "pills" { pills_x = b.x; pills_w = b.w }
            else if id == "vis" { vis_w = b.w }
          }
          None => ()
        }
        for ch in b.children { stack.push(ch) }
      }
      debug_assert(slot_w.abs() < 0.5, "0fr grid with min-width:0 overflow:hidden child must collapse to 0px, got " + slot_w.to_string())
      debug_assert(pills_x.abs() < 0.5 && (pills_w - 1000.0).abs() < 0.5, "flex:1 sibling must span full 1000px width, got x=" + pills_x.to_string() + " w=" + pills_w.to_string())
      debug_assert((vis_w - 120.0).abs() < 0.5, "0fr grid with overflow:visible fixed-width child must keep 120px automatic min size, got " + vis_w.to_string())
    }
    None => debug_assert(false, "layout root missing")
  }
  html::cut(doc)
}

test "Batch 16: CSS Grid 1 §7.6 grid-auto-rows sizes implicit rows and multi-row spans" {
  let doc = html::parse(
    "<!doctype html><html><body style='margin:0'>" +
    "<div id='mosaic' style='--mo-row:88px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:var(--mo-row);gap:16px;width:1000px'>" +
    "<div id='t2' style='--x4:1;--y4:1;--w4:1;--h4:2;grid-column:var(--x4)/span var(--w4);grid-row:var(--y4)/span var(--h4);display:flex;flex-direction:column'>" +
    "<div style='height:20px'>H</div><div id='body2' style='flex:1 1 0;min-height:0;overflow:hidden'>Note</div><div style='height:20px'>F</div>" +
    "</div>" +
    "<div id='t3' style='grid-column:2/span 1;grid-row:1/span 3'></div>" +
    "</div>" +
    "<div id='cyc' style='display:grid;grid-template-columns:100px;grid-auto-rows:40px 60px'>" +
    "<div id='c0'></div><div id='c1'></div><div id='c2'></div>" +
    "</div>" +
    "</body></html>",
  )
  let eng = css::Engine::new(css::Env::new(1000.0, 800.0))
  let fonts = Fonts::new_portable([], [])
  match generate(doc, eng) {
    Some(root) => {
      layout(root, fonts, 1000.0, 800.0)
      let mut t2_h = -1.0
      let mut body2_h = -1.0
      let mut t3_h = -1.0
      let mut c0_h = -1.0
      let mut c1_h = -1.0
      let mut c2_h = -1.0
      let stack = [root]
      while stack.pop() is Some(b) {
        match b.node {
          Some(n) => {
            let id = n.attr("id").unwrap_or("")
            if id == "t2" { t2_h = b.h }
            else if id == "body2" { body2_h = b.h }
            else if id == "t3" { t3_h = b.h }
            else if id == "c0" { c0_h = b.h }
            else if id == "c1" { c1_h = b.h }
            else if id == "c2" { c2_h = b.h }
          }
          None => ()
        }
        for ch in b.children { stack.push(ch) }
      }
      debug_assert((t2_h - 192.0).abs() < 0.5, "span 2 of 88px grid-auto-rows + 16px gap must be 192px, got " + t2_h.to_string())
      debug_assert((body2_h - 152.0).abs() < 0.5, "flex:1 1 0 body inside 192px card must receive 152px height, got " + body2_h.to_string())
      debug_assert((t3_h - 296.0).abs() < 0.5, "span 3 of 88px grid-auto-rows + 32px gaps must be 296px, got " + t3_h.to_string())
      debug_assert((c0_h - 40.0).abs() < 0.5 && (c1_h - 60.0).abs() < 0.5 && (c2_h - 40.0).abs() < 0.5, "cycling grid-auto-rows: 40px 60px must produce 40/60/40, got " + c0_h.to_string() + "/" + c1_h.to_string() + "/" + c2_h.to_string())
    }
    None => debug_assert(false, "layout root missing")
  }
  html::cut(doc)
}

///|
fn w8_set_class(engine : css::Engine, reuse : Reuse, n : html::Node, v : String) -> Unit {
  engine.forget(n, false, Some(("class", v)), None, false)
  let mut i = 0
  while i < n.attrs.length() {
    if n.attrs[i].name == "class" { n.attrs[i].value = v }
    i += 1
  }
  reuse.changed(n)
}

///|
/// Each scroll size of `ids` after laying `html` out, changing `id`'s class to `cls` and laying it out again with
/// reuse; and as laying the changed page out whole finds them.
fn w8_scroll_sizes_after(html : String, sheet : String, ids : Array[String], id : String, cls : String) -> (Array[Double], Array[Double]) {
  let doc = html::parse(html)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let reuse = Reuse::new()
  let r0 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout(r0, fonts, 400.0, 300.0)
  // the sizes asked once, so each box below keeps the extents it found
  for i in ids { let _ = box_scroll_sizes(test_unwrap(find_by_id(r0, i))) }
  let target = match test_unwrap(find_by_id(r0, id)).node { Some(n) => n None => panic() }
  w8_set_class(engine, reuse, target, cls)
  let r1 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  assert(reuse.taken_count() > 0)
  reuse.fresh()
  layout(r1, fonts, 400.0, 300.0)
  let inc : Array[Double] = []
  for i in ids {
    let (_, _, sw, sh) = box_scroll_sizes(test_unwrap(find_by_id(r1, i)))
    inc.push(sw)
    inc.push(sh)
  }
  let engine2 = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine2.add_sheet(sheet)
  let r2 = test_unwrap(generate(doc, engine2))
  layout(r2, fonts, 400.0, 300.0)
  let whole : Array[Double] = []
  for i in ids {
    let (_, _, sw, sh) = box_scroll_sizes(test_unwrap(find_by_id(r2, i)))
    whole.push(sw)
    whole.push(sh)
  }
  html::cut(doc)
  (inc, whole)
}

///|
test "Wave 8: scroll extents of a subtree whose abspos boxes are placed inside it are kept, and found again when one is placed outside it" {
  let sheet = "body{margin:0} .sc{overflow:auto;width:200px;height:100px} .rel{position:relative;width:50px;height:20px} " +
  ".abs{position:absolute;left:10px;top:300px;width:20px;height:20px} .pad{height:10px} .tall{height:70px} " +
  ".outer2{position:relative;width:300px} .low{position:absolute;bottom:0;left:250px;width:10px;height:10px}"
  // held inside: the abspos box's containing block (.rel) is in the subtree, which moves down whole when .pad grows
  let html1 = "<!doctype html><html><body><div class=sc id=sc><div class=pad id=pad></div><div id=w><div class=rel id=rel><div class=abs></div></div></div></div></body></html>"
  let (inc1, whole1) = w8_scroll_sizes_after(html1, sheet, ["sc", "w", "rel"], "pad", "pad tall")
  for k, v in inc1 {
    debug_assert((v - whole1[k]).abs() < 0.001, "held abspos: scroll size " + k.to_string() + " " + v.to_string() + " vs whole " + whole1[k].to_string())
  }
  debug_assert((whole1[1] - 390.0).abs() < 0.001, "the scroller reaches the abspos box 70+300+20 down, got " + whole1[1].to_string())
  // placed outside: the abspos box's containing block (.outer2) is above the scroller, and its bottom moves down when
  // the box after the scroller grows, with nothing in the scroller laid out again
  let html2 = "<!doctype html><html><body><div class=outer2 id=outer><div class=sc id=sc><div id=w><div class=low></div></div></div><div class=pad id=pad></div></div></body></html>"
  let (inc2, whole2) = w8_scroll_sizes_after(html2, sheet, ["sc", "w"], "pad", "pad tall")
  for k, v in inc2 {
    debug_assert((v - whole2[k]).abs() < 0.001, "escaping abspos: scroll size " + k.to_string() + " " + v.to_string() + " vs whole " + whole2[k].to_string())
  }
}

///|
test "Wave 8: edges without percentages hold at any containing block width, percentage and calc() edges do not" {
  let doc = html::parse("<!doctype html><html><body><div class=px></div><div class=pct></div><div class=calc></div></body></html>")
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} .px{margin-left:12px;padding-top:2em;border-left:3px solid} .pct{padding-left:10%;margin-top:4px} .calc{margin-right:calc(10% + 2px)}",
  )
  let root = test_unwrap(generate(doc, engine))
  let body = doc.children[1].children[1]
  let bpx = test_unwrap(box_of(root, body.children[0]))
  let bpct = test_unwrap(box_of(root, body.children[1]))
  let bcalc = test_unwrap(box_of(root, body.children[2]))
  set_edges(bpx, 800.0)
  debug_assert(bpx.edges_free && bpx.ml == 12.0 && bpx.bl == 3.0 && bpx.pt == 32.0, "px/em edges need no width")
  bpx.ml = 999.0
  set_edges(bpx, 300.0)
  debug_assert(bpx.ml == 12.0 && bpx.pt == 32.0 && bpx.edges_cbw == 800.0, "px edges taken as kept at another width")
  set_edges(bpct, 800.0)
  debug_assert(!bpct.edges_free && bpct.pl == 80.0 && bpct.mt == 4.0, "10% of 800")
  set_edges(bpct, 300.0)
  debug_assert(bpct.pl == 30.0 && bpct.edges_cbw == 300.0, "10% of 300 found again")
  set_edges(bcalc, 800.0)
  debug_assert(!bcalc.edges_free && bcalc.mr == 82.0, "calc(10% + 2px) of 800")
  set_edges(bcalc, 400.0)
  debug_assert(bcalc.mr == 42.0, "calc(10% + 2px) of 400 found again")
  html::cut(doc)
}

///|
test "Wave 8: column flex baseline items share one line edge; row flex baseline and alignment from each item's align-self" {
  let doc = html::parse(
    "<!doctype html><html><body><div id=col><div id=a>a</div><div id=b>bb</div><div id=c>c</div><div id=d>d</div></div>" +
    "<div id=row><div id=e>e</div><div id=f>f</div><div id=g>g</div></div></body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(
    "body{margin:0} #col{display:flex;flex-direction:column;align-items:baseline;width:300px} #a{margin-left:5px;width:20px;height:10px} " +
    "#b{margin-left:30px;width:40px;height:10px} #c{align-self:flex-end;width:10px;height:10px} #d{align-self:last baseline;margin-right:7px;width:15px;height:10px} " +
    "#row{display:flex;align-items:center;height:60px} #e{height:20px;width:10px} #f{align-self:flex-start;height:20px;width:10px} #g{align-self:stretch;width:10px}",
  )
  let root = test_unwrap(generate(doc, engine))
  layout(root, Fonts::new_portable([], []), 800.0, 600.0)
  let x = fn(id : String) -> Double { test_unwrap(find_by_id(root, id)).x }
  let y = fn(id : String) -> Double { test_unwrap(find_by_id(root, id)).y }
  let h = fn(id : String) -> Double { test_unwrap(find_by_id(root, id)).h }
  // first-baseline items in a column line up at the largest start margin
  debug_assert(x("a") == 30.0 && x("b") == 30.0, "baseline items at x 30, got " + x("a").to_string() + "/" + x("b").to_string())
  debug_assert(x("c") == 290.0, "flex-end item at the far edge, got " + x("c").to_string())
  debug_assert(x("d") == 278.0, "last-baseline item against the end edge less its margin, got " + x("d").to_string())
  debug_assert(y("a") == 0.0 && y("b") == 10.0 && y("c") == 20.0 && y("d") == 30.0, "column items one below another")
  debug_assert(y("e") == 60.0 && y("f") == 40.0 && h("g") == 60.0, "row: center, flex-start and stretch, got " + y("e").to_string() + "/" + y("f").to_string() + "/" + h("g").to_string())
  html::cut(doc)
}

///|
/// `ids`' boxes (x, y, w, h) after laying `html` out, changing `id`'s class to `cls` and laying it out again with
/// reuse; the same as laying the changed page out whole finds them; and how many boxes the second layout laid out.
fn w9_after_change(html : String, sheet : String, ids : Array[String], id : String, cls : String) -> (Array[Double], Array[Double], Int) {
  let doc = html::parse(html)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let reuse = Reuse::new()
  let r0 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout(r0, fonts, 400.0, 300.0)
  let target = match test_unwrap(find_by_id(r0, id)).node { Some(n) => n None => panic() }
  w8_set_class(engine, reuse, target, cls)
  let r1 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  let laid0 = work_counts[0]
  layout(r1, fonts, 400.0, 300.0)
  let laid = work_counts[0] - laid0
  let geo = fn(r : Box) -> Array[Double] {
    let out : Array[Double] = []
    for i in ids {
      let b = test_unwrap(find_by_id(r, i))
      out.push(b.x)
      out.push(b.y)
      out.push(b.w)
      out.push(b.h)
    }
    out
  }
  let inc = geo(r1)
  let engine2 = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine2.add_sheet(sheet)
  let r2 = test_unwrap(generate(doc, engine2))
  layout(r2, fonts, 400.0, 300.0)
  let whole = geo(r2)
  html::cut(doc)
  (inc, whole, laid)
}

///|
fn w9_same(what : String, inc : Array[Double], whole : Array[Double]) -> Unit {
  debug_assert(inc.length() == whole.length(), what + ": as many boxes")
  for k, v in inc {
    debug_assert((v - whole[k]).abs() < 0.001, what + ": value " + k.to_string() + " " + v.to_string() + " vs whole " + whole[k].to_string())
  }
}

///|
test "Wave 9: a column flex item whose specified height is its base size is laid out once when its container has no definite height" {
  let sheet = "body{margin:0} #col{display:flex;flex-direction:column;width:200px} #lab{display:flex;flex-wrap:wrap;height:32px} " +
  "#m{height:20px} .p{padding-left:3px} #col2{display:flex;flex-direction:column;width:100px} #a2{height:50px} " +
  "#b2{height:200px;max-height:100px}"
  let html = "<!doctype html><html><body><div id=col><div id=lab><span id=k>k</span><span id=k2>k2</span></div><div id=m></div></div>" +
  "<div id=col2><div id=a2><span id=t>t</span></div><div id=b2></div></div></body></html>"
  let ids = ["col", "lab", "k", "k2", "m", "col2", "a2", "b2"]
  let (inc, whole, laid) = w9_after_change(html, sheet, ids, "k", "p")
  // html, body, #col, #lab and the <span> laid out once each: #lab (whose content height with no height given its
  // layout does not note, its line able to wrap) is no longer laid out with no height given only to find a minimum
  // that cannot be reached in a column whose main size is the sum of its items' (it was laid out 3 times)
  debug_assert(laid <= 6, "boxes laid out after the change: " + laid.to_string())
  w9_same("lazy minimum", inc, whole)
  // #col: 32 + 20; #col2: #b2 at its max-height (its hypothetical size, not its base size), #a2 at its height
  debug_assert(whole[3] == 52.0 && whole[7] == 32.0 && whole[19] == 20.0, "col 52, lab 32, m 20")
  debug_assert(
    whole[23] == 150.0 && whole[27] == 50.0 && whole[31] == 100.0 && whole[29] - whole[25] == 50.0,
    "col2 150, a2 50, b2 100 below a2: " + whole[23].to_string() + "/" + whole[27].to_string() + "/" + whole[31].to_string(),
  )
  // the same with #a2's minimum needed by its line (#b2 at a size other than its base size) after #t changes
  let (inc2, whole2, _) = w9_after_change(html, sheet, ids, "t", "p")
  w9_same("minimum taken for the line", inc2, whole2)
}

///|
test "Wave 9: a flex item's content height kept from the layout at its specified height, and not where that height reaches its children" {
  let sheet = "body{margin:0} #page{display:flex;flex-direction:column;height:300px;width:300px} " +
  "#nav{display:flex;height:40px} #row{display:flex} #ncol{display:flex;flex-direction:column;height:30px} " +
  "#c1{height:10px} #c2{height:12px} #blk{height:24px} .p{padding-left:3px}"
  let html = "<!doctype html><html><body><div id=page><nav id=nav><div id=row><span id=x>x</span></div></nav>" +
  "<div id=ncol><div id=c1><span id=y>y</span></div><div id=c2></div></div><div id=blk><span id=z>z</span></div></div></body></html>"
  let ids = ["page", "nav", "row", "x", "ncol", "c1", "c2", "blk", "z"]
  for t in ["x", "y", "z"] {
    let (inc, whole, laid) = w9_after_change(html, sheet, ids, t, "p")
    // each box on the way down laid out once: html, body, #page, the item, what holds the change, the change
    debug_assert(laid <= 6, "boxes laid out after changing " + t + ": " + laid.to_string())
    w9_same("kept content height, " + t, inc, whole)
  }
  // a percentage height below a flex item reaches it: its content height with no height given (the percentage taken
  // as auto then) is not the one its layout at 40px found (its child 100% of that), and its minimum in a container
  // too short for both items is that content height, as it is with the child's height auto
  let shrink = "body{margin:0} #page{display:flex;flex-direction:column;height:50px;width:300px} " +
  "#nav{display:flex;height:40px} #o{height:40px} #pc{height:100%} #pa{height:auto} .p{padding-left:3px}"
  let (inc_pct, whole_pct, _) = w9_after_change(
    "<!doctype html><html><body><div id=page><nav id=nav><div id=pc><span id=x>x</span></div></nav><div id=o></div></div></body></html>",
    shrink,
    ["nav", "pc", "o"],
    "x",
    "p",
  )
  w9_same("percentage height below", inc_pct, whole_pct)
  let (_, whole_auto, _) = w9_after_change(
    "<!doctype html><html><body><div id=page><nav id=nav><div id=pa><span id=x>x</span></div></nav><div id=o></div></div></body></html>",
    shrink,
    ["nav", "pa", "o"],
    "x",
    "p",
  )
  debug_assert(whole_pct[3] == whole_auto[3] && whole_pct[3] < 40.0, "nav shrinks to its content: " + whole_pct[3].to_string() + " vs " + whole_auto[3].to_string())
  debug_assert(whole_pct[11] == whole_auto[11], "o alike: " + whole_pct[11].to_string() + " vs " + whole_auto[11].to_string())
}

test "Batch 18: CSS Transforms 2 §2.1 (translate/rotate/scale) & CSS Animations 1 §4.2 (@keyframes transform) establish containing block" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<div class='pad'></div>" +
    "<div id='tr' class='box tr'><div id='tr_abs' class='abs'></div></div>" +
    "<div id='ro' class='box ro'><div id='ro_abs' class='abs'></div></div>" +
    "<div id='sc' class='box sc'><div id='sc_abs' class='abs'></div></div>" +
    "<ul id='anim' class='box anim'><li class='item'><div id='anim_abs' class='abs'></div></li></ul>" +
    "<div id='idle' class='box idle'><div id='idle_abs' class='abs'></div></div>" +
    "</body></html>",
  )
  let sheet = "body { margin: 0; } .pad { height: 200px; } .box { display: flex; width: 300px; height: 80px; margin: 0; padding: 0; } " +
  ".tr { translate: 10px 0; } .ro { rotate: 5deg; } .sc { scale: 1.1; } " +
  "@keyframes scroll-x { to { transform: translateX(-50%); } } " +
  ".anim { animation: scroll-x 180s linear infinite; } " +
  ".idle { animation: scroll-x 0s linear; } " +
  ".abs { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }"
  let engine = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout(root, fonts, 800.0, 600.0)
  let b_tr = test_unwrap(find_by_id(root, "tr"))
  let b_tr_abs = test_unwrap(find_by_id(root, "tr_abs"))
  let b_ro = test_unwrap(find_by_id(root, "ro"))
  let b_ro_abs = test_unwrap(find_by_id(root, "ro_abs"))
  let b_sc = test_unwrap(find_by_id(root, "sc"))
  let b_sc_abs = test_unwrap(find_by_id(root, "sc_abs"))
  let b_anim = test_unwrap(find_by_id(root, "anim"))
  let b_anim_abs = test_unwrap(find_by_id(root, "anim_abs"))
  let b_idle = test_unwrap(find_by_id(root, "idle"))
  let b_idle_abs = test_unwrap(find_by_id(root, "idle_abs"))
  debug_assert(holds_fixed(b_tr) && b_tr_abs.y == b_tr.y && b_tr_abs.w == 300.0, "translate must trap abspos descendant")
  debug_assert(holds_fixed(b_ro) && b_ro_abs.y == b_ro.y && b_ro_abs.w == 300.0, "rotate must trap abspos descendant")
  debug_assert(holds_fixed(b_sc) && b_sc_abs.y == b_sc.y && b_sc_abs.w == 300.0, "scale must trap abspos descendant")
  debug_assert(holds_fixed(b_anim) && b_anim_abs.y == b_anim.y && b_anim_abs.w == 300.0 && b_anim_abs.h == 80.0, "active @keyframes transform must trap abspos descendant inside ul")
  debug_assert(!holds_fixed(b_idle) && b_idle_abs.y == 0.0 && b_idle_abs.w == 800.0, "0s animation without fill-mode must not create containing block")
  html::cut(doc)
}

test "Batch 18: CSS Grid 1 §7.3.1 & §8.3 implicitly-named area (<ident>-start / <ident>-end) with auto end line" {
  let doc = html::parse(
    "<!doctype html><html><body><div id='g'><div id='full'></div><div id='content'></div></div></body></html>",
  )
  let sheet = "body { margin: 0; } " +
  "#g { display: grid; width: 400px; grid-template-columns: [full-start] 100px [content-start] 200px [content-end] 100px [full-end]; } " +
  "#full { grid-column-start: full; grid-column-end: auto; height: 20px; } " +
  "#content { grid-column-start: content; grid-column-end: auto; height: 20px; }"
  let engine = css::Engine::new(css::Env::{ width: 600.0, height: 400.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let root = test_unwrap(generate(doc, engine))
  layout(root, fonts, 600.0, 400.0)
  let b_full = test_unwrap(find_by_id(root, "full"))
  let b_content = test_unwrap(find_by_id(root, "content"))
  debug_assert(b_full.x == 0.0 && b_full.w == 400.0, "grid-column-start: full with auto end must span [full-start]..[full-end] (400px), got x=" + b_full.x.to_string() + " w=" + b_full.w.to_string())
  debug_assert(b_content.x == 100.0 && b_content.w == 200.0, "grid-column-start: content with auto end must span [content-start]..[content-end] (x=100, w=200), got x=" + b_content.x.to_string() + " w=" + b_content.w.to_string())
  html::cut(doc)
}

///|
/// Every box under `b` (its id, tag or text) with its x, y, w and h, and its fragments' x and y, in tree order.
fn w10_boxes(b : Box, out : Array[String]) -> Unit {
  let name = match b.node {
    Some(n) => match n.attr("id") { Some(v) => v None => n.tag }
    None => match b.kind { TextRun(s) => "text:" + s _ => "anon" }
  }
  out.push(name + " " + b.x.to_string() + "," + b.y.to_string() + " " + b.w.to_string() + "x" + b.h.to_string())
  for f in b.frags { out.push("  frag " + f.text + " " + f.x.to_string() + "," + f.y.to_string()) }
  for c in b.children { w10_boxes(c, out) }
}

///|
/// Every box of `html` after laying it out, changing `id`'s class to `cls` and laying it out again with reuse, against
/// laying the changed page out whole: the lines that differ (empty when every box and fragment lands alike).
fn w10_diff_after_change(html : String, sheet : String, id : String, cls : String) -> Array[String] {
  let doc = html::parse(html)
  let engine = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = Fonts::new_portable([], [])
  let reuse = Reuse::new()
  let r0 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout(r0, fonts, 400.0, 300.0)
  let target = match test_unwrap(find_by_id(r0, id)).node { Some(n) => n None => panic() }
  w8_set_class(engine, reuse, target, cls)
  let r1 = test_unwrap(generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout(r1, fonts, 400.0, 300.0)
  let inc : Array[String] = []
  w10_boxes(r1, inc)
  let engine2 = css::Engine::new(css::Env::{ width: 400.0, height: 300.0, media: "screen", dpr: 1.0 })
  engine2.add_sheet(sheet)
  let r2 = test_unwrap(generate(doc, engine2))
  layout(r2, fonts, 400.0, 300.0)
  let whole : Array[String] = []
  w10_boxes(r2, whole)
  html::cut(doc)
  let bad : Array[String] = []
  if inc.length() != whole.length() { bad.push("boxes: " + inc.length().to_string() + " vs " + whole.length().to_string()) }
  for k, v in inc {
    if k < whole.length() && v != whole[k] { bad.push(v + " | whole: " + whole[k]) }
  }
  bad
}

///|
test "Wave 10: inline boxes of a flex item laid out again at 0, 0 land where a whole layout puts them" {
  // #blk's height reaches its child (100%), so its automatic minimum lays it out at 0, 0 with no height given (and
  // again at 40px) before it is moved to its line: its <span> and the span's text run, kept from the first layout at
  // y 16, were left there by laying the line out again and moved by 16 once more (32; whole: 16)
  let sheet = "body{margin:0} #page{display:flex;flex-direction:column;height:300px;width:300px} .p{padding-left:3px} " +
  ".h{height:20px} .r{position:relative;top:5px;left:2px}"
  let pages = [
    "<div id=a><span id=x>x</span></div><div id=blk style='height:40px'><div style='height:100%'></div><span id=z>z</span></div>",
    "<div id=a><span id=x>x</span></div><div id=blk style='height:40px'><div style='height:50%'>q</div><span id=z>z<b>w<i></i></b></span></div>",
    "<div id=a><span id=x>x</span></div><div id=blk><div style='height:100%'></div>t<span id=z class=r>z<b class=r>w<i id=q>q</i></b></span><br></div>",
    "<div id=a><span id=x>x</span></div><div id=row style='display:flex;height:60px'><div id=blk style='height:40px'><div style='height:100%'></div><span id=z>z<b>w</b></span></div><div>s<span>t<i>u</i></span></div></div>",
    "<div id=a><span id=x>x</span></div><div style='display:flex;flex-direction:column;height:80px'><div id=blk style='height:40px'><div style='height:100%'></div><span id=z>z<b>w</b></span></div></div><div style='display:flex'><span id=y>y<b>v</b></span><div>k<span>t<i>u</i></span></div></div>",
    "<div id=a><span id=x>x</span></div><div style='display:grid;height:80px'><div id=blk style='height:40px'><div style='height:100%'></div><span id=z>z<b>w</b></span></div><div>k<span>t<i>u</i></span></div></div>",
  ]
  for i, body in pages {
    let html = "<!doctype html><html><body><div id=page>" + body + "</div></body></html>"
    for t in (if i == 2 { ["a", "x", "q", "z"] } else { ["a", "x"] }) {
      for cls in ["p", "h"] {
        let bad = w10_diff_after_change(html, sheet, t, cls)
        let mut msg = ""
        for l in bad { msg = msg + l + "; " }
        debug_assert(bad.length() == 0, "page " + i.to_string() + ", " + t + "." + cls + ": " + msg)
      }
    }
  }
}

///|
test "Batch 19: CSS 2.1 §8.3.1 empty min-height block sets parent f.first and does not double-shift with negative margin-bottom" {
  let html_src =
  "<!doctype html><html><body style='margin:0'>" +
  "<header style='height:64px'></header>" +
  "<main id='m'>" +
  "<div id='k0'></div>" +
  "<div id='k4' style='min-height:64px;margin-bottom:-64px'><div id='k4c' style='min-height:64px'></div></div>" +
  "<div id='hero' style='height:200px'>Hero</div>" +
  "</main></body></html>"
  let doc = html::parse(html_src)
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let main_el = body.children[1]
  let k4_el = main_el.children[1]
  let k4c_el = k4_el.children[0]
  let hero_el = main_el.children[2]
  match (box_of(root, main_el), box_of(root, k4_el), box_of(root, k4c_el), box_of(root, hero_el)) {
    (Some(m), Some(k4), Some(k4c), Some(hero)) => {
      debug_assert(m.y == 64.0, "main.y must be 64, got " + m.y.to_string())
      debug_assert(k4.y == 64.0, "k4.y must be 64, got " + k4.y.to_string())
      debug_assert(k4c.y == 64.0, "k4c.y must be 64, got " + k4c.y.to_string())
      debug_assert(hero.y == 64.0, "hero.y must be 64, got " + hero.y.to_string())
    }
    _ => debug_assert(false, "expected boxes for m, k4, k4c, hero")
  }
  html::cut(doc)
}

///|
test "Batch 19: CSS Overflow 3 §3.2 viewport-propagated body overflow does not clip html scrollHeight" {
  let html_src =
  "<!doctype html><html><body style='margin:0;overflow-y:scroll'>" +
  "<div id='app' style='position:absolute;top:0;left:0;width:1280px;height:2400px'></div>" +
  "</body></html>"
  let doc = html::parse(html_src)
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let html_el = doc.children[1]
  match scroll_sizes(root, html_el) {
    Some((_, _, _, sh)) => debug_assert(sh >= 2400.0, "html scrollHeight must include abs child in body, got " + sh.to_string())
    None => debug_assert(false, "expected scroll_sizes for html")
  }
  html::cut(doc)
}

///|
test "relative top:50% resolves inside fixed height:100% wrapper" {
  let html_src =
  "<!doctype html><html><body style='margin:0'>" +
  "<div style='position:fixed;top:0;left:0;width:100%;height:100%'>" +
  "<div id='dlg' style='position:relative;top:50%;left:50%;width:400px;height:200px'></div>" +
  "</div></body></html>"
  let doc = html::parse(html_src)
  let engine = css::Engine::new(css::Env::{ width: 1280.0, height: 800.0, media: "screen", dpr: 1.0 })
  let root = test_unwrap(generate(doc, engine))
  let fonts = Fonts::new_portable([], [])
  layout_with_scrollbar(root, fonts, 1280.0, 800.0, 0.0)
  let body = doc.children[1].children[1]
  let dlg = body.children[0].children[0]
  match box_of(root, dlg) {
    Some(b) => {
      debug_assert((b.x - 640.0).abs() < 0.5, "dlg.x expected 640, got " + b.x.to_string())
      debug_assert((b.y - 400.0).abs() < 0.5, "dlg.y expected 400, got " + b.y.to_string())
    }
    None => debug_assert(false, "expected box for dlg")
  }
  html::cut(doc)
}

test "web font: a @font-face file not here yet is asked again later, one that came and failed is remembered" {
  let fonts = Fonts::new_portable([], [])
  fonts.synth_missing = true
  let have : Array[Bytes] = []
  let asked : Array[Int] = [0]
  fonts.set_web(
    [css::FontFace::{ family: "suisse site", src: ["u:a"], weight_lo: 100, weight_hi: 450, italic: false, size_adjust: 1.0, ranges: [] }],
    fn(_u : String) -> Option[Bytes] {
      asked[0] = asked[0] + 1
      if have.length() > 0 { Some(have[0]) } else { None }
    },
    Map::new(),
  )
  let doc = html::parse("<p style='font-family:\"Suisse Site\"'>x</p>")
  let e = css::Engine::new(css::Env::{ width: 800.0, height: 600.0, media: "screen", dpr: 1.0 })
  let st = match e.style_of(doc.children[0].children[1].children[0], None) { Some(s) => s None => panic("no style") }
  // (no face at all and no bundled fonts: the web face is still asked for, not skipped for synthetic metrics)
  let _ = fonts.pick(st)
  debug_assert(asked[0] > 0, "pick must ask for the @font-face file even with an empty font database")
  debug_assert(fonts.by_url.get("u:a").is_none(), "a file not here yet must not be remembered as missing")
  debug_assert(fonts.web_face("u:a", 1.0) == -1, "still missing")
  let n = asked[0]
  let _ = fonts.web_face("u:a", 1.0)
  debug_assert(asked[0] == n + 1, "a missing file is asked for again")
  have.push(Bytes::new(16))
  debug_assert(fonts.web_face("u:a", 1.0) == -1, "bytes that are no font load nothing")
  debug_assert(fonts.by_url.get("u:a") == Some(-1), "a file that came and failed is remembered")
  let m = asked[0]
  let _ = fonts.web_face("u:a", 1.0)
  debug_assert(asked[0] == m, "and not asked again")
}
