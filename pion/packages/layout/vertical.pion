///| Vertical writing modes (`vertical-rl`, `vertical-lr`, `sideways-*`).
///| 1:1 port of `client/src/layout/vertical.mbt`.

import "css"

fn vertical_mode(s : css::Style) -> Int {
  s.flow_flags_val() & 3
}

fn turn_styles(b : Box, rl : Bool, saved : Array[(Box, css::Style, Kind)]) -> Unit {
  saved.push((b, b.style, b.kind))
  b.style = b.style.transposed(rl)
  match b.kind {
    Replaced(w, h) => b.kind = if w < 0.0 { Replaced(w, 1.0 / h) } else { Replaced(h, w) }
    _ => ()
  }
  b.max_c = -1.0
  b.min_c = -1.0
  b.max_c_inner = -1.0
  b.min_c_inner = -1.0
  b.abs_from = no_edges
  let mut i = 0
  while i < b.children.length() {
    turn_styles(b.children[i], rl, saved)
    i += 1
  }
}

fn turn_back(b : Box, size : Double, rl : Bool) -> Unit {
  let (x0, y0, w0, h0) = (b.x, b.y, b.w, b.h)
  b.x = if rl { size - y0 - h0 } else { y0 }
  b.y = x0
  b.w = h0
  b.h = w0
  let (mt, mr, mb, ml) = (b.mt, b.mr, b.mb, b.ml)
  let (bt, br, bb, bl) = (b.bt, b.br, b.bb, b.bl)
  let (pt, pr, pb, pl) = (b.pt, b.pr, b.pb, b.pl)
  b.mt = ml
  b.mb = mr
  b.bt = bl
  b.bb = br
  b.pt = pl
  b.pb = pr
  if rl {
    b.mr = mt
    b.ml = mb
    b.br = bt
    b.bl = bb
    b.pr = pt
    b.pl = pb
  } else {
    b.ml = mt
    b.mr = mb
    b.bl = bt
    b.br = bb
    b.pl = pt
    b.pr = pb
  }
  if b.has_frag {
    let (a, c, d, e) = (b.min_x, b.min_y, b.max_x, b.max_y)
    b.min_y = a
    b.max_y = d
    if rl {
      b.min_x = size - e
      b.max_x = size - c
    } else {
      b.min_x = c
      b.max_x = e
    }
  }
  let mut fi = 0
  while fi < b.frags.length() {
    let f = b.frags[fi]
    let (fx, fy) = (f.x, f.y)
    f.x = if rl { size - fy - f.ascent } else { fy }
    f.y = fx
    fi += 1
  }
  b.max_c = -1.0
  b.min_c = -1.0
  b.max_c_inner = -1.0
  b.min_c_inner = -1.0
  let mut i = 0
  while i < b.children.length() {
    turn_back(b.children[i], size, rl)
    i += 1
  }
}

fn Lay::layout_vertical(
  self : Lay,
  b : Box,
  inline_room : Option[Double],
  forced_w : Option[Double],
  forced_h : Option[Double],
) -> Unit {
  laid(b)
  let rl = vertical_mode(b.style) == 2
  let saved : Array[(Box, css::Style, Kind)] = []
  self.turned += 1
  turn_styles(b, rl, saved)
  let room = match inline_room { Some(r) => r None => self.vh }
  set_edges(b, room)
  let w = match forced_h {
    Some(h) => h
    None =>
    match self.said_width(b, Some(room)) {
      Some(v) => clamp_w(b, v, Some(room))
      None => {
        let avail = room - b.ml - b.mr
        clamp_w(b, dmax(self.min_content(b), dmin(self.max_content(b), avail)), Some(room))
      }
    }
  }
  let start = self.pending.length()
  self.layout_root(b, 0.0, 0.0, room, None, Some(w), forced_w)
  let inside = fn(x : Box) -> Bool {
    let mut i = 0
    while i < saved.length() {
      if saved[i].0.uid == x.uid { return true }
      i += 1
    }
    false
  }
  let mine : Array[Pending] = []
  let rest : Array[Pending] = []
  let mut k = start
  while k < self.pending.length() {
    let p = self.pending[k]
    let is_mine = match p.cb { Some(cb) => inside(cb) None => false }
    if is_mine { mine.push(p) } else { rest.push(p) }
    k += 1
  }
  while self.pending.length() > start { let _ = self.pending.pop() }
  let base = self.pending.length()
  let mut mi = 0
  while mi < mine.length() {
    mine[mi].box.placed = true
    self.push_pending(mine[mi])
    mi += 1
  }
  settle_all(b)
  self.run_abs_from(base)
  while self.pending.length() > base { let _ = self.pending.pop() }
  let mut ri = 0
  while ri < rest.length() { self.push_pending(rest[ri]); ri += 1 }
  let size = b.h
  turn_back(b, size, rl)
  let mut si = 0
  while si < saved.length() {
    let (bx, st, kd) = saved[si]
    bx.style = st
    match kd {
      Replaced(_, _) => bx.kind = kd
      _ => ()
    }
    si += 1
  }
  self.turned -= 1
}
