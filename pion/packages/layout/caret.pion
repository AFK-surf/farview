///| Caret & selection geometry over laid-out text fragments.
///| 1:1 port of `client/src/layout/caret.mbt`.

import "html"

fn text_runs(b : Box, n : html::Node, out : Array[Box]) -> Unit {
  match b.text_node {
    Some(m) => if m.uid == n.uid { out.push(b) }
    None => ()
  }
  let mut i = 0
  while i < b.children.length() {
    text_runs(b.children[i], n, out)
    i += 1
  }
}

pub fn caret_blank_unit(u : Int) -> Bool {
  u == 32 || u == 10 || u == 9 || u == 13 || u == 12
}

pub fn frag_offsets(root : Box, n : html::Node) -> Array[(TextFrag, Int)] {
  let runs : Array[Box] = []
  text_runs(root, n, runs)
  let data = n.data
  let out : Array[(TextFrag, Int)] = []
  let mut i = 0
  let mut ri = 0
  while ri < runs.length() {
    let r = runs[ri]
    let mut fi = 0
    while fi < r.frags.length() {
      let f = r.frags[fi]
      if f.text.length() > 0 && !caret_blank_unit(f.text.code_unit_at(0)) {
        while i < data.length() && caret_blank_unit(data.code_unit_at(i)) {
          i += 1
        }
      }
      out.push((f, i))
      let mut ci = 0
      while ci < f.text.length() {
        if i >= data.length() { break }
        let u = f.text.code_unit_at(ci)
        if caret_blank_unit(u) {
          while i < data.length() && caret_blank_unit(data.code_unit_at(i)) { i += 1 }
          ci += 1
        } else {
          i += 1
          ci += 1
        }
      }
      fi += 1
    }
    ri += 1
  }
  out
}

pub fn frag_units(f : TextFrag, data : String, from : Int, k : Int) -> Int {
  let mut i = from
  let mut u = 0
  let mut ci = 0
  while ci < f.text.length() {
    if i >= from + k || i >= data.length() { break }
    let cu = f.text.code_unit_at(ci)
    if caret_blank_unit(cu) {
      while i < data.length() && i < from + k && caret_blank_unit(data.code_unit_at(i)) { i += 1 }
    } else {
      i += 1
    }
    u += 1
    ci += 1
  }
  u
}

pub fn caret_in(fonts : Fonts, root : Box, n : html::Node, offset : Int) -> Option[(Double, Double, Double)] {
  let frags = frag_offsets(root, n)
  if frags.length() == 0 { return None }
  let mut pick = frags[0]
  let mut i = 0
  while i < frags.length() {
    if frags[i].1 <= offset { pick = frags[i] }
    i += 1
  }
  let (f, from) = pick
  let u0 = frag_units(f, n.data, from, offset - from)
  let u = if u0 < f.text.length() { u0 } else { f.text.length() }
  let w = fonts.width(f.font, f.size, f.text.slice(0, u))
  let m = fonts.metrics(f.font, f.size)
  Some((f.x + w, f.y + f.ascent - m.ascent, m.ascent + m.descent))
}

pub fn caret_in_element(fonts : Fonts, root : Box, e : html::Node) -> Option[(Double, Double, Double)] {
  guard box_of(root, e) is Some(b) else { return None }
  let font = fonts.pick(b.style)
  let m = fonts.metrics(font, b.style.font_size)
  let line = m.ascent + m.descent
  let top = b.y + b.bt + b.pt
  let inner = b.h - b.bt - b.bb - b.pt - b.pb
  let first = dmin(inner, line * 1.25)
  Some((b.x + b.bl + b.pl, top + dmax(first - line, 0.0) / 2.0, line))
}

pub fn scrolled_above(n : html::Node) -> (Double, Double) {
  if scrolls.is_empty() { return (0.0, 0.0) }
  let mut sx = 0.0
  let mut sy = 0.0
  let mut cur : Option[html::Node] = Some(n)
  while true {
    match cur {
      Some(e) => {
        if scrolls.contains(e.uid) {
          let (x, y) = scrolls.get_or(e.uid, (0.0, 0.0))
          sx += x
          sy += y
        }
        cur = e.parent
      }
      None => break
    }
  }
  (sx, sy)
}

pub fn edit_marks(
  fonts : Fonts,
  root : Box,
  host : html::Node,
  start : Option[(html::Node, Int)],
  end : Option[(html::Node, Int)],
) -> Array[(Double, Double, Double, Double, Bool)] {
  let out : Array[(Double, Double, Double, Double, Bool)] = []
  let point = fn(p : Option[(html::Node, Int)]) -> Option[(Double, Double, Double)] {
    match p {
      None => None
      Some((n, o)) => if n.kind == html::Kind::Text { caret_in(fonts, root, n, o) } else { caret_in_element(fonts, root, n) }
    }
  }
  let collapsed = match (start, end) {
    (Some((a, ao)), Some((z, zo))) => a.uid == z.uid && ao == zo
    _ => false
  }
  match (point(start), point(end)) {
    (Some((x1, y1, h1)), Some(_)) =>
    if collapsed {
      out.push((x1, y1, 1.0, h1, true))
    } else {
      match point(end) {
        Some((x2, y2, h2)) =>
        if (y2 - y1).abs() < h1 / 2.0 {
          out.push((dmin(x1, x2), y1, dmax((x2 - x1).abs(), 4.0), h1, false))
        } else {
          let (left, right) = match box_of(root, host) {
            Some(b) => (b.x + b.bl + b.pl, b.x + b.w - b.br - b.pr)
            None => (dmin(x1, x2), dmax(x1, x2))
          }
          out.push((x1, y1, dmax(right - x1, 4.0), h1, false))
          if y2 > y1 + h1 { out.push((left, y1 + h1, right - left, y2 - y1 - h1, false)) }
          out.push((left, y2, dmax(x2 - left, 4.0), h2, false))
        }
        None => ()
      }
    }
    (None, None) =>
    match box_of(root, host) {
      Some(b) => {
        let font = fonts.pick(b.style)
        let m = fonts.metrics(font, b.style.font_size)
        out.push((b.x + b.bl + b.pl, b.y + b.bt + b.pt, 1.0, m.ascent + m.descent, true))
      }
      None => ()
    }
    _ => ()
  }
  out
}
