///| Layout geometry memoization (`Alt` / `Geom`): saves and restores a subtree's layout across dual-input passes.
///| 1:1 port of `client/src/layout/memo.mbt` (Biased-RC cycle-safe: root slot cleared to `None` in `alt_kept`).

struct Geom {
  box : Option[Box]
  x : Double
  y : Double
  sdx : Double
  sdy : Double
  w : Double
  h : Double
  mt : Double
  mr : Double
  mb : Double
  ml : Double
  bt : Double
  br : Double
  bb : Double
  bl : Double
  pt : Double
  pr : Double
  pb : Double
  pl : Double
  baseline : Option[Double]
  last_baseline : Option[Double]
  has_frag : Bool
  min_x : Double
  min_y : Double
  max_x : Double
  max_y : Double
  frags : Array[TextFrag]
  abs_cb : Option[Box]
  collapsed : Option[(Double, Double, Double, Double)]
  placed : Bool
  tracks : Option[(Array[Double], Array[Double])]
  memo_pass : Int
  memo_key : (Double, Double, Double, Double)
  memo_size : (Double, Double)
  memo_base : Double
  memo_pending : Array[Pending]
}

struct Alt {
  key : (Double, Double, Double, Double)
  base : Double
  pending : Array[Pending]
  geoms : Array[Geom]
  quiet : Bool
  rel_applied : Bool
}

pub let work_counts : Array[Int] = [0, 0, 0, 0]

let no_frags : Array[TextFrag] = []

fn copy_frags(fs : Array[TextFrag]) -> Array[TextFrag] {
  let n = fs.length()
  if n == 0 {
    return no_frags
  }
  let out : Array[TextFrag] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let f = fs[i]
    out.push(TextFrag::{ x: f.x, y: f.y, w: f.w, text: f.text, font: f.font, size: f.size, ascent: f.ascent })
    i += 1
  }
  out
}

fn keep_layout_rec(n : Box, geoms : Array[Geom]) -> Bool {
  work_counts[2] = work_counts[2] + 1
  settle(n)
  geoms.push(Geom::{
    box: Some(n),
    x: n.x,
    y: n.y,
    sdx: n.sdx,
    sdy: n.sdy,
    w: n.w,
    h: n.h,
    mt: n.mt,
    mr: n.mr,
    mb: n.mb,
    ml: n.ml,
    bt: n.bt,
    br: n.br,
    bb: n.bb,
    bl: n.bl,
    pt: n.pt,
    pr: n.pr,
    pb: n.pb,
    pl: n.pl,
    baseline: n.baseline,
    last_baseline: n.last_baseline,
    has_frag: n.has_frag,
    min_x: n.min_x,
    min_y: n.min_y,
    max_x: n.max_x,
    max_y: n.max_y,
    frags: if n.frags.length() == 0 { no_frags } else { copy_frags(n.frags) },
    abs_cb: n.abs_cb,
    collapsed: n.collapsed,
    placed: n.placed,
    tracks: n.tracks,
    memo_pass: n.memo_pass,
    memo_key: n.memo_key,
    memo_size: n.memo_size,
    memo_base: n.memo_base,
    memo_pending: n.memo_pending,
  })
  let mut quiet = n.memo_pending.length() == 0 && n.abs_cb.is_none()
  let mut i = 0
  let cn = n.children.length()
  while i < cn {
    if !keep_layout_rec(n.children[i], geoms) {
      quiet = false
    }
    i += 1
  }
  quiet
}

fn keep_layout(b : Box, rel_applied : Bool) -> Alt {
  let init_cap = if b.children.length() > 0 { b.children.length() + 4 } else { 1 }
  let geoms : Array[Geom] = Array::with_capacity(init_cap)
  work_counts[1] = work_counts[1] + 1
  let quiet = keep_layout_rec(b, geoms)
  Alt::{ key: b.memo_key, base: b.memo_base, pending: b.memo_pending, geoms: geoms, quiet: quiet, rel_applied: rel_applied }
}

fn alt_kept(a : Option[Alt]) -> Option[Alt] {
  match a {
    Some(x) =>
    if x.quiet {
      if x.geoms.length() > 0 && x.geoms[0].box.is_some() {
        let g0 = x.geoms[0]
        x.geoms[0] = Geom::{
          box: None,
          x: g0.x, y: g0.y, sdx: g0.sdx, sdy: g0.sdy, w: g0.w, h: g0.h,
          mt: g0.mt, mr: g0.mr, mb: g0.mb, ml: g0.ml,
          bt: g0.bt, br: g0.br, bb: g0.bb, bl: g0.bl,
          pt: g0.pt, pr: g0.pr, pb: g0.pb, pl: g0.pl,
          baseline: g0.baseline, last_baseline: g0.last_baseline,
          has_frag: g0.has_frag, min_x: g0.min_x, min_y: g0.min_y, max_x: g0.max_x, max_y: g0.max_y,
          frags: g0.frags, abs_cb: g0.abs_cb, collapsed: g0.collapsed, placed: g0.placed,
          tracks: g0.tracks, memo_pass: g0.memo_pass, memo_key: g0.memo_key,
          memo_size: g0.memo_size, memo_base: g0.memo_base, memo_pending: g0.memo_pending,
        }
      }
      Some(x)
    } else {
      None
    }
    None => None
  }
}

fn put_back(a : Alt, root : Box, kept_on : Array[Box], unsettled : Array[Box]) -> Unit {
  let geoms = a.geoms
  let gn = geoms.length()
  let mut i = 0
  while i < gn {
    let g = geoms[i]
    let n = if i == 0 {
      root
    } else {
      match g.box {
        Some(bx) => bx
        None => { i += 1; continue }
      }
    }
    laid(n)
    if g.memo_pending.length() > 0 || n.memo_alt.is_some() || g.abs_cb.is_some() {
      kept_on.push(n)
    }
    n.x = g.x
    n.y = g.y
    n.sdx = 0.0
    n.sdy = 0.0
    if g.sdx != 0.0 || g.sdy != 0.0 {
      unsettled.push(n)
    }
    n.sdx = g.sdx
    n.sdy = g.sdy
    n.w = g.w
    n.h = g.h
    n.mt = g.mt
    n.mr = g.mr
    n.mb = g.mb
    n.ml = g.ml
    n.bt = g.bt
    n.br = g.br
    n.bb = g.bb
    n.bl = g.bl
    n.pt = g.pt
    n.pr = g.pr
    n.pb = g.pb
    n.pl = g.pl
    n.baseline = g.baseline
    n.last_baseline = g.last_baseline
    n.has_frag = g.has_frag
    n.tracks = g.tracks
    n.min_x = g.min_x
    n.min_y = g.min_y
    n.max_x = g.max_x
    n.max_y = g.max_y
    n.frags = if g.frags.length() == 0 { no_frags } else { copy_frags(g.frags) }
    n.abs_cb = g.abs_cb
    n.collapsed = g.collapsed
    n.placed = g.placed
    n.memo_pass = g.memo_pass
    n.memo_key = g.memo_key
    n.memo_size = g.memo_size
    n.memo_base = g.memo_base
    n.memo_pending = g.memo_pending
    i += 1
  }
}
