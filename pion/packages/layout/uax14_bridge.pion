///| Unicode 16.0.0 UAX #14 line-breaking bridge powered by `packages/unicode_linebreak`.
///| Provides DoS-bounded line break opportunity queries, streaming iteration, and
///| wrap-segment splitting for Farview inline text layout.
///| Pure Pion, zero external dependencies, zero `World`.

import "unicode_linebreak"

///| Maximum input size processed in a single full-string UAX #14 pass (2 MiB).
pub let UAX14_MAX_INPUT_BYTES : Int = 2097152

///| Maximum break opportunities collected in a single UAX #14 pass (512K opportunities).
pub let UAX14_MAX_OPPORTUNITIES : Int = 524288

///| Bounded local window radius (bytes) used when inputs exceed `UAX14_MAX_INPUT_BYTES`.
let uax14_window_bytes : Int = 4096

///| Default DoS-safe resource limits for UAX #14 line breaking in Farview.
pub fn uax14_limits() -> unicode_linebreak::LineBreakLimits {
  unicode_linebreak::LineBreakLimits::new(UAX14_MAX_INPUT_BYTES, UAX14_MAX_OPPORTUNITIES)
}

fn uax14_clamp_offset(s : String, byte_offset : Int) -> Int {
  let n = s.length()
  if byte_offset < 0 {
    0
  } else if byte_offset > n {
    n
  } else {
    byte_offset
  }
}

fn uax14_align_utf8_down(s : String, offset : Int) -> Int {
  let n = s.length()
  let mut p = uax14_clamp_offset(s, offset)
  if p >= n {
    return n
  }
  let mut back = 0
  while p > 0 && back < 3 && (s.code_unit_at(p) & 0xC0) == 0x80 {
    p = p - 1
    back = back + 1
  }
  p
}

fn uax14_align_utf8_up(s : String, offset : Int) -> Int {
  let n = s.length()
  let mut p = uax14_clamp_offset(s, offset)
  let mut fwd = 0
  while p < n && fwd < 3 && (s.code_unit_at(p) & 0xC0) == 0x80 {
    p = p + 1
    fwd = fwd + 1
  }
  p
}

fn uax14_bounded_prefix(s : String) -> String {
  if s.length() <= UAX14_MAX_INPUT_BYTES {
    s
  } else {
    let cap = uax14_align_utf8_down(s, UAX14_MAX_INPUT_BYTES)
    s.slice(0, cap)
  }
}

///| Compute all Unicode 16.0.0 UAX #14 line break opportunities for `s` with explicit
///| DoS resource limits. Returns `Err(LineBreakError::LimitExceeded)` if `s` exceeds
///| `limits.max_input_bytes` or produces more than `limits.max_opportunities`.
pub fn uax14_line_breaks_with_limits(
  s : String,
  limits : unicode_linebreak::LineBreakLimits,
) -> Result[Array[unicode_linebreak::BreakOpportunity], unicode_linebreak::LineBreakError] {
  unicode_linebreak::line_breaks_with_limits(s, limits)
}

///| Compute DoS-bounded Unicode 16.0.0 UAX #14 line break opportunities for `s`
///| (both `Mandatory` and `Allowed`).
///| Inputs exceeding `UAX14_MAX_INPUT_BYTES` are bounded to a UTF-8 aligned prefix,
///| and at most `UAX14_MAX_OPPORTUNITIES` opportunities are returned.
pub fn uax14_line_breaks(s : String) -> Array[unicode_linebreak::BreakOpportunity] {
  let n = s.length()
  if n == 0 {
    return []
  }
  let target = uax14_bounded_prefix(s)
  match unicode_linebreak::line_breaks_with_limits(target, uax14_limits()) {
    Ok(opps) => opps
    Err(_) => {
      let out : Array[unicode_linebreak::BreakOpportunity] = []
      let iter = unicode_linebreak::line_break_iter(target)
      while out.length() < UAX14_MAX_OPPORTUNITIES {
        match iter.next() {
          Some(opp) => out.push(opp)
          None => break
        }
      }
      out
    }
  }
}

///| Return the first Unicode 16.0.0 UAX #14 line break opportunity strictly after
///| `byte_offset`. Negative offsets behave as `0`; offsets at or past `s.length()`
///| return `None`. Uses a bounded local window when `s` exceeds `UAX14_MAX_INPUT_BYTES`.
pub fn uax14_next_break_after(
  s : String,
  byte_offset : Int,
) -> Option[unicode_linebreak::BreakOpportunity] {
  let n = s.length()
  if n == 0 || byte_offset >= n {
    return None
  }
  let off = if byte_offset < 0 { 0 } else { byte_offset }
  if n <= UAX14_MAX_INPUT_BYTES {
    unicode_linebreak::next_break_opportunity(s, off)
  } else {
    let win_start = uax14_align_utf8_down(
      s,
      if off > uax14_window_bytes { off - uax14_window_bytes } else { 0 },
    )
    let win_end = uax14_align_utf8_up(
      s,
      if off + uax14_window_bytes < n { off + uax14_window_bytes } else { n },
    )
    let sub = s.slice(win_start, win_end)
    let rel = off - win_start
    match unicode_linebreak::next_break_opportunity(sub, rel) {
      Some(opp) =>
      Some(unicode_linebreak::BreakOpportunity::new(win_start + opp.byte_offset, opp.kind))
      None => None
    }
  }
}

///| Return whether `byte_offset` is a valid Unicode 16.0.0 UAX #14 line break
///| opportunity in `s` (either `Allowed` or `Mandatory`).
///| Returns `false` for empty strings, offset `0` (LB2), out-of-range offsets,
///| or mid-UTF-8 continuation bytes; returns `true` at `s.length()` for non-empty `s` (LB3).
pub fn uax14_can_break_at(s : String, byte_offset : Int) -> Bool {
  let n = s.length()
  if n == 0 || byte_offset <= 0 || byte_offset > n {
    return false
  }
  if byte_offset == n {
    return true
  }
  match uax14_next_break_after(s, byte_offset - 1) {
    Some(opp) => opp.byte_offset == byte_offset
    None => false
  }
}

///| Construct a resumable O(n) worst-case streaming iterator over Unicode 16.0.0
///| UAX #14 line break opportunities in `s`.
///| Inputs exceeding `UAX14_MAX_INPUT_BYTES` are bounded to a UTF-8 aligned prefix.
pub fn uax14_iter(s : String) -> unicode_linebreak::LineBreakIter {
  unicode_linebreak::line_break_iter(uax14_bounded_prefix(s))
}

///| Split `s` into consecutive wrappable segments `(start, end, is_mandatory)` using
///| Unicode 16.0.0 UAX #14 line breaking rules (LB1-LB31):
///| - Respects CJK kinsoku (never breaks before closing punctuation / after opening punctuation),
///| - Keeps `CR+LF` together, currency/numeric chains (`$1,234.56`) intact,
///|   Emoji ZWJ sequences & regional-indicator flags intact, and NBSP/WJ/GL non-breaking.
///| DoS-bounded to `UAX14_MAX_INPUT_BYTES` and `UAX14_MAX_OPPORTUNITIES`.
pub fn uax14_wrap_segments(s : String) -> Array[(Int, Int, Bool)] {
  let n = s.length()
  if n == 0 {
    return []
  }
  let target = uax14_bounded_prefix(s)
  let out : Array[(Int, Int, Bool)] = []
  let iter = unicode_linebreak::line_break_iter(target)
  let mut start = 0
  while out.length() < UAX14_MAX_OPPORTUNITIES {
    match iter.next() {
      Some(opp) => {
        let is_mand = opp.kind.eq(unicode_linebreak::BreakKind::Mandatory)
        if opp.byte_offset > start {
          out.push((start, opp.byte_offset, is_mand))
          start = opp.byte_offset
        }
      }
      None => break
    }
  }
  out
}

fn uax14_has_non_ascii(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) >= 0x80 {
      return true
    }
    i = i + 1
  }
  false
}

fn uax14_with_prev(t : String, prev : Int) -> (String, Int) {
  if prev == 0 {
    return (t, 0)
  }
  let sb = StringBuilder::new()
  inline_write_cp(sb, prev)
  let prefix_len = sb.length()
  sb.write_string(t)
  (sb.to_string(), prefix_len)
}

///| Scan a non-ASCII word for UAX #14 break opportunities, returning `(first_break, has_internal)`.
///| Respects `prev` (the preceding code point across inline element boundaries).
fn uax14_word_pieces_scan(t : String, prev : Int) -> (Bool, Bool) {
  let n = t.length()
  if n == 0 {
    return (false, false)
  }
  if n > UAX14_MAX_INPUT_BYTES {
    return (false, false)
  }
  let (combined, prefix_len) = uax14_with_prev(t, prev)
  let total = combined.length()
  let iter = unicode_linebreak::line_break_iter(combined)
  let mut first_break = false
  while true {
    match iter.next() {
      Some(opp) => {
        let off = opp.byte_offset
        if off >= total {
          break
        }
        if prefix_len > 0 && off == prefix_len {
          first_break = true
        } else if off > prefix_len {
          return (first_break, true)
        }
      }
      None => break
    }
  }
  (first_break, false)
}

///| Split a non-ASCII word into `(piece, can_break_before)` pairs using Unicode 16.0.0 UAX #14.
///| Preserves CJK kinsoku, Emoji ZWJ / RI flag clusters, currency/number chains, and NBSP/WJ/GL.
fn uax14_word_pieces(t : String, prev : Int) -> Array[(String, Bool)] {
  let n = t.length()
  if n == 0 {
    return []
  }
  if n > UAX14_MAX_INPUT_BYTES {
    return [(t, false)]
  }
  let (combined, prefix_len) = uax14_with_prev(t, prev)
  let total = combined.length()
  let out : Array[(String, Bool)] = []
  let iter = unicode_linebreak::line_break_iter(combined)
  let mut first_break = false
  let mut seg_start = 0
  while out.length() < UAX14_MAX_OPPORTUNITIES {
    match iter.next() {
      Some(opp) => {
        let off = opp.byte_offset
        if prefix_len > 0 && off == prefix_len {
          first_break = true
        } else if off > prefix_len {
          let rel = off - prefix_len
          let end_rel = if rel > n { n } else { rel }
          if end_rel > seg_start {
            out.push((t.slice(seg_start, end_rel), out.length() > 0 || first_break))
            seg_start = end_rel
          }
          if off >= total {
            break
          }
        }
      }
      None => break
    }
  }
  if seg_start < n {
    out.push((t.slice(seg_start, n), out.length() > 0 || first_break))
  }
  out
}
