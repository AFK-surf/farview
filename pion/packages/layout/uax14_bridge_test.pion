///| Regression unit tests for `uax14_bridge.pion` (Unicode 16.0.0 UAX #14 line breaking).

import "unicode_linebreak"

fn uax14_assert(ok : Bool, msg : String) -> Unit {
  if !ok {
    panic("uax14_bridge_test failed: " + msg)
  }
}

fn uax14_seg_strings(s : String) -> Array[(String, Bool)] {
  let segs = uax14_wrap_segments(s)
  let out : Array[(String, Bool)] = []
  for seg in segs {
    let (a, b, mand) = seg
    out.push((s.slice(a, b), mand))
  }
  out
}

test "uax14 CJK kinsoku: never break before closing/comma/period or after opening" {
  let s = "「中文」，测试。"
  let segs = uax14_seg_strings(s)
  // Expected UAX #14 segments:
  // "「中" (Allowed), "文」，" (Allowed), "测" (Allowed), "试。" (Mandatory)
  uax14_assert(segs.length() == 4, "expected 4 segments, got " + segs.length().to_string())
  uax14_assert(segs[0].0 == "「中" && !segs[0].1, "seg 0 mismatch: " + segs[0].0)
  uax14_assert(segs[1].0 == "文」，" && !segs[1].1, "seg 1 mismatch: " + segs[1].0)
  uax14_assert(segs[2].0 == "测" && !segs[2].1, "seg 2 mismatch: " + segs[2].0)
  uax14_assert(segs[3].0 == "试。" && segs[3].1, "seg 3 mismatch: " + segs[3].0)

  // Verify uax14_can_break_at directly at every UTF-8 boundary (3 bytes per char):
  // 0: 「 (sot -> false)
  // 3: 中 (after OP -> false)
  // 6: 文 (ID ÷ ID -> true)
  // 9: 」 (before CL -> false)
  // 12: ， (before CL -> false)
  // 15: 测 (after CL ÷ ID -> true)
  // 18: 试 (ID ÷ ID -> true)
  // 21: 。 (before CL -> false)
  // 24: EOT (LB3 -> true)
  uax14_assert(!uax14_can_break_at(s, 0), "LB2 sot must be false")
  uax14_assert(!uax14_can_break_at(s, 3), "after 「 must not break")
  uax14_assert(uax14_can_break_at(s, 6), "between 中 and 文 should break")
  uax14_assert(!uax14_can_break_at(s, 9), "before 」 must not break")
  uax14_assert(!uax14_can_break_at(s, 12), "before ， must not break")
  uax14_assert(uax14_can_break_at(s, 15), "after ， before 测 should break")
  uax14_assert(uax14_can_break_at(s, 18), "between 测 and 试 should break")
  uax14_assert(!uax14_can_break_at(s, 21), "before 。 must not break")
  uax14_assert(uax14_can_break_at(s, 24), "EOT must be true")
  // Mid-UTF-8 continuation byte must return false
  uax14_assert(!uax14_can_break_at(s, 1), "mid-utf8 must be false")
  uax14_assert(!uax14_can_break_at(s, 7), "mid-utf8 must be false")
  uax14_assert(!uax14_can_break_at(s, -1), "negative offset must be false")
  uax14_assert(!uax14_can_break_at(s, 25), "past end must be false")
}

test "uax14 mandatory breaks: CRLF not split, LF and BK mandatory" {
  // CR+LF must stay together (LB6/LB5)
  let crlf = "a\r\nb\nc\u{000B}d"
  let segs = uax14_seg_strings(crlf)
  uax14_assert(segs.length() == 4, "expected 4 mandatory segments")
  uax14_assert(segs[0].0 == "a\r\n" && segs[0].1, "CRLF segment mismatch")
  uax14_assert(segs[1].0 == "b\n" && segs[1].1, "LF segment mismatch")
  uax14_assert(segs[2].0 == "c\u{000B}" && segs[2].1, "BK (VT) segment mismatch")
  uax14_assert(segs[3].0 == "d" && segs[3].1, "EOT segment mismatch")
  // Must NOT break between \r (offset 1) and \n (offset 2)
  uax14_assert(!uax14_can_break_at(crlf, 2), "must not split CR+LF")
  uax14_assert(uax14_can_break_at(crlf, 3), "must break after CR+LF")
}

test "uax14 currency numeric chains stay intact" {
  let s = "Price $1,234.56 total"
  let segs = uax14_seg_strings(s)
  uax14_assert(segs.length() == 3, "expected 3 segments for currency sentence")
  uax14_assert(segs[0].0 == "Price " && !segs[0].1, "seg 0 mismatch")
  uax14_assert(segs[1].0 == "$1,234.56 " && !segs[1].1, "currency chain broken: " + segs[1].0)
  uax14_assert(segs[2].0 == "total" && segs[2].1, "seg 2 mismatch")
}

test "uax14 Emoji ZWJ family and regional indicator flags stay intact" {
  // Family ZWJ emoji: U+1F468 U+200D U+1F469 U+200D U+1F467 U+200D U+1F466 (25 bytes)
  let fam = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"
  let fam_segs = uax14_seg_strings(fam)
  uax14_assert(fam_segs.length() == 1 && fam_segs[0].0 == fam && fam_segs[0].1, "ZWJ family must not split")

  // Flags: 🇯🇵 (U+1F1EF U+1F1F5) + 🇺🇸 (U+1F1FA U+1F1F8) -> breaks between the two flags, never inside a flag
  let jp = "\u{1F1EF}\u{1F1F5}"
  let us = "\u{1F1FA}\u{1F1F8}"
  let flags = jp + us
  let flag_segs = uax14_seg_strings(flags)
  uax14_assert(flag_segs.length() == 2, "expected 2 flag segments, got " + flag_segs.length().to_string())
  uax14_assert(flag_segs[0].0 == jp && !flag_segs[0].1, "JP flag split")
  uax14_assert(flag_segs[1].0 == us && flag_segs[1].1, "US flag split")
  uax14_assert(!uax14_can_break_at(flags, 4), "must not split inside JP flag")
  uax14_assert(uax14_can_break_at(flags, 8), "should break between JP and US flags")
  uax14_assert(!uax14_can_break_at(flags, 12), "must not split inside US flag")
}

test "uax14 Korean Hangul, Hebrew, hyphens, and NBSP/WJ/GL non-breaking" {
  // Korean Hangul syllables (LB27 / ID): "한글 테스트"
  let ko = "한글 테스트"
  let ko_segs = uax14_seg_strings(ko)
  uax14_assert(ko_segs.length() >= 2, "Hangul should have break opportunities")
  uax14_assert(uax14_can_break_at(ko, 7), "should break after space in Hangul")

  // Hebrew with hyphen (LB21a: HL (HY | BA) × [^HL]): "אב-גד"
  let he = "אב-גד"
  let he_segs = uax14_seg_strings(he)
  uax14_assert(he_segs.length() == 2, "Hebrew hyphenated word should split after hyphen before HL")
  uax14_assert(he_segs[0].0 == "אב-", "Hebrew first seg mismatch")
  uax14_assert(he_segs[1].0 == "גד", "Hebrew second seg mismatch")

  // ASCII hyphen: "well-known" breaks after '-'
  let hy = "well-known"
  let hy_segs = uax14_seg_strings(hy)
  uax14_assert(hy_segs.length() == 2, "hyphenated word should split in 2")
  uax14_assert(hy_segs[0].0 == "well-" && !hy_segs[0].1, "hyphen seg 0 mismatch")
  uax14_assert(hy_segs[1].0 == "known" && hy_segs[1].1, "hyphen seg 1 mismatch")

  // NBSP (U+00A0, GL) and Word Joiner (U+2060, WJ) prevent breaks
  let nbsp = "foo\u{00A0}bar"
  let nbsp_segs = uax14_seg_strings(nbsp)
  uax14_assert(nbsp_segs.length() == 1 && nbsp_segs[0].0 == nbsp, "NBSP must prevent break")

  let wj_cjk = "中\u{2060}文"
  let wj_segs = uax14_seg_strings(wj_cjk)
  uax14_assert(wj_segs.length() == 1 && wj_segs[0].0 == wj_cjk, "WJ must prevent CJK break")
}

test "uax14_iter and uax14_next_break_after match uax14_line_breaks" {
  let s = "Hello, 「世界」! Price $99.50\r\n🇯🇵🇺🇸 well-known"
  let all = uax14_line_breaks(s)
  uax14_assert(all.length() > 0, "expected non-empty break opportunities")

  // Check LineBreakIter equivalence
  let iter = uax14_iter(s)
  let from_iter : Array[unicode_linebreak::BreakOpportunity] = []
  while true {
    match iter.next() {
      Some(opp) => from_iter.push(opp)
      None => break
    }
  }
  uax14_assert(from_iter.length() == all.length(), "iter length mismatch")
  let mut i = 0
  while i < all.length() {
    uax14_assert(from_iter[i].eq(all[i]), "iter item mismatch at " + i.to_string())
    i += 1
  }

  // Check uax14_next_break_after stepping equivalence
  let from_next : Array[unicode_linebreak::BreakOpportunity] = []
  let mut cursor = 0
  while true {
    match uax14_next_break_after(s, cursor) {
      Some(opp) => {
        from_next.push(opp)
        cursor = opp.byte_offset
      }
      None => break
    }
  }
  uax14_assert(from_next.length() == all.length(), "next_break_after length mismatch")
  i = 0
  while i < all.length() {
    uax14_assert(from_next[i].eq(all[i]), "next_break_after item mismatch at " + i.to_string())
    i += 1
  }

  // Empty string edge cases
  uax14_assert(uax14_line_breaks("").length() == 0, "empty line_breaks")
  uax14_assert(uax14_wrap_segments("").length() == 0, "empty wrap_segments")
  uax14_assert(!uax14_can_break_at("", 0), "empty can_break_at")
  match uax14_next_break_after("", 0) {
    None => ()
    Some(_) => uax14_assert(false, "empty next_break_after must be None")
  }
}

test "uax14 DoS limits enforcement" {
  let sample = "a b c d e f g h i j"
  // Input bytes limit exceeded
  let tiny_bytes = unicode_linebreak::LineBreakLimits::new(5, 100)
  match uax14_line_breaks_with_limits(sample, tiny_bytes) {
    Err(e) => uax14_assert(e.eq(unicode_linebreak::LineBreakError::LimitExceeded), "expected LimitExceeded for bytes")
    Ok(_) => uax14_assert(false, "expected Err for max_input_bytes")
  }
  // Opportunities limit exceeded
  let tiny_opps = unicode_linebreak::LineBreakLimits::new(1024, 3)
  match uax14_line_breaks_with_limits(sample, tiny_opps) {
    Err(e) => uax14_assert(e.eq(unicode_linebreak::LineBreakError::LimitExceeded), "expected LimitExceeded for opps")
    Ok(_) => uax14_assert(false, "expected Err for max_opportunities")
  }
  // Negative limit fails immediately
  let neg = unicode_linebreak::LineBreakLimits::new(-1, 10)
  match uax14_line_breaks_with_limits("a", neg) {
    Err(e) => uax14_assert(e.eq(unicode_linebreak::LineBreakError::LimitExceeded), "expected LimitExceeded for negative")
    Ok(_) => uax14_assert(false, "expected Err for negative limit")
  }
  // Default limits constants sanity
  let lim = uax14_limits()
  uax14_assert(lim.max_input_bytes == 2097152, "default max_input_bytes should be 2 MiB")
  uax14_assert(lim.max_opportunities == 524288, "default max_opportunities should be 512K")
}

test "uax14 inline word_pieces_ex integration preserves CJK kinsoku, Emoji ZWJ/flags, and WJ" {
  let cjk = word_pieces_ex("「中文」，测试。", false, 0, false, false)
  uax14_assert(cjk.length() == 4, "word_pieces_ex CJK kinsoku expected 4 pieces, got " + cjk.length().to_string())
  uax14_assert(cjk[0].0 == "「中" && !cjk[0].1, "piece 0 mismatch")
  uax14_assert(cjk[1].0 == "文」，" && cjk[1].1, "piece 1 mismatch")
  uax14_assert(cjk[2].0 == "测" && cjk[2].1, "piece 2 mismatch")
  uax14_assert(cjk[3].0 == "试。" && cjk[3].1, "piece 3 mismatch")

  // Family ZWJ emoji must stay a single unbreakable piece
  let fam = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"
  let fam_p = word_pieces_ex(fam, false, 0, false, false)
  uax14_assert(fam_p.length() == 1 && fam_p[0].0 == fam, "word_pieces_ex must keep ZWJ family intact")

  // Flags 🇯🇵🇺🇸 split between the two flags, never inside a flag
  let jp = "\u{1F1EF}\u{1F1F5}"
  let us = "\u{1F1FA}\u{1F1F8}"
  let flags_p = word_pieces_ex(jp + us, false, 0, false, false)
  uax14_assert(flags_p.length() == 2 && flags_p[0].0 == jp && flags_p[1].0 == us && flags_p[1].1, "word_pieces_ex flags mismatch")

  // Word Joiner prevents CJK break
  let wj_p = word_pieces_ex("中\u{2060}文", false, 0, false, false)
  uax14_assert(wj_p.length() == 1 && wj_p[0].0 == "中\u{2060}文", "word_pieces_ex WJ must not break")
}
