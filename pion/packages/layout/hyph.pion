///| Hyphenation points of English words (Liang's patterns, as TeX finds them), for `hyphens: auto`.
///| 1:1 port of `client/src/layout/hyph.mbt`.

struct Hyph {
  patterns : Map[String, Array[Int]]
  exceptions : Map[String, Array[Int]]
  mut longest : Int
}

struct HyphBox {
  mut loaded : Option[Hyph]
}

let hyph_box : HyphBox = HyphBox::{ loaded: None }

fn hyph_words_of(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut b = StringBuilder::new()
  let mut i = 0
  let n = s.length()
  while i < n {
    let ch = s.code_unit_at(i)
    if ch == 32 || ch == 10 || ch == 9 {
      if b.length() > 0 {
        out.push(b.to_string())
        b = StringBuilder::new()
      }
    } else {
      b.write_char(ch.unsafe_to_char())
    }
    i += 1
  }
  if b.length() > 0 {
    out.push(b.to_string())
  }
  out
}

fn hyph_tables() -> Hyph {
  match hyph_box.loaded {
    Some(h) => h
    None => {
      let h = Hyph::{ patterns: Map::new(), exceptions: Map::new(), longest: 0 }
      let pats = hyph_words_of(en_patterns)
      let mut pi = 0
      while pi < pats.length() {
        let p = pats[pi]
        let letters = StringBuilder::new()
        let vals : Array[Int] = [0]
        let mut ci = 0
        while ci < p.length() {
          let ch = p.code_unit_at(ci)
          if ch >= 48 && ch <= 57 {
            vals[vals.length() - 1] = ch - 48
          } else {
            letters.write_char(ch.unsafe_to_char())
            vals.push(0)
          }
          ci += 1
        }
        let key = letters.to_string()
        h.patterns.set(key, vals)
        if key.length() > h.longest {
          h.longest = key.length()
        }
        pi += 1
      }
      let excs = hyph_words_of(en_exceptions)
      let mut ei = 0
      while ei < excs.length() {
        let e = excs[ei]
        let letters = StringBuilder::new()
        let points : Array[Int] = []
        let mut k = 0
        let mut ci = 0
        while ci < e.length() {
          let ch = e.code_unit_at(ci)
          if ch == 45 {
            points.push(k)
          } else {
            letters.write_char(ch.unsafe_to_char())
            k += 1
          }
          ci += 1
        }
        h.exceptions.set(letters.to_string(), points)
        ei += 1
      }
      hyph_box.loaded = Some(h)
      h
    }
  }
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn hyph_ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i += 1
  }
  sb.to_string()
}

pub fn hyphen_points(word : String) -> Array[Int] {
  let n = word.length()
  let mut a = 0
  let mut b = n
  while a < b && !is_ascii_alpha(word.code_unit_at(a)) {
    a += 1
  }
  while b > a && !is_ascii_alpha(word.code_unit_at(b - 1)) {
    b -= 1
  }
  if a > 0 || b < n {
    let core = core_points(word.slice(a, b))
    let out : Array[Int] = []
    let mut i = 0
    while i < core.length() {
      out.push(core[i] + a)
      i += 1
    }
    return out
  }
  core_points(word)
}

fn core_points(word : String) -> Array[Int] {
  let n = word.length()
  if n < 5 {
    return []
  }
  let mut i = 0
  while i < n {
    if !is_ascii_alpha(word.code_unit_at(i)) {
      return []
    }
    i += 1
  }
  let lower = hyph_ascii_lower(word)
  let h = hyph_tables()
  match h.exceptions.get(lower) {
    Some(p) => return p
    None => ()
  }
  let w = "." + lower + "."
  let wn = w.length()
  let vals : Array[Int] = []
  i = 0
  while i <= wn {
    vals.push(0)
    i += 1
  }
  i = 0
  while i < wn {
    let mut len = 1
    while len <= h.longest && i + len <= wn {
      let key = w.slice(i, i + len)
      match h.patterns.get(key) {
        Some(v) => {
          let mut k = 0
          while k < v.length() {
            if v[k] > vals[i + k] {
              vals[i + k] = v[k]
            }
            k += 1
          }
        }
        None => ()
      }
      len += 1
    }
    i += 1
  }
  let out : Array[Int] = []
  i = 2
  while i <= n - 3 {
    if vals[i + 1] % 2 == 1 {
      out.push(i)
    }
    i += 1
  }
  out
}
