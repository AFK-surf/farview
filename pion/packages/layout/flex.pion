///| Flexbox, tables and grids.
///| 1:1 port of `client/src/layout/flex.mbt`.

import "html"
import "css"
import "intmap"

struct FlexItem {
  box : Box
  mut base : Double
  mut main : Double
  mut hypo : Double
  mut lo : Double
  mut hi : Double
  mut frozen : Bool
  mut cross : Double
  mut answered : Bool
  grow : Double
  shrink : Double
  // its align-self, or else its container's align-items (`flex_self_align`)
  al : String
  // (a column item of a container with no definite height, whose specified height is its base size: `lo` stands for
  // its automatic minimum, which is no greater than that, until a line with an item whose hypothetical size is
  // not its base size needs it; the main sizes of a line whose items all are, are those sizes whatever the minimums)
  mut lazy_min : Bool
}

fn flex_self_align(c : Box, b : Box) -> String {
  let s = c.style.word_id(css::p_align_self)
  if s != "" && s != "auto" { s } else { b.style.word_id(css::p_align_items) }
}

fn flex_mm(it : FlexItem, column : Bool) -> Double {
  if column { it.box.mt + it.box.mb } else { it.box.ml + it.box.mr }
}

fn flex_by_baseline(al : String, column : Bool) -> Bool {
  !column && (al == "baseline" || al == "first")
}

fn flex_by_last(al : String, column : Bool, wrap_rev_lines : Bool) -> Bool {
  !column && !wrap_rev_lines && al == "last"
}

fn flex_base_of(c : Box, wrap_rev_lines : Bool) -> Double {
  let bv = match c.baseline { Some(v) => v None => c.h }
  if wrap_rev_lines { c.mb + c.h - bv } else { c.mt + bv }
}

fn flex_below_last(c : Box) -> Double {
  let lb = match c.last_baseline {
    Some(v) => v
    None => match c.baseline { Some(v) => v None => c.h }
  }
  c.h + c.mb - lb
}

fn flex_aligns_by_baseline(it : FlexItem, column : Bool) -> Bool {
  if column || it.box.baseline.is_none() { return false }
  it.al == "baseline" || it.al == "first" || it.al == "last"
}

fn flex_is_whitespace_only(t : String) -> Bool {
  let mut i = 0
  let n = t.length()
  while i < n {
    let c = t.code_unit_at(i)
    if c != 32 && c != 10 && c != 9 {
      return false
    }
    i += 1
  }
  true
}

fn flex_is_compressible(b : Box) -> Bool {
  match b.node {
    Some(n) => {
      if n.tag == "textarea" || n.tag == "select" {
        return true
      }
      if n.tag == "input" {
        let ty = match n.attr("type") {
          Some(t) => inline_ascii_lower(t)
          None => ""
        }
        return ty != "button" && ty != "submit" && ty != "reset" &&
        ty != "checkbox" && ty != "radio" && ty != "image"
      }
      false
    }
    None => false
  }
}

fn definite_basis(c : Box) -> Bool {
  let v = c.style.get_id(css::p_flex_basis)
  if v.length() == 0 {
    return specified_h(c, css::p_height, None).is_some()
  }
  match v[0] {
    css::Tok::Ident(_) => specified_h(c, css::p_height, None).is_some()
    _ => !has_pct_tok(v) && c.style.length_of(v).is_some()
  }
}

fn sort_boxes_by_order(arr : Array[Box]) -> Unit {
  // Stable insertion sort by CSS `order`
  let n = arr.length()
  if n <= 1 { return }
  let mut any_order = false
  let mut k = 0
  while k < n {
    if arr[k].style.values.maybe_has_id(css::p_order) {
      any_order = true
      break
    }
    k += 1
  }
  if !any_order { return }
  let mut i = 1
  while i < n {
    let cur = arr[i]
    let key = cur.style.number_id(css::p_order, 0.0).to_int()
    let mut j = i - 1
    while j >= 0 && arr[j].style.number_id(css::p_order, 0.0).to_int() > key {
      arr[j + 1] = arr[j]
      j -= 1
    }
    arr[j + 1] = cur
    i += 1
  }
}

fn rev_flex_items(src : Array[FlexItem]) -> Array[FlexItem] {
  let out : Array[FlexItem] = []
  let mut i = src.length() - 1
  while i >= 0 {
    out.push(src[i])
    i -= 1
  }
  out
}

fn replaced_aspect_ratio(b : Box) -> Option[Double] {
  match b.node {
    Some(n) => if is_no_ratio_replaced(n) { return None }
    None => ()
  }
  match b.kind {
    Kind::Replaced(nw, nh) =>
    if nw > 0.0 && nh > 0.0 {
      Some(nw / nh)
    } else if nw < 0.0 && nh > 0.0 {
      Some(1.0 / nh)
    } else {
      None
    }
    _ => None
  }
}

fn flex_item_aspect_ratio(c2 : Box) -> Option[(Double, Bool)] {
  match c2.kind {
    Kind::Replaced(_, _) =>
    match replaced_aspect_ratio(c2) {
      Some(r) => Some((r, false))
      None =>
      if c2.style.values.maybe_has_id(css::p_aspect_ratio) {
        match aspect_ratio(c2) {
          Some(r) => Some((r, border_box_sizing(c2)))
          None => None
        }
      } else {
        None
      }
    }
    _ =>
    if c2.style.values.maybe_has_id(css::p_aspect_ratio) {
      match aspect_ratio(c2) {
        Some(r) => Some((r, border_box_sizing(c2)))
        None => None
      }
    } else {
      None
    }
  }
}

fn flex_ratio_from_stretch(b : Box, c2 : Box, column : Bool, inner_h : Option[Double]) -> Option[Double] {
  if column { return None }
  match flex_item_aspect_ratio(c2) {
    Some((r, bb)) => {
      // W3C CSS Flexbox 1 §9.2 step 3B + CSS Sizing 4 §5.1:
      // Transfer a definite cross size (explicit/percentage height or stretched
      // against a definite flex container cross size) through the item's preferred
      // aspect-ratio to determine its flex base main size.
      let cross_h : Option[Double] = match specified_h(c2, css::p_height, inner_h) {
        Some(sh) => Some(clamp_h(c2, sh, inner_h))
        None =>
        match inner_h {
          Some(h) => {
            let s = c2.style.word_id(css::p_align_self)
            let al = if s != "" && s != "auto" { s } else { b.style.word_id(css::p_align_items) }
            if (al == "" || al == "stretch" || al == "normal") &&
            (c2.style.auto_margins() & 1) == 0 &&
            (c2.style.auto_margins() & 4) == 0 {
              Some(clamp_h(c2, dmax(h - c2.mt - c2.mb, 0.0), inner_h))
            } else {
              None
            }
          }
          None => None
        }
      }
      match cross_h {
        Some(bh) =>
        Some(
          if bb {
            dmax(bh * r, hedges(c2))
          } else {
            dmax(bh - vedges(c2), 0.0) * r + hedges(c2)
          },
        )
        None => None
      }
    }
    None => None
  }
}

// A column item's automatic minimum main size (CSS Flexbox 1 §4.5), its overflow visible and its min-height auto:
// the smaller of its specified size and its content size, its height laid out with none given.
fn Lay::flex_col_auto_min(self : Lay, b : Box, c2 : Box, cw : Double, spec : Option[Double], edges : Double) -> Double {
  let fw = self.cross_width(c2, cw, b, false)
  let answer = self.measured(c2, (cw, -1.0e300, fw, -1.0e300))
  if answer.is_none() {
    self.layout_root(c2, 0.0, 0.0, cw, None, Some(fw), None)
  }
  let has_spec_h = (c2.style.values.maybe_has_id(css::p_height) && specified_h(c2, css::p_height, None).is_some()) ||
  (c2.style.values.maybe_has_id(css::p_aspect_ratio) && ratio_h(c2, c2.w).is_some())
  let by_content = vertical_mode(c2.style) == 0 &&
  !has_spec_h &&
  specified_h(c2, css::p_max_height, None).is_none() &&
  !is_content_kw(c2.style.word_id(css::p_max_height)) &&
  !is_content_kw(c2.style.word_id(css::p_min_height))
  let mut content = -1.0
  if !by_content {
    if answer.is_some() {
      self.layout_root(c2, 0.0, 0.0, cw, None, Some(fw), None)
    }
    if self.auto_h_kept(c2) {
      content = c2.auto_h
    } else {
      self.layout_inner(c2, None, None)
    }
  }
  if content < 0.0 {
    content = match answer {
      Some(h) => if by_content { h } else { c2.h }
      None => c2.h
    }
  }
  let spec_eff = match c2.style.length_id(css::p_height) {
    Some(l) =>
    if l.pct != 0.0 && flex_is_compressible(c2) {
      Some(if border_box_sizing(c2) { dmax(l.px, edges) } else { l.px + edges })
    } else {
      spec
    }
    None => spec
  }
  match spec_eff {
    Some(v) => dmin(v, content)
    None => content
  }
}

// Whether the height the box's content would give it with no height given is the `auto_h` its last layout noted
// (nothing laid it out since: its geom is the one noted then), so that it need not be laid out again, with no height
// given, only to read that height: which would leave its geometry at a height other than its memo's, so that its
// final layout at its used height could not reuse the layout just made.
// Its children are laid out alike at any height of its own, as long as that height reaches none of them (no
// percentage heights below, as `height_reaches` says) and no item of a flex container takes its main size from its
// cross size through an aspect ratio; a block container's content then gives it the same height, and a single-line
// row flex container's line the same cross size, whatever height it was given (noted only by those two).
fn Lay::auto_h_kept(self : Lay, c : Box) -> Bool {
  if c.auto_geom != c.geom || self.turned != 0 || vertical_mode(c.style) != 0 || line_clamp(c.style) != 0 || size_contained(c) {
    return false
  }
  if (c.style.values.maybe_has_id(css::p_min_height) && is_content_kw(c.style.word_id(css::p_min_height))) ||
  (c.style.values.maybe_has_id(css::p_max_height) && is_content_kw(c.style.word_id(css::p_max_height))) {
    return false
  }
  match inner_kind(c) {
    Kind::Block => ()
    Kind::Flex => {
      let mut i = 0
      while i < c.children.length() {
        let k = c.children[i]
        if !out_of_flow(k.style) && flex_item_aspect_ratio(k).is_some() { return false }
        i += 1
      }
    }
    _ => return false
  }
  !self.height_reaches(c)
}

// Whether a column item's specified height is its flex base size and bounds its automatic minimum from above, so
// that the minimum (the smaller of the two) is no greater than the base size (its effective specified size is the
// specified one: no percentage of a compressible box taken as its fixed part, as flex_col_auto_min does).
fn flex_spec_is_min_bound(c2 : Box, spec : Option[Double], edges : Double) -> Bool {
  match spec {
    None => false
    Some(v) =>
    match c2.style.length_id(css::p_height) {
      Some(l) =>
      if l.pct != 0.0 && flex_is_compressible(c2) {
        (if border_box_sizing(c2) { dmax(l.px, edges) } else { l.px + edges }) == v
      } else {
        true
      }
      None => true
    }
  }
}

fn Lay::flex_content_size(self : Lay, b : Box, c2 : Box, column : Bool, cw : Double, inner_h : Option[Double]) -> Double {
  if column {
    match flex_item_aspect_ratio(c2) {
      Some((r, bb)) =>
      if specified_w(c2, css::p_width, Some(cw)).is_none() {
        let s = c2.style.word_id(css::p_align_self)
        let al = if s != "" && s != "auto" { s } else { b.style.word_id(css::p_align_items) }
        if (al == "" || al == "stretch" || al == "normal") &&
        (c2.style.auto_margins() & 8) == 0 &&
        (c2.style.auto_margins() & 2) == 0 {
          let bw = clamp_w(c2, dmax(cw - c2.ml - c2.mr, 0.0), Some(cw))
          return if bb {
            dmax(bw / r, vedges(c2))
          } else {
            dmax(bw - hedges(c2), 0.0) / r + vedges(c2)
          }
        }
      }
      None => ()
    }
    let fw = self.cross_width(c2, cw, b, false)
    match self.measured(c2, (cw, -1.0e300, fw, -1.0e300)) {
      Some(h) => h
      None => {
        self.layout_root(c2, 0.0, 0.0, cw, None, Some(fw), None)
        c2.h
      }
    }
  } else {
    match flex_ratio_from_stretch(b, c2, column, inner_h) {
      Some(w) => w
      None => {
        let saved_pct_h = self.pct_h
        if inner_h.is_some() { self.pct_h = inner_h }
        let w = self.max_content(c2)
        self.pct_h = saved_pct_h
        set_edges(c2, cw)
        w
      }
    }
  }
}

fn Lay::layout_flex(self : Lay, b : Box, given_h : Option[Double], cbh : Option[Double]) -> Unit {
  let dir = if b.style.values.maybe_has_id(css::p_flex_direction) { b.style.word_id(css::p_flex_direction) } else { "" }
  let column = dir.length() > 0 && dir.starts_with("column")
  let reverse = dir.length() > 0 && str_has_suffix(dir, "reverse")
  let wrap_word = if b.style.values.maybe_has_id(css::p_flex_wrap) { b.style.word_id(css::p_flex_wrap) } else { "" }
  let wrap = wrap_word == "wrap" || wrap_word == "wrap-reverse" || wrap_word == "balance"
  let cw = dmax(b.w - hedges(b), 0.0)
  let inner_h : Option[Double] = match given_h {
    Some(h) => Some(dmax(h - vedges(b), 0.0))
    None => None
  }
  let main_size : Option[Double] = if column { inner_h } else { Some(cw) }
  let pct_main : Option[Double] = match self.settling {
    Some(s) => if s.uid == b.uid { None } else { main_size }
    None => main_size
  }
  let gap_main = len(b, if column { css::p_row_gap } else { css::p_column_gap }, cw)
  let gap_cross = len(b, if column { css::p_column_gap } else { css::p_row_gap }, cw)
  let nch = b.children.length()
  let items : Array[FlexItem] = if nch > 0 { Array::with_capacity(nch) } else { [] }
  let wrappers : Array[Box] = []
  let ordered : Array[Box] = if nch > 0 { Array::with_capacity(nch) } else { [] }
  let mut ci = 0
  while ci < nch {
    let c = b.children[ci]
    match c.kind {
      Kind::TextRun(_) => {
        // CSS Flexbox 1 §4: contiguous direct text runs in a flex container form
        // a single anonymous flex item (omitted only if the entire run is whitespace).
        let run_start = ci
        let mut has_non_ws = false
        while ci < nch {
          match b.children[ci].kind {
            Kind::TextRun(t) => {
              if !flex_is_whitespace_only(t) { has_non_ws = true }
              ci += 1
            }
            _ => break
          }
        }
        if has_non_ws {
          if ci - run_start == 1 {
            ordered.push(b.children[run_start])
          } else {
            let w = new_box(None, b.children[run_start].style.anonymous(), Kind::Block)
            let mut k = run_start
            while k < ci {
              w.children.push(b.children[k])
              k += 1
            }
            wrappers.push(w)
            ordered.push(w)
          }
        }
      }
      _ => {
        ordered.push(c)
        ci += 1
      }
    }
  }
  sort_boxes_by_order(ordered)
  for c in ordered {
    if out_of_flow(c.style) {
      self.queue_abs(c, b, b.bl + b.pl, b.bt + b.pt)
      continue
    }
    let c2 = if c.kind is Kind::TextRun(_) || c.kind is Kind::Inline {
      let w = new_box(None, c.style.anonymous(), Kind::Block)
      w.children.push(c)
      wrappers.push(w)
      w
    } else {
      c
    }
    set_edges(c2, cw)
    let basis : Option[Double] = if !c2.style.values.maybe_has_id(css::p_flex_basis) {
      None
    } else {
      let basis_prop = c2.style.get_id(css::p_flex_basis)
      let blen = basis_prop.length()
      if blen == 0 {
        None
      } else if blen == 1 {
        match basis_prop[0] {
          css::Tok::Dimension(v, u) =>
          if u == "px" { Some(v) }
          else if u == "rem" { Some(v * c2.style.root_font) }
          else if u == "em" { Some(v * c2.style.font_size) }
          else {
            match c2.style.length_of(basis_prop) {
              Some(l) => Some(l.px)
              None => None
            }
          }
          css::Tok::Number(n) => if n == 0.0 { Some(0.0) } else { None }
          css::Tok::Percentage(p) =>
          match pct_main {
            Some(m) => Some(p * m / 100.0)
            None => None
          }
          css::Tok::Ident(k) =>
          if k == "auto" {
            None
          } else {
            let lk = inline_ascii_lower(k)
            if !column && (lk == "min-content" || lk == "max-content" || lk == "fit-content" || lk == "content") {
              let mx = self.intrinsic(c2, true, false) - hedges(c2)
              Some(
                if lk == "min-content" {
                  self.intrinsic(c2, false, false) - hedges(c2)
                } else if lk == "fit-content" {
                  dmax(self.intrinsic(c2, false, false) - hedges(c2), dmin(mx, cw - c2.ml - c2.mr - hedges(c2)))
                } else {
                  mx
                },
              )
            } else {
              None
            }
          }
          _ =>
          match c2.style.length_of_against(basis_prop, pct_main) {
            Some(l) =>
            if l.pct != 0.0 || has_pct_tok(basis_prop) {
              match pct_main {
                Some(m) => Some(resolve(l, m))
                None => None
              }
            } else {
              Some(l.px)
            }
            None => None
          }
        }
      } else {
        match c2.style.length_of_against(basis_prop, pct_main) {
          Some(l) =>
          if l.pct != 0.0 || has_pct_tok(basis_prop) {
            match pct_main {
              Some(m) => Some(resolve(l, m))
              None => None
            }
          } else {
            Some(l.px)
          }
          None => None
        }
      }
    }
    let edges = if column { vedges(c2) } else { hedges(c2) }
    let spec = if column {
      specified_h(c2, css::p_height, inner_h)
    } else {
      self.said_width(c2, Some(cw))
    }
    let base = match basis {
      Some(v) => if border_box_sizing(c2) { dmax(v, edges) } else { v + edges }
      None =>
      match spec {
        Some(v) => v
        None => self.flex_content_size(b, c2, column, cw, inner_h)
      }
    }
    let explicit_min_w = if column {
      None
    } else {
      match specified_w(c2, css::p_min_width, Some(cw)) {
        Some(v) => Some(v)
        None =>
        if c2.style.values.maybe_has_id(css::p_min_width) {
          let v = self.clamp_keyword_size(c2, css::p_min_width, Some(dmax(cw - c2.ml - c2.mr, 0.0)))
          set_edges(c2, cw)
          v
        } else {
          None
        }
      }
    }
    let mut lazy_min = false
    let mut lo0 = if column {
      match specified_h(c2, css::p_min_height, inner_h) {
        Some(v) => v
        None => {
          let ov = c2.style.word_id(css::p_overflow_y)
          if ov == "" || ov == "visible" {
            // (an item whose minimum the line's main sizes cannot reach: `lazy_min`, laid out for it only if they can)
            if main_size.is_none() && basis.is_none() && flex_spec_is_min_bound(c2, spec, edges) {
              lazy_min = true
              base
            } else {
              self.flex_col_auto_min(b, c2, cw, spec, edges)
            }
          } else {
            edges
          }
        }
      }
    } else {
      match explicit_min_w {
        Some(v) => v
        None => {
          let ov = c2.style.word_id(css::p_overflow_x)
          let compressible = flex_is_compressible(c2)
          let spec_eff = match c2.style.length_id(css::p_width) {
            Some(l) =>
            if compressible && l.pct != 0.0 {
              Some(if border_box_sizing(c2) { dmax(l.px, edges) } else { l.px + edges })
            } else {
              spec
            }
            None => spec
          }
          if ov == "" || ov == "visible" {
            let saved_pct_h = self.pct_h
            if inner_h.is_some() { self.pct_h = inner_h }
            let content = match c2.kind {
              Kind::Replaced(_, _) =>
              match (replaced_aspect_ratio(c2), specified_h(c2, css::p_height, inner_h)) {
                (Some(r), Some(h)) => {
                  let ch = clamp_h(c2, h, inner_h) - vedges(c2)
                  dmax(ch, 0.0) * r + hedges(c2)
                }
                _ => self.min_content(c2)
              }
              _ => self.intrinsic(c2, false, false)
            }
            self.pct_h = saved_pct_h
            set_edges(c2, cw)
            match spec_eff {
              Some(v) => dmin(v, content)
              None => content
            }
          } else {
            edges
          }
        }
      }
    }
    let hi = if column {
      match specified_h(c2, css::p_max_height, inner_h) {
        Some(v) => v
        None => 1.0e18
      }
    } else {
      match specified_w(c2, css::p_max_width, Some(cw)) {
        Some(v) => v
        None =>
        if c2.style.values.maybe_has_id(css::p_max_width) {
          let v = self.clamp_keyword_size(c2, css::p_max_width, Some(dmax(cw - c2.ml - c2.mr, 0.0)))
          set_edges(c2, cw)
          match v { Some(m) => m None => 1.0e18 }
        } else {
          1.0e18
        }
      }
    }
    let auto_min = if column {
      specified_h(c2, css::p_min_height, inner_h).is_none()
    } else {
      explicit_min_w.is_none()
    }
    if lazy_min && !(base <= hi) {
      lazy_min = false
      lo0 = self.flex_col_auto_min(b, c2, cw, spec, edges)
    }
    let lo = if auto_min { dmin(lo0, hi) } else { lo0 }
    items.push(FlexItem::{
      box: c2,
      base: base,
      main: base,
      hypo: dmax(lo, dmin(base, hi)),
      lo: lo,
      hi: hi,
      frozen: false,
      cross: 0.0,
      answered: false,
      grow: c2.style.number_id(css::p_flex_grow, 0.0),
      shrink: c2.style.number_id(css::p_flex_shrink, 1.0),
      al: flex_self_align(c2, b),
      lazy_min: lazy_min,
    })
  }
  // Lines
  let lines : Array[Array[FlexItem]] = []
  let mut cur : Array[FlexItem] = []
  let mut used = 0.0
  let slack = 1.0 / 64.0
  for it in items {
    let outer = it.hypo + flex_mm(it, column)
    let overflows = match main_size {
      Some(m) => used + gap_main + outer > m + slack
      None =>
      match specified_h(b, css::p_max_height, None) {
        Some(mh) => column && used + gap_main + outer > mh - vedges(b)
        None => false
      }
    }
    if wrap && cur.length() > 0 && overflows {
      lines.push(cur)
      cur = []
      used = 0.0
    }
    used += outer + (if cur.length() > 0 { gap_main } else { 0.0 })
    cur.push(it)
  }
  if cur.length() > 0 {
    lines.push(cur)
  }
  for line in lines {
    let mut all_at_base = true
    let mut any_lazy = false
    for it in line {
      if it.hypo != it.base { all_at_base = false }
      if it.lazy_min { any_lazy = true }
    }
    if any_lazy && !all_at_base {
      for it in line {
        if it.lazy_min {
          it.lazy_min = false
          let c2 = it.box
          it.lo = dmin(self.flex_col_auto_min(b, c2, cw, Some(it.base), vedges(c2)), it.hi)
          it.hypo = dmax(it.lo, dmin(it.base, it.hi))
        }
      }
    }
  }
  // (a single column line whose items all are at their base sizes is at those sizes whatever the container's
  // height, which reaches none of them when `auto_h_kept` takes this: the container's content height with none given)
  if column && !wrap && lines.length() == 1 {
    let line = lines[0]
    let mut at_base = true
    let mut sum = (line.length() - 1).to_double() * gap_main
    for it in line {
      if it.hypo != it.base { at_base = false }
      sum += it.base + flex_mm(it, column)
    }
    if at_base {
      b.auto_h = dmax(sum, 0.0) + vedges(b)
      b.auto_geom = b.geom
    }
  }
  // Main sizes
  for line in lines {
    let mut hypo_sum = (line.length() - 1).to_double() * gap_main
    for it in line {
      hypo_sum += it.hypo + flex_mm(it, column)
    }
    let size = match main_size {
      Some(m) => m
      None => hypo_sum
    }
    let grow = hypo_sum < size
    for it in line {
      it.frozen = (if grow { it.grow == 0.0 } else { it.shrink == 0.0 }) ||
      (grow && it.base > it.hypo) ||
      (!grow && it.base < it.hypo)
      if it.frozen {
        it.main = it.hypo
      } else {
        it.main = it.base
      }
    }
    for _round in 0..<(line.length() + 1) {
      let mut all_frozen = true
      for it in line {
        if !it.frozen {
          all_frozen = false
          break
        }
      }
      if all_frozen {
        break
      }
      let mut sum = (line.length() - 1).to_double() * gap_main
      let mut factor = 0.0
      let mut scaled = 0.0
      for it in line {
        sum += flex_mm(it, column) + (if it.frozen { it.main } else { it.base })
        if !it.frozen {
          factor += if grow { it.grow } else { it.shrink }
          scaled += it.shrink * it.base
        }
      }
      let mut free = size - sum
      if factor < 1.0 {
        free = free * factor
      }
      let mut violation = 0.0
      for it in line {
        if !it.frozen {
          let t = if grow {
            if factor > 0.0 { it.base + free * it.grow / factor } else { it.base }
          } else if scaled > 0.0 {
            it.base + free * it.shrink * it.base / scaled
          } else {
            it.base
          }
          let c = dmax(it.lo, dmin(t, it.hi))
          violation += c - t
          it.main = c
        }
      }
      for it in line {
        if !it.frozen {
          let t = it.main
          if violation == 0.0 ||
          (violation > 0.0 && t <= it.lo) ||
          (violation < 0.0 && t >= it.hi) {
            it.frozen = true
          }
        }
      }
    }
  }
  // Cross sizes
  let line_cross : Array[Double] = []
  let wrap_rev_lines = wrap_word == "wrap-reverse"
  let line_base : Array[Double] = []
  let line_below : Array[Double] = []
  for line in lines {
    let mut best = 0.0
    let mut above = 0.0
    let mut below = 0.0
    let mut last_above = 0.0
    let mut last_below = 0.0
    for it in line {
      let c = it.box
      if column {
        let w0 = self.cross_width(c, cw, b, wrap)
        let w = match replaced_aspect_ratio(c) {
          Some(r) => {
            let sa = it.al
            if specified_w(c, css::p_width, Some(cw)).is_none() &&
            sa != "" && sa != "stretch" && sa != "normal" {
              clamp_w(c, dmax(it.main - vedges(c), 0.0) * r + hedges(c), Some(cw))
            } else {
              w0
            }
          }
          None => w0
        }
        self.items_indefinite = pct_main.is_none() && !definite_basis(c) && ratio_h(c, w).is_none()
        self.layout_root(c, 0.0, 0.0, cw, inner_h, Some(w), Some(it.main))
        it.cross = w
        best = dmax(best, w + c.ml + c.mr)
      } else {
        let al = it.al
        let stretchy = (al == "" || al == "stretch" || al == "normal") &&
        specified_h(c, css::p_height, inner_h).is_none() &&
        !is_intrinsic_h(c) &&
        (c.style.auto_margins() & 1) == 0 &&
        (c.style.auto_margins() & 4) == 0 &&
        !flex_by_baseline(al, column) &&
        !flex_by_last(al, column, wrap_rev_lines)
        if stretchy {
          let ih = match inner_h { Some(h) => h None => -1.0e300 }
          match self.measured(c, (cw, ih, it.main, -1.0e300)) {
            Some(h) => {
              it.answered = true
              it.cross = h
              best = dmax(best, h + c.mt + c.mb)
              continue
            }
            None => ()
          }
        }
        self.layout_root(c, 0.0, 0.0, cw, inner_h, Some(it.main), None)
        it.cross = c.h
        best = dmax(best, c.h + c.mt + c.mb)
        if flex_by_baseline(al, column) {
          above = dmax(above, flex_base_of(c, wrap_rev_lines))
          below = dmax(below, c.h + c.mt + c.mb - flex_base_of(c, wrap_rev_lines))
        }
        if flex_by_last(al, column, wrap_rev_lines) {
          last_below = dmax(last_below, flex_below_last(c))
          last_above = dmax(last_above, c.mt + c.h + c.mb - flex_below_last(c))
        }
      }
    }
    line_cross.push(dmax(dmax(best, above + below), last_above + last_below))
    line_base.push(above)
    line_below.push(last_below)
  }
  let mut total_cross = (lines.length() - 1).to_double() * gap_cross
  for v in line_cross {
    total_cross += v
  }
  let pct_cb = match cbh {
    Some(_) => cbh
    None => self.pct_h
  }
  let cross_size = if column {
    cw
  } else {
    let lo = match specified_h(b, css::p_min_height, pct_cb) {
      Some(v) => v - vedges(b)
      None => 0.0
    }
    let hi : Option[Double] = match specified_h(b, css::p_max_height, pct_cb) {
      Some(v) => Some(v - vedges(b))
      None => None
    }
    let t = match inner_h {
      Some(h) => h
      None => dmax(total_cross, lo)
    }
    // (a single line's cross size with no height given, CSS Flexbox 1 §9.4 step 8: the container's content height then)
    if !wrap && lines.length() == 1 {
      let auto_t = dmax(total_cross, lo)
      let auto_cross = match hi {
        Some(m) => if auto_t > m { dmax(m, lo) } else { dmax(auto_t, lo) }
        None => dmax(auto_t, lo)
      }
      b.auto_h = dmax(auto_cross, 0.0) + vedges(b)
      b.auto_geom = b.geom
    }
    match hi {
      Some(m) => if t > m { dmax(m, lo) } else { dmax(t, lo) }
      None => dmax(t, lo)
    }
  }
  let align_content = b.style.word_id(css::p_align_content)
  let stretch_lines = align_content == "" || align_content == "stretch" || align_content == "normal"
  if !wrap && lines.length() == 1 {
    line_cross[0] = cross_size
  }
  let mut extra_each = 0.0
  let mut lines_start = 0.0
  let mut lines_between = 0.0
  if wrap && lines.length() > 0 {
    let nl = lines.length().to_double()
    let free_c = cross_size - total_cross
    let wrap_rev = wrap_word == "wrap-reverse"
    if align_content == "start" && wrap_rev {
      lines_start = free_c
    } else if align_content == "end" && wrap_rev {
      ()
    } else if align_content == "flex-end" || align_content == "end" {
      lines_start = free_c
    } else if align_content == "center" {
      lines_start = free_c / 2.0
    } else if align_content == "space-between" {
      if nl > 1.0 && free_c > 0.0 { lines_between = free_c / (nl - 1.0) }
    } else if align_content == "space-around" {
      if free_c > 0.0 {
        lines_between = free_c / nl
        lines_start = lines_between / 2.0
      } else {
        lines_start = free_c / 2.0
      }
    } else if align_content == "space-evenly" {
      if free_c > 0.0 {
        lines_between = free_c / (nl + 1.0)
        lines_start = lines_between
      } else {
        lines_start = free_c / 2.0
      }
    } else if stretch_lines {
      extra_each = dmax(free_c, 0.0) / nl
    }
  }
  // Positions
  let ox = b.x + b.bl + b.pl
  let oy = b.y + b.bt + b.pt
  let mut cross_pos = lines_start
  let mut content_main = 0.0
  let mut first_from : Option[(Box, Bool)] = None
  let mut last_from : Option[(Box, Bool)] = None
  // CSS Flexbox 1 §9.5: auto-height column flex container clamps its main size by min-height / max-height
  // before main-axis alignment (justify-content / auto margins).
  let col_min_main = if column && main_size.is_none() {
    match specified_h(b, css::p_min_height, pct_cb) {
      Some(v) => dmax(v - vedges(b), 0.0)
      None => 0.0
    }
  } else {
    0.0
  }
  let col_max_main : Option[Double] = if column && main_size.is_none() {
    match specified_h(b, css::p_max_height, pct_cb) {
      Some(v) => Some(dmax(v - vedges(b), 0.0))
      None => None
    }
  } else {
    None
  }
  for li, line in lines {
    let lc = line_cross[li] + extra_each
    let mut sum = (line.length() - 1).to_double() * gap_main
    let mut autos = 0
    for it in line {
      sum += it.main + flex_mm(it, column)
      let a_id = if column { css::p_margin_top } else { css::p_margin_left }
      let z_id = if column { css::p_margin_bottom } else { css::p_margin_right }
      if it.box.style.word_id(a_id) == "auto" { autos += 1 }
      if it.box.style.word_id(z_id) == "auto" { autos += 1 }
    }
    let size = match main_size {
      Some(m) => m
      None => {
        let lo = dmax(sum, col_min_main)
        match col_max_main {
          Some(hi) => if lo > hi { dmax(hi, col_min_main) } else { lo }
          None => lo
        }
      }
    }
    content_main = dmax(content_main, sum)
    let free = size - sum
    let n = line.length().to_double()
    let raw_jc = b.style.word_id(css::p_justify_content)
    let jc = if reverse && (raw_jc == "flex-start" || raw_jc == "normal" || raw_jc == "") {
      "flex-end"
    } else if reverse && raw_jc == "flex-end" {
      "flex-start"
    } else {
      raw_jc
    }
    let (start, between) = if autos > 0 {
      (0.0, 0.0)
    } else if jc == "flex-end" || jc == "end" || jc == "right" {
      (free, 0.0)
    } else if jc == "center" {
      (free / 2.0, 0.0)
    } else if jc == "space-between" {
      if line.length() > 1 && free > 0.0 { (0.0, free / (n - 1.0)) } else { (0.0, 0.0) }
    } else if jc == "space-around" {
      if free > 0.0 { (free / n / 2.0, free / n) } else { (free / 2.0, 0.0) }
    } else if jc == "space-evenly" {
      if free > 0.0 { (free / (n + 1.0), free / (n + 1.0)) } else { (free / 2.0, 0.0) }
    } else {
      (0.0, 0.0)
    }
    let auto_each = if autos > 0 { dmax(free, 0.0) / autos.to_double() } else { 0.0 }
    let mut pos = start
    let mut col_first = 0.0
    let mut col_last = 0.0
    let col_rtl = column && b.style.word_id(css::p_direction) == "rtl"
    let start_m = fn(c : Box) -> Double { if col_rtl { c.mr } else { c.ml } }
    let col_wrap_rev = column && wrap_word == "wrap-reverse"
    let turned = b.style.word_id(css::p__fv_central) == "1" || b.style.word_id(css::p__fv_turned) == "1"
    let mut col_top = 0.0
    let end_m = fn(c : Box) -> Double { if col_rtl { c.ml } else { c.mr } }
    let mut col_aligned = false
    if column {
      for it in line {
        let sa = it.al
        if sa == "baseline" || sa == "first" || sa == "last" { col_aligned = true }
        if sa == "baseline" || sa == "first" {
          col_first = dmax(col_first, start_m(it.box))
          col_top = dmax(col_top, it.box.ml)
        } else if sa == "last" {
          col_last = dmax(col_last, end_m(it.box))
        }
      }
    }
    let seq = if reverse { rev_flex_items(line) } else { line }
    if reverse {
      pos = start
    }
    for it in seq {
      let c = it.box
      let al = it.al
      if !column {
        let mut cross_off = 0.0
        let auto_mt = (c.style.auto_margins() & 1) != 0
        let auto_mb = (c.style.auto_margins() & 4) != 0
        let stretchy = (al == "" || al == "stretch" || al == "normal") &&
        specified_h(c, css::p_height, inner_h).is_none() &&
        !is_intrinsic_h(c) &&
        !auto_mt && !auto_mb
        if auto_mt || auto_mb {
          let free_c = dmax(lc - c.h - c.mt - c.mb, 0.0)
          cross_off = if auto_mt && auto_mb { free_c / 2.0 } else if auto_mt { free_c } else { 0.0 }
        } else if stretchy {
          let h = dmax(lc - c.mt - c.mb, 0.0)
          if it.answered || h != c.h || self.has_percent_height(c) {
            self.layout_root(c, 0.0, 0.0, cw, Some(h), Some(it.main), Some(h))
          }
        } else {
          let free_c = lc - c.h - c.mt - c.mb
          cross_off = if al == "flex-end" || al == "end" {
            free_c
          } else if al == "center" {
            free_c / 2.0
          } else if (al == "baseline" || al == "first") && li < line_base.length() && flex_by_baseline(al, column) {
            line_base[li] - flex_base_of(c, wrap_rev_lines)
          } else if al == "last" && li < line_below.length() && flex_by_last(al, column, wrap_rev_lines) {
            lc - (line_below[li] - flex_below_last(c)) - (c.mt + c.h + c.mb)
          } else {
            0.0
          }
        }
        // Apply main-axis auto margins AFTER any stretched layout_root (which calls set_edges and resets auto margins to 0).
        if (c.style.auto_margins() & 8) != 0 { c.ml = auto_each }
        if (c.style.auto_margins() & 2) != 0 { c.mr = auto_each }
        self.shift(c, ox + pos + c.ml - c.x, oy + cross_pos + cross_off + c.mt - c.y)
        pos += it.main + c.ml + c.mr + gap_main + between
      } else {
        if wrap && (al == "" || al == "stretch" || al == "normal") &&
        specified_w(c, css::p_width, Some(cw)).is_none() &&
        (c.style.auto_margins() & 8) == 0 &&
        (c.style.auto_margins() & 2) == 0 {
          let w = clamp_w(c, dmax(lc - c.ml - c.mr, 0.0), Some(cw))
          if w != c.w {
            self.items_indefinite = pct_main.is_none() && !definite_basis(c) && ratio_h(c, w).is_none()
            self.layout_root(c, 0.0, 0.0, cw, inner_h, Some(w), Some(it.main))
          }
        }
        // Apply main-axis auto margins AFTER any stretched layout_root (which calls set_edges and resets auto margins to 0).
        if (c.style.auto_margins() & 1) != 0 { c.mt = auto_each }
        if (c.style.auto_margins() & 4) != 0 { c.mb = auto_each }
        let free_c = lc - c.w - c.ml - c.mr
        let auto_ml = (c.style.auto_margins() & 8) != 0
        let auto_mr = (c.style.auto_margins() & 2) != 0
        let cross_off = if auto_ml && auto_mr {
          free_c / 2.0
        } else if auto_ml {
          free_c
        } else if al == "flex-end" || al == "end" {
          free_c
        } else if al == "center" {
          free_c / 2.0
        } else if (al == "baseline" || al == "first") && col_rtl && turned {
          free_c - (col_top - c.ml)
        } else if (al == "baseline" || al == "first" || al == "last") && col_wrap_rev {
          0.0
        } else if al == "baseline" || al == "first" {
          col_first - start_m(c) - (if col_rtl { c.ml } else { 0.0 })
        } else if al == "last" {
          free_c - (col_last - end_m(c)) + (if col_rtl { c.mr - c.ml } else { 0.0 })
        } else {
          0.0
        }
        self.shift(c, ox + cross_pos + cross_off + c.ml - c.x, oy + pos + c.mt - c.y)
        pos += it.main + c.mt + c.mb + gap_main + between
      }
    }
    // (after the line's items are placed: each item placed moves none of these boxes' baselines, and they go where
    // the line's baseline boxes put them)
    if column && !col_rtl && !col_wrap_rev && !turned && col_aligned {
      let lefts : Array[(Box, Double)] = []
      let rights : Array[(Box, Double)] = []
      for it2 in line {
        let c2 = it2.box
        let al2 = it2.al
        if (al2 != "baseline" && al2 != "first" && al2 != "last") ||
        (c2.style.auto_margins() & 8) != 0 ||
        (c2.style.auto_margins() & 2) != 0 {
          continue
        }
        let is_last = al2 == "last"
        let vm = vertical_mode(c2.style)
        let v = if is_last && c2.last_baseline.is_some() { c2.last_baseline } else { c2.baseline }
        let (x, is_left) = match v {
          Some(bv) =>
          if vm == 1 {
            (bv, !is_last)
          } else if vm == 2 {
            (c2.w - bv, is_last)
          } else if is_last {
            (c2.w, false)
          } else {
            (0.0, true)
          }
          None => if is_last { (c2.w, false) } else { (0.0, true) }
        }
        if is_left {
          lefts.push((c2, x))
        } else {
          rights.push((c2, x))
        }
      }
      let line_x = ox + cross_pos
      let mut l = 0.0
      for e in lefts {
        l = dmax(l, e.0.ml + e.1)
      }
      for e in lefts {
        self.shift(e.0, line_x + l - e.1 - e.0.x, 0.0)
      }
      let mut r = 0.0
      for e in rights {
        r = dmax(r, e.0.mr + e.0.w - e.1)
      }
      for e in rights {
        self.shift(e.0, line_x + lc - r - e.1 - e.0.x, 0.0)
      }
    }
    let last_line = if wrap_rev_lines { 0 } else { lines.length() - 1 }
    let first_line = lines.length() - 1 - last_line
    if li == last_line && line.length() > 0 {
      let shown = if reverse { line } else { rev_flex_items(line) }
      let mut found : Option[FlexItem] = None
      for it in shown {
        if flex_aligns_by_baseline(it, column) {
          found = Some(it)
          break
        }
      }
      if found.is_none() {
        for it in shown {
          if it.box.baseline.is_some() {
            found = Some(it)
            break
          }
        }
      }
      last_from = match found {
        Some(it) => Some((it.box, true))
        None => Some((shown[0].box, false))
      }
    }
    if li == first_line && line.length() > 0 {
      let shown = if reverse { rev_flex_items(line) } else { line }
      let mut first : Option[FlexItem] = None
      for it in shown {
        if flex_aligns_by_baseline(it, column) {
          first = Some(it)
          break
        }
      }
      if first.is_none() {
        for it in shown {
          if it.box.baseline.is_some() {
            first = Some(it)
            break
          }
        }
      }
      first_from = match first {
        Some(it) => Some((it.box, true))
        None => Some((shown[0].box, false))
      }
    }
    cross_pos += lc + gap_cross + lines_between
  }
  match given_h {
    None => {
      let content = if column { content_main } else { cross_pos - gap_cross }
      b.h = dmax(content, 0.0) + vedges(b)
    }
    Some(h) => b.h = h
  }
  if !column && b.style.word_id(css::p_direction) == "rtl" {
    for line in lines {
      for it in line {
        let c = it.box
        let left = c.x - c.ml - ox
        self.shift(c, cw - left - (c.w + c.ml + c.mr) - left, 0.0)
      }
    }
  }
  let mirror = (wrap_word == "wrap-reverse") != (column && b.style.word_id(css::p_direction) == "rtl")
  if mirror {
    for line in lines {
      for it in line {
        let c = it.box
        if column {
          let room = cw
          let left = c.x - c.ml - ox
          self.shift(c, room - left - (c.w + c.ml + c.mr) - left, 0.0)
        } else {
          let room = b.h - vedges(b)
          let top = c.y - c.mt - oy
          self.shift(c, 0.0, room - top - (c.h + c.mt + c.mb) - top)
        }
      }
    }
  }
  for w in wrappers {
    self.settle(w)
  }
  match first_from {
    Some((c, true)) =>
    match c.baseline {
      Some(bv) => b.baseline = Some(c.y - b.y + bv)
      None => b.baseline = Some(c.y - b.y + c.h)
    }
    Some((c, false)) => b.baseline = Some(c.y - b.y + c.h)
    None => ()
  }
  match last_from {
    Some((c, true)) => {
      let bv = match c.last_baseline {
        Some(v) => v
        None => match c.baseline { Some(v) => v None => c.h }
      }
      b.last_baseline = Some(c.y - b.y + bv)
    }
    Some((c, false)) => b.last_baseline = Some(c.y - b.y + c.h)
    None => ()
  }
}

fn Lay::has_percent_height(self : Lay, b : Box) -> Bool {
  if b.pct_h_pass == self.pass || (b.pct_h_pass == known_always && self.turned == 0) {
    return b.pct_h
  }
  let mut found = false
  for c in b.children {
    if has_pct_tok(c.style.get_id(css::p_height)) ||
    has_pct_tok(c.style.get_id(css::p_min_height)) ||
    has_pct_tok(c.style.get_id(css::p_max_height)) {
      found = true
      break
    }
    if !(c.kind is Kind::Replaced(_, _)) {
      let hv = c.style.get_id(css::p_height)
      let is_auto_or_ident = hv.length() == 0 || (hv.length() == 1 && (match hv[0] { css::Tok::Ident(_) => true _ => false }))
      if is_auto_or_ident && self.has_percent_height(c) {
        found = true
        break
      }
    }
  }
  b.pct_h_pass = if self.turned == 0 { known_always } else { self.pass }
  b.pct_h = found
  found
}

fn Lay::cross_width(self : Lay, c : Box, cw : Double, parent : Box, fit : Bool) -> Double {
  set_edges(c, cw)
  match specified_w(c, css::p_width, Some(cw)) {
    Some(v) => clamp_w(c, v, Some(cw))
    None => {
      let s = c.style.word_id(css::p_align_self)
      let al = if s != "" && s != "auto" { s } else { parent.style.word_id(css::p_align_items) }
      let am = (c.style.auto_margins() & 8) != 0 || (c.style.auto_margins() & 2) != 0
      if (al == "" || al == "stretch" || al == "normal") && !am && !fit {
        clamp_w(c, dmax(cw - c.ml - c.mr, 0.0), Some(cw))
      } else {
        clamp_w(c, dmin(self.max_content(c), cw - c.ml - c.mr), Some(cw))
      }
    }
  }
}

// =========================================================================
// Tables
// =========================================================================

struct TableCell {
  box : Box
  col : Int
  span : Int
  row : Int
  rowspan : Int
}

fn int_attr(b : Box, name : String) -> Int {
  match b.node {
    Some(n) =>
    match n.attr(name) {
      Some(v) => {
        let d = css::parse_double(v).to_int()
        if d >= 1 { d } else { 1 }
      }
      None => 1
    }
    None => 1
  }
}

fn table_rows(b : Box) -> Array[Box] {
  settle(b)
  let out : Array[Box] = []
  for c in b.children {
    match c.kind {
      Kind::Row => out.push(c)
      Kind::RowGroup => {
        for r in table_rows(c) {
          out.push(r)
        }
      }
      Kind::Cell => {
        if out.length() == 0 {
          out.push(new_box(None, b.style.anonymous(), Kind::Row))
        }
        out[out.length() - 1].children.push(c)
      }
      _ => ()
    }
  }
  out
}

fn grid_of(rows : Array[Box]) -> (Array[TableCell], Int) {
  let cells : Array[TableCell] = []
  let taken : intmap::IntMap[Int] = intmap::IntMap::new()
  let mut cols = 0
  for r, row in rows {
    let mut col = 0
    for c in row.children {
      if !(c.kind is Kind::Cell) {
        continue
      }
      while taken.contains(r * 4096 + col) {
        col += 1
      }
      let span = int_attr(c, "colspan")
      let rowspan = int_attr(c, "rowspan")
      for i in 0..<rowspan {
        for j in 0..<span {
          taken.set((r + i) * 4096 + col + j, 1)
        }
      }
      cells.push(TableCell::{ box: c, col: col, span: span, row: r, rowspan: rowspan })
      col += span
      if col > cols {
        cols = col
      }
    }
  }
  (cells, cols)
}

fn spacing_of(b : Box) -> Double {
  if b.style.word_id(css::p_border_collapse) == "collapse" {
    return 0.0
  }
  let ws = css::words(b.style.get_id(css::p_border_spacing))
  if ws.length() == 0 {
    return 0.0
  }
  match b.style.length_of(ws[0]) {
    Some(l) => l.px
    None => 0.0
  }
}

fn Lay::column_widths(self : Lay, b : Box) -> (Array[Double], Array[Double], Array[Option[Double]]) {
  let rows = table_rows(b)
  let (cells, cols) = grid_of(rows)
  let mn : Array[Double] = []
  let mx : Array[Double] = []
  let fixed : Array[Option[Double]] = []
  for _ in 0..<cols {
    mn.push(0.0)
    mx.push(0.0)
    fixed.push(None)
  }
  for c in cells {
    let lo = self.min_content(c.box)
    let hi = self.max_content(c.box)
    if c.span == 1 {
      mn[c.col] = dmax(mn[c.col], lo)
      mx[c.col] = dmax(mx[c.col], hi)
      match specified_w(c.box, css::p_width, None) {
        Some(v) => {
          let prev = match fixed[c.col] { Some(p) => p None => 0.0 }
          fixed[c.col] = Some(dmax(prev, v))
        }
        None => ()
      }
    }
  }
  for c in cells {
    if c.span > 1 {
      let mut sum_mn = 0.0
      let mut sum_mx = 0.0
      for i in 0..<c.span {
        sum_mn += mn[c.col + i]
        sum_mx += mx[c.col + i]
      }
      let lo = self.min_content(c.box)
      let hi = self.max_content(c.box)
      let n = c.span.to_double()
      if lo > sum_mn {
        for i in 0..<c.span {
          mn[c.col + i] = mn[c.col + i] + (lo - sum_mn) / n
        }
      }
      if hi > sum_mx {
        for i in 0..<c.span {
          mx[c.col + i] = mx[c.col + i] + (hi - sum_mx) / n
        }
      }
    }
  }
  (mn, mx, fixed)
}

fn Lay::table_intrinsic(self : Lay, b : Box, max : Bool) -> Double {
  match inner_kind(b) {
    Kind::Table => {
      let (mn, mx, fixed) = self.column_widths(b)
      let sp = spacing_of(b)
      let mut s = sp * (mn.length() + 1).to_double()
      for i in 0..<mn.length() {
        s += match fixed[i] {
          Some(v) => dmax(v, mn[i])
          None => if max { mx[i] } else { mn[i] }
        }
      }
      for c in b.children {
        if c.kind is Kind::Caption {
          s = dmax(s, self.min_content(c))
        }
      }
      s
    }
    _ => self.inline_or_block_intrinsic(b, max, false, false)
  }
}

fn collapse_borders(b : Box, rows : Array[Box], cells : Array[TableCell], cols : Int) -> Unit {
  if b.style.word_id(css::p_border_collapse) != "collapse" {
    return
  }
  let nrows = rows.length()
  let bw_top = fn(x : Box) -> Double { border_width_id(x, css::p_border_top_style, css::p_border_top_width) }
  let bw_right = fn(x : Box) -> Double { border_width_id(x, css::p_border_right_style, css::p_border_right_width) }
  let bw_bottom = fn(x : Box) -> Double { border_width_id(x, css::p_border_bottom_style, css::p_border_bottom_width) }
  let bw_left = fn(x : Box) -> Double { border_width_id(x, css::p_border_left_style, css::p_border_left_width) }
  let at : intmap::IntMap[Box] = intmap::IntMap::new()
  for c in cells {
    for i in 0..<c.rowspan {
      for j in 0..<c.span {
        at.set((c.row + i) * 4096 + c.col + j, c.box)
      }
    }
  }
  let tt = bw_top(b)
  let tr = bw_right(b)
  let tb = bw_bottom(b)
  let tl = bw_left(b)
  let mut edge_t = tt
  let mut edge_r = tr
  let mut edge_b = tb
  let mut edge_l = tl
  for c in cells {
    let x = c.box
    let top = if c.row == 0 {
      edge_t = dmax(edge_t, bw_top(x))
      dmax(tt, bw_top(x))
    } else {
      match intmap::get(at, (c.row - 1) * 4096 + c.col) {
        Some(n) => dmax(bw_top(x), bw_bottom(n))
        None => bw_top(x)
      }
    }
    let last_row = c.row + c.rowspan >= nrows
    let bottom = if last_row {
      edge_b = dmax(edge_b, bw_bottom(x))
      dmax(tb, bw_bottom(x))
    } else {
      match intmap::get(at, (c.row + c.rowspan) * 4096 + c.col) {
        Some(n) => dmax(bw_bottom(x), bw_top(n))
        None => bw_bottom(x)
      }
    }
    let left = if c.col == 0 {
      edge_l = dmax(edge_l, bw_left(x))
      dmax(tl, bw_left(x))
    } else {
      match intmap::get(at, c.row * 4096 + c.col - 1) {
        Some(n) => dmax(bw_left(x), bw_right(n))
        None => bw_left(x)
      }
    }
    let right = if c.col + c.span >= cols {
      edge_r = dmax(edge_r, bw_right(x))
      dmax(tr, bw_right(x))
    } else {
      match intmap::get(at, c.row * 4096 + c.col + c.span) {
        Some(n) => dmax(bw_right(x), bw_left(n))
        None => bw_right(x)
      }
    }
    x.collapsed = Some((top / 2.0, right / 2.0, bottom / 2.0, left / 2.0))
  }
  b.collapsed = Some((edge_t / 2.0, edge_r / 2.0, edge_b / 2.0, edge_l / 2.0))
}

fn Lay::layout_table(self : Lay, b : Box, given_h : Option[Double]) -> Unit {
  let rows = table_rows(b)
  let (cells, cols) = grid_of(rows)
  let sp = spacing_of(b)
  let (mn, mx, fixed) = self.column_widths(b)
  let inner = dmax(b.w - hedges(b) - sp * (cols + 1).to_double(), 0.0)
  let widths : Array[Double] = []
  let mut sum = 0.0
  for i in 0..<cols {
    let w = match fixed[i] {
      Some(v) => dmax(v, mn[i])
      None => mx[i]
    }
    widths.push(w)
    sum += w
  }
  if sum > inner {
    let mut room = 0.0
    for i in 0..<cols {
      room += widths[i] - mn[i]
    }
    let cut = sum - inner
    for i in 0..<cols {
      if room > 0.0 {
        widths[i] = widths[i] - (widths[i] - mn[i]) * dmin(cut / room, 1.0)
      }
    }
  } else if sum < inner && sum > 0.0 {
    let mut flex_sum = 0.0
    for i in 0..<cols {
      if fixed[i].is_none() {
        flex_sum += widths[i]
      }
    }
    let extra = inner - sum
    for i in 0..<cols {
      if flex_sum > 0.0 {
        if fixed[i].is_none() {
          widths[i] = widths[i] + extra * widths[i] / flex_sum
        }
      } else {
        widths[i] = widths[i] + extra * widths[i] / sum
      }
    }
  } else if sum == 0.0 && cols > 0 {
    for i in 0..<cols {
      widths[i] = inner / cols.to_double()
    }
  }
  let xs : Array[Double] = []
  for _ in 0..<(cols + 1) {
    xs.push(0.0)
  }
  xs[0] = sp
  for i in 0..<cols {
    xs[i + 1] = xs[i] + widths[i] + sp
  }
  let heights : Array[Double] = []
  for _ in 0..<rows.length() {
    heights.push(0.0)
  }
  for c in cells {
    let w = xs[c.col + c.span] - xs[c.col] - sp
    self.layout_root(c.box, 0.0, 0.0, w, None, Some(w), None)
    if c.rowspan == 1 {
      heights[c.row] = dmax(heights[c.row], c.box.h)
    }
  }
  for r, row in rows {
    match specified_h(row, css::p_height, None) {
      Some(h) => heights[r] = dmax(heights[r], h)
      None => ()
    }
  }
  let mut y = b.y
  let cap_w = b.w
  for c in b.children {
    if c.kind is Kind::Caption && c.style.word_id(css::p_caption_side) != "bottom" {
      set_edges(c, cap_w)
      self.layout_root(c, b.x + c.ml, y + c.mt, cap_w, None, Some(dmax(cap_w - c.ml - c.mr, 0.0)), None)
      y += c.h + c.mt + c.mb
    }
  }
  y += b.bt + b.pt + sp
  for r, row in rows {
    row.x = b.x + b.bl + b.pl + sp
    row.y = y
    row.w = inner + sp * (cols - 1).to_double()
    row.h = heights[r]
    y += heights[r] + sp
  }
  for c in cells {
    let row = rows[c.row]
    let mut h = 0.0
    for i in 0..<c.rowspan {
      if c.row + i < rows.length() {
        h += heights[c.row + i] + (if i > 0 { sp } else { 0.0 })
      }
    }
    let content_h = c.box.h
    c.box.h = h
    let va = c.box.style.word_id(css::p_vertical_align)
    let off = if va == "top" || va == "baseline" {
      0.0
    } else if va == "bottom" {
      h - content_h
    } else {
      (h - content_h) / 2.0
    }
    for k in c.box.children {
      if !out_of_flow(k.style) {
        self.shift(k, 0.0, off)
      }
    }
    for f in c.box.frags {
      f.y += off
    }
    self.shift(c.box, b.x + b.bl + b.pl + xs[c.col] - c.box.x, row.y - c.box.y)
  }
  for c in b.children {
    if c.kind is Kind::RowGroup {
      let group = c
      self.settle(group)
      let inner_rows = table_rows(group)
      if inner_rows.length() > 0 {
        group.x = inner_rows[0].x
        group.y = inner_rows[0].y
        group.w = inner_rows[0].w
        let last = inner_rows[inner_rows.length() - 1]
        group.h = last.y + last.h - group.y
      } else {
        group.x = b.x + b.bl + b.pl
        group.y = y
        group.w = 0.0
        group.h = 0.0
      }
    }
  }
  y += b.pb + b.bb
  for c in b.children {
    if c.kind is Kind::Caption && c.style.word_id(css::p_caption_side) == "bottom" {
      set_edges(c, cap_w)
      self.layout_root(c, b.x + c.ml, y + c.mt, cap_w, None, Some(dmax(cap_w - c.ml - c.mr, 0.0)), None)
      y += c.h + c.mt + c.mb
    }
  }
  b.h = match given_h {
    Some(h) => h
    None => y - b.y
  }
  if b.kind is Kind::Atomic {
    let mut found_row : Option[Box] = None
    for r in table_rows(b) {
      if r.children.length() > 0 {
        found_row = Some(r)
        break
      }
    }
    b.baseline = match found_row {
      Some(r) => {
        let c = r.children[0]
        let v = match first_baseline(c) {
          Some(v0) => v0
          None => c.y + c.h - c.bb - c.pb
        }
        Some(v - b.y)
      }
      None => None
    }
  }
}

fn first_baseline(b : Box) -> Option[Double] {
  settle(b)
  match b.baseline {
    Some(v) => return Some(v + b.y)
    None => ()
  }
  for c in b.children {
    if out_of_flow(c.style) || floated(c.style) {
      continue
    }
    match c.kind {
      Kind::Block =>
      match first_baseline(c) {
        Some(v) => return Some(v)
        None => ()
      }
      Kind::Cell =>
      match first_baseline(c) {
        Some(v) => return Some(v)
        None => ()
      }
      Kind::Flex =>
      match c.baseline {
        Some(v) => return Some(v + c.y)
        None => ()
      }
      Kind::Grid =>
      match c.baseline {
        Some(v) => return Some(v + c.y)
        None => ()
      }
      _ => ()
    }
  }
  None
}

fn shift_self(b : Box, x : Double, y : Double) -> Unit {
  shift(b, x - b.x, y - b.y)
}

// =========================================================================
// Grids
// =========================================================================

enum Track {
  Fixed(Double)
  Fr(Double)
  AutoTrack
  MinContent
  MaxContent
  FitContent(Double)
  MinMax(Double, Double)
  FrMin(Double, Double)
  ContentMin(Bool, Double)
}

fn align_kind(v : String) -> String {
  if v == "center" {
    "center"
  } else if v == "end" || v == "flex-end" || v == "self-end" || v == "right" {
    "end"
  } else if v == "start" || v == "flex-start" || v == "self-start" || v == "left" ||
  v == "baseline" || v == "first" || v == "last" {
    "start"
  } else {
    "stretch"
  }
}

fn content_spread(v : String, free : Double, n : Int) -> (Double, Double) {
  if v == "center" {
    (free / 2.0, 0.0)
  } else if v == "end" || v == "flex-end" || v == "right" {
    (free, 0.0)
  } else if v == "space-between" {
    if free > 0.0 && n > 1 { (0.0, free / (n - 1).to_double()) } else { (0.0, 0.0) }
  } else if v == "space-around" {
    if free > 0.0 && n > 0 { (free / n.to_double() / 2.0, free / n.to_double()) } else { (free / 2.0, 0.0) }
  } else if v == "space-evenly" {
    if free > 0.0 && n > 0 {
      (free / (n + 1).to_double(), free / (n + 1).to_double())
    } else {
      (free / 2.0, 0.0)
    }
  } else {
    (0.0, 0.0)
  }
}

fn self_place(grid : Box, c : Box, own_prop : Int, items_prop : Int, kind : String) -> String {
  let own = c.style.word_id(own_prop)
  let v = if own == "" || own == "auto" { grid.style.word_id(items_prop) } else { own }
  let horizontal = fn(x : Box) -> Bool {
    let wm = x.style.word_id(css::p_writing_mode)
    (wm == "" || wm == "horizontal-tb") && !x.style.values.contains_id(css::p__fv_turned)
  }
  if (v == "self-start" || v == "self-end") && own_prop == css::p_justify_self &&
  horizontal(grid) && horizontal(c) &&
  c.style.word_id(css::p_direction) != grid.style.word_id(css::p_direction) {
    return if v == "self-start" { "end" } else { "start" }
  }
  kind
}

fn has_ratio(c : Box) -> Bool {
  if !(c.kind is Kind::Replaced(_, _)) {
    return false
  }
  match c.node {
    Some(n) => n.tag != "input" && n.tag != "select" && n.tag != "textarea" && n.tag != "button"
    None => true
  }
}

fn grid_justify(grid : Box, c : Box) -> String {
  let own = c.style.word_id(css::p_justify_self)
  let v = if own == "" || own == "auto" { grid.style.word_id(css::p_justify_items) } else { own }
  if (v == "" || v == "normal" || v == "legacy") && has_ratio(c) {
    return "start"
  }
  align_kind(v)
}

fn grid_align(grid : Box, c : Box) -> String {
  let own = c.style.word_id(css::p_align_self)
  let v = if own == "" || own == "auto" { grid.style.word_id(css::p_align_items) } else { own }
  if (v == "" || v == "normal") && has_ratio(c) {
    return "start"
  }
  align_kind(v)
}

fn tok_slice(arr : Array[css::Tok], lo : Int, hi : Int) -> Array[css::Tok] {
  let out : Array[css::Tok] = []
  let mut i = lo
  while i < hi && i < arr.length() {
    out.push(arr[i])
    i += 1
  }
  out
}

fn tok_strip_spaces(arr : Array[css::Tok]) -> Array[css::Tok] {
  let out : Array[css::Tok] = []
  for t in arr {
    if !(t is css::Tok::Space) {
      out.push(t)
    }
  }
  out
}

fn tok_find_comma(arr : Array[css::Tok]) -> Option[Int] {
  let mut depth = 0
  for i, t in arr {
    match t {
      css::Tok::Function(_) | css::Tok::OpenParen => depth += 1
      css::Tok::CloseParen => if depth > 0 { depth -= 1 }
      css::Tok::Comma => if depth == 0 { return Some(i) }
      _ => ()
    }
  }
  None
}

fn tok_find_slash(arr : Array[css::Tok]) -> Option[Int] {
  let mut depth = 0
  for i, t in arr {
    match t {
      css::Tok::OpenParen | css::Tok::Function(_) | css::Tok::OpenSquare => depth += 1
      css::Tok::CloseParen | css::Tok::CloseSquare => if depth > 0 { depth -= 1 }
      css::Tok::Delim(c) => if c == 47 && depth == 0 { return Some(i) }
      _ => ()
    }
  }
  None
}

fn int_arr_contains(a : Array[Int], v : Int) -> Bool {
  for x in a {
    if x == v { return true }
  }
  false
}

fn split_track_items(v : Array[css::Tok]) -> Array[Array[css::Tok]] {
  let out : Array[Array[css::Tok]] = []
  let n = v.length()
  let mut i = 0
  while i < n {
    match v[i] {
      css::Tok::Space | css::Tok::End => i += 1
      css::Tok::Function(_) | css::Tok::OpenParen => {
        let item : Array[css::Tok] = [v[i]]
        let mut depth = 1
        i += 1
        while i < n && depth > 0 {
          match v[i] {
            css::Tok::Function(_) | css::Tok::OpenParen => depth += 1
            css::Tok::CloseParen => depth -= 1
            _ => ()
          }
          item.push(v[i])
          i += 1
        }
        out.push(item)
      }
      css::Tok::OpenSquare => {
        let item : Array[css::Tok] = [v[i]]
        let mut depth = 1
        i += 1
        while i < n && depth > 0 {
          match v[i] {
            css::Tok::OpenSquare => depth += 1
            css::Tok::CloseSquare => depth -= 1
            _ => ()
          }
          item.push(v[i])
          i += 1
        }
        out.push(item)
      }
      t => {
        out.push([t])
        i += 1
      }
    }
  }
  out
}

let empty_tracks : Array[Track] = []
let empty_line_names : Map[String, Array[Int]] = Map::new()

fn parse_tracks(
  b : Box,
  v : Array[css::Tok],
  avail : Double,
  gap : Double,
  names : Option[Map[String, Array[Int]]],
) -> Array[Track] {
  if v.length() == 0 {
    return empty_tracks
  }
  let base : Option[Double] = if avail > 0.0 { Some(avail) } else { None }
  let out : Array[Track] = []
  let name_line = fn(m : Map[String, Array[Int]], nm : String, line : Int) -> Unit {
    match m.get(nm) {
      Some(a) => if !int_arr_contains(a, line) { a.push(line) }
      None => m.set(nm, [line])
    }
  }
  for w in split_track_items(v) {
    if w.length() == 0 {
      continue
    }
    match w[0] {
      css::Tok::Function(f) => {
        let lf = inline_ascii_lower(f)
        if lf == "repeat" {
          let inner = tok_slice(w, 1, w.length() - 1)
          match tok_find_comma(inner) {
            Some(k) => {
              let inner_names : Option[Map[String, Array[Int]]] = match names {
                Some(_) => Some(Map::new())
                None => None
              }
              let list = parse_tracks(b, tok_slice(inner, k + 1, inner.length()), avail, gap, inner_names)
              let rep_toks = tok_strip_spaces(tok_slice(inner, 0, k))
              let count = if rep_toks.length() > 0 {
                match rep_toks[0] {
                  css::Tok::Number(n) => n.to_int()
                  _ => {
                    // CSS Grid Level 1 §7.2.2.2 (auto-fill / auto-fit):
                    // Use max track sizing function if definite, else min track sizing function,
                    // flooring max by min when both are definite, and include internal gaps.
                    let mut one = 0.0
                    for t in list {
                      one += match t {
                        Track::Fixed(x) => x
                        Track::FrMin(lo, _) => lo
                        Track::MinMax(lo, hi) => if hi >= lo { hi } else { lo }
                        Track::ContentMin(_, hi) => hi
                        Track::FitContent(hi) => hi
                        _ => 100.0
                      }
                    }
                    if list.length() > 1 {
                      one += (list.length() - 1).to_double() * gap
                    }
                    if one < 1.0 {
                      one = 1.0
                    }
                    if avail <= 0.0 {
                      1
                    } else {
                      let raw = ((avail + gap) / (one + gap)).floor().to_int()
                      if raw < 1 { 1 } else { raw }
                    }
                  }
                }
              } else {
                0
              }
              for _ in 0..<count {
                match (names, inner_names) {
                  (Some(m), Some(im)) => {
                    for nm in im.keys() {
                      match im.get(nm) {
                        Some(lines) => {
                          for l in lines {
                            name_line(m, nm, out.length() + l)
                          }
                        }
                        None => ()
                      }
                    }
                  }
                  _ => ()
                }
                for t in list {
                  out.push(t)
                }
              }
            }
            None => ()
          }
        } else if lf == "minmax" {
          let inner = tok_slice(w, 1, w.length() - 1)
          match tok_find_comma(inner) {
            Some(k) => {
              let lo = tok_strip_spaces(tok_slice(inner, 0, k))
              let hi = tok_strip_spaces(tok_slice(inner, k + 1, inner.length()))
              if hi.length() > 0 {
                match hi[0] {
                  css::Tok::Dimension(n, u) =>
                  if u == "fr" {
                    match b.style.length_of_against(lo, base) {
                      Some(l) => out.push(Track::FrMin(dmax(resolve(l, avail), 0.0), n))
                      None => out.push(Track::Fr(n))
                    }
                  } else {
                    match b.style.length_of_against(hi, base) {
                      Some(l) => {
                        let is_content_min = if lo.length() == 1 {
                          match lo[0] {
                            css::Tok::Ident(k0) => {
                              let lk0 = inline_ascii_lower(k0)
                              lk0 == "auto" || lk0 == "min-content" || lk0 == "max-content"
                            }
                            _ => false
                          }
                        } else {
                          false
                        }
                        if is_content_min {
                          let is_max = match lo[0] {
                            css::Tok::Ident(k0) => inline_ascii_lower(k0) == "max-content"
                            _ => false
                          }
                          out.push(Track::ContentMin(is_max, resolve(l, avail)))
                        } else {
                          let lo_v = match b.style.length_of_against(lo, base) {
                            Some(x) => resolve(x, avail)
                            None => 0.0
                          }
                          let hi_v = resolve(l, avail)
                          out.push(if lo_v >= hi_v { Track::Fixed(hi_v) } else { Track::MinMax(lo_v, hi_v) })
                        }
                      }
                      None => out.push(Track::AutoTrack)
                    }
                  }
                  css::Tok::Ident(hi_id) => {
                    let lhi = inline_ascii_lower(hi_id)
                    if lhi == "max-content" {
                      out.push(Track::MaxContent)
                    } else if lhi == "min-content" {
                      out.push(Track::MinContent)
                    } else {
                      out.push(Track::AutoTrack)
                    }
                  }
                  _ =>
                  match b.style.length_of_against(hi, base) {
                    Some(l) => {
                      let is_content_min = if lo.length() == 1 {
                        match lo[0] {
                          css::Tok::Ident(k0) => {
                            let lk0 = inline_ascii_lower(k0)
                            lk0 == "auto" || lk0 == "min-content" || lk0 == "max-content"
                          }
                          _ => false
                        }
                      } else {
                        false
                      }
                      if is_content_min {
                        let is_max = match lo[0] {
                          css::Tok::Ident(k0) => inline_ascii_lower(k0) == "max-content"
                          _ => false
                        }
                        out.push(Track::ContentMin(is_max, resolve(l, avail)))
                      } else {
                        let lo_v = match b.style.length_of_against(lo, base) {
                          Some(x) => resolve(x, avail)
                          None => 0.0
                        }
                        let hi_v = resolve(l, avail)
                        out.push(if lo_v >= hi_v { Track::Fixed(hi_v) } else { Track::MinMax(lo_v, hi_v) })
                      }
                    }
                    None => out.push(Track::AutoTrack)
                  }
                }
              }
            }
            None => ()
          }
        } else if lf == "fit-content" {
          let inner = tok_strip_spaces(tok_slice(w, 1, w.length() - 1))
          match b.style.length_of_against(inner, base) {
            Some(l) => out.push(Track::FitContent(resolve(l, avail)))
            None => out.push(Track::AutoTrack)
          }
        } else {
          match b.style.length_of_against(w, base) {
            Some(l) => out.push(Track::Fixed(resolve(l, avail)))
            None => out.push(Track::AutoTrack)
          }
        }
      }
      css::Tok::Dimension(n, u) =>
      if u == "fr" {
        out.push(Track::Fr(n))
      } else {
        match b.style.length_of_against(w, base) {
          Some(l) => out.push(Track::Fixed(resolve(l, avail)))
          None => out.push(Track::AutoTrack)
        }
      }
      css::Tok::OpenSquare => {
        match names {
          Some(m) => {
            let mut ti = 1
            while ti < w.length() {
              match w[ti] {
                css::Tok::Ident(nm) => name_line(m, nm, out.length() + 1)
                _ => ()
              }
              ti += 1
            }
          }
          None => ()
        }
      }
      css::Tok::Ident(k) => {
        let lk = inline_ascii_lower(k)
        if lk == "min-content" {
          out.push(Track::MinContent)
        } else if lk == "max-content" {
          out.push(Track::MaxContent)
        } else {
          match b.style.length_of_against(w, base) {
            Some(l) => out.push(Track::Fixed(resolve(l, avail)))
            None => out.push(Track::AutoTrack)
          }
        }
      }
      _ =>
      match b.style.length_of_against(w, base) {
        Some(l) => out.push(Track::Fixed(resolve(l, avail)))
        None => out.push(Track::AutoTrack)
      }
    }
  }
  out
}

fn Lay::grid_intrinsic(self : Lay, b : Box, max : Bool) -> Option[Double] {
  let tracks = parse_tracks(b, b.style.get_id(css::p_grid_template_columns), 0.0, 0.0, None)
  let n = tracks.length()
  if n == 0 {
    let mut flow_col = false
    for ft in b.style.get_id(css::p_grid_auto_flow) {
      match ft {
        css::Tok::Ident(w) if inline_ascii_lower(w) == "column" => flow_col = true
        _ => ()
      }
    }
    if flow_col {
      let auto_cols = parse_tracks(b, b.style.get_id(css::p_grid_auto_columns), 0.0, 0.0, None)
      let gap = len(b, css::p_column_gap, 0.0)
      let mut total = 0.0
      let mut count = 0
      for c in b.children {
        if out_of_flow(c.style) {
          continue
        }
        let mut is_text_item = false
        match c.kind {
          Kind::TextRun(t) =>
          if flex_is_whitespace_only(t) {
            continue
          } else {
            is_text_item = true
          }
          _ => ()
        }
        let cw = if auto_cols.length() > 0 {
          match auto_cols[count % auto_cols.length()] {
            Track::Fixed(v) => v
            _ =>
            if is_text_item {
              let (mn, mx) = self.inline_widths([c])
              if max { mx } else { mn }
            } else {
              self.outer_intrinsic(c, max)
            }
          }
        } else if is_text_item {
          let (mn, mx) = self.inline_widths([c])
          if max { mx } else { mn }
        } else {
          self.outer_intrinsic(c, max)
        }
        total += cw
        count += 1
      }
      if count > 0 {
        return Some(total + gap * (count - 1).to_double())
      }
    }
    return None
  }
  let single_zero_fr = match tracks[0] { Track::Fr(f) => f <= 0.0 _ => false }
  if n == 1 && !(tracks[0] is Track::FrMin(_, _) || tracks[0] is Track::Fixed(_) || single_zero_fr) {
    return None
  }
  let areas = area_map(b)
  let widths : Array[Double] = []
  for i in 0..<n {
    let w = match tracks[i] {
      Track::Fixed(v) => v
      Track::MinMax(a, _) => a
      Track::FrMin(m, _) => m
      _ => 0.0
    }
    widths.push(w)
  }
  let grows = fn(i : Int) -> Bool {
    let is_zero_fr = match tracks[i] { Track::Fr(f) => f <= 0.0 _ => false }
    !(tracks[i] is Track::Fixed(_)) && !is_zero_fr && (max || !(tracks[i] is Track::FrMin(_, _)))
  }
  let spanning : Array[(Int, Int, Double)] = []
  let mut next = 0
  for c in b.children {
    if out_of_flow(c.style) || c.kind is Kind::TextRun(_) {
      continue
    }
    let start = c.style.get_id(css::p_grid_column_start)
    let end_ = c.style.get_id(css::p_grid_column_end)
    let stripped = tok_strip_spaces(start)
    let named : Option[(Int, Int, Int, Int)] = if stripped.length() == 1 {
      match stripped[0] {
        css::Tok::Ident(nm) => {
          let lnm = inline_ascii_lower(nm)
          if lnm != "auto" && lnm != "span" { areas.get(nm) } else { None }
        }
        _ => None
      }
    } else {
      None
    }
    let (col0, span0) = match named {
      Some(a) => (a.1, a.3 - a.1)
      None => {
        let both : Array[css::Tok] = []
        for t in start { both.push(t) }
        both.push(css::Tok::Delim(47))
        for t in end_ { both.push(t) }
        let lo_res = line_of(both, n + 1)
        match lo_res.0 {
          Some(l) => if l >= 1 { (l - 1, lo_res.1) } else { (next, lo_res.1) }
          None => (next, lo_res.1)
        }
      }
    }
    let col = col0 % n
    let span = if span0 < 1 { 1 } else if col + span0 > n { n - col } else { span0 }
    next = col + span
    let v = self.outer_intrinsic(c, max)
    if span == 1 {
      widths[col] = match tracks[col] {
        Track::Fixed(x) => x
        Track::Fr(f) if f <= 0.0 => {
          // W3C CSS Grid 1 §11.5: a 0fr track has flex factor 0 and does not grow
          // beyond the item's automatic minimum size (0 when min-width: 0 or overflow-x != visible).
          let am = match specified_w(c, css::p_min_width, None) {
            Some(mv) => mv
            None => {
              let ov = c.style.word_id(css::p_overflow_x)
              if ov != "" && ov != "visible" { 0.0 } else { self.min_content(c) }
            }
          }
          dmax(widths[col], am + c.ml + c.mr)
        }
        Track::FrMin(m, _) => if max { dmax(widths[col], dmax(m, v)) } else { m }
        Track::MinMax(a, z) => dmax(widths[col], dmax(a, dmin(z, v)))
        Track::FitContent(l) => dmax(widths[col], dmin(l, v))
        _ => dmax(widths[col], v)
      }
    } else {
      spanning.push((col, span, v))
    }
  }
  let gap = len(b, css::p_column_gap, 0.0)
  for it in spanning {
    let (col, span, v) = it
    let mut have = gap * (span - 1).to_double()
    let mut growing = 0
    for i in col..<(col + span) {
      have += widths[i]
      if grows(i) { growing += 1 }
    }
    if v > have && growing > 0 {
      let add = (v - have) / growing.to_double()
      for i in col..<(col + span) {
        if grows(i) { widths[i] = widths[i] + add }
      }
    }
  }
  let mut total = gap * (n - 1).to_double()
  for w in widths {
    total += w
  }
  Some(total)
}

fn eval_grid_math_expr(toks : Array[css::Tok], pos : Int, end : Int) -> Option[(Double, Int)] {
  match eval_grid_math_term(toks, pos, end) {
    None => None
    Some((lhs, next_i)) => {
      let mut acc = lhs
      let mut i = next_i
      while i < end {
        while i < end && toks[i] is css::Tok::Space { i += 1 }
        if i >= end { break }
        match toks[i] {
          css::Tok::Delim(c) if c == 43 || c == 45 => {
            i += 1
            match eval_grid_math_term(toks, i, end) {
              Some((rhs, ni)) => {
                acc = if c == 43 { acc + rhs } else { acc - rhs }
                i = ni
              }
              None => return None
            }
          }
          _ => break
        }
      }
      Some((acc, i))
    }
  }
}

fn eval_grid_math_term(toks : Array[css::Tok], pos : Int, end : Int) -> Option[(Double, Int)] {
  match eval_grid_math_atom(toks, pos, end) {
    None => None
    Some((lhs, next_i)) => {
      let mut acc = lhs
      let mut i = next_i
      while i < end {
        while i < end && toks[i] is css::Tok::Space { i += 1 }
        if i >= end { break }
        match toks[i] {
          css::Tok::Delim(c) if c == 42 || c == 47 => {
            i += 1
            match eval_grid_math_atom(toks, i, end) {
              Some((rhs, ni)) => {
                if c == 42 {
                  acc = acc * rhs
                } else if rhs == 0.0 {
                  return None
                } else {
                  acc = acc / rhs
                }
                i = ni
              }
              None => return None
            }
          }
          _ => break
        }
      }
      Some((acc, i))
    }
  }
}

fn grid_group_end(toks : Array[css::Tok], start : Int, end : Int) -> Int {
  let mut depth = 1
  let mut i = start
  while i < end {
    match toks[i] {
      css::Tok::OpenParen | css::Tok::Function(_) => depth += 1
      css::Tok::CloseParen => {
        depth -= 1
        if depth == 0 { return i }
      }
      _ => ()
    }
    i += 1
  }
  end
}

fn eval_grid_math_func(name : String, toks : Array[css::Tok], start : Int, end : Int) -> Option[Double] {
  let lf = inline_ascii_lower(name)
  if lf == "calc" {
    match eval_grid_math_expr(toks, start, end) {
      Some((v, _)) => Some(v)
      None => None
    }
  } else if lf == "min" || lf == "max" || lf == "clamp" {
    let vals : Array[Double] = []
    let mut seg_s = start
    let mut depth = 0
    let mut i = start
    while i <= end {
      let is_comma = i < end && depth == 0 && (toks[i] is css::Tok::Comma)
      if i == end || is_comma {
        match eval_grid_math_expr(toks, seg_s, i) {
          Some((v, _)) => vals.push(v)
          None => return None
        }
        seg_s = i + 1
      } else {
        match toks[i] {
          css::Tok::OpenParen | css::Tok::Function(_) => depth += 1
          css::Tok::CloseParen => if depth > 0 { depth -= 1 }
          _ => ()
        }
      }
      i += 1
    }
    if lf == "min" {
      if vals.length() == 0 { return None }
      let mut m = vals[0]
      for v in vals { if v < m { m = v } }
      Some(m)
    } else if lf == "max" {
      if vals.length() == 0 { return None }
      let mut m = vals[0]
      for v in vals { if v > m { m = v } }
      Some(m)
    } else {
      if vals.length() != 3 { return None }
      Some(dmax(vals[0], dmin(vals[1], vals[2])))
    }
  } else {
    None
  }
}

fn eval_grid_math_atom(toks : Array[css::Tok], pos : Int, end : Int) -> Option[(Double, Int)] {
  let mut i = pos
  while i < end && toks[i] is css::Tok::Space { i += 1 }
  if i >= end { return None }
  match toks[i] {
    css::Tok::Number(n) => Some((n, i + 1))
    css::Tok::Delim(45) =>
    match eval_grid_math_atom(toks, i + 1, end) {
      Some((v, ni)) => Some((-v, ni))
      None => None
    }
    css::Tok::Delim(43) => eval_grid_math_atom(toks, i + 1, end)
    css::Tok::OpenParen => {
      let ge = grid_group_end(toks, i + 1, end)
      match eval_grid_math_expr(toks, i + 1, ge) {
        Some((v, _)) => Some((v, if ge < end { ge + 1 } else { ge }))
        None => None
      }
    }
    css::Tok::Function(fn_name) => {
      let ge = grid_group_end(toks, i + 1, end)
      match eval_grid_math_func(fn_name, toks, i + 1, ge) {
        Some(v) => Some((v, if ge < end { ge + 1 } else { ge }))
        None => None
      }
    }
    _ => None
  }
}

fn eval_grid_line_int(toks : Array[css::Tok]) -> Option[Int] {
  if toks.length() == 0 { return None }
  match toks[0] {
    css::Tok::Number(n) => Some(fvdmath::floor(n + 0.5).to_int())
    css::Tok::Function(f) => {
      let ge = grid_group_end(toks, 1, toks.length())
      match eval_grid_math_func(f, toks, 1, ge) {
        Some(v) => Some(fvdmath::floor(v + 0.5).to_int())
        None => None
      }
    }
    _ => None
  }
}

fn line_of(v : Array[css::Tok], lines : Int) -> (Option[Int], Int) {
  match tok_find_slash(v) {
    Some(k) => {
      let (a, s1) = line_of(tok_slice(v, 0, k), lines)
      let (z, s2) = line_of(tok_slice(v, k + 1, v.length()), lines)
      return match (a, z) {
        (Some(x), Some(y)) =>
        if y > x { (a, y - x) } else if y < 0 { (a, 1) } else { (a, if s2 > 1 { s2 } else { s1 }) }
        _ => (a, if s2 > 1 { s2 } else { s1 })
      }
    }
    None => ()
  }
  let ws = css::words(v)
  let mut start : Option[Int] = None
  let mut span = 1
  let mut i = 0
  while i < ws.length() {
    if ws[i].length() > 0 {
      match eval_grid_line_int(ws[i]) {
        Some(k) => start = Some(if k < 0 && lines > 0 { lines + 1 + k } else { k })
        None =>
        match ws[i][0] {
          css::Tok::Ident(w) =>
          if inline_ascii_lower(w) == "span" && i + 1 < ws.length() && ws[i + 1].length() > 0 {
            match eval_grid_line_int(ws[i + 1]) {
              Some(k) => {
                span = if k < 1 { 1 } else { k }
                i += 1
              }
              None => ()
            }
          }
          _ => ()
        }
      }
    }
    i += 1
  }
  (start, span)
}

fn named_line(names : Map[String, Array[Int]], nm : String, suffix : String) -> Option[Int] {
  match names.get(nm + suffix) {
    Some(a) => if a.length() > 0 { return Some(a[0]) }
    None => ()
  }
  match names.get(nm) {
    Some(a) => if a.length() > 0 { Some(a[0]) } else { None }
    None => None
  }
}

fn split_area_cells(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut b = StringBuilder::new()
  let mut i = 0
  let n = s.length()
  while i < n {
    let ch = s.code_unit_at(i)
    if ch == 32 || ch == 9 || ch == 10 {
      if b.length() > 0 {
        out.push(b.to_string())
        b = StringBuilder::new()
      }
    } else {
      b.write_byte(ch.to_byte())
    }
    i += 1
  }
  if b.length() > 0 {
    out.push(b.to_string())
  }
  out
}

let empty_area_map : Map[String, (Int, Int, Int, Int)] = Map::new()

fn has_open_square(toks : Array[css::Tok]) -> Bool {
  let mut i = 0
  while i < toks.length() {
    if toks[i] is css::Tok::OpenSquare { return true }
    i += 1
  }
  false
}

fn grid_name_of(t : Array[css::Tok]) -> Option[String] {
  let mut found : Option[String] = None
  let mut cnt = 0
  let mut i = 0
  while i < t.length() {
    match t[i] {
      css::Tok::Space => ()
      css::Tok::Ident(nm) => {
        cnt += 1
        if cnt > 1 { return None }
        found = Some(nm)
      }
      _ => return None
    }
    i += 1
  }
  match found {
    Some(nm) => {
      let lnm = inline_ascii_lower(nm)
      if lnm != "auto" && lnm != "span" { Some(nm) } else { None }
    }
    None => None
  }
}

fn grid_axis_place(
  start : Array[css::Tok],
  end_ : Array[css::Tok],
  lines : Int,
  use_col : Bool,
  areas : Map[String, (Int, Int, Int, Int)],
  names : Map[String, Array[Int]],
) -> (Option[Int], Int) {
  let snm = grid_name_of(start)
  let enm = grid_name_of(end_)
  let is_auto_end = end_.length() == 0 ||
  (end_.length() == 1 && (match end_[0] { css::Tok::Ident(w) => inline_ascii_lower(w) == "auto" _ => false }))
  let (a, sa) = match snm {
    Some(nm) =>
    match named_line(names, nm, "-start") {
      Some(l) => (Some(l), 1)
      None =>
      match areas.get(nm) {
        Some(ar) => (Some((if use_col { ar.1 } else { ar.0 }) + 1), 1)
        None => line_of(start, lines)
      }
    }
    None => line_of(start, lines)
  }
  let (z, sz) = match enm {
    Some(nm) =>
    match named_line(names, nm, "-end") {
      Some(l) => (Some(l), 1)
      None =>
      match areas.get(nm) {
        Some(ar) => (Some((if use_col { ar.3 } else { ar.2 }) + 1), 1)
        None => line_of(end_, lines)
      }
    }
    None =>
    if is_auto_end {
      match snm {
        Some(nm) =>
        match named_line(names, nm, "-end") {
          Some(l) => (Some(l), 1)
          None =>
          match areas.get(nm) {
            Some(ar) => (Some((if use_col { ar.3 } else { ar.2 }) + 1), 1)
            None => line_of(end_, lines)
          }
        }
        None => line_of(end_, lines)
      }
    } else {
      line_of(end_, lines)
    }
  }
  match (a, z) {
    (Some(x), Some(y)) =>
    if y > x { (a, y - x) } else if y < x { (z, x - y) } else { (a, if sz > 1 { sz } else { 1 }) }
    (Some(_), None) => (a, if sz > 1 { sz } else { 1 })
    (None, Some(y)) => {
      let sp = if sa > 1 { sa } else { 1 }
      (Some(y - sp), sp)
    }
    _ => (None, if sa > 1 { sa } else if sz > 1 { sz } else { 1 })
  }
}

fn area_map(b : Box) -> Map[String, (Int, Int, Int, Int)] {
  if !b.style.values.maybe_has_id(css::p_grid_template_areas) {
    return empty_area_map
  }
  let m : Map[String, (Int, Int, Int, Int)] = Map::new()
  let mut r = 0
  for t in b.style.get_id(css::p_grid_template_areas) {
    match t {
      css::Tok::Str(s) => {
        let cells = split_area_cells(s)
        for c, k in cells {
          if k != "." {
            match m.get(k) {
              Some((a, b1, c1, d)) =>
              m.set(k, (a, b1, if r + 1 > c1 { r + 1 } else { c1 }, if c + 1 > d { c + 1 } else { d }))
              None => m.set(k, (r, c, r + 1, c + 1))
            }
          }
        }
        r += 1
      }
      _ => ()
    }
  }
  m
}

fn Lay::layout_grid(self : Lay, b : Box, given_h : Option[Double], cbh : Option[Double]) -> Unit {
  let sub_cols = self.subgrid_cols
  self.subgrid_cols = None
  let cw = dmax(b.w - hedges(b), 0.0)
  let mut col_gap0 = len(b, css::p_column_gap, cw)
  let row_gap0 = len(b, css::p_row_gap, 0.0)
  let has_areas = b.style.values.maybe_has_id(css::p_grid_template_areas)
  let areas = if has_areas { area_map(b) } else { empty_area_map }
  let col_toks = b.style.get_id(css::p_grid_template_columns)
  let col_has_names = has_open_square(col_toks)
  let col_names = if col_has_names { Map::new() } else { empty_line_names }
  let col_names_opt : Option[Map[String, Array[Int]]] = if col_has_names { Some(col_names) } else { None }
  let is_subgrid_cols = b.style.word_id(css::p_grid_template_columns) == "subgrid"
  let tracks = match (is_subgrid_cols, sub_cols) {
    (true, Some((pcols, pgap))) if pcols.length() > 0 => {
      if b.style.get_id(css::p_column_gap).length() == 0 {
        col_gap0 = pgap
      }
      let out : Array[Track] = []
      for w in pcols {
        out.push(Track::Fixed(w))
      }
      out
    }
    _ => parse_tracks(b, col_toks, cw, col_gap0, col_names_opt)
  }
  let mut ncols = tracks.length()
  if has_areas {
    for k in areas.keys() {
      match areas.get(k) {
        Some(a) => if a.3 > ncols { ncols = a.3 }
        None => ()
      }
    }
  }
  if ncols == 0 {
    ncols = 1
  }
  let nch = b.children.length()
  let items : Array[Box] = if nch > 0 { Array::with_capacity(nch) } else { [] }
  let wrappers : Array[Box] = []
  for c in b.children {
    if out_of_flow(c.style) {
      self.queue_abs(c, b, b.bl + b.pl, b.bt + b.pt)
    } else {
      match c.kind {
        Kind::TextRun(t) =>
        if !flex_is_whitespace_only(t) {
          let w = new_box(None, c.style.anonymous(), Kind::Block)
          w.children.push(c)
          wrappers.push(w)
          items.push(w)
        }
        Kind::Inline => {
          let w = new_box(None, c.style.anonymous(), Kind::Block)
          w.children.push(c)
          wrappers.push(w)
          items.push(w)
        }
        _ => items.push(c)
      }
    }
  }
  sort_boxes_by_order(items)
  let nitems = items.length()
  let places : Array[(Box, Int, Int, Int, Int)] = if nitems > 0 { Array::with_capacity(nitems) } else { [] }
  let taken : intmap::IntMap[Bool] = intmap::IntMap::new()
  let row_toks = b.style.get_id(css::p_grid_template_rows)
  let row_has_names = has_open_square(row_toks)
  let row_names = if row_has_names { Map::new() } else { empty_line_names }
  let row_names_opt : Option[Map[String, Array[Int]]] = if row_has_names { Some(row_names) } else { None }
  let row_lines = parse_tracks(b, row_toks, 0.0, row_gap0, row_names_opt).length() + 1
  let col_lines = tracks.length() + 1
  if !flow_masks.ready { ensure_flow_masks() }
  let specs : Array[(Box, (Option[Int], Option[Int], Int, Int))] = if nitems > 0 { Array::with_capacity(nitems) } else { [] }
  for c in items {
    set_edges(c, 0.0)
    if !c.style.values.has_any_mask(flow_masks.grid_place_m0, flow_masks.grid_place_m1, flow_masks.grid_place_m2, flow_masks.grid_place_m3) {
      specs.push((c, (None, None, 1, 1)))
      continue
    }
    let (r0, rs) = grid_axis_place(
      c.style.get_id(css::p_grid_row_start),
      c.style.get_id(css::p_grid_row_end),
      row_lines,
      false,
      areas,
      row_names,
    )
    let (c0, cs) = grid_axis_place(
      c.style.get_id(css::p_grid_column_start),
      c.style.get_id(css::p_grid_column_end),
      col_lines,
      true,
      areas,
      col_names,
    )
    let r0_adj : Option[Int] = match r0 { Some(v) => Some(v - 1) None => None }
    let c0_adj : Option[Int] = match c0 { Some(v) => Some(v - 1) None => None }
    specs.push((c, (r0_adj, c0_adj, rs, cs)))
  }
  let flow_toks = b.style.get_id(css::p_grid_auto_flow)
  let mut flow_col = false
  for ft in flow_toks {
    match ft {
      css::Tok::Ident(w) if inline_ascii_lower(w) == "column" => flow_col = true
      _ => ()
    }
  }
  let explicit_rows = if row_lines > 1 { row_lines - 1 } else { 1 }
  let fits = fn(r : Int, col : Int, sr : Int, sc : Int, bounded : Bool) -> Bool {
    if bounded {
      if flow_col {
        if r + sr > explicit_rows && r > 0 {
          return false
        }
      } else if col + sc > ncols && col > 0 {
        return false
      }
    }
    for i in 0..<sr {
      for j in 0..<sc {
        if taken.contains((r + i) * 4096 + col + j) {
          return false
        }
      }
    }
    true
  }
  let take = fn(r0 : Int, col0 : Int, sr : Int, sc : Int) -> Unit {
    let r = if r0 < 0 { 0 } else { r0 }
    let col = if col0 < 0 { 0 } else { col0 }
    for i in 0..<sr {
      for j in 0..<sc {
        taken.set((r + i) * 4096 + col + j, true)
      }
    }
  }
  let placed : intmap::IntMap[(Int, Int, Int, Int)] = intmap::IntMap::new()
  for k, e in specs {
    let sp = e.1
    let (ra, ca, rs, cs) = sp
    let sr = if rs < 1 { 1 } else { rs }
    let sc = if cs < 1 { 1 } else { cs }
    match (ra, ca) {
      (Some(r), Some(col)) => {
        take(r, col, sr, sc)
        placed.set(k, (r, col, sr, sc))
      }
      _ => ()
    }
  }
  for k, e in specs {
    let sp = e.1
    let (ra, ca, rs, cs) = sp
    let sr = if rs < 1 { 1 } else { rs }
    let sc = if cs < 1 { 1 } else { cs }
    match (ra, ca) {
      (Some(r), None) => {
        let mut col = 0
        while !fits(r, col, sr, sc, false) && col < 4096 {
          col += 1
        }
        take(r, col, sr, sc)
        placed.set(k, (r, col, sr, sc))
      }
      _ => ()
    }
  }
  let mut cr = 0
  let mut cc = 0
  for k, e in specs {
    if placed.contains(k) {
      continue
    }
    let sp = e.1
    let (_, ca, rs, cs) = sp
    let sr = if rs < 1 { 1 } else { rs }
    let sc = if cs < 1 { 1 } else { cs }
    match ca {
      Some(col) => {
        if col < cc {
          cr += 1
        }
        while !fits(cr, col, sr, sc, false) && cr < 100000 {
          cr += 1
        }
        take(cr, col, sr, sc)
        placed.set(k, (cr, col, sr, sc))
        cc = col + sc
      }
      None => {
        if flow_col {
          while true {
            if cr + sr > explicit_rows && cr > 0 {
              cr = 0
              cc += 1
            }
            if fits(cr, cc, sr, sc, true) {
              break
            }
            cr += 1
          }
          take(cr, cc, sr, sc)
          placed.set(k, (cr, cc, sr, sc))
          cr += sr
        } else {
          while true {
            if cc + sc > ncols && cc > 0 {
              cc = 0
              cr += 1
            }
            if fits(cr, cc, sr, sc, true) {
              break
            }
            cc += 1
          }
          take(cr, cc, sr, sc)
          placed.set(k, (cr, cc, sr, sc))
          cc += sc
        }
      }
    }
  }
  for k, e in specs {
    match intmap::get(placed, k) {
      Some((r0, col0, sr, sc)) => {
        let r = if r0 < 0 { 0 } else { r0 }
        let col = if col0 < 0 { 0 } else { col0 }
        if col + sc > ncols {
          ncols = col + sc
        }
        places.push((e.0, r, col, sr, sc))
      }
      None => ()
    }
  }
  let saved_pct_h = self.pct_h
  let mut all_row0 = true
  for p in places {
    if p.1 != 0 || p.3 != 1 {
      all_row0 = false
      break
    }
  }
  let one_row = all_row0 &&
  parse_tracks(b, b.style.get_id(css::p_grid_template_rows), 0.0, 0.0, None).length() <= 1
  let row_h : Option[Double] = match given_h {
    Some(h) => if one_row { Some(dmax(h - vedges(b), 0.0)) } else { None }
    None => None
  }
  if row_h.is_some() {
    self.pct_h = row_h
  }
  let widths : Array[Double] = []
  let limits : Array[Double] = []
  for _ in 0..<ncols {
    widths.push(0.0)
    limits.push(0.0)
  }
  let auto_cols = parse_tracks(b, b.style.get_id(css::p_grid_auto_columns), cw, col_gap0, None)
  let track = fn(i : Int) -> Track {
    if i < tracks.length() {
      tracks[i]
    } else if auto_cols.length() > 0 {
      auto_cols[(i - tracks.length()) % auto_cols.length()]
    } else {
      Track::AutoTrack
    }
  }
  let mut frs = 0.0
  for i in 0..<ncols {
    let mut mn = 0.0
    let mut auto_mn = 0.0
    let mut mx = 0.0
    for p in places {
      if p.2 == i && p.4 == 1 {
        let mc = self.min_content(p.0)
        let am0 = match specified_w(p.0, css::p_min_width, Some(cw)) {
          Some(v) => v
          None => {
            let ov = p.0.style.word_id(css::p_overflow_x)
            if ov != "" && ov != "visible" { 0.0 } else { mc }
          }
        }
        let am = match specified_w(p.0, css::p_max_width, Some(cw)) {
          Some(mw) => dmin(am0, mw)
          None => am0
        }
        mn = dmax(mn, mc + p.0.ml + p.0.mr)
        auto_mn = dmax(auto_mn, am + p.0.ml + p.0.mr)
        mx = dmax(mx, self.max_content(p.0) + p.0.ml + p.0.mr)
      }
    }
    let (base, limit) = match track(i) {
      Track::Fixed(v) => (v, v)
      Track::Fr(v) => {
        frs += v
        (0.0, 0.0)
      }
      Track::FrMin(m, v) => {
        frs += v
        (m, m)
      }
      Track::MinContent => (mn, mn)
      Track::MaxContent => (mx, mx)
      Track::AutoTrack => (auto_mn, mx)
      Track::FitContent(l) => (mn, dmax(mn, dmin(mx, l)))
      Track::MinMax(a, z) => (a, z)
      Track::ContentMin(is_max, z) => {
        let m = if is_max { mx } else { mn }
        (m, dmax(m, z))
      }
    }
    widths[i] = base
    limits[i] = dmax(base, limit)
  }
  let mut free = cw - col_gap0 * (ncols - 1).to_double()
  for w in widths {
    free -= w
  }
  while free > 0.001 {
    let mut growing = 0
    for i in 0..<ncols {
      if widths[i] < limits[i] - 0.001 {
        growing += 1
      }
    }
    if growing == 0 {
      break
    }
    let mut step = free / growing.to_double()
    for i in 0..<ncols {
      if widths[i] < limits[i] - 0.001 {
        step = dmin(step, limits[i] - widths[i])
      }
    }
    for i in 0..<ncols {
      if widths[i] < limits[i] - 0.001 {
        widths[i] = widths[i] + step
        free -= step
      }
    }
  }
  if frs > 0.0 {
    let fixed_min : Array[Bool] = []
    for _ in 0..<ncols {
      fixed_min.push(false)
    }
    let mut unit = 0.0
    let mut again = true
    while again {
      again = false
      let mut left = free
      let mut flex = 0.0
      for i in 0..<ncols {
        match track(i) {
          Track::FrMin(m, v) => if !fixed_min[i] { left += m; flex += v }
          Track::Fr(v) => flex += v
          _ => ()
        }
      }
      unit = if flex > 0.0 { dmax(left, 0.0) / flex } else { 0.0 }
      for i in 0..<ncols {
        match track(i) {
          Track::FrMin(m, v) =>
          if !fixed_min[i] && unit * v < m {
            fixed_min[i] = true
            again = true
          }
          _ => ()
        }
      }
    }
    for i in 0..<ncols {
      match track(i) {
        Track::Fr(v) => widths[i] = unit * v
        Track::FrMin(m, v) => widths[i] = if fixed_min[i] { m } else { unit * v }
        _ => ()
      }
    }
  } else {
    let jc = b.style.word_id(css::p_justify_content)
    if free > 0.0 && (jc == "" || jc == "normal" || jc == "stretch") {
      let mut autos = 0
      for i in 0..<ncols {
        if track(i) is Track::AutoTrack { autos += 1 }
      }
      if autos > 0 {
        let add = free / autos.to_double()
        for i in 0..<ncols {
          if track(i) is Track::AutoTrack { widths[i] = widths[i] + add }
        }
      }
    }
  }
  let mut used_w = col_gap0 * (ncols - 1).to_double()
  for w in widths {
    used_w += w
  }
  let (x0, col_extra) = content_spread(b.style.word_id(css::p_justify_content), cw - used_w, ncols)
  let xs : Array[Double] = []
  for _ in 0..<(ncols + 1) {
    xs.push(x0)
  }
  for i in 0..<ncols {
    xs[i + 1] = xs[i] + widths[i] + col_gap0 + col_extra
  }
  let col_gap = col_gap0 + col_extra
  let gh_val = match given_h { Some(h) => h None => 0.0 }
  let row_tracks = parse_tracks(b, b.style.get_id(css::p_grid_template_rows), gh_val, row_gap0, None)
  let auto_rows = parse_tracks(b, b.style.get_id(css::p_grid_auto_rows), gh_val, row_gap0, None)
  let row_track = fn(i : Int) -> Track {
    if i < row_tracks.length() {
      row_tracks[i]
    } else if auto_rows.length() > 0 {
      auto_rows[(i - row_tracks.length()) % auto_rows.length()]
    } else {
      Track::AutoTrack
    }
  }
  let mut nrows = row_tracks.length()
  for p in places {
    if p.1 + p.3 > nrows {
      nrows = p.1 + p.3
    }
  }
  let heights : Array[Double] = []
  for _ in 0..<nrows {
    heights.push(0.0)
  }
  for p in places {
    let (c, r, col, rs, cs) = p
    let end_x = dmin(xs[col + cs], xs[ncols])
    let w = end_x - xs[col] - col_gap
    set_edges(c, w)
    let spec_w = specified_w(c, css::p_width, Some(w))
    let al = grid_justify(b, c)
    let forced0 = match spec_w {
      Some(v) => clamp_w(c, v, Some(w))
      None => {
        let w_kw = c.style.word_id(css::p_width)
        if w_kw == "fit-content" || w_kw == "-webkit-fit-content" || w_kw == "-moz-fit-content" {
          clamp_w(c, dmax(self.min_content(c), dmin(self.max_content(c), dmax(w - c.ml - c.mr, 0.0))), Some(w))
        } else if w_kw == "max-content" || w_kw == "-webkit-max-content" {
          clamp_w(c, self.max_content(c), Some(w))
        } else if w_kw == "min-content" || w_kw == "-webkit-min-content" {
          clamp_w(c, self.min_content(c), Some(w))
        } else if al != "stretch" {
          clamp_w(c, dmin(self.max_content(c), dmax(w - c.ml - c.mr, 0.0)), Some(w))
        } else {
          clamp_w(c, dmax(w - c.ml - c.mr, 0.0), Some(w))
        }
      }
    }
    let forced = self.clamp_keywords(c, forced0, Some(dmax(w - c.ml - c.mr, 0.0)))
    let prev_sub = self.subgrid_cols
    if c.kind is Kind::Grid && c.style.word_id(css::p_grid_template_columns) == "subgrid" && col >= 0 && col + cs <= widths.length() && cs > 0 {
      let sc_arr : Array[Double] = []
      let mut ci = col
      while ci < col + cs {
        let mut tw = widths[ci]
        if ci == col { tw = dmax(tw - c.bl - c.pl, 0.0) }
        if ci == col + cs - 1 { tw = dmax(tw - c.br - c.pr, 0.0) }
        sc_arr.push(tw)
        ci += 1
      }
      self.subgrid_cols = Some((sc_arr, col_gap))
    }
    self.layout_root(c, 0.0, 0.0, w, row_h, Some(forced), None)
    self.subgrid_cols = prev_sub
    if rs == 1 {
      let oy = c.style.word_id(css::p_overflow_y)
      let scrolls_y = oy == "hidden" || oy == "clip" || oy == "scroll" || oy == "auto"
      let spec_min_h = specified_h(c, css::p_min_height, row_h)
      let fr_min_bounded = match row_track(r) {
        Track::Fr(v) => (v <= 0.0 && scrolls_y) || (given_h.is_some() && (scrolls_y || spec_min_h.is_some()))
        _ => false
      }
      if fr_min_bounded {
        let mh = match spec_min_h { Some(v) => v None => 0.0 }
        heights[r] = dmax(heights[r], mh + c.mt + c.mb)
      } else {
        heights[r] = dmax(heights[r], c.h + c.mt + c.mb)
      }
    }
  }
  for i in 0..<nrows {
    match row_track(i) {
      Track::Fixed(v) => heights[i] = v
      Track::MinMax(a, z) => heights[i] = dmax(a, dmin(heights[i], z))
      Track::FrMin(m, _) => heights[i] = dmax(heights[i], m)
      _ => ()
    }
  }
  // CSS Grid 1 §11.5 step 3: distribute height of multi-row spanning items across auto rows
  // (items spanning a flexible `fr` track do not inflate sibling `auto` tracks — the `fr` track absorbs them)
  for p in places {
    let (c, r, _, rs, _) = p
    if rs > 1 {
      let need = c.h + c.mt + c.mb
      let mut have = row_gap0 * (rs - 1).to_double()
      let mut spans_fr = false
      let mut span_fr_sum = 0.0
      let flex_rows : Array[Int] = []
      let fr_rows : Array[(Int, Double)] = []
      let mut rr = r
      while rr < r + rs && rr < nrows {
        have += heights[rr]
        let rt = row_track(rr)
        let is_fixed = rt is Track::Fixed(_)
        match rt {
          Track::Fr(v) => {
            spans_fr = true
            let wv = if v > 0.0 { v } else { 1.0 }
            span_fr_sum += wv
            fr_rows.push((rr, wv))
          }
          _ => if !is_fixed {
            flex_rows.push(rr)
          }
        }
        rr += 1
      }
      if !spans_fr && need > have + 0.001 && flex_rows.length() > 0 {
        let extra = (need - have) / flex_rows.length().to_double()
        for rr2 in flex_rows {
          heights[rr2] = heights[rr2] + extra
        }
      } else if spans_fr && given_h.is_none() && need > have + 0.001 && span_fr_sum > 0.0 {
        // CSS Grid 1 §11.7.1: when grid height is indefinite, spanning items crossing `fr` tracks
        // contribute their remaining height to those `fr` tracks proportionally to flex factor.
        let rem = need - have
        for pair in fr_rows {
          heights[pair.0] = heights[pair.0] + rem * (pair.1 / span_fr_sum)
        }
      }
    }
  }
  let pct_cb = match cbh { Some(_) => cbh None => saved_pct_h }
  let min_h = match specified_h(b, css::p_min_height, pct_cb) { Some(v) => v None => 0.0 }
  let target = dmax(gh_val, min_h) - vedges(b)
  let mut fr_sum = 0.0
  let mut taken_h = row_gap0 * dmax((nrows - 1).to_double(), 0.0)
  for i in 0..<nrows {
    match row_track(i) {
      Track::Fr(v) => fr_sum += v
      _ => taken_h += heights[i]
    }
  }
  if fr_sum > 0.0 {
    if given_h.is_none() {
      let mut per_fr = 0.0
      for i in 0..<nrows {
        match row_track(i) {
          Track::Fr(v) => if v > 0.0 { per_fr = dmax(per_fr, heights[i] / dmax(v, 1.0)) }
          _ => ()
        }
      }
      for i in 0..<nrows {
        match row_track(i) {
          Track::Fr(v) => heights[i] = dmax(heights[i], per_fr * v)
          _ => ()
        }
      }
    }
    let unit = dmax(target - taken_h, 0.0) / fr_sum
    for i in 0..<nrows {
      match row_track(i) {
        Track::Fr(v) => heights[i] = dmax(heights[i], unit * v)
        _ => ()
      }
    }
  } else if target > taken_h + 0.001 && nrows > 0 {
    let ac = b.style.word_id(css::p_align_content)
    if ac == "" || ac == "normal" || ac == "stretch" {
      let autos : Array[Int] = []
      for i in 0..<nrows {
        let is_fixed = row_track(i) is Track::Fixed(_)
        if !is_fixed {
          autos.push(i)
        }
      }
      if autos.length() > 0 {
        let add = (target - taken_h) / autos.length().to_double()
        for i in autos {
          heights[i] = heights[i] + add
        }
      }
    }
  }
  let mut used_h = row_gap0 * dmax((nrows - 1).to_double(), 0.0)
  for h in heights {
    used_h += h
  }
  let (y0, row_extra) = if given_h.is_some() || min_h > 0.0 {
    content_spread(b.style.word_id(css::p_align_content), target - used_h, nrows)
  } else {
    (0.0, 0.0)
  }
  let ys : Array[Double] = []
  for _ in 0..<(nrows + 1) {
    ys.push(y0)
  }
  for i in 0..<nrows {
    ys[i + 1] = ys[i] + heights[i] + row_gap0 + row_extra
  }
  let row_gap = row_gap0 + row_extra
  let ox = b.x + b.bl + b.pl
  let oy = b.y + b.bt + b.pt
  let grid_rtl = b.style.word_id(css::p_direction) == "rtl"
  for p in places {
    let (c, r, col, rs, cs) = p
    let area_h = ys[r + rs] - ys[r] - row_gap
    let area_w = dmin(xs[col + cs], xs[ncols]) - xs[col] - col_gap
    let va = grid_align(b, c)
    if has_pct_tok(c.style.get_id(css::p_height)) {
      match specified_h(c, css::p_height, Some(area_h)) {
        Some(h) =>
        if (h - c.h).abs() > 0.01 {
          self.layout_root(c, c.x, c.y, area_w, Some(area_h), Some(c.w), Some(clamp_h(c, h, Some(area_h))))
        }
        None => ()
      }
    }
    if va == "stretch" && specified_h(c, css::p_height, None).is_none() && !is_intrinsic_h(c) {
      let oy_s = c.style.word_id(css::p_overflow_y)
      let scrolls_y_s = oy_s == "hidden" || oy_s == "clip" || oy_s == "scroll" || oy_s == "auto"
      let has_min_h_s = specified_h(c, css::p_min_height, Some(area_h)).is_some()
      let fr_min_bounded = rs == 1 && match row_track(r) {
        Track::Fr(v) => (v <= 0.0 && scrolls_y_s) || (given_h.is_some() && (scrolls_y_s || has_min_h_s))
        _ => false
      }
      let sh = if fr_min_bounded {
        clamp_h(c, dmax(area_h - c.mt - c.mb, 0.0), Some(area_h))
      } else {
        clamp_h(c, dmax(area_h - c.mt - c.mb, c.h), Some(area_h))
      }
      // CSS Grid 1 §6.6: a stretched block grid item has a definite height, so children with
      // percentage heights (e.g. nested split-grid / ACE editor wrappers) must re-resolve against it.
      let has_pct_h_child = match c.kind {
        Kind::Block => {
          let mut found = false
          for ch in c.children {
            if has_pct_tok(ch.style.get_id(css::p_height)) || has_pct_tok(ch.style.get_id(css::p_min_height)) || has_pct_tok(ch.style.get_id(css::p_max_height)) {
              found = true
              break
            }
          }
          found
        }
        _ => false
      }
      if (sh - c.h).abs() > 0.01 && (c.kind is Kind::Flex || c.kind is Kind::Grid || has_pct_h_child) && (fr_min_bounded || sh > c.h + 0.01) {
        self.layout_root(c, c.x, c.y, area_w, Some(area_h), Some(c.w), Some(sh))
      } else {
        c.h = sh
        c.memo_stretched_h = sh
      }
    } else if va != "stretch" && specified_h(c, css::p_height, None).is_none() {
      match specified_h(c, css::p_min_height, Some(area_h)) {
        Some(mh) if mh > c.h + 0.01 => {
          let sh = clamp_h(c, mh, Some(area_h))
          if (sh - c.h).abs() > 0.01 && (c.kind is Kind::Flex || c.kind is Kind::Grid) {
            self.layout_root(c, c.x, c.y, area_w, Some(area_h), Some(c.w), Some(sh))
          } else {
            c.h = sh
            c.memo_stretched_h = sh
          }
        }
        _ => ()
      }
    }
    let free_x = area_w - c.w - c.ml - c.mr
    let jp = self_place(b, c, css::p_justify_self, css::p_justify_items, grid_justify(b, c))
    let dx = if jp == "center" { free_x / 2.0 }
    else if (jp == "end") != grid_rtl { free_x }
    else { 0.0 }
    let free_y = area_h - c.h - c.mt - c.mb
    let dy = if va == "center" { free_y / 2.0 } else if va == "end" { free_y } else { 0.0 }
    let cell_x = if grid_rtl { cw - xs[col] - area_w } else { xs[col] }
    self.shift(c, ox + cell_x + c.ml + dmax(dx, 0.0) - c.x, oy + ys[r] + c.mt + dmax(dy, 0.0) - c.y)
  }
  for w in wrappers {
    self.settle(w)
  }
  b.h = match given_h {
    Some(h) => h
    None => dmax(ys[nrows] - y0 - row_gap, 0.0) + vedges(b)
  }
  let w_copy : Array[Double] = []
  for w in widths { w_copy.push(w) }
  let h_copy : Array[Double] = []
  for h in heights { h_copy.push(h) }
  b.tracks = Some((w_copy, h_copy))
  self.pct_h = saved_pct_h
}

fn collapse_tables(b : Box) -> Unit {
  if b.taken_gen == box_globals.generations {
    return
  }
  let is_tbl = inner_kind(b) is Kind::Table
  if !is_tbl && b.children.length() == 0 {
    return
  }
  box_globals.pass_visits += 1
  if is_tbl {
    let rows = table_rows(b)
    let (cells, cols) = grid_of(rows)
    collapse_borders(b, rows, cells, cols)
  }
  for c in b.children {
    collapse_tables(c)
  }
}
