  mut hf_m1 : Int64
  mut hf_m2 : Int64
  mut hf_m3 : Int64
  mut pos_m0 : Int64
  mut pos_m1 : Int64
  mut pos_m2 : Int64
  mut pos_m3 : Int64
  mut sc_m0 : Int64
  mut sc_m1 : Int64
  mut sc_m2 : Int64
  mut sc_m3 : Int64
  mut bfc_m0 : Int64
  mut bfc_m1 : Int64
  mut bfc_m2 : Int64
  mut bfc_m3 : Int64
  mut pe_m0 : Int64
  mut pe_m1 : Int64
  mut pe_m2 : Int64
  mut pe_m3 : Int64
  mut ph_m0 : Int64
  mut ph_m1 : Int64
  mut ph_m2 : Int64
  mut ph_m3 : Int64
  mut phc_m0 : Int64
  mut phc_m1 : Int64
  mut phc_m2 : Int64
  mut phc_m3 : Int64
  mut ov_m0 : Int64
  mut ov_m1 : Int64
  mut ov_m2 : Int64
  mut ov_m3 : Int64
