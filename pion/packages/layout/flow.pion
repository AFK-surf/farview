  mut minmax_w_m1 : Int64
  mut minmax_w_m2 : Int64
  mut minmax_w_m3 : Int64
  mut minmax_h_m0 : Int64
  mut minmax_h_m1 : Int64
  mut minmax_h_m2 : Int64
  mut minmax_h_m3 : Int64
}

let flow_masks : FlowMasks = FlowMasks::{
  ready: false,
  hf_m0: 0L, hf_m1: 0L, hf_m2: 0L, hf_m3: 0L,
  pos_m0: 0L, pos_m1: 0L, pos_m2: 0L, pos_m3: 0L,
  sc_m0: 0L, sc_m1: 0L, sc_m2: 0L, sc_m3: 0L,
  bfc_m0: 0L, bfc_m1: 0L, bfc_m2: 0L, bfc_m3: 0L,
  pe_m0: 0L, pe_m1: 0L, pe_m2: 0L, pe_m3: 0L,
  ph_m0: 0L, ph_m1: 0L, ph_m2: 0L, ph_m3: 0L,
  phc_m0: 0L, phc_m1: 0L, phc_m2: 0L, phc_m3: 0L,
  ov_m0: 0L, ov_m1: 0L, ov_m2: 0L, ov_m3: 0L,
  grid_place_m0: 0L, grid_place_m1: 0L, grid_place_m2: 0L, grid_place_m3: 0L,
  minmax_w_m0: 0L, minmax_w_m1: 0L, minmax_w_m2: 0L, minmax_w_m3: 0L,
  minmax_h_m0: 0L, minmax_h_m1: 0L, minmax_h_m2: 0L, minmax_h_m3: 0L,
}

fn mask_bit0(id : Int) -> Int64 { css::mask_bit_in(id, 0) }
fn mask_bit1(id : Int) -> Int64 { css::mask_bit_in(id, 1) }
fn mask_bit2(id : Int) -> Int64 { css::mask_bit_in(id, 2) }
fn mask_bit3(id : Int) -> Int64 { css::mask_bit_in(id, 3) }

fn ensure_flow_masks() -> Unit {
  if flow_masks.ready { return }
  let hf0 = mask_bit0(css::p_transform) | mask_bit0(css::p_translate) | mask_bit0(css::p_rotate) | mask_bit0(css::p_scale) |
  mask_bit0(css::p_perspective) | mask_bit0(css::p_filter) |
  mask_bit0(css::p_backdrop_filter) | mask_bit0(css::p__webkit_backdrop_filter) |
  mask_bit0(css::p_contain) | mask_bit0(css::p_will_change)
  let hf1 = mask_bit1(css::p_transform) | mask_bit1(css::p_translate) | mask_bit1(css::p_rotate) | mask_bit1(css::p_scale) |
  mask_bit1(css::p_perspective) | mask_bit1(css::p_filter) |
  mask_bit1(css::p_backdrop_filter) | mask_bit1(css::p__webkit_backdrop_filter) |
  mask_bit1(css::p_contain) | mask_bit1(css::p_will_change)
  let hf2 = mask_bit2(css::p_transform) | mask_bit2(css::p_translate) | mask_bit2(css::p_rotate) | mask_bit2(css::p_scale) |
  mask_bit2(css::p_perspective) | mask_bit2(css::p_filter) |
  mask_bit2(css::p_backdrop_filter) | mask_bit2(css::p__webkit_backdrop_filter) |
  mask_bit2(css::p_contain) | mask_bit2(css::p_will_change)
  let hf3 = mask_bit3(css::p_transform) | mask_bit3(css::p_translate) | mask_bit3(css::p_rotate) | mask_bit3(css::p_scale) |
  mask_bit3(css::p_perspective) | mask_bit3(css::p_filter) |
  mask_bit3(css::p_backdrop_filter) | mask_bit3(css::p__webkit_backdrop_filter) |
  mask_bit3(css::p_contain) | mask_bit3(css::p_will_change)
  flow_masks.hf_m0 = hf0
  flow_masks.hf_m1 = hf1
  flow_masks.hf_m2 = hf2
  flow_masks.hf_m3 = hf3
  flow_masks.pos_m0 = hf0 | mask_bit0(css::p_position)
  flow_masks.pos_m1 = hf1 | mask_bit1(css::p_position)
  flow_masks.pos_m2 = hf2 | mask_bit2(css::p_position)
  flow_masks.pos_m3 = hf3 | mask_bit3(css::p_position)
  flow_masks.sc_m0 = mask_bit0(css::p_content_visibility) | mask_bit0(css::p_contain)
  flow_masks.sc_m1 = mask_bit1(css::p_content_visibility) | mask_bit1(css::p_contain)
  flow_masks.sc_m2 = mask_bit2(css::p_content_visibility) | mask_bit2(css::p_contain)
  flow_masks.sc_m3 = mask_bit3(css::p_content_visibility) | mask_bit3(css::p_contain)
  flow_masks.bfc_m0 = mask_bit0(css::p_overflow_x) | mask_bit0(css::p_overflow_y) | mask_bit0(css::p_display) |
  mask_bit0(css::p_content_visibility) | mask_bit0(css::p_contain) |
  mask_bit0(css::p_column_width) | mask_bit0(css::p_column_count)
  flow_masks.bfc_m1 = mask_bit1(css::p_overflow_x) | mask_bit1(css::p_overflow_y) | mask_bit1(css::p_display) |
  mask_bit1(css::p_content_visibility) | mask_bit1(css::p_contain) |
  mask_bit1(css::p_column_width) | mask_bit1(css::p_column_count)
  flow_masks.bfc_m2 = mask_bit2(css::p_overflow_x) | mask_bit2(css::p_overflow_y) | mask_bit2(css::p_display) |
  mask_bit2(css::p_content_visibility) | mask_bit2(css::p_contain) |
  mask_bit2(css::p_column_width) | mask_bit2(css::p_column_count)
  flow_masks.bfc_m3 = mask_bit3(css::p_overflow_x) | mask_bit3(css::p_overflow_y) | mask_bit3(css::p_display) |
  mask_bit3(css::p_content_visibility) | mask_bit3(css::p_contain) |
  mask_bit3(css::p_column_width) | mask_bit3(css::p_column_count)
  flow_masks.pe_m0 = mask_bit0(css::p_margin_top) | mask_bit0(css::p_margin_right) |
  mask_bit0(css::p_margin_bottom) | mask_bit0(css::p_margin_left) |
  mask_bit0(css::p_padding_top) | mask_bit0(css::p_padding_right) |
  mask_bit0(css::p_padding_bottom) | mask_bit0(css::p_padding_left)
  flow_masks.pe_m1 = mask_bit1(css::p_margin_top) | mask_bit1(css::p_margin_right) |
  mask_bit1(css::p_margin_bottom) | mask_bit1(css::p_margin_left) |
  mask_bit1(css::p_padding_top) | mask_bit1(css::p_padding_right) |
  mask_bit1(css::p_padding_bottom) | mask_bit1(css::p_padding_left)
  flow_masks.pe_m2 = mask_bit2(css::p_margin_top) | mask_bit2(css::p_margin_right) |
  mask_bit2(css::p_margin_bottom) | mask_bit2(css::p_margin_left) |
  mask_bit2(css::p_padding_top) | mask_bit2(css::p_padding_right) |
  mask_bit2(css::p_padding_bottom) | mask_bit2(css::p_padding_left)
  flow_masks.pe_m3 = mask_bit3(css::p_margin_top) | mask_bit3(css::p_margin_right) |
  mask_bit3(css::p_margin_bottom) | mask_bit3(css::p_margin_left) |
  mask_bit3(css::p_padding_top) | mask_bit3(css::p_padding_right) |
  mask_bit3(css::p_padding_bottom) | mask_bit3(css::p_padding_left)
  let ph0 = mask_bit0(css::p_height) | mask_bit0(css::p_min_height) | mask_bit0(css::p_max_height) |
  mask_bit0(css::p_top) | mask_bit0(css::p_bottom)
  let ph1 = mask_bit1(css::p_height) | mask_bit1(css::p_min_height) | mask_bit1(css::p_max_height) |
  mask_bit1(css::p_top) | mask_bit1(css::p_bottom)
  let ph2 = mask_bit2(css::p_height) | mask_bit2(css::p_min_height) | mask_bit2(css::p_max_height) |
  mask_bit2(css::p_top) | mask_bit2(css::p_bottom)
  let ph3 = mask_bit3(css::p_height) | mask_bit3(css::p_min_height) | mask_bit3(css::p_max_height) |
  mask_bit3(css::p_top) | mask_bit3(css::p_bottom)
  flow_masks.ph_m0 = ph0
  flow_masks.ph_m1 = ph1
  flow_masks.ph_m2 = ph2
  flow_masks.ph_m3 = ph3
  flow_masks.phc_m0 = ph0 | mask_bit0(css::p_flex_basis)
  flow_masks.phc_m1 = ph1 | mask_bit1(css::p_flex_basis)
  flow_masks.phc_m2 = ph2 | mask_bit2(css::p_flex_basis)
  flow_masks.phc_m3 = ph3 | mask_bit3(css::p_flex_basis)
  flow_masks.ov_m0 = mask_bit0(css::p_overflow_x) | mask_bit0(css::p_overflow_y)
  flow_masks.ov_m1 = mask_bit1(css::p_overflow_x) | mask_bit1(css::p_overflow_y)
  flow_masks.ov_m2 = mask_bit2(css::p_overflow_x) | mask_bit2(css::p_overflow_y)
  flow_masks.ov_m3 = mask_bit3(css::p_overflow_x) | mask_bit3(css::p_overflow_y)
  flow_masks.grid_place_m0 = mask_bit0(css::p_grid_column_start) | mask_bit0(css::p_grid_column_end) |
  mask_bit0(css::p_grid_row_start) | mask_bit0(css::p_grid_row_end)
  flow_masks.grid_place_m1 = mask_bit1(css::p_grid_column_start) | mask_bit1(css::p_grid_column_end) |
  mask_bit1(css::p_grid_row_start) | mask_bit1(css::p_grid_row_end)
  flow_masks.grid_place_m2 = mask_bit2(css::p_grid_column_start) | mask_bit2(css::p_grid_column_end) |
  mask_bit2(css::p_grid_row_start) | mask_bit2(css::p_grid_row_end)
  flow_masks.grid_place_m3 = mask_bit3(css::p_grid_column_start) | mask_bit3(css::p_grid_column_end) |
  mask_bit3(css::p_grid_row_start) | mask_bit3(css::p_grid_row_end)
  flow_masks.minmax_w_m0 = mask_bit0(css::p_min_width) | mask_bit0(css::p_max_width)
  flow_masks.minmax_w_m1 = mask_bit1(css::p_min_width) | mask_bit1(css::p_max_width)
  flow_masks.minmax_w_m2 = mask_bit2(css::p_min_width) | mask_bit2(css::p_max_width)
  flow_masks.minmax_w_m3 = mask_bit3(css::p_min_width) | mask_bit3(css::p_max_width)
  flow_masks.minmax_h_m0 = mask_bit0(css::p_min_height) | mask_bit0(css::p_max_height)
  flow_masks.minmax_h_m1 = mask_bit1(css::p_min_height) | mask_bit1(css::p_max_height)
  flow_masks.minmax_h_m2 = mask_bit2(css::p_min_height) | mask_bit2(css::p_max_height)
  flow_masks.minmax_h_m3 = mask_bit3(css::p_min_height) | mask_bit3(css::p_max_height)
  flow_masks.ready = true
}

struct Flow {
  mut y : Double
  mut pos : Double
  mut neg : Double
  mut first : Option[Double]
}

fn Flow::margin(self : Flow) -> Double {
  self.pos + self.neg
}

fn Flow::add(self : Flow, m : Double) -> Unit {
  if m > self.pos { self.pos = m }
  if m < self.neg { self.neg = m }
}

fn Flow::commit(self : Flow) -> Double {
  self.y += self.margin()
  self.pos = 0.0
  self.neg = 0.0
  if self.first.is_none() { self.first = Some(self.y) }
  self.y
}

