///| Block layout: normal flow, margins, floats, positioned boxes, sticky, intrinsic widths, memoization.
///| 1:1 port of `client/src/layout/flow.mbt` (Bug #5 safe: zero module-level `Array[Box]`).

import "html"
import "css"
import "intmap"

