///| Unit tests for `fetch` (curl-impersonate version, iconv, URL resolve, loopback HTTP GET/POST/cookies/async, WebSocket).

test "curl-impersonate linked and active, rss_mb and now_us work" {
  let ver = curl_version_str()
  debug_assert(ver.contains("libcurl/"), "curl_version must report libcurl")
  debug_assert(ver.contains("BoringSSL"), "curl-impersonate must use BoringSSL")
  debug_assert(rss_mb() > 0, "rss_mb > 0")
  debug_assert(now_us() > 0L, "now_us > 0")
}

test "iconv to_utf8 and from_utf8 round-trip and resolve" {
  let src = "你好世界"
  let gbk = from_utf8(src, "GBK")
  debug_assert(gbk.length() == 8, "4 CJK chars = 8 GBK bytes")
  match to_utf8(gbk, "GBK") {
    Option::Some(u) => debug_assert(u.to_string() == src, "GBK round-trip matches")
    Option::None => debug_assert(false, "to_utf8 GBK failed")
  }
  debug_assert(resolve("https://example.com/a/b.html", "../c.js") == "https://example.com/c.js", "resolve relative URL")
}

fn bytes_from_ints(arr : Array[Int]) -> Bytes {
  let b = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    b[i] = arr[i].to_byte()
    i = i + 1
  }
  b
}

test "pure-Pion WHATWG encoding CJK and legacy charsets round-trip" {
  // GBK & GB18030 (including 4-byte astral plane char and GB18030-2022 code points)
  let gb18030_src = "你好😀𠀀\u{9FB4}"
  let gb18030_bytes = from_utf8(gb18030_src, "GB18030")
  match to_utf8(gb18030_bytes, "GB18030") {
    Option::Some(u) => debug_assert(u.to_string() == gb18030_src, "GB18030 4-byte + 2022 round-trip")
    Option::None => debug_assert(false, "to_utf8 GB18030 failed")
  }

  // Shift_JIS (including legacy CP932 alias used by page::iconv_name)
  let sjis_src = "こんにちは世界"
  let sjis_bytes = from_utf8(sjis_src, "Shift_JIS")
  match to_utf8(sjis_bytes, "Shift_JIS") {
    Option::Some(u) => debug_assert(u.to_string() == sjis_src, "Shift_JIS round-trip")
    Option::None => debug_assert(false, "to_utf8 Shift_JIS failed")
  }
  match to_utf8(sjis_bytes, "CP932") {
    Option::Some(u) => debug_assert(u.to_string() == sjis_src, "CP932 alias decode")
    Option::None => debug_assert(false, "to_utf8 CP932 failed")
  }

  // EUC-JP
  let eucjp_src = "日本語テスト"
  let eucjp_bytes = from_utf8(eucjp_src, "EUC-JP")
  match to_utf8(eucjp_bytes, "EUC-JP") {
    Option::Some(u) => debug_assert(u.to_string() == eucjp_src, "EUC-JP round-trip")
    Option::None => debug_assert(false, "to_utf8 EUC-JP failed")
  }

  // ISO-2022-JP
  let iso2022_src = "ABC日本語123"
  let iso2022_bytes = from_utf8(iso2022_src, "ISO-2022-JP")
  match to_utf8(iso2022_bytes, "ISO-2022-JP") {
    Option::Some(u) => debug_assert(u.to_string() == iso2022_src, "ISO-2022-JP round-trip")
    Option::None => debug_assert(false, "to_utf8 ISO-2022-JP failed")
  }

  // Big5 (including HKSCS decode: 0x87 0x40 -> U+43F0)
  let big5_src = "繁體中文香港"
  let big5_bytes = from_utf8(big5_src, "Big5")
  match to_utf8(big5_bytes, "BIG5-HKSCS") {
    Option::Some(u) => debug_assert(u.to_string() == big5_src, "Big5 round-trip")
    Option::None => debug_assert(false, "to_utf8 Big5 failed")
  }
  let hkscs_bytes = bytes_from_ints([0x87, 0x40])
  match to_utf8(hkscs_bytes, "Big5") {
    Option::Some(u) => debug_assert(u.to_string() == "\u{43F0}", "Big5 HKSCS decode")
    Option::None => debug_assert(false, "to_utf8 Big5 HKSCS failed")
  }

  // EUC-KR (including legacy CP949 alias used by page::iconv_name)
  let euckr_src = "안녕하세요"
  let euckr_bytes = from_utf8(euckr_src, "EUC-KR")
  match to_utf8(euckr_bytes, "EUC-KR") {
    Option::Some(u) => debug_assert(u.to_string() == euckr_src, "EUC-KR round-trip")
    Option::None => debug_assert(false, "to_utf8 EUC-KR failed")
  }
  match to_utf8(euckr_bytes, "CP949") {
    Option::Some(u) => debug_assert(u.to_string() == euckr_src, "CP949 alias decode")
    Option::None => debug_assert(false, "to_utf8 CP949 failed")
  }
}

test "pure-Pion WHATWG encoding UTF-16, single-byte, replacement, and BOM sniffing" {
  // UTF-16LE with and without BOM ("Hi")
  let u16le_nobom = bytes_from_ints([0x48, 0x00, 0x69, 0x00])
  let u16le_bom = bytes_from_ints([0xFF, 0xFE, 0x48, 0x00, 0x69, 0x00])
  match to_utf8(u16le_nobom, "UTF-16LE") {
    Option::Some(u) => debug_assert(u.to_string() == "Hi", "UTF-16LE no BOM")
    Option::None => debug_assert(false, "to_utf8 UTF-16LE no BOM failed")
  }
  match to_utf8(u16le_bom, "UTF-16LE") {
    Option::Some(u) => debug_assert(u.to_string() == "Hi", "UTF-16LE BOM stripped")
    Option::None => debug_assert(false, "to_utf8 UTF-16LE BOM failed")
  }

  // UTF-16BE with and without BOM ("Hi")
  let u16be_nobom = bytes_from_ints([0x00, 0x48, 0x00, 0x69])
  let u16be_bom = bytes_from_ints([0xFE, 0xFF, 0x00, 0x48, 0x00, 0x69])
  match to_utf8(u16be_nobom, "UTF-16BE") {
    Option::Some(u) => debug_assert(u.to_string() == "Hi", "UTF-16BE no BOM")
    Option::None => debug_assert(false, "to_utf8 UTF-16BE no BOM failed")
  }
  match to_utf8(u16be_bom, "UTF-16BE") {
    Option::Some(u) => debug_assert(u.to_string() == "Hi", "UTF-16BE BOM stripped")
    Option::None => debug_assert(false, "to_utf8 UTF-16BE BOM failed")
  }

  // windows-1252 (0x80 = Euro sign U+20AC)
  let w1252_euro = bytes_from_ints([0x80, 0x31, 0x30])
  match to_utf8(w1252_euro, "windows-1252") {
    Option::Some(u) => debug_assert(u.to_string() == "€10", "windows-1252 0x80 -> €")
    Option::None => debug_assert(false, "to_utf8 windows-1252 failed")
  }

  // KOI8-R
  let koi8_src = "Привет"
  let koi8_bytes = from_utf8(koi8_src, "KOI8-R")
  match to_utf8(koi8_bytes, "KOI8-R") {
    Option::Some(u) => debug_assert(u.to_string() == koi8_src, "KOI8-R round-trip")
    Option::None => debug_assert(false, "to_utf8 KOI8-R failed")
  }

  // replacement encoding
  match to_utf8("hello".to_bytes(), "replacement") {
    Option::Some(u) => debug_assert(u.to_string() == "\u{FFFD}", "replacement emits U+FFFD")
    Option::None => debug_assert(false, "to_utf8 replacement failed")
  }

  // sniff_and_decode_utf8: BOM takes precedence over charset label
  match sniff_and_decode_utf8(u16le_bom, "GBK") {
    Option::Some((name, u)) => {
      debug_assert(name == "UTF-16LE", "sniffed UTF-16LE BOM")
      debug_assert(u.to_string() == "Hi", "sniffed UTF-16LE payload")
    }
    Option::None => debug_assert(false, "sniff_and_decode_utf8 BOM failed")
  }
  match sniff_and_decode_utf8(w1252_euro, "windows-1252") {
    Option::Some((name, u)) => {
      debug_assert(name == "windows-1252", "sniff fallback charset name")
      debug_assert(u.to_string() == "€10", "sniff fallback payload")
    }
    Option::None => debug_assert(false, "sniff_and_decode_utf8 fallback failed")
  }
  match sniff_and_decode_utf8("abc".to_bytes(), "not-a-real-charset") {
    Option::None => ()
    Option::Some(_) => debug_assert(false, "sniff_and_decode_utf8 unknown charset must return None")
  }
}

test "pure-Pion WHATWG form from_utf8 NCR fallback and error boundaries" {
  // HTML form encoding: unmappable emoji U+1F600 (128512) -> &#128512;
  let sjis_ncr = from_utf8("a😀b", "Shift_JIS")
  debug_assert(sjis_ncr.to_string() == "a&#128512;b", "Shift_JIS NCR fallback for emoji")
  let gbk_ncr = from_utf8("你好😀", "GBK")
  match to_utf8(gbk_ncr, "GBK") {
    Option::Some(u) => debug_assert(u.to_string() == "你好&#128512;", "GBK NCR fallback for emoji")
    Option::None => debug_assert(false, "GBK decode of NCR failed")
  }
  let w1252_ncr = from_utf8("€😀", "windows-1252")
  match to_utf8(w1252_ncr, "windows-1252") {
    Option::Some(u) => debug_assert(u.to_string() == "€&#128512;", "windows-1252 NCR fallback for emoji")
    Option::None => debug_assert(false, "windows-1252 decode of NCR failed")
  }

  // Unknown/invalid charset
  match to_utf8("hello".to_bytes(), "invalid-charset-xyz") {
    Option::None => ()
    Option::Some(_) => debug_assert(false, "unknown charset must return None")
  }
  let fallback = from_utf8("你好😀", "invalid-charset-xyz")
  debug_assert(fallback.to_string() == "你好😀", "from_utf8 unknown charset falls back to UTF-8")

  // Empty input
  match to_utf8(Bytes::new(0), "GBK") {
    Option::Some(u) => debug_assert(u.length() == 0, "empty input -> empty Some")
    Option::None => debug_assert(false, "empty input with valid charset failed")
  }
  debug_assert(from_utf8("", "GBK").length() == 0, "from_utf8 empty string -> empty bytes")

  // Malformed byte sequences -> U+FFFD without panic
  let bad_utf8 = bytes_from_ints([0x41, 0xFF, 0xFE, 0x42])
  match to_utf8(bad_utf8, "UTF-8") {
    Option::Some(u) => debug_assert(u.to_string() == "A\u{FFFD}\u{FFFD}B", "malformed UTF-8 emits U+FFFD")
    Option::None => debug_assert(false, "to_utf8 malformed UTF-8 failed")
  }
  let bad_gbk = bytes_from_ints([0x81, 0x20])
  match to_utf8(bad_gbk, "GBK") {
    Option::Some(u) => debug_assert(u.to_string() == "\u{FFFD} ", "malformed GBK emits U+FFFD + ASCII")
    Option::None => debug_assert(false, "to_utf8 malformed GBK failed")
  }
}

test "loopback HTTP GET, POST, headers, status, cookies, and async request" {
  jar_add("ALL")
  let port = c_test_start_http(3)
  debug_assert(port > 0, "loopback HTTP server started")
  let base = "http://127.0.0.1:" + port.to_string()

  // 1. GET /hello sets cookie + Content-Type + Content-Disposition
  let (body, fin) = get(base + "/hello")
  debug_assert(body.to_string() == "hello-from-loopback", "GET body")
  debug_assert(fin == base + "/hello", "GET final url")
  debug_assert(last_content_type().contains("text/plain"), "Content-Type captured")
  debug_assert(last_disposition().contains("hello.txt"), "Content-Disposition captured")
  debug_assert(cookies_for(base + "/hello").contains("sid=pion42"), "cookie stored in jar")

  // 2. POST /echo sends body + cookie from jar, verifies 201 + response header
  let ans = request("POST", base + "/echo", "X-Client: pion", "payload-123".to_bytes(), true)
  debug_assert(ans.status == 201, "POST status 201")
  debug_assert(ans.headers.contains("X-Test-Reply: ok"), "POST response header")
  debug_assert(ans.body.to_string() == "cookie=1|body=payload-123", "POST echoed cookie + body")

  // 3. Async start + done
  let id = start("GET", base + "/missing", "", Bytes::new(0), true)
  debug_assert(id > 0, "async id > 0")
  let mut got_async = false
  let mut tries = 0
  while !got_async && tries < 20 {
    let evs = done(50)
    let mut i = 0
    while i < evs.length() {
      let (eid, ea) = evs[i]
      if eid == id {
        debug_assert(ea.status == 404, "async 404")
        debug_assert(ea.body.to_string() == "not-found", "async body")
        got_async = true
      }
      i = i + 1
    }
    tries = tries + 1
  }
  debug_assert(got_async, "async request completed")
  debug_assert(pending() == 0, "no pending async requests")
}

test "WebSocket basic API surface" {
  ws_clear()
  debug_assert(ws_active() == 0, "ws_active starts at 0")
  debug_assert(ws_fds().length() == 0, "ws_fds empty")
  debug_assert(ws_poll().length() == 0, "ws_poll empty")
  drop_started()
}

extern "C" fn c_test_start_dl_http(max_reqs : Int, total_len : Int64, slow_ms : Int) -> Int = "pion_fetch_test_start_dl_http"

extern "C" fn c_test_file_size(path : Ptr) -> Int64 = "pion_fetch_test_file_size"

extern "C" fn c_test_unlink(path : Ptr) -> Int = "pion_fetch_test_unlink"

extern "C" fn c_test_verify_pattern(path : Ptr, expected_len : Int64) -> Int = "pion_fetch_test_verify_pattern"

fn wait_download_done(id : Int, max_iters : Int) -> DownloadStatus {
  let mut i = 0
  while i < max_iters {
    let st = download_poll(id)
    match st.state {
      DownloadState::Downloading => c_sleep_ms(10)
      _ => return st
    }
    i = i + 1
  }
  download_poll(id)
}

test "streaming download rejects invalid paths and URLs" {
  debug_assert(download_start("http://127.0.0.1:1/a", "", "", 0L) == -1, "empty dest rejected")
  debug_assert(download_start("http://127.0.0.1:1/a", "/tmp/dir/", "", 0L) == -1, "trailing slash rejected")
  debug_assert(download_start("http://127.0.0.1:1/a", "/tmp/../etc/passwd", "", 0L) == -1, "dotdot traversal rejected")
  debug_assert(download_start("file:///etc/passwd", "/tmp/fv_bad.bin", "", 0L) == -1, "non-http URL rejected")
  debug_assert(download_start("http://127.0.0.1:1/a", "/tmp/fv_bad.bin", "", -1L) == -1, "negative resume rejected")
  let missing = download_poll(999999)
  match missing.state {
    DownloadState::NotFound => ()
    _ => debug_assert(false, "unknown id must report NotFound")
  }
  debug_assert(!download_cancel(999999), "cancel unknown id returns false")
}

test "streaming 48 MiB download keeps RSS delta < 8 MiB and verifies every byte" {
  let size48 : Int64 = 48L * 1024L * 1024L
  let port = c_test_start_dl_http(1, size48, 0)
  debug_assert(port > 0, "dl loopback server started")
  let dest = "/tmp/fv_test_48m_" + port.to_string() + ".bin"
  let part = dest + ".part"
  let _ = c_test_unlink(str_data_ptr(dest))
  let _ = c_test_unlink(str_data_ptr(part))

  let rss_before = rss_mb()
  let mut peak_rss = rss_before
  let id = download_start("http://127.0.0.1:" + port.to_string() + "/file48m", dest, "", 0L)
  debug_assert(id > 0, "download id > 0")

  let mut final_st = download_poll(id)
  let mut i = 0
  while i < 1500 {
    final_st = download_poll(id)
    let cur = rss_mb()
    if cur > peak_rss {
      peak_rss = cur
    }
    match final_st.state {
      DownloadState::Downloading => c_sleep_ms(10)
      _ => break
    }
    i = i + 1
  }

  match final_st.state {
    DownloadState::Completed => ()
    _ => debug_assert(false, "48 MiB download must complete: " + final_st.error)
  }
  debug_assert(final_st.http_status == 200, "48 MiB http_status == 200")
  debug_assert(final_st.bytes_received == size48, "48 MiB bytes_received exact")
  debug_assert(final_st.total_bytes == size48, "48 MiB total_bytes exact")
  debug_assert(peak_rss - rss_before < 8, "peak RSS delta must be < 8 MiB")
  debug_assert(c_test_file_size(str_data_ptr(dest)) == size48, "dest file size == 48 MiB")
  debug_assert(c_test_file_size(str_data_ptr(part)) == -1L, ".part atomically renamed away")
  debug_assert(c_test_verify_pattern(str_data_ptr(dest), size48) == 1, "all 48 MiB bytes match pattern")
  let _ = c_test_unlink(str_data_ptr(dest))
}

test "streaming download cancel + 206 Partial Content resume and 200 fallback" {
  // 1. Mid-transfer cancel (keep .part) + 206 resume
  let total : Int64 = 4L * 1024L * 1024L
  let port = c_test_start_dl_http(3, total, 15)
  debug_assert(port > 0, "range server started")
  let slow_url = "http://127.0.0.1:" + port.to_string() + "/slow"
  let fast_url = "http://127.0.0.1:" + port.to_string() + "/fast"
  let dest = "/tmp/fv_test_resume_" + port.to_string() + ".bin"
  let part = dest + ".part"
  let _ = c_test_unlink(str_data_ptr(dest))
  let _ = c_test_unlink(str_data_ptr(part))

  let id1 = download_start(slow_url, dest, "", 0L)
  debug_assert(id1 > 0, "id1 > 0")
  let mut tries = 0
  while tries < 200 {
    let st = download_poll(id1)
    if st.bytes_received >= 262144L {
      break
    }
    c_sleep_ms(10)
    tries = tries + 1
  }
  debug_assert(download_cancel(id1), "cancel id1 succeeded")
  let st_cancel = download_poll(id1)
  match st_cancel.state {
    DownloadState::Cancelled => ()
    _ => debug_assert(false, "state must be Cancelled")
  }
  let part_size = c_test_file_size(str_data_ptr(part))
  debug_assert(part_size > 0L && part_size < total, ".part preserved with partial bytes")

  // Resume from part_size via 206 Partial Content
  let id2 = download_start(fast_url, dest, "", part_size)
  debug_assert(id2 > 0, "id2 > 0")
  let st2 = wait_download_done(id2, 500)
  match st2.state {
    DownloadState::Completed => ()
    _ => debug_assert(false, "resumed download must complete: " + st2.error)
  }
  debug_assert(st2.http_status == 206, "resumed download received 206 Partial Content")
  debug_assert(st2.bytes_received == total, "resumed bytes_received == total")
  debug_assert(st2.total_bytes == total, "resumed total_bytes == total")
  debug_assert(c_test_verify_pattern(str_data_ptr(dest), total) == 1, "resumed file matches every byte")
  let _ = c_test_unlink(str_data_ptr(dest))

  // 2. Server ignores Range and returns 200 OK -> automatically overwrites from byte 0
  let dest2 = "/tmp/fv_test_fallback200_" + port.to_string() + ".bin"
  let part2 = dest2 + ".part"
  let _ = c_test_unlink(str_data_ptr(dest2))
  let _ = c_test_unlink(str_data_ptr(part2))
  let id3 = download_start("http://127.0.0.1:" + port.to_string() + "/norange", dest2, "", 65536L)
  let st3 = wait_download_done(id3, 500)
  match st3.state {
    DownloadState::Completed => ()
    _ => debug_assert(false, "200 fallback download must complete: " + st3.error)
  }
  debug_assert(st3.http_status == 200, "200 fallback status == 200")
  debug_assert(st3.bytes_received == total, "200 fallback bytes_received == total")
  debug_assert(c_test_verify_pattern(str_data_ptr(dest2), total) == 1, "200 fallback file matches every byte")
  let _ = c_test_unlink(str_data_ptr(dest2))
}

// ----- Pure-Pion WHATWG MIME Parsing & Sniffing tests -----

test "pure-Pion MIME parse_content_type, charset extraction, and Content-Disposition" {
  match parse_content_type("Text/HTML; Charset=\"UTF-8\"; boundary=abc") {
    Option::Some(ct) => {
      debug_assert(ct.type_name == "text", "type lowercased")
      debug_assert(ct.subtype == "html", "subtype lowercased")
      debug_assert(ct.essence == "text/html", "essence normalized")
      debug_assert(ct.charset.unwrap_or("") == "UTF-8", "quoted charset extracted")
      debug_assert(ct.params.length() == 2, "2 parameters parsed")
    }
    Option::None => debug_assert(false, "valid Content-Type must parse")
  }
  debug_assert(extract_charset("application/json; charset=utf-8").unwrap_or("") == "utf-8", "extract_charset json")
  debug_assert(extract_charset("image/png").is_none(), "image/png has no charset")
  debug_assert(parse_content_type("").is_none(), "empty Content-Type returns None")
  debug_assert(parse_content_type("not-a-mime-type").is_none(), "malformed Content-Type returns None")

  // Content-Disposition safe filename (RFC 5987 + path traversal defense)
  debug_assert(
    parse_content_disposition_filename("attachment; filename=\"../../etc/passwd\"").unwrap_or("") == "passwd",
    "Content-Disposition strips path traversal",
  )
  debug_assert(
    parse_content_disposition_filename("attachment; filename*=UTF-8''report%202026.pdf").unwrap_or("") == "report 2026.pdf",
    "Content-Disposition decodes RFC 5987 UTF-8",
  )
}

test "pure-Pion WHATWG MIME sniffing magic bytes and nosniff enforcement" {
  // nosniff header parser
  debug_assert(is_nosniff_header("nosniff"), "nosniff exact")
  debug_assert(is_nosniff_header("  NoSniff , other "), "nosniff case-insensitive + comma")
  debug_assert(!is_nosniff_header("sniff"), "non-nosniff rejected")

  // Magic-byte payloads
  let html_bytes = "<!DOCTYPE html><html><body>hi</body></html>".to_bytes()
  let xml_bytes = "<?xml version=\"1.0\"?><root/>".to_bytes()
  let json_bytes = "{\"ok\": true, \"n\": 42}".to_bytes()
  let png_bytes = bytes_from_ints([0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D])
  let jpeg_bytes = bytes_from_ints([0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x10])
  let gif_bytes = "GIF89a\u{0001}\u{0000}".to_bytes()
  let webp_bytes = "RIFF\u{0024}\u{0000}\u{0000}\u{0000}WEBPVP8 ".to_bytes()
  let svg_bytes = "<svg xmlns=\"http://www.w3.org/2000/svg\"></svg>".to_bytes()
  let mp4_bytes = bytes_from_ints([0x00, 0x00, 0x00, 0x18, 0x66, 0x74, 0x79, 0x70, 0x69, 0x73, 0x6F, 0x6D])
  let webm_bytes = bytes_from_ints([0x1A, 0x45, 0xDF, 0xA3, 0x9F, 0x42, 0x82, 0x84, 0x77, 0x65, 0x62, 0x6D])
  let woff2_bytes = "wOF2\u{0000}\u{0001}\u{0000}\u{0000}".to_bytes()
  let pdf_bytes = "%PDF-1.7\n".to_bytes()

  // Unspecified / octet-stream Content-Type sniffs accurately when nosniff = false
  debug_assert(sniff_content_type("", false, html_bytes) == "text/html; charset=utf-8", "sniff HTML")
  debug_assert(sniff_content_type("", false, xml_bytes) == "text/xml; charset=utf-8", "sniff XML")
  debug_assert(sniff_content_type("", false, json_bytes) == "application/json", "sniff JSON")
  debug_assert(sniff_content_type("", false, png_bytes) == "image/png", "sniff PNG")
  debug_assert(sniff_content_type("application/octet-stream", false, jpeg_bytes) == "image/jpeg", "sniff JPEG")
  debug_assert(sniff_content_type("unknown/unknown", false, gif_bytes) == "image/gif", "sniff GIF")
  debug_assert(sniff_content_type("*/*", false, webp_bytes) == "image/webp", "sniff WebP")
  debug_assert(sniff_content_type("", false, mp4_bytes) == "video/mp4", "sniff MP4")
  debug_assert(sniff_content_type("", false, webm_bytes) == "video/webm", "sniff WebM")
  debug_assert(sniff_content_type("", false, woff2_bytes) == "font/woff2", "sniff WOFF2")
  debug_assert(sniff_content_type("", false, pdf_bytes) == "application/pdf", "sniff PDF")

  // SVG: explicit image/svg+xml is preserved; untrusted unknown bytes are never promoted to scriptable image/svg+xml
  debug_assert(sniff_content_type("image/svg+xml", false, svg_bytes) == "image/svg+xml", "explicit SVG preserved")
  debug_assert(sniff_content_type("", false, svg_bytes) != "image/svg+xml", "untrusted bytes never sniffed as scriptable SVG")

  // X-Content-Type-Options: nosniff strictly prevents sniffing
  debug_assert(sniff_content_type("text/plain", true, html_bytes) == "text/plain", "nosniff keeps text/plain for HTML")
  debug_assert(sniff_content_type("text/plain", true, png_bytes) == "text/plain", "nosniff keeps text/plain for PNG")
  debug_assert(sniff_content_type("", true, html_bytes) == "application/octet-stream", "nosniff with empty CT defaults to octet-stream")

  // Apache bug rule: text/plain with HTML text stays text/plain, but binary PNG sniffs to image/png
  debug_assert(sniff_content_type("text/plain", false, html_bytes) == "text/plain", "text/plain never promoted to text/html")
  debug_assert(sniff_content_type("text/plain", false, png_bytes) == "image/png", "text/plain with binary PNG sniffs to image/png")

  // sniff_response_content_type extracts headers directly
  let hdrs_nosniff = "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nX-Content-Type-Options: nosniff\r\n"
  debug_assert(sniff_response_content_type(hdrs_nosniff, png_bytes) == "text/plain", "response headers respect nosniff")
  let hdrs_unknown = "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n"
  debug_assert(sniff_response_content_type(hdrs_unknown, woff2_bytes) == "font/woff2", "response headers sniff WOFF2")
}

// ---------------------------------------------------------------------------
// BrowserHttpCache (RFC 9111 private cache over http_cache)
// ---------------------------------------------------------------------------

///| A scripted origin: counts requests and keeps the last request's method, URL and header text.
struct HcOrigin {
  mut calls : Int
  mut last_method : String
  mut last_url : String
  mut last_headers : String
}

fn hc_origin() -> HcOrigin {
  HcOrigin::{ calls: 0, last_method: "", last_url: "", last_headers: "" }
}

fn hc_note(o : HcOrigin, m : String, u : String, h : String) -> Unit {
  o.calls = o.calls + 1
  o.last_method = m
  o.last_url = u
  o.last_headers = h
}

fn hc_ans(status : Int, headers : String, url : String, body : String) -> Answer {
  Answer::{ status: status, headers: "HTTP/1.1 " + status.to_string() + " X\r\n" + headers + "\r\n", url: url, body: body.to_bytes() }
}

fn hc_get(c : BrowserHttpCache, url : String, headers : String, send : (String, String, String, Bytes, Bool) -> Answer, clock : Array[Int64]) -> Answer {
  cached_request_with(c, "GET", url, headers, Bytes::new(0), true, send, fn() -> Int64 { clock[0] })
}

fn hc_header(ans : Answer, name_lower : String) -> String {
  match parse_header_text(ans.headers, browser_cache_limits()) {
    Ok(hs) => {
      let mut i = 0
      while i < hs.length() {
        if to_ascii_lower(hs[i].name) == name_lower {
          return hs[i].value
        }
        i = i + 1
      }
      ""
    }
    Err(_) => ""
  }
}

test "http cache header text parsing, serialization and DoS limits" {
  let lim = browser_cache_limits()
  let raw = "HTTP/2 200\r\nContent-Type: text/html\r\nCache-Control:  max-age=60 \r\nX-Fold: a\r\n  b\r\nbad line\r\nsp ace: v\r\nETag: \"x\"\n\r\n"
  match parse_header_text(raw, lim) {
    Ok(hs) => {
      debug_assert(hs.length() == 4, "status line, blank, colon-less and non-token lines are skipped")
      debug_assert(hs[0].name == "Content-Type" && hs[0].value == "text/html", "CRLF header")
      debug_assert(hs[1].value == "max-age=60", "OWS trimmed")
      debug_assert(hs[2].name == "X-Fold" && hs[2].value == "a b", "obs-fold joined with SP")
      debug_assert(hs[3].name == "ETag" && hs[3].value == "\"x\"", "LF-only line")
    }
    Err(e) => debug_assert(false, "parse failed: " + e)
  }
  // oversize text and too many headers fail closed
  let small = http_cache::CacheLimits::new(32, 2, 32, 64, 4194304L, 512, 33554432L)
  debug_assert(parse_header_text("A: 1\nB: 2\nC: 3", small).is_err(), "max_headers enforced")
  debug_assert(parse_header_text("A: 1\nB: 2", small).is_ok(), "within max_headers")
  debug_assert(parse_header_text("X-Long: 0123456789012345678901234567890", small).is_err(), "max_header_bytes enforced")
  // serialization never lets a value open a new line
  let txt = request_header_text([http_cache::Header::new("If-None-Match", "\"v\"\r\nEvil: 1"), http_cache::Header::new("bad name", "x")])
  debug_assert(txt == "If-None-Match: \"v\"  Evil: 1", "CR/LF stripped and non-token names dropped")
  let rt = response_header_text(200, [http_cache::Header::new("etag", "\"v\"")])
  debug_assert(rt == "HTTP/1.1 200\r\netag: \"v\"\r\n\r\n", "response block shape")
  debug_assert(wall_now_secs() > 1700000000L, "wall clock is Unix seconds")
}

test "http cache fresh max-age hit is served with zero network" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [1000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    hc_ans(200, "Cache-Control: max-age=60\r\nContent-Type: text/css\r\n", u, "body-" + o.calls.to_string())
  }
  let a1 = hc_get(c, "https://a.example/s.css#frag", "", send, clock)
  debug_assert(a1.status == 200 && a1.body.to_string() == "body-1", "miss goes to network")
  debug_assert(o.calls == 1, "one network call")
  clock[0] = 1000059L
  let a2 = hc_get(c, "https://a.example/s.css", "", send, clock)
  debug_assert(o.calls == 1, "fresh hit: zero network")
  debug_assert(a2.status == 200 && a2.body.to_string() == "body-1", "fresh hit body")
  debug_assert(hc_header(a2, "content-type") == "text/css", "fresh hit keeps headers")
  let head = cached_request_with(c, "HEAD", "https://a.example/s.css", "", Bytes::new(0), true, send, fn() -> Int64 { clock[0] })
  debug_assert(o.calls == 1 && head.status == 200 && head.body.length() == 0, "HEAD served from the GET entry without body")
  clock[0] = 1000061L
  let a3 = hc_get(c, "https://a.example/s.css", "", send, clock)
  debug_assert(o.calls == 2 && a3.body.to_string() == "body-2", "stale without validators refetches")
  let st = c.stats()
  debug_assert(st.hits == 2 && st.misses == 1, "hits/misses counted")
  debug_assert(st.stored_entries == 1 && st.stored_bytes == 6L, "replaced entry, 6 body bytes")
  c.clear()
  let st2 = c.stats()
  debug_assert(st2.stored_entries == 0 && st2.stored_bytes == 0L && st2.hits == 0, "clear drops entries and counters")
}

test "http cache no-store is never stored" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [2000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if u.ends_with("/resp") {
      hc_ans(200, "Cache-Control: no-store, max-age=600\r\n", u, "secret")
    } else {
      hc_ans(200, "Cache-Control: max-age=600\r\n", u, "public")
    }
  }
  let _ = hc_get(c, "https://a.example/resp", "", send, clock)
  let _ = hc_get(c, "https://a.example/resp", "", send, clock)
  debug_assert(o.calls == 2, "response no-store: every request hits the network")
  let _ = hc_get(c, "https://a.example/req", "Cache-Control: no-store", send, clock)
  debug_assert(c.stats().stored_entries == 0, "request no-store: nothing stored")
  debug_assert(!c.store("GET", "https://a.example/resp", "", hc_ans(200, "cache-control: NO-STORE\r\n", "https://a.example/resp", "x"), 1L, 1L), "store refuses no-store")
  debug_assert(!c.store("GET", "https://a.example/p", "", hc_ans(206, "cache-control: max-age=60\r\n", "https://a.example/p", "x"), 1L, 1L), "store refuses 206")
  debug_assert(c.stats().stored_entries == 0, "still nothing stored")
}

test "http cache Vary variants are isolated and Vary star is never reused" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [3000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if u.ends_with("/star") {
      hc_ans(200, "Cache-Control: max-age=600\r\nVary: *\r\n", u, "star")
    } else {
      hc_ans(200, "Cache-Control: max-age=600\r\nVary: Accept-Encoding\r\n", u, if h.contains("br") { "br-body" } else { "gzip-body" })
    }
  }
  let g1 = hc_get(c, "https://a.example/v", "Accept-Encoding: gzip", send, clock)
  let b1 = hc_get(c, "https://a.example/v", "Accept-Encoding: br", send, clock)
  debug_assert(o.calls == 2 && g1.body.to_string() == "gzip-body" && b1.body.to_string() == "br-body", "two variants fetched")
  let g2 = hc_get(c, "https://a.example/v", "accept-encoding:   gzip", send, clock)
  let b2 = hc_get(c, "https://a.example/v", "ACCEPT-ENCODING: br", send, clock)
  debug_assert(o.calls == 2, "both variants hit (header names case-insensitive)")
  debug_assert(g2.body.to_string() == "gzip-body" && b2.body.to_string() == "br-body", "each variant keeps its own body")
  let _ = hc_get(c, "https://a.example/v", "Accept-Encoding: zstd", send, clock)
  debug_assert(o.calls == 3, "an unseen variant misses")
  debug_assert(c.stats().stored_entries == 3, "three variants stored")
  let _ = hc_get(c, "https://a.example/star", "", send, clock)
  let _ = hc_get(c, "https://a.example/star", "", send, clock)
  debug_assert(o.calls == 5, "Vary: * is never reused")
  debug_assert(c.stats().stored_entries == 3, "Vary: * not stored")
}

test "http cache ETag If-None-Match 304 refreshes in place and keeps the body" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [4000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if h.contains("If-None-Match: \"v1\"") {
      hc_ans(304, "Cache-Control: max-age=100\r\nETag: \"v1\"\r\nX-Fresh: yes\r\n", u, "")
    } else if h.contains("If-Modified-Since: Sun, 06 Nov 1994 08:49:37 GMT") {
      hc_ans(304, "Cache-Control: max-age=100\r\n", u, "")
    } else if u.ends_with("/lm") {
      hc_ans(200, "Cache-Control: max-age=10\r\nLast-Modified: Sun, 06 Nov 1994 08:49:37 GMT\r\n", u, "lm-body")
    } else {
      hc_ans(200, "Cache-Control: max-age=10\r\nETag: \"v1\"\r\nContent-Type: application/json\r\n", u, "{\"big\":1}")
    }
  }
  let a1 = hc_get(c, "https://a.example/api", "Accept: */*", send, clock)
  debug_assert(o.calls == 1 && a1.status == 200, "first fetch")
  clock[0] = 4000020L
  let a2 = hc_get(c, "https://a.example/api", "Accept: */*", send, clock)
  debug_assert(o.calls == 2, "stale entry revalidated")
  debug_assert(o.last_headers.contains("Accept: */*") && o.last_headers.contains("If-None-Match: \"v1\""), "conditional header added to the page's headers")
  debug_assert(a2.status == 200 && a2.body.to_string() == "{\"big\":1}", "304 answered as 200 with the stored body")
  debug_assert(hc_header(a2, "x-fresh") == "yes" && hc_header(a2, "content-type") == "application/json", "304 metadata merged, stored headers kept")
  debug_assert(c.stats().revalidated_304 == 1, "revalidated_304 counted")
  clock[0] = 4000110L
  let _ = hc_get(c, "https://a.example/api", "Accept: */*", send, clock)
  debug_assert(o.calls == 2, "freshness refreshed by the 304 (max-age=100)")
  // Last-Modified validator -> If-Modified-Since
  let _ = hc_get(c, "https://a.example/lm", "", send, clock)
  clock[0] = 4000200L
  let l2 = hc_get(c, "https://a.example/lm", "", send, clock)
  debug_assert(o.last_headers.contains("If-Modified-Since: Sun, 06 Nov 1994 08:49:37 GMT"), "If-Modified-Since sent")
  debug_assert(l2.status == 200 && l2.body.to_string() == "lm-body", "Last-Modified 304 keeps body")
  // the page's own conditional request bypasses the cache and gets the raw 304
  let raw = hc_get(c, "https://a.example/api", "If-None-Match: \"v1\"", send, clock)
  debug_assert(raw.status == 304, "page-made conditional request is the page's to answer")
  // public lookup surfaces the conditional headers
  clock[0] = 4009999L
  match c.lookup("GET", "https://a.example/api", "Accept: */*", clock[0]) {
    BrowserCacheLookup::StaleNeedsRevalidation(cached, conds) => {
      debug_assert(conds == "If-None-Match: \"v1\"", "lookup builds If-None-Match")
      debug_assert(cached.body.to_string() == "{\"big\":1}", "lookup returns the stored answer")
    }
    _ => debug_assert(false, "expected StaleNeedsRevalidation")
  }
  match c.merge_304("https://a.example/api", "Accept: */*", hc_ans(304, "ETag: \"v1\"\r\nCache-Control: max-age=5\r\n", "https://a.example/api", ""), clock[0], clock[0]) {
    Some(full) => debug_assert(full.status == 200 && full.body.to_string() == "{\"big\":1}", "merge_304 keeps body")
    None => debug_assert(false, "merge_304 matched")
  }
  debug_assert(c.merge_304("https://a.example/api", "Accept: */*", hc_ans(304, "ETag: \"v2\"\r\n", "https://a.example/api", ""), clock[0], clock[0]).is_none(), "mismatched validator rejected")
}

test "http cache 304 with a contradicting validator refetches unconditionally" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [5000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if h.contains("If-None-Match") {
      hc_ans(304, "ETag: \"other\"\r\n", u, "")
    } else {
      hc_ans(200, "Cache-Control: max-age=10\r\nETag: \"v" + o.calls.to_string() + "\"\r\n", u, "body-" + o.calls.to_string())
    }
  }
  let _ = hc_get(c, "https://a.example/x", "", send, clock)
  clock[0] = 5000020L
  let a = hc_get(c, "https://a.example/x", "", send, clock)
  debug_assert(o.calls == 3, "conditional + unconditional request")
  debug_assert(!o.last_headers.contains("If-None-Match"), "second request is unconditional")
  debug_assert(a.status == 200 && a.body.to_string() == "body-3", "fresh full answer returned")
  debug_assert(c.stats().revalidated_304 == 0, "no 304 counted")
}

test "http cache unsafe methods invalidate same origin only" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [6000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if m == "GET" {
      hc_ans(200, "Cache-Control: max-age=600\r\n", u, "get")
    } else if u.ends_with("/fail") {
      hc_ans(500, "Location: https://a.example/list\r\n", u, "err")
    } else if u.ends_with("/xorigin") {
      hc_ans(201, "Location: https://b.example/data\r\nContent-Location: https://b.example/other\r\n", u, "made")
    } else {
      hc_ans(200, "Location: /list\r\n", u, "ok")
    }
  }
  let _ = hc_get(c, "https://a.example/item", "", send, clock)
  let _ = hc_get(c, "https://a.example/list", "", send, clock)
  let _ = hc_get(c, "https://b.example/data", "", send, clock)
  debug_assert(c.stats().stored_entries == 3, "three entries")
  let body = "x=1".to_bytes()
  let f = cached_request_with(c, "POST", "https://a.example/fail", "", body, true, send, fn() -> Int64 { clock[0] })
  debug_assert(f.status == 500 && c.stats().stored_entries == 3, "5xx answers invalidate nothing")
  let x = cached_request_with(c, "PUT", "https://a.example/xorigin", "", body, true, send, fn() -> Int64 { clock[0] })
  debug_assert(x.status == 201 && c.stats().stored_entries == 3, "cross-origin Location / Content-Location never invalidate")
  let calls_before = o.calls
  let _ = hc_get(c, "https://b.example/data", "", send, clock)
  debug_assert(o.calls == calls_before, "other origin entry still served from cache")
  let p = cached_request_with(c, "post", "https://a.example/item", "", body, true, send, fn() -> Int64 { clock[0] })
  debug_assert(p.status == 200 && o.last_method == "POST", "POST sent upper-cased")
  debug_assert(c.stats().stored_entries == 1, "POST 200 invalidated the target and same-origin Location")
  let _ = hc_get(c, "https://a.example/item", "", send, clock)
  debug_assert(o.calls == calls_before + 2, "invalidated entry refetched")
  debug_assert(c.invalidate("DELETE", "https://b.example/data", hc_ans(204, "", "https://b.example/data", "")) == 1, "DELETE 204 invalidates")
  debug_assert(c.invalidate("GET", "https://a.example/item", hc_ans(200, "", "https://a.example/item", "")) == 0, "safe methods never invalidate")
}

test "http cache only-if-cached answers 504 without network" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [7000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    hc_ans(200, "Cache-Control: max-age=30\r\n", u, "cached")
  }
  let a = hc_get(c, "https://a.example/o", "Cache-Control: only-if-cached", send, clock)
  debug_assert(a.status == 504 && o.calls == 0, "504 without network on miss")
  let _ = hc_get(c, "https://a.example/o", "", send, clock)
  let b = hc_get(c, "https://a.example/o", "Cache-Control: only-if-cached", send, clock)
  debug_assert(b.status == 200 && b.body.to_string() == "cached" && o.calls == 1, "fresh entry served for only-if-cached")
  clock[0] = 7000100L
  let s = hc_get(c, "https://a.example/o", "Cache-Control: only-if-cached", send, clock)
  debug_assert(s.status == 504 && o.calls == 1, "stale entry with only-if-cached is 504")
  debug_assert(c.stats().misses == 3, "two 504s and one miss")
}

test "http cache stale-while-revalidate serves stale and queues revalidation" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [8000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if h.contains("If-None-Match") {
      hc_ans(304, "ETag: \"s\"\r\nCache-Control: max-age=10, stale-while-revalidate=60\r\n", u, "")
    } else {
      hc_ans(200, "ETag: \"s\"\r\nCache-Control: max-age=10, stale-while-revalidate=60\r\n", u, "swr")
    }
  }
  let _ = hc_get(c, "https://a.example/swr", "", send, clock)
  clock[0] = 8000030L
  let s = hc_get(c, "https://a.example/swr", "", send, clock)
  let _ = hc_get(c, "https://a.example/swr", "", send, clock)
  debug_assert(s.body.to_string() == "swr" && o.calls == 1, "stale served without waiting on the network")
  debug_assert(c.pending_revalidations().length() == 1, "one revalidation queued (deduplicated)")
  debug_assert(c.run_pending_revalidations_with(send, fn() -> Int64 { clock[0] }) == 1, "queued revalidation ran")
  debug_assert(o.calls == 2 && o.last_headers.contains("If-None-Match: \"s\""), "background revalidation is conditional")
  debug_assert(c.pending_revalidations().length() == 0 && c.stats().revalidated_304 == 1, "queue drained, 304 merged")
  let _ = hc_get(c, "https://a.example/swr", "", send, clock)
  debug_assert(o.calls == 2, "fresh again after revalidation")
}

test "http cache CacheLimits bounds and LRU eviction" {
  debug_assert(BrowserHttpCache::with_limits(http_cache::CacheLimits::new(65536, 512, 32, 64, 8L, -1, 64L)).is_err(), "negative limit rejected")
  // max_total_bytes bounds bodies and stored header bytes separately
  let t = match BrowserHttpCache::with_limits(http_cache::CacheLimits::new(65536, 512, 32, 64, 100L, 100, 100L)) {
    Ok(v) => v
    Err(e) => abort(e)
  }
  let sixty = "012345678901234567890123456789012345678901234567890123456789"
  debug_assert(t.store("GET", "https://a.example/x", "", hc_ans(200, "Cache-Control: max-age=600\r\n", "https://a.example/x", sixty), 1L, 1L), "x stored")
  debug_assert(t.store("GET", "https://a.example/y", "", hc_ans(200, "Cache-Control: max-age=600\r\n", "https://a.example/y", sixty), 1L, 1L), "y stored")
  debug_assert(t.stats().stored_entries == 1 && t.stats().stored_bytes == 60L, "max_total_bytes evicted x")
  let c = match BrowserHttpCache::with_limits(http_cache::CacheLimits::new(65536, 512, 32, 64, 8L, 2, 1024L)) {
    Ok(v) => v
    Err(e) => abort(e)
  }
  let fresh = "Cache-Control: max-age=600\r\n"
  debug_assert(c.store("GET", "https://a.example/a", "", hc_ans(200, fresh, "https://a.example/a", "aaaaaaaa"), 1L, 1L), "8-byte body at max_entry_bytes stored")
  debug_assert(!c.store("GET", "https://a.example/big", "", hc_ans(200, fresh, "https://a.example/big", "123456789"), 1L, 1L), "9-byte body over max_entry_bytes refused")
  debug_assert(c.store("GET", "https://a.example/b", "", hc_ans(200, fresh, "https://a.example/b", "bb"), 1L, 1L), "b stored")
  // touch a so b becomes least recently used
  match c.lookup("GET", "https://a.example/a", "", 2L) {
    BrowserCacheLookup::Fresh(ans, ttl) => debug_assert(ans.body.to_string() == "aaaaaaaa" && ttl == 599L, "a fresh with ttl 599")
    _ => debug_assert(false, "a should be fresh")
  }
  debug_assert(c.store("GET", "https://a.example/c", "", hc_ans(200, fresh, "https://a.example/c", "cc"), 3L, 3L), "c stored")
  debug_assert(c.stats().stored_entries == 2, "max_entries = 2 holds")
  match c.lookup("GET", "https://a.example/b", "", 4L) {
    BrowserCacheLookup::Miss => ()
    _ => debug_assert(false, "LRU b evicted")
  }
  match c.lookup("GET", "https://a.example/a", "", 4L) {
    BrowserCacheLookup::Fresh(_, _) => ()
    _ => debug_assert(false, "recently used a kept")
  }
  debug_assert(c.stats().stored_bytes == 10L, "8 + 2 body bytes")
  // redirect: stored under the final URL
  debug_assert(c.store("GET", "https://a.example/old", "", hc_ans(200, fresh, "https://a.example/new#f", "n"), 5L, 5L), "redirected answer stored")
  match c.lookup("GET", "https://a.example/new", "", 6L) {
    BrowserCacheLookup::Fresh(ans, _) => debug_assert(ans.url == "https://a.example/new", "keyed by final URL without fragment")
    _ => debug_assert(false, "final URL should hit")
  }
  // default browser limits
  let d = browser_cache_limits()
  debug_assert(d.max_entries == 512 && d.max_total_bytes == 33554432L && d.max_entry_bytes == 4194304L, "default bounds")
}

test "http cache unstorable full answer to a revalidation drops the outdated entry" {
  let c = BrowserHttpCache::new()
  let o = hc_origin()
  let clock : Array[Int64] = [9000000L]
  let send = fn(m : String, u : String, h : String, _b : Bytes, _c : Bool) -> Answer {
    hc_note(o, m, u, h)
    if o.calls == 1 {
      hc_ans(200, "Cache-Control: max-age=10, stale-while-revalidate=600\r\nETag: \"a\"\r\n", u, "old")
    } else {
      hc_ans(200, "Cache-Control: no-store\r\n", u, "new")
    }
  }
  let _ = hc_get(c, "https://a.example/r", "", send, clock)
  clock[0] = 9000020L
  let a = cached_request_with(c, "GET", "https://a.example/r", "Cache-Control: no-cache", Bytes::new(0), true, send, fn() -> Int64 { clock[0] })
  debug_assert(o.calls == 2 && o.last_headers.contains("If-None-Match: \"a\""), "request no-cache revalidates")
  debug_assert(a.body.to_string() == "new" && c.stats().stored_entries == 0, "outdated entry dropped, no-store answer not kept")
  let b = hc_get(c, "https://a.example/r", "", send, clock)
  debug_assert(o.calls == 3 && b.body.to_string() == "new", "no stale-while-revalidate fallback to the old body")
}
