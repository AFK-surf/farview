///| Pure-Pion WHATWG MIME Type Parsing & MIME Sniffing helpers for `fetch`.
///| Backed by vendored `AFK-surf/pion-packages` `mime` (`pion/packages/mime/`).
///| Zero `extern "C"`, zero `World`, zero module-level mutable state.

import "mime"

///| Parsed HTTP `Content-Type` header (RFC 9110 / WHATWG MIME Sniffing Standard).
pub struct ParsedContentType {
  pub type_name : String
  pub subtype : String
  pub essence : String
  pub charset : Option[String]
  pub params : Array[(String, String)]
}

///| Parse an HTTP `Content-Type` header into normalized `type_name`, `subtype`,
///| `essence` (`type/subtype`), optional `charset` parameter, and all parameters.
///| Returns `None` if the header is empty or malformed.
pub fn parse_content_type(header : String) -> Option[ParsedContentType] {
  match mime::parse_media_type(header) {
    Result::Ok(mt) => {
      let params : Array[(String, String)] = []
      let mut i = 0
      while i < mt.params.length() {
        params.push((mt.params[i].name, mt.params[i].value))
        i = i + 1
      }
      let charset = match mt.param("charset") {
        Option::Some(cs) => {
          let t = cs.trim()
          if t.length() > 0 {
            Option::Some(t)
          } else {
            Option::None
          }
        }
        Option::None => Option::None
      }
      Option::Some(
        ParsedContentType::{
          type_name: mt.type_name,
          subtype: mt.subtype,
          essence: mt.essence(),
          charset: charset,
          params: params,
        },
      )
    }
    Result::Err(_) => Option::None
  }
}

///| Extract the `charset` parameter from a `Content-Type` header value, if present.
pub fn extract_charset(content_type : String) -> Option[String] {
  match parse_content_type(content_type) {
    Option::Some(ct) => ct.charset
    Option::None => Option::None
  }
}

///| Extract a safe download basename from a `Content-Disposition` header value
///| (RFC 6266 / RFC 5987, stripping path traversal, control bytes, and reserved names).
pub fn parse_content_disposition_filename(header : String) -> Option[String] {
  match mime::parse_content_disposition(header) {
    Result::Ok(cd) => cd.safe_filename()
    Result::Err(_) => Option::None
  }
}

///| Returns `true` if an `X-Content-Type-Options` header value enables `nosniff`
///| per WHATWG Fetch §4.7 (case-insensitive first comma-delimited token == `"nosniff"`).
pub fn is_nosniff_header(x_content_type_options : String) -> Bool {
  let parts = x_content_type_options.split(",")
  if parts.length() == 0 {
    return false
  }
  to_ascii_lower(parts[0].trim()) == "nosniff"
}

fn is_unknown_essence(essence : String) -> Bool {
  essence == "unknown/unknown" ||
  essence == "application/unknown" ||
  essence == "*/*"
}

fn is_apache_bug_content_type(raw : String) -> Bool {
  // WHATWG MIME Sniffing §7.2 exact Apache bug byte-string matches
  raw == "text/plain" ||
  raw == "text/plain; charset=ISO-8859-1" ||
  raw == "text/plain; charset=iso-8859-1" ||
  raw == "text/plain; charset=UTF-8"
}

fn is_xml_essence(type_name : String, subtype : String) -> Bool {
  (type_name == "text" && subtype == "xml") ||
  (type_name == "application" && subtype == "xml") ||
  subtype.ends_with("+xml")
}

fn is_binary_data_byte(b : Int) -> Bool {
  b <= 0x08 || b == 0x0B || (b >= 0x0E && b <= 0x1A) || (b >= 0x1C && b <= 0x1F)
}

fn has_binary_data_bytes(data : Bytes) -> Bool {
  let n = if data.length() < 512 { data.length() } else { 512 }
  let mut i = 0
  while i < n {
    if is_binary_data_byte(data[i].to_int() & 0xFF) {
      return true
    }
    i = i + 1
  }
  false
}

///| Determine the computed MIME type for a fetched resource per WHATWG MIME Sniffing §7:
///| - Respects `X-Content-Type-Options: nosniff` (`nosniff = true`): never sniffs body bytes.
///| - When `supplied_content_type` is empty, malformed, or `unknown/unknown` / `application/unknown` / `*/*`
///|   (or `application/octet-stream`), sniffs magic bytes & text/markup via pure-Pion `mime::sniff_mime`.
///| - For `text/plain` (Apache bug rule), only sniffs if body contains binary data bytes
///|   (never promotes `text/plain` to scriptable `text/html`).
///| - XML types (`text/xml`, `application/xml`, `*+xml` including `image/svg+xml`) are never sniffed.
///| - Non-SVG `image/*` types sniff binary image signatures (PNG/JPEG/GIF/WebP/BMP/ICO/AVIF)
///|   and fall back to the supplied `image/*` essence when unrecognized.
pub fn sniff_content_type(
  supplied_content_type : String,
  nosniff : Bool,
  data : Bytes,
) -> String {
  let parsed = parse_content_type(supplied_content_type)
  match parsed {
    Option::None => {
      if nosniff {
        "application/octet-stream"
      } else {
        mime::sniff_mime(data)
      }
    }
    Option::Some(ct) => {
      if nosniff {
        return ct.essence
      }
      if is_unknown_essence(ct.essence) || ct.essence == "application/octet-stream" {
        if data.length() == 0 {
          return "application/octet-stream"
        }
        return mime::sniff_mime(data)
      }
      if is_xml_essence(ct.type_name, ct.subtype) {
        return ct.essence
      }
      if is_apache_bug_content_type(supplied_content_type.trim()) {
        if has_binary_data_bytes(data) {
          let sniffed = mime::sniff_mime(data)
          if !sniffed.starts_with("text/") {
            return sniffed
          }
          return "application/octet-stream"
        }
        return ct.essence
      }
      if ct.type_name == "image" && ct.subtype != "svg+xml" {
        let sniffed = mime::sniff_mime(data)
        if sniffed.starts_with("image/") {
          return sniffed
        }
        return ct.essence
      }
      ct.essence
    }
  }
}

///| Direct magic-byte & WHATWG text/markup MIME sniffing over raw bytes.
pub fn sniff_mime_bytes(data : Bytes) -> String {
  mime::sniff_mime(data)
}

///| Extract `Content-Type` and `X-Content-Type-Options` from a newline-delimited
///| HTTP response header block (such as `Answer.headers`) and compute the sniffed MIME type.
pub fn sniff_response_content_type(headers : String, body : Bytes) -> String {
  let lines = headers.split("\n")
  let mut content_type = ""
  let mut nosniff = false
  let mut i = 0
  while i < lines.length() {
    let line = lines[i].trim()
    let colon = line.index_of(":")
    if colon > 0 {
      let name = to_ascii_lower(line.slice(0, colon).trim())
      let hval = line.slice(colon + 1, line.length()).trim()
      if name == "content-type" {
        content_type = hval
      } else if name == "x-content-type-options" {
        if is_nosniff_header(hval) {
          nosniff = true
        }
      }
    }
    i = i + 1
  }
  sniff_content_type(content_type, nosniff, body)
}
