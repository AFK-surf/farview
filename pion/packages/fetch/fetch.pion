fn keep_bytes_alive(b : Bytes) -> Unit {
  if b.length() < 0 {
    panic("unreachable")
  }
}

fn take_mb_bytes(p : Ptr) -> Bytes {
  let n = c_mb_len(p)
  let out = bytes_from_ptr(p, n)
  c_mb_free(p)
  out
}

fn take_mb_str(p : Ptr) -> String {
  take_mb_bytes(p).to_string()
}

fn read_u32_be(b : Bytes, i : Int) -> Int {
  ((b[i].to_int() & 0xFF) << 24) | ((b[i + 1].to_int() & 0xFF) << 16) | ((b[i + 2].to_int() & 0xFF) << 8) | (b[i + 3].to_int() & 0xFF)
}

fn read_i64_be(b : Bytes, i : Int) -> Int64 {
  let hi = read_u32_be(b, i).to_int64() & 0xFFFFFFFFL
  let lo = read_u32_be(b, i + 4).to_int64() & 0xFFFFFFFFL
  (hi << 32) | lo
}

fn to_ascii_upper(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 97 && c <= 122 {
      out[i] = (c - 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

fn to_ascii_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

pub fn curl_version_str() -> String {
  cstr_to_str(c_curl_version())
}

pub fn last_disposition() -> String {
  take_mb_str(c_last_disposition())
}

pub fn last_content_type() -> String {
  take_mb_str(c_last_content_type())
}

fn resolve_charset(charset : String) -> Option[encoding::Encoding] {
  match encoding::Encoding::for_label(charset) {
    Option::Some(enc) => Option::Some(enc)
    Option::None => {
      let lower = to_ascii_lower(charset.trim())
      if lower == "cp932" {
        Option::Some(encoding::Encoding::ShiftJis)
      } else if lower == "cp949" {
        Option::Some(encoding::Encoding::EucKr)
      } else {
        Option::None
      }
    }
  }
}

pub fn from_utf8(s : String, charset : String) -> Bytes {
  match resolve_charset(charset) {
    Option::Some(enc) => {
      let (out, _) = encoding::encode_html(enc, s)
      out
    }
    Option::None => s.to_bytes()
  }
}

pub fn to_utf8(data : Bytes, charset : String) -> Option[Bytes] {
  match resolve_charset(charset) {
    Option::Some(enc) => {
      if data.length() == 0 {
        return Option::Some(data)
      }
      Option::Some(encoding::decode(enc, data).to_bytes())
    }
    Option::None => Option::None
  }
}

pub fn sniff_and_decode_utf8(data : Bytes, charset : String) -> Option[(String, Bytes)] {
  match encoding::sniff_bom(data) {
    Option::Some((bom_enc, _)) => {
      let (decoded, actual, _) = encoding::decode_with_bom_sniffing(bom_enc, data)
      Option::Some((actual.name(), decoded.to_bytes()))
    }
    Option::None =>
    match resolve_charset(charset) {
      Option::Some(enc) => {
        let decoded = encoding::decode(enc, data)
        Option::Some((enc.name(), decoded.to_bytes()))
      }
      Option::None => Option::None
    }
  }
}

pub fn set_referer(page : String) -> Unit {
  c_set_referer(str_data_ptr(page))
}

pub fn prof_line(s : String) -> Unit {
  c_prof_line(str_data_ptr(s))
}

pub fn get(u : String) -> (Bytes, String) {
  let body = take_mb_bytes(c_get(str_data_ptr(u)))
  let fin = take_mb_str(c_last_url())
  (body, fin)
}

pub fn get_picture(u : String) -> (Bytes, String) {
  c_set_picture_accept(1)
  let r = get(u)
  c_set_picture_accept(0)
  r
}

pub fn get_many_pictures(urls : Array[String]) -> Array[(Bytes, String)] {
  c_set_picture_accept(1)
  let res = get_many(urls)
  c_set_picture_accept(0)
  res
}

pub fn get_many(urls : Array[String]) -> Array[(Bytes, String)] {
  let list = if urls.length() == 0 { "" } else { urls.join("\n") + "\n" }
  let out = take_mb_bytes(c_get_many(str_data_ptr(list)))
  let res : Array[(Bytes, String)] = []
  let mut pos = 0
  let mut k = 0
  while k < urls.length() && pos + 4 <= out.length() {
    let bn = read_u32_be(out, pos)
    pos = pos + 4
    let body = out.slice(pos, pos + bn)
    pos = pos + bn
    let un = read_u32_be(out, pos)
    pos = pos + 4
    let fin = out.slice(pos, pos + un).to_string()
    pos = pos + un
    res.push((body, fin))
    k = k + 1
  }
  res
}

pub fn resolve(base : String, r : String) -> String {
  url::resolve(base, r)
}

pub fn as_phone(phone : Bool) -> Unit {
  c_set_phone(if phone { 1 } else { 0 })
}

pub struct Answer {
  pub status : Int
  pub headers : String
  pub url : String
  pub body : Bytes
}

fn ensure_non_empty(body : Bytes) -> Bytes {
  if body.length() == 0 {
    Bytes::new(1)
  } else {
    body
  }
}

pub fn request(method : String, target_url : String, headers : String, body : Bytes, credentials : Bool) -> Answer {
  let m = to_ascii_upper(method)
  let b = ensure_non_empty(body)
  let raw = c_request(str_data_ptr(m), str_data_ptr(target_url), str_data_ptr(headers), bytes_data_ptr(b), body.length(), if credentials { 1 } else { 0 })
  keep_bytes_alive(b)
  let out = take_mb_bytes(raw)
  let mut i = 0
  let status = read_u32_be(out, i)
  i = i + 4
  let hn = read_u32_be(out, i)
  i = i + 4
  let hs = out.slice(i, i + hn).to_string()
  i = i + hn
  let fn_ = read_u32_be(out, i)
  i = i + 4
  let fin = out.slice(i, i + fn_).to_string()
  i = i + fn_
  let final_url = if fin == "" { target_url } else { fin }
  Answer::{ status: status, headers: hs, url: final_url, body: out.slice(i, out.length()) }
}

pub fn start(method : String, target_url : String, headers : String, body : Bytes, credentials : Bool) -> Int {
  let m = to_ascii_upper(method)
  let b = ensure_non_empty(body)
  let id = c_async_start(str_data_ptr(m), str_data_ptr(target_url), str_data_ptr(headers), bytes_data_ptr(b), body.length(), if credentials { 1 } else { 0 })
  keep_bytes_alive(b)
  id
}

pub fn done(wait_ms : Int) -> Array[(Int, Answer)] {
  let out = take_mb_bytes(c_async_poll(wait_ms))
  let list : Array[(Int, Answer)] = []
  let mut i = 0
  while i + 4 <= out.length() {
    let id = read_u32_be(out, i)
    i = i + 4
    let status = read_u32_be(out, i)
    i = i + 4
    let hn = read_u32_be(out, i)
    i = i + 4
    let hs = out.slice(i, i + hn).to_string()
    i = i + hn
    let fn_ = read_u32_be(out, i)
    i = i + 4
    let fin = out.slice(i, i + fn_).to_string()
    i = i + fn_
    let bn = read_u32_be(out, i)
    i = i + 4
    let body = out.slice(i, i + bn)
    i = i + bn
    list.push((id, Answer::{ status: status, headers: hs, url: fin, body: body }))
  }
  list
}

pub fn pending() -> Int {
  c_async_pending()
}

pub fn drop_started() -> Unit {
  c_async_clear()
  c_stream_clear()
  c_ws_clear()
}

pub enum StreamEvent {
  Head(Int, Int, String, String)
  Chunk(Int, Bytes)
  Done(Int, Bool, String)
}

pub fn stream_start(method : String, target_url : String, headers : String, body : Bytes, credentials : Bool, long_lived : Bool) -> Int {
  let m = to_ascii_upper(method)
  let b = ensure_non_empty(body)
  let id = c_stream_start(
    str_data_ptr(m),
    str_data_ptr(target_url),
    str_data_ptr(headers),
    bytes_data_ptr(b),
    body.length(),
    if credentials { 1 } else { 0 },
    if long_lived { 1 } else { 0 },
  )
  keep_bytes_alive(b)
  id
}

pub fn stream_abort(id : Int) -> Unit {
  c_stream_abort(id)
}

pub fn stream_active() -> Int {
  c_stream_active()
}

pub fn stream_clear() -> Unit {
  c_stream_clear()
}

pub fn stream_poll(wait_ms : Int) -> Array[StreamEvent] {
  let out = take_mb_bytes(c_stream_poll(wait_ms))
  let list : Array[StreamEvent] = []
  let mut i = 0
  let n = out.length()
  while i < n {
    let tag = out[i].to_int() & 0xFF
    i = i + 1
    if tag == 1 {
      let id = read_u32_be(out, i)
      i = i + 4
      let status = read_u32_be(out, i)
      i = i + 4
      let hn = read_u32_be(out, i)
      i = i + 4
      let hs = out.slice(i, i + hn).to_string()
      i = i + hn
      let fn_ = read_u32_be(out, i)
      i = i + 4
      let fin = out.slice(i, i + fn_).to_string()
      i = i + fn_
      list.push(StreamEvent::Head(id, status, hs, fin))
    } else if tag == 2 {
      let id = read_u32_be(out, i)
      i = i + 4
      let bn = read_u32_be(out, i)
      i = i + 4
      let data = out.slice(i, i + bn)
      i = i + bn
      list.push(StreamEvent::Chunk(id, data))
    } else if tag == 3 {
      let id = read_u32_be(out, i)
      i = i + 4
      let ok = (out[i].to_int() & 0xFF) != 0
      i = i + 1
      let en = read_u32_be(out, i)
      i = i + 4
      let err = out.slice(i, i + en).to_string()
      i = i + en
      list.push(StreamEvent::Done(id, ok, err))
    } else {
      break
    }
  }
  list
}

fn url_parts(u : String) -> (Bool, String, String) {
  let secure = u.starts_with("https:")
  let k_scheme = u.index_of("://")
  let rest = if k_scheme >= 0 { u.slice(k_scheme + 3, u.length()) } else { u }
  let k_slash = rest.index_of("/")
  let (host0, path) = if k_slash >= 0 {
    (rest.slice(0, k_slash), rest.slice(k_slash, rest.length()))
  } else {
    (rest, "/")
  }
  let k_colon = host0.index_of(":")
  let host = if k_colon >= 0 { host0.slice(0, k_colon) } else { host0 }
  (secure, to_ascii_lower(host), path)
}

fn trim_leading_dots(s : String) -> String {
  let mut i = 0
  let b = s.to_bytes()
  while i < b.length() && (b[i].to_int() & 0xFF) == 46 {
    i = i + 1
  }
  s.slice(i, s.length())
}

pub fn jar_lines() -> String {
  take_mb_str(c_cookies())
}

pub fn jar_add(line : String) -> Unit {
  c_set_cookie(str_data_ptr(line))
}

pub fn cookies_for(u : String) -> String {
  let (secure, host, path) = url_parts(u)
  let lines = jar_lines().split("\n")
  let out : Array[String] = []
  let mut i = 0
  while i < lines.length() {
    let f = lines[i].split("\t")
    if f.length() >= 7 && !f[0].starts_with("#HttpOnly_") {
      let domain = trim_leading_dots(f[0])
      let domain_ok = host == domain || (f[1] == "TRUE" && host.ends_with("." + domain))
      if domain_ok && path.starts_with(f[2]) && (f[3] != "TRUE" || secure) {
        out.push(f[5] + "=" + f[6])
      }
    }
    i = i + 1
  }
  out.join("; ")
}

pub fn set_cookie(u : String, text : String) -> Unit {
  let (_, host, _) = url_parts(u)
  let lower = to_ascii_lower(text)
  let line = if lower.contains("domain=") { text } else { text + "; domain=" + host }
  let hdr = "Set-Cookie: " + line
  c_set_cookie(str_data_ptr(hdr))
}

pub fn picture_size(data : Bytes) -> (Int, Int) {
  let b = ensure_non_empty(data)
  let wh = c_picture_size(bytes_data_ptr(b), data.length())
  keep_bytes_alive(b)
  (wh >> 16, wh & 0xFFFF)
}

pub fn to_png(data : Bytes) -> Option[Bytes] {
  let b = ensure_non_empty(data)
  let raw = c_to_png(bytes_data_ptr(b), data.length())
  keep_bytes_alive(b)
  let out = take_mb_bytes(raw)
  if out.length() > 0 {
    Option::Some(out)
  } else {
    Option::None
  }
}

pub fn shrink_picture(data : Bytes, max_px : Int, any_size : Bool) -> Option[Bytes] {
  let b = ensure_non_empty(data)
  let raw = c_shrink(bytes_data_ptr(b), data.length(), max_px, if any_size { 1 } else { 0 })
  keep_bytes_alive(b)
  let out = take_mb_bytes(raw)
  if out.length() > 0 {
    Option::Some(out)
  } else {
    Option::None
  }
}

// --- WebSocket (ws.c) ---

pub enum WsEvent {
  Open(Int, String)
  MsgText(Int, Bytes)
  MsgBin(Int, Bytes)
  Close(Int, Int, Bool, String)
  Error(Int)
}

pub fn ws_open(target_url : String, origin : String, protocols : String) -> Int {
  c_ws_open(str_data_ptr(target_url), str_data_ptr(origin), str_data_ptr(protocols))
}

pub fn ws_send(id : Int, is_bin : Bool, data : Bytes) -> Bool {
  let b = ensure_non_empty(data)
  let ok = c_ws_send(id, if is_bin { 1 } else { 0 }, bytes_data_ptr(b), data.length()) != 0
  keep_bytes_alive(b)
  ok
}

pub fn ws_close(id : Int, code : Int, reason : String) -> Unit {
  let rb = reason.to_bytes()
  let b = ensure_non_empty(rb)
  c_ws_close(id, code, bytes_data_ptr(b), rb.length())
  keep_bytes_alive(b)
}

pub fn ws_active() -> Int {
  c_ws_active()
}

pub fn ws_fds() -> Array[Int] {
  let raw = take_mb_bytes(c_ws_fds())
  let out : Array[Int] = []
  let mut i = 0
  while i + 4 <= raw.length() {
    out.push(read_u32_be(raw, i))
    i = i + 4
  }
  out
}

pub fn ws_clear() -> Unit {
  c_ws_clear()
}

pub fn ws_poll() -> Array[WsEvent] {
  let out = take_mb_bytes(c_ws_poll())
  let list : Array[WsEvent] = []
  let mut i = 0
  let n = out.length()
  while i < n {
    let tag = out[i].to_int() & 0xFF
    i = i + 1
    if tag == 1 {
      let id = read_u32_be(out, i)
      i = i + 4
      let pn = read_u32_be(out, i)
      i = i + 4
      let proto = out.slice(i, i + pn).to_string()
      i = i + pn
      list.push(WsEvent::Open(id, proto))
    } else if tag == 2 {
      let id = read_u32_be(out, i)
      i = i + 4
      let dn = read_u32_be(out, i)
      i = i + 4
      let data = out.slice(i, i + dn)
      i = i + dn
      list.push(WsEvent::MsgText(id, data))
    } else if tag == 3 {
      let id = read_u32_be(out, i)
      i = i + 4
      let dn = read_u32_be(out, i)
      i = i + 4
      let data = out.slice(i, i + dn)
      i = i + dn
      list.push(WsEvent::MsgBin(id, data))
    } else if tag == 4 {
      let id = read_u32_be(out, i)
      i = i + 4
      let code = read_u32_be(out, i)
      i = i + 4
      let clean = (out[i].to_int() & 0xFF) != 0
      i = i + 1
      let rn = read_u32_be(out, i)
      i = i + 4
      let reason = out.slice(i, i + rn).to_string()
      i = i + rn
      list.push(WsEvent::Close(id, code, clean, reason))
    } else if tag == 5 {
      let id = read_u32_be(out, i)
      i = i + 4
      list.push(WsEvent::Error(id))
    } else {
      break
    }
  }
  list
}

// --- Streaming Large-File Resumable Downloader ---

pub enum DownloadState {
  NotFound
  Downloading
  Completed
  Cancelled
  Failed
}

pub struct DownloadStatus {
  pub state : DownloadState
  pub bytes_received : Int64
  pub total_bytes : Int64
  pub http_status : Int
  pub speed_bps : Int64
  pub error : String
}

///| Start a streaming disk download to `dest_path` (written via `<dest_path>.part` and atomically renamed).
///| If `resume_from_bytes > 0`, sends `Range: bytes=<n>-` and appends on `206 Partial Content`,
///| or automatically restarts from byte 0 if the server returns `200 OK`.
///| Returns a positive download id, or -1 on invalid URL / unsafe path / spawn failure.
pub fn download_start(
  target_url : String,
  dest_path : String,
  headers : String,
  resume_from_bytes : Int64,
) -> Int {
  c_download_start(
    str_data_ptr(target_url),
    str_data_ptr(dest_path),
    str_data_ptr(headers),
    resume_from_bytes,
  )
}

///| Poll the current progress and state of a streaming download.
pub fn download_poll(id : Int) -> DownloadStatus {
  let out = take_mb_bytes(c_download_poll(id))
  if out.length() < 33 {
    return DownloadStatus::{
      state: DownloadState::NotFound,
      bytes_received: 0L,
      total_bytes: -1L,
      http_status: 0,
      speed_bps: 0L,
      error: "",
    }
  }
  let tag = out[0].to_int() & 0xFF
  let state = if tag == 1 {
    DownloadState::Downloading
  } else if tag == 2 {
    DownloadState::Completed
  } else if tag == 3 {
    DownloadState::Cancelled
  } else if tag == 4 {
    DownloadState::Failed
  } else {
    DownloadState::NotFound
  }
  let bytes_received = read_i64_be(out, 1)
  let total_bytes = read_i64_be(out, 9)
  let http_status = read_u32_be(out, 17)
  let speed_bps = read_i64_be(out, 21)
  let elen = read_u32_be(out, 29)
  let err = if elen > 0 && 33 + elen <= out.length() {
    out.slice(33, 33 + elen).to_string()
  } else {
    ""
  }
  DownloadStatus::{
    state: state,
    bytes_received: bytes_received,
    total_bytes: total_bytes,
    http_status: http_status,
    speed_bps: speed_bps,
    error: err,
  }
}

///| Safely cancel an in-flight download, keeping the `.part` file for later resume.
pub fn download_cancel(id : Int) -> Bool {
  c_download_cancel(id, 0) != 0
}

///| Safely cancel an in-flight download; if `remove_part` is true, also removes the `.part` file.
pub fn download_cancel_ex(id : Int, remove_part : Bool) -> Bool {
  c_download_cancel(id, if remove_part { 1 } else { 0 }) != 0
}
