///| Host system fonts and CoreText bindings for Farview.
///| 1:1 port of `src/hostfont/hostfont.mbt` + CoreText metrics/measurement via `[link.macos]`.

pub enum PathCmd {
  MoveTo(Double, Double)
  LineTo(Double, Double)
  QuadTo(Double, Double, Double, Double)
  CubicTo(Double, Double, Double, Double, Double, Double)
  Close
}

pub struct FontMetrics {
  pub ascent : Double
  pub descent : Double
  pub line_gap : Double
  pub x_height : Double
}

extern "C" fn c_mb_len(b : Ptr) -> Int = "pion_hf_mb_len"

extern "C" fn c_mb_free(b : Ptr) -> Unit = "pion_hf_mb_free"

extern "C" fn c_ct_fallback(family : Ptr, c : Int, weight : Int) -> Ptr = "pion_hf_ct_fallback"

extern "C" fn c_ct_outline(ps : Ptr, glyph : Int, upem : Int, wght : Int) -> Ptr = "pion_hf_ct_outline"

extern "C" fn c_file_exists(path : Ptr) -> Int = "pion_hf_file_exists"

extern "C" fn c_read_file_bytes(path : Ptr) -> Ptr = "pion_hf_read_file_bytes"

extern "C" fn c_ct_metrics(family : Ptr, size : Double, weight : Int, out4 : Ptr) -> Int = "pion_hf_ct_metrics"

extern "C" fn c_ct_measure_text(family : Ptr, size : Double, weight : Int, text : Ptr) -> Double = "pion_hf_ct_measure_text"

extern "C" fn c_ct_glyph_advance(family : Ptr, size : Double, weight : Int, cp : Int) -> Double = "pion_hf_ct_glyph_advance"

fn take_mb_bytes(p : Ptr) -> Bytes {
  let n = c_mb_len(p)
  let out = bytes_from_ptr(p, n)
  c_mb_free(p)
  out
}

let font_dir : String = "/System/Library/Fonts/"

let on_macos_cached : AtomicInt = AtomicInt::new(0)

pub fn on_macos() -> Bool {
  let c = on_macos_cached.load().to_int()
  if c != 0 {
    return c == 2
  }
  let probe = font_dir + "Helvetica.ttc"
  let res = c_file_exists(str_data_ptr(probe)) != 0
  on_macos_cached.store(if res { 2 } else { 1 })
  res
}

extern "C" fn c_file_size(path : Ptr) -> Int = "pion_hf_file_size"

extern "C" fn c_read_into(path : Ptr, dst : Ptr, max_len : Int) -> Int = "pion_hf_read_into"

pub fn read_font_file(path : String) -> Option[Bytes] {
  let sz = c_file_size(str_data_ptr(path))
  if sz <= 0 {
    return Option::None
  }
  let b = Bytes::new(sz)
  let got = c_read_into(str_data_ptr(path), bytes_data_ptr(b), sz)
  if got <= 0 {
    Option::None
  } else if got < sz {
    Option::Some(b.slice(0, got))
  } else {
    Option::Some(b)
  }
}

///| The face CoreText puts in for character `c` after a face of `family` ("" for system) at `weight`:
///| returns `Some((path, postscript_name))` or `None`.
pub fn coretext_fallback(family : String, c : Int, weight : Int) -> Option[(String, String)] {
  let p = c_ct_fallback(str_data_ptr(family), c, weight)
  let got = cstr_to_str(p)
  c_mb_free(p)
  let idx = got.index_of("\t")
  if idx < 0 {
    Option::None
  } else {
    Option::Some((got.slice(0, idx), got.slice(idx + 1, got.length())))
  }
}

pub fn ct_outline_raw(ps : String, glyph : Int, upem : Int, wght : Int) -> Bytes {
  take_mb_bytes(c_ct_outline(str_data_ptr(ps), glyph, upem, wght))
}

pub fn path_of_floats(b : Bytes) -> Array[PathCmd] {
  let n = b.length() / 4
  let ptr = bytes_data_ptr(b)
  let v : Array[Double] = []
  let mut i = 0
  while i < n {
    v.push(ptr_read_f32(ptr, (i * 4).to_int64()))
    i = i + 1
  }
  let out : Array[PathCmd] = []
  let mut j = 0
  while j < n {
    let kind = v[j].to_int()
    j = j + 1
    if kind == 0 && j + 2 <= n {
      out.push(PathCmd::MoveTo(v[j], v[j + 1]))
      j = j + 2
    } else if kind == 1 && j + 2 <= n {
      out.push(PathCmd::LineTo(v[j], v[j + 1]))
      j = j + 2
    } else if kind == 2 && j + 4 <= n {
      out.push(PathCmd::QuadTo(v[j], v[j + 1], v[j + 2], v[j + 3]))
      j = j + 4
    } else if kind == 3 && j + 6 <= n {
      out.push(PathCmd::CubicTo(v[j], v[j + 1], v[j + 2], v[j + 3], v[j + 4], v[j + 5]))
      j = j + 6
    } else if kind == 4 {
      out.push(PathCmd::Close)
    } else {
      break
    }
  }
  out
}

pub fn system_outline(ps : String, glyph : Int, upem : Int, wght : Int) -> Option[Array[PathCmd]] {
  let got = ct_outline_raw(ps, glyph, upem, wght)
  if got.length() >= 4 {
    Option::Some(path_of_floats(got))
  } else {
    Option::None
  }
}

pub fn metrics(family : String, size : Double, weight : Int) -> Option[FontMetrics] {
  let out : Array[Double] = [0.0, 0.0, 0.0, 0.0]
  let ok = c_ct_metrics(str_data_ptr(family), size, weight, array_data_ptr(out))
  if ok != 0 {
    Option::Some(FontMetrics::{ ascent: out[0], descent: out[1], line_gap: out[2], x_height: out[3] })
  } else {
    Option::None
  }
}

pub fn measure_text(family : String, size : Double, weight : Int, text : String) -> Double {
  c_ct_measure_text(str_data_ptr(family), size, weight, str_data_ptr(text))
}

pub fn glyph_advance(family : String, size : Double, weight : Int, cp : Int) -> Double {
  c_ct_glyph_advance(str_data_ptr(family), size, weight, cp)
}

fn append_all(dst : Array[String], src : Array[String]) -> Unit {
  let mut i = 0
  while i < src.length() {
    dst.push(src[i])
    i = i + 1
  }
}

fn linux_places(dirs : Array[String], files : Array[String]) -> Array[String] {
  let roots : Array[String] = ["/usr/share/fonts/", "/usr/local/share/fonts/"]
  let out : Array[String] = []
  let mut ri = 0
  while ri < roots.length() {
    let mut di = 0
    while di < dirs.length() {
      let mut fi = 0
      while fi < files.length() {
        out.push(roots[ri] + dirs[di] + "/" + files[fi])
        fi = fi + 1
      }
      di = di + 1
    }
    ri = ri + 1
  }
  out
}

fn liberation_dirs() -> Array[String] {
  [
    "truetype/liberation2",
    "truetype/liberation",
    "liberation-sans-fonts",
    "liberation-serif-fonts",
    "liberation-mono-fonts",
    "liberation-sans",
    "liberation-serif",
    "liberation-mono",
    "liberation",
  ]
}

fn dejavu_dirs() -> Array[String] {
  ["truetype/dejavu", "dejavu-sans-fonts", "dejavu-serif-fonts", "dejavu-sans-mono-fonts", "dejavu", "TTF"]
}

fn noto_dirs() -> Array[String] {
  ["truetype/noto", "google-noto", "google-noto-vf", "noto"]
}

fn urw_dirs() -> Array[String] {
  ["opentype/urw-base35", "type1/urw-base35", "urw-base35"]
}

fn noto_cjk_dirs() -> Array[String] {
  [
    "opentype/noto",
    "truetype/noto",
    "opentype/noto-cjk",
    "google-noto-cjk",
    "google-noto-sans-cjk-fonts",
    "noto-cjk",
    "noto",
  ]
}

fn linux_cjk_others() -> Array[String] {
  let out : Array[String] = []
  append_all(out, linux_places(["truetype/droid", "google-droid-sans-fonts", "droid"], ["DroidSansFallbackFull.ttf", "DroidSansFallback.ttf"]))
  append_all(out, linux_places(["truetype/wqy", "wqy-microhei", "wenquanyi"], ["wqy-microhei.ttc", "wqy-zenhei.ttc"]))
  out
}

fn linux_sans() -> Array[String] {
  let out : Array[String] = []
  append_all(out, linux_places(liberation_dirs(), ["LiberationSans-Regular.ttf", "LiberationSans-Bold.ttf", "LiberationSans-Italic.ttf", "LiberationSans-BoldItalic.ttf"]))
  append_all(out, linux_places(dejavu_dirs(), ["DejaVuSans.ttf", "DejaVuSans-Bold.ttf", "DejaVuSans-Oblique.ttf"]))
  append_all(out, linux_places(noto_dirs(), ["NotoSans-Regular.ttf", "NotoSans-Bold.ttf", "NotoSans-Italic.ttf"]))
  append_all(out, linux_places(urw_dirs(), ["NimbusSans-Regular.otf", "NimbusSans-Bold.otf", "NimbusSans-Italic.otf"]))
  out
}

fn linux_serif() -> Array[String] {
  let out : Array[String] = []
  append_all(out, linux_places(liberation_dirs(), ["LiberationSerif-Regular.ttf", "LiberationSerif-Bold.ttf", "LiberationSerif-Italic.ttf", "LiberationSerif-BoldItalic.ttf"]))
  append_all(out, linux_places(dejavu_dirs(), ["DejaVuSerif.ttf", "DejaVuSerif-Bold.ttf", "DejaVuSerif-Italic.ttf"]))
  append_all(out, linux_places(noto_dirs(), ["NotoSerif-Regular.ttf", "NotoSerif-Bold.ttf"]))
  append_all(out, linux_places(urw_dirs(), ["NimbusRoman-Regular.otf", "NimbusRoman-Bold.otf", "NimbusRoman-Italic.otf"]))
  out
}

fn linux_mono() -> Array[String] {
  let out : Array[String] = []
  append_all(out, linux_places(liberation_dirs(), ["LiberationMono-Regular.ttf", "LiberationMono-Bold.ttf", "LiberationMono-Italic.ttf", "LiberationMono-BoldItalic.ttf"]))
  append_all(out, linux_places(dejavu_dirs(), ["DejaVuSansMono.ttf", "DejaVuSansMono-Bold.ttf", "DejaVuSansMono-Oblique.ttf"]))
  append_all(out, linux_places(noto_dirs(), ["NotoSansMono-Regular.ttf", "NotoSansMono-Bold.ttf"]))
  append_all(out, linux_places(urw_dirs(), ["NimbusMonoPS-Regular.otf", "NimbusMonoPS-Bold.otf", "NimbusMonoPS-Italic.otf"]))
  out
}

pub fn linux_files_of(family : String) -> Array[String] {
  if family == "times" || family == "times new roman" || family == "georgia" || family == "serif" || family == "nimbus roman" {
    linux_serif()
  } else if family == "songti sc" || family == "songti tc" || family == "stsong" || family == "hiragino mincho pron" || family == "hiragino mincho pro" || family == "applemyungjo" {
    let out : Array[String] = []
    append_all(out, linux_places(noto_cjk_dirs(), ["NotoSerifCJK-Regular.ttc", "NotoSerifCJK-Bold.ttc"]))
    append_all(out, linux_cjk_others())
    append_all(out, linux_serif())
    out
  } else if family == "menlo" || family == "courier" || family == "courier new" || family == "monaco" || family == "sf mono" || family == "ui-monospace" || family == "sfmono-regular" || family == "consolas" || family == "dejavu sans mono" || family == "liberation mono" || family == "monospace" || family == "nimbus mono ps" {
    linux_mono()
  } else if family == "pingfang sc" || family == "pingfang tc" || family == "pingfang hk" || family == "hiragino sans gb" || family == "hiragino sans" || family == "hiragino kaku gothic pron" || family == "hiragino kaku gothic pro" || family == "apple sd gothic neo" || family == "noto sans cjk sc" || family == "noto sans sc" {
    let out : Array[String] = []
    append_all(out, linux_places(noto_cjk_dirs(), ["NotoSansCJK-Regular.ttc", "NotoSansCJK-Bold.ttc"]))
    append_all(out, linux_cjk_others())
    append_all(out, linux_sans())
    out
  } else if family == "helvetica" || family == "helvetica neue" || family == "helveticaneue" || family == "arial" || family == "verdana" || family == "tahoma" || family == "sf" || family == "blinkmacsystemfont" || family == "system-ui" || family == "ui-sans-serif" || family == "lucida grande" || family == "dejavu sans" || family == "liberation sans" || family == "noto sans" || family == "sans-serif" || family == "nimbus sans" {
    linux_sans()
  } else if family == "dejavu serif" || family == "liberation serif" || family == "noto serif" {
    linux_serif()
  } else {
    []
  }
}

pub fn mac_files_of(family : String) -> Array[String] {
  if family == "helvetica" {
    [font_dir + "Helvetica.ttc"]
  } else if family == "helvetica neue" || family == "helveticaneue" {
    [font_dir + "HelveticaNeue.ttc"]
  } else if family == "times" || family == "times new roman" {
    [
      font_dir + "Times.ttc",
      font_dir + "Supplemental/Times New Roman.ttf",
      font_dir + "Supplemental/Times New Roman Bold.ttf",
      font_dir + "Supplemental/Times New Roman Italic.ttf",
    ]
  } else if family == "arial" {
    [
      font_dir + "Supplemental/Arial.ttf",
      font_dir + "Supplemental/Arial Bold.ttf",
      font_dir + "Supplemental/Arial Italic.ttf",
      font_dir + "Supplemental/Arial Bold Italic.ttf",
    ]
  } else if family == "menlo" {
    [font_dir + "Menlo.ttc"]
  } else if family == "courier" {
    [font_dir + "Courier.ttc"]
  } else if family == "courier new" {
    [font_dir + "Supplemental/Courier New.ttf", font_dir + "Supplemental/Courier New Bold.ttf"]
  } else if family == "georgia" {
    [font_dir + "Supplemental/Georgia.ttf", font_dir + "Supplemental/Georgia Bold.ttf", font_dir + "Supplemental/Georgia Italic.ttf"]
  } else if family == "verdana" {
    [font_dir + "Supplemental/Verdana.ttf", font_dir + "Supplemental/Verdana Bold.ttf"]
  } else if family == "tahoma" {
    [font_dir + "Supplemental/Tahoma.ttf", font_dir + "Supplemental/Tahoma Bold.ttf"]
  } else if family == "sf" || family == "blinkmacsystemfont" || family == "system-ui" || family == "ui-sans-serif" {
    [font_dir + "SFNS.ttf", font_dir + "SFNSItalic.ttf"]
  } else if family == "sf mono" || family == "ui-monospace" || family == "sfmono-regular" {
    [font_dir + "SFNSMono.ttf", font_dir + "SFNSMonoItalic.ttf"]
  } else if family == "monaco" {
    [font_dir + "Monaco.ttf"]
  } else if family == "lucida grande" {
    [font_dir + "LucidaGrande.ttc"]
  } else if family == "hiragino kaku gothic pron" || family == "hiragino kaku gothic pro" {
    [font_dir + "ヒラギノ角ゴシック W3.ttc", font_dir + "ヒラギノ角ゴシック W6.ttc"]
  } else if family == "hiragino sans" {
    let out : Array[String] = []
    let mut i = 0
    while i < 10 {
      out.push(font_dir + "ヒラギノ角ゴシック W" + i.to_string() + ".ttc")
      i = i + 1
    }
    out
  } else if family == "hiragino mincho pron" || family == "hiragino mincho pro" {
    [font_dir + "ヒラギノ明朝 ProN.ttc"]
  } else if family == "hiragino sans gb" {
    [font_dir + "Hiragino Sans GB.ttc"]
  } else if family == "pingfang sc" || family == "pingfang tc" || family == "pingfang hk" {
    ["/System/Library/PrivateFrameworks/FontServices.framework/Versions/A/Resources/Reserved/PingFangUI.ttc"]
  } else if family == "songti sc" || family == "songti tc" || family == "stsong" {
    [font_dir + "Supplemental/Songti.ttc"]
  } else if family == "applemyungjo" {
    [font_dir + "Supplemental/AppleMyungjo.ttf"]
  } else if family == "apple sd gothic neo" {
    [font_dir + "AppleSDGothicNeo.ttc"]
  } else {
    []
  }
}

pub fn files_of(family : String) -> Array[String] {
  if on_macos() {
    mac_files_of(family)
  } else {
    linux_files_of(family)
  }
}

pub fn fallback_files() -> Array[String] {
  [
    "/System/Library/PrivateFrameworks/FontServices.framework/Versions/A/Resources/Reserved/PingFangUI.ttc",
    font_dir + "Hiragino Sans GB.ttc",
    font_dir + "ヒラギノ角ゴシック W3.ttc",
    font_dir + "AppleSDGothicNeo.ttc",
    font_dir + "SFArabic.ttf",
    font_dir + "SFHebrew.ttf",
    font_dir + "ThonburiUI.ttc",
    font_dir + "Kohinoor.ttc",
    font_dir + "SFArmenian.ttf",
    font_dir + "SFGeorgian.ttf",
    font_dir + "Apple Symbols.ttf",
    font_dir + "Apple Color Emoji.ttc",
    font_dir + "LastResort.otf",
    "/System/Library/Fonts/Supplemental/Songti.ttc",
    font_dir + "ヒラギノ明朝 ProN.ttc",
    font_dir + "ヒラギノ角ゴシック W6.ttc",
    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/google-noto-cjk/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf",
    "/usr/share/fonts/TTF/DejaVuSans.ttf",
    "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
    "/usr/share/fonts/google-noto/NotoSans-Regular.ttf",
    "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",
    "/usr/share/fonts/google-noto-emoji/NotoColorEmoji.ttf",
    "/usr/share/fonts/noto/NotoColorEmoji.ttf",
    "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
    "/usr/share/fonts/google-droid-sans-fonts/DroidSansFallbackFull.ttf",
    "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
    "/usr/local/share/fonts/NotoSansCJK-Regular.ttc",
    "/usr/local/share/fonts/DejaVuSans.ttf",
    "/usr/local/share/fonts/NotoSans-Regular.ttf",
    "/usr/local/share/fonts/NotoColorEmoji.ttf",
  ]
}
