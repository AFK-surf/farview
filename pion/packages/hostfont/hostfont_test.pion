///| Unit tests for `hostfont` (Linux/macOS family lookup, CoreText fallback, outline, metrics, ASCII+CJK measurement).

fn has_suffix_in(fs : Array[String], name : String) -> Bool {
  let suf = "/" + name
  let mut i = 0
  while i < fs.length() {
    if fs[i].ends_with(suf) {
      return true
    }
    i = i + 1
  }
  false
}

test "a family's files on a host without macOS's fonts are the free families standing in for it" {
  debug_assert(has_suffix_in(linux_files_of("helvetica"), "LiberationSans-Regular.ttf"), "helvetica liberation")
  debug_assert(has_suffix_in(linux_files_of("arial"), "DejaVuSans.ttf"), "arial dejavu")
  debug_assert(has_suffix_in(linux_files_of("times"), "LiberationSerif-Regular.ttf"), "times liberation")
  debug_assert(has_suffix_in(linux_files_of("menlo"), "DejaVuSansMono.ttf"), "menlo dejavu")
  debug_assert(has_suffix_in(linux_files_of("pingfang sc"), "NotoSansCJK-Regular.ttc"), "pingfang noto")
  debug_assert(has_suffix_in(linux_files_of("songti sc"), "NotoSerifCJK-Regular.ttc"), "songti noto")
  let hs = linux_files_of("helvetica")
  let mut i = 0
  let mut has_local = false
  while i < hs.length() {
    debug_assert(hs[i].starts_with("/usr/share/fonts/") || hs[i].starts_with("/usr/local/share/fonts/"), "linux prefix")
    if hs[i].starts_with("/usr/local/") && hs[i].ends_with("/LiberationSans-Regular.ttf") {
      has_local = true
    }
    i = i + 1
  }
  debug_assert(has_local, "has /usr/local/ LiberationSans")
  debug_assert(linux_files_of("no such family").length() == 0, "unknown family empty")
}

test "macOS family lookup, CoreText fallback, outline, metrics, and ASCII+CJK measurement" {
  if !on_macos() {
    return
  }
  let helv = files_of("helvetica")
  debug_assert(helv.length() == 1 && helv[0] == "/System/Library/Fonts/Helvetica.ttc", "macOS Helvetica.ttc")
  match read_font_file(helv[0]) {
    Option::Some(b) => debug_assert(b.length() > 10000, "Helvetica.ttc readable")
    Option::None => debug_assert(false, "Helvetica.ttc should exist")
  }

  // CoreText fallback for CJK character U+4E2D ('中')
  match coretext_fallback("Helvetica", 0x4E2D, 400) {
    Option::Some((path, ps)) => {
      debug_assert(path.length() > 0 && ps.length() > 0, "fallback returned path and ps")
      match system_outline(ps, 10, 1000, 400) {
        Option::Some(cmds) => debug_assert(cmds.length() > 0, "outline non-empty")
        Option::None => debug_assert(true, "outline optional for glyph 10")
      }
    }
    Option::None => debug_assert(false, "CoreText fallback for CJK should succeed on macOS")
  }

  // CoreText outline for Helvetica glyph 'A' (gid 36)
  match system_outline("Helvetica", 36, 2048, 0) {
    Option::Some(cmds) => debug_assert(cmds.length() >= 4, "Helvetica glyph outline has commands")
    Option::None => debug_assert(false, "Helvetica outline should succeed")
  }

  // CoreText metrics & ASCII+CJK width measurement
  match metrics("Helvetica", 16.0, 400) {
    Option::Some(m) => {
      debug_assert(m.ascent > 10.0 && m.ascent < 20.0, "ascent reasonable")
      debug_assert(m.descent > 2.0 && m.descent < 10.0, "descent reasonable")
      debug_assert(m.line_gap >= 0.0, "line_gap >= 0")
    }
    Option::None => debug_assert(false, "metrics should succeed on macOS")
  }
  let w_ascii = measure_text("Helvetica", 16.0, 400, "Hello, World!")
  let w_cjk = measure_text("Helvetica", 16.0, 400, "你好世界")
  let w_mix = measure_text("Helvetica", 16.0, 400, "Hello 世界 123")
  debug_assert(w_ascii > 50.0 && w_ascii < 150.0, "ascii width")
  debug_assert(w_cjk > 40.0 && w_cjk < 100.0, "cjk width")
  debug_assert(w_mix > w_cjk, "mixed width > cjk")
  let adv_a = glyph_advance("Helvetica", 16.0, 400, 65)
  let adv_zh = glyph_advance("Helvetica", 16.0, 400, 0x4E2D)
  debug_assert(adv_a > 5.0 && adv_a < 20.0, "advance 'A'")
  debug_assert(adv_zh > 10.0 && adv_zh < 24.0, "advance '中'")
  // Fallback symbol advances for macOS keycap glyphs ⌘ (U+2318) and ⇧ (U+21E7)
  match coretext_fallback("Helvetica", 0x2318, 400) {
    Option::Some((path, ps)) => debug_assert(path.length() > 0 && ps.length() > 0, "⌘ fallback face")
    Option::None => debug_assert(false, "CoreText fallback for ⌘ (U+2318) should succeed on macOS")
  }
  match coretext_fallback("Helvetica", 0x21E7, 400) {
    Option::Some((path, ps)) => debug_assert(path.length() > 0 && ps.length() > 0, "⇧ fallback face")
    Option::None => debug_assert(false, "CoreText fallback for ⇧ (U+21E7) should succeed on macOS")
  }
  let adv_cmd = glyph_advance("Helvetica", 16.0, 400, 0x2318)
  let adv_shift = glyph_advance("Helvetica", 16.0, 400, 0x21E7)
  debug_assert(adv_cmd >= 12.0 && adv_cmd <= 22.0, "⌘ advance at 16px must match full fallback glyph advance")
  debug_assert(adv_shift >= 12.0 && adv_shift <= 22.0, "⇧ advance at 16px must match full fallback glyph advance")
  let w_shortcut = measure_text("Helvetica", 16.0, 400, "Press ⌘K for the Command Bar, ⌘/ for Keyboard Shortcuts, or ⇧⌘C to copy")
  let w_plain = measure_text("Helvetica", 16.0, 400, "Press K for the Command Bar, / for Keyboard Shortcuts, or C to copy")
  debug_assert(w_shortcut > w_plain + 36.0, "shortcut string width must include full fallback advances for ⌘, ⌘, ⇧, ⌘")
}
