///| Download filename sanitization, Content-Disposition parsing, disk saving, and client download queue.
///| 1:1 port of `src/page/download.mbt`.

import "url"

fn dl_rev_index_of(s : String, needle : String) -> Int {
  let sb = s.to_bytes()
  let nb = needle.to_bytes()
  let slen = sb.length()
  let nlen = nb.length()
  if nlen == 0 || nlen > slen {
    return -1
  }
  let mut i = slen - nlen
  while i >= 0 {
    let mut ok = true
    let mut j = 0
    while j < nlen {
      if sb[i + j] != nb[j] {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i - 1
  }
  -1
}

fn dl_to_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

pub fn data_url_type(u : String) -> String {
  if !u.starts_with("data:") {
    return ""
  }
  let k = u.index_of(",")
  if k < 0 {
    return ""
  }
  let head = u.slice(5, k)
  let parts = head.split(";")
  if parts.length() == 0 {
    ""
  } else {
    dl_to_lower(parts[0].trim())
  }
}

pub fn header_value(headers : String, name : String) -> String {
  let key = dl_to_lower(name) + ":"
  let lines = headers.split("\n")
  let mut i = 0
  while i < lines.length() {
    let l = lines[i].trim()
    if dl_to_lower(l).starts_with(key) {
      return l.slice(key.length(), l.length()).trim()
    }
    i = i + 1
  }
  ""
}

///| Every `name` line's value of `headers`, in order, joined with ", " (RFC 9110 §5.3: a field sent on several
///| lines is the same as one line of their values joined by commas). "" when there is none.
pub fn header_values_joined(headers : String, name : String) -> String {
  let key = dl_to_lower(name) + ":"
  let out : Array[String] = []
  for line in headers.split("\n") {
    let l = line.trim()
    if dl_to_lower(l).starts_with(key) {
      let v = l.slice(key.length(), l.length()).trim()
      if v != "" {
        out.push(v)
      }
    }
  }
  out.join(", ")
}

pub fn is_attachment(header : String) -> Bool {
  dl_to_lower(header.trim()).starts_with("attachment")
}

pub fn disposition_name(header : String) -> Option[String] {
  let mut plain : Option[String] = Option::None
  let parts = header.split(";")
  let mut i = 0
  while i < parts.length() {
    let p = parts[i].trim()
    let k = p.index_of("=")
    if k >= 0 {
      let key = dl_to_lower(p.slice(0, k).trim())
      let mut v = p.slice(k + 1, p.length()).trim()
      if v.length() >= 2 && v.starts_with("\"") && v.ends_with("\"") {
        v = v.slice(1, v.length() - 1)
      }
      if key == "filename*" {
        let q = dl_rev_index_of(v, "'")
        let enc = if q >= 0 { v.slice(q + 1, v.length()) } else { v }
        match url::data_url_bytes("data:," + enc) {
          Option::Some(b) => return Option::Some(b.to_string())
          Option::None => ()
        }
      } else if key == "filename" {
        plain = Option::Some(v)
      }
    }
    i = i + 1
  }
  plain
}

pub fn safe_filename(name : String) -> String {
  let src = name.to_bytes()
  let out = Bytes::new(src.length())
  let mut i = 0
  while i < src.length() {
    let c = src[i].to_int() & 0xFF
    if c == 47 || c == 92 || c == 58 || c < 32 {
      out[i] = (95).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  let mut s = out.to_string().trim()
  while s.starts_with(".") {
    s = s.slice(1, s.length())
  }
  if s == "" {
    "download"
  } else {
    s
  }
}

pub fn url_file_name(u : String) -> String {
  if u.starts_with("data:") || u.starts_with("blob:") {
    return ""
  }
  let mut path = u
  let kh = path.index_of("#")
  if kh >= 0 {
    path = path.slice(0, kh)
  }
  let kq = path.index_of("?")
  if kq >= 0 {
    path = path.slice(0, kq)
  }
  let ks = dl_rev_index_of(path, "/")
  let last = if ks >= 0 { path.slice(ks + 1, path.length()) } else { "" }
  match url::data_url_bytes("data:," + last) {
    Option::Some(b) => b.to_string()
    Option::None => ""
  }
}

pub struct SavedDownload {
  pub name : String
  pub path : String
  pub url : String
  pub size : Int
}

pub struct ClientDownload {
  pub name : String
  pub url : String
  pub mime : String
  pub body : Bytes
}

pub struct DownloadManager {
  pub dir : String
  pub max_client_bytes : Int
  pub mut saved : Array[SavedDownload]
  pub mut pending_client : Array[ClientDownload]
}

pub fn DownloadManager::new(dir : String) -> DownloadManager {
  DownloadManager::{
    dir: dir,
    max_client_bytes: 268435456,
    saved: [],
    pending_client: [],
  }
}

pub fn DownloadManager::save(
  self : DownloadManager,
  w : World,
  source_url : String,
  given_name : String,
  body : Bytes,
  mime : String,
) -> Option[String] {
  let _ = fs_mkdir_p(w, self.dir)
  let raw_name = if given_name != "" { given_name } else { url_file_name(source_url) }
  let base = safe_filename(raw_name)
  let dot = dl_rev_index_of(base, ".")
  let (stem, ext) = if dot > 0 {
    (base.slice(0, dot), base.slice(dot, base.length()))
  } else {
    (base, "")
  }
  let mut file = base
  let mut n = 1
  while fs_exists(w, self.dir + "/" + file) {
    file = stem + " (" + n.to_string() + ")" + ext
    n = n + 1
  }
  let path = self.dir + "/" + file
  match fs_write_bytes(w, path, body) {
    Result::Err(_) => return Option::None
    Result::Ok(_) => ()
  }
  self.saved.push(SavedDownload::{ name: file, path: path, url: source_url, size: body.length() })
  let semi = mime.index_of(";")
  let ty = (if semi >= 0 { mime.slice(0, semi) } else { mime }).trim()
  let payload = if body.length() <= self.max_client_bytes { body } else { Bytes::new(0) }
  self.pending_client.push(ClientDownload::{ name: file, url: source_url, mime: ty, body: payload })
  Option::Some(path)
}

pub fn DownloadManager::take_client_downloads(self : DownloadManager) -> Array[ClientDownload] {
  let out = self.pending_client
  self.pending_client = []
  out
}
