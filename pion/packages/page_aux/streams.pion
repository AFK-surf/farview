///| Streaming HTTP requests (`fetch().body` ReadableStream, EventSource SSE): op 119.
///| 1:1 port of `src/page/streams.mbt`.

import "fetch"

pub struct StreamDispatch {
  pub ctx : Int
  pub event : fetch::StreamEvent
}

pub struct StreamTable {
  pub mut live : Map[String, Int]
  pub mut bg : Map[String, Bool]
}

pub fn StreamTable::new() -> StreamTable {
  StreamTable::{ live: Map::new(), bg: Map::new() }
}

pub fn StreamTable::start(
  self : StreamTable,
  ctx : Int,
  method : String,
  target_url : String,
  headers : String,
  body : Bytes,
  credentials : Bool,
  keepalive : Bool,
  long_lived : Bool,
) -> Int {
  let id = fetch::stream_start(method, target_url, headers, body, credentials, long_lived)
  let k = id.to_string()
  self.live.set(k, ctx)
  if keepalive || long_lived {
    self.bg.set(k, true)
  }
  id
}

pub fn StreamTable::abort(self : StreamTable, id : Int) -> Unit {
  let k = id.to_string()
  self.live.remove(k)
  self.bg.remove(k)
  fetch::stream_abort(id)
}

pub fn StreamTable::poll(self : StreamTable, wait_ms : Int) -> Array[StreamDispatch] {
  let out : Array[StreamDispatch] = []
  if self.live.length() == 0 && fetch::stream_active() == 0 {
    return out
  }
  let evs = fetch::stream_poll(wait_ms)
  let mut i = 0
  while i < evs.length() {
    let ev = evs[i]
    match ev {
      fetch::StreamEvent::Head(id, _, _, _) => match self.live.get(id.to_string()) {
        Option::Some(ctx) => out.push(StreamDispatch::{ ctx: ctx, event: ev })
        Option::None => ()
      }
      fetch::StreamEvent::Chunk(id, _) => match self.live.get(id.to_string()) {
        Option::Some(ctx) => out.push(StreamDispatch::{ ctx: ctx, event: ev })
        Option::None => ()
      }
      fetch::StreamEvent::Done(id, _, _) => {
        let k = id.to_string()
        match self.live.get(k) {
          Option::Some(ctx) => out.push(StreamDispatch::{ ctx: ctx, event: ev })
          Option::None => ()
        }
        self.live.remove(k)
        self.bg.remove(k)
      }
    }
    i = i + 1
  }
  out
}

pub fn StreamTable::is_busy(self : StreamTable) -> Bool {
  self.live.length() > self.bg.length()
}

pub fn StreamTable::has_live(self : StreamTable) -> Bool {
  self.live.length() > 0 || fetch::stream_active() > 0
}

pub fn StreamTable::clear(self : StreamTable) -> Unit {
  self.live = Map::new()
  self.bg = Map::new()
  fetch::stream_clear()
}
