///| Chrome Native Messaging host transport & recursive extension directory walker
///| backed by `native/page/native_messaging.c`.

extern "C" fn c_nm_spawn(exe : Ptr, exe_len : Int, origin : Ptr, origin_len : Int) -> Int = "fv_nm_spawn"

extern "C" fn c_nm_write(handle : Int, data : Ptr, len : Int) -> Int = "fv_nm_write"

extern "C" fn c_nm_peek_len(handle : Int) -> Int = "fv_nm_peek_len"

extern "C" fn c_nm_poll(handle : Int, out_buf : Ptr, out_cap : Int) -> Int = "fv_nm_poll"

pub extern "C" fn nm_close(handle : Int) -> Unit = "fv_nm_close"

pub extern "C" fn nm_close_all() -> Unit = "fv_nm_close_all"

pub extern "C" fn nm_active_count() -> Int = "fv_nm_active_count"

pub extern "C" fn nm_epoch_ms() -> Int64 = "fv_nm_epoch_ms"

extern "C" fn c_nm_lookup_win_registry(app : Ptr, app_len : Int, out_buf : Ptr, out_cap : Int) -> Int = "fv_nm_lookup_win_registry"

extern "C" fn c_ext_walk_dir(root : Ptr, root_len : Int, out_buf : Ptr, out_cap : Int, max_files : Int) -> Int = "fv_ext_walk_dir"

fn nm_non_empty(b : Bytes) -> Bytes {
  if b.length() == 0 {
    Bytes::new(1)
  } else {
    b
  }
}

///| Spawns a Chrome Native Messaging host binary, passing `origin` (`chrome-extension://<id>/`) as argv[1].
pub fn nm_spawn(exe_path : String, origin : String) -> Int {
  let eb = exe_path.to_bytes()
  let ob = origin.to_bytes()
  let ebs = nm_non_empty(eb)
  let obs = nm_non_empty(ob)
  c_nm_spawn(bytes_data_ptr(ebs), eb.length(), bytes_data_ptr(obs), ob.length())
}

///| Enqueues a length-prefixed UTF-8 JSON message to native messaging port `handle` (non-blocking).
pub fn nm_write(handle : Int, json_utf8 : String) -> Bool {
  let b = json_utf8.to_bytes()
  if b.length() == 0 {
    return false
  }
  c_nm_write(handle, bytes_data_ptr(b), b.length()) != 0
}

///| Non-blocking two-phase poll of native messaging port `handle` (allocates exact message size only).
///| Returns `(status, json_str)` where status is `1` (message), `0` (empty/alive), `-1` (disconnected).
pub fn nm_poll(handle : Int) -> (Int, String) {
  let ready_len = c_nm_peek_len(handle)
  if ready_len < 0 {
    return (-1, "")
  }
  if ready_len == 0 {
    return (0, "")
  }
  let buf = Bytes::new(ready_len)
  let n = c_nm_poll(handle, bytes_data_ptr(buf), ready_len)
  if n < 0 {
    (-1, "")
  } else if n == 0 {
    (0, "")
  } else {
    (1, buf.to_string())
  }
}

///| Looks up a Native Messaging manifest path in the Windows Registry (returns None on POSIX or if absent).
pub fn nm_lookup_win_registry(app_name : String) -> Option[String] {
  let ab = app_name.to_bytes()
  if ab.length() == 0 {
    return None
  }
  let cap = 4096
  let buf = Bytes::new(cap)
  let n = c_nm_lookup_win_registry(bytes_data_ptr(ab), ab.length(), bytes_data_ptr(buf), cap)
  if n <= 0 {
    return None
  }
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = buf[i]
    i += 1
  }
  Some(out.to_string())
}

///| Recursively lists all regular (non-symlink) relative POSIX file paths under `root_dir`.
///| Preserves spaces in filenames via NUL-delimited C framing; returns Err on cap overflow/truncation.
pub fn ext_walk_dir_checked(root_dir : String, max_files~ : Int = 2048) -> Result[Array[String], String] {
  let rb = root_dir.to_bytes()
  if rb.length() == 0 {
    return Err("empty extension directory")
  }
  let cap = 524288
  let buf = Bytes::new(cap)
  let n = c_ext_walk_dir(bytes_data_ptr(rb), rb.length(), bytes_data_ptr(buf), cap, max_files)
  if n == -2 {
    return Err("extension directory exceeded file or path limit")
  }
  if n < 0 {
    return Err("failed to walk extension directory")
  }
  let res : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < n {
    if buf[i] == b'\x00' {
      if i > start {
        let len = i - start
        let slice_b = Bytes::new(len)
        let mut k = 0
        while k < len {
          slice_b[k] = buf[start + k]
          k += 1
        }
        res.push(slice_b.to_string())
      }
      start = i + 1
    }
    i += 1
  }
  Ok(res)
}

///| Convenience wrapper returning an array of relative paths (empty on error).
pub fn ext_walk_dir(root_dir : String, max_files~ : Int = 2048) -> Array[String] {
  match ext_walk_dir_checked(root_dir, max_files=max_files) {
    Ok(paths) => paths
    Err(_) => []
  }
}
