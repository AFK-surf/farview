pub fn storage_test_http_start(max_reqs : Int) -> Int {
  c_storage_test_http_start(max_reqs)
}

pub fn storage_test_http_hits() -> Int {
  c_storage_test_http_hits()
}

fn st_non_empty(b : Bytes) -> Bytes {
  if b.length() == 0 {
    Bytes::new(1)
  } else {
    b
  }
}

fn st_take_buf(p : Ptr) -> Option[Bytes] {
  if ptr_is_null(p) {
    return Option::None
  }
  let n = c_storage_buf_len(p)
  if n < 0 {
    c_storage_buf_free(p)
    return Option::None
  }
  let out = if n == 0 {
    Bytes::new(0)
  } else {
    bytes_from_ptr(c_storage_buf_data(p), n)
  }
  c_storage_buf_free(p)
  Option::Some(out)
}

pub fn storage_env(name : String) -> Option[String] {
  let nb = name.to_bytes()
  let cstr = Bytes::new(nb.length() + 1)
  let mut i = 0
  while i < nb.length() {
    cstr[i] = nb[i]
    i = i + 1
  }
  cstr[nb.length()] = (0).to_byte()
  let p = c_storage_getenv(bytes_data_ptr(cstr))
  if ptr_is_null(p) {
    Option::None
  } else {
    Option::Some(cstr_to_str(p))
  }
}

pub fn default_partition_key() -> String {
  match storage_env("FV_PARTITION_KEY") {
    Option::Some(v) if v != "" => v
    _ => "default"
  }
}

pub fn storage_sqlite_available() -> Bool {
  c_storage_available() != 0
}

pub fn storage_sqlite_open(profile_dir : String) -> Bool {
  let db = profile_dir.to_bytes()
  let db_s = st_non_empty(db)
  c_storage_open(bytes_data_ptr(db_s), db.length()) != 0
}

pub fn storage_sqlite_is_wal(profile_dir : String) -> Bool {
  let db = profile_dir.to_bytes()
  let db_s = st_non_empty(db)
  c_storage_is_wal(bytes_data_ptr(db_s), db.length()) != 0
}

pub fn storage_sqlite_close() -> Unit {
  c_storage_close()
}

pub fn storage_sqlite_remove_db(profile_dir : String) -> Bool {
  let db = profile_dir.to_bytes()
  let db_s = st_non_empty(db)
  c_storage_remove_db(bytes_data_ptr(db_s), db.length()) != 0
}

pub fn storage_now_unix() -> Int64 {
  c_storage_now_unix()
}

fn st_read_u32_be(b : Bytes, pos : Int) -> Int {
  ((b[pos].to_int() & 0xFF) << 24) |
  ((b[pos + 1].to_int() & 0xFF) << 16) |
  ((b[pos + 2].to_int() & 0xFF) << 8) |
  (b[pos + 3].to_int() & 0xFF)
}

fn st_read_i64_be(b : Bytes, pos : Int) -> Int64 {
  let mut v = 0L
  let mut i = 0
  while i < 8 {
    v = (v << 8) | (b[pos + i].to_int() & 0xFF).to_int64()
    i = i + 1
  }
  v
}

fn st_write_u32_be(dst : Bytes, pos : Int, v : Int) -> Unit {
  dst[pos] = ((v >> 24) & 0xFF).to_byte()
  dst[pos + 1] = ((v >> 16) & 0xFF).to_byte()
  dst[pos + 2] = ((v >> 8) & 0xFF).to_byte()
  dst[pos + 3] = (v & 0xFF).to_byte()
}

fn st_pack_strings(items : Array[String]) -> Bytes {
  let bs : Array[Bytes] = []
  let mut total = 0
  let mut i = 0
  while i < items.length() {
    let b = items[i].to_bytes()
    total = total + 4 + b.length()
    bs.push(b)
    i = i + 1
  }
  let out = Bytes::new(total)
  let mut pos = 0
  i = 0
  while i < bs.length() {
    let b = bs[i]
    st_write_u32_be(out, pos, b.length())
    pos = pos + 4
    let mut j = 0
    while j < b.length() {
      out[pos + j] = b[j]
      j = j + 1
    }
    pos = pos + b.length()
    i = i + 1
  }
  out
}

pub fn sqlite_idb_get(dir : String, part : String, origin : String, key : String) -> Option[Bytes] {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let kb = key.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  let ks = st_non_empty(kb)
  st_take_buf(
    c_idb_get(
      bytes_data_ptr(ds),
      db.length(),
      bytes_data_ptr(ps),
      pb.length(),
      bytes_data_ptr(os),
      ob.length(),
      bytes_data_ptr(ks),
      kb.length(),
    ),
  )
}

pub fn sqlite_idb_put(dir : String, part : String, origin : String, key : String, data : Bytes) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let kb = key.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  let ks = st_non_empty(kb)
  let vs = st_non_empty(data)
  c_idb_put(
    bytes_data_ptr(ds),
    db.length(),
    bytes_data_ptr(ps),
    pb.length(),
    bytes_data_ptr(os),
    ob.length(),
    bytes_data_ptr(ks),
    kb.length(),
    bytes_data_ptr(vs),
    data.length(),
  ) != 0
}

pub fn sqlite_idb_del(dir : String, part : String, origin : String, key : String) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let kb = key.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  let ks = st_non_empty(kb)
  c_idb_del(
    bytes_data_ptr(ds),
    db.length(),
    bytes_data_ptr(ps),
    pb.length(),
    bytes_data_ptr(os),
    ob.length(),
    bytes_data_ptr(ks),
    kb.length(),
  ) != 0
}

pub fn sqlite_idb_list_keys(dir : String, part : String, origin : String, prefix : String) -> Array[String] {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let prb = prefix.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  let prs = st_non_empty(prb)
  let out : Array[String] = []
  match
  st_take_buf(
    c_idb_list_keys(
      bytes_data_ptr(ds),
      db.length(),
      bytes_data_ptr(ps),
      pb.length(),
      bytes_data_ptr(os),
      ob.length(),
      bytes_data_ptr(prs),
      prb.length(),
    ),
  ) {
    Option::Some(raw) => {
      let mut pos = 0
      while pos + 4 <= raw.length() {
        let n = st_read_u32_be(raw, pos)
        pos = pos + 4
        if n < 0 || pos + n > raw.length() {
          break
        }
        out.push(raw.slice(pos, pos + n).to_string())
        pos = pos + n
      }
    }
    Option::None => ()
  }
  out
}

pub fn sqlite_idb_clear_origin(dir : String, part : String, origin : String) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  c_idb_clear_origin(bytes_data_ptr(ds), db.length(), bytes_data_ptr(ps), pb.length(), bytes_data_ptr(os), ob.length()) != 0
}

pub fn sqlite_idb_usage_bytes(dir : String, part : String, origin : String) -> Int64 {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  c_idb_usage_bytes(bytes_data_ptr(ds), db.length(), bytes_data_ptr(ps), pb.length(), bytes_data_ptr(os), ob.length())
}

pub fn sqlite_http_cache_get_raw(dir : String, part : String, url : String, now_ts : Int64) -> Option[Bytes] {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ub = url.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let us = st_non_empty(ub)
  st_take_buf(
    c_http_cache_get(
      bytes_data_ptr(ds),
      db.length(),
      bytes_data_ptr(ps),
      pb.length(),
      bytes_data_ptr(us),
      ub.length(),
      now_ts,
    ),
  )
}

pub fn sqlite_http_cache_put(
  dir : String,
  part : String,
  url : String,
  status : Int,
  final_url : String,
  content_type : String,
  etag : String,
  last_modified : String,
  vary : String,
  expires_at : Int64,
  stored_at : Int64,
  body : Bytes,
  max_bytes : Int64,
) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let meta = st_pack_strings([url, final_url, content_type, etag, last_modified, vary])
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let ms = st_non_empty(meta)
  let bs = st_non_empty(body)
  c_http_cache_put(
    bytes_data_ptr(ds),
    db.length(),
    bytes_data_ptr(ps),
    pb.length(),
    bytes_data_ptr(ms),
    meta.length(),
    status,
    expires_at,
    stored_at,
    bytes_data_ptr(bs),
    body.length(),
    max_bytes,
  ) != 0
}

pub fn sqlite_http_cache_touch(
  dir : String,
  part : String,
  url : String,
  new_expires_at : Int64,
  now_ts : Int64,
  etag : String,
  last_modified : String,
) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ub = url.to_bytes()
  let eb = etag.to_bytes()
  let lb = last_modified.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let us = st_non_empty(ub)
  let es = st_non_empty(eb)
  let ls = st_non_empty(lb)
  c_http_cache_touch(
    bytes_data_ptr(ds),
    db.length(),
    bytes_data_ptr(ps),
    pb.length(),
    bytes_data_ptr(us),
    ub.length(),
    new_expires_at,
    now_ts,
    bytes_data_ptr(es),
    eb.length(),
    bytes_data_ptr(ls),
    lb.length(),
  ) != 0
}

pub fn sqlite_http_cache_delete(dir : String, part : String, url : String) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ub = url.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let us = st_non_empty(ub)
  c_http_cache_delete(bytes_data_ptr(ds), db.length(), bytes_data_ptr(ps), pb.length(), bytes_data_ptr(us), ub.length()) != 0
}

pub fn sqlite_http_cache_size_bytes(dir : String, part : String) -> Int64 {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  c_http_cache_size_bytes(bytes_data_ptr(ds), db.length(), bytes_data_ptr(ps), pb.length())
}

pub fn sqlite_http_cache_count(dir : String, part : String) -> Int {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  c_http_cache_count(bytes_data_ptr(ds), db.length(), bytes_data_ptr(ps), pb.length())
}

pub fn sqlite_perm_get(dir : String, part : String, origin : String, name : String) -> Option[String] {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let nb = name.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  let ns = st_non_empty(nb)
  match
  st_take_buf(
    c_perm_get(
      bytes_data_ptr(ds),
      db.length(),
      bytes_data_ptr(ps),
      pb.length(),
      bytes_data_ptr(os),
      ob.length(),
      bytes_data_ptr(ns),
      nb.length(),
    ),
  ) {
    Option::Some(b) => Option::Some(b.to_string())
    Option::None => Option::None
  }
}

pub fn sqlite_perm_set(dir : String, part : String, origin : String, name : String, state : String) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let nb = name.to_bytes()
  let sb = state.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  let ns = st_non_empty(nb)
  let ss = st_non_empty(sb)
  c_perm_set(
    bytes_data_ptr(ds),
    db.length(),
    bytes_data_ptr(ps),
    pb.length(),
    bytes_data_ptr(os),
    ob.length(),
    bytes_data_ptr(ns),
    nb.length(),
    bytes_data_ptr(ss),
    sb.length(),
  ) != 0
}

pub fn sqlite_perm_clear(dir : String, part : String, origin : String) -> Bool {
  let db = dir.to_bytes()
  let pb = part.to_bytes()
  let ob = origin.to_bytes()
  let ds = st_non_empty(db)
  let ps = st_non_empty(pb)
  let os = st_non_empty(ob)
  c_perm_clear(bytes_data_ptr(ds), db.length(), bytes_data_ptr(ps), pb.length(), bytes_data_ptr(os), ob.length()) != 0
}
