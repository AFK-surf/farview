extern "C" fn c_perm_set(dir : Ptr, dir_len : Int, part : Ptr, part_len : Int, origin : Ptr, origin_len : Int, name : Ptr, name_len : Int, state : Ptr, state_len : Int) -> Int = "fv_perm_set"
