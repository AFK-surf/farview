///| Cross-tab OAuth `window.open` / `window.opener` / `postMessage` / `BroadcastChannel` IPC state.
///| 1:1 port of `src/page/windows.mbt`.

pub struct WindowIpc {
  pub mut tab_id : String
  pub mut opener_id : String
  pub mut opener_origin : String
  pub mut posts : Array[(String, String)]
  pub mut opened_windows : Bool
  pub mut bc_subscribed : Bool
}

pub fn WindowIpc::new(tab_id : String, opener_id : String, opener_origin : String) -> WindowIpc {
  WindowIpc::{
    tab_id: tab_id,
    opener_id: opener_id,
    opener_origin: opener_origin,
    posts: [],
    opened_windows: false,
    bc_subscribed: false,
  }
}

///| Handles op 118 (`postMessage` to another tab or `"__bc_sub"` BroadcastChannel subscription).
///| Rejects path-traversal target ids containing `/` or `..`.
pub fn WindowIpc::post_op(self : WindowIpc, to : String, json : String) -> Unit {
  if to == "__bc_sub" {
    self.bc_subscribed = true
    return
  }
  if to != "" && !to.contains("/") && !to.contains("..") {
    self.posts.push((to, json))
  }
}

pub fn WindowIpc::mark_opened_window(self : WindowIpc) -> Unit {
  self.opened_windows = true
}

pub fn WindowIpc::take_posts(self : WindowIpc) -> Array[(String, String)] {
  let out = self.posts
  self.posts = []
  out
}

pub fn WindowIpc::has_window_ipc(self : WindowIpc) -> Bool {
  self.opener_id != "" || self.opened_windows
}

pub fn WindowIpc::has_bc(self : WindowIpc) -> Bool {
  self.bc_subscribed
}
