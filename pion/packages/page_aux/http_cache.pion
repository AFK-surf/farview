///| Farview Wave S1: Pure-Pion RFC 9111 HTTP cache policy parser + SQLite3 WAL disk cache.
///| Supports Cache-Control (max-age, s-maxage, no-store, no-cache, must-revalidate, immutable,
///| private, public), Expires (HTTP-date), Age, ETag, Last-Modified, Vary, 304 revalidation,
///| single-entry cap (16 MiB), and LRU eviction (default 256 MiB, configurable via FV_HTTP_CACHE_MB).

pub struct CacheDirective {
  pub no_store : Bool
  pub no_cache : Bool
  pub must_revalidate : Bool
  pub immutable : Bool
  pub is_private : Bool
  pub is_public : Bool
  pub max_age : Option[Int64]
  pub s_maxage : Option[Int64]
}

pub struct CachePolicy {
  pub storable : Bool
  pub expires_at : Int64
  pub etag : String
  pub last_modified : String
  pub vary : String
  pub content_type : String
  pub immutable : Bool
  pub no_cache : Bool
}

pub struct HttpCacheEntry {
  pub status : Int
  pub final_url : String
  pub content_type : String
  pub etag : String
  pub last_modified : String
  pub vary : String
  pub expires_at : Int64
  pub stored_at : Int64
  pub last_access : Int64
  pub body : Bytes
}

pub enum CacheLookup {
  Miss
  Fresh(HttpCacheEntry)
  Stale(HttpCacheEntry)
}

fn hc_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    out[i] = if c >= 65 && c <= 90 { (c + 32).to_byte() } else { src[i] }
    i = i + 1
  }
  out.to_string()
}

fn hc_parse_i64(s : String) -> Option[Int64] {
  let t = s.trim()
  if t == "" {
    return Option::None
  }
  let b = t.to_bytes()
  let mut i = 0
  let mut neg = false
  if b[0].to_int() == 45 {
    neg = true
    i = 1
  } else if b[0].to_int() == 43 {
    i = 1
  }
  if i >= b.length() {
    return Option::None
  }
  let mut acc = 0L
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c < 48 || c > 57 {
      return Option::None
    }
    acc = acc * 10L + (c - 48).to_int64()
    i = i + 1
  }
  Option::Some(if neg { -acc } else { acc })
}

fn hc_strip_quotes(s : String) -> String {
  let t = s.trim()
  if t.length() >= 2 && t.starts_with("\"") && t.ends_with("\"") {
    t.slice(1, t.length() - 1)
  } else {
    t
  }
}

pub fn parse_cache_control(hdr : String) -> CacheDirective {
  let mut no_store = false
  let mut no_cache = false
  let mut must_revalidate = false
  let mut immutable = false
  let mut is_private = false
  let mut is_public = false
  let mut max_age : Option[Int64] = Option::None
  let mut s_maxage : Option[Int64] = Option::None

  let parts = hdr.split(",")
  let mut i = 0
  while i < parts.length() {
    let tok = parts[i].trim()
    if tok != "" {
      let eq = tok.index_of("=")
      if eq < 0 {
        let k = hc_lower(tok)
        if k == "no-store" {
          no_store = true
        } else if k == "no-cache" {
          no_cache = true
        } else if k == "must-revalidate" {
          must_revalidate = true
        } else if k == "immutable" {
          immutable = true
        } else if k == "private" {
          is_private = true
        } else if k == "public" {
          is_public = true
        }
      } else {
        let k = hc_lower(tok.slice(0, eq).trim())
        let v = hc_strip_quotes(tok.slice(eq + 1, tok.length()))
        if k == "max-age" {
          match hc_parse_i64(v) {
            Option::Some(n) if n >= 0L => max_age = Option::Some(n)
            Option::Some(_) => max_age = Option::Some(0L)
            Option::None => ()
          }
        } else if k == "s-maxage" {
          match hc_parse_i64(v) {
            Option::Some(n) if n >= 0L => s_maxage = Option::Some(n)
            Option::Some(_) => s_maxage = Option::Some(0L)
            Option::None => ()
          }
        } else if k == "no-cache" {
          no_cache = true
        } else if k == "private" {
          is_private = true
        }
      }
    }
    i = i + 1
  }
  CacheDirective::{
    no_store: no_store,
    no_cache: no_cache,
    must_revalidate: must_revalidate,
    immutable: immutable,
    is_private: is_private,
    is_public: is_public,
    max_age: max_age,
    s_maxage: s_maxage,
  }
}

fn hc_month_num(m : String) -> Int {
  let l = hc_lower(m)
  if l == "jan" { 1 }
  else if l == "feb" { 2 }
  else if l == "mar" { 3 }
  else if l == "apr" { 4 }
  else if l == "may" { 5 }
  else if l == "jun" { 6 }
  else if l == "jul" { 7 }
  else if l == "aug" { 8 }
  else if l == "sep" { 9 }
  else if l == "oct" { 10 }
  else if l == "nov" { 11 }
  else if l == "dec" { 12 }
  else { 0 }
}

///| Howard Hinnant's civil-to-days algorithm: days since 1970-01-01 (UTC).
fn hc_days_from_civil(year : Int, month : Int, day : Int) -> Int64 {
  let y = (if month <= 2 { year - 1 } else { year }).to_int64()
  let era = (if y >= 0L { y } else { y - 399L }) / 400L
  let yoe = y - era * 400L
  let mp = (if month > 2 { month - 3 } else { month + 9 }).to_int64()
  let doy = (153L * mp + 2L) / 5L + day.to_int64() - 1L
  let doe = yoe * 365L + yoe / 4L - yoe / 100L + doy
  era * 146097L + doe - 719468L
}

fn hc_parse_hms(s : String) -> Option[(Int, Int, Int)] {
  let p = s.split(":")
  if p.length() != 3 {
    return Option::None
  }
  match (hc_parse_i64(p[0]), hc_parse_i64(p[1]), hc_parse_i64(p[2])) {
    (Option::Some(h), Option::Some(m), Option::Some(sec)) => {
      if h >= 0L && h <= 23L && m >= 0L && m <= 59L && sec >= 0L && sec <= 60L {
        Option::Some((h.to_int(), m.to_int(), sec.to_int()))
      } else {
        Option::None
      }
    }
    _ => Option::None
  }
}

///| Parses RFC 9110 HTTP-date (IMF-fixdate, RFC 850, asctime) into UTC Unix seconds.
pub fn parse_http_date(date_str : String) -> Option[Int64] {
  let s = date_str.trim()
  if s == "" {
    return Option::None
  }
  let raw_parts = s.split(" ")
  let tokens : Array[String] = []
  for p in raw_parts {
    let t = p.trim()
    if t != "" {
      tokens.push(t)
    }
  }
  // Format 1: IMF-fixdate: "Sun, 06 Nov 1994 08:49:37 GMT"
  if tokens.length() >= 5 && tokens[0].ends_with(",") {
    if tokens.length() >= 6 {
      let day_opt = hc_parse_i64(tokens[1])
      let mon = hc_month_num(tokens[2])
      let year_opt = hc_parse_i64(tokens[3])
      let hms_opt = hc_parse_hms(tokens[4])
      match (day_opt, year_opt, hms_opt) {
        (Option::Some(d), Option::Some(y), Option::Some((hh, mm, ss))) if mon > 0 && d >= 1L && d <= 31L => {
          let days = hc_days_from_civil(y.to_int(), mon, d.to_int())
          return Option::Some(days * 86400L + hh.to_int64() * 3600L + mm.to_int64() * 60L + ss.to_int64())
        }
        _ => ()
      }
    }
    // Format 2: RFC 850: "Sunday, 06-Nov-94 08:49:37 GMT"
    let dmy = tokens[1].split("-")
    if dmy.length() == 3 && tokens.length() >= 4 {
      let day_opt = hc_parse_i64(dmy[0])
      let mon = hc_month_num(dmy[1])
      let year_opt = hc_parse_i64(dmy[2])
      let hms_opt = hc_parse_hms(tokens[2])
      match (day_opt, year_opt, hms_opt) {
        (Option::Some(d), Option::Some(y0), Option::Some((hh, mm, ss))) if mon > 0 && d >= 1L && d <= 31L => {
          let y = if y0 < 70L { y0 + 2000L } else if y0 < 100L { y0 + 1900L } else { y0 }
          let days = hc_days_from_civil(y.to_int(), mon, d.to_int())
          return Option::Some(days * 86400L + hh.to_int64() * 3600L + mm.to_int64() * 60L + ss.to_int64())
        }
        _ => ()
      }
    }
  }
  // Format 3: asctime: "Sun Nov  6 08:49:37 1994"
  if tokens.length() == 5 {
    let mon = hc_month_num(tokens[1])
    let day_opt = hc_parse_i64(tokens[2])
    let hms_opt = hc_parse_hms(tokens[3])
    let year_opt = hc_parse_i64(tokens[4])
    match (day_opt, year_opt, hms_opt) {
      (Option::Some(d), Option::Some(y), Option::Some((hh, mm, ss))) if mon > 0 && d >= 1L && d <= 31L => {
        let days = hc_days_from_civil(y.to_int(), mon, d.to_int())
        return Option::Some(days * 86400L + hh.to_int64() * 3600L + mm.to_int64() * 60L + ss.to_int64())
      }
      _ => ()
    }
  }
  Option::None
}

fn hc_cacheable_status(status : Int) -> Bool {
  status == 200 || status == 203 || status == 204 || status == 206 || status == 300 || status == 301 || status == 404 || status == 405 || status == 410 || status == 414 || status == 501
}

///| Evaluates RFC 9111 storage eligibility and freshness expiration timestamp (UTC seconds).
pub fn evaluate_cache_policy(status : Int, headers : String, now_ts : Int64) -> CachePolicy {
  let cc_hdr = header_values_joined(headers, "cache-control")
  let cc = parse_cache_control(cc_hdr)
  let etag = header_value(headers, "etag")
  let lm = header_value(headers, "last-modified")
  let vary = header_value(headers, "vary")
  let ct = header_value(headers, "content-type")

  if cc.no_store || !hc_cacheable_status(status) {
    return CachePolicy::{
      storable: false,
      expires_at: 0L,
      etag: etag,
      last_modified: lm,
      vary: vary,
      content_type: ct,
      immutable: false,
      no_cache: cc.no_cache,
    }
  }
  // Vary: * is uncacheable per RFC 9111 §4.1
  if vary.trim() == "*" {
    return CachePolicy::{
      storable: false,
      expires_at: 0L,
      etag: etag,
      last_modified: lm,
      vary: vary,
      content_type: ct,
      immutable: false,
      no_cache: cc.no_cache,
    }
  }

  let age = match hc_parse_i64(header_value(headers, "age")) {
    Option::Some(a) if a > 0L => a
    _ => 0L
  }

  let mut expires_at = 0L
  let mut has_freshness = false

  if cc.no_cache {
    expires_at = 0L
    has_freshness = false
  } else {
    match cc.max_age {
      Option::Some(ma) => {
        let rem = ma - age
        expires_at = if rem > 0L { now_ts + rem } else { 0L }
        has_freshness = rem > 0L
      }
      Option::None => {
        let exp_hdr = header_value(headers, "expires")
        if exp_hdr != "" {
          match parse_http_date(exp_hdr) {
            Option::Some(exp_ts) => {
              let date_hdr = header_value(headers, "date")
              let base_ts = match parse_http_date(date_hdr) {
                Option::Some(dt) => dt
                Option::None => now_ts
              }
              let lifetime = exp_ts - base_ts - age
              expires_at = if lifetime > 0L { now_ts + lifetime } else { 0L }
              has_freshness = lifetime > 0L
            }
            Option::None => {
              expires_at = 0L
            }
          }
        } else if cc.immutable {
          expires_at = now_ts + 31536000L
          has_freshness = true
        }
      }
    }
  }

  let has_validator = etag != "" || lm != ""
  let storable = has_freshness || has_validator
  CachePolicy::{
    storable: storable,
    expires_at: expires_at,
    etag: etag,
    last_modified: lm,
    vary: vary,
    content_type: ct,
    immutable: cc.immutable,
    no_cache: cc.no_cache,
  }
}

pub fn http_cache_conditional_headers(entry : HttpCacheEntry) -> String {
  let parts : Array[String] = []
  if entry.etag != "" {
    parts.push("If-None-Match: " + entry.etag)
  }
  if entry.last_modified != "" {
    parts.push("If-Modified-Since: " + entry.last_modified)
  }
  parts.join("\r\n")
}

fn decode_http_cache_entry(raw : Bytes) -> Option[HttpCacheEntry] {
  if raw.length() < 28 {
    return Option::None
  }
  let mut pos = 0
  let status = st_read_u32_be(raw, pos)
  pos = pos + 4
  let expires_at = st_read_i64_be(raw, pos)
  pos = pos + 8
  let stored_at = st_read_i64_be(raw, pos)
  pos = pos + 8
  let last_access = st_read_i64_be(raw, pos)
  pos = pos + 8

  if pos + 4 > raw.length() { return Option::None }
  let furl_n = st_read_u32_be(raw, pos); pos = pos + 4
  if furl_n < 0 || pos + furl_n > raw.length() { return Option::None }
  let final_url = raw.slice(pos, pos + furl_n).to_string(); pos = pos + furl_n

  if pos + 4 > raw.length() { return Option::None }
  let ct_n = st_read_u32_be(raw, pos); pos = pos + 4
  if ct_n < 0 || pos + ct_n > raw.length() { return Option::None }
  let content_type = raw.slice(pos, pos + ct_n).to_string(); pos = pos + ct_n

  if pos + 4 > raw.length() { return Option::None }
  let etag_n = st_read_u32_be(raw, pos); pos = pos + 4
  if etag_n < 0 || pos + etag_n > raw.length() { return Option::None }
  let etag = raw.slice(pos, pos + etag_n).to_string(); pos = pos + etag_n

  if pos + 4 > raw.length() { return Option::None }
  let lm_n = st_read_u32_be(raw, pos); pos = pos + 4
  if lm_n < 0 || pos + lm_n > raw.length() { return Option::None }
  let last_modified = raw.slice(pos, pos + lm_n).to_string(); pos = pos + lm_n

  if pos + 4 > raw.length() { return Option::None }
  let vary_n = st_read_u32_be(raw, pos); pos = pos + 4
  if vary_n < 0 || pos + vary_n > raw.length() { return Option::None }
  let vary = raw.slice(pos, pos + vary_n).to_string(); pos = pos + vary_n

  if pos + 4 > raw.length() { return Option::None }
  let body_n = st_read_u32_be(raw, pos); pos = pos + 4
  if body_n < 0 || pos + body_n > raw.length() { return Option::None }
  let body = raw.slice(pos, pos + body_n)

  Option::Some(HttpCacheEntry::{
    status: status,
    final_url: final_url,
    content_type: content_type,
    etag: etag,
    last_modified: last_modified,
    vary: vary,
    expires_at: expires_at,
    stored_at: stored_at,
    last_access: last_access,
    body: body,
  })
}

pub fn default_http_cache_max_bytes() -> Int64 {
  match storage_env("FV_HTTP_CACHE_MB") {
    Option::Some(v) => match hc_parse_i64(v) {
      Option::Some(mb) if mb > 0L => mb * 1024L * 1024L
      _ => 256L * 1024L * 1024L
    }
    Option::None => 256L * 1024L * 1024L
  }
}

pub struct HttpDiskCache {
  pub profile_dir : String
  pub partition_key : String
  pub max_bytes : Int64
  pub max_entry_bytes : Int64
  pub mut disk_hits : Int
  pub mut revalidated_304 : Int
  pub mut disk_misses : Int
  pub mut disk_stores : Int
}

pub fn HttpDiskCache::new(profile_dir : String, partition_key : String, max_bytes : Int64) -> HttpDiskCache {
  let pk = if partition_key == "" { default_partition_key() } else { partition_key }
  let mb = if max_bytes > 0L { max_bytes } else { default_http_cache_max_bytes() }
  HttpDiskCache::{
    profile_dir: profile_dir,
    partition_key: pk,
    max_bytes: mb,
    max_entry_bytes: 16L * 1024L * 1024L,
    disk_hits: 0,
    revalidated_304: 0,
    disk_misses: 0,
    disk_stores: 0,
  }
}

pub fn HttpDiskCache::is_enabled(self : HttpDiskCache) -> Bool {
  self.profile_dir != "" && storage_sqlite_available()
}

pub fn HttpDiskCache::lookup(self : HttpDiskCache, url : String, now_ts : Int64) -> CacheLookup {
  if !self.is_enabled() || url == "" {
    self.disk_misses = self.disk_misses + 1
    return CacheLookup::Miss
  }
  match sqlite_http_cache_get_raw(self.profile_dir, self.partition_key, url, now_ts) {
    Option::None => {
      self.disk_misses = self.disk_misses + 1
      CacheLookup::Miss
    }
    Option::Some(raw) => match decode_http_cache_entry(raw) {
      Option::None => {
        self.disk_misses = self.disk_misses + 1
        CacheLookup::Miss
      }
      Option::Some(entry) => {
        if entry.expires_at > now_ts {
          self.disk_hits = self.disk_hits + 1
          CacheLookup::Fresh(entry)
        } else if entry.etag != "" || entry.last_modified != "" {
          CacheLookup::Stale(entry)
        } else {
          self.disk_misses = self.disk_misses + 1
          CacheLookup::Miss
        }
      }
    }
  }
}

pub fn HttpDiskCache::store(
  self : HttpDiskCache,
  url : String,
  status : Int,
  final_url : String,
  headers : String,
  body : Bytes,
  now_ts : Int64,
) -> Bool {
  if !self.is_enabled() || url == "" {
    return false
  }
  if body.length().to_int64() > self.max_entry_bytes || body.length().to_int64() > self.max_bytes {
    return false
  }
  let pol = evaluate_cache_policy(status, headers, now_ts)
  if !pol.storable {
    return false
  }
  let fin = if final_url != "" { final_url } else { url }
  let ok = sqlite_http_cache_put(
    self.profile_dir,
    self.partition_key,
    url,
    status,
    fin,
    pol.content_type,
    pol.etag,
    pol.last_modified,
    pol.vary,
    pol.expires_at,
    now_ts,
    body,
    self.max_bytes,
  )
  if ok {
    self.disk_stores = self.disk_stores + 1
  }
  ok
}

pub fn HttpDiskCache::revalidate_304(
  self : HttpDiskCache,
  url : String,
  headers : String,
  now_ts : Int64,
) -> Bool {
  if !self.is_enabled() || url == "" {
    return false
  }
  let pol = evaluate_cache_policy(200, headers, now_ts)
  let ok = sqlite_http_cache_touch(
    self.profile_dir,
    self.partition_key,
    url,
    pol.expires_at,
    now_ts,
    pol.etag,
    pol.last_modified,
  )
  if ok {
    self.revalidated_304 = self.revalidated_304 + 1
  }
  ok
}

pub fn HttpDiskCache::delete(self : HttpDiskCache, url : String) -> Bool {
  if !self.is_enabled() || url == "" {
    return false
  }
  sqlite_http_cache_delete(self.profile_dir, self.partition_key, url)
}

pub fn HttpDiskCache::size_bytes(self : HttpDiskCache) -> Int64 {
  if !self.is_enabled() {
    return 0L
  }
  sqlite_http_cache_size_bytes(self.profile_dir, self.partition_key)
}

pub fn HttpDiskCache::entry_count(self : HttpDiskCache) -> Int {
  if !self.is_enabled() {
    return 0
  }
  sqlite_http_cache_count(self.profile_dir, self.partition_key)
}
