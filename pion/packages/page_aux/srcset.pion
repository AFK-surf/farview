///| Responsive images (HTML §4.8.4.3): `<img srcset>` & `<picture><source>` candidate selection.
///| 1:1 port of `src/page/srcset.mbt`.

fn srcset_is_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn srcset_to_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

fn positive_float(s : String) -> Option[Double] {
  let b = s.to_bytes()
  let n = b.length()
  let mut i = 0
  if i < n && (b[i].to_int() & 0xFF) == 45 {
    return Option::None
  }
  let mut digits = 0
  while i < n {
    let c = b[i].to_int() & 0xFF
    if c >= 48 && c <= 57 {
      i = i + 1
      digits = digits + 1
    } else {
      break
    }
  }
  if i < n && (b[i].to_int() & 0xFF) == 46 {
    i = i + 1
    let mut frac = 0
    while i < n {
      let c = b[i].to_int() & 0xFF
      if c >= 48 && c <= 57 {
        i = i + 1
        frac = frac + 1
      } else {
        break
      }
    }
    if frac == 0 {
      return Option::None
    }
    digits = digits + frac
  }
  if digits == 0 {
    return Option::None
  }
  if i < n && ((b[i].to_int() & 0xFF) == 101 || (b[i].to_int() & 0xFF) == 69) {
    i = i + 1
    if i < n && ((b[i].to_int() & 0xFF) == 43 || (b[i].to_int() & 0xFF) == 45) {
      i = i + 1
    }
    let mut exp = 0
    while i < n {
      let c = b[i].to_int() & 0xFF
      if c >= 48 && c <= 57 {
        i = i + 1
        exp = exp + 1
      } else {
        break
      }
    }
    if exp == 0 {
      return Option::None
    }
  }
  if i != n {
    return Option::None
  }
  match s.to_double() {
    Option::Some(v) => if v > 0.0 { Option::Some(v) } else { Option::None }
    Option::None => Option::None
  }
}

fn positive_int(s : String) -> Option[Int] {
  let b = s.to_bytes()
  if b.length() == 0 {
    return Option::None
  }
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c < 48 || c > 57 {
      return Option::None
    }
    i = i + 1
  }
  match s.to_int() {
    Option::Some(v) => if v >= 1 { Option::Some(v) } else { Option::None }
    Option::None => Option::None
  }
}

pub struct SrcsetCandidate {
  pub url : String
  pub density : Option[Double]
  pub width : Option[Int]
}

pub fn parse_srcset(s : String) -> Array[SrcsetCandidate] {
  let b = s.to_bytes()
  let n = b.length()
  let out : Array[SrcsetCandidate] = []
  let mut i = 0
  while i < n {
    while i < n && (srcset_is_space(b[i].to_int() & 0xFF) || (b[i].to_int() & 0xFF) == 44) {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && !srcset_is_space(b[i].to_int() & 0xFF) {
      i = i + 1
    }
    let mut end = i
    let descs : Array[String] = []
    if (b[end - 1].to_int() & 0xFF) == 44 {
      while end > start && (b[end - 1].to_int() & 0xFF) == 44 {
        end = end - 1
      }
    } else {
      let mut in_parens = false
      let mut tok_start = -1
      while i < n {
        let c = b[i].to_int() & 0xFF
        if in_parens {
          if tok_start < 0 {
            tok_start = i
          }
          if c == 41 {
            in_parens = false
          }
        } else if c == 44 {
          if tok_start >= 0 {
            descs.push(s.slice(tok_start, i))
            tok_start = -1
          }
          i = i + 1
          break
        } else if srcset_is_space(c) {
          if tok_start >= 0 {
            descs.push(s.slice(tok_start, i))
            tok_start = -1
          }
        } else {
          if tok_start < 0 {
            tok_start = i
          }
          if c == 40 {
            in_parens = true
          }
        }
        i = i + 1
      }
      if tok_start >= 0 {
        descs.push(s.slice(tok_start, if i <= n { i } else { n }))
      }
    }
    let u = s.slice(start, end)
    if u == "" {
      continue
    }
    let mut x : Option[Double] = Option::None
    let mut w : Option[Int] = Option::None
    let mut has_h = false
    let mut bad = false
    let mut di = 0
    while di < descs.length() {
      let d = descs[di]
      if d.length() < 2 {
        bad = true
      } else {
        let unit = d.slice(d.length() - 1, d.length())
        let num = d.slice(0, d.length() - 1)
        if unit == "w" && w.is_none() && x.is_none() {
          match positive_int(num) {
            Option::Some(v) => w = Option::Some(v)
            Option::None => bad = true
          }
        } else if unit == "x" && x.is_none() && w.is_none() && !has_h {
          match positive_float(num) {
            Option::Some(v) => x = Option::Some(v)
            Option::None => bad = true
          }
        } else if unit == "h" && !has_h && x.is_none() {
          match positive_int(num) {
            Option::Some(_) => has_h = true
            Option::None => bad = true
          }
        } else {
          bad = true
        }
      }
      di = di + 1
    }
    if has_h && w.is_none() {
      bad = true
    }
    if !bad {
      out.push(SrcsetCandidate::{ url: u, density: x, width: w })
    }
  }
  out
}

pub fn is_drawn_image_mime(mime : String) -> Bool {
  let trimmed = mime.trim()
  if trimmed == "" {
    return true
  }
  let lt = srcset_to_lower(trimmed)
  let semi = lt.index_of(";")
  let ty = (if semi >= 0 { lt.slice(0, semi) } else { lt }).trim()
  ty == "image/jpeg" || ty == "image/jpg" || ty == "image/pjpeg" || ty == "image/png" || ty == "image/apng" || ty == "image/gif" || ty == "image/svg+xml" || ty == "image/bmp" || ty == "image/x-icon" || ty == "image/vnd.microsoft.icon"
}

pub struct PictureSource {
  pub srcset : String
  pub mime_type : String
  pub media_matches : Bool
}

pub fn select_image_choice(
  sources : Array[PictureSource],
  img_src : String,
  img_srcset : String,
  viewport_w : Double,
  dpr : Double,
) -> Option[(String, Double)] {
  let mut chosen_srcset = img_srcset
  let mut own = true
  let mut si = 0
  while si < sources.length() {
    let src = sources[si]
    if src.srcset != "" && src.media_matches && is_drawn_image_mime(src.mime_type) {
      chosen_srcset = src.srcset
      own = false
      break
    }
    si = si + 1
  }
  let cands = parse_srcset(chosen_srcset)
  if own && img_src != "" {
    let mut has_1x_or_w = false
    let mut ci = 0
    while ci < cands.length() {
      let c = cands[ci]
      if c.width.is_some() {
        has_1x_or_w = true
      } else {
        match c.density {
          Option::Some(d) => if d == 1.0 { has_1x_or_w = true }
          Option::None => has_1x_or_w = true
        }
      }
      ci = ci + 1
    }
    if !has_1x_or_w {
      cands.push(SrcsetCandidate::{ url: img_src, density: Option::None, width: Option::None })
    }
  }
  if cands.length() == 0 {
    return Option::None
  }
  let dens : Array[(String, Double)] = []
  let mut ci = 0
  while ci < cands.length() {
    let c = cands[ci]
    let d = match c.density {
      Option::Some(x) => x
      Option::None => match c.width {
        Option::Some(w) => if viewport_w > 0.0 { (w as Double) / viewport_w } else { 1000000.0 }
        Option::None => 1.0
      }
    }
    let mut dup = false
    let mut dj = 0
    while dj < dens.length() {
      let (_, ed) = dens[dj]
      if ed == d {
        dup = true
        break
      }
      dj = dj + 1
    }
    if !dup {
      dens.push((c.url, d))
    }
    ci = ci + 1
  }
  // Insertion sort by density ascending
  let mut a = 1
  while a < dens.length() {
    let cur = dens[a]
    let (_, cur_d) = cur
    let mut b = a
    while b > 0 {
      let (_, prev_d) = dens[b - 1]
      if prev_d > cur_d {
        dens[b] = dens[b - 1]
        b = b - 1
      } else {
        break
      }
    }
    dens[b] = cur
    a = a + 1
  }
  let mut k = 0
  while k < dens.length() {
    let (_, kd) = dens[k]
    if kd >= dpr {
      break
    }
    k = k + 1
  }
  if k == dens.length() {
    return Option::Some(dens[k - 1])
  }
  if k > 0 {
    let (_, d_lo) = dens[k - 1]
    let (_, d_hi) = dens[k]
    if math_sqrt(d_lo * d_hi) > dpr {
      return Option::Some(dens[k - 1])
    }
  }
  Option::Some(dens[k])
}
