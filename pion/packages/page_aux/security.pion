///| Farview Wave W1: Pure Pion W3C Content Security Policy Level 3 (CSP3) &
///| Fetch Standard CORS Policy Engine.
///| Zero external dependencies; 100% pure Pion.

// ============================================================================
// W3C Content Security Policy Level 3 (CSP3)
// ============================================================================

///| Parsed Content-Security-Policy header.
pub struct CspPolicy {
  directives : Map[String, Array[String]]
  upgrade_insecure_requests : Bool
  block_all_mixed_content : Bool
}

///| Result of evaluating a CSP directive against a target source or inline/eval execution.
pub enum CspDecision {
  Allow
  Block(String)
}

fn sec_is_ws(b : Byte) -> Bool {
  let c = b.to_int()
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn sec_ascii_lower(s : String) -> String {
  let bs = s.to_bytes()
  let n = bs.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = bs[i].to_int()
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = bs[i]
    }
    i = i + 1
  }
  out.to_string()
}

fn sec_trim(s : String) -> String {
  let bs = s.to_bytes()
  let n = bs.length()
  let mut start = 0
  while start < n && sec_is_ws(bs[start]) {
    start = start + 1
  }
  let mut end = n
  while end > start && sec_is_ws(bs[end - 1]) {
    end = end - 1
  }
  if start == 0 && end == n {
    s
  } else if start >= end {
    ""
  } else {
    s.slice(start, end)
  }
}

fn sec_split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let bs = s.to_bytes()
  let n = bs.length()
  let mut i = 0
  while i < n {
    while i < n && sec_is_ws(bs[i]) {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && !sec_is_ws(bs[i]) {
      i = i + 1
    }
    out.push(s.slice(start, i))
  }
  out
}

fn sec_normalize_csp_token(tok : String) -> String {
  let lower = sec_ascii_lower(tok)
  // Preserve case for base64 values in 'nonce-...' and 'sha256-...'/'sha384-...'/'sha512-...'.
  if lower.starts_with("'nonce-") && tok.ends_with("'") {
    return "'nonce-" + tok.slice(7, tok.length())
  }
  if lower.starts_with("'sha256-") && tok.ends_with("'") {
    return "'sha256-" + tok.slice(8, tok.length())
  }
  if lower.starts_with("'sha384-") && tok.ends_with("'") {
    return "'sha384-" + tok.slice(8, tok.length())
  }
  if lower.starts_with("'sha512-") && tok.ends_with("'") {
    return "'sha512-" + tok.slice(8, tok.length())
  }
  if lower == "'none'" ||
  lower == "'self'" ||
  lower == "'unsafe-inline'" ||
  lower == "'unsafe-eval'" ||
  lower == "'strict-dynamic'" ||
  lower == "'unsafe-hashes'" ||
  lower == "'report-sample'" ||
  lower == "'wasm-unsafe-eval'" {
    return lower
  }
  // Scheme-source like HTTPS: -> https:
  if tok.ends_with(":") {
    return lower
  }
  tok
}

///| Parses a single `Content-Security-Policy` header value into a `CspPolicy`.
///| Per W3C CSP3 §2.2.1, duplicate directives within the same policy are ignored (first wins).
pub fn parse_csp(header_value : String) -> CspPolicy {
  let dirs : Map[String, Array[String]] = Map::new()
  let mut upgrade_insecure = false
  let mut block_mixed = false

  let parts = header_value.split(";")
  for raw in parts {
    let trimmed = sec_trim(raw)
    if trimmed == "" {
      continue
    }
    let tokens = sec_split_ws(trimmed)
    if tokens.length() == 0 {
      continue
    }
    let name = sec_ascii_lower(tokens[0])
    if name == "upgrade-insecure-requests" {
      upgrade_insecure = true
    } else if name == "block-all-mixed-content" {
      block_mixed = true
    }
    if dirs.contains(name) {
      continue
    }
    let vals : Array[String] = []
    let mut i = 1
    while i < tokens.length() {
      vals.push(sec_normalize_csp_token(tokens[i]))
      i = i + 1
    }
    dirs.set(name, vals)
  }

  CspPolicy::{
    directives: dirs,
    upgrade_insecure_requests: upgrade_insecure,
    block_all_mixed_content: block_mixed,
  }
}

///| Parses multiple `Content-Security-Policy` header values (also splitting comma-separated policies).
pub fn parse_csp_list(headers : Array[String]) -> Array[CspPolicy] {
  let out : Array[CspPolicy] = []
  for h in headers {
    let segs = h.split(",")
    for seg in segs {
      let t = sec_trim(seg)
      if t != "" {
        out.push(parse_csp(t))
      }
    }
  }
  out
}

fn csp_fallback_chain(directive : String) -> Array[String] {
  let d = sec_ascii_lower(directive)
  if d == "script-src-elem" || d == "script-src-attr" {
    [d, "script-src", "default-src"]
  } else if d == "style-src-elem" || d == "style-src-attr" {
    [d, "style-src", "default-src"]
  } else if d == "worker-src" {
    ["worker-src", "child-src", "script-src", "default-src"]
  } else if d == "frame-src" {
    ["frame-src", "child-src", "default-src"]
  } else if d == "child-src" {
    ["child-src", "default-src"]
  } else if d == "script-src" ||
  d == "style-src" ||
  d == "img-src" ||
  d == "connect-src" ||
  d == "media-src" ||
  d == "font-src" ||
  d == "object-src" ||
  d == "manifest-src" ||
  d == "prefetch-src" {
    [d, "default-src"]
  } else {
    // base-uri, frame-ancestors, form-action, etc. do NOT fall back to default-src per CSP3.
    [d]
  }
}

fn csp_effective_sources(policy : CspPolicy, directive : String) -> Option[(String, Array[String])] {
  let chain = csp_fallback_chain(directive)
  for name in chain {
    match policy.directives.get(name) {
      Option::Some(list) => return Option::Some((name, list))
      Option::None => ()
    }
  }
  Option::None
}

struct ParsedUrlParts {
  scheme : String
  host : String
  port : Int
  path : String
  has_host : Bool
}

fn default_port_for_scheme(scheme : String) -> Int {
  if scheme == "http" || scheme == "ws" {
    80
  } else if scheme == "https" || scheme == "wss" {
    443
  } else if scheme == "ftp" {
    21
  } else {
    -1
  }
}

fn parse_uint_str(s : String) -> Int {
  let bs = s.to_bytes()
  if bs.length() == 0 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < bs.length() {
    let c = bs[i].to_int()
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

fn sec_index_of(s : String, needle : String) -> Int {
  let sb = s.to_bytes()
  let nb = needle.to_bytes()
  let sl = sb.length()
  let nl = nb.length()
  if nl == 0 {
    return 0
  }
  if nl > sl {
    return -1
  }
  let mut i = 0
  while i <= sl - nl {
    let mut j = 0
    let mut ok = true
    while j < nl {
      if sb[i + j] != nb[j] {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i + 1
  }
  -1
}

fn parse_url_parts(raw : String) -> ParsedUrlParts {
  let s = sec_trim(raw)
  let colon = sec_index_of(s, ":")
  if colon <= 0 {
    return ParsedUrlParts::{ scheme: "", host: "", port: -1, path: s, has_host: false }
  }
  let scheme = sec_ascii_lower(s.slice(0, colon))
  let rest = s.slice(colon + 1, s.length())
  if !rest.starts_with("//") {
    return ParsedUrlParts::{ scheme, host: "", port: -1, path: rest, has_host: false }
  }
  let after_slashes = rest.slice(2, rest.length())
  // Find end of authority: '/', '?', or '#'
  let bs = after_slashes.to_bytes()
  let mut auth_end = bs.length()
  let mut i = 0
  while i < bs.length() {
    let c = bs[i].to_int()
    if c == 47 || c == 63 || c == 35 {
      auth_end = i
      break
    }
    i = i + 1
  }
  let auth = after_slashes.slice(0, auth_end)
  let mut path = if auth_end < bs.length() {
    after_slashes.slice(auth_end, bs.length())
  } else {
    "/"
  }
  // Strip query and fragment from path for CSP path matching
  let q_idx = sec_index_of(path, "?")
  if q_idx >= 0 {
    path = path.slice(0, q_idx)
  }
  let h_idx = sec_index_of(path, "#")
  if h_idx >= 0 {
    path = path.slice(0, h_idx)
  }
  if path == "" {
    path = "/"
  }

  // Strip optional userinfo@
  let at_idx = sec_index_of(auth, "@")
  let hostport = if at_idx >= 0 { auth.slice(at_idx + 1, auth.length()) } else { auth }

  let mut host = hostport
  let mut port = default_port_for_scheme(scheme)
  if hostport.starts_with("[") {
    let rb = sec_index_of(hostport, "]")
    if rb >= 0 {
      host = sec_ascii_lower(hostport.slice(0, rb + 1))
      if rb + 1 < hostport.length() && hostport.slice(rb + 1, rb + 2) == ":" {
        let p = parse_uint_str(hostport.slice(rb + 2, hostport.length()))
        if p >= 0 {
          port = p
        }
      }
    }
  } else {
    let pc = sec_index_of(hostport, ":")
    if pc >= 0 {
      host = sec_ascii_lower(hostport.slice(0, pc))
      let p = parse_uint_str(hostport.slice(pc + 1, hostport.length()))
      if p >= 0 {
        port = p
      }
    } else {
      host = sec_ascii_lower(hostport)
    }
  }

  ParsedUrlParts::{ scheme, host, port, path, has_host: host != "" }
}

fn csp_scheme_matches(expr_scheme : String, target_scheme : String) -> Bool {
  if expr_scheme == target_scheme {
    return true
  }
  // W3C CSP3 §6.7.2.1: http matches https; ws matches wss.
  if expr_scheme == "http" && target_scheme == "https" {
    return true
  }
  if expr_scheme == "ws" && target_scheme == "wss" {
    return true
  }
  false
}

fn csp_host_matches(pattern : String, target_host : String) -> Bool {
  let pat = sec_ascii_lower(pattern)
  let host = sec_ascii_lower(target_host)
  if pat == "*" {
    return host != ""
  }
  if pat.starts_with("*.") {
    let suffix = pat.slice(1, pat.length()) // ".twimg.com"
    return host.length() > suffix.length() && host.ends_with(suffix)
  }
  pat == host
}

fn csp_path_matches(expr_path : String, target_path : String) -> Bool {
  if expr_path == "" {
    return true
  }
  if expr_path.ends_with("/") {
    return target_path.starts_with(expr_path)
  }
  expr_path == target_path
}

fn csp_expr_matches_url(
  expr : String,
  page : ParsedUrlParts,
  target : ParsedUrlParts,
) -> Bool {
  if expr == "'none'" {
    return false
  }
  if expr == "*" {
    // CSP3 §6.7.2.5: '*' matches network schemes or page's own scheme, never data:/blob:/filesystem:.
    if target.scheme == "data" || target.scheme == "blob" || target.scheme == "filesystem" {
      return false
    }
    return target.scheme == "http" ||
    target.scheme == "https" ||
    target.scheme == "ws" ||
    target.scheme == "wss" ||
    (page.scheme != "" && target.scheme == page.scheme)
  }
  if expr == "'self'" {
    if !page.has_host || !target.has_host {
      return false
    }
    if !csp_scheme_matches(page.scheme, target.scheme) {
      return false
    }
    if page.host != target.host {
      return false
    }
    // Port match: exact port match, or upgraded default port (http:80 -> https:443).
    if page.port == target.port {
      return true
    }
    if (page.scheme == "http" && target.scheme == "https" && page.port == 80 && target.port == 443) ||
    (page.scheme == "ws" && target.scheme == "wss" && page.port == 80 && target.port == 443) {
      return true
    }
    return false
  }
  // Keywords that are not URL source expressions
  if expr.starts_with("'") && expr.ends_with("'") {
    return false
  }
  // Scheme-source: e.g. "https:", "data:", "blob:"
  if expr.ends_with(":") && sec_index_of(expr, "/") < 0 {
    let sch = sec_ascii_lower(expr.slice(0, expr.length() - 1))
    return csp_scheme_matches(sch, target.scheme)
  }
  // Host-source: [scheme://]host[:port|*][/path]
  if !target.has_host {
    return false
  }
  let mut rest = expr
  let mut expr_scheme = ""
  let sep = sec_index_of(rest, "://")
  if sep >= 0 {
    expr_scheme = sec_ascii_lower(rest.slice(0, sep))
    rest = rest.slice(sep + 3, rest.length())
  }
  // Split path
  let slash = sec_index_of(rest, "/")
  let hostport = if slash >= 0 { rest.slice(0, slash) } else { rest }
  let expr_path = if slash >= 0 { rest.slice(slash, rest.length()) } else { "" }

  let mut expr_host = hostport
  let mut expr_port_any = false
  let mut expr_port = -1
  let colon = sec_index_of(hostport, ":")
  if colon >= 0 {
    expr_host = hostport.slice(0, colon)
    let pstr = hostport.slice(colon + 1, hostport.length())
    if pstr == "*" {
      expr_port_any = true
    } else {
      expr_port = parse_uint_str(pstr)
      if expr_port < 0 {
        return false
      }
    }
  }

  // Scheme check
  let effective_scheme = if expr_scheme != "" { expr_scheme } else { page.scheme }
  if effective_scheme != "" && !csp_scheme_matches(effective_scheme, target.scheme) {
    return false
  }

  // Host check
  if !csp_host_matches(expr_host, target.host) {
    return false
  }

  // Port check
  if !expr_port_any {
    if expr_port >= 0 {
      if target.port != expr_port {
        return false
      }
    } else {
      let def_p = default_port_for_scheme(target.scheme)
      if def_p >= 0 && target.port != def_p {
        return false
      }
    }
  }

  // Path check
  csp_path_matches(expr_path, target.path)
}

fn csp_list_has_nonce_or_hash(sources : Array[String]) -> Bool {
  for s in sources {
    if s.starts_with("'nonce-") ||
    s.starts_with("'sha256-") ||
    s.starts_with("'sha384-") ||
    s.starts_with("'sha512-") ||
    s == "'strict-dynamic'" {
      return true
    }
  }
  false
}

///| Evaluates a single `CspPolicy` for `directive` against `target_url` (or inline/eval).
pub fn check_source(
  policy : CspPolicy,
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  sha256_b64 : String,
  is_inline : Bool,
  is_eval : Bool,
) -> CspDecision {
  let eff = match csp_effective_sources(policy, directive) {
    Option::Some(pair) => pair
    Option::None => return CspDecision::Allow
  }
  let eff_name = eff.0
  let sources = eff.1
  if sources.length() == 0 {
    return CspDecision::Block("CSP blocked by empty " + eff_name)
  }
  for s in sources {
    if s == "'none'" {
      return CspDecision::Block("CSP blocked by " + eff_name + " 'none'")
    }
  }

  if is_eval {
    for s in sources {
      if s == "'unsafe-eval'" {
        return CspDecision::Allow
      }
    }
    return CspDecision::Block("CSP blocked eval under " + eff_name)
  }

  let nonce_tok = if nonce != "" { "'nonce-" + nonce + "'" } else { "" }
  let hash_tok = if sha256_b64 != "" { "'sha256-" + sha256_b64 + "'" } else { "" }

  if is_inline {
    if nonce_tok != "" {
      for s in sources {
        if s == nonce_tok {
          return CspDecision::Allow
        }
      }
    }
    if hash_tok != "" {
      for s in sources {
        if s == hash_tok {
          return CspDecision::Allow
        }
      }
    }
    // W3C CSP3: 'unsafe-inline' is IGNORED when any nonce, hash, or 'strict-dynamic' is present!
    if !csp_list_has_nonce_or_hash(sources) {
      for s in sources {
        if s == "'unsafe-inline'" {
          return CspDecision::Allow
        }
      }
    }
    return CspDecision::Block("CSP blocked inline execution under " + eff_name)
  }

  // External resource check: nonce / hash can also authorize external scripts/styles.
  if nonce_tok != "" {
    for s in sources {
      if s == nonce_tok {
        return CspDecision::Allow
      }
    }
  }
  if hash_tok != "" {
    for s in sources {
      if s == hash_tok {
        return CspDecision::Allow
      }
    }
  }

  let page = parse_url_parts(page_origin)
  let target = parse_url_parts(target_url)
  for s in sources {
    if csp_expr_matches_url(s, page, target) {
      return CspDecision::Allow
    }
  }
  CspDecision::Block("CSP blocked " + target_url + " under " + eff_name)
}

///| Evaluates multiple `Content-Security-Policy` policies as an intersection:
///| allowed if and only if EVERY policy allows.
pub fn check_source_all(
  policies : Array[CspPolicy],
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  sha256_b64 : String,
  is_inline : Bool,
  is_eval : Bool,
) -> CspDecision {
  for p in policies {
    match check_source(p, directive, page_origin, target_url, nonce, sha256_b64, is_inline, is_eval) {
      CspDecision::Allow => ()
      CspDecision::Block(reason) => return CspDecision::Block(reason)
    }
  }
  CspDecision::Allow
}

// ============================================================================
// Fetch Standard CORS Policy Engine
// ============================================================================

fn cors_is_safelisted_method(method_name : String) -> Bool {
  method_name == "GET" || method_name == "HEAD" || method_name == "POST"
}

fn cors_mime_essence(ct : String) -> String {
  let semi = sec_index_of(ct, ";")
  let base = if semi >= 0 { ct.slice(0, semi) } else { ct }
  sec_ascii_lower(sec_trim(base))
}

fn cors_is_safelisted_header(name : String, value : String) -> Bool {
  let k = sec_ascii_lower(sec_trim(name))
  let v = sec_trim(value)
  if v.length() > 128 {
    return false
  }
  if k == "accept" || k == "accept-language" || k == "content-language" {
    return true
  }
  if k == "content-type" {
    let essence = cors_mime_essence(v)
    return essence == "application/x-www-form-urlencoded" ||
    essence == "multipart/form-data" ||
    essence == "text/plain"
  }
  false
}

///| Fetch Standard §4.5: returns `true` if the request is a CORS-safelisted ("simple") request
///| that does NOT require an `OPTIONS` preflight.
pub fn is_cors_safelisted_request(
  method_name : String,
  headers : Array[(String, String)],
) -> Bool {
  if !cors_is_safelisted_method(method_name) {
    return false
  }
  for h in headers {
    if !cors_is_safelisted_header(h.0, h.1) {
      return false
    }
  }
  true
}

fn cors_find_header(headers : Array[(String, String)], target_lower : String) -> Option[String] {
  let mut found : Option[String] = Option::None
  for h in headers {
    if sec_ascii_lower(sec_trim(h.0)) == target_lower {
      let hv = sec_trim(h.1)
      match found {
        Option::None => found = Option::Some(hv)
        Option::Some(prev) => found = Option::Some(prev + ", " + hv)
      }
    }
  }
  found
}

fn cors_split_csv(csv : String, lowercase : Bool) -> Array[String] {
  let out : Array[String] = []
  for part in csv.split(",") {
    let t = sec_trim(part)
    if t != "" {
      out.push(if lowercase { sec_ascii_lower(t) } else { t })
    }
  }
  out
}

fn cors_check_origin_and_creds(
  req_origin : String,
  credentials_include : Bool,
  resp_headers : Array[(String, String)],
) -> Result[Unit, String] {
  let acao = match cors_find_header(resp_headers, "access-control-allow-origin") {
    Option::Some(v) if v != "" => v
    _ => return Result::Err("missing Access-Control-Allow-Origin")
  }
  if credentials_include {
    if acao == "*" {
      return Result::Err("Access-Control-Allow-Origin '*' is forbidden when credentials: include")
    }
    if acao != req_origin {
      return Result::Err("Access-Control-Allow-Origin mismatch: got " + acao + ", expected " + req_origin)
    }
    match cors_find_header(resp_headers, "access-control-allow-credentials") {
      Option::Some(v) if v == "true" => ()
      _ => return Result::Err("missing or non-'true' Access-Control-Allow-Credentials")
    }
  } else {
    if acao != "*" && acao != req_origin {
      return Result::Err("Access-Control-Allow-Origin mismatch: got " + acao + ", expected " + req_origin)
    }
  }
  Result::Ok(())
}

///| Fetch Standard §4.9: validates CORS response headers and returns the list of exposed headers
///| from `Access-Control-Expose-Headers` (lowercased, or `["*"]` when wildcard without credentials).
pub fn check_cors_response(
  req_origin : String,
  credentials_include : Bool,
  resp_headers : Array[(String, String)],
) -> Result[Array[String], String] {
  match cors_check_origin_and_creds(req_origin, credentials_include, resp_headers) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }
  let exposed : Array[String] = []
  match cors_find_header(resp_headers, "access-control-expose-headers") {
    Option::Some(raw) => {
      let items = cors_split_csv(raw, true)
      for item in items {
        if item == "*" && !credentials_include {
          return Result::Ok(["*"])
        }
        if item != "*" {
          exposed.push(item)
        }
      }
    }
    Option::None => ()
  }
  Result::Ok(exposed)
}

///| Fetch Standard §4.6: validates a CORS `OPTIONS` preflight response against `req_method`
///| and `req_headers`. Returns `Ok(max_age_seconds)` on success or `Err(reason)` on rejection.
pub fn check_cors_preflight(
  req_origin : String,
  req_method : String,
  req_headers : Array[String],
  credentials_include : Bool,
  resp_headers : Array[(String, String)],
) -> Result[Int, String] {
  match cors_check_origin_and_creds(req_origin, credentials_include, resp_headers) {
    Result::Err(e) => return Result::Err(e)
    Result::Ok(_) => ()
  }

  // 1. Validate Access-Control-Allow-Methods
  let mut method_ok = cors_is_safelisted_method(req_method)
  if !method_ok {
    match cors_find_header(resp_headers, "access-control-allow-methods") {
      Option::Some(raw) => {
        let methods = cors_split_csv(raw, false)
        for m in methods {
          if m == req_method || (m == "*" && !credentials_include) {
            method_ok = true
            break
          }
        }
      }
      Option::None => ()
    }
  }
  if !method_ok {
    return Result::Err("preflight method not allowed: " + req_method)
  }

  // 2. Validate Access-Control-Allow-Headers
  if req_headers.length() > 0 {
    let allowed_hdrs = match cors_find_header(resp_headers, "access-control-allow-headers") {
      Option::Some(raw) => cors_split_csv(raw, true)
      Option::None => []
    }
    let mut has_wildcard = false
    if !credentials_include {
      for ah in allowed_hdrs {
        if ah == "*" {
          has_wildcard = true
          break
        }
      }
    }
    for rh in req_headers {
      let lower_rh = sec_ascii_lower(sec_trim(rh))
      if lower_rh == "" {
        continue
      }
      let mut ok = false
      for ah in allowed_hdrs {
        if ah == lower_rh {
          ok = true
          break
        }
      }
      // Fetch spec: '*' covers non-Authorization headers when credentials are not included.
      if !ok && has_wildcard && lower_rh != "authorization" {
        ok = true
      }
      if !ok {
        return Result::Err("preflight header not allowed: " + lower_rh)
      }
    }
  }

  // 3. Parse Access-Control-Max-Age (non-negative seconds, default 0 if absent/invalid)
  let mut max_age = 0
  match cors_find_header(resp_headers, "access-control-max-age") {
    Option::Some(raw) => {
      let parsed = parse_uint_str(sec_trim(raw))
      if parsed >= 0 {
        max_age = parsed
      }
    }
    Option::None => ()
  }
  Result::Ok(max_age)
}
