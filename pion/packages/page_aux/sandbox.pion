///| Farview Wave W1: OS-level render process sandbox bindings (`native/page/sandbox.c`).
///| - macOS: Seatbelt SBPL (`(version 1) (deny default)`) via `dlopen("/usr/lib/libSystem.B.dylib")`.
///| - Linux: `prctl(PR_SET_NO_NEW_PRIVS, 1)` + `setrlimit` hardening.

extern "C" fn c_sandbox_supported() -> Int = "fv_sandbox_supported"

extern "C" fn c_sandbox_apply_str(
  profile_dir : Ptr,
  profile_len : Int,
  state_dir : Ptr,
  state_len : Int,
  download_dir : Ptr,
  download_len : Int,
  tmp_dir : Ptr,
  tmp_len : Int,
  allow_network : Int,
) -> Int = "fv_sandbox_apply_str"

extern "C" fn c_sandbox_self_test(
  allowed_dir : Ptr,
  allowed_len : Int,
  denied_path : Ptr,
  denied_len : Int,
) -> Int = "fv_sandbox_self_test"

fn sb_non_empty(b : Bytes) -> Bytes {
  if b.length() == 0 {
    Bytes::new(1)
  } else {
    b
  }
}

///| Returns `true` when OS-level sandboxing is supported on the current host platform.
pub fn sandbox_supported() -> Bool {
  c_sandbox_supported() != 0
}

///| Applies the OS-level render process sandbox to the current process.
///| Only the explicitly authorized directories are writable; sensitive user directories
///| (`~/.ssh`, `~/.aws`, `~/Documents`, `~/Desktop`, `~/.gnupg`) and `process-exec` are denied.
pub fn sandbox_apply(
  profile_dir : String,
  state_dir : String,
  download_dir : String,
  tmp_dir : String,
  allow_network : Bool,
) -> Result[Unit, String] {
  let pb = profile_dir.to_bytes()
  let sb = state_dir.to_bytes()
  let db = download_dir.to_bytes()
  let tb = tmp_dir.to_bytes()
  let pb_s = sb_non_empty(pb)
  let sb_s = sb_non_empty(sb)
  let db_s = sb_non_empty(db)
  let tb_s = sb_non_empty(tb)
  let rc = c_sandbox_apply_str(
    bytes_data_ptr(pb_s),
    pb.length(),
    bytes_data_ptr(sb_s),
    sb.length(),
    bytes_data_ptr(db_s),
    db.length(),
    bytes_data_ptr(tb_s),
    tb.length(),
    if allow_network { 1 } else { 0 },
  )
  if rc == 0 {
    Result::Ok(())
  } else {
    Result::Err("sandbox_apply failed (rc=" + rc.to_string() + ")")
  }
}

///| Forks an isolated child process, enables the OS sandbox with read/write allowed only in
///| `allowed_dir`, verifies reading `denied_path` fails with kernel `EPERM`, and verifies
///| read/write inside `allowed_dir` succeeds. Returns `0` on full pass.
pub fn sandbox_self_test(allowed_dir : String, denied_path : String) -> Int {
  let ab = allowed_dir.to_bytes()
  let db = denied_path.to_bytes()
  let ab_s = sb_non_empty(ab)
  let db_s = sb_non_empty(db)
  c_sandbox_self_test(
    bytes_data_ptr(ab_s),
    ab.length(),
    bytes_data_ptr(db_s),
    db.length(),
  )
}
