///| `<canvas>` 2D context state machine, deferred draw queue (with full-clear culling),
///| and command dispatch backed by `raster::Surface`.
///| Port of `src/page/canvas.mbt`.

import "raster"
import "webauthn"

pub let max_canvas_pixels : Int = 16777216

pub enum CanvasCmd {
  ClearRect(Double, Double, Double, Double)
  FillRect(Double, Double, Double, Double, Int)
  StrokeRect(Double, Double, Double, Double, Int, Double)
  BeginPath
  MoveTo(Double, Double)
  LineTo(Double, Double)
  QuadTo(Double, Double, Double, Double)
  CubicTo(Double, Double, Double, Double, Double, Double)
  Arc(Double, Double, Double, Double, Double, Bool)
  ClosePath
  PathCsv(String)
  Fill(Int, Bool)
  Stroke(Int, Double)
  StrokeStyled(Int, Double, Int, Int, Double, Array[Double], Double)
  Clip(Bool)
  Save
  Restore
  Transform(Double, Double, Double, Double, Double, Double)
  LinearGradient(Double, Double, Double, Double, Double, Double, Double, Double, Array[Double], Array[Int])
  RadialGradient(Double, Double, Double, Double, Double, Double, Double, Double, Double, Double, Array[Double], Array[Int])
  FillText(String, Double, Double, Double, Int, String)
  DrawImage(Bytes, Int, Int, Double, Double, Double, Double)
  PutImageData(Bytes, Int, Int, Int, Int)
}

pub struct Canvas2D {
  pub surface : raster::Surface
  pub width : Int
  pub height : Int
  pub mut dirty : Bool
  pub mut version : Int
  pub mut queue : Array[CanvasCmd]
  pub mut drawn_count : Int
  pub mut culled_count : Int
  mut png_buf : Bytes
}

pub fn Canvas2D::new(w : Int, h : Int) -> Option[Canvas2D] {
  if w <= 0 || h <= 0 || w * h > max_canvas_pixels {
    return Option::None
  }
  Option::Some(
    Canvas2D::{
      surface: raster::Surface::new(w, h),
      width: w,
      height: h,
      dirty: true,
      version: 0,
      queue: Array::with_capacity(64),
      drawn_count: 0,
      culled_count: 0,
      png_buf: Bytes::new(0),
    },
  )
}

pub fn Canvas2D::free(self : Canvas2D) -> Unit {
  self.surface.free()
  self.png_buf = Bytes::new(0)
}

fn is_full_clear(c : Canvas2D, cmd : CanvasCmd) -> Bool {
  match cmd {
    CanvasCmd::ClearRect(x, y, w, h) => x <= 0.0 && y <= 0.0 && w >= (c.width as Double) && h >= (c.height as Double)
    _ => false
  }
}

///| Enqueues a drawing command; a full-canvas `ClearRect` drops unseen queued commands before it.
pub fn Canvas2D::enqueue(self : Canvas2D, cmd : CanvasCmd) -> Unit {
  if is_full_clear(self, cmd) && self.queue.length() > 0 {
    self.culled_count = self.culled_count + self.queue.length()
    self.queue.clear()
  }
  self.queue.push(cmd)
  self.dirty = true
  self.version = self.version + 1
}

///| Flushes all pending queued commands onto `self.surface`.
pub fn Canvas2D::flush(self : Canvas2D) -> Unit {
  let n = self.queue.length()
  if n == 0 {
    return
  }
  let s = self.surface
  let mut i = 0
  while i < n {
    match self.queue[i] {
      CanvasCmd::ClearRect(x, y, w, h) => s.clear_rect(x, y, w, h)
      CanvasCmd::FillRect(x, y, w, h, rgba) => s.fill_rect(x, y, w, h, rgba)
      CanvasCmd::StrokeRect(x, y, w, h, rgba, lw) => s.stroke_rect(x, y, w, h, rgba, lw)
      CanvasCmd::BeginPath => s.begin_path()
      CanvasCmd::MoveTo(x, y) => s.move_to(x, y)
      CanvasCmd::LineTo(x, y) => s.line_to(x, y)
      CanvasCmd::QuadTo(cpx, cpy, x, y) => s.quad_to(cpx, cpy, x, y)
      CanvasCmd::CubicTo(c1x, c1y, c2x, c2y, x, y) => s.cubic_to(c1x, c1y, c2x, c2y, x, y)
      CanvasCmd::Arc(cx, cy, r, sa, ea, ccw) => s.arc(cx, cy, r, sa, ea, ccw)
      CanvasCmd::ClosePath => s.close_path()
      CanvasCmd::PathCsv(csv) => s.path_csv(csv)
      CanvasCmd::Fill(rgba, eo) => s.fill(rgba, eo)
      CanvasCmd::Stroke(rgba, lw) => s.stroke(rgba, lw)
      CanvasCmd::StrokeStyled(rgba, lw, cap, join, ml, dash, doff) => s.stroke_styled(rgba, lw, cap, join, ml, dash, doff)
      CanvasCmd::Clip(eo) => s.clip(eo)
      CanvasCmd::Save => s.save()
      CanvasCmd::Restore => s.restore()
      CanvasCmd::Transform(a, b, c, d, tx, ty) => s.transform(a, b, c, d, tx, ty)
      CanvasCmd::LinearGradient(rx, ry, rw, rh, x0, y0, x1, y1, offs, cols) =>
      s.fill_linear_gradient(rx, ry, rw, rh, x0, y0, x1, y1, offs, cols)
      CanvasCmd::RadialGradient(rx, ry, rw, rh, c0x, c0y, r0, c1x, c1y, r1, offs, cols) =>
      s.fill_radial_gradient(rx, ry, rw, rh, c0x, c0y, r0, c1x, c1y, r1, offs, cols)
      CanvasCmd::FillText(fam, sz, x, y, rgba, txt) => s.fill_text(fam, sz, x, y, rgba, txt)
      CanvasCmd::DrawImage(rgba, sw, sh, dx, dy, dw, dh) => s.draw_image(rgba, sw, sh, dx, dy, dw, dh)
      CanvasCmd::PutImageData(rgba, sw, sh, dx, dy) => s.put_image_data(rgba, sw, sh, dx, dy)
    }
    self.drawn_count = self.drawn_count + 1
    i = i + 1
  }
  self.queue.clear()
}

pub fn Canvas2D::get_image_data(self : Canvas2D, sx : Int, sy : Int, sw : Int, sh : Int) -> Bytes {
  self.flush()
  self.surface.get_image_data(sx, sy, sw, sh)
}

pub fn Canvas2D::to_png(self : Canvas2D) -> Bytes {
  self.flush()
  self.dirty = false
  let need = raster::png_size(self.width, self.height)
  if need <= 0 {
    return Bytes::new(0)
  }
  if self.png_buf.length() != need {
    self.png_buf = Bytes::new(need)
  }
  let got = self.surface.write_png_into(self.png_buf)
  if got == need {
    self.png_buf
  } else {
    self.surface.to_png()
  }
}

pub fn Canvas2D::to_data_url_png(self : Canvas2D) -> String {
  let png = self.to_png()
  "data:image/png;base64," + webauthn::b64_encode(png)
}

pub struct CanvasStore {
  pub mut canvases : Map[Int, Canvas2D]
}

pub fn CanvasStore::new() -> CanvasStore {
  CanvasStore::{ canvases: Map::with_capacity(8) }
}

pub fn CanvasStore::get_or_create(self : CanvasStore, id : Int, w : Int, h : Int) -> Option[Canvas2D] {
  match self.canvases.get(id) {
    Option::Some(c) => if c.width == w && c.height == h {
      return Option::Some(c)
    } else {
      c.free()
      self.canvases.remove(id)
    }
    Option::None => ()
  }
  match Canvas2D::new(w, h) {
    Option::Some(c) => {
      self.canvases.set(id, c)
      Option::Some(c)
    }
    Option::None => Option::None
  }
}

pub fn CanvasStore::clear(self : CanvasStore) -> Unit {
  let ks = self.canvases.keys()
  let mut i = 0
  while i < ks.length() {
    match self.canvases.get(ks[i]) {
      Option::Some(c) => c.free()
      Option::None => ()
    }
    i = i + 1
  }
  self.canvases = Map::with_capacity(8)
}
