///| Native WebSocket session table management (op 120).
///| 1:1 port of `src/page/ws.mbt`.

import "fetch"

pub struct WsDispatch {
  pub ctx : Int
  pub event : fetch::WsEvent
}

pub struct WsTable {
  pub mut live : Map[String, Int]
}

pub fn WsTable::new() -> WsTable {
  WsTable::{ live: Map::new() }
}

pub fn WsTable::open(self : WsTable, ctx : Int, target_url : String, origin : String, protocols : String) -> Int {
  let id = fetch::ws_open(target_url, origin, protocols)
  if id > 0 {
    self.live.set(id.to_string(), ctx)
  }
  id
}

pub fn WsTable::send_text(self : WsTable, id : Int, text : String) -> Bool {
  let _ = self
  fetch::ws_send(id, false, text.to_bytes())
}

pub fn WsTable::send_binary(self : WsTable, id : Int, data : Bytes) -> Bool {
  let _ = self
  fetch::ws_send(id, true, data)
}

pub fn WsTable::close(self : WsTable, id : Int, code : Int, reason : String) -> Unit {
  let _ = self
  fetch::ws_close(id, code, reason)
}

pub fn WsTable::poll(self : WsTable) -> Array[WsDispatch] {
  let out : Array[WsDispatch] = []
  if self.live.length() == 0 && fetch::ws_active() == 0 {
    return out
  }
  let evs = fetch::ws_poll()
  let mut i = 0
  while i < evs.length() {
    let ev = evs[i]
    match ev {
      fetch::WsEvent::Open(id, _) => match self.live.get(id.to_string()) {
        Option::Some(ctx) => out.push(WsDispatch::{ ctx: ctx, event: ev })
        Option::None => ()
      }
      fetch::WsEvent::MsgText(id, _) => match self.live.get(id.to_string()) {
        Option::Some(ctx) => out.push(WsDispatch::{ ctx: ctx, event: ev })
        Option::None => ()
      }
      fetch::WsEvent::MsgBin(id, _) => match self.live.get(id.to_string()) {
        Option::Some(ctx) => out.push(WsDispatch::{ ctx: ctx, event: ev })
        Option::None => ()
      }
      fetch::WsEvent::Close(id, _, _, _) => {
        let k = id.to_string()
        match self.live.get(k) {
          Option::Some(ctx) => out.push(WsDispatch::{ ctx: ctx, event: ev })
          Option::None => ()
        }
        self.live.remove(k)
      }
      fetch::WsEvent::Error(id) => match self.live.get(id.to_string()) {
        Option::Some(ctx) => out.push(WsDispatch::{ ctx: ctx, event: ev })
        Option::None => ()
      }
    }
    i = i + 1
  }
  out
}

pub fn WsTable::has_live(self : WsTable) -> Bool {
  self.live.length() > 0 || fetch::ws_active() > 0
}

pub fn WsTable::clear(self : WsTable) -> Unit {
  self.live = Map::new()
  fetch::ws_clear()
}
