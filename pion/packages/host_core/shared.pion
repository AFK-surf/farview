///| Shared profile state (cookies & localStorage 3-way merge across tab processes).
///| 1:1 port of `src/cmd/host/shared.mbt`.

import "net"
import "fetch"

pub struct ProfileConfig {
  pub profile_dir : String
  pub state_dir : String
  pub cookies_file : String
  pub storage_file : String
  pub ipc_dir : String
}

pub fn ProfileConfig::from_dirs(profile_dir : String, state_dir : String, cookies_override : String) -> ProfileConfig {
  let cfile = if cookies_override != "" {
    cookies_override
  } else if profile_dir != "" {
    profile_dir + "/cookies.txt"
  } else {
    ""
  }
  let sfile = if profile_dir != "" { profile_dir + "/storage.json" } else { "" }
  let idir = if profile_dir != "" { profile_dir + "/ipc" } else { "" }
  ProfileConfig::{
    profile_dir: profile_dir,
    state_dir: state_dir,
    cookies_file: cfile,
    storage_file: sfile,
    ipc_dir: idir,
  }
}

pub fn cookie_key(line : String) -> Option[String] {
  let f = line.split("\t")
  if f.length() < 7 {
    return Option::None
  }
  Option::Some(f[0] + "\t" + f[2] + "\t" + f[5])
}

pub fn cookie_map(text : String) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  let lines = text.split("\n")
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    if line != "" && !(line.starts_with("#") && !line.starts_with("#HttpOnly_")) {
      match cookie_key(line) {
        Option::Some(k) => out.set(k, line)
        Option::None => ()
      }
    }
    i = i + 1
  }
  out
}

///| 3-way merge: `mine` now, `met` as last synced, `theirs` on disk now.
///| Local additions/edits/deletions win; untouched keys take theirs.
pub fn merge_maps(mine : Map[String, String], met : Map[String, String], theirs : Map[String, String]) -> Map[String, String] {
  let out = theirs.copy()
  let mks = mine.keys()
  let mut i = 0
  while i < mks.length() {
    let k = mks[i]
    match mine.get(k) {
      Option::Some(v) => {
        let same_as_met = match met.get(k) {
          Option::Some(mv) => mv == v
          Option::None => false
        }
        if !same_as_met {
          out.set(k, v)
        }
      }
      Option::None => ()
    }
    i = i + 1
  }
  let met_ks = met.keys()
  let mut j = 0
  while j < met_ks.length() {
    let k = met_ks[j]
    if !mine.contains(k) {
      out.remove(k)
    }
    j = j + 1
  }
  out
}

pub fn maps_equal(a : Map[String, String], b : Map[String, String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let ks = a.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match (a.get(k), b.get(k)) {
      (Option::Some(va), Option::Some(vb)) => if va != vb { return false }
      _ => return false
    }
    i = i + 1
  }
  true
}

pub struct SharedStateSync {
  pub cfg : ProfileConfig
  pub mut cookies_met : Map[String, String]
  pub mut storage_met : Map[String, String]
}

pub fn SharedStateSync::new(cfg : ProfileConfig) -> SharedStateSync {
  SharedStateSync::{ cfg: cfg, cookies_met: Map::new(), storage_met: Map::new() }
}

pub fn SharedStateSync::sync_cookies(self : SharedStateSync, w : World) -> Bool {
  if self.cfg.cookies_file == "" {
    return false
  }
  let path = self.cfg.cookies_file
  let mine = cookie_map(fetch::jar_lines())
  let theirs_txt = match fs_read(w, path) {
    Result::Ok(t) => t
    Result::Err(_) => ""
  }
  let theirs = cookie_map(theirs_txt)
  let all = merge_maps(mine, self.cookies_met, theirs)

  let aks = all.keys()
  let mut i = 0
  while i < aks.length() {
    let k = aks[i]
    match all.get(k) {
      Option::Some(line) => {
        let same = match mine.get(k) {
          Option::Some(ml) => ml == line
          Option::None => false
        }
        if !same {
          fetch::jar_add(line)
        }
      }
      Option::None => ()
    }
    i = i + 1
  }
  let mks = mine.keys()
  let mut j = 0
  while j < mks.length() {
    let k = mks[j]
    if !all.contains(k) {
      match mine.get(k) {
        Option::Some(line) => {
          let f = line.split("\t")
          if f.length() >= 7 {
            f[4] = "1"
            fetch::jar_add(f.join("\t"))
          }
        }
        Option::None => ()
      }
    }
    j = j + 1
  }
  if !maps_equal(all, theirs) {
    let lines : Array[String] = ["# Netscape HTTP Cookie File"]
    let ks = all.keys()
    let mut ki = 0
    while ki < ks.length() {
      match all.get(ks[ki]) {
        Option::Some(line) => lines.push(line)
        Option::None => ()
      }
      ki = ki + 1
    }
    net::write_file_atomic(path, lines.join("\n") + "\n")
  }
  self.cookies_met = all
  true
}
