///| XML 1.0 + Namespaces parser producing the same `Node` tree.
///| 1:1 port of `client/src/html/xml.mbt`.

let XHTML_NS : String = "http://www.w3.org/1999/xhtml"
let SVG_NS : String = "http://www.w3.org/2000/svg"
let MATHML_NS : String = "http://www.w3.org/1998/Math/MathML"

pub fn looks_xml(url : String, body : String) -> Bool {
  let qi = url.index_of("?")
  let path = if qi >= 0 { url.slice(0, qi) } else { url }
  path.ends_with(".xht") ||
  path.ends_with(".xhtml") ||
  path.ends_with(".xml") ||
  path.ends_with(".svg") ||
  body.starts_with("<?xml")
}

fn utf8_to_cps(s : String) -> Array[Int] {
  let n = s.length()
  if n == 0 {
    return []
  }
  let out : Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) == 0x80 {
        out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
        i = i + 2
      } else {
        out.push(0xFFFD)
        i = i + 1
      }
    } else if b0 >= 0xE0 && b0 <= 0xEF && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let lo = if b0 == 0xE0 { 0xA0 } else { 0x80 }
      let hi = if b0 == 0xED { 0x9F } else { 0xBF }
      if b1 >= lo && b1 <= hi && (b2 & 0xC0) == 0x80 {
        out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
        i = i + 3
      } else {
        out.push(0xFFFD)
        i = i + 1
      }
    } else if b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      let lo = if b0 == 0xF0 { 0x90 } else { 0x80 }
      let hi = if b0 == 0xF4 { 0x8F } else { 0xBF }
      if b1 >= lo && b1 <= hi && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
        out.push(((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F))
        i = i + 4
      } else {
        out.push(0xFFFD)
        i = i + 1
      }
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

struct XmlReader {
  s : Array[Int]
  mut i : Int
}

fn XmlReader::at(self : XmlReader, k : Int) -> Int {
  if self.i + k < self.s.length() {
    self.s[self.i + k]
  } else {
    0
  }
}

fn XmlReader::starts(self : XmlReader, t : String) -> Bool {
  let tc = utf8_to_cps(t)
  let mut k = 0
  while k < tc.length() {
    if self.at(k) != tc[k] {
      return false
    }
    k = k + 1
  }
  true
}

fn XmlReader::until(self : XmlReader, t : String) -> String {
  let b = StringBuilder()
  while self.i < self.s.length() && !self.starts(t) {
    b.write_char(self.s[self.i].unsafe_to_char())
    self.i = self.i + 1
  }
  self.i = self.i + utf8_to_cps(t).length()
  b.to_string()
}

fn xml_space(c : Int) -> Bool {
  c == 32 || c == 10 || c == 9 || c == 13
}

fn XmlReader::skip_space(self : XmlReader) -> Unit {
  while self.i < self.s.length() && xml_space(self.s[self.i]) {
    self.i = self.i + 1
  }
}

fn XmlReader::name(self : XmlReader) -> String {
  let b = StringBuilder()
  while self.i < self.s.length() {
    let c = self.s[self.i]
    if xml_space(c) || c == 62 || c == 47 || c == 61 || c == 63 {
      break
    }
    b.write_char(c.unsafe_to_char())
    self.i = self.i + 1
  }
  b.to_string()
}

fn num_of(t : String, base : Int) -> Option[Int] {
  if t == "" {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    let d = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 102 {
      c - 87
    } else if c >= 65 && c <= 70 {
      c - 55
    } else {
      return None
    }
    if d >= base || v > 0x10FFFF {
      return None
    }
    v = v * base + d
    i = i + 1
  }
  if v > 0x10FFFF || v == 0 {
    None
  } else {
    Some(v)
  }
}

fn xml_unescape(t : String) -> String {
  if !t.contains("&") {
    return t
  }
  let b = StringBuilder()
  let cs = utf8_to_cps(t)
  let mut i = 0
  while i < cs.length() {
    if cs[i] == 38 {
      let mut j = i + 1
      while j < cs.length() && cs[j] != 59 && j - i < 12 {
        j = j + 1
      }
      if j < cs.length() && cs[j] == 59 {
        let nb = StringBuilder()
        let mut k = i + 1
        while k < j {
          nb.write_char(cs[k].unsafe_to_char())
          k = k + 1
        }
        let name = nb.to_string()
        let rep : Option[String] = if name == "lt" {
          Some("<")
        } else if name == "gt" {
          Some(">")
        } else if name == "amp" {
          Some("&")
        } else if name == "quot" {
          Some("\"")
        } else if name == "apos" {
          Some("'")
        } else if name.starts_with("#x") || name.starts_with("#X") {
          match num_of(name.slice(2, name.length()), 16) {
            Some(v) => {
              let sb2 = StringBuilder()
              sb2.write_char(v.unsafe_to_char())
              Some(sb2.to_string())
            }
            None => None
          }
        } else if name.starts_with("#") {
          match num_of(name.slice(1, name.length()), 10) {
            Some(v) => {
              let sb2 = StringBuilder()
              sb2.write_char(v.unsafe_to_char())
              Some(sb2.to_string())
            }
            None => None
          }
        } else {
          None
        }
        match rep {
          Some(r) => {
            b.write_string(r)
            i = j + 1
            continue
          }
          None => ()
        }
      }
    }
    b.write_char(cs[i].unsafe_to_char())
    i = i + 1
  }
  b.to_string()
}

fn xml_lookup(
  stack : Array[(Node, Map[String, String])],
  prefix : String,
) -> Option[String] {
  let mut k = stack.length() - 1
  while k >= 0 {
    match stack[k].1.get(prefix) {
      Some(u) => return Some(u)
      None => ()
    }
    k = k - 1
  }
  None
}

pub fn parse_xml(text : String) -> Node {
  let doc = Node::new_full(Document, Html, "#xml", [], "", false)
  let r = XmlReader::{ s: utf8_to_cps(text), i: 0 }
  let root_decls : Map[String, String] = Map::new()
  root_decls.set("xml", XML_NS)
  let stack : Array[(Node, Map[String, String])] = [(doc, root_decls)]
  let text_buf = StringBuilder()
  while r.i < r.s.length() {
    if r.at(0) != 60 {
      text_buf.write_char(r.at(0).unsafe_to_char())
      r.i = r.i + 1
      continue
    }
    if text_buf.length() > 0 {
      let t = text_buf.to_string()
      text_buf.reset()
      let parent = stack[stack.length() - 1].0
      if parent.kind != Document {
        parent.append(Node::text(xml_unescape(t)))
      }
    }
    let parent = stack[stack.length() - 1].0
    if r.starts("<!--") {
      r.i = r.i + 4
      parent.append(Node::comment(r.until("-->")))
    } else if r.starts("<![CDATA[") {
      r.i = r.i + 9
      parent.append(
        Node::new_full(Text, Html, "#cdata", [], r.until("]]>"), false),
      )
    } else if r.starts("<?") {
      r.i = r.i + 2
      let target = r.name()
      r.skip_space()
      let data = r.until("?>")
      if ascii_lower(target) != "xml" {
        parent.append(Node::new_full(Comment, Html, target, [], data, false))
      }
    } else if r.starts("<!DOCTYPE") || r.starts("<!doctype") {
      r.i = r.i + 9
      r.skip_space()
      let name = r.name()
      let n = Node::doctype(name)
      let mut depth = 0
      let rest = StringBuilder()
      while r.i < r.s.length() {
        let c = r.at(0)
        if c == 91 {
          depth = depth + 1
        } else if c == 93 {
          depth = depth - 1
        } else if c == 62 && depth <= 0 {
          r.i = r.i + 1
          break
        }
        if depth == 0 {
          rest.write_char(c.unsafe_to_char())
        }
        r.i = r.i + 1
      }
      let rs = rest.to_string()
      let ids = rs.split("\"")
      if rs.contains("PUBLIC") && ids.length() >= 4 {
        n.public_id = Some(ids[1])
        n.system_id = Some(ids[3])
      } else if rs.contains("SYSTEM") && ids.length() >= 2 {
        n.public_id = Some("")
        n.system_id = Some(ids[1])
      }
      parent.append(n)
    } else if r.starts("</") {
      r.i = r.i + 2
      let _ = r.name()
      r.skip_space()
      if r.at(0) == 62 {
        r.i = r.i + 1
      }
      if stack.length() > 1 {
        let _ = stack.pop()
      }
    } else {
      r.i = r.i + 1
      let qname = r.name()
      let raw_attrs : Array[(String, String)] = []
      let mut empty = false
      while r.i < r.s.length() {
        r.skip_space()
        if r.at(0) == 47 && r.at(1) == 62 {
          r.i = r.i + 2
          empty = true
          break
        }
        if r.at(0) == 62 {
          r.i = r.i + 1
          break
        }
        let an = r.name()
        if an == "" {
          r.i = r.i + 1
          continue
        }
        r.skip_space()
        let mut av = ""
        if r.at(0) == 61 {
          r.i = r.i + 1
          r.skip_space()
          let q = r.at(0)
          if q == 34 || q == 39 {
            r.i = r.i + 1
            let qs = if q == 34 { "\"" } else { "'" }
            av = xml_unescape(r.until(qs))
          }
        }
        raw_attrs.push((an, av))
      }
      let decls : Map[String, String] = Map::new()
      let mut ai = 0
      while ai < raw_attrs.length() {
        let a = raw_attrs[ai]
        if a.0 == "xmlns" {
          decls.set("", a.1)
        } else if a.0.starts_with("xmlns:") {
          decls.set(a.0.slice(6, a.0.length()), a.1)
        }
        ai = ai + 1
      }
      stack.push((Node::new(Document), decls))
      let colon = qname.index_of(":")
      let prefix = if colon >= 0 { qname.slice(0, colon) } else { "" }
      let local_name = if colon >= 0 {
        qname.slice(colon + 1, qname.length())
      } else {
        qname
      }
      let uri = xml_lookup(stack, prefix).unwrap_or("")
      let ns = if uri == XHTML_NS {
        Html
      } else if uri == SVG_NS {
        Svg
      } else if uri == MATHML_NS {
        MathMl
      } else {
        Other
      }
      let attrs : Array[Attr] = []
      ai = 0
      while ai < raw_attrs.length() {
        let a = raw_attrs[ai]
        let ac = a.0.index_of(":")
        if ac >= 0 {
          let p = a.0.slice(0, ac)
          let l = a.0.slice(ac + 1, a.0.length())
          let u = if p == "xmlns" {
            XMLNS_NS
          } else {
            xml_lookup(stack, p).unwrap_or("")
          }
          attrs.push(Attr::new(p, l, a.1, u))
        } else {
          let u = if a.0 == "xmlns" { XMLNS_NS } else { "" }
          attrs.push(Attr::new("", a.0, a.1, u))
        }
        ai = ai + 1
      }
      let _ = stack.pop()
      let el = Node::element(ns, local_name, attrs)
      el.prefix = prefix
      if ns == Other {
        el.ns_uri = uri
      }
      if ns == Html && local_name == "template" {
        el.template_content = Some(
          Node::new_full(Fragment, Html, "", [], "", true),
        )
      }
      parent.append(el)
      if !empty {
        stack.push((el, decls))
      }
    }
  }
  if text_buf.length() > 0 {
    let t = text_buf.to_string()
    let parent = stack[stack.length() - 1].0
    if parent.kind != Document {
      parent.append(Node::text(xml_unescape(t)))
    }
  }
  doc
}
