test "basic html5 parse dump and serialize" {
  let doc = parse("<!DOCTYPE html><p>Hello &amp; <b>world</b>")
  debug_assert(!doc.is_quirks(), "standards mode")
  let d = dump(doc)
  debug_assert(d.contains("<!DOCTYPE html>"), "has doctype")
  debug_assert(d.contains("\"Hello & \""), "entity decoded")
  debug_assert(d.contains("<b>"), "has b")
  debug_assert(
    inner_html(doc) == "<!DOCTYPE html><html><head></head><body><p>Hello &amp; <b>world</b></p></body></html>",
    "inner_html"
  )
  // Clean up cycles via cut()
  cut(doc)
  debug_assert(doc.children.length() == 0, "cut cleared children")
}

test "adoption agency and foster parenting" {
  let doc = parse("<b>1<p>2</b>3</p>")
  let d = dump(doc)
  debug_assert(d.contains("<b>"), "adoption b")
  let doc2 = parse("<table>foo<tr><td>bar</td></tr></table>")
  let d2 = dump(doc2)
  debug_assert(d2.contains("\"foo\""), "foster text")
  cut(doc)
  cut(doc2)
}

test "svg mathml and template" {
  let doc = parse("<svg viewbox='0 0 10 10'><foreignobject><p>hi</p></foreignobject></svg><template><tr><td>x</td></tr></template>")
  let d = dump(doc)
  debug_assert(d.contains("<svg svg>"), "svg ns")
  debug_assert(d.contains("viewBox=\"0 0 10 10\""), "svg attr case")
  debug_assert(d.contains("<svg foreignObject>"), "svg tag case")
  debug_assert(d.contains("content"), "template content")
  cut(doc)
}

test "xml parser namespaces" {
  let doc = parse_xml("<?xml version=\"1.0\"?><svg xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"10\"/></svg>")
  debug_assert(doc.children.length() == 1, "one root")
  debug_assert(doc.children[0].ns == Svg && doc.children[0].tag == "svg", "svg root")
  cut(doc)
}

test "note_name and maybe_named track id and name attributes" {
  debug_assert(!maybe_named("__fv_never_seen_id__"), "unseen name returns false")
  let doc = parse("<div id=\"hero_banner\" class=\"ignored_cls\"><input name=\"user_email\"></div>")
  debug_assert(maybe_named("hero_banner"), "id attribute noted on parse")
  debug_assert(maybe_named("user_email"), "name attribute noted on parse")
  debug_assert(!maybe_named("ignored_cls"), "non-id/name attribute not noted")
  note_name("id", "dyn_added_id")
  note_name("data-x", "ignored_data")
  debug_assert(maybe_named("dyn_added_id"), "dynamic note_name tracked")
  debug_assert(!maybe_named("ignored_data"), "dynamic non-id/name ignored")
  cut(doc)
}

test "lazy empty children and attrs stay unpolluted across mutations" {
  let e1 = Node::element(Html, "div", empty_attrs())
  debug_assert(e1.children.length() == 0, "fresh element has 0 children")
  debug_assert(e1.attrs.length() == 0, "fresh element has 0 attrs")
  let child = Node::text("hello")
  e1.push_child(child)
  e1.push_attr(Attr::new("", "class", "card", ""))
  debug_assert(e1.children.length() == 1, "e1 has 1 child")
  debug_assert(e1.attrs.length() == 1, "e1 has 1 attr")
  let e2 = Node::element(Html, "span", empty_attrs())
  debug_assert(e2.children.length() == 0, "e2 children unpolluted")
  debug_assert(e2.attrs.length() == 0, "e2 attrs unpolluted")
  e1.clear_children()
  e1.clear_attrs()
  debug_assert(e1.children.length() == 0, "e1 children cleared")
  debug_assert(e1.attrs.length() == 0, "e1 attrs cleared")
  e1.push_child(Node::text("again"))
  e1.push_attr(Attr::new("", "id", "x", ""))
  let e3 = Node::new(Element)
  debug_assert(e3.children.length() == 0, "e3 children unpolluted after clear+push")
  debug_assert(e3.attrs.length() == 0, "e3 attrs unpolluted after clear+push")
  debug_assert(empty_children().length() == 0, "EMPTY_CHILDREN still empty")
  debug_assert(empty_attrs().length() == 0, "EMPTY_ATTRS still empty")
}

test "intern_html_tag and intern_html_attr hit and miss boundaries" {
  debug_assert(intern_html_tag("<div>", 1, 4) == "div", "tag div hit")
  debug_assert(intern_html_tag("<template>", 1, 9) == "template", "tag template hit")
  debug_assert(intern_html_tag("<textarea>", 1, 9) == "textarea", "tag textarea hit")
  debug_assert(intern_html_tag("<x-foo>", 1, 6) == "x-foo", "tag custom miss")
  debug_assert(intern_html_tag("DIV", 0, 3) == "DIV", "tag uppercase miss")
  debug_assert(intern_html_tag("", 0, 0) == "", "tag empty miss")
  debug_assert(intern_html_attr(" id=", 1, 3) == "id", "attr id hit")
  debug_assert(intern_html_attr(" class=", 1, 6) == "class", "attr class hit")
  debug_assert(intern_html_attr(" data-id=", 1, 8) == "data-id", "attr data-id hit")
  debug_assert(intern_html_attr(" aria-label=", 1, 11) == "aria-label", "attr aria-label hit")
  debug_assert(intern_html_attr(" placeholder=", 1, 12) == "placeholder", "attr placeholder hit")
  debug_assert(intern_html_attr(" autocomplete=", 1, 13) == "autocomplete", "attr autocomplete hit")
  debug_assert(intern_html_attr(" custom-tag=", 1, 11) == "custom-tag", "attr custom miss")
  debug_assert(intern_html_attr(" X=", 1, 2) == "X", "attr 1-char uppercase miss")
  debug_assert(intern_html_attr_val("=\"0\"", 2, 3) == "0", "val 0 hit")
  debug_assert(intern_html_attr_val("=\"checkbox\"", 2, 10) == "checkbox", "val checkbox hit")
  debug_assert(intern_html_attr_val("=\"_blank\"", 2, 8) == "_blank", "val _blank hit")
  debug_assert(intern_html_attr_val("=\"password\"", 2, 10) == "password", "val password hit")
  debug_assert(intern_html_attr_val("=\"custom-val\"", 2, 12) == "custom-val", "val long miss")
  debug_assert(intern_html_attr_val("=\"\"", 2, 2) == "", "val empty miss")
  debug_assert(intern_html_ws(" ", 0, 1) == " ", "ws space hit")
  debug_assert(intern_html_ws("\n\t\t\t", 0, 4) == "\n\t\t\t", "ws nl+3tabs hit")
  debug_assert(intern_html_ws("\n    ", 0, 5) == "\n    ", "ws nl+4spaces hit")
  debug_assert(intern_html_ws("\r\n", 0, 2) == "\r\n", "ws crlf hit")
  debug_assert(intern_html_ws("\n\t ", 0, 3) == "\n\t ", "ws mixed miss")
  let p_fresh = Node::element(Html, "div", empty_attrs())
  let t_fresh = Node::text("hi")
  p_fresh.append_fresh(t_fresh)
  debug_assert(
    p_fresh.children.length() == 1 && t_fresh.pos == 0 && t_fresh.parent.is_some(),
    "append_fresh links child",
  )
  // cut_detached breaks parent/child links without bumping tree_changes
  let before = tree_changes_count()
  let root = Node::element(Html, "ul", empty_attrs())
  let li = Node::element(Html, "li", empty_attrs())
  let leaf = Node::text("item")
  li.append(leaf)
  root.append(li)
  let after_build = tree_changes_count()
  debug_assert(after_build >= before, "tree_changes bumped on build")
  cut_detached(root)
  debug_assert(tree_changes_count() == after_build, "cut_detached must not bump tree_changes")
  debug_assert(root.children.length() == 0 && li.parent.is_none() && leaf.parent.is_none(), "cut_detached breaks links")
}

test "wave37a_fast_html_tag_sets_exact_equivalence" {
  let mut i = 0
  while i < SPECIAL_HTML.length() {
    debug_assert(is_special_html_tag(SPECIAL_HTML[i]), "special missing: " + SPECIAL_HTML[i])
    i = i + 1
  }
  i = 0
  while i < SCOPE_HTML.length() {
    debug_assert(is_scope_html_tag(SCOPE_HTML[i]), "scope missing: " + SCOPE_HTML[i])
    i = i + 1
  }
  i = 0
  while i < IMPLIED_TAGS.length() {
    debug_assert(is_implied_html_tag(IMPLIED_TAGS[i]), "implied missing: " + IMPLIED_TAGS[i])
    i = i + 1
  }
  let probes : Array[String] = [
    "", "a", "b", "i", "s", "u", "span", "label", "strong", "em", "code", "canvas", "svg", "math",
    "video", "audio", "picture", "abbr", "cite", "data", "time", "mark", "ruby", "bdi", "bdo",
    "ins", "del", "slot", "custom-element", "div", "ul", "li", "input", "button", "table", "p",
    "td", "th", "html", "template", "option", "optgroup", "rtc", "blockquote", "figcaption",
  ]
  i = 0
  while i < probes.length() {
    let t = probes[i]
    debug_assert(is_special_html_tag(t) == str_in(t, SPECIAL_HTML), "special mismatch: " + t)
    debug_assert(is_scope_html_tag(t) == str_in(t, SCOPE_HTML), "scope mismatch: " + t)
    debug_assert(is_implied_html_tag(t) == str_in(t, IMPLIED_TAGS), "implied mismatch: " + t)
    i = i + 1
  }
}

///|
test "Wave 67A: ASCII tag fast path (start/end/self-closing/bool/quotes/fallbacks/SVG) & DomCounters" {
  let b0 = base_tag_adds_count()
  let s0 = svg_adds_count()
  let a0 = asset_adds_count()
  let doc = parse(
    "<!doctype html><html><head><base href=\"https://example.com/\"><link rel=\"stylesheet\" href='a.css'></head>" +
    "<body><section class=\"wrap\" data-flag><main><a href='https://x.test' rel=\"noopener\">hi</a>" +
    "<input type=\"checkbox\" checked/><DIV CLASS=\"UP\" a=\"1&amp;2\" a=\"dup\">ok</DIV>" +
    "<svg viewBox=\"0 0 10 10\"><rect width=\"10\" height=\"10\"/></svg></main></section></body></html>",
  )
  debug_assert(base_tag_adds_count() > b0, "base_tag_adds_count incremented")
  debug_assert(svg_adds_count() > s0, "svg_adds_count incremented")
  debug_assert(asset_adds_count() > a0, "asset_adds_count incremented")
  let html_el = doc.children[1]
  let body = html_el.children[1]
  let sec = body.children[0]
  debug_assert(sec.tag == "section" && sec.attr("class").unwrap_or("") == "wrap" && sec.attr("data-flag").unwrap_or("x") == "", "fast start tag with double quote and bool attr")
  let main_el = sec.children[0]
  let a_el = main_el.children[0]
  debug_assert(a_el.tag == "a" && a_el.attr("rel").unwrap_or("") == "noopener", "fast <a> tag and interned attr val")
  let inp = main_el.children[1]
  debug_assert(inp.tag == "input" && inp.attr("type").unwrap_or("") == "checkbox" && inp.attr("checked").unwrap_or("x") == "", "self-closing input with bool attr")
  let up = main_el.children[2]
  debug_assert(up.tag == "div" && up.attr("class").unwrap_or("") == "UP" && up.attr("a").unwrap_or("") == "1&2", "uppercase/entity/dup fallback matches WHATWG")
  let svg = main_el.children[3]
  debug_assert(svg.ns == Svg && svg.children.length() == 1 && svg.children[0].ns == Svg, "foreign_depth tracks nested SVG")
  cut(doc)
}

///|
test "Wave 72A: single-pass utf8_to_cps (ASCII, 2/3/4-byte UTF-8) & CRLF UTF-8 parse equivalence" {
  let cps = utf8_to_cps("a×你😀z")
  debug_assert(cps.length() == 5 && cps[0] == 97 && cps[1] == 0xD7 && cps[2] == 0x4F60 && cps[3] == 0x1F600 && cps[4] == 122, "utf8_to_cps single-pass decodes 1/2/3/4-byte UTF-8")
  let doc = parse("<p>hi×\r\nthere\rworld</p>")
  let p = doc.children[0].children[1].children[0]
  debug_assert(text_content(p) == "hi×\nthere\nworld", "CRLF and bare CR folded to LF in UTF-8 HTML input, got: " + text_content(p))
  cut(doc)
}

///|
test "Wave 73A: CR-free UTF-8 direct byte-stream scan (×/CJK/emoji/entities/uppercase/invalid fallback)" {
  debug_assert(is_valid_utf8_no_cr("<div>×你好😀&amp;</div>"), "valid CR-free UTF-8 uses direct scan")
  debug_assert(!is_valid_utf8_no_cr("<div>×\r\n</div>"), "CR falls back to preprocess_html")
  let bad = Bytes::new(3)
  bad[0] = (0x61).to_byte()
  bad[1] = (0xFF).to_byte()
  bad[2] = (0x62).to_byte()
  debug_assert(!is_valid_utf8_no_cr(bad.to_string()), "invalid UTF-8 byte falls back to preprocess_html")
  let doc = parse("<!doctype html><div data-lbl=\"×你好😀\" DATA-X=\"a&amp;b\"><BUTTON>×删除😀</BUTTON><span>&copy;中文</span></div>")
  let body = doc.children[1].children[1]
  let div = body.children[0]
  debug_assert(div.attr("data-lbl").unwrap_or("") == "×你好😀", "UTF-8 attr value preserved")
  debug_assert(div.attr("data-x").unwrap_or("") == "a&b", "uppercase attr + entity preserved")
  debug_assert(text_content(div.children[0]) == "×删除😀", "UTF-8 text inside uppercase tag preserved")
  debug_assert(text_content(div.children[1]) == "©中文", "entity + CJK text preserved")
  cut(doc)
}

///|
test "Wave 82A: intern_html_attr_val 1-char ASCII fast path" {
  debug_assert(intern_html_attr_val("a=#", 2, 3) == "#", "single-char '#' interned")
  debug_assert(intern_html_attr_val("x=9", 2, 3) == "9", "single-char '9' interned")
  debug_assert(intern_html_attr_val("x=/", 2, 3) == "/", "single-char '/' interned")
  let doc = parse("<!doctype html><a href=\"#\" data-i=\"5\" data-p=\"/\">ok</a>")
  let a = doc.children[1].children[1].children[0]
  debug_assert(a.attr("href").unwrap_or("") == "#" && a.attr("data-i").unwrap_or("") == "5" && a.attr("data-p").unwrap_or("") == "/", "parsed 1-char ASCII attr values preserved")
  cut(doc)
}

///|
test "Wave 91A: Node::index repairs all sibling pos hints in one O(N) pass" {
  let doc = parse("<!doctype html><div><span>a</span><span>b</span><span>c</span><span>d</span></div>")
  let div = doc.children[1].children[1].children[0]
  // Simulate stale pos hints after an unindexed mutation
  for c in div.children { c.pos = 99 }
  debug_assert(div.children[1].index() == 1, "index returns exact position")
  for i in 0..<div.children.length() {
    debug_assert(div.children[i].pos == i, "all sibling pos hints repaired in single pass")
  }
  cut(doc)
}

///|
test "Wave 99A: take_ascii_run two-loop ws/non-ws split and try_scan_ascii_tag attr-value boundary" {
  let ctx = Node::element(Html, "ul", EMPTY_ATTRS)
  let frag = parse_fragment(
    "  \n\t <li data-id=\"a'b\" data-q='x\"y' data-e=\"1&amp;2\">  hello &lt;world&gt;  </li> \n ",
    ctx,
    false,
  )
  debug_assert(frag.children.length() == 3, "leading ws, li, trailing ws: got " + frag.children.length().to_string())
  debug_assert(frag.children[0].kind == Text && frag.children[0].data == "  \n\t ", "leading pure-ws run preserved")
  let li = frag.children[1]
  debug_assert(li.tag == "li", "li tag parsed")
  debug_assert(li.attr("data-id").unwrap_or("") == "a'b", "single quote inside double-quoted attr preserved")
  debug_assert(li.attr("data-q").unwrap_or("") == "x\"y", "double quote inside single-quoted attr preserved")
  debug_assert(li.attr("data-e").unwrap_or("") == "1&2", "entity in attr falls back accurately")
  debug_assert(text_content(li) == "  hello <world>  ", "mixed ws + text + entity preserved")
  debug_assert(frag.children[2].kind == Text && frag.children[2].data == " \n ", "trailing pure-ws run preserved")
  cut(frag)
}

///|
test "Wave 2: try_parse_fragment_fast matches parse_fragment on well-formed fragments and bails on edge cases" {
  let ul = Node::element(Html, "ul", EMPTY_ATTRS)
  let sample = "\n<li data-id=\"42\" class=\"item active\" data-p=3>\n  <div class=\"view\">\n    <input class=\"toggle\" type=\"checkbox\" checked>\n    <label>Buy milk</label>\n    <button class=\"destroy\"></button>\n  </div>\n</li>\n"
  let fast = match try_parse_fragment_fast(sample, ul) {
    Some(ch) => ch
    None => panic("expected fast-path hit on well-formed fragment")
  }
  let full = parse_fragment(sample, ul, true)
  debug_assert(fast.length() == full.children.length(), "child count must match: " + fast.length().to_string() + " vs " + full.children.length().to_string())
  let li_fast = fast[1]
  let li_full = full.children[1]
  debug_assert(li_fast.tag == "li" && li_fast.attr("data-id").unwrap_or("") == "42" && li_fast.attr("class").unwrap_or("") == "item active" && li_fast.attr("data-p").unwrap_or("") == "3", "li attrs must match")
  debug_assert(text_content(li_fast) == text_content(li_full), "text content must match exactly")
  let div_fast = li_fast.children[1]
  debug_assert(div_fast.tag == "div" && div_fast.children.length() == 7, "div children count must match")
  let inp = div_fast.children[1]
  debug_assert(inp.tag == "input" && inp.attr("checked").is_some() && inp.attr("checked").unwrap_or("x") == "" && inp.attr("type").unwrap_or("") == "checkbox", "void input + boolean attr must match")
  // Edge cases must bail to None (handled by full parse_fragment)
  debug_assert(try_parse_fragment_fast("<span>a &amp; b</span>", ul).is_none(), "entity must bail")
  debug_assert(try_parse_fragment_fast("<!-- hi --><span>a</span>", ul).is_none(), "comment must bail")
  debug_assert(try_parse_fragment_fast("<p><div>x</div></p>", ul).is_none(), "block inside p must bail")
  debug_assert(try_parse_fragment_fast("<li><li>x</li></li>", ul).is_none(), "nested li must bail")
  debug_assert(try_parse_fragment_fast("<div/>", ul).is_none(), "self-closing non-void must bail")
  debug_assert(try_parse_fragment_fast("<div><span>unclosed</div>", ul).is_none(), "mismatched close tag must bail")
  debug_assert(try_parse_fragment_fast("<div a=\"1\" a=\"2\"></div>", ul).is_none(), "duplicate attr must bail")
  debug_assert(try_parse_fragment_fast("<script>alert(1)</script>", ul).is_none(), "script tag must bail")
  let ta = Node::element(Html, "textarea", EMPTY_ATTRS)
  debug_assert(try_parse_fragment_fast("<span>x</span>", ta).is_none(), "textarea context must bail")
  let tbl = Node::element(Html, "table", EMPTY_ATTRS)
  debug_assert(try_parse_fragment_fast("<div>x</div>", tbl).is_none(), "table context must bail")
  cut(full)
  for c in fast { cut(c) }
}

///|
test "Wave 5: Node::has_class_masked single/multi/ws/invalidation & try_parse_fragment_fast edge cases" {
  // Single class (no ws & with surrounding ASCII ws)
  let n1 = Node::element(Html, "div", [Attr::new("", "class", "active", "")])
  debug_assert(n1.has_class("active"), "single class hit")
  debug_assert(!n1.has_class("activ"), "prefix must not match")
  debug_assert(!n1.has_class("active2"), "longer token must not match")
  debug_assert(!n1.has_class(""), "empty token must not match")
  debug_assert(n1.class_bloom < 0L, "single class sets bit 63 fast flag")
  let n2 = Node::element(Html, "div", [Attr::new("", "class", " \t\n\r\u{000C}solo\t ", "")])
  debug_assert(n2.has_class("solo") && n2.class_bloom < 0L, "trimmed single class uses single fast flag")
  debug_assert(!n2.has_class(" solo "), "whitespace token must not match trimmed single class")
  // Multi class with all ASCII whitespace separators + dynamic invalidation
  let n3 = Node::element(Html, "div", [Attr::new("", "class", "a\tb\nc\rd\u{000C}e", "")])
  debug_assert(n3.has_class("a") && n3.has_class("b") && n3.has_class("c") && n3.has_class("d") && n3.has_class("e"), "all 5 ASCII ws separators split tokens")
  debug_assert(!n3.has_class("a\tb") && n3.class_bloom > 0L, "multi-class keeps bit 63 clear")
  n3.attrs[0].value = "only-one"
  n3.invalidate_class()
  debug_assert(n3.has_class("only-one") && !n3.has_class("a") && n3.class_bloom < 0L, "invalidate_class updates single/multi state immediately")
  // Empty / whitespace-only class
  let n4 = Node::element(Html, "div", [Attr::new("", "class", "  \t\n ", "")])
  debug_assert(!n4.has_class("a") && n4.class_bloom == 0L, "ws-only class has zero bloom")
  // Fragment fast-path: uppercase close tag, whitespace before '>', empty attr value, nesting bailouts
  let div = Node::element(Html, "div", EMPTY_ATTRS)
  let ok = match try_parse_fragment_fast("<span class=\"\" data-k=\"v\">hello</SPAN >", div) {
    Some(ch) => ch
    None => panic("expected uppercase/ws close tag and empty attr value to succeed")
  }
  debug_assert(ok.length() == 1 && ok[0].tag == "span" && ok[0].attr("class").unwrap_or("x") == "" && ok[0].attr("data-k").unwrap_or("") == "v", "attrs preserved")
  debug_assert(try_parse_fragment_fast("<h1><h2>x</h2></h1>", div).is_none(), "nested heading must bail")
  debug_assert(try_parse_fragment_fast("<button><button>x</button></button>", div).is_none(), "nested button must bail")
  debug_assert(try_parse_fragment_fast("<label><label>x</label></label>", div).is_none(), "nested label must bail")
  debug_assert(try_parse_fragment_fast("<span>a\rb</span>", div).is_none(), "CR in text must bail")
  for c in ok { cut(c) }
}

test "NodeRare lazy allocation, read/write defaults, clone, and RC cycle cleanup" {
  // Plain element and text nodes never allocate NodeRare on construction or default reads/writes.
  let el = Node::element(Html, "div", empty_attrs())
  let tx = Node::text("plain")
  debug_assert(el.rare.is_none() && tx.rare.is_none(), "fresh nodes have rare == None")
  debug_assert(el.get_public_id().is_none() && el.get_system_id().is_none(), "default doctype ids")
  debug_assert(el.get_template_content().is_none() && !el.has_template_content(), "default template_content")
  debug_assert(el.content_node().uid == el.uid, "content_node returns self when rare is None")
  debug_assert(!el.is_of_template() && !el.is_quirks(), "default bools")
  debug_assert(el.get_shadow().is_none() && !el.has_shadow(), "default shadow")
  debug_assert(el.get_host().is_none() && !el.has_host(), "default host")
  debug_assert(el.get_checked().is_none(), "default checked")
  debug_assert(el.get_ns_uri() == "" && el.get_prefix() == "", "default ns_uri/prefix")
  // Writing default values must not allocate NodeRare.
  el.set_public_id(None)
  el.set_system_id(None)
  el.set_template_content(None)
  el.set_of_template(false)
  el.set_shadow(None)
  el.set_host(None)
  el.set_checked(None)
  el.set_ns_uri("")
  el.set_prefix("")
  el.set_quirks(false)
  debug_assert(el.rare.is_none(), "writing default values keeps rare == None")

  // Cloning a plain node keeps rare == None.
  let cl_plain = clone(el, true)
  debug_assert(cl_plain.rare.is_none(), "clone of plain node keeps rare == None")

  // Writing a non-default cold field lazily allocates NodeRare and round-trips all fields.
  let dt = Node::doctype("html")
  dt.set_public_id(Some("-//W3C//DTD HTML 4.01//EN"))
  dt.set_system_id(Some("http://www.w3.org/TR/html4/strict.dtd"))
  dt.set_quirks(true)
  dt.set_ns_uri("urn:example")
  dt.set_prefix("ex")
  dt.set_checked(Some(true))
  debug_assert(dt.rare.is_some(), "non-default write allocates NodeRare")
  debug_assert(dt.get_public_id().unwrap_or("") == "-//W3C//DTD HTML 4.01//EN", "public_id round-trip")
  debug_assert(dt.get_system_id().unwrap_or("") == "http://www.w3.org/TR/html4/strict.dtd", "system_id round-trip")
  debug_assert(dt.is_quirks(), "quirks round-trip")
  debug_assert(dt.get_ns_uri() == "urn:example" && dt.get_prefix() == "ex", "ns_uri/prefix round-trip")
  debug_assert(checked(dt), "checked round-trip")
  let dt_cl = clone(dt, false)
  debug_assert(dt_cl.get_public_id().unwrap_or("") == "-//W3C//DTD HTML 4.01//EN" && dt_cl.is_quirks(), "clone copies rare fields")

  // RC cycle breaking via cut() and drop_dom_tree() for shadow/host and template_content.
  let host = Node::element(Html, "div", empty_attrs())
  let sr = Node::new(Fragment)
  let sr_child = Node::element(Html, "span", empty_attrs())
  sr_child.js_id = 42
  sr.append(sr_child)
  host.set_shadow(Some(sr))
  sr.set_host(Some(host))
  debug_assert(held_in(host), "held_in descends into shadow")
  sr_child.js_id = 0
  debug_assert(!held_in(host), "held_in false after js_id cleared")
  cut(host)
  debug_assert(host.get_shadow().is_none() && sr.get_host().is_none() && sr.children.length() == 0, "cut breaks shadow/host cycle")

  let tpl = Node::element(Html, "template", empty_attrs())
  let tc = Node::new_full(Fragment, Html, "", empty_attrs(), "", true)
  debug_assert(tc.is_of_template(), "new_full with of_template=true sets flag")
  let tc_child = Node::element(Html, "p", empty_attrs())
  tc_child.js_id = 99
  tc.append(tc_child)
  tpl.set_template_content(Some(tc))
  debug_assert(tpl.content_node().uid == tc.uid, "content_node returns template_content")
  debug_assert(held_in(tpl), "held_in descends into template_content")
  drop_dom_tree(tpl)
  debug_assert(tpl.get_template_content().is_none() && tc.children.length() == 0, "drop_dom_tree clears template_content")
}
