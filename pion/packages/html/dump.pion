///| html5lib tree dump format.
///| 1:1 port of `client/src/html/dump.mbt`.

fn repeat_spaces(depth : Int) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < depth {
    sb.write_string("  ")
    i = i + 1
  }
  sb.to_string()
}

fn cmp_str_bytes(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let n = if na < nb { na } else { nb }
  let mut i = 0
  while i < n {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return ca - cb
    }
    i = i + 1
  }
  na - nb
}

fn sort_dump_attrs(names : Array[(String, String)]) -> Unit {
  let n = names.length()
  let mut i = 1
  while i < n {
    let cur = names[i]
    let mut j = i - 1
    while j >= 0 && cmp_str_bytes(names[j].0, cur.0) > 0 {
      names[j + 1] = names[j]
      j = j - 1
    }
    names[j + 1] = cur
    i = i + 1
  }
}

fn dump_node(b : StringBuilder, n : Node, depth : Int) -> Unit {
  let pad = repeat_spaces(depth)
  b.write_string("| " + pad)
  match n.kind {
    Doctype => {
      b.write_string("<!DOCTYPE " + n.tag)
      if n.public_id.is_some() || n.system_id.is_some() {
        b.write_string(
          " \"" +
          n.public_id.unwrap_or("") +
          "\" \"" +
          n.system_id.unwrap_or("") +
          "\"",
        )
      }
      b.write_string(">\n")
    }
    Comment => b.write_string("<!-- " + n.data + " -->\n")
    Text => b.write_string("\"" + n.data + "\"\n")
    _ => {
      let ns_s = match n.ns {
        Html => ""
        Svg => "svg "
        MathMl => "math "
        Other => ""
      }
      b.write_string("<" + ns_s + n.tag + ">\n")
      let names : Array[(String, String)] = []
      let mut i = 0
      while i < n.attrs.length() {
        let a = n.attrs[i]
        let key = if a.ns == XLINK_NS {
          "xlink " + a.name
        } else if a.ns == XML_NS {
          "xml " + a.name
        } else if a.ns == XMLNS_NS {
          "xmlns " + a.name
        } else if a.prefix == "" {
          a.name
        } else {
          a.prefix + " " + a.name
        }
        names.push((key, a.value))
        i = i + 1
      }
      sort_dump_attrs(names)
      i = 0
      while i < names.length() {
        b.write_string(
          "| " + pad + "  " + names[i].0 + "=\"" + names[i].1 + "\"\n",
        )
        i = i + 1
      }
    }
  }
  match n.template_content {
    Some(c) => {
      b.write_string("| " + pad + "  content\n")
      let mut i = 0
      while i < c.children.length() {
        dump_node(b, c.children[i], depth + 2)
        i = i + 1
      }
    }
    None => ()
  }
  let mut i = 0
  while i < n.children.length() {
    dump_node(b, n.children[i], depth + 1)
    i = i + 1
  }
}

pub fn dump(root : Node) -> String {
  let b = StringBuilder()
  let mut i = 0
  while i < root.children.length() {
    dump_node(b, root.children[i], 0)
    i = i + 1
  }
  b.to_string()
}
