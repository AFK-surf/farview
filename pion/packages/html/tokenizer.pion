///| WHATWG HTML5 Tokenizer (§13.2.5).
///| 1:1 port of `client/src/html/tokenizer.mbt`.

fn slice_eq_lit(src : String, start : Int, len : Int, lit : String) -> Bool {
  let mut i = 1
  while i < len {
    if src.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn intern_html_tag(src : String, start : Int, end : Int) -> String {
  let len = end - start
  if len <= 0 || len > 8 {
    return src.slice(start, end)
  }
  let c0 = src.code_unit_at(start)
  match len {
    1 =>
    match c0 {
      0x61 => return "a"
      0x70 => return "p"
      0x69 => return "i"
      0x62 => return "b"
      _ => ()
    }
    2 => {
      let c1 = src.code_unit_at(start + 1)
      match c0 {
        0x6C => if c1 == 0x69 { return "li" }
        0x75 => if c1 == 0x6C { return "ul" }
        0x6F => if c1 == 0x6C { return "ol" }
        0x74 =>
        match c1 {
          0x72 => return "tr"
          0x64 => return "td"
          0x68 => return "th"
          _ => ()
        }
        0x62 => if c1 == 0x72 { return "br" }
        0x68 =>
        match c1 {
          0x72 => return "hr"
          0x31 => return "h1"
          0x32 => return "h2"
          0x33 => return "h3"
          0x34 => return "h4"
          _ => ()
        }
        0x65 => if c1 == 0x6D { return "em" }
        0x64 =>
        match c1 {
          0x6C => return "dl"
          0x74 => return "dt"
          0x64 => return "dd"
          _ => ()
        }
        _ => ()
      }
    }
    3 =>
    match c0 {
      0x64 => if slice_eq_lit(src, start, 3, "div") { return "div" }
      0x69 => if slice_eq_lit(src, start, 3, "img") { return "img" }
      0x6E => if slice_eq_lit(src, start, 3, "nav") { return "nav" }
      0x70 => if slice_eq_lit(src, start, 3, "pre") { return "pre" }
      0x73 =>
      if slice_eq_lit(src, start, 3, "svg") { return "svg" }
      else if slice_eq_lit(src, start, 3, "sub") { return "sub" }
      else if slice_eq_lit(src, start, 3, "sup") { return "sup" }
      0x63 => if slice_eq_lit(src, start, 3, "col") { return "col" }
      _ => ()
    }
    4 =>
    match c0 {
      0x73 => if slice_eq_lit(src, start, 4, "span") { return "span" }
      0x66 => if slice_eq_lit(src, start, 4, "form") { return "form" }
      0x62 => if slice_eq_lit(src, start, 4, "body") { return "body" }
      0x68 =>
      if slice_eq_lit(src, start, 4, "head") { return "head" }
      else if slice_eq_lit(src, start, 4, "html") { return "html" }
      0x6D =>
      if slice_eq_lit(src, start, 4, "meta") { return "meta" }
      else if slice_eq_lit(src, start, 4, "main") { return "main" }
      0x6C => if slice_eq_lit(src, start, 4, "link") { return "link" }
      0x63 => if slice_eq_lit(src, start, 4, "code") { return "code" }
      0x70 => if slice_eq_lit(src, start, 4, "path") { return "path" }
      0x72 => if slice_eq_lit(src, start, 4, "rect") { return "rect" }
      _ => ()
    }
    5 =>
    match c0 {
      0x69 => if slice_eq_lit(src, start, 5, "input") { return "input" }
      0x6C => if slice_eq_lit(src, start, 5, "label") { return "label" }
      0x74 =>
      if slice_eq_lit(src, start, 5, "table") { return "table" }
      else if slice_eq_lit(src, start, 5, "tbody") { return "tbody" }
      else if slice_eq_lit(src, start, 5, "thead") { return "thead" }
      else if slice_eq_lit(src, start, 5, "tfoot") { return "tfoot" }
      else if slice_eq_lit(src, start, 5, "title") { return "title" }
      0x73 =>
      if slice_eq_lit(src, start, 5, "style") { return "style" }
      else if slice_eq_lit(src, start, 5, "small") { return "small" }
      _ => ()
    }
    6 =>
    match c0 {
      0x62 => if slice_eq_lit(src, start, 6, "button") { return "button" }
      0x6F => if slice_eq_lit(src, start, 6, "option") { return "option" }
      0x73 =>
      if slice_eq_lit(src, start, 6, "select") { return "select" }
      else if slice_eq_lit(src, start, 6, "script") { return "script" }
      else if slice_eq_lit(src, start, 6, "strong") { return "strong" }
      0x68 => if slice_eq_lit(src, start, 6, "header") { return "header" }
      0x66 => if slice_eq_lit(src, start, 6, "footer") { return "footer" }
      0x69 => if slice_eq_lit(src, start, 6, "iframe") { return "iframe" }
      0x63 => if slice_eq_lit(src, start, 6, "canvas") { return "canvas" }
      _ => ()
    }
    7 =>
    match c0 {
      0x73 => if slice_eq_lit(src, start, 7, "section") { return "section" }
      0x61 => if slice_eq_lit(src, start, 7, "article") { return "article" }
      _ => ()
    }
    8 =>
    if c0 == 0x74 {
      if slice_eq_lit(src, start, 8, "textarea") { return "textarea" }
      else if slice_eq_lit(src, start, 8, "template") { return "template" }
    }
    _ => ()
  }
  src.slice(start, end)
}

let html_ascii_1 : Array[String] = {
  let arr : Array[String] = Array::make(128, "")
  let mut i = 0
  while i < 128 {
    let b = Bytes::new(1)
    b[0] = i.to_byte()
    arr[i] = b.to_string()
    i += 1
  }
  arr
}

fn intern_html_attr_val(src : String, start : Int, end : Int) -> String {
  let len = end - start
  if len < 1 || len > 10 {
    return src.slice(start, end)
  }
  let c0 = src.code_unit_at(start)
  match len {
    1 => if c0 < 128 { return html_ascii_1[c0] }
    2 => if c0 == 0x6F && src.code_unit_at(start + 1) == 0x6E { return "on" }
    3 =>
    match c0 {
      0x6F => if slice_eq_lit(src, start, 3, "off") { return "off" }
      0x75 => if slice_eq_lit(src, start, 3, "url") { return "url" }
      _ => ()
    }
    4 =>
    match c0 {
      0x74 =>
      if slice_eq_lit(src, start, 4, "text") { return "text" }
      else if slice_eq_lit(src, start, 4, "true") { return "true" }
      0x6E => if slice_eq_lit(src, start, 4, "none") { return "none" }
      0x69 => if slice_eq_lit(src, start, 4, "icon") { return "icon" }
      0x6C => if slice_eq_lit(src, start, 4, "lazy") { return "lazy" }
      _ => ()
    }
    5 =>
    match c0 {
      0x66 => if slice_eq_lit(src, start, 5, "false") { return "false" }
      0x72 => if slice_eq_lit(src, start, 5, "radio") { return "radio" }
      0x62 => if slice_eq_lit(src, start, 5, "block") { return "block" }
      0x65 =>
      if slice_eq_lit(src, start, 5, "email") { return "email" }
      else if slice_eq_lit(src, start, 5, "eager") { return "eager" }
      0x75 => if slice_eq_lit(src, start, 5, "utf-8") { return "utf-8" }
      _ => ()
    }
    6 =>
    match c0 {
      0x62 => if slice_eq_lit(src, start, 6, "button") { return "button" }
      0x73 =>
      if slice_eq_lit(src, start, 6, "submit") { return "submit" }
      else if slice_eq_lit(src, start, 6, "search") { return "search" }
      0x68 => if slice_eq_lit(src, start, 6, "hidden") { return "hidden" }
      0x6E => if slice_eq_lit(src, start, 6, "number") { return "number" }
      0x5F => if slice_eq_lit(src, start, 6, "_blank") { return "_blank" }
      _ => ()
    }
    8 =>
    match c0 {
      0x63 => if slice_eq_lit(src, start, 8, "checkbox") { return "checkbox" }
      0x70 => if slice_eq_lit(src, start, 8, "password") { return "password" }
      0x6E => if slice_eq_lit(src, start, 8, "noopener") { return "noopener" }
      _ => ()
    }
    10 =>
    match c0 {
      0x73 => if slice_eq_lit(src, start, 10, "stylesheet") { return "stylesheet" }
      0x6E => if slice_eq_lit(src, start, 10, "noreferrer") { return "noreferrer" }
      _ => ()
    }
    _ => ()
  }
  src.slice(start, end)
}

pub fn intern_html_attr(src : String, start : Int, end : Int) -> String {
  let len = end - start
  if len < 2 || len > 12 {
    return if start == 0 && end == src.length() { src } else { src.slice(start, end) }
  }
  let c0 = src.code_unit_at(start)
  match len {
    2 => if c0 == 0x69 && src.code_unit_at(start + 1) == 0x64 { return "id" }
    3 =>
    match c0 {
      0x66 => if slice_eq_lit(src, start, 3, "for") { return "for" }
      0x73 => if slice_eq_lit(src, start, 3, "src") { return "src" }
      0x61 => if slice_eq_lit(src, start, 3, "alt") { return "alt" }
      0x72 => if slice_eq_lit(src, start, 3, "rel") { return "rel" }
      0x64 => if slice_eq_lit(src, start, 3, "dir") { return "dir" }
      0x6D =>
      if slice_eq_lit(src, start, 3, "min") { return "min" }
      else if slice_eq_lit(src, start, 3, "max") { return "max" }
      _ => ()
    }
    4 =>
    match c0 {
      0x68 => if slice_eq_lit(src, start, 4, "href") { return "href" }
      0x74 => if slice_eq_lit(src, start, 4, "type") { return "type" }
      0x6E => if slice_eq_lit(src, start, 4, "name") { return "name" }
      0x72 =>
      if slice_eq_lit(src, start, 4, "role") { return "role" }
      else if slice_eq_lit(src, start, 4, "rows") { return "rows" }
      0x6C => if slice_eq_lit(src, start, 4, "lang") { return "lang" }
      0x63 => if slice_eq_lit(src, start, 4, "cols") { return "cols" }
      0x73 => if slice_eq_lit(src, start, 4, "step") { return "step" }
      0x64 => if slice_eq_lit(src, start, 4, "data") { return "data" }
      _ => ()
    }
    5 =>
    match c0 {
      0x63 => if slice_eq_lit(src, start, 5, "class") { return "class" }
      0x73 => if slice_eq_lit(src, start, 5, "style") { return "style" }
      0x76 => if slice_eq_lit(src, start, 5, "value") { return "value" }
      0x74 => if slice_eq_lit(src, start, 5, "title") { return "title" }
      0x77 => if slice_eq_lit(src, start, 5, "width") { return "width" }
      _ => ()
    }
    6 =>
    match c0 {
      0x68 => if slice_eq_lit(src, start, 6, "height") { return "height" }
      0x74 => if slice_eq_lit(src, start, 6, "target") { return "target" }
      0x61 => if slice_eq_lit(src, start, 6, "action") { return "action" }
      0x6D => if slice_eq_lit(src, start, 6, "method") { return "method" }
      _ => ()
    }
    7 =>
    match c0 {
      0x63 =>
      if slice_eq_lit(src, start, 7, "checked") { return "checked" }
      else if slice_eq_lit(src, start, 7, "colspan") { return "colspan" }
      0x64 => if slice_eq_lit(src, start, 7, "data-id") { return "data-id" }
      0x72 => if slice_eq_lit(src, start, 7, "rowspan") { return "rowspan" }
      0x76 => if slice_eq_lit(src, start, 7, "viewbox") { return "viewbox" }
      _ => ()
    }
    8 =>
    match c0 {
      0x64 => if slice_eq_lit(src, start, 8, "disabled") { return "disabled" }
      0x72 => if slice_eq_lit(src, start, 8, "readonly") { return "readonly" }
      0x73 => if slice_eq_lit(src, start, 8, "selected") { return "selected" }
      0x74 => if slice_eq_lit(src, start, 8, "tabindex") { return "tabindex" }
      _ => ()
    }
    10 => if c0 == 0x61 && slice_eq_lit(src, start, 10, "aria-label") { return "aria-label" }
    11 => if c0 == 0x70 && slice_eq_lit(src, start, 11, "placeholder") { return "placeholder" }
    12 => if c0 == 0x61 && slice_eq_lit(src, start, 12, "autocomplete") { return "autocomplete" }
    _ => ()
  }
  src.slice(start, end)
}

enum State {
  Data
  Rcdata
  Rawtext
  ScriptData
  Plaintext
  TagOpen
  EndTagOpen
  TagName
  RawLessThan
  RawEndOpen
  RawEndName
  EscapeStart
  EscapeStartDash
  Escaped
  EscapedDash
  EscapedDashDash
  DoubleEscapeStart
  DoubleEscaped
  DoubleEscapedDash
  DoubleEscapedDashDash
  DoubleEscapedLessThan
  DoubleEscapeEnd
  BeforeAttrName
  AttrName
  AfterAttrName
  BeforeAttrValue
  AttrValueDouble
  AttrValueSingle
  AttrValueUnquoted
  AfterAttrValueQuoted
  SelfClosingStartTag
  BogusComment
  MarkupDeclarationOpen
  CommentStart
  CommentStartDash
  CommentBody
  CommentLessThan
  CommentLessThanBang
  CommentLessThanBangDash
  CommentLessThanBangDashDash
  CommentEndDash
  CommentEnd
  CommentEndBang
  DoctypeState
  BeforeDoctypeName
  DoctypeName
  AfterDoctypeName
  AfterDoctypePublicKeyword
  BeforeDoctypePublicId
  DoctypePublicIdDouble
  DoctypePublicIdSingle
  AfterDoctypePublicId
  BetweenDoctypeIds
  AfterDoctypeSystemKeyword
  BeforeDoctypeSystemId
  DoctypeSystemIdDouble
  DoctypeSystemIdSingle
  AfterDoctypeSystemId
  BogusDoctype
  CdataSection
  CdataSectionBracket
  CdataSectionEnd
  CharRef
  NumericCharRef
  HexStart
  DecStart
  HexRef
  DecRef
  NumericRefEnd
}

pub enum Token {
  DoctypeToken(Option[String], Option[String], Option[String], Bool)
  StartTag(String, Array[Attr], Bool)
  EndTag(String)
  CommentToken(String)
  Character(Int)
  Eof
}

let TOK_EOF : Int = -1

struct Tokenizer {
  ascii : Bool
  src : String
  input : Array[Int]
  len : Int
  mut pos : Int
  mut last_pos : Int
  mut state : State
  mut return_state : State
  mut raw_origin : State
  out : Array[Token]
  mut head : Int
  mut tag : Option[StringBuilder]
  mut tag_slice : Option[String]
  mut tag_has_buf : Bool
  mut is_end : Bool
  mut self_closing : Bool
  mut attrs : Array[Attr]
  mut attr_name : Option[StringBuilder]
  mut attr_name_slice : Option[String]
  mut aname_has_buf : Bool
  mut attr_value : Option[StringBuilder]
  mut attr_val_slice : Option[String]
  mut aval_has_buf : Bool
  mut in_attr : Bool
  mut temp : Option[StringBuilder]
  mut comment : Option[StringBuilder]
  mut dt_name : Option[StringBuilder]
  mut dt_public : Option[StringBuilder]
  mut dt_system : Option[StringBuilder]
  mut dt_quirks : Bool
  mut char_code : Int
  mut last_start : String
  mut allow_cdata : Bool
}

fn preprocess_html(s : String) -> Array[Int] {
  let n = s.length()
  let mut has_cr = false
  let mut all_ascii = true
  for i in 0..<n {
    let b = s.code_unit_at(i)
    if b == 13 {
      has_cr = true
    } else if b >= 0x80 {
      all_ascii = false
    }
  }
  if all_ascii && !has_cr {
    let out = Array::make(n, 0)
    for i in 0..<n {
      out[i] = s.code_unit_at(i)
    }
    return out
  }
  let raw = utf8_to_cps(s)
  if !has_cr {
    return raw
  }
  let rn = raw.length()
  let out : Array[Int] = Array::with_capacity(rn)
  let mut cr = false
  let mut i = 0
  while i < rn {
    let c = raw[i]
    if c == 13 {
      out.push(10)
      cr = true
      i = i + 1
      continue
    }
    if !(cr && c == 10) {
      out.push(c)
    }
    cr = false
    i = i + 1
  }
  out
}

fn is_valid_utf8_no_cr(s : String) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      if b0 == 13 {
        return false
      }
      i = i + 1
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      if i + 1 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      if (b1 & 0xC0) != 0x80 {
        return false
      }
      i = i + 2
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      if i + 2 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return false
      }
      if (b0 == 0xE0 && b1 < 0xA0) || (b0 == 0xED && b1 >= 0xA0) {
        return false
      }
      i = i + 3
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      if i + 3 >= n {
        return false
      }
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return false
      }
      if (b0 == 0xF0 && b1 < 0x90) || (b0 == 0xF4 && b1 >= 0x90) {
        return false
      }
      i = i + 4
    } else {
      return false
    }
  }
  true
}

fn utf8_decode_at(s : String, p : Int) -> (Int, Int) {
  let b0 = s.code_unit_at(p)
  if b0 < 0xE0 {
    let b1 = s.code_unit_at(p + 1)
    (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
  } else if b0 < 0xF0 {
    let b1 = s.code_unit_at(p + 1)
    let b2 = s.code_unit_at(p + 2)
    (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
  } else {
    let b1 = s.code_unit_at(p + 1)
    let b2 = s.code_unit_at(p + 2)
    let b3 = s.code_unit_at(p + 3)
    (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)
  }
}

let EMPTY_INTS : Array[Int] = []

fn Tokenizer::new(s : String) -> Tokenizer {
  let ascii = is_valid_utf8_no_cr(s)
  let input : Array[Int] = if ascii { EMPTY_INTS } else { preprocess_html(s) }
  let len = if ascii { s.length() } else { input.length() }
  Tokenizer::{
    ascii: ascii,
    src: s,
    input: input,
    len: len,
    pos: 0,
    last_pos: 0,
    state: Data,
    return_state: Data,
    raw_origin: Data,
    out: [],
    head: 0,
    tag: None,
    tag_slice: None,
    tag_has_buf: false,
    is_end: false,
    self_closing: false,
    attrs: EMPTY_ATTRS,
    attr_name: None,
    attr_name_slice: None,
    aname_has_buf: false,
    attr_value: None,
    attr_val_slice: None,
    aval_has_buf: false,
    in_attr: false,
    temp: None,
    comment: None,
    dt_name: None,
    dt_public: None,
    dt_system: None,
    dt_quirks: false,
    char_code: 0,
    last_start: "",
    allow_cdata: false,
  }
}

fn sb_opt_str(b : Option[StringBuilder]) -> String {
  match b {
    Some(x) => x.to_string()
    None => ""
  }
}

fn sb_opt_reset(b : Option[StringBuilder]) -> Unit {
  match b {
    Some(x) => x.reset()
    None => ()
  }
}

fn Tokenizer::tag_sb(self : Tokenizer) -> StringBuilder {
  match self.tag {
    Some(sb) => sb
    None => {
      let sb = StringBuilder()
      self.tag = Some(sb)
      sb
    }
  }
}

fn Tokenizer::aname_sb(self : Tokenizer) -> StringBuilder {
  match self.attr_name {
    Some(sb) => sb
    None => {
      let sb = StringBuilder()
      self.attr_name = Some(sb)
      sb
    }
  }
}

fn Tokenizer::aval_sb(self : Tokenizer) -> StringBuilder {
  match self.attr_value {
    Some(sb) => sb
    None => {
      let sb = StringBuilder()
      self.attr_value = Some(sb)
      sb
    }
  }
}

fn Tokenizer::temp_sb(self : Tokenizer) -> StringBuilder {
  match self.temp {
    Some(sb) => sb
    None => {
      let sb = StringBuilder()
      self.temp = Some(sb)
      sb
    }
  }
}

fn Tokenizer::comment_sb(self : Tokenizer) -> StringBuilder {
  match self.comment {
    Some(sb) => sb
    None => {
      let sb = StringBuilder()
      self.comment = Some(sb)
      sb
    }
  }
}

fn Tokenizer::char_at(self : Tokenizer, idx : Int) -> Int {
  if self.ascii {
    self.src.code_unit_at(idx)
  } else {
    self.input[idx]
  }
}

fn Tokenizer::next_char(self : Tokenizer) -> Int {
  let p = self.pos
  self.last_pos = p
  if p < self.len {
    if self.ascii {
      let b = self.src.code_unit_at(p)
      if b < 0x80 {
        self.pos = p + 1
        b
      } else {
        let (cp, step) = utf8_decode_at(self.src, p)
        self.pos = p + step
        cp
      }
    } else {
      self.pos = p + 1
      self.input[p]
    }
  } else {
    self.pos = p + 1
    TOK_EOF
  }
}

fn tok_alpha(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
}

fn tok_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn tok_hex(c : Int) -> Bool {
  tok_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
}

fn tok_space(c : Int) -> Bool {
  c == 9 || c == 10 || c == 12 || c == 32
}

fn tok_lower_char(c : Int) -> Char {
  if c >= 65 && c <= 90 {
    (c + 32).unsafe_to_char()
  } else {
    c.unsafe_to_char()
  }
}

fn tok_lower_cp(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let b = Bytes::new(n)
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      b[i] = (c + 32).to_byte()
    } else {
      b[i] = c.to_byte()
    }
    i = i + 1
  }
  b.to_string()
}

fn Tokenizer::emit(self : Tokenizer, t : Token) -> Unit {
  self.out.push(t)
}

fn Tokenizer::emit_char(self : Tokenizer, c : Int) -> Unit {
  self.out.push(Character(c))
}

fn Tokenizer::emit_str(self : Tokenizer, s : String) -> Unit {
  let cps = utf8_to_cps(s)
  let mut i = 0
  while i < cps.length() {
    self.out.push(Character(cps[i]))
    i = i + 1
  }
}

fn Tokenizer::take_text(self : Tokenizer, buf : StringBuilder) -> Bool {
  if self.state != Data || self.head < self.out.length() {
    return false
  }
  let n = self.len
  let start = self.pos
  let mut p = start
  let mut has_non_ws = false
  if self.ascii {
    while p < n {
      let c = self.src.code_unit_at(p)
      if c == 60 || c == 38 || c == 0 {
        break
      }
      if !is_ws_cp(c) {
        has_non_ws = true
      }
      p = p + 1
    }
    if p > start {
      buf.write_string(self.src.slice(start, p))
    }
  } else {
    while p < n {
      let c = self.input[p]
      if c == 60 || c == 38 || c == 0 {
        break
      }
      if !is_ws_cp(c) {
        has_non_ws = true
      }
      buf.write_char(c.unsafe_to_char())
      p = p + 1
    }
  }
  self.pos = p
  has_non_ws
}

let no_attrs : Array[Attr] = []

fn intern_html_ws(src : String, start : Int, end : Int) -> String {
  let len = end - start
  if len <= 0 || len > 16 {
    return src.slice(start, end)
  }
  let c0 = src.code_unit_at(start)
  if len == 1 {
    if c0 == 0x20 { return " " }
    if c0 == 0x0A { return "\n" }
    if c0 == 0x09 { return "\t" }
    return src.slice(start, end)
  }
  if len == 2 {
    let c1 = src.code_unit_at(start + 1)
    if c0 == 0x0A {
      if c1 == 0x20 { return "\n " }
      if c1 == 0x09 { return "\n\t" }
    } else if c0 == 0x0D && c1 == 0x0A {
      return "\r\n"
    } else if c0 == 0x20 && c1 == 0x20 {
      return "  "
    }
    return src.slice(start, end)
  }
  if c0 == 0x0A {
    let c1 = src.code_unit_at(start + 1)
    if c1 == 0x20 {
      let mut i = start + 2
      while i < end {
        if src.code_unit_at(i) != 0x20 {
          return src.slice(start, end)
        }
        i = i + 1
      }
      match len {
        3 => return "\n  "
        4 => return "\n   "
        5 => return "\n    "
        7 => return "\n      "
        9 => return "\n        "
        11 => return "\n          "
        13 => return "\n            "
        _ => ()
      }
    } else if c1 == 0x09 {
      let mut i = start + 2
      while i < end {
        if src.code_unit_at(i) != 0x09 {
          return src.slice(start, end)
        }
        i = i + 1
      }
      match len {
        3 => return "\n\t\t"
        4 => return "\n\t\t\t"
        5 => return "\n\t\t\t\t"
        6 => return "\n\t\t\t\t\t"
        7 => return "\n\t\t\t\t\t\t"
        _ => ()
      }
    }
  }
  src.slice(start, end)
}

fn Tokenizer::take_ascii_run(self : Tokenizer, first_c : Int) -> (String, Bool) {
  let start = self.last_pos
  let src = self.src
  let n = self.len
  let mut p = self.pos
  if first_c == 32 || first_c == 10 || first_c == 9 || first_c == 12 {
    while p < n {
      let c = src.code_unit_at(p)
      if c == 32 || c == 10 || c == 9 || c == 12 {
        p = p + 1
        continue
      }
      if c == 60 || c == 38 || c == 0 {
        self.pos = p
        return (intern_html_ws(src, start, p), false)
      }
      p = p + 1
      while p < n {
        let c2 = src.code_unit_at(p)
        if c2 > 60 {
          p = p + 1
          continue
        }
        if c2 == 60 || c2 == 38 || c2 == 0 {
          break
        }
        p = p + 1
      }
      self.pos = p
      return (src.slice(start, p), true)
    }
    self.pos = p
    return (intern_html_ws(src, start, p), false)
  }
  while p < n {
    let c = src.code_unit_at(p)
    if c > 60 {
      p = p + 1
      continue
    }
    if c == 60 || c == 38 || c == 0 {
      break
    }
    p = p + 1
  }
  self.pos = p
  (src.slice(start, p), true)
}

fn Tokenizer::start_tag(self : Tokenizer, is_end : Bool) -> Unit {
  if self.tag_has_buf {
    sb_opt_reset(self.tag)
    self.tag_has_buf = false
  }
  self.tag_slice = None
  self.is_end = is_end
  self.self_closing = false
  self.attrs = EMPTY_ATTRS
}

fn Tokenizer::finish_attr(self : Tokenizer) -> Unit {
  if self.in_attr {
    if !self.is_end {
      let name = match self.attr_name_slice {
        Some(s) => s
        None => sb_opt_str(self.attr_name)
      }
      let alen = self.attrs.length()
      if alen == 0 {
        let val_str = match self.attr_val_slice {
          Some(s) => s
          None => if self.aval_has_buf { sb_opt_str(self.attr_value) } else { "" }
        }
        self.attrs = [Attr::new("", name, val_str, "")]
      } else {
        let mut dup = false
        let mut i = 0
        while i < alen {
          if self.attrs[i].name == name {
            dup = true
            break
          }
          i = i + 1
        }
        if !dup {
          let val_str = match self.attr_val_slice {
            Some(s) => s
            None => if self.aval_has_buf { sb_opt_str(self.attr_value) } else { "" }
          }
          self.attrs.push(Attr::new("", name, val_str, ""))
        }
      }
    }
    self.in_attr = false
  }
}

fn Tokenizer::start_attr(self : Tokenizer) -> Unit {
  self.finish_attr()
  if self.aname_has_buf {
    sb_opt_reset(self.attr_name)
    self.aname_has_buf = false
  }
  self.attr_name_slice = None
  if self.aval_has_buf {
    sb_opt_reset(self.attr_value)
    self.aval_has_buf = false
  }
  self.attr_val_slice = None
  self.in_attr = true
}

fn Tokenizer::emit_tag(self : Tokenizer) -> Unit {
  self.finish_attr()
  let name = match self.tag_slice {
    Some(s) => s
    None => sb_opt_str(self.tag)
  }
  if self.is_end {
    self.emit(EndTag(name))
  } else {
    self.last_start = name
    self.emit(StartTag(name, self.attrs, self.self_closing))
  }
}

fn sb_opt_to_str(b : Option[StringBuilder]) -> Option[String] {
  match b {
    Some(x) => Some(x.to_string())
    None => None
  }
}

fn Tokenizer::emit_doctype(self : Tokenizer) -> Unit {
  self.emit(
    DoctypeToken(
      sb_opt_to_str(self.dt_name),
      sb_opt_to_str(self.dt_public),
      sb_opt_to_str(self.dt_system),
      self.dt_quirks,
    ),
  )
}

fn Tokenizer::start_doctype(self : Tokenizer) -> Unit {
  self.dt_name = None
  self.dt_public = None
  self.dt_system = None
  self.dt_quirks = false
}

fn Tokenizer::appropriate(self : Tokenizer) -> Bool {
  sb_opt_str(self.tag) == self.last_start
}

fn Tokenizer::emit_comment(self : Tokenizer) -> Unit {
  self.emit(CommentToken(sb_opt_str(self.comment)))
}

fn Tokenizer::take(self : Tokenizer, word : String, any_case : Bool) -> Bool {
  let p = self.pos
  let n = word.length()
  let mut i = 0
  while i < n {
    if p + i >= self.len {
      return false
    }
    let d = self.char_at(p + i)
    let c = word.code_unit_at(i)
    if !(d == c || (any_case && tok_lower_cp(d) == tok_lower_cp(c))) {
      return false
    }
    i = i + 1
  }
  self.pos = p + n
  true
}

fn Tokenizer::processing_instruction(self : Tokenizer) -> Bool {
  let n = self.len
  let mut i = self.pos
  if i >= n {
    self.state = Data
    return true
  }
  let c0 = self.char_at(i)
  if !(tok_alpha(c0) || c0 == 95) {
    return false
  }
  let target = StringBuilder()
  while i < n {
    let c = self.char_at(i)
    if tok_space(c) || c == 63 || c == 62 {
      break
    }
    if !(tok_alpha(c) || tok_digit(c) || c == 95 || c == 45) {
      return false
    }
    target.write_char(c.unsafe_to_char())
    i = i + 1
  }
  let t = target.to_string()
  if ascii_lower(t).starts_with("xml") {
    return false
  }
  while i < n && tok_space(self.char_at(i)) {
    i = i + 1
  }
  let data = StringBuilder()
  while i < n && self.char_at(i) != 62 {
    let c = self.char_at(i)
    if self.ascii && c >= 0x80 {
      let (cp, step) = utf8_decode_at(self.src, i)
      data.write_char(cp.unsafe_to_char())
      i = i + step
    } else {
      data.write_char((if c == 0 { 0xFFFD } else { c }).unsafe_to_char())
      i = i + 1
    }
  }
  if i >= n {
    self.pos = n
    self.state = Data
    return true
  }
  let mut d = data.to_string()
  if d.ends_with("?") {
    d = d.slice(0, d.length() - 1)
  }
  self.pos = i + 1
  self.state = Data
  let sep0 = Bytes::new(1)
  sep0[0] = (0).to_byte()
  let sep1 = Bytes::new(1)
  sep1[0] = (1).to_byte()
  self.emit(CommentToken(sep0.to_string() + t + sep1.to_string() + d))
  true
}

fn Tokenizer::reconsume(self : Tokenizer, s : State) -> Unit {
  self.pos = self.last_pos
  self.state = s
}

fn Tokenizer::in_attr_ref(self : Tokenizer) -> Bool {
  self.return_state == AttrValueDouble ||
  self.return_state == AttrValueSingle ||
  self.return_state == AttrValueUnquoted
}

fn Tokenizer::flush_ref(self : Tokenizer) -> Unit {
  let s = sb_opt_str(self.temp)
  if self.in_attr_ref() {
    self.aval_has_buf = true
    self.aval_sb().write_string(s)
  } else {
    self.emit_str(s)
  }
}

fn build_entity_map() -> Map[String, String] {
  let m : Map[String, String] = Map::new()
  let mut i = 0
  while i < ENTITY_LIST.length() {
    let e = ENTITY_LIST[i]
    m.set(e.name, e.value)
    i = i + 1
  }
  m
}

let ENTITIES : Map[String, String] = build_entity_map()

fn Tokenizer::named_ref(self : Tokenizer) -> Bool {
  let b = StringBuilder()
  let mut best : Option[String] = None
  let mut best_name = ""
  let mut best_len = 0
  let mut i = 0
  while i < 33 && self.pos + i < self.len {
    let c = self.char_at(self.pos + i)
    let ok = tok_alpha(c) || tok_digit(c) || c == 59
    if !ok {
      break
    }
    b.write_char(c.unsafe_to_char())
    i = i + 1
    let name = b.to_string()
    match ENTITIES.get(name) {
      Some(v) => {
        best = Some(v)
        best_name = name
        best_len = i
      }
      None => ()
    }
    if c == 59 {
      break
    }
  }
  match best {
    None => false
    Some(v) => {
      let next = if self.pos + best_len < self.len {
        self.char_at(self.pos + best_len)
      } else {
        TOK_EOF
      }
      let semi = best_name.ends_with(";")
      if self.in_attr_ref() &&
      !semi &&
      (next == 61 || tok_alpha(next) || tok_digit(next)) {
        let mut k = 0
        while k < best_len {
          self.temp_sb().write_char(self.char_at(self.pos).unsafe_to_char())
          self.pos = self.pos + 1
          k = k + 1
        }
      } else {
        self.pos = self.pos + best_len
        sb_opt_reset(self.temp)
        self.temp_sb().write_string(v)
      }
      self.flush_ref()
      self.state = self.return_state
      true
    }
  }
}

let WIN1252 : Array[Int] = [
  0x20AC, 0x81, 0x201A, 0x192, 0x201E, 0x2026, 0x2020, 0x2021, 0x2C6, 0x2030,
  0x160, 0x2039, 0x152, 0x8D, 0x17D, 0x8F, 0x90, 0x2018, 0x2019, 0x201C, 0x201D,
  0x2022, 0x2013, 0x2014, 0x2DC, 0x2122, 0x161, 0x203A, 0x153, 0x9D, 0x17E,
  0x178,
]

fn Tokenizer::try_scan_ascii_tag(self : Tokenizer) -> Option[Token] {
  let src = self.src
  let len = self.len
  let mut p = self.pos + 1
  if p >= len {
    return None
  }
  let c1 = src.code_unit_at(p)
  // Fast path A: pure lowercase ASCII end tag `</tag>`
  if c1 == 0x2F {
    p = p + 1
    if p >= len {
      return None
    }
    let name_start = p
    let fc = src.code_unit_at(p)
    if fc < 0x61 || fc > 0x7A {
      return None
    }
    p = p + 1
    while p < len {
      let ch = src.code_unit_at(p)
      if ch >= 0x61 && ch <= 0x7A {
        p = p + 1
        continue
      }
      if ch == 0x3E {
        let name = intern_html_tag(src, name_start, p)
        self.pos = p + 1
        return Some(EndTag(name))
      }
      if (ch >= 0x41 && ch <= 0x5A) || ch == 0 || ch == 0x2F || ch == 0x20 || ch == 0x09 || ch == 0x0A || ch == 0x0C || ch == 0x0D {
        return None
      }
      p = p + 1
    }
    return None
  }
  // Fast path B: pure lowercase ASCII start tag `<tag ...>`
  if c1 < 0x61 || c1 > 0x7A {
    return None
  }
  let name_start = p
  p = p + 1
  while p < len {
    let ch = src.code_unit_at(p)
    if ch >= 0x61 && ch <= 0x7A {
      p = p + 1
      continue
    }
    if ch == 0x3E || ch == 0x2F || ch == 0x20 || ch == 0x09 || ch == 0x0A || ch == 0x0C {
      break
    }
    if (ch >= 0x41 && ch <= 0x5A) || ch == 0 || ch == 0x0D {
      return None
    }
    p = p + 1
  }
  if p >= len {
    return None
  }
  let name = intern_html_tag(src, name_start, p)
  let sep = src.code_unit_at(p)
  if sep == 0x3E {
    self.pos = p + 1
    self.last_start = name
    return Some(StartTag(name, EMPTY_ATTRS, false))
  }
  if sep == 0x2F {
    if p + 1 < len && src.code_unit_at(p + 1) == 0x3E {
      self.pos = p + 2
      self.last_start = name
      return Some(StartTag(name, EMPTY_ATTRS, true))
    }
    return None
  }
  // Whitespace after tag name: scan simple lowercase attributes
  let mut attrs : Array[Attr] = EMPTY_ATTRS
  while p < len {
    while p < len {
      let ws = src.code_unit_at(p)
      if ws == 0x20 || ws == 0x09 || ws == 0x0A || ws == 0x0C {
        p = p + 1
      } else {
        break
      }
    }
    if p >= len {
      return None
    }
    let ch = src.code_unit_at(p)
    if ch == 0x3E {
      self.pos = p + 1
      self.last_start = name
      return Some(StartTag(name, attrs, false))
    }
    if ch == 0x2F {
      if p + 1 < len && src.code_unit_at(p + 1) == 0x3E {
        self.pos = p + 2
        self.last_start = name
        return Some(StartTag(name, attrs, true))
      }
      return None
    }
    let a_start = p
    while p < len {
      let ac = src.code_unit_at(p)
      if (ac >= 0x61 && ac <= 0x7A) || ac == 0x2D {
        p = p + 1
        continue
      }
      if ac == 0x3D || ac == 0x3E || ac == 0x2F || ac == 0x20 || ac == 0x09 || ac == 0x0A || ac == 0x0C {
        break
      }
      if (ac >= 0x41 && ac <= 0x5A) || ac == 0 || ac == 0x0D || ac == 0x22 || ac == 0x27 || ac == 0x3C {
        return None
      }
      p = p + 1
    }
    if p == a_start || p >= len {
      return None
    }
    let aname = intern_html_attr(src, a_start, p)
    let alen = attrs.length()
    if alen == 1 {
      if attrs[0].name == aname {
        return None
      }
    } else if alen > 1 {
      let mut ai = 0
      while ai < alen {
        if attrs[ai].name == aname {
          return None
        }
        ai = ai + 1
      }
    }
    let after = src.code_unit_at(p)
    let aval = if after == 0x3D {
      p = p + 1
      if p >= len {
        return None
      }
      let q = src.code_unit_at(p)
      if q != 0x22 && q != 0x27 {
        return None
      }
      p = p + 1
      let v_start = p
      while p < len {
        let vc = src.code_unit_at(p)
        if vc > 0x27 {
          p = p + 1
          continue
        }
        if vc == q {
          break
        }
        if vc == 0x26 || vc == 0 {
          return None
        }
        p = p + 1
      }
      if p >= len {
        return None
      }
      let v = if p == v_start { "" } else { intern_html_attr_val(src, v_start, p) }
      p = p + 1
      if p >= len {
        return None
      }
      let nc = src.code_unit_at(p)
      if nc != 0x20 && nc != 0x09 && nc != 0x0A && nc != 0x0C && nc != 0x3E && nc != 0x2F {
        return None
      }
      v
    } else if after == 0x20 || after == 0x09 || after == 0x0A || after == 0x0C {
      while p < len {
        let ws = src.code_unit_at(p)
        if ws == 0x20 || ws == 0x09 || ws == 0x0A || ws == 0x0C {
          p = p + 1
        } else {
          break
        }
      }
      if p >= len || src.code_unit_at(p) == 0x3D {
        return None
      }
      ""
    } else {
      ""
    }
    let a = Attr::new("", aname, aval, "")
    if alen == 0 {
      if p < len && src.code_unit_at(p) != 0x3E && src.code_unit_at(p) != 0x2F {
        attrs = Array::with_capacity(4)
        attrs.push(a)
      } else {
        attrs = [a]
      }
    } else {
      attrs.push(a)
    }
  }
  None
}

fn Tokenizer::next_token(self : Tokenizer) -> Token {
  if self.head >= self.out.length() && self.ascii && self.state == Data {
    if self.pos >= self.len {
      return Eof
    }
    let c = self.src.code_unit_at(self.pos)
    if c < 0x80 {
      if c != 0x3C && c != 0x26 && c != 0 && c != 0x0D {
        self.last_pos = self.pos
        self.pos = self.pos + 1
        return Character(c)
      }
      if c == 0x3C {
        match self.try_scan_ascii_tag() {
          Some(tok) => return tok
          None => ()
        }
      }
    } else {
      let p = self.pos
      self.last_pos = p
      let (cp, step) = utf8_decode_at(self.src, p)
      self.pos = p + step
      return Character(cp)
    }
  }
  while self.head >= self.out.length() {
    if self.out.length() > 0 {
      self.out.clear()
    }
    self.head = 0
    self.step()
  }
  let t = self.out[self.head]
  self.head = self.head + 1
  t
}

fn Tokenizer::raw_text_step(self : Tokenizer, s : State, c : Int) -> Unit {
  if c == 0x26 && s != ScriptData && s != Rawtext {
    self.return_state = s
    self.state = CharRef
  } else if c == 0x3C {
    self.raw_origin = s
    self.state = RawLessThan
  } else if c == 0 {
    self.emit_char(0xFFFD)
  } else if c == TOK_EOF {
    self.emit(Eof)
  } else {
    self.emit_char(c)
  }
}

fn Tokenizer::less_than_slash(self : Tokenizer, s : State) -> Unit {
  self.emit_char(0x3C)
  self.emit_char(0x2F)
  let t = sb_opt_str(self.temp)
  self.emit_str(t)
  self.state = s
}

fn Tokenizer::step(self : Tokenizer) -> Unit {
  let state = self.state
  let c = self.next_char()
  match state {
    Data => {
      if c == 0x26 {
        self.return_state = Data
        self.state = CharRef
      } else if c == 0x3C {
        self.state = TagOpen
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.emit_char(c)
      }
    }
    Rcdata => self.raw_text_step(Rcdata, c)
    Rawtext => self.raw_text_step(Rawtext, c)
    ScriptData => self.raw_text_step(ScriptData, c)
    Plaintext => {
      if c == 0 {
        self.emit_char(0xFFFD)
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.emit_char(c)
      }
    }
    TagOpen => {
      if c == 0x21 {
        self.state = MarkupDeclarationOpen
      } else if c == 0x2F {
        self.state = EndTagOpen
      } else if tok_alpha(c) {
        self.start_tag(false)
        self.reconsume(TagName)
      } else if c == 0x3F {
        if !self.processing_instruction() {
          sb_opt_reset(self.comment)
          self.reconsume(BogusComment)
        }
      } else {
        self.emit_char(0x3C)
        self.reconsume(Data)
      }
    }
    EndTagOpen => {
      if tok_alpha(c) {
        self.start_tag(true)
        self.reconsume(TagName)
      } else if c == 0x3E {
        self.state = Data
      } else if c == TOK_EOF {
        self.emit_char(0x3C)
        self.emit_char(0x2F)
        self.emit(Eof)
      } else {
        sb_opt_reset(self.comment)
        self.reconsume(BogusComment)
      }
    }
    TagName => {
      if tok_space(c) {
        self.state = BeforeAttrName
      } else if c == 0x2F {
        self.state = SelfClosingStartTag
      } else if c == 0x3E {
        self.state = Data
        self.emit_tag()
      } else if c == 0 {
        self.tag_has_buf = true
        self.tag_sb().write_char((0xFFFD).unsafe_to_char())
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else if self.ascii && !self.tag_has_buf && self.tag_slice.is_none() && !(c >= 65 && c <= 90) {
        let start = self.last_pos
        let mut p = self.pos
        let mut pure_lower = true
        while p < self.len {
          let d = self.src.code_unit_at(p)
          if tok_space(d) || d == 0x2F || d == 0x3E {
            break
          }
          if d == 0 || (d >= 65 && d <= 90) {
            pure_lower = false
            break
          }
          p = p + 1
        }
        if pure_lower {
          self.tag_slice = Some(intern_html_tag(self.src, start, p))
          self.pos = p
        } else {
          self.tag_has_buf = true
          self.tag_sb().write_string(self.src.slice(start, p))
          while p < self.len {
            let d = self.src.code_unit_at(p)
            if tok_space(d) || d == 0x2F || d == 0x3E || d == 0 {
              break
            }
            if d >= 0x80 {
              let (cp, step) = utf8_decode_at(self.src, p)
              self.tag_sb().write_char(cp.unsafe_to_char())
              p = p + step
            } else {
              self.tag_sb().write_char(tok_lower_char(d))
              p = p + 1
            }
          }
          self.pos = p
        }
      } else {
        self.tag_has_buf = true
        self.tag_sb().write_char(tok_lower_char(c))
        while self.pos < self.len {
          let d = self.char_at(self.pos)
          if tok_space(d) || d == 0x2F || d == 0x3E || d == 0 {
            break
          }
          if self.ascii && d >= 0x80 {
            let (cp, step) = utf8_decode_at(self.src, self.pos)
            self.tag_sb().write_char(cp.unsafe_to_char())
            self.pos = self.pos + step
          } else {
            self.tag_sb().write_char(tok_lower_char(d))
            self.pos = self.pos + 1
          }
        }
      }
    }
    RawLessThan => {
      let s = self.raw_origin
      if c == 0x2F {
        sb_opt_reset(self.temp)
        self.state = RawEndOpen
      } else if s == ScriptData && c == 0x21 {
        self.state = EscapeStart
        self.emit_char(0x3C)
        self.emit_char(0x21)
      } else if s == Escaped && tok_alpha(c) {
        sb_opt_reset(self.temp)
        self.emit_char(0x3C)
        self.reconsume(DoubleEscapeStart)
      } else {
        self.emit_char(0x3C)
        self.reconsume(s)
      }
    }
    RawEndOpen => {
      let s = self.raw_origin
      if tok_alpha(c) {
        self.start_tag(true)
        self.reconsume(RawEndName)
      } else {
        self.emit_char(0x3C)
        self.emit_char(0x2F)
        self.reconsume(s)
      }
    }
    RawEndName => {
      let s = self.raw_origin
      if tok_space(c) && self.appropriate() {
        self.state = BeforeAttrName
      } else if c == 0x2F && self.appropriate() {
        self.state = SelfClosingStartTag
      } else if c == 0x3E && self.appropriate() {
        self.state = Data
        self.emit_tag()
      } else if tok_alpha(c) {
        self.tag_has_buf = true
        self.tag_sb().write_char(tok_lower_char(c))
        self.temp_sb().write_char(c.unsafe_to_char())
      } else {
        self.less_than_slash(s)
        self.pos = self.last_pos
      }
    }
    EscapeStart => {
      if c == 0x2D {
        self.state = EscapeStartDash
        self.emit_char(c)
      } else {
        self.reconsume(ScriptData)
      }
    }
    EscapeStartDash => {
      if c == 0x2D {
        self.state = EscapedDashDash
        self.emit_char(c)
      } else {
        self.reconsume(ScriptData)
      }
    }
    Escaped => self.escaped_step(Escaped, c)
    EscapedDash => self.escaped_step(EscapedDash, c)
    EscapedDashDash => self.escaped_step(EscapedDashDash, c)
    DoubleEscapeStart => {
      if tok_space(c) || c == 0x2F || c == 0x3E {
        self.state = if sb_opt_str(self.temp) == "script" {
          DoubleEscaped
        } else {
          Escaped
        }
        self.emit_char(c)
      } else if tok_alpha(c) {
        self.temp_sb().write_char(tok_lower_char(c))
        self.emit_char(c)
      } else {
        self.reconsume(Escaped)
      }
    }
    DoubleEscaped => self.double_escaped_step(DoubleEscaped, c)
    DoubleEscapedDash => self.double_escaped_step(DoubleEscapedDash, c)
    DoubleEscapedDashDash => self.double_escaped_step(DoubleEscapedDashDash, c)
    DoubleEscapedLessThan => {
      if c == 0x2F {
        sb_opt_reset(self.temp)
        self.state = DoubleEscapeEnd
        self.emit_char(c)
      } else {
        self.reconsume(DoubleEscaped)
      }
    }
    DoubleEscapeEnd => {
      if tok_space(c) || c == 0x2F || c == 0x3E {
        self.state = if sb_opt_str(self.temp) == "script" {
          Escaped
        } else {
          DoubleEscaped
        }
        self.emit_char(c)
      } else if tok_alpha(c) {
        self.temp_sb().write_char(tok_lower_char(c))
        self.emit_char(c)
      } else {
        self.reconsume(DoubleEscaped)
      }
    }
    BeforeAttrName => {
      if tok_space(c) {
        ()
      } else if c == 0x2F || c == 0x3E || c == TOK_EOF {
        self.reconsume(AfterAttrName)
      } else if c == 0x3D {
        self.start_attr()
        self.aname_has_buf = true
        self.aname_sb().write_char('=')
        self.state = AttrName
      } else {
        self.start_attr()
        self.reconsume(AttrName)
      }
    }
    AttrName => {
      if tok_space(c) || c == 0x2F || c == 0x3E || c == TOK_EOF {
        self.reconsume(AfterAttrName)
      } else if c == 0x3D {
        self.state = BeforeAttrValue
      } else if c == 0 {
        self.aname_has_buf = true
        self.aname_sb().write_char((0xFFFD).unsafe_to_char())
      } else if self.ascii && !self.aname_has_buf && self.attr_name_slice.is_none() && !(c >= 65 && c <= 90) {
        let start = self.last_pos
        let mut p = self.pos
        let mut pure_lower = true
        while p < self.len {
          let d = self.src.code_unit_at(p)
          if tok_space(d) || d == 0x2F || d == 0x3E || d == 0x3D {
            break
          }
          if d == 0 || (d >= 65 && d <= 90) {
            pure_lower = false
            break
          }
          p = p + 1
        }
        if pure_lower {
          self.attr_name_slice = Some(intern_html_attr(self.src, start, p))
          self.pos = p
        } else {
          self.aname_has_buf = true
          self.aname_sb().write_string(self.src.slice(start, p))
          while p < self.len {
            let d = self.src.code_unit_at(p)
            if tok_space(d) || d == 0x2F || d == 0x3E || d == 0x3D || d == 0 {
              break
            }
            if d >= 0x80 {
              let (cp, step) = utf8_decode_at(self.src, p)
              self.aname_sb().write_char(cp.unsafe_to_char())
              p = p + step
            } else {
              self.aname_sb().write_char(tok_lower_char(d))
              p = p + 1
            }
          }
          self.pos = p
        }
      } else {
        self.aname_has_buf = true
        self.aname_sb().write_char(tok_lower_char(c))
        while self.pos < self.len {
          let d = self.char_at(self.pos)
          if tok_space(d) || d == 0x2F || d == 0x3E || d == 0x3D || d == 0 {
            break
          }
          if self.ascii && d >= 0x80 {
            let (cp, step) = utf8_decode_at(self.src, self.pos)
            self.aname_sb().write_char(cp.unsafe_to_char())
            self.pos = self.pos + step
          } else {
            self.aname_sb().write_char(tok_lower_char(d))
            self.pos = self.pos + 1
          }
        }
      }
    }
    AfterAttrName => {
      if tok_space(c) {
        ()
      } else if c == 0x2F {
        self.state = SelfClosingStartTag
      } else if c == 0x3D {
        self.state = BeforeAttrValue
      } else if c == 0x3E {
        self.state = Data
        self.emit_tag()
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.start_attr()
        self.reconsume(AttrName)
      }
    }
    BeforeAttrValue => {
      if tok_space(c) {
        ()
      } else if c == 0x22 {
        self.state = AttrValueDouble
      } else if c == 0x27 {
        self.state = AttrValueSingle
      } else if c == 0x3E {
        self.state = Data
        self.emit_tag()
      } else {
        self.reconsume(AttrValueUnquoted)
      }
    }
    AttrValueDouble => self.attr_quoted_step(AttrValueDouble, 0x22, c)
    AttrValueSingle => self.attr_quoted_step(AttrValueSingle, 0x27, c)
    AttrValueUnquoted => {
      if tok_space(c) {
        self.state = BeforeAttrName
      } else if c == 0x26 {
        self.return_state = AttrValueUnquoted
        self.state = CharRef
      } else if c == 0x3E {
        self.state = Data
        self.emit_tag()
      } else if c == 0 {
        self.aval_has_buf = true
        self.aval_sb().write_char((0xFFFD).unsafe_to_char())
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.aval_has_buf = true
        self.aval_sb().write_char(c.unsafe_to_char())
      }
    }
    AfterAttrValueQuoted => {
      if tok_space(c) {
        self.state = BeforeAttrName
      } else if c == 0x2F {
        self.state = SelfClosingStartTag
      } else if c == 0x3E {
        self.state = Data
        self.emit_tag()
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.reconsume(BeforeAttrName)
      }
    }
    SelfClosingStartTag => {
      if c == 0x3E {
        self.self_closing = true
        self.state = Data
        self.emit_tag()
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.reconsume(BeforeAttrName)
      }
    }
    BogusComment => {
      if c == 0x3E {
        self.state = Data
        self.emit_comment()
      } else if c == TOK_EOF {
        self.emit_comment()
        self.emit(Eof)
      } else if c == 0 {
        self.comment_sb().write_char((0xFFFD).unsafe_to_char())
      } else {
        self.comment_sb().write_char(c.unsafe_to_char())
      }
    }
    MarkupDeclarationOpen => {
      self.pos = self.last_pos
      if self.take("--", false) {
        sb_opt_reset(self.comment)
        self.state = CommentStart
      } else if self.take("DOCTYPE", true) {
        self.state = DoctypeState
      } else if self.take("[CDATA[", false) {
        if self.allow_cdata {
          self.state = CdataSection
        } else {
          sb_opt_reset(self.comment)
          self.comment_sb().write_string("[CDATA[")
          self.state = BogusComment
        }
      } else {
        sb_opt_reset(self.comment)
        self.state = BogusComment
      }
    }
    CommentStart => {
      if c == 0x2D {
        self.state = CommentStartDash
      } else if c == 0x3E {
        self.state = Data
        self.emit_comment()
      } else {
        self.reconsume(CommentBody)
      }
    }
    CommentStartDash => {
      if c == 0x2D {
        self.state = CommentEnd
      } else if c == 0x3E {
        self.state = Data
        self.emit_comment()
      } else if c == TOK_EOF {
        self.emit_comment()
        self.emit(Eof)
      } else {
        self.comment_sb().write_char('-')
        self.reconsume(CommentBody)
      }
    }
    CommentBody => {
      if c == 0x3C {
        self.comment_sb().write_char('<')
        self.state = CommentLessThan
      } else if c == 0x2D {
        self.state = CommentEndDash
      } else if c == 0 {
        self.comment_sb().write_char((0xFFFD).unsafe_to_char())
      } else if c == TOK_EOF {
        self.emit_comment()
        self.emit(Eof)
      } else {
        self.comment_sb().write_char(c.unsafe_to_char())
      }
    }
    CommentLessThan => {
      if c == 0x21 {
        self.comment_sb().write_char('!')
        self.state = CommentLessThanBang
      } else if c == 0x3C {
        self.comment_sb().write_char('<')
      } else {
        self.reconsume(CommentBody)
      }
    }
    CommentLessThanBang => {
      if c == 0x2D {
        self.state = CommentLessThanBangDash
      } else {
        self.reconsume(CommentBody)
      }
    }
    CommentLessThanBangDash => {
      if c == 0x2D {
        self.state = CommentLessThanBangDashDash
      } else {
        self.reconsume(CommentEndDash)
      }
    }
    CommentLessThanBangDashDash => self.reconsume(CommentEnd)
    CommentEndDash => {
      if c == 0x2D {
        self.state = CommentEnd
      } else if c == TOK_EOF {
        self.emit_comment()
        self.emit(Eof)
      } else {
        self.comment_sb().write_char('-')
        self.reconsume(CommentBody)
      }
    }
    CommentEnd => {
      if c == 0x3E {
        self.state = Data
        self.emit_comment()
      } else if c == 0x21 {
        self.state = CommentEndBang
      } else if c == 0x2D {
        self.comment_sb().write_char('-')
      } else if c == TOK_EOF {
        self.emit_comment()
        self.emit(Eof)
      } else {
        self.comment_sb().write_string("--")
        self.reconsume(CommentBody)
      }
    }
    CommentEndBang => {
      if c == 0x2D {
        self.comment_sb().write_string("--!")
        self.state = CommentEndDash
      } else if c == 0x3E {
        self.state = Data
        self.emit_comment()
      } else if c == TOK_EOF {
        self.emit_comment()
        self.emit(Eof)
      } else {
        self.comment_sb().write_string("--!")
        self.reconsume(CommentBody)
      }
    }
    DoctypeState => {
      if tok_space(c) {
        self.state = BeforeDoctypeName
      } else if c == TOK_EOF {
        self.start_doctype()
        self.dt_quirks = true
        self.emit_doctype()
        self.emit(Eof)
      } else {
        self.reconsume(BeforeDoctypeName)
      }
    }
    BeforeDoctypeName => {
      if tok_space(c) {
        ()
      } else if c == 0x3E {
        self.start_doctype()
        self.dt_quirks = true
        self.state = Data
        self.emit_doctype()
      } else if c == TOK_EOF {
        self.start_doctype()
        self.dt_quirks = true
        self.emit_doctype()
        self.emit(Eof)
      } else {
        self.start_doctype()
        let b = StringBuilder()
        b.write_char(
          if c == 0 { (0xFFFD).unsafe_to_char() } else { tok_lower_char(c) },
        )
        self.dt_name = Some(b)
        self.state = DoctypeName
      }
    }
    DoctypeName => {
      if tok_space(c) {
        self.state = AfterDoctypeName
      } else if c == 0x3E {
        self.state = Data
        self.emit_doctype()
      } else if c == TOK_EOF {
        self.dt_quirks = true
        self.emit_doctype()
        self.emit(Eof)
      } else {
        match self.dt_name {
          Some(b) => {
            b.write_char(
              if c == 0 {
                (0xFFFD).unsafe_to_char()
              } else {
                tok_lower_char(c)
              },
            )
          }
          None => ()
        }
      }
    }
    AfterDoctypeName => {
      if tok_space(c) {
        ()
      } else if c == 0x3E {
        self.state = Data
        self.emit_doctype()
      } else if c == TOK_EOF {
        self.dt_quirks = true
        self.emit_doctype()
        self.emit(Eof)
      } else {
        self.pos = self.last_pos
        if self.take("PUBLIC", true) {
          self.state = AfterDoctypePublicKeyword
        } else if self.take("SYSTEM", true) {
          self.state = AfterDoctypeSystemKeyword
        } else {
          self.dt_quirks = true
          self.state = BogusDoctype
        }
      }
    }
    AfterDoctypePublicKeyword => self.before_doctype_pub_step(c)
    BeforeDoctypePublicId => self.before_doctype_pub_step(c)
    DoctypePublicIdDouble => self.doctype_pub_id_step(0x22, c)
    DoctypePublicIdSingle => self.doctype_pub_id_step(0x27, c)
    AfterDoctypePublicId => self.after_doctype_pub_step(c)
    BetweenDoctypeIds => self.after_doctype_pub_step(c)
    AfterDoctypeSystemKeyword => self.before_doctype_sys_step(c)
    BeforeDoctypeSystemId => self.before_doctype_sys_step(c)
    DoctypeSystemIdDouble => self.doctype_sys_id_step(0x22, c)
    DoctypeSystemIdSingle => self.doctype_sys_id_step(0x27, c)
    AfterDoctypeSystemId => {
      if tok_space(c) {
        ()
      } else if c == 0x3E {
        self.state = Data
        self.emit_doctype()
      } else if c == TOK_EOF {
        self.dt_quirks = true
        self.emit_doctype()
        self.emit(Eof)
      } else {
        self.reconsume(BogusDoctype)
      }
    }
    BogusDoctype => {
      if c == 0x3E {
        self.state = Data
        self.emit_doctype()
      } else if c == TOK_EOF {
        self.emit_doctype()
        self.emit(Eof)
      }
    }
    CdataSection => {
      if c == 0x5D {
        self.state = CdataSectionBracket
      } else if c == TOK_EOF {
        self.emit(Eof)
      } else {
        self.emit_char(c)
      }
    }
    CdataSectionBracket => {
      if c == 0x5D {
        self.state = CdataSectionEnd
      } else {
        self.emit_char(0x5D)
        self.reconsume(CdataSection)
      }
    }
    CdataSectionEnd => {
      if c == 0x5D {
        self.emit_char(0x5D)
      } else if c == 0x3E {
        self.state = Data
      } else {
        self.emit_char(0x5D)
        self.emit_char(0x5D)
        self.reconsume(CdataSection)
      }
    }
    CharRef => {
      sb_opt_reset(self.temp)
      self.temp_sb().write_char('&')
      if tok_alpha(c) || tok_digit(c) {
        self.pos = self.last_pos
        if !self.named_ref() {
          self.flush_ref()
          self.state = self.return_state
        }
      } else if c == 0x23 {
        self.temp_sb().write_char('#')
        self.state = NumericCharRef
      } else {
        self.flush_ref()
        self.reconsume(self.return_state)
      }
    }
    NumericCharRef => {
      self.char_code = 0
      if c == 0x78 || c == 0x58 {
        self.temp_sb().write_char(c.unsafe_to_char())
        self.state = HexStart
      } else {
        self.reconsume(DecStart)
      }
    }
    HexStart => {
      if tok_hex(c) {
        self.reconsume(HexRef)
      } else {
        self.flush_ref()
        self.reconsume(self.return_state)
      }
    }
    DecStart => {
      if tok_digit(c) {
        self.reconsume(DecRef)
      } else {
        self.flush_ref()
        self.reconsume(self.return_state)
      }
    }
    HexRef => self.num_ref_step(16, c)
    DecRef => self.num_ref_step(10, c)
    NumericRefEnd => {
      self.pos = self.last_pos
      let mut code = self.char_code
      if code == 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF) {
        code = 0xFFFD
      } else if code >= 0x80 && code <= 0x9F {
        code = WIN1252[code - 0x80]
      }
      sb_opt_reset(self.temp)
      self.temp_sb().write_char(code.unsafe_to_char())
      self.flush_ref()
      self.state = self.return_state
    }
  }
}

fn Tokenizer::escaped_step(self : Tokenizer, state : State, c : Int) -> Unit {
  if c == 0x2D {
    self.state = if state == Escaped { EscapedDash } else { EscapedDashDash }
    self.emit_char(c)
  } else if c == 0x3C {
    self.raw_origin = Escaped
    self.state = RawLessThan
  } else if c == 0x3E && state == EscapedDashDash {
    self.state = ScriptData
    self.emit_char(c)
  } else if c == 0 {
    self.state = Escaped
    self.emit_char(0xFFFD)
  } else if c == TOK_EOF {
    self.emit(Eof)
  } else {
    self.state = Escaped
    self.emit_char(c)
  }
}

fn Tokenizer::double_escaped_step(
  self : Tokenizer,
  state : State,
  c : Int,
) -> Unit {
  if c == 0x2D {
    self.state = if state == DoubleEscaped {
      DoubleEscapedDash
    } else {
      DoubleEscapedDashDash
    }
    self.emit_char(c)
  } else if c == 0x3C {
    self.state = DoubleEscapedLessThan
    self.emit_char(c)
  } else if c == 0x3E && state == DoubleEscapedDashDash {
    self.state = ScriptData
    self.emit_char(c)
  } else if c == 0 {
    self.state = DoubleEscaped
    self.emit_char(0xFFFD)
  } else if c == TOK_EOF {
    self.emit(Eof)
  } else {
    self.state = DoubleEscaped
    self.emit_char(c)
  }
}

fn Tokenizer::attr_quoted_step(
  self : Tokenizer,
  state : State,
  end : Int,
  c : Int,
) -> Unit {
  if c == end {
    self.state = AfterAttrValueQuoted
  } else if c == 0x26 {
    self.return_state = state
    self.state = CharRef
  } else if c == 0 {
    self.aval_has_buf = true
    self.aval_sb().write_char((0xFFFD).unsafe_to_char())
  } else if c == TOK_EOF {
    self.emit(Eof)
  } else {
    if self.ascii {
      let start = self.last_pos
      let mut p = self.pos
      while p < self.len {
        let d = self.src.code_unit_at(p)
        if d == end || d == 0x26 || d == 0 {
          break
        }
        p = p + 1
      }
      if !self.aval_has_buf && self.attr_val_slice.is_none() && p < self.len && self.src.code_unit_at(p) == end {
        self.attr_val_slice = Some(intern_html_attr_val(self.src, start, p))
        self.pos = p + 1
        self.state = AfterAttrValueQuoted
      } else {
        self.aval_has_buf = true
        self.aval_sb().write_string(self.src.slice(start, p))
        self.pos = p
      }
    } else {
      self.aval_has_buf = true
      self.aval_sb().write_char(c.unsafe_to_char())
      while self.pos < self.len {
        let d = self.input[self.pos]
        if d == end || d == 0x26 || d == 0 {
          break
        }
        self.aval_sb().write_char(d.unsafe_to_char())
        self.pos = self.pos + 1
      }
    }
  }
}

fn Tokenizer::before_doctype_pub_step(self : Tokenizer, c : Int) -> Unit {
  if tok_space(c) {
    self.state = BeforeDoctypePublicId
  } else if c == 0x22 || c == 0x27 {
    self.dt_public = Some(StringBuilder())
    self.state = if c == 0x22 {
      DoctypePublicIdDouble
    } else {
      DoctypePublicIdSingle
    }
  } else if c == 0x3E {
    self.dt_quirks = true
    self.state = Data
    self.emit_doctype()
  } else if c == TOK_EOF {
    self.dt_quirks = true
    self.emit_doctype()
    self.emit(Eof)
  } else {
    self.dt_quirks = true
    self.reconsume(BogusDoctype)
  }
}

fn Tokenizer::doctype_pub_id_step(
  self : Tokenizer,
  end : Int,
  c : Int,
) -> Unit {
  if c == end {
    self.state = AfterDoctypePublicId
  } else if c == 0x3E {
    self.dt_quirks = true
    self.state = Data
    self.emit_doctype()
  } else if c == TOK_EOF {
    self.dt_quirks = true
    self.emit_doctype()
    self.emit(Eof)
  } else {
    match self.dt_public {
      Some(b) => {
        b.write_char((if c == 0 { 0xFFFD } else { c }).unsafe_to_char())
      }
      None => ()
    }
  }
}

fn Tokenizer::after_doctype_pub_step(self : Tokenizer, c : Int) -> Unit {
  if tok_space(c) {
    self.state = BetweenDoctypeIds
  } else if c == 0x3E {
    self.state = Data
    self.emit_doctype()
  } else if c == 0x22 || c == 0x27 {
    self.dt_system = Some(StringBuilder())
    self.state = if c == 0x22 {
      DoctypeSystemIdDouble
    } else {
      DoctypeSystemIdSingle
    }
  } else if c == TOK_EOF {
    self.dt_quirks = true
    self.emit_doctype()
    self.emit(Eof)
  } else {
    self.dt_quirks = true
    self.reconsume(BogusDoctype)
  }
}

fn Tokenizer::before_doctype_sys_step(self : Tokenizer, c : Int) -> Unit {
  if tok_space(c) {
    self.state = BeforeDoctypeSystemId
  } else if c == 0x22 || c == 0x27 {
    self.dt_system = Some(StringBuilder())
    self.state = if c == 0x22 {
      DoctypeSystemIdDouble
    } else {
      DoctypeSystemIdSingle
    }
  } else if c == 0x3E {
    self.dt_quirks = true
    self.state = Data
    self.emit_doctype()
  } else if c == TOK_EOF {
    self.dt_quirks = true
    self.emit_doctype()
    self.emit(Eof)
  } else {
    self.dt_quirks = true
    self.reconsume(BogusDoctype)
  }
}

fn Tokenizer::doctype_sys_id_step(
  self : Tokenizer,
  end : Int,
  c : Int,
) -> Unit {
  if c == end {
    self.state = AfterDoctypeSystemId
  } else if c == 0x3E {
    self.dt_quirks = true
    self.state = Data
    self.emit_doctype()
  } else if c == TOK_EOF {
    self.dt_quirks = true
    self.emit_doctype()
    self.emit(Eof)
  } else {
    match self.dt_system {
      Some(b) => {
        b.write_char((if c == 0 { 0xFFFD } else { c }).unsafe_to_char())
      }
      None => ()
    }
  }
}

fn Tokenizer::num_ref_step(self : Tokenizer, base : Int, c : Int) -> Unit {
  let v = if tok_digit(c) {
    c - 0x30
  } else if base == 16 && c >= 0x61 && c <= 0x66 {
    c - 0x61 + 10
  } else if base == 16 && c >= 0x41 && c <= 0x46 {
    c - 0x41 + 10
  } else {
    -1
  }
  if v >= 0 {
    if self.char_code <= 0x10FFFF {
      self.char_code = self.char_code * base + v
    }
  } else if c == 0x3B {
    self.state = NumericRefEnd
  } else {
    self.reconsume(NumericRefEnd)
  }
}
