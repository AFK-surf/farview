///| HTML fragment serialization & DOM node cloning.
///| 1:1 port of `client/src/html/serialize.mbt`.

fn html_escape(s : String, attr : Bool) -> String {
  let b = StringBuilder()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 38 {
      b.write_string("&amp;")
      i = i + 1
    } else if c == 0xC2 && i + 1 < n && s.code_unit_at(i + 1) == 0xA0 {
      b.write_string("&nbsp;")
      i = i + 2
    } else if c == 34 && attr {
      b.write_string("&quot;")
      i = i + 1
    } else if c == 60 && !attr {
      b.write_string("&lt;")
      i = i + 1
    } else if c == 62 && !attr {
      b.write_string("&gt;")
      i = i + 1
    } else {
      let end = if c < 0x80 {
        i + 1
      } else if c < 0xE0 {
        i + 2
      } else if c < 0xF0 {
        i + 3
      } else {
        i + 4
      }
      let e = if end <= n { end } else { n }
      b.write_string(s.slice(i, e))
      i = e
    }
  }
  b.to_string()
}

fn is_raw_text_tag(tag : String) -> Bool {
  tag == "style" ||
  tag == "script" ||
  tag == "xmp" ||
  tag == "iframe" ||
  tag == "noembed" ||
  tag == "noframes" ||
  tag == "plaintext"
}

fn is_void_tag(tag : String) -> Bool {
  tag == "area" ||
  tag == "base" ||
  tag == "basefont" ||
  tag == "bgsound" ||
  tag == "br" ||
  tag == "col" ||
  tag == "embed" ||
  tag == "frame" ||
  tag == "hr" ||
  tag == "img" ||
  tag == "input" ||
  tag == "keygen" ||
  tag == "link" ||
  tag == "meta" ||
  tag == "param" ||
  tag == "source" ||
  tag == "track" ||
  tag == "wbr"
}

fn write_node(b : StringBuilder, n : Node) -> Unit {
  match n.kind {
    Text => {
      let raw = match n.parent {
        Some(p) => p.ns == Html && is_raw_text_tag(p.tag)
        None => false
      }
      b.write_string(if raw { n.data } else { html_escape(n.data, false) })
    }
    Comment => b.write_string("<!--" + n.data + "-->")
    Doctype => b.write_string("<!DOCTYPE " + n.tag + ">")
    Element => {
      b.write_string("<" + n.tag)
      let mut i = 0
      while i < n.attrs.length() {
        let a = n.attrs[i]
        let name = if a.prefix == "" { a.name } else { a.prefix + ":" + a.name }
        b.write_string(" " + name + "=\"" + html_escape(a.value, true) + "\"")
        i = i + 1
      }
      b.write_char('>')
      if !is_void_tag(n.tag) {
        write_children(b, n)
        b.write_string("</" + n.tag + ">")
      }
    }
    _ => write_children(b, n)
  }
}

fn write_children(b : StringBuilder, n : Node) -> Unit {
  let from = n.content_node()
  let mut i = 0
  while i < from.children.length() {
    write_node(b, from.children[i])
    i = i + 1
  }
}

pub fn inner_html(n : Node) -> String {
  let b = StringBuilder()
  write_children(b, n)
  b.to_string()
}

pub fn outer_html(n : Node) -> String {
  let b = StringBuilder()
  write_node(b, n)
  b.to_string()
}

pub fn text_content(n : Node) -> String {
  match n.kind {
    Text => n.data
    Comment => n.data
    _ => {
      let nc = n.children.length()
      if nc == 0 {
        return ""
      }
      if nc == 1 && n.children[0].kind == Text {
        return n.children[0].data
      }
      let b = StringBuilder()
      let walk : Array[Node] = [n]
      while walk.length() > 0 {
        match walk.pop() {
          Some(x) =>
          if x.kind == Text {
            b.write_string(x.data)
          } else {
            let mut i = x.children.length() - 1
            while i >= 0 {
              walk.push(x.children[i])
              i = i - 1
            }
          }
          None => break
        }
      }
      b.to_string()
    }
  }
}

pub fn clone(n : Node, deep : Bool) -> Node {
  let attrs : Array[Attr] = []
  let mut i = 0
  while i < n.attrs.length() {
    let a = n.attrs[i]
    attrs.push(Attr::new(a.prefix, a.name, a.value, a.ns))
    i = i + 1
  }
  let c = Node::new_full(n.kind, n.ns, n.tag, attrs, n.data, false)
  match n.rare {
    Some(nr) => {
      if nr.prefix != "" { c.set_prefix(nr.prefix) }
      if nr.ns_uri != "" { c.set_ns_uri(nr.ns_uri) }
      if nr.public_id.is_some() { c.set_public_id(nr.public_id) }
      if nr.system_id.is_some() { c.set_system_id(nr.system_id) }
      if nr.quirks { c.set_quirks(true) }
      match nr.template_content {
        Some(t) => {
          let content = clone(t, deep)
          content.set_of_template(true)
          c.set_template_content(Some(content))
        }
        None => ()
      }
    }
    None => ()
  }
  if deep {
    i = 0
    while i < n.children.length() {
      c.append(clone(n.children[i], true))
      i = i + 1
    }
  }
  c
}
