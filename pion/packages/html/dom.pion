///| DOM tree types and Biased-RC-safe tree operations.
///| 1:1 port of `client/src/html/dom.mbt`.

pub enum Ns {
  Html
  Svg
  MathMl
  Other
}

pub enum Kind {
  Document
  Fragment
  Doctype
  Element
  Text
  Comment
}

pub struct Attr {
  pub prefix : String
  pub name : String
  pub mut value : String
  pub ns : String
}

pub let XLINK_NS : String = "http://www.w3.org/1999/xlink"
pub let XMLNS_NS : String = "http://www.w3.org/2000/xmlns/"
pub let XML_NS : String = "http://www.w3.org/XML/1998/namespace"

pub fn Attr::new(
  prefix : String,
  name : String,
  value : String,
  ns : String,
) -> Attr {
  Attr::{ prefix: prefix, name: name, value: value, ns: ns }
}

pub fn Attr::qname(self : Attr) -> String {
  if self.prefix == "" {
    self.name
  } else {
    self.prefix + ":" + self.name
  }
}

pub struct Node {
  pub kind : Kind
  pub ns : Ns
  pub mut tag : String
  pub mut attrs : Array[Attr]
  pub mut data : String
  pub mut public_id : Option[String]
  pub mut system_id : Option[String]
  pub mut parent : Option[Node]
  pub mut children : Array[Node]
  pub mut template_content : Option[Node]
  pub mut of_template : Bool
  pub mut shadow : Option[Node]
  pub mut host : Option[Node]
  pub mut value : Option[String]
  pub mut checked : Option[Bool]
  pub mut ns_uri : String
  pub mut prefix : String
  pub mut quirks : Bool
  pub mut layout_id : Int
  pub mut js_id : Int
  pub mut pos : Int
  pub uid : Int
  pub mut wire_id : Int
  pub mut src_url : Option[String]
  pub mut natural : Option[(Double, Double)]
  pub mut ever_styled : Bool
  pub mut class_bloom_valid : Bool
  pub mut class_bloom : Int64
  pub mut class_val : String
}

struct DomCounters {
  mut next_uid : Int
  mut tree_changes : Int
  mut id_attr_adds : Int
  mut base_tag_adds : Int
  mut svg_adds : Int
  mut asset_adds : Int
  mut class_attr_adds : Int
}

let dom_counters : DomCounters = DomCounters::{
  next_uid: 0,
  tree_changes: 0,
  id_attr_adds: 0,
  base_tag_adds: 0,
  svg_adds: 0,
  asset_adds: 0,
  class_attr_adds: 0,
}

fn note_dom_attr(an : String, av : String) -> Unit {
  let l = an.length()
  if l == 2 || l == 4 {
    note_name(an, av)
  } else if l == 5 {
    if an == "class" {
      dom_counters.asset_adds += 1
      dom_counters.class_attr_adds += 1
    } else if an == "style" {
      dom_counters.asset_adds += 1
    }
  }
}

fn note_dom_element(ns : Ns, tag : String) -> Unit {
  if ns == Svg {
    dom_counters.svg_adds += 1
    return
  }
  let l = tag.length()
  if l == 3 {
    if tag == "svg" { dom_counters.svg_adds += 1 }
    else if tag == "img" { dom_counters.asset_adds += 1 }
  } else if l == 4 {
    if ns == Html && tag == "base" { dom_counters.base_tag_adds += 1 }
    else if tag == "link" { dom_counters.asset_adds += 1 }
  } else if l == 5 {
    if tag == "style" { dom_counters.asset_adds += 1 }
  } else if l == 6 {
    if tag == "source" || tag == "canvas" || tag == "iframe" { dom_counters.asset_adds += 1 }
  } else if l == 7 {
    if tag == "picture" { dom_counters.asset_adds += 1 }
  }
}

///| Every value an `id` or a `name` attribute was given, in any document (a name not among them finds no element,
///| whatever the document's elements are now); none kept past `NAMES_CAP` (then every name may be one).
let GIVEN_NAMES : Map[String, Bool] = Map::new()
let NAMES_CAP : Int = 100000

///| An attribute given a value: kept when it is an `id` or a `name`.
pub fn note_name(attr : String, value : String) -> Unit {
  let l = attr.length()
  if l == 2 && attr == "id" {
    dom_counters.id_attr_adds += 1
    if GIVEN_NAMES.length() <= NAMES_CAP {
      GIVEN_NAMES.set(value, true)
    }
  } else if l == 4 && attr == "name" && GIVEN_NAMES.length() <= NAMES_CAP {
    GIVEN_NAMES.set(value, true)
  }
}

///| Whether an element anywhere could have `k` as its id or name.
pub fn maybe_named(k : String) -> Bool {
  GIVEN_NAMES.length() > NAMES_CAP || GIVEN_NAMES.contains(k)
}

pub fn id_attr_adds_count() -> Int {
  dom_counters.id_attr_adds
}

pub fn base_tag_adds_count() -> Int {
  dom_counters.base_tag_adds
}

pub fn svg_adds_count() -> Int {
  dom_counters.svg_adds
}

pub fn asset_adds_count() -> Int {
  dom_counters.asset_adds
}

pub fn class_attr_adds_count() -> Int {
  dom_counters.class_attr_adds
}

pub fn tree_changes_count() -> Int {
  dom_counters.tree_changes
}

pub fn bump_tree_changes() -> Unit {
  dom_counters.tree_changes += 1
}

let EMPTY_ATTRS : Array[Attr] = []
let EMPTY_CHILDREN : Array[Node] = []

pub fn empty_attrs() -> Array[Attr] {
  EMPTY_ATTRS
}

pub fn empty_children() -> Array[Node] {
  EMPTY_CHILDREN
}

pub fn Node::push_child(self : Node, c : Node) -> Unit {
  if self.children.length() == 0 {
    self.children = [c]
  } else {
    self.children.push(c)
  }
}

pub fn Node::clear_children(self : Node) -> Unit {
  if self.children.length() > 0 {
    self.children = EMPTY_CHILDREN
  }
}

pub fn Node::push_attr(self : Node, a : Attr) -> Unit {
  note_dom_attr(a.name, a.value)
  if self.attrs.length() == 0 {
    self.attrs = [a]
  } else {
    self.attrs.push(a)
  }
}

pub fn Node::clear_attrs(self : Node) -> Unit {
  if self.attrs.length() > 0 {
    self.attrs = EMPTY_ATTRS
  }
}

pub fn Node::new_full(
  kind : Kind,
  ns : Ns,
  tag : String,
  attrs : Array[Attr],
  data : String,
  of_template : Bool,
) -> Node {
  let alen = attrs.length()
  if alen > 0 {
    let mut ai = 0
    while ai < alen {
      note_dom_attr(attrs[ai].name, attrs[ai].value)
      ai = ai + 1
    }
  }
  if kind == Element {
    note_dom_element(ns, tag)
  }
  dom_counters.next_uid += 1
  let uid = dom_counters.next_uid
  Node::{
    kind: kind,
    ns: ns,
    tag: tag,
    attrs: if alen == 0 { EMPTY_ATTRS } else { attrs },
    data: data,
    public_id: None,
    system_id: None,
    parent: None,
    children: EMPTY_CHILDREN,
    template_content: None,
    of_template: of_template,
    shadow: None,
    host: None,
    value: None,
    checked: None,
    ns_uri: "",
    prefix: "",
    quirks: false,
    layout_id: -1,
    js_id: 0,
    pos: -1,
    uid: uid,
    wire_id: 0,
    src_url: None,
    natural: None,
    ever_styled: false,
    class_bloom_valid: false,
    class_bloom: 0L,
    class_val: "",
  }
}

pub fn Node::new(kind : Kind) -> Node {
  Node::new_full(kind, Html, "", EMPTY_ATTRS, "", false)
}

pub fn Node::element(ns : Ns, tag : String, attrs : Array[Attr]) -> Node {
  let alen = attrs.length()
  if alen > 0 {
    let mut ai = 0
    while ai < alen {
      note_dom_attr(attrs[ai].name, attrs[ai].value)
      ai = ai + 1
    }
  }
  note_dom_element(ns, tag)
  dom_counters.next_uid += 1
  Node::{
    kind: Element,
    ns: ns,
    tag: tag,
    attrs: if alen == 0 { EMPTY_ATTRS } else { attrs },
    data: "",
    public_id: None,
    system_id: None,
    parent: None,
    children: EMPTY_CHILDREN,
    template_content: None,
    of_template: false,
    shadow: None,
    host: None,
    value: None,
    checked: None,
    ns_uri: "",
    prefix: "",
    quirks: false,
    layout_id: -1,
    js_id: 0,
    pos: -1,
    uid: dom_counters.next_uid,
    wire_id: 0,
    src_url: None,
    natural: None,
    ever_styled: false,
    class_bloom_valid: false,
    class_bloom: 0L,
    class_val: "",
  }
}

pub fn Node::text(data : String) -> Node {
  dom_counters.next_uid += 1
  Node::{
    kind: Text,
    ns: Html,
    tag: "",
    attrs: EMPTY_ATTRS,
    data: data,
    public_id: None,
    system_id: None,
    parent: None,
    children: EMPTY_CHILDREN,
    template_content: None,
    of_template: false,
    shadow: None,
    host: None,
    value: None,
    checked: None,
    ns_uri: "",
    prefix: "",
    quirks: false,
    layout_id: -1,
    js_id: 0,
    pos: -1,
    uid: dom_counters.next_uid,
    wire_id: 0,
    src_url: None,
    natural: None,
    ever_styled: false,
    class_bloom_valid: false,
    class_bloom: 0L,
    class_val: "",
  }
}

pub fn Node::comment(data : String) -> Node {
  Node::new_full(Comment, Html, "", EMPTY_ATTRS, data, false)
}

pub fn Node::doctype(tag : String) -> Node {
  Node::new_full(Doctype, Html, tag, EMPTY_ATTRS, "", false)
}

pub fn Node::attr(self : Node, name : String) -> Option[String] {
  let attrs = self.attrs
  let n = attrs.length()
  let mut i = 0
  while i < n {
    let a = attrs[i]
    if a.prefix == "" && a.name == name {
      return Some(a.value)
    }
    i = i + 1
  }
  None
}

pub fn Node::invalidate_class(self : Node) -> Unit {
  self.class_bloom_valid = false
  self.class_bloom = 0L
  self.class_val = ""
}

fn is_ascii_ws(c : Int) -> Bool {
  c <= 32 && (c == 32 || (c >= 9 && c <= 13 && c != 11))
}

let CLASS_SINGLE_BIT : Int64 = 1L << 63

fn token_mask_slice(s : String, start : Int, end : Int) -> Int64 {
  let mut h1 = 5381
  let mut h2 = 0
  let mut i = start
  while i < end {
    let c = s.code_unit_at(i)
    h1 = ((h1 << 5) + h1) ^ c
    h2 = h2 * 31 + c
    i = i + 1
  }
  let b1 = h1 & 63
  let b2 = h2 & 63
  (1L << (if b1 == 63 { 0 } else { b1 })) | (1L << (if b2 == 63 { 1 } else { b2 }))
}

pub fn class_token_mask(tok : String) -> Int64 {
  let n = tok.length()
  if n == 0 {
    return 0L
  }
  token_mask_slice(tok, 0, n)
}

fn Node::ensure_class_cache(self : Node) -> Unit {
  if self.class_bloom_valid {
    return
  }
  self.class_bloom_valid = true
  if self.attrs.length() == 0 {
    self.class_bloom = 0L
    self.class_val = ""
    return
  }
  match self.attr("class") {
    None => {
      self.class_bloom = 0L
      self.class_val = ""
    }
    Some(cv) => {
      let n = cv.length()
      let mut mask = 0L
      let mut tok_count = 0
      let mut first_start = 0
      let mut first_end = 0
      let mut i = 0
      while i < n {
        while i < n && is_ascii_ws(cv.code_unit_at(i)) {
          i = i + 1
        }
        let start = i
        let mut h1 = 5381
        let mut h2 = 0
        while i < n {
          let c = cv.code_unit_at(i)
          if is_ascii_ws(c) {
            break
          }
          h1 = ((h1 << 5) + h1) ^ c
          h2 = h2 * 31 + c
          i = i + 1
        }
        if i > start {
          let b1 = h1 & 63
          let b2 = h2 & 63
          mask = mask | (1L << (if b1 == 63 { 0 } else { b1 })) | (1L << (if b2 == 63 { 1 } else { b2 }))
          if tok_count == 0 {
            first_start = start
            first_end = i
          }
          tok_count = tok_count + 1
        }
      }
      if tok_count == 0 {
        self.class_bloom = 0L
        self.class_val = ""
      } else if tok_count == 1 {
        self.class_bloom = mask | CLASS_SINGLE_BIT
        self.class_val = if first_start == 0 && first_end == n { cv } else { cv.slice(first_start, first_end) }
      } else {
        self.class_bloom = mask
        self.class_val = cv
      }
    }
  }
}

pub fn Node::has_class_masked(self : Node, tok : String, mask : Int64) -> Bool {
  let m = tok.length()
  if m == 0 {
    return false
  }
  if !self.class_bloom_valid {
    self.ensure_class_cache()
  }
  let bloom = self.class_bloom
  if (bloom & mask) != mask {
    return false
  }
  let cv = self.class_val
  if bloom < 0L {
    return cv == tok
  }
  let n = cv.length()
  if m > n {
    return false
  }
  let t0 = tok.code_unit_at(0)
  let mut i = 0
  while i < n {
    while i < n {
      let c = cv.code_unit_at(i)
      if c > 32 || (c != 32 && (c < 9 || c > 13 || c == 11)) {
        break
      }
      i = i + 1
    }
    let start = i
    while i < n {
      let c = cv.code_unit_at(i)
      if c <= 32 && (c == 32 || (c >= 9 && c <= 13 && c != 11)) {
        break
      }
      i = i + 1
    }
    if i - start == m && cv.code_unit_at(start) == t0 {
      let mut j = 1
      while j < m && cv.code_unit_at(start + j) == tok.code_unit_at(j) {
        j = j + 1
      }
      if j == m {
        return true
      }
    }
  }
  false
}

pub fn Node::has_class(self : Node, tok : String) -> Bool {
  let m = tok.length()
  if m == 0 {
    return false
  }
  if !self.class_bloom_valid {
    self.ensure_class_cache()
  }
  if self.class_bloom == 0L {
    return false
  }
  let mask = token_mask_slice(tok, 0, m)
  if (self.class_bloom & mask) != mask {
    return false
  }
  self.has_class_masked(tok, mask)
}

pub fn arr_remove_node(arr : Array[Node], idx : Int) -> Unit {
  let last = arr.length() - 1
  let mut i = idx
  while i < last {
    arr[i] = arr[i + 1]
    arr[i].pos = i
    i = i + 1
  }
  let _ = arr.pop()
}

pub fn arr_insert_node(arr : Array[Node], idx : Int, item : Node) -> Unit {
  arr.push(item)
  let mut i = arr.length() - 1
  while i > idx {
    arr[i] = arr[i - 1]
    arr[i].pos = i
    i = i - 1
  }
  arr[idx] = item
  item.pos = idx
}

fn index_of(parent : Node, child : Node) -> Int {
  let h = child.pos
  let k = parent.children
  if h >= 0 && h < k.length() && k[h].uid == child.uid {
    return h
  }
  let mut found = -1
  let mut i = 0
  let n = k.length()
  while i < n {
    let c = k[i]
    c.pos = i
    if found < 0 && c.uid == child.uid {
      found = i
    }
    i = i + 1
  }
  found
}

pub fn Node::index(self : Node) -> Int {
  match self.parent {
    None => -1
    Some(p) => index_of(p, self)
  }
}

pub fn held_in(r : Node) -> Bool {
  if r.js_id != 0 {
    return true
  }
  let mut i = 0
  let n = r.children.length()
  while i < n {
    let c = r.children[i]
    if c.js_id != 0 {
      return true
    }
    if c.children.length() > 0 || c.shadow.is_some() || c.template_content.is_some() {
      if held_in(c) {
        return true
      }
    }
    i = i + 1
  }
  match r.shadow {
    Some(sh) => if held_in(sh) { return true }
    None => ()
  }
  match r.template_content {
    Some(t) => if held_in(t) { return true }
    None => ()
  }
  false
}

fn cut_inner(x : Node) -> Unit {
  let kids = x.children
  let n = kids.length()
  let mut i = 0
  while i < n {
    let c = kids[i]
    if c.children.length() == 0 && c.shadow.is_none() && c.template_content.is_none() {
      c.parent = None
      if c.host is Some(_) {
        c.host = None
      }
    } else {
      cut_inner(c)
    }
    i = i + 1
  }
  if n > 0 {
    x.clear_children()
  }
  if x.parent is Some(_) {
    x.parent = None
  }
  if x.host is Some(_) {
    x.host = None
  }
  match x.shadow {
    Some(sh) => {
      x.shadow = None
      cut_inner(sh)
    }
    None => ()
  }
  match x.template_content {
    Some(t) => {
      x.template_content = None
      cut_inner(t)
    }
    None => ()
  }
}

/// Breaks every parent<->child, host<->shadow, and template_content link in an
/// already-detached subtree rooted at `r` without disturbing live document caches.
pub fn cut_detached(r : Node) -> Unit {
  cut_inner(r)
}

/// Breaks every parent<->child, host<->shadow, and template_content link in the
/// subtree rooted at `r` so Biased RC frees all nodes with zero reference cycles.
pub fn cut(r : Node) -> Unit {
  cut_inner(r)
  bump_tree_changes()
}

pub fn Node::detach(self : Node) -> Unit {
  match self.parent {
    Some(p) => {
      bump_tree_changes()
      let i = index_of(p, self)
      if i >= 0 {
        arr_remove_node(p.children, i)
      }
      self.parent = None
      self.pos = -1
    }
    None => ()
  }
}

///| Break internal DOM cycles (`parent`, `children`, `shadow`, `host`, `template_content`) for Biased RC cleanup.
pub fn drop_dom_tree(root : Node) -> Unit {
  let walk : Array[Node] = [root]
  while walk.length() > 0 {
    match walk.pop() {
      Some(n) => {
        n.parent = None
        n.host = None
        match n.shadow {
          Some(sh) => {
            n.shadow = None
            walk.push(sh)
          }
          None => ()
        }
        match n.template_content {
          Some(tc) => {
            n.template_content = None
            walk.push(tc)
          }
          None => ()
        }
        let mut i = 0
        while i < n.children.length() {
          walk.push(n.children[i])
          i += 1
        }
        n.clear_children()
      }
      None => break
    }
  }
}

pub fn Node::append(self : Node, child : Node) -> Unit {
  child.detach()
  child.parent = Some(self)
  child.pos = self.children.length()
  self.push_child(child)
  bump_tree_changes()
}

pub fn Node::append_fresh(self : Node, child : Node) -> Unit {
  child.parent = Some(self)
  child.pos = self.children.length()
  self.push_child(child)
  bump_tree_changes()
}

fn Node::append_parsed(self : Node, child : Node) -> Unit {
  child.parent = Some(self)
  child.pos = self.children.length()
  self.push_child(child)
}

pub fn Node::insert_before(
  self : Node,
  child : Node,
  before : Option[Node],
) -> Unit {
  match before {
    None => self.append(child)
    Some(b0) => {
      let b : Option[Node] = if b0.uid == child.uid {
        let i = index_of(self, child)
        if i >= 0 && i + 1 < self.children.length() {
          Some(self.children[i + 1])
        } else {
          None
        }
      } else {
        Some(b0)
      }
      child.detach()
      match b {
        Some(bn) => {
          let i = index_of(self, bn)
          if i >= 0 {
            child.parent = Some(self)
            arr_insert_node(self.children, i, child)
            bump_tree_changes()
          } else {
            self.append(child)
          }
        }
        None => self.append(child)
      }
    }
  }
}

pub fn attach_shadow_roots(n : Node) -> Unit {
  let mut i = 0
  while i < n.children.length() {
    let c = n.children[i]
    let mode_opt = c.attr("shadowrootmode")
    let is_dsd = c.kind == Element &&
    c.ns == Html &&
    c.tag == "template" &&
    n.kind == Element &&
    n.shadow.is_none() &&
    (match mode_opt {
      Some(m) => m == "open" || m == "closed"
      None => false
    })
    if is_dsd {
      match c.template_content {
        Some(root) => {
          root.data = ""
          root.push_attr(Attr::new("", "mode", mode_opt.unwrap_or("open"), ""))
          root.host = Some(n)
          n.shadow = Some(root)
          attach_shadow_roots(root)
        }
        None => ()
      }
      arr_remove_node(n.children, i)
      c.parent = None
      c.pos = -1
      bump_tree_changes()
      continue
    }
    attach_shadow_roots(c)
    match c.template_content {
      Some(t) => attach_shadow_roots(t)
      None => ()
    }
    i = i + 1
  }
}

pub fn select_options(sel : Node) -> Array[Node] {
  let opts : Array[Node] = []
  let mut i = 0
  while i < sel.children.length() {
    let c = sel.children[i]
    if c.kind == Element && c.tag == "option" {
      opts.push(c)
    } else if c.kind == Element && c.tag == "optgroup" {
      let mut j = 0
      while j < c.children.length() {
        let o = c.children[j]
        if o.kind == Element && o.tag == "option" {
          opts.push(o)
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  opts
}

pub fn option_chosen(o : Node) -> Bool {
  match o.checked {
    Some(v) => v
    None => o.attr("selected").is_some()
  }
}

pub fn chosen_option(sel : Node) -> Int {
  let opts = select_options(sel)
  let mut last = -1
  let mut i = 0
  while i < opts.length() {
    if option_chosen(opts[i]) {
      last = i
    }
    i = i + 1
  }
  if last >= 0 {
    return last
  }
  i = 0
  while i < opts.length() {
    let o = opts[i]
    let in_off_group = match o.parent {
      Some(g) => g.tag == "optgroup" && g.attr("disabled").is_some()
      None => false
    }
    if o.attr("disabled").is_none() && !in_off_group {
      return i
    }
    i = i + 1
  }
  -1
}

pub fn control_value(n : Node) -> String {
  match n.value {
    Some(v) => v
    None => {
      if n.tag == "textarea" {
        text_content(n)
      } else if n.tag == "select" {
        let opts = select_options(n)
        let idx = chosen_option(n)
        if idx >= 0 && idx < opts.length() {
          let o = opts[idx]
          o.attr("value").unwrap_or(text_content(o).trim())
        } else {
          ""
        }
      } else {
        n.attr("value").unwrap_or("")
      }
    }
  }
}

pub fn option_label(o : Node) -> String {
  match o.attr("label") {
    Some(l) => l
    None => {
      let s = text_content(o)
      let out = StringBuilder()
      let mut space = false
      let mut i = 0
      while i < s.length() {
        let b = s.code_unit_at(i)
        if b == 32 || b == 9 || b == 10 || b == 13 || b == 12 {
          space = true
          i = i + 1
        } else {
          if space && out.length() > 0 {
            out.write_char(' ')
          }
          space = false
          // Copy UTF-8 character intact
          let end = if b < 0x80 {
            i + 1
          } else if b < 0xE0 {
            i + 2
          } else if b < 0xF0 {
            i + 3
          } else {
            i + 4
          }
          let e = if end <= s.length() { end } else { s.length() }
          out.write_string(s.slice(i, e))
          i = e
        }
      }
      out.to_string()
    }
  }
}

pub fn select_label(sel : Node) -> String {
  let opts = select_options(sel)
  let idx = chosen_option(sel)
  if idx >= 0 && idx < opts.length() {
    option_label(opts[idx])
  } else {
    ""
  }
}

pub fn checked(n : Node) -> Bool {
  match n.checked {
    Some(v) => v
    None => n.attr("checked").is_some()
  }
}
