///| WHATWG HTML5 Tree Construction (§13.2.6).
///| 1:1 port of `client/src/html/tree.mbt`.

enum Mode {
  Initial
  BeforeHtml
  BeforeHead
  InHead
  InHeadNoscript
  AfterHead
  InBody
  TextMode
  InTable
  InTableText
  InCaption
  InColumnGroup
  InTableBody
  InRow
  InCell
  InTemplate
  AfterBody
  InFrameset
  AfterFrameset
  AfterAfterBody
  AfterAfterFrameset
}

enum Fmt {
  Marker
  Entry(Node, String, Array[Attr])
}

struct Builder {
  tok : Tokenizer
  doc : Node
  stack : Array[Node]
  mut mode : Mode
  mut original : Mode
  mut head : Option[Node]
  mut form : Option[Node]
  fmt : Array[Fmt]
  templates : Array[Mode]
  mut foster : Bool
  mut frameset_ok : Bool
  scripting : Bool
  context : Option[Node]
  table_chars : Array[Int]
  mut skip_newline : Bool
  mut text_node : Option[Node]
  mut text_buf : Option[StringBuilder]
  mut open_p : Int
  mut open_select : Int
  mut open_button : Int
  mut open_li : Int
  mut foreign_depth : Int
}

let TAGS_MATHML_TEXT_6 : Array[String] = ["mi", "mo", "mn", "ms", "mtext", "annotation-xml"]
let TAGS_MATHML_TEXT_5 : Array[String] = ["mi", "mo", "mn", "ms", "mtext"]
let TAGS_HEAD_VOID : Array[String] = ["base", "basefont", "bgsound", "link", "meta"]
let TAGS_HEAD_NOSCRIPT : Array[String] = ["basefont", "bgsound", "link", "meta", "noframes", "style"]
let TAGS_IN_HEAD_START : Array[String] = ["base", "basefont", "bgsound", "link", "meta", "noframes", "script", "style", "template", "title"]
let TAGS_TABLE_END_IGNORE : Array[String] = ["body", "caption", "col", "colgroup", "html", "tbody", "td", "tfoot", "th", "thead", "tr"]
let TAGS_CAPTION_END_IGNORE : Array[String] = ["body", "col", "colgroup", "html", "tbody", "td", "tfoot", "th", "thead", "tr"]
let TAGS_CAPTION_START_CLOSE : Array[String] = ["caption", "col", "colgroup", "tbody", "td", "tfoot", "th", "thead", "tr"]
let TAGS_TBODY_START_CLOSE : Array[String] = ["caption", "col", "colgroup", "tbody", "tfoot", "thead"]
let TAGS_TBODY_END_IGNORE : Array[String] = ["body", "caption", "col", "colgroup", "html", "td", "th", "tr"]
let TAGS_TR_START_CLOSE : Array[String] = ["caption", "col", "colgroup", "tbody", "tfoot", "thead", "tr"]
let TAGS_TR_END_IGNORE : Array[String] = ["body", "caption", "col", "colgroup", "html", "td", "th"]
let TAGS_CELL_END_IGNORE : Array[String] = ["body", "caption", "col", "colgroup", "html"]
let TAGS_CELL_END_CLOSE : Array[String] = ["table", "tbody", "tfoot", "thead", "tr"]
let TAGS_TEMPLATE_TABLE : Array[String] = ["caption", "colgroup", "tbody", "tfoot", "thead"]
let TAGS_FOSTER_TARGETS : Array[String] = ["table", "tbody", "tfoot", "thead", "tr"]
let TAGS_IMPLIED_ALL : Array[String] = [
  "caption", "colgroup", "dd", "dt", "li", "optgroup", "option", "p", "rb",
  "rp", "rt", "rtc", "tbody", "td", "tfoot", "th", "thead", "tr",
]
let TAGS_TABLE_CTX : Array[String] = ["table", "template", "html"]
let TAGS_TABLE_TEXT_CUR : Array[String] = ["table", "tbody", "template", "tfoot", "thead", "tr"]
let TAGS_FRAG_RAWTEXT : Array[String] = ["style", "xmp", "iframe", "noembed", "noframes"]

fn is_scope_html_tag(tag : String) -> Bool {
  let l = tag.length()
  if l == 2 {
    tag == "td" || tag == "th"
  } else if l == 4 {
    tag == "html"
  } else if l == 5 {
    tag == "table"
  } else if l == 6 {
    let c = tag.code_unit_at(0)
    if c == 97 { tag == "applet" }
    else if c == 111 { tag == "object" }
    else if c == 115 { tag == "select" }
    else { false }
  } else if l == 7 {
    tag == "caption" || tag == "marquee"
  } else if l == 8 {
    tag == "template"
  } else {
    false
  }
}

fn is_implied_html_tag(tag : String) -> Bool {
  let l = tag.length()
  if l == 1 {
    tag == "p"
  } else if l == 2 {
    let c = tag.code_unit_at(0)
    if c == 100 { tag == "dd" || tag == "dt" }
    else if c == 108 { tag == "li" }
    else if c == 114 { tag == "rb" || tag == "rp" || tag == "rt" }
    else { false }
  } else if l == 3 {
    tag == "rtc"
  } else if l == 6 {
    tag == "option"
  } else if l == 8 {
    tag == "optgroup"
  } else {
    false
  }
}

fn is_special_html_tag(tag : String) -> Bool {
  let l = tag.length()
  if l == 1 {
    tag == "p"
  } else if l == 2 {
    let c = tag.code_unit_at(0)
    if c == 104 { tag == "h1" || tag == "h2" || tag == "h3" || tag == "h4" || tag == "h5" || tag == "h6" || tag == "hr" }
    else if c == 116 { tag == "td" || tag == "th" || tag == "tr" }
    else if c == 100 { tag == "dd" || tag == "dl" || tag == "dt" }
    else if c == 108 { tag == "li" }
    else if c == 117 { tag == "ul" }
    else if c == 111 { tag == "ol" }
    else if c == 98 { tag == "br" }
    else { false }
  } else if l == 3 {
    let c = tag.code_unit_at(0)
    if c == 100 { tag == "div" || tag == "dir" }
    else if c == 99 { tag == "col" }
    else if c == 105 { tag == "img" }
    else if c == 110 { tag == "nav" }
    else if c == 112 { tag == "pre" }
    else if c == 119 { tag == "wbr" }
    else if c == 120 { tag == "xmp" }
    else { false }
  } else if l == 4 {
    let c = tag.code_unit_at(0)
    if c == 104 { tag == "html" || tag == "head" }
    else if c == 98 { tag == "body" || tag == "base" }
    else if c == 109 { tag == "main" || tag == "menu" || tag == "meta" }
    else if c == 102 { tag == "form" }
    else if c == 108 { tag == "link" }
    else if c == 97 { tag == "area" }
    else { false }
  } else if l == 5 {
    let c = tag.code_unit_at(0)
    if c == 116 { tag == "table" || tag == "tbody" || tag == "tfoot" || tag == "thead" || tag == "title" || tag == "track" }
    else if c == 105 { tag == "input" }
    else if c == 115 { tag == "style" }
    else if c == 97 { tag == "aside" }
    else if c == 101 { tag == "embed" }
    else if c == 102 { tag == "frame" }
    else if c == 112 { tag == "param" }
    else { false }
  } else if l == 6 {
    let c = tag.code_unit_at(0)
    if c == 115 { tag == "script" || tag == "search" || tag == "select" || tag == "source" }
    else if c == 102 { tag == "figure" || tag == "footer" }
    else if c == 104 { tag == "header" || tag == "hgroup" }
    else if c == 98 { tag == "button" }
    else if c == 97 { tag == "applet" }
    else if c == 99 { tag == "center" }
    else if c == 105 { tag == "iframe" }
    else if c == 107 { tag == "keygen" }
    else if c == 111 { tag == "object" }
    else { false }
  } else if l == 7 {
    let c = tag.code_unit_at(0)
    if c == 97 { tag == "address" || tag == "article" }
    else if c == 115 { tag == "section" || tag == "summary" }
    else if c == 98 { tag == "bgsound" }
    else if c == 99 { tag == "caption" }
    else if c == 100 { tag == "details" }
    else if c == 108 { tag == "listing" }
    else if c == 109 { tag == "marquee" }
    else if c == 110 { tag == "noembed" }
    else { false }
  } else if l == 8 {
    let c = tag.code_unit_at(0)
    if c == 110 { tag == "noframes" || tag == "noscript" }
    else if c == 116 { tag == "template" || tag == "textarea" }
    else if c == 102 { tag == "fieldset" || tag == "frameset" }
    else if c == 98 { tag == "basefont" }
    else if c == 99 { tag == "colgroup" }
    else { false }
  } else if l == 9 {
    tag == "plaintext"
  } else if l == 10 {
    tag == "blockquote" || tag == "figcaption"
  } else {
    false
  }
}

fn str_in(s : String, tags : Array[String]) -> Bool {
  let mut i = 0
  while i < tags.length() {
    if tags[i] == s {
      return true
    }
    i = i + 1
  }
  false
}

fn is_html(n : Node, tag : String) -> Bool {
  n.ns == Html && n.tag == tag
}

fn html_in(n : Node, tags : Array[String]) -> Bool {
  n.ns == Html && str_in(n.tag, tags)
}

fn is_ws_cp(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 12 || c == 13
}

fn arr_remove_fmt(arr : Array[Fmt], idx : Int) -> Unit {
  let last = arr.length() - 1
  let mut i = idx
  while i < last {
    arr[i] = arr[i + 1]
    i = i + 1
  }
  let _ = arr.pop()
}

fn arr_insert_fmt(arr : Array[Fmt], idx : Int, item : Fmt) -> Unit {
  arr.push(item)
  let mut i = arr.length() - 1
  while i > idx {
    arr[i] = arr[i - 1]
    i = i - 1
  }
  arr[idx] = item
}

fn stack_remove_at(arr : Array[Node], idx : Int) -> Unit {
  let last = arr.length() - 1
  let mut i = idx
  while i < last {
    arr[i] = arr[i + 1]
    i = i + 1
  }
  let _ = arr.pop()
}

fn stack_insert_at(arr : Array[Node], idx : Int, item : Node) -> Unit {
  arr.push(item)
  let mut i = arr.length() - 1
  while i > idx {
    arr[i] = arr[i - 1]
    i = i - 1
  }
  arr[idx] = item
}

fn Builder::current(self : Builder) -> Node {
  self.stack[self.stack.length() - 1]
}

fn Builder::adjusted(self : Builder) -> Option[Node] {
  match self.context {
    Some(c) => {
      if self.stack.length() == 1 {
        return Some(c)
      }
      if self.stack.length() > 0 {
        Some(self.stack[self.stack.length() - 1])
      } else {
        None
      }
    }
    None => {
      if self.stack.length() > 0 {
        Some(self.stack[self.stack.length() - 1])
      } else {
        None
      }
    }
  }
}

fn clone_attrs(a : Array[Attr]) -> Array[Attr] {
  let out : Array[Attr] = []
  let mut i = 0
  while i < a.length() {
    let x = a[i]
    out.push(Attr::new(x.prefix, x.name, x.value, x.ns))
    i = i + 1
  }
  out
}

fn stack_has_html(stack : Array[Node], tag : String) -> Bool {
  let mut i = 0
  while i < stack.length() {
    if is_html(stack[i], tag) {
      return true
    }
    i = i + 1
  }
  false
}

struct Place {
  parent : Node
  before : Option[Node]
}

fn Builder::place(self : Builder, target : Node) -> Place {
  if self.foster &&
  html_in(target, TAGS_FOSTER_TARGETS) {
    let mut last_template = -1
    let mut last_table = -1
    let mut i = 0
    while i < self.stack.length() {
      let n = self.stack[i]
      if is_html(n, "template") {
        last_template = i
      }
      if is_html(n, "table") {
        last_table = i
      }
      i = i + 1
    }
    if last_template >= 0 && (last_table < 0 || last_template > last_table) {
      match self.stack[last_template].get_template_content() {
        Some(tc) => return Place::{ parent: tc, before: None }
        None => ()
      }
    }
    if last_table < 0 {
      return Place::{ parent: self.stack[0], before: None }
    }
    let table = self.stack[last_table]
    match table.parent {
      Some(p) => return Place::{ parent: p, before: Some(table) }
      None => return Place::{ parent: self.stack[last_table - 1], before: None }
    }
  }
  if is_html(target, "template") {
    match target.get_template_content() {
      Some(tc) => return Place::{ parent: tc, before: None }
      None => ()
    }
  }
  Place::{ parent: target, before: None }
}

fn Builder::insert_at(self : Builder, n : Node, at : Place) -> Unit {
  let _ = self
  at.parent.insert_before(n, at.before)
}

fn new_element(ns : Ns, name : String, attrs : Array[Attr]) -> Node {
  let n = Node::element(ns, name, attrs)
  if ns == Html && name.length() == 8 && name == "template" {
    n.set_template_content(Some(Node::new_full(Fragment, Html, "", EMPTY_ATTRS, "", true)))
  }
  n
}

fn Builder::count_open(self : Builder, n : Node, delta : Int) -> Unit {
  if n.ns == Html {
    let l = n.tag.length()
    if l == 1 {
      if n.tag == "p" {
        self.open_p = self.open_p + delta
      }
    } else if l == 2 {
      if n.tag == "li" {
        self.open_li = self.open_li + delta
      }
    } else if l == 6 {
      if n.tag == "select" {
        self.open_select = self.open_select + delta
      } else if n.tag == "button" {
        self.open_button = self.open_button + delta
      }
    }
  } else {
    self.foreign_depth = self.foreign_depth + delta
  }
}

fn Builder::push_open(self : Builder, n : Node) -> Unit {
  self.stack.push(n)
  self.count_open(n, 1)
}

fn Builder::pop_open(self : Builder) -> Option[Node] {
  match self.stack.pop() {
    Some(n) => {
      self.count_open(n, -1)
      Some(n)
    }
    None => None
  }
}

fn Builder::remove_open_at(self : Builder, idx : Int) -> Unit {
  let n = self.stack[idx]
  stack_remove_at(self.stack, idx)
  self.count_open(n, -1)
}

fn Builder::adjusted_is_html(self : Builder) -> Bool {
  if self.foreign_depth == 0 {
    return true
  }
  match self.context {
    Some(c) => {
      if self.stack.length() == 1 {
        return c.ns == Html
      }
      if self.stack.length() > 0 {
        self.stack[self.stack.length() - 1].ns == Html
      } else {
        true
      }
    }
    None => {
      if self.stack.length() > 0 {
        self.stack[self.stack.length() - 1].ns == Html
      } else {
        true
      }
    }
  }
}

fn Builder::insert_element_ns(
  self : Builder,
  name : String,
  attrs : Array[Attr],
  ns : Ns,
) -> Node {
  let n = new_element(ns, name, attrs)
  if !self.foster {
    let target = self.current()
    if !(target.ns == Html && target.tag.length() == 8 && target.tag == "template") {
      target.append_parsed(n)
      self.push_open(n)
      return n
    }
  }
  self.insert_at(n, self.place(self.current()))
  self.push_open(n)
  n
}

fn Builder::insert_element(
  self : Builder,
  name : String,
  attrs : Array[Attr],
) -> Node {
  self.insert_element_ns(name, attrs, Html)
}

fn Builder::tbuf(self : Builder) -> StringBuilder {
  match self.text_buf {
    Some(sb) => sb
    None => {
      let sb = StringBuilder()
      self.text_buf = Some(sb)
      sb
    }
  }
}

fn Builder::flush_text(self : Builder) -> Unit {
  match self.text_node {
    Some(t) => {
      match self.text_buf {
        Some(sb) => {
          t.data = sb.to_string()
          sb.reset()
        }
        None => t.data = ""
      }
      self.text_node = None
    }
    None => ()
  }
}

fn Builder::insert_char(self : Builder, c : Int) -> Unit {
  if !self.foster {
    let target = self.current()
    if target.kind != Document && !(target.ns == Html && target.tag == "template") {
      match self.text_node {
        Some(n) => {
          let clen = target.children.length()
          if clen > 0 && target.children[clen - 1].uid == n.uid {
            self.tbuf().write_char(c.unsafe_to_char())
            return
          }
        }
        None => ()
      }
      self.flush_text()
      let ch = c.unsafe_to_char()
      let clen = target.children.length()
      if clen > 0 && target.children[clen - 1].kind == Text {
        let t = target.children[clen - 1]
        self.text_node = Some(t)
        let tb = self.tbuf()
        tb.reset()
        tb.write_string(t.data)
        tb.write_char(ch)
        return
      }
      let t = Node::text("")
      target.append_fresh(t)
      self.text_node = Some(t)
      let tb = self.tbuf()
      tb.reset()
      tb.write_char(ch)
      return
    }
  }
  let pl = self.place(self.current())
  let p = pl.parent
  let before = pl.before
  if p.kind == Document {
    return
  }
  let prev : Option[Node] = match before {
    Some(b) => {
      let i = index_of(p, b)
      if i > 0 {
        Some(p.children[i - 1])
      } else {
        None
      }
    }
    None => {
      if p.children.length() > 0 {
        Some(p.children[p.children.length() - 1])
      } else {
        None
      }
    }
  }
  let ch = c.unsafe_to_char()
  match prev {
    Some(t) => {
      if t.kind == Text {
        match self.text_node {
          Some(n) => {
            if n.uid == t.uid {
              self.tbuf().write_char(ch)
              return
            }
          }
          None => ()
        }
        self.flush_text()
        self.text_node = Some(t)
        let tb = self.tbuf()
        tb.write_string(t.data)
        tb.write_char(ch)
        return
      }
    }
    None => ()
  }
  self.flush_text()
  let t = Node::text("")
  p.insert_before(t, before)
  self.text_node = Some(t)
  self.tbuf().write_char(ch)
}

fn comment_node(d : String) -> Node {
  if d.length() > 0 && d.code_unit_at(0) == 0 {
    let mut k = 1
    while k < d.length() {
      if d.code_unit_at(k) == 1 {
        return Node::new_full(
          Comment,
          Html,
          d.slice(1, k),
          [],
          d.slice(k + 1, d.length()),
          false,
        )
      }
      k = k + 1
    }
  }
  Node::comment(d)
}

fn Builder::insert_comment(self : Builder, data : String) -> Unit {
  let n = comment_node(data)
  self.insert_at(n, self.place(self.current()))
}

let SCOPE_HTML : Array[String] = [
  "applet", "caption", "html", "table", "td", "th", "marquee", "object",
  "select", "template",
]

fn scope_marker(n : Node) -> Bool {
  match n.ns {
    Html => is_scope_html_tag(n.tag)
    MathMl => str_in(n.tag, TAGS_MATHML_TEXT_6)
    Svg => (n.tag == "foreignObject" || n.tag == "desc" || n.tag == "title")
    Other => false
  }
}

fn Builder::in_scope_by(
  self : Builder,
  tags : Array[String],
  stop : (Node) -> Bool,
) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if html_in(n, tags) {
      return true
    }
    if stop(n) {
      return false
    }
    i = i - 1
  }
  false
}

let TABLE_SCOPE_MARKERS : Array[String] = ["html", "table", "template"]

fn Builder::in_scope(self : Builder, tag : String) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if is_html(n, tag) {
      return true
    }
    if scope_marker(n) {
      return false
    }
    i = i - 1
  }
  false
}

fn Builder::any_in_scope(self : Builder, tags : Array[String]) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if html_in(n, tags) {
      return true
    }
    if scope_marker(n) {
      return false
    }
    i = i - 1
  }
  false
}

fn Builder::in_button_scope(self : Builder, tag : String) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if is_html(n, tag) {
      return true
    }
    if scope_marker(n) || is_html(n, "button") {
      return false
    }
    i = i - 1
  }
  false
}

fn Builder::in_list_scope(self : Builder, tag : String) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if is_html(n, tag) {
      return true
    }
    if scope_marker(n) || is_html(n, "ol") || is_html(n, "ul") {
      return false
    }
    i = i - 1
  }
  false
}

fn Builder::in_table_scope(self : Builder, tags : Array[String]) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if html_in(n, tags) {
      return true
    }
    if html_in(n, TABLE_SCOPE_MARKERS) {
      return false
    }
    i = i - 1
  }
  false
}

let IMPLIED_TAGS : Array[String] = [
  "dd", "dt", "li", "optgroup", "option", "p", "rb", "rp", "rt", "rtc",
]

fn Builder::end_implied(self : Builder, except : String) -> Unit {
  while true {
    let cur = self.current()
    if cur.ns == Html && is_implied_html_tag(cur.tag) && cur.tag != except {
      let _ = self.pop_open()
    } else {
      break
    }
  }
}

fn Builder::end_implied_all(self : Builder) -> Unit {
  while html_in(self.current(), TAGS_IMPLIED_ALL) {
    let _ = self.pop_open()
  }
}

fn Builder::pop_until(self : Builder, tag : String) -> Unit {
  while self.stack.length() > 0 {
    match self.pop_open() {
      Some(n) => {
        if is_html(n, tag) {
          break
        }
      }
      None => break
    }
  }
}

fn Builder::pop_until_any(self : Builder, tags : Array[String]) -> Unit {
  while self.stack.length() > 0 {
    match self.pop_open() {
      Some(n) => {
        if html_in(n, tags) {
          break
        }
      }
      None => break
    }
  }
}

fn Builder::remove(self : Builder, n : Node) -> Unit {
  let mut i = 0
  while i < self.stack.length() {
    if self.stack[i].uid == n.uid {
      self.remove_open_at(i)
      return
    }
    i = i + 1
  }
}

fn Builder::stack_index(self : Builder, n : Node) -> Int {
  let mut i = 0
  while i < self.stack.length() {
    if self.stack[i].uid == n.uid {
      return i
    }
    i = i + 1
  }
  -1
}

fn Builder::close_p(self : Builder) -> Unit {
  self.end_implied("p")
  self.pop_until("p")
}

fn Builder::close_p_in_button(self : Builder) -> Unit {
  if self.open_p == 0 {
    return
  }
  if self.in_button_scope("p") {
    self.close_p()
  }
}

fn Builder::clear_to(self : Builder, tags : Array[String]) -> Unit {
  while !html_in(self.current(), tags) {
    let _ = self.pop_open()
  }
}

fn Builder::text_element(
  self : Builder,
  name : String,
  attrs : Array[Attr],
  state : State,
) -> Unit {
  let _ = self.insert_element(name, attrs)
  self.tok.state = state
  self.original = self.mode
  self.mode = TextMode
}

fn Builder::fmt_index(self : Builder, n : Node) -> Int {
  let mut i = 0
  while i < self.fmt.length() {
    match self.fmt[i] {
      Entry(x, _, _) => {
        if x.uid == n.uid {
          return i
        }
      }
      Marker => ()
    }
    i = i + 1
  }
  -1
}

fn attrs_equal_set(at : Array[Attr], attrs : Array[Attr]) -> Bool {
  if at.length() != attrs.length() {
    return false
  }
  let mut i = 0
  while i < at.length() {
    let a = at[i]
    let mut found = false
    let mut j = 0
    while j < attrs.length() {
      let b = attrs[j]
      if a.name == b.name && a.value == b.value && a.prefix == b.prefix {
        found = true
        break
      }
      j = j + 1
    }
    if !found {
      return false
    }
    i = i + 1
  }
  true
}

fn Builder::push_fmt(
  self : Builder,
  n : Node,
  name : String,
  attrs : Array[Attr],
) -> Unit {
  let mut same = 0
  let mut i = self.fmt.length() - 1
  let mut first = -1
  while i >= 0 {
    match self.fmt[i] {
      Marker => break
      Entry(_, nm, at) => {
        if nm == name && attrs_equal_set(at, attrs) {
          same = same + 1
          first = i
        }
      }
    }
    i = i - 1
  }
  if same >= 3 {
    arr_remove_fmt(self.fmt, first)
  }
  self.fmt.push(Entry(n, name, clone_attrs(attrs)))
}

fn Builder::fmt_on_stack(self : Builder, e : Fmt) -> Bool {
  match e {
    Marker => true
    Entry(n, _, _) => self.stack_index(n) >= 0
  }
}

fn Builder::reconstruct(self : Builder) -> Unit {
  let len = self.fmt.length()
  if len == 0 {
    return
  }
  if self.fmt_on_stack(self.fmt[len - 1]) {
    return
  }
  let mut i = len - 1
  while i > 0 && !self.fmt_on_stack(self.fmt[i - 1]) {
    i = i - 1
  }
  while i < len {
    match self.fmt[i] {
      Entry(_, name, attrs) => {
        let n = self.insert_element(name, clone_attrs(attrs))
        self.fmt[i] = Entry(n, name, attrs)
      }
      Marker => ()
    }
    i = i + 1
  }
}

fn Builder::clear_fmt_to_marker(self : Builder) -> Unit {
  while self.fmt.length() > 0 {
    match self.fmt.pop() {
      None => break
      Some(Marker) => break
      Some(_) => ()
    }
  }
}

fn Builder::fmt_after_marker(self : Builder, tag : String) -> Option[Node] {
  let mut i = self.fmt.length() - 1
  while i >= 0 {
    match self.fmt[i] {
      Marker => return None
      Entry(n, name, _) => {
        if name == tag {
          return Some(n)
        }
      }
    }
    i = i - 1
  }
  None
}

let SPECIAL_HTML : Array[String] = [
  "address", "applet", "area", "article", "aside", "base", "basefont",
  "bgsound", "blockquote", "body", "br", "button", "caption", "center", "col",
  "colgroup", "dd", "details", "dir", "div", "dl", "dt", "embed", "fieldset",
  "figcaption", "figure", "footer", "form", "frame", "frameset", "h1", "h2",
  "h3", "h4", "h5", "h6", "head", "header", "hgroup", "hr", "html", "iframe",
  "img", "input", "keygen", "li", "link", "listing", "main", "marquee", "menu",
  "meta", "nav", "noembed", "noframes", "noscript", "object", "ol", "p",
  "param", "plaintext", "pre", "script", "search", "section", "select",
  "source", "style", "summary", "table", "tbody", "td", "template", "textarea",
  "tfoot", "th", "thead", "title", "tr", "track", "ul", "wbr", "xmp",
]

fn special(n : Node) -> Bool {
  match n.ns {
    Html => is_special_html_tag(n.tag)
    MathMl => str_in(n.tag, TAGS_MATHML_TEXT_6)
    Svg => (n.tag == "foreignObject" || n.tag == "desc" || n.tag == "title")
    Other => false
  }
}

fn Builder::in_scope_node(self : Builder, target : Node) -> Bool {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if n.uid == target.uid {
      return true
    }
    if scope_marker(n) {
      return false
    }
    i = i - 1
  }
  false
}

fn Builder::adoption(self : Builder, subject : String) -> Bool {
  let cur = self.current()
  if is_html(cur, subject) && self.fmt_index(cur) < 0 {
    let _ = self.pop_open()
    return true
  }
  let mut outer = 0
  while outer < 8 {
    let fe = match self.fmt_after_marker(subject) {
      None => return false
      Some(n) => n
    }
    let fe_stack = self.stack_index(fe)
    if fe_stack < 0 {
      arr_remove_fmt(self.fmt, self.fmt_index(fe))
      return true
    }
    if !self.in_scope_node(fe) {
      return true
    }
    let mut furthest : Option[Node] = None
    let mut i = fe_stack + 1
    while i < self.stack.length() {
      if special(self.stack[i]) {
        furthest = Some(self.stack[i])
        break
      }
      i = i + 1
    }
    let fb = match furthest {
      None => {
        while self.stack.length() > fe_stack {
          let _ = self.pop_open()
        }
        arr_remove_fmt(self.fmt, self.fmt_index(fe))
        return true
      }
      Some(n) => n
    }
    let common = self.stack[fe_stack - 1]
    let mut bookmark = self.fmt_index(fe)
    let mut node = fb
    let mut last = fb
    let mut inner = 0
    let mut idx = self.stack_index(fb)
    while true {
      inner = inner + 1
      idx = idx - 1
      node = self.stack[idx]
      if node.uid == fe.uid {
        break
      }
      let fi = self.fmt_index(node)
      if inner > 3 && fi >= 0 {
        arr_remove_fmt(self.fmt, fi)
        if fi < bookmark {
          bookmark = bookmark - 1
        }
      }
      let fi2 = self.fmt_index(node)
      if fi2 < 0 {
        self.remove_open_at(idx)
        continue
      }
      match self.fmt[fi2] {
        Entry(_, name, attrs) => {
          let copy = new_element(Html, name, clone_attrs(attrs))
          self.fmt[fi2] = Entry(copy, name, attrs)
          self.stack[idx] = copy
          node = copy
          if last.uid == fb.uid {
            bookmark = fi2 + 1
          }
          node.append(last)
          last = node
        }
        Marker => panic("adoption: unexpected marker")
      }
    }
    self.insert_at(last, self.place(common))
    let fe_fi = self.fmt_index(fe)
    match self.fmt[fe_fi] {
      Entry(_, name, attrs) => {
        let copy = new_element(Html, name, clone_attrs(attrs))
        let fb_children = fb.children.copy()
        let mut ci = 0
        while ci < fb_children.length() {
          copy.append(fb_children[ci])
          ci = ci + 1
        }
        fb.append(copy)
        arr_remove_fmt(self.fmt, fe_fi)
        if fe_fi < bookmark {
          bookmark = bookmark - 1
        }
        arr_insert_fmt(self.fmt, bookmark, Entry(copy, name, attrs))
        self.remove(fe)
        stack_insert_at(self.stack, self.stack_index(fb) + 1, copy)
      }
      Marker => panic("adoption: unexpected marker for fe")
    }
    outer = outer + 1
  }
  true
}

fn Builder::reset_mode(self : Builder) -> Unit {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let last = i == 0
    let n = if last {
      match self.context {
        Some(c) => c
        None => self.stack[i]
      }
    } else {
      self.stack[i]
    }
    if n.ns == Html {
      if (n.tag == "td" || n.tag == "th") && !last {
        self.mode = InCell
        return
      } else if n.tag == "tr" {
        self.mode = InRow
        return
      } else if n.tag == "tbody" || n.tag == "thead" || n.tag == "tfoot" {
        self.mode = InTableBody
        return
      } else if n.tag == "caption" {
        self.mode = InCaption
        return
      } else if n.tag == "colgroup" {
        self.mode = InColumnGroup
        return
      } else if n.tag == "table" {
        self.mode = InTable
        return
      } else if n.tag == "template" {
        self.mode = self.templates[self.templates.length() - 1]
        return
      } else if n.tag == "head" && !last {
        self.mode = InHead
        return
      } else if n.tag == "body" {
        self.mode = InBody
        return
      } else if n.tag == "frameset" {
        self.mode = InFrameset
        return
      } else if n.tag == "html" {
        self.mode = match self.head {
          None => BeforeHead
          Some(_) => AfterHead
        }
        return
      }
    }
    if last {
      self.mode = InBody
      return
    }
    i = i - 1
  }
}

fn start_with_any(s : String, prefixes : Array[String]) -> Bool {
  let mut i = 0
  while i < prefixes.length() {
    if s.starts_with(prefixes[i]) {
      return true
    }
    i = i + 1
  }
  false
}

