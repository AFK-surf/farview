  "-//advasoft ltd//dtd html 3.0 aswedit + extensions//",
  "-//ietf//dtd html 2.0 level 1//", "-//ietf//dtd html 2.0 level 2//",
  "-//ietf//dtd html 2.0 strict level 1//",
  "-//ietf//dtd html 2.0 strict level 2//", "-//ietf//dtd html 2.0 strict//",
  "-//ietf//dtd html 2.0//", "-//ietf//dtd html 2.1e//",
  "-//ietf//dtd html 3.0//", "-//ietf//dtd html 3.2 final//",
  "-//ietf//dtd html 3.2//", "-//ietf//dtd html 3//",
  "-//ietf//dtd html level 0//", "-//ietf//dtd html level 1//",
  "-//ietf//dtd html level 2//", "-//ietf//dtd html level 3//",
  "-//ietf//dtd html strict level 0//", "-//ietf//dtd html strict level 1//",
  "-//ietf//dtd html strict level 2//", "-//ietf//dtd html strict level 3//",
  "-//ietf//dtd html strict//", "-//ietf//dtd html//",
  "-//metrius//dtd metrius presentational//",
  "-//microsoft//dtd internet explorer 2.0 html strict//",
  "-//microsoft//dtd internet explorer 2.0 html//",
  "-//microsoft//dtd internet explorer 2.0 tables//",
  "-//microsoft//dtd internet explorer 3.0 html strict//",
  "-//microsoft//dtd internet explorer 3.0 html//",
  "-//microsoft//dtd internet explorer 3.0 tables//",
  "-//netscape comm. corp.//dtd html//",
  "-//netscape comm. corp.//dtd strict html//",
  "-//o'reilly and associates//dtd html 2.0//",
  "-//o'reilly and associates//dtd html extended 1.0//",
  "-//o'reilly and associates//dtd html extended relaxed 1.0//",
  "-//sq//dtd html 2.0 hotmetal + extensions//",
  "-//softquad software//dtd hotmetal pro 6.0::19990601::extensions to html 4.0//",
  "-//softquad//dtd hotmetal pro 4.0::19971010::extensions to html 4.0//",
  "-//spyglass//dtd html 2.0 extended//",
  "-//sun microsystems corp.//dtd hotjava html//",
  "-//sun microsystems corp.//dtd hotjava strict html//",
  "-//w3c//dtd html 3 1995-03-24//", "-//w3c//dtd html 3.2 draft//",
  "-//w3c//dtd html 3.2 final//", "-//w3c//dtd html 3.2//",
  "-//w3c//dtd html 3.2s draft//", "-//w3c//dtd html 4.0 frameset//",
  "-//w3c//dtd html 4.0 transitional//",
  "-//w3c//dtd html experimental 19960712//",
  "-//w3c//dtd html experimental 970421//", "-//w3c//dtd w3 html//",
  "-//w3o//dtd w3 html 3.0//", "-//webtechs//dtd mozilla html 2.0//",
  "-//webtechs//dtd mozilla html//",
]

fn Builder::doctype(
  self : Builder,
  name : Option[String],
  public_id : Option[String],
  system_id : Option[String],
  force : Bool,
) -> Unit {
  let n = Node::doctype(name.unwrap_or(""))
  n.set_public_id(public_id)
  n.set_system_id(system_id)
  self.doc.append(n)
  let p = ascii_lower(public_id.unwrap_or(""))
  let s = ascii_lower(system_id.unwrap_or(""))
  let html4_tf = start_with_any(p, [
    "-//w3c//dtd html 4.01 frameset//", "-//w3c//dtd html 4.01 transitional//",
  ])
  let not_html = match name {
    Some(nm) => nm != "html"
    None => true
  }
  self.doc.set_quirks(
    force ||
    not_html ||
    p == "-//w3o//dtd w3 html strict 3.0//en//" ||
    p == "-/w3c/dtd html 4.0 transitional/en" ||
    p == "html" ||
    s == "http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd" ||
    start_with_any(p, QUIRKY_PUBLIC) ||
    (system_id.is_none() && html4_tf),
  )
}

fn Builder::initial(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        return
      }
      self.doc.set_quirks(true)
      self.mode = BeforeHtml
      self.process(t)
    }
    CommentToken(d) => self.doc.append(comment_node(d))
    DoctypeToken(name, public_id, system_id, force_quirks) => {
      self.doctype(name, public_id, system_id, force_quirks)
      self.mode = BeforeHtml
    }
    _ => {
      self.doc.set_quirks(true)
      self.mode = BeforeHtml
      self.process(t)
    }
  }
}

fn Builder::before_html(self : Builder, t : Token) -> Unit {
  match t {
    DoctypeToken(_, _, _, _) => ()
    CommentToken(d) => self.doc.append(comment_node(d))
    Character(c) => {
      if is_ws_cp(c) {
        return
      }
      let n = new_element(Html, "html", [])
      self.doc.append(n)
      self.push_open(n)
      self.mode = BeforeHead
      self.process(t)
    }
    StartTag(name, attrs, _) => {
      if name == "html" {
        let n = new_element(Html, "html", attrs)
        self.doc.append(n)
        self.push_open(n)
        self.mode = BeforeHead
      } else {
        let n = new_element(Html, "html", [])
        self.doc.append(n)
        self.push_open(n)
        self.mode = BeforeHead
        self.process(t)
      }
    }
    EndTag(nm) => {
      if !(nm == "head" || nm == "body" || nm == "html" || nm == "br") {
        return
      }
      let n = new_element(Html, "html", [])
      self.doc.append(n)
      self.push_open(n)
      self.mode = BeforeHead
      self.process(t)
    }
    Eof => {
      let n = new_element(Html, "html", [])
      self.doc.append(n)
      self.push_open(n)
      self.mode = BeforeHead
      self.process(t)
    }
  }
}

fn Builder::before_head(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        return
      }
      self.head = Some(self.insert_element("head", []))
      self.mode = InHead
      self.process(t)
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, _) => {
      if name == "html" {
        self.in_body(t)
      } else if name == "head" {
        self.head = Some(self.insert_element("head", attrs))
        self.mode = InHead
      } else {
        self.head = Some(self.insert_element("head", []))
        self.mode = InHead
        self.process(t)
      }
    }
    EndTag(nm) => {
      if !(nm == "head" || nm == "body" || nm == "html" || nm == "br") {
        return
      }
      self.head = Some(self.insert_element("head", []))
      self.mode = InHead
      self.process(t)
    }
    Eof => {
      self.head = Some(self.insert_element("head", []))
      self.mode = InHead
      self.process(t)
    }
  }
}

fn Builder::in_head(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        self.insert_char(c)
        return
      }
      let _ = self.pop_open()
      self.mode = AfterHead
      self.process(t)
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, _) => {
      if name == "html" {
        self.in_body(t)
      } else if str_in(name, TAGS_HEAD_VOID) {
        let _ = self.insert_element(name, attrs)
        let _ = self.pop_open()
      } else if name == "title" {
        self.text_element("title", attrs, Rcdata)
      } else if name == "noscript" && self.scripting {
        self.text_element("noscript", attrs, Rawtext)
      } else if name == "noframes" || name == "style" {
        self.text_element(name, attrs, Rawtext)
      } else if name == "noscript" {
        let _ = self.insert_element("noscript", attrs)
        self.mode = InHeadNoscript
      } else if name == "script" {
        self.text_element("script", attrs, ScriptData)
      } else if name == "template" {
        let _ = self.insert_element("template", attrs)
        self.fmt.push(Marker)
        self.frameset_ok = false
        self.mode = InTemplate
        self.templates.push(InTemplate)
      } else if name == "head" {
        ()
      } else {
        let _ = self.pop_open()
        self.mode = AfterHead
        self.process(t)
      }
    }
    EndTag(nm) => {
      if nm == "head" {
        let _ = self.pop_open()
        self.mode = AfterHead
      } else if nm == "body" || nm == "html" || nm == "br" {
        let _ = self.pop_open()
        self.mode = AfterHead
        self.process(t)
      } else if nm == "template" {
        if stack_has_html(self.stack, "template") {
          self.end_implied_all()
          self.pop_until("template")
          self.clear_fmt_to_marker()
          let _ = self.templates.pop()
          self.reset_mode()
        }
      }
    }
    Eof => {
      let _ = self.pop_open()
      self.mode = AfterHead
      self.process(t)
    }
  }
}

fn Builder::in_head_noscript(self : Builder, t : Token) -> Unit {
  match t {
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, _, _) => {
      if name == "html" {
        self.in_body(t)
      } else if str_in(name, TAGS_HEAD_NOSCRIPT) {
        self.in_head(t)
      } else if name == "head" || name == "noscript" {
        ()
      } else {
        let _ = self.pop_open()
        self.mode = InHead
        self.process(t)
      }
    }
    EndTag(nm) => {
      if nm == "noscript" {
        let _ = self.pop_open()
        self.mode = InHead
      } else if nm == "br" {
        let _ = self.pop_open()
        self.mode = InHead
        self.process(t)
      }
    }
    Character(c) => {
      if is_ws_cp(c) {
        self.in_head(t)
      } else {
        let _ = self.pop_open()
        self.mode = InHead
        self.process(t)
      }
    }
    CommentToken(_) => self.in_head(t)
    Eof => {
      let _ = self.pop_open()
      self.mode = InHead
      self.process(t)
    }
  }
}

fn Builder::after_head(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        self.insert_char(c)
        return
      }
      let _ = self.insert_element("body", [])
      self.mode = InBody
      self.process(t)
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, _) => {
      if name == "html" {
        self.in_body(t)
      } else if name == "body" {
        let _ = self.insert_element("body", attrs)
        self.frameset_ok = false
        self.mode = InBody
      } else if name == "frameset" {
        let _ = self.insert_element("frameset", attrs)
        self.mode = InFrameset
      } else if str_in(name, TAGS_IN_HEAD_START) {
        match self.head {
          Some(head) => {
            self.push_open(head)
            self.in_head(t)
            self.remove(head)
          }
          None => ()
        }
      } else if name == "head" {
        ()
      } else {
        let _ = self.insert_element("body", [])
        self.mode = InBody
        self.process(t)
      }
    }
    EndTag(nm) => {
      if nm == "template" {
        self.in_head(t)
      } else if nm == "body" || nm == "html" || nm == "br" {
        let _ = self.insert_element("body", [])
        self.mode = InBody
        self.process(t)
      }
    }
    Eof => {
      let _ = self.insert_element("body", [])
      self.mode = InBody
      self.process(t)
    }
  }
}

fn Builder::merge_attrs(self : Builder, n : Node, attrs : Array[Attr]) -> Unit {
  let _ = self
  let mut i = 0
  while i < attrs.length() {
    let a = attrs[i]
    let mut exists = false
    let mut j = 0
    while j < n.attrs.length() {
      if n.attrs[j].name == a.name {
        exists = true
        break
      }
      j = j + 1
    }
    if !exists {
      note_name(a.name, a.value)
      n.push_attr(a)
      if a.name == "class" {
        n.invalidate_class()
      }
    }
    i = i + 1
  }
}

fn Builder::any_other_end(self : Builder, name : String) -> Unit {
  let mut i = self.stack.length() - 1
  while i >= 0 {
    let n = self.stack[i]
    if is_html(n, name) {
      self.end_implied(name)
      while self.stack.length() > i {
        let _ = self.pop_open()
      }
      return
    }
    if special(n) {
      return
    }
    i = i - 1
  }
}

fn Builder::in_body(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if c == 0 {
        return
      }
      self.reconstruct()
      self.insert_char(c)
      if !is_ws_cp(c) {
        self.frameset_ok = false
      }
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, self_closing) => {
      self.in_body_start(t, name, attrs, self_closing)
    }
    EndTag(name) => self.in_body_end(name)
    Eof => {
      if self.templates.length() > 0 {
        self.in_template(t)
      }
    }
  }
}

fn has_hidden_type(attrs : Array[Attr]) -> Bool {
  let mut i = 0
  while i < attrs.length() {
    if attrs[i].name == "type" && ascii_lower(attrs[i].value) == "hidden" {
      return true
    }
    i = i + 1
  }
  false
}

fn Builder::fragment_of(self : Builder, tag : String) -> Bool {
  match self.context {
    Some(c) => is_html(c, tag)
    None => false
  }
}

let TAGS_BODY_HEAD : Array[String] = [
  "base", "basefont", "bgsound", "link", "meta", "noframes", "script",
  "style", "template", "title",
]
let TAGS_BODY_BLOCK : Array[String] = [
  "address", "article", "aside", "blockquote", "center", "details",
  "dialog", "dir", "div", "dl", "fieldset", "figcaption", "figure",
  "footer", "header", "hgroup", "main", "menu", "nav", "ol", "p", "search",
  "section", "summary", "ul",
]
let TAGS_HEADING : Array[String] = ["h1", "h2", "h3", "h4", "h5", "h6"]
let TAGS_ADDR_DIV_P : Array[String] = ["address", "div", "p"]
let TAGS_DD_DT : Array[String] = ["dd", "dt"]
let TAGS_FMT_START : Array[String] = [
  "b", "big", "code", "em", "font", "i", "s", "small", "strike", "strong",
  "tt", "u",
]
let TAGS_VOID_MEDIA : Array[String] = ["area", "br", "embed", "img", "keygen", "wbr"]
let TAGS_TABLE_IGNORE : Array[String] = [
  "caption", "col", "colgroup", "frame", "head", "tbody", "td", "tfoot",
  "th", "thead", "tr",
]
let TAGS_BODY_END_BLOCK : Array[String] = [
  "address", "article", "aside", "blockquote", "button", "center",
  "details", "dialog", "dir", "div", "dl", "fieldset", "figcaption",
  "figure", "footer", "header", "hgroup", "listing", "main", "menu", "nav",
  "ol", "pre", "search", "section", "select", "summary", "ul",
]
let TAGS_FMT_END : Array[String] = [
  "a", "b", "big", "code", "em", "font", "i", "nobr", "s", "small",
  "strike", "strong", "tt", "u",
]

fn Builder::in_body_start(
  self : Builder,
  t : Token,
  name : String,
  attrs : Array[Attr],
  self_closing : Bool,
) -> Unit {
  // Hot common-tag fast paths (avoids scanning rare-tag lists for 90%+ of real DOM tags)
  if name == "div" || name == "p" || name == "ul" || name == "section" ||
  name == "header" || name == "footer" || name == "nav" || name == "main" ||
  name == "article" || name == "aside" {
    self.close_p_in_button()
    let _ = self.insert_element(name, attrs)
    return
  }
  if name == "span" || name == "label" {
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    return
  }
  if name == "a" && self.fmt.length() == 0 {
    let n = self.insert_element("a", attrs)
    self.push_fmt(n, "a", attrs)
    return
  }
  if name == "li" {
    self.frameset_ok = false
    if self.open_li > 0 {
      let mut i = self.stack.length() - 1
      while i >= 0 {
        let n = self.stack[i]
        if is_html(n, "li") {
          self.end_implied("li")
          self.pop_until("li")
          break
        }
        if special(n) && !html_in(n, TAGS_ADDR_DIV_P) {
          break
        }
        i = i - 1
      }
    }
    self.close_p_in_button()
    let _ = self.insert_element("li", attrs)
    return
  }
  if name == "input" {
    if self.fragment_of("select") {
      return
    }
    if self.open_select > 0 && self.in_scope("select") {
      self.pop_until("select")
    }
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    let _ = self.pop_open()
    if !has_hidden_type(attrs) {
      self.frameset_ok = false
    }
    return
  }
  if name == "button" {
    if self.open_button > 0 && self.in_scope("button") {
      self.end_implied("")
      self.pop_until("button")
    }
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    self.frameset_ok = false
    return
  }
  if name == "html" {
    if !stack_has_html(self.stack, "template") {
      self.merge_attrs(self.stack[0], attrs)
    }
  } else if str_in(name, TAGS_BODY_HEAD) {
    self.in_head(t)
  } else if name == "body" {
    let second = self.stack.length() > 1 && is_html(self.stack[1], "body")
    if second && !stack_has_html(self.stack, "template") {
      self.frameset_ok = false
      self.merge_attrs(self.stack[1], attrs)
    }
  } else if name == "frameset" {
    let second = self.stack.length() > 1 && is_html(self.stack[1], "body")
    if second && self.frameset_ok {
      self.stack[1].detach()
      while self.stack.length() > 1 {
        let _ = self.pop_open()
      }
      let _ = self.insert_element("frameset", attrs)
      self.mode = InFrameset
    }
  } else if str_in(name, TAGS_BODY_BLOCK) {
    self.close_p_in_button()
    let _ = self.insert_element(name, attrs)
  } else if str_in(name, TAGS_HEADING) {
    self.close_p_in_button()
    if html_in(self.current(), TAGS_HEADING) {
      let _ = self.pop_open()
    }
    let _ = self.insert_element(name, attrs)
  } else if name == "pre" || name == "listing" {
    self.close_p_in_button()
    let _ = self.insert_element(name, attrs)
    self.skip_newline = true
    self.frameset_ok = false
  } else if name == "form" {
    let in_template = stack_has_html(self.stack, "template")
    if self.form.is_none() || in_template {
      self.close_p_in_button()
      let n = self.insert_element("form", attrs)
      if !in_template {
        self.form = Some(n)
      }
    }
  } else if name == "li" {
    self.frameset_ok = false
    let mut i = self.stack.length() - 1
    while i >= 0 {
      let n = self.stack[i]
      if is_html(n, "li") {
        self.end_implied("li")
        self.pop_until("li")
        break
      }
      if special(n) && !html_in(n, TAGS_ADDR_DIV_P) {
        break
      }
      i = i - 1
    }
    self.close_p_in_button()
    let _ = self.insert_element("li", attrs)
  } else if name == "dd" || name == "dt" {
    self.frameset_ok = false
    let mut i = self.stack.length() - 1
    while i >= 0 {
      let n = self.stack[i]
      if html_in(n, TAGS_DD_DT) {
        let tag = n.tag
        self.end_implied(tag)
        self.pop_until(tag)
        break
      }
      if special(n) && !html_in(n, TAGS_ADDR_DIV_P) {
        break
      }
      i = i - 1
    }
    self.close_p_in_button()
    let _ = self.insert_element(name, attrs)
  } else if name == "plaintext" {
    self.close_p_in_button()
    let _ = self.insert_element(name, attrs)
    self.tok.state = Plaintext
  } else if name == "button" {
    if self.in_scope("button") {
      self.end_implied("")
      self.pop_until("button")
    }
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    self.frameset_ok = false
  } else if name == "a" {
    match self.fmt_after_marker("a") {
      Some(n) => {
        if !self.adoption("a") {
          self.any_other_end("a")
        }
        let fi = self.fmt_index(n)
        if fi >= 0 {
          arr_remove_fmt(self.fmt, fi)
        }
        self.remove(n)
      }
      None => ()
    }
    self.reconstruct()
    let n = self.insert_element(name, attrs)
    self.push_fmt(n, name, attrs)
  } else if str_in(name, TAGS_FMT_START) {
    self.reconstruct()
    let n = self.insert_element(name, attrs)
    self.push_fmt(n, name, attrs)
  } else if name == "nobr" {
    self.reconstruct()
    if self.in_scope("nobr") {
      if !self.adoption("nobr") {
        self.any_other_end("nobr")
      }
      self.reconstruct()
    }
    let n = self.insert_element(name, attrs)
    self.push_fmt(n, name, attrs)
  } else if name == "applet" || name == "marquee" || name == "object" {
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    self.fmt.push(Marker)
    self.frameset_ok = false
  } else if name == "table" {
    if !self.doc.is_quirks() {
      self.close_p_in_button()
    }
    let _ = self.insert_element(name, attrs)
    self.frameset_ok = false
    self.mode = InTable
  } else if str_in(name, TAGS_VOID_MEDIA) {
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    let _ = self.pop_open()
    self.frameset_ok = false
  } else if name == "input" {
    if self.fragment_of("select") {
      return
    }
    if self.in_scope("select") {
      self.pop_until("select")
    }
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
    let _ = self.pop_open()
    if !has_hidden_type(attrs) {
      self.frameset_ok = false
    }
  } else if name == "param" || name == "source" || name == "track" {
    let _ = self.insert_element(name, attrs)
    let _ = self.pop_open()
  } else if name == "hr" {
    self.close_p_in_button()
    if self.in_scope("select") {
      self.end_implied("")
    }
    let _ = self.insert_element(name, attrs)
    let _ = self.pop_open()
    self.frameset_ok = false
  } else if name == "image" {
    self.process(StartTag("img", attrs, self_closing))
  } else if name == "textarea" {
    if self.in_scope("select") {
      self.pop_until("select")
    }
    let _ = self.insert_element(name, attrs)
    self.skip_newline = true
    self.tok.state = Rcdata
    self.original = self.mode
    self.frameset_ok = false
    self.mode = TextMode
  } else if name == "xmp" {
    self.close_p_in_button()
    self.reconstruct()
    self.frameset_ok = false
    self.text_element(name, attrs, Rawtext)
  } else if name == "iframe" {
    self.frameset_ok = false
    self.text_element(name, attrs, Rawtext)
  } else if name == "noembed" {
    self.text_element(name, attrs, Rawtext)
  } else if name == "noscript" && self.scripting {
    self.text_element(name, attrs, Rawtext)
  } else if name == "select" {
    if self.fragment_of("select") {
      ()
    } else if self.in_scope("select") {
      self.pop_until("select")
    } else {
      self.reconstruct()
      let _ = self.insert_element(name, attrs)
      self.frameset_ok = false
    }
  } else if name == "option" {
    if self.in_scope("select") {
      self.end_implied("optgroup")
    } else if is_html(self.current(), "option") {
      let _ = self.pop_open()
    }
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
  } else if name == "optgroup" {
    if self.in_scope("select") {
      self.end_implied("")
    } else if is_html(self.current(), "option") {
      let _ = self.pop_open()
    }
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
  } else if name == "rb" || name == "rtc" {
    if self.in_scope("ruby") {
      self.end_implied("")
    }
    let _ = self.insert_element(name, attrs)
  } else if name == "rp" || name == "rt" {
    if self.in_scope("ruby") {
      self.end_implied("rtc")
    }
    let _ = self.insert_element(name, attrs)
  } else if name == "math" {
    self.reconstruct()
    let a = adjust_foreign_attrs(adjust_math_attrs(attrs))
    let _ = self.insert_element_ns(name, a, MathMl)
    if self_closing {
      let _ = self.pop_open()
    }
  } else if name == "svg" {
    self.reconstruct()
    let a = adjust_foreign_attrs(adjust_svg_attrs(attrs))
    let _ = self.insert_element_ns(name, a, Svg)
    if self_closing {
      let _ = self.pop_open()
    }
  } else if str_in(name, TAGS_TABLE_IGNORE) {
    ()
  } else {
    self.reconstruct()
    let _ = self.insert_element(name, attrs)
  }
}

fn Builder::in_body_end(self : Builder, name : String) -> Unit {
  if (name == "div" || name == "button" || name == "ul" || name == "li" ||
    name == "span" || name == "label" || name == "section" || name == "header" ||
    name == "footer" || name == "nav" || name == "main" || name == "article" ||
    name == "aside") && self.stack.length() > 0 && is_html(self.current(), name) {
    let _ = self.pop_open()
    return
  }
  if name == "span" || name == "label" {
    self.any_other_end(name)
    return
  }
  if name == "div" || name == "button" || name == "ul" {
    if self.in_scope(name) {
      self.end_implied("")
      self.pop_until(name)
    }
    return
  }
  if name == "li" {
    if self.in_list_scope("li") {
      self.end_implied("li")
      self.pop_until("li")
    }
    return
  }
  if name == "template" {
    self.in_head(EndTag(name))
  } else if name == "body" || name == "html" {
    if self.in_scope("body") {
      self.mode = AfterBody
      if name == "html" {
        self.process(EndTag(name))
      }
    }
  } else if str_in(name, TAGS_BODY_END_BLOCK) {
    if self.in_scope(name) {
      self.end_implied("")
      self.pop_until(name)
    }
  } else if name == "form" {
    if stack_has_html(self.stack, "template") {
      if self.in_scope("form") {
        self.end_implied("")
        self.pop_until("form")
      }
    } else {
      let node = self.form
      self.form = None
      match node {
        Some(n) => {
          if self.in_scope_node(n) {
            self.end_implied("")
            self.remove(n)
          }
        }
        None => ()
      }
    }
  } else if name == "p" {
    if !self.in_button_scope("p") {
      let _ = self.insert_element("p", [])
    }
    self.close_p()
  } else if name == "dd" || name == "dt" {
    if self.in_scope(name) {
      self.end_implied(name)
      self.pop_until(name)
    }
  } else if str_in(name, TAGS_HEADING) {
    if self.any_in_scope(TAGS_HEADING) {
      self.end_implied("")
      self.pop_until_any(TAGS_HEADING)
    }
  } else if str_in(name, TAGS_FMT_END) {
    if !self.adoption(name) {
      self.any_other_end(name)
    }
  } else if name == "applet" || name == "marquee" || name == "object" {
    if self.in_scope(name) {
      self.end_implied("")
      self.pop_until(name)
      self.clear_fmt_to_marker()
    }
  } else if name == "br" {
    self.in_body_start(StartTag("br", [], false), "br", [], false)
  } else {
    self.any_other_end(name)
  }
}

fn Builder::text_mode(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => self.insert_char(c)
    Eof => {
      let _ = self.pop_open()
      self.mode = self.original
      self.process(t)
    }
    EndTag(_) => {
      let _ = self.pop_open()
      self.mode = self.original
    }
    _ => ()
  }
}

fn Builder::in_table_else(self : Builder, t : Token) -> Unit {
  self.foster = true
  self.in_body(t)
  self.foster = false
}

fn Builder::in_table(self : Builder, t : Token) -> Unit {
  let table_ctx = TAGS_TABLE_CTX
  match t {
    Character(_) => {
      if html_in(self.current(), TAGS_TABLE_TEXT_CUR) {
        self.table_chars.clear()
        self.original = self.mode
        self.mode = InTableText
        self.process(t)
      } else {
        self.in_table_else(t)
      }
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, _) => {
      if name == "caption" {
        self.clear_to(table_ctx)
        self.fmt.push(Marker)
        let _ = self.insert_element("caption", attrs)
        self.mode = InCaption
      } else if name == "colgroup" {
        self.clear_to(table_ctx)
        let _ = self.insert_element("colgroup", attrs)
        self.mode = InColumnGroup
      } else if name == "col" {
        self.clear_to(table_ctx)
        let _ = self.insert_element("colgroup", [])
        self.mode = InColumnGroup
        self.process(t)
      } else if name == "tbody" || name == "tfoot" || name == "thead" {
        self.clear_to(table_ctx)
        let _ = self.insert_element(name, attrs)
        self.mode = InTableBody
      } else if name == "td" || name == "th" || name == "tr" {
        self.clear_to(table_ctx)
        let _ = self.insert_element("tbody", [])
        self.mode = InTableBody
        self.process(t)
      } else if name == "table" {
        if self.in_table_scope(["table"]) {
          self.pop_until("table")
          self.reset_mode()
          self.process(t)
        }
      } else if name == "style" || name == "script" || name == "template" {
        self.in_head(t)
      } else if name == "input" && has_hidden_type(attrs) {
        let _ = self.insert_element("input", attrs)
        let _ = self.pop_open()
      } else if name == "form" {
        if self.form.is_none() && !stack_has_html(self.stack, "template") {
          self.form = Some(self.insert_element("form", attrs))
          let _ = self.pop_open()
        }
      } else {
        self.in_table_else(t)
      }
    }
    EndTag(nm) => {
      if nm == "table" {
        if self.in_table_scope(["table"]) {
          self.pop_until("table")
          self.reset_mode()
        }
      } else if nm == "template" {
        self.in_head(t)
      } else if str_in(nm, TAGS_TABLE_END_IGNORE) {
        ()
      } else {
        self.in_table_else(t)
      }
    }
    Eof => self.in_body(t)
  }
}

fn Builder::in_table_text(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if c != 0 {
        self.table_chars.push(c)
      }
    }
    _ => {
      let mut has_non_ws = false
      let mut i = 0
      while i < self.table_chars.length() {
        if !is_ws_cp(self.table_chars[i]) {
          has_non_ws = true
          break
        }
        i = i + 1
      }
      if has_non_ws {
        i = 0
        while i < self.table_chars.length() {
          self.in_table_else(Character(self.table_chars[i]))
          i = i + 1
        }
      } else {
        i = 0
        while i < self.table_chars.length() {
          self.insert_char(self.table_chars[i])
          i = i + 1
        }
      }
      self.mode = self.original
      self.process(t)
    }
  }
}

fn Builder::close_caption(self : Builder) -> Unit {
  self.end_implied("")
  self.pop_until("caption")
  self.clear_fmt_to_marker()
  self.mode = InTable
}

fn Builder::in_caption(self : Builder, t : Token) -> Unit {
  match t {
    EndTag(nm) => {
      if nm == "caption" {
        if self.in_table_scope(["caption"]) {
          self.close_caption()
        }
      } else if nm == "table" {
        if self.in_table_scope(["caption"]) {
          self.close_caption()
          self.process(t)
        }
      } else if str_in(nm, TAGS_CAPTION_END_IGNORE) {
        ()
      } else {
        self.in_body(t)
      }
    }
    StartTag(name, _, _) => {
      if str_in(name, TAGS_CAPTION_START_CLOSE) {
        if self.in_table_scope(["caption"]) {
          self.close_caption()
          self.process(t)
        }
      } else {
        self.in_body(t)
      }
    }
    _ => self.in_body(t)
  }
}

fn Builder::in_column_group(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        self.insert_char(c)
        return
      }
      if is_html(self.current(), "colgroup") {
        let _ = self.pop_open()
        self.mode = InTable
        self.process(t)
      }
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, _) => {
      if name == "html" {
        self.in_body(t)
      } else if name == "col" {
        let _ = self.insert_element("col", attrs)
        let _ = self.pop_open()
      } else if name == "template" {
        self.in_head(t)
      } else {
        if is_html(self.current(), "colgroup") {
          let _ = self.pop_open()
          self.mode = InTable
          self.process(t)
        }
      }
    }
    EndTag(nm) => {
      if nm == "colgroup" {
        if is_html(self.current(), "colgroup") {
          let _ = self.pop_open()
          self.mode = InTable
        }
      } else if nm == "col" {
        ()
      } else if nm == "template" {
        self.in_head(t)
      } else {
        if is_html(self.current(), "colgroup") {
          let _ = self.pop_open()
          self.mode = InTable
          self.process(t)
        }
      }
    }
    Eof => self.in_body(t)
  }
}

fn Builder::in_table_body(self : Builder, t : Token) -> Unit {
  let ctx = ["tbody", "tfoot", "thead", "template", "html"]
  match t {
    StartTag(name, attrs, _) => {
      if name == "tr" {
        self.clear_to(ctx)
        let _ = self.insert_element("tr", attrs)
        self.mode = InRow
      } else if name == "th" || name == "td" {
        self.clear_to(ctx)
        let _ = self.insert_element("tr", [])
        self.mode = InRow
        self.process(t)
      } else if str_in(name, TAGS_TBODY_START_CLOSE) {
        if self.in_table_scope(["tbody", "thead", "tfoot"]) {
          self.clear_to(ctx)
          let _ = self.pop_open()
          self.mode = InTable
          self.process(t)
        }
      } else {
        self.in_table(t)
      }
    }
    EndTag(nm) => {
      if nm == "tbody" || nm == "tfoot" || nm == "thead" {
        if self.in_table_scope([nm]) {
          self.clear_to(ctx)
          let _ = self.pop_open()
          self.mode = InTable
        }
      } else if nm == "table" {
        if self.in_table_scope(["tbody", "thead", "tfoot"]) {
          self.clear_to(ctx)
          let _ = self.pop_open()
          self.mode = InTable
          self.process(t)
        }
      } else if str_in(nm, TAGS_TBODY_END_IGNORE) {
        ()
      } else {
        self.in_table(t)
      }
    }
    _ => self.in_table(t)
  }
}

fn Builder::close_row(self : Builder) -> Unit {
  self.clear_to(["tr", "template", "html"])
  let _ = self.pop_open()
  self.mode = InTableBody
}

fn Builder::in_row(self : Builder, t : Token) -> Unit {
  let ctx = ["tr", "template", "html"]
  match t {
    StartTag(name, attrs, _) => {
      if name == "th" || name == "td" {
        self.clear_to(ctx)
        let _ = self.insert_element(name, attrs)
        self.mode = InCell
        self.fmt.push(Marker)
      } else if str_in(name, TAGS_TR_START_CLOSE) {
        if self.in_table_scope(["tr"]) {
          self.close_row()
          self.process(t)
        }
      } else {
        self.in_table(t)
      }
    }
    EndTag(nm) => {
      if nm == "tr" {
        if self.in_table_scope(["tr"]) {
          self.close_row()
        }
      } else if nm == "table" {
        if self.in_table_scope(["tr"]) {
          self.close_row()
          self.process(t)
        }
      } else if nm == "tbody" || nm == "tfoot" || nm == "thead" {
        if self.in_table_scope([nm]) && self.in_table_scope(["tr"]) {
          self.close_row()
          self.process(t)
        }
      } else if str_in(nm, TAGS_TR_END_IGNORE) {
        ()
      } else {
        self.in_table(t)
      }
    }
    _ => self.in_table(t)
  }
}

fn Builder::close_cell(self : Builder) -> Unit {
  self.end_implied("")
  self.pop_until_any(["td", "th"])
  self.clear_fmt_to_marker()
  self.mode = InRow
}

fn Builder::in_cell(self : Builder, t : Token) -> Unit {
  match t {
    EndTag(nm) => {
      if nm == "td" || nm == "th" {
        if self.in_table_scope([nm]) {
          self.end_implied("")
          self.pop_until(nm)
          self.clear_fmt_to_marker()
          self.mode = InRow
        }
      } else if str_in(nm, TAGS_CELL_END_IGNORE) {
        ()
      } else if str_in(nm, TAGS_CELL_END_CLOSE) {
        if self.in_table_scope([nm]) {
          self.close_cell()
          self.process(t)
        }
      } else {
        self.in_body(t)
      }
    }
    StartTag(name, _, _) => {
      if str_in(name, TAGS_CAPTION_START_CLOSE) {
        if self.in_table_scope(["td", "th"]) {
          self.close_cell()
          self.process(t)
        }
      } else {
        self.in_body(t)
      }
    }
    _ => self.in_body(t)
  }
}

fn Builder::switch_template_mode(self : Builder, m : Mode, t : Token) -> Unit {
  let _ = self.templates.pop()
  self.templates.push(m)
  self.mode = m
  self.process(t)
}

fn Builder::in_template(self : Builder, t : Token) -> Unit {
  match t {
    Character(_) => self.in_body(t)
    CommentToken(_) => self.in_body(t)
    DoctypeToken(_, _, _, _) => self.in_body(t)
    StartTag(name, _, _) => {
      if str_in(name, TAGS_IN_HEAD_START) {
        self.in_head(t)
      } else if str_in(name, TAGS_TEMPLATE_TABLE) {
        self.switch_template_mode(InTable, t)
      } else if name == "col" {
        self.switch_template_mode(InColumnGroup, t)
      } else if name == "tr" {
        self.switch_template_mode(InTableBody, t)
      } else if name == "td" || name == "th" {
        self.switch_template_mode(InRow, t)
      } else {
        self.switch_template_mode(InBody, t)
      }
    }
    EndTag(nm) => {
      if nm == "template" {
        self.in_head(t)
      }
    }
    Eof => {
      if stack_has_html(self.stack, "template") {
        self.pop_until("template")
        self.clear_fmt_to_marker()
        let _ = self.templates.pop()
        self.reset_mode()
        self.process(t)
      }
    }
  }
}

fn Builder::after_body(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        self.in_body(t)
      } else {
        self.mode = InBody
        self.process(t)
      }
    }
    CommentToken(d) => self.stack[0].append(comment_node(d))
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, _, _) => {
      if name == "html" {
        self.in_body(t)
      } else {
        self.mode = InBody
        self.process(t)
      }
    }
    EndTag(nm) => {
      if nm == "html" {
        if self.context.is_none() {
          self.mode = AfterAfterBody
        }
      } else {
        self.mode = InBody
        self.process(t)
      }
    }
    Eof => ()
  }
}

fn Builder::in_frameset(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        self.insert_char(c)
      }
    }
    CommentToken(d) => self.insert_comment(d)
    StartTag(name, attrs, _) => {
      if name == "html" {
        self.in_body(t)
      } else if name == "frameset" {
        let _ = self.insert_element("frameset", attrs)
      } else if name == "frame" {
        let _ = self.insert_element("frame", attrs)
        let _ = self.pop_open()
      } else if name == "noframes" {
        self.in_head(t)
      }
    }
    EndTag(nm) => {
      if nm == "frameset" && self.stack.length() > 1 {
        let _ = self.pop_open()
        if self.context.is_none() && !is_html(self.current(), "frameset") {
          self.mode = AfterFrameset
        }
      }
    }
    _ => ()
  }
}

fn Builder::after_frameset(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if is_ws_cp(c) {
        self.insert_char(c)
      }
    }
    CommentToken(d) => self.insert_comment(d)
    StartTag(name, _, _) => {
      if name == "html" {
        self.in_body(t)
      } else if name == "noframes" {
        self.in_head(t)
      }
    }
    EndTag(nm) => {
      if nm == "html" {
        self.mode = AfterAfterFrameset
      }
    }
    _ => ()
  }
}

fn Builder::after_after_body(self : Builder, t : Token) -> Unit {
  match t {
    CommentToken(d) => self.doc.append(comment_node(d))
    DoctypeToken(_, _, _, _) => self.in_body(t)
    StartTag(name, _, _) => {
      if name == "html" {
        self.in_body(t)
      } else {
        self.mode = InBody
        self.process(t)
      }
    }
    Character(c) => {
      if is_ws_cp(c) {
        self.in_body(t)
      } else {
        self.mode = InBody
        self.process(t)
      }
    }
    Eof => ()
    _ => {
      self.mode = InBody
      self.process(t)
    }
  }
}

fn Builder::after_after_frameset(self : Builder, t : Token) -> Unit {
  match t {
    CommentToken(d) => self.doc.append(comment_node(d))
    DoctypeToken(_, _, _, _) => self.in_body(t)
    StartTag(name, _, _) => {
      if name == "html" {
        self.in_body(t)
      } else if name == "noframes" {
        self.in_head(t)
      }
    }
    Character(c) => {
      if is_ws_cp(c) {
        self.in_body(t)
      }
    }
    _ => ()
  }
}

// Foreign content

fn math_text_point(n : Node) -> Bool {
  n.ns == MathMl && str_in(n.tag, TAGS_MATHML_TEXT_5)
}

fn html_point(n : Node) -> Bool {
  match n.ns {
    Svg => (n.tag == "foreignObject" || n.tag == "desc" || n.tag == "title")
    MathMl => {
      if n.tag != "annotation-xml" {
        return false
      }
      match n.attr("encoding") {
        Some(e) => {
          let le = ascii_lower(e)
          le == "text/html" || le == "application/xhtml+xml"
        }
        None => false
      }
    }
    Html => false
    Other => false
  }
}

fn build_svg_tags() -> Map[String, String] {
  let m : Map[String, String] = Map::new()
  let names : Array[String] = [
    "altGlyph", "altGlyphDef", "altGlyphItem", "animateColor", "animateMotion",
    "animateTransform", "clipPath", "feBlend", "feColorMatrix",
    "feComponentTransfer", "feComposite", "feConvolveMatrix",
    "feDiffuseLighting", "feDisplacementMap", "feDistantLight", "feDropShadow",
    "feFlood", "feFuncA", "feFuncB", "feFuncG", "feFuncR", "feGaussianBlur",
    "feImage", "feMerge", "feMergeNode", "feMorphology", "feOffset",
    "fePointLight", "feSpecularLighting", "feSpotLight", "feTile",
    "feTurbulence", "foreignObject", "glyphRef", "linearGradient",
    "radialGradient", "textPath",
  ]
  let mut i = 0
  while i < names.length() {
    m.set(ascii_lower(names[i]), names[i])
    i = i + 1
  }
  m
}

let SVG_TAGS : Map[String, String] = build_svg_tags()

fn build_svg_attr_names() -> Map[String, String] {
  let m : Map[String, String] = Map::new()
  let names : Array[String] = [
    "attributeName", "attributeType", "baseFrequency", "baseProfile",
    "calcMode", "clipPathUnits", "diffuseConstant", "edgeMode", "filterUnits",
    "glyphRef", "gradientTransform", "gradientUnits", "kernelMatrix",
    "kernelUnitLength", "keyPoints", "keySplines", "keyTimes", "lengthAdjust",
    "limitingConeAngle", "markerHeight", "markerUnits", "markerWidth",
    "maskContentUnits", "maskUnits", "numOctaves", "pathLength",
    "patternContentUnits", "patternTransform", "patternUnits", "pointsAtX",
    "pointsAtY", "pointsAtZ", "preserveAlpha", "preserveAspectRatio",
    "primitiveUnits", "refX", "refY", "repeatCount", "repeatDur",
    "requiredExtensions", "requiredFeatures", "specularConstant",
    "specularExponent", "spreadMethod", "startOffset", "stdDeviation",
    "stitchTiles", "surfaceScale", "systemLanguage", "tableValues", "targetX",
    "targetY", "textLength", "viewBox", "viewTarget", "xChannelSelector",
    "yChannelSelector", "zoomAndPan",
  ]
  let mut i = 0
  while i < names.length() {
    m.set(ascii_lower(names[i]), names[i])
    i = i + 1
  }
  m
}

let SVG_ATTR_NAMES : Map[String, String] = build_svg_attr_names()

let XLINK_ATTRS : Array[String] = [
  "xlink:actuate", "xlink:arcrole", "xlink:href", "xlink:role",
  "xlink:show", "xlink:title", "xlink:type",
]

fn adjust_svg_attrs(attrs : Array[Attr]) -> Array[Attr] {
  let n = attrs.length()
  if n == 0 {
    return attrs
  }
  let mut first = -1
  let mut i = 0
  while i < n {
    if SVG_ATTR_NAMES.contains(attrs[i].name) {
      first = i
      break
    }
    i = i + 1
  }
  if first < 0 {
    return attrs
  }
  let out : Array[Attr] = []
  i = 0
  while i < first {
    out.push(attrs[i])
    i = i + 1
  }
  while i < n {
    let a = attrs[i]
    match SVG_ATTR_NAMES.get(a.name) {
      Some(nm) => out.push(Attr::new("", nm, a.value, ""))
      None => out.push(a)
    }
    i = i + 1
  }
  out
}

fn adjust_math_attrs(attrs : Array[Attr]) -> Array[Attr] {
  let n = attrs.length()
  if n == 0 {
    return attrs
  }
  let mut first = -1
  let mut i = 0
  while i < n {
    if attrs[i].name == "definitionurl" {
      first = i
      break
    }
    i = i + 1
  }
  if first < 0 {
    return attrs
  }
  let out : Array[Attr] = []
  i = 0
  while i < first {
    out.push(attrs[i])
    i = i + 1
  }
  while i < n {
    let a = attrs[i]
    if a.name == "definitionurl" {
      out.push(Attr::new("", "definitionURL", a.value, ""))
    } else {
      out.push(a)
    }
    i = i + 1
  }
  out
}

fn is_foreign_attr(name : String) -> Bool {
  if name.length() < 5 {
    return false
  }
  if name.code_unit_at(0) != 120 { // 'x'
    return false
  }
  if name == "xmlns" || name == "xmlns:xlink" || name == "xml:lang" || name == "xml:space" {
    return true
  }
  str_in(name, XLINK_ATTRS)
}

fn adjust_foreign_attrs(attrs : Array[Attr]) -> Array[Attr] {
  let n = attrs.length()
  if n == 0 {
    return attrs
  }
  let mut first = -1
  let mut i = 0
  while i < n {
    if is_foreign_attr(attrs[i].name) {
      first = i
      break
    }
    i = i + 1
  }
  if first < 0 {
    return attrs
  }
  let out : Array[Attr] = []
  i = 0
  while i < first {
    out.push(attrs[i])
    i = i + 1
  }
  while i < n {
    let a = attrs[i]
    if a.name.length() >= 5 && a.name.code_unit_at(0) == 120 {
      if str_in(a.name, XLINK_ATTRS) {
        out.push(
          Attr::new("xlink", a.name.slice(6, a.name.length()), a.value, XLINK_NS),
        )
      } else if a.name == "xml:lang" || a.name == "xml:space" {
        out.push(
          Attr::new("xml", a.name.slice(4, a.name.length()), a.value, XML_NS),
        )
      } else if a.name == "xmlns" {
        out.push(Attr::new("", "xmlns", a.value, XMLNS_NS))
      } else if a.name == "xmlns:xlink" {
        out.push(Attr::new("xmlns", "xlink", a.value, XMLNS_NS))
      } else {
        out.push(a)
      }
    } else {
      out.push(a)
    }
    i = i + 1
  }
  out
}

let FOREIGN_BREAKOUT_TAGS : Array[String] = [
  "b", "big", "blockquote", "body", "br", "center", "code", "dd", "div", "dl",
  "dt", "em", "embed", "h1", "h2", "h3", "h4", "h5", "h6", "head", "hr", "i",
  "img", "li", "listing", "menu", "meta", "nobr", "ol", "p", "pre", "ruby", "s",
  "small", "span", "strong", "strike", "sub", "sup", "table", "tt", "u", "ul",
  "var",
]

fn Builder::foreign_breakout(self : Builder, t : Token) -> Unit {
  if self.context.is_some() {
    match t {
      StartTag(name, attrs, self_closing) => {
        match self.adjusted() {
          Some(adj) => {
            if adj.ns != Html && self.stack.length() == 1 {
              self.mode_step(self.mode, StartTag(name, attrs, self_closing))
              return
            }
          }
          None => ()
        }
      }
      _ => ()
    }
  }
  while !(self.current().ns == Html ||
    math_text_point(self.current()) ||
    html_point(self.current())) {
    let _ = self.pop_open()
  }
  self.mode_step(self.mode, t)
}

fn Builder::foreign(self : Builder, t : Token) -> Unit {
  match t {
    Character(c) => {
      if c == 0 {
        self.insert_char(0xFFFD)
      } else {
        self.insert_char(c)
        if !is_ws_cp(c) {
          self.frameset_ok = false
        }
      }
    }
    CommentToken(d) => self.insert_comment(d)
    DoctypeToken(_, _, _, _) => ()
    StartTag(name, attrs, self_closing) => {
      let mut font_breakout = false
      if name == "font" {
        let mut ai = 0
        while ai < attrs.length() {
          let an = attrs[ai].name
          if an == "color" || an == "face" || an == "size" {
            font_breakout = true
            break
          }
          ai = ai + 1
        }
      }
      if str_in(name, FOREIGN_BREAKOUT_TAGS) || font_breakout {
        self.foreign_breakout(t)
        return
      }
      let adjusted = match self.adjusted() {
        Some(a) => a
        None => return
      }
      let mut tag = name
      let mut a = attrs
      if adjusted.ns == Svg {
        tag = SVG_TAGS.get(name).unwrap_or(name)
        a = adjust_svg_attrs(a)
      } else {
        a = adjust_math_attrs(a)
      }
      a = adjust_foreign_attrs(a)
      let _ = self.insert_element_ns(tag, a, adjusted.ns)
      if self_closing {
        let _ = self.pop_open()
      }
    }
    EndTag(nm) => {
      if nm == "br" || nm == "p" {
        self.foreign_breakout(t)
        return
      }
      let mut i = self.stack.length() - 1
      while i > 0 {
        let n = self.stack[i]
        if ascii_lower(n.tag) == nm {
          while self.stack.length() > i {
            let _ = self.pop_open()
          }
          return
        }
        i = i - 1
        if self.stack[i].ns == Html {
          self.mode_step(self.mode, t)
          return
        }
      }
    }
    Eof => self.mode_step(self.mode, t)
  }
}

fn Builder::mode_step(self : Builder, m : Mode, t : Token) -> Unit {
  match m {
    Initial => self.initial(t)
    BeforeHtml => self.before_html(t)
    BeforeHead => self.before_head(t)
    InHead => self.in_head(t)
    InHeadNoscript => self.in_head_noscript(t)
    AfterHead => self.after_head(t)
    InBody => self.in_body(t)
    TextMode => self.text_mode(t)
    InTable => self.in_table(t)
    InTableText => self.in_table_text(t)
    InCaption => self.in_caption(t)
    InColumnGroup => self.in_column_group(t)
    InTableBody => self.in_table_body(t)
    InRow => self.in_row(t)
    InCell => self.in_cell(t)
    InTemplate => self.in_template(t)
    AfterBody => self.after_body(t)
    InFrameset => self.in_frameset(t)
    AfterFrameset => self.after_frameset(t)
    AfterAfterBody => self.after_after_body(t)
    AfterAfterFrameset => self.after_after_frameset(t)
  }
}

fn Builder::process(self : Builder, t : Token) -> Unit {
  let is_char = match t {
    Character(_) => true
    _ => false
  }
  if !is_char {
    self.flush_text()
  }
  if self.foreign_depth == 0 {
    self.mode_step(self.mode, t)
    return
  }
  let html_rules = match self.adjusted() {
    None => true
    Some(n) => {
      if n.ns == Html {
        true
      } else if math_text_point(n) &&
      (match t {
        StartTag(name, _, _) => name != "mglyph" && name != "malignmark"
        Character(_) => true
        _ => false
      }) {
        true
      } else if n.ns == MathMl &&
      n.tag == "annotation-xml" &&
      (match t {
        StartTag(name, _, _) => name == "svg"
        _ => false
      }) {
        true
      } else if html_point(n) &&
      (match t {
        StartTag(_, _, _) => true
        Character(_) => true
        _ => false
      }) {
        true
      } else {
        match t {
          Eof => true
          _ => false
        }
      }
    }
  }
  if html_rules {
    self.mode_step(self.mode, t)
  } else {
    self.foreign(t)
  }
}

fn Builder::run(self : Builder) -> Unit {
  while true {
    if self.foreign_depth > 0 || self.tok.allow_cdata {
      self.tok.allow_cdata = !self.adjusted_is_html()
    }
    let t = self.tok.next_token()
    if self.skip_newline {
      self.skip_newline = false
      match t {
        Character(c) => {
          if c == 10 {
            continue
          }
        }
        _ => ()
      }
    }
    if self.mode == InBody && self.foreign_depth == 0 && !self.foster && self.text_node.is_none() {
      match t {
        StartTag(name, attrs, self_closing) => {
          self.in_body_start(t, name, attrs, self_closing)
          continue
        }
        EndTag(name) => {
          self.in_body_end(name)
          continue
        }
        Eof => if self.templates.length() == 0 { break }
        Character(c) if c != 0 &&
        self.tok.ascii &&
        self.tok.state == Data &&
        self.tok.head >= self.tok.out.length() &&
        self.tok.pos > 0 &&
        self.tok.src.code_unit_at(self.tok.pos - 1) == c => {
          self.reconstruct()
          let target = self.current()
          if target.kind != Document &&
          !(target.ns == Html && target.tag.length() == 8 && target.tag == "template") &&
          (target.children.length() == 0 || target.children[target.children.length() - 1].kind != Text) {
            let (s, has_non_ws) = self.tok.take_ascii_run(c)
            let tn = Node::text(s)
            target.append_parsed(tn)
            if has_non_ws {
              self.frameset_ok = false
            }
            continue
          }
        }
        _ => ()
      }
    }
    self.process(t)
    match t {
      Eof => break
      Character(c) => {
        if c != 0 &&
        self.mode == InBody &&
        !self.foster &&
        self.text_node.is_some() &&
        self.adjusted_is_html() &&
        self.tok.take_text(self.tbuf()) {
          self.frameset_ok = false
        }
      }
      _ => ()
    }
  }
  self.flush_text()
}

fn new_builder(
  s : String,
  doc : Node,
  scripting : Bool,
  context : Option[Node],
) -> Builder {
  Builder::{
    tok: Tokenizer::new(s),
    doc: doc,
    stack: Array::with_capacity(8),
    mode: Initial,
    original: Initial,
    head: None,
    form: None,
    fmt: [],
    templates: [],
    foster: false,
    frameset_ok: true,
    scripting: scripting,
    context: context,
    table_chars: [],
    skip_newline: false,
    text_node: None,
    text_buf: None,
    open_p: 0,
    open_select: 0,
    open_button: 0,
    open_li: 0,
    foreign_depth: match context {
      Some(c) => if c.ns != Html { 1 } else { 0 }
      None => 0
    },
  }
}

pub fn parse_with_scripting(s : String, scripting : Bool) -> Node {
  let doc = Node::new(Document)
  let b = new_builder(s, doc, scripting, None)
  b.run()
  bump_tree_changes()
  doc
}

pub fn parse(s : String) -> Node {
  parse_with_scripting(s, true)
}

pub fn parse_fragment(s : String, context : Node, scripting : Bool) -> Node {
  let doc = Node::new(Document)
  let b = new_builder(s, doc, scripting, Some(context))
  if context.ns == Html {
    if context.tag == "title" || context.tag == "textarea" {
      b.tok.state = Rcdata
    } else if str_in(context.tag, TAGS_FRAG_RAWTEXT) {
      b.tok.state = Rawtext
    } else if context.tag == "script" {
      b.tok.state = ScriptData
    } else if context.tag == "noscript" && scripting {
      b.tok.state = Rawtext
    } else if context.tag == "plaintext" {
      b.tok.state = Plaintext
    } else {
      b.tok.state = Data
    }
  }
  let root = new_element(Html, "html", EMPTY_ATTRS)
  doc.append(root)
  b.push_open(root)
  if is_html(context, "template") {
    b.templates.push(InTemplate)
  }
  b.reset_mode()
  if b.mode == Initial {
    b.mode = InBody
  }
  let mut cur : Option[Node] = Some(context)
  while true {
    match cur {
      Some(x) => {
        if is_html(x, "form") {
          b.form = Some(x)
          break
        }
        cur = x.parent
      }
      None => break
    }
  }
  b.run()
  bump_tree_changes()
  root.detach()
  root
}

fn fast_frag_ctx_ok(context : Node) -> Bool {
  if context.kind != Element || context.ns != Html {
    return false
  }
  let t = context.tag
  let l = t.length()
  if l == 3 {
    t != "xmp"
  } else if l == 4 {
    t != "html" && t != "head" && t != "form"
  } else if l == 2 {
    t != "tr" && t != "li" && t != "dt" && t != "dd" &&
    !(t.code_unit_at(0) == 104 && t.code_unit_at(1) >= 49 && t.code_unit_at(1) <= 54)
  } else if l == 5 {
    t != "style" && t != "title" && t != "table" && t != "tbody" && t != "thead" && t != "tfoot" && t != "label"
  } else if l == 6 {
    t != "script" && t != "iframe" && t != "select" && t != "option" && t != "button"
  } else if l == 7 {
    t != "noembed"
  } else if l == 8 {
    t != "textarea" && t != "noframes" && t != "noscript" && t != "colgroup" && t != "optgroup" && t != "frameset" && t != "template"
  } else if l == 1 {
    t != "p" && t != "a"
  } else if l == 9 {
    t != "plaintext"
  } else {
    true
  }
}

///| Tag classification for `try_parse_fragment_fast`:
///| 0 = disallowed, 1 = void, 2 = normal safe, 3 = li, 4 = dt/dd,
///| 5 = p, 6 = a, 7 = button, 8 = form, 9 = label, 10 = h1..h6
fn fast_frag_tag_class(tag : String) -> Int {
  let l = tag.length()
  if l == 3 {
    if tag == "div" || tag == "nav" || tag == "sub" || tag == "sup" || tag == "del" || tag == "ins" { 2 }
    else if tag == "img" || tag == "wbr" { 1 }
    else { 0 }
  } else if l == 4 {
    if tag == "span" || tag == "main" || tag == "code" || tag == "mark" || tag == "time" || tag == "abbr" || tag == "cite" { 2 }
    else if tag == "form" { 8 }
    else if tag == "area" { 1 }
    else { 0 }
  } else if l == 2 {
    if tag == "li" { 3 }
    else if tag == "ul" || tag == "ol" || tag == "em" || tag == "dl" { 2 }
    else if tag == "br" || tag == "hr" { 1 }
    else if tag == "dt" || tag == "dd" { 4 }
    else if tag.code_unit_at(0) == 104 && tag.code_unit_at(1) >= 49 && tag.code_unit_at(1) <= 54 { 10 }
    else { 0 }
  } else if l == 5 {
    if tag == "input" || tag == "track" { 1 }
    else if tag == "label" { 9 }
    else if tag == "small" || tag == "aside" || tag == "meter" || tag == "video" || tag == "audio" { 2 }
    else { 0 }
  } else if l == 6 {
    if tag == "button" { 7 }
    else if tag == "strong" || tag == "header" || tag == "footer" || tag == "figure" || tag == "legend" || tag == "output" || tag == "dialog" || tag == "canvas" { 2 }
    else if tag == "source" { 1 }
    else { 0 }
  } else if l == 1 {
    if tag == "a" { 6 }
    else if tag == "p" { 5 }
    else if tag == "b" || tag == "i" || tag == "q" || tag == "s" || tag == "u" { 2 }
    else { 0 }
  } else if l == 7 {
    if tag == "section" || tag == "article" || tag == "details" || tag == "summary" { 2 } else { 0 }
  } else if l == 8 {
    if tag == "fieldset" || tag == "progress" { 2 } else { 0 }
  } else if l == 10 {
    if tag == "figcaption" || tag == "blockquote" { 2 } else { 0 }
  } else {
    0
  }
}

fn fast_frag_blocks_p(tag : String) -> Bool {
  tag == "div" || tag == "p" || tag == "ul" || tag == "ol" || tag == "li" ||
  tag == "section" || tag == "article" || tag == "aside" || tag == "header" ||
  tag == "footer" || tag == "nav" || tag == "main" || tag == "blockquote" ||
  tag == "form" || tag == "fieldset" || tag == "dl" || tag == "dt" || tag == "dd" ||
  tag == "figure" || tag == "figcaption" || tag == "details" || tag == "summary" ||
  tag == "dialog" || tag == "hr" ||
  tag == "h1" || tag == "h2" || tag == "h3" || tag == "h4" || tag == "h5" || tag == "h6"
}

fn fast_frag_is_heading(tag : String) -> Bool {
  tag.length() == 2 && tag.code_unit_at(0) == 104 && tag.code_unit_at(1) >= 49 && tag.code_unit_at(1) <= 54
}

fn fast_frag_tag_eq(s : String, start : Int, end : Int, tag : String) -> Bool {
  let tl = tag.length()
  if end - start != tl {
    return false
  }
  let mut k = 0
  while k < tl {
    let mut c = s.code_unit_at(start + k)
    if c >= 65 && c <= 90 {
      c = c + 32
    }
    if c != tag.code_unit_at(k) {
      return false
    }
    k = k + 1
  }
  true
}

///| General HTML5-equivalent fast-path fragment parser for well-formed simple HTML fragments.
///| Returns `None` on any edge case (entities, comments, non-whitelisted tags, implicit closes,
///| unclosed tags, rawtext/table/foreign contexts) so callers fall back to `parse_fragment`.
pub fn try_parse_fragment_fast(s : String, context : Node) -> Option[Array[Node]] {
  if !fast_frag_ctx_ok(context) {
    return None
  }
  let n = s.length()
  let root_children : Array[Node] = []
  let stack : Array[Node] = []
  let mut open_p = 0
  let mut open_a = 0
  let mut open_btn = 0
  let mut open_form = 0
  let mut open_label = 0
  let mut open_heading = 0
  let mut i = 0
  while i < n {
    let ch = s.code_unit_at(i)
    if ch != 60 {
      // Text run: scan until '<', '&', '\r', or '\0'
      let start = i
      while i < n {
        let c = s.code_unit_at(i)
        if c != 32 && c != 9 && c != 10 && c != 12 {
          break
        }
        i = i + 1
      }
      let all_ws = i >= n || s.code_unit_at(i) == 60
      if !all_ws {
        while i < n {
          let c = s.code_unit_at(i)
          if c > 60 {
            i = i + 1
            continue
          }
          if c == 60 {
            break
          }
          if c == 38 || c == 13 || c == 0 {
            return None
          }
          i = i + 1
        }
      }
      let txt = if all_ws { intern_html_ws(s, start, i) } else { s.slice(start, i) }
      let tn = Node::text(txt)
      let slen = stack.length()
      if slen == 0 {
        tn.pos = root_children.length()
        root_children.push(tn)
      } else {
        let par = stack[slen - 1]
        tn.parent = Some(par)
        tn.pos = par.children.length()
        par.push_child(tn)
      }
    } else {
      // Tag starting with '<'
      i = i + 1
      if i >= n {
        return None
      }
      let c1 = s.code_unit_at(i)
      if c1 == 47 {
        // End tag '</tag>'
        i = i + 1
        let slen = stack.length()
        if slen == 0 || i >= n {
          return None
        }
        let top = stack[slen - 1]
        let ttag = top.tag
        let tl = ttag.length()
        if i + tl < n && s.code_unit_at(i + tl) == 62 {
          let mut k = 0
          while k < tl && s.code_unit_at(i + k) == ttag.code_unit_at(k) {
            k = k + 1
          }
          if k == tl {
            i = i + tl + 1
          } else {
            let tstart = i
            let c0 = s.code_unit_at(i)
            if !((c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90)) {
              return None
            }
            i = i + 1
            while i < n {
              let c = s.code_unit_at(i)
              if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
                i = i + 1
              } else {
                break
              }
            }
            let tend = i
            while i < n {
              let c = s.code_unit_at(i)
              if c == 32 || c == 9 || c == 10 || c == 12 {
                i = i + 1
              } else {
                break
              }
            }
            if i >= n || s.code_unit_at(i) != 62 || !fast_frag_tag_eq(s, tstart, tend, ttag) {
              return None
            }
            i = i + 1
          }
        } else {
          let tstart = i
          let c0 = s.code_unit_at(i)
          if !((c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90)) {
            return None
          }
          i = i + 1
          while i < n {
            let c = s.code_unit_at(i)
            if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
              i = i + 1
            } else {
              break
            }
          }
          let tend = i
          while i < n {
            let c = s.code_unit_at(i)
            if c == 32 || c == 9 || c == 10 || c == 12 {
              i = i + 1
            } else {
              break
            }
          }
          if i >= n || s.code_unit_at(i) != 62 || !fast_frag_tag_eq(s, tstart, tend, ttag) {
            return None
          }
          i = i + 1
        }
        let _ = stack.pop()
        if (open_p | open_a | open_btn | open_form | open_label | open_heading) != 0 {
          if ttag == "p" {
            open_p = open_p - 1
          } else if ttag == "a" {
            open_a = open_a - 1
          } else if ttag == "button" {
            open_btn = open_btn - 1
          } else if ttag == "form" {
            open_form = open_form - 1
          } else if ttag == "label" {
            open_label = open_label - 1
          } else if fast_frag_is_heading(ttag) {
            open_heading = open_heading - 1
          }
        }
      } else if c1 >= 97 && c1 <= 122 {
        // Start tag '<tag ...>'
        let tstart = i
        i = i + 1
        while i < n {
          let c = s.code_unit_at(i)
          if c >= 97 && c <= 122 {
            i = i + 1
            continue
          }
          if c == 32 || c == 62 || c == 47 || c == 9 || c == 10 || c == 12 {
            break
          }
          if c >= 48 && c <= 57 {
            i = i + 1
            continue
          }
          return None
        }
        let tag = intern_html_tag(s, tstart, i)
        let tcls = fast_frag_tag_class(tag)
        if tcls == 0 {
          return None
        }
        let is_void = tcls == 1
        // HTML5 nesting safety checks (bail on any implicit-close case)
        if open_p > 0 && fast_frag_blocks_p(tag) {
          return None
        }
        if tcls >= 5 {
          if tcls == 6 && open_a > 0 { return None }
          if tcls == 7 && open_btn > 0 { return None }
          if tcls == 8 && open_form > 0 { return None }
          if tcls == 9 && open_label > 0 { return None }
          if tcls == 10 && open_heading > 0 { return None }
        }
        let slen = stack.length()
        if slen >= 64 {
          return None
        }
        if slen > 0 && (tcls == 3 || tcls == 4) {
          let ptag = stack[slen - 1].tag
          if (tcls == 3 && ptag == "li") || (tcls == 4 && (ptag == "dt" || ptag == "dd")) {
            return None
          }
        }
        // Parse attributes
        let mut attrs : Array[Attr] = EMPTY_ATTRS
        let mut self_close = false
        while true {
          // Skip ASCII whitespace
          let mut ws_skipped = false
          while i < n {
            let c = s.code_unit_at(i)
            if c > 32 {
              break
            }
            if c == 32 || c == 9 || c == 10 || c == 12 {
              ws_skipped = true
              i = i + 1
            } else if c == 13 || c == 0 {
              return None
            } else {
              break
            }
          }
          if i >= n {
            return None
          }
          let c = s.code_unit_at(i)
          if c == 62 {
            i = i + 1
            break
          }
          if c == 47 {
            if i + 1 < n && s.code_unit_at(i + 1) == 62 {
              self_close = true
              i = i + 2
              break
            }
            return None
          }
          if !ws_skipped && attrs.length() > 0 {
            return None
          }
          // Attribute name (lowercase ASCII letters, digits, '-', '_')
          let astart = i
          while i < n {
            let ac = s.code_unit_at(i)
            if ac >= 97 && ac <= 122 {
              i = i + 1
              continue
            }
            if ac == 61 || ac == 32 || ac == 62 || ac == 47 || ac == 9 || ac == 10 || ac == 12 {
              break
            }
            if ac == 45 || (ac >= 48 && ac <= 57) || ac == 95 {
              i = i + 1
              continue
            }
            break
          }
          let aend = i
          if aend == astart {
            return None
          }
          let aname = intern_html_attr(s, astart, aend)
          // Check for duplicate attribute name
          let alen = attrs.length()
          if alen == 1 {
            if attrs[0].name == aname {
              return None
            }
          } else if alen > 1 {
            let mut di = 0
            while di < alen {
              if attrs[di].name == aname {
                return None
              }
              di = di + 1
            }
          }
          // Skip whitespace before '='
          while i < n {
            let wc = s.code_unit_at(i)
            if wc > 32 {
              break
            }
            if wc == 32 || wc == 9 || wc == 10 || wc == 12 {
              i = i + 1
            } else {
              break
            }
          }
          let mut aval = ""
          if i < n && s.code_unit_at(i) == 61 {
            i = i + 1
            while i < n {
              let wc = s.code_unit_at(i)
              if wc > 32 {
                break
              }
              if wc == 32 || wc == 9 || wc == 10 || wc == 12 {
                i = i + 1
              } else {
                break
              }
            }
            if i >= n {
              return None
            }
            let qc = s.code_unit_at(i)
            if qc == 34 || qc == 39 {
              i = i + 1
              let vstart = i
              while i < n {
                let vc = s.code_unit_at(i)
                if vc > 39 {
                  i = i + 1
                  continue
                }
                if vc == qc {
                  break
                }
                if vc == 38 || vc == 13 || vc == 0 {
                  return None
                }
                i = i + 1
              }
              if i >= n {
                return None
              }
              aval = if i == vstart { "" } else { intern_html_attr_val(s, vstart, i) }
              i = i + 1
            } else {
              // Unquoted attribute value
              let vstart = i
              while i < n {
                let vc = s.code_unit_at(i)
                if vc == 32 || vc == 9 || vc == 10 || vc == 12 || vc == 62 {
                  break
                }
                if vc == 34 || vc == 39 || vc == 61 || vc == 60 || vc == 96 || vc == 38 || vc == 13 || vc == 0 {
                  return None
                }
                i = i + 1
              }
              if i == vstart {
                return None
              }
              aval = intern_html_attr_val(s, vstart, i)
            }
          }
          let a = Attr::{ prefix: "", name: aname, value: aval, ns: "" }
          if alen == 0 {
            if i < n && s.code_unit_at(i) != 62 && s.code_unit_at(i) != 47 {
              attrs = Array::with_capacity(4)
              attrs.push(a)
            } else {
              attrs = [a]
            }
          } else {
            attrs.push(a)
          }
        }
        if self_close && !is_void {
          return None
        }
        let el = Node::element(Html, tag, attrs)
        if slen == 0 {
          el.pos = root_children.length()
          root_children.push(el)
        } else {
          let par = stack[slen - 1]
          el.parent = Some(par)
          el.pos = par.children.length()
          par.push_child(el)
        }
        if !is_void {
          stack.push(el)
          if tcls >= 5 {
            if tcls == 5 { open_p = open_p + 1 }
            else if tcls == 6 { open_a = open_a + 1 }
            else if tcls == 7 { open_btn = open_btn + 1 }
            else if tcls == 8 { open_form = open_form + 1 }
            else if tcls == 9 { open_label = open_label + 1 }
            else if tcls == 10 { open_heading = open_heading + 1 }
          }
        }
      } else {
        return None
      }
    }
  }
  if stack.length() != 0 {
    return None
  }
  Some(root_children)
}
