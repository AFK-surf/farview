///| Farview host <-> client display-list wire protocol (Op, Message, Framer, Sender/Receiver).
///| 1:1 port of `src/wire/proto.mbt` and `src/wire/pieces.mbt`.

pub enum PathCmd {
  MoveTo(Double, Double)
  LineTo(Double, Double)
  QuadTo(Double, Double, Double, Double)
  CubicTo(Double, Double, Double, Double, Double, Double)
  Close
}

pub enum Op {
  Rect(Double, Double, Double, Double, Int)
  Glyphs(Int, Double, Double, Double, Int, Array[Int], Array[Double])
  Image(Double, Double, Double, Double, String)
  Clip(Double, Double, Double, Double)
  Unclip
  Mask(Double, Double, Double, Double, String, Int)
  VGlyphs(Int, Double, Int, Array[Int], Array[Bool], Array[Double], Array[Double])
  Round(Double, Double, Double, Double, Array[Double], Array[Double], Int)
  RoundClip(Double, Double, Double, Double, Array[Double])
  Gradient(Double, Double, Double, Double, Int, Array[Double], Array[Double], Array[Int])
  Transform(Double, Double, Double, Double, Double, Double, Double, Double)
  Untransform
  ScrollBox(Int, Double, Double, Double, Double, Double, Double)
  Hover(Int, Double, Double, Double, Double, Int)
  Shadow(Double, Double, Double, Double, Array[Double], Int, Bool)
}

pub enum Message {
  Hello(Double, Double, Double)
  Tap(Double, Double)
  Input(Int, String)
  Enter(Int)
  Go(String)
  Back
  Forward
  Reload
  Scroll(Double)
  ScrollTo(Double)
  Copied(String)
  Pointer(Int, Double, Double)
  Act(String, String, String)
  Look
  TakeOver
  Settle(Int)
  Settled
  Seen(String, String, String)
  Taken
  AgentOn(Bool)
  Eval(String)
  Value(String)
  Shot(Bytes)
  Pdf(Bytes)
  Cookies(String, String)
  Passkeys(String, String)
  Font(Int, Int, Int, Int, Bytes)
  Picture(String, Bytes)
  Focus(Int, Double, Double, Double, Double, String, Bool, Bool)
  Overlay(Array[Op])
  Outlines(Int, Int, Array[(Int, Array[PathCmd])])
  Page(String)
  Loaded
  Title(String)
  DragAreas(Array[(Double, Double, Double, Double, Bool)])
  Frame(Double, Double, Array[(Int, Double)], Array[(Int, Array[Op])])
  Person(String)
  BoxScroll(Int, Double, Double)
  Seq(Int)
  Acked(Int)
  HoverLook(Int, Int, Int, Array[Op])
  Marks(Array[Op])
  ComposeStart(String)
  ComposeUpdate(String)
  ComposeEnd(String)
  Copy
  Cut
  Paste(String)
  SelectAll
  Zoom(Double)
  FindResult(Int, Int)
  OmniboxResults(String)
  WorkspaceState(String)
  DownloadsState(String)
  HistoryState(String)
  DevToolsState(String)
  BookmarksState(String)
  ReaderState(String)
  BoostsState(String)
  SettingsState(String)
  SitePermissionsState(String)
  MediaHubState(String)
  PeekState(String)
  SiteCookiesState(String)
  ClosedTabsState(String)
  PerfHudState(String)
  SessionsState(String)
  ///| A site's icon (tag 69): its key (`proto::favicon_host_key`), the PNG's content hash, the PNG. Sent once per
  ///| client per hash. A decoder from before this tag reads it as a `Font` frame (its unknown-tag fallback), which
  ///| no consumer acts on; decoders from this tag on give None for any tag they do not know.
  SiteIcon(String, String, Bytes)
}

fn math_round(v : Double) -> Double {
  if v >= 0.0 {
    math_floor(v + 0.5)
  } else {
    0.0 - math_floor(0.0 - v + 0.5)
  }
}

fn round_to_int(v : Double) -> Int {
  math_round(v).to_int()
}

fn double_arr_eq(a : Array[Double], b : Array[Double]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn int_arr_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn bool_arr_eq(a : Array[Bool], b : Array[Bool]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

pub fn op_eq(a : Op, b : Op) -> Bool {
  match a {
    Op::Rect(x1, y1, w1, h1, c1) => match b {
      Op::Rect(x2, y2, w2, h2, c2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && c1 == c2
      _ => false
    }
    Op::Glyphs(f1, s1, x1, y1, c1, g1, d1) => match b {
      Op::Glyphs(f2, s2, x2, y2, c2, g2, d2) => f1 == f2 && s1 == s2 && x1 == x2 && y1 == y2 && c1 == c2 && int_arr_eq(g1, g2) && double_arr_eq(d1, d2)
      _ => false
    }
    Op::Image(x1, y1, w1, h1, u1) => match b {
      Op::Image(x2, y2, w2, h2, u2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && u1 == u2
      _ => false
    }
    Op::Clip(x1, y1, w1, h1) => match b {
      Op::Clip(x2, y2, w2, h2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2
      _ => false
    }
    Op::Unclip => match b {
      Op::Unclip => true
      _ => false
    }
    Op::Mask(x1, y1, w1, h1, u1, c1) => match b {
      Op::Mask(x2, y2, w2, h2, u2, c2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && u1 == u2 && c1 == c2
      _ => false
    }
    Op::VGlyphs(f1, s1, c1, g1, t1, xs1, ys1) => match b {
      Op::VGlyphs(f2, s2, c2, g2, t2, xs2, ys2) => f1 == f2 && s1 == s2 && c1 == c2 && int_arr_eq(g1, g2) && bool_arr_eq(t1, t2) && double_arr_eq(xs1, xs2) && double_arr_eq(ys1, ys2)
      _ => false
    }
    Op::Round(x1, y1, w1, h1, r1, ring1, c1) => match b {
      Op::Round(x2, y2, w2, h2, r2, ring2, c2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(r1, r2) && double_arr_eq(ring1, ring2) && c1 == c2
      _ => false
    }
    Op::RoundClip(x1, y1, w1, h1, r1) => match b {
      Op::RoundClip(x2, y2, w2, h2, r2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(r1, r2)
      _ => false
    }
    Op::Gradient(x1, y1, w1, h1, k1, g1, o1, c1) => match b {
      Op::Gradient(x2, y2, w2, h2, k2, g2, o2, c2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && k1 == k2 && double_arr_eq(g1, g2) && double_arr_eq(o1, o2) && int_arr_eq(c1, c2)
      _ => false
    }
    Op::Transform(ox1, oy1, a1, b1, c1, d1, tx1, ty1) => match b {
      Op::Transform(ox2, oy2, a2, b2, c2, d2, tx2, ty2) => ox1 == ox2 && oy1 == oy2 && a1 == a2 && b1 == b2 && c1 == c2 && d1 == d2 && tx1 == tx2 && ty1 == ty2
      _ => false
    }
    Op::Untransform => match b {
      Op::Untransform => true
      _ => false
    }
    Op::ScrollBox(id1, x1, y1, w1, h1, cw1, ch1) => match b {
      Op::ScrollBox(id2, x2, y2, w2, h2, cw2, ch2) => id1 == id2 && x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && cw1 == cw2 && ch1 == ch2
      _ => false
    }
    Op::Hover(id1, x1, y1, w1, h1, cur1) => match b {
      Op::Hover(id2, x2, y2, w2, h2, cur2) => id1 == id2 && x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && cur1 == cur2
      _ => false
    }
    Op::Shadow(x1, y1, w1, h1, g1, c1, in1) => match b {
      Op::Shadow(x2, y2, w2, h2, g2, c2, in2) => x1 == x2 && y1 == y2 && w1 == w2 && h1 == h2 && double_arr_eq(g1, g2) && c1 == c2 && in1 == in2
      _ => false
    }
  }
}

struct Writer {
  mut buf : Bytes
  mut n : Int
}

fn Writer::new() -> Writer {
  Writer::{ buf: Bytes::new(256), n: 0 }
}

fn Writer::reset(self : Writer) -> Unit {
  self.n = 0
}

fn Writer::ensure(self : Writer, extra : Int) -> Unit {
  if self.n + extra <= self.buf.length() {
    return
  }
  let mut cap = self.buf.length() * 2
  while cap < self.n + extra {
    cap = cap * 2
  }
  let bigger = Bytes::new(cap)
  let mut i = 0
  while i < self.n {
    bigger[i] = self.buf[i]
    i = i + 1
  }
  self.buf = bigger
}

fn Writer::write_byte(self : Writer, b : Int) -> Unit {
  self.ensure(1)
  self.buf[self.n] = (b & 0xFF).to_byte()
  self.n = self.n + 1
}

fn Writer::write_bytes(self : Writer, b : Bytes) -> Unit {
  let len = b.length()
  self.ensure(len)
  let mut i = 0
  while i < len {
    self.buf[self.n + i] = b[i]
    i = i + 1
  }
  self.n = self.n + len
}

fn Writer::to_bytes(self : Writer) -> Bytes {
  self.buf.slice(0, self.n)
}

fn Writer::int(self : Writer, v : Int) -> Unit {
  let zz = (v << 1) ^ (v >> 31)
  let mut u = zz.to_int64() & 0xFFFFFFFFL
  while u >= 0x80L {
    self.write_byte(((u & 0x7FL) | 0x80L).to_int())
    u = u >> 7L
  }
  self.write_byte(u.to_int())
}

fn Writer::num(self : Writer, v : Double) -> Unit {
  self.int(round_to_int(v * 64.0))
}

fn Writer::path(self : Writer, cmds : Array[PathCmd]) -> Unit {
  self.int(cmds.length())
  let mut lx = 0
  let mut ly = 0
  let mut i = 0
  while i < cmds.length() {
    match cmds[i] {
      PathCmd::MoveTo(x, y) => {
        self.int(0)
        let qx = round_to_int(x * 4.0)
        let qy = round_to_int(y * 4.0)
        self.int(qx - lx)
        self.int(qy - ly)
        lx = qx
        ly = qy
      }
      PathCmd::LineTo(x, y) => {
        self.int(1)
        let qx = round_to_int(x * 4.0)
        let qy = round_to_int(y * 4.0)
        self.int(qx - lx)
        self.int(qy - ly)
        lx = qx
        ly = qy
      }
      PathCmd::QuadTo(a, b, x, y) => {
        self.int(2)
        let qax = round_to_int(a * 4.0)
        let qay = round_to_int(b * 4.0)
        self.int(qax - lx)
        self.int(qay - ly)
        lx = qax
        ly = qay
        let qx = round_to_int(x * 4.0)
        let qy = round_to_int(y * 4.0)
        self.int(qx - lx)
        self.int(qy - ly)
        lx = qx
        ly = qy
      }
      PathCmd::CubicTo(a, b, c2, d, x, y) => {
        self.int(3)
        let qax = round_to_int(a * 4.0)
        let qay = round_to_int(b * 4.0)
        self.int(qax - lx)
        self.int(qay - ly)
        lx = qax
        ly = qay
        let qcx = round_to_int(c2 * 4.0)
        let qcy = round_to_int(d * 4.0)
        self.int(qcx - lx)
        self.int(qcy - ly)
        lx = qcx
        ly = qcy
        let qx = round_to_int(x * 4.0)
        let qy = round_to_int(y * 4.0)
        self.int(qx - lx)
        self.int(qy - ly)
        lx = qx
        ly = qy
      }
      PathCmd::Close => self.int(4)
    }
    i = i + 1
  }
}

fn Writer::string(self : Writer, s : String) -> Unit {
  let b = s.to_bytes()
  self.int(b.length())
  self.write_bytes(b)
}

fn Writer::op(self : Writer, op : Op) -> Unit {
  match op {
    Op::Rect(x, y, w, h, c) => {
      self.int(0)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      self.int(c)
    }
    Op::Glyphs(f, size, x, y, c, gids, dx) => {
      self.int(1)
      self.int(f)
      self.num(size)
      self.num(x)
      self.num(y)
      self.int(c)
      self.int(gids.length())
      let mut last = 0
      let mut i = 0
      while i < gids.length() {
        let g = gids[i]
        self.int(g - last)
        last = g
        self.num(dx[i])
        i = i + 1
      }
    }
    Op::Image(x, y, w, h, u) => {
      self.int(2)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      self.string(u)
    }
    Op::Clip(x, y, w, h) => {
      self.int(3)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
    }
    Op::Unclip => self.int(4)
    Op::Mask(x, y, w, h, u, c) => {
      self.int(5)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      self.string(u)
      self.int(c)
    }
    Op::VGlyphs(f, size, c, gids, turned, xs, ys) => {
      self.int(6)
      self.int(f)
      self.num(size)
      self.int(c)
      self.int(gids.length())
      let mut i = 0
      while i < gids.length() {
        self.int(gids[i])
        self.int(if turned[i] { 1 } else { 0 })
        self.num(xs[i])
        self.num(ys[i])
        i = i + 1
      }
    }
    Op::Round(x, y, w, h, radii, ring, c) => {
      self.int(if radii.length() >= 8 { 15 } else { 7 })
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      let lim = if radii.length() >= 8 { 8 } else { 4 }
      let mut i = 0
      while i < lim {
        self.num(if i < radii.length() { radii[i] } else { 0.0 })
        i = i + 1
      }
      self.int(ring.length())
      let mut j = 0
      while j < ring.length() {
        self.num(ring[j])
        j = j + 1
      }
      self.int(c)
    }
    Op::RoundClip(x, y, w, h, radii) => {
      self.int(if radii.length() >= 8 { 16 } else { 8 })
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      let lim = if radii.length() >= 8 { 8 } else { 4 }
      let mut i = 0
      while i < lim {
        self.num(if i < radii.length() { radii[i] } else { 0.0 })
        i = i + 1
      }
    }
    Op::Gradient(x, y, w, h, kind, geom, offsets, colors) => {
      self.int(9)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      self.int(kind)
      self.int(geom.length())
      let mut i = 0
      while i < geom.length() {
        self.num(geom[i])
        i = i + 1
      }
      self.int(offsets.length())
      let mut j = 0
      while j < offsets.length() {
        self.int(round_to_int(offsets[j] * 65536.0))
        self.int(colors[j])
        j = j + 1
      }
    }
    Op::Transform(ox, oy, a, b, c, d, tx, ty) => {
      self.int(10)
      self.num(ox)
      self.num(oy)
      self.int(round_to_int(a * 65536.0))
      self.int(round_to_int(b * 65536.0))
      self.int(round_to_int(c * 65536.0))
      self.int(round_to_int(d * 65536.0))
      self.num(tx)
      self.num(ty)
    }
    Op::Untransform => self.int(11)
    Op::ScrollBox(id, x, y, w, h, cw, ch) => {
      self.int(12)
      self.int(id)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      self.num(cw)
      self.num(ch)
    }
    Op::Hover(id, x, y, w, h, cursor) => {
      self.int(13)
      self.int(id)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      self.int(cursor)
    }
    Op::Shadow(x, y, w, h, g, c, inset) => {
      self.int(14)
      self.num(x)
      self.num(y)
      self.num(w)
      self.num(h)
      let mut i = 0
      while i < 9 {
        let v = if i < g.length() { g[i] } else if i == 8 { 1.0 } else { 0.0 }
        self.num(v)
        i = i + 1
      }
      self.int(c)
      self.int(if inset { 1 } else { 0 })
    }
  }
}

pub fn encode(m : Message) -> Bytes {
  let w = Writer::new()
  match m {
    Message::Hello(a, b, c) => {
      w.int(1)
      w.num(a)
      w.num(b)
      w.num(c)
    }
    Message::Tap(x, y) => {
      w.int(2)
      w.num(x)
      w.num(y)
    }
    Message::Font(k, i, wg, o, data) => {
      w.int(4)
      w.int(k)
      w.int(i)
      w.int(wg)
      w.int(o)
      w.int(data.length())
      w.write_bytes(data)
    }
    Message::Picture(u, data) => {
      w.int(5)
      w.string(u)
      w.int(data.length())
      w.write_bytes(data)
    }
    Message::Input(id, v) => {
      w.int(6)
      w.int(id)
      w.string(v)
    }
    Message::Enter(id) => {
      w.int(7)
      w.int(id)
    }
    Message::Focus(id, x, y, fw, fh, v, multi, secret) => {
      w.int(8)
      w.int(id)
      w.num(x)
      w.num(y)
      w.num(fw)
      w.num(fh)
      w.string(v)
      w.int((if multi { 1 } else { 0 }) + (if secret { 2 } else { 0 }))
    }
    Message::Overlay(ops) => {
      w.int(9)
      w.int(ops.length())
      let mut i = 0
      while i < ops.length() {
        w.op(ops[i])
        i = i + 1
      }
    }
    Message::Outlines(k, per_em, glyphs) => {
      w.int(10)
      w.int(k)
      w.int(per_em)
      w.int(glyphs.length())
      let mut i = 0
      while i < glyphs.length() {
        let (gid, cmds) = glyphs[i]
        w.int(gid)
        w.path(cmds)
        i = i + 1
      }
    }
    Message::Page(u) => {
      w.int(11)
      w.string(u)
    }
    Message::Frame(a, b, order, fresh) => {
      w.int(12)
      w.num(a)
      w.num(b)
      w.int(order.length())
      let mut i = 0
      while i < order.length() {
        let (id, y) = order[i]
        w.int(id)
        w.num(y)
        i = i + 1
      }
      w.int(fresh.length())
      let mut j = 0
      while j < fresh.length() {
        let (id, ops) = fresh[j]
        w.int(id)
        w.int(ops.length())
        let mut k = 0
        while k < ops.length() {
          w.op(ops[k])
          k = k + 1
        }
        j = j + 1
      }
    }
    Message::Go(u) => {
      w.int(13)
      w.string(u)
    }
    Message::Back => w.int(14)
    Message::Forward => w.int(15)
    Message::Reload => w.int(16)
    Message::Scroll(y) => {
      w.int(17)
      w.num(y)
    }
    Message::Act(verb, sel, text) => {
      w.int(18)
      w.string(verb)
      w.string(sel)
      w.string(text)
    }
    Message::Look => w.int(19)
    Message::Seen(u, t, o) => {
      w.int(20)
      w.string(u)
      w.string(t)
      w.string(o)
    }
    Message::Taken => w.int(21)
    Message::AgentOn(on) => {
      w.int(22)
      w.int(if on { 1 } else { 0 })
    }
    Message::TakeOver => w.int(23)
    Message::Loaded => w.int(24)
    Message::Title(t) => {
      w.int(25)
      w.string(t)
    }
    Message::Pointer(k, x, y) => {
      w.int(26)
      w.int(k)
      w.num(x)
      w.num(y)
    }
    Message::DragAreas(list) => {
      w.int(27)
      w.int(list.length())
      let mut i = 0
      while i < list.length() {
        let (x, y, dw, dh, fixed) = list[i]
        w.num(x)
        w.num(y)
        w.num(dw)
        w.num(dh)
        w.int(if fixed { 1 } else { 0 })
        i = i + 1
      }
    }
    Message::Settle(ms) => {
      w.int(28)
      w.int(ms)
    }
    Message::Settled => w.int(29)
    Message::ScrollTo(y) => {
      w.int(30)
      w.num(y)
    }
    Message::Copied(t) => {
      w.int(31)
      w.string(t)
    }
    Message::Eval(src) => {
      w.int(32)
      w.string(src)
    }
    Message::Value(v) => {
      w.int(33)
      w.string(v)
    }
    Message::Shot(data) => {
      w.int(34)
      w.int(data.length())
      w.write_bytes(data)
    }
    Message::Cookies(verb, arg) => {
      w.int(35)
      w.string(verb)
      w.string(arg)
    }
    Message::Person(json) => {
      w.int(36)
      w.string(json)
    }
    Message::Marks(ops) => {
      w.int(37)
      w.int(ops.length())
      let mut i = 0
      while i < ops.length() {
        w.op(ops[i])
        i = i + 1
      }
    }
    Message::BoxScroll(id, x, y) => {
      w.int(38)
      w.int(id)
      w.num(x)
      w.num(y)
    }
    Message::Seq(n) => {
      w.int(39)
      w.int(n)
    }
    Message::Acked(n) => {
      w.int(40)
      w.int(n)
    }
    Message::HoverLook(id, start, end, ops) => {
      w.int(41)
      w.int(id)
      w.int(start)
      w.int(end)
      w.int(ops.length())
      let mut i = 0
      while i < ops.length() {
        w.op(ops[i])
        i = i + 1
      }
    }
    Message::Passkeys(verb, arg) => {
      w.int(42)
      w.string(verb)
      w.string(arg)
    }
    Message::Pdf(data) => {
      w.int(43)
      w.int(data.length())
      w.write_bytes(data)
    }
    Message::ComposeStart(data) => {
      w.int(44)
      w.string(data)
    }
    Message::ComposeUpdate(data) => {
      w.int(45)
      w.string(data)
    }
    Message::ComposeEnd(data) => {
      w.int(46)
      w.string(data)
    }
    Message::Copy => w.int(47)
    Message::Cut => w.int(48)
    Message::Paste(text) => {
      w.int(49)
      w.string(text)
    }
    Message::SelectAll => w.int(50)
    Message::Zoom(z) => {
      w.int(51)
      w.int(round_to_int(z * 10000.0))
    }
    Message::FindResult(active, total) => {
      w.int(52)
      w.int(active)
      w.int(total)
    }
    Message::OmniboxResults(json) => {
      w.int(53)
      w.string(json)
    }
    Message::WorkspaceState(json) => {
      w.int(54)
      w.string(json)
    }
    Message::DownloadsState(json) => {
      w.int(55)
      w.string(json)
    }
    Message::HistoryState(json) => {
      w.int(56)
      w.string(json)
    }
    Message::DevToolsState(json) => {
      w.int(57)
      w.string(json)
    }
    Message::BookmarksState(json) => {
      w.int(58)
      w.string(json)
    }
    Message::ReaderState(json) => {
      w.int(59)
      w.string(json)
    }
    Message::BoostsState(json) => {
      w.int(60)
      w.string(json)
    }
    Message::SettingsState(json) => {
      w.int(61)
      w.string(json)
    }
    Message::SitePermissionsState(json) => {
      w.int(62)
      w.string(json)
    }
    Message::MediaHubState(json) => {
      w.int(63)
      w.string(json)
    }
    Message::PeekState(json) => {
      w.int(64)
      w.string(json)
    }
    Message::SiteCookiesState(json) => {
      w.int(65)
      w.string(json)
    }
    Message::ClosedTabsState(json) => {
      w.int(66)
      w.string(json)
    }
    Message::PerfHudState(json) => {
      w.int(67)
      w.string(json)
    }
    Message::SessionsState(json) => {
      w.int(68)
      w.string(json)
    }
    Message::SiteIcon(key, hash, png) => {
      w.int(69)
      w.string(key)
      w.string(hash)
      w.int(png.length())
      w.write_bytes(png)
    }
  }
  let body = w.to_bytes()
  let n = body.length()
  let out = Bytes::new(4 + n)
  out[0] = ((n >> 24) & 255).to_byte()
  out[1] = ((n >> 16) & 255).to_byte()
  out[2] = ((n >> 8) & 255).to_byte()
  out[3] = (n & 255).to_byte()
  let mut i = 0
  while i < n {
    out[4 + i] = body[i]
    i = i + 1
  }
  out
}

struct Reader {
  b : Bytes
  mut i : Int
  mut bad : Bool
}

fn Reader::int(self : Reader) -> Int {
  let mut shift = 0L
  let mut u = 0L
  let mut done = false
  while !done {
    if self.i >= self.b.length() || shift >= 35L {
      self.bad = true
      return 0
    }
    let c = self.b[self.i].to_int().to_int64() & 0xFFL
    self.i = self.i + 1
    u = u | ((c & 0x7FL) << shift)
    shift = shift + 7L
    if c < 0x80L {
      done = true
    }
  }
  let u32 = u & 0xFFFFFFFFL
  let shifted = (u32 >> 1L).to_int()
  let neg = 0 - (u32 & 1L).to_int()
  shifted ^ neg
}

fn Reader::count(self : Reader) -> Int {
  let n = self.int()
  if n < 0 || n > self.b.length() - self.i {
    self.bad = true
    return 0
  }
  n
}

fn Reader::take(self : Reader, n : Int) -> Bytes {
  if n < 0 || n > self.b.length() - self.i {
    self.bad = true
    self.i = self.b.length()
    return Bytes::new(0)
  }
  let out = self.b.slice(self.i, self.i + n)
  self.i = self.i + n
  out
}

fn Reader::num(self : Reader) -> Double {
  (self.int() as Double) / 64.0
}

fn Reader::string(self : Reader) -> String {
  let n = self.int()
  self.take(n).to_string()
}

fn Reader::op(self : Reader) -> Op {
  let tag = self.int()
  if tag == 0 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    Op::Rect(x, y, w, h, self.int())
  } else if tag == 1 {
    let f = self.int()
    let size = self.num()
    let x = self.num()
    let y = self.num()
    let c = self.int()
    let n = self.count()
    let gids : Array[Int] = []
    let dx : Array[Double] = []
    let mut last = 0
    let mut i = 0
    while i < n {
      last = last + self.int()
      gids.push(last)
      dx.push(self.num())
      i = i + 1
    }
    Op::Glyphs(f, size, x, y, c, gids, dx)
  } else if tag == 2 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    Op::Image(x, y, w, h, self.string())
  } else if tag == 3 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    Op::Clip(x, y, w, self.num())
  } else if tag == 5 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let u = self.string()
    Op::Mask(x, y, w, h, u, self.int())
  } else if tag == 6 {
    let f = self.int()
    let size = self.num()
    let c = self.int()
    let n = self.count()
    let gids : Array[Int] = []
    let turned : Array[Bool] = []
    let xs : Array[Double] = []
    let ys : Array[Double] = []
    let mut i = 0
    while i < n {
      gids.push(self.int())
      turned.push(self.int() == 1)
      xs.push(self.num())
      ys.push(self.num())
      i = i + 1
    }
    Op::VGlyphs(f, size, c, gids, turned, xs, ys)
  } else if tag == 7 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let r0 = self.num()
    let r1 = self.num()
    let r2 = self.num()
    let r3 = self.num()
    let radii : Array[Double] = [r0, r1, r2, r3]
    let n = self.count()
    let ring : Array[Double] = []
    let mut i = 0
    while i < n {
      ring.push(self.num())
      i = i + 1
    }
    Op::Round(x, y, w, h, radii, ring, self.int())
  } else if tag == 8 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let r0 = self.num()
    let r1 = self.num()
    let r2 = self.num()
    let r3 = self.num()
    Op::RoundClip(x, y, w, h, [r0, r1, r2, r3])
  } else if tag == 15 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let radii : Array[Double] = [self.num(), self.num(), self.num(), self.num(), self.num(), self.num(), self.num(), self.num()]
    let n = self.count()
    let ring : Array[Double] = []
    let mut i = 0
    while i < n {
      ring.push(self.num())
      i = i + 1
    }
    Op::Round(x, y, w, h, radii, ring, self.int())
  } else if tag == 16 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    Op::RoundClip(x, y, w, h, [self.num(), self.num(), self.num(), self.num(), self.num(), self.num(), self.num(), self.num()])
  } else if tag == 9 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let kind = self.int()
    let gn = self.count()
    let geom : Array[Double] = []
    let mut i = 0
    while i < gn {
      geom.push(self.num())
      i = i + 1
    }
    let sn = self.count()
    let offsets : Array[Double] = []
    let colors : Array[Int] = []
    let mut j = 0
    while j < sn {
      offsets.push((self.int() as Double) / 65536.0)
      colors.push(self.int())
      j = j + 1
    }
    Op::Gradient(x, y, w, h, kind, geom, offsets, colors)
  } else if tag == 10 {
    let ox = self.num()
    let oy = self.num()
    let a = (self.int() as Double) / 65536.0
    let b = (self.int() as Double) / 65536.0
    let c = (self.int() as Double) / 65536.0
    let d = (self.int() as Double) / 65536.0
    let tx = self.num()
    let ty = self.num()
    Op::Transform(ox, oy, a, b, c, d, tx, ty)
  } else if tag == 11 {
    Op::Untransform
  } else if tag == 12 {
    let id = self.int()
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let cw = self.num()
    Op::ScrollBox(id, x, y, w, h, cw, self.num())
  } else if tag == 13 {
    let id = self.int()
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    Op::Hover(id, x, y, w, h, self.int())
  } else if tag == 14 {
    let x = self.num()
    let y = self.num()
    let w = self.num()
    let h = self.num()
    let g : Array[Double] = []
    let mut i = 0
    while i < 9 {
      g.push(self.num())
      i = i + 1
    }
    let c = self.int()
    Op::Shadow(x, y, w, h, g, c, self.int() == 1)
  } else {
    Op::Unclip
  }
}

fn Reader::path(self : Reader) -> Array[PathCmd] {
  let n = self.count()
  let out : Array[PathCmd] = []
  let mut lx = 0
  let mut ly = 0
  let mut i = 0
  while i < n {
    let kind = self.int()
    if kind == 0 {
      lx = lx + self.int()
      ly = ly + self.int()
      out.push(PathCmd::MoveTo((lx) as Double / 4.0, (ly) as Double / 4.0))
    } else if kind == 1 {
      lx = lx + self.int()
      ly = ly + self.int()
      out.push(PathCmd::LineTo((lx) as Double / 4.0, (ly) as Double / 4.0))
    } else if kind == 2 {
      lx = lx + self.int()
      ly = ly + self.int()
      let ax = (lx) as Double / 4.0
      let ay = (ly) as Double / 4.0
      lx = lx + self.int()
      ly = ly + self.int()
      out.push(PathCmd::QuadTo(ax, ay, (lx) as Double / 4.0, (ly) as Double / 4.0))
    } else if kind == 3 {
      lx = lx + self.int()
      ly = ly + self.int()
      let ax = (lx) as Double / 4.0
      let ay = (ly) as Double / 4.0
      lx = lx + self.int()
      ly = ly + self.int()
      let cx = (lx) as Double / 4.0
      let cy = (ly) as Double / 4.0
      lx = lx + self.int()
      ly = ly + self.int()
      out.push(PathCmd::CubicTo(ax, ay, cx, cy, (lx) as Double / 4.0, (ly) as Double / 4.0))
    } else {
      out.push(PathCmd::Close)
    }
    i = i + 1
  }
  out
}

pub fn decode(b : Bytes) -> Option[Message] {
  let r = Reader::{ b: b, i: 0, bad: false }
  let m = decode_message(r)
  if r.bad {
    Option::None
  } else {
    Option::Some(m)
  }
}

fn decode_message(r : Reader) -> Message {
  let tag = r.int()
  if tag == 1 {
    let a = r.num()
    let c = r.num()
    Message::Hello(a, c, r.num())
  } else if tag == 2 {
    let x = r.num()
    Message::Tap(x, r.num())
  } else if tag == 5 {
    let u = r.string()
    let n = r.int()
    Message::Picture(u, r.take(n))
  } else if tag == 6 {
    let id = r.int()
    Message::Input(id, r.string())
  } else if tag == 7 {
    Message::Enter(r.int())
  } else if tag == 8 {
    let id = r.int()
    let x = r.num()
    let y = r.num()
    let fw = r.num()
    let fh = r.num()
    let v = r.string()
    let flags = r.int()
    Message::Focus(id, x, y, fw, fh, v, (flags & 1) == 1, (flags & 2) == 2)
  } else if tag == 9 {
    let n = r.count()
    let ops : Array[Op] = []
    let mut i = 0
    while i < n {
      ops.push(r.op())
      i = i + 1
    }
    Message::Overlay(ops)
  } else if tag == 10 {
    let k = r.int()
    let per_em = r.int()
    let n = r.count()
    let glyphs : Array[(Int, Array[PathCmd])] = []
    let mut i = 0
    while i < n {
      let g = r.int()
      glyphs.push((g, r.path()))
      i = i + 1
    }
    Message::Outlines(k, per_em, glyphs)
  } else if tag == 11 {
    Message::Page(r.string())
  } else if tag == 12 {
    let a = r.num()
    let c = r.num()
    let n = r.count()
    let order : Array[(Int, Double)] = []
    let mut i = 0
    while i < n {
      let id = r.int()
      order.push((id, r.num()))
      i = i + 1
    }
    let m = r.count()
    let fresh : Array[(Int, Array[Op])] = []
    let mut j = 0
    while j < m {
      let id = r.int()
      let k = r.count()
      let ops : Array[Op] = []
      let mut kk = 0
      while kk < k {
        ops.push(r.op())
        kk = kk + 1
      }
      fresh.push((id, ops))
      j = j + 1
    }
    Message::Frame(a, c, order, fresh)
  } else if tag == 13 {
    Message::Go(r.string())
  } else if tag == 14 {
    Message::Back
  } else if tag == 15 {
    Message::Forward
  } else if tag == 16 {
    Message::Reload
  } else if tag == 17 {
    Message::Scroll(r.num())
  } else if tag == 18 {
    let verb = r.string()
    let sel = r.string()
    Message::Act(verb, sel, r.string())
  } else if tag == 19 {
    Message::Look
  } else if tag == 20 {
    let u = r.string()
    let t = r.string()
    Message::Seen(u, t, r.string())
  } else if tag == 21 {
    Message::Taken
  } else if tag == 22 {
    Message::AgentOn(r.int() == 1)
  } else if tag == 23 {
    Message::TakeOver
  } else if tag == 24 {
    Message::Loaded
  } else if tag == 25 {
    Message::Title(r.string())
  } else if tag == 26 {
    let k = r.int()
    let x = r.num()
    Message::Pointer(k, x, r.num())
  } else if tag == 27 {
    let n = r.count()
    let list : Array[(Double, Double, Double, Double, Bool)] = []
    let mut i = 0
    while i < n {
      let x = r.num()
      let y = r.num()
      let w = r.num()
      let h = r.num()
      list.push((x, y, w, h, r.int() == 1))
      i = i + 1
    }
    Message::DragAreas(list)
  } else if tag == 28 {
    Message::Settle(r.int())
  } else if tag == 29 {
    Message::Settled
  } else if tag == 30 {
    Message::ScrollTo(r.num())
  } else if tag == 31 {
    Message::Copied(r.string())
  } else if tag == 32 {
    Message::Eval(r.string())
  } else if tag == 33 {
    Message::Value(r.string())
  } else if tag == 34 {
    let n = r.int()
    Message::Shot(r.take(n))
  } else if tag == 35 {
    let verb = r.string()
    Message::Cookies(verb, r.string())
  } else if tag == 36 {
    Message::Person(r.string())
  } else if tag == 37 {
    let n = r.count()
    let ops : Array[Op] = []
    let mut i = 0
    while i < n {
      ops.push(r.op())
      i = i + 1
    }
    Message::Marks(ops)
  } else if tag == 38 {
    let id = r.int()
    let x = r.num()
    Message::BoxScroll(id, x, r.num())
  } else if tag == 39 {
    Message::Seq(r.int())
  } else if tag == 40 {
    Message::Acked(r.int())
  } else if tag == 41 {
    let id = r.int()
    let start = r.int()
    let end = r.int()
    let n = r.count()
    let ops : Array[Op] = []
    let mut i = 0
    while i < n {
      ops.push(r.op())
      i = i + 1
    }
    Message::HoverLook(id, start, end, ops)
  } else if tag == 42 {
    let verb = r.string()
    Message::Passkeys(verb, r.string())
  } else if tag == 43 {
    let n = r.int()
    Message::Pdf(r.take(n))
  } else if tag == 44 {
    Message::ComposeStart(r.string())
  } else if tag == 45 {
    Message::ComposeUpdate(r.string())
  } else if tag == 46 {
    Message::ComposeEnd(r.string())
  } else if tag == 47 {
    Message::Copy
  } else if tag == 48 {
    Message::Cut
  } else if tag == 49 {
    Message::Paste(r.string())
  } else if tag == 50 {
    Message::SelectAll
  } else if tag == 51 {
    Message::Zoom((r.int() as Double) / 10000.0)
  } else if tag == 52 {
    let active = r.int()
    Message::FindResult(active, r.int())
  } else if tag == 53 {
    Message::OmniboxResults(r.string())
  } else if tag == 54 {
    Message::WorkspaceState(r.string())
  } else if tag == 55 {
    Message::DownloadsState(r.string())
  } else if tag == 56 {
    Message::HistoryState(r.string())
  } else if tag == 57 {
    Message::DevToolsState(r.string())
  } else if tag == 58 {
    Message::BookmarksState(r.string())
  } else if tag == 59 {
    Message::ReaderState(r.string())
  } else if tag == 60 {
    Message::BoostsState(r.string())
  } else if tag == 61 {
    Message::SettingsState(r.string())
  } else if tag == 62 {
    Message::SitePermissionsState(r.string())
  } else if tag == 63 {
    Message::MediaHubState(r.string())
  } else if tag == 64 {
    Message::PeekState(r.string())
  } else if tag == 65 {
    Message::SiteCookiesState(r.string())
  } else if tag == 66 {
    Message::ClosedTabsState(r.string())
  } else if tag == 67 {
    Message::PerfHudState(r.string())
  } else if tag == 68 {
    Message::SessionsState(r.string())
  } else if tag == 69 {
    let key = r.string()
    let hash = r.string()
    let n = r.int()
    Message::SiteIcon(key, hash, r.take(n))
  } else if tag == 4 {
    let k = r.int()
    let i = r.int()
    let wg = r.int()
    let o = r.int()
    let n = r.int()
    Message::Font(k, i, wg, o, r.take(n))
  } else {
    // A tag this side does not know (a newer peer's message): not read as anything, so `decode` gives None and the
    // caller goes on to the next frame. (Before tag 69, unknown tags fell through to Font and an old decoder reads a
    // SiteIcon as a small Font frame; no consumer acts on Font, so it is harmless there, but it is not "dropped".)
    r.bad = true
    Message::Title("")
  }
}

pub struct Framer {
  mut buf : Bytes
  mut start : Int
  mut end : Int
  mut is_broken : Bool
}

let max_message : Int = 268435456

pub fn Framer::new() -> Framer {
  Framer::{ buf: Bytes::new(65536), start: 0, end: 0, is_broken: false }
}

pub fn Framer::broken(self : Framer) -> Bool {
  self.is_broken
}

pub fn Framer::clear(self : Framer) -> Unit {
  self.start = 0
  self.end = 0
  self.is_broken = false
}

extern "C" fn wire_c_memmove(dst : Ptr, src : Ptr, n : Int64) -> Ptr = "memmove"

fn wire_bytes_blit(dst : Bytes, dst_off : Int, src : Bytes, src_off : Int, len : Int) -> Unit {
  if len <= 0 {
    return
  }
  let _ = wire_c_memmove(
    ptr_offset(bytes_data_ptr(dst), dst_off.to_int64()),
    ptr_offset(bytes_data_ptr(src), src_off.to_int64()),
    len.to_int64(),
  )
}

pub fn Framer::push(self : Framer, chunk : Bytes) -> Unit {
  let n = chunk.length()
  if n == 0 {
    return
  }
  if self.end + n > self.buf.length() {
    let live = self.end - self.start
    let need = live + n
    if need <= self.buf.length() / 2 && self.start > 0 {
      wire_bytes_blit(self.buf, 0, self.buf, self.start, live)
      self.start = 0
      self.end = live
    } else {
      let mut want = need
      if live >= 4 {
        let d = self.buf
        let s = self.start
        let hdr_n = (d[s].to_int() << 24) | (d[s + 1].to_int() << 16) | (d[s + 2].to_int() << 8) | d[s + 3].to_int()
        if hdr_n > 0 && hdr_n <= max_message {
          let frame_need = 4 + hdr_n
          if frame_need > want {
            want = frame_need
          }
        }
      }
      let mut c = self.buf.length() * 2
      if c < 65536 {
        c = 65536
      }
      while c < want {
        c = c * 2
      }
      let size = if want > need && want >= 262144 { want + 4096 } else { c }
      let fresh = Bytes::new(size)
      wire_bytes_blit(fresh, 0, self.buf, self.start, live)
      self.buf = fresh
      self.start = 0
      self.end = live
    }
  }
  wire_bytes_blit(self.buf, self.end, chunk, 0, n)
  self.end = self.end + n
}

pub fn Framer::next(self : Framer) -> Option[Bytes] {
  if self.is_broken || self.end - self.start < 4 {
    return Option::None
  }
  let d = self.buf
  let s = self.start
  let n = (d[s].to_int() << 24) | (d[s + 1].to_int() << 16) | (d[s + 2].to_int() << 8) | d[s + 3].to_int()
  if n < 0 || n > max_message {
    self.is_broken = true
    self.start = 0
    self.end = 0
    return Option::None
  }
  if self.end - s < 4 + n {
    return Option::None
  }
  let body = d.slice(s + 4, s + 4 + n)
  self.start = s + 4 + n
  if self.start == self.end {
    self.start = 0
    self.end = 0
    if self.buf.length() > 4194304 {
      self.buf = Bytes::new(65536)
    }
  }
  Option::Some(body)
}

// --- pieces.mbt ---

fn op_bytes(op : Op) -> Bytes {
  let w = Writer::new()
  w.op(op)
  w.to_bytes()
}

fn fnv(b : Bytes) -> Int64 {
  let mut h = 2166136261L
  let mut i = 0
  while i < b.length() {
    let x = b[i].to_int().to_int64() & 0xFFL
    h = ((h ^ x) * 16777619L) & 0xFFFFFFFFL
    i = i + 1
  }
  h
}

fn bytes_to_hex(b : Bytes) -> String {
  let hex = "0123456789abcdef".to_bytes()
  let n = b.length()
  let out = Bytes::new(n * 2)
  let mut i = 0
  while i < n {
    let v = b[i].to_int() & 0xFF
    out[i * 2] = hex[v >> 4]
    out[i * 2 + 1] = hex[v & 15]
    i = i + 1
  }
  out.to_string()
}

pub fn op_shift(op : Op, dx : Double, dy : Double) -> Op {
  if dx == 0.0 && dy == 0.0 {
    return op
  }
  match op {
    Op::Rect(x, y, w, h, c) => Op::Rect(x + dx, y + dy, w, h, c)
    Op::Glyphs(f, size, x, y, c, g, a) => Op::Glyphs(f, size, x + dx, y + dy, c, g, a)
    Op::Image(x, y, w, h, u) => Op::Image(x + dx, y + dy, w, h, u)
    Op::Clip(x, y, w, h) => Op::Clip(x + dx, y + dy, w, h)
    Op::Mask(x, y, w, h, u, c) => Op::Mask(x + dx, y + dy, w, h, u, c)
    Op::VGlyphs(f, size, c, g, t, xs, ys) => {
      let nxs : Array[Double] = []
      let nys : Array[Double] = []
      let mut i = 0
      while i < xs.length() {
        nxs.push(xs[i] + dx)
        i = i + 1
      }
      let mut j = 0
      while j < ys.length() {
        nys.push(ys[j] + dy)
        j = j + 1
      }
      Op::VGlyphs(f, size, c, g, t, nxs, nys)
    }
    Op::Round(x, y, w, h, r, ring, c) => Op::Round(x + dx, y + dy, w, h, r, ring, c)
    Op::RoundClip(x, y, w, h, r) => Op::RoundClip(x + dx, y + dy, w, h, r)
    Op::Gradient(x, y, w, h, k, g, o, c) => Op::Gradient(x + dx, y + dy, w, h, k, g, o, c)
    Op::Unclip => Op::Unclip
    Op::Transform(ox, oy, a, b, c, d, tx, ty) => Op::Transform(ox + dx, oy + dy, a, b, c, d, tx, ty)
    Op::Untransform => Op::Untransform
    Op::ScrollBox(id, x, y, w, h, cw, ch) => Op::ScrollBox(id, x + dx, y + dy, w, h, cw, ch)
    Op::Hover(id, x, y, w, h, c) => Op::Hover(id, x + dx, y + dy, w, h, c)
    Op::Shadow(x, y, w, h, g, c, inset) => Op::Shadow(x + dx, y + dy, w, h, g, c, inset)
  }
}

pub fn op_down(op : Op, dy : Double) -> Op {
  if dy == 0.0 {
    return op
  }
  match op {
    Op::Rect(x, y, w, h, c) => Op::Rect(x, y + dy, w, h, c)
    Op::Glyphs(f, size, x, y, c, g, a) => Op::Glyphs(f, size, x, y + dy, c, g, a)
    Op::Image(x, y, w, h, u) => Op::Image(x, y + dy, w, h, u)
    Op::Clip(x, y, w, h) => Op::Clip(x, y + dy, w, h)
    Op::Mask(x, y, w, h, u, c) => Op::Mask(x, y + dy, w, h, u, c)
    Op::VGlyphs(f, size, c, g, t, xs, ys) => {
      let nys : Array[Double] = []
      let mut i = 0
      while i < ys.length() {
        nys.push(ys[i] + dy)
        i = i + 1
      }
      Op::VGlyphs(f, size, c, g, t, xs, nys)
    }
    Op::Round(x, y, w, h, r, ring, c) => Op::Round(x, y + dy, w, h, r, ring, c)
    Op::RoundClip(x, y, w, h, r) => Op::RoundClip(x, y + dy, w, h, r)
    Op::Gradient(x, y, w, h, k, g, o, c) => Op::Gradient(x, y + dy, w, h, k, g, o, c)
    Op::Unclip => Op::Unclip
    Op::Transform(ox, oy, a, b, c, d, tx, ty) => Op::Transform(ox, oy + dy, a, b, c, d, tx, ty)
    Op::Untransform => Op::Untransform
    Op::ScrollBox(id, x, y, w, h, cw, ch) => Op::ScrollBox(id, x, y + dy, w, h, cw, ch)
    Op::Hover(id, x, y, w, h, c) => Op::Hover(id, x, y + dy, w, h, c)
    Op::Shadow(x, y, w, h, g, c, inset) => Op::Shadow(x, y + dy, w, h, g, c, inset)
  }
}

pub fn op_rows(op : Op) -> (Double, Double) {
  match op {
    Op::Rect(_, y, _, h, _) => (y, y + h)
    Op::Image(_, y, _, h, _) => (y, y + h)
    Op::Mask(_, y, _, h, _, _) => (y, y + h)
    Op::Clip(_, y, _, h) => (y, y + h)
    Op::Round(_, y, _, h, _, _, _) => (y, y + h)
    Op::RoundClip(_, y, _, h, _) => (y, y + h)
    Op::Gradient(_, y, _, h, _, _, _, _) => (y, y + h)
    Op::ScrollBox(_, _, y, _, h, _, _) => (y, y + h)
    Op::Hover(_, _, y, _, h, _) => (y, y + h)
    Op::Shadow(_, y, _, h, g, _, inset) => if inset {
      (y, y + h)
    } else {
      let e = g[2] * 1.5 + math_abs(g[3])
      (y + g[1] - e, y + g[1] + h + e)
    }
    Op::Glyphs(_, size, _, base, _, _, _) => {
      let m = if size * 2.0 > 80.0 { size * 2.0 } else { 80.0 }
      (base - m, base + m)
    }
    Op::VGlyphs(_, size, _, _, _, _, ys) => {
      let m = if size * 2.0 > 80.0 { size * 2.0 } else { 80.0 }
      if ys.length() == 0 {
        (0.0, 0.0)
      } else {
        let mut lo = ys[0]
        let mut hi = ys[0]
        let mut i = 1
        while i < ys.length() {
          if ys[i] < lo {
            lo = ys[i]
          }
          if ys[i] > hi {
            hi = ys[i]
          }
          i = i + 1
        }
        (lo - m, hi + m)
      }
    }
    Op::Unclip => (-1000000000.0, 1000000000.0)
    Op::Transform(_, _, _, _, _, _, _, _) => (-1000000000.0, 1000000000.0)
    Op::Untransform => (-1000000000.0, 1000000000.0)
  }
}

fn op_top(op : Op) -> Double {
  match op {
    Op::Unclip => 0.0
    Op::Untransform => 0.0
    Op::Transform(_, oy, _, _, _, _, _, _) => math_round(oy * 64.0) / 64.0
    _ => {
      let (top, _) = op_rows(op)
      math_round(top * 64.0) / 64.0
    }
  }
}

fn order_eq(a : Array[(Int, Double)], b : Array[(Int, Double)]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    let (id1, y1) = a[i]
    let (id2, y2) = b[i]
    if id1 != id2 || y1 != y2 {
      return false
    }
    i = i + 1
  }
  true
}

pub struct Sender {
  mut known : Map[String, Int]
  mut next : Int
  mut last : Array[(Int, Double)]
  mut last_w : Double
  mut last_h : Double
}

pub fn Sender::new() -> Sender {
  Sender::{ known: Map::new(), next: 0, last: [], last_w: -1.0, last_h: -1.0 }
}

pub fn Sender::forget(self : Sender) -> Unit {
  self.known = Map::new()
  self.last = []
  self.last_w = -1.0
}

pub fn Sender::frame(self : Sender, w : Double, h : Double, ops : Array[Op]) -> Option[Message] {
  let order : Array[(Int, Double)] = []
  let fresh : Array[(Int, Array[Op])] = []
  let now : Map[String, Int] = Map::new()
  let mut piece : Array[Op] = []
  let body = Writer::new()
  let mut at = 0.0
  let mut i = 0
  while i <= ops.length() {
    let do_cut = if i == ops.length() {
      piece.length() > 0
    } else {
      let op = ops[i]
      if piece.length() == 0 {
        at = op_top(op)
      }
      piece.push(op)
      (fnv(op_bytes(op_down(op, 0.0 - op_top(op)))) & 15L) == 0L || piece.length() >= 64
    }
    if do_cut && piece.length() > 0 {
      let mut j = 0
      while j < piece.length() {
        body.write_bytes(op_bytes(op_down(piece[j], 0.0 - at)))
        j = j + 1
      }
      let key = bytes_to_hex(body.to_bytes())
      let id = match self.known.get(key) {
        Option::Some(id0) => id0
        Option::None => match now.get(key) {
          Option::Some(id1) => id1
          Option::None => {
            let nid = self.next
            self.next = self.next + 1
            let shifted : Array[Op] = []
            let mut k = 0
            while k < piece.length() {
              shifted.push(op_down(piece[k], 0.0 - at))
              k = k + 1
            }
            fresh.push((nid, shifted))
            nid
          }
        }
      }
      now.set(key, id)
      order.push((id, at))
      piece = []
      body.reset()
    }
    i = i + 1
  }
  self.known = now
  if fresh.length() == 0 && w == self.last_w && h == self.last_h && order_eq(order, self.last) {
    return Option::None
  }
  self.last = order
  self.last_w = w
  self.last_h = h
  Option::Some(Message::Frame(w, h, order, fresh))
}

fn entry_key(id : Int, y : Double) -> String {
  (id).to_string() + ":" + (round_to_int(y * 64.0).to_string())
}

pub struct Receiver {
  mut pieces : Map[String, Array[Op]]
  mut order : Array[(Int, Double)]
}

pub fn Receiver::new() -> Receiver {
  Receiver::{ pieces: Map::new(), order: [] }
}

pub fn Receiver::take(
  self : Receiver,
  order : Array[(Int, Double)],
  fresh : Array[(Int, Array[Op])],
) -> (Array[Op], Option[Array[(Double, Double)]]) {
  let had = self.pieces
  let mut i = 0
  while i < fresh.length() {
    let (id, ops) = fresh[i]
    had.set((id).to_string(), ops)
    i = i + 1
  }
  let was : Map[String, Bool] = Map::new()
  let mut wi = 0
  while wi < self.order.length() {
    let (id, y) = self.order[wi]
    was.set(entry_key(id, y), true)
    wi = wi + 1
  }
  let now_at : Map[String, Bool] = Map::new()
  let mut ni = 0
  while ni < order.length() {
    let (id, y) = order[ni]
    now_at.set(entry_key(id, y), true)
    ni = ni + 1
  }
  let prev_kept : Array[(Int, Double)] = []
  let mut pi = 0
  while pi < self.order.length() {
    let (id, y) = self.order[pi]
    if now_at.contains(entry_key(id, y)) {
      prev_kept.push((id, y))
    }
    pi = pi + 1
  }
  let curr_kept : Array[(Int, Double)] = []
  let mut ci = 0
  while ci < order.length() {
    let (id, y) = order[ci]
    if was.contains(entry_key(id, y)) {
      curr_kept.push((id, y))
    }
    ci = ci + 1
  }
  let moved = !order_eq(prev_kept, curr_kept)
  let rows : Array[(Double, Double)] = []
  let mut ri = 0
  while ri < self.order.length() {
    let (id, y) = self.order[ri]
    if !now_at.contains(entry_key(id, y)) {
      match had.get((id).to_string()) {
        Option::Some(ops) => {
          let mut k = 0
          while k < ops.length() {
            let (a, b) = op_rows(ops[k])
            rows.push((a + y, b + y))
            k = k + 1
          }
        }
        Option::None => ()
      }
    }
    ri = ri + 1
  }
  let mut oi = 0
  while oi < order.length() {
    let (id, y) = order[oi]
    if !was.contains(entry_key(id, y)) {
      match had.get((id).to_string()) {
        Option::Some(ops) => {
          let mut k = 0
          while k < ops.length() {
            let (a, b) = op_rows(ops[k])
            rows.push((a + y, b + y))
            k = k + 1
          }
        }
        Option::None => ()
      }
    }
    oi = oi + 1
  }
  let next : Map[String, Array[Op]] = Map::new()
  let all : Array[Op] = []
  let mut ai = 0
  while ai < order.length() {
    let (id, y) = order[ai]
    let kstr = (id).to_string()
    match had.get(kstr) {
      Option::Some(ops) => {
        next.set(kstr, ops)
        let mut k = 0
        while k < ops.length() {
          all.push(op_down(ops[k], y))
          k = k + 1
        }
      }
      Option::None => ()
    }
    ai = ai + 1
  }
  self.pieces = next
  let first = self.order.length() == 0
  self.order = order
  let changed : Option[Array[(Double, Double)]] = if moved || first {
    Option::None
  } else {
    Option::Some(rows)
  }
  (all, changed)
}
