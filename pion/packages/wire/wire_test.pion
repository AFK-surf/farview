test "ClosedTabsState (tag 66) and space/closed-tabs/print Act messages round-trip with byte-by-byte truncation safety" {
  let closed_json = "{\"items\":[{\"index\":0,\"title\":\"设计调研 · Arc Spaces\",\"url\":\"https://farview.dev/design\",\"host\":\"farview.dev\",\"spaceName\":\"设计调研\",\"closedSecs\":1795516700},{\"index\":1,\"title\":\"Pion Language Guide\",\"url\":\"https://pionlang.dev/guide\",\"host\":\"pionlang.dev\",\"spaceName\":\"Work\",\"closedSecs\":1795516400}]}"
  let msgs : Array[Message] = [
    Message::Act("closed_tabs_sync", "", ""),
    Message::Act("tab_reopen_at", "1", ""),
    Message::Act("closed_tabs_clear", "", ""),
    Message::Act("space_accent", "design", "#8B5CF6"),
    Message::Act("export_pdf", "Farview Guide", "{\"paper\":\"letter\",\"orientation\":\"landscape\",\"margins\":\"narrow\",\"backgroundGraphics\":false}"),
    Message::ClosedTabsState(closed_json),
  ]
  let f = Framer::new()
  for m in msgs {
    f.push(encode(m))
  }
  let got : Array[Message] = []
