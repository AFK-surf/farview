test "wire round-trip and byte-by-byte truncation for MediaHubState (tag 63) and media hub Act frames" {
  let hub_json = "{\"sessions\":[{\"tabId\":\"t-yt\",\"title\":\"Lofi Girl\",\"artistOrHost\":\"youtube.com\",\"url\":\"https://youtube.com/watch?v=1\",\"playing\":true,\"muted\":false,\"isLiveCall\":false,\"durationSecs\":240,\"positionSecs\":95},{\"tabId\":\"t-meet\",\"title\":\"Design Sync\",\"artistOrHost\":\"meet.google.com\",\"url\":\"https://meet.google.com/abc\",\"playing\":true,\"muted\":false,\"isLiveCall\":true,\"durationSecs\":0,\"positionSecs\":0}]}"
  let msgs : Array[Message] = [
    Message::Act("media_hub_sync", "", ""),
    Message::Act("media_toggle_play", "t-yt", ""),
    Message::Act("media_toggle_mute", "t-meet", ""),
    Message::MediaHubState(hub_json),
  ]
  let f = Framer::new()
  for m in msgs {
    f.push(encode(m))
  }
  let got : Array[Message] = []
  while true {
    match f.next() {
      Option::None => break
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
