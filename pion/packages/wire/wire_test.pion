  match got[0] {
    Message::Act(v, a, b) => debug_assert(v == "closed_tabs_sync" && a == "" && b == "", "closed_tabs_sync round-trip")
    _ => debug_assert(false, "expected closed_tabs_sync")
  }
  match got[1] {
    Message::Act(v, a, b) => debug_assert(v == "tab_reopen_at" && a == "1" && b == "", "tab_reopen_at round-trip")
    _ => debug_assert(false, "expected tab_reopen_at")
  }
  match got[2] {
    Message::Act(v, a, b) => debug_assert(v == "closed_tabs_clear" && a == "" && b == "", "closed_tabs_clear round-trip")
    _ => debug_assert(false, "expected closed_tabs_clear")
  }
  match got[3] {
    Message::Act(v, a, b) => debug_assert(v == "space_accent" && a == "design" && b == "#8B5CF6", "space_accent round-trip")
    _ => debug_assert(false, "expected space_accent")
  }
  match got[4] {
    Message::Act(v, a, b) => debug_assert(v == "export_pdf" && a == "Farview Guide" && b.contains("landscape"), "export_pdf config round-trip")
    _ => debug_assert(false, "expected export_pdf")
  }
  match got[5] {
    Message::ClosedTabsState(s) => debug_assert(s == closed_json, "ClosedTabsState tag 66 round-trip")
    _ => debug_assert(false, "expected ClosedTabsState")
  }
  for m in msgs {
    let tf = Framer::new()
    tf.push(encode(m))
    match tf.next() {
      Option::Some(body) => {
        let mut k = 0
        while k < body.length() {
          match decode(body.slice(0, k)) {
            Option::None => ()
            Option::Some(_) => debug_assert(false, "truncated closed tabs frame must return None")
          }
          k = k + 1
        }
      }
      Option::None => debug_assert(false, "framer should yield closed tabs frame")
    }
  }
}

