///| Unit tests for `wire` (1:1 port of `src/wire/proto_test.mbt` and `src/wire/pieces_test.mbt` + full Op coverage).

fn make_bytes(arr : Array[Int]) -> Bytes {
  let b = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    b[i] = (arr[i] & 0xFF).to_byte()
    i = i + 1
  }
  b
}

fn page_of(n : Int, changed : Int, colour : Int) -> Array[Op] {
  let out : Array[Op] = []
  let mut i = 0
  while i < n {
    let c = if i == changed { colour } else { i }
    out.push(Op::Rect(0.0, (i) as Double * 20.0, 100.0, 10.0, c))
    i = i + 1
  }
  out
}

test "what a person does and the caret go and come back as they were" {
  let said = "{\"key\":{\"type\":\"down\",\"key\":\"a\",\"code\":\"KeyA\",\"mods\":0}}"
  let framer = Framer::new()
  framer.push(encode(Message::Person(said)))
  framer.push(encode(Message::Marks([Op::Rect(10.0, 20.5, 1.0, 16.0, 0x0A84FFFF)])))
  let got : Array[Message] = []
  let mut running = true
  while running {
    match framer.next() {
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "assert_true")
      }
      Option::None => running = false
    }
  }
  debug_assert(got.length() == 2, "assert_eq")
  match got[0] {
    Message::Person(s) => debug_assert(s == said, "assert_eq")
    _ => debug_assert(false, "assert_true")
  }
  match got[1] {
    Message::Marks(ops) => {
      debug_assert(ops.length() == 1, "assert_eq")
      debug_assert(op_eq(ops[0], Op::Rect(10.0, 20.5, 1.0, 16.0, 0x0A84FFFF)), "assert_true")
    }
    _ => debug_assert(false, "assert_true")
  }
}

test "a message cut short at any byte is dropped, not read past its end" {
  let msgs : Array[Message] = [
    Message::Hello(1280.0, 800.0, 2.0),
    Message::Tap(10.5, 20.25),
    Message::Person("{\"key\":{\"type\":\"down\"}}"),
    Message::Picture("https://example.com/a.png", make_bytes([0x89, 80, 78, 71, 13, 10])),
    Message::Font(0, 1, 400, 0, "wOF2abc".to_bytes()),
    Message::Marks([
      Op::Rect(1.0, 2.0, 3.0, 4.0, 0x0A84FFFF),
      Op::Glyphs(1, 16.0, 0.0, 12.0, 0xFF, [3, 5, 9], [0.0, 8.5, 17.0]),
      Op::Image(0.0, 0.0, 10.0, 10.0, "a.png"),
    ]),
    Message::Focus(7, 1.0, 2.0, 30.0, 16.0, "值", true, false),
    Message::Outlines(1, 2048, [(3, [PathCmd::MoveTo(0.0, 0.0), PathCmd::LineTo(4.0, 0.0), PathCmd::Close])]),
  ]
  let mut i = 0
  while i < msgs.length() {
    let f = Framer::new()
    f.push(encode(msgs[i]))
    match f.next() {
      Option::Some(body) => {
        match decode(body) {
          Option::Some(_) => debug_assert(true, "assert_true")
          Option::None => debug_assert(false, "assert_true")
        }
        let mut k = 0
        while k < body.length() {
          match decode(body.slice(0, k)) {
            Option::None => debug_assert(true, "assert_true")
            Option::Some(_) => debug_assert(false, "assert_true")
          }
          k = k + 1
        }
      }
      Option::None => debug_assert(false, "assert_true")
    }
    i = i + 1
  }
}

test "counts and lengths past the end, numbers never ended and lengths no message has" {
  match decode(make_bytes([0x4a, 0x80, 0xa8, 0xd6, 0xb9, 0x07])) {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  match decode(make_bytes([0x44, 0x05])) {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  match decode(make_bytes([0x44, 0x40, 97, 98])) {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  let bad_varint = Bytes::new(12)
  let mut i = 0
  while i < 12 {
    bad_varint[i] = 0xFF.to_byte()
    i = i + 1
  }
  match decode(bad_varint) {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  match decode(Bytes::new(0)) {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  let f = Framer::new()
  f.push(make_bytes([0x80, 0x00, 0x00, 0x01, 120]))
  match f.next() {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  debug_assert(f.broken(), "assert_true")
}

test "all 15 Op variants round-trip cleanly" {
  let ops : Array[Op] = [
    Op::Rect(1.5, 2.25, 100.0, 50.0, 0x112233FF),
    Op::Glyphs(2, 14.5, 10.0, 24.0, 0x000000FF, [10, 25, 20, 40], [0.0, 7.5, 15.0, 22.5]),
    Op::Image(0.0, 0.0, 64.0, 64.0, "https://example.com/pic.png"),
    Op::Clip(4.0, 8.0, 200.0, 100.0),
    Op::Unclip,
    Op::Mask(1.0, 2.0, 32.0, 32.0, "mask.svg", 0xFF0000FF),
    Op::VGlyphs(3, 18.0, 0x222222FF, [5, 8], [true, false], [10.0, 10.0], [20.0, 38.0]),
    Op::Round(5.0, 6.0, 80.0, 40.0, [4.0, 4.0, 4.0, 4.0], [1.0, 1.0, 1.0, 1.0], 0x334455FF),
    Op::RoundClip(5.0, 6.0, 80.0, 40.0, [8.0, 8.0, 8.0, 8.0]),
    Op::Gradient(0.0, 0.0, 100.0, 50.0, 0, [0.0, 0.0, 100.0, 0.0], [0.0, 0.5, 1.0], [0xFF0000FF, 0x00FF00FF, 0x0000FFFF]),
    Op::Transform(50.0, 25.0, 1.0, 0.0, 0.0, 1.0, 10.0, -5.0),
    Op::Untransform,
    Op::ScrollBox(42, 0.0, 0.0, 300.0, 200.0, 600.0, 800.0),
    Op::Hover(99, 10.0, 10.0, 50.0, 20.0, 1),
    Op::Shadow(10.0, 10.0, 100.0, 50.0, [0.0, 4.0, 8.0, 0.0, 4.0, 4.0, 4.0, 4.0, 1.0], 0x00000080, false),
  ]
  let f = Framer::new()
  f.push(encode(Message::Overlay(ops)))
  match f.next() {
    Option::Some(body) => match decode(body) {
      Option::Some(Message::Overlay(got)) => {
        debug_assert(got.length() == ops.length(), "assert_eq")
        let mut i = 0
        while i < ops.length() {
          debug_assert(op_eq(got[i], ops[i]), "assert_true")
          i = i + 1
        }
      }
      _ => debug_assert(false, "assert_true")
    }
    Option::None => debug_assert(false, "assert_true")
  }
}

test "an edit sends only the pieces around it, and the rows they cover" {
  let s = Sender::new()
  let r = Receiver::new()
  match s.frame(400.0, 20000.0, page_of(1000, -1, 0)) {
    Option::Some(Message::Frame(_, _, order, fresh)) => {
      let (ops, rows) = r.take(order, fresh)
      debug_assert(ops.length() == 1000, "assert_eq")
      match rows {
        Option::None => debug_assert(true, "assert_true")
        Option::Some(_) => debug_assert(false, "assert_true")
      }
      debug_assert(fresh.length() == order.length(), "assert_eq")
    }
    _ => debug_assert(false, "assert_true")
  }
  let edited = page_of(1000, 500, 7)
  match s.frame(400.0, 20000.0, edited) {
    Option::Some(Message::Frame(_, _, order2, fresh2)) => {
      debug_assert(fresh2.length() <= 2, "assert_true")
      let (ops2, rows2) = r.take(order2, fresh2)
      debug_assert(ops2.length() == 1000, "assert_eq")
      let mut i = 0
      while i < ops2.length() {
        debug_assert(op_eq(ops2[i], edited[i]), "assert_true")
        i = i + 1
      }
      match rows2 {
        Option::Some(rlist) => {
          let mut has_edit = false
          let mut ri = 0
          while ri < rlist.length() {
            let (a, b) = rlist[ri]
            if a <= 10000.0 && b >= 10010.0 {
              has_edit = true
            }
            debug_assert(a > 10000.0 - 64.0 * 20.0 && b < 10010.0 + 64.0 * 20.0, "assert_true")
            ri = ri + 1
          }
          debug_assert(has_edit, "assert_true")
        }
        Option::None => debug_assert(false, "assert_true")
      }
    }
    _ => debug_assert(false, "assert_true")
  }
  let base_page = page_of(1000, -1, 0)
  let longer : Array[Op] = []
  let mut li = 0
  while li < 1000 {
    if li == 300 {
      longer.push(Op::Rect(5.0, 6005.0, 10.0, 10.0, 99))
    }
    longer.push(base_page[li])
    li = li + 1
  }
  match s.frame(400.0, 20000.0, longer) {
    Option::Some(Message::Frame(_, _, order3, fresh3)) => {
      debug_assert(fresh3.length() <= 3, "assert_true")
      let (ops3, _) = r.take(order3, fresh3)
      debug_assert(ops3.length() == longer.length(), "assert_eq")
      let mut i = 0
      while i < ops3.length() {
        debug_assert(op_eq(ops3[i], longer[i]), "assert_true")
        i = i + 1
      }
    }
    _ => debug_assert(false, "assert_true")
  }
}

test "what moves down the page is not sent again, and the same page twice is no frame" {
  let s = Sender::new()
  let r = Receiver::new()
  let page = page_of(1000, -1, 0)
  match s.frame(400.0, 20000.0, page) {
    Option::Some(Message::Frame(_, _, order, fresh)) => {
      let _ = r.take(order, fresh)
    }
    _ => debug_assert(false, "assert_true")
  }
  match s.frame(400.0, 20000.0, page) {
    Option::None => debug_assert(true, "assert_true")
    Option::Some(_) => debug_assert(false, "assert_true")
  }
  let grown : Array[Op] = []
  let mut i = 0
  while i < page.length() {
    if i > 100 {
      grown.push(op_down(page[i], 3.5))
    } else {
      grown.push(page[i])
    }
    i = i + 1
  }
  match s.frame(400.0, 20003.5, grown) {
    Option::Some(Message::Frame(_, _, order2, fresh2)) => {
      debug_assert(fresh2.length() <= 2, "assert_true")
      let (ops2, rows2) = r.take(order2, fresh2)
      let mut j = 0
      while j < ops2.length() {
        debug_assert(op_eq(ops2[j], grown[j]), "assert_true")
        j = j + 1
      }
      match rows2 {
        Option::Some(rlist) => {
          let mut ri = 0
          while ri < rlist.length() {
            let (_, b) = rlist[ri]
            debug_assert(b > 100.0 * 20.0 - 64.0 * 20.0, "assert_true")
            ri = ri + 1
          }
        }
        Option::None => debug_assert(false, "assert_true")
      }
    }
    _ => debug_assert(false, "assert_true")
  }
}

test "IME composition and clipboard shortcut messages round-trip cleanly" {
  let msgs : Array[Message] = [
    Message::ComposeStart(""),
    Message::ComposeUpdate("ni'hao"),
    Message::ComposeEnd("你好世界"),
    Message::Copy,
    Message::Cut,
    Message::Paste("粘贴中文文本 Farview"),
    Message::SelectAll,
  ]
  let f = Framer::new()
  let mut i = 0
  while i < msgs.length() {
    f.push(encode(msgs[i]))
    i = i + 1
  }
  let got : Array[Message] = []
  let mut running = true
  while running {
    match f.next() {
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "decode failed")
      }
      Option::None => running = false
    }
  }
  debug_assert(got.length() == 7, "expected 7 decoded messages")
  match got[0] {
    Message::ComposeStart(s) => debug_assert(s == "", "ComposeStart payload")
    _ => debug_assert(false, "expected ComposeStart")
  }
  match got[1] {
    Message::ComposeUpdate(s) => debug_assert(s == "ni'hao", "ComposeUpdate payload")
    _ => debug_assert(false, "expected ComposeUpdate")
  }
  match got[2] {
    Message::ComposeEnd(s) => debug_assert(s == "你好世界", "ComposeEnd CJK payload")
    _ => debug_assert(false, "expected ComposeEnd")
  }
  match got[3] {
    Message::Copy => ()
    _ => debug_assert(false, "expected Copy")
  }
  match got[4] {
    Message::Cut => ()
    _ => debug_assert(false, "expected Cut")
  }
  match got[5] {
    Message::Paste(s) => debug_assert(s == "粘贴中文文本 Farview", "Paste CJK payload")
    _ => debug_assert(false, "expected Paste")
  }
  match got[6] {
    Message::SelectAll => ()
    _ => debug_assert(false, "expected SelectAll")
  }
  // Truncated payloads for string-carrying messages must cleanly return None.
  let trunc_msgs : Array[Message] = [
    Message::ComposeStart("a"),
    Message::ComposeUpdate("ni'hao"),
    Message::ComposeEnd("你好"),
    Message::Paste("剪贴板"),
  ]
  let mut ti = 0
  while ti < trunc_msgs.length() {
    let tf = Framer::new()
    tf.push(encode(trunc_msgs[ti]))
    match tf.next() {
      Option::Some(body) => {
        let mut k = 0
        while k < body.length() {
          match decode(body.slice(0, k)) {
            Option::None => ()
            Option::Some(_) => debug_assert(false, "truncated message must not decode")
          }
          k = k + 1
        }
      }
      Option::None => debug_assert(false, "framer should yield body")
    }
    ti = ti + 1
  }
}

test "Zoom, FindResult, and Find/Zoom Act messages round-trip and reject truncation" {
  let msgs : Array[Message] = [
    Message::Zoom(0.5),
    Message::Zoom(0.67),
    Message::Zoom(1.0),
    Message::Zoom(1.25),
    Message::Zoom(1.5),
    Message::Zoom(3.0),
    Message::FindResult(-1, 0),
    Message::FindResult(0, 7),
    Message::FindResult(6, 7),
    Message::Act("find", "Farview", ""),
    Message::Act("find_next", "", ""),
    Message::Act("find_prev", "", ""),
    Message::Act("find_clear", "", ""),
    Message::Act("zoom", "1.5", "1280x754"),
  ]
  let f = Framer::new()
  let mut i = 0
  while i < msgs.length() {
    f.push(encode(msgs[i]))
    i = i + 1
  }
  let got : Array[Message] = []
  let mut running = true
  while running {
    match f.next() {
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "decode zoom/find message failed")
      }
      Option::None => running = false
    }
  }
  debug_assert(got.length() == 14, "expected 14 decoded messages")
  match got[0] {
    Message::Zoom(z) => debug_assert((z - 0.5).abs() < 1.0e-4, "Zoom 0.5")
    _ => debug_assert(false, "expected Zoom 0.5")
  }
  match got[1] {
    Message::Zoom(z) => debug_assert((z - 0.67).abs() < 1.0e-4, "Zoom 0.67")
    _ => debug_assert(false, "expected Zoom 0.67")
  }
  match got[4] {
    Message::Zoom(z) => debug_assert((z - 1.5).abs() < 1.0e-4, "Zoom 1.5")
    _ => debug_assert(false, "expected Zoom 1.5")
  }
  match got[5] {
    Message::Zoom(z) => debug_assert((z - 3.0).abs() < 1.0e-4, "Zoom 3.0")
    _ => debug_assert(false, "expected Zoom 3.0")
  }
  match got[6] {
    Message::FindResult(a, t) => debug_assert(a == -1 && t == 0, "FindResult empty")
    _ => debug_assert(false, "expected FindResult empty")
  }
  match got[7] {
    Message::FindResult(a, t) => debug_assert(a == 0 && t == 7, "FindResult 0/7")
    _ => debug_assert(false, "expected FindResult 0/7")
  }
  match got[8] {
    Message::FindResult(a, t) => debug_assert(a == 6 && t == 7, "FindResult 6/7")
    _ => debug_assert(false, "expected FindResult 6/7")
  }
  match got[9] {
    Message::Act(v, s, t) => debug_assert(v == "find" && s == "Farview" && t == "", "Act find")
    _ => debug_assert(false, "expected Act find")
  }
  match got[13] {
    Message::Act(v, s, t) => debug_assert(v == "zoom" && s == "1.5" && t == "1280x754", "Act zoom")
    _ => debug_assert(false, "expected Act zoom")
  }
  // Truncation at every byte must return None for Zoom and FindResult
  let trunc_cases : Array[Message] = [Message::Zoom(1.5), Message::FindResult(2, 12)]
  let mut ti = 0
  while ti < trunc_cases.length() {
    let tf = Framer::new()
    tf.push(encode(trunc_cases[ti]))
    match tf.next() {
      Option::Some(body) => {
        let mut k = 0
        while k < body.length() {
          match decode(body.slice(0, k)) {
            Option::None => ()
            Option::Some(_) => debug_assert(false, "truncated Zoom/FindResult must not decode")
          }
          k = k + 1
        }
      }
      Option::None => debug_assert(false, "framer should yield Zoom/FindResult body")
    }
    ti = ti + 1
  }
}

test "OmniboxResults (tag 53) round-trips and rejects byte-by-byte truncation" {
  let payload = "[{\"url\":\"https://www.youtube.com\",\"title\":\"YouTube 首页\",\"visits\":24,\"score\":1480.5,\"switchToTab\":false}]"
  let msgs : Array[Message] = [
    Message::OmniboxResults("[]"),
    Message::OmniboxResults(payload),
    Message::Act("omnibox", "youtube", ""),
    Message::Act("omnibox_seed", "https://linear.app", "Linear"),
  ]
  let f = Framer::new()
  let mut i = 0
  while i < msgs.length() {
    f.push(encode(msgs[i]))
    i = i + 1
  }
  let got : Array[Message] = []
  let mut running = true
  while running {
    match f.next() {
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "decode OmniboxResults message failed")
      }
      Option::None => running = false
    }
  }
  debug_assert(got.length() == 4, "expected 4 decoded omnibox messages")
  match got[0] {
    Message::OmniboxResults(s) => debug_assert(s == "[]", "OmniboxResults empty")
    _ => debug_assert(false, "expected OmniboxResults empty")
  }
  match got[1] {
    Message::OmniboxResults(s) => debug_assert(s == payload, "OmniboxResults payload")
    _ => debug_assert(false, "expected OmniboxResults payload")
  }
  match got[2] {
    Message::Act(v, s, t) => debug_assert(v == "omnibox" && s == "youtube" && t == "", "Act omnibox")
    _ => debug_assert(false, "expected Act omnibox")
  }
  match got[3] {
    Message::Act(v, s, t) => debug_assert(v == "omnibox_seed" && s == "https://linear.app" && t == "Linear", "Act omnibox_seed")
    _ => debug_assert(false, "expected Act omnibox_seed")
  }
  // Truncation at every byte must return None for OmniboxResults
  let tf = Framer::new()
  tf.push(encode(Message::OmniboxResults(payload)))
  match tf.next() {
    Option::Some(body) => {
      let mut k = 0
      while k < body.length() {
        match decode(body.slice(0, k)) {
          Option::None => ()
          Option::Some(_) => debug_assert(false, "truncated OmniboxResults must not decode")
        }
        k = k + 1
      }
    }
    Option::None => debug_assert(false, "framer should yield OmniboxResults body")
  }
}

test "WorkspaceState (tag 54) round-trips and rejects byte-by-byte truncation" {
  let payload = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"1\",\"spaces\":[{\"id\":\"work\",\"name\":\"Work 工作\",\"accent\":\"#2563EB\",\"active\":true,\"tabCount\":2}],\"tabs\":[{\"id\":\"1\",\"spaceId\":\"work\",\"title\":\"Farview — \\\"Arc\\\"\",\"url\":\"https://farview.dev\",\"pinned\":true,\"active\":true,\"state\":\"active\"}]}"
  let msgs : Array[Message] = [
    Message::WorkspaceState("{}"),
    Message::WorkspaceState(payload),
    Message::Act("workspace_sync", "", ""),
    Message::Act("tab_new", "https://linear.app", "Linear"),
    Message::Act("tab_switch", "2", ""),
    Message::Act("tab_close", "2", ""),
    Message::Act("tab_pin", "1", ""),
    Message::Act("space_switch", "personal", ""),
    Message::Act("space_new", "Design", "#8B5CF6"),
  ]
  let f = Framer::new()
  let mut i = 0
  while i < msgs.length() {
    f.push(encode(msgs[i]))
    i = i + 1
  }
  let got : Array[Message] = []
  let mut running = true
  while running {
    match f.next() {
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "decode WorkspaceState message failed")
      }
      Option::None => running = false
    }
  }
  debug_assert(got.length() == 9, "expected 9 decoded workspace messages")
  match got[0] {
    Message::WorkspaceState(s) => debug_assert(s == "{}", "WorkspaceState empty")
    _ => debug_assert(false, "expected WorkspaceState empty")
  }
  match got[1] {
    Message::WorkspaceState(s) => debug_assert(s == payload, "WorkspaceState payload")
    _ => debug_assert(false, "expected WorkspaceState payload")
  }
  match got[2] {
    Message::Act(v, s, t) => debug_assert(v == "workspace_sync" && s == "" && t == "", "Act workspace_sync")
    _ => debug_assert(false, "expected Act workspace_sync")
  }
  match got[8] {
    Message::Act(v, s, t) => debug_assert(v == "space_new" && s == "Design" && t == "#8B5CF6", "Act space_new")
    _ => debug_assert(false, "expected Act space_new")
  }
  // Truncation at every byte must return None for WorkspaceState
  let tf = Framer::new()
  tf.push(encode(Message::WorkspaceState(payload)))
  match tf.next() {
    Option::Some(body) => {
      let mut k = 0
      while k < body.length() {
        match decode(body.slice(0, k)) {
          Option::None => ()
          Option::Some(_) => debug_assert(false, "truncated WorkspaceState must not decode")
        }
        k = k + 1
      }
    }
    Option::None => debug_assert(false, "framer should yield WorkspaceState body")
  }
}

test "DownloadsState (tag 55) round-trips and rejects byte-by-byte truncation" {
  let payload = "[{\"id\":\"dl-1\",\"filename\":\"Farview-2.4-macOS-arm64.dmg\",\"url\":\"https://releases.farview.dev/Farview-2.4.dmg\",\"mime\":\"application/x-apple-diskimage\",\"bytes\":14889779,\"state\":\"completed\"},{\"id\":\"dl-2\",\"filename\":\"架构评审报告 \\\"Q4\\\".pdf\",\"url\":\"https://docs.linear.app/q4.pdf\",\"mime\":\"application/pdf\",\"bytes\":253952,\"state\":\"in_progress\"}]"
  let msgs : Array[Message] = [
    Message::DownloadsState("[]"),
    Message::DownloadsState(payload),
    Message::Act("downloads_sync", "", ""),
    Message::Act("downloads_clear", "", ""),
    Message::Act("perm_set", "screen_capture", "allow"),
  ]
  let f = Framer::new()
  let mut i = 0
  while i < msgs.length() {
    f.push(encode(msgs[i]))
    i = i + 1
  }
  let got : Array[Message] = []
  let mut running = true
  while running {
    match f.next() {
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "decode DownloadsState message failed")
      }
      Option::None => running = false
    }
  }
  debug_assert(got.length() == 5, "expected 5 decoded downloads messages")
  match got[0] {
    Message::DownloadsState(s) => debug_assert(s == "[]", "DownloadsState empty")
    _ => debug_assert(false, "expected DownloadsState empty")
  }
  match got[1] {
    Message::DownloadsState(s) => debug_assert(s == payload, "DownloadsState payload")
    _ => debug_assert(false, "expected DownloadsState payload")
  }
  match got[2] {
    Message::Act(v, s, t) => debug_assert(v == "downloads_sync" && s == "" && t == "", "Act downloads_sync")
    _ => debug_assert(false, "expected Act downloads_sync")
  }
  match got[3] {
    Message::Act(v, s, t) => debug_assert(v == "downloads_clear" && s == "" && t == "", "Act downloads_clear")
    _ => debug_assert(false, "expected Act downloads_clear")
  }
  match got[4] {
    Message::Act(v, s, t) => debug_assert(v == "perm_set" && s == "screen_capture" && t == "allow", "Act perm_set")
    _ => debug_assert(false, "expected Act perm_set")
  }
  // Truncation at every byte must return None for DownloadsState
  let tf = Framer::new()
  tf.push(encode(Message::DownloadsState(payload)))
  match tf.next() {
    Option::Some(body) => {
      let mut k = 0
      while k < body.length() {
        match decode(body.slice(0, k)) {
          Option::None => ()
          Option::Some(_) => debug_assert(false, "truncated DownloadsState must not decode")
        }
        k = k + 1
      }
    }
    Option::None => debug_assert(false, "framer should yield DownloadsState body")
  }
}

