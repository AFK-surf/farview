  }
  match got[6] {
    Message::Act(v, s, t) => debug_assert(v == "space_color" && s == "work" && t == "#8B5CF6", "Act space_color")
    _ => debug_assert(false, "expected Act space_color")
  }
  match got[7] {
    Message::Act(v, s, t) => debug_assert(v == "space_delete" && s == "personal" && t == "", "Act space_delete")
    _ => debug_assert(false, "expected Act space_delete")
  }
  // Truncation at every byte must return None for HistoryState
  let tf = Framer::new()
  tf.push(encode(Message::HistoryState(payload)))
  match tf.next() {
    Option::Some(body) => {
      let mut k = 0
      while k < body.length() {
        match decode(body.slice(0, k)) {
          Option::None => ()
          Option::Some(_) => debug_assert(false, "truncated HistoryState must not decode")
        }
        k = k + 1
      }
    }
    Option::None => debug_assert(false, "framer should yield HistoryState body")
  }
}

test "wire round-trip for Pinned folders WorkspaceState and folder/duplicate Act verbs" {
  let ws_payload = "{\"activeSpaceId\":\"work\",\"activeTabId\":\"2\",\"spaces\":[{\"id\":\"work\",\"name\":\"Work\",\"accent\":\"#2563EB\",\"active\":true,\"tabCount\":2}],\"folders\":[{\"id\":\"f-docs\",\"spaceId\":\"work\",\"name\":\"Docs\",\"collapsed\":false}],\"tabs\":[{\"id\":\"1\",\"spaceId\":\"work\",\"title\":\"Spec\",\"url\":\"https://example.com/spec\",\"pinned\":true,\"favorite\":false,\"active\":false,\"state\":\"background\",\"folderId\":\"f-docs\"}],\"closedCount\":0}"
  let msgs : Array[Message] = [
    Message::WorkspaceState(ws_payload),
    Message::Act("folder_new", "Docs", "work"),
    Message::Act("folder_toggle", "f-docs", ""),
    Message::Act("folder_rename", "f-docs", "Engineering Docs"),
    Message::Act("tab_move_folder", "1", "f-docs"),
    Message::Act("tab_move_folder", "1", ""),
    Message::Act("folder_delete", "f-docs", ""),
    Message::Act("tab_duplicate", "1", ""),
  ]
  let f = Framer::new()
  for m in msgs {
    f.push(encode(m))
  }
  let got : Array[Message] = []
  while true {
    match f.next() {
      Option::None => break
      Option::Some(body) => match decode(body) {
        Option::Some(m) => got.push(m)
        Option::None => debug_assert(false, "decode folder wire message failed")
      }
    }
  }
  debug_assert(got.length() == 8, "expected 8 decoded folder/duplicate messages")
  match got[0] {
    Message::WorkspaceState(s) => debug_assert(s == ws_payload, "WorkspaceState with folders")
    _ => debug_assert(false, "expected WorkspaceState")
  }
  match got[1] {
    Message::Act(v, a, b) => debug_assert(v == "folder_new" && a == "Docs" && b == "work", "folder_new")
    _ => debug_assert(false, "expected folder_new")
  }
  match got[4] {
    Message::Act(v, a, b) => debug_assert(v == "tab_move_folder" && a == "1" && b == "f-docs", "tab_move_folder")
    _ => debug_assert(false, "expected tab_move_folder")
  }
  match got[7] {
    Message::Act(v, a, b) => debug_assert(v == "tab_duplicate" && a == "1" && b == "", "tab_duplicate")
    _ => debug_assert(false, "expected tab_duplicate")
  }
}

