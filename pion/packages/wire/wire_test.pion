  match got[0] {
    Message::Act(v, a, b) => debug_assert(v == "media_hub_sync" && a == "" && b == "", "media_hub_sync round-trip")
    _ => debug_assert(false, "expected media_hub_sync")
  }
  match got[1] {
    Message::Act(v, a, b) => debug_assert(v == "media_toggle_play" && a == "t-yt" && b == "", "media_toggle_play round-trip")
    _ => debug_assert(false, "expected media_toggle_play")
  }
  match got[2] {
    Message::Act(v, a, b) => debug_assert(v == "media_toggle_mute" && a == "t-meet" && b == "", "media_toggle_mute round-trip")
    _ => debug_assert(false, "expected media_toggle_mute")
  }
  match got[3] {
    Message::MediaHubState(s) => debug_assert(s == hub_json, "MediaHubState tag 63 round-trip")
    _ => debug_assert(false, "expected MediaHubState")
  }
  // Byte-by-byte truncation safety on MediaHubState (tag 63) and Act frames
  for m in msgs {
    let tf = Framer::new()
    tf.push(encode(m))
    match tf.next() {
      Option::Some(body) => {
        let mut k = 0
        while k < body.length() {
          match decode(body.slice(0, k)) {
            Option::None => ()
            Option::Some(_) => debug_assert(false, "truncated media hub frame must return None")
          }
          k = k + 1
        }
      }
      Option::None => debug_assert(false, "framer should yield media hub frame")
    }
  }
}

