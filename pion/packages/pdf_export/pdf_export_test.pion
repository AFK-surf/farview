///| Unit tests for `pdf_export` (1:1 port of `src/cmd/host/pdf_export_wbtest.mbt` + alpha blending & PackBits edge cases).

fn make_solid_page(w : Int, h : Int, r : Int, g : Int, b : Int, a : Int) -> (Int, Int, Bytes) {
  let rgba = Bytes::new(w * h * 4)
  let mut i = 0
  while i < w * h {
    rgba[i * 4] = (r & 0xFF).to_byte()
    rgba[i * 4 + 1] = (g & 0xFF).to_byte()
    rgba[i * 4 + 2] = (b & 0xFF).to_byte()
    rgba[i * 4 + 3] = (a & 0xFF).to_byte()
    i = i + 1
  }
  (w, h, rgba)
}

test "stage20a: pure Pion PDF 1.4 encoder produces valid multi-page PDF with exact xref offsets" {
  let p1 = make_solid_page(8, 8, 0x25, 0x63, 0xEB, 0xFF)
  let p2 = make_solid_page(8, 8, 0x16, 0xA3, 0x4A, 0xFF)
  let pdf = encode_pdf_pages([p1, p2])
  let text = pdf.to_string()
  debug_assert(text.starts_with("%PDF-1.4\n"), "starts with %PDF-1.4")
  debug_assert(text.contains("/Type /Catalog /Pages 2 0 R"), "catalog")
  debug_assert(text.contains("/Type /Pages /Count 2 /Kids [3 0 R 6 0 R]"), "pages kids")
  debug_assert(text.contains("/Filter /RunLengthDecode"), "RunLengthDecode filter")
  debug_assert(text.contains("xref\n0 9\n"), "xref count 9")
  debug_assert(text.ends_with("%%EOF\n"), "ends with %%EOF")

  let (_, _, white_rgba) = make_solid_page(8, 8, 0xFF, 0xFF, 0xFF, 0xFF)
  let rgb = rgba_to_white_rgb(white_rgba, 8, 8)
  let rle = pdf_rle_encode(rgb)
  debug_assert(rle.length() < 16, "uniform white compresses tightly")
  debug_assert((rle[rle.length() - 1].to_int() & 0xFF) == 0x80, "EOD marker 0x80")
}

test "rgba_to_white_rgb blends semi-transparent pixels over white paper" {
  let (_, _, semi) = make_solid_page(2, 2, 0, 0, 0, 128)
  let rgb = rgba_to_white_rgb(semi, 2, 2)
  debug_assert(rgb.length() == 12, "2x2 RGB = 12 bytes")
  let expected = (0 * 128 + 255 * 127) / 255
  debug_assert((rgb[0].to_int() & 0xFF) == expected, "alpha blend over white")
  debug_assert((rgb[1].to_int() & 0xFF) == expected, "alpha blend G")
  debug_assert((rgb[2].to_int() & 0xFF) == expected, "alpha blend B")
}

test "phase3b: encode_pdf_pages_sized emits exact MediaBox and cm matrix for A4, Letter, and Legal Landscape" {
  let p = make_solid_page(4, 4, 0x10, 0x20, 0x30, 0xFF)
  let pdf_legal_land = encode_pdf_pages_sized([p], 1008.0, 612.0).to_string()
  debug_assert(pdf_legal_land.contains("/MediaBox [0 0 1008.00 612.00]"), "Legal Landscape MediaBox")
  debug_assert(pdf_legal_land.contains("q 1008.00 0 0 612.00 0 0 cm /Im0 Do Q\n"), "Legal Landscape cm")

  let pdf_letter = encode_pdf_pages_sized([p], 612.0, 792.0).to_string()
  debug_assert(pdf_letter.contains("/MediaBox [0 0 612.00 792.00]"), "Letter Portrait MediaBox")
  debug_assert(pdf_letter.contains("q 612.00 0 0 792.00 0 0 cm /Im0 Do Q\n"), "Letter Portrait cm")

  let pdf_a4 = encode_pdf_pages([p]).to_string()
  debug_assert(pdf_a4.contains("/MediaBox [0 0 595.28 841.89]"), "A4 Portrait MediaBox")
}
