///| Pure Pion multi-page PDF 1.4 exporter (PackBits /RunLengthDecode, ISO 32000-1 §7.4.5).
///| 1:1 port of `src/cmd/host/pdf_export.mbt` with zero external dependencies.

pub let print_css_w : Double = 794.0

pub let print_css_h : Double = 1123.0

pub let print_pt_w : String = "595.28"

pub let print_pt_h : String = "841.89"

struct ByteBuf {
  mut buf : Bytes
  mut n : Int
}

fn ByteBuf::new() -> ByteBuf {
  ByteBuf::{ buf: Bytes::new(256), n: 0 }
}

fn ByteBuf::ensure(self : ByteBuf, extra : Int) -> Unit {
  if self.n + extra <= self.buf.length() {
    return
  }
  let mut cap = self.buf.length() * 2
  while cap < self.n + extra {
    cap = cap * 2
  }
  let bigger = Bytes::new(cap)
  let mut i = 0
  while i < self.n {
    bigger[i] = self.buf[i]
    i = i + 1
  }
  self.buf = bigger
}

fn ByteBuf::write_byte(self : ByteBuf, b : Int) -> Unit {
  self.ensure(1)
  self.buf[self.n] = (b & 0xFF).to_byte()
  self.n = self.n + 1
}

fn ByteBuf::write_bytes(self : ByteBuf, b : Bytes) -> Unit {
  let len = b.length()
  self.ensure(len)
  let mut i = 0
  while i < len {
    self.buf[self.n + i] = b[i]
    i = i + 1
  }
  self.n = self.n + len
}

fn ByteBuf::write_str(self : ByteBuf, s : String) -> Unit {
  self.write_bytes(s.to_bytes())
}

fn ByteBuf::to_bytes(self : ByteBuf) -> Bytes {
  self.buf.slice(0, self.n)
}

///| PackBits (/Filter /RunLengthDecode, ISO 32000-1 §7.4.5) encoder for RGB scanlines.
pub fn pdf_rle_encode(src : Bytes) -> Bytes {
  let n = src.length()
  let out = ByteBuf::new()
  let mut i = 0
  while i < n {
    let b = src[i].to_int() & 0xFF
    let mut run = 1
    while i + run < n && run < 128 && (src[i + run].to_int() & 0xFF) == b {
      run = run + 1
    }
    if run >= 3 {
      out.write_byte(257 - run)
      out.write_byte(b)
      i = i + run
    } else {
      let start = i
      let mut lit = 0
      while i < n && lit < 128 {
        if i + 2 < n {
          let c0 = src[i].to_int() & 0xFF
          let c1 = src[i + 1].to_int() & 0xFF
          let c2 = src[i + 2].to_int() & 0xFF
          if c0 == c1 && c0 == c2 {
            break
          }
        }
        i = i + 1
        lit = lit + 1
      }
      if lit == 0 {
        out.write_byte(0)
        out.write_byte(src[i].to_int() & 0xFF)
        i = i + 1
      } else {
        out.write_byte(lit - 1)
        let mut k = 0
        while k < lit {
          out.write_byte(src[start + k].to_int() & 0xFF)
          k = k + 1
        }
      }
    }
  }
  out.write_byte(0x80)
  out.to_bytes()
}

///| Convert straight-alpha RGBA pixels to opaque RGB over white paper.
pub fn rgba_to_white_rgb(rgba : Bytes, pw : Int, ph : Int) -> Bytes {
  let count = pw * ph
  let rgb = Bytes::new(count * 3)
  let mut init_i = 0
  while init_i < count * 3 {
    rgb[init_i] = 0xFF.to_byte()
    init_i = init_i + 1
  }
  let avail = rgba.length() / 4
  let max_i = if avail < count { avail } else { count }
  let mut p = 0
  while p < max_i {
    let s = p * 4
    let d = p * 3
    let a = rgba[s + 3].to_int() & 0xFF
    if a >= 255 {
      rgb[d] = rgba[s]
      rgb[d + 1] = rgba[s + 1]
      rgb[d + 2] = rgba[s + 2]
    } else if a > 0 {
      let inv = 255 - a
      let r = rgba[s].to_int() & 0xFF
      let g = rgba[s + 1].to_int() & 0xFF
      let b = rgba[s + 2].to_int() & 0xFF
      rgb[d] = ((r * a + 255 * inv) / 255).to_byte()
      rgb[d + 1] = ((g * a + 255 * inv) / 255).to_byte()
      rgb[d + 2] = ((b * a + 255 * inv) / 255).to_byte()
    }
    p = p + 1
  }
  rgb
}

fn pdf_pad10(n : Int) -> String {
  let s = n.to_string()
  if s.length() >= 10 {
    return s
  }
  let pad = 10 - s.length()
  let mut prefix = ""
  let mut i = 0
  while i < pad {
    prefix = prefix + "0"
    i = i + 1
  }
  prefix + s
}

///| Assemble a standard multi-page PDF 1.4 document from `(width, height, rgba)` pages.
pub fn encode_pdf_pages(pages : Array[(Int, Int, Bytes)]) -> Bytes {
  let buf = ByteBuf::new()
  buf.write_str("%PDF-1.4\n%")
  buf.write_byte(0xE2)
  buf.write_byte(0xE3)
  buf.write_byte(0xCF)
  buf.write_byte(0xD3)
  buf.write_byte(10)
  let n_pages = pages.length()
  let offsets : Array[Int] = [0]
  // Obj 1: Catalog
  offsets.push(buf.n)
  buf.write_str("1 0 obj\n<</Type /Catalog /Pages 2 0 R>>\nendobj\n")
  // Obj 2: Pages
  let kids_parts : Array[String] = []
  let mut ki = 0
  while ki < n_pages {
    let page_id = 3 + ki * 3
    kids_parts.push(page_id.to_string() + " 0 R")
    ki = ki + 1
  }
  offsets.push(buf.n)
  buf.write_str("2 0 obj\n<</Type /Pages /Count " + n_pages.to_string() + " /Kids [" + kids_parts.join(" ") + "]>>\nendobj\n")
  // Each page: Page obj, Content stream obj, Image XObject obj
  let mut i = 0
  while i < n_pages {
    let (pw, ph, rgba) = pages[i]
    let page_id = 3 + i * 3
    let content_id = page_id + 1
    let img_id = page_id + 2
    offsets.push(buf.n)
    buf.write_str(
      page_id.to_string() + " 0 obj\n<</Type /Page /Parent 2 0 R /MediaBox [0 0 " + print_pt_w + " " + print_pt_h + "] /Resources <</XObject <</Im0 " + img_id.to_string() + " 0 R>>>> /Contents " + content_id.to_string() + " 0 R>>\nendobj\n",
    )
    let content = "q " + print_pt_w + " 0 0 " + print_pt_h + " 0 0 cm /Im0 Do Q\n"
    let content_bytes = content.to_bytes()
    offsets.push(buf.n)
    buf.write_str(content_id.to_string() + " 0 obj\n<</Length " + content_bytes.length().to_string() + ">>\nstream\n")
    buf.write_bytes(content_bytes)
    buf.write_str("endstream\nendobj\n")
    let rgb = rgba_to_white_rgb(rgba, pw, ph)
    let rle = pdf_rle_encode(rgb)
    offsets.push(buf.n)
    buf.write_str(
      img_id.to_string() + " 0 obj\n<</Type /XObject /Subtype /Image /Width " + pw.to_string() + " /Height " + ph.to_string() + " /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /RunLengthDecode /Length " + rle.length().to_string() + ">>\nstream\n",
    )
    buf.write_bytes(rle)
    buf.write_str("\nendstream\nendobj\n")
    i = i + 1
  }
  let xref_off = buf.n
  let total_objs = offsets.length()
  buf.write_str("xref\n0 " + total_objs.to_string() + "\n0000000000 65535 f \n")
  let mut oi = 1
  while oi < total_objs {
    buf.write_str(pdf_pad10(offsets[oi]) + " 00000 n \n")
    oi = oi + 1
  }
  buf.write_str("trailer\n<</Size " + total_objs.to_string() + " /Root 1 0 R>>\nstartxref\n" + xref_off.to_string() + "\n%%EOF\n")
  buf.to_bytes()
}
