///| Unit & mock TCP server integration tests for `agent_cli`.

test "base64_encode, mime_type_of, and parse_port helpers" {
  debug_assert(base64_encode("Hello".to_bytes()) == "SGVsbG8=", "base64 Hello")
  debug_assert(base64_encode("abcd".to_bytes()) == "YWJjZA==", "base64 abcd")
  debug_assert(base64_encode("abc".to_bytes()) == "YWJj", "base64 abc")
  debug_assert(mime_type_of("shot.PNG") == "image/png", "mime png")
  debug_assert(mime_type_of("report.pdf") == "application/pdf", "mime pdf")
  debug_assert(mime_type_of("noext") == "", "mime unknown")
  debug_assert(parse_port("9222") == 9222, "parse_port")
}

test "agent_cli drives mock wire TCP server over go/look/click/type/eval/shot/pdf/passkeys" {
  let srv = net::listen_on("127.0.0.1", 0)
  debug_assert(srv >= 0, "mock server listen_on")
  let port = net::port_of(srv)
  debug_assert(port > 0, "mock server port > 0")

  let pid = net::fork()
  if pid == 0 {
    // Child process: mock Farview agent-port server
    let c = net::accept(srv)
    if c >= 0 {
      let f = wire::Framer::new()
      let mut cur_url = "about:blank"
      let mut cur_title = "Blank"
      let mut alive = true
      while alive {
        match net::recv(c, 5000) {
          Option::None => alive = false
          Option::Some(chunk) => if chunk.length() == 0 {
            alive = false
          } else {
            f.push(chunk)
            let mut more = true
            while more {
              match f.next() {
                Option::Some(body) => match wire::decode(body) {
                  Option::Some(wire::Message::Go(u)) => {
                    cur_url = u
                    cur_title = "Loaded"
                    let _ = net::send(c, wire::encode(wire::Message::Seen(cur_url, cur_title, "body ok")))
                  }
                  Option::Some(wire::Message::Look) => {
                    let _ = net::send(c, wire::encode(wire::Message::Seen(cur_url, cur_title, "seen text")))
                  }
                  Option::Some(wire::Message::Act(verb, sel, txt)) => {
                    let _ = net::send(c, wire::encode(wire::Message::Seen(cur_url, cur_title, verb + ":" + sel + ":" + txt)))
                  }
                  Option::Some(wire::Message::Eval(expr)) => {
                    let _ = net::send(c, wire::encode(wire::Message::Value("eval:" + expr)))
                  }
                  Option::Some(wire::Message::Shot(_)) => {
                    let _ = net::send(c, wire::encode(wire::Message::Shot("PNGDATA".to_bytes())))
                  }
                  Option::Some(wire::Message::Pdf(_)) => {
                    let _ = net::send(c, wire::encode(wire::Message::Pdf("%PDF-1.4\n%%EOF\n".to_bytes())))
                  }
                  Option::Some(wire::Message::Passkeys(verb, arg)) => {
                    let _ = net::send(c, wire::encode(wire::Message::Value("pk:" + verb + ":" + arg)))
                  }
                  _ => ()
                }
                Option::None => more = false
              }
            }
          }
        }
      }
      net::close(c)
    }
    net::close(srv)
    net::exit(0)
  }

  // Parent process: drive mock server directly using net + wire (and test step parsing + framing)
  let sock = net::connect("127.0.0.1", port)
  debug_assert(sock >= 0, "connect to mock server")
  let framer = wire::Framer::new()
  let steps : Array[wire::Message] = [
    wire::Message::Go("https://example.com/"),
    wire::Message::Look,
    wire::Message::Act("click", "#btn", ""),
    wire::Message::Act("type", "#q", "pion"),
    wire::Message::Eval("1+41"),
    wire::Message::Shot(Bytes::new(0)),
    wire::Message::Pdf(Bytes::new(0)),
    wire::Message::Passkeys("get", "example.com"),
  ]
  let mut i = 0
  while i < steps.length() {
    let _ = net::send(sock, wire::encode(steps[i]))
    let mut got = false
    while !got {
      match net::recv(sock, 5000) {
        Option::Some(chunk) => if chunk.length() > 0 {
          framer.push(chunk)
          match framer.next() {
            Option::Some(body) => {
              match wire::decode(body) {
                Option::Some(wire::Message::Seen(u, _, o)) => {
                  debug_assert(u == "https://example.com/", "seen url")
                  if i == 2 {
                    debug_assert(o == "click:#btn:", "click echoed")
                  }
                  if i == 3 {
                    debug_assert(o == "type:#q:pion", "type echoed")
                  }
                }
                Option::Some(wire::Message::Value(v)) => {
                  if i == 4 {
                    debug_assert(v == "eval:1+41", "eval result")
                  }
                  if i == 7 {
                    debug_assert(v == "pk:get:example.com", "passkeys result")
                  }
                }
                Option::Some(wire::Message::Shot(b)) => debug_assert(b.to_string() == "PNGDATA", "shot bytes")
                Option::Some(wire::Message::Pdf(b)) => debug_assert(b.to_string().starts_with("%PDF-1.4"), "pdf bytes")
                _ => debug_assert(false, "unexpected message")
              }
              got = true
            }
            Option::None => ()
          }
        }
        Option::None => debug_assert(false, "unexpected EOF")
      }
    }
    i = i + 1
  }
  net::close(sock)
  net::close(srv)
  let _ = net::wait(pid)
}
