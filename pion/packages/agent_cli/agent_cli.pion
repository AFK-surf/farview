///| Farview Agent TCP CLI client.
///| 1:1 port of `src/cmd/agent/main.mbt` built on `net` + `wire`.

import "net"
import "wire"

fn rev_index_of(s : String, needle : String) -> Int {
  let sb = s.to_bytes()
  let nb = needle.to_bytes()
  let slen = sb.length()
  let nlen = nb.length()
  if nlen == 0 || nlen > slen {
    return -1
  }
  let mut i = slen - nlen
  while i >= 0 {
    let mut ok = true
    let mut j = 0
    while j < nlen {
      if sb[i + j] != nb[j] {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i - 1
  }
  -1
}

fn to_ascii_lower(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    if c >= 65 && c <= 90 {
      out[i] = (c + 32).to_byte()
    } else {
      out[i] = src[i]
    }
    i = i + 1
  }
  out.to_string()
}

pub fn parse_port(s : String) -> Int {
  let b = s.to_bytes()
  let mut n = 0
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    if c >= 48 && c <= 57 {
      n = n * 10 + (c - 48)
    }
    i = i + 1
  }
  n
}

pub fn mime_type_of(name : String) -> String {
  let k = rev_index_of(name, ".")
  let ext = if k >= 0 { to_ascii_lower(name.slice(k + 1, name.length())) } else { "" }
  if ext == "txt" {
    "text/plain"
  } else if ext == "html" || ext == "htm" {
    "text/html"
  } else if ext == "css" {
    "text/css"
  } else if ext == "csv" {
    "text/csv"
  } else if ext == "json" {
    "application/json"
  } else if ext == "js" {
    "text/javascript"
  } else if ext == "pdf" {
    "application/pdf"
  } else if ext == "zip" {
    "application/zip"
  } else if ext == "png" {
    "image/png"
  } else if ext == "jpg" || ext == "jpeg" {
    "image/jpeg"
  } else if ext == "gif" {
    "image/gif"
  } else if ext == "webp" {
    "image/webp"
  } else if ext == "svg" {
    "image/svg+xml"
  } else if ext == "mp4" {
    "video/mp4"
  } else if ext == "mp3" {
    "audio/mpeg"
  } else if ext == "doc" {
    "application/msword"
  } else if ext == "docx" {
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
  } else if ext == "xlsx" {
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
  } else if ext == "eml" {
    "message/rfc822"
  } else {
    ""
  }
}

pub fn base64_encode(data : Bytes) -> String {
  let abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".to_bytes()
  let n = data.length()
  let groups = (n + 2) / 3
  let out = Bytes::new(groups * 4)
  let mut i = 0
  let mut o = 0
  while i < n {
    let b0 = data[i].to_int() & 0xFF
    let b1 = if i + 1 < n { data[i + 1].to_int() & 0xFF } else { 0 }
    let b2 = if i + 2 < n { data[i + 2].to_int() & 0xFF } else { 0 }
    out[o] = abc[b0 >> 2]
    out[o + 1] = abc[((b0 & 3) << 4) | (b1 >> 4)]
    out[o + 2] = if i + 1 < n { abc[((b1 & 15) << 2) | (b2 >> 6)] } else { (61).to_byte() }
    out[o + 3] = if i + 2 < n { abc[b2 & 63] } else { (61).to_byte() }
    i = i + 3
    o = o + 4
  }
  out.to_string()
}

fn upload_lines(w : World, paths : String) -> Option[String] {
  let parts = paths.split(",")
  let lines : Array[String] = []
  let mut i = 0
  while i < parts.length() {
    let path = parts[i].trim()
    match fs_read_bytes(w, path) {
      Result::Err(_) => {
        io_println(w, "upload: could not read " + path)
        return Option::None
      }
      Result::Ok(data) => {
        let k = rev_index_of(path, "/")
        let name = if k >= 0 { path.slice(k + 1, path.length()) } else { path }
        lines.push(name + "\t" + mime_type_of(name) + "\t" + base64_encode(data))
      }
    }
    i = i + 1
  }
  Option::Some(lines.join("\n"))
}

pub fn parse_step_message(w : World, s : String) -> Option[wire::Message] {
  if s == "look" {
    Option::Some(wire::Message::Look)
  } else if s.starts_with("click:") {
    Option::Some(wire::Message::Act("click", s.slice(6, s.length()), ""))
  } else if s.starts_with("fill:") || s.starts_with("type:") {
    let rest = s.slice(5, s.length())
    let k = rev_index_of(rest, "=")
    if k >= 0 {
      Option::Some(wire::Message::Act("type", rest.slice(0, k), rest.slice(k + 1, rest.length())))
    } else {
      Option::Some(wire::Message::Act("type", rest, ""))
    }
  } else if s.starts_with("key:") {
    let rest = s.slice(4, s.length())
    let k = rest.index_of("@")
    if k > 0 {
      Option::Some(wire::Message::Act("key", rest.slice(k + 1, rest.length()), rest.slice(0, k)))
    } else {
      Option::Some(wire::Message::Act("key", "", rest))
    }
  } else if s.starts_with("submit:") {
    Option::Some(wire::Message::Act("enter", s.slice(7, s.length()), ""))
  } else if s.starts_with("go:") {
    Option::Some(wire::Message::Go(s.slice(3, s.length())))
  } else if s.starts_with("eval:") {
    Option::Some(wire::Message::Eval(s.slice(5, s.length())))
  } else if s.starts_with("shot:") {
    Option::Some(wire::Message::Shot(Bytes::new(0)))
  } else if s.starts_with("pdf:") {
    Option::Some(wire::Message::Pdf(Bytes::new(0)))
  } else if s.starts_with("cookies:") {
    let rest = s.slice(8, s.length())
    let k = rest.index_of("=")
    if k >= 0 {
      Option::Some(wire::Message::Cookies(rest.slice(0, k), rest.slice(k + 1, rest.length())))
    } else {
      Option::Some(wire::Message::Cookies(rest, ""))
    }
  } else if s.starts_with("passkeys:") {
    let rest = s.slice(9, s.length())
    let k = rest.index_of("=")
    if k >= 0 {
      Option::Some(wire::Message::Passkeys(rest.slice(0, k), rest.slice(k + 1, rest.length())))
    } else {
      Option::Some(wire::Message::Passkeys(rest, ""))
    }
  } else if s.starts_with("upload:") {
    let rest = s.slice(7, s.length())
    let k = rev_index_of(rest, "=")
    if k >= 0 {
      match upload_lines(w, rest.slice(k + 1, rest.length())) {
        Option::Some(lines) => Option::Some(wire::Message::Act("upload", rest.slice(0, k), lines))
        Option::None => Option::None
      }
    } else {
      io_println(w, "upload: say upload:selector=file[,file...]")
      Option::None
    }
  } else if s == "downloads" {
    Option::Some(wire::Message::Act("downloads", "", ""))
  } else if s == "back" {
    Option::Some(wire::Message::Back)
  } else if s == "forward" {
    Option::Some(wire::Message::Forward)
  } else if s == "reload" {
    Option::Some(wire::Message::Reload)
  } else {
    io_println(w, "unknown step " + s)
    Option::None
  }
}

pub fn run_agent(w : World, host : String, port : Int, steps : Array[String], print_out : Bool) -> Array[String] {
  let outputs : Array[String] = []
  let emit = fn(line : String) {
    outputs.push(line)
    if print_out {
      io_println(w, line)
    }
  }
  let sock = net::connect(host, port)
  if sock < 0 {
    emit("no tab to drive at " + host + ":" + port.to_string())
    return outputs
  }
  let framer = wire::Framer::new()
  let mut over = false
  let mut si = 0
  while si < steps.length() && !over {
    let s = steps[si]
    si = si + 1
    if s.starts_with("wait:") {
      let wait_ms = parse_port(s.slice(5, s.length())).to_int64()
      let end = clock_now_ms(w) + wait_ms
      while !over && clock_now_ms(w) < end {
        let rem = (end - clock_now_ms(w)).to_int()
        let timeout = if rem > 0 { rem } else { 1 }
        match net::recv(sock, timeout) {
          Option::Some(chunk) => if chunk.length() > 0 {
            framer.push(chunk)
            let mut more = true
            while more {
              match framer.next() {
                Option::Some(body) => match wire::decode(body) {
                  Option::Some(wire::Message::Taken) => {
                    emit("the person took the tab back")
                    over = true
                  }
                  _ => ()
                }
                Option::None => more = false
              }
            }
          }
          Option::None => {
            emit("the host closed the connection")
            over = true
          }
        }
      }
      continue
    }
    match parse_step_message(w, s) {
      Option::None => continue
      Option::Some(msg) => {
        let _ = net::send(sock, wire::encode(msg))
        let mut answered = false
        while !answered && !over {
          match net::recv(sock, 60000) {
            Option::None => {
              emit("the host closed the connection")
              over = true
            }
            Option::Some(chunk) => if chunk.length() == 0 {
              emit(s + ": no answer")
              answered = true
            } else {
              framer.push(chunk)
              let mut more = true
              while more {
                match framer.next() {
                  Option::Some(body) => match wire::decode(body) {
                    Option::Some(wire::Message::Seen(u, t, o)) => {
                      let shown = if s.starts_with("fill:") || s.starts_with("type:") {
                        let k = rev_index_of(s, "=")
                        if k >= 0 { s.slice(0, k) + "=…" } else { s }
                      } else {
                        s
                      }
                      emit("== " + shown + "\nurl " + u + "\ntitle " + t + "\n" + o)
                      answered = true
                    }
                    Option::Some(wire::Message::Value(v)) => {
                      let shown = if s.starts_with("cookies:set") {
                        "cookies:set"
                      } else if s.starts_with("passkeys:set") {
                        "passkeys:set"
                      } else {
                        s
                      }
                      emit("== " + shown + "\n" + v)
                      answered = true
                    }
                    Option::Some(wire::Message::Shot(png)) => {
                      let path = s.slice(5, s.length())
                      match fs_write_bytes(w, path, png) {
                        Result::Ok(_) => ()
                        Result::Err(_) => emit("shot: could not write " + path)
                      }
                      emit("== " + s + "\n" + png.length().to_string() + " bytes")
                      answered = true
                    }
                    Option::Some(wire::Message::Pdf(pdf)) => {
                      let path = s.slice(4, s.length())
                      match fs_write_bytes(w, path, pdf) {
                        Result::Ok(_) => ()
                        Result::Err(_) => emit("pdf: could not write " + path)
                      }
                      emit("== " + s + "\n" + pdf.length().to_string() + " bytes")
                      answered = true
                    }
                    Option::Some(wire::Message::Taken) => {
                      emit("the person took the tab back")
                      over = true
                    }
                    _ => ()
                  }
                  Option::None => more = false
                }
              }
            }
          }
        }
      }
    }
  }
  net::close(sock)
  outputs
}

fn main(w : World) -> Unit {
  let a = world_args(w)
  if a.length() < 3 {
    io_println(w, "usage: agent <host> <port> [steps...]")
    return
  }
  let host = a[1]
  let port = parse_port(a[2])
  let steps : Array[String] = []
  let mut i = 3
  while i < a.length() {
    steps.push(a[i])
    i = i + 1
  }
  let _ = run_agent(w, host, port, steps, true)
}
