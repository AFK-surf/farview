///| Paint tests ported from `src/paint/paint_test.mbt`.

import "html"
import "css"
import "layout"
import "display"
import "wire"
import "hostfont"
import "intmap"

fn assert(ok : Bool) -> Unit {
  if !ok { panic("assertion failed") }
}

fn make_host_fonts() -> layout::Fonts {
  let fb_files : Array[(String, () -> Option[Bytes])] = []
  for p in hostfont::fallback_files() {
    let path = p
    fb_files.push((path, fn() -> Option[Bytes] { hostfont::read_font_file(path) }))
  }
  let backend = layout::FontBackend::{
    family_files: fn(fam : String) -> Array[(String, () -> Option[Bytes])] {
      let out : Array[(String, () -> Option[Bytes])] = []
      for p in hostfont::files_of(fam) {
        let path = p
        out.push((path, fn() -> Option[Bytes] { hostfont::read_font_file(path) }))
      }
      out
    },
    fallback_files: fb_files,
    system_fallback: fn(fam : String, cp : Int, w : Int) -> Option[(String, String, () -> Option[Bytes])] {
      match hostfont::coretext_fallback(fam, cp, w) {
        Some((path, ps)) => Some((path, ps, fn() -> Option[Bytes] { hostfont::read_font_file(path) }))
        None => None
      }
    },
    system_outline: fn(_ps : String, _gid : Int, _upem : Int, _wght : Int) -> Option[Array[layout::PathCmd]] {
      None
    },
  }
  layout::Fonts::with_backend(backend)
}

fn unwrap_box(o : Option[layout::Box]) -> layout::Box {
  match o {
    Some(b) => b
    None => panic("expected Box")
  }
}

fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  for _ in 0..<n { sb.write_string(s) }
  sb.to_string()
}

test "a page drawn again shapes no word again" {
  let doc = html::parse(
    "<!doctype html><html><body>" + repeat_str("<p>some words <b>drawn</b> again and again</p>", 50) +
    "</body></html>",
  )
  let engine = css::Engine::new(css::Env::{ width: 412.0, height: 900.0, media: "screen", dpr: 1.0 })
  let root = unwrap_box(layout::generate(doc, engine))
  let fonts = make_host_fonts()
  layout::layout(root, fonts, 412.0, 900.0)
  let first = display_list(root, fonts).0.length()
  let shaped = layout::get_shape_count()
  let again = display_list(root, fonts).0.length()
  assert(again == first)
  assert(layout::get_shape_count() - shaped == 0)
}

fn one_line_changed(lines : Int) -> (Int, Bool) {
  let doc = html::parse(
    "<!doctype html><html><body><div class=view>" +
    repeat_str("<div class=line><span class=k>let</span> x = <b>1</b></div>", lines) +
    "</div></body></html>",
  )
  let sheet = ".view { display: flex; flex-direction: column } .line { padding: 2px; background: #eee } .k { color: blue } .on { color: red }"
  let engine = css::Engine::new(css::Env::{ width: 412.0, height: 900.0, media: "screen", dpr: 1.0 })
  engine.add_sheet(sheet)
  let fonts = make_host_fonts()
  let reuse = layout::Reuse::new()
  let r0 = unwrap_box(layout::generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout::layout(r0, fonts, 412.0, 900.0)
  let cache = display::KeptCache::new()
  let _ = display_list_full(r0, fonts, Map::new(), intmap::IntMap::new(), [], intmap::IntMap::new(), Some(cache))
  let line = doc.children[1].children[1].children[0].children[lines / 2]
  engine.forget(line, false, Some(("class", "line on")), None, false)
  line.attrs[0].value = "line on"
  reuse.changed(line)
  let r = unwrap_box(layout::generate_with_reuse(doc, engine, Some(reuse)))
  reuse.fresh()
  layout::layout(r, fonts, 412.0, 900.0)
  paint_counts[0] = 0
  let kept = display_list_full(r, fonts, Map::new(), intmap::IntMap::new(), [], intmap::IntMap::new(), Some(cache)).0
  let drawn = paint_counts[0]
  let anew = display_list(r, fonts).0
  (drawn, first_difference(kept, anew) == -1)
}

test "a page drawn after one change draws no more for being longer" {
  let (few, same_few) = one_line_changed(20)
  let (many, same_many) = one_line_changed(200)
  assert(same_few)
  assert(same_many)
  assert(many == few)
}

test "a field's border is drawn as the theme's" {
  let doc = html::parse("<!doctype html><html><body><input value=tester></body></html>")
  let engine = css::Engine::new(css::Env::{ width: 412.0, height: 900.0, media: "screen", dpr: 1.0 })
  let root = unwrap_box(layout::generate(doc, engine))
  let fonts = make_host_fonts()
  layout::layout(root, fonts, 412.0, 900.0)
  let ops = display_list(root, fonts).0
  let mut rings = 0
  let is_mac = hostfont::on_macos()
  for op in ops {
    match op {
      wire::Op::Round(_, _, w, h, _, ring, col) =>
      if (if is_mac { w == 153.0 && h == 21.0 } else { w > 100.0 && h > 14.0 }) &&
      ring.length() == 4 &&
      ring[0] == 1.0 && ring[1] == 1.0 && ring[2] == 1.0 && ring[3] == 1.0 &&
      col == 0x767676FF {
        rings += 1
      }
      _ => ()
    }
  }
  assert(rings == 1)
}

test "background-image none preserves background-clip text with exclude mask" {
  let fonts = layout::Fonts::new_portable([], [])
  let doc = html::parse("<!doctype html><html><body><h1>Sample</h1></body></html>")
  let engine = css::Engine::new(css::Env::new(600.0, 200.0))
  engine.add_sheet("h1{width:120px;height:40px;padding:2px;border-radius:8px;color:transparent;background-color:#ffb23e;background-image:none;background-clip:text;mask-composite:exclude;mask-clip:content-box,border-box}")
  let root = unwrap_box(layout::generate(doc, engine))
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let items = display::display_list(root, fonts)
  for item in items {
    match item {
      display::Item::Round(_, _, _, _, _, ring, color) if ring.length() == 4 && ((color >> 16) & 0xFF) == 178 =>
      panic("background-image none painted a visible ring outside text")
      _ => ()
    }
  }
}

test "re-entrant display_list_full via hover callback preserves outer ops" {
  let fonts = layout::Fonts::new_portable([], [])
  let nested_fonts = layout::Fonts::new_portable([], [])
  let doc = html::parse("<!doctype html><html><body><div class='before'></div><section></section><div class='after'></div></body></html>")
  let engine = css::Engine::new(css::Env::new(600.0, 200.0))
  engine.add_sheet(".before{width:40px;height:20px;background:#12a456}.after{width:40px;height:20px;background:#542abc}")
  let root = unwrap_box(layout::generate(doc, engine))
  layout::layout_with_scrollbar(root, fonts, 600.0, 200.0, 0.0)
  let nested_doc = html::parse("<!doctype html><html><body><div></div></body></html>")
  let nested_engine = css::Engine::new(css::Env::new(600.0, 200.0))
  nested_engine.add_sheet("div{width:60px;height:20px;background:#654321}")
  let nested_root = unwrap_box(layout::generate(nested_doc, nested_engine))
  layout::layout_with_scrollbar(nested_root, nested_fonts, 600.0, 200.0, 0.0)
  let expected = display_list(root, fonts).0
  let invoked = [false]
  display::set_hover_of(fn(node : html::Node) -> Int {
    if node.tag == "section" && !invoked[0] {
      invoked[0] = true
      let _ = display_list(nested_root, nested_fonts)
    }
    -1
  })
  let actual = display_list(root, fonts).0
  display::set_hover_of(fn(_ : html::Node) -> Int { -1 })
  assert(invoked[0])
  assert(first_difference(expected, actual) == -1)
}
