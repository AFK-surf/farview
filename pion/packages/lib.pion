///| Farview Pion core workspace integration module (P0 + P1 + P2A).

import "intmap"
import "url"
import "brotli"
import "woff2"
import "html"
import "proto"
import "doc"
import "fvdmath"
import "css"

pub fn workspace_ready() -> Bool {
  true
}

pub fn version() -> String {
  "farview-pion-p2a"
}

test "cross-package workspace integration" {
  let m : intmap::IntMap[Int] = intmap::IntMap::new()
  m.set(7, 42)
  debug_assert(m.get_or(7, 0) == 42, "intmap works")

  let resolved = url::resolve("https://example.com/a/b.html", "../c.css")
  debug_assert(resolved == "https://example.com/c.css", "url works")

  let br_in = Bytes::new(1)
  br_in[0] = (6).to_byte()
  let empty_br = brotli::decode(br_in)
  debug_assert(empty_br.is_ok(), "brotli works")

  let w_in = Bytes::new(4)
  w_in[0] = (79).to_byte()
  w_in[1] = (84).to_byte()
  w_in[2] = (84).to_byte()
  w_in[3] = (79).to_byte()
  let passthrough = woff2::decode(w_in)
  debug_assert(passthrough.is_ok(), "woff2 works")

  let dom = html::parse("<!DOCTYPE html><html><body><p class=hi>hi</p></body></html>")
  let mirror = doc::Mirror::new()
  let st = doc::DocState::{
    base: "https://example.com/",
    root: dom,
    frames: [],
    sheets: [],
    cssom: [],
    defined: fn(_n : html::Node) -> Bool { false },
    states: fn(_n : html::Node) -> Int { 0 },
    anim_style: fn(_n : html::Node) -> String { "" },
    target: "",
  }
  let wdoc = mirror.reset(st)
  let wire = proto::encode_host(proto::HostMsg::Reset(1, 0, wdoc))
  let framer = proto::Framer::new()
  framer.push(wire)
  let client = doc::Doc::new()
  match framer.next() {
    Some(body) => {
      match proto::decode_host(body) {
        Some(proto::HostMsg::Reset(_, _, decoded)) => client.reset(decoded)
        _ => debug_assert(false, "reset decode")
      }
    }
    None => debug_assert(false, "framer")
  }
  debug_assert(client.root().is_some(), "doc synced")

  let engine = css::Engine::new(css::Env::new(1280.0, 800.0))
  engine.add_sheet(".hi { font-size: 20px; color: #ff0000; }")
  let p_node = dom.children[1].children[1].children[0]
  let sty = match engine.style_of(p_node, None) {
    Some(s) => s
    None => {
      debug_assert(false, "css style")
      return
    }
  }
  debug_assert(fvdmath::abs(sty.font_size - 20.0) < 0.001, "css font-size")
  match sty.color("color") {
    Some(c) => debug_assert(c.r == 255 && c.g == 0 && c.b == 0, "css color")
    None => debug_assert(false, "css color none")
  }
  html::cut(dom)
}
