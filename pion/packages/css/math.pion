///| CSS math functions (CSS Values 4 §10): calc(), min(), max(), clamp(), round(), mod(), rem(), trig, etc.
///| 1:1 port of `client/src/css/math.mbt`.

struct MVal {
  v : Double
  pct : Double
  kind : String
  // CSS Values 4 §10.2: dimension exponent (0 for <number>, 1 for <length>/<angle>/<time>/<resolution>,
  // 2 for px*px, -1 for 1/px, etc.). Intermediate products like (length * length) / length cancel back to pow == 1.
  pow : Int
}

fn pos_inf() -> Double { 1.0 / 0.0 }
fn neg_inf() -> Double { -1.0 / 0.0 }
fn nan_value() -> Double { 0.0 / 0.0 }

fn is_math_func(f : String) -> Bool {
  f == "calc" || f == "min" || f == "max" || f == "clamp" || f == "round" ||
  f == "mod" || f == "rem" || f == "abs" || f == "sign" || f == "sin" ||
  f == "cos" || f == "tan" || f == "asin" || f == "acos" || f == "atan" ||
  f == "atan2" || f == "pow" || f == "sqrt" || f == "hypot" || f == "log" ||
  f == "exp" || f == "progress"
}

struct MathCx {
  fs : Double
  root : Double
  env : Env
}

fn deg_of(rad : Double) -> Double {
  rad * 180.0 / fvdmath::PI
}

fn rad_of(deg : Double) -> Double {
  deg * fvdmath::PI / 180.0
}

fn mval_num(v : Double) -> MVal {
  MVal::{ v: v, pct: 0.0, kind: "", pow: 0 }
}

fn mval_dim(v : Double, kind : String, pow : Int) -> MVal {
  if pow == 0 || kind == "" {
    MVal::{ v: v, pct: 0.0, kind: "", pow: 0 }
  } else {
    MVal::{ v: v, pct: 0.0, kind: kind, pow: pow }
  }
}

fn MVal::flat(self : MVal) -> Option[Double] {
  if self.pct == 0.0 {
    Some(self.v)
  } else {
    match css_globals.calc_base {
      Some(b) => Some(self.v + self.pct * b / 100.0)
      None => None
    }
  }
}

fn MathCx::dim(self : MathCx, n : Double, unit : String) -> Option[MVal] {
  let u = ascii_lower(unit)
  if u == "deg" {
    Some(MVal::{ v: n, pct: 0.0, kind: "deg", pow: 1 })
  } else if u == "rad" {
    Some(MVal::{ v: deg_of(n), pct: 0.0, kind: "deg", pow: 1 })
  } else if u == "grad" {
    Some(MVal::{ v: n * 0.9, pct: 0.0, kind: "deg", pow: 1 })
  } else if u == "turn" {
    Some(MVal::{ v: n * 360.0, pct: 0.0, kind: "deg", pow: 1 })
  } else if u == "s" {
    Some(MVal::{ v: n, pct: 0.0, kind: "s", pow: 1 })
  } else if u == "ms" {
    Some(MVal::{ v: n / 1000.0, pct: 0.0, kind: "s", pow: 1 })
  } else if u == "dppx" || u == "x" {
    Some(MVal::{ v: n, pct: 0.0, kind: "dppx", pow: 1 })
  } else if u == "dpi" {
    Some(MVal::{ v: n / 96.0, pct: 0.0, kind: "dppx", pow: 1 })
  } else if u == "dpcm" {
    Some(MVal::{ v: n * 2.54 / 96.0, pct: 0.0, kind: "dppx", pow: 1 })
  } else {
    match unit_px(n, u, self.fs, self.root, self.env) {
      Some(p) => Some(MVal::{ v: p, pct: 0.0, kind: "px", pow: 1 })
      None => None
    }
  }
}

struct SignedTerm {
  sign : Double
  toks : Array[Tok]
}

fn MathCx::sum(self : MathCx, t0 : Array[Tok]) -> Option[MVal] {
  let t = tok_filter_no_end(t0)
  let terms : Array[SignedTerm] = []
  let cur : Array[Tok] = []
  let mut sign = 1.0
  let mut depth = 0
  let mut i = 0
  while i < t.length() {
    let x = t[i]
    match x {
      OpenParen => depth = depth + 1
      Function(_) => depth = depth + 1
      OpenSquare => depth = depth + 1
      CloseParen => depth = depth - 1
      CloseSquare => depth = depth - 1
      Delim(c) => {
        if (c == 43 || c == 45) && depth == 0 && i > 0 && tok_eq(t[i - 1], Space) && i + 1 < t.length() && tok_eq(t[i + 1], Space) {
          terms.push(SignedTerm::{ sign: sign, toks: tok_copy(cur) })
          cur.clear()
          sign = if c == 45 { -1.0 } else { 1.0 }
          i = i + 1
          continue
        }
      }
      _ => ()
    }
    cur.push(x)
    i = i + 1
  }
  terms.push(SignedTerm::{ sign: sign, toks: cur })
  let mut acc : Option[MVal] = None
  let mut ti = 0
  while ti < terms.length() {
    let term = terms[ti]
    let v0 = match self.product(term.toks) {
      Some(v) => v
      None => return None
    }
    let v = MVal::{ v: v0.v * term.sign, pct: v0.pct * term.sign, kind: v0.kind, pow: v0.pow }
    acc = match acc {
      None => Some(v)
      Some(a) => {
        if a.kind == v.kind && a.pow == v.pow {
          Some(MVal::{ v: a.v + v.v, pct: a.pct + v.pct, kind: a.kind, pow: a.pow })
        } else {
          return None
        }
      }
    }
    ti = ti + 1
  }
  acc
}

struct AtomRes {
  val_ : MVal
  next : Int
}

fn MathCx::product(self : MathCx, t0 : Array[Tok]) -> Option[MVal] {
  let n = t0.length()
  let mut i = 0
  while i < n && tok_eq(t0[i], Space) { i = i + 1 }
  if i >= n {
    return None
  }
  let first = match self.atom(t0, i) {
    Some(r) => r
    None => return None
  }
  let mut acc = first.val_
  i = first.next
  while true {
    while i < n && tok_eq(t0[i], Space) { i = i + 1 }
    if i >= n { break }
    let op = t0[i]
    i = i + 1
    while i < n && tok_eq(t0[i], Space) { i = i + 1 }
    let r2 = match self.atom(t0, i) {
      Some(r) => r
      None => return None
    }
    let b = r2.val_
    i = r2.next
    match op {
      Delim(c) => {
        if c == 42 {
          if acc.kind == "" {
            acc = MVal::{ v: b.v * acc.v, pct: b.pct * acc.v, kind: b.kind, pow: b.pow }
          } else if b.kind == "" {
            acc = MVal::{ v: acc.v * b.v, pct: acc.pct * b.v, kind: acc.kind, pow: acc.pow }
          } else if acc.kind == b.kind {
            // CSS Values 4 §10.2: multiplying two same-dimension values adds their exponents (e.g. px * px -> px^2).
            match (acc.flat(), b.flat()) {
              (Some(x), Some(y)) => acc = mval_dim(x * y, acc.kind, acc.pow + b.pow)
              _ => return None
            }
          } else {
            return None
          }
        } else if c == 47 {
          if b.kind == "" {
            acc = MVal::{ v: acc.v / b.v, pct: acc.pct / b.v, kind: acc.kind, pow: acc.pow }
          } else if acc.kind == "" {
            // CSS Values 4 §10.2: dividing a number by a dimension negates its exponent (e.g. 1 / px -> px^-1).
            match b.flat() {
              Some(y) => acc = mval_dim(acc.v / y, b.kind, -b.pow)
              None => return None
            }
          } else if b.kind == acc.kind {
            // CSS Values 4 §10.2: dividing same-dimension values subtracts exponents (px / px -> number, px^2 / px -> px).
            match (acc.flat(), b.flat()) {
              (Some(x), Some(y)) => acc = mval_dim(x / y, acc.kind, acc.pow - b.pow)
              _ => return None
            }
          } else {
            return None
          }
        } else {
          return None
        }
      }
      _ => return None
    }
  }
  Some(acc)
}

fn MathCx::atom(self : MathCx, t : Array[Tok], i : Int) -> Option[AtomRes] {
  if i >= t.length() {
    return None
  }
  match t[i] {
    Number(n) => Some(AtomRes::{ val_: mval_num(n), next: i + 1 })
    Percentage(p) => Some(AtomRes::{ val_: MVal::{ v: 0.0, pct: p, kind: "px", pow: 1 }, next: i + 1 })
    Dimension(n, u) => {
      match self.dim(n, u) {
        Some(v) => Some(AtomRes::{ val_: v, next: i + 1 })
        None => None
      }
    }
    Ident(w) => {
      let lw = ascii_lower(w)
      let v = if lw == "pi" {
        fvdmath::PI
      } else if lw == "e" {
        2.718281828459045
      } else if lw == "infinity" {
        pos_inf()
      } else if lw == "-infinity" {
        neg_inf()
      } else if lw == "nan" {
        nan_value()
      } else {
        return None
      }
      Some(AtomRes::{ val_: mval_num(v), next: i + 1 })
    }
    OpenParen => {
      let e = group_end(t, i + 1)
      match self.sum(tok_slice(t, i + 1, e)) {
        Some(v) => Some(AtomRes::{ val_: v, next: e + 1 })
        None => None
      }
    }
    Function(f) => {
      let e = group_end(t, i + 1)
      match self.call(ascii_lower(f), tok_slice(t, i + 1, e)) {
        Some(v) => Some(AtomRes::{ val_: v, next: e + 1 })
        None => None
      }
    }
    _ => None
  }
}

fn all_same_kind(vs : Array[MVal]) -> Bool {
  if vs.length() == 0 {
    return true
  }
  let k0 = vs[0].kind
  let p0 = vs[0].pow
  let mut i = 1
  while i < vs.length() {
    if vs[i].kind != k0 || vs[i].pow != p0 {
      return false
    }
    i = i + 1
  }
  true
}

fn MathCx::call(self : MathCx, f : String, inner : Array[Tok]) -> Option[MVal] {
  if f == "calc" {
    return self.sum(inner)
  }
  if !is_math_func(f) {
    return None
  }
  let raw = split_commas(inner)
  let mut strategy = "nearest"
  let mut raw_start = 0
  if f == "round" && raw.length() > 0 {
    let a0 = tok_filter_no_space(raw[0])
    if a0.length() == 1 {
      match a0[0] {
        Ident(w) => {
          let lw = ascii_lower(w)
          if lw == "nearest" || lw == "up" || lw == "down" || lw == "to-zero" {
            strategy = lw
            raw_start = 1
          }
        }
        _ => ()
      }
    }
  }
  let raw_len = raw.length() - raw_start
  let args : Array[Option[MVal]] = []
  let mut ri = raw_start
  while ri < raw.length() {
    let a = raw[ri]
    let is_none_kw = if f == "clamp" {
      let ns = tok_filter_no_space(a)
      ns.length() == 1 && match ns[0] {
        Ident(w) => ascii_lower(w) == "none"
        _ => false
      }
    } else {
      false
    }
    if is_none_kw {
      args.push(None)
    } else {
      args.push(self.sum(a))
    }
    ri = ri + 1
  }
  let vals : Array[MVal] = []
  let mut k = 0
  while k < args.length() {
    match args[k] {
      Some(v) => vals.push(v)
      None => {
        if !(f == "clamp" && k != 1 && raw_len == 3) {
          return None
        }
      }
    }
    k = k + 1
  }
  if f == "progress" {
    if vals.length() != 3 || !all_same_kind(vals) {
      return None
    }
    let v = match vals[0].flat() { Some(x) => x None => return None }
    let lo = match vals[1].flat() { Some(x) => x None => return None }
    let hi = match vals[2].flat() { Some(x) => x None => return None }
    if hi == lo {
      return Some(mval_num(0.0))
    }
    return Some(mval_num(fvdmath::clamp((v - lo) / (hi - lo), 0.0, 1.0)))
  }
  if f == "min" || f == "max" {
    if vals.length() == 0 || !all_same_kind(vals) {
      return None
    }
    let mut best = vals[0]
    let mut bv = match best.flat() { Some(x) => x None => return None }
    let mut i = 1
    while i < vals.length() {
      let v = vals[i]
      let x = match v.flat() { Some(xx) => xx None => return None }
      if (f == "min" && x < bv) || (f == "max" && x > bv) || x != x {
        best = v
        bv = x
      }
      i = i + 1
    }
    return Some(MVal::{ v: bv, pct: 0.0, kind: best.kind, pow: best.pow })
  }
  if f == "clamp" {
    if raw_len != 3 {
      return None
    }
    let mid = match args[1] { Some(m) => m None => return None }
    let mut x = match mid.flat() { Some(xx) => xx None => return None }
    match args[2] {
      Some(hi) => {
        if hi.kind != mid.kind || hi.pow != mid.pow {
          return None
        }
        let h = match hi.flat() { Some(hh) => hh None => return None }
        if h < x {
          x = h
        }
      }
      None => ()
    }
    match args[0] {
      Some(lo) => {
        if lo.kind != mid.kind || lo.pow != mid.pow {
          return None
        }
        let l = match lo.flat() { Some(ll) => ll None => return None }
        if l > x {
          x = l
        }
      }
      None => ()
    }
    return Some(MVal::{ v: x, pct: 0.0, kind: mid.kind, pow: mid.pow })
  }
  if f == "round" {
    if vals.length() == 0 || vals.length() > 2 {
      return None
    }
    let a = vals[0]
    let b = if vals.length() == 2 {
      vals[1]
    } else if a.kind == "" {
      mval_num(1.0)
    } else {
      return None
    }
    if a.kind != b.kind || a.pow != b.pow {
      return None
    }
    let x = match a.flat() { Some(xx) => xx None => return None }
    let step0 = match b.flat() { Some(ss) => ss None => return None }
    let step = fvdmath::abs(step0)
    let r = if step == 0.0 || x != x || step != step {
      nan_value()
    } else if step == pos_inf() {
      if strategy == "up" {
        if x > 0.0 { pos_inf() } else if x == 0.0 { x } else { -0.0 }
      } else if strategy == "down" {
        if x < 0.0 { neg_inf() } else if x == 0.0 { x } else { 0.0 }
      } else {
        if x < 0.0 || 1.0 / x < 0.0 { -0.0 } else { 0.0 }
      }
    } else {
      let lo = fvdmath::floor(x / step) * step
      let hi = lo + step
      let picked = if strategy == "up" {
        if lo == x { lo } else { hi }
      } else if strategy == "down" {
        lo
      } else if strategy == "to-zero" {
        if x >= 0.0 { lo } else if lo == x { lo } else { hi }
      } else {
        if x - lo < hi - x { lo } else { hi }
      }
      if picked == 0.0 && (x < 0.0 || 1.0 / x < 0.0) { -0.0 } else { picked }
    }
    return Some(MVal::{ v: r, pct: 0.0, kind: a.kind, pow: a.pow })
  }
  if f == "mod" || f == "rem" {
    if vals.length() != 2 || !all_same_kind(vals) {
      return None
    }
    let a = match vals[0].flat() { Some(xx) => xx None => return None }
    let b = match vals[1].flat() { Some(xx) => xx None => return None }
    let r = if b == 0.0 || a != a || b != b || fvdmath::abs(a) == pos_inf() {
      nan_value()
    } else if fvdmath::abs(b) == pos_inf() {
      if f == "mod" && a != 0.0 && (a < 0.0) != (b < 0.0) { nan_value() } else { a }
    } else {
      let q = a / b
      let tv = if f == "mod" { fvdmath::floor(q) } else if q < 0.0 { fvdmath::ceil(q) } else { fvdmath::floor(q) }
      let m = a - b * tv
      if m == 0.0 {
        if (if f == "mod" { b } else { a }) < 0.0 { -0.0 } else { 0.0 }
      } else {
        m
      }
    }
    return Some(MVal::{ v: r, pct: 0.0, kind: vals[0].kind, pow: vals[0].pow })
  }
  if f == "abs" {
    if vals.length() != 1 { return None }
    let x = match vals[0].flat() { Some(xx) => xx None => return None }
    return Some(MVal::{ v: fvdmath::abs(x), pct: 0.0, kind: vals[0].kind, pow: vals[0].pow })
  }
  if f == "sign" {
    if vals.length() != 1 { return None }
    let x = match vals[0].flat() { Some(xx) => xx None => return None }
    return Some(mval_num(if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { x }))
  }
  if f == "sin" || f == "cos" || f == "tan" {
    if vals.length() != 1 { return None }
    let a = vals[0]
    let r = if a.kind == "deg" && a.pow == 1 {
      rad_of(a.v)
    } else if a.kind == "" {
      a.v
    } else {
      return None
    }
    let deg = if a.kind == "deg" { a.v } else { deg_of(a.v) }
    let m = deg - fvdmath::floor(deg / 360.0) * 360.0
    let v = if f == "sin" {
      if m == 0.0 || m == 180.0 {
        if r < 0.0 || 1.0 / r < 0.0 { -0.0 } else { 0.0 }
      } else if m == 90.0 { 1.0 } else if m == 270.0 { -1.0 } else { fvdmath::sin(r) }
    } else if f == "cos" {
      if m == 90.0 || m == 270.0 { 0.0 } else if m == 0.0 { 1.0 } else if m == 180.0 { -1.0 } else { fvdmath::cos(r) }
    } else {
      if m == 90.0 { pos_inf() } else if m == 270.0 { neg_inf() } else if m == 0.0 || m == 180.0 {
        if r < 0.0 || 1.0 / r < 0.0 { -0.0 } else { 0.0 }
      } else { fvdmath::tan(r) }
    }
    return Some(mval_num(v))
  }
  if f == "asin" || f == "acos" || f == "atan" {
    if vals.length() != 1 || vals[0].kind != "" { return None }
    let x = vals[0].v
    let r = if f == "asin" { fvdmath::asin(x) } else if f == "acos" { fvdmath::acos(x) } else { fvdmath::atan(x) }
    return Some(MVal::{ v: deg_of(r), pct: 0.0, kind: "deg", pow: 1 })
  }
  if f == "atan2" {
    if vals.length() != 2 || !all_same_kind(vals) { return None }
    let y = match vals[0].flat() { Some(yy) => yy None => return None }
    let x = match vals[1].flat() { Some(xx) => xx None => return None }
    return Some(MVal::{ v: deg_of(fvdmath::atan2(y, x)), pct: 0.0, kind: "deg", pow: 1 })
  }
  if f == "pow" {
    if vals.length() != 2 || vals[0].kind != "" || vals[1].kind != "" { return None }
    return Some(mval_num(fvdmath::pow(vals[0].v, vals[1].v)))
  }
  if f == "sqrt" {
    if vals.length() != 1 || vals[0].kind != "" { return None }
    return Some(mval_num(fvdmath::sqrt(vals[0].v)))
  }
  if f == "exp" {
    if vals.length() != 1 || vals[0].kind != "" { return None }
    return Some(mval_num(fvdmath::exp(vals[0].v)))
  }
  if f == "log" {
    if !(vals.length() == 1 || vals.length() == 2) { return None }
    let mut i = 0
    while i < vals.length() {
      if vals[i].kind != "" { return None }
      i = i + 1
    }
    let l = fvdmath::ln(vals[0].v)
    return Some(mval_num(if vals.length() == 2 { l / fvdmath::ln(vals[1].v) } else { l }))
  }
  if f == "hypot" {
    if vals.length() == 0 || !all_same_kind(vals) { return None }
    let mut s = 0.0
    let mut i = 0
    while i < vals.length() {
      let x = match vals[i].flat() { Some(xx) => xx None => return None }
      s = s + x * x
      i = i + 1
    }
    return Some(MVal::{ v: fvdmath::sqrt(s), pct: 0.0, kind: vals[0].kind, pow: vals[0].pow })
  }
  None
}

fn is_integer_prop(prop : String) -> Bool {
  prop == "z-index" || prop == "order" || prop == "orphans" || prop == "widows" ||
  prop == "column-count" || prop == "-webkit-line-clamp" ||
  prop == "grid-column-start" || prop == "grid-column-end" ||
  prop == "grid-row-start" || prop == "grid-row-end"
}

fn is_calc_resolve_prop(prop : String) -> Bool {
  prop == "z-index" || prop == "scale" || prop == "rotate" ||
  prop == "transition-delay" || prop == "transition-duration" ||
  prop == "animation-delay" || prop == "animation-duration" ||
  prop == "opacity" || prop == "order" || prop == "flex-grow" ||
  prop == "flex-shrink" || prop == "orphans" || prop == "widows" ||
  prop == "column-count" || prop == "image-resolution" ||
  prop == "grid-column-start" || prop == "grid-column-end" ||
  prop == "grid-row-start" || prop == "grid-row-end"
}

fn resolve_math(prop : String, v : Array[Tok], fs : Double, root : Double, env : Env) -> Array[Tok] {
  let mut has_fn = false
  let mut has_non_calc_math = false
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Function(f) => {
        has_fn = true
        let lf = ascii_lower(f)
        if is_math_func(lf) && lf != "calc" {
          has_non_calc_math = true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  if !has_fn {
    return v
  }
  if !has_non_calc_math && !is_calc_resolve_prop(prop) {
    return v
  }
  let cx = MathCx::{ fs: fs, root: root, env: env }
  let out : Array[Tok] = []
  i = 0
  while i < v.length() {
    match v[i] {
      Function(f) => {
        let lf = ascii_lower(f)
        if is_math_func(lf) {
          let e = group_end(v, i + 1)
          match cx.call(lf, tok_slice(v, i + 1, e)) {
            Some(r) => {
              if r.pct == 0.0 && (r.kind == "" || r.pow == 1) {
                let mut x = r.v
                if x != x {
                  x = 0.0
                }
                if is_integer_prop(prop) && r.kind == "" {
                  x = fvdmath::floor(x + 0.5)
                  if x > 2147483647.0 {
                    x = 2147483647.0
                  } else if x < -2147483648.0 {
                    x = -2147483648.0
                  }
                  out.push(Number(x))
                } else {
                  let big = if r.kind == "px" {
                    33554400.0
                  } else {
                    fvdmath::pow(2.0, 127.0) * 1.9999998807907104
                  }
                  if x > big {
                    x = big
                  } else if x < -big {
                    x = -big
                  }
                  if x == 0.0 {
                    x = 0.0
                  }
                  out.push(if r.kind == "" { Number(x) } else { Dimension(x, r.kind) })
                }
                i = e + 1
                continue
              }
            }
            None => ()
          }
          tok_append(out, tok_slice(v, i, e + 1))
          i = e + 1
          continue
        }
        out.push(v[i])
        i = i + 1
      }
      t => {
        out.push(t)
        i = i + 1
      }
    }
  }
  out
}

struct MathInCalcRes {
  v : Double
  pct : Double
  is_num : Bool
}

fn math_in_calc(f : String, inner : Array[Tok], fs : Double, root : Double, env : Env) -> Option[MathInCalcRes] {
  let cx = MathCx::{ fs: fs, root: root, env: env }
  let r = match cx.call(f, inner) {
    Some(x) => x
    None => return None
  }
  if r.kind == "" {
    Some(MathInCalcRes::{ v: r.v, pct: 0.0, is_num: true })
  } else if r.kind == "px" && r.pow == 1 {
    Some(MathInCalcRes::{ v: r.v, pct: r.pct, is_num: false })
  } else {
    None
  }
}
