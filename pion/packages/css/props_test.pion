///| Regression tests for sparse-small -> dense hybrid `Props`.

test "props_sparse_to_dense_promotion_and_ops" {
  let p = Props::new()
  debug_assert(p.length() == 0, "empty length")
  debug_assert(p.get("color").is_none(), "empty get")
  debug_assert(p.same(Props::new()), "empty same")

  // Sparse mode (1..32 properties)
  let mut i = 0
  while i < 32 {
    p.set("p-sparse-\{i}", [Ident("v\{i}")])
    i = i + 1
  }
  debug_assert(p.length() == 32, "sparse 32 length")
  debug_assert(p.contains("p-sparse-0"), "sparse has 0")
  debug_assert(p.contains("p-sparse-31"), "sparse has 31")

  // Overwrite in sparse mode
  p.set("p-sparse-5", [Ident("updated")])
  debug_assert(p.length() == 32, "overwrite keeps length")
  match p.get("p-sparse-5") {
    Some(ts) => debug_assert(toks_eq(ts, [Ident("updated")]), "overwrite value")
    None => debug_assert(false, "overwrite missing")
  }

  // Copy & same in sparse mode
  let cp = p.copy()
  debug_assert(p.same(cp), "sparse copy same")

  // Remove in sparse mode
  cp.remove("p-sparse-10")
  debug_assert(cp.length() == 31, "sparse remove length")
  debug_assert(!cp.contains("p-sparse-10"), "sparse remove absent")
  debug_assert(!p.same(cp), "sparse diff after remove")

  // Promote sparse -> dense on 33rd property
  p.set("p-dense-32", [Ident("v32")])
  p.set("p-dense-33", [Ident("v33")])
  debug_assert(p.length() == 34, "dense 34 length")
  debug_assert(p.contains("p-sparse-0"), "dense keeps sparse-0")
  debug_assert(p.contains("p-dense-33"), "dense has 33")

  // Cross sparse vs dense same()
  cp.set("p-sparse-10", [Ident("v10")])
  p.remove("p-dense-32")
  p.remove("p-dense-33")
  debug_assert(p.same(cp), "dense vs sparse same")
  debug_assert(cp.same(p), "sparse vs dense same")

  // each_id count matches length
  let seen : Array[Int] = [0]
  p.each_id(fn(_id, _v) { seen[0] = seen[0] + 1 })
  debug_assert(seen[0] == 32, "each_id count")
  debug_assert(p.keys().length() == 32, "keys count")
}

test "props_inline_two_slot_transitions" {
  let p = Props::new()
  debug_assert(p.length() == 0 && p.keys().length() == 0, "0 props")

  // 0 -> 1 (inline k0)
  p.set("display", [Ident("block")])
  debug_assert(p.length() == 1, "1 prop")
  debug_assert(p.k0 >= 0 && p.k1 < 0 && p.keys.length() == 0, "1 prop stays inline")
  match p.get("display") {
    Some(ts) => debug_assert(toks_eq(ts, [Ident("block")]), "k0 value")
    None => debug_assert(false, "k0 missing")
  }

  // Overwrite k0
  p.set("display", [Ident("flex")])
  debug_assert(p.length() == 1, "overwrite k0 keeps length")
  match p.get("display") {
    Some(ts) => debug_assert(toks_eq(ts, [Ident("flex")]), "k0 updated")
    None => debug_assert(false, "k0 updated missing")
  }

  // 1 -> 2 (inline k0 + k1)
  p.set("color", [Ident("red")])
  debug_assert(p.length() == 2 && p.k0 >= 0 && p.k1 >= 0 && p.keys.length() == 0, "2 props stay inline")
  let c2 = p.copy()
  debug_assert(p.same(c2) && c2.same(p), "inline copy same")
  let seen2 : Array[Int] = [0]
  p.each_id(fn(_id, _v) { seen2[0] = seen2[0] + 1 })
  debug_assert(seen2[0] == 2 && p.keys().length() == 2, "inline each_id & keys")

  // Remove k0 -> k1 shifts into k0
  p.remove("display")
  debug_assert(p.length() == 1 && p.k0 >= 0 && p.k1 < 0, "remove k0 shifts k1->k0")
  debug_assert(!p.contains("display") && p.contains("color"), "remaining color")

  // Remove last -> back to 0
  p.remove("color")
  debug_assert(p.length() == 0 && p.k0 < 0 && p.k1 < 0, "back to 0")

  // 0 -> 1 -> 2 -> 3 (promotes to sparse array)
  p.set("display", [Ident("grid")])
  p.set("color", [Ident("blue")])
  p.set("margin-top", [Ident("4px")])
  debug_assert(p.length() == 3 && p.k0 < 0 && p.k1 < 0 && p.keys.length() == 3, "3 props promoted to sparse")
  debug_assert(p.contains("display") && p.contains("color") && p.contains("margin-top"), "all 3 present")

  // Cross inline (c2) vs sparse (q) same()
  let q = Props::new()
  q.set("display", [Ident("flex")])
  q.set("color", [Ident("red")])
  q.set("margin-top", [Ident("1px")])
  q.remove("margin-top")
  debug_assert(q.length() == 2 && q.same(c2) && c2.same(q), "sparse-2 vs inline-2 same")

  // Promote all the way to dense (33+)
  let mut i = 0
  while i < 35 {
    p.set("p-inline-dense-\{i}", [Ident("d\{i}")])
    i = i + 1
  }
  debug_assert(p.length() == 38 && p.slots.length() > 0 && p.k0 < 0 && p.k1 < 0, "promoted to dense")
  debug_assert(p.contains("display") && p.contains("p-inline-dense-34"), "dense preserves all")
}

test "props_256bit_mask_boundaries" {
  // One id in each of the four words, then one past 255 (it shares the bit of id & 255)
  let id_w0 = 5
  let id_w1 = 70
  let id_w2 = 133 // in a 128-bit mask it folded onto 5
  let id_w3 = 198 // in a 128-bit mask it folded onto 70
  let id_fold = 261 // 261 & 255 == 5: shares id_w0's bit

  let p = Props::new()
  debug_assert(p.mask0 == 0L && p.mask1 == 0L && p.mask2 == 0L && p.mask3 == 0L, "initial masks zero")
  debug_assert(mask_word(id_w0) == 0 && mask_word(id_w1) == 1 && mask_word(id_w2) == 2 && mask_word(id_w3) == 3, "words")
  debug_assert(mask_word(id_fold) == 0 && mask_bit_in(id_fold, 0) == mask_bit_in(id_w0, 0), "past 255 folds")
  debug_assert(mask_bit_in(id_w2, 0) == 0L && mask_bit_in(id_w2, 2) == 1L << 5, "a bit only in its own word")

  p.set_id(id_w0, [Ident("w0")])
  p.set_id(id_w1, [Ident("w1")])
  debug_assert(p.mask0 == 1L << 5 && p.mask1 == 1L << 6 && p.mask2 == 0L && p.mask3 == 0L, "inline masks")
  // ids that shared a bit in 128 bits do not now
  debug_assert(!p.maybe_has_id(id_w2) && !p.maybe_has_id(id_w3), "133 and 198 do not fold onto 5 and 70")
  debug_assert(p.maybe_has_id(id_fold) && p.get_id(id_fold).is_none(), "a folding absent id reads None")
  p.set_id(id_w2, [Ident("w2")]) // promotes to sparse keys
  p.set_id(id_w3, [Ident("w3")])
  debug_assert(p.length() == 4 && p.mask2 == 1L << 5 && p.mask3 == 1L << 6, "sparse masks")
  debug_assert(p.has_any_mask(0L, 0L, 1L << 5, 0L) && p.has_any_mask(0L, 0L, 0L, 1L << 6), "has_any_mask words 2, 3")
  debug_assert(!p.has_any_mask(1L << 6, 1L << 5, 1L << 6, 1L << 5), "has_any_mask misses")
  match p.get_id(id_w3) {
    Some(ts) => debug_assert(toks_eq(ts, [Ident("w3")]), "id_w3 intact")
    None => debug_assert(false, "id_w3 missing")
  }
  p.set_id(id_fold, [Ident("fold")])
  match p.get_id(id_w0) {
    Some(ts) => debug_assert(toks_eq(ts, [Ident("w0")]), "id_w0 intact after folding id")
    None => debug_assert(false, "id_w0 missing")
  }
  match p.get_id(id_fold) {
    Some(ts) => debug_assert(toks_eq(ts, [Ident("fold")]), "id_fold read")
    None => debug_assert(false, "id_fold missing")
  }
  p.set_id(id_w3, [Ident("w3b")])
  debug_assert(p.length() == 5, "overwrite keeps length")

  let cp = p.copy()
  debug_assert(cp.mask0 == p.mask0 && cp.mask1 == p.mask1 && cp.mask2 == p.mask2 && cp.mask3 == p.mask3, "copy keeps masks")
  debug_assert(cp.contains_id(id_w2) && cp.contains_id(id_w3) && cp.contains_id(id_fold), "copy lookups work")

  // dense (over 32 own properties) keeps the masks too
  let d = Props::new()
  let mut i = 0
  while i < 40 {
    d.set_id(i * 6, [Ident("d\{i}")]) // 0 .. 234, every word
    i = i + 1
  }
  debug_assert(d.slots.length() > 0 && d.maybe_has_id(234) && d.maybe_has_id(132) && !d.maybe_has_id(235), "dense masks")

  p.remove_id(id_w0)
  debug_assert(p.get_id(id_w0).is_none() && p.contains_id(id_fold), "partial remove")
  p.remove_id(id_w1)
  p.remove_id(id_w2)
  p.remove_id(id_w3)
  p.remove_id(id_fold)
  debug_assert(p.length() == 0 && p.mask0 == 0L && p.mask1 == 0L && p.mask2 == 0L && p.mask3 == 0L, "emptied resets masks")
}

test "props_256bit_builtin_ids_have_their_own_bits" {
  // Every built-in property has an id below 256: none shares a mask bit with another
  debug_assert(p_slider_thumb_rot < 256 && p_font_size < 256 && p_color < 256, "built-in ids below 256")
  // pairs that shared a bit in a 128-bit mask
  let pairs : Array[(Int, Int)] = [
    (p_font_size, p_column_gap),
    (p_color, p_column_width),
    (p_pointer_events, p_align_self),
  ]
  for pr in pairs {
    let p = Props::new()
    p.set_id(pr.0, [Ident("x")])
    debug_assert(!p.maybe_has_id(pr.1), "\{prop_names[pr.0]} and \{prop_names[pr.1]} have their own bits")
  }
}
