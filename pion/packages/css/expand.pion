///| Shorthand expansion, quirks validation, presentational hints, lengths & colors.
///| 1:1 port of the expansion/hints/length/color sections of `client/src/css/cascade.mbt`.

pub struct Length {
  pub px : Double
  pub pct : Double
}

pub struct Color {
  pub r : Int
  pub g : Int
  pub b : Int
  pub a : Double
}

pub fn words(t : Array[Tok]) -> Array[Array[Tok]] {
  let out : Array[Array[Tok]] = []
  let cur : Array[Tok] = []
  let mut depth = 0
  let mut i = 0
  while i < t.length() {
    let x = t[i]
    match x {
      Function(_) => depth = depth + 1
      OpenParen => depth = depth + 1
      OpenSquare => depth = depth + 1
      CloseParen => depth = depth - 1
      CloseSquare => depth = depth - 1
      _ => ()
    }
    if tok_eq(x, Space) && depth == 0 {
      if cur.length() > 0 {
        out.push(tok_copy(cur))
        cur.clear()
      }
    } else {
      cur.push(x)
      if depth == 0 && i + 1 < t.length() {
        let ends_word = match x {
          CloseParen | Ident(_) | Dimension(_, _) | Number(_) | Percentage(_) | Hash(_, _) | Str(_) | Url(_) => true
          _ => false
        }
        if ends_word {
          let next_starts_word = match t[i + 1] {
            Ident(_) | Function(_) | Dimension(_, _) | Number(_) | Percentage(_) | Hash(_, _) | Str(_) | Url(_) => true
            _ => false
          }
          if next_starts_word {
            out.push(tok_copy(cur))
            cur.clear()
          }
        }
      }
    }
    i = i + 1
  }
  if cur.length() > 0 {
    out.push(cur)
  }
  out
}

pub fn split_top_commas(t : Array[Tok]) -> Array[Array[Tok]] {
  split_commas(t)
}

struct FourSides {
  top : Array[Tok]
  right : Array[Tok]
  bottom : Array[Tok]
  left : Array[Tok]
}

fn sides(v : Array[Array[Tok]]) -> FourSides {
  let n = v.length()
  if n == 0 { FourSides::{ top: [], right: [], bottom: [], left: [] } }
  else if n == 1 { FourSides::{ top: v[0], right: v[0], bottom: v[0], left: v[0] } }
  else if n == 2 { FourSides::{ top: v[0], right: v[1], bottom: v[0], left: v[1] } }
  else if n == 3 { FourSides::{ top: v[0], right: v[1], bottom: v[2], left: v[1] } }
  else { FourSides::{ top: v[0], right: v[1], bottom: v[2], left: v[3] } }
}

fn is_ident(v : Array[Tok], names : Array[String]) -> Bool {
  v.length() == 1 && match v[0] {
    Ident(w) => str_arr_contains(names, ascii_lower(w))
    _ => false
  }
}

fn is_color(v : Array[Tok]) -> Bool {
  parse_color(v, 0).is_some()
}

fn is_image_word(w : Array[Tok]) -> Bool {
  if w.length() == 0 { return false }
  match w[0] {
    Url(_) => true
    Function(f) => {
      let lf = ascii_lower(f)
      lf == "url" || str_has_suffix(lf, "gradient") || str_has_suffix(lf, "image-set")
    }
    _ => false
  }
}

fn set_box(out : Map[String, Array[Tok]], pre : String, suf : String, v : Array[Tok]) -> Unit {
  let ws = words(v)
  if ws.length() == 0 { return }
  let s = sides(ws)
  out.set(pre + "top" + suf, s.top)
  out.set(pre + "right" + suf, s.right)
  out.set(pre + "bottom" + suf, s.bottom)
  out.set(pre + "left" + suf, s.left)
}

fn set_border(out : Map[String, Array[Tok]], side : String, v : Array[Tok]) -> Unit {
  let mut width : Array[Tok] = [Ident("medium")]
  let mut style : Array[Tok] = [Ident("none")]
  let mut color : Array[Tok] = [Ident("currentcolor")]
  let ws = words(v)
  let mut i = 0
  while i < ws.length() {
    let w = ws[i]
    if is_ident(w, ["none", "hidden", "dotted", "dashed", "solid", "double", "groove", "ridge", "inset", "outset"]) {
      style = w
    } else if is_color(w) {
      color = w
    } else {
      width = w
    }
    i = i + 1
  }
  out.set("border-" + side + "-width", width)
  out.set("border-" + side + "-style", style)
  out.set("border-" + side + "-color", color)
}

fn font_shorthand_valid(v : Array[Tok], ws : Array[Array[Tok]]) -> Bool {
  if is_ident(v, ["caption", "icon", "menu", "message-box", "small-caption", "status-bar"]) {
    return true
  }
  let mut i = 0
  while i < ws.length() {
    let w = ws[i]
    if w.length() > 0 {
      let ok = match w[0] {
        Dimension(_, _) => true
        Percentage(_) => true
        Number(n) => n == 0.0
        Ident(x) => {
          let lx = ascii_lower(x)
          lx == "xx-small" || lx == "x-small" || lx == "small" || lx == "medium" ||
          lx == "large" || lx == "x-large" || lx == "xx-large" || lx == "xxx-large" ||
          lx == "smaller" || lx == "larger"
        }
        Function(f) => {
          let lf = ascii_lower(f)
          lf == "calc" || lf == "min" || lf == "max" || lf == "clamp" || lf == "var" || lf == "env"
        }
        _ => false
      }
      if ok {
        return i + 1 < ws.length()
      }
    }
    i = i + 1
  }
  false
}

let logical_marks : Map[String, String] = Map::new()
let logical_yes : Array[Tok] = [Ident("1")]
let important_marks : Map[String, Int] = Map::new()
let mark_ids : Array[Int] = []

fn important_mark(k : String) -> Int {
  match important_marks.get(k) {
    Some(m) => m
    None => {
      let m = prop_id("-fv-important-" + k)
      important_marks.set(k, m)
      m
    }
  }
}

fn logical_mark(k : String) -> String {
  match logical_marks.get(k) {
    Some(m) => m
    None => {
      let m = "-fv-logical-" + k
      logical_marks.set(k, m)
      m
    }
  }
}

fn mark_id(id : Int) -> Int {
  while mark_ids.length() <= id {
    mark_ids.push(-1)
  }
  if mark_ids[id] < 0 {
    let m = prop_id(logical_mark(prop_names[id]))
    while mark_ids.length() <= id {
      mark_ids.push(-1)
    }
    mark_ids[id] = m
  }
  mark_ids[id]
}

struct DeclLonghands {
  list : Array[(String, Array[Tok])]
  logical : Bool
}

fn decl_longhands(name0 : String, v : Array[Tok]) -> DeclLonghands {
  let tmp : Map[String, Array[Tok]] = Map::new()
  expand_decl(name0, v, tmp)
  let name = alias_of(name0)
  let logical = str_contains(name, "inline") || str_contains(name, "block") ||
  str_has_suffix(name, "-start") || str_has_suffix(name, "-end")
  let list : Array[(String, Array[Tok])] = []
  let ks = tmp.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match tmp.get(k) {
      Some(val_) => list.push((k, val_))
      None => ()
    }
    i = i + 1
  }
  DeclLonghands::{ list: list, logical: logical }
}

fn expand(name0 : String, v : Array[Tok], out : Map[String, Array[Tok]]) -> Unit {
  let dl = decl_longhands(name0, v)
  let mut i = 0
  while i < dl.list.length() {
    let kv = dl.list[i]
    out.set(kv.0, kv.1)
    let mark = logical_mark(kv.0)
    if dl.logical {
      out.set(mark, logical_yes)
    } else {
      let _ = out.remove(mark)
    }
    i = i + 1
  }
}

fn longhand_ids(name : String, v : Array[Tok]) -> Array[Longhand] {
  let dl = decl_longhands(name, v)
  let out : Array[Longhand] = []
  let mut i = 0
  while i < dl.list.length() {
    let kv = dl.list[i]
    let id = prop_id(kv.0)
    out.push(Longhand::{ id: id, mark: mark_id(id), logical: dl.logical, value: kv.1 })
    i = i + 1
  }
  out
}

fn put_longhand_ids(list : Array[Longhand], out : Props) -> Unit {
  let mut i = 0
  while i < list.length() {
    let l = list[i]
    out.set_id(l.id, l.value)
    if l.logical {
      out.set_id(l.mark, logical_yes)
    } else if l.mark >= 0 {
      out.remove_id(l.mark)
    }
    i = i + 1
  }
}

fn expand_decl_kept(d : Decl, out : Props) -> Bool {
  match d.longhands {
    Some(list) => {
      put_longhand_ids(list, out)
      true
    }
    None => {
      if has_var(d.value) || has_attr_fn(d.value) {
        false
      } else {
        let list = longhand_ids(d.name, d.value)
        d.longhands = Some(list)
        put_longhand_ids(list, out)
        true
      }
    }
  }
}

fn expand_props(name : String, v : Array[Tok], out : Props) -> Unit {
  put_longhand_ids(longhand_ids(name, v), out)
}

fn display_canonical(ws : Array[Array[Tok]]) -> Option[Array[Tok]] {
  let mut outer = ""
  let mut inner = ""
  let mut item = false
  let mut i = 0
  while i < ws.length() {
    if ws[i].length() != 1 { return None }
    let k = match ws[i][0] { Ident(x) => ascii_lower(x) _ => return None }
    if k == "block" || k == "inline" || k == "run-in" {
      if outer != "" { return None }
      outer = k
    } else if k == "math" {
      if inner != "" { return None }
      inner = "flow"
    } else if k == "flow" || k == "flow-root" || k == "table" || k == "flex" || k == "grid" || k == "grid-lanes" || k == "ruby" {
      if inner != "" { return None }
      inner = k
    } else if k == "list-item" {
      if item { return None }
      item = true
    } else {
      return None
    }
    i = i + 1
  }
  if item && !(inner == "" || inner == "flow" || inner == "flow-root") {
    return None
  }
  let o = if outer == "" { if inner == "ruby" { "inline" } else { "block" } } else { outer }
  let inn = if inner == "" { "flow" } else { inner }
  let res : Array[String] = []
  if item {
    if o != "block" { res.push(o) }
    if inn != "flow" { res.push(inn) }
    res.push("list-item")
  } else if o == "block" && inn == "flow" {
    res.push("block")
  } else if o == "inline" && inn == "flow" {
    res.push("inline")
  } else if o == "run-in" && inn == "flow" {
    res.push("run-in")
  } else if o == "block" && inn == "flow-root" {
    res.push("flow-root")
  } else if o == "inline" && inn == "flow-root" {
    res.push("inline-block")
  } else if o == "block" && inn != "ruby" {
    res.push(inn)
  } else if o == "inline" && inn == "ruby" {
    res.push("ruby")
  } else if o == "inline" && inn == "grid-lanes" {
    res.push("inline"); res.push("grid-lanes")
  } else if o == "inline" {
    res.push("inline-" + inn)
  } else {
    res.push(o); res.push(inn)
  }
  let out : Array[Tok] = []
  i = 0
  while i < res.length() {
    if i > 0 { out.push(Space) }
    out.push(Ident(res[i]))
    i = i + 1
  }
  Some(out)
}

fn align_words(v : Array[Tok]) -> Option[Array[String]] {
  if is_ident(v, ["inherit", "initial", "unset", "revert", "revert-layer"]) || has_var(v) {
    return None
  }
  let out : Array[String] = []
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Ident(k) => out.push(ascii_lower(k))
      Space => ()
      _ => return Some([])
    }
    i = i + 1
  }
  Some(out)
}

fn idents_toks(w : Array[String]) -> Array[Tok] {
  let out : Array[Tok] = []
  let mut i = 0
  while i < w.length() {
    if i > 0 { out.push(Space) }
    out.push(Ident(w[i]))
    i = i + 1
  }
  out
}

struct AlignRes {
  next : Int
  words : Array[String]
}

fn parse_alignment(prop : String, w : Array[String], i : Int) -> Option[AlignRes] {
  let a = if i < w.length() { w[i] } else { "" }
  let a1 = if i + 1 < w.length() { w[i + 1] } else { "" }
  let self_pos = ["center", "start", "end", "self-start", "self-end", "flex-start", "flex-end", "flow-start", "flow-end"]
  let content_pos = ["center", "start", "end", "flex-start", "flex-end", "flow-start", "flow-end"]
  let is_self = str_has_suffix(prop, "-self") || str_has_suffix(prop, "-items")
  let justify = str_has_prefix(prop, "justify-")
  let positions = if is_self { self_pos } else { content_pos }
  if prop != "justify-content" {
    if a == "baseline" { return Some(AlignRes::{ next: i + 1, words: ["baseline"] }) }
    if (a == "first" || a == "last") && a1 == "baseline" {
      return Some(AlignRes::{ next: i + 2, words: if a == "first" { ["baseline"] } else { ["last", "baseline"] } })
    }
  }
  if a == "normal" { return Some(AlignRes::{ next: i + 1, words: ["normal"] }) }
  if a == "auto" && str_has_suffix(prop, "-self") { return Some(AlignRes::{ next: i + 1, words: ["auto"] }) }
  if a == "stretch" { return Some(AlignRes::{ next: i + 1, words: ["stretch"] }) }
  if str_has_suffix(prop, "-content") && (a == "space-between" || a == "space-around" || a == "space-evenly") {
    return Some(AlignRes::{ next: i + 1, words: [a] })
  }
  if a == "anchor-center" && is_self { return Some(AlignRes::{ next: i + 1, words: [a] }) }
  if prop == "justify-items" {
    let lr = ["left", "right", "center"]
    if a == "legacy" {
      return if str_arr_contains(lr, a1) { Some(AlignRes::{ next: i + 2, words: ["legacy", a1] }) }
      else { Some(AlignRes::{ next: i + 1, words: ["legacy"] }) }
    }
    if str_arr_contains(lr, a) && a1 == "legacy" {
      return Some(AlignRes::{ next: i + 2, words: ["legacy", a] })
    }
  }
  let pos_ok = fn(p : String) -> Bool { str_arr_contains(positions, p) || (justify && (p == "left" || p == "right")) }
  if a == "safe" || a == "unsafe" {
    if pos_ok(a1) || (a1 == "normal" && !str_has_suffix(prop, "-content")) {
      return Some(AlignRes::{ next: i + 2, words: [a, a1] })
    }
    return None
  }
  if pos_ok(a) { return Some(AlignRes::{ next: i + 1, words: [a] }) }
  None
}

fn wrap_value(ws : Array[Array[Tok]]) -> Array[Tok] {
  let wds : Array[String] = []
  let mut i = 0
  while i < ws.length() {
    if ws[i].length() == 1 {
      match ws[i][0] { Ident(x) => wds.push(ascii_lower(x)) _ => () }
    }
    i = i + 1
  }
  if str_arr_contains(wds, "balance") {
    if str_arr_contains(wds, "wrap-reverse") {
      [Ident("wrap-reverse"), Space, Ident("balance")]
    } else {
      [Ident("balance")]
    }
  } else {
    let flat : Array[Tok] = []
    i = 0
    while i < ws.length() { tok_append(flat, ws[i]); i = i + 1 }
    flat
  }
}

fn comma_items(v : Array[Tok]) -> Array[Array[Tok]] {
  let out : Array[Array[Tok]] = []
  let cur : Array[Tok] = []
  let mut depth = 0
  let mut i = 0
  while i < v.length() {
    let x = v[i]
    match x {
      Function(_) => depth = depth + 1
      OpenParen => depth = depth + 1
      OpenSquare => depth = depth + 1
      CloseParen => depth = depth - 1
      CloseSquare => depth = depth - 1
      _ => ()
    }
    if tok_eq(x, Comma) && depth == 0 {
      out.push(tok_copy(cur))
      cur.clear()
    } else if !tok_eq(x, End) {
      cur.push(x)
    }
    i = i + 1
  }
  out.push(cur)
  out
}

fn set_lists(out : Map[String, Array[Tok]], names : Array[String], items : Array[Array[Array[Tok]]]) -> Unit {
  let mut k = 0
  while k < names.length() {
    let list : Array[Tok] = []
    let mut i = 0
    while i < items.length() {
      if i > 0 { list.push(Comma); list.push(Space) }
      tok_append(list, items[i][k])
      i = i + 1
    }
    out.set(names[k], list)
    k = k + 1
  }
}

fn is_easing(w : Array[Tok]) -> Bool {
  if w.length() == 1 {
    match w[0] {
      Ident(k) => {
        let lk = ascii_lower(k)
        return lk == "ease" || lk == "linear" || lk == "ease-in" || lk == "ease-out" ||
        lk == "ease-in-out" || lk == "step-start" || lk == "step-end"
      }
      _ => ()
    }
  }
  if w.length() > 0 {
    match w[0] {
      Function(f) => {
        let lf = ascii_lower(f)
        return lf == "cubic-bezier" || lf == "steps" || lf == "linear"
      }
      _ => ()
    }
  }
  false
}

fn is_time(w : Array[Tok]) -> Bool {
  if w.length() == 1 {
    match w[0] {
      Dimension(_, u) => { let lu = ascii_lower(u); return lu == "s" || lu == "ms" }
      _ => ()
    }
  }
  if w.length() > 0 {
    match w[0] {
      Function(f) => return ascii_lower(f) == "calc"
      _ => ()
    }
  }
  false
}

fn expand_transition(out : Map[String, Array[Tok]], v : Array[Tok], global : Bool) -> Unit {
  let names = ["transition-property", "transition-duration", "transition-timing-function", "transition-delay", "transition-behavior"]
  if global {
    let mut i = 0
    while i < names.length() { out.set(names[i], v); i = i + 1 }
    return
  }
  let items : Array[Array[Array[Tok]]] = []
  let parts = comma_items(v)
  let mut pi = 0
  while pi < parts.length() {
    let mut prop : Option[Array[Tok]] = None
    let mut dur : Option[Array[Tok]] = None
    let mut delay : Option[Array[Tok]] = None
    let mut easing : Option[Array[Tok]] = None
    let mut behavior : Option[Array[Tok]] = None
    let ws = words(parts[pi])
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      if is_time(w) {
        if dur.is_none() { dur = Some(w) }
        else if delay.is_none() { delay = Some(w) }
        else { return }
      } else if is_easing(w) {
        if easing.is_some() { return }
        easing = Some(w)
      } else if w.length() == 1 {
        match w[0] {
          Ident(k) => {
            let l = ascii_lower(k)
            if l == "allow-discrete" || l == "normal" {
              if behavior.is_some() { return }
              behavior = Some(w)
            } else {
              if prop.is_some() || is_global_keyword(l) || l == "default" || (l == "none" && parts.length() > 1) {
                return
              }
              prop = Some(w)
            }
          }
          _ => return
        }
      } else {
        return
      }
      wi = wi + 1
    }
    items.push([
      match prop { Some(x) => x None => [Ident("all")] },
      match dur { Some(x) => x None => [Dimension(0.0, "s")] },
      match easing { Some(x) => x None => [Ident("ease")] },
      match delay { Some(x) => x None => [Dimension(0.0, "s")] },
      match behavior { Some(x) => x None => [Ident("normal")] },
    ])
    pi = pi + 1
  }
  set_lists(out, names, items)
}

fn expand_animation(out : Map[String, Array[Tok]], v : Array[Tok], global : Bool) -> Unit {
  let names = [
    "animation-duration", "animation-timing-function", "animation-delay", "animation-iteration-count",
    "animation-direction", "animation-fill-mode", "animation-play-state", "animation-name",
  ]
  if global {
    let mut i = 0
    while i < names.length() { out.set(names[i], v); i = i + 1 }
    return
  }
  let items : Array[Array[Array[Tok]]] = []
  let parts = comma_items(v)
  let mut pi = 0
  while pi < parts.length() {
    let slot : Array[Option[Array[Tok]]] = [None, None, None, None, None, None, None, None]
    let ws = words(parts[pi])
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      let k = word_ident(w)
      let is_num = w.length() == 1 && match w[0] { Number(_) => true _ => false }
      let is_id_or_str = w.length() == 1 && match w[0] { Ident(_) => true Str(_) => true _ => false }
      let at = if is_time(w) {
        if slot[0].is_none() { 0 } else { 2 }
      } else if is_easing(w) {
        1
      } else if (is_num || k == "infinite") && slot[3].is_none() {
        3
      } else if (k == "normal" || k == "reverse" || k == "alternate" || k == "alternate-reverse") && slot[4].is_none() {
        4
      } else if (k == "forwards" || k == "backwards" || k == "both" || k == "none") && slot[5].is_none() {
        5
      } else if (k == "running" || k == "paused") && slot[6].is_none() {
        6
      } else if is_id_or_str && slot[7].is_none() {
        7
      } else {
        return
      }
      if slot[at].is_some() { return }
      slot[at] = Some(w)
      wi = wi + 1
    }
    let defaults : Array[Array[Tok]] = [
      [Dimension(0.0, "s")], [Ident("ease")], [Dimension(0.0, "s")], [Number(1.0)],
      [Ident("normal")], [Ident("none")], [Ident("running")], [Ident("none")],
    ]
    let row : Array[Array[Tok]] = []
    let mut j = 0
    while j < 8 {
      row.push(match slot[j] { Some(x) => x None => defaults[j] })
      j = j + 1
    }
    items.push(row)
    pi = pi + 1
  }
  set_lists(out, names, items)
}

fn expand_decl(name0 : String, v0 : Array[Tok], out : Map[String, Array[Tok]]) -> Unit {
  let name = alias_of(name0)
  let v1 = match quirky_value(name, v0) {
    Some(x) => x
    None => return
  }
  let v = if name == "overflow" || name == "overflow-x" || name == "overflow-y" {
    let nv : Array[Tok] = []
    let mut i = 0
    while i < v1.length() {
      match v1[i] {
        Ident(w) => if ascii_lower(w) == "overlay" { nv.push(Ident("auto")) } else { nv.push(v1[i]) }
        _ => nv.push(v1[i])
      }
      i = i + 1
    }
    nv
  } else {
    v1
  }
  let global = is_ident(v, ["inherit", "initial", "unset", "revert", "revert-layer"])
  if name == "text-align" && !global && !has_var(v) && !has_attr_fn(v) {
