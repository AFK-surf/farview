  if name == "mask" || name == "-webkit-mask" {
    let target = if name == "mask" { "mask-image" } else { "-webkit-mask-image" }
    let size_target = if name == "mask" { "mask-size" } else { "-webkit-mask-size" }
    if global {
      out.set(target, v)
      out.set(size_target, v)
      out.set(name, v)
      return
    }
    let layers = split_commas(v)
    let all_imgs : Array[Tok] = []
    let all_sizes : Array[Tok] = []
    let mut any_img = false
    let mut any_size = false
    let mut li = 0
    while li < layers.length() {
      let lws = words(trim(layers[li]))
      let mut img_tok : Option[Array[Tok]] = None
      let mut sz_tok : Option[Array[Tok]] = None
      let mut i = 0
      while i < lws.length() {
        let w = lws[i]
        if is_image_word(w) || is_ident(w, ["none"]) {
          if img_tok.is_none() {
            img_tok = Some(w)
          }
        } else {
          match tok_search_delim(w, 47) {
            Some(k) => {
              if k + 1 < w.length() {
                let sz = tok_slice(w, k + 1, w.length())
                if i + 1 < lws.length() && !is_image_word(lws[i + 1]) && !is_ident(lws[i + 1], ["no-repeat", "repeat", "repeat-x", "repeat-y", "space", "round", "none", "border-box", "padding-box", "content-box", "add", "subtract", "intersect", "exclude", "alpha", "luminance", "match-source"]) {
                  let both : Array[Tok] = []
                  tok_append(both, sz)
                  both.push(Space)
                  tok_append(both, lws[i + 1])
                  sz_tok = Some(both)
                  i = i + 1
                } else {
                  sz_tok = Some(sz)
                }
              } else if i + 1 < lws.length() {
                sz_tok = Some(lws[i + 1])
                i = i + 1
              }
            }
            None => ()
          }
        }
        i = i + 1
      }
      if li > 0 {
        all_imgs.push(Comma)
        all_sizes.push(Comma)
      }
      match img_tok {
        Some(t) => {
          tok_append(all_imgs, t)
          any_img = true
        }
        None => all_imgs.push(Ident("none"))
      }
      match sz_tok {
        Some(t) => {
          tok_append(all_sizes, t)
          any_size = true
        }
        None => all_sizes.push(Ident("auto"))
      }
      li = li + 1
    }
    if any_img { out.set(target, all_imgs) }
    if any_size { out.set(size_target, all_sizes) }
    out.set(name, v)
    return
  }
  if name == "text-decoration-line" {
    out.set("text-decoration-line", v)
    return
  }
  if name == "text-decoration" {
    if global || has_var(v) {
      out.set("text-decoration-line", v)
      out.set("text-decoration-style", v)
      out.set("text-decoration-color", v)
      out.set("text-decoration-thickness", v)
      return
    }
    let lines : Array[Tok] = []
    let mut deco_style : Array[Tok] = [Ident("solid")]
    let mut deco_col : Option[Array[Tok]] = None
    let mut deco_thick : Option[Array[Tok]] = None
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      if is_ident(w, ["none", "underline", "overline", "line-through", "blink"]) {
        if lines.length() > 0 { lines.push(Space) }
        tok_append(lines, w)
      } else if is_ident(w, ["solid", "double", "dotted", "dashed", "wavy"]) {
        deco_style = w
      } else if is_ident(w, ["auto", "from-font"]) || (w.length() == 1 && match w[0] { Dimension(_, _) | Percentage(_) => true _ => false }) {
        deco_thick = Some(w)
      } else if parse_col(w).is_some() {
        deco_col = Some(w)
      }
      wi = wi + 1
    }
    if lines.length() > 0 {
      out.set("text-decoration-line", lines)
    } else {
      out.set("text-decoration-line", [Ident("none")])
    }
    out.set("text-decoration-style", deco_style)
    match deco_col {
      Some(c) => out.set("text-decoration-color", c)
      None => out.set("text-decoration-color", [Ident("currentcolor")])
    }
    match deco_thick {
      Some(th) => out.set("text-decoration-thickness", th)
      None => out.set("text-decoration-thickness", [Ident("auto")])
    }
    return
  }
  if name == "white-space" {
    if global || has_var(v) {
      out.set("white-space", v)
    } else if ws.length() >= 1 {
      let mut ok = true
      let mut wi = 0
      while wi < ws.length() {
        let k = if ws[wi].length() == 1 {
          match ws[wi][0] { Ident(x) => ascii_lower(x) _ => "" }
        } else {
          ""
        }
        if k != "normal" && k != "nowrap" && k != "pre" && k != "pre-wrap" && k != "pre-line" && k != "break-spaces" &&
        k != "collapse" && k != "preserve" && k != "preserve-breaks" && k != "preserve-spaces" &&
        k != "wrap" && k != "balance" && k != "pretty" {
          ok = false
          break
        }
        wi = wi + 1
      }
      if ok { out.set("white-space", v) }
    }
    return
  }
  if name == "grid-template" || name == "grid" {
    let mut left = v
    let mut right : Array[Tok] = []
    match tok_search_delim(v, 47) {
      Some(k) => {
        left = tok_slice(v, 0, k)
        right = tok_slice(v, k + 1, v.length())
      }
      None => ()
    }
    let mut has_str = false
    let mut si = 0
    while si < left.length() {
      match left[si] {
        Str(_) => { has_str = true; break }
        _ => ()
      }
      si = si + 1
    }
    if !has_str {
      out.set("grid-template-areas", [])
      out.set("grid-template-rows", trim(left))
      out.set("grid-template-columns", trim(right))
      return
    }
    // CSS Grid 1 §7.4 ASCII-art syntax:
    // [ <line-names>? <string> <track-size>? <line-names>? ]+ [ / <explicit-track-list> ]?
    let areas : Array[Tok] = []
    let rows : Array[Tok] = []
    let mut i = 0
    while i < left.length() {
      match left[i] {
        Space => { i = i + 1 }
        OpenSquare => {
          i = i + 1
          while i < left.length() {
            match left[i] {
              CloseSquare => { i = i + 1; break }
              _ => { i = i + 1 }
            }
          }
        }
        Str(_) => {
          areas.push(left[i])
          areas.push(Space)
          i = i + 1
          while i < left.length() {
            match left[i] {
              Space => { i = i + 1 }
              _ => break
            }
          }
          let is_track = i < left.length() && match left[i] {
            Str(_) => false
            OpenSquare => false
            _ => true
          }
          if is_track {
            match left[i] {
              Function(_) | OpenParen => {
                let mut depth = 0
                while i < left.length() {
                  let tk = left[i]
                  rows.push(tk)
                  i = i + 1
                  match tk {
                    Function(_) | OpenParen => { depth = depth + 1 }
                    CloseParen => {
                      depth = depth - 1
                      if depth <= 0 { break }
                    }
                    _ => ()
                  }
                }
              }
              _ => {
                rows.push(left[i])
                i = i + 1
              }
            }
            rows.push(Space)
          } else {
            rows.push(Ident("auto"))
            rows.push(Space)
          }
        }
        _ => { i = i + 1 }
      }
    }
    out.set("grid-template-areas", trim(areas))
    out.set("grid-template-rows", trim(rows))
    out.set("grid-template-columns", trim(right))
    return
  }
  if name == "grid-row" || name == "grid-column" || name == "grid-area" {
    let parts : Array[Array[Tok]] = [[]]
    let mut depth = 0
    let mut i = 0
    while i < v.length() {
      match v[i] {
        OpenParen | Function(_) | OpenSquare => {
          depth = depth + 1
          parts[parts.length() - 1].push(v[i])
        }
        CloseParen | CloseSquare => {
          if depth > 0 { depth = depth - 1 }
          parts[parts.length() - 1].push(v[i])
        }
        Delim(47) if depth == 0 => parts.push([])
        _ => parts[parts.length() - 1].push(v[i])
      }
      i = i + 1
    }
    let tp : Array[Array[Tok]] = []
    i = 0
    while i < parts.length() { tp.push(trim(parts[i])); i = i + 1 }
    let auto_tok : Array[Tok] = [Ident("auto")]
    let is_named = fn(p : Array[Tok]) -> Bool {
      p.length() == 1 && match p[0] {
        Ident(w) => { let lw = ascii_lower(w); lw != "auto" && lw != "span" }
        _ => false
      }
    }
    let or_same = fn(k : Int, base : Array[Tok]) -> Array[Tok] {
      if k < tp.length() { tp[k] } else if is_named(base) { base } else { auto_tok }
    }
    if name == "grid-area" {
      let rs = tp[0]
      let cs = or_same(1, rs)
      out.set("grid-row-start", rs)
      out.set("grid-column-start", cs)
      out.set("grid-row-end", or_same(2, rs))
      out.set("grid-column-end", or_same(3, cs))
    } else {
      let axis = str_slice(name, 5, name.length())
      out.set("grid-" + axis + "-start", tp[0])
      out.set("grid-" + axis + "-end", or_same(1, tp[0]))
    }
    return
  }
  out.set(name, v)
}

pub fn alias_of(name : String) -> String {
  if name == "grid-row-gap" { return "row-gap" }
  if name == "grid-column-gap" { return "column-gap" }
  if str_has_prefix(name, "-webkit-") {
    let r = str_slice(name, 8, name.length())
    if r == "align-content" || r == "align-items" || r == "align-self" || r == "flex" ||
    r == "flex-basis" || r == "flex-direction" || r == "flex-flow" || r == "flex-grow" ||
    r == "flex-shrink" || r == "flex-wrap" || r == "justify-content" || r == "order" ||
    r == "box-sizing" || r == "transform" || r == "transform-origin" || r == "transition" ||
    r == "transition-property" || r == "transition-duration" || r == "transition-delay" ||
    r == "transition-timing-function" || r == "animation" || r == "animation-name" ||
    r == "animation-duration" || r == "animation-delay" || r == "animation-timing-function" ||
    r == "animation-iteration-count" || r == "animation-direction" || r == "animation-fill-mode" ||
    r == "border-radius" || r == "box-shadow" || r == "opacity" || r == "filter" ||
    r == "perspective" || r == "backface-visibility" {
      return r
    }
  }
  name
}

// ----- Quirks & value validation -----

fn is_unitless_prop(name : String) -> Bool {
  name == "background-position" || name == "border-spacing" || name == "border-bottom-width" ||
  name == "border-left-width" || name == "border-right-width" || name == "border-top-width" ||
  name == "border-width" || name == "bottom" || name == "clip" || name == "font-size" ||
  name == "height" || name == "left" || name == "letter-spacing" || name == "margin" ||
  name == "margin-bottom" || name == "margin-left" || name == "margin-right" || name == "margin-top" ||
  name == "max-height" || name == "max-width" || name == "min-height" || name == "min-width" ||
  name == "padding" || name == "padding-bottom" || name == "padding-left" || name == "padding-right" ||
  name == "padding-top" || name == "right" || name == "text-indent" || name == "top" ||
  name == "vertical-align" || name == "width" || name == "word-spacing"
}

fn is_hashless_prop(name : String) -> Bool {
  name == "background-color" || name == "border-color" || name == "border-top-color" ||
  name == "border-right-color" || name == "border-bottom-color" || name == "border-left-color" ||
  name == "color"
}

fn length_units() -> Array[String] {
  [
    "px", "em", "rem", "ex", "rex", "ch", "rch", "ic", "ric", "cap", "rcap", "lh", "rlh",
    "vw", "vh", "vi", "vb", "vmin", "vmax", "svw", "svh", "svi", "svb", "svmin", "svmax",
    "lvw", "lvh", "lvi", "lvb", "lvmin", "lvmax", "dvw", "dvh", "dvi", "dvb", "dvmin", "dvmax",
    "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax", "cm", "mm", "q", "in", "pt", "pc",
  ]
}

fn length_keywords_for(name : String) -> Array[String] {
  if name == "width" || name == "height" || name == "min-width" || name == "min-height" {
    ["auto", "min-content", "max-content", "fit-content", "stretch"]
  } else if name == "max-width" || name == "max-height" {
    ["none", "min-content", "max-content", "fit-content", "stretch"]
  } else if name == "margin" || name == "margin-top" || name == "margin-right" || name == "margin-bottom" ||
  name == "margin-left" || name == "top" || name == "right" || name == "bottom" || name == "left" || name == "clip" {
    ["auto"]
  } else if name == "border-width" || name == "border-top-width" || name == "border-right-width" ||
  name == "border-bottom-width" || name == "border-left-width" {
    ["thin", "medium", "thick"]
  } else if name == "font-size" {
    ["xx-small", "x-small", "small", "medium", "large", "x-large", "xx-large", "xxx-large", "larger", "smaller", "math"]
  } else if name == "letter-spacing" || name == "word-spacing" {
    ["normal"]
  } else if name == "text-indent" {
    ["hanging", "each-line"]
  } else if name == "vertical-align" {
    ["baseline", "sub", "super", "text-top", "text-bottom", "middle", "top", "bottom"]
  } else if name == "background-position" {
    ["left", "right", "top", "bottom", "center"]
  } else {
    []
  }
}

fn length_word_ok(w : Array[Tok], kws : Array[String]) -> Bool {
  let mut depth = 0
  let mut any = false
  let mut i = 0
  while i < w.length() {
    let t = w[i]
    if depth > 0 {
      match t {
        Function(_) => depth = depth + 1
        OpenParen => depth = depth + 1
        CloseParen => depth = depth - 1
        _ => ()
      }
      i = i + 1
      continue
    }
    any = true
    let ok = match t {
      Function(_) => { depth = depth + 1; true }
      Dimension(_, u) => str_arr_contains(length_units(), ascii_lower(u))
      Percentage(_) => true
      Comma => true
      End => true
      Number(n) => n == 0.0
      Ident(k) => {
        let lk = ascii_lower(k)
        str_arr_contains(kws, lk) || str_has_prefix(lk, "-webkit-") || str_has_prefix(lk, "-moz-")
      }
      _ => false
    }
    if !ok { return false }
    i = i + 1
  }
  any
}

fn all_hex_str(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if !is_hex(s.code_unit_at(i)) { return false }
    i = i + 1
  }
  true
}

fn maybe_color(w : Array[Tok]) -> Bool {
  if w.length() == 1 {
    match w[0] {
      Ident(s) => {
        return (!str_has_prefix(s, "-") && !all_hex_str(s)) || str_has_prefix(s, "-webkit-") || str_has_prefix(s, "-moz-")
      }
      _ => ()
    }
  }
  if w.length() > 0 {
    match w[0] {
      Function(f) => {
        let lf = ascii_lower(f)
        return !(lf == "calc" || lf == "min" || lf == "max" || lf == "clamp")
      }
      _ => ()
    }
  }
  false
}

fn hashless(w : Array[Tok]) -> Option[Array[Tok]] {
  if w.length() != 1 { return None }
  let padded = fn(s : String) -> Option[Array[Tok]] {
    if s.length() > 6 || !all_hex_str(s) { return None }
    Some([Hash(str_slice("000000", 0, 6 - s.length()) + s, false)])
  }
  match w[0] {
    Ident(s) => if (s.length() == 3 || s.length() == 6) && all_hex_str(s) { Some([Hash(s, false)]) } else { None }
    Number(n) => if n >= 0.0 && n == fvdmath::floor(n) && n < 1000000.0 { padded(fvdmath::d2i64(n).to_string()) } else { None }
    Dimension(n, u) => if n >= 0.0 && n == fvdmath::floor(n) && n < 1000000.0 { padded(fvdmath::d2i64(n).to_string() + u) } else { None }
    _ => None
  }
}

fn quirky_value(name : String, v : Array[Tok]) -> Option[Array[Tok]] {
  let ws = tok_filter_no_space_end(v)
  if ws.length() == 1 {
    match ws[0] {
      Ident(w) => if is_global_keyword(ascii_lower(w)) { return Some(v) }
      _ => ()
    }
  }
  if is_unitless_prop(name) {
    let out : Array[Tok] = []
    let mut depth = 0
    let mut i = 0
    while i < v.length() {
      let t = v[i]
      match t {
        Function(_) => depth = depth + 1
        OpenParen => depth = depth + 1
        CloseParen => depth = depth - 1
        _ => ()
      }
      match t {
        Number(n) => {
          if depth == 0 && n != 0.0 {
            if css_globals.quirks_mode {
              out.push(Dimension(n, "px"))
            } else {
              return None
            }
          } else {
            out.push(t)
          }
        }
        _ => out.push(t)
      }
      i = i + 1
    }
    let kws = length_keywords_for(name)
    let comps = words(out)
    i = 0
    while i < comps.length() {
      if !length_word_ok(comps[i], kws) { return None }
      i = i + 1
    }
    return Some(out)
  }
  if is_hashless_prop(name) {
    let out : Array[Tok] = []
    let comps = words(v)
    let mut i = 0
    while i < comps.length() {
      let w = tok_filter_no_end(comps[i])
      let c = if css_globals.quirks_mode {
        match hashless(w) { Some(h) => h None => w }
      } else {
        w
      }
      if !is_color(c) && !maybe_color(c) { return None }
      if i > 0 { out.push(Space) }
      tok_append(out, c)
      i = i + 1
    }
    return if out.length() == 0 { None } else { Some(out) }
  }
  Some(v)
}

// ----- Lengths & Calc -----

fn unit_px(n : Double, unit : String, fs : Double, root : Double, env : Env) -> Option[Double] {
  let u = ascii_lower(unit)
  if u == "px" { Some(n) }
  else if u == "em" { Some(n * fs) }
  else if u == "rem" { Some(n * root) }
  else if u == "ch" { Some(n * (css_globals.ch_hook)(family_now(), fs)) }
  else if u == "ex" { Some(n * fs * 0.5) }
  else if u == "pt" { Some(n * 96.0 / 72.0) }
  else if u == "pc" { Some(n * 16.0) }
  else if u == "in" { Some(n * 96.0) }
  else if u == "cm" { Some(n * 96.0 / 2.54) }
  else if u == "mm" { Some(n * 96.0 / 25.4) }
  else if u == "q" { Some(n * 96.0 / 101.6) }
  else if u == "vw" || u == "svw" || u == "lvw" || u == "dvw" || u == "vi" || u == "svi" || u == "lvi" || u == "dvi" { Some(n * env.width / 100.0) }
  else if u == "vh" || u == "svh" || u == "lvh" || u == "dvh" || u == "vb" || u == "svb" || u == "lvb" || u == "dvb" { Some(n * env.height / 100.0) }
  else if u == "vmin" || u == "svmin" || u == "lvmin" || u == "dvmin" { Some(n * (if env.width < env.height { env.width } else { env.height }) / 100.0) }
  else if u == "vmax" || u == "svmax" || u == "lvmax" || u == "dvmax" { Some(n * (if env.width > env.height { env.width } else { env.height }) / 100.0) }
  else if u == "cqw" || u == "cqi" {
    let w = match css_globals.cur_cq {
      Some((cw, _)) if cw > 0.0 => cw
      _ => env.width
    }
    Some(n * w / 100.0)
  }
  else if u == "cqh" || u == "cqb" {
    let h = match css_globals.cur_cq {
      Some((_, ch)) if ch > 0.0 => ch
      _ => env.height
    }
    Some(n * h / 100.0)
  }
  else if u == "cqmin" {
    let (w, h) = match css_globals.cur_cq {
      Some((cw, ch)) if cw > 0.0 && ch > 0.0 => (cw, ch)
      _ => (env.width, env.height)
    }
    Some(n * (if w < h { w } else { h }) / 100.0)
  }
  else if u == "cqmax" {
    let (w, h) = match css_globals.cur_cq {
      Some((cw, ch)) if cw > 0.0 && ch > 0.0 => (cw, ch)
      _ => (env.width, env.height)
    }
    Some(n * (if w > h { w } else { h }) / 100.0)
  }
  else { None }
}

struct Calc {
  t : Array[Tok]
  mut i : Int
  fs : Double
  root : Double
  env : Env
}

enum CalcVal {
  CalcLen(Double, Double)
  CalcNum(Double)
  // CSS Values 4 §10.2: intermediate length power (px^pow where pow != 0 && pow != 1).
  CalcPow(Double, Int)
}

fn calc_flat_px(v : Double, pct : Double) -> Option[Double] {
  if pct == 0.0 {
    Some(v)
  } else {
    match css_globals.calc_base {
      Some(b) => Some(v + pct * b / 100.0)
      None => None
    }
  }
}

fn calc_with_pow(v : Double, pow : Int) -> CalcVal {
  if pow == 0 {
    CalcNum(v)
  } else if pow == 1 {
    CalcLen(v, 0.0)
  } else {
    CalcPow(v, pow)
  }
}

fn Calc::skip(self : Calc) -> Unit {
  while self.i < self.t.length() && tok_eq(self.t[self.i], Space) {
    self.i = self.i + 1
  }
}

fn Calc::atom(self : Calc) -> Option[CalcVal] {
  self.skip()
  if self.i >= self.t.length() { return None }
  let x = self.t[self.i]
  self.i = self.i + 1
  match x {
    Number(n) => Some(CalcNum(n))
    Percentage(p) => Some(CalcLen(0.0, p))
    Dimension(n, u) => match unit_px(n, u, self.fs, self.root, self.env) {
      Some(p) => Some(CalcLen(p, 0.0))
      None => None
    }
    OpenParen => {
      let v = self.sum()
      self.skip()
      self.i = self.i + 1
      v
    }
    Ident(w) => {
      let lw = ascii_lower(w)
      if lw == "pi" { Some(CalcNum(3.14159265358979)) }
      else if lw == "e" { Some(CalcNum(2.71828182845905)) }
      else if lw == "infinity" { Some(CalcNum(pos_inf())) }
      else if lw == "-infinity" { Some(CalcNum(neg_inf())) }
      else if lw == "nan" { Some(CalcNum(nan_value())) }
      else { None }
    }
    Function(f) => {
      let lf = ascii_lower(f)
      if lf == "calc" {
        let v = self.sum()
        self.skip()
        self.i = self.i + 1
        v
      } else if lf == "min" || lf == "max" || lf == "clamp" {
        let e = group_end(self.t, self.i)
        let args = split_commas(tok_slice(self.t, self.i, e))
        self.i = e + 1
        let vs : Array[Double] = []
        let mut ai = 0
        while ai < args.length() {
          let c = Calc::{ t: args[ai], i: 0, fs: self.fs, root: self.root, env: self.env }
          match c.sum() {
            Some(CalcLen(p, pct)) => {
              if pct == 0.0 {
                vs.push(p)
              } else {
                match css_globals.calc_base {
                  Some(base) => vs.push(p + pct * base / 100.0)
                  None => return None
                }
              }
            }
            Some(CalcNum(n)) => vs.push(n)
            Some(CalcPow(_, _)) => return None
            None => return None
          }
          ai = ai + 1
        }
        if vs.length() == 0 { return None }
        let mut r = vs[0]
        if lf == "min" {
          let mut j = 1
          while j < vs.length() { if vs[j] < r { r = vs[j] }; j = j + 1 }
        } else if lf == "max" {
          let mut j = 1
          while j < vs.length() { if vs[j] > r { r = vs[j] }; j = j + 1 }
        } else if vs.length() == 3 {
          r = if vs[1] < vs[0] { vs[0] } else if vs[1] > vs[2] { vs[2] } else { vs[1] }
        }
        Some(CalcLen(r, 0.0))
      } else {
        let e = group_end(self.t, self.i)
        let inner = tok_slice(self.t, self.i, e)
        self.i = e + 1
        match math_in_calc(lf, inner, self.fs, self.root, self.env) {
          Some(mr) => if mr.is_num { Some(CalcNum(mr.v)) } else { Some(CalcLen(mr.v, mr.pct)) }
          None => None
        }
      }
    }
    _ => None
  }
}

fn calc_scale(v : Double, n : Double) -> Double {
  if n != n || v != v {
    nan_value()
  } else if v == 0.0 {
    0.0
  } else {
    v * n
  }
}

fn clamp_calc_px(x : Double) -> Double {
  if x != x {
    0.0
  } else if x > 33554400.0 {
    33554400.0
  } else if x < -33554400.0 {
    -33554400.0
  } else {
    x
  }
}

fn Calc::product(self : Calc) -> Option[CalcVal] {
  let mut v = self.atom()
  while true {
    self.skip()
    if self.i >= self.t.length() { break }
    match self.t[self.i] {
      Delim(c) => {
        if c == 42 {
          self.i = self.i + 1
          let rhs = self.atom()
          v = match (v, rhs) {
            (Some(CalcLen(a, b)), Some(CalcNum(n))) => Some(CalcLen(calc_scale(a, n), calc_scale(b, n)))
            (Some(CalcNum(a)), Some(CalcLen(x, y))) => Some(CalcLen(calc_scale(x, a), calc_scale(y, a)))
            (Some(CalcNum(a)), Some(CalcNum(b))) => Some(CalcNum(a * b))
            (Some(CalcPow(x, p)), Some(CalcNum(n))) => Some(CalcPow(calc_scale(x, n), p))
            (Some(CalcNum(n)), Some(CalcPow(x, p))) => Some(CalcPow(calc_scale(x, n), p))
            (Some(CalcLen(a, b)), Some(CalcLen(x, y))) => match (calc_flat_px(a, b), calc_flat_px(x, y)) {
              (Some(p), Some(q)) => Some(CalcPow(p * q, 2))
              _ => None
            }
            (Some(CalcPow(x, p)), Some(CalcLen(a, b))) => match calc_flat_px(a, b) {
              Some(q) => Some(calc_with_pow(x * q, p + 1))
              None => None
            }
            (Some(CalcLen(a, b)), Some(CalcPow(x, p))) => match calc_flat_px(a, b) {
              Some(q) => Some(calc_with_pow(q * x, p + 1))
              None => None
            }
            (Some(CalcPow(x, p1)), Some(CalcPow(y, p2))) => Some(calc_with_pow(x * y, p1 + p2))
            _ => None
          }
        } else if c == 47 {
          self.i = self.i + 1
          let rhs = self.atom()
          v = match (v, rhs) {
            (Some(CalcLen(a, b)), Some(CalcNum(n))) => Some(CalcLen(a / n, b / n))
            (Some(CalcNum(a)), Some(CalcNum(b))) => Some(CalcNum(a / b))
            (Some(CalcPow(x, p)), Some(CalcNum(n))) => Some(CalcPow(x / n, p))
            (Some(CalcLen(a, b)), Some(CalcLen(x, y))) => match (calc_flat_px(a, b), calc_flat_px(x, y)) {
              (Some(p), Some(q)) => Some(CalcNum(p / q))
              _ => None
            }
            (Some(CalcPow(x, p)), Some(CalcLen(a, b))) => match calc_flat_px(a, b) {
              Some(q) => Some(calc_with_pow(x / q, p - 1))
              None => None
            }
            (Some(CalcLen(a, b)), Some(CalcPow(y, p))) => match calc_flat_px(a, b) {
              Some(q) => Some(calc_with_pow(q / y, 1 - p))
              None => None
            }
            (Some(CalcNum(a)), Some(CalcLen(x, y))) => match calc_flat_px(x, y) {
              Some(q) => Some(CalcPow(a / q, -1))
              None => None
            }
            (Some(CalcNum(a)), Some(CalcPow(y, p))) => Some(calc_with_pow(a / y, -p))
            (Some(CalcPow(x, p1)), Some(CalcPow(y, p2))) => Some(calc_with_pow(x / y, p1 - p2))
            _ => None
          }
        } else {
          break
        }
      }
      _ => break
    }
  }
  v
}

fn Calc::sum(self : Calc) -> Option[CalcVal] {
  let mut v = self.product()
  while true {
    self.skip()
    if self.i >= self.t.length() { break }
    let sign = match self.t[self.i] {
      Delim(c) => if c == 43 { 1.0 } else if c == 45 { -1.0 } else { break }
      _ => break
    }
    self.i = self.i + 1
    let rhs = self.product()
    v = match v {
      Some(CalcLen(a, b)) => match rhs { Some(CalcLen(c, d)) => Some(CalcLen(a + sign * c, b + sign * d)) _ => None }
      Some(CalcNum(a)) => match rhs { Some(CalcNum(c)) => Some(CalcNum(a + sign * c)) _ => None }
      Some(CalcPow(a, p1)) => match rhs { Some(CalcPow(c, p2)) if p1 == p2 => Some(CalcPow(a + sign * c, p1)) _ => None }
      None => None
    }
  }
  v
}

fn eval_length(t : Array[Tok], fs : Double, root : Double, env : Env) -> Option[Length] {
  if t.length() == 1 {
    match t[0] {
      Dimension(v, u) =>
      if u == "px" { return Some(Length::{ px: v, pct: 0.0 }) }
      else if u == "rem" { return Some(Length::{ px: v * root, pct: 0.0 }) }
      else if u == "em" { return Some(Length::{ px: v * fs, pct: 0.0 }) }
      Percentage(p) => return Some(Length::{ px: 0.0, pct: p })
      Number(n) => return if n == 0.0 { Some(Length::{ px: 0.0, pct: 0.0 }) } else { None }
      Ident(_) => return None
      _ => ()
    }
  }
  let c = Calc::{ t: t, i: 0, fs: fs, root: root, env: env }
  match c.atom() {
    Some(CalcLen(p, q)) => Some(Length::{ px: clamp_calc_px(p), pct: clamp_calc_px(q) })
    Some(CalcNum(n)) => if n == 0.0 { Some(Length::{ px: 0.0, pct: 0.0 }) } else { None }
    Some(CalcPow(_, _)) => None
    None => None
  }
}

// ----- Colors -----

fn clamp8(v : Double) -> Int {
  let r = fvdmath::d2i(fvdmath::floor(v + 0.5))
  if r < 0 { 0 } else if r > 255 { 255 } else { r }
}

pub fn parse_color(v : Array[Tok], _current : Int) -> Option[Color] {
  parse_color_with_current(v, None)
}

// ----- Presentational hints -----

fn dim_hint(v : String) -> String {
  let t = trim_str(v)
  if t == "" { return "" }
  if str_has_suffix(t, "%") { return t }
  let b = StringBuilder::new()
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if is_digit(c) || c == 46 { b.write_char((c).unsafe_to_char()) } else { break }
    i = i + 1
  }
  let s = b.to_string()
  if s == "" { "" } else { s + "px" }
}

fn ancestor_table(n : html::Node) -> Option[html::Node] {
  let mut p = n.parent
  while true {
    match p {
      Some(x) => {
        if x.tag == "table" { return Some(x) }
        p = x.parent
      }
      None => break
    }
  }
  None
}

fn svg_presentation_attrs() -> Array[String] {
  [
    "alignment-baseline", "baseline-shift", "clip-path", "clip-rule", "color", "color-interpolation",
    "color-interpolation-filters", "cursor", "direction", "display", "dominant-baseline", "fill", "fill-opacity",
    "fill-rule", "filter", "flood-color", "flood-opacity", "font-family", "font-size", "font-size-adjust",
    "font-stretch", "font-style", "font-variant", "font-weight", "image-rendering", "letter-spacing", "lighting-color",
    "marker-end", "marker-mid", "marker-start", "mask", "mask-type", "opacity", "overflow", "paint-order",
    "pointer-events", "shape-rendering", "stop-color", "stop-opacity", "stroke", "stroke-dasharray",
    "stroke-dashoffset", "stroke-linecap", "stroke-linejoin", "stroke-miterlimit", "stroke-opacity", "stroke-width",
    "text-anchor", "text-decoration", "text-overflow", "text-rendering", "transform-origin", "unicode-bidi",
    "vector-effect", "visibility", "white-space", "word-spacing", "writing-mode",
  ]
}

fn is_ascii_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

let hints_sb : StringBuilder = StringBuilder::new()

fn hints_prop(b : StringBuilder, name : String, v : String) -> Unit {
  if v != "" {
    b.write_string(name)
    b.write_string(":")
    b.write_string(v)
    b.write_string(";")
  }
}

fn hints_dim_attr(b : StringBuilder, n : html::Node, attr : String, name : String) -> Unit {
  match n.attr(attr) { Some(v) => hints_prop(b, name, dim_hint(v)) None => () }
}

fn hints_color_attr(b : StringBuilder, n : html::Node, attr : String, name : String) -> Unit {
  match n.attr(attr) {
    Some(v) => {
      let t = trim_str(v)
      hints_prop(b, name, if t.length() == 6 && all_hex_str(t) { "#" + t } else { t })
    }
    None => ()
  }
}

fn hints(n : html::Node) -> String {
  let alen = n.attrs.length()
  let tag = n.tag
  if alen == 0 && !(tag == "td" || tag == "th") {
    return ""
  }
  if n.ns == html::Ns::Html && alen > 0 {
    if tag == "div" || tag == "p" || tag == "h1" || tag == "h2" || tag == "h3" || tag == "h4" || tag == "h5" || tag == "h6" {
      let mut found = false
      let mut i = 0
      while i < alen {
        let a = n.attrs[i]
        if a.prefix == "" && (a.name == "lang" || a.name == "align") {
          found = true
          break
        }
        i = i + 1
      }
      if !found { return "" }
    } else if !(tag == "table" || tag == "td" || tag == "th" || tag == "tr" || tag == "tbody" || tag == "thead" || tag == "tfoot" ||
      tag == "img" || tag == "iframe" || tag == "object" || tag == "embed" || tag == "video" || tag == "hr" ||
      tag == "body" || tag == "font") {
      let mut found = false
      let mut i = 0
      while i < alen {
        let a = n.attrs[i]
        if a.prefix == "" && a.name == "lang" {
          found = true
          break
        }
        i = i + 1
      }
      if !found { return "" }
    }
  }
  let b = hints_sb
  b.reset()
  match n.attr("lang") {
    Some(l) => {
      if l.length() > 0 && is_ascii_alpha(l.code_unit_at(0)) {
        let mut ok = true
        let mut i = 0
        while i < l.length() {
          let c = l.code_unit_at(i)
          if !(is_ascii_alpha(c) || is_digit(c) || c == 45) { ok = false; break }
          i = i + 1
        }
        if ok { hints_prop(b, "-fv-lang", ascii_lower(l)) }
      }
    }
    None => ()
  }
  if n.ns == html::Ns::Svg && tag != "animate" && tag != "animateMotion" && tag != "animateTransform" && tag != "set" && tag != "discard" {
    let attrs = svg_presentation_attrs()
    let mut ai = 0
    while ai < attrs.length() {
      let attr = attrs[ai]
      match n.attr(attr) {
        Some(v) => {
          let t = trim_str(v)
          if t != "" && !str_contains(t, ";") && !str_contains(t, "{") && !str_contains(t, "}") && !str_contains(t, "!") {
            let mut unitless = true
            let mut j = 0
            while j < t.length() {
              let c = t.code_unit_at(j)
              if !(is_digit(c) || c == 46 || c == 45) { unitless = false; break }
              j = j + 1
            }
            let is_svg_len = attr == "font-size" || attr == "letter-spacing" || attr == "word-spacing" || attr == "baseline-shift"
            hints_prop(b, attr, if unitless && is_svg_len { t + "px" } else { t })
          }
        }
        None => ()
      }
      ai = ai + 1
    }
  }
  if tag == "svg" && n.ns == html::Ns::Svg {
    let parent_svg = match n.parent { Some(p) => p.ns == html::Ns::Svg None => false }
    if !parent_svg {
      let wh = ["width", "height"]
      let mut i = 0
      while i < 2 {
        match n.attr(wh[i]) {
          Some(v) => {
            let t = trim_str(v)
            if t != "" && t != "auto" {
              let mut pure_num = true
              let mut j = 0
              while j < t.length() {
                let c = t.code_unit_at(j)
                if !(is_digit(c) || c == 46) { pure_num = false; break }
                j = j + 1
              }
              hints_prop(b, wh[i], if pure_num { t + "px" } else { t })
            }
          }
          None => ()
        }
        i = i + 1
      }
    }
  } else if tag == "table" {
    hints_dim_attr(b, n, "width", "width")
    hints_dim_attr(b, n, "height", "height")
    hints_color_attr(b, n, "bgcolor", "background-color")
    match n.attr("cellspacing") { Some(v) => hints_prop(b, "border-spacing", dim_hint(v)) None => () }
    match n.attr("border") { Some(v) => if v != "0" { hints_prop(b, "border", dim_hint(v) + " outset") } None => () }
    match n.attr("align") {
      Some(a) => {
        if a == "center" { b.write_string("margin-left:auto;margin-right:auto;") }
        else if a == "left" { hints_prop(b, "float", "left") }
        else if a == "right" { hints_prop(b, "float", "right") }
      }
      None => ()
    }
  } else if tag == "td" || tag == "th" || tag == "tr" || tag == "tbody" || tag == "thead" || tag == "tfoot" {
    hints_dim_attr(b, n, "width", "width")
    hints_dim_attr(b, n, "height", "height")
    hints_color_attr(b, n, "bgcolor", "background-color")
    match n.attr("align") {
      Some(v) => {
        let lv = ascii_lower(v)
        if lv == "center" || lv == "middle" { hints_prop(b, "text-align", "-webkit-center") } else { hints_prop(b, "text-align", lv) }
      }
      None => ()
    }
    match n.attr("valign") { Some(v) => hints_prop(b, "vertical-align", ascii_lower(v)) None => () }
    if n.attr("nowrap").is_some() { hints_prop(b, "white-space", "nowrap") }
    if tag == "td" || tag == "th" {
      match ancestor_table(n) {
        Some(t) => match t.attr("cellpadding") { Some(v) => hints_prop(b, "padding", dim_hint(v)) None => () }
        None => ()
      }
    }
  } else if tag == "img" || tag == "iframe" || tag == "object" || tag == "embed" || tag == "video" || tag == "hr" {
    hints_dim_attr(b, n, "width", "width")
    hints_dim_attr(b, n, "height", "height")
    match n.attr("align") {
      Some(v) => {
        if v == "left" { hints_prop(b, "float", "left") }
        else if v == "right" { hints_prop(b, "float", "right") }
        else if tag != "hr" { hints_prop(b, "vertical-align", ascii_lower(v)) }
      }
      None => ()
    }
    match n.attr("hspace") {
      Some(v) => {
        let d = dim_hint(v)
        hints_prop(b, "margin-left", d)
        hints_prop(b, "margin-right", d)
      }
      None => ()
    }
    match n.attr("vspace") {
      Some(v) => {
        let d = dim_hint(v)
        hints_prop(b, "margin-top", d)
        hints_prop(b, "margin-bottom", d)
      }
      None => ()
    }
    if tag == "img" {
      match n.attr("border") { Some(v) => hints_prop(b, "border", dim_hint(v) + " solid") None => () }
    }
  } else if tag == "body" {
    hints_color_attr(b, n, "bgcolor", "background-color")
    hints_color_attr(b, n, "text", "color")
  } else if tag == "font" {
    hints_color_attr(b, n, "color", "color")
    match n.attr("face") { Some(v) => hints_prop(b, "font-family", v) None => () }
    match n.attr("size") {
      Some(v) => {
        let fs = if v == "1" { "x-small" } else if v == "2" { "small" } else if v == "3" { "medium" }
        else if v == "4" { "large" } else if v == "5" { "x-large" } else if v == "6" { "xx-large" }
        else if v == "7" { "48px" } else { "" }
        hints_prop(b, "font-size", fs)
      }
      None => ()
    }
  } else if tag == "div" || tag == "p" || tag == "h1" || tag == "h2" || tag == "h3" || tag == "h4" || tag == "h5" || tag == "h6" {
    match n.attr("align") {
      Some(v) => {
        let lv = ascii_lower(v)
        if (lv == "center" || lv == "middle") && tag == "div" { hints_prop(b, "text-align", "-webkit-center") }
        else if lv == "middle" { hints_prop(b, "text-align", "center") }
        else { hints_prop(b, "text-align", lv) }
      }
      None => ()
    }
  }
  let res = b.to_string()
  b.reset()
  res
}
