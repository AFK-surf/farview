///| Selectors Level 4: parsing and matching.
///| 1:1 port of `client/src/css/selector.mbt`.

pub enum Simple {
  Universal
  TypeSel(String)
  IdSel(String)
  ClassSel(String, Int64)
  AttrSel(String, String, String, Bool)
  PseudoSel(String, Array[Selector])
  NthSel(String, Int, Int, Array[Selector])
  PseudoElSel(String)
  PartSel(Array[String])
  NeverSel
}

pub enum Combinator {
  Descendant
  Child
  Next
  Later
}

fn comb_eq(a : Combinator, b : Combinator) -> Bool {
  match a {
    Descendant => match b { Descendant => true _ => false }
    Child => match b { Child => true _ => false }
    Next => match b { Next => true _ => false }
    Later => match b { Later => true _ => false }
  }
}

pub struct SelPart {
  pub compound : Array[Simple]
  pub comb : Combinator
}

pub struct Selector {
  pub parts : Array[SelPart]
  pub specificity : Int
  pub pseudo_element : String
  pub relative : Combinator
}

fn is_known_pseudo_element(pe : String) -> Bool {
  pe == "before" || pe == "after" || pe == "first-line" || pe == "first-letter" ||
  pe == "marker" || pe == "placeholder" || pe == "selection" || pe == "backdrop" ||
  pe == "file-selector-button" || pe == "grammar-error" || pe == "spelling-error" ||
  pe == "target-text" || pe == "cue" || pe == "cue-region" || pe == "details-content" ||
  pe == "view-transition" || pe == "search-text" || pe == "column" ||
  pe == "scroll-marker" || pe == "scroll-marker-group" || pe == "scroll-button" ||
  pe == "picker-icon" || pe == "checkmark" || pe == "picker" ||
  pe == "-webkit-slider-runnable-track" || pe == "-webkit-slider-thumb" ||
  pe == "-moz-range-track" || pe == "-moz-range-thumb"
}

fn is_known_pseudo_class(pc : String) -> Bool {
  pc == "active" || pc == "any-link" || pc == "autofill" || pc == "blank" ||
  pc == "checked" || pc == "closed" || pc == "current" || pc == "default" ||
  pc == "defined" || pc == "disabled" || pc == "empty" || pc == "enabled" ||
  pc == "first" || pc == "first-child" || pc == "first-of-type" || pc == "focus" ||
  pc == "focus-visible" || pc == "focus-within" || pc == "fullscreen" || pc == "future" ||
  pc == "hover" || pc == "in-range" || pc == "indeterminate" || pc == "invalid" ||
  pc == "last-child" || pc == "last-of-type" || pc == "left" || pc == "link" ||
  pc == "local-link" || pc == "modal" || pc == "only-child" || pc == "only-of-type" ||
  pc == "open" || pc == "optional" || pc == "out-of-range" || pc == "past" ||
  pc == "paused" || pc == "picture-in-picture" || pc == "placeholder-shown" ||
  pc == "playing" || pc == "popover-open" || pc == "read-only" || pc == "read-write" ||
  pc == "required" || pc == "right" || pc == "root" || pc == "scope" || pc == "target" ||
  pc == "target-within" || pc == "user-invalid" || pc == "user-valid" || pc == "valid" ||
  pc == "visited" || pc == "host" || pc == "muted" || pc == "seeking" || pc == "stalled" ||
  pc == "buffering" || pc == "volume-locked" || pc == "xr-overlay" || pc == "state" ||
  pc == "active-view-transition" || pc == "horizontal" || pc == "vertical" ||
  pc == "decrement" || pc == "increment" || pc == "start" || pc == "end" ||
  pc == "double-button" || pc == "single-button" || pc == "no-button" ||
  pc == "corner-present" || pc == "window-inactive" || pc == "target-current" ||
  pc == "has-slotted"
}

// Global selector context (mirrors MoonBit Refs / Maps)
struct SelState {
  mut scope_node : Option[html::Node]
  mut target_id : String
  mut forgiven : Bool
  // CSS Scoping 1 §3.1.1: uid of the shadow host currently being matched against its own shadow tree (-1 outside shadow context).
  mut host_target : Int
}

let sel_state : SelState = SelState::{
  scope_node: None,
  target_id: "",
  forgiven: false,
  host_target: -1,
}

pub let defined_custom : intmap::IntMap[Bool] = intmap::IntMap::new()
pub let element_states : intmap::IntMap[Int] = intmap::IntMap::new()

pub fn set_scope_node(n : Option[html::Node]) -> Unit {
  sel_state.scope_node = n
}

pub fn set_target_id(id : String) -> Unit {
  sel_state.target_id = id
}

fn int_of(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  let mut neg = false
  if i < n && s.code_unit_at(i) == 43 {
    i = i + 1
  } else if i < n && s.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  }
  let mut v = 0
  while i < n && is_digit(s.code_unit_at(i)) {
    v = v * 10 + (s.code_unit_at(i) - 48)
    i = i + 1
  }
  if neg { -v } else { v }
}

fn anb_int(n : Double) -> Option[Int] {
  if n == fvdmath::floor(n) && fvdmath::abs(n) < 1000000000.0 {
    Some(fvdmath::d2i(n))
  } else {
    None
  }
}

fn anb_digits(s : String) -> Option[Int] {
  if s.length() == 0 || s.length() > 9 {
    return None
  }
  let mut i = 0
  while i < s.length() {
    if !is_digit(s.code_unit_at(i)) {
      return None
    }
    i = i + 1
  }
  Some(int_of(s))
}

fn anb_rest(t : Array[Tok], a : Int, i : Int) -> Option[(Int, Int)] {
  let mut k = i
  while k < t.length() && tok_eq(t[k], Space) {
    k = k + 1
  }
  if k >= t.length() {
    return Some((a, 0))
  }
  match t[k] {
    Number(n) => {
      if k + 1 == t.length() {
        match anb_int(n) {
          Some(b) => Some((a, b))
          None => None
        }
      } else {
        None
      }
    }
    Delim(c) => {
      if c == 43 || c == 45 {
        let neg = c == 45
        k = k + 1
        while k < t.length() && tok_eq(t[k], Space) {
          k = k + 1
        }
        if k + 1 == t.length() {
          match t[k] {
            Number(n) => {
              if n >= 0.0 {
                match anb_int(n) {
                  Some(b) => Some((a, if neg { -b } else { b }))
                  None => None
                }
              } else {
                None
              }
            }
            _ => None
          }
        } else {
          None
        }
      } else {
        None
      }
    }
    _ => None
  }
}

fn anb_after_n(t : Array[Tok], a : Int, unit : String, i : Int) -> Option[(Int, Int)] {
  if unit == "n" {
    return anb_rest(t, a, i)
  }
  if unit == "n-" {
    let mut k = i
    while k < t.length() && tok_eq(t[k], Space) {
      k = k + 1
    }
    if k + 1 == t.length() {
      match t[k] {
        Number(n) => {
          if n >= 0.0 {
            match anb_int(n) {
              Some(b) => return Some((a, -b))
              None => return None
            }
          }
        }
        _ => ()
      }
    }
    return None
  }
  if str_has_prefix(unit, "n-") && i == t.length() {
    match anb_digits(str_slice(unit, 2, unit.length())) {
      Some(b) => return Some((a, -b))
      None => return None
    }
  }
  None
}

fn parse_anb(toks : Array[Tok]) -> Option[(Int, Int)] {
  let t = trim(toks)
  if t.length() == 0 {
    return None
  }
  if t.length() == 1 {
    match t[0] {
      Ident(w) => {
        let lw = ascii_lower(w)
        if lw == "odd" {
          return Some((2, 1))
        }
        if lw == "even" {
          return Some((2, 0))
        }
      }
      Number(n) => {
        return match anb_int(n) {
          Some(b) => Some((0, b))
          None => None
        }
      }
      _ => ()
    }
  }
  match t[0] {
    Dimension(n, u) => {
      match anb_int(n) {
        Some(a) => anb_after_n(t, a, ascii_lower(u), 1)
        None => None
      }
    }
    Ident(w) => {
      let lw = ascii_lower(w)
      if str_has_prefix(lw, "-") {
        anb_after_n(t, -1, str_slice(lw, 1, lw.length()), 1)
      } else {
        anb_after_n(t, 1, lw, 1)
      }
    }
    Delim(c) => {
      if c == 43 && t.length() >= 2 {
        match t[1] {
          Ident(w) => {
            let lw = ascii_lower(w)
            if str_has_prefix(lw, "-") {
              None
            } else {
              anb_after_n(t, 1, lw, 2)
            }
          }
          _ => None
        }
      } else {
        None
      }
    }
    _ => None
  }
}

fn split_commas(t : Array[Tok]) -> Array[Array[Tok]] {
  let out : Array[Array[Tok]] = []
  let cur : Array[Tok] = []
  let mut depth = 0
  let mut i = 0
  while i < t.length() {
    let x = t[i]
    match x {
      OpenParen => depth = depth + 1
      OpenSquare => depth = depth + 1
      Function(_) => depth = depth + 1
      CloseParen => depth = depth - 1
      CloseSquare => depth = depth - 1
      _ => ()
    }
    if tok_eq(x, Comma) && depth == 0 {
      out.push(tok_copy(cur))
      cur.clear()
    } else {
      cur.push(x)
    }
    i = i + 1
  }
  out.push(cur)
  out
}

pub fn parse_selector_list(t : Array[Tok]) -> Array[Selector] {
  let out : Array[Selector] = []
  let parts = split_commas(t)
  let mut i = 0
  while i < parts.length() {
    match parse_selector(trim(parts[i])) {
      Some(s) => out.push(s)
      None => return []
    }
    i = i + 1
  }
  out
}

fn group_end(t : Array[Tok], start : Int) -> Int {
  let mut depth = 1
  let mut i = start
  while i < t.length() {
    match t[i] {
      OpenParen => depth = depth + 1
      Function(_) => depth = depth + 1
      OpenSquare => depth = depth + 1
      CloseParen => {
        depth = depth - 1
        if depth == 0 {
          return i
        }
      }
      CloseSquare => {
        depth = depth - 1
        if depth == 0 {
          return i
        }
      }
      _ => ()
    }
    i = i + 1
  }
  t.length()
}

fn valid_tail(t : Array[Tok]) -> Bool {
  if t.length() == 0 {
    return false
  }
  match t[t.length() - 1] {
    Delim(c) => !(c == 62 || c == 43 || c == 126)
    _ => true
  }
}

fn copy_simples(arr : Array[Simple]) -> Array[Simple] {
  let out : Array[Simple] = []
  let mut i = 0
  while i < arr.length() {
    out.push(arr[i])
    i = i + 1
  }
  out
}

fn has_no_ns_pseudo(cur : Array[Simple]) -> Bool {
  let mut i = 0
  while i < cur.length() {
    match cur[i] {
      PseudoSel(name, _) => {
        if name == "-fv-no-namespace" {
          return true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn has_non_univ_or_nons(cur : Array[Simple]) -> Bool {
  let mut i = 0
  while i < cur.length() {
    match cur[i] {
      Universal => ()
      PseudoSel(name, _) => {
        if name != "-fv-no-namespace" {
          return true
        }
      }
      _ => return true
    }
    i = i + 1
  }
  false
}

fn parse_selector(t : Array[Tok]) -> Option[Selector] {
  if !valid_tail(t) {
    return None
  }
  let parts : Array[SelPart] = []
  let cur : Array[Simple] = []
  let mut comb = Combinator::Descendant
  let mut i = 0
  let mut a = 0
  let mut b = 0
  let mut c = 0
  let mut pe = ""
  while i < t.length() {
    let x = t[i]
    i = i + 1
    match x {
      Space => {
        while i < t.length() && tok_eq(t[i], Space) {
          i = i + 1
        }
        if i < t.length() {
          let is_comb = match t[i] {
            Delim(d) => d == 62 || d == 43 || d == 126
            _ => false
          }
          if !is_comb {
            if cur.length() == 0 {
              return None
            }
            parts.push(SelPart::{ compound: copy_simples(cur), comb: comb })
            cur.clear()
            comb = Combinator::Descendant
          }
        }
      }
      Delim(d) => {
        if d == 62 || d == 43 || d == 126 {
          if cur.length() == 0 {
            return None
          }
          parts.push(SelPart::{ compound: copy_simples(cur), comb: comb })
          cur.clear()
          comb = if d == 62 { Combinator::Child } else if d == 43 { Combinator::Next } else { Combinator::Later }
          while i < t.length() && tok_eq(t[i], Space) {
            i = i + 1
          }
        } else if d == 42 {
          let no_ns = has_no_ns_pseudo(cur)
          if cur.length() > 0 && !(i >= 2 && tok_eq(t[i - 2], Delim(124))) {
            return None
          }
          cur.clear()
          if no_ns {
            cur.push(PseudoSel("-fv-no-namespace", []))
          }
          cur.push(Universal)
        } else if d == 124 {
          if cur.length() == 0 || (i >= 2 && tok_eq(t[i - 2], Delim(42))) {
            if cur.length() == 0 {
              cur.push(PseudoSel("-fv-no-namespace", []))
            }
          }
        } else if d == 46 {
          if i < t.length() {
            match t[i] {
              Ident(n) => {
                i = i + 1
                cur.push(ClassSel(n, html::class_token_mask(n)))
                b = b + 1
              }
              _ => return None
            }
          } else {
            return None
          }
        } else {
          return None
        }
      }
      Ident(n) => {
        let no_ns = has_no_ns_pseudo(cur)
        if has_non_univ_or_nons(cur) || (cur.length() > 0 && !(i >= 2 && tok_eq(t[i - 2], Delim(124)))) {
          return None
        }
        cur.clear()
        if no_ns {
          cur.push(PseudoSel("-fv-no-namespace", []))
        }
        cur.push(TypeSel(ascii_lower(n)))
        c = c + 1
      }
      Hash(n, _) => {
        cur.push(IdSel(n))
        a = a + 1
      }
      OpenSquare => {
        let e = group_end(t, i)
        let inner = trim(tok_slice(t, i, e))
        i = e + 1
        match parse_attr(inner) {
          Some(s) => {
            cur.push(s)
            b = b + 1
          }
          None => return None
        }
      }
      Colon => {
        if i >= t.length() {
          return None
        }
        if tok_eq(t[i], Colon) {
          i = i + 1
          if i >= t.length() {
            return None
          }
          match t[i] {
            Ident(n) => {
              i = i + 1
              pe = ascii_lower(n)
              if !is_known_pseudo_element(pe) && !str_has_prefix(pe, "-webkit-") && !str_has_prefix(pe, "-moz-") {
                return None
              }
              cur.push(PseudoElSel(pe))
              c = c + 1
            }
            Function(fname) => {
              if ascii_lower(fname) == "slotted" {
                let e = group_end(t, i + 1)
                let inner = trim(tok_slice(t, i + 1, e))
                i = e + 1
                pe = "slotted"
                cur.push(PseudoSel("slotted", parse_forgiving(inner)))
                b = b + 1
                c = c + 1
              } else if ascii_lower(fname) == "part" {
                let e = group_end(t, i + 1)
                let names : Array[String] = []
                let mut pi = i + 1
                while pi < e {
                  match t[pi] {
                    Ident(nm) => names.push(nm)
                    Space => ()
                    _ => return None
                  }
                  pi = pi + 1
                }
                i = e + 1
                if names.length() == 0 {
                  return None
                }
                pe = "part"
                cur.push(PartSel(names))
                c = c + 1
              } else {
                i = group_end(t, i + 1) + 1
                cur.push(NeverSel)
              }
            }
            _ => return None
          }
          continue
        }
        match t[i] {
          Ident(n) => {
            i = i + 1
            let l = ascii_lower(n)
            if l == "before" || l == "after" || l == "first-line" || l == "first-letter" {
              pe = l
              cur.push(PseudoElSel(l))
              c = c + 1
            } else if l == "has" || l == "not" || l == "is" || l == "where" || l == "matches" ||
            l == "nth-child" || l == "nth-last-child" || l == "nth-of-type" ||
            l == "nth-last-of-type" || l == "host-context" || l == "dir" || l == "lang" {
              return None
            } else if !is_known_pseudo_class(l) && !str_has_prefix(l, "-webkit-") && !str_has_prefix(l, "-moz-") {
              return None
            } else {
              cur.push(PseudoSel(l, []))
              b = b + 1
            }
          }
          Function(n) => {
            let l = ascii_lower(n)
            let e = group_end(t, i + 1)
            let inner = trim(tok_slice(t, i + 1, e))
            i = e + 1
            if l == "is" || l == "matches" || l == "where" || l == "not" || l == "has" || l == "-webkit-any" {
              let list = if l == "has" {
                parse_relative(inner)
              } else if l == "not" {
                parse_selector_list(inner)
              } else {
                parse_forgiving(inner)
              }
              if (l == "not" || l == "has") && list.length() == 0 {
                return None
              }
              if l != "where" {
                let mut most = 0
                let mut si = 0
                while si < list.length() {
                  if list[si].specificity > most {
                    most = list[si].specificity
                  }
                  si = si + 1
                }
                a = a + most / 0x10000
                b = b + (most / 0x100) % 0x100
                c = c + most % 0x100
              }
              cur.push(PseudoSel(l, list))
            } else if l == "nth-child" || l == "nth-last-child" || l == "nth-of-type" || l == "nth-last-of-type" {
              b = b + 1
              let mut of_at = -1
              let mut k = 0
              while k < inner.length() {
                match inner[k] {
                  Ident(w) => {
                    if ascii_lower(w) == "of" {
                      of_at = k
                    }
                  }
                  _ => ()
                }
                k = k + 1
              }
              let anb = if of_at >= 0 { tok_slice(inner, 0, of_at) } else { inner }
              let list = if of_at >= 0 {
                parse_selector_list(trim(tok_slice(inner, of_at + 1, inner.length())))
              } else {
                []
              }
              match parse_anb(anb) {
                Some(pq) => cur.push(NthSel(l, pq.0, pq.1, list))
                None => return None
              }
            } else if l == "host" {
              b = b + 1
              let list = parse_forgiving(inner)
              let mut complex = false
              let mut li = 0
              while li < list.length() {
                if list[li].parts.length() > 1 {
                  complex = true
                }
                li = li + 1
              }
              if complex {
                sel_state.forgiven = true
              }
              cur.push(PseudoSel("host", list))
            } else if l == "dir" {
              b = b + 1
              if inner.length() == 1 {
                match inner[0] {
                  Ident(d) => {
                    let ld = ascii_lower(d)
                    if ld == "ltr" || ld == "rtl" {
                      cur.push(PseudoSel("dir-" + ld, []))
                    } else {
                      cur.push(NeverSel)
                    }
                  }
                  _ => return None
                }
              } else {
                return None
              }
            } else if l == "lang" {
              b = b + 1
              let langs : Array[Selector] = []
              let mut li = 0
              while li < inner.length() {
                match inner[li] {
                  Ident(w) => langs.push(Selector::{
                    parts: [SelPart::{ compound: [TypeSel(ascii_lower(w))], comb: Combinator::Descendant }],
                    specificity: 0,
                    pseudo_element: "",
                    relative: Combinator::Descendant,
                  })
                  Str(w) => langs.push(Selector::{
                    parts: [SelPart::{ compound: [TypeSel(ascii_lower(w))], comb: Combinator::Descendant }],
                    specificity: 0,
                    pseudo_element: "",
                    relative: Combinator::Descendant,
                  })
                  _ => ()
                }
                li = li + 1
              }
              if langs.length() == 0 {
                return None
              }
              cur.push(PseudoSel("lang", langs))
            } else if l == "host-context" || l == "state" {
              b = b + 1
              cur.push(NeverSel)
            } else {
              return None
            }
          }
          _ => return None
        }
      }
      _ => return None
    }
  }
  if cur.length() == 0 {
    return None
  }
  parts.push(SelPart::{ compound: copy_simples(cur), comb: comb })
  let rev : Array[SelPart] = []
  let n = parts.length()
  let mut k = n - 1
  while k >= 0 {
    let left = if k > 0 { parts[k].comb } else { Combinator::Descendant }
    rev.push(SelPart::{ compound: parts[k].compound, comb: left })
    k = k - 1
  }
  Some(Selector::{
    parts: rev,
    specificity: a * 0x10000 + b * 0x100 + c,
    pseudo_element: pe,
    relative: Combinator::Descendant,
  })
}

fn sel_has_pseudo_element(s : Selector) -> Bool {
  let mut i = 0
  while i < s.parts.length() {
    let comp = s.parts[i].compound
    let mut j = 0
    while j < comp.length() {
      match comp[j] {
        PseudoElSel(_) => return true
        PartSel(_) => return true
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
  false
}

fn parse_forgiving(t : Array[Tok]) -> Array[Selector] {
  let out : Array[Selector] = []
  let parts = split_commas(t)
  let mut i = 0
  while i < parts.length() {
    match parse_selector(trim(parts[i])) {
      Some(s) => {
        if sel_has_pseudo_element(s) {
          sel_state.forgiven = true
        } else {
          out.push(s)
        }
      }
      None => sel_state.forgiven = true
    }
    i = i + 1
  }
  out
}

pub fn strictly_valid(t : Array[Tok]) -> Bool {
  sel_state.forgiven = false
  let ok = parse_selector_list(t).length() > 0
  let r = ok && !sel_state.forgiven
  sel_state.forgiven = false
  r
}

fn parse_relative(t : Array[Tok]) -> Array[Selector] {
  let out : Array[Selector] = []
  let parts = split_commas(t)
  let mut i = 0
  while i < parts.length() {
    let v = trim(parts[i])
    let mut rel = Combinator::Descendant
    let mut rest = v
    if v.length() > 0 {
      match v[0] {
        Delim(c) => {
          if c == 62 {
            rel = Combinator::Child
            rest = trim(tok_slice(v, 1, v.length()))
          } else if c == 43 {
            rel = Combinator::Next
            rest = trim(tok_slice(v, 1, v.length()))
          } else if c == 126 {
            rel = Combinator::Later
            rest = trim(tok_slice(v, 1, v.length()))
          }
        }
        _ => ()
      }
    }
    match parse_selector(rest) {
      Some(s) => out.push(Selector::{
        parts: s.parts,
        specificity: s.specificity,
        pseudo_element: s.pseudo_element,
        relative: rel,
      })
      None => ()
    }
    i = i + 1
  }
  out
}

fn parse_attr(t0 : Array[Tok]) -> Option[Simple] {
  let t = trim(t0)
  if t.length() < 1 {
    return None
  }
  let mut i = 0
  let mut name = ""
  let mut never = false
  if t.length() >= 3 && tok_eq(t[1], Delim(124)) && !tok_eq(t[2], Delim(61)) {
    match t[0] {
      Ident(_) => {
        match t[2] {
          Ident(m) => {
            name = ascii_lower(m)
            never = true
            i = 3
          }
          _ => return None
        }
      }
      Delim(c) => {
        if c == 42 {
          match t[2] {
            Ident(m) => {
              name = ascii_lower(m)
              i = 3
            }
            _ => return None
          }
        } else {
          return None
        }
      }
      _ => return None
    }
  } else if t.length() >= 2 && tok_eq(t[0], Delim(124)) {
    match t[1] {
      Ident(m) => {
        name = ascii_lower(m)
        i = 2
      }
      _ => return None
    }
  } else {
    match t[0] {
      Ident(n) => {
        name = ascii_lower(n)
        i = 1
      }
      _ => return None
    }
  }
  while i < t.length() && tok_eq(t[i], Space) {
    i = i + 1
  }
  if i >= t.length() {
    return Some(if never { NeverSel } else { AttrSel(name, "", "", false) })
  }
  let mut op = ""
  match t[i] {
    Delim(c) => {
      if c == 61 {
        op = "="
        i = i + 1
      } else if (c == 126 || c == 124 || c == 94 || c == 36 || c == 42) && i + 1 < t.length() && tok_eq(t[i + 1], Delim(61)) {
        op = cp_to_str(c)
        i = i + 2
      } else {
        return None
      }
    }
    _ => return None
  }
  while i < t.length() && tok_eq(t[i], Space) {
    i = i + 1
  }
  if i >= t.length() {
    return None
  }
  let value = match t[i] {
    Ident(v) => v
    Str(v) => v
    _ => return None
  }
  i = i + 1
  let mut ci = false
  let mut seen = false
  while i < t.length() {
    match t[i] {
      Space => ()
      Ident(f) => {
        let lf = ascii_lower(f)
        if !seen && (lf == "i" || lf == "s") {
          ci = lf == "i"
          seen = true
        } else {
          return None
        }
      }
      _ => return None
    }
    i = i + 1
  }
  Some(if never { NeverSel } else { AttrSel(name, op, value, ci) })
}

// ----- Matching -----

fn direction_of(n : html::Node) -> String {
  match n.attr("dir") {
    Some(d) => {
      let ld = ascii_lower(d)
      if ld == "ltr" {
        return "ltr"
      }
      if ld == "rtl" {
        return "rtl"
      }
      if ld == "auto" {
        let walk : Array[html::Node] = []
        let mut ci = n.children.length() - 1
        while ci >= 0 {
          walk.push(n.children[ci])
          ci = ci - 1
        }
        while walk.length() > 0 {
          match walk.pop() {
            Some(c) => {
              if c.kind == html::Kind::Text {
                let cps = decode_utf8_chars(c.data)
                let mut k = 0
                while k < cps.length() {
                  let v = cps[k]
                  if (v >= 0x590 && v < 0x900) || (v >= 0xFB1D && v < 0xFE00) || (v >= 0xFE70 && v < 0xFF00) {
                    return "rtl"
                  }
                  if (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 0xC0 && v < 0x590) {
                    return "ltr"
                  }
                  k = k + 1
                }
              } else if c.kind == html::Kind::Element && c.attr("dir").is_none() &&
              c.tag != "script" && c.tag != "style" && c.tag != "textarea" && c.tag != "bdi" {
                let mut j = c.children.length() - 1
                while j >= 0 {
                  walk.push(c.children[j])
                  j = j - 1
                }
              }
            }
            None => break
          }
        }
        return "ltr"
      }
    }
    None => ()
  }
  match n.parent {
    Some(p) => {
      if p.kind == html::Kind::Element {
        direction_of(p)
      } else if p.kind == html::Kind::Fragment {
        match p.host {
          Some(h) => direction_of(h)
          None => "ltr"
        }
      } else {
        "ltr"
      }
    }
    None => "ltr"
  }
}

fn attr_value_matches(got : Option[String], op : String, value : String, ci : Bool) -> Bool {
  match got {
    None => false
    Some(raw) => {
      let g = if ci { ascii_lower(raw) } else { raw }
      let v = if ci { ascii_lower(value) } else { value }
      if op == "" {
        true
      } else if op == "=" {
        g == v
      } else if op == "~" {
        v != "" && has_token(g, v)
      } else if op == "|" {
        g == v || str_has_prefix(g, v + "-")
      } else if op == "^" {
        v != "" && str_has_prefix(g, v)
      } else if op == "$" {
        v != "" && str_has_suffix(g, v)
      } else {
        v != "" && str_contains(g, v)
      }
    }
  }
}

fn element_parent(n : html::Node) -> Option[html::Node] {
  match n.parent {
    Some(p) => {
      if p.kind == html::Kind::Element {
        Some(p)
      } else if p.kind == html::Kind::Fragment {
        p.host
      } else {
        None
      }
    }
    None => None
  }
}

fn prev_element(n : html::Node, same : Bool) -> Option[html::Node] {
  let p = match n.parent {
    Some(p) => p
    None => return None
  }
  let kids = p.children
  let nlen = kids.length()
  let at = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
  let mut i = at - 1
  while i >= 0 {
    let c = kids[i]
    if c.kind == html::Kind::Element && (!same || c.tag == n.tag) {
      return Some(c)
    }
    i = i - 1
  }
  None
}

fn next_element(n : html::Node, same : Bool) -> Option[html::Node] {
  let p = match n.parent {
    Some(p) => p
    None => return None
  }
  let kids = p.children
  let nlen = kids.length()
  let at = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
  if at < 0 {
    return None
  }
  let mut i = at + 1
  while i < nlen {
    let c = kids[i]
    if c.kind == html::Kind::Element && (!same || c.tag == n.tag) {
      return Some(c)
    }
    i = i + 1
  }
  None
}

fn has_prev_element(n : html::Node, same : Bool) -> Bool {
  let p = match n.parent {
    Some(p) => p
    None => return false
  }
  let kids = p.children
  let nlen = kids.length()
  let at = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
  let mut i = at - 1
  while i >= 0 {
    let c = kids[i]
    if c.kind == html::Kind::Element && (!same || c.tag == n.tag) {
      return true
    }
    i = i - 1
  }
  false
}

fn has_next_element(n : html::Node, same : Bool) -> Bool {
  let p = match n.parent {
    Some(p) => p
    None => return false
  }
  let kids = p.children
  let nlen = kids.length()
  let at = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
  if at < 0 {
    return false
  }
  let mut i = at + 1
  while i < nlen {
    let c = kids[i]
    if c.kind == html::Kind::Element && (!same || c.tag == n.tag) {
      return true
    }
    i = i + 1
  }
  false
}

fn same_lower(tag : String, t : String) -> Bool {
  if tag.length() != t.length() {
    return false
  }
  let mut i = 0
  while i < tag.length() {
    let c = tag.code_unit_at(i)
    let l = if c >= 65 && c <= 90 { c + 32 } else { c }
    if l != t.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn has_token(list : String, tok : String) -> Bool {
  let n = list.length()
  let m = tok.length()
  if m == 0 || m > n {
    return false
  }
  let mut i = 0
  while i < n {
    while i < n && is_space_byte(list.code_unit_at(i)) {
      i = i + 1
    }
    let start = i
    while i < n && !is_space_byte(list.code_unit_at(i)) {
      i = i + 1
    }
    if i - start == m {
      let mut j = 0
      while j < m && list.code_unit_at(start + j) == tok.code_unit_at(j) {
        j = j + 1
      }
      if j == m {
        return true
      }
    }
  }
  false
}

fn matches_nth(pos : Int, a : Int, b : Int) -> Bool {
  if a == 0 {
    pos == b
  } else {
    let d = pos - b
    d % a == 0 && d / a >= 0
  }
}

fn simple_matches(s : Simple, n : html::Node) -> Bool {
  match s {
    Universal => true
    NeverSel => false
    TypeSel(t) => same_lower(n.tag, t)
    IdSel(v) => {
      match n.attr("id") {
        Some(a) => a == v
        None => false
      }
    }
    ClassSel(v, mask) => n.has_class_masked(v, mask)
    AttrSel(name, op, value, ci) => attr_value_matches(n.attr(name), op, value, ci)
    PseudoElSel(_) => true
    PartSel(_) => true
    PseudoSel(name, list) => {
      let c0 = if name.length() > 0 { name.code_unit_at(0) } else { 0 }
      match c0 {
        45 => {
          if name == "-webkit-any" {
            any_matches(list, n)
          } else if name == "-fv-no-namespace" {
            n.ns == html::Ns::Other && n.ns_uri == ""
          } else {
            false
          }
        }
        97 => {
          if name == "active" {
            (element_states.get_or(n.uid, 0) & 64) != 0
          } else if name == "any-link" {
            (n.tag == "a" || n.tag == "area") && n.attr("href").is_some()
          } else {
            false
          }
        }
        99 => {
          if name == "checked" {
            if n.tag == "input" { html::checked(n) } else { n.attr("selected").is_some() }
          } else {
            false
          }
        }
        100 => {
          if name == "disabled" {
            n.attr("disabled").is_some()
          } else if name == "dir-ltr" {
            direction_of(n) == "ltr"
          } else if name == "dir-rtl" {
            direction_of(n) == "rtl"
          } else if name == "defined" {
            !(str_contains(n.tag, "-") && n.ns == html::Ns::Html) || defined_custom.contains(n.uid)
          } else {
            false
          }
        }
        101 => {
          if name == "empty" {
            let mut ci = 0
            while ci < n.children.length() {
              if n.children[ci].kind != html::Kind::Comment {
                return false
              }
              ci = ci + 1
            }
            true
          } else if name == "enabled" {
            (n.tag == "button" || n.tag == "input" || n.tag == "select" || n.tag == "textarea") &&
            n.attr("disabled").is_none()
          } else {
            false
          }
        }
        102 => {
          if name == "first-child" {
            !has_prev_element(n, false)
          } else if name == "focus" {
            (element_states.get_or(n.uid, 0) & 4) != 0
          } else if name == "focus-visible" {
            (element_states.get_or(n.uid, 0) & 8) != 0
          } else if name == "focus-within" {
            (element_states.get_or(n.uid, 0) & 16) != 0
          } else if name == "first-of-type" {
            !has_prev_element(n, true)
          } else {
            false
          }
        }
        104 => {
          if name == "hover" {
            (element_states.get_or(n.uid, 0) & 32) != 0
          } else if name == "has" {
            has_descendant(n, list)
          } else if name == "host" {
            // CSS Scoping 1 §3.1.1: :host / :host(...) only matches in the context of its own shadow tree.
            sel_state.host_target == n.uid && n.shadow.is_some() && (list.length() == 0 || any_matches(list, n))
          } else {
            false
          }
        }
        105 => name == "is" && any_matches(list, n)
        108 => {
          if name == "last-child" {
            !has_next_element(n, false)
          } else if name == "link" {
            (n.tag == "a" || n.tag == "area") && n.attr("href").is_some()
          } else if name == "last-of-type" {
            !has_next_element(n, true)
          } else if name == "lang" {
            let mut p : Option[html::Node] = Some(n)
            let mut lang = ""
            while true {
              match p {
                Some(x) => {
                  match x.attr("lang") {
                    Some(l) => {
                      lang = ascii_lower(l)
                      break
                    }
                    None => p = x.parent
                  }
                }
                None => break
              }
            }
            let mut li = 0
            while li < list.length() {
              let sel = list[li]
              if sel.parts.length() == 1 && sel.parts[0].compound.length() == 1 {
                match sel.parts[0].compound[0] {
                  TypeSel(l) => {
                    if lang == l || str_has_prefix(lang, l + "-") || l == "*" {
                      return true
                    }
                  }
                  _ => ()
                }
              }
              li = li + 1
            }
            false
          } else {
            false
          }
        }
        109 => {
          if name == "matches" {
            any_matches(list, n)
          } else if name == "modal" {
            (element_states.get_or(n.uid, 0) & 2) != 0
          } else {
            false
          }
        }
        110 => name == "not" && !any_matches(list, n)
        111 => {
          if name == "only-child" {
            !has_prev_element(n, false) && !has_next_element(n, false)
          } else if name == "only-of-type" {
            !has_prev_element(n, true) && !has_next_element(n, true)
          } else if name == "open" {
            (n.ns == html::Ns::Html && (n.tag == "details" || n.tag == "dialog") && n.attr("open").is_some()) ||
            (element_states.get_or(n.uid, 0) & 1) != 0
          } else {
            false
          }
        }
        112 => {
          if name == "popover-open" {
            (element_states.get_or(n.uid, 0) & 1) != 0
          } else if name == "placeholder-shown" {
            if n.ns == html::Ns::Html && (n.tag == "input" || n.tag == "textarea") {
              match n.attr("placeholder") {
                Some(ph) => ph.length() > 0 && html::control_value(n) == ""
                None => false
              }
            } else {
              false
            }
          } else {
            false
          }
        }
        114 => {
          if name == "root" {
            match n.parent {
              Some(p) => p.kind == html::Kind::Document
              None => false
            }
          } else {
            false
          }
        }
        115 => {
          if name == "scope" {
            match sel_state.scope_node {
              Some(sc) => sc.uid == n.uid
              None => {
                match n.parent {
                  Some(p) => p.kind == html::Kind::Document
                  None => false
                }
              }
            }
          } else {
            name == "slotted"
          }
        }
        116 => {
          if name == "target" {
            sel_state.target_id != "" && match n.attr("id") {
              Some(a) => a == sel_state.target_id
              None => false
            }
          } else {
            false
          }
        }
        119 => name == "where" && any_matches(list, n)
        _ => false
      }
    }
    NthSel(kind, a, b, list) => {
      let same = kind == "nth-of-type" || kind == "nth-last-of-type"
      let last = kind == "nth-last-child" || kind == "nth-last-of-type"
      let list_empty = list.length() == 0
      let counts_n = n.kind == html::Kind::Element &&
      (list_empty || any_matches(list, n))
      if !counts_n {
        return false
      }
      let mut k = 1
      match n.parent {
        Some(p) => {
          let kids = p.children
          let nlen = kids.length()
          let idx = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
          if last {
            let mut j = idx + 1
            while j < nlen {
              let x = kids[j]
              if x.kind == html::Kind::Element && (!same || x.tag == n.tag) &&
              (list_empty || any_matches(list, x)) {
                k = k + 1
              }
              j = j + 1
            }
          } else {
            let mut j = 0
            while j < idx {
              let x = kids[j]
              if x.kind == html::Kind::Element && (!same || x.tag == n.tag) &&
              (list_empty || any_matches(list, x)) {
                k = k + 1
              }
              j = j + 1
            }
          }
        }
        None => ()
      }
      matches_nth(k, a, b)
    }
  }
}

fn has_descendant(n : html::Node, list : Array[Selector]) -> Bool {
  let mut i = 0
  while i < list.length() {
    if has_one(n, list[i]) {
      return true
    }
    i = i + 1
  }
  false
}

fn any_below_rel(n : html::Node, s : Selector, anchor : html::Node) -> Bool {
  let mut i = 0
  while i < n.children.length() {
    let c = n.children[i]
    if c.kind == html::Kind::Element {
      if rel_from(s, 0, c, anchor) || any_below_rel(c, s, anchor) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn has_one(anchor : html::Node, s : Selector) -> Bool {
  match s.relative {
    Descendant => any_below_rel(anchor, s, anchor)
    Child => any_below_rel(anchor, s, anchor)
    Next => {
      if s.parts.length() == 1 {
        match next_element(anchor, false) {
          Some(x) => rel_from(s, 0, x, anchor)
          None => false
        }
      } else {
        let mut q = next_element(anchor, false)
        while true {
          match q {
            Some(x) => {
              if rel_from(s, 0, x, anchor) || any_below_rel(x, s, anchor) {
                return true
              }
              q = next_element(x, false)
            }
            None => break
          }
        }
        false
      }
    }
    Later => {
      let mut q = next_element(anchor, false)
      while true {
        match q {
          Some(x) => {
            if rel_from(s, 0, x, anchor) || (s.parts.length() > 1 && any_below_rel(x, s, anchor)) {
              return true
            }
            q = next_element(x, false)
          }
          None => break
        }
      }
      false
    }
  }
}

fn rel_from(s : Selector, part : Int, n : html::Node, anchor : html::Node) -> Bool {
  let sp = s.parts[part]
  if !compound_matches(sp.compound, n) {
    return false
  }
  if part + 1 >= s.parts.length() {
    return match s.relative {
      Child => {
        match element_parent(n) {
          Some(p) => p.uid == anchor.uid
          None => false
        }
      }
      Descendant => {
        let mut p = element_parent(n)
        while true {
          match p {
            Some(x) => {
              if x.uid == anchor.uid {
                return true
              }
              p = element_parent(x)
            }
            None => break
          }
        }
        false
      }
      Next => {
        match prev_element(n, false) {
          Some(x) => x.uid == anchor.uid
          None => false
        }
      }
      Later => {
        let mut q = prev_element(n, false)
        while true {
          match q {
            Some(x) => {
              if x.uid == anchor.uid {
                return true
              }
              q = prev_element(x, false)
            }
            None => break
          }
        }
        false
      }
    }
  }
  match sp.comb {
    Child => {
      match element_parent(n) {
        Some(p) => p.uid != anchor.uid && rel_from(s, part + 1, p, anchor)
        None => false
      }
    }
    Descendant => {
      let mut p = element_parent(n)
      while true {
        match p {
          Some(x) => {
            if x.uid == anchor.uid {
              return false
            }
            if rel_from(s, part + 1, x, anchor) {
              return true
            }
            p = element_parent(x)
          }
          None => break
        }
      }
      false
    }
    Next => {
      match prev_element(n, false) {
        Some(x) => rel_from(s, part + 1, x, anchor)
        None => false
      }
    }
    Later => {
      let mut q = prev_element(n, false)
      while true {
        match q {
          Some(x) => {
            if rel_from(s, part + 1, x, anchor) {
              return true
            }
            q = prev_element(x, false)
          }
          None => break
        }
      }
      false
    }
  }
}

fn compound_matches(c : Array[Simple], n : html::Node) -> Bool {
  let mut i = 0
  while i < c.length() {
    if !simple_matches(c[i], n) {
      return false
    }
    i = i + 1
  }
  true
}

fn any_matches(list : Array[Selector], n : html::Node) -> Bool {
  let mut i = 0
  while i < list.length() {
    if selector_matches(list[i], n) {
      return true
    }
    i = i + 1
  }
  false
}

fn match_from(s : Selector, part : Int, n : html::Node) -> Bool {
  let sp = s.parts[part]
  if !compound_matches(sp.compound, n) {
    return false
  }
  match_after(s, part, sp, n)
}

///|
/// Whether the rest of `s` past part `part` (whose compound `n` matches) matches `n`'s ancestors and siblings.
fn match_after(s : Selector, part : Int, sp : SelPart, n : html::Node) -> Bool {
  if part + 1 >= s.parts.length() {
    return true
  }
  match sp.comb {
    Child => {
      match n.parent {
        Some(p) => {
          if p.kind == html::Kind::Element {
            match_from(s, part + 1, p)
          } else if p.kind == html::Kind::Fragment {
            match p.host {
              Some(h) => {
                let prev_host = sel_state.host_target
                sel_state.host_target = h.uid
                let matched = match_from(s, part + 1, h)
                sel_state.host_target = prev_host
                matched
              }
              None => false
            }
          } else {
            false
          }
        }
        None => false
      }
    }
    Descendant => {
      // (each ancestor's compound tested here, the rest of the selector only past one that matches; the host a
      // :host part matches set only for the shadow host just crossed into, and put back: a match leaves it as it was)
      let next = s.parts[part + 1]
      let nc = next.compound
      let mut cur = n.parent
      let mut crossed_host = -1
      while true {
        match cur {
          Some(p) => {
            if p.kind == html::Kind::Element {
              if crossed_host == p.uid {
                let prev_host = sel_state.host_target
                sel_state.host_target = p.uid
                let matched = match_from(s, part + 1, p)
                sel_state.host_target = prev_host
                if matched {
                  return true
                }
              } else if compound_matches(nc, p) && match_after(s, part + 1, next, p) {
                return true
              }
              crossed_host = -1
              cur = p.parent
            } else if p.kind == html::Kind::Fragment {
              match p.host {
                Some(h) => {
                  crossed_host = h.uid
                  cur = Some(h)
                }
                None => break
              }
            } else {
              break
            }
          }
          None => break
        }
      }
      false
    }
    Next => {
      match n.parent {
        Some(p) => {
          let kids = p.children
          let nlen = kids.length()
          let at = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
          let mut i = at - 1
          while i >= 0 {
            let c = kids[i]
            if c.kind == html::Kind::Element {
              return match_from(s, part + 1, c)
            }
            i = i - 1
          }
          false
        }
        None => false
      }
    }
    Later => {
      match n.parent {
        Some(p) => {
          let kids = p.children
          let nlen = kids.length()
          let at = if n.pos >= 0 && n.pos < nlen && kids[n.pos].uid == n.uid { n.pos } else { n.index() }
          let mut i = at - 1
          while i >= 0 {
            let c = kids[i]
            if c.kind == html::Kind::Element {
              if match_from(s, part + 1, c) {
                return true
              }
            }
            i = i - 1
          }
          false
        }
        None => false
      }
    }
  }
}

pub fn selector_matches(s : Selector, n : html::Node) -> Bool {
  match_from(s, 0, n)
}
