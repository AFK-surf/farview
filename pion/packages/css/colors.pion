  m.set("selecteditemtext", 0xffffff)
  m.set("mark", 0xffff00)
  m.set("marktext", 0x000000)
  m.set("graytext", 0x808080)
  m.set("accentcolor", 0x0075ff)
  m.set("accentcolortext", 0xffffff)
  m
}

let named_colors_cache : Array[Map[String, Int]] = []

fn named_color_lookup(name : String) -> Option[Int] {
  if named_colors_cache.length() == 0 {
    named_colors_cache.push(build_named_colors())
  }
  named_colors_cache[0].get(name)
}
