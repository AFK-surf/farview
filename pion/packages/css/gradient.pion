///| CSS Images 4 gradients: linear-, radial-, conic-gradient() validation and canonical serialization.
///| 1:1 port of `client/src/css/gradient.mbt`.

fn is_gradient_name(f : String) -> Bool {
  f == "linear-gradient" || f == "repeating-linear-gradient" ||
  f == "radial-gradient" || f == "repeating-radial-gradient" ||
  f == "conic-gradient" || f == "repeating-conic-gradient"
}

fn is_rect_space(s : String) -> Bool {
  s == "srgb" || s == "srgb-linear" || s == "display-p3" || s == "display-p3-linear" || s == "a98-rgb" ||
  s == "prophoto-rgb" || s == "rec2020" || s == "lab" || s == "oklab" ||
  s == "xyz" || s == "xyz-d50" || s == "xyz-d65"
}

fn paren_end(t : Array[Tok], start : Int) -> Int {
  let mut depth = 0
  let mut i = start
  while i < t.length() {
    match t[i] {
      Function(_) => depth = depth + 1
      OpenParen => depth = depth + 1
      CloseParen => {
        if depth == 0 {
          return i
        }
        depth = depth - 1
      }
      _ => ()
    }
    i = i + 1
  }
  -1
}

fn word_ident(w : Array[Tok]) -> String {
  if w.length() == 1 {
    match w[0] {
      Ident(x) => ascii_lower(x)
      _ => ""
    }
  } else {
    ""
  }
}

fn is_grad_length_unit(u : String) -> Bool {
  let lu = ascii_lower(u)
  str_arr_contains(length_units(), lu)
}

fn is_angle_unit(u : String) -> Bool {
  let lu = ascii_lower(u)
  lu == "deg" || lu == "rad" || lu == "grad" || lu == "turn"
}

fn is_grad_math_fn(f : String) -> Bool {
  let lf = ascii_lower(f)
  is_math_func(lf) || lf == "calc-size"
}

struct MathKinds {
  kinds : Array[String]
  added_number : Bool
}

fn math_kinds(w : Array[Tok]) -> MathKinds {
  let kinds : Array[String] = []
  let mut added_number = false
  let sig = tok_filter_no_space(w)
  let mut i = 0
  while i < sig.length() {
    match sig[i] {
      Dimension(_, u) => {
        if is_grad_length_unit(u) {
          if !str_arr_contains(kinds, "length") { kinds.push("length") }
        } else if is_angle_unit(u) {
          if !str_arr_contains(kinds, "angle") { kinds.push("angle") }
        } else {
          if !str_arr_contains(kinds, "other") { kinds.push("other") }
        }
      }
      Percentage(_) => {
        if !str_arr_contains(kinds, "percent") { kinds.push("percent") }
      }
      Number(_) => {
        let before_mul = i > 0 && match sig[i - 1] { Delim(c) => c == 42 || c == 47 _ => false }
        let after_mul = i + 1 < sig.length() && match sig[i + 1] { Delim(c) => c == 42 || c == 47 _ => false }
        if !before_mul && !after_mul {
          added_number = true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  MathKinds::{ kinds: kinds, added_number: added_number }
}

fn is_lp(w : Array[Tok], angle : Bool) -> Bool {
  if w.length() == 1 {
    match w[0] {
      Percentage(_) => return true
      Number(n) => return n == 0.0
      Dimension(_, u) => return if angle { is_angle_unit(u) } else { is_grad_length_unit(u) }
      _ => return false
    }
  }
  if w.length() > 0 {
    match w[0] {
      Function(f) => {
        if is_grad_math_fn(f) {
          let mk = math_kinds(w)
          let want = if angle { "angle" } else { "length" }
          let mut ok = true
          let mut i = 0
          while i < mk.kinds.length() {
            if mk.kinds[i] != "percent" && mk.kinds[i] != want {
              ok = false
            }
            i = i + 1
          }
          return ok && mk.kinds.length() > 0 && !mk.added_number
        }
      }
      _ => ()
    }
  }
  false
}

fn is_angle(w : Array[Tok]) -> Bool {
  if w.length() == 1 {
    match w[0] {
      Number(n) => return n == 0.0
      Dimension(_, u) => return is_angle_unit(u)
      _ => return false
    }
  }
  if w.length() > 0 {
    match w[0] {
      Function(f) => {
        if is_grad_math_fn(f) {
          let mk = math_kinds(w)
          return mk.kinds.length() == 1 && mk.kinds[0] == "angle"
        }
      }
      _ => ()
    }
  }
  false
}

fn lp_text(w : Array[Tok]) -> String {
  if w.length() > 1 {
    match w[0] {
      Function(f) => {
        if ascii_lower(f) == "calc" {
          let sig = tok_filter_no_space(tok_slice(w, 1, w.length()))
          if sig.length() == 4 && tok_eq(sig[1], Delim(43)) && tok_eq(sig[3], CloseParen) {
            let a_is_pct = match sig[0] { Percentage(_) => true _ => false }
            match sig[2] {
              Percentage(p) => {
                if !a_is_pct {
                  return "calc(" + serialize_value([Percentage(p)]) + " + " + serialize_value([sig[0]]) + ")"
                }
              }
              _ => ()
            }
          }
        }
      }
      _ => ()
    }
  }
  serialize_value(w)
}

fn lp_computed(w : Array[Tok], px : Option[(Array[Tok]) -> Option[Double]]) -> String {
  match px {
    Some(f) => {
      if w.length() == 1 {
        match w[0] {
          Dimension(_, u) => {
            if is_grad_length_unit(u) {
              match f(w) {
                Some(v) => return serialize_value([Dimension(v, "px")])
                None => return serialize_value(w)
              }
            }
          }
          Number(n) => {
            if n == 0.0 {
              return "0px"
            }
          }
          _ => ()
        }
      }
      lp_text(w)
    }
    None => lp_text(w)
  }
}

struct PosParts {
  hp : Array[Array[Tok]]
  vp : Array[Array[Tok]]
}

fn position_parts(ws : Array[Array[Tok]]) -> Option[PosParts] {
  let n = ws.length()
  if n == 1 {
    let a = ws[0]
    let ia = word_ident(a)
    if ia == "left" || ia == "right" || ia == "center" {
      return Some(PosParts::{ hp: [a], vp: [[Ident("center")]] })
    }
    if ia == "top" || ia == "bottom" {
      return Some(PosParts::{ hp: [[Ident("center")]], vp: [a] })
    }
    if is_lp(a, false) {
      return Some(PosParts::{ hp: [a], vp: [[Ident("center")]] })
    }
    return None
  }
  if n == 2 {
    let a = ws[0]
    let b = ws[1]
    let ia = word_ident(a)
    let ib = word_ident(b)
    let ha = ia == "left" || ia == "right" || ia == "center"
    let vb = ib == "top" || ib == "bottom" || ib == "center"
    let va = ia == "top" || ia == "bottom" || ia == "center"
    let hb = ib == "left" || ib == "right" || ib == "center"
    if (ha || is_lp(a, false)) && (vb || is_lp(b, false)) {
      return Some(PosParts::{ hp: [a], vp: [b] })
    }
    if va && hb {
      return Some(PosParts::{ hp: [b], vp: [a] })
    }
    return None
  }
  if n == 4 {
    let a = ws[0]
    let oa = ws[1]
    let b = ws[2]
    let ob = ws[3]
    if !is_lp(oa, false) || !is_lp(ob, false) {
      return None
    }
    let ia = word_ident(a)
    let ib = word_ident(b)
    if (ia == "left" || ia == "right") && (ib == "top" || ib == "bottom") {
      return Some(PosParts::{ hp: [a, oa], vp: [b, ob] })
    }
    if (ia == "top" || ia == "bottom") && (ib == "left" || ib == "right") {
      return Some(PosParts::{ hp: [b, ob], vp: [a, oa] })
    }
    return None
  }
  None
}

fn pos_axis_text(p : Array[Array[Tok]], px : Option[(Array[Tok]) -> Option[Double]]) -> String {
  if p.length() == 1 {
    let k = word_ident(p[0])
    if k == "left" || k == "top" { return "0%" }
    if k == "center" { return "50%" }
    if k == "right" || k == "bottom" { return "100%" }
    return lp_computed(p[0], px)
  }
  if p.length() == 2 {
    let k = word_ident(p[0])
    let far = k == "right" || k == "bottom"
    if p[1].length() == 1 {
      match p[1][0] {
        Percentage(v) => return serialize_value([Percentage(if far { 100.0 - v } else { v })])
        _ => ()
      }
    }
    let o = lp_computed(p[1], px)
    return if far { "calc(100% - " + o + ")" } else { o }
  }
  ""
}

fn position_text(parts : PosParts, px : Option[(Array[Tok]) -> Option[Double]]) -> Option[String] {
  if px.is_none() {
    let hs : Array[String] = []
    let mut i = 0
    while i < parts.hp.length() {
      let id = word_ident(parts.hp[i])
      hs.push(if id != "" { id } else { lp_text(parts.hp[i]) })
      i = i + 1
    }
    let vs : Array[String] = []
    i = 0
    while i < parts.vp.length() {
      let id = word_ident(parts.vp[i])
      vs.push(if id != "" { id } else { lp_text(parts.vp[i]) })
      i = i + 1
    }
    return Some(str_join(hs, " ") + " " + str_join(vs, " "))
  }
  let x = pos_axis_text(parts.hp, px)
  let y = pos_axis_text(parts.vp, px)
  if x == "50%" && y == "50%" { None } else { Some(x + " " + y) }
}

fn linear_shape(ws : Array[Array[Tok]]) -> Option[String] {
  if ws.length() == 0 {
    return Some("")
  }
  if ws.length() == 1 {
    return if is_angle(ws[0]) { Some(lp_text(ws[0])) } else { None }
  }
  if word_ident(ws[0]) == "to" && ws.length() >= 2 && ws.length() <= 3 {
    let mut h = ""
    let mut v = ""
    let mut i = 1
    while i < ws.length() {
      let s = word_ident(ws[i])
      if (s == "left" || s == "right") && h == "" {
        h = s
      } else if (s == "top" || s == "bottom") && v == "" {
        v = s
      } else {
        return None
      }
      i = i + 1
    }
    let out : Array[String] = []
    if h != "" { out.push(h) }
    if v != "" { out.push(v) }
    return Some("to " + str_join(out, " "))
  }
  None
}

fn radial_shape(ws : Array[Array[Tok]], px : Option[(Array[Tok]) -> Option[Double]]) -> Option[String] {
  let mut at = -1
  let mut i = 0
  while i < ws.length() {
    if word_ident(ws[i]) == "at" {
      at = i
      break
    }
    i = i + 1
  }
  let before : Array[Array[Tok]] = []
  let pos : Array[Array[Tok]] = []
  let has_pos = at >= 0
  let lim = if at >= 0 { at } else { ws.length() }
  i = 0
  while i < lim {
    before.push(ws[i])
    i = i + 1
  }
  if has_pos {
    i = at + 1
    while i < ws.length() {
      pos.push(ws[i])
      i = i + 1
    }
  }
  let mut shape = ""
  let mut extent = ""
  let sizes : Array[Array[Tok]] = []
  i = 0
  while i < before.length() {
    let w = before[i]
    let id = word_ident(w)
    if (id == "circle" || id == "ellipse") && shape == "" {
      shape = id
    } else if (id == "closest-side" || id == "closest-corner" || id == "farthest-side" || id == "farthest-corner") && extent == "" && sizes.length() == 0 {
      extent = id
    } else if extent == "" && is_lp(w, false) && sizes.length() < 2 {
      sizes.push(w)
    } else {
      return None
    }
    i = i + 1
  }
  if sizes.length() == 1 {
    if shape == "ellipse" { return None }
    let s0 = sizes[0]
    if s0.length() == 1 {
      match s0[0] {
        Percentage(_) => return None
        Dimension(n, _) => { if n < 0.0 { return None } }
        _ => ()
      }
    } else if s0.length() > 0 {
      match s0[0] {
        Function(_) => {
          if str_arr_contains(math_kinds(s0).kinds, "percent") { return None }
        }
        _ => ()
      }
    }
  } else if sizes.length() == 2 {
    if shape == "circle" { return None }
  }
  i = 0
  while i < sizes.length() {
    let s = sizes[i]
    if s.length() == 1 {
      match s[0] {
        Dimension(n, _) => { if n < 0.0 { return None } }
        Percentage(n) => { if n < 0.0 { return None } }
        _ => ()
      }
    }
    i = i + 1
  }
  let out : Array[String] = []
  if shape == "circle" && sizes.length() == 0 {
    out.push("circle")
  }
  if extent != "" && extent != "farthest-corner" {
    out.push(extent)
  }
  i = 0
  while i < sizes.length() {
    out.push(if px.is_some() { lp_computed(sizes[i], px) } else { lp_text(sizes[i]) })
    i = i + 1
  }
  if has_pos {
    let parts = match position_parts(pos) { Some(p) => p None => return None }
    match position_text(parts, px) {
      Some(t) => out.push("at " + t)
      None => ()
    }
  }
  Some(str_join(out, " "))
}

fn conic_shape(ws : Array[Array[Tok]], px : Option[(Array[Tok]) -> Option[Double]]) -> Option[String] {
  let out : Array[String] = []
  let mut i = 0
  if i < ws.length() && word_ident(ws[i]) == "from" {
    if i + 1 >= ws.length() || !is_angle(ws[i + 1]) { return None }
    out.push("from " + lp_text(ws[i + 1]))
    i = i + 2
  }
  if i < ws.length() && word_ident(ws[i]) == "at" {
    let pos : Array[Array[Tok]] = []
    let mut j = i + 1
    while j < ws.length() {
      pos.push(ws[j])
      j = j + 1
    }
    let parts = match position_parts(pos) { Some(p) => p None => return None }
    match position_text(parts, px) {
      Some(t) => out.push("at " + t)
      None => ()
    }
    i = ws.length()
  }
  if i != ws.length() { return None }
  Some(str_join(out, " "))
}

struct InterpMethod {
  space : String
  hue : String
}

fn gradient_text(name : String, inner : Array[Tok], px : Option[(Array[Tok]) -> Option[Double]]) -> Option[String] {
  let kind = if str_contains(name, "linear") {
    "linear"
  } else if str_contains(name, "radial") {
    "radial"
  } else {
    "conic"
  }
  let raw_parts = split_commas(inner)
  let parts : Array[Array[Tok]] = []
  let mut i = 0
  while i < raw_parts.length() {
    parts.push(trim(raw_parts[i]))
    i = i + 1
  }
  if parts.length() == 0 || parts[0].length() == 0 {
    return None
  }
  let first = words(parts[0])
  if first.length() == 0 {
    return None
  }
  let is_stop_start = parse_col(first[0]).is_some()
  let prelude : Array[Array[Tok]] = if is_stop_start { [] } else { first }
  let stop_parts : Array[Array[Tok]] = []
  let mut si = if is_stop_start { 0 } else { 1 }
  while si < parts.length() {
    stop_parts.push(parts[si])
    si = si + 1
  }
  let mut interp : Option[InterpMethod] = None
  let mut rest = prelude
  let mut in_idx = -1
  i = 0
  while i < prelude.length() {
    if word_ident(prelude[i]) == "in" {
      in_idx = i
      break
    }
    i = i + 1
  }
  if in_idx >= 0 {
    if in_idx + 1 >= prelude.length() { return None }
    let space = word_ident(prelude[in_idx + 1])
    let polar = is_polar_space(space)
    if !polar && !is_rect_space(space) { return None }
    let mut end = in_idx + 2
    let mut hue = ""
    if end < prelude.length() {
      let hm = word_ident(prelude[end])
      if hm == "shorter" || hm == "longer" || hm == "increasing" || hm == "decreasing" {
        if !polar || end + 1 >= prelude.length() || word_ident(prelude[end + 1]) != "hue" {
          return None
        }
        hue = hm
        end = end + 2
      }
    }
    if in_idx != 0 && end != prelude.length() { return None }
    interp = Some(InterpMethod::{ space: if space == "xyz" { "xyz-d65" } else { space }, hue: hue })
    let nr : Array[Array[Tok]] = []
    let mut j = 0
    while j < in_idx { nr.push(prelude[j]); j = j + 1 }
    j = end
    while j < prelude.length() { nr.push(prelude[j]); j = j + 1 }
    j = 0
    while j < nr.length() {
      if word_ident(nr[j]) == "in" { return None }
      j = j + 1
    }
    rest = nr
  }
  if prelude.length() > 0 && rest.length() == 0 && interp.is_none() {
    return None
  }
  let shape = match (if kind == "linear" { linear_shape(rest) } else if kind == "radial" { radial_shape(rest, px) } else { conic_shape(rest, px) }) {
    Some(s) => s
    None => return None
  }
  if stop_parts.length() == 0 {
    return None
  }
  let stops : Array[String] = []
  let mut legacy = true
  let mut last_hint = true
  i = 0
  while i < stop_parts.length() {
    let ws = words(stop_parts[i])
    if ws.length() == 0 { return None }
    match parse_col(ws[0]) {
      Some(c) => {
        if ws.length() > 3 { return None }
        let mut j = 1
        while j < ws.length() {
          if !is_lp(ws[j], kind == "conic") { return None }
          j = j + 1
        }
        if c.space != "currentcolor" && !c.legacy {
          legacy = false
        }
        let color = if px.is_some() {
          if c.space == "currentcolor" { "currentcolor" } else { col_text(c) }
        } else {
          serialize_value(ws[0])
        }
        let segs : Array[String] = [color]
        j = 1
        while j < ws.length() {
          segs.push(if px.is_some() { lp_computed(ws[j], px) } else { lp_text(ws[j]) })
          j = j + 1
        }
        stops.push(str_join(segs, " "))
        last_hint = false
      }
      None => {
        if ws.length() != 1 || !is_lp(ws[0], kind == "conic") { return None }
        if last_hint || i >= stop_parts.length() - 1 { return None }
        stops.push(if px.is_some() { lp_computed(ws[0], px) } else { lp_text(ws[0]) })
        last_hint = true
      }
    }
    i = i + 1
  }
  if last_hint { return None }
  let method_text = match interp {
    Some(im) => {
      let hue = if im.hue == "shorter" { "" } else { im.hue }
      if hue == "" && ((legacy && im.space == "srgb") || (!legacy && im.space == "oklab")) {
        ""
      } else if hue == "" {
        "in " + im.space
      } else {
        "in " + im.space + " " + hue + " hue"
      }
    }
    None => ""
  }
  let head_parts : Array[String] = []
  if shape != "" { head_parts.push(shape) }
  if method_text != "" { head_parts.push(method_text) }
  let head = str_join(head_parts, " ")
  Some(name + "(" + (if head == "" { "" } else { head + ", " }) + str_join(stops, ", ") + ")")
}

pub fn image_list_text(v0 : Array[Tok], px : Option[(Array[Tok]) -> Option[Double]]) -> Option[String] {
  let v = tok_filter_no_end(v0)
  if has_var(v) {
    return Some(serialize_value(v))
  }
  let out : Array[String] = []
  let layers = split_commas(v)
  let mut i = 0
  while i < layers.length() {
    let layer = trim(layers[i])
    let mut handled = false
    if layer.length() > 0 {
      match layer[0] {
        Function(f) => {
          let lf = ascii_lower(f)
          if is_gradient_name(lf) {
            let end = paren_end(layer, 1)
            if end != layer.length() - 1 { return None }
            match gradient_text(lf, tok_slice(layer, 1, end), px) {
              Some(t) => out.push(t)
              None => return None
            }
            handled = true
          }
        }
        _ => ()
      }
    }
    if !handled {
      out.push(serialize_value(layer))
    }
    i = i + 1
  }
  Some(str_join(out, ", "))
}

pub fn image_list_tokens(v0 : Array[Tok]) -> Option[Array[Tok]] {
  let v = tok_filter_no_end(v0)
  if has_var(v) {
    return Some(v)
  }
  let out : Array[Tok] = []
  let layers = split_commas(v)
  let mut i = 0
  while i < layers.length() {
    if i > 0 {
      out.push(Comma)
    }
    let layer = trim(layers[i])
    let mut handled = false
    if layer.length() > 0 {
      match layer[0] {
        Function(f) => {
          let lf = ascii_lower(f)
          if is_gradient_name(lf) {
            let end = paren_end(layer, 1)
            if end != layer.length() - 1 { return None }
            match gradient_text(lf, tok_slice(layer, 1, end), None) {
              Some(t) => tok_append(out, trim(tok_filter_no_end(tokenize(t))))
              None => return None
            }
            handled = true
          }
        }
        _ => ()
      }
    }
    if !handled {
      tok_append(out, layer)
    }
    i = i + 1
  }
  Some(out)
}

pub fn image_list_valid(v : Array[Tok]) -> Bool {
  image_list_text(v, None).is_some()
}
