///| CSS Cascade, Style, VarMap, Engine, invalidation sets, and computed style accessors.
///| 1:1 port of `client/src/css/cascade.mbt`.

// ----- Global hooks & counters -----

struct CssGlobals {
  mut quirks_mode : Bool
  mut share_gens : Int
  mut style_uids : Int
  mut varmap_uids : Int
  mut matched_uids : Int
  mut calc_base : Option[Double]
  mut cur_family : Array[Tok]
  mut ch_hook : (Array[Tok], Double) -> Double
  mut normal_lh_hook : (Array[Tok], Double) -> Double
  mut container_size : (Int) -> Option[(Double, Double)]
  mut cur_cq : Option[(Double, Double)]
  mut kids_same_a_uid : Int
  mut kids_same_b_uid : Int
}

let css_globals : CssGlobals = CssGlobals::{
  quirks_mode: false,
  share_gens: 0,
  style_uids: 0,
  varmap_uids: 0,
  matched_uids: 0,
  calc_base: None,
  cur_family: [],
  ch_hook: fn(_fam : Array[Tok], fs : Double) -> Double { fs * 0.5 },
  normal_lh_hook: fn(_fam : Array[Tok], fs : Double) -> Double { fs * 1.15 },
  container_size: fn(_uid : Int) -> Option[(Double, Double)] { None },
  cur_cq: None,
  kids_same_a_uid: -1,
  kids_same_b_uid: -1,
}

pub let match_counts : Array[Int] = [0, 0, 0, 0]
pub let forget_counts : Array[Int] = [0, 0, 0, 0]
pub let style_counts : Array[Int] = [0, 0, 0, 0, 0, 0, 0]
pub let lookup_counts : Array[Int] = [0, 0, 0]

pub fn set_ch_hook(f : (Array[Tok], Double) -> Double) -> Unit {
  css_globals.ch_hook = f
}

pub fn set_normal_lh_hook(f : (Array[Tok], Double) -> Double) -> Unit {
  css_globals.normal_lh_hook = f
}

pub fn set_container_size_hook(f : (Int) -> Option[(Double, Double)]) -> Unit {
  css_globals.container_size = f
}

fn next_share_gen() -> Int {
  css_globals.share_gens = css_globals.share_gens + 1
  css_globals.share_gens
}

fn next_style_uid() -> Int {
  css_globals.style_uids = css_globals.style_uids + 1
  css_globals.style_uids
}

fn next_varmap_uid() -> Int {
  css_globals.varmap_uids = css_globals.varmap_uids + 1
  css_globals.varmap_uids
}

fn next_matched_uid() -> Int {
  css_globals.matched_uids = css_globals.matched_uids + 1
  css_globals.matched_uids
}

fn family_now() -> Array[Tok] {
  css_globals.cur_family
}

fn toks_has_ch(toks : Array[Tok]) -> Bool {
  let mut i = 0
  while i < toks.length() {
    match toks[i] {
      Dimension(_, u) => if u == "ch" || u == "CH" || u == "Ch" || u == "cH" { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

// ----- Core structs -----

struct Entry {
  sel : Selector
  decls : Array[Decl]
  order : Int
  ua : Bool
  layer : Array[Int]
  need : Array[Int]
  attr_fn : Bool
  has_vars : Bool
  has_important : Bool
  has_content : Bool
  cq : Option[Array[Tok]]
  mut single_list : Option[MatchedList]
}

struct PseudoIndex {
  by_id : Map[String, Array[Entry]]
  by_class : Map[String, Array[Entry]]
  by_tag : Map[String, Array[Entry]]
  by_attr : Map[String, Array[Entry]]
  mut by_attr_has_id : Bool
  mut by_attr_has_class : Bool
  roots : Array[Entry]
  rest : Array[Entry]
}

// The keys a ::before or ::after rule that declares `content` is filed under, as in a PseudoIndex (`content_keys`):
// an element none of whose keys is here (no id, class, tag, attribute or root rule of the kind, no unkeyed one) is
// matched by none of them, so that no box is made for its ::before / ::after, without matching the rules of every
// other pseudo-element (`*::before { box-sizing }` and the like) that the pseudo index holds as well.
struct ContentKeys {
  ids : Map[String, Bool]
  classes : Map[String, Bool]
  tags : Map[String, Bool]
  attrs : Map[String, Bool]
  mut attr_has_id : Bool
  mut attr_has_class : Bool
  mut roots : Bool
  mut rest : Bool
}

fn ContentKeys::new() -> ContentKeys {
  ContentKeys::{
    ids: Map::new(),
    classes: Map::new(),
    tags: Map::new(),
    attrs: Map::new(),
    attr_has_id: false,
    attr_has_class: false,
    roots: false,
    rest: false,
  }
}

fn ContentKeys::add(self : ContentKeys, keys : Option[Array[SubjectKey]]) -> Unit {
  match keys {
    Some(ks) => {
      let mut i = 0
      while i < ks.length() {
        let kk = ks[i]
        if kk.kind == 4 {
          self.roots = true
        } else if kk.kind == 0 {
          self.ids.set(kk.key, true)
        } else if kk.kind == 1 {
          self.classes.set(kk.key, true)
        } else if kk.kind == 2 {
          self.tags.set(kk.key, true)
        } else {
          if kk.key == "id" { self.attr_has_id = true } else if kk.key == "class" { self.attr_has_class = true }
          self.attrs.set(kk.key, true)
        }
        i = i + 1
      }
    }
    None => self.rest = true
  }
}

// Whether a rule filed under these keys might match `n`: it looks the element up as match_now_with does, without
// matching anything.
fn ContentKeys::may_match(self : ContentKeys, n : html::Node) -> Bool {
  if self.rest { return true }
  if self.roots {
    match n.parent {
      Some(p) => if p.kind == html::Kind::Document { return true }
      None => ()
    }
  }
  let is_html = n.ns == html::Ns::Html
  if self.tags.length() > 0 {
    let tn = if is_html { n.tag } else { lower_tag(n.tag) }
    if self.tags.contains(tn) { return true }
  }
  let has_id = self.ids.length() > 0
  let has_cls = self.classes.length() > 0
  let has_attr = self.attrs.length() > 0
  let attrs = n.attrs
  let alen = attrs.length()
  if (has_id || has_cls || has_attr) && alen > 0 {
    let mut seen_id = false
    let mut seen_cls = false
    let mut ai = 0
    while ai < alen {
      let attr = attrs[ai]
      let al = attr.name.length()
      if attr.prefix == "" {
        if has_id && !seen_id && al == 2 && attr.name == "id" {
          seen_id = true
          if self.ids.contains(attr.value) { return true }
        } else if has_cls && !seen_cls && al == 5 && attr.name == "class" {
          seen_cls = true
          let c = attr.value
          if is_single_word(c) {
            if self.classes.contains(c) { return true }
          } else {
            let ws = class_words_dedup(c)
            let mut j = 0
            while j < ws.length() {
              if self.classes.contains(ws[j]) { return true }
              j = j + 1
            }
          }
        }
      }
      if has_attr {
        if attr.prefix != "" || !((al == 5 && attr.name == "class" && !self.attr_has_class) || (al == 2 && attr.name == "id" && !self.attr_has_id)) {
          let an = if is_html { attr.name } else { lower_tag(attr.name) }
          if self.attrs.contains(an) { return true }
        }
      }
      ai = ai + 1
    }
  }
  false
}

fn PseudoIndex::new() -> PseudoIndex {
  PseudoIndex::{
    by_id: Map::new(),
    by_class: Map::new(),
    by_tag: Map::new(),
    by_attr: Map::new(),
    by_attr_has_id: false,
    by_attr_has_class: false,
    roots: [],
    rest: [],
  }
}

struct MatchedList {
  uid : Int
  entries : Array[Entry]
  flags : Int
  mut share_key : String
}

fn entry_flags(e : Entry) -> Int {
  (if e.attr_fn { 1 } else { 0 }) |
  (if e.has_vars { 2 } else { 0 }) |
  (if e.has_important { 4 } else { 0 }) |
  (if e.ua { 8 } else { 16 })
}

let empty_share_key : String = "|\u{0}|"

let EMPTY_MATCHED_LIST : MatchedList = MatchedList::{ uid: 0, entries: [], flags: 0, share_key: empty_share_key }

struct NodeMatches {
  mut main : Option[MatchedList]
  mut before : Option[MatchedList]
  mut after : Option[MatchedList]
  mut other : Option[Map[String, MatchedList]]
  // (pseudo_declares_content) 1: no ::before rule declaring `content` is filed under the element's keys, 2: no
  // ::after one; known as long as what it matched is (all of it is forgotten together)
  mut no_content : Int
}

fn NodeMatches::new() -> NodeMatches {
  NodeMatches::{ main: None, before: None, after: None, other: None, no_content: 0 }
}

struct StyledEntry {
  mut parent : Option[Style]
  found : MatchedList
  style : Style
}

struct MediaAsked {
  query : Array[Tok]
  result : Bool
}

struct LayerPath {
  path : Array[Int]
  key : String
}

struct HasAttrTest {
  op : String
  value : String
  ci : Bool
}

struct HasUse {
  anchor : Map[String, Bool]
  anchor_any : Bool
  keys : Map[String, Bool]
  mut any : Bool
  mut beside : Bool
  attrs : Map[String, Array[HasAttrTest]]
  mut empty : Bool
  empty_keys : Map[String, Bool]
  mut empty_any : Bool
  mut indexed : Bool
  deep : Bool
  deep_keys : Map[String, Bool]
  mut deep_any : Bool
}

pub struct TargetSet {
  tags : Map[String, Bool]
  classes : Map[String, Bool]
  ids : Map[String, Bool]
  attrs : Map[String, Bool]
  mut state_bits : Int
}

fn TargetSet::new() -> TargetSet {
  TargetSet::{
    tags: Map::new(),
    classes: Map::new(),
    ids: Map::new(),
    attrs: Map::new(),
    state_bits: 0,
  }
}

struct SubjectKey {
  kind : Int
  key : String
}

fn TargetSet::add_all(self : TargetSet, keys : Array[SubjectKey]) -> Unit {
  let mut i = 0
  while i < keys.length() {
    let kk = keys[i]
    if kk.kind == 0 { self.ids.set(kk.key, true) }
    else if kk.kind == 1 { self.classes.set(kk.key, true) }
    else if kk.kind == 2 { self.tags.set(ascii_lower(kk.key), true) }
    else if kk.kind == 3 { self.attrs.set(kk.key, true) }
    else if kk.kind == 5 { self.state_bits = self.state_bits | int_of(kk.key) }
    i = i + 1
  }
}

fn class_matches_set(c : String, classes : Map[String, Bool]) -> Bool {
  let n = c.length()
  let mut i = 0
  while i < n {
    while i < n && is_space_byte(c.code_unit_at(i)) { i = i + 1 }
    let start = i
    while i < n && !is_space_byte(c.code_unit_at(i)) { i = i + 1 }
    if i > start && classes.contains(str_slice(c, start, i)) {
      return true
    }
  }
  false
}

fn TargetSet::matches(self : TargetSet, x : html::Node) -> Bool {
  if self.tags.length() > 0 && self.tags.contains(lower_tag(x.tag)) {
    return true
  }
  if self.ids.length() > 0 {
    match x.attr("id") {
      Some(id) => if self.ids.contains(id) { return true }
      None => ()
    }
  }
  if self.classes.length() > 0 {
    match x.attr("class") {
      Some(c) => if class_matches_set(c, self.classes) { return true }
      None => ()
    }
  }
  if self.attrs.length() > 0 {
    let mut i = 0
    while i < x.attrs.length() {
      if self.attrs.contains(ascii_lower(x.attrs[i].name)) {
        return true
      }
      i = i + 1
    }
  }
  if self.state_bits != 0 && !element_states.is_empty() {
    if (element_states.get_or(x.uid, 0) & self.state_bits) != 0 {
      return true
    }
  }
  false
}

// ----- VarMap -----

pub struct VarMap {
  uid : Int
  mut has0 : Bool
  mut k0 : String
  mut v0 : Option[Array[Tok]]
  mut has1 : Bool
  mut k1 : String
  mut v1 : Option[Array[Tok]]
  mut own : Option[Map[String, Option[Array[Tok]]]]
  parent : Option[VarMap]
  depth : Int
}

fn VarMap::empty() -> VarMap {
  VarMap::{
    uid: next_varmap_uid(),
    has0: false,
    k0: "",
    v0: None,
    has1: false,
    k1: "",
    v1: None,
    own: None,
    parent: None,
    depth: 0,
  }
}

let empty_var_map : VarMap = VarMap::{
  uid: 0,
  has0: false,
  k0: "",
  v0: None,
  has1: false,
  k1: "",
  v1: None,
  own: None,
  parent: None,
  depth: 0,
}

fn VarMap::own_get(self : VarMap, k : String) -> Option[Option[Array[Tok]]] {
  match self.own {
    Some(m) => m.get(k)
    None => {
      if self.has0 && self.k0 == k {
        Some(self.v0)
      } else if self.has1 && self.k1 == k {
        Some(self.v1)
      } else {
        None
      }
    }
  }
}

fn VarMap::own_contains(self : VarMap, k : String) -> Bool {
  match self.own {
    Some(m) => m.contains(k)
    None => (self.has0 && self.k0 == k) || (self.has1 && self.k1 == k)
  }
}

fn VarMap::own_len(self : VarMap) -> Int {
  match self.own {
    Some(m) => m.length()
    None => (if self.has0 { 1 } else { 0 }) + (if self.has1 { 1 } else { 0 })
  }
}

fn VarMap::own_set(self : VarMap, k : String, v : Option[Array[Tok]]) -> Unit {
  match self.own {
    Some(m) => m.set(k, v)
    None => {
      if !self.has0 || self.k0 == k {
        self.has0 = true
        self.k0 = k
        self.v0 = v
      } else if !self.has1 || self.k1 == k {
        self.has1 = true
        self.k1 = k
        self.v1 = v
      } else {
        let m : Map[String, Option[Array[Tok]]] = Map::with_capacity(16)
        m.set(self.k0, self.v0)
        m.set(self.k1, self.v1)
        m.set(k, v)
        self.has0 = false
        self.k0 = ""
        self.v0 = None
        self.has1 = false
        self.k1 = ""
        self.v1 = None
        self.own = Some(m)
      }
    }
  }
}

pub fn VarMap::get(self : VarMap, k : String) -> Option[Array[Tok]] {
  let mut cur : Option[VarMap] = Some(self)
  while true {
    match cur {
      Some(m) => {
        match m.own_get(k) {
          Some(v) => return v
          None => cur = m.parent
        }
      }
      None => break
    }
  }
  None
}

fn VarMap::set(self : VarMap, k : String, v : Array[Tok]) -> Unit {
  self.own_set(k, Some(v))
}

fn VarMap::remove(self : VarMap, k : String) -> Unit {
  match self.parent {
    Some(_) => self.own_set(k, None)
    None => {
      match self.own {
        Some(m) => { let _ = m.remove(k) }
        None => {
          if self.has0 && self.k0 == k {
            if self.has1 {
              self.k0 = self.k1
              self.v0 = self.v1
              self.has1 = false
              self.k1 = ""
              self.v1 = None
            } else {
              self.has0 = false
              self.k0 = ""
              self.v0 = None
            }
          } else if self.has1 && self.k1 == k {
            self.has1 = false
            self.k1 = ""
            self.v1 = None
          }
        }
      }
    }
  }
}

fn VarMap::overlay(parent : VarMap) -> VarMap {
  if parent.depth < 16 {
    VarMap::{
      uid: next_varmap_uid(),
      has0: false,
      k0: "",
      v0: None,
      has1: false,
      k1: "",
      v1: None,
      own: None,
      parent: Some(parent),
      depth: parent.depth + 1,
    }
  } else {
    let flat : Map[String, Option[Array[Tok]]] = Map::new()
    let chain : Array[VarMap] = []
    let mut cur : Option[VarMap] = Some(parent)
    while true {
      match cur {
        Some(m) => { chain.push(m); cur = m.parent }
        None => break
      }
    }
    let mut i = chain.length() - 1
    while i >= 0 {
      let cm = chain[i]
      match cm.own {
        Some(mp) => {
          let ks = mp.keys()
          let mut ki = 0
          while ki < ks.length() {
            let k = ks[ki]
            match mp.get(k) {
              Some(Some(t)) => flat.set(k, Some(t))
              Some(None) => { let _ = flat.remove(k) }
              None => ()
            }
            ki = ki + 1
          }
        }
        None => {
          if cm.has0 {
            match cm.v0 {
              Some(t) => flat.set(cm.k0, Some(t))
              None => { let _ = flat.remove(cm.k0) }
            }
          }
          if cm.has1 {
            match cm.v1 {
              Some(t) => flat.set(cm.k1, Some(t))
              None => { let _ = flat.remove(cm.k1) }
            }
          }
        }
      }
      i = i - 1
    }
    style_counts[4] = style_counts[4] + 1
    style_counts[5] = style_counts[5] + flat.length()
    VarMap::{
      uid: next_varmap_uid(),
      has0: false,
      k0: "",
      v0: None,
      has1: false,
      k1: "",
      v1: None,
      own: if flat.length() > 0 { Some(flat) } else { None },
      parent: None,
      depth: 0,
    }
  }
}

fn opt_toks_same(a : Option[Array[Tok]], b : Option[Array[Tok]]) -> Bool {
  match a {
    None => b.is_none()
    Some(x) => match b { Some(y) => toks_eq(x, y) None => false }
  }
}

fn varmap_check_same_parent(a : VarMap, b : VarMap, pb : VarMap) -> Bool {
  match a.own {
    Some(ma) => {
      let ks1 = ma.keys()
      let mut i = 0
      while i < ks1.length() {
        let k = ks1[i]
        let va = match ma.get(k) { Some(v) => v None => None }
        let vb = match b.own_get(k) { Some(v) => v None => pb.get(k) }
        if !opt_toks_same(va, vb) { return false }
        i = i + 1
      }
    }
    None => {
      if a.has0 {
        let vb = match b.own_get(a.k0) { Some(v) => v None => pb.get(a.k0) }
        if !opt_toks_same(a.v0, vb) { return false }
      }
      if a.has1 {
        let vb = match b.own_get(a.k1) { Some(v) => v None => pb.get(a.k1) }
        if !opt_toks_same(a.v1, vb) { return false }
      }
    }
  }
  match b.own {
    Some(mb) => {
      let ks2 = mb.keys()
      let mut i = 0
      while i < ks2.length() {
        let k = ks2[i]
        if !a.own_contains(k) {
          let vb = match mb.get(k) { Some(v) => v None => None }
          if !opt_toks_same(pb.get(k), vb) { return false }
        }
        i = i + 1
      }
    }
    None => {
      if b.has0 && !a.own_contains(b.k0) {
        if !opt_toks_same(pb.get(b.k0), b.v0) { return false }
      }
      if b.has1 && !a.own_contains(b.k1) {
        if !opt_toks_same(pb.get(b.k1), b.v1) { return false }
      }
    }
  }
  true
}

fn varmap_check_chain(src : VarMap, a : VarMap, b : VarMap, seen : Map[String, Bool]) -> Bool {
  let mut cur : Option[VarMap] = Some(src)
  while true {
    match cur {
      Some(m) => {
        match m.own {
          Some(mp) => {
            let ks = mp.keys()
            let mut i = 0
            while i < ks.length() {
              let k = ks[i]
              if !seen.contains(k) {
                seen.set(k, true)
                if !opt_toks_same(a.get(k), b.get(k)) { return false }
              }
              i = i + 1
            }
          }
          None => {
            if m.has0 && !seen.contains(m.k0) {
              seen.set(m.k0, true)
              if !opt_toks_same(a.get(m.k0), b.get(m.k0)) { return false }
            }
            if m.has1 && !seen.contains(m.k1) {
              seen.set(m.k1, true)
              if !opt_toks_same(a.get(m.k1), b.get(m.k1)) { return false }
            }
          }
        }
        cur = m.parent
      }
      None => break
    }
  }
  true
}

fn VarMap::same(self : VarMap, other : VarMap) -> Bool {
  if self.uid == other.uid {
    return true
  }
  match self.parent {
    Some(pa) => {
      match other.parent {
        Some(pb) => {
          if pa.uid == pb.uid {
            return varmap_check_same_parent(self, other, pb)
          }
        }
        None => ()
      }
    }
    None => {
      if other.parent.is_none() {
        if self.own_len() != other.own_len() { return false }
        match self.own {
          Some(ma) => {
            let ks = ma.keys()
            let mut i = 0
            while i < ks.length() {
              let k = ks[i]
              let va = match ma.get(k) { Some(v) => v None => None }
              match other.own_get(k) {
                Some(vb) => if !opt_toks_same(va, vb) { return false }
                None => return false
              }
              i = i + 1
            }
          }
          None => {
            if self.has0 {
              match other.own_get(self.k0) {
                Some(vb) => if !opt_toks_same(self.v0, vb) { return false }
                None => return false
              }
            }
            if self.has1 {
              match other.own_get(self.k1) {
                Some(vb) => if !opt_toks_same(self.v1, vb) { return false }
                None => return false
              }
            }
          }
        }
        return true
      }
    }
  }
  let seen : Map[String, Bool] = Map::new()
  if !varmap_check_chain(self, self, other, seen) { return false }
  varmap_check_chain(other, self, other, seen)
}

// ----- Style -----

enum HotSlot {
  Unasked
  Absent
  Present(Array[Tok])
}

let hot_count : Int = 128
let no_hot : Array[HotSlot] = []

fn new_hot() -> Array[HotSlot] {
  Array::make(hot_count, Unasked)
}

pub struct Style {
  pub uid : Int
  pub values : Props
  pub vars : VarMap
  pub parent : Option[Style]
  mut own_inherited : Bool
  mut inherit_from : Option[Style]
  mut inh_m0 : Int64
  mut inh_m1 : Int64
  mut inh_m2 : Int64
  mut inh_m3 : Int64
  pub font_size : Double
  pub env : Env
  mut inherited_found : Option[intmap::IntMap[HotSlot]]
  pub root_font : Double
  mut picked : Int
  mut picked_gen : Int
  mut out_of_flow : Int
  mut hot : Array[HotSlot]
  mut kids_gen : Int
  mut kid0_key : String
  mut kid0_val : Option[Style]
  mut kid1_key : String
  mut kid1_val : Option[Style]
  mut kid2_key : String
  mut kid2_val : Option[Style]
  mut kid3_key : String
  mut kid3_val : Option[Style]
  mut kids : Option[Map[String, Style]]
  mut deco : Int
  mut text : Option[Style]
  mut color_cached : Option[Color]
  pub mut cursor_cache : Int
  pub mut flow_flags : Int
  // which of its margins are `auto` (`auto_margins`), -1 until asked
  mut auto_m : Int
  // whether a margin or padding of it holds a percentage (`edges_hold_pct`): -1 until asked, else 0 or 1
  mut edge_pct : Int
  pub mut disp_str : String
  cq_w : Double
  cq_h : Double
  kw_size : Bool
  uses_non_inh_inherit : Bool
  pub anim_cb : Bool
}

fn props_inherited_masks(p : Props) -> (Int64, Int64, Int64, Int64) {
  if p.count == 0 {
    return (0L, 0L, 0L, 0L)
  }
  let mut m0 = 0L
  let mut m1 = 0L
  let mut m2 = 0L
  let mut m3 = 0L
  if p.k0 >= 0 {
    if (id_kind(p.k0) & 0x10000) != 0 {
      let bit = 1L << (p.k0 & 63)
      if (p.k0 & 128) == 0 { if (p.k0 & 64) == 0 { m0 = m0 | bit } else { m1 = m1 | bit } } else if (p.k0 & 64) == 0 { m2 = m2 | bit } else { m3 = m3 | bit }
    }
    if p.k1 >= 0 && (id_kind(p.k1) & 0x10000) != 0 {
      let bit = 1L << (p.k1 & 63)
      if (p.k1 & 128) == 0 { if (p.k1 & 64) == 0 { m0 = m0 | bit } else { m1 = m1 | bit } } else if (p.k1 & 64) == 0 { m2 = m2 | bit } else { m3 = m3 | bit }
    }
    return (m0, m1, m2, m3)
  }
  if p.slots.length() > 0 {
    let mut i = 0
    while i < p.slots.length() {
      if p.slots[i].is_some() && (id_kind(i) & 0x10000) != 0 {
        let bit = 1L << (i & 63)
        if (i & 128) == 0 { if (i & 64) == 0 { m0 = m0 | bit } else { m1 = m1 | bit } } else if (i & 64) == 0 { m2 = m2 | bit } else { m3 = m3 | bit }
      }
      i = i + 1
    }
    (m0, m1, m2, m3)
  } else {
    let mut i = 0
    let n = p.keys.length()
    while i < n {
      let k = p.keys[i]
      if (id_kind(k) & 0x10000) != 0 {
        let bit = 1L << (k & 63)
        if (k & 128) == 0 { if (k & 64) == 0 { m0 = m0 | bit } else { m1 = m1 | bit } } else if (k & 64) == 0 { m2 = m2 | bit } else { m3 = m3 | bit }
      }
      i = i + 1
    }
    (m0, m1, m2, m3)
  }
}

fn inherit_source(parent : Option[Style]) -> Option[Style] {
  match parent {
    Some(p) => if p.own_inherited { Some(p) } else { p.inherit_from }
    None => None
  }
}

let no_toks : Array[Tok] = []

fn hot_slot(name : String) -> Int {
  let l = name.length()
  if l == 3 {
    if name == "top" { 66 } else { -1 }
  } else if l == 4 {
    if name == "left" { 68 } else { -1 }
  } else if l == 5 {
    if name == "float" { 3 }
    else if name == "width" { 7 }
    else if name == "color" { 42 }
    else if name == "scale" { 50 }
    else if name == "right" { 69 }
    else if name == "order" { 86 }
    else { -1 }
  } else if l == 6 {
    if name == "height" { 1 }
    else if name == "rotate" { 49 }
    else if name == "bottom" { 67 }
    else if name == "filter" { 85 }
    else if name == "cursor" { 103 }
    else if name == "widows" { 116 }
    else if name == "quotes" { 123 }
    else { -1 }
  } else if l == 7 {
    if name == "display" { 6 }
    else if name == "contain" { 32 }
    else if name == "z-index" { 41 }
    else if name == "opacity" { 47 }
    else if name == "content" { 70 }
    else if name == "row-gap" { 93 }
    else if name == "hyphens" { 94 }
    else if name == "orphans" { 115 }
    else { -1 }
  } else if l == 8 {
    if name == "position" { 8 }
    else if name == "-fv-lang" { 37 }
    else if name == "tab-size" { 122 }
    else { -1 }
  } else if l == 9 {
    if name == "direction" { 16 }
    else if name == "min-width" { 17 }
    else if name == "max-width" { 18 }
    else if name == "transform" { 31 }
    else if name == "translate" { 48 }
    else if name == "flex-wrap" { 63 }
    else if name == "flex-grow" { 81 }
    else if name == "font-size" { 104 }
    else if name == "word-wrap" { 121 }
    else if name == "text-wrap" { 126 }
    else { -1 }
  } else if l == 10 {
    if name == "line-break" { 12 }
    else if name == "min-height" { 15 }
    else if name == "margin-top" { 20 }
    else if name == "max-height" { 33 }
    else if name == "text-align" { 34 }
    else if name == "font-style" { 35 }
    else if name == "visibility" { 40 }
    else if name == "overflow-x" { 52 }
    else if name == "overflow-y" { 53 }
    else if name == "mask-image" { 59 }
    else if name == "align-self" { 62 }
    else if name == "flex-basis" { 64 }
    else if name == "box-sizing" { 71 }
    else if name == "column-gap" { 91 }
    else if name == "-fv-turned" { 96 }
    else if name == "word-break" { 120 }
    else { -1 }
  } else if l == 11 {
    if name == "line-height" { 0 }
    else if name == "white-space" { 2 }
    else if name == "-fv-central" { 4 }
    else if name == "font-family" { 5 }
    else if name == "margin-left" { 10 }
    else if name == "padding-top" { 25 }
    else if name == "align-items" { 61 }
    else if name == "counter-set" { 73 }
    else if name == "flex-shrink" { 82 }
    else if name == "will-change" { 83 }
    else if name == "perspective" { 84 }
    else if name == "font-weight" { 88 }
    else if name == "text-indent" { 98 }
    else if name == "text-shadow" { 110 }
    else if name == "empty-cells" { 124 }
    else { -1 }
  } else if l == 12 {
    if name == "margin-right" { 9 }
    else if name == "writing-mode" { 14 }
    else if name == "padding-left" { 28 }
    else if name == "word-spacing" { 29 }
    else if name == "aspect-ratio" { 30 }
    else if name == "column-width" { 75 }
    else if name == "column-count" { 76 }
    else if name == "font-kerning" { 89 }
    else if name == "justify-self" { 99 }
    else if name == "font-variant" { 105 }
    else if name == "caption-side" { 108 }
    else if name == "font-stretch" { 117 }
    else { -1 }
  } else if l == 13 {
    if name == "margin-bottom" { 19 }
    else if name == "padding-right" { 26 }
    else if name == "counter-reset" { 72 }
    else if name == "align-content" { 95 }
    else if name == "justify-items" { 100 }
    else if name == "overflow-wrap" { 119 }
    else { -1 }
  } else if l == 14 {
    if name == "text-transform" { 11 }
    else if name == "letter-spacing" { 13 }
    else if name == "padding-bottom" { 27 }
    else if name == "flex-direction" { 65 }
    else if name == "vertical-align" { 97 }
    else if name == "border-spacing" { 107 }
    else if name == "pointer-events" { 109 }
    else { -1 }
  } else if l == 15 {
    if name == "background-clip" { 58 }
    else if name == "justify-content" { 92 }
    else if name == "border-collapse" { 106 }
    else if name == "list-style-type" { 112 }
