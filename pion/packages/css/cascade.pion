  } else if l == 16 {
    if name == "border-top-style" { 23 }
    else if name == "background-color" { 54 }
    else if name == "background-image" { 57 }
    else if name == "border-top-width" { 78 }
    else if name == "text-orientation" { 111 }
    else if name == "list-style-image" { 113 }
    else { -1 }
  } else if l == 17 {
    if name == "border-left-style" { 21 }
    else if name == "font-variant-caps" { 36 }
    else if name == "counter-increment" { 74 }
    else if name == "border-left-width" { 79 }
    else { -1 }
  } else if l == 18 {
    if name == "border-right-style" { 24 }
    else if name == "content-visibility" { 51 }
    else if name == "-webkit-mask-image" { 56 }
    else if name == "border-right-width" { 80 }
    else if name == "grid-template-rows" { 102 }
    else { -1 }
  } else if l == 19 {
    if name == "border-bottom-style" { 22 }
    else if name == "border-bottom-width" { 77 }
    else if name == "list-style-position" { 114 }
    else { -1 }
  } else if l == 20 {
    if name == "font-variant-numeric" { 39 }
    else if name == "text-decoration-line" { 60 }
    else if name == "white-space-collapse" { 127 }
    else { -1 }
  } else if l == 21 {
    if name == "font-feature-settings" { 87 }
    else if name == "grid-template-columns" { 101 }
    else { -1 }
  } else if l == 22 {
    if name == "font-variant-ligatures" { 38 }
    else if name == "border-top-left-radius" { 43 }
    else { -1 }
  } else if l == 23 {
    if name == "border-top-right-radius" { 44 }
    else if name == "-webkit-background-clip" { 55 }
    else if name == "font-variant-alternates" { 90 }
    else if name == "font-variation-settings" { 125 }
    else { -1 }
  } else if l == 25 {
    if name == "border-bottom-left-radius" { 46 } else { -1 }
  } else if l == 26 {
    if name == "border-bottom-right-radius" { 45 } else { -1 }
  } else {
    -1
  }
}

let inherited_list : Array[String] = [
  "color", "cursor", "direction", "font-family", "font-size", "font-stretch", "font-style",
  "font-variant", "font-weight", "letter-spacing", "line-height", "list-style-image",
  "list-style-position", "list-style-type", "quotes", "text-align", "text-indent",
  "text-transform", "visibility", "white-space", "white-space-collapse", "text-wrap", "text-wrap-mode", "text-wrap-style",
  "word-break", "word-spacing", "overflow-wrap", "word-wrap", "border-collapse",
  "border-spacing", "caption-side", "empty-cells", "orphans", "widows", "tab-size",
  "text-decoration-color", "text-shadow", "writing-mode", "hyphens", "-webkit-text-fill-color",
  "font-feature-settings", "font-variant-alternates", "font-variant-ligatures", "font-variant-numeric",
  "font-variant-caps", "font-kerning", "font-variation-settings", "font-optical-sizing", "-fv-lang",
  "line-break", "text-align-last", "text-justify", "font-size-adjust", "font-synthesis", "font-palette",
  "pointer-events", "text-rendering", "text-underline-position", "hanging-punctuation", "ruby-position",
  "paint-order", "color-scheme", "caret-color", "accent-color", "text-emphasis-color", "text-emphasis-style",
  "text-emphasis-position", "image-orientation", "image-rendering", "text-orientation", "text-spacing-trim",
  "text-autospace", "math-depth", "math-style", "dominant-baseline", "fill", "fill-opacity", "fill-rule",
  "stroke", "stroke-width", "stroke-opacity", "stroke-linecap", "stroke-linejoin", "stroke-dasharray",
  "stroke-dashoffset", "stroke-miterlimit", "clip-rule", "-webkit-text-stroke", "-webkit-text-stroke-width", "-webkit-text-stroke-color",
]

let inherited_map_cache : Array[Map[String, Bool]] = []

pub fn is_inherited(prop : String) -> Bool {
  if inherited_map_cache.length() == 0 {
    let m : Map[String, Bool] = Map::new()
    let mut i = 0
    while i < inherited_list.length() {
      m.set(inherited_list[i], true)
      i = i + 1
    }
    inherited_map_cache.push(m)
  }
  inherited_map_cache[0].contains(prop)
}

let id_kinds_arr : Array[Int] = []

fn id_kind(id : Int) -> Int {
  if id < id_kinds_arr.length() {
    return id_kinds_arr[id]
  }
  while id_kinds_arr.length() <= id {
    let k = id_kinds_arr.length()
    let name = prop_names[k]
    let slot = hot_slot(name)
    let bits = (if slot < 0 { 0xFFFF } else { slot }) | (if is_inherited(name) { 0x10000 } else { 0 })
    id_kinds_arr.push(bits)
  }
  id_kinds_arr[id]
}

pub fn Style::decorations(self : Style) -> Int {
  if self.deco >= 0 {
    return self.deco
  }
  let mut own = 0
  let toks = self.get_id(p_text_decoration_line)
  let mut i = 0
  while i < toks.length() {
    match toks[i] {
      Ident(s) => {
        let w = ascii_lower(s)
        if w == "underline" {
          own = own | 1
        } else if w == "line-through" {
          own = own | 2
        } else if w == "overline" {
          own = own | 4
        }
      }
      _ => ()
    }
    i = i + 1
  }
  // CSS Text Decoration 3 §3.1: text decorations are not propagated to
  // out-of-flow descendants (absolute/fixed/float) or atomic inline-level
  // descendants (inline-block, inline-table, inline-flex, inline-grid).
  let mut stop_prop = false
  if self.values.maybe_has_id(p_position) {
    let pos = self.word_id(p_position)
    if pos == "absolute" || pos == "fixed" {
      stop_prop = true
    }
  }
  if !stop_prop && self.values.maybe_has_id(p_float) {
    let fl = self.word_id(p_float)
    if fl != "" && fl != "none" {
      stop_prop = true
    }
  }
  if !stop_prop && self.values.maybe_has_id(p_display) {
    let d = self.word_id(p_display)
    if d == "inline-block" || d == "inline-table" || d == "inline-flex" || d == "inline-grid" {
      stop_prop = true
    }
  }
  let up = if stop_prop {
    0
  } else {
    match self.parent { Some(p) => p.decorations() None => 0 }
  }
  self.deco = own | up
  self.deco
}

struct FlowFlagsMask {
  mut ready : Bool
  mut m0 : Int64
  mut m1 : Int64
  mut m2 : Int64
  mut m3 : Int64
}

let ff_mask : FlowFlagsMask = FlowFlagsMask::{ ready: false, m0: 0L, m1: 0L, m2: 0L, m3: 0L }

fn add_ff_mask(id : Int) -> Unit {
  ff_mask.m0 = ff_mask.m0 | mask_bit_in(id, 0)
  ff_mask.m1 = ff_mask.m1 | mask_bit_in(id, 1)
  ff_mask.m2 = ff_mask.m2 | mask_bit_in(id, 2)
  ff_mask.m3 = ff_mask.m3 | mask_bit_in(id, 3)
}

fn ensure_ff_mask() -> Unit {
  if ff_mask.ready { return }
  add_ff_mask(p_writing_mode)
  add_ff_mask(p_direction)
  add_ff_mask(p_text_align)
  add_ff_mask(p_white_space)
  add_ff_mask(p_text_wrap)
  add_ff_mask(p_text_wrap_mode)
  add_ff_mask(p_word_spacing)
  add_ff_mask(p_letter_spacing)
  add_ff_mask(p_text_transform)
  add_ff_mask(p_line_break)
  add_ff_mask(p_line_height)
  add_ff_mask(p_color_scheme)
  add_ff_mask(p_word_break)
  add_ff_mask(p_overflow_wrap)
  add_ff_mask(p_word_wrap)
  add_ff_mask(p_hyphens)
  add_ff_mask(p_visibility)
  add_ff_mask(p__webkit_text_fill_color)
  ff_mask.ready = true
}

pub fn Style::flow_flags_val(self : Style) -> Int {
  if self.flow_flags >= 0 {
    return self.flow_flags
  }
  if !ff_mask.ready {
    ensure_ff_mask()
  }
  let pv = match self.inherit_from {
    Some(p) => p.flow_flags_val()
    None => 0
  }
  if !self.own_inherited || !self.values.has_any_mask(ff_mask.m0, ff_mask.m1, ff_mask.m2, ff_mask.m3) {
    self.flow_flags = pv
    return pv
  }
  let mut v = pv
  let vals = self.values
  if vals.maybe_has_id(p_writing_mode) {
    let w = self.word_id(p_writing_mode)
    let wm = if w == "vertical-lr" || w == "sideways-lr" { 1 }
    else if w == "vertical-rl" || w == "sideways-rl" || w == "tb-rl" || w == "tb" { 2 }
    else { 0 }
    v = (v & (0x7FFFFFFF ^ 3)) | wm
  }
  if vals.maybe_has_id(p_direction) {
    v = if self.word_id(p_direction) == "rtl" { v | 4 } else { v & (0x7FFFFFFF ^ 4) }
  }
  if vals.maybe_has_id(p_text_align) {
    let ta = self.word_id(p_text_align)
    let wc = if ta == "-webkit-center" { 8 } else { 0 }
    let ta_non_def = if ta != "" && ta != "start" { 64 } else { 0 }
    v = (v & (0x7FFFFFFF ^ (8 | 64))) | wc | ta_non_def
  }
  if vals.maybe_has_id(p_white_space) || vals.maybe_has_id(p_text_wrap) || vals.maybe_has_id(p_text_wrap_mode) {
    let ws = self.word_id(p_white_space)
    let ws_pres = if ws == "pre" || ws == "pre-wrap" || ws == "break-spaces" { 16 } else { 0 }
    let tw = self.word_id(p_text_wrap)
    let twm = if tw == "" { self.word_id(p_text_wrap_mode) } else { tw }
    let ws_nowrap = if ws == "nowrap" || ws == "pre" || twm == "nowrap" { 32 } else { 0 }
    let ws_preline = if ws == "pre-line" { 128 } else { 0 }
    v = (v & (0x7FFFFFFF ^ (16 | 32 | 128))) | ws_pres | ws_nowrap | ws_preline
  }
  if vals.maybe_has_id(p_word_spacing) || vals.maybe_has_id(p_letter_spacing) {
    let has_sp = self.lookup_id(p_word_spacing).is_some() ||
    self.lookup_id(p_letter_spacing).is_some()
    v = if has_sp { v | 256 } else { v & (0x7FFFFFFF ^ 256) }
  }
  if vals.maybe_has_id(p_text_transform) {
    let tt = self.word_id(p_text_transform)
    v = if tt != "" && tt != "none" { v | 512 } else { v & (0x7FFFFFFF ^ 512) }
  }
  if vals.maybe_has_id(p_line_break) {
    v = if self.word_id(p_line_break) == "strict" { v | 1024 } else { v & (0x7FFFFFFF ^ 1024) }
  }
  if vals.maybe_has_id(p_line_height) {
    v = if self.lookup_id(p_line_height).is_some() { v | 2048 } else { v & (0x7FFFFFFF ^ 2048) }
  }
  if vals.maybe_has_id(p_color_scheme) {
    let dark_cs = match self.lookup_id(p_color_scheme) {
      Some(cv) => color_scheme_is_dark(cv)
      None => false
    }
    v = if dark_cs { v | 4096 } else { v & (0x7FFFFFFF ^ 4096) }
  }
  if vals.maybe_has_id(p_word_break) || vals.maybe_has_id(p_overflow_wrap) || vals.maybe_has_id(p_word_wrap) {
    let has_bw = self.word_id(p_word_break) != "" || self.word_id(p_overflow_wrap) != "" || self.word_id(p_word_wrap) != ""
    v = if has_bw { v | 8192 } else { v & (0x7FFFFFFF ^ 8192) }
  }
  if vals.maybe_has_id(p_hyphens) {
    v = if self.word_id(p_hyphens) == "auto" { v | 16384 } else { v & (0x7FFFFFFF ^ 16384) }
  }
  if vals.maybe_has_id(p_visibility) {
    v = if self.word_id(p_visibility) == "hidden" { v | 32768 } else { v & (0x7FFFFFFF ^ 32768) }
  }
  if vals.maybe_has_id(p__webkit_text_fill_color) {
    v = if self.lookup_id(p__webkit_text_fill_color).is_some() { v | 65536 } else { v & (0x7FFFFFFF ^ 65536) }
  }
  self.flow_flags = v
  v
}

fn color_scheme_is_dark(v : Array[Tok]) -> Bool {
  let mut has_dark = false
  let mut has_light = false
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Ident(w) => {
        let lw = ascii_lower(w)
        if lw == "dark" { has_dark = true }
        else if lw == "light" { has_light = true }
      }
      _ => ()
    }
    i = i + 1
  }
  // (`light dark`: whichever the person prefers, `set_media_prefs`)
  has_dark && (!has_light || media_prefs.dark)
}

fn resolve_light_dark_toks(v : Array[Tok], dark : Bool) -> Option[Array[Tok]] {
  let mut found = false
  let mut k = 0
  while k < v.length() {
    match v[k] {
      Function(f) if f.length() == 10 && ascii_lower(f) == "light-dark" => {
        found = true
        break
      }
      _ => ()
    }
    k = k + 1
  }
  if !found {
    return None
  }
  let out : Array[Tok] = []
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Function(f) if f.length() == 10 && ascii_lower(f) == "light-dark" => {
        let mut depth = 0
        let mut comma_idx = -1
        let mut close_idx = -1
        let mut j = i + 1
        while j < v.length() {
          match v[j] {
            Function(_) | OpenParen => { depth = depth + 1 }
            CloseParen => {
              if depth == 0 {
                close_idx = j
                break
              }
              depth = depth - 1
            }
            Comma => {
              if depth == 0 && comma_idx < 0 {
                comma_idx = j
              }
            }
            _ => ()
          }
          j = j + 1
        }
        if comma_idx >= 0 && close_idx > comma_idx {
          let branch = if dark {
            trim(tok_slice(v, comma_idx + 1, close_idx))
          } else {
            trim(tok_slice(v, i + 1, comma_idx))
          }
          let resolved = match resolve_light_dark_toks(branch, dark) {
            Some(r) => r
            None => branch
          }
          tok_append(out, resolved)
          i = close_idx + 1
        } else {
          out.push(v[i])
          i = i + 1
        }
      }
      _ => {
        out.push(v[i])
        i = i + 1
      }
    }
  }
  Some(out)
}

fn is_cb_creating_prop(name : String) -> Bool {
  name == "transform" || name == "translate" || name == "rotate" || name == "scale" ||
  name == "perspective" || name == "filter" || name == "backdrop-filter" ||
  name == "-webkit-backdrop-filter"
}

fn value_is_none(v : Array[Tok]) -> Bool {
  let tv = trim(v)
  if tv.length() == 0 { return true }
  if tv.length() == 1 {
    match tv[0] {
      Ident(w) => return ascii_lower(w) == "none"
      _ => ()
    }
  }
  false
}

fn keyframes_creates_cb(frames : Array[Keyframe]) -> Bool {
  let mut i = 0
  while i < frames.length() {
    let decls = frames[i].decls
    let mut j = 0
    while j < decls.length() {
      let d = decls[j]
      if is_cb_creating_prop(d.name) && !value_is_none(d.value) {
        return true
      }
      j = j + 1
    }
    i = i + 1
  }
  false
}

fn animation_creates_cb(e : Engine, values : Props) -> Bool {
  if e.keyframes_map.length() == 0 || !values.maybe_has_id(p_animation_name) {
    return false
  }
  let names = match values.get_id(p_animation_name) {
    Some(v) => v
    None => return false
  }
  let mut active = false
  match values.get("animation-duration") {
    Some(dv) => {
      let mut di = 0
      while di < dv.length() {
        match dv[di] {
          Dimension(x, _) if x > 0.0 => {
            active = true
            break
          }
          _ => ()
        }
        di = di + 1
      }
    }
    None => ()
  }
  if !active {
    match values.get("animation-fill-mode") {
      Some(fv) => {
        let mut fi = 0
        while fi < fv.length() {
          match fv[fi] {
            Ident(w) => {
              let lw = ascii_lower(w)
              if lw == "forwards" || lw == "both" || lw == "backwards" {
                active = true
                break
              }
            }
            _ => ()
          }
          fi = fi + 1
        }
      }
      None => ()
    }
  }
  if !active {
    return false
  }
  let mut i = 0
  while i < names.length() {
    let nm = match names[i] {
      Ident(w) => if ascii_lower(w) != "none" { w } else { "" }
      Str(w) => w
      _ => ""
    }
    if nm.length() > 0 {
      match e.keyframes_map.get(nm) {
        Some(frames) => if keyframes_creates_cb(frames) { return true }
        None => ()
      }
    }
    i = i + 1
  }
  false
}

fn resolve_light_dark_props(values : Props, dark : Bool) -> Unit {
  let updates : Array[(Int, Array[Tok])] = []
  values.each_id(fn(id : Int, v : Array[Tok]) -> Unit {
    match resolve_light_dark_toks(v, dark) {
      Some(nv) => updates.push((id, nv))
      None => ()
    }
  })
  let mut i = 0
  while i < updates.length() {
    values.set_id(updates[i].0, updates[i].1)
    i = i + 1
  }
}

pub fn Style::display_str(self : Style) -> String {
  if self.disp_str.length() > 0 { return self.disp_str }
  self.word_id(p_display)
}

let empty_props : Props = Props::new()

pub fn Style::anonymous(self : Style) -> Style {
  Style::{
    uid: next_style_uid(),
    values: empty_props,
    vars: self.vars,
    parent: Some(self),
    own_inherited: false,
    inherit_from: if self.own_inherited { Some(self) } else { self.inherit_from },
    inh_m0: self.inh_m0,
    inh_m1: self.inh_m1,
    inh_m2: self.inh_m2,
    inh_m3: self.inh_m3,
    font_size: self.font_size,
    env: self.env,
    inherited_found: None,
    root_font: self.root_font,
    picked: -1,
    picked_gen: 0,
    out_of_flow: 0,
    hot: no_hot,
    kids_gen: -1,
    kid0_key: "",
    kid0_val: None,
    kid1_key: "",
    kid1_val: None,
    kid2_key: "",
    kid2_val: None,
    kid3_key: "",
    kid3_val: None,
    kids: None,
    deco: -1,
    text: None,
    color_cached: self.color_cached,
    cursor_cache: self.cursor_cache,
    flow_flags: self.flow_flags,
    auto_m: -1,
    edge_pct: -1,
    disp_str: "",
    cq_w: self.cq_w,
    cq_h: self.cq_h,
    kw_size: self.kw_size,
    uses_non_inh_inherit: self.uses_non_inh_inherit,
    anim_cb: false,
  }
}

pub fn Style::anonymous_mut(self : Style) -> Style {
  Style::{
    uid: next_style_uid(),
    values: Props::new(),
    vars: self.vars,
    parent: Some(self),
    own_inherited: false,
    inherit_from: if self.own_inherited { Some(self) } else { self.inherit_from },
    inh_m0: self.inh_m0,
    inh_m1: self.inh_m1,
    inh_m2: self.inh_m2,
    inh_m3: self.inh_m3,
    font_size: self.font_size,
    env: self.env,
    inherited_found: None,
    root_font: self.root_font,
    picked: -1,
    picked_gen: 0,
    out_of_flow: 0,
    hot: new_hot(),
    kids_gen: -1,
    kid0_key: "",
    kid0_val: None,
    kid1_key: "",
    kid1_val: None,
    kid2_key: "",
    kid2_val: None,
    kid3_key: "",
    kid3_val: None,
    kids: None,
    deco: -1,
    text: None,
    color_cached: None,
    cursor_cache: -2,
    flow_flags: -1,
    auto_m: -1,
    edge_pct: -1,
    disp_str: "",
    cq_w: self.cq_w,
    cq_h: self.cq_h,
    kw_size: self.kw_size,
    uses_non_inh_inherit: self.uses_non_inh_inherit,
    anim_cb: false,
  }
}

pub fn Style::text_style(self : Style) -> Style {
  match self.text {
    Some(t) => t
    None => {
      let t = self.anonymous()
      self.text = Some(t)
      t
    }
  }
}

pub fn Style::lookup_id(self : Style, id : Int) -> Option[Array[Tok]] {
  if id < 0 {
    return None
  }
  let vals = self.values
  let bit = 1L << (id & 63)
  let own_m = if (id & 128) == 0 { if (id & 64) == 0 { vals.mask0 } else { vals.mask1 } } else if (id & 64) == 0 { vals.mask2 } else { vals.mask3 }
  if (own_m & bit) != 0L {
    if vals.k0 >= 0 {
      if vals.k0 == id { return Some(vals.v0) }
      if vals.k1 == id { return Some(vals.v1) }
    } else if vals.slots.length() > 0 {
      if id < vals.slots.length() {
        match vals.slots[id] {
          Some(v) => return Some(v)
          None => ()
        }
      }
    } else {
      let mut i = 0
      let n = vals.keys.length()
      while i < n {
        if vals.keys[i] == id {
          return Some(vals.vals[i])
        }
        i = i + 1
      }
    }
  }
  let inh_m = if (id & 128) == 0 { if (id & 64) == 0 { self.inh_m0 } else { self.inh_m1 } } else if (id & 64) == 0 { self.inh_m2 } else { self.inh_m3 }
  if (inh_m & bit) == 0L {
    return None
  }
  let kind = id_kind(id)
  if (kind & 0x10000) == 0 {
    return None
  }
  self.lookup_inh_id_kind(id, kind, bit)
}

fn Style::lookup_inh_id_kind(self : Style, id : Int, kind : Int, bit : Int64) -> Option[Array[Tok]] {
  let slot = kind & 0xFFFF
  if slot != 0xFFFF && self.hot.length() > 0 {
    match self.hot[slot] {
      Unasked => {
        let found = match self.inherit_from {
          Some(p) => p.lookup_id_kind(id, kind)
          None => None
        }
        self.hot[slot] = match found { Some(v) => Present(v) None => Absent }
        return found
      }
      Absent => return None
      Present(v) => return Some(v)
    }
  }
  let mut cur_opt = self.inherit_from
  while true {
    match cur_opt {
      None => return None
      Some(cur) => {
        let cur_inh = if (id & 128) == 0 { if (id & 64) == 0 { cur.inh_m0 } else { cur.inh_m1 } } else if (id & 64) == 0 { cur.inh_m2 } else { cur.inh_m3 }
        if (cur_inh & bit) == 0L {
          return None
        }
        if !cur.own_inherited {
          cur_opt = cur.inherit_from
          continue
        }
        let cvals = cur.values
        let cown = if (id & 128) == 0 { if (id & 64) == 0 { cvals.mask0 } else { cvals.mask1 } } else if (id & 64) == 0 { cvals.mask2 } else { cvals.mask3 }
        if (cown & bit) != 0L {
          if cvals.k0 >= 0 {
            if cvals.k0 == id { return Some(cvals.v0) }
            if cvals.k1 == id { return Some(cvals.v1) }
          } else if cvals.slots.length() > 0 {
            if id < cvals.slots.length() {
              match cvals.slots[id] {
                Some(v) => return Some(v)
                None => ()
              }
            }
          } else {
            let mut i = 0
            let n = cvals.keys.length()
            while i < n {
              if cvals.keys[i] == id {
                return Some(cvals.vals[i])
              }
              i = i + 1
            }
          }
        }
        if slot != 0xFFFF && cur.hot.length() > 0 {
          match cur.hot[slot] {
            Unasked => {
              let found = cur.lookup_now_id(id, kind)
              cur.hot[slot] = match found { Some(v) => Present(v) None => Absent }
              return found
            }
            Absent => return None
            Present(v) => return Some(v)
          }
        }
        cur_opt = cur.inherit_from
      }
    }
  }
  None
}

fn Style::lookup_id_kind(self : Style, id : Int, kind : Int) -> Option[Array[Tok]] {
  if id < 0 {
    return None
  }
  let bit = 1L << (id & 63)
  if (kind & 0x10000) == 0 {
    let vals = self.values
    let own_m = if (id & 128) == 0 { if (id & 64) == 0 { vals.mask0 } else { vals.mask1 } } else if (id & 64) == 0 { vals.mask2 } else { vals.mask3 }
    if (own_m & bit) == 0L {
      return None
    }
    if vals.k0 >= 0 {
      if vals.k0 == id { return Some(vals.v0) }
      if vals.k1 == id { return Some(vals.v1) }
      return None
    }
    if vals.slots.length() > 0 {
      return if id < vals.slots.length() { vals.slots[id] } else { None }
    }
    let mut i = 0
    let n = vals.keys.length()
    while i < n {
      if vals.keys[i] == id {
        return Some(vals.vals[i])
      }
      i = i + 1
    }
    return None
  }
  let mut cur = self
  let slot = kind & 0xFFFF
  while true {
    let cur_inh = if (id & 128) == 0 { if (id & 64) == 0 { cur.inh_m0 } else { cur.inh_m1 } } else if (id & 64) == 0 { cur.inh_m2 } else { cur.inh_m3 }
    if (cur_inh & bit) == 0L {
      return None
    }
    if !cur.own_inherited {
      match cur.inherit_from {
        Some(p) => { cur = p; continue }
        None => return None
      }
    }
    let vals = cur.values
    if vals.k0 >= 0 {
      if vals.k0 == id { return Some(vals.v0) }
      if vals.k1 == id { return Some(vals.v1) }
      match cur.inherit_from {
        Some(p) => { cur = p; continue }
        None => return None
      }
    }
    if cur.hot.length() == 0 {
      match cur.inherit_from {
        Some(p) => { cur = p; continue }
        None => return None
      }
    }
    if slot != 0xFFFF {
      match cur.hot[slot] {
        Unasked => {
          let found = cur.lookup_now_id(id, kind)
          cur.hot[slot] = match found { Some(v) => Present(v) None => Absent }
          return found
        }
        Absent => return None
        Present(v) => return Some(v)
      }
    }
    return cur.lookup_now_id(id, kind)
  }
  None
}

fn Style::lookup_now_id(self : Style, id : Int, kind : Int) -> Option[Array[Tok]] {
  match self.values.get_id(id) {
    Some(v) => Some(v)
    None => {
      if (kind & 0x10000) != 0 {
        if (kind & 0xFFFF) != 0xFFFF || !self.own_inherited {
          return match self.inherit_from {
            Some(p) => p.lookup_id_kind(id, kind)
            None => None
          }
        }
        match self.inherited_found {
          Some(m) => {
            match intmap::get(m, id) {
              Some(Present(v)) => return Some(v)
              Some(_) => return None
              None => ()
            }
            let v = match self.inherit_from {
              Some(p) => p.lookup_id_kind(id, kind)
              None => None
            }
            m.set(id, match v { Some(x) => Present(x) None => Absent })
            v
          }
          None => {
            match self.inherit_from {
              Some(p) => {
                let v = p.lookup_id_kind(id, kind)
                let m : intmap::IntMap[HotSlot] = intmap::IntMap::with_capacity(16)
                m.set(id, match v { Some(x) => Present(x) None => Absent })
                self.inherited_found = Some(m)
                v
              }
              None => None
            }
          }
        }
      } else {
        None
      }
    }
  }
}

pub fn Style::own_id(self : Style, id : Int) -> Array[Tok] {
  match self.values.get_id(id) { Some(v) => v None => no_toks }
}

pub fn Style::get_id(self : Style, id : Int) -> Array[Tok] {
  if id < 0 {
    return no_toks
  }
  let vals = self.values
  let bit = 1L << (id & 63)
  let own_m = if (id & 128) == 0 { if (id & 64) == 0 { vals.mask0 } else { vals.mask1 } } else if (id & 64) == 0 { vals.mask2 } else { vals.mask3 }
  let inh_m = if (id & 128) == 0 { if (id & 64) == 0 { self.inh_m0 } else { self.inh_m1 } } else if (id & 64) == 0 { self.inh_m2 } else { self.inh_m3 }
  if ((own_m | inh_m) & bit) == 0L {
    return no_toks
  }
  if (own_m & bit) != 0L {
    if vals.k0 >= 0 {
      if vals.k0 == id { return vals.v0 }
      if vals.k1 == id { return vals.v1 }
    } else if vals.slots.length() > 0 {
      if id < vals.slots.length() {
        match vals.slots[id] {
          Some(v) => return v
          None => ()
        }
      }
    } else {
      let mut i = 0
      let n = vals.keys.length()
      while i < n {
        if vals.keys[i] == id {
          return vals.vals[i]
        }
        i = i + 1
      }
    }
  }
  if (inh_m & bit) == 0L {
    return no_toks
  }
  let kind = id_kind(id)
  if (kind & 0x10000) == 0 {
    return no_toks
  }
  match self.lookup_inh_id_kind(id, kind, bit) { Some(v) => v None => no_toks }
}

pub fn Style::set_override_id(self : Style, id : Int, v : Array[Tok]) -> Unit {
  self.values.set_id(id, v)
  let kind = id_kind(id)
  if (kind & 0x10000) != 0 {
    self.own_inherited = true
    let bit = 1L << (id & 63)
    let w = (id >> 6) & 3
    if w == 0 {
      self.inh_m0 = self.inh_m0 | bit
    } else if w == 1 {
      self.inh_m1 = self.inh_m1 | bit
    } else if w == 2 {
      self.inh_m2 = self.inh_m2 | bit
    } else {
      self.inh_m3 = self.inh_m3 | bit
    }
  }
  self.flow_flags = -1
  self.auto_m = -1
  self.edge_pct = -1
  if self.values.k0 < 0 && self.hot.length() == 0 {
    self.hot = new_hot()
  }
  let slot = kind & 0xFFFF
  if slot != 0xFFFF && self.hot.length() > slot {
    self.hot[slot] = Present(v)
  }
}

// Whether the style may hold a value for the property (its own or one it inherits), as get_id's first test says:
// when it holds none, the readers below answer as for no tokens without taking get_id's empty array (whose reference
// count each of them would raise and drop again).
fn Style::may_hold_id(self : Style, id : Int) -> Bool {
  // (kept within what is inlined into word_id and the other readers: ids 0..127 here, the rest out of line; a
  // negative id may answer true, as get_id answers none for it)
  if id >= 128 { return self.may_hold_id_hi(id) }
  let bit = 1L << (id & 63)
  let m = if (id & 64) == 0 { self.values.mask0 | self.inh_m0 } else { self.values.mask1 | self.inh_m1 }
  (m & bit) != 0L
}

fn Style::may_hold_id_hi(self : Style, id : Int) -> Bool {
  let bit = 1L << (id & 63)
  let w = (id >> 6) & 3
  let m = if w == 0 {
    self.values.mask0 | self.inh_m0
  } else if w == 1 {
    self.values.mask1 | self.inh_m1
  } else if w == 2 {
    self.values.mask2 | self.inh_m2
  } else {
    self.values.mask3 | self.inh_m3
  }
  (m & bit) != 0L
}

pub fn Style::word_id(self : Style, id : Int) -> String {
  if !self.may_hold_id(id) { return "" }
  let v = self.get_id(id)
  if v.length() > 0 {
    match v[0] { Ident(w) => ascii_lower(w) _ => "" }
  } else { "" }
}

///| Which of its margins are `auto`, as `word_id` reads them (1 top, 2 right, 4 bottom, 8 left): worked out once
/// for the style (margins are not inherited), as layout asks for them many times for each box (a flex item's auto
/// margins take its free space, and keep it from being stretched).
pub fn Style::auto_margins(self : Style) -> Int {
  if self.auto_m >= 0 { return self.auto_m }
  let v = (if self.word_id(p_margin_top) == "auto" { 1 } else { 0 }) |
  (if self.word_id(p_margin_right) == "auto" { 2 } else { 0 }) |
  (if self.word_id(p_margin_bottom) == "auto" { 4 } else { 0 }) |
  (if self.word_id(p_margin_left) == "auto" { 8 } else { 0 })
  self.auto_m = v
  v
}

fn toks_hold_pct(toks : Array[Tok]) -> Bool {
  let mut i = 0
  while i < toks.length() {
    if toks[i] is Percentage(_) { return true }
    i += 1
  }
  false
}

///| Whether a margin or padding of it holds a percentage token (resolved against its containing block's width), as
/// layout asks of each box it would take from an earlier layout: worked out once for the style (none of them is
/// inherited).
pub fn Style::edges_hold_pct(self : Style) -> Bool {
  if self.edge_pct >= 0 { return self.edge_pct == 1 }
  let v = toks_hold_pct(self.get_id(p_margin_top)) ||
  toks_hold_pct(self.get_id(p_margin_right)) ||
  toks_hold_pct(self.get_id(p_margin_bottom)) ||
  toks_hold_pct(self.get_id(p_margin_left)) ||
  toks_hold_pct(self.get_id(p_padding_top)) ||
  toks_hold_pct(self.get_id(p_padding_right)) ||
  toks_hold_pct(self.get_id(p_padding_bottom)) ||
  toks_hold_pct(self.get_id(p_padding_left))
  self.edge_pct = if v { 1 } else { 0 }
  v
}

pub fn Style::number_id(self : Style, id : Int, default : Double) -> Double {
  if !self.may_hold_id(id) { return default }
  let v = self.get_id(id)
  for tok in v {
    match tok {
      Space => continue
      Number(n) => return n
      _ => return default
    }
  }
  default
}

pub fn Style::length_id(self : Style, id : Int) -> Option[Length] {
  if !self.may_hold_id(id) { return None }
  let toks = self.get_id(id)
  if toks.length() == 0 { return None }
  if toks_has_ch(toks) { css_globals.cur_family = self.get_id(p_font_family) }
  if self.cq_w > 0.0 || self.cq_h > 0.0 {
    let prev = css_globals.cur_cq
    css_globals.cur_cq = Some((self.cq_w, self.cq_h))
    let r = eval_length(toks, self.font_size, self.root_size(), self.env)
    css_globals.cur_cq = prev
    return r
  }
  eval_length(toks, self.font_size, self.root_size(), self.env)
}

pub fn Style::length_against_id(self : Style, id : Int, base : Option[Double]) -> Option[Length] {
  if !self.may_hold_id(id) { return None }
  let toks = self.get_id(id)
  if toks.length() == 0 { return None }
  css_globals.calc_base = base
  if toks_has_ch(toks) { css_globals.cur_family = self.get_id(p_font_family) }
  let r = if self.cq_w > 0.0 || self.cq_h > 0.0 {
    let prev = css_globals.cur_cq
    css_globals.cur_cq = Some((self.cq_w, self.cq_h))
    let res = eval_length(toks, self.font_size, self.root_size(), self.env)
    css_globals.cur_cq = prev
    res
  } else {
    eval_length(toks, self.font_size, self.root_size(), self.env)
  }
  css_globals.calc_base = None
  r
}

fn Style::lookup(self : Style, name : String) -> Option[Array[Tok]] {
  if self.hot.length() == 0 {
    return match prop_id_of(name) {
      Some(id) => self.lookup_id(id)
      None => None
    }
  }
  let slot = hot_slot(name)
  if slot >= 0 {
    match self.hot[slot] {
      Unasked => {
        let found = self.lookup_now(name)
        self.hot[slot] = match found { Some(v) => Present(v) None => Absent }
        return found
      }
      Absent => return None
      Present(v) => return Some(v)
    }
  }
  self.lookup_now(name)
}

fn Style::lookup_now(self : Style, name : String) -> Option[Array[Tok]] {
  match prop_id_of(name) {
    Some(id) => self.lookup_now_id(id, id_kind(id))
    None => None
  }
}

pub fn Style::kept_pick(self : Style, gen : Int) -> Option[Int] {
  if self.picked >= 0 && self.picked_gen == gen { Some(self.picked) } else { None }
}

pub fn Style::keep_pick(self : Style, id : Int, gen : Int) -> Unit {
  self.picked = id
  self.picked_gen = gen
}

pub fn Style::get(self : Style, name : String) -> Array[Tok] {
  match self.lookup(name) { Some(v) => v None => no_toks }
}

pub fn Style::word(self : Style, name : String) -> String {
  match self.lookup(name) {
    Some(v) => {
      if v.length() > 0 {
        match v[0] { Ident(w) => ascii_lower(w) _ => "" }
      } else { "" }
    }
    None => ""
  }
}

pub fn Style::pos_kind(self : Style) -> Int {
  let f = self.out_of_flow
  if (f & 8) != 0 { return f & 7 }
  let k = if !self.values.maybe_has_id(p_position) {
    0
  } else {
    let p = self.word_id(p_position)
    if p == "relative" { 1 }
    else if p == "sticky" { 2 }
    else if p == "absolute" { 3 }
    else if p == "fixed" { 4 }
    else { 0 }
  }
  self.out_of_flow = (f & 48) | 8 | k
  k
}

pub fn Style::is_out_of_flow(self : Style) -> Bool {
  self.pos_kind() >= 3
}

pub fn Style::is_border_box(self : Style) -> Bool {
  let f = self.out_of_flow
  if (f & 16) != 0 { return (f & 32) != 0 }
  let bb = self.values.maybe_has_id(p_box_sizing) && self.word_id(p_box_sizing) == "border-box"
  self.out_of_flow = (f & 15) | 16 | (if bb { 32 } else { 0 })
  bb
}

fn Style::root_size(self : Style) -> Double {
  self.root_font
}

fn Style::root_style(self : Style) -> Style {
  let mut s = self
  while true {
    match s.parent {
      Some(p) => s = p
      None => break
    }
  }
  s
}

fn lh_px(v : Option[Array[Tok]], fs : Double, root : Double, env : Env, family : Array[Tok]) -> Double {
  match v {
    Some(toks) => {
      if toks.length() == 1 {
        match toks[0] {
          Number(n) => return n * fs
          Percentage(p) => return p * fs / 100.0
          Dimension(n, u) => {
            return match unit_px(n, ascii_lower(u), fs, root, env) {
              Some(px) => px
              None => (css_globals.normal_lh_hook)(family, fs)
            }
          }
          _ => ()
        }
      }
      if toks.length() > 0 {
        match toks[0] {
          Function(_) => {
            match eval_length(toks, fs, root, env) {
              Some(l) => if l.pct == 0.0 { return l.px }
              None => ()
            }
          }
          _ => ()
        }
      }
      (css_globals.normal_lh_hook)(family, fs)
    }
    None => (css_globals.normal_lh_hook)(family, fs)
  }
}

fn Style::line_height_px(self : Style) -> Double {
  lh_px(self.lookup("line-height"), self.font_size, self.root_size(), self.env, self.get("font-family"))
}

pub fn Style::length(self : Style, name : String) -> Option[Length] {
  let toks = self.get(name)
  if toks_has_ch(toks) { css_globals.cur_family = self.get_id(p_font_family) }
  if self.cq_w > 0.0 || self.cq_h > 0.0 {
    let prev = css_globals.cur_cq
    css_globals.cur_cq = Some((self.cq_w, self.cq_h))
    let r = eval_length(toks, self.font_size, self.root_size(), self.env)
    css_globals.cur_cq = prev
    return r
  }
  eval_length(toks, self.font_size, self.root_size(), self.env)
}

pub fn Style::length_of(self : Style, v : Array[Tok]) -> Option[Length] {
  if toks_has_ch(v) { css_globals.cur_family = self.get_id(p_font_family) }
  if self.cq_w > 0.0 || self.cq_h > 0.0 {
    let prev = css_globals.cur_cq
    css_globals.cur_cq = Some((self.cq_w, self.cq_h))
    let r = eval_length(v, self.font_size, self.root_size(), self.env)
    css_globals.cur_cq = prev
    return r
  }
  eval_length(v, self.font_size, self.root_size(), self.env)
}

pub fn Style::length_of_against(self : Style, v : Array[Tok], base : Option[Double]) -> Option[Length] {
  let prev = css_globals.calc_base
  css_globals.calc_base = base
  let r = self.length_of(v)
  css_globals.calc_base = prev
  r
}

pub fn Style::length_against(self : Style, name : String, base : Option[Double]) -> Option[Length] {
  css_globals.calc_base = base
  let r = self.length(name)
  css_globals.calc_base = None
  r
}

pub fn Style::number(self : Style, name : String, default : Double) -> Double {
  let v = self.get(name)
  if v.length() > 0 {
    match v[0] { Number(n) => n _ => default }
  } else {
    default
  }
}

pub fn Style::color_id(self : Style, id : Int) -> Option[Color] {
  if id == p_color {
    match self.color_cached {
      Some(c) => return Some(c)
      None => ()
    }
  }
  let toks = self.get_id(id)
  if toks.length() == 0 {
    if id == p_color {
      let res = match self.parent {
        Some(p) => p.color_id(p_color)
        None => Some(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
      }
      self.color_cached = res
      return res
    }
    return None
  }
  let parsed = if toks.length() > 1 && tokens_have_currentcolor(toks) {
    let cur = if id == p_color {
      match self.parent {
        Some(p) => p.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
        None => Color::{ r: 0, g: 0, b: 0, a: 1.0 }
      }
    } else {
      self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
    }
    parse_color_with_current(toks, Some(cur))
  } else {
    parse_color(toks, 0)
  }
  let res = match parsed {
    Some(c) => {
      if c.r == -1 {
        if id == p_color {
          match self.parent {
            Some(p) => p.color_id(p_color)
            None => Some(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
          }
        } else {
          self.color_id(p_color)
        }
      } else {
        Some(c)
      }
    }
    None => {
      if id == p_color {
        match self.parent {
          Some(p) => p.color_id(p_color)
          None => Some(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
        }
      } else {
        None
      }
    }
  }
  if id == p_color {
    self.color_cached = res
  }
  res
}

pub fn Style::color(self : Style, name : String) -> Option[Color] {
  match prop_id_of(name) {
    Some(id) => self.color_id(id)
    None => None
  }
}

pub fn Style::url_id(self : Style, id : Int) -> Option[String] {
  let v = self.get_id(id)
  if v.length() == 0 { return None }
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Url(u) => return Some(u)
      Function(f) => {
        if ascii_lower(f) == "url" {
          let mut j = i + 1
          while j < v.length() {
            match v[j] {
              Str(u) => return Some(u)
              CloseParen => break
              _ => ()
            }
            j = j + 1
          }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  None
}

pub fn Style::url(self : Style, name : String) -> Option[String] {
  match prop_id_of(name) {
    Some(id) => self.url_id(id)
    None => None
  }
}

pub fn Style::urls(self : Style, name : String) -> Array[String] {
  self.urls_id(prop_id(name))
}

pub fn Style::urls_id(self : Style, id : Int) -> Array[String] {
  let v = self.get_id(id)
  if v.length() == 0 { return [] }
  let out : Array[String] = []
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Url(u) => out.push(u)
      Function(f) => {
        if ascii_lower(f) == "url" {
          let mut j = i + 1
          while j < v.length() {
            match v[j] {
              Str(u) => { out.push(u); break }
              CloseParen => break
              _ => ()
            }
            j = j + 1
          }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  out
}

pub fn Style::parent_style(self : Style) -> Option[Style] {
  self.parent
}

pub fn Style::own_keys(self : Style) -> Array[String] {
  self.values.keys()
}

pub fn Style::with_value(self : Style, prop : String, v : Array[Tok]) -> Style {
  let values = self.values.copy()
  let pid = prop_id(prop)
  values.set_id(pid, v)
  let is_inh = (id_kind(pid) & 0x10000) != 0
  let inh_m0 = if is_inh { self.inh_m0 | mask_bit_in(pid, 0) } else { self.inh_m0 }
  let inh_m1 = if is_inh { self.inh_m1 | mask_bit_in(pid, 1) } else { self.inh_m1 }
  let inh_m2 = if is_inh { self.inh_m2 | mask_bit_in(pid, 2) } else { self.inh_m2 }
  let inh_m3 = if is_inh { self.inh_m3 | mask_bit_in(pid, 3) } else { self.inh_m3 }
  Style::{
    uid: next_style_uid(),
    values: values,
    vars: self.vars,
    parent: self.parent,
    own_inherited: self.own_inherited || is_inh,
    inherit_from: self.inherit_from,
    inh_m0: inh_m0,
    inh_m1: inh_m1,
    inh_m2: inh_m2,
    inh_m3: inh_m3,
    font_size: self.font_size,
    env: self.env,
    inherited_found: None,
    root_font: self.root_font,
    picked: -1,
    picked_gen: 0,
    out_of_flow: 0,
    hot: new_hot(),
    kids_gen: -1,
    kid0_key: "",
    kid0_val: None,
    kid1_key: "",
    kid1_val: None,
    kid2_key: "",
    kid2_val: None,
    kid3_key: "",
    kid3_val: None,
    kids: None,
    deco: -1,
    text: None,
    color_cached: None,
    cursor_cache: -2,
    flow_flags: -1,
    auto_m: -1,
    edge_pct: -1,
    disp_str: "",
    cq_w: self.cq_w,
    cq_h: self.cq_h,
    kw_size: self.kw_size,
    uses_non_inh_inherit: self.uses_non_inh_inherit,
    anim_cb: self.anim_cb,
  }
}

pub fn Style::of_family(family : Array[Tok], size : Double) -> Style {
  Style::{
    uid: next_style_uid(),
    values: Props::of([("font-family", family)]),
    vars: VarMap::empty(),
    parent: None,
    own_inherited: true,
    inherit_from: None,
    inh_m0: mask_bit_in(p_font_family, 0),
    inh_m1: mask_bit_in(p_font_family, 1),
    inh_m2: mask_bit_in(p_font_family, 2),
    inh_m3: mask_bit_in(p_font_family, 3),
    font_size: size,
    env: Env::new(0.0, 0.0),
    inherited_found: None,
    root_font: size,
    picked: -1,
    picked_gen: 0,
    out_of_flow: 0,
    hot: new_hot(),
    kids_gen: -1,
    kid0_key: "",
    kid0_val: None,
    kid1_key: "",
    kid1_val: None,
    kid2_key: "",
    kid2_val: None,
    kid3_key: "",
    kid3_val: None,
    kids: None,
    deco: -1,
    text: None,
    color_cached: None,
    cursor_cache: -2,
    flow_flags: -1,
    auto_m: -1,
    edge_pct: -1,
    disp_str: "",
    cq_w: 0.0,
    cq_h: 0.0,
    kw_size: false,
    uses_non_inh_inherit: false,
    anim_cb: false,
  }
}

pub fn Style::transposed(self : Style, rl : Bool) -> Style {
  let values = self.values.copy()
  let turned : Array[(String, String)] = [
    ("width", "height"), ("height", "width"),
    ("min-width", "min-height"), ("min-height", "min-width"),
    ("max-width", "max-height"), ("max-height", "max-width"),
    ("overflow-x", "overflow-y"), ("overflow-y", "overflow-x"),
  ]
  let ss = if rl { ["right", "bottom", "left", "top"] } else { ["left", "bottom", "right", "top"] }
  let orig = ["top", "right", "bottom", "left"]
  let pres = [("margin-", ""), ("padding-", ""), ("border-", "-width"), ("border-", "-style"), ("border-", "-color"), ("", "")]
  let mut pi = 0
  while pi < pres.length() {
    let mut si = 0
    while si < 4 {
      turned.push((pres[pi].0 + orig[si] + pres[pi].1, pres[pi].0 + ss[si] + pres[pi].1))
      si = si + 1
    }
    pi = pi + 1
  }
  let mut ti = 0
  while ti < turned.length() {
    let name = turned[ti].0
    let from = turned[ti].1
    let v = if self.values.contains("-fv-logical-" + name) {
      self.values.get(name)
    } else if self.values.contains("-fv-logical-" + from) {
      None
    } else {
      self.values.get(from)
    }
    match v {
      Some(x) => values.set(name, x)
      None => values.remove(name)
    }
    ti = ti + 1
  }
  let sideways = str_has_prefix(self.word("writing-mode"), "sideways") || self.word("text-orientation") == "sideways"
  if !sideways { values.set("-fv-central", [Ident("1")]) } else { values.remove("-fv-central") }
  values.set("-fv-turned", [Ident("1")])
  values.set("writing-mode", [Ident("horizontal-tb")])
  let (own_m0, own_m1, own_m2, own_m3) = props_inherited_masks(values)
  let (pinh_m0, pinh_m1, pinh_m2, pinh_m3) = match self.inherit_from {
    Some(p) => (p.inh_m0, p.inh_m1, p.inh_m2, p.inh_m3)
    None => (0L, 0L, 0L, 0L)
  }
  Style::{
    uid: next_style_uid(),
    values: values,
    vars: self.vars,
    parent: self.parent,
    own_inherited: (own_m0 | own_m1 | own_m2 | own_m3) != 0L,
    inherit_from: self.inherit_from,
    inh_m0: own_m0 | pinh_m0,
    inh_m1: own_m1 | pinh_m1,
    inh_m2: own_m2 | pinh_m2,
    inh_m3: own_m3 | pinh_m3,
    font_size: self.font_size,
    env: self.env,
    inherited_found: None,
    root_font: self.root_font,
    picked: -1,
    picked_gen: 0,
    out_of_flow: 0,
    hot: new_hot(),
    kids_gen: -1,
    kid0_key: "",
    kid0_val: None,
    kid1_key: "",
    kid1_val: None,
    kid2_key: "",
    kid2_val: None,
    kid3_key: "",
    kid3_val: None,
    kids: None,
    deco: -1,
    text: None,
    color_cached: None,
    cursor_cache: -2,
    flow_flags: -1,
    auto_m: -1,
    edge_pct: -1,
    disp_str: "",
    cq_w: self.cq_w,
    cq_h: self.cq_h,
    kw_size: self.kw_size,
    uses_non_inh_inherit: self.uses_non_inh_inherit,
    anim_cb: self.anim_cb,
  }
}

pub fn Style::same_values(self : Style, other : Style) -> Bool {
  if self.font_size != other.font_size || self.values.length() != other.values.length() || self.root_font != other.root_font || self.cq_w != other.cq_w || self.cq_h != other.cq_h || self.kw_size != other.kw_size || self.anim_cb != other.anim_cb {
    return false
  }
  if !self.vars.same(other.vars) { return false }
  if !self.values.same(other.values) { return false }
  match self.parent {
    None => other.parent.is_none()
    Some(p) => match other.parent {
      Some(q) => p.uid == q.uid || p.same_for_kids(q)
      None => false
    }
  }
}

let inherited_ids_cache : Array[Int] = []

fn ensure_inherited_ids() -> Unit {
  if inherited_ids_cache.length() > 0 { return }
  let mut i = 0
  while i < inherited_list.length() {
    inherited_ids_cache.push(prop_id(inherited_list[i]))
    i = i + 1
  }
}

fn props_inherited_same(a : Style, b : Style, p : Props) -> Bool {
  if p.count == 0 { return true }
  if p.k0 >= 0 {
    let k0 = id_kind(p.k0)
    if (k0 & 0x10000) != 0 && !opt_toks_same(a.lookup_id_kind(p.k0, k0), b.lookup_id_kind(p.k0, k0)) {
      return false
    }
    if p.k1 >= 0 {
      let k1 = id_kind(p.k1)
      if (k1 & 0x10000) != 0 && !opt_toks_same(a.lookup_id_kind(p.k1, k1), b.lookup_id_kind(p.k1, k1)) {
        return false
      }
    }
    return true
  }
  if p.slots.length() > 0 {
    let mut i = 0
    while i < p.slots.length() {
      if p.slots[i].is_some() {
        let k = id_kind(i)
        if (k & 0x10000) != 0 && !opt_toks_same(a.lookup_id_kind(i, k), b.lookup_id_kind(i, k)) {
          return false
        }
      }
      i = i + 1
    }
    return true
  }
  let mut i = 0
  while i < p.keys.length() {
    let id = p.keys[i]
    let k = id_kind(id)
    if (k & 0x10000) != 0 && !opt_toks_same(a.lookup_id_kind(id, k), b.lookup_id_kind(id, k)) {
      return false
    }
    i = i + 1
  }
  true
}

fn Style::same_for_kids(self : Style, other : Style) -> Bool {
  if self.uid == other.uid { return true }
  if (css_globals.kids_same_a_uid == self.uid && css_globals.kids_same_b_uid == other.uid) ||
  (css_globals.kids_same_a_uid == other.uid && css_globals.kids_same_b_uid == self.uid) {
    return true
  }
  if self.font_size != other.font_size || self.root_font != other.root_font || self.kw_size != other.kw_size { return false }
  if !self.vars.same(other.vars) { return false }
  if !opt_toks_same(self.values.get_id(p_display), other.values.get_id(p_display)) || self.decorations() != other.decorations() {
    return false
  }
  let same_inh_src = match self.inherit_from {
    None => other.inherit_from.is_none()
    Some(a) => match other.inherit_from { Some(b) => a.uid == b.uid None => false }
  }
  if !self.own_inherited && !other.own_inherited && same_inh_src {
    css_globals.kids_same_a_uid = self.uid
    css_globals.kids_same_b_uid = other.uid
    return true
  }
  if same_inh_src {
    if !props_inherited_same(self, other, self.values) || !props_inherited_same(self, other, other.values) {
      return false
    }
    css_globals.kids_same_a_uid = self.uid
    css_globals.kids_same_b_uid = other.uid
    return true
  }
  ensure_inherited_ids()
  let mut i = 0
  while i < inherited_ids_cache.length() {
    let id = inherited_ids_cache[i]
    let k = id_kind(id)
    if !opt_toks_same(self.lookup_id_kind(id, k), other.lookup_id_kind(id, k)) { return false }
    i = i + 1
  }
  css_globals.kids_same_a_uid = self.uid
  css_globals.kids_same_b_uid = other.uid
  true
}

// ----- Ancestor key cache -----

struct AncItem {
  uid : Int
  start : Int
}

let anc_chain : Array[AncItem] = []
let anc_key_buf : Array[Int] = []
let anc_counts : Array[Int] = []
let key_ids : Map[String, Int] = Map::new()
let class_keys : Map[String, Int] = Map::new()
let id_keys : Map[String, Int] = Map::new()
let tag_keys : Map[String, Int] = Map::new()

fn key_id(k : String) -> Int {
  match key_ids.get(k) {
    Some(i) => i
    None => {
      let i = key_ids.length()
      key_ids.set(k, i)
      i
    }
  }
}

fn named_key(names : Map[String, Int], prefix : String, name : String) -> Int {
  match names.get(name) {
    Some(i) => i
    None => {
      let i = key_id(prefix + name)
      names.set(name, i)
      i
    }
  }
}

fn lower_tag(t : String) -> String {
  ascii_lower(t)
}

let empty_str_arr : Array[String] = []
let match_class_buf : Array[String] = []
let anc_class_buf : Array[String] = []

fn fill_class_words(c : String, out : Array[String]) -> Unit {
  out.clear()
  let n = c.length()
  if n == 0 { return }
  let mut i = 0
  while i < n && is_space_byte(c.code_unit_at(i)) { i = i + 1 }
  if i == n { return }
  let first_start = i
  while i < n && !is_space_byte(c.code_unit_at(i)) { i = i + 1 }
  if first_start == 0 && i == n {
    out.push(c)
    return
  }
  out.push(str_slice(c, first_start, i))
  while i < n {
    while i < n && is_space_byte(c.code_unit_at(i)) { i = i + 1 }
    let start = i
    while i < n && !is_space_byte(c.code_unit_at(i)) { i = i + 1 }
    if i > start { out.push(str_slice(c, start, i)) }
  }
}

fn class_words(c : String) -> Array[String] {
  let n = c.length()
  if n == 0 { return empty_str_arr }
  let mut i = 0
  while i < n && is_space_byte(c.code_unit_at(i)) { i = i + 1 }
  if i == n { return empty_str_arr }
  let first_start = i
  while i < n && !is_space_byte(c.code_unit_at(i)) { i = i + 1 }
  if first_start == 0 && i == n { return [c] }
  let out : Array[String] = [str_slice(c, first_start, i)]
  while i < n {
    while i < n && is_space_byte(c.code_unit_at(i)) { i = i + 1 }
    let start = i
    while i < n && !is_space_byte(c.code_unit_at(i)) { i = i + 1 }
    if i > start { out.push(str_slice(c, start, i)) }
  }
  out
}

fn is_single_word(c : String) -> Bool {
  let n = c.length()
  if n == 0 { return false }
  let mut i = 0
  while i < n {
    if is_space_byte(c.code_unit_at(i)) { return false }
    i = i + 1
  }
  true
}

fn own_keys(x : html::Node) -> Array[String] {
  let out : Array[String] = [lower_tag(x.tag)]
  match x.attr("id") { Some(id) => out.push("#" + id) None => () }
  match x.attr("class") {
    Some(c) => {
      let ws = class_words(c)
      let mut i = 0
      while i < ws.length() { out.push("." + ws[i]); i = i + 1 }
    }
    None => ()
  }
  out
}

fn anc_inc_key(k : Int) -> Unit {
  anc_key_buf.push(k)
  while anc_counts.length() <= k { anc_counts.push(0) }
  anc_counts[k] = anc_counts[k] + 1
}

fn anc_pop() -> Unit {
  match anc_chain.pop() {
    Some(item) => {
      while anc_key_buf.length() > item.start {
        match anc_key_buf.pop() {
          Some(k) => anc_counts[k] = anc_counts[k] - 1
          None => break
        }
      }
    }
    None => ()
  }
}

fn anc_push(x : html::Node) -> Unit {
  let start = anc_key_buf.length()
  let tag = if x.ns == html::Ns::Html { x.tag } else { lower_tag(x.tag) }
  anc_inc_key(named_key(tag_keys, "", tag))
  let alen = x.attrs.length()
  if alen > 0 {
    let mut id_val : Option[String] = None
    let mut cls_val : Option[String] = None
    let mut ai = 0
    while ai < alen {
      let a = x.attrs[ai]
      if a.prefix == "" {
        if id_val.is_none() && a.name == "id" {
          id_val = Some(a.value)
          if cls_val.is_some() { break }
        } else if cls_val.is_none() && a.name == "class" {
          cls_val = Some(a.value)
          if id_val.is_some() { break }
        }
      }
      ai = ai + 1
    }
    match id_val { Some(id) => anc_inc_key(named_key(id_keys, "#", id)) None => () }
    match cls_val {
      Some(c) => {
        if is_single_word(c) {
          anc_inc_key(named_key(class_keys, ".", c))
        } else {
          fill_class_words(c, anc_class_buf)
          let mut i = 0
          let wn = anc_class_buf.length()
          while i < wn { anc_inc_key(named_key(class_keys, ".", anc_class_buf[i])); i = i + 1 }
          anc_class_buf.clear()
        }
      }
      None => ()
    }
  }
  anc_chain.push(AncItem::{ uid: x.uid, start: start })
}

pub fn reset_ancestor_keys() -> Unit {
  while anc_chain.length() > 0 { anc_pop() }
}

fn ancestor_keys(n : html::Node) -> Array[Int] {
  match element_parent(n) {
    None => reset_ancestor_keys()
    Some(p) => {
      let clen = anc_chain.length()
      if clen > 0 && anc_chain[clen - 1].uid == p.uid {
        return anc_counts
      }
      // Fast path: DFS descending one level (p's parent is already top of anc_chain)
      if clen > 0 {
        match element_parent(p) {
          Some(gp) if anc_chain[clen - 1].uid == gp.uid => {
            anc_push(p)
            return anc_counts
          }
          _ => ()
        }
      }
      // Check if p is already an ancestor in anc_chain (DFS ascending)
      let mut i = clen - 1
      while i >= 0 && anc_chain[i].uid != p.uid { i = i - 1 }
      if i >= 0 {
        while anc_chain.length() > i + 1 { anc_pop() }
      } else {
        // Walk up from p until we hit the lowest common ancestor already in anc_chain
        let anc_up_buf : Array[html::Node] = []
        let mut q : Option[html::Node] = Some(p)
        let mut lca = -1
        while true {
          match q {
            Some(x) => {
              let xuid = x.uid
              let mut k = clen - 1
              while k >= 0 && anc_chain[k].uid != xuid { k = k - 1 }
              if k >= 0 {
                lca = k
                break
              }
              anc_up_buf.push(x)
              q = element_parent(x)
            }
            None => break
          }
        }
        while anc_chain.length() > lca + 1 { anc_pop() }
        let mut j = anc_up_buf.length() - 1
        while j >= 0 { anc_push(anc_up_buf[j]); j = j - 1 }
      }
    }
  }
  anc_counts
}

// ----- Engine -----

pub struct Engine {
  pub uid : Int
  mut env : Env
  media_asked : Array[MediaAsked]
  mut prefs_dark : Bool
  mut prefs_dpr : Double
  mut viewport_units : Bool
  by_id : Map[String, Array[Entry]]
  by_class : Map[String, Array[Entry]]
  by_tag : Map[String, Array[Entry]]
  by_attr : Map[String, Array[Entry]]
  mut by_attr_has_id : Bool
  mut by_attr_has_class : Bool
  roots : Array[Entry]
  mut multi : Bool
  rest : Array[Entry]
  mut pseudo_index : Option[PseudoIndex]
  mut has_before_content : Bool
  mut has_after_content : Bool
  before_content : ContentKeys
  after_content : ContentKeys
  pub mut has_first_line : Bool
  pub mut has_first_letter : Bool
  mut has_placeholder : Bool
  mut has_webkit_scrollbar : Bool
  mut has_slider_pseudo : Bool
  mut has_parts : Bool
  mut order : Int
  mut faces : Array[FontFace]
  face_keys : Array[String]
  face_layers : Array[Array[Int]]
  feature_values_map : Map[String, Array[Int]]
  keyframes_map : Map[String, Array[Keyframe]]
  mut has_transitions_flag : Bool
  mut has_var_revert_layer : Bool
  registered : Map[String, RegProp]
  matched : intmap::IntMap[NodeMatches]
  pair_lists : intmap::IntMap[MatchedList]
  styled : intmap::IntMap[StyledEntry]
  matched_nodes : intmap::IntMap[html::Node]
  mut sibling_rules : Bool
  beside_keys : Map[String, Bool]
  mut beside_any : Bool
  beside_right_keys : Map[String, Bool]
  mut beside_right_any : Bool
  deep_keys : Map[String, Bool]
  mut deep_any : Bool
  deep_left : Map[String, Bool]
  deep_parent : Map[String, Int]
  mut deep_far : Bool
  below_keys : Map[String, Bool]
  mut below_any : Bool
  below_targets : Map[String, TargetSet]
  below_wild : Map[String, Bool]
  restyle_dirty : intmap::IntMap[Bool]
  changed_keys_buf : Array[String]
  ck_old_ws_buf : Array[String]
  ck_new_ws_buf : Array[String]
  mut has_rules : Bool
  mut has_deep : Bool
  mut state_bits : Int
  used_attrs : Map[String, Bool]
  mut has_attr_fn_flag : Bool
  mut has_ns_attr : Bool
  hover_targets : Array[Selector]
  hover_by_key : Map[String, Array[Selector]]
  hover_any : Array[Selector]
  active_targets : Array[Selector]
  active_by_key : Map[String, Array[Selector]]
  active_any : Array[Selector]
  has_uses : Array[HasUse]
  layer_index : Map[String, Int]
  layer_next : Map[String, Int]
  mut cur_layer : Array[Int]
  mut cur_key : String
  mut cur_cq : Option[Array[Tok]]
  mut has_cq : Bool
  mut anon : Int
  mut quirks : Bool
  mut share_gen : Int
}

fn layer_cmp(a : Array[Int], b : Array[Int]) -> Int {
  let mut i = 0
  while i < a.length() && i < b.length() {
    if a[i] != b[i] { return a[i] - b[i] }
    i = i + 1
  }
  b.length() - a.length()
}

fn entry_cmp(a : Entry, b : Entry) -> Int {
  let l = layer_cmp(a.layer, b.layer)
  if l != 0 { l }
  else if a.sel.specificity != b.sel.specificity { a.sel.specificity - b.sel.specificity }
  else { a.order - b.order }
}

fn sort_entries(arr : Array[Entry], cmp : (Entry, Entry) -> Int) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && cmp(arr[j], key) > 0 {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

fn sort_strings(arr : Array[String]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j] > key {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

fn Engine::layer_path(self : Engine, name : String) -> LayerPath {
  let path : Array[Int] = []
  let mut i = 0
  while i < self.cur_layer.length() { path.push(self.cur_layer[i]); i = i + 1 }
  let mut key = self.cur_key
  let segs : Array[String] = if name == "" {
    self.anon = self.anon + 1
    ["\u{1}" + self.anon.to_string()]
  } else {
    str_split_char(name, 46)
  }
  i = 0
  while i < segs.length() {
    let k = key + "/" + segs[i]
    let idx = match self.layer_index.get(k) {
      Some(v) => v
      None => {
        let v = match self.layer_next.get(key) { Some(n) => n None => 0 }
        self.layer_next.set(key, v + 1)
        self.layer_index.set(k, v)
        v
      }
    }
    path.push(idx)
    key = k
    i = i + 1
  }
  LayerPath::{ path: path, key: key }
}

pub fn Engine::import_applies(self : Engine, r : Import) -> Bool {
  let sup : Array[Tok] = [OpenParen]
  tok_append(sup, r.supports)
  sup.push(CloseParen)
  (r.supports.length() == 0 || supports_matches(sup)) && self.media_said(r.media)
}

fn Engine::media_said(self : Engine, q : Array[Tok]) -> Bool {
  let r = media_matches(self.env, q)
  self.media_asked.push(MediaAsked::{ query: q, result: r })
  r
}

pub fn Engine::matches_env(self : Engine, env : Env) -> Bool {
  self.prefs_dark == media_prefs.dark &&
  self.prefs_dpr == env.dpr &&
  env.width == self.env.width &&
  env.height == self.env.height &&
  env.media == self.env.media
}

pub fn Engine::resize(self : Engine, env : Env) -> Bool {
  let same_prefs = self.prefs_dark == media_prefs.dark && self.prefs_dpr == env.dpr
  if same_prefs && env.width == self.env.width && env.height == self.env.height && env.media == self.env.media {
    return true
  }
  let mut i = 0
  while i < self.media_asked.length() {
    if media_matches(env, self.media_asked[i].query) != self.media_asked[i].result {
      return false
    }
    i = i + 1
  }
  self.env = env
  // (`light-dark()` and `color-scheme: light dark` are resolved in the computed styles kept)
  let dark_changed = self.prefs_dark != media_prefs.dark
  self.prefs_dark = media_prefs.dark
  self.prefs_dpr = env.dpr
  if self.viewport_units || dark_changed {
    self.forget_all()
  }
  true
}

fn in_cq_units(v : Array[Tok]) -> Bool {
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Dimension(_, u) => {
        let lu = ascii_lower(u)
        if lu == "cqw" || lu == "cqh" || lu == "cqi" || lu == "cqb" || lu == "cqmin" || lu == "cqmax" {
          return true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn Engine::ancestor_container_size(self : Engine, n : html::Node) -> Option[(Double, Double)] {
  let sz_fn = css_globals.container_size
  let mut p = n.parent
  while true {
    match p {
      Some(x) => {
        if x.kind != html::Kind::Element { break }
        let is_ct = match intmap::get(self.styled, x.uid) {
          Some(se) => {
            let ct = se.style.word("container-type")
            ct == "size" || ct == "inline-size"
          }
          None => true
        }
        if is_ct {
          match sz_fn(x.uid) {
            Some(wh) if wh.0 > 0.0 => return Some(wh)
            _ => ()
          }
        }
        p = x.parent
      }
      None => break
    }
  }
  None
}

fn in_viewport_units(v : Array[Tok]) -> Bool {
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Dimension(_, u) => {
        let lu = ascii_lower(u)
        if lu == "vw" || lu == "vh" || lu == "vmin" || lu == "vmax" || lu == "vi" || lu == "vb" ||
        lu == "svw" || lu == "svh" || lu == "lvw" || lu == "lvh" || lu == "dvw" || lu == "dvh" ||
        lu == "cqw" || lu == "cqh" || lu == "cqi" || lu == "cqb" || lu == "cqmin" || lu == "cqmax" {
          return true
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

pub fn Engine::in_layer(self : Engine, layer : String, f : () -> Unit) -> Unit {
  let lp = self.layer_path(layer)
  let sp = self.cur_layer
  let sk = self.cur_key
  self.cur_layer = lp.path
  self.cur_key = lp.key
  f()
  self.cur_layer = sp
  self.cur_key = sk
}

fn ancestor_needs(sel : Selector) -> Array[String] {
  let out : Array[String] = []
  let mut i = 1
  while i < sel.parts.length() {
    let ok = match sel.parts[i - 1].comb { Descendant => true Child => true _ => false }
    if !ok { break }
    let comp = sel.parts[i].compound
    let mut j = 0
    while j < comp.length() {
      match comp[j] {
        IdSel(v) => out.push("#" + v)
        ClassSel(v, _) => out.push("." + v)
        TypeSel(t) => out.push(t)
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
  out
}

fn subject_keys(c : Array[Simple]) -> Option[Array[SubjectKey]] {
  let mut has_best = false
  let mut best_kind = 99
  let mut best_key = ""
  let rank = fn(k : Int) -> Int {
    if k == 0 { 0 } else if k == 1 { 1 } else if k == 3 { 2 } else if k == 2 { 3 } else { 4 }
  }
  let mut i = 0
  while i < c.length() {
    match c[i] {
      IdSel(v) => if !has_best || rank(0) < rank(best_kind) { has_best = true; best_kind = 0; best_key = v }
      ClassSel(v, _) => if !has_best || rank(1) < rank(best_kind) { has_best = true; best_kind = 1; best_key = v }
      AttrSel(name, _, _, _) => if !str_contains(name, "|") && (!has_best || rank(3) < rank(best_kind)) { has_best = true; best_kind = 3; best_key = ascii_lower(name) }
      TypeSel(v) => if !has_best || rank(2) < rank(best_kind) { has_best = true; best_kind = 2; best_key = v }
      PseudoSel(nm, _) => if nm == "root" && (!has_best || rank(4) < rank(best_kind)) { has_best = true; best_kind = 4; best_key = "" }
      _ => ()
    }
    i = i + 1
  }
  if has_best {
    return Some([SubjectKey::{ kind: best_kind, key: best_key }])
  }
  i = 0
  while i < c.length() {
    match c[i] {
      PseudoSel(name, list) => {
        if list.length() > 0 && (name == "is" || name == "where" || name == "matches" || name == "-webkit-any") {
          let all : Array[SubjectKey] = []
          let mut each = true
          let mut j = 0
          while j < list.length() {
            let t = list[j]
            if t.parts.length() > 0 {
              match subject_keys(t.parts[0].compound) {
                Some(ks) => {
                  let mut ki = 0
                  while ki < ks.length() {
                    let kk = ks[ki]
                    let mut dup = false
                    let mut ai = 0
                    while ai < all.length() {
                      if all[ai].kind == kk.kind && all[ai].key == kk.key { dup = true; break }
                      ai = ai + 1
                    }
                    if !dup { all.push(kk) }
                    ki = ki + 1
                  }
                }
                None => each = false
              }
            } else {
              each = false
            }
            j = j + 1
          }
          if each { return Some(all) }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  None
}

fn state_bit_of_pseudo(name : String) -> Int {
  if name == "popover-open" { 1 }
  else if name == "modal" { 2 }
  else if name == "focus" { 4 }
  else if name == "focus-visible" { 8 }
  else if name == "focus-within" { 16 }
  else if name == "hover" { 32 }
  else if name == "active" { 64 }
  else if name == "fullscreen" || name == "-webkit-full-screen" { 128 }
  else { 0 }
}

fn state_bits_of(sel : Selector) -> Int {
  let mut bits = 0
  let mut i = 0
  while i < sel.parts.length() {
    let comp = sel.parts[i].compound
    let mut j = 0
    while j < comp.length() {
      match comp[j] {
        PseudoSel(name, list) => {
          bits = bits | state_bit_of_pseudo(name)
          let mut k = 0
          while k < list.length() { bits = bits | state_bits_of(list[k]); k = k + 1 }
        }
        NthSel(_, _, _, list) => {
          let mut k = 0
          while k < list.length() { bits = bits | state_bits_of(list[k]); k = k + 1 }
        }
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
  bits
}

fn subject_targets(c : Array[Simple]) -> Option[Array[SubjectKey]] {
  match subject_keys(c) {
    Some(keys) => {
      let mut i = 0
      while i < keys.length() {
        if keys[i].kind == 4 { return None }
        i = i + 1
      }
      Some(keys)
    }
    None => {
      let mut i = 0
      while i < c.length() {
        match c[i] {
          PseudoSel(name, _) => {
            let bit = state_bit_of_pseudo(name)
            if bit != 0 { return Some([SubjectKey::{ kind: 5, key: bit.to_string() }]) }
          }
          _ => ()
        }
        i = i + 1
      }
      None
    }
  }
}

fn looks_beside(sel : Selector) -> Bool {
  let mut i = 0
  while i < sel.parts.length() {
    let p = sel.parts[i]
    match p.comb { Next => return true Later => return true _ => () }
    let mut j = 0
    while j < p.compound.length() {
      match p.compound[j] {
        PseudoSel(_, list) => {
          let mut k = 0
          while k < list.length() { if looks_beside(list[k]) { return true }; k = k + 1 }
        }
        NthSel(_, _, _, list) => {
          let mut k = 0
          while k < list.length() { if looks_beside(list[k]) { return true }; k = k + 1 }
        }
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
  false
}

fn positional(c : Array[Simple], comb : Combinator) -> Bool {
  match comb { Next => return true Later => return true _ => () }
  let mut i = 0
  while i < c.length() {
    match c[i] {
      NthSel(_, _, _, _) => return true
      PseudoSel(name, list) => {
        if name == "has" { () }
        else if name == "first-child" || name == "last-child" || name == "only-child" ||
        name == "first-of-type" || name == "last-of-type" || name == "only-of-type" {
          return true
        } else {
          let mut k = 0
          while k < list.length() {
            let t = list[k]
            let mut pi = 0
            while pi < t.parts.length() {
              if positional(t.parts[pi].compound, t.parts[pi].comb) { return true }
              pi = pi + 1
            }
            k = k + 1
          }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn beside_deep(sel : Selector) -> Bool {
  let mut i = 0
  while i < sel.parts.length() {
    let p = sel.parts[i]
    if i > 0 && positional(p.compound, p.comb) { return true }
    if i == 0 {
      let mut j = 0
      while j < p.compound.length() {
        match p.compound[j] {
          PseudoSel(name, list) => {
            if name != "has" {
              let mut k = 0
              while k < list.length() { if beside_deep(list[k]) { return true }; k = k + 1 }
            }
          }
          NthSel(_, _, _, list) => {
            let mut k = 0
            while k < list.length() { if beside_deep(list[k]) { return true }; k = k + 1 }
          }
          _ => ()
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  false
}

fn just_position(c : Array[Simple]) -> Bool {
  let mut i = 0
  while i < c.length() {
    match c[i] {
      NthSel(_, _, _, list) => if list.length() > 0 { return false }
      PseudoSel(_, list) => {
        let mut k = 0
        while k < list.length() {
          let t = list[k]
          let mut pi = 0
          while pi < t.parts.length() {
            if positional(t.parts[pi].compound, t.parts[pi].comb) { return false }
            pi = pi + 1
          }
          k = k + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

fn keyed(c : Array[Simple]) -> Bool {
  let mut i = 0
  while i < c.length() {
    match c[i] {
      TypeSel(_) => return true
      IdSel(_) => return true
      ClassSel(_, _) => return true
      AttrSel(_, _, _, _) => return true
      PseudoSel(name, list) => {
        if (name == "is" || name == "where" || name == "matches" || name == "-webkit-any") && list.length() > 0 {
          let mut all = true
          let mut k = 0
          while k < list.length() {
            if !(list[k].parts.length() > 0 && keyed(list[k].parts[0].compound)) { all = false; break }
            k = k + 1
          }
          if all { return true }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn compound_keys(c : Array[Simple]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < c.length() {
    match c[i] {
      TypeSel(t) => out.push(ascii_lower(t))
      IdSel(id) => out.push("#" + id)
      ClassSel(k, _) => out.push("." + k)
      AttrSel(name, _, _, _) => out.push("[" + ascii_lower(name))
      PseudoSel(name, list) => {
        if name == "is" || name == "where" || name == "matches" || name == "-webkit-any" {
          let mut k = 0
          while k < list.length() {
            if list[k].parts.length() > 0 {
              let sub = compound_keys(list[k].parts[0].compound)
              let mut si = 0
              while si < sub.length() { out.push(sub[si]); si = si + 1 }
            }
            k = k + 1
          }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  out
}

fn pos_mask(c : Array[Simple]) -> Int {
  let mut m = 0
  let mut i = 0
  while i < c.length() {
    match c[i] {
      NthSel(_, _, _, _) => return 4
      PseudoSel(name, _) => {
        if name == "first-child" { m = m | 1 }
        else if name == "last-child" { m = m | 2 }
        else if name == "only-child" { m = m | 3 }
        else if name == "first-of-type" || name == "last-of-type" || name == "only-of-type" {
          return 4
        }
      }
      _ => ()
    }
    i = i + 1
  }
  if m == 0 { 4 } else { m }
}

fn has_strong_key(c : Array[Simple]) -> Bool {
  let mut i = 0
  while i < c.length() {
    match c[i] {
      IdSel(_) | ClassSel(_, _) | AttrSel(_, _, _, _) => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn has_any_key_mask(x : html::Node, keys : Map[String, Int]) -> Int {
  if x.kind != html::Kind::Element { return 0 }
  let mut m = 0
  let ok = own_keys(x)
  let mut i = 0
  while i < ok.length() {
    match keys.get(ok[i]) {
      Some(v) => { m = m | v; if (m & 4) != 0 { return m } }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < x.attrs.length() {
    match keys.get("[" + ascii_lower(x.attrs[i].name)) {
      Some(v) => { m = m | v; if (m & 4) != 0 { return m } }
      None => ()
    }
    i = i + 1
  }
  m
}

fn has_any_key(x : html::Node, keys : Map[String, Bool]) -> Bool {
  if x.kind != html::Kind::Element { return false }
  let ok = own_keys(x)
  let mut i = 0
  while i < ok.length() {
    if keys.contains(ok[i]) { return true }
    i = i + 1
  }
  i = 0
  while i < x.attrs.length() {
    if keys.contains("[" + ascii_lower(x.attrs[i].name)) { return true }
    i = i + 1
  }
  false
}

fn pseudo_attrs(name : String) -> Option[Array[String]] {
  if name == "link" || name == "any-link" { Some(["[href"]) }
  else if name == "checked" || name == "default" { Some(["[checked", "[selected"]) }
  else if name == "disabled" || name == "enabled" { Some(["[disabled"]) }
  else if name == "required" || name == "optional" { Some(["[required"]) }
  else if name == "open" || name == "closed" { Some(["[open"]) }
  else if name == "placeholder-shown" { Some(["[placeholder", "[value"]) }
  else if name == "target" { Some(["[id"]) }
  else if name == "dir" || name == "dir-ltr" || name == "dir-rtl" { Some(["[dir"]) }
  else if name == "lang" { Some(["[lang"]) }
  else { None }
}

fn gather_keys(c : Array[Simple], into : Map[String, Bool]) -> Bool {
  let mut told = true
  let mut i = 0
  while i < c.length() {
    match c[i] {
      IdSel(id) => into.set("#" + id, true)
      ClassSel(k, _) => into.set("." + k, true)
      AttrSel(name, _, _, _) => into.set("[" + ascii_lower(name), true)
      PseudoSel(name, list) => {
        match pseudo_attrs(name) {
          Some(ks) => {
            let mut ki = 0
            while ki < ks.length() { into.set(ks[ki], true); ki = ki + 1 }
          }
          None => if name == "host" || name == "host-context" || name == "slotted" { told = false }
        }
        let mut ti = 0
        while ti < list.length() {
          let t = list[ti]
          let mut qi = 0
          while qi < t.parts.length() {
            if !gather_keys(t.parts[qi].compound, into) { told = false }
            qi = qi + 1
          }
          ti = ti + 1
        }
      }
      NthSel(name, _, _, list) => {
        match pseudo_attrs(name) {
          Some(ks) => {
            let mut ki = 0
            while ki < ks.length() { into.set(ks[ki], true); ki = ki + 1 }
          }
          None => ()
        }
        let mut ti = 0
        while ti < list.length() {
          let t = list[ti]
          let mut qi = 0
          while qi < t.parts.length() {
            if !gather_keys(t.parts[qi].compound, into) { told = false }
            qi = qi + 1
          }
          ti = ti + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  told
}

fn looks_below(sel : Selector) -> Bool {
  let mut i = 0
  while i < sel.parts.length() {
    let comp = sel.parts[i].compound
    let mut j = 0
    while j < comp.length() {
      match comp[j] {
        PseudoSel(name, list) => {
          if name == "has" { return true }
          let mut k = 0
          while k < list.length() { if looks_below(list[k]) { return true }; k = k + 1 }
        }
        NthSel(_, _, _, list) => {
          let mut k = 0
          while k < list.length() { if looks_below(list[k]) { return true }; k = k + 1 }
        }
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
  false
}

fn meets(keys : Map[String, Bool], found : Map[String, Bool]) -> Bool {
  if keys.length() <= found.length() {
    let ks = keys.keys()
    let mut i = 0
    while i < ks.length() {
      if found.contains(ks[i]) { return true }
      i = i + 1
    }
    false
  } else {
    let ks = found.keys()
    let mut i = 0
    while i < ks.length() {
      if keys.contains(ks[i]) { return true }
      i = i + 1
    }
    false
  }
}

fn add_keys(x : html::Node, into : Map[String, Bool]) -> Unit {
  if x.kind != html::Kind::Element { return }
  let ok = own_keys(x)
  let mut i = 0
  while i < ok.length() { into.set(ok[i], true); i = i + 1 }
  i = 0
  while i < x.attrs.length() { into.set("[" + ascii_lower(x.attrs[i].name), true); i = i + 1 }
}

fn meets_arr(ck : Array[String], target : Map[String, Bool]) -> Bool {
  if target.length() == 0 || ck.length() == 0 { return false }
  let mut i = 0
  let n = ck.length()
  while i < n {
    if target.contains(ck[i]) { return true }
    i = i + 1
  }
  false
}

fn changed_keys_into(n : html::Node, name0 : String, value0 : String, out : Array[String]) -> Unit {
  changed_keys_into_ws(n, name0, value0, out, [], [])
}

fn changed_keys_into_ws(
  n : html::Node,
  name0 : String,
  value0 : String,
  out : Array[String],
  old_ws : Array[String],
  new_ws : Array[String],
) -> Unit {
  out.clear()
  let name = ascii_lower(name0)
  out.push("[" + name)
  let value = if value0 == "\u{0}" { "" } else { value0 }
  if name == "id" {
    match n.attr("id") { Some(old) => out.push("#" + old) None => () }
    if value != "" { out.push("#" + value) }
  } else if name == "class" {
    let old_str = match n.attr("class") { Some(s) => s None => "" }
    if old_str == value { return }
    fill_class_words(old_str, old_ws)
    fill_class_words(value, new_ws)
    let on = old_ws.length()
    let nn = new_ws.length()
    if on <= 8 && nn <= 8 {
      let mut i = 0
      while i < on {
        let w = old_ws[i]
        let mut dup = false
        let mut p = 0
        while p < i {
          if old_ws[p] == w { dup = true; break }
          p = p + 1
        }
        if !dup {
          let mut found = false
          let mut j = 0
          while j < nn {
            if new_ws[j] == w { found = true; break }
            j = j + 1
          }
          if !found { out.push("." + w) }
        }
        i = i + 1
      }
      i = 0
      while i < nn {
        let w = new_ws[i]
        let mut dup = false
        let mut p = 0
        while p < i {
          if new_ws[p] == w { dup = true; break }
          p = p + 1
        }
        if !dup {
          let mut found = false
          let mut j = 0
          while j < on {
            if old_ws[j] == w { found = true; break }
            j = j + 1
          }
          if !found { out.push("." + w) }
        }
        i = i + 1
      }
    } else {
      let was : Map[String, Bool] = Map::new()
      let now : Map[String, Bool] = Map::new()
      let mut i = 0
      while i < on { was.set(old_ws[i], true); i = i + 1 }
      i = 0
      while i < nn { now.set(new_ws[i], true); i = i + 1 }
      let wks = was.keys()
      i = 0
      while i < wks.length() { if !now.contains(wks[i]) { out.push("." + wks[i]) }; i = i + 1 }
      let nks = now.keys()
      i = 0
      while i < nks.length() { if !was.contains(nks[i]) { out.push("." + nks[i]) }; i = i + 1 }
    }
    old_ws.clear()
    new_ws.clear()
  }
}

// ----- HasScope & HasUse -----

struct AttrChange {
  name : String
  value : String
}

struct HasScope {
  n : html::Node
  children_changed : Bool
  attr : Option[AttrChange]
  moved : Option[html::Node]
  mut sub_cache : Option[Map[String, Bool]]
  mut kids_cache : Option[Map[String, Bool]]
  mut own_cache : Option[Map[String, Bool]]
  mut up_cache : Option[Map[String, Bool]]
  mut up_beside_cache : Option[Map[String, Bool]]
}

fn HasScope::new(n : html::Node, children_changed : Bool, attr : Option[AttrChange], moved : Option[html::Node]) -> HasScope {
  HasScope::{
    n: n,
    children_changed: children_changed,
    attr: attr,
    moved: moved,
    sub_cache: None,
    kids_cache: None,
    own_cache: None,
    up_cache: None,
    up_beside_cache: None,
  }
}

fn HasScope::sub(self : HasScope) -> Map[String, Bool] {
  match self.sub_cache {
    Some(m) => m
    None => {
      let m : Map[String, Bool] = Map::new()
      let top = match self.moved { Some(x) => x None => self.n }
      let deep = if self.moved.is_some() { true } else { self.children_changed }
      let walk : Array[html::Node] = [top]
      while walk.length() > 0 {
        match walk.pop() {
          Some(x) => {
            add_keys(x, m)
            if deep || x.uid != top.uid {
              let mut i = 0
              while i < x.children.length() { walk.push(x.children[i]); i = i + 1 }
            }
          }
          None => break
        }
      }
      self.sub_cache = Some(m)
      m
    }
  }
}

fn HasScope::kids(self : HasScope) -> Map[String, Bool] {
  match self.kids_cache {
    Some(m) => m
    None => {
      let m : Map[String, Bool] = Map::new()
      let mut i = 0
      while i < self.n.children.length() { add_keys(self.n.children[i], m); i = i + 1 }
      self.kids_cache = Some(m)
      m
    }
  }
}

fn HasScope::own(self : HasScope) -> Map[String, Bool] {
  match self.own_cache {
    Some(m) => m
    None => {
      let m : Map[String, Bool] = Map::new()
      add_keys(self.n, m)
      self.own_cache = Some(m)
      m
    }
  }
}

fn HasScope::gather_up(self : HasScope, beside : Bool) -> Map[String, Bool] {
  let m : Map[String, Bool] = Map::new()
  let mut p : Option[html::Node] = Some(self.n)
  while true {
    match p {
      Some(x) => {
        add_keys(x, m)
        if beside {
          match x.parent {
            Some(q) => {
              let mut i = 0
              while i < q.children.length() {
                let c = q.children[i]
                if c.uid == x.uid { break }
                add_keys(c, m)
                i = i + 1
              }
            }
            None => ()
          }
        }
        p = match x.parent { Some(y) => Some(y) None => x.get_host() }
      }
      None => break
    }
  }
  m
}

fn HasScope::up(self : HasScope) -> Map[String, Bool] {
  match self.up_cache {
    Some(m) => m
    None => { let m = self.gather_up(false); self.up_cache = Some(m); m }
  }
}

fn HasScope::up_beside(self : HasScope) -> Map[String, Bool] {
  match self.up_beside_cache {
    Some(m) => m
    None => { let m = self.gather_up(true); self.up_beside_cache = Some(m); m }
  }
}

fn HasUse::anchor_near(self : HasUse, s : HasScope) -> Bool {
  self.anchor_any || meets(self.anchor, if self.beside { s.up_beside() } else { s.up() })
}

fn HasUse::anchors_near(self : HasUse, n : html::Node, among_children : Bool) -> Array[html::Node] {
  let out : Array[html::Node] = []
  if self.beside && among_children {
    let mut i = 0
    while i < n.children.length() {
      if has_any_key(n.children[i], self.anchor) { out.push(n.children[i]) }
      i = i + 1
    }
  }
  let mut p : Option[html::Node] = Some(n)
  while true {
    match p {
      Some(x) => {
        if has_any_key(x, self.anchor) { out.push(x) }
        if self.beside {
          match x.parent {
            Some(q) => {
              let mut i = 0
              while i < q.children.length() {
                let c = q.children[i]
                if c.uid == x.uid { break }
                if has_any_key(c, self.anchor) { out.push(c) }
                i = i + 1
              }
            }
            None => ()
          }
        }
        p = match x.parent { Some(y) => Some(y) None => x.get_host() }
      }
      None => break
    }
  }
  out
}

fn HasUse::relevant(self : HasUse, s : HasScope) -> Bool {
  let n = s.n
  match s.attr {
    Some(ac) => {
      let name = ascii_lower(ac.name)
      let value = if ac.value == "\u{0}" && (name == "class" || name == "id") { "" } else { ac.value }
      let mut flips = false
      match self.attrs.get(name) {
        Some(tests) => {
          let old = n.attr(name)
          let new_v = if ac.value == "\u{0}" { None } else { Some(ac.value) }
          let mut i = 0
          while i < tests.length() {
            let t = tests[i]
            if attr_value_matches(old, t.op, t.value, t.ci) != attr_value_matches(new_v, t.op, t.value, t.ci) {
              flips = true
              break
            }
            i = i + 1
          }
        }
        None => ()
      }
      let mut named = false
      if name == "class" {
        let old_ws = class_words(match n.attr("class") { Some(x) => x None => "" })
        let new_ws = class_words(value)
        let mut i = 0
        while i < old_ws.length() {
          if !str_arr_contains(new_ws, old_ws[i]) && self.keys.contains("." + old_ws[i]) { named = true; break }
          i = i + 1
        }
        if !named {
          i = 0
          while i < new_ws.length() {
            if !str_arr_contains(old_ws, new_ws[i]) && self.keys.contains("." + new_ws[i]) { named = true; break }
            i = i + 1
          }
        }
      } else if name == "id" {
        let old_id = match n.attr("id") { Some(x) => x None => "" }
        named = self.keys.contains("#" + old_id) || self.keys.contains("#" + value)
      }
      let pseudo = self.any && !(name == "style" || name == "class" || name == "id" || str_has_prefix(name, "data-") || str_has_prefix(name, "aria-"))
      return (flips || named || pseudo) && self.anchor_near(s)
    }
    None => ()
  }
  match s.moved {
    Some(m) => {
      if m.kind != html::Kind::Element {
        self.empty && (self.empty_any || meets(self.empty_keys, s.own())) && self.anchor_near(s)
      } else {
        let found = self.any || self.beside || (self.indexed && meets(self.keys, s.kids())) || meets(self.keys, s.sub())
        found && (self.anchor_near(s) || (self.beside && meets(self.anchor, s.kids())))
      }
    }
    None => (self.any || meets(self.keys, s.sub())) && self.anchor_near(s)
  }
}

// ----- Engine methods -----

struct EngineUidGen {
  mut next : Int
}

let engine_uid_gen : EngineUidGen = EngineUidGen::{ next: 0 }

pub fn Engine::new(env : Env) -> Engine {
  engine_uid_gen.next += 1
  let e = Engine::{
    uid: engine_uid_gen.next,
    env: env,
    media_asked: [],
    prefs_dark: media_prefs.dark,
    prefs_dpr: env.dpr,
    viewport_units: false,
    by_id: Map::new(),
    by_class: Map::with_capacity(64),
    by_tag: Map::with_capacity(32),
    by_attr: Map::new(),
    by_attr_has_id: false,
    by_attr_has_class: false,
    roots: [],
    multi: false,
    rest: [],
    pseudo_index: None,
    has_before_content: false,
    has_after_content: false,
    before_content: ContentKeys::new(),
    after_content: ContentKeys::new(),
    has_first_line: false,
    has_first_letter: false,
    has_placeholder: false,
    has_webkit_scrollbar: false,
    has_slider_pseudo: false,
    has_parts: false,
    order: 0,
    faces: [],
    face_keys: [],
    face_layers: [],
    feature_values_map: Map::new(),
    keyframes_map: Map::new(),
    has_transitions_flag: false,
    has_var_revert_layer: false,
    registered: Map::new(),
    matched: intmap::IntMap::with_capacity(64),
    pair_lists: intmap::IntMap::new(),
    styled: intmap::IntMap::with_capacity(64),
    matched_nodes: intmap::IntMap::with_capacity(64),
    sibling_rules: false,
    beside_keys: Map::new(),
    beside_any: false,
    beside_right_keys: Map::new(),
    beside_right_any: false,
    deep_keys: Map::new(),
    deep_any: false,
    deep_left: Map::new(),
    deep_parent: Map::new(),
    deep_far: false,
    below_keys: Map::new(),
    below_any: false,
    below_targets: Map::new(),
    below_wild: Map::new(),
    restyle_dirty: intmap::IntMap::new(),
    changed_keys_buf: [],
    ck_old_ws_buf: [],
    ck_new_ws_buf: [],
    has_rules: false,
    has_deep: false,
    state_bits: 0,
    used_attrs: Map::new(),
    has_attr_fn_flag: false,
    has_ns_attr: false,
    hover_targets: [],
    hover_by_key: Map::new(),
    hover_any: [],
    active_targets: [],
    active_by_key: Map::new(),
    active_any: [],
    has_uses: [],
    layer_index: Map::new(),
    layer_next: Map::new(),
    cur_layer: [],
    cur_key: "",
    cur_cq: None,
    has_cq: false,
    anon: 0,
    quirks: false,
    share_gen: next_share_gen(),
  }
  e.add_rules(cached_ua_rules(), true, fn(u : String) -> String { u })
  e
}

let ua_rules_cache : Array[Array[Rule]] = []
let quirks_rules_cache : Array[Array[Rule]] = []

fn cached_ua_rules() -> Array[Rule] {
  if ua_rules_cache.length() == 0 {
    ua_rules_cache.push(parse_stylesheet(get_ua_css()).rules)
  }
  ua_rules_cache[0]
}

fn cached_quirks_rules() -> Array[Rule] {
  if quirks_rules_cache.length() == 0 {
    quirks_rules_cache.push(parse_stylesheet(quirks_css()).rules)
  }
  quirks_rules_cache[0]
}

pub fn Engine::set_quirks(self : Engine, q : Bool) -> Unit {
  self.quirks = q
  self.share_gen = next_share_gen()
}

pub fn Engine::add_ua_sheet(self : Engine, css : String) -> Unit {
  if css == quirks_css() {
    self.add_rules(cached_quirks_rules(), true, fn(u : String) -> String { u })
  } else {
    self.add_rules(parse_stylesheet(css).rules, true, fn(u : String) -> String { u })
  }
}

pub fn Engine::add_sheet(self : Engine, css : String) -> Unit {
  self.add_sheet_resolve(css, fn(u : String) -> String { u })
}

let parsed_sheets_std : Map[String, (Stylesheet, Bool)] = Map::new()
let parsed_sheets_quirks : Map[String, (Stylesheet, Bool)] = Map::new()

fn rules_have_url(rules : Array[Rule]) -> Bool {
  let mut ri = 0
  while ri < rules.length() {
    match rules[ri] {
      StyleRule(_, decls) => {
        let mut di = 0
        while di < decls.length() {
          let dv = decls[di].value
          let mut ti = 0
          while ti < dv.length() {
            match dv[ti] {
              Url(_) => return true
              Function(f) => if ascii_lower(f) == "url" { return true }
              _ => ()
            }
            ti = ti + 1
          }
          di = di + 1
        }
      }
      MediaRule(_, inner) | SupportsRule(_, inner) => {
        if rules_have_url(inner) { return true }
      }
      LayerRule(_, Some(inner)) => {
        if rules_have_url(inner) { return true }
      }
      _ => ()
    }
    ri = ri + 1
  }
  false
}

fn parse_stylesheet_cached(css : String, quirks : Bool) -> (Stylesheet, Bool) {
  let cache = if quirks { parsed_sheets_quirks } else { parsed_sheets_std }
  match cache.get(css) {
    Some(entry) => return entry
    None => ()
  }
  let was = css_globals.quirks_mode
  css_globals.quirks_mode = quirks
  let sheet = parse_stylesheet(css)
  css_globals.quirks_mode = was
  let entry = (sheet, rules_have_url(sheet.rules))
  if css.length() <= 1048576 {
    if cache.length() >= 256 {
      cache.clear()
    }
    cache.set(css, entry)
  }
  entry
}

pub fn Engine::add_sheet_resolve(self : Engine, css : String, resolve : (String) -> String) -> Unit {
  let (sheet, has_url) = parse_stylesheet_cached(css, self.quirks)
  let was = css_globals.quirks_mode
  css_globals.quirks_mode = self.quirks
  self.add_rules(sheet.rules, false, resolve, maybe_url=has_url)
  css_globals.quirks_mode = was
}

fn Engine::note_beside(self : Engine, sel : Selector, top : Bool) -> Unit {
  let mut i = 0
  while i < sel.parts.length() {
    let p = sel.parts[i]
    if i > 0 {
      let prev_sib = match sel.parts[i - 1].comb { Next => true Later => true _ => false }
      if prev_sib {
        if !gather_keys(p.compound, self.beside_keys) {
          self.beside_any = true
        }
        if top && i == 1 {
          if keyed(sel.parts[0].compound) {
            let ks = compound_keys(sel.parts[0].compound)
            let mut ki = 0
            while ki < ks.length() { self.beside_right_keys.set(ks[ki], true); ki = ki + 1 }
          } else {
            self.beside_right_any = true
          }
        } else if !top {
          self.beside_right_any = true
        }
      }
    }
    if top && i > 0 && positional(p.compound, p.comb) {
      if keyed(p.compound) {
        let ks = compound_keys(p.compound)
        let mut ki = 0
        while ki < ks.length() { self.deep_keys.set(ks[ki], true); ki = ki + 1 }
      } else if !positional(p.compound, Combinator::Descendant) && i + 1 < sel.parts.length() && keyed(sel.parts[i + 1].compound) {
        let ks = compound_keys(sel.parts[i + 1].compound)
        let mut ki = 0
        while ki < ks.length() { self.deep_left.set(ks[ki], true); ki = ki + 1 }
      } else if (comb_eq(p.comb, Combinator::Child) || comb_eq(p.comb, Combinator::Descendant)) &&
      just_position(p.compound) && i + 1 < sel.parts.length() {
        let mut best_k = -1
        let mut k = i + 1
        while k < sel.parts.length() {
          if k > i + 1 && !comb_eq(sel.parts[k - 1].comb, Combinator::Child) && !comb_eq(sel.parts[k - 1].comb, Combinator::Descendant) {
            break
          }
          if keyed(sel.parts[k].compound) {
            if best_k < 0 || has_strong_key(sel.parts[k].compound) {
              best_k = k
              if has_strong_key(sel.parts[k].compound) { break }
            }
          }
          k = k + 1
        }
        if best_k >= 0 {
          let pm = pos_mask(p.compound)
          let ks = compound_keys(sel.parts[best_k].compound)
          let mut ki = 0
          while ki < ks.length() {
            let prev = self.deep_parent.get(ks[ki]).unwrap_or(0)
            self.deep_parent.set(ks[ki], prev | pm)
            ki = ki + 1
          }
          if best_k > i + 1 || comb_eq(p.comb, Combinator::Descendant) { self.deep_far = true }
        } else {
          self.deep_any = true
        }
      } else {
        self.deep_any = true
      }
    }
    let mut j = 0
    while j < p.compound.length() {
      match p.compound[j] {
        PseudoSel(name, list) => {
          if top && i == 0 && (name == "is" || name == "where" || name == "not" || name == "matches" || name == "-webkit-any") {
            let mut k = 0
            while k < list.length() { self.note_beside(list[k], true); k = k + 1 }
          } else if name == "has" {
            let mut k = 0
            while k < list.length() { self.note_beside(list[k], true); k = k + 1 }
          } else {
            let mut k = 0
            while k < list.length() {
              if top && i == 0 && beside_deep(list[k]) { self.deep_any = true }
              self.note_beside(list[k], false)
              k = k + 1
            }
          }
        }
        NthSel(_, _, _, list) => {
          let mut k = 0
          while k < list.length() {
            if top && i == 0 && beside_deep(list[k]) { self.deep_any = true }
            self.note_beside(list[k], false)
            k = k + 1
          }
        }
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
}

fn Engine::note_has(self : Engine, sel : Selector, inside : Option[HasUse], outer : Array[Simple], deep : Bool) -> Unit {
  match inside {
    Some(u) => match sel.relative { Next => u.beside = true Later => u.beside = true _ => () }
    None => ()
  }
  let mut i = 0
  while i < sel.parts.length() {
    let p = sel.parts[i]
    let own = if i == 0 && outer.length() > 0 {
      let tmp = copy_simples(p.compound)
      let mut oi = 0
      while oi < outer.length() { tmp.push(outer[oi]); oi = oi + 1 }
      tmp
    } else {
      p.compound
    }
    match inside {
      Some(u) => {
        match p.comb { Next => u.beside = true Later => u.beside = true _ => () }
        let mut j = 0
        while j < p.compound.length() {
          match p.compound[j] {
            TypeSel(t) => u.keys.set(ascii_lower(t), true)
            IdSel(id) => u.keys.set("#" + id, true)
            ClassSel(c, _) => u.keys.set("." + c, true)
            AttrSel(name, op, value, ci) => {
              let ln = ascii_lower(name)
              u.keys.set("[" + ln, true)
              let test_item = HasAttrTest::{ op: op, value: value, ci: ci }
              match u.attrs.get(ln) {
                Some(a) => a.push(test_item)
                None => u.attrs.set(ln, [test_item])
              }
            }
            NthSel(_, _, _, _) => u.indexed = true
            PseudoSel(nm, _) => {
              if nm == "first-child" || nm == "last-child" || nm == "only-child" ||
              nm == "first-of-type" || nm == "last-of-type" || nm == "only-of-type" {
                u.indexed = true
              }
              if nm == "empty" || nm == "blank" {
                u.empty = true
                if keyed(p.compound) {
                  let ks = compound_keys(p.compound)
                  let mut ki = 0
                  while ki < ks.length() { u.empty_keys.set(ks[ki], true); ki = ki + 1 }
                } else {
                  u.empty_any = true
                }
              }
            }
            _ => ()
          }
          j = j + 1
        }
        if !keyed(p.compound) { u.any = true }
      }
      None => ()
    }
    let mut j = 0
    while j < p.compound.length() {
      match p.compound[j] {
        PseudoSel(name, list) => {
          if name == "has" {
            let u = HasUse::{
              anchor: Map::new(),
              anchor_any: !keyed(own),
              keys: Map::new(),
              any: false,
              beside: false,
              attrs: Map::new(),
              empty: false,
              empty_keys: Map::new(),
              empty_any: false,
              indexed: false,
              deep: deep || i > 0 || inside.is_some(),
              deep_keys: Map::new(),
              deep_any: false,
            }
            let ks = compound_keys(own)
            let mut ki = 0
            while ki < ks.length() { u.anchor.set(ks[ki], true); ki = ki + 1 }
            self.has_uses.push(u)
            let mut ti = 0
            while ti < list.length() { self.note_has(list[ti], Some(u), [], false); ti = ti + 1 }
            match inside {
              Some(o) => {
                ti = 0
                while ti < list.length() { self.note_has(list[ti], Some(o), [], false); ti = ti + 1 }
              }
              None => ()
            }
          } else {
            let mut ti = 0
            while ti < list.length() { self.note_has(list[ti], inside, own, deep || i > 0); ti = ti + 1 }
          }
        }
        NthSel(_, _, _, list) => {
          let mut ti = 0
          while ti < list.length() { self.note_has(list[ti], inside, own, deep || i > 0); ti = ti + 1 }
        }
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
}

fn Engine::note_below(self : Engine, sel : Selector) -> Unit {
  let targets = if sel.parts.length() > 0 { subject_targets(sel.parts[0].compound) } else { None }
  self.note_below_with(sel, targets)
}

fn Engine::note_below_with(self : Engine, sel : Selector, targets : Option[Array[SubjectKey]]) -> Unit {
  let record = fn(keys : Map[String, Bool], wild : Bool) -> Unit {
    let ks = keys.keys()
    let mut ki = 0
    while ki < ks.length() {
      let k = ks[ki]
      self.below_keys.set(k, true)
      if wild {
        self.below_wild.set(k, true)
      } else {
        match targets {
          Some(ts) => {
            if !self.below_wild.contains(k) {
              match self.below_targets.get(k) {
                Some(set) => set.add_all(ts)
                None => {
                  let set = TargetSet::new()
                  set.add_all(ts)
                  self.below_targets.set(k, set)
                }
              }
            }
          }
          None => self.below_wild.set(k, true)
        }
      }
      ki = ki + 1
    }
  }
  let mut i = 0
  while i < sel.parts.length() {
    let p = sel.parts[i]
    if i > 0 {
      let keys : Map[String, Bool] = Map::new()
      if !gather_keys(p.compound, keys) { self.below_any = true }
      record(keys, false)
    } else {
      let mut j = 0
      while j < p.compound.length() {
        match p.compound[j] {
          PseudoSel(name, list) => {
            if name == "has" || name == "host" || name == "host-context" || name == "slotted" {
              let mut ti = 0
              while ti < list.length() {
                let t = list[ti]
                let mut qi = 0
                while qi < t.parts.length() {
                  let keys : Map[String, Bool] = Map::new()
                  if !gather_keys(t.parts[qi].compound, keys) { self.below_any = true }
                  record(keys, true)
                  qi = qi + 1
                }
                ti = ti + 1
              }
            } else {
              let mut ti = 0
              while ti < list.length() { self.note_below_with(list[ti], targets); ti = ti + 1 }
            }
          }
          NthSel(_, _, _, list) => {
            let mut ti = 0
            while ti < list.length() { self.note_below_with(list[ti], targets); ti = ti + 1 }
          }
          _ => ()
        }
        j = j + 1
      }
    }
    i = i + 1
  }
}

fn note_state_target(
  sel : Selector,
  pseudo : String,
  bit : Int,
  targets : Array[Selector],
  by_key : Map[String, Array[Selector]],
  any : Array[Selector],
) -> Unit {
  let mut added_any = false
  let mut i = 0
  while i < sel.parts.length() {
    let p = sel.parts[i]
    let mut has_s = false
    let mut in_func = false
    let rest : Array[Simple] = []
    let mut j = 0
    while j < p.compound.length() {
      match p.compound[j] {
        PseudoSel(nm, args) => {
          if nm == pseudo {
            has_s = true
          } else {
            let mut k = 0
            while k < args.length() {
              if (state_bits_of(args[k]) & bit) != 0 {
                in_func = true
                break
              }
              k = k + 1
            }
            rest.push(p.compound[j])
          }
        }
        NthSel(_, _, _, args) => {
          let mut k = 0
          while k < args.length() {
            if (state_bits_of(args[k]) & bit) != 0 {
              in_func = true
              break
            }
            k = k + 1
          }
          rest.push(p.compound[j])
        }
        _ => rest.push(p.compound[j])
      }
      j = j + 1
    }
    if in_func && !added_any {
      let univ = Selector::{
        parts: [SelPart::{ compound: [Universal], comb: Combinator::Descendant }],
        specificity: 0,
        pseudo_element: "",
        relative: sel.relative,
      }
      targets.push(univ)
      any.push(univ)
      added_any = true
    }
    if has_s {
      let parts : Array[SelPart] = [SelPart::{ compound: if rest.length() == 0 { [Universal] } else { rest }, comb: p.comb }]
      let mut q = i + 1
      while q < sel.parts.length() { parts.push(sel.parts[q]); q = q + 1 }
      let t = Selector::{ parts: parts, specificity: 0, pseudo_element: "", relative: sel.relative }
      targets.push(t)
      let mut key : Option[String] = None
      let c0 = parts[0].compound
      let mut ci = 0
      while ci < c0.length() && key.is_none() {
        match c0[ci] {
          IdSel(id) => key = Some("#" + id)
          ClassSel(k, _) => key = Some("." + k)
          TypeSel(tn) => key = Some(ascii_lower(tn))
          _ => ()
        }
        ci = ci + 1
      }
      match key {
        Some(k) => match by_key.get(k) {
          Some(a) => a.push(t)
          None => by_key.set(k, [t])
        }
        None => any.push(t)
      }
    }
    i = i + 1
  }
}

fn Engine::note_hover(self : Engine, sel : Selector) -> Unit {
  note_state_target(sel, "hover", 32, self.hover_targets, self.hover_by_key, self.hover_any)
}

fn Engine::note_active(self : Engine, sel : Selector) -> Unit {
  note_state_target(sel, "active", 64, self.active_targets, self.active_by_key, self.active_any)
}

fn Engine::note_sel_attrs(self : Engine, sel : Selector) -> Unit {
  let mut i = 0
  while i < sel.parts.length() {
    let comp = sel.parts[i].compound
    let mut j = 0
    while j < comp.length() {
      match comp[j] {
        AttrSel(name, _, _, _) => {
          if str_contains(name, "|") { self.has_ns_attr = true }
          else { self.used_attrs.set(ascii_lower(name), true) }
        }
        PseudoSel(_, args) => {
          let mut k = 0
          while k < args.length() { self.note_sel_attrs(args[k]); k = k + 1 }
        }
        NthSel(_, _, _, args) => {
          let mut k = 0
          while k < args.length() { self.note_sel_attrs(args[k]); k = k + 1 }
        }
        _ => ()
      }
      j = j + 1
    }
    i = i + 1
  }
}

fn Engine::bucket(self : Engine, e : Entry) -> Unit {
  if e.attr_fn { self.has_attr_fn_flag = true }
  self.note_sel_attrs(e.sel)
  let pe = e.sel.pseudo_element
  let mut by_id = self.by_id
  let mut by_class = self.by_class
  let mut by_tag = self.by_tag
  let mut by_attr = self.by_attr
  let mut roots = self.roots
  let mut rest = self.rest
  let mut pi_opt : Option[PseudoIndex] = None
  if pe != "" {
    if e.has_content {
      if pe == "before" {
        self.has_before_content = true
        self.before_content.add(subject_keys(e.sel.parts[0].compound))
      } else if pe == "after" {
        self.has_after_content = true
        self.after_content.add(subject_keys(e.sel.parts[0].compound))
      }
    }
    if pe == "first-line" { self.has_first_line = true }
    if pe == "first-letter" { self.has_first_letter = true }
    if pe == "placeholder" { self.has_placeholder = true }
    if pe == "-webkit-scrollbar" { self.has_webkit_scrollbar = true }
    if pe == "-webkit-slider-runnable-track" || pe == "-webkit-slider-thumb" || pe == "-moz-range-track" || pe == "-moz-range-thumb" {
      self.has_slider_pseudo = true
    }
    if pe == "part" { self.has_parts = true }
    let pi = match self.pseudo_index {
      Some(p) => p
      None => {
        let p = PseudoIndex::new()
        self.pseudo_index = Some(p)
        p
      }
    }
    pi_opt = Some(pi)
    by_id = pi.by_id
    by_class = pi.by_class
    by_tag = pi.by_tag
    by_attr = pi.by_attr
    roots = pi.roots
    rest = pi.rest
  }
  match subject_keys(e.sel.parts[0].compound) {
    Some(keys) => {
      if keys.length() > 1 { self.multi = true }
      let mut i = 0
      while i < keys.length() {
        let kk = keys[i]
        if kk.kind == 4 {
          roots.push(e)
        } else {
          if kk.kind == 3 {
            if kk.key == "id" {
              match pi_opt { Some(pi) => pi.by_attr_has_id = true None => self.by_attr_has_id = true }
            } else if kk.key == "class" {
              match pi_opt { Some(pi) => pi.by_attr_has_class = true None => self.by_attr_has_class = true }
            }
          }
          let m = if kk.kind == 0 { by_id } else if kk.kind == 1 { by_class } else if kk.kind == 2 { by_tag } else { by_attr }
          match m.get(kk.key) {
            Some(a) => a.push(e)
            None => m.set(kk.key, [e])
          }
        }
        i = i + 1
      }
    }
    None => rest.push(e)
  }
}

fn Engine::add_face(self : Engine, f : FontFace, decls : Array[Decl]) -> Unit {
  let parts : Array[String] = []
  let mut i = 0
  while i < decls.length() {
    let d = decls[i]
    if d.name != "src" && d.name != "font-display" {
      parts.push(d.name + ":" + serialize_value(d.value))
    }
    i = i + 1
  }
  sort_strings(parts)
  let key = f.family + "|" + str_join(parts, ";")
  let layer = self.cur_layer
  i = 0
  while i < self.faces.length() {
    if self.face_keys[i] == key {
      if layer_cmp(self.face_layers[i], layer) > 0 { return }
      let nf : Array[FontFace] = []
      let nk : Array[String] = []
      let nl : Array[Array[Int]] = []
      let mut j = 0
      while j < self.faces.length() {
        if j != i {
          nf.push(self.faces[j])
          nk.push(self.face_keys[j])
          nl.push(self.face_layers[j])
        }
        j = j + 1
      }
      self.faces = nf
      self.face_keys.clear()
      j = 0
      while j < nk.length() { self.face_keys.push(nk[j]); j = j + 1 }
      self.face_layers.clear()
      j = 0
      while j < nl.length() { self.face_layers.push(nl[j]); j = j + 1 }
      break
    }
    i = i + 1
  }
  let mut at = self.faces.length()
  while at > 0 && layer_cmp(self.face_layers[at - 1], layer) > 0 { at = at - 1 }
  self.faces.push(f)
  self.face_keys.push(key)
  self.face_layers.push(layer)
  let mut j = self.faces.length() - 1
  while j > at {
    self.faces[j] = self.faces[j - 1]
    self.face_keys[j] = self.face_keys[j - 1]
    self.face_layers[j] = self.face_layers[j - 1]
    j = j - 1
  }
  self.faces[at] = f
  self.face_keys[at] = key
  self.face_layers[at] = layer
}

fn Engine::add_feature_values(self : Engine, pre : Array[Tok], body : Array[Tok]) -> Unit {
  let families : Array[String] = []
  let mut cur = StringBuilder::new()
  let mut has_cur = false
  let mut i = 0
  while i < pre.length() {
    match pre[i] {
      Ident(w) => {
        if has_cur { cur.write_char((32).unsafe_to_char()) }
        cur.write_string(ascii_lower(w))
        has_cur = true
      }
      Str(w) => {
        if has_cur { cur.write_char((32).unsafe_to_char()) }
        cur.write_string(ascii_lower(w))
        has_cur = true
      }
      Comma => {
        families.push(cur.to_string())
        cur = StringBuilder::new()
        has_cur = false
      }
      _ => ()
    }
    i = i + 1
  }
  families.push(cur.to_string())
  i = 0
  while i < body.length() {
    match body[i] {
      AtKeyword(block) => {
        while i < body.length() && !tok_eq(body[i], OpenCurly) { i = i + 1 }
        i = i + 1
        let mut name = ""
        let nums : Array[Int] = []
        let lblock = ascii_lower(block)
        while i < body.length() && !tok_eq(body[i], CloseCurly) {
          match body[i] {
            Ident(n) => name = ascii_lower(n)
            Number(v) => nums.push(fvdmath::d2i(v))
            Semicolon => {
              if name != "" {
                let mut fi = 0
                while fi < families.length() {
                  let cp : Array[Int] = []
                  let mut ni = 0
                  while ni < nums.length() { cp.push(nums[ni]); ni = ni + 1 }
                  self.feature_values_map.set(families[fi] + "/" + lblock + "/" + name, cp)
                  fi = fi + 1
                }
              }
              name = ""
              nums.clear()
            }
            _ => ()
          }
          i = i + 1
        }
        if name != "" {
          let mut fi = 0
          while fi < families.length() {
            let cp : Array[Int] = []
            let mut ni = 0
            while ni < nums.length() { cp.push(nums[ni]); ni = ni + 1 }
            self.feature_values_map.set(families[fi] + "/" + lblock + "/" + name, cp)
            fi = fi + 1
          }
        }
      }
      _ => ()
    }
    i = i + 1
  }
}

fn Engine::add_rules(self : Engine, rules : Array[Rule], ua : Bool, resolve : (String) -> String, maybe_url~ : Bool = true) -> Unit {
  self.share_gen = next_share_gen()
  let mut ri = 0
  while ri < rules.length() {
    match rules[ri] {
      StyleRule(sels, decls0) => {
        let mut any_u = false
        let mut di = 0
        if maybe_url {
          while di < decls0.length() && !any_u {
            let dv = decls0[di].value
            let mut ti = 0
            while ti < dv.length() {
              match dv[ti] {
                Url(_) => { any_u = true; break }
                Function(f) => if ascii_lower(f) == "url" { any_u = true; break }
                _ => ()
              }
              ti = ti + 1
            }
            di = di + 1
          }
        }
        let decls : Array[Decl] = if !any_u {
          decls0
        } else {
          let out : Array[Decl] = []
          di = 0
          while di < decls0.length() {
            let d = decls0[di]
            let mut has_u = false
            let mut ti = 0
            while ti < d.value.length() {
              match d.value[ti] {
                Url(_) => { has_u = true; break }
                Function(f) => if ascii_lower(f) == "url" { has_u = true; break }
                _ => ()
              }
              ti = ti + 1
            }
            if has_u {
              let v : Array[Tok] = []
              let mut in_url = false
              ti = 0
              while ti < d.value.length() {
                match d.value[ti] {
                  Url(u) => v.push(Url(resolve(u)))
                  Function(f) => {
                    if ascii_lower(f) == "url" { in_url = true }
                    v.push(d.value[ti])
                  }
                  Str(u) => {
                    if in_url {
                      in_url = false
                      v.push(Str(resolve(u)))
                    } else {
                      v.push(d.value[ti])
                    }
                  }
                  _ => v.push(d.value[ti])
                }
                ti = ti + 1
              }
              out.push(Decl::{ name: d.name, value: v, important: d.important, longhands: None, var_memo: None })
            } else {
              out.push(d)
            }
            di = di + 1
          }
          out
        }
        if !self.viewport_units {
          di = 0
          while di < decls.length() {
            if in_viewport_units(decls[di].value) { self.viewport_units = true; break }
            di = di + 1
          }
        }
        if !self.has_cq {
          di = 0
          while di < decls.length() {
            if in_cq_units(decls[di].value) { self.has_cq = true; break }
            di = di + 1
          }
        }
        let mut has_vars = false
        let mut has_important = false
        let mut has_content = false
        let mut has_attr = false
        di = 0
        while di < decls.length() {
          let d = decls[di]
          if !self.has_transitions_flag && (d.name == "transition" || d.name == "transition-duration" || d.name == "transition-property") {
            self.has_transitions_flag = true
          }
          if str_has_prefix(d.name, "--") {
            if !has_vars { has_vars = true }
            if !self.has_var_revert_layer && has_revert_layer_tok(d.value) {
              self.has_var_revert_layer = true
            }
          }
          if !has_important && d.important { has_important = true }
          if !has_content && d.name == "content" { has_content = true }
          if !has_attr && has_attr_fn(d.value) { has_attr = true }
          di = di + 1
        }
        let mut si = 0
        while si < sels.length() {
          let sel = sels[si]
          self.note_below(sel)
          let sb = state_bits_of(sel)
          self.state_bits = self.state_bits | sb
          if (sb & 32) != 0 { self.note_hover(sel) }
          if (sb & 64) != 0 { self.note_active(sel) }
          if looks_beside(sel) { self.sibling_rules = true }
          if looks_beside(sel) || beside_deep(sel) { self.note_beside(sel, true) }
          if looks_below(sel) {
            self.has_rules = true
            let before = self.has_uses.length()
            self.note_has(sel, None, [], false)
            let subject = sel.parts[0].compound
            let mut ui = before
            while ui < self.has_uses.length() {
              let u = self.has_uses[ui]
              if u.deep {
                if keyed(subject) {
                  let ks = compound_keys(subject)
                  let mut ki = 0
                  while ki < ks.length() { u.deep_keys.set(ks[ki], true); ki = ki + 1 }
                } else {
                  u.deep_any = true
                }
              }
              ui = ui + 1
            }
            let mut deep_h = false
            let mut pi = 1
            while pi < sel.parts.length() {
              let sub_sel = Selector::{ parts: [sel.parts[pi]], specificity: 0, pseudo_element: "", relative: Combinator::Descendant }
              if looks_below(sub_sel) { deep_h = true; break }
              pi = pi + 1
            }
            if !deep_h {
              let c0 = sel.parts[0].compound
              let mut ci = 0
              while ci < c0.length() {
                match c0[ci] {
                  PseudoSel(nm, list) => {
                    if nm != "has" {
                      let mut li = 0
                      while li < list.length() {
                        if list[li].parts.length() > 1 && looks_below(list[li]) { deep_h = true; break }
                        li = li + 1
                      }
                    }
                  }
                  _ => ()
                }
                ci = ci + 1
              }
            }
            if deep_h { self.has_deep = true }
          }
          self.order = self.order + 1
          let need_strs = ancestor_needs(sel)
          let need : Array[Int] = []
          let mut ni = 0
          while ni < need_strs.length() { need.push(key_id(need_strs[ni])); ni = ni + 1 }
          let e = Entry::{
            sel: sel,
            decls: decls,
            order: self.order,
            ua: ua,
            layer: self.cur_layer,
            need: need,
            attr_fn: has_attr,
            has_vars: has_vars,
            has_important: has_important,
            has_content: has_content,
            cq: self.cur_cq,
            single_list: None,
          }
          self.bucket(e)
          si = si + 1
        }
      }
      MediaRule(q, inner) => {
        let is_cq = q.length() > 0 && match q[0] { Ident(m) => m == container_marker _ => false }
        if is_cq {
          let was = self.cur_cq
          self.cur_cq = Some(tok_slice(q, 1, q.length()))
          self.has_cq = true
          self.add_rules(inner, ua, resolve, maybe_url=maybe_url)
          self.cur_cq = was
        } else if self.media_said(q) {
          self.add_rules(inner, ua, resolve, maybe_url=maybe_url)
        }
      }
      SupportsRule(q, inner) => {
        if supports_matches(q) { self.add_rules(inner, ua, resolve, maybe_url=maybe_url) }
      }
      FontFaceRule(decls) => {
        match font_face_of(decls, resolve) {
          Some(f) => self.add_face(f, decls)
          None => ()
        }
      }
      FeatureValuesRule(pre, body) => self.add_feature_values(pre, body)
      KeyframesRule(name, frames) => self.keyframes_map.set(name, frames)
      PropertyRule(name, decls) => {
        match property_rule(decls) {
          Some(r) => self.registered.set(name, r)
          None => ()
        }
      }
      LayerRule(names, body_opt) => {
        match body_opt {
          None => {
            let mut ni = 0
            while ni < names.length() { let _ = self.layer_path(names[ni]); ni = ni + 1 }
          }
          Some(inner) => {
            let first = if names.length() > 0 { names[0] } else { "" }
            let lp = self.layer_path(first)
            let sp = self.cur_layer
            let sk = self.cur_key
            self.cur_layer = lp.path
            self.cur_key = lp.key
            self.add_rules(inner, ua, resolve, maybe_url=maybe_url)
            self.cur_layer = sp
            self.cur_key = sk
          }
        }
      }
      OtherRule => ()
    }
    ri = ri + 1
  }
}

pub fn Engine::font_faces(self : Engine) -> Array[FontFace] { self.faces }
pub fn Engine::keyframes_named(self : Engine, name : String) -> Option[Array[Keyframe]] { self.keyframes_map.get(name) }
pub fn Engine::has_keyframes(self : Engine) -> Bool { self.keyframes_map.length() > 0 }
pub fn Engine::has_transitions(self : Engine) -> Bool { self.has_transitions_flag }
pub fn Engine::feature_values(self : Engine) -> Map[String, Array[Int]] { self.feature_values_map }
pub fn Engine::rule_count(self : Engine) -> Int { self.order }
pub fn Engine::set_order(self : Engine, order : Int) -> Unit { self.order = order }
pub fn Engine::registered_count(self : Engine) -> Int { self.registered.length() }
pub fn Engine::kept_count(self : Engine) -> Int { self.matched.len() }
pub fn Engine::has_container_rules(self : Engine) -> Bool { self.has_cq }
pub fn Engine::asks_states(self : Engine, bits : Int) -> Bool { (self.state_bits & bits) != 0 }
pub fn Engine::asks_attr(self : Engine, name : String) -> Bool { self.has_attr_fn_flag || self.has_ns_attr || self.used_attrs.contains(ascii_lower(name)) }
pub fn Engine::asks_hover(self : Engine) -> Bool { self.hover_targets.length() > 0 }

pub fn Engine::asks_active(self : Engine) -> Bool { self.active_targets.length() > 0 }
pub fn Engine::is_restyle_dirty(self : Engine, uid : Int) -> Bool { self.restyle_dirty.contains(uid) }
pub fn Engine::clear_restyle_dirty(self : Engine) -> Unit { self.restyle_dirty.clear() }

///| Break internal `Style.parent` <-> `Style.kids` / `Style.text` cycles for Biased RC cleanup.
pub fn drop_style_tree(root : Style) -> Unit {
  let walk : Array[Style] = [root]
  while walk.length() > 0 {
    match walk.pop() {
      Some(s) => {
        s.inherit_from = None
        match s.text {
          Some(t) => {
            s.text = None
            walk.push(t)
          }
          None => ()
        }
        match s.kid0_val {
          Some(k0) => {
            s.kid0_key = ""
            s.kid0_val = None
            walk.push(k0)
          }
          None => ()
        }
        match s.kid1_val {
          Some(k1) => {
            s.kid1_key = ""
            s.kid1_val = None
            walk.push(k1)
          }
          None => ()
        }
        match s.kid2_val {
          Some(k2) => {
            s.kid2_key = ""
            s.kid2_val = None
            walk.push(k2)
          }
          None => ()
        }
        match s.kid3_val {
          Some(k3) => {
            s.kid3_key = ""
            s.kid3_val = None
            walk.push(k3)
          }
          None => ()
        }
        s.kids_gen = -1
        match s.kids {
          Some(mp) => {
            s.kids = None
            for mk in mp.keys() {
              match mp.get(mk) {
                Some(cs) => walk.push(cs)
                None => ()
              }
            }
          }
          None => ()
        }
      }
      None => break
    }
  }
}

///| Break all cached `Style` cycles and release engine caches for Biased RC cleanup.
pub fn Engine::dispose(self : Engine) -> Unit {
  for k in self.styled.keys() {
    match intmap::get(self.styled, k) {
      Some(se) => {
        drop_style_tree(se.style)
        match se.parent {
          Some(p) => drop_style_tree(p)
          None => ()
        }
      }
      None => ()
    }
  }
  self.styled.clear()
  self.matched.clear()
  self.pair_lists.clear()
  self.matched_nodes.clear()
  self.restyle_dirty.clear()
}

pub fn Engine::knows(self : Engine, n : html::Node) -> Bool {
  if !n.ever_styled { return false }
  self.matched.contains(n.uid) || self.styled.contains(n.uid) || self.matched_nodes.contains(n.uid)
}

fn Engine::forget_one(self : Engine, x : html::Node, why : Int) -> Unit {
  if !x.ever_styled { return }
  if self.matched.delete(x.uid) { forget_counts[why] = forget_counts[why] + 1 }
  let _ = self.matched_nodes.delete(x.uid)
}

fn Engine::forget_subtree_rec(self : Engine, x : html::Node, why : Int, include_shadow : Bool) -> Unit {
  if x.ever_styled {
    if self.matched.delete(x.uid) { forget_counts[why] = forget_counts[why] + 1 }
    let _ = self.styled.delete(x.uid)
    let _ = self.matched_nodes.delete(x.uid)
  }
  let children = x.children
  let n = children.length()
  let mut i = 0
  while i < n {
    let c = children[i]
    if c.kind != html::Kind::Text && c.kind != html::Kind::Comment {
      if c.children.length() == 0 {
        if c.ever_styled {
          if self.matched.delete(c.uid) { forget_counts[why] = forget_counts[why] + 1 }
          let _ = self.styled.delete(c.uid)
          let _ = self.matched_nodes.delete(c.uid)
        }
      } else {
        self.forget_subtree_rec(c, why, false)
      }
    }
    i = i + 1
  }
  if include_shadow {
    match x.get_shadow() {
      Some(r) => self.forget_subtree_rec(r, why, false)
      None => ()
    }
  }
}

fn Engine::forget_subtree(self : Engine, n : html::Node, why : Int) -> Unit {
  if self.matched.is_empty() && self.styled.is_empty() && self.matched_nodes.is_empty() {
    return
  }
  self.forget_subtree_rec(n, why, true)
}

pub fn Engine::forget_subtree_of(self : Engine, n : html::Node) -> Unit {
  self.forget_subtree(n, 3)
}

pub fn Engine::forget_all(self : Engine) -> Unit {
  if !self.matched.is_empty() { match_counts[3] = match_counts[3] + 1 }
  self.share_gen = next_share_gen()
  self.matched.clear()
  self.pair_lists.clear()
  self.styled.clear()
  self.restyle_dirty.clear()
}

fn Engine::mark_restyle_dirty(self : Engine, x : html::Node, stop : html::Node) -> Unit {
  let mut cur : Option[html::Node] = Some(x)
  while true {
    match cur {
      Some(y) => {
        if self.restyle_dirty.contains(y.uid) { break }
        self.restyle_dirty.set(y.uid, true)
        if y.uid == stop.uid { break }
        cur = match y.parent { Some(p) => Some(p) None => y.get_host() }
      }
      None => break
    }
  }
}

fn Engine::forget_keyed(self : Engine, x : html::Node, u : HasUse) -> Unit {
  if u.deep_any {
    self.forget_subtree(x, 0)
    return
  }
  let walk : Array[html::Node] = [x]
  while walk.length() > 0 {
    match walk.pop() {
      Some(y) => {
        if has_any_key(y, u.deep_keys) {
          self.forget_one(y, 0)
          self.mark_restyle_dirty(y, x)
        }
        let mut i = 0
        while i < y.children.length() { walk.push(y.children[i]); i = i + 1 }
        match y.get_shadow() { Some(r) => walk.push(r) None => () }
      }
      None => break
    }
  }
}

fn Engine::forget_below_targeted(self : Engine, n : html::Node, ck : Array[String]) -> Unit {
  let sets : Array[TargetSet] = []
  let mut ki = 0
  let kn = ck.length()
  while ki < kn {
    match self.below_targets.get(ck[ki]) {
      Some(ts) => sets.push(ts)
      None => ()
    }
    ki = ki + 1
  }
  if sets.length() == 0 { return }
  let walk : Array[html::Node] = []
  let mut i = 0
  while i < n.children.length() {
    if n.children[i].kind == html::Kind::Element { walk.push(n.children[i]) }
    i = i + 1
  }
  match n.get_shadow() { Some(r) => walk.push(r) None => () }
  while walk.length() > 0 {
    match walk.pop() {
      Some(x) => {
        if x.kind == html::Kind::Element {
          let mut hit = false
          let mut si = 0
          while si < sets.length() {
            if sets[si].matches(x) { hit = true; break }
            si = si + 1
          }
          if hit {
            self.forget_one(x, 1)
            self.mark_restyle_dirty(x, n)
          }
        }
        let mut ci = 0
        while ci < x.children.length() {
          if x.children[ci].kind == html::Kind::Element { walk.push(x.children[ci]) }
          ci = ci + 1
        }
      }
      None => break
    }
  }
}

fn Engine::beside_hit(self : Engine, n : html::Node, attr : Option[AttrChange]) -> Bool {
  match attr {
    None => true
    Some(ac) => {
      if self.beside_any { return true }
      if self.beside_keys.length() == 0 { return false }
      changed_keys_into_ws(n, ac.name, ac.value, self.changed_keys_buf, self.ck_old_ws_buf, self.ck_new_ws_buf)
      let hit = meets_arr(self.changed_keys_buf, self.beside_keys)
      self.changed_keys_buf.clear()
      hit
    }
  }
}

fn Engine::parent_deep_mask(self : Engine, n : html::Node) -> Int {
  if self.deep_parent.length() == 0 { return 0 }
  let mut m = has_any_key_mask(n, self.deep_parent)
  if (m & 4) != 0 || !self.deep_far { return m }
  let mut p = n.parent
  while true {
    match p {
      Some(x) => {
        m = m | has_any_key_mask(x, self.deep_parent)
        if (m & 4) != 0 { return m }
        p = x.parent
      }
      None => break
    }
  }
  m
}

fn Engine::deep_at(self : Engine, c : html::Node) -> Bool {
  self.deep_any || (self.deep_keys.length() > 0 && has_any_key(c, self.deep_keys))
}

fn Engine::has_relevant(self : Engine, n : html::Node, children_changed : Bool, attr : Option[AttrChange], moved : Option[html::Node]) -> Bool {
  let s = HasScope::new(n, children_changed, attr, moved)
  let mut i = 0
  while i < self.has_uses.length() {
    if self.has_uses[i].relevant(s) { return true }
    i = i + 1
  }
  false
}

pub fn Engine::forget(
  self : Engine,
  n : html::Node,
  children_changed : Bool,
  attr : Option[(String, String)],
  moved : Option[html::Node],
  has_known : Bool,
) -> Unit {
  match attr {
    None => n.invalidate_class()
    Some(kv) => if kv.0 == "class" { n.invalidate_class() }
  }
  if self.matched.is_empty() { return }
  let ac = match attr { Some(kv) => Some(AttrChange::{ name: kv.0, value: kv.1 }) None => None }
  let has = self.has_rules && !has_known && self.has_relevant(n, children_changed, ac, moved)
  if self.has_deep && has {
    let s = HasScope::new(n, children_changed, ac, moved)
    let mut ui = 0
    while ui < self.has_uses.length() {
      let u = self.has_uses[ui]
      if !u.relevant(s) { ui = ui + 1; continue }
      if !u.deep {
        if u.beside && moved.is_some() {
          let mut ci = 0
          while ci < n.children.length() { self.forget_one(n.children[ci], 0); ci = ci + 1 }
        }
        ui = ui + 1
        continue
      }
      if u.anchor_any {
        match_counts[2] = match_counts[2] + 1
        self.matched.clear()
        self.pair_lists.clear()
        self.styled.clear()
        return
      }
      let anchors = u.anchors_near(n, moved.is_some())
      let mut ai = 0
      while ai < anchors.length() {
        let a = anchors[ai]
        self.forget_one(a, 0)
        self.forget_keyed(a, u)
        match a.parent {
          Some(q) => {
            let mut after = false
            let mut ci = 0
            while ci < q.children.length() {
              let c = q.children[ci]
              if after { self.forget_keyed(c, u) }
              else if c.uid == a.uid { after = true }
              ci = ci + 1
            }
          }
          None => ()
        }
        ai = ai + 1
      }
      ui = ui + 1
    }
  }
  let mut ck_ready = false
  if children_changed && moved.is_some() && !self.deep_any {
    self.forget_one(n, 1)
    let moved_is_el = match moved {
      Some(x) => x.kind == html::Kind::Element
      None => true
    }
    if moved_is_el {
      let p_mask = self.parent_deep_mask(n)
      let mut left_all = (p_mask & 4) != 0
      if !left_all && self.deep_left.length() > 0 {
        match moved {
          Some(x) => if has_any_key(x, self.deep_left) { left_all = true }
          None => ()
        }
        if !left_all {
          let mut ci = 0
          while ci < n.children.length() {
            if has_any_key(n.children[ci], self.deep_left) { left_all = true; break }
            ci = ci + 1
          }
        }
      }
      let mut first1 = -1
      let mut first2 = -1
      let mut last1 = -1
      let mut last2 = -1
      if !left_all && (p_mask & 3) != 0 {
        let mut ci = 0
        while ci < n.children.length() {
          if n.children[ci].kind == html::Kind::Element {
            if first1 < 0 { first1 = ci }
            else if first2 < 0 { first2 = ci }
            last2 = last1
            last1 = ci
          }
          ci = ci + 1
        }
      }
      let want_first = (p_mask & 1) != 0
      let want_last = (p_mask & 2) != 0
      let mut ci = 0
      while ci < n.children.length() {
        let c = n.children[ci]
        if c.kind == html::Kind::Element {
          let need_sub = left_all ||
          (want_first && (ci == first1 || ci == first2)) ||
          (want_last && (ci == last1 || ci == last2)) ||
          self.deep_at(c)
          if need_sub { self.forget_subtree(c, 1) } else { self.forget_one(c, 1) }
        }
        ci = ci + 1
      }
    }
  } else {
    let mut handled_attr = false
    match ac {
      Some(a) => {
        let lname = ascii_lower(a.name)
        if !children_changed && moved.is_none() && !self.below_any &&
        lname != "lang" && lname != "xml:lang" && lname != "dir" && lname != "slot" {
          handled_attr = true
          if self.below_keys.length() == 0 {
            self.forget_one(n, 1)
          } else {
            if !ck_ready {
              changed_keys_into_ws(n, a.name, a.value, self.changed_keys_buf, self.ck_old_ws_buf, self.ck_new_ws_buf)
              ck_ready = true
            }
            if !meets_arr(self.changed_keys_buf, self.below_keys) {
              self.forget_one(n, 1)
            } else if !self.quirks && !meets_arr(self.changed_keys_buf, self.below_wild) {
              self.forget_one(n, 1)
              self.forget_below_targeted(n, self.changed_keys_buf)
            } else {
              self.forget_subtree(n, 1)
            }
          }
        }
      }
      None => ()
    }
    if !handled_attr {
      self.forget_subtree(n, 1)
    }
  }
  if !children_changed && self.sibling_rules {
    let beside_ok = match ac {
      None => true
      Some(a) =>
      if self.beside_any {
        true
      } else if self.beside_keys.length() == 0 {
        false
      } else {
        if !ck_ready {
          changed_keys_into_ws(n, a.name, a.value, self.changed_keys_buf, self.ck_old_ws_buf, self.ck_new_ws_buf)
          ck_ready = true
        }
        meets_arr(self.changed_keys_buf, self.beside_keys)
      }
    }
    if beside_ok {
      let left = self.deep_left.length() > 0 && match ac {
        Some(a) => {
          if !ck_ready {
            changed_keys_into_ws(n, a.name, a.value, self.changed_keys_buf, self.ck_old_ws_buf, self.ck_new_ws_buf)
            ck_ready = true
          }
          meets_arr(self.changed_keys_buf, self.deep_left)
        }
        None => has_any_key(n, self.deep_left)
      }
      match n.parent {
        Some(p) => {
          let mut after = false
          let mut ci = 0
          while ci < p.children.length() {
            let c = p.children[ci]
            if after {
              if c.kind == html::Kind::Element {
                if left || self.deep_at(c) {
                  self.forget_subtree(c, 2)
                } else if self.beside_right_any || has_any_key(c, self.beside_right_keys) {
                  self.forget_one(c, 2)
                }
              }
            } else if c.uid == n.uid {
              after = true
            }
            ci = ci + 1
          }
        }
        None => ()
      }
    }
  }
  if ck_ready { self.changed_keys_buf.clear() }
  if self.has_rules {
    let mut p : Option[html::Node] = Some(n)
    while true {
      match p {
        Some(x) => {
          let _ = self.matched.delete(x.uid)
          if has {
            match x.parent {
              Some(q) => {
                let mut ci = 0
                while ci < q.children.length() {
                  let c = q.children[ci]
                  if c.uid == x.uid { break }
                  let _ = self.matched.delete(c.uid)
                  ci = ci + 1
                }
              }
              None => ()
            }
          }
          p = match x.parent { Some(y) => Some(y) None => x.get_host() }
        }
        None => break
      }
    }
  } else {
    let _ = self.matched.delete(n.uid)
    if n.kind == html::Kind::Text {
      match n.parent {
        Some(par) => { let _ = self.matched.delete(par.uid) }
        None => ()
      }
    }
  }
}

// ----- Matching & Cascade -----

fn Engine::cq_holds(self : Engine, n : html::Node, q0 : Array[Tok]) -> Bool {
  let q = trim(q0)
  let mut name = ""
  let mut cond = q
  if q.length() > 0 {
    match q[0] {
      Ident(x) => {
        let lx = ascii_lower(x)
        if lx != "not" && lx != "and" && lx != "or" {
          name = x
          cond = trim(tok_slice(q, 1, q.length()))
        }
      }
      _ => ()
    }
  }
  let mut p = n.parent
  while true {
    match p {
      Some(x) => {
        if x.kind != html::Kind::Element { break }
        match intmap::get(self.styled, x.uid) {
          Some(se) => {
            let st = se.style
            let ct = st.word("container-type")
            if ct == "size" || ct == "inline-size" {
              let mut name_ok = name == ""
              if !name_ok {
                let cn = st.get("container-name")
                let mut ci = 0
                while ci < cn.length() {
                  match cn[ci] {
                    Ident(v) => if v == name { name_ok = true; break }
                    _ => ()
                  }
                  ci = ci + 1
                }
              }
              if name_ok {
                let sz_fn = css_globals.container_size
                return match sz_fn(x.uid) {
                  Some(wh) => {
                    let mapped : Array[Tok] = []
                    let mut ti = 0
                    while ti < cond.length() {
                      match cond[ti] {
                        Ident(v) => {
                          let lv = ascii_lower(v)
                          if lv == "inline-size" { mapped.push(Ident("width")) }
                          else if lv == "block-size" { mapped.push(Ident("height")) }
                          else { mapped.push(cond[ti]) }
                        }
                        _ => mapped.push(cond[ti])
                      }
                      ti = ti + 1
                    }
                    media_matches(Env::new(wh.0, wh.1), mapped)
                  }
                  None => false
                }
              }
            }
          }
          None => ()
        }
        p = x.parent
      }
      None => break
    }
  }
  false
}

fn match_take(eng : Engine, n : html::Node, pseudo : String, check_pseudo : Bool, list : Array[Entry], out : Array[Entry], have : Array[Option[Array[Int]]]) -> Unit {
  let mut i = 0
  while i < list.length() {
    let e = list[i]
    if check_pseudo && e.sel.pseudo_element != pseudo {
      i = i + 1
      continue
    }
    if e.need.length() > 0 {
      let m = match have[0] {
        Some(x) => x
        None => {
          let x = ancestor_keys(n)
          have[0] = Some(x)
          x
        }
      }
      let mut all = true
      let mut ki = 0
      while ki < e.need.length() {
        let k = e.need[ki]
        if k >= m.length() || m[k] <= 0 { all = false; break }
        ki = ki + 1
      }
      if !all { i = i + 1; continue }
    }
    if selector_matches(e.sel, n) {
      let cq_ok = match e.cq { Some(q) => eng.cq_holds(n, q) None => true }
      if cq_ok { out.push(e) }
    }
    i = i + 1
  }
}

let class_words_cache : Map[String, Array[String]] = Map::with_capacity(256)

fn class_words_dedup(c : String) -> Array[String] {
  match class_words_cache.get(c) {
    Some(ws) => return ws
    None => ()
  }
  fill_class_words(c, match_class_buf)
  let raw_len = match_class_buf.length()
  let out : Array[String] = Array::with_capacity(raw_len)
  let mut j = 0
  while j < raw_len {
    let k = match_class_buf[j]
    let mut again = false
    let mut x = 0
    while x < out.length() {
      if out[x] == k {
        again = true
        break
      }
      x = x + 1
    }
    if !again {
      out.push(k)
    }
    j = j + 1
  }
  match_class_buf.clear()
  if class_words_cache.length() >= 2048 {
    class_words_cache.clear()
  }
  class_words_cache.set(c, out)
  out
}

fn Engine::match_now_with(
  self : Engine,
  n : html::Node,
  pseudo : String,
  check_pseudo : Bool,
  by_id : Map[String, Array[Entry]],
  by_class : Map[String, Array[Entry]],
  by_tag : Map[String, Array[Entry]],
  by_attr : Map[String, Array[Entry]],
  attr_has_id : Bool,
  attr_has_class : Bool,
  roots : Array[Entry],
  rest : Array[Entry],
) -> MatchedList {
  let out : Array[Entry] = []
  let have : Array[Option[Array[Int]]] = [None]
  let has_id = by_id.length() > 0
  let has_cls = by_class.length() > 0
  let has_attr = by_attr.length() > 0
  let is_html = n.ns == html::Ns::Html
  let attrs = n.attrs
  let alen = attrs.length()
  if (has_id || has_cls || has_attr) && alen > 0 {
    let mut seen_id = false
    let mut seen_cls = false
    let mut ai = 0
    while ai < alen {
      let attr = attrs[ai]
      let al = attr.name.length()
      if attr.prefix == "" {
        if has_id && !seen_id && al == 2 && attr.name == "id" {
          seen_id = true
          match by_id.get(attr.value) { Some(a) => match_take(self, n, pseudo, check_pseudo, a, out, have) None => () }
        } else if has_cls && !seen_cls && al == 5 && attr.name == "class" {
          seen_cls = true
          let c = attr.value
          if is_single_word(c) {
            match by_class.get(c) { Some(a) => match_take(self, n, pseudo, check_pseudo, a, out, have) None => () }
          } else {
            let ws = class_words_dedup(c)
            let wn = ws.length()
            let mut j = 0
            while j < wn {
              match by_class.get(ws[j]) { Some(a) => match_take(self, n, pseudo, check_pseudo, a, out, have) None => () }
              j = j + 1
            }
          }
        }
      }
      if has_attr {
        if attr.prefix != "" || !((al == 5 && attr.name == "class" && !attr_has_class) || (al == 2 && attr.name == "id" && !attr_has_id)) {
          let an = if is_html { attr.name } else { lower_tag(attr.name) }
          match by_attr.get(an) { Some(l) => match_take(self, n, pseudo, check_pseudo, l, out, have) None => () }
        }
      }
      ai = ai + 1
    }
  }
  let tn = if is_html { n.tag } else { lower_tag(n.tag) }
  match by_tag.get(tn) { Some(a) => match_take(self, n, pseudo, check_pseudo, a, out, have) None => () }
  if roots.length() > 0 {
    match n.parent {
      Some(p) => if p.kind == html::Kind::Document { match_take(self, n, pseudo, check_pseudo, roots, out, have) }
      None => ()
    }
  }
  if rest.length() > 0 {
    match_take(self, n, pseudo, check_pseudo, rest, out, have)
  }
  let total = out.length()
  if total == 0 {
    return EMPTY_MATCHED_LIST
  }
  if total == 2 {
    if entry_cmp(out[0], out[1]) > 0 {
      let tmp = out[0]
      out[0] = out[1]
      out[1] = tmp
    }
  } else if total > 2 {
    sort_entries(out, entry_cmp)
  }
  let mut k = total
  if self.multi && total > 1 {
    let mut w = 1
    let mut i = 1
    while i < total {
      if out[i].order != out[w - 1].order {
        if w != i { out[w] = out[i] }
        w = w + 1
      }
      i = i + 1
    }
    k = w
  }
  if k == 1 {
    let e0 = out[0]
    match e0.single_list {
      Some(ml) => return ml
      None => {
        let ml = MatchedList::{ uid: next_matched_uid(), entries: [e0], flags: entry_flags(e0), share_key: "" }
        e0.single_list = Some(ml)
        return ml
      }
    }
  }
  if k == 2 {
    let e0 = out[0]
    let e1 = out[1]
    if e0.order >= 0 && e0.order < 32768 && e1.order >= 0 && e1.order < 32768 {
      let key = (e0.order << 15) | e1.order
      match intmap::get(self.pair_lists, key) {
        Some(ml) => return ml
        None => {
          let ml = MatchedList::{ uid: next_matched_uid(), entries: [e0, e1], flags: entry_flags(e0) | entry_flags(e1), share_key: "" }
          if self.pair_lists.len() < 4096 {
            self.pair_lists.set(key, ml)
          }
          return ml
        }
      }
    }
    return MatchedList::{ uid: next_matched_uid(), entries: [e0, e1], flags: entry_flags(e0) | entry_flags(e1), share_key: "" }
  }
  let entries = Array::make(k, out[0])
  let mut ml_flags = entry_flags(out[0])
  let mut ci = 1
  while ci < k {
    let e = out[ci]
    ml_flags = ml_flags | entry_flags(e)
    entries[ci] = e
    ci = ci + 1
  }
  MatchedList::{ uid: next_matched_uid(), entries: entries, flags: ml_flags, share_key: "" }
}

fn Engine::match_now(self : Engine, n : html::Node, pseudo : String) -> MatchedList {
  if pseudo != "" {
    match self.pseudo_index {
      Some(pi) =>
      return self.match_now_with(
        n, pseudo, true, pi.by_id, pi.by_class, pi.by_tag, pi.by_attr,
        pi.by_attr_has_id, pi.by_attr_has_class, pi.roots, pi.rest,
      )
      None => return EMPTY_MATCHED_LIST
    }
  }
  self.match_now_with(
    n, pseudo, false, self.by_id, self.by_class, self.by_tag, self.by_attr,
    self.by_attr_has_id, self.by_attr_has_class, self.roots, self.rest,
  )
}

fn Engine::matching(self : Engine, n : html::Node, pseudo : String) -> MatchedList {
  if sel_state.scope_node.is_some() {
    return self.match_now(n, pseudo)
  }
  let mine = match intmap::get(self.matched, n.uid) {
    Some(m) => m
    None => {
      let m = NodeMatches::new()
      n.ever_styled = true
      self.matched.set(n.uid, m)
      self.matched_nodes.set(n.uid, n)
      if pseudo == "" {
        match_counts[1] = match_counts[1] + 1
        let found = self.match_now(n, pseudo)
        m.main = Some(found)
        return found
      }
      m
    }
  }
  if pseudo == "" {
    match mine.main {
      Some(found) => {
        match_counts[0] = match_counts[0] + 1
        found
      }
      None => {
        match_counts[1] = match_counts[1] + 1
        let found = self.match_now(n, pseudo)
        mine.main = Some(found)
        found
      }
    }
  } else if pseudo == "before" {
    match mine.before {
      Some(found) => {
        match_counts[0] = match_counts[0] + 1
        found
      }
      None => {
        match_counts[1] = match_counts[1] + 1
        let found = self.match_now(n, pseudo)
        mine.before = Some(found)
        found
      }
    }
  } else if pseudo == "after" {
    match mine.after {
      Some(found) => {
        match_counts[0] = match_counts[0] + 1
        found
      }
      None => {
        match_counts[1] = match_counts[1] + 1
        let found = self.match_now(n, pseudo)
        mine.after = Some(found)
        found
      }
    }
  } else {
    let om = match mine.other {
      Some(m) => m
      None => {
        let m : Map[String, MatchedList] = Map::new()
        mine.other = Some(m)
        m
      }
    }
    match om.get(pseudo) {
      Some(found) => {
        match_counts[0] = match_counts[0] + 1
        found
      }
      None => {
        match_counts[1] = match_counts[1] + 1
        let found = self.match_now(n, pseudo)
        om.set(pseudo, found)
        found
      }
    }
  }
}

pub fn Engine::pseudo_declares_content(self : Engine, n : html::Node, pseudo : String) -> Bool {
  let bit = if pseudo == "before" {
    if !self.has_before_content { return false }
    1
  } else if pseudo == "after" {
    if !self.has_after_content { return false }
    2
  } else {
    0
  }
  if bit != 0 {
    // (an element none of whose keys a content rule is filed under is matched against no pseudo-element rule; the
    // answer is kept with what the element matched, and the rules it matched, once kept, answer for it)
    let mine = if sel_state.scope_node.is_some() { None } else { intmap::get(self.matched, n.uid) }
    match mine {
      Some(m) => {
        if (m.no_content & bit) != 0 { return false }
        match if bit == 1 { m.before } else { m.after } {
          Some(found) => return declares_content(found.entries)
          None => ()
        }
      }
      None => ()
    }
    if !(if bit == 1 { self.before_content } else { self.after_content }).may_match(n) {
      match mine {
        Some(m) => m.no_content = m.no_content | bit
        None => ()
      }
      return false
    }
  }
  declares_content(self.matching(n, pseudo).entries)
}

fn declares_content(found : Array[Entry]) -> Bool {
  let mut i = 0
  while i < found.length() {
    if found[i].has_content { return true }
    i = i + 1
  }
  false
}

fn state_target_matches(
  any : Array[Selector],
  by_key : Map[String, Array[Selector]],
  n : html::Node,
) -> Bool {
  let check = fn(list : Array[Selector]) -> Bool {
    let mut i = 0
    while i < list.length() {
      if selector_matches(list[i], n) { return true }
      i = i + 1
    }
    false
  }
  if check(any) { return true }
  match by_key.get(lower_tag(n.tag)) { Some(l) => if check(l) { return true } None => () }
  match n.attr("id") {
    Some(id) => match by_key.get("#" + id) { Some(l) => if check(l) { return true } None => () }
    None => ()
  }
  match n.attr("class") {
    Some(c) => {
      let ws = class_words(c)
      let mut i = 0
      while i < ws.length() {
        match by_key.get("." + ws[i]) { Some(l) => if check(l) { return true } None => () }
        i = i + 1
      }
    }
    None => ()
  }
  false
}

pub fn Engine::hover_target(self : Engine, n : html::Node) -> Bool {
  state_target_matches(self.hover_any, self.hover_by_key, n)
}

pub fn Engine::active_target(self : Engine, n : html::Node) -> Bool {
  state_target_matches(self.active_any, self.active_by_key, n)
}

fn has_lh(v : Array[Tok]) -> Bool {
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Dimension(_, u) => {
        let lu = ascii_lower(u)
        if lu == "lh" || lu == "rlh" { return true }
      }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn has_function_or_lh(v : Array[Tok]) -> Bool {
  let mut i = 0
  while i < v.length() {
    match v[i] { Function(_) => return true _ => () }
    i = i + 1
  }
  has_lh(v)
}

fn with_lh(v : Array[Tok], lh : Double, rlh : Double) -> Array[Tok] {
  if !has_lh(v) { return v }
  let out : Array[Tok] = []
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Dimension(n, u) => {
        let lu = ascii_lower(u)
        if lu == "lh" { out.push(Dimension(n * lh, "px")) }
        else if lu == "rlh" { out.push(Dimension(n * rlh, "px")) }
        else { out.push(v[i]) }
      }
      _ => out.push(v[i])
    }
    i = i + 1
  }
  out
}

fn font_size_of(v : Array[Tok], parent : Double, root : Double, env : Env) -> Double {
  if v.length() > 0 {
    match v[0] {
      Ident(w) => {
        let lw = ascii_lower(w)
        if lw == "xx-small" { return 9.0 }
        if lw == "x-small" { return 10.0 }
        if lw == "small" { return 13.0 }
        if lw == "medium" { return 16.0 }
        if lw == "large" { return 18.0 }
        if lw == "x-large" { return 24.0 }
        if lw == "xx-large" { return 32.0 }
        if lw == "xxx-large" { return 48.0 }
        if lw == "smaller" { return parent / 1.2 }
        if lw == "larger" { return parent * 1.2 }
        return parent
      }
      _ => ()
    }
  }
  match eval_length(v, parent, root, env) {
    Some(l) => l.px + l.pct * parent / 100.0
    None => parent
  }
}

pub struct SlottedInput {
  pub engine : Engine
  pub slot : html::Node
}

pub fn Engine::style_of(self : Engine, n : html::Node, parent : Option[Style]) -> Option[Style] {
  self.style_of_full(n, parent, "", None, None)
}

pub fn Engine::first_line_color(self : Engine, n : html::Node, own : Style) -> Option[Color] {
  if !self.has_first_line { return None }
  let ml = self.match_now(n, "first-line")
  if ml.entries.length() == 0 { return None }
  match self.style_of_full(n, Some(own), "first-line", None, None) {
    Some(fl) => if fl.values.maybe_has_id(p_color) { fl.color_id(p_color) } else { None }
    None => None
  }
}

pub fn Engine::first_letter_color(self : Engine, n : html::Node, own : Style) -> Option[Color] {
  if !self.has_first_letter { return None }
  let ml = self.match_now(n, "first-letter")
  if ml.entries.length() == 0 { return None }
  match self.style_of_full(n, Some(own), "first-letter", None, None) {
    Some(fl) => if fl.values.maybe_has_id(p_color) { fl.color_id(p_color) } else { None }
    None => None
  }
}

pub fn Engine::style_of_full(
  self : Engine,
  n : html::Node,
  parent : Option[Style],
  pseudo : String,
  host_rules : Option[Engine],
  slotted : Option[SlottedInput],
  parts~ : Array[(html::Node, Engine)] = empty_parts,
) -> Option[Style] {
  let keep = pseudo == "" && host_rules.is_none() && slotted.is_none() && parts.length() == 0 && sel_state.scope_node.is_none()
  if keep {
    match intmap::get(self.styled, n.uid) {
      Some(se) =>
      match intmap::get(self.matched, n.uid) {
        Some(per) =>
        match per.main {
          Some(now) => {
            let same_parent = match se.parent {
              None => parent.is_none()
              Some(a) => match parent {
                Some(b) =>
                if a.uid == b.uid {
                  true
                } else if se.found.uid == now.uid && !se.style.uses_non_inh_inherit &&
                (!self.has_cq || (a.cq_w == b.cq_w && a.cq_h == b.cq_h)) &&
                a.same_for_kids(b) {
                  se.parent = parent
                  true
                } else {
                  false
                }
                None => false
              }
            }
            if same_parent && se.found.uid == now.uid {
              style_counts[0] = style_counts[0] + 1
              return Some(se.style)
            }
            style_counts[3] = style_counts[3] + 1
          }
          None => ()
        }
        None => ()
      }
      None => ()
    }
  }
  let was = css_globals.quirks_mode
  css_globals.quirks_mode = self.quirks
  let st0 = self.style_of_in(n, parent, pseudo, host_rules, slotted, parts)
  css_globals.quirks_mode = was
  if st0.is_some() { style_counts[1] = style_counts[1] + 1 }
  if pseudo != "" || sel_state.scope_node.is_some() {
    return st0
  }
  // (a scroller's ::-webkit-scrollbar that hides its bar: display none, or no width; only for what may scroll, the
  // root, or a box whose overflow scrolls)
  if self.has_webkit_scrollbar && n.ns == html::Ns::Html {
    match st0 {
      Some(x) => {
        let ox = x.word_id(p_overflow_x)
        let oy = x.word_id(p_overflow_y)
        let scrolls = n.tag == "html" || n.tag == "body" || ox == "auto" || ox == "scroll" || oy == "auto" || oy == "scroll"
        if scrolls && self.matching(n, "-webkit-scrollbar").entries.length() > 0 {
          match self.style_of_in(n, Some(x), "-webkit-scrollbar", host_rules, slotted, parts) {
            Some(sb) => {
              let zero_w = match sb.length_id(p_width) {
                Some(l) => l.px == 0.0 && l.pct == 0.0
                None => false
              }
              if sb.word_id(p_display) == "none" || zero_w {
                x.values.set_id(p_fv_scrollbar_hidden, tokenize("none"))
              }
            }
            None => ()
          }
        }
      }
      None => ()
    }
  }
  if self.has_placeholder && n.ns == html::Ns::Html && (n.tag == "input" || n.tag == "textarea") && n.attr("placeholder").is_some() {
    match st0 {
      Some(x) =>
      if self.matching(n, "placeholder").entries.length() > 0 {
        match self.style_of_in(n, Some(x), "placeholder", host_rules, slotted, parts) {
          Some(ph) =>
          match ph.color_id(p_color) {
            Some(c) => {
              let op0 = ph.number_id(p_opacity, 1.0)
              let op = if op0 < 0.0 { 0.0 } else if op0 > 1.0 { 1.0 } else { op0 }
              let a = c.a * op
              let s = "rgba(" + c.r.to_string() + "," + c.g.to_string() + "," + c.b.to_string() + "," + a.to_string() + ")"
              x.values.set_id(p_placeholder_color, tokenize(s))
            }
            None => ()
          }
          None => ()
        }
      }
      None => ()
    }
  }
  if self.has_slider_pseudo && n.ns == html::Ns::Html && n.tag == "input" {
    let ty = match n.attr("type") { Some(t) => ascii_lower(t) None => "" }
    if ty == "range" {
      match st0 {
        Some(x) => {
          let track_pe = if self.matching(n, "-webkit-slider-runnable-track").entries.length() > 0 {
            "-webkit-slider-runnable-track"
          } else if self.matching(n, "-moz-range-track").entries.length() > 0 {
            "-moz-range-track"
          } else {
            ""
          }
          if track_pe != "" {
            match self.style_of_in(n, Some(x), track_pe, host_rules, slotted, parts) {
              Some(tr) => {
                match tr.color_id(p_background_color) {
                  Some(c) if c.a > 0.0 => {
                    let s = "rgba(" + c.r.to_string() + "," + c.g.to_string() + "," + c.b.to_string() + "," + c.a.to_string() + ")"
                    x.values.set_id(p_slider_track_bg, tokenize(s))
                  }
                  _ => ()
                }
                let tr_img = tr.get_id(p_background_image)
                if tr_img.length() > 0 && !(tr_img.length() == 1 && (tr_img[0] is Tok::Ident(_))) {
                  x.values.set_id(p_slider_track_bg_img, tr_img)
                }
                match tr.length_id(p_height) {
                  Some(l) if l.px > 0.0 => x.values.set_id(p_slider_track_h, tokenize(l.px.to_string()))
                  _ => ()
                }
                match tr.length_id(p_border_top_left_radius) {
                  Some(l) if l.px > 0.0 => x.values.set_id(p_slider_track_r, tokenize(l.px.to_string()))
                  _ => ()
                }
              }
              None => ()
            }
          }
          let thumb_pe = if self.matching(n, "-webkit-slider-thumb").entries.length() > 0 {
            "-webkit-slider-thumb"
          } else if self.matching(n, "-moz-range-thumb").entries.length() > 0 {
            "-moz-range-thumb"
          } else {
            ""
          }
          if thumb_pe != "" {
            match self.style_of_in(n, Some(x), thumb_pe, host_rules, slotted, parts) {
              Some(tb) => {
                let mut thumb_col = match tb.color_id(p_background_color) {
                  Some(c) if c.a > 0.0 => Some(c)
                  _ => None
                }
                if thumb_col.is_none() {
                  let bg_img0 = tb.get_id(p_background_image)
                  let bg_img = if bg_img0.length() > 0 && !(bg_img0.length() == 1 && (bg_img0[0] is Tok::Ident(_))) { bg_img0 } else { tb.get("background") }
                  let mut bi = 0
                  while bi < bg_img.length() && thumb_col.is_none() {
                    match bg_img[bi] {
                      Tok::Function(fn_name) if ascii_lower(fn_name) == "linear-gradient" => {
                        let args : Array[Tok] = []
                        let mut depth = 1
                        let mut j = bi + 1
                        while j < bg_img.length() && depth > 0 {
                          match bg_img[j] {
                            Tok::Function(_) => { depth += 1; args.push(bg_img[j]) }
                            Tok::OpenParen => { depth += 1; args.push(bg_img[j]) }
                            Tok::CloseParen => { depth -= 1; if depth > 0 { args.push(bg_img[j]) } }
                            _ => args.push(bg_img[j])
                          }
                          j += 1
                        }
                        let lg_parts = split_top_commas(args)
                        let mut pi = 0
                        while pi < lg_parts.length() && thumb_col.is_none() {
                          let part = lg_parts[pi]
                          let mut lo = 0
                          while lo < part.length() && (part[lo] is Tok::Space) { lo += 1 }
                          let mut hi = part.length()
                          while hi > lo && (part[hi - 1] is Tok::Space) { hi -= 1 }
                          let trimmed : Array[Tok] = []
                          let mut ti2 = lo
                          while ti2 < hi {
                            trimmed.push(part[ti2])
                            ti2 += 1
                          }
                          match parse_color(trimmed, 0) {
                            Some(c) => if c.a > 0.0 { thumb_col = Some(c) }
                            None => ()
                          }
                          pi += 1
                        }
                        bi = j - 1
                      }
                      _ => ()
                    }
                    bi += 1
                  }
                }
                match thumb_col {
                  Some(c) => {
                    let s = "rgba(" + c.r.to_string() + "," + c.g.to_string() + "," + c.b.to_string() + "," + c.a.to_string() + ")"
                    x.values.set_id(p_slider_thumb_bg, tokenize(s))
                  }
                  None => ()
                }
                let tw = match tb.length_id(p_width) { Some(l) if l.px > 0.0 => l.px _ => 0.0 }
                let th = match tb.length_id(p_height) { Some(l) if l.px > 0.0 => l.px _ => 0.0 }
                let tsz = if tw > 0.0 && th > 0.0 { (tw + th) * 0.5 } else if tw > 0.0 { tw } else { th }
                if tsz > 0.0 {
                  x.values.set_id(p_slider_thumb_size, tokenize(tsz.to_string()))
                }
                match tb.length_id(p_border_top_width) {
                  Some(bw) if bw.px > 0.0 => {
                    x.values.set_id(p_slider_thumb_bw, tokenize(bw.px.to_string()))
                    match tb.color_id(p_border_top_color) {
                      Some(bc) if bc.a > 0.0 => {
                        let bs = "rgba(" + bc.r.to_string() + "," + bc.g.to_string() + "," + bc.b.to_string() + "," + bc.a.to_string() + ")"
                        x.values.set_id(p_slider_thumb_border, tokenize(bs))
                      }
                      _ => ()
                    }
                  }
                  _ => ()
                }
                match tb.length_id(p_border_top_left_radius) {
                  Some(rl) => {
                    let rpx = if rl.pct > 0.0 && tsz > 0.0 { rl.pct * tsz / 100.0 } else { rl.px }
                    x.values.set_id(p_slider_thumb_r, tokenize(rpx.to_string()))
                  }
                  None => ()
                }
                let tf_toks = tb.get_id(p_transform)
                let mut ti = 0
                while ti < tf_toks.length() {
                  match tf_toks[ti] {
                    Tok::Function(fn_name) if ascii_lower(fn_name) == "rotate" => {
                      let mut ai = ti + 1
                      while ai < tf_toks.length() {
                        match tf_toks[ai] {
                          Tok::CloseParen => break
                          Tok::Dimension(v, u) => {
                            let lu = ascii_lower(u)
                            let deg = if lu == "deg" { v } else if lu == "rad" { v * 180.0 / 3.141592653589793 } else if lu == "turn" { v * 360.0 } else { 0.0 }
                            if deg != 0.0 { x.values.set_id(p_slider_thumb_rot, tokenize(deg.to_string())) }
                            break
                          }
                          _ => ()
                        }
                        ai += 1
                      }
                    }
                    _ => ()
                  }
                  ti += 1
                }
              }
              None => ()
            }
          }
        }
        None => ()
      }
    }
  }
  let st = match st0 {
    Some(x) =>
    match intmap::get(self.styled, n.uid) {
      Some(old_se) =>
      if x.same_values(old_se.style) {
        style_counts[2] = style_counts[2] + 1
        Some(old_se.style)
      } else {
        Some(x)
      }
      None => Some(x)
    }
    None => None
  }
  match st {
    Some(x) =>
    match intmap::get(self.matched, n.uid) {
      Some(per) =>
      match per.main {
        Some(found) => {
          n.ever_styled = true
          self.styled.set(n.uid, StyledEntry::{
            parent: if keep { parent } else { None },
            found: found,
            style: x,
          })
        }
        None => { let _ = self.styled.delete(n.uid) }
      }
      None => { let _ = self.styled.delete(n.uid) }
    }
    None => { let _ = self.styled.delete(n.uid) }
  }
  st
}

struct ShareTarget {
  parent : Style
  gen : Int
  key : String
}

let empty_entries : Array[Entry] = []
let empty_parts : Array[(html::Node, Engine)] = []

fn has_revert_layer_tok(toks : Array[Tok]) -> Bool {
  let mut i = 0
  let n = toks.length()
  while i < n {
    match toks[i] {
      Ident(w) => if ascii_lower(w) == "revert-layer" { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn str_contains_ci_ascii(s : String, lower_needle : String) -> Bool {
  let sl = s.length()
  let nl = lower_needle.length()
  if nl == 0 { return true }
  if sl < nl { return false }
  let first = lower_needle.code_unit_at(0)
  let first_up = if first >= 97 && first <= 122 { first - 32 } else { first }
  let last = sl - nl
  let mut i = 0
  while i <= last {
    let c0 = s.code_unit_at(i)
    if c0 == first || c0 == first_up {
      let mut j = 1
      let mut ok = true
      while j < nl {
        let mut c = s.code_unit_at(i + j)
        if c >= 65 && c <= 90 { c = c + 32 }
        if c != lower_needle.code_unit_at(j) { ok = false; break }
        j = j + 1
      }
      if ok { return true }
    }
    i = i + 1
  }
  false
}

fn apply_decl_to_props(d : Decl, to : Props, vars : VarMap, n : html::Node, has_attr : Bool) -> Unit {
  if d.value.length() == 0 && !str_has_prefix(d.name, "--") {
    return
  }
  match d.longhands {
    Some(list) => {
      if list.length() == 1 {
        let l = list[0]
        to.set_id(l.id, l.value)
        if l.logical {
          to.set_id(l.mark, logical_yes)
        } else if l.mark >= 0 {
          to.remove_id(l.mark)
        }
      } else {
        put_longhand_ids(list, to)
      }
      return
    }
    None => ()
  }
  if d.name == "all" {
    if is_ident(d.value, ["unset", "initial", "revert", "revert-layer"]) {
      let rm_ids : Array[Int] = []
      to.each_id(fn(id : Int, _v : Array[Tok]) -> Unit {
        let pn = prop_names[id]
        if pn != "direction" && pn != "unicode-bidi" && !str_has_prefix(pn, "-fv-") {
          rm_ids.push(id)
        }
      })
      let mut ri = 0
      while ri < rm_ids.length() {
        to.remove_id(rm_ids[ri])
        ri = ri + 1
      }
    }
    return
  }
  if !str_has_prefix(d.name, "--") && !expand_decl_kept(d, to) {
    match subst(d.value, vars, 0) {
      Some(sv) => {
        if has_attr {
          match subst_attr(sv, n, empty_str_arr) {
            Some(v) => put_longhand_ids(var_longhands(d, v), to)
            None => ()
          }
        } else {
          put_longhand_ids(var_longhands(d, sv), to)
        }
      }
      None => ()
    }
  }
}

///|
/// The longhands of `d` for `v`, its value with var()/attr() put in: expanded again only when `v` (or quirks mode)
/// differs from what `d` last took (the expansion depends on nothing else).
fn var_longhands(d : Decl, v : Array[Tok]) -> Array[Longhand] {
  let q = css_globals.quirks_mode
  match d.var_memo {
    Some(m) => if m.quirks == q && toks_eq(m.value, v) { return m.list }
    None => ()
  }
  let list = longhand_ids(d.name, v)
  d.var_memo = Some(VarMemo::{ value: v, quirks: q, list: list })
  list
}

struct VarHistItem {
  layer : Array[Int]
  value : Array[Tok]
}

fn layer_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() { if a[i] != b[i] { return false }; i = i + 1 }
  true
}

let style_share_sb : StringBuilder = StringBuilder::new()
let inline_decls_cache : Map[String, (Array[Decl], Bool)] = Map::new()

let style_ids_buf : Array[Int] = []

let style_math_ids_buf : Array[Int] = []

let rtl_logical_pairs : Array[(String, String)] = [
  ("margin-left", "margin-right"),
  ("padding-left", "padding-right"),
  ("left", "right"),
  ("border-left-width", "border-right-width"),
  ("border-left-style", "border-right-style"),
  ("border-left-color", "border-right-color"),
  ("border-top-left-radius", "border-top-right-radius"),
  ("border-bottom-left-radius", "border-bottom-right-radius"),
]

fn rtl_put(values : Props, k : String, v : Option[Array[Tok]], logical : Bool) -> Unit {
  match v {
    Some(x) => values.set(k, x)
    None => values.remove(k)
  }
  if logical {
    values.set("-fv-logical-" + k, logical_yes)
  } else {
    values.remove("-fv-logical-" + k)
  }
}

fn is_global_kw_or_var(v : Array[Tok]) -> Bool {
  let n = v.length()
  if n == 0 {
    return false
  }
  if n == 1 {
    match v[0] {
      Ident(w) => {
        let wl = w.length()
        if wl < 5 || wl > 12 {
          return false
        }
        let c0 = w.code_unit_at(0)
        if c0 == 0x69 || c0 == 0x49 {
          if wl == 7 {
            let lw = ascii_lower(w)
            return lw == "inherit" || lw == "initial"
          }
          return false
        }
        if c0 == 0x75 || c0 == 0x55 {
          return wl == 5 && ascii_lower(w) == "unset"
        }
        if c0 == 0x72 || c0 == 0x52 {
          if wl == 6 {
            return ascii_lower(w) == "revert"
          }
          if wl == 12 {
            return ascii_lower(w) == "revert-layer"
          }
          return false
        }
        return false
      }
      _ => ()
    }
  }
  has_var(v)
}

fn Props::collect_kw_or_var_ids(self : Props, out : Array[Int]) -> Unit {
  if self.count == 0 {
    return
  }
  if self.k0 >= 0 {
    if is_global_kw_or_var(self.v0) {
      out.push(self.k0)
    }
    if self.k1 >= 0 && is_global_kw_or_var(self.v1) {
      out.push(self.k1)
    }
    return
  }
  if self.slots.length() > 0 {
    let mut i = 0
    let n = self.slots.length()
    while i < n {
      match self.slots[i] {
        Some(v) => if is_global_kw_or_var(v) { out.push(i) }
        None => ()
      }
      i = i + 1
    }
  } else {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      if is_global_kw_or_var(self.vals[i]) {
        out.push(self.keys[i])
      }
      i = i + 1
    }
  }
}

fn Props::collect_math_ids(self : Props, out : Array[Int]) -> Unit {
  if self.count == 0 {
    return
  }
  if self.k0 >= 0 {
    if has_function_or_lh(self.v0) {
      out.push(self.k0)
    }
    if self.k1 >= 0 && has_function_or_lh(self.v1) {
      out.push(self.k1)
    }
    return
  }
  if self.slots.length() > 0 {
    let mut i = 0
    let n = self.slots.length()
    while i < n {
      match self.slots[i] {
        Some(v) => if has_function_or_lh(v) { out.push(i) }
        None => ()
      }
      i = i + 1
    }
  } else {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      if has_function_or_lh(self.vals[i]) {
        out.push(self.keys[i])
      }
      i = i + 1
    }
  }
}

fn style_root_lh(parent : Option[Style]) -> Double {
  match parent {
    Some(p) => p.root_style().line_height_px()
    None => (css_globals.normal_lh_hook)([], 16.0)
  }
}

fn is_mono_only(v : Option[Array[Tok]]) -> Bool {
  match v {
    Some(toks) => toks.length() == 1 && match toks[0] { Ident(w) => w == "monospace" _ => false }
    None => false
  }
}

fn style_own_lh(values : Props, parent : Option[Style], fs : Double, root : Double, env : Env) -> Double {
  let lv = match values.get_id(p_line_height) {
    Some(v) => Some(v)
    None => match parent { Some(p) => p.lookup_id(p_line_height) None => None }
  }
  lh_px(lv, fs, root, env, css_globals.cur_family)
}

fn resolve_lh_prop(values : Props, parent : Option[Style], id : Int) -> Unit {
  if !values.maybe_has_id(id) { return }
  match values.get_id(id) {
    Some(v) => {
      if has_lh(v) {
        let parent_lh = match parent {
          Some(p) => p.line_height_px()
          None => (css_globals.normal_lh_hook)([], 16.0)
        }
        values.set_id(id, with_lh(v, parent_lh, style_root_lh(parent)))
      }
    }
    None => ()
  }
}

fn resolve_inh_len_prop(
  values : Props,
  parent : Option[Style],
  id : Int,
  is_lh : Bool,
  fs : Double,
  root : Double,
  env : Env,
) -> Unit {
  if !values.maybe_has_id(id) { return }
  match values.get_id(id) {
    Some(v) => {
      if v.length() == 1 {
        match v[0] {
          Dimension(num_v, u) => {
            if u != "px" {
              let rsz = if values.contains_id(p_font_size) && parent.is_none() { fs } else { root }
              match unit_px(num_v, ascii_lower(u), fs, rsz, env) {
                Some(px) => values.set_id(id, [Dimension(px, "px")])
                None => ()
              }
            }
          }
          Percentage(num_v) => {
            if is_lh { values.set_id(id, [Dimension(num_v * fs / 100.0, "px")]) }
          }
          _ => ()
        }
      } else if v.length() > 0 {
        match v[0] {
          Function(f) => {
            if ascii_lower(f) == "calc" {
              match eval_length(v, fs, root, env) {
                Some(l) => if l.pct == 0.0 { values.set_id(id, [Dimension(l.px, "px")]) }
                None => ()
              }
            }
          }
          _ => ()
        }
      }
    }
    None => ()
  }
}

let empty_decls : Array[Decl] = []

let empty_resets : Array[(String, RegProp)] = []

fn css_sb_write_int(b : StringBuilder, v : Int) -> Unit {
  if v >= 0 && v < 1000000 {
    if v < 10 {
      b.write_byte((48 + v).to_byte())
      return
    }
    if v < 100 {
      b.write_byte((48 + v / 10).to_byte())
      b.write_byte((48 + v % 10).to_byte())
      return
    }
    if v < 1000 {
      let q = v / 10
      b.write_byte((48 + q / 10).to_byte())
      b.write_byte((48 + q % 10).to_byte())
      b.write_byte((48 + v % 10).to_byte())
      return
    }
    if v < 10000 {
      let q1 = v / 10
      let q2 = q1 / 10
      b.write_byte((48 + q2 / 10).to_byte())
      b.write_byte((48 + q2 % 10).to_byte())
      b.write_byte((48 + q1 % 10).to_byte())
      b.write_byte((48 + v % 10).to_byte())
      return
    }
    if v < 100000 {
      let q1 = v / 10
      let q2 = q1 / 10
      let q3 = q2 / 10
      b.write_byte((48 + q3 / 10).to_byte())
      b.write_byte((48 + q3 % 10).to_byte())
      b.write_byte((48 + q2 % 10).to_byte())
      b.write_byte((48 + q1 % 10).to_byte())
      b.write_byte((48 + v % 10).to_byte())
      return
    }
    let q1 = v / 10
    let q2 = q1 / 10
    let q3 = q2 / 10
    let q4 = q3 / 10
    b.write_byte((48 + q4 / 10).to_byte())
    b.write_byte((48 + q4 % 10).to_byte())
    b.write_byte((48 + q3 % 10).to_byte())
    b.write_byte((48 + q2 % 10).to_byte())
    b.write_byte((48 + q1 % 10).to_byte())
    b.write_byte((48 + v % 10).to_byte())
    return
  }
  b.write_string(v.to_string())
}

fn var_keyword_value(
  self : Engine,
  parent : Option[Style],
  k : String,
  w : String,
) -> Option[Array[Tok]] {
  let pv = match parent {
    Some(p) => p.vars.get(k)
    None => None
  }
  match self.registered.get(k) {
    Some(rp) => {
      if w == "initial" || (!rp.inherits && w != "inherit") || (w == "inherit" && parent.is_none()) {
        rp.initial
      } else {
        pv
      }
    }
    None => if w == "initial" { None } else { pv }
  }
}

fn Engine::style_of_in(
  self : Engine,
  n : html::Node,
  parent : Option[Style],
  pseudo : String,
  host_rules : Option[Engine],
  slotted : Option[SlottedInput],
  parts : Array[(html::Node, Engine)],
) -> Option[Style] {
  let found_ml = self.matching(n, pseudo)
  let found = found_ml.entries
  let from_part : Array[Entry] = if pseudo == "" && parts.length() > 0 {
    match n.attr("part") {
      Some(p_attr) => {
        let mut active : Array[String] = []
        let mut pi = 0
        let plen = p_attr.length()
        while pi < plen {
          while pi < plen {
            let cu = p_attr.code_unit_at(pi).to_int()
            if cu == 32 || cu == 9 || cu == 10 || cu == 12 || cu == 13 { pi = pi + 1 } else { break }
          }
          let st = pi
          while pi < plen {
            let cu = p_attr.code_unit_at(pi).to_int()
            if cu == 32 || cu == 9 || cu == 10 || cu == 12 || cu == 13 { break } else { pi = pi + 1 }
          }
          if pi > st { active.push(p_attr.slice(st, pi)) }
        }
        if active.length() == 0 {
          empty_entries
        } else {
          let f : Array[Entry] = []
          let mut hi = parts.length() - 1
          while hi >= 0 && active.length() > 0 {
            let (host_k, eng_k) = parts[hi]
            if eng_k.has_parts {
              let raw = eng_k.matching(host_k, "part").entries
              let mut ri = 0
              while ri < raw.length() {
                let e = raw[ri]
                if !e.ua && e.sel.parts.length() > 0 {
                  let c0 = e.sel.parts[0].compound
                  let mut saw_part = false
                  let mut ok = true
                  let mut j = 0
                  while j < c0.length() {
                    match c0[j] {
                      PartSel(req) => {
                        saw_part = true
                        let mut qi = 0
                        while qi < req.length() {
                          let want = req[qi]
                          let mut hit = false
                          let mut ai = 0
                          while ai < active.length() {
                            if active[ai] == want { hit = true; break }
                            ai = ai + 1
                          }
                          if !hit { ok = false; break }
                          qi = qi + 1
                        }
                        if !ok { break }
                      }
                      _ => ()
                    }
                    j = j + 1
                  }
                  if saw_part && ok { f.push(e) }
                }
                ri = ri + 1
              }
            }
            if hi > 0 {
              match host_k.attr("exportparts") {
                Some(ep) => {
                  let next_active : Array[String] = []
                  let mut ei = 0
                  let elen = ep.length()
                  while ei < elen {
                    let mut seg_end = ei
                    while seg_end < elen && ep.code_unit_at(seg_end).to_int() != 44 { seg_end = seg_end + 1 }
                    let seg = ep.slice(ei, seg_end).trim()
                    ei = seg_end + 1
                    if seg != "" {
                      let mut colon = -1
                      let mut si = 0
                      while si < seg.length() {
                        if seg.code_unit_at(si).to_int() == 58 { colon = si; break }
                        si = si + 1
                      }
                      let (src, dst) = if colon >= 0 {
                        (seg.slice(0, colon).trim(), seg.slice(colon + 1, seg.length()).trim())
                      } else {
                        (seg, seg)
                      }
                      if src != "" && dst != "" {
                        let mut ai = 0
                        while ai < active.length() {
                          if active[ai] == src { next_active.push(dst); break }
                          ai = ai + 1
                        }
                      }
                    }
                  }
                  active = next_active
                }
                None => { active = [] }
              }
            }
            hi = hi - 1
          }
          if f.length() == 0 {
            empty_entries
          } else {
            sort_entries(f, entry_cmp)
            f
          }
        }
      }
      None => empty_entries
    }
  } else { empty_entries }
  let from_slot : Array[Entry] = match slotted {
    Some(sl) => {
      if pseudo == "" {
        let raw = sl.engine.matching(sl.slot, "slotted").entries
        if raw.length() == 0 {
          empty_entries
        } else {
          let f : Array[Entry] = []
          let mut i = 0
          while i < raw.length() {
            let e = raw[i]
            if !e.ua && e.sel.parts.length() > 0 {
              let c0 = e.sel.parts[0].compound
              let mut ok = false
              let mut j = 0
              while j < c0.length() {
                match c0[j] {
                  PseudoSel(nm, list) => if nm == "slotted" && any_matches(list, n) { ok = true; break }
                  _ => ()
                }
                j = j + 1
              }
              if ok { f.push(e) }
            }
            i = i + 1
          }
          if f.length() == 0 {
            empty_entries
          } else {
            sort_entries(f, entry_cmp)
            f
          }
        }
      } else { empty_entries }
    }
    None => empty_entries
  }
  let from_host : Array[Entry] = match host_rules {
    Some(h) => {
      let prev_host = sel_state.host_target
      sel_state.host_target = n.uid
      let raw = h.matching(n, pseudo).entries
      sel_state.host_target = prev_host
      if raw.length() == 0 {
        empty_entries
      } else {
        let f : Array[Entry] = []
        let mut i = 0
        while i < raw.length() {
          let e = raw[i]
          if !e.ua && e.sel.parts.length() > 0 {
            let c0 = e.sel.parts[0].compound
            let mut ok = false
            let mut j = 0
            while j < c0.length() {
              match c0[j] {
                PseudoSel(nm, _) => if nm == "host" { ok = true; break }
                _ => ()
              }
              j = j + 1
            }
            if ok { f.push(e) }
          }
          i = i + 1
        }
        if f.length() == 0 {
          empty_entries
        } else {
          sort_entries(f, entry_cmp)
          f
        }
      }
    }
    None => empty_entries
  }
  if pseudo != "" && found.length() == 0 {
    return None
  }
  let style_attr = if pseudo == "" { n.attr("style") } else { None }
  match style_attr {
    Some(a) => {
      if !self.viewport_units {
        if str_contains_ci_ascii(a, "vw") || str_contains_ci_ascii(a, "vh") || str_contains_ci_ascii(a, "vmin") ||
        str_contains_ci_ascii(a, "vmax") || str_contains_ci_ascii(a, "vi") || str_contains_ci_ascii(a, "vb") {
          self.viewport_units = true
        }
      }
    }
    None => ()
  }
  let hint_text = if pseudo == "" { hints(n) } else { "" }
  let mut share : Option[ShareTarget] = None
  match parent {
    Some(p) => {
      let mut any_attr = (found_ml.flags & 1) != 0
      let mut i = 0
      while !any_attr && i < from_host.length() { if from_host[i].attr_fn { any_attr = true; break }; i = i + 1 }
      i = 0
      while !any_attr && i < from_slot.length() { if from_slot[i].attr_fn { any_attr = true; break }; i = i + 1 }
      i = 0
      while !any_attr && i < from_part.length() { if from_part[i].attr_fn { any_attr = true; break }; i = i + 1 }
      if !any_attr {
        match style_attr {
          Some(a) => if str_contains_ci_ascii(a, "attr(") { any_attr = true }
          None => ()
        }
      }
      if sel_state.scope_node.is_none() && !any_attr {
        let key = if pseudo == "" && from_host.length() == 0 &&
        from_slot.length() == 0 && from_part.length() == 0 && style_attr.is_none() && hint_text == "" {
          if found.length() == 0 {
            empty_share_key
          } else if found_ml.share_key != "" {
            found_ml.share_key
          } else {
            let k = style_share_sb
            k.reset()
            i = 0
            while i < found.length() { k.write_byte(b','); css_sb_write_int(k, found[i].order); i = i + 1 }
            k.write_string("|\u{0}|")
            let built = k.to_string()
            k.reset()
            found_ml.share_key = built
            built
          }
        } else {
          let k = style_share_sb
          k.reset()
          k.write_string(pseudo)
          i = 0
          while i < found.length() { k.write_byte(b','); css_sb_write_int(k, found[i].order); i = i + 1 }
          match host_rules {
            Some(h) => {
              if from_host.length() > 0 {
                k.write_string("|h"); css_sb_write_int(k, h.share_gen)
                i = 0
                while i < from_host.length() { k.write_byte(b','); css_sb_write_int(k, from_host[i].order); i = i + 1 }
              }
            }
            None => ()
          }
          match slotted {
            Some(sl) => {
              if from_slot.length() > 0 {
                k.write_string("|s"); css_sb_write_int(k, sl.engine.share_gen)
                i = 0
                while i < from_slot.length() { k.write_byte(b','); css_sb_write_int(k, from_slot[i].order); i = i + 1 }
              }
            }
            None => ()
          }
          if from_part.length() > 0 {
            k.write_string("|p")
            i = 0
            while i < parts.length() { k.write_byte(b':'); css_sb_write_int(k, parts[i].1.share_gen); i = i + 1 }
            i = 0
            while i < from_part.length() { k.write_byte(b','); css_sb_write_int(k, from_part[i].order); i = i + 1 }
          }
          k.write_byte(b'|')
          k.write_string(match style_attr { Some(s) => s None => "\u{0}" })
          k.write_byte(b'|')
          k.write_string(hint_text)
          let built = k.to_string()
          k.reset()
          built
        }
        if p.kids_gen != self.share_gen {
          p.kids_gen = self.share_gen
          p.kids = None
          p.kid0_key = ""
          p.kid0_val = None
          p.kid1_key = ""
          p.kid1_val = None
          p.kid2_key = ""
          p.kid2_val = None
          p.kid3_key = ""
          p.kid3_val = None
        }
        let hit : Option[Style] = match p.kids {
          Some(m) => m.get(key)
          None => {
            match p.kid0_val {
              Some(s0) if p.kid0_key == key => Some(s0)
              _ => match p.kid1_val {
                Some(s1) if p.kid1_key == key => Some(s1)
                _ => match p.kid2_val {
                  Some(s2) if p.kid2_key == key => Some(s2)
                  _ => match p.kid3_val {
                    Some(s3) if p.kid3_key == key => Some(s3)
                    _ => None
                  }
                }
              }
            }
          }
        }
        match hit {
          Some(st) => {
            style_counts[6] = style_counts[6] + 1
            return Some(st)
          }
          None => share = Some(ShareTarget::{ parent: p, gen: self.share_gen, key: key })
        }
      }
    }
    None => ()
  }
  let values = Props::new()
  let inline : Array[Decl] = match style_attr {
    Some(s) =>
    if s == "" {
      empty_decls
    } else {
      match inline_decls_cache.get(s) {
        Some((ds, has_trans)) => {
          if has_trans && !self.has_transitions_flag {
            self.has_transitions_flag = true
          }
          ds
        }
        None => {
          let ds = parse_decls(tokenize(s))
          let mut has_trans = false
          let mut i = 0
          while i < ds.length() {
            let nm = ds[i].name
            if nm == "transition" || nm == "transition-duration" || nm == "transition-property" {
              has_trans = true
              break
            }
            i = i + 1
          }
          if has_trans && !self.has_transitions_flag {
            self.has_transitions_flag = true
          }
          if s.length() <= 256 {
            if inline_decls_cache.length() >= 1024 {
              inline_decls_cache.clear()
            }
            inline_decls_cache.set(s, (ds, has_trans))
          }
          ds
        }
      }
    }
    None => empty_decls
  }
  // Custom properties
  let mut need_var_hist = self.has_var_revert_layer
  if !need_var_hist {
    match host_rules {
      Some(h) => if h.has_var_revert_layer { need_var_hist = true }
      None => ()
    }
  }
  if !need_var_hist {
    match slotted {
      Some(sl) => if sl.engine.has_var_revert_layer { need_var_hist = true }
      None => ()
    }
  }
  if !need_var_hist && parts.length() > 0 {
    let mut pi = 0
    while pi < parts.length() {
      if parts[pi].1.has_var_revert_layer { need_var_hist = true; break }
      pi = pi + 1
    }
  }
  if !need_var_hist {
    match style_attr {
      Some(s) => if str_contains_ci_ascii(s, "revert-layer") { need_var_hist = true }
      None => ()
    }
  }
  let mut own_vars_opt : Option[Map[String, Array[Tok]]] = None
  let mut var_decls_opt : Option[Map[String, Array[VarHistItem]]] = None
  let mut var_count = 0
  let mut var0_k = ""
  let mut var0_v : Array[Tok] = empty_toks
  let mut any_var_attr = false
  if (found_ml.flags & 2) != 0 || from_host.length() > 0 || from_slot.length() > 0 || from_part.length() > 0 {
    let mut vsi = 0
    while vsi < 4 {
      let arr = if vsi == 0 { from_host } else if vsi == 1 { from_slot } else if vsi == 2 { found } else { from_part }
      let mut ai = 0
      while ai < arr.length() {
        let e = arr[ai]
        if e.has_vars {
          let mut di = 0
          while di < e.decls.length() {
            let d = e.decls[di]
            if str_has_prefix(d.name, "--") {
              if e.attr_fn { any_var_attr = true }
              if need_var_hist {
                let ov = match own_vars_opt {
                  Some(m) => m
                  None => { let m : Map[String, Array[Tok]] = Map::new(); own_vars_opt = Some(m); m }
                }
                let vd = match var_decls_opt {
                  Some(m) => m
                  None => { let m : Map[String, Array[VarHistItem]] = Map::new(); var_decls_opt = Some(m); m }
                }
                ov.set(d.name, d.value)
                let item = VarHistItem::{ layer: e.layer, value: d.value }
                match vd.get(d.name) {
                  Some(a) => a.push(item)
                  None => vd.set(d.name, [item])
                }
              } else {
                match own_vars_opt {
                  Some(ov) => ov.set(d.name, d.value)
                  None => {
                    if var_count == 0 {
                      var0_k = d.name
                      var0_v = d.value
                      var_count = 1
                    } else if var0_k == d.name {
                      var0_v = d.value
                    } else {
                      let m : Map[String, Array[Tok]] = Map::new()
                      m.set(var0_k, var0_v)
                      m.set(d.name, d.value)
                      own_vars_opt = Some(m)
                      var_count = 2
                    }
                  }
                }
              }
            }
            di = di + 1
          }
        }
        ai = ai + 1
      }
      vsi = vsi + 1
    }
  }
  let mut fi = 0
  let mut ii = 0
  while ii < inline.length() {
    let d = inline[ii]
    if str_has_prefix(d.name, "--") {
      if has_attr_fn(d.value) { any_var_attr = true }
      if need_var_hist {
        let ov = match own_vars_opt {
          Some(m) => m
          None => { let m : Map[String, Array[Tok]] = Map::new(); own_vars_opt = Some(m); m }
        }
        ov.set(d.name, d.value)
        match var_decls_opt {
          Some(vd) => { let _ = vd.remove(d.name) }
          None => ()
        }
      } else {
        match own_vars_opt {
          Some(ov) => ov.set(d.name, d.value)
          None => {
            if var_count == 0 {
              var0_k = d.name
              var0_v = d.value
              var_count = 1
            } else if var0_k == d.name {
              var0_v = d.value
            } else {
              let m : Map[String, Array[Tok]] = Map::new()
              m.set(var0_k, var0_v)
              m.set(d.name, d.value)
              own_vars_opt = Some(m)
              var_count = 2
            }
          }
        }
      }
    }
    ii = ii + 1
  }
  let mut attr_invalid_opt : Option[Map[String, Bool]] = None
  if any_var_attr {
    if own_vars_opt.is_none() && var_count == 1 {
      let m : Map[String, Array[Tok]] = Map::new()
      m.set(var0_k, var0_v)
      own_vars_opt = Some(m)
    }
    match own_vars_opt {
      Some(own_vars) => {
        let ks = own_vars.keys()
        let mut ki = 0
        while ki < ks.length() {
          let k = ks[ki]
          match own_vars.get(k) {
            Some(vv) => {
              match subst_attr(vv, n, empty_str_arr) {
                Some(x) => own_vars.set(k, x)
                None => {
                  let ai = match attr_invalid_opt {
                    Some(m) => m
                    None => { let m : Map[String, Bool] = Map::new(); attr_invalid_opt = Some(m); m }
                  }
                  ai.set(k, true)
                }
              }
            }
            None => ()
          }
          ki = ki + 1
        }
      }
      None => ()
    }
  }
  let resets : Array[(String, RegProp)] = match parent {
    Some(p) => {
      if self.registered.length() > 0 {
        let out : Array[(String, RegProp)] = []
        let rks = self.registered.keys()
        let mut ri = 0
        while ri < rks.length() {
          let k = rks[ri]
          match self.registered.get(k) {
            Some(rp) => {
              if !rp.inherits && !opt_toks_same(p.vars.get(k), rp.initial) {
                out.push((k, rp))
              }
            }
            None => ()
          }
          ri = ri + 1
        }
        out
      } else {
        empty_resets
      }
    }
    None => empty_resets
  }
  let has_any_own_var = var_count > 0 || own_vars_opt.is_some()
  let vars : VarMap = match parent {
    Some(p) => if !has_any_own_var && resets.length() == 0 { p.vars } else { VarMap::overlay(p.vars) }
    None => if !has_any_own_var && self.registered.length() == 0 { empty_var_map } else { VarMap::empty() }
  }
  let mut ri = 0
  while ri < resets.length() {
    let kv = resets[ri]
    match kv.1.initial { Some(v) => vars.set(kv.0, v) None => vars.remove(kv.0) }
    ri = ri + 1
  }
  if parent.is_none() && self.registered.length() > 0 {
    let rks = self.registered.keys()
    ri = 0
    while ri < rks.length() {
      let k = rks[ri]
      match self.registered.get(k) {
        Some(rp) => match rp.initial { Some(v) => vars.set(k, v) None => vars.remove(k) }
        None => ()
      }
      ri = ri + 1
    }
  }
  if own_vars_opt.is_none() && var_count == 1 {
    if !has_var(var0_v) {
      let tv = trim(var0_v)
      let kw = if tv.length() == 1 {
        match tv[0] { Ident(w) => { let lw = ascii_lower(w); if is_global_keyword(lw) { lw } else { "" } } _ => "" }
      } else { "" }
      if kw != "" {
        match var_keyword_value(self, parent, var0_k, kw) { Some(x) => vars.set(var0_k, x) None => vars.remove(var0_k) }
      } else {
        vars.set(var0_k, var0_v)
      }
    } else {
      let m : Map[String, Array[Tok]] = Map::new()
      m.set(var0_k, var0_v)
      own_vars_opt = Some(m)
    }
  }
  match own_vars_opt {
    Some(own_vars) => {
      let ks = own_vars.keys()
      let mut ki = 0
      while ki < ks.length() {
        let k = ks[ki]
        let is_invalid = match attr_invalid_opt { Some(ai) => ai.contains(k) None => false }
        let mut resolved = if is_invalid { None } else { resolve_var(k, own_vars, vars, empty_str_arr) }
        match var_decls_opt {
          Some(vd) => {
            match vd.get(k) {
              Some(hist) => {
                let mut hi = hist.length() - 1
                while hi >= 0 {
                  let is_rl = match resolved {
                    Some(v) => {
                      let tv = trim(v)
                      tv.length() == 1 && match tv[0] { Ident(w) => ascii_lower(w) == "revert-layer" _ => false }
                    }
                    None => false
                  }
                  if !is_rl { break }
                  let layer = hist[hi].layer
                  while hi >= 0 && layer_eq(hist[hi].layer, layer) { hi = hi - 1 }
                  if hi >= 0 {
                    own_vars.set(k, hist[hi].value)
                    resolved = resolve_var(k, own_vars, vars, empty_str_arr)
                  }
                }
              }
              None => ()
            }
          }
          None => ()
        }
        match resolved {
          Some(v) => {
            let tv = trim(v)
            let kw = if tv.length() == 1 {
              match tv[0] { Ident(w) => { let lw = ascii_lower(w); if is_global_keyword(lw) { lw } else { "" } } _ => "" }
            } else { "" }
            if kw != "" {
              match var_keyword_value(self, parent, k, kw) { Some(x) => vars.set(k, x) None => vars.remove(k) }
            } else {
              vars.set(k, v)
            }
          }
          None => {
            if self.registered.contains(k) {
              match var_keyword_value(self, parent, k, "unset") { Some(x) => vars.set(k, x) None => vars.remove(k) }
            } else {
              vars.remove(k)
            }
          }
        }
        ki = ki + 1
      }
    }
    None => ()
  }
  fi = 0
  if (found_ml.flags & 8) != 0 {
    while fi < found.length() {
      if found[fi].ua {
        let ds = found[fi].decls
        let ha = found[fi].attr_fn
        let mut di = 0
        while di < ds.length() { apply_decl_to_props(ds[di], values, vars, n, ha); di = di + 1 }
      }
      fi = fi + 1
    }
  }
  fi = 0
  while fi < from_host.length() {
    let ds = from_host[fi].decls
    let ha = from_host[fi].attr_fn
    let mut di = 0
    while di < ds.length() { apply_decl_to_props(ds[di], values, vars, n, ha); di = di + 1 }
    fi = fi + 1
  }
  fi = 0
  while fi < from_slot.length() {
    let ds = from_slot[fi].decls
    let ha = from_slot[fi].attr_fn
    let mut di = 0
    while di < ds.length() { apply_decl_to_props(ds[di], values, vars, n, ha); di = di + 1 }
    fi = fi + 1
  }
  if hint_text != "" {
    let hds = parse_decls(tokenize(hint_text))
    let mut di = 0
    while di < hds.length() { expand_props(hds[di].name, hds[di].value, values); di = di + 1 }
  }
  if (found_ml.flags & 16) != 0 {
    fi = 0
    while fi < found.length() {
      if !found[fi].ua {
        let ds = found[fi].decls
        let ha = found[fi].attr_fn
        let mut di = 0
        while di < ds.length() { apply_decl_to_props(ds[di], values, vars, n, ha); di = di + 1 }
      }
      fi = fi + 1
    }
  }
  fi = 0
  while fi < from_part.length() {
    let ds = from_part[fi].decls
    let ha = from_part[fi].attr_fn
    let mut di = 0
    while di < ds.length() { apply_decl_to_props(ds[di], values, vars, n, ha); di = di + 1 }
    fi = fi + 1
  }
  ii = 0
  while ii < inline.length() {
    let d = inline[ii]
    apply_decl_to_props(d, values, vars, n, has_attr_fn(d.value))
    ii = ii + 1
  }
  // !important declarations
  let mut any_important = (found_ml.flags & 4) != 0
  if !any_important {
    fi = 0
    while fi < from_host.length() { if from_host[fi].has_important { any_important = true; break }; fi = fi + 1 }
  }
  if !any_important {
    fi = 0
    while fi < from_slot.length() { if from_slot[fi].has_important { any_important = true; break }; fi = fi + 1 }
  }
  if !any_important {
    fi = 0
    while fi < from_part.length() { if from_part[fi].has_important { any_important = true; break }; fi = fi + 1 }
  }
  if !any_important {
    ii = 0
    while ii < inline.length() { if inline[ii].important { any_important = true; break }; ii = ii + 1 }
  }
  if any_important {
    let important = Props::new()
    fi = 0
    while fi < from_part.length() {
      if from_part[fi].has_important {
        let ds = from_part[fi].decls
        let ha = from_part[fi].attr_fn
        let mut di = 0
        while di < ds.length() { if ds[di].important { apply_decl_to_props(ds[di], important, vars, n, ha) }; di = di + 1 }
      }
      fi = fi + 1
    }
    let found_imp : Array[Entry] = []
    let mut has_layered = false
    fi = 0
    while fi < found.length() {
      if !found[fi].ua && found[fi].has_important {
        found_imp.push(found[fi])
        if found[fi].layer.length() > 0 { has_layered = true }
      }
      fi = fi + 1
    }
    if has_layered {
      sort_entries(found_imp, fn(a : Entry, b : Entry) -> Int {
        let l = layer_cmp(b.layer, a.layer)
        if l != 0 { l } else { entry_cmp(a, b) }
      })
    }
    fi = 0
    while fi < found_imp.length() {
      let ds = found_imp[fi].decls
      let ha = found_imp[fi].attr_fn
      let mut di = 0
      while di < ds.length() { if ds[di].important { apply_decl_to_props(ds[di], important, vars, n, ha) }; di = di + 1 }
      fi = fi + 1
    }
    fi = 0
    while fi < from_slot.length() {
      if from_slot[fi].has_important {
        let ds = from_slot[fi].decls
        let ha = from_slot[fi].attr_fn
        let mut di = 0
        while di < ds.length() { if ds[di].important { apply_decl_to_props(ds[di], important, vars, n, ha) }; di = di + 1 }
      }
      fi = fi + 1
    }
    fi = 0
    while fi < from_host.length() {
      if from_host[fi].has_important {
        let ds = from_host[fi].decls
        let ha = from_host[fi].attr_fn
        let mut di = 0
        while di < ds.length() { if ds[di].important { apply_decl_to_props(ds[di], important, vars, n, ha) }; di = di + 1 }
      }
      fi = fi + 1
    }
    ii = 0
    while ii < inline.length() {
      let d = inline[ii]
      if d.important { apply_decl_to_props(d, important, vars, n, has_attr_fn(d.value)) }
      ii = ii + 1
    }
    fi = 0
    while fi < found.length() {
      if found[fi].ua && found[fi].has_important {
        let ds = found[fi].decls
        let ha = found[fi].attr_fn
        let mut di = 0
        while di < ds.length() { if ds[di].important { apply_decl_to_props(ds[di], important, vars, n, ha) }; di = di + 1 }
      }
      fi = fi + 1
    }
    important.each_id(fn(id : Int, v : Array[Tok]) -> Unit { values.set_id(id, v) })
    let iks = important.keys()
    let mut ki = 0
    while ki < iks.length() {
      if !str_has_prefix(iks[ki], "-fv-") {
        values.set_id(important_mark(iks[ki]), logical_yes)
      }
      ki = ki + 1
    }
  }
  let parent_fs = match parent { Some(p) => p.font_size None => 16.0 }
  let mut uses_non_inh_inherit = false
  style_ids_buf.clear()
  values.collect_kw_or_var_ids(style_ids_buf)
  let mut ua_revert_vals : Option[Props] = None
  let mut id_i = 0
  while id_i < style_ids_buf.length() {
    let id = style_ids_buf[id_i]
    match values.get_id(id) {
      Some(v) => {
        match subst(v, vars, 0) {
          Some(x) => {
            let lw = if x.length() == 1 {
              match x[0] {
                Ident(w) => {
                  let wl = w.length()
                  if wl >= 5 && wl <= 12 { ascii_lower(w) } else { "" }
                }
                _ => ""
              }
            } else { "" }
            if lw == "inherit" {
              if id == p_font_size {
                values.set_id(id, [Dimension(parent_fs, "px")])
              } else {
                if (id_kind(id) & 0x10000) == 0 {
                  uses_non_inh_inherit = true
                }
                let pv = match parent { Some(p) => p.lookup_id(id) None => None }
                match pv { Some(y) => values.set_id(id, y) None => values.remove_id(id) }
              }
            } else if lw == "revert" {
              // CSS Cascade 4 §7.3.4: revert rolls back author origin to UA origin
              let ua_p = match ua_revert_vals {
                Some(p) => p
                None => {
                  let p = Props::new()
                  let mut ufi = 0
                  while ufi < found.length() {
                    if found[ufi].ua {
                      let uds = found[ufi].decls
                      let uha = found[ufi].attr_fn
                      let mut udi = 0
                      while udi < uds.length() {
                        apply_decl_to_props(uds[udi], p, vars, n, uha)
                        udi = udi + 1
                      }
                    }
                    ufi = ufi + 1
                  }
                  ua_revert_vals = Some(p)
                  p
                }
              }
              match ua_p.get_id(id) {
                Some(uv) => values.set_id(id, uv)
                None => values.remove_id(id)
              }
            } else if lw == "revert-layer" {
              // CSS Cascade 5 §7.3.4: revert-layer rolls back to the previous cascade layer (or UA origin)
              let tmp = Props::new()
              let mut prev_val : Option[Array[Tok]] = None
              let mut cur_val : Option[Array[Tok]] = None
              let is_rl = fn(tv : Array[Tok]) -> Bool {
                match subst(tv, vars, 0) {
                  Some(sv) if sv.length() == 1 => match sv[0] {
                    Ident(w) => w.length() == 12 && ascii_lower(w) == "revert-layer"
                    _ => false
                  }
                  _ => false
                }
              }
              // 1. UA origin
              let mut rfi = 0
              while rfi < found.length() {
                if found[rfi].ua {
                  let rds = found[rfi].decls
                  let rha = found[rfi].attr_fn
                  let mut rdi = 0
                  while rdi < rds.length() {
                    apply_decl_to_props(rds[rdi], tmp, vars, n, rha)
                    rdi = rdi + 1
                  }
                }
                rfi = rfi + 1
              }
              cur_val = tmp.get_id(id)
              prev_val = cur_val
              // 2. Presentational hints
              if hint_text != "" {
                tmp.remove_id(id)
                let hds = parse_decls(tokenize(hint_text))
                let mut hdi = 0
                while hdi < hds.length() {
                  expand_props(hds[hdi].name, hds[hdi].value, tmp)
                  hdi = hdi + 1
                }
                match tmp.get_id(id) {
                  Some(hv) => {
                    cur_val = Some(hv)
                    prev_val = cur_val
                  }
                  None => ()
                }
              }
              // 3. Author stylesheet layers (sorted by layer in `found`)
              let mut have_layer = false
              let mut active_layer : Array[Int] = []
              rfi = 0
              while rfi < found.length() {
                if !found[rfi].ua {
                  if !have_layer || layer_cmp(found[rfi].layer, active_layer) != 0 {
                    prev_val = cur_val
                    active_layer = found[rfi].layer
                    have_layer = true
                  }
                  let rds = found[rfi].decls
                  let rha = found[rfi].attr_fn
                  let mut rdi = 0
                  while rdi < rds.length() {
                    if !rds[rdi].important {
                      tmp.remove_id(id)
                      apply_decl_to_props(rds[rdi], tmp, vars, n, rha)
                      match tmp.get_id(id) {
                        Some(nv) => cur_val = if is_rl(nv) { prev_val } else { Some(nv) }
                        None => ()
                      }
                    }
                    rdi = rdi + 1
                  }
                }
                rfi = rfi + 1
              }
              // 4. Inline style layer (above all author stylesheet layers)
              prev_val = cur_val
              let mut rii = 0
              while rii < inline.length() {
                let d = inline[rii]
                if !d.important {
                  tmp.remove_id(id)
                  apply_decl_to_props(d, tmp, vars, n, has_attr_fn(d.value))
                  match tmp.get_id(id) {
                    Some(nv) => cur_val = if is_rl(nv) { prev_val } else { Some(nv) }
                    None => ()
                  }
                }
                rii = rii + 1
              }
              match cur_val {
                Some(rv) => match subst(rv, vars, 0) {
                  Some(sv) => values.set_id(id, sv)
                  None => values.remove_id(id)
                }
                None => values.remove_id(id)
              }
            } else if lw == "initial" || (lw == "unset" && (id_kind(id) & 0x10000) == 0) {
              values.remove_id(id)
              if id == p_font_size { values.set_id(id, [Dimension(16.0, "px")]) }
              else if id == p_color && parent.is_some() { values.set_id(id, [Ident("black")]) }
              else if parent.is_some() && (id_kind(id) & 0x10000) != 0 {
                if id == p_text_transform { values.set_id(id, [Ident("none")]) }
                else if id == p_font_style || id == p_font_weight ||
                id == p_line_height || id == p_letter_spacing || id == p_word_spacing || id == p_white_space {
                  values.set_id(id, [Ident("normal")])
                } else if id == p_visibility { values.set_id(id, [Ident("visible")]) }
                else if id == p_text_align { values.set_id(id, [Ident("start")]) }
                else if id == p_direction { values.set_id(id, [Ident("ltr")]) }
                else if id == p_color_scheme { values.set_id(id, [Ident("normal")]) }
              }
            } else if lw == "unset" {
              values.remove_id(id)
            } else {
              values.set_id(id, x)
            }
          }
          None => values.remove_id(id)
        }
      }
      None => ()
    }
    id_i = id_i + 1
  }
  style_ids_buf.clear()
  // RTL logical side swap
  let is_rtl = if values.maybe_has_id(p_direction) {
    match values.get_id(p_direction) {
      Some(v) => v.length() == 1 && match v[0] { Ident(w) => w == "rtl" _ => false }
      None => match parent { Some(p) => (p.flow_flags_val() & 4) != 0 None => false }
    }
  } else {
    match parent { Some(p) => (p.flow_flags_val() & 4) != 0 None => false }
  }
  if is_rtl {
    let mut pi = 0
    while pi < rtl_logical_pairs.length() {
      let l = rtl_logical_pairs[pi].0
      let r = rtl_logical_pairs[pi].1
      let ll = values.contains("-fv-logical-" + l)
      let lr = values.contains("-fv-logical-" + r)
      if ll || lr {
        let vl = values.get(l)
        let vr = values.get(r)
        if ll && lr { rtl_put(values, l, vr, true); rtl_put(values, r, vl, true) }
        else if ll { rtl_put(values, r, vl, true); rtl_put(values, l, None, false) }
        else { rtl_put(values, l, vr, true); rtl_put(values, r, None, false) }
      }
      pi = pi + 1
    }
  }
  let is_dark_cs = if values.maybe_has_id(p_color_scheme) {
    match values.get_id(p_color_scheme) {
      Some(v) => color_scheme_is_dark(v)
      None => match parent { Some(p) => (p.flow_flags_val() & 4096) != 0 None => false }
    }
  } else {
    match parent { Some(p) => (p.flow_flags_val() & 4096) != 0 None => false }
  }
  if is_dark_cs {
    resolve_light_dark_props(values, true)
  }
  resolve_lh_prop(values, parent, p_font_size)
  resolve_lh_prop(values, parent, p_line_height)
  let prev_cq = css_globals.cur_cq
  if self.has_cq {
    css_globals.cur_cq = self.ancestor_container_size(n)
  }
  let root = match parent { Some(p) => p.root_size() None => 16.0 }
  let own_fs = values.get_id(p_font_size)
  let mut fs = match own_fs {
    Some(v) => font_size_of(v, parent_fs, root, self.env)
    None => parent_fs
  }
  let own_fam = values.get_id(p_font_family)
  let parent_kw = match parent {
    Some(p) => p.kw_size
    None => true
  }
  let relative = match own_fs {
    None => parent_kw
    Some(v) => {
      if v.length() == 1 {
        match v[0] {
          Dimension(_, u) => (u == "em" || u == "ex") && parent_kw
          Percentage(_) => parent_kw
          Ident(w) => {
            let lw = ascii_lower(w)
            if lw == "larger" || lw == "smaller" { parent_kw } else { true }
          }
          _ => false
        }
      } else { false }
    }
  }
  if own_fam.is_some() && relative {
    let parent_fam = match parent { Some(p) => p.lookup_id(p_font_family) None => None }
    if is_mono_only(own_fam) && !is_mono_only(parent_fam) {
      fs = fs * 13.0 / 16.0
    } else if !is_mono_only(own_fam) && is_mono_only(parent_fam) && own_fs.is_none() {
      fs = fs * 16.0 / 13.0
    }
  }
  style_math_ids_buf.clear()
  values.collect_math_ids(style_math_ids_buf)
  if style_math_ids_buf.length() > 0 || values.maybe_has_id(p_line_height) || values.maybe_has_id(p_letter_spacing) || values.maybe_has_id(p_word_spacing) {
    css_globals.cur_family = match own_fam {
      Some(f) => f
      None => match parent { Some(p) => p.get_id(p_font_family) None => empty_toks }
    }
  } else {
    css_globals.cur_family = empty_toks
  }
  let mut mi = 0
  while mi < style_math_ids_buf.length() {
    let id = style_math_ids_buf[mi]
    let k = prop_names[id]
    if !str_has_prefix(k, "--") && !str_has_prefix(k, "-fv-") {
      match values.get_id(id) {
        Some(v0) => {
          let mut cur_v = v0
          if id != p_font_size && id != p_line_height && has_lh(v0) {
            let lh = style_own_lh(values, parent, fs, root, self.env)
            cur_v = with_lh(v0, lh, if parent.is_none() { lh } else { style_root_lh(parent) })
            values.set_id(id, cur_v)
          }
          let r = resolve_math(k, cur_v, fs, root, self.env)
          if !toks_eq(r, cur_v) { values.set_id(id, r) }
        }
        None => ()
      }
    }
    mi = mi + 1
  }
  style_math_ids_buf.clear()
  resolve_inh_len_prop(values, parent, p_line_height, true, fs, root, self.env)
  resolve_inh_len_prop(values, parent, p_letter_spacing, false, fs, root, self.env)
  resolve_inh_len_prop(values, parent, p_word_spacing, false, fs, root, self.env)
  let (st_cq_w, st_cq_h) = match css_globals.cur_cq {
    Some((cw, ch)) => (cw, ch)
    None => (0.0, 0.0)
  }
  css_globals.cur_cq = prev_cq
  let root_font = match parent { Some(p) => p.root_font None => fs }
  let is_empty = values.count == 0
  let st_values = if is_empty { empty_props } else { values }
  let (own_m0, own_m1, own_m2, own_m3) = if is_empty { (0L, 0L, 0L, 0L) } else { props_inherited_masks(st_values) }
  let inh_src = inherit_source(parent)
  let (pinh_m0, pinh_m1, pinh_m2, pinh_m3) = match inh_src {
    Some(p) => (p.inh_m0, p.inh_m1, p.inh_m2, p.inh_m3)
    None => (0L, 0L, 0L, 0L)
  }
  let st_anim_cb = animation_creates_cb(self, st_values)
  let st = Style::{
    uid: next_style_uid(),
    values: st_values,
    vars: vars,
    parent: parent,
    own_inherited: (own_m0 | own_m1 | own_m2 | own_m3) != 0L,
    inherit_from: inh_src,
    inh_m0: own_m0 | pinh_m0,
    inh_m1: own_m1 | pinh_m1,
    inh_m2: own_m2 | pinh_m2,
    inh_m3: own_m3 | pinh_m3,
    font_size: fs,
    env: self.env,
    inherited_found: None,
    root_font: root_font,
    picked: -1,
    picked_gen: 0,
    out_of_flow: 0,
    hot: if is_empty { no_hot } else { new_hot() },
    kids_gen: -1,
    kid0_key: "",
    kid0_val: None,
    kid1_key: "",
    kid1_val: None,
    kid2_key: "",
    kid2_val: None,
    kid3_key: "",
    kid3_val: None,
    kids: None,
    deco: -1,
    text: None,
    color_cached: None,
    cursor_cache: -2,
    flow_flags: -1,
    auto_m: -1,
    edge_pct: -1,
    disp_str: "",
    cq_w: st_cq_w,
    cq_h: st_cq_h,
    kw_size: relative,
    uses_non_inh_inherit: uses_non_inh_inherit,
    anim_cb: st_anim_cb,
  }
  match share {
    Some(sh) => {
      let p = sh.parent
      if p.kids_gen == sh.gen {
        match p.kids {
          Some(m) => m.set(sh.key, st)
          None => {
            if p.kid0_val.is_none() || p.kid0_key == sh.key {
              p.kid0_key = sh.key
              p.kid0_val = Some(st)
            } else if p.kid1_val.is_none() || p.kid1_key == sh.key {
              p.kid1_key = sh.key
              p.kid1_val = Some(st)
            } else if p.kid2_val.is_none() || p.kid2_key == sh.key {
              p.kid2_key = sh.key
              p.kid2_val = Some(st)
            } else if p.kid3_val.is_none() || p.kid3_key == sh.key {
              p.kid3_key = sh.key
              p.kid3_val = Some(st)
            } else {
              let m : Map[String, Style] = Map::new()
              match p.kid0_val { Some(s0) => m.set(p.kid0_key, s0) None => () }
              match p.kid1_val { Some(s1) => m.set(p.kid1_key, s1) None => () }
              match p.kid2_val { Some(s2) => m.set(p.kid2_key, s2) None => () }
              match p.kid3_val { Some(s3) => m.set(p.kid3_key, s3) None => () }
              m.set(sh.key, st)
              p.kid0_key = ""
              p.kid0_val = None
              p.kid1_key = ""
              p.kid1_val = None
              p.kid2_key = ""
              p.kid2_val = None
              p.kid3_key = ""
              p.kid3_val = None
              p.kids = Some(m)
            }
          }
        }
      }
    }
    None => ()
  }
  Some(st)
}
