///| CSS box-shadow parsing.
///| 1:1 port of `client/src/css/shadow.mbt`.

pub struct BoxShadow {
  pub inset : Bool
  pub dx : Double
  pub dy : Double
  pub blur : Double
  pub spread : Double
  pub color : Color
}

let empty_box_shadows : Array[BoxShadow] = []

pub fn Style::box_shadows(self : Style) -> Array[BoxShadow] {
  if !self.values.maybe_has_id(p_box_shadow) {
    return empty_box_shadows
  }
  let v = self.own_id(p_box_shadow)
  let vn = v.length()
  if vn == 0 {
    return empty_box_shadows
  }
  if vn == 1 {
    match v[0] {
      Ident(k) => if k == "none" || ascii_lower(k) == "none" { return empty_box_shadows }
      _ => ()
    }
  }
  let layers = split_top_commas(v)
  let out : Array[BoxShadow] = Array::with_capacity(layers.length())
  let mut li = 0
  while li < layers.length() {
    let layer = layers[li]
    let mut inset = false
    let mut l0 = 0.0
    let mut l1 = 0.0
    let mut l2 = 0.0
    let mut l3 = 0.0
    let mut lcnt = 0
    let mut color : Option[Color] = None
    let mut lens_done = false
    let ws = words(layer)
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      if w.length() == 1 {
        match w[0] {
          Ident(k) => {
            let lk = ascii_lower(k)
            if lk == "none" {
              return empty_box_shadows
            }
            if lk == "inset" && !inset {
              inset = true
              if lcnt > 0 {
                lens_done = true
              }
              wi = wi + 1
              continue
            }
          }
          _ => ()
        }
      }
      match self.length_of(w) {
        Some(l) => {
          if !lens_done && lcnt < 4 && l.pct == 0.0 {
            if lcnt == 0 { l0 = l.px }
            else if lcnt == 1 { l1 = l.px }
            else if lcnt == 2 { l2 = l.px }
            else { l3 = l.px }
            lcnt = lcnt + 1
          } else {
            return empty_box_shadows
          }
        }
        None => {
          let parsed = if w.length() > 1 && tokens_have_currentcolor(w) {
            let cur = self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
            parse_color_with_current(w, Some(cur))
          } else {
            parse_color(w, 0)
          }
          match parsed {
            Some(c) => {
              if color.is_none() {
                color = Some(c)
                if lcnt > 0 {
                  lens_done = true
                }
              } else {
                return empty_box_shadows
              }
            }
            None => return empty_box_shadows
          }
        }
      }
      wi = wi + 1
    }
    if lcnt < 2 {
      return empty_box_shadows
    }
    let blur = if lcnt > 2 { l2 } else { 0.0 }
    if blur < 0.0 {
      return empty_box_shadows
    }
    let ink = match color {
      Some(c) => {
        if c.r == -1 {
          match self.color_id(p_color) {
            Some(cc) => cc
            None => Color::{ r: 0, g: 0, b: 0, a: 1.0 }
          }
        } else {
          c
        }
      }
      None => {
        match self.color_id(p_color) {
          Some(cc) => cc
          None => Color::{ r: 0, g: 0, b: 0, a: 1.0 }
        }
      }
    }
    let spread = if lcnt > 3 { l3 } else { 0.0 }
    out.push(BoxShadow::{
      inset: inset,
      dx: l0,
      dy: l1,
      blur: blur,
      spread: spread,
      color: ink,
    })
    li = li + 1
  }
  out
}

pub struct TextShadow {
  pub dx : Double
  pub dy : Double
  pub blur : Double
  pub color : Color
}

let empty_text_shadows : Array[TextShadow] = []

pub fn Style::text_shadows(self : Style) -> Array[TextShadow] {
  let v = self.get_id(p_text_shadow)
  let vn = v.length()
  if vn == 0 {
    return empty_text_shadows
  }
  if vn == 1 {
    match v[0] {
      Ident(k) => if k == "none" || ascii_lower(k) == "none" { return empty_text_shadows }
      _ => ()
    }
  }
  let layers = split_top_commas(v)
  let out : Array[TextShadow] = Array::with_capacity(layers.length())
  let mut li = 0
  while li < layers.length() {
    let layer = layers[li]
    let mut l0 = 0.0
    let mut l1 = 0.0
    let mut l2 = 0.0
    let mut lcnt = 0
    let mut color : Option[Color] = None
    let mut lens_done = false
    let ws = words(layer)
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      if w.length() == 1 {
        match w[0] {
          Ident(k) => {
            if ascii_lower(k) == "none" {
              return empty_text_shadows
            }
          }
          _ => ()
        }
      }
      match self.length_of(w) {
        Some(l) => {
          if !lens_done && lcnt < 3 && l.pct == 0.0 {
            if lcnt == 0 { l0 = l.px }
            else if lcnt == 1 { l1 = l.px }
            else { l2 = l.px }
            lcnt = lcnt + 1
          } else {
            return empty_text_shadows
          }
        }
        None => {
          let parsed = if w.length() > 1 && tokens_have_currentcolor(w) {
            let cur = self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
            parse_color_with_current(w, Some(cur))
          } else {
            parse_color(w, 0)
          }
          match parsed {
            Some(c) => {
              if color.is_none() {
                color = Some(c)
                if lcnt > 0 {
                  lens_done = true
                }
              } else {
                return empty_text_shadows
              }
            }
            None => return empty_text_shadows
          }
        }
      }
      wi = wi + 1
    }
    if lcnt < 2 {
      return empty_text_shadows
    }
    let blur = if lcnt > 2 { l2 } else { 0.0 }
    if blur < 0.0 {
      return empty_text_shadows
    }
    let ink = match color {
      Some(c) => {
        if c.r == -1 {
          self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
        } else {
          c
        }
      }
      None => self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
    }
    out.push(TextShadow::{
      dx: l0,
      dy: l1,
      blur: blur,
      color: ink,
    })
    li = li + 1
  }
  out
}
