///| CSS box-shadow parsing.
///| 1:1 port of `client/src/css/shadow.mbt`.

pub struct BoxShadow {
  pub inset : Bool
  pub dx : Double
  pub dy : Double
  pub blur : Double
  pub spread : Double
  pub color : Color
}

let empty_box_shadows : Array[BoxShadow] = []

pub fn Style::box_shadows(self : Style) -> Array[BoxShadow] {
  if !self.values.maybe_has_id(p_box_shadow) {
    return empty_box_shadows
  }
  let v = self.own_id(p_box_shadow)
  if v.length() == 0 {
    return empty_box_shadows
  }
  let out : Array[BoxShadow] = []
  let layers = split_top_commas(v)
  let mut li = 0
  while li < layers.length() {
    let layer = layers[li]
    let mut inset = false
    let lens : Array[Double] = []
    let mut color : Option[Color] = None
    let mut lens_done = false
    let ws = words(layer)
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      if w.length() == 1 {
        match w[0] {
          Ident(k) => {
            let lk = ascii_lower(k)
            if lk == "none" {
              return empty_box_shadows
            }
            if lk == "inset" && !inset {
              inset = true
              if lens.length() > 0 {
                lens_done = true
              }
              wi = wi + 1
              continue
            }
          }
          _ => ()
        }
      }
      match self.length_of(w) {
        Some(l) => {
          if !lens_done && lens.length() < 4 && l.pct == 0.0 {
            lens.push(l.px)
          } else {
            return []
          }
        }
        None => {
          let parsed = if w.length() > 1 && tokens_have_currentcolor(w) {
            let cur = self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
            parse_color_with_current(w, Some(cur))
          } else {
            parse_color(w, 0)
          }
          match parsed {
            Some(c) => {
              if color.is_none() {
                color = Some(c)
                if lens.length() > 0 {
                  lens_done = true
                }
              } else {
                return []
              }
            }
            None => return []
          }
        }
      }
      wi = wi + 1
    }
    if lens.length() < 2 {
      return []
    }
    let blur = if lens.length() > 2 { lens[2] } else { 0.0 }
    if blur < 0.0 {
      return []
    }
    let ink = match color {
      Some(c) => {
        if c.r == -1 {
          match self.color("color") {
            Some(cc) => cc
            None => Color::{ r: 0, g: 0, b: 0, a: 1.0 }
          }
        } else {
          c
        }
      }
      None => {
        match self.color("color") {
          Some(cc) => cc
          None => Color::{ r: 0, g: 0, b: 0, a: 1.0 }
        }
      }
    }
    let spread = if lens.length() > 3 { lens[3] } else { 0.0 }
    out.push(BoxShadow::{
      inset: inset,
      dx: lens[0],
      dy: lens[1],
      blur: blur,
      spread: spread,
      color: ink,
    })
    li = li + 1
  }
  out
}

pub struct TextShadow {
  pub dx : Double
  pub dy : Double
  pub blur : Double
  pub color : Color
}

let empty_text_shadows : Array[TextShadow] = []

pub fn Style::text_shadows(self : Style) -> Array[TextShadow] {
  let v = self.get_id(p_text_shadow)
  if v.length() == 0 {
    return empty_text_shadows
  }
  let out : Array[TextShadow] = []
  let layers = split_top_commas(v)
  let mut li = 0
  while li < layers.length() {
    let layer = layers[li]
    let lens : Array[Double] = []
    let mut color : Option[Color] = None
    let mut lens_done = false
    let ws = words(layer)
    let mut wi = 0
    while wi < ws.length() {
      let w = ws[wi]
      if w.length() == 1 {
        match w[0] {
          Ident(k) => {
            if ascii_lower(k) == "none" {
              return empty_text_shadows
            }
          }
          _ => ()
        }
      }
      match self.length_of(w) {
        Some(l) => {
          if !lens_done && lens.length() < 3 && l.pct == 0.0 {
            lens.push(l.px)
          } else {
            return empty_text_shadows
          }
        }
        None => {
          let parsed = if w.length() > 1 && tokens_have_currentcolor(w) {
            let cur = self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
            parse_color_with_current(w, Some(cur))
          } else {
            parse_color(w, 0)
          }
          match parsed {
            Some(c) => {
              if color.is_none() {
                color = Some(c)
                if lens.length() > 0 {
                  lens_done = true
                }
              } else {
                return empty_text_shadows
              }
            }
            None => return empty_text_shadows
          }
        }
      }
      wi = wi + 1
    }
    if lens.length() < 2 {
      return empty_text_shadows
    }
    let blur = if lens.length() > 2 { lens[2] } else { 0.0 }
    if blur < 0.0 {
      return empty_text_shadows
    }
    let ink = match color {
      Some(c) => {
        if c.r == -1 {
          self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
        } else {
          c
        }
      }
      None => self.color_id(p_color).unwrap_or(Color::{ r: 0, g: 0, b: 0, a: 1.0 })
    }
    out.push(TextShadow::{
      dx: lens[0],
      dy: lens[1],
      blur: blur,
      color: ink,
    })
    li = li + 1
  }
  out
}
