///| CSS value serialization and declaration validation.
///| 1:1 port of `client/src/css/serialize.mbt`.

fn num_text(n : Double) -> String {
  if n == fvdmath::floor(n) && fvdmath::abs(n) < 1000000000000000.0 {
    fvdmath::d2i64(n).to_string()
  } else {
    let r = fvdmath::round(n * 1000000.0) / 1000000.0
    if r == fvdmath::floor(r) && fvdmath::abs(r) < 1000000000000000.0 {
      fvdmath::d2i64(r).to_string()
    } else {
      r.to_string()
    }
  }
}

pub fn serialize_value(t : Array[Tok]) -> String {
  let b = StringBuilder::new()
  let mut pending_space = false
  let mut after_open = true
  let mut i = 0
  while i < t.length() {
    let x = t[i]
    match x {
      Space => {
        pending_space = !after_open
        i = i + 1
        continue
      }
      CloseParen => {
        b.write_char((41).unsafe_to_char())
        pending_space = false
        after_open = false
        i = i + 1
        continue
      }
      Comma => {
        b.write_string(", ")
        pending_space = false
        after_open = true
        i = i + 1
        continue
      }
      _ => ()
    }
    if pending_space {
      b.write_char((32).unsafe_to_char())
    }
    pending_space = false
    after_open = false
    match x {
      Ident(w) => b.write_string(w)
      Number(n) => b.write_string(num_text(n))
      Dimension(n, u) => b.write_string(num_text(n) + ascii_lower(u))
      Percentage(n) => b.write_string(num_text(n) + "%")
      Hash(h, _) => b.write_string("#" + h)
      Str(s) => b.write_string("\"" + s + "\"")
      Url(u) => b.write_string("url(\"" + u + "\")")
      Function(f) => {
        b.write_string(ascii_lower(f) + "(")
        after_open = true
      }
      Delim(c) => write_utf8_cp(b, c)
      Colon => b.write_char((58).unsafe_to_char())
      OpenParen => {
        b.write_char((40).unsafe_to_char())
        after_open = true
      }
      OpenSquare => b.write_char((91).unsafe_to_char())
      CloseSquare => b.write_char((93).unsafe_to_char())
      _ => ()
    }
    i = i + 1
  }
  b.to_string()
}

pub fn longhands_of(name : String, value : String) -> Array[(String, String)] {
  let raw = tok_filter_no_end(trim(tokenize(value)))
  let toks = match tok_search_delim(raw, 33) {
    Some(k) => trim(tok_slice(raw, 0, k))
    None => raw
  }
  if toks.length() == 0 {
    return []
  }
  let lname = ascii_lower(name)
  if !valid_decl(alias_of(lname), toks) {
    return []
  }
  if has_var(toks) || has_attr_fn(toks) {
    return [(alias_of(lname), serialize_value(toks))]
  }
  let out : Map[String, Array[Tok]] = Map::new()
  expand(lname, toks, out)
  let res : Array[(String, String)] = []
  let ks = out.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    if !str_has_prefix(k, "-fv-") {
      match out.get(k) {
        Some(v) => res.push((k, serialize_value(v)))
        None => ()
      }
    }
    i = i + 1
  }
  res
}

fn keyword_values_for(name : String) -> Option[Array[String]] {
  if name == "flex-direction" {
    Some(["row", "row-reverse", "column", "column-reverse"])
  } else if name == "position" {
    Some(["static", "relative", "absolute", "fixed", "sticky"])
  } else if name == "float" {
    Some(["none", "left", "right", "inline-start", "inline-end"])
  } else if name == "clear" {
    Some(["none", "left", "right", "both", "inline-start", "inline-end"])
  } else if name == "visibility" {
    Some(["visible", "hidden", "collapse"])
  } else if name == "box-sizing" {
    Some(["content-box", "border-box"])
  } else if name == "white-space" {
    Some(["normal", "pre", "nowrap", "pre-wrap", "pre-line", "break-spaces"])
  } else if name == "direction" {
    Some(["ltr", "rtl"])
  } else if name == "table-layout" {
    Some(["auto", "fixed"])
  } else if name == "border-collapse" {
    Some(["collapse", "separate"])
  } else if name == "text-align" {
    Some([
      "left", "right", "center", "justify", "start", "end", "match-parent",
      "-webkit-left", "-webkit-right", "-webkit-center", "-webkit-match-parent",
    ])
  } else {
    None
  }
}

fn is_global_keyword(w : String) -> Bool {
  w == "inherit" || w == "initial" || w == "unset" || w == "revert" || w == "revert-layer"
}

fn valid_decl(name : String, toks : Array[Tok]) -> Bool {
  let ws = tok_filter_no_space_end(toks)
  let global = ws.length() == 1 && match ws[0] {
    Ident(w) => is_global_keyword(ascii_lower(w))
    _ => false
  }
  if global || has_var(toks) {
    return true
  }
  match keyword_values_for(name) {
    Some(kws) => {
      if ws.length() == 1 {
        match ws[0] {
          Ident(w) => return str_arr_contains(kws, ascii_lower(w))
          _ => return false
        }
      }
      return false
    }
    None => ()
  }
  if quirky_value(name, toks).is_none() {
    return false
  }
  if name == "flex-grow" || name == "flex-shrink" {
    if ws.length() == 1 {
      match ws[0] {
        Number(n) => return n >= 0.0
        _ => ()
      }
    }
    if ws.length() > 0 {
      match ws[0] { Function(_) => return true _ => () }
    }
    return false
  }
  if name == "order" {
    if ws.length() == 1 {
      match ws[0] {
        Number(n) => return n == fvdmath::floor(n)
        _ => ()
      }
    }
    if ws.length() > 0 {
      match ws[0] { Function(_) => return true _ => () }
    }
    return false
  }
  if name == "flex-flow" || name == "flex-wrap" {
    let mut dir = 0
    let mut wrap = 0
    let mut nowrap = 0
    let mut balance = 0
    let mut i = 0
    while i < ws.length() {
      match ws[i] {
        Ident(x) => {
          let lx = ascii_lower(x)
          if name == "flex-flow" && (lx == "row" || lx == "row-reverse" || lx == "column" || lx == "column-reverse") {
            dir = dir + 1
          } else if lx == "wrap" || lx == "wrap-reverse" {
            wrap = wrap + 1
          } else if lx == "nowrap" {
            nowrap = nowrap + 1
          } else if lx == "balance" {
            balance = balance + 1
          } else {
            return false
          }
        }
        _ => return false
      }
      i = i + 1
    }
    return dir <= 1 && wrap <= 1 && nowrap <= 1 && balance <= 1 && !(nowrap == 1 && wrap + balance > 0) && ws.length() >= 1
  }
  if name == "grid-template-columns" || name == "grid-template-rows" {
    return track_list_ok(ws, toks)
  }
  if name == "background-image" || name == "list-style-image" || name == "border-image-source" || name == "mask-image" {
    return image_list_valid(toks)
  }
  if name == "flex-line-count" {
    if ws.length() == 1 {
      match ws[0] {
        Number(n) => return n >= 1.0 && n == fvdmath::floor(n)
        Ident(w) => return ascii_lower(w) == "none"
        _ => ()
      }
    }
    return false
  }
  if name == "flex-basis" {
    let comps = words(toks)
    if comps.length() != 1 || comps[0].length() == 0 {
      return false
    }
    let w0 = comps[0][0]
    if !basis_ok(w0) {
      return false
    }
    match w0 {
      Function(f) => {
        if !toks_have_unit(comps[0]) || ascii_lower(f) == "anchor-size" {
          return false
        }
      }
      _ => ()
    }
    return true
  }
  if name == "flex" {
    if ws.length() == 1 {
      match ws[0] {
        Ident(w) => {
          let lw = ascii_lower(w)
          if lw == "none" || lw == "auto" || lw == "content" {
            return true
          }
        }
        _ => ()
      }
    }
    let mut nums = 0
    let mut bases = 0
    let mut last_num = false
    let mut runs = 0
    let comps = words(toks)
    let mut ci = 0
    while ci < comps.length() {
      let comp = comps[ci]
      if comp.length() == 0 {
        ci = ci + 1
        continue
      }
      let w = comp[0]
      let numeric = match w {
        Number(_) => true
        Function(f) => {
          let lf = ascii_lower(f)
          (lf == "calc" || lf == "min" || lf == "max" || lf == "clamp") && !toks_have_unit(comp)
        }
        _ => false
      }
      if numeric {
        if !last_num {
          runs = runs + 1
        }
        nums = nums + 1
        last_num = true
      } else if basis_ok(w) {
        bases = bases + 1
        last_num = false
      } else {
        return false
      }
      ci = ci + 1
    }
    let mut has_none = false
    let mut wi = 0
    while wi < ws.length() {
      match ws[wi] {
        Ident(x) => {
          if ascii_lower(x) == "none" {
            has_none = true
          }
        }
        _ => ()
      }
      wi = wi + 1
    }
    return nums <= 2 && bases <= 1 && runs <= 1 && ws.length() >= 1 && !has_none
  }
  true
}

fn basis_ok(t : Tok) -> Bool {
  match t {
    Ident(w) => {
      let lw = ascii_lower(w)
      lw == "auto" || lw == "content" || lw == "min-content" || lw == "max-content" || lw == "fit-content"
    }
    Dimension(n, _) => n >= 0.0
    Percentage(n) => n >= 0.0
    Number(n) => n == 0.0
    Function(f) => {
      let lf = ascii_lower(f)
      lf == "calc" || lf == "min" || lf == "max" || lf == "clamp"
    }
    _ => false
  }
}

fn toks_have_unit(t : Array[Tok]) -> Bool {
  let mut i = 0
  while i < t.length() {
    match t[i] {
      Dimension(_, _) => return true
      Percentage(_) => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn track_list_ok(ws : Array[Tok], toks : Array[Tok]) -> Bool {
  if ws.length() == 1 {
    match ws[0] {
      Ident(w) => {
        if ascii_lower(w) == "none" {
          return true
        }
      }
      _ => ()
    }
  }
  if ws.length() > 0 {
    match ws[0] {
      Ident(w) => {
        let lw = ascii_lower(w)
        if lw == "subgrid" || lw == "masonry" {
          return true
        }
      }
      _ => ()
    }
  }
  let mut tracks = 0
  let mut names_last = false
  let comps = words(toks)
  let mut ci = 0
  while ci < comps.length() {
    let w = comps[ci]
    if w.length() == 0 {
      return false
    }
    if tok_eq(w[0], OpenSquare) {
      if names_last || !tok_eq(w[w.length() - 1], CloseSquare) {
        return false
      }
      let mut j = 1
      while j < w.length() - 1 {
        match w[j] {
          Space => ()
          Ident(n) => {
            let ln = ascii_lower(n)
            if ln == "span" || ln == "auto" || ln == "initial" || ln == "inherit" ||
            ln == "unset" || ln == "default" || ln == "revert" || ln == "revert-layer" {
              return false
            }
          }
          _ => return false
        }
        j = j + 1
      }
      names_last = true
    } else if w.length() == 1 {
      match w[0] {
        Dimension(_, _) => {
          tracks = tracks + 1
          names_last = false
        }
        Percentage(_) => {
          tracks = tracks + 1
          names_last = false
        }
        Number(n) => {
          if n == 0.0 {
            tracks = tracks + 1
            names_last = false
          } else {
            return false
          }
        }
        Ident(k) => {
          let lk = ascii_lower(k)
          if lk == "auto" || lk == "min-content" || lk == "max-content" {
            tracks = tracks + 1
            names_last = false
          } else {
            return false
          }
        }
        _ => return false
      }
    } else {
      match w[0] {
        Function(f) => {
          let lf = ascii_lower(f)
          if lf == "minmax" || lf == "fit-content" || lf == "repeat" || lf == "calc" ||
          lf == "min" || lf == "max" || lf == "clamp" {
            tracks = tracks + 1
            names_last = false
          } else {
            return false
          }
        }
        _ => return false
      }
    }
    ci = ci + 1
  }
  tracks > 0
}
