  "text-transform", "text-indent", "letter-spacing", "word-spacing", "line-height",
  "font-size-adjust", "font-stretch", "font-palette", "outline-offset", "outline-width",
  "outline-style", "outline-color", "z-index", "order", "opacity", "visibility", "box-sizing",
  "float", "clear", "position", "display", "content", "clip", "box-decoration-break",
  "shape-outside", "shape-margin", "mask-image", "mask-size", "mask-position", "mask-repeat",
  "mask-origin", "mask-clip", "mask-composite", "mask-mode", "-webkit-mask-image",
  "-webkit-mask-size", "-webkit-mask-position", "-webkit-mask-repeat",
  "-webkit-mask-composite", "overflow-anchor", "overflow-clip-margin",
  "contain-intrinsic-size", "contain-intrinsic-width", "contain-intrinsic-height",
  "contain-intrinsic-block-size", "contain-intrinsic-inline-size", "row-gap", "column-gap",
  "align-content", "align-items", "align-self", "justify-content", "justify-items",
  "justify-self", "border-start-start-radius", "border-start-end-radius",
  "border-end-start-radius", "border-end-end-radius", "border-image-source",
  "list-style-image",
]

let known_extra_props_map : Map[String, Bool] = Map::new()

fn is_known_css_prop(name : String) -> Bool {
  let n = ascii_lower(name)
  if str_has_prefix(n, "--") {
    return true
  }
  if str_has_prefix(n, "-ms-") || str_has_prefix(n, "-moz-") || str_has_prefix(n, "-o-") ||
  n == "-webkit-touch-callout" || n == "-webkit-overflow-scrolling" {
    return false
  }
  let canon = alias_of(n)
  if prop_id_of(canon).is_some() || prop_id_of(n).is_some() {
    return true
  }
  if known_extra_props_map.get("all").is_none() {
    let mut i = 0
    while i < known_extra_props_list.length() {
      known_extra_props_map.set(known_extra_props_list[i], true)
      i = i + 1
    }
  }
  known_extra_props_map.contains(canon)
}

fn custom_prop_value_valid(toks : Array[Tok]) -> Bool {
  let stack : Array[Int] = []
  let mut i = 0
  while i < toks.length() {
    match toks[i] {
      Semicolon => if stack.length() == 0 { return false }
      OpenParen | Function(_) => stack.push(1)
      OpenSquare => stack.push(2)
      OpenCurly => stack.push(3)
      CloseParen => if stack.length() == 0 || stack[stack.length() - 1] != 1 { return false } else { let _ = stack.pop() }
      CloseSquare => if stack.length() == 0 || stack[stack.length() - 1] != 2 { return false } else { let _ = stack.pop() }
      CloseCurly => if stack.length() == 0 || stack[stack.length() - 1] != 3 { return false } else { let _ = stack.pop() }
      _ => ()
    }
    i = i + 1
  }
  stack.length() == 0
}

fn supports_decl_toks(name : String, value_raw : Array[Tok], allow_important~ : Bool = false) -> Bool {
  let v_toks = tok_filter_no_space(value_raw)
  if v_toks.length() == 0 {
    return false
  }
  let mut eff_raw = value_raw
  let has_imp = if v_toks.length() >= 2 {
    match (v_toks[v_toks.length() - 2], v_toks[v_toks.length() - 1]) {
      (Delim(33), Ident(w)) if ascii_lower(w) == "important" => true
      _ => false
    }
  } else {
    false
  }
  if has_imp {
    if !allow_important {
      return false
    }
    // Strip trailing `! important` from raw tokens
    let mut cut = value_raw.length() - 1
    while cut >= 0 {
      match value_raw[cut] {
        Delim(33) => break
        _ => cut = cut - 1
      }
    }
    if cut <= 0 {
      return false
    }
    eff_raw = tok_slice(value_raw, 0, cut)
    if tok_filter_no_space(eff_raw).length() == 0 {
      return false
    }
  }
  if str_has_prefix(name, "--") {
    return custom_prop_value_valid(eff_raw)
  }
  let n = ascii_lower(name)
  if !is_known_css_prop(n) {
    return false
  }
  let canon = alias_of(n)
  valid_decl(canon, eff_raw) && (canon != "font" || font_shorthand_valid(eff_raw, words(eff_raw)))
}

fn skip_spaces_at(v : Array[Tok], idx : Int) -> Int {
  let mut i = idx
  while i < v.length() && tok_eq(v[i], Space) {
    i = i + 1
  }
  i
}

fn has_top_level_comma(toks : Array[Tok]) -> Bool {
  let mut depth = 0
  let mut i = 0
  while i < toks.length() {
    match toks[i] {
      OpenParen | Function(_) | OpenSquare | OpenCurly => depth = depth + 1
      CloseParen | CloseSquare | CloseCurly => if depth > 0 { depth = depth - 1 }
      Comma => if depth == 0 { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn supports_term(v : Array[Tok], start0 : Int) -> SupportsTerm {
  let start = skip_spaces_at(v, start0)
  if start >= v.length() {
    return SupportsTerm::{ ok: false, valid: false, next: start + 1 }
  }
  match v[start] {
    OpenParen => {
      let e = group_end(v, start + 1)
      if e >= v.length() {
        return SupportsTerm::{ ok: false, valid: false, next: e + 1 }
      }
      let inner = trim(tok_slice(v, start + 1, e))
      if inner.length() == 0 {
        return SupportsTerm::{ ok: false, valid: false, next: e + 1 }
      }
      let i1 = skip_spaces_at(inner, 1)
      let r = if i1 < inner.length() && tok_eq(inner[i1], Colon) {
        match inner[0] {
          Ident(name) => supports_decl_toks(name, tok_slice(inner, i1 + 1, inner.length()), allow_important=true)
          _ => supports_matches(inner)
        }
      } else {
        supports_matches(inner)
      }
      SupportsTerm::{ ok: r, valid: true, next: e + 1 }
    }
    Function(fname) => {
      let e = group_end(v, start + 1)
      if e >= v.length() {
        return SupportsTerm::{ ok: false, valid: false, next: e + 1 }
      }
      let lfn = ascii_lower(fname)
      let ok = if lfn == "selector" {
        let inner = trim(tok_slice(v, start + 1, e))
        inner.length() > 0 && !has_top_level_comma(inner) && strictly_valid(inner)
      } else if lfn == "at-rule" {
        let inner = tok_filter_no_space(tok_slice(v, start + 1, e))
        if inner.length() == 1 {
          match inner[0] {
            AtKeyword(rule) => {
              let lr = ascii_lower(rule)
              lr == "supports" || lr == "media" || lr == "import" || lr == "layer" ||
              lr == "container" || lr == "scope" || lr == "font-face" || lr == "keyframes" ||
              lr == "property" || lr == "page" || lr == "starting-style" ||
              lr == "counter-style" || lr == "font-feature-values" || lr == "swash"
            }
            _ => false
          }
        } else {
          false
        }
      } else if lfn == "font-tech" {
        let inner = tok_filter_no_space(tok_slice(v, start + 1, e))
        if inner.length() == 1 {
          match inner[0] {
            Ident(tech) => {
              let lt = ascii_lower(tech)
              lt == "color-colrv1" || lt == "color-colrv0" || lt == "color-svg" ||
              lt == "color-sbix" || lt == "color-cbdt" || lt == "variations" ||
              lt == "features-opentype" || lt == "palettes" || lt == "incremental"
            }
            _ => false
          }
        } else {
          false
        }
      } else {
        false
      }
      SupportsTerm::{ ok: ok, valid: true, next: e + 1 }
    }
    _ => SupportsTerm::{ ok: false, valid: false, next: start + 1 }
  }
}

fn supports_matches(t : Array[Tok]) -> Bool {
  let v = trim(tok_filter_no_end(t))
  if v.length() == 0 {
    return false
  }
  match v[0] {
    Ident(w) => {
      if ascii_lower(w) == "not" {
        let t_start = skip_spaces_at(v, 1)
        if t_start >= v.length() {
          return false
        }
        let term = supports_term(v, t_start)
        let after = skip_spaces_at(v, term.next)
        return term.valid && after == v.length() && !term.ok
      }
      return false
    }
    _ => ()
  }
  let first = supports_term(v, 0)
  if !first.valid {
    return false
  }
  let mut result = first.ok
  let mut i = skip_spaces_at(v, first.next)
  let mut combinator = ""
  while i < v.length() {
    let op = match v[i] { Ident(w) => ascii_lower(w) _ => "" }
    if op != "and" && op != "or" {
      return false
    }
    if combinator != "" && combinator != op {
      return false
    }
    combinator = op
    let r = supports_term(v, i + 1)
    if !r.valid {
      return false
    }
    if op == "and" {
      result = result && r.ok
    } else {
      result = result || r.ok
    }
    i = skip_spaces_at(v, r.next)
  }
  result
}

pub fn supports_decl_matches(prop : String, raw_val : String) -> Bool {
  // CSS Conditional Rules 3: property name must be a single <ident-token> with no leading/trailing whitespace
  let p_toks = tok_filter_no_end(tokenize(prop))
  if p_toks.length() != 1 {
    return false
  }
  let pname = match p_toks[0] {
    Ident(s) => s
    _ => return false
  }
  let v_raw = tok_filter_no_end(tokenize(raw_val))
  supports_decl_toks(pname, v_raw)
}

pub fn supports_query_matches(q : String) -> Bool {
  let v = trim(tok_filter_no_end(tokenize(q)))
  if v.length() == 0 {
    return false
  }
  let i1 = skip_spaces_at(v, 1)
  if i1 < v.length() && tok_eq(v[i1], Colon) {
    match v[0] {
      Ident(name) => return supports_decl_toks(name, tok_slice(v, i1 + 1, v.length()), allow_important=true)
      _ => ()
    }
  }
  supports_matches(v)
}

// ----- FontFace -----

pub struct FontFace {
  pub family : String
  pub src : Array[String]
  pub weight_lo : Int
  pub weight_hi : Int
  pub italic : Bool
  pub size_adjust : Double
  pub ranges : Array[(Int, Int)]
}

pub fn FontFace::covers(self : FontFace, c : Int) -> Bool {
  if self.ranges.length() == 0 {
    return true
  }
  let mut i = 0
  while i < self.ranges.length() {
    let r = self.ranges[i]
    if c >= r.0 && c <= r.1 {
      return true
    }
    i = i + 1
  }
  false
}

fn hex_with_wild(x : String, q : Int) -> Int {
  let mut v = 0
  let mut i = 0
  while i < x.length() {
    let ch = x.code_unit_at(i)
    let d = if is_digit(ch) {
      ch - 48
    } else if ch >= 97 && ch <= 102 {
      ch - 87
    } else if ch >= 65 && ch <= 70 {
      ch - 55
    } else {
      q
    }
    v = v * 16 + d
    i = i + 1
  }
  v
}

fn unicode_range_of(t : String) -> Option[(Int, Int)] {
  if !(str_has_prefix(t, "u+") || str_has_prefix(t, "U+")) {
    return None
  }
  let body = str_slice(t, 2, t.length())
  match str_find(body, "-") {
    Some(k) => Some((hex_with_wild(str_slice(body, 0, k), 0), hex_with_wild(str_slice(body, k + 1, body.length()), 0)))
    None => Some((hex_with_wild(body, 0), hex_with_wild(body, 15)))
  }
}

fn weight_value(t : Tok) -> Option[Int] {
  match t {
    Number(n) => Some(fvdmath::d2i(n))
    Ident(w) => {
      let lw = ascii_lower(w)
      if lw == "normal" { Some(400) } else if lw == "bold" { Some(700) } else { None }
    }
    _ => None
  }
}

fn font_face_of(decls : Array[Decl], resolve : (String) -> String) -> Option[FontFace] {
  let mut family = ""
  let src : Array[String] = []
  let mut lo = 400
  let mut hi = 400
  let mut italic = false
  let mut size_adjust = 1.0
  let ranges : Array[(Int, Int)] = []
  let mut di = 0
  while di < decls.length() {
    let d = decls[di]
    if d.name == "size-adjust" {
      if d.value.length() > 0 {
        match d.value[0] {
          Percentage(p) => if p > 0.0 { size_adjust = p / 100.0 }
          _ => ()
        }
      }
    } else if d.name == "unicode-range" {
      let mut j = 0
      while j < d.value.length() {
        match d.value[j] {
          Ident(w) => {
            match unicode_range_of(w) {
              Some(r) => ranges.push(r)
              None => ()
            }
          }
          _ => ()
        }
        j = j + 1
      }
    } else if d.name == "font-family" {
      let mut j = 0
      while j < d.value.length() {
        match d.value[j] {
          Ident(w) => family = if family == "" { w } else { family + " " + w }
          Str(w) => family = if family == "" { w } else { family + " " + w }
          _ => ()
        }
        j = j + 1
      }
    } else if d.name == "src" {
      let mut url = ""
      let mut fmt_ok = true
      let mut i = 0
      let v = d.value
      while i < v.length() {
        match v[i] {
          Url(u) => url = u
          Function(f) => {
            let lf = ascii_lower(f)
            let mut j = i + 1
            let mut arg = ""
            while j < v.length() && !tok_eq(v[j], CloseParen) {
              match v[j] {
                Str(a) => if arg == "" { arg = a }
                Ident(a) => if arg == "" { arg = a }
                _ => ()
              }
              j = j + 1
            }
            if lf == "url" {
              url = arg
            } else if lf == "format" {
              let fa = ascii_lower(arg)
              fmt_ok = str_has_prefix(fa, "woff") || fa == "truetype" || fa == "opentype"
            }
            i = j
          }
          Comma => {
            if url != "" && fmt_ok {
              let lu = ascii_lower(url)
              if !lu.ends_with(".eot") && !lu.contains(".eot?") && !lu.contains(".eot#") {
                src.push(resolve(url))
              }
            }
            url = ""
            fmt_ok = true
          }
          _ => ()
        }
        i = i + 1
      }
      if url != "" && fmt_ok {
        let lu = ascii_lower(url)
        if !lu.ends_with(".eot") && !lu.contains(".eot?") && !lu.contains(".eot#") {
          src.push(resolve(url))
        }
      }
    } else if d.name == "font-weight" {
      let ws : Array[Int] = []
      let mut j = 0
      while j < d.value.length() {
        match weight_value(d.value[j]) {
          Some(w) => ws.push(w)
          None => ()
        }
        j = j + 1
      }
      if ws.length() > 0 {
        lo = ws[0]
        hi = if ws.length() > 1 { ws[1] } else { ws[0] }
      }
    } else if d.name == "font-style" {
      let mut j = 0
      while j < d.value.length() {
        match d.value[j] {
          Ident(w) => {
            let lw = ascii_lower(w)
            if lw == "italic" || lw == "oblique" { italic = true }
          }
          _ => ()
        }
        j = j + 1
      }
    }
    di = di + 1
  }
  if family == "" || src.length() == 0 {
    None
  } else {
    Some(FontFace::{
      family: ascii_lower(family),
      src: src,
      weight_lo: lo,
      weight_hi: hi,
      italic: italic,
      size_adjust: size_adjust,
      ranges: ranges,
    })
  }
}

// ----- @property & var() & attr() -----

struct RegProp {
  inherits : Bool
  initial : Option[Array[Tok]]
}

fn property_rule(decls : Array[Decl]) -> Option[RegProp] {
  let mut syntax : Option[String] = None
  let mut inherits : Option[Bool] = None
  let mut initial : Option[Array[Tok]] = None
  let mut i = 0
  while i < decls.length() {
    let d = decls[i]
    let tv = trim(d.value)
    if d.name == "syntax" && tv.length() == 1 {
      match tv[0] { Str(x) => syntax = Some(trim_str(x)) _ => () }
    } else if d.name == "inherits" && tv.length() == 1 {
      match tv[0] {
        Ident(w) => {
          let lw = ascii_lower(w)
          if lw == "true" { inherits = Some(true) }
          else if lw == "false" { inherits = Some(false) }
        }
        _ => ()
      }
    } else if d.name == "initial-value" {
      initial = Some(tv)
    }
    i = i + 1
  }
  let syn = match syntax { Some(s) => s None => return None }
  let inh = match inherits { Some(b) => b None => return None }
  if syn == "*" {
    let init_ok = match initial { Some(v) => if v.length() > 0 { Some(v) } else { None } None => None }
    Some(RegProp::{ inherits: inh, initial: init_ok })
  } else {
    match initial {
      Some(v) => if v.length() > 0 { Some(RegProp::{ inherits: inh, initial: Some(v) }) } else { None }
      None => None
    }
  }
}

fn syntax_component(c : String, v : Array[Tok]) -> Bool {
  let is_m = v.length() > 0 && match v[0] {
    Function(f) => {
      let lf = ascii_lower(f)
      lf == "calc" || lf == "min" || lf == "max" || lf == "clamp" || lf == "round" || lf == "mod" || lf == "rem" || lf == "abs" || lf == "sign"
    }
    _ => false
  }
  let is_dim_in = fn(units : Array[String]) -> Bool {
    if v.length() == 1 {
      match v[0] { Dimension(_, u) => str_arr_contains(units, ascii_lower(u)) _ => is_m }
    } else {
      is_m
    }
  }
  let is_zero = v.length() == 1 && match v[0] { Number(n) => n == 0.0 _ => false }
  let is_pct = v.length() == 1 && match v[0] { Percentage(_) => true _ => false }
  if c == "<length>" { return is_dim_in(length_units()) || is_zero }
  if c == "<percentage>" { return is_pct || is_m }
  if c == "<length-percentage>" { return is_dim_in(length_units()) || is_zero || is_pct }
  if c == "<number>" {
    return (v.length() == 1 && match v[0] { Number(_) => true _ => false }) || is_m
  }
  if c == "<integer>" {
    if v.length() == 1 {
      match v[0] { Number(x) => return x == fvdmath::floor(x) _ => () }
    }
    return is_m
  }
  if c == "<angle>" { return is_dim_in(["deg", "rad", "grad", "turn"]) || is_zero }
  if c == "<time>" { return is_dim_in(["s", "ms"]) }
  if c == "<resolution>" { return is_dim_in(["dpi", "dpcm", "dppx", "x"]) }
  if c == "<color>" { return parse_color(v, 0).is_some() }
  if c == "<string>" { return v.length() == 1 && match v[0] { Str(_) => true _ => false } }
  if c == "<url>" {
    return (v.length() == 1 && match v[0] { Url(_) => true _ => false }) ||
    (v.length() > 0 && match v[0] { Function(f) => ascii_lower(f) == "url" _ => false })
  }
  if c == "<custom-ident>" {
    if v.length() == 1 {
      match v[0] {
        Ident(w) => {
          let lw = ascii_lower(w)
          return !(is_global_keyword(lw) || lw == "default")
        }
        _ => return false
      }
    }
    return false
  }
  if c == "<image>" {
    return v.length() > 0 && match v[0] {
      Url(_) => true
      Function(f) => { let lf = ascii_lower(f); str_has_suffix(lf, "gradient") || lf == "url" }
      _ => false
    }
  }
  if c == "<transform-function>" {
    return v.length() > 0 && match v[0] { Function(_) => group_end(v, 1) == v.length() - 1 _ => false }
  }
  if v.length() == 1 {
    match v[0] { Ident(w) => return !str_has_prefix(c, "<") && w == c _ => () }
  }
  false
}

fn syntax_matches(syntax0 : String, v0 : Array[Tok]) -> Bool {
  let v = trim(v0)
  let syntax = trim_str(syntax0)
  if syntax == "*" { return true }
  if v.length() == 0 { return false }
  let alts = str_split_char(syntax, 124)
  let mut ai = 0
  while ai < alts.length() {
    let a = trim_str(alts[ai])
    if str_has_suffix(a, "+") {
      let c = str_slice(a, 0, a.length() - 1)
      let parts = words(v)
      let mut all_ok = true
      let mut pi = 0
      while pi < parts.length() {
        if !syntax_component(c, parts[pi]) { all_ok = false; break }
        pi = pi + 1
      }
      if all_ok { return true }
    } else if str_has_suffix(a, "#") {
      let c = str_slice(a, 0, a.length() - 1)
      let parts = split_commas(v)
      let mut all_ok = true
      let mut pi = 0
      while pi < parts.length() {
        if !syntax_component(c, trim(parts[pi])) { all_ok = false; break }
        pi = pi + 1
      }
      if all_ok { return true }
    } else if syntax_component(a, v) {
      return true
    }
    ai = ai + 1
  }
  false
}

fn has_attr_fn(v : Array[Tok]) -> Bool {
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Function(f) => if ascii_lower(f) == "attr" { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn is_var_fn(f : String) -> Bool {
  if f.length() != 3 { return false }
  let c0 = f.code_unit_at(0)
  let c1 = f.code_unit_at(1)
  let c2 = f.code_unit_at(2)
  (c0 == 118 || c0 == 86) && (c1 == 97 || c1 == 65) && (c2 == 114 || c2 == 82)
}

fn is_env_fn(f : String) -> Bool {
  let n = f.length()
  if n == 3 {
    let c0 = f.code_unit_at(0)
    let c1 = f.code_unit_at(1)
    let c2 = f.code_unit_at(2)
    return (c0 == 101 || c0 == 69) && (c1 == 110 || c1 == 78) && (c2 == 118 || c2 == 86)
  }
  if n == 8 {
    return ascii_lower(f) == "constant"
  }
  false
}

fn env_value(name : String) -> Option[Array[Tok]] {
  match name {
    "safe-area-inset-top" | "safe-area-inset-right" | "safe-area-inset-bottom" | "safe-area-inset-left" |
    "titlebar-area-x" | "titlebar-area-y" | "titlebar-area-width" | "titlebar-area-height" |
    "keyboard-inset-top" | "keyboard-inset-right" | "keyboard-inset-bottom" | "keyboard-inset-left" |
    "keyboard-inset-width" | "keyboard-inset-height" => Some([Dimension(0.0, "px")])
    _ => None
  }
}

let empty_var_own : Map[String, Array[Tok]] = Map::new()
let empty_var_path : Array[String] = []

fn find_top_comma(v : Array[Tok], lo : Int, hi : Int) -> Int {
  let mut depth = 0
  let mut i = lo
  while i < hi {
    match v[i] {
      Function(_) | OpenParen | OpenSquare | OpenCurly => depth = depth + 1
      CloseParen | CloseSquare | CloseCurly => if depth > 0 { depth = depth - 1 }
      Comma => if depth == 0 { return i }
      _ => ()
    }
    i = i + 1
  }
  -1
}

fn first_non_space_ident(v : Array[Tok], lo : Int, hi : Int) -> String {
  let mut i = lo
  while i < hi && v[i] is Space {
    i = i + 1
  }
  if i < hi {
    match v[i] {
      Ident(nm) => nm
      _ => ""
    }
  } else {
    ""
  }
}

fn trim_tok_range(v : Array[Tok], lo0 : Int, hi0 : Int) -> Array[Tok] {
  let mut lo = lo0
  let mut hi = hi0
  while lo < hi && v[lo] is Space { lo = lo + 1 }
  while hi > lo && v[hi - 1] is Space { hi = hi - 1 }
  if lo >= hi { empty_toks } else { tok_slice(v, lo, hi) }
}

fn has_var(v : Array[Tok]) -> Bool {
  let mut i = 0
  let n = v.length()
  while i < n {
    match v[i] {
      Function(f) => if is_var_fn(f) || is_env_fn(f) { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn subst_attr(v : Array[Tok], n : html::Node, within : Array[String]) -> Option[Array[Tok]] {
  if !has_attr_fn(v) {
    return Some(v)
  }
  let out : Array[Tok] = []
  let mut i = 0
  while i < v.length() {
    match v[i] {
      Function(f) => {
        if ascii_lower(f) == "attr" {
          let e = group_end(v, i + 1)
          let inner = tok_slice(v, i + 1, e)
          let mut head = trim(inner)
          let mut fallback : Option[Array[Tok]] = None
          match tok_search_comma(inner) {
            Some(k) => {
              head = trim(tok_slice(inner, 0, k))
              fallback = Some(trim(tok_slice(inner, k + 1, inner.length())))
            }
            None => ()
          }
          if head.length() == 0 { return None }
          let name = match head[0] { Ident(x) => x _ => return None }
          if str_arr_contains(within, name) { return None }
          let rest = trim(tok_slice(head, 1, head.length()))
          let value = n.attr(name)
          let fb = match fallback {
            Some(fb_toks) => match subst_attr(fb_toks, n, within) {
              Some(x) => Some(x)
              None => return None
            }
            None => None
          }
          let inside : Array[String] = []
          let mut wi = 0
          while wi < within.length() { inside.push(within[wi]); wi = wi + 1 }
          inside.push(name)
          let got : Option[Array[Tok]] = if rest.length() == 0 || (rest.length() == 1 && match rest[0] { Ident(w) => w == "raw-string" _ => false }) {
            match value {
              Some(a) => Some([Str(a)])
              None => Some(match fb { Some(x) => x None => [Str("")] })
            }
          } else if rest.length() > 0 && match rest[0] { Function(tf) => ascii_lower(tf) == "type" _ => false } {
            let close = group_end(rest, 1)
            let sb = StringBuilder::new()
            let mut j = 1
            while j < close {
              match rest[j] {
                Delim(c) => write_utf8_cp(sb, c)
                Ident(w) => sb.write_string(w)
                Space => sb.write_char((32).unsafe_to_char())
                _ => ()
              }
              j = j + 1
            }
            let syn = sb.to_string()
            match value {
              Some(a) => {
                let t = trim(tokenize(a))
                match subst_attr(t, n, inside) {
                  Some(x) => if syntax_matches(syn, x) { Some(x) } else { fb }
                  None => return None
                }
              }
              None => fb
            }
          } else if rest.length() == 1 && (match rest[0] { Ident(_) => true Delim(c) => c == 37 _ => false }) {
            let unit = match rest[0] { Ident(u) => ascii_lower(u) _ => "%" }
            match value {
              Some(a) => {
                let t = trim(tokenize(a))
                if t.length() == 1 {
                  match t[0] {
                    Number(x) => {
                      if unit == "%" { Some([Percentage(x)]) }
                      else if unit == "number" { Some([Number(x)]) }
                      else { Some([Dimension(x, unit)]) }
                    }
                    _ => fb
                  }
                } else {
                  fb
                }
              }
              None => fb
            }
          } else {
            return None
          }
          match got {
            Some(x) => tok_append(out, x)
            None => return None
          }
          i = e + 1
          continue
        }
        out.push(v[i])
        i = i + 1
      }
      t => {
        out.push(t)
        i = i + 1
      }
    }
  }
  Some(out)
}

fn subst(v : Array[Tok], vars : VarMap, depth : Int) -> Option[Array[Tok]] {
  if depth > 32 {
    return None
  }
  let sn = v.length()
  if sn > 0 {
    match v[0] {
      Function(f) if is_var_fn(f) => {
        let e = group_end(v, 1)
        if e + 1 == sn {
          let name = first_non_space_ident(v, 1, e)
          match vars.get(name) {
            Some(x) => return subst(x, vars, depth + 1)
            None => {
              let k = find_top_comma(v, 1, e)
              if k >= 0 {
                return subst(trim_tok_range(v, k + 1, e), vars, depth + 1)
              }
              return None
            }
          }
        }
      }
      _ => ()
    }
  }
  if !has_var(v) {
    return Some(v)
  }
  let out : Array[Tok] = []
  let mut i = 0
  while i < sn {
    match v[i] {
      Function(f) => {
        if is_var_fn(f) {
          let e = group_end(v, i + 1)
          let name = first_non_space_ident(v, i + 1, e)
          match vars.get(name) {
            Some(x) => {
              match subst(x, vars, depth + 1) {
                Some(y) => tok_append(out, y)
                None => return None
              }
            }
            None => {
              let k = find_top_comma(v, i + 1, e)
              if k >= 0 {
                match subst(trim_tok_range(v, k + 1, e), vars, depth + 1) {
                  Some(y) => tok_append(out, y)
                  None => return None
                }
              } else {
                return None
              }
            }
          }
          i = e + 1
          continue
        }
        if is_env_fn(f) {
          let e = group_end(v, i + 1)
          let name = first_non_space_ident(v, i + 1, e)
          match env_value(name) {
            Some(x) => tok_append(out, x)
            None => {
              let k = find_top_comma(v, i + 1, e)
              if k >= 0 {
                match subst(trim_tok_range(v, k + 1, e), vars, depth + 1) {
                  Some(y) => tok_append(out, y)
                  None => return None
                }
              } else {
                return None
              }
            }
          }
          i = e + 1
          continue
        }
        out.push(v[i])
        i = i + 1
      }
      t => {
        out.push(t)
        i = i + 1
      }
    }
  }
  Some(out)
}

fn resolve_var(
  name : String,
  own : Map[String, Array[Tok]],
  inherited_vars : VarMap,
  path : Array[String],
) -> Option[Array[Tok]] {
  if str_arr_contains(path, name) {
    return None
  }
  let next : Array[String] = []
  let mut i = 0
  while i < path.length() { next.push(path[i]); i = i + 1 }
  next.push(name)
  match own.get(name) {
    Some(v) => resolve_var_tokens(v, own, inherited_vars, next)
    None => None
  }
}

pub fn Style::resolve_tokens(self : Style, toks : Array[Tok]) -> Array[Tok] {
  if !has_var(toks) {
    return toks
  }
  match resolve_var_tokens(toks, empty_var_own, self.vars, empty_var_path) {
    Some(resolved) => resolved
    None => toks
  }
}

fn lookup_var_value(
  ref_name : String,
  own : Map[String, Array[Tok]],
  inherited_vars : VarMap,
  next : Array[String],
) -> Option[Array[Tok]] {
  if own.contains(ref_name) {
    match resolve_var(ref_name, own, inherited_vars, next) {
      Some(x) => {
        let tx = trim(x)
        if tx.length() == 1 {
          match tx[0] {
            Ident(w) => {
              let lw = ascii_lower(w)
              if lw == "initial" {
                None
              } else if lw == "inherit" || lw == "unset" || lw == "revert" || lw == "revert-layer" {
                inherited_vars.get(ref_name)
              } else {
                Some(x)
              }
            }
            _ => Some(x)
          }
        } else {
          Some(x)
        }
      }
      None => None
    }
  } else {
    inherited_vars.get(ref_name)
  }
}

fn resolve_var_tokens(
  v : Array[Tok],
  own : Map[String, Array[Tok]],
  inherited_vars : VarMap,
  next : Array[String],
) -> Option[Array[Tok]] {
  let sn = v.length()
  if sn > 0 {
    match v[0] {
      Function(f) if is_var_fn(f) => {
        let e = group_end(v, 1)
        if e + 1 == sn {
          let ref_name = first_non_space_ident(v, 1, e)
          if str_arr_contains(next, ref_name) {
            return None
          }
          match lookup_var_value(ref_name, own, inherited_vars, next) {
            Some(x) => return Some(x)
            None => {
              let k = find_top_comma(v, 1, e)
              if k >= 0 {
                return resolve_var_tokens(trim_tok_range(v, k + 1, e), own, inherited_vars, next)
              }
              return None
            }
          }
        }
      }
      _ => ()
    }
  }
  if !has_var(v) {
    return Some(v)
  }
  let out : Array[Tok] = []
  let mut i = 0
  while i < sn {
    match v[i] {
      Function(f) => {
        if is_var_fn(f) {
          let e = group_end(v, i + 1)
          let ref_name = first_non_space_ident(v, i + 1, e)
          if str_arr_contains(next, ref_name) {
            return None
          }
          match lookup_var_value(ref_name, own, inherited_vars, next) {
            Some(x) => tok_append(out, x)
            None => {
              let k = find_top_comma(v, i + 1, e)
              if k >= 0 {
                match resolve_var_tokens(trim_tok_range(v, k + 1, e), own, inherited_vars, next) {
                  Some(x) => tok_append(out, x)
                  None => return None
                }
              } else {
                return None
              }
            }
          }
          i = e + 1
          continue
        }
        if is_env_fn(f) {
          let e = group_end(v, i + 1)
          let name = first_non_space_ident(v, i + 1, e)
          match env_value(name) {
            Some(x) => tok_append(out, x)
            None => {
              let k = find_top_comma(v, i + 1, e)
              if k >= 0 {
                match resolve_var_tokens(trim_tok_range(v, k + 1, e), own, inherited_vars, next) {
                  Some(y) => tok_append(out, y)
                  None => return None
                }
              } else {
                return None
              }
            }
          }
          i = e + 1
          continue
        }
        out.push(v[i])
        i = i + 1
      }
      t => {
        out.push(t)
        i = i + 1
      }
    }
  }
  Some(out)
}
