///| Media Queries 4, @supports, @font-face, @property, var() & attr() substitution.
///| 1:1 port of the media/supports/font-face/var sections of `client/src/css/cascade.mbt`.

pub struct Env {
  pub width : Double
  pub height : Double
  pub media : String
  ///| the device pixels a CSS pixel for `resolution` queries: the preferences' when made (`set_media_prefs`), so an
  ///| engine keeps the ratio it was made or resized with, and two documents in one process (a split view's panes at
  ///| different zooms) each answer with their own whenever they restyle
  pub dpr : Double
}

pub fn Env::new(width : Double, height : Double) -> Env {
  Env::{ width: width, height: height, media: "screen", dpr: media_dpr() }
}

pub fn Env::with_media(width : Double, height : Double, media : String) -> Env {
  Env::{ width: width, height: height, media: media, dpr: media_dpr() }
}

///| The person's display preferences media queries read beyond the viewport's size: whether pages are shown dark
///| (`prefers-color-scheme`, `color-scheme: light dark`, `light-dark()`) and the device pixels per CSS pixel
///| (`resolution`, `-webkit-device-pixel-ratio`). One per process: the client sets them before it lays a tab out, the
///| host when the client says them (`ClientMsg::MediaPrefs`). An `Engine` built under other ones is built again where a
///| query it asked now says otherwise (`Engine::resize`).
struct MediaPrefs {
  mut dark : Bool
  mut dpr : Double
}

let media_prefs : MediaPrefs = MediaPrefs::{ dark: false, dpr: 1.0 }

///| Set the preferences media queries read; whether they changed.
pub fn set_media_prefs(dark : Bool, dpr : Double) -> Bool {
  let d = if dpr > 0.0 { dpr } else { 1.0 }
  if media_prefs.dark == dark && media_prefs.dpr == d {
    return false
  }
  media_prefs.dark = dark
  media_prefs.dpr = d
  true
}

pub fn media_prefers_dark() -> Bool {
  media_prefs.dark
}

pub fn media_dpr() -> Double {
  media_prefs.dpr
}

///| A `<resolution>` token in dppx (`2dppx`, `2x`, `192dpi`, `75.6dpcm`), or a bare number (the
///| `-webkit-device-pixel-ratio` form).
fn resolution_dppx(t : Tok) -> Option[Double] {
  match t {
    Number(n) => Some(n)
    Dimension(n, u) => {
      let lu = ascii_lower(u)
      if lu == "dppx" || lu == "x" { Some(n) }
      else if lu == "dpi" { Some(n / 96.0) }
      else if lu == "dpcm" { Some(n * 2.54 / 96.0) }
      else { None }
    }
    _ => None
  }
}

pub fn media_query_matches(env : Env, q : String) -> Bool {
  media_matches(env, tokenize(q))
}

pub fn source_size(env : Env, sizes : String) -> Option[Double] {
  let parts = split_commas(tokenize(sizes))
  let mut pi = 0
  while pi < parts.length() {
    let t = trim(parts[pi])
    if t.length() == 0 {
      pi = pi + 1
      continue
    }
    let mut start = t.length() - 1
    if tok_eq(t[start], CloseParen) {
      let mut depth = 0
      let mut k = start
      while k >= 0 {
        match t[k] {
          CloseParen => depth = depth + 1
          OpenParen => {
            depth = depth - 1
            if depth == 0 { break }
          }
          Function(_) => {
            depth = depth - 1
            if depth == 0 { break }
          }
          _ => ()
        }
        k = k - 1
      }
      if k < 0 || tok_eq(t[k], OpenParen) {
        pi = pi + 1
        continue
      }
      start = k
    }
    let bad_num = match t[start] { Number(n) => n != 0.0 _ => false }
    if !bad_num {
      match eval_length(tok_slice(t, start, t.length()), 16.0, 16.0, env) {
        Some(l) => {
          if l.pct == 0.0 && l.px >= 0.0 {
            let cond = trim(tok_slice(t, 0, start))
            if cond.length() == 0 || query_matches(env, cond) {
              return Some(l.px)
            }
          }
        }
        None => ()
      }
    }
    pi = pi + 1
  }
  None
}

fn media_matches(env : Env, t : Array[Tok]) -> Bool {
  if t.length() == 0 {
    return true
  }
  let parts = split_commas(t)
  let mut i = 0
  while i < parts.length() {
    if query_matches(env, trim(parts[i])) {
      return true
    }
    i = i + 1
  }
  false
}

fn length_px(t : Tok) -> Option[Double] {
  match t {
    Dimension(n, u) => {
      let lu = ascii_lower(u)
      if lu == "px" { Some(n) }
      else if lu == "em" || lu == "rem" { Some(n * 16.0) }
      else if lu == "pt" { Some(n * 96.0 / 72.0) }
      else if lu == "in" { Some(n * 96.0) }
      else if lu == "cm" { Some(n * 96.0 / 2.54) }
      else if lu == "mm" { Some(n * 96.0 / 25.4) }
      else { None }
    }
    Number(n) => if n == 0.0 { Some(0.0) } else { None }
    _ => None
  }
}

fn media_feature_keywords(base : String) -> Option[Array[String]] {
  if base == "orientation" { Some(["portrait", "landscape"]) }
  else if base == "prefers-color-scheme" { Some(["light", "dark"]) }
  else if base == "prefers-reduced-motion" || base == "prefers-reduced-transparency" { Some(["no-preference", "reduce"]) }
  else if base == "prefers-contrast" { Some(["no-preference", "more", "less", "custom"]) }
  else if base == "forced-colors" { Some(["none", "active"]) }
  else if base == "inverted-colors" { Some(["none", "inverted"]) }
  else if base == "hover" || base == "any-hover" { Some(["none", "hover"]) }
  else if base == "pointer" || base == "any-pointer" { Some(["none", "coarse", "fine"]) }
  else if base == "display-mode" { Some(["browser", "fullscreen", "standalone", "minimal-ui", "picture-in-picture", "window-controls-overlay"]) }
  else if base == "scripting" { Some(["none", "initial-only", "enabled"]) }
  else if base == "update" { Some(["none", "slow", "fast"]) }
  else if base == "overflow-block" { Some(["none", "scroll", "paged"]) }
  else if base == "overflow-inline" { Some(["none", "scroll"]) }
  else if base == "color-gamut" { Some(["srgb", "p3", "rec2020"]) }
  else if base == "dynamic-range" || base == "video-dynamic-range" { Some(["standard", "high"]) }
  else if base == "width" || base == "height" || base == "device-width" || base == "device-height" ||
  base == "aspect-ratio" || base == "device-aspect-ratio" || base == "resolution" ||
  base == "color" || base == "color-index" || base == "monochrome" || base == "grid" ||
  base == "-webkit-device-pixel-ratio" || base == "-webkit-transform-3d" { Some([]) }
  else { None }
}

fn has_range_delim(vals : Array[Tok]) -> Bool {
  let mut i = 0
  while i < vals.length() {
    match vals[i] {
      Delim(c) => if c == 60 || c == 62 || c == 61 { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

fn features_known(t : Array[Tok]) -> Bool {
  let mut i = 0
  while i < t.length() {
    if tok_eq(t[i], OpenParen) {
      let e = group_end(t, i + 1)
      let inner = tok_slice(t, i + 1, e)
      let vals = tok_filter_no_space(inner)
      if vals.length() > 0 && tok_eq(vals[0], OpenParen) {
        if !features_known(inner) {
          return false
        }
      } else if vals.length() >= 2 && tok_eq(vals[1], OpenParen) && match vals[0] {
        Ident(raw) => ascii_lower(raw) == "not"
        _ => false
      } {
        // Media Queries Level 4 §3.2: `(not <media-in-parens>)`
        if !features_known(inner) {
          return false
        }
      } else if vals.length() > 0 {
        match vals[0] {
          Ident(raw) => {
            let name = ascii_lower(raw)
            if name != "not" && name != "and" && name != "or" {
              if has_range_delim(vals) && !tok_contains_colon(vals) {
                match media_feature_keywords(name) {
                  Some(kws) => if kws.length() > 0 { return false }
                  None => return false
                }
              } else {
                let base = if str_has_prefix(name, "min-") || str_has_prefix(name, "max-") {
                  str_slice(name, 4, name.length())
                } else if str_has_prefix(name, "-webkit-min-") || str_has_prefix(name, "-webkit-max-") {
                  "-webkit-" + str_slice(name, 12, name.length())
                } else {
                  name
                }
                let kws = match media_feature_keywords(base) {
                  Some(w) => w
                  None => return false
                }
                let ranged = base != name
                if ranged && kws.length() > 0 {
                  return false
                }
                if vals.length() == 1 {
                  if ranged { return false }
                } else {
                  if vals.length() < 3 || !tok_eq(vals[1], Colon) {
                    return false
                  }
                  let rest = tok_slice(vals, 2, vals.length())
                  if kws.length() > 0 {
                    if rest.length() != 1 { return false }
                    match rest[0] {
                      Ident(w) => if !str_arr_contains(kws, ascii_lower(w)) { return false }
                      _ => return false
                    }
                  } else {
                    let is_dim_base = base == "width" || base == "height" || base == "device-width" || base == "device-height"
                    let ok = if rest.length() == 1 {
                      match rest[0] {
                        Number(n) => !is_dim_base || n == 0.0
                        Dimension(_, u) => {
                          if base == "resolution" || base == "-webkit-device-pixel-ratio" {
                            let lu = ascii_lower(u)
                            lu == "dpi" || lu == "dpcm" || lu == "dppx" || lu == "x"
                          } else {
                            is_dim_base && length_px(rest[0]).is_some()
                          }
                        }
                        _ => false
                      }
                    } else if rest.length() == 3 && tok_eq(rest[1], Delim(47)) {
                      let n0 = match rest[0] { Number(_) => true _ => false }
                      let n2 = match rest[2] { Number(_) => true _ => false }
                      n0 && n2 && (base == "aspect-ratio" || base == "device-aspect-ratio")
                    } else if rest.length() > 0 {
                      match rest[0] {
                        Function(_) => is_dim_base
                        _ => false
                      }
                    } else {
                      false
                    }
                    if !ok { return false }
                  }
                }
              }
            }
          }
          _ => ()
        }
      }
      i = e
    }
    i = i + 1
  }
  true
}

fn query_matches(env : Env, t : Array[Tok]) -> Bool {
  if !features_known(t) {
    return false
  }
  let ws = tok_filter_no_space(t)
  if ws.length() >= 2 {
    match ws[0] {
      Ident(n) => {
        if ascii_lower(n) == "not" {
          match ws[1] {
            Ident(_) => return !query_matches(env, tok_slice(ws, 1, ws.length()))
            _ => ()
          }
        }
      }
      _ => ()
    }
  }
  let mut result = true
  let mut negate = false
  let mut i = 0
  while i < t.length() {
    match t[i] {
      Space => ()
      Ident(w) => {
        let lw = ascii_lower(w)
        if lw == "not" {
          negate = true
        } else if lw == "only" || lw == "and" {
          ()
        } else if lw == "all" {
          if negate {
            result = false
            negate = false
          }
        } else if lw == "screen" {
          let cur = if env.media == "" { "screen" } else { ascii_lower(env.media) }
          if (cur == "screen") == negate {
            result = false
          }
          negate = false
        } else if lw == "print" {
          let cur = if env.media == "" { "screen" } else { ascii_lower(env.media) }
          if (cur == "print") == negate {
            result = false
          }
          negate = false
        } else if lw == "or" {
          if result { return true } else { result = true }
        } else {
          if !negate {
            result = false
          }
          negate = false
        }
      }
      OpenParen => {
        let e = group_end(t, i + 1)
        let inner = trim(tok_slice(t, i + 1, e))
        let m = feature_matches(env, inner)
        if m == negate {
          result = false
        }
        negate = false
        i = e
      }
      _ => ()
    }
    i = i + 1
  }
  result
}

fn range_matches(env : Env, vals : Array[Tok]) -> Bool {
  let operands : Array[Option[Double]] = []
  let ops : Array[String] = []
  let mut i = 0
  while i < vals.length() {
    match vals[i] {
      Delim(c) => {
        let mut op = cp_to_str(c)
        if i + 1 < vals.length() && tok_eq(vals[i + 1], Delim(61)) && c != 61 {
          op = op + "="
          i = i + 1
        }
        ops.push(op)
      }
      Ident(w) => {
        let lw = ascii_lower(w)
        if lw == "width" { operands.push(Some(env.width)) }
        else if lw == "height" { operands.push(Some(env.height)) }
        else if lw == "aspect-ratio" { operands.push(Some(env.width / env.height)) }
        else if lw == "resolution" || lw == "-webkit-device-pixel-ratio" { operands.push(Some(env.dpr)) }
        else { operands.push(None) }
      }
      Function(_) => {
        let e = group_end(vals, i + 1)
        match eval_length(tok_slice(vals, i, e + 1), 16.0, 16.0, env) {
          Some(l) => operands.push(Some(l.px))
          None => operands.push(None)
        }
        i = e
      }
      Number(n) => {
        if i + 2 < vals.length() && tok_eq(vals[i + 1], Delim(47)) {
          match vals[i + 2] {
            Number(d) => operands.push(if d > 0.0 { Some(n / d) } else { None })
            _ => operands.push(None)
          }
          i = i + 2
        } else {
          operands.push(length_px(vals[i]))
        }
      }
      Dimension(_, u) if ascii_lower(u) == "dppx" || ascii_lower(u) == "x" || ascii_lower(u) == "dpi" || ascii_lower(u) == "dpcm" =>
      operands.push(resolution_dppx(vals[i]))
      t => operands.push(length_px(t))
    }
    i = i + 1
  }
  if operands.length() != ops.length() + 1 {
    return false
  }
  let mut k = 0
  while k < ops.length() {
    let a = match operands[k] { Some(v) => v None => return false }
    let b = match operands[k + 1] { Some(v) => v None => return false }
    let op = ops[k]
    let ok = if op == "<" { a < b }
    else if op == "<=" { a <= b }
    else if op == ">" { a > b }
    else if op == ">=" { a >= b }
    else if op == "=" { a == b }
    else { false }
    if !ok { return false }
    k = k + 1
  }
  true
}

fn feature_matches(env : Env, t : Array[Tok]) -> Bool {
  let vals = tok_filter_no_space(t)
  if vals.length() == 0 {
    return false
  }
  if tok_eq(vals[0], OpenParen) {
    return query_matches(env, t)
  }
  // Media Queries Level 4 §3.2: <media-in-parens> allows `(not <media-in-parens>)`.
  if vals.length() >= 2 && tok_eq(vals[1], OpenParen) {
    match vals[0] {
      Ident(raw) => if ascii_lower(raw) == "not" { return query_matches(env, t) }
      _ => ()
    }
  }
  if !tok_contains_colon(vals) && has_range_delim(vals) {
    return range_matches(env, vals)
  }
  let raw = match vals[0] { Ident(r) => r _ => return false }
  let name = ascii_lower(raw)
  if vals.length() >= 3 && tok_eq(vals[1], Colon) {
    let val_ = vals[2]
    let px = match val_ {
      Function(_) => match eval_length(tok_slice(vals, 2, vals.length()), 16.0, 16.0, env) {
        Some(l) => Some(l.px)
        None => None
      }
      _ => length_px(val_)
    }
    let word = match val_ { Ident(w) => ascii_lower(w) _ => "" }
    if name == "scripting" { return word == "enabled" }
    if name == "update" { return word == "fast" }
    if name == "overflow-block" || name == "overflow-inline" { return word == "scroll" }
    if name == "color-gamut" { return word == "srgb" }
    if name == "dynamic-range" || name == "video-dynamic-range" { return word == "standard" }
    if name == "grid" || name == "monochrome" || name == "min-monochrome" {
      return match val_ { Number(n) => n == 0.0 _ => false }
    }
    if name == "max-monochrome" { return true }
    if name == "color" || name == "min-color" {
      return match val_ { Number(n) => n <= 8.0 _ => false }
    }
    if name == "max-color" {
      return match val_ { Number(n) => n >= 8.0 _ => false }
    }
    if name == "min-width" { return match px { Some(v) => env.width >= v None => false } }
    if name == "max-width" { return match px { Some(v) => env.width <= v None => false } }
    if name == "width" { return match px { Some(v) => env.width == v None => false } }
    if name == "min-height" { return match px { Some(v) => env.height >= v None => false } }
    if name == "max-height" { return match px { Some(v) => env.height <= v None => false } }
    if name == "height" { return match px { Some(v) => env.height == v None => false } }
    if name == "orientation" { return (word == "landscape") == (env.width >= env.height) }
    if name == "prefers-color-scheme" { return word == (if media_prefs.dark { "dark" } else { "light" }) }
    if name == "prefers-reduced-motion" || name == "prefers-reduced-transparency" ||
    name == "prefers-contrast" || name == "forced-colors" || name == "inverted-colors" {
      return word == "no-preference" || word == "none"
    }
    if name == "hover" || name == "any-hover" { return word == (if env.width < 700.0 { "none" } else { "hover" }) }
    if name == "pointer" || name == "any-pointer" { return word == (if env.width < 700.0 { "coarse" } else { "fine" }) }
    if name == "display-mode" { return word == "browser" }
    if name == "min-resolution" || name == "-webkit-min-device-pixel-ratio" || name == "min-device-pixel-ratio" {
      return match resolution_dppx(val_) { Some(n) => n <= env.dpr None => false }
    }
    if name == "max-resolution" || name == "-webkit-max-device-pixel-ratio" || name == "max-device-pixel-ratio" {
      return match resolution_dppx(val_) { Some(n) => n >= env.dpr None => false }
    }
    if name == "resolution" || name == "-webkit-device-pixel-ratio" || name == "device-pixel-ratio" {
      return match resolution_dppx(val_) { Some(n) => n == env.dpr None => false }
    }
    return false
  }
  if name == "hover" || name == "any-hover" {
    return env.width >= 700.0
  }
  name == "pointer" || name == "any-pointer" || name == "color" || name == "width" || name == "height" ||
  name == "orientation" || name == "prefers-color-scheme" || name == "display-mode" || name == "scripting" ||
  name == "update" || name == "overflow-block" || name == "overflow-inline" || name == "color-gamut" ||
  name == "dynamic-range" || name == "video-dynamic-range" || name == "aspect-ratio" || name == "resolution" ||
  name == "device-width" || name == "device-height" || name == "device-aspect-ratio" || name == "-webkit-transform-3d"
}

struct SupportsTerm {
  ok : Bool
  valid : Bool
  next : Int
}

