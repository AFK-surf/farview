///| The user agent style sheet: the HTML standard's rendering section, as Chrome applies it.
///| 1:1 port of `client/src/css/ua.mbt`.

fn get_ua_css() -> String {
  "html, address, blockquote, body, center, dialog, div, figure, figcaption, footer, form, header, hr,\n" +
  "legend, listing, main, p, plaintext, pre, search, summary, xmp, article, aside, h1, h2, h3, h4, h5, h6,\n" +
  "hgroup, nav, section, dir, dd, dl, dt, menu, ol, ul, details, fieldset, optgroup, option { display: block; }\n" +
  "area, base, basefont, datalist, head, link, meta, noembed, noframes, param, rp, script, style, template, title { display: none; }\n" +
  "body { margin: 8px; }\n" +
  "p, blockquote, figure, listing, plaintext, pre, xmp, dl, multicol { margin-block: 1em; }\n" +
  "h1 { font-size: 2em; margin-block: 0.67em; font-weight: bold; }\n" +
  "h2 { font-size: 1.5em; margin-block: 0.83em; font-weight: bold; }\n" +
  "h3 { font-size: 1.17em; margin-block: 1em; font-weight: bold; }\n" +
  "h4 { margin-block: 1.33em; font-weight: bold; }\n" +
  "h5 { font-size: 0.83em; margin-block: 1.67em; font-weight: bold; }\n" +
  "h6 { font-size: 0.67em; margin-block: 2.33em; font-weight: bold; }\n" +
  "blockquote, figure { margin-inline: 40px; }\n" +
  "dd { margin-inline-start: 40px; }\n" +
  "dir, menu, ol, ul { margin-block: 1em; padding-inline-start: 40px; list-style-type: disc; }\n" +
  "ol { list-style-type: decimal; }\n" +
  "li { display: list-item; }\n" +
  "ol ol, ol ul, ul ol, ul ul, menu ol, menu ul, dir dl, dl dir, dl dl, dl menu, dl ol, dl ul, menu dl, ol dl, ul dl, dir dir, dir menu, dir ol, dir ul, menu dir, ol dir, ul dir, menu menu { margin-block: 0; }\n" +
  "ul ul { list-style-type: circle; }\n" +
  "ul ul ul { list-style-type: square; }\n" +
  "table { display: table; border-spacing: 2px; border-collapse: separate; box-sizing: border-box; text-indent: 0; }\n" +
  "caption { display: table-caption; text-align: center; }\n" +
  "colgroup { display: table-column-group; }\n" +
  "col { display: table-column; }\n" +
  "thead { display: table-header-group; vertical-align: middle; }\n" +
  "tbody { display: table-row-group; vertical-align: middle; }\n" +
  "tfoot { display: table-footer-group; vertical-align: middle; }\n" +
  "tr { display: table-row; vertical-align: inherit; }\n" +
  "td, th { display: table-cell; vertical-align: inherit; padding: 1px; }\n" +
  "th { font-weight: bold; text-align: center; }\n" +
  "pre, listing, plaintext, xmp, code, kbd, samp, tt { font-family: monospace; }\n" +
  "pre, listing, plaintext, xmp { white-space: pre; }\n" +
  "textarea { white-space: pre-wrap; }\n" +
  "b, strong { font-weight: bold; }\n" +
  "i, cite, em, var, dfn, address { font-style: italic; }\n" +
  "u, ins { text-decoration: underline; }\n" +
  "abbr[title] { text-decoration: underline dotted; }\n" +
  "s, strike, del { text-decoration: line-through; }\n" +
  "small { font-size: smaller; }\n" +
  "big { font-size: larger; }\n" +
  "sub { vertical-align: sub; font-size: smaller; }\n" +
  "sup { vertical-align: super; font-size: smaller; }\n" +
  "center { text-align: -webkit-center; }\n" +
  "a:link { color: #0000ee; text-decoration: underline; cursor: pointer; }\n" +
  "a:visited { color: #551a8b; }\n" +
  "hr { border: 1px inset; margin-block: 0.5em; margin-inline: auto; overflow: hidden; color: gray; }\n" +
  "img { display: inline-block; }\n" +
  "input, select, button, textarea { display: inline-block; color: black; font-size: 13.3333px; font-family: Arial; font-weight: normal; font-style: normal; line-height: normal; text-align: start; box-sizing: border-box; }\n" +
  "input, textarea { padding: 1px 2px; border: 2px inset rgb(118, 118, 118); background-color: white; }\n" +
  "button, input[type=submit], input[type=button], input[type=reset] { padding: 1px 6px; border: 2px outset rgb(118, 118, 118); background-color: #efefef; text-align: center; }\n" +
  "input[type=checkbox], input[type=radio] { padding: 0; border: 0; margin: 3px 3px 3px 4px; background-color: transparent; }\n" +
  "input[type=radio] { margin: 3px 3px 0 5px; }\n" +
  "input[type=range] { padding: 0; border: 0; margin: 2px; background-color: transparent; }\n" +
  "input[type=color] { padding: 1px 2px; border: 1px solid rgb(118, 118, 118); background-color: #efefef; }\n" +
  "input[type=file] { padding: 0; border: 0; background-color: transparent; }\n" +
  "progress, meter { display: inline-block; vertical-align: -0.2em; }\n" +
  "textarea { font-family: monospace; padding: 2px; border: 1px solid rgb(118, 118, 118); }\n" +
  "select { padding: 0; border: 1px solid rgb(118, 118, 118); background-color: white; }\n" +
  "[hidden]:not([hidden=until-found i]):not(embed), input[type=hidden] { display: none; }\n" +
  "[dir=rtl i] { direction: rtl; }\n" +
  "[dir=ltr i] { direction: ltr; }\n" +
  "[hidden=until-found i]:not(embed) { content-visibility: hidden; }\n" +
  "slot { display: contents; }\n" +
  "noscript { display: none !important; }\n" +
  "dialog:not([open]) { display: none; }\n" +
  "dialog { position: absolute; left: 0; right: 0; width: fit-content; height: fit-content; margin: auto; border: solid; padding: 1em; background-color: white; color: black; }\n" +
  "dialog:modal { position: fixed; overflow: auto; inset-block: 0; max-width: calc(100% - 6px - 2em); max-height: calc(100% - 6px - 2em); }\n" +
  "[popover]:not(:popover-open):not(dialog[open]) { display: none; }\n" +
  "[popover] { position: fixed; inset: 0; width: fit-content; height: fit-content; margin: auto; border: solid; padding: 0.25em; overflow: auto; color: black; background-color: white; }\n" +
  "dialog:popover-open { display: block; }\n" +
  "dialog:modal, :popover-open { z-index: 2147483647; }\n" +
  ":not(:root):fullscreen { position: fixed !important; inset: 0 !important; margin: 0 !important; box-sizing: border-box !important; min-width: 0 !important; max-width: none !important; min-height: 0 !important; max-height: none !important; width: 100% !important; height: 100% !important; transform: none !important; z-index: 2147483647 !important; object-fit: contain; background-color: black; }\n" +
  "iframe:fullscreen { border: none !important; padding: 0 !important; }\n" +
  "fieldset { margin-inline: 2px; padding-block: 0.35em 0.625em; padding-inline: 0.75em; border: 2px groove; }\n" +
  "details > summary { display: list-item; }\n" +
  "marquee { display: inline-block; }\n" +
  "ruby { display: ruby; }\n" +
  "rt { display: ruby-text; }\n" +
  "svg { display: inline-block; }\n" +
  "svg:not(:root) { overflow: hidden; }\n" +
  // (Chrome's focus ring: what has the focus shown by the keyboard, or a field typed in, ringed; -webkit-focus-ring-color
  // as it is drawn, #101010 with a white halo: `outline-style: auto`, display.pion)
  ":focus-visible { outline: auto 1px rgb(16, 16, 16); }\n" +
  "input:focus-visible, textarea:focus-visible, select:focus-visible { outline-offset: 0; }\n"
}

pub fn quirks_css() -> String {
  "table { white-space: normal; line-height: normal; font-weight: normal; font-size: medium; font-variant: normal; font-style: normal; text-align: start; }\n" +
  "li { list-style-position: inside; }\n"
}
