///| Property ID table and dense array storage (`Props`).
///| 1:1 port of `client/src/css/props.mbt`.

let prop_ids : Map[String, Int] = Map::new()
let prop_names : Array[String] = []

pub fn prop_id(name : String) -> Int {
  match prop_ids.get(name) {
    Some(i) => i
    None => {
      let i = prop_names.length()
      prop_names.push(name)
      prop_ids.set(name, i)
      i
    }
  }
}

fn prop_id_of(name : String) -> Option[Int] {
  prop_ids.get(name)
}

let empty_keys : Array[Int] = []
let empty_vals : Array[Array[Tok]] = []
let empty_slots : Array[Option[Array[Tok]]] = []
let empty_toks : Array[Tok] = []

pub struct Props {
  mut k0 : Int
  mut v0 : Array[Tok]
  mut k1 : Int
  mut v1 : Array[Tok]
  mut keys : Array[Int]
  mut vals : Array[Array[Tok]]
  mut slots : Array[Option[Array[Tok]]]
  mut count : Int
  // which properties it may hold, one bit each for ids 0..255 (above, an id shares the bit of id & 255): word
  // (id >> 6) & 3, bit id & 63
  mut mask0 : Int64
  mut mask1 : Int64
  mut mask2 : Int64
  mut mask3 : Int64
}

///| The word of a 256-bit property mask that holds property `id`'s bit (`mask_bit_in`): 0..3.
pub fn mask_word(id : Int) -> Int {
  (id >> 6) & 3
}

///| Property `id`'s bit in word `w` of a 256-bit property mask, 0 when its bit is in another word.
pub fn mask_bit_in(id : Int, w : Int) -> Int64 {
  if ((id >> 6) & 3) == w { 1L << (id & 63) } else { 0L }
}

fn make_none_slots(n : Int) -> Array[Option[Array[Tok]]] {
  Array::make(n, None)
}

pub fn Props::new() -> Props {
  Props::{
    k0: -1,
    v0: empty_toks,
    k1: -1,
    v1: empty_toks,
    keys: empty_keys,
    vals: empty_vals,
    slots: empty_slots,
    count: 0,
    mask0: 0L,
    mask1: 0L,
    mask2: 0L,
    mask3: 0L,
  }
}

pub fn Props::of(pairs : Array[(String, Array[Tok])]) -> Props {
  let p = Props::new()
  let mut i = 0
  while i < pairs.length() {
    p.set(pairs[i].0, pairs[i].1)
    i = i + 1
  }
  p
}

pub fn Props::get_id(self : Props, id : Int) -> Option[Array[Tok]] {
  if id < 0 {
    return None
  }
  let bit = 1L << (id & 63)
  let m = if (id & 128) == 0 { if (id & 64) == 0 { self.mask0 } else { self.mask1 } } else if (id & 64) == 0 { self.mask2 } else { self.mask3 }
  if (m & bit) == 0L {
    return None
  }
  if self.k0 >= 0 {
    if self.k0 == id {
      return Some(self.v0)
    }
    if self.k1 == id {
      return Some(self.v1)
    }
    return None
  }
  if self.slots.length() > 0 {
    if id < self.slots.length() {
      self.slots[id]
    } else {
      None
    }
  } else {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      if self.keys[i] == id {
        return Some(self.vals[i])
      }
      i = i + 1
    }
    None
  }
}

pub fn Props::get(self : Props, name : String) -> Option[Array[Tok]] {
  if self.count == 0 {
    return None
  }
  match prop_id_of(name) {
    Some(id) => self.get_id(id)
    None => None
  }
}

pub fn Props::contains(self : Props, name : String) -> Bool {
  self.get(name).is_some()
}

pub fn Props::contains_id(self : Props, id : Int) -> Bool {
  self.get_id(id).is_some()
}

///| Whether it may hold one of the properties of a 256-bit mask (`mask_bit_in`). (Its masks are all 0 when it holds
/// none: no test of `count`, so that the call is inlined where it is made, in layout and display.)
pub fn Props::has_any_mask(self : Props, m0 : Int64, m1 : Int64, m2 : Int64, m3 : Int64) -> Bool {
  ((self.mask0 & m0) | (self.mask1 & m1) | (self.mask2 & m2) | (self.mask3 & m3)) != 0L
}

pub fn Props::maybe_has_id(self : Props, id : Int) -> Bool {
  if id < 0 {
    return false
  }
  let bit = 1L << (id & 63)
  let m = if (id & 128) == 0 { if (id & 64) == 0 { self.mask0 } else { self.mask1 } } else if (id & 64) == 0 { self.mask2 } else { self.mask3 }
  (m & bit) != 0L
}

pub fn Props::set_id(self : Props, id : Int, v : Array[Tok]) -> Unit {
  let bit = 1L << (id & 63)
  let w = (id >> 6) & 3
  let had_bit = if w == 0 {
    let h = (self.mask0 & bit) != 0L
    self.mask0 = self.mask0 | bit
    h
  } else if w == 1 {
    let h = (self.mask1 & bit) != 0L
    self.mask1 = self.mask1 | bit
    h
  } else if w == 2 {
    let h = (self.mask2 & bit) != 0L
    self.mask2 = self.mask2 | bit
    h
  } else {
    let h = (self.mask3 & bit) != 0L
    self.mask3 = self.mask3 | bit
    h
  }
  if self.slots.length() > 0 {
    if id >= self.slots.length() {
      let doubled = self.slots.length() * 2
      let target = if id + 1 > doubled { id + 1 } else { doubled }
      while self.slots.length() < target {
        self.slots.push(None)
      }
    }
    if self.slots[id].is_none() {
      self.count = self.count + 1
    }
    self.slots[id] = Some(v)
    return
  }
  let n = self.keys.length()
  if n == 0 {
    if self.k0 < 0 {
      self.k0 = id
      self.v0 = v
      self.count = 1
      return
    }
    if self.k0 == id {
      self.v0 = v
      return
    }
    if self.k1 < 0 {
      self.k1 = id
      self.v1 = v
      self.count = 2
      return
    }
    if self.k1 == id {
      self.v1 = v
      return
    }
    let keys : Array[Int] = Array::with_capacity(8)
    keys.push(self.k0)
    keys.push(self.k1)
    keys.push(id)
    let vals : Array[Array[Tok]] = Array::with_capacity(8)
    vals.push(self.v0)
    vals.push(self.v1)
    vals.push(v)
    self.keys = keys
    self.vals = vals
    self.k0 = -1
    self.v0 = empty_toks
    self.k1 = -1
    self.v1 = empty_toks
    self.count = 3
    return
  }
  if had_bit {
    let mut i = 0
    while i < n {
      if self.keys[i] == id {
        self.vals[i] = v
        return
      }
      i = i + 1
    }
  }
  if n < 32 {
    self.keys.push(id)
    self.vals.push(v)
    self.count = self.count + 1
    return
  }
  // Promote sparse -> dense (> 32 own properties)
  let base_cap = if prop_names.length() > 16 { prop_names.length() } else { 16 }
  let cap = if id + 1 > base_cap { id + 1 } else { base_cap }
  let slots = make_none_slots(cap)
  let mut j = 0
  while j < n {
    let k = self.keys[j]
    if k >= slots.length() {
      while slots.length() <= k {
        slots.push(None)
      }
    }
    slots[k] = Some(self.vals[j])
    j = j + 1
  }
  slots[id] = Some(v)
  self.slots = slots
  self.keys = empty_keys
  self.vals = empty_vals
  self.count = self.count + 1
}

pub fn Props::set(self : Props, name : String, v : Array[Tok]) -> Unit {
  self.set_id(prop_id(name), v)
}

pub fn Props::remove_id(self : Props, id : Int) -> Unit {
  if id < 0 || self.count == 0 {
    return
  }
  if self.k0 >= 0 {
    if self.k0 == id {
      if self.k1 >= 0 {
        self.k0 = self.k1
        self.v0 = self.v1
        self.k1 = -1
        self.v1 = empty_toks
        self.count = 1
      } else {
        self.k0 = -1
        self.v0 = empty_toks
        self.count = 0
        self.mask0 = 0L
        self.mask1 = 0L
        self.mask2 = 0L
        self.mask3 = 0L
      }
      return
    }
    if self.k1 == id {
      self.k1 = -1
      self.v1 = empty_toks
      self.count = 1
    }
    return
  }
  if self.slots.length() > 0 {
    if id >= 0 && id < self.slots.length() {
      if self.slots[id].is_some() {
        self.slots[id] = None
        self.count = self.count - 1
        if self.count == 0 {
          self.mask0 = 0L
          self.mask1 = 0L
          self.mask2 = 0L
          self.mask3 = 0L
        }
      }
    }
  } else {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      if self.keys[i] == id {
        let last = n - 1
        if i != last {
          self.keys[i] = self.keys[last]
          self.vals[i] = self.vals[last]
        }
        let _ = self.keys.pop()
        let _ = self.vals.pop()
        self.count = self.count - 1
        if self.count == 0 {
          self.keys = empty_keys
          self.vals = empty_vals
          self.mask0 = 0L
          self.mask1 = 0L
          self.mask2 = 0L
          self.mask3 = 0L
        }
        return
      }
      i = i + 1
    }
  }
}

pub fn Props::remove(self : Props, name : String) -> Unit {
  match prop_id_of(name) {
    Some(id) => self.remove_id(id)
    None => ()
  }
}

pub fn Props::length(self : Props) -> Int {
  self.count
}

pub fn Props::copy(self : Props) -> Props {
  if self.count == 0 {
    return Props::new()
  }
  if self.k0 >= 0 {
    return Props::{
      k0: self.k0,
      v0: self.v0,
      k1: self.k1,
      v1: self.v1,
      keys: empty_keys,
      vals: empty_vals,
      slots: empty_slots,
      count: self.count,
      mask0: self.mask0,
      mask1: self.mask1,
      mask2: self.mask2,
      mask3: self.mask3,
    }
  }
  if self.slots.length() > 0 {
    let out : Array[Option[Array[Tok]]] = []
    let mut i = 0
    while i < self.slots.length() {
      out.push(self.slots[i])
      i = i + 1
    }
    Props::{
      k0: -1,
      v0: empty_toks,
      k1: -1,
      v1: empty_toks,
      keys: empty_keys,
      vals: empty_vals,
      slots: out,
      count: self.count,
      mask0: self.mask0,
      mask1: self.mask1,
      mask2: self.mask2,
      mask3: self.mask3,
    }
  } else {
    let ks : Array[Int] = []
    let vs : Array[Array[Tok]] = []
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      ks.push(self.keys[i])
      vs.push(self.vals[i])
      i = i + 1
    }
    Props::{
      k0: -1,
      v0: empty_toks,
      k1: -1,
      v1: empty_toks,
      keys: ks,
      vals: vs,
      slots: empty_slots,
      count: self.count,
      mask0: self.mask0,
      mask1: self.mask1,
      mask2: self.mask2,
      mask3: self.mask3,
    }
  }
}

pub fn Props::same(self : Props, other : Props) -> Bool {
  if self.count != other.count {
    return false
  }
  if self.count == 0 {
    return true
  }
  if self.k0 >= 0 {
    match other.get_id(self.k0) {
      Some(vb) => if !toks_eq(self.v0, vb) { return false }
      None => return false
    }
    if self.k1 >= 0 {
      match other.get_id(self.k1) {
        Some(vb) => if !toks_eq(self.v1, vb) { return false }
        None => return false
      }
    }
    return true
  }
  if other.k0 >= 0 {
    match self.get_id(other.k0) {
      Some(va) => if !toks_eq(va, other.v0) { return false }
      None => return false
    }
    if other.k1 >= 0 {
      match self.get_id(other.k1) {
        Some(va) => if !toks_eq(va, other.v1) { return false }
        None => return false
      }
    }
    return true
  }
  if self.slots.length() == 0 {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      match other.get_id(self.keys[i]) {
        Some(vb) => if !toks_eq(self.vals[i], vb) { return false }
        None => return false
      }
      i = i + 1
    }
    return true
  }
  if other.slots.length() == 0 {
    let mut i = 0
    let n = other.keys.length()
    while i < n {
      match self.get_id(other.keys[i]) {
        Some(va) => if !toks_eq(va, other.vals[i]) { return false }
        None => return false
      }
      i = i + 1
    }
    return true
  }
  let n = if self.slots.length() > other.slots.length() {
    self.slots.length()
  } else {
    other.slots.length()
  }
  let mut i = 0
  while i < n {
    let a = if i < self.slots.length() { self.slots[i] } else { None }
    let b = if i < other.slots.length() { other.slots[i] } else { None }
    match a {
      None => {
        if b.is_some() {
          return false
        }
      }
      Some(va) => {
        match b {
          Some(vb) => {
            if !toks_eq(va, vb) {
              return false
            }
          }
          None => return false
        }
      }
    }
    i = i + 1
  }
  true
}

pub fn Props::each_id(self : Props, f : (Int, Array[Tok]) -> Unit) -> Unit {
  if self.count == 0 {
    return
  }
  if self.k0 >= 0 {
    f(self.k0, self.v0)
    if self.k1 >= 0 {
      f(self.k1, self.v1)
    }
    return
  }
  if self.slots.length() > 0 {
    let mut i = 0
    while i < self.slots.length() {
      match self.slots[i] {
        Some(v) => f(i, v)
        None => ()
      }
      i = i + 1
    }
  } else {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      f(self.keys[i], self.vals[i])
      i = i + 1
    }
  }
}

pub fn Props::keys(self : Props) -> Array[String] {
  let out : Array[String] = []
  if self.count == 0 {
    return out
  }
  if self.k0 >= 0 {
    out.push(prop_names[self.k0])
    if self.k1 >= 0 {
      out.push(prop_names[self.k1])
    }
    return out
  }
  if self.slots.length() > 0 {
    let mut i = 0
    while i < self.slots.length() {
      if self.slots[i].is_some() {
        out.push(prop_names[i])
      }
      i = i + 1
    }
  } else {
    let mut i = 0
    let n = self.keys.length()
    while i < n {
      out.push(prop_names[self.keys[i]])
      i = i + 1
    }
  }
  out
}

