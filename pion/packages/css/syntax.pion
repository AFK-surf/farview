///| CSS Syntax Level 3: tokens, rules, declarations, nesting, @scope, @import.
///| 1:1 port of `client/src/css/syntax.mbt`.

import "html"
import "intmap"
import "fvdmath"

// ----- String & Char helpers shared across css package -----

fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i = i + 1
  }
  sb.to_string()
}

fn str_has_prefix(s : String, pre : String) -> Bool {
  let n = pre.length()
  if s.length() < n {
    return false
  }
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) != pre.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_has_suffix(s : String, suf : String) -> Bool {
  let n = suf.length()
  let sl = s.length()
  if sl < n {
    return false
  }
  let off = sl - n
  let mut i = 0
  while i < n {
    if s.code_unit_at(off + i) != suf.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

fn str_find(s : String, pat : String) -> Option[Int] {
  let n = s.length()
  let m = pat.length()
  if m == 0 {
    return Some(0)
  }
  if m > n {
    return None
  }
  let mut i = 0
  let lim = n - m
  while i <= lim {
    let mut j = 0
    while j < m && s.code_unit_at(i + j) == pat.code_unit_at(j) {
      j = j + 1
    }
    if j == m {
      return Some(i)
    }
    i = i + 1
  }
  None
}

fn str_contains(s : String, pat : String) -> Bool {
  str_find(s, pat).is_some()
}

fn str_slice(s : String, start : Int, end : Int) -> String {
  let sl = s.length()
  let a = if start < 0 { 0 } else if start > sl { sl } else { start }
  let b = if end < a { a } else if end > sl { sl } else { end }
  if a == 0 && b == sl {
    return s
  }
  s.slice(a, b)
}

fn trim_str(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && is_space_byte(s.code_unit_at(a)) {
    a = a + 1
  }
  let mut b = n
  while b > a && is_space_byte(s.code_unit_at(b - 1)) {
    b = b - 1
  }
  str_slice(s, a, b)
}

fn str_split_char(s : String, sep : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == sep {
      out.push(str_slice(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(str_slice(s, start, n))
  out
}

fn str_join(xs : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}

fn str_arr_contains(arr : Array[String], x : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == x {
      return true
    }
    i = i + 1
  }
  false
}

fn tok_slice(t : Array[Tok], start : Int, end : Int) -> Array[Tok] {
  let a = if start < 0 { 0 } else { start }
  let b = if end > t.length() { t.length() } else { end }
  if b <= a {
    return []
  }
  let out : Array[Tok] = Array::with_capacity(b - a)
  let mut i = a
  while i < b {
    out.push(t[i])
    i = i + 1
  }
  out
}

fn tok_copy(t : Array[Tok]) -> Array[Tok] {
  tok_slice(t, 0, t.length())
}

fn tok_append(dst : Array[Tok], src : Array[Tok]) -> Unit {
  let mut i = 0
  while i < src.length() {
    dst.push(src[i])
    i = i + 1
  }
}

fn tok_filter_no_space(t : Array[Tok]) -> Array[Tok] {
  let out : Array[Tok] = []
  let mut i = 0
  while i < t.length() {
    match t[i] {
      Space => ()
      _ => out.push(t[i])
    }
    i = i + 1
  }
  out
}

fn tok_filter_no_end(t : Array[Tok]) -> Array[Tok] {
  let out : Array[Tok] = []
  let mut i = 0
  while i < t.length() {
    match t[i] {
      End => ()
      _ => out.push(t[i])
    }
    i = i + 1
  }
  out
}

fn tok_filter_no_space_end(t : Array[Tok]) -> Array[Tok] {
  let out : Array[Tok] = []
  let mut i = 0
  while i < t.length() {
    match t[i] {
      Space => ()
      End => ()
      _ => out.push(t[i])
    }
    i = i + 1
  }
  out
}

fn tok_search_delim(t : Array[Tok], ch : Int) -> Option[Int] {
  let mut i = 0
  let mut depth = 0
  while i < t.length() {
    match t[i] {
      Function(_) | OpenParen | OpenSquare | OpenCurly => depth = depth + 1
      CloseParen | CloseSquare | CloseCurly => if depth > 0 { depth = depth - 1 }
      Delim(c) => {
        if depth == 0 && c == ch {
          return Some(i)
        }
      }
      _ => ()
    }
    i = i + 1
  }
  None
}

fn tok_search_comma(t : Array[Tok]) -> Option[Int] {
  let mut i = 0
  let mut depth = 0
  while i < t.length() {
    match t[i] {
      Function(_) | OpenParen | OpenSquare | OpenCurly => depth = depth + 1
      CloseParen | CloseSquare | CloseCurly => if depth > 0 { depth = depth - 1 }
      Comma => if depth == 0 { return Some(i) }
      _ => ()
    }
    i = i + 1
  }
  None
}

fn tok_contains_colon(t : Array[Tok]) -> Bool {
  let mut i = 0
  while i < t.length() {
    match t[i] {
      Colon => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

fn cp_to_str(cp : Int) -> String {
  let sb = StringBuilder::new()
  write_utf8_cp(sb, cp)
  sb.to_string()
}

fn decode_utf8_chars(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let b0 = s.code_unit_at(i)
    if b0 < 0x80 {
      out.push(b0)
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
      let b1 = s.code_unit_at(i + 1)
      out.push(((b0 & 0x1F) << 6) | (b1 & 0x3F))
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      out.push(((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F))
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
      let b1 = s.code_unit_at(i + 1)
      let b2 = s.code_unit_at(i + 2)
      let b3 = s.code_unit_at(i + 3)
      out.push(((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F))
      i = i + 4
    } else {
      out.push(0xFFFD)
      i = i + 1
    }
  }
  out
}

// ----- Tokens -----

pub enum Tok {
  Ident(String)
  Function(String)
  AtKeyword(String)
  Hash(String, Bool)
  Str(String)
  Url(String)
  Delim(Int)
  Number(Double)
  Percentage(Double)
  Dimension(Double, String)
  Space
  Colon
  Semicolon
  Comma
  OpenSquare
  CloseSquare
  OpenParen
  CloseParen
  OpenCurly
  CloseCurly
  Cdo
  Cdc
  Bad
  End
}

pub fn tok_eq(a : Tok, b : Tok) -> Bool {
  match a {
    Ident(x) => match b { Ident(y) => x == y _ => false }
    Function(x) => match b { Function(y) => x == y _ => false }
    AtKeyword(x) => match b { AtKeyword(y) => x == y _ => false }
    Hash(x, ix) => match b { Hash(y, iy) => x == y && ix == iy _ => false }
    Str(x) => match b { Str(y) => x == y _ => false }
    Url(x) => match b { Url(y) => x == y _ => false }
    Delim(x) => match b { Delim(y) => x == y _ => false }
    Number(x) => match b { Number(y) => x == y _ => false }
    Percentage(x) => match b { Percentage(y) => x == y _ => false }
    Dimension(x, ux) => match b { Dimension(y, uy) => x == y && ux == uy _ => false }
    Space => match b { Space => true _ => false }
    Colon => match b { Colon => true _ => false }
    Semicolon => match b { Semicolon => true _ => false }
    Comma => match b { Comma => true _ => false }
    OpenSquare => match b { OpenSquare => true _ => false }
    CloseSquare => match b { CloseSquare => true _ => false }
    OpenParen => match b { OpenParen => true _ => false }
    CloseParen => match b { CloseParen => true _ => false }
    OpenCurly => match b { OpenCurly => true _ => false }
    CloseCurly => match b { CloseCurly => true _ => false }
    Cdo => match b { Cdo => true _ => false }
    Cdc => match b { Cdc => true _ => false }
    Bad => match b { Bad => true _ => false }
    End => match b { End => true _ => false }
  }
}

pub fn toks_eq(a : Array[Tok], b : Array[Tok]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !tok_eq(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  true
}

fn double_show(n : Double) -> String {
  if n == fvdmath::floor(n) && fvdmath::abs(n) < 1000000000000000.0 {
    fvdmath::d2i64(n).to_string()
  } else {
    n.to_string()
  }
}

pub fn tok_to_string(t : Tok) -> String {
  match t {
    Ident(v) => "Ident(" + v + ")"
    Function(v) => "Function(" + v + ")"
    AtKeyword(v) => "AtKeyword(" + v + ")"
    Hash(v, id) => "Hash(" + v + ", " + (if id { "true" } else { "false" }) + ")"
    Str(v) => "Str(" + v + ")"
    Url(v) => "Url(" + v + ")"
    Delim(c) => "Delim(" + cp_to_str(c) + ")"
    Number(n) => "Number(" + double_show(n) + ")"
    Percentage(n) => "Percentage(" + double_show(n) + ")"
    Dimension(n, u) => "Dimension(" + double_show(n) + ", " + u + ")"
    Space => "Space"
    Colon => "Colon"
    Semicolon => "Semicolon"
    Comma => "Comma"
    OpenSquare => "OpenSquare"
    CloseSquare => "CloseSquare"
    OpenParen => "OpenParen"
    CloseParen => "CloseParen"
    OpenCurly => "OpenCurly"
    CloseCurly => "CloseCurly"
    Cdo => "Cdo"
    Cdc => "Cdc"
    Bad => "Bad"
    End => "End"
  }
}

// ----- Lexer -----

let no_ints : Array[Int] = []

struct Lexer {
  raw : String
  s : Array[Int]
  ascii : Bool
  len : Int
  mut i : Int
}

fn Lexer::char_at(self : Lexer, p : Int) -> Int {
  if self.ascii {
    self.raw.code_unit_at(p)
  } else {
    self.s[p]
  }
}

fn Lexer::at(self : Lexer, k : Int) -> Int {
  let p = self.i + k
  if p >= 0 && p < self.len {
    if self.ascii { self.raw.code_unit_at(p) } else { self.s[p] }
  } else {
    0
  }
}

fn Lexer::eof(self : Lexer) -> Bool {
  self.i >= self.len
}

fn is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_hex(c : Int) -> Bool {
  is_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
}

fn is_name_start(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95 || c >= 0x80
}

fn is_name(c : Int) -> Bool {
  is_name_start(c) || is_digit(c) || c == 45
}

fn is_space(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn is_space_byte(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

fn hex_val(c : Int) -> Int {
  if is_digit(c) {
    c - 48
  } else if c >= 97 {
    c - 87
  } else {
    c - 55
  }
}

fn Lexer::valid_escape(self : Lexer, k : Int) -> Bool {
  self.at(k) == 92 && self.at(k + 1) != 10 && self.i + k + 1 < self.len
}

fn Lexer::starts_ident(self : Lexer, k : Int) -> Bool {
  let c = self.at(k)
  if c == 45 {
    is_name_start(self.at(k + 1)) || self.at(k + 1) == 45 || self.valid_escape(k + 1)
  } else if is_name_start(c) {
    self.i + k < self.len
  } else {
    self.valid_escape(k)
  }
}

fn Lexer::starts_number(self : Lexer) -> Bool {
  let c = self.at(0)
  if c == 43 || c == 45 {
    is_digit(self.at(1)) || (self.at(1) == 46 && is_digit(self.at(2)))
  } else if c == 46 {
    is_digit(self.at(1))
  } else {
    is_digit(c)
  }
}

fn Lexer::escape(self : Lexer) -> Int {
  self.i = self.i + 1
  let c = self.at(0)
  if is_hex(c) {
    let mut v = 0
    let mut n = 0
    while n < 6 && is_hex(self.at(0)) {
      v = v * 16 + hex_val(self.at(0))
      self.i = self.i + 1
      n = n + 1
    }
    if is_space(self.at(0)) {
      self.i = self.i + 1
    }
    if v == 0 || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF) {
      0xFFFD
    } else {
      v
    }
  } else {
    self.i = self.i + 1
    c
  }
}

fn css_slice_eq_lit(src : String, start : Int, len : Int, lit : String) -> Bool {
  let mut i = 0
  while i < len {
    if src.code_unit_at(start + i) != lit.code_unit_at(i) {
      return false
    }
    i = i + 1
  }
  true
}

pub fn intern_css_ident(src : String, start : Int, end : Int) -> String {
  let len = end - start
  if len < 2 || len > 16 {
    return src.slice(start, end)
  }
  let c0 = src.code_unit_at(start)
  match len {
    2 => {
      let c1 = src.code_unit_at(start + 1)
      match c0 {
        0x70 => if c1 == 0x78 { return "px" }
        0x65 => if c1 == 0x6D { return "em" }
        0x6D => if c1 == 0x73 { return "ms" }
        0x76 =>
        if c1 == 0x68 { return "vh" }
        else if c1 == 0x77 { return "vw" }
        0x66 => if c1 == 0x72 { return "fr" }
        _ => ()
      }
    }
    3 =>
    match c0 {
      0x72 =>
      if css_slice_eq_lit(src, start, 3, "rem") { return "rem" }
      else if css_slice_eq_lit(src, start, 3, "rgb") { return "rgb" }
      0x64 => if css_slice_eq_lit(src, start, 3, "deg") { return "deg" }
      0x74 => if css_slice_eq_lit(src, start, 3, "top") { return "top" }
      0x76 => if css_slice_eq_lit(src, start, 3, "var") { return "var" }
      0x70 => if css_slice_eq_lit(src, start, 3, "pre") { return "pre" }
      0x61 => if css_slice_eq_lit(src, start, 3, "all") { return "all" }
      0x75 => if css_slice_eq_lit(src, start, 3, "url") { return "url" }
      _ => ()
    }
    4 =>
    match c0 {
      0x61 => if css_slice_eq_lit(src, start, 4, "auto") { return "auto" }
      0x6E => if css_slice_eq_lit(src, start, 4, "none") { return "none" }
      0x66 =>
      if css_slice_eq_lit(src, start, 4, "flex") { return "flex" }
      else if css_slice_eq_lit(src, start, 4, "font") { return "font" }
      0x67 => if css_slice_eq_lit(src, start, 4, "grid") { return "grid" }
      0x62 =>
      if css_slice_eq_lit(src, start, 4, "bold") { return "bold" }
      else if css_slice_eq_lit(src, start, 4, "both") { return "both" }
      0x6C =>
      if css_slice_eq_lit(src, start, 4, "left") { return "left" }
      else if css_slice_eq_lit(src, start, 4, "line") { return "line" }
      0x72 => if css_slice_eq_lit(src, start, 4, "rgba") { return "rgba" }
      0x63 => if css_slice_eq_lit(src, start, 4, "calc") { return "calc" }
      0x77 => if css_slice_eq_lit(src, start, 4, "wrap") { return "wrap" }
      0x74 => if css_slice_eq_lit(src, start, 4, "text") { return "text" }
      0x73 =>
      if css_slice_eq_lit(src, start, 4, "size") { return "size" }
      else if css_slice_eq_lit(src, start, 4, "sans") { return "sans" }
      _ => ()
    }
    5 =>
    match c0 {
      0x62 => if css_slice_eq_lit(src, start, 5, "block") { return "block" }
      0x73 =>
      if css_slice_eq_lit(src, start, 5, "solid") { return "solid" }
      else if css_slice_eq_lit(src, start, 5, "start") { return "start" }
      else if css_slice_eq_lit(src, start, 5, "serif") { return "serif" }
      0x66 =>
      if css_slice_eq_lit(src, start, 5, "fixed") { return "fixed" }
      else if css_slice_eq_lit(src, start, 5, "float") { return "float" }
      else if css_slice_eq_lit(src, start, 5, "focus") { return "focus" }
      0x72 => if css_slice_eq_lit(src, start, 5, "right") { return "right" }
      0x63 =>
      if css_slice_eq_lit(src, start, 5, "color") { return "color" }
      else if css_slice_eq_lit(src, start, 5, "clear") { return "clear" }
      0x77 => if css_slice_eq_lit(src, start, 5, "width") { return "width" }
      0x75 => if css_slice_eq_lit(src, start, 5, "unset") { return "unset" }
      0x74 => if css_slice_eq_lit(src, start, 5, "table") { return "table" }
      0x68 => if css_slice_eq_lit(src, start, 5, "hover") { return "hover" }
      _ => ()
    }
    6 =>
    match c0 {
      0x69 =>
      if css_slice_eq_lit(src, start, 6, "inline") { return "inline" }
      else if css_slice_eq_lit(src, start, 6, "italic") { return "italic" }
      0x68 =>
      if css_slice_eq_lit(src, start, 6, "hidden") { return "hidden" }
      else if css_slice_eq_lit(src, start, 6, "height") { return "height" }
      0x73 =>
      if css_slice_eq_lit(src, start, 6, "static") { return "static" }
      else if css_slice_eq_lit(src, start, 6, "sticky") { return "sticky" }
      else if css_slice_eq_lit(src, start, 6, "scroll") { return "scroll" }
      else if css_slice_eq_lit(src, start, 6, "shadow") { return "shadow" }
      0x63 =>
      if css_slice_eq_lit(src, start, 6, "center") { return "center" }
      else if css_slice_eq_lit(src, start, 6, "cursor") { return "cursor" }
      0x6E =>
      if css_slice_eq_lit(src, start, 6, "normal") { return "normal" }
      else if css_slice_eq_lit(src, start, 6, "nowrap") { return "nowrap" }
      0x62 =>
      if css_slice_eq_lit(src, start, 6, "bottom") { return "bottom" }
      else if css_slice_eq_lit(src, start, 6, "border") { return "border" }
      0x6D =>
      if css_slice_eq_lit(src, start, 6, "margin") { return "margin" }
      else if css_slice_eq_lit(src, start, 6, "medium") { return "medium" }
      else if css_slice_eq_lit(src, start, 6, "middle") { return "middle" }
      0x66 => if css_slice_eq_lit(src, start, 6, "filter") { return "filter" }
      _ => ()
    }
    7 =>
    match c0 {
      0x76 => if css_slice_eq_lit(src, start, 7, "visible") { return "visible" }
      0x69 =>
      if css_slice_eq_lit(src, start, 7, "inherit") { return "inherit" }
      else if css_slice_eq_lit(src, start, 7, "initial") { return "initial" }
      0x70 =>
      if css_slice_eq_lit(src, start, 7, "padding") { return "padding" }
      else if css_slice_eq_lit(src, start, 7, "pointer") { return "pointer" }
      0x64 =>
      if css_slice_eq_lit(src, start, 7, "display") { return "display" }
      else if css_slice_eq_lit(src, start, 7, "default") { return "default" }
      0x6F =>
      if css_slice_eq_lit(src, start, 7, "opacity") { return "opacity" }
      else if css_slice_eq_lit(src, start, 7, "outline") { return "outline" }
      0x63 =>
      if css_slice_eq_lit(src, start, 7, "content") { return "content" }
      else if css_slice_eq_lit(src, start, 7, "checked") { return "checked" }
      0x7A => if css_slice_eq_lit(src, start, 7, "z-index") { return "z-index" }
      0x6A => if css_slice_eq_lit(src, start, 7, "justify") { return "justify" }
      0x73 => if css_slice_eq_lit(src, start, 7, "stretch") { return "stretch" }
      _ => ()
    }
    8 =>
    match c0 {
      0x72 => if css_slice_eq_lit(src, start, 8, "relative") { return "relative" }
      0x61 => if css_slice_eq_lit(src, start, 8, "absolute") { return "absolute" }
      0x70 => if css_slice_eq_lit(src, start, 8, "position") { return "position" }
      0x6F => if css_slice_eq_lit(src, start, 8, "overflow") { return "overflow" }
      0x62 => if css_slice_eq_lit(src, start, 8, "baseline") { return "baseline" }
      0x65 => if css_slice_eq_lit(src, start, 8, "ellipsis") { return "ellipsis" }
      0x76 => if css_slice_eq_lit(src, start, 8, "vertical") { return "vertical" }
      0x64 => if css_slice_eq_lit(src, start, 8, "disabled") { return "disabled" }
      0x73 => if css_slice_eq_lit(src, start, 8, "selected") { return "selected" }
      _ => ()
    }
    9 =>
    match c0 {
      0x66 => if css_slice_eq_lit(src, start, 9, "font-size") { return "font-size" }
      0x74 => if css_slice_eq_lit(src, start, 9, "transform") { return "transform" }
      0x6D =>
      if css_slice_eq_lit(src, start, 9, "max-width") { return "max-width" }
      else if css_slice_eq_lit(src, start, 9, "min-width") { return "min-width" }
      _ => ()
    }
    10 =>
    match c0 {
      0x62 =>
      if css_slice_eq_lit(src, start, 10, "background") { return "background" }
      else if css_slice_eq_lit(src, start, 10, "border-box") { return "border-box" }
      else if css_slice_eq_lit(src, start, 10, "box-sizing") { return "box-sizing" }
      0x74 =>
      if css_slice_eq_lit(src, start, 10, "text-align") { return "text-align" }
      else if css_slice_eq_lit(src, start, 10, "transition") { return "transition" }
      0x6D =>
      if css_slice_eq_lit(src, start, 10, "margin-top") { return "margin-top" }
      else if css_slice_eq_lit(src, start, 10, "max-height") { return "max-height" }
      else if css_slice_eq_lit(src, start, 10, "min-height") { return "min-height" }
      0x76 => if css_slice_eq_lit(src, start, 10, "visibility") { return "visibility" }
      0x66 => if css_slice_eq_lit(src, start, 10, "flex-basis") { return "flex-basis" }
      0x6C => if css_slice_eq_lit(src, start, 10, "list-style") { return "list-style" }
      _ => ()
    }
    11 =>
    match c0 {
      0x74 => if css_slice_eq_lit(src, start, 11, "transparent") { return "transparent" }
      0x66 =>
      if css_slice_eq_lit(src, start, 11, "font-weight") { return "font-weight" }
      else if css_slice_eq_lit(src, start, 11, "font-family") { return "font-family" }
      0x6C => if css_slice_eq_lit(src, start, 11, "line-height") { return "line-height" }
      0x77 => if css_slice_eq_lit(src, start, 11, "white-space") { return "white-space" }
      0x6D => if css_slice_eq_lit(src, start, 11, "margin-left") { return "margin-left" }
      0x70 => if css_slice_eq_lit(src, start, 11, "padding-top") { return "padding-top" }
      0x61 => if css_slice_eq_lit(src, start, 11, "align-items") { return "align-items" }
      0x62 => if css_slice_eq_lit(src, start, 11, "border-left") { return "border-left" }
      _ => ()
    }
    12 =>
    match c0 {
      0x69 => if css_slice_eq_lit(src, start, 12, "inline-block") { return "inline-block" }
      0x6D => if css_slice_eq_lit(src, start, 12, "margin-right") { return "margin-right" }
      0x70 => if css_slice_eq_lit(src, start, 12, "padding-left") { return "padding-left" }
      0x62 =>
      if css_slice_eq_lit(src, start, 12, "border-width") { return "border-width" }
      else if css_slice_eq_lit(src, start, 12, "border-color") { return "border-color" }
      else if css_slice_eq_lit(src, start, 12, "border-style") { return "border-style" }
      else if css_slice_eq_lit(src, start, 12, "border-right") { return "border-right" }
      _ => ()
    }
    13 =>
    match c0 {
      0x62 =>
      if css_slice_eq_lit(src, start, 13, "border-radius") { return "border-radius" }
      else if css_slice_eq_lit(src, start, 13, "border-bottom") { return "border-bottom" }
      0x6D => if css_slice_eq_lit(src, start, 13, "margin-bottom") { return "margin-bottom" }
      0x70 => if css_slice_eq_lit(src, start, 13, "padding-right") { return "padding-right" }
      0x74 => if css_slice_eq_lit(src, start, 13, "text-overflow") { return "text-overflow" }
      _ => ()
    }
    14 =>
    match c0 {
      0x70 =>
      if css_slice_eq_lit(src, start, 14, "padding-bottom") { return "padding-bottom" }
      else if css_slice_eq_lit(src, start, 14, "pointer-events") { return "pointer-events" }
      0x66 => if css_slice_eq_lit(src, start, 14, "flex-direction") { return "flex-direction" }
      0x6C => if css_slice_eq_lit(src, start, 14, "letter-spacing") { return "letter-spacing" }
      0x76 => if css_slice_eq_lit(src, start, 14, "vertical-align") { return "vertical-align" }
      0x74 => if css_slice_eq_lit(src, start, 14, "text-transform") { return "text-transform" }
      _ => ()
    }
    15 =>
    match c0 {
      0x74 => if css_slice_eq_lit(src, start, 15, "text-decoration") { return "text-decoration" }
      0x6A => if css_slice_eq_lit(src, start, 15, "justify-content") { return "justify-content" }
      _ => ()
    }
    16 =>
    if c0 == 0x62 {
      if css_slice_eq_lit(src, start, 16, "background-color") { return "background-color" }
      else if css_slice_eq_lit(src, start, 16, "background-image") { return "background-image" }
    }
    _ => ()
  }
  src.slice(start, end)
}

fn Lexer::name(self : Lexer) -> String {
  if self.ascii {
    let start = self.i
    while self.i < self.len {
      let c = self.raw.code_unit_at(self.i)
      if is_name(c) {
        self.i = self.i + 1
      } else if c == 92 {
        break
      } else {
        return intern_css_ident(self.raw, start, self.i)
      }
    }
    if self.i >= self.len || !self.valid_escape(0) {
      return intern_css_ident(self.raw, start, self.i)
    }
    let b = StringBuilder::new()
    if self.i > start {
      b.write_string(self.raw.slice(start, self.i))
    }
    while !self.eof() {
      let c = self.at(0)
      if is_name(c) {
        write_utf8_cp(b, c)
        self.i = self.i + 1
      } else if self.valid_escape(0) {
        write_utf8_cp(b, self.escape())
      } else {
        break
      }
    }
    return b.to_string()
  }
  let b = StringBuilder::new()
  while !self.eof() {
    let c = self.at(0)
    if is_name(c) {
      write_utf8_cp(b, c)
      self.i = self.i + 1
    } else if self.valid_escape(0) {
      write_utf8_cp(b, self.escape())
    } else {
      break
    }
  }
  b.to_string()
}

pub fn parse_double_range(t : String, start : Int, end : Int) -> Double {
  let mut i = start
  let mut n = end
  while i < n && is_space(t.code_unit_at(i)) {
    i = i + 1
  }
  while n > i && is_space(t.code_unit_at(n - 1)) {
    n = n - 1
  }
  if i >= n {
    return 0.0
  }
  let mut neg = false
  if t.code_unit_at(i) == 45 {
    neg = true
    i = i + 1
  } else if t.code_unit_at(i) == 43 {
    i = i + 1
  }
  let mut int_part = 0.0
  let mut has_digits = false
  while i < n && is_digit(t.code_unit_at(i)) {
    int_part = int_part * 10.0 + fvdmath::i2d(t.code_unit_at(i) - 48)
    has_digits = true
    i = i + 1
  }
  let mut frac_part = 0.0
  let mut frac_div = 1.0
  if i < n && t.code_unit_at(i) == 46 {
    i = i + 1
    while i < n && is_digit(t.code_unit_at(i)) {
      frac_part = frac_part * 10.0 + fvdmath::i2d(t.code_unit_at(i) - 48)
      frac_div = frac_div * 10.0
      has_digits = true
      i = i + 1
    }
  }
  if !has_digits {
    return 0.0
  }
  let mut val_ = int_part + frac_part / frac_div
  if i < n && (t.code_unit_at(i) == 101 || t.code_unit_at(i) == 69) {
    i = i + 1
    let mut eneg = false
    if i < n && t.code_unit_at(i) == 45 {
      eneg = true
      i = i + 1
    } else if i < n && t.code_unit_at(i) == 43 {
      i = i + 1
    }
    let mut exp = 0
    while i < n && is_digit(t.code_unit_at(i)) {
      if exp < 1000 {
        exp = exp * 10 + (t.code_unit_at(i) - 48)
      }
      i = i + 1
    }
    let e = if eneg { -exp } else { exp }
    val_ = val_ * fvdmath::pow(10.0, fvdmath::i2d(e))
  }
  if neg { -val_ } else { val_ }
}

pub fn parse_double(s : String) -> Double {
  parse_double_range(s, 0, s.length())
}

fn Lexer::number(self : Lexer) -> Double {
  if self.ascii {
    let start = self.i
    if self.at(0) == 43 || self.at(0) == 45 {
      self.i = self.i + 1
    }
    while is_digit(self.at(0)) {
      self.i = self.i + 1
    }
    if self.at(0) == 46 && is_digit(self.at(1)) {
      self.i = self.i + 1
      while is_digit(self.at(0)) {
        self.i = self.i + 1
      }
    }
    let c = self.at(0)
    if (c == 101 || c == 69) &&
    (is_digit(self.at(1)) ||
      ((self.at(1) == 43 || self.at(1) == 45) && is_digit(self.at(2)))) {
      self.i = self.i + 2
      while is_digit(self.at(0)) {
        self.i = self.i + 1
      }
    }
    return parse_double_range(self.raw, start, self.i)
  }
  let b = StringBuilder::new()
  if self.at(0) == 43 || self.at(0) == 45 {
    b.write_char((self.at(0)).unsafe_to_char())
    self.i = self.i + 1
  }
  while is_digit(self.at(0)) {
    b.write_char((self.at(0)).unsafe_to_char())
    self.i = self.i + 1
  }
  if self.at(0) == 46 && is_digit(self.at(1)) {
    b.write_char((46).unsafe_to_char())
    self.i = self.i + 1
    while is_digit(self.at(0)) {
      b.write_char((self.at(0)).unsafe_to_char())
      self.i = self.i + 1
    }
  }
  let c = self.at(0)
  if (c == 101 || c == 69) &&
  (is_digit(self.at(1)) ||
    ((self.at(1) == 43 || self.at(1) == 45) && is_digit(self.at(2)))) {
    b.write_char((101).unsafe_to_char())
    self.i = self.i + 1
    b.write_char((self.at(0)).unsafe_to_char())
    self.i = self.i + 1
    while is_digit(self.at(0)) {
      b.write_char((self.at(0)).unsafe_to_char())
      self.i = self.i + 1
    }
  }
  parse_double(b.to_string())
}

fn Lexer::string(self : Lexer, end : Int) -> Tok {
  self.i = self.i + 1
  if self.ascii {
    let start = self.i
    while self.i < self.len {
      let c = self.raw.code_unit_at(self.i)
      if c == end {
        let out = self.raw.slice(start, self.i)
        self.i = self.i + 1
        return Str(out)
      }
      if c == 10 {
        return Bad
      }
      if c == 92 {
        break
      }
      self.i = self.i + 1
    }
    if self.i >= self.len {
      return Str(self.raw.slice(start, self.i))
    }
    let b = StringBuilder::new()
    if self.i > start {
      b.write_string(self.raw.slice(start, self.i))
    }
    while !self.eof() {
      let c = self.at(0)
      if c == end {
        self.i = self.i + 1
        return Str(b.to_string())
      }
      if c == 10 {
        return Bad
      }
      if c == 92 {
        if self.at(1) == 10 {
          self.i = self.i + 2
        } else if self.i + 1 >= self.len {
          self.i = self.i + 1
        } else {
          write_utf8_cp(b, self.escape())
        }
      } else {
        write_utf8_cp(b, c)
        self.i = self.i + 1
      }
    }
    return Str(b.to_string())
  }
  let b = StringBuilder::new()
  while !self.eof() {
    let c = self.at(0)
    if c == end {
      self.i = self.i + 1
      return Str(b.to_string())
    }
    if c == 10 {
      return Bad
    }
    if c == 92 {
      if self.at(1) == 10 {
        self.i = self.i + 2
      } else if self.i + 1 >= self.len {
        self.i = self.i + 1
      } else {
        write_utf8_cp(b, self.escape())
      }
    } else {
      write_utf8_cp(b, c)
      self.i = self.i + 1
    }
  }
  Str(b.to_string())
}

fn Lexer::url(self : Lexer) -> Tok {
  while is_space(self.at(0)) {
    self.i = self.i + 1
  }
  let b = StringBuilder::new()
  while !self.eof() {
    let c = self.at(0)
    if c == 41 {
      self.i = self.i + 1
      return Url(b.to_string())
    }
    if is_space(c) {
      while is_space(self.at(0)) {
        self.i = self.i + 1
      }
      if self.at(0) == 41 {
        self.i = self.i + 1
        return Url(b.to_string())
      }
      if self.eof() {
        return Url(b.to_string())
      }
      break
    }
    if c == 34 || c == 39 || c == 40 {
      break
    }
    if c == 92 {
      if self.valid_escape(0) {
        write_utf8_cp(b, self.escape())
      } else {
        break
      }
    } else {
      write_utf8_cp(b, c)
      self.i = self.i + 1
    }
  }
  while !self.eof() {
    let c = self.at(0)
    self.i = self.i + 1
    if c == 41 {
      break
    }
  }
  Bad
}

fn Lexer::after_colon(self : Lexer) -> Bool {
  let mut k = self.i - 1
  while k >= 0 && is_space(self.char_at(k)) {
    k = k - 1
  }
  k >= 0 && (self.char_at(k) == 58 || self.char_at(k) == 44)
}

fn Lexer::unicode_range(self : Lexer) -> Option[Tok] {
  let mut k = 2
  while k < 8 && (is_hex(self.at(k)) || self.at(k) == 63) {
    k = k + 1
  }
  if self.at(k) == 45 && is_hex(self.at(k + 1)) {
    k = k + 1
    while k < 16 && is_hex(self.at(k)) {
      k = k + 1
    }
  }
  if is_name(self.at(k)) {
    return None
  }
  let b = StringBuilder::new()
  let mut j = 0
  while j < k {
    write_utf8_cp(b, self.at(j))
    j = j + 1
  }
  self.i = self.i + k
  Some(Ident(b.to_string()))
}

fn Lexer::next(self : Lexer) -> Tok {
  while self.at(0) == 47 && self.at(1) == 42 {
    self.i = self.i + 2
    while !self.eof() && !(self.at(0) == 42 && self.at(1) == 47) {
      self.i = self.i + 1
    }
    self.i = self.i + 2
  }
  if self.eof() {
    return End
  }
  let c = self.at(0)
  if is_space(c) {
    while is_space(self.at(0)) {
      self.i = self.i + 1
    }
    return Space
  }
  if c == 34 || c == 39 {
    return self.string(c)
  }
  if (c == 117 || c == 85) && self.at(1) == 43 && (is_hex(self.at(2)) || self.at(2) == 63) && self.after_colon() {
    match self.unicode_range() {
      Some(t) => return t
      None => ()
    }
  }
  if self.starts_number() {
    let n = self.number()
    if self.starts_ident(0) {
      return Dimension(n, self.name())
    }
    if self.at(0) == 37 {
      self.i = self.i + 1
      return Percentage(n)
    }
    return Number(n)
  }
  if c == 45 && self.at(1) == 45 && self.at(2) == 62 {
    self.i = self.i + 3
    return Cdc
  }
  if self.starts_ident(0) {
    let n = self.name()
    if self.at(0) == 40 {
      self.i = self.i + 1
      if is_url_word(n) {
        let mut k = 0
        while is_space(self.at(k)) {
          k = k + 1
        }
        if self.at(k) != 34 && self.at(k) != 39 {
          return self.url()
        }
      }
      return Function(n)
    }
    return Ident(n)
  }
  self.i = self.i + 1
  match c {
    35 => if is_name(self.at(0)) || self.valid_escape(0) {
      let id = self.starts_ident(0)
      Hash(self.name(), id)
    } else {
      Delim(c)
    }
    40 => OpenParen
    41 => CloseParen
    91 => OpenSquare
    93 => CloseSquare
    123 => OpenCurly
    125 => CloseCurly
    44 => Comma
    58 => Colon
    59 => Semicolon
    64 => if self.starts_ident(0) {
      AtKeyword(self.name())
    } else {
      Delim(c)
    }
    60 => if self.at(0) == 33 && self.at(1) == 45 && self.at(2) == 45 {
      self.i = self.i + 3
      Cdo
    } else {
      Delim(c)
    }
    _ => Delim(c)
  }
}

fn is_url_word(n : String) -> Bool {
  if n.length() != 3 { return false }
  let c0 = n.code_unit_at(0)
  let c1 = n.code_unit_at(1)
  let c2 = n.code_unit_at(2)
  (c0 == 117 || c0 == 85) && (c1 == 114 || c1 == 82) && (c2 == 108 || c2 == 76)
}

pub fn tokenize(s : String) -> Array[Tok] {
  let n = s.length()
  if n == 0 {
    return empty_toks
  }
  let mut is_ascii = true
  let mut k = 0
  while k < n {
    if s.code_unit_at(k) >= 0x80 {
      is_ascii = false
      break
    }
    k = k + 1
  }
  let lx = if is_ascii {
    Lexer::{ raw: s, s: no_ints, ascii: true, len: n, i: 0 }
  } else {
    let dec = decode_utf8_chars(s)
    // CSS Syntax Level 3 §3.2: strip leading U+FEFF BOM if present.
    let start = if dec.length() > 0 && dec[0] == 0xFEFF { 1 } else { 0 }
    Lexer::{ raw: s, s: dec, ascii: false, len: dec.length(), i: start }
  }
  let init_cap = if n > 32 { n / 4 } else { 8 }
  let out : Array[Tok] = Array::with_capacity(init_cap)
  while true {
    let t = lx.next()
    match t {
      End => break
      _ => out.push(t)
    }
  }
  out
}

// ----- Rules & Declarations -----

pub struct Longhand {
  pub id : Int
  pub mark : Int
  pub logical : Bool
  pub value : Array[Tok]
}

pub struct Decl {
  pub name : String
  pub value : Array[Tok]
  pub important : Bool
  pub mut longhands : Option[Array[Longhand]]
  // (a declaration whose value holds var()/attr(): its longhands for the value it last took, and whether in quirks
  // mode, as an element under the same custom properties takes the same value again)
  pub mut var_memo : Option[VarMemo]
}

pub struct VarMemo {
  value : Array[Tok]
  quirks : Bool
  list : Array[Longhand]
}

pub struct Keyframe {
  pub offsets : Array[Double]
  pub decls : Array[Decl]
}

pub enum Rule {
  StyleRule(Array[Selector], Array[Decl])
  MediaRule(Array[Tok], Array[Rule])
  SupportsRule(Array[Tok], Array[Rule])
  FontFaceRule(Array[Decl])
  FeatureValuesRule(Array[Tok], Array[Tok])
  KeyframesRule(String, Array[Keyframe])
  LayerRule(Array[String], Option[Array[Rule]])
  PropertyRule(String, Array[Decl])
  OtherRule
}

struct PreludeBlock {
  pre : Array[Tok]
  body : Array[Tok]
}

struct Parser {
  t : Array[Tok]
  mut i : Int
}

fn Parser::peek(self : Parser) -> Tok {
  if self.i < self.t.length() {
    self.t[self.i]
  } else {
    End
  }
}

fn Parser::skip_block(self : Parser, out : Array[Tok]) -> Unit {
  let stack : Array[Tok] = [self.t[self.i - 1]]
  while self.i < self.t.length() && stack.length() > 0 {
    let t = self.t[self.i]
    self.i = self.i + 1
    let top = stack[stack.length() - 1]
    match t {
      OpenCurly => stack.push(t)
      OpenSquare => stack.push(t)
      OpenParen => stack.push(t)
      Function(_) => stack.push(t)
      CloseCurly => {
        match top {
          OpenCurly => { let _ = stack.pop() }
          _ => ()
        }
      }
      CloseSquare => {
        match top {
          OpenSquare => { let _ = stack.pop() }
          _ => ()
        }
      }
      CloseParen => {
        match top {
          OpenParen => { let _ = stack.pop() }
          Function(_) => { let _ = stack.pop() }
          _ => ()
        }
      }
      _ => ()
    }
    if stack.length() > 0 {
      out.push(t)
    }
  }
}

fn Parser::prelude(self : Parser, stop_semi : Bool) -> Option[PreludeBlock] {
  let pre : Array[Tok] = []
  while self.i < self.t.length() {
    let t = self.t[self.i]
    self.i = self.i + 1
    match t {
      OpenCurly => {
        let body : Array[Tok] = []
        self.skip_block(body)
        return Some(PreludeBlock::{ pre: pre, body: body })
      }
      Semicolon => if stop_semi { return None } else { pre.push(t) }
      OpenSquare => {
        pre.push(t)
        let inner : Array[Tok] = []
        self.skip_block(inner)
        tok_append(pre, inner)
        pre.push(CloseSquare)
      }
      OpenParen => {
        pre.push(t)
        let inner : Array[Tok] = []
        self.skip_block(inner)
        tok_append(pre, inner)
        pre.push(CloseParen)
      }
      Function(_) => {
        pre.push(t)
        let inner : Array[Tok] = []
        self.skip_block(inner)
        tok_append(pre, inner)
        pre.push(CloseParen)
      }
      _ => pre.push(t)
    }
  }
  None
}

fn trim(t : Array[Tok]) -> Array[Tok] {
  let n = t.length()
  if n == 0 {
    return t
  }
  if !(t[0] is Space) && !(t[n - 1] is Space) {
    return t
  }
  let mut a = 0
  let mut b = n
  while a < b && t[a] is Space {
    a = a + 1
  }
  while b > a && t[b - 1] is Space {
    b = b - 1
  }
  tok_slice(t, a, b)
}

fn keyframes_of(body : Array[Tok]) -> Array[Keyframe] {
  let p = Parser::{ t: body, i: 0 }
  let out : Array[Keyframe] = []
  while p.i < body.length() {
    if tok_eq(p.peek(), Space) {
      p.i = p.i + 1
      continue
    }
    match p.prelude(false) {
      Some(pb) => {
        let offsets : Array[Double] = []
        let parts = split_commas(trim(pb.pre))
        let mut pi = 0
        while pi < parts.length() {
          let one = trim(parts[pi])
          if one.length() == 1 {
            match one[0] {
              Ident(w) => {
                let lw = ascii_lower(w)
                if lw == "from" {
                  offsets.push(0.0)
                } else if lw == "to" {
                  offsets.push(1.0)
                }
              }
              Percentage(v) => offsets.push(v / 100.0)
              _ => ()
            }
          }
          pi = pi + 1
        }
        out.push(Keyframe::{ offsets: offsets, decls: parse_decls(pb.body) })
      }
      None => break
    }
  }
  out
}

let container_marker : String = "-fv-container"

fn parse_rules(t : Array[Tok], top : Bool) -> Array[Rule] {
  let p = Parser::{ t: t, i: 0 }
  let out : Array[Rule] = []
  while p.i < t.length() {
    match p.peek() {
      Space => p.i = p.i + 1
      Cdo => {
        if top {
          p.i = p.i + 1
        } else {
          match p.prelude(false) {
            Some(pb) => {
              let rs = style_rules(trim(pb.pre), pb.body)
              let mut ri = 0
              while ri < rs.length() {
                out.push(rs[ri])
                ri = ri + 1
              }
            }
            None => ()
          }
        }
      }
      Cdc => {
        if top {
          p.i = p.i + 1
        } else {
          match p.prelude(false) {
            Some(pb) => {
              let rs = style_rules(trim(pb.pre), pb.body)
              let mut ri = 0
              while ri < rs.length() {
                out.push(rs[ri])
                ri = ri + 1
              }
            }
            None => ()
          }
        }
      }
      AtKeyword(name) => {
        p.i = p.i + 1
        let lname = ascii_lower(name)
        let at = p.i
        match p.prelude(true) {
          None => {
            if lname == "layer" {
              out.push(LayerRule(layer_names(tok_slice(t, at, p.i)), None))
            }
          }
          Some(pb) => {
            if lname == "media" {
              out.push(MediaRule(trim(pb.pre), parse_rules(pb.body, false)))
            } else if lname == "supports" {
              out.push(SupportsRule(trim(pb.pre), parse_rules(pb.body, false)))
            } else if lname == "font-face" {
              out.push(FontFaceRule(parse_decls(pb.body)))
            } else if lname == "font-feature-values" {
              out.push(FeatureValuesRule(trim(pb.pre), pb.body))
            } else if lname == "keyframes" || lname == "-webkit-keyframes" {
              let tp = trim(pb.pre)
              if tp.length() == 1 {
                match tp[0] {
                  Ident(kn) => out.push(KeyframesRule(kn, keyframes_of(pb.body)))
                  Str(kn) => out.push(KeyframesRule(kn, keyframes_of(pb.body)))
                  _ => out.push(OtherRule)
                }
              } else {
                out.push(OtherRule)
              }
            } else if lname == "layer" {
              let lns = layer_names(pb.pre)
              let first_l = if lns.length() > 0 { lns[0] } else { "" }
              out.push(LayerRule([first_l], Some(parse_rules(pb.body, false))))
            } else if lname == "scope" {
              let sr = scope_rules(pb.pre, pb.body)
              let mut si = 0
              while si < sr.length() {
                out.push(sr[si])
                si = si + 1
              }
            } else if lname == "property" {
              let tp = trim(pb.pre)
              if tp.length() == 1 {
                match tp[0] {
                  Ident(pn) => {
                    if str_has_prefix(pn, "--") {
                      out.push(PropertyRule(pn, parse_decls(pb.body)))
                    } else {
                      out.push(OtherRule)
                    }
                  }
                  _ => out.push(OtherRule)
                }
              } else {
                out.push(OtherRule)
              }
            } else if lname == "container" {
              let mq : Array[Tok] = [Ident(container_marker)]
              tok_append(mq, trim(pb.pre))
              out.push(MediaRule(mq, parse_rules(pb.body, false)))
            } else {
              out.push(OtherRule)
            }
          }
        }
      }
      _ => {
        match p.prelude(false) {
          Some(pb) => {
            let rs = style_rules(trim(pb.pre), pb.body)
            let mut ri = 0
            while ri < rs.length() {
              out.push(rs[ri])
              ri = ri + 1
            }
          }
          None => ()
        }
      }
    }
  }
  out
}

fn is_important_word(w : String) -> Bool {
  if w.length() != 9 {
    return false
  }
  let c0 = w.code_unit_at(0)
  let c1 = w.code_unit_at(1)
  let c2 = w.code_unit_at(2)
  let c3 = w.code_unit_at(3)
  let c4 = w.code_unit_at(4)
  let c5 = w.code_unit_at(5)
  let c6 = w.code_unit_at(6)
  let c7 = w.code_unit_at(7)
  let c8 = w.code_unit_at(8)
  (c0 == 105 || c0 == 73) &&
  (c1 == 109 || c1 == 77) &&
  (c2 == 112 || c2 == 80) &&
  (c3 == 111 || c3 == 79) &&
  (c4 == 114 || c4 == 82) &&
  (c5 == 116 || c5 == 84) &&
  (c6 == 97 || c6 == 65) &&
  (c7 == 110 || c7 == 78) &&
  (c8 == 116 || c8 == 84)
}

pub fn parse_decls(t : Array[Tok]) -> Array[Decl] {
  let out : Array[Decl] = []
  let tlen = t.length()
  let mut i = 0
  while i < tlen {
    while i < tlen && (tok_eq(t[i], Space) || tok_eq(t[i], Semicolon)) {
      i = i + 1
    }
    let start = i
    let mut depth = 0
    while i < tlen {
      match t[i] {
        OpenCurly => depth = depth + 1
        OpenParen => depth = depth + 1
        OpenSquare => depth = depth + 1
        Function(_) => depth = depth + 1
        CloseCurly => depth = depth - 1
        CloseParen => depth = depth - 1
        CloseSquare => depth = depth - 1
        Semicolon => {
          if depth == 0 {
            break
          }
        }
        _ => ()
      }
      i = i + 1
    }
    if i - start >= 2 {
      match t[start] {
        Ident(name) => {
          let mut k = start + 1
          while k < i && tok_eq(t[k], Space) {
            k = k + 1
          }
          if k < i && tok_eq(t[k], Colon) {
            let mut vs = k + 1
            let mut ve = i
            while vs < ve && tok_eq(t[vs], Space) {
              vs = vs + 1
            }
            while ve > vs && tok_eq(t[ve - 1], Space) {
              ve = ve - 1
            }
            let mut important = false
            if ve - vs >= 2 {
              match t[ve - 1] {
                Ident(w) => {
                  if is_important_word(w) {
                    let mut j = ve - 2
                    while j >= vs && tok_eq(t[j], Space) {
                      j = j - 1
                    }
                    if j >= vs && tok_eq(t[j], Delim(33)) {
                      important = true
                      ve = j
                      while ve > vs && tok_eq(t[ve - 1], Space) {
                        ve = ve - 1
                      }
                    }
                  }
                }
                _ => ()
              }
            }
            let v = if vs >= ve { empty_toks } else { tok_slice(t, vs, ve) }
            let lname = if str_has_prefix(name, "--") { name } else { ascii_lower(name) }
            out.push(Decl::{ name: lname, value: v, important: important, longhands: None, var_memo: None })
          }
        }
        _ => ()
      }
    }
  }
  out
}

pub struct Stylesheet {
  pub rules : Array[Rule]
}

pub fn parse_stylesheet(s : String) -> Stylesheet {
  Stylesheet::{ rules: parse_rules(tokenize(s), true) }
}

pub struct Import {
  pub url : String
  pub layer : Option[String]
  pub supports : Array[Tok]
  pub media : Array[Tok]
}

pub fn imports_of(css : String) -> Array[String] {
  let rs = import_rules(css)
  let out : Array[String] = []
  let mut i = 0
  while i < rs.length() {
    out.push(rs[i].url)
    i = i + 1
  }
  out
}

fn has_at_import(css : String) -> Bool {
  let n = css.length()
  let mut i = 0
  while i < n {
    if css.code_unit_at(i) == 0x40 {
      if i + 1 < n && css.code_unit_at(i + 1) == 0x5C {
        return true
      }
      if i + 6 < n {
        let c1 = css.code_unit_at(i + 1) | 0x20
        let c2 = css.code_unit_at(i + 2) | 0x20
        let c3 = css.code_unit_at(i + 3) | 0x20
        let c4 = css.code_unit_at(i + 4) | 0x20
        let c5 = css.code_unit_at(i + 5) | 0x20
        let c6 = css.code_unit_at(i + 6) | 0x20
        if c1 == 0x69 && c2 == 0x6D && c3 == 0x70 && c4 == 0x6F && c5 == 0x72 && c6 == 0x74 {
          return true
        }
      }
    }
    i += 1
  }
  false
}

pub fn import_rules(css : String) -> Array[Import] {
  let out : Array[Import] = []
  if !has_at_import(css) {
    return out
  }
  let t = tokenize(css)
  let mut i = 0
  while i < t.length() {
    match t[i] {
      AtKeyword(k) => {
        if ascii_lower(k) == "import" {
          let mut j = i + 1
          let mut e = j
          let mut depth = 0
          while e < t.length() {
            match t[e] {
              OpenParen => depth = depth + 1
              Function(_) => depth = depth + 1
              OpenSquare => depth = depth + 1
              CloseParen => depth = depth - 1
              CloseSquare => depth = depth - 1
              Semicolon => {
                if depth == 0 {
                  break
                }
              }
              _ => ()
            }
            e = e + 1
          }
          while j < e && tok_eq(t[j], Space) {
            j = j + 1
          }
          let mut url : Option[String] = None
          if j < e {
            match t[j] {
              Str(u) => {
                url = Some(u)
                j = j + 1
              }
              Url(u) => {
                url = Some(u)
                j = j + 1
              }
              Function(f) => {
                if ascii_lower(f) == "url" && j + 1 < e {
                  match t[j + 1] {
                    Str(u) => {
                      url = Some(u)
                      j = group_end(t, j + 1) + 1
                    }
                    _ => ()
                  }
                }
              }
              _ => ()
            }
          }
          let mut layer : Option[String] = None
          let mut supports : Array[Tok] = []
          while j < e {
            match t[j] {
              Space => j = j + 1
              Ident(w) => {
                if ascii_lower(w) == "layer" && layer.is_none() {
                  layer = Some("")
                  j = j + 1
                } else {
                  break
                }
              }
              Function(f) => {
                let lf = ascii_lower(f)
                if lf == "layer" {
                  let g = group_end(t, j + 1)
                  let lns = layer_names(tok_slice(t, j + 1, g))
                  layer = Some(if lns.length() > 0 { lns[0] } else { "" })
                  j = g + 1
                } else if lf == "supports" {
                  let g = group_end(t, j + 1)
                  supports = tok_slice(t, j + 1, g)
                  j = g + 1
                } else {
                  break
                }
              }
              _ => break
            }
          }
          match url {
            Some(u) => out.push(Import::{
              url: u,
              layer: layer,
              supports: supports,
              media: trim(tok_slice(t, j, e)),
            })
            None => ()
          }
          i = e
        }
      }
      Ident(_) => break
      Hash(_, _) => break
      OpenCurly => break
      _ => ()
    }
    i = i + 1
  }
  out
}

fn anb_text(a : Int, c : Int) -> String {
  if a == 0 {
    return c.to_string()
  }
  let head = if a == 1 { "n" } else if a == -1 { "-n" } else { a.to_string() + "n" }
  if c > 0 {
    head + "+" + c.to_string()
  } else if c < 0 {
    head + c.to_string()
  } else {
    head
  }
}

fn is_selector_join_next(t : Array[Tok], idx : Int) -> Bool {
  if idx >= t.length() {
    return false
  }
  match t[idx] {
    Colon => true
    Delim(c) => c == 46
    Hash(_, _) => true
    OpenSquare => true
    _ => false
  }
}

fn spell(t : Array[Tok]) -> String {
  let b = StringBuilder::new()
  let mut skip_to = -1
  let mut i = 0
  while i < t.length() {
    if i <= skip_to {
      i = i + 1
      continue
    }
    let x = t[i]
    match x {
      Function(f) => {
        if str_has_prefix(ascii_lower(f), "nth-") {
          let e = group_end(t, i + 1)
          let inner = tok_slice(t, i + 1, e)
          let mut of_at = -1
          let mut k = 0
          while k < inner.length() {
            match inner[k] {
              Ident(w) => {
                if ascii_lower(w) == "of" {
                  of_at = k
                }
              }
              _ => ()
            }
            k = k + 1
          }
          let anb = if of_at >= 0 { tok_slice(inner, 0, of_at) } else { inner }
          match parse_anb(anb) {
            Some(ab) => {
              b.write_string(ascii_lower(f) + "(" + anb_text(ab.0, ab.1))
              if of_at >= 0 {
                b.write_string(" of " + spell(trim(tok_slice(inner, of_at + 1, inner.length()))))
              }
              b.write_char((41).unsafe_to_char())
              skip_to = e
              i = i + 1
              continue
            }
            None => ()
          }
        }
      }
      _ => ()
    }
    if tok_eq(x, Delim(42)) && !(i > 0 && tok_eq(t[i - 1], OpenSquare)) && i + 2 < t.length() && tok_eq(t[i + 1], Delim(124)) {
      let ok2 = match t[i + 2] {
        Delim(c) => c == 42
        Ident(_) => true
        _ => false
      }
      if ok2 {
        skip_to = i + 1
        if tok_eq(t[i + 2], Delim(42)) {
          if !is_selector_join_next(t, i + 3) {
            b.write_char((42).unsafe_to_char())
          }
          skip_to = i + 2
        }
        i = i + 1
        continue
      }
    }
    if tok_eq(x, Delim(124)) && i > 0 && tok_eq(t[i - 1], OpenSquare) {
      i = i + 1
      continue
    }
    if tok_eq(x, Delim(42)) && is_selector_join_next(t, i + 1) {
      i = i + 1
      continue
    }
    match x {
      Ident(s) => {
        if i > 0 && tok_eq(t[i - 1], Delim(61)) {
          b.write_string("\"" + s + "\"")
        } else {
          b.write_string(s)
        }
      }
      Hash(s, _) => b.write_string("#" + s)
      Delim(c) => write_utf8_cp(b, c)
      Colon => b.write_char((58).unsafe_to_char())
      Comma => b.write_string(", ")
      Space => {
        if i > 0 && i + 1 < t.length() {
          let prev_no = match t[i - 1] {
            Function(_) => true
            OpenParen => true
            Comma => true
            Space => true
            _ => false
          }
          let next_no = match t[i + 1] {
            CloseParen => true
            Comma => true
            Space => true
            _ => false
          }
          if !prev_no && !next_no {
            b.write_char((32).unsafe_to_char())
          }
        }
      }
      OpenSquare => b.write_char((91).unsafe_to_char())
      CloseSquare => b.write_char((93).unsafe_to_char())
      OpenParen => b.write_char((40).unsafe_to_char())
      CloseParen => b.write_char((41).unsafe_to_char())
      Function(s) => b.write_string(s + "(")
      Str(s) => b.write_string("\"" + s + "\"")
      Number(n) => b.write_string(fvdmath::d2i(n).to_string())
      Dimension(n, u) => b.write_string(fvdmath::d2i(n).to_string() + u)
      _ => ()
    }
    i = i + 1
  }
  b.to_string()
}

pub fn style_rule_selectors(css : String) -> Array[String] {
  let p = Parser::{ t: tokenize(css), i: 0 }
  let out : Array[String] = []
  while p.i < p.t.length() {
    if tok_eq(p.peek(), Space) {
      p.i = p.i + 1
      continue
    }
    let is_at = match p.peek() { AtKeyword(_) => true _ => false }
    match p.prelude(is_at) {
      Some(pb) => {
        let t = trim(pb.pre)
        if parse_selector_list(t).length() > 0 {
          out.push(spell(t))
        }
      }
      None => ()
    }
  }
  out
}

pub fn sheet_rules(css : String) -> Array[(Int, String, String)] {
  let p = Parser::{ t: tokenize(css), i: 0 }
  let out : Array[(Int, String, String)] = []
  while p.i < p.t.length() {
    if tok_eq(p.peek(), Space) {
      p.i = p.i + 1
      continue
    }
    let is_at = match p.peek() { AtKeyword(_) => true _ => false }
    match p.prelude(is_at) {
      Some(pb) => {
        let t = trim(pb.pre)
        let body_s = spell(trim(pb.body))
        if t.length() > 0 {
          match t[0] {
            AtKeyword(kw) => {
              let lkw = ascii_lower(kw)
              if lkw == "font-face" {
                out.push((5, "", "@font-face { " + body_s + " }"))
              }
            }
            _ => if parse_selector_list(t).length() > 0 {
              let sel = spell(t)
              out.push((1, sel, sel + " { " + body_s + " }"))
            }
          }
        }
      }
      None => ()
    }
  }
  out
}

struct NestedRule {
  pre : Array[Tok]
  body : Array[Tok]
}

enum NestedItem {
  Decls(Array[Tok])
  Nested(NestedRule)
}

fn split_nested_ordered(body : Array[Tok]) -> Array[NestedItem] {
  let items : Array[NestedItem] = []
  let decls : Array[Tok] = []
  let cur : Array[Tok] = []
  let mut i = 0
  let mut depth = 0
  while i < body.length() {
    let t = body[i]
    match t {
      OpenCurly => {
        if depth == 0 {
          if decls.length() > 0 {
            items.push(Decls(tok_copy(decls)))
            decls.clear()
          }
          let block : Array[Tok] = []
          let mut d = 1
          i = i + 1
          while i < body.length() {
            let u = body[i]
            match u {
              OpenCurly => d = d + 1
              CloseCurly => d = d - 1
              _ => ()
            }
            if d == 0 {
              break
            }
            block.push(u)
            i = i + 1
          }
          items.push(Nested(NestedRule::{ pre: trim(tok_copy(cur)), body: block }))
          cur.clear()
        } else {
          cur.push(t)
        }
      }
      Semicolon => {
        if depth == 0 {
          tok_append(decls, cur)
          decls.push(Semicolon)
          cur.clear()
        } else {
          cur.push(t)
        }
      }
      OpenParen => {
        depth = depth + 1
        cur.push(t)
      }
      OpenSquare => {
        depth = depth + 1
        cur.push(t)
      }
      Function(_) => {
        depth = depth + 1
        cur.push(t)
      }
      CloseParen => {
        depth = depth - 1
        cur.push(t)
      }
      CloseSquare => {
        depth = depth - 1
        cur.push(t)
      }
      _ => cur.push(t)
    }
    i = i + 1
  }
  tok_append(decls, cur)
  if decls.length() > 0 {
    items.push(Decls(decls))
  }
  items
}

struct SplitNested {
  decls : Array[Tok]
  nested : Array[NestedRule]
}

fn split_nested(body : Array[Tok]) -> SplitNested {
  let decls : Array[Tok] = []
  let nested : Array[NestedRule] = []
  let cur : Array[Tok] = []
  let mut i = 0
  let mut depth = 0
  while i < body.length() {
    let t = body[i]
    match t {
      OpenCurly => {
        if depth == 0 {
          let block : Array[Tok] = []
          let mut d = 1
          i = i + 1
          while i < body.length() {
            let u = body[i]
            match u {
              OpenCurly => d = d + 1
              CloseCurly => d = d - 1
              _ => ()
            }
            if d == 0 {
              break
            }
            block.push(u)
            i = i + 1
          }
          nested.push(NestedRule::{ pre: trim(tok_copy(cur)), body: block })
          cur.clear()
        } else {
          cur.push(t)
        }
      }
      Semicolon => {
        if depth == 0 {
          tok_append(decls, cur)
          decls.push(Semicolon)
          cur.clear()
        } else {
          cur.push(t)
        }
      }
      OpenParen => {
        depth = depth + 1
        cur.push(t)
      }
      OpenSquare => {
        depth = depth + 1
        cur.push(t)
      }
      Function(_) => {
        depth = depth + 1
        cur.push(t)
      }
      CloseParen => {
        depth = depth - 1
        cur.push(t)
      }
      CloseSquare => {
        depth = depth - 1
        cur.push(t)
      }
      _ => cur.push(t)
    }
    i = i + 1
  }
  tok_append(decls, cur)
  SplitNested::{ decls: decls, nested: nested }
}

fn nest_selector(parent : Array[Tok], inner : Array[Tok]) -> Array[Tok] {
  let wrapped : Array[Tok] = [Colon, Function("is")]
  tok_append(wrapped, parent)
  wrapped.push(CloseParen)
  let out : Array[Tok] = []
  let parts : Array[Array[Tok]] = []
  let part : Array[Tok] = []
  let mut depth = 0
  let mut i = 0
  while i < inner.length() {
    let t = inner[i]
    match t {
      Comma => {
        if depth == 0 {
          parts.push(tok_copy(part))
          part.clear()
          i = i + 1
          continue
        }
      }
      OpenParen => depth = depth + 1
      OpenSquare => depth = depth + 1
      Function(_) => depth = depth + 1
      CloseParen => depth = depth - 1
      CloseSquare => depth = depth - 1
      _ => ()
    }
    part.push(t)
    i = i + 1
  }
  parts.push(part)
  let mut k = 0
  while k < parts.length() {
    let p = trim(parts[k])
    if k > 0 {
      out.push(Comma)
    }
    let mut has_amp = false
    let mut j = 0
    while j < p.length() {
      if tok_eq(p[j], Delim(38)) {
        has_amp = true
        break
      }
      j = j + 1
    }
    if has_amp {
      j = 0
      while j < p.length() {
        if tok_eq(p[j], Delim(38)) {
          tok_append(out, wrapped)
        } else {
          out.push(p[j])
        }
        j = j + 1
      }
    } else {
      tok_append(out, wrapped)
      out.push(Space)
      tok_append(out, p)
    }
    k = k + 1
  }
  out
}

fn style_rules(pre : Array[Tok], body : Array[Tok]) -> Array[Rule] {
  let out : Array[Rule] = []
  let items = split_nested_ordered(body)
  let sel = parse_selector_list(pre)
  let mut ii = 0
  while ii < items.length() {
    match items[ii] {
      Decls(ds_toks) => {
        if sel.length() > 0 {
          let ds = parse_decls(ds_toks)
          if ds.length() > 0 {
            out.push(StyleRule(sel, ds))
          }
        }
      }
      Nested(n) => {
        if n.pre.length() > 0 {
          match n.pre[0] {
            AtKeyword(name) => {
              let rest = tok_slice(n.pre, 1, n.pre.length())
              let inner = style_rules(pre, n.body)
              let lname = ascii_lower(name)
              if lname == "media" {
                out.push(MediaRule(trim(rest), inner))
              } else if lname == "supports" {
                out.push(SupportsRule(trim(rest), inner))
              } else if lname == "layer" {
                let lns = layer_names(rest)
                let first_l = if lns.length() > 0 { lns[0] } else { "" }
                out.push(LayerRule([first_l], Some(inner)))
              } else if lname == "container" {
                let mq : Array[Tok] = [Ident(container_marker)]
                tok_append(mq, trim(rest))
                out.push(MediaRule(mq, inner))
              } else if lname == "scope" {
                out.push(MediaRule([], inner))
              }
            }
            _ => {
              let rs = style_rules(nest_selector(pre, n.pre), n.body)
              let mut ri = 0
              while ri < rs.length() {
                out.push(rs[ri])
                ri = ri + 1
              }
            }
          }
        } else {
          let rs = style_rules(nest_selector(pre, n.pre), n.body)
          let mut ri = 0
          while ri < rs.length() {
            out.push(rs[ri])
            ri = ri + 1
          }
        }
      }
    }
    ii = ii + 1
  }
  out
}

fn layer_names(t : Array[Tok]) -> Array[String] {
  let out : Array[String] = []
  let mut cur = StringBuilder::new()
  let mut i = 0
  while i < t.length() {
    match t[i] {
      Ident(w) => cur.write_string(w)
      Delim(c) => {
        if c == 46 {
          cur.write_char((46).unsafe_to_char())
        }
      }
      Comma => {
        let s = cur.to_string()
        if s.length() > 0 {
          out.push(s)
        }
        cur = StringBuilder::new()
      }
      Semicolon => {
        let s = cur.to_string()
        if s.length() > 0 {
          out.push(s)
        }
        cur = StringBuilder::new()
        break
      }
      _ => ()
    }
    i = i + 1
  }
  let s = cur.to_string()
  if s.length() > 0 {
    out.push(s)
  }
  out
}

fn apply_scope_limit(rules : Array[Rule], limit : Array[Selector]) -> Unit {
  let mut ri = 0
  while ri < rules.length() {
    match rules[ri] {
      StyleRule(sels, _) => {
        let mut si = 0
        while si < sels.length() {
          let sel = sels[si]
          if sel.parts.length() > 0 {
            sel.parts[0].compound.push(PseudoSel("not", limit))
          }
          si = si + 1
        }
      }
      MediaRule(_, inner) => apply_scope_limit(inner, limit)
      SupportsRule(_, inner) => apply_scope_limit(inner, limit)
      LayerRule(_, Some(inner)) => apply_scope_limit(inner, limit)
      _ => ()
    }
    ri = ri + 1
  }
}

fn rewrite_scope_pseudo(toks : Array[Tok], replacement : Array[Tok]) -> Array[Tok] {
  let out : Array[Tok] = []
  let mut k = 0
  while k < toks.length() {
    if tok_eq(toks[k], Colon) && k + 1 < toks.length() {
      match toks[k + 1] {
        Ident(w) => {
          if ascii_lower(w) == "scope" {
            tok_append(out, replacement)
            k = k + 2
            continue
          }
        }
        _ => ()
      }
    }
    out.push(toks[k])
    k = k + 1
  }
  out
}

fn scope_body_rules(implicit : Bool, root : Array[Tok], body : Array[Tok]) -> Array[Rule] {
  let sn = split_nested(body)
  let out : Array[Rule] = []
  let ds = parse_decls(sn.decls)
  if ds.length() > 0 && !implicit {
    let sel = parse_selector_list(root)
    if sel.length() > 0 {
      out.push(StyleRule(sel, ds))
    }
  }
  let mut ni = 0
  while ni < sn.nested.length() {
    let n = sn.nested[ni]
    let at_name : Option[String] = if n.pre.length() > 0 {
      match n.pre[0] { AtKeyword(nm) => Some(nm) _ => None }
    } else {
      None
    }
    match at_name {
      Some(name) => {
        let rest = tok_slice(n.pre, 1, n.pre.length())
        let lname = ascii_lower(name)
        if lname == "media" {
          out.push(MediaRule(trim(rest), scope_body_rules(implicit, root, n.body)))
        } else if lname == "supports" {
          out.push(SupportsRule(trim(rest), scope_body_rules(implicit, root, n.body)))
        } else if lname == "layer" {
          let lns = layer_names(rest)
          let first_l = if lns.length() > 0 { lns[0] } else { "" }
          out.push(LayerRule([first_l], Some(scope_body_rules(implicit, root, n.body))))
        } else if lname == "container" {
          let mq : Array[Tok] = [Ident(container_marker)]
          tok_append(mq, trim(rest))
          out.push(MediaRule(mq, scope_body_rules(implicit, root, n.body)))
        } else if lname == "scope" {
          let nested_pre = if implicit {
            rest
          } else {
            // Rewrite :scope in nested @scope prelude to outer root and scope its root selector
            let rewritten = rewrite_scope_pseudo(rest, root)
            let trew = trim(rewritten)
            if trew.length() > 0 && tok_eq(trew[0], OpenParen) {
              let e = group_end(trew, 1)
              let inner_root = trim(tok_slice(trew, 1, e))
              let combined = nest_selector(root, rewrite_scope_pseudo(inner_root, [Delim(38)]))
              let built : Array[Tok] = [OpenParen]
              tok_append(built, combined)
              built.push(CloseParen)
              tok_append(built, tok_slice(trew, e + 1, trew.length()))
              built
            } else {
              rewritten
            }
          }
          let sr = scope_rules(nested_pre, n.body)
          let mut ri = 0
          while ri < sr.length() {
            out.push(sr[ri])
            ri = ri + 1
          }
        } else if lname == "keyframes" || lname == "-webkit-keyframes" {
          let tp = trim(rest)
          if tp.length() == 1 {
            match tp[0] {
              Ident(kn) => out.push(KeyframesRule(kn, keyframes_of(n.body)))
              Str(kn) => out.push(KeyframesRule(kn, keyframes_of(n.body)))
              _ => ()
            }
          }
        }
      }
      None => {
        let rel = rewrite_scope_pseudo(n.pre, [Delim(38)])
        if implicit {
          match implicit_scoped(rel) {
            Some(sel) => {
              let rs = style_rules(sel, n.body)
              let mut ri = 0
              while ri < rs.length() {
                out.push(rs[ri])
                ri = ri + 1
              }
            }
            None => ()
          }
        } else {
          let rs = style_rules(nest_selector(root, rel), n.body)
          let mut ri = 0
          while ri < rs.length() {
            out.push(rs[ri])
            ri = ri + 1
          }
        }
      }
    }
    ni = ni + 1
  }
  out
}

fn scope_rules(pre : Array[Tok], body : Array[Tok]) -> Array[Rule] {
  let groups : Array[Array[Tok]] = []
  let mut i = 0
  while i < pre.length() {
    if tok_eq(pre[i], OpenParen) {
      let e = group_end(pre, i + 1)
      groups.push(tok_slice(pre, i + 1, e))
      i = e + 1
    } else {
      i = i + 1
    }
  }
  let tpre = trim(pre)
  let implicit = !(tpre.length() > 0 && tok_eq(tpre[0], OpenParen))
  let root : Array[Tok] = if implicit {
    []
  } else {
    let w : Array[Tok] = [Colon, Function("where")]
    if groups.length() > 0 {
      tok_append(w, trim(groups[0]))
    }
    w.push(CloseParen)
    w
  }
  let limit_idx = if implicit { 0 } else { 1 }
  let limit : Array[Selector] = if limit_idx < groups.length() {
    let lim : Array[Tok] = [Colon, Function("where")]
    tok_append(lim, trim(groups[limit_idx]))
    lim.push(CloseParen)
    let list : Array[Tok] = []
    tok_append(list, root)
    if !implicit {
      list.push(Space)
    }
    tok_append(list, lim)
    list.push(Comma)
    tok_append(list, root)
    if !implicit {
      list.push(Space)
    }
    tok_append(list, lim)
    list.push(Space)
    list.push(Delim(42))
    parse_selector_list(list)
  } else {
    []
  }
  let out = scope_body_rules(implicit, root, body)
  if limit.length() > 0 {
    apply_scope_limit(out, limit)
  }
  out
}

fn implicit_scoped(sel : Array[Tok]) -> Option[Array[Tok]] {
  let parts : Array[Array[Tok]] = []
  let part : Array[Tok] = []
  let mut depth = 0
  let mut i = 0
  while i < sel.length() {
    let t = sel[i]
    match t {
      Comma => {
        if depth == 0 {
          parts.push(tok_copy(part))
          part.clear()
          i = i + 1
          continue
        }
      }
      OpenParen => depth = depth + 1
      OpenSquare => depth = depth + 1
      Function(_) => depth = depth + 1
      CloseParen => depth = depth - 1
      CloseSquare => depth = depth - 1
      _ => ()
    }
    part.push(t)
    i = i + 1
  }
  parts.push(part)
  let out : Array[Tok] = []
  let mut pi = 0
  while pi < parts.length() {
    let mut p = trim(parts[pi])
    if p.length() > 0 && tok_eq(p[0], Delim(38)) {
      p = trim(tok_slice(p, 1, p.length()))
      if p.length() == 0 {
        pi = pi + 1
        continue
      }
    }
    if p.length() > 0 && tok_eq(p[0], Delim(62)) {
      p = trim(tok_slice(p, 1, p.length()))
      let mut k = 0
      let mut d = 0
      while k < p.length() {
        match p[k] {
          OpenParen => d = d + 1
          OpenSquare => d = d + 1
          Function(_) => d = d + 1
          CloseParen => d = d - 1
          CloseSquare => d = d - 1
          Space => { if d == 0 { break } }
          Delim(c) => {
            if d == 0 && (c == 62 || c == 43 || c == 126) {
              break
            }
          }
          _ => ()
        }
        k = k + 1
      }
      let q = tok_slice(p, 0, k)
      q.push(Colon)
      q.push(Ident("root"))
      tok_append(q, tok_slice(p, k, p.length()))
      p = q
    }
    if out.length() > 0 {
      out.push(Comma)
    }
    tok_append(out, p)
    pi = pi + 1
  }
  if out.length() == 0 { None } else { Some(out) }
}
