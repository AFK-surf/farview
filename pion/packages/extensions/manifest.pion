///| Chrome Manifest V3 parser (`manifest.json`).
///| Strictly requires `manifest_version == 3`.

import "url"

pub enum ExtJson {
  EJNull
  EJBool(Bool)
  EJInt(Int)
  EJStr(String)
  EJArr(Array[ExtJson])
  EJObj(Map[String, ExtJson])
}

struct ExtJsonParser {
  s : String
  n : Int
  mut pos : Int
}

fn ExtJsonParser::skip_ws(self : ExtJsonParser) -> Unit {
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn ExtJsonParser::parse_str(self : ExtJsonParser) -> Option[String] {
  if self.pos >= self.n || self.s.code_unit_at(self.pos) != 34 {
    return None
  }
  self.pos = self.pos + 1
  let out = StringBuilder::new()
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 34 {
      self.pos = self.pos + 1
      return Some(out.to_string())
    }
    if c == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.n {
        return None
      }
      let e = self.s.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if e == 34 {
        out.write_string("\"")
      } else if e == 92 {
        out.write_string("\\")
      } else if e == 47 {
        out.write_string("/")
      } else if e == 110 {
        out.write_string("\n")
      } else if e == 114 {
        out.write_string("\r")
      } else if e == 116 {
        out.write_string("\t")
      } else {
        out.write_string(self.s.slice(self.pos - 1, self.pos))
      }
    } else {
      out.write_string(self.s.slice(self.pos, self.pos + 1))
      self.pos = self.pos + 1
    }
  }
  None
}

fn ExtJsonParser::parse_val(self : ExtJsonParser, depth : Int) -> Option[ExtJson] {
  if depth > 64 {
    return None
  }
  self.skip_ws()
  if self.pos >= self.n {
    return None
  }
  let c = self.s.code_unit_at(self.pos)
  if c == 34 {
    match self.parse_str() {
      Some(v) => Some(EJStr(v))
      None => None
    }
  } else if c == 123 {
    self.pos = self.pos + 1
    let m : Map[String, ExtJson] = Map::new()
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
      self.pos = self.pos + 1
      return Some(EJObj(m))
    }
    while self.pos < self.n {
      self.skip_ws()
      let k = match self.parse_str() {
        Some(ks) => ks
        None => return None
      }
      self.skip_ws()
      if self.pos >= self.n || self.s.code_unit_at(self.pos) != 58 {
        return None
      }
      self.pos = self.pos + 1
      let v = match self.parse_val(depth + 1) {
        Some(vv) => vv
        None => return None
      }
      m.set(k, v)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
        self.pos = self.pos + 1
        return Some(EJObj(m))
      }
      return None
    }
    None
  } else if c == 91 {
    self.pos = self.pos + 1
    let arr : Array[ExtJson] = []
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
      self.pos = self.pos + 1
      return Some(EJArr(arr))
    }
    while self.pos < self.n {
      let v = match self.parse_val(depth + 1) {
        Some(vv) => vv
        None => return None
      }
      arr.push(v)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
        self.pos = self.pos + 1
        return Some(EJArr(arr))
      }
      return None
    }
    None
  } else if c == 116 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "true" {
    self.pos = self.pos + 4
    Some(EJBool(true))
  } else if c == 102 && self.pos + 5 <= self.n && self.s.slice(self.pos, self.pos + 5) == "false" {
    self.pos = self.pos + 5
    Some(EJBool(false))
  } else if c == 110 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "null" {
    self.pos = self.pos + 4
    Some(EJNull)
  } else if c == 45 || (c >= 48 && c <= 57) {
    let mut neg = false
    if c == 45 {
      neg = true
      self.pos = self.pos + 1
    }
    let mut acc = 0
    let mut digits = 0
    while self.pos < self.n {
      let d = self.s.code_unit_at(self.pos)
      if d >= 48 && d <= 57 {
        acc = acc * 10 + (d - 48)
        digits = digits + 1
        self.pos = self.pos + 1
      } else {
        break
      }
    }
    if digits == 0 {
      return None
    }
    Some(EJInt(if neg { 0 - acc } else { acc }))
  } else {
    None
  }
}

pub fn ext_json_parse(s : String) -> Option[ExtJson] {
  let p = ExtJsonParser::{ s: s, n: s.length(), pos: 0 }
  p.parse_val(0)
}

pub fn ej_get(v : ExtJson, k : String) -> Option[ExtJson] {
  match v {
    EJObj(m) => m.get(k)
    _ => None
  }
}

pub fn ej_str(v : ExtJson, k : String) -> String {
  match ej_get(v, k) {
    Some(EJStr(s)) => s
    _ => ""
  }
}

pub fn ej_int(v : ExtJson, k : String, def : Int) -> Int {
  match ej_get(v, k) {
    Some(EJInt(n)) => n
    _ => def
  }
}

pub fn ej_bool(v : ExtJson, k : String, def : Bool) -> Bool {
  match ej_get(v, k) {
    Some(EJBool(b)) => b
    _ => def
  }
}

pub fn ej_str_array(v : ExtJson, k : String) -> Array[String] {
  let out : Array[String] = []
  match ej_get(v, k) {
    Some(EJArr(items)) => {
      for it in items {
        match it {
          EJStr(s) => out.push(s)
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

pub struct ContentScriptSpec {
  pub matches : Array[String]
  pub exclude_matches : Array[String]
  pub js : Array[String]
  pub css : Array[String]
  pub run_at : String
}

pub struct DnrRuleResource {
  pub id : String
  pub enabled : Bool
  pub path : String
}

///| One `{size: path}` entry of `icons` / `action.default_icon` (`size` 0 for the single-string form).
pub struct ExtIcon {
  pub size : Int
  pub path : String
}

///| MV3 `action` (toolbar button): `default_title`, `default_popup`, `default_icon`.
pub struct ExtensionAction {
  pub present : Bool
  pub default_title : String
  pub default_popup : String
  pub default_icon : Array[ExtIcon]
}

///| MV3 `web_accessible_resources` entry (`{resources, matches, extension_ids, use_dynamic_url}`).
pub struct WebAccessibleResource {
  pub resources : Array[String]
  pub matches : Array[String]
  pub extension_ids : Array[String]
}

pub struct ManifestV3 {
  pub manifest_version : Int
  pub name : String
  pub version : String
  pub description : String
  pub permissions : Array[String]
  pub optional_permissions : Array[String]
  pub host_permissions : Array[String]
  pub content_scripts : Array[ContentScriptSpec]
  pub dnr_rule_resources : Array[DnrRuleResource]
  pub background_service_worker : String
  pub background_type : String
  pub action : ExtensionAction
  pub icons : Array[ExtIcon]
  ///| `options_ui.page` when given, else `options_page` ("" when none)
  pub options_page : String
  ///| `options_ui.open_in_tab` (`options_page` always opens in a tab)
  pub options_open_in_tab : Bool
  pub web_accessible_resources : Array[WebAccessibleResource]
  pub raw_json : String
}

fn ej_icons(v : Option[ExtJson]) -> Array[ExtIcon] {
  let out : Array[ExtIcon] = []
  match v {
    Some(EJStr(p)) => if p != "" { out.push(ExtIcon::{ size: 0, path: p }) }
    Some(EJObj(m)) => {
      for k in m.keys() {
        match m.get(k) {
          Some(EJStr(p)) if p != "" => {
            let mut n = 0
            let mut ok = k.length() > 0
            let mut i = 0
            while i < k.length() {
              let c = k.code_unit_at(i)
              if c < 48 || c > 57 {
                ok = false
                break
              }
              n = n * 10 + (c - 48)
              i = i + 1
            }
            out.push(ExtIcon::{ size: if ok { n } else { 0 }, path: p })
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  // ascending by size (insertion sort; icon maps are tiny)
  let mut i = 1
  while i < out.length() {
    let cur = out[i]
    let mut j = i - 1
    while j >= 0 && out[j].size > cur.size {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    i = i + 1
  }
  out
}

///| The icon whose size is the smallest at or above `want` (else the largest), "" when there is none.
pub fn ext_pick_icon(icons : Array[ExtIcon], want : Int) -> String {
  if icons.length() == 0 {
    return ""
  }
  for ic in icons {
    if ic.size >= want {
      return ic.path
    }
  }
  icons[icons.length() - 1].path
}

///| The toolbar icon path (`action.default_icon`, falling back to `icons`) nearest `want` px.
pub fn ManifestV3::toolbar_icon(self : ManifestV3, want : Int) -> String {
  let p = ext_pick_icon(self.action.default_icon, want)
  if p != "" {
    p
  } else {
    ext_pick_icon(self.icons, want)
  }
}

///| The toolbar title: `action.default_title`, else the extension's name.
pub fn ManifestV3::action_title(self : ManifestV3) -> String {
  if self.action.default_title != "" {
    self.action.default_title
  } else {
    self.name
  }
}

///| Whether `path` (relative to the extension root) is web accessible to a page at `page_url`.
pub fn ManifestV3::is_web_accessible(self : ManifestV3, path : String, page_url : String) -> Bool {
  let rel = if path.starts_with("/") { path.slice(1, path.length()) } else { path }
  for war in self.web_accessible_resources {
    let mut hit = false
    for pat in war.resources {
      let p = if pat.starts_with("/") { pat.slice(1, pat.length()) } else { pat }
      if glob_match(p, rel) {
        hit = true
        break
      }
    }
    if !hit {
      continue
    }
    if war.matches.length() == 0 {
      // MV2-style plain list (or extension_ids only): reachable from any page
      return war.extension_ids.length() == 0
    }
    for m in war.matches {
      if match_url_pattern(m, page_url) {
        return true
      }
    }
  }
  false
}

///| A manifest-relative path without its leading `/` or `./`, query or fragment.
pub fn ext_clean_rel(p : String) -> String {
  let mut s = p.trim()
  while s.starts_with("/") || s.starts_with("./") {
    s = if s.starts_with("/") { s.slice(1, s.length()) } else { s.slice(2, s.length()) }
  }
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 63 || c == 35 {
      return s.slice(0, i)
    }
    i = i + 1
  }
  s
}

pub fn parse_manifest_v3(raw_json : String) -> Result[ManifestV3, String] {
  let root = match ext_json_parse(raw_json) {
    Some(v) => v
    None => return Err("invalid manifest.json: JSON parse error")
  }
  let mv = ej_int(root, "manifest_version", 0)
  if mv != 3 {
    return Err("unsupported manifest_version: expected 3, got " + mv.to_string())
  }
  let name = ej_str(root, "name")
  if name == "" {
    return Err("manifest.json missing required field: name")
  }
  let version = ej_str(root, "version")
  if version == "" {
    return Err("manifest.json missing required field: version")
  }
  let permissions = ej_str_array(root, "permissions")
  let host_permissions = ej_str_array(root, "host_permissions")

  let content_scripts : Array[ContentScriptSpec] = []
  match ej_get(root, "content_scripts") {
    Some(EJArr(items)) => {
      for it in items {
        let matches = ej_str_array(it, "matches")
        let exclude_matches = ej_str_array(it, "exclude_matches")
        let js = ej_str_array(it, "js")
        let css = ej_str_array(it, "css")
        let raw_run = ej_str(it, "run_at")
        let run_at = if raw_run == "document_start" || raw_run == "document_end" || raw_run == "document_idle" {
          raw_run
        } else {
          "document_idle"
        }
        content_scripts.push(ContentScriptSpec::{
          matches: matches,
          exclude_matches: exclude_matches,
          js: js,
          css: css,
          run_at: run_at,
        })
      }
    }
    _ => ()
  }

  let dnr_rule_resources : Array[DnrRuleResource] = []
  match ej_get(root, "declarative_net_request") {
    Some(dnr_obj) => {
      match ej_get(dnr_obj, "rule_resources") {
        Some(EJArr(items)) => {
          for it in items {
            let rid = ej_str(it, "id")
            let enabled = ej_bool(it, "enabled", true)
            let path = ej_str(it, "path")
            if rid != "" && path != "" {
              dnr_rule_resources.push(DnrRuleResource::{ id: rid, enabled: enabled, path: path })
            }
          }
        }
        _ => ()
      }
    }
    None => ()
  }

  let mut background_service_worker = ""
  let mut background_type = "classic"
  match ej_get(root, "background") {
    Some(bg_obj) => {
      background_service_worker = ej_str(bg_obj, "service_worker")
      let bt = ej_str(bg_obj, "type")
      if bt == "module" {
        background_type = "module"
      }
    }
    None => ()
  }

  let action = match ej_get(root, "action") {
    Some(a) if a is EJObj(_) =>
    ExtensionAction::{
      present: true,
      default_title: ej_str(a, "default_title"),
      default_popup: ext_clean_rel(ej_str(a, "default_popup")),
      default_icon: ej_icons(ej_get(a, "default_icon")),
    }
    _ => ExtensionAction::{ present: false, default_title: "", default_popup: "", default_icon: [] }
  }
  let mut options_page = ext_clean_rel(ej_str(root, "options_page"))
  let mut options_open_in_tab = options_page != ""
  match ej_get(root, "options_ui") {
    Some(ou) if ou is EJObj(_) => {
      let p = ext_clean_rel(ej_str(ou, "page"))
      if p != "" {
        options_page = p
        options_open_in_tab = ej_bool(ou, "open_in_tab", false)
      }
    }
    _ => ()
  }
  let wars : Array[WebAccessibleResource] = []
  match ej_get(root, "web_accessible_resources") {
    Some(EJArr(items)) => {
      let plain : Array[String] = []
      for it in items {
        match it {
          EJStr(p) => plain.push(p)
          EJObj(_) => {
            wars.push(WebAccessibleResource::{
              resources: ej_str_array(it, "resources"),
              matches: ej_str_array(it, "matches"),
              extension_ids: ej_str_array(it, "extension_ids"),
            })
          }
          _ => ()
        }
      }
      if plain.length() > 0 {
        wars.push(WebAccessibleResource::{ resources: plain, matches: [], extension_ids: [] })
      }
    }
    _ => ()
  }

  Ok(ManifestV3::{
    manifest_version: 3,
    name: name,
    version: version,
    description: ej_str(root, "description"),
    permissions: permissions,
    optional_permissions: ej_str_array(root, "optional_permissions"),
    host_permissions: host_permissions,
    content_scripts: content_scripts,
    dnr_rule_resources: dnr_rule_resources,
    background_service_worker: background_service_worker,
    background_type: background_type,
    action: action,
    icons: ej_icons(ej_get(root, "icons")),
    options_page: options_page,
    options_open_in_tab: options_open_in_tab,
    web_accessible_resources: wars,
    raw_json: raw_json,
  })
}

pub fn ContentScriptSpec::matches_url(self : ContentScriptSpec, raw_url : String) -> Bool {
  // Judge the WHATWG-canonical URL so `https://evil.test\@good.example/` is seen as evil.test.
  let url = match url::parse_url(raw_url) {
    Some(u) => url::url_href(u, true)
    None => return false
  }
  let mut matched = false
  for pat in self.matches {
    if match_url_pattern(pat, url) {
      matched = true
      break
    }
  }
  if !matched {
    return false
  }
  for ex in self.exclude_matches {
    if match_url_pattern(ex, url) {
      return false
    }
  }
  true
}
