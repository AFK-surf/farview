///| Chrome Manifest V3 parser (`manifest.json`).
///| Strictly requires `manifest_version == 3`.

pub enum ExtJson {
  EJNull
  EJBool(Bool)
  EJInt(Int)
  EJStr(String)
  EJArr(Array[ExtJson])
  EJObj(Map[String, ExtJson])
}

struct ExtJsonParser {
  s : String
  n : Int
  mut pos : Int
}

fn ExtJsonParser::skip_ws(self : ExtJsonParser) -> Unit {
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn ExtJsonParser::parse_str(self : ExtJsonParser) -> Option[String] {
  if self.pos >= self.n || self.s.code_unit_at(self.pos) != 34 {
    return None
  }
  self.pos = self.pos + 1
  let out = StringBuilder::new()
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 34 {
      self.pos = self.pos + 1
      return Some(out.to_string())
    }
    if c == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.n {
        return None
      }
      let e = self.s.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if e == 34 {
        out.write_string("\"")
      } else if e == 92 {
        out.write_string("\\")
      } else if e == 47 {
        out.write_string("/")
      } else if e == 110 {
        out.write_string("\n")
      } else if e == 114 {
        out.write_string("\r")
      } else if e == 116 {
        out.write_string("\t")
      } else {
        out.write_string(self.s.slice(self.pos - 1, self.pos))
      }
    } else {
      out.write_string(self.s.slice(self.pos, self.pos + 1))
      self.pos = self.pos + 1
    }
  }
  None
}

fn ExtJsonParser::parse_val(self : ExtJsonParser, depth : Int) -> Option[ExtJson] {
  if depth > 64 {
    return None
  }
  self.skip_ws()
  if self.pos >= self.n {
    return None
  }
  let c = self.s.code_unit_at(self.pos)
  if c == 34 {
    match self.parse_str() {
      Some(v) => Some(EJStr(v))
      None => None
    }
  } else if c == 123 {
    self.pos = self.pos + 1
    let m : Map[String, ExtJson] = Map::new()
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
      self.pos = self.pos + 1
      return Some(EJObj(m))
    }
    while self.pos < self.n {
      self.skip_ws()
      let k = match self.parse_str() {
        Some(ks) => ks
        None => return None
      }
      self.skip_ws()
      if self.pos >= self.n || self.s.code_unit_at(self.pos) != 58 {
        return None
      }
      self.pos = self.pos + 1
      let v = match self.parse_val(depth + 1) {
        Some(vv) => vv
        None => return None
      }
      m.set(k, v)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
        self.pos = self.pos + 1
        return Some(EJObj(m))
      }
      return None
    }
    None
  } else if c == 91 {
    self.pos = self.pos + 1
    let arr : Array[ExtJson] = []
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
      self.pos = self.pos + 1
      return Some(EJArr(arr))
    }
    while self.pos < self.n {
      let v = match self.parse_val(depth + 1) {
        Some(vv) => vv
        None => return None
      }
      arr.push(v)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
        self.pos = self.pos + 1
        return Some(EJArr(arr))
      }
      return None
    }
    None
  } else if c == 116 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "true" {
    self.pos = self.pos + 4
    Some(EJBool(true))
  } else if c == 102 && self.pos + 5 <= self.n && self.s.slice(self.pos, self.pos + 5) == "false" {
    self.pos = self.pos + 5
    Some(EJBool(false))
  } else if c == 110 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "null" {
    self.pos = self.pos + 4
    Some(EJNull)
  } else if c == 45 || (c >= 48 && c <= 57) {
    let mut neg = false
    if c == 45 {
      neg = true
      self.pos = self.pos + 1
    }
    let mut acc = 0
    let mut digits = 0
    while self.pos < self.n {
      let d = self.s.code_unit_at(self.pos)
      if d >= 48 && d <= 57 {
        acc = acc * 10 + (d - 48)
        digits = digits + 1
        self.pos = self.pos + 1
      } else {
        break
      }
    }
    if digits == 0 {
      return None
    }
    Some(EJInt(if neg { 0 - acc } else { acc }))
  } else {
    None
  }
}

pub fn ext_json_parse(s : String) -> Option[ExtJson] {
  let p = ExtJsonParser::{ s: s, n: s.length(), pos: 0 }
  p.parse_val(0)
}

pub fn ej_get(v : ExtJson, k : String) -> Option[ExtJson] {
  match v {
    EJObj(m) => m.get(k)
    _ => None
  }
}

pub fn ej_str(v : ExtJson, k : String) -> String {
  match ej_get(v, k) {
    Some(EJStr(s)) => s
    _ => ""
  }
}

pub fn ej_int(v : ExtJson, k : String, def : Int) -> Int {
  match ej_get(v, k) {
    Some(EJInt(n)) => n
    _ => def
  }
}

pub fn ej_bool(v : ExtJson, k : String, def : Bool) -> Bool {
  match ej_get(v, k) {
    Some(EJBool(b)) => b
    _ => def
  }
}

pub fn ej_str_array(v : ExtJson, k : String) -> Array[String] {
  let out : Array[String] = []
  match ej_get(v, k) {
    Some(EJArr(items)) => {
      for it in items {
        match it {
          EJStr(s) => out.push(s)
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

pub struct ContentScriptSpec {
  pub matches : Array[String]
  pub exclude_matches : Array[String]
  pub js : Array[String]
  pub css : Array[String]
  pub run_at : String
}

pub struct DnrRuleResource {
  pub id : String
  pub enabled : Bool
  pub path : String
}

pub struct ManifestV3 {
  pub manifest_version : Int
  pub name : String
  pub version : String
  pub permissions : Array[String]
  pub host_permissions : Array[String]
  pub content_scripts : Array[ContentScriptSpec]
  pub dnr_rule_resources : Array[DnrRuleResource]
  pub background_service_worker : String
  pub background_type : String
  pub raw_json : String
}

pub fn parse_manifest_v3(raw_json : String) -> Result[ManifestV3, String] {
  let root = match ext_json_parse(raw_json) {
    Some(v) => v
    None => return Err("invalid manifest.json: JSON parse error")
  }
  let mv = ej_int(root, "manifest_version", 0)
  if mv != 3 {
    return Err("unsupported manifest_version: expected 3, got " + mv.to_string())
  }
  let name = ej_str(root, "name")
  if name == "" {
    return Err("manifest.json missing required field: name")
  }
  let version = ej_str(root, "version")
  if version == "" {
    return Err("manifest.json missing required field: version")
  }
  let permissions = ej_str_array(root, "permissions")
  let host_permissions = ej_str_array(root, "host_permissions")

  let content_scripts : Array[ContentScriptSpec] = []
  match ej_get(root, "content_scripts") {
    Some(EJArr(items)) => {
      for it in items {
        let matches = ej_str_array(it, "matches")
        let exclude_matches = ej_str_array(it, "exclude_matches")
        let js = ej_str_array(it, "js")
        let css = ej_str_array(it, "css")
        let raw_run = ej_str(it, "run_at")
        let run_at = if raw_run == "document_start" || raw_run == "document_end" || raw_run == "document_idle" {
          raw_run
        } else {
          "document_idle"
        }
        content_scripts.push(ContentScriptSpec::{
          matches: matches,
          exclude_matches: exclude_matches,
          js: js,
          css: css,
          run_at: run_at,
        })
      }
    }
    _ => ()
  }

  let dnr_rule_resources : Array[DnrRuleResource] = []
  match ej_get(root, "declarative_net_request") {
    Some(dnr_obj) => {
      match ej_get(dnr_obj, "rule_resources") {
        Some(EJArr(items)) => {
          for it in items {
            let rid = ej_str(it, "id")
            let enabled = ej_bool(it, "enabled", true)
            let path = ej_str(it, "path")
            if rid != "" && path != "" {
              dnr_rule_resources.push(DnrRuleResource::{ id: rid, enabled: enabled, path: path })
            }
          }
        }
        _ => ()
      }
    }
    None => ()
  }

  let mut background_service_worker = ""
  let mut background_type = "classic"
  match ej_get(root, "background") {
    Some(bg_obj) => {
      background_service_worker = ej_str(bg_obj, "service_worker")
      let bt = ej_str(bg_obj, "type")
      if bt == "module" {
        background_type = "module"
      }
    }
    None => ()
  }

  Ok(ManifestV3::{
    manifest_version: 3,
    name: name,
    version: version,
    permissions: permissions,
    host_permissions: host_permissions,
    content_scripts: content_scripts,
    dnr_rule_resources: dnr_rule_resources,
    background_service_worker: background_service_worker,
    background_type: background_type,
    raw_json: raw_json,
  })
}

pub fn ContentScriptSpec::matches_url(self : ContentScriptSpec, url : String) -> Bool {
  let mut matched = false
  for pat in self.matches {
    if match_url_pattern(pat, url) {
      matched = true
      break
    }
  }
  if !matched {
    return false
  }
  for ex in self.exclude_matches {
    if match_url_pattern(ex, url) {
      return false
    }
  }
  true
}
