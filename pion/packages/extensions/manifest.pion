///| Chrome Manifest V3 parser (`manifest.json`).
///| Strictly requires `manifest_version == 3`.

import "url"

pub enum ExtJson {
  EJNull
  EJBool(Bool)
  EJInt(Int)
  EJFloat(Double)
  EJStr(String)
  EJArr(Array[ExtJson])
  EJObj(Map[String, ExtJson])
}

struct ExtJsonParser {
  s : String
  n : Int
  mut pos : Int
}

fn ExtJsonParser::skip_ws(self : ExtJsonParser) -> Unit {
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      self.pos = self.pos + 1
    } else {
      break
    }
  }
}

fn hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn write_utf8_cp(out : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    let b = Bytes::new(1)
    b[0] = cp.to_byte()
    out.write_string(b.to_string())
  } else if cp < 0x800 {
    let b = Bytes::new(2)
    b[0] = (0xC0 | (cp >> 6)).to_byte()
    b[1] = (0x80 | (cp & 0x3F)).to_byte()
    out.write_string(b.to_string())
  } else if cp < 0x10000 {
    let b = Bytes::new(3)
    b[0] = (0xE0 | (cp >> 12)).to_byte()
    b[1] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
    b[2] = (0x80 | (cp & 0x3F)).to_byte()
    out.write_string(b.to_string())
  } else {
    let b = Bytes::new(4)
    b[0] = (0xF0 | (cp >> 18)).to_byte()
    b[1] = (0x80 | ((cp >> 12) & 0x3F)).to_byte()
    b[2] = (0x80 | ((cp >> 6) & 0x3F)).to_byte()
    b[3] = (0x80 | (cp & 0x3F)).to_byte()
    out.write_string(b.to_string())
  }
}

fn ExtJsonParser::parse_hex4(self : ExtJsonParser) -> Int {
  if self.pos + 4 > self.n {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < 4 {
    let v = hex_val(self.s.code_unit_at(self.pos + i).to_int())
    if v < 0 {
      return -1
    }
    acc = (acc << 4) | v
    i += 1
  }
  self.pos = self.pos + 4
  acc
}

fn ExtJsonParser::parse_str(self : ExtJsonParser) -> Option[String] {
  if self.pos >= self.n || self.s.code_unit_at(self.pos) != 34 {
    return None
  }
  self.pos = self.pos + 1
  let out = StringBuilder::new()
  while self.pos < self.n {
    let c = self.s.code_unit_at(self.pos)
    if c == 34 {
      self.pos = self.pos + 1
      return Some(out.to_string())
    }
    if c == 92 {
      self.pos = self.pos + 1
      if self.pos >= self.n {
        return None
      }
      let e = self.s.code_unit_at(self.pos)
      self.pos = self.pos + 1
      if e == 34 {
        out.write_string("\"")
      } else if e == 92 {
        out.write_string("\\")
      } else if e == 47 {
        out.write_string("/")
      } else if e == 110 {
        out.write_string("\n")
      } else if e == 114 {
        out.write_string("\r")
      } else if e == 116 {
        out.write_string("\t")
      } else if e == 98 {
        write_utf8_cp(out, 8)
      } else if e == 102 {
        write_utf8_cp(out, 12)
      } else if e == 117 {
        let u1 = self.parse_hex4()
        if u1 < 0 {
          return None
        }
        if u1 >= 0xD800 && u1 <= 0xDBFF && self.pos + 6 <= self.n &&
        self.s.code_unit_at(self.pos) == 92 && self.s.code_unit_at(self.pos + 1) == 117 {
          let save = self.pos
          self.pos = self.pos + 2
          let u2 = self.parse_hex4()
          if u2 >= 0xDC00 && u2 <= 0xDFFF {
            write_utf8_cp(out, 0x10000 + ((u1 - 0xD800) << 10) + (u2 - 0xDC00))
          } else {
            self.pos = save
            write_utf8_cp(out, 0xFFFD)
          }
        } else {
          write_utf8_cp(out, u1)
        }
      } else {
        out.write_string(self.s.slice(self.pos - 1, self.pos))
      }
    } else {
      out.write_string(self.s.slice(self.pos, self.pos + 1))
      self.pos = self.pos + 1
    }
  }
  None
}

fn ExtJsonParser::parse_val(self : ExtJsonParser, depth : Int) -> Option[ExtJson] {
  if depth > 64 {
    return None
  }
  self.skip_ws()
  if self.pos >= self.n {
    return None
  }
  let c = self.s.code_unit_at(self.pos)
  if c == 34 {
    match self.parse_str() {
      Some(v) => Some(EJStr(v))
      None => None
    }
  } else if c == 123 {
    self.pos = self.pos + 1
    let m : Map[String, ExtJson] = Map::new()
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
      self.pos = self.pos + 1
      return Some(EJObj(m))
    }
    while self.pos < self.n {
      self.skip_ws()
      let k = match self.parse_str() {
        Some(ks) => ks
        None => return None
      }
      self.skip_ws()
      if self.pos >= self.n || self.s.code_unit_at(self.pos) != 58 {
        return None
      }
      self.pos = self.pos + 1
      let v = match self.parse_val(depth + 1) {
        Some(vv) => vv
        None => return None
      }
      m.set(k, v)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 125 {
        self.pos = self.pos + 1
        return Some(EJObj(m))
      }
      return None
    }
    None
  } else if c == 91 {
    self.pos = self.pos + 1
    let arr : Array[ExtJson] = []
    self.skip_ws()
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
      self.pos = self.pos + 1
      return Some(EJArr(arr))
    }
    while self.pos < self.n {
      let v = match self.parse_val(depth + 1) {
        Some(vv) => vv
        None => return None
      }
      arr.push(v)
      self.skip_ws()
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 44 {
        self.pos = self.pos + 1
        continue
      }
      if self.pos < self.n && self.s.code_unit_at(self.pos) == 93 {
        self.pos = self.pos + 1
        return Some(EJArr(arr))
      }
      return None
    }
    None
  } else if c == 116 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "true" {
    self.pos = self.pos + 4
    Some(EJBool(true))
  } else if c == 102 && self.pos + 5 <= self.n && self.s.slice(self.pos, self.pos + 5) == "false" {
    self.pos = self.pos + 5
    Some(EJBool(false))
  } else if c == 110 && self.pos + 4 <= self.n && self.s.slice(self.pos, self.pos + 4) == "null" {
    self.pos = self.pos + 4
    Some(EJNull)
  } else if c == 45 || (c >= 48 && c <= 57) {
    let mut neg = false
    if c == 45 {
      neg = true
      self.pos = self.pos + 1
    }
    let mut acc = 0.0
    let mut iacc = 0
    let mut digits = 0
    let mut is_float = false
    let first_digit_pos = self.pos
    while self.pos < self.n {
      let d = self.s.code_unit_at(self.pos).to_int()
      if d >= 48 && d <= 57 {
        let dv = d - 48
        acc = acc * 10.0 + dv.to_double()
        if digits < 9 {
          iacc = iacc * 10 + dv
        } else {
          is_float = true
        }
        digits = digits + 1
        self.pos = self.pos + 1
      } else {
        break
      }
    }
    if digits == 0 {
      return None
    }
    if digits > 1 && self.s.code_unit_at(first_digit_pos) == 48 {
      return None
    }
    if self.pos < self.n && self.s.code_unit_at(self.pos) == 46 {
      is_float = true
      self.pos = self.pos + 1
      let mut frac_digits = 0
      let mut scale = 0.1
      while self.pos < self.n {
        let d = self.s.code_unit_at(self.pos).to_int()
        if d >= 48 && d <= 57 {
          acc = acc + (d - 48).to_double() * scale
          scale = scale * 0.1
          frac_digits += 1
          self.pos = self.pos + 1
        } else {
          break
        }
      }
      if frac_digits == 0 {
        return None
      }
    }
    if self.pos < self.n && (self.s.code_unit_at(self.pos) == 101 || self.s.code_unit_at(self.pos) == 69) {
      is_float = true
      self.pos = self.pos + 1
      let mut eneg = false
      if self.pos < self.n && (self.s.code_unit_at(self.pos) == 43 || self.s.code_unit_at(self.pos) == 45) {
        eneg = self.s.code_unit_at(self.pos) == 45
        self.pos = self.pos + 1
      }
      let mut exp = 0
      let mut exp_digits = 0
      while self.pos < self.n {
        let d = self.s.code_unit_at(self.pos).to_int()
        if d >= 48 && d <= 57 {
          if exp < 308 {
            exp = exp * 10 + (d - 48)
          }
          exp_digits += 1
          self.pos = self.pos + 1
        } else {
          break
        }
      }
      if exp_digits == 0 {
        return None
      }
      let mut k = 0
      while k < exp {
        acc = if eneg { acc * 0.1 } else { acc * 10.0 }
        k += 1
      }
    }
    if is_float {
      Some(EJFloat(if neg { 0.0 - acc } else { acc }))
    } else {
      Some(EJInt(if neg { 0 - iacc } else { iacc }))
    }
  } else {
    None
  }
}

pub fn ext_json_parse(s : String) -> Option[ExtJson] {
  let p = ExtJsonParser::{ s: s, n: s.length(), pos: 0 }
  match p.parse_val(0) {
    Some(v) => {
      p.skip_ws()
      if p.pos != p.n {
        None
      } else {
        Some(v)
      }
    }
    None => None
  }
}

pub fn ej_get(v : ExtJson, k : String) -> Option[ExtJson] {
  match v {
    EJObj(m) => m.get(k)
    _ => None
  }
}

pub fn ej_str(v : ExtJson, k : String) -> String {
  match ej_get(v, k) {
    Some(EJStr(s)) => s
    _ => ""
  }
}

pub fn ej_int(v : ExtJson, k : String, def : Int) -> Int {
  match ej_get(v, k) {
    Some(EJInt(n)) => n
    Some(EJFloat(f)) => f.to_int()
    _ => def
  }
}

pub fn ej_double(v : ExtJson, k : String, def : Double) -> Double {
  match ej_get(v, k) {
    Some(EJInt(n)) => n.to_double()
    Some(EJFloat(f)) => f
    _ => def
  }
}

pub fn ej_bool(v : ExtJson, k : String, def : Bool) -> Bool {
  match ej_get(v, k) {
    Some(EJBool(b)) => b
    _ => def
  }
}

pub fn ej_str_array(v : ExtJson, k : String) -> Array[String] {
  let out : Array[String] = []
  match ej_get(v, k) {
    Some(EJArr(items)) => {
      for it in items {
        match it {
          EJStr(s) => out.push(s)
          _ => ()
        }
      }
    }
    _ => ()
  }
  out
}

pub struct ContentScriptSpec {
  pub matches : Array[String]
  pub exclude_matches : Array[String]
  pub js : Array[String]
  pub css : Array[String]
  pub run_at : String
  pub all_frames : Bool
  pub match_about_blank : Bool
  pub world : String
}

pub struct ExtCommandSpec {
  pub name : String
  pub suggested_key : String
  pub description : String
}

pub struct DnrRuleResource {
  pub id : String
  pub enabled : Bool
  pub path : String
}

///| One `{size: path}` entry of `icons` / `action.default_icon` (`size` 0 for the single-string form).
pub struct ExtIcon {
  pub size : Int
  pub path : String
}

///| MV3 `action` (toolbar button): `default_title`, `default_popup`, `default_icon`.
pub struct ExtensionAction {
  pub present : Bool
  pub default_title : String
  pub default_popup : String
  pub default_icon : Array[ExtIcon]
}

///| MV3 `web_accessible_resources` entry (`{resources, matches, extension_ids, use_dynamic_url}`).
pub struct WebAccessibleResource {
  pub resources : Array[String]
  pub matches : Array[String]
  pub extension_ids : Array[String]
}

pub struct ManifestV3 {
  pub manifest_version : Int
  pub name : String
  pub version : String
  pub description : String
  pub key : String
  pub default_locale : String
  pub permissions : Array[String]
  pub optional_permissions : Array[String]
  pub host_permissions : Array[String]
  pub content_scripts : Array[ContentScriptSpec]
  pub dnr_rule_resources : Array[DnrRuleResource]
  pub background_service_worker : String
  pub background_type : String
  pub action : ExtensionAction
  pub icons : Array[ExtIcon]
  ///| `options_ui.page` when given, else `options_page` ("" when none)
  pub options_page : String
  ///| `options_ui.open_in_tab` (`options_page` always opens in a tab)
  pub options_open_in_tab : Bool
  pub web_accessible_resources : Array[WebAccessibleResource]
  pub commands : Array[ExtCommandSpec]
  pub raw_json : String
}

fn ej_icons(v : Option[ExtJson]) -> Array[ExtIcon] {
  let out : Array[ExtIcon] = []
  match v {
    Some(EJStr(p)) => if p != "" { out.push(ExtIcon::{ size: 0, path: p }) }
    Some(EJObj(m)) => {
      for k in m.keys() {
        match m.get(k) {
          Some(EJStr(p)) if p != "" => {
            let mut n = 0
            let mut ok = k.length() > 0
            let mut i = 0
            while i < k.length() {
              let c = k.code_unit_at(i)
              if c < 48 || c > 57 {
                ok = false
                break
              }
              n = n * 10 + (c - 48)
              i = i + 1
            }
            out.push(ExtIcon::{ size: if ok { n } else { 0 }, path: p })
          }
          _ => ()
        }
      }
    }
    _ => ()
  }
  // ascending by size (insertion sort; icon maps are tiny)
  let mut i = 1
  while i < out.length() {
    let cur = out[i]
    let mut j = i - 1
    while j >= 0 && out[j].size > cur.size {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    i = i + 1
  }
  out
}

///| The icon whose size is the smallest at or above `want` (else the largest), "" when there is none.
pub fn ext_pick_icon(icons : Array[ExtIcon], want : Int) -> String {
  if icons.length() == 0 {
    return ""
  }
  for ic in icons {
    if ic.size >= want {
      return ic.path
    }
  }
  icons[icons.length() - 1].path
}

///| The toolbar icon path (`action.default_icon`, falling back to `icons`) nearest `want` px.
pub fn ManifestV3::toolbar_icon(self : ManifestV3, want : Int) -> String {
  let p = ext_pick_icon(self.action.default_icon, want)
  if p != "" {
    p
  } else {
    ext_pick_icon(self.icons, want)
  }
}

///| The toolbar title: `action.default_title`, else the extension's name.
pub fn ManifestV3::action_title(self : ManifestV3) -> String {
  if self.action.default_title != "" {
    self.action.default_title
  } else {
    self.name
  }
}

///| Whether `path` (relative to the extension root) is web accessible to a page at `page_url`.
pub fn ManifestV3::is_web_accessible(self : ManifestV3, path : String, page_url : String) -> Bool {
  let rel = if path.starts_with("/") { path.slice(1, path.length()) } else { path }
  for war in self.web_accessible_resources {
    let mut hit = false
    for pat in war.resources {
      let p = if pat.starts_with("/") { pat.slice(1, pat.length()) } else { pat }
      if glob_match(p, rel) {
        hit = true
        break
      }
    }
    if !hit {
      continue
    }
    if war.matches.length() == 0 {
      // MV2-style plain list (or extension_ids only): reachable from any page
      return war.extension_ids.length() == 0
    }
    for m in war.matches {
      if match_url_pattern(m, page_url) {
        return true
      }
    }
  }
  false
}

///| A manifest-relative path without its leading `/` or `./`, query or fragment.
pub fn ext_clean_rel(p : String) -> String {
  let mut s = p.trim()
  while s.starts_with("/") || s.starts_with("./") {
    s = if s.starts_with("/") { s.slice(1, s.length()) } else { s.slice(2, s.length()) }
  }
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 63 || c == 35 {
      return s.slice(0, i)
    }
    i = i + 1
  }
  s
}

pub fn parse_manifest_v3(raw_json : String) -> Result[ManifestV3, String] {
  let root = match ext_json_parse(raw_json) {
    Some(v) => v
    None => return Err("invalid manifest.json: JSON parse error")
  }
  let mv = ej_int(root, "manifest_version", 0)
  if mv != 3 {
    return Err("unsupported manifest_version: expected 3, got " + mv.to_string())
  }
  let name = ej_str(root, "name")
  if name == "" {
    return Err("manifest.json missing required field: name")
  }
  let version = ej_str(root, "version")
  if version == "" {
    return Err("manifest.json missing required field: version")
  }
  let permissions = ej_str_array(root, "permissions")
  let host_permissions = ej_str_array(root, "host_permissions")

  let content_scripts : Array[ContentScriptSpec] = []
  match ej_get(root, "content_scripts") {
    Some(EJArr(items)) => {
      for it in items {
        let matches = ej_str_array(it, "matches")
        let exclude_matches = ej_str_array(it, "exclude_matches")
        let js = ej_str_array(it, "js")
        let css = ej_str_array(it, "css")
        let raw_run = ej_str(it, "run_at")
        let run_at = if raw_run == "document_start" || raw_run == "document_end" || raw_run == "document_idle" {
          raw_run
        } else {
          "document_idle"
        }
        let all_frames = ej_bool(it, "all_frames", false)
        let match_about_blank = ej_bool(it, "match_about_blank", false)
        let raw_world = ej_str(it, "world")
        let world = if raw_world == "MAIN" { "MAIN" } else { "ISOLATED" }
        content_scripts.push(ContentScriptSpec::{
          matches: matches,
          exclude_matches: exclude_matches,
          js: js,
          css: css,
          run_at: run_at,
          all_frames: all_frames,
          match_about_blank: match_about_blank,
          world: world,
        })
      }
    }
    _ => ()
  }

  let dnr_rule_resources : Array[DnrRuleResource] = []
  match ej_get(root, "declarative_net_request") {
    Some(dnr_obj) => {
      match ej_get(dnr_obj, "rule_resources") {
        Some(EJArr(items)) => {
          for it in items {
            let rid = ej_str(it, "id")
            let enabled = ej_bool(it, "enabled", true)
            let path = ej_str(it, "path")
            if rid != "" && path != "" {
              dnr_rule_resources.push(DnrRuleResource::{ id: rid, enabled: enabled, path: path })
            }
          }
        }
        _ => ()
      }
    }
    None => ()
  }

  let mut background_service_worker = ""
  let mut background_type = "classic"
  match ej_get(root, "background") {
    Some(bg_obj) => {
      background_service_worker = ej_str(bg_obj, "service_worker")
      let bt = ej_str(bg_obj, "type")
      if bt == "module" {
        background_type = "module"
      }
    }
    None => ()
  }

  let action = match ej_get(root, "action") {
    Some(a) if a is EJObj(_) =>
    ExtensionAction::{
      present: true,
      default_title: ej_str(a, "default_title"),
      default_popup: ext_clean_rel(ej_str(a, "default_popup")),
      default_icon: ej_icons(ej_get(a, "default_icon")),
    }
    _ => ExtensionAction::{ present: false, default_title: "", default_popup: "", default_icon: [] }
  }
  let mut options_page = ext_clean_rel(ej_str(root, "options_page"))
  let mut options_open_in_tab = options_page != ""
  match ej_get(root, "options_ui") {
    Some(ou) if ou is EJObj(_) => {
      let p = ext_clean_rel(ej_str(ou, "page"))
      if p != "" {
        options_page = p
        options_open_in_tab = ej_bool(ou, "open_in_tab", false)
      }
    }
    _ => ()
  }
  let wars : Array[WebAccessibleResource] = []
  match ej_get(root, "web_accessible_resources") {
    Some(EJArr(items)) => {
      let plain : Array[String] = []
      for it in items {
        match it {
          EJStr(p) => plain.push(p)
          EJObj(_) => {
            wars.push(WebAccessibleResource::{
              resources: ej_str_array(it, "resources"),
              matches: ej_str_array(it, "matches"),
              extension_ids: ej_str_array(it, "extension_ids"),
            })
          }
          _ => ()
        }
      }
      if plain.length() > 0 {
        wars.push(WebAccessibleResource::{ resources: plain, matches: [], extension_ids: [] })
      }
    }
    _ => ()
  }

  let commands : Array[ExtCommandSpec] = []
  match ej_get(root, "commands") {
    Some(EJObj(cm)) => {
      for cname in cm.keys() {
        match cm.get(cname) {
          Some(cobj) => {
            let desc = ej_str(cobj, "description")
            let mut skey = ""
            match ej_get(cobj, "suggested_key") {
              Some(EJStr(s)) => skey = s
              Some(sk_obj) => {
                skey = ej_str(sk_obj, "default")
                if skey == "" {
                  skey = ej_str(sk_obj, "mac")
                }
              }
              None => ()
            }
            commands.push(ExtCommandSpec::{ name: cname, suggested_key: skey, description: desc })
          }
          None => ()
        }
      }
    }
    _ => ()
  }

  Ok(ManifestV3::{
    manifest_version: 3,
    name: name,
    version: version,
    description: ej_str(root, "description"),
    key: ej_str(root, "key"),
    default_locale: ej_str(root, "default_locale"),
    permissions: permissions,
    optional_permissions: ej_str_array(root, "optional_permissions"),
    host_permissions: host_permissions,
    content_scripts: content_scripts,
    dnr_rule_resources: dnr_rule_resources,
    background_service_worker: background_service_worker,
    background_type: background_type,
    action: action,
    icons: ej_icons(ej_get(root, "icons")),
    options_page: options_page,
    options_open_in_tab: options_open_in_tab,
    web_accessible_resources: wars,
    commands: commands,
    raw_json: raw_json,
  })
}

pub fn ContentScriptSpec::matches_url(self : ContentScriptSpec, raw_url : String) -> Bool {
  if self.match_about_blank && (raw_url == "about:blank" || raw_url == "about:srcdoc") {
    return true
  }
  // Judge the WHATWG-canonical URL so `https://evil.test\@good.example/` is seen as evil.test.
  let url = match url::parse_url(raw_url) {
    Some(u) => url::url_href(u, true)
    None => return false
  }
  let mut matched = false
  for pat in self.matches {
    if match_url_pattern(pat, url) {
      matched = true
      break
    }
  }
  if !matched {
    return false
  }
  for ex in self.exclude_matches {
    if match_url_pattern(ex, url) {
      return false
    }
  }
  true
}

pub fn ManifestV3::has_permission(self : ManifestV3, perm : String) -> Bool {
  for p in self.permissions {
    if p == perm {
      return true
    }
  }
  false
}

pub fn ManifestV3::has_host_permission(self : ManifestV3, raw_url : String) -> Bool {
  extension_can_access_url(self, raw_url)
}

///| Parses a Chrome `_locales/<lang>/messages.json` file into `lowercase_key -> message`.
pub fn parse_i18n_messages(raw_json : String) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  match ext_json_parse(raw_json) {
    Some(EJObj(m)) => {
      for k in m.keys() {
        match m.get(k) {
          Some(entry) => {
            let msg = ej_str(entry, "message")
            if msg != "" {
              out.set(ext_ascii_lower(k), msg)
            }
          }
          None => ()
        }
      }
    }
    _ => ()
  }
  out
}

///| Expands `$1`..`$9` positional placeholders and `$$` escapes in a Chrome i18n message.
pub fn expand_i18n_message(template : String, substitutions : Array[String]) -> String {
  let sb = StringBuilder::new()
  let n = template.length()
  let mut i = 0
  while i < n {
    let c = template.code_unit_at(i).to_int()
    if c == 36 && i + 1 < n {
      let nxt = template.code_unit_at(i + 1).to_int()
      if nxt == 36 {
        sb.write_string("$")
        i += 2
        continue
      }
      if nxt >= 49 && nxt <= 57 {
        let idx = nxt - 49
        if idx < substitutions.length() {
          sb.write_string(substitutions[idx])
        }
        i += 2
        continue
      }
    }
    sb.write_string(template.slice(i, i + 1))
    i += 1
  }
  sb.to_string()
}

///| Resolves Chrome `__MSG_<key>__` tokens inside manifest strings (`name`, `description`, etc.).
pub fn resolve_manifest_msg(
  text : String,
  ext_id : String,
  locale : String,
  msgs : Map[String, String],
) -> String {
  if !text.contains("__MSG_") {
    return text
  }
  let sb = StringBuilder::new()
  let n = text.length()
  let mut i = 0
  while i < n {
    if i + 8 < n && text.slice(i, i + 6) == "__MSG_" {
      let close = find_substr(text, "__", i + 6)
      if close > i + 6 {
        let key = text.slice(i + 6, close)
        if key == "@@extension_id" {
          sb.write_string(ext_id)
        } else if key == "@@ui_locale" {
          sb.write_string(if locale != "" { locale } else { "en" })
        } else if key == "@@bidi_dir" {
          sb.write_string("ltr")
        } else {
          match msgs.get(ext_ascii_lower(key)) {
            Some(m) => sb.write_string(m)
            None => sb.write_string(text.slice(i, close + 2))
          }
        }
        i = close + 2
        continue
      }
    }
    sb.write_string(text.slice(i, i + 1))
    i += 1
  }
  sb.to_string()
}

///| Returns the HTTP Content-Type for an extension resource path (`chrome-extension://<id>/<path>`).
pub fn mime_type_for_ext_path(path : String) -> String {
  let low = ext_ascii_lower(path)
  if low.ends_with(".html") || low.ends_with(".htm") {
    "text/html; charset=utf-8"
  } else if low.ends_with(".js") || low.ends_with(".mjs") || low.ends_with(".cjs") {
    "application/javascript; charset=utf-8"
  } else if low.ends_with(".css") {
    "text/css; charset=utf-8"
  } else if low.ends_with(".json") || low.ends_with(".map") {
    "application/json; charset=utf-8"
  } else if low.ends_with(".wasm") {
    "application/wasm"
  } else if low.ends_with(".svg") {
    "image/svg+xml"
  } else if low.ends_with(".png") {
    "image/png"
  } else if low.ends_with(".jpg") || low.ends_with(".jpeg") {
    "image/jpeg"
  } else if low.ends_with(".gif") {
    "image/gif"
  } else if low.ends_with(".webp") {
    "image/webp"
  } else if low.ends_with(".ico") {
    "image/x-icon"
  } else if low.ends_with(".woff2") {
    "font/woff2"
  } else if low.ends_with(".woff") {
    "font/woff"
  } else if low.ends_with(".ttf") {
    "font/ttf"
  } else if low.ends_with(".otf") {
    "font/otf"
  } else if low.ends_with(".txt") {
    "text/plain; charset=utf-8"
  } else if low.ends_with(".xml") {
    "application/xml; charset=utf-8"
  } else {
    "application/octet-stream"
  }
}
