///| Unpacked Chrome MV3 extension directory loader.
///| Reads `manifest.json`, `declarative_net_request.rule_resources` JSON files,
///| `content_scripts` JS/CSS files, and `background.service_worker` JS from an unpacked directory.

pub struct UnpackedExtension {
  pub id : String
  pub dir : String
  pub manifest : ManifestV3
  pub files : Map[String, String]
  pub static_dnr_rules : Array[DnrRule]
}

fn is_safe_rel_path(p : String) -> Bool {
  if p == "" || p.starts_with("/") || p.starts_with("\\") {
    return false
  }
  let parts = p.split("/")
  for seg in parts {
    if seg == ".." || seg == "" {
      return false
    }
  }
  true
}

fn join_ext_path(dir : String, rel : String) -> String {
  let clean_dir = if dir.ends_with("/") && dir.length() > 1 {
    dir.slice(0, dir.length() - 1)
  } else {
    dir
  }
  clean_dir + "/" + rel
}

///| The extension-relative paths an extension page (`popup.html`) names in `src="..."` / `href="..."`:
///| relative and root-relative references only (no scheme, `//`, `data:` or `#`), resolved against the page's
///| own directory, without query or fragment, `..` segments folded (and dropped when they climb out of the root).
pub fn ext_page_asset_refs(page_path : String, html : String) -> Array[String] {
  let out : Array[String] = []
  let mut cut = 0
  let mut k = 0
  while k < page_path.length() {
    if page_path.code_unit_at(k) == 47 {
      cut = k + 1
    }
    k = k + 1
  }
  let base_dir = page_path.slice(0, cut)
  let low = ext_ascii_lower(html)
  for attr in ["src=", "href="] {
    let mut at = 0
    while true {
      let i = find_substr(low, attr, at)
      if i < 0 {
        break
      }
      at = i + attr.length()
      if i > 0 {
        let pc = low.code_unit_at(i - 1)
        if pc != 32 && pc != 9 && pc != 10 && pc != 13 {
          continue
        }
      }
      if at >= html.length() {
        break
      }
      let q = html.code_unit_at(at)
      if q != 34 && q != 39 {
        continue
      }
      let mut e = at + 1
      while e < html.length() && html.code_unit_at(e) != q {
        e = e + 1
      }
      let raw = html.slice(at + 1, e).trim()
      at = e
      let rl = ext_ascii_lower(raw)
      if raw == "" || raw.starts_with("#") || raw.starts_with("//") || rl.contains(":") {
        continue
      }
      let joined = if raw.starts_with("/") { ext_clean_rel(raw) } else { ext_clean_rel(base_dir + raw) }
      let segs : Array[String] = []
      let mut bad = false
      for seg in joined.split("/") {
        if seg == "" || seg == "." {
          continue
        }
        if seg == ".." {
          if segs.length() == 0 {
            bad = true
            break
          }
          let _ = segs.pop()
        } else {
          segs.push(seg)
        }
      }
      if bad || segs.length() == 0 {
        continue
      }
      let rel = segs.join("/")
      let mut dup = false
      for o in out {
        if o == rel {
          dup = true
          break
        }
      }
      if !dup {
        out.push(rel)
      }
    }
  }
  out
}

///| Derives a deterministic, URL-safe extension ID from the unpacked directory path and manifest name.
pub fn derive_unpacked_extension_id(dir : String, name : String) -> String {
  let seed = if dir != "" { dir } else { name }
  let mut h : Int64 = 1469598103934665603L
  let n = seed.length()
  let mut i = 0
  while i < n {
    let c = seed.code_unit_at(i).to_int64()
    h = (h ^ c) * 1099511628211L
    i = i + 1
  }
  let hex = "0123456789abcdef"
  let sb = StringBuilder::new()
  sb.write_string("unpacked-")
  let mut j = 0
  while j < 12 {
    let shift = (11 - j) * 4
    let nib = ((h >> shift) & 15L).to_int()
    sb.write_string(hex.slice(nib, nib + 1))
    j = j + 1
  }
  sb.to_string()
}

///| Loads an unpacked MV3 extension directory using the provided file reader callback.
pub fn load_unpacked_extension_with(
  dir : String,
  read_file : (String) -> Result[String, String],
) -> Result[UnpackedExtension, String] {
  let manifest_path = join_ext_path(dir, "manifest.json")
  let manifest_json = match read_file(manifest_path) {
    Ok(s) => s
    Err(e) => return Err("failed to read manifest.json: " + e)
  }
  let manifest = match parse_manifest_v3(manifest_json) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  let files : Map[String, String] = Map::new()
  files.set("manifest.json", manifest_json)

  // Collect all referenced relative asset paths
  let wanted : Array[String] = []
  for res in manifest.dnr_rule_resources {
    if res.enabled && res.path != "" {
      wanted.push(res.path)
    }
  }
  for cs in manifest.content_scripts {
    for p in cs.css {
      wanted.push(p)
    }
    for p in cs.js {
      wanted.push(p)
    }
  }
  if manifest.background_service_worker != "" {
    wanted.push(manifest.background_service_worker)
  }
  // Extension pages (toolbar popup, options page): optional, read with the scripts and styles they reference.
  let pages : Array[String] = []
  if manifest.action.default_popup != "" {
    pages.push(manifest.action.default_popup)
  }
  if manifest.options_page != "" && manifest.options_page != manifest.action.default_popup {
    pages.push(manifest.options_page)
  }

  for rel in wanted {
    if !is_safe_rel_path(rel) {
      return Err("unsafe extension asset path: " + rel)
    }
    if files.contains(rel) {
      continue
    }
    let full = join_ext_path(dir, rel)
    match read_file(full) {
      Ok(content) => files.set(rel, content)
      Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
    }
  }

  for page in pages {
    if !is_safe_rel_path(page) || files.contains(page) {
      continue
    }
    match read_file(join_ext_path(dir, page)) {
      Ok(html) => {
        files.set(page, html)
        for rel in ext_page_asset_refs(page, html) {
          if files.contains(rel) || !is_safe_rel_path(rel) {
            continue
          }
          match read_file(join_ext_path(dir, rel)) {
            Ok(content) => files.set(rel, content)
            Err(_) => ()
          }
        }
      }
      Err(_) => ()
    }
  }

  let static_dnr_rules : Array[DnrRule] = []
  for res in manifest.dnr_rule_resources {
    if !res.enabled {
      continue
    }
    match files.get(res.path) {
      Some(rjson) => match parse_dnr_rules_json(rjson) {
        Ok(rs) => {
          for r in rs {
            static_dnr_rules.push(r)
          }
        }
        Err(e) => return Err("failed to parse DNR rules " + res.path + ": " + e)
      }
      None => ()
    }
  }

  let id = derive_unpacked_extension_id(dir, manifest.name)
  Ok(UnpackedExtension::{
    id: id,
    dir: dir,
    manifest: manifest,
    files: files,
    static_dnr_rules: static_dnr_rules,
  })
}

///| Loads an unpacked MV3 extension directory from disk via `World`.
pub fn load_unpacked_extension(w : World, dir : String) -> Result[UnpackedExtension, String] {
  load_unpacked_extension_with(dir, fn(p : String) -> Result[String, String] {
    fs_read(w, p)
  })
}
