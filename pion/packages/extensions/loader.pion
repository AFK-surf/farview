///| Unpacked Chrome MV3 extension directory loader.
///| Reads `manifest.json`, `declarative_net_request.rule_resources` JSON files,
///| `content_scripts` JS/CSS files, and `background.service_worker` JS from an unpacked directory.

pub struct UnpackedExtension {
  pub id : String
  pub dir : String
  pub manifest : ManifestV3
  pub files : Map[String, String]
  pub assets : Map[String, Bytes]
  pub static_dnr_rules : Array[DnrRule]
}

fn is_safe_rel_path(p : String) -> Bool {
  is_safe_archive_path(p)
}

fn normalize_rel_path(p : String) -> String {
  let mut s = p.trim()
  while s.starts_with("./") {
    s = s.slice(2, s.length())
  }
  while s.starts_with("/") {
    s = s.slice(1, s.length())
  }
  s
}

fn is_text_asset_path(rel : String) -> Bool {
  let low = ext_ascii_lower(rel)
  low.ends_with(".js") || low.ends_with(".mjs") || low.ends_with(".cjs") ||
  low.ends_with(".css") || low.ends_with(".html") || low.ends_with(".htm") ||
  low.ends_with(".json") || low.ends_with(".svg") || low.ends_with(".txt") ||
  low.ends_with(".xml") || low.ends_with(".map")
}

fn ext_b64_val(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 || c == 45 {
    62
  } else if c == 47 || c == 95 {
    63
  } else {
    -1
  }
}

fn ext_b64_decode(s : String) -> Option[Bytes] {
  let out : Array[Byte] = []
  let mut acc = 0
  let mut bits = -8
  let n = s.length()
  let mut i = 0
  while i < n {
    let ch = s.code_unit_at(i).to_int()
    if ch == 61 {
      break
    }
    if ch == 32 || ch == 10 || ch == 13 || ch == 9 {
      i += 1
      continue
    }
    let d = ext_b64_val(ch)
    if d < 0 {
      return None
    }
    acc = (acc << 6) | d
    bits += 6
    if bits >= 0 {
      out.push(((acc >> bits) & 0xFF).to_byte())
      bits -= 8
    }
    i += 1
  }
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j]
    j += 1
  }
  Some(res)
}

fn ext_rotr32(x : Int64, n : Int) -> Int64 {
  let u = x & 0xFFFFFFFFL
  ((u >> n) | (u << (32 - n))) & 0xFFFFFFFFL
}

fn ext_sha256_first16(data : Bytes) -> Bytes {
  let k : Array[Int64] = [
    0x428a2f98L, 0x71374491L, 0xb5c0fbcfL, 0xe9b5dba5L, 0x3956c25bL, 0x59f111f1L, 0x923f82a4L, 0xab1c5ed5L,
    0xd807aa98L, 0x12835b01L, 0x243185beL, 0x550c7dc3L, 0x72be5d74L, 0x80deb1feL, 0x9bdc06a7L, 0xc19bf174L,
    0xe49b69c1L, 0xefbe4786L, 0x0fc19dc6L, 0x240ca1ccL, 0x2de92c6fL, 0x4a7484aaL, 0x5cb0a9dcL, 0x76f988daL,
    0x983e5152L, 0xa831c66dL, 0xb00327c8L, 0xbf597fc7L, 0xc6e00bf3L, 0xd5a79147L, 0x06ca6351L, 0x14292967L,
    0x27b70a85L, 0x2e1b2138L, 0x4d2c6dfcL, 0x53380d13L, 0x650a7354L, 0x766a0abbL, 0x81c2c92eL, 0x92722c85L,
    0xa2bfe8a1L, 0xa81a664bL, 0xc24b8b70L, 0xc76c51a3L, 0xd192e819L, 0xd6990624L, 0xf40e3585L, 0x106aa070L,
    0x19a4c116L, 0x1e376c08L, 0x2748774cL, 0x34b0bcb5L, 0x391c0cb3L, 0x4ed8aa4aL, 0x5b9cca4fL, 0x682e6ff3L,
    0x748f82eeL, 0x78a5636fL, 0x84c87814L, 0x8cc70208L, 0x90befffaL, 0xa4506cebL, 0xbef9a3f7L, 0xc67178f2L,
  ]
  let mut h0 = 0x6a09e667L
  let mut h1 = 0xbb67ae85L
  let mut h2 = 0x3c6ef372L
  let mut h3 = 0xa54ff53aL
  let mut h4 = 0x510e527fL
  let mut h5 = 0x9b05688cL
  let mut h6 = 0x1f83d9abL
  let mut h7 = 0x5be0cd19L

  let len = data.length()
  let bit_len = len.to_int64() * 8L
  let pad_rem = (len + 9) % 64
  let total = if pad_rem == 0 { len + 9 } else { len + 9 + (64 - pad_rem) }
  let msg = Bytes::new(total)
  let mut i = 0
  while i < len {
    msg[i] = data[i]
    i += 1
  }
  msg[len] = b'\x80'
  let mut b = 0
  while b < 8 {
    msg[total - 1 - b] = ((bit_len >> (b * 8)) & 0xFFL).to_int().to_byte()
    b += 1
  }

  let w : Array[Int64] = Array::make(64, 0L)
  let mut off = 0
  while off < total {
    let mut j = 0
    while j < 16 {
      let o = off + j * 4
      w[j] = ((msg[o].to_int().to_int64() & 0xFFL) << 24) |
      ((msg[o + 1].to_int().to_int64() & 0xFFL) << 16) |
      ((msg[o + 2].to_int().to_int64() & 0xFFL) << 8) |
      (msg[o + 3].to_int().to_int64() & 0xFFL)
      j += 1
    }
    while j < 64 {
      let s0 = ext_rotr32(w[j - 15], 7) ^ ext_rotr32(w[j - 15], 18) ^ ((w[j - 15] & 0xFFFFFFFFL) >> 3)
      let s1 = ext_rotr32(w[j - 2], 17) ^ ext_rotr32(w[j - 2], 19) ^ ((w[j - 2] & 0xFFFFFFFFL) >> 10)
      w[j] = (w[j - 16] + s0 + w[j - 7] + s1) & 0xFFFFFFFFL
      j += 1
    }
    let mut a = h0
    let mut bb = h1
    let mut c = h2
    let mut d = h3
    let mut e = h4
    let mut f = h5
    let mut g = h6
    let mut hh = h7
    j = 0
    while j < 64 {
      let s1 = ext_rotr32(e, 6) ^ ext_rotr32(e, 11) ^ ext_rotr32(e, 25)
      let ch = (e & f) ^ ((e ^ 0xFFFFFFFFL) & g)
      let t1 = (hh + s1 + ch + k[j] + w[j]) & 0xFFFFFFFFL
      let s0 = ext_rotr32(a, 2) ^ ext_rotr32(a, 13) ^ ext_rotr32(a, 22)
      let maj = (a & bb) ^ (a & c) ^ (bb & c)
      let t2 = (s0 + maj) & 0xFFFFFFFFL
      hh = g
      g = f
      f = e
      e = (d + t1) & 0xFFFFFFFFL
      d = c
      c = bb
      bb = a
      a = (t1 + t2) & 0xFFFFFFFFL
      j += 1
    }
    h0 = (h0 + a) & 0xFFFFFFFFL
    h1 = (h1 + bb) & 0xFFFFFFFFL
    h2 = (h2 + c) & 0xFFFFFFFFL
    h3 = (h3 + d) & 0xFFFFFFFFL
    h4 = (h4 + e) & 0xFFFFFFFFL
    h5 = (h5 + f) & 0xFFFFFFFFL
    h6 = (h6 + g) & 0xFFFFFFFFL
    h7 = (h7 + hh) & 0xFFFFFFFFL
    off += 64
  }
  let out = Bytes::new(16)
  let hs : Array[Int64] = [h0, h1, h2, h3]
  let mut hi = 0
  while hi < 4 {
    let v = hs[hi]
    out[hi * 4] = ((v >> 24) & 0xFFL).to_int().to_byte()
    out[hi * 4 + 1] = ((v >> 16) & 0xFFL).to_int().to_byte()
    out[hi * 4 + 2] = ((v >> 8) & 0xFFL).to_int().to_byte()
    out[hi * 4 + 3] = (v & 0xFFL).to_int().to_byte()
    hi += 1
  }
  out
}

///| Derives the official 32-char Chrome Extension ID (`a`–`p`) from a base64 DER public key (`manifest.key`).
pub fn derive_chrome_id_from_key(b64_key : String) -> Option[String] {
  if b64_key == "" {
    return None
  }
  match ext_b64_decode(b64_key) {
    Some(der) if der.length() > 0 => Some(crx_bytes_to_chrome_id(ext_sha256_first16(der)))
    _ => None
  }
}

fn join_ext_path(dir : String, rel : String) -> String {
  let clean_dir = if dir.ends_with("/") && dir.length() > 1 {
    dir.slice(0, dir.length() - 1)
  } else {
    dir
  }
  clean_dir + "/" + rel
}

///| The extension-relative paths an extension page (`popup.html`) names in `src="..."` / `href="..."`:
///| relative and root-relative references only (no scheme, `//`, `data:` or `#`), resolved against the page's
///| own directory, without query or fragment, `..` segments folded (and dropped when they climb out of the root).
pub fn ext_page_asset_refs(page_path : String, html : String) -> Array[String] {
  let out : Array[String] = []
  let mut cut = 0
  let mut k = 0
  while k < page_path.length() {
    if page_path.code_unit_at(k) == 47 {
      cut = k + 1
    }
    k = k + 1
  }
  let base_dir = page_path.slice(0, cut)
  let low = ext_ascii_lower(html)
  for attr in ["src=", "href="] {
    let mut at = 0
    while true {
      let i = find_substr(low, attr, at)
      if i < 0 {
        break
      }
      at = i + attr.length()
      if i > 0 {
        let pc = low.code_unit_at(i - 1)
        if pc != 32 && pc != 9 && pc != 10 && pc != 13 {
          continue
        }
      }
      if at >= html.length() {
        break
      }
      let q = html.code_unit_at(at)
      if q != 34 && q != 39 {
        continue
      }
      let mut e = at + 1
      while e < html.length() && html.code_unit_at(e) != q {
        e = e + 1
      }
      let raw = html.slice(at + 1, e).trim()
      at = e
      let rl = ext_ascii_lower(raw)
      if raw == "" || raw.starts_with("#") || raw.starts_with("//") || rl.contains(":") {
        continue
      }
      let joined = if raw.starts_with("/") { ext_clean_rel(raw) } else { ext_clean_rel(base_dir + raw) }
      let segs : Array[String] = []
      let mut bad = false
      for seg in joined.split("/") {
        if seg == "" || seg == "." {
          continue
        }
        if seg == ".." {
          if segs.length() == 0 {
            bad = true
            break
          }
          let _ = segs.pop()
        } else {
          segs.push(seg)
        }
      }
      if bad || segs.length() == 0 {
        continue
      }
      let rel = segs.join("/")
      let mut dup = false
      for o in out {
        if o == rel {
          dup = true
          break
        }
      }
      if !dup {
        out.push(rel)
      }
    }
  }
  out
}

///| Derives a deterministic, URL-safe extension ID from the unpacked directory path and manifest name.
pub fn derive_unpacked_extension_id(dir : String, name : String) -> String {
  let seed = if dir != "" { dir } else { name }
  let mut h : Int64 = 1469598103934665603L
  let n = seed.length()
  let mut i = 0
  while i < n {
    let c = seed.code_unit_at(i).to_int64()
    h = (h ^ c) * 1099511628211L
    i = i + 1
  }
  let hex = "0123456789abcdef"
  let sb = StringBuilder::new()
  sb.write_string("unpacked-")
  let mut j = 0
  while j < 12 {
    let shift = (11 - j) * 4
    let nib = ((h >> shift) & 15L).to_int()
    sb.write_string(hex.slice(nib, nib + 1))
    j = j + 1
  }
  sb.to_string()
}

///| Loads an unpacked MV3 extension directory using the provided file reader callback.
pub fn load_unpacked_extension_with(
  dir : String,
  read_file : (String) -> Result[String, String],
) -> Result[UnpackedExtension, String] {
  let manifest_path = join_ext_path(dir, "manifest.json")
  let manifest_json = match read_file(manifest_path) {
    Ok(s) => s
    Err(e) => return Err("failed to read manifest.json: " + e)
  }
  let manifest = match parse_manifest_v3(manifest_json) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  let files : Map[String, String] = Map::new()
  files.set("manifest.json", manifest_json)

  // Collect all referenced relative asset paths
  let wanted : Array[String] = []
  for res in manifest.dnr_rule_resources {
    if res.enabled && res.path != "" {
      wanted.push(res.path)
    }
  }
  for cs in manifest.content_scripts {
    for p in cs.css {
      wanted.push(p)
    }
    for p in cs.js {
      wanted.push(p)
    }
  }
  if manifest.background_service_worker != "" {
    wanted.push(manifest.background_service_worker)
  }
  // Extension pages (toolbar popup, options page): optional, read with the scripts and styles they reference.
  let pages : Array[String] = []
  if manifest.action.default_popup != "" {
    pages.push(manifest.action.default_popup)
  }
  if manifest.options_page != "" && manifest.options_page != manifest.action.default_popup {
    pages.push(manifest.options_page)
  }

  for rel in wanted {
    if !is_safe_rel_path(rel) {
      return Err("unsafe extension asset path: " + rel)
    }
    if files.contains(rel) {
      continue
    }
    let full = join_ext_path(dir, rel)
    match read_file(full) {
      Ok(content) => files.set(rel, content)
      Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
    }
  }

  for page in pages {
    if !is_safe_rel_path(page) || files.contains(page) {
      continue
    }
    match read_file(join_ext_path(dir, page)) {
      Ok(html) => {
        files.set(page, html)
        for rel in ext_page_asset_refs(page, html) {
          if files.contains(rel) || !is_safe_rel_path(rel) {
            continue
          }
          match read_file(join_ext_path(dir, rel)) {
            Ok(content) => files.set(rel, content)
            Err(_) => ()
          }
        }
      }
      Err(_) => ()
    }
  }

  let static_dnr_rules : Array[DnrRule] = []
  for res in manifest.dnr_rule_resources {
    if !res.enabled {
      continue
    }
    match files.get(res.path) {
      Some(rjson) => match parse_dnr_rules_json(rjson) {
        Ok(rs) => {
          for r in rs {
            static_dnr_rules.push(r)
          }
        }
        Err(e) => return Err("failed to parse DNR rules " + res.path + ": " + e)
      }
      None => ()
    }
  }

  let assets : Map[String, Bytes] = Map::new()
  for k in files.keys() {
    match files.get(k) {
      Some(v) => assets.set(k, v.to_bytes())
      None => ()
    }
  }
  let id = match derive_chrome_id_from_key(manifest.key) {
    Some(cid) => cid
    None => derive_unpacked_extension_id(dir, manifest.name)
  }
  Ok(UnpackedExtension::{
    id: id,
    dir: dir,
    manifest: manifest,
    files: files,
    assets: assets,
    static_dnr_rules: static_dnr_rules,
  })
}

///| Loads an entire unpacked MV3 extension directory (all relative files, text + binary assets
///| such as `.wasm`, `.png`, `_locales/**`, ES modules, `popup.html`, etc.).
pub fn load_unpacked_extension_all_with(
  dir : String,
  rel_paths : Array[String],
  read_bytes : (String) -> Result[Bytes, String],
  max_files~ : Int = CRX3_DEFAULT_MAX_FILES,
  max_file_bytes~ : Int = CRX3_DEFAULT_MAX_FILE_BYTES,
  max_total_bytes~ : Int = CRX3_DEFAULT_MAX_TOTAL_BYTES,
) -> Result[UnpackedExtension, String] {
  let manifest_raw = match read_bytes(join_ext_path(dir, "manifest.json")) {
    Ok(b) => b
    Err(e) => return Err("failed to read manifest.json: " + e)
  }
  let manifest_json = manifest_raw.to_string()
  let manifest = match parse_manifest_v3(manifest_json) {
    Ok(m) => m
    Err(e) => return Err(e)
  }
  if rel_paths.length() > max_files {
    return Err("unpacked extension exceeds file count limit")
  }
  let files : Map[String, String] = Map::new()
  let assets : Map[String, Bytes] = Map::new()
  files.set("manifest.json", manifest_json)
  assets.set("manifest.json", manifest_raw)
  let mut total_bytes = manifest_raw.length()

  for raw_rel in rel_paths {
    let rel = normalize_rel_path(raw_rel)
    if rel == "" || rel == "manifest.json" {
      continue
    }
    if !is_safe_rel_path(rel) {
      return Err("unsafe extension asset path: " + raw_rel)
    }
    match read_bytes(join_ext_path(dir, rel)) {
      Ok(raw) => {
        if raw.length() > max_file_bytes {
          return Err("extension file exceeds size limit: " + rel)
        }
        total_bytes += raw.length()
        if total_bytes > max_total_bytes {
          return Err("extension total size exceeds limit")
        }
        assets.set(rel, raw)
        if is_text_asset_path(rel) {
          files.set(rel, raw.to_string())
        }
      }
      Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
    }
  }

  for res in manifest.dnr_rule_resources {
    if res.enabled && res.path != "" {
      let rel = normalize_rel_path(res.path)
      if !is_safe_rel_path(rel) {
        return Err("unsafe extension asset path: " + res.path)
      }
      if !files.contains(rel) {
        match read_bytes(join_ext_path(dir, rel)) {
          Ok(raw) => {
            assets.set(rel, raw)
            files.set(rel, raw.to_string())
          }
          Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
        }
      }
    }
  }
  for cs in manifest.content_scripts {
    for p in cs.css {
      let rel = normalize_rel_path(p)
      if !is_safe_rel_path(rel) {
        return Err("unsafe extension asset path: " + p)
      }
      if !files.contains(rel) {
        match read_bytes(join_ext_path(dir, rel)) {
          Ok(raw) => {
            assets.set(rel, raw)
            files.set(rel, raw.to_string())
          }
          Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
        }
      }
    }
    for p in cs.js {
      let rel = normalize_rel_path(p)
      if !is_safe_rel_path(rel) {
        return Err("unsafe extension asset path: " + p)
      }
      if !files.contains(rel) {
        match read_bytes(join_ext_path(dir, rel)) {
          Ok(raw) => {
            assets.set(rel, raw)
            files.set(rel, raw.to_string())
          }
          Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
        }
      }
    }
  }
  if manifest.background_service_worker != "" {
    let rel = normalize_rel_path(manifest.background_service_worker)
    if !is_safe_rel_path(rel) {
      return Err("unsafe extension asset path: " + manifest.background_service_worker)
    }
    if !files.contains(rel) {
      match read_bytes(join_ext_path(dir, rel)) {
        Ok(raw) => {
          assets.set(rel, raw)
          files.set(rel, raw.to_string())
        }
        Err(e) => return Err("failed to read extension asset " + rel + ": " + e)
      }
    }
  }

  let static_dnr_rules : Array[DnrRule] = []
  for res in manifest.dnr_rule_resources {
    if !res.enabled {
      continue
    }
    let rel = normalize_rel_path(res.path)
    match files.get(rel) {
      Some(rjson) => match parse_dnr_rules_json(rjson) {
        Ok(rs) => {
          for r in rs {
            static_dnr_rules.push(r)
          }
        }
        Err(e) => return Err("failed to parse DNR rules " + res.path + ": " + e)
      }
      None => ()
    }
  }

  let id = match derive_chrome_id_from_key(manifest.key) {
    Some(cid) => cid
    None => derive_unpacked_extension_id(dir, manifest.name)
  }
  Ok(UnpackedExtension::{
    id: id,
    dir: dir,
    manifest: manifest,
    files: files,
    assets: assets,
    static_dnr_rules: static_dnr_rules,
  })
}

///| Loads an unpacked MV3 extension directory from disk via `World`.
pub fn load_unpacked_extension(w : World, dir : String) -> Result[UnpackedExtension, String] {
  load_unpacked_extension_with(dir, fn(p : String) -> Result[String, String] {
    fs_read(w, p)
  })
}
