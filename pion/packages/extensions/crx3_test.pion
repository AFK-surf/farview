///| Unit tests for pure-Pion CRX3 container parser, hardened ZIP unpacker, and MV3 loader.

fn test_push_u16_le(out : Array[Int], v : Int) -> Unit {
  out.push(v & 0xFF)
  out.push((v >> 8) & 0xFF)
}

fn test_push_u32_le(out : Array[Int], v : Int) -> Unit {
  out.push(v & 0xFF)
  out.push((v >> 8) & 0xFF)
  out.push((v >> 16) & 0xFF)
  out.push((v >> 24) & 0xFF)
}

fn test_push_bytes(out : Array[Int], b : Bytes) -> Unit {
  let mut i = 0
  while i < b.length() {
    out.push(b[i].to_int() & 0xFF)
    i += 1
  }
}

fn test_arr_to_bytes(arr : Array[Int]) -> Bytes {
  let b = Bytes::new(arr.length())
  let mut i = 0
  while i < arr.length() {
    b[i] = (arr[i] & 0xFF).to_byte()
    i += 1
  }
  b
}

///| Builds a valid ZIP archive from `(path, method, payload, declared_uncomp_size)` tuples.
fn test_build_zip(entries : Array[(String, Int, Bytes, Int)]) -> Bytes {
  let buf : Array[Int] = []
  let cd : Array[Int] = []
  for item in entries {
    let (path, method, data, uncomp_sz) = item
    let pb = path.to_bytes()
    let lfh_off = buf.length()
    // Local file header signature
    test_push_u32_le(buf, 0x04034b50)
    test_push_u16_le(buf, 20)
    test_push_u16_le(buf, 0)
    test_push_u16_le(buf, method)
    test_push_u16_le(buf, 0)
    test_push_u16_le(buf, 0)
    test_push_u32_le(buf, 0)
    test_push_u32_le(buf, data.length())
    test_push_u32_le(buf, uncomp_sz)
    test_push_u16_le(buf, pb.length())
    test_push_u16_le(buf, 0)
    test_push_bytes(buf, pb)
    test_push_bytes(buf, data)

    // Central directory entry
    test_push_u32_le(cd, 0x02014b50)
    test_push_u16_le(cd, 20)
    test_push_u16_le(cd, 20)
    test_push_u16_le(cd, 0)
    test_push_u16_le(cd, method)
    test_push_u16_le(cd, 0)
    test_push_u16_le(cd, 0)
    test_push_u32_le(cd, 0)
    test_push_u32_le(cd, data.length())
    test_push_u32_le(cd, uncomp_sz)
    test_push_u16_le(cd, pb.length())
    test_push_u16_le(cd, 0)
    test_push_u16_le(cd, 0)
    test_push_u16_le(cd, 0)
    test_push_u16_le(cd, 0)
    test_push_u32_le(cd, 0)
    test_push_u32_le(cd, lfh_off)
    test_push_bytes(cd, pb)
  }
  let cd_off = buf.length()
  let mut i = 0
  while i < cd.length() {
    buf.push(cd[i])
    i += 1
  }
  // End of Central Directory
  test_push_u32_le(buf, 0x06054b50)
  test_push_u16_le(buf, 0)
  test_push_u16_le(buf, 0)
  test_push_u16_le(buf, entries.length())
  test_push_u16_le(buf, entries.length())
  test_push_u32_le(buf, cd.length())
  test_push_u32_le(buf, cd_off)
  test_push_u16_le(buf, 0)
  test_arr_to_bytes(buf)
}

///| Wraps a ZIP archive in a Chrome CRX3 container with an embedded 16-byte crx_id.
fn test_build_crx3(crx_id16 : Bytes, zip : Bytes) -> Bytes {
  // SignedData: field 1 (wire type 2 = 0x0A), len 16, crx_id16
  let sd : Array[Int] = [0x0A, 16]
  test_push_bytes(sd, crx_id16)
  // CrxFileHeader: field 10000 (wire type 2): (10000 << 3) | 2 = 80002 = 0x82 0xF1 0x04
  let hdr : Array[Int] = [0x82, 0xF1, 0x04, sd.length()]
  let mut i = 0
  while i < sd.length() {
    hdr.push(sd[i])
    i += 1
  }
  let out : Array[Int] = [0x43, 0x72, 0x32, 0x34] // "Cr24"
  test_push_u32_le(out, 3)
  test_push_u32_le(out, hdr.length())
  i = 0
  while i < hdr.length() {
    out.push(hdr[i])
    i += 1
  }
  test_push_bytes(out, zip)
  test_arr_to_bytes(out)
}

///| Wraps raw bytes in a valid uncompressed RFC 1951 DEFLATE stored block (method 8).
fn test_deflate_stored_block(raw : Bytes) -> Bytes {
  let n = raw.length()
  let out : Array[Int] = [0x01] // BFINAL=1, BTYPE=00 (stored)
  test_push_u16_le(out, n)
  test_push_u16_le(out, (n ^ 0xFFFF) & 0xFFFF)
  test_push_bytes(out, raw)
  test_arr_to_bytes(out)
}

test "CRX3 loader unpacks valid Stored + DEFLATE MV3 extension and derives Chrome ID" {
  let manifest = "{\"manifest_version\":3,\"name\":\"Shield Pro\",\"version\":\"3.0.1\",\"permissions\":[\"storage\",\"declarativeNetRequest\"],\"content_scripts\":[{\"matches\":[\"https://*.example.com/*\"],\"js\":[\"content.js\"],\"run_at\":\"document_idle\"}],\"declarative_net_request\":{\"rule_resources\":[{\"id\":\"r1\",\"enabled\":true,\"path\":\"rules.json\"}]}}"
  let content_js = "console.log('crx3 loaded');"
  let rules_json = "[{\"id\":5,\"priority\":1,\"action\":{\"type\":\"block\"},\"condition\":{\"urlFilter\":\"||tracker.test^\"}}]"
  let mb = manifest.to_bytes()
  let cb = content_js.to_bytes()
  let rb = rules_json.to_bytes()
  let zip = test_build_zip([
    ("manifest.json", 0, mb, mb.length()),
    ("content.js", 8, test_deflate_stored_block(cb), cb.length()),
    ("rules.json", 0, rb, rb.length()),
  ])
  let id16 = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    id16[i] = (i * 17).to_byte()
    i += 1
  }
  let crx = test_build_crx3(id16, zip)
  match load_crx3_extension(crx, source_label="shield.crx") {
    Ok(ext) => {
      debug_assert(ext.id.length() == 32, "Chrome 32-char extension ID derived: " + ext.id)
      debug_assert(ext.id == "aabbccddeeffgghhiijjkkllmmnnoopp", "exact Chrome nibble ID: " + ext.id)
      debug_assert(ext.manifest.name == "Shield Pro", "manifest name")
      debug_assert(ext.manifest.version == "3.0.1", "manifest version")
      debug_assert(ext.static_dnr_rules.length() == 1, "DNR rule parsed")
      match ext.files.get("content.js") {
        Some(js_src) => debug_assert(js_src == content_js, "DEFLATE content.js roundtrip")
        None => debug_assert(false, "missing content.js")
      }
    }
    Err(e) => debug_assert(false, "valid CRX3 failed: " + e)
  }
}

test "CRX3 and ZIP security: rejects bad magic, traversal, ZIP bombs, and MV2" {
  // 1. Bad magic
  match parse_crx3_container("NOTACRX3ARCHIVE1234567890".to_bytes()) {
    Ok(_) => debug_assert(false, "must reject bad magic")
    Err(e) => debug_assert(e.contains("magic"), "bad magic error: " + e)
  }

  // 2. Path traversal entry in ZIP
  let evil_zip = test_build_zip([
    ("../escape.js", 0, "evil()".to_bytes(), 6),
  ])
  match extract_zip_secure(evil_zip) {
    Ok(_) => debug_assert(false, "must reject path traversal")
    Err(e) => debug_assert(e.contains("unsafe archive path"), "traversal rejected: " + e)
  }

  // 3. ZIP bomb exceeding max_total_bytes during inflate
  let big_payload = Bytes::new(512)
  let bomb_zip = test_build_zip([
    ("manifest.json", 8, test_deflate_stored_block(big_payload), 16), // lies about uncomp_sz=16!
  ])
  match extract_zip_secure(bomb_zip, max_file_bytes=64, max_total_bytes=64) {
    Ok(_) => debug_assert(false, "must reject lying ZIP bomb exceeding limit")
    Err(e) => debug_assert(e.contains("limit exceeded"), "ZIP bomb rejected: " + e)
  }

  // 4. MV2 inside valid CRX3 must still be rejected
  let mv2 = "{\"manifest_version\":2,\"name\":\"Legacy\",\"version\":\"1.0\"}".to_bytes()
  let mv2_zip = test_build_zip([("manifest.json", 0, mv2, mv2.length())])
  let id16 = Bytes::new(16)
  let mv2_crx = test_build_crx3(id16, mv2_zip)
  match load_crx3_extension(mv2_crx) {
    Ok(_) => debug_assert(false, "MV2 CRX3 must be rejected")
    Err(e) => debug_assert(e.contains("expected 3"), "MV2 rejected: " + e)
  }
}
