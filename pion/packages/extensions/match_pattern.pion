///| Chrome Extensions URL Match Pattern engine (MV3).
///| Implements <all_urls>, *:// (http/https only), *.domain (exact or subdomain,
///| strictly rejecting suffix spoofing like evilyoutube.com), path globs, and exclude_matches.

fn ext_ascii_lower(s : String) -> String {
  let b = s.to_bytes()
  let out = Bytes::new(b.length())
  let mut i = 0
  while i < b.length() {
    let c = b[i].to_int() & 0xFF
    out[i] = if c >= 65 && c <= 90 { (c + 32).to_byte() } else { b[i] }
    i = i + 1
  }
  out.to_string()
}

fn find_substr(hay : String, needle : String, start : Int) -> Int {
  let hn = hay.length()
  let nn = needle.length()
  if nn == 0 {
    return start
  }
  if start < 0 || start + nn > hn {
    return -1
  }
  let mut i = start
  while i + nn <= hn {
    if hay.slice(i, i + nn) == needle {
      return i
    }
    i = i + 1
  }
  -1
}

///| Wildcard '*' glob match (linear backtracking with star anchor).
pub fn glob_match(pattern : String, text : String) -> Bool {
  let pn = pattern.length()
  let tn = text.length()
  let mut pi = 0
  let mut ti = 0
  let mut star_pi = -1
  let mut star_ti = 0
  while ti < tn {
    if pi < pn && pattern.code_unit_at(pi) == 42 {
      star_pi = pi
      star_ti = ti
      pi = pi + 1
    } else if pi < pn && pattern.code_unit_at(pi) == text.code_unit_at(ti) {
      pi = pi + 1
      ti = ti + 1
    } else if star_pi >= 0 {
      pi = star_pi + 1
      star_ti = star_ti + 1
      ti = star_ti
    } else {
      return false
    }
  }
  while pi < pn && pattern.code_unit_at(pi) == 42 {
    pi = pi + 1
  }
  pi == pn
}

///| Splits a URL into (scheme, host_without_port, path_and_query).
pub fn split_url_parts(url : String) -> Option[(String, String, String)] {
  let sep = find_substr(url, "://", 0)
  if sep <= 0 {
    return None
  }
  let scheme = ext_ascii_lower(url.slice(0, sep))
  let rest = url.slice(sep + 3, url.length())
  let slash = find_substr(rest, "/", 0)
  let (auth, path) = if slash < 0 {
    (rest, "/")
  } else {
    (rest.slice(0, slash), rest.slice(slash, rest.length()))
  }
  // Strip userinfo@ if present
  let at = find_substr(auth, "@", 0)
  let hostport = if at >= 0 { auth.slice(at + 1, auth.length()) } else { auth }
  // Strip :port (unless IPv6 [...])
  let host = if hostport.starts_with("[") {
    let rb = find_substr(hostport, "]", 0)
    if rb >= 0 { hostport.slice(0, rb + 1) } else { hostport }
  } else {
    let col = find_substr(hostport, ":", 0)
    if col >= 0 { hostport.slice(0, col) } else { hostport }
  }
  Some((scheme, ext_ascii_lower(host), path))
}

///| Checks whether `url` matches a Chrome Match Pattern.
pub fn match_url_pattern(pattern : String, url : String) -> Bool {
  let (u_scheme, u_host, u_path) = match split_url_parts(url) {
    Some(p) => p
    None => return false
  }
  if pattern == "<all_urls>" {
    return u_scheme == "http" || u_scheme == "https" || u_scheme == "file" || u_scheme == "ftp" || u_scheme == "ws" || u_scheme == "wss"
  }
  let sep = find_substr(pattern, "://", 0)
  if sep <= 0 {
    return false
  }
  let p_scheme = ext_ascii_lower(pattern.slice(0, sep))
  if p_scheme == "*" {
    if u_scheme != "http" && u_scheme != "https" {
      return false
    }
  } else if p_scheme != u_scheme {
    return false
  }

  let rest = pattern.slice(sep + 3, pattern.length())
  let slash = find_substr(rest, "/", 0)
  if slash < 0 {
    return false
  }
  let p_host = ext_ascii_lower(rest.slice(0, slash))
  let p_path = rest.slice(slash, rest.length())

  if p_scheme == "file" {
    if p_host != "" {
      return false
    }
  } else if p_host == "*" {
    if u_host == "" {
      return false
    }
  } else if p_host.starts_with("*.") {
    let base = p_host.slice(2, p_host.length())
    if base == "" || find_substr(base, "*", 0) >= 0 {
      return false
    }
    if u_host != base && !u_host.ends_with("." + base) {
      return false
    }
  } else {
    if find_substr(p_host, "*", 0) >= 0 {
      return false
    }
    if u_host != p_host {
      return false
    }
  }

  glob_match(p_path, u_path)
}

///| Checks whether `host` equals `domain` or is a subdomain of `domain`.
pub fn domain_matches(host : String, domain : String) -> Bool {
  let h = ext_ascii_lower(host)
  let d = ext_ascii_lower(domain)
  if d == "" {
    return false
  }
  h == d || h.ends_with("." + d)
}
