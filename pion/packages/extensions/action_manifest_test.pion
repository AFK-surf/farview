///| Unit tests for MV3 `action`, `options_page` / `options_ui`, `host_permissions`, `web_accessible_resources`,
///| and extension pages (popup / options) loaded from unpacked directories and `.crx3` packages.

fn mv3_ui_manifest() -> String {
  "{\"manifest_version\":3,\"name\":\"Tab Notes\",\"version\":\"1.4.2\",\"description\":\"Notes per tab\"," +
  "\"permissions\":[\"storage\",\"alarms\",\"contextMenus\",\"scripting\"],\"optional_permissions\":[\"tabs\"]," +
  "\"host_permissions\":[\"https://*.example.com/*\",\"<all_urls>\"]," +
  "\"icons\":{\"128\":\"icons/i128.png\",\"16\":\"icons/i16.png\",\"48\":\"icons/i48.png\"}," +
  "\"action\":{\"default_title\":\"Open Notes\",\"default_popup\":\"/popup/popup.html?x=1\",\"default_icon\":{\"32\":\"a32.png\",\"16\":\"a16.png\"}}," +
  "\"options_ui\":{\"page\":\"options.html\",\"open_in_tab\":false},\"options_page\":\"legacy_options.html\"," +
  "\"web_accessible_resources\":[{\"resources\":[\"img/*.png\",\"inject.js\"],\"matches\":[\"https://*.example.com/*\"]}]," +
  "\"background\":{\"service_worker\":\"bg.js\"}}"
}

test "MV3 action, options_ui, host_permissions, icons and web_accessible_resources parse" {
  match parse_manifest_v3(mv3_ui_manifest()) {
    Ok(m) => {
      debug_assert(m.description == "Notes per tab", "description")
      debug_assert(m.action.present, "action present")
      debug_assert(m.action.default_title == "Open Notes", "default_title")
      debug_assert(m.action.default_popup == "popup/popup.html", "popup cleaned: " + m.action.default_popup)
      debug_assert(m.action.default_icon.length() == 2 && m.action.default_icon[0].size == 16, "default_icon sorted")
      debug_assert(m.toolbar_icon(19) == "a32.png", "toolbar icon >= 19: " + m.toolbar_icon(19))
      debug_assert(m.toolbar_icon(64) == "a32.png", "largest action icon when none is big enough")
      debug_assert(m.icons.length() == 3 && m.icons[2].path == "icons/i128.png", "icons sorted ascending")
      debug_assert(m.action_title() == "Open Notes", "action_title")
      // options_ui wins over options_page
      debug_assert(m.options_page == "options.html", "options_ui.page wins: " + m.options_page)
      debug_assert(!m.options_open_in_tab, "options_ui open_in_tab false")
      debug_assert(m.host_permissions.length() == 2 && m.host_permissions[1] == "<all_urls>", "host_permissions")
      debug_assert(m.permissions.length() == 4 && m.optional_permissions[0] == "tabs", "permissions")
      debug_assert(m.web_accessible_resources.length() == 1, "1 WAR entry")
      debug_assert(m.is_web_accessible("img/logo.png", "https://app.example.com/x"), "WAR glob hit")
      debug_assert(m.is_web_accessible("/inject.js", "https://example.com/"), "WAR leading slash")
      debug_assert(!m.is_web_accessible("img/logo.png", "https://evil.test/"), "WAR rejects non-matching page")
      debug_assert(!m.is_web_accessible("bg.js", "https://app.example.com/"), "non-WAR file is private")
    }
    Err(e) => debug_assert(false, "manifest rejected: " + e)
  }
  // options_page alone always opens in a tab; no action -> title falls back to name; string default_icon
  let m2 = "{\"manifest_version\":3,\"name\":\"Solo\",\"version\":\"1\",\"options_page\":\"./opt.html\",\"action\":{\"default_icon\":\"one.png\"},\"web_accessible_resources\":[\"a.css\"]}"
  match parse_manifest_v3(m2) {
    Ok(m) => {
      debug_assert(m.options_page == "opt.html" && m.options_open_in_tab, "options_page in a tab")
      debug_assert(m.action.present && m.action.default_popup == "", "action without popup")
      debug_assert(m.action_title() == "Solo", "title falls back to name")
      debug_assert(m.toolbar_icon(16) == "one.png", "string default_icon")
      debug_assert(m.is_web_accessible("a.css", "https://any.test/"), "MV2-style WAR list reachable")
    }
    Err(e) => debug_assert(false, "m2 rejected: " + e)
  }
  let m3 = "{\"manifest_version\":3,\"name\":\"Bare\",\"version\":\"1\"}"
  match parse_manifest_v3(m3) {
    Ok(m) => debug_assert(!m.action.present && m.options_page == "" && m.toolbar_icon(16) == "", "bare manifest")
    Err(e) => debug_assert(false, "m3 rejected: " + e)
  }
}

test "extension page asset refs resolve relative, root-relative and reject escapes" {
  let html = "<html><head><link rel=stylesheet href=\"popup.css\"><script src='../shared/lib.js'></script>" +
  "<script src=\"/root.js?v=2\"></script><script src=\"https://cdn.test/x.js\"></script>" +
  "<img src=\"data:image/png;base64,AA\"><a href=\"#top\">t</a><img data-src=\"skip.png\">" +
  "<script src=\"../../escape.js\"></script><script src=\"popup.css\"></script></head></html>"
  let refs = ext_page_asset_refs("popup/popup.html", html)
  debug_assert(refs.length() == 3, "3 refs: " + refs.join(","))
  debug_assert(refs[0] == "shared/lib.js" && refs[1] == "root.js" && refs[2] == "popup/popup.css", "refs: " + refs.join(","))
}

test "unpacked loader reads popup, options page and their assets (missing ones are optional)" {
  let disk : Map[String, String] = Map::new()
  disk.set("/ext/manifest.json", mv3_ui_manifest())
  disk.set("/ext/bg.js", "chrome.runtime.onInstalled.addListener(() => {});")
  disk.set("/ext/popup/popup.html", "<script src=\"popup.js\"></script><link href=\"missing.css\">")
  disk.set("/ext/popup/popup.js", "document.title = 'p';")
  disk.set("/ext/options.html", "<p>opts</p>")
  match load_unpacked_extension_with("/ext", fn(p : String) -> Result[String, String] {
    match disk.get(p) {
      Some(s) => Ok(s)
      None => Err("enoent " + p)
    }
  }) {
    Ok(u) => {
      debug_assert(u.files.contains("popup/popup.html"), "popup html loaded")
      debug_assert(u.files.contains("popup/popup.js"), "popup script loaded")
      debug_assert(!u.files.contains("popup/missing.css"), "missing asset skipped")
      debug_assert(u.files.contains("options.html"), "options page loaded")
      debug_assert(u.manifest.action.default_popup == "popup/popup.html", "popup path")
    }
    Err(e) => debug_assert(false, "load failed: " + e)
  }
}

test "CRX3 package with action popup and options_ui loads its extension pages" {
  let popup = "<script src=\"popup.js\"></script>"
  let manifest = "{\"manifest_version\":3,\"name\":\"Crx Popup\",\"version\":\"3.0\",\"host_permissions\":[\"https://*.news.test/*\"]," +
  "\"action\":{\"default_title\":\"Crx\",\"default_popup\":\"popup.html\"},\"options_ui\":{\"page\":\"opts.html\",\"open_in_tab\":true}}"
  let zip = test_build_zip([
    ("manifest.json", 0, manifest.to_bytes(), manifest.to_bytes().length()),
    ("popup.html", 0, popup.to_bytes(), popup.to_bytes().length()),
    ("popup.js", 0, "1".to_bytes(), 1),
    ("opts.html", 0, "<b>o</b>".to_bytes(), 8),
  ])
  let id16 = Bytes::new(16)
  let mut i = 0
  while i < 16 {
    id16[i] = (i * 17).to_byte()
    i += 1
  }
  match load_crx3_extension(test_build_crx3(id16, zip), source_label="popup.crx") {
    Ok(u) => {
      debug_assert(u.id.length() == 32, "chrome id from header: " + u.id)
      debug_assert(u.manifest.action.default_title == "Crx", "crx action title")
      debug_assert(u.manifest.options_page == "opts.html" && u.manifest.options_open_in_tab, "crx options_ui")
      debug_assert(u.manifest.host_permissions[0] == "https://*.news.test/*", "crx host_permissions")
      debug_assert(u.files.get("popup.html") == Some(popup), "crx popup html")
      debug_assert(u.files.contains("popup.js") && u.files.contains("opts.html"), "crx popup script + options page")
    }
    Err(e) => debug_assert(false, "crx load failed: " + e)
  }
}
