///| RFC 8439 ChaCha20 stream cipher (pure Pion, zero World dependencies).

fn cc_rotl(x : UInt, n : UInt) -> UInt {
  (x << n) | (x >> (32U - n))
}

fn cc_le32(b : Bytes, off : Int) -> UInt {
  b[off].to_int().to_uint() |
  (b[off + 1].to_int().to_uint() << 8U) |
  (b[off + 2].to_int().to_uint() << 16U) |
  (b[off + 3].to_int().to_uint() << 24U)
}

fn cc_quarter(s : FixedArray[UInt], a : Int, b : Int, c : Int, d : Int) -> Unit {
  s[a] = s[a] + s[b]
  s[d] = cc_rotl(s[d] ^ s[a], 16U)
  s[c] = s[c] + s[d]
  s[b] = cc_rotl(s[b] ^ s[c], 12U)
  s[a] = s[a] + s[b]
  s[d] = cc_rotl(s[d] ^ s[a], 8U)
  s[c] = s[c] + s[d]
  s[b] = cc_rotl(s[b] ^ s[c], 7U)
}

///| One 64-byte ChaCha20 keystream block for `key` (32 bytes), `counter` and `nonce` (12 bytes).
pub fn chacha20_block(key : Bytes, counter : UInt, nonce : Bytes) -> Bytes {
  let init : FixedArray[UInt] = FixedArray::make(16, 0U)
  init[0] = 0x61707865U
  init[1] = 0x3320646eU
  init[2] = 0x79622d32U
  init[3] = 0x6b206574U
  let mut i = 0
  while i < 8 {
    init[4 + i] = cc_le32(key, i * 4)
    i = i + 1
  }
  init[12] = counter
  init[13] = cc_le32(nonce, 0)
  init[14] = cc_le32(nonce, 4)
  init[15] = cc_le32(nonce, 8)
  let s : FixedArray[UInt] = FixedArray::make(16, 0U)
  i = 0
  while i < 16 {
    s[i] = init[i]
    i = i + 1
  }
  let mut r = 0
  while r < 10 {
    cc_quarter(s, 0, 4, 8, 12)
    cc_quarter(s, 1, 5, 9, 13)
    cc_quarter(s, 2, 6, 10, 14)
    cc_quarter(s, 3, 7, 11, 15)
    cc_quarter(s, 0, 5, 10, 15)
    cc_quarter(s, 1, 6, 11, 12)
    cc_quarter(s, 2, 7, 8, 13)
    cc_quarter(s, 3, 4, 9, 14)
    r = r + 1
  }
  let out = Bytes::new(64)
  i = 0
  while i < 16 {
    let v = s[i] + init[i]
    out[i * 4] = (v & 0xFFU).to_int().to_byte()
    out[i * 4 + 1] = ((v >> 8U) & 0xFFU).to_int().to_byte()
    out[i * 4 + 2] = ((v >> 16U) & 0xFFU).to_int().to_byte()
    out[i * 4 + 3] = ((v >> 24U) & 0xFFU).to_int().to_byte()
    i = i + 1
  }
  out
}

///| XORs `data` with the ChaCha20 keystream starting at block `counter` (encryption and decryption alike).
pub fn chacha20_xor(key : Bytes, counter : UInt, nonce : Bytes, data : Bytes) -> Bytes {
  let n = data.length()
  let out = Bytes::new(n)
  let mut off = 0
  let mut ctr = counter
  while off < n {
    let ks = chacha20_block(key, ctr, nonce)
    let mut j = 0
    while j < 64 && off + j < n {
      out[off + j] = (data[off + j].to_int() ^ ks[j].to_int()).to_byte()
      j = j + 1
    }
    off = off + 64
    ctr = ctr + 1U
  }
  out
}
