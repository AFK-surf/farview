///| Credential vault tests: RFC 8439 vectors, encrypted-at-rest, origin/subdomain matching, upsert/update/delete/
///| search, the generator's entropy and the idempotent CSV import bridge.

import "crypto"
import "migrate"

fn[T] t_some(o : Option[T]) -> T {
  match o {
    Some(x) => x
    None => abort("expected Some")
  }
}

fn t_key(seed : Int) -> Bytes {
  let k = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    k[i] = ((i * 7 + seed) & 255).to_byte()
    i = i + 1
  }
  k
}

fn t_nonce(seed : Int) -> Bytes {
  let n = Bytes::new(12)
  let mut i = 0
  while i < 12 {
    n[i] = ((i * 13 + seed) & 255).to_byte()
    i = i + 1
  }
  n
}

fn t_contains_bytes(hay : Bytes, needle : Bytes) -> Bool {
  let mut i = 0
  while i + needle.length() <= hay.length() {
    let mut j = 0
    while j < needle.length() && hay[i + j] == needle[j] {
      j = j + 1
    }
    if j == needle.length() {
      return true
    }
    i = i + 1
  }
  false
}

///| A deterministic stand-in for the OS random source (SplitMix-like), for repeatable tests.
fn t_rand(seed : Int) -> (Int) -> Bytes {
  let state : Array[Int64] = [seed.to_int64() * 0x9E3779B9L + 1L]
  fn(n : Int) -> Bytes {
    let out = Bytes::new(n)
    let mut i = 0
    while i < n {
      state[0] = state[0] * 6364136223846793005L + 1442695040888963407L
      out[i] = ((state[0] >> 33).to_int() & 255).to_byte()
      i = i + 1
    }
    out
  }
}

test "passwords: ChaCha20 matches the RFC 8439 block and encryption vectors" {
  let key = Bytes::new(32)
  let mut i = 0
  while i < 32 {
    key[i] = i.to_byte()
    i = i + 1
  }
  let n1 = t_some(crypto::hex_to_bytes("000000090000004a00000000"))
  debug_assert(
    crypto::bytes_to_hex(chacha20_block(key, 1U, n1)) ==
    "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e",
    "RFC 8439 2.3.2 block",
  )
  let n2 = t_some(crypto::hex_to_bytes("000000000000004a00000000"))
  let pt = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
  let ct = chacha20_xor(key, 1U, n2, pt.to_bytes())
  debug_assert(
    crypto::bytes_to_hex(ct) ==
    "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d",
    "RFC 8439 2.4.2 encryption",
  )
  debug_assert(chacha20_xor(key, 1U, n2, ct).to_string() == pt, "decrypts back")
}

test "passwords: the sealed vault holds no plaintext, and a wrong key or a flipped byte does not open" {
  let v = Vault::new()
  let secret = "correct horse battery staple 42!"
  let _ = v.upsert("https://accounts.example.com/login", "ada@example.com", secret, 1700000000L)
  let sealed = t_some(seal_vault(v, t_key(1), t_nonce(1)))
  debug_assert(!t_contains_bytes(sealed, secret.to_bytes()), "raw bytes hold no password")
  debug_assert(!t_contains_bytes(sealed, "ada@example.com".to_bytes()), "nor the username")
  debug_assert(!t_contains_bytes(sealed, "accounts.example.com".to_bytes()), "nor the site")
  debug_assert(t_contains_bytes(sealed, "FVPW".to_bytes()), "magic header")
  match open_vault(sealed, t_key(1)) {
    Ok(back) => {
      debug_assert(back.length() == 1, "one login")
      debug_assert(back.entries()[0].password == secret && back.entries()[0].username == "ada@example.com", "restored")
    }
    Err(e) => debug_assert(false, "opens with its key: " + e)
  }
  debug_assert(open_vault(sealed, t_key(2)) is Err(_), "wrong key fails")
  let tampered = Bytes::new(sealed.length())
  let mut i = 0
  while i < sealed.length() {
    tampered[i] = sealed[i]
    i = i + 1
  }
  tampered[20] = (tampered[20].to_int() ^ 1).to_byte()
  debug_assert(open_vault(tampered, t_key(1)) is Err(_), "a flipped ciphertext byte fails")
  debug_assert(open_vault("FVPW".to_bytes(), t_key(1)) is Err(_), "short file fails")
  // (two seals of the same vault under different nonces differ everywhere past the header)
  let other = t_some(seal_vault(v, t_key(1), t_nonce(2)))
  debug_assert(crypto::bytes_to_hex(other) != crypto::bytes_to_hex(sealed), "fresh nonce, fresh ciphertext")
  debug_assert(seal_vault(v, Bytes::new(16), t_nonce(1)).is_none(), "short key refused")
}

test "passwords: origin matching is exact or same-site with the same scheme and port" {
  debug_assert(normalize_origin("HTTPS://Accounts.Example.com:443/login?x=1") == "https://accounts.example.com", "normalized")
  debug_assert(normalize_origin("javascript:alert(1)") == "", "not http(s)")
  debug_assert(signon_realm_of("https://example.com/a") == "https://example.com/", "realm")
  debug_assert(origin_match("https://example.com", "https://example.com/login") == 2, "exact")
  debug_assert(origin_match("https://accounts.example.com", "https://www.example.com/") == 1, "same site")
  debug_assert(origin_match("https://example.com", "https://login.example.com/") == 1, "apex to subdomain")
  debug_assert(origin_match("https://example.com", "http://example.com/") == 0, "never across schemes")
  debug_assert(origin_match("https://example.com:8443", "https://example.com/") == 0, "never across ports")
  debug_assert(origin_match("https://example.com", "https://example.org/") == 0, "other site")
  debug_assert(origin_match("https://example.com", "https://example.com.evil.net/") == 0, "lookalike suffix")
  debug_assert(origin_match("https://alice.github.io", "https://bob.github.io/") == 0, "private suffix splits sites")
  debug_assert(origin_match("https://a.example.co.uk", "https://b.example.co.uk/") == 1, "multi-label suffix")
  debug_assert(origin_match("https://foo.co.uk", "https://bar.co.uk/") == 0, "public suffix is no site")
  debug_assert(origin_match("http://10.0.0.1", "http://10.0.0.2/") == 0, "IPs match only exactly")
  debug_assert(origin_match("http://10.0.0.1", "http://10.0.0.1/x") == 2, "same IP")
  let v = Vault::new()
  let _ = v.upsert("https://accounts.example.com", "site-user", "p1", 10L)
  let _ = v.upsert("https://www.example.com", "exact-user", "p2", 11L)
  let _ = v.upsert("https://example.org", "other", "p3", 12L)
  let m = v.matches_for("https://www.example.com/signin")
  debug_assert(m.length() == 2, "exact and same-site, not the other site")
  let (first, ex1) = m[0]
  let (second, ex2) = m[1]
  debug_assert(first.username == "exact-user" && ex1, "exact first")
  debug_assert(second.username == "site-user" && !ex2, "same-site after, marked inexact")
}

test "passwords: upsert, update, delete, search and never-save" {
  let v = Vault::new()
  let id = match v.upsert("https://example.com/login", " ada ", "one", 100L) {
    UpsertOutcome::Added(id) => id
    _ => {
      debug_assert(false, "added")
      ""
    }
  }
  debug_assert(id.starts_with("pw-") && id.length() == 19, "id")
  debug_assert(t_some(v.get(id)).username == "ada", "username trimmed")
  debug_assert(t_some(v.get(id)).display_name == "example.com", "name defaults to the host")
  debug_assert(v.upsert("https://example.com/other", "ada", "one", 101L) is UpsertOutcome::Unchanged(_), "same password")
  match v.upsert("https://example.com/", "ada", "two", 102L) {
    UpsertOutcome::Updated(uid) => debug_assert(uid == id, "same login updated")
    _ => debug_assert(false, "updated")
  }
  debug_assert(t_some(v.get(id)).password == "two" && t_some(v.get(id)).updated_at == 102L, "new password")
  debug_assert(t_some(v.get(id)).created_at == 100L, "created kept")
  debug_assert(v.upsert("ftp://example.com", "a", "b", 1L) is UpsertOutcome::Rejected, "non-http rejected")
  debug_assert(v.upsert("https://example.com", "a", "", 1L) is UpsertOutcome::Rejected, "empty password rejected")
  let id2 = match v.upsert("https://github.com/session", "octo", "gh", 103L) {
    UpsertOutcome::Added(x) => x
    _ => ""
  }
  debug_assert(id2 != "" && id2 != id, "second login, own id")
  debug_assert(t_some(v.find_login("https://github.com/x", "octo")).id == id2, "find_login")
  // update
  debug_assert(v.update(id, 200L, username="ada.l", password="three"), "update")
  debug_assert(t_some(v.get(id)).username == "ada.l" && t_some(v.get(id)).password == "three", "updated fields")
  let _ = v.upsert("https://example.com", "bob", "b", 201L)
  debug_assert(!v.update(id, 202L, username="bob"), "no two logins of one origin share a username")
  debug_assert(!v.update("pw-missing", 1L, password="x"), "missing id")
  // mark used
  v.mark_used(id2, 300L)
  debug_assert(t_some(v.get(id2)).times_used == 1 && t_some(v.get(id2)).last_used_at == 300L, "used")
  // search
  debug_assert(v.search("").length() == 3, "all")
  debug_assert(v.search("GITHUB").length() == 1, "case-insensitive origin")
  debug_assert(v.search("ada").length() == 1 && v.search("ada")[0].id == id, "username")
  debug_assert(v.search("example")[0].username == "ada.l", "sorted by host then username")
  let sums = v.summaries(query="octo")
  debug_assert(sums.length() == 1 && sums[0].id == id2, "summaries filter")
  // delete
  debug_assert(v.delete(id2), "deleted")
  debug_assert(!v.delete(id2), "already gone")
  debug_assert(v.get(id2).is_none() && v.length() == 2, "two left")
  // never
  debug_assert(!v.is_never("https://example.net/a"), "not yet")
  v.set_never("https://example.net/login")
  debug_assert(v.is_never("https://example.net/other"), "never-save by origin")
  match open_vault(t_some(seal_vault(v, t_key(3), t_nonce(3))), t_key(3)) {
    Ok(back) => {
      debug_assert(back.is_never("https://example.net/") && back.length() == 2, "never list and logins persist")
      // ids from a reopened vault never collide with ids already handed out
      match back.upsert("https://new.example", "n", "n", 400L) {
        UpsertOutcome::Added(nid) => debug_assert(nid != id && nid != id2, "fresh id")
        _ => debug_assert(false, "added after reopen")
      }
    }
    Err(e) => debug_assert(false, e)
  }
  let csv = v.export_csv()
  debug_assert(csv.starts_with("name,url,username,password,note\n") && csv.contains("ada.l,three"), "export CSV")
}

test "passwords: generated passwords are uniform over a strong alphabet with every class" {
  let rand = t_rand(7)
  let seen : Map[String, Bool] = Map::new()
  let mut k = 0
  while k < 200 {
    let p = generate_password(20, true, rand)
    debug_assert(p.length() == 20, "length")
    let mut lo = false
    let mut up = false
    let mut di = false
    let mut sy = false
    let mut i = 0
    while i < p.length() {
      let c = p.slice(i, i + 1)
      if PW_GEN_LOWER.contains(c) {
        lo = true
      } else if PW_GEN_UPPER.contains(c) {
        up = true
      } else if PW_GEN_DIGITS.contains(c) {
        di = true
      } else if PW_GEN_SYMBOLS.contains(c) {
        sy = true
      } else {
        debug_assert(false, "character outside the alphabet: " + c)
      }
      i = i + 1
    }
    debug_assert(lo && up && di && sy, "every class present")
    debug_assert(!seen.contains(p), "no repeats")
    seen[p] = true
    k = k + 1
  }
  debug_assert(generate_password(3, false, rand).length() == PW_GEN_MIN_LEN, "clamped up")
  debug_assert(generate_password(999, false, rand).length() == PW_GEN_MAX_LEN, "clamped down")
  let plain = generate_password(64, false, rand)
  let mut i = 0
  while i < plain.length() {
    debug_assert(!PW_GEN_SYMBOLS.contains(plain.slice(i, i + 1)), "no symbols when not asked")
    i = i + 1
  }
  // entropy: 71 symbols -> ~6.15 bits each, 20 chars > 120 bits; 57 letters+digits -> ~5.83 bits
  let e20 = password_entropy_bits(20, true)
  debug_assert(e20 > 122.0 && e20 < 124.0, "20 chars with symbols ~123 bits (\{e20})")
  let e16 = password_entropy_bits(16, false)
  debug_assert(e16 > 93.0 && e16 < 94.0, "16 chars, letters and digits ~93.3 bits (\{e16})")
  // empirical spread: every alphabet character turns up over many draws (no class or position left out)
  let counts : Map[String, Int] = Map::new()
  let mut d = 0
  while d < 100 {
    let p = generate_password(64, true, rand)
    let mut j = 0
    while j < p.length() {
      let c = p.slice(j, j + 1)
      counts[c] = counts.get(c).unwrap_or(0) + 1
      j = j + 1
    }
    d = d + 1
  }
  let alpha = password_alphabet(true)
  let mut a = 0
  while a < alpha.length() {
    let n = counts.get(alpha.slice(a, a + 1)).unwrap_or(0)
    // 6400 draws / 71 ~ 90 expected per character
    debug_assert(n > 40 && n < 160, "character " + alpha.slice(a, a + 1) + " drawn \{n} times")
    a = a + 1
  }
}

test "passwords: CSV import from another browser is idempotent and skips unsafe rows" {
  let csv = "name,url,username,password,note\n" +
  "Example,https://example.com/login,ada,pw-one,\n" +
  "GitHub,https://github.com/session,octo,\"p,w\"\"2\",note\n" +
  "Evil,javascript:alert(1),x,y,\n" +
  "Empty,https://empty.example,u,,\n"
  let (rows, parse_skipped) = migrate::parse_passwords_csv(csv)
  let v = Vault::new()
  let c1 = import_migrated(v, rows, 500L)
  debug_assert(c1.added == 2, "two logins added (\{c1.added})")
  debug_assert(parse_skipped + c1.skipped == 2, "the javascript: and the empty-password rows skipped")
  debug_assert(t_some(v.find_login("https://github.com/", "octo")).password == "p,w\"2", "quoted CSV password")
  debug_assert(t_some(v.find_login("https://example.com/", "ada")).display_name == "Example", "CSV name kept")
  let c2 = import_migrated(v, rows, 600L)
  debug_assert(c2.added == 0 && c2.updated == 0 && c2.unchanged == 2, "second import changes nothing")
  debug_assert(v.length() == 2, "still two")
  let (rows3, _) = migrate::parse_passwords_csv("name,url,username,password\nExample,https://example.com/,ada,pw-new\n")
  let c3 = import_migrated(v, rows3, 700L)
  debug_assert(c3.updated == 1 && t_some(v.find_login("https://example.com", "ada")).password == "pw-new", "new password updates")
  // export -> import into a new vault round-trips
  let (rows4, _) = migrate::parse_passwords_csv(v.export_csv())
  let w = Vault::new()
  let c4 = import_migrated(w, rows4, 800L)
  debug_assert(c4.added == 2 && t_some(w.find_login("https://github.com", "octo")).password == "p,w\"2", "export round-trips")
}
