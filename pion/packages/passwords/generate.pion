///| Strong password generator: uniform draws from a cryptographic random source passed in by the host (rejection
///| sampling, no modulo bias), at least one character of each class, then a Fisher-Yates shuffle.

pub let PW_GEN_MIN_LEN : Int = 8
pub let PW_GEN_MAX_LEN : Int = 128
pub let PW_GEN_DEFAULT_LEN : Int = 20

///| Letters and digits that are not mistaken for one another (no `l`, `I`, `O`, `0`, `1`).
pub let PW_GEN_LOWER : String = "abcdefghijkmnopqrstuvwxyz"
pub let PW_GEN_UPPER : String = "ABCDEFGHJKLMNPQRSTUVWXYZ"
pub let PW_GEN_DIGITS : String = "23456789"
pub let PW_GEN_SYMBOLS : String = "-_.!@#$%^&*+=?"

struct PwRng {
  rand : (Int) -> Bytes
  mut buf : Bytes
  mut at : Int
}

fn PwRng::byte(self : PwRng) -> Int {
  if self.at >= self.buf.length() {
    self.buf = (self.rand)(64)
    self.at = 0
    if self.buf.length() == 0 {
      abort("password generator: random source gave no bytes")
    }
  }
  let b = self.buf[self.at].to_int()
  self.at = self.at + 1
  b
}

///| A uniform integer in `[0, n)` for `1 <= n <= 256`.
fn PwRng::below(self : PwRng, n : Int) -> Int {
  let limit = 256 - 256 % n
  while true {
    let b = self.byte()
    if b < limit {
      return b % n
    }
  }
  0
}

pub fn password_alphabet(symbols : Bool) -> String {
  PW_GEN_LOWER + PW_GEN_UPPER + PW_GEN_DIGITS + (if symbols { PW_GEN_SYMBOLS } else { "" })
}

///| Bits of entropy of a password drawn uniformly from the generator's alphabet: `len * log2(alphabet size)` (the
///| one-of-each-class rule takes away well under one bit).
pub fn password_entropy_bits(len : Int, symbols : Bool) -> Double {
  // log2 of the alphabet size: whole bits by halving, the fraction by repeated squaring
  let mut x = password_alphabet(symbols).length().to_double()
  let mut bits = 0.0
  while x >= 2.0 {
    x = x / 2.0
    bits = bits + 1.0
  }
  let mut f = 0.5
  let mut i = 0
  while i < 24 {
    x = x * x
    if x >= 2.0 {
      x = x / 2.0
      bits = bits + f
    }
    f = f / 2.0
    i = i + 1
  }
  bits * len.to_double()
}

///| A new password of `len` characters (clamped to 8..128) with lower, upper and digits (and symbols when asked),
///| each at least once.
pub fn generate_password(len : Int, symbols : Bool, rand : (Int) -> Bytes) -> String {
  let n = if len < PW_GEN_MIN_LEN {
    PW_GEN_MIN_LEN
  } else if len > PW_GEN_MAX_LEN {
    PW_GEN_MAX_LEN
  } else {
    len
  }
  let rng = PwRng::{ rand, buf: Bytes::new(0), at: 0 }
  let classes = if symbols {
    [PW_GEN_LOWER, PW_GEN_UPPER, PW_GEN_DIGITS, PW_GEN_SYMBOLS]
  } else {
    [PW_GEN_LOWER, PW_GEN_UPPER, PW_GEN_DIGITS]
  }
  let all = password_alphabet(symbols)
  let chars : Array[String] = []
  for c in classes {
    let k = rng.below(c.length())
    chars.push(c.slice(k, k + 1))
  }
  while chars.length() < n {
    let k = rng.below(all.length())
    chars.push(all.slice(k, k + 1))
  }
  // Fisher-Yates (the class characters end up anywhere)
  let mut i = chars.length() - 1
  while i > 0 {
    let j = rng.below(i + 1)
    let t = chars[i]
    chars[i] = chars[j]
    chars[j] = t
    i = i - 1
  }
  chars.join("")
}
