///| Deterministic E2E tests for CJK IME composition events and OS clipboard shortcuts (`os_platform`).

test "CJK IME compositionstart/update/end updates input, textarea, and contenteditable" {
  let html = "<!doctype html><html><body>" +
  "<input id='inp' type='text' value=''>" +
  "<textarea id='ta'></textarea>" +
  "<div id='ce' contenteditable='true'></div>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")

  // 1. <input>
  let _ = eval(
    "globalThis.__log1 = [];" +
    "const inp = document.getElementById('inp');" +
    "inp.focus();" +
    "inp.addEventListener('compositionstart', e => globalThis.__log1.push('cs:' + e.data));" +
    "inp.addEventListener('compositionupdate', e => globalThis.__log1.push('cu:' + e.data));" +
    "inp.addEventListener('compositionend', e => globalThis.__log1.push('ce:' + e.data));" +
    "inp.addEventListener('input', e => globalThis.__log1.push('in:' + e.inputType + ':' + e.isComposing + ':' + e.data));",
  )
  compose_start(data="")
  compose_update("ni'hao")
  compose_end("你好")
  let v1 = eval("document.getElementById('inp').value")
  let l1 = eval("globalThis.__log1.join('|')")
  debug_assert(v1 == "你好", "input value must be 你好, got: " + v1)
  debug_assert(
    l1 == "cs:|cu:ni'hao|in:insertCompositionText:true:ni'hao|ce:你好|in:insertFromComposition:false:你好",
    "input IME event sequence mismatch: " + l1,
  )

  // 2. <textarea> via edit_composing(phase, data)
  let _ = eval(
    "globalThis.__log2 = [];" +
    "const ta = document.getElementById('ta');" +
    "ta.focus();" +
    "ta.addEventListener('compositionstart', e => globalThis.__log2.push('cs:' + e.data));" +
    "ta.addEventListener('compositionupdate', e => globalThis.__log2.push('cu:' + e.data));" +
    "ta.addEventListener('compositionend', e => globalThis.__log2.push('ce:' + e.data));" +
    "ta.addEventListener('input', e => globalThis.__log2.push('in:' + e.inputType + ':' + e.isComposing + ':' + e.data));",
  )
  edit_composing(0, "")
  edit_composing(1, "zhong'wen")
  edit_composing(2, "中文测试")
  let v2 = eval("document.getElementById('ta').value")
  let l2 = eval("globalThis.__log2.join('|')")
  debug_assert(v2 == "中文测试", "textarea value must be 中文测试, got: " + v2)
  debug_assert(
    l2 == "cs:|cu:zhong'wen|in:insertCompositionText:true:zhong'wen|ce:中文测试|in:insertFromComposition:false:中文测试",
    "textarea IME event sequence mismatch: " + l2,
  )

  // 3. contenteditable
  let _ = eval(
    "globalThis.__log3 = [];" +
    "const ce = document.getElementById('ce');" +
    "ce.focus();" +
    "ce.addEventListener('compositionstart', e => globalThis.__log3.push('cs:' + e.data));" +
    "ce.addEventListener('compositionupdate', e => globalThis.__log3.push('cu:' + e.data));" +
    "ce.addEventListener('compositionend', e => globalThis.__log3.push('ce:' + e.data));" +
    "ce.addEventListener('input', e => globalThis.__log3.push('in:' + e.inputType + ':' + e.isComposing + ':' + e.data));",
  )
  compose_start(data="")
  compose_update("tui'te")
  compose_end("推特中文")
  let v3 = eval("document.getElementById('ce').textContent")
  let l3 = eval("globalThis.__log3.join('|')")
  debug_assert(v3 == "推特中文", "contenteditable textContent must be 推特中文, got: " + v3)
  debug_assert(
    l3 == "cs:|cu:tui'te|in:insertCompositionText:true:tui'te|ce:推特中文|in:insertFromComposition:false:推特中文",
    "contenteditable IME event sequence mismatch: " + l3,
  )
}

test "copy, cut, paste, and select_all round-trip through os_platform clipboard (mem mode)" {
  os_platform::clipboard_set_mem_mode(true)
  let _ = os_platform::clipboard_clear()
  let _ = take_copied()

  let html = "<!doctype html><html><body>" +
  "<input id='src' type='text' value='你好 Farview 剪贴板'>" +
  "<input id='dst' type='text' value=''>" +
  "<textarea id='ta'>第一行内容</textarea>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")

  // 1. select_all + copy_selection on #src
  let _ = eval("document.getElementById('src').focus();")
  debug_assert(select_all(), "select_all should return true")
  let copied = copy_selection()
  debug_assert(copied == "你好 Farview 剪贴板", "copy_selection mismatch: " + copied)
  debug_assert(
    os_platform::clipboard_read_text().unwrap_or("") == "你好 Farview 剪贴板",
    "os_platform clipboard must hold copied CJK text",
  )
  debug_assert(take_copied().unwrap_or("") == "你好 Farview 剪贴板", "take_copied must report copied text")

  // 2. paste_text() (reading from os_platform clipboard) into #dst
  let _ = eval(
    "globalThis.__pasted = '';" +
    "const dst = document.getElementById('dst');" +
    "dst.focus();" +
    "dst.addEventListener('paste', e => { globalThis.__pasted = e.clipboardData ? e.clipboardData.getData('text/plain') : ''; });",
  )
  debug_assert(paste_text(), "paste_text from os_platform should return true")
  let dst_val = eval("document.getElementById('dst').value")
  let paste_ev = eval("globalThis.__pasted")
  debug_assert(dst_val == "你好 Farview 剪贴板", "dst value after paste mismatch: " + dst_val)
  debug_assert(paste_ev == "你好 Farview 剪贴板", "paste event clipboardData mismatch: " + paste_ev)

  // 3. select_all + cut_selection on #ta, then paste back
  let _ = eval("document.getElementById('ta').focus();")
  debug_assert(select_all(), "select_all on textarea")
  let cut_txt = cut_selection()
  debug_assert(cut_txt == "第一行内容", "cut_selection mismatch: " + cut_txt)
  debug_assert(eval("document.getElementById('ta').value") == "", "textarea should be empty after cut")
  debug_assert(
    os_platform::clipboard_read_text().unwrap_or("") == "第一行内容",
    "os_platform clipboard must hold cut text",
  )
  debug_assert(paste_text(), "paste back cut text into textarea")
  debug_assert(eval("document.getElementById('ta').value") == "第一行内容", "textarea value restored after paste")

  let _ = os_platform::clipboard_clear()
}
