///| End-to-end host tests for:
///|   1. Advanced WebGL2 pipeline (Worker + OffscreenCanvas WebGL2 + UBO + Sampler + clearBufferfv +
///|      transferToImageBitmap -> Canvas2D globalCompositeOperation='copy' drawImage + CubeMap texStorage2D +
///|      EXT_color_buffer_float + MSAA renderbufferStorageMultisample/blitFramebuffer).
///|   2. Google Meet real-time A/V + WebRTC + AudioWorklet + AudioOut loopback pipeline
///|      (mediaDevices.enumerateDevices + getUserMedia + dual-peer RTCPeerConnection SDP/ICE/tracks/DataChannel +
///|      AudioContext.audioWorklet.addModule + AudioWorkletNode real-time callback + AudioOut zero-leak push).

import "webgl"
import "webrtc"
import "media"
import "js"

test "WebGL2 E2E: Worker OffscreenCanvas UBO + transferToImageBitmap copy + CubeMap texStorage2D + MSAA" {
  debug_assert(
    load(
      "data:text/html;charset=utf-8,<!doctype html><html><body><canvas id='c2d' width='64' height='64'></canvas><canvas id='gl2' width='64' height='64'></canvas></body></html>",
      800.0,
      600.0,
    ),
    "loaded WebGL2 E2E page",
  )

  if webgl::available() == 0 {
    return
  }

  // 1. Worker + OffscreenCanvas WebGL2 + UBO + clearBufferfv + transferToImageBitmap -> main Canvas2D copy
  let _ = eval(
    "globalThis.__wglWorkerRes = '';" +
    "const wcode = `" +
    "  self.onmessage = () => {" +
    "    const oc = new OffscreenCanvas(64, 64);" +
    "    const gl = oc.getContext('webgl2');" +
    "    if (!gl) { postMessage({ err: 'no-gl2' }); return; }" +
    "    const vs = gl.createShader(gl.VERTEX_SHADER);" +
    "    gl.shaderSource(vs, '#version 300 es\\\\nvoid main(){ vec2 p[3]=vec2[3](vec2(-1.0,-3.0),vec2(-1.0,1.0),vec2(3.0,1.0)); gl_Position=vec4(p[gl_VertexID],0.0,1.0); }');" +
    "    gl.compileShader(vs);" +
    "    const fs = gl.createShader(gl.FRAGMENT_SHADER);" +
    "    gl.shaderSource(fs, '#version 300 es\\\\nprecision highp float; layout(std140) uniform Cfg { vec4 c; }; out vec4 o; void main(){ o = c; }');" +
    "    gl.compileShader(fs);" +
    "    const pr = gl.createProgram(); gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.linkProgram(pr);" +
    "    const bi = gl.getUniformBlockIndex(pr, 'Cfg');" +
    "    gl.uniformBlockBinding(pr, bi, 0);" +
    "    const ubo = gl.createBuffer(); gl.bindBuffer(gl.UNIFORM_BUFFER, ubo);" +
    "    gl.bufferData(gl.UNIFORM_BUFFER, new Float32Array([0.5, 0.25, 0.125, 0.5]), gl.STATIC_DRAW);" +
    "    gl.bindBufferBase(gl.UNIFORM_BUFFER, 0, ubo);" +
    "    gl.viewport(0, 0, 64, 64);" +
    "    gl.clearBufferfv(gl.COLOR, 0, [0, 0, 0, 0]);" +
    "    gl.useProgram(pr); gl.drawArrays(gl.TRIANGLES, 0, 3);" +
    "    const bmp = oc.transferToImageBitmap();" +
    "    postMessage({ bmp, err: gl.getError() }, [bmp]);" +
    "  };" +
    "`;" +
    "const w = new Worker(URL.createObjectURL(new Blob([wcode], { type: 'application/javascript' })));" +
    "w.onmessage = (ev) => {" +
    "  const { bmp, err } = ev.data;" +
    "  const c = document.getElementById('c2d'); const ctx = c.getContext('2d');" +
    "  ctx.fillStyle = '#00ff00'; ctx.fillRect(0, 0, 64, 64);" +
    "  ctx.globalCompositeOperation = 'copy';" +
    "  ctx.drawImage(bmp, 0, 0, 64, 64);" +
    "  const px = ctx.getImageData(32, 32, 1, 1).data;" +
    "  bmp.close(); w.terminate();" +
    "  globalThis.__wglWorkerRes = err + '|' + px[0] + ',' + px[1] + ',' + px[2] + ',' + px[3];" +
    "};" +
    "w.postMessage('go');",
  )
  let mut tries = 0
  while tries < 80 && eval("globalThis.__wglWorkerRes") == "" {
    tick(16)
    tries += 1
  }
  let wres = eval("globalThis.__wglWorkerRes")
  debug_assert(wres.starts_with("0|"), "Worker OffscreenCanvas UBO + copy drawImage failed: " + wres)
  let px = wres.split("|")[1].split(",")
  let r = px[0].to_int().unwrap_or(0)
  let g = px[1].to_int().unwrap_or(0)
  let b = px[2].to_int().unwrap_or(0)
  let a = px[3].to_int().unwrap_or(0)
  // Premultiplied (0.5, 0.25, 0.125, 0.5) unpremultiplied -> straight ~(255, 128, 64, 128), green background cleared by copy!
  debug_assert(
    r >= 245 && g >= 118 && g <= 138 && b >= 54 && b <= 74 && a >= 120 && a <= 136,
    "expected straight ~(255,128,64,128) with green cleared by copy, got " + wres,
  )

  // 2. Three.js WebGL2 extensions + CubeMap texStorage2D + MSAA renderbufferStorageMultisample/blitFramebuffer
  let gl2_res = eval(
    "(() => {" +
    "  const gl = document.getElementById('gl2').getContext('webgl2');" +
    "  if (!gl) return 'no-gl2';" +
    "  if (!gl.getExtension('EXT_color_buffer_float')) return 'no-ext-cbf';" +
    "  const cube = gl.createTexture();" +
    "  gl.bindTexture(gl.TEXTURE_CUBE_MAP, cube);" +
    "  gl.texStorage2D(gl.TEXTURE_CUBE_MAP, 3, gl.SRGB8_ALPHA8, 16, 16);" +
    "  const cubeErr = gl.getError();" +
    "  gl.deleteTexture(cube);" +
    "  const fbo = gl.createFramebuffer(); const rbo = gl.createRenderbuffer();" +
    "  gl.bindFramebuffer(gl.FRAMEBUFFER, fbo); gl.bindRenderbuffer(gl.RENDERBUFFER, rbo);" +
    "  gl.renderbufferStorageMultisample(gl.RENDERBUFFER, 4, gl.RGBA8, 64, 64);" +
    "  gl.framebufferRenderbuffer(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.RENDERBUFFER, rbo);" +
    "  const fboSt = gl.checkFramebufferStatus(gl.FRAMEBUFFER);" +
    "  gl.clearBufferfv(gl.COLOR, 0, [0.2, 0.8, 0.4, 1.0]);" +
    "  gl.bindFramebuffer(gl.READ_FRAMEBUFFER, fbo); gl.bindFramebuffer(gl.DRAW_FRAMEBUFFER, null);" +
    "  gl.readBuffer(gl.COLOR_ATTACHMENT0);" +
    "  gl.blitFramebuffer(0, 0, 64, 64, 0, 0, 64, 64, gl.COLOR_BUFFER_BIT, gl.NEAREST);" +
    "  gl.bindFramebuffer(gl.FRAMEBUFFER, null);" +
    "  const out = new Uint8Array(4); gl.readPixels(32, 32, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, out);" +
    "  const blitErr = gl.getError();" +
    "  gl.deleteRenderbuffer(rbo); gl.deleteFramebuffer(fbo);" +
    "  return cubeErr + '|' + (fboSt === gl.FRAMEBUFFER_COMPLETE) + '|' + blitErr + '|' + out[0] + ',' + out[1] + ',' + out[2] + ',' + out[3];" +
    "})()",
  )
  debug_assert(gl2_res.starts_with("0|true|0|"), "WebGL2 CubeMap + MSAA blit failed: " + gl2_res)
  let gpx = gl2_res.split("|")[3].split(",")
  debug_assert(
    gpx[1].to_int().unwrap_or(0) >= 195 && gpx[1].to_int().unwrap_or(0) <= 212,
    "MSAA blit green channel ~204, got " + gl2_res,
  )

  clear_webgl()
  debug_assert(webgl::active_count() == 0, "zero WebGL leaks")
}

test "Google Meet E2E: enumerateDevices + getUserMedia + RTCPeerConnection tracks/DataChannel + AudioWorklet + AudioOut" {
  configure_permissions("", "meet-loopback-e2e")
  debug_assert(
    load("data:text/html;charset=utf-8,<!doctype html><html><body><div id='call'></div></body></html>", 1280.0, 800.0),
    "Meet loopback page loaded",
  )
  st.url = "https://meet.google.com/e2e-loopback"

  let _ = perm_op(1, "camera", "granted")
  let _ = perm_op(1, "microphone", "granted")

  // 1. navigator.mediaDevices.enumerateDevices() + getUserMedia({ audio: true, video: true })
  let _ = eval(
    "globalThis.__meetDev = '';" +
    "Promise.all([navigator.mediaDevices.enumerateDevices(), navigator.mediaDevices.getUserMedia({ audio: true, video: true })]).then(([devs, stream]) => {" +
    "  globalThis.__meetStream = stream;" +
    "  const hasAudioIn = devs.some(d => d.kind === 'audioinput');" +
    "  const hasVideoIn = devs.some(d => d.kind === 'videoinput');" +
    "  const at = stream.getAudioTracks(); const vt = stream.getVideoTracks();" +
    "  globalThis.__meetDev = [devs.length, hasAudioIn, hasVideoIn, at.length, vt.length].join('|');" +
    "});",
  )
  tick(16)
  let dev_res = eval("globalThis.__meetDev")
  debug_assert(
    dev_res.contains("|true|true|1|1"),
    "enumerateDevices + getUserMedia must expose audioinput/videoinput + 1 audio + 1 video track, got: " + dev_res,
  )

  // 2. Dual-peer RTCPeerConnection: SDP offer/answer + ICE candidates + addTrack (audio+video) + DataChannel
  let _ = eval(
    "globalThis.__pc1 = new RTCPeerConnection();" +
    "globalThis.__pc2 = new RTCPeerConnection();" +
    "globalThis.__dcMsgs1 = []; globalThis.__dcMsgs2 = [];" +
    "for (const trk of globalThis.__meetStream.getTracks()) { globalThis.__pc1.addTrack(trk, globalThis.__meetStream); }" +
    "globalThis.__pc1.onicecandidate = e => { if (e.candidate) globalThis.__pc2.addIceCandidate(e.candidate); };" +
    "globalThis.__pc2.onicecandidate = e => { if (e.candidate) globalThis.__pc1.addIceCandidate(e.candidate); };" +
    "globalThis.__dc1 = globalThis.__pc1.createDataChannel('meet-signaling');" +
    "globalThis.__dc1.onopen = () => { if (!globalThis.__sent1) { globalThis.__sent1 = true; globalThis.__dc1.send('ping-av'); } };" +
    "globalThis.__dc1.onmessage = e => { globalThis.__dcMsgs1.push(e.data); };" +
    "globalThis.__pc2.ondatachannel = e => {" +
    "  globalThis.__dc2 = e.channel;" +
    "  globalThis.__dc2.onmessage = ev => { globalThis.__dcMsgs2.push(ev.data); globalThis.__dc2.send('pong-av'); };" +
    "};" +
    "globalThis.__pc1.createOffer()" +
    "  .then(o => globalThis.__pc1.setLocalDescription(o).then(() => globalThis.__pc2.setRemoteDescription(o)))" +
    "  .then(() => globalThis.__pc2.createAnswer())" +
    "  .then(a => globalThis.__pc2.setLocalDescription(a).then(() => globalThis.__pc1.setRemoteDescription(a)));",
  )
  let mut rtc_ok = false
  let mut rtries = 0
  while rtries < 200 {
    tick(16)
    if eval("globalThis.__pc1.connectionState === 'connected' && globalThis.__pc2.connectionState === 'connected' && globalThis.__dcMsgs1.length > 0 && globalThis.__dcMsgs2.length > 0 ? 'ok' : ''") == "ok" {
      rtc_ok = true
      break
    }
    js::worker_sleep_ms(2)
    rtries += 1
  }
  let rtc_diag = eval(
    "globalThis.__pc1.getSenders().length + '|' + globalThis.__pc1.connectionState + '|' + globalThis.__pc2.connectionState + '|' + globalThis.__dcMsgs2[0] + '|' + globalThis.__dcMsgs1[0]",
  )
  debug_assert(rtc_ok, "Meet RTCPeerConnection loopback failed: " + rtc_diag)
  debug_assert(rtc_diag == "2|connected|connected|ping-av|pong-av", "Meet 2 tracks + DataChannel exact, got: " + rtc_diag)

  // 3. AudioContext + audioWorklet.addModule + AudioWorkletNode real-time DSP callback
  let _ = eval(
    "globalThis.__awRes = '';" +
    "const awSrc = `" +
    "  class MeetGainProcessor extends AudioWorkletProcessor {" +
    "    static get parameterDescriptors() { return [{ name: 'gain', defaultValue: 0.5, minValue: 0, maxValue: 2 }]; }" +
    "    constructor(opts) { super(); this._frames = 0; this.port.onmessage = (e) => { if (e.data && e.data.cmd === 'ping') this.port.postMessage({ pong: true, frames: this._frames }); }; }" +
    "    process(inputs, outputs, params) {" +
    "      const g = (params && params.gain && params.gain.length) ? params.gain[0] : 0.5;" +
    "      const inp = inputs[0] && inputs[0][0]; const out = outputs[0] && outputs[0][0];" +
    "      if (inp && out) { for (let i = 0; i < out.length; i++) out[i] = inp[i] * g; }" +
    "      this._frames += 128; return true;" +
    "    }" +
    "  }" +
    "  registerProcessor('meet-gain', MeetGainProcessor);" +
    "`;" +
    "const ac = new AudioContext({ sampleRate: 48000 });" +
    "globalThis.__ac = ac;" +
    "ac.audioWorklet.addModule(URL.createObjectURL(new Blob([awSrc], { type: 'application/javascript' }))).then(() => {" +
    "  const node = new AudioWorkletNode(ac, 'meet-gain', { parameterData: { gain: 0.25 } });" +
    "  node.connect(ac.destination);" +
    "  const inBuf = new Float32Array(128).fill(0.8); const outBuf = new Float32Array(128);" +
    "  const alive = node._processor.process([[inBuf]], [[outBuf]], { gain: new Float32Array([0.25]) });" +
    "  node.port.onmessage = (ev) => {" +
    "    globalThis.__awRes = alive + '|' + outBuf[0].toFixed(2) + '|' + ev.data.pong + '|' + ev.data.frames;" +
    "  };" +
    "  node.port.postMessage({ cmd: 'ping' });" +
    "});",
  )
  let mut atries = 0
  while atries < 60 && eval("globalThis.__awRes") == "" {
    tick(16)
    atries += 1
  }
  let aw_res = eval("globalThis.__awRes")
  debug_assert(aw_res == "true|0.20|true|128", "AudioWorkletNode addModule + process + port roundtrip failed: " + aw_res)

  // 4. Native AudioOut (null backend flags=1 so zero speaker noise even without FV_AUDIO_NULL=1)
  let ao = media::audio_out_open(48000, 1, 1, 1) // 48kHz mono F32, null/silent backend
  debug_assert(ao > 0, "AudioOut opened cleanly")
  let pcm = Bytes::new(128 * 4) // 128 F32 samples (1 AudioWorklet quantum)
  let written = media::audio_out_write(ao, pcm)
  debug_assert(written == 512, "AudioOut accepted 128-sample F32 quantum")
  debug_assert(media::audio_out_play(ao) == 1, "AudioOut play ok")
  debug_assert(media::audio_out_flush(ao) == 1, "AudioOut flush ok")
  media::audio_out_close(ao)
  debug_assert(media::audio_out_active_count() == 0, "zero AudioOut leaks")

  // 5. Clean teardown & zero leaks across WebRTC + Capture
  let _ = eval("globalThis.__meetStream.getTracks().forEach(t => t.stop()); globalThis.__pc1.close(); globalThis.__pc2.close();")
  debug_assert(webrtc::capture_active_count() == 0, "zero capture handle leaks")
  debug_assert(webrtc::active_peer_count() == 0 && webrtc::udp_active_count() == 0 && webrtc::dtls_active_count() == 0, "zero WebRTC leaks")
  reset_permissions_override()
}

test "Batch 4: WebGL2 colorSpace setters, Infinity uniforms, GLSL reserved keyword unmangle, GL_BACK drawBuffers, document.title & script.crossOrigin" {
  debug_assert(
    load(
      "data:text/html;charset=utf-8,<!doctype html><html><head></head><body><canvas id='c' width='16' height='16'></canvas></body></html>",
      200.0,
      200.0,
    ),
    "loaded Batch 4 test page",
  )
  let dom_res = eval(
    "(() => {" +
    "  'use strict';" +
    "  document.title = 'Batch4 Title';" +
    "  const titleOk = document.title === 'Batch4 Title' && document.head.querySelector('title')?.textContent === 'Batch4 Title';" +
    "  const sc = document.createElement('script');" +
    "  sc.crossOrigin = 'anonymous';" +
    "  const coSet = sc.getAttribute('crossorigin') === 'anonymous';" +
    "  sc.crossOrigin = null;" +
    "  const coCleared = sc.getAttribute('crossorigin') === null;" +
    "  return [titleOk, coSet, coCleared].join('|');" +
    "})()",
  )
  debug_assert(dom_res == "true|true|true", "Batch 4 DOM regression failed: " + dom_res)
  if webgl::available() == 0 {
    return
  }
  let res = eval(
    "(() => {" +
    "  'use strict';" +
    "  const c = document.getElementById('c');" +
    "  const gl = c.getContext('webgl2');" +
    "  gl.drawingBufferColorSpace = 'display-p3';" +
    "  const dbcs1 = gl.drawingBufferColorSpace;" +
    "  gl.drawingBufferColorSpace = 'invalid-cs';" +
    "  const dbcs2 = gl.drawingBufferColorSpace;" +
    "  gl.unpackColorSpace = 'display-p3';" +
    "  const ucs = gl.unpackColorSpace;" +
    "  gl.drawBuffers([gl.BACK]);" +
    "  gl.readBuffer(gl.BACK);" +
    "  const backErr = gl.getError();" +
    "  const vs = gl.createShader(gl.VERTEX_SHADER);" +
    "  gl.shaderSource(vs, '#version 300 es\\nin vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }');" +
    "  gl.compileShader(vs);" +
    "  const fs = gl.createShader(gl.FRAGMENT_SHADER);" +
    "  gl.shaderSource(fs, '#version 300 es\\nprecision highp float; uniform float attDist; uniform sampler2D buffer; out vec4 o; void main(){ vec4 s = texture(buffer, vec2(0.5)); o = isinf(attDist) ? vec4(s.r, 1.0, 0.0, 1.0) : vec4(0.0, 0.0, 0.0, 1.0); }');" +
    "  gl.compileShader(fs);" +
    "  const prog = gl.createProgram();" +
    "  gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);" +
    "  const linked = gl.getProgramParameter(prog, gl.LINK_STATUS);" +
    "  const nU = gl.getProgramParameter(prog, gl.ACTIVE_UNIFORMS);" +
    "  const uNames = []; for (let i = 0; i < nU; i++) { const info = gl.getActiveUniform(prog, i); if (info) uNames.push(info.name); }" +
    "  const hasUnmangledBuffer = uNames.includes('buffer') && !uNames.some(n => n.startsWith('_fv_u_'));" +
    "  const bufLoc = gl.getUniformLocation(prog, 'buffer');" +
    "  const attLoc = gl.getUniformLocation(prog, 'attDist');" +
    "  const tex = gl.createTexture();" +
    "  gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, tex);" +
    "  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);" +
    "  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);" +
    "  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([200, 0, 0, 255]));" +
    "  gl.useProgram(prog);" +
    "  gl.uniform1i(bufLoc, 1);" +
    "  gl.uniform1f(attLoc, Infinity);" +
    "  const vb = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, vb);" +
    "  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);" +
    "  const pLoc = gl.getAttribLocation(prog, 'p');" +
    "  gl.enableVertexAttribArray(pLoc); gl.vertexAttribPointer(pLoc, 2, gl.FLOAT, false, 0, 0);" +
    "  gl.viewport(0, 0, 16, 16); gl.drawArrays(gl.TRIANGLES, 0, 3);" +
    "  const px = new Uint8Array(4); gl.readPixels(8, 8, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px);" +
    "  return [dbcs1, dbcs2, ucs, backErr, linked, hasUnmangledBuffer, !!bufLoc, px[0] >= 190, px[1] >= 250].join('|');" +
    "})()",
  )
  debug_assert(
    res == "display-p3|display-p3|display-p3|0|true|true|true|true|true",
    "Batch 4 WebGL2 regression failed: " + res,
  )
}

test "Batch 4: deferred_async_done preserves non-prefetch completions across deliver_answers" {
  debug_assert(
    load("data:text/html;charset=utf-8,<!doctype html><html><body></body></html>", 200.0, 200.0),
    "loaded deferred_async_done test page",
  )
  let req_id = 999991
  started.set(req_id, (0, false))
  started_flags.set(req_id, (false, false))
  started_urls.set(req_id, "GET https://example.com/chunk.js")
  deferred_async_done.push(
    (
      req_id,
      fetch::Answer::{
        status: 200,
        headers: "Content-Type: application/javascript\r\n",
        url: "https://example.com/chunk.js",
        body: "ok".to_bytes(),
      },
    ),
  )
  deliver_answers(0)
  debug_assert(deferred_async_done.length() == 0, "deliver_answers must drain deferred_async_done")
  debug_assert(!started.contains(req_id), "deliver_answers must complete and remove deferred request from started")
}
