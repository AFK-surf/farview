test "OAuth R5 crosscheck min max clamp numeric comparisons" {
  let _ = load("data:text/html;charset=utf-8," + "<!doctype html><div id=\"demo\" style=\"width:80px;height:40px;display:flex\"><i id=\"child\"></i></div><pre id=\"res\"></pre>", 400.0, 200.0)
  let _ = frame()
  let r = eval("JSON.stringify(['calc(10px * min(2,3))','calc(10px * max(2,3))','calc(10px * clamp(1,2,3))','min(5px,2)','max(2,5px)','clamp(1px,2,3px)'].map(v=>CSS.supports('width',v)))")
  debug_assert(r == "[true,true,true,false,false,false]", "expected " + "[true,true,true,false,false,false]" + " observed " + r)
}

