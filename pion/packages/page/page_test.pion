test "OAuth R4 CSSStyleDeclaration and CSS.supports property parity" {
  let _ = load("data:text/html;charset=utf-8,<!doctype html><div id='el'></div>", 400.0, 200.0)
  let _ = frame()
  let r = eval("JSON.stringify((()=>{const s=document.getElementById('el').style;const props=['display','position','width','height','min-width','max-height','margin','padding','inset','border-width','border-style','border-color','gap','place-items','place-content','place-self','overflow','flex','flex-flow','grid-template-columns','background-color','caret-color','transform','transition','animation','opacity','z-index','float','color','font-size','line-height','text-align','white-space','box-sizing','-webkit-transform','-webkit-appearance','-webkit-line-clamp','-webkit-flex'];const toCamel=p=>p.replace(/-([a-z])/g,(_,c)=>c.toUpperCase());const ok=props.every(p=>(toCamel(p) in s)===CSS.supports(p,'initial') && (p in s)===CSS.supports(p,'initial'));const wkOk=['-webkit-transform','-webkit-appearance','-webkit-line-clamp','-webkit-flex'].every(p=>{const wk=toCamel(p.slice(1));return (wk in s)===CSS.supports(p,'initial');});const neg=!('unknownProp' in s) && !CSS.supports('unknown-prop','initial') && !('mozAnimation' in s) && !('msGrid' in s) && !('-webkit-touch-callout' in s);return [ok,wkOk,neg];})())")
  debug_assert(r == "[true,true,true]", "expected [true,true,true] observed " + r)
}

