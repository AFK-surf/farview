test "Wave 83B: svg_markup resolves HTML5-parsed <use xlink:href='#sym'> and inlines external <symbol>" {
  let html = "<!doctype html><html><body>" +
  "<svg id='ic' style='width:24px;height:24px'><use xlink:href='#sym-dyno'></use></svg>" +
  "<svg style='display:none'><symbol id='sym-dyno' viewBox='0 0 48 48'><path d='M4 4h40v40H4z'/></symbol></svg>" +
  "</body></html>"
  load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  ensure_layout()
  let ic = by_id(st.doc, "ic")[0]
  let out = svg_markup(ic, 1.0, box_w=24.0, box_h=24.0)
  debug_assert(out.contains("id=\"sym-dyno\""), "svg_markup must inline external <symbol> referenced via xlink:href, got: " + out)
  debug_assert(out.contains("xmlns:xlink=\"http://www.w3.org/1999/xlink\""), "svg_markup must declare xmlns:xlink when serializing xlink:href, got: " + out)
}

///|
test "Wave 7C: WHATWG HTML §8.1.7.2 event handler content attribute lexical scope binds element properties (link preload onload='rel=\"stylesheet\"')" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><head>" +
    "<link id='s' href='data:text/css,body{color:red}' rel='preload' as='style' onload='rel=\"stylesheet\"'>" +
    "</head><body><p>hi</p></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  tick(30)
  let rel = eval("document.getElementById('s').getAttribute('rel')")
  debug_assert(rel == "stylesheet", "onload='rel=\"stylesheet\"' must mutate link.rel, not window.rel, got: " + rel)
  let wrel = eval("typeof window.rel")
  debug_assert(wrel == "undefined", "window.rel must remain undefined, got: " + wrel)
}

///|
test "Wave 9C: CSSOM CSSStyleDeclaration.length, item(), and indexed access work for Split.js calc() feature detection" {
  let ok = load("data:text/html;charset=utf-8,<!doctype html><html><body></body></html>", 400.0, 300.0)
  debug_assert(ok, "page loaded")
  let res = eval(
    "(() => {" +
    "const el = document.createElement('div');" +
    "el.style.cssText = 'width:calc(50% - 2px);height:100px;';" +
    "return [el.style.length, el.style[0], el.style.item(1), el.style.parentRule === null].join(',');" +
    "})()",
  )
  debug_assert(res == "2,width,height,true", "CSSStyleDeclaration.length/item/[0] must return 2,width,height,true, got: " + res)
}

///|
test "Wave 85A: UnboundScript and ES Module code cache isolate iframe globals and sheets_sig_now" {
  // Pad > 1024 bytes so both classic script (__fvScript) and module (__fvModule) hit Wave 85A caches across two iframes.
  let pad = StringBuilder::new()
  let mut i = 0
  while i < 40 {
    pad.write_string("/* wave85a-cache-padding-0123456789 */")
    i += 1
  }
  let p = pad.to_string()
  let classic_src = "window.__w85 = (window.__w85 || 0) + 1; parent.postMessage('c:' + document.title + ':' + window.__w85, '*'); " + p
  let mod_src = "window.__w85m = (window.__w85m || 0) + 1; parent.postMessage('m:' + document.title + ':' + window.__w85m, '*'); export const v = window.__w85m; " + p
  let f1 = "<!doctype html><html><head><title>A</title><style>p{color:red}</style><link rel='stylesheet' href='a.css'></head><body><script>" +
  classic_src + "</script><script type='module'>" + mod_src + "</script></body></html>"
  let f2 = "<!doctype html><html><head><title>B</title><style>p{color:blue}</style><link rel='stylesheet' href='b.css'></head><body><script>" +
  classic_src + "</script><script type='module'>" + mod_src + "</script></body></html>"
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "host page loaded")
  let _ = eval(
    "window.__w85_log = []; window.addEventListener('message', function(e) { window.__w85_log.push(e.data); });" +
    "const f1 = document.createElement('iframe'); f1.setAttribute('srcdoc', " + js_string(f1) + "); document.body.appendChild(f1);" +
    "const f2 = document.createElement('iframe'); f2.setAttribute('srcdoc', " + js_string(f2) + "); document.body.appendChild(f2);",
  )
  tick(50)
  tick(50)
  tick(50)
  let r = eval("window.__w85_log.slice().sort().join(',')")
  debug_assert(
    r == "c:A:1,c:B:1,m:A:1,m:B:1",
    "cached UnboundScript and Module must stay isolated per iframe, got: " + r + " errs=" + errors().join(" | "),
  )
  // Verify sheets_sig_now output format
  let doc = html::parse("<!doctype html><html><head><style>a{}</style><link href='x.css'></head><body><p>hi</p></body></html>")
  let sig = sheets_sig_now(doc)
  debug_assert(sig == "lx.css;s3;" || sig == "s3;lx.css;", "sheets_sig_now format mismatch: " + sig)
}

///|
test "Wave 87B: CSSOM §6.7.2 style.setProperty(prop, val, 'important') overrides author !important and reports priority" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><head><style>body { display: none !important; }</style></head><body><p>Cambridge</p></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let res = eval(
    "(() => {" +
    "document.body.style.setProperty('display', 'block', 'important');" +
    "const v = document.body.style.getPropertyValue('display');" +
    "const p = document.body.style.getPropertyPriority('display');" +
    "const d = getComputedStyle(document.body).display;" +
    "return [v, p, d].join(',');" +
    "})()",
  )
  debug_assert(res == "block,important,block", "setProperty(..., 'important') must override author !important and report priority, got: " + res)
}

///|
test "Wave 87A: SVG createElementNS calli fast path, css import_rules prescan, and direct intbuf release" {
  let ok = load("data:text/html;charset=utf-8,<!doctype html><html><body><div id='r'></div></body></html>", 400.0, 300.0)
  debug_assert(ok, "page loaded")
  let res = eval(
    "(() => {" +
    "const ns = 'http://www.w3.org/2000/svg';" +
    "const s = document.createElementNS(ns, 'svg');" +
    "const g = document.createElementNS(ns, 'g');" +
    "const c = document.createElementNS(ns, 'circle');" +
    "c.setAttribute('cx', '10'); c.setAttribute('cy', '20'); c.setAttribute('r', '5');" +
    "const cp = document.createElementNS(ns, 'clipPath');" +
    "g.appendChild(c); s.appendChild(g); s.appendChild(cp); document.getElementById('r').appendChild(s);" +
    "return [s.namespaceURI === ns, c.tagName, cp.tagName, c.getAttribute('r'), s.querySelectorAll('circle').length].join(',');" +
    "})()",
  )
  debug_assert(res == "true,circle,clipPath,5,1", "SVG createElementNS calli fast path failed: " + res)
  // Verify css::import_rules prescan matches both absent and present @import (case-insensitive & escaped)
  debug_assert(css::import_rules("body { color: red; }").length() == 0, "no @import returns empty")
  debug_assert(css::import_rules("@IMPORT url('a.css'); body{}").length() == 1, "@IMPORT detected")
  debug_assert(css::import_rules("@\\69mport 'b.css';").length() == 1, "escaped @import detected")
}

///|
test "Wave 12C: WHATWG HTML §13.2.7 defer and module scripts execute in unified document order" {
  let html = "<!doctype html><html><head>" +
  "<script>window.__ord = [];</script>" +
  "<script type=\"module\">window.__ord.push('mod1');</script>" +
  "<script defer src=\"data:text/javascript,window.__ord.push('def2');\"></script>" +
  "<script type=\"module\">window.__ord.push('mod3');</script>" +
  "<script>window.__ord.push('sync0');</script>" +
  "</head><body></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 400.0, 300.0)
  debug_assert(ok, "page loaded")
  let res = eval("window.__ord.join(',')")
  debug_assert(res == "sync0,mod1,def2,mod3", "defer and module scripts must execute in unified document order, got: " + res)
}

///|
test "Wave 90A: no_base_docs fast cache and incremental id_idx update on op20/dom_insert_op" {
  let ok = load("data:text/html;charset=utf-8,<!doctype html><html><head></head><body><input id='new-todo'><footer id='footer'><button id='clear'>x</button></footer><ul id='list'></ul></body></html>", 400.0, 300.0)
  debug_assert(ok, "page loaded")
  let doc = doc_state().root
  let doc_id = id_of(doc)
  // First querySelector('base') populates no_base_docs; second hits O(1)
  debug_assert(host_op(17, doc_id, 4, "base", "") == "", "no base initially")
  debug_assert(no_base_docs.contains(doc.uid), "no_base_docs populated after query_fast_into('base')")
  debug_assert(host_op(17, doc_id, 4, "base", "") == "", "cached no_base_docs returns empty")
  // Adding <base> via op20 invalidates no_base_docs and finds it
  let head_el = query(doc, "head", true)[0]
  let _ = host_op(20, id_of(head_el), 0, "<base href='https://example.com/'>", "")
  debug_assert(!no_base_docs.contains(doc.uid), "no_base_docs cleared when <base> added via op20")
  debug_assert(host_op(17, doc_id, 4, "base", "").length() > 0, "querySelector('base') finds added <base>")
  // Prime id_idx on doc and verify footer innerHTML replacing #clear updates id_idx without bumping id_index_gen
  let new_todo_res = host_op(17, doc_id, 5, "new-todo", "")
  debug_assert(new_todo_res.length() > 0, "new-todo found")
  let gen0 = id_index_gen.v
  let footer_el = by_id(doc, "footer")[0]
  let _ = host_op(20, id_of(footer_el), 0, "<button id='clear'>y</button>", "")
  debug_assert(id_index_gen.v == gen0, "op20 replacing #clear must not bump id_index_gen")
  debug_assert(host_op(17, doc_id, 5, "new-todo", "") == new_todo_res, "new-todo still hits O(1)")
  let clear_res = host_op(17, doc_id, 5, "clear", "")
  debug_assert(clear_res.length() > 0, "replaced #clear found via incremental id_idx")
  // Appending a subtree with no id must not bump id_index_gen
  let r_ins = eval(
    "(() => { const li = document.createElement('li'); li.innerHTML = '<span>item</span>'; document.getElementById('list').appendChild(li); return document.getElementById('clear').textContent; })()",
  )
  debug_assert(r_ins == "y", "replaced #clear textContent is y, got " + r_ins)
  debug_assert(id_index_gen.v == gen0, "appendChild subtree without id must not bump id_index_gen")
}

///|
test "Wave 14C: dynamic <script type='importmap'> registration and cross-origin GET Origin header" {
  // 1. script_request must include Origin header on cross-origin GET/HEAD (a & 8 != 0) and omit it on same-origin GET/HEAD (a & 8 == 0)
  let ok0 = load("https://example.com/app", 400.0, 300.0)
  let _ = ok0
  let (_, _, h_cross_get, _) = script_request(8, "GET\u{01}https://api.other.example/v1", "\u{02}")
  let (_, _, h_cross_head, _) = script_request(8, "HEAD\u{01}https://api.other.example/v1", "\u{02}")
  let (_, _, h_same_get, _) = script_request(0, "GET\u{01}https://example.com/v1", "\u{02}")
  debug_assert(
    ascii_lower(h_cross_get).contains("origin:"),
    "cross-origin GET must send Origin header, got: " + h_cross_get,
  )
  debug_assert(
    ascii_lower(h_cross_head).contains("origin:"),
    "cross-origin HEAD must send Origin header, got: " + h_cross_head,
  )
  debug_assert(
    !ascii_lower(h_same_get).contains("origin:"),
    "same-origin GET must not send Origin header, got: " + h_same_get,
  )
  // 2. Dynamically inserted <script type="importmap"> must register mappings for subsequent module scripts
  let html = "<!doctype html><html><head></head><body><script>" +
  "const modUrl = URL.createObjectURL(new Blob(['export const ans = 42;'], { type: 'application/javascript' }));" +
  "const im = document.createElement('script'); im.type = 'importmap';" +
  "im.textContent = JSON.stringify({ imports: { '@w14c/lib': modUrl } });" +
  "document.head.appendChild(im);" +
  "const m = document.createElement('script'); m.type = 'module';" +
  "m.textContent = \"import { ans } from '@w14c/lib'; window.__w14cAns = ans;\";" +
  "document.head.appendChild(m);" +
  "</script></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 400.0, 300.0)
  debug_assert(ok, "dynamic importmap page loaded")
  let ans = eval("String(window.__w14cAns)")
  debug_assert(ans == "42", "dynamic <script type='importmap'> must resolve bare module specifiers, got: " + ans + " errs=" + errors().join(" | "))
  // 3. Fetch §4.3 data: URLs (base64 + percent-encoded)
  let _ = eval(
    "window.__w14cData = ''; Promise.all([fetch('data:text/plain;base64,SGVsbG8=').then(r => r.text()), fetch('data:text/plain,world%21').then(r => r.text())]).then(a => { window.__w14cData = a.join(' '); });",
  )
  let _ = tick(50)
  let d = eval("window.__w14cData")
  debug_assert(d == "Hello world!", "fetch('data:...') must decode base64 and percent-encoded payloads, got: " + d)
}

///|
test "Wave 15C: UA form control color:black inside dark header & blob: HTMLImageElement decode + canvas drawImage/getImageData" {
  // 1. <select> inside a color:white container must have UA color:black (FieldText) instead of inheriting white
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body style='color:white;background:#553399'><select id='s'><option>Simple Counter</option></select><canvas id='c' width='4' height='4'></canvas></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "Wave 15C page loaded")
  let col = eval("getComputedStyle(document.getElementById('s')).color")
  debug_assert(col == "rgb(0, 0, 0)", "UA <select> color must be rgb(0, 0, 0), got: " + col)
  // 2. HTMLImageElement with a blob: PNG URL must register bytes into st.pictures, report naturalWidth/Height, and draw into canvas
  // 1x1 red PNG base64
  let r = eval(
    "(() => {" +
    "const b64 = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==';" +
    "const bin = atob(b64); const u8 = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);" +
    "const u = URL.createObjectURL(new Blob([u8], { type: 'image/png' }));" +
    "const img = new Image(); img.src = u;" +
    "const nw = img.naturalWidth, nh = img.naturalHeight, w = img.width, h = img.height;" +
    "const ctx = document.getElementById('c').getContext('2d');" +
    "ctx.drawImage(img, 0, 0, 2, 2);" +
    "const d = ctx.getImageData(0, 0, 1, 1).data;" +
    "return [nw, nh, w, h, d[0], d[1], d[2], d[3]].join(',');" +
    "})()",
  )
  debug_assert(r == "1,1,1,1,255,0,0,127", "blob: HTMLImageElement naturalSize/width/height + drawImage + getImageData failed: " + r)
}

///|
test "Wave 92A: loose_root_ctx cross-context isolation, direct-cut release & single-pass reap" {
  let html = "<!doctype html><html><body><ul id='u'><li><div><span>a</span><b>b</b></div></li><li><div><span>c</span><b>d</b></div></li></ul></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 400.0, 300.0)
  debug_assert(ok, "page loaded")
  // Wrap all descendants then replace innerHTML, verify detached wrappers remain valid and live DOM updates cleanly
  let res = eval(
    "const u = document.getElementById('u');" +
    "const old = Array.from(u.getElementsByTagName('*'));" +
    "u.innerHTML = '<li><p>fresh</p></li>';" +
    "const live = u.getElementsByTagName('*');" +
    "old.length + ':' + live.length + ':' + live[1].textContent + ':' + old[2].textContent",
  )
  debug_assert(res == "8:2:fresh:a", "detached subtree wrappers and live querySelectorAll('*') preserved, got: " + res)
}

///|
test "Wave 16C: WHATWG HTML §4.2.3 <base href> resolves document scripts, stylesheets, and subresources" {
  let doc = html::parse(
    "<!doctype html><html><head><base href='/Song-Maker/client/'><link rel='stylesheet' href='style/main.css'><script src='build/Main.js'></script></head><body></body></html>",
  )
