test "Wave 79A: id_owner_ctx isolates loose_trees across contexts and reaps dead iframe detached trees" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body>" +
    "<iframe id='f' srcdoc='<!doctype html><html><body><script>for (let i = 0; i < 20; i++) { const d = document.createElement(\"div\"); d.innerHTML = \"<b></b><i></i>\"; }</script></body></html>'></iframe>" +
    "</body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  tick(20)
  // Remove iframe and tick so drop_gone_frames -> let_go -> reap_dead_ctx_loose_roots runs
  let _ = eval("document.getElementById('f').remove();")
  tick(20)
  // Main context loose_trees() must NOT emit the dead iframe's exclusively-owned detached nodes
  let raw = loose_trees()
  debug_assert(raw.length() < 32, "dead iframe detached nodes must be reaped in Pion without polluting main sweep, got len=" + raw.length().to_string() + " raw=" + raw)
}

///|
test "Wave 3C: SVG foreignObject getBoundingClientRect, isolated text synthesis, percent viewBox, and rect default 0x0 BBox" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body style='margin:0'><div style='width:400px;height:300px'>" +
    "<svg id='g' width='100%' height='100%' xmlns='http://www.w3.org/2000/svg'>" +
    "<g id='n1' transform='translate(50,40)'><rect id='emptyRect'></rect><foreignObject id='fo1' width='120' height='21'><div xmlns='http://www.w3.org/1999/xhtml'><span id='s1'>Christmas</span></div></foreignObject></g>" +
    "<g id='n2' transform='translate(50,120)'><foreignObject id='fo2' width='120' height='21'><div xmlns='http://www.w3.org/1999/xhtml'><span id='s2'>Go shopping</span></div></foreignObject></g>" +
    "</svg></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let js_res = eval(
    "(() => {" +
    "const r1 = document.getElementById('s1').getBoundingClientRect();" +
    "const er = document.getElementById('emptyRect');" +
    "const ebb = er.getBBox();" +
    "const n1bb = document.getElementById('n1').getBBox();" +
    "const svg = document.getElementById('g');" +
    "return (r1.width > 20 && r1.height > 10 && ebb.width === 0 && ebb.height === 0 && n1bb.width === 120 && n1bb.height === 21 && svg.width.baseVal.valueAsString === '100%') ? 'ok' : JSON.stringify({r1, ebb, n1bb});" +
    "})()",
  )
  debug_assert(js_res == "ok", "Wave 3C foreignObject/rect BBox check failed: " + js_res)
  let g = by_id(doc_state().root, "g")[0]
  let markup = svg_markup(g, 1.0, box_w=400.0, box_h=300.0)
  debug_assert(markup.contains("viewBox=\"0 0 400 300\""), "percent SVG without viewBox must get numeric viewBox")
  debug_assert(markup.contains(">Christmas</text>"), "first synthesized text must contain only Christmas")
  debug_assert(markup.contains(">Go shopping</text>"), "second synthesized text must contain only Go shopping")
  debug_assert(!markup.contains("ChristmasGo shopping"), "synthesized text nodes must not share EMPTY_CHILDREN")
}

///|
test "Wave 80A: promoteTree Case 2 (unwrapped root reattached -> fallback full sweep) and Case 3 (sibling re-dirtied)" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><div id='host'></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  // Case 2: detached tree [div, b#x2] where only b#x2 is wrapped before sweep; div is wrapped later via b.parentNode
  let _ = eval(
    "(() => {" +
    "const h = document.getElementById('host');" +
    "h.innerHTML = '<div><b id=\"x2\"></b></div>';" +
    "const b = document.getElementById('x2');" +
    "b._exp2 = 'alive2';" +
    "h.innerHTML = '';" +
    "var orig = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = orig;" +
    "const p = b.parentNode;" +
    "h.appendChild(p);" +
    "globalThis.__bRef = b;" +
    "})()",
  )
  debug_assert(loose_full_needed.v, "Case 2: unwrapped non-leaf root reattach must trigger conservative full sweep")
  let _ = eval("var orig2 = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = orig2;")
  debug_assert(!loose_full_needed.v, "Case 2: full sweep clears loose_full_needed")
  debug_assert(
    eval("document.getElementById('x2') === globalThis.__bRef && document.getElementById('x2')._exp2 === 'alive2'") == "true",
    "Case 2: child promoted safely back to strong wrapper",
  )

  // Case 3: detached tree [root, A, B] swept -> moving A into host re-dirties root so B/root demote back on next 'I' sweep
  let _ = eval(
    "(() => {" +
    "const r = document.createElement('div'); const a = document.createElement('span'); const b = document.createElement('em');" +
    "r.appendChild(a); r.appendChild(b);" +
    "globalThis.__c3r = r; globalThis.__c3a = a; globalThis.__c3b = b;" +
    "var orig = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = orig;" +
    "document.getElementById('host').appendChild(a);" +
    "})()",
  )
  debug_assert(!loose_full_needed.v, "Case 3: promoted child move stays incremental without full sweep")
  let delta = loose_trees()
  debug_assert(delta.starts_with("I") && delta.length() > 1, "Case 3: remaining detached root+sibling must be re-dirtied for next 'I' sweep, got " + delta)
}

///|
test "Wave 4C: module worker async postMessage and CompressionStream/DecompressionStream round-trip" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><script>" +
    "globalThis.__w4c = 'pending';" +
    "const code = `self.onmessage = async (e) => {" +
    "  const cs = new Response(e.data).body.pipeThrough(new CompressionStream('gzip'));" +
    "  const buf = await new Response(cs).arrayBuffer();" +
    "  const ds = new Response(buf).body.pipeThrough(new DecompressionStream('gzip'));" +
    "  const txt = await new Response(ds).text();" +
    "  self.postMessage('echo:' + txt);" +
    "};`;" +
    "const u = URL.createObjectURL(new Blob([code], { type: 'text/javascript' }));" +
    "const w = new Worker(u, { type: 'module' });" +
    "w.onmessage = (e) => { globalThis.__w4c = String(e.data); };" +
    "w.postMessage('svelte5-ok');" +
    "</script></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  tick(80)
  let res = eval("String(globalThis.__w4c)")
  debug_assert(res == "echo:svelte5-ok", "module worker async postMessage + gzip round-trip failed, got: " + res)
}

///|
test "Wave 81A: bytes_latin1, js_string, text_content and text_content_len fast paths" {
  // 1. bytes_latin1 pure ASCII + mixed high bytes (0x80..0xFF) exact roundtrip
  let ascii_b = Bytes::new(5)
  ascii_b[0] = b'h'
  ascii_b[1] = b'e'
  ascii_b[2] = b'l'
  ascii_b[3] = b'l'
  ascii_b[4] = b'o'
  debug_assert(bytes_latin1(ascii_b) == "hello", "bytes_latin1 pure ASCII fast path")
  let mix_b = Bytes::new(4)
  mix_b[0] = 0x41.to_byte()
  mix_b[1] = 0x80.to_byte()
  mix_b[2] = 0xFF.to_byte()
  mix_b[3] = 0x7A.to_byte()
  let mix_s = bytes_latin1(mix_b)
  let back = latin1_bytes(mix_s)
  debug_assert(back.length() == 4 && back[0] == 0x41.to_byte() && back[1] == 0x80.to_byte() && back[2] == 0xFF.to_byte() && back[3] == 0x7A.to_byte(), "bytes_latin1 high-byte roundtrip")

  // 2. js_string unescaped fast path + escaped runs + UTF-8
  debug_assert(js_string("plain_ascii_123") == "\"plain_ascii_123\"", "js_string unescaped fast path")
  debug_assert(js_string("a\"b\\c\nd\re") == "\"a\\\"b\\\\c\\nd\\re\"", "js_string escaped spans")
  debug_assert(js_string("中文\"测\\试") == "\"中文\\\"测\\\\试\"", "js_string UTF-8 with escapes")

  // 3. html::text_content & text_content_len (0 children, 1 text child, nested)
  let empty_el = html::Node::element(html::Ns::Html, "div", [])
  debug_assert(html::text_content(empty_el) == "" && text_content_len(empty_el) == 0, "empty element text_content")
  let single_el = html::Node::element(html::Ns::Html, "style", [])
  single_el.append(html::Node::text("body{color:red}"))
  debug_assert(html::text_content(single_el) == "body{color:red}" && text_content_len(single_el) == 15, "single-text element fast path")
  let nested = html::Node::element(html::Ns::Html, "div", [])
  let sp = html::Node::element(html::Ns::Html, "span", [])
  sp.append(html::Node::text("ab"))
  nested.append(sp)
  nested.append(html::Node::text("cd"))
  debug_assert(html::text_content(nested) == "abcd" && text_content_len(nested) == 4, "nested text_content pre-order")
}

