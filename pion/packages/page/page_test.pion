test "Wave 58B: video poster async arrival populates natural dimensions even after src_url is set" {
  let poster_svg = "<svg xmlns='http://www.w3.org/2000/svg' width='640' height='360'><rect width='640' height='360' fill='blue'/></svg>"
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body>" +
    "<video id='v' poster='https://example.com/poster.svg'></video>" +
    "</body></html>",
    800.0,
    600.0,
  )
  debug_assert(ok, "page loaded")
  let v = by_id(doc_state().root, "v")[0]
  // Simulate async fetch: src_url set before bytes arrive, then bytes arrive into st.pictures
  v.src_url = Some("https://example.com/poster.svg")
  v.natural = None
  st.pictures.set("https://example.com/poster.svg", utf8_encode(poster_svg))
  load_images(v, base="https://example.com/")
  match v.natural {
    Some((w, h)) => debug_assert((w - 640.0).abs() < 0.5 && (h - 360.0).abs() < 0.5, "expected 640x360 natural size from poster, got " + w.to_string() + "x" + h.to_string())
    None => panic("video natural dimensions must be populated once poster bytes arrive")
  }
}

///|
test "Wave 58B: svg_markup transcodes embedded WebP <image> data URI to PNG for invar/svg" {
  // Minimal valid 1x1 lossless WebP (RIFF....WEBPVP8L) disguised as data:image/png;base64,... (as Lottie emits)
  let webp_b64 = "UklGRh4AAABXRUJQVlA4TBEAAAAvAAAAAAfQ//73v/+BiOh/AAA="
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body>" +
    "<svg id='wsvg' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' width='40' height='40' viewBox='0 0 40 40'>" +
    "<image id='wimg' width='40' height='40' xlink:href='data:image/png;base64," + webp_b64 + "'></image>" +
    "</svg></body></html>",
    200.0,
    200.0,
  )
  debug_assert(ok, "page loaded")
  let svg = by_id(doc_state().root, "wsvg")[0]
  let img = by_id(doc_state().root, "wimg")[0]
  let out = svg_markup(svg, 1.0, box_w=40.0, box_h=40.0)
  // PNG magic 0x89 0x50 0x4E 0x47 base64-encodes to "iVBORw"
  debug_assert(out.contains("data:image/png;base64,iVBORw"), "expected WebP <image> transcoded to PNG data URI, got " + out)
  // Lossless DOM restoration
  let mut restored = false
  for a in img.attrs {
    if a.qname() == "xlink:href" && a.value.contains(webp_b64) {
      restored = true
    }
  }
  debug_assert(restored, "original xlink:href must be restored after svg_markup")
}

///|
test "Wave 68A: query_fast tag[attr=val] attr_idx + has_dups, tag.cls, desc .cls & :checked" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body>" +
    "<ul class='list'><li data-id='1'><input id='c1' class='toggle' type='checkbox' checked><span class='lbl'>one</span></li>" +
    "<li data-id='2'><input id='c2' class='toggle' type='checkbox'><span class='lbl'>two</span></li>" +
    "<div data-id='2' id='d2'></div><li data-id='dup' id='l_dup'></li><span data-id='dup' id='s_dup'></span></ul>" +
    "<select><option id='o1' selected>a</option><option id='o2'>b</option></select></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  debug_assert(eval("document.querySelector('li[data-id=\"1\"]')?.tagName") == "LI", "tag[attr=val] attr_idx hit")
  debug_assert(eval("document.querySelector('span[data-id=\"1\"]') === null") == "true", "tag[attr=val] mismatch with !has_dups")
  debug_assert(eval("document.querySelector('span[data-id=\"dup\"]')?.id") == "s_dup", "tag[attr=val] has_dups fallback")
  debug_assert(eval("document.querySelectorAll('span.lbl').length") == "2", "tag.cls recursive walk")
  debug_assert(eval("document.querySelectorAll('ul .lbl').length") == "2", "tag .cls recursive walk")
  debug_assert(eval("document.querySelectorAll('.list .toggle').length") == "2", ".cls1 .cls2 recursive walk")
  debug_assert(eval("document.querySelectorAll('input.toggle:checked').length") == "1", "input.toggle:checked")
  debug_assert(eval("document.querySelector('.toggle:checked')?.id") == "c1", ".toggle:checked")
  debug_assert(eval("document.querySelector('option:checked')?.id") == "o1", "option:checked")
  let _ = eval("document.getElementById('c2').checked = true")
  debug_assert(eval("document.querySelectorAll('input.toggle:checked').length") == "2", "dynamic checked toggle reflected")
}

///|
test "Wave 59B: innerHTML & insertAdjacentHTML do not execute <script>, while document.write / insertAdjacentHTML(true) does" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><div id='host'></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let r = eval(
    "(() => {" +
    "globalThis.__ih = 0; globalThis.__adj = 0; globalThis.__dw = 0;" +
    "const h = document.getElementById('host');" +
    "const tmp = document.createElement('div'); tmp.innerHTML = '<script>globalThis.__ih++<\\/script>';" +
    "const sc = tmp.querySelector('script'); if (sc) h.appendChild(sc);" +
    "h.insertAdjacentHTML('beforeend', '<script>globalThis.__adj++<\\/script>');" +
    "h.insertAdjacentHTML('beforeend', '<script>globalThis.__dw++<\\/script>', true);" +
    "return globalThis.__ih + ',' + globalThis.__adj + ',' + globalThis.__dw;" +
    "})()",
  )
  debug_assert(r == "0,0,1", "expected innerHTML=0, insertAdjacentHTML=0, document.write(3rd arg true)=1, got " + r)
}

///|
test "Wave 70A: incremental OP.SWEEP ('I' delta -> 'I' zero-walk -> reattach 'F' strong promotion)" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><div id='host'></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  // 1) Create detached subtree with expando; first sweep emits 'I<ids>', second unchanged sweep emits 'I'
  let _ = eval("globalThis.__d = document.createElement('div'); globalThis.__d._exp = 'alive'; globalThis.__d.appendChild(document.createElement('span'));")
  let first_raw = loose_trees()
  debug_assert(first_raw.starts_with("I") && first_raw.length() > 1, "first loose_trees emits incremental 'I<ids>', got " + first_raw)
  let second_raw = loose_trees()
  debug_assert(second_raw == "I", "second unchanged loose_trees returns O(1) 'I', got " + second_raw)
  // Run JS sweep with another detached node so it moves into weakWrappers
  let _ = eval(
    "globalThis.__d2 = document.createElement('p'); globalThis.__d2._exp = 'kept2'; " +
    "var __origST = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = __origST;",
  )
  debug_assert(loose_trees() == "I", "after JS sweep, dirty_loose_roots is empty -> 'I'")
  // 2) Reattach __d2 to document.body -> JS promotes tree directly back to strong wrappers preserving expando (no full 'F' scan needed!)
  let _ = eval("document.getElementById('host').appendChild(globalThis.__d2);")
  debug_assert(!loose_full_needed.v, "single-ctx reattach promotes via JS tree without forcing full 'F' sweep")
  let _ = eval("var __origST2 = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = __origST2;")
  debug_assert(
    eval("document.getElementById('host').lastChild === globalThis.__d2 && document.getElementById('host').lastChild._exp === 'kept2'") == "true",
    "reattached node promoted back to strong wrapper with expando intact",
  )
}

///|
test "Wave 71A: swept_held_count two-batch O(1) release, mutation invalidation & <template> safety" {
  let ok = load("data:text/html;charset=utf-8,<!doctype html><html><body></body></html>", 400.0, 300.0)
  debug_assert(ok, "page loaded")
  // (a) Two-batch release: batch 1 leaves count > 0 (not cut), batch 2 hits 0 (cut immediately)
  let root = html::Node::element(html::Ns::Html, "div", [])
  let c1 = html::Node::element(html::Ns::Html, "span", [])
  let c2 = html::Node::element(html::Ns::Html, "em", [])
  root.append(c1)
  root.append(c2)
  let id1 = id_of(c1)
  let id2 = id_of(c2)
  note_loose_subtree(root)
  let _ = loose_trees()
  debug_assert(match intmap::get(swept_held_count, root.uid) { Some(2) => true _ => false }, "swept_held_count tracks 2 held children")
  release_id_list([id1])
  debug_assert(root.children.length() == 2, "batch 1 must not cut while c2 is still held")
  debug_assert(match intmap::get(swept_held_count, root.uid) { Some(1) => true _ => false }, "swept_held_count decremented to 1")
  release_id_list([id2])
  debug_assert(root.children.length() == 0, "batch 2 reaches 0 and cuts detached root immediately")
  debug_assert(intmap::get(swept_held_count, root.uid).is_none(), "swept_held_count cleared after cut")

  // (b) Mutation invalidation: id_of on a third child erases swept_held_count -> falls back to held_in safely
  let r2 = html::Node::element(html::Ns::Html, "ul", [])
  let a1 = html::Node::element(html::Ns::Html, "li", [])
  let a2 = html::Node::element(html::Ns::Html, "li", [])
  r2.append(a1)
  r2.append(a2)
  let ida1 = id_of(a1)
  note_loose_subtree(r2)
  let _ = loose_trees()
  debug_assert(match intmap::get(swept_held_count, r2.uid) { Some(1) => true _ => false }, "r2 initially has count 1")
  let ida2 = id_of(a2)
  debug_assert(intmap::get(swept_held_count, r2.uid).is_none(), "id_of inside loose tree invalidates swept_held_count")
  release_id_list([ida1])
  debug_assert(r2.children.length() == 2, "fallback held_in sees a2 still held and does not cut")
  release_id_list([ida2])
  debug_assert(r2.children.length() == 0, "after releasing a2, r2 is cut")

  // (c) Detached subtree containing <template> is excluded from swept_held_count
  let wrap = html::Node::element(html::Ns::Html, "div", [])
  let tpl = html::Node::element(html::Ns::Html, "template", [])
  let tc = html::Node::new(html::Kind::Fragment)
  tc.set_of_template(true)
  tpl.set_template_content(Some(tc))
  wrap.append(tpl)
  let id_tpl = id_of(tpl)
  note_loose_subtree(wrap)
  let _ = loose_trees()
  debug_assert(intmap::get(swept_held_count, wrap.uid).is_none(), "<template> subtree excluded from swept_held_count")
  release_id_list([id_tpl])
  debug_assert(wrap.children.length() == 0, "releasing template itself cuts wrapper cleanly")
}

///|
test "Wave 61B: HTMLImageElement.src setter fires onload & canvas drawImage decodes detached data:image/svg+xml Image" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><canvas id='c' width='16' height='16'></canvas></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let _ = eval(
    "(() => {" +
    "globalThis.__imgLoaded = 0;" +
    "const img = new Image();" +
    "img.onload = () => { globalThis.__imgLoaded++; };" +
    "img.src = 'data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\"><rect width=\"16\" height=\"16\" fill=\"%23ff0000\"/></svg>';" +
    "const c = document.getElementById('c'); const ctx = c.getContext('2d');" +
    "ctx.drawImage(img, 0, 0, 16, 16);" +
    "const px = ctx.getImageData(8, 8, 1, 1).data;" +
    "globalThis.__imgPx = px[0] + ',' + px[1] + ',' + px[2] + ',' + px[3];" +
    "})()",
  )
  tick(50)
  let loaded = eval("String(globalThis.__imgLoaded)")
  let px = eval("String(globalThis.__imgPx)")
  debug_assert(loaded == "1", "HTMLImageElement.src setter must fire onload, got " + loaded)
  debug_assert(px == "255,0,0,255", "detached data:image/svg+xml Image must draw onto 2D canvas, got " + px)
}

///|
test "Wave 61B: HTML §8.6 timer nesting > 5 clamps 0ms setTimeout to 4ms so __tick terminates" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let _ = eval(
    "(() => { globalThis.__nestN = 0; function step() { globalThis.__nestN++; setTimeout(step, 0); } setTimeout(step, 0); })()",
  )
  tick(40)
  let n = eval("String(globalThis.__nestN)")
  // Depth 1..5 at 0ms + 10 steps at 4ms each in 40ms => 15..16 invocations (never infinite)
  debug_assert(n == "15" || n == "16", "nested 0ms setTimeout must clamp to 4ms after depth 5 (expected 15..16 in 40ms), got " + n)
}

///|
test "Wave 72A: op43 clientWidth/clientHeight uses cached client_sizes and invalidates on style mutation" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body style='margin:0'><div id='box' style='width:100px;height:50px;border:4px solid #000'></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let r1 = eval("const el = document.getElementById('box'); el.clientWidth + ',' + el.clientHeight")
  debug_assert(r1 == "100,50", "initial clientWidth,clientHeight == 100,50, got " + r1)
  debug_assert(main_client_cache.v.is_some(), "main_client_cache populated after op43 clientWidth/clientHeight")
  let r2 = eval("el.style.width = '180px'; el.style.height = '75px'; el.clientWidth + ',' + el.clientHeight")
  debug_assert(r2 == "180,75", "mutated clientWidth,clientHeight == 180,75 after cache invalidation, got " + r2)
}

///|
test "Wave 74A: sb_write_int 3-digit lookup table exactness across boundaries" {
  let sb = StringBuilder::new()
  let vals = [-42, 0, 7, 99, 100, 999, 1000, 1005, 1050, 12345, 999999, 1000000, 12345678]
  for i, v in vals {
    if i > 0 { sb.write_byte(b',') }
    sb_write_int(sb, v)
  }
  debug_assert(
    sb.to_string() == "-42,0,7,99,100,999,1000,1005,1050,12345,999999,1000000,12345678",
    "sb_write_int exact across boundaries, got " + sb.to_string(),
  )
}

///|
test "Wave 63B: DOMTokenList values/keys/entries iterators" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><div id='d' class='alpha beta'></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let vals = eval("Array.from(document.getElementById('d').classList.values()).join(',')")
  let keys = eval("Array.from(document.getElementById('d').classList.keys()).join(',')")
  let ents = eval("Array.from(document.getElementById('d').classList.entries()).map(e => e[0] + ':' + e[1]).join(',')")
  debug_assert(vals == "alpha,beta", "classList.values() must iterate tokens, got " + vals)
  debug_assert(keys == "0,1", "classList.keys() must iterate indices, got " + keys)
  debug_assert(ents == "0:alpha,1:beta", "classList.entries() must iterate [index, token], got " + ents)
}

