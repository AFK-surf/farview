test "OAuth R10 border/outline/border-radius shorthands and styleDeclsCache/LRU invariants" {
  let _ = load("data:text/html;charset=utf-8,<!doctype html><div id='el'></div>", 400.0, 200.0)
  let _ = frame()
  let r = eval("JSON.stringify((()=>{const e=document.getElementById('el'),s=e.style;e.setAttribute('style','border: 2px solid red !important');const b1=[s.border,s.borderTop,s.getPropertyPriority('border'),s.cssText];s.borderTopColor='blue';const b1m=[s.border,s.borderTop];e.setAttribute('style','border: 2px solid red');s.borderTopColor='blue';const b2=[s.border,s.borderTop,s.borderRight];e.setAttribute('style','border: 1px solid; outline: 2px dashed blue; border-radius: 8px 12px');const b3=[s.border,s.outline,s.borderRadius];e.setAttribute('style','border: none');const b4=s.border;e.setAttribute('style','outline: none');const o1=[s.outline,s.getPropertyPriority('outline')];e.setAttribute('style','outline: 2px solid !important');const o2=[s.outline,s.getPropertyPriority('outline'),s.cssText];e.setAttribute('style','outline-width: 2px; outline-style: solid');const o3=s.outline;e.setAttribute('style','outline: initial');const o4=s.outline;e.setAttribute('style','border-radius: 10px / 20px');s.color='red';const er=[s.borderTopLeftRadius,s.borderBottomRightRadius,s.borderRadius];e.setAttribute('style','border-radius: calc(10px + 2px) / 20px');const ec=s.borderRadius;e.setAttribute('style','margin-top: initial; margin-right: 16px; margin-bottom: 16px; margin-left: 16px');const mi=s.margin;for(let i=0;i<4200;i++)s.transform='translateX('+i+'px)';const t1=s.transform;e.setAttribute('style','transform: translateX(7px)');const t2=s.transform;e.removeAttribute('style');const t3=s.transform;return [b1,b1m,b2,b3,b4,o1,o2,o3,o4,er,ec,mi,t1,t2,t3];})())")
  debug_assert(r == "[[\"2px solid red\",\"2px solid red\",\"important\",\"border: 2px solid red !important;\"],[\"\",\"\"],[\"\",\"2px solid blue\",\"2px solid red\"],[\"1px solid\",\"2px dashed blue\",\"8px 12px\"],\"none\",[\"none\",\"\"],[\"2px solid\",\"important\",\"outline: 2px solid !important;\"],\"\",\"initial\",[\"10px 20px\",\"10px 20px\",\"10px / 20px\"],\"calc(10px + 2px) / 20px\",\"\",\"translatex(4199px)\",\"translateX(7px)\",\"\"]", "observed " + r)
}

