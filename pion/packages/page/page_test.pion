///| End-to-end unit tests for `pion/packages/page` (V8 + DOM + CSS + Layout + Paint).

test "page load, JS eval, DOM mutation, computed style, and layout frame" {
  let html = "<!doctype html><html><head><title>Pion Page Test</title><style>body{margin:0}#box{width:120px;height:40px;background:#336699;color:#ffffff}</style></head><body><div id='box'>Hello Pion</div><script>document.getElementById('box').setAttribute('data-ok','yes'); window.__ans = 21 * 2;</script></body></html>"
  let data_u = "data:text/html;charset=utf-8," + html
  let ok = load(data_u, 800.0, 600.0)
  debug_assert(ok, "page::load returned true")
  debug_assert(title() == "Pion Page Test", "title matches")
  debug_assert(eval("String(window.__ans)") == "42", "js eval 21*2 == 42")
  debug_assert(eval("document.getElementById('box').getAttribute('data-ok')") == "yes", "DOM setAttribute roundtrip")
  debug_assert(eval("getComputedStyle(document.getElementById('box')).width") == "120px", "getComputedStyle width == 120px")
  let (ops, _fonts, page_h) = frame()
  debug_assert(ops.length() > 0, "frame produced display ops")
  debug_assert(page_h >= 40.0, "page height >= 40")
  let ds = doc_state()
  debug_assert(ds.root.children.length() > 0, "doc_state has children")
}

test "page storage dump/load and parse_storage_json roundtrip" {
  let json = "{\"https://example.com\":{\"k1\":\"v1\",\"k2\":\"v2\"}}"
  let parsed = parse_storage_json(json)
  match parsed.get("https://example.com") {
    Some(m) => {
      debug_assert(m.get("k1").unwrap_or("") == "v1", "k1 == v1")
      debug_assert(m.get("k2").unwrap_or("") == "v2", "k2 == v2")
    }
    None => debug_assert(false, "origin present")
  }
}

test "page fetch_pending updates static img natural size and emits PatchOp::SetImage" {
  let prev_eager = eager_pictures.v
  eager_pictures.v = false
  let pic_url = "http://test.invalid/wave8b-logo.svg"
  let svg_bytes = "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='48'><rect width='120' height='48' fill='#000'/></svg>".to_bytes()
  let html = "<!doctype html><html><body><img id='logo' src='" + pic_url + "'></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "static img page loaded")
  let _ = frame()
  let _ = doc_element_pictures()
  debug_assert(!assets_dirty.v, "assets_dirty cleared after initial doc_element_pictures")
  let mirror = doc::Mirror::new()
  let _ = mirror.reset(doc_state())
  fcache.cache.set(pic_url, (svg_bytes, pic_url))
  let fetched = fetch_pending()
  debug_assert(fetched, "fetch_pending returned true for pending img")
  debug_assert(assets_dirty.v, "fetch_pending marked assets_dirty")
  let mut saw_set_image = false
  match mirror.diff(doc_state()) {
    Some(ops) => {
      for op in ops {
        match op {
          proto::PatchOp::SetImage(_id, Some(u), Some((w, h))) if u == pic_url && (w - 120.0).abs() < 0.5 && (h - 48.0).abs() < 0.5 =>
          saw_set_image = true
          _ => ()
        }
      }
    }
    None => ()
  }
  eager_pictures.v = prev_eager
  debug_assert(saw_set_image, "fetch_pending emitted PatchOp::SetImage with natural size on static page")
}

test "page HTMLLinkElement.relList.supports works for VitePress prefetch detection" {
  let html = "<!doctype html><html><body><link id='l' rel='preload'></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  debug_assert(eval("String(document.createElement('link').relList.supports('prefetch'))") == "true", "link.relList.supports('prefetch') == true")
  debug_assert(eval("String(document.createElement('link').relList.supports('bogus-token'))") == "false", "link.relList.supports('bogus-token') == false")
  debug_assert(eval("String(document.getElementById('l').relList.contains('preload'))") == "true", "relList.contains('preload') == true")
}

test "page svg_markup inlines cross-svg <use href='#id'> symbol definitions" {
  let html = "<!doctype html><html><body><svg id='icon' width='16' height='16'><use href='#arrow-r'></use></svg><svg style='display:none'><symbol id='arrow-r' viewBox='0 0 16 16'><path d='M1 8h14' stroke='currentColor'/></symbol></svg></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let icon = by_id(doc_state().root, "icon")[0]
  let markup = svg_markup(icon, 1.0)
  debug_assert(markup.contains("<defs>") && markup.contains("id=\"arrow-r\"") && markup.contains("M1 8h14"), "svg_markup must inline external <symbol id='arrow-r'> into <defs>")
}

test "page DOM constructors new Text, new Comment, new DocumentFragment create real host nodes" {
  let html = "<!doctype html><html><body><div id='host'><!--mark--><span>hi</span></div></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let res = eval("(() => { const d = document.getElementById('host'); const c = d.firstChild; const t = new Text('hello'); d.insertBefore(t, c); c.remove(); const cm = new Comment('note'); d.appendChild(cm); const df = new DocumentFragment(); df.appendChild(new Text('!')); d.appendChild(df); return [t.parentNode === d, t.data, cm.parentNode === d, cm.data, d.textContent].join('|'); })()")
  debug_assert(res == "true|hello|true|note|hellohi!", "new Text/Comment/DocumentFragment must create real DOM nodes with valid parentNode")
}

test "page HTMLMediaElement.textTracks populates TextTrack from child <track> elements" {
  let html = "<!doctype html><html><body><video id='v'><track id='tr' kind='captions' srclang='en' default src='data:text/vtt,WEBVTT'></video></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let res = eval("(() => { const v = document.getElementById('v'); const tr = document.getElementById('tr'); return [v.textTracks.length, v.textTracks[0] === tr.track, v.textTracks[0].kind, v.textTracks[0].mode, v.textTracks[0].cues.length].join('|'); })()")
  debug_assert(res == "1|true|captions|showing|0", "video.textTracks[0] must link to child <track>.track with valid cues list")
}

test "page svg_markup preserves fill='currentColor' as ancestor color on child <path> inside <symbol>" {
  let html = "<!doctype html><html><body style='color:oklch(100% 0 0)'><svg id='ico' width='24' height='24'><symbol id='s1'><path fill='currentColor' d='M0 0h10'/></symbol><use href='#s1'/></svg></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let ico = by_id(doc_state().root, "ico")[0]
  let markup = svg_markup(ico, 1.0)
  debug_assert(markup.contains("fill:rgb(255, 255, 255)") && !markup.contains("oklch(") && !markup.contains("fill:rgb(0, 0, 0)") && !markup.contains("fill:black"), "svg_markup must convert oklch currentColor to sRGB white for invar/svg")
}

test "Wave 3C: SVG <foreignObject> HTML label getBoundingClientRect measurement & svg_markup text synthesis" {
  let html = "<!doctype html><html><body><svg id='flow' width='200' height='100' viewBox='0 0 200 100'><g transform='translate(20,20)'><foreignObject x='0' y='0' width='120' height='32'><div id='lbl' style='font-size:16px;color:#112233'><span>Christmas</span></div></foreignObject></g></svg></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let rect = eval("(() => { const r = document.getElementById('lbl').getBoundingClientRect(); return (r.width > 40 && r.height >= 16) ? 'ok' : r.width + 'x' + r.height; })()")
  debug_assert(rect == "ok", "foreignObject HTML child getBoundingClientRect must measure non-zero width & height: " + rect)
  let flow = by_id(doc_state().root, "flow")[0]
  let markup = svg_markup(flow, 1.0)
  debug_assert(markup.contains("<text") && markup.contains("Christmas") && markup.contains("rgb(17, 34, 51)"), "svg_markup must synthesize centered SVG <text> for foreignObject: " + markup)
  // Original <g> must not retain the temporary synthetic <text> node
  let g = flow.children[0]
  debug_assert(g.children.length() == 1 && g.children[0].tag == "foreignObject", "svg_markup must pop synthetic <text> after serialization")
}

test "page svg_markup inlines external sprite <use href='.../sprite.svg#logo'> and rasterizes non-empty pixels" {
  let sprite_url = "https://typst.test/assets/images/sprite.svg"
  let sprite_src = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><g id='logo'><rect x='2' y='2' width='28' height='28' fill='currentColor'/></g></svg>"
  svg_sprite_cache.set(sprite_url, html::parse(sprite_src))
  let html = "<!doctype html><html><body style='color:#239dad'><svg id='ext' width='32' height='32' viewBox='0 0 32 32'><use href='https://typst.test/assets/images/sprite.svg#logo'></use></svg></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let ext = by_id(doc_state().root, "ext")[0]
  let markup = svg_markup(ext, 1.0)
  debug_assert(markup.contains("href=\"#logo\""), "external <use> href rewritten to #logo in serialized SVG")
  debug_assert(markup.contains("<defs>") && markup.contains("id=\"logo\""), "external #logo inlined into <defs>")
  // Original DOM attribute must be restored untouched
  let use_el = ext.children[0]
  debug_assert(use_el.attr("href").unwrap_or("") == "https://typst.test/assets/images/sprite.svg#logo", "DOM <use href> restored after svg_markup")
  let full_svg = if markup.contains("xmlns=") { markup } else { str_replace_all(markup, "<svg", "<svg xmlns=\"http://www.w3.org/2000/svg\"") }
  match raster::decode_svg(utf8_encode(full_svg), 64) {
    Some((w, h, rgba)) => {
      let mut opaque = 0
      let mut i = 3
      while i < rgba.length() {
        if (rgba[i].to_int() & 0xFF) > 20 { opaque += 1 }
        i += 4
      }
      debug_assert(w > 0 && h > 0 && opaque > 50, "external <use> sprite must rasterize non-empty opaque pixels, got " + opaque.to_string())
    }
    None => debug_assert(false, "raster::decode_svg must succeed on inlined external sprite SVG")
  }
}

test "page hydrated inline SVG updates picture key after JS mutates children/viewBox" {
  let html = "<!doctype html><html><body><svg id='hy' width='18' height='18' viewBox='0 0 16 16'></svg></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let _ = frame()
  let pics0 = element_pictures()
  debug_assert(pics0.length() == 1, "initial empty svg recorded")
  let k0 = pics0[0].1
  let _ = eval("const s = document.getElementById('hy'); s.setAttribute('viewBox', '0 0 24 24'); s.innerHTML = '<path fill=\"#fff\" d=\"M2 2h20v20H2z\"/>';")
  let _ = frame()
  let pics1 = element_pictures()
  debug_assert(pics1.length() == 1 && pics1[0].1 != k0, "hydrated svg must emit a new fv-svg picture key after DOM mutation")
}

test "sb_write_int boundary values and op 113/125 discard_detached_child behavior" {
  let sb = StringBuilder::new()
  let vals = [0, 9, 10, 99, 100, 999, 1000, 9999, 10000, 99999, 100000, 1234567, -42]
  for v in vals {
    sb.reset()
    sb_write_int(sb, v)
    debug_assert(sb.to_string() == v.to_string(), "sb_write_int mismatch for " + v.to_string() + ": got " + sb.to_string())
  }
  let ok = load("data:text/html;charset=utf-8,<div id='box'><p id='unheld'><span>a</span></p><p id='held'><b>b</b></p><template id='tpl'><i>c</i></template></div>", 800.0, 600.0)
  debug_assert(ok, "loaded test doc")
  let box = by_id(doc_state().root, "box")[0]
  let unheld = by_id(doc_state().root, "unheld")[0]
  let held = by_id(doc_state().root, "held")[0]
  let tpl = by_id(doc_state().root, "tpl")[0]
  let held_id = id_of(held)
  debug_assert(held_id > 0, "held node has js_id")
  // Mark template content child as of_template
  match tpl.get_template_content() {
    Some(tc) => {
      tc.set_of_template(true)
      let box_id = id_of(box)
      // op 113 (textContent = "fresh") detaches all children: unheld cut, held noted loose
      let _ = host_op(113, box_id, 0, "fresh", "")
      debug_assert(box.children.length() == 1 && box.children[0].data == "fresh", "op 113 replaced with text")
      debug_assert(unheld.parent.is_none() && unheld.children.length() == 0, "op 113 cut unheld subtree")
      debug_assert(held.parent.is_none() && held.children.length() == 1, "op 113 preserved held subtree")
      debug_assert(loose_roots.contains(held.uid), "op 113 recorded held subtree in loose_roots")
      // op 125 (replaceChildren) on box with empty incoming
      let u2 = html::Node::element(html::Ns::Html, "div", html::empty_attrs())
      u2.append(html::Node::text("x"))
      box.append(u2)
      let _ = host_op(125, box_id, 0, "", "")
      debug_assert(box.children.length() == 0, "op 125 cleared children")
      debug_assert(u2.parent.is_none() && u2.children.length() == 0, "op 125 cut unheld subtree")
    }
    None => debug_assert(false, "template has content")
  }
}

test "page inline SVG inside opacity:0 element with opacity keyframes animation does not bake opacity:0" {
  let html = "<!doctype html><html><head><style>@keyframes fadeIn{from{opacity:0}to{opacity:1}}.wrap{opacity:0;animation:fadeIn .5s forwards}</style></head><body><div class='wrap'><svg id='ic' width='16' height='16' viewBox='0 0 16 16'><rect width='16' height='16' fill='#fff'/></svg></div></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let _ = frame()
  let pics = element_pictures()
  debug_assert(pics.length() == 1, "expected 1 svg picture")
  let key = pics[0].1
  match st.pictures.get(key) {
    Some(bytes) => {
      let src = utf8_decode_lossy(bytes)
      debug_assert(!src.contains("opacity:0"), "SVG inside opacity-animated ancestor must not bake opacity:0, got: " + src)
    }
    None => debug_assert(false, "missing svg bytes in st.pictures")
  }
}

test "query_fast_into and nth-child class fast path match full CSS query" {
  let html = "<!doctype html><html><body><div id='a' class='x y'><span class='y'>1</span><span id='dup'>2</span><span id='dup'>3</span><svg><defs><linearGradient id='g1'></linearGradient></defs></svg></div><ul id='u'>text<!-- c --><li><input class='toggle'/></li><li><input class='toggle'/></li><li><input class='toggle'/><ul><li><input class='toggle'/></li><li><input class='toggle'/></li><li><input class='toggle'/></li></ul></li></ul></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "loaded query_fast_into test doc")
  let root = doc_state().root
  let cases : Array[(String, Bool, Int)] = [
    ("span", false, 3),
    ("span", true, 1),
    ("SPAN", false, 3),
    ("linearGradient", false, 1),
    ("lineargradient", true, 1),
    ("*", true, 1),
    ("#a", true, 1),
    ("#dup", false, 2),
    (".y", false, 2),
    (".y", true, 1),
    ("li:nth-child(1) .toggle", true, 1),
    ("li:nth-child(1) .toggle", false, 2),
    ("li:nth-child(3) .toggle", true, 1),
    ("li:nth-child(3) .toggle", false, 4),
    ("li:nth-child(99) .toggle", false, 0),
  ]
  for tc in cases {
    let (sel, first, expect_len) = tc
    let fast_out : Array[html::Node] = []
    let handled = query_fast_into(root, sel, first, fast_out)
    debug_assert(handled, "query_fast_into should handle " + sel)
    debug_assert(fast_out.length() == expect_len, "query_fast_into len mismatch for " + sel + ": got " + fast_out.length().to_string())
    let list = selectors_of(sel)
    let full_out : Array[html::Node] = []
    let stk : Array[html::Node] = []
    for i = root.children.length() - 1; i >= 0; i = i - 1 {
      let c = root.children[i]
      if c.kind == html::Kind::Element { stk.push(c) }
    }
    while stk.pop() is Some(n) {
      for s in list {
        if s.pseudo_element == "" && css::selector_matches(s, n) {
          full_out.push(n)
          if first { stk.clear() }
          break
        }
      }
      if !(first && full_out.length() > 0) {
        for i = n.children.length() - 1; i >= 0; i = i - 1 {
          let c = n.children[i]
          if c.kind == html::Kind::Element { stk.push(c) }
        }
      }
    }
    debug_assert(fast_out.length() == full_out.length(), "fast vs full count mismatch for " + sel)
    for i in 0..<fast_out.length() {
      debug_assert(fast_out[i].uid == full_out[i].uid, "fast vs full uid mismatch for " + sel)
    }
  }
}

test "id_idx exact invalidation ignores data-id and catches real id add/remove" {
  let ok = load("data:text/html;charset=utf-8,<div id='keep'></div><ul id='list'></ul>", 800.0, 600.0)
  debug_assert(ok, "loaded id_idx test doc")
  let doc_id = id_of(doc_state().root)
  let list_el = by_id(doc_state().root, "list")[0]
  let list_id = id_of(list_el)
  let keep_res0 = host_op(17, doc_id, 2, "keep", "")
  debug_assert(keep_res0.length() > 0, "initial getElementById('keep') hits")
  let gen0 = id_index_gen.v
  // data-id must NOT bump id_index_gen
  let _ = host_op(20, list_id, 0, "<li data-id=\"1\">a</li>", "")
  debug_assert(id_index_gen.v == gen0, "data-id in innerHTML must not bump id_index_gen")
  debug_assert(host_op(17, doc_id, 2, "keep", "") == keep_res0, "keep still hits after data-id innerHTML")
  // real id="new1" is incrementally indexed without bumping id_index_gen and found immediately
  let _ = host_op(20, list_id, 0, "<li id=\"new1\">b</li>", "")
  debug_assert(id_index_gen.v == gen0, "real non-dup id in innerHTML updates id_idx incrementally without full rebuild")
  debug_assert(host_op(17, doc_id, 2, "new1", "").length() > 0, "new1 found via getElementById")
  // replacing list removes new1 -> must return empty while keep still hits
  let _ = host_op(20, list_id, 0, "<li data-id=\"2\">c</li>", "")
  debug_assert(host_op(17, doc_id, 2, "new1", "") == "", "removed new1 must return empty")
  debug_assert(host_op(17, doc_id, 2, "keep", "") == keep_res0, "keep still hits after new1 removed")
}

test "id_idx incremental op12/op13 Sizzle temp id, duplicate id fallback, and 2-slot multi-doc" {
  let ok = load("data:text/html;charset=utf-8,<div id='keep'></div><span id='s'></span><p id='dup'>1</p><p id='dup'>2</p>", 800.0, 600.0)
  debug_assert(ok, "loaded id_idx incremental test doc")
  let doc = doc_state().root
  let doc_id = id_of(doc)
  let keep_el = by_id(doc, "keep")[0]
  let span_el = by_id(doc, "s")[0]
  let span_id = id_of(span_el)
  let dup_els = query(doc, "#dup", false)
  debug_assert(dup_els.length() == 2, "two dup elements")
  let dup0_id = id_of(dup_els[0])
  let dup1_id = id_of(dup_els[1])
  // Prime index on doc (has_dups = true initially because of dup)
  debug_assert(host_op(17, doc_id, 2, "dup", "") == dup0_id.to_string(), "dup hits first")
  // Remove id from first dup -> must fall back and find second dup!
  let _ = host_op(13, dup0_id, 0, "id", "")
  debug_assert(host_op(17, doc_id, 2, "dup", "") == dup1_id.to_string(), "after removing first dup, second dup found")
  // Now doc has NO duplicate ids -> rebuild cleared has_dups
  debug_assert(host_op(17, doc_id, 2, "keep", "") == id_of(keep_el).to_string(), "keep hits")
  let gen_before = id_index_gen.v
  // Sizzle pattern: add temp id on span (after removing its old id first)
  let _ = host_op(13, span_id, 0, "id", "")
  let _ = host_op(12, span_id, 0, "id", "sizzle1")
  debug_assert(id_index_gen.v == gen_before, "Sizzle op13+op12 must NOT bump id_index_gen when no dups")
  debug_assert(host_op(17, doc_id, 2, "sizzle1", "") == span_id.to_string(), "sizzle1 found incrementally")
  let _ = host_op(13, span_id, 0, "id", "")
  debug_assert(id_index_gen.v == gen_before, "Sizzle op13 cleanup must NOT bump id_index_gen")
  debug_assert(host_op(17, doc_id, 2, "sizzle1", "") == "", "sizzle1 gone after op13")
  debug_assert(host_op(17, doc_id, 2, "keep", "") == id_of(keep_el).to_string(), "keep still hits")
  // 2-slot multi-doc: alternating doc and a second document does not evict either slot
  let doc2 = html::parse("<!doctype html><html><body><div id='d2'></div></body></html>")
  let d2_el = by_id(doc2, "d2")[0]
  let doc2_id = id_of(doc2)
  debug_assert(host_op(17, doc2_id, 2, "d2", "") == id_of(d2_el).to_string(), "doc2 lookup hits")
  debug_assert((id_idx_a.root_uid == doc.uid && id_idx_b.root_uid == doc2.uid) || (id_idx_b.root_uid == doc.uid && id_idx_a.root_uid == doc2.uid), "both docs resident in 2-slot id_idx")
  debug_assert(host_op(17, doc_id, 2, "keep", "") == id_of(keep_el).to_string(), "doc1 still cached")
}

test "svg_markup strips undeclared XML prefixes (q:id/q:key) and propagates child opacity:0" {
  let html = "<!doctype html><html><head><style>.tip { opacity: 0; }</style></head><body>" +
  "<svg id='ic' width='24' height='24' viewBox='0 0 24 24' q:id='f' q:key='4o_0'>" +
  "<rect width='24' height='24' fill='#00ff00'/>" +
  "<g class='tip'><rect width='24' height='24' fill='#ff0000'/></g>" +
  "</svg></body></html>"
  let ok = load("data:text/html;charset=utf-8," + html, 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let svg_n = by_id(doc_state().root, "ic")[0]
  let markup = svg_markup(svg_n, 1.0)
  debug_assert(!markup.contains("q:id"), "undeclared q:id stripped from SVG XML")
  debug_assert(!markup.contains("q:key"), "undeclared q:key stripped from SVG XML")
  debug_assert(markup.contains("opacity:0"), "child CSS opacity:0 propagated into SVG style")
  // DOM attributes restored after serialization
  debug_assert(svg_n.attr("q:id").unwrap_or("") == "f", "q:id restored on DOM node")
  let full_svg = if markup.contains("xmlns=") { markup } else { str_replace_all(markup, "<svg", "<svg xmlns=\"http://www.w3.org/2000/svg\"") }
  match raster::decode_svg(utf8_encode(full_svg), 24) {
    Some((w, h, rgba)) => {
      debug_assert(w == 24 && h == 24, "decoded 24x24")
      let off = (12 * w + 12) * 4
      debug_assert((rgba[off].to_int() & 0xFF) == 0 && (rgba[off + 1].to_int() & 0xFF) == 255 && (rgba[off + 3].to_int() & 0xFF) == 255, "red tip hidden by opacity:0, green visible")
    }
    None => debug_assert(false, "decode_svg must succeed after stripping undeclared XML prefixes")
  }
}

test "loose_trees groups held children without allocating phantom root js_id and cuts after release" {
  let ok = load("data:text/html;charset=utf-8,<!doctype html><html><body></body></html>", 800.0, 600.0)
  debug_assert(ok, "page loaded")
  let parent = html::Node::element(html::Ns::Html, "li", [])
  let c1 = html::Node::element(html::Ns::Html, "span", [])
  let c2 = html::Node::element(html::Ns::Html, "button", [])
  parent.append(c1)
  parent.append(c2)
  let id1 = id_of(c1)
  let id2 = id_of(c2)
  debug_assert(parent.js_id == 0, "detached parent starts unheld")
  note_loose_subtree(parent)
  let s1 = loose_trees()
  debug_assert(s1 == "I" + id1.to_string() + "," + id2.to_string(), "loose_trees emits only held child ids in one group")
  debug_assert(parent.js_id == 0, "loose_trees must not allocate phantom js_id for unheld root")
  release_id_list([id1, id2])
  let s2 = loose_trees()
  debug_assert(s2 == "I", "loose_trees empty after releasing held children")
  debug_assert(parent.children.length() == 0, "detached parent cut once no descendants held")
}

///|
test "svg_markup inlines external <image xlink:href> as data:image/png;base64 and restores DOM attr" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body>" +
    "<svg id='g' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' width='20' height='20' viewBox='0 0 20 20'>" +
    "<path fill='url(#pat)' d='M0 0H20V20H0z'/>" +
    "<defs><pattern id='pat' width='1' height='1' patternContentUnits='objectBoundingBox'>" +
    "<use transform='scale(0.05)' xlink:href='#img0'/></pattern>" +
    "<image id='img0' width='20' height='20' xlink:href='https://example.com/cup.png'/></defs>" +
    "</svg></body></html>",
    800.0,
    600.0,
  )
  debug_assert(ok, "page loaded")
  // Build a real 2x2 solid red PNG in memory and seed st.pictures
  let rgba_in = Bytes::new(16)
  let mut p = 0
  while p < 16 {
    rgba_in[p] = 220.to_byte()
    rgba_in[p + 1] = 40.to_byte()
    rgba_in[p + 2] = 40.to_byte()
    rgba_in[p + 3] = 255.to_byte()
    p += 4
  }
  let png = raster::encode_png(rgba_in, 2, 2)
  st.pictures.set("https://example.com/cup.png", png)
  let svg_n = by_id(doc_state().root, "g")[0]
  let markup = svg_markup(svg_n, 1.0)
  debug_assert(markup.contains("data:image/png;base64,"), "svg_markup must inline external <image> as data:image/png;base64")
  let img_n = by_id(doc_state().root, "img0")[0]
  let mut orig_restored = false
  for a in img_n.attrs {
    if a.qname() == "xlink:href" && a.value == "https://example.com/cup.png" {
      orig_restored = true
    }
  }
  debug_assert(orig_restored, "original xlink:href must be restored on DOM node after serialization")
}

///|
test "Wave 47A: op 126 (OP.PATH) N/A/,W/S zero-alloc event ancestor chain" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body>" +
    "<div id='outer' onclick='x()'><span id='inner'>hi</span></div>" +
    "<div id='plain'><b id='leaf'>ok</b></div>" +
    "</body></html>",
    800.0,
    600.0,
  )
  debug_assert(ok, "page loaded")
  let inner = by_id(doc_state().root, "inner")[0]
  let leaf = by_id(doc_state().root, "leaf")[0]
  let id_inner = id_of(inner)
  let id_leaf = id_of(leaf)
  let p_on = host_op(126, id_inner, 1, "onclick", "")
  debug_assert(p_on.starts_with("A" + id_inner.to_string() + ","), "op 126 inline handler prefix A")
  debug_assert(p_on.ends_with(",W"), "op 126 window suffix ,W when b=1")
  let p_off = host_op(126, id_leaf, 0, "onclick", "")
  debug_assert(p_off.starts_with("N" + id_leaf.to_string() + ","), "op 126 no handler prefix N")
  debug_assert(!p_off.ends_with(",W"), "op 126 no ,W when b=0")
  // Shadow host returns "S"
  let sh_root = html::Node::new(html::Kind::Fragment)
  sh_root.set_host(Some(leaf))
  leaf.set_shadow(Some(sh_root))
  let p_sh = host_op(126, id_leaf, 1, "onclick", "")
  debug_assert(p_sh == "S", "op 126 returns S on shadow host")
}

///|
test "Wave 55B: svg_markup expands userSpaceOnUse <pattern> grid rect into tiled <g> and restores DOM losslessly" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body style='color:rgb(120,120,120)'>" +
    "<svg id='grid_svg' width='100%' height='100%'>" +
    "<defs><pattern id='grid-1' x='0' y='0' width='60' height='60' patternUnits='userSpaceOnUse'>" +
    "<path d='M 60 0 L 0 0 0 60' fill='transparent' stroke='currentColor' stroke-width='2'></path>" +
    "</pattern></defs>" +
    "<rect id='grid_rect' fill='url(#grid-1)' width='100%' height='100%'></rect>" +
    "</svg></body></html>",
    800.0,
    600.0,
  )
  debug_assert(ok, "page loaded")
  let svg = by_id(doc_state().root, "grid_svg")[0]
  let rect = by_id(doc_state().root, "grid_rect")[0]
  let out = svg_markup(svg, 1.0, box_w=180.0, box_h=120.0)
  debug_assert(out.contains("viewBox=\"0 0 180 120\""), "expected synthetic viewBox from box_w/box_h")
  debug_assert(out.contains("transform=\"translate(0,0)\""), "expected tile at (0,0)")
  debug_assert(out.contains("transform=\"translate(120,60)\""), "expected tile at (120,60)")
  debug_assert(out.contains("fill=\"none\""), "expected pattern rect fill neutralized during serialization")
  // Verify lossless DOM restoration after serialization
  debug_assert(svg.attr("viewBox").is_none(), "synthetic viewBox must be removed from DOM")
  debug_assert(svg.attr("width").unwrap_or("") == "100%", "svg width attr must be restored")
  debug_assert(rect.attr("fill").unwrap_or("") == "url(#grid-1)", "rect fill attr must be restored")
}

///|
test "svg_markup preserves native <pattern> z-order behind foreground nodes and inlines text-anchor" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><head><style>.d text{text-anchor:middle}</style></head><body>" +
    "<div class='d'><svg id='net_svg' viewBox='0 0 358 358'>" +
    "<defs><pattern id='sec-dot' width='14' height='14' patternUnits='userSpaceOnUse'><circle cx='11' cy='11' r='.9' fill='#C9C7C1'/></pattern></defs>" +
    "<rect x='16' y='16' width='325' height='325' fill='url(#sec-dot)'/>" +
    "<rect x='127' y='157' width='104' height='44' fill='#1C1B1A'/>" +
    "<text x='179' y='183'><tspan>Your phone</tspan></text>" +
    "</svg></div></body></html>",
    800.0,
    600.0,
  )
  debug_assert(ok, "page loaded")
  let svg = by_id(doc_state().root, "net_svg")[0]
  let out = svg_markup(svg, 1.0, box_w=358.0, box_h=358.0)
  debug_assert(out.contains("url(#sec-dot)"), "pattern behind foreground rect must remain native url(#sec-dot), got " + out)
  debug_assert(!out.contains("transform=\"translate("), "must not expand dense/background pattern into trailing <g> tiles")
  debug_assert(out.contains("text-anchor:middle;"), "CSS text-anchor:middle must be inlined onto SVG <text>, got " + out)
}

