///|
test "Wave 83A: fvIntBuf shared Int32Array for SWEEP, RELEASE, KIDS, QSA, PATH and overflow fallback" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body><div id='box'><span class='it'>a</span><em class='it'>b</em></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  debug_assert(js::intbuf_cap() == 262144, "fvIntBuf cap is 262144")
  // Verify KIDS (childNodes & children), QSA (querySelectorAll & getElementsByTagName), PATH (click dispatch), and SWEEP/RELEASE all work via fvIntBuf
  let res = eval(
    "(() => {" +
    "const box = document.getElementById('box');" +
    "const cn = box.childNodes.length;" +
    "const elc = box.children.length;" +
    "const qsa = document.querySelectorAll('.it').length;" +
    "const all = document.getElementsByTagName('*').length;" +
    "let clicked = 0;" +
    "box.addEventListener('click', () => { clicked++; });" +
    "box.firstElementChild.dispatchEvent(new MouseEvent('click', { bubbles: true }));" +
    "const d = document.createElement('div'); d.appendChild(document.createElement('span'));" +
    "globalThis.__w83d = d;" +
    "var orig = setTimeout; setTimeout = fn => fn(); globalThis.__sweepSoon(); setTimeout = orig;" +
    "return [cn, elc, qsa, all >= 5 ? 1 : 0, clicked].join(',');" +
    "})()",
  )
  debug_assert(res == "2,2,2,1,1", "fvIntBuf KIDS/QSA/PATH/SWEEP end-to-end check failed: " + res)
  // Verify direct host_int OP.KIDS & OP.SWEEP & OP.RELEASE + OP.PATH intbuf protocol
  let box_id = eval("document.getElementById('box')._id").to_int().unwrap_or(0)
  debug_assert(kids_to_intbuf(box_id, 0) == 2 && kids_to_intbuf(box_id, 1) == 2, "kids_to_intbuf b=0/1 returns 2")
  let p_res = host(126, box_id, 3, "onclick", "")
  debug_assert(p_res.starts_with("n") && p_res.length() >= 2, "OP.PATH b=3 returns intbuf prefix 'n<len>', got: " + p_res)
  // Verify loose_ib_emit_held overflow sets loose_ib.overflow cleanly
  loose_ib.pos = 2
  loose_ib.cap = 2
  loose_ib.overflow = false
  loose_emit.emitted = 1
  loose_emit.tree_started = false
  loose_ib_emit_held(42, js::intbuf_ptr())
  debug_assert(loose_ib.overflow, "loose_ib_emit_held must flag overflow when pos + 2 > cap")
  loose_ib.overflow = false
}

