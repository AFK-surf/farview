test "Wave 67A: op20 innerHTML <base> clears no_base_docs and <svg> sets svg_dirty via DomCounters" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><head id='hd'></head><body id='bd'><div>init</div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let hd = by_id(doc_state().root, "hd")[0]
  let bd = by_id(doc_state().root, "bd")[0]
  // Warm no_base_docs and clear svg_dirty
  let _ = eval("document.baseURI")
  svg_dirty.v = false
  let _ = eval("document.getElementById('bd').innerHTML = '<svg width=\"10\" height=\"10\"><rect width=\"10\" height=\"10\"/></svg>'")
  debug_assert(svg_dirty.v, "op20 innerHTML with <svg> must set svg_dirty")
  let _ = eval("document.getElementById('hd').innerHTML = '<base href=\"https://example.org/sub/\">'")
  let resolved = eval("new URL('p.html', document.baseURI).href")
  debug_assert(resolved == "https://example.org/sub/p.html", "op20 innerHTML <base> must clear no_base_docs, got " + resolved)
  let _ = hd
  let _ = bd
}

