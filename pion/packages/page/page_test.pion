  let _ = frame()
  let r = eval("JSON.stringify((()=>{const e=document.getElementById('sample');e.style.width='80px';e.style.width='calc(160px - env(safe-area-inset-left, 0px))';return [CSS.supports('width','calc(160px - env(safe-area-inset-left, 0px))'),e.getBoundingClientRect().width]})())")
  debug_assert(r == "[true,160]", "expected " + "[true,160]" + " observed " + r)
}

