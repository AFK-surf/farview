///|
test "Wave 66B: ReadableStream.tee() cancelling one branch does not error the other branch" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let _ = eval(
    "(() => {" +
    "globalThis.__teeOut = 'pending';" +
    "const s = new ReadableStream({ start(c) { c.enqueue('a'); setTimeout(() => { c.enqueue('b'); c.close(); }, 5); } });" +
    "const [b1, b2] = s.tee();" +
    "b1.cancel();" +
    "(async () => { const chunks = []; for await (const v of b2) chunks.push(v); globalThis.__teeOut = chunks.join(','); })().catch(e => { globalThis.__teeOut = 'ERR:' + e.message; });" +
    "})()",
  )
  tick(40)
  let out = eval("String(globalThis.__teeOut)")
  debug_assert(out == "a,b", "second tee branch must receive all chunks after first branch cancels, got " + out)
}

