///|
test "Wave 77B: Web Animations Element.animate opacity:0 applies to painted box tree" {
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><body style='margin:0'><div id='bd' style='position:fixed;inset:0;background:rgba(0,0,0,0.5)'></div></body></html>",
    400.0,
    300.0,
  )
  debug_assert(ok, "page loaded")
  let _ = eval("document.getElementById('bd').animate([{ opacity: 0 }, { opacity: 0 }], { duration: 100, fill: 'forwards' });")
  tick(150)
  ensure_layout()
  let bd = by_id(doc_state().root, "bd")[0]
  let mut found_op = -1.0
  match st.root {
    Some(root) => {
      let walk = [root]
      while walk.pop() is Some(b) {
        match b.node {
          Some(n) if n.uid == bd.uid => {
            found_op = b.style.number_id(css::p_opacity, 1.0)
            break
          }
          _ => ()
        }
        for ch in b.children {
          walk.push(ch)
        }
      }
    }
    None => ()
  }
  debug_assert(
    (found_op - 0.0).abs() < 0.001,
    "Web Animations opacity:0 must propagate to box style, got " + found_op.to_string(),
  )
}

