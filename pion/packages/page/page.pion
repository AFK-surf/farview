        let mut fw = st.w
        let mut fh = st.h
        for f in frames {
          if f.ctx == cur_ctx.v {
            let (szw, szh) = f.size
            if szw > 0.0 || szh > 0.0 {
              fw = szw
              fh = szh
            } else {
              match st.root {
                Some(root) => match layout::box_of(root, f.el) {
                  Some(bx) => {
                    fw = bx.w - bx.bl - bx.br - bx.pl - bx.pr
                    fh = bx.h - bx.bt - bx.bb - bx.pt - bx.pb
