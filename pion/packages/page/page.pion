// A page on the host: its document, its scripts and its layout.

///|
struct State {
  mut doc : html::Node
  nodes : Array[Option[html::Node]]
  mut url : String
  mut w : Double
  mut h : Double
  mut media : String
  fonts : layout::Fonts
  sheets : Map[String, String]
  mut dirty : Bool
  // counts changes to the document, so scripts can keep what they read from it until it changes
  mut version : Int
  mut root : Option[layout::Box]
  mut engine : Option[css::Engine]
  mut started : Bool
  errors : Array[String]
  pictures : Map[String, Bytes]
  fixed : Array[wire::Op]
  // every element's border box in the current layout, by layout id (made when a script first asks)
  mut rects : Option[intmap::IntMap[(Double, Double, Double, Double)]]
  styles : intmap::IntMap[css::Style]
  // the engine and the styles kept are for the document as it is (a script reading styles needs no layout for it)
  mut style_ok : Bool
  // what the engine was made from (its sheets, the viewport): made again only when that changes
  mut engine_key : Int64
  // the page's address as its scripts read it, when it was loaded or last moved (their URL writes it their way)
  mut js_href : String
  paint_kept : display::KeptCache
  mut last_hover_raw : String
}

///|
let st : State = {
  doc: html::Node::new(html::Kind::Document),
  nodes: [None],
  url: "",
  w: 1280.0,
  h: 800.0,
  media: "screen",
  fonts: make_host_fonts(),
  sheets: Map::new(),
  dirty: true,
  style_ok: false,
  engine_key: 0L,
  js_href: "",
  version: 0,
  root: None,
  engine: None,
  started: false,
  errors: [],
  pictures: Map::new(),
  fixed: [],
  rects: None,
  styles: intmap::IntMap::new(),
  paint_kept: display::KeptCache::new(),
  last_hover_raw: "",
}

///|
pub fn fonts() -> layout::Fonts {
  st.fonts
}

///|
pub fn url() -> String {
  st.url
}

///|
pub fn errors() -> Array[String] {
  st.errors
}

let free_ids : Array[Int] = []
let id_owner_ctx : Array[Int] = [0]

///|
/// Candidate detached tree roots (keyed by root uid) that may contain script-held nodes.
/// O(1) insert on detach/create; `loose_trees()` walks only dirty roots in incremental ("I") mode,
/// and falls back to full ("F") mode whenever a detached subtree is reattached or merged.
let loose_roots : intmap::IntMap[html::Node] = intmap::IntMap::with_capacity(64)
let dirty_loose_roots : intmap::IntMap[html::Node] = intmap::IntMap::with_capacity(64)
let swept_loose_roots : intmap::IntMap[Bool] = intmap::IntMap::with_capacity(64)
let swept_held_count : intmap::IntMap[Int] = intmap::IntMap::with_capacity(64)
let loose_root_ctx : intmap::IntMap[Int] = intmap::IntMap::with_capacity(64)
let loose_full_needed : Ref[Bool] = Ref::{ v: false }
let cross_ctx_seen : Ref[Bool] = Ref::{ v: false }

fn invalidate_swept_held_count(n : html::Node) -> Unit {
  if swept_held_count.len() > 0 || loose_root_ctx.len() > 0 {
    let r = tree_root(n)
    if swept_held_count.len() > 0 { swept_held_count.erase(r.uid) }
    if loose_root_ctx.len() > 0 { loose_root_ctx.erase(r.uid) }
  }
}

fn note_loose_subtree(r : html::Node) -> Unit {
  if r.parent is None && !r.has_host() && (r.kind != html::Kind::Document || !shown_root(r)) {
    loose_roots.set(r.uid, r)
    dirty_loose_roots.set(r.uid, r)
    if swept_held_count.len() > 0 { swept_held_count.erase(r.uid) }
    if loose_root_ctx.len() > 0 { loose_root_ctx.erase(r.uid) }
  }
}

fn id_of_connected(n : html::Node) -> Int {
  if n.js_id == 0 {
    match free_ids.pop() {
      Some(slot) if slot > 0 && slot < st.nodes.length() => {
        st.nodes[slot] = Some(n)
        if slot < id_owner_ctx.length() {
          id_owner_ctx[slot] = cur_ctx.v
        }
        n.js_id = slot
      }
      _ => {
        st.nodes.push(Some(n))
        id_owner_ctx.push(cur_ctx.v)
        n.js_id = st.nodes.length() - 1
      }
    }
  } else if n.js_id > 0 && n.js_id < id_owner_ctx.length() && id_owner_ctx[n.js_id] != cur_ctx.v {
    id_owner_ctx[n.js_id] = -1
    cross_ctx_seen.v = true
  }
  n.js_id
}

fn id_of(n : html::Node) -> Int {
  if n.js_id == 0 {
    match free_ids.pop() {
      Some(slot) if slot > 0 && slot < st.nodes.length() => {
        st.nodes[slot] = Some(n)
        if slot < id_owner_ctx.length() {
          id_owner_ctx[slot] = cur_ctx.v
        }
        n.js_id = slot
      }
      _ => {
        st.nodes.push(Some(n))
        id_owner_ctx.push(cur_ctx.v)
        n.js_id = st.nodes.length() - 1
      }
    }
    if n.parent is None && !n.has_host() && (n.kind != html::Kind::Document || !shown_root(n)) {
      loose_roots.set(n.uid, n)
      dirty_loose_roots.set(n.uid, n)
      if swept_held_count.len() > 0 { swept_held_count.erase(n.uid) }
      if loose_root_ctx.len() > 0 { loose_root_ctx.erase(n.uid) }
    } else if loose_roots.len() > 0 {
      let r = tree_root(n)
      if loose_roots.contains(r.uid) {
        dirty_loose_roots.set(r.uid, r)
        if swept_held_count.len() > 0 { swept_held_count.erase(r.uid) }
        if loose_root_ctx.len() > 0 { loose_root_ctx.erase(r.uid) }
      }
    }
  } else if n.js_id > 0 && n.js_id < id_owner_ctx.length() && id_owner_ctx[n.js_id] != cur_ctx.v {
    id_owner_ctx[n.js_id] = -1
    cross_ctx_seen.v = true
    if loose_root_ctx.len() > 0 {
      let r = tree_root(n)
      loose_root_ctx.erase(r.uid)
    }
  }
  n.js_id
}

///|
fn at(i : Int) -> html::Node {
  if i >= 0 && i < st.nodes.length() {
    match st.nodes[i] {
      Some(n) => return n
      None => ()
    }
  }
  html::Node::new(html::Kind::Fragment)
}

///|
let csv_sb : StringBuilder = StringBuilder::new()
let path_ids_buf : Array[Int] = []
let path_sb : StringBuilder = StringBuilder::new()

fn make_int_str_1000() -> Array[String] {
  let out : Array[String] = Array::with_capacity(1000)
  let mut i = 0
  while i < 1000 {
    out.push(i.to_string())
    i += 1
  }
  out
}

fn make_int_pad3_1000() -> Array[String] {
  let out : Array[String] = Array::with_capacity(1000)
  let mut i = 0
  while i < 1000 {
    if i < 10 {
      out.push("00" + i.to_string())
    } else if i < 100 {
      out.push("0" + i.to_string())
    } else {
      out.push(i.to_string())
    }
    i += 1
  }
  out
}

let int_str_1000 : Array[String] = make_int_str_1000()
let int_pad3_1000 : Array[String] = make_int_pad3_1000()

fn sb_write_int(b : StringBuilder, v : Int) -> Unit {
  if v >= 0 && v < 1000000 {
    if v < 1000 {
      b.write_string(int_str_1000[v])
      return
    }
    b.write_string(int_str_1000[v / 1000])
    b.write_string(int_pad3_1000[v % 1000])
    return
  }
  let mut x = v
  if x < 0 {
    b.write_byte(b'-')
    x = -x
  }
  // Max 10 digits for positive 32-bit Int; avoid any heap allocation.
  let mut p = 1
  while x / p >= 10 {
    p = p * 10
  }
  while p > 0 {
    let d = x / p
    b.write_byte((48 + d).to_byte())
    x = x - d * p
    p = p / 10
  }
}

fn el_kn(c : html::Node) -> Int {
  let ns = match c.ns {
    Html => 0
    Svg => 1
    MathMl => 2
    Other => 3
  }
  1 | (ns << 8) | (tag_code(c.tag) << 12)
}

fn csv_with_kn(list : Array[html::Node]) -> String {
  if list.length() == 0 {
    return ""
  }
  csv_sb.reset()
  for i, n in list {
    if i > 0 {
      csv_sb.write_byte(b',')
    }
    sb_write_int(csv_sb, id_of(n))
    csv_sb.write_byte(b':')
    sb_write_int(csv_sb, el_kn(n))
  }
  let out = csv_sb.to_string()
  csv_sb.reset()
  out
}

fn csv_el_kids_kn(list : Array[html::Node]) -> String {
  if list.length() == 0 {
    return ""
  }
  csv_sb.reset()
  let mut first = true
  for n in list {
    if n.kind == html::Kind::Element {
      if !first {
        csv_sb.write_byte(b',')
      }
      first = false
      sb_write_int(csv_sb, id_of(n))
      csv_sb.write_byte(b':')
      sb_write_int(csv_sb, el_kn(n))
    }
  }
  let out = csv_sb.to_string()
  csv_sb.reset()
  out
}

fn csv(list : Array[html::Node]) -> String {
  if list.length() == 0 {
    return ""
  }
  csv_sb.reset()
  for i, n in list {
    if i > 0 {
      csv_sb.write_byte(b',')
    }
    sb_write_int(csv_sb, id_of(n))
  }
  let out = csv_sb.to_string()
  csv_sb.reset()
  out
}

///|
/// Documents (main or iframe, by uid) confirmed to contain no `<base>` element; cleared whenever
/// any `<base>` element is created/parsed or a new document loads.
let no_base_docs : intmap::IntMap[Bool] = intmap::IntMap::new()

///|
fn is_ident_alpha_or_us(c : Int) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
}

///|
fn is_simple_ident(s : String, start : Int) -> Bool {
  let n = s.length()
  if start >= n {
    return false
  }
  let c0 = s.code_unit_at(start)
  if c0 == 45 {
    // CSS ident starting with '-' must be followed by [A-Za-z_-], never a digit (e.g. .-1 is invalid)
    if start + 1 >= n {
      return false
    }
    let c1 = s.code_unit_at(start + 1)
    if !is_ident_alpha_or_us(c1) && c1 != 45 {
      return false
    }
  } else if !is_ident_alpha_or_us(c0) {
    // CSS ident cannot start with a digit (e.g. #123, .0a must throw SyntaxError via selectors_of)
    return false
  }
  let mut i = start + 1
  while i < n {
    let c = s.code_unit_at(i)
    if !is_ident_alpha_or_us(c) && (c < 48 || c > 57) && c != 45 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn is_cls_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13 || c == 12
}

///|
fn has_class_token(cls_attr : String, target : String) -> Bool {
  let n = cls_attr.length()
  let m = target.length()
  if m == 0 || n < m {
    return false
  }
  let mut i = 0
  while i < n {
    while i < n && is_cls_ws(cls_attr.code_unit_at(i)) {
      i += 1
    }
    let start = i
    while i < n && !is_cls_ws(cls_attr.code_unit_at(i)) {
      i += 1
    }
    if i - start == m {
      let mut eq = true
      let mut k = 0
      while k < m {
        if cls_attr.code_unit_at(start + k) != target.code_unit_at(k) {
          eq = false
          break
        }
        k = k + 1
      }
      if eq {
        return true
      }
    }
  }
  false
}

struct AttrIndex {
  mut root_uid : Int
  mut attr_name : String
  mut tree_ver : Int
  mut insert_ver : Int
  mut has_dups : Bool
  map : Map[String, html::Node]
}

struct ClassIndex {
  mut root_uid : Int
  mut tree_ver : Int
  mut insert_ver : Int
  mut seen_root_uid : Int
  mut seen_insert_ver : Int
  map : Map[String, Array[html::Node]]
  dirty : Map[String, Bool]
}

let attr_index_gen : Ref[Int] = Ref::{ v: 1 }
let id_index_gen : Ref[Int] = Ref::{ v: 1 }
let id_idx_pick : Ref[Int] = Ref::{ v: 0 }
let class_insert_gen : Ref[Int] = Ref::{ v: 1 }
let class_idx_pick : Ref[Int] = Ref::{ v: 0 }

let class_idx_a : ClassIndex = ClassIndex::{
  root_uid: -1,
  tree_ver: -1,
  insert_ver: -1,
  seen_root_uid: -1,
  seen_insert_ver: -1,
  map: Map::new(),
  dirty: Map::new(),
}

let class_idx_b : ClassIndex = ClassIndex::{
  root_uid: -1,
  tree_ver: -1,
  insert_ver: -1,
  seen_root_uid: -1,
  seen_insert_ver: -1,
  map: Map::new(),
  dirty: Map::new(),
}

fn pick_class_idx(root_uid : Int) -> ClassIndex {
  if class_idx_a.root_uid == root_uid || class_idx_a.seen_root_uid == root_uid {
    return class_idx_a
  }
  if class_idx_b.root_uid == root_uid || class_idx_b.seen_root_uid == root_uid {
    return class_idx_b
  }
  if class_idx_a.root_uid < 0 && class_idx_a.seen_root_uid < 0 {
    return class_idx_a
  }
  if class_idx_b.root_uid < 0 && class_idx_b.seen_root_uid < 0 {
    return class_idx_b
  }
  class_idx_pick.v = 1 - class_idx_pick.v
  if class_idx_pick.v == 0 { class_idx_a } else { class_idx_b }
}

fn is_class_ws(c : Int) -> Bool {
  c <= 32 && (c == 32 || (c >= 9 && c <= 13 && c != 11))
}

fn class_idx_mark_tokens_dirty(idx : ClassIndex, cv : String) -> Unit {
  let n = cv.length()
  let mut i = 0
  while i < n {
    while i < n && is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    let start = i
    while i < n && !is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    if i > start {
      let tok = if start == 0 && i == n { cv } else { cv.slice(start, i) }
      idx.dirty.set(tok, true)
    }
  }
}

fn class_str_has_tok(cv : String, tok : String) -> Bool {
  let tlen = tok.length()
  let n = cv.length()
  let mut i = 0
  while i < n {
    while i < n && is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    let start = i
    while i < n && !is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    if i - start == tlen {
      let mut eq = true
      let mut k = 0
      while k < tlen {
        if cv.code_unit_at(start + k) != tok.code_unit_at(k) {
          eq = false
          break
        }
        k += 1
      }
      if eq {
        return true
      }
    }
  }
  false
}

fn class_idx_mark_diff_tokens(idx : ClassIndex, a : String, b : String) -> Unit {
  let n = a.length()
  let mut i = 0
  while i < n {
    while i < n && is_class_ws(a.code_unit_at(i)) {
      i += 1
    }
    let start = i
    while i < n && !is_class_ws(a.code_unit_at(i)) {
      i += 1
    }
    if i > start {
      let tok = if start == 0 && i == n { a } else { a.slice(start, i) }
      if !class_str_has_tok(b, tok) {
        idx.dirty.set(tok, true)
      }
    }
  }
}

fn class_idx_on_attr_change(old_val : String, new_val : String) -> Unit {
  if old_val == new_val {
    return
  }
  if class_idx_a.root_uid >= 0 {
    class_idx_mark_diff_tokens(class_idx_a, old_val, new_val)
    class_idx_mark_diff_tokens(class_idx_a, new_val, old_val)
    if class_idx_a.dirty.length() > 64 {
      class_idx_a.root_uid = -1
      class_idx_a.map.clear()
      class_idx_a.dirty.clear()
    }
  }
  if class_idx_b.root_uid >= 0 {
    class_idx_mark_diff_tokens(class_idx_b, old_val, new_val)
    class_idx_mark_diff_tokens(class_idx_b, new_val, old_val)
    if class_idx_b.dirty.length() > 64 {
      class_idx_b.root_uid = -1
      class_idx_b.map.clear()
      class_idx_b.dirty.clear()
    }
  }
}

fn class_idx_insert_tokens_into(
  idx : ClassIndex,
  parent_uid : Int,
  n : html::Node,
  cv : String,
  is_append : Bool,
) -> Unit {
  let len = cv.length()
  let mut i = 0
  while i < len {
    while i < len && is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    let start = i
    while i < len && !is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    if i > start {
      let tok = if start == 0 && i == len { cv } else { cv.slice(start, i) }
      if !idx.dirty.contains(tok) {
        if is_append {
          match idx.map.get(tok) {
            None => idx.map.set(tok, [n])
            Some(arr) => {
              let alen = arr.length()
              if alen == 0 {
                arr.push(n)
              } else {
                let last = arr[alen - 1]
                if last.uid != n.uid {
                  if last.uid == parent_uid || is_descendant_of_uid(last, parent_uid) {
                    arr.push(n)
                  } else {
                    idx.dirty.set(tok, true)
                  }
                }
              }
            }
          }
        } else {
          idx.dirty.set(tok, true)
        }
      }
    }
  }
}

fn class_idx_insert_node_into(
  idx : ClassIndex,
  parent_uid : Int,
  n : html::Node,
  is_append : Bool,
) -> Unit {
  if n.attrs.length() == 0 {
    return
  }
  if n.class_bloom_valid {
    let bloom = n.class_bloom
    if bloom == 0L {
      return
    }
    class_idx_insert_tokens_into(idx, parent_uid, n, n.class_val, is_append)
    return
  }
  match n.attr("class") {
    None => {
      n.class_bloom_valid = true
      n.class_bloom = 0L
      n.class_val = ""
    }
    Some(cv) => class_idx_insert_tokens_into(idx, parent_uid, n, cv, is_append)
  }
}

fn class_idx_on_insert_one(
  idx : ClassIndex,
  parent : html::Node,
  inserted : html::Node,
  is_append : Bool,
) -> Unit {
  if idx.root_uid < 0 || idx.insert_ver != class_insert_gen.v {
    return
  }
  if parent.uid != idx.root_uid && !is_descendant_of_uid(parent, idx.root_uid) {
    return
  }
  let puid = parent.uid
  let stack : Array[html::Node] = [inserted]
  while stack.pop() is Some(x) {
    if x.kind == html::Kind::Element {
      class_idx_insert_node_into(idx, puid, x, is_append)
    }
    let mut i = x.children.length() - 1
    while i >= 0 {
      let c = x.children[i]
      if c.kind == html::Kind::Element || c.kind == html::Kind::Fragment {
        stack.push(c)
      }
      i -= 1
    }
  }
  if idx.dirty.length() > 64 {
    idx.root_uid = -1
    idx.map.clear()
    idx.dirty.clear()
  }
}

fn class_idx_on_insert(parent : html::Node, inserted : html::Node, is_append : Bool) -> Unit {
  if class_idx_a.root_uid >= 0 {
    class_idx_on_insert_one(class_idx_a, parent, inserted, is_append)
  }
  if class_idx_b.root_uid >= 0 {
    class_idx_on_insert_one(class_idx_b, parent, inserted, is_append)
  }
}

fn class_idx_push_token(map : Map[String, Array[html::Node]], tok : String, n : html::Node) -> Unit {
  match map.get(tok) {
    Some(arr) => {
      let alen = arr.length()
      if alen == 0 || arr[alen - 1].uid != n.uid {
        arr.push(n)
      }
    }
    None => map.set(tok, [n])
  }
}

fn class_idx_index_tokens(map : Map[String, Array[html::Node]], n : html::Node, cv : String) -> Unit {
  let len = cv.length()
  let mut i = 0
  while i < len {
    while i < len && is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    let start = i
    while i < len && !is_class_ws(cv.code_unit_at(i)) {
      i += 1
    }
    if i > start {
      let tok = if start == 0 && i == len { cv } else { cv.slice(start, i) }
      class_idx_push_token(map, tok, n)
    }
  }
}

fn class_idx_index_node(map : Map[String, Array[html::Node]], n : html::Node) -> Unit {
  if n.attrs.length() == 0 {
    return
  }
  if n.class_bloom_valid {
    let bloom = n.class_bloom
    if bloom == 0L {
      return
    }
    if bloom < 0L {
      class_idx_push_token(map, n.class_val, n)
      return
    }
    class_idx_index_tokens(map, n, n.class_val)
    return
  }
  match n.attr("class") {
    None => {
      n.class_bloom_valid = true
      n.class_bloom = 0L
      n.class_val = ""
    }
    Some(cv) => class_idx_index_tokens(map, n, cv)
  }
}

fn class_index_lookup(root : html::Node, cls : String, cls_mask : Int64, first : Bool, out : Array[html::Node]) -> Unit {
  let idx = pick_class_idx(root.uid)
  let tc = html::tree_changes_count()
  let iv = class_insert_gen.v
  if idx.root_uid == root.uid && idx.insert_ver == iv {
    if idx.dirty.contains(cls) {
      let from = root.content_node()
      let _ = query_walk_class(from, cls, cls_mask, first, out)
      return
    }
    match idx.map.get(cls) {
      None => return
      Some(arr) => {
        if idx.tree_ver == tc {
          if first {
            if arr.length() > 0 {
              out.push(arr[0])
            }
          } else {
            let mut i = 0
            let alen = arr.length()
            while i < alen {
              out.push(arr[i])
              i += 1
            }
          }
          return
        }
        // Only removals happened since build: filter in-place preserving exact DOM order
        let alen = arr.length()
        if first {
          let mut i = 0
          while i < alen {
            let c = arr[i]
            if is_descendant_of_uid(c, root.uid) {
              out.push(c)
              return
            }
            i += 1
          }
          return
        }
        let mut w = 0
        let mut r = 0
        while r < alen {
          let c = arr[r]
          if is_descendant_of_uid(c, root.uid) {
            if w != r {
              arr[w] = c
            }
            out.push(c)
            w += 1
          }
          r += 1
        }
        while arr.length() > w {
          let _ = arr.pop()
        }
        return
      }
    }
  }
  // Adaptive threshold: on the first query for (root.uid, iv), walk directly without allocating
  // a full class map; build the index on the 2nd query against the same generation.
  if idx.seen_root_uid != root.uid || idx.seen_insert_ver != iv {
    idx.seen_root_uid = root.uid
    idx.seen_insert_ver = iv
    let from = root.content_node()
    let _ = query_walk_class(from, cls, cls_mask, first, out)
    return
  }
  idx.map.clear()
  idx.dirty.clear()
  let stack : Array[html::Node] = []
  let from = root.content_node()
  for i = from.children.length() - 1; i >= 0; i = i - 1 {
    let c = from.children[i]
    if c.kind == html::Kind::Element {
      stack.push(c)
    }
  }
  while stack.pop() is Some(n) {
    class_idx_index_node(idx.map, n)
    for i = n.children.length() - 1; i >= 0; i = i - 1 {
      let c = n.children[i]
      if c.kind == html::Kind::Element {
        stack.push(c)
      }
    }
  }
  idx.root_uid = root.uid
  idx.tree_ver = tc
  idx.insert_ver = iv
  match idx.map.get(cls) {
    None => ()
    Some(arr) =>
    if first {
      if arr.length() > 0 {
        out.push(arr[0])
      }
    } else {
      let mut i = 0
      let alen = arr.length()
      while i < alen {
        out.push(arr[i])
        i += 1
      }
    }
  }
}

let id_idx_a : AttrIndex = AttrIndex::{
  root_uid: -1,
  attr_name: "id",
  tree_ver: -1,
  insert_ver: -1,
  has_dups: false,
  map: Map::new(),
}

let id_idx_b : AttrIndex = AttrIndex::{
  root_uid: -1,
  attr_name: "id",
  tree_ver: -1,
  insert_ver: -1,
  has_dups: false,
  map: Map::new(),
}

let attr_idx : AttrIndex = AttrIndex::{
  root_uid: -1,
  attr_name: "",
  tree_ver: -1,
  insert_ver: -1,
  has_dups: false,
  map: Map::new(),
}

fn pick_id_idx(root_uid : Int) -> AttrIndex {
  if id_idx_a.root_uid == root_uid {
    return id_idx_a
  }
  if id_idx_b.root_uid == root_uid {
    return id_idx_b
  }
  if id_idx_a.root_uid < 0 {
    return id_idx_a
  }
  if id_idx_b.root_uid < 0 {
    return id_idx_b
  }
  id_idx_pick.v = 1 - id_idx_pick.v
  if id_idx_pick.v == 0 { id_idx_a } else { id_idx_b }
}

fn clear_attr_indices() -> Unit {
  id_idx_a.root_uid = -1
  id_idx_a.has_dups = false
  id_idx_a.map.clear()
  id_idx_b.root_uid = -1
  id_idx_b.has_dups = false
  id_idx_b.map.clear()
  attr_idx.root_uid = -1
  attr_idx.attr_name = ""
  attr_idx.has_dups = false
  attr_idx.map.clear()
  class_idx_a.root_uid = -1
  class_idx_a.seen_root_uid = -1
  class_idx_a.map.clear()
  class_idx_a.dirty.clear()
  class_idx_b.root_uid = -1
  class_idx_b.seen_root_uid = -1
  class_idx_b.map.clear()
  class_idx_b.dirty.clear()
}

fn is_descendant_of_uid(n : html::Node, root_uid : Int) -> Bool {
  let mut p = n.parent
  while p is Some(anc) {
    if anc.uid == root_uid {
      return true
    }
    p = anc.parent
  }
  false
}

fn id_idx_on_add(n : html::Node, id_val : String) -> Unit {
  let ver = id_index_gen.v
  if id_idx_a.root_uid >= 0 && id_idx_a.insert_ver == ver && is_descendant_of_uid(n, id_idx_a.root_uid) {
    match id_idx_a.map.get(id_val) {
      Some(existing) =>
      if existing.uid != n.uid && is_descendant_of_uid(existing, id_idx_a.root_uid) {
        id_idx_a.has_dups = true
        id_index_gen.v += 1
        return
      }
      None => ()
    }
    id_idx_a.map.set(id_val, n)
  }
  if id_idx_b.root_uid >= 0 && id_idx_b.insert_ver == ver && is_descendant_of_uid(n, id_idx_b.root_uid) {
    match id_idx_b.map.get(id_val) {
      Some(existing) =>
      if existing.uid != n.uid && is_descendant_of_uid(existing, id_idx_b.root_uid) {
        id_idx_b.has_dups = true
        id_index_gen.v += 1
        return
      }
      None => ()
    }
    id_idx_b.map.set(id_val, n)
  }
}

fn id_idx_add_subtree(n : html::Node) -> Unit {
  if n.kind == html::Kind::Element {
    if n.has_shadow() {
      id_index_gen.v += 1
      return
    }
    match n.attr("id") {
      Some(av) => id_idx_on_add(n, av)
      None => ()
    }
  }
  let ch = n.children
  let len = ch.length()
  let mut i = 0
  while i < len {
    let c = ch[i]
    if c.kind == html::Kind::Element || c.kind == html::Kind::Fragment {
      id_idx_add_subtree(c)
    }
    i += 1
  }
}

fn id_idx_on_remove(n : html::Node, id_val : String) -> Unit {
  let ver = id_index_gen.v
  if (id_idx_a.root_uid >= 0 && id_idx_a.insert_ver == ver && id_idx_a.has_dups) ||
  (id_idx_b.root_uid >= 0 && id_idx_b.insert_ver == ver && id_idx_b.has_dups) {
    id_index_gen.v += 1
    return
  }
  if id_idx_a.root_uid >= 0 && id_idx_a.insert_ver == ver {
    match id_idx_a.map.get(id_val) {
      Some(m) => if m.uid == n.uid { let _ = id_idx_a.map.remove(id_val) }
      None => ()
    }
  }
  if id_idx_b.root_uid >= 0 && id_idx_b.insert_ver == ver {
    match id_idx_b.map.get(id_val) {
      Some(m) => if m.uid == n.uid { let _ = id_idx_b.map.remove(id_val) }
      None => ()
    }
  }
}

fn is_connected_to_id_idx(n : html::Node) -> Bool {
  let ra = id_idx_a.root_uid
  let rb = id_idx_b.root_uid
  if ra < 0 && rb < 0 {
    return false
  }
  if n.uid == ra || n.uid == rb {
    return true
  }
  let mut p = n.parent
  while p is Some(anc) {
    if anc.uid == ra || anc.uid == rb {
      return true
    }
    p = anc.parent
  }
  false
}

fn subtree_has_id_attr(n : html::Node) -> Bool {
  if n.kind == html::Kind::Element {
    if n.has_shadow() || n.attr("id").is_some() {
      return true
    }
  }
  let ch = n.children
  let len = ch.length()
  let mut i = 0
  while i < len {
    let c = ch[i]
    if c.kind == html::Kind::Element || c.kind == html::Kind::Fragment {
      if subtree_has_id_attr(c) {
        return true
      }
    }
    i += 1
  }
  false
}

fn is_descendant_of(n : html::Node, root : html::Node) -> Bool {
  is_descendant_of_uid(n, root.uid)
}

fn str_contains_ci(hay : String, needle : String) -> Bool {
  let nl = needle.length()
  if nl == 0 {
    return false
  }
  let hl = hay.length()
  if hl < nl {
    return false
  }
  let n0 = needle.code_unit_at(0)
  let lim = hl - nl
  let mut i = 0
  while i <= lim {
    let c = hay.code_unit_at(i)
    if (c == n0) || ((c | 32) == n0 && c >= 65 && c <= 90) {
      let mut j = 1
      while j < nl {
        let hc = hay.code_unit_at(i + j)
        let nc = needle.code_unit_at(j)
        if hc != nc && !((hc | 32) == nc && hc >= 65 && hc <= 90) {
          break
        }
        j += 1
      }
      if j == nl {
        return true
      }
    }
    i += 1
  }
  false
}

fn is_html_attr_sep_before(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D || c == 0x0C || c == 0x2F
}

fn is_html_attr_sep_after(c : Int) -> Bool {
  c == 0x3D || c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D || c == 0x0C || c == 0x3E || c == 0x2F
}

fn str_contains_attr_ci(hay : String, needle : String) -> Bool {
  let nl = needle.length()
  if nl == 0 {
    return true
  }
  let hl = hay.length()
  if hl < nl {
    return false
  }
  let n0 = needle.code_unit_at(0)
  let lim = hl - nl
  let mut i = 0
  while i <= lim {
    let c = hay.code_unit_at(i)
    if ((c == n0) || ((c | 32) == n0 && c >= 65 && c <= 90)) && (i == 0 || is_html_attr_sep_before(hay.code_unit_at(i - 1))) {
      let mut j = 1
      while j < nl {
        let hc = hay.code_unit_at(i + j)
        let nc = needle.code_unit_at(j)
        if hc != nc && !((hc | 32) == nc && hc >= 65 && hc <= 90) {
          break
        }
        j += 1
      }
      if j == nl && (i + nl == hl || is_html_attr_sep_after(hay.code_unit_at(i + nl))) {
        return true
      }
    }
    i += 1
  }
  false
}

fn attr_index_lookup_one(idx : AttrIndex, root : html::Node, attr_name : String, raw_name : String, attr_val : String, ver : Int) -> Option[html::Node] {
  let tc = html::tree_changes_count()
  if idx.root_uid == root.uid && idx.attr_name == attr_name && idx.insert_ver == ver {
    if idx.tree_ver == tc {
      return idx.map.get(attr_val)
    }
    match idx.map.get(attr_val) {
      Some(n) =>
      if is_descendant_of(n, root) {
        return Some(n)
      }
      None => return None
    }
  }
  idx.map.clear()
  idx.has_dups = false
  let stack : Array[html::Node] = []
  let from = root.content_node()
  for i = from.children.length() - 1; i >= 0; i = i - 1 {
    let c = from.children[i]
    if c.kind == html::Kind::Element {
      stack.push(c)
    }
  }
  while stack.pop() is Some(n) {
    match n.attr(if n.ns == html::Ns::Html { attr_name } else { raw_name }) {
      Some(av) =>
      if !idx.map.contains(av) {
        idx.map.set(av, n)
      } else {
        idx.has_dups = true
      }
      None => ()
    }
    for i = n.children.length() - 1; i >= 0; i = i - 1 {
      let c = n.children[i]
      if c.kind == html::Kind::Element {
        stack.push(c)
      }
    }
  }
  idx.root_uid = root.uid
  idx.attr_name = attr_name
  idx.tree_ver = tc
  idx.insert_ver = ver
  idx.map.get(attr_val)
}

fn attr_index_lookup(idx : AttrIndex, root : html::Node, attr_name : String, raw_name : String, attr_val : String, ver : Int) -> Array[html::Node] {
  match attr_index_lookup_one(idx, root, attr_name, raw_name, attr_val, ver) {
    Some(n) => [n]
    None => []
  }
}

let star_csv_count : Ref[Int] = Ref::{ v: 0 }

fn query_star_kn_to_csv_sb(parent : html::Node) -> Unit {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if star_csv_count.v > 0 {
        csv_sb.write_byte(b',')
      }
      sb_write_int(csv_sb, id_of(c))
      csv_sb.write_byte(b':')
      sb_write_int(csv_sb, el_kn(c))
      star_csv_count.v += 1
      if c.children.length() > 0 {
        query_star_kn_to_csv_sb(c)
      }
    }
    i = i + 1
  }
}

fn query_star_to_csv_sb(parent : html::Node) -> Unit {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if star_csv_count.v > 0 {
        csv_sb.write_byte(b',')
      }
      sb_write_int(csv_sb, id_of(c))
      star_csv_count.v += 1
      if c.children.length() > 0 {
        query_star_to_csv_sb(c)
      }
    }
    i = i + 1
  }
}

fn query_walk_all(parent : html::Node, first : Bool, out : Array[html::Node]) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      out.push(c)
      if first {
        return true
      }
      if c.children.length() > 0 && query_walk_all(c, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_walk_tag(parent : html::Node, want : String, first : Bool, out : Array[html::Node]) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if c.tag == want || (c.ns != html::Ns::Html && ascii_lower(c.tag) == want) {
        out.push(c)
        if first {
          return true
        }
      }
      if c.children.length() > 0 && query_walk_tag(c, want, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_walk_id(parent : html::Node, id : String, out : Array[html::Node]) -> Unit {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      match c.attr("id") {
        Some(av) => if av == id { out.push(c) }
        None => ()
      }
      if c.children.length() > 0 {
        query_walk_id(c, id, out)
      }
    }
    i = i + 1
  }
}

fn query_walk_class(parent : html::Node, cls : String, cls_mask : Int64, first : Bool, out : Array[html::Node]) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if (!c.class_bloom_valid || (c.class_bloom & cls_mask) == cls_mask) && c.has_class_masked(cls, cls_mask) {
        out.push(c)
        if first {
          return true
        }
      }
      if c.children.length() > 0 && query_walk_class(c, cls, cls_mask, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_walk_nth_child_class(
  parent : html::Node,
  want_tag : String,
  k : Int,
  cls : String,
  cls_mask : Int64,
  first : Bool,
  out : Array[html::Node],
) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  let mut el_idx = 0
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      el_idx += 1
      if el_idx == k && (c.tag == want_tag || (c.ns != html::Ns::Html && ascii_lower(c.tag) == want_tag)) {
        if c.children.length() > 0 && query_walk_class(c, cls, cls_mask, first, out) {
          return true
        }
      } else if c.children.length() > 0 && query_walk_nth_child_class(c, want_tag, k, cls, cls_mask, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn node_is_checked(n : html::Node) -> Bool {
  if n.tag == "input" { html::checked(n) } else { n.attr("selected").is_some() }
}

fn query_walk_attr(
  parent : html::Node,
  tag_want : String,
  attr_name : String,
  raw_name : String,
  attr_val : String,
  first : Bool,
  out : Array[html::Node],
) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if (tag_want == "" || c.tag == tag_want || (c.ns != html::Ns::Html && ascii_lower(c.tag) == tag_want)) &&
      (match c.attr(if c.ns == html::Ns::Html { attr_name } else { raw_name }) {
        Some(av) => av == attr_val
        None => false
      }) {
        out.push(c)
        if first {
          return true
        }
      }
      if c.children.length() > 0 && query_walk_attr(c, tag_want, attr_name, raw_name, attr_val, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_walk_tag_class(
  parent : html::Node,
  want : String,
  cls : String,
  cls_mask : Int64,
  first : Bool,
  out : Array[html::Node],
) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if c.has_class_masked(cls, cls_mask) && (c.tag == want || (c.ns != html::Ns::Html && ascii_lower(c.tag) == want)) {
        out.push(c)
        if first {
          return true
        }
      }
      if c.children.length() > 0 && query_walk_tag_class(c, want, cls, cls_mask, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_walk_desc_class(
  parent : html::Node,
  left_is_cls : Bool,
  anc_cls : String,
  anc_mask : Int64,
  anc_tag : String,
  cls2 : String,
  mask2 : Int64,
  first : Bool,
  out : Array[html::Node],
) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if c.has_class_masked(cls2, mask2) {
        let mut p = c.parent
        let mut hit = false
        while p is Some(anc) && anc.kind == html::Kind::Element {
          if (if left_is_cls { anc.has_class_masked(anc_cls, anc_mask) } else { anc.tag == anc_tag || (anc.ns != html::Ns::Html && ascii_lower(anc.tag) == anc_tag) }) {
            hit = true
            break
          }
          p = anc.parent
        }
        if hit {
          out.push(c)
          if first {
            return true
          }
        }
      }
      if c.children.length() > 0 && query_walk_desc_class(c, left_is_cls, anc_cls, anc_mask, anc_tag, cls2, mask2, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_walk_checked(
  parent : html::Node,
  want_tag : String,
  cls : String,
  cls_mask : Int64,
  first : Bool,
  out : Array[html::Node],
) -> Bool {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      if (want_tag == "" || c.tag == want_tag || (c.ns != html::Ns::Html && ascii_lower(c.tag) == want_tag)) &&
      (cls == "" || c.has_class_masked(cls, cls_mask)) &&
      node_is_checked(c) {
        out.push(c)
        if first {
          return true
        }
      }
      if c.children.length() > 0 && query_walk_checked(c, want_tag, cls, cls_mask, first, out) {
        return true
      }
    }
    i = i + 1
  }
  false
}

fn query_fast_into(root : html::Node, sel : String, first : Bool, out : Array[html::Node]) -> Bool {
  // Fast paths for the hottest simple selectors (avoid CSS tokenize/parse & full selector matching)
  let sl = sel.length()
  if sl == 0 {
    return false
  }
  if sel == "base" && root.kind == html::Kind::Document {
    if no_base_docs.contains(root.uid) {
      return true
    }
    let from = root.content_node()
    let _ = query_walk_tag(from, "base", first, out)
    if out.length() == 0 {
      if no_base_docs.len() > 64 {
        no_base_docs.clear()
      }
      no_base_docs.set(root.uid, true)
    }
    return true
  }
  if sel == "body" && first && root.kind == html::Kind::Document {
    for c in root.children {
      if c.kind == html::Kind::Element && c.tag == "html" {
        for k in c.children {
          if k.kind == html::Kind::Element && k.tag == "body" {
            out.push(k)
            return true
          }
        }
      }
    }
  }
  if sel == "*" {
    let from = root.content_node()
    let _ = query_walk_all(from, first, out)
    return true
  }
  if is_simple_ident(sel, 0) {
    let want = ascii_lower(sel)
    let from = root.content_node()
    let _ = query_walk_tag(from, want, first, out)
    return true
  }
  if sl > 1 && sel.code_unit_at(0) == 35 && is_simple_ident(sel, 1) && !tree_root(root).is_quirks() {
    let id = sel.slice(1, sl)
    if first {
      match attr_index_lookup_one(pick_id_idx(root.uid), root, "id", "id", id, id_index_gen.v) {
        Some(n) => out.push(n)
        None => ()
      }
      return true
    }
    let from = root.content_node()
    query_walk_id(from, id, out)
    return true
  }
  if sl > 1 && sel.code_unit_at(0) == 46 && is_simple_ident(sel, 1) && !tree_root(root).is_quirks() {
    let cls = sel.slice(1, sl)
    let cls_mask = html::class_token_mask(cls)
    class_index_lookup(root, cls, cls_mask, first, out)
    return true
  }
  // Fast path for `[attr="val"]` and `tag[attr="val"]` (e.g. TodoMVC `[data-id="123"]`, `li[data-id="123"]`)
  if sl > 4 && sel.code_unit_at(sl - 1) == 93 {
    let mut lb = -1
    for i in 0..<sl {
      if sel.code_unit_at(i) == 91 {
        lb = i
        break
      }
    }
    if lb == 0 || (lb > 0 && is_simple_ident(sel.slice(0, lb), 0)) {
      let tag_want = if lb > 0 { ascii_lower(sel.slice(0, lb)) } else { "" }
      let mut eq = -1
      let mut simple_name = true
      for i in (lb + 1)..<(sl - 1) {
        let c = sel.code_unit_at(i)
        if c == 0x3D {
          eq = i
          break
        }
        if !((c >= 0x61 && c <= 0x7A) || (c >= 0x41 && c <= 0x5A) || (c >= 0x30 && c <= 0x39) || c == 0x2D || c == 0x5F) {
          simple_name = false
          break
        }
      }
      if simple_name && eq > lb + 1 && eq + 2 < sl - 1 {
        let q = sel.code_unit_at(eq + 1)
        let q2 = sel.code_unit_at(sl - 2)
        if (q == 0x22 || q == 0x27) && q == q2 {
          let mut has_esc = false
          for i in (eq + 2)..<(sl - 2) {
            let c = sel.code_unit_at(i)
            if c == 0x5C || c == q {
              has_esc = true
              break
            }
          }
          if !has_esc {
            let raw_name = sel.slice(lb + 1, eq)
            let attr_name = ascii_lower(raw_name)
            let attr_val = sel.slice(eq + 2, sl - 2)
            if first && raw_name == attr_name && attr_name != "class" && attr_name != "style" {
              let ver = if attr_name == "id" { id_index_gen.v } else { attr_index_gen.v }
              let idx = if attr_name == "id" { pick_id_idx(root.uid) } else { attr_idx }
              match attr_index_lookup_one(idx, root, attr_name, raw_name, attr_val, ver) {
                Some(n) => {
                  if tag_want == "" || n.tag == tag_want || (n.ns != html::Ns::Html && ascii_lower(n.tag) == tag_want) {
                    out.push(n)
                    return true
                  }
                  if !idx.has_dups {
                    return true
                  }
                }
                None => return true
              }
            }
            let from = root.content_node()
            let _ = query_walk_attr(from, tag_want, attr_name, raw_name, attr_val, first, out)
            return true
          }
        }
      }
    }
  }
  // Fast path for `:checked`, `tag.class`, 2-part descendant `tag .class` / `.cls1 .cls2`, and `tag:nth-child(k) .cls`
  let mut sp = -1
  let mut dot = -1
  let mut colon = -1
  let mut multi_sp = false
  for i in 0..<sl {
    let c = sel.code_unit_at(i)
    if c == 32 {
      if sp < 0 { sp = i } else { multi_sp = true; break }
    } else if c == 46 && dot < 0 && sp < 0 {
      dot = i
    } else if c == 58 && colon < 0 && sp < 0 {
      colon = i
    }
  }
  if !multi_sp && (sp > 0 || dot >= 0 || colon >= 0) && !tree_root(root).is_quirks() {
    if sp < 0 && colon >= 0 && sl - colon == 8 && sel.slice(colon, sl) == ":checked" {
      if colon == 0 {
        let from = root.content_node()
        let _ = query_walk_checked(from, "", "", 0L, first, out)
        return true
      }
      if dot < 0 {
        let tag_part = sel.slice(0, colon)
        if is_simple_ident(tag_part, 0) {
          let from = root.content_node()
          let _ = query_walk_checked(from, ascii_lower(tag_part), "", 0L, first, out)
          return true
        }
      } else if dot == 0 && colon > 1 {
        let cls = sel.slice(1, colon)
        if is_simple_ident(cls, 0) {
          let from = root.content_node()
          let _ = query_walk_checked(from, "", cls, html::class_token_mask(cls), first, out)
          return true
        }
      } else if dot > 0 && dot + 1 < colon {
        let tag_part = sel.slice(0, dot)
        let cls = sel.slice(dot + 1, colon)
        if is_simple_ident(tag_part, 0) && is_simple_ident(cls, 0) {
          let from = root.content_node()
          let _ = query_walk_checked(from, ascii_lower(tag_part), cls, html::class_token_mask(cls), first, out)
          return true
        }
      }
    }
    if sp > 0 && colon > 0 && colon < sp && sp + 2 < sl && sel.code_unit_at(sp + 1) == 46 && is_simple_ident(sel, sp + 2) {
      // Check `<tag>:nth-child(<k>) .<cls>` where `:nth-child(` is 11 bytes and ends with `)` at `sp - 1`
      if sp - colon > 12 && sel.code_unit_at(sp - 1) == 41 && sel.slice(colon, colon + 11) == ":nth-child(" {
        let tag_part = sel.slice(0, colon)
        if is_simple_ident(tag_part, 0) {
          let mut k = 0
          let mut digits_ok = true
          let mut di = colon + 11
          while di < sp - 1 {
            let ch = sel.code_unit_at(di)
            if ch < 0x30 || ch > 0x39 {
              digits_ok = false
              break
            }
            k = k * 10 + (ch - 0x30)
            di += 1
          }
          if digits_ok && k >= 1 {
            let want_tag = ascii_lower(tag_part)
            let cls = sel.slice(sp + 2, sl)
            let cls_mask = html::class_token_mask(cls)
            let from = root.content_node()
            let _ = query_walk_nth_child_class(from, want_tag, k, cls, cls_mask, first, out)
            return true
          }
        }
      }
    }
    if sp < 0 && colon < 0 && dot > 0 && dot + 1 < sl {
      let tag_part = sel.slice(0, dot)
      if is_simple_ident(tag_part, 0) && is_simple_ident(sel, dot + 1) {
        let want = ascii_lower(tag_part)
        let cls = sel.slice(dot + 1, sl)
        let cls_mask = html::class_token_mask(cls)
        let from = root.content_node()
        let _ = query_walk_tag_class(from, want, cls, cls_mask, first, out)
        return true
      }
    }
    if sp > 0 && sp + 2 < sl && sel.code_unit_at(sp + 1) == 46 && is_simple_ident(sel, sp + 2) {
      let left = sel.slice(0, sp)
      let left_is_cls = left.length() > 1 && left.code_unit_at(0) == 46 && is_simple_ident(left, 1)
      let left_is_tag = !left_is_cls && is_simple_ident(left, 0)
      if left_is_cls || left_is_tag {
        let cls2 = sel.slice(sp + 2, sl)
        let mask2 = html::class_token_mask(cls2)
        let anc_cls = if left_is_cls { left.slice(1, left.length()) } else { "" }
        let anc_mask = if left_is_cls { html::class_token_mask(anc_cls) } else { 0L }
        let anc_tag = if left_is_tag { ascii_lower(left) } else { "" }
        let from = root.content_node()
        let _ = query_walk_desc_class(from, left_is_cls, anc_cls, anc_mask, anc_tag, cls2, mask2, first, out)
        return true
      }
    }
  }
  false
}

fn query_fast(root : html::Node, sel : String, first : Bool) -> Option[Array[html::Node]] {
  let out : Array[html::Node] = []
  if query_fast_into(root, sel, first, out) {
    Some(out)
  } else {
    None
  }
}

///|
fn query(root : html::Node, sel : String, first : Bool) -> Array[html::Node] {
  match query_fast(root, sel, first) {
    Some(r) => return r
    None => ()
  }
  let list = selectors_of(sel)
  let out : Array[html::Node] = []
  let stack : Array[html::Node] = []
  let from = root.content_node()
  for i = from.children.length() - 1; i >= 0; i = i - 1 {
    let c = from.children[i]
    if c.kind == html::Kind::Element {
      stack.push(c)
    }
  }
  while stack.pop() is Some(n) {
    // (a selector with a pseudo-element matches no element)
    for s in list {
      if s.pseudo_element == "" && css::selector_matches(s, n) {
        out.push(n)
        if first {
          return out
        }
        break
      }
    }
    for i = n.children.length() - 1; i >= 0; i = i - 1 {
      let c = n.children[i]
      if c.kind == html::Kind::Element {
        stack.push(c)
      }
    }
  }
  if sel == "base" && root.kind == html::Kind::Document && out.length() == 0 {
    if no_base_docs.len() > 64 {
      no_base_docs.clear()
    }
    no_base_docs.set(root.uid, true)
  }
  out
}

///|
/// The selector lists scripts asked of the tree, parsed (see `selectors_of`).
let parsed_selectors : Map[String, Array[css::Selector]] = Map::new()

///|
/// A selector list's text parsed, once for each text (as Blink's selector query cache): pages ask the same few
/// selectors thousands of times, of querySelector, matches and closest alike. Empty when the text is not one.
fn selectors_of(sel : String) -> Array[css::Selector] {
  match parsed_selectors.get(sel) {
    Some(l) => l
    None => {
      let l = css::parse_selector_list(css::tokenize(sel))
      if parsed_selectors.length() > 4096 {
        parsed_selectors.clear()
      }
      parsed_selectors.set(sel, l)
      l
    }
  }
}

///|
fn by_id(root : html::Node, id : String) -> Array[html::Node] {
  let stack = [root]
  while stack.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.attr("id").unwrap_or("") == id && n.attr("id").is_some() {
      return [n]
    }
    for i = n.children.length() - 1; i >= 0; i = i - 1 {
      stack.push(n.children[i])
    }
  }
  []
}

///|
/// What a point of an inline <svg> hits: the shape there (by its geometry and pointer-events), else the <svg>.
fn svg_target(_root : layout::Box, n : html::Node, _x : Double, _y : Double) -> html::Node {
  n
}

///|
/// The element's color as computed (what currentcolor is).
fn computed_color_text(s : css::Style) -> String {
  match css::parse_col(s.get("color")) {
    Some(c) if c.space != "currentcolor" => css::col_text(c)
    _ =>
    match s.color("color") {
      Some(c) if c.a >= 1.0 => "rgb(\{c.r}, \{c.g}, \{c.b})"
      Some(c) => "rgba(\{c.r}, \{c.g}, \{c.b}, \{c.a})"
      None => "rgb(0, 0, 0)"
    }
  }
}

///|
fn computed(n : html::Node, prop : String, pseudo~ : String = "") -> String {
  ensure_style()
  let chain : Array[html::Node] = []
  let mut p : Option[html::Node] = Some(n)
  let mut top = n
  while p is Some(x) {
    if x.kind == html::Kind::Element {
      chain.push(x)
    }
    top = x
    p = x.parent
  }
  // an element inside a shadow tree is styled by its shadow root's own sheets (style elements + adoptedStyleSheets)
  let in_shadow = top.kind == html::Kind::Fragment && top.has_host()
  // an element of another document (a frame's) is styled by that document's sheets
  let other = top.kind == html::Kind::Document && !((top).uid == (st.doc).uid)
  // (a frame's: its own engine, kept with what it matched, as the page's is; a frame's script reading a style (jQuery
  // asks each element's display as it shows and hides it) made an engine and read every sheet again for each)
  let framed = if other { frame_engine(top) } else { None }
  let kept = (!other && !in_shadow) || framed is Some(_)
  let e = if in_shadow {
    let se = css::Engine::new({ width: st.w, height: st.h, media: st.media, dpr: css::media_dpr() })
    add_sheets(top, se)
    if top.data != "" {
      se.set_order(adopted_base)
      se.add_sheet_resolve(top.data, fn(u) { fetch::resolve(st.url, u) })
    }
    se
  } else if framed is Some(fe) {
    fe
  } else if other {
    let e = css::Engine::new({ width: st.w, height: st.h, media: st.media, dpr: css::media_dpr() })
    if top.is_quirks() {
      e.add_ua_sheet(css::quirks_css())
    }
    e.set_quirks(top.is_quirks())
    add_sheets(top, e)
    e
  } else {
    match st.engine {
      Some(e) => e
      None => return ""
    }
  }
  // computed styles are kept for the layout they were computed in, each from its parent's
  let mut style : Option[css::Style] = None
  let mut from = chain.length() - 1
  for i in 0..<chain.length() {
    if !kept {
      break
    }
    match intmap::get(st.styles, id_of(chain[i])) {
      Some(s) => {
        style = Some(s)
        from = i - 1
        break
      }
      None => ()
    }
  }
  for i = from; i >= 0; i = i - 1 {
    let cur_el = chain[i]
    style = match cur_el.get_shadow() {
      Some(sr) => {
        let se = css::Engine::new({ width: st.w, height: st.h, media: st.media, dpr: css::media_dpr() })
        add_sheets(sr, se)
        if sr.data != "" {
          se.set_order(adopted_base)
          se.add_sheet_resolve(sr.data, fn(u) { fetch::resolve(st.url, u) })
        }
        e.style_of_full(cur_el, style, "", Some(se), None)
      }
      None => e.style_of(cur_el, style)
    }
    match style {
      Some(s) if kept => st.styles.set(id_of(cur_el), s)
      _ => ()
    }
  }
  // a pseudo-element's style (getComputedStyle(e, "::before")), from the element's: as its rules say, unanimated
  // (Proton reads its layout breakpoint from body::before's content, a box it never shows)
  if pseudo != "" {
    return match style {
      Some(s) =>
      match e.style_of_full(n, Some(s), pseudo, None, None) {
        Some(ps) => value_text(ps, prop)
        None => ""
      }
      None => ""
    }
  }
  // (a script reading the style is a style change event: transitions it starts start now)
  match style {
    Some(s) if !other && rendered(s) && in_any_document(n) => {
      // (a style change is the whole document's: the ancestors' changes start their transitions first, so a child
      // that inherits a value in transition follows it rather than starting its own)
      let up : Array[(html::Node, css::Style)] = []
      let mut node = n.parent
      let mut ps = s.parent_style()
      while node is Some(a) && a.kind == html::Kind::Element && ps is Some(pst) {
        up.push((a, pst))
        node = a.parent
        ps = pst.parent_style()
      }
      for i = up.length() - 1; i >= 0; i = i - 1 {
        detect_element(up[i].0, up[i].1)
      }
      detect_element(n, s, asked=prop)
    }
    Some(_) if !other => not_rendered(n)
    _ => ()
  }
  match style {
    // a custom property reads as its value, its var()s substituted (Apple's modal reads its scrim colour so)
    // (one being animated, or registered with @property, reads as it did: as the animation or its syntax has it)
    Some(s) if prop.starts_with("--") => {
      let av = animated(n, s, prop, value_text(s, prop))
      if av == "" {
        match s.vars.get(prop) {
          Some(v) => css::serialize_value(v).trim()
          None => ""
        }
      } else {
        av
      }
    }
    // a transform reads as its matrix (CSSOM's resolved value), percentages of the box's size
    Some(s) if prop == "transform" => {
      let (w, h) = if other {
        (0.0, 0.0)
      } else {
        match root_for(n) {
          Some(root) =>
          match layout::box_of(root, n) {
            Some(b) => (b.w, b.h)
            None => (0.0, 0.0)
          }
          None => (0.0, 0.0)
        }
      }
      transform_box.v = (w, h, Some(s))
      let shown = animated(n, s, prop, value_text(s, prop))
      transform_box.v = (0.0, 0.0, None)
      css::transform_text(s.transform_args_resolved(css::tokenize(shown)), w, h, fn(t) { s.length_of(t) })
    }
    Some(s) => {
      let pos_w = s.word("position")
      let is_inset = prop == "top" || prop == "bottom" || prop == "left" || prop == "right"
      let is_pos = pos_w == "relative" || pos_w == "absolute" || pos_w == "fixed" || pos_w == "sticky"
      let is_box_prop = prop == "width" || prop == "height" || prop == "padding-top" || prop == "padding-right" || prop == "padding-bottom" || prop == "padding-left" || prop == "margin-top" || prop == "margin-right" || prop == "margin-bottom" || prop == "margin-left" || prop == "grid-template-columns" || prop == "grid-template-rows"
      if is_inset && is_pos && !other && resolved_inset(n, s, prop, false).is_some() {
        let given = value_text(s, prop)
        let shown = animated(n, s, prop, given)
        if shown == given {
          resolved_inset(n, s, prop, false).unwrap_or(shown)
        } else if shown == "auto" {
          resolved_inset(n, s, prop, true).unwrap_or("auto")
        } else {
          shown
        }
      } else if is_inset && is_pos && has_percentage_tok(s.get(prop)) {
        match (root_for(n), n.parent) {
          (Some(root), Some(p)) =>
          match (layout::scroll_sizes(root, p), s.length(prop)) {
            (Some((cw, ch, _, _)), Some(l)) => {
              let base = if prop == "top" || prop == "bottom" { ch } else { cw }
              css::serialize_value([css::Tok::Dimension(l.px + l.pct * base / 100.0, "px")])
            }
            _ => value_text(s, prop)
          }
          _ => value_text(s, prop)
        }
      } else if is_box_prop && kept {
        let given = value_text(s, prop)
        let shown = animated(n, s, prop, given)
        if shown != given && shown != "auto" {
          shown
        } else {
          match resolved(n, s, prop) {
            Some(v) => v
            None => shown
          }
        }
      } else {
        animated(n, s, prop, value_text(s, prop))
      }
    }
    None => ""
  }
}

///|
/// A positioned box's used inset (top, right, bottom, left) as getComputedStyle gives it (CSSOM §9): an absolutely
/// positioned one's from where it was placed in its containing block; a relatively positioned one's from its insets,
/// percentages against its containing block, auto the opposite inset negated.
fn resolved_inset(n : html::Node, s : css::Style, prop : String, auto : Bool) -> Option[String] {
  guard root_for(n) is Some(root) else { return None }
  guard layout::box_of(root, n) is Some(b) else { return None }
  let px = fn(v : Double) { css::serialize_value([css::Tok::Dimension(v, "px")]) }
  let pos = s.word("position")
  if pos == "relative" || pos == "sticky" {
    // (the containing block: the parent's content box)
    let (cw, ch) = match n.parent {
      Some(p) =>
      match layout::box_of(root, p) {
        Some(pb) => (pb.w - pb.bl - pb.br - pb.pl - pb.pr, pb.h - pb.bt - pb.bb - pb.pt - pb.pb)
        None => (st.w, st.h)
      }
      None => (st.w, st.h)
    }
    let vertical = prop == "top" || prop == "bottom"
    let base = if vertical { ch } else { cw }
    let opposite = match prop {
      "top" => "bottom"
      "bottom" => "top"
      "left" => "right"
      _ => "left"
    }
    let used_prop = if auto { None } else {
      match s.length_against(prop, Some(base)) {
        Some(l) => Some(l.px + l.pct * base / 100.0)
        None => None
      }
    }
    let used_opp = match s.length_against(opposite, Some(base)) {
      Some(l) => Some(l.px + l.pct * base / 100.0)
      None => None
    }
    // (a sticky box's auto inset stays auto: it is not offset from that side)
    if pos == "sticky" && (auto || used_prop is None) {
      return Some("auto")
    }
    let res_px = match used_prop {
      Some(v) => v
      None =>
      match used_opp {
        Some(o) => -o
        None => 0.0
      }
    }
    return Some(px(res_px))
  }
  // the containing block's padding box: the nearest positioned ancestor's, else the viewport
  let mut cb : (Double, Double, Double, Double) = (0.0, 0.0, st.w, st.h)
  // an absolutely positioned box's: the nearest positioned ancestor's; a fixed one's: the viewport, unless an
  // ancestor's transform, perspective, filter or containment makes one (CSS Transforms §2)
  let set = fn(a : css::Style, p : String) -> Bool {
    let ts = a.get(p)
    if ts.length() == 0 {
      return false
    }
    if ts.length() == 1 {
      match ts[0] {
        css::Tok::Ident(w) if w == "none" => return false
        _ => ()
      }
    }
    true
  }
  let fixed_cb = fn(a : css::Style) {
    set(a, "transform") || set(a, "perspective") || set(a, "filter") || set(a, "translate") || set(a, "rotate") ||
    set(a, "scale") || (a.word("contain") == "paint" || a.word("contain") == "layout" || a.word("contain") == "strict" || a.word("contain") == "content") ||
    (a.word("will-change") == "transform" || a.word("will-change") == "perspective" || a.word("will-change") == "filter")
  }
  let makes_cb = fn(a : css::Style) {
    if pos == "fixed" {
      fixed_cb(a)
    } else {
      (a.word("position") != "" && a.word("position") != "static") || fixed_cb(a)
    }
  }
  if pos == "absolute" || pos == "fixed" {
    let mut p = n.parent
    while p is Some(a) {
      if a.kind == html::Kind::Element {
        match layout::box_of(root, a) {
          Some(ab) if makes_cb(ab.style) => {
            cb = (ab.x + ab.bl, ab.y + ab.bt, ab.w - ab.bl - ab.br, ab.h - ab.bt - ab.bb)
            break
          }
          _ => ()
        }
      }
      p = a.parent
    }
  }
  let (cx, cy, cw, ch) = cb
  // an inset that is not auto: its computed value with percentages of the containing block, as written even when
  // the box is overconstrained
  let prop_toks = s.get(prop)
  let is_empty_or_ident = prop_toks.length() == 0 || (prop_toks.length() == 1 && (match prop_toks[0] { css::Tok::Ident(_) => true; _ => false }))
  if !auto && !is_empty_or_ident {
    let base = if prop == "top" || prop == "bottom" { ch } else { cw }
    match s.length_against(prop, Some(base)) {
      Some(l) => return Some(px(l.px + l.pct * base / 100.0))
      None => ()
    }
  }
  Some(
    px(
      match prop {
        "top" => b.y - b.mt - cy
        "left" => b.x - b.ml - cx
        "bottom" => cy + ch - (b.y + b.h + b.mb)
        _ => cx + cw - (b.x + b.w + b.mr)
      },
    ),
  )
}

///|
/// A grid template's line names by line (0-based, a repeat() with a count written out); none for a template that
/// repeats to fill, whose lines are only known in layout.
fn line_names(v : Array[css::Tok]) -> Array[Array[String]] {
  let out : Array[Array[String]] = [[]]
  let add = fn(ws : Array[Array[css::Tok]], out : Array[Array[String]]) -> Bool {
    for w in ws {
      if w.length() == 0 {
        ()
      } else {
        match w[0] {
          css::Tok::OpenSquare => {
            let mut k = 1
            while k < w.length() {
              match w[k] {
                css::Tok::Ident(n) => out[out.length() - 1].push(n)
                _ => ()
              }
              k = k + 1
            }
          }
          _ => out.push([])
        }
      }
    }
    true
  }
  for w in css::words(v) {
    let mut handled = false
    if w.length() >= 2 {
      match w[0] {
        css::Tok::Function(f) if ascii_lower(f) == "repeat" => {
          handled = true
          let inner : Array[css::Tok] = []
          let mut j = 1
          while j < w.length() - 1 {
            inner.push(w[j])
            j = j + 1
          }
          let mut comma = -1
          j = 0
          while j < inner.length() {
            match inner[j] {
              css::Tok::Comma => {
                comma = j
                break
              }
              _ => ()
            }
            j = j + 1
          }
          if comma < 0 {
            return []
          }
          let lhs : Array[css::Tok] = []
          j = 0
          while j < comma {
            match inner[j] {
              css::Tok::Space => ()
              _ => lhs.push(inner[j])
            }
            j = j + 1
          }
          if lhs.length() != 1 {
            return []
          }
          let rep_n = match lhs[0] {
            css::Tok::Number(n) => n.to_int()
            _ => return []
          }
          let rhs : Array[css::Tok] = []
          j = comma + 1
          while j < inner.length() {
            rhs.push(inner[j])
            j = j + 1
          }
          let body = css::words(rhs)
          for _ in 0..<rep_n {
            ignore(add(body, out))
          }
        }
        _ => ()
      }
    }
    if !handled {
      ignore(add([w], out))
    }
  }
  let mut all_empty = true
  for a in out {
    if a.length() > 0 {
      all_empty = false
      break
    }
  }
  if all_empty {
    []
  } else {
    out
  }
}

///|
/// A laid-out box's used value for a property, as getComputedStyle gives it; None where the specified one stands
/// (no box, an inline box's width or height, a grid property of what is no grid).
fn resolved(n : html::Node, s : css::Style, prop : String) -> Option[String] {
  guard root_for(n) is Some(root) else { return None }
  guard layout::box_of(root, n) is Some(b) else { return None }
  let is_inline_like = match b.kind {
    layout::Kind::Inline => true
    layout::Kind::TextRun(_) => true
    layout::Kind::Break => true
    _ => false
  }
  if is_inline_like {
    return None
  }
  let px = fn(v : Double) -> String { css::serialize_value([css::Tok::Dimension(v, "px")]) }
  let border_box = s.word("box-sizing") == "border-box"
  match prop {
    "width" => Some(px(if border_box { b.w } else { b.w - b.pl - b.pr - b.bl - b.br }))
    "height" => Some(px(if border_box { b.h } else { b.h - b.pt - b.pb - b.bt - b.bb }))
    "padding-top" => Some(px(b.pt))
    "padding-right" => Some(px(b.pr))
    "padding-bottom" => Some(px(b.pb))
    "padding-left" => Some(px(b.pl))
    "margin-top" => Some(px(b.mt))
    "margin-right" => Some(px(b.mr))
    "margin-bottom" => Some(px(b.mb))
    "margin-left" => Some(px(b.ml))
    "grid-template-columns" => resolved_grid(b, s, prop, true, px)
    "grid-template-rows" => resolved_grid(b, s, prop, false, px)
    _ => None
  }
}

fn resolved_grid(b : layout::Box, s : css::Style, prop : String, is_col : Bool, px : (Double) -> String) -> Option[String] {
  match b.tracks {
    Some((cols, rows)) => {
      let list = if is_col { cols } else { rows }
      let raw_spec = s.get(prop)
      let spec : Array[css::Tok] = []
      for t in raw_spec {
        match t {
          css::Tok::Space => ()
          _ => spec.push(t)
        }
      }
      let mut no_items = true
      for c in b.children {
        let ok = match c.kind {
          layout::Kind::TextRun(_) => true
          _ => layout::out_of_flow(c.style)
        }
        if !ok {
          no_items = false
          break
        }
      }
      let spec_none = spec.length() == 0 || (spec.length() == 1 && (match spec[0] { css::Tok::Ident(w) if w == "none" => true; _ => false }))
      if list.length() == 0 || (spec_none && no_items) {
        None
      } else {
        let names = line_names(s.get(prop))
        let parts : Array[String] = []
        for i, t in list {
          if i < names.length() && names[i].length() > 0 {
            parts.push("[" + names[i].join(" ") + "]")
          }
          parts.push(px(t))
        }
        if list.length() < names.length() && names[list.length()].length() > 0 {
          parts.push("[" + names[list.length()].join(" ") + "]")
        }
        Some(parts.join(" "))
      }
    }
    None => None
  }
}

///|
/// A property's computed value as getComputedStyle writes it, for a style.
fn value_text(s : css::Style, prop : String) -> String {
  // shorthands: their longhands' values put together
  match prop {
    "flex" => return value_text(s, "flex-grow") + " " + value_text(s, "flex-shrink") + " " + value_text(s, "flex-basis")
    "flex-flow" => return value_text(s, "flex-direction") + " " + value_text(s, "flex-wrap")
    "gap" => {
      let r = value_text(s, "row-gap")
      let c = value_text(s, "column-gap")
      return if r == c { r } else { r + " " + c }
    }
    _ => ()
  }
  if prop == "border-top-width" || prop == "border-right-width" || prop == "border-bottom-width" || prop == "border-left-width" || prop == "outline-width" {
    let side_style = prop.slice(0, prop.length() - 6) + "-style"
    if s.word(side_style) == "" || s.word(side_style) == "none" || s.word(side_style) == "hidden" {
      return "0px"
    }
    let v = s.get(prop)
    if v.length() == 0 {
      return "3px"
    }
    if v.length() == 1 {
      match v[0] {
        css::Tok::Ident(w) if ascii_lower(w) == "thin" => return "1px"
        css::Tok::Ident(w) if ascii_lower(w) == "thick" => return "5px"
        css::Tok::Ident(_) => return "3px"
        _ => ()
      }
    }
    return match s.length_of(v) {
      Some(l) => css::serialize_value([css::Tok::Dimension(l.px, "px")])
      None => "3px"
    }
  }
  if prop == "background-image" || prop == "list-style-image" || prop == "border-image-source" || prop == "mask-image" {
    let v = s.get(prop)
    if v.length() == 0 {
      return "none"
    }
    return css::image_list_text(
      v,
      Some(fn(w : Array[css::Tok]) -> Option[Double] {
        match s.length_of(w) {
          Some(l) if l.pct == 0.0 => Some(l.px)
          _ => None
        }
      }),
    ).unwrap_or(css::serialize_value(v))
  }
  if prop == "box-shadow" || prop == "text-shadow" {
    return shadow_value_text(s, prop)
  }
  if prop == "fill" || prop == "stroke" || prop == "stop-color" || prop == "flood-color" || prop == "lighting-color" {
    let v = s.get(prop)
    if v.length() == 0 {
      return if prop == "fill" {
        "rgb(0, 0, 0)"
      } else if prop == "stroke" {
        "none"
      } else if prop == "lighting-color" {
        "rgb(255, 255, 255)"
      } else {
        "rgb(0, 0, 0)"
      }
    }
    return match css::parse_col(v) {
      Some(c) if c.space != "currentcolor" => css::col_text(c)
      Some(_) => computed_color_text(s)
      None => css::serialize_value(v)
    }
  }
  if prop == "color" || prop == "background-color" {
    return match css::parse_col(s.get(prop)) {
      Some(c) if c.space != "currentcolor" => css::col_text(c)
      _ =>
      match s.color(prop) {
        Some(c) if c.a >= 1.0 => "rgb(\{c.r}, \{c.g}, \{c.b})"
        Some(c) => "rgba(\{c.r}, \{c.g}, \{c.b}, \{c.a})"
        None => if prop == "color" { "rgb(0, 0, 0)" } else { "rgba(0, 0, 0, 0)" }
      }
    }
  }
  match prop {
    "font-size" => "\{s.font_size}px"
    "display" => {
      let v = s.get("display")
      let d = match ascii_lower(css::serialize_value(v)) {
        "" => "inline"
        "math" => "inline"
        d => d
      }
      let out_of_flow = (s.word("position") == "absolute" || s.word("position") == "fixed") ||
      (s.word("float") != "" && s.word("float") != "none")
      if out_of_flow {
        match d {
          "inline" => "block"
          "inline-block" => "block"
          "run-in" => "block"
          "inline-flex" => "flex"
          "inline-grid" => "grid"
          "inline-table" => "table"
          "inline list-item" => "list-item"
          "inline flow-root list-item" => "flow-root list-item"
          "inline grid-lanes" => "grid-lanes"
          "inline-grid-lanes" => "grid-lanes"
          d if d.starts_with("table-") || d.starts_with("ruby") => "block"
          d => d
        }
      } else {
        d
      }
    }
    _ => {
      let v = s.get(prop)
      let is_simple_tok = if v.length() == 0 {
        false
      } else {
        match v[0] {
          css::Tok::Ident(_) => true
          css::Tok::Number(_) if v.length() == 1 => true
          css::Tok::Percentage(_) if v.length() == 1 => true
          _ => false
        }
      }
      let text = if v.length() == 0 {
        ""
      } else if is_simple_tok {
        css::serialize_value(v)
      } else if arr_has_str(length_props, prop) {
        match s.length_of(v) {
          Some(l) if l.pct == 0.0 && l.px < 0.0 && !(prop.starts_with("margin") || (prop == "top" || prop == "right" || prop == "bottom" || prop == "left" || prop == "text-indent" || prop == "letter-spacing" || prop == "word-spacing")) =>
          "0px"
          Some(l) if l.pct == 0.0 => css::serialize_value([css::Tok::Dimension(l.px, "px")])
          Some(l) if l.px == 0.0 => css::serialize_value([css::Tok::Percentage(l.pct)])
          Some(l) =>
          "calc(" + css::serialize_value([css::Tok::Percentage(l.pct)]) + " + " +
          css::serialize_value([css::Tok::Dimension(l.px, "px")]) + ")"
          None => css::serialize_value(v)
        }
      } else {
        css::serialize_value(v)
      }
      if text == "" {
        initial_value(prop)
      } else {
        text
      }
    }
  }
}

fn arr_has_str(xs : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < xs.length() {
    if xs[i] == target {
      return true
    }
    i += 1
  }
  false
}

fn arr_has_int(xs : Array[Int], target : Int) -> Bool {
  let mut i = 0
  while i < xs.length() {
    if xs[i] == target {
      return true
    }
    i += 1
  }
  false
}

///|
/// Properties whose computed value is a length (or percentage).
let length_props : Array[String] = [
  "width", "height", "min-width", "min-height", "max-width", "max-height", "top", "right", "bottom", "left",
  "margin-top", "margin-right", "margin-bottom", "margin-left", "padding-top", "padding-right", "padding-bottom",
  "padding-left", "flex-basis", "row-gap", "column-gap", "text-indent", "letter-spacing", "word-spacing",
  "border-top-width", "border-right-width", "border-bottom-width", "border-left-width", "outline-width",
  "inset-block-start", "inset-inline-start",
]

let initial_value_cache : Map[String, String] = Map::new()

fn ensure_initial_value_cache() -> Unit {
  if initial_value_cache.length() > 0 {
    return
  }
  let pairs : Array[(String, String)] = [
    ("visibility", "visible"), ("position", "static"), ("float", "none"), ("clear", "none"),
    ("overflow", "visible"), ("overflow-x", "visible"), ("overflow-y", "visible"), ("opacity", "1"),
    ("z-index", "auto"), ("width", "auto"), ("height", "auto"), ("top", "auto"), ("left", "auto"),
    ("right", "auto"), ("bottom", "auto"), ("margin-top", "0px"), ("margin-right", "0px"),
    ("margin-bottom", "0px"), ("margin-left", "0px"), ("padding-top", "0px"), ("padding-right", "0px"),
    ("padding-bottom", "0px"), ("padding-left", "0px"), ("border-top-width", "0px"),
    ("border-right-width", "0px"), ("border-bottom-width", "0px"), ("border-left-width", "0px"),
    ("border-top-style", "none"), ("border-right-style", "none"), ("border-bottom-style", "none"),
    ("border-left-style", "none"), ("text-align", "start"), ("white-space", "normal"),
    ("font-style", "normal"), ("font-weight", "400"), ("text-decoration-line", "none"),
    ("box-sizing", "content-box"), ("flex-direction", "row"), ("flex-wrap", "nowrap"),
    ("justify-content", "normal"), ("align-items", "normal"), ("align-content", "normal"),
    ("row-gap", "normal"), ("column-gap", "normal"), ("align-self", "auto"), ("justify-self", "auto"),
    ("flex-grow", "0"), ("flex-shrink", "1"), ("flex-basis", "auto"), ("order", "0"),
    ("direction", "ltr"), ("writing-mode", "horizontal-tb"), ("content-visibility", "visible"),
    ("pointer-events", "auto"), ("cursor", "auto"), ("transform", "none"),
    ("grid-row-start", "auto"), ("grid-row-end", "auto"), ("grid-column-start", "auto"),
    ("grid-column-end", "auto"), ("grid-auto-columns", "auto"), ("grid-auto-rows", "auto"),
    ("min-width", "auto"), ("min-height", "auto"), ("aspect-ratio", "auto"), ("column-count", "auto"),
    ("column-width", "auto"), ("will-change", "auto"), ("user-select", "auto"), ("touch-action", "auto"),
    ("scroll-behavior", "auto"), ("overscroll-behavior", "auto"), ("image-rendering", "auto"),
    ("isolation", "auto"), ("table-layout", "auto"), ("quotes", "auto"), ("page-break-before", "auto"),
    ("page-break-after", "auto"), ("break-before", "auto"), ("break-after", "auto"), ("inset", "auto"),
    ("grid-template-columns", "none"), ("grid-template-rows", "none"), ("grid-template-areas", "none"),
    ("max-width", "none"), ("max-height", "none"), ("background-image", "none"),
    ("border-image-source", "none"), ("box-shadow", "none"), ("text-shadow", "none"),
    ("text-transform", "none"), ("list-style-image", "none"), ("animation-name", "none"),
    ("animation-fill-mode", "none"), ("filter", "none"), ("backdrop-filter", "none"),
    ("clip-path", "none"), ("mask-image", "none"), ("outline-style", "none"), ("resize", "none"),
    ("contain", "none"), ("counter-reset", "none"), ("counter-increment", "none"),
    ("perspective", "none"), ("translate", "none"), ("rotate", "none"), ("scale", "none"),
    ("appearance", "none"), ("container-type", "none"), ("grid-auto-flow", "row"),
    ("justify-items", "normal"), ("letter-spacing", "normal"), ("line-height", "normal"),
    ("font-variant", "normal"), ("overflow-wrap", "normal"), ("word-break", "normal"),
    ("unicode-bidi", "normal"), ("mix-blend-mode", "normal"), ("animation-direction", "normal"),
    ("font-kerning", "normal"), ("content", "normal"), ("font-feature-settings", "normal"),
    ("font-variation-settings", "normal"), ("line-break", "normal"),
    ("transition-duration", "0s"), ("transition-delay", "0s"), ("animation-duration", "0s"),
    ("animation-delay", "0s"), ("transition-property", "all"), ("transition-timing-function", "ease"),
    ("animation-timing-function", "ease"), ("transition-behavior", "normal"),
    ("animation-iteration-count", "1"), ("zoom", "1"), ("animation-play-state", "running"),
    ("background-repeat", "repeat"), ("background-position", "0% 0%"), ("object-position", "50% 50%"),
    ("background-size", "auto"), ("background-attachment", "scroll"), ("background-clip", "border-box"),
    ("background-origin", "padding-box"), ("border-top-left-radius", "0px"),
    ("border-top-right-radius", "0px"), ("border-bottom-right-radius", "0px"),
    ("border-bottom-left-radius", "0px"), ("outline-width", "0px"), ("outline-offset", "0px"),
    ("word-spacing", "0px"), ("text-indent", "0px"), ("text-overflow", "clip"),
    ("vertical-align", "baseline"), ("list-style-type", "disc"), ("list-style-position", "outside"),
    ("border-collapse", "separate"), ("border-spacing", "0px 0px"), ("caption-side", "top"),
    ("empty-cells", "show"), ("object-fit", "fill"), ("hyphens", "manual"), ("tab-size", "8"),
    ("font-stretch", "100%"), ("text-decoration-style", "solid"), ("backface-visibility", "visible"),
    ("transform-style", "flat"),
  ]
  for pair in pairs {
    initial_value_cache.set(pair.0, pair.1)
  }
}

///|
/// A property's initial value as getComputedStyle gives it, for those a page reads most.
fn initial_value(prop : String) -> String {
  ensure_initial_value_cache()
  initial_value_cache.get(prop).unwrap_or("")
}

///|
/// Web Storage's items by origin, local and session, kept for as long as the host runs.
let storages : Map[String, Map[String, String]] = Map::new()

///|
/// Whether localStorage changed since it was last dumped.
let storage_changed : Ref[Bool] = Ref::{ v: false }

///|
/// localStorage as the host keeps it on disk, if it changed since last asked: a JSON object of origins, each an
/// object of its items.
pub fn storage_dump() -> Option[String] {
  if !storage_changed.v {
    return None
  }
  storage_changed.v = false
  let b = StringBuilder::new()
  b.write_char('{')
  let mut first = true
  let sks = storages.keys()
  for key in sks {
    if !key.starts_with("local ") {
      continue
    }
    match storages.get(key) {
      Some(m) => {
        if !first {
          b.write_char(',')
        }
        first = false
        b.write_string(json_string(key.slice(6, key.length())))
        b.write_string(":{")
        let mut f2 = true
        let mks = m.keys()
        for k in mks {
          match m.get(k) {
            Some(v) => {
              if !f2 {
                b.write_char(',')
              }
              f2 = false
              b.write_string(json_string(k) + ":" + json_string(v))
            }
            None => ()
          }
        }
        b.write_char('}')
      }
      None => ()
    }
  }
  b.write_char('}')
  Some(b.to_string())
}

///|
/// localStorage as `storage_dump` wrote it, taken back (a host started again keeps what pages stored).
pub fn storage_load(text : String) -> Unit {
  let origins = parse_storage_json(text)
  let oks = origins.keys()
  for origin in oks {
    match origins.get(origin) {
      Some(kv) => {
        let m = storage_of(0, origin)
        let ks = kv.keys()
        for k in ks {
          match kv.get(k) {
            Some(s) => m.set(k, s)
            None => ()
          }
        }
      }
      None => ()
    }
  }
}

///|
fn storage_of(kind : Int, origin : String) -> Map[String, String] {
  let key = (if kind == 0 { "local " } else { "session " }) + origin
  match storages.get(key) {
    Some(m) => m
    None => {
      let m : Map[String, String] = Map::new()
      storages.set(key, m)
      m
    }
  }
}

///|
/// A string as a JSON string.
fn json_string(v : String) -> String {
  let b = StringBuilder::new()
  b.write_char('"')
  let bs = v.to_bytes()
  let hex = "0123456789abcdef".to_bytes()
  let mut i = 0
  while i < bs.length() {
    let ch = bs[i].to_int() & 0xFF
    if ch == 34 {
      b.write_string("\\\"")
    } else if ch == 92 {
      b.write_string("\\\\")
    } else if ch == 10 {
      b.write_string("\\n")
    } else if ch == 13 {
      b.write_string("\\r")
    } else if ch == 9 {
      b.write_string("\\t")
    } else if ch < 32 {
      b.write_string("\\u00")
      b.write_byte(hex[ch >> 4])
      b.write_byte(hex[ch & 15])
    } else {
      b.write_byte(bs[i])
    }
    i = i + 1
  }
  b.write_char('"')
  b.to_string()
}

///|
/// The page's encoding as its label said it (the HTTP charset, a byte order mark, a <meta>), and as iconv names it
/// ("" for UTF-8).
let doc_label : Ref[String] = Ref::{ v: "" }

///|
let doc_iconv : Ref[String] = Ref::{ v: "" }

///|
/// Previous document URL for `document.referrer` on navigation.
let nav_referrer : Ref[String] = Ref::{ v: "" }

///|
/// An encoding label (WHATWG Encoding's) as iconv names the encoding; "" for UTF-8 and what is not known.
fn iconv_name(label : String) -> String {
  let l = ascii_lower(label.trim())
  match l {
    "utf-8" => ""
    "utf8" => ""
    "unicode-1-1-utf-8" => ""
    "unicode11utf8" => ""
    "unicode20utf8" => ""
    "x-unicode20utf8" => ""
    "gbk" | "gb2312" | "gb_2312" | "gb_2312-80" | "chinese" | "csgb2312" | "csiso58gb231280" | "iso-ir-58" |
    "x-gbk" => "GB18030"
    "gb18030" => "GB18030"
    "big5" => "BIG5-HKSCS"
    "big5-hkscs" => "BIG5-HKSCS"
    "cn-big5" => "BIG5-HKSCS"
    "csbig5" => "BIG5-HKSCS"
    "x-x-big5" => "BIG5-HKSCS"
    "shift_jis" => "CP932"
    "shift-jis" => "CP932"
    "sjis" => "CP932"
    "ms_kanji" => "CP932"
    "windows-31j" => "CP932"
    "x-sjis" => "CP932"
    "csshiftjis" => "CP932"
    "ms932" => "CP932"
    "euc-jp" => "EUC-JP"
    "x-euc-jp" => "EUC-JP"
    "cseucpkdfmtjapanese" => "EUC-JP"
    "iso-2022-jp" => "ISO-2022-JP"
    "csiso2022jp" => "ISO-2022-JP"
    "euc-kr" | "ks_c_5601-1987" | "ks_c_5601-1989" | "korean" | "windows-949" | "csksc56011987" | "iso-ir-149" |
    "ksc5601" => "CP949"
    "ksc_5601" => "CP949"
    "cseuckr" => "CP949"
    "ascii" | "us-ascii" | "latin1" | "iso-8859-1" | "iso8859-1" | "iso_8859-1" | "l1" | "cp1252" |
    "windows-1252" => "WINDOWS-1252"
    "x-cp1252" => "WINDOWS-1252"
    "cp819" => "WINDOWS-1252"
    "ibm819" => "WINDOWS-1252"
    "iso-ir-100" => "WINDOWS-1252"
    "csisolatin1" => "WINDOWS-1252"
    "utf-16le" => "UTF-16LE"
    "utf-16" => "UTF-16LE"
    "utf-16be" => "UTF-16BE"
    "koi8-r" => "KOI8-R"
    "koi8" => "KOI8-R"
    "koi" => "KOI8-R"
    "cskoi8r" => "KOI8-R"
    "koi8-u" => "KOI8-U"
    "koi8-ru" => "KOI8-U"
    "macintosh" => "MACINTOSH"
    "mac" => "MACINTOSH"
    "x-mac-roman" => "MACINTOSH"
    "csmacintosh" => "MACINTOSH"
    l if l.starts_with("windows-125") && l.length() == 12 => ascii_upper(l)
    l if l.starts_with("iso-8859-") => ascii_upper(l)
    _ => ""
  }
}

fn decode_page(body : Bytes, content_type : String) -> String {
  doc_label.v = ""
  doc_iconv.v = ""
  if body.length() >= 3 && (body[0].to_int() & 0xFF) == 0xEF && (body[1].to_int() & 0xFF) == 0xBB && (body[2].to_int() & 0xFF) == 0xBF {
    doc_label.v = "UTF-8"
    return utf8_decode_lossy(body)
  }
  let ct_parts = content_type.split(";")
  let essence = if ct_parts.length() > 0 { ascii_lower(ct_parts[0].trim()) } else { "" }
  if essence == "application/json" || essence == "text/json" || essence.ends_with("+json") {
    return utf8_decode_lossy(body)
  }
  let mut label = ""
  if body.length() >= 2 && (body[0].to_int() & 0xFF) == 0xFE && (body[1].to_int() & 0xFF) == 0xFF {
    label = "utf-16be"
  } else if body.length() >= 2 && (body[0].to_int() & 0xFF) == 0xFF && (body[1].to_int() & 0xFF) == 0xFE {
    label = "utf-16le"
  }
  let charset_in = fn(t : String) -> String {
    let lt = ascii_lower(t)
    match str_find(lt, "charset=") {
      Some(i) => {
        let rest = t.slice(i + 8, t.length())
        let v = StringBuilder::new()
        let bs = rest.to_bytes()
        let mut j = 0
        while j < bs.length() {
          let ch = bs[j].to_int() & 0xFF
          if ch == 59 || ch == 32 || ch == 62 || ch == 47 {
            if v.to_string().length() == 0 {
              j += 1
              continue
            }
            break
          }
          if ch != 34 && ch != 39 {
            v.write_byte(bs[j])
          }
          j += 1
        }
        v.to_string()
      }
      None => ""
    }
  }
  if label == "" {
    label = charset_in(content_type)
  }
  if label == "" {
    let n = if body.length() < 1024 { body.length() } else { 1024 }
    let head_b = Bytes::new(n)
    let mut i = 0
    while i < n {
      let b = body[i].to_int() & 0xFF
      head_b[i] = if b < 128 { body[i] } else { 32.to_byte() }
      i += 1
    }
    let h = head_b.to_string()
    let lh = ascii_lower(h)
    let mut pos = 0
    while str_find(lh.slice(pos, lh.length()), "<meta") is Some(k) {
      let start = pos + k
      let end = match str_find(lh.slice(start, lh.length()), ">") {
        Some(e) => start + e
        None => lh.length()
      }
      let tag = h.slice(start, end)
      let lt = ascii_lower(tag)
      match str_find(lt, "charset") {
        Some(c) => {
          let raw_r = tag.slice(c + 7, tag.length()).to_bytes()
          let mut ri = 0
          while ri < raw_r.length() {
            let ch = raw_r[ri].to_int() & 0xFF
            if ch == 32 || ch == 61 || ch == 34 || ch == 39 {
              ri += 1
            } else {
              break
            }
          }
          let v = StringBuilder::new()
          while ri < raw_r.length() {
            let ch = raw_r[ri].to_int() & 0xFF
            if ch == 34 || ch == 39 || ch == 32 || ch == 59 || ch == 47 || ch == 62 {
              break
            }
            v.write_byte(raw_r[ri])
            ri += 1
          }
          let vs = v.to_string()
          if vs.length() > 0 {
            label = vs
            break
          }
        }
        None => ()
      }
      pos = end
      if pos >= lh.length() {
        break
      }
    }
  }
  let name = iconv_name(label)
  if label != "" {
    doc_label.v = label
  }
  if name == "" {
    return utf8_decode_lossy(body)
  }
  match fetch::to_utf8(body, name) {
    Some(u) => {
      doc_iconv.v = name
      utf8_decode_lossy(u)
    }
    None => utf8_decode_lossy(body)
  }
}

///|
/// The JavaScript MIME type essences a classic script may be given (HTML: "JavaScript MIME type essence match").
let js_mime_essences : Array[String] = [
  "application/ecmascript", "application/javascript", "application/x-ecmascript", "application/x-javascript",
  "text/ecmascript", "text/javascript", "text/javascript1.0", "text/javascript1.1", "text/javascript1.2",
  "text/javascript1.3", "text/javascript1.4", "text/javascript1.5", "text/jscript", "text/livescript",
  "text/x-ecmascript", "text/x-javascript",
]

///|
/// What a script element's type (or, without one, its language) makes it, as HTML's "prepare the script element"
/// reads them: "classic", "module", "importmap", or "" for a block of data that does not run.
/// (An SVG script has no language attribute; module and importmap are matched without trimming, as Chrome does.)
fn script_kind(s : html::Node) -> String {
  let language = if s.ns is Svg { None } else { s.attr("language") }
  let given = match s.attr("type") {
    Some("") => return "classic"
    Some(t) => t
    None =>
    match language {
      None => return "classic"
      Some("") => return "classic"
      Some(l) => "text/" + l
    }
  }
  let raw = ascii_lower(given)
  if arr_has_str(js_mime_essences, raw.trim()) {
    "classic"
  } else if raw == "module" || raw == "importmap" {
    raw
  } else {
    ""
  }
}

///|
/// A script's bytes as text: UTF-8 when they are, else in the page's own legacy encoding (a GBK page's scripts are
/// GBK too).
fn script_text(code : Bytes) -> String {
  if doc_iconv.v != "" && !valid_utf8(code) {
    match fetch::to_utf8(code, doc_iconv.v) {
      Some(u) => return utf8_decode_lossy(u)
      None => ()
    }
  }
  utf8_decode_lossy(code)
}

///|
fn valid_utf8(b : Bytes) -> Bool {
  let n = b.length()
  let mut i = 0
  while i < n {
    let c = b[i].to_int()
    let len = if c < 0x80 { 1 } else if c >= 0xC2 && c < 0xE0 { 2 } else if c >= 0xE0 && c < 0xF0 { 3 } else if c >= 0xF0 && c < 0xF5 { 4 } else { 0 }
    if len == 0 || i + len > n {
      return false
    }
    for k in 1..<len {
      if (b[i + k].to_int() & 0xC0) != 0x80 {
        return false
      }
    }
    i += len
  }
  true
}

///|
/// FV_PROF: what changed the page after its last layout.
let dirtied_by : Ref[String] = Ref::{ v: "" }

///|
/// Where the page's scripts last scrolled it, until the client is told.
let scroll_wanted : Ref[Option[Double]] = Ref::{ v: None }

///|
/// Whether the page's scripts scrolled the document since it was loaded (`scripts_scrolled`).
let scripts_scrolled_doc : Ref[Bool] = Ref::{ v: false }

///|
/// Whether the current document's scripts have scrolled it themselves since it was loaded (a scroll restored on
/// Back/Forward or a tab switch leaves such a place as the page put it).
pub fn scripts_scrolled() -> Bool {
  scripts_scrolled_doc.v
}

///|
/// What the page copied last, until the client is told.
let copied_wanted : Ref[Option[String]] = Ref::{ v: None }

///|
/// What the page copied since this was last asked, for the person's device.
pub fn take_copied() -> Option[String] {
  let s = copied_wanted.v
  copied_wanted.v = None
  s
}

///|
/// Where the page's scripts scrolled it since this was last asked, if they did.
pub fn take_scroll() -> Option[Double] {
  let y = scroll_wanted.v
  scroll_wanted.v = None
  y
}

///|
/// A document's elements by the names the window and the document find them by (HTML's named properties), as one
/// version of its names had them (`names_version`).
struct Named {
  ver : Int
  frames : Map[String, html::Node]
  win : Map[String, Array[html::Node]]
  docs : Map[String, Array[html::Node]]
}

///|
/// Each document's named elements, by the document's js id.
let named_kept : intmap::IntMap[Named] = intmap::IntMap::new()

///|
/// The named elements of `doc`, found once for each version of its names: pages ask for names they have not (typeof
/// define, x in document) many times a tap, each a walk of the whole document before. As Blink's named item maps,
/// what is found among the elements with an id or a name; in document order.
fn named_in(doc : html::Node) -> Named {
  let ver = st.version - names_kept.v
  match intmap::get(named_kept, id_of(doc)) {
    Some(n) if n.ver == ver => return n
    _ => ()
  }
  named_rebuilds.v += 1
  let n = Named::{ ver: ver, frames: Map::new(), win: Map::new(), docs: Map::new() }
  let add = fn(m : Map[String, Array[html::Node]], k : String, e : html::Node) {
    match m.get(k) {
      Some(l) => if l[l.length() - 1].uid != e.uid { l.push(e) }
      None => m[k] = [e]
    }
  }
  for e in query(doc, "[id],[name]", false) {
    let tag = e.tag
    let id = e.attr("id")
    let name = e.attr("name")
    let html = e.ns == html::Html
    if tag == "iframe" && name is Some(nm) && !n.frames.contains(nm) {
      n.frames[nm] = e
    }
    // the window's: an element by its id, a form, picture, embed or object of HTML's by its name
    match id {
      Some(v) if v != "" => add(n.win, v, e)
      _ => ()
    }
    match name {
      Some(v) if html && (tag == "form" || tag == "img" || tag == "embed" || tag == "object") => add(n.win, v, e)
      _ => ()
    }
    // the document's: forms, iframes, embeds and objects by name, pictures by a name not empty and by id when they
    // have one, objects by id
    if tag == "object" {
      if name is Some(v) { add(n.docs, v, e) }
      if id is Some(v) { add(n.docs, v, e) }
    } else if tag == "img" {
      match name {
        Some(v) if v != "" => {
          add(n.docs, v, e)
          if id is Some(i) { add(n.docs, i, e) }
        }
        _ => ()
      }
    } else if (tag == "form" || tag == "iframe" || tag == "embed") && name is Some(v) {
      add(n.docs, v, e)
    }
  }
  named_kept.set(id_of(doc), n)
  n
}

///|
let named_rebuilds : Ref[Int] = Ref::{ v: 0 }

///|
/// `n` changed: its boxes and its ancestors' to be made again, in the page's boxes or its frame's.
fn boxes_changed(n : html::Node) -> Unit {
  box_reuse.v.changed(n)
  // (a node in a frame's document, or a shadow tree in it: its boxes made again there)
  if frames.length() > 0 {
    let mut top = n
    while true {
      match top.parent {
        Some(p) => top = p
        None =>
        match top.get_host() {
          Some(h) => top = h
          None => break
        }
      }
    }
    for f in frames {
      if ((f.doc).uid == (top).uid) {
        f.reuse.changed(n)
      }
    }
  }
}

///|
/// The document's changes that could not change what a name finds (`host` op 102).
let names_kept : Ref[Int] = Ref::{ v: 0 }

///|
/// The host call scripts made last (FV_PROF says which one a layout was for).
let last_op : Ref[Int] = Ref::{ v: -1 }

///|
let trace : Ref[Bool] = Ref::{ v: env_var("FV_TRACE") is Some(_) }

///|
fn host(op : Int, a : Int, b : Int, s : String, t : String) -> String {
  if !fcache.prof {
    return host_op(op, a, b, s, t)
  }
  // (FV_PROF) how often scripts called each op and how long the calls took, for `take_op_report`
  let t0 = fetch::now_us()
  let r = host_op(op, a, b, s, t)
  let us = fetch::now_us() - t0
  let (n, sum) = intmap::get(op_times, op).unwrap_or((0, 0L))
  op_times.set(op, (n + 1, sum + us))
  if op == 17 || op == 22 || op == 21 {
    let cls = at(a).attr("class").unwrap_or("")
    let k = if op == 22 { "22 " + at(a).tag + "." + cls.slice(0, imin(cls.length(), 30)) } else { "\{op} \{b} " + s.slice(0, imin(s.length(), 60)) }
    let (m, u) = op_args.get(k).unwrap_or((0, 0L))
    op_args.set(k, (m + 1, u + us))
  }
  r
}

///|
/// (FV_PROF) The selectors (op 17), properties (21) and elements (22) asked, with their calls and microseconds.
let op_args : Map[String, (Int, Int64)] = Map::new()

///|
/// (FV_PROF) Each op's calls and microseconds since the report before.
let op_times : intmap::IntMap[(Int, Int64)] = intmap::IntMap::new()

///|
/// (FV_PROF) The ops scripts called since the last report, most time first: "op count×, ms", and the calls in all.
pub fn take_op_report() -> String {
  let ks = op_times.keys()
  let mut calls = 0
  let mut us = 0L
  let entries : Array[(Int, Int, Int64)] = []
  for k in ks {
    let (c, t) = op_times.get_or(k, (0, 0L))
    calls += c
    us += t
    entries.push((k, c, t))
  }
  // Sort descending by total microseconds (simple selection sort, small N)
  let mut i = 0
  while i < entries.length() {
    let mut best = i
    let mut j = i + 1
    while j < entries.length() {
      if entries[j].2 > entries[best].2 {
        best = j
      }
      j += 1
    }
    if best != i {
      let tmp = entries[i]
      entries[i] = entries[best]
      entries[best] = tmp
    }
    i += 1
  }
  let parts : Array[String] = []
  let mut pi = 0
  while pi < entries.length() && pi < 12 {
    let (k, c, t) = entries[pi]
    parts.push("op\{k} \{c}x \{t.to_double() / 1000.0}ms")
    pi += 1
  }
  let arg_entries : Array[(String, Int, Int64)] = []
  for k in op_args.keys() {
    let (c, t) = op_args.get(k).unwrap_or((0, 0L))
    arg_entries.push((k, c, t))
  }
  let mut ai = 0
  while ai < arg_entries.length() {
    let mut best = ai
    let mut aj = ai + 1
    while aj < arg_entries.length() {
      if arg_entries[aj].2 > arg_entries[best].2 {
        best = aj
      }
      aj += 1
    }
    if best != ai {
      let tmp = arg_entries[ai]
      arg_entries[ai] = arg_entries[best]
      arg_entries[best] = tmp
    }
    ai += 1
  }
  let arg_parts : Array[String] = []
  let mut api = 0
  while api < arg_entries.length() && api < 8 {
    let (k, c, t) = arg_entries[api]
    arg_parts.push("[\{k}] \{c}x \{t.to_double() / 1000.0}ms")
    api += 1
  }
  op_times.clear()
  op_args.clear()
  "\{calls} calls, \{us.to_double() / 1000.0} ms: " + parts.join(", ") + " | args: " + arg_parts.join(", ")
}

///|
/// Whether a document's named elements were looked up since the names last changed (what is found is kept until then).
let names_asked : Ref[Bool] = Ref::{ v: false }

///|
/// Whether an element at or below `n` has an id or a name (what a document's named elements are found by).
fn names_below(n : html::Node) -> Bool {
  let walk = [n]
  while walk.pop() is Some(x) {
    if x.kind == html::Kind::Element {
      for a in x.attrs {
        if a.name == "id" || a.name == "name" {
          return true
        }
      }
    }
    for c in x.children {
      walk.push(c)
    }
  }
  false
}

///|
/// Tags by the numbers `host_int`'s op 8 gives them, and the numbers by tag.
let tag_names : Array[String] = []

///|
let tag_codes : Map[String, Int] = Map::new()

///|
fn tag_code(t : String) -> Int {
  match tag_codes.get(t) {
    Some(c) => c
    None => {
      let c = tag_names.length()
      tag_names.push(t)
      tag_codes[t] = c
      c
    }
  }
}

///|
/// The host's calls that read the tree and answer a node's id (0: none) or a number, without strings either way (as
/// Blink's bindings hand scripts a node's parent and siblings straight from its fields): 5 the parent, 110 the first
/// child (b 1: element), 111 the last (b 1: element), 100 a sibling (b as op 100's), 7 the node type (b 1: with the
/// namespace code), 67 the root (b as op 67's), 112 whether a holds b, 60 the document's version, 8 the tag's number.
let doc_names_ver : Ref[Int] = Ref::{ v: 1 }
let detach_ver : Ref[Int] = Ref::{ v: 1 }

fn bump_doc_names_version() -> Unit {
  doc_names_ver.v += 1
  js::set_doc_names_version(doc_names_ver.v)
}

fn bump_detach_version() -> Unit {
  detach_ver.v += 1
  js::set_detach_version(detach_ver.v)
}

fn is_doc_named_tag(tag : String) -> Bool {
  tag == "form" || tag == "iframe" || tag == "img" || tag == "embed" || tag == "object"
}

fn is_id_or_name(s : String) -> Bool {
  let n = s.length()
  if n == 2 {
    let c0 = s.code_unit_at(0)
    let c1 = s.code_unit_at(1)
    (c0 == 105 || c0 == 73) && (c1 == 100 || c1 == 68)
  } else if n == 4 {
    let c0 = s.code_unit_at(0)
    let c1 = s.code_unit_at(1)
    let c2 = s.code_unit_at(2)
    let c3 = s.code_unit_at(3)
    (c0 == 110 || c0 == 78) && (c1 == 97 || c1 == 65) && (c2 == 109 || c2 == 77) && (c3 == 101 || c3 == 69)
  } else {
    false
  }
}

fn subtree_has_doc_named(root : html::Node) -> Bool {
  if root.kind == html::Kind::Element && is_doc_named_tag(root.tag) {
    return true
  }
  let mut i = 0
  let n = root.children.length()
  while i < n {
    if subtree_has_doc_named(root.children[i]) {
      return true
    }
    i = i + 1
  }
  false
}

fn subtree_has_active_kind(parent : html::Node) -> Int {
  let mut i = 0
  let n = parent.children.length()
  while i < n {
    let c = parent.children[i]
    if c.kind == html::Kind::Element {
      let t = c.tag
      if t == "link" || t == "script" || t == "iframe" {
        return 1
      }
      if c.children.length() > 0 && subtree_has_active_kind(c) != 0 {
        return 1
      }
    }
    i = i + 1
  }
  0
}

fn bump_version() -> Unit {
  st.version += 1
  js::set_dom_version(st.version)
  css::reset_ancestor_keys()
}

let hot_create_tags : Array[String] = [
  "div", "span", "li", "ul", "a", "p", "input", "label",
  "button", "section", "header", "footer", "main", "nav", "article", "aside",
  "h1", "h2", "h3", "h4", "table", "thead", "tbody", "tr",
  "td", "th", "form", "img", "br", "strong", "em", "option",
]

let hot_svg_create_tags : Array[String] = [
  "g", "path", "rect", "line", "circle", "text", "tspan", "svg",
  "clipPath", "defs", "linearGradient", "stop", "polygon", "polyline",
  "ellipse", "use", "title", "desc", "symbol", "marker",
]

fn dom_insert_op(a : Int, b : Int, before : Option[html::Node], promoted : Bool) -> Unit {
  let inserted = at(b)
  if inserted.kind == html::Kind::Fragment || (inserted.kind == html::Kind::Element && inserted.tag == "base") {
    no_base_docs.clear()
  }
  let parent = at(a)
  let fresh_leaf = inserted.layout_id < 0 &&
  inserted.children.length() == 0 &&
  !inserted.has_shadow() &&
  inserted.parent is None
  if !fresh_leaf && !((tree_root(inserted)).uid == (tree_root(parent)).uid) {
    let walk = [inserted]
    while walk.pop() is Some(x) {
      if x.layout_id >= 0 {
        x.layout_id = -1
      }
      for c in x.children {
        walk.push(c)
      }
      match x.get_shadow() {
        Some(sh) => walk.push(sh)
        None => ()
      }
    }
  }
  touch_at(parent, children_changed=true, moved=Some(inserted))
  if !(fresh_leaf && !inserted.ever_styled) {
    touch_at(inserted, children_changed=true, has_known=true)
  }
  match inserted.parent {
    Some(old) => touch_at(old, children_changed=true, moved=Some(inserted))
    None => ()
  }
  if browsing.len() > 0 && !cross_ctx_seen.v {
    let cl = id_owner_ctx.length()
    if (a > 0 && a < cl && id_owner_ctx[a] != cur_ctx.v) || (b > 0 && b < cl && id_owner_ctx[b] != cur_ctx.v) {
      cross_ctx_seen.v = true
    }
  }
  if loose_roots.len() > 0 {
    let shared_ctx = browsing.len() > 0 && inserted.js_id > 0 && inserted.js_id < id_owner_ctx.length() && id_owner_ctx[inserted.js_id] == -1
    let safe_promote = !shared_ctx && (promoted || (inserted.children.length() == 0 && !inserted.has_shadow()))
    if loose_roots.contains(inserted.uid) {
      if inserted.kind != html::Kind::Fragment {
        loose_roots.erase(inserted.uid)
        dirty_loose_roots.erase(inserted.uid)
      }
      if swept_held_count.len() > 0 { swept_held_count.erase(inserted.uid) }
      if loose_root_ctx.len() > 0 { loose_root_ctx.erase(inserted.uid) }
      if swept_loose_roots.contains(inserted.uid) {
        if inserted.kind != html::Kind::Fragment {
          swept_loose_roots.erase(inserted.uid)
        }
        if !safe_promote {
          loose_full_needed.v = true
        } else {
          let pr = tree_root(parent)
          if loose_roots.contains(pr.uid) {
            dirty_loose_roots.set(pr.uid, pr)
          }
        }
      } else {
        let pr = tree_root(parent)
        if loose_roots.contains(pr.uid) {
          dirty_loose_roots.set(pr.uid, pr)
        }
      }
    } else if !fresh_leaf {
      let ir = tree_root(inserted)
      if loose_roots.contains(ir.uid) {
        if swept_held_count.len() > 0 { swept_held_count.erase(ir.uid) }
        if loose_root_ctx.len() > 0 { loose_root_ctx.erase(ir.uid) }
        dirty_loose_roots.set(ir.uid, ir)
        if swept_loose_roots.contains(ir.uid) && !safe_promote {
          loose_full_needed.v = true
        } else {
          let pr = tree_root(parent)
          if loose_roots.contains(pr.uid) {
            dirty_loose_roots.set(pr.uid, pr)
          }
        }
      }
    }
  }
  let was_in_tree = inserted.parent.is_some()
  let is_frag = inserted.kind == html::Kind::Fragment
  let old_plen = parent.children.length()
  let tc_before = html::tree_changes_count()
  invalidate_swept_held_count(parent)
  parent.insert_before(inserted, before)
  if inserted.kind == html::Kind::Element || is_frag {
    if is_connected_to_id_idx(parent) {
      let ver = id_index_gen.v
      if (id_idx_a.root_uid >= 0 && id_idx_a.insert_ver == ver && id_idx_a.has_dups) ||
      (id_idx_b.root_uid >= 0 && id_idx_b.insert_ver == ver && id_idx_b.has_dups) {
        if is_frag || subtree_has_id_attr(inserted) {
          id_index_gen.v += 1
        }
      } else if is_frag {
        let mut fi = old_plen
        while fi < parent.children.length() {
          id_idx_add_subtree(parent.children[fi])
          fi += 1
        }
      } else {
        id_idx_add_subtree(inserted)
      }
    }
    attr_index_gen.v += 1
    if is_frag {
      if before.is_none() {
        let mut fi = old_plen
        while fi < parent.children.length() {
          let fc = parent.children[fi]
          if fc.kind == html::Kind::Element {
            class_idx_on_insert(parent, fc, true)
          }
          fi += 1
        }
      } else {
        class_insert_gen.v += 1
      }
    } else {
      class_idx_on_insert(parent, inserted, !was_in_tree && before.is_none())
    }
    if !was_in_tree {
      let tc_after = html::tree_changes_count()
      if class_idx_a.root_uid >= 0 && class_idx_a.tree_ver == tc_before {
        class_idx_a.tree_ver = tc_after
      }
      if class_idx_b.root_uid >= 0 && class_idx_b.tree_ver == tc_before {
        class_idx_b.tree_ver = tc_after
      }
    }
  }
}

fn dom_detach_op(a : Int) -> Unit {
  let target = at(a)
  touch_at(target, children_changed=true, has_known=true)
  invalidate_swept_held_count(target)
  match target.parent {
    Some(p) => touch_at(p, children_changed=true, moved=Some(target))
    None => ()
  }
  target.detach()
  note_loose_subtree(target)
}

fn host_int(op : Int, a : Int, b : Int) -> Int {
  last_op.v = op
  if op == 60 {
    return st.version
  }
  if op == 102 {
    if b == 1 {
      return doc_names_ver.v
    }
    names_asked.v = true
    return st.version - names_kept.v
  }
  if op == 2 {
    if b == 1 {
      if a >= 0 && a < hot_svg_create_tags.length() {
        bump_version()
        names_kept.v += 1
        return id_of(html::Node::element(html::Ns::Svg, hot_svg_create_tags[a], html::empty_attrs()))
      }
      return 0
    }
    if a >= 0 && a < hot_create_tags.length() {
      bump_version()
      names_kept.v += 1
      return id_of(html::Node::element(html::Ns::Html, hot_create_tags[a], html::empty_attrs()))
    }
    return 0
  }
  if op == 3 {
    bump_version()
    names_kept.v += 1
    return id_of(html::Node::text(if b == 0 { "" } else { " " }))
  }
  if op == 26 {
    if b == 1 {
      return match at(a).get_template_content() {
        Some(tc) => id_of(tc)
        None => 0
      }
    }
    bump_version()
    names_kept.v += 1
    return id_of(html::Node::new(html::Kind::Fragment))
  }
  if op == 29 {
    bump_version()
    names_kept.v += 1
    return id_of(html::clone(at(a), b == 1))
  }
  if op == 9 {
    bump_version()
    let inserted = at(b)
    if names_asked.v && !names_below(inserted) {
      names_kept.v += 1
    } else {
      names_asked.v = false
    }
    if subtree_has_doc_named(inserted) {
      bump_doc_names_version()
    }
    if inserted.parent is Some(_) {
      bump_detach_version()
    }
    dom_insert_op(a, b, None, false)
    return 1
  }
  if op == 10 {
    bump_version()
    let target = at(a)
    if names_asked.v && !names_below(target) {
      names_kept.v += 1
    } else {
      names_asked.v = false
    }
    if subtree_has_doc_named(target) {
      bump_doc_names_version()
    }
    bump_detach_version()
    dom_detach_op(a)
    return 1
  }
  if op == 65 {
    return loose_trees_intbuf()
  }
  if op == 66 {
    release_ids_from_intbuf(a)
    return 0
  }
  if op == 6 {
    return kids_to_intbuf(a, b)
  }
  if op == 133 {
    return js::intbuf_cap()
  }
  let n = at(a)
  match op {
    5 =>
    match n.parent {
      Some(p) => id_of(p)
      None => 0
    }
    110 | 111 => {
      if op == 110 && b == 2 {
        return subtree_has_active_kind(n)
      }
      let k = n.children
      let first = op == 110
      let mut i = if first { 0 } else { k.length() - 1 }
      while i >= 0 && i < k.length() {
        if b == 0 || k[i].kind == html::Kind::Element {
          return id_of(k[i])
        }
        i += if first { 1 } else { -1 }
      }
      0
    }
    100 =>
    match n.parent {
      Some(p) => {
        let k = p.children
        let i = n.index()
        let step = if b == 1 || b == 3 { 1 } else { -1 }
        let mut j = i + step
        if b >= 2 {
          while j >= 0 && j < k.length() && k[j].kind != html::Kind::Element {
            j += step
          }
        }
        if i >= 0 && j >= 0 && j < k.length() {
          k[j].pos = j
          id_of(k[j])
        } else {
          0
        }
      }
      None => 0
    }
    7 => {
      let kind = match n.kind {
        Element => 1
        Text => if n.tag == "" { 3 } else { 4 }
        Comment => if n.tag == "" { 8 } else { 7 }
        Doctype => 10
        Fragment => 11
        Document => 9
      }
      // (b 1: namespace code in bits 8..11, and for Element its tag_code in bits 12..30: a wrapper made in ONE call)
      if b == 1 {
        let ns = match n.ns {
          Html => 0
          Svg => 1
          MathMl => 2
          Other => 3
        }
        if kind == 1 {
          kind | (ns << 8) | (tag_code(n.tag) << 12)
        } else {
          kind | (ns << 8)
        }
      } else {
        kind
      }
    }
    // the document's version (op 60's, as a number: lists scripts hold ask it at each read)
    60 => st.version
    // named-elements version (op 102's, as a number: winNamed asks it on every unknown global property lookup)
    102 => {
      names_asked.v = true
      st.version - names_kept.v
    }
    // a node's tag as a number, the same for each tag (its name once by op 8 with b 2): a wrapper made for each
    // element a script reaches asked for its tag as a string
    8 => tag_code(n.tag)
    67 => id_of(if b == 1 { tree_root(n) } else { top_ancestor(n) })
    // 112: whether a is b or above it, through shadow roots' hosts (a node put in b would hold itself)
    112 => {
      let mut cur : Option[html::Node] = Some(at(b))
      while cur is Some(x) {
        if ((x).uid == (n).uid) {
          return 1
        }
        cur = match x.parent {
          Some(p) => Some(p)
          None => x.get_host()
        }
      }
      0
    }
    _ => 0
  }
}

///|
fn host_op(op : Int, a : Int, b : Int, s : String, t : String) -> String {
  last_op.v = op
  if trace.v {
    println("host \{op} \{a} \{b} \{s.length()}" + (if op == 12 { " " + s + "=" + t.slice(0, imin(t.length(), 60)) } else { "" }))
  }
  // what only reads the document leaves its version; anything else may change it
  if (op != 1 && op != 5 && op != 6 && op != 7 && op != 8 && op != 11 && op != 14 && op != 15 && op != 17 && op != 18 && op != 19 && op != 21 && op != 22 && op != 23 && op != 78 && op != 79 && op != 81 && op != 82 && op != 83 && op != 84 && op != 85 && op != 87 && op != 24 && op != 25 && op != 27 && op != 28 && op != 30 && op != 37 && op != 39 && op != 40 && op != 41 && op != 42 && op != 60 && op != 62 && op != 63 && op != 64 && op != 65 && op != 66 && op != 67 && op != 68 && op != 70 && op != 71 && op != 72 && op != 73 && op != 74 && op != 75 && op != 76 && op != 102 && op != 103 && op != 104 && op != 117 && op != 118 && op != 119 && op != 120 && op != 121 && op != 124 && op != 126 && op != 128 && op != 129 && op != 130 && op != 134 && op != 135 && op != 138) {
    bump_version()
    // (what cannot change which elements a name finds: another attribute, a text's data)
    // a node made (in no document yet), or a subtree put in or taken out with no element named in it (Blink's
    // TreeScope keeps its id and name maps by the elements that come and go, not by every change)
    // (a subtree is looked through only while what names found is kept: once a change let it go, nothing is kept)
    if ((op == 12 || op == 13) && !is_id_or_name(s)) ||
    (op == 16 || op == 2 || op == 3 || op == 4 || op == 29) ||
    (op == 9 && names_asked.v && !names_below(at(b))) ||
    (op == 10 && names_asked.v && !names_below(at(a))) ||
    (op == 113 && names_asked.v && !names_below(at(a))) {
      names_kept.v += 1
    } else {
      names_asked.v = false
    }
    // Track document named-property version (only form/iframe/img/embed/object id/name mutations affect docNamed)
    if op == 12 || op == 13 {
      if is_id_or_name(s) && is_doc_named_tag(at(a).tag) {
        bump_doc_names_version()
      }
    } else if op == 9 {
      if subtree_has_doc_named(at(b)) {
        bump_doc_names_version()
      }
    } else if op == 10 || op == 113 {
      if subtree_has_doc_named(at(a)) {
        bump_doc_names_version()
      }
    } else if op != 16 && op != 2 && op != 3 && op != 4 && op != 29 && op != 33 && op != 69 {
      bump_doc_names_version()
    }
    if op == 10 || op == 20 || op == 35 || op == 113 || op == 125 || (op == 9 && at(b).parent is Some(_)) {
      bump_detach_version()
    }
  }
  match op {
    // a passkey made or signed with (webauthn.mbt)
    117 => webauthn_op(s, t)
    // a message for another tab of the profile (windows.mbt): the tab, the message
    118 => window_post_op(s, t)
    // streaming HTTP fetch / SSE (streams.mbt)
    119 => stream_op(a, b, s, t)
    // native WebSocket (ws.mbt)
    120 => ws_op(a, b, s, t)
    // IndexedDB persistence per origin (idb.mbt)
    121 => idb_op(a, s, t)
    // <video>/<audio> real media loading, probing, frame decoding & playback (media.mbt)
    122 => media_op(a, b, s, t)
    // hover listener registered on an element in the main global
    123 => {
      if cur_ctx.v == 0 {
        has_hover_targets.v = true
      }
      ""
    }
    // inline PDF viewer one-click download (pdf.mbt)
    124 => pdf_download_op()
    // real GPU WebGL 1.0 / WebGL 2.0 backend (webgl.pion)
    128 => webgl_op(a, b, s, t)
    // per-origin persistent permission state machine (sync.pion / page_aux/permissions.pion)
    129 => perm_op(a, s, t)
    // multi-threaded V8 Isolate Web Worker management (frames.pion / v8_worker.cc)
    130 => worker_thread_op(a, b, s, t)
    // real WebRTC (RTCPeerConnection + UDP/STUN/DTLS-SRTP + mediaDevices) (webrtc.pion)
    134 => webrtc_op(a, b, s, t)
    // Chrome MV3 isolated extension APIs (chrome.storage.local, runtime, declarativeNetRequest) (extensions.pion)
    135 => ext_op(a, b, s, t)
    // a person's caret: where it is drawn for a text node's offset, and the one nearest a point of an editing host
    // (person.mbt)
    114 => caret_point_op(a, b)
    // an element scrolled by its scripts or a person ("left,top"): drawn, hit and measured so
    116 => {
      let n = at(a)
      let xyp = s.split(",")
      if xyp.length() == 2 {
        let sx = css::parse_double(xyp[0])
        let sy = css::parse_double(xyp[1])
        let was = intmap::get(layout::scrolls, n.uid).unwrap_or((0.0, 0.0))
        if was.0 != sx || was.1 != sy {
          if sx == 0.0 && sy == 0.0 {
            ignore(layout::scrolls.delete(n.uid))
          } else {
            layout::scrolls.set(n.uid, (sx, sy))
          }
          st.rects = None
          for f in frames {
            f.rects = None
          }
          touch_at(n)
        }
      }
      ""
    }
    115 => point_caret_op(a, s)
    60 => st.version.to_string()
    // the document's version as names see it (window.x, document.x): it changes when elements come or go or an id or
    // a name changes, not with other attributes
    102 => {
      names_asked.v = true
      (st.version - names_kept.v).to_string()
    }
    // after an animation frame's callbacks (FV_RENDER, a runner with no client timing what a browser does): the frame
    // a display would show, laid out and drawn
    104 => {
      if render_frames && frame_due.v {
        frame() |> ignore
      }
      ""
    }
    // the elements a name finds in document a (b 0: as the window's, b 1: as the document's, b 2: the iframe of that
    // name), from its named elements kept for this version of its names
    103 => {
      names_asked.v = true
      if !html::maybe_named(s) {
        return ""
      }
      let n = named_in(at(a))
      if b == 3 {
        match n.frames.get(s) {
          Some(f) => return "F" + id_of(f).to_string()
          None => return csv(n.win.get(s).unwrap_or([]))
        }
      }
      csv(
        (match b {
          0 => n.win.get(s)
          1 => n.docs.get(s)
          _ => match n.frames.get(s) {
            Some(f) => Some([f])
            None => None
          }
        }).unwrap_or([]),
      )
    }
    65 => loose_trees()
    79 => {
      let m = storage_of(a, s)
      let b = StringBuilder::new()
      b.write_char('{')
      let mut first = true
      let mks = m.keys()
      for k in mks {
        match m.get(k) {
          Some(v) => {
            if !first {
              b.write_char(',')
            }
            first = false
            b.write_string(json_string(k))
            b.write_char(':')
            b.write_string(json_string(v))
          }
          None => ()
        }
      }
      b.write_char('}')
      b.to_string()
    }
    80 => {
      let m = storage_of(a, s)
      match b {
        0 =>
        match str_find(t, soh_str()) {
          Some(k) => m.set(t.slice(0, k), t.slice(k + 1, t.length()))
          None => ()
        }
        1 => m.remove(t)
        _ => m.clear()
      }
      if a == 0 {
        storage_changed.v = true
      }
      ""
    }
    78 => {
      let name = iconv_name(t)
      if name == "" {
        return nul_str()
      }
      let raw = s.to_bytes()
      match fetch::to_utf8(raw, name) {
        Some(u) => utf8_decode_lossy(u)
        None => nul_str()
      }
    }
    // the page copied `s` (navigator.clipboard, a copy command): the person's device is told with the next frame
    97 => {
      let _ = os_platform::clipboard_write_text(s)
      copied_wanted.v = Some(s)
      frame_due.v = true
      ""
    }
    // OS multi-format clipboard bridge (`os_platform`)
    136 => clipboard_host_op(a, b, s, t)
    // Pure-Pion WebVTT parsing & active subtitle tracking (`webvtt_host.pion`)
    137 => webvtt_op(a, b, s, t)
    // Pure-Pion WGSL->MSL & Apple Silicon Metal WebGPU backend (`webgpu_host.pion`)
    138 => webgpu_op(a, b, s, t)
    // HTML5 constraint validation tooltip changed: schedule DocClient Patch sync
    131 => {
      frame_due.v = true
      ""
    }
    132 => release_held_arg[0]
    // Register a blob: image's bytes, async-load detached/DOM HTMLImageElement, or manage ImageBitmap
    133 => image_host_op(a, b, s, t)
    // the page's scripts scroll it to `s` (the client is told with the next frame)
    77 => {
      scroll_wanted.v = Some(css::parse_double(s))
      scripts_scrolled_doc.v = true
      frame_due.v = true
      ""
    }
    // the element drawn topmost at a point of the page ("x,y"), 0 for none
    70 => {
      ensure_layout()
      let parts = s.split(",")
      let xy : Array[Double] = []
      for v in parts {
        xy.push(css::parse_double(v))
      }
      match st.root {
        Some(root) if xy.length() == 2 =>
        match layout::node_at(root, xy[0], xy[1]) {
          Some(n) => id_of(svg_target(root, if n.kind == html::Kind::Element { n } else { n.parent.unwrap_or(n) }, xy[0], xy[1])).to_string()
          None => "0"
        }
        _ => "0"
      }
    }
    // a checkbox's or radio button's checkedness: read (b 2), or set (b 1 checked, 0 not)
    69 => {
      let n = at(a)
      if b == 2 {
        return if html::checked(n) { "1" } else { "0" }
      }
      if html::checked(n) != (b == 1) || n.get_checked() is None {
        touch_at(n)
        // (an option chosen: what its select shows)
        match n.parent {
          Some(p) if n.tag == "option" && p.tag == "select" => touch_at(p)
          Some(p) if n.tag == "option" && p.tag == "optgroup" =>
          match p.parent {
            Some(s) if s.tag == "select" => touch_at(s)
            _ => ()
          }
          _ => ()
        }
      }
      n.set_checked(Some(b == 1))
      ""
    }
    // the document an iframe shows (0: none, one of another origin)
    71 => {
      let had = frames.length()
      match open_frame(at(a), now=true) {
        Some(f) => {
          // (a frame opened now is laid out with the page)
          if frames.length() != had {
            touch()
          }
          id_of(f.doc).to_string()
        }
        None => "0"
      }
    }
    // a node's root: its topmost ancestor (b 0), or through shadow roots' hosts (b 1)
    67 => {
      let n = at(a)
      id_of(if b == 1 { tree_root(n) } else { top_ancestor(n) }).to_string()
    }
    // whether a is b or one of b's ancestors
    68 => {
      let x = at(a)
      let mut cur = Some(at(b))
      while cur is Some(n) {
        if ((n).uid == (x).uid) {
          return "1"
        }
        cur = n.parent
      }
      "0"
    }
    // where boundary point (a, offset) is against (b, offset) (DOM ranges): -1 before, 0 equal, 1 after, 2 apart
    81 => {
      let (ao, bo) = match str_find(s, ",") {
        Some(i) => (css::parse_double(s.slice(0, i)).to_int(), css::parse_double(s.slice(i + 1, s.length())).to_int())
        None => (0, 0)
      }
      bp_compare(at(a), ao, at(b), bo).to_string()
    }
    // the page's time as its timers have run (ms): what transitions and animations go by
    83 => {
      page_now.v = a
      ""
    }
    // transitions and animations started or stopped since the scripts last asked: their events to come
    84 => {
      if trans_started.length() == 0 && anim_events.length() == 0 {
        return ""
      }
      let t : Array[String] = []
      for tr in trans_started {
        t.push("[\{tr.0},\{js_string(tr.1)},\{tr.2},\{tr.3}]")
      }
      let an : Array[String] = []
      for ae in anim_events {
        an.push("[\{ae.0},\{js_string(ae.1)},\{ae.2},\{ae.3},\{ae.4}]")
      }
      trans_started.clear()
      anim_events.clear()
      "[[" + t.join(",") + "],[" + an.join(",") + "]]"
    }
    85 => {
      let name = iconv_name(t)
      let bytes = if name == "" { utf8_encode(s) } else { fetch::from_utf8(s, name) }
      bytes_latin1(bytes)
    }
    86 => {
      let (method, url) = match str_find(s, soh_str()) {
        Some(i) => (s.slice(0, i), s.slice(i + 1, s.length()))
        None => ("GET", s)
      }
      let stx_b = Bytes::new(1)
      stx_b[0] = 2.to_byte()
      let (ctype, body) = match str_find(t, stx_b.to_string()) {
        Some(i) => (t.slice(0, i), latin1_bytes(t.slice(i + 1, t.length())))
        None => ("", Bytes::new(0))
      }
      navigate_frame(at(a), method, url, ctype, body)
      ""
    }
    87 => inner_text(at(a))
    82 => child_index(at(a)).to_string()
    66 => {
      if browsing.len() == 0 {
        release_ids(s)
      } else {
        to_release.push((cur_ctx.v, s))
      }
      ""
    }
    62 => {
      let (method, req_url, req_headers, out) = script_request(a, s, t)
      let mut url = req_url
      let mut headers = req_headers
      match extension_dnr_check(url, cur_url(), "xmlhttprequest") {
        extensions::DnrDecision::Blocked(_) => {
          cdp_record_network(method, url, 0)
          return ""
        }
        extensions::DnrDecision::Redirected(_, target) => {
          if target != "" {
            url = target
          }
        }
        extensions::DnrDecision::ModifyHeaders(mods) => {
          for m in mods {
            if m.target == "request" && (m.operation == "set" || m.operation == "append") {
              headers = if headers == "" { m.header + ": " + m.value } else { headers + "\n" + m.header + ": " + m.value }
            }
          }
        }
        extensions::DnrDecision::Allowed => ()
      }
      let extra = cdp_extra_headers()
      for ek in extra.keys() {
        match extra.get(ek) {
          Some(ev) => {
            headers = if headers == "" { ek + ": " + ev } else { headers + "\n" + ek + ": " + ev }
          }
          None => ()
        }
      }
      let r = fetch::request(method, url, headers, out, (a & 4) == 0)
      cdp_record_network(method, url, r.status)
      if (a & 4) == 0 && r.status > 0 {
        sec_ingest_set_cookies(if r.url != "" { r.url } else { url }, r.headers)
      }
      if !sec_check_corp(cur_url(), if r.url != "" { r.url } else { url }, r.headers, (a & 8) != 0) {
        return ""
      }
      if env_has("FV_DEBUG_FRAMES") {
        st.errors.push("request in context \{cur_ctx.v}: \{method} \{url} -> \{r.status}, \{r.body.length()} bytes")
      }
      answer_text(r, (a & 2) != 0)
    }
    76 => {
      let (method, req_url, req_headers, out) = script_request(a, s, t)
      let mut url = req_url
      let mut headers = req_headers
      match extension_dnr_check(url, cur_url(), "xmlhttprequest") {
        extensions::DnrDecision::Blocked(_) => {
          cdp_record_network(method, url, 0)
          return "0"
        }
        extensions::DnrDecision::Redirected(_, target) => {
          if target != "" {
            url = target
          }
        }
        extensions::DnrDecision::ModifyHeaders(mods) => {
          for m in mods {
            if m.target == "request" && (m.operation == "set" || m.operation == "append") {
              headers = if headers == "" { m.header + ": " + m.value } else { headers + "\n" + m.header + ": " + m.value }
            }
          }
        }
