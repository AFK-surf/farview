///|
fn walk_meta_charset(n : html::Node, found : Array[String]) -> Unit {
  if found.length() > 0 {
    return
  }
  if n.kind == html::Kind::Element && n.tag == "meta" {
    match n.attr("charset") {
      Some(c) => {
        found.push(c)
        return
      }
      None => ()
    }
    match (n.attr("http-equiv"), n.attr("content")) {
      (Some(h), Some(c)) if ascii_lower(h) == "content-type" && ascii_lower(c).contains("charset=") => {
        let lc = ascii_lower(c)
        let i = lc.index_of("charset=") + 8
        let rest = c.slice(i, c.length())
        let semi = rest.index_of(";")
        let end = if semi >= 0 { semi } else { rest.length() }
        let v = StringBuilder::new()
        let sub = rest.slice(0, end)
        let bs = sub.to_bytes()
        let mut j = 0
        while j < bs.length() {
          let ch = bs[j].to_int() & 0xFF
          if ch != 34 && ch != 39 && ch != 32 {
            v.write_byte(bs[j])
          }
          j = j + 1
        }
        found.push(v.to_string())
        return
      }
      _ => ()
    }
  }
  for c in n.children {
    walk_meta_charset(c, found)
  }
}

fn sheet_of(url : String) -> String {
  match st.sheets.get(url) {
    Some(t) => t
    None => {
      let (body, _) = fc_get(url)
      let t = utf8_decode_lossy(body)
      st.sheets.set(url, t)
      t
    }
  }
}

///|
/// Where the page's sheets come from, for fvclient/doc's adding of them (the client's adds them the same way): a
/// linked one fetched (and kept), the sheet scripts made of a <style>, an address resolved as fetch resolves it.
struct SheetSource {
  sheet_of : (String) -> String
  cssom_of : (html::Node) -> Option[String]
  resolve : (String, String) -> String
}

let page_sheets : SheetSource = SheetSource::{
  sheet_of: sheet_of,
  cssom_of: fn(n : html::Node) -> Option[String] {
    match intmap::get(cssom_rules, n.js_id) {
      Some(t) if n.js_id != 0 => Some(t)
      _ => None
    }
  },
  resolve: fetch::resolve,
}

///|
fn css_style(n : html::Node) -> Bool {
  if n.attr("disabled").is_some() {
    return false
  }
  let ty = ascii_lower(n.attr("type").unwrap_or("").trim())
  if ty != "" && ty != "text/css" {
    return false
  }
  let m = n.attr("media").unwrap_or("").trim()
  m == "" || css::media_query_matches(css::Env::new(st.w, st.h), m)
}

fn add_css_host(text : String, e : css::Engine, base : String, depth : Int) -> Unit {
  if depth < 4 && text != "" {
    let imps = css::import_rules(text)
    let mut i = 0
    while i < imps.length() {
      let r = imps[i]
      if e.import_applies(r) {
        let full = (page_sheets.resolve)(base, r.url)
        let sub = (page_sheets.sheet_of)(full)
        match r.layer {
          Some(l) => e.in_layer(l, fn() { add_css_host(sub, e, full, depth + 1) })
          None => add_css_host(sub, e, full, depth + 1)
        }
      }
      i += 1
    }
  }
  e.add_sheet_resolve(text, fn(u : String) -> String { (page_sheets.resolve)(base, u) })
}

fn add_sheets_walk(n : html::Node, e : css::Engine, base : String, index : Ref[Int]) -> Unit {
  if n.kind == html::Kind::Element {
    if n.tag == "style" {
      index.v += 1
      if css_style(n) {
        let text = match (page_sheets.cssom_of)(n) {
          Some(t) => t
          None => html::text_content(n)
        }
        add_css_host(text, e, base, 0)
      }
    } else if n.tag == "link" && ascii_lower(n.attr("rel").unwrap_or("")).contains("stylesheet") {
      index.v += 1
      let rel = ascii_lower(n.attr("rel").unwrap_or(""))
      let m = n.attr("media").unwrap_or("").trim()
      if n.attr("disabled").is_none() && !rel.contains("alternate") && (m == "" || css::media_query_matches(css::Env::new(st.w, st.h), m)) {
        match n.attr("href") {
          Some(href) if href != "" => {
            let full = (page_sheets.resolve)(base, href)
            let text = (page_sheets.sheet_of)(full)
            add_css_host(text, e, full, 0)
          }
          _ => ()
        }
      }
    }
  }
  for c in n.children {
    add_sheets_walk(c, e, base, index)
  }
}

///|
/// Document base URL per WHATWG HTML §4.2.3: the first `<base href>` element's href resolved against `fallback`.
fn doc_base_url(doc : html::Node, fallback : String) -> String {
  for b in query(doc, "base", false) {
    match b.attr("href") {
      Some(h) if h.trim() != "" => return fetch::resolve(fallback, h.trim())
      _ => ()
    }
  }
  fallback
}

fn add_sheets(
  n : html::Node,
  e : css::Engine,
  base? : String,
  index~ : Ref[Int] = Ref::{ v: 0 },
  only~ : Option[intmap::IntMap[(Int, Int)]] = None,
  added~ : Array[(Int, Int)] = [],
  ok~ : Ref[Bool] = Ref::{ v: true },
) -> Unit {
  ignore(only)
  ignore(added)
  ignore(ok)
  let b = doc_base_url(n, base.unwrap_or(st.url))
  if n.data != "" {
    e.add_sheet_resolve(n.data, fn(u : String) -> String { (page_sheets.resolve)(b, u) })
  }
  add_sheets_walk(n, e, b, index)
}

///|
/// A <style> element's sheet as a script made it (insertRule, deleteRule), by the element's script id: its rules' text.
let cssom_rules : intmap::IntMap[String] = intmap::IntMap::new()

///|
/// Whether pictures are got before the page is drawn (a test harness's onload waits for them); otherwise a page is
/// drawn first and its pictures come after, by fetch_pending.
pub let eager_pictures : Ref[Bool] = Ref::{ v: false }

///|
/// Whether a page's own scripts may reach the host-only entry points (the WPT runner's testdriver, which acts as the
/// user through them): as window.__fvTestInput.
pub let test_input : Ref[Bool] = Ref::{ v: false }

///|
/// The prelude's host-only entry points, as the host's own calls name them: __fvH(key) gives them only with the key.
fn hk() -> String {
  "__fvH(\"" + js::host_key() + "\")"
}

let cached_prelude : Ref[String] = Ref::{ v: "" }

fn cached_prelude_js() -> String {
  if cached_prelude.v == "" {
    cached_prelude.v = prelude_js()
  }
  cached_prelude.v
}

///|
/// A new global's prelude, then the host's key given to it (and the entry points to a test's driver, for tests).
fn run_prelude() -> Unit {
  if cur_ctx.v == 0 {
    has_hover_targets.v = false
  }
  run(cached_prelude_js())
  run("__fvHostKey(\"" + js::host_key() + "\")")
  if new_tabs.v {
    run("globalThis.__fvNewTabs = true")
  }
  if test_input.v {
    run("window.__fvTestInput = " + hk())
  }
}

///|
/// Pictures the last layout drew without, not yet got (their resolved URLs, or a background's own).
let pending : Array[String] = []

///|
/// Gets the pictures the page was drawn without, in progressive batches of up to 8 URLs per tick
/// so above-the-fold logos and hero images render immediately without being starved by dozens of
/// below-the-fold images; returns whether a batch was fetched (the page then changed).
pub fn fetch_pending() -> Bool {
  if pending.length() == 0 {
    return false
  }
  let batch_limit = 8
  let list : Array[String] = []
  let rest : Array[String] = []
  let mut pi = 0
  while pi < pending.length() {
    if pi < batch_limit {
      list.push(pending[pi])
    } else {
      rest.push(pending[pi])
    }
    pi += 1
  }
  pending.clear()
  for u in rest {
    pending.push(u)
  }
  let resolved_list : Array[String] = []
  for u in list {
    resolved_list.push(fetch::resolve(st.url, u))
  }
  fc_prefetch_pictures(resolved_list)
  for u in list {
    if !st.pictures.contains(u) {
      st.pictures.set(u, fc_get_picture(fetch::resolve(st.url, u)).0)
    }
  }
  assets_dirty.v = true
  load_images_of(st.doc)
  for f in frames {
    let base = if f.url.starts_with("about:") { st.url } else { f.url }
    load_images_of(f.doc, base=base)
  }
  touch()
  true
}

///|
/// The @font-face rules `fetch_fonts_ahead` last started the files of (and how many there were then).
let fonts_ahead_for : Ref[(Array[css::FontFace], Int)] = Ref::{ v: ([], 0) }

///|
/// The font files `fetch_fonts_ahead` started for this page: those not taken by its layout let go of when it is left.
let fonts_ahead : Array[String] = []

///|
/// The most font files started ahead for a page (a CJK family's unicode-range parts are left to come when drawn).
let fonts_ahead_max : Int = 24

fn fetch_fonts_ahead(faces : Array[css::FontFace]) -> Unit {
  if fonts_ahead_for.v.1 == faces.length() && faces.length() > 0 {
    return
  }
  fonts_ahead_for.v = (faces, faces.length())
  let urls : Array[String] = []
  for f in faces {
    if fonts_ahead.length() + urls.length() >= fonts_ahead_max {
      break
    }
    if !f.covers('a'.to_int()) {
      continue
    }
    if f.src.length() > 0 {
      let u = f.src[0]
      if (u.starts_with("http://") || u.starts_with("https://")) &&
      !font_files.contains(u) &&
      !arr_has_str(fonts_ahead, u) &&
      !arr_has_str(urls, u) {
        urls.push(u)
      }
    }
  }
  if urls.length() == 0 {
    return
  }
  for u in urls {
    fonts_ahead.push(u)
  }
  fc_fetch_ahead(urls)
}

///|
/// What a document will fetch (scripts, style sheets, pictures), got ahead together over parallel connections: one at
/// a time, a page waited for each in turn.
fn prefetch_for(doc : html::Node, sheets_only~ : Bool = false) -> Unit {
  fc_prefetch(subresources(doc, sheets_only=sheets_only, pictures=false))
  // (its pictures asked for as pictures: get_picture's Accept)
  if !sheets_only && eager_pictures.v {
    fc_prefetch_pictures(subresources(doc, pictures_only=true))
  }
}

///|
/// What a document's style sheets, scripts and the files it says it will need (modulepreload; preload as a script, a
/// style or a font) are, resolved; and with `pictures` its eager pictures; `sheets_only` its style sheets alone;
/// `pictures_only` its eager pictures alone.
fn subresources(
  doc : html::Node,
  sheets_only~ : Bool = false,
  pictures~ : Bool = true,
  pictures_only~ : Bool = false,
) -> Array[String] {
  let urls : Array[String] = []
  let base = doc_base_url(doc, st.url)
  let walk = [doc]
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.ns == html::Ns::Html {
      let want = match n.tag {
        "img" if !sheets_only && (pictures || pictures_only) =>
        if n.src_url is None && eager_pictures.v { image_source(n, base) } else { None }
        _ if pictures_only => None
        "script" if !sheets_only => n.attr("src")
        "link" => {
          let rel = ascii_lower(n.attr("rel").unwrap_or(""))
          let as_attr = ascii_lower(n.attr("as").unwrap_or(""))
          let script = !sheets_only &&
          (rel.contains("modulepreload") ||
            (rel.contains("preload") && (as_attr == "script" || as_attr == "style" || as_attr == "font")))
          if rel.contains("stylesheet") || script {
            n.attr("href")
          } else {
            None
          }
        }
        _ => None
      }
      match want {
        Some(u) if u != "" && !u.starts_with("data:") => {
          let full = fetch::resolve(base, u)
          if !st.pictures.contains(full) && !st.sheets.contains(full) {
            urls.push(full)
          }
        }
        _ => ()
      }
    }
    for c in n.children {
      walk.push(c)
    }
  }
  urls
}

///|
/// Changes to a picture, a source or a picture element (an attribute, a state): what `load_images` looks at besides
/// the tree.
let image_changes : Ref[Int] = Ref::{ v: 0 }

///|
/// A blob: picture the page has not made yet (it is asked for again at the next layout).
let images_unsettled : Ref[Bool] = Ref::{ v: false }

///|
/// What each document's pictures were last worked out for, by its uid: the tree's changes (`html::tree_changes`),
/// the pictures' own (`image_changes`), the pictures fetched, the viewport (a srcset's sizes, a source's media), the
/// base and whether pictures are fetched at once.
let images_done_for : intmap::IntMap[(Int, Int, Int, Double, Double, String, Bool)] = intmap::IntMap::new()

///|
/// `load_images` of a document, unless nothing it looks at changed since: each forced layout walked every element of
/// the page and of each frame for its pictures (NewsSite: 50 µs a layout, after each change of a class).
fn load_images_of(doc : html::Node, base~ : String = st.url) -> Unit {
  let base = doc_base_url(doc, base)
  let tc = html::tree_changes_count()
  let ic = image_changes.v
  let plen = st.pictures.length()
  match intmap::get(images_done_for, doc.uid) {
    Some(prev) if prev.0 == tc && prev.1 == ic && prev.2 == plen && prev.3 == st.w && prev.4 == st.h && prev.5 == base && prev.6 == eager_pictures.v =>
    return
    _ => ()
  }
  images_unsettled.v = false
  load_images(doc, base=base)
  if images_unsettled.v {
    ignore(images_done_for.delete(doc.uid))
    return
  }
  if images_done_for.len() > 64 {
    images_done_for.clear()
  }
  images_done_for.set(
    doc.uid,
    (
      html::tree_changes_count(),
      image_changes.v,
      st.pictures.length(),
      st.w,
      st.h,
      base,
      eager_pictures.v,
    ),
  )
}

///|
fn load_images(n : html::Node, base~ : String = st.url) -> Unit {
  if n.kind == html::Kind::Element && n.tag == "img" && n.ns == html::Ns::Html {
    let choice = image_choice(n, base, st.w)
    let density = match choice {
      Some((_, d)) if d > 0.0 => d
      _ => 1.0
    }
    let src_opt = match choice {
      Some((s, _)) => Some(s)
      None => None
    }
    match src_opt {
      Some(src) if src != "" => {
        let key = base + soh_str() + src
        let u = match resolved_srcs.get(key) {
          Some(u) => u
          None => {
            let u = fetch::resolve(base, src)
            if resolved_srcs.length() >= 10000 {
              resolved_srcs.clear()
            }
            resolved_srcs.set(key, u)
            u
          }
        }
        // another picture picked (a script changed its srcset, the viewport its sizes): its own size
        if n.src_url is Some(old) && old != u && !is_gif_frame_key_for(old, u) {
          n.natural = None
          boxes_changed(n)
        }
        // a data: picture's bytes are its address's (an icon's SVG percent-encoded or as it is): no fetch, and ready now
        if u.starts_with("data:") && !st.pictures.contains(u) {
          st.pictures.set(u, data_url(u).unwrap_or(Bytes::new(0)))
        }
        // a blob: picture is the page's own bytes, held by its script: no fetch, and ready now
        if u.starts_with("blob:") && !st.pictures.contains(u) {
          match blob_bytes(u) {
            Some(body) => st.pictures.set(u, body)
            None => images_unsettled.v = true
          }
        }
        if !st.pictures.contains(u) && !eager_pictures.v {
          // drawn without it first; it comes after (fetch_pending)
          if !arr_has_str(pending, u) {
            pending.push(u)
          }
        } else if !st.pictures.contains(u) {
          let (body, _) = fc_get_picture(u)
          st.pictures.set(u, body)
        }
        let mut effective_u = u
        if st.pictures.contains(u) {
          let body = st.pictures[u]
          if n.natural is None {
            match picture_size(u, body) {
              Some((w, h)) => {
                if raster::is_svg_bytes(body) && !raster::svg_has_intrinsic_size(body) && w > 0 && h > 0 {
                  n.natural = Some((-1.0, h.to_double() / w.to_double()))
                } else {
                  n.natural = Some((w.to_double() / density, h.to_double() / density))
                }
                boxes_changed(n)
              }
              None => ()
            }
          }
          match register_animated_gif(u, body, id_of(n)) {
            Some(gif_key) => effective_u = gif_key
            None => ()
          }
        }
        n.src_url = Some(effective_u)
      }
      _ => ()
    }
  } else if n.kind == html::Kind::Element && n.tag == "video" && n.ns == html::Ns::Html && (n.src_url is None || n.natural is None) {
    match n.attr("poster") {
      Some(raw_poster) => {
        let poster = raw_poster.trim()
        if poster != "" {
          let u = fetch::resolve(base, poster)
          if u.starts_with("data:") && !st.pictures.contains(u) {
            st.pictures.set(u, data_url(u).unwrap_or(Bytes::new(0)))
          } else if u.starts_with("blob:") && !st.pictures.contains(u) {
            match blob_bytes(u) {
              Some(body) => st.pictures.set(u, body)
              None => images_unsettled.v = true
            }
          } else if !st.pictures.contains(u) && !eager_pictures.v {
            if !arr_has_str(pending, u) {
              pending.push(u)
            }
          } else if !st.pictures.contains(u) {
            let (body, _) = fc_get_picture(u)
            st.pictures.set(u, body)
          }
          if n.natural is None && st.pictures.contains(u) {
            match picture_size(u, st.pictures[u]) {
              Some((w, h)) => {
                n.natural = Some((w.to_double(), h.to_double()))
                boxes_changed(n)
              }
              None => ()
            }
          }
          if n.src_url is None { n.src_url = Some(u) }
        }
      }
      None => ()
    }
  } else if n.kind == html::Kind::Element && n.tag == "image" && n.ns == html::Ns::Svg {
    let (_, raw_href0) = svg_href_attr(n)
    let raw_href = raw_href0.trim()
    if raw_href != "" && !raw_href.starts_with("data:") && !raw_href.starts_with("#") {
      let u = fetch::resolve(base, raw_href)
      if !st.pictures.contains(u) {
        if !eager_pictures.v {
          if !arr_has_str(pending, u) {
            pending.push(u)
          }
        } else {
          let (body, _) = fc_get_picture(u)
          st.pictures.set(u, body)
        }
      }
    }
  }
  let children = n.children
  let cn = children.length()
  let mut ci = 0
  while ci < cn {
    let c = children[ci]
    if c.kind != html::Kind::Text && c.kind != html::Kind::Comment {
      if c.children.length() > 0 || c.tag == "img" || c.tag == "video" || c.tag == "image" {
        load_images(c, base=base)
      }
    }
    ci += 1
  }
}

///|
/// A picture's size in pixels, from its bytes, worked out once for the bytes a URL has (each new <img> of a picture
/// asked again, and a size is a whole decode of its pixels).
fn picture_size(u : String, data : Bytes) -> Option[(Int, Int)] {
  match picture_sizes.get(u) {
    Some((d, size)) if (d.length() == data.length()) => size
    _ => {
      let size = raster_size_of(data)
      picture_sizes.set(u, (data, size))
      size
    }
  }
}

///|
/// The pictures' addresses `load_images` resolved, by base and src.
let resolved_srcs : Map[String, String] = Map::new()

///|
/// The sizes `picture_size` worked out, by URL, with the bytes they are of.
let picture_sizes : Map[String, (Bytes, Option[(Int, Int)])] = Map::new()

///|
/// A blob: URL's bytes, from the global that made it: this one, else the page's or a frame's (a frame shows what its
/// parent made for it, as Proton's message pictures).
fn blob_bytes(u : String) -> Option[Bytes] {
  let ask = "typeof __blobBase64 === 'function' ? __blobBase64(" + js_string(u) + ") : ''"
  let b64 : Ref[String] = Ref::{ v: js::run(ask) }
  if b64.v == "" {
    let ctxs = [0]
    for f in frames {
      if f.ctx >= 0 {
        ctxs.push(f.ctx)
      }
    }
    for c in ctxs {
      if c != cur_ctx.v && b64.v == "" {
        in_context(c, fn() { b64.v = js::run(ask) })
      }
    }
  }
  if b64.v == "" {
    None
  } else {
    data_url("data:;base64," + b64.v)
  }
}

///|
/// The pictures boxes paint with (background and mask images): fetched once, and their sizes.
fn box_pictures(root : layout::Box, svgs : intmap::IntMap[String]) -> Map[String, (Double, Double)] {
  let sizes : Map[String, (Double, Double)] = Map::new()
  // Uncached non-data URLs collected during the single walk so eager_pictures can prefetch them in parallel.
  let need_fetch : Array[String] = []
  let need_resolved : Array[String] = []
  let urgent_bg : Array[String] = []
  let bg_props = [css::p_background_image, css::p_mask_image, css::p__webkit_mask_image]
  let tc = html::tree_changes_count()
  let svg_cache_ok = svg_keys_tc.v == tc
  // (each box with the opacity it is drawn at, its ancestors' too, as painting has it)
  let walk = [(root, 1.0)]
  while walk.pop() is Some((b, a0)) {
    let op_toks = b.style.get_id(css::p_opacity)
    let mut op_val = if op_toks.length() > 0 {
      match op_toks[0] {
        css::Tok::Number(v) => v
        css::Tok::Percentage(v) => v / 100.0
        _ => 1.0
      }
    } else {
      1.0
    }
    if op_val < 1.0 {
      let an_toks = b.style.get_id(css::p_animation_name)
      if an_toks.length() > 0 {
        match st.engine {
          Some(eng) => {
            let mut anims_opacity = false
            for t in an_toks {
              match t {
                css::Tok::Ident(nm) if ascii_lower(nm) != "none" =>
                match eng.keyframes_named(nm) {
                  Some(kfs) => {
                    for kf in kfs {
                      for d in kf.decls {
                        if d.name == "opacity" {
                          anims_opacity = true
                          break
                        }
                      }
                      if anims_opacity { break }
                    }
                  }
                  None => ()
                }
                _ => ()
              }
              if anims_opacity { break }
            }
            if anims_opacity {
              op_val = 1.0
            }
          }
          None => ()
        }
      }
    }
    let alpha = a0 * op_val
    // a checked checkbox's tick
    if b.node is Some(n) && n.tag == "input" && !st.pictures.contains(fvpaint::check_mark_key) &&
    ascii_lower(n.attr("type").unwrap_or("")) == "checkbox" {
      st.pictures.set(fvpaint::check_mark_key, utf8_encode(fvpaint::check_mark_svg))
    }
    // an svg <img> under opacity: the picture drawn at it, as a picture of its own (the display list has no opacity for
    // a picture; Proton's done checklist item's icon is at half)
    match b.node {
      Some(n) if n.tag == "img" && alpha < 1.0 =>
      match n.src_url {
        Some(u) =>
        match st.pictures.get(u) {
          Some(data) => {
            let text = utf8_decode_lossy(data)
            match str_find(text, "<svg") {
              Some(i) if alpha > 0.0 => {
                let key = "fv-alpha:\{alpha}:" + u
                if !st.pictures.contains(key) {
                  let at = i + 4
                  st.pictures.set(key, utf8_encode(text.slice(0, at) + " opacity=\"\{alpha}\"" + text.slice(at, text.length())))
                }
                svgs.set(n.layout_id, key)
              }
              _ => ()
            }
          }
          None => ()
        }
        None => ()
      }
      _ => ()
    }
    match b.node {
      Some(n) if n.tag == "svg" && n.ns == html::Ns::Svg => {
        let mut reused_svg = false
        if svg_cache_ok {
          match intmap::get(svg_keys.v, n.uid) {
            Some((_was, key, wa)) if wa == alpha && st.pictures.contains(key) => {
              svgs.set(n.layout_id, key)
              svg_kept.set(n.uid, (b, key, alpha))
              reused_svg = true
            }
            _ => ()
          }
        }
        if !reused_svg {
          let ov_vis = b.style.word_id(css::p_overflow_x) == "visible" || b.style.word_id(css::p_overflow_y) == "visible"
          let mut old_vb : Option[String] = None
          let mut old_w : Option[String] = None
          let mut old_h : Option[String] = None
          if ov_vis {
            match layout::svg_overflow_viewbox(n) {
              Some((_, _, vw, vh, ex0, ey0, ew, eh)) => {
                for a in n.attrs {
                  let qn = a.qname()
                  if qn == "viewBox" {
                    old_vb = Some(a.value)
                    a.value = "\{ex0} \{ey0} \{ew} \{eh}"
                  } else if qn == "width" && vw > 0.0 {
                    let wt = a.value.trim()
                    if wt != "" && !wt.contains("%") && !wt.contains("em") && !wt.contains("ex") && !wt.contains("ch") {
                      let wv = css::parse_double(wt)
                      if wv > 0.0 {
                        old_w = Some(a.value)
                        a.value = (wv * ew / vw).to_string()
                      }
                    }
                  } else if qn == "height" && vh > 0.0 {
                    let ht = a.value.trim()
                    if ht != "" && !ht.contains("%") && !ht.contains("em") && !ht.contains("ex") && !ht.contains("ch") {
                      let hv = css::parse_double(ht)
                      if hv > 0.0 {
                        old_h = Some(a.value)
                        a.value = (hv * eh / vh).to_string()
                      }
                    }
                  }
                }
              }
              None => ()
            }
          }
          let text = svg_markup(n, alpha, box_w=b.w, box_h=b.h)
          if old_vb.is_some() || old_w.is_some() || old_h.is_some() {
            for a in n.attrs {
              let qn = a.qname()
              if qn == "viewBox" {
                match old_vb {
                  Some(orig) => a.value = orig
                  None => ()
                }
              } else if qn == "width" {
                match old_w {
                  Some(orig) => a.value = orig
                  None => ()
                }
              } else if qn == "height" {
                match old_h {
                  Some(orig) => a.value = orig
                  None => ()
                }
              }
            }
          }
          let mut h = 5381
          let bs = text.to_bytes()
          let mut bi = 0
          while bi < bs.length() {
            h = h * 33 + (bs[bi].to_int() & 0xFF)
            bi += 1
          }
          let key = "fv-svg:" + h.to_string() + ":" + text.length().to_string()
          svgs.set(n.layout_id, key)
          svg_kept.set(n.uid, (b, key, alpha))
          if !st.pictures.contains(key) {
            let src = if text.contains("xmlns=") { text } else { str_replace_all(text, "<svg", "<svg xmlns=\"http://www.w3.org/2000/svg\"") }
            st.pictures.set(key, utf8_encode(src))
          }
        }
      }
      _ => ()
    }
    for pid in bg_props {
      for u in b.style.urls_id(pid) {
        if sizes.contains(u) {
          continue
        }
        if !st.pictures.contains(u) {
          if u.starts_with("data:") {
            st.pictures.set(u, data_url(u).unwrap_or(Bytes::new(0)))
          } else if !eager_pictures.v {
            if b.y < st.h + 200.0 {
              if !arr_has_str(urgent_bg, u) {
                urgent_bg.push(u)
              }
            } else if !arr_has_str(pending, u) {
              pending.push(u)
            }
            continue
          } else {
            need_fetch.push(u)
            need_resolved.push(fetch::resolve(st.url, u))
            continue
          }
        }
        match picture_size(u, st.pictures[u]) {
          Some((w, h)) => sizes[u] = (w.to_double(), h.to_double())
          None => sizes[u] = (0.0, 0.0)
        }
      }
    }
    let mut ci = b.children.length() - 1
    while ci >= 0 {
      walk.push((b.children[ci], alpha))
      ci -= 1
    }
  }
  if urgent_bg.length() > 0 {
    let old_pending : Array[String] = []
    for u in pending {
      if !arr_has_str(urgent_bg, u) {
        old_pending.push(u)
      }
    }
    pending.clear()
    for u in urgent_bg {
      pending.push(u)
    }
    for u in old_pending {
      pending.push(u)
    }
  }
  if need_fetch.length() > 0 {
    fc_prefetch_pictures(need_resolved)
    for i, u in need_fetch {
      if sizes.contains(u) {
        continue
      }
      if !st.pictures.contains(u) {
        st.pictures.set(u, fc_get_picture(need_resolved[i]).0)
      }
      match picture_size(u, st.pictures.get(u).unwrap_or(Bytes::new(0))) {
        Some((w, h)) => sizes.set(u, (w.to_double(), h.to_double()))
        None => sizes.set(u, (0.0, 0.0))
      }
    }
  }
  svg_keys.v = svg_kept
  svg_keys_tc.v = tc
  sizes
}

///|
/// Each inline <svg>'s picture key by its node, with the box it was made for (see box_pictures).
let svg_keys : Ref[intmap::IntMap[(layout::Box, String, Double)]] = Ref::{ v: intmap::IntMap::new() }
let svg_keys_tc : Ref[Int] = Ref::{ v: -1 }

///|
let svg_kept : intmap::IntMap[(layout::Box, String, Double)] = intmap::IntMap::new()

///|
pub fn pictures() -> Map[String, Bytes] {
  st.pictures
}

///|
/// The nodes changed since the last layout (an attribute, the children, the text), and whether a change not at a node
/// was made: a layout whose boxes are the same is kept only when none of its boxes' nodes changed.
let changed_nodes : intmap::IntMap[Bool] = intmap::IntMap::new()

///|
let changed_whole : Ref[Bool] = Ref::{ v: false }

///|
/// The page's boxes to make again from (see layout::Reuse): made anew with each page.
let box_reuse : Ref[layout::Reuse] = Ref::{ v: layout::Reuse::new() }

///|
/// FV_RENDER: a runner with no client renders the frames a display would show (after each animation frame's
/// callbacks: host op 104).
let render_frames : Bool = env_has("FV_RENDER")

///|
/// FV_CHECK_PAINT: each frame's drawing checked against one made from nothing.
let check_paint : Bool = env_has("FV_CHECK_PAINT")

///|
/// FV_CHECK_LAYOUT: each layout checked against one made from nothing.
let check_layout : Bool = env_has("FV_CHECK_LAYOUT")

///|
/// FV_CHECK_MATCH: the kept matches checked against matching anew.
let check_match : Bool = env_has("FV_CHECK_MATCH")

///|
/// FV_PROF: the document's elements.
fn prof_elements() -> Int {
  let walk = [st.doc]
  let mut k = 0
  while walk.pop() is Some(x) {
    if x.kind == html::Kind::Element {
      k += 1
    }
    for c in x.children {
      walk.push(c)
    }
    match x.get_shadow() {
      Some(r) => walk.push(r)
      None => ()
    }
  }
  k
}

///|
/// FV_PROF: how many times the sheets' engine was made afresh.
let engines_made : Ref[Int] = Ref::{ v: 0 }

///|
/// The engine and font language the last layout was made with.
let laid_with : Ref[(css::Engine, String)] = Ref::{ v: (css::Engine::new({ width: 0.0, height: 0.0 , media: "screen", dpr: css::media_dpr() }), "") }

///|
fn ensure_layout() -> Unit {
  if !st.dirty && st.root is Some(_) {
    return
  }
  st.dirty = false
  css::set_container_size_hook(fn(uid : Int) -> Option[(Double, Double)] { intmap::get(cq_sizes.v, uid) })
  layouts.v += 1
  let t0 = now_ms()
  let phases : Array[String] = []
  let last_mark = Ref::{ v: fetch::now_us() }
  let mark = fn(name : String) -> Unit {
    phases.push("\{name} \{now_ms() - t0}")
    if fcache.prof {
      let now = fetch::now_us()
      let sp = name.split(" ")
      add_phase(if sp.length() > 0 { sp[0] } else { name }, now - last_mark.v)
      last_mark.v = now
    }
  }
  if trace.v {
    println("layout \{layouts.v} rss \{fetch::rss_mb()}")
  }
  if !main_dirty.v && !changed_whole.v && st.root is Some(old) {
    changed_nodes.clear()
    frame_roots.v = layout_frames(old)
    mark("frames alone")
    st.styles.clear()
    layout_ms.v += (now_ms() - t0).to_int64()
    return
  }
  prefetch_for(st.doc, sheets_only=true)
  mark("sheets")
  css::reset_ancestor_keys()
  load_images_of(st.doc)
  mark("images")
  ensure_style()
  mark("style")
  let engine = match st.engine {
    Some(e) => e
    None => return
  }
  let mut root_lang = ""
  for c in st.doc.children {
    if c.kind == html::Kind::Element && c.tag == "html" {
      root_lang = c.attr("lang").unwrap_or("")
      break
    }
  }
  st.fonts.set_lang(root_lang)
  fetch_fonts_ahead(engine.font_faces())
  st.fonts.set_web(
    engine.font_faces(),
    fn(u : String) -> Option[Bytes] {
      if u.starts_with("data:") {
        match data_url(u) {
          Some(b) if b.length() > 0 => return Some(b)
          _ => return None
        }
      }
      let (body, _) = fc_get(u)
      if body.length() > 0 {
        font_files.set(u, body)
        Some(body)
      } else {
        None
      }
    },
    engine.feature_values(),
  )
  mark("fonts")
  match st.root {
    Some(old) if !page_touched.v &&
    !changed_whole.v &&
    frame_roots.v.len() > 0 &&
    st.fonts.lang == laid_with.v.1 => {
      main_dirty.v = false
      changed_nodes.clear()
      frame_roots.v = layout_frames(old)
      mark("frames alone")
      st.styles.clear()
      layout_ms.v += (now_ms() - t0).to_int64()
      return
    }
    _ => ()
  }
  page_touched.v = false
  let reuse_was = if fcache.prof { box_reuse.v.state() } else { "" }
  match layout::generate_with_reuse(st.doc, engine, Some(box_reuse.v)) {
    Some(root) => {
      mark("boxes")
      let fonts_lang = st.fonts.lang
      match st.root {
        Some(old) if !changed_whole.v &&
        fonts_lang == laid_with.v.1 &&
        frame_roots.v.len() == 0 &&
        layout::same_boxes(old, root, fn(n : html::Node) -> Bool { changed_nodes.contains(n.uid) }) => {
          mark("same boxes, kept")
          if fcache.prof {
            fetch::prof_line("prof kept the last layout (\{now_ms() - t0} ms): the same boxes; changed by " + dirtied_by.v)
          }
          main_dirty.v = false
          changed_nodes.clear()
          st.rects = None
          main_scroll_cache.v = None
          main_client_cache.v = None
          st.styles.clear()
          apply_web_anims_to_boxes(old)
          return
        }
        _ => ()
      }
      changed_nodes.clear()
      changed_whole.v = false
      main_dirty.v = false
      laid_with.v = (engine, fonts_lang)
      mark("taken \{box_reuse.v.taken_count()} (\{reuse_was})")
      box_reuse.v.fresh()
      layout::layout(root, st.fonts, st.w, st.h)
      mark("earlier layouts kept \{layout::get_earlier_kept()}")
      // FV_CHECK_LAYOUT: the same page made and laid out whole beside it, every box where it is (what took boxes and
      // layouts from before must land where a layout from nothing does)
      if check_layout {
        match layout::generate(st.doc, engine) {
          Some(whole) => {
            layout::layout(whole, st.fonts, st.w, st.h)
            let a = layout::rects(root)
            let b = layout::rects(whole)
            let off : Array[(Int, (Double, Double, Double, Double))] = []
            for k in b.keys() {
              match intmap::get(b, k) {
                Some(bv) => {
                  let eq = match intmap::get(a, k) {
                    Some(av) => av.0 == bv.0 && av.1 == bv.1 && av.2 == bv.2 && av.3 == bv.3
                    None => false
                  }
                  if !eq {
                    off.push((k, bv))
                  }
                }
                None => ()
              }
            }
            if off.length() > 0 || a.len() != b.len() {
              let first_parts : Array[String] = []
              let mut i = 0
              while i < off.length() && i < 3 {
                let (kid, r) = off[i]
                let (rx, ry, rw, rh) = r
                first_parts.push("\{kid}: (\{rx}, \{ry}, \{rw}, \{rh})")
                i += 1
              }
              let first = first_parts.join("; ") + " — " + (if off.length() > 0 { layout_path(off[0].0) } else { "" })
              st.errors.push("layout check: \{off.length()} of \{b.len()} boxes elsewhere (\{a.len()} laid out): " + first)
            }
          }
          None => ()
        }
      }
      mark("layout")
      frame_roots.v = layout_frames(root)
      mark("frames")
      if trace.v {
        println("laid out rss \{fetch::rss_mb()}")
      }
      st.root = Some(root)
      st.rects = None
      main_scroll_cache.v = None
      main_client_cache.v = None
      st.styles.clear()
      detect_transitions(root)
      apply_web_anims_to_boxes(root)
      // container queries were matched against the containers' sizes of the layout before: where those changed, the
      // page is styled and laid out again with these (a few times at most, as Chrome settles them in one pass)
      if engine.has_container_rules() {
        let sizes = layout::container_sizes(root)
        let mut same = sizes.len() == cq_sizes.v.len()
        if same {
          for k in sizes.keys() {
            match (intmap::get(sizes, k), intmap::get(cq_sizes.v, k)) {
              (Some(sv), Some(cv)) => if sv.0 != cv.0 || sv.1 != cv.1 { same = false; break }
              _ => { same = false; break }
            }
          }
        }
        if !same && cq_rounds.v < 3 {
          cq_sizes.v = sizes
          cq_rounds.v += 1
          engine.forget_all()
          changed_whole.v = true
          main_dirty.v = true
          box_reuse.v.drop_all()
          st.paint_kept.clear()
          st.last_hover_raw = ""
          st.styles.clear()
          st.dirty = true
          ensure_layout()
          cq_rounds.v -= 1
        }
      }
    }
    None => st.root = None
  }
}

///|
/// Something not in a frame's document changed since the page was last laid out (a node of the page's, of a shadow
/// tree, of none, or what is not known): its own boxes are made and laid out again, not only its frames'.
let page_touched : Ref[Bool] = Ref::{ v: true }

///|
/// Whether the main document itself needs style/layout (iframe-only mutations leave this false).
let main_dirty : Ref[Bool] = Ref::{ v: true }

///|
/// Whether an <iframe> element may have been added, removed, or changed src/srcdoc in the main document.
let iframes_dirty : Ref[Bool] = Ref::{ v: true }

///|
/// Cached scroll_sizes (cw, ch, sw, sh) by layout_id for the main document's current layout.
let main_scroll_cache : Ref[Option[intmap::IntMap[(Double, Double, Double, Double)]]] = Ref::{ v: None }
///|
/// Cached client_sizes (cw, ch) by layout_id for the main document's current layout (built once on first op43 b=1).
let main_client_cache : Ref[Option[intmap::IntMap[(Double, Double)]]] = Ref::{ v: None }

///|
/// Scan a moved subtree for iframe / sheet / image elements in one pass.
fn node_scan_dirty(m : html::Node) -> (Bool, Bool, Bool) {
  let mut has_iframe = false
  let mut has_sheet = false
  let mut has_image = false
  let walk = [m]
  while walk.pop() is Some(x) {
    if x.kind == html::Kind::Element {
      if x.tag == "iframe" {
        has_iframe = true
      } else if (x.tag == "style" || x.tag == "link") {
        has_sheet = true
      } else if (x.tag == "img" || x.tag == "source" || x.tag == "picture") {
        has_image = true
      }
      if has_iframe && has_sheet && has_image {
        return (true, true, true)
      }
    }
    for c in x.children {
      walk.push(c)
    }
    match x.get_shadow() {
      Some(r) => walk.push(r)
      None => ()
    }
  }
  (has_iframe, has_sheet, has_image)
}

///|
/// The containers' sizes container queries are matched against, and how deep a layout again for them is.
let cq_sizes : Ref[intmap::IntMap[(Double, Double)]] = Ref::{ v: intmap::IntMap::new() }

///|
let cq_rounds : Ref[Int] = Ref::{ v: 0 }

///|
/// A node changed: layouts and styles change with it only when it is in a document (the page's, or a frame's or one a
/// script made, which have styles too); a tree being built apart, a template's content, has none.
fn touch_at(
  n : html::Node,
  children_changed~ : Bool = false,
  attr~ : Option[(String, String)] = None,
  moved~ : Option[html::Node] = None,
  has_known~ : Bool = false,
  bulk_assets_checked~ : Bool = false,
) -> Unit {
  let top = tree_root(n)
  let in_doc = top.kind == html::Kind::Document
  // Detached node: cannot affect any shown layout; only forget cached matches if an engine already knows it.
  if !in_doc {
    if !n.ever_styled && n.children.length() == 0 {
      return
    }
    match st.engine {
      Some(e) if e.knows(n) => e.forget(n, children_changed, attr, moved, has_known)
      _ => ()
    }
    for f in frames {
      match f.engine {
        Some(e) if e.knows(n) => e.forget(n, children_changed, attr, moved, has_known)
        _ => ()
      }
    }
    layout::forget_in_shadow(n, children_changed, attr, moved, has_known)
    return
  }
  let is_main = ((top).uid == (st.doc).uid)
  let mut owner_frame : Option[Frame] = None
  if !is_main {
    for f in frames {
      if ((f.doc).uid == (top).uid) {
        owner_frame = Some(f)
        break
      }
    }
  }
  // A document not shown (DOMParser / createHTMLDocument): forget only if known, never dirty shown layouts.
  if !is_main && owner_frame is None {
    match st.engine {
      Some(e) if e.knows(n) => e.forget(n, children_changed, attr, moved, has_known)
      _ => ()
    }
    layout::forget_in_shadow(n, children_changed, attr, moved, has_known)
    return
  }
  // Purely custom/metadata attribute (data-*, aria-*, title, tabindex, role, etc.) not referenced by any CSS rule
  // in the owning document or any shadow tree cannot affect style or layout: skip dirtying.
  let attr_kl = match attr {
    Some((k, _)) => ascii_lower(k)
    None => ""
  }
  if !children_changed && moved is None && attr_kl != "" {
    let non_visual_attr = attr_kl.starts_with("data-") ||
    attr_kl.starts_with("aria-") ||
    (attr_kl == "title" || attr_kl == "tabindex" || attr_kl == "role" || attr_kl == "autocomplete" || attr_kl == "spellcheck" || attr_kl == "draggable" || attr_kl == "nonce" || attr_kl == "referrerpolicy" || attr_kl == "decoding" || attr_kl == "fetchpriority")
    if non_visual_attr {
      let engine = if is_main {
        st.engine
      } else {
        match owner_frame {
          Some(f) => f.engine
          None => None
        }
      }
      let inline_attr_fn = match n.attr("style") {
        Some(sv) => ascii_lower(sv).contains("attr(")
        None => false
      }
      if !inline_attr_fn && engine is Some(e) && !e.asks_attr(attr_kl) && !layout::shadow_asks_attr(attr_kl) {
        return
      }
    }
  }
  if n.ns == html::Ns::Svg {
    svg_keys_tc.v = -1
  }
  let mut touched_image = n.kind == html::Kind::Element && (n.tag == "img" || n.tag == "source" || n.tag == "picture")
  let parent_is_style = match n.parent {
    Some(p) => p.kind == html::Kind::Element && p.tag == "style"
    None => false
  }
  let mut touched_sheet = (n.kind == html::Kind::Element && (n.tag == "style" || n.tag == "link")) || parent_is_style
  let mut touched_iframe = n.kind == html::Kind::Element && n.tag == "iframe"
  if moved is Some(m) && m.kind != html::Kind::Text {
    let (hi, hs, himg) = node_scan_dirty(m)
    if hi {
      touched_iframe = true
    }
    if hs {
      touched_sheet = true
    }
    if himg {
      touched_image = true
    }
  } else if children_changed && moved is None {
    touched_iframe = true
    touched_sheet = true
    touched_image = true
  }
  if touched_image {
    image_changes.v += 1
    assets_dirty.v = true
  }
  if touched_sheet {
    sheet_changes.v += 1
    assets_dirty.v = true
  }
  // Track whether this mutation could affect inline SVGs or image/font/sheet assets for DocClient fast path.
  let parent_is_svg = match n.parent {
    Some(p) => p.ns == html::Ns::Svg
    None => false
  }
  if n.ns == html::Ns::Svg || (n.kind == html::Kind::Element && n.tag == "svg") || parent_is_svg {
    svg_dirty.v = true
  } else if n.kind == html::Kind::Element {
    if (n.tag == "canvas" || n.tag == "iframe") {
      assets_dirty.v = true
    }
    if attr_kl != "" {
      if (attr_kl == "style" || attr_kl == "class" || attr_kl == "src" || attr_kl == "srcset" || attr_kl == "href" ||
        (n.tag == "link" && (attr_kl == "media" || attr_kl == "rel" || attr_kl == "disabled"))) {
        assets_dirty.v = true
        if cached_el_pics.v.length() > 0 {
          svg_dirty.v = true
        }
      }
    }
    match moved {
      Some(m) if m.kind != html::Kind::Text => {
        let (ms, ma) = node_has_svg_or_asset(m)
        if ms {
          svg_dirty.v = true
        }
        if ma {
          assets_dirty.v = true
        }
      }
      None if children_changed && !bulk_assets_checked => {
        // bulk child change (e.g. innerHTML)
        svg_dirty.v = true
        assets_dirty.v = true
      }
      _ => ()
    }
  }
  // a style sheet (or a preloaded script, style or font) a script puts in or points elsewhere: started as it does, not
  // when a layout comes to need it (a sign-in page's own sheet came 0.3 s into a layout that waited on it)
  if n.kind == html::Kind::Element && n.tag == "link" && n.ns == html::Ns::Html {
    let rel = ascii_lower(n.attr("rel").unwrap_or(""))
    let as_attr = ascii_lower(n.attr("as").unwrap_or(""))
    let wanted = rel.contains("stylesheet") ||
    (rel.contains("preload") && (as_attr == "script" || as_attr == "style" || as_attr == "font"))
    match n.attr("href") {
      Some(h) if wanted && h != "" && !h.starts_with("data:") => fc_fetch_ahead([fetch::resolve(st.url, h)])
      _ => ()
    }
  }
  match moved {
    Some(l) if l.kind == html::Kind::Element && l.tag == "link" && l.ns == html::Ns::Html => {
      let rel = ascii_lower(l.attr("rel").unwrap_or(""))
      let as_attr = ascii_lower(l.attr("as").unwrap_or(""))
      let wanted = rel.contains("stylesheet") ||
      (rel.contains("preload") && (as_attr == "script" || as_attr == "style" || as_attr == "font"))
      match l.attr("href") {
        Some(h) if wanted && h != "" && !h.starts_with("data:") => fc_fetch_ahead([fetch::resolve(st.url, h)])
        _ => ()
      }
    }
    _ => ()
  }
  if is_main {
    page_touched.v = true
    main_dirty.v = true
    main_scroll_cache.v = None
    main_client_cache.v = None
    if touched_iframe {
      iframes_dirty.v = true
    }
    match st.engine {
      Some(e) => e.forget(n, children_changed, attr, moved, has_known)
      None => ()
    }
    layout::forget_in_shadow(n, children_changed, attr, moved, has_known)
    if layout::touches_style(n, children_changed, moved) {
      layout::style_changed()
    }
    changed_nodes.set(n.uid, true)
    nodes_touched.v += 1
    box_reuse.v.changed(n)
    if fcache.prof && touched_log.length() < 12 {
      let cls = n.attr("class").unwrap_or("")
      touched_log.push(
        "<\{n.tag}.\{cls.slice(0, imin(cls.length(), 24))}>" +
        (match attr {
          Some((k, v)) => " \{k}=\{v.slice(0, imin(v.length(), 30))}"
          None => if children_changed { " kids" } else { "" }
        }),
      )
    }
    if !st.dirty || st.style_ok {
      if fcache.prof && !st.dirty {
        let attrs : Array[String] = []
        for x in n.attrs {
          attrs.push(x.name + "=" + x.value.slice(0, imin(x.value.length(), 30)))
        }
        let ptag = match n.parent { Some(p) => p.tag; None => "" }
        dirtied_by.v = "op \{last_op.v} on <\{n.tag} " + attrs.join(" ") + "> in <" + ptag + ">"
      }
      mark_changed()
    }
  } else if owner_frame is Some(f) {
    f.dirty = true
    f.rects = None
    f.scroll_cache = None
    f.client_cache = None
    if touched_sheet {
      f.sheets_dirty = true
    }
    if touched_image {
      f.images_dirty = true
    }
    match f.engine {
      Some(e) => e.forget(n, children_changed, attr, moved, has_known)
      None => ()
    }
    layout::forget_in_shadow(n, children_changed, attr, moved, has_known)
    if layout::touches_style(n, children_changed, moved) {
      layout::style_changed()
    }
    nodes_touched.v += 1
    f.reuse.changed(n)
    if fcache.prof && touched_log.length() < 12 {
      let cls = n.attr("class").unwrap_or("")
      touched_log.push(
        "<\{n.tag}.\{cls.slice(0, imin(cls.length(), 24))}>" +
        (match attr {
          Some((k, v)) => " \{k}=\{v.slice(0, imin(v.length(), 30))}"
          None => if children_changed { " kids" } else { "" }
        }),
      )
    }
    if fcache.prof && !st.dirty {
      let attrs : Array[String] = []
      for x in n.attrs {
        attrs.push(x.name + "=" + x.value.slice(0, imin(x.value.length(), 30)))
      }
      let ptag = match n.parent { Some(p) => p.tag; None => "" }
      dirtied_by.v = "op \{last_op.v} on <\{n.tag} " + attrs.join(" ") + "> in <" + ptag + ">"
    }
    // Only mark st.dirty + frame_due; leave main_dirty and st.style_ok untouched!
    st.dirty = true
    frame_due.v = true
  }
}

///|
/// (FV_CHECK_LAYOUT) The element of a box's layout id and its ancestors, with the ways each is positioned and shown.
fn layout_path(id : Int) -> String {
  let walk = [st.doc]
  while walk.pop() is Some(x) {
    if x.layout_id == id {
      let parts : Array[String] = []
      let mut cur : Option[html::Node] = Some(x)
      while cur is Some(c) && parts.length() < 12 {
        if c.kind == html::Element {
          let cls = c.attr("class").unwrap_or("")
          parts.push("<\{c.tag}.\{cls.slice(0, imin(cls.length(), 30))}> \{computed(c, "display")} \{computed(c, "position")}")
        }
        cur = c.parent
      }
      return parts.join(" < ")
    }
    for c in x.children {
      walk.push(c)
    }
    match x.get_shadow() {
      Some(r) => walk.push(r)
      None => ()
    }
  }
  "?"
}

///|
/// (FV_PROF) The first changes since the last layout: what each was at.
let touched_log : Array[String] = []

///|
/// The laid-out boxes a node's measures come from: its frame's when it is in a frame's document, the page's otherwise
/// (only the needed document is laid out when the main document is already clean).
fn root_for(n : html::Node) -> Option[layout::Box] {
  let top = tree_root(n)
  if ((top).uid == (st.doc).uid) {
    if main_dirty.v || st.root is None {
      ensure_layout()
    }
    return st.root
  }
  for f in frames {
    if ((f.doc).uid == (top).uid) {
      if main_dirty.v || st.root is None {
        ensure_layout()
      }
      if f.dirty || f.root is None {
        layouts.v += 1
        match st.root {
          Some(r) => layout_one_frame(r, f) |> ignore
          None => ()
        }
      }
      return f.root
    }
  }
  ensure_layout()
  st.root
}

///|
/// Cached scroll_sizes / fast client_sizes for `n` (op 43).
fn scroll_sizes_of(n : html::Node, client_only~ : Bool = false) -> Option[(Double, Double, Double, Double)] {
  let top = tree_root(n)
  if !((top).uid == (st.doc).uid) {
    for f in frames {
      if ((f.doc).uid == (top).uid) {
        if main_dirty.v || st.root is None {
          ensure_layout()
        } else if f.dirty || f.root is None {
          layouts.v += 1
          match st.root {
            Some(r) => layout_one_frame(r, f) |> ignore
            None => ()
          }
        }
        guard f.root is Some(fr) else { return None }
        if !client_only {
          match f.scroll_cache {
            Some(m) =>
            match intmap::get(m, n.layout_id) {
              Some(v) => return Some(v)
              None => ()
            }
            None => ()
          }
        }
        if client_only {
          let cm = match f.client_cache {
            Some(m) => m
            None => {
              let m = layout::client_sizes(fr)
              f.client_cache = Some(m)
              m
            }
          }
          match intmap::get(cm, n.layout_id) {
            Some((cw, ch)) => return Some((cw, ch, 0.0, 0.0))
            None => return None
          }
        }
        let r = layout::scroll_sizes(fr, n)
        match r {
          Some(v) => {
            let m = match f.scroll_cache {
              Some(m) => m
              None => {
                let m : intmap::IntMap[(Double, Double, Double, Double)] = intmap::IntMap::new()
                f.scroll_cache = Some(m)
                m
              }
            }
            m.set(n.layout_id, v)
          }
          None => ()
        }
        return r
      }
    }
  }
  if main_dirty.v || st.root is None {
    ensure_layout()
  }
  guard st.root is Some(root) else { return None }
  if !client_only {
    match main_scroll_cache.v {
      Some(m) =>
      match intmap::get(m, n.layout_id) {
        Some(v) => return Some(v)
        None => ()
      }
      None => ()
    }
  }
  if client_only {
    let cm = match main_client_cache.v {
      Some(m) => m
      None => {
        let m = layout::client_sizes(root)
        main_client_cache.v = Some(m)
        m
      }
    }
    match intmap::get(cm, n.layout_id) {
      Some((cw, ch)) => return Some((cw, ch, 0.0, 0.0))
      None => return None
    }
  }
  let r = layout::scroll_sizes(root, n)
  match r {
    Some(v) => {
      let m = match main_scroll_cache.v {
        Some(m) => m
        None => {
          let m : intmap::IntMap[(Double, Double, Double, Double)] = intmap::IntMap::new()
          main_scroll_cache.v = Some(m)
          m
        }
      }
      m.set(n.layout_id, v)
    }
    None => ()
  }
  r
}

fn svg_foreign_text(n : html::Node) -> String {
  let sb = StringBuilder::new()
  let walk : Array[html::Node] = [n]
  let mut prev_ws = true
  while walk.length() > 0 {
    let cur = walk[walk.length() - 1]
    let _ = walk.pop()
    if cur.kind == html::Kind::Text {
      let s = cur.data
      let mut i = 0
      while i < s.length() {
        let cu = s.code_unit_at(i).to_int()
        let is_ws = cu == 0x20 || cu == 0x09 || cu == 0x0A || cu == 0x0D
        if is_ws {
          if !prev_ws {
            sb.write_char(' ')
            prev_ws = true
          }
        } else {
          sb.write_string(s.slice(i, i + 1))
          prev_ws = false
        }
        i += 1
      }
    } else if cur.kind == html::Kind::Element && cur.tag != "style" && cur.tag != "script" {
      let mut ci = cur.children.length() - 1
      while ci >= 0 {
        walk.push(cur.children[ci])
        ci -= 1
      }
    }
  }
  sb.to_string().trim()
}

fn foreign_object_rect(n : html::Node) -> Option[(Double, Double, Double, Double)] {
  let mut in_fo = n.kind == html::Kind::Element && n.tag == "foreignObject" && n.ns == html::Ns::Svg
  let mut p = n.parent
  while !in_fo {
    match p {
      Some(par) => {
        if par.kind == html::Kind::Element && par.tag == "foreignObject" && par.ns == html::Ns::Svg {
          in_fo = true
          break
        }
        p = par.parent
      }
      None => break
    }
  }
  if !in_fo {
    return None
  }
  let txt = svg_foreign_text(n)
  if txt == "" {
    return Some((0.0, 0.0, 0.0, 0.0))
  }
  let fs0 = css::parse_double(computed(n, "font-size"))
  let fs = if fs0 > 0.0 { fs0 } else { 16.0 }
  let lh_s = computed(n, "line-height").trim()
  let lh = if lh_s.ends_with("px") {
    let v = css::parse_double(lh_s)
    if v > 0.0 { v } else { fs * 1.5 }
  } else {
    let v = css::parse_double(lh_s)
    if v > 0.0 { v * fs } else { fs * 1.5 }
  }
  let mw_s = computed(n, "max-width").trim()
  let max_w = if mw_s.ends_with("px") { css::parse_double(mw_s) } else { 0.0 }
  let ws = computed(n, "white-space").trim()
  let measured = st.fonts.width(0, fs, txt)
  let raw_w = if measured > 0.0 { measured } else { txt.length().to_double() * fs * 0.58 }
  if max_w > 0.0 && raw_w > max_w && ws != "nowrap" {
    let lines = (raw_w / max_w).ceil()
    Some((0.0, 0.0, max_w, lines * lh))
  } else {
    Some((0.0, 0.0, raw_w + 4.0, lh))
  }
}

///|
/// An element's box in the page as getBoundingClientRect has it (before the scroll), the page laid out first.
fn rect_of(n : html::Node) -> Option[(Double, Double, Double, Double)] {
  // an element of a frame's document: its box in the frame's viewport, as the frame's scripts measure it (Proton
  // sizes a message's iframe by its content's height)
  let top = tree_root(n)
  if !((top).uid == (st.doc).uid) {
    for f in frames {
      if ((f.doc).uid == (top).uid) {
        if main_dirty.v || st.root is None {
          ensure_layout()
        } else if f.dirty || f.root is None {
          layouts.v += 1
          match st.root {
            Some(r) => layout_one_frame(r, f) |> ignore
            None => ()
          }
        }
        guard f.root is Some(fr) else { return None }
        if f.rects is None {
          if rect_down(fr, n) is Some(r) {
            return Some(r)
          }
          if n.kind == html::Kind::Element && layout::box_of(fr, n).is_none() {
            return None
          }
        }
        let m = match f.rects {
          Some(m) => m
          None => {
            let m = layout::rects(fr)
            f.rects = Some(m)
            m
          }
        }
        return intmap::get(m, n.layout_id)
      }
    }
  }
  if main_dirty.v || st.root is None {
    ensure_layout()
  }
  match st.root {
    Some(root) => {
      if st.rects is None && rect_down(root, n) is Some(r) {
        return Some(r)
      }
      let m = match st.rects {
        Some(m) => m
        None => {
          let m = layout::rects(root)
          st.rects = Some(m)
          m
        }
      }
      match intmap::get(m, n.layout_id) {
        Some(r) => Some(r)
        None => foreign_object_rect(n)
      }
    }
    None => None
  }
}

///|
/// One element's box found through its ancestors' boxes alone (`layout::rect_down`); with FV_CHECK_LAYOUT, checked
/// against the whole map.
fn rect_down(root : layout::Box, n : html::Node) -> Option[(Double, Double, Double, Double)] {
  let r = layout::rect_down(root, n)
  if check_layout {
    match r {
      Some(rv) => {
        let whole = intmap::get(layout::rects(root), n.layout_id)
        let eq = match whole {
          Some(wv) => wv.0 == rv.0 && wv.1 == rv.1 && wv.2 == rv.2 && wv.3 == rv.3
          None => false
        }
        if !eq {
          println("rect check: <\{n.tag}> #\{n.layout_id} mismatch")
        }
      }
      None => ()
    }
  }
  r
}

///|
/// A node's topmost ancestor (itself when it has none).
fn top_ancestor(n : html::Node) -> html::Node {
  let mut cur = n
  while cur.parent is Some(p) {
    cur = p
  }
  cur
}

///|
/// Whether the sheets that style `n` (its document's, or any shadow tree's) ask about any of these element states.
fn states_asked(n : html::Node, bits : Int) -> Bool {
  let top = tree_root(n)
  // (a node in no document: what any engine kept of it is forgotten, as for any change to it)
  if top.kind != html::Kind::Document || layout::shadow_asks_states(bits) {
    return true
  }
  if top.uid == st.doc.uid {
    return match st.engine {
      Some(e) => e.asks_states(bits)
      None => false
    }
  }
  for f in frames {
    if f.doc.uid == top.uid {
      return match f.engine {
        Some(e) => e.asks_states(bits)
        None => false
      }
    }
  }
  true
}

///|
/// The tree a node is in: its topmost ancestor, through shadow roots' hosts.
fn tree_root(n : html::Node) -> html::Node {
  let mut cur = n
  while true {
    match cur.parent {
      Some(p) => cur = p
      None =>
      match cur.get_host() {
        Some(h) => cur = h
        None => return cur
      }
    }
  }
  cur
}

///|
/// Whether a node is in a document (the page's, a frame's, one a script made): what is not is a tree being built or
/// kept apart, which a script reaches only through the nodes of it that it holds.
fn in_any_document(n : html::Node) -> Bool {
  tree_root(n).kind == html::Kind::Document
}

///|
/// Whether `r` is the root of a document shown: the page's or a frame's. Another tree (one built apart, a document a
/// script made, a frame's once its iframe is gone) is reached by scripts only through the nodes of it they hold.
fn shown_root(r : html::Node) -> Bool {
  if r.kind != html::Kind::Document {
    return false
  }
  if ((r).uid == (st.doc).uid) {
    return true
  }
  for f in frames {
    if ((f.doc).uid == (r).uid) {
      return true
    }
  }
  false
}

let loose_sb : StringBuilder = StringBuilder::new()

fn discard_detached_child(c : html::Node) -> Unit {
  if c.kind == html::Kind::Text || c.kind == html::Kind::Comment {
    c.parent = None
    if c.js_id != 0 && !c.is_of_template() {
      note_loose_subtree(c)
    }
    return
  }
  c.parent = None
  if c.children.length() == 0 {
    match c.rare {
      None => {
        if c.js_id != 0 {
          note_loose_subtree(c)
        }
        return
      }
      Some(r) =>
      if r.shadow is None && r.template_content is None {
        if c.js_id != 0 && !r.of_template {
          note_loose_subtree(c)
        }
        return
      }
    }
  }
  if !c.is_of_template() && !html::held_in(c) {
    html::cut_detached(c)
  } else {
    note_loose_subtree(c)
  }
}

struct LooseEmitState {
  mut emitted : Int
  mut tree_started : Bool
  mut tree_count : Int
  mut has_template : Bool
  mut has_other_ctx : Bool
  mut has_shared_ctx : Bool
}

let loose_emit : LooseEmitState = LooseEmitState::{ emitted: 0, tree_started: false, tree_count: 0, has_template: false, has_other_ctx: false, has_shared_ctx: false }

fn id_visible_to_cur_ctx(id : Int) -> Bool {
  id > 0 && (id >= id_owner_ctx.length() || id_owner_ctx[id] == cur_ctx.v || id_owner_ctx[id] == -1)
}

let comma_int_str_1000 : Array[String] = {
  let arr : Array[String] = Array::make(1000, "")
  let mut i = 0
  while i < 1000 {
    arr[i] = "," + i.to_string()
    i += 1
  }
  arr
}

fn loose_emit_held(id : Int) -> Unit {
  loose_emit.tree_count += 1
  if !loose_emit.tree_started {
    if loose_emit.emitted > 0 {
      loose_sb.write_byte(b';')
    }
    sb_write_int(loose_sb, id)
    loose_emit.emitted += 1
    loose_emit.tree_started = true
  } else if id >= 0 && id < 1000000 {
    if id < 1000 {
      loose_sb.write_string(comma_int_str_1000[id])
    } else {
      loose_sb.write_string(comma_int_str_1000[id / 1000])
      loose_sb.write_string(int_pad3_1000[id % 1000])
    }
  } else {
    loose_sb.write_byte(b',')
    sb_write_int(loose_sb, id)
  }
}

fn loose_emit_subtree_ctx(x : html::Node, ctx : Int, ctx_len : Int) -> Unit {
  let children = x.children
  let n = children.length()
  let mut i = 0
  while i < n {
    let c = children[i]
    if c.has_template_content() {
      loose_emit.has_template = true
    }
    let cid = c.js_id
    if cid > 0 {
      if cid >= ctx_len || id_owner_ctx[cid] == ctx || id_owner_ctx[cid] < 0 {
        loose_emit_held(cid)
      } else {
        loose_emit.has_other_ctx = true
      }
    }
    if c.children.length() > 0 || c.has_shadow() {
      loose_emit_subtree_ctx(c, ctx, ctx_len)
    }
    i = i + 1
  }
  match x.get_shadow() {
    Some(sh) => {
      let sid = sh.js_id
      if sid > 0 {
        if sid >= ctx_len || id_owner_ctx[sid] == ctx || id_owner_ctx[sid] < 0 {
          loose_emit_held(sid)
        } else {
          loose_emit.has_other_ctx = true
        }
      }
      if sh.children.length() > 0 || sh.has_shadow() {
        loose_emit_subtree_ctx(sh, ctx, ctx_len)
      }
    }
    None => ()
  }
}

fn loose_emit_subtree(x : html::Node) -> Unit {
  loose_emit_subtree_ctx(x, cur_ctx.v, id_owner_ctx.length())
}

fn loose_visit_root(uid : Int) -> Unit {
  match intmap::get(loose_roots, uid) {
    None => ()
    Some(r) => {
      if r.parent is Some(_) || r.has_host() || (r.kind == html::Kind::Document && shown_root(r)) {
        loose_roots.erase(uid)
        swept_loose_roots.erase(uid)
        swept_held_count.erase(uid)
        return
      }
      if r.children.length() == 0 && !r.has_shadow() {
        if r.js_id > 0 {
          if id_visible_to_cur_ctx(r.js_id) {
            if loose_emit.emitted > 0 {
              loose_sb.write_byte(b';')
            }
            sb_write_int(loose_sb, r.js_id)
            loose_emit.emitted += 1
            swept_loose_roots.set(uid, true)
            if !r.has_template_content() {
              swept_held_count.set(uid, 1)
            } else {
              swept_held_count.erase(uid)
            }
          } else {
            dirty_loose_roots.set(uid, r)
          }
        } else {
          loose_roots.erase(uid)
          swept_loose_roots.erase(uid)
          swept_held_count.erase(uid)
        }
        return
      }
      loose_emit.tree_started = false
      loose_emit.tree_count = 0
      loose_emit.has_template = r.has_template_content()
      loose_emit.has_other_ctx = false
      if r.js_id > 0 {
        if id_visible_to_cur_ctx(r.js_id) {
          loose_emit_held(r.js_id)
        } else {
          loose_emit.has_other_ctx = true
        }
      }
      loose_emit_subtree(r)
      if !loose_emit.tree_started {
        if !loose_emit.has_other_ctx {
          loose_roots.erase(uid)
          swept_loose_roots.erase(uid)
          swept_held_count.erase(uid)
          if !r.is_of_template() {
            html::cut_detached(r)
          }
        } else {
          dirty_loose_roots.set(uid, r)
        }
      } else {
        swept_loose_roots.set(uid, true)
        if loose_emit.has_other_ctx {
          dirty_loose_roots.set(uid, r)
          swept_held_count.erase(uid)
        } else if !loose_emit.has_template && loose_emit.tree_count > 0 {
          swept_held_count.set(uid, loose_emit.tree_count)
        } else {
          swept_held_count.erase(uid)
        }
      }
    }
  }
}

fn reap_ctx_subtree_len(x : html::Node, dead_ctx : Int, ctx_len : Int) -> Bool {
  let mut keep = false
  let xid = x.js_id
  if xid > 0 {
    if xid < ctx_len && id_owner_ctx[xid] == dead_ctx {
      x.js_id = 0
      st.nodes[xid] = None
      id_owner_ctx[xid] = 0
      free_ids.push(xid)
    } else {
      keep = true
    }
  }
  let children = x.children
  let n = children.length()
  let mut i = 0
  while i < n {
    let c = children[i]
    if c.children.length() == 0 && c.rare is None {
      let cid = c.js_id
      if cid > 0 {
        if cid < ctx_len && id_owner_ctx[cid] == dead_ctx {
          c.js_id = 0
          st.nodes[cid] = None
          id_owner_ctx[cid] = 0
          free_ids.push(cid)
        } else {
          keep = true
        }
      }
    } else if reap_ctx_subtree_len(c, dead_ctx, ctx_len) {
      keep = true
    }
    i = i + 1
  }
  match x.rare {
    Some(r) => {
      match r.shadow {
        Some(sh) =>
        if reap_ctx_subtree_len(sh, dead_ctx, ctx_len) {
          keep = true
        }
        None => ()
      }
      match r.template_content {
        Some(tc) =>
        if reap_ctx_subtree_len(tc, dead_ctx, ctx_len) {
          keep = true
        }
        None => ()
      }
    }
    None => ()
  }
  keep
}

fn reap_ctx_subtree(x : html::Node, dead_ctx : Int) -> Bool {
  reap_ctx_subtree_len(x, dead_ctx, id_owner_ctx.length())
}

fn reap_and_cut_single_ctx(x : html::Node, dead_ctx : Int, ctx_len : Int) -> Unit {
  let xid = x.js_id
  if xid > 0 && xid < ctx_len && id_owner_ctx[xid] == dead_ctx {
    x.js_id = 0
    st.nodes[xid] = None
    id_owner_ctx[xid] = 0
    free_ids.push(xid)
  }
  let children = x.children
  let n = children.length()
  let mut i = 0
  while i < n {
    let c = children[i]
    if c.children.length() == 0 && c.rare is None {
      let cid = c.js_id
      if cid > 0 && cid < ctx_len && id_owner_ctx[cid] == dead_ctx {
        c.js_id = 0
        st.nodes[cid] = None
        id_owner_ctx[cid] = 0
        free_ids.push(cid)
      }
      c.parent = None
    } else {
      reap_and_cut_single_ctx(c, dead_ctx, ctx_len)
    }
    i = i + 1
  }
  if n > 0 { x.clear_children() }
  if x.parent is Some(_) { x.parent = None }
  match x.rare {
    Some(r) => {
      if r.host is Some(_) { r.host = None }
      match r.shadow {
        Some(sh) => {
          r.shadow = None
          reap_and_cut_single_ctx(sh, dead_ctx, ctx_len)
        }
        None => ()
      }
      match r.template_content {
        Some(tc) => {
          r.template_content = None
          reap_and_cut_single_ctx(tc, dead_ctx, ctx_len)
        }
        None => ()
      }
    }
    None => ()
  }
}

fn reap_dead_ctx_loose_roots(dead_ctx : Int) -> Unit {
  if loose_roots.len() == 0 {
    return
  }
  let ctx_len = id_owner_ctx.length()
  let uids = loose_roots.keys()
  for uid in uids {
    match intmap::get(loose_roots, uid) {
      None => ()
      Some(r) =>
      if r.parent is Some(_) || r.has_host() || (r.kind == html::Kind::Document && shown_root(r)) {
        loose_roots.erase(uid)
        dirty_loose_roots.erase(uid)
        swept_loose_roots.erase(uid)
        swept_held_count.erase(uid)
        loose_root_ctx.erase(uid)
      } else {
        match intmap::get(loose_root_ctx, uid) {
          Some(owner) if owner >= 0 =>
          if owner != dead_ctx {
            continue
          } else if !r.is_of_template() {
            loose_roots.erase(uid)
            if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(uid) }
            if swept_loose_roots.len() > 0 { swept_loose_roots.erase(uid) }
            if swept_held_count.len() > 0 { swept_held_count.erase(uid) }
            loose_root_ctx.erase(uid)
            reap_and_cut_single_ctx(r, dead_ctx, ctx_len)
            continue
          }
          _ => ()
        }
        if !cross_ctx_seen.v && !r.is_of_template() && r.js_id > 0 && r.js_id < ctx_len {
          let rowner = id_owner_ctx[r.js_id]
          if rowner >= 0 {
            if rowner != dead_ctx {
              continue
            }
            loose_roots.erase(uid)
            if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(uid) }
            if swept_loose_roots.len() > 0 { swept_loose_roots.erase(uid) }
            if swept_held_count.len() > 0 { swept_held_count.erase(uid) }
            if loose_root_ctx.len() > 0 { loose_root_ctx.erase(uid) }
            reap_and_cut_single_ctx(r, dead_ctx, ctx_len)
            continue
          }
        }
        if r.children.length() == 0 && !r.has_shadow() && !r.has_template_content() {
          let rid = r.js_id
          let keep_leaf = if rid > 0 {
            if rid < ctx_len && id_owner_ctx[rid] == dead_ctx {
              r.js_id = 0
              st.nodes[rid] = None
              id_owner_ctx[rid] = 0
              free_ids.push(rid)
              false
            } else {
              true
            }
          } else {
            false
          }
          if !keep_leaf {
            loose_roots.erase(uid)
            if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(uid) }
            if swept_loose_roots.len() > 0 { swept_loose_roots.erase(uid) }
            if swept_held_count.len() > 0 { swept_held_count.erase(uid) }
            if loose_root_ctx.len() > 0 { loose_root_ctx.erase(uid) }
          } else {
            if swept_held_count.len() > 0 { swept_held_count.erase(uid) }
            if loose_root_ctx.len() > 0 { loose_root_ctx.erase(uid) }
          }
          continue
        }
        if !reap_ctx_subtree_len(r, dead_ctx, ctx_len) {
          loose_roots.erase(uid)
          dirty_loose_roots.erase(uid)
          swept_loose_roots.erase(uid)
          swept_held_count.erase(uid)
          loose_root_ctx.erase(uid)
          if !r.is_of_template() {
            html::cut_detached(r)
          }
        } else {
          swept_held_count.erase(uid)
          loose_root_ctx.erase(uid)
        }
      }
    }
  }
}

///|
/// The nodes scripts hold by id that are in no document, grouped by the tree each is in: a script holding any node of
/// such a tree can reach all of it.
/// Protocol prefix: "F" = full scan (when a loose subtree reattached/merged), "I" = incremental delta (dirty roots only).
fn loose_trees() -> String {
  if loose_full_needed.v {
    loose_full_needed.v = false
    dirty_loose_roots.clear()
    if loose_roots.len() == 0 {
      return "F"
    }
    loose_sb.reset()
    loose_sb.write_byte(b'F')
    loose_emit.emitted = 0
    let root_uids = loose_roots.keys()
    for uid in root_uids {
      loose_visit_root(uid)
    }
    let out = loose_sb.to_string()
    loose_sb.reset()
    return out
  }
  if dirty_loose_roots.len() == 0 {
    return "I"
  }
  loose_sb.reset()
  loose_sb.write_byte(b'I')
  loose_emit.emitted = 0
  let root_uids = dirty_loose_roots.keys()
  dirty_loose_roots.clear()
  for uid in root_uids {
    loose_visit_root(uid)
  }
  let out = loose_sb.to_string()
  loose_sb.reset()
  out
}

struct LooseIntBufState {
  mut pos : Int
  mut cap : Int
  mut overflow : Bool
}

let loose_ib : LooseIntBufState = { pos: 0, cap: 0, overflow: false }

fn loose_ib_emit_held(id : Int, ibp : Ptr) -> Unit {
  if loose_ib.overflow {
    return
  }
  loose_emit.tree_count += 1
  if !loose_emit.tree_started {
    if loose_emit.emitted > 0 {
      if loose_ib.pos + 2 > loose_ib.cap {
        loose_ib.overflow = true
        return
      }
      ptr_write_i32(ibp, (loose_ib.pos * 4).to_int64(), -1)
      loose_ib.pos += 1
    } else if loose_ib.pos + 1 > loose_ib.cap {
      loose_ib.overflow = true
      return
    }
    ptr_write_i32(ibp, (loose_ib.pos * 4).to_int64(), id)
    loose_ib.pos += 1
    loose_emit.emitted += 1
    loose_emit.tree_started = true
  } else {
    if loose_ib.pos + 1 > loose_ib.cap {
      loose_ib.overflow = true
      return
    }
    ptr_write_i32(ibp, (loose_ib.pos * 4).to_int64(), id)
    loose_ib.pos += 1
  }
}

fn loose_ib_emit_subtree_ctx(x : html::Node, ctx : Int, ctx_len : Int, ctxs : Array[Int], ibp : Ptr) -> Unit {
  let children = x.children
  let n = children.length()
  let mut i = 0
  while i < n {
    let c = children[i]
    let cid = c.js_id
    if cid > 0 {
      let own = if cid < ctx_len { ctxs[cid] } else { ctx }
      if own == ctx || own < 0 {
        if own < 0 { loose_emit.has_shared_ctx = true }
        if loose_emit.tree_started {
          let pos = loose_ib.pos
          if pos + 1 > loose_ib.cap {
            loose_ib.overflow = true
            return
          }
          ptr_write_i32(ibp, (pos * 4).to_int64(), cid)
          loose_ib.pos = pos + 1
          loose_emit.emitted += 1
          loose_emit.tree_count += 1
        } else {
          loose_ib_emit_held(cid, ibp)
          if loose_ib.overflow {
            return
          }
        }
      } else {
        loose_emit.has_other_ctx = true
      }
    }
    if c.kind != html::Kind::Text && c.kind != html::Kind::Comment {
      if c.has_template_content() {
        loose_emit.has_template = true
      }
      let cn = c.children.length()
      if cn == 1 && !c.has_shadow() {
        let gc = c.children[0]
        if gc.kind == html::Kind::Text || (gc.children.length() == 0 && (gc.rare is None || (!gc.has_shadow() && !gc.has_template_content()))) {
          let gcid = gc.js_id
          if gcid > 0 {
            let own = if gcid < ctx_len { ctxs[gcid] } else { ctx }
            if own == ctx || own < 0 {
              if own < 0 { loose_emit.has_shared_ctx = true }
              if loose_emit.tree_started {
                let pos = loose_ib.pos
                if pos + 1 > loose_ib.cap {
                  loose_ib.overflow = true
                  return
                }
                ptr_write_i32(ibp, (pos * 4).to_int64(), gcid)
                loose_ib.pos = pos + 1
                loose_emit.emitted += 1
                loose_emit.tree_count += 1
              } else {
                loose_ib_emit_held(gcid, ibp)
                if loose_ib.overflow {
                  return
                }
              }
            } else {
              loose_emit.has_other_ctx = true
            }
          }
          i = i + 1
          continue
        }
      }
      if cn > 0 || c.has_shadow() {
        loose_ib_emit_subtree_ctx(c, ctx, ctx_len, ctxs, ibp)
        if loose_ib.overflow {
          return
        }
      }
    }
    i = i + 1
  }
  match x.get_shadow() {
    Some(sh) => {
      if loose_ib.overflow {
        return
      }
      let sid = sh.js_id
      if sid > 0 {
        if sid >= ctx_len || ctxs[sid] == ctx || ctxs[sid] < 0 {
          loose_ib_emit_held(sid, ibp)
        } else {
          loose_emit.has_other_ctx = true
        }
      }
      if sh.children.length() > 0 || sh.has_shadow() {
        loose_ib_emit_subtree_ctx(sh, ctx, ctx_len, ctxs, ibp)
      }
    }
    None => ()
  }
}

fn loose_ib_visit_root(uid : Int, ctx : Int, ctx_len : Int) -> Unit {
  if loose_ib.overflow {
    return
  }
  match intmap::get(loose_roots, uid) {
    None => ()
    Some(r) => {
      if r.parent is Some(_) || r.has_host() || (r.kind == html::Kind::Document && shown_root(r)) {
        loose_roots.erase(uid)
        swept_loose_roots.erase(uid)
        swept_held_count.erase(uid)
        loose_root_ctx.erase(uid)
        return
      }
      if loose_root_ctx.len() > 0 {
        match intmap::get(loose_root_ctx, uid) {
          Some(owner) if owner >= 0 && owner != ctx => {
            dirty_loose_roots.set(uid, r)
            return
          }
          _ => ()
        }
      }
      if r.children.length() == 0 && !r.has_shadow() {
        let rid = r.js_id
        if rid > 0 {
          let own = if rid < ctx_len { id_owner_ctx[rid] } else { ctx }
          if own == ctx || own < 0 {
            let ibp = js::intbuf_ptr()
            if loose_emit.emitted > 0 {
              if loose_ib.pos + 2 > loose_ib.cap {
                loose_ib.overflow = true
                return
              }
              ptr_write_i32(ibp, (loose_ib.pos * 4).to_int64(), -1)
              loose_ib.pos += 1
            } else if loose_ib.pos + 1 > loose_ib.cap {
              loose_ib.overflow = true
              return
            }
            ptr_write_i32(ibp, (loose_ib.pos * 4).to_int64(), rid)
            loose_ib.pos += 1
            loose_emit.emitted += 1
            swept_loose_roots.set(uid, true)
            if own >= 0 { loose_root_ctx.set(uid, own) } else { loose_root_ctx.erase(uid) }
            if !r.has_template_content() {
              swept_held_count.set(uid, 1)
            } else {
              swept_held_count.erase(uid)
            }
          } else {
            loose_root_ctx.set(uid, own)
            dirty_loose_roots.set(uid, r)
          }
        } else {
          loose_roots.erase(uid)
          swept_loose_roots.erase(uid)
          swept_held_count.erase(uid)
          loose_root_ctx.erase(uid)
        }
        return
      }
      loose_emit.tree_started = false
      loose_emit.tree_count = 0
      loose_emit.has_template = r.has_template_content()
      loose_emit.has_other_ctx = false
      loose_emit.has_shared_ctx = false
      let ibp = js::intbuf_ptr()
      let rid = r.js_id
      if rid > 0 {
        let own = if rid < ctx_len { id_owner_ctx[rid] } else { ctx }
        if own == ctx || own < 0 {
          if own < 0 { loose_emit.has_shared_ctx = true }
          loose_ib_emit_held(rid, ibp)
        } else {
          loose_emit.has_other_ctx = true
        }
      }
      loose_ib_emit_subtree_ctx(r, ctx, ctx_len, id_owner_ctx, ibp)
      if loose_ib.overflow {
        return
      }
      if !loose_emit.tree_started {
        if !loose_emit.has_other_ctx {
          loose_roots.erase(uid)
          swept_loose_roots.erase(uid)
          swept_held_count.erase(uid)
          loose_root_ctx.erase(uid)
          if !r.is_of_template() {
            html::cut_detached(r)
          }
        } else {
          dirty_loose_roots.set(uid, r)
        }
      } else {
        swept_loose_roots.set(uid, true)
        if loose_emit.has_other_ctx {
          dirty_loose_roots.set(uid, r)
          swept_held_count.erase(uid)
          loose_root_ctx.erase(uid)
        } else {
          if !loose_emit.has_shared_ctx && !loose_emit.has_template {
            loose_root_ctx.set(uid, ctx)
          } else {
            loose_root_ctx.erase(uid)
          }
          if !loose_emit.has_template && loose_emit.tree_count > 0 {
            swept_held_count.set(uid, loose_emit.tree_count)
          } else {
            swept_held_count.erase(uid)
          }
        }
      }
    }
  }
}

fn loose_trees_intbuf() -> Int {
  let cap = js::intbuf_cap()
  if cap < 4 {
    return -1
  }
  let ctx = cur_ctx.v
  let ctx_len = id_owner_ctx.length()
  if loose_full_needed.v {
    loose_full_needed.v = false
    dirty_loose_roots.clear()
    js::intbuf_set(0, 70)
    if loose_roots.len() == 0 {
      return 1
    }
    loose_ib.pos = 1
    loose_ib.cap = cap
    loose_ib.overflow = false
    loose_emit.emitted = 0
    let root_uids = loose_roots.keys()
    for uid in root_uids {
      loose_ib_visit_root(uid, ctx, ctx_len)
      if loose_ib.overflow {
        loose_full_needed.v = true
        return -1
      }
    }
    return loose_ib.pos
  }
  if dirty_loose_roots.len() == 0 {
    return 0
  }
  js::intbuf_set(0, 73)
  loose_ib.pos = 1
  loose_ib.cap = cap
  loose_ib.overflow = false
  loose_emit.emitted = 0
  let root_uids = dirty_loose_roots.keys()
  dirty_loose_roots.clear()
  for uid in root_uids {
    loose_ib_visit_root(uid, ctx, ctx_len)
    if loose_ib.overflow {
      loose_full_needed.v = true
      return -1
    }
  }
  loose_ib.pos
}

fn release_ids_from_intbuf(count : Int) -> Unit {
  let cap = js::intbuf_cap()
  let n = if count > cap { cap } else { count }
  if n <= 0 {
    return
  }
  let release_roots : Array[html::Node] = []
  release_root_counts.clear()
  let nodes = st.nodes
  let nlen = nodes.length()
  let ctxs = id_owner_ctx
  let ctx_len = ctxs.length()
  let fids = free_ids
  let has_loose = loose_roots.len() > 0
  let mut last_parent_uid = -1
  let mut last_parent_root : Option[html::Node] = None
  let mut last_root_uid = -1
  let mut last_root_cnt = 0
  let mut last_root_node : Option[html::Node] = None
  let ibp = js::intbuf_ptr()
  let mut idx = 0
  while idx < n {
    let i = ptr_read_i32(ibp, (idx * 4).to_int64())
    idx += 1
    if i >= 0 && i < nlen {
      match nodes[i] {
        Some(node) => {
          let mut fast_same_root = false
          match node.parent {
            Some(p) =>
            if p.uid == last_root_uid && last_root_cnt > 0 {
              fast_same_root = true
            } else if p.uid == last_parent_uid && last_root_cnt > 0 {
              match last_parent_root {
                Some(pr) if pr.uid == last_root_uid => fast_same_root = true
                _ => ()
              }
            }
            None => ()
          }
          if fast_same_root {
            node.js_id = 0
            nodes[i] = None
            if i < ctx_len {
              ctxs[i] = 0
            }
            fids.push(i)
            last_root_cnt += 1
            continue
          }
          let r = match node.parent {
            None => if !node.has_host() { node } else { tree_root(node) }
            Some(p) =>
            if p.uid == last_parent_uid {
              match last_parent_root {
                Some(pr) => pr
                None => tree_root(p)
              }
            } else {
              let pr = match p.parent {
                None => if !p.has_host() { p } else { tree_root(p) }
                Some(gp) => if gp.parent is None && !gp.has_host() { gp } else { tree_root(gp) }
              }
              last_parent_uid = p.uid
              last_parent_root = Some(pr)
              pr
            }
          }
          if r.kind != html::Document || !shown_root(r) {
            node.js_id = 0
            nodes[i] = None
            if i < ctx_len {
              ctxs[i] = 0
            }
            fids.push(i)
            if r.children.length() == 0 && (r.rare is None || (!r.has_shadow() && !r.has_template_content())) {
              if !r.is_of_template() && has_loose && loose_roots.contains(r.uid) {
                loose_roots.erase(r.uid)
                if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(r.uid) }
                if swept_loose_roots.len() > 0 { swept_loose_roots.erase(r.uid) }
                if loose_root_ctx.len() > 0 { loose_root_ctx.erase(r.uid) }
              }
            } else if r.uid == last_root_uid {
              last_root_cnt += 1
            } else {
              if last_root_cnt > 0 {
                let mut direct_cut = false
                match last_root_node {
                  Some(lr) =>
                  if lr.parent is None && !lr.has_host() && !lr.is_of_template() && lr.js_id == 0 {
                    match intmap::get(swept_held_count, last_root_uid) {
                      Some(prev_cnt) if prev_cnt <= last_root_cnt => {
                        swept_held_count.erase(last_root_uid)
                        if has_loose {
                          loose_roots.erase(last_root_uid)
                          if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(last_root_uid) }
                          if swept_loose_roots.len() > 0 { swept_loose_roots.erase(last_root_uid) }
                          if loose_root_ctx.len() > 0 { loose_root_ctx.erase(last_root_uid) }
                        }
                        html::cut_detached(lr)
                        direct_cut = true
                      }
                      _ => ()
                    }
                  }
                  None => ()
                }
                if !direct_cut {
                  match intmap::get(release_root_counts, last_root_uid) {
                    Some(cnt) => release_root_counts.set(last_root_uid, cnt + last_root_cnt)
                    None => {
                      release_root_counts.set(last_root_uid, last_root_cnt)
                      match last_root_node {
                        Some(lr) => release_roots.push(lr)
                        None => ()
                      }
                    }
                  }
                }
              }
              last_root_uid = r.uid
              last_root_cnt = 1
              last_root_node = Some(r)
            }
          }
        }
        None => ()
      }
    }
  }
  if last_root_cnt > 0 {
    let mut direct_cut = false
    match last_root_node {
      Some(lr) =>
      if lr.parent is None && !lr.has_host() && !lr.is_of_template() && lr.js_id == 0 {
        match intmap::get(swept_held_count, last_root_uid) {
          Some(prev_cnt) if prev_cnt <= last_root_cnt => {
            swept_held_count.erase(last_root_uid)
            if has_loose {
              loose_roots.erase(last_root_uid)
              if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(last_root_uid) }
              if swept_loose_roots.len() > 0 { swept_loose_roots.erase(last_root_uid) }
              if loose_root_ctx.len() > 0 { loose_root_ctx.erase(last_root_uid) }
            }
            html::cut_detached(lr)
            direct_cut = true
          }
          _ => ()
        }
      }
      None => ()
    }
    if !direct_cut {
      match intmap::get(release_root_counts, last_root_uid) {
        Some(cnt) => release_root_counts.set(last_root_uid, cnt + last_root_cnt)
        None => {
          release_root_counts.set(last_root_uid, last_root_cnt)
          match last_root_node {
            Some(lr) => release_roots.push(lr)
            None => ()
          }
        }
      }
    }
  }
  release_finish_roots(release_roots)
}

fn kids_to_intbuf(a : Int, b : Int) -> Int {
  let list = at(a).children
  let n = list.length()
  if n == 0 {
    return 0
  }
  let cap = js::intbuf_cap()
  let ibp = js::intbuf_ptr()
  if b == 1 {
    let mut cnt = 0
    let mut i = 0
    while i < n {
      let c = list[i]
      if c.kind == html::Kind::Element {
        let off = cnt * 2
        if off + 2 > cap {
          return -1
        }
        ptr_write_i32(ibp, (off * 4).to_int64(), id_of(c))
        ptr_write_i32(ibp, ((off + 1) * 4).to_int64(), el_kn(c))
        cnt += 1
      }
      i += 1
    }
    return cnt
  }
  if n > cap {
    return -1
  }
  let mut i = 0
  while i < n {
    ptr_write_i32(ibp, (i * 4).to_int64(), id_of(list[i]))
    i += 1
  }
  n
}

fn el_kn_to_intbuf(list : Array[html::Node]) -> String {
  let n = list.length()
  if n == 0 {
    return ""
  }
  let cap = js::intbuf_cap()
  if n * 2 > cap {
    return csv_with_kn(list)
  }
  let ibp = js::intbuf_ptr()
  let mut i = 0
  while i < n {
    let c = list[i]
    let off = i * 2
    ptr_write_i32(ibp, (off * 4).to_int64(), id_of(c))
    ptr_write_i32(ibp, ((off + 1) * 4).to_int64(), el_kn(c))
    i += 1
  }
  "I" + n.to_string()
}

fn query_star_kn_to_intbuf_walk(n : html::Node, pos : Ref[Int], cap : Int, in_loose : Bool, ibp : Ptr) -> Bool {
  let children = n.children
  let len = children.length()
  let mut i = 0
  while i < len {
    let c = children[i]
    if c.kind == html::Kind::Element {
      let off = pos.v
      if off + 2 > cap {
        return false
      }
      ptr_write_i32(ibp, (off * 4).to_int64(), if in_loose { id_of(c) } else { id_of_connected(c) })
      ptr_write_i32(ibp, ((off + 1) * 4).to_int64(), el_kn(c))
      pos.v = off + 2
      if c.children.length() > 0 {
        if !query_star_kn_to_intbuf_walk(c, pos, cap, in_loose, ibp) {
          return false
        }
      }
    }
    i += 1
  }
  true
}

fn query_star_kn_to_intbuf(from : html::Node) -> String {
  let cap = js::intbuf_cap()
  if cap < 2 {
    csv_sb.reset()
    star_csv_count.v = 0
    query_star_kn_to_csv_sb(from)
    let r = csv_sb.to_string()
    csv_sb.reset()
    return r
  }
  let in_loose = loose_roots.len() > 0 && loose_roots.contains(tree_root(from).uid)
  let pos : Ref[Int] = { v: 0 }
  if !query_star_kn_to_intbuf_walk(from, pos, cap, in_loose, js::intbuf_ptr()) {
    csv_sb.reset()
    star_csv_count.v = 0
    query_star_kn_to_csv_sb(from)
    let r = csv_sb.to_string()
    csv_sb.reset()
    return r
  }
  if pos.v == 0 {
    return ""
  }
  "I" + (pos.v / 2).to_string()
}

///|
/// The document changed: its layout and the styles kept are made again when next needed.
fn touch() -> Unit {
  layout::style_changed()
  // (a change not at one node: every element matches its rules again)
  match st.engine {
    Some(e) => e.forget_all()
    None => ()
  }
  for f in frames {
    match f.engine {
      Some(e) => e.forget_all()
      None => ()
    }
  }
  // (laid out again whatever the boxes: what changed is not known)
  changed_whole.v = true
  page_touched.v = true
  main_dirty.v = true
  iframes_dirty.v = true
  main_scroll_cache.v = None
  main_client_cache.v = None
  box_reuse.v.drop_all()
  st.paint_kept.clear()
  st.last_hover_raw = ""
  clear_attr_indices()
  for f in frames {
    f.reuse.drop_all()
    f.dirty = true
    f.sheets_dirty = true
    f.images_dirty = true
    f.rects = None
    f.scroll_cache = None
    f.client_cache = None
  }
  svg_dirty.v = true
  assets_dirty.v = true
  mark_changed()
}

///|
/// The page is to be styled, laid out and sent again.
fn mark_changed() -> Unit {
  st.dirty = true
  st.style_ok = false
  frame_due.v = true
}

///|
/// Whether the page changed since the last frame was made: a script reading the layout lays it out again, but
/// what it changed is still to be sent.
let frame_due : Ref[Bool] = Ref::{ v: true }

///|
/// The engine for the document's sheets as they are now, made again only when they changed, and no styles kept from
/// before the document changed.
fn ensure_style() -> Unit {
  if st.style_ok && st.engine is Some(_) {
    return
  }
  st.style_ok = true
  st.styles.clear()
  let key = sheets_key()
  if st.engine is Some(_) && key == st.engine_key {
    return
  }
  st.engine_key = key
  // the page's sheets as they were with sheets after them: only those are added, the engine kept (a page adds sheets
  // as it loads, one for each part: GitHub's file page, 10 thousand elements, was restyled whole for each)
  let sheets = sheet_list()
  // (the very sheets the engine is of: kept)
  let mut same_sheets = sheets.length() == engine_sheets.v.length()
  if same_sheets {
    let mut si = 0
    while si < sheets.length() {
      if sheets[si] != engine_sheets.v[si] {
        same_sheets = false
        break
      }
      si += 1
    }
  }
  if st.engine is Some(_) && same_sheets {
    st.engine_key = key
    return
  }
  match (st.engine, inserted_sheets(engine_sheets.v, sheet_bases.v, sheets)) {
    (Some(e), Some((bases, inserted))) => {
      let top = e.rule_count()
      let _registered = e.registered_count()
      let ranges : Array[(Int, Int)] = []
      let ok : Ref[Bool] = Ref::{ v: true }
      add_sheets(st.doc, e, only=Some(inserted), added=ranges, ok=ok)
      let mut max_order = top
      for r in ranges {
        if r.1 > max_order {
          max_order = r.1
        }
      }
      e.set_order(max_order)
      if ok.v {
        e.forget_all()
        engine_sheets.v = sheets
        sheet_bases.v = bases
        return
      }
    }
    _ => ()
  }
  if fcache.prof {
    // (why: the first sheet that is not as it was, by its place and its start)
    let old = engine_sheets.v
    let mut i = 0
    while i < old.length() && i < sheets.length() && old[i] == sheets[i] {
      i += 1
    }
    let show = fn(a : Array[String]) {
      if i < a.length() {
        str_replace_all(a[i].slice(0, imin(a[i].length(), 100)), "\n", " ")
      } else {
        "(none)"
      }
    }
    fetch::prof_line("prof engine anew: \{old.length()} sheets then, \{sheets.length()} now; at \{i} was " + show(old) + " now " + show(sheets))
  }
  engine_sheets.v = sheets
  let new_bases : Array[Int] = []
  for si, _ in sheets {
    new_bases.push(si * sheet_gap)
  }
  sheet_bases.v = new_bases
  engines_made.v += 1
  let engine = css::Engine::new({ width: st.w, height: st.h, media: st.media, dpr: css::media_dpr() })
  // (a quirks mode document's sheets take unitless lengths and hashless colors; its style attributes too)
  engine.set_quirks(st.doc.is_quirks())
  if st.doc.is_quirks() {
    engine.add_ua_sheet(css::quirks_css())
  }
  add_sheets(st.doc, engine)
  if st.doc.data != "" {
    // (the document's adopted sheets after all its own, however many come between them later)
    engine.set_order(adopted_base)
    engine.add_sheet_resolve(st.doc.data, fn(u) { fetch::resolve(st.url, u) })
  }
  st.engine = Some(engine)
}

///|
let sheet_gap : Int = 65536

///|
let adopted_base : Int = 1000000000

///|
/// Each sheet's first order in the engine, as sheet_list lists them.
let sheet_bases : Ref[Array[Int]] = Ref::{ v: [] }

///|
/// Whether the page's sheets now are those the engine was made from with others put among them (none taken out,
/// none changed): the orders of all (the new ones' between their neighbours'), and the new ones by their place in the
/// list with the first order and the last each may take. None: the engine is made again.
fn inserted_sheets(old : Array[String], old_bases : Array[Int], now : Array[String]) -> Option[(Array[Int], intmap::IntMap[(Int, Int)])] {
  if old.length() == 0 || now.length() <= old.length() || old[0] != now[0] || old_bases.length() != old.length() {
    return None
  }
  let bases : Array[Int] = []
  for _ in 0..<now.length() {
    bases.push(-1)
  }
  let fresh : Array[Int] = []
  let mut i = 0
  for j, x in now {
    if i < old.length() && old[i] == x {
      bases[j] = old_bases[i]
      i += 1
    } else {
      fresh.push(j)
    }
  }
  if i != old.length() {
    return None
  }
  let inserted : intmap::IntMap[(Int, Int)] = intmap::IntMap::new()
  // each run of new sheets shares the room between the sheets around it
  let mut k = 0
  while k < fresh.length() {
    let mut end_ = k
    while end_ + 1 < fresh.length() && fresh[end_ + 1] == fresh[end_] + 1 {
      end_ += 1
    }
    let first = fresh[k]
    let last = fresh[end_]
    let lo = bases[first - 1]
    let hi = if last + 1 < now.length() { bases[last + 1] } else { lo + (end_ - k + 2) * sheet_gap }
    let step = (hi - lo) / (end_ - k + 2)
    if step < 4096 || hi >= adopted_base {
      return None
    }
    for m in 0..=(end_ - k) {
      let b = lo + step * (m + 1)
      bases[fresh[k + m]] = b
      inserted.set(fresh[k + m], (b, b + step))
    }
    k = end_ + 1
  }
  Some((bases, inserted))
}

///|
/// What the page's engine was made from, as sheet_list says it.
let engine_sheets : Ref[Array[String]] = Ref::{ v: [] }

///|
/// What the engine is made from, in order: the viewport, quirks, the address and the document's adopted sheets first,
/// then each sheet (a <style>'s text, a <link>'s address).
fn walk_sheet_list(n : html::Node, out : Array[String]) -> Unit {
  if n.kind == html::Kind::Element {
    if n.tag == "style" {
      out.push(
        (if css_style(n) { "css " } else { "off " }) +
        (match intmap::get(cssom_rules, n.js_id) {
          Some(t) if n.js_id != 0 => t
          _ => html::text_content(n)
        }),
      )
    } else if n.tag == "link" && ascii_lower(n.attr("rel").unwrap_or("")).contains("stylesheet") {
      let dis = if n.attr("disabled").is_some() { " dis" } else { "" }
      out.push("link " + n.attr("rel").unwrap_or("") + dis + " " + n.attr("media").unwrap_or("") + " " + n.attr("href").unwrap_or(""))
    }
  }
  for c in n.children {
    walk_sheet_list(c, out)
  }
}

fn sheet_list() -> Array[String] {
  let out = ["\{st.w}x\{st.h} \{st.doc.is_quirks()} " + sheets_url() + soh_str() + st.doc.data]
  walk_sheet_list(st.doc, out)
  out
}

///|
/// A hash of what the engine is made from: the viewport, quirks, each sheet (a <style>'s text, a <link>'s address)
/// in order.
fn sheets_key() -> Int64 {
  sheets_key_of()
}

///|
/// The address the sheets are of: the page's without its fragment (their URLs resolve against it, and a link to a
/// line, #L10, changes only the fragment; with it, each such link made the engine and every style again).
fn sheets_url() -> String {
  match str_find(st.url, "#") {
    Some(i) => st.url.slice(0, i)
    None => st.url
  }
}

///|
fn walk_sheets_key(n : html::Node, mix_fn : (String) -> Unit) -> Unit {
  if n.kind == html::Kind::Element {
    if n.tag == "style" {
      mix_fn(if css_style(n) { "css " } else { "off " })
      mix_fn(
        match intmap::get(cssom_rules, n.js_id) {
          Some(t) if n.js_id != 0 => t
          _ => html::text_content(n)
        },
      )
    } else if n.tag == "link" && ascii_lower(n.attr("rel").unwrap_or("")).contains("stylesheet") {
      let dis = if n.attr("disabled").is_some() { " dis" } else { "" }
      mix_fn("link " + n.attr("rel").unwrap_or("") + dis + " " + n.attr("media").unwrap_or("") + " " + n.attr("href").unwrap_or(""))
    }
  }
  for c in n.children {
    walk_sheets_key(c, mix_fn)
  }
}

fn sheets_key_of() -> Int64 {
  let h : Ref[Int64] = Ref::{ v: 1469598103934665603L }
  let mix_str = fn(s : String) -> Unit {
    let bs = s.to_bytes()
    let mut i = 0
    while i < bs.length() {
      h.v = (h.v ^ (bs[i].to_int() & 0xFF).to_int64()) * 1099511628211L
      i = i + 1
    }
    h.v = (h.v ^ 0xFFL) * 1099511628211L
  }
  mix_str("\{st.w}x\{st.h} \{st.doc.is_quirks()}")
  mix_str(sheets_url())
  mix_str(st.doc.data)
  walk_sheets_key(st.doc, mix_str)
  h.v
}

///|
fn run_scripts(n : html::Node, out : Array[html::Node]) -> Unit {
  if n.kind == html::Kind::Element && n.tag == "script" && n.ns == html::Ns::Html {
    out.push(n)
  }
  for c in n.children {
    run_scripts(c, out)
  }
}

///|
/// How deep the host's runs of scripts are, and how long the outermost took in all (their layouts included).
let run_depth : Ref[Int] = Ref::{ v: 0 }

///|
let script_ms : Ref[Int64] = Ref::{ v: 0L }

///|
let layout_ms : Ref[Int64] = Ref::{ v: 0L }

///|
/// (FV_PROF) The work of the layouts so far: how many, the nodes changed between them, the boxes made and laid out,
/// and each phase's time (a frame's boxes and layout apart).
pub fn work_report() -> String {
  let parts : Array[String] = []
  for k in phase_us.keys() {
    let v = phase_us.get(k).unwrap_or(0L)
    parts.push("\{k} \{v / 1000L}")
  }
  "named rebuilds \{named_rebuilds.v}, layouts \{layouts.v}, nodes touched \{nodes_touched.v}, boxes made \{layout::boxes_made()}, boxes laid out \{layout::work_counts[0]}, layouts put back \{layout::work_counts[3]}, kept for other inputs \{layout::work_counts[1]}, inline runs measured \{layout::inline_counts[0]}, laid out \{layout::inline_counts[1]} with pieces \{layout::inline_counts[2]}, cut anew \{layout::inline_counts[3]}, paint drawn/hit/unkept/mismatch/miss \{fvpaint::paint_counts[0]}/\{fvpaint::paint_counts[1]}/\{fvpaint::paint_counts[2]}/\{fvpaint::paint_counts[3]}/\{fvpaint::paint_counts[4]}; ms by phase " + parts.join(", ")
}

///|
/// (FV_PROF) Microseconds of layouts by phase, over the run.
let phase_us : Map[String, Int64] = Map::new()

///|
fn add_phase(name : String, us : Int64) -> Unit {
  phase_us[name] = phase_us.get(name).unwrap_or(0L) + us
}

///|
/// (FV_PROF) Nodes changed, each time one was.
let nodes_touched : Ref[Int] = Ref::{ v: 0 }

///|
/// Where a page's time went so far (FV_PROF): scripts (with the layouts they asked for), layouts, the network waited
/// on in gets the page could not go on without, and waited for with nothing else to do.
pub fn time_spent() -> String {
  "scripts \{script_ms.v} ms, layouts \{layout_ms.v} ms"
}

///|
fn run(source : String, from~ : String = "") -> Unit {
  // the host may have changed the document since scripts last ran
  bump_version()
  let t0 = now_ms()
  run_depth.v += 1
  let r = js::run(source)
  run_depth.v -= 1
  if run_depth.v == 0 {
    script_ms.v += (now_ms() - t0).to_int64()
  }
  last_op.v = -1
  if fcache.prof && now_ms() - t0 >= 5 {
    let what = if from != "" { from } else { source.slice(0, imin(source.length(), 80)) }
    fetch::prof_line("prof run \{now_ms() - t0} ms \{what}")
  }
  if r.starts_with("!error:") {
    // (where it came from: a script's name, else the start of what the host ran)
    let what = if from != "" {
      from
    } else {
      // (the host's key is not the page's to see in its log)
      str_replace_all(source.slice(0, imin(source.length(), 60)), js::host_key(), "…")
    }
    st.errors.push(r + " (in " + what + ")")
  }
}

///|
fn js_string(s : String) -> String {
  let n = s.length()
  let mut i = 0
  let mut first_esc = -1
  while i < n {
    let c = s.code_unit_at(i).to_int()
    if c == 0x22 || c == 0x5C || c == 0x0A || c == 0x0D {
      first_esc = i
      break
    }
    i += 1
  }
  if first_esc < 0 {
    return "\"" + s + "\""
  }
  let b = StringBuilder::new()
  b.write_char('"')
  if first_esc > 0 {
    b.write_string(s.slice(0, first_esc))
  }
  i = first_esc
  let mut run_start = i
  while i < n {
    let c = s.code_unit_at(i).to_int()
    if c == 0x22 || c == 0x5C || c == 0x0A || c == 0x0D {
      if i > run_start {
        b.write_string(s.slice(run_start, i))
      }
      if c == 0x22 {
        b.write_string("\\\"")
      } else if c == 0x5C {
        b.write_string("\\\\")
      } else if c == 0x0A {
        b.write_string("\\n")
      } else {
        b.write_string("\\r")
      }
      run_start = i + 1
    }
    i += 1
  }
  if n > run_start {
    b.write_string(s.slice(run_start, n))
  }
  b.write_char('"')
  b.to_string()
}

///|
extern "C" fn pion_page_host_cb(op : Int, a : Int, b : Int, s : String, t : String) -> String {
  host(op, a, b, s, t)
}

extern "C" fn pion_page_int_cb(op : Int, a : Int, b : Int) -> Int {
  host_int(op, a, b)
}

///|
/// `parsed` is called once the document is parsed and before its scripts run, for showing it while they do (a
/// browser draws a page as it comes, not once its scripts are done).
pub fn load(url : String, w : Double, h : Double, post? : String, parsed? : () -> Unit) -> Bool {
  st.w = w
  st.h = h
  // a phone-sized viewport gets the pages sites make for phones
  fetch::as_phone(w < 700.0)
  let prev_url = if st.started && st.url != "" && !st.url.starts_with("about:") { st.url } else { "" }
  let computed_nav_ref = if prev_url != "" {
    sec_compute_referrer(prev_url, url)
  } else {
    None
  }
  let nav_ref_str = computed_nav_ref.unwrap_or("")
  fetch::set_referer(nav_ref_str)
  let mut nav_req_headers = ""
  if nav_ref_str != "" {
    nav_req_headers = "Referer: " + nav_ref_str + "\n"
  }
  let nav_ck = sec_cookie_header_for_request(url, true, if post.is_some() { "POST" } else { "GET" })
  if nav_ck != "" {
    nav_req_headers = nav_req_headers + "Cookie: " + nav_ck + "\n"
  }
  let (body, final_url, disposition, resp_headers) = match post {
    // a form's POST: the page is what it answers
    // (its body: content type \u{2} bytes as Latin-1 text, or urlencoded text from before that was so)
    Some(data) => {
      let (ctype, body) = match str_find(data, stx_str()) {
        Some(i) => (data.slice(0, i), latin1_bytes(data.slice(i + 1, data.length())))
        None => ("application/x-www-form-urlencoded", utf8_encode(data))
      }
      let r = fetch::request("POST", url, nav_req_headers + "Content-Type: " + ctype, body, true)
      let mut disp = ""
      for l0 in r.headers.split("\n") {
        let l = l0.trim()
        if ascii_lower(l).starts_with("content-disposition:") {
          disp = l.slice(20, l.length())
          break
        }
      }
      (r.body, r.url, disp, r.headers)
    }
    None => {
      let (b, u, hdrs) = fc_get_doc(url, nav_req_headers)
      (b, u, fc_last_disposition(), hdrs)
    }
  }
  // a file to save, not a page to show (Content-Disposition: attachment): saved, the page staying as it was
  if is_attachment(disposition) && st.started {
    saved_as_attachment(if final_url == "" { url } else { final_url }, disposition, fc_last_content_type(), body) |> ignore
    fetch::set_referer(st.url)
    return false
  }
  nav_referrer.v = nav_ref_str
  // (a new document is shown from its top until the client says otherwise)
  shown_from.v = 0.0
  scripts_scrolled_doc.v = false
  st.url = if final_url == "" { url } else { final_url }
  // (a POST's answer is always a response received now; a GET's may be the history's own copy of the document)
  sec_apply_nav_headers(prev_url, st.url, resp_headers, history=post.is_none() && fc_last_from_history())
  // (a response received now, its cookies set: what its history copy was shown with)
  if post.is_none() && !fc_last_from_history() {
    fc_history_shown_with(url, st.url, sec_cookie_header_for_request(st.url, true, "GET"))
  }
  let sub_ref = sec_compute_referrer(st.url, st.url).unwrap_or("")
  fetch::set_referer(sub_ref)
  let content_type = fc_last_content_type()
  // :target is the element the fragment names
  let frag_id = match str_find(url, "#") {
    Some(k) => url.slice(k + 1, url.length())
    None => ""
  }
  cur_target_id.v = frag_id
  css::set_target_id(frag_id)
  clear_pdf()
  find_clear_quiet()
  let text = if !is_attachment(disposition) && is_inline_pdf(st.url, content_type, body) {
    render_pdf_viewer_html(st.url, disposition, body)
  } else {
    decode_page(body, content_type)
  }
  match st.engine {
    Some(e) => {
      e.dispose()
      st.engine = None
    }
    None => ()
  }
  match st.root {
    Some(r) => {
      layout::drop_box_tree(r)
      st.root = None
    }
    None => ()
  }
  box_reuse.v.drop_all()
  st.paint_kept.clear()
  st.last_hover_raw = ""
  clear_attr_indices()
  for old_f in frames {
    match old_f.engine {
      Some(e) => {
        e.dispose()
        old_f.engine = None
      }
      None => ()
    }
    match old_f.root {
      Some(r) => {
        layout::drop_box_tree(r)
        old_f.root = None
      }
      None => ()
    }
    old_f.reuse.drop_all()
  }
  html::drop_dom_tree(st.doc)
  st.nodes.clear()
  st.nodes.push(None)
  id_owner_ctx.clear()
  id_owner_ctx.push(0)
  free_ids.clear()
  loose_roots.clear()
  dirty_loose_roots.clear()
  swept_loose_roots.clear()
  swept_held_count.clear()
  loose_root_ctx.clear()
  loose_full_needed.v = false
  cross_ctx_seen.v = false
  st.doc = if html::looks_xml(st.url, text) { html::parse_xml(text) } else { html::parse(text) }
  no_base_docs.clear()
  html::attach_shadow_roots(st.doc)
  frames.clear()
  frames_gone.clear()
  // (the page's own frames, opened now, are the ones to start and fetch: none of the last page's)
  to_start.clear()
  to_fetch.clear()
  canvases.clear()
  clear_canvas_tracking()
  clear_webgl()
  clear_webgpu()
  clear_webrtc()
  clear_media()
  last_canvas_draw_ms.v = 0L
  frame_roots.v = intmap::IntMap::new()
  // (the last page's requests dropped before this one's start; the browser's own among them are told they were lost,
  // so what waits on one asks again: host_fetches_lost)
  host_fetches_drop()
  fetch::drop_started()
  clear_streams()
  clear_ws()
  bc_subscribed.v = false
  svg_dirty.v = true
  assets_dirty.v = true
  cached_el_pics.v = []
  pictures_ver.v += 1
  fonts_ver.v += 1
  // (and its fonts got ahead that its layout never took)
  fc_forget()
  fonts_ahead.clear()
  fonts_ahead_for.v = ([], 0)
  open_frames(st.doc)
  // all it says it needs (its style sheets, scripts, preloaded fonts) started at once, as the document comes, over the
  // connections already open: a sign-in page took its sheet, then its fonts, then its scripts, one after another
  fc_fetch_ahead(subresources(st.doc, pictures=false))
  // its style sheets come before it goes on (the page is drawn with them before its scripts run); its scripts after
  prefetch_for(st.doc, sheets_only=true)
  touch()
  st.root = None
  if !st.started {
    st.started = true
    js::start_raw(c_fn_ptr(pion_page_host_cb))
    js::start_int_raw(c_fn_ptr(pion_page_int_cb))
  }
  // Scripts see one document at a time, each page in a global of its own
  terminate_threaded_workers()
  js::new_context()
  js::set_dom_version(st.version)
  bump_doc_names_version()
  bump_detach_version()
  browsing.clear()
  throttled.clear()
  started_at.clear()
  before_style.clear()
  trans_started.clear()
  transitions.clear()
  clear_web_anims()
  anim_start.clear()
  anim_names.clear()
  anim_events.clear()
  started.clear()
  started_flags.clear()
  started_urls.clear()
  background.clear()
  deferred_async_done.clear()
  clear_image_async_state()
  box_reuse.v = layout::Reuse::new()
  changed_nodes.clear()
  changed_whole.v = false
  cur_ctx.v = 0
  load_waited.v = -1
  messages.clear()
  js::set_origin(0, origin_of(st.url))
  run_prelude()
  tell_window_ids()
  // FV_DEBUG_JS: a script (by URL) run before the page's own, for looking into what a page does
  match env_var("FV_DEBUG_JS") {
    Some(u) => run(utf8_decode_lossy(fc_get(u).0))
    None => ()
  }
  run(
    "__setUrl(" + js_string(st.url) + "); " +
    hk() + ".__setReferrer(" + js_string(nav_referrer.v) + "); " +
    hk() + ".__setCrossOriginIsolated(" + (if is_cross_origin_isolated() { "true" } else { "false" }) + "); " +
    hk() + ".__fvSetDpr(\{css::media_dpr()}); " +
    "innerWidth=\{w}; innerHeight=\{h}; __readyState='loading'",
  )
  let scripts : Array[html::Node] = []
  run_scripts(st.doc, scripts)
  run("__fvModulesReset()")
  match parsed {
    Some(f) => f()
    None => ()
  }
  prefetch_for(st.doc)
  inject_extension_scripts(st.url, "document_start")
  run_document_scripts(scripts, doc_base_url(st.doc, st.url))
  // the frames the document came with load before it does (a parent's load waits for its frames')
  start_frames()
  run(
    "__readyState='interactive'; __frames(\{if eager_pictures.v { "false" } else { "true" }}); __initialLinks(); document.dispatchEvent(new Event('DOMContentLoaded',{bubbles:true})); \{hk()}.__mediaAutoLoad()",
  )
  inject_extension_scripts(st.url, "document_end")
  // the page's load waits for the frames its scripts put in (they start between its tasks), as a browser's does
  if frames_waiting() {
    load_waited.v = 0
  } else {
    fire_load()
  }
  inject_extension_scripts(st.url, "document_idle")
  tick(1500)
  st.js_href = js::run("String(location.href)")
  apply_env_find_query()
  // (an address with a #fragment opens where what it names is, unless the page's scripts scrolled it themselves)
  if frag_id != "" && scroll_wanted.v.is_none() {
    scroll_to_fragment(fragment_decoded(frag_id))
  }
  true
}

///| An address's #fragment with its percent-escapes undone (as it is left when they do not decode).
fn fragment_decoded(frag : String) -> String {
  if frag.contains("%") && st.started {
    js::run("(() => { try { return decodeURIComponent(" + js_string(frag) + ") } catch (e) { return " + js_string(frag) + " } })()")
  } else {
    frag
  }
}

///| Asks the client to show the page from the element `id` names (its id, else an `<a name>`; `id` decoded already),
///| as following a #fragment does (HTML §7.4.6.2 "scroll to the fragment"); nothing when none is named so.
fn scroll_to_fragment(id : String) -> Unit {
  if !st.started || id == "" {
    return
  }
  let found = by_id(st.doc, id)
  let el = if found.length() > 0 {
    Some(found[0])
  } else if id.contains("\"") || id.contains("\\") {
    None
  } else {
    match query_fast(st.doc, "a[name=\"" + id + "\"]", true) {
      Some(ns) if ns.length() > 0 => Some(ns[0])
      _ => None
    }
  }
  match el {
    Some(n) => {
      ensure_layout()
      match st.root {
        Some(root) => match layout::rect_of(root, n) {
          Some((_, y, _, _)) => scroll_wanted.v = Some(if y > 0.0 { y } else { 0.0 })
          None => ()
        }
        None => ()
      }
    }
    None => ()
  }
}

///|
/// A document's scripts (`scripts`, in document order) run as a browser runs them (WHATWG HTML §13.2.7):
/// classic parser-blocking scripts where they stand, then all deferred classic (`defer`/`async` with `src`)
/// and module scripts in a single queue preserving their exact document order; each with its currentScript,
/// addresses resolved against `base`.
fn run_document_scripts(scripts : Array[html::Node], base : String) -> Unit {
  // deferred classic (src + defer/async) and module scripts share one document-order queue
  let deferred : Array[(html::Node, Bool)] = []
  let classic = fn(s : html::Node) {
    run("__setCurrent(\{id_of(s)})")
    match s.attr("src") {
      Some(src) => {
        let (code, _) = fc_get(fetch::resolve(base, src))
        run(script_text(code), from=src)
      }
      None => run(html::text_content(s), from="inline script " + id_of(s).to_string())
    }
    run("__setCurrent(0)")
    run(
      "if (window.add_completion_callback && !window.__hooked) { window.__hooked = true; add_completion_callback((t, s) => { window.__wpt = t; }); }",
    )
  }
  for s in scripts {
    let ty = script_kind(s)
    // the names modules import by, for the module loader
    if ty == "importmap" {
      run("__fvImportMap(" + js_string(html::text_content(s)) + ")")
      continue
    }
    if ty == "" {
      continue
    }
    if ty == "module" {
      deferred.push((s, true))
      continue
    }
    // a browser that runs modules skips what is there for one that does not
    if s.attr("nomodule") is Some(_) {
      continue
    }
    if s.attr("src") is Some(_) && (s.attr("defer") is Some(_) || s.attr("async") is Some(_)) {
      deferred.push((s, false))
      continue
    }
    classic(s)
  }
  for item in deferred {
    let (s, is_mod) = item
    if !is_mod {
      classic(s)
    } else {
      run("__setCurrent(\{id_of(s)}); __setCurrent(0)")
      let src_opt = s.attr("src")
      match src_opt {
        Some(src_val) => run("__fvModule(null, " + js_string(fetch::resolve(base, src_val)) + ")", from=src_val)
        None => {
          let code = html::text_content(s)
          if code.trim() != "" {
            run(
              "__fvModule(" + js_string(code) + ", " + js_string(base + "#module-" + id_of(s).to_string()) + ")",
              from="inline module " + id_of(s).to_string(),
            )
          }
        }
      }
    }
  }
}

///|
/// A request a script makes (op 62, 76): method \u{1} URL in `s`, headers \u{2} body in `t`; a's bit 0, the body is
/// bytes one character each; bit 2, it goes without credentials (no cookies); bit 3, it is a CORS request to another
/// origin, which says the page's origin whatever its method. What a browser adds goes with it: where it comes from,
/// what it accepts.
fn script_request(a : Int, s : String, t : String) -> (String, String, String, Bytes) {
  let (method, url) = match str_find(s, soh_str()) {
    Some(k) => (s.slice(0, k), s.slice(k + 1, s.length()))
    None => ("GET", s)
  }
  let (headers, body) = match str_find(t, stx_str()) {
    Some(k) => (t.slice(0, k), t.slice(k + 1, t.length()))
    None => (t, "")
  }
  let here = cur_url()
  let target_url = fetch::resolve(here, url)
  let origin = {
    let k = str_find(here, "://").unwrap_or(0) + 3
    match str_find(here.slice(k, here.length()), "/") {
      Some(e) => here.slice(0, k + e)
      None => here
    }
  }
  let lower = ascii_lower(headers)
  let ref_line = if lower.contains("referer:") {
    ""
  } else {
    match sec_compute_referrer(here, target_url) {
      Some(rv) => "Referer: " + rv + "\n"
      None => ""
    }
  }
  let ck_line = if (a & 4) == 0 && !lower.contains("cookie:") {
    let ck = sec_cookie_header_for_request(target_url, false, method)
    if ck != "" { "Cookie: " + ck + "\n" } else { "" }
  } else {
    ""
  }
  let extra = ref_line + ck_line +
  (if lower.contains("origin:") || ((ascii_lower(method) == "get" || ascii_lower(method) == "head") && (a & 8) == 0) {
    ""
  } else {
    "Origin: " + origin + "\n"
  }) +
  (if lower.contains("accept:") { "" } else { "Accept: */*\n" })
  let out = if (a & 1) != 0 { latin1_bytes(body) } else { utf8_encode(body) }
  (method, target_url, extra + headers, out)
}

///|
/// An answer as scripts take it: status \u{1} headers \u{1} final URL \u{1} body (bytes one character each, or text).
fn answer_text(r : fetch::Answer, bytes : Bool) -> String {
  r.status.to_string() + soh_str() + r.headers + soh_str() + r.url + soh_str() +
  (if bytes { bytes_latin1(r.body) } else { utf8_decode_lossy(r.body) })
}

///|
/// The requests scripts started that are still out: the context each was made in, and whether its body goes back as
/// bytes.
let started : intmap::IntMap[(Int, Bool)] = intmap::IntMap::new()

///|
/// Security flags for each in-flight async script request: `(is_cors, with_credentials)`.
let started_flags : intmap::IntMap[(Bool, Bool)] = intmap::IntMap::new()

///|
/// What each of them asked for (FV_DEBUG_FRAMES's account of what a page still waits on).
let started_urls : intmap::IntMap[String] = intmap::IntMap::new()

///|
/// Those of them the page does not wait on (keepalive requests, beacons): out, the page has still settled.
let background : intmap::IntMap[Bool] = intmap::IntMap::new()

///|
/// The requests scripts started that are still out, each as its method and URL.
pub fn pending_requests() -> Array[String] {
  let out : Array[String] = []
  for id in started.keys() {
    out.push(intmap::get(started_urls, id).unwrap_or("?"))
  }
  out
}

///|
/// Non-prefetch async completions drained by `fc_wait_inflight` while waiting on a
/// prefetched resource, queued here so `deliver_answers` delivers them without loss.
let deferred_async_done : Array[(Int, fetch::Answer)] = []

///|
/// The answers come since last asked, each handed to its request's callback in the context that made it. When
/// requests are out and `wait_ms` is more than 0, waits that long at most for one: the page's time goes on as the
/// network's does.
///| Requests the browser makes for itself, not the page (the address palette's search suggestions): answered to
///| their callback by `deliver_answers`, never to the page's scripts, and never counted as the page's network.
let host_fetches : intmap::IntMap[(fetch::Answer) -> Unit] = intmap::IntMap::new()

///|
/// Start a GET of the browser's own (no cookies sent or kept: `credentials` off); `done` is told its answer as the
/// page's answers are delivered (`tick`). The request id.
pub fn host_fetch(url : String, headers : String, done : (fetch::Answer) -> Unit) -> Int {
  let id = fetch::start("GET", url, headers, Bytes::new(0), false)
  host_fetches.set(id, done)
  id
}

///|
/// How many of the browser's own requests are out.
pub fn host_fetches_out() -> Int {
  host_fetches.len()
}

///| The browser's own requests dropped with a page's (`load`: `fetch::drop_started` frees every request out), each
///| callback told so with an answer of status 0 at the next `deliver_answers`, never in the middle of a load.
let host_fetches_lost : Array[(fetch::Answer) -> Unit] = []

fn host_fetches_drop() -> Unit {
  host_fetches.each(fn(_id, done) { host_fetches_lost.push(done) })
  host_fetches.clear()
}

fn host_fetches_tell_lost() -> Unit {
  if host_fetches_lost.length() == 0 {
    return
  }
  let lost : Array[(fetch::Answer) -> Unit] = []
  for d in host_fetches_lost {
    lost.push(d)
  }
  host_fetches_lost.clear()
  for d in lost {
    d(fetch::Answer::{ status: 0, headers: "", url: "", body: Bytes::new(0) })
  }
}

fn deliver_answers(wait_ms : Int) -> Unit {
  host_fetches_tell_lost()
  if deferred_async_done.length() > 0 || started.len() > 0 || fc_ahead_count() > 0 || media_has_pending_fetches() || img_has_pending_fetches() || host_fetches.len() > 0 {
    let batch : Array[(Int, fetch::Answer)] = []
    if deferred_async_done.length() > 0 {
      for d in deferred_async_done {
        batch.push(d)
      }
      deferred_async_done.clear()
    }
    let poll_wait = if batch.length() > 0 { 0 } else { wait_ms }
    if started.len() > 0 || fc_ahead_count() > 0 || media_has_pending_fetches() || img_has_pending_fetches() || host_fetches.len() > 0 {
      for d in fetch::done(poll_wait) {
        batch.push(d)
      }
    }
    for d in batch {
      let (id, r) = d
      if fc_handle_done(id, r) {
        continue
      }
      if media_handle_fetch_done(id, r) {
        continue
      }
      if img_handle_fetch_done(id, r) {
        continue
      }
      match intmap::get(host_fetches, id) {
        Some(done) => {
          let _ = host_fetches.delete(id)
          done(r)
          continue
        }
        None => ()
      }
      match intmap::get(started, id) {
        Some((ctx, bytes)) => {
          let (is_cors, with_creds) = intmap::get(started_flags, id).unwrap_or((false, true))
          started.delete(id)
          started_flags.delete(id)
          started_urls.delete(id)
          background.delete(id)
          if with_creds && r.status > 0 {
            sec_ingest_set_cookies(r.url, r.headers)
          }
          let corp_ok = sec_check_corp(st.url, r.url, r.headers, is_cors)
          if env_has("FV_DEBUG_FRAMES") {
            st.errors.push("answer in context \{ctx}: \{r.url} -> \{r.status}, \{r.body.length()} bytes")
          }
          // (a context gone with its frame: dropped)
          if ctx == 0 || browsing.contains(ctx) {
            let payload = if corp_ok { answer_text(r, bytes) } else { "" }
            in_context(ctx, fn() { run("\{hk()}.__netDone(\{id}, " + js_string(payload) + ")") })
          }
        }
        None => ()
      }
    }
  }
  let stream_wait = if started.len() == 0 && fc_ahead_count() == 0 { wait_ms } else { 0 }
  deliver_streams(stream_wait)
  deliver_ws()
}

///|
/// Whether requests scripts started are still out (a page waiting on its network is not settled).
pub fn network_busy() -> Bool {
  started.len() > background.len() || fc_ahead_count() > 0 || streams_busy() || pending.length() > 0 || media_has_pending_fetches() || img_has_pending_fetches()
}

///|
/// Whether an element with this style is rendered (no display: none on it or an ancestor): only those transition.
fn rendered(s : css::Style) -> Bool {
  let mut cur = Some(s)
  while cur is Some(x) {
    if x.word("display") == "none" {
      return false
    }
    cur = x.parent_style()
  }
  true
}

///|
/// How long the page's load has waited for its frames (page time, ms); -1 when it is not waiting.
let load_waited : Ref[Int] = Ref::{ v: -1 }

///|
fn frames_waiting() -> Bool {
  to_start.length() > 0 || to_fetch.length() > 0
}

///|
fn fire_load() -> Unit {
  load_waited.v = -1
  run("__readyState='complete'; document.dispatchEvent(new Event('readystatechange')); window.dispatchEvent(new Event('load'))")
}

///|
/// Runs timers for `ms` of the page's time.
/// `net_wait`: how long to wait for the network when it is all the page waits for (a test client's settle, which has
/// no client to wait on meanwhile).
pub fn tick(ms : Int, net_wait~ : Int = 0) -> Unit {
  if !st.started {
    return
  }
  // what its links asked to have saved since (a person's tap on one)
  take_downloads()
  // poll MutationObservers in any active MV3 extension isolated worlds
  pump_extension_mutations()
  // what the network answered meanwhile (waiting for it as long as this tick is, when it is all the page waits for)
  deliver_answers(net_wait)
  // with frames, the page's time and theirs go on together, a frame at a time (16 ms, a display frame): a page that
  // waits a few animation frames for what a frame tells it sees the frame's timers run meanwhile
  let mut left = ms
  while true {
    // (a worker's messages wait for the step's end: workers alone do not make the page's time go by frames)
    let mut has_frame_browsing = false
    for bk in browsing.keys() {
      match intmap::get(browsing, bk) {
        Some(b) if b.el is Some(_) => { has_frame_browsing = true; break }
        _ => ()
      }
    }
    let step = if has_frame_browsing && left > 16 { 16 } else { left }
    run("__tick(\{step})")
    tick_media(step)
    let _ = tick_gif_animations(step)
    // transitions the last layouts started: their events, as tasks of the page's
    if trans_started.length() > 0 {
      let items : Array[String] = []
      for t in trans_started {
        items.push("[\{t.0},\{js_string(t.1)},\{t.2},\{t.3}]")
      }
      trans_started.clear()
      run("__transitions([" + items.join(",") + "])")
    }
    if anim_events.length() > 0 {
      let items : Array[String] = []
      for t in anim_events {
        items.push("[\{t.0},\{js_string(t.1)},\{t.2},\{t.3},\{t.4}]")
      }
      anim_events.clear()
      run("__animations([" + items.join(",") + "])")
    }
    // the frames: those opened since started, messages between them and the page delivered, their timers
    release_waiting()
    start_frames()
    if load_waited.v >= 0 {
      load_waited.v += step
      if !frames_waiting() || load_waited.v >= 10000 {
        fire_load()
      }
    }
    deliver_messages()
    pump_threaded_workers()
    pump_webrtc()
    tick_frames(step)
    left -= step
    if left <= 0 {
      break
    }
  }
}

///|
pub fn eval(source : String) -> String {
  bump_version()
  js::run(source)
}

///|
/// The viewport made `w` by `h` CSS pixels with the page on it (a window resized): its media queries and viewport
/// units evaluated anew, the whole page styled and laid out again, and its scripts told (a resize event).
pub fn resize(w : Double, h : Double) -> Unit {
  if !st.started || (st.w == w && st.h == h) {
    st.w = w
    st.h = h
    return
  }
  st.w = w
  st.h = h
  // (an engine evaluates media queries for the size it was made with)
  st.engine = None
  st.engine_key = 0L
  st.paint_kept.clear()
  touch()
  // (its scripts read the new size before they hear of it: a composer put by innerWidth was put for the old one)
  run("innerWidth=\{w}; innerHeight=\{h}; window.dispatchEvent(new Event('resize')); " + hk() + ".__mediaCheck()")
  in_every_frame(hk() + ".__mediaCheck()")
}

///| `source` run in each frame's own context (an `<iframe>`'s document has a prelude, and lists it follows, of its own).
fn in_every_frame(source : String) -> Unit {
  for i in browsing.keys() {
    match intmap::get(browsing, i) {
      Some(b) if b.el is Some(_) => in_context(i, fn() { run(source) })
      _ => ()
    }
  }
}

///|
/// The person left the page's fullscreen (Esc, the window leaving full screen): the element is no longer
/// `:fullscreen`, `document.fullscreenElement` is null and the page hears "fullscreenchange".
pub fn exit_fullscreen() -> Unit {
  if st.started {
    run(hk() + ".__fsExit()")
  }
}

///|
/// What the client shows its pages as beyond their size (`ClientMsg::MediaPrefs`, the ratio from `Viewport`): dark or
/// light (`prefers-color-scheme`, `color-scheme: light dark`, `light-dark()`) and its device pixels a CSS pixel
/// (`devicePixelRatio`, the `srcset` / `image-set` candidate picked, `resolution` queries). Restyled as a resize is,
/// its pictures picked again, and a followed `matchMedia` list whose answer changed hears "change".
pub fn set_media_prefs(dark : Bool, dpr : Double) -> Unit {
  if !css::set_media_prefs(dark, dpr) {
    return
  }
  if !st.started {
    return
  }
  st.engine = None
  st.engine_key = 0L
  st.paint_kept.clear()
  image_changes.v += 1
  touch()
  run(hk() + ".__mediaPrefs(\{css::media_dpr()})")
  in_every_frame(hk() + ".__mediaPrefs(\{css::media_dpr()})")
}

///|
/// How many `matchMedia` lists the main document's scripts listen to (let go once no one does).
pub fn media_lists_followed() -> Int {
  css::parse_double(eval(hk() + ".__mediaFollowed()")).to_int()
}

///|
/// Temporarily switch viewport size and CSS media type ("print" or "screen") for PDF export without firing window resize.
/// When `media == "screen"`, background graphics painting is always restored to `true`.
pub fn set_print_mode(w : Double, h : Double, media : String, background_graphics~ : Bool = true) -> Unit {
  st.w = w
  st.h = h
  st.media = media
  fvpaint::set_paint_backgrounds(if media == "screen" { true } else { background_graphics })
  st.engine = None
  st.engine_key = 0L
  st.paint_kept.clear()
  touch()
}

///|
/// An agent's script run in the page's global as the page's own code (an indirect eval): its value as JSON (null for
/// undefined; a value JSON cannot hold, as its String), or "error: " and what was thrown. A promise is waited for:
/// "\u{0}pending" now, and `eval_settled` says its value once the page has run on.
pub fn eval_value(source : String) -> String {
  eval(
    "(() => { const out = v => { try { const j = JSON.stringify(v === undefined ? null : v); return j === undefined ? JSON.stringify(String(v)) : j } catch (e) { return JSON.stringify(String(v)) } }; try { const v = (0, eval)(" +
    js_string(source) +
    "); if (v && typeof v.then === 'function') { const box = globalThis[Symbol.for('farview.eval')] = { done: false }; v.then(x => { box.done = true; box.text = out(x) }, e => { box.done = true; box.text = 'error: ' + ((e && e.stack) || e) }); return '\\u0001__fv_pending__' } return out(v) } catch (e) { return 'error: ' + ((e && e.stack) || e) } })()",
  )
}

///|
/// The value of the promise `eval_value` waits for, once it settled.
pub fn eval_settled() -> Option[String] {
  let r = eval(
    "(() => { const box = globalThis[Symbol.for('farview.eval')]; if (!box || !box.done) return '\\u0001__fv_pending__'; delete globalThis[Symbol.for('farview.eval')]; return box.text })()",
  )
  if r == soh_str() + "__fv_pending__" {
    None
  } else {
    Some(r)
  }
}

///|
/// Where the client shows the page from, as it last said.
let shown_from : Ref[Double] = Ref::{ v: 0.0 }

///|
/// The client shows the page from `y` down: its scripts see it scrolled there and are told (a scroll event), as they
/// are in a browser when a person scrolls.
pub fn scrolled(y : Double) -> Unit {
  shown_from.v = y
  wake_visible_deferred_canvases()
  if !st.started {
    return
  }
  run("\{hk()}.__scrolled(\{y})")
}

///|
/// Where the client last showed the page from (Viewport scroll told by `scrolled`), CSS pixels.
pub fn shown_y() -> Double {
  shown_from.v
}

///|
/// Asks the client to show the page from `y` (a ScrollTo the next frame carries), as a script's scroll does.
pub fn ask_scroll(y : Double) -> Unit {
  scroll_wanted.v = Some(y)
}

///|
/// Whether the page leaves scroll restoration to the browser (history.scrollRestoration is not "manual").
pub fn history_scroll_auto() -> Bool {
  if !st.started {
    return true
  }
  js::run("String(history.scrollRestoration)") != "manual"
}

///|
pub fn changed() -> Bool {
  frame_due.v || has_dirty_canvases()
}

///|
/// Whether the main global has any elements with mouse/pointer hover listeners registered.
let has_hover_targets : Ref[Bool] = Ref::{ v: false }

///|
/// What to send a client: the display list, the fonts in it, the page's height.
pub fn frame() -> (Array[wire::Op], Array[Int], Double) {
  frame_due.v = false
  refresh_canvases() |> ignore
  ensure_layout()
  st.fixed.clear()
  match st.root {
    Some(root) => {
      apply_web_anims_to_boxes(root)
      let svgs : intmap::IntMap[String] = intmap::IntMap::new()
      let sizes = box_pictures(root, svgs)
      hover_targets.clear()
      hover_listened.clear()
      let mut hover_raw = ""
      if has_hover_targets.v {
        hover_raw = js::run("typeof __hoverIds === 'function' ? __hoverIds() : ''")
        if hover_raw == "" {
          has_hover_targets.v = false
        } else {
          for x in hover_raw.split(",") {
            let i = css::parse_double(x.to_string()).to_int()
            if i > 0 && i < st.nodes.length() {
              match st.nodes[i] {
                Some(n) => hover_listened.set(n.uid, true)
                None => ()
              }
            }
          }
        }
      }
      if hover_raw != st.last_hover_raw {
        st.last_hover_raw = hover_raw
        st.paint_kept.clear()
      }
      let pk_before = st.paint_kept.len()
      let pc0 = fvpaint::paint_counts[0]
      let pc1 = fvpaint::paint_counts[1]
      let pc2 = fvpaint::paint_counts[2]
      let pc3 = fvpaint::paint_counts[3]
      let pc4 = fvpaint::paint_counts[4]
      let (ops, used) = fvpaint::display_list_full(root, st.fonts, sizes, svgs, st.fixed, frame_roots.v, Some(st.paint_kept))
      if fcache.prof {
        fetch::prof_line("prof paint kept_before=\{pk_before} kept_after=\{st.paint_kept.len()} drawn=\{fvpaint::paint_counts[0] - pc0} hit=\{fvpaint::paint_counts[1] - pc1} unkept=\{fvpaint::paint_counts[2] - pc2} mismatch=\{fvpaint::paint_counts[3] - pc3} miss=\{fvpaint::paint_counts[4] - pc4}")
      }
      // FV_CHECK_PAINT: the page drawn anew beside it, nothing kept from the last frame: what was kept must draw the
      // same
      if check_paint {
        fvpaint::forget_kept()
        let anew = fvpaint::display_list_full(root, st.fonts, sizes, svgs, [], frame_roots.v, None).0
        let d = fvpaint::first_difference(ops, anew)
        if d >= 0 {
          let show = fn(a : Array[wire::Op]) { if d < a.length() { fvpaint::op_text(a[d]) } else { "(none)" } }
          st.errors.push("paint check: op \{d} of \{anew.length()} drawn as " + show(ops) + ", anew " + show(anew))
        }
      }
      for fop in find_overlay_page_ops() {
        ops.push(fop)
      }
      for ffx in find_overlay_fixed_ops() {
        st.fixed.push(ffx)
      }
      (ops, used, layout::page_height(root))
    }
    None => ([], [], 0.0)
  }
}

///|
/// What the last frame drew over the page where the viewport is.
pub fn fixed_ops() -> Array[wire::Op] {
  st.fixed
}

///|
pub enum Hit {
  // a field to type in: its node, its border box, its value, whether it holds lines
  Field(Int, Double, Double, Double, Double, String, Bool, Bool)
  Go(String)
  // a form sent with POST: where to and its urlencoded body
  Post(String, String)
  Nothing
}

///|
fn text_field(n : html::Node) -> Bool {
  if n.tag == "textarea" {
    return true
  }
  if n.tag != "input" {
    return false
  }
  match ascii_lower(n.attr("type").unwrap_or("text")) {
    "text" => true
    "search" => true
    "email" => true
    "url" => true
    "tel" => true
    "password" => true
    "number" => true
    "" => true
    _ => false
  }
}

///|
fn form_of(n : html::Node) -> Option[html::Node] {
  let mut p = n.parent
  while p is Some(x) {
    if x.kind == html::Kind::Element && x.tag == "form" {
      return Some(x)
    }
    p = x.parent
  }
  None
}

///|
/// Where the page's scripts sent it on their own (location set in a timer, a script during load), if they did.
pub fn navigation_pending() -> Bool {
  st.started && js::run("String(!!(globalThis.__navigate || globalThis.__post))") == "true"
}

///|
pub fn navigation() -> Option[String] {
  if !st.started {
    return None
  }
  take_navigation()
}

///|
fn take_navigation() -> Option[String] {
  bump_version()
  // (a frame's own: the page stays where it is)
  if cur_ctx.v != 0 {
    js::run("__takeNavigate()") |> ignore
    return None
  }
  let u = js::run("__takeNavigate()")
  if u == "" || u.starts_with("!error") {
    None
  } else {
    Some(u)
  }
}

///|
/// A form the page sent with POST: where to and its urlencoded body.
fn take_post() -> Option[Hit] {
  if cur_ctx.v != 0 {
    js::run("__takePost()") |> ignore
    return None
  }
  let p = js::run("__takePost()")
  match str_find(p, soh_str()) {
    Some(i) if !p.starts_with("!error") => Some(Post(p.slice(0, i), p.slice(i + 1, p.length())))
    _ => None
  }
}

///|
/// What a tap at page point (x, y) does: the page's click goes to the element under it first; then, unless the
/// page's script stopped it, a field is focused, a link followed, a form sent.
pub fn tap(x : Double, y : Double) -> Hit {
  ensure_layout()
  guard st.root is Some(root) else { return Nothing }
  guard layout::node_at(root, x, y) is Some(n) else { return Nothing }
  let n = svg_target(root, n, x, y)
  // a tap on a frame's document is that document's, its scripts' in their own global
  let n = if n.tag == "iframe" { node_in_frame(root, n, x, y).unwrap_or(n) } else { n }
  in_context_of(n, fn() { activate(root, n, x, y) })
}

///|
/// What a click on `n` (at x, y on the page) does: the page's script first, then what the browser does for it.
fn activate(root : layout::Box, n : html::Node, x : Double, y : Double) -> Hit {
  bump_version()
  let allowed = js::run("\{hk()}.__click(\{id_of(n)}, \{x}, \{y})") != "false"
  // what the click did by the page's own rules (a link followed, a form sent, a box checked)
  match take_navigation() {
    Some(u) => return Go(u)
    None => ()
  }
  match take_post() {
    Some(p) => return p
    None => ()
  }
  if !allowed {
    return Nothing
  }
  let mut cur : Option[html::Node] = Some(n)
  while cur is Some(e) {
    if e.kind == html::Kind::Element {
      if text_field(e) {
        run("\{hk()}.__focus(\{id_of(e)})")
        let (bx, by, bw, bh) = layout::rect_of(root, e).unwrap_or((x, y, 0.0, 0.0))
        let secret = e.tag == "input" && ascii_lower(e.attr("type").unwrap_or("")) == "password"
        return Field(id_of(e), bx, by, bw, bh, html::control_value(e), e.tag == "textarea", secret)
      }
    }
    cur = e.parent
  }
  Nothing
}

///|
/// What an element the CSS selector picks (the first) is asked to do, as a person would do it there, for what drives
/// the page by its parts rather than by points on the screen (an agent, a site's regression flow): "click" taps its
/// middle, "type" taps it and puts `text` in it, "enter" is Enter in it, "key" presses the key `text` there (with no
/// selector, at what has the focus). Nothing when nothing matches.
pub fn act(verb : String, selector : String, text : String) -> Hit {
  ensure_layout()
  guard st.root is Some(root) else { return Nothing }
  // a key pressed (`text` its key: "t", "/", "Escape"), at what has the focus when no selector says where (a page's
  // shortcuts listen on the document for keys pressed outside its fields)
  if verb == "key" && selector == "" {
    let id = css::parse_double(
      js::run("String((document.activeElement && document.activeElement._id) || (document.body && document.body._id) || 0)"),
    ).to_int()
    return if id > 0 { press_key(id, text) } else { Nothing }
  }
  let id = js::run(
    "(() => { try { const e = document.querySelector(" + js_string(selector) +
    "); return e ? String(e._id) : '0'; } catch (x) { return '0'; } })()",
  )
  let id = css::parse_double(id).to_int()
  if id <= 0 {
    return Nothing
  }
  let n = at(id)
  if verb == "click" || verb == "type" {
    let (x, y, w, h) = layout::rect_of(root, n).unwrap_or((0.0, 0.0, 0.0, 0.0))
    let hit = activate(root, n, x + w / 2.0, y + h / 2.0)
    if verb == "click" {
      take_downloads()
      return hit
    }
    let fid = match hit {
      Field(f, _, _, _, _, _, _, _) => Some(if text_field(n) { id } else { f })
      _ => if text_field(n) { Some(id) } else { None }
    }
    return match fid {
      Some(fid) => {
        if fid != id || !(hit is Field(_, _, _, _, _, _, _, _)) {
          run("\{hk()}.__focus(\{fid})")
        }
        at(fid).value = Some("")
        let typed_hit = typed_keys(fid, text)
        match typed_hit {
          Nothing => hit
          other => other
        }
      }
      _ => typed(id, text)
    }
  }
  match verb {
    "enter" => enter(id)
    "key" => press_key(id, text)
    // files chosen for a file input (`text`: a line each, its name, type and bytes in base64, tab-separated)
    "upload" => {
      let files : Array[String] = []
      for line in text.split("\n") {
        let f = line.split("\t")
        if f.length() == 3 {
          files.push("[" + js_string(f[0]) + "," + js_string(f[1]) + "," + js_string(f[2]) + "]")
        }
      }
      run("\{hk()}.__upload(\{id}, [" + files.join(",") + "])")
      Nothing
    }
    _ => Nothing
  }
}

///|
/// What the page says, as an agent reads it: its words in order, and each link, field and button as
/// `[kind selector] label` with a CSS selector that picks it (for `act`).
pub fn outline() -> String {
  if !st.started {
    return ""
  }
  js::run("__outline()")
}

///|
/// Where the page's scripts moved its address without leaving it (history.pushState: a single-page site's link), once:
/// the page now has that address.
pub fn moved_to() -> Option[String] {
  if !st.started {
    return None
  }
  let u = js::run("String(location.href)")
  if u == "" || u.starts_with("!error") || u == st.js_href {
    return None
  }
  st.js_href = u
  st.url = u
  Some(u)
}

///|
/// The page's title.
pub fn title() -> String {
  if !st.started {
    return ""
  }
  js::run("String(document.title || '')")
}

///|
/// A field's value as it is now (what was typed in it or its scripts set; else its value attribute).
pub fn field_value(id : Int) -> String {
  let n = at(id)
  match n.value {
    Some(v) => v
    None => n.attr("value").unwrap_or("")
  }
}

///|
/// Words typed into a field: its value, and the page's input event.
pub fn typed(id : Int, value : String) -> Hit {
  in_context_of(at(id), fn() { typed_in(id, value) })
}

///|
fn typed_in(id : Int, value : String) -> Hit {
  let n = at(id)
  n.value = Some(value)
  // (what its value changes: its own box, and what matches by it, :placeholder-shown and the like)
  touch_at(n)
  run("\{hk()}.__typed(\{id})")
  match take_navigation() {
    Some(u) => Go(u)
    None => Nothing
  }
}

///|
/// Words typed into a field key by key, as an agent's typing should look to the page: each key's keydown, keypress,
/// the value with it, input, keyup.
pub fn typed_keys(id : Int, text : String) -> Hit {
  in_context_of(at(id), fn() { typed_keys_in(id, text) })
}

///|
fn typed_keys_in(id : Int, text : String) -> Hit {
  let n = at(id)
  let mut value = n.value.unwrap_or("")
  let mut i = 0
  while i < text.length() {
    let ch = text.slice(i, i + 1)
    let k = js_string(ch)
    run("\{hk()}.__key(\{id}, 'keydown', \{k})")
    run("\{hk()}.__key(\{id}, 'keypress', \{k})")
    value = value + ch
    n.value = Some(value)
    touch_at(n)
    run("\{hk()}.__typed(\{id}, \{k})")
    run("\{hk()}.__key(\{id}, 'keyup', \{k})")
    i += 1
  }
  match take_navigation() {
    Some(u) => Go(u)
    None => Nothing
  }
}

///|
/// A key pressed and let go at element `id`: keydown, keypress for a key that types (one character), keyup.
fn press_key(id : Int, key : String) -> Hit {
  in_context_of(at(id), fn() {
    let k = js_string(key)
    run("\{hk()}.__key(\{id}, 'keydown', \{k})")
    if key.length() == 1 {
      run("\{hk()}.__key(\{id}, 'keypress', \{k})")
    }
    run("\{hk()}.__key(\{id}, 'keyup', \{k})")
    match take_navigation() {
      Some(u) => Go(u)
      None => Nothing
    }
  })
}

///|
/// Enter in a field: its form is sent.
pub fn enter(id : Int) -> Hit {
  in_context_of(at(id), fn() { enter_in(id) })
}

///| Dispatches a W3C CJK IME `compositionstart` event on the currently focused editable element.
pub fn compose_start(data? : String) -> Unit {
  let s = match data {
    Some(v) => v
    None => ""
  }
  run("\{hk()}.__composeStart(" + js_string(s) + ")")
  frame_due.v = true
}

///| Dispatches W3C `compositionupdate` + `input` (`insertCompositionText`, `isComposing: true`).
pub fn compose_update(data : String) -> Unit {
  run("\{hk()}.__composeUpdate(" + js_string(data) + ")")
  frame_due.v = true
}

///| Commits CJK IME text and dispatches `compositionend` + `input` (`isComposing: false`).
pub fn compose_end(data : String) -> Unit {
  run("\{hk()}.__composeEnd(" + js_string(data) + ")")
  frame_due.v = true
}

///| Handles `proto::EDIT_COMPOSING` phases (0 = start, 1 = update, 2 = end).
pub fn edit_composing(phase : Int, data : String) -> Unit {
  if phase == 0 {
    compose_start(data=data)
  } else if phase == 1 {
    compose_update(data)
  } else {
    compose_end(data)
  }
}

///| Copies the active selection (input/textarea/contenteditable/page), writes to `os_platform` clipboard,
///| and marks it for client notification.
pub fn copy_selection() -> String {
  let text = person_copy(false)
  if text != "" {
    let _ = os_platform::clipboard_write_text(text)
    copied_wanted.v = Some(text)
    frame_due.v = true
  }
  text
}

///| Cuts the active selection (input/textarea/contenteditable), writes to `os_platform` clipboard,
///| and marks it for client notification.
pub fn cut_selection() -> String {
  let text = person_copy(true)
  if text != "" {
    let _ = os_platform::clipboard_write_text(text)
    copied_wanted.v = Some(text)
    frame_due.v = true
    bump_version()
  }
  text
}

///| Pastes `text` (or reads `os_platform` clipboard when omitted/empty) into the focused element,
///| dispatching a DOM `paste` event first and falling back to inserting text if not prevented.
pub fn paste_text(text? : String) -> Bool {
  let payload = match text {
    Some(s) if s != "" => s
    _ => match os_platform::clipboard_read_text() {
      Some(s) => s
      None => ""
    }
  }
  if payload == "" {
    return false
  }
  if pasted(payload) {
    let _ = person_text(payload)
  }
  frame_due.v = true
  bump_version()
  true
}

///| Selects all content in the focused editable element (input/textarea/contenteditable) or document body.
pub fn select_all() -> Bool {
  let (changed, _) = person_key("down", "a", "KeyA", 4)
  let _ = person_key("up", "a", "KeyA", 4)
  if !changed {
    run("if (document.body && globalThis.getSelection) { globalThis.getSelection().selectAllChildren(document.body); }")
  }
  frame_due.v = true
  true
}

///| Triggers a registered `navigator.mediaSession` action handler (e.g. "play", "pause", "nexttrack").
pub fn media_session_action(action : String, details_json? : String) -> Bool {
  let d = match details_json {
    Some(v) => v
    None => ""
  }
  js::run("\{hk()}.__mediaSessionAction(" + js_string(action) + ", " + js_string(d) + ")") == "true"
}

///|
fn enter_in(id : Int) -> Hit {
  // the key goes to the page first; a page that takes it (its own search box) does what it does instead
  bump_version()
  let taken = js::run("\{hk()}.__enter(\{id})") == "false"
  match take_navigation() {
    Some(u) => return Go(u)
    None => ()
  }
  if taken {
    return Nothing
  }
  run("\{hk()}.__changed(\{id})")
  match form_of(at(id)) {
    Some(f) => submit_form(f)
    None =>
    match take_navigation() {
      Some(u) => Go(u)
      None => Nothing
    }
  }
}

///|
/// Words as a form sends them (application/x-www-form-urlencoded).
pub fn percent(s : String) -> String {
  let b = StringBuilder::new()
  let bs = utf8_encode(s)
  let mut i = 0
  while i < bs.length() {
    let c = bs[i].to_int()
    if (c >= 'a'.to_int() && c <= 'z'.to_int()) || (c >= 'A'.to_int() && c <= 'Z'.to_int()) ||
    (c >= '0'.to_int() && c <= '9'.to_int()) || c == '-'.to_int() || c == '_'.to_int() || c == '.'.to_int() ||
    c == '*'.to_int() {
      b.write_string(byte_str(c))
    } else if c == ' '.to_int() {
      b.write_char('+')
    } else {
      let hex = "0123456789ABCDEF"
      b.write_char('%')
      b.write_string(hex.slice(c >> 4, (c >> 4) + 1))
      b.write_string(hex.slice(c & 15, (c & 15) + 1))
    }
    i += 1
  }
  b.to_string()
}

///|
/// A form sent (HTML §4.10.21): the page's submit event, then its fields as a GET query to its action.
fn submit_form(f : html::Node) -> Hit {
  bump_version()
  // the page's own submission: its submit event, then the form's fields as its method sends them
  js::run("\{hk()}.__submit(\{id_of(f)})") |> ignore
  match take_navigation() {
    Some(u) => return Go(u)
    None => ()
  }
  match take_post() {
    Some(p) => p
    None => Nothing
  }
}

///|
pub fn link_at(x : Double, y : Double) -> Option[String] {
  match st.root {
    Some(root) => layout::link_at(root, x, y)
    None => None
  }
}

///|
let layouts : Ref[Int] = Ref::{ v: 0 }

///|
/// How many layouts the page has had (for finding what makes a page slow).
pub fn layout_count() -> Int {
  layouts.v
}

///|
/// Bytes as a string of one character per byte (how a script's request and answer bodies cross to the page).
fn bytes_latin1(b : Bytes) -> String {
  let n = b.length()
  let mut hi = 0
  let mut i = 0
  while i < n {
    if b[i].to_int() >= 0x80 {
      hi += 1
    }
    i += 1
  }
  if hi == 0 {
    return b.to_string()
  }
  let out = Bytes::new(n + hi)
  let mut k = 0
  i = 0
  while i < n {
    let v = b[i].to_int()
    if v < 0x80 {
      out[k] = v.to_byte()
      k += 1
    } else {
      out[k] = (0xC0 | (v >> 6)).to_byte()
      out[k + 1] = (0x80 | (v & 0x3F)).to_byte()
      k += 2
    }
    i += 1
  }
  out.to_string()
}

///|
/// A string of one character per byte (UTF-8 encoded U+0000..U+00FF), decoded back to raw Latin-1 bytes.
fn latin1_bytes(s : String) -> Bytes {
  let bs = s.to_bytes()
  let n = bs.length()
  let tmp = Bytes::new(n)
  let mut i = 0
  let mut k = 0
  while i < n {
    let b0 = bs[i].to_int() & 0xFF
    if b0 < 0x80 {
      tmp[k] = b0.to_byte()
      k += 1
      i += 1
    } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
      let b1 = bs[i + 1].to_int() & 0xFF
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      tmp[k] = (cp & 0xFF).to_byte()
      k += 1
      i += 2
    } else {
      tmp[k] = b0.to_byte()
      k += 1
      i += 1
    }
  }
  tmp.slice(0, k)
}

///|
/// An inline <svg>'s markup as a picture of its own: each of its elements given, after its own style, the color, fill
/// and stroke (a stop its stop-color) the page computes for it, which the picture alone would not have: the page's
/// sheets' rules, var()s (Proton's logo text is fill="var(--logo-text-proton-color)") and currentColor as the text
/// color it stands in. A paint server it names from outside it (Proton's icons fill from a gradient in another, hidden
/// svg) is taken in, styled so too.
let svg_stroke_props : Array[String] = [
  "stroke-width", "stroke-linecap", "stroke-linejoin", "stroke-dasharray", "stroke-dashoffset", "stroke-opacity", "fill-opacity",
]

let svg_webp_png_cache : Map[String, String] = Map::new()

fn svg_is_webp_bytes(bytes : Bytes) -> Bool {
  bytes.length() >= 12 &&
  bytes[0].to_int() == 0x52 &&
  bytes[1].to_int() == 0x49 &&
  bytes[2].to_int() == 0x46 &&
  bytes[3].to_int() == 0x46 &&
  bytes[8].to_int() == 0x57 &&
  bytes[9].to_int() == 0x45 &&
  bytes[10].to_int() == 0x42 &&
  bytes[11].to_int() == 0x50
}

fn svg_transcode_webp(bytes : Bytes) -> (Bytes, Bool) {
  if !svg_is_webp_bytes(bytes) {
    return (bytes, false)
  }
  match raster::decode_image(bytes) {
    Some((w, h, rgba)) if w > 0 && h > 0 => {
      let png = raster::encode_png(rgba, w, h)
      if png.length() > 0 { (png, true) } else { (bytes, false) }
    }
    _ => (bytes, false)
  }
}

fn svg_image_mime(bytes : Bytes, url : String) -> String {
  if bytes.length() >= 4 &&
  bytes[0].to_int() == 0x89 &&
  bytes[1].to_int() == 0x50 &&
  bytes[2].to_int() == 0x4E &&
  bytes[3].to_int() == 0x47 {
    return "image/png"
  }
  if bytes.length() >= 3 &&
  bytes[0].to_int() == 0xFF &&
  bytes[1].to_int() == 0xD8 &&
  bytes[2].to_int() == 0xFF {
    return "image/jpeg"
  }
  if bytes.length() >= 4 &&
  bytes[0].to_int() == 0x47 &&
  bytes[1].to_int() == 0x49 &&
  bytes[2].to_int() == 0x46 &&
  bytes[3].to_int() == 0x38 {
    return "image/gif"
  }
  if bytes.length() >= 12 &&
  bytes[0].to_int() == 0x52 &&
  bytes[1].to_int() == 0x49 &&
  bytes[2].to_int() == 0x46 &&
  bytes[3].to_int() == 0x46 &&
  bytes[8].to_int() == 0x57 &&
  bytes[9].to_int() == 0x45 &&
  bytes[10].to_int() == 0x42 &&
  bytes[11].to_int() == 0x50 {
    return "image/webp"
  }
  let head = utf8_decode_lossy(if bytes.length() > 64 { bytes.slice(0, 64) } else { bytes }).trim()
  if head.starts_with("<svg") || head.starts_with("<?xml") {
    return "image/svg+xml"
  }
  let lu = ascii_lower(url)
  if lu.ends_with(".jpg") || lu.ends_with(".jpeg") {
    "image/jpeg"
  } else if lu.ends_with(".webp") {
    "image/webp"
  } else if lu.ends_with(".gif") {
    "image/gif"
  } else if lu.ends_with(".svg") {
    "image/svg+xml"
  } else {
    "image/png"
  }
}

let svg_sprite_cache : Map[String, html::Node] = Map::new()

fn svg_sprite_doc(abs_url : String) -> Option[html::Node] {
  match svg_sprite_cache.get(abs_url) {
    Some(doc) => return Some(doc)
    None => ()
  }
  let (body, _) = fc_get(abs_url)
  if body.length() == 0 {
    return None
  }
  if svg_sprite_cache.length() > 64 {
    svg_sprite_cache.clear()
  }
  let doc = html::parse(utf8_decode_lossy(body))
  svg_sprite_cache.set(abs_url, doc)
  Some(doc)
}

fn svg_replace_ci(src : String, pat : String, rep : String) -> String {
  let lsrc = ascii_lower(src)
  let lpat = ascii_lower(pat)
  let plen = lpat.length()
  if plen == 0 || !lsrc.contains(lpat) {
    return src
  }
  let sb = StringBuilder::new()
  let mut pos = 0
  while pos < src.length() {
    match str_find(lsrc.slice(pos, lsrc.length()), lpat) {
      Some(rel) => {
        sb.write_string(src.slice(pos, pos + rel))
        sb.write_string(rep)
        pos = pos + rel + plen
      }
      None => {
        sb.write_string(src.slice(pos, src.length()))
        break
      }
    }
  }
  sb.to_string()
}

fn svg_resolve_current_color(markup : String, col : String) -> String {
  if col == "" {
    return markup
  }
  svg_replace_ci(markup, "currentColor", col)
}

fn svg_collect_defs(root : html::Node, out : StringBuilder) -> Unit {
  let walk = [root]
  while walk.pop() is Some(e) {
    if e.kind != html::Kind::Element {
      continue
    }
    if e.tag == "defs" {
      for ch in e.children {
        out.write_string(html::outer_html(ch))
      }
      continue
    }
    for ch in e.children {
      walk.push(ch)
    }
  }
}

fn svg_parse_len(s : String, total : Double, fallback : Double) -> Double {
  let t = s.trim()
  if t == "" { return fallback }
  if t.ends_with("%") {
    let p = css::parse_double(t.slice(0, t.length() - 1))
    return p * total / 100.0
  }
  let v = css::parse_double(t)
  if v == 0.0 && !t.starts_with("0") && !t.starts_with("-0") && !t.starts_with(".") { fallback } else { v }
}

fn svg_extract_url_id(v : String) -> String {
  guard str_find(v, "url(") is Some(i) else { return "" }
  let mut rest = v.slice(i + 4, v.length())
  while rest.length() > 0 && (rest.starts_with("\"") || rest.starts_with("'") || rest.starts_with(" ")) {
    rest = rest.slice(1, rest.length())
  }
  guard rest.starts_with("#") else { return "" }
  let sb = StringBuilder::new()
  let mut ri = 1
  while ri < rest.length() {
    let cu = rest.code_unit_at(ri).to_int()
    if cu == 0x22 || cu == 0x27 || cu == 0x29 || cu == 0x20 { break }
    sb.write_string(rest.slice(ri, ri + 1))
    ri += 1
  }
  sb.to_string()
}

fn svg_href_attr(e : html::Node) -> (String, String) {
  match e.attr("href") {
    Some(h) if h.length() > 0 => ("href", h)
    _ => {
      for a in e.attrs {
        if a.qname() == "xlink:href" && a.value.length() > 0 {
          return ("xlink:href", a.value)
        }
      }
      ("", "")
    }
  }
}

fn svg_attr_invalid_xml(qn : String, declared_ns : Map[String, Bool]) -> Bool {
  if qn.length() == 0 {
    return true
  }
  let c0 = qn.code_unit_at(0).to_int()
  let start_ok = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95 || c0 >= 128
  if !start_ok {
    return true
  }
  match str_find(qn, ":") {
    Some(ci) => {
      if ci == 0 || ci + 1 >= qn.length() {
        return true
      }
      let p = qn.slice(0, ci)
      if !declared_ns.contains(p) {
        return true
      }
      str_find(qn.slice(ci + 1, qn.length()), ":").is_some()
    }
    None => false
  }
}

fn svg_strip_invalid_attrs(
  root : html::Node,
  declared_ns : Map[String, Bool],
  stripped_attrs : Array[(html::Node, Array[html::Attr])],
) -> Unit {
  let walk = [root]
  while walk.pop() is Some(e) {
    if e.kind != html::Kind::Element { continue }
    let mut bad = false
    for a in e.attrs {
      if svg_attr_invalid_xml(a.qname(), declared_ns) {
        bad = true
        break
      }
    }
    if bad {
      let saved : Array[html::Attr] = []
      let kept : Array[html::Attr] = []
      for a in e.attrs {
        saved.push(a)
        if !svg_attr_invalid_xml(a.qname(), declared_ns) {
          kept.push(a)
        }
      }
      stripped_attrs.push((e, saved))
      e.attrs = kept
    }
    for ch in e.children { walk.push(ch) }
  }
}

fn svg_collect_declared_ns(root : html::Node) -> (Map[String, Bool], Bool, Bool) {
  let declared_ns : Map[String, Bool] = Map::new()
  declared_ns.set("xml", true)
  declared_ns.set("xmlns", true)
  let mut need_xlink_ns = false
  let mut has_xlink_ns = false
  let ns_walk = [root]
  while ns_walk.pop() is Some(e) {
    if e.kind != html::Kind::Element { continue }
    for a in e.attrs {
      let qn = a.qname()
      if qn.starts_with("xmlns:") {
        let p = qn.slice(6, qn.length())
        declared_ns.set(p, true)
        if p == "xlink" { has_xlink_ns = true }
      } else if qn.starts_with("xlink:") {
        need_xlink_ns = true
      }
    }
    for ch in e.children { ns_walk.push(ch) }
  }
  if need_xlink_ns && !has_xlink_ns {
    declared_ns.set("xlink", true)
  }
  (declared_ns, need_xlink_ns, has_xlink_ns)
}

fn svg_clean_outer_html(g : html::Node) -> String {
  let (g_ns, _, _) = svg_collect_declared_ns(g)
  let g_stripped : Array[(html::Node, Array[html::Attr])] = []
  svg_strip_invalid_attrs(g, g_ns, g_stripped)
  let html_str = html::outer_html(g)
  for sa in g_stripped {
    let (e, saved) = sa
    e.attrs = saved
  }
  html_str
}

fn svg_has_following_elements(root : html::Node, target : html::Node) -> Bool {
  let mut seen = false
  let walk : Array[html::Node] = [root]
  while walk.length() > 0 {
    let cur = walk[walk.length() - 1]
    let _ = walk.pop()
    if cur.kind != html::Kind::Element {
      continue
    }
    if cur.tag == "defs" || cur.tag == "pattern" || cur.tag == "symbol" {
      continue
    }
    if cur.uid == target.uid {
      seen = true
      continue
    }
    if seen {
      return true
    }
    let mut ci = cur.children.length() - 1
    while ci >= 0 {
      walk.push(cur.children[ci])
      ci -= 1
    }
  }
  false
}

fn svg_markup(n : html::Node, opacity : Double, box_w~ : Double = 0.0, box_h~ : Double = 0.0) -> String {
  let changed = svg_styled(n, true, opacity=opacity)
  let outside = StringBuilder::new()
  let seen : Map[String, Bool] = Map::new()
  for x in changed {
    let (e, _) = x
    for prop in ["fill", "stroke"] {
      let v = computed(e, prop)
      guard str_find(v, "url(") is Some(i) else { continue }
      let mut rest = v.slice(i + 4, v.length())
      while rest.length() > 0 && (rest.starts_with("\"") || rest.starts_with("'") || rest.starts_with(" ")) {
        rest = rest.slice(1, rest.length())
      }
      guard rest.starts_with("#") else { continue }
      let mut id = ""
      let mut ri = 1
      while ri < rest.length() {
        let cu = rest.code_unit_at(ri).to_int()
        if cu == 0x22 || cu == 0x27 || cu == 0x29 || cu == 0x20 {
          break
        }
        id = id + rest.slice(ri, ri + 1)
        ri += 1
      }
      if id == "" || seen.contains(id) || by_id(n, id).length() > 0 {
        continue
      }
      seen.set(id, true)
      let found_g = by_id(tree_root(n), id)
      if found_g.length() > 0 {
        let g = found_g[0]
        let gc = svg_styled(g, false)
        outside.write_string(svg_clean_outer_html(g))
        svg_unstyled(gc)
      }
    }
  }
  let use_rewrites : Array[(html::Node, String, String)] = []
  let use_walk = [n]
  while use_walk.pop() is Some(e) {
    if e.kind != html::Kind::Element {
      continue
    }
    if e.tag == "use" {
      let (attr_name, href) = svg_href_attr(e)
      if href.starts_with("#") && href.length() > 1 {
        let id = href.slice(1, href.length()).trim()
        if id != "" && !seen.contains(id) && by_id(n, id).length() == 0 {
          seen.set(id, true)
          let found_g = by_id(tree_root(n), id)
          if found_g.length() > 0 {
            let g = found_g[0]
            if g.tag == "symbol" {
              outside.write_string(svg_resolve_current_color(svg_clean_outer_html(g), svg_srgb(computed(e, "color"))))
            } else {
              let gc = svg_styled(g, false)
              outside.write_string(svg_clean_outer_html(g))
              svg_unstyled(gc)
            }
          }
        }
      } else if str_find(href, "#") is Some(hi) && hi > 0 && hi + 1 < href.length() {
        let url_part = href.slice(0, hi).trim()
        let id = href.slice(hi + 1, href.length()).trim()
        if url_part != "" && id != "" {
          let abs = fetch::resolve(cur_url(), url_part)
          match svg_sprite_doc(abs) {
            Some(ext_root) => {
              let mut inlined = seen.contains(id) || by_id(n, id).length() > 0
              if !inlined {
                let found_g = by_id(ext_root, id)
                if found_g.length() > 0 {
                  seen.set(id, true)
                  let defs_k = "defs:" + abs
                  if !seen.contains(defs_k) {
                    seen.set(defs_k, true)
                    svg_collect_defs(ext_root, outside)
                  }
                  outside.write_string(svg_resolve_current_color(html::outer_html(found_g[0]), svg_srgb(computed(e, "color"))))
                  inlined = true
                }
              }
              if inlined && attr_name != "" {
                for a in e.attrs {
                  if a.qname() == attr_name {
                    use_rewrites.push((e, attr_name, a.value))
                    a.value = "#" + id
                    break
                  }
                }
              }
            }
            None => ()
          }
        }
      }
    } else if e.tag == "image" {
      for a in e.attrs {
        let qn = a.qname()
        if qn != "href" && qn != "xlink:href" {
          continue
        }
        let href = a.value.trim()
        if href == "" || href.starts_with("#") {
          continue
        }
        if href.starts_with("data:") {
          match svg_webp_png_cache.get(href) {
            Some(cached) => {
              if cached != "" {
                use_rewrites.push((e, qn, a.value))
                a.value = cached
              }
            }
            None =>
            match data_url(href) {
              Some(raw) if svg_is_webp_bytes(raw) => {
                let (png_bytes, ok_png) = svg_transcode_webp(raw)
                if ok_png && png_bytes.length() > 0 {
                  let data_uri = "data:image/png;base64," + webauthn::b64_encode(png_bytes)
                  if svg_webp_png_cache.length() >= 256 { svg_webp_png_cache.clear() }
                  svg_webp_png_cache.set(href, data_uri)
                  use_rewrites.push((e, qn, a.value))
                  a.value = data_uri
                }
              }
              _ => ()
            }
          }
          continue
        }
        let abs = fetch::resolve(cur_url(), href)
        let bytes = match st.pictures.get(abs) {
          Some(b) if b.length() > 0 => b
          _ => {
            let (body, _) = fc_get_picture(abs)
            if body.length() > 0 {
              st.pictures.set(abs, body)
            }
            body
          }
        }
        if bytes.length() > 0 {
          let (out_bytes, was_webp) = svg_transcode_webp(bytes)
          let mime = if was_webp { "image/png" } else { svg_image_mime(out_bytes, abs) }
          let data_uri = "data:" + mime + ";base64," + webauthn::b64_encode(out_bytes)
          use_rewrites.push((e, qn, a.value))
          a.value = data_uri
        }
      }
    }
    for ch in e.children {
      use_walk.push(ch)
    }
  }
  let stripped_attrs : Array[(html::Node, Array[html::Attr])] = []
  let (declared_ns, need_xlink_ns, has_xlink_ns) = svg_collect_declared_ns(n)
  svg_strip_invalid_attrs(n, declared_ns, stripped_attrs)
  // When an inline <svg> has a viewBox and relative width/height attrs (e.g. width="1em" height="1em"
  // overridden by CSS width/height: 100%), rewrite root width/height to the viewBox dimensions during serialization
  // so invar/svg rasterizes at the true viewBox aspect ratio instead of squishing into a 1:1 square.
  let mut added_vb = false
  let mut added_w = false
  let mut added_h = false
  match n.attr("viewBox") {
    Some(vb_s) => {
      let vb = layout::svg_numbers(vb_s)
      if vb.length() == 4 && vb[2] > 0.0 && vb[3] > 0.0 {
        let ws = n.attr("width").unwrap_or("").trim()
        let hs = n.attr("height").unwrap_or("").trim()
        let rel = ws.contains("%") || hs.contains("%") ||
        ws.contains("em") || hs.contains("em") ||
        ws.contains("ex") || hs.contains("ex") ||
        ws.contains("ch") || hs.contains("ch")
        if rel {
          for a in n.attrs {
            let qn = a.qname()
            if qn == "width" {
              use_rewrites.push((n, "width", a.value))
              a.value = vb[2].to_string()
            } else if qn == "height" {
              use_rewrites.push((n, "height", a.value))
              a.value = vb[3].to_string()
            }
          }
        }
      }
    }
    None =>
    if box_w > 0.0 && box_h > 0.0 {
      let ws = n.attr("width").unwrap_or("").trim()
      let hs = n.attr("height").unwrap_or("").trim()
      let has_abs_w = ws != "" && !ws.contains("%") && svg_parse_len(ws, 0.0, 0.0) > 0.0
      let has_abs_h = hs != "" && !hs.contains("%") && svg_parse_len(hs, 0.0, 0.0) > 0.0
      if !has_abs_w || !has_abs_h {
        n.push_attr({ prefix: "", name: "viewBox", value: "0 0 " + box_w.to_string() + " " + box_h.to_string(), ns: "" })
        added_vb = true
        if n.attr("width").is_none() {
          n.push_attr({ prefix: "", name: "width", value: box_w.to_string(), ns: "" })
          added_w = true
        } else if !has_abs_w {
          for a in n.attrs {
            if a.qname() == "width" {
              use_rewrites.push((n, "width", a.value))
              a.value = box_w.to_string()
              break
            }
          }
        }
        if n.attr("height").is_none() {
          n.push_attr({ prefix: "", name: "height", value: box_h.to_string(), ns: "" })
          added_h = true
        } else if !has_abs_h {
          for a in n.attrs {
            if a.qname() == "height" {
              use_rewrites.push((n, "height", a.value))
              a.value = box_h.to_string()
              break
            }
          }
        }
      }
    }
  }
  // Expand <pattern patternUnits="userSpaceOnUse"> referenced by <rect fill="url(#id)">
  // into tiled <g transform="translate(tx,ty)"> groups so invar/svg renders exact grid tiles.
  let pat_map : Map[String, (Double, Double, Double, Double, String)] = Map::new()
  let pat_walk = [n]
  while pat_walk.pop() is Some(e) {
    if e.kind != html::Kind::Element { continue }
    if e.tag == "pattern" {
      let id = e.attr("id").unwrap_or("").trim()
      let pu = e.attr("patternUnits").unwrap_or(e.attr("patternunits").unwrap_or("")).trim()
      let pcu = e.attr("patternContentUnits").unwrap_or(e.attr("patterncontentunits").unwrap_or("")).trim()
      if id != "" && pu == "userSpaceOnUse" && pcu != "objectBoundingBox" {
        let px = svg_parse_len(e.attr("x").unwrap_or("0"), 0.0, 0.0)
        let py = svg_parse_len(e.attr("y").unwrap_or("0"), 0.0, 0.0)
        let pw = svg_parse_len(e.attr("width").unwrap_or("0"), 0.0, 0.0)
        let ph = svg_parse_len(e.attr("height").unwrap_or("0"), 0.0, 0.0)
        if pw > 0.5 && ph > 0.5 {
          let inner_sb = StringBuilder::new()
          for ch in e.children {
            inner_sb.write_string(html::outer_html(ch))
          }
          let inner = inner_sb.to_string()
          if inner.length() > 0 {
            pat_map.set(id, (px, py, pw, ph, inner))
          }
        }
      }
    } else {
      for ch in e.children { pat_walk.push(ch) }
    }
  }
  let pat_tiles = StringBuilder::new()
  if pat_map.length() > 0 {
    let mut svg_w = box_w
    let mut svg_h = box_h
    match n.attr("viewBox") {
      Some(vb_s) => {
        let vb = layout::svg_numbers(vb_s)
        if vb.length() == 4 && vb[2] > 0.0 && vb[3] > 0.0 {
          svg_w = vb[2]
          svg_h = vb[3]
        }
      }
      None => {
        if svg_w <= 0.0 { svg_w = svg_parse_len(n.attr("width").unwrap_or(""), 0.0, 0.0) }
        if svg_h <= 0.0 { svg_h = svg_parse_len(n.attr("height").unwrap_or(""), 0.0, 0.0) }
      }
    }
    if svg_w > 0.0 && svg_h > 0.0 {
      let rect_walk = [n]
      while rect_walk.pop() is Some(e) {
        if e.kind != html::Kind::Element { continue }
        if e.tag == "pattern" || e.tag == "defs" { continue }
        if e.tag == "rect" {
          let fill_v = e.attr("fill").unwrap_or("")
          let pid = svg_extract_url_id(fill_v)
          match pat_map.get(pid) {
            Some((px, py, pw, ph, inner)) => {
              let rx = svg_parse_len(e.attr("x").unwrap_or("0"), svg_w, 0.0)
              let ry = svg_parse_len(e.attr("y").unwrap_or("0"), svg_h, 0.0)
              let rw = svg_parse_len(e.attr("width").unwrap_or("100%"), svg_w, svg_w)
              let rh = svg_parse_len(e.attr("height").unwrap_or("100%"), svg_h, svg_h)
              if rw > 0.0 && rh > 0.0 {
                let tx0 = px + ((rx - px) / pw).floor() * pw
                let ty0 = py + ((ry - py) / ph).floor() * ph
                let nx = ((rx + rw - tx0) / pw).ceil().to_int()
                let ny = ((ry + rh - ty0) / ph).ceil().to_int()
                if nx > 0 && ny > 0 && nx * ny <= 64 && !svg_has_following_elements(n, e) {
                  for a in e.attrs {
                    if a.qname() == "fill" {
                      use_rewrites.push((e, "fill", a.value))
                      a.value = "none"
                      break
                    }
                  }
                  pat_tiles.write_string("<g>")
                  let mut iy = 0
                  while iy < ny {
                    let ty = ty0 + iy.to_double() * ph
                    let mut ix = 0
                    while ix < nx {
                      let tx = tx0 + ix.to_double() * pw
                      pat_tiles.write_string("<g transform=\"translate(" + tx.to_string() + "," + ty.to_string() + ")\">")
                      pat_tiles.write_string(inner)
                      pat_tiles.write_string("</g>")
                      ix += 1
                    }
                    iy += 1
                  }
                  pat_tiles.write_string("</g>")
                }
              }
            }
            None => ()
          }
        }
        for ch in e.children { rect_walk.push(ch) }
      }
      if pat_tiles.length() > 0 {
        if n.attr("viewBox").is_none() {
          n.push_attr({ prefix: "", name: "viewBox", value: "0 0 " + svg_w.to_string() + " " + svg_h.to_string(), ns: "" })
          added_vb = true
        }
        for a in n.attrs {
          let qn = a.qname()
          if qn == "width" && a.value.contains("%") {
            use_rewrites.push((n, "width", a.value))
            a.value = svg_w.to_string()
          } else if qn == "height" && a.value.contains("%") {
            use_rewrites.push((n, "height", a.value))
            a.value = svg_h.to_string()
          }
        }
      }
    }
  }
  // Synthesize centered SVG <text> nodes for <foreignObject> HTML labels so invar/svg renders them
  // while inheriting all ancestor <g transform="..."> matrices; popped right after serialization.
  let fo_added : Array[html::Node] = []
  let fo_walk : Array[html::Node] = [n]
  while fo_walk.length() > 0 {
    let cur = fo_walk[fo_walk.length() - 1]
    let _ = fo_walk.pop()
    if cur.kind != html::Kind::Element { continue }
    if cur.tag == "foreignObject" && cur.ns == html::Ns::Svg {
      let txt = svg_foreign_text(cur)
      if txt != "" {
        match cur.parent {
          Some(par) => {
            let fx = svg_parse_len(cur.attr("x").unwrap_or("0"), 0.0, 0.0)
            let fy = svg_parse_len(cur.attr("y").unwrap_or("0"), 0.0, 0.0)
            let fw = svg_parse_len(cur.attr("width").unwrap_or("0"), 0.0, 0.0)
            let fh = svg_parse_len(cur.attr("height").unwrap_or("0"), 0.0, 0.0)
            let mut style_node = cur
            for ch in cur.children {
              if ch.kind == html::Kind::Element {
                style_node = ch
                break
              }
            }
            let fs0 = css::parse_double(computed(style_node, "font-size"))
            let fs = if fs0 > 0.0 { fs0 } else { 16.0 }
            let col0 = svg_srgb(computed(style_node, "color"))
            let col = if col0 != "" && col0 != "transparent" { col0 } else { "#333333" }
            let cx = fx + (if fw > 0.0 { fw / 2.0 } else { 0.0 })
            let cy = fy + (if fh > 0.0 { fh / 2.0 } else { fs * 0.6 })
            let tnode = html::Node::element(html::Ns::Svg, "text", [
              { prefix: "", name: "x", value: cx.to_string(), ns: "" },
              { prefix: "", name: "y", value: cy.to_string(), ns: "" },
              { prefix: "", name: "text-anchor", value: "middle", ns: "" },
              { prefix: "", name: "dominant-baseline", value: "central", ns: "" },
              { prefix: "", name: "font-size", value: fs.to_string() + "px", ns: "" },
              { prefix: "", name: "font-family", value: "sans-serif", ns: "" },
              { prefix: "", name: "fill", value: col, ns: "" },
            ])
            tnode.children = [html::Node::text(txt)]
            par.children.push(tnode)
            fo_added.push(par)
          }
          None => ()
        }
      }
      continue
    }
    let mut ci = cur.children.length() - 1
    while ci >= 0 {
      fo_walk.push(cur.children[ci])
      ci -= 1
    }
  }
  if need_xlink_ns && !has_xlink_ns {
    n.push_attr({ prefix: "xmlns", name: "xlink", value: "http://www.w3.org/1999/xlink", ns: "" })
  }
  let text = html::outer_html(n)
  let mut fi = fo_added.length() - 1
  while fi >= 0 {
    let par = fo_added[fi]
    if par.children.length() > 0 {
      let _ = par.children.pop()
    }
    fi -= 1
  }
  if need_xlink_ns && !has_xlink_ns && n.attrs.length() > 0 {
    let _ = n.attrs.pop()
  }
  if added_h && n.attrs.length() > 0 {
    let _ = n.attrs.pop()
  }
  if added_w && n.attrs.length() > 0 {
    let _ = n.attrs.pop()
  }
  if added_vb && n.attrs.length() > 0 {
    let _ = n.attrs.pop()
  }
  for sa in stripped_attrs {
    let (e, saved) = sa
    e.attrs = saved
  }
  for rw in use_rewrites {
    let (e, attr_name, old_val) = rw
    for a in e.attrs {
      if a.qname() == attr_name {
        a.value = old_val
        break
      }
    }
  }
  svg_unstyled(changed)
  if (outside.length() == 0 && pat_tiles.length() == 0) || !text.ends_with("</svg>") {
    text
  } else {
    let extra = (if outside.length() > 0 { "<defs>" + outside.to_string() + "</defs>" } else { "" }) + pat_tiles.to_string()
    text.slice(0, text.length() - 6) + extra + "</svg>"
  }
}

///|
/// Each element of an svg's tree given its computed paint in its style attribute (see `svg_markup`); what each had,
/// for `svg_unstyled`.
fn svg_srgb(v : String) -> String {
  let tv = v.trim()
  if tv == "" || tv == "none" || tv == "transparent" || tv.starts_with("url(") || tv.starts_with("rgb(") || tv.starts_with("rgba(") || tv.starts_with("#") {
    return tv
  }
  match css::parse_col(css::tokenize(tv)) {
    Some(col) if col.space != "currentcolor" => {
      let c = css::col_to_color(col)
      if c.a >= 1.0 {
        "rgb(\{c.r}, \{c.g}, \{c.b})"
      } else {
        "rgba(\{c.r}, \{c.g}, \{c.b}, \{c.a})"
      }
    }
    _ => tv
  }
}

fn svg_split_rgba(v : String) -> (String, String) {
  let tv = v.trim()
  if !tv.starts_with("rgba(") && !tv.starts_with("rgb(") {
    return (tv, "")
  }
  match css::parse_col(css::tokenize(tv)) {
    Some(col) if col.space != "currentcolor" => {
      let c = css::col_to_color(col)
      if c.a < 0.999 {
        ("rgb(\{c.r}, \{c.g}, \{c.b})", c.a.to_string())
      } else {
        ("rgb(\{c.r}, \{c.g}, \{c.b})", "")
      }
    }
    _ => (tv, "")
  }
}

fn svg_styled(n : html::Node, is_root : Bool, opacity~ : Double = 1.0) -> Array[(html::Node, Option[String])] {
  let changed : Array[(html::Node, Option[String])] = []
  let walk : Array[(html::Node, Bool)] = [(n, false)]
  while walk.pop() is Some((e, in_tmpl0)) {
    if e.kind != html::Kind::Element {
      continue
    }
    let in_tmpl = in_tmpl0 || e.tag == "defs" || e.tag == "symbol"
    let root = is_root && ((e).uid == (n).uid)
    let extra = StringBuilder::new()
    let color = svg_srgb(computed(e, "color"))
    if root && color != "" {
      extra.write_string("color:" + color + ";")
    }
    // the opacity it is drawn under, its own and its ancestors' (a picture is drawn whole: the display list has no
    // opacity for it; Proton's disabled page arrows are at half)
    if root && opacity < 1.0 {
      extra.write_string("opacity:\{opacity};")
    } else if !root {
      let op = computed(e, "opacity")
      if op != "" && op != "1" && op != "1.0" {
        extra.write_string("opacity:" + op + ";")
      }
      let dp = computed(e, "display")
      if dp == "none" {
        extra.write_string("display:none;")
      }
      let vis = computed(e, "visibility")
      if vis == "hidden" || vis == "collapse" {
        extra.write_string("visibility:hidden;")
      }
    }
    // currentColor as the color itself (the picture's renderer reads only its own spelling)
    let own = fn(v : String) { if ascii_lower(v) == "currentcolor" && color != "" { color } else { svg_srgb(v) } }
    if e.tag == "stop" {
      let sc = own(computed(e, "stop-color"))
      if sc != "" {
        extra.write_string("stop-color:" + sc + ";")
      }
    } else if root || (e.tag == "g" || e.tag == "path" || e.tag == "rect" || e.tag == "circle" || e.tag == "ellipse" || e.tag == "line" || e.tag == "polyline" || e.tag == "polygon" || e.tag == "text" || e.tag == "tspan" || e.tag == "use") {
      let mut fill = own(computed(e, "fill"))
      match e.attr("fill") {
        Some(af) => {
          let laf = ascii_lower(af.trim())
          if laf == "currentcolor" && color != "" && (fill == "" || fill == "black" || fill == "rgb(0, 0, 0)") {
            fill = color
          } else if laf != "" && (fill == "black" || fill == "rgb(0, 0, 0)") {
            fill = ""
          }
        }
        None => ()
      }
      if fill != "" && (!(root || e.tag == "use" || (in_tmpl && e.attr("fill").is_none())) || (fill != "black" && fill != "rgb(0, 0, 0)")) {
        let (f_rgb, f_op) = svg_split_rgba(fill)
        extra.write_string("fill:" + f_rgb + ";")
        if f_op != "" {
          extra.write_string("fill-opacity:" + f_op + ";")
        }
      }
      let mut stroke = own(computed(e, "stroke"))
      match e.attr("stroke") {
        Some(ast) => {
          let last = ascii_lower(ast.trim())
          if last == "currentcolor" && color != "" && (stroke == "" || stroke == "none") {
            stroke = color
          } else if last != "" && stroke == "none" {
            stroke = ""
          }
        }
        None => ()
      }
      if stroke != "" && (!(root || e.tag == "use" || (in_tmpl && e.attr("stroke").is_none())) || stroke != "none") {
        let (s_rgb, s_op) = svg_split_rgba(stroke)
        extra.write_string("stroke:" + s_rgb + ";")
        if s_op != "" {
          extra.write_string("stroke-opacity:" + s_op + ";")
        }
      }
      for prop in svg_stroke_props {
        let v = computed(e, prop)
        let skip_tmpl_default = in_tmpl && e.attr(prop).is_none() && (v == "1" || v == "none" || v == "0" || v == "0px" || v == "1px" || v == "butt" || v == "miter")
        if v != "" && !skip_tmpl_default {
          extra.write_string(prop + ":" + v + ";")
        }
      }
    }
    // text in the page's font and size (Proton's calendar icon's day, 7px from a class)
    if (e.tag == "text" || e.tag == "tspan") {
      for prop in ["font-size", "font-weight", "font-style", "text-anchor", "dominant-baseline", "letter-spacing"] {
        let v = computed(e, prop)
        if v != "" {
          extra.write_string(prop + ":" + v + ";")
        }
      }
      let fam = computed(e, "font-family")
      extra.write_string("font-family:" + (if fam == "" { "" } else { fam + ", " }) + "sans-serif;")
    }
    let add = extra.to_string()
    if add != "" {
      let mut found_style = false
      for a in e.attrs {
        if a.qname() == "style" {
          changed.push((e, Some(a.value)))
          let trimmed = a.value.trim()
          a.value = if trimmed == "" || trimmed.ends_with(";") { a.value + add } else { a.value + ";" + add }
          found_style = true
          break
        }
      }
      if !found_style {
        changed.push((e, None))
        e.push_attr({ prefix: "", name: "style", value: add, ns: "" })
      }
    }
    for c in e.children {
      walk.push((c, in_tmpl))
    }
  }
  changed
}

///|
/// The style attributes `svg_styled` changed, as they were.
fn svg_unstyled(changed : Array[(html::Node, Option[String])]) -> Unit {
  for x in changed {
    let (e, old) = x
    match old {
      Some(v) => {
        for a in e.attrs {
          if a.qname() == "style" {
            a.value = v
            break
          }
        }
      }
      None => {
        for i, a in e.attrs {
          if a.qname() == "style" {
            let _ = arr_remove_at(e.attrs, i)
            break
          }
        }
      }
    }
  }
}

///|
/// What a finger drags on this page instead of scrolling it: the elements its scripts follow a finger on (they listen
/// for touches, pointers or mouse presses on them) and those whose style says touch-action: none, each box on the
/// page and whether it is fixed to the viewport. 64 at most.
pub fn drag_areas() -> Array[(Double, Double, Double, Double, Bool)] {
  if !st.started {
    return []
  }
  let ids = js::run("__dragIds()")
  ensure_layout()
  guard st.root is Some(root) else { return [] }
  let rects = match st.rects {
    Some(m) => m
    None => {
      let m = layout::rects(root)
      st.rects = Some(m)
      m
    }
  }
  let fixed = layout::fixed_ids(root)
  let layout_ids = layout::no_touch_ids(root)
  for x in ids.split(",") {
    let i = css::parse_double(x.to_string()).to_int()
    if i > 0 {
      layout_ids.push(at(i).layout_id)
    }
  }
  let out : Array[(Double, Double, Double, Double, Bool)] = []
  for k in layout_ids {
    match intmap::get(rects, k) {
      Some((x, y, w, h)) if w > 0.0 && h > 0.0 && out.length() < 64 => out.push((x, y, w, h, fixed.contains(k)))
      _ => ()
    }
  }
  out
}

///|
/// The element a finger went down on, which its moves and its lift go to (as touches do), by script id.
let pointer_target : Ref[Int] = Ref::{ v: 0 }

///|
/// A finger on the page (0 down, 1 moved, 2 up, at page point x, y): the page's pointer and touch events.
pub fn pointer(kind : Int, x : Double, y : Double) -> Unit {
  if kind == 0 {
    ensure_layout()
    pointer_target.v = match st.root {
      Some(root) =>
      match layout::node_at(root, x, y) {
        Some(n) if n.tag == "iframe" => id_of(node_in_frame(root, n, x, y).unwrap_or(n))
        Some(n) => id_of(svg_target(root, n, x, y))
        None => 0
      }
      None => 0
    }
  }
  if pointer_target.v > 0 {
    bump_version()
    let id = pointer_target.v
    in_context(context_of(at(id)), fn() { js::run("\{hk()}.__pointer(\{id}, \{kind}, \{x}, \{y})") |> ignore })
  }
  if kind == 2 {
    pointer_target.v = 0
  }
}

///|
/// Desktop mouse pointer action ("down", "move", "up") at page coordinates (x, y): drives pointer*/mouse* and HTML5 DnD.
pub fn mouse(kind : String, x : Double, y : Double, button : Int, buttons : Int) -> Unit {
  if !st.started {
    return
  }
  ensure_layout()
  let cx = x
  let cy = y - shown_from.v
  bump_version()
  js::run("\{hk()}.__mouse(\{js_string(kind)}, \{cx}, \{cy}, \{button}, \{buttons}, \"mouse\")") |> ignore
}

///|
fn child_index(n : html::Node) -> Int {
  match n.parent {
    Some(p) => {
      for i, c in p.children {
        if ((c).uid == (n).uid) {
          return i
        }
      }
      -1
    }
    None => -1
  }
}

///|
/// A boundary point's place against another (DOM §5.2): -1 before, 0 equal, 1 after, 2 when in different trees.
fn bp_compare(a : html::Node, ao : Int, b : html::Node, bo : Int) -> Int {
  if ((a).uid == (b).uid) {
    return if ao == bo { 0 } else if ao < bo { -1 } else { 1 }
  }
  let chain = fn(n : html::Node) -> Array[html::Node] {
    let c : Array[html::Node] = [n]
    let mut cur = n.parent
    while cur is Some(p) {
      c.push(p)
      cur = p.parent
    }
    let rev : Array[html::Node] = []
    let mut ri = c.length() - 1
    while ri >= 0 {
      rev.push(c[ri])
      ri -= 1
    }
    rev
  }
  let ca = chain(a)
  let cb = chain(b)
  if !((ca[0]).uid == (cb[0]).uid) {
    return 2
  }
  let mut i = 0
  while i < ca.length() && i < cb.length() && ((ca[i]).uid == (cb[i]).uid) {
    i += 1
  }
  if i == ca.length() {
    // a holds b: the child of a on b's way
    return if child_index(cb[i]) < ao { 1 } else { -1 }
  }
  if i == cb.length() {
    return if child_index(ca[i]) < bo { -1 } else { 1 }
  }
  if child_index(ca[i]) < child_index(cb[i]) {
    -1
  } else {
    1
  }
}

///|
/// A piece of an element's rendered text (HTML's innerText): text as it is, a collapsible space, a forced newline,
/// or a required line break count (0: an edge spaces do not cross).
enum TextItem {
  Word(String)
  Gap
  Newline
  Breaks(Int)
  // an inline-block's (or a replaced element's) edges: spaces just inside them collapse away
  Open
  Close
}

///|
/// Whether an element is being rendered: no display: none on it or an ancestor, and in its document.
fn being_rendered(n : html::Node) -> Bool {
  let mut p : Option[html::Node] = Some(n)
  while p is Some(x) {
    if x.kind == html::Kind::Element && computed(x, "display") == "none" {
      return false
    }
    p = x.parent
  }
  in_any_document(n)
}

///|
/// The rendered text collection steps (HTML §3.2.7) for a node, its items added to `out`.
fn rendered_items(n : html::Node, out : Array[TextItem]) -> Unit {
  match n.kind {
    Text => {
      guard n.parent is Some(p) && p.kind == html::Kind::Element else { return }
      if computed(p, "visibility") != "visible" {
        return
      }
      let ws = computed(p, "white-space")
      let tt = computed(p, "text-transform")
      let text = match tt {
        "uppercase" => ascii_upper(n.data)
        "lowercase" => ascii_lower(n.data)
        _ => n.data
      }
      if ws == "pre" || ws == "pre-wrap" || ws == "break-spaces" {
        // (preserved as written, its newlines forced)
        let parts = str_replace_all(text, "\r\n", "\n").split("\n")
        for i, part in parts {
          if i > 0 {
            out.push(Newline)
          }
          if part != "" {
            out.push(Word(part))
          }
        }
        return
      }
      let keep_newlines = ws == "pre-line"
      let cur = StringBuilder::new()
      let flush = fn() {
        if cur.length() > 0 {
          out.push(Word(cur.to_string()))
          cur.reset()
        }
      }
      let mut ti = 0
      while ti < text.length() {
        let cu = text.code_unit_at(ti).to_int()
        if cu == 0x0A && keep_newlines {
          flush()
          out.push(Newline)
        } else if cu == 0x20 || cu == 0x09 || cu == 0x0A || cu == 0x0D || cu == 0x0C {
          flush()
          out.push(Gap)
        } else {
          cur.write_string(text.slice(ti, ti + 1))
        }
        ti += 1
      }
      flush()
    }
    Element => {
      let display = computed(n, "display")
      if display == "none" {
        return
      }
      let tag = n.tag
      if tag == "br" {
        out.push(Newline)
        return
      }
      // (a select, an input and the like show no text of their children here)
      if replaced_text_less(tag) {
        if (display == "block" || display == "flow-root" || display == "flex" || display == "grid" || display == "table" || display == "list-item") {
          out.push(Breaks(1))
        } else {
          out.push(Open)
          out.push(Close)
        }
        return
      }
      let block = (display == "block" || display == "flow-root" || display == "flex" || display == "grid" || display == "table" || display == "list-item" || display == "table-caption" || display == "math" || display == "ruby-base-container" || display == "grid-lanes")
      let atomic = (display == "inline-block" || display == "inline-flex" || display == "inline-grid" || display == "inline-table")
      let breaks = if tag == "p" && block { 2 } else if block { 1 } else { 0 }
      if breaks > 0 {
        out.push(Breaks(breaks))
      } else if atomic {
        out.push(Open)
      }
      let shadow_children = n.children
      for c in shadow_children {
        rendered_items(c, out)
      }
      if display == "table-cell" && next_with_display(n, "table-cell") {
        out.push(Close)
        out.push(Word("\t"))
        out.push(Open)
      }
      if display == "table-row" && next_with_display(n, "table-row") {
        out.push(Newline)
      }
      if breaks > 0 {
        out.push(Breaks(breaks))
      } else if atomic {
        out.push(Close)
      }
    }
    _ => {
      for c in n.children {
        rendered_items(c, out)
      }
    }
  }
}

///|
/// Whether a later sibling of `n` (in its parent or its table row group's next) has this display.
fn next_with_display(n : html::Node, display : String) -> Bool {
  guard n.parent is Some(p) else { return false }
  let mut seen = false
  for c in p.children {
    if ((c).uid == (n).uid) {
      seen = true
      continue
    }
    if seen && c.kind == html::Kind::Element && computed(c, "display") == display {
      return true
    }
  }
  // (a row followed by the next row group's rows)
  if display == "table-row" {
    match p.parent {
      Some(table) if table.kind == html::Kind::Element => {
        let mut after = false
        for g in table.children {
          if ((g).uid == (p).uid) {
            after = true
            continue
          }
          if after && g.kind == html::Kind::Element {
            for r in g.children {
              if r.kind == html::Kind::Element && computed(r, "display") == "table-row" {
                return true
              }
            }
          }
        }
      }
      _ => ()
    }
  }
  false
}

///|
/// An element's innerText (HTML §3.2.7): its rendered text, or its text content when it is not being rendered.
fn inner_text(n : html::Node) -> String {
  if !being_rendered(n) {
    return html::text_content(n)
  }
  // (a replaced element shows no text of its children)
  if replaced_text_less(n.tag) {
    return ""
  }
  let items : Array[TextItem] = []
  for c in n.children {
    rendered_items(c, items)
  }
  // collapsible spaces: one between words, none at an edge or beside a forced newline or a line break
  let kept : Array[TextItem] = []
  let mut space = false
  // (just inside an inline-block's start: its spaces collapse away)
  let mut inside_start = false
  for it in items {
    match it {
      Gap => if !inside_start { space = true }
      Word(w) => {
        let last_is_word = if kept.length() > 0 {
          match kept[kept.length() - 1] {
            Word(_) => true
            _ => false
          }
        } else {
          false
        }
        if space && last_is_word {
          kept.push(Word(" "))
        }
        space = false
        inside_start = false
        kept.push(Word(w))
      }
      // (an inline-block or replaced element is content: spaces around it stay, those just inside it go)
      Open => {
        let last_is_word = if kept.length() > 0 {
          match kept[kept.length() - 1] {
            Word(_) => true
            _ => false
          }
        } else {
          false
        }
        if space && last_is_word {
          kept.push(Word(" "))
        }
        space = false
        kept.push(Word(""))
        inside_start = true
      }
      Close => {
        space = false
        inside_start = false
        kept.push(Word(""))
      }
      Newline | Breaks(_) => {
        space = false
        inside_start = false
        kept.push(it)
      }
    }
  }
  // required line breaks: a run of them is as many newlines as the most it asks for, none at the start or end
  let b = StringBuilder::new()
  let mut pending = 0
  let mut started = false
  for it in kept {
    match it {
      Word(w) => {
        if started && pending > 0 {
          for _ in 0..<pending {
            b.write_char('\n')
          }
        }
        pending = 0
        started = true
        b.write_string(w)
      }
      Newline => {
        if started && pending > 0 {
          for _ in 0..<pending {
            b.write_char('\n')
          }
        }
        pending = 0
        started = true
        b.write_char('\n')
      }
      Breaks(k) => if k > pending { pending = k }
      Gap | Open | Close => ()
    }
  }
  b.to_string()
}

///|
/// Elements whose children are not rendered as text (replaced elements and form controls showing their own).
fn replaced_text_less(tag : String) -> Bool {
  (tag == "select" || tag == "input" || tag == "textarea" || tag == "img" || tag == "video" || tag == "audio" || tag == "canvas" || tag == "iframe" || tag == "object" || tag == "embed" || tag == "meter" || tag == "progress")
}

///|
/// Ids a frame's global said it holds no more, to be let go between tasks once no other global holds them.
let to_release : Array[(Int, String)] = []

fn parse_csv_nonneg_ints(s : String, out : Array[Int]) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let mut v = 0
    let mut has = false
    while i < n {
      let c = s.code_unit_at(i)
      if c == 44 {
        i += 1
        break
      }
      if c >= 48 && c <= 57 {
        v = v * 10 + (c - 48)
        has = true
      }
      i += 1
    }
    if has {
      out.push(v)
    }
  }
}

let release_waiting_all : Array[Int] = []
let release_waiting_tmp : Array[Int] = []
let release_waiting_drop : Array[Int] = []
let release_waiting_held : intmap::IntMap[Bool] = intmap::IntMap::new()
let release_held_arg : Array[String] = [""]

///|
/// What `to_release` holds, let go where no global (the page's, a frame's) holds it still.
fn release_waiting() -> Unit {
  let tlen = to_release.length()
  if tlen == 0 {
    return
  }
  let src0 = to_release[0].0
  let mut same_src = true
  let list = if tlen == 1 {
    to_release[0].1
  } else {
    let sb = StringBuilder::new()
    let mut ti = 0
    while ti < tlen {
      if ti > 0 {
        sb.write_byte(b',')
      }
      let item = to_release[ti]
      if item.0 != src0 {
        same_src = false
      }
      sb.write_string(item.1)
      ti = ti + 1
    }
    sb.to_string()
  }
  let skip_ctx = if same_src { src0 } else { -1 }
  to_release.clear()
  release_waiting_all.clear()
  release_waiting_tmp.clear()
  release_waiting_drop.clear()
  release_waiting_held.clear()
  release_held_arg[0] = list
  let script = "typeof __heldHost === 'function' ? __heldHost() : ''"
  let ask = fn() {
    let ans = js::run(script)
    if ans.length() > 0 {
      release_waiting_tmp.clear()
      parse_csv_nonneg_ints(ans, release_waiting_tmp)
      for id in release_waiting_tmp {
        release_waiting_held.set(id, true)
      }
      release_waiting_tmp.clear()
    }
  }
  if skip_ctx != 0 {
    in_context(0, ask)
  }
  for i in browsing.keys() {
    if i != skip_ctx {
      in_context(i, ask)
    }
  }
  release_held_arg[0] = ""
  parse_csv_nonneg_ints(list, release_waiting_all)
  if release_waiting_held.len() == 0 {
    release_id_list(release_waiting_all)
  } else {
    for id in release_waiting_all {
      if !release_waiting_held.contains(id) {
        release_waiting_drop.push(id)
      }
    }
    release_id_list(release_waiting_drop)
  }
  release_waiting_all.clear()
  release_waiting_tmp.clear()
  release_waiting_drop.clear()
  release_waiting_held.clear()
}

let release_ids_buf : Array[Int] = []
let release_root_counts : intmap::IntMap[Int] = intmap::IntMap::with_capacity(32)

///|
/// Ids no global holds any more: the nodes let go, and a tree no script holds any node of cut apart.
fn release_ids(s : String) -> Unit {
  release_ids_buf.clear()
  parse_csv_nonneg_ints(s, release_ids_buf)
  release_id_list(release_ids_buf)
  release_ids_buf.clear()
}

fn release_id_list(ids : Array[Int]) -> Unit {
  let release_roots : Array[html::Node] = []
  release_root_counts.clear()
  let nlen = st.nodes.length()
  let mut last_parent_uid = -1
  let mut last_parent_root : Option[html::Node] = None
  let mut last_root_uid = -1
  let mut last_root_cnt = 0
  let mut last_root_node : Option[html::Node] = None
  for i in ids {
    if i >= 0 && i < nlen {
      match st.nodes[i] {
        Some(n) => {
          let r = match n.parent {
            None => if !n.has_host() { n } else { tree_root(n) }
            Some(p) =>
            if p.uid == last_parent_uid {
              match last_parent_root {
                Some(pr) => pr
                None => tree_root(p)
              }
            } else {
              let pr = match p.parent {
                None => if !p.has_host() { p } else { tree_root(p) }
                Some(gp) => if gp.parent is None && !gp.has_host() { gp } else { tree_root(gp) }
              }
              last_parent_uid = p.uid
              last_parent_root = Some(pr)
              pr
            }
          }
          if r.kind != html::Document || !shown_root(r) {
            n.js_id = 0
            st.nodes[i] = None
            release_webgl_id(i)
            release_webgpu_canvas(i)
            if i < id_owner_ctx.length() {
              id_owner_ctx[i] = 0
            }
            free_ids.push(i)
            // (each tree once: what it holds is walked once however many of its nodes go)
            if r.children.length() == 0 && (r.rare is None || (!r.has_shadow() && !r.has_template_content())) {
              if !r.is_of_template() && loose_roots.len() > 0 {
                loose_roots.erase(r.uid)
                dirty_loose_roots.erase(r.uid)
                swept_loose_roots.erase(r.uid)
                swept_held_count.erase(r.uid)
                loose_root_ctx.erase(r.uid)
              }
            } else if r.uid == last_root_uid {
              last_root_cnt += 1
            } else {
              if last_root_cnt > 0 {
                match intmap::get(release_root_counts, last_root_uid) {
                  Some(cnt) => release_root_counts.set(last_root_uid, cnt + last_root_cnt)
                  None => {
                    release_root_counts.set(last_root_uid, last_root_cnt)
                    match last_root_node {
                      Some(lr) => release_roots.push(lr)
                      None => ()
                    }
                  }
                }
              }
              last_root_uid = r.uid
              last_root_cnt = 1
              last_root_node = Some(r)
            }
          }
        }
        None => ()
      }
    }
  }
  if last_root_cnt > 0 {
    let mut direct_cut = false
    match last_root_node {
      Some(lr) =>
      if lr.parent is None && !lr.has_host() && !lr.is_of_template() && lr.js_id == 0 {
        match intmap::get(swept_held_count, last_root_uid) {
          Some(prev_cnt) if prev_cnt <= last_root_cnt => {
            swept_held_count.erase(last_root_uid)
            if loose_roots.len() > 0 {
              loose_roots.erase(last_root_uid)
              if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(last_root_uid) }
              if swept_loose_roots.len() > 0 { swept_loose_roots.erase(last_root_uid) }
              if loose_root_ctx.len() > 0 { loose_root_ctx.erase(last_root_uid) }
            }
            html::cut_detached(lr)
            direct_cut = true
          }
          _ => ()
        }
      }
      None => ()
    }
    if !direct_cut {
      match intmap::get(release_root_counts, last_root_uid) {
        Some(cnt) => release_root_counts.set(last_root_uid, cnt + last_root_cnt)
        None => {
          release_root_counts.set(last_root_uid, last_root_cnt)
          match last_root_node {
            Some(lr) => release_roots.push(lr)
            None => ()
          }
        }
      }
    }
  }
  release_finish_roots(release_roots)
}

fn release_finish_roots(release_roots : Array[html::Node]) -> Unit {
  // a tree no script holds any node of: its parents and children are let go of each other, which hold each other
  // (nodes are counted, not collected: a tree left whole would never be freed)
  for r in release_roots {
    // (a template's content is its template's: cut with it, never apart from it while a script holds the template,
    // which would empty what template.content gives next: Reddit's Lit templates came back empty)
    let released_n = match intmap::get(release_root_counts, r.uid) {
      Some(k) => k
      None => 0
    }
    if r.parent is None && !r.has_host() && !r.is_of_template() && r.js_id == 0 {
      let can_cut = match intmap::get(swept_held_count, r.uid) {
        Some(prev_cnt) => {
          let rem = prev_cnt - released_n
          if rem > 0 {
            swept_held_count.set(r.uid, rem)
            false
          } else {
            swept_held_count.erase(r.uid)
            true
          }
        }
        None => !html::held_in(r)
      }
      if can_cut {
        if loose_roots.len() > 0 {
          loose_roots.erase(r.uid)
          if dirty_loose_roots.len() > 0 { dirty_loose_roots.erase(r.uid) }
          if swept_loose_roots.len() > 0 { swept_loose_roots.erase(r.uid) }
          if loose_root_ctx.len() > 0 { loose_root_ctx.erase(r.uid) }
        }
        html::cut_detached(r)
      }
    } else if swept_held_count.len() > 0 {
      match intmap::get(swept_held_count, r.uid) {
        Some(prev_cnt) => {
          let rem = prev_cnt - released_n
          if rem > 0 {
            swept_held_count.set(r.uid, rem)
          } else {
            swept_held_count.erase(r.uid)
          }
        }
        None => ()
      }
    }
  }
  release_root_counts.clear()
}
