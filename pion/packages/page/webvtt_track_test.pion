///| End-to-end deterministic tests for pure-Pion WebVTT (`webvtt` v0.1.0) + HTML5 `<video><track>` / `VTTCue` / `TextTrack.activeCues` / `cuechange` / host `active_subtitle_text`.

test "HTML5 <video><track default> auto-parses WebVTT via pure-Pion webvtt, updates activeCues/cuechange and active_subtitle_text" {
  // Note: outer page uses `data:text/html;charset=utf-8,...`, which percent-decodes once on load,
  // so `%25` in the outer URL becomes `%` inside the `<track src="data:text/vtt;charset=utf-8,...">` attribute.
  let vtt_enc = "WEBVTT%250A%250A" +
  "cue-zh%250A" +
  "00:00:00.200%2520--%253E%252000:00:01.800%2520align:start%2520line:90%2525%2520position:10%2525%2520size:80%2525%250A" +
  "%253Cv%2520旁白%253E欢迎来到%2520%253Cb%253EFarview%253C/b%253E%2520%2526amp;%2520%253Ci%253EPion%253C/i%253E%2520字幕引擎%250A%250A" +
  "cue-en%250A" +
  "00:00:02.000%2520--%253E%252000:00:04.000%2520align:end%2520vertical:rl%250A" +
  "Hello%2520%253Ci%253EWorld%253C/i%253E%2520%2526lt;WebVTT%2526gt;%250A%250A" +
  "cue-late%250A" +
  "00:00:06.000%2520--%253E%252000:00:08.000%250A" +
  "Final%2520cue%250A"
  let html = "<!doctype html><html><body>" +
  "<video id='v' width='320' height='180'>" +
  "<track id='tr' kind='subtitles' srclang='zh' label='中英字幕' src='data:text/vtt;charset=utf-8," +
  vtt_enc +
  "' default>" +
  "</video>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")

  let meta = eval(
    "(() => {" +
    "const v = document.getElementById('v');" +
    "const trEl = document.getElementById('tr');" +
    "const t = trEl.track;" +
    "const c0 = t.cues[0], c1 = t.cues[1], c2 = t.cues[2];" +
    "const frag0 = c0.getCueAsHTML();" +
    "const bold0 = frag0.querySelector('b') ? frag0.querySelector('b').textContent : '';" +
    "const italic0 = frag0.querySelector('i') ? frag0.querySelector('i').textContent : '';" +
    "return JSON.stringify({" +
    "  rs: trEl.readyState," +
    "  tracksLen: v.textTracks.length," +
    "  mode: t.mode," +
    "  cuesLen: t.cues.length," +
    "  id0: c0.id, s0: c0.startTime, e0: c0.endTime, text0: c0.text," +
    "  align0: c0.align, line0: c0.line, snap0: c0.snapToLines, pos0: c0.position, size0: c0.size, vert0: c0.vertical," +
    "  bold0, italic0, fragText0: frag0.textContent," +
    "  id1: c1.id, text1: c1.text, align1: c1.align, vert1: c1.vertical," +
    "  id2: c2.id, text2: c2.text," +
    "  vidId: v._id" +
    "});" +
    "})()",
  )
  debug_assert(meta.contains("\"rs\":2"), "track readyState must be LOADED (2), got: " + meta)
  debug_assert(meta.contains("\"tracksLen\":1"), "video.textTracks.length must be 1, got: " + meta)
  debug_assert(meta.contains("\"mode\":\"showing\""), "default track mode must be showing, got: " + meta)
  debug_assert(meta.contains("\"cuesLen\":3"), "must parse 3 cues, got: " + meta)
  debug_assert(
    meta.contains("\"text0\":\"欢迎来到 Farview & Pion 字幕引擎\""),
    "cue 0 plain text must decode <v>, <b>, <i>, &amp;, got: " + meta,
  )
  debug_assert(
    meta.contains("\"align0\":\"start\"") &&
    meta.contains("\"line0\":90") &&
    meta.contains("\"snap0\":false") &&
    meta.contains("\"pos0\":10") &&
    meta.contains("\"size0\":80"),
    "cue 0 settings mismatch: " + meta,
  )
  debug_assert(
    meta.contains("\"bold0\":\"Farview\"") && meta.contains("\"italic0\":\"Pion\""),
    "getCueAsHTML() must build <b> and <i> nodes, got: " + meta,
  )
  debug_assert(
    meta.contains("\"text1\":\"Hello World <WebVTT>\"") &&
    meta.contains("\"align1\":\"end\"") &&
    meta.contains("\"vert1\":\"rl\""),
    "cue 1 text/settings mismatch: " + meta,
  )

  let vid_id = css::parse_double(eval("String(document.getElementById('v')._id)")).to_int()
  debug_assert(vid_id > 0, "video node id must be positive")
  // At t=0.0, no cue is active yet (cue 0 starts at 0.2s)
  debug_assert(active_subtitle_text(vid_id) == "", "at t=0.0 active_subtitle_text must be empty")

  // Attach both addEventListener('cuechange') and oncuechange
  let _ = eval(
    "(() => {" +
    "const t = document.getElementById('tr').track;" +
    "globalThis.__ccLog = [];" +
    "globalThis.__onCcCount = 0;" +
    "t.addEventListener('cuechange', () => {" +
    "  const arr = []; for (const c of t.activeCues) arr.push(c.id + ':' + c.text);" +
    "  globalThis.__ccLog.push(arr.join('|'));" +
    "});" +
    "t.oncuechange = () => { globalThis.__onCcCount++; };" +
    "})()",
  )

  // Step 1: advance to 0.5s -> cue-zh active
  let _ = eval("document.getElementById('v').currentTime = 0.5;")
  debug_assert(
    eval("document.getElementById('tr').track.activeCues.length + ':' + document.getElementById('tr').track.activeCues[0].id") == "1:cue-zh",
    "at 0.5s activeCues must contain cue-zh",
  )
  debug_assert(
    active_subtitle_text(vid_id) == "欢迎来到 Farview & Pion 字幕引擎",
    "host active_subtitle_text at 0.5s mismatch: " + active_subtitle_text(vid_id),
  )

  // Step 1b: seek within same cue (0.5s -> 1.0s) must NOT fire duplicate cuechange
  let _ = eval("document.getElementById('v').currentTime = 1.0;")
  debug_assert(eval("String(globalThis.__onCcCount)") == "1", "seeking within same cue must not re-fire cuechange")

  // Step 2: advance to 2.5s -> cue-en active
  let _ = eval("document.getElementById('v').currentTime = 2.5;")
  debug_assert(
    eval("document.getElementById('tr').track.activeCues.length + ':' + document.getElementById('tr').track.activeCues[0].id") == "1:cue-en",
    "at 2.5s activeCues must contain cue-en",
  )
  debug_assert(
    active_subtitle_text(vid_id) == "Hello World <WebVTT>",
    "host active_subtitle_text at 2.5s mismatch: " + active_subtitle_text(vid_id),
  )

  // Step 3: advance to 5.0s -> gap between cue-en (ends 4.0) and cue-late (starts 6.0)
  let _ = eval("document.getElementById('v').currentTime = 5.0;")
  debug_assert(
    eval("String(document.getElementById('tr').track.activeCues.length)") == "0",
    "at 5.0s activeCues must be empty",
  )
  debug_assert(
    active_subtitle_text(vid_id) == "",
    "host active_subtitle_text at 5.0s must be cleared, got: " + active_subtitle_text(vid_id),
  )

  // Verify exact cuechange count and sequence
  let cc_count = eval("String(globalThis.__ccLog.length) + ':' + String(globalThis.__onCcCount)")
  debug_assert(cc_count == "3:3", "expected 3 cuechange events for both listener and oncuechange, got: " + cc_count)
}

test "Programmatic VTTCue, addTextTrack, addCue/removeCue, mode switching, and invalid VTT error" {
  let html = "<!doctype html><html><body>" +
  "<video id='v'></video>" +
  "<video id='vbad'><track id='tbad' src='data:text/vtt;charset=utf-8,NOT_A_VALID_WEBVTT' default></video>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")

  // Invalid WebVTT must set readyState === ERROR (3)
  let bad_rs = eval("String(document.getElementById('tbad').readyState)")
  debug_assert(bad_rs == "3", "invalid WebVTT track must have readyState 3 (ERROR), got: " + bad_rs)

  let vid_id = css::parse_double(eval("String(document.getElementById('v')._id)")).to_int()
  let res = eval(
    "(() => {" +
    "const v = document.getElementById('v');" +
    "const t = v.addTextTrack('captions', 'English', 'en');" +
    "let cc = 0; t.addEventListener('cuechange', () => cc++);" +
    "const c2 = new VTTCue(2.0, 5.0, 'Second cue');" +
    "c2.id = 'c2';" +
    "const c1 = new VTTCue(1.0, 3.0, 'First cue');" +
    "c1.id = 'c1';" +
    "t.addCue(c2); t.addCue(c1);" +
    "const orderOk = t.cues.length === 2 && t.cues[0].id === 'c1' && t.cues[1].id === 'c2';" +
    "const defaultsOk = c1.align === 'center' && c1.line === 'auto' && c1.position === 'auto' && c1.size === 100 && c1.vertical === '' && c1.snapToLines === true;" +
    "v.currentTime = 2.5;" +
    "const bothActive = t.activeCues.length === 2 && t.activeCues[0].id === 'c1' && t.activeCues[1].id === 'c2';" +
    "t.mode = 'showing';" +
    "const showingMode = t.mode;" +
    "globalThis.__t = t; globalThis.__c1 = c1; globalThis.__c2 = c2; globalThis.__cc = () => cc;" +
    "return JSON.stringify({ orderOk, defaultsOk, bothActive, showingMode, cc });" +
    "})()",
  )
  debug_assert(
    res.contains("\"orderOk\":true") &&
    res.contains("\"defaultsOk\":true") &&
    res.contains("\"bothActive\":true") &&
    res.contains("\"showingMode\":\"showing\""),
    "programmatic VTTCue checks failed: " + res,
  )
  // Both c1 and c2 are active at 2.5s and track is showing
  debug_assert(
    active_subtitle_text(vid_id) == "First cue\nSecond cue",
    "overlapping active_subtitle_text mismatch: " + active_subtitle_text(vid_id),
  )

  // removeCue(c1) -> only c2 remains active
  let _ = eval("globalThis.__t.removeCue(globalThis.__c1);")
  debug_assert(
    eval("globalThis.__t.activeCues.length + ':' + globalThis.__t.activeCues[0].id") == "1:c2",
    "after removeCue(c1), only c2 should be active",
  )
  debug_assert(
    active_subtitle_text(vid_id) == "Second cue",
    "after removeCue(c1), active_subtitle_text must be 'Second cue'",
  )

  // Removing already-removed cue must throw NotFoundError
  let not_found = eval(
    "(() => { try { globalThis.__t.removeCue(globalThis.__c1); return 'no-throw'; } catch (e) { return e.name; } })()",
  )
  debug_assert(not_found == "NotFoundError", "removeCue on missing cue must throw NotFoundError, got: " + not_found)

  // mode = 'disabled' -> cues === null, activeCues === null, active_subtitle_text === ""
  let disabled_res = eval(
    "(() => {" +
    "const before = globalThis.__cc();" +
    "globalThis.__t.mode = 'disabled';" +
    "return JSON.stringify({ cuesNull: globalThis.__t.cues === null, activeNull: globalThis.__t.activeCues === null, fired: globalThis.__cc() > before });" +
    "})()",
  )
  debug_assert(
    disabled_res == "{\"cuesNull\":true,\"activeNull\":true,\"fired\":true}",
    "mode='disabled' behavior mismatch: " + disabled_res,
  )
  debug_assert(
    active_subtitle_text(vid_id) == "",
    "mode='disabled' must clear active_subtitle_text, got: " + active_subtitle_text(vid_id),
  )
}
