///| Farview Wave WebGPU-Wire-1: Host op 138 (`webgpu_op`) bridging `js/prelude.js`
///| standard W3C WebGPU APIs (`navigator.gpu` + `canvas.getContext("webgpu")`)
///| to the pure-Pion WGSL->MSL compiler & Apple Silicon Metal backend (`webgpu`).

import "webgpu"
import "raster"
import "intmap"

let webgpu_devices : intmap::IntMap[webgpu::GpuDevice] = intmap::IntMap::new()
let webgpu_buffers : intmap::IntMap[webgpu::GpuBuffer] = intmap::IntMap::new()
let webgpu_textures : intmap::IntMap[webgpu::GpuTexture] = intmap::IntMap::new()
let webgpu_samplers : intmap::IntMap[webgpu::GpuSampler] = intmap::IntMap::new()
let webgpu_shaders : intmap::IntMap[webgpu::GpuShaderModule] = intmap::IntMap::new()
let webgpu_cpipes : intmap::IntMap[webgpu::GpuComputePipeline] = intmap::IntMap::new()
let webgpu_rpipes : intmap::IntMap[webgpu::GpuRenderPipeline] = intmap::IntMap::new()
let webgpu_canvas_tex : intmap::IntMap[Int] = intmap::IntMap::new()
let webgpu_next_handle : Ref[Int] = Ref::{ v: 1 }

fn wgpu_alloc_handle() -> Int {
  let id = webgpu_next_handle.v
  webgpu_next_handle.v = id + 1
  id
}

pub fn webgpu_active_devices() -> Int {
  webgpu_devices.len()
}

pub fn clear_webgpu() -> Unit {
  for id in webgpu_devices.keys() {
    match intmap::get(webgpu_devices, id) {
      Some(dev) => dev.destroy()
      None => ()
    }
  }
  webgpu_devices.clear()
  webgpu_buffers.clear()
  webgpu_textures.clear()
  webgpu_samplers.clear()
  webgpu_shaders.clear()
  webgpu_cpipes.clear()
  webgpu_rpipes.clear()
  webgpu_canvas_tex.clear()
  webgpu_next_handle.v = 1
}

pub fn release_webgpu_canvas(canvas_id : Int) -> Unit {
  match intmap::get(webgpu_canvas_tex, canvas_id) {
    Some(tex_h) => {
      webgpu_canvas_tex.erase(canvas_id)
      match intmap::get(webgpu_textures, tex_h) {
        Some(tex) => {
          tex.destroy()
          webgpu_textures.erase(tex_h)
        }
        None => ()
      }
    }
    None => ()
  }
}

pub fn webgpu_read_rgba_for_canvas(canvas_id : Int) -> Option[(Int, Int, Bytes)] {
  match intmap::get(webgpu_canvas_tex, canvas_id) {
    Some(tex_h) =>
    match intmap::get(webgpu_textures, tex_h) {
      Some(tex) =>
      if tex.width <= 0 || tex.height <= 0 {
        None
      } else {
        match tex.read_rgba8() {
          Ok(rgba) =>
          if rgba.length() == tex.width * tex.height * 4 {
            Some((tex.width, tex.height, rgba))
          } else {
            None
          }
          Err(_) => None
        }
      }
      None => None
    }
    None => None
  }
}

pub fn webgpu_to_png_for_canvas(canvas_id : Int) -> Option[Bytes] {
  match webgpu_read_rgba_for_canvas(canvas_id) {
    Some((w, h, rgba)) => {
      let png = raster::encode_png(rgba, w, h)
      if png.length() > 0 { Some(png) } else { None }
    }
    None => None
  }
}

fn wgpu_destroy_device_resources(dev_id : Int) -> Unit {
  let del_bufs : Array[Int] = []
  for k in webgpu_buffers.keys() {
    match intmap::get(webgpu_buffers, k) {
      Some(v) if v.dev_id == dev_id => del_bufs.push(k)
      _ => ()
    }
  }
  for k in del_bufs {
    webgpu_buffers.erase(k)
  }

  let del_texs : Array[Int] = []
  for k in webgpu_textures.keys() {
    match intmap::get(webgpu_textures, k) {
      Some(v) if v.dev_id == dev_id => del_texs.push(k)
      _ => ()
    }
  }
  let del_canvases : Array[Int] = []
  for cid in webgpu_canvas_tex.keys() {
    match intmap::get(webgpu_canvas_tex, cid) {
      Some(th) =>
      match intmap::get(webgpu_textures, th) {
        Some(v) if v.dev_id == dev_id => del_canvases.push(cid)
        _ => ()
      }
      None => ()
    }
  }
  for cid in del_canvases {
    webgpu_canvas_tex.erase(cid)
  }
  for k in del_texs {
    webgpu_textures.erase(k)
  }

  let del_samps : Array[Int] = []
  for k in webgpu_samplers.keys() {
    match intmap::get(webgpu_samplers, k) {
      Some(v) if v.dev_id == dev_id => del_samps.push(k)
      _ => ()
    }
  }
  for k in del_samps {
    webgpu_samplers.erase(k)
  }

  let del_mods : Array[Int] = []
  for k in webgpu_shaders.keys() {
    match intmap::get(webgpu_shaders, k) {
      Some(v) if v.dev_id == dev_id => del_mods.push(k)
      _ => ()
    }
  }
  for k in del_mods {
    webgpu_shaders.erase(k)
  }

  let del_cp : Array[Int] = []
  for k in webgpu_cpipes.keys() {
    match intmap::get(webgpu_cpipes, k) {
      Some(v) if v.dev_id == dev_id => del_cp.push(k)
      _ => ()
    }
  }
  for k in del_cp {
    webgpu_cpipes.erase(k)
  }

  let del_rp : Array[Int] = []
  for k in webgpu_rpipes.keys() {
    match intmap::get(webgpu_rpipes, k) {
      Some(v) if v.dev_id == dev_id => del_rp.push(k)
      _ => ()
    }
  }
  for k in del_rp {
    webgpu_rpipes.erase(k)
  }
}

fn wgpu_parse_format(fmt : String) -> Int {
  if fmt == "bgra8unorm" {
    webgpu::fmt_bgra8_unorm
  } else if fmt == "depth32float" {
    webgpu::fmt_depth32_float
  } else {
    webgpu::fmt_rgba8_unorm
  }
}

fn wgpu_parse_prim(topo : String) -> Int {
  if topo == "point-list" {
    webgpu::prim_point_list
  } else if topo == "line-list" {
    webgpu::prim_line_list
  } else if topo == "line-strip" {
    webgpu::prim_line_strip
  } else if topo == "triangle-strip" {
    webgpu::prim_triangle_strip
  } else {
    webgpu::prim_triangle_list
  }
}

fn wgpu_parse_addr(mode : String) -> Int {
  if mode == "repeat" {
    webgpu::addr_repeat
  } else if mode == "mirror-repeat" {
    webgpu::addr_mirror_repeat
  } else {
    webgpu::addr_clamp_to_edge
  }
}

fn wgpu_find_default_entry(mod : webgpu::GpuShaderModule, want_stage : Int) -> String {
  // want_stage: 0 = vertex, 1 = fragment, 2 = compute
  let entries = mod.compiled.entries
  let mut i = 0
  while i < entries.length() {
    let ep = entries[i]
    let ok = match ep.stage {
      webgpu::EntryStage::Vertex => want_stage == 0
      webgpu::EntryStage::Fragment => want_stage == 1
      webgpu::EntryStage::Compute => want_stage == 2
    }
    if ok {
      return ep.name
    }
    i = i + 1
  }
  ""
}

fn wgpu_collect_binds(arr : Array[JVal]) -> Array[webgpu::GpuBindEntry] {
  let out : Array[webgpu::GpuBindEntry] = []
  let mut i = 0
  while i < arr.length() {
    match arr[i] {
      JVal::JObj(bo) => {
        let kind = jget_str(bo, "k")
        let grp = jget_int(bo, "g", 0)
        let bnd = jget_int(bo, "b", 0)
        let h = jget_int(bo, "h", 0)
        if kind == "b" {
          match intmap::get(webgpu_buffers, h) {
            Some(buf) => out.push(webgpu::GpuBindEntry::Buffer(grp, bnd, buf))
            None => ()
          }
        } else if kind == "t" {
          match intmap::get(webgpu_textures, h) {
            Some(tex) => out.push(webgpu::GpuBindEntry::Texture(grp, bnd, tex))
            None => ()
          }
        } else if kind == "s" {
          match intmap::get(webgpu_samplers, h) {
            Some(samp) => out.push(webgpu::GpuBindEntry::Sampler(grp, bnd, samp))
            None => ()
          }
        }
      }
      _ => ()
    }
    i = i + 1
  }
  out
}

fn wgpu_find_canvas_for_tex(tex_h : Int) -> Int {
  for cid in webgpu_canvas_tex.keys() {
    match intmap::get(webgpu_canvas_tex, cid) {
      Some(th) if th == tex_h => return cid
      _ => ()
    }
  }
  0
}

fn wgpu_compact_rows(raw : Bytes, w : Int, h : Int, bpr : Int) -> Bytes {
  let row_bytes = w * 4
  if bpr <= 0 || bpr == row_bytes || raw.length() < bpr * h {
    return raw
  }
  let out = Bytes::new(row_bytes * h)
  let mut y = 0
  while y < h {
    let src_off = y * bpr
    let dst_off = y * row_bytes
    let mut x = 0
    while x < row_bytes {
      out[dst_off + x] = raw[src_off + x]
      x = x + 1
    }
    y = y + 1
  }
  out
}

///| Host op 138: WebGPU native Metal bridge.
pub fn webgpu_op(a : Int, b : Int, s : String, t : String) -> String {
  match jparse(s) {
    Some(JVal::JObj(obj)) => {
      let op = jget_str(obj, "k")
      if op == "available" {
        return if webgpu::wgpu_available() { "1" } else { "0" }
      }
      if op == "adapterInfo" {
        if !webgpu::wgpu_available() {
          return "{\"ok\":false}"
        }
        match webgpu::GpuDevice::create() {
          Ok(dev) => {
            let name = dev.name()
            let max_buf = dev.max_buffer_length()
            dev.destroy()
            return "{\"ok\":true,\"name\":" +
            jquote(name) +
            ",\"maxBufferSize\":" +
            max_buf.to_string() +
            "}"
          }
          Err(_) => return "{\"ok\":false}"
        }
      }
      if op == "bindCanvas" {
        if a > 0 {
          if b > 0 {
            webgpu_canvas_tex.set(a, b)
          } else {
            webgpu_canvas_tex.erase(a)
          }
        }
        return ""
      }
      if op == "createDevice" {
        if !webgpu::wgpu_available() {
          return "{\"ok\":false,\"err\":\"WebGPU backend unavailable\"}"
        }
        match webgpu::GpuDevice::create() {
          Ok(dev) => {
            webgpu_devices.set(dev.id, dev)
            let name = dev.name()
            let max_buf = dev.max_buffer_length()
            return "{\"ok\":true,\"id\":" +
            dev.id.to_string() +
            ",\"name\":" +
            jquote(name) +
            ",\"maxBufferSize\":" +
            max_buf.to_string() +
            "}"
          }
          Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
        }
      }

      let dev = match intmap::get(webgpu_devices, a) {
        Some(d) => d
        None => return ""
      }

      if op == "destroyDevice" {
        wgpu_destroy_device_resources(a)
        dev.destroy()
        webgpu_devices.erase(a)
        return ""
      }

      // --- Buffers ---
      if op == "createBuffer" {
        let size = jget_int(obj, "size", 0)
        let usage = jget_int(obj, "usage", 0)
        match dev.create_buffer(size, usage) {
          Ok(buf) => {
            let h = wgpu_alloc_handle()
            webgpu_buffers.set(h, buf)
            return h.to_string()
          }
          Err(_) => return "0"
        }
      }
      if op == "destroyBuffer" {
        match intmap::get(webgpu_buffers, b) {
          Some(buf) => {
            buf.destroy()
            webgpu_buffers.erase(b)
          }
          None => ()
        }
        return ""
      }
      if op == "writeBuffer" {
        let off = jget_int(obj, "off", 0)
        match intmap::get(webgpu_buffers, b) {
          Some(buf) => {
            let raw = latin1_bytes(t)
            let _ = buf.write_bytes(off, raw)
          }
          None => ()
        }
        return ""
      }
      if op == "readBuffer" {
        let off = jget_int(obj, "off", 0)
        let sz = jget_int(obj, "size", 0)
        match intmap::get(webgpu_buffers, b) {
          Some(buf) =>
          match buf.read_bytes(off, sz) {
            Ok(bs) => return bytes_latin1(bs)
            Err(_) => return ""
          }
          None => return ""
        }
      }
      if op == "copyBufferToBuffer" {
        let src_h = jget_int(obj, "src", 0)
        let src_off = jget_int(obj, "srcOff", 0)
        let dst_h = jget_int(obj, "dst", 0)
        let dst_off = jget_int(obj, "dstOff", 0)
        let sz = jget_int(obj, "size", 0)
        match (intmap::get(webgpu_buffers, src_h), intmap::get(webgpu_buffers, dst_h)) {
          (Some(sb), Some(db)) =>
          match sb.read_bytes(src_off, sz) {
            Ok(bs) => {
              let _ = db.write_bytes(dst_off, bs)
              return "1"
            }
            Err(_) => return "0"
          }
          _ => return "0"
        }
      }

      // --- Textures ---
      if op == "createTexture" {
        let w = jget_int(obj, "w", 1)
        let h = jget_int(obj, "h", 1)
        let fmt = wgpu_parse_format(jget_str(obj, "fmt"))
        let usage = jget_int(obj, "usage", webgpu::tex_usage_render_attachment | webgpu::tex_usage_copy_src)
        match dev.create_texture_2d(w, h, fmt, usage) {
          Ok(tex) => {
            let th = wgpu_alloc_handle()
            webgpu_textures.set(th, tex)
            return th.to_string()
          }
          Err(_) => return "0"
        }
      }
      if op == "destroyTexture" {
        match intmap::get(webgpu_textures, b) {
          Some(tex) => {
            let cid = wgpu_find_canvas_for_tex(b)
            if cid > 0 {
              webgpu_canvas_tex.erase(cid)
            }
            tex.destroy()
            webgpu_textures.erase(b)
          }
          None => ()
        }
        return ""
      }
      if op == "writeTexture" {
        let w = jget_int(obj, "w", 0)
        let h = jget_int(obj, "h", 0)
        let bpr = jget_int(obj, "bpr", 0)
        match intmap::get(webgpu_textures, b) {
          Some(tex) => {
            let tw = if w > 0 { w } else { tex.width }
            let th = if h > 0 { h } else { tex.height }
            let raw = wgpu_compact_rows(latin1_bytes(t), tw, th, bpr)
            let _ = tex.write_rgba8(raw)
          }
          None => ()
        }
        return ""
      }

      // --- Samplers ---
      if op == "createSampler" {
        let linear = jget_int(obj, "linear", 0) != 0
        let addr = wgpu_parse_addr(jget_str(obj, "addr"))
        match dev.create_sampler(linear, addr) {
          Ok(samp) => {
            let sh = wgpu_alloc_handle()
            webgpu_samplers.set(sh, samp)
            return sh.to_string()
          }
          Err(_) => return "0"
        }
      }
      if op == "destroySampler" {
        match intmap::get(webgpu_samplers, b) {
          Some(samp) => {
            samp.destroy()
            webgpu_samplers.erase(b)
          }
          None => ()
        }
        return ""
      }

      // --- Shader Modules ---
      if op == "createShaderModule" {
        match dev.create_shader_module_wgsl(t) {
          Ok(mod) => {
            let mh = wgpu_alloc_handle()
            webgpu_shaders.set(mh, mod)
            return "{\"ok\":true,\"id\":" + mh.to_string() + ",\"messages\":[]}"
          }
          Err(err) =>
          return "{\"ok\":false,\"id\":0,\"messages\":[{\"type\":\"error\",\"message\":" +
          jquote(err) +
          ",\"lineNum\":1,\"linePos\":1}]}"
        }
      }
      if op == "destroyShaderModule" {
        match intmap::get(webgpu_shaders, b) {
          Some(mod) => {
            mod.destroy()
            webgpu_shaders.erase(b)
          }
          None => ()
        }
        return ""
      }

      // --- Pipelines ---
      if op == "createComputePipeline" {
        let mod_h = jget_int(obj, "mod", 0)
        let mut entry = jget_str(obj, "entry")
        match intmap::get(webgpu_shaders, mod_h) {
          Some(mod) => {
            if entry == "" {
              entry = wgpu_find_default_entry(mod, 2)
            }
            match dev.create_compute_pipeline(mod, entry) {
              Ok(pipe) => {
                let ph = wgpu_alloc_handle()
                webgpu_cpipes.set(ph, pipe)
                return "{\"ok\":true,\"id\":" + ph.to_string() + "}"
              }
              Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
            }
          }
          None => return "{\"ok\":false,\"err\":\"invalid shader module\"}"
        }
      }
      if op == "createRenderPipeline" {
        let vs_h = jget_int(obj, "vsMod", 0)
        let fs_h = jget_int(obj, "fsMod", 0)
        let mut vs_entry = jget_str(obj, "vsEntry")
        let mut fs_entry = jget_str(obj, "fsEntry")
        let fmt = wgpu_parse_format(jget_str(obj, "fmt"))
        let blend = jget_int(obj, "blend", 0) != 0
        match (intmap::get(webgpu_shaders, vs_h), intmap::get(webgpu_shaders, fs_h)) {
          (Some(vs_mod), Some(fs_mod)) => {
            if vs_entry == "" {
              vs_entry = wgpu_find_default_entry(vs_mod, 0)
            }
            if fs_entry == "" {
              fs_entry = wgpu_find_default_entry(fs_mod, 1)
            }
            match dev.create_render_pipeline(vs_mod, vs_entry, fs_mod, fs_entry, fmt, blend) {
              Ok(pipe) => {
                let ph = wgpu_alloc_handle()
                webgpu_rpipes.set(ph, pipe)
                return "{\"ok\":true,\"id\":" + ph.to_string() + "}"
              }
              Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
            }
          }
          _ => return "{\"ok\":false,\"err\":\"invalid vertex or fragment shader module\"}"
        }
      }

      // --- Queue Submit (batch of compute / render / copyBuf commands) ---
      if op == "submit" {
        let cmds = jget_arr(obj, "cmds")
        let mut ci = 0
        while ci < cmds.length() {
          match cmds[ci] {
            JVal::JObj(cmd) => {
              let ct = jget_str(cmd, "t")
              if ct == "compute" {
                let pipe_h = jget_int(cmd, "pipe", 0)
                let gx = jget_int(cmd, "gx", 1)
                let gy = jget_int(cmd, "gy", 1)
                let gz = jget_int(cmd, "gz", 1)
                let binds = wgpu_collect_binds(jget_arr(cmd, "binds"))
                match intmap::get(webgpu_cpipes, pipe_h) {
                  Some(pipe) => {
                    match dev.dispatch_compute(pipe, binds, gx, gy, gz) {
                      Ok(_) => ()
                      Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
                    }
                  }
                  None => return "{\"ok\":false,\"err\":\"invalid compute pipeline\"}"
                }
              } else if ct == "render" {
                let pipe_h = jget_int(cmd, "pipe", 0)
                let target_h = jget_int(cmd, "target", 0)
                let canvas_id_hint = jget_int(cmd, "canvas", 0)
                let clear_en = jget_int(cmd, "clear", 0) != 0
                let cr = jget_num(cmd, "cr", 0.0)
                let cg = jget_num(cmd, "cg", 0.0)
                let cb = jget_num(cmd, "cb", 0.0)
                let ca = jget_num(cmd, "ca", 1.0)
                let prim = wgpu_parse_prim(jget_str(cmd, "prim"))
                let vstart = jget_int(cmd, "vstart", 0)
                let vcount = jget_int(cmd, "vcount", 0)
                let inst = jget_int(cmd, "inst", 1)
                let binds = wgpu_collect_binds(jget_arr(cmd, "binds"))
                match (intmap::get(webgpu_rpipes, pipe_h), intmap::get(webgpu_textures, target_h)) {
                  (Some(pipe), Some(target)) => {
                    match dev.render_draw(pipe, target, clear_en, cr, cg, cb, ca, binds, prim, vstart, vcount, inst) {
                      Ok(_) => {
                        let cid = if canvas_id_hint > 0 {
                          canvas_id_hint
                        } else {
                          wgpu_find_canvas_for_tex(target_h)
                        }
                        if cid > 0 {
                          last_canvas_draw_ms.v = now_ms().to_int64()
                          canvas_dirty_ids.set(cid, true)
                        }
                      }
                      Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
                    }
                  }
                  _ => return "{\"ok\":false,\"err\":\"invalid render pipeline or target texture\"}"
                }
              } else if ct == "copyBuf" {
                let src_h = jget_int(cmd, "src", 0)
                let src_off = jget_int(cmd, "srcOff", 0)
                let dst_h = jget_int(cmd, "dst", 0)
                let dst_off = jget_int(cmd, "dstOff", 0)
                let sz = jget_int(cmd, "size", 0)
                match (intmap::get(webgpu_buffers, src_h), intmap::get(webgpu_buffers, dst_h)) {
                  (Some(sb), Some(db)) =>
                  match sb.read_bytes(src_off, sz) {
                    Ok(bs) => {
                      match db.write_bytes(dst_off, bs) {
                        Ok(_) => ()
                        Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
                      }
                    }
                    Err(err) => return "{\"ok\":false,\"err\":" + jquote(err) + "}"
                  }
                  _ => return "{\"ok\":false,\"err\":\"invalid buffer in copyBufferToBuffer\"}"
                }
              }
            }
            _ => ()
          }
          ci = ci + 1
        }
        return "{\"ok\":true}"
      }
      ""
    }
    _ => ""
  }
}
