///| Compatibility bridges and host-platform helpers for `pion/packages/page`.
///| Connects `hostfont` -> `layout::FontBackend`, libc `getenv`/`puts`, clock, and already-ported
///| `page_aux` / `page_mid` / `webauthn` / `media` / `raster` / `page_js` packages.

import "html"
import "css"
import "layout"
import "hostfont"
import "fetch"
import "url"
import "page_js"
import "page_aux"
import "page_mid"
import "webauthn"
import "media"
import "raster"
import "intmap"

pub struct Ref[T] {
  pub mut v : T
}

pub fn ignore[T](_x : T) -> Unit {
  ()
}

extern "C" fn c_getenv(name : Ptr) -> Ptr = "getenv"
extern "C" fn c_puts(s : Ptr) -> Int = "puts"

pub fn byte_str(b : Int) -> String {
  let bs = Bytes::new(1)
  bs[0] = (b & 0xFF).to_byte()
  bs.to_string()
}

pub fn nul_str() -> String {
  byte_str(0)
}

pub fn stx_str() -> String {
  byte_str(2)
}

pub fn etx_str() -> String {
  byte_str(3)
}

pub fn println(s : String) -> Unit {
  let cstr = (s + nul_str()).to_bytes()
  let _ = c_puts(bytes_data_ptr(cstr))
}

pub fn env_var(name : String) -> Option[String] {
  let cstr = (name + nul_str()).to_bytes()
  let p = c_getenv(bytes_data_ptr(cstr))
  if ptr_is_null(p) {
    Option::None
  } else {
    Option::Some(cstr_to_str(p))
  }
}

pub fn env_has(name : String) -> Bool {
  env_var(name).is_some()
}

pub fn now_ms() -> Int {
  (fetch::now_us() / 1000L).to_int()
}

fn map_path_cmds(cmds : Array[hostfont::PathCmd]) -> Array[layout::PathCmd] {
  let out : Array[layout::PathCmd] = []
  let mut i = 0
  while i < cmds.length() {
    match cmds[i] {
      hostfont::PathCmd::MoveTo(x, y) => out.push(layout::PathCmd::MoveTo(x, y))
      hostfont::PathCmd::LineTo(x, y) => out.push(layout::PathCmd::LineTo(x, y))
      hostfont::PathCmd::QuadTo(cx, cy, x, y) => out.push(layout::PathCmd::QuadTo(cx, cy, x, y))
      hostfont::PathCmd::CubicTo(c1x, c1y, c2x, c2y, x, y) => out.push(layout::PathCmd::CubicTo(c1x, c1y, c2x, c2y, x, y))
      hostfont::PathCmd::Close => out.push(layout::PathCmd::Close)
    }
    i = i + 1
  }
  out
}

pub fn make_host_fonts() -> layout::Fonts {
  let fb_paths = hostfont::fallback_files()
  let fallbacks : Array[(String, () -> Option[Bytes])] = []
  let mut i = 0
  while i < fb_paths.length() {
    let p = fb_paths[i]
    fallbacks.push((p, fn() -> Option[Bytes] { hostfont::read_font_file(p) }))
    i = i + 1
  }
  let backend = layout::FontBackend::{
    family_files: fn(family : String) -> Array[(String, () -> Option[Bytes])] {
      let paths = hostfont::files_of(family)
      let out : Array[(String, () -> Option[Bytes])] = []
      let mut k = 0
      while k < paths.length() {
        let p = paths[k]
        out.push((p, fn() -> Option[Bytes] { hostfont::read_font_file(p) }))
        k = k + 1
      }
      out
    },
    fallback_files: fallbacks,
    system_fallback: fn(family : String, cp : Int, weight : Int) -> Option[(String, String, () -> Option[Bytes])] {
      match hostfont::coretext_fallback(family, cp, weight) {
        Option::Some((path, ps)) => Option::Some((path, ps, fn() -> Option[Bytes] { hostfont::read_font_file(path) }))
        Option::None => Option::None
      }
    },
    system_outline: fn(ps : String, glyph : Int, upem : Int, wght : Int) -> Option[Array[layout::PathCmd]] {
      match hostfont::system_outline(ps, glyph, upem, wght) {
        Option::Some(cmds) => Option::Some(map_path_cmds(cmds))
        Option::None => Option::None
      }
    },
  }
  layout::Fonts::with_backend(backend)
}

pub fn ascii_upper(s : String) -> String {
  let src = s.to_bytes()
  let n = src.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let c = src[i].to_int() & 0xFF
    out[i] = if c >= 97 && c <= 122 { (c - 32).to_byte() } else { src[i] }
    i = i + 1
  }
  out.to_string()
}

pub fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut has_upper = false
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      has_upper = true
      break
    }
    i = i + 1
  }
  if !has_upper {
    return s
  }
  let src = s.to_bytes()
  let bn = src.length()
  let out = Bytes::new(bn)
  i = 0
  while i < bn {
    let c = src[i].to_int() & 0xFF
    out[i] = if c >= 65 && c <= 90 { (c + 32).to_byte() } else { src[i] }
    i = i + 1
  }
  out.to_string()
}

pub fn str_find(s : String, needle : String) -> Option[Int] {
  let i = s.index_of(needle)
  if i >= 0 {
    Option::Some(i)
  } else {
    Option::None
  }
}

pub fn str_rev_find(s : String, needle : String) -> Option[Int] {
  let sb = s.to_bytes()
  let nb = needle.to_bytes()
  let sl = sb.length()
  let nl = nb.length()
  if nl == 0 || nl > sl {
    return Option::None
  }
  let mut i = sl - nl
  while i >= 0 {
    let mut ok = true
    let mut j = 0
    while j < nl {
      if sb[i + j] != nb[j] {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return Option::Some(i)
    }
    i = i - 1
  }
  Option::None
}

pub fn data_url(u : String) -> Option[Bytes] {
  url::data_url_bytes(u)
}

pub fn data_url_type(u : String) -> String {
  page_aux::data_url_type(u)
}

pub fn utf8_decode_lossy(b : Bytes) -> String {
  b.to_string()
}

pub fn utf8_encode(s : String) -> Bytes {
  s.to_bytes()
}

pub fn soh_str() -> String {
  let b = Bytes::new(1)
  b[0] = 1.to_byte()
  b.to_string()
}

pub fn prelude_js() -> String {
  page_js::prelude_js()
}

pub fn editing_js() -> String {
  page_js::editing_js()
}

fn normalize_shadow_color(col : String, cur : String) -> String {
  if col == "" {
    return cur
  }
  match css::parse_col(css::tokenize(col)) {
    Option::Some(c) if c.space != "currentcolor" => css::col_text(c)
    Option::Some(_) => cur
    Option::None => col
  }
}

pub fn shadow_mix(a : String, b : String, p : Double, prop : String) -> Option[String] {
  let is_box = prop == "box-shadow"
  let na = ascii_lower(a.trim()) == "none"
  let nb = ascii_lower(b.trim()) == "none"
  if na && nb {
    return Option::Some("none")
  }
  let la_opt = page_mid::parse_shadows(a, "rgba(0, 0, 0, 0)", is_box)
  let lb_opt = page_mid::parse_shadows(b, "rgba(0, 0, 0, 0)", is_box)
  if (la_opt.is_none() && !na) || (lb_opt.is_none() && !nb) {
    return Option::None
  }
  let la = la_opt.unwrap_or([])
  let lb = lb_opt.unwrap_or([])
  let n = if la.length() > lb.length() { la.length() } else { lb.length() }
  let out : Array[page_mid::ShadowSpec] = []
  let mut i = 0
  while i < n {
    let x = if i < la.length() {
      la[i]
    } else {
      let zs : Array[Double] = []
      let mut z = 0
      while z < lb[i].lens.length() { zs.push(0.0); z = z + 1 }
      page_mid::ShadowSpec::{ color: "rgba(0, 0, 0, 0)", lens: zs, inset: lb[i].inset }
    }
    let y = if i < lb.length() {
      lb[i]
    } else {
      let zs : Array[Double] = []
      let mut z = 0
      while z < la[i].lens.length() { zs.push(0.0); z = z + 1 }
      page_mid::ShadowSpec::{ color: "rgba(0, 0, 0, 0)", lens: zs, inset: la[i].inset }
    }
    if x.inset != y.inset || x.lens.length() != y.lens.length() {
      return Option::None
    }
    let xc = normalize_shadow_color(x.color, "rgba(0, 0, 0, 0)")
    let yc = normalize_shadow_color(y.color, "rgba(0, 0, 0, 0)")
    let color = css::interpolate_colors(xc, yc, p).unwrap_or(if p < 0.5 { xc } else { yc })
    let lens : Array[Double] = []
    let mut k = 0
    while k < x.lens.length() {
      let r = x.lens[k] + (y.lens[k] - x.lens[k]) * p
      lens.push(if k == 2 && r < 0.0 { 0.0 } else { r })
      k = k + 1
    }
    out.push(page_mid::ShadowSpec::{ color: color, lens: lens, inset: x.inset })
    i = i + 1
  }
  Option::Some(page_mid::shadows_to_text(Option::Some(out)))
}

pub fn shadow_value_text(s : css::Style, prop : String) -> String {
  let raw = css::serialize_value(s.get(prop))
  if raw == "" || raw == "none" {
    return "none"
  }
  let cur = match s.color("color") {
    Option::Some(c) if c.a >= 1.0 => "rgb(\{c.r}, \{c.g}, \{c.b})"
    Option::Some(c) => "rgba(\{c.r}, \{c.g}, \{c.b}, \{c.a})"
    Option::None => "rgb(0, 0, 0)"
  }
  match page_mid::parse_shadows(raw, cur, prop == "box-shadow") {
    Option::Some(list) => {
      let norm : Array[page_mid::ShadowSpec] = []
      for sh in list {
        norm.push(page_mid::ShadowSpec::{
          color: normalize_shadow_color(sh.color, cur),
          lens: sh.lens,
          inset: sh.inset,
        })
      }
      page_mid::shadows_to_text(Option::Some(norm))
    }
    Option::None => raw
  }
}

pub fn indiv_mix(a : String, b : String, p : Double, prop : String) -> Option[String] {
  page_mid::indiv_mix(a, b, p, prop)
}

pub fn indiv_add(a : String, b : String, acc : Bool, prop : String) -> Option[String] {
  page_mid::indiv_add(a, b, acc, prop)
}

pub fn has_percentage_tok(ts : Array[css::Tok]) -> Bool {
  for t in ts {
    match t {
      css::Tok::Percentage(_) => return true
      _ => ()
    }
  }
  false
}

pub fn raster_size_of(data : Bytes) -> Option[(Int, Int)] {
  match raster::image_size(data) {
    Option::Some(sz) => Option::Some(sz)
    Option::None => {
      let (w, h) = fetch::picture_size(data)
      if w > 0 && h > 0 {
        Option::Some((w, h))
      } else {
        Option::None
      }
    }
  }
}

// --- Shared dirty flags & subsystem singletons bridged to page_aux / page_mid / webauthn / media ---

pub fn arr_remove_at[T](a : Array[T], idx : Int) -> T {
  let v = a[idx]
  let mut i = idx
  while i + 1 < a.length() {
    a[i] = a[i + 1]
    i = i + 1
  }
  let _ = a.pop()
  v
}

pub fn imin(a : Int, b : Int) -> Int {
  if a < b { a } else { b }
}

pub fn imax(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

pub fn dmin(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

pub fn dmax(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

pub fn dclamp(v : Double, lo : Double, hi : Double) -> Double {
  if v < lo { lo } else if v > hi { hi } else { v }
}

pub fn str_replace_all(s : String, old : String, rep : String) -> String {
  if old == "" {
    return s
  }
  s.split(old).join(rep)
}

pub fn str_repeat(s : String, n : Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

