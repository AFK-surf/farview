pub fn image_choice(n : html::Node, base : String, vw : Double) -> Option[(String, Double)] {
  let srcs : Array[page_aux::PictureSource] = []
  let env = css::Env::new(st.w, st.h)
  match n.parent {
    Option::Some(p) if p.kind == html::Kind::Element && p.tag == "picture" => {
      for c in p.children {
        if c.uid == n.uid {
          break
        }
        if c.kind == html::Kind::Element && c.tag == "source" {
          let mq = c.attr("media").unwrap_or("")
          let matches = mq == "" || css::media_query_matches(env, mq)
          srcs.push(
            page_aux::PictureSource::{
              srcset: c.attr("srcset").unwrap_or(""),
              mime_type: c.attr("type").unwrap_or(""),
              media_matches: matches,
            },
          )
        }
      }
    }
    _ => ()
  }
  match page_aux::select_image_choice(srcs, n.attr("src").unwrap_or(""), n.attr("srcset").unwrap_or(""), vw, css::media_dpr()) {
    Option::Some((u, dpr)) => Option::Some((fetch::resolve(base, u), dpr))
    Option::None => Option::None
  }
}

pub fn image_source(n : html::Node, base : String) -> Option[String] {
  match image_choice(n, base, st.w) {
    Option::Some((u, _)) => Option::Some(u)
    Option::None => Option::None
  }
}
