///| Back/Forward's own document copies (fetch_cache.pion `hist_docs`): shown as the document was, never as a response
///| received again (no old Set-Cookie back in the jar), kept per Space, passed over once a cookie it was shown with is
///| gone (a sign-out), dropped on a Space change or a later no-store answer for the same address. Each test leaves the
///| Space partition, the jar and the copies as it found them ("default", empty, none).

import "page_aux"
import "security"

fn hist_cookie(base : String) -> String {
  sec_cookie_header_for_request(base + "/", true, "GET")
}

test "history copy: Back shows the page as it was without putting its old Set-Cookie back" {
  let port = page_aux::storage_test_http_start(4)
  debug_assert(port > 0, "loopback server")
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  clear_page_cookie_jar()
  set_space_partition_key("hist-space-a")
  fc_history_forget_all()
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(hist_cookie(base) == "sess=S1", "signed in: sess=S1, got " + hist_cookie(base))
  debug_assert(fc_history_count() == 1, "the page is kept for Back")
  // the session turns over on another page
  let _ = load(base + "/hist-rotate", 800.0, 600.0)
  debug_assert(hist_cookie(base) == "sess=S2", "rotated: sess=S2, got " + hist_cookie(base))
  let hits = page_aux::storage_test_http_hits()
  // Back to the first page: its copy, no request, and the jar keeps the session as it now is
  let switches = coop_bcg_switch_count()
  fc_history_nav(true)
  let _ = load(base + "/hist-login", 800.0, 600.0)
  fc_history_nav(false)
  debug_assert(fc_last_from_history(), "Back took the history's copy")
  debug_assert(page_aux::storage_test_http_hits() == hits, "no request for Back")
  debug_assert(title() == "in", "the first page shown again, got " + title())
  debug_assert(hist_cookie(base) == "sess=S2", "the old Set-Cookie did not come back: " + hist_cookie(base))
  debug_assert(coop_bcg_switch_count() == switches, "no browsing context group switch counted for a history copy")
  debug_assert(current_coop().value is security::CoopValue::SameOrigin, "the document's own COOP is its policy again")
  // a page loaded anew still takes its cookies
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(!fc_last_from_history(), "a plain load is a new response")
  debug_assert(hist_cookie(base) == "sess=S1", "a new response sets its cookie")
  clear_page_cookie_jar()
  set_space_partition_key("default")
}

test "history copy: kept per Space; a Space change and clearing cookies drop it, a sign-out passes it over" {
  let port = page_aux::storage_test_http_start(6)
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  clear_page_cookie_jar()
  set_space_partition_key("hist-space-a")
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(fc_history_count() == 1, "kept in Space a")
  // another Space: none of Space a's copies are there
  set_space_partition_key("hist-space-b")
  debug_assert(fc_history_count() == 0, "another Space starts with none")
  let hits = page_aux::storage_test_http_hits()
  fc_history_nav(true)
  let _ = load(base + "/hist-login", 800.0, 600.0)
  fc_history_nav(false)
  debug_assert(!fc_last_from_history() && page_aux::storage_test_http_hits() == hits + 1, "Back in Space b fetched anew")
  // the same address kept by Space b is not Space a's
  debug_assert(hist_doc_find("hist-space-a", base + "/hist-login").is_none(), "Space b's copy is not found for Space a")
  debug_assert(hist_doc_find("hist-space-b", base + "/hist-login").is_some(), "Space b's own copy")
  // a sign-out (the session cookie deleted): Back to the signed-in page fetches it anew, not its signed-in copy
  let _ = load(base + "/hist-logout", 800.0, 600.0)
  debug_assert(hist_cookie(base) == "", "signed out")
  let out_hits = page_aux::storage_test_http_hits()
  fc_history_nav(true)
  let _ = load(base + "/hist-login", 800.0, 600.0)
  fc_history_nav(false)
  debug_assert(!fc_last_from_history() && page_aux::storage_test_http_hits() == out_hits + 1, "signed out: Back fetched anew")
  debug_assert(fc_history_count() >= 1, "kept again, as it now came")
  clear_page_cookie_jar()
  debug_assert(fc_history_count() == 0, "clearing the cookie jar drops them")
  set_space_partition_key("default")
}

test "history copy: a cookie a page sets and takes away again (a cookie check) leaves the copies be" {
  let port = page_aux::storage_test_http_start(3)
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  clear_page_cookie_jar()
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(hist_cookie(base) == "sess=S1", "signed in")
  let _ = load(base + "/hist-probe", 800.0, 600.0)
  debug_assert(title() == "pr" && hist_cookie(base) == "sess=S1", "the check's cookie came and went, got " + hist_cookie(base))
  let hits = page_aux::storage_test_http_hits()
  fc_history_nav(true)
  let _ = load(base + "/hist-login", 800.0, 600.0)
  fc_history_nav(false)
  debug_assert(fc_last_from_history() && page_aux::storage_test_http_hits() == hits, "Back took its copy")
  clear_page_cookie_jar()
  set_space_partition_key("default")
}

test "history copy: a later no-store answer for the address drops its copy; headers kept without Set-Cookie" {
  let port = page_aux::storage_test_http_start(3)
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  fc_history_forget_all()
  let _ = load(base + "/hist-flip", 800.0, 600.0)
  debug_assert(hist_doc_find(sec_space_partition(), base + "/hist-flip").is_some(), "first answer kept")
  let _ = load(base + "/hist-flip", 800.0, 600.0)
  debug_assert(hist_doc_find(sec_space_partition(), base + "/hist-flip").is_none(), "no-store answer dropped the old copy")
  let hits = page_aux::storage_test_http_hits()
  fc_history_nav(true)
  let _ = load(base + "/hist-flip", 800.0, 600.0)
  fc_history_nav(false)
  debug_assert(page_aux::storage_test_http_hits() == hits + 1 && title() == "f2", "Back fetched it anew")
  let kept = hist_headers_kept("HTTP/1.1 200 OK\nContent-Type: text/html\nSet-Cookie: a=1\nset-cookie2: b=2\nX-A: 1")
  debug_assert(kept == "HTTP/1.1 200 OK\nContent-Type: text/html\nX-A: 1", "Set-Cookie lines removed, got " + kept)
  debug_assert(hist_cookie_names("Referer: x\nCookie: a=1; b = 2 ;c\n").join(",") == "a,b,c", "a Cookie line's names")
  clear_page_cookie_jar()
  set_space_partition_key("default")
}

test "history copy: no-store on any of several Cache-Control lines is not kept" {
  let port = page_aux::storage_test_http_start(1)
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  fc_history_forget_all()
  let _ = load(base + "/hist-two-cc", 800.0, 600.0)
  debug_assert(title() == "tc", "loaded, got " + title())
  debug_assert(hist_doc_find(sec_space_partition(), base + "/hist-two-cc").is_none(), "Cache-Control: private + no-store: no copy")
  debug_assert(fc_history_count() == 0, "nothing kept")
  set_space_partition_key("default")
}

test "history copy: a Back to a data: address takes the history flag, the next plain load is a new response" {
  let port = page_aux::storage_test_http_start(2)
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  clear_page_cookie_jar()
  fc_history_forget_all()
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(fc_history_count() == 1, "kept")
  fc_history_nav(true)
  let _ = load("data:text/html,<title>d</title>", 800.0, 600.0)
  // (no fc_history_nav(false): the data: fetch itself must have taken it)
  let hits = page_aux::storage_test_http_hits()
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(!fc_last_from_history(), "a plain load after a data: Back is not a history copy")
  debug_assert(page_aux::storage_test_http_hits() == hits + 1, "it was fetched anew")
  fc_history_nav(false)
  clear_page_cookie_jar()
  set_space_partition_key("default")
}
