///| Files dragged in from the person's desktop (sync.pion: drag_over, drag_leave, drop_files; prelude __dragOver,
///| __dragLeave, __dropFiles) and a file input's picker asked only in the person's activation (prelude
///| takeActivation, take_file_picks).

fn js_id_uid(expr : String) -> Int {
  let id = cdp_parse_int(eval("String(" + expr + "._id)").trim())
  if id <= 0 { 0 } else { at(id).uid }
}

test "dropped files reach a drop zone's drop with File objects and DataTransfer items, or fill a file input; elsewhere nothing" {
  let html = "<!doctype html><html><body style='margin:0'>" +
  "<div id='zone' style='position:absolute;left:0;top:0;width:200px;height:100px'>zone</div>" +
  "<input id='f' type='file' multiple style='position:absolute;left:0;top:150px;width:200px;height:30px'>" +
  "<p id='plain' style='position:absolute;left:0;top:250px;width:200px;height:30px;margin:0'>plain</p>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")
  let _ = eval(
    "globalThis.__log = [];" +
    "const z = document.getElementById('zone');" +
    "z.addEventListener('dragenter', e => __log.push('enter:' + e.dataTransfer.types.join('+') + ':' + e.dataTransfer.items.length + ':' + e.dataTransfer.items[0].kind + ':' + e.dataTransfer.files.length));" +
    "z.addEventListener('dragover', e => { e.preventDefault(); __log.push('over:' + (e.dataTransfer.items[0].getAsFile() === null)); });" +
    "z.addEventListener('dragleave', e => __log.push('leave'));" +
    // (as react-dropzone's file-selector reads a drop: items by index, each its kind, then getAsFile)
    "z.addEventListener('drop', e => { e.preventDefault(); const dt = e.dataTransfer, f = dt.files, got = [];" +
    "  for (let i = 0; i < dt.items.length; i++) { const it = dt.items[i]; if (it.kind === 'file') got.push(it.getAsFile().name); }" +
    "  const ent = dt.items[0].webkitGetAsEntry();" +
    "  __log.push('drop:' + f.length + ':' + f[0].name + ':' + f[0].type + ':' + f[0].size + ':' + e.isTrusted + ':' + got.join('+') + ':' + [...dt.items].length + ':' + ent.isFile + ':' + ent.name); });" +
    "const inp = document.getElementById('f');" +
    "inp.addEventListener('drop', e => __log.push('inputdrop'));" +
    "inp.addEventListener('change', e => __log.push('change:' + e.target.files.length + ':' + e.target.files[1].name));",
  )
  let files = [("notes.txt", "text/plain", "hello".to_bytes()), ("b.png", "image/png", "PNG".to_bytes())]
  // (held over the zone, moved within it, then let go: one dragenter, a dragover each move, the drop)
  debug_assert(drag_over(0, 0.0, 0.0, 50.0, 50.0), "the zone takes the drag")
  debug_assert(drag_over(0, 0.0, 0.0, 60.0, 50.0), "still over the zone")
  debug_assert(drop_files(0, 0.0, 0.0, 60.0, 50.0, files), "the zone takes them")
  // (let go on a file input whose dragover nobody cancelled: its own default takes them, its drop fires first)
  debug_assert(drop_files(0, 0.0, 0.0, 50.0, 160.0, files), "the input takes them")
  debug_assert(!drop_files(0, 0.0, 0.0, 50.0, 260.0, files), "plain text takes none")
  let log = eval("__log.join('|')")
  debug_assert(log.contains("enter:Files:1:file:0|over:true|over:true|drop:2:notes.txt:text/plain:5:true:notes.txt+b.png:2:true:notes.txt"), "zone events: " + log)
  debug_assert(log.contains("inputdrop|change:2:b.png"), "input dropped on, then filled: " + log)
  // (the point given as the element under it and its fraction, as the client's Pointer says it)
  let _ = eval("__log = [];")
  let zone = js_id_uid("document.getElementById('zone')")
  debug_assert(zone > 0, "the zone's uid")
  debug_assert(drag_over(zone, 0.5, 0.5, 700.0, 500.0), "over the zone by its element, whatever the point")
  // (carried off the page: dragleave)
  drag_leave()
  let log2 = eval("__log.join('|')")
  debug_assert(log2 == "enter:Files:1:file:0|over:true|leave", "drag over and off: " + log2)
}

test "files dropped on a drop zone in a frame reach the frame's own drop" {
  let html = "<!doctype html><html><body style='margin:0'>" +
  "<iframe id='fr' style='border:0;width:300px;height:200px' srcdoc=\"<body style='margin:0'><div id='z' style='width:300px;height:200px'>z</div></body>\"></iframe>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")
  tick(50)
  let _ = eval(
    "globalThis.__flog = [];" +
    "const d = document.getElementById('fr').contentDocument, z = d.getElementById('z');" +
    "z.addEventListener('dragover', e => { e.preventDefault(); __flog.push('over'); });" +
    "z.addEventListener('drop', e => { e.preventDefault(); __flog.push('drop:' + e.dataTransfer.files[0].name); });" +
    "document.addEventListener('drop', e => __flog.push('top-drop'));",
  )
  let z = js_id_uid("document.getElementById('fr').contentDocument.getElementById('z')")
  debug_assert(z > 0, "the frame's zone's uid")
  debug_assert(drop_files(z, 0.5, 0.5, 150.0, 100.0, [("in-frame.txt", "text/plain", "x".to_bytes())]), "the frame's zone takes them")
  let log = eval("__flog.join('|')")
  debug_assert(log == "over|drop:in-frame.txt", "frame zone events: " + log)
}

test "a file input's picker opens only in the person's activation: not from a script on its own" {
  let html = "<!doctype html><html><body style='margin:0'>" +
  "<input id='f' type='file' style='display:none'>" +
  "<button id='b' style='display:block;width:200px;height:50px'>choose</button>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")
  let _ = eval("document.getElementById('b').addEventListener('click', () => document.getElementById('f').click());")
  // (a script's click on load, and from a timer: no picker)
  let _ = eval("document.getElementById('f').click(); setTimeout(() => document.getElementById('f').click(), 0);")
  tick(30)
  debug_assert(take_file_picks().length() == 0, "no picker without the person")
  debug_assert(eval("String(navigator.userActivation.isActive)") == "false", "not active")
  // (the person's press on the page's button, which clicks the hidden input: its picker)
  let _ = tap(100.0, 25.0)
  let picks = take_file_picks()
  debug_assert(picks.length() == 1, "one picker in the person's press: " + picks.length().to_string())
  // (the press is taken by that picker: the page cannot open another when the person shuts it)
  let _ = eval("document.getElementById('f').click();")
  debug_assert(take_file_picks().length() == 0, "the activation was taken by the first picker")
  debug_assert(eval("String(navigator.userActivation.hasBeenActive)") == "true", "has been active")
}
