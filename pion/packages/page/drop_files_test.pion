///| Files dropped on the page from the person's desktop (sync.pion: drop_files, prelude __dropFiles).

test "dropped files reach a drop zone's drop with File objects, or fill a file input; elsewhere nothing" {
  let html = "<!doctype html><html><body style='margin:0'>" +
  "<div id='zone' style='position:absolute;left:0;top:0;width:200px;height:100px'>zone</div>" +
  "<input id='f' type='file' multiple style='position:absolute;left:0;top:150px;width:200px;height:30px'>" +
  "<p id='plain' style='position:absolute;left:0;top:250px;width:200px;height:30px'>plain</p>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")
  let _ = eval(
    "globalThis.__log = [];" +
    "const z = document.getElementById('zone');" +
    "z.addEventListener('dragenter', e => __log.push('enter:' + e.dataTransfer.types.join('+')));" +
    "z.addEventListener('dragover', e => { e.preventDefault(); __log.push('over'); });" +
    "z.addEventListener('drop', e => { e.preventDefault(); const f = e.dataTransfer.files; __log.push('drop:' + f.length + ':' + f[0].name + ':' + f[0].type + ':' + f[0].size + ':' + e.isTrusted); });" +
    "document.getElementById('f').addEventListener('change', e => __log.push('change:' + e.target.files.length + ':' + e.target.files[1].name));",
  )
  let files = [("notes.txt", "text/plain", "hello".to_bytes()), ("b.png", "image/png", "PNG".to_bytes())]
  debug_assert(drop_files(50.0, 50.0, files), "the zone takes them")
  debug_assert(drop_files(50.0, 160.0, files), "the input takes them")
  debug_assert(!drop_files(50.0, 260.0, files), "plain text takes none")
  let log = eval("__log.join('|')")
  debug_assert(log.contains("enter:Files|over|drop:2:notes.txt:text/plain:5:true"), "zone events: " + log)
  debug_assert(log.contains("change:2:b.png"), "input filled: " + log)
}
