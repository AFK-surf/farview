///| Host-permission gates wired into the page's extension runtime (`extensions.pion`):
///| DNR redirect / modifyHeaders rules act only on hosts the extension may access, and
///| block rules never touch privileged browser pages.

test "MV3 guard: DNR redirect acts only inside host_permissions; block skips farview://" {
  clear_extensions()
  let manifest = "{\"manifest_version\":3,\"name\":\"Redirector\",\"version\":\"1.0.0\",\"permissions\":[\"declarativeNetRequest\"],\"host_permissions\":[\"https://*.example.com/*\"],\"declarative_net_request\":{\"rule_resources\":[{\"id\":\"r\",\"enabled\":true,\"path\":\"rules.json\"}]}}"
  let files : Map[String, String] = Map::new()
  files.set(
    "rules.json",
    "[{\"id\":1,\"priority\":2,\"action\":{\"type\":\"redirect\",\"redirect\":{\"url\":\"https://cdn.example.com/stub.js\"}},\"condition\":{\"urlFilter\":\"/lib.js\"}}," +
    "{\"id\":2,\"priority\":1,\"action\":{\"type\":\"block\"},\"condition\":{\"urlFilter\":\"settings\"}}]",
  )
  debug_assert(install_extension("ext-redirector", manifest, files) is Ok(_), "install redirector")
  match extension_dnr_check("https://www.example.com/lib.js", "https://www.example.com/", "script") {
    extensions::DnrDecision::Redirected(rid, to) => debug_assert(rid == 1 && to == "https://cdn.example.com/stub.js", "redirect inside host permissions")
    _ => debug_assert(false, "redirect must apply on www.example.com")
  }
  match extension_dnr_check("https://bank.test/lib.js", "https://bank.test/", "script") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "redirect must not act on a host outside host_permissions")
  }
  match extension_dnr_check("https://news.test/settings", "https://news.test/", "xmlhttprequest") {
    extensions::DnrDecision::Blocked(rid) => debug_assert(rid == 2, "block needs no host permission")
    _ => debug_assert(false, "block rule must apply on ordinary pages")
  }
  match extension_dnr_check("farview://settings", "", "main_frame") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "extensions never act on farview:// pages")
  }
  clear_extensions()
}
