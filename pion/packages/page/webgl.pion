///| Farview Wave G1: Host op 128 (`webgl_op`) bridging `js/prelude.js` WebGL 1.0/2.0 calls
///| to the native GPU `webgl` package and Farview's `canvas_dirty_ids` / `st.pictures` pipeline.

import "webgl"
import "raster"
import "intmap"

let webgl_contexts : intmap::IntMap[Int] = intmap::IntMap::new()

pub fn clear_webgl() -> Unit {
  for id in webgl_contexts.keys() {
    match intmap::get(webgl_contexts, id) {
      Some(ctx_id) => webgl::destroy(ctx_id)
      None => ()
    }
  }
  webgl_contexts.clear()
}

pub fn release_webgl_id(id : Int) -> Unit {
  match intmap::get(webgl_contexts, id) {
    Some(ctx_id) => {
      webgl::destroy(ctx_id)
      webgl_contexts.erase(id)
    }
    None => ()
  }
}

pub fn webgl_read_rgba_for_canvas(id : Int) -> Option[(Int, Int, Bytes)] {
  match intmap::get(webgl_contexts, id) {
    Some(ctx_id) => {
      let gw = webgl::width(ctx_id)
      let gh = webgl::height(ctx_id)
      if gw <= 0 || gh <= 0 {
        return None
      }
      let rgba = webgl::read_rgba_top_down(ctx_id)
      if rgba.length() == gw * gh * 4 {
        Some((gw, gh, rgba))
      } else {
        None
      }
    }
    None => None
  }
}

pub fn webgl_to_png_for_canvas(id : Int) -> Option[Bytes] {
  match intmap::get(webgl_contexts, id) {
    Some(ctx_id) => {
      let gw = webgl::width(ctx_id)
      let gh = webgl::height(ctx_id)
      if gw <= 0 || gh <= 0 {
        return None
      }
      let rgba = webgl::read_rgba_top_down(ctx_id)
      webgl::clear_dirty(ctx_id)
      if rgba.length() == gw * gh * 4 {
        let png = raster::encode_png(rgba, gw, gh)
        if png.length() > 0 { Some(png) } else { None }
      } else {
        None
      }
    }
    None => None
  }
}

fn jget_int(obj : Map[String, JVal], k : String, def : Int) -> Int {
  jget_num(obj, k, def.to_double()).to_int()
}

fn jget_num_arr(obj : Map[String, JVal], k : String) -> Array[Double] {
  let out : Array[Double] = []
  for v in jget_arr(obj, k) {
    match v {
      JVal::JNum(x) => out.push(x)
      JVal::JStr(s) => if s == "Infinity" {
        out.push(1.0 / 0.0)
      } else if s == "-Infinity" {
        out.push(-1.0 / 0.0)
      } else if s == "NaN" {
        out.push(0.0 / 0.0)
      } else {
        out.push(0.0)
      }
      _ => out.push(0.0)
    }
  }
  out
}

fn jget_int_arr(obj : Map[String, JVal], k : String) -> Array[Int] {
  let out : Array[Int] = []
  for v in jget_arr(obj, k) {
    match v {
      JVal::JNum(x) => out.push(x.to_int())
      _ => out.push(0)
    }
  }
  out
}

fn webgl_mark_dirty_if_needed(canvas_id : Int, ctx_id : Int) -> Unit {
  if canvas_id > 0 && webgl::is_dirty(ctx_id) != 0 {
    last_canvas_draw_ms.v = now_ms().to_int64()
    canvas_dirty_ids.set(canvas_id, true)
  }
}

pub fn webgl_op(a : Int, b : Int, s : String, t : String) -> String {
  if webgl::available() == 0 {
    return ""
  }
  match jparse(s) {
    Some(JVal::JObj(obj)) => {
      let op = jget_str(obj, "k")
      if op == "create" {
        match intmap::get(webgl_contexts, a) {
          Some(existing) => return existing.to_string()
          None => ()
        }
        let (def_w, def_h) = if a > 0 {
          let el = at(a)
          (canvas_dim(el, "width", 300), canvas_dim(el, "height", 150))
        } else {
          (300, 150)
        }
        let w = jget_int(obj, "w", def_w)
        let h = jget_int(obj, "h", def_h)
        let ctx_id = webgl::create(w, h, b != 0)
        if ctx_id > 0 {
          webgl_contexts.set(a, ctx_id)
          if a > 0 {
            canvas_dirty_ids.set(a, true)
          }
          return ctx_id.to_string()
        }
        return "0"
      }
      let ctx_id = match intmap::get(webgl_contexts, a) {
        Some(id) => id
        None => return ""
      }
      if op == "destroy" {
        webgl::destroy(ctx_id)
        webgl_contexts.erase(a)
        return ""
      }
      if op == "resize" {
        let w = jget_int(obj, "w", 300)
        let h = jget_int(obj, "h", 150)
        let _ = webgl::resize(ctx_id, w, h)
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }

      // --- Shaders & Programs ---
      if op == "createShader" {
        return webgl::create_shader(ctx_id, jget_int(obj, "t", webgl::gl_vertex_shader)).to_string()
      }
      if op == "shaderSource" {
        webgl::shader_source(ctx_id, jget_int(obj, "s", 0), t)
        return ""
      }
      if op == "compileShader" {
        webgl::compile_shader(ctx_id, jget_int(obj, "s", 0))
        return ""
      }
      if op == "getShaderParameter" {
        return webgl::get_shader_iv(ctx_id, jget_int(obj, "s", 0), jget_int(obj, "p", 0)).to_string()
      }
      if op == "getShaderInfoLog" {
        return webgl::get_shader_info_log(ctx_id, jget_int(obj, "s", 0))
      }
      if op == "getShaderSource" {
        return webgl::get_shader_source(ctx_id, jget_int(obj, "s", 0))
      }
      if op == "getTranslatedShaderSource" {
        return webgl::get_translated_shader_source(ctx_id, jget_int(obj, "s", 0))
      }
      if op == "deleteShader" {
        webgl::delete_shader(ctx_id, jget_int(obj, "s", 0))
        return ""
      }
      if op == "createProgram" {
        return webgl::create_program(ctx_id).to_string()
      }
      if op == "attachShader" {
        webgl::attach_shader(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "s", 0))
        return ""
      }
      if op == "detachShader" {
        webgl::detach_shader(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "s", 0))
        return ""
      }
      if op == "linkProgram" {
        webgl::link_program(ctx_id, jget_int(obj, "p", 0))
        return ""
      }
      if op == "validateProgram" {
        webgl::validate_program(ctx_id, jget_int(obj, "p", 0))
        return ""
      }
      if op == "getProgramParameter" {
        return webgl::get_program_iv(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "n", 0)).to_string()
      }
      if op == "getProgramInfoLog" {
        return webgl::get_program_info_log(ctx_id, jget_int(obj, "p", 0))
      }
      if op == "useProgram" {
        webgl::use_program(ctx_id, jget_int(obj, "p", 0))
        return ""
      }
      if op == "deleteProgram" {
        webgl::delete_program(ctx_id, jget_int(obj, "p", 0))
        return ""
      }
      if op == "getAttribLocation" {
        return webgl::get_attrib_location(ctx_id, jget_int(obj, "p", 0), jget_str(obj, "n")).to_string()
      }
      if op == "bindAttribLocation" {
        webgl::bind_attrib_location(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "i", 0), jget_str(obj, "n"))
        return ""
      }
      if op == "getUniformLocation" {
        return webgl::get_uniform_location(ctx_id, jget_int(obj, "p", 0), jget_str(obj, "n")).to_string()
      }
      if op == "getUniformBlockIndex" {
        return webgl::get_uniform_block_index(ctx_id, jget_int(obj, "p", 0), jget_str(obj, "n")).to_string()
      }
      if op == "uniformBlockBinding" {
        webgl::uniform_block_binding(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "bi", 0), jget_int(obj, "bb", 0))
        return ""
      }
      if op == "bindBufferBase" {
        webgl::bind_buffer_base(ctx_id, jget_int(obj, "t", 0), jget_int(obj, "i", 0), jget_int(obj, "b", 0))
        return ""
      }
      if op == "bindBufferRange" {
        webgl::bind_buffer_range(ctx_id, jget_int(obj, "t", 0), jget_int(obj, "i", 0), jget_int(obj, "b", 0), jget_int(obj, "o", 0), jget_int(obj, "sz", 0))
        return ""
      }
      if op == "getActiveAttrib" {
        match webgl::get_active_attrib(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "i", 0)) {
          Some((sz, ty, name)) => return "\{sz}\t\{ty}\t\{name}"
          None => return ""
        }
      }
      if op == "getActiveUniform" {
        match webgl::get_active_uniform(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "i", 0)) {
          Some((sz, ty, name)) => return "\{sz}\t\{ty}\t\{name}"
          None => return ""
        }
      }

      // --- Buffers, VAOs & Vertex Attributes ---
      if op == "createBuffer" {
        return webgl::create_buffer(ctx_id).to_string()
      }
      if op == "bindBuffer" {
        webgl::bind_buffer(ctx_id, jget_int(obj, "t", 0), jget_int(obj, "b", 0))
        return ""
      }
      if op == "bufferData" {
        let target = jget_int(obj, "t", 0)
        let usage = jget_int(obj, "u", webgl::gl_static_draw)
        let sz = jget_int(obj, "sz", -1)
        if sz >= 0 {
          webgl::buffer_data_size(ctx_id, target, sz, usage)
        } else {
          let raw = latin1_bytes(t)
          webgl::buffer_data_bytes(ctx_id, target, raw, usage)
        }
        return ""
      }
      if op == "bufferSubData" {
        let raw = latin1_bytes(t)
        webgl::buffer_sub_data_bytes(ctx_id, jget_int(obj, "t", 0), jget_int(obj, "o", 0), raw)
        return ""
      }
      if op == "deleteBuffer" {
        webgl::delete_buffer(ctx_id, jget_int(obj, "b", 0))
        return ""
      }
      if op == "createVertexArray" {
        return webgl::create_vao(ctx_id).to_string()
      }
      if op == "bindVertexArray" {
        webgl::bind_vao(ctx_id, jget_int(obj, "v", 0))
        return ""
      }
      if op == "deleteVertexArray" {
        webgl::delete_vao(ctx_id, jget_int(obj, "v", 0))
        return ""
      }
      if op == "enableVertexAttribArray" {
        webgl::enable_vertex_attrib_array(ctx_id, jget_int(obj, "i", 0))
        return ""
      }
      if op == "disableVertexAttribArray" {
        webgl::disable_vertex_attrib_array(ctx_id, jget_int(obj, "i", 0))
        return ""
      }
      if op == "vertexAttribPointer" {
        webgl::vertex_attrib_pointer(
          ctx_id,
          jget_int(obj, "i", 0),
          jget_int(obj, "sz", 4),
          jget_int(obj, "ty", webgl::gl_float),
          jget_int(obj, "n", 0),
          jget_int(obj, "st", 0),
          jget_int(obj, "o", 0),
        )
        return ""
      }
      if op == "vertexAttribIPointer" {
        webgl::vertex_attrib_ipointer(
          ctx_id,
          jget_int(obj, "i", 0),
          jget_int(obj, "sz", 4),
          jget_int(obj, "ty", webgl::gl_int),
          jget_int(obj, "st", 0),
          jget_int(obj, "o", 0),
        )
        return ""
      }
      if op == "vertexAttribDivisor" {
        webgl::vertex_attrib_divisor(ctx_id, jget_int(obj, "i", 0), jget_int(obj, "d", 0))
        return ""
      }
      if op == "vertexAttribFv" {
        webgl::vertex_attrib_fv(ctx_id, jget_int(obj, "i", 0), jget_int(obj, "d", 4), jget_num_arr(obj, "v"))
        return ""
      }

      // --- Uniforms ---
      if op == "uniformFv" {
        webgl::uniform_fv(ctx_id, jget_int(obj, "l", -1), jget_int(obj, "d", 1), jget_num_arr(obj, "v"))
        return ""
      }
      if op == "uniformIv" {
        webgl::uniform_iv(ctx_id, jget_int(obj, "l", -1), jget_int(obj, "d", 1), jget_int_arr(obj, "v"))
        return ""
      }
      if op == "uniformUiv" {
        webgl::uniform_uiv(ctx_id, jget_int(obj, "l", -1), jget_int(obj, "d", 1), jget_int_arr(obj, "v"))
        return ""
      }
      if op == "uniformMatrixFv" {
        webgl::uniform_matrix_fv(
          ctx_id,
          jget_int(obj, "l", -1),
          jget_int(obj, "d", 4),
          jget_int(obj, "tr", 0) != 0,
          jget_num_arr(obj, "v"),
        )
        return ""
      }

      // --- Textures & PixelStore ---
      if op == "createTexture" {
        return webgl::create_texture(ctx_id).to_string()
      }
      if op == "bindTexture" {
        webgl::bind_texture(ctx_id, jget_int(obj, "t", webgl::gl_texture_2d), jget_int(obj, "tx", 0))
        return ""
      }
      if op == "activeTexture" {
        webgl::active_texture(ctx_id, jget_int(obj, "u", webgl::gl_texture0))
        return ""
      }
      if op == "deleteTexture" {
        webgl::delete_texture(ctx_id, jget_int(obj, "tx", 0))
        return ""
      }
      if op == "pixelStorei" {
        webgl::pixel_storei(ctx_id, jget_int(obj, "p", 0), jget_int(obj, "v", 0))
        return ""
      }
      if op == "texImage2D" {
        let target = jget_int(obj, "t", webgl::gl_texture_2d)
        let level = jget_int(obj, "lv", 0)
        let ifmt = jget_int(obj, "if", webgl::gl_rgba)
        let w = jget_int(obj, "w", 0)
        let h = jget_int(obj, "h", 0)
        let border = jget_int(obj, "b", 0)
        let fmt = jget_int(obj, "f", webgl::gl_rgba)
        let ty = jget_int(obj, "ty", webgl::gl_unsigned_byte)
        if jget_int(obj, "has", 0) == 0 {
          webgl::tex_image_2d_null(ctx_id, target, level, ifmt, w, h, border, fmt, ty)
        } else {
          let raw = latin1_bytes(t)
          webgl::tex_image_2d_bytes(ctx_id, target, level, ifmt, w, h, border, fmt, ty, raw)
        }
        return ""
      }
      if op == "texImage2D_el" || op == "texSubImage2D_el" {
        let bmp_id = jget_int(obj, "bmp", 0)
        let src_id = jget_int(obj, "n", 0)
        let src_rgba = if bmp_id > 0 {
          get_image_bitmap_rgba(bmp_id)
        } else if src_id > 0 {
          resolve_element_rgba(src_id)
        } else {
          None
        }
        match src_rgba {
          Some((iw, ih, rgba)) => if op == "texSubImage2D_el" {
            webgl::tex_sub_image_2d_bytes(
              ctx_id,
              jget_int(obj, "t", webgl::gl_texture_2d),
              jget_int(obj, "lv", 0),
              jget_int(obj, "x", 0),
              jget_int(obj, "y", 0),
              iw,
              ih,
              webgl::gl_rgba,
              webgl::gl_unsigned_byte,
              rgba,
            )
          } else {
            webgl::tex_image_2d_bytes(
              ctx_id,
              jget_int(obj, "t", webgl::gl_texture_2d),
              jget_int(obj, "lv", 0),
              jget_int(obj, "if", webgl::gl_rgba),
              iw,
              ih,
              0,
              webgl::gl_rgba,
              webgl::gl_unsigned_byte,
              rgba,
            )
          }
          None => ()
        }
        return ""
      }
      if op == "texSubImage2D" {
        let raw = latin1_bytes(t)
        webgl::tex_sub_image_2d_bytes(
          ctx_id,
          jget_int(obj, "t", webgl::gl_texture_2d),
          jget_int(obj, "lv", 0),
          jget_int(obj, "x", 0),
          jget_int(obj, "y", 0),
          jget_int(obj, "w", 0),
          jget_int(obj, "h", 0),
          jget_int(obj, "f", webgl::gl_rgba),
          jget_int(obj, "ty", webgl::gl_unsigned_byte),
          raw,
        )
        return ""
      }
      if op == "texParameteri" {
        webgl::tex_parameteri(ctx_id, jget_int(obj, "t", webgl::gl_texture_2d), jget_int(obj, "p", 0), jget_int(obj, "v", 0))
        return ""
      }
      if op == "texParameterf" {
        webgl::tex_parameterf(ctx_id, jget_int(obj, "t", webgl::gl_texture_2d), jget_int(obj, "p", 0), jget_num(obj, "v", 0.0))
        return ""
      }
      if op == "generateMipmap" {
        webgl::generate_mipmap(ctx_id, jget_int(obj, "t", webgl::gl_texture_2d))
        return ""
      }
      if op == "createSampler" {
        return webgl::create_sampler(ctx_id).to_string()
      }
      if op == "deleteSampler" {
        webgl::delete_sampler(ctx_id, jget_int(obj, "sm", 0))
        return ""
      }
      if op == "bindSampler" {
        webgl::bind_sampler(ctx_id, jget_int(obj, "u", 0), jget_int(obj, "sm", 0))
        return ""
      }
      if op == "samplerParameteri" {
        webgl::sampler_parameteri(ctx_id, jget_int(obj, "sm", 0), jget_int(obj, "p", 0), jget_int(obj, "v", 0))
        return ""
      }
      if op == "samplerParameterf" {
        webgl::sampler_parameterf(ctx_id, jget_int(obj, "sm", 0), jget_int(obj, "p", 0), jget_num(obj, "v", 0.0))
        return ""
      }

      // --- Framebuffers & Renderbuffers ---
      if op == "createFramebuffer" {
        return webgl::create_framebuffer(ctx_id).to_string()
      }
      if op == "bindFramebuffer" {
        webgl::bind_framebuffer(ctx_id, jget_int(obj, "t", webgl::gl_framebuffer), jget_int(obj, "f", 0))
        return ""
      }
      if op == "framebufferTexture2D" {
        webgl::framebuffer_texture_2d(
          ctx_id,
          jget_int(obj, "t", webgl::gl_framebuffer),
          jget_int(obj, "a", webgl::gl_color_attachment0),
          jget_int(obj, "tt", webgl::gl_texture_2d),
          jget_int(obj, "tx", 0),
          jget_int(obj, "lv", 0),
        )
        return ""
      }
      if op == "framebufferRenderbuffer" {
        webgl::framebuffer_renderbuffer(
          ctx_id,
          jget_int(obj, "t", webgl::gl_framebuffer),
          jget_int(obj, "a", webgl::gl_depth_attachment),
          jget_int(obj, "rt", webgl::gl_renderbuffer),
          jget_int(obj, "r", 0),
        )
        return ""
      }
      if op == "checkFramebufferStatus" {
        return webgl::check_framebuffer_status(ctx_id, jget_int(obj, "t", webgl::gl_framebuffer)).to_string()
      }
      if op == "deleteFramebuffer" {
        webgl::delete_framebuffer(ctx_id, jget_int(obj, "f", 0))
        return ""
      }
      if op == "drawBuffers" {
        webgl::draw_buffers(ctx_id, jget_int_arr(obj, "b"))
        return ""
      }
      if op == "readBuffer" {
        webgl::read_buffer(ctx_id, jget_int(obj, "s", webgl::gl_color_attachment0))
        return ""
      }
      if op == "blitFramebuffer" {
        webgl::blit_framebuffer(
          ctx_id,
          jget_int(obj, "sx0", 0),
          jget_int(obj, "sy0", 0),
          jget_int(obj, "sx1", 0),
          jget_int(obj, "sy1", 0),
          jget_int(obj, "dx0", 0),
          jget_int(obj, "dy0", 0),
          jget_int(obj, "dx1", 0),
          jget_int(obj, "dy1", 0),
          jget_int(obj, "m", webgl::gl_color_buffer_bit),
          jget_int(obj, "f", webgl::gl_nearest),
        )
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "createRenderbuffer" {
        return webgl::create_renderbuffer(ctx_id).to_string()
      }
      if op == "bindRenderbuffer" {
        webgl::bind_renderbuffer(ctx_id, jget_int(obj, "t", webgl::gl_renderbuffer), jget_int(obj, "r", 0))
        return ""
      }
      if op == "renderbufferStorage" {
        webgl::renderbuffer_storage(
          ctx_id,
          jget_int(obj, "t", webgl::gl_renderbuffer),
          jget_int(obj, "if", webgl::gl_depth24_stencil8),
          jget_int(obj, "w", 0),
          jget_int(obj, "h", 0),
        )
        return ""
      }
      if op == "renderbufferStorageMultisample" {
        webgl::renderbuffer_storage_multisample(
          ctx_id,
          jget_int(obj, "t", webgl::gl_renderbuffer),
          jget_int(obj, "sp", 0),
          jget_int(obj, "if", webgl::gl_rgba8),
          jget_int(obj, "w", 0),
          jget_int(obj, "h", 0),
        )
        return ""
      }
      if op == "deleteRenderbuffer" {
        webgl::delete_renderbuffer(ctx_id, jget_int(obj, "r", 0))
        return ""
      }

      // --- State & Draw ---
      if op == "viewport" {
        webgl::viewport(ctx_id, jget_int(obj, "x", 0), jget_int(obj, "y", 0), jget_int(obj, "w", 0), jget_int(obj, "h", 0))
        return ""
      }
      if op == "scissor" {
        webgl::scissor(ctx_id, jget_int(obj, "x", 0), jget_int(obj, "y", 0), jget_int(obj, "w", 0), jget_int(obj, "h", 0))
        return ""
      }
      if op == "clearColor" {
        webgl::clear_color(ctx_id, jget_num(obj, "r", 0.0), jget_num(obj, "g", 0.0), jget_num(obj, "b", 0.0), jget_num(obj, "a", 0.0))
        return ""
      }
      if op == "clearDepth" {
        webgl::clear_depth(ctx_id, jget_num(obj, "d", 1.0))
        return ""
      }
      if op == "clearStencil" {
        webgl::clear_stencil(ctx_id, jget_int(obj, "s", 0))
        return ""
      }
      if op == "clear" {
        webgl::clear(ctx_id, jget_int(obj, "m", 0))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "clearBufferfv" {
        webgl::clear_buffer_fv(ctx_id, jget_int(obj, "b", 0x1800), jget_int(obj, "db", 0), jget_num_arr(obj, "v"))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "clearBufferiv" {
        webgl::clear_buffer_iv(ctx_id, jget_int(obj, "b", 0x1800), jget_int(obj, "db", 0), jget_int_arr(obj, "v"))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "clearBufferuiv" {
        webgl::clear_buffer_uiv(ctx_id, jget_int(obj, "b", 0x1800), jget_int(obj, "db", 0), jget_int_arr(obj, "v"))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "clearBufferfi" {
        webgl::clear_buffer_fi(ctx_id, jget_int(obj, "b", 0x84F9), jget_int(obj, "db", 0), jget_num(obj, "d", 1.0), jget_int(obj, "s", 0))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "enable" {
        webgl::enable(ctx_id, jget_int(obj, "c", 0))
        return ""
      }
      if op == "disable" {
        webgl::disable(ctx_id, jget_int(obj, "c", 0))
        return ""
      }
      if op == "isEnabled" {
        return webgl::is_enabled(ctx_id, jget_int(obj, "c", 0)).to_string()
      }
      if op == "depthFunc" {
        webgl::depth_func(ctx_id, jget_int(obj, "f", webgl::gl_less))
        return ""
      }
      if op == "depthMask" {
        webgl::depth_mask(ctx_id, jget_int(obj, "f", 1))
        return ""
      }
      if op == "depthRange" {
        webgl::depth_range(ctx_id, jget_num(obj, "n", 0.0), jget_num(obj, "f", 1.0))
        return ""
      }
      if op == "colorMask" {
        webgl::color_mask(ctx_id, jget_int(obj, "r", 1), jget_int(obj, "g", 1), jget_int(obj, "b", 1), jget_int(obj, "a", 1))
        return ""
      }
      if op == "cullFace" {
        webgl::cull_face(ctx_id, jget_int(obj, "m", 0x0405))
        return ""
      }
      if op == "frontFace" {
        webgl::front_face(ctx_id, jget_int(obj, "m", 0x0901))
        return ""
      }
      if op == "blendFunc" {
        webgl::blend_func(ctx_id, jget_int(obj, "s", 1), jget_int(obj, "d", 0))
        return ""
      }
      if op == "blendFuncSeparate" {
        webgl::blend_func_separate(ctx_id, jget_int(obj, "sr", 1), jget_int(obj, "dr", 0), jget_int(obj, "sa", 1), jget_int(obj, "da", 0))
        return ""
      }
      if op == "blendEquation" {
        webgl::blend_equation(ctx_id, jget_int(obj, "m", 0x8006))
        return ""
      }
      if op == "blendEquationSeparate" {
        webgl::blend_equation_separate(ctx_id, jget_int(obj, "mr", 0x8006), jget_int(obj, "ma", 0x8006))
        return ""
      }
      if op == "blendColor" {
        webgl::blend_color(ctx_id, jget_num(obj, "r", 0.0), jget_num(obj, "g", 0.0), jget_num(obj, "b", 0.0), jget_num(obj, "a", 0.0))
        return ""
      }
      if op == "lineWidth" {
        webgl::line_width(ctx_id, jget_num(obj, "w", 1.0))
        return ""
      }
      if op == "polygonOffset" {
        webgl::polygon_offset(ctx_id, jget_num(obj, "f", 0.0), jget_num(obj, "u", 0.0))
        return ""
      }
      if op == "stencilFunc" {
        webgl::stencil_func(ctx_id, jget_int(obj, "f", 0x0207), jget_int(obj, "r", 0), jget_int(obj, "m", 0xFF))
        return ""
      }
      if op == "stencilFuncSeparate" {
        webgl::stencil_func_separate(ctx_id, jget_int(obj, "fc", 0x0408), jget_int(obj, "f", 0x0207), jget_int(obj, "r", 0), jget_int(obj, "m", 0xFF))
        return ""
      }
      if op == "stencilOp" {
        webgl::stencil_op(ctx_id, jget_int(obj, "sf", 0x1E00), jget_int(obj, "df", 0x1E00), jget_int(obj, "dp", 0x1E00))
        return ""
      }
      if op == "stencilOpSeparate" {
        webgl::stencil_op_separate(ctx_id, jget_int(obj, "fc", 0x0408), jget_int(obj, "sf", 0x1E00), jget_int(obj, "df", 0x1E00), jget_int(obj, "dp", 0x1E00))
        return ""
      }
      if op == "stencilMask" {
        webgl::stencil_mask(ctx_id, jget_int(obj, "m", 0xFF))
        return ""
      }
      if op == "stencilMaskSeparate" {
        webgl::stencil_mask_separate(ctx_id, jget_int(obj, "fc", 0x0408), jget_int(obj, "m", 0xFF))
        return ""
      }
      if op == "drawArrays" {
        webgl::draw_arrays(ctx_id, jget_int(obj, "m", webgl::gl_triangles), jget_int(obj, "f", 0), jget_int(obj, "c", 0))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "drawElements" {
        webgl::draw_elements(ctx_id, jget_int(obj, "m", webgl::gl_triangles), jget_int(obj, "c", 0), jget_int(obj, "ty", webgl::gl_unsigned_short), jget_int(obj, "o", 0))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "drawArraysInstanced" {
        webgl::draw_arrays_instanced(ctx_id, jget_int(obj, "m", webgl::gl_triangles), jget_int(obj, "f", 0), jget_int(obj, "c", 0), jget_int(obj, "p", 0))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "drawElementsInstanced" {
        webgl::draw_elements_instanced(ctx_id, jget_int(obj, "m", webgl::gl_triangles), jget_int(obj, "c", 0), jget_int(obj, "ty", webgl::gl_unsigned_short), jget_int(obj, "o", 0), jget_int(obj, "p", 0))
        webgl_mark_dirty_if_needed(a, ctx_id)
        return ""
      }
      if op == "finish" {
        webgl::finish(ctx_id)
        return ""
      }
      if op == "flush" {
        webgl::flush(ctx_id)
        return ""
      }
      if op == "getError" {
        return webgl::get_error(ctx_id).to_string()
      }
      if op == "getString" {
        return webgl::get_string(ctx_id, jget_int(obj, "p", 0))
      }
      if op == "getIntegerv" {
        let vals = webgl::get_integerv(ctx_id, jget_int(obj, "p", 0))
        let sb = StringBuilder::new()
        let mut i = 0
        while i < vals.length() {
          if i > 0 { sb.write_string(",") }
          sb.write_string(vals[i].to_string())
          i = i + 1
        }
        return sb.to_string()
      }
      if op == "getFloatv" {
        let vals = webgl::get_floatv(ctx_id, jget_int(obj, "p", 0))
        let sb = StringBuilder::new()
        let mut i = 0
        while i < vals.length() {
          if i > 0 { sb.write_string(",") }
          sb.write_string(vals[i].to_string())
          i = i + 1
        }
        return sb.to_string()
      }
      if op == "readPixels" {
        let raw = webgl::read_pixels(
          ctx_id,
          jget_int(obj, "x", 0),
          jget_int(obj, "y", 0),
          jget_int(obj, "w", 0),
          jget_int(obj, "h", 0),
          jget_int(obj, "f", webgl::gl_rgba),
          jget_int(obj, "ty", webgl::gl_unsigned_byte),
        )
        return bytes_latin1(raw)
      }
      ""
    }
    _ => ""
  }
}

///| Async image fetches initiated by HTMLImageElement (including detached `new Image()`).
///| Maps fetch id -> (js_ctx, img_node_id, resolved_url).
let img_pending_fetches : intmap::IntMap[(Int, Int, String)] = intmap::IntMap::new()

///| Host-side decoded RGBA storage for `createImageBitmap` / `ImageBitmap`.
let image_bitmaps : intmap::IntMap[(Int, Int, Bytes)] = intmap::IntMap::new()
let image_bitmap_next_id : Ref[Int] = Ref::{ v: 1 }

pub fn clear_image_async_state() -> Unit {
  img_pending_fetches.clear()
  image_bitmaps.clear()
  image_bitmap_next_id.v = 1
}

pub fn img_has_pending_fetches() -> Bool {
  img_pending_fetches.len() > 0
}

pub fn get_image_bitmap_rgba(bmp_id : Int) -> Option[(Int, Int, Bytes)] {
  intmap::get(image_bitmaps, bmp_id)
}

pub fn resolve_element_rgba(src_id : Int) -> Option[(Int, Int, Bytes)] {
  if src_id == 0 {
    return None
  }
  if src_id < 0 {
    match webgl_read_rgba_for_canvas(src_id) {
      Some(v) => return Some(v)
      None => return webgpu_read_rgba_for_canvas(src_id)
    }
  }
  let src_el = at(src_id)
  if src_el.tag == "canvas" {
    match webgl_read_rgba_for_canvas(src_id) {
      Some(v) => return Some(v)
      None =>
      match webgpu_read_rgba_for_canvas(src_id) {
        Some(v) => return Some(v)
        None => {
          let sw0 = canvas_dim(src_el, "width", 0)
          let sh0 = canvas_dim(src_el, "height", 0)
          if sw0 > 0 && sh0 > 0 {
            match canvases.get_or_create(src_id, sw0, sh0) {
              Some(sc) => {
                sc.flush()
                return Some((sw0, sh0, sc.get_image_data(0, 0, sw0, sh0)))
              }
              None => return None
            }
          }
          return None
        }
      }
    }
  }
  let raw_u = src_el.src_url.unwrap_or(src_el.attr("src").unwrap_or(""))
  if raw_u == "" {
    return None
  }
  let resolved_u = if raw_u.starts_with("data:") || raw_u.starts_with("blob:") || raw_u.starts_with("fvmedia:") {
    raw_u
  } else {
    fetch::resolve(cur_url(), raw_u)
  }
  let pic_opt = match st.pictures.get(resolved_u) {
    Some(pb) => Some(pb)
    None => match st.pictures.get(raw_u) {
      Some(pb) => Some(pb)
      None => if raw_u.starts_with("data:") {
        match data_url(raw_u) {
          Some(pb) => {
            st.pictures.set(raw_u, pb)
            Some(pb)
          }
          None => None
        }
      } else {
        None
      }
    }
  }
  match pic_opt {
    Some(pb) => raster::decode_image(pb)
    None => None
  }
}

fn crop_and_flip_rgba(
  rgba : Bytes,
  iw : Int,
  ih : Int,
  sx : Int,
  sy : Int,
  sw : Int,
  sh : Int,
  flip_y : Bool,
) -> Option[(Int, Int, Bytes)] {
  if iw <= 0 || ih <= 0 || rgba.length() < iw * ih * 4 {
    return None
  }
  let out_w = if sw > 0 { sw } else { iw }
  let out_h = if sh > 0 { sh } else { ih }
  if out_w <= 0 || out_h <= 0 || out_w > 16384 || out_h > 16384 {
    return None
  }
  if sx == 0 && sy == 0 && out_w == iw && out_h == ih && !flip_y {
    return Some((iw, ih, rgba))
  }
  let out = Bytes::new(out_w * out_h * 4)
  let mut y = 0
  while y < out_h {
    let dst_y = if flip_y { out_h - 1 - y } else { y }
    let src_y = sy + y
    if src_y >= 0 && src_y < ih {
      let mut x = 0
      while x < out_w {
        let src_x = sx + x
        if src_x >= 0 && src_x < iw {
          let si = (src_y * iw + src_x) * 4
          let di = (dst_y * out_w + x) * 4
          out[di] = rgba[si]
          out[di + 1] = rgba[si + 1]
          out[di + 2] = rgba[si + 2]
          out[di + 3] = rgba[si + 3]
        }
        x += 1
      }
    }
    y += 1
  }
  Some((out_w, out_h, out))
}

fn parse_bitmap_opts(s : String) -> (Int, Int, Int, Int, Bool) {
  if s == "" {
    return (0, 0, 0, 0, false)
  }
  let parts = s.split(",")
  let sx = if parts.length() > 0 { css::parse_double(parts[0]).to_int() } else { 0 }
  let sy = if parts.length() > 1 { css::parse_double(parts[1]).to_int() } else { 0 }
  let sw = if parts.length() > 2 { css::parse_double(parts[2]).to_int() } else { 0 }
  let sh = if parts.length() > 3 { css::parse_double(parts[3]).to_int() } else { 0 }
  let flip_y = parts.length() > 4 && parts[4] == "1"
  (sx, sy, sw, sh, flip_y)
}

fn store_image_bitmap(rgba_opt : Option[(Int, Int, Bytes)], opts : String) -> String {
  match rgba_opt {
    Some((iw, ih, rgba)) => {
      let (sx, sy, sw, sh, flip_y) = parse_bitmap_opts(opts)
      match crop_and_flip_rgba(rgba, iw, ih, sx, sy, sw, sh, flip_y) {
        Some((ow, oh, out)) => {
          let id = image_bitmap_next_id.v
          image_bitmap_next_id.v = id + 1
          image_bitmaps.set(id, (ow, oh, out))
          "\{id},\{ow},\{oh}"
        }
        None => ""
      }
    }
    None => ""
  }
}

pub fn img_handle_fetch_done(fid : Int, r : fetch::Answer) -> Bool {
  match intmap::get(img_pending_fetches, fid) {
    Some((ctx, img_id, u)) => {
      img_pending_fetches.delete(fid)
      let mut ok = false
      if r.status >= 200 && r.status < 400 && r.body.length() > 0 {
        st.pictures.set(u, r.body)
        pictures_ver.v += 1
        match picture_size(u, r.body) {
          Some((w, h)) if w > 0 && h > 0 => {
            let el = at(img_id)
            el.src_url = Some(u)
            el.natural = Some((w.to_double(), h.to_double()))
            boxes_changed(el)
            frame_due.v = true
            ok = true
          }
          _ => ()
        }
      }
      if ctx == 0 || browsing.contains(ctx) {
        let flag = if ok { 1 } else { 0 }
        in_context(ctx, fn() { run("\{hk()}.__imgDone(\{fid}, \{flag})") })
      }
      true
    }
    None => false
  }
}

pub fn image_host_op(a : Int, b : Int, s : String, t : String) -> String {
  if b == 0 {
    // Register a blob: image's bytes into st.pictures
    if s.starts_with("blob:") {
      st.pictures.set(s, latin1_bytes(t))
      pictures_ver.v += 1
      frame_due.v = true
    }
    return ""
  }
  if b == 1 {
    // Async-load an HTMLImageElement's src (including detached `new Image()`)
    let raw_src = s.trim()
    if raw_src == "" {
      return "err"
    }
    let u = if raw_src.starts_with("data:") || raw_src.starts_with("blob:") || raw_src.starts_with("fvmedia:") {
      raw_src
    } else {
      fetch::resolve(cur_url(), raw_src)
    }
    let el = at(a)
    if u.starts_with("data:") {
      let body = match st.pictures.get(u) {
        Some(pb) => Some(pb)
        None => match data_url(u) {
          Some(pb) => {
            st.pictures.set(u, pb)
            pictures_ver.v += 1
            Some(pb)
          }
          None => None
        }
      }
      match body {
        Some(pb) => match picture_size(u, pb) {
          Some((w, h)) if w > 0 && h > 0 => {
            el.src_url = Some(u)
            el.natural = Some((w.to_double(), h.to_double()))
            return "ok"
          }
          _ => return "err"
        }
        None => return "err"
      }
    }
    if u.starts_with("blob:") {
      match st.pictures.get(u) {
        Some(pb) => match picture_size(u, pb) {
          Some((w, h)) if w > 0 && h > 0 => {
            el.src_url = Some(u)
            el.natural = Some((w.to_double(), h.to_double()))
            return "ok"
          }
          _ => return "err"
        }
        None => return "err"
      }
    }
    if u.starts_with("http://") || u.starts_with("https://") {
      match st.pictures.get(u) {
        Some(pb) => match picture_size(u, pb) {
          Some((w, h)) if w > 0 && h > 0 => {
            el.src_url = Some(u)
            el.natural = Some((w.to_double(), h.to_double()))
            return "ok"
          }
          _ => return "err"
        }
        None => {
          let fid = fetch::start("GET", u, fc_picture_accept, Bytes::new(0), true)
          if fid > 0 {
            img_pending_fetches.set(fid, (cur_ctx.v, a, u))
            return "async:\{fid}"
          }
          return "err"
        }
      }
    }
    // Non-HTTP(S) schemes (e.g. about:blank relative paths in offline unit tests): keep sync compatibility
    if st.pictures.contains(u) {
      el.src_url = Some(u)
      return "ok"
    }
    return "sync"
  }
  if b == 2 {
    // createImageBitmap(Blob): decode raw image bytes
    let raw = latin1_bytes(t)
    return store_image_bitmap(raster::decode_image(raw), s)
  }
  if b == 3 {
    // ImageBitmap.close()
    if a > 0 {
      image_bitmaps.delete(a)
    }
    return ""
  }
  if b == 4 {
    // createImageBitmap(HTMLImageElement | HTMLCanvasElement)
    return store_image_bitmap(resolve_element_rgba(a), s)
  }
  if b == 5 {
    // createImageBitmap(ImageData): a = width, s = "height,sx,sy,sw,sh,flipY", t = latin1 RGBA
    let parts = s.split(",")
    let ih = if parts.length() > 0 { css::parse_double(parts[0]).to_int() } else { 0 }
    let raw = latin1_bytes(t)
    if a <= 0 || ih <= 0 || raw.length() < a * ih * 4 {
      return ""
    }
    let sub_opts = if parts.length() > 1 {
      let rest : Array[String] = []
      let mut i = 1
      while i < parts.length() {
        rest.push(parts[i])
        i += 1
      }
      rest.join(",")
    } else {
      ""
    }
    return store_image_bitmap(Some((a, ih, raw)), sub_opts)
  }
  if b == 6 {
    // createImageBitmap(ImageBitmap)
    return store_image_bitmap(get_image_bitmap_rgba(a), s)
  }
  if b == 7 {
    // Read host ImageBitmap RGBA bytes as latin1 string (for VideoFrame.copyTo / WebCodecs)
    match get_image_bitmap_rgba(a) {
      Some((_, _, rgba)) => return bytes_latin1(rgba)
      None => return ""
    }
  }
  ""
}
