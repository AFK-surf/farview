///| A person's press as the client reports it (the element under the pointer and where in it, page::point_of), then
///| page::tap: on a challenge-style page, a link's onclick, and a checkbox `span` in a bordered iframe (same-origin
///| srcdoc and cross-origin data:) whose scripts listen for pointerdown/mousedown/mouseup/click, each get their events,
///| at client coordinates in their own document's viewport.

import "html"

fn click_test_el(frame : String, id : String) -> Option[html::Node] {
  let walk : Array[html::Node] = []
  if frame == "" {
    walk.push(st.doc)
  }
  for f in frames {
    if f.el.attr("id").unwrap_or("") == frame {
      walk.push(f.doc)
    }
  }
  while walk.pop() is Some(n) {
    if n.kind == html::Kind::Element && n.attr("id").unwrap_or("") == id {
      return Some(n)
    }
    for c in n.children {
      walk.push(c)
    }
  }
  None
}

fn click_test_tap(frame : String, id : String, rx : Double, ry : Double) -> Hit {
  match click_test_el(frame, id) {
    Some(n) =>
    match point_of(n.uid, rx, ry) {
      Some((x, y)) => tap(x, y)
      None => {
        debug_assert(false, "no point for #" + id)
        Nothing
      }
    }
    None => {
      debug_assert(false, "no element #" + id)
      Nothing
    }
  }
}

fn click_test_frame(origin_note : String) -> String {
  // the checkbox reports what it was given to its parent by postMessage, as a cross-origin frame must
  "<!doctype html><html><head><style>body { margin: 0 } .anchor { position: relative; width: 300px; height: 74px; " +
  "background: rgb(249, 249, 249) } .cb { position: absolute; left: 12px; top: 25px; width: 24px; height: 24px; " +
  "border: 2px solid rgb(193, 193, 193); border-radius: 2px; background: white; cursor: pointer } " +
  ".lbl { position: absolute; left: 52px; top: 28px; font-size: 14px }</style></head><body>" +
  "<div class=anchor><span id=cb class=cb role=checkbox aria-checked=false tabindex=0></span>" +
  "<label id=lbl class=lbl>I am not a robot</label></div><script>" +
  "const cb = document.getElementById('cb'); const seen = [];" +
  "for (const t of ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click']) cb.addEventListener(t, e => {" +
  " seen.push(t + '@' + Math.round(e.clientX) + ',' + Math.round(e.clientY));" +
  " if (t === 'click') { cb.setAttribute('aria-checked', 'true');" +
  " parent.postMessage('" + origin_note + ":' + seen.join(' ') + ':' + (document.activeElement === cb), '*'); seen.length = 0; } });" +
  "</script></body></html>"
}

test "challenge page: a link's onclick and an iframe checkbox's pointer, mouse and click events all arrive where pressed" {
  let same = click_test_frame("same")
  let cross = click_test_frame("cross")
  let ok = load(
    "data:text/html;charset=utf-8,<!doctype html><html><head><style>" +
    "body { margin: 0 } .pre { height: 60px } a { display: inline-block; width: 200px; height: 20px } " +
    "iframe { display: block; margin: 10px 0 0 30px; width: 304px; height: 78px; border: 2px solid gray } " +
    ".info { display: none }</style></head><body><div class=pre>" +
    "<a id=why href='%23' onclick=\"document.getElementById('info').style.display='block'; return false\">Why</a>" +
    "<a id=why2 href='%23' onclick=\"document.getElementById('info2').style.display='block'\">Why</a>" +
    "<div id=info class=info>about</div><div id=info2 class=info>about</div></div>" +
    "<iframe id=f1 srcdoc=\"" + same + "\"></iframe>" +
    "<iframe id=f2 src=\"data:text/html;charset=utf-8," + cross + "\"></iframe>" +
    "<script>window.__got = []; addEventListener('message', e => window.__got.push(String(e.data)));</script>" +
    "</body></html>",
    800.0,
    600.0,
  )
  debug_assert(ok, "challenge page loaded")
  tick(200)
  let _ = click_test_tap("", "why", 0.5, 0.5)
  debug_assert(eval("getComputedStyle(document.getElementById('info')).display") == "block", "link onclick ran")
  debug_assert(eval("location.hash") == "", "onclick returning false kept the link from navigating")
  // href="#" with an onclick that lets it be (a challenge page's own "Why did this happen?"): no page load, the
  // onclick's change kept
  let hit = click_test_tap("", "why2", 0.5, 0.5)
  debug_assert(eval("getComputedStyle(document.getElementById('info2')).display") == "block", "second link onclick ran")
  debug_assert(!(hit is Go(_)), "a same-document fragment link loads nothing anew")
  debug_assert(eval("location.href.endsWith('#')") == "true", "the URL took its empty fragment")
  // the checkbox in the same-origin frame: 28px square (border box), its middle at (26, 39) in the frame's viewport
  let _ = click_test_tap("f1", "cb", 0.5, 0.5)
  tick(50)
  let got = eval("window.__got.join('|')")
  debug_assert(
    got == "same:pointerdown@26,39 mousedown@26,39 pointerup@26,39 mouseup@26,39 click@26,39:true",
    "same-origin frame checkbox events in order at frame coordinates, got: " + got,
  )
  let _ = eval("window.__got = []")
  // the cross-origin frame's checkbox
  let _ = click_test_tap("f2", "cb", 0.5, 0.5)
  tick(50)
  let got2 = eval("window.__got.join('|')")
  debug_assert(
    got2 == "cross:pointerdown@26,39 mousedown@26,39 pointerup@26,39 mouseup@26,39 click@26,39:true",
    "cross-origin frame checkbox events in order at frame coordinates, got: " + got2,
  )
  // a narrow frame of a desktop tab is a desktop's (its UA, no touch), and follows the tab when it turns phone-sized
  let probe = "(() => { const w = document.getElementById('f1').contentWindow; " +
  "return [w.innerWidth < 700, /Mobile/.test(w.navigator.userAgent), w.navigator.maxTouchPoints, 'ontouchstart' in w].join(','); })()"
  let desk = eval(probe)
  debug_assert(desk == "true,false,0,false", "a narrow frame of a desktop tab is a desktop's, got: " + desk)
  resize(600.0, 600.0)
  let phone = eval(probe)
  debug_assert(phone == "true,true,5,true", "a frame of a phone-sized tab is a phone's, got: " + phone)
}
