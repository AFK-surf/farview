///| The page's Zap picker (`js/prelude.js`, Site Boosts): names an element and its related elements, selects on a
///| tap and shows its bar, zaps through the bar, brings a placeholder back, and ends on the page's Done.

fn zap_center(sel : String) -> (Double, Double) {
  let raw = eval(
    "(() => { const e = document.querySelector('" +
    sel +
    "'); if (!e) return ''; const r = e.getBoundingClientRect(); return (r.left + r.width / 2) + ',' + (r.top + r.height / 2); })()",
  )
  match str_find(raw, ",") {
    Some(i) => {
      let x = css::parse_double(raw.slice(0, i))
      let y = css::parse_double(raw.slice(i + 1, raw.length()))
      (x, y)
    }
    None => (-1.0, -1.0)
  }
}

fn zap_tap(sel : String) -> Unit {
  let (x, y) = zap_center(sel)
  debug_assert(x >= 0.0 && y >= 0.0, "Zap test: " + sel + " is on the page")
  let _ = tap(x, y)
}

test "Zap overlay: related-element names, select, Zap all related, unzap a placeholder, Done" {
  let html = "<!doctype html><html><head><style>body{margin:0;font:16px sans-serif} ul{margin:0;padding:0} li{display:block;height:40px} p{height:40px;margin:0}</style></head><body><ul class='feed'><li class='post'>One</li><li class='post'>Two</li><li class='post'>Three</li></ul><p id='lone'>Alone</p><div class='box'><span class='tag'>a</span></div></body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "zap page loaded")
  let h = hk()
  // Names: a list item by its position, its related elements by the tag and class path without positions.
  debug_assert(
    eval(h + ".__zapNames(document.querySelectorAll('li')[1])") == "[\"li.post:nth-of-type(2)\",\"ul.feed > li.post\"]",
    "second post: own selector and the related path",
  )
  debug_assert(eval(h + ".__zapNames(document.getElementById('lone'))") == "[\"#lone\",\"\"]", "an element like no other has no related path")
  debug_assert(eval(h + ".__zapNames(document.querySelector('span'))") == "[\"span.tag\",\"\"]", "a single span has no related path")
  // The picker is host-only.
  debug_assert(eval("typeof __zapStart") == "undefined", "zap entries hidden from the page")
  debug_assert(eval(h + ".__zapStart({\"zapped\":[]})") == "1", "zap on")
  debug_assert(eval("document.querySelectorAll('[data-fv-zap-ui=foot]').length") == "1", "the foot bar is on the page")
  debug_assert(eval("document.querySelectorAll('[data-fv-zap-ui=bar]').length") == "0", "no selection bar before a tap")
  // A tap selects (nothing is hidden yet) and shows the bar with the selector.
  zap_tap("li:nth-of-type(2)")
  debug_assert(eval(h + ".__zapTake()") == "[]", "a tap selects, it does not zap")
  debug_assert(eval("document.querySelectorAll('[data-fv-zap-ui=bar]').length") == "1", "selection bar shown")
  debug_assert(eval("document.querySelector('[data-fv-zap-ui=sel]').textContent") == "li.post:nth-of-type(2)", "selector under the buttons")
  debug_assert(eval("document.querySelectorAll('[data-fv-act=all]').length") == "1", "Zap all related offered")
  // Zap all related elements through the bar.
  zap_tap("[data-fv-act=all]")
  debug_assert(eval(h + ".__zapTake()") == "[\"ul.feed > li.post\"]", "related elements zapped by the general selector")
  debug_assert(eval("document.querySelectorAll('[data-fv-zap-ui=bar]').length") == "0", "bar gone after zapping")
  debug_assert(eval("document.querySelector('[data-fv-zap-ui=count]').textContent") == "1", "the foot counts what is zapped")
  // The host saved it; a tap on its placeholder brings it back.
  let _ = eval(h + ".__zapKeep({\"zapped\":[\"ul.feed > li.post\"]})")
  zap_tap("li:nth-of-type(1)")
  debug_assert(eval(h + ".__zapTakeUndone()") == "[\"ul.feed > li.post\"]", "placeholder tap unzaps")
  // Cancel drops the selection; Done is taken once.
  zap_tap("#lone")
  debug_assert(eval("document.querySelectorAll('[data-fv-act=all]').length") == "0", "no related elements: only Zap this")
  zap_tap("[data-fv-act=cancel]")
  debug_assert(eval("document.querySelectorAll('[data-fv-zap-ui=bar]').length") == "0", "Cancel closes the bar")
  debug_assert(eval(h + ".__zapTake()") == "[]", "Cancel zaps nothing")
  zap_tap("[data-fv-act=done]")
  debug_assert(eval(h + ".__zapTakeDone()") == "1", "Done asked")
  debug_assert(eval(h + ".__zapTakeDone()") == "0", "Done is taken once")
  debug_assert(eval(h + ".__zapStop()") == "0", "zap off")
  debug_assert(eval("document.querySelectorAll('[data-fv-zap-ui]').length") == "0", "the bars leave with Zap")
  debug_assert(eval("document.documentElement.hasAttribute('data-fv-zap')") == "false", "page attribute removed")
}
