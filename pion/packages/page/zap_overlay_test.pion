///| The page's Zap picker (`js/prelude.js`, Site Boosts): names an element and its related elements, selects on a
///| tap and shows its bar, zaps through the bar, brings a placeholder back, and ends on the page's Done. The bars sit
///| in a closed shadow root (`__zapUi` hands it to the host's checks).

///| The center of what `q` finds, in the page or (`ui`) in the bars' shadow root, as "x,y".
fn zap_center(q : String, ui~ : Bool = false) -> (Double, Double) {
  let within = if ui { hk() + ".__zapUi()" } else { "document" }
  let raw = eval(
    "(() => { const s = " +
    within +
    "; const e = s && s.querySelector('" +
    q +
    "'); if (!e) return ''; const r = e.getBoundingClientRect(); return (r.left + r.width / 2) + ',' + (r.top + r.height / 2); })()",
  )
  match str_find(raw, ",") {
    Some(i) => {
      let x = css::parse_double(raw.slice(0, i))
      let y = css::parse_double(raw.slice(i + 1, raw.length()))
      (x, y)
    }
    None => (-1.0, -1.0)
  }
}

fn zap_tap(q : String, ui~ : Bool = false) -> Unit {
  let (x, y) = zap_center(q, ui~)
  debug_assert(x >= 0.0 && y >= 0.0, "Zap test: " + q + " is on the page")
  let _ = tap(x, y)
}

///| A script run on the bars' shadow root (`r`), "" when Zap is off.
fn zap_ui(code : String) -> String {
  eval("(() => { const r = " + hk() + ".__zapUi(); if (!r) return ''; return String(" + code + "); })()")
}

///| Whether the bar part `q` is drawn (its `display` is not none).
fn zap_shown(q : String) -> Bool {
  zap_ui("(() => { const e = r.querySelector('" + q + "'); return !!e && getComputedStyle(e).display !== 'none'; })()") == "true"
}

test "Zap overlay: related-element names, select, Zap all related, unzap a placeholder, Done" {
  let html = "<!doctype html><html><head><style>body{margin:0;font:16px sans-serif} ul{margin:0;padding:0} li{display:block;height:40px} p{height:40px;margin:0}</style></head><body><ul class='feed'><li class='post'>One</li><li class='post'>Two</li><li class='post'>Three</li></ul><p id='lone'>Alone</p><div class='box'><span class='tag'>a</span></div></body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "zap page loaded")
  let h = hk()
  // Names: a list item by its position, its related elements by the tag and class path without positions.
  debug_assert(
    eval(h + ".__zapNames(document.querySelectorAll('li')[1])") == "[\"li.post:nth-of-type(2)\",\"ul.feed > li.post\"]",
    "second post: own selector and the related path",
  )
  debug_assert(eval(h + ".__zapNames(document.getElementById('lone'))") == "[\"#lone\",\"\"]", "an element like no other has no related path")
  debug_assert(eval(h + ".__zapNames(document.querySelector('span'))") == "[\"span.tag\",\"\"]", "a single span has no related path")
  // The picker is host-only.
  debug_assert(eval("typeof __zapStart") == "undefined", "zap entries hidden from the page")
  debug_assert(eval("typeof __zapUi") == "undefined", "the bars' root is hidden from the page")
  debug_assert(eval(h + ".__zapStart({\"zapped\":[]})") == "1", "zap on")
  // The page sees one element of the prelude's own, with no open shadow root and none of the bars' parts.
  debug_assert(eval("document.querySelectorAll('fv-zap').length") == "1", "one host element")
  debug_assert(eval("document.querySelector('fv-zap').shadowRoot === null") == "true", "the bars' root is closed")
  debug_assert(eval("document.querySelectorAll('.foot, .bar, [data-act]').length") == "0", "no bar part in the page's tree")
  debug_assert(zap_shown(".foot"), "the foot bar is drawn")
  debug_assert(!zap_shown(".bar"), "no selection bar before a tap")
  // A tap selects (nothing is hidden yet) and shows the bar with the selector.
  zap_tap("li:nth-of-type(2)")
  debug_assert(eval(h + ".__zapTake()") == "[]", "a tap selects, it does not zap")
  debug_assert(zap_shown(".bar"), "selection bar shown")
  debug_assert(zap_ui("r.querySelector('.own').textContent") == "li.post:nth-of-type(2)", "selector under the buttons")
  debug_assert(zap_ui("r.querySelector('.gen').textContent") == "ul.feed > li.post · 3", "what Zap all would hide, and how many")
  debug_assert(zap_shown(".all"), "Zap all related offered")
  // Zap all related elements through the bar.
  zap_tap(".all", ui=true)
  debug_assert(eval(h + ".__zapTake()") == "[\"ul.feed > li.post\"]", "related elements zapped by the general selector")
  debug_assert(!zap_shown(".bar"), "bar gone after zapping")
  debug_assert(zap_ui("r.querySelector('.count').textContent") == "1", "the foot counts what is zapped")
  // The host saved it; a tap on its placeholder brings it back.
  let _ = eval(h + ".__zapKeep({\"zapped\":[\"ul.feed > li.post\"]})")
  debug_assert(eval("document.querySelector('li').offsetHeight") == "24", "a zapped element is a placeholder")
  zap_tap("li:nth-of-type(1)")
  debug_assert(eval(h + ".__zapTakeUndone()") == "[\"ul.feed > li.post\"]", "placeholder tap unzaps")
  // Cancel drops the selection; Done is taken once.
  zap_tap("#lone")
  debug_assert(!zap_shown(".all"), "no related elements: only Zap this")
  zap_tap(".cancel", ui=true)
  debug_assert(!zap_shown(".bar"), "Cancel closes the bar")
  debug_assert(eval(h + ".__zapTake()") == "[]", "Cancel zaps nothing")
  zap_tap(".done", ui=true)
  debug_assert(eval(h + ".__zapTakeDone()") == "1", "Done asked")
  debug_assert(eval(h + ".__zapTakeDone()") == "0", "Done is taken once")
  debug_assert(eval(h + ".__zapStop()") == "0", "zap off")
  debug_assert(eval("document.querySelectorAll('fv-zap').length") == "0", "the bars leave with Zap")
  debug_assert(eval("document.documentElement.hasAttribute('data-fv-zap')") == "false", "page attribute removed")
}

test "Zap overlay: an element named from the body is lit, its placeholder shows and a tap brings it back" {
  // (two plain divs at the body: the second is only unique as `body > div:nth-of-type(2)`)
  let html = "<!doctype html><html><head><style>body{margin:0} div{height:60px} section div{height:20px}</style></head><body><div>First</div><div>Second</div><section><div>a</div><div>b</div></section></body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "zap page loaded")
  let h = hk()
  debug_assert(
    eval(h + ".__zapNames(document.body.children[1])") == "[\"body > div:nth-of-type(2)\",\"div\"]",
    "a body child is named from the body",
  )
  debug_assert(eval(h + ".__zapStart({\"zapped\":[]})") == "1", "zap on")
  zap_tap("body > div:nth-of-type(2)")
  // The selection light reaches it (the rule is scoped by :is(), not by a prefix).
  debug_assert(
    eval("getComputedStyle(document.body.children[1]).outlineStyle") == "solid",
    "the selected body child is lit",
  )
  zap_tap(".this", ui=true)
  debug_assert(eval(h + ".__zapTake()") == "[\"body > div:nth-of-type(2)\"]", "zapped by its body-anchored name")
  // The host saved it: the boost's own rule hides it, Zap's placeholder rule outranks that.
  let _ = eval(
    "(() => { const s = document.createElement('style'); s.textContent = 'body > div:nth-of-type(2) { display: none !important; }'; document.head.appendChild(s); })()",
  )
  let _ = eval(h + ".__zapKeep({\"zapped\":[\"body > div:nth-of-type(2)\"]})")
  debug_assert(eval("document.body.children[1].offsetHeight") == "24", "its placeholder is drawn over the boost's rule")
  debug_assert(zap_ui("r.querySelector('.count').textContent") == "1", "counted")
  zap_tap("body > div:nth-of-type(2)")
  debug_assert(eval(h + ".__zapTakeUndone()") == "[\"body > div:nth-of-type(2)\"]", "a tap on the placeholder unzaps it")
  // A saved list is scoped whole.
  let _ = eval(h + ".__zapKeep({\"zapped\":[\"section > div:nth-of-type(1), section > div:nth-of-type(2)\"]})")
  debug_assert(eval("document.querySelectorAll('section div')[1].offsetHeight") == "24", "each part of a list is a placeholder")
  debug_assert(eval(h + ".__zapStop()") == "0", "zap off")
}
