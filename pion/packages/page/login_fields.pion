///| Login fields for the password manager: which fields of the page it may fill, the username/password pair of the
///| form a field is in, and the credentials a sent login form left for the Save Password prompt (`__takeCred`).
///|
///| Only `<input>`s of the main document are offered: a frame's fields (another origin's, maybe) are never filled.

import "html"
import "js"

fn lf_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i).to_int()
    if c >= 65 && c <= 90 {
      sb.write_string("abcdefghijklmnopqrstuvwxyz".slice(c - 65, c - 64))
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i = i + 1
  }
  sb.to_string()
}

fn lf_input_type(n : html::Node) -> String {
  let t = lf_lower(n.attr("type").unwrap_or("text").trim())
  if t == "" { "text" } else { t }
}

fn lf_is_text_like(t : String) -> Bool {
  t == "text" || t == "email" || t == "tel" || t == "password" || t == "search" || t == "url"
}

fn lf_collect(n : html::Node, out : Array[html::Node], depth : Int) -> Unit {
  if depth > 64 || out.length() > 256 {
    return
  }
  for c in n.children {
    if c.kind == html::Kind::Element {
      if c.tag == "input" {
        out.push(c)
      }
      lf_collect(c, out, depth + 1)
    }
  }
}

fn lf_kind_of(n : html::Node) -> String {
  if n.kind != html::Kind::Element || n.tag != "input" {
    return ""
  }
  if context_of(n) != 0 {
    return ""
  }
  if n.attr("disabled") is Some(_) || n.attr("readonly") is Some(_) {
    return ""
  }
  let t = lf_input_type(n)
  if !lf_is_text_like(t) {
    return ""
  }
  if t == "password" {
    if lf_lower(n.attr("autocomplete").unwrap_or("")).contains("new-password") { "new-password" } else { "password" }
  } else {
    "username"
  }
}

///| What a field (by its wire id, as the client names it) is to the password manager: `"password"`,
///| `"new-password"` (a password field marked `autocomplete=new-password`: sign-up and change forms), `"username"` (a
///| text-like input), or `""` when it is not one it may fill (not an `<input>`, disabled, read-only, or in a frame).
pub fn login_field_kind(uid : Int) -> String {
  if !st.started {
    return ""
  }
  match node_of_uid(uid) {
    Some(n) => lf_kind_of(n)
    None => ""
  }
}

///| A field's wire id from its page id (the id the page's scripts know it by).
pub fn wire_id_of(id : Int) -> Int {
  at(id).uid
}

///| The username and password fields (wire ids, `-1` for none) of the login form the field `uid` is in: the form's
///| first password field, and the text-like field closest before it (or one marked `autocomplete=username`). A field
///| outside any `<form>` looks up a few ancestors for one that holds a password field.
pub fn login_form_fields(uid : Int) -> (Int, Int) {
  if login_field_kind(uid) == "" {
    return (-1, -1)
  }
  let n = match node_of_uid(uid) {
    Some(n) => n
    None => return (-1, -1)
  }
  let mut root = n
  let mut found = false
  match form_of(n) {
    Some(f) => {
      root = f
      found = true
    }
    None => {
      let mut p = n.parent
      let mut hops = 0
      while hops < 4 && !found {
        match p {
          Some(x) => {
            let ins : Array[html::Node] = []
            lf_collect(x, ins, 0)
            for e in ins {
              if lf_input_type(e) == "password" {
                found = true
              }
            }
            root = x
            p = x.parent
          }
          None => break
        }
        hops = hops + 1
      }
    }
  }
  let inputs : Array[html::Node] = []
  if found {
    lf_collect(root, inputs, 0)
  } else {
    inputs.push(n)
  }
  let mut pw = -1
  let mut user = -1
  let mut marked_user = -1
  for e in inputs {
    let k = lf_kind_of(e)
    if k == "" {
      continue
    }
    if k == "password" || k == "new-password" {
      if pw < 0 {
        pw = e.uid
      }
    } else if pw < 0 {
      user = e.uid
    }
    if k == "username" && lf_lower(e.attr("autocomplete").unwrap_or("")).contains("username") && marked_user < 0 {
      marked_user = e.uid
    }
  }
  (if marked_user >= 0 { marked_user } else { user }, pw)
}

///| A login field's value now (by wire id).
pub fn login_field_value(uid : Int) -> String {
  match node_of_uid(uid) {
    Some(n) => field_value(id_of(n))
    None => ""
  }
}

///| The credentials a login form left when it was sent (JSON `{url, action, username, password}`), taken once;
///| `""` when none was sent since the last take.
pub fn take_credential_capture() -> String {
  if !st.started {
    return ""
  }
  let r = js::run("\{hk()}.__takeCred()")
  if r.starts_with("!error") || r == "undefined" { "" } else { r }
}
