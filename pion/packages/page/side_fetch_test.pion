///| The host's own side fetches (site icons, manifests: site_icons.pion `side_fetch`) go without the Space's cookies
///| and keep none their answer sets: what they bring is shared by every Space of the profile.

import "page_aux"
import "fetch"

test "side fetch: no cookie goes with it and none it answers is kept" {
  let port = page_aux::storage_test_http_start(2)
  debug_assert(port > 0, "loopback server")
  let base = "http://127.0.0.1:" + port.to_string()
  fc_forget()
  fc_disable_disk_cache()
  clear_page_cookie_jar()
  let _ = load(base + "/hist-login", 800.0, 600.0)
  debug_assert(sec_cookie_header_for_request(base + "/", true, "GET") == "sess=S1", "signed in")
  let got : Ref[String] = Ref::{ v: "" }
  let _ = side_fetch(base + "/side-cookie", "", 4096, fn(a : fetch::Answer) -> Unit {
    got.v = if a.status == 200 { bytes_latin1(a.body) } else { "status " + a.status.to_string() }
  })
  // (side fetches alone never make deliver_streams wait on the network: wait by the clock, up to 10 s)
  let until = now_ms() + 10000
  while got.v == "" && now_ms() < until {
    deliver_streams(20)
  }
  debug_assert(got.v == "no-cookie", "the side fetch carried no cookie, got " + got.v)
  debug_assert(sec_cookie_header_for_request(base + "/", true, "GET") == "sess=S1", "its Set-Cookie was not kept: " + sec_cookie_header_for_request(base + "/", true, "GET"))
  clear_page_cookie_jar()
  fc_history_forget_all()
}
