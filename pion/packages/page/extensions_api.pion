///| The one `chrome.*` API factory every MV3 extension context is built from (`extensions.pion` / `extensions_sw.pion`):
///| content scripts (isolated world, `ctx: 'content'`), extension pages such as the toolbar popup and options page
///| (their own main world, `ctx: 'page'`) and the background service worker (its own OS-thread isolate,
///| `ctx: 'worker'`). Each context hands it `call(a, b, payload)`: host op 135 (synchronous, wrapped in a Promise)
///| in a page or isolated world, a `postMessage` RPC answered by the host's pump in the worker. Every API returns a
///| Promise and also takes Chrome's trailing callback. The factory returns:
///|   `{ chrome, dispatch, deliver, fire, portConnect, portMessage, portDisconnect }`.
///|
///| Op 135 sub-codes (`a`; `b` is the storage area, the tab id, or the sender kind):
///|   1-4 storage get/set/remove/clear (b: 0 local, 1 sync, 2 session),
///|   10 runtime.sendMessage (b: 0 content, 1 worker, 2 extension page), 11 deferred async reply,
///|   20/21 declarativeNetRequest,
///|   30-36 tabs (query, sendMessage, get, create, update, remove, reload),
///|   40-49 action (setBadgeText, getBadgeText, setBadgeBackgroundColor, getBadgeBackgroundColor, setTitle, getTitle,
///|     setPopup, getPopup, enable/disable, isEnabled; b: tab id or -1),
///|   50-54 alarms (create, get, getAll, clear, clearAll),
///|   60-65 scripting (executeScript, insertCSS, removeCSS, registerContentScripts, unregisterContentScripts,
///|     getRegisteredContentScripts),
///|   70-73 contextMenus (create, update, remove, removeAll),
///|   80 runtime.openOptionsPage, 81-84 permissions (contains, getAll, request, remove),
///|   85 commands.getAll, 86-88 offscreen (createDocument, closeDocument, hasDocument),
///|   89 windows (b: 0 getCurrent, 1 getLastFocused, 2 getAll, 3 create, 4 update, 5 remove),
///|   90 cross-world DOM event forwarding,
///|   91-95 Ports & Native Messaging (connect, port.postMessage, port.disconnect, connectNative, sendNativeMessage),
///|   100 SW fetch(). Answers are JSON; `{"__fvError": msg}` rejects the Promise.

fn ext_chrome_api_factory_js() -> String {
  let src =
  #|(function (host) {
    #| "use strict";
    #| const id = String(host.id), manifest = host.manifest || {}, ctx = host.ctx;
    #| const i18nMsgs = host.i18n && typeof host.i18n === "object" ? host.i18n : {};
    #| const workerGen = host.workerGen | 0;
    #| const ctxId = host.ctxId | 0;
    #| const perms = new Set(Array.isArray(manifest.permissions) ? manifest.permissions.map(String) : []);
    #| const has = (p) => perms.has(p);
    #| const enc = (v) => JSON.stringify(v === undefined ? null : v);
    #| const dec = (s) => { if (s === undefined || s === null || s === "") return undefined; try { return JSON.parse(s); } catch (_) { return s; } };
    #| let lastError;
    #| const pendingAsync = new Map();
    #| const finish = (p, cb) => {
      #| if (typeof cb !== "function") return p;
      #| p.then((v) => { cb(v); }, (e) => { lastError = { message: String((e && e.message) || e) }; try { cb(); } finally { lastError = undefined; } });
      #| return undefined;
      #| };
    #| // Out-of-band host control envelope (\x02A:<id> pending, \x02E:<msg> error, \x02V:<json> literal value)
    #| // prevents arbitrary user JSON (e.g. {"__fvAsyncId": 1, "__fvError": "x"}) from colliding with control frames.
    #| const decodeOut = (out) => {
      #| if (typeof out === "string" && out.length >= 3 && out.charCodeAt(0) === 2 && out.charCodeAt(2) === 58) {
        #| const tag = out.charCodeAt(1);
        #| if (tag === 69) throw new Error(out.slice(3));
        #| if (tag === 86) return dec(out.slice(3));
        #| }
      #| const r = dec(out);
      #| if (r && typeof r === "object" && !Array.isArray(r) && typeof r.__fvError === "string") throw new Error(r.__fvError);
      #| return r;
      #| };
    #| // Register async tickets synchronously on document host.call returns (before returning to user JS)
    #| // so back-to-back calls in one JS task never race ahead of pendingAsync registration.
    #| const settleRaw = (out) => {
      #| if (typeof out === "string" && out.length >= 3 && out.charCodeAt(0) === 2 && out.charCodeAt(2) === 58) {
        #| const tag = out.charCodeAt(1);
        #| if (tag === 65) {
          #| const aid = +out.slice(3);
          #| return new Promise((resolve, reject) => {
            #| pendingAsync.set(aid, { resolve, reject });
            #| });
          #| }
        #| if (tag === 69) return Promise.reject(new Error(out.slice(3)));
        #| if (tag === 86) return Promise.resolve(dec(out.slice(3)));
        #| }
      #| try { return Promise.resolve(decodeOut(out)); } catch (e) { return Promise.reject(e); }
      #| };
    #| const callJ = (a, b, payload) => {
      #| let rawOut;
      #| try { rawOut = host.call(a | 0, b | 0, payload === undefined ? "" : String(payload)); }
      #| catch (e) { return Promise.reject(e); }
      #| if (rawOut && typeof rawOut.then === "function") return rawOut.then(settleRaw);
      #| return settleRaw(rawOut);
      #| };
    #| const nothing = () => undefined;
    #| const mkEvent = () => {
      #| const ls = [];
      #| return {
        #| addListener(fn) { if (typeof fn === "function" && ls.indexOf(fn) < 0) ls.push(fn); },
        #| removeListener(fn) { const i = ls.indexOf(fn); if (i >= 0) ls.splice(i, 1); },
        #| hasListener(fn) { return ls.indexOf(fn) >= 0; },
        #| hasListeners() { return ls.length > 0; },
        #| _list() { return ls.slice(); },
        #| _fire(args) { for (const fn of ls.slice()) { try { fn.apply(null, args); } catch (e) { if (host.log) host.log(String((e && e.stack) || e)); } } },
        #| };
      #| };
    #| // Ports (runtime.connect, tabs.connect, runtime.connectNative)
    #| const ports = new Map();
    #| let portSeq = 0;
    #| const nextPortId = (pfx) => pfx + ":" + id + ":" + ctx + ":" + workerGen + ":" + ctxId + ":" + (++portSeq);
    #| const mkPort = (portId, name, sender) => {
      #| const onMsg = mkEvent(), onDisc = mkEvent();
      #| let open = true;
      #| const port = {
        #| name: String(name || ""),
        #| sender: sender || undefined,
        #| onMessage: onMsg,
        #| onDisconnect: onDisc,
        #| postMessage(msg) {
          #| if (!open) throw new Error("Attempting to use a disconnected port object");
          #| callJ(92, ctx === "worker" ? 1 : 0, enc({ portId, message: msg === undefined ? null : msg })).catch(nothing);
          #| },
        #| disconnect() {
          #| if (!open) return;
          #| open = false;
          #| ports.delete(portId);
          #| callJ(93, ctx === "worker" ? 1 : 0, enc({ portId })).catch(nothing);
          #| },
        #| _deliver(m) { if (open) onMsg._fire([m, port]); },
        #| _disconnect(errMsg) {
          #| if (!open) return;
          #| open = false;
          #| ports.delete(portId);
          #| if (errMsg) { lastError = { message: String(errMsg) }; try { onDisc._fire([port]); } finally { lastError = undefined; } }
          #| else { onDisc._fire([port]); }
          #| },
        #| };
      #| ports.set(portId, port);
      #| return port;
      #| };
    #| // storage: local / sync (local-backed) / session (memory), with onChanged on every write
    #| const onChanged = mkEvent();
    #| const mkArea = (name, b) => {
      #| const area = {
        #| get(keys, cb) {
          #| if (typeof keys === "function") { cb = keys; keys = null; }
          #| let payload = "";
          #| if (typeof keys === "string") payload = JSON.stringify([keys]);
          #| else if (Array.isArray(keys)) payload = JSON.stringify(keys.map(String));
          #| else if (keys && typeof keys === "object") payload = JSON.stringify(Object.keys(keys));
          #| return finish(callJ(1, b, payload).then((obj) => {
            #| const out = obj && typeof obj === "object" && !Array.isArray(obj) ? obj : {};
            #| if (keys && typeof keys === "object" && !Array.isArray(keys)) for (const k of Object.keys(keys)) if (!(k in out)) out[k] = keys[k];
            #| return out;
            #| }), cb);
          #| },
        #| set(items, cb) { return finish(callJ(2, b, enc(items == null ? {} : items)).then(nothing), cb); },
        #| remove(keys, cb) { const arr = typeof keys === "string" ? [keys] : (Array.isArray(keys) ? keys.map(String) : []); return finish(callJ(3, b, JSON.stringify(arr)).then(nothing), cb); },
        #| clear(cb) { return finish(callJ(4, b, "").then(nothing), cb); },
        #| getBytesInUse(keys, cb) {
          #| if (typeof keys === "function") { cb = keys; keys = null; }
          #| return finish(area.get(keys).then((o) => { let n = 0; for (const k of Object.keys(o)) n += k.length + JSON.stringify(o[k]).length; return n; }), cb);
          #| },
        #| setAccessLevel(o, cb) { return finish(Promise.resolve(), cb); },
        #| onChanged: mkEvent(),
        #| QUOTA_BYTES: name === "sync" ? 102400 : 10485760,
        #| };
      #| if (name === "sync") { area.QUOTA_BYTES_PER_ITEM = 8192; area.MAX_ITEMS = 512; }
      #| return Object.freeze(area);
      #| };
    #| const storage = { local: mkArea("local", 0), sync: mkArea("sync", 1), onChanged };
    #| if (ctx !== "content") storage.session = mkArea("session", 2);
    #| // runtime
    #| const onMessage = mkEvent(), onMessageExternal = mkEvent(), onConnect = mkEvent(), onConnectExternal = mkEvent();
    #| const onInstalled = mkEvent(), onStartup = mkEvent(), onSuspend = mkEvent(), onUpdateAvailable = mkEvent();
    #| const fire = (msg, sender, sendResponse, sendError) => {
      #| let keep = false;
      #| for (const fn of onMessage._list()) {
        #| const ret = fn(msg, sender, sendResponse);
        #| if (ret === true) keep = true;
        #| else if (ret && typeof ret.then === "function") {
          #| keep = true;
          #| ret.then(
            #| (v) => sendResponse(v),
            #| (err) => {
              #| if (typeof sendError === "function") sendError(String((err && err.message) || err || "Error"));
              #| else sendResponse(null);
              #| },
            #| );
          #| }
        #| }
      #| return keep;
      #| };
    #| const deliver = (msgJson, senderJson, reqId) => {
      #| if (!onMessage.hasListeners()) return "";
      #| let msg = null; try { msg = JSON.parse(msgJson); } catch (_) { msg = msgJson; }
      #| let sender = { id }; try { if (senderJson) sender = JSON.parse(senderJson); } catch (_) {}
      #| let reply = "";
      #| let replied = false;
      #| let inFire = true;
      #| const sendResponse = (r) => {
        #| if (replied) return;
        #| replied = true;
        #| let encoded = "null";
        #| try { encoded = JSON.stringify(r === undefined ? null : r); } catch (_) { encoded = JSON.stringify(String(r)); }
        #| const env = "\x02V:" + encoded;
        #| reply = env;
        #| if (!inFire && reqId) { callJ(11, reqId | 0, env).catch(nothing); }
        #| };
      #| const sendError = (emsg) => {
        #| if (replied) return;
        #| replied = true;
        #| const env = "\x02E:" + String(emsg || "Error");
        #| reply = env;
        #| if (!inFire && reqId) { callJ(11, reqId | 0, env).catch(nothing); }
        #| };
      #| let keep = false;
      #| try { keep = fire(msg, sender, sendResponse, sendError); }
      #| catch (e) { sendError((e && e.message) || String(e)); inFire = false; return reply; }
      #| inFire = false;
      #| if (replied) return reply;
      #| if (keep && reqId) return "__fvAsync__";
      #| return "";
      #| };
    #| const runtime = {
      #| id,
      #| getManifest() { return JSON.parse(JSON.stringify(manifest)); },
      #| getURL(p) { return "chrome-extension://" + id + "/" + String(p == null ? "" : p).replace(/^\/+/, ""); },
      #| get lastError() { return lastError; },
      #| sendMessage(...args) {
        #| let cb; if (typeof args[args.length - 1] === "function") cb = args.pop();
        #| const message = args.length >= 2 && typeof args[0] === "string" && args[1] !== undefined ? args[1] : args[0];
        #| return finish(callJ(10, ctx === "worker" ? 1 : (ctx === "page" ? 2 : 0), enc(message)), cb);
        #| },
      #| connect(extIdOrInfo, connectInfo) {
        #| let info = connectInfo;
        #| if (extIdOrInfo && typeof extIdOrInfo === "object") info = extIdOrInfo;
        #| const name = info && info.name != null ? String(info.name) : "";
        #| const pid = nextPortId("p");
        #| const port = mkPort(pid, name, { id });
        #| callJ(91, 0, enc({ portId: pid, name, fromKind: ctx })).catch((e) => port._disconnect((e && e.message) || String(e)));
        #| return port;
        #| },
      #| connectNative(application) {
        #| const app = String(application || "");
        #| const pid = nextPortId("nm");
        #| const port = mkPort(pid, app, { id });
        #| if (!has("nativeMessaging")) {
          #| Promise.resolve().then(() => port._disconnect("Missing \"nativeMessaging\" permission."));
          #| return port;
          #| }
        #| callJ(94, ctx === "worker" ? 1 : 0, enc({ portId: pid, application: app, fromKind: ctx })).catch((e) => port._disconnect((e && e.message) || String(e)));
        #| return port;
        #| },
      #| sendNativeMessage(application, message, cb) {
        #| if (!has("nativeMessaging")) return finish(Promise.reject(new Error("Missing \"nativeMessaging\" permission.")), cb);
        #| return finish(callJ(95, ctx === "worker" ? 1 : 0, enc({ application: String(application || ""), message: message === undefined ? null : message })), cb);
        #| },
      #| onMessage,
      #| onMessageExternal,
      #| onConnect,
      #| onConnectExternal,
      #| onInstalled,
      #| onStartup,
      #| onSuspend,
      #| onUpdateAvailable,
      #| openOptionsPage(cb) { return finish(callJ(80, 0, "").then(nothing), cb); },
      #| setUninstallURL(u, cb) { return finish(Promise.resolve(), cb); },
      #| getContexts(filter, cb) { if (typeof filter === "function") cb = filter; return finish(Promise.resolve([]), cb); },
      #| getPlatformInfo(cb) { return finish(Promise.resolve({ os: "linux", arch: "x86-64", nacl_arch: "x86-64" }), cb); },
      #| reload() {},
      #| };
    #| // i18n (available in all extension contexts)
    #| const expandI18n = (key, subs) => {
      #| const k = String(key || "");
      #| if (k === "@@extension_id") return id;
      #| if (k === "@@ui_locale") return manifest.default_locale || "en";
      #| if (k === "@@bidi_dir") return "ltr";
      #| const tmpl = i18nMsgs[k.toLowerCase()];
      #| if (!tmpl) return "";
      #| const arr = subs == null ? [] : (Array.isArray(subs) ? subs.map(String) : [String(subs)]);
      #| return String(tmpl).replace(/\$([\$1-9])/g, (_, d) => d === "$" ? "$" : (arr[+d - 1] || ""));
