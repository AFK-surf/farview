  #| const out = obj && typeof obj === "object" && !Array.isArray(obj) ? obj : {};
  #| if (keys && typeof keys === "object" && !Array.isArray(keys)) for (const k of Object.keys(keys)) if (!(k in out)) out[k] = keys[k];
  #| return out;
  #| }), cb);
