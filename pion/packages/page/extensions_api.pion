      #| getAcceptLanguages(cb) { return finish(Promise.resolve([manifest.default_locale || "en-US", "en"]), cb); },
      #| });
    #| // tabs (the current page is tab 1)
    #| const tabsOnUpdated = mkEvent(), tabsOnCreated = mkEvent(), tabsOnRemoved = mkEvent(), tabsOnActivated = mkEvent();
    #| const tabs = {
      #| query(info, cb) { return finish(callJ(30, 0, enc(info == null ? {} : info)).then((r) => Array.isArray(r) ? r : []), cb); },
      #| sendMessage(tabId, message, opts, cb) {
        #| if (typeof opts === "function") { cb = opts; opts = {}; }
        #| const fid = opts && opts.frameId != null ? opts.frameId | 0 : -1;
        #| return finish(callJ(31, tabId | 0, enc({ message: message === undefined ? null : message, frameId: fid })), cb);
        #| },
      #| connect(tabId, connectInfo) {
        #| const name = connectInfo && connectInfo.name != null ? String(connectInfo.name) : "";
        #| const fid = connectInfo && connectInfo.frameId != null ? connectInfo.frameId | 0 : -1;
        #| const pid = nextPortId("tp");
        #| const port = mkPort(pid, name, { id });
        #| callJ(91, tabId | 0, enc({ portId: pid, name, tabId: tabId | 0, frameId: fid, fromKind: ctx })).catch((e) => port._disconnect((e && e.message) || String(e)));
        #| return port;
        #| },
      #| get(tabId, cb) { return finish(callJ(32, tabId | 0, ""), cb); },
      #| create(props, cb) { return finish(callJ(33, 0, enc(props == null ? {} : props)), cb); },
      #| update(tabId, props, cb) {
        #| if (typeof tabId === "object" && tabId !== null) { cb = props; props = tabId; tabId = -1; }
        #| return finish(callJ(34, tabId | 0, enc(props == null ? {} : props)), cb);
