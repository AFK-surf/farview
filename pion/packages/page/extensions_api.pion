  #| // prevents arbitrary user JSON (e.g. {"__fvAsyncId": 1, "__fvError": "x"}) from colliding with control frames.
  #| const decodeOut = (out) => {
  #| if (typeof out === "string" && out.length >= 3 && out.charCodeAt(0) === 2 && out.charCodeAt(2) === 58) {
  #| const tag = out.charCodeAt(1);
  #| if (tag === 69) throw new Error(out.slice(3));
  #| if (tag === 86) return dec(out.slice(3));
  #| }
  #| const r = dec(out);
  #| if (r && typeof r === "object" && !Array.isArray(r) && typeof r.__fvError === "string") throw new Error(r.__fvError);
  #| return r;
