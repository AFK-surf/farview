      #| getDynamicRules(cb) { return finish(callJ(21, 0, "").then((r) => Array.isArray(r) ? r : []), cb); },
      #| updateSessionRules(options, cb) { return finish(callJ(20, 1, enc(options == null ? {} : options)).then(nothing), cb); },
