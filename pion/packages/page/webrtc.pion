///| Farview Wave R1: Host op 134 (`webrtc_op`) bridging `js/prelude.js` W3C WebRTC APIs
///| (`RTCPeerConnection`, `RTCDataChannel`, `navigator.mediaDevices`) to the real
///| pure-Pion + BoringSSL DTLS-SRTP + POSIX UDP `webrtc` engine.

import "webrtc"
import "intmap"

struct PagePeerEntry {
  peer : webrtc::PeerConnection
  mut last_conn_state : String
  mut last_ice_state : String
  mut last_gather_state : String
  mut last_sig_state : String
}

let webrtc_peers : intmap::IntMap[PagePeerEntry] = intmap::IntMap::new()
let webrtc_next_id : Ref[Int] = Ref::{ v: 1 }
let webrtc_captures : Array[Int] = []

pub fn clear_webrtc() -> Unit {
  for id in webrtc_peers.keys() {
    match intmap::get(webrtc_peers, id) {
      Some(e) => e.peer.close()
      None => ()
    }
  }
  webrtc_peers.clear()
  for h in webrtc_captures {
    if h > 0 {
      webrtc::capture_close(h)
    }
  }
  webrtc_captures.clear()
}

fn b64_encode_webrtc(data : Bytes) -> String {
  let tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let n = data.length()
  let out_len = ((n + 2) / 3) * 4
  let out = Bytes::new(out_len)
  let mut i = 0
  let mut pos = 0
  while i < n {
    let b0 = data[i].to_int() & 0xFF
    let b1 = if i + 1 < n { data[i + 1].to_int() & 0xFF } else { 0 }
    let b2 = if i + 2 < n { data[i + 2].to_int() & 0xFF } else { 0 }
    let rem = n - i
    out[pos] = tbl.code_unit_at((b0 >> 2) & 63).to_byte()
    out[pos + 1] = tbl.code_unit_at(((b0 & 3) << 4) | ((b1 >> 4) & 15)).to_byte()
    out[pos + 2] = if rem > 1 {
      tbl.code_unit_at(((b1 & 15) << 2) | ((b2 >> 6) & 3)).to_byte()
    } else {
      (61).to_byte()
    }
    out[pos + 3] = if rem > 2 {
      tbl.code_unit_at(b2 & 63).to_byte()
    } else {
      (61).to_byte()
    }
    pos = pos + 4
    i = i + 3
  }
  out.to_string()
}

fn b64_val_webrtc(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 {
    62
  } else if c == 47 {
    63
  } else {
    -1
  }
}

fn b64_decode_webrtc(s : String) -> Bytes {
  let out : Array[Byte] = []
  let mut acc = 0
  let mut bits = 0
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 61 {
      break
    }
    let v = b64_val_webrtc(c)
    if v >= 0 {
      acc = (acc << 6) | v
      bits = bits + 6
      if bits >= 8 {
        bits = bits - 8
        out.push(((acc >> bits) & 0xFF).to_byte())
      }
    }
    i = i + 1
  }
  let res = Bytes::new(out.length())
  let mut j = 0
  while j < out.length() {
    res[j] = out[j]
    j = j + 1
  }
  res
}

fn parse_int_simple(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    } else {
      break
    }
    i = i + 1
  }
  acc
}

fn webrtc_stats_json(p : webrtc::PeerConnection) -> String {
  let st = p.get_stats()
  "{\"connectionState\":" + jquote(st.connection_state) +
  ",\"iceConnectionState\":" + jquote(st.ice_connection_state) +
  ",\"iceGatheringState\":" + jquote(st.ice_gathering_state) +
  ",\"signalingState\":" + jquote(st.signaling_state) +
  ",\"srtpCipher\":" + jquote(st.srtp_cipher) +
  ",\"stunTx\":" + st.stun_tx.to_string() +
  ",\"stunRx\":" + st.stun_rx.to_string() +
  ",\"rtpTxPackets\":" + st.rtp_tx_packets.to_string() +
  ",\"rtpTxBytes\":" + st.rtp_tx_bytes.to_string() +
  ",\"rtpRxPackets\":" + st.rtp_rx_packets.to_string() +
  ",\"rtpRxBytes\":" + st.rtp_rx_bytes.to_string() +
  ",\"rtcpTxPackets\":" + st.rtcp_tx_packets.to_string() +
  ",\"rtcpTxBytes\":" + st.rtcp_tx_bytes.to_string() +
  ",\"rtcpRxPackets\":" + st.rtcp_rx_packets.to_string() +
  ",\"rtcpRxBytes\":" + st.rtcp_rx_bytes.to_string() +
  ",\"dcTxMessages\":" + st.dc_tx_messages.to_string() +
  ",\"dcTxBytes\":" + st.dc_tx_bytes.to_string() +
  ",\"dcRxMessages\":" + st.dc_rx_messages.to_string() +
  ",\"dcRxBytes\":" + st.dc_rx_bytes.to_string() +
  ",\"srtpAuthFailures\":" + st.srtp_auth_failures.to_string() + "}"
}

pub fn webrtc_op(a : Int, b : Int, s : String, t : String) -> String {
  if a == 0 {
    // Create PeerConnection (b != 0 => loopback_only)
    match webrtc::PeerConnection::new(b != 0) {
      Ok(pc) => {
        let id = webrtc_next_id.v
        webrtc_next_id.v = id + 1
        webrtc_peers.set(id, PagePeerEntry::{
          peer: pc,
          last_conn_state: pc.connection_state,
          last_ice_state: pc.ice_connection_state,
          last_gather_state: pc.ice_gathering_state,
          last_sig_state: pc.signaling_state,
        })
        id.to_string()
      }
      Err(e) => "!error:" + e
    }
  } else if a == 1 {
    // createOffer
    match intmap::get(webrtc_peers, b) {
      Some(e) => match e.peer.create_offer() {
        Ok(sdp) => sdp
        Err(err) => "!error:" + err
      }
      None => "!error:unknown peer"
    }
  } else if a == 2 {
    // createAnswer
    match intmap::get(webrtc_peers, b) {
      Some(e) => match e.peer.create_answer() {
        Ok(sdp) => sdp
        Err(err) => "!error:" + err
      }
      None => "!error:unknown peer"
    }
  } else if a == 3 {
    // setLocalDescription(type=s, sdp=t)
    match intmap::get(webrtc_peers, b) {
      Some(e) => match e.peer.set_local_description(s, t) {
        Ok(_) => "ok"
        Err(err) => "!error:" + err
      }
      None => "!error:unknown peer"
    }
  } else if a == 4 {
    // setRemoteDescription(type=s, sdp=t)
    match intmap::get(webrtc_peers, b) {
      Some(e) => match e.peer.set_remote_description(s, t) {
        Ok(_) => "ok"
        Err(err) => "!error:" + err
      }
      None => "!error:" + err_unknown()
    }
  } else if a == 5 {
    // addIceCandidate(s)
    match intmap::get(webrtc_peers, b) {
      Some(e) => match e.peer.add_ice_candidate(s) {
        Ok(_) => "ok"
        Err(err) => "!error:" + err
      }
      None => "!error:unknown peer"
    }
  } else if a == 6 {
    // createDataChannel(label=s)
    match intmap::get(webrtc_peers, b) {
      Some(e) => e.peer.create_data_channel(s).to_string()
      None => "!error:unknown peer"
    }
  } else if a == 7 {
    // sendDataChannel(s="chan_id\t0|1", t=payload)
    match intmap::get(webrtc_peers, b) {
      Some(e) => {
        let tab = s.index_of("\t")
        let (cid, is_bin) = if tab >= 0 {
          (parse_int_simple(s.slice(0, tab)), s.slice(tab + 1, s.length()) == "1")
        } else {
          (parse_int_simple(s), false)
        }
        let payload = if is_bin { b64_decode_webrtc(t) } else { t.to_bytes() }
        match e.peer.send_data_channel(cid, is_bin, payload) {
          Ok(_) => "ok"
          Err(err) => "!error:" + err
        }
      }
      None => "!error:unknown peer"
    }
  } else if a == 8 {
    // getStats
    match intmap::get(webrtc_peers, b) {
      Some(e) => webrtc_stats_json(e.peer)
      None => "{}"
    }
  } else if a == 9 {
    // close PeerConnection
    match intmap::get(webrtc_peers, b) {
      Some(e) => {
        e.peer.close()
        webrtc_peers.delete(b)
        "ok"
      }
      None => "ok"
    }
  } else if a == 10 {
    // enumerateDevices
    webrtc::capture_enumerate_devices()
  } else if a == 11 {
    // captureOpen(kind=b, s="w,h")
    let parts = s.split(",")
    let w = if parts.length() >= 1 && parts[0] != "" { parse_int_simple(parts[0]) } else { 320 }
    let h = if parts.length() >= 2 && parts[1] != "" { parse_int_simple(parts[1]) } else { 240 }
    let ch = webrtc::capture_open(b, w, h)
    if ch > 0 {
      webrtc_captures.push(ch)
      ch.to_string()
    } else {
      "!error:capture open failed"
    }
  } else if a == 12 {
    // captureClose(handle=b)
    if b > 0 {
      webrtc::capture_close(b)
      let mut i = 0
      while i < webrtc_captures.length() {
        if webrtc_captures[i] == b {
          webrtc_captures[i] = 0
        }
        i = i + 1
      }
    }
    "ok"
  } else if a == 13 {
    // pumpNow
    if b > 0 {
      match intmap::get(webrtc_peers, b) {
        Some(e) => e.peer.pump()
        None => ()
      }
    } else {
      for id in webrtc_peers.keys() {
        match intmap::get(webrtc_peers, id) {
          Some(e) => e.peer.pump()
          None => ()
        }
      }
    }
    "ok"
  } else {
    ""
  }
}

fn err_unknown() -> String {
  "unknown peer"
}

pub fn pump_webrtc() -> Unit {
  let keys = webrtc_peers.keys()
  if keys.length() == 0 {
    return
  }
  // Pump multiple short steps per tick so loopback peers converge rapidly within a few ticks
  let mut step = 0
  while step < 4 {
    for id in keys {
      match intmap::get(webrtc_peers, id) {
        Some(e) => e.peer.pump()
        None => ()
      }
    }
    step = step + 1
  }

  let evs : Array[String] = []
  for id in keys {
    match intmap::get(webrtc_peers, id) {
      Some(e) => {
        let p = e.peer
        // Local ICE candidates
        if p.pending_local_candidates.length() > 0 {
          for c in p.pending_local_candidates {
            evs.push("{\"id\":" + id.to_string() + ",\"ev\":\"icecandidate\",\"candidate\":" + jquote(c) + "}")
          }
          p.pending_local_candidates.clear()
        }
        // State transitions
        if p.signaling_state != e.last_sig_state ||
        p.ice_gathering_state != e.last_gather_state ||
        p.ice_connection_state != e.last_ice_state ||
        p.connection_state != e.last_conn_state {
          e.last_sig_state = p.signaling_state
          e.last_gather_state = p.ice_gathering_state
          e.last_ice_state = p.ice_connection_state
          e.last_conn_state = p.connection_state
          evs.push(
            "{\"id\":" + id.to_string() +
            ",\"ev\":\"state\",\"signalingState\":" + jquote(p.signaling_state) +
            ",\"iceGatheringState\":" + jquote(p.ice_gathering_state) +
            ",\"iceConnectionState\":" + jquote(p.ice_connection_state) +
            ",\"connectionState\":" + jquote(p.connection_state) + "}",
          )
        }
        // Local DC open notifications
        if p.pending_dc_opens.length() > 0 {
          for cid in p.pending_dc_opens {
            evs.push("{\"id\":" + id.to_string() + ",\"ev\":\"dcopen\",\"cid\":" + cid.to_string() + "}")
          }
          p.pending_dc_opens.clear()
        }
        // Remote DC created notifications
        if p.pending_remote_dcs.length() > 0 {
          for cid in p.pending_remote_dcs {
            let mut label = ""
            for dc in p.data_channels {
              if dc.id == cid {
                label = dc.label
              }
            }
            evs.push(
              "{\"id\":" + id.to_string() +
              ",\"ev\":\"datachannel\",\"cid\":" + cid.to_string() +
              ",\"label\":" + jquote(label) + "}",
            )
          }
          p.pending_remote_dcs.clear()
        }
        // Received DC messages
        if p.received_dc_messages.length() > 0 {
          for m in p.received_dc_messages {
            let payload_str = if m.is_binary { b64_encode_webrtc(m.data) } else { m.data.to_string() }
            evs.push(
              "{\"id\":" + id.to_string() +
              ",\"ev\":\"dcmsg\",\"cid\":" + m.channel_id.to_string() +
              ",\"binary\":" + (if m.is_binary { "true" } else { "false" }) +
              ",\"data\":" + jquote(payload_str) + "}",
            )
          }
          p.received_dc_messages.clear()
        }
      }
      None => ()
    }
  }
  if evs.length() > 0 {
    run("\{hk()}.__webrtcEvents([" + evs.join(",") + "])")
  }
}
