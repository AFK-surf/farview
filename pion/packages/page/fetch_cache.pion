///| In-process URL fetch cache, prefetch layer, and RFC 9111 SQLite3 WAL HTTP disk cache
///| for `pion/packages/page`.

import "fetch"
import "url"
import "intmap"
import "page_aux"

let fc_picture_accept : String = "Accept: image/webp,image/png,image/jpeg,image/gif,image/svg+xml,image/*;q=0.8,*/*;q=0.5"

struct FetchCache {
  cache : Map[String, (Bytes, String)]
  inflight : Map[String, Int]
  inflight_by_id : intmap::IntMap[String]
  mut ahead : Int
  mut waited : Int
  mut blocked : Int
  mut prof : Bool
  mut prof_min : Int
  mut disk : Option[page_aux::HttpDiskCache]
  mut disk_init : Bool
  mut disk_override : Bool
  mut last_ct : String
  mut last_disp : String
  mut last_headers : String
}

let fcache : FetchCache = FetchCache::{
  cache: Map::new(),
  inflight: Map::new(),
  inflight_by_id: intmap::IntMap::new(),
  ahead: 0,
  waited: 0,
  blocked: 0,
  prof: env_var("FV_PROF").is_some(),
  prof_min: 0,
  disk: Option::None,
  disk_init: false,
  disk_override: false,
  last_ct: "",
  last_disp: "",
  last_headers: "",
}

fn fc_is_http_url(u : String) -> Bool {
  u.starts_with("http://") || u.starts_with("https://")
}

fn fc_disk() -> Option[page_aux::HttpDiskCache] {
  if !fcache.disk_init && !fcache.disk_override {
    fcache.disk_init = true
    let disabled = match env_var("FV_DISABLE_HTTP_CACHE") {
      Option::Some(v) => v == "1" || v == "true"
      Option::None => false
    }
    if !disabled {
      match env_var("FV_PROFILE_DIR") {
        Option::Some(dir) if dir != "" && page_aux::storage_sqlite_available() => {
          fcache.disk = Option::Some(
            page_aux::HttpDiskCache::new(dir, page_aux::default_partition_key(), 0L),
          )
        }
        _ => ()
      }
    }
  }
  fcache.disk
}

pub fn fc_configure_disk_cache(profile_dir : String, partition_key : String, max_bytes : Int64) -> Unit {
  fcache.disk_override = true
  fcache.disk_init = true
  if profile_dir == "" || !page_aux::storage_sqlite_available() {
    fcache.disk = Option::None
  } else {
    fcache.disk = Option::Some(page_aux::HttpDiskCache::new(profile_dir, partition_key, max_bytes))
  }
}

pub fn fc_disable_disk_cache() -> Unit {
  fcache.disk_override = false
  fcache.disk_init = false
  fcache.disk = Option::None
}

pub fn fc_disk_hits() -> Int {
  match fc_disk() {
    Option::Some(d) => d.disk_hits
    Option::None => 0
  }
}

pub fn fc_revalidated_304() -> Int {
  match fc_disk() {
    Option::Some(d) => d.revalidated_304
    Option::None => 0
  }
}

pub fn fc_disk_misses() -> Int {
  match fc_disk() {
    Option::Some(d) => d.disk_misses
    Option::None => 0
  }
}

pub fn fc_disk_stores() -> Int {
  match fc_disk() {
    Option::Some(d) => d.disk_stores
    Option::None => 0
  }
}

pub fn fc_last_content_type() -> String {
  if fcache.last_ct != "" {
    fcache.last_ct
  } else {
    fetch::last_content_type()
  }
}

pub fn fc_last_disposition() -> String {
  if fcache.last_disp != "" {
    fcache.last_disp
  } else {
    fetch::last_disposition()
  }
}

pub fn fc_last_headers() -> String {
  fcache.last_headers
}

pub fn fc_forget() -> Unit {
  fcache.cache.clear()
  fcache.inflight.clear()
  fcache.inflight_by_id.clear()
  fcache.ahead = 0
  fcache.waited = 0
  fcache.blocked = 0
  fcache.last_ct = ""
  fcache.last_disp = ""
  fcache.last_headers = ""
}

pub fn fc_has_fetched(u : String) -> Bool {
  fcache.cache.contains(u)
}

pub fn fc_waiting_for(u : String) -> Bool {
  fcache.inflight.contains(u)
}

pub fn fc_ahead_count() -> Int {
  fcache.ahead
}

pub fn fc_waited_ms() -> Int {
  fcache.waited
}

pub fn fc_blocked_ms() -> Int {
  fcache.blocked
}

pub fn fc_fetch_ahead(urls : Array[String]) -> Unit {
  let disk_opt = fc_disk()
  let now = if disk_opt.is_some() { page_aux::storage_now_unix() } else { 0L }
  for u in urls {
    if u != "" && !fcache.cache.contains(u) && !fcache.inflight.contains(u) {
      if fc_is_http_url(u) {
        match disk_opt {
          Option::Some(d) => match d.lookup(u, now) {
            page_aux::CacheLookup::Fresh(entry) => {
              let fin = if entry.final_url != "" { entry.final_url } else { u }
              fcache.cache.set(u, (entry.body, fin))
              continue
            }
            _ => ()
          }
          Option::None => ()
        }
      }
      let id = fetch::start("GET", u, "", Bytes::new(0), true)
      if id > 0 {
        fcache.inflight.set(u, id)
        fcache.inflight_by_id.set(id, u)
        fcache.ahead += 1
      }
    }
  }
}

pub fn fc_fetch_ahead_with(reqs : Array[(String, String)]) -> Unit {
  for req in reqs {
    let (u, headers) = req
    if u != "" && !fcache.cache.contains(u) && !fcache.inflight.contains(u) {
      let id = fetch::start("GET", u, headers, Bytes::new(0), true)
      if id > 0 {
        fcache.inflight.set(u, id)
        fcache.inflight_by_id.set(id, u)
        fcache.ahead += 1
      }
    }
  }
}

pub fn fc_handle_done(id : Int, ans : fetch::Answer) -> Bool {
  match intmap::get(fcache.inflight_by_id, id) {
    Option::Some(u) => {
      fcache.inflight_by_id.delete(id)
      let _ = fcache.inflight.remove(u)
      if fcache.ahead > 0 {
        fcache.ahead -= 1
      }
      let fin = if ans.url != "" { ans.url } else { u }
      if sec_coep_active() && fc_is_http_url(fin) && !sec_check_corp(st.url, fin, ans.headers, false) {
        fcache.cache.set(u, (Bytes::new(0), fin))
        return true
      }
      if fc_is_http_url(u) && ans.status > 0 {
        match fc_disk() {
          Option::Some(d) => {
            let _ = d.store(u, ans.status, fin, ans.headers, ans.body, page_aux::storage_now_unix())
          }
          Option::None => ()
        }
      }
      fcache.cache.set(u, (ans.body, fin))
      true
    }
    Option::None => false
  }
}

fn fc_wait_inflight(u : String) -> Option[(Bytes, String)] {
  if !fcache.inflight.contains(u) {
    return Option::None
  }
  let mut tries = 0
  while fcache.inflight.contains(u) && tries < 200 {
    let got = fetch::done(50)
    for d in got {
      let (id, ans) = d
      if !fc_handle_done(id, ans) {
        deferred_async_done.push(d)
      }
    }
    if fcache.cache.contains(u) {
      return fcache.cache.get(u)
    }
    tries += 1
  }
  fcache.cache.get(u)
}

pub fn fc_prefetch(urls : Array[String]) -> Unit {
  let missing : Array[String] = []
  let disk_opt = fc_disk()
  let now = if disk_opt.is_some() { page_aux::storage_now_unix() } else { 0L }
  let mut i = 0
  while i < urls.length() {
    let u = urls[i]
    if u != "" && !fcache.cache.contains(u) {
      let mut hit = false
      if fc_is_http_url(u) {
        match disk_opt {
          Option::Some(d) => match d.lookup(u, now) {
            page_aux::CacheLookup::Fresh(entry) => {
              let fin = if entry.final_url != "" { entry.final_url } else { u }
              fcache.cache.set(u, (entry.body, fin))
              hit = true
            }
            _ => ()
          }
          Option::None => ()
        }
      }
      if !hit {
        missing.push(u)
      }
    }
    i = i + 1
  }
  if missing.length() == 0 {
    return
  }
  let got = fetch::get_many(missing)
  i = 0
  while i < got.length() && i < missing.length() {
    let u = missing[i]
    let item = got[i]
    fcache.cache.set(u, item)
    i = i + 1
  }
}

pub fn fc_prefetch_pictures(urls : Array[String]) -> Unit {
  let missing : Array[String] = []
  let disk_opt = fc_disk()
  let now = if disk_opt.is_some() { page_aux::storage_now_unix() } else { 0L }
  let mut i = 0
  while i < urls.length() {
    let u = urls[i]
    if u != "" && !fcache.cache.contains(u) && !u.starts_with("data:") && !u.starts_with("file://") {
      let mut hit = false
      if fc_is_http_url(u) {
        match disk_opt {
          Option::Some(d) => match d.lookup(u, now) {
            page_aux::CacheLookup::Fresh(entry) => {
              let fin = if entry.final_url != "" { entry.final_url } else { u }
              fcache.cache.set(u, (entry.body, fin))
              hit = true
            }
            _ => ()
          }
          Option::None => ()
        }
      }
      if !hit {
        missing.push(u)
      }
    }
    i = i + 1
  }
  if missing.length() == 0 {
    return
  }
  let got = fetch::get_many_pictures(missing)
  i = 0
  while i < got.length() && i < missing.length() {
    let u = missing[i]
    let item = got[i]
    fcache.cache.set(u, item)
    i = i + 1
  }
}

fn fc_get_with_disk(d : page_aux::HttpDiskCache, u : String, extra_headers : String) -> (Bytes, String) {
  let now = page_aux::storage_now_unix()
  match d.lookup(u, now) {
    page_aux::CacheLookup::Fresh(entry) => {
      let fin = if entry.final_url != "" { entry.final_url } else { u }
      fcache.last_ct = entry.content_type
      fcache.last_disp = ""
      let res = (entry.body, fin)
      fcache.cache.set(u, res)
      res
    }
    page_aux::CacheLookup::Stale(entry) => {
      let cond = page_aux::http_cache_conditional_headers(entry)
      let req_hdrs = if extra_headers == "" {
        cond
      } else if cond == "" {
        extra_headers
      } else {
        extra_headers + "\r\n" + cond
      }
      let ans = fetch::request("GET", u, req_hdrs, Bytes::new(0), true)
      if ans.status == 304 {
        let _ = d.revalidate_304(u, ans.headers, page_aux::storage_now_unix())
        let fin = if entry.final_url != "" { entry.final_url } else { u }
        let ct = if entry.content_type != "" { entry.content_type } else { page_aux::header_value(ans.headers, "content-type") }
        fcache.last_ct = ct
        fcache.last_disp = ""
        let res = (entry.body, fin)
        fcache.cache.set(u, res)
        res
      } else {
        let fin = if ans.url != "" { ans.url } else { u }
        if ans.status > 0 {
          let _ = d.store(u, ans.status, fin, ans.headers, ans.body, page_aux::storage_now_unix())
        }
        fcache.last_ct = page_aux::header_value(ans.headers, "content-type")
        fcache.last_disp = page_aux::header_value(ans.headers, "content-disposition")
        let res = (ans.body, fin)
        fcache.cache.set(u, res)
        res
      }
    }
    page_aux::CacheLookup::Miss => {
      let ans = fetch::request("GET", u, extra_headers, Bytes::new(0), true)
      let fin = if ans.url != "" { ans.url } else { u }
      if ans.status > 0 {
        let _ = d.store(u, ans.status, fin, ans.headers, ans.body, page_aux::storage_now_unix())
      }
      fcache.last_ct = page_aux::header_value(ans.headers, "content-type")
      fcache.last_disp = page_aux::header_value(ans.headers, "content-disposition")
      let res = (ans.body, fin)
      fcache.cache.set(u, res)
      res
    }
  }
}

///| A document as it last came, for Back/Forward: its Space's partition (`HistDoc::part`, the cookie partition key of
///| the Space it was fetched in, as the disk cache keys its entries by Space), address, body, final address, headers
///| and content type. The headers are kept without Set-Cookie: a history entry shown again is the document as it was,
///| not a new response, so it must not put an old session's cookies back into the jar (RFC 6265bis §5.6 takes cookies
///| from responses received, and a history copy is none). `names`: the cookies the document was shown with (sent with
///| its request, and as its response left them): when one of them is no longer sent (a sign-out deleted the session
///| cookie), the copy is of a state that is gone and Back fetches the page anew. A cookie only changed in value (a
///| session turned over) keeps the copy, as a browser's history shows the page as it was.
struct HistDoc {
  part : String
  url : String
  body : Bytes
  fin : String
  headers : String
  ct : String
  mut names : Array[String]
}

///| The history's own documents, the newest last: a history navigation shows the entry as it was, from here, stale or
///| not (RFC 9111 §6: a history list is not a cache's freshness matter), unless its response said no-store. At most
///| `hist_docs_most` of them, each up to 4 MB. Emptied when the Space changes (`fc_history_forget_all`), when history
///| is cleared, and per site when the person clears that site's cookies or data; one whose cookies are gone (`names`)
///| is passed over.
let hist_docs : Array[HistDoc] = []
let hist_docs_most : Int = 8
let hist_nav : Array[Bool] = [false]
// whether the last fc_get_doc answered from `hist_docs`
let hist_last_hit : Array[Bool] = [false]

///| The next document fetch is a history navigation (Back/Forward): taken from `hist_docs` when it is there.
pub fn fc_history_nav(on : Bool) -> Unit {
  hist_nav[0] = on
}

///| Whether the last document fetch was answered from the history's own copy (no new response came: nothing in its
///| headers is to be taken as newly received, Set-Cookie above all).
pub fn fc_last_from_history() -> Bool {
  hist_last_hit[0]
}

///| How many documents the history keeps now (for tests and diagnostics).
pub fn fc_history_count() -> Int {
  hist_docs.length()
}

///| Drops every kept history document (the Space changed, history or browsing data cleared).
pub fn fc_history_forget_all() -> Unit {
  hist_docs.clear()
}

///| Drops the kept history documents for which `gone(address)` says so (a site's data cleared, a sign-out).
pub fn fc_history_forget_where(gone : (String) -> Bool) -> Unit {
  let kept : Array[HistDoc] = []
  for e in hist_docs {
    if !gone(e.url) && !gone(e.fin) {
      kept.push(e)
    }
  }
  hist_docs.clear()
  for e in kept {
    hist_docs.push(e)
  }
}

///| `headers` without its Set-Cookie (and Set-Cookie2) lines.
fn hist_headers_kept(headers : String) -> String {
  if !ascii_lower(headers).contains("set-cookie") {
    return headers
  }
  let out : Array[String] = []
  for line in headers.split("\n") {
    let l = ascii_lower(line.trim())
    if l.starts_with("set-cookie:") || l.starts_with("set-cookie2:") {
      continue
    }
    out.push(line)
  }
  out.join("\n")
}

///| The cookie names of a request's headers (`headers`, lines; its `Cookie:` line), in order.
fn hist_cookie_names(headers : String) -> Array[String] {
  let out : Array[String] = []
  for line in headers.split("\n") {
    let l = line.trim()
    if !ascii_lower(l).starts_with("cookie:") {
      continue
    }
    for pair in l.slice(7, l.length()).split(";") {
      let p = pair.trim()
      let name = match str_find(p, "=") {
        Some(i) => p.slice(0, i).trim()
        None => p
      }
      if name != "" {
        out.push(name)
      }
    }
  }
  out
}

///| Whether every cookie in `kept` is still among `now`'s.
fn hist_names_still_sent(kept : Array[String], now : Array[String]) -> Bool {
  for n in kept {
    if !now.contains(n) {
      return false
    }
  }
  true
}

///| The document now shown for `u` (final address `fin`) was a response received now, its cookies set as it left
///| them: `cookie` (a Cookie header value for its address) is what it was shown with, the names its copy needs.
pub fn fc_history_shown_with(u : String, fin : String, cookie : String) -> Unit {
  let part = sec_space_partition()
  let mut i = hist_docs.length() - 1
  while i >= 0 {
    let e = hist_docs[i]
    if e.part == part && (e.url == u || e.fin == fin) {
      // (those sent with its request and still there, and those its response set; one its response took away is
      // not one it was shown with)
      e.names = hist_cookie_names("Cookie: " + cookie)
      return
    }
    i -= 1
  }
}

///| A document fetched anew for `u` in Space partition `part`: it replaces what the history had for that address (in
///| that Space), and is kept when it may be (a 2xx page, not an attachment, not no-store, not empty, at most 4 MB).
///| `names`: the cookies its request was sent with (fc_history_shown_with adds those its response set).
fn hist_doc_keep(part : String, u : String, status : Int, disp : String, body : Bytes, fin : String, headers : String, ct : String, names : Array[String]) -> Unit {
  let kept : Array[HistDoc] = []
  for e in hist_docs {
    if e.part != part || e.url != u && e.fin != fin && e.url != fin && e.fin != u {
      kept.push(e)
    }
  }
  let cc = page_aux::header_value(headers, "cache-control")
  let keeps = status >= 200 && status < 300 && disp == "" && body.length() > 0 && body.length() <= 4194304 && !ascii_lower(cc).contains("no-store")
  if keeps {
    kept.push(HistDoc::{ part, url: u, body, fin, headers: hist_headers_kept(headers), ct, names })
  }
  let from = if kept.length() > hist_docs_most { kept.length() - hist_docs_most } else { 0 }
  hist_docs.clear()
  let mut i = from
  while i < kept.length() {
    hist_docs.push(kept[i])
    i += 1
  }
}

fn hist_doc_find(part : String, u : String) -> Option[HistDoc] {
  let mut i = hist_docs.length() - 1
  while i >= 0 {
    let e = hist_docs[i]
    if e.part == part && (e.url == u || e.fin == u) {
      return Some(e)
    }
    i -= 1
  }
  None
}

fn file_url_to_path(u : String) -> String {
  let p = u.slice(7, u.length())
  if p.length() >= 3 && p[0].to_int() == 47 && p[2].to_int() == 58 {
    p.slice(1, p.length())
  } else {
    p
  }
}

pub fn fc_get_doc(u : String, extra_headers : String) -> (Bytes, String, String) {
  hist_last_hit[0] = false
  if u.starts_with("data:") {
    fcache.last_ct = page_aux::data_url_type(u)
    fcache.last_disp = ""
    fcache.last_headers = ""
    match url::data_url_bytes(u) {
      Option::Some(b) => return (b, u, "")
      Option::None => return (Bytes::new(0), u, "")
    }
  }
  if u.starts_with("file://") {
    fcache.last_ct = ""
    fcache.last_disp = ""
    fcache.last_headers = ""
    let path = file_url_to_path(u)
    match posix_read_bytes(path) {
      Option::Some(b) => return (b, u, "")
      Option::None => return (Bytes::new(0), u, "")
    }
  }
  if u == "about:blank" || u == "" {
    fcache.last_ct = ""
    fcache.last_disp = ""
    fcache.last_headers = ""
    return (Bytes::new(0), if u == "" { "about:blank" } else { u }, "")
  }
  match fcache.cache.get(u) {
    Option::Some((b, fin)) => {
      fcache.last_ct = ""
      fcache.last_disp = ""
      fcache.last_headers = ""
      return (b, fin, "")
    }
    Option::None => ()
  }
  if fc_is_http_url(u) {
    let history = hist_nav[0]
    hist_nav[0] = false
    let part = sec_space_partition()
    let sent = hist_cookie_names(extra_headers)
    if history {
      match hist_doc_find(part, u) {
        // (a copy whose cookies are all still sent: the state it was shown in is the one there is)
        Some(e) if hist_names_still_sent(e.names, sent) => {
          fcache.last_ct = e.ct
          fcache.last_disp = ""
          fcache.last_headers = e.headers
          hist_last_hit[0] = true
          return (e.body, e.fin, e.headers)
        }
        _ => ()
      }
    }
    let ans = fetch::request("GET", u, extra_headers, Bytes::new(0), true)
    let fin = if ans.url != "" { ans.url } else { u }
    fcache.last_ct = page_aux::header_value(ans.headers, "content-type")
    fcache.last_disp = page_aux::header_value(ans.headers, "content-disposition")
    fcache.last_headers = ans.headers
    hist_doc_keep(part, u, ans.status, fcache.last_disp, ans.body, fin, ans.headers, fc_last_content_type(), sent)
    return (ans.body, fin, ans.headers)
  }
  let (b, fin) = fc_get(u)
  (b, fin, "")
}

pub fn fc_get(u : String) -> (Bytes, String) {
  if u.starts_with("data:") {
    match url::data_url_bytes(u) {
      Option::Some(b) => return (b, u)
      Option::None => return (Bytes::new(0), u)
    }
  }
  if u.starts_with("file://") {
    let path = file_url_to_path(u)
    match posix_read_bytes(path) {
      Option::Some(b) => return (b, u)
      Option::None => return (Bytes::new(0), u)
    }
  }
  if u == "about:blank" || u == "" {
    return (Bytes::new(0), if u == "" { "about:blank" } else { u })
  }
  match fcache.cache.get(u) {
    Option::Some(v) => return v
    Option::None => ()
  }
  match fc_wait_inflight(u) {
    Option::Some(v) => return v
    Option::None => ()
  }
  if fc_is_http_url(u) {
    if sec_coep_active() {
      let ans = fetch::request("GET", u, "", Bytes::new(0), true)
      let fin = if ans.url != "" { ans.url } else { u }
      if !sec_check_corp(st.url, fin, ans.headers, false) {
        let blocked = (Bytes::new(0), fin)
        fcache.cache.set(u, blocked)
        return blocked
      }
      fcache.last_ct = page_aux::header_value(ans.headers, "content-type")
      fcache.last_disp = page_aux::header_value(ans.headers, "content-disposition")
      fcache.last_headers = ans.headers
      let res = (ans.body, fin)
      fcache.cache.set(u, res)
      return res
    }
    match fc_disk() {
      Option::Some(d) => return fc_get_with_disk(d, u, "")
      Option::None => ()
    }
  }
  fcache.last_ct = ""
  fcache.last_disp = ""
  fcache.last_headers = ""
  let res = fetch::get(u)
  fcache.cache.set(u, res)
  res
}

pub fn fc_get_picture(u : String) -> (Bytes, String) {
  match fcache.cache.get(u) {
    Option::Some(v) => return v
    Option::None => ()
  }
  if fc_is_http_url(u) {
    if sec_coep_active() {
      let ans = fetch::request("GET", u, fc_picture_accept, Bytes::new(0), true)
      let fin = if ans.url != "" { ans.url } else { u }
      if !sec_check_corp(st.url, fin, ans.headers, false) {
        let blocked = (Bytes::new(0), fin)
        fcache.cache.set(u, blocked)
        return blocked
      }
      let res = (ans.body, fin)
      fcache.cache.set(u, res)
      return res
    }
    match fc_disk() {
      Option::Some(d) => return fc_get_with_disk(d, u, fc_picture_accept)
      Option::None => ()
    }
  }
  let res = fetch::get_picture(u)
  fcache.cache.set(u, res)
  res
}
