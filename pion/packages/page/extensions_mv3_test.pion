///| MV3 runtime parity: extension pages (`chrome-extension://`), `chrome.action`, `chrome.storage`
///| (`local` / `sync` / `session` + `onChanged`), `chrome.alarms`, `chrome.contextMenus`, `chrome.scripting`,
///| `chrome.runtime` (`getURL`, `onInstalled`, `openOptionsPage`) in pages, content scripts and the worker.

fn ext_t_wait(what : String, ready : () -> Bool, seen~ : () -> String = fn() { "" }) -> Unit {
  let mut i = 0
  while i < 400 {
    if st.started {
      // (a display frame of the page's own: its timers, then the extensions' turn)
      tick(16)
    } else {
      pump_extensions()
    }
    if ready() {
      return
    }
    js::worker_sleep_ms(2)
    i = i + 1
  }
  debug_assert(false, "timed out waiting for " + what + ": " + seen())
}

fn ext_t_info(id : String, tab~ : Int = -1) -> Option[ExtensionRuntimeInfo] {
  for it in list_installed_extensions(tab=tab) {
    if it.id == id {
      return Some(it)
    }
  }
  None
}

fn ext_t_has_menu(url : String, id : String) -> Bool {
  for m in extension_context_menu_items(url) {
    if m.id == id {
      return true
    }
  }
  false
}

test "MV3 extension page: chrome.action badge/title/popup per tab, runtime.getURL, storage areas + onChanged" {
  configure_extensions_storage("")
  clear_extensions()
  let manifest = "{\"manifest_version\":3,\"name\":\"Badge Lab\",\"version\":\"1.0.0\",\"description\":\"d\"," +
  "\"permissions\":[\"storage\",\"alarms\",\"contextMenus\",\"scripting\"]," +
  "\"action\":{\"default_title\":\"Badge Lab\",\"default_popup\":\"popup.html\"},\"options_page\":\"options.html\"," +
  "\"web_accessible_resources\":[{\"resources\":[\"pub/*\"],\"matches\":[\"https://*.example.com/*\"]}]}"
  let files : Map[String, String] = Map::new()
  files.set("popup.html", "<!doctype html><html><head><title>Popup</title><script src=\"popup.js\"></script></head><body><p id=s>pop</p></body></html>")
  files.set(
    "popup.js",
    "window.__log = [];" +
    "chrome.storage.onChanged.addListener((c, area) => window.__log.push(area + '|' + JSON.stringify(c)));" +
    "chrome.storage.local.onChanged.addListener((c) => window.__log.push('local-only|' + Object.keys(c).join(',')));" +
    "chrome.action.onClicked.addListener((tab) => { window.__clicked = tab.id + '|' + tab.url; });" +
    "window.__boot = typeof chrome.action.setBadgeText + '|' + chrome.runtime.getURL('/a/b.html');",
  )
  files.set("options.html", "<p>options</p>")
  files.set("pub/logo.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\"></svg>")
  files.set("private.js", "1")
  match install_extension("ext-badge-lab", manifest, files) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "install failed: " + e)
  }
  debug_assert(extension_install_reason("ext-badge-lab") == "install", "first install reason")

  // chrome-extension:// resources: navigations and the extension's own pages, WAR for web pages only
  debug_assert(extension_resource("chrome-extension://ext-badge-lab/popup.html", "") is Some(_), "popup served to a navigation")
  debug_assert(extension_resource("chrome-extension://ext-badge-lab/pub/logo.svg", "https://app.example.com/") is Some(_), "WAR served")
  debug_assert(extension_resource("chrome-extension://ext-badge-lab/private.js", "https://app.example.com/") is None, "non-WAR refused")
  debug_assert(extension_resource("chrome-extension://ext-badge-lab/pub/logo.svg", "https://evil.test/") is None, "WAR refused off its matches")
  debug_assert(
    extension_resource("chrome-extension://ext-badge-lab/private.js", "chrome-extension://ext-badge-lab/popup.html") is Some(_),
    "own page reads any file",
  )

  let popup = match ext_t_info("ext-badge-lab") {
    Some(i) => i.popup_url
    None => ""
  }
  debug_assert(popup == "chrome-extension://ext-badge-lab/popup.html", "popup url: " + popup)
  debug_assert(load(popup, 320.0, 480.0), "popup page loaded")
  tick(16)
  debug_assert(eval("window.__boot") == "function|chrome-extension://ext-badge-lab/a/b.html", "page chrome.*: " + eval("String(window.__boot)"))
  debug_assert(eval("document.getElementById('s').textContent") == "pop", "popup DOM")

  // chrome.action: global and per-tab badge text, colour, title
  let _ = eval(
    "chrome.action.setBadgeText({ text: '7' }); chrome.action.setBadgeBackgroundColor({ color: '#FF0000' });" +
    "chrome.action.setBadgeText({ text: 'T2', tabId: 2 }); chrome.action.setBadgeBackgroundColor({ color: [0, 128, 255, 200], tabId: 2 });" +
    "chrome.action.setTitle({ title: 'Hi there' });" +
    "Promise.all([chrome.action.getBadgeText({}), chrome.action.getBadgeText({ tabId: 2 }), chrome.action.getBadgeBackgroundColor({})," +
    " chrome.action.getBadgeBackgroundColor({ tabId: 2 }), chrome.action.getTitle({}), chrome.action.getPopup({})]).then((v) => { window.__r1 = JSON.stringify(v); }); 1",
  )
  tick(16)
  let r1 = eval("window.__r1")
  debug_assert(
    r1 == "[\"7\",\"T2\",[255,0,0,255],[0,128,255,200],\"Hi there\",\"chrome-extension://ext-badge-lab/popup.html\"]",
    "action getters: " + r1,
  )
  match ext_t_info("ext-badge-lab") {
    Some(i) => {
      debug_assert(i.badge_text == "7" && i.badge_bg == 0xFF0000FFL && i.title == "Hi there", "tab 1 badge: " + i.badge_text)
      debug_assert(i.has_action && i.action_enabled, "action enabled")
      debug_assert(i.options_url == "chrome-extension://ext-badge-lab/options.html", "options url")
    }
    None => debug_assert(false, "ext listed")
  }
  match ext_t_info("ext-badge-lab", tab=2) {
    Some(i) => debug_assert(i.badge_text == "T2" && i.badge_bg == 0x0080FFC8L, "tab 2 badge override")
    None => debug_assert(false, "ext listed for tab 2")
  }

  // a toolbar press: popup page while one is set; onClicked (with the tab) once it is cleared; nothing when disabled
  debug_assert(extension_action_click("ext-badge-lab") == popup, "press opens the popup")
  let _ = eval("chrome.action.setPopup({ popup: '' }); 1")
  tick(16)
  debug_assert(extension_action_click("ext-badge-lab") == "", "no popup: onClicked")
  debug_assert(eval("window.__clicked") == "1|" + popup, "onClicked got the tab: " + eval("String(window.__clicked)"))
  let _ = eval("window.__clicked = ''; chrome.action.disable(); 1")
  tick(16)
  debug_assert(extension_action_click("ext-badge-lab") == "" && eval("window.__clicked") == "", "disabled action fires nothing")
  let _ = eval("chrome.action.enable(); chrome.action.isEnabled().then((v) => { window.__en = String(v); }); 1")
  tick(16)
  debug_assert(eval("window.__en") == "true", "isEnabled after enable")

  // chrome.storage: session keeps fractions in memory, sync is local-backed, onChanged on set/remove/clear
  let _ = eval(
    "(async () => { await chrome.storage.session.set({ s: 1.5 }); await chrome.storage.sync.set({ y: { a: [1, 'x'] } });" +
    " await chrome.storage.local.set({ k: 'v' }); await chrome.storage.local.set({ k: 'v' }); await chrome.storage.local.remove('k');" +
    " const s = await chrome.storage.session.get('s'); const y = await chrome.storage.sync.get(['y', 'none']);" +
    " await chrome.storage.sync.clear(); const after = await chrome.storage.sync.get(null);" +
    " const dflt = await chrome.storage.local.get({ k: 'dflt' });" +
    " window.__r2 = JSON.stringify([s, y, after, dflt]); })(); 1",
  )
  tick(16)
  let r2 = eval("window.__r2")
  debug_assert(r2 == "[{\"s\":1.5},{\"y\":{\"a\":[1,\"x\"]}},{},{\"k\":\"dflt\"}]", "storage areas: " + r2)
  let log = eval("window.__log.join('\\n')")
  debug_assert(
    log ==
    "session|{\"s\":{\"newValue\":1.5}}\n" +
    "sync|{\"y\":{\"newValue\":{\"a\":[1,\"x\"]}}}\n" +
    "local|{\"k\":{\"newValue\":\"v\"}}\nlocal-only|k\n" +
    "local|{\"k\":{\"oldValue\":\"v\"}}\nlocal-only|k\n" +
    "sync|{\"y\":{\"oldValue\":{\"a\":[1,\"x\"]}}}",
    "onChanged log:\n" + log,
  )
  debug_assert(extension_storage_dump("ext-badge-lab", area="session") == "{\"s\":1.5}", "session dump")

  // runtime.openOptionsPage
  let _ = eval("chrome.runtime.openOptionsPage(); 1")
  tick(16)
  let opens = take_extension_open_requests()
  debug_assert(opens.length() == 1 && opens[0] == "chrome-extension://ext-badge-lab/options.html", "options page request")
  debug_assert(take_extension_open_requests().length() == 0, "requests taken once")

  // reinstalling the same version is a start, a new version an update
  let _ = install_extension("ext-badge-lab", manifest, files)
  debug_assert(extension_install_reason("ext-badge-lab") == "", "same version: onStartup")
  let _ = install_extension("ext-badge-lab", manifest.replace("\"1.0.0\"", "\"1.1.0\""), files)
  debug_assert(extension_install_reason("ext-badge-lab") == "update", "new version: update")
  debug_assert(uninstall_extension("ext-badge-lab", wipe_data=true), "uninstall")
  debug_assert(list_installed_extensions().length() == 0, "nothing listed after uninstall")
  debug_assert(extension_resource(popup, "") is None, "no pages after uninstall")
  clear_extensions()
}

test "MV3 extension page: chrome.alarms create/get/fire/clear, contextMenus tree + onClicked, scripting under host access and activeTab" {
  configure_extensions_storage("")
  clear_extensions()
  let manifest = "{\"manifest_version\":3,\"name\":\"Alarm Lab\",\"version\":\"2.0\"," +
  "\"permissions\":[\"alarms\",\"contextMenus\",\"scripting\",\"activeTab\"],\"host_permissions\":[\"https://*.example.com/*\"],\"action\":{}}"
  let files : Map[String, String] = Map::new()
  files.set("page.html", "<!doctype html><html><head><title>Lab</title></head><body><p>lab</p></body></html>")
  files.set("inject.js", "document.body.setAttribute('data-injected', 'yes'); document.title + '!'")
  match install_extension("ext-alarm-lab", manifest, files) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "install failed: " + e)
  }
  let page = "chrome-extension://ext-alarm-lab/page.html"
  debug_assert(load(page, 400.0, 300.0), "extension page loaded")
  tick(16)
  debug_assert(eval("typeof chrome.storage") == "undefined" && eval("typeof chrome.alarms") == "object", "no storage permission, no chrome.storage")

  // alarms
  let t0 = ext_now_ms()
  let _ = eval(
    "window.__alarms = []; chrome.alarms.onAlarm.addListener((a) => window.__alarms.push(a.name + (a.periodInMinutes ? '@' + a.periodInMinutes : '')));" +
    "chrome.alarms.create('once', { delayInMinutes: 1 }); chrome.alarms.create('rep', { when: Date.now() + 1000, periodInMinutes: 2 });" +
    "chrome.alarms.create({ delayInMinutes: 30 });" +
    "Promise.all([chrome.alarms.get('once'), chrome.alarms.getAll()]).then(([a, all]) => { window.__a1 = a.name + '|' + Math.round((a.scheduledTime - Date.now()) / 1000) + '|' + all.length; }); 1",
  )
  tick(16)
  debug_assert(eval("window.__a1") == "once|60|3", "alarms.get / getAll: " + eval("String(window.__a1)"))
  debug_assert(fire_extension_alarms(t0 + 30000.0) == 1, "only 'rep' is due at +30s")
  debug_assert(fire_extension_alarms(t0 + 61000.0) == 1, "then 'once' at +61s")
  debug_assert(fire_extension_alarms(t0 + 62000.0) == 0, "a one-shot alarm fires once; rep not due again yet")
  debug_assert(fire_extension_alarms(t0 + 125000.0) == 1, "rep again a period later")
  tick(16)
  debug_assert(eval("window.__alarms.join(',')") == "rep@2,once,rep@2", "onAlarm order: " + eval("window.__alarms.join(',')"))
  let _ = eval(
    "(async () => { const c1 = await chrome.alarms.clear('rep'); const c2 = await chrome.alarms.clear('rep');" +
    " const left = await chrome.alarms.getAll(); const all = await chrome.alarms.clearAll(); const none = await chrome.alarms.getAll();" +
    " window.__a2 = [c1, c2, left.length, left[0] && left[0].name, all, none.length].join('|'); })(); 1",
  )
  tick(16)
  debug_assert(eval("window.__a2") == "true|false|1||true|0", "alarms clear / clearAll: " + eval("String(window.__a2)"))

  // contextMenus: generated ids, a tree, duplicates refused, onClicked with a checkbox's state
  let _ = eval(
    "window.__menu = []; chrome.contextMenus.onClicked.addListener((info, tab) => window.__menu.push(info.menuItemId + ':' + info.checked + ':' + info.parentMenuItemId + ':' + tab.id));" +
    "chrome.contextMenus.create({ id: 'root', title: 'Root', contexts: ['selection', 'page'] });" +
    "chrome.contextMenus.create({ id: 'kid', parentId: 'root', title: 'Kid', type: 'checkbox' });" +
    "window.__gen = chrome.contextMenus.create({ title: 'Auto' });" +
    "chrome.contextMenus.create({ id: 'root', title: 'Again' }, () => { window.__dup = chrome.runtime.lastError ? chrome.runtime.lastError.message : 'none'; }); 1",
  )
  tick(16)
  debug_assert(eval("String(window.__gen)") == "1", "generated id")
  debug_assert(eval("window.__dup").contains("duplicate id root"), "duplicate refused: " + eval("String(window.__dup)"))
  let items = extension_context_menu_items(page)
  debug_assert(items.length() == 3, "3 items: " + items.length().to_string())
  debug_assert(items[1].parent_id == "root" && items[1].kind == "checkbox" && items[0].contexts.length() == 2, "item fields")
  debug_assert(click_extension_context_menu("ext-alarm-lab", "kid", info_json="{\"selectionText\":\"hey\"}"), "click kid")
  tick(16)
  debug_assert(eval("window.__menu.join(',')") == "kid:true:root:1", "onClicked info: " + eval("window.__menu.join(',')"))
  let _ = eval("chrome.contextMenus.update('kid', { title: 'Kid 2', enabled: false }); chrome.contextMenus.remove('root'); 1")
  tick(16)
  debug_assert(!ext_t_has_menu(page, "root") && !ext_t_has_menu(page, "kid") && ext_t_has_menu(page, "1"), "remove takes the subtree")

  // scripting needs host access to the page shown: the extension's own page is a privileged surface no extension
  // scripts; a web page under its host_permissions it can, another page only once activeTab is granted
  let _ = eval("chrome.scripting.executeScript({ target: { tabId: 1 }, func: () => 1 }).catch((e) => { window.__own = e.message; }); 1")
  tick(16)
  debug_assert(eval("String(window.__own)").contains("Cannot access contents of the page"), "own page refused: " + eval("String(window.__own)"))
  let web = "https://lab.example.com/doc"
  fcache.cache.set(web, ("<!doctype html><html><head><title>Lab</title></head><body><p>lab</p></body></html>".to_bytes(), web))
  debug_assert(load(web, 400.0, 300.0), "web page loaded")
  tick(16)
  let call = fn(a : Int, t : String) -> String { ext_api("ext-alarm-lab", a, 0, t, true) }
  let exec = fn(t : String) -> String { call(60, t) }
  debug_assert(
    exec("{\"tabId\":1,\"world\":\"ISOLATED\",\"files\":[\"inject.js\"],\"func\":\"\",\"args\":[]}") ==
    "[{\"frameId\":0,\"documentId\":\"0\",\"result\":\"Lab!\"}]",
    "files: the last file's value",
  )
  let b = exec("{\"tabId\":-1,\"world\":\"ISOLATED\",\"files\":[],\"func\":\"(x, y) => x + y + document.body.getAttribute('data-injected')\",\"args\":[2,3]}")
  debug_assert(b.contains("\"result\":\"5yes\""), "func with args: " + b)
  let _ = eval("window.__mainOnly = 'main'; 1")
  debug_assert(exec("{\"world\":\"MAIN\",\"files\":[],\"func\":\"() => window.__mainOnly\",\"args\":[]}").contains("\"result\":\"main\""), "MAIN world")
  debug_assert(exec("{\"files\":[],\"func\":\"() => typeof window.__mainOnly\",\"args\":[]}").contains("\"result\":\"undefined\""), "isolated world")
  debug_assert(exec("{\"tabId\":9,\"files\":[],\"func\":\"() => 1\",\"args\":[]}").contains("No tab with id: 9"), "unknown tab")
  debug_assert(exec("{\"files\":[\"nope.js\"],\"func\":\"\",\"args\":[]}").contains("Could not load file: 'nope.js'."), "missing file")
  debug_assert(exec("{\"files\":[],\"func\":\"() => { throw new Error('boom') }\",\"args\":[]}").contains("__fvError\":\"boom"), "a throw rejects")
  let css = "{\"tabId\":1,\"css\":\"p { color: rgb(1, 2, 3); }\",\"files\":[]}"
  debug_assert(call(61, css) == "true", "insertCSS")
  tick(16)
  debug_assert(eval("document.querySelectorAll('style[data-fv-ext-css]').length") == "1", "style inserted")
  debug_assert(call(62, css) == "true", "removeCSS")
  tick(16)
  debug_assert(eval("document.querySelectorAll('style[data-fv-ext-css]').length") == "0", "style removed")
  debug_assert(eval("document.body.getAttribute('data-injected')") == "yes", "injected file ran on the shared DOM")
  // a page outside host_permissions: refused until a toolbar press grants activeTab for it
  let other = "https://other.test/"
  fcache.cache.set(other, ("<!doctype html><html><body>o</body></html>".to_bytes(), other))
  debug_assert(load(other, 400.0, 300.0), "other page loaded")
  tick(16)
  let probe = "{\"files\":[],\"func\":\"() => location.href\",\"args\":[]}"
  debug_assert(exec(probe).contains("Cannot access contents of the page"), "no host access: " + exec(probe))
  debug_assert(call(30, "{}").contains("\"url\"") == false, "tabs.query hides the URL without access")
  debug_assert(extension_action_click("ext-alarm-lab") == "", "toolbar press (no popup)")
  debug_assert(exec(probe).contains("\"result\":\"https://other.test/\""), "activeTab grant: " + exec(probe))
  debug_assert(call(30, "{}").contains("\"url\":\"https://other.test/\""), "tabs.query shows it with activeTab")
  debug_assert(uninstall_extension("ext-alarm-lab"), "uninstall")
  debug_assert(extension_context_menu_items(page).length() == 0, "menus dropped with the extension")
  clear_extensions()
}

test "MV3 background worker: onInstalled, action badge, storage.onChanged in worker + content script, alarms, contextMenus -> scripting" {
  configure_extensions_storage("")
  clear_extensions()
  let manifest = "{\"manifest_version\":3,\"name\":\"Worker Lab\",\"version\":\"3.0.0\"," +
  "\"permissions\":[\"storage\",\"alarms\",\"contextMenus\",\"scripting\"],\"host_permissions\":[\"https://*.example.com/*\"]," +
  "\"action\":{\"default_title\":\"Worker Lab\"},\"background\":{\"service_worker\":\"bg.js\"}," +
  "\"content_scripts\":[{\"matches\":[\"https://app.example.com/*\"],\"js\":[\"cs.js\"],\"run_at\":\"document_idle\"}]}"
  let files : Map[String, String] = Map::new()
  files.set(
    "bg.js",
    "const log = [];" +
    "chrome.runtime.onInstalled.addListener((d) => { log.push('installed:' + d.reason); chrome.contextMenus.create({ id: 'm1', title: 'Shout', contexts: ['page'] });" +
    "  chrome.action.setBadgeText({ text: 'ON' }); chrome.action.setBadgeBackgroundColor({ color: [0, 128, 255, 255] }); });" +
    "chrome.storage.onChanged.addListener((c, area) => log.push('changed:' + area + ':' + Object.keys(c).join(',')));" +
    "chrome.alarms.onAlarm.addListener((a) => { log.push('alarm:' + a.name); chrome.action.setBadgeText({ text: 'A' }); });" +
    "chrome.contextMenus.onClicked.addListener((info, tab) => { log.push('menu:' + info.menuItemId + ':' + tab.id);" +
    "  chrome.scripting.executeScript({ target: { tabId: tab.id }, func: (n) => { document.body.setAttribute('data-shout', 'x' + n); return document.title; }, args: [3] })" +
    "    .then((r) => log.push('exec:' + r[0].result)); });" +
    "chrome.action.onClicked.addListener((tab) => { chrome.scripting.insertCSS({ target: { tabId: tab.id }, css: 'main { color: red; }' }).then(() => log.push('css')); });" +
    "chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {" +
    "  if (msg === 'log') { sendResponse(log.slice()); return; }" +
    "  if (msg === 'bump') { chrome.storage.local.get('n').then((o) => { const n = (o.n || 0) + 1; chrome.storage.local.set({ n }).then(() => sendResponse({ n, url: chrome.runtime.getURL('x') })); }); return true; }" +
    "});" +
    "chrome.alarms.create('tick', { delayInMinutes: 5 });",
  )
  files.set("cs.js", "chrome.storage.onChanged.addListener((c, area) => document.body.setAttribute('data-cs-changed', area + ':' + Object.keys(c).join(',')));")
  match install_extension("ext-worker-lab", manifest, files) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "install failed: " + e)
  }
  debug_assert(extension_bg_worker_id("ext-worker-lab") > 0, "worker spawned")
  ext_t_wait("onInstalled badge from the worker", fn() {
    match ext_t_info("ext-worker-lab") {
      Some(i) => i.badge_text == "ON" && i.badge_bg == 0x0080FFFFL
      None => false
    }
  })
  let url = "https://app.example.com/home"
  debug_assert(ext_t_has_menu(url, "m1"), "worker registered its context menu item")

  fcache.cache.set(url, ("<!doctype html><html><head><title>App</title></head><body><main>hi</main></body></html>".to_bytes(), url))
  debug_assert(load(url, 800.0, 600.0), "web page loaded")
  tick(16)

  // a content script's message: the worker reads and writes storage (its RPCs answered while the host waits)
  let _ = eval_in_extension_world(
    "ext-worker-lab",
    "chrome.runtime.sendMessage('bump').then((r) => document.body.setAttribute('data-n', r.n + '|' + r.url)); 1",
  )
  tick(16)
  debug_assert(eval("document.body.getAttribute('data-n')") == "1|chrome-extension://ext-worker-lab/x", "worker reply: " + eval("String(document.body.getAttribute('data-n'))"))
  debug_assert(eval("document.body.getAttribute('data-cs-changed')") == "local:n", "content script heard storage.onChanged")
  debug_assert(extension_storage_dump("ext-worker-lab") == "{\"n\":1}", "worker's write persisted")

  // alarms fire in the worker, which sets the badge
  debug_assert(fire_extension_alarms(ext_now_ms() + 301000.0) == 1, "tick due")
  ext_t_wait("onAlarm badge", fn() {
    match ext_t_info("ext-worker-lab") {
      Some(i) => i.badge_text == "A"
      None => false
    }
  })

  // a context menu press: the worker scripts the page (host permission for *.example.com)
  debug_assert(click_extension_context_menu("ext-worker-lab", "m1"), "menu click")
  // (the page read data-shout before the worker's script set it: its cached attributes must not hide the change)
  ext_t_wait("executeScript from the worker", fn() { eval("document.body.getAttribute('data-shout')") == "x3" }, seen=fn() {
    eval("String(document.body.getAttribute('data-shout'))") + " / " + eval("document.body.outerHTML")
  })

  // a toolbar press without a popup: onClicked in the worker -> insertCSS
  debug_assert(extension_action_click("ext-worker-lab") == "", "no popup")
  ext_t_wait("insertCSS from the worker", fn() { eval("document.querySelectorAll('style[data-fv-ext-css]').length") == "1" })

  let _ = eval_in_extension_world("ext-worker-lab", "chrome.runtime.sendMessage('log').then((r) => document.body.setAttribute('data-log', r.join(','))); 1")
  tick(16)
  ext_t_wait("worker log", fn() { eval("String(document.body.getAttribute('data-log'))").contains("css") })
  let log = eval("document.body.getAttribute('data-log')")
  debug_assert(
    log == "installed:install,changed:local:n,alarm:tick,menu:m1:1,exec:App,css",
    "worker log: " + log,
  )
  // the content script world has no worker-only APIs
  debug_assert(
    eval_in_extension_world("ext-worker-lab", "[typeof chrome.action, typeof chrome.alarms, typeof chrome.storage.session, typeof chrome.storage.sync].join('|')") ==
    "undefined|undefined|undefined|object",
    "content script API surface",
  )
  clear_extensions()
}

test "MV3 M1.1: Full-DOM Isolated World (Shadow DOM, MutationObserver, cross-world events, no checkbox double-toggle, all_frames)" {
  configure_extensions_storage("")
  clear_extensions()
  let ext_id = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let manifest = "{" +
  "\"manifest_version\":3," +
  "\"name\":\"FullDomVault\"," +
  "\"version\":\"1.0.0\"," +
  "\"permissions\":[\"storage\"]," +
  "\"host_permissions\":[\"https://*.login.example/*\"]," +
  "\"content_scripts\":[" +
  "  {\"matches\":[\"https://*.login.example/*\"],\"js\":[\"cs.js\"],\"run_at\":\"document_idle\",\"all_frames\":true}," +
  "  {\"matches\":[\"https://*.login.example/*\"],\"js\":[\"main_hook.js\"],\"run_at\":\"document_start\",\"world\":\"MAIN\"}" +
  "]}"
  let files : Map[String, String] = Map::new()
  files.set("main_hook.js", "window.__mainHookRan = 'YES';")
  files.set(
    "cs.js",
    "window.__isoCheck = Array.prototype.push === [].push;\n" +
    "document.documentElement.setAttribute('data-frame-hit', location.href);\n" +
    "const host = document.createElement('div'); host.id = 'vault-host';\n" +
    "const sr = host.attachShadow({ mode: 'closed' });\n" +
    "const btn = document.createElement('button'); btn.textContent = 'Fill'; sr.appendChild(btn);\n" +
    "document.body.appendChild(host);\n" +
    "window.__srOk = sr.querySelector('button').textContent === 'Fill';\n" +
    "window.__moHits = [];\n" +
    "const mo = new MutationObserver((recs) => {\n" +
    "  for (const r of recs) window.__moHits.push(r.type + ':' + (r.attributeName || r.addedNodes.length));\n" +
    "});\n" +
    "mo.observe(document.body, { childList: true, attributes: true, subtree: true });\n" +
    "window.__isoFocus = 0;\n" +
    "const inp = document.getElementById('user');\n" +
    "if (inp) {\n" +
    "  inp.addEventListener('focus', () => { window.__isoFocus++; });\n" +
    "  window.__doFill = () => { inp.value = 'alice@1p.test'; inp.dispatchEvent(new Event('input', { bubbles: true })); };\n" +
    "}\n",
  )
  debug_assert(install_extension(ext_id, manifest, files) is Ok(_), "install full-dom ext")

  let main_url = "https://app.login.example/signin"
  let sub_url = "https://app.login.example/iframe"
  fcache.cache.set(sub_url, ("<!doctype html><html><body><p>sub</p></body></html>".to_bytes(), sub_url))
  let html = (
    "<!doctype html><html><body>" +
    "<input id='user' type='text'><input id='cb' type='checkbox'>" +
    "<iframe id='f1' src='" + sub_url + "'></iframe>" +
    "<script>" +
    "window.__pageInputVal = '';" +
    "document.getElementById('user').addEventListener('input', e => { window.__pageInputVal = e.target.value; });" +
    "Array.prototype.push = function() { return 999; };" +
    "</script></body></html>"
  ).to_bytes()
  fcache.cache.set(main_url, (html, main_url))
  debug_assert(load(main_url, 800.0, 600.0), "load login page")
  tick(64)

  // MAIN world content script + Isolated World Shadow DOM + pristine Array.prototype + all_frames
  debug_assert(eval("window.__mainHookRan") == "YES", "world:MAIN content script ran")
  debug_assert(eval_in_extension_world(ext_id, "String(window.__srOk)") == "true", "closed ShadowRoot works in isolated world")
  debug_assert(eval_in_extension_world(ext_id, "const a=[]; a.push(1); String(a.length)") == "1", "isolated Array.prototype unaffected by page poisoning")
  debug_assert(eval("document.getElementById('f1').contentDocument.documentElement.getAttribute('data-frame-hit')") == sub_url, "all_frames injected into subframe")

  // Cross-world event forwarding (main -> iso AND iso -> main) + P0-3 single checkbox toggle
  let _ = eval("document.getElementById('user').dispatchEvent(new FocusEvent('focus', { bubbles: true }))")
  tick(16)
  debug_assert(eval_in_extension_world(ext_id, "String(window.__isoFocus)") == "1", "main->iso focus forwarded")
  let _ = eval_in_extension_world(ext_id, "window.__doFill(); 'ok'")
  tick(16)
  debug_assert(eval("window.__pageInputVal") == "alice@1p.test", "iso->main input forwarded: " + eval("String(window.__pageInputVal)"))
  debug_assert(eval("document.getElementById('cb').checked") == "false", "checkbox starts false")
  let _ = eval("document.getElementById('cb').click()")
  tick(16)
  debug_assert(eval("document.getElementById('cb').checked") == "true", "P0-3: checkbox toggled once (no double activateDispatch)")

  // Cross-world MutationObserver (main world DOM insert + attribute change -> isolated world MO)
  let _ = eval("const s = document.createElement('span'); s.id = 'dyn'; document.body.appendChild(s); s.setAttribute('data-k', 'v');")
  tick(32)
  let mo_hits = eval_in_extension_world(ext_id, "window.__moHits.join(',')")
  debug_assert(mo_hits.contains("childList:") && mo_hits.contains("attributes:data-k"), "cross-world MO delivered: " + mo_hits)

  clear_extensions()
}

test "MV3 M1.2: ES Module Service Worker (import, import.meta.url, TLA), WebCrypto AES-GCM, WASM fetch, i18n, commands, permissions, offscreen, Ports" {
  configure_extensions_storage("")
  clear_extensions()
  let ext_id = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let manifest = "{" +
  "\"manifest_version\":3," +
  "\"name\":\"__MSG_appName__\"," +
  "\"version\":\"2.0.0\"," +
  "\"default_locale\":\"en\"," +
  "\"permissions\":[\"storage\",\"offscreen\",\"tabs\"]," +
  "\"host_permissions\":[\"https://*.example.com/*\"]," +
  "\"background\":{\"service_worker\":\"sw/main.mjs\",\"type\":\"module\"}," +
  "\"commands\":{\"fill\":{\"suggested_key\":{\"default\":\"Ctrl+Shift+L\"},\"description\":\"Autofill\"}}," +
  "\"content_scripts\":[{\"matches\":[\"https://*.example.com/*\"],\"js\":[\"cs.js\"],\"run_at\":\"document_idle\"}]" +
  "}"
  let files : Map[String, String] = Map::new()
  files.set("_locales/en/messages.json", "{\"appName\":{\"message\":\"1Vault\"},\"hi\":{\"message\":\"Hello $1\"}}")
  files.set("sw/util.mjs", "export const SECRET = 42; export const metaUrl = import.meta.url;")
  files.set(
    "sw/main.mjs",
    "import { SECRET, metaUrl } from './util.mjs';\n" +
    "// Top-level await + WebCrypto AES-GCM + WASM fetch from extension binary VFS\n" +
    "const key = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt', 'decrypt']);\n" +
    "const iv = crypto.getRandomValues(new Uint8Array(12));\n" +
    "const pt = new TextEncoder().encode('vault-secret');\n" +
    "const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, pt);\n" +
    "const dec = new TextDecoder().decode(await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ct));\n" +
    "const wasmResp = await fetch(chrome.runtime.getURL('core/add.wasm'));\n" +
    "const { instance } = await WebAssembly.instantiate(await wasmResp.arrayBuffer());\n" +
    "const wasmSum = instance.exports.add(19, 23);\n" +
    "const cmds = await chrome.commands.getAll();\n" +
    "const hasOff0 = await chrome.offscreen.hasDocument();\n" +
    "await chrome.offscreen.createDocument({ url: 'off.html', reasons: ['DOM_PARSER'], justification: 'test' });\n" +
    "const hasOff1 = await chrome.offscreen.hasDocument();\n" +
    "const i18nHi = chrome.i18n.getMessage('hi', ['World']);\n" +
    "const permOk = await chrome.permissions.contains({ permissions: ['storage'] });\n" +
    "const bootInfo = { SECRET, metaUrl, dec, wasmSum, cmd: cmds[0].name, hasOff0, hasOff1, i18nHi, permOk, hasBrowser: browser === chrome };\n" +
    "chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {\n" +
    "  if (msg === 'boot') { sendResponse(bootInfo); return; }\n" +
    "});\n" +
    "chrome.runtime.onConnect.addListener((port) => {\n" +
    "  port.onMessage.addListener((m) => port.postMessage({ echo: m.v + ':' + port.name }));\n" +
    "});\n",
  )
  files.set(
    "cs.js",
    "window.__portGot = '';\n" +
    "const p = chrome.runtime.connect({ name: 'vault-chan' });\n" +
    "p.onMessage.addListener((m) => { window.__portGot = m.echo; });\n" +
    "p.postMessage({ v: 'ping' });\n",
  )
  // Minimal valid WASM module exporting `add(i32, i32) -> i32`
  let wasm_bytes : Array[Int] = [
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00,
    0x01, 0x07, 0x01, 0x60, 0x02, 0x7f, 0x7f, 0x01, 0x7f,
    0x03, 0x02, 0x01, 0x00,
    0x07, 0x07, 0x01, 0x03, 0x61, 0x64, 0x64, 0x00, 0x00,
    0x0a, 0x09, 0x01, 0x07, 0x00, 0x20, 0x00, 0x20, 0x01, 0x6a, 0x0b,
  ]
  let wasm = Bytes::new(wasm_bytes.length())
  for i, b in wasm_bytes {
    wasm[i] = b.to_byte()
  }
  let assets : Map[String, Bytes] = Map::new()
  assets.set("core/add.wasm", wasm)
  match install_extension_with_assets(ext_id, manifest, files, assets, "") {
    Ok(_) => ()
    Err(e) => debug_assert(false, "install ES module SW failed: " + e)
  }

  let url = "https://vault.example.com/"
  fcache.cache.set(url, ("<!doctype html><html><body>ok</body></html>".to_bytes(), url))
  debug_assert(load(url, 800.0, 600.0), "load page")
  tick(32)

  // Verify ES module TLA, import.meta.url, WebCrypto AES-GCM, WASM add(19, 23)==42, i18n, commands, offscreen
  let _ = eval_in_extension_world(ext_id, "chrome.runtime.sendMessage('boot').then((r) => { window.__boot = JSON.stringify(r); }); 1")
  ext_t_wait("ES module SW bootInfo", fn() { eval_in_extension_world(ext_id, "String(window.__boot || '')").contains("vault-secret") })
  let boot = eval_in_extension_world(ext_id, "String(window.__boot)")
  debug_assert(boot.contains("\"SECRET\":42"), "ES module static import: " + boot)
  debug_assert(boot.contains("chrome-extension://" + ext_id + "/sw/util.mjs"), "import.meta.url: " + boot)
  debug_assert(boot.contains("\"dec\":\"vault-secret\""), "WebCrypto AES-GCM round-trip: " + boot)
  debug_assert(boot.contains("\"wasmSum\":42"), "WASM fetch & instantiate: " + boot)
  debug_assert(boot.contains("\"cmd\":\"fill\""), "commands.getAll: " + boot)
  debug_assert(boot.contains("\"hasOff0\":false") && boot.contains("\"hasOff1\":true"), "offscreen lifecycle: " + boot)
  debug_assert(boot.contains("\"i18nHi\":\"Hello World\""), "i18n.getMessage: " + boot)
  debug_assert(boot.contains("\"permOk\":true") && boot.contains("\"hasBrowser\":true"), "permissions & browser alias: " + boot)

  // Verify long-lived Port content script <-> background SW round-trip
  ext_t_wait("Port echo", fn() { eval_in_extension_world(ext_id, "String(window.__portGot || '')") == "ping:vault-chan" })
  clear_extensions()
}

test "MV3 M1.3: Chrome Native Messaging manifest discovery, allowed_origins & real framed stdio Port + P0-1/P0-2 security" {
  configure_extensions_storage("")
  clear_extensions()
  let nm_dir = "/tmp/farview-nm-e2e-test"
  posix_mkdir_p(nm_dir)
  let ext_ok_id = "dddddddddddddddddddddddddddddddd"
  let ext_bad_id = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
  let host_sh = nm_dir + "/echo_host.sh"
  let is_win = posix_exists("C:/Windows")
  if !is_win {
    let sh_src = "#!/bin/sh\nif [ \"$1\" != \"chrome-extension://" + ext_ok_id + "/\" ]; then exit 2; fi\nexec /bin/cat\n"
    let _ = posix_write_atomic(host_sh, utf8_encode(sh_src))
    let _ = ew_run_cmd("chmod +x " + host_sh)
  }
  let nm_manifest = "{\"name\":\"com.farview.cat\",\"description\":\"Cat\",\"path\":\"echo_host.sh\",\"type\":\"stdio\",\"allowed_origins\":[\"chrome-extension://" + ext_ok_id + "/\"]}"
  let _ = posix_write_atomic(nm_dir + "/com.farview.cat.json", utf8_encode(nm_manifest))
  set_native_messaging_dir(nm_dir)

  // 1. Discovery, relative path resolution against manifest dir, & allowed_origins enforcement
  match find_native_messaging_host("com.farview.cat", ext_ok_id) {
    Ok(p) => debug_assert(p == host_sh, "relative path resolved: " + p)
    Err(e) => debug_assert(false, "allowed origin rejected: " + e)
  }
  debug_assert(find_native_messaging_host("com.farview.cat", ext_bad_id) is Err(_), "disallowed origin rejected")
  debug_assert(find_native_messaging_host("../escape", ext_ok_id) is Err(_), "traversal app name rejected")

  // 2. Real SW connectNative + sendNativeMessage round-trip over 4-byte framed stdio + P0-1/P0-2 guards
  let manifest = "{" +
  "\"manifest_version\":3," +
  "\"name\":\"NativeExt\"," +
  "\"version\":\"1.0.0\"," +
  "\"permissions\":[\"storage\",\"nativeMessaging\"]," +
  "\"web_accessible_resources\":[{\"resources\":[\"panel.html\"],\"matches\":[\"https://*.victim.example/*\"]}]," +
  "\"background\":{\"service_worker\":\"sw.js\"}," +
  "\"content_scripts\":[{\"matches\":[\"https://*.victim.example/*\"],\"js\":[\"cs.js\"],\"run_at\":\"document_idle\"}]" +
  "}"
  let files : Map[String, String] = Map::new()
  files.set("panel.html", "<!doctype html><html><body><p>Panel</p></body></html>")
  files.set("cs.js", "window.__csOk = true;")
  files.set(
    "sw.js",
    "let nmPortEcho = '';\n" +
    "let nmOnceEcho = '';\n" +
    (if !is_win {
      "const p = chrome.runtime.connectNative('com.farview.cat');\n" +
      "p.onMessage.addListener((m) => { nmPortEcho = m.hello || ''; });\n" +
      "p.postMessage({ hello: 'from-1pass-port' });\n" +
      "chrome.runtime.sendNativeMessage('com.farview.cat', { ping: 'one-shot' }).then((r) => { nmOnceEcho = (r && r.ping) || ''; });\n"
    } else {
      ""
    }) +
    "chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {\n" +
    "  if (msg === 'nm') { sendResponse({ nmPortEcho, nmOnceEcho }); return; }\n" +
    "  if (msg === 'write-secret') { chrome.storage.local.set({ secret: 'top-secret' }).then(() => sendResponse({ ok: true })); return true; }\n" +
    "});\n",
  )
  debug_assert(install_extension(ext_ok_id, manifest, files) is Ok(_), "install native ext")

  let url = "https://app.victim.example/page"
  let html = (
    "<!doctype html><html><body>" +
    "<iframe id='extf' src='chrome-extension://" + ext_ok_id + "/panel.html'></iframe>" +
    "<script>window.__leaked = '';</script>" +
    "</body></html>"
  ).to_bytes()
  fcache.cache.set(url, (html, url))
  debug_assert(load(url, 800.0, 600.0), "load victim page")
  tick(32)

  // Verify real Native Messaging round-trip (both connectNative Port and sendNativeMessage, checking argv[1] origin!)
  if !is_win {
    ext_t_wait("native messaging round-trip", fn() {
      let _ = eval_in_extension_world(ext_ok_id, "chrome.runtime.sendMessage('nm').then((r) => { window.__nm = JSON.stringify(r); }); 1")
      let s = eval_in_extension_world(ext_ok_id, "String(window.__nm || '')")
      s.contains("from-1pass-port") && s.contains("one-shot")
    }, seen=fn() { eval_in_extension_world(ext_ok_id, "String(window.__nm || '')") })
  }

  // P0-1: Main world cannot call op 135 storage read even if it guesses/forges an extension ID
  let _ = eval_in_extension_world(ext_ok_id, "chrome.storage.local.set({ vaultKey: 'saved-123' }); 1")
  tick(16)
  let steal = eval("typeof __fv === 'function' ? __fv(135, 1, 0, '" + ext_ok_id + "\\u0001any-token', '') : ''")
  debug_assert(steal == "", "P0-1: main world cannot invoke op 135: " + steal)

  // P0-2: Removing WAR extension iframe cleans up active_ext_pages so storage.onChanged never touches dead ctx
  let _ = eval("document.getElementById('extf').remove()")
  tick(32)
  let _ = eval_in_extension_world(ext_ok_id, "chrome.runtime.sendMessage('write-secret'); 1")
  tick(32)
  debug_assert(active_ext_pages.length() == 0, "P0-2: destroyed ext iframe cleaned from active_ext_pages")

  set_native_messaging_dir("")
  clear_extensions()
}

test "MV3 M1.5 (R4 lifecycle): microtask Promise content replies, out-of-band envelope literal JSON, SW diagnostic timer survival, chained nativeMessaging" {
  configure_extensions_storage("")
  clear_extensions()
  let ext_id = "abababababababababababababababab"
  let is_win = posix_exists("C:/Windows")
  let nm_dir = "/tmp/farview-nm-r4-test"
  if !is_win {
    posix_mkdir_p(nm_dir)
    let host_sh = nm_dir + "/echo_host.sh"
    let sh_src = "#!/bin/sh\nif [ \"$1\" != \"chrome-extension://" + ext_id + "/\" ]; then exit 2; fi\nexec /bin/cat\n"
    let _ = posix_write_atomic(host_sh, utf8_encode(sh_src))
    let _ = ew_run_cmd("chmod +x " + host_sh)
    let nm_manifest = "{\"name\":\"com.farview.r4cat\",\"description\":\"Cat\",\"path\":\"echo_host.sh\",\"type\":\"stdio\",\"allowed_origins\":[\"chrome-extension://" + ext_id + "/\"]}"
    let _ = posix_write_atomic(nm_dir + "/com.farview.r4cat.json", utf8_encode(nm_manifest))
    set_native_messaging_dir(nm_dir)
  }

  let manifest = "{" +
  "\"manifest_version\":3," +
  "\"name\":\"R4Lifecycle\"," +
  "\"version\":\"1.0.0\"," +
  "\"permissions\":[\"tabs\",\"storage\",\"nativeMessaging\"]," +
  "\"host_permissions\":[\"https://*.r4.test/*\"]," +
  "\"background\":{\"service_worker\":\"sw.js\"}," +
  "\"content_scripts\":[{\"matches\":[\"https://*.r4.test/*\"],\"js\":[\"cs.js\"],\"run_at\":\"document_idle\"}]" +
  "}"
  let files : Map[String, String] = Map::new()
  files.set(
    "cs.js",
    "window.__innerGot = '';\n" +
    "chrome.storage.onChanged.addListener((changes) => {\n" +
    "  if (changes && changes.triggerNested) {\n" +
    "    chrome.runtime.sendMessage('inner-ping').then((r) => { window.__innerGot = JSON.stringify(r); });\n" +
    "  }\n" +
    "});\n" +
    "chrome.runtime.onMessage.addListener((msg) => {\n" +
    "  if (msg === 'micro-ok') return Promise.resolve({ ok: 'microtask-resolved' });\n" +
    "  if (msg === 'micro-err') return Promise.reject(new Error('content-micro-reject'));\n" +
    "});\n",
  )
  files.set(
    "sw.js",
    "// Schedule a timer that throws a diagnostic exception; worker MUST stay alive!\n" +
    "setTimeout(() => { throw new Error('non-fatal-timer-diag'); }, 2);\n" +
    "chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {\n" +
    "  if (msg === 'literal-ctrl') {\n" +
    "    sendResponse({ __fvAsyncId: 777, __fvError: 'literal-not-error' });\n" +
    "    return;\n" +
    "  }\n" +
    "  if (msg === 'outer-storage') {\n" +
    "    chrome.storage.local.set({ triggerNested: 1 }).then(() => sendResponse({ outer: 'ok' }));\n" +
    "    return true;\n" +
    "  }\n" +
    "  if (msg === 'inner-ping') {\n" +
    "    sendResponse({ inner: 'ok' });\n" +
    "    return;\n" +
    "  }\n" +
    "  if (msg === 'slow-first') {\n" +
    "    setTimeout(() => sendResponse({ order: 1 }), 55);\n" +
    "    return true;\n" +
    "  }\n" +
    "  if (msg === 'slow-second') {\n" +
    "    setTimeout(() => sendResponse({ order: 2 }), 25);\n" +
    "    return true;\n" +
    "  }\n" +
    "  if (msg === 'ask-micro-ok') {\n" +
    "    chrome.tabs.sendMessage(1, 'micro-ok').then((r) => sendResponse(r), (e) => sendResponse({ err: String((e && e.message) || e) }));\n" +
    "    return true;\n" +
    "  }\n" +
    "  if (msg === 'ask-micro-err') {\n" +
    "    chrome.tabs.sendMessage(1, 'micro-err').then((r) => sendResponse({ unexpected: r }), (e) => sendResponse({ err: String((e && e.message) || e) }));\n" +
    "    return true;\n" +
    "  }\n" +
    "  if (msg === 'alive-after-diag') {\n" +
    "    sendResponse({ alive: true });\n" +
    "    return;\n" +
    "  }\n" +
    "});\n",
  )
  debug_assert(install_extension(ext_id, manifest, files) is Ok(_), "install R4 ext")

  let url = "https://app.r4.test/index"
  fcache.cache.set(url, ("<!doctype html><html><body>ok</body></html>".to_bytes(), url))
  debug_assert(load(url, 800.0, 600.0), "load R4 page")
  tick(48)

  // 1. Out-of-band envelope preserves literal { __fvAsyncId, __fvError } objects intact
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('literal-ctrl').then((r) => { window.__lit = JSON.stringify(r); }, (e) => { window.__lit = 'ERR:' + e.message; }); 1",
  )
  ext_t_wait("literal ctrl JSON", fn() { eval_in_extension_world(ext_id, "String(window.__lit || '')") != "" })
  let lit = eval_in_extension_world(ext_id, "String(window.__lit)")
  debug_assert(lit.contains("\"__fvAsyncId\":777") && lit.contains("\"__fvError\":\"literal-not-error\""), "literal JSON preserved: " + lit)

  // 2. Immediate Promise.resolve & Promise.reject in content listener via tabs.sendMessage
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('ask-micro-ok').then((r) => { window.__mok = JSON.stringify(r); });" +
    "chrome.runtime.sendMessage('ask-micro-err').then((r) => { window.__merr = JSON.stringify(r); }); 1",
  )
  ext_t_wait("content microtask resolve", fn() { eval_in_extension_world(ext_id, "String(window.__mok || '')").contains("microtask-resolved") })
  ext_t_wait("content microtask reject", fn() { eval_in_extension_world(ext_id, "String(window.__merr || '')").contains("content-micro-reject") })

  // 3. Worker survived non-fatal timer exception (kind == 2 diagnostic did NOT kill/abandon worker)
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('alive-after-diag').then((r) => { window.__alive = JSON.stringify(r); }); 1",
  )
  ext_t_wait("worker alive after timer diag", fn() { eval_in_extension_world(ext_id, "String(window.__alive || '')").contains("\"alive\":true") })
  debug_assert(extension_bg_worker_id(ext_id) > 0, "bg_worker_id still active after diagnostic")

  // 4. Chained sendNativeMessage enqueued inside Promise reaction of first native reply
  if !is_win {
    let _ = eval_in_extension_world(
      ext_id,
      "chrome.runtime.sendNativeMessage('com.farview.r4cat', { step: 1 }).then((r1) => {\n" +
      "  return chrome.runtime.sendNativeMessage('com.farview.r4cat', { step: r1.step + 1 });\n" +
      "}).then((r2) => { window.__chain = 'step:' + r2.step; }, (e) => { window.__chain = 'ERR:' + e.message; }); 1",
    )
    ext_t_wait("chained sendNativeMessage", fn() { eval_in_extension_world(ext_id, "String(window.__chain || '')") == "step:2" }, seen=fn() { eval_in_extension_world(ext_id, "String(window.__chain || '')") })
  }

  // 5. Nested sendMessage triggered from storage.onChanged while outer sendMessage writes storage
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('outer-storage').then((r) => { window.__outerGot = JSON.stringify(r); }); 1",
  )
  ext_t_wait("outer+nested sendMessage both resolve", fn() {
    eval_in_extension_world(ext_id, "String(window.__outerGot || '')").contains("\"outer\":\"ok\"") &&
    eval_in_extension_world(ext_id, "String(window.__innerGot || '')").contains("\"inner\":\"ok\"")
  }, seen=fn() { eval_in_extension_world(ext_id, "String(window.__outerGot || '') + '|' + String(window.__innerGot || '')") })

  // 5b. Two back-to-back async sends in ONE JS task: first exceeds 40ms fast wait -> registers
  // pendingAsync synchronously before second send's fast wait drains first reply.
  let _ = eval_in_extension_world(
    ext_id,
    "Promise.all([chrome.runtime.sendMessage('slow-first'), chrome.runtime.sendMessage('slow-second')]).then((rs) => { window.__b2b = rs.map((x) => x.order).join(','); }); 1",
  )
  ext_t_wait("back-to-back async sends in one JS task", fn() { eval_in_extension_world(ext_id, "String(window.__b2b || '')") == "1,2" }, seen=fn() { eval_in_extension_world(ext_id, "String(window.__b2b || '')") })

  // 6. Worker that opens a native Port then fails startup closes the native child via terminate_bg_worker
  if !is_win {
    let bad_nm_id = "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
    let sh2 = nm_dir + "/echo_bad.sh"
    let _ = posix_write_atomic(sh2, utf8_encode("#!/bin/sh\nexec /bin/cat\n"))
    let _ = ew_run_cmd("chmod +x " + sh2)
    let _ = posix_write_atomic(
      nm_dir + "/com.farview.r4bad.json",
      utf8_encode("{\"name\":\"com.farview.r4bad\",\"description\":\"Bad\",\"path\":\"echo_bad.sh\",\"type\":\"stdio\",\"allowed_origins\":[\"chrome-extension://" + bad_nm_id + "/\"]}"),
    )
    let bad_mf = "{\"manifest_version\":3,\"name\":\"BadNm\",\"version\":\"1.0.0\",\"permissions\":[\"nativeMessaging\"],\"background\":{\"service_worker\":\"sw.mjs\",\"type\":\"module\"}}"
    let bad_fs : Map[String, String] = Map::new()
    bad_fs.set("sw.mjs", "chrome.runtime.connectNative('com.farview.r4bad'); await new Promise((r) => setTimeout(r, 15)); throw new Error('fail-after-connect');")
    debug_assert(install_extension(bad_nm_id, bad_mf, bad_fs) is Ok(_), "install bad nm ext")
    debug_assert(extension_bg_worker_id(bad_nm_id) == 0, "failed SW startup terminated")
    debug_assert(page_aux::nm_active_count() == 0, "worker-owned native port closed on startup failure: " + page_aux::nm_active_count().to_string())
    let _ = uninstall_extension(bad_nm_id)
  }

  set_native_messaging_dir("")
  clear_extensions()
}

test "MV3 M3 real-world compatibility: extensible chrome API, SW globals, DNR requestDomains/extensionPath/rulesets, popup Referer/fetch, WebIDL MutationObserver" {
  configure_extensions_storage("")
  clear_extensions()
  st.errors.clear()

  let ext_id = "m3compat000000000000000000000001"
  let manifest =
  "{" +
  "\"manifest_version\":3," +
  "\"name\":\"M3Compat\"," +
  "\"version\":\"1.0.0\"," +
  "\"permissions\":[\"storage\",\"declarativeNetRequest\",\"webNavigation\",\"idle\",\"notifications\",\"fontSettings\"]," +
  "\"host_permissions\":[\"<all_urls>\"]," +
  "\"action\":{\"default_title\":\"M3Compat\",\"default_popup\":\"popup/index.html\"}," +
  "\"declarative_net_request\":{\"rule_resources\":[" +
  "  {\"id\":\"main\",\"enabled\":true,\"path\":\"/rulesets/main.json\"}," +
  "  {\"id\":\"extra\",\"enabled\":false,\"path\":\"/rulesets/extra.json\"}" +
  "]}," +
  "\"web_accessible_resources\":[{\"resources\":[\"war/noop.js\"],\"matches\":[\"<all_urls>\"]}]," +
  "\"background\":{\"service_worker\":\"/sw/bg.mjs\",\"type\":\"module\"}," +
  "\"content_scripts\":[{\"matches\":[\"https://*.example.com/*\"],\"js\":[\"cs.js\"],\"run_at\":\"document_idle\"}]" +
  "}"
  let files : Map[String, String] = Map::new()
  files.set(
    "rulesets/main.json",
    "[" +
    "  {\"id\":1,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"ads.tracker.test\"],\"domainType\":\"thirdParty\",\"excludedResourceTypes\":[\"main_frame\"]}}," +
    "  {\"id\":2,\"priority\":16,\"action\":{\"type\":\"redirect\",\"redirect\":{\"extensionPath\":\"/war/noop.js\"}},\"condition\":{\"urlFilter\":\"||ads.tracker.test/sdk.js\",\"resourceTypes\":[\"script\",\"xmlhttprequest\"]}}," +
    "  {\"id\":3,\"priority\":20,\"action\":{\"type\":\"block\"},\"condition\":{\"regexFilter\":\"^https://never-match-all\\\\.test/\"}}" +
    "]",
  )
  files.set(
    "rulesets/extra.json",
    "[{\"id\":10,\"priority\":15,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"extra.tracker.test\"]}}]",
  )
  files.set("war/noop.js", "window.__noopLoaded = true;")
  files.set("popup/data.json", "{\"hello\":\"m3\"}")
  files.set(
    "popup/index.html",
    "<!doctype html><html><head><title>M3 Popup</title></head><body><div id='out'>loading</div><script>" +
    "const desc = Object.getOwnPropertyDescriptor(MutationObserver.prototype, 'observe');" +
    "const moOk = !!(desc && desc.enumerable && typeof new MutationObserver(() => {}).observe === 'function');" +
    "fetch(chrome.runtime.getURL('popup/data.json')).then(async (r) => {" +
    "  const ct = r.headers.get('content-type') || '';" +
    "  const j = await r.json();" +
    "  document.getElementById('out').textContent = moOk + '|' + ct + '|' + j.hello;" +
    "}).catch((e) => { document.getElementById('out').textContent = 'ERR:' + e.message; });" +
    "</script></body></html>",
  )
  files.set(
    "sw/bg.mjs",
    "// 1. 1Password/uBOL pattern: attach Symbol & monkey-patch chrome namespaces\n" +
    "const sym = Symbol('com.1p.log');\n" +
    "chrome[sym] = 'ok-sym';\n" +
    "chrome.declarativeNetRequest.setAllowAllRules = () => 'patched';\n" +
    "// 2. Dark Reader / modern MV3 SW globals\n" +
    "const platOk = navigator.platform.toLowerCase().length > 0;\n" +
    "const locOk = location.origin === 'chrome-extension://" + ext_id + "' && self.origin === location.origin;\n" +
    "const lockRes = await navigator.locks.request('m3-lock', async (l) => l.name);\n" +
    "const f = new File(['abc'], 'a.txt', { type: 'text/plain' });\n" +
    "const fd = new FormData(); fd.append('k', f);\n" +
    "const bc1 = new BroadcastChannel('m3-ch'), bc2 = new BroadcastChannel('m3-ch');\n" +
    "let bcGot = ''; bc2.onmessage = (e) => { bcGot = e.data; }; bc1.postMessage('hi-bc');\n" +
    "await Promise.resolve();\n" +
    "const managed = await chrome.storage.managed.get({ policy: 'default' });\n" +
    "const idleState = await chrome.idle.queryState(60);\n" +
    "const fonts = await chrome.fontSettings.getFontList();\n" +
    "const rs0 = await chrome.declarativeNetRequest.getEnabledRulesets();\n" +
    "const avail0 = await chrome.declarativeNetRequest.getAvailableStaticRuleCount();\n" +
    "await chrome.storage.local.set({\n" +
    "  boot: [chrome[sym], chrome.declarativeNetRequest.setAllowAllRules(), platOk, locOk, lockRes, f.name, fd.get('k') instanceof File, bcGot, managed.policy, idleState, fonts.length > 0, rs0.join(','), avail0 > 0, typeof chrome.browserAction.setBadgeText, typeof self.clients.matchAll, typeof self.registration.update].join('|')\n" +
    "});\n" +
    "bc1.close(); bc2.close();\n" +
    "chrome.runtime.onMessage.addListener((msg, _sender, sendResponse) => {\n" +
    "  if (msg && msg.op === 'enableExtra') {\n" +
    "    chrome.declarativeNetRequest.updateEnabledRulesets({ enableRulesetIds: ['extra'] }).then(async () => {\n" +
    "      const rs1 = await chrome.declarativeNetRequest.getEnabledRulesets();\n" +
    "      const frames = await chrome.webNavigation.getAllFrames({ tabId: 1 });\n" +
    "      sendResponse({ rs: rs1, frameCount: frames.length });\n" +
    "    });\n" +
    "    return true;\n" +
    "  }\n" +
    "});\n",
  )
  files.set(
    "cs.js",
    "chrome.runtime.sendMessage({ op: 'enableExtra' }).then((r) => { window.__m3Cs = JSON.stringify(r); });",
  )

  debug_assert(install_extension(ext_id, manifest, files) is Ok(_), "install M3Compat")
  debug_assert(extension_bg_worker_ready(ext_id), "M3Compat SW booted cleanly")
  debug_assert(extension_diagnostics().length() == 0, "zero M3Compat SW diagnostics")

  // Verify leading-slash DNR static ruleset loaded: block + extensionPath redirect + regexFilter fail-closed
  debug_assert(extension_static_dnr_count(ext_id) == 3, "3 static DNR rules loaded from /rulesets/main.json")
  match extension_dnr_check("https://sub.ads.tracker.test/pixel.js", "https://app.example.com/", "script") {
    extensions::DnrDecision::Blocked(1) => ()
    _ => debug_assert(false, "thirdParty requestDomains must block rule 1")
  }
  match extension_dnr_check("https://ads.tracker.test/pixel.js", "https://ads.tracker.test/", "script") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "firstParty request must not trigger thirdParty rule 1")
  }
  match extension_dnr_check("https://ads.tracker.test/page", "https://app.example.com/", "main_frame") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "excludedResourceTypes main_frame must not be blocked")
  }
  match extension_dnr_check("https://ads.tracker.test/sdk.js", "https://app.example.com/", "script") {
    extensions::DnrDecision::Redirected(2, target) =>
    debug_assert(target == "chrome-extension://" + ext_id + "/war/noop.js", "extensionPath redirect target: " + target)
    _ => debug_assert(false, "rule 2 must redirect via extensionPath")
  }
  match extension_dnr_check("https://safe.example.com/app.js", "https://app.example.com/", "script") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "regexFilter rule 3 must fail closed and not block unrelated URLs")
  }

  // Load web page, verify content script calls updateEnabledRulesets('extra') & webNavigation.getAllFrames
  let page_url = "https://app.example.com/home"
  fcache.cache.set(page_url, ("<!doctype html><html><body><p>home</p></body></html>".to_bytes(), page_url))
  debug_assert(load(page_url, 800.0, 600.0), "load web page")
  ext_t_wait(
    "M3Compat content script + dynamic ruleset enable",
    fn() { eval_in_extension_world(ext_id, "String(window.__m3Cs || '')").contains("extra") },
    seen=fn() { eval_in_extension_world(ext_id, "String(window.__m3Cs || '')") },
  )
  let cs_res = eval_in_extension_world(ext_id, "String(window.__m3Cs || '')")
  debug_assert(cs_res.contains("\"frameCount\":1"), "webNavigation.getAllFrames returned 1 frame: " + cs_res)
  match extension_dnr_check("https://extra.tracker.test/t.js", page_url, "script") {
    extensions::DnrDecision::Blocked(10) => ()
    _ => debug_assert(false, "enabling ruleset 'extra' must activate rule 10")
  }
  let boot_dump = extension_storage_dump(ext_id, area="local")
  debug_assert(
    boot_dump.contains("ok-sym|patched|true|true|m3-lock|a.txt|true|hi-bc|default|active|true|main|true|function|function|function"),
    "M3Compat SW boot checks: " + boot_dump,
  )

  // Browser-initiated popup navigation from web tab must NOT be blocked by previous page's Referer,
  // and fetch('chrome-extension://...') + WebIDL MutationObserver must both work cleanly.
  let popup_url = extension_action_click(ext_id)
  debug_assert(popup_url == "chrome-extension://" + ext_id + "/popup/index.html", "popup url")
  debug_assert(load(popup_url, 400.0, 600.0), "browser-initiated popup load from web tab")
  ext_t_wait(
    "popup fetch chrome-extension:// JSON + WebIDL MutationObserver",
    fn() {
      let s = eval("document.getElementById('out') ? document.getElementById('out').textContent : ''")
      s.starts_with("true|application/json") && s.ends_with("|m3")
    },
    seen=fn() { eval("document.getElementById('out') ? document.getElementById('out').textContent : ''") },
  )

  // Web-initiated navigation to non-WAR popup.html MUST be blocked across ALL bypass vectors
  // (explicit web_initiated, Referrer-Policy: no-referrer, data: opaque origin, and must not commit st.url):
  // (a) explicit web_initiated=true
  debug_assert(load(page_url, 800.0, 600.0), "reload web page")
  debug_assert(!load(popup_url, 400.0, 600.0, web_initiated=true), "web-initiated nav to non-WAR popup must return false")
  debug_assert(url() == page_url, "blocked web nav must not mutate st.url: " + url())

  // (b) Referrer-Policy: no-referrer page doing location = popup_url via real take_navigation() -> load()
  let noref_url = "https://noref.example.com/attack"
  fcache.cache.set(
    noref_url,
    (
      (
        "<!doctype html><html><head><meta name='referrer' content='no-referrer'></head><body><script>location.href=" +
        js_string(popup_url) + ";</script></body></html>"
      ).to_bytes(),
      noref_url,
    ),
  )
  debug_assert(load(noref_url, 800.0, 600.0), "load no-referrer attack page")
  sec_state.referrer_policy = security::ReferrerPolicy::NoReferrer
  match navigation() {
    Some(target) => {
      debug_assert(target == popup_url, "attack page requested popup_url")
      debug_assert(!load(target, 400.0, 600.0), "no-referrer web nav to non-WAR popup must be blocked")
      debug_assert(url() == noref_url, "no-referrer blocked nav must preserve st.url")
    }
    None => debug_assert(false, "expected pending navigation from no-referrer page")
  }
  sec_state.referrer_policy = security::ReferrerPolicy::StrictOriginWhenCrossOrigin

  // (c) data: URL opaque origin page doing location = popup_url via take_navigation() -> load()
  let data_attack = "data:text/html;charset=utf-8,<!doctype html><html><body><script>location.href=" + js_string(popup_url) + ";</script></body></html>"
  debug_assert(load(data_attack, 800.0, 600.0), "load data: attack page")
  match navigation() {
    Some(target) => {
      debug_assert(target == popup_url, "data: page requested popup_url")
      debug_assert(!load(target, 400.0, 600.0), "data: web nav to non-WAR popup must be blocked")
      debug_assert(url() == data_attack, "data: blocked nav must preserve st.url")
    }
    None => debug_assert(false, "expected pending navigation from data: page")
  }

  // (d) Subresource <script src> DNR enforcement (P1-2):
  //     - https://ads.tracker.test/sdk.js -> redirected to chrome-extension://.../war/noop.js (__noopLoaded=true)
  //     - https://ads.tracker.test/pixel.js -> blocked (cached malicious marker must NOT execute)
  let dnr_page_url = "https://app.example.com/dnr-subresource"
  fcache.cache.set("https://ads.tracker.test/sdk.js", ("window.__realSdk = true;".to_bytes(), "https://ads.tracker.test/sdk.js"))
  fcache.cache.set("https://ads.tracker.test/pixel.js", ("window.__pixelRan = true;".to_bytes(), "https://ads.tracker.test/pixel.js"))
  fcache.cache.set(
    dnr_page_url,
    (
      "<!doctype html><html><body><script src='https://ads.tracker.test/sdk.js'></script><script src='https://ads.tracker.test/pixel.js'></script></body></html>".to_bytes(),
      dnr_page_url,
    ),
  )
  debug_assert(load(dnr_page_url, 800.0, 600.0), "load subresource DNR test page")
  debug_assert(eval("String(window.__noopLoaded)") == "true", "DNR extensionPath redirect must execute war/noop.js")
  debug_assert(eval("String(window.__realSdk)") == "undefined", "redirected real sdk.js must not execute")
  debug_assert(eval("String(window.__pixelRan)") == "undefined", "DNR blocked pixel.js must not execute")

  // (e) PSL-based dnr_same_site (.co.uk + IP literals) & `^` separator anchoring (P1-5 + P2)
  let psl_ext = "m3psl000000000000000000000000002"
  let psl_mf = "{\"manifest_version\":3,\"name\":\"PslDnr\",\"version\":\"1.0.0\",\"permissions\":[\"declarativeNetRequest\"],\"declarative_net_request\":{\"rule_resources\":[{\"id\":\"r\",\"enabled\":true,\"path\":\"r.json\"}]}}"
  let psl_files : Map[String, String] = Map::new()
  psl_files.set(
    "r.json",
    "[" +
    "  {\"id\":1,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"tracker.co.uk\",\"10.0.0.1\"],\"domainType\":\"thirdParty\"}}," +
    "  {\"id\":2,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"urlFilter\":\"||caret.test^ads/\"}}" +
    "]",
  )
  debug_assert(install_extension(psl_ext, psl_mf, psl_files) is Ok(_), "install PslDnr")
  match extension_dnr_check("https://tracker.co.uk/t.js", "https://news.co.uk/", "script") {
    extensions::DnrDecision::Blocked(1) => ()
    _ => debug_assert(false, "tracker.co.uk vs news.co.uk must be thirdParty via PSL")
  }
  match extension_dnr_check("https://cdn.tracker.co.uk/t.js", "https://www.tracker.co.uk/", "script") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "cdn.tracker.co.uk vs www.tracker.co.uk must be firstParty via PSL")
  }
  match extension_dnr_check("http://10.0.0.1/t.js", "http://192.168.0.1/", "script") {
    extensions::DnrDecision::Blocked(1) => ()
    _ => debug_assert(false, "10.0.0.1 vs 192.168.0.1 must be thirdParty (IP literals)")
  }
  match extension_dnr_check("https://caret.test/ads/banner.js", "https://app.example.com/", "script") {
    extensions::DnrDecision::Blocked(2) => ()
    _ => debug_assert(false, "||caret.test^ads/ must match /ads/banner.js")
  }
  match extension_dnr_check("https://caret.test/foo/ads/banner.js", "https://app.example.com/", "script") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "||caret.test^ads/ must NOT match /foo/ads/banner.js")
  }

  // (f) Dedicated Worker (non-SW) must NOT expose ServiceWorkerGlobalScope / clients / registration / skipWaiting,
  //     AND navigator.locks must enforce exclusive mutual exclusion, shared concurrency, ifAvailable, and missing-cb TypeError (P1-4 + P1-6)
  let dw_id = js::worker_spawn(
    "const swLeak = ('clients' in self) || ('registration' in self) || ('skipWaiting' in self) || (typeof ServiceWorkerGlobalScope !== 'undefined');\n" +
    "(async () => {\n" +
    "  let active = 0, maxExcl = 0, availHit = 'unset', missingThrew = false;\n" +
    "  try { await navigator.locks.request('bad'); } catch (e) { missingThrew = e instanceof TypeError; }\n" +
    "  const p1 = navigator.locks.request('vault', async () => {\n" +
    "    active++; if (active > maxExcl) maxExcl = active;\n" +
    "    await navigator.locks.request('vault', { ifAvailable: true }, (l) => { availHit = l === null ? 'null' : 'got'; });\n" +
    "    await new Promise((r) => setTimeout(r, 15));\n" +
    "    active--;\n" +
    "  });\n" +
    "  const p2 = navigator.locks.request('vault', async () => {\n" +
    "    active++; if (active > maxExcl) maxExcl = active;\n" +
    "    await new Promise((r) => setTimeout(r, 5));\n" +
    "    active--;\n" +
    "  });\n" +
    "  await Promise.all([p1, p2]);\n" +
    "  let shActive = 0, maxSh = 0;\n" +
    "  await Promise.all([\n" +
    "    navigator.locks.request('ro', { mode: 'shared' }, async () => { shActive++; if (shActive > maxSh) maxSh = shActive; await new Promise((r) => setTimeout(r, 10)); shActive--; }),\n" +
    "    navigator.locks.request('ro', { mode: 'shared' }, async () => { shActive++; if (shActive > maxSh) maxSh = shActive; await new Promise((r) => setTimeout(r, 10)); shActive--; }),\n" +
    "  ]);\n" +
    "  postMessage([swLeak, location.origin, maxExcl, availHit, missingThrew, maxSh].join('|'));\n" +
    "})();\n",
    "blob:https://app.example.com/worker-1",
  )
  debug_assert(dw_id > 0, "spawn dedicated worker")
  let mut dw_out = ""
  let mut dw_spins = 0
  while dw_out == "" && dw_spins < 200 {
    let (k, msg) = js::worker_poll(dw_id)
    if k == 1 && msg != "" {
      dw_out = msg
      break
    }
    js::worker_sleep_ms(5)
    dw_spins += 1
  }
  js::worker_terminate(dw_id)
  debug_assert(dw_out == "false|https://app.example.com|1|null|true|2", "dedicated worker SW isolation + blob origin + navigator.locks mutex/shared: " + dw_out)

  // (g) R3 regressions: prefetch DNR (zero network/inflight), page fetch() op 119 + chrome-extension:// redirect,
  //     sendBeacon ("ping"), WebSocket op 120 ("websocket"), full ICANN PSL (*.sch.uk), and global DNR domain index
  clear_extensions()
  let r3_ext = "m3dnrr30000000000000000000000003"
  let r3_mf = "{" +
  "\"manifest_version\":3,\"name\":\"DnrR3\",\"version\":\"1.0.0\"," +
  "\"permissions\":[\"declarativeNetRequest\"]," +
  "\"host_permissions\":[\"<all_urls>\"]," +
  "\"web_accessible_resources\":[{\"resources\":[\"war/*\"],\"matches\":[\"<all_urls>\"]}]," +
  "\"declarative_net_request\":{\"rule_resources\":[{\"id\":\"r\",\"enabled\":true,\"path\":\"r.json\"}]}" +
  "}"
  let r3_files : Map[String, String] = Map::new()
  r3_files.set("war/noop.js", "window.__noopFromDnr = 'ok';")
  r3_files.set(
    "r.json",
    "[" +
    "  {\"id\":10,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"ads.r3.invalid\"],\"resourceTypes\":[\"script\",\"stylesheet\",\"image\",\"sub_frame\",\"xmlhttprequest\"]}}," +
    "  {\"id\":11,\"priority\":20,\"action\":{\"type\":\"redirect\",\"redirect\":{\"extensionPath\":\"/war/noop.js\"}},\"condition\":{\"urlFilter\":\"||ads.r3.invalid/sdk.js\",\"resourceTypes\":[\"script\",\"xmlhttprequest\"]}}," +
    "  {\"id\":12,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"beacon.r3.invalid\"],\"resourceTypes\":[\"ping\"]}}," +
    "  {\"id\":13,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"ws.r3.invalid\"],\"resourceTypes\":[\"websocket\"]}}," +
    "  {\"id\":14,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"requestDomains\":[\"tracker.a.sch.uk\"],\"domainType\":\"thirdParty\"}}," +
    "  {\"id\":15,\"priority\":10,\"action\":{\"type\":\"block\"},\"condition\":{\"urlFilter\":\"/vast.php?idzone=\"}}" +
    "]",
  )
  debug_assert(install_extension(r3_ext, r3_mf, r3_files) is Ok(_), "install DnrR3")

  // Verify 3-tier global DNR index: 4 domain buckets + 1 token bucket ('vast'/'idzone'), 0 global fallback rules
  let (idx_doms, idx_init, idx_tok, idx_global) = extension_dnr_index_stats()
  debug_assert(idx_doms == 4 && idx_init == 0 && idx_tok == 1 && idx_global == 0, "global DNR index buckets: doms=" + idx_doms.to_string() + " init=" + idx_init.to_string() + " tok=" + idx_tok.to_string() + " global=" + idx_global.to_string())
  match extension_dnr_check("https://cdn.publisher.test/vast.php?idzone=99", "https://app.example.com/", "xmlhttprequest") {
    extensions::DnrDecision::Blocked(15) => ()
    _ => debug_assert(false, "token-indexed /vast.php?idzone= rule must match")
  }

  // Full ICANN PSL check (*.sch.uk wildcard suffix is NOT in security::registrable_domain's 58-entry table)
  match extension_dnr_check("https://tracker.a.sch.uk/t.js", "https://news.b.sch.uk/", "script") {
    extensions::DnrDecision::Blocked(14) => ()
    _ => debug_assert(false, "tracker.a.sch.uk vs news.b.sch.uk must be thirdParty via full ICANN PSL")
  }
  match extension_dnr_check("https://cdn.tracker.a.sch.uk/t.js", "https://www.tracker.a.sch.uk/", "script") {
    extensions::DnrDecision::Allowed => ()
    _ => debug_assert(false, "cdn.tracker.a.sch.uk vs www.tracker.a.sch.uk must be firstParty via full ICANN PSL")
  }

  // Load page with blocked script, stylesheet, iframe, and test prefetch never starts inflight network requests
  let r3_page = "https://app.example.com/r3-dnr"
  let r3_html = (
    "<!doctype html><html><head>" +
    "<link rel='stylesheet' href='https://ads.r3.invalid/ad.css'>" +
    "<script src='https://ads.r3.invalid/pixel.js'></script>" +
    "<script src='https://ads.r3.invalid/sdk.js'></script>" +
    "</head><body>" +
    "<iframe id='adfr' src='https://ads.r3.invalid/frame.html'></iframe>" +
    "<script>" +
    "window.__fBlocked = 'pending'; window.__fRedir = 'pending'; window.__wsState = 'pending'; window.__imgBlk = 'pending';" +
    "fetch('https://ads.r3.invalid/api').then(() => { window.__fBlocked = 'UNEXPECTED_OK'; }, (e) => { window.__fBlocked = 'REJECTED:' + e.name; });" +
    "fetch('https://ads.r3.invalid/sdk.js').then(async (r) => { window.__fRedir = r.status + ':' + (r.url.startsWith('chrome-extension://') ? 'ext' : r.url) + ':' + (await r.text()); }, (e) => { window.__fRedir = 'ERR:' + e; });" +
    "navigator.sendBeacon('https://beacon.r3.invalid/collect', 'k=v');" +
    "const ws = new WebSocket('wss://ws.r3.invalid/live');" +
    "ws.addEventListener('error', () => { window.__wsErr = '1'; });" +
    "ws.addEventListener('close', (ev) => { window.__wsState = ws.readyState + ':' + ev.code + ':' + ev.wasClean; });" +
    "const px = new Image();" +
    "px.onload = () => { window.__imgBlk = 'UNEXPECTED_LOAD'; };" +
    "px.onerror = () => { window.__imgBlk = 'ERR'; };" +
    "px.src = 'https://ads.r3.invalid/pixel.gif';" +
    "</script></body></html>"
  ).to_bytes()
  fcache.cache.set(r3_page, (r3_html, r3_page))
  debug_assert(load(r3_page, 800.0, 600.0), "load r3 DNR page")

  // Blocked URLs & chrome-extension:// redirected URL must NEVER enter inflight during load or explicit prefetch calls
  fc_fetch_ahead(["https://ads.r3.invalid/pixel.js", "https://ads.r3.invalid/sdk.js"], resource_type="script")
  fc_fetch_ahead_with([("https://ads.r3.invalid/frame.html", "")], resource_type="sub_frame")
  fc_prefetch(["https://ads.r3.invalid/ad.css"], resource_type="stylesheet")
  fc_prefetch_pictures(["https://ads.r3.invalid/banner.png"])
  debug_assert(!fc_waiting_for("https://ads.r3.invalid/pixel.js"), "blocked script must never enter inflight")
  debug_assert(!fc_waiting_for("https://ads.r3.invalid/sdk.js"), "extensionPath-redirected script must never enter HTTP inflight")
  debug_assert(!fc_waiting_for("https://ads.r3.invalid/frame.html"), "blocked iframe must never enter inflight")
  debug_assert(!fc_waiting_for("https://ads.r3.invalid/ad.css"), "blocked stylesheet must never enter inflight")
  debug_assert(!fc_waiting_for("https://ads.r3.invalid/banner.png"), "blocked image must never enter inflight")
  debug_assert(fc_ahead_count() == 0, "zero inflight ahead fetches for DNR-blocked/ext-redirected URLs: " + fc_ahead_count().to_string())
  debug_assert(live_ws.len() == 0, "DNR-blocked WebSocket must never open a live socket")
  debug_assert(stream_bg.len() == 0, "DNR-blocked sendBeacon must never start a background stream")
  debug_assert(img_pending_fetches.len() == 0, "DNR-blocked detached new Image().src must never enter img_pending_fetches")

  // Deliver synthetic streams + timers and verify fetch(), fetch()->extensionPath redirect, WebSocket, and detached Image results
  tick(48)
  tick(48)
  debug_assert(eval("String(window.__noopFromDnr || '')") == "ok", "redirected <script> executed war/noop.js")
  let f_blk = eval("String(window.__fBlocked)")
  let f_red = eval("String(window.__fRedir)")
  let ws_st = eval("String(window.__wsState)")
  let ws_er = eval("String(window.__wsErr || '')")
  let img_blk = eval("String(window.__imgBlk)")
  debug_assert(f_blk == "REJECTED:TypeError", "op 119 fetch() blocked by DNR must reject TypeError: " + f_blk)
  debug_assert(f_red == "200:ext:window.__noopFromDnr = 'ok';", "op 119 fetch() redirected to extensionPath: " + f_red)
  debug_assert(ws_er == "1" && ws_st == "3:1006:false", "op 120 WebSocket blocked by DNR must error+close(1006): err=" + ws_er + " state=" + ws_st)
  debug_assert(img_blk == "ERR", "detached new Image().src blocked by DNR must fire onerror: " + img_blk)

  clear_extensions()
}

test "MV3 M3 real-world extension probe (env-gated FV_REAL_EXT_PROBE)" {
  let root = match env_var("FV_REAL_EXT_PROBE") {
    Some(d) if d != "" => d
    _ => return
  }
  configure_extensions_storage("")
  let exts = ["darkreader", "ubol", "1password", "bitwarden"]
  for name in exts {
    clear_extensions()
    st.errors.clear()
    let dir = root + "/" + name
    match install_unpacked_extension(dir) {
      Ok(eid) => {
        debug_assert(extension_bg_worker_id(eid) > 0, name + ": bg worker spawned")
        debug_assert(extension_bg_worker_ready(eid), name + ": bg worker ready")
        let login_url = "https://accounts.example.com/signin"
        let html = (
          "<!doctype html><html><head><title>Sign in</title><style>body{background:#fff;color:#111;}</style></head><body>" +
          "<form id='f' action='/login' method='post'>" +
          "<input id='email' name='username' type='email' autocomplete='username'>" +
          "<input id='pw' name='password' type='password' autocomplete='current-password'>" +
          "<button type='submit'>Sign in</button></form></body></html>"
        ).to_bytes()
        fcache.cache.set(login_url, (html, login_url))
        debug_assert(load(login_url, 1024.0, 768.0), name + ": load login page")
        let mut i = 0
        while i < 20 {
          tick(50)
          js::worker_sleep_ms(20)
          i += 1
        }
        debug_assert(extension_bg_worker_ready(eid), name + ": bg worker alive after page load")
        debug_assert(extension_diagnostics().length() == 0, name + ": zero SW/content diagnostics")
        if name == "ubol" {
          debug_assert(extension_static_dnr_count(eid) > 10000, "ubol loaded >10k static DNR rules")
          let (ub_doms, ub_init, ub_tok, ub_glob) = extension_dnr_index_stats()
          debug_assert(ub_doms > 10000 && ub_tok > 1000 && ub_glob < 1500, "ubol 3-tier DNR index populated: doms=" + ub_doms.to_string() + " init=" + ub_init.to_string() + " tok=" + ub_tok.to_string() + " glob=" + ub_glob.to_string())
          match extension_dnr_check("https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js", login_url, "script") {
            extensions::DnrDecision::Redirected(_, t) =>
            debug_assert(t.starts_with("chrome-extension://" + eid + "/"), "ubol redirects adsbygoogle to extensionPath: " + t)
            extensions::DnrDecision::Blocked(_) => ()
            _ => debug_assert(false, "ubol must block or redirect adsbygoogle.js")
          }
          match extension_dnr_check("https://adservice.google.com/adsid/integrator.js", login_url, "script") {
            extensions::DnrDecision::Blocked(_) => ()
            _ => debug_assert(false, "ubol must block adservice.google.com")
          }
          match extension_dnr_check("https://accounts.example.com/static/app.js", login_url, "script") {
            extensions::DnrDecision::Allowed => ()
            _ => debug_assert(false, "ubol must not false-positive block accounts.example.com")
          }
          // Measure 1,000 indexed DNR evaluations against uBOL's full static ruleset
          let t0 = now_ms()
          let mut k = 0
          let mut hits = 0
          while k < 250 {
            match extension_dnr_check("https://adservice.google.com/adsid/integrator.js", login_url, "script") {
              extensions::DnrDecision::Blocked(_) => hits += 1
              _ => ()
            }
            match extension_dnr_check("https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js", login_url, "script") {
              extensions::DnrDecision::Redirected(_, _) | extensions::DnrDecision::Blocked(_) => hits += 1
              _ => ()
            }
            match extension_dnr_check("https://accounts.example.com/static/app.js", login_url, "script") {
              extensions::DnrDecision::Allowed => hits += 1
              _ => ()
            }
            match extension_dnr_check("https://cdn.example.org/assets/bundle.css", login_url, "stylesheet") {
              extensions::DnrDecision::Allowed => hits += 1
              _ => ()
            }
            k += 1
          }
          let elapsed = now_ms() - t0
          println("UBOL_DNR_BENCH rules=" + extension_static_dnr_count(eid).to_string() + " indexed_domains=" + ub_doms.to_string() + " indexed_initiators=" + ub_init.to_string() + " indexed_tokens=" + ub_tok.to_string() + " global_rules=" + ub_glob.to_string() + " evals=1000 hits=" + hits.to_string() + " elapsed_ms=" + elapsed.to_string())
          debug_assert(hits == 1000, "all 1000 ubol DNR benchmark evals matched expected outcomes")
          debug_assert(elapsed < 500, "1000 indexed ubol DNR evals must complete under 500ms, got ms=" + elapsed.to_string())
        }
        let popup_url = extension_action_click(eid)
        debug_assert(popup_url != "", name + ": popup url present")
        st.errors.clear()
        debug_assert(load(popup_url, 400.0, 600.0), name + ": popup loaded")
        let mut pj = 0
        while pj < 10 {
          tick(50)
          js::worker_sleep_ms(15)
          pj += 1
        }
        let nodes = css::parse_double(eval("String(document.querySelectorAll('*').length)")).to_int()
        debug_assert(nodes >= 10, name + ": popup rendered DOM nodes: " + nodes.to_string())
        if name != "darkreader" {
          debug_assert(st.errors.length() == 0, name + ": zero popup errors, got: " + st.errors.join("; "))
        }
      }
      Err(e) => debug_assert(false, name + " install failed: " + e)
    }
    clear_extensions()
  }
}

test "MV3 M1.4 (R3 regressions): subframe a=90 context, tabs.sendMessage all-frames + iframe teardown, rejected Promise error, SW startup failure, scripting allFrames" {
  configure_extensions_storage("")
  clear_extensions()

  // 1. SW startup failure must terminate worker and leave bg_worker_id == 0
  let bad_id = "ffffffffffffffffffffffffffffffff"
  let bad_manifest = "{\"manifest_version\":3,\"name\":\"BadSW\",\"version\":\"1.0.0\",\"background\":{\"service_worker\":\"sw.mjs\",\"type\":\"module\"}}"
  let bad_files : Map[String, String] = Map::new()
  bad_files.set("sw.mjs", "throw new Error('boom-on-boot');")
  debug_assert(install_extension(bad_id, bad_manifest, bad_files) is Ok(_), "install bad SW ext")
  debug_assert(extension_bg_worker_id(bad_id) == 0, "failed SW startup must return bg_worker_id == 0")
  let _ = uninstall_extension(bad_id)

  // 2. Main R3 test extension with all_frames content script, scripting, tabs, and SW
  let ext_id = "cccccccccccccccccccccccccccccccc"
  let manifest = "{" +
  "\"manifest_version\":3," +
  "\"name\":\"R3Suite\"," +
  "\"version\":\"1.0.0\"," +
  "\"permissions\":[\"tabs\",\"scripting\",\"storage\"]," +
  "\"host_permissions\":[\"https://*.r3.test/*\"]," +
  "\"background\":{\"service_worker\":\"sw.js\"}," +
  "\"content_scripts\":[{\"matches\":[\"https://*.r3.test/*\"],\"js\":[\"cs.js\"],\"all_frames\":true,\"run_at\":\"document_idle\"}]" +
  "}"
  let files : Map[String, String] = Map::new()
  files.set(
    "cs.js",
    "const isSub = location.href.indexOf('/sub') >= 0;\n" +
    "if (isSub) {\n" +
    "  // Dispatch input from subframe isolated world -> must land in subframe main world only\n" +
    "  const inp = document.getElementById('u');\n" +
    "  if (inp) { inp.value = 'sub-fill'; inp.dispatchEvent(new Event('input', { bubbles: true })); }\n" +
    "}\n" +
    "chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {\n" +
    "  if (msg === 'fanout') {\n" +
    "    document.documentElement.setAttribute('data-fanout', isSub ? 'sub' : 'top');\n" +
    "    if (!isSub) { sendResponse({ from: 'top' }); return; }\n" +
    "    return;\n" +
    "  }\n" +
    "  if (msg === 'hang-sub' && isSub) {\n" +
    "    return true; // intentionally never replies; iframe removal must reject caller\n" +
    "  }\n" +
    "});\n",
  )
  files.set(
    "sw.js",
    "let hangErr = '';\n" +
    "let fanoutReply = '';\n" +
    "let execRes = '';\n" +
    "chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {\n" +
    "  if (msg === 'reject-me') {\n" +
    "    return Promise.reject(new Error('denied-by-sw'));\n" +
    "  }\n" +
    "  if (msg === 'run-fanout') {\n" +
    "    chrome.tabs.sendMessage(1, 'fanout').then((r) => { fanoutReply = JSON.stringify(r); sendResponse(r); });\n" +
    "    return true;\n" +
    "  }\n" +
    "  if (msg === 'start-hang') {\n" +
    "    chrome.tabs.sendMessage(1, 'hang-sub').then(\n" +
    "      (r) => { hangErr = 'UNEXPECTED:' + JSON.stringify(r); },\n" +
    "      (e) => { hangErr = String((e && e.message) || e); }\n" +
    "    );\n" +
    "    sendResponse({ started: true });\n" +
    "    return;\n" +
    "  }\n" +
    "  if (msg === 'get-hang') { sendResponse({ hangErr }); return; }\n" +
    "  if (msg === 'run-exec-all') {\n" +
    "    chrome.scripting.executeScript({ target: { tabId: 1, allFrames: true }, func: () => location.href }).then((res) => {\n" +
    "      execRes = JSON.stringify(res);\n" +
    "      sendResponse(res);\n" +
    "    });\n" +
    "    return true;\n" +
    "  }\n" +
    "});\n",
  )
  debug_assert(install_extension(ext_id, manifest, files) is Ok(_), "install R3 ext")

  let main_url = "https://app.r3.test/top"
  let sub_url = "https://app.r3.test/sub"
  let sub_html = (
    "<!doctype html><html><body><input id='u'><script>" +
    "document.getElementById('u').addEventListener('input', e => { document.documentElement.setAttribute('data-sub-got', e.target.value); });" +
    "</script></body></html>"
  ).to_bytes()
  let main_html = (
    "<!doctype html><html><body><input id='u'><iframe id='f1' src='" + sub_url + "'></iframe><script>" +
    "window.__topGot=''; document.getElementById('u').addEventListener('input', e => { window.__topGot = e.target.value; });" +
    "</script></body></html>"
  ).to_bytes()
  fcache.cache.set(main_url, (main_html, main_url))
  debug_assert(load(main_url, 800.0, 600.0, parsed=fn() { fcache.cache.set(sub_url, (sub_html, sub_url)) }), "load R3 page")
  tick(48)

  // Check 1: subframe isolated-world event landed ONLY in subframe main world (not top main world)
  let sub_got = eval("document.getElementById('f1').contentDocument.documentElement.getAttribute('data-sub-got') || ''")
  let top_got = eval("window.__topGot")
  debug_assert(sub_got == "sub-fill", "subframe a=90 reached subframe main world: got=" + sub_got)
  debug_assert(top_got == "", "subframe a=90 did NOT leak to top main world: " + top_got)

  // Check 2: rejected Promise in SW runtime.onMessage propagates error instead of null
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('reject-me').then(() => { window.__rej = 'OK'; }, (e) => { window.__rej = String((e && e.message) || e); }); 1",
  )
  ext_t_wait("rejected SW promise error", fn() { eval_in_extension_world(ext_id, "String(window.__rej || '')").contains("denied-by-sw") })

  // Check 3: tabs.sendMessage delivers to BOTH top frame AND subframe even when top frame replies sync
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('run-fanout').then((r) => { window.__fan = JSON.stringify(r); }); 1",
  )
  ext_t_wait("tabs.sendMessage fanout reply", fn() { eval_in_extension_world(ext_id, "String(window.__fan || '')").contains("top") })
  debug_assert(eval("document.documentElement.getAttribute('data-fanout')") == "top", "top frame got fanout")
  debug_assert(eval("document.getElementById('f1').contentDocument.documentElement.getAttribute('data-fanout')") == "sub", "subframe ALSO got fanout despite top sync reply")

  // Check 4: chrome.scripting.executeScript({ target: { tabId: 1, allFrames: true } }) runs in both frames
  let _ = eval_in_extension_world(
    ext_id,
    "chrome.runtime.sendMessage('run-exec-all').then((r) => { window.__ex = JSON.stringify(r); }); 1",
  )
  ext_t_wait("executeScript allFrames", fn() {
    let s = eval_in_extension_world(ext_id, "String(window.__ex || '')")
    s.contains(main_url) && s.contains(sub_url)
  }, seen=fn() { eval_in_extension_world(ext_id, "String(window.__ex || '')") })

  // Check 5: tabs.sendMessage deferred reply rejects promptly when target iframe is removed
  let _ = eval_in_extension_world(ext_id, "chrome.runtime.sendMessage('start-hang').then(() => { window.__hs = '1'; }); 1")
  ext_t_wait("start-hang registered", fn() { eval_in_extension_world(ext_id, "String(window.__hs || '')") == "1" })
  tick(32)
  let _ = eval("document.getElementById('f1').remove()")
  tick(32)
  ext_t_wait("iframe teardown rejects deferred reply", fn() {
    let _ = eval_in_extension_world(ext_id, "chrome.runtime.sendMessage('get-hang').then((r) => { window.__he = (r && r.hangErr) || ''; }); 1")
    eval_in_extension_world(ext_id, "String(window.__he || '')").contains("message port closed")
  }, seen=fn() { eval_in_extension_world(ext_id, "String(window.__he || '')") })

  clear_extensions()
}
