///| End-to-end host tests for Farview Wave M1:
///|   1. W3C WebCodecs API: VideoFrame (Canvas/Buffer/I420/NV12/BGRA) -> VideoEncoder ->
///|      EncodedVideoChunk -> VideoDecoder -> VideoFrame -> Canvas2D.drawImage + WebGL2.texImage2D
///|      pixel-exact round-trip & close() InvalidStateError checks.
///|   2. AudioData (f32-planar/s16/u8) -> AudioEncoder -> EncodedAudioChunk -> AudioDecoder ->
///|      AudioData copyTo sample-exact round-trip & close() checks.
///|   3. MediaStreamTrackProcessor -> TransformStream (pixel filter simulating Meet background blur) ->
///|      MediaStreamTrackGenerator -> <video srcObject> -> Canvas2D real pixel verification.
///|   4. RTCRtpSender/Receiver.createEncodedStreams() + RTCRtpScriptTransform +
///|      RTCEncodedVideoFrame / RTCEncodedAudioFrame.
///|   5. W3C Screen Wake Lock API (navigator.wakeLock.request, release, visibilitychange auto-release,
///|      invalid type rejection, hidden document rejection).

import "webgl"

test "WebCodecs Video E2E: Canvas -> VideoFrame -> VideoEncoder -> VideoDecoder -> Canvas2D & WebGL2 + close()" {
  debug_assert(
    load(
      "data:text/html;charset=utf-8,<!doctype html><html><body><canvas id='src' width='32' height='32'></canvas><canvas id='dst' width='32' height='32'></canvas><canvas id='glc' width='32' height='32'></canvas></body></html>",
      800.0,
      600.0,
    ),
    "loaded WebCodecs Video E2E page",
  )

  let _ = eval(
    "globalThis.__wcVidRes = '';" +
    "(async () => {" +
    "  try {" +
    "    const supAvc = await VideoEncoder.isConfigSupported({ codec: 'avc1.42001E', width: 32, height: 32 });" +
    "    const supVp9 = await VideoDecoder.isConfigSupported({ codec: 'vp09.00.10.08' });" +
    "    const supAv1 = await VideoDecoder.isConfigSupported({ codec: 'av01.0.04M.08' });" +
    "    const supBad = await VideoEncoder.isConfigSupported({ codec: 'bogus-codec', width: 32, height: 32 });" +
    "    if (!supAvc.supported || !supVp9.supported || !supAv1.supported || supBad.supported) {" +
    "      globalThis.__wcVidRes = 'err:support'; return;" +
    "    }" +
    "    const src = document.getElementById('src');" +
    "    const ctx1 = src.getContext('2d');" +
    "    ctx1.fillStyle = 'rgb(220, 40, 60)'; ctx1.fillRect(0, 0, 16, 32);" +
    "    ctx1.fillStyle = 'rgb(30, 180, 240)'; ctx1.fillRect(16, 0, 16, 32);" +
    "    const vf = new VideoFrame(src, { timestamp: 12345, duration: 33333 });" +
    "    if (vf.codedWidth !== 32 || vf.codedHeight !== 32 || vf.format !== 'RGBA' || vf.timestamp !== 12345) {" +
    "      globalThis.__wcVidRes = 'err:vf-props'; return;" +
    "    }" +
    "    if (vf.allocationSize() !== 32 * 32 * 4) { globalThis.__wcVidRes = 'err:alloc'; return; }" +
    "    const cloned = vf.clone();" +
    "    const copyBuf = new Uint8Array(cloned.allocationSize());" +
    "    await cloned.copyTo(copyBuf);" +
    "    cloned.close();" +
    "    if (copyBuf[0] !== 220 || copyBuf[1] !== 40 || copyBuf[2] !== 60 || copyBuf[3] !== 255) {" +
    "      globalThis.__wcVidRes = 'err:copyTo:' + copyBuf.slice(0, 4).join(','); return;" +
    "    }" +
    "    const chunks = []; let encDequeues = 0; let decDequeues = 0;" +
    "    const enc = new VideoEncoder({" +
    "      output: (ch, meta) => { chunks.push({ ch, meta }); }," +
    "      error: (e) => { globalThis.__wcVidRes = 'err:enc:' + e; }" +
    "    });" +
    "    enc.ondequeue = () => { encDequeues++; };" +
    "    enc.configure({ codec: 'avc1.42001E', width: 32, height: 32, bitrate: 500000, framerate: 30 });" +
    "    enc.encode(vf, { keyFrame: true });" +
    "    vf.close();" +
    "    await enc.flush();" +
    "    if (chunks.length !== 1 || chunks[0].ch.type !== 'key' || chunks[0].ch.byteLength <= 24 || encDequeues < 1) {" +
    "      globalThis.__wcVidRes = 'err:enc-out'; return;" +
    "    }" +
    "    const decoded = [];" +
    "    const dec = new VideoDecoder({" +
    "      output: (f) => { decoded.push(f); }," +
    "      error: (e) => { globalThis.__wcVidRes = 'err:dec:' + e; }" +
    "    });" +
    "    dec.ondequeue = () => { decDequeues++; };" +
    "    dec.configure(chunks[0].meta.decoderConfig);" +
    "    dec.decode(chunks[0].ch);" +
    "    await dec.flush();" +
    "    if (decoded.length !== 1 || decDequeues < 1) { globalThis.__wcVidRes = 'err:dec-out'; return; }" +
    "    const df = decoded[0];" +
    "    const dst = document.getElementById('dst');" +
    "    const ctx2 = dst.getContext('2d');" +
    "    ctx2.drawImage(df, 0, 0);" +
    "    const pL = ctx2.getImageData(4, 16, 1, 1).data;" +
    "    const pR = ctx2.getImageData(24, 16, 1, 1).data;" +
    "    let glOk = true;" +
    "    const gl = document.getElementById('glc').getContext('webgl2');" +
    "    if (gl) {" +
    "      const tex = gl.createTexture();" +
    "      gl.bindTexture(gl.TEXTURE_2D, tex);" +
    "      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, df);" +
    "      glOk = gl.getError() === 0;" +
    "      gl.deleteTexture(tex);" +
    "    }" +
    "    df.close();" +
    "    let closedErr = '';" +
    "    try { df.clone(); } catch (e) { closedErr = e.name; }" +
    "    let drawClosedErr = '';" +
    "    try { ctx2.drawImage(df, 0, 0); } catch (e) { drawClosedErr = e.name; }" +
    "    enc.reset(); if (enc.state !== 'unconfigured') { globalThis.__wcVidRes = 'err:reset'; return; }" +
    "    enc.close(); dec.close();" +
    "    const bgra = new Uint8Array([10, 20, 200, 255, 10, 20, 200, 255, 10, 20, 200, 255, 10, 20, 200, 255]);" +
    "    const fBgra = new VideoFrame(bgra, { format: 'BGRA', codedWidth: 2, codedHeight: 2, timestamp: 99 });" +
    "    const rgbaOut = new Uint8Array(16);" +
    "    await fBgra.copyTo(rgbaOut, { format: 'RGBA' });" +
    "    fBgra.close();" +
    "    globalThis.__wcVidRes = 'ok|' + [pL[0],pL[1],pL[2],pL[3]].join(',') + '|' + [pR[0],pR[1],pR[2],pR[3]].join(',') + '|' + glOk + '|' + closedErr + '|' + drawClosedErr + '|' + [rgbaOut[0],rgbaOut[1],rgbaOut[2],rgbaOut[3]].join(',');" +
    "  } catch (e) { globalThis.__wcVidRes = 'exc:' + (e && e.stack ? e.stack : e); }" +
    "})();",
  )

  let mut tries = 0
  while tries < 40 && eval("globalThis.__wcVidRes") == "" {
    tick(16)
    tries += 1
  }
  let res = eval("globalThis.__wcVidRes")
  debug_assert(
    res == "ok|220,40,60,255|30,180,240,255|true|InvalidStateError|InvalidStateError|200,20,10,255",
    "WebCodecs Video E2E exact pixel round-trip failed, got: " + res,
  )
  clear_webgl()
  debug_assert(webgl::active_count() == 0, "zero WebGL leaks")
}

test "WebCodecs Audio E2E: AudioData -> AudioEncoder -> EncodedAudioChunk -> AudioDecoder -> copyTo" {
  debug_assert(
    load("data:text/html;charset=utf-8,<!doctype html><html><body></body></html>", 800.0, 600.0),
    "loaded WebCodecs Audio E2E page",
  )

  let _ = eval(
    "globalThis.__wcAudRes = '';" +
    "(async () => {" +
    "  try {" +
    "    const supOpus = await AudioEncoder.isConfigSupported({ codec: 'opus', sampleRate: 48000, numberOfChannels: 2 });" +
    "    const supAac = await AudioDecoder.isConfigSupported({ codec: 'mp4a.40.2', sampleRate: 44100, numberOfChannels: 2 });" +
    "    const supBad = await AudioEncoder.isConfigSupported({ codec: 'unknown-aud', sampleRate: 48000, numberOfChannels: 1 });" +
    "    if (!supOpus.supported || !supAac.supported || supBad.supported) { globalThis.__wcAudRes = 'err:support'; return; }" +
    "    const nf = 64, nc = 2, sr = 48000;" +
    "    const src = new Float32Array(nf * nc);" +
    "    for (let i = 0; i < nf; i++) { src[i] = (i - 32) / 64; src[nf + i] = Math.sin(i * 0.1) * 0.5; }" +
    "    const ad = new AudioData({ format: 'f32-planar', sampleRate: sr, numberOfFrames: nf, numberOfChannels: nc, timestamp: 5000, data: src });" +
    "    if (ad.allocationSize({ planeIndex: 0 }) !== nf * 4 || ad.allocationSize({ planeIndex: 1 }) !== nf * 4) {" +
    "      globalThis.__wcAudRes = 'err:alloc'; return;" +
    "    }" +
    "    const chunks = [];" +
    "    const enc = new AudioEncoder({ output: (c, m) => chunks.push({ c, m }), error: (e) => { globalThis.__wcAudRes = 'err:enc:' + e; } });" +
    "    enc.configure({ codec: 'opus', sampleRate: sr, numberOfChannels: nc });" +
    "    enc.encode(ad);" +
    "    ad.close();" +
    "    let closedErr = ''; try { ad.clone(); } catch (e) { closedErr = e.name; }" +
    "    await enc.flush();" +
    "    const decoded = [];" +
    "    const dec = new AudioDecoder({ output: (d) => decoded.push(d), error: (e) => { globalThis.__wcAudRes = 'err:dec:' + e; } });" +
    "    dec.configure({ codec: 'opus', sampleRate: sr, numberOfChannels: nc });" +
    "    dec.decode(chunks[0].c);" +
    "    await dec.flush();" +
    "    const out = decoded[0];" +
    "    const ch0 = new Float32Array(nf), ch1 = new Float32Array(nf);" +
    "    out.copyTo(ch0, { planeIndex: 0 });" +
    "    out.copyTo(ch1, { planeIndex: 1 });" +
    "    let maxDiff = 0;" +
    "    for (let i = 0; i < nf; i++) {" +
    "      maxDiff = Math.max(maxDiff, Math.abs(ch0[i] - src[i]), Math.abs(ch1[i] - src[nf + i]));" +
    "    }" +
    "    out.close(); enc.close(); dec.close();" +
    "    globalThis.__wcAudRes = 'ok|' + (maxDiff < 1e-6) + '|' + out.timestamp + '|' + closedErr;" +
    "  } catch (e) { globalThis.__wcAudRes = 'exc:' + e; }" +
    "})();",
  )

  let mut tries = 0
  while tries < 40 && eval("globalThis.__wcAudRes") == "" {
    tick(16)
    tries += 1
  }
  let res = eval("globalThis.__wcAudRes")
  debug_assert(res == "ok|true|5000|InvalidStateError", "WebCodecs Audio E2E failed, got: " + res)
}

test "Meet Insertable Streams + WebRTC Encoded Transform + Screen Wake Lock E2E" {
  configure_permissions("", "meet-webcodecs-e2e")
  debug_assert(
    load(
      "data:text/html;charset=utf-8,<!doctype html><html><body><video id='v'></video><canvas id='out' width='16' height='16'></canvas></body></html>",
      1280.0,
      800.0,
    ),
    "loaded Meet streams + WakeLock E2E page",
  )
  st.url = "https://meet.google.com/webcodecs-e2e"
  let _ = perm_op(1, "camera", "granted")
  let _ = perm_op(1, "microphone", "granted")

  let _ = eval(
    "globalThis.__meetPipeRes = '';" +
    "(async () => {" +
    "  try {" +
    "    const camStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });" +
    "    const camTrack = camStream.getVideoTracks()[0];" +
    "    const proc = new MediaStreamTrackProcessor({ track: camTrack });" +
    "    const gen = new MediaStreamTrackGenerator({ kind: 'video' });" +
    "    const videoEl = document.getElementById('v');" +
    "    videoEl.srcObject = new MediaStream([gen]);" +
    "    const filter = new TransformStream({" +
    "      async transform(frame, controller) {" +
    "        const w = 16, h = 16;" +
    "        const px = new Uint8Array(w * h * 4);" +
    "        for (let i = 0; i < px.length; i += 4) { px[i] = 90; px[i+1] = 210; px[i+2] = 150; px[i+3] = 255; }" +
    "        const outFrame = new VideoFrame(px, { format: 'RGBA', codedWidth: w, codedHeight: h, timestamp: frame.timestamp });" +
    "        frame.close();" +
    "        controller.enqueue(outFrame);" +
    "      }" +
    "    });" +
    "    const reader = proc.readable.pipeThrough(filter).getReader();" +
    "    const writer = gen.writable.getWriter();" +
    "    const first = await reader.read();" +
    "    await writer.write(first.value);" +
    "    await reader.cancel();" +
    "    const outCanvas = document.getElementById('out');" +
    "    const octx = outCanvas.getContext('2d');" +
    "    octx.drawImage(videoEl, 0, 0);" +
    "    const opx = octx.getImageData(8, 8, 1, 1).data;" +
    "    const vidDims = videoEl.videoWidth + 'x' + videoEl.videoHeight;" +
    "    camTrack.stop(); gen.stop();" +
    "    const pc = new RTCPeerConnection();" +
    "    const tr = pc.addTransceiver('video');" +
    "    const sStreams = tr.sender.createEncodedStreams();" +
    "    const sr = sStreams.readable.getReader();" +
    "    const sw = sStreams.writable.getWriter();" +
    "    const ef = (await sr.read()).value;" +
    "    const isEncVid = ef instanceof RTCEncodedVideoFrame && ef.type === 'key' && ef.data instanceof ArrayBuffer && ef.getMetadata().synchronizationSource === 1;" +
    "    const bytes = new Uint8Array(ef.data); for (let i = 0; i < bytes.length; i++) bytes[i] ^= 0x5a;" +
    "    ef.data = bytes.buffer;" +
    "    await sw.write(ef);" +
    "    let dupStreamErr = ''; try { tr.sender.createEncodedStreams(); } catch (e) { dupStreamErr = e.name; }" +
    "    const rStreams = tr.receiver.createEncodedStreams();" +
    "    const rf = (await rStreams.readable.getReader().read()).value;" +
    "    const rxOk = rf instanceof RTCEncodedVideoFrame && rf.data instanceof ArrayBuffer;" +
    "    const tr2 = pc.addTransceiver('audio');" +
    "    let xformEvtOk = false;" +
    "    const fakeWorker = new EventTarget();" +
    "    fakeWorker.addEventListener('rtctransform', ev => {" +
    "      xformEvtOk = ev.transformer && ev.transformer.readable instanceof ReadableStream && ev.transformer.writable instanceof WritableStream && ev.transformer.options.keyId === 7;" +
    "    });" +
    "    tr2.sender.transform = new RTCRtpScriptTransform(fakeWorker, { keyId: 7 });" +
    "    await Promise.resolve(); await Promise.resolve();" +
    "    pc.close();" +
    "    let badTypeErr = '';" +
    "    try { await navigator.wakeLock.request('system'); } catch (e) { badTypeErr = e.name; }" +
    "    const wl1 = await navigator.wakeLock.request('screen');" +
    "    let wl1Events = 0; wl1.onrelease = () => { wl1Events++; };" +
    "    const wl1Init = (wl1 instanceof WakeLockSentinel) && wl1.type === 'screen' && wl1.released === false;" +
    "    await wl1.release(); await wl1.release();" +
    "    const wl1Done = wl1.released === true && wl1Events === 1;" +
    "    const wl2 = await navigator.wakeLock.request('screen');" +
    "    let wl2AutoReleased = 0; wl2.addEventListener('release', () => { wl2AutoReleased++; });" +
    "    Object.defineProperty(document, 'visibilityState', { value: 'hidden', configurable: true });" +
    "    Object.defineProperty(document, 'hidden', { value: true, configurable: true });" +
    "    document.dispatchEvent(new Event('visibilitychange'));" +
    "    let hiddenReqErr = '';" +
    "    try { await navigator.wakeLock.request('screen'); } catch (e) { hiddenReqErr = e.name; }" +
    "    globalThis.__meetPipeRes = ['ok', vidDims, [opx[0],opx[1],opx[2],opx[3]].join(','), isEncVid, dupStreamErr, rxOk, xformEvtOk, badTypeErr, wl1Init, wl1Done, wl2.released, wl2AutoReleased, hiddenReqErr].join('|');" +
    "  } catch (e) { globalThis.__meetPipeRes = 'exc:' + (e && e.stack ? e.stack : e); }" +
    "})();",
  )

  let mut tries = 0
  while tries < 40 && eval("globalThis.__meetPipeRes") == "" {
    tick(16)
    tries += 1
  }
  let res = eval("globalThis.__meetPipeRes")
  debug_assert(
    res == "ok|16x16|90,210,150,255|true|InvalidStateError|true|true|TypeError|true|true|true|1|NotAllowedError",
    "Meet Insertable Streams + Encoded Transform + WakeLock E2E failed, got: " + res,
  )
  clear_webrtc()
}
