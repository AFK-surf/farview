///| Tab's sequential focus order (HTML §6.6.3) and :focus-visible as a key moves the focus.

test "Tab visits positive tabindex first by value, then the rest in document order, skipping what cannot take focus" {
  let html = "<!doctype html><html><body>" +
  "<input id='a'>" +
  "<button id='b' tabindex='2'>b</button>" +
  "<a id='c' href='#x'>c</a>" +
  "<button id='d' disabled>d</button>" +
  "<div id='e' tabindex='1'>e</div>" +
  "<div id='f' contenteditable='true'><span id='g' contenteditable='true'>g</span></div>" +
  "<span id='h' tabindex='-1'>h</span>" +
  "<button id='i' style='display:none'>i</button>" +
  "<div id='j' contenteditable='false'>j</div>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")
  let _ = eval("document.activeElement && document.activeElement.blur && document.activeElement.blur();")
  let order : Array[String] = []
  for _ in 0..<7 {
    let _ = person_key("down", "Tab", "Tab", 0)
    let _ = person_key("up", "Tab", "Tab", 0)
    order.push(eval("document.activeElement ? document.activeElement.id : ''"))
  }
  let got = order.join(",")
  debug_assert(got == "e,b,a,c,f,e,b", "Tab order: " + got)
  // (Shift+Tab back the other way, round from the start)
  let back : Array[String] = []
  for _ in 0..<3 {
    let _ = person_key("down", "Tab", "Tab", 8)
    let _ = person_key("up", "Tab", "Tab", 8)
    back.push(eval("document.activeElement ? document.activeElement.id : ''"))
  }
  let got_back = back.join(",")
  debug_assert(got_back == "e,f,c", "Shift+Tab order: " + got_back)
  // (moved by a key: the focus shows)
  debug_assert(eval("String(document.getElementById('c').matches(':focus-visible'))") == "true", "keyboard focus is :focus-visible")
}

test "Tab walks the flat tree: into shadow roots and slots; not into inert, hidden, or a disabled fieldset; a radio group is one stop" {
  let html = "<!doctype html><html><body>" +
  "<input id='a'>" +
  "<x-card id='card'><button id='slotted'>s</button></x-card>" +
  "<fieldset disabled><legend><input id='inlegend'></legend><input id='offd'></fieldset>" +
  "<div inert><button id='inert'>i</button></div>" +
  "<button id='hid' style='visibility:hidden'>h</button>" +
  "<input type='radio' name='r' id='r1'><input type='radio' name='r' id='r2' checked><input type='radio' name='r' id='r3'>" +
  "<input type='radio' name='q' id='q1'><input type='radio' name='q' id='q2'>" +
  "<button id='z'>z</button>" +
  "</body></html>"
  debug_assert(load("data:text/html;charset=utf-8," + html, 800.0, 600.0), "page loaded")
  let _ = eval(
    "const h = document.getElementById('card'); const sr = h.attachShadow({ mode: 'open' });" +
    "sr.innerHTML = \"<button id='inner1'>1</button><slot></slot><button id='inner2'>2</button>\";" +
    "document.activeElement && document.activeElement.blur && document.activeElement.blur();",
  )
  let order : Array[String] = []
  for _ in 0..<8 {
    let _ = person_key("down", "Tab", "Tab", 0)
    let _ = person_key("up", "Tab", "Tab", 0)
    order.push(eval("document.activeElement ? document.activeElement.id : ''"))
  }
  let got = order.join(",")
  debug_assert(got == "a,inner1,slotted,inner2,inlegend,r2,q1,z", "flat-tree Tab order: " + got)
  // (back into a group with none checked: its last)
  let _ = person_key("down", "Tab", "Tab", 8)
  debug_assert(eval("document.activeElement.id") == "q2", "Shift+Tab into an unchecked group: its last")
}
