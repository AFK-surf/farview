///| 1:1 port of `client/src/stage/stage11_wbtest.mbt` (5 tests).

import "css"
import "layout"
import "display"
import "doc"
import "proto"
import "signals"

test "stage11a: canvas 200 frames zero-leak and invar node reuse" {
  let forgotten : Array[String] = []
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) }, forget=fn(k : String) -> Unit { forgotten.push(k) })
  let wide = signals::signal(640.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><canvas id=c width=300 height=150></canvas></body></html>",
    "body { margin: 0; } canvas { display: block; width: 300px; height: 150px; }",
  )
  let t = shown(stage, wide)
  stage.opened()
  let canvas_el = must(find_el(host.doc, "c"))
  let px = FixedArray::make(4 * 4 * 4, 0x90.to_byte())
  let png_bytes = png(px, 4, 4)
  canvas_el.src_url = Some("fvcanvas:1/1")
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:1/1", 0, 4.0, 4.0, png_bytes)))
  stage.feed(host.reset())
  t.run_for(shown_ms)
  let leaves_base = leaves_made[0]
  let mut v = 2
  while v <= 200 {
    let u = "fvcanvas:1/" + v.to_string()
    canvas_el.src_url = Some(u)
    stage.feed(proto::encode_host(proto::HostMsg::Asset(u, 0, 4.0, 4.0, png_bytes)))
    stage.feed(host.patch(0))
    t.frame(ms=16.0)
    v += 1
  }
  debug_assert(stage.pictures.length() == 1, "pictures length == 1")
  debug_assert(stage.picture_bytes.length() == 1, "picture_bytes length == 1")
  debug_assert(forgotten.length() == 198, "double-buffered forgotten == 198")
  // When Asset(N+1) arrives ahead of Patch(SetImage(N+1)), querying picture(N) must fall back to latest canvas key instead of None
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:1/201", 0, 4.0, 4.0, png_bytes)))
  match stage.picture("fvcanvas:1/200") {
    Some((src, _, _)) => debug_assert(src == "fvpic:fvcanvas:1/201", "stale canvas ref must fall back to latest fvcanvas:1/201, got " + src)
    None => debug_assert(false, "stale canvas ref must not return None when newer Asset already arrived")
  }
  debug_assert(leaves_made[0] - leaves_base == 0, "zero new invar leaves across 199 canvas frames")
  let host2 = TestHost::new("<!doctype html><html><body><p>next</p></body></html>", "")
  stage.feed(host2.reset())
  t.frame(ms=16.0)
  debug_assert(forgotten.length() == 201, "all 201 canvas textures forgotten after reset")
  t.dispose()
}

test "stage11a: css @keyframes rotate continuous and finite animation stops when idle" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(640.0)
  let css_src = "body { margin: 0; } " +
  "@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } } " +
  "@keyframes fade { from { opacity: 0; } to { opacity: 1; } } " +
  "#s { width: 40px; height: 40px; background: rgb(255, 0, 0); animation: spin 1000ms linear 1 forwards; } " +
  "#f { width: 40px; height: 40px; background: rgb(0, 255, 0); animation: fade 200ms linear 1 forwards; }"
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><div id=s></div><div id=f></div></body></html>",
    css_src,
  )
  let t = shown(stage, wide)
  stage.opened()
  stage.feed(host.reset())
  t.frame(ms=16.0)
  let box_s = fn() -> layout::Box {
    let n = must(stage.doc.root())
    let el = must(find_el(n, "s"))
    must(stage.doc.box_of(el)).0
  }
  let now_ms = fn() -> Double { must(stage.node).logic_at() }
  let s0 = css::serialize_value(box_s().style.get("transform"))
  debug_assert(stage.doc.has_active_animations(now_ms()), "animations active at t=16ms")
  t.run_for(250.0)
  let s250 = css::serialize_value(box_s().style.get("transform"))
  t.run_for(250.0)
  let s500 = css::serialize_value(box_s().style.get("transform"))
  debug_assert(s0 != s250, "transform changed at 250ms")
  debug_assert(s250 != s500, "transform changed at 500ms")
  t.run_for(700.0)
  debug_assert(!stage.doc.has_active_animations(now_ms()), "finite animations idle after 1100ms")
  t.dispose()
}

test "stage11a: hover triggers 0-RTT css transition midpoint and settles" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(640.0)
  let css_src = "body { margin: 0; } " +
  "#btn { width: 120px; height: 60px; background-color: rgb(0, 0, 200); transform: translateY(0px); " +
  "transition: background-color 200ms linear, transform 200ms linear; } " +
  "#btn:hover { background-color: rgb(200, 0, 0); transform: translateY(-20px); }"
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><div id=btn></div></body></html>",
    css_src,
  )
  let t = shown(stage, wide)
  stage.opened()
  stage.feed(host.reset())
  t.frame(ms=16.0)
  let now_ms = fn() -> Double { must(stage.node).logic_at() }
  debug_assert(!stage.doc.has_active_animations(now_ms()), "idle before hover")
  t.move_to(60.0, 30.0)
  t.frame(ms=16.0)
  debug_assert(stage.doc.has_active_animations(now_ms()), "transition active on hover")
  t.run_for(100.0)
  let btn_el = must(find_el(must(stage.doc.root()), "btn"))
  let mid_col = must(must(stage.doc.box_of(btn_el)).0.style.color("background-color"))
  debug_assert(mid_col.r > 20 && mid_col.r < 190, "red channel interpolated at midpoint")
  debug_assert(mid_col.b > 10 && mid_col.b < 180, "blue channel interpolated at midpoint")
  t.run_for(150.0)
  debug_assert(!stage.doc.has_active_animations(now_ms()), "transition settled after 250ms")
  t.dispose()
}

test "Wave 85B: finite CSS opacity transition stays active until settled final frame is laid out" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(640.0)
  let css_src = "body { margin: 0; } " +
  "#box { width: 100px; height: 100px; opacity: 0; transition: all 0.2s ease; } " +
  "#box:hover { opacity: 1; }"
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><div id=box></div></body></html>",
    css_src,
  )
  let t = shown(stage, wide)
  stage.opened()
  stage.feed(host.reset())
  t.frame(ms=16.0)
  let now_ms = fn() -> Double { must(stage.node).logic_at() }
  t.move_to(50.0, 50.0)
  t.frame(ms=16.0)
  let t_start = now_ms()
  debug_assert(stage.has_finite_animations(t_start), "transition active right after start")
  // Even if wall clock jumps past transition duration before final layout runs, has_finite_animations stays true
  // because doc.last_anim_time() is still mid-transition.
  debug_assert(stage.has_finite_animations(t_start + 500.0), "has_finite_animations stays true until final frame is painted")
  t.run_for(300.0)
  let box_el = must(find_el(must(stage.doc.root()), "box"))
  let final_op = css::serialize_value(must(stage.doc.box_of(box_el)).0.style.get("opacity"))
  debug_assert(final_op == "1", "opacity settles to 1 after transition, got " + final_op)
  debug_assert(!stage.has_finite_animations(now_ms()), "has_finite_animations false once final settled frame is painted")
  t.dispose()
}

test "stage11a: backdrop-filter, filter, and clip-path emit expected display items" {
  let fonts = layout::Fonts::new_portable([], [])
  let d = doc::Doc::new_with_fonts(fonts)
  let css_src = "body { margin: 0; } " +
  "#g { width: 100px; height: 60px; border-radius: 12px; background: rgba(255,255,255,0.25); backdrop-filter: blur(12px) saturate(1.4); } " +
  "#f { width: 50px; height: 50px; background: rgb(255, 0, 0); filter: grayscale(1) drop-shadow(2px 4px 6px rgba(0,0,0,0.5)); } " +
  "#c1 { width: 60px; height: 60px; background: rgb(0, 255, 0); clip-path: inset(8px round 16px); } " +
  "#c2 { width: 60px; height: 60px; background: rgb(0, 0, 255); clip-path: circle(40% at 50% 50%); }"
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><div id=g></div><div id=f></div><div id=c1></div><div id=c2></div></body></html>",
    css_src,
  )
  let reset_bytes = host.reset()
  let framer = proto::Framer::new()
  framer.push(reset_bytes)
  match proto::decode_host(must(framer.next())) {
    Some(proto::HostMsg::Reset(_, _, wd)) => d.reset(wd)
    _ => debug_assert(false, "expected Reset")
  }
  let root = must(d.layout(640.0, 480.0))
  let items = display::display_list(root, fonts)
  let mut has_backdrop = false
  let mut has_shadow = false
  let mut has_gray_rect = false
  let mut round_clips = 0
  for it in items {
    match it {
      display::Item::Backdrop(_, _, _, _, _, blur, sat, _) => {
        if (blur - 12.0).abs() < 0.01 && (sat - 1.4).abs() < 0.01 {
          has_backdrop = true
        }
      }
      display::Item::Shadow(_, _, _, _, _, _, false) => has_shadow = true
      display::Item::Rect(_, _, w, h, c) => {
        if (w - 50.0).abs() < 0.5 && (h - 50.0).abs() < 0.5 {
          let r = (c >> 24) & 0xFF
          let g = (c >> 16) & 0xFF
          let b = (c >> 8) & 0xFF
          let drg = if r > g { r - g } else { g - r }
          let dgb = if g > b { g - b } else { b - g }
          if drg <= 1 && dgb <= 1 && r > 0 {
            has_gray_rect = true
          }
        }
      }
      display::Item::RoundClip(_, _, _, _, _) => round_clips += 1
      _ => ()
    }
  }
  debug_assert(has_backdrop, "backdrop-filter emitted")
  debug_assert(has_shadow, "drop-shadow emitted")
  debug_assert(has_gray_rect, "grayscale filter applied")
  debug_assert(round_clips >= 2, "clip-path round clips >= 2")
}

test "stage11a: chunked download protocol reassembles multi-chunk payload" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  stage.opened()
  let c1 = Bytes::new(4096)
  let mut i = 0
  while i < 4096 { c1[i] = (i % 251).to_byte(); i += 1 }
  let c2 = Bytes::new(4096)
  i = 0
  while i < 4096 { c2[i] = ((i + 17) % 251).to_byte(); i += 1 }
  let c3 = Bytes::new(1234)
  i = 0
  while i < 1234 { c3[i] = ((i + 99) % 251).to_byte(); i += 1 }
  let total = c1.length() + c2.length() + c3.length()
  stage.feed(proto::encode_host(proto::HostMsg::DownloadStart(42, "big.bin", "https://t.test/big.bin", "application/octet-stream", total)))
  stage.feed(proto::encode_host(proto::HostMsg::DownloadChunk(42, c1)))
  stage.feed(proto::encode_host(proto::HostMsg::DownloadChunk(42, c2)))
  stage.feed(proto::encode_host(proto::HostMsg::DownloadChunk(42, c3)))
  stage.feed(proto::encode_host(proto::HostMsg::DownloadEnd(42)))
  debug_assert(stage.downloads_seq() == 1, "downloads_seq == 1")
  let got = stage.take_downloads()
  debug_assert(got.length() == 1, "1 download")
  debug_assert(got[0].0 == "big.bin", "filename")
  debug_assert(got[0].1 == "https://t.test/big.bin", "url")
  debug_assert(got[0].2 == "application/octet-stream", "mime")
  debug_assert(got[0].3.length() == total, "reassembled total length")
  debug_assert(got[0].3[0] == c1[0] && got[0].3[4096] == c2[0] && got[0].3[8192] == c3[0], "reassembled chunk bytes match")
}

test "stage11b: initial viewport sent immediately (0ms), subsequent resize debounced 100ms" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(640.0)
  let t = shown(stage, wide)
  stage.opened()
  let count_vp = fn() -> Array[Double] {
    let ws : Array[Double] = []
    for m in said(sent) {
      match m {
        proto::ClientMsg::Viewport(w, _, _) => ws.push(w)
        _ => ()
      }
    }
    ws
  }
  // First layout sends Viewport immediately without waiting 100ms
  t.draw()
  let vp0 = count_vp()
  debug_assert(vp0.length() == 1 && (vp0[0] - 640.0).abs() < 0.01, "initial viewport sent immediately on first layout")
  // Subsequent resize is still debounced by 100ms
  wide.set(800.0)
  t.frame(ms=16.0)
  let vp1 = count_vp()
  debug_assert(vp1.length() == 1, "resize viewport debounced before 100ms")
  t.run_for(120.0)
  let vp2 = count_vp()
  debug_assert(vp2.length() == 2 && (vp2[1] - 800.0).abs() < 0.01, "resize viewport sent after 100ms debounce")
  t.dispose()
}

test "stage11c: async canvas decode holds last ready frame until new frame decodes" {
  let sent : Array[Bytes] = []
  let forgotten : Array[String] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) }, forget=fn(k : String) -> Unit { forgotten.push(k) })
  let wide = signals::signal(640.0)
  let t = shown(stage, wide)
  let h = hostapi::host()
  let orig_load = h.image_load_bytes
  let orig_info = h.image_info
  let ready_ids : Map[Int, Bool] = Map::new()
  let next_id : Array[Int] = [9000]
  h.image_load_bytes = fn(_data : Bytes, _px : Int) -> Int {
    next_id[0] = next_id[0] + 1
    ready_ids.set(next_id[0], false)
    next_id[0]
  }
  h.image_info = fn(id : Int, out : Array[Double]) -> Int {
    match ready_ids.get(id) {
      Some(true) => {
        out[0] = 130.0
        out[1] = 130.0
        1
      }
      Some(false) => 0
      None => orig_info(id, out)
    }
  }
  let px = FixedArray::make(4 * 4 * 4, 0xA0.to_byte())
  let png_bytes = png(px, 4, 4)
  // Frame 1 arrives; async decode starts (state=0)
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:9/1", 0, 130.0, 130.0, png_bytes)))
  let p1 = stage.picture("fvcanvas:9/1", want_px=260)
  let id1 = next_id[0]
  debug_assert(match p1 { Some((s, _, _)) => s == "fvpic:fvcanvas:9/1" None => false }, "frame 1 kicks off decode")
  // Frame 1 finishes decoding asynchronously; frame 2 arrives (not yet decoded)
  ready_ids.set(id1, true)
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:9/2", 0, 130.0, 130.0, png_bytes)))
  let p2 = stage.picture("fvcanvas:9/2", want_px=260)
  // Must return the ready frame 1 instead of undecoded frame 2 (zero blank frames!)
  debug_assert(match p2 { Some((s, _, _)) => s == "fvpic:fvcanvas:9/1" None => false }, "holds ready frame 1 while frame 2 decodes")
  let id2 = next_id[0]
  // Frame 2 finishes decoding; next query advances to frame 2
  ready_ids.set(id2, true)
  let p3 = stage.picture("fvcanvas:9/2", want_px=260)
  debug_assert(match p3 { Some((s, _, _)) => s == "fvpic:fvcanvas:9/2" None => false }, "advances to frame 2 once decoded")
  h.image_load_bytes = orig_load
  h.image_info = orig_info
  t.dispose()
}

test "stage11d: PatchOp::Rendered invalidates KeptCache when inline SVG key updates" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(640.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><div class=wrap><svg id=ico width=24 height=24 viewBox='0 0 20 20'></svg></div></body></html>",
    "body{margin:0} .wrap{width:100px;height:40px} svg{display:block;width:24px;height:24px}",
  )
  let t = shown(stage, wide)
  stage.opened()
  let svg_el = must(find_el(host.doc, "ico"))
  let svg_old = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' style='opacity:0'></svg>".to_bytes()
  let svg_new = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24'></svg>".to_bytes()
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fv-svg:old", 0, 24.0, 24.0, svg_old)))
  stage.feed(host.reset())
  stage.feed(proto::encode_host(proto::HostMsg::Patch(2, 0, [proto::PatchOp::Rendered(svg_el.uid, "fv-svg:old", 24.0, 24.0)])))
  t.run_for(shown_ms)
  let has_key = fn(target : String) -> Bool {
    for it in stage.last_items {
      match it {
        display::Item::Image(_, _, _, _, u, _) if u == target => return true
        _ => ()
      }
    }
    false
  }
  debug_assert(has_key("fv-svg:old"), "initial rendered SVG key fv-svg:old present in display list")
  // Now update the inline SVG key (e.g. fade-in opacity 0 -> 1) without changing parent layout/style
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fv-svg:new", 0, 24.0, 24.0, svg_new)))
  stage.feed(proto::encode_host(proto::HostMsg::Patch(3, 0, [proto::PatchOp::Rendered(svg_el.uid, "fv-svg:new", 24.0, 24.0)])))
  t.frame(ms=16.0)
  debug_assert(has_key("fv-svg:new") && !has_key("fv-svg:old"), "KeptCache must invalidate on PatchOp::Rendered so fv-svg:new replaces fv-svg:old")
  t.dispose()
}

test "stage11d: fvflt grayscale matrix on inline SVG produces non-white gray pixels" {
  let u = "fvflt:0.2126,0.7152,0.0722,0,0,0.2126,0.7152,0.0722,0,0,0.2126,0.7152,0.0722,0,0,0,0,0,1,0|fv-svg:test"
  match parse_fvflt(u) {
    Some((mat, base_u)) => {
      debug_assert(base_u == "fv-svg:test", "base_u mismatch: " + base_u)
      let arr : Array[Byte] = [255 as Byte, 87 as Byte, 10 as Byte, 255 as Byte]
      apply_mat_rgba_arr(arr, mat, true)
      let r = arr[0].to_int() & 0xFF
      let g = arr[1].to_int() & 0xFF
      let b = arr[2].to_int() & 0xFF
      let a = arr[3].to_int() & 0xFF
      debug_assert(r > 100 && r < 140 && r == g && g == b && a == 255, "expected gray ~117, got " + r.to_string() + "," + g.to_string() + "," + b.to_string() + "," + a.to_string())
    }
    None => debug_assert(false, "parse_fvflt returned None")
  }
}

test "stage11e: fvpoly hexagon clip zeroes 4 corners and keeps center opaque" {
  let u = "fvpoly:0.5,1;0.933,0.75;0.933,0.25;0.5,0;0.067,0.25;0.067,0.75|https://example.test/chart.png"
  match parse_fvpoly(u) {
    Some((pts, rest)) => {
      debug_assert(rest == "https://example.test/chart.png", "rest mismatch: " + rest)
      debug_assert(pts.length() == 6, "expected 6 hex vertices")
      let w = 20
      let h = 20
      let arr : Array[Byte] = Array::make(w * h * 4, 0xFF as Byte)
      apply_poly_rgba_arr(arr, w, h, pts, false)
      let a_tl = arr[3].to_int() & 0xFF
      let a_tr = arr[(w - 1) * 4 + 3].to_int() & 0xFF
      let a_bl = arr[((h - 1) * w) * 4 + 3].to_int() & 0xFF
      let a_br = arr[((h - 1) * w + (w - 1)) * 4 + 3].to_int() & 0xFF
      let a_mid = arr[((h / 2) * w + (w / 2)) * 4 + 3].to_int() & 0xFF
      debug_assert(a_tl == 0 && a_tr == 0 && a_bl == 0 && a_br == 0, "all 4 corners must be clipped to alpha=0")
      debug_assert(a_mid == 255, "center pixel must stay opaque alpha=255")
    }
    None => debug_assert(false, "parse_fvpoly returned None")
  }
}

test "stage11f: feed_bodies coalesces live canvas bursts and SetImage same-cid skips CSS relayout" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(640.0)
  let host = TestHost::new(
    "<!doctype html><html><body style='margin:0'><canvas id='c' width='4' height='4' style='display:block;width:64px;height:64px'></canvas></body></html>",
    "",
  )
  let t = shown(stage, wide)
  stage.opened()
  let canvas_el = must(find_el(host.doc, "c"))
  canvas_el.src_url = Some("fvcanvas:1/1")
  let png_bytes = pixels::png(4, 4, Bytes::new(4 * 4 * 4))
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:1/1", 0, 4.0, 4.0, png_bytes)))
  stage.feed(host.reset())
  t.run_for(shown_ms)
  let layouts0 = stage.layout_count()

  // Feed a batch of 5 live canvas frames + matching SetImage patches via feed_bodies:
  // earlier Asset frames are coalesced and same-size SetImage skips full CSS relayout.
  let bodies : Array[Bytes] = []
  let mut v = 2
  while v <= 6 {
    let u = "fvcanvas:1/" + v.to_string()
    let a = proto::encode_host(proto::HostMsg::Asset(u, 0, 4.0, 4.0, png_bytes))
    bodies.push(a.slice(4, a.length()))
    let p = proto::encode_host(proto::HostMsg::Patch(v, 0, [proto::PatchOp::SetImage(canvas_el.uid, Some(u), None)]))
    bodies.push(p.slice(4, p.length()))
    v += 1
  }
  stage.feed_bodies(bodies)
  t.frame(ms=16.0)
  debug_assert(stage.layout_count() == layouts0, "same-size live canvas SetImage burst must trigger 0 CSS relayouts, got " + (stage.layout_count() - layouts0).to_string())
  match stage.picture("fvcanvas:1/6", want_px=128) {
    Some((src, _, _)) => debug_assert(src == "fvpic:fvcanvas:1/6", "latest coalesced frame must be fvcanvas:1/6, got " + src)
    None => debug_assert(false, "expected picture for fvcanvas:1/6")
  }
  t.dispose()
}

test "stage11g: budgeted SVG queue defers rasterization and encodes bit-exact green PNG" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  stage.set_svg_budgeted(true)
  let svg_xml = "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32'><rect width='32' height='32' fill='#11aa44'/></svg>".to_bytes()
  stage.feed(proto::encode_host(proto::HostMsg::Asset("https://example.test/icon.svg", 0, 32.0, 32.0, svg_xml)))
  // Requesting picture enqueues rasterization instead of blocking synchronously inside view_frame
  let p0 = stage.picture("https://example.test/icon.svg", want_px=64)
  debug_assert(p0.is_none(), "initial picture before pump_svg_queue returns None")
  debug_assert(stage.svg_raster_pending(), "svg_raster_pending must be true while queued")
  // Drain the queue and verify the produced PNG decodes to exact green pixels
  let more = stage.pump_svg_queue(50.0)
  debug_assert(!more && !stage.svg_raster_pending(), "queue must be drained")
  match stage.picture("https://example.test/icon.svg", want_px=64) {
    Some((src, _, cap)) => {
      debug_assert(src == "fvpic:https://example.test/icon.svg" && cap == 64, "pumped SVG resolves as raster image")
      match ui::image_bytes_for(src) {
        Some(png_bytes) => match raster::decode_image(png_bytes) {
          Some((w, h, rgba)) => {
            debug_assert(w == 64 && h == 64 && rgba.length() == 64 * 64 * 4, "decoded SVG PNG is 64x64")
            let mid = (32 * 64 + 32) * 4
            let r = rgba[mid].to_int() & 0xFF
            let g = rgba[mid + 1].to_int() & 0xFF
            let b = rgba[mid + 2].to_int() & 0xFF
            let a = rgba[mid + 3].to_int() & 0xFF
            debug_assert(r == 0x11 && g == 0xAA && b == 0x44 && a == 0xFF, "pixel must be #11aa44ff, got " + r.to_string() + "," + g.to_string() + "," + b.to_string() + "," + a.to_string())
          }
          None => debug_assert(false, "encoded SVG PNG failed to decode")
        }
        None => debug_assert(false, "ui::image_bytes_for missing for pumped SVG")
      }
    }
    None => debug_assert(false, "expected Some after pump_svg_queue")
  }
}
