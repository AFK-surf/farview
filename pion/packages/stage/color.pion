///| Native `<input type="color">` interactive 24-swatch picker popup.
///| 1:1 port of `client/src/stage/color.mbt`.

import "html"
import "css"
import "proto"
import "view"

let color_corner : Double = 10.0
let color_pad : Double = 10.0
let color_swatch : Double = 26.0
let color_gap : Double = 4.0
let color_panel_w : Double = 196.0
let color_panel_h : Double = 170.0
let color_room : Double = 8.0

let color_palette : Array[(String, Int64)] = [
  ("#ef4444", 0xEF4444FFL),
  ("#f97316", 0xF97316FFL),
  ("#eab308", 0xEAB308FFL),
  ("#22c55e", 0x22C55EFFL),
  ("#06b6d4", 0x06B6D4FFL),
  ("#2563eb", 0x2563EBFFL),
  ("#b91c1c", 0xB91C1CFFL),
  ("#c2410c", 0xC2410CFFL),
  ("#a16207", 0xA16207FFL),
  ("#15803d", 0x15803DFFL),
  ("#0e7490", 0x0E7490FFL),
  ("#1d4ed8", 0x1D4ED8FFL),
  ("#6366f1", 0x6366F1FFL),
  ("#8b5cf6", 0x8B5CF6FFL),
  ("#a855f7", 0xA855F7FFL),
  ("#ec4899", 0xEC4899FFL),
  ("#f43f5e", 0xF43F5EFFL),
  ("#14b8a6", 0x14B8A6FFL),
  ("#000000", 0x000000FFL),
  ("#1e293b", 0x1E293BFFL),
  ("#475569", 0x475569FFL),
  ("#94a3b8", 0x94A3B8FFL),
  ("#cbd5e1", 0xCBD5E1FFL),
  ("#ffffff", 0xFFFFFFFFL),
]

fn st_ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
    i += 1
  }
  sb.to_string()
}

fn dmax(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

fn dmin(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

fn imax(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

fn imin(a : Int, b : Int) -> Int {
  if a < b { a } else { b }
}

fn is_color(n : html::Node) -> Bool {
  if !(n.kind is html::Kind::Element) || n.tag != "input" {
    return false
  }
  let ty = match n.attr("type") {
    Some(t) => st_ascii_lower(t)
    None => ""
  }
  if ty != "color" || n.attr("disabled").is_some() {
    return false
  }
  let mut cur = n.parent
  while true {
    match cur {
      Some(p) => {
        if p.kind is html::Kind::Element && p.tag == "fieldset" && p.attr("disabled").is_some() {
          return false
        }
        cur = p.parent
      }
      None => break
    }
  }
  true
}

fn color_hex_of(el : html::Node) -> String {
  let raw = st_ascii_lower(html::control_value(el).trim())
  if raw.length() == 7 && raw.starts_with("#") {
    raw
  } else {
    "#000000"
  }
}

fn color_rgba_of(hex : String) -> Int64 {
  match css::parse_color(css::tokenize(hex), 0x000000FF) {
    Some(c) =>
    (c.r.to_int64() << 24) |
    (c.g.to_int64() << 16) |
    (c.b.to_int64() << 8) |
    0xFFL
    None => 0x000000FFL
  }
}

fn Stage::pick_color(self : Stage, el : html::Node, hex : String) -> Unit {
  self.color_open.set(None)
  self.doc.set_value(el, hex)
  self.seq += 1
  self.typed.set(el.wire_id, (self.seq, hex))
  self.out(proto::ClientMsg::EditInput(self.seq, el.wire_id, hex, 0, 0, proto::EDIT_INPUT))
  self.seq += 1
  self.typed.set(el.wire_id, (self.seq, hex))
  self.out(proto::ClientMsg::EditInput(self.seq, el.wire_id, hex, 0, 0, proto::EDIT_CHANGE))
  self.changed.set(self.changed.untracked() + 1)
}

fn color_picker(o : view::View, stage : Stage, el : html::Node) -> Unit {
  let cur_hex = color_hex_of(el)
  let cur_rgba = color_rgba_of(cur_hex)
  let at = fn() -> (Double, Double) {
    let _ = stage.changed.get()
    let page_y = stage.page_at(o.tree)
    let (x, y, _, h) = match stage.shown_rect(el, page_y) {
      Some(r) => r
      None => (0.0, 0.0, 44.0, 23.0)
    }
    let room_w = dmax(stage.layout_w.get(), stage.size.get().0)
    let room_h = dmax(stage.room.1, stage.layout_h.get())
    let below = y + h + 4.0
    let over = below + color_panel_h + color_room > page_y + room_h &&
    y - page_y > page_y + room_h - (y + h)
    let top = if over {
      dmax(y - 4.0 - color_panel_h, page_y + color_room)
    } else {
      dmin(below, dmax(page_y + room_h - color_panel_h - color_room, page_y + color_room))
    }
    let max_left = dmax(room_w - color_panel_w - color_room, color_room)
    let left = dmin(dmax(x, color_room), max_left)
    (left, top)
  }
  let _ = o.box(fn(panel : view::View) -> Unit {
    let _ = panel
    .over(view::Live::Is(true))
    .offset(view::Live::By(fn() -> (Double, Double) { at() }))
    .width(view::Live::Is(Some(color_panel_w)))
    .height(view::Live::Is(Some(color_panel_h)))
    .ground(view::Live::Is(0xFFFFFFFFL))
    .radius(view::Live::Is(color_corner))
    .edge(view::Live::Is((1.0, 0x0000001FL)))
    .shadow(view::Live::Is((8.0, 4.0, 0x00000033L)))
    .pad(view::Live::Is(color_pad))
    .gap(view::Live::Is(8.0))
    .clips(view::Live::Is(true))
    .on_press(fn() -> Unit { () })
    let _ = panel.box(fn(grid : view::View) -> Unit {
      let _ = grid.gap(view::Live::Is(color_gap))
      let mut row_i = 0
      while row_i < 4 {
        let ri = row_i
        let _ = grid.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(color_gap))
          let mut col_i = 0
          while col_i < 6 {
            let (hex, rgba) = color_palette[ri * 6 + col_i]
            let selected = hex == cur_hex
            let _ = row.box(fn(cell : view::View) -> Unit {
              let _ = cell
              .width(view::Live::Is(Some(color_swatch)))
              .height(view::Live::Is(Some(color_swatch)))
              .radius(view::Live::Is(5.0))
              .clips(view::Live::Is(true))
              .cursor(view::Live::Is(Some(view::Cursor::Hand)))
              .on_press(fn() -> Unit { stage.pick_color(el, hex) })
              if selected {
                let _ = cell.ground(view::Live::Is(0xFFFFFFFFL)).edge(view::Live::Is((2.0, 0x0F172AFFL))).pad(view::Live::Is(3.0))
                let _ = cell.box(fn(inner : view::View) -> Unit {
                  let _ = inner
                  .grow(view::Live::Is(1.0))
                  .width(view::Live::Is(Some(color_swatch - 6.0)))
                  .height(view::Live::Is(Some(color_swatch - 6.0)))
                  .ground(view::Live::Is(rgba))
                  .radius(view::Live::Is(2.5))
                })
              } else {
                let _ = cell.ground(view::Live::Is(rgba)).edge(view::Live::Is((1.0, 0x00000022L)))
              }
            })
            col_i += 1
          }
        })
        row_i += 1
      }
    })
    let _ = panel.box(fn(foot : view::View) -> Unit {
      let _ = foot
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(8.0))
      .height(view::Live::Is(Some(26.0)))
      .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
      .ground(view::Live::Is(0xF8FAFCFFL))
      .radius(view::Live::Is(5.0))
      .edge(view::Live::Is((1.0, 0xE2E8F0FFL)))
      let _ = foot.box(fn(dot : view::View) -> Unit {
        let _ = dot
        .width(view::Live::Is(Some(14.0)))
        .height(view::Live::Is(Some(14.0)))
        .ground(view::Live::Is(cur_rgba))
        .radius(view::Live::Is(3.0))
        .edge(view::Live::Is((1.0, 0x00000022L)))
      })
      let _ = foot.box(fn(lbl : view::View) -> Unit {
        let _ = lbl.words(
          view::Live::Is(cur_hex),
          ink=0x0F172AFFL,
          look=view::WordsLook::{
            size: 12.0,
            weight: 500,
            line: 16.0,
            wrap: false,
            tracking: view::Spacing::Points(0.0),
            balance: false,
            max_lines: 1,
          },
        )
      })
    })
  })
}
