///| 1:1 port of `client/src/stage/stage23_wbtest.mbt` (4 tests).

import "html"
import "proto"
import "signals"
import "ui"

test "stage23a: pure Pion Gregorian calendar math is exact across leap years and month boundaries" {
  debug_assert(is_leap_year(2024), "2024 leap")
  debug_assert(!is_leap_year(2026), "2026 non-leap")
  debug_assert(!is_leap_year(1900), "1900 non-leap")
  debug_assert(is_leap_year(2000), "2000 leap")
  debug_assert(days_in_month(2024, 2) == 29, "2024-02 == 29")
  debug_assert(days_in_month(2026, 2) == 28, "2026-02 == 28")
  debug_assert(days_in_month(2026, 11) == 30, "2026-11 == 30")
  debug_assert(weekday_of(2026, 11, 1) == 0, "2026-11-01 Sunday")
  debug_assert(weekday_of(2026, 11, 21) == 6, "2026-11-21 Saturday")
  debug_assert(weekday_of(2026, 12, 1) == 2, "2026-12-01 Tuesday")
  match parse_ymd("2026-11-21") {
    Some((y, m, d)) => debug_assert(y == 2026 && m == 11 && d == 21, "parse 2026-11-21")
    None => debug_assert(false, "parse 2026-11-21")
  }
  debug_assert(parse_ymd("2026-02-29").is_none(), "2026-02-29 invalid")
  match parse_ymd("2024-02-29") {
    Some((y, m, d)) => debug_assert(y == 2024 && m == 2 && d == 29, "parse 2024-02-29")
    None => debug_assert(false, "parse 2024-02-29")
  }
  debug_assert(format_ymd(2026, 3, 5) == "2026-03-05", "format_ymd")
  let cells = month_cells(2026, 12)
  debug_assert(cells.length() == 42, "42 cells")
  let (d0, c0in) = cells[0]
  let (c0y, c0m, c0d) = d0
  let (d2, c2in) = cells[2]
  let (c2y, c2m, c2d) = d2
  let (d16, c16in) = cells[16]
  let (c16y, c16m, c16d) = d16
  debug_assert(c0y == 2026 && c0m == 11 && c0d == 29 && !c0in, "cell 0")
  debug_assert(c2y == 2026 && c2m == 12 && c2d == 1 && c2in, "cell 2")
  debug_assert(c16y == 2026 && c16m == 12 && c16d == 15 && c16in, "cell 16")
}

test "stage23a: native <input type=date> calendar opens, navigates months, respects min/max, picks/clears/today" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=d1 type=date value=\"2026-11-21\" min=\"2026-11-05\" max=\"2026-12-20\">" +
    "<input id=d2 type=date value=\"2026-11-21\" disabled></body></html>",
    "body { margin: 0 } input { display: block; width: 180px; height: 32px; margin: 10px }",
  )
  let t = shown_with_keys(stage, wide)
  t.set_wall(1795003200000.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let d1 = must(find_el(must(stage.doc.root()), "d1"))
  t.tap(40.0, 66.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_none(), "disabled date does not open")
  t.tap(40.0, 24.0)
  t.frame(ms=frame_ms)
  match stage.date_open.untracked() {
    Some(n) => debug_assert(n.wire_id == d1.wire_id, "d1 calendar opened")
    None => debug_assert(false, "expected d1 calendar")
  }
  let has_word = fn(s : String) -> Bool {
    for w in t.drawn_words_found() {
      if w.1 == s { return true }
    }
    false
  }
  debug_assert(has_word("2026-11"), "shows 2026-11")
  debug_assert(has_word("Clear"), "shows Clear")
  debug_assert(has_word("Today"), "shows Today")
  t.tap(36.0, 130.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_some(), "disabled day keeps calendar open")
  debug_assert(html::control_value(d1) == "2026-11-21", "value unchanged on disabled day")
  t.tap(242.0, 70.0)
  t.frame(ms=frame_ms)
  debug_assert(has_word("2026-12"), "navigated to 2026-12")
  sent.clear()
  t.tap(104.0, 190.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_none(), "picking Dec 15 closed calendar")
  debug_assert(html::control_value(d1) == "2026-12-15", "value is 2026-12-15")
  let edits : Array[(String, Int)] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, id, v, _, _, k) => if id == d1.wire_id { edits.push((v, k)) }
      _ => ()
    }
  }
  debug_assert(edits.length() == 2 && edits[0].0 == "2026-12-15" && edits[0].1 == proto::EDIT_INPUT && edits[1].0 == "2026-12-15" && edits[1].1 == proto::EDIT_CHANGE, "INPUT + CHANGE emitted")
  t.tap(40.0, 24.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_some(), "re-opened calendar")
  sent.clear()
  t.tap(46.0, 316.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_none(), "Clear closed calendar")
  debug_assert(html::control_value(d1) == "", "Clear emptied value")
  t.tap(40.0, 24.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_some(), "re-opened calendar for Escape")
  t.key(17, mods=0)
  t.frame(ms=frame_ms)
  debug_assert(stage.date_open.untracked().is_none(), "Escape closed calendar")
  t.dispose()
}

test "stage23a: native <input type=number> stepper buttons and ArrowUp/ArrowDown respect step/min/max" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=n1 type=number value=4 min=0 max=8 step=2></body></html>",
    "body { margin: 0 } input { display: block; width: 160px; height: 32px; margin: 10px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let n1 = must(find_el(must(stage.doc.root()), "n1"))
  sent.clear()
  t.tap(160.0, 18.0)
  t.frame(ms=frame_ms)
  debug_assert(html::control_value(n1) == "6", "stepper up -> 6")
  let up_edits : Array[(String, Int)] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, id, v, _, _, k) => if id == n1.wire_id { up_edits.push((v, k)) }
      _ => ()
    }
  }
  debug_assert(up_edits.length() == 2 && up_edits[0].0 == "6" && up_edits[0].1 == proto::EDIT_INPUT && up_edits[1].0 == "6" && up_edits[1].1 == proto::EDIT_CHANGE, "stepper emitted INPUT + CHANGE")
  t.tap(160.0, 18.0)
  t.frame(ms=frame_ms)
  debug_assert(html::control_value(n1) == "8", "stepper up -> 8")
  t.tap(160.0, 18.0)
  t.frame(ms=frame_ms)
  debug_assert(html::control_value(n1) == "8", "stepper clamped at max 8")
  t.tap(160.0, 34.0)
  t.frame(ms=frame_ms)
  debug_assert(html::control_value(n1) == "6", "stepper down -> 6")
  t.tap(40.0, 24.0)
  t.frame(ms=frame_ms)
  match stage.field.untracked() {
    Some(e) => debug_assert(e.node.wire_id == n1.wire_id, "number field focused")
    None => debug_assert(false, "expected number field")
  }
  t.key(5, mods=0)
  t.frame(ms=frame_ms)
  debug_assert(html::control_value(n1) == "8", "ArrowUp -> 8")
  t.key(6, mods=0)
  t.frame(ms=frame_ms)
  debug_assert(html::control_value(n1) == "6", "ArrowDown -> 6")
  t.dispose()
}

test "stage23a: PatchOp::Validation renders native bubble and clears on typing, Escape, tap, or Reset" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(360.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=req1 type=email required placeholder=\"name@example.com\"></body></html>",
    "body { margin: 0 } input { display: block; width: 220px; height: 32px; margin: 12px }",
  )
  let t = shown_with_keys(stage, wide, h=640.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let req1_host = must(find_el(host.doc, "req1"))
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(host.patch(0, more=[proto::PatchOp::Focus(req1_host.uid), proto::PatchOp::Validation(req1_host.uid, "Please fill out this field.")]))
  })
  t.frame(ms=frame_ms)
  let tip1 = stage.validation_tip.untracked()
  debug_assert(tip1.0 == req1_host.uid && tip1.1 == "Please fill out this field.", "validation_tip set")
  let has_tip = fn(msg : String) -> Bool {
    for w in t.drawn_words_found() {
      if str_has_sub(w.1, msg) { return true }
    }
    false
  }
  debug_assert(has_tip("Please fill out this field."), "validation bubble drawn")
  t.key(17, mods=0)
  t.frame(ms=frame_ms)
  debug_assert(stage.validation_tip.untracked().0 == 0 && stage.validation_tip.untracked().1 == "", "Escape dismissed bubble")
  debug_assert(!has_tip("Please fill out this field."), "bubble words gone")
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(host.patch(0, more=[proto::PatchOp::Validation(req1_host.uid, "Please enter a valid value.")]))
  })
  t.frame(ms=frame_ms)
  debug_assert(has_tip("Please enter a valid value."), "second validation bubble drawn")
  t.tap(10.0, 200.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.validation_tip.untracked().0 == 0, "tap dismissed bubble")
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(host.patch(0, more=[proto::PatchOp::Validation(req1_host.uid, "Custom error")]))
  })
  t.frame(ms=frame_ms)
  debug_assert(stage.validation_tip.untracked().0 == req1_host.uid, "third validation bubble set")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.frame(ms=frame_ms)
  debug_assert(stage.validation_tip.untracked().0 == 0, "Reset dismissed bubble")
  t.dispose()
}
