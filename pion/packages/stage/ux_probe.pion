///| Read-only probes for the UX flow driver (`pion/cmd/app/ux_flows.pion`, `tools/ux_flows.sh`): where the page's
///| links are as this client laid them out (what the person sees and clicks), where the page's viewport sits in the
///| window, and what this client's own hit test finds at a point. Nothing here changes the stage.

///| A link as laid out here: its address (resolved as a click resolves it), its words, and its border box in the
///| viewport's CSS pixels (scroll already taken off; a fixed one where it stays).
pub struct UxLink {
  pub href : String
  pub words : String
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
}

///| The window rectangle (points) of the page's viewport node, once it has been drawn.
pub fn Stage::ux_view_rect(self : Stage) -> Option[(Double, Double, Double, Double)] {
  match self.node {
    Some(v) => match v.tree.drawn_of(v.id()) {
      Some(d) => Some((d.x, d.y, d.w, d.h))
      None => None
    }
    None => None
  }
}

///| The vertical scroll in CSS pixels as the last pointer/scroll handling saw it.
pub fn Stage::ux_page_y(self : Stage) -> Double {
  self.page_y
}

fn ux_words(n : html::Node, out : Array[String], left : Array[Int]) -> Unit {
  if left[0] <= 0 {
    return
  }
  if n.kind is html::Kind::Text {
    let t = n.data.trim()
    if t != "" {
      out.push(t)
      left[0] = left[0] - t.length()
    }
    return
  }
  for c in n.children {
    ux_words(c, out, left)
  }
}

fn Stage::ux_walk(self : Stage, n : html::Node, out : Array[UxLink], limit : Int) -> Unit {
  if out.length() >= limit {
    return
  }
  if n.kind is html::Kind::Element {
    if n.tag == "head" || n.tag == "script" || n.tag == "style" || n.tag == "template" {
      return
    }
    if n.tag == "a" && n.attr("href") is Some(_) {
      let href = self.hover_link_url(Some(n))
      match self.shown_rect(n, self.page_y) {
        Some((x, y, w, h)) => if w >= 4.0 && h >= 4.0 {
          let ws : Array[String] = []
          ux_words(n, ws, [80])
          out.push(UxLink::{ href, words: ws.join(" "), x, y: y - self.page_y, w, h })
        }
        None => ()
      }
    }
  }
  for c in n.children {
    self.ux_walk(c, out, limit)
  }
}

///| The page's links as laid out here, in document order (at most `limit`).
pub fn Stage::ux_links(self : Stage, limit~ : Int = 600) -> Array[UxLink] {
  let out : Array[UxLink] = []
  match self.doc.root() {
    Some(r) => self.ux_walk(r, out, limit)
    None => ()
  }
  out
}

///| What this client's own hit test finds at a viewport point (CSS pixels): `tag#id` and the link it is in, if any.
pub fn Stage::ux_hit(self : Stage, x : Double, y : Double) -> String {
  match self.element_at(x, y + self.page_y) {
    Some((el, _, _)) => {
      let id = match el.attr("id") {
        Some(v) => "#" + v
        None => ""
      }
      el.tag + id + " -> " + self.hover_link_url(Some(el))
    }
    None => "(nothing)"
  }
}

///| How many layouts this stage ran and the size of the laid-out page (CSS pixels): a new page's first layout shows
///| as the count going up after its address came.
pub fn Stage::ux_page_size(self : Stage) -> (Double, Double) {
  self.size.untracked()
}

///| The pointer's shape this stage asks for where the pointer last was (`view::cursor_code`; -1: none asked, the
///| window's own arrow).
pub fn Stage::ux_cursor(self : Stage) -> Int {
  match self.cursor.untracked() {
    Some(c) => view::cursor_code(c)
    None => -1
  }
}
