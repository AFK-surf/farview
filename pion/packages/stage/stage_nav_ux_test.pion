///| A link's click as a person feels it: loading shown in the frame of the press (not once the host has the next page),
///| a press held long with the mouse still a click, the pointer's hand over a link.

import "proto"
import "signals"
import "ui"
import "view"

fn nav_ux_page() -> TestHost {
  TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<a id=a1 href=/next>Next</a><a id=a2 href=#sec>Hash</a><div id=plain>Plain</div></body></html>",
    "body { margin: 0 } a, div { display: block; width: 200px; height: 40px }",
  )
}

fn ups(sent : Array[Bytes]) -> Int {
  let mut n = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, k, _, _, _, _, _, _, _) => if k == proto::POINTER_UP { n += 1 }
      _ => ()
    }
  }
  n
}

test "nav ux: a link tap shows loading at once; the host's answer, a new document or a timeout clears it" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = nav_ux_page()
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  debug_assert(!stage.loading(), "not loading once shown")
  sent.clear()
  t.tap(50.0, 20.0)
  debug_assert(ups(sent) == 1, "the tap reached the page")
  debug_assert(stage.loading() && stage.pending_nav() == "https://t.test/next", "loading shown in the frame of the tap")
  // pressed again while on its way: the same navigation, nothing more sent
  sent.clear()
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(ups(sent) == 0, "a second press of the loading link is not sent")
  // the host answered that input and nothing loads: the page took the click itself
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(1000)) })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "an answered click with nothing loading clears it")
  // the host says it loads, then the next document comes
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(stage.loading(), "loading again")
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(proto::encode_host(proto::HostMsg::Meta("", "", true, false, false)))
  })
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(1000)) })
  t.frame(ms=frame_ms)
  debug_assert(stage.loading(), "the host loading keeps it")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(proto::encode_host(proto::HostMsg::Meta("https://t.test/next", "", false, false, false)))
  })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "the next document clears it")
  // a same-page fragment link does not load
  t.frame(ms=500.0)
  t.tap(50.0, 60.0)
  debug_assert(!stage.loading(), "a #fragment link does not show loading")
  // nothing answers: 10 s later it is gone
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(stage.loading(), "loading for a third tap")
  t.run_for(10200.0)
  debug_assert(!stage.loading(), "cleared after 10 s with no answer")
  t.dispose()
}

test "nav ux: a mouse press held past the hold is still a click; the pointer is a hand over a link" {
  ui::set_pointing(Some(ui::Pointing::Mouse))
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = nav_ux_page()
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  match ui::view_tree() {
    Some(tree) => {
      t.move_to(50.0, 20.0)
      t.frame(ms=frame_ms)
      let over = match tree.target_at(50.0, 20.0) {
        view::Target::Dragged(id) => tree.cursor_of(id)
        _ => view::Cursor::Arrow
      }
      debug_assert(over == view::Cursor::Hand, "the hand over a link, on the node the pointer is over")
      sent.clear()
      match tree.target_at(50.0, 20.0) {
        view::Target::Dragged(id) => {
          let _ = tree.drag_at(id, view::DragIs::Down, 50.0, 20.0, t.inner.fake.now_ms)
          t.run_for(700.0)
          let _ = tree.drag_at(id, view::DragIs::Up, 50.0, 20.0, t.inner.fake.now_ms)
          t.frame(ms=frame_ms)
        }
        _ => debug_assert(false, "the page takes the press")
      }
      debug_assert(ups(sent) == 1, "a 700 ms mouse press on a link is a click")
      debug_assert(stage.loading(), "and it shows loading")
    }
    None => debug_assert(false, "a tree")
  }
  ui::set_pointing(None)
  t.dispose()
}

test "nav ux: a long page makes view nodes only near what shows, and more as it scrolls" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let body = StringBuilder::new()
  let mut i = 0
  while i < 400 {
    body.write_string("<p>Paragraph \{i}</p>")
    i += 1
  }
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" + body.to_string() + "</body></html>",
    "body { margin: 0 } p { margin: 0; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  leaves_made[0] = 0
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let first = leaves_made[0]
  debug_assert(first > 10 && first < 120, "only the band near the top is made (\{first} of 400 paragraphs)")
  stage.set_scroll_y(14000.0)
  t.run_for(shown_ms)
  debug_assert(leaves_made[0] > first + 10, "scrolled far down: the band there is made")
  t.dispose()
}
