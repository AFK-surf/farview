///| A link's click as a person feels it: loading shown in the frame of the press (not once the host has the next page)
///| and ended by the host's answer to that input, a press held long with the mouse still a click, the pointer's hand
///| over a link; a new document shown from where the host says; only what is near the viewport made as view nodes.

import "proto"
import "signals"
import "ui"
import "view"

fn nav_ux_page() -> TestHost {
  TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<a id=a1 href=/next>Next</a><a id=a2 href=#sec>Hash</a><div id=plain>Plain</div></body></html>",
    "body { margin: 0 } a, div { display: block; width: 200px; height: 40px }",
  )
}

fn ups(sent : Array[Bytes]) -> Int {
  let mut n = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, k, _, _, _, _, _, _, _) => if k == proto::POINTER_UP { n += 1 }
      _ => ()
    }
  }
  n
}

test "nav ux: a link tap shows loading at once; the host's answer or a new document clears it, no timer" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = nav_ux_page()
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  debug_assert(!stage.loading(), "not loading once shown")
  sent.clear()
  t.tap(50.0, 20.0)
  debug_assert(ups(sent) == 1, "the tap reached the page")
  debug_assert(stage.loading() && stage.pending_nav() == "https://t.test/next", "loading shown in the frame of the tap")
  // pressed again while on its way: the same navigation, nothing more sent
  sent.clear()
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(ups(sent) == 0, "a second press of the loading link is not sent")
  // the host answered that input and nothing loads: the page took the click itself
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(1000)) })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "an answered click with nothing loading clears it")
  // the host says it loads, then the next document comes
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(stage.loading(), "loading again")
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(proto::encode_host(proto::HostMsg::Meta("", "", true, false, false)))
  })
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(1000)) })
  t.frame(ms=frame_ms)
  debug_assert(stage.loading(), "the host loading keeps it")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(proto::encode_host(proto::HostMsg::Meta("https://t.test/next", "", false, false, false)))
  })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "the next document clears it")
  // a same-page fragment link does not load
  t.frame(ms=500.0)
  t.tap(50.0, 60.0)
  debug_assert(!stage.loading(), "a #fragment link does not show loading")
  // no timer stands in for the host's answer: unanswered, it stays (a host that does not answer is not hidden)
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(stage.loading(), "loading for a third tap")
  t.run_for(12000.0)
  debug_assert(stage.loading(), "still loading 12 s on with no answer: no fallback timeout")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(1000)) })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "the answer clears it")
  t.dispose()
}

fn nav_ats(sent : Array[Bytes]) -> Array[(Int, Int, String)] {
  let out : Array[(Int, Int, String)] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::NavAt(seq, kind, u) => out.push((seq, kind, u))
      _ => ()
    }
  }
  out
}

test "nav ux: go/back/reload go with an input seq; the host's ack of it (a declined one too) ends the loading" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = nav_ux_page()
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(proto::encode_host(proto::HostMsg::Meta("https://t.test/", "", false, true, false)))
  })
  t.run_for(shown_ms)
  sent.clear()
  // an address that is not a page: the host stays, and acknowledges it
  stage.go("mailto:a@b.test")
  let navs = nav_ats(sent)
  debug_assert(navs.length() == 1 && navs[0].1 == proto::NAV_GO, "the go is a NavAt")
  let go_seq = navs[0].0
  debug_assert(stage.loading(), "loading shown for the go")
  // a Patch for an earlier input leaves it
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(go_seq - 1)) })
  t.frame(ms=frame_ms)
  debug_assert(stage.loading(), "an older ack does not answer it")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(go_seq)) })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "the ack of the declined go ends it")
  // Back: shown loading; while it is on its way a link to this page's own address is still pressable
  sent.clear()
  stage.back()
  let back = nav_ats(sent)
  debug_assert(back.length() == 1 && back[0].1 == proto::NAV_BACK && back[0].0 > go_seq, "Back is a NavAt with a later seq")
  debug_assert(stage.loading(), "Back shows loading")
  sent.clear()
  t.frame(ms=500.0)
  t.tap(50.0, 20.0)
  debug_assert(ups(sent) == 1, "a link pressed during Back is sent (only the same link's own repeat is dropped)")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.frame(ms=frame_ms)
  debug_assert(!stage.loading(), "the next document ends it")
  // with no entry back there, nothing is shown loading, and the NavAt still goes
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(proto::encode_host(proto::HostMsg::Meta("https://t.test/", "", false, false, false)))
  })
  t.frame(ms=frame_ms)
  sent.clear()
  stage.back()
  debug_assert(nav_ats(sent).length() == 1 && !stage.loading(), "no entry back: sent, not shown loading")
  // a lost connection ends it too
  stage.reload()
  debug_assert(stage.loading(), "Reload shows loading")
  stage.closed()
  debug_assert(!stage.loading(), "the connection gone: no answer is coming")
  t.dispose()
}

test "nav ux: a new document's ScrollTo after its Reset shows it from there (Back to where it was, a #fragment)" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let body = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    body.write_string("<p>Paragraph \{i}</p>")
    i += 1
  }
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" + body.to_string() + "</body></html>",
    "body { margin: 0 } p { margin: 0; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  // the host's first send for a document is its Reset, the place it is shown from in the Patch right after it
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(host.reset())
    stage.feed(host.patch(0, more=[proto::PatchOp::ScrollTo(0, 0.0, 2400.0)]))
  })
  t.run_for(shown_ms)
  let y = stage.scroll_y()
  debug_assert((y - 2400.0).abs() < 1.0, "shown from 2400 px, got \{y}")
  // the next document: from its top unless told otherwise
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  debug_assert(stage.scroll_y() < 1.0, "a new document from its top, got \{stage.scroll_y()}")
  t.dispose()
}

test "nav ux: a page's own new-tab asks (OpenTab) are not the person's link opens" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = nav_ux_page()
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let before = stage.link_opens().0
  ui::answered_from_outside(fn() -> Unit { stage.feed(proto::encode_host(proto::HostMsg::OpenTab("https://t.test/popup"))) })
  t.frame(ms=frame_ms)
  debug_assert(stage.opens_seq().0 == 1 && stage.opens_seq().1 == "https://t.test/popup", "the page's ask is told as the page's")
  debug_assert(stage.link_opens().0 == before, "and is not a link the person opened: the app opens no tab for it")
  t.hold_mods(8)
  t.tap(50.0, 20.0)
  t.frame(ms=frame_ms)
  t.hold_mods(0)
  let (n, u, front) = stage.link_opens()
  debug_assert(n == before + 1 && u == "https://t.test/next" && !front, "a Cmd+click is the person's, behind")
  t.dispose()
}

test "nav ux: a mouse press held past the hold is still a click; the pointer is a hand over a link" {
  ui::set_pointing(Some(ui::Pointing::Mouse))
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = nav_ux_page()
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  match ui::view_tree() {
    Some(tree) => {
      t.move_to(50.0, 20.0)
      t.frame(ms=frame_ms)
      let over = match tree.target_at(50.0, 20.0) {
        view::Target::Dragged(id) => tree.cursor_of(id)
        _ => view::Cursor::Arrow
      }
      debug_assert(over == view::Cursor::Hand, "the hand over a link, on the node the pointer is over")
      sent.clear()
      match tree.target_at(50.0, 20.0) {
        view::Target::Dragged(id) => {
          let _ = tree.drag_at(id, view::DragIs::Down, 50.0, 20.0, t.inner.fake.now_ms)
          t.run_for(700.0)
          let _ = tree.drag_at(id, view::DragIs::Up, 50.0, 20.0, t.inner.fake.now_ms)
          t.frame(ms=frame_ms)
        }
        _ => debug_assert(false, "the page takes the press")
      }
      debug_assert(ups(sent) == 1, "a 700 ms mouse press on a link is a click")
      debug_assert(stage.loading(), "and it shows loading")
    }
    None => debug_assert(false, "a tree")
  }
  ui::set_pointing(None)
  t.dispose()
}

test "nav ux: a long page makes view nodes only near what shows, and more as it scrolls" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let body = StringBuilder::new()
  let mut i = 0
  while i < 400 {
    body.write_string("<p>Paragraph \{i}</p>")
    i += 1
  }
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" + body.to_string() + "</body></html>",
    "body { margin: 0 } p { margin: 0; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  leaves_made[0] = 0
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let first = leaves_made[0]
  debug_assert(first > 10 && first < 120, "only the band near the top is made (\{first} of 400 paragraphs)")
  stage.set_scroll_y(14000.0)
  t.run_for(shown_ms)
  debug_assert(leaves_made[0] > first + 10, "scrolled far down: the band there is made")
  // a scroll by one step of the band makes only that step's worth (a quarter viewport, not a viewport, a frame)
  let step = stage.cull_step()
  let at_step = leaves_made[0]
  stage.set_scroll_y(14000.0 + step)
  t.run_for(shown_ms)
  let made = leaves_made[0] - at_step
  // (`first` is the band at the top: a margin's height and the viewport; a step is a quarter of a margin)
  debug_assert(made > 0 && made * 4 <= first, "one step made \{made} leaves for \{step} px, the band at the top \{first}")
  t.dispose()
}

test "nav ux: a page wrapped in a translate is culled where it shows, not made whole" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let body = StringBuilder::new()
  let mut i = 0
  while i < 400 {
    body.write_string("<p>Paragraph \{i}</p>")
    i += 1
  }
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><div id=wrap>" + body.to_string() +
    "</div></body></html>",
    "body { margin: 0 } #wrap { transform: translateY(400px) } p { margin: 0; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  leaves_made[0] = 0
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let first = leaves_made[0]
  debug_assert(first > 5 && first < 120, "only the band near the top is made inside the translate (\{first} of 400)")
  stage.set_scroll_y(10000.0)
  t.run_for(shown_ms)
  debug_assert(leaves_made[0] > first + 10, "scrolled down: the translated items there are made")
  t.dispose()
}

test "nav ux: the host is told exactly where the page came to rest, not the last 200 px step of the move" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let body = StringBuilder::new()
  let mut i = 0
  while i < 200 {
    body.write_string("<p>Paragraph \{i}</p>")
    i += 1
  }
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" + body.to_string() + "</body></html>",
    "body { margin: 0 } p { margin: 0; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  sent.clear()
  // moved a little at a time, as a wheel's eased notches move it: 30 px a frame to 930
  let mut y = 0.0
  while y < 930.0 {
    y += 30.0
    stage.set_scroll_y(y)
    t.frame(ms=frame_ms)
  }
  let told = fn() -> Array[Double] {
    let out : Array[Double] = []
    for m in said(sent) {
      match m {
        proto::ClientMsg::ScrollSync(0, _, ty) => out.push(ty)
        _ => ()
      }
    }
    out
  }
  let moving = told()
  debug_assert(moving.length() >= 3 && moving.length() <= 6, "told every 200 px while it moves, got \{moving.length()}")
  t.run_for(400.0)
  let all = told()
  let last = if all.length() > 0 { all[all.length() - 1] } else { -1.0 }
  debug_assert((last - 930.0).abs() < 0.5, "at rest: told exactly 930, got \{last}")
  t.dispose()
}
