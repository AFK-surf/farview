///| How often an infinite CSS animation asks for frames: at the display's pace only where it can be seen. A spinner
///| under an `opacity: 0` ancestor (a challenge widget's idle spinner, a loader kept for later) turns at the hidden
///| pace, as one scrolled away does; one seen, or one fading itself, keeps the display's pace; none relays out.

import "signals"

fn anim_frames_in_2s(css : String, body : String) -> (Int, Int) {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let w = signals::signal(640.0)
  let h = TestHost::new("<!doctype html><html><head><style>" + css + "</style></head><body style='margin:0'>" + body + "</body></html>", "")
  let t = shown(stage, w)
  stage.opened()
  stage.feed(h.reset())
  t.run_for(shown_ms)
  let l0 = stage.layout_count()
  let frames = [0]
  t.inner.each_frame(Some(fn() { frames[0] = frames[0] + 1 }))
  t.inner.run_shown(2000.0)
  t.inner.each_frame(None)
  let out = (frames[0], stage.layout_count() - l0)
  t.dispose()
  out
}

test "an infinite spinner under an opacity: 0 ancestor asks for frames at the hidden pace, a seen one at the display's" {
  let kf = "@keyframes rot { from { transform: rotate(0deg) } to { transform: rotate(360deg) } } " +
  "@keyframes pulse { from { opacity: 1 } to { opacity: 0.2 } } " +
  ".s { width: 28px; height: 28px; border: 4px solid blue; border-radius: 50%; animation: rot 1s linear infinite } "
  let (seen, seen_l) = anim_frames_in_2s(kf, "<div class=s></div>")
  let (hidden, hidden_l) = anim_frames_in_2s(kf + ".w { opacity: 0 }", "<div class=w><div class=s></div></div>")
  let (pulse, pulse_l) = anim_frames_in_2s(kf + ".p { width: 20px; height: 20px; background: red; animation: pulse 1s linear infinite alternate }", "<div class=p></div>")
  let (idle, _) = anim_frames_in_2s("", "<div style='width:40px;height:40px;background:red'></div>")
  debug_assert(seen >= 100, "a seen spinner turns at the display's pace, got " + seen.to_string() + " frames in 2 s")
  debug_assert(pulse >= 100, "an element fading itself keeps the display's pace, got " + pulse.to_string() + " frames in 2 s")
  debug_assert(hidden <= 20, "a spinner under opacity: 0 turns at the hidden pace (4 Hz), got " + hidden.to_string() + " frames in 2 s")
  debug_assert(idle == 0, "a still page asks for no frames, got " + idle.to_string())
  debug_assert(seen_l == 0 && hidden_l == 0 && pulse_l == 0, "compositor animations relay nothing out")
}
