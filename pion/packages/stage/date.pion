///| Native `<input type="date">` interactive Gregorian calendar picker popup.
///| 1:1 port of `client/src/stage/date.mbt`.

import "html"
import "proto"
import "signals"
import "hostapi"
import "view"

let date_corner : Double = 10.0
let date_pad : Double = 10.0
let date_cell_w : Double = 32.0
let date_cell_h : Double = 28.0
let date_gap : Double = 2.0
let date_panel_w : Double = 256.0
let date_panel_h : Double = 294.0
let date_room : Double = 8.0

let date_weekdays : Array[String] = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]

fn is_date(n : html::Node) -> Bool {
  if !(n.kind is html::Kind::Element) || n.tag != "input" {
    return false
  }
  let ty = match n.attr("type") {
    Some(t) => st_ascii_lower(t)
    None => ""
  }
  if ty != "date" || n.attr("disabled").is_some() || n.attr("readonly").is_some() {
    return false
  }
  let mut cur = n.parent
  while true {
    match cur {
      Some(p) => {
        if p.kind is html::Kind::Element && p.tag == "fieldset" && p.attr("disabled").is_some() {
          return false
        }
        cur = p.parent
      }
      None => break
    }
  }
  true
}

fn is_leap_year(y : Int) -> Bool {
  (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_in_month(y : Int, m : Int) -> Int {
  match m {
    1 | 3 | 5 | 7 | 8 | 10 | 12 => 31
    4 | 6 | 9 | 11 => 30
    2 => if is_leap_year(y) { 29 } else { 28 }
    _ => 30
  }
}

fn weekday_of(y : Int, m : Int, d : Int) -> Int {
  let t : Array[Int] = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
  let yr = if m < 3 { y - 1 } else { y }
  let w = (yr + yr / 4 - yr / 100 + yr / 400 + t[m - 1] + d) % 7
  if w < 0 { w + 7 } else { w }
}

fn parse_uint_digits(s : String) -> Option[Int] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10 + (c - 48)
    i += 1
  }
  Some(acc)
}

fn split_dash(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || s.code_unit_at(i) == 45 {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i += 1
  }
  out
}

fn parse_ymd(s : String) -> Option[(Int, Int, Int)] {
  let t = s.trim()
  let parts = split_dash(t)
  if parts.length() != 3 || parts[0].length() < 4 || parts[1].length() != 2 || parts[2].length() != 2 {
    return None
  }
  match (parse_uint_digits(parts[0]), parse_uint_digits(parts[1]), parse_uint_digits(parts[2])) {
    (Some(y), Some(m), Some(d)) =>
    if y >= 1 && m >= 1 && m <= 12 && d >= 1 && d <= days_in_month(y, m) {
      Some((y, m, d))
    } else {
      None
    }
    _ => None
  }
}

fn pad2_int(n : Int) -> String {
  if n < 10 { "0" + n.to_string() } else { n.to_string() }
}

fn pad4_int(n : Int) -> String {
  if n < 10 {
    "000" + n.to_string()
  } else if n < 100 {
    "00" + n.to_string()
  } else if n < 1000 {
    "0" + n.to_string()
  } else {
    n.to_string()
  }
}

fn format_ymd(y : Int, m : Int, d : Int) -> String {
  pad4_int(y) + "-" + pad2_int(m) + "-" + pad2_int(d)
}

fn format_ym(y : Int, m : Int) -> String {
  pad4_int(y) + "-" + pad2_int(m)
}

fn ymd_cmp(a : (Int, Int, Int), b : (Int, Int, Int)) -> Int {
  if a.0 != b.0 {
    a.0 - b.0
  } else if a.1 != b.1 {
    a.1 - b.1
  } else {
    a.2 - b.2
  }
}

fn ymd_eq(a : (Int, Int, Int), b : (Int, Int, Int)) -> Bool {
  a.0 == b.0 && a.1 == b.1 && a.2 == b.2
}

fn date_in_range(ymd : (Int, Int, Int), min_d : Option[(Int, Int, Int)], max_d : Option[(Int, Int, Int)]) -> Bool {
  match min_d {
    Some(lo) => if ymd_cmp(ymd, lo) < 0 { return false }
    None => ()
  }
  match max_d {
    Some(hi) => if ymd_cmp(ymd, hi) > 0 { return false }
    None => ()
  }
  true
}

fn shift_ym(y : Int, m : Int, delta : Int) -> (Int, Int) {
  let total = y * 12 + (m - 1) + delta
  if total < 12 {
    return (1, 1)
  }
  let ny = total / 12
  let nm = total % 12 + 1
  (ny, nm)
}

fn today_ymd() -> (Int, Int, Int) {
  let ms = hostapi::wall_ms()
  if ms < 946684800000.0 || ms != ms {
    return (2026, 11, 21)
  }
  let offset_min = hostapi::utc_offset_min(ms)
  let local_ms = ms + offset_min.to_double() * 60000.0
  let days = (local_ms / 86400000.0).floor().to_int()
  let z = days + 719468
  let era = (if z >= 0 { z } else { z - 146096 }) / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = mp + (if mp < 10 { 3 } else { -9 })
  let yr = y + (if m <= 2 { 1 } else { 0 })
  (yr, m, d)
}

fn month_cells(y : Int, m : Int) -> Array[((Int, Int, Int), Bool)] {
  let first_wd = weekday_of(y, m, 1)
  let dim = days_in_month(y, m)
  let (py, pm) = shift_ym(y, m, -1)
  let prev_dim = days_in_month(py, pm)
  let (ny, nm) = shift_ym(y, m, 1)
  let out : Array[((Int, Int, Int), Bool)] = []
  let mut i = 0
  while i < 42 {
    if i < first_wd {
      let d = prev_dim - first_wd + 1 + i
      out.push(((py, pm, d), false))
    } else if i < first_wd + dim {
      out.push(((y, m, i - first_wd + 1), true))
    } else {
      out.push(((ny, nm, i - first_wd - dim + 1), false))
    }
    i += 1
  }
  out
}

fn Stage::pick_date(self : Stage, el : html::Node, value : String) -> Unit {
  self.date_open.set(None)
  if self.validation_tip.untracked().0 != 0 {
    self.validation_tip.set((0, ""))
  }
  self.doc.set_value(el, value)
  self.seq += 1
  self.typed.set(el.wire_id, (self.seq, value))
  self.out(proto::ClientMsg::EditInput(self.seq, el.wire_id, value, 0, 0, proto::EDIT_INPUT))
  self.seq += 1
  self.typed.set(el.wire_id, (self.seq, value))
  self.out(proto::ClientMsg::EditInput(self.seq, el.wire_id, value, 0, 0, proto::EDIT_CHANGE))
  self.changed.set(self.changed.untracked() + 1)
}

fn date_picker(o : view::View, stage : Stage, el : html::Node) -> Unit {
  let today = today_ymd()
  let selected = parse_ymd(html::control_value(el))
  let min_d = match el.attr("min") {
    Some(s) => parse_ymd(s)
    None => None
  }
  let max_d = match el.attr("max") {
    Some(s) => parse_ymd(s)
    None => None
  }
  let init_ym = match selected {
    Some((y, m, _)) => (y, m)
    None => (today.0, today.1)
  }
  let view_ym = signals::signal_by(init_ym, fn(a : (Int, Int), b : (Int, Int)) -> Bool { a.0 == b.0 && a.1 == b.1 })
  let at = fn() -> (Double, Double) {
    let _ = stage.changed.get()
    let page_y = stage.page_at(o.tree)
    let (x, y, _, h) = match stage.viewport_rect(el, page_y) {
      Some(r) => r
      None => (0.0, 0.0, 140.0, 28.0)
    }
    let room_w = dmax(stage.layout_w.get(), stage.size.get().0)
    let room_h = dmax(stage.room.1, stage.layout_h.get())
    let below = y + h + 4.0
    let over = below + date_panel_h + date_room > room_h &&
    y > room_h - (y + h)
    let top = if over {
      dmax(y - 4.0 - date_panel_h, date_room)
    } else {
      dmin(below, dmax(room_h - date_panel_h - date_room, date_room))
    }
    let max_left = dmax(room_w - date_panel_w - date_room, date_room)
    let left = dmin(dmax(x, date_room), max_left)
    (left, top)
  }
  let nav_btn_look = view::WordsLook::{
    size: 15.0, weight: 600, line: 20.0, wrap: false, tracking: view::Spacing::Points(0.0), balance: false, max_lines: 1,
    tabular: None, diagonal_fractions: false,
  }
  let title_look = view::WordsLook::{
    size: 13.0, weight: 600, line: 18.0, wrap: false, tracking: view::Spacing::Points(0.0), balance: false, max_lines: 1,
    tabular: None, diagonal_fractions: false,
  }
  let wd_look = view::WordsLook::{
    size: 11.0, weight: 600, line: 16.0, wrap: false, tracking: view::Spacing::Points(0.0), balance: false, max_lines: 1,
    tabular: None, diagonal_fractions: false,
  }
  let day_look = view::WordsLook::{
    size: 12.0, weight: 500, line: 16.0, wrap: false, tracking: view::Spacing::Points(0.0), balance: false, max_lines: 1,
    tabular: None, diagonal_fractions: false,
  }
  let foot_look = view::WordsLook::{
    size: 12.0, weight: 500, line: 16.0, wrap: false, tracking: view::Spacing::Points(0.0), balance: false, max_lines: 1,
    tabular: None, diagonal_fractions: false,
  }
  let _ = o.box(fn(panel : view::View) -> Unit {
    let _ = panel
    .over(view::Live::Is(true))
    .offset(view::Live::By(fn() -> (Double, Double) { at() }))
    .width(view::Live::Is(Some(date_panel_w)))
    .height(view::Live::Is(Some(date_panel_h)))
    .ground(view::Live::Is(0xFFFFFFFFL))
    .radius(view::Live::Is(date_corner))
    .edge(view::Live::Is((1.0, 0x0000001FL)))
    .shadow(view::Live::Is((8.0, 4.0, 0x00000033L)))
    .pad(view::Live::Is(date_pad))
    .gap(view::Live::Is(6.0))
    .clips(view::Live::Is(true))
    .on_press(fn() -> Unit { () })
    let _ = panel.box(fn(hdr : view::View) -> Unit {
      let _ = hdr.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).height(view::Live::Is(Some(28.0))).gap(view::Live::Is(6.0))
      let _ = hdr.box(fn(prev : view::View) -> Unit {
        let _ = prev
        .width(view::Live::Is(Some(28.0)))
        .height(view::Live::Is(Some(28.0)))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::Is(0xF1F5F9FFL))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .cursor(view::Live::Is(Some(view::Cursor::Hand)))
        .on_press(fn() -> Unit {
          let (y, m) = view_ym.untracked()
          view_ym.set(shift_ym(y, m, -1))
        })
        let _ = prev.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("‹"), ink=0x0F172AFFL, look=nav_btn_look) })
      })
      let _ = hdr.box(fn(title : view::View) -> Unit {
        let _ = title.grow(view::Live::Is(1.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
        let _ = title.box(fn(w : view::View) -> Unit {
          let _ = w.words(
            view::Live::By(fn() -> String {
              let (y, m) = view_ym.get()
              format_ym(y, m)
            }),
            ink=0x0F172AFFL,
            look=title_look,
          )
        })
      })
      let _ = hdr.box(fn(next : view::View) -> Unit {
        let _ = next
        .width(view::Live::Is(Some(28.0)))
        .height(view::Live::Is(Some(28.0)))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::Is(0xF1F5F9FFL))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .cursor(view::Live::Is(Some(view::Cursor::Hand)))
        .on_press(fn() -> Unit {
          let (y, m) = view_ym.untracked()
          view_ym.set(shift_ym(y, m, 1))
        })
        let _ = next.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("›"), ink=0x0F172AFFL, look=nav_btn_look) })
      })
    })
    let _ = panel.box(fn(wrow : view::View) -> Unit {
      let _ = wrow.row(view::Live::Is(true)).gap(view::Live::Is(date_gap)).height(view::Live::Is(Some(20.0)))
      for label in date_weekdays {
        let _ = wrow.box(fn(cell : view::View) -> Unit {
          let _ = cell
          .width(view::Live::Is(Some(date_cell_w)))
          .height(view::Live::Is(Some(20.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          let _ = cell.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is(label), ink=0x64748BFFL, look=wd_look) })
        })
      }
    })
    let _ = panel.pick(
      fn() -> Int {
        let (y, m) = view_ym.get()
        y * 12 + (m - 1)
      },
      fn(grid_host : view::View, ym_key : Int) -> Unit {
        let y0 = ym_key / 12
        let m0 = ym_key % 12 + 1
        let cells = month_cells(y0, m0)
        let _ = grid_host.box(fn(grid : view::View) -> Unit {
          let _ = grid.gap(view::Live::Is(date_gap))
          let mut row_i = 0
          while row_i < 6 {
            let ri = row_i
            let _ = grid.box(fn(row : view::View) -> Unit {
              let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(date_gap))
              let mut col_i = 0
              while col_i < 7 {
                let (ymd, in_month) = cells[ri * 7 + col_i]
                let enabled = date_in_range(ymd, min_d, max_d)
                let is_sel = match selected {
                  Some(s) => ymd_eq(s, ymd)
                  None => false
                }
                let is_today = ymd_eq(ymd, today)
                let _ = row.box(fn(cell : view::View) -> Unit {
                  let _ = cell
                  .width(view::Live::Is(Some(date_cell_w)))
                  .height(view::Live::Is(Some(date_cell_h)))
                  .radius(view::Live::Is(6.0))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  if is_sel {
                    let _ = cell.ground(view::Live::Is(0x2563EBFFL))
                  } else if is_today && enabled {
                    let _ = cell.ground(view::Live::Is(0xEFF6FFFFL)).edge(view::Live::Is((1.0, 0x93C5FDFFL)))
                  }
                  if enabled {
                    let _ = cell.cursor(view::Live::Is(Some(view::Cursor::Hand)))
                  }
                  let ink = if is_sel {
                    0xFFFFFFFFL
                  } else if !enabled {
                    0xCBD5E1FFL
                  } else if !in_month {
                    0x94A3B8FFL
                  } else {
                    0x0F172AFFL
                  }
                  let _ = cell.box(fn(w : view::View) -> Unit {
                    let _ = w.words(view::Live::Is(ymd.2.to_string()), ink=ink, look=day_look)
                  })
                  let _ = cell.on_press(fn() -> Unit {
                    if enabled {
                      stage.pick_date(el, format_ymd(ymd.0, ymd.1, ymd.2))
                    }
                  })
                })
                col_i += 1
              }
            })
            row_i += 1
          }
        })
      },
    )
    let _ = panel.box(fn(foot : view::View) -> Unit {
      let _ = foot.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).height(view::Live::Is(Some(28.0))).gap(view::Live::Is(8.0))
      let _ = foot.box(fn(clear_btn : view::View) -> Unit {
        let _ = clear_btn
        .height(view::Live::Is(Some(26.0)))
        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::Is(0xF1F5F9FFL))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .cursor(view::Live::Is(Some(view::Cursor::Hand)))
        .on_press(fn() -> Unit { stage.pick_date(el, "") })
        let _ = clear_btn.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("Clear"), ink=0x334155FFL, look=foot_look) })
      })
      let _ = foot.box(fn(spacer : view::View) -> Unit { let _ = spacer.grow(view::Live::Is(1.0)) })
      let today_ok = date_in_range(today, min_d, max_d)
      let _ = foot.box(fn(today_btn : view::View) -> Unit {
        let _ = today_btn
        .height(view::Live::Is(Some(26.0)))
        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::Is(if today_ok { 0xEFF6FFFFL } else { 0xF8FAFCFFL }))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        if today_ok {
          let _ = today_btn.cursor(view::Live::Is(Some(view::Cursor::Hand)))
        }
        let _ = today_btn.box(fn(w : view::View) -> Unit {
          let _ = w.words(view::Live::Is("Today"), ink=if today_ok { 0x2563EBFFL } else { 0x94A3B8FFL }, look=foot_look)
        })
        let _ = today_btn.on_press(fn() -> Unit {
          if today_ok {
            stage.pick_date(el, format_ymd(today.0, today.1, today.2))
          }
        })
      })
    })
  })
}
