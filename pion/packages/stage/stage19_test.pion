///| 1:1 port of `client/src/stage/stage19_wbtest.mbt` (6 tests).

import "html"
import "css"
import "layout"
import "display"
import "doc"
import "proto"
import "signals"
import "ui"

test "stage19a: Tab and Shift+Tab traverse focus outside and inside native fields" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=f1 type=text value=one><input id=f2 type=text value=two><button id=b1>Go</button></body></html>",
    "body { margin: 0 } input { display: block; width: 160px; height: 30px } button { display: block; width: 80px; height: 30px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  sent.clear()
  t.key(18, mods=0)
  t.frame(ms=frame_ms)
  t.key(18, mods=1)
  t.frame(ms=frame_ms)
  let tabs : Array[Int] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::Key(_, _, true, "Tab", "Tab", _, mods) => tabs.push(mods)
      _ => ()
    }
  }
  debug_assert(tabs.length() == 2 && tabs[0] == 0 && tabs[1] == 8, "Tab and Shift+Tab forwarded")
  let f1 = must(find_el(host.doc, "f1"))
  let f2 = must(find_el(host.doc, "f2"))
  let b1 = must(find_el(host.doc, "b1"))
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(0, more=[proto::PatchOp::Focus(f1.uid)])) })
  t.frame(ms=frame_ms)
  match stage.field.untracked() {
    Some(e) => debug_assert(e.node.wire_id == f1.uid, "f1 focused")
    None => debug_assert(false, "expected f1 field")
  }
  sent.clear()
  t.key(18, mods=0)
  t.frame(ms=frame_ms)
  debug_assert(stage.field.untracked().is_none(), "Tab closed f1 field")
  let mut field_tab_count = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::Key(_, _, true, "Tab", "Tab", _, 0) => field_tab_count += 1
      _ => ()
    }
  }
  debug_assert(field_tab_count == 1, "Tab from field forwarded to host")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(0, more=[proto::PatchOp::Focus(f2.uid)])) })
  t.frame(ms=frame_ms)
  match stage.field.untracked() {
    Some(e) => debug_assert(e.node.wire_id == f2.uid, "f2 focused")
    None => debug_assert(false, "expected f2 field")
  }
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(0, more=[proto::PatchOp::Focus(b1.uid)])) })
  t.frame(ms=frame_ms)
  debug_assert(stage.field.untracked().is_none(), "button focus closes field")
  t.dispose()
}

test "stage19a: Cmd+Click, Ctrl+Click and middle-click open link in new tab without navigating" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<a id=a1 href=/next>Next</a><a id=a2 href=\"javascript:void(0)\">JS</a><a id=a3 href=#sec>Hash</a></body></html>",
    "body { margin: 0 } a { display: block; width: 200px; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  sent.clear()
  let (n0, _, _) = stage.link_opens()
  t.hold_mods(8)
  t.tap(50.0, 20.0)
  t.frame(ms=frame_ms)
  t.hold_mods(0)
  let msgs1 = said(sent)
  let mut has_ptr1 = false
  for m in msgs1 {
    match m {
      proto::ClientMsg::Pointer(_, k, _, _, _, _, _, _, _) => {
        if k == proto::POINTER_DOWN || k == proto::POINTER_UP { has_ptr1 = true }
      }
      _ => ()
    }
  }
  let (n1, u1, front1) = stage.link_opens()
  debug_assert(n1 == n0 + 1 && u1 == "https://t.test/next" && !front1, "Cmd+Click opens new tab behind")
  debug_assert(!has_ptr1, "Cmd+Click does not emit POINTER_DOWN/UP")
  debug_assert(!stage.loading(), "Cmd+Click does not show this page loading")
  t.hold_mods(9)
  t.tap(50.0, 20.0)
  t.frame(ms=frame_ms)
  t.hold_mods(0)
  let (n1b, _, front1b) = stage.link_opens()
  debug_assert(n1b == n1 + 1 && front1b, "Cmd+Shift+Click opens new tab in front")
  let n1 = n1b
  sent.clear()
  t.hold_mods(2)
  t.tap(50.0, 60.0)
  t.frame(ms=frame_ms)
  t.tap(50.0, 100.0)
  t.frame(ms=frame_ms)
  t.hold_mods(0)
  debug_assert(stage.link_opens().0 == n1, "javascript: and #hash do not open new tab")
  sent.clear()
  debug_assert(stage.middle_click(50.0, 20.0), "middle_click handled")
  let (n2, u2, front2) = stage.link_opens()
  debug_assert(n2 == n1 + 1 && u2 == "https://t.test/next" && !front2, "middle_click opens new tab behind")
  let mut navs = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::Nav(_, _) | proto::ClientMsg::Pointer(_, _, _, _, _, _, _, _, _) => navs += 1
      _ => ()
    }
  }
  debug_assert(navs == 0, "middle_click sends the page nothing")
  t.dispose()
}

test "stage19a: double-click word selection and Cmd+A select all with Cmd+C copy" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<p id=p1>Hello world from Farview</p></body></html>",
    "body { margin: 0; font-size: 16px } p { margin: 0; padding: 10px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  t.tap(24.0, 18.0)
  t.frame(ms=100.0)
  t.tap(24.0, 18.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.picked_words == "Hello", "double-click selected Hello")
  debug_assert(stage.picked.untracked().length() > 0, "selection rects non-empty")
  t.key(1000 + 'c'.to_int(), mods=8)
  t.frame(ms=frame_ms)
  debug_assert(t.clipboard() == "Hello", "Cmd+C copied Hello")
  t.key(1000 + 'a'.to_int(), mods=8)
  t.frame(ms=frame_ms)
  debug_assert(stage.picked_words == "Hello world from Farview", "Cmd+A selected all")
  t.key(1000 + 'c'.to_int(), mods=8)
  t.frame(ms=frame_ms)
  debug_assert(t.clipboard() == "Hello world from Farview", "Cmd+C copied all")
  t.dispose()
}

test "stage19a: hover link URL status preview pill appears on hover and clears on leave" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(360.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<a id=lnk href=/docs/stage19/very-long-preview-url?q=1><span>Docs</span></a>" +
    "<div id=plain>Plain</div></body></html>",
    "body { margin: 0 } a { display: block; width: 200px; height: 40px } #plain { height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  debug_assert(stage.hover_href.untracked() == "", "no hover url initially")
  t.move_to(40.0, 20.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.hover_href.untracked() == "https://t.test/docs/stage19/very-long-preview-url?q=1", "hover_href set")
  let mut found_pill = false
  for w in t.drawn_words_found() {
    if str_has_sub(w.1, "https://t.test/docs/stage19/") { found_pill = true }
  }
  debug_assert(found_pill, "URL preview pill drawn")
  t.move_to(40.0, 60.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.hover_href.untracked() == "", "hover_href cleared")
  let mut still_pill = false
  for w in t.drawn_words_found() {
    if str_has_sub(w.1, "https://t.test/docs/stage19/") { still_pill = true }
  }
  debug_assert(!still_pill, "URL preview pill hidden")
  t.dispose()
}

test "stage19a: range slider click and drag update value with step alignment and emit input+change" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=r1 type=range min=0 max=100 step=5 value=20>" +
    "<input id=r2 type=range min=0 max=10 step=any value=2></body></html>",
    "body { margin: 0 } input[type=range] { display: block; width: 200px; height: 20px; margin: 0 }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  sent.clear()
  t.tap(150.0, 10.0)
  t.frame(ms=frame_ms)
  let r1 = must(find_el(must(stage.doc.root()), "r1"))
  let v1 = css::parse_double(html::control_value(r1)).to_int()
  debug_assert(v1 >= 65 && v1 <= 85 && v1 % 5 == 0, "range tap snapped to step 5")
  let mut has_change = false
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, id, _, _, _, k) => if id == r1.wire_id && k == proto::EDIT_CHANGE { has_change = true }
      _ => ()
    }
  }
  debug_assert(has_change, "range tap emitted EDIT_CHANGE")
  sent.clear()
  t.drag(20.0, 10.0, 180.0, 10.0, steps=6)
  t.frame(ms=frame_ms)
  let v2 = css::parse_double(html::control_value(r1)).to_int()
  debug_assert(v2 >= 85 && v2 <= 100 && v2 % 5 == 0, "range drag snapped near max")
  let mut has_drag_in = false
  let mut has_drag_ch = false
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, id, _, _, _, k) => if id == r1.wire_id {
        if k == proto::EDIT_INPUT { has_drag_in = true }
        if k == proto::EDIT_CHANGE { has_drag_ch = true }
      }
      _ => ()
    }
  }
  debug_assert(has_drag_in && has_drag_ch, "range drag emitted INPUT + CHANGE")
  let r2 = must(find_el(must(stage.doc.root()), "r2"))
  debug_assert(range_value_for(r2, 0.37) == "3.7", "step=any value")
  t.dispose()
}

test "stage19a: range, color, progress and meter emit native display ops and respect appearance: none" {
  let fonts = layout::Fonts::new_portable([], [])
  let d = doc::Doc::new_with_fonts(fonts)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=rng type=range min=0 max=100 value=50>" +
    "<input id=rng_none type=range min=0 max=100 value=50 class=none>" +
    "<input id=col type=color value=\"#2563eb\">" +
    "<progress id=p1 value=60 max=100></progress>" +
    "<progress id=p2></progress>" +
    "<meter id=m_ok value=0.8 min=0 max=1 low=0.3 high=0.7 optimum=0.9></meter>" +
    "<meter id=m_warn value=0.5 min=0 max=1 low=0.3 high=0.7 optimum=0.9></meter>" +
    "<meter id=m_bad value=0.1 min=0 max=1 low=0.3 high=0.7 optimum=0.9></meter>" +
    "</body></html>",
    "body { margin: 0 } .none { appearance: none }",
  )
  let reset_bytes = host.reset()
  let framer = proto::Framer::new()
  framer.push(reset_bytes)
  match proto::decode_host(must(framer.next())) {
    Some(proto::HostMsg::Reset(_, _, wd)) => d.reset(wd)
    _ => debug_assert(false, "expected Reset")
  }
  let root = must(d.layout(640.0, 480.0))
  let items = display::display_list(root, fonts)
  let has_color = fn(rgba : Int) -> Bool {
    for it in items {
      match it {
        display::Item::Round(_, _, _, _, _, _, c) => if c == rgba { return true }
        _ => ()
      }
    }
    false
  }
  debug_assert(has_color(0x2563EBFF), "color swatch")
  debug_assert(has_color(0x16A34AFF), "meter ok green")
  debug_assert(has_color(0xEAB308FF), "meter warn yellow")
  debug_assert(has_color(0xDC2626FF), "meter bad red")
  debug_assert(has_color(0x0075FFFF), "range/progress blue")
  debug_assert(has_color(0x3B82F6FF), "indeterminate progress pill")
}
