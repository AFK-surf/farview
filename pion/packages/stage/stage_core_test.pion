test "stage web font slot pool handles >15 @font-face files lazily and reclaims inactive slots under MB_FACES=16" {
  reset_global_font_slot_for_test()
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  let mut added_count = 0
  let cleared_slots : Array[Int] = []
  cur.face_add_bytes = fn(slot : Int, _data : Bytes, _w : Int) -> Bool {
    if slot < 16 {
      added_count += 1
      true
    } else {
      false
    }
  }
  cur.face_clear = fn(slot : Int) -> Unit { cleared_slots.push(slot) }
  // Simulate a Framer-like site registering 30 @font-face files (well above old last_slot=15)
  let mut i = 0
  while i < 30 {
    stage.add_face_file(build_fallback_sfnt(0x41 + i, 500, "StagePool" + i.to_string()), Some("https://cdn.example.com/f" + i.to_string() + ".woff2"), notify=false)
    i += 1
  }
  // Lazy registration: unused @font-face files must not consume any native host slot yet
  debug_assert(added_count == 0, "unused @font-face files must not eagerly consume host slots, got " + added_count.to_string())
  // Requesting the 25th font (e.g. Hero GT Walsheim Medium) must succeed immediately in slot 4
  let hero_slot = stage.ensure_url_slot("https://cdn.example.com/f25.woff2")
  debug_assert(hero_slot.unwrap_or(-1) == 4, "25th web font must allocate first available slot 4 on demand")
  // Fill all 12 native slots (4..15) with fonts 0..10 + 25
  let mut j = 0
  while j < 11 {
    let s = stage.ensure_url_slot("https://cdn.example.com/f" + j.to_string() + ".woff2")
    debug_assert(s.is_some(), "slot allocation must succeed within 12 native slots")
    j += 1
  }
  // Mark f25 as active; f0..f10 are inactive -> requesting f29 must evict an inactive slot via face_clear
  let active : Map[String, Bool] = Map::new()
  active.set("u:https://cdn.example.com/f25.woff2", true)
  stage.active_font_owners = active
  let late_slot = stage.ensure_url_slot("https://cdn.example.com/f29.woff2")
  debug_assert(late_slot.is_some(), "late web font must reclaim an inactive slot when MB_FACES=16 is full")
  debug_assert(cleared_slots.length() == 1, "reclaiming an inactive slot must call face_clear once")
  debug_assert(stage.url_slots.get("https://cdn.example.com/f25.woff2").unwrap_or(-1) == 4, "active Hero font slot must never be evicted")
  // When host supports >15 slots, Stage must not artificially cap at 15
  cur.face_add_bytes = fn(_slot : Int, _data : Bytes, _w : Int) -> Bool { true }
  let slot16 = stage.ensure_url_slot("https://cdn.example.com/f28.woff2")
  debug_assert(slot16.unwrap_or(-1) == 16, "Stage must allocate slot >= 16 when host supports >15 slots")
  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
}

test "stage portable system_fallback queries hostapi::shape for missing symbol advances (⌘/⇧)" {
  let cur = hostapi::host()
  let prev_shape = cur.shape
  cur.shape = fn(txt : String, size : Double, _weight : Int, _style : Int, out : Array[Double]) -> Int {
    if txt == "⌘" || txt == "⇧" {
      out[0] = 0.0
      out[1] = 1.0
      out[2] = size
      out[3] = 1.0
      1
    } else {
      0
    }
  }
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let base_sfnt = build_fallback_sfnt(0x4B, 667, "StageTestBase")
  stage.fonts.add_font_data(base_sfnt)
  let w_cmd = stage.fonts.width(0, 20.0, "⌘")
  let w_shift_cmd = stage.fonts.width(0, 20.0, "⇧⌘")
  cur.shape = prev_shape
  debug_assert((w_cmd - 20.0).abs() < 0.1, "⌘ at 20px must measure full 20px platform advance instead of 0.55em synthetic 11px, got " + w_cmd.to_string())
  debug_assert((w_shift_cmd - 40.0).abs() < 0.1, "⇧⌘ at 20px must measure 40px combined advance, got " + w_shift_cmd.to_string())
}

fn ot_face(b : Bytes, msg : String) -> opentype::Face {
  match opentype::Face::parse(b, 0) {
    Ok(f) => f
    Err(e) => panic(msg + ": " + e.to_string())
  }
}

fn ot_table(face : opentype::Face, tag : String) -> Bytes {
  match face.table_data_by_name(tag) {
    Some(t) => t
    None => panic("missing table " + tag)
  }
}

fn put_be(b : Bytes, off : Int, n : Int, v : Int) -> Unit {
  let mut k = 0
  while k < n {
    b[off + k] = ((v >> ((n - 1 - k) * 8)) & 0xFF) as Byte
    k += 1
  }
}

///| Assemble an SFNT (TrueType flavor) from `(tag, payload)` pairs given in ascending tag order.
fn sfnt_from_tables(tables : Array[(String, Bytes)]) -> Bytes {
  let n = tables.length()
  let mut total = 12 + n * 16
  for t in tables {
    total += (t.1.length() + 3) & -4
  }
  let b = Bytes::new(total)
  put_be(b, 0, 4, 0x00010000)
  put_be(b, 4, 2, n)
  let mut off = 12 + n * 16
  let mut i = 0
  while i < n {
    let (tag, data) = tables[i]
    let rec = 12 + i * 16
    let mut k = 0
    while k < 4 {
      b[rec + k] = (tag.code_unit_at(k).to_int() & 0xFF) as Byte
      k += 1
    }
    put_be(b, rec + 8, 4, off)
    put_be(b, rec + 12, 4, data.length())
    let mut j = 0
    while j < data.length() {
      b[off + j] = data[j]
      j += 1
    }
    off += (data.length() + 3) & -4
    i += 1
  }
  b
}

fn bytes_with(src : Bytes, edits : Array[(Int, Int)]) -> Bytes {
  let out = Bytes::new(src.length())
  let mut i = 0
  while i < src.length() {
    out[i] = src[i]
    i += 1
  }
  for e in edits {
    out[e.0] = (e.1 & 0xFF) as Byte
  }
  out
}

fn bytes_prefix(src : Bytes, n : Int) -> Bytes {
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = src[i]
    i += 1
  }
  out
}

test "build_fallback_sfnt round-trips through opentype::Face::parse with exact cmap, advances and checksums" {
  let cases : Array[(Int, Int, Int)] = [(0x2318, 1000, 1000), (0x21E7, 731, 731), (0x1F600, 1245, 1245), (0x4B, -5, 0), (0xE600, 70000, 65535)]
  for c in cases {
    let (cp, adv, want) = c
    let ps = "stage-fb-" + cp.to_string() + "-400"
    let b = build_fallback_sfnt(cp, adv, ps)
    debug_assert(b.length() % 4 == 0, "fallback SFNT is 4-byte padded")
    let face = ot_face(b, "fallback SFNT must parse")
    debug_assert(face.units_per_em() == 1000, "upem 1000")
    debug_assert(face.number_of_glyphs() == 2, "maxp numGlyphs 2")
    debug_assert(face.glyph_index(cp).unwrap_or(-1) == 1, "cmap maps cp " + cp.to_string() + " to glyph 1")
    debug_assert(face.glyph_index(cp + 1).is_none(), "cmap maps nothing else")
    debug_assert(face.glyph_hor_advance(1).unwrap_or(-1) == want, "glyph 1 advance == " + want.to_string())
    debug_assert(face.glyph_hor_advance(0).unwrap_or(-1) == 550, ".notdef advance 550")
    debug_assert(face.postscript_name().unwrap_or("") == ps, "PostScript name round-trips")
    match face.hhea() {
      Some(h) => debug_assert(h.ascender == 800 && h.descender == -200 && h.number_of_h_metrics == 2, "hhea metrics")
      None => panic("hhea must parse")
    }
    for rec in face.tables() {
      let off = rec.offset.to_int()
      let len = rec.length.to_int()
      debug_assert(off % 4 == 0, "table " + rec.tag.to_string() + " 4-byte aligned")
      debug_assert(
        (sfnt_table_checksum(b, off, len).to_int64() & 0xFFFFFFFFL) == rec.checksum,
        "table " + rec.tag.to_string() + " checksum",
      )
    }
    match inspect_webfont_sfnt(b) {
      Ok(info) => {
        debug_assert(info.units_per_em == 1000 && info.glyph_count == 2 && info.has_cmap, "gate metadata")
        debug_assert(!info.is_variable && info.axis_count == 0 && info.weight_range.is_none(), "static font")
        debug_assert(info.weight_class == 400 && !info.italic, "defaults without OS/2")
      }
      Err(e) => panic("fallback SFNT must pass the WebFont gate: " + e)
    }
  }
  // layout's own parser keeps reading the same advance (system_fallback contract).
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  stage.fonts.add_font_data(build_fallback_sfnt(0x4B, 667, "StageRoundTrip"))
  debug_assert((stage.fonts.width(0, 30.0, "K") - 20.01).abs() < 0.05, "layout advance 667/1000 em")
}

test "inspect_webfont_sfnt extracts fvar axes, wght range and OS/2 weight/italic from a variable font" {
  let base = ot_face(build_fallback_sfnt(0x41, 600, "StageVar"), "base")
  let fvar = Bytes::new(16 + 2 * 20)
  put_be(fvar, 0, 2, 1)
  put_be(fvar, 4, 2, 16)
  put_be(fvar, 6, 2, 2)
  put_be(fvar, 8, 2, 2)
  put_be(fvar, 10, 2, 20)
  put_be(fvar, 14, 2, 12)
  let axis = fn(i : Int, tag : String, lo : Int, def : Int, hi : Int) -> Unit {
    let p = 16 + i * 20
    let mut k = 0
    while k < 4 {
      fvar[p + k] = (tag.code_unit_at(k).to_int() & 0xFF) as Byte
      k += 1
    }
    put_be(fvar, p + 4, 4, lo << 16)
    put_be(fvar, p + 8, 4, def << 16)
    put_be(fvar, p + 12, 4, hi << 16)
    put_be(fvar, p + 18, 2, 256 + i)
  }
  axis(0, "wdth", 75, 100, 125)
  axis(1, "wght", 100, 400, 900)
  let os2 = Bytes::new(78)
  put_be(os2, 4, 2, 700)
  put_be(os2, 62, 2, 1)
  let font = sfnt_from_tables([
    ("OS/2", os2),
    ("cmap", ot_table(base, "cmap")),
    ("fvar", fvar),
    ("head", ot_table(base, "head")),
    ("hhea", ot_table(base, "hhea")),
    ("hmtx", ot_table(base, "hmtx")),
    ("maxp", ot_table(base, "maxp")),
    ("name", ot_table(base, "name")),
  ])
  match inspect_webfont_sfnt(font) {
    Ok(info) => {
      debug_assert(info.is_variable && info.axis_count == 2, "two fvar axes")
      match info.weight_range {
        Some((lo, hi)) => debug_assert(lo == 100.0 && hi == 900.0, "wght 100..900")
        None => panic("wght axis expected")
      }
      debug_assert(info.weight_class == 700, "OS/2 usWeightClass 700")
      debug_assert(info.italic, "OS/2 fsSelection ITALIC")
      debug_assert(info.kind == "TrueType", "kind: " + info.kind)
    }
    Err(e) => panic("variable font must pass: " + e)
  }
}

test "a real WOFF-decoded web font passes the gate unchanged" {
  let base = match woff2::decode(must(url::data_url_bytes(base_woff))) {
    Ok(b) => b
    Err(e) => panic(e)
  }
  match inspect_webfont_sfnt(base) {
    Ok(info) => debug_assert(info.has_cmap && info.units_per_em >= 16 && info.glyph_count >= 1, "real font metadata")
    Err(e) => panic("WOFF-decoded font must pass: " + e)
  }
}

test "malformed, truncated, non-SFNT and table-less web fonts are rejected before a host slot is spent" {
  let good = build_fallback_sfnt(0x41, 600, "StageGate")
  let face = ot_face(good, "good")
  let dir_pos = fn(tag : String) -> Int {
    let mut i = 0
    while i < 6 {
      if face.tables()[i].tag.to_string() == tag { return 12 + i * 16 }
      i += 1
    }
    panic("no " + tag)
  }
  let maxp_rec = dir_pos("maxp")
  let cmap_rec = dir_pos("cmap")
  let hhea_off = face.tables()[2].offset.to_int()
  let bad : Array[(String, Bytes)] = [
    ("empty", Bytes::new(0)),
    ("ascii", "dummy-ttf-bytes".to_bytes()),
    ("undecoded woff2 magic", bytes_with(good, [(0, 0x77), (1, 0x4F), (2, 0x46), (3, 0x32)])),
    ("truncated directory", bytes_prefix(good, 40)),
    ("truncated tables", bytes_prefix(good, 140)),
    ("missing maxp", bytes_with(good, [(maxp_rec + 3, 0x71)])),
    ("missing cmap", bytes_with(good, [(cmap_rec + 3, 0x71)])),
    ("zero numTables", bytes_with(good, [(5, 0)])),
    ("bad head magic", bytes_with(good, [(face.tables()[1].offset.to_int() + 12, 0)])),
    ("numberOfHMetrics > numGlyphs", bytes_with(good, [(hhea_off + 35, 9)])),
    ("bogus ttc", bytes_with(good, [(0, 0x74), (1, 0x74), (2, 0x63), (3, 0x66), (4, 0), (5, 1), (6, 0), (7, 0), (8, 0x7F), (9, 0xFF), (10, 0xFF), (11, 0xFF)])),
  ]
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  let mut uploads = 0
  let mut clears = 0
  cur.face_add_bytes = fn(_slot : Int, _data : Bytes, _w : Int) -> Bool {
    uploads += 1
    true
  }
  cur.face_clear = fn(_slot : Int) -> Unit { clears += 1 }
  stage.add_face_file(good, Some("https://fonts.example/good.woff2"), notify=false)
  let good_slot = stage.ensure_url_slot("https://fonts.example/good.woff2")
  debug_assert(good_slot.is_some() && uploads == 1, "a valid font is uploaded")
  let slot_after_good = stage.next_slot
  for c in bad {
    let (label, data) = c
    debug_assert(inspect_webfont_sfnt(data).is_err(), label + " must fail inspection")
    let u = "https://fonts.example/" + label + ".woff2"
    stage.add_face_file(data, Some(u), notify=false)
    debug_assert(stage.ensure_url_slot(u).is_none(), label + " must not get a slot")
    debug_assert(stage.failed_font_owners.contains("u:" + u), label + " recorded in failed_font_owners")
    debug_assert(stage.ensure_url_slot(u).is_none(), label + " stays rejected")
  }
  // Same gate for a garbage data: URL font: never declared drawable to layout.
  let data_u = "data:font/ttf;base64,ZHVtbXktdHRmLWJ5dGVz"
  debug_assert(!stage.data_font(data_u), "garbage data: font is not drawable")
  debug_assert(stage.failed_font_owners.contains("u:" + data_u), "garbage data: font recorded as failed")
  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
  debug_assert(uploads == 1, "no malformed font reached face_add_bytes, got " + uploads.to_string())
  debug_assert(clears == 0, "no malformed font evicted a live slot")
  debug_assert(stage.next_slot == slot_after_good, "no MB_FACES slot consumed by malformed fonts")
}

test "dual concurrent Stages share process-global pool with cross-Stage inactive LRU, lifecycle release, and remount safety" {
  reset_global_font_slot_for_test()
  let st_a = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_b = Stage::new(fn(_b : Bytes) -> Unit { () })
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  // Simulate macOS native MB_FACES=16 cap (slots 4..15 = 12 webfont slots).
  let slot_bytes_len : Map[Int, Int] = Map::new()
  let cleared_slots : Array[Int] = []
  let mut add_calls = 0
  let mut reject_bad_len = -1
  cur.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    add_calls += 1
    if reject_bad_len >= 0 && data.length() == reject_bad_len {
      return false
    }
    if slot >= 4 && slot < 16 {
      slot_bytes_len.set(slot, data.length())
      true
    } else {
      false
    }
  }
  cur.face_clear = fn(slot : Int) -> Unit {
    cleared_slots.push(slot)
    slot_bytes_len.remove(slot)
  }

  // 1. Stage A fills all 12 native slots (4..15) and marks all 12 active -> Stage B safely falls back to None
  //    without evicting any active slot and WITHOUT marking B's font as permanently failed.
  let active_a : Map[String, Bool] = Map::new()
  let a_urls : Array[String] = []
  let a_lens : Array[Int] = []
  let mut i = 0
  while i < 12 {
    let u = "https://a.test/f" + i.to_string() + ".woff2"
    let b = build_fallback_sfnt(0x41 + i, 500 + i, "StageAFull" + i.to_string())
    st_a.add_face_file(b, Some(u), notify=false)
    let s = st_a.ensure_url_slot(u).unwrap_or(-1)
    debug_assert(s == 4 + i, "Stage A slot " + i.to_string() + " == " + (4 + i).to_string())
    active_a.set("u:" + u, true)
    a_urls.push(u)
    a_lens.push(b.length())
    i += 1
  }
  st_a.active_font_owners = active_a

  let b_urls : Array[String] = []
  let b_lens : Array[Int] = []
  let mut bi = 0
  while bi < 3 {
    let u = "https://b.test/f" + bi.to_string() + ".woff2"
    let b = build_fallback_sfnt(0x61 + bi, 700 + bi, "StageBFontLongName" + bi.to_string())
    st_b.add_face_file(b, Some(u), notify=false)
    b_urls.push(u)
    b_lens.push(b.length())
    bi += 1
  }
  debug_assert(st_b.ensure_url_slot(b_urls[0]).is_none(), "all 12 slots active on A -> B safely falls back to None")
  debug_assert(cleared_slots.length() == 0, "0 active Stage A slots cleared")
  debug_assert(!st_b.failed_font_owners.contains("u:" + b_urls[0]), "full-active pool must NOT mark B's font failed")

  // 2. Mark 3 of Stage A's slots (0, 1, 2 -> slots 4, 5, 6) inactive -> Stage B immediately acquires 3/3 valid slots,
  //    while Stage A's remaining 9 active slots (7..15) stay completely untouched!
  active_a.remove("u:" + a_urls[0])
  active_a.remove("u:" + a_urls[1])
  active_a.remove("u:" + a_urls[2])
  let active_b : Map[String, Bool] = Map::new()
  st_b.active_font_owners = active_b
  let sb0 = st_b.ensure_url_slot(b_urls[0]).unwrap_or(-1)
  active_b.set("u:" + b_urls[0], true)
  let sb1 = st_b.ensure_url_slot(b_urls[1]).unwrap_or(-1)
  active_b.set("u:" + b_urls[1], true)
  let sb2 = st_b.ensure_url_slot(b_urls[2]).unwrap_or(-1)
  active_b.set("u:" + b_urls[2], true)
  debug_assert(sb0 == 4 && sb1 == 5 && sb2 == 6, "B reclaimed A's 3 LRU inactive slots 4,5,6")
  debug_assert(cleared_slots.length() == 3, "3 inactive slots cleared for cross-Stage reclaim")
  debug_assert(st_a.url_slots.get(a_urls[0]).is_none(), "A's reclaimed slot 4 detached from url_slots")
  let mut k = 3
  while k < 12 {
    debug_assert(slot_bytes_len.get(4 + k).unwrap_or(-1) == a_lens[k], "A active slot untouched: " + (4 + k).to_string())
    k += 1
  }

  // 3. Stage A requests its previously reclaimed font a_urls[0] again after B's b_urls[0] becomes inactive:
  //    A automatically re-uploads from preserved `url_font_bytes` and receives a valid slot!
  active_b.remove("u:" + b_urls[0])
  let sa0_re = st_a.ensure_url_slot(a_urls[0]).unwrap_or(-1)
  debug_assert(sa0_re == sb0, "A automatically re-uploaded reclaimed font into B's inactive slot")
  debug_assert(slot_bytes_len.get(sa0_re).unwrap_or(-1) == a_lens[0], "re-uploaded A font bytes match")

  // 4. Non-first Stage submitting invalid font bytes rolls back evicted slot and marks failed_font_owners
  //    so subsequent calls never trigger repeated eviction!
  let bad_b = build_fallback_sfnt(0x7A, 777, "StageBBadHostRejectPayloadXYZ")
  reject_bad_len = bad_b.length()
  let bad_u = "https://b.test/bad-host-reject.woff2"
  st_b.add_face_file(bad_b, Some(bad_u), notify=false)
  let clears_before_bad = cleared_slots.length()
  debug_assert(st_b.ensure_url_slot(bad_u).is_none(), "host-rejected font returns None")
  debug_assert(st_b.failed_font_owners.contains("u:" + bad_u), "host-rejected font marked failed on non-first Stage")
  debug_assert(slot_bytes_len.get(sa0_re).unwrap_or(-1) == a_lens[0], "evicted victim slot restored after failed upload")
  let clears_after_bad = cleared_slots.length()
  debug_assert(st_b.ensure_url_slot(bad_u).is_none(), "second call short-circuits via failed_font_owners")
  debug_assert(cleared_slots.length() == clears_after_bad, "no repeated eviction on failed font")
  let _ = clears_before_bad
  reject_bad_len = -1

  // 5. Stage::closed() clears active_font_owners so B and new Stage C can immediately reclaim A's slots;
  //    Stage::close() / release_font_slots() explicitly clears slots into global_free_font_slots so
  //    global_next_font_slot does NOT grow when reused!
  st_a.closed()
  debug_assert(st_a.active_font_owners.length() == 0, "closed() clears active_font_owners")
  let st_c = Stage::new(fn(_b : Bytes) -> Unit { () })
  let fc = build_fallback_sfnt(0x43, 610, "StageCAfterClosed")
  let uc = "https://c.test/c.woff2"
  st_c.add_face_file(fc, Some(uc), notify=false)
  let sc = st_c.ensure_url_slot(uc).unwrap_or(-1)
  debug_assert(sc >= 4 && sc < 16, "Stage C acquires slot after A.closed()")

  let next_before_close = global_next_font_slot[0]
  let clears_before_close = cleared_slots.length()
  st_a.close()
  debug_assert(cleared_slots.length() > clears_before_close, "close() explicitly calls face_clear on A's owned slots")
  debug_assert(global_free_font_slots.length() > 0, "close() returns slots to global_free_font_slots")
  let fc2 = build_fallback_sfnt(0x44, 612, "StageCReuseFree")
  let uc2 = "https://c.test/c2.woff2"
  st_c.add_face_file(fc2, Some(uc2), notify=false)
  let sc2 = st_c.ensure_url_slot(uc2).unwrap_or(-1)
  debug_assert(sc2 >= 4 && sc2 < 16, "Stage C reuses freed slot")
  debug_assert(global_next_font_slot[0] == next_before_close, "reusing free slot does NOT advance global_next_font_slot")

  // 6. Mount / unmount cycle:
  //    (a) Repeated mount/unmount does NOT replay face_add_bytes;
  //    (b) Unmounting Stage M clears active_font_owners -> Stage N fills pool & reclaims M's slot ->
  //        remounting M does NOT overwrite N's slot bytes!
  reset_global_font_slot_for_test()
  slot_bytes_len.clear()
  let st_m = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_n = Stage::new(fn(_b : Bytes) -> Unit { () })
  let fm = build_fallback_sfnt(0x4D, 555, "StageMountFontM")
  let um = "https://m.test/m.woff2"
  st_m.add_face_file(fm, Some(um), notify=false)
  let sm = st_m.ensure_url_slot(um).unwrap_or(-1)
  debug_assert(sm == 4, "Stage M gets slot 4")
  let am : Map[String, Bool] = Map::new()
  am.set("u:" + um, true)
  st_m.active_font_owners = am

  let show_m = signals::signal(true)
  let tm = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.show(fn() -> Bool { show_m.get() }, fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_m)
      })
    },
    w=400.0,
    h=200.0,
  )
  // Re-hook hostapi AFTER StageTester::make installs its test host!
  let cur_m = hostapi::host()
  let prev_add_m = cur_m.face_add_bytes
  let prev_clear_m = cur_m.face_clear
  cur_m.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    add_calls += 1
    if slot >= 4 && slot < 16 {
      slot_bytes_len.set(slot, data.length())
      true
    } else {
      false
    }
  }
  cur_m.face_clear = fn(slot : Int) -> Unit {
    cleared_slots.push(slot)
    slot_bytes_len.remove(slot)
  }
  let adds_after_first_mount = add_calls
  tm.draw()
  // Unmount M -> clears active_font_owners
  show_m.set(false)
  tm.run_for(frame_ms)
  debug_assert(st_m.active_font_owners.length() == 0, "unmounting Stage M clears active_font_owners")
  // Remount M without contention -> 0 duplicate face_add_bytes calls!
  show_m.set(true)
  tm.run_for(frame_ms)
  debug_assert(add_calls == adds_after_first_mount, "remounting Stage M does NOT replay face_add_bytes")
  // Unmount M again, let Stage N fill all 12 active slots (4..15) and reclaim M's slot 4!
  show_m.set(false)
  tm.run_for(frame_ms)
  let active_n : Map[String, Bool] = Map::new()
  st_n.active_font_owners = active_n
  let mut ni = 0
  let mut n_reclaimed_len = -1
  while ni < 12 {
    let un = "https://n.test/n" + ni.to_string() + ".woff2"
    let fn_b = build_fallback_sfnt(0x4E + ni, 680 + ni, "StageNFontOverrideCheck" + ni.to_string())
    st_n.add_face_file(fn_b, Some(un), notify=false)
    let sn = st_n.ensure_url_slot(un).unwrap_or(-1)
    active_n.set("u:" + un, true)
    if sn == sm {
      n_reclaimed_len = fn_b.length()
    }
    ni += 1
  }
  debug_assert(n_reclaimed_len > 0 && slot_bytes_len.get(sm).unwrap_or(-1) == n_reclaimed_len, "Stage N reclaimed M's slot 4")
  // Remount M -> MUST NOT overwrite Stage N's slot 4 bytes!
  show_m.set(true)
  tm.run_for(frame_ms)
  debug_assert(
    slot_bytes_len.get(sm).unwrap_or(-1) == n_reclaimed_len,
    "remounting Stage M must NEVER overwrite Stage N's reclaimed slot",
  )

  cur_m.face_add_bytes = prev_add_m
  cur_m.face_clear = prev_clear_m
  tm.dispose()
  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
}

fn find_runs_for_text(v : view::View, needle : String, out : Array[text::Run]) -> Unit {
  for d in v.tree.drawn() {
    for r in d.runs {
      if r.text.contains(needle) {
        out.push(r)
      }
    }
  }
}

test "mounted disconnected Stage protects visible font slot while unmounted disconnected Stage releases it" {
  reset_global_font_slot_for_test()
  let st_a = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_b = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_off = Stage::new(fn(_b : Bytes) -> Unit { () })
  st_a.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "StageTestBaseA"))
  st_b.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "StageTestBaseB"))
  let font_a = build_fallback_sfnt(0x41, 600, "MountedClosedAlpha")
  let url_a = "https://a.test/mounted-closed.ttf"
  let host_a = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><p>AAA</p></body></html>",
    "@font-face { font-family: MountedAlpha; src: url(\"" + url_a + "\"); } body { margin: 0; font-family: MountedAlpha; font-size: 20px; }",
  )
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_a)
      })
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_b)
      })
    },
    w=800.0,
    h=200.0,
  )
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  let slot_len : Map[Int, Int] = Map::new()
  let cleared : Array[Int] = []
  cur.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    if slot >= 4 && slot < 16 {
      slot_len.set(slot, data.length())
      true
    } else {
      false
    }
  }
  cur.face_clear = fn(slot : Int) -> Unit {
    cleared.push(slot)
    slot_len.remove(slot)
  }

  t.draw()
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(host_a.reset())
    st_a.feed(proto::encode_host(proto::HostMsg::Asset(url_a, 1, 0.0, 0.0, font_a)))
  })
  t.run_for(shown_ms)
  let slot_a = st_a.url_slots.get(url_a).unwrap_or(-1)
  debug_assert(slot_a == 4, "mounted Stage A allocated slot 4, got " + slot_a.to_string())

  // Disconnect st_a while keeping it mounted on screen (last-frame reconnect UX)
  st_a.closed()
  debug_assert(st_a.node.is_some(), "st_a remains mounted after closed()")
  debug_assert(st_a.active_font_owners.contains("u:" + url_a), "mounted closed() preserves active_font_owners")

  // Also allocate a slot on an unmounted Stage and mark it active, then call closed() -> MUST become reclaimable!
  let font_off = build_fallback_sfnt(0x4F, 610, "UnmountedClosedFont")
  let url_off = "https://off.test/unmounted.ttf"
  st_off.add_face_file(font_off, Some(url_off), notify=false)
  let slot_off = st_off.ensure_url_slot(url_off).unwrap_or(-1)
  debug_assert(slot_off == 5, "unmounted Stage got slot 5")
  let active_off : Map[String, Bool] = Map::new()
  active_off.set("u:" + url_off, true)
  st_off.active_font_owners = active_off
  st_off.closed()
  debug_assert(st_off.active_font_owners.length() == 0, "unmounted closed() clears active_font_owners")

  // Stage B requests 12 active fonts under MB_FACES=16:
  // it may reclaim slot_off (slot 5) + slots 6..15 (11 slots total), but MUST NEVER evict mounted st_a's slot 4!
  let active_b : Map[String, Bool] = Map::new()
  st_b.active_font_owners = active_b
  let mut reclaimed_off = false
  let mut bi = 0
  while bi < 12 {
    let ub = "https://b.test/f" + bi.to_string() + ".ttf"
    let fb = build_fallback_sfnt(0x61 + bi, 700 + bi, "StageBCompetingFontLong" + bi.to_string())
    st_b.add_face_file(fb, Some(ub), notify=false)
    let sb = st_b.ensure_url_slot(ub).unwrap_or(-1)
    if sb == slot_off {
      reclaimed_off = true
    }
    if sb >= 0 {
      active_b.set("u:" + ub, true)
    }
    bi += 1
  }
  debug_assert(reclaimed_off, "Stage B reclaimed unmounted disconnected Stage's slot 5")
  debug_assert(slot_len.get(slot_a).unwrap_or(-1) == font_a.length(), "mounted disconnected Stage A slot 4 bytes untouched")
  for cs in cleared {
    debug_assert(cs != slot_a, "mounted disconnected Stage A slot 4 must never be cleared")
  }

  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
  t.dispose()
}

test "mixed-script text protects both primary and other_faces fallback webfont slots from cross-Stage eviction" {
  reset_global_font_slot_for_test()
  let st_a = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_b = Stage::new(fn(_b : Bytes) -> Unit { () })
  st_a.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "StageMixBaseA"))
  st_b.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "StageMixBaseB"))
  // Primary font covers ONLY 'A' (0x41); fallback font covers ONLY 'Z' (0x5A)
  let font_a = build_fallback_sfnt(0x41, 600, "MixedPrimaryOnlyA")
  let font_z = build_fallback_sfnt(0x5A, 740, "MixedFallbackOnlyZLongName")
  let url_a = "https://a.test/only-a.ttf"
  let url_z = "https://a.test/only-z.ttf"
  let host_a = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><p>AZ</p></body></html>",
    "@font-face { font-family: FontA; src: url(\"" + url_a + "\"); } " +
    "@font-face { font-family: FontZ; src: url(\"" + url_z + "\"); } " +
    "body { margin: 0; font-family: FontA, FontZ; font-size: 20px; }",
  )
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_a)
      })
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_b)
      })
    },
    w=800.0,
    h=200.0,
  )
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  let slot_len : Map[Int, Int] = Map::new()
  let cleared : Array[Int] = []
  cur.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    if slot >= 4 && slot < 16 {
      slot_len.set(slot, data.length())
      true
    } else {
      false
    }
  }
  cur.face_clear = fn(slot : Int) -> Unit {
    cleared.push(slot)
    slot_len.remove(slot)
  }

  t.draw()
  st_a.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_a.feed(host_a.reset())
    st_a.feed(proto::encode_host(proto::HostMsg::Asset(url_a, 1, 0.0, 0.0, font_a)))
    st_a.feed(proto::encode_host(proto::HostMsg::Asset(url_z, 1, 0.0, 0.0, font_z)))
  })
  t.run_for(shown_ms)

  let slot_a = st_a.url_slots.get(url_a).unwrap_or(-1)
  let slot_z = st_a.url_slots.get(url_z).unwrap_or(-1)
  debug_assert(slot_a >= 4 && slot_z >= 4 && slot_a != slot_z, "mixed text allocated distinct slots for FontA and FontZ: a=" + slot_a.to_string() + " z=" + slot_z.to_string())
  debug_assert(st_a.active_font_owners.contains("u:" + url_a), "primary FontA marked active")
  debug_assert(st_a.active_font_owners.contains("u:" + url_z), "other_faces fallback FontZ marked active")

  // Stage B tries to allocate 12 active fonts under MB_FACES=16 -> neither slot_a nor slot_z may be evicted!
  let active_b : Map[String, Bool] = Map::new()
  st_b.active_font_owners = active_b
  let mut bi = 0
  while bi < 12 {
    let ub = "https://b.test/mix" + bi.to_string() + ".ttf"
    let fb = build_fallback_sfnt(0x61 + bi, 700 + bi, "StageBMixPressureLongName" + bi.to_string())
    st_b.add_face_file(fb, Some(ub), notify=false)
    let sb = st_b.ensure_url_slot(ub).unwrap_or(-1)
    if sb >= 0 {
      active_b.set("u:" + ub, true)
    }
    bi += 1
  }
  debug_assert(cleared.length() == 0, "neither primary nor fallback active slot was cleared")
  debug_assert(slot_len.get(slot_a).unwrap_or(-1) == font_a.length(), "primary FontA slot bytes intact")
  debug_assert(slot_len.get(slot_z).unwrap_or(-1) == font_z.length(), "fallback FontZ slot bytes intact")

  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
  t.dispose()
}

test "static mounted Stage auto-rebinds fallback text nodes to webfont slot once competing Stage frees slots" {
  reset_global_font_slot_for_test()
  let st_a = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_b = Stage::new(fn(_b : Bytes) -> Unit { () })
  st_b.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "StageRecoverBaseB"))
  let font_b = build_fallback_sfnt(0x42, 680, "StaticRecoverBetaFont")
  let url_b = "https://b.test/static-recover.ttf"
  let host_b = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><p>BBB</p></body></html>",
    "@font-face { font-family: RecoverBeta; src: url(\"" + url_b + "\"); } body { margin: 0; font-family: RecoverBeta; font-size: 20px; }",
  )
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_b)
      })
    },
    w=400.0,
    h=200.0,
  )
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  let slot_len : Map[Int, Int] = Map::new()
  cur.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    if slot >= 4 && slot < 16 {
      slot_len.set(slot, data.length())
      true
    } else {
      false
    }
  }
  cur.face_clear = fn(slot : Int) -> Unit {
    slot_len.remove(slot)
  }

  // Stage A occupies all 12 native slots (4..15) as active BEFORE Stage B renders
  let active_a : Map[String, Bool] = Map::new()
  st_a.active_font_owners = active_a
  let mut ai = 0
  while ai < 12 {
    let ua = "https://a.test/full" + ai.to_string() + ".ttf"
    let fa = build_fallback_sfnt(0x41 + ai, 500 + ai, "StageAHoldSlot" + ai.to_string())
    st_a.add_face_file(fa, Some(ua), notify=false)
    let sa = st_a.ensure_url_slot(ua).unwrap_or(-1)
    debug_assert(sa == 4 + ai, "Stage A filled slot " + (4 + ai).to_string())
    active_a.set("u:" + ua, true)
    ai += 1
  }

  // Stage B renders static page "BBB" while pool is 100% full -> falls back to system font (`face == None`)
  t.draw()
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(host_b.reset())
    st_b.feed(proto::encode_host(proto::HostMsg::Asset(url_b, 1, 0.0, 0.0, font_b)))
  })
  t.run_for(shown_ms)

  let runs_before : Array[text::Run] = []
  find_runs_for_text(must(st_b.node), "BBB", runs_before)
  debug_assert(runs_before.length() == 1, "found mounted static text node BBB before release")
  debug_assert(runs_before[0].face.is_none(), "initial render under full-active pool falls back to face == None")
  debug_assert(st_b.waiting_for_font_slot, "Stage B registered as waiting_for_font_slot")

  // Stage A releases its font slots; Stage B stays completely static (no re-navigation, no manual ensure_url_slot)
  st_a.release_font_slots()
  t.run_for(frame_ms)

  let runs_after : Array[text::Run] = []
  find_runs_for_text(must(st_b.node), "BBB", runs_after)
  debug_assert(runs_after.length() == 1, "original static text node BBB still mounted after frame")
  let rebound_slot = runs_after[0].face.unwrap_or(-1)
  debug_assert(rebound_slot >= 4 && rebound_slot < 16, "static text node auto-rebound to valid webfont slot, got " + rebound_slot.to_string())
  debug_assert(slot_len.get(rebound_slot).unwrap_or(-1) == font_b.length(), "rebound native slot holds Stage B's font bytes")
  debug_assert(st_b.active_font_owners.contains("u:" + url_b), "rebound font immediately marked active on Stage B")

  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
  t.dispose()
}

test "mark_active_fonts scales strictly O(unique_fonts) across 20 vs 2,000 text display items" {
  let st = Stage::new(fn(_b : Bytes) -> Unit { () })
  let make_items = fn(n : Int) -> Array[display::Item] {
    let out : Array[display::Item] = []
    let mut i = 0
    while i < n {
      let font = if (i & 1) == 0 { 0 } else { 1 }
      out.push(display::Item::Text(font, 16.0, 0.0, 16.0, 0x111111FF, "word-" + i.to_string(), 0.0, 40.0))
      i += 1
    }
    out
  }
  st.mark_active_font_lookups = 0
  st.mark_active_fonts(make_items(20), [])
  let lookups_20 = st.mark_active_font_lookups

  st.mark_active_font_lookups = 0
  st.mark_active_fonts(make_items(2000), [])
  let lookups_2000 = st.mark_active_font_lookups

  debug_assert(
    lookups_20 == 2 && lookups_2000 == 2,
    "mark_active_fonts must scale O(unique_fonts): expected 2==2, got 20->" + lookups_20.to_string() + ", 2000->" + lookups_2000.to_string(),
  )
}

test "same mounted Stage self-wakes fallback 13th webfont when an earlier font leaves active set without wake loop" {
  reset_global_font_slot_for_test()
  let st = Stage::new(fn(_b : Bytes) -> Unit { () })
  st.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "SelfWakeBase"))
  let urls : Array[String] = []
  let fonts : Array[Bytes] = []
  let css_sb = StringBuilder::new()
  css_sb.write_string("body { margin: 0; font-size: 20px; } ")
  let html_sb = StringBuilder::new()
  html_sb.write_string("<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>")
  let mut i = 0
  while i < 13 {
    let u = "https://self.test/f" + i.to_string() + ".ttf"
    let fam = "SelfFam" + i.to_string()
    let ch = (0x41 + i).unsafe_to_char().to_string()
    let fb = build_fallback_sfnt(0x41 + i, 550 + i * 5, "SelfWakeFont" + i.to_string())
    urls.push(u)
    fonts.push(fb)
    css_sb.write_string("@font-face { font-family: " + fam + "; src: url(\"" + u + "\"); } ")
    css_sb.write_string("#p" + i.to_string() + " { font-family: " + fam + "; } ")
    html_sb.write_string("<p id=p" + i.to_string() + ">" + ch + ch + ch + "</p>")
    i += 1
  }
  html_sb.write_string("</body></html>")
  let host = TestHost::new(html_sb.to_string(), css_sb.to_string())
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(600.0)))
        let _ = stage_node(box, st)
      })
    },
    w=400.0,
    h=600.0,
  )
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  let slot_len : Map[Int, Int] = Map::new()
  cur.face_add_bytes = fn(slot : Int, data : Bytes, _w : Int) -> Bool {
    if slot >= 4 && slot < 16 {
      slot_len.set(slot, data.length())
      true
    } else {
      false
    }
  }
  cur.face_clear = fn(slot : Int) -> Unit { slot_len.remove(slot) }

  t.draw()
  st.opened()
  ui::answered_from_outside(fn() -> Unit {
    st.feed(host.reset())
    let mut k = 0
    while k < 13 {
      st.feed(proto::encode_host(proto::HostMsg::Asset(urls[k], 1, 0.0, 0.0, fonts[k])))
      k += 1
    }
  })
  t.run_for(shown_ms)

  // 13th paragraph ("MMM", 0x41 + 12 = 'M') fell back to face == None because slots 4..15 are full & active
  let runs_13_before : Array[text::Run] = []
  find_runs_for_text(must(st.node), "MMM", runs_13_before)
  debug_assert(runs_13_before.length() == 1, "found 13th paragraph MMM before removal")
  debug_assert(runs_13_before[0].face.is_none(), "13th webfont initially fell back to face == None")
  debug_assert(st.waiting_for_font_slot, "Stage waiting for font slot")

  // Remove the unique text of paragraph #0 ("AAA") via DOM patch, keeping #13 ("MMM") untouched!
  must(find_el(host.doc, "p0")).children[0].data = ""
  ui::answered_from_outside(fn() -> Unit { st.feed(host.patch(0)) })
  t.run_for(shown_ms)

  let runs_13_after : Array[text::Run] = []
  find_runs_for_text(must(st.node), "MMM", runs_13_after)
  debug_assert(runs_13_after.length() == 1, "13th paragraph MMM still mounted")
  let slot_13 = runs_13_after[0].face.unwrap_or(-1)
  debug_assert(slot_13 >= 4 && slot_13 < 16, "13th webfont self-woke and bound valid slot, got " + slot_13.to_string())
  debug_assert(slot_len.get(slot_13).unwrap_or(-1) == fonts[12].length(), "13th webfont bytes uploaded to slot")

  // Verify zero wake loop: advancing several frames without capacity changes must NOT bump font_rebind_gen
  let gen_settled = st.font_rebind_gen.untracked()
  let mut f = 0
  while f < 6 {
    t.run_for(frame_ms)
    f += 1
  }
  debug_assert(
    st.font_rebind_gen.untracked() == gen_settled,
    "no wake loop after recovery: gen=" + st.font_rebind_gen.untracked().to_string() + " expected=" + gen_settled.to_string(),
  )

  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
  t.dispose()
}

test "unmounting and closing a waiting Stage removes it from global_waiting_font_stages immediately" {
  reset_global_font_slot_for_test()
  let st_a = Stage::new(fn(_b : Bytes) -> Unit { () })
  let st_b = Stage::new(fn(_b : Bytes) -> Unit { () })
  st_b.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "WaitLeakBaseB"))
  let font_b = build_fallback_sfnt(0x42, 680, "WaitLeakBetaFont")
  let url_b = "https://b.test/wait-leak.ttf"
  let host_b = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><p>BBB</p></body></html>",
    "@font-face { font-family: WaitBeta; src: url(\"" + url_b + "\"); } body { margin: 0; font-family: WaitBeta; font-size: 20px; }",
  )
  let show_b = signals::signal(true)
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.show(fn() -> Bool { show_b.get() }, fn(box : view::View) -> Unit {
        let _ = box.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = stage_node(box, st_b)
      })
    },
    w=400.0,
    h=200.0,
  )
  let cur = hostapi::host()
  let prev_add = cur.face_add_bytes
  let prev_clear = cur.face_clear
  cur.face_add_bytes = fn(slot : Int, _data : Bytes, _w : Int) -> Bool { slot >= 4 && slot < 16 }
  cur.face_clear = fn(_slot : Int) -> Unit { () }

  // Stage A occupies all 12 slots as active
  let active_a : Map[String, Bool] = Map::new()
  st_a.active_font_owners = active_a
  let mut ai = 0
  while ai < 12 {
    let ua = "https://a.test/wl" + ai.to_string() + ".ttf"
    st_a.add_face_file(build_fallback_sfnt(0x41 + ai, 500 + ai, "WaitLeakA" + ai.to_string()), Some(ua), notify=false)
    let _ = st_a.ensure_url_slot(ua)
    active_a.set("u:" + ua, true)
    ai += 1
  }

  // Stage B renders and enters global_waiting_font_stages
  t.draw()
  st_b.opened()
  ui::answered_from_outside(fn() -> Unit {
    st_b.feed(host_b.reset())
    st_b.feed(proto::encode_host(proto::HostMsg::Asset(url_b, 1, 0.0, 0.0, font_b)))
  })
  t.run_for(shown_ms)
  let has_b_in_waiters = fn() -> Bool {
    for st in global_waiting_font_stages {
      if st.stage_id == st_b.stage_id { return true }
    }
    false
  }
  debug_assert(has_b_in_waiters(), "Stage B entered global_waiting_font_stages")

  // Unmount B and close it -> immediately removed from global_waiting_font_stages!
  show_b.set(false)
  t.run_for(frame_ms)
  debug_assert(!has_b_in_waiters(), "unmounting Stage B immediately removed it from global_waiting_font_stages")
  st_b.close()
  debug_assert(!has_b_in_waiters(), "closing Stage B leaves zero references in global_waiting_font_stages")

  // Releasing Stage A's slots must NOT notify closed Stage B
  let gen_before = st_b.font_rebind_gen.untracked()
  st_a.release_font_slots()
  debug_assert(st_b.font_rebind_gen.untracked() == gen_before, "closed Stage B receives no rebind notification")

  cur.face_add_bytes = prev_add
  cur.face_clear = prev_clear
  t.dispose()
}
