///| 1:1 port of `client/src/stage/stage20_wbtest.mbt` (4 tests).

import "html"
import "proto"
import "signals"
import "ui"

test "stage20a: interactive drag targets route POINTER_DOWN/MOVE/UP without text selection; normal text still selects" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<div id=card draggable=true><span>Drag Card</span></div>" +
    "<canvas id=cv width=200 height=80></canvas>" +
    "<p id=prose>Selectable paragraph text</p></body></html>",
    "body { margin: 0 } #card { width: 200px; height: 50px; background: #eee } canvas { display: block; width: 200px; height: 80px } p { margin: 0; height: 40px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  sent.clear()
  t.drag(20.0, 20.0, 160.0, 20.0, steps=6)
  t.frame(ms=frame_ms)
  let mut cd = false
  let mut cm = false
  let mut cu = false
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, k, _, _, _, _, _, _, _) => {
        if k == proto::POINTER_DOWN { cd = true }
        if k == proto::POINTER_MOVE { cm = true }
        if k == proto::POINTER_UP { cu = true }
      }
      _ => ()
    }
  }
  debug_assert(cd && cm && cu, "draggable card routed DOWN/MOVE/UP")
  debug_assert(stage.picked_words == "", "zero text selection on draggable card")
  sent.clear()
  t.drag(20.0, 80.0, 140.0, 100.0, steps=5)
  t.frame(ms=frame_ms)
  let mut vd = false
  let mut vm = false
  let mut vu = false
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, k, _, _, _, _, _, _, _) => {
        if k == proto::POINTER_DOWN { vd = true }
        if k == proto::POINTER_MOVE { vm = true }
        if k == proto::POINTER_UP { vu = true }
      }
      _ => ()
    }
  }
  debug_assert(vd && vm && vu, "canvas routed DOWN/MOVE/UP")
  debug_assert(stage.picked_words == "", "zero text selection on canvas")
  sent.clear()
  t.drag(5.0, 140.0, 120.0, 140.0, steps=5)
  t.frame(ms=frame_ms)
  debug_assert(stage.picked_words.length() > 0, "paragraph text selected")
  let mut bad_ptr = false
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, k, _, _, _, _, _, _, _) => {
        if k == proto::POINTER_DOWN || k == proto::POINTER_UP { bad_ptr = true }
      }
      _ => ()
    }
  }
  debug_assert(!bad_ptr, "text drag does not emit POINTER_DOWN/UP")
  t.dispose()
}

test "stage20a: native <input type=color> popup opens, picks swatch with input+change, and closes on Escape/outside" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=c1 type=color value=\"#2563eb\">" +
    "<input id=c2 type=color value=\"#000000\" disabled></body></html>",
    "body { margin: 0 } input { display: block; width: 44px; height: 24px; margin: 10px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let c1 = must(find_el(must(stage.doc.root()), "c1"))
  t.tap(24.0, 56.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.color_open.untracked().is_none(), "disabled color does not open")
  t.tap(24.0, 22.0)
  t.frame(ms=frame_ms)
  match stage.color_open.untracked() {
    Some(n) => debug_assert(n.wire_id == c1.wire_id, "c1 color popup opened")
    None => debug_assert(false, "expected color popup")
  }
  let mut has_hex = false
  for w in t.drawn_words_found() {
    if w.1 == "#2563eb" { has_hex = true }
  }
  debug_assert(has_hex, "current hex shown")
  t.key(17, mods=0)
  t.frame(ms=frame_ms)
  debug_assert(stage.color_open.untracked().is_none(), "Escape closed color popup")
  t.tap(24.0, 22.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.color_open.untracked().is_some(), "re-opened color popup")
  sent.clear()
  t.tap(33.0, 61.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.color_open.untracked().is_none(), "swatch click closed popup")
  debug_assert(html::control_value(c1) == "#ef4444", "picked swatch #ef4444")
  let edits : Array[(String, Int)] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, id, v, _, _, k) => if id == c1.wire_id { edits.push((v, k)) }
      _ => ()
    }
  }
  debug_assert(edits.length() == 2 && edits[0].0 == "#ef4444" && edits[0].1 == proto::EDIT_INPUT && edits[1].0 == "#ef4444" && edits[1].1 == proto::EDIT_CHANGE, "INPUT + CHANGE emitted")
  t.dispose()
}

test "stage20a: native title tooltip appears on hover, inherits from ancestor, and clears on leave or tap" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(360.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<div id=wrap title=\"Helpful ancestor tooltip\"><span id=inner>Hover me</span></div>" +
    "<div id=plain>Plain area</div></body></html>",
    "body { margin: 0 } #wrap { width: 200px; height: 40px } #plain { width: 200px; height: 40px }",
  )
  let t = shown_with_keys(stage, wide, h=640.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  debug_assert(stage.hover_title.untracked().0 == "", "no tooltip initially")
  t.move_to(50.0, 20.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.hover_title.untracked().0 == "Helpful ancestor tooltip", "ancestor tooltip shown")
  let mut drawn_tip = false
  for w in t.drawn_words_found() {
    if str_has_sub(w.1, "Helpful ancestor tooltip") { drawn_tip = true }
  }
  debug_assert(drawn_tip, "tooltip words drawn")
  t.move_to(50.0, 60.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.hover_title.untracked().0 == "", "tooltip cleared on leave")
  let mut still_tip = false
  for w in t.drawn_words_found() {
    if str_has_sub(w.1, "Helpful ancestor tooltip") { still_tip = true }
  }
  debug_assert(!still_tip, "tooltip words gone")
  t.move_to(50.0, 20.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.hover_title.untracked().0 == "Helpful ancestor tooltip", "tooltip back on hover")
  t.tap(50.0, 20.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.hover_title.untracked().0 == "", "tooltip cleared on tap")
  t.dispose()
}

test "stage20a: triple-click selects entire visual line and Shift+Click extends selection from anchor" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<p id=p1>Alpha beta gamma delta</p>" +
    "<p id=p2>Second line words</p></body></html>",
    "body { margin: 0; font-size: 16px } p { margin: 0; padding: 8px; height: 24px }",
  )
  let t = shown_with_keys(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  t.tap(24.0, 18.0)
  t.frame(ms=80.0)
  t.tap(24.0, 18.0)
  t.frame(ms=80.0)
  t.tap(24.0, 18.0)
  t.frame(ms=frame_ms)
  debug_assert(stage.picked_words == "Alpha beta gamma delta", "triple-click selected visual line")
  t.key(1000 + 'c'.to_int(), mods=8)
  t.frame(ms=frame_ms)
  debug_assert(t.clipboard() == "Alpha beta gamma delta", "Cmd+C copied line")
  t.frame(ms=500.0)
  t.tap(10.0, 18.0)
  t.frame(ms=frame_ms)
  t.hold_mods(1)
  t.tap(140.0, 58.0)
  t.frame(ms=frame_ms)
  t.hold_mods(0)
  debug_assert(str_has_sub(stage.picked_words, "Alpha"), "Shift+Click includes Alpha")
  debug_assert(str_has_sub(stage.picked_words, "Second"), "Shift+Click includes Second")
  t.key(1000 + 'c'.to_int(), mods=8)
  t.frame(ms=frame_ms)
  debug_assert(t.clipboard() == stage.picked_words, "Cmd+C copied extended selection")
  t.dispose()
}
