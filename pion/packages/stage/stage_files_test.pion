///| A page's file input answered by the system's own picker (files.pion).

test "a picked file's type is its extension's, and an input's accept takes what it names" {
  debug_assert(file_type_of("a.txt") == "text/plain", "txt type without charset")
  debug_assert(file_type_of("Photo.JPG") == "image/jpeg", "upper-case extension")
  debug_assert(file_type_of("noext") == "" && file_type_of("dot.") == "", "unknown types are empty")
  debug_assert(accept_matches("", "x.bin", ""), "no accept takes anything")
  debug_assert(accept_matches("image/*", "a.png", "image/png"), "image/* takes a png")
  debug_assert(!accept_matches("image/*", "a.pdf", "application/pdf"), "image/* refuses a pdf")
  debug_assert(accept_matches(" .PDF , image/png", "Report.pdf", "application/pdf"), ".pdf token, any case")
  debug_assert(accept_matches("application/pdf", "r.pdf", "application/pdf"), "a full type")
  debug_assert(!accept_matches(".pdf", "pdf", ""), "an extension token needs a name before it")
  debug_assert(accept_is_images("image/*,.jpg") && !accept_is_images("image/*,.pdf") && !accept_is_images(""), "picture-only accepts")
  let chosen = [("a.png", "1".to_bytes()), ("b.pdf", "2".to_bytes()), ("c.jpg", "3".to_bytes())]
  let all = files_for_input("image/*", true, chosen)
  debug_assert(all.length() == 2 && all[0].0 == "a.png" && all[0].1 == "image/png" && all[1].0 == "c.jpg", "multiple: every accepted file")
  let one = files_for_input("", false, chosen)
  debug_assert(one.length() == 1 && one[0].0 == "a.png", "single: only the first")
}

///| The system's picker faked: what it was asked for, and what it answers (`ready`: answered yet).
struct FakePicker {
  kinds : Array[Int]
  mut start_id : Int
  mut ready : Bool
  mut names : Array[String]
  ended : Array[Int]
}

fn fake_picker(t : StageTester) -> FakePicker {
  let fp = FakePicker::{ kinds: [], start_id: 7, ready: true, names: [], ended: [] }
  let h = hostapi::host()
  h.pk_start = fn(k : Int) -> Int { fp.kinds.push(k); fp.start_id }
  h.pk_state = fn(_id : Int) -> Int { if fp.ready { 1 } else { 0 } }
  h.pk_count = fn(_id : Int) -> Int { fp.names.length() }
  h.pk_name = fn(_id : Int, i : Int) -> String { fp.names[i] }
  h.pk_bytes = fn(_id : Int, i : Int) -> Bytes { ("data:" + fp.names[i]).to_bytes() }
  h.pk_info = fn(_id : Int, _i : Int) -> String { "" }
  h.pk_end = fn(id : Int) -> Unit { fp.ended.push(id) }
  ignore(t)
  fp
}

fn fake_picker_off(was : hostapi::Host) -> Unit {
  let h = hostapi::host()
  h.pk_start = was.pk_start
  h.pk_state = was.pk_state
  h.pk_count = was.pk_count
  h.pk_name = was.pk_name
  h.pk_bytes = was.pk_bytes
  h.pk_info = was.pk_info
  h.pk_end = was.pk_end
}

fn uploads(sent : Array[Bytes]) -> Array[(Int, Array[(String, String, Bytes)])] {
  let out : Array[(Int, Array[(String, String, Bytes)])] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::UploadFiles(id, files) => out.push((id, files))
      _ => ()
    }
  }
  out
}

test "a file input's picker is the system's: what was chosen is uploaded, filtered by accept and multiple" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(800.0)
  let t = shown(stage, wide)
  let base = hostapi::host()
  let was = hostapi::Host::{ ..base }
  let fp = fake_picker(t)
  stage.opened()
  stage.feed(TestHost::new("<input type=file id=f>", "").reset())
  t.run_for(frame_ms)
  // (answered at once, as the open panel's canned answer is)
  fp.names = ["a.png", "notes.txt", "b.jpg"]
  stage.feed(proto::encode_host(proto::HostMsg::PickFile(42, "image/*", true)))
  t.draw()
  debug_assert(fp.kinds.length() == 1 && fp.kinds[0] == 1, "image accept asks for pictures (kind 1)")
  let ups = uploads(sent)
  debug_assert(ups.length() == 1 && ups[0].0 == 42, "one upload to the input")
  debug_assert(ups[0].1.length() == 2 && ups[0].1[0].0 == "a.png" && ups[0].1[0].1 == "image/png" && ups[0].1[1].0 == "b.jpg", "only pictures")
  debug_assert(ups[0].1[0].2.to_string() == "data:a.png", "the file's own bytes")
  debug_assert(stage.file_pick().is_none(), "the ask is answered")
  // (answered later: nothing sent till the panel shuts; one file for an input without multiple)
  sent.clear()
  fp.ready = false
  fp.names = ["x.pdf", "y.pdf"]
  stage.feed(proto::encode_host(proto::HostMsg::PickFile(43, "", false)))
  t.draw()
  debug_assert(fp.kinds.length() == 2 && fp.kinds[1] == 2, "any file asks for files (kind 2)")
  debug_assert(uploads(sent).length() == 0, "nothing before the answer")
  debug_assert(stage.native_pick_hook != 0, "its answer is read between frames")
  fp.ready = true
  debug_assert(stage.native_pick_ready(), "answered")
  let ups2 = uploads(sent)
  debug_assert(ups2.length() == 1 && ups2[0].0 == 43 && ups2[0].1.length() == 1 && ups2[0].1[0].0 == "x.pdf" && ups2[0].1[0].1 == "application/pdf", "first file only")
  debug_assert(stage.native_pick_hook == 0, "no reading left after the answer")
  // (the same ask seen again, as the node is drawn anew: not asked twice)
  t.draw()
  debug_assert(fp.kinds.length() == 2, "one panel per ask")
  // (nothing chosen, or nothing the input takes: its picker cancelled)
  sent.clear()
  fp.names = []
  stage.feed(proto::encode_host(proto::HostMsg::PickFile(44, "", true)))
  t.draw()
  fp.names = ["a.pdf"]
  stage.feed(proto::encode_host(proto::HostMsg::PickFile(45, ".png", true)))
  t.draw()
  let ups3 = uploads(sent)
  debug_assert(ups3.length() == 2 && ups3[0].0 == 44 && ups3[0].1.length() == 0 && ups3[1].0 == 45 && ups3[1].1.length() == 0, "cancelled")
  // (no picker on this host: cancelled at once)
  sent.clear()
  fp.start_id = 0
  stage.feed(proto::encode_host(proto::HostMsg::PickFile(46, "", true)))
  t.draw()
  let ups4 = uploads(sent)
  debug_assert(ups4.length() == 1 && ups4[0].0 == 46 && ups4[0].1.length() == 0, "no picker: cancelled")
  t.dispose()
  fake_picker_off(was)
}

test "files dropped from the desktop on the page go to the host at the point of the page they were let go" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(800.0)
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(b : view::View) -> Unit {
        let _ = b.height(view::Live::Is(Some(40.0)))
      })
      let _ = root.box(fn(b : view::View) -> Unit {
        let _ = b.width(view::Live::By(fn() -> Option[Double] { Some(wide.get()) })).grow(view::Live::Is(1.0))
        let _ = stage_node(b, stage)
      })
    },
    w=800.0,
    h=600.0,
  )
  t.draw()
  stage.opened()
  stage.feed(TestHost::new("<div id=zone style='height:200px'>drop here</div><p id=low>low</p>", "").reset())
  t.run_for(frame_ms)
  let zone = must(find_el(must(stage.doc.root()), "zone")).wire_id
  // (the host says where they are held, as it posts them on mbui.drop: the page told live, at the element there)
  t.inner.post("mb" + "ui.drop", "{\"type\":\"over\",\"x\":100.0,\"y\":100.0}")
  t.run_for(frame_ms)
  t.inner.post("mb" + "ui.drop", "{\"type\":\"over\",\"x\":100.0,\"y\":100.0}")
  t.run_for(frame_ms)
  t.inner.post("mb" + "ui.drop", "{\"type\":\"over\",\"x\":120.0,\"y\":140.0}")
  t.run_for(frame_ms)
  let overs : Array[(Int, Double, Double, Double, Double)] = []
  let mut leaves = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::DragOver(id, rx, ry, x, y) => overs.push((id, rx, ry, x, y))
      proto::ClientMsg::DragLeave => leaves += 1
      _ => ()
    }
  }
  debug_assert(overs.length() == 2, "a DragOver each time they move, not while they rest: " + overs.length().to_string())
  debug_assert(overs[0].0 == zone && overs[0].0 > 0, "over the zone, by its wire id")
  debug_assert(overs[1].3 == 120.0 && (overs[1].4 - 100.0).abs() < 0.5, "at the page's point")
  debug_assert(overs[1].2 > 0.0 && overs[1].2 < 1.0, "its fraction of the zone's box")
  debug_assert(leaves == 0, "no leave while over the page")
  // (let go there: the host's drop message gives where; ui then gives the files to the page's receiver)
  sent.clear()
  t.inner.post("mb" + "ui.drop", "{\"type\":\"drop\",\"x\":120.0,\"y\":140.0}")
  t.run_for(frame_ms)
  let empty = Bytes::new(0)
  debug_assert(
    t.inner.hold_files(
      [
        hostapi::Picked::{ name: "photo.png", bytes: "PNG".to_bytes(), held: 0, size: 3.0, src: "" },
        hostapi::Picked::{ name: "folder", bytes: empty, held: 0, size: 96.0, src: "" },
        hostapi::Picked::{ name: "empty.txt", bytes: empty, held: 0, size: 0.0, src: "" },
      ],
      x=120.0,
      y=140.0,
    ),
    "the page receives files",
  )
  let drops : Array[(Int, Double, Double, Double, Double, Array[(String, String, Bytes)])] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::DropFiles(id, rx, ry, x, y, files) => drops.push((id, rx, ry, x, y, files))
      _ => ()
    }
  }
  debug_assert(drops.length() == 1, "one drop")
  let (id, _, _, x, y, files) = drops[0]
  debug_assert(id == zone, "at the zone, by its wire id")
  debug_assert(x == 120.0 && (y - 100.0).abs() < 0.5, "at the page's point: " + x.to_string() + "," + y.to_string())
  debug_assert(files.length() == 2 && files[0].0 == "photo.png" && files[0].1 == "image/png" && files[0].2.to_string() == "PNG", "the file, typed")
  debug_assert(files[1].0 == "empty.txt" && files[1].1 == "text/plain", "an empty file kept, a folder not")
  // (held again, then carried off the window: one DragLeave)
  sent.clear()
  t.inner.post("mb" + "ui.drop", "{\"type\":\"over\",\"x\":120.0,\"y\":140.0}")
  t.run_for(frame_ms)
  t.inner.post("mb" + "ui.drop", "{\"type\":\"left\"}")
  t.run_for(frame_ms)
  t.inner.post("mb" + "ui.drop", "{\"type\":\"left\"}")
  t.run_for(frame_ms)
  let mut left_n = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::DragLeave => left_n += 1
      _ => ()
    }
  }
  debug_assert(left_n == 1, "one leave: " + left_n.to_string())
  // (nothing that can be given: nothing sent)
  sent.clear()
  stage.dropped_at([hostapi::Picked::{ name: "folder", bytes: empty, held: 0, size: 96.0, src: "" }], 120.0, 140.0)
  debug_assert(said(sent).length() == 0, "a folder alone sends nothing")
  // (too large: not sent, the person told)
  let noted : Array[String] = []
  stage.set_noter(fn(m : String) -> Unit { noted.push(m) })
  stage.dropped_at([hostapi::Picked::{ name: "film.mov", bytes: empty, held: 5, size: 900000000.0, src: "" }], 120.0, 140.0)
  debug_assert(said(sent).length() == 0, "a held file too large sends nothing")
  debug_assert(noted.length() == 1 && noted[0].contains("film.mov") && noted[0].contains("too large"), "the person told: " + noted.join("|"))
  let (fit, big) = files_within_most([
    hostapi::Picked::{ name: "a", bytes: Bytes::new(FILES_GIVEN_MOST - 10), held: 0, size: 0.0, src: "" },
    hostapi::Picked::{ name: "b", bytes: Bytes::new(20), held: 0, size: 20.0, src: "" },
    hostapi::Picked::{ name: "c", bytes: Bytes::new(5), held: 0, size: 5.0, src: "" },
  ])
  debug_assert(fit.length() == 2 && fit[0].name == "a" && fit[1].name == "c" && big.length() == 1 && big[0] == "b", "the cap counts all of a drop's bytes")
  t.dispose()
}
