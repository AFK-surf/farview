///| A page's `<input type=file>` answered with the person's own files: the system's open panel (`hostapi::pick`),
///| what was chosen filtered by the input's `accept` and cut to one where it takes one, each given the type a browser
///| gives a `File` (by its name's extension, as Chrome does), handed to the host (`Stage::give_files`) or the picker
///| cancelled there (`Stage::cancel_file_pick`: the input's `cancel` event).

///| The MIME type a browser gives a picked or dropped file named `name` (`File.type`): by its extension, without
///| parameters (`text/plain`, not `text/plain; charset=utf-8`); "" where it is not known, as Chrome leaves it.
pub fn file_type_of(name : String) -> String {
  let mut dot = name.length() - 1
  while dot >= 0 && name.code_unit_at(dot) != 46 {
    dot -= 1
  }
  if dot < 0 || dot + 1 >= name.length() {
    return ""
  }
  let ext = name.slice(dot + 1, name.length())
  match mime::mime_from_extension(ext) {
    Some(t) => {
      let semi = t.index_of(";")
      if semi >= 0 { t.slice(0, semi).trim() } else { t }
    }
    None => ""
  }
}

///| An `accept` attribute's tokens (HTML §4.10.5.1.18): comma-separated, trimmed, lowercased, the empty ones dropped.
fn accept_tokens(accept : String) -> Array[String] {
  let out : Array[String] = []
  for raw in accept.split(",") {
    let t = st_ascii_lower(raw.trim())
    if t != "" {
      out.push(t)
    }
  }
  out
}

///| Whether a file named `name`, of type `ty`, is one an input's `accept` takes: no tokens, any file; else one token
///| matching it (`.ext` by its name's ending, `image/*` `audio/*` `video/*` by its type's major part, a full type
///| exactly).
pub fn accept_matches(accept : String, name : String, ty : String) -> Bool {
  let toks = accept_tokens(accept)
  if toks.length() == 0 {
    return true
  }
  let lname = st_ascii_lower(name)
  let lty = st_ascii_lower(ty)
  for t in toks {
    if t.starts_with(".") {
      if lname.ends_with(t) && lname.length() > t.length() {
        return true
      }
    } else if t.ends_with("/*") {
      let major = t.slice(0, t.length() - 1)
      if lty.starts_with(major) {
        return true
      }
    } else if t == lty {
      return true
    }
  }
  false
}

///| Whether every token of `accept` names a picture (`image/*`, `image/png`, `.jpg`…): the system's picker then
///| offers pictures alone (`hostapi::PickKind::Photos`: the open panel kept to images on the desktop, the photo
///| library on a phone).
pub fn accept_is_images(accept : String) -> Bool {
  let toks = accept_tokens(accept)
  if toks.length() == 0 {
    return false
  }
  for t in toks {
    let ok = if t.starts_with(".") {
      file_type_of("x" + t).starts_with("image/")
    } else {
      t.starts_with("image/")
    }
    if !ok {
      return false
    }
  }
  true
}

///| What of the files chosen (`name`, bytes) an input takes: those its `accept` takes, each with its type; only the
///| first of them where it takes one file (no `multiple`).
pub fn files_for_input(accept : String, multiple : Bool, chosen : Array[(String, Bytes)]) -> Array[(String, String, Bytes)] {
  let out : Array[(String, String, Bytes)] = []
  for c in chosen {
    let (name, data) = c
    let ty = file_type_of(name)
    if accept_matches(accept, name, ty) {
      out.push((name, ty, data))
      if !multiple {
        break
      }
    }
  }
  out
}

///| The picker the host asked for (`HostMsg::PickFile`, the `picks`-th) opened, once: the system's open panel asked
///| (none here: the input's picker cancelled at once); its answer read as it comes (`Stage::native_pick_ready`).
fn Stage::ask_native_pick(self : Stage, asked : Option[(Int, Int, String, Bool)]) -> Unit {
  let (n, id, accept, multiple) = match asked {
    Some(a) => a
    None => return
  }
  if n <= self.native_pick_seen {
    return
  }
  self.native_pick_seen = n
  // (one still open for an earlier ask: that input's picker shut unanswered, as a new click replaces it)
  match self.native_pick {
    Some((old_id, _, _, p)) => {
      self.native_pick = None
      hostapi::forget_dropped(p.id())
      self.cancel_file_pick(old_id)
    }
    None => ()
  }
  // (a tab not shown asks nothing of the person: its input's picker cancelled)
  if self.node is None {
    self.cancel_file_pick(id)
    return
  }
  let kind = if accept_is_images(accept) { hostapi::PickKind::Photos } else { hostapi::PickKind::Files }
  match hostapi::pick(kind, hold=false) {
    None => self.cancel_file_pick(id)
    Some(p) => {
      self.native_pick = Some((id, accept, multiple, p))
      if !self.native_pick_ready() && self.native_pick_hook == 0 {
        // (answered later, the panel shut: the host says so between frames (`set_outside` kind 3) and asks for one)
        self.native_pick_hook = ui::on_before_frame(fn() -> Unit { let _ = self.native_pick_ready() })
      }
    }
  }
}

///| The system's picker's answer, if it has come: the files it gave handed to the input (none, or none it takes:
///| cancelled); true once answered (nothing open then).
fn Stage::native_pick_ready(self : Stage) -> Bool {
  let (id, accept, multiple, p) = match self.native_pick {
    Some(t) => t
    None => return true
  }
  let got = match p.files() {
    Some(fs) => fs
    None => return false
  }
  self.native_pick = None
  if self.native_pick_hook != 0 {
    ui::remove_before_frame(self.native_pick_hook)
    self.native_pick_hook = 0
  }
  let (fit, big) = files_within_most(got)
  let chosen : Array[(String, Bytes)] = []
  for f in fit {
    chosen.push((f.name, f.bytes))
  }
  let files = files_for_input(accept, multiple, chosen)
  if big.length() > 0 {
    self.too_big(big)
  } else if files.length() == 0 && got.length() > 0 {
    self.note_person(if accept_tokens(accept).length() == 0 { "The page could not be given that file." } else { "The page takes only " + accept + " here." })
  }
  if files.length() == 0 {
    self.cancel_file_pick(id)
  } else {
    self.give_files(id, files)
  }
  true
}

///| The most bytes of files given a page at once (one pick or one drop): each is read whole on the person's device,
///| sent in one message and made a page's `File` from one string on the host, so past this a person's video would
///| stall both and could pass what one script string may hold. Those past it are not given, and the person told.
pub let FILES_GIVEN_MOST : Int = 67108864

///| Of files picked or dropped (`got`), those given (their bytes read, in all within `FILES_GIVEN_MOST`) and the
///| names of those too large (past it, or held by the system unread); folders and what could not be read are
///| neither.
pub fn files_within_most(got : Array[hostapi::Picked]) -> (Array[hostapi::Picked], Array[String]) {
  let fit : Array[hostapi::Picked] = []
  let big : Array[String] = []
  let mut total = 0
  for f in got {
    if f.name == "" {
      continue
    }
    if f.bytes.length() == 0 && f.size > 0.0 {
      // (held unread: one the system kept for its size; a folder has no bytes and is given nothing, quietly)
      if f.held != 0 || f.size > FILES_GIVEN_MOST.to_double() {
        big.push(f.name)
      }
      continue
    }
    if total + f.bytes.length() > FILES_GIVEN_MOST {
      big.push(f.name)
      continue
    }
    total += f.bytes.length()
    fit.push(f)
  }
  (fit, big)
}

///| What tells the person what the page could not be given (the shell's toast); none by default.
pub fn Stage::set_noter(self : Stage, f : (String) -> Unit) -> Unit {
  self.noter = Some(f)
}

fn Stage::note_person(self : Stage, msg : String) -> Unit {
  match self.noter {
    Some(f) => f(msg)
    None => ()
  }
}

fn Stage::too_big(self : Stage, names : Array[String]) -> Unit {
  let what = if names.length() == 1 { "\u{201C}" + names[0] + "\u{201D} is" } else { names.length().to_string() + " files are" }
  self.note_person(what + " too large to give the page (over " + (FILES_GIVEN_MOST / 1048576).to_string() + " MB).")
}

///| Where files dragged in from the desktop were last held or let go over a window (its points), as the host says
///| on `mbui.drop` ({"type":"over"|"drop","x","y"} or {"type":"left"}): read ahead of ui's own handling, which gives
///| a drop's files to the receiver there (`ui::files_into`) without where. While they are held, the page under them
///| is told (`Stage::drag_moved`), so its drop zones see dragenter, dragover and dragleave live.
let drop_point : signals::Ref[(Double, Double)] = ui::ref_new((0.0, 0.0))
let drop_point_watched : signals::Ref[Bool] = ui::ref_new(false)
let drag_watchers : Array[(Int, Stage)] = []
let drag_watch_seq : signals::Ref[Int] = ui::ref_new(0)

///| A page shown told of drags from the desktop over its window; its key, to stop (`unwatch_drags`).
fn watch_drags(st : Stage) -> Int {
  drag_watch_seq.v = drag_watch_seq.v + 1
  drag_watchers.push((drag_watch_seq.v, st))
  drag_watch_seq.v
}

fn unwatch_drags(key : Int) -> Unit {
  let keep : Array[(Int, Stage)] = []
  for w in drag_watchers {
    if w.0 != key {
      keep.push(w)
    }
  }
  drag_watchers.clear()
  for w in keep {
    drag_watchers.push(w)
  }
}

fn watch_drop_points() -> Unit {
  if drop_point_watched.v {
    return
  }
  drop_point_watched.v = true
  ui::on_messages_ahead("mb" + "ui.drop", fn(batch : Array[Option[(String, Option[Bytes])]]) -> Unit {
    for m in batch {
      match m {
        Some((json, _)) => note_drop_point(json)
        None => ()
      }
    }
  })
}

///| A host's drop message read: an "over" or a "drop" for where it is (x and y), an "over" told to each page shown,
///| a "left" to each that had them over it.
fn note_drop_point(json : String) -> Unit {
  match hostapi::json_parse(json) {
    Some(hostapi::JsonValue::JObject(o)) => {
      let kind = match o.get("type") {
        Some(hostapi::JsonValue::JString(s)) => s
        _ => ""
      }
      if kind == "left" {
        for w in drag_watchers {
          w.1.drag_gone()
        }
        return
      }
      if kind != "over" && kind != "drop" {
        return
      }
      match (o.get("x"), o.get("y")) {
        (Some(hostapi::JsonValue::JNumber(x)), Some(hostapi::JsonValue::JNumber(y))) => {
          drop_point.v = (x, y)
          if kind == "over" {
            for w in drag_watchers {
              w.1.drag_moved(x, y)
            }
          }
        }
        _ => ()
      }
    }
    _ => ()
  }
}

///| A point of the window (`wx`, `wy`) as the page's: CSS px from the top left of what shows, or None off it.
fn Stage::window_point(self : Stage, wx : Double, wy : Double) -> Option[(Double, Double)] {
  let (vx, vy, vw, vh) = match self.node {
    Some(v) => v.rect()
    None => return None
  }
  if wx < vx || wy < vy || wx >= vx + vw || wy >= vy + vh {
    return None
  }
  let z = self.zoom.untracked()
  Some(((wx - vx) / z, (wy - vy) / z))
}

///| Where a point of what shows (`x`, `y`) is as `Pointer` says it: the element there (its wire id, 0 for none) and
///| the point's fraction of its box, so the host finds the same element whatever its own layout or scroll.
fn Stage::drag_target(self : Stage, x : Double, y : Double) -> (Int, Double, Double) {
  match self.element_at(x, y + self.page_y) {
    Some((el, rx, ry)) => (el.wire_id, rx, ry)
    None => (0, 0.0, 0.0)
  }
}

///| Files from the desktop held at `(wx, wy)` in the window: over this page, the host told where (DragOver), each
///| time they move; off it, a DragLeave where they had been over it.
fn Stage::drag_moved(self : Stage, wx : Double, wy : Double) -> Unit {
  let (x, y) = match self.window_point(wx, wy) {
    Some(p) => p
    None => {
      self.drag_gone()
      return
    }
  }
  if self.drag_held && self.drag_at.0 == x && self.drag_at.1 == y {
    return
  }
  self.drag_held = true
  self.drag_at = (x, y)
  let (id, rx, ry) = self.drag_target(x, y)
  self.out(proto::ClientMsg::DragOver(id, rx, ry, x, y))
}

///| Files from the desktop carried off this page (or the drag given up): the host's DragLeave, once.
fn Stage::drag_gone(self : Stage) -> Unit {
  if !self.drag_held {
    return
  }
  self.drag_held = false
  self.drag_at = (-1.0, -1.0)
  self.out(proto::ClientMsg::DragLeave)
}

///| Files dropped on the page from the desktop (`files`), let go at `(wx, wy)` in the window: sent to the host at
///| the element there (as `Pointer` says it), each typed by its name; those too large not sent, the person told;
///| none to send, the drag left.
fn Stage::dropped_at(self : Stage, files : Array[hostapi::Picked], wx : Double, wy : Double) -> Unit {
  let (fit, big) = files_within_most(files)
  if big.length() > 0 {
    self.too_big(big)
  }
  let out : Array[(String, String, Bytes)] = []
  for f in fit {
    out.push((f.name, file_type_of(f.name), f.bytes))
  }
  let (x, y) = match self.window_point(wx, wy) {
    Some(p) => p
    None => {
      self.drag_gone()
      return
    }
  }
  if out.length() == 0 {
    self.drag_gone()
    return
  }
  self.drag_held = false
  self.drag_at = (-1.0, -1.0)
  let (id, rx, ry) = self.drag_target(x, y)
  self.out(proto::ClientMsg::DropFiles(id, rx, ry, x, y, out))
}
