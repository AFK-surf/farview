///| 1:1 port of `client/src/stage/stage_bench_wbtest.mbt` (2 benchmarks).

import "proto"
import "signals"

test "bench: stage11a large page relayout and pointer_moved" {
  let buf = StringBuilder::new()
  buf.write_string("<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>")
  buf.write_string("<div class=hdr id=hdr><span>Fixed Header</span><span id=counter>0</span></div>")
  buf.write_string("<div class=wrap>")
  let mut s = 0
  while s < 3 {
    buf.write_string("<div class=scroller id=sc" + s.to_string() + ">")
    let mut i = 0
    while i < 130 {
      buf.write_string(
        "<div class=card><div class=ct>Card " + s.to_string() + "-" + i.to_string() +
        "</div><div class=cb>Body text for item " + i.to_string() + "</div><div class=tag>TAG</div></div>",
      )
      i += 1
    }
    buf.write_string("</div>")
    s += 1
  }
  buf.write_string("</div></body></html>")
  let css_src = "body { margin: 0; font-family: sans-serif; } " +
  ".hdr { position: fixed; top: 0; left: 0; width: 100%; height: 48px; background: #1e293b; color: #fff; display: flex; justify-content: space-between; align-items: center; } " +
  ".wrap { padding-top: 56px; display: flex; gap: 12px; } " +
  ".scroller { width: 320px; height: 600px; overflow-y: auto; } " +
  ".card { margin: 8px; padding: 10px; border-radius: 10px; border: 1px solid #cbd5e1; background: #f8fafc; box-shadow: 0 2px 6px rgba(0,0,0,0.12); } " +
  ".ct { font-size: 14px; font-weight: bold; color: #0f172a; } " +
  ".cb { font-size: 12px; color: #475569; } " +
  ".tag { display: inline-block; border-radius: 6px; padding: 2px 6px; background: #e2e8f0; color: #334155; font-size: 11px; }"
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(1024.0)
  let host = TestHost::new(buf.to_string(), css_src)
  let t = shown(stage, wide)
  stage.opened()
  stage.feed(host.reset())
  t.run_for(shown_ms)
  let counter = must(find_el(host.doc, "counter"))
  let leaves_before = leaves_made[0]
  let mut i = 1
  while i <= 100 {
    counter.children[0].data = i.to_string()
    stage.feed(host.patch(0))
    t.frame(ms=16.0)
    i += 1
  }
  let leaves_after = leaves_made[0]
  let mut hits = 0
  i = 0
  while i < 100 {
    let x = 40.0 + (i % 10).to_double() * 80.0
    let y = 60.0 + (i / 10).to_double() * 50.0
    if stage.element_at(x, y).is_some() {
      hits += 1
    }
    i += 1
  }
  let _ = leaves_after - leaves_before
  debug_assert(hits > 0, "pointer_moved hit elements")
  t.dispose()
}

test "bench: stage11a 120 canvas frames" {
  let forgotten : Array[String] = []
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) }, forget=fn(k : String) -> Unit { forgotten.push(k) })
  let wide = signals::signal(640.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body><canvas id=c width=300 height=150></canvas></body></html>",
    "body { margin: 0; } canvas { display: block; width: 300px; height: 150px; }",
  )
  let t = shown(stage, wide)
  stage.opened()
  let canvas_el = must(find_el(host.doc, "c"))
  let px = FixedArray::make(4 * 4 * 4, 0x80.to_byte())
  let png_bytes = png(px, 4, 4)
  canvas_el.src_url = Some("fvcanvas:1/1")
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:1/1", 0, 4.0, 4.0, png_bytes)))
  stage.feed(host.reset())
  t.run_for(shown_ms)
  let leaves_base = leaves_made[0]
  let mut v = 2
  while v <= 120 {
    let u = "fvcanvas:1/" + v.to_string()
    canvas_el.src_url = Some(u)
    stage.feed(proto::encode_host(proto::HostMsg::Asset(u, 0, 4.0, 4.0, png_bytes)))
    stage.feed(host.patch(0))
    t.frame(ms=16.0)
    v += 1
  }
  let leaves_delta = leaves_made[0] - leaves_base
  let _ = leaves_delta
  debug_assert(stage.pictures.length() >= 1, "pictures retained")
  t.dispose()
}
