///| Unit tests for `pion/packages/stage` (independent of `ui::Tester`):
///| covers PNG round-trip via `invar/pixels`, SVG `data_picture_here` via `invar/svg`,
///| `page_keys` bindings, Gregorian `date` math, `color`/`select` predicates,
///| `scene_groups` + `invar/skia` gradient/shadow/turned rasterization,
///| and `Stage` wire protocol (`Meta`, `Reset`, `Patch`, `Asset`, `Downloaded`, `zoom`, `find`).

import "html"
import "display"
import "proto"
import "pixels"

test "stage: png stored-deflate encoder round-trips through invar/pixels" {
  let px = FixedArray::make(4 * 4 * 4, 0 as Byte)
  // Top-left pixel: red (255, 0, 0, 255); bottom-right pixel: blue (0, 0, 255, 255)
  px[0] = 255.to_byte()
  px[3] = 255.to_byte()
  let last = (3 * 4 + 3) * 4
  px[last + 2] = 255.to_byte()
  px[last + 3] = 255.to_byte()
  let encoded = png(px, 4, 4)
  debug_assert(pixels::is_png(encoded), "PNG magic valid")
  debug_assert(data_picture_here(encoded), "data_picture_here accepts PNG")
  match pixels::image_size(encoded) {
    Some((w, h)) => debug_assert(w == 4 && h == 4, "PNG 4x4 size")
    None => debug_assert(false, "image_size failed")
  }
  match pixels::decode_png(encoded) {
    Some((w, h, rgba)) => {
      debug_assert(w == 4 && h == 4, "decoded 4x4")
      debug_assert((rgba[0].to_int() & 0xFF) == 255 && (rgba[3].to_int() & 0xFF) == 255, "top-left red")
      debug_assert((rgba[last + 2].to_int() & 0xFF) == 255 && (rgba[last + 3].to_int() & 0xFF) == 255, "bottom-right blue")
    }
    None => debug_assert(false, "decode_png failed")
  }
}

test "stage: data_picture_here + data_picture_size for SVG via invar/svg" {
  let svg_bytes = "<svg xmlns='http://www.w3.org/2000/svg' width='48' height='24'><rect width='48' height='24' fill='#2563eb'/></svg>".to_bytes()
  debug_assert(data_picture_here(svg_bytes), "SVG accepted by data_picture_here")
  match data_picture_size(svg_bytes) {
    Some((w, h)) => debug_assert(w == 48.0 && h == 24.0, "SVG size 48x24")
    None => debug_assert(false, "SVG data_picture_size failed")
  }
  debug_assert(!data_picture_here("hello world".to_bytes()), "plain text rejected")
}

test "stage: page_keys bindings and key_dom / shifted / dom_mods" {
  let bindings = page_keys()
  debug_assert(bindings.length() > 150, "page_keys emits full caret + field + page bindings")
  match key_dom(17) {
    Some((k, c, m)) => debug_assert(k == "Escape" && c == "Escape" && m == 0, "Escape key_dom")
    None => debug_assert(false, "Escape key_dom missing")
  }
  match key_dom(1097) {
    Some((k, c, _)) => debug_assert(k == "a" && c == "KeyA", "char 'a' key_dom")
    None => debug_assert(false, "char 'a' key_dom missing")
  }
  debug_assert(shifted(97) == 65 && shifted(47) == 63, "shifted 'a'->'A', '/'->'?'")
  debug_assert(dom_mods(1 | 8) == (8 | 4), "Shift+Meta -> DOM bits 12")
}

test "stage: Gregorian date math, parse_ymd, shift_ym, month_cells & range clamp" {
  debug_assert(is_leap_year(2024) && !is_leap_year(2100) && is_leap_year(2000), "leap year rules")
  debug_assert(days_in_month(2024, 2) == 29 && days_in_month(2026, 2) == 28, "Feb days")
  debug_assert(weekday_of(2026, 11, 21) == 6, "2026-11-21 is Saturday")
  match parse_ymd("2026-11-21") {
    Some((y, m, d)) => debug_assert(y == 2026 && m == 11 && d == 21, "parse_ymd exact")
    None => debug_assert(false, "parse_ymd failed")
  }
  debug_assert(parse_ymd("2026-02-30").is_none(), "invalid calendar date rejected")
  debug_assert(format_ymd(2026, 3, 5) == "2026-03-05", "format_ymd padded")
  let (ny, nm) = shift_ym(2026, 12, 1)
  debug_assert(ny == 2027 && nm == 1, "shift_ym year rollover")
  let cells = month_cells(2026, 11)
  debug_assert(cells.length() == 42, "6x7 calendar grid")
  debug_assert(date_in_range((2026, 11, 15), Some((2026, 11, 1)), Some((2026, 11, 30))), "in range")
  debug_assert(!date_in_range((2026, 10, 31), Some((2026, 11, 1)), None), "before min")
}

fn first_input(src : String) -> html::Node {
  let doc = html::parse(src)
  let walk : Array[html::Node] = [doc]
  while walk.length() > 0 {
    let n = walk[walk.length() - 1]
    let _ = walk.pop()
    if n.kind is html::Kind::Element && n.tag == "input" {
      return n
    }
    for ch in n.children {
      walk.push(ch)
    }
  }
  doc
}

test "stage: color/select/range/number predicates and step math" {
  let c = first_input("<input type=color>")
  debug_assert(is_color(c), "color input detected")
  debug_assert(color_rgba_of("#2563eb") == 0x2563EBFFL, "color_rgba_of hex")

  let r = first_input("<input type=range min=0 max=10 step=2>")
  debug_assert(is_range(r), "range input detected")
  debug_assert(range_value_for(r, 0.4) == "4", "range 0.4 -> 4")

  let num = first_input("<input type=number min=0 max=5 step=2 value=4>")
  debug_assert(is_number_steppable(num), "number input steppable")
  debug_assert(number_step(num, 1) == "5", "number_step clamped to max 5")
  debug_assert(number_step(num, -1) == "2", "number_step down to 2")
}

test "stage: scene_groups + invar/skia gradient, shadow & turned rasterization" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let items : Array[display::Item] = [
    display::Item::Rect(0.0, 0.0, 200.0, 100.0, 0xFFFFFFFF),
    display::Item::Clip(10.0, 10.0, 80.0, 40.0),
    display::Item::Rect(10.0, 10.0, 50.0, 20.0, 0xFF0000FF),
    display::Item::Unclip,
    display::Item::Transform(20.0, 20.0, 1.0, 0.5, 0.0, 1.0, 0.0, 0.0),
    display::Item::Rect(10.0, 10.0, 20.0, 20.0, 0x00FF00FF),
    display::Item::Untransform,
  ]
  let groups = scene_groups(items, "")
  match groups.get("") {
    Some(root_g) => debug_assert(root_g.kids.length() == 3, "root has rect + clip group + skewed turned group")
    None => debug_assert(false, "root group missing")
  }
  let grad = display::Item::Gradient(0.0, 0.0, 40.0, 20.0, 0, [0.0, 0.0, 40.0, 0.0], [0.0, 1.0], [0xFF0000FF, 0x0000FFFF])
  let gkey = stage.gradient_picture(grad)
  debug_assert(gkey.starts_with("fvgrad:") && stage.drawn_count() == 1, "skia gradient picture generated")
  let wgrad = display::Item::Gradient(0.0, 0.0, 100.0, 10.0, 0, [0.0, 0.0, 100.0, 0.0], [0.0, 1.0], [0xFFFFFFFF, 0x00000000])
  let wkey = stage.gradient_picture(wgrad)
  match stage.drawn.get(wkey) {
    Some(png_bytes) => match pixels::decode_png(png_bytes) {
      Some((gw, gh, rgba)) => {
        let mid = ((gh / 2) * gw + (gw / 2)) * 4
        let mr = rgba[mid].to_int() & 0xFF
        let mg = rgba[mid + 1].to_int() & 0xFF
        let mb = rgba[mid + 2].to_int() & 0xFF
        let ma = rgba[mid + 3].to_int() & 0xFF
        debug_assert(mr == 255 && mg == 255 && mb == 255 && ma >= 124 && ma <= 132, "white->transparent gradient midpoint must stay pure white premultiplied (got rgb=(" + mr.to_string() + "," + mg.to_string() + "," + mb.to_string() + ") a=" + ma.to_string() + ")")
      }
      None => debug_assert(false, "white->transparent gradient PNG must decode")
    }
    None => debug_assert(false, "white->transparent gradient must be cached in stage.drawn")
  }
  let sh = display::Item::Shadow(10.0, 10.0, 40.0, 20.0, [2.0, 4.0, 6.0, 0.0, 4.0, 4.0, 4.0, 4.0, 1.0], 0x00000080, false)
  let skey = stage.shadow_picture(sh)
  debug_assert(skey.starts_with("fvshadow:") && stage.drawn_count() == 3, "shadow picture generated")
}

test "stage: Stage wire feed (Meta, Reset, Asset, Downloaded, zoom, find) + real doc layout" {
  let sent : Array[Bytes] = []
  let forgotten : Array[String] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) }, forget=fn(k : String) -> Unit { forgotten.push(k) })
  stage.opened()
  debug_assert(stage.live(), "stage live after opened")
  debug_assert(sent.length() >= 1, "Hello sent on opened")
  stage.feed(proto::encode_host(proto::HostMsg::Meta("https://example.com/", "Example", false, true, false)))
  debug_assert(stage.url() == "https://example.com/", "Meta url")
  debug_assert(stage.title() == "Example", "Meta title")
  debug_assert(stage.can_back() && !stage.can_forward(), "Meta history flags")
  stage.zoom_in()
  debug_assert(stage.zoom() > 1.0, "zoom_in increases zoom")
  stage.zoom_reset()
  debug_assert(stage.zoom() == 1.0, "zoom_reset returns to 1.0")
  stage.feed(proto::encode_host(proto::HostMsg::Downloaded("report.txt", "https://example.com/r", "text/plain", "ok".to_bytes())))
  debug_assert(stage.downloads_seq() == 1, "downloads_seq incremented")
  let dls = stage.take_downloads()
  debug_assert(dls.length() == 1 && dls[0].0 == "report.txt", "take_downloads returns item")
  stage.closed()
  debug_assert(!stage.live(), "stage not live after closed")
}

test "stage: smart omnibox normalize_address, zoom_percent, and keyboard page scrolling" {
  debug_assert(normalize_address("rust-lang.org") == "https://rust-lang.org", "bare domain gets https://")
  debug_assert(normalize_address("  go.dev/doc  ") == "https://go.dev/doc", "trimmed domain+path gets https://")
  debug_assert(normalize_address("localhost:3000") == "http://localhost:3000", "localhost:port gets http://")
  debug_assert(normalize_address("127.0.0.1:8080/api") == "http://127.0.0.1:8080/api", "127.0.0.1:port gets http://")
  debug_assert(normalize_address("https://vite.dev/") == "https://vite.dev/", "existing https preserved")
  debug_assert(normalize_address("about:blank") == "about:blank", "about: scheme preserved")
  debug_assert(normalize_address("//example.com/a") == "https://example.com/a", "protocol-relative gets https:")

  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  debug_assert(stage.zoom_percent() == 100, "default zoom_percent is 100")
  stage.zoom_in()
  debug_assert(stage.zoom_percent() > 100, "zoom_in raises zoom_percent")
  stage.zoom_reset()
  debug_assert(stage.zoom_percent() == 100, "zoom_reset restores 100")

  stage.room = (1280.0, 800.0)
  stage.size.set((1280.0, 3200.0))
  debug_assert(stage.scroll_y() == 0.0, "initial scroll_y is 0")
  stage.scroll_page_down()
  let y1 = stage.scroll_y()
  debug_assert(y1 > 600.0 && y1 < 800.0, "scroll_page_down advances ~1 viewport")
  stage.scroll_bottom()
  debug_assert((stage.scroll_y() - 2400.0).abs() < 1.0, "scroll_bottom jumps to max scroll")
  stage.scroll_page_up()
  debug_assert(stage.scroll_y() < 2400.0 && stage.scroll_y() > 1500.0, "scroll_page_up moves up ~1 viewport")
  stage.scroll_top()
  debug_assert(stage.scroll_y() == 0.0, "scroll_top returns to 0")

  // Verify free scroll keys are present in page_keys()
  let keys = page_keys()
  let mut has_pgdn = false
  let mut has_pgup = false
  let mut has_home = false
  let mut has_end = false
  let mut has_cmd_up = false
  let mut has_cmd_down = false
  for b in keys {
    if b.action == free_action(16, 0) { has_pgdn = true }
    if b.action == free_action(15, 0) { has_pgup = true }
    if b.action == free_action(8, 0) { has_home = true }
    if b.action == free_action(9, 0) { has_end = true }
    if b.action == free_action(5, 8) { has_cmd_up = true }
    if b.action == free_action(6, 8) { has_cmd_down = true }
  }
  debug_assert(has_pgdn && has_pgup && has_home && has_end && has_cmd_up && has_cmd_down, "all page scroll bindings registered")
}

test "Wave 1C: field_ink flags transparent color and zero opacity for hidden focusable textareas" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<textarea id='a' style='color:rgba(0,0,0,0)'></textarea>" +
    "<textarea id='b' style='opacity:0;color:#111'></textarea>" +
    "<textarea id='c' style='color:#223344'></textarea>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let body = doc.children[1].children[1]
  let ba = match layout::box_of(root, body.children[0]) { Some(b) => b None => panic("a") }
  let bb = match layout::box_of(root, body.children[1]) { Some(b) => b None => panic("b") }
  let bc = match layout::box_of(root, body.children[2]) { Some(b) => b None => panic("c") }
  let (ca, ha) = field_ink(Some(ba.style))
  let (cb, hb) = field_ink(Some(bb.style))
  let (cc, hc) = field_ink(Some(bc.style))
  debug_assert(ha && (ca & 0xFFL) == 0L, "rgba(0,0,0,0) textarea must be marked hidden_ink")
  debug_assert(hb && cb == 0x111111FFL, "opacity:0 textarea must be marked hidden_ink")
  debug_assert(!hc && cc == 0x223344FFL, "visible #223344 textarea must not be hidden")
  html::cut(doc)
}

test "Wave 29C: field_ink hides unlaid-out focus targets, -webkit-text-fill-color:transparent, visibility:hidden and stylesheet transparent inputarea" {
  let (_, h_none) = field_ink(None)
  debug_assert(h_none, "unlaid-out focused field (None style) must stay hidden until layout resolves style")
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<div class='monaco-editor'><textarea class='inputarea'></textarea></div>" +
    "<textarea style='color:#000;-webkit-text-fill-color:transparent'></textarea>" +
    "<textarea style='color:#000;visibility:hidden'></textarea>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet(".monaco-editor .inputarea { color: transparent; }")
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let body = doc.children[1].children[1]
  let b_monaco = match layout::box_of(root, body.children[0].children[0]) { Some(b) => b None => panic("monaco") }
  let b_tfill = match layout::box_of(root, body.children[1]) { Some(b) => b None => panic("tfill") }
  let b_vis = match layout::box_of(root, body.children[2]) { Some(b) => b None => panic("vis") }
  let (cm, hm) = field_ink(Some(b_monaco.style))
  let (ct, ht) = field_ink(Some(b_tfill.style))
  let (_, hv) = field_ink(Some(b_vis.style))
  debug_assert(hm && (cm & 0xFFL) == 0L, "Monaco .inputarea { color: transparent } must be hidden_ink")
  debug_assert(ht && (ct & 0xFFL) == 0L, "-webkit-text-fill-color: transparent must be hidden_ink")
  debug_assert(hv, "visibility: hidden textarea must be hidden_ink")
  html::cut(doc)
}

test "Wave 29C: PatchOp::SetForm updates active focused ui::Field words in place" {
  let host = TestHost::new("<!doctype html><html><body><input id='q' type='text' value='$.phoneNumbers[:1].type'></body></html>", "")
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  stage.feed(host.reset())
  let wid = must(find_el(must(stage.doc.root()), "q")).wire_id
  stage.feed(host.patch(0, more=[proto::PatchOp::Focus(wid)]))
  let e0 = match stage.field.untracked() {
    Some(e) => e
    None => panic("expected active Editing field after Focus")
  }
  debug_assert(e0.words.text() == "$.phoneNumbers[:1].type", "initial focused field text")
  stage.feed(host.patch(0, more=[proto::PatchOp::SetForm(wid, Some("$..number"), None)]))
  debug_assert(e0.words.text() == "$..number", "SetForm must sync focused Editing field text, got: " + e0.words.text())
}

test "Wave 33C: field_placeholder_ink honors ::placeholder color and defaults to #757575 for focused empty fields" {
  let doc = html::parse(
    "<!doctype html><html><body>" +
    "<input id='a' placeholder='Paste CSV'>" +
    "<input id='b' class='custom' style='color:#111' placeholder='Type here'>" +
    "</body></html>",
  )
  let e = css::Engine::new(css::Env::new(800.0, 600.0))
  e.add_sheet("input.custom::placeholder { color: #336699; }")
  let root = match layout::generate(doc, e) { Some(b) => b None => panic("root") }
  let body = doc.children[1].children[1]
  let ba = match layout::box_of(root, body.children[0]) { Some(b) => b None => panic("a") }
  let bb = match layout::box_of(root, body.children[1]) { Some(b) => b None => panic("b") }
  debug_assert(field_placeholder_ink(None) == 0x757575FFL, "None style defaults to #757575")
  debug_assert(field_placeholder_ink(Some(ba.style)) == 0x757575FFL, "plain input defaults placeholder ink to #757575, got=" + field_placeholder_ink(Some(ba.style)).to_string())
  debug_assert(field_placeholder_ink(Some(bb.style)) == 0x336699FFL, "::placeholder color must be honored on focused field")
  html::cut(doc)
}

test "Wave 2C: resolve_svg_light_dark rewrites CSS Color 5 light-dark() with nested var() for SVG rasterization" {
  let plain = "<svg><rect fill='#fff'/></svg>"
  debug_assert(resolve_svg_light_dark(plain) == plain, "fast path returns unchanged string")
  let drawio = "<svg><rect style=\"fill: light-dark(#ffffff, var(--ge-dark-color, #121212)); stroke: light-dark(#000000, var(--ge-light-color, #ffffff));\"/></svg>"
  let got = resolve_svg_light_dark(drawio)
  debug_assert(
    got == "<svg><rect style=\"fill: #ffffff; stroke: #000000;\"/></svg>",
    "nested var() inside light-dark() must resolve to light branch, got: " + got,
  )
  let grid = "<path style=\"stroke:light-dark(#e6e6e6, #424242);\"/>"
  debug_assert(
    resolve_svg_light_dark(grid) == "<path style=\"stroke:#e6e6e6;\"/>",
    "simple light-dark() must resolve to light branch",
  )
}

test "Wave 3C: resolve_svg_fragment extracts SVG stack target and symbol for mask-image #id sprites" {
  let sprite = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" fill=\"none\"><style><![CDATA[svg>[id]{display:none}svg>[id]:target{display:inline}]]></style><path id=\"a\" fill=\"#000\" d=\"M0 0h10v10H0z\"/><g id=\"b\"><path fill=\"#000\" d=\"M1 1h8v8H1z\"/></g></svg>"
  let out = resolve_svg_fragment(sprite, "https://example.com/icons.svg#b")
  debug_assert(out.contains("id=\"b\"") && !out.contains("id=\"a\"") && !out.contains("display:none"), "extracted SVG stack target #b without hiding style: " + out)
  let ras = svg::rasterize(prepare_svg_bytes(sprite.to_bytes(), "https://example.com/icons.svg#b"), 30, opt=raster::svg_options())
  match ras {
    Some((w, h, rgba)) => {
      let mut non_zero_alpha = 0
      let mut k = 3
      while k < rgba.length() {
        if (rgba[k].to_int() & 0xFF) > 0 { non_zero_alpha += 1 }
        k += 4
      }
      debug_assert(w == 30 && h == 30 && non_zero_alpha > 0, "rasterized #b fragment must have non-zero alpha pixels")
    }
    None => debug_assert(false, "rasterize #b failed")
  }
}

test "Wave 5C: Lexical data:image/svg+xml mask-image rasterizes with non-zero alpha" {
  let u = "data:image/svg+xml,%3csvg%20xmlns='http://www.w3.org/2000/svg'%20width='16'%20height='16'%20fill='currentColor'%20class='bi%20bi-type-bold'%3e%3cpath%20d='M8.21%2013c2.106%200%203.412-1.087%203.412-2.823%200-1.306-.984-2.283-2.324-2.386v-.055a2.176%202.176%200%200%200%201.852-2.14c0-1.51-1.162-2.46-3.014-2.46H3.843V13H8.21z'/%3e%3c/svg%3e"
  let data = match url::data_url_bytes(u) {
    Some(d) => d
    None => panic("data_url_bytes returned None")
  }
  debug_assert(is_svg(data), "is_svg must be true, got: " + data.to_string())
  let ras = svg::rasterize(prepare_svg_bytes(data, u), 36, opt=raster::svg_options())
  match ras {
    Some((w, h, rgba)) => {
      let mut nz = 0
      let mut k = 3
      while k < rgba.length() {
        if (rgba[k].to_int() & 0xFF) > 0 { nz += 1 }
        k += 4
      }
      debug_assert(w > 0 && h > 0 && nz > 0, "Lexical mask SVG must rasterize with non-zero alpha, got w=" + w.to_string() + " h=" + h.to_string() + " nz=" + nz.to_string())
    }
    None => panic("svg::rasterize returned None for: " + data.to_string())
  }
}

///|
test "Wave 96B: scene_groups preserves paint order across interleaved ScrollBox layers while merging consecutive chunks" {
  // Interleaved: ScrollBox(42) -> Unclip -> Rect(veil) -> ScrollBox(42) -> Rect(modal) -> Unclip
  let interleaved : Array[display::Item] = [
    display::Item::ScrollBox(42, 0.0, 0.0, 1280.0, 800.0, 1280.0, 900.0),
    display::Item::Unclip,
    display::Item::Rect(0.0, 0.0, 1280.0, 800.0, 0x000000A6),
    display::Item::ScrollBox(42, 0.0, 0.0, 1280.0, 800.0, 1280.0, 900.0),
    display::Item::Rect(300.0, 20.0, 600.0, 700.0, 0xFFFFFFFF),
    display::Item::Unclip,
  ]
  let gs = scene_groups(interleaved, "fixed")
  let rg = match gs.get("fixed") { Some(g) => g None => panic("missing fixed root group") }
  debug_assert(rg.kids.length() == 3, "interleaved ScrollBox must keep 3 kids [s42#0, veil, s42#1], got " + rg.kids.length().to_string())
  debug_assert(rg.kids[0].nest && !rg.kids[1].nest && rg.kids[2].nest, "kid[1] veil must sit between s42#0 and s42#1")
  let g0 = match gs.get("fixed/" + rg.kids[0].key) { Some(g) => g None => panic("missing s42#0") }
  let g2 = match gs.get("fixed/" + rg.kids[2].key) { Some(g) => g None => panic("missing s42#1") }
  debug_assert(g0.kids.length() == 0 && g2.kids.length() == 1, "modal rect must stay in s42#1 AFTER veil, not teleport into s42#0")
  // Consecutive with nothing in between: still merges into a single ScrollBox group
  let consec : Array[display::Item] = [
    display::Item::ScrollBox(42, 0.0, 0.0, 1280.0, 800.0, 1280.0, 900.0),
    display::Item::Rect(10.0, 10.0, 50.0, 50.0, 0x111111FF),
    display::Item::Unclip,
    display::Item::ScrollBox(42, 0.0, 0.0, 1280.0, 800.0, 1280.0, 900.0),
    display::Item::Rect(20.0, 20.0, 50.0, 50.0, 0x222222FF),
    display::Item::Unclip,
  ]
  let gs2 = scene_groups(consec, "fixed")
  let rg2 = match gs2.get("fixed") { Some(g) => g None => panic("missing fixed root group 2") }
  debug_assert(rg2.kids.length() == 1, "consecutive ScrollBox(42) chunks must merge into 1 kid, got " + rg2.kids.length().to_string())
  let gm = match gs2.get("fixed/" + rg2.kids[0].key) { Some(g) => g None => panic("missing merged s42") }
  debug_assert(gm.kids.length() == 2, "merged ScrollBox must contain both rects")
}

///|
test "Wave 98B: rtl_visual_shape shapes Arabic joining forms, LAM-ALEF ligatures, and UAX #9 visual order" {
  // Pure ASCII: unchanged
  debug_assert(rtl_visual_shape("Hello") == "Hello", "ASCII must pass through unchanged")
  // "إعلان" -> shaped logical [0xFE87 (إ iso), 0xFECB (ع ini), 0xFEFC (لا fin), 0xFEE5 (ن iso)]
  // -> visual LTR [0xFEE5, 0xFEFC, 0xFECB, 0xFE87]
  let il_cps = utf8_cps(rtl_visual_shape("إعلان"))
  debug_assert(il_cps.length() == 4, "إعلان must form 4 visual glyphs via LAM-ALEF ligature, got " + il_cps.length().to_string())
  debug_assert(
    il_cps[0] == 0xFEE5 && il_cps[1] == 0xFEFC && il_cps[2] == 0xFECB && il_cps[3] == 0xFE87,
    "إعلان visual order must be [ن_iso, لا_fin, ع_ini, إ_iso]",
  )
  // "السعودية" -> visual LTR [ة_fin, ي_ini, د_iso, و_fin, ع_med, س_med, ل_ini, ا_iso]
  let sa_cps = utf8_cps(rtl_visual_shape("السعودية"))
  debug_assert(sa_cps.length() == 8, "السعودية must have 8 glyphs")
  debug_assert(
    sa_cps[0] == 0xFE94 && sa_cps[1] == 0xFEF3 && sa_cps[2] == 0xFEA9 && sa_cps[3] == 0xFEEE &&
    sa_cps[4] == 0xFECC && sa_cps[5] == 0xFEB4 && sa_cps[6] == 0xFEDF && sa_cps[7] == 0xFE8D,
    "السعودية must join all medial/initial/final forms in RTL visual order",
  )
  // Mixed Arabic + ASCII digits: digits stay LTR "2026" on left, Arabic RTL on right
  let mix_cps = utf8_cps(rtl_visual_shape("عربي2026"))
  debug_assert(mix_cps.length() == 8, "عربي2026 must have 8 glyphs")
  debug_assert(
    mix_cps[0] == 0x32 && mix_cps[1] == 0x30 && mix_cps[2] == 0x32 && mix_cps[3] == 0x36,
    "digits in RTL run must stay LTR '2026' on the left",
  )
  // Hebrew: RTL visual order without Arabic joining
  let he_cps = utf8_cps(rtl_visual_shape("שלום"))
  debug_assert(he_cps.length() == 4 && he_cps[0] == 0x05DD && he_cps[3] == 0x05E9, "Hebrew must reverse to visual LTR order")
}

///|
test "Wave G2: 60fps live canvas/video asset updates trigger zero redundant page relayouts and bounded memory" {
  let host = TestHost::new(
    "<!doctype html><html><body><canvas id='c' width='64' height='64'></canvas><video id='v' width='64' height='64'></video></body></html>",
    "canvas, video { display: block; width: 64px; height: 64px; }",
  )
  let forgotten : Array[String] = []
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () }, forget=fn(k : String) -> Unit { forgotten.push(k) })
  let t = shown(stage, signals::signal(800.0))
  stage.feed(host.reset())
  t.draw()

  // Make a tiny valid 2x2 PNG payload for live frame streaming
  let px = FixedArray::make(2 * 2 * 4, 0 as Byte)
  px[0] = (255).to_byte()
  px[3] = (255).to_byte()
  let frame_png = png(px, 2, 2)

  // Frame 1 for both canvas and video establishes initial slot & triggers initial layout
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvcanvas:1/1", 0, 64.0, 64.0, frame_png)))
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvmedia:2/1", 0, 64.0, 64.0, frame_png)))
  t.frame(ms=16.0)
  let layouts_after_first = stage.layout_count()
  debug_assert(layouts_after_first >= 1, "initial layout must have run")

  // Stream 59 more same-size frames (frames 2..60) for both canvas & video (118 fast updates)
  let mut f = 2
  while f <= 60 {
    let ck = "fvcanvas:1/" + f.to_string()
    let vk = "fvmedia:2/" + f.to_string()
    stage.feed(proto::encode_host(proto::HostMsg::Asset(ck, 0, 64.0, 64.0, frame_png)))
    stage.feed(proto::encode_host(proto::HostMsg::Asset(vk, 0, 64.0, 64.0, frame_png)))
    t.frame(ms=16.0)
    f = f + 1
  }

  let layouts_after_60 = stage.layout_count()
  debug_assert(
    layouts_after_60 - layouts_after_first == 0,
    "60fps same-size live frames must trigger ZERO redundant page relayouts, got delta=" + (layouts_after_60 - layouts_after_first).to_string(),
  )
  debug_assert(
    stage.live_frame_fast_hits() >= 118,
    "live_frame_fast_hits must be >= 118, got " + stage.live_frame_fast_hits().to_string(),
  )
  debug_assert(
    stage.picture_cache_entries() <= 4,
    "picture_cache_entries must stay bounded O(1), got " + stage.picture_cache_entries().to_string(),
  )
  debug_assert(forgotten.length() >= 110, "stale frame textures must be evicted continuously, forgotten=" + forgotten.length().to_string())

  // Size change (64x64 -> 128x72) must fall back to relayout for 100% layout accuracy
  stage.feed(proto::encode_host(proto::HostMsg::Asset("fvmedia:2/61", 0, 128.0, 72.0, frame_png)))
  t.frame(ms=16.0)
  debug_assert(
    stage.layout_count() > layouts_after_60,
    "size change on live video frame must still trigger relayout",
  )
}

test "stage select UAX #29 grapheme & word boundaries preserve Emoji ZWJ, flags, diacritics & CJK" {
  // ASCII double-click & word stepping compatibility
  let ascii = "Hello world from Farview"
  let (a0, a1) = select_word_span_at(ascii, 2)
  debug_assert(ascii.slice(a0, a1) == "Hello", "ASCII double-click selects Hello")
  debug_assert(select_word_next(ascii, 0) == 5, "ASCII word next reaches end of Hello")
  debug_assert(select_word_prev(ascii, 11) == 6, "ASCII word prev reaches start of world")

  // Emoji ZWJ family, regional-indicator flags, combining diacritic & CJK
  let family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}\u{200D}\u{1F466}"
  let jp_flag = "\u{1F1EF}\u{1F1F5}"
  let us_flag = "\u{1F1FA}\u{1F1F8}"
  let cafe = "cafe\u{0301}"
  let mixed = family + " " + jp_flag + us_flag + " " + cafe + " 中文测试"

  // Clicking/aligning inside the ZWJ family must never split the cluster
  let fam_end = family.length()
  debug_assert(select_grapheme_next(mixed, 0) == fam_end, "next grapheme skips whole ZWJ family")
  debug_assert(select_grapheme_prev(mixed, fam_end) == 0, "prev grapheme skips whole ZWJ family")
  debug_assert(select_align_grapheme_start(mixed, 4) == 0, "mid-ZWJ align start snaps to 0")
  debug_assert(select_align_grapheme_end(mixed, 4) == fam_end, "mid-ZWJ align end snaps to family end")
  let (f0, f1) = select_word_span_at(mixed, 4)
  debug_assert(mixed.slice(f0, f1) == family, "double-click on ZWJ family selects entire cluster")

  // Flags stay paired (2 RI codepoints per flag, never split into 1 RI)
  let flag_start = fam_end + 1
  let jp_end = flag_start + jp_flag.length()
  let us_end = jp_end + us_flag.length()
  debug_assert(select_grapheme_next(mixed, flag_start) == jp_end, "JP flag is 1 grapheme")
  debug_assert(select_grapheme_next(mixed, jp_end) == us_end, "US flag is 1 grapheme")
  let (j0, j1) = select_word_span_at(mixed, flag_start + 4)
  debug_assert(mixed.slice(j0, j1) == jp_flag, "double-click inside JP flag selects whole JP flag")

  // Combining diacritic in cafe + combining acute stays attached to 'e' and word
  let cafe_start = us_end + 1
  let cafe_end = cafe_start + cafe.length()
  let (c0, c1) = select_word_span_at(mixed, cafe_start + 3)
  debug_assert(mixed.slice(c0, c1) == cafe, "double-click selects cafe with combining accent")
  debug_assert(select_grapheme_prev(mixed, cafe_end) == cafe_start + 3, "prev grapheme treats e+combining as 1 unit")

  // CJK mixed text selects individual Han word boundaries cleanly
  let cjk_start = cafe_end + 1
  let (z0, z1) = select_word_span_at(mixed, cjk_start)
  debug_assert(mixed.slice(z0, z1) == "中", "CJK word span selects valid Han boundary")

  // Codepoint-index mapping used by Stage::select_word_at (don't, Emoji ZWJ, flags, combining marks, CJK)
  let cp_sample = "don't " + family + " " + jp_flag + us_flag + " " + cafe + " 中文"
  let cps = utf8_cps(cp_sample)
  // "don't" occupies codepoint indices 0..5 (apostrophe at index 3)
  let (dc0, dc1) = select_word_cp_span_at(cp_sample, 3)
  debug_assert(cps_slice_str(cps, dc0, dc1) == "don't", "cp map selects contraction don't")
  // ZWJ family starts at cp index 6 (7 codepoints: man+zwj+woman+zwj+girl+zwj+boy -> 6..13)
  let (fc0, fc1) = select_word_cp_span_at(cp_sample, 9)
  debug_assert(fc0 == 6 && fc1 == 13 && cps_slice_str(cps, fc0, fc1) == family, "cp map selects whole ZWJ family")
  // JP flag at cp indices 14..16, US flag at 16..18
  let (jc0, jc1) = select_word_cp_span_at(cp_sample, 15)
  debug_assert(jc0 == 14 && jc1 == 16 && cps_slice_str(cps, jc0, jc1) == jp_flag, "cp map selects whole JP flag")
  let (uc0, uc1) = select_word_cp_span_at(cp_sample, 16)
  debug_assert(uc0 == 16 && uc1 == 18 && cps_slice_str(cps, uc0, uc1) == us_flag, "cp map selects whole US flag")
  // "cafe\u{0301}" at cp indices 19..24 (combining acute at 23)
  let (cc0, cc1) = select_word_cp_span_at(cp_sample, 23)
  debug_assert(cc0 == 19 && cc1 == 24 && cps_slice_str(cps, cc0, cc1) == cafe, "cp map selects cafe + combining acute")
  // CJK "中文" at cp indices 25, 26
  let (zc0, zc1) = select_word_cp_span_at(cp_sample, 25)
  debug_assert(zc0 == 25 && zc1 == 26 && cps_slice_str(cps, zc0, zc1) == "中", "cp map selects CJK Han char")
}

test "stage: turned SVG fit preserves aspect ratio by default and stretches only on preserveAspectRatio=none" {
  let logo = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 112 24\"><rect width=\"112\" height=\"24\"/></svg>"
  let stretched_dq = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 112 24\" preserveAspectRatio=\"none\"><rect width=\"112\" height=\"24\"/></svg>"
  let stretched_sq = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 112 24' preserveaspectratio=' NONE '><rect width='112' height='24'/></svg>"
  debug_assert(!svg_preserve_aspect_none(logo), "default SVG must not be preserveAspectRatio=none")
  debug_assert(svg_preserve_aspect_none(stretched_dq), "double-quoted preserveAspectRatio=none detected")
  debug_assert(svg_preserve_aspect_none(stretched_sq), "single-quoted case-insensitive preserveAspectRatio=none detected")
  let (dx, dy, sx, sy) = svg_fit_scale(120.0, 84.0, 112.0f, 24.0f, svg_preserve_aspect_none(logo))
  debug_assert(sx == sy, "default meet scaling must be uniform (sx == sy)")
  debug_assert(dx >= -0.01f && dx <= 0.01f && dy > 28.0f && dy < 30.0f, "wide 112x24 SVG in 120x84 must center vertically without stretching")
  let (ndx, ndy, nsx, nsy) = svg_fit_scale(120.0, 84.0, 112.0f, 24.0f, svg_preserve_aspect_none(stretched_dq))
  debug_assert(ndx == 0.0f && ndy == 0.0f && nsy > nsx * 3.0f, "preserveAspectRatio=none must allow non-uniform stretch")
}

fn oauth_svg_top_alpha(attrs : String) -> Int {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let src = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 112 24' " + attrs + "><rect width='112' height='24' fill='red'/></svg>"
  let u = "fv-svg:review"
  stage.picture_bytes.set(u, src.to_bytes())
  let (k, _) = stage.turned_picture([display::Item::Image(0.0, 0.0, 120.0, 84.0, u, 1.0)])
  match stage.drawn.get(k) {
    Some(data) => match pixels::decode_png(data) {
      Some((w, h, rgba)) => {
        debug_assert(rgba[((h / 2 * w) + w / 2) * 4 + 3].to_int() == 255, "center must contain red logo")
        rgba[(w * 12 + w / 2) * 4 + 3].to_int()
      }
      None => -1
    }
    None => -1
  }
}

test "independent OAuth SVG default and true none" {
  debug_assert(oauth_svg_top_alpha("") == 0 && oauth_svg_top_alpha("preserveAspectRatio='none'") == 255, "default and none controls")
}

test "independent OAuth SVG metadata must not stretch logo" {
  let a = oauth_svg_top_alpha("data-preserveAspectRatio='none'")
  debug_assert(a == 0, "expected transparent margin, alpha=" + a.to_string())
}

test "independent OAuth SVG quoted angle before none" {
  let a = oauth_svg_top_alpha("data-label='A > B' preserveAspectRatio='none'")
  debug_assert(a == 255, "expected opaque logo, alpha=" + a.to_string())
}

fn oauth_r2_alpha(prefix : String, attrs : String) -> Int {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let src = prefix + "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 112 24' " + attrs + "><rect width='112' height='24' fill='red'/></svg>"
  let u = "fv-svg:review"
  stage.picture_bytes.set(u, src.to_bytes())
  let (k, _) = stage.turned_picture([display::Item::Image(0.0, 0.0, 120.0, 84.0, u, 1.0)])
  match stage.drawn.get(k) {
    Some(data) => match pixels::decode_png(data) {
      Some((w, h, rgba)) => {
        debug_assert(rgba[((h / 2 * w) + w / 2) * 4 + 3].to_int() == 255, "center must contain red logo")
        rgba[(w * 12 + w / 2) * 4 + 3].to_int()
      }
      None => -1
    }
    None => -1
  }
}

test "OAuth R2 audit XML comment before root" {
  let def = oauth_r2_alpha("", "")
  let comment = oauth_r2_alpha("<!-- example: <svg preserveAspectRatio='none'> -->", "")
  let none = oauth_r2_alpha("", "preserveAspectRatio='none'")
  let comment_none = oauth_r2_alpha("<!-- example: <svg> -->", "preserveAspectRatio='none'")
  debug_assert(def == 0 && none == 255, "positive and negative controls")
  debug_assert(comment == def && comment_none == none, "comment before default/none changed top alpha to " + comment.to_string() + "/" + comment_none.to_string())
}

fn oauth_r3_alpha(prefix : String, attrs : String) -> Int {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let src = prefix + "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 112 24' " + attrs + "><rect width='112' height='24' fill='red'/></svg>"
  let u = "fv-svg:review"
  stage.picture_bytes.set(u, src.to_bytes())
  let (k, _) = stage.turned_picture([display::Item::Image(0.0, 0.0, 120.0, 84.0, u, 1.0)])
  match stage.drawn.get(k) {
    Some(data) => match pixels::decode_png(data) {
      Some((w, h, rgba)) => {
        debug_assert(rgba[((h / 2 * w) + w / 2) * 4 + 3].to_int() == 255, "center must contain red logo")
        rgba[(w * 12 + w / 2) * 4 + 3].to_int()
      }
      None => -1
    }
    None => -1
  }
}

test "OAuth R3 check SVG BOM" {
  let a = oauth_r3_alpha("\u{FEFF}", "preserveAspectRatio='none'")
  debug_assert(a == 255, "expected 255 observed " + a.to_string())
}

test "OAuth R3 check SVG XML PI" {
  let a = oauth_r3_alpha("<?display sample?>", "preserveAspectRatio='none'")
  debug_assert(a == 255, "expected 255 observed " + a.to_string())
}

test "OAuth R3 check SVG simple doctype" {
  let a = oauth_r3_alpha("<!DOCTYPE svg>", "preserveAspectRatio='none'")
  debug_assert(a == 255, "expected 255 observed " + a.to_string())
}

test "OAuth R3 check SVG internal subset" {
  let a = oauth_r3_alpha("<!DOCTYPE svg [<!ELEMENT svg ANY>]>", "preserveAspectRatio='none'")
  debug_assert(a == 255, "expected 255 observed " + a.to_string())
}

test "perf: scene_groups keeps stable container keys across animated Sticky/Transform/Clip updates" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let t = shown(stage, signals::signal(800.0))
  let frame1 : Array[display::Item] = [
    display::Item::Sticky(101, 0.0, 0.0, 400.0, 0.0),
    display::Item::Clip(0.0, 0.0, 400.0, 300.0),
    display::Item::Transform(50.0, 50.0, 1.0, 0.0, 0.0, 1.0, 10.0, 0.0),
    display::Item::Rect(10.0, 10.0, 80.0, 40.0, 0x112233FF),
    display::Item::Untransform,
    display::Item::Unclip,
    display::Item::Unclip,
  ]
  stage.scene_take(frame1, "")
  t.draw()
  let base_leaves = leaves_made[0]
  let mut i = 1
  while i <= 10 {
    let shift = i.to_double() * 5.0
    let frame_i : Array[display::Item] = [
      display::Item::Sticky(101, 0.0, 0.0, 400.0, shift),
      display::Item::Clip(0.0, shift, 400.0, 300.0),
      display::Item::Transform(50.0, 50.0, 1.0, 0.0, 0.0, 1.0, 10.0 + shift, 0.0),
      display::Item::Rect(10.0, 10.0, 80.0, 40.0, 0x112233FF),
      display::Item::Untransform,
      display::Item::Unclip,
      display::Item::Unclip,
    ]
    stage.scene_take(frame_i, "")
    t.draw()
    i += 1
  }
  debug_assert(leaves_made[0] == base_leaves, "animated Sticky/Clip/Transform must reuse mounted leaves, delta=" + (leaves_made[0] - base_leaves).to_string())
}

test "perf: position sticky keeps stable DOM node uid across relayouts" {
  let host = TestHost::new(
    "<!doctype html><html><body style='height:2000px'><div style='height:800px'><div id='st' style='position:sticky;top:0;height:100px'><div id='inner' style='width:80px;height:40px;background:#112233'></div></div></div><div id='anim' style='width:10px;height:10px;background:#445566'></div></body></html>",
    "",
  )
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let t = shown(stage, signals::signal(800.0))
  stage.feed(host.reset())
  t.draw()
  let base_leaves = leaves_made[0]
  let mut i = 0
  while i < 5 {
    stage.changed.set(stage.changed.untracked() + 1)
    t.draw()
    i += 1
  }
  debug_assert(leaves_made[0] == base_leaves, "repeated relayouts of position:sticky must not remount subtree leaves, delta=" + (leaves_made[0] - base_leaves).to_string())
}
