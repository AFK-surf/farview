///| Uncompressed (stored deflate) PNG encoder for RGBA pixel tiles.
///| 1:1 port of `client/src/stage/png.mbt`.

fn crc_table() -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < 256 {
    let mut c = i
    let mut b = 0
    while b < 8 {
      c = if (c & 1) != 0 {
        0xEDB88320 ^ ((c >> 1) & 0x7FFFFFFF)
      } else {
        (c >> 1) & 0x7FFFFFFF
      }
      b += 1
    }
    out.push(c)
    i += 1
  }
  out
}

let crcs : Array[Int] = crc_table()

fn buf_push_bytes(out : Array[Byte], b : Bytes) -> Unit {
  let n = b.length()
  let mut i = 0
  while i < n {
    out.push(b[i])
    i += 1
  }
}

fn arr_to_bytes(a : Array[Byte]) -> Bytes {
  let n = a.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = a[i]
    i += 1
  }
  out
}

fn bytes_put_be32(out : Bytes, off : Int, v : Int) -> Unit {
  out[off] = ((v >> 24) & 0xFF).to_byte()
  out[off + 1] = ((v >> 16) & 0xFF).to_byte()
  out[off + 2] = ((v >> 8) & 0xFF).to_byte()
  out[off + 3] = (v & 0xFF).to_byte()
}

fn crc32_range(buf : Bytes, start : Int, len : Int) -> Int {
  let mut c = -1
  let end = start + len
  let mut i = start
  while i < end {
    c = crcs[(c ^ (buf[i].to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i += 1
  }
  c ^ -1
}

///| An RGBA picture as a PNG, its data stored as it is.
pub fn png(px : FixedArray[Byte], w : Int, h : Int) -> Bytes {
  let row_bytes = w * 4
  let raw_len = h * (row_bytes + 1)
  let blocks = if raw_len == 0 { 0 } else { (raw_len + 65534) / 65535 }
  let idat_len = 2 + raw_len + blocks * 5 + 4
  let total = 8 + 25 + 12 + idat_len + 12
  let out = Bytes::new(total)
  out[0] = 0x89 as Byte
  out[1] = 0x50 as Byte
  out[2] = 0x4E as Byte
  out[3] = 0x47 as Byte
  out[4] = 0x0D as Byte
  out[5] = 0x0A as Byte
  out[6] = 0x1A as Byte
  out[7] = 0x0A as Byte
  let mut pos = 8
  bytes_put_be32(out, pos, 13)
  pos += 4
  let ihdr_type = pos
  out[pos] = 73 as Byte
  out[pos + 1] = 72 as Byte
  out[pos + 2] = 68 as Byte
  out[pos + 3] = 82 as Byte
  pos += 4
  bytes_put_be32(out, pos, w)
  bytes_put_be32(out, pos + 4, h)
  out[pos + 8] = 8 as Byte
  out[pos + 9] = 6 as Byte
  out[pos + 10] = 0 as Byte
  out[pos + 11] = 0 as Byte
  out[pos + 12] = 0 as Byte
  pos += 13
  bytes_put_be32(out, pos, crc32_range(out, ihdr_type, 17))
  pos += 4
  bytes_put_be32(out, pos, idat_len)
  pos += 4
  let idat_type = pos
  out[pos] = 73 as Byte
  out[pos + 1] = 68 as Byte
  out[pos + 2] = 65 as Byte
  out[pos + 3] = 84 as Byte
  pos += 4
  out[pos] = 0x78 as Byte
  out[pos + 1] = 0x01 as Byte
  pos += 2
  let mut a = 1
  let mut b = 0
  let mut nmax = 5552
  let mut y = 0
  let mut col = -1
  let mut written = 0
  while written < raw_len {
    let rem = raw_len - written
    let len = if rem > 65535 { 65535 } else { rem }
    out[pos] = (if written + len >= raw_len { 1 } else { 0 }).to_byte()
    out[pos + 1] = (len & 255).to_byte()
    out[pos + 2] = ((len >> 8) & 255).to_byte()
    let nlen = len ^ 0xFFFF
    out[pos + 3] = (nlen & 255).to_byte()
    out[pos + 4] = ((nlen >> 8) & 255).to_byte()
    pos += 5
    let mut left = len
    while left > 0 {
      if col < 0 {
        out[pos] = 0 as Byte
        pos += 1
        b = b + a
        nmax -= 1
        if nmax == 0 {
          a = a % 65521
          b = b % 65521
          nmax = 5552
        }
        col = 0
        left -= 1
      } else {
        let row_rem = row_bytes - col
        let take = if row_rem < left { row_rem } else { left }
        let base = y * row_bytes + col
        let mut k = 0
        while k < take {
          let v = px[base + k]
          out[pos] = v
          pos += 1
          a = a + (v.to_int() & 0xFF)
          b = b + a
          nmax -= 1
          if nmax == 0 {
            a = a % 65521
            b = b % 65521
            nmax = 5552
          }
          k += 1
        }
        col += take
        left -= take
        if col >= row_bytes {
          col = -1
          y += 1
        }
      }
    }
    written += len
  }
  a = a % 65521
  b = b % 65521
  bytes_put_be32(out, pos, (b << 16) | a)
  pos += 4
  bytes_put_be32(out, pos, crc32_range(out, idat_type, 4 + idat_len))
  pos += 4
  bytes_put_be32(out, pos, 0)
  pos += 4
  let iend_type = pos
  out[pos] = 73 as Byte
  out[pos + 1] = 69 as Byte
  out[pos + 2] = 78 as Byte
  out[pos + 3] = 68 as Byte
  pos += 4
  bytes_put_be32(out, pos, crc32_range(out, iend_type, 4))
  out
}
