///| Uncompressed (stored deflate) PNG encoder for RGBA pixel tiles.
///| 1:1 port of `client/src/stage/png.mbt`.

fn crc_table() -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < 256 {
    let mut c = i
    let mut b = 0
    while b < 8 {
      c = if (c & 1) != 0 {
        0xEDB88320 ^ ((c >> 1) & 0x7FFFFFFF)
      } else {
        (c >> 1) & 0x7FFFFFFF
      }
      b += 1
    }
    out.push(c)
    i += 1
  }
  out
}

let crcs : Array[Int] = crc_table()

fn buf_push_be32(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 24) & 0xFF).to_byte())
  out.push(((v >> 16) & 0xFF).to_byte())
  out.push(((v >> 8) & 0xFF).to_byte())
  out.push((v & 0xFF).to_byte())
}

fn buf_push_bytes(out : Array[Byte], b : Bytes) -> Unit {
  let n = b.length()
  let mut i = 0
  while i < n {
    out.push(b[i])
    i += 1
  }
}

fn png_chunk(out : Array[Byte], tag : String, body : Bytes) -> Unit {
  buf_push_be32(out, body.length())
  let tb = tag.to_bytes()
  buf_push_bytes(out, tb)
  buf_push_bytes(out, body)
  let mut c = -1
  let mut i = 0
  while i < tb.length() {
    c = crcs[(c ^ (tb[i].to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i += 1
  }
  i = 0
  while i < body.length() {
    c = crcs[(c ^ (body[i].to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i += 1
  }
  buf_push_be32(out, c ^ -1)
}

fn arr_to_bytes(a : Array[Byte]) -> Bytes {
  let n = a.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = a[i]
    i += 1
  }
  out
}

///| An RGBA picture as a PNG, its data stored as it is.
pub fn png(px : FixedArray[Byte], w : Int, h : Int) -> Bytes {
  let row_bytes = w * 4
  let total_rows = h * (row_bytes + 1)
  let rows = Bytes::new(total_rows)
  let mut dst = 0
  let mut y = 0
  while y < h {
    rows[dst] = 0 as Byte
    dst += 1
    let base = y * row_bytes
    let mut k = 0
    while k < row_bytes {
      rows[dst] = px[base + k]
      dst += 1
      k += 1
    }
    y += 1
  }
  let z : Array[Byte] = []
  z.push(0x78 as Byte)
  z.push(0x01 as Byte)
  let mut off = 0
  let n = rows.length()
  while off < n {
    let rem = n - off
    let len = if rem > 65535 { 65535 } else { rem }
    z.push((if off + len >= n { 1 } else { 0 }).to_byte())
    z.push((len & 255).to_byte())
    z.push(((len >> 8) & 255).to_byte())
    let nlen = len ^ 0xFFFF
    z.push((nlen & 255).to_byte())
    z.push(((nlen >> 8) & 255).to_byte())
    let mut k = 0
    while k < len {
      z.push(rows[off + k])
      k += 1
    }
    off += len
  }
  let mut a = 1
  let mut b = 0
  let mut i = 0
  while i < n {
    a = (a + (rows[i].to_int() & 0xFF)) % 65521
    b = (b + a) % 65521
    i += 1
  }
  buf_push_be32(z, (b << 16) | a)
  let out : Array[Byte] = [
    0x89 as Byte, 0x50 as Byte, 0x4E as Byte, 0x47 as Byte,
    0x0D as Byte, 0x0A as Byte, 0x1A as Byte, 0x0A as Byte,
  ]
  let head : Array[Byte] = []
  buf_push_be32(head, w)
  buf_push_be32(head, h)
  head.push(8 as Byte)
  head.push(6 as Byte)
  head.push(0 as Byte)
  head.push(0 as Byte)
  head.push(0 as Byte)
  png_chunk(out, "IHDR", arr_to_bytes(head))
  png_chunk(out, "IDAT", arr_to_bytes(z))
  png_chunk(out, "IEND", Bytes::new(0))
  arr_to_bytes(out)
}
