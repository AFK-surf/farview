///| Uncompressed (stored deflate) PNG encoder for RGBA pixel tiles.
///| 1:1 port of `client/src/stage/png.mbt`.

fn crc_table() -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < 256 {
    let mut c = i
    let mut b = 0
    while b < 8 {
      c = if (c & 1) != 0 {
        0xEDB88320 ^ ((c >> 1) & 0x7FFFFFFF)
      } else {
        (c >> 1) & 0x7FFFFFFF
      }
      b += 1
    }
    out.push(c)
    i += 1
  }
  out
}

let crcs : Array[Int] = crc_table()

fn buf_push_be32(out : Array[Byte], v : Int) -> Unit {
  out.push(((v >> 24) & 0xFF).to_byte())
  out.push(((v >> 16) & 0xFF).to_byte())
  out.push(((v >> 8) & 0xFF).to_byte())
  out.push((v & 0xFF).to_byte())
}

fn buf_push_bytes(out : Array[Byte], b : Bytes) -> Unit {
  let n = b.length()
  let mut i = 0
  while i < n {
    out.push(b[i])
    i += 1
  }
}

fn png_chunk(out : Array[Byte], tag : String, body : Bytes) -> Unit {
  buf_push_be32(out, body.length())
  let tb = tag.to_bytes()
  buf_push_bytes(out, tb)
  buf_push_bytes(out, body)
  let mut c = -1
  let mut i = 0
  while i < tb.length() {
    c = crcs[(c ^ (tb[i].to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i += 1
  }
  i = 0
  while i < body.length() {
    c = crcs[(c ^ (body[i].to_int() & 0xFF)) & 255] ^ ((c >> 8) & 0x00FFFFFF)
    i += 1
  }
  buf_push_be32(out, c ^ -1)
}

fn arr_to_bytes(a : Array[Byte]) -> Bytes {
  let n = a.length()
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    out[i] = a[i]
    i += 1
  }
  out
}

///| An RGBA picture as a PNG, encoded via native C fast-RLE PNG in `raster::encode_png`.
pub fn png(px : FixedArray[Byte], w : Int, h : Int) -> Bytes {
  let n = w * h * 4
  if w <= 0 || h <= 0 || px.length() < n {
    return Bytes::new(0)
  }
  let raw = Bytes::new(n)
  let mut i = 0
  while i < n {
    raw[i] = px[i]
    i += 1
  }
  raster::encode_png(raw, w, h)
}
