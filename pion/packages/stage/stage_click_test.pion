///| Presses on a challenge-style page: a link, a fixed bar, and an iframe (a border, a checkbox `span` with a spinner
///| beside it) reach the element under the pointer, wherever the page is scrolled and whatever overlay is up.

import "html"
import "proto"
import "signals"

fn challenge_host() -> TestHost {
  TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<div class=bar><button id=fb>menu</button><input id=fq></div>" +
    "<div class=pre><a id=why href=\"#\">Why did this happen?</a></div>" +
    "<form><iframe id=fr title=check></iframe></form><div class=long></div></body></html>",
    "body { margin: 0 } .bar { position: fixed; top: 0; left: 0; right: 0; height: 40px; background: rgb(30, 30, 30) } " +
    "#fb { position: absolute; left: 10px; top: 5px; width: 80px; height: 30px } " +
    "#fq { position: absolute; left: 100px; top: 5px; width: 120px; height: 30px } " +
    ".pre { padding-top: 60px; height: 40px } a { display: inline-block; width: 200px; height: 20px } " +
    "iframe { display: block; margin-left: 30px; width: 304px; height: 78px; border: 2px solid rgb(200, 200, 200) } " +
    ".long { height: 1500px }",
    frames=[
      (
        "fr",
        "<!doctype html><style>body { margin: 0 } .anchor { position: relative; width: 300px; height: 74px; " +
        "background: rgb(249, 249, 249) } .box { position: absolute; left: 12px; top: 25px; width: 24px; height: 24px; " +
        "border: 2px solid rgb(193, 193, 193); border-radius: 2px; background: white; cursor: pointer } " +
        ".spin { position: absolute; left: 12px; top: 25px; width: 28px; height: 28px; border-radius: 50%; " +
        "border: 4px solid rgb(77, 144, 254); opacity: 0; pointer-events: none } " +
        "label { position: absolute; left: 52px; top: 28px; font-size: 14px }</style>" +
        "<body><div class=anchor><span id=cb role=checkbox aria-checked=false tabindex=0 class=box></span>" +
        "<div class=spin></div><label id=lbl>I'm not a robot</label></div></body>",
      ),
    ],
  )
}

fn downs_of(sent : Array[Bytes]) -> Array[(Int, Double, Double)] {
  let out : Array[(Int, Double, Double)] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, 0, _, _, id, rx, ry, _, _) => out.push((id, rx, ry))
      _ => ()
    }
  }
  out
}

fn ups_of(sent : Array[Bytes]) -> Int {
  let mut n = 0
  for m in said(sent) {
    match m {
      proto::ClientMsg::Pointer(_, 1, _, _, _, _, _, _, _) => n += 1
      _ => ()
    }
  }
  n
}

fn tapped_on(t : StageTester, sent : Array[Bytes], x : Double, y : Double, want : html::Node, what : String) -> Unit {
  sent.clear()
  t.tap(x, y)
  t.run_for(frame_ms)
  let ds = downs_of(sent)
  debug_assert(ds.length() == 1, what + ": one pointer down sent (got " + ds.length().to_string() + ")")
  debug_assert(ds.length() == 1 && ds[0].0 == want.uid, what + ": down aimed at the element under the pointer")
  debug_assert(ups_of(sent) == 1, what + ": one pointer up sent")
}

test "challenge page: link, fixed bar and a bordered iframe's checkbox each take the press under the pointer" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let host = challenge_host()
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let why = must(find_el(host.doc, "why"))
  let fb = must(find_el(host.doc, "fb"))
  let cb = must(find_el(host.frames[0].root, "cb"))
  let lbl = must(find_el(host.frames[0].root, "lbl"))
  tapped_on(t, sent, 100.0, 70.0, why, "link")
  tapped_on(t, sent, 50.0, 20.0, fb, "fixed button")
  // the iframe's content box starts at (32, 102): its 2px border inside its 30px margin, under the 100px of .pre
  tapped_on(t, sent, 32.0 + 12.0 + 14.0, 102.0 + 25.0 + 14.0, cb, "iframe checkbox")
  let ds = downs_of(sent)
  debug_assert((ds[0].1 - 0.5).abs() < 0.05 && (ds[0].2 - 0.5).abs() < 0.05, "checkbox press at its middle")
  tapped_on(t, sent, 32.0 + 80.0, 102.0 + 36.0, lbl, "iframe label")
  // a focused fixed field puts its overlay (field, caret, marks) over the page: presses still reach the page
  t.tap(160.0, 20.0)
  t.run_for(shown_ms)
  debug_assert(stage.field.untracked().is_some(), "fixed input focused")
  tapped_on(t, sent, 100.0, 70.0, why, "link with a fixed field focused")
  tapped_on(t, sent, 32.0 + 12.0 + 14.0, 102.0 + 25.0 + 14.0, cb, "iframe checkbox with a fixed field focused")
  // scrolled: the iframe moves up, the fixed bar stays
  t.wheel(300.0, 300.0, 60.0)
  t.run_for(shown_ms)
  let py = stage.page_y
  debug_assert(py > 0.0, "page scrolled (page_y " + py.to_string() + ")")
  tapped_on(t, sent, 32.0 + 12.0 + 14.0, 102.0 + 25.0 + 14.0 - py, cb, "iframe checkbox scrolled")
  tapped_on(t, sent, 50.0, 20.0, fb, "fixed button scrolled")
  t.dispose()
}
