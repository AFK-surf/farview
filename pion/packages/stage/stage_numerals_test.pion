///| A page's numerals reach the drawn words: proportional digits by default (as layout measures them, whatever the UI
/// theme says), tabular where it says `tabular-nums` / `"tnum"`, diagonal fractions where it says
/// `diagonal-fractions` / `"frac"`, and a node redrawn when only that changes.

fn tab_name(t : Option[Bool]) -> String {
  match t {
    Some(true) => "Some(true)"
    Some(false) => "Some(false)"
    None => "None"
  }
}

///| The numerals of the look and runs the drawn words node reading `needle` was given.
fn numerals_drawn(t : StageTester, needle : String) -> (Option[Bool], Bool, Array[(Option[Bool], Bool)]) {
  for d in t.inner.drawn() {
    let runs : Array[(Option[Bool], Bool)] = []
    for r in d.runs {
      runs.push((r.tabular, r.diagonal_fractions))
    }
    if d.words == needle {
      return (d.words_look.tabular, d.words_look.diagonal_fractions, runs)
    }
  }
  let seen = StringBuilder::new()
  for d in t.inner.drawn() {
    for r in d.runs {
      seen.write_string("[" + r.text + "]")
    }
    if d.words.length() > 0 { seen.write_string("{" + d.words + "}") }
  }
  panic("no drawn words holding " + needle + ": " + seen.to_string())
}

fn check_numerals(t : StageTester, needle : String, want_tab : Option[Bool], want_frac : Bool) -> Unit {
  let (lt, lf, runs) = numerals_drawn(t, needle)
  debug_assert(
    lt == want_tab && lf == want_frac,
    needle + ": look tabular=" + tab_name(lt) + " diagonal_fractions=" + lf.to_string(),
  )
  debug_assert(runs.length() > 0, needle + ": drawn with runs")
  for r in runs {
    debug_assert(
      r.0 == want_tab && r.1 == want_frac,
      needle + ": run tabular=" + tab_name(r.0) + " diagonal_fractions=" + r.1.to_string(),
    )
  }
}

test "stage: words_of / run_of set a page's digits proportional by default, not as the theme says" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  stage.fonts.add_font_data(build_fallback_sfnt(0x31, 600, "StageNumeralsBase"))
  let (r, _) = stage.run_of(0, "12% to", 400, false, 0x111111FF)
  debug_assert(r.tabular == Some(false) && !r.diagonal_fractions, "run_of: plain text is proportional, no fractions")
  let (_, runs, look, _) = stage.words_of(0, 16.0, 12.0, 0x111111FF, "14th and the 15th still", 0.0)
  debug_assert(look.tabular == Some(false) && !look.diagonal_fractions, "words_of: look is proportional, no fractions")
  for x in runs {
    debug_assert(x.tabular == Some(false) && !x.diagonal_fractions, "words_of: every run is proportional")
  }
}

test "stage: font-variant-numeric and font-feature-settings reach the drawn words, and switching them redraws" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  stage.fonts.add_font_data(build_fallback_sfnt(0x20, 500, "StageNumeralsPage"))
  let wide = signals::signal(800.0)
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<p id=a>Signups rose 12% to 1,590.</p>" +
    "<p id=b class=tab>1111 0000</p>" +
    "<h1 id=c class=hero>Comma is your 24/7 Super Agent.</h1>" +
    "<p id=d class=ffs>tnum 1/2 frac</p>" +
    "</body></html>",
    "body { margin: 0; font-size: 16px } .tab { font-variant-numeric: tabular-nums } " +
    ".hero { font-variant-numeric: diagonal-fractions } .ffs { font-feature-settings: \"tnum\", \"frac\" }",
  )
  let t = shown(stage, wide)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  check_numerals(t, "Signups", Some(false), false)
  check_numerals(t, "1111", Some(true), false)
  check_numerals(t, "24/7", Some(false), true)
  check_numerals(t, "tnum", Some(true), true)
  // only the numerals change: the node is redrawn with them
  let a = must(find_el(host.doc, "a"))
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(host.patch(0, more=[proto::PatchOp::SetAttrs(a.uid, [html::Attr::new("", "class", "tab", "")])]))
  })
  t.run_for(shown_ms)
  check_numerals(t, "Signups", Some(true), false)
  let c = must(find_el(host.doc, "c"))
  ui::answered_from_outside(fn() -> Unit {
    stage.feed(host.patch(0, more=[proto::PatchOp::SetAttrs(c.uid, [html::Attr::new("", "class", "", "")])]))
  })
  t.run_for(shown_ms)
  check_numerals(t, "24/7", Some(false), false)
  t.dispose()
}
