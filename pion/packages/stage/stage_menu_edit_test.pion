///| A field's own menu (find.pion: Stage::menu_asked focusing what it is asked over, Stage::edit_command).

fn edits_of(sent : Array[Bytes]) -> Array[String] {
  let out : Array[String] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, _, txt, _, _, _) => out.push(txt)
      _ => ()
    }
  }
  out
}

fn keys_of(sent : Array[Bytes]) -> Array[String] {
  let out : Array[String] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::Key(_, focus, true, key, _, txt, mods) => out.push(key + "/" + txt + "/" + mods.to_string() + "@" + focus.to_string())
      _ => ()
    }
  }
  out
}

test "a field's menu edits it: right-click focuses it, then undo, cut, copy, paste and select all act on it" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<input id=f><div id=ce contenteditable=true>rich words</div><input id=pw type=password value=secret></body></html>",
    "body { margin: 0; font-size: 20px } input, div { display: block; margin: 0; height: 40px; width: 300px; border: 0; padding: 0 }",
  )
  let hits : Array[MenuHit] = []
  let t = StageTester::make(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(b : view::View) -> Unit {
        let _ = b.width(view::Live::Is(Some(600.0))).grow(view::Live::Is(1.0))
        let _ = stage_node(b, stage, on_menu=Some(fn(m : MenuHit) -> Unit { hits.push(m) }))
      })
    },
    w=600.0,
    h=600.0,
  )
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  // (right-click an unfocused field: it takes the focus, nothing selected in it)
  t.right_click(20.0, 20.0)
  t.run_for(frame_ms)
  debug_assert(hits.length() == 1 && hits[0].editable && !hits[0].edit_has_selection, "field menu, nothing selected")
  let fe = match stage.field.untracked() {
    Some(e) => e
    None => panic("the field took the focus")
  }
  debug_assert(fe.node.attr("id").unwrap_or("") == "f", "the field right-clicked is edited")
  sent.clear()
  let _ = stage.edit_command("paste", "hello")
  debug_assert(fe.words.text() == "hello", "pasted")
  let _ = stage.edit_command("select_all", "")
  t.right_click(20.0, 20.0)
  t.run_for(frame_ms)
  debug_assert(hits.length() == 2 && hits[1].editable && hits[1].edit_has_selection && hits[1].selection == "hello", "the field's selection")
  match stage.field.untracked() {
    Some(e) => debug_assert(e.node.uid == fe.node.uid, "right-click on the focused field keeps it")
    None => debug_assert(false, "still edited")
  }
  debug_assert(stage.edit_command("copy", "") == "hello", "copy gives what is selected")
  debug_assert(fe.words.text() == "hello", "copy leaves it")
  debug_assert(stage.edit_command("cut", "") == "hello", "cut gives what is selected")
  debug_assert(fe.words.text() == "", "cut takes it out")
  let _ = stage.edit_command("undo", "")
  debug_assert(fe.words.text() == "hello", "undo puts it back")
  let _ = stage.edit_command("redo", "")
  debug_assert(fe.words.text() == "", "redo takes it out again")
  let ed = edits_of(sent)
  debug_assert(ed.length() >= 4 && ed[0] == "hello" && ed[ed.length() - 1] == "", "each edit goes to the host: " + ed.join("|"))
  // (a password field: nothing of it copied)
  t.right_click(20.0, 100.0)
  t.run_for(frame_ms)
  let _ = stage.edit_command("select_all", "")
  debug_assert(stage.edit_command("copy", "") == "", "a password is not copied")
  t.right_click(20.0, 100.0)
  t.run_for(frame_ms)
  debug_assert(!hits[hits.length() - 1].edit_has_selection && hits[hits.length() - 1].selection == "", "a password's Cut and Copy dim, as Chrome's")
  // (an editing host: the page's editing keys at it)
  t.right_click(20.0, 60.0)
  t.run_for(frame_ms)
  debug_assert(hits[hits.length() - 1].editable, "editing host's menu")
  debug_assert(stage.field.untracked().is_none() && stage.caret.untracked().is_some(), "the host is typed in, no field")
  let ce = match stage.caret.untracked() { Some(n) => n.wire_id None => -1 }
  sent.clear()
  let _ = stage.edit_command("select_all", "")
  let _ = stage.edit_command("copy", "")
  let _ = stage.edit_command("paste", "more")
  let _ = stage.edit_command("undo", "")
  let _ = stage.edit_command("redo", "")
  let mac = proto::keys_are_macos(ui::keys_system())
  let pm = if mac { 4 } else { 2 }
  let ks = keys_of(sent)
  let want = ["a//" + pm.to_string(), "c//" + pm.to_string(), "v/more/" + pm.to_string(), "z//" + pm.to_string(), if mac { "z//12" } else { "y//2" }]
  debug_assert(ks.length() == 5, "five keys: " + ks.join(" "))
  for i in 0..<5 {
    debug_assert(ks[i] == want[i] + "@" + ce.to_string(), "key " + i.to_string() + ": " + ks[i])
  }
  // (the host's own selection in it is what its menu searches for, not words picked elsewhere)
  let txt = must(find_el(host.doc, "ce")).children[0]
  let txt_id = txt.uid
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(stage.seq, more=[proto::PatchOp::Selection(ce, txt_id, 0, txt_id, 4)])) })
  t.run_for(frame_ms)
  t.right_click(20.0, 60.0)
  t.run_for(frame_ms)
  let last = hits[hits.length() - 1]
  debug_assert(last.edit_has_selection && last.selection == "rich", "the host's selection: '" + last.selection + "'")
  t.dispose()
}
