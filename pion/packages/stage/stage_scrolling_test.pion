test "the page and its boxes show overlay scroll bars, unless they hide them" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  let tree = must(stage.node).tree
  // (the page's and the plain box's: two thumbs; the box with scrollbar-width: none has none)
  debug_assert(tree.thumbs_now().length() == 2, "two bars: " + tree.thumbs_now().length().to_string())
  t.inner.wheel(400.0, 400.0, 120.0)
  t.run_for(32.0)
  // (the page's thumb along its right edge, as long as what shows is of the page, moved down as it scrolled)
  let mut seen = false
  let dbg : Array[String] = []
  for id in tree.thumbs_now() {
    match tree.drawn_of(id) {
      Some(d) => {
        dbg.push(d.x.to_string() + "," + d.y.to_string() + "," + d.w.to_string() + "," + d.h.to_string())
        if d.x > 580.0 && d.x + d.w <= 604.5 && d.h >= 28.0 && d.y > 0.0 {
          seen = true
        }
      }
      None => ()
    }
  }
  debug_assert(seen, "the page's thumb along its right edge: " + dbg.join(" | "))
  t.dispose()
}

test "a page whose root says scrollbar-width: none draws no bar of its own" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let wide = signals::signal(600.0)
