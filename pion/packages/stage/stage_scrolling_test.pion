///| Scrolling as the platform scrolls: a mouse wheel's notches eased in, the page's keys gliding it, overlay bars.

let scroll_html : String = "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
"<div id=box class=box><div class=inner></div></div><div id=hid class='box hid'><div class=inner></div></div>" +
"<div class=tall></div></body></html>"

let scroll_css : String = "body { margin: 0 } .box { overflow: auto; height: 100px; width: 300px } " +
".hid { scrollbar-width: none } .inner { height: 900px } .tall { height: 4000px }"

fn scroll_stage(sent : Array[Bytes]) -> (Stage, StageTester) {
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(TestHost::new(scroll_html, scroll_css).reset()) })
  t.run_for(shown_ms)
  (stage, t)
}

test "a mouse wheel's notch eases the page in over ~200ms; a trackpad's moves it at once" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  // (a notch: phase 4, as the host says a mouse's wheel)
  t.inner.wheel(400.0, 400.0, 40.0, phase=4)
  let y0 = stage.scroll_y()
  debug_assert(y0 >= 0.0 && y0 < 30.0, "a notch does not jump: " + y0.to_string())
  t.run_for(80.0)
  let y1 = stage.scroll_y()
  debug_assert(y1 > y0 && y1 < 40.0, "under way: " + y1.to_string())
  t.run_for(600.0)
  debug_assert((stage.scroll_y() - 40.0).abs() < 0.5, "comes to the notch's 40: " + stage.scroll_y().to_string())
  // (a trackpad's fingers: where they move it, at once)
  t.inner.wheel(400.0, 400.0, 25.0)
  debug_assert((stage.scroll_y() - 65.0).abs() < 0.5, "trackpad at once: " + stage.scroll_y().to_string())
  t.dispose()
}

test "the page's keys glide it: Space, Page Down, Page Up and arrows ease in, carry on when pressed again, Home and End go to its ends" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  let page = stage.room.1 - view::scroll_key_line
  t.key(1032)
  let a = stage.scroll_y()
  debug_assert(a < page * 0.5, "Space does not jump: " + a.to_string())
  t.run_for(48.0)
  let b = stage.scroll_y()
  debug_assert(b > a && b < page, "Space glides: " + b.to_string())
  // (pressed again while it goes: on to two pages, not back)
  t.key(1032)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page * 2.0).abs() < 1.0, "two Spaces, two pages: " + stage.scroll_y().to_string() + " page " + page.to_string())
  debug_assert(stage.glide.is_none(), "at rest")
  // (Shift+Space back a page)
  t.key(1032, mods=1)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page).abs() < 1.0, "Shift+Space a page back")
  // (an arrow, with the pointer away from the boxes: a line)
  t.inner.move_to(400.0, 400.0)
  t.key(6)
  let c = stage.scroll_y()
  t.run_for(800.0)
  debug_assert(c < page + view::scroll_key_line - 1.0 && (stage.scroll_y() - page - view::scroll_key_line).abs() < 1.0, "↓ glides a line")
  // (the wheel during a glide: the wheel's from there)
  t.key(9)
  t.run_for(32.0)
  t.inner.wheel(400.0, 400.0, -10.0)
  let w = stage.scroll_y()
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - w).abs() < 1.0 && stage.glide.is_none(), "the wheel ends the glide where it leaves it")
  t.key(8)
  t.run_for(800.0)
  debug_assert(stage.scroll_y() == 0.0, "Home: the top")
  // (Page Down glides exactly a page, once: no second path moves it on; Page Up back)
  t.key(16)
  let pd0 = stage.scroll_y()
  debug_assert(pd0 < page * 0.5, "Page Down does not jump: " + pd0.to_string())
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page).abs() < 1.0, "Page Down, one page: " + stage.scroll_y().to_string() + " page " + page.to_string())
  t.key(16)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page * 2.0).abs() < 1.0, "Page Down again, two pages: " + stage.scroll_y().to_string())
  t.key(15)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page).abs() < 1.0, "Page Up, a page back: " + stage.scroll_y().to_string())
  // (End: the foot, where the page can go no further)
  t.key(9)
  t.run_for(1200.0)
  let foot = stage.scroll_y()
  debug_assert(foot > page * 2.0 && stage.glide.is_none(), "End: the foot " + foot.to_string())
  t.key(6)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - foot).abs() < 0.5, "at the foot ↓ goes no further")
  t.key(8)
  t.run_for(1200.0)
  debug_assert(stage.scroll_y() == 0.0, "Home again")
  t.dispose()
}

test "↓ with the pointer over a box that scrolls moves the box, not the page" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  let tree = must(stage.node).tree
  let bx = must(find_el(must(stage.doc.root()), "box"))
  let (sc, _) = stage.box(bx.uid)
  t.inner.move_to(100.0, 50.0)
  t.run_for(32.0)
  t.key(6)
  t.run_for(800.0)
  debug_assert((sc.at(tree) - view::scroll_key_line).abs() < 1.0, "the box a line: " + sc.at(tree).to_string())
  debug_assert(stage.scroll_y() == 0.0, "the page stayed: " + stage.scroll_y().to_string())
  t.dispose()
}

test "the page and its boxes show overlay scroll bars, unless they hide them" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  let tree = must(stage.node).tree
  // (a bar for each scroller: the page's, the plain box's, and the box with scrollbar-width: none, whose is not
  // drawn while it says so)
  debug_assert(tree.thumbs_now().length() == 3, "three bars: " + tree.thumbs_now().length().to_string())
  debug_assert(!(must(stage.box_bar(must(find_el(must(stage.doc.root()), "hid")).uid)).drawn)(), "the hidden box's is not drawn")
  t.inner.wheel(400.0, 400.0, 120.0)
  t.run_for(32.0)
  // (the page's thumb along its right edge, as long as what shows is of the page, moved down as it scrolled)
  let mut seen = false
  let dbg : Array[String] = []
  for id in tree.thumbs_now() {
    match tree.drawn_of(id) {
      Some(d) => {
        dbg.push(d.x.to_string() + "," + d.y.to_string() + "," + d.w.to_string() + "," + d.h.to_string())
        if d.x > 580.0 && d.x + d.w <= 604.5 && d.h >= 28.0 && d.y > 0.0 {
          seen = true
        }
      }
      None => ()
    }
  }
  debug_assert(seen, "the page's thumb along its right edge: " + dbg.join(" | "))
  t.dispose()
}

test "a box's bar follows its style as it changes: a class that hides it later, a ::-webkit-scrollbar rule" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  let host = TestHost::new(scroll_html, scroll_css + " .wk::-webkit-scrollbar { display: none }")
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let bx = must(find_el(must(stage.doc.root()), "box"))
  let hid = must(find_el(must(stage.doc.root()), "hid"))
  debug_assert((must(stage.box_bar(bx.uid)).drawn)(), "a plain box draws its bar")
  debug_assert(!(must(stage.box_bar(hid.uid)).drawn)(), "scrollbar-width: none hides the box's")
  // (the page gives the box a class whose ::-webkit-scrollbar hides it: hidden now, the same bar)
  let bar = must(stage.box_bar(bx.uid))
  for a in must(find_el(host.doc, "box")).attrs {
    if a.name == "class" {
      a.value = "box wk"
    }
  }
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(0)) })
  t.run_for(shown_ms)
  debug_assert(!(bar.drawn)(), "hidden by its later class")
  t.dispose()
}

fn root_bar_drawn(extra_css : String) -> Bool {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(TestHost::new(scroll_html, scroll_css + extra_css).reset()) })
  t.run_for(shown_ms)
  let drawn = match stage.page_bar() {
    Some(b) => (b.drawn)()
    None => {
      debug_assert(false, "the page always has its bar, drawn or not")
      false
    }
  }
  t.dispose()
  drawn
}

test "a page whose root hides its bar (scrollbar-width: none, ::-webkit-scrollbar) draws none; else it draws its own" {
  debug_assert(root_bar_drawn(""), "a page's bar is drawn")
  debug_assert(!root_bar_drawn(" html { scrollbar-width: none }"), "scrollbar-width: none on the root hides it")
  debug_assert(!root_bar_drawn(" ::-webkit-scrollbar { display: none }"), "::-webkit-scrollbar display: none hides it")
  debug_assert(!root_bar_drawn(" html::-webkit-scrollbar { width: 0 }"), "::-webkit-scrollbar width 0 hides it")
  debug_assert(root_bar_drawn(" ::-webkit-scrollbar { width: 8px } ::-webkit-scrollbar-thumb { background: red }"), "a styled bar is still a bar")
}
