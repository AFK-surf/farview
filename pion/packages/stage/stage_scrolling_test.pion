///| Scrolling as the platform scrolls: a mouse wheel's notches eased in, the page's keys gliding it, overlay bars.

let scroll_html : String = "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
"<div id=box class=box><div class=inner></div></div><div id=hid class='box hid'><div class=inner></div></div>" +
"<div class=tall></div></body></html>"

let scroll_css : String = "body { margin: 0 } .box { overflow: auto; height: 100px; width: 300px } " +
".hid { scrollbar-width: none } .inner { height: 900px } .tall { height: 4000px }"

fn scroll_stage(sent : Array[Bytes]) -> (Stage, StageTester) {
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(TestHost::new(scroll_html, scroll_css).reset()) })
  t.run_for(shown_ms)
  (stage, t)
}

test "a mouse wheel's notch eases the page in over ~200ms; a trackpad's moves it at once" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  // (a notch: phase 4, as the host says a mouse's wheel)
  t.inner.wheel(400.0, 400.0, 40.0, phase=4)
  let y0 = stage.scroll_y()
  debug_assert(y0 >= 0.0 && y0 < 30.0, "a notch does not jump: " + y0.to_string())
  t.run_for(80.0)
  let y1 = stage.scroll_y()
  debug_assert(y1 > y0 && y1 < 40.0, "under way: " + y1.to_string())
  t.run_for(600.0)
  debug_assert((stage.scroll_y() - 40.0).abs() < 0.5, "comes to the notch's 40: " + stage.scroll_y().to_string())
  // (a trackpad's fingers: where they move it, at once)
  t.inner.wheel(400.0, 400.0, 25.0)
  debug_assert((stage.scroll_y() - 65.0).abs() < 0.5, "trackpad at once: " + stage.scroll_y().to_string())
  t.dispose()
}

test "a page whose root says scrollbar-width: none draws no bar of its own" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(TestHost::new(scroll_html, scroll_css + " html { scrollbar-width: none }").reset()) })
  t.run_for(shown_ms)
  match stage.page_bar() {
    Some(b) => debug_assert(!(b.drawn)(), "the root hides the page's bar")
    None => ()
  }
  t.dispose()
}

test "the page's keys glide it: Space, Page Down and arrows ease in, carry on when pressed again, Home goes back" {
  let sent : Array[Bytes] = []
  let (stage, t) = scroll_stage(sent)
  let page = stage.room.1 - view::scroll_key_line
  t.key(1032)
  let a = stage.scroll_y()
  debug_assert(a < page * 0.5, "Space does not jump: " + a.to_string())
  t.run_for(48.0)
  let b = stage.scroll_y()
  debug_assert(b > a && b < page, "Space glides: " + b.to_string())
  // (pressed again while it goes: on to two pages, not back)
  t.key(1032)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page * 2.0).abs() < 1.0, "two Spaces, two pages: " + stage.scroll_y().to_string() + " page " + page.to_string())
  debug_assert(stage.glide.is_none(), "at rest")
  // (Shift+Space back a page)
  t.key(1032, mods=1)
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - page).abs() < 1.0, "Shift+Space a page back")
  // (an arrow, with the pointer away from the boxes: a line)
  t.inner.move_to(400.0, 400.0)
  t.key(6)
  let c = stage.scroll_y()
  t.run_for(800.0)
  debug_assert(c < page + view::scroll_key_line - 1.0 && (stage.scroll_y() - page - view::scroll_key_line).abs() < 1.0, "↓ glides a line")
  // (the wheel during a glide: the wheel's from there)
  t.key(9)
  t.run_for(32.0)
  t.inner.wheel(400.0, 400.0, -10.0)
  let w = stage.scroll_y()
  t.run_for(800.0)
  debug_assert((stage.scroll_y() - w).abs() < 1.0 && stage.glide.is_none(), "the wheel ends the glide where it leaves it")
  t.key(8)
  t.run_for(800.0)
  debug_assert(stage.scroll_y() == 0.0, "Home: the top")
  t.dispose()
}

