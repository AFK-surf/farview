///| A `<select>` taken by the keys as a native one is (select.pion: Stage::select_key).

let fruit_html : String = "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
"<select id=s><option value=a>Apple</option><option value=b>Banana</option><option value=bb>Blueberry</option>" +
"<option value=c selected>Cherry</option><option value=d disabled>Date</option><option value=e>Elderberry</option></select>" +
"<p id=after>after</p></body></html>"

fn picked_values(sent : Array[Bytes]) -> Array[String] {
  let out : Array[String] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::EditInput(_, _, v, _, _, k) => if k == proto::EDIT_CHANGE { out.push(v) }
      _ => ()
    }
  }
  out
}

test "type-ahead finds an option by its first letters, the same letter stepping through those it starts" {
  let opts = [
    Choice::{ label: "Apple", index: 0, disabled: false, chosen: false },
    Choice::{ label: "Banana", index: 1, disabled: false, chosen: false },
    Choice::{ label: "Blueberry", index: 2, disabled: false, chosen: false },
    Choice::{ label: " cherry", index: 3, disabled: false, chosen: true },
  ]
  debug_assert(type_ahead(opts, "b", 3) == 1, "b from Cherry: Banana")
  debug_assert(type_ahead(opts, "b", 1) == 2, "b again: Blueberry")
  debug_assert(type_ahead(opts, "bb", 2) == 1, "the same letter twice steps round: Banana")
  debug_assert(type_ahead(opts, "bl", 1) == 2, "more letters: the one they start")
  debug_assert(type_ahead(opts, "ch", 0) == 3, "case and leading spaces ignored")
  debug_assert(type_ahead(opts, "z", 0) == -1, "none")
}

test "a select's list is driven by the keys: arrows mark, Enter picks, Escape shuts; closed, letters pick and arrows open" {
  let sent : Array[Bytes] = []
  let stage = Stage::new(fn(b : Bytes) -> Unit { sent.push(b) })
  let host = TestHost::new(fruit_html, select_css)
  let wide = signals::signal(600.0)
  let t = shown_with_keys(stage, wide, w=600.0, h=600.0)
  t.draw()
  stage.opened()
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  let sel = must(stage.doc.node(must(find_el(host.doc, "s")).uid))
  // (opened by a tap: Cherry, the one chosen, marked)
  t.tap(100.0, 35.0)
  t.run_for(shown_ms)
  debug_assert(stage.select_open.untracked().is_some() && stage.select_hi.untracked() == 3, "open, Cherry marked")
  t.key(6)
  t.run_for(frame_ms)
  debug_assert(stage.select_hi.untracked() == 5, "↓ skips the disabled Date to Elderberry")
  t.key(6)
  t.run_for(frame_ms)
  debug_assert(stage.select_hi.untracked() == 5, "↓ at the end stays")
  t.key(8)
  t.run_for(frame_ms)
  debug_assert(stage.select_hi.untracked() == 0, "Home: Apple")
  t.key(1098)
  t.run_for(frame_ms)
  debug_assert(stage.select_hi.untracked() == 1, "b: Banana")
  t.key(1098)
  t.run_for(frame_ms)
  debug_assert(stage.select_hi.untracked() == 2, "b again: Blueberry")
  debug_assert(picked_values(sent).length() == 0, "nothing chosen while marking")
  sent.clear()
  t.key(7)
  t.run_for(shown_ms)
  debug_assert(stage.select_open.untracked().is_none(), "Enter shuts the list")
  debug_assert(html::select_label(sel) == "Blueberry", "Enter picks the marked option")
  let pv = picked_values(sent)
  debug_assert(pv.length() == 1 && pv[0] == "bb", "one change to the host")
  // (nothing of the open list's keys reaches the page)
  t.tap(100.0, 35.0)
  t.run_for(shown_ms)
  sent.clear()
  t.key(5)
  t.key(17)
  t.run_for(shown_ms)
  let keys : Array[String] = []
  for m in said(sent) {
    match m {
      proto::ClientMsg::Key(_, _, true, k, _, _, _) => keys.push(k)
      _ => ()
    }
  }
  debug_assert(keys.length() == 0, "the open list's keys are its own: " + keys.join(","))
  debug_assert(stage.select_open.untracked().is_none() && html::select_label(sel) == "Blueberry", "Escape shuts it, nothing chosen")
  // (closed, the focus on it: letters pick, ↓ opens)
  host.focus = "s"
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(0)) })
  t.run_for(shown_ms)
  match stage.doc.focused() {
    Some(n) => debug_assert(n.uid == sel.uid, "the page's focus is on the select")
    None => debug_assert(false, "focus synced")
  }
  sent.clear()
  t.wall_val = 100000.0
  t.key(1101)
  t.run_for(frame_ms)
  debug_assert(html::select_label(sel) == "Elderberry", "e picks Elderberry, closed")
  debug_assert(stage.select_open.untracked().is_none(), "a letter does not open it")
  t.key(6)
  t.run_for(frame_ms)
  debug_assert(stage.select_open.untracked().is_some() && stage.select_hi.untracked() == 5, "↓ opens it at the chosen one")
  t.key(17)
  t.run_for(frame_ms)
  // (the focus elsewhere: the keys are the page's again, Space scrolling it)
  host.focus = "after"
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.patch(0)) })
  t.run_for(shown_ms)
  t.key(1101)
  t.run_for(frame_ms)
  debug_assert(html::select_label(sel) == "Elderberry" && stage.select_open.untracked().is_none(), "not the select's")
  t.dispose()
}
