///| The form field being edited, as the password manager's autofill dropdown needs it (read-only: nothing here
///| changes the stage).

pub struct LoginField {
  ///| the field's wire id (what `EditInput` and the host's password verbs name it by)
  pub id : Int
  pub secret : Bool
  ///| its window rectangle in points (zero size when it is not laid out yet)
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
}

///| The single-line field the person is editing now, if any (tracked: changes as the focus moves).
pub fn Stage::login_field(self : Stage) -> Option[LoginField] {
  match self.field.get() {
    Some(e) if !e.lines => {
      let z = self.zoom()
      let (vx, vy) = match self.ux_view_rect() {
        Some((x, y, _, _)) => (x, y)
        None => (0.0, 0.0)
      }
      match self.shown_rect(e.node, self.page_y) {
        Some((x, y, w, h)) =>
        Some(LoginField::{ id: e.node.wire_id, secret: e.secret, x: vx + x * z, y: vy + (y - self.page_y) * z, w: w * z, h: h * z })
        None => Some(LoginField::{ id: e.node.wire_id, secret: e.secret, x: 0.0, y: 0.0, w: 0.0, h: 0.0 })
      }
    }
    _ => None
  }
}
