///| WebFont pre-upload gate: every SFNT / TrueType / OpenType / TTC payload (including the WOFF/WOFF2
///| decode output) is parsed with `opentype::Face::parse` before it may reach a native host font slot,
///| so malformed, truncated, non-SFNT or table-less fonts are rejected without consuming a slot.

import "opentype"

///| Upper bound on a font payload handed to a host slot (decoded SFNT bytes).
let max_webfont_bytes : Int = 64 * 1024 * 1024

///| Metadata of a WebFont that passed the gate.
pub struct WebFontInfo {
  pub kind : String
  pub units_per_em : Int
  pub glyph_count : Int
  pub has_cmap : Bool
  pub is_variable : Bool
  pub axis_count : Int
  ///| `(min, max)` of the `wght` variation axis, if any.
  pub weight_range : Option[(Double, Double)]
  pub weight_class : Int
  pub italic : Bool
}

fn tag_present(face : opentype::Face, name : String) -> Bool {
  face.table_data_by_name(name).is_some()
}

///| Validate SFNT/TTC bytes (face 0) and extract the metadata the stage needs. Rejects payloads that are
///| empty or oversized, not an SFNT/TTC, fail `opentype` parsing (bad magic, truncated directory,
///| bad/missing `head`/`maxp`, limit exceeded), lack `cmap`/`hhea`/`hmtx`, carry an `hmtx` shorter than
///| `hhea.numberOfHMetrics` requires, or ship `glyf` without `loca`.
pub fn inspect_webfont_sfnt(raw : Bytes) -> Result[WebFontInfo, String] {
  if raw.length() > max_webfont_bytes {
    return Err("font larger than " + max_webfont_bytes.to_string() + " bytes")
  }
  let face = match opentype::Face::parse(raw, 0) {
    Ok(f) => f
    Err(e) => return Err(e.to_string())
  }
  let has_cmap = tag_present(face, "cmap")
  if !has_cmap {
    return Err("missing required table: cmap")
  }
  let glyphs = face.number_of_glyphs()
  let nhm = match face.hhea() {
    Some(h) => h.number_of_h_metrics
    None => return Err("missing required table: hhea")
  }
  let hmtx_len = match face.table_data_by_name("hmtx") {
    Some(t) => t.length()
    None => return Err("missing required table: hmtx")
  }
  if nhm <= 0 || nhm > glyphs {
    return Err("hhea numberOfHMetrics out of range")
  }
  if hmtx_len < nhm * 4 {
    return Err("hmtx shorter than numberOfHMetrics")
  }
  if tag_present(face, "glyf") && !tag_present(face, "loca") {
    return Err("glyf without loca")
  }
  let axes = face.variation_axes()
  let wght = match opentype::Tag::from_string("wght") {
    Some(t) => t.value
    None => -1L
  }
  let mut weight_range : Option[(Double, Double)] = None
  for a in axes {
    if a.tag.value == wght {
      weight_range = Some((a.min_value, a.max_value))
      break
    }
  }
  let (weight_class, os2_italic) = match face.os2() {
    Some(o) => (o.weight_class, (o.fs_selection & 1) != 0)
    None => (400, false)
  }
  Ok(
    WebFontInfo::{
      kind: face.kind().to_string(),
      units_per_em: face.units_per_em(),
      glyph_count: glyphs,
      has_cmap: has_cmap,
      is_variable: axes.length() > 0,
      axis_count: axes.length(),
      weight_range: weight_range,
      weight_class: weight_class,
      italic: os2_italic || (face.head().mac_style & 2) != 0,
    },
  )
}
