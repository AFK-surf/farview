///| Native `<select>` dropdown popup overlay.
///| 1:1 port of `client/src/stage/select.mbt`.

import "html"
import "css"
import "proto"
import "view"
import "ui"

let select_most : Double = 320.0
let select_room : Double = 8.0
let select_pad : Double = 4.0
let select_corner : Double = 8.0
let select_chosen : Int64 = 0x0060DFFFL
let select_grey : Int64 = 0x6E6E73FFL

struct Choice {
  label : String
  index : Int
  disabled : Bool
  chosen : Bool
}

fn choices(sel : html::Node) -> Array[Choice] {
  let chosen = html::chosen_option(sel)
  let out : Array[Choice] = []
  let idx : Array[Int] = [0]
  let add_option = fn(o : html::Node, group_off : Bool) -> Unit {
    let i = idx[0]
    out.push(
      Choice::{
        label: html::option_label(o),
        index: i,
        disabled: group_off || o.attr("disabled").is_some(),
        chosen: i == chosen,
      },
    )
    idx[0] = i + 1
  }
  for c in sel.children {
    if !(c.kind is html::Kind::Element) {
      continue
    }
    if c.tag == "option" {
      add_option(c, false)
    } else if c.tag == "optgroup" {
      let off = c.attr("disabled").is_some()
      out.push(Choice::{ label: c.attr("label").unwrap_or(""), index: -1, disabled: off, chosen: false })
      for o in c.children {
        if o.kind is html::Kind::Element && o.tag == "option" {
          add_option(o, off)
        }
      }
    }
  }
  out
}

fn picks_here(n : html::Node) -> Bool {
  if !(n.kind is html::Kind::Element) || n.tag != "select" {
    return false
  }
  if n.attr("multiple").is_some() || n.attr("disabled").is_some() {
    return false
  }
  match n.attr("size") {
    Some(v) => if css::parse_double(v) > 1.0 { return false }
    None => ()
  }
  let mut cur = n.parent
  while true {
    match cur {
      Some(p) => {
        if p.kind is html::Kind::Element && p.tag == "fieldset" && p.attr("disabled").is_some() {
          return false
        }
        cur = p.parent
      }
      None => break
    }
  }
  true
}

fn Stage::choose(self : Stage, sel : html::Node, index : Int) -> Unit {
  self.select_open.set(None)
  if index == html::chosen_option(sel) {
    return
  }
  self.seq += 1
  for o in html::select_options(sel) {
    self.typed.set(o.wire_id, (self.seq, ""))
  }
  self.doc.choose(sel, index)
  let value = html::control_value(sel)
  self.out(proto::ClientMsg::EditInput(self.seq, sel.wire_id, value, index, index, proto::EDIT_CHANGE))
  self.changed.set(self.changed.untracked() + 1)
}

fn choice_look(size : Double, weight : Int) -> view::WordsLook {
  view::WordsLook::{
    size,
    weight,
    line: (size * 1.3).ceil(),
    wrap: false,
    tracking: view::Spacing::Points(0.0),
    balance: false,
    max_lines: 1,
  }
}

fn select_list(o : view::View, stage : Stage, sel : html::Node) -> Unit {
  let style_opt = match stage.doc.box_of(sel) {
    Some((b, _, _)) => Some(b.style)
    None => None
  }
  let size = dmax(
    match style_opt {
      Some(s) => s.font_size
      None => 13.0
    },
    12.0,
  )
  let row_h = (size * 1.3).ceil() + 8.0
  let rows = choices(sel)
  let fonts = stage.fonts
  let font = match style_opt {
    Some(s) => fonts.pick(s)
    None => 0
  }
  let mut widest = 0.0
  let mut has_groups = false
  let mut chosen_at = 0
  let mut ri = 0
  while ri < rows.length() {
    let r = rows[ri]
    widest = dmax(widest, fonts.width(font, size, r.label))
    if r.index < 0 {
      has_groups = true
    }
    if r.chosen {
      chosen_at = ri
    }
    ri += 1
  }
  let list_h = dmin(rows.length().to_double() * row_h + select_pad * 2.0, select_most)
  let at = fn() -> (Double, Double, Double, Double) {
    let _ = stage.changed.get()
    let page_y = stage.page_at(o.tree)
    let (x, y, w, h) = match stage.shown_rect(sel, page_y) {
      Some(r) => r
      None => (0.0, 0.0, 0.0, 0.0)
    }
    let width = dmax(w, widest * 1.08 + 34.0 + select_pad * 2.0)
    let room_h = stage.room.1
    let below = y + h + 2.0
    let over = below + list_h > page_y + room_h && y - page_y > page_y + room_h - (y + h)
    let room = (if over { y - 2.0 - page_y } else { page_y + room_h - below }) - select_room
    let height = dmin(list_h, dmax(room, row_h + select_pad * 2.0))
    let top = if over { y - 2.0 - height } else { below }
    let left = dmin(x, dmax(stage.size.get().0 - width, 0.0))
    (left, top, width, height)
  }
  let scroll = view::Scroll::new()
  let start = dmax(chosen_at.to_double() * row_h - list_h / 2.0, 0.0)
  scroll.put(dmin(start, dmax(rows.length().to_double() * row_h + select_pad * 2.0 - list_h, 0.0)))
  let _ = o.box(fn(panel : view::View) -> Unit {
    let _ = panel
    .over(view::Live::Is(true))
    .offset(view::Live::By(fn() -> (Double, Double) { let t = at(); (t.0, t.1) }))
    .width(view::Live::By(fn() -> Option[Double] { Some(at().2) }))
    .height(view::Live::By(fn() -> Option[Double] { Some(at().3) }))
    .ground(view::Live::Is(0xFFFFFFFFL))
    .radius(view::Live::Is(select_corner))
    .edge(view::Live::Is((1.0, 0x0000001FL)))
    .shadow(view::Live::Is((8.0, 4.0, 0x00000033L)))
    .clips(view::Live::Is(true))
    .on_press(fn() -> Unit { () })
    let _ = panel.scrolls(
      scroll,
      fn(col : view::View) -> Unit {
        let _ = col.pad(view::Live::Is(select_pad))
        for r in rows {
          let _ = col.box(fn(row : view::View) -> Unit {
            let picks = r.index >= 0 && !r.disabled
            let indent = if r.index >= 0 && has_groups { 10.0 } else { 0.0 }
            let _ = row
            .height(view::Live::Is(Some(row_h)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .padding(view::Live::Is((12.0 + indent, 0.0, 12.0, 0.0)))
            .radius(view::Live::Is(select_corner - select_pad))
            if r.chosen {
              let _ = row.ground(view::Live::Is(select_chosen))
            }
            let ink = if r.chosen {
              0xFFFFFFFFL
            } else if r.disabled || r.index < 0 {
              select_grey
            } else {
              0x1D1D1FFFL
            }
            let _ = row.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is(r.label), ink=ink, look=choice_look(size, if r.index < 0 { 600 } else { 400 }))
            })
            let _ = row.on_press(fn() -> Unit { if picks { stage.choose(sel, r.index) } })
          })
        }
      },
      slop=ui::touch_slop(),
    )
  })
}
