///| Native `<select>` dropdown popup overlay.
///| 1:1 port of `client/src/stage/select.mbt`.

import "html"
import "css"
import "proto"
import "unicode_segment"
import "view"
import "ui"
import "hostapi"

let select_most : Double = 320.0
let select_room : Double = 8.0
let select_pad : Double = 4.0
let select_corner : Double = 8.0
let select_chosen : Int64 = 0x0060DFFFL
let select_grey : Int64 = 0x6E6E73FFL

struct Choice {
  label : String
  index : Int
  disabled : Bool
  chosen : Bool
}

fn choices(sel : html::Node) -> Array[Choice] {
  let chosen = html::chosen_option(sel)
  let out : Array[Choice] = []
  let idx : Array[Int] = [0]
  let add_option = fn(o : html::Node, group_off : Bool) -> Unit {
    let i = idx[0]
    out.push(
      Choice::{
        label: html::option_label(o),
        index: i,
        disabled: group_off || o.attr("disabled").is_some(),
        chosen: i == chosen,
      },
    )
    idx[0] = i + 1
  }
  for c in sel.children {
    if !(c.kind is html::Kind::Element) {
      continue
    }
    if c.tag == "option" {
      add_option(c, false)
    } else if c.tag == "optgroup" {
      let off = c.attr("disabled").is_some()
      out.push(Choice::{ label: c.attr("label").unwrap_or(""), index: -1, disabled: off, chosen: false })
      for o in c.children {
        if o.kind is html::Kind::Element && o.tag == "option" {
          add_option(o, off)
        }
      }
    }
  }
  out
}

fn picks_here(n : html::Node) -> Bool {
  if !(n.kind is html::Kind::Element) || n.tag != "select" {
    return false
  }
  if n.attr("multiple").is_some() || n.attr("disabled").is_some() {
    return false
  }
  match n.attr("size") {
    Some(v) => if css::parse_double(v) > 1.0 { return false }
    None => ()
  }
  let mut cur = n.parent
  while true {
    match cur {
      Some(p) => {
        if p.kind is html::Kind::Element && p.tag == "fieldset" && p.attr("disabled").is_some() {
          return false
        }
        cur = p.parent
      }
      None => break
    }
  }
  true
}

fn Stage::choose(self : Stage, sel : html::Node, index : Int) -> Unit {
  self.select_open.set(None)
  if index == html::chosen_option(sel) {
    return
  }
  self.seq += 1
  for o in html::select_options(sel) {
    self.typed.set(o.wire_id, (self.seq, ""))
  }
  self.doc.choose(sel, index)
  let value = html::control_value(sel)
  self.out(proto::ClientMsg::EditInput(self.seq, sel.wire_id, value, index, index, proto::EDIT_CHANGE))
  self.changed.set(self.changed.untracked() + 1)
}

///| How long a pause ends a type-ahead's letters (Chrome's: a second), so the next starts a new search.
let select_type_pause_ms : Double = 1000.0

///| The options one can pick of `sel`, by index, in order (what its keys step through).
fn pickable(sel : html::Node) -> Array[Choice] {
  let out : Array[Choice] = []
  for c in choices(sel) {
    if c.index >= 0 && !c.disabled {
      out.push(c)
    }
  }
  out
}

///| The option a type-ahead of `typed` (lowercase) comes to from `from` (an option's index), as Chrome's does: the
///| same letter again and again steps through those starting with it, after `from`; more letters, the first from
///| `from` on whose label starts with them; -1 where none does.
fn type_ahead(opts : Array[Choice], typed : String, from : Int) -> Int {
  let n = opts.length()
  if n == 0 || typed == "" {
    return -1
  }
  let mut same = true
  for i in 1..<typed.length() {
    if typed.code_unit_at(i) != typed.code_unit_at(0) {
      same = false
    }
  }
  let prefix = if same { typed.slice(0, 1) } else { typed }
  let mut at = 0
  for i in 0..<n {
    if opts[i].index == from {
      at = i
    }
  }
  // (one letter, or the same again: the next after where it is; more: from where it is)
  let start = if same { at + 1 } else { at }
  for k in 0..<n {
    let o = opts[(start + k) % n]
    if st_ascii_lower(o.label.trim()).starts_with(prefix) {
      return o.index
    }
  }
  -1
}

///| A key of the person's (ui's code: ↑ 5, ↓ 6, Enter 7, Home 8, End 9, Page Up 15, Page Down 16, Escape 17,
///| Tab 18, 1000 + a character) at a `<select>`, as a native one takes it: while its list is open, the list's (↑ ↓
///| Home End and the pages move what is marked, Enter and Space pick it, letters search; the page told none of
///| them); closed, with the focus on it, ↑ ↓ Space and Enter open its list and letters pick the option they come to.
///| Whether it was the select's.
fn Stage::select_key(self : Stage, code : Int) -> Bool {
  match self.select_open.untracked() {
    Some(sel) => {
      let opts = pickable(sel)
      if code == 18 {
        self.select_open.set(None)
        return false
      }
      if opts.length() == 0 {
        return true
      }
      let hi = self.select_hi.untracked()
      let mut at = -1
      for i in 0..<opts.length() {
        if opts[i].index == hi {
          at = i
        }
      }
      let last = opts.length() - 1
      let mark = fn(i : Int) -> Unit { self.select_hi.set(opts[imax(0, imin(i, last))].index) }
      if code == 6 {
        mark(if at < 0 { 0 } else { at + 1 })
      } else if code == 5 {
        mark(if at < 0 { last } else { at - 1 })
      } else if code == 8 {
        mark(0)
      } else if code == 9 {
        mark(last)
      } else if code == 16 {
        mark(at + 10)
      } else if code == 15 {
        mark(at - 10)
      } else if code == 7 || code == 1032 {
        if at >= 0 {
          self.choose(sel, opts[at].index)
        } else {
          self.select_open.set(None)
        }
      } else if code > 1032 {
        let i = self.type_into(opts, code - 1000, hi)
        if i >= 0 {
          self.select_hi.set(i)
        }
      }
      true
    }
    None => {
      let sel = match self.doc.focused() {
        Some(n) if picks_here(n) => n
        _ => return false
      }
      if (code == 5 || code == 6) && !proto::keys_are_macos(ui::keys_system()) {
        // (Chrome on Windows and Linux: ↑ and ↓ on a closed select step its value, the list left shut; on a Mac
        // they open it)
        match step_choice(pickable(sel), html::chosen_option(sel), if code == 6 { 1 } else { -1 }) {
          Some(i) => self.choose(sel, i)
          None => ()
        }
        true
      } else if code == 5 || code == 6 || code == 7 || code == 1032 {
        self.open_select(sel)
        true
      } else if code > 1032 {
        let i = self.type_into(pickable(sel), code - 1000, html::chosen_option(sel))
        if i >= 0 {
          self.choose(sel, i)
        }
        true
      } else {
        false
      }
    }
  }
}

///| The option a step `dir` (1 on, -1 back) from the chosen one (`from`, an option's index, -1 for none) comes to
///| among those that can be picked, as a closed select's ↑ and ↓ step it on Windows and Linux; None at an end.
fn step_choice(opts : Array[Choice], from : Int, dir : Int) -> Option[Int] {
  if opts.length() == 0 {
    return None
  }
  let mut at = -1
  for i, c in opts {
    if c.index == from {
      at = i
    }
  }
  if at < 0 {
    return Some(if dir > 0 { opts[0].index } else { opts[opts.length() - 1].index })
  }
  let to = at + dir
  if to < 0 || to >= opts.length() { None } else { Some(opts[to].index) }
}

///| A letter `cp` typed at a select's options, after those typed within the pause before it: the option they come
///| to from `from` (-1: none).
fn Stage::type_into(self : Stage, opts : Array[Choice], cp : Int, from : Int) -> Int {
  let now = hostapi::wall_ms()
  if now - self.select_typed_at > select_type_pause_ms {
    self.select_typed = ""
  }
  self.select_typed_at = now
  self.select_typed = self.select_typed + st_ascii_lower(cp.unsafe_to_char().to_string())
  type_ahead(opts, self.select_typed, from)
}

///| The list of `sel` opened, what is chosen in it marked.
fn Stage::open_select(self : Stage, sel : html::Node) -> Unit {
  self.select_typed = ""
  self.select_hi.set(html::chosen_option(sel))
  self.select_open.set(Some(sel))
}

fn choice_look(size : Double, weight : Int) -> view::WordsLook {
  view::WordsLook::{
    size,
    weight,
    line: (size * 1.3).ceil(),
    wrap: false,
    tracking: view::Spacing::Points(0.0),
    balance: false,
    max_lines: 1,
    tabular: None,
    diagonal_fractions: false,
  }
}

fn select_list(o : view::View, stage : Stage, sel : html::Node) -> Unit {
  let style_opt = match stage.doc.box_of(sel) {
    Some((b, _, _)) => Some(b.style)
    None => None
  }
  let size = dmax(
    match style_opt {
      Some(s) => s.font_size
      None => 13.0
    },
    12.0,
  )
  let row_h = (size * 1.3).ceil() + 8.0
  let rows = choices(sel)
  let fonts = stage.fonts
  let font = match style_opt {
    Some(s) => fonts.pick(s)
    None => 0
  }
  let mut widest = 0.0
  let mut has_groups = false
  let mut chosen_at = 0
  let mut ri = 0
  while ri < rows.length() {
    let r = rows[ri]
    widest = dmax(widest, fonts.width(font, size, r.label))
    if r.index < 0 {
      has_groups = true
    }
    if r.chosen {
      chosen_at = ri
    }
    ri += 1
  }
  let list_h = dmin(rows.length().to_double() * row_h + select_pad * 2.0, select_most)
  let at = fn() -> (Double, Double, Double, Double) {
    let _ = stage.changed.get()
    let page_y = stage.page_at(o.tree)
    let (x, y, w, h) = match stage.viewport_rect(sel, page_y) {
      Some(r) => r
      None => (0.0, 0.0, 0.0, 0.0)
    }
    let width = dmax(w, widest * 1.08 + 34.0 + select_pad * 2.0)
    let room_h = stage.room.1
    let below = y + h + 2.0
    let over = below + list_h > room_h && y > room_h - (y + h)
    let room = (if over { y - 2.0 } else { room_h - below }) - select_room
    let height = dmin(list_h, dmax(room, row_h + select_pad * 2.0))
    let top = if over { y - 2.0 - height } else { below }
    let left = dmin(x, dmax(stage.size.get().0 - width, 0.0))
    (left, top, width, height)
  }
  let scroll = view::Scroll::new()
  let start = dmax(chosen_at.to_double() * row_h - list_h / 2.0, 0.0)
  scroll.put(dmin(start, dmax(rows.length().to_double() * row_h + select_pad * 2.0 - list_h, 0.0)))
  // (the row marked by the keys kept in sight: scrolled to as it goes past an end of what shows)
  let row_of = fn(index : Int) -> Int {
    let mut k = -1
    for i in 0..<rows.length() {
      if rows[i].index == index {
        k = i
      }
    }
    k
  }
  o.reacts(fn() -> Int { stage.select_hi.get() }, fn(hi : Int) -> Unit {
    let k = row_of(hi)
    if k < 0 {
      return
    }
    let shown = at().3
    let top = k.to_double() * row_h
    let now = scroll.at(o.tree)
    if top < now {
      scroll.put(top)
    } else if top + row_h + select_pad * 2.0 > now + shown {
      scroll.put(top + row_h + select_pad * 2.0 - shown)
    }
  }, at_start=false)
  let _ = o.box(fn(panel : view::View) -> Unit {
    let _ = panel
    .over(view::Live::Is(true))
    .offset(view::Live::By(fn() -> (Double, Double) { let t = at(); (t.0, t.1) }))
    .width(view::Live::By(fn() -> Option[Double] { Some(at().2) }))
    .height(view::Live::By(fn() -> Option[Double] { Some(at().3) }))
    .ground(view::Live::Is(0xFFFFFFFFL))
    .radius(view::Live::Is(select_corner))
    .edge(view::Live::Is((1.0, 0x0000001FL)))
    .shadow(view::Live::Is((8.0, 4.0, 0x00000033L)))
    .clips(view::Live::Is(true))
    .on_press(fn() -> Unit { () })
    let _ = panel.scrolls(
      scroll,
      fn(col : view::View) -> Unit {
        let _ = col.pad(view::Live::Is(select_pad))
        for r in rows {
          let _ = col.box(fn(row : view::View) -> Unit {
            let picks = r.index >= 0 && !r.disabled
            let indent = if r.index >= 0 && has_groups { 10.0 } else { 0.0 }
            let _ = row
            .height(view::Live::Is(Some(row_h)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .padding(view::Live::Is((12.0 + indent, 0.0, 12.0, 0.0)))
            .radius(view::Live::Is(select_corner - select_pad))
            // (what is marked: the chosen one as it opens, then where the keys or the pointer move it)
            let marked = fn() -> Bool { picks && stage.select_hi.get() == r.index }
            let _ = row.ground(view::Live::By(fn() -> Int64 { if marked() { select_chosen } else { 0x00000000L } }))
            let ink = fn() -> Int64 {
              if marked() {
                0xFFFFFFFFL
              } else if r.disabled || r.index < 0 {
                select_grey
              } else {
                0x1D1D1FFFL
              }
            }
            let _ = row.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is(r.label), look=choice_look(size, if r.index < 0 { 600 } else { 400 })).ink(view::Live::By(ink))
            })
            if picks {
              row.reacts(fn() -> Bool { row.pointed() }, fn(on : Bool) -> Unit { if on { stage.select_hi.set(r.index) } }, at_start=false)
            }
            let _ = row.on_press(fn() -> Unit { if picks { stage.choose(sel, r.index) } })
          })
        }
      },
      slop=ui::touch_slop(),
    )
  })
}

///| Align `byte_offset` down to a valid UAX #29 Extended Grapheme Cluster boundary in `text`,
///| ensuring multi-codepoint clusters (Emoji ZWJ, flags, combining marks, Hangul) are never split.
pub fn select_align_grapheme_start(text : String, byte_offset : Int) -> Int {
  let n = text.length()
  if byte_offset <= 0 || n == 0 {
    return 0
  }
  if byte_offset >= n {
    return n
  }
  if unicode_segment::is_grapheme_boundary(text, byte_offset) {
    byte_offset
  } else {
    proto::prev_grapheme_offset(text, byte_offset)
  }
}

///| Align `byte_offset` up to a valid UAX #29 Extended Grapheme Cluster boundary in `text`,
///| ensuring multi-codepoint clusters (Emoji ZWJ, flags, combining marks, Hangul) are never split.
pub fn select_align_grapheme_end(text : String, byte_offset : Int) -> Int {
  let n = text.length()
  if byte_offset <= 0 || n == 0 {
    return 0
  }
  if byte_offset >= n {
    return n
  }
  if unicode_segment::is_grapheme_boundary(text, byte_offset) {
    byte_offset
  } else {
    proto::next_grapheme_offset(text, byte_offset)
  }
}

///| Step the selection caret left by one UAX #29 Extended Grapheme Cluster.
pub fn select_grapheme_prev(text : String, byte_offset : Int) -> Int {
  proto::prev_grapheme_offset(text, byte_offset)
}

///| Step the selection caret right by one UAX #29 Extended Grapheme Cluster.
pub fn select_grapheme_next(text : String, byte_offset : Int) -> Int {
  proto::next_grapheme_offset(text, byte_offset)
}

///| Step the selection caret left to the previous UAX #29 word boundary (`Option+Left`).
pub fn select_word_prev(text : String, byte_offset : Int) -> Int {
  proto::prev_word_boundary(text, byte_offset)
}

///| Step the selection caret right to the next UAX #29 word boundary (`Option+Right`).
pub fn select_word_next(text : String, byte_offset : Int) -> Int {
  proto::next_word_boundary(text, byte_offset)
}

///| Compute the UAX #29 double-click word selection byte range `(start, end)` containing `byte_offset`,
///| snapping both endpoints to Extended Grapheme Cluster boundaries so Emoji ZWJ, flags,
///| combining diacritics, and CJK characters are never sliced mid-cluster.
pub fn select_word_span_at(text : String, byte_offset : Int) -> (Int, Int) {
  let n = text.length()
  if n == 0 {
    return (0, 0)
  }
  let (raw_lo, raw_hi) = proto::word_span_at_byte(text, byte_offset)
  let lo = select_align_grapheme_start(text, raw_lo)
  let hi = select_align_grapheme_end(text, raw_hi)
  if hi < lo {
    (lo, lo)
  } else {
    (lo, hi)
  }
}

///| Compute the UAX #29 double-click word selection range `(lo_cp, hi_cp)` in `utf8_cps` codepoint
///| indices for `text` at codepoint index `cp_idx`, delegating to `select_word_span_at`.
pub fn select_word_cp_span_at(text : String, cp_idx : Int) -> (Int, Int) {
  let bs = text.to_bytes()
  let n = bs.length()
  if n == 0 {
    return (0, 0)
  }
  let offsets : Array[Int] = []
  let mut i = 0
  while i < n {
    offsets.push(i)
    let b0 = bs[i].to_int() & 0xFF
    if b0 < 0x80 {
      i += 1
    } else if b0 < 0xE0 && i + 1 < n {
      i += 2
    } else if b0 < 0xF0 && i + 2 < n {
      i += 3
    } else if i + 3 < n {
      i += 4
    } else {
      i += 1
    }
  }
  let cp_len = offsets.length()
  offsets.push(n)
  let idx = if cp_idx < 0 { 0 } else if cp_idx >= cp_len { cp_len - 1 } else { cp_idx }
  let (lo_byte, hi_byte) = select_word_span_at(text, offsets[idx])
  let mut lo_cp = 0
  while lo_cp < cp_len && offsets[lo_cp + 1] <= lo_byte {
    lo_cp += 1
  }
  let mut hi_cp = lo_cp
  while hi_cp < cp_len && offsets[hi_cp] < hi_byte {
    hi_cp += 1
  }
  (lo_cp, hi_cp)
}
