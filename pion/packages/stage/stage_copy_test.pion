///| Copying what is picked on the page as plain text and HTML (copy.pion).

test "what is picked is copied with its HTML: blocks, links and how its words are set" {
  let stage = Stage::new(fn(_b : Bytes) -> Unit { () })
  let copied : Array[(String, String)] = []
  stage.set_copier(fn(plain : String, html : String) -> Unit { copied.push((plain, html)) })
  let wide = signals::signal(600.0)
  let t = shown(stage, wide)
  t.draw()
  stage.opened()
  let host = TestHost::new(
    "<!doctype html><html><head><link rel=stylesheet href=s.css></head><body>" +
    "<p>Plain <b>heavy</b> <a href=\"/docs?a=1&b=2\">a link</a> <span class=red>red &amp; hot</span></p>" +
    "<h2>A title</h2><ul><li><i>slanted</i> item</li></ul></body></html>",
    "body { margin: 0; font-size: 16px } .red { color: rgb(200, 0, 0) }",
  )
  ui::answered_from_outside(fn() -> Unit { stage.feed(host.reset()) })
  t.run_for(shown_ms)
  debug_assert(!stage.copy_selection(), "nothing picked, nothing copied")
  debug_assert(stage.select_all(), "all picked")
  debug_assert(stage.copy_selection(), "copied")
  debug_assert(copied.length() == 1, "one copy")
  let (plain, html) = copied[0]
  debug_assert(plain.contains("Plain heavy a link red & hot") && plain.contains("A title"), "plain: " + plain)
  let has = fn(s : String) -> Bool { html.contains(s) }
  debug_assert(has("<meta charset=\"utf-8\">"), "charset said")
  debug_assert(has("<p>Plain <span style=\"font-weight: bold\">heavy</span> "), "bold run in its paragraph: " + html)
  debug_assert(has("<a href=\"https://t.test/docs?a=1&amp;b=2\"><span style=\"text-decoration: underline; color: rgb(0, 0, 238)\">a</span></a>"), "the link resolved, escaped, styled: " + html)
  debug_assert(has("<span style=\"color: rgb(200, 0, 0)\">red</span> <span style=\"color: rgb(200, 0, 0)\">&amp;</span>"), "colored run, escaped: " + html)
  debug_assert(has("</p><h2><span style=\"font-weight: bold\">A</span>"), "a heading its own block: " + html)
  debug_assert(has("<li><span style=\"font-style: italic\">slanted</span> item</li>"), "a list item, italic run: " + html)
  // (a part of a word picked: only that part)
  stage.pick((0, 1), (0, 3))
  debug_assert(stage.picked_words == "la", "part picked: " + stage.picked_words)
  debug_assert(stage.picked_html() == "<meta charset=\"utf-8\"><p>la</p>", "part's HTML: " + stage.picked_html())
  t.dispose()
}
