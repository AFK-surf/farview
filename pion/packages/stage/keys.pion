///| Browser key mapping and `invar/view` keymap bindings for Farview Stage.
///| 1:1 port of `client/src/stage/keys.mbt`.

import "view"

fn ascii_char_str(cp : Int) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(cp.to_byte())
  sb.to_string()
}

fn key_dom(c : Int) -> Option[(String, String, Int)] {
  let alt = 1
  let meta = 4
  match c {
    1 => Some(("Backspace", "Backspace", 0))
    2 => Some(("Delete", "Delete", 0))
    3 => Some(("ArrowLeft", "ArrowLeft", 0))
    4 => Some(("ArrowRight", "ArrowRight", 0))
    5 => Some(("ArrowUp", "ArrowUp", 0))
    6 => Some(("ArrowDown", "ArrowDown", 0))
    7 => Some(("Enter", "Enter", 0))
    8 => Some(("Home", "Home", 0))
    9 => Some(("End", "End", 0))
    12 => Some(("a", "KeyA", meta))
    13 => Some(("c", "KeyC", meta))
    14 => Some(("x", "KeyX", meta))
    15 => Some(("PageUp", "PageUp", 0))
    16 => Some(("PageDown", "PageDown", 0))
    17 => Some(("Escape", "Escape", 0))
    18 => Some(("Tab", "Tab", 0))
    20 => Some(("ArrowLeft", "ArrowLeft", alt))
    21 => Some(("ArrowRight", "ArrowRight", alt))
    22 => Some(("ArrowLeft", "ArrowLeft", meta))
    23 => Some(("ArrowRight", "ArrowRight", meta))
    26 => Some(("ArrowUp", "ArrowUp", meta))
    27 => Some(("ArrowDown", "ArrowDown", meta))
    30 => Some(("Backspace", "Backspace", alt))
    31 => Some(("Delete", "Delete", alt))
    32 => Some(("Backspace", "Backspace", meta))
    _ => if c >= 1000 {
      let cp = c - 1000
      Some((ascii_char_str(cp), char_code(cp), 0))
    } else {
      None
    }
  }
}

fn char_code(cp : Int) -> String {
  if cp >= 97 && cp <= 122 {
    "Key" + ascii_char_str(cp - 32)
  } else if cp >= 65 && cp <= 90 {
    "Key" + ascii_char_str(cp)
  } else if cp >= 48 && cp <= 57 {
    "Digit" + ascii_char_str(cp)
  } else if cp == 32 {
    "Space"
  } else if cp == 47 || cp == 63 {
    "Slash"
  } else if cp == 46 || cp == 62 {
    "Period"
  } else if cp == 44 || cp == 60 {
    "Comma"
  } else if cp == 45 || cp == 95 {
    "Minus"
  } else if cp == 61 || cp == 43 {
    "Equal"
  } else if cp == 59 || cp == 58 {
    "Semicolon"
  } else if cp == 39 || cp == 34 {
    "Quote"
  } else if cp == 91 || cp == 123 {
    "BracketLeft"
  } else if cp == 93 || cp == 125 {
    "BracketRight"
  } else if cp == 92 || cp == 124 {
    "Backslash"
  } else if cp == 96 || cp == 126 {
    "Backquote"
  } else {
    ""
  }
}

fn dom_mods(m : Int) -> Int {
  (if (m & 1) != 0 { 8 } else { 0 }) |
  (if (m & 2) != 0 { 2 } else { 0 }) |
  (if (m & 4) != 0 { 1 } else { 0 }) |
  (if (m & 8) != 0 { 4 } else { 0 })
}

let caret_context : String = "FarviewCaret"

let page_codes : Array[Int] = [
  1, 2, 3, 4, 5, 6, 7, 8, 9, 15, 16, 18, 20, 21, 22, 23, 26, 27, 30, 31, 32,
  1098, 1105, 1117, 1122, 1097, 1099, 1120,
]

let page_mods : Array[Int] = [0, 1, 2, 4, 8, 5, 9, 3]

fn page_action(code : Int, mods : Int) -> String {
  "farview.key " + code.to_string() + " " + mods.to_string()
}

fn make_free_codes() -> Array[Int] {
  let out : Array[Int] = [17, 7, 18, 8, 9, 15, 16]
  let chars = " abcdefghijklmnopqrstuvwxyz0123456789/?.,-=;'[]\\`"
  let mut i = 0
  while i < chars.length() {
    out.push(1000 + chars.code_unit_at(i))
    i += 1
  }
  out
}

let free_codes : Array[Int] = make_free_codes()

let free_meta_codes : Array[Int] = [5, 6, 26, 27]

fn free_action(code : Int, mods : Int) -> String {
  "farview.free " + code.to_string() + " " + mods.to_string()
}

let field_context : String = "FarviewField"

fn field_tab_action(mods : Int) -> String {
  "farview.field_tab " + mods.to_string()
}

let field_step_up_action : String = "farview.field_step_up"
let field_step_down_action : String = "farview.field_step_down"
let field_esc_action : String = "farview.field_esc"
let page_context : String = "FarviewPage"
let copy_action : String = "farview.copy"
let select_all_action : String = "farview.select_all"

fn shifted(cp : Int) -> Int {
  if cp >= 97 && cp <= 122 {
    cp - 32
  } else if cp == 47 {
    63
  } else if cp == 46 {
    62
  } else if cp == 44 {
    60
  } else if cp == 45 {
    95
  } else if cp == 61 {
    43
  } else if cp == 59 {
    58
  } else if cp == 39 {
    34
  } else if cp == 91 {
    123
  } else if cp == 93 {
    125
  } else if cp == 92 {
    124
  } else if cp == 96 {
    126
  } else if cp == 49 {
    33
  } else if cp == 50 {
    64
  } else if cp == 51 {
    35
  } else if cp == 52 {
    36
  } else if cp == 53 {
    37
  } else if cp == 54 {
    94
  } else if cp == 55 {
    38
  } else if cp == 56 {
    42
  } else if cp == 57 {
    40
  } else if cp == 48 {
    41
  } else {
    cp
  }
}

pub fn page_keys() -> Array[view::Binding] {
  let out : Array[view::Binding] = []
  for code in page_codes {
    for m in page_mods {
      if code >= 1000 && (m & 10) == 0 {
        continue
      }
      out.push(
        view::Binding::{
          keys: [view::Stroke::{ code, mods: m }],
          action: page_action(code, m),
          when: view::KeyWhen::In(caret_context),
        },
      )
    }
  }
  for m in [8, 2] {
    out.push(
      view::Binding::{
        keys: [view::Stroke::{ code: 1099, mods: m }],
        action: copy_action,
        when: view::KeyWhen::In(page_context),
      },
    )
    out.push(
      view::Binding::{
        keys: [view::Stroke::{ code: 1097, mods: m }],
        action: select_all_action,
        when: view::KeyWhen::All([
          view::KeyWhen::In(page_context),
          view::KeyWhen::Not(view::KeyWhen::In("Field")),
          view::KeyWhen::Not(view::KeyWhen::In(caret_context)),
        ]),
      },
    )
  }
  for m in [0, 1] {
    out.push(
      view::Binding::{
        keys: [view::Stroke::{ code: 18, mods: m }],
        action: field_tab_action(m),
        when: view::KeyWhen::In(field_context),
      },
    )
  }
  out.push(
    view::Binding::{
      keys: [view::Stroke::{ code: 5, mods: 0 }],
      action: field_step_up_action,
      when: view::KeyWhen::In(field_context),
    },
  )
  out.push(
    view::Binding::{
      keys: [view::Stroke::{ code: 6, mods: 0 }],
      action: field_step_down_action,
      when: view::KeyWhen::In(field_context),
    },
  )
  out.push(
    view::Binding::{
      keys: [view::Stroke::{ code: 17, mods: 0 }],
      action: field_esc_action,
      when: view::KeyWhen::In(field_context),
    },
  )
  for code in free_codes {
    for m in [0, 1] {
      out.push(
        view::Binding::{
          keys: [view::Stroke::{ code, mods: m }],
          action: free_action(code, m),
          when: view::KeyWhen::All([
            view::KeyWhen::In(page_context),
            view::KeyWhen::Not(view::KeyWhen::In("Field")),
          ]),
        },
      )
    }
  }
  for code in free_meta_codes {
    for m in [0, 8, 2] {
      if (code == 5 || code == 6) && m == 0 {
        continue
      }
      out.push(
        view::Binding::{
          keys: [view::Stroke::{ code, mods: m }],
          action: free_action(code, m),
          when: view::KeyWhen::All([
            view::KeyWhen::In(page_context),
            view::KeyWhen::Not(view::KeyWhen::In("Field")),
            view::KeyWhen::Not(view::KeyWhen::In(caret_context)),
          ]),
        },
      )
    }
  }
  out
}

pub let act_focus_url : String = "farview.browser.focus_url"
pub let act_reload : String = "farview.browser.reload"
pub let act_back : String = "farview.browser.back"
pub let act_forward : String = "farview.browser.forward"
pub let act_zoom_in : String = "farview.browser.zoom_in"
pub let act_zoom_out : String = "farview.browser.zoom_out"
pub let act_zoom_reset : String = "farview.browser.zoom_reset"
pub let act_find : String = "farview.browser.find"
pub let act_escape : String = "farview.browser.escape"

///| The browser's own keys, bound for the platform's primary modifier only (`is_macos`: Cmd; else Ctrl). On macOS
///| Ctrl+F / Ctrl+L / Ctrl+R are the text system's (forward a character, centre the line, ...), so they reach
///| the field that has the caret instead of opening Find or reloading.
pub fn browser_keys(is_macos : Bool) -> Array[view::Binding] {
  let out : Array[view::Binding] = []
  let pairs : Array[(Int, String)] = [
    (1108, act_focus_url), // Cmd/Ctrl+L
    (1114, act_reload), // Cmd/Ctrl+R
    (1091, act_back), // Cmd/Ctrl+[
    (1093, act_forward), // Cmd/Ctrl+]
    (1061, act_zoom_in), // Cmd/Ctrl+=
    (1043, act_zoom_in), // Cmd/Ctrl++
    (1045, act_zoom_out), // Cmd/Ctrl+-
    (1048, act_zoom_reset), // Cmd/Ctrl+0
    (1102, act_find), // Cmd/Ctrl+F
  ]
  let m = if is_macos { 8 } else { 2 }
  for p in pairs {
    out.push(
      view::Binding::{
        keys: [view::Stroke::{ code: p.0, mods: m }],
        action: p.1,
        when: view::KeyWhen::Always,
      },
    )
  }
  out.push(
    view::Binding::{
      keys: [view::Stroke::{ code: 17, mods: 0 }],
      action: act_escape,
      when: view::KeyWhen::Always,
    },
  )
  out
}
