///| Pure-Pion Portable W3C Content Security Policy Level 3 (CSP3) Engine.
///| Backed by vendored `AFK-surf/pion-packages` `csp` (`pion/packages/csp/`).
///| Zero `extern "C"`, zero `World`, zero module-level mutable state.
///|
///| Provides:
///|   - `CspDisposition` (`Enforce` / `ReportOnly`)
///|   - `CspPolicy` (multi-header intersection, merge, `upgrade-insecure-requests`,
///|     `block-all-mixed-content`, `sandbox`, `report-uri`, `report-to`)
///|   - `parse_csp_header`, `parse_csp_report_only_header`, `parse_csp_headers`
///|   - `evaluate_csp`, `evaluate_csp_url`, `evaluate_csp_inline_script`,
///|     `evaluate_csp_inline_style`, `evaluate_csp_eval`, `evaluate_csp_wasm_eval`,
///|     `evaluate_csp_frame_ancestors`, `csp_upgrade_url`

import "csp"

pub enum CspDisposition {
  Enforce
  ReportOnly
}

pub fn CspDisposition::eq(self : CspDisposition, other : CspDisposition) -> Bool {
  match (self, other) {
    (CspDisposition::Enforce, CspDisposition::Enforce) => true
    (CspDisposition::ReportOnly, CspDisposition::ReportOnly) => true
    _ => false
  }
}

///| A parsed Content Security Policy set (one or more comma/header-separated
///| CSP3 policies evaluated as a strict intersection) with a disposition.
pub struct CspPolicy {
  pub policies : Array[csp::CspPolicy]
  pub disposition : CspDisposition
}

///| Structured result of evaluating a CSP3 check.
///|
///| For `CspDisposition::ReportOnly`:
///| - `allowed` is always `true` (Report-Only never blocks loading/execution),
///| - `would_block` is `true` when the policy was violated and a report should be emitted,
///| - `report_only` is `true`.
pub val struct CspEvalResult {
  pub allowed : Bool
  pub would_block : Bool
  pub report_only : Bool
  pub violated_directive : String
  pub effective_directive : String
  pub matched_source : Option[String]
}

///| Construct an empty, permissive `CspPolicy` (`Enforce` disposition).
pub fn CspPolicy::empty() -> CspPolicy {
  CspPolicy::{ policies: [], disposition: CspDisposition::Enforce }
}

///| Returns `true` if no CSP policies are present.
pub fn CspPolicy::is_empty(self : CspPolicy) -> Bool {
  self.policies.length() == 0
}

///| Returns `true` if this policy uses `ReportOnly` disposition.
pub fn CspPolicy::is_report_only(self : CspPolicy) -> Bool {
  self.disposition.eq(CspDisposition::ReportOnly)
}

///| Combine two `CspPolicy` values into a strict intersection.
///| If either policy has `Enforce` disposition, the merged policy enforces;
///| if both are `ReportOnly`, the merged policy remains `ReportOnly`.
pub fn CspPolicy::merge(self : CspPolicy, other : CspPolicy) -> CspPolicy {
  let merged : Array[csp::CspPolicy] = []
  let mut i = 0
  while i < self.policies.length() {
    merged.push(self.policies[i])
    i = i + 1
  }
  i = 0
  while i < other.policies.length() {
    merged.push(other.policies[i])
    i = i + 1
  }
  let disp = if self.is_report_only() && other.is_report_only() {
    CspDisposition::ReportOnly
  } else {
    CspDisposition::Enforce
  }
  CspPolicy::{ policies: merged, disposition: disp }
}

///| Returns `true` if any policy in this set enables `upgrade-insecure-requests`.
pub fn CspPolicy::upgrade_insecure_requests(self : CspPolicy) -> Bool {
  let mut i = 0
  while i < self.policies.length() {
    if self.policies[i].upgrade_insecure_requests {
      return true
    }
    i = i + 1
  }
  false
}

///| Returns `true` if any policy in this set enables `block-all-mixed-content`.
pub fn CspPolicy::block_all_mixed_content(self : CspPolicy) -> Bool {
  let mut i = 0
  while i < self.policies.length() {
    if self.policies[i].block_all_mixed_content {
      return true
    }
    i = i + 1
  }
  false
}

fn sec_array_contains(arr : Array[String], needle : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == needle {
      return true
    }
    i = i + 1
  }
  false
}

///| Returns the effective `sandbox` token list if any policy specifies a `sandbox`
///| directive, or `None` if no policy sandboxes the document.
///| When multiple policies specify `sandbox`, only tokens permitted by ALL of them survive.
pub fn CspPolicy::sandbox_tokens(self : CspPolicy) -> Option[Array[String]] {
  let mut has_sandbox = false
  let mut acc : Array[String] = []
  let mut i = 0
  while i < self.policies.length() {
    match self.policies[i].sandbox_tokens {
      Option::Some(tokens) => {
        if !has_sandbox {
          has_sandbox = true
          let mut j = 0
          while j < tokens.length() {
            acc.push(tokens[j])
            j = j + 1
          }
        } else {
          let next : Array[String] = []
          let mut j = 0
          while j < acc.length() {
            if sec_array_contains(tokens, acc[j]) {
              next.push(acc[j])
            }
            j = j + 1
          }
          acc = next
        }
      }
      Option::None => ()
    }
    i = i + 1
  }
  if has_sandbox {
    Option::Some(acc)
  } else {
    Option::None
  }
}

///| Collect all `report-uri` endpoints declared across policies in this set.
pub fn CspPolicy::report_uri(self : CspPolicy) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < self.policies.length() {
    let uris = self.policies[i].report_uri
    let mut j = 0
    while j < uris.length() {
      if !sec_array_contains(out, uris[j]) {
        out.push(uris[j])
      }
      j = j + 1
    }
    i = i + 1
  }
  out
}

///| Return the first `report-to` endpoint group declared in this policy set.
pub fn CspPolicy::report_to(self : CspPolicy) -> Option[String] {
  let mut i = 0
  while i < self.policies.length() {
    match self.policies[i].report_to {
      Option::Some(ep) => return Option::Some(ep)
      Option::None => ()
    }
    i = i + 1
  }
  Option::None
}

///| Serialize all contained CSP policies as a comma-separated header value.
pub fn CspPolicy::serialize(self : CspPolicy) -> String {
  let parts : Array[String] = []
  let mut i = 0
  while i < self.policies.length() {
    parts.push(csp::serialize_csp(self.policies[i]))
    i = i + 1
  }
  parts.join(", ")
}

///| Parse a single `Content-Security-Policy` HTTP header (may contain comma-separated
///| multiple policies per RFC 9110 / W3C CSP3 §3.1).
pub fn parse_csp_header(header : String) -> Result[CspPolicy, String] {
  parse_csp_headers([header], false)
}

///| Parse a single `Content-Security-Policy-Report-Only` HTTP header.
pub fn parse_csp_report_only_header(header : String) -> Result[CspPolicy, String] {
  parse_csp_headers([header], true)
}

///| Parse one or more CSP HTTP header values into a single intersected `CspPolicy`.
pub fn parse_csp_headers(
  headers : Array[String],
  report_only : Bool,
) -> Result[CspPolicy, String] {
  match csp::parse_csp_list(headers) {
    Result::Ok(list) => {
      let disp = if report_only {
        CspDisposition::ReportOnly
      } else {
        CspDisposition::Enforce
      }
      Result::Ok(CspPolicy::{ policies: list, disposition: disp })
    }
    Result::Err(e) => Result::Err(csp::csp_error_message(e))
  }
}

fn csp_decision_to_eval_result(
  d : csp::CspDecision,
  report_only : Bool,
) -> CspEvalResult {
  let would_block = !d.allowed
  let effective_allowed = if report_only { true } else { d.allowed }
  CspEvalResult::{
    allowed: effective_allowed,
    would_block: would_block,
    report_only: report_only,
    violated_directive: d.violated_directive,
    effective_directive: d.effective_directive,
    matched_source: d.matched_source,
  }
}

///| Evaluate a W3C CSP3 resource/navigation directive against `policy`.
///|
///| Supports full directive fallback chains (`script-src-elem`/`script-src-attr` ->
///| `script-src` -> `default-src`, `style-src-elem`/`style-src-attr` -> `style-src` ->
///| `default-src`, `img-src`/`connect-src`/`font-src`/`media-src`/`frame-src`/
///| `object-src` -> `default-src`, and non-fallback directives `frame-ancestors`,
///| `base-uri`, `form-action`), `'self'`, `'none'`, `'unsafe-inline'`, `'unsafe-eval'`,
///| `'nonce-...'`, `'sha256-...'`/`'sha384-...'`/`'sha512-...'`, `'strict-dynamic'`,
///| multi-policy strict intersection, and Report-Only disposition.
pub fn evaluate_csp(
  policy : CspPolicy,
  directive : String,
  page_origin : String,
  target_url : String,
  nonce : String,
  hashes : Array[(String, String)],
  is_parser_inserted : Bool,
) -> CspEvalResult {
  let ro = policy.is_report_only()
  if policy.policies.length() == 0 {
    return CspEvalResult::{
      allowed: true,
      would_block: false,
      report_only: ro,
      violated_directive: "",
      effective_directive: sec_ascii_lower(directive),
      matched_source: Option::None,
    }
  }
  let d = csp::check_source_all(
    policy.policies,
    directive,
    page_origin,
    target_url,
    nonce,
    hashes,
    is_parser_inserted,
  )
  csp_decision_to_eval_result(d, ro)
}

///| Convenience wrapper for `evaluate_csp` without nonce/hashes (parser-inserted).
pub fn evaluate_csp_url(
  policy : CspPolicy,
  directive : String,
  page_origin : String,
  target_url : String,
) -> CspEvalResult {
  evaluate_csp(policy, directive, page_origin, target_url, "", [], true)
}

///| Evaluate an inline `<script>` element (`is_attribute = false`) or inline event
///| handler attribute (`is_attribute = true`) across all policies in `policy`.
pub fn evaluate_csp_inline_script(
  policy : CspPolicy,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspEvalResult {
  let ro = policy.is_report_only()
  let eff = if is_attribute { "script-src-attr" } else { "script-src-elem" }
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < policy.policies.length() {
    let d = csp::check_inline_script(policy.policies[i], nonce, hashes, is_attribute)
    if !d.allowed {
      return csp_decision_to_eval_result(d, ro)
    }
    match d.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspEvalResult::{
    allowed: true,
    would_block: false,
    report_only: ro,
    violated_directive: "",
    effective_directive: eff,
    matched_source: last_matched,
  }
}

///| Evaluate an inline `<style>` element (`is_attribute = false`) or inline `style=""`
///| attribute (`is_attribute = true`) across all policies in `policy`.
pub fn evaluate_csp_inline_style(
  policy : CspPolicy,
  nonce : String,
  hashes : Array[(String, String)],
  is_attribute : Bool,
) -> CspEvalResult {
  let ro = policy.is_report_only()
  let eff = if is_attribute { "style-src-attr" } else { "style-src-elem" }
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < policy.policies.length() {
    let d = csp::check_inline_style(policy.policies[i], nonce, hashes, is_attribute)
    if !d.allowed {
      return csp_decision_to_eval_result(d, ro)
    }
    match d.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspEvalResult::{
    allowed: true,
    would_block: false,
    report_only: ro,
    violated_directive: "",
    effective_directive: eff,
    matched_source: last_matched,
  }
}

///| Evaluate JavaScript `eval()` / `new Function()` across all policies in `policy`.
pub fn evaluate_csp_eval(policy : CspPolicy) -> CspEvalResult {
  let ro = policy.is_report_only()
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < policy.policies.length() {
    let d = csp::check_eval(policy.policies[i])
    if !d.allowed {
      return csp_decision_to_eval_result(d, ro)
    }
    match d.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspEvalResult::{
    allowed: true,
    would_block: false,
    report_only: ro,
    violated_directive: "",
    effective_directive: "script-src",
    matched_source: last_matched,
  }
}

///| Evaluate WebAssembly dynamic compilation (`WebAssembly.compile`/`instantiate`)
///| across all policies in `policy` (requires `'wasm-unsafe-eval'` or `'unsafe-eval'`).
pub fn evaluate_csp_wasm_eval(policy : CspPolicy) -> CspEvalResult {
  let ro = policy.is_report_only()
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < policy.policies.length() {
    let d = csp::check_wasm_eval(policy.policies[i])
    if !d.allowed {
      return csp_decision_to_eval_result(d, ro)
    }
    match d.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspEvalResult::{
    allowed: true,
    would_block: false,
    report_only: ro,
    violated_directive: "",
    effective_directive: "script-src",
    matched_source: last_matched,
  }
}

///| Evaluate `frame-ancestors` against every ancestor URL in the embedding chain.
///| Per W3C CSP3 §6.5.2, ALL ancestors in the chain must be permitted.
pub fn evaluate_csp_frame_ancestors(
  policy : CspPolicy,
  page_origin : String,
  ancestor_urls : Array[String],
) -> CspEvalResult {
  let ro = policy.is_report_only()
  let mut last_matched : Option[String] = Option::None
  let mut i = 0
  while i < ancestor_urls.length() {
    let res = evaluate_csp(
      policy,
      "frame-ancestors",
      page_origin,
      ancestor_urls[i],
      "",
      [],
      true,
    )
    if res.would_block {
      return res
    }
    match res.matched_source {
      Option::Some(m) => last_matched = Option::Some(m)
      Option::None => ()
    }
    i = i + 1
  }
  CspEvalResult::{
    allowed: true,
    would_block: false,
    report_only: ro,
    violated_directive: "",
    effective_directive: "frame-ancestors",
    matched_source: last_matched,
  }
}

///| Apply `upgrade-insecure-requests` to a URL when the policy enforces it.
///| Upgrades `http://` -> `https://` and `ws://` -> `wss://` (case-insensitive scheme).
///| Report-Only policies do not mutate URLs.
pub fn csp_upgrade_url(policy : CspPolicy, raw_url : String) -> String {
  if policy.is_report_only() || !policy.upgrade_insecure_requests() {
    return raw_url
  }
  let lower = sec_ascii_lower(raw_url)
  if lower.starts_with("http://") {
    "https://" + raw_url.slice(7, raw_url.length())
  } else if lower.starts_with("ws://") {
    "wss://" + raw_url.slice(5, raw_url.length())
  } else {
    raw_url
  }
}
