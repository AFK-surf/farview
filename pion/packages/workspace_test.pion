test "cross-package workspace integration" {
  debug_assert(workspace_ready(), "workspace ready")
  let m : intmap::IntMap[String] = intmap::IntMap::new()
  m.set(7, "seven")
  debug_assert(m.get_or(7, "") == "seven", "cross-pkg intmap get_or")
  debug_assert(m.contains(7), "cross-pkg intmap contains")
  let u = url::parse_url("https://中文.测试/a/../b?k=1#h")
  debug_assert(u.is_some(), "cross-pkg url parse")
}
